075,"_32070":46078,"_32072":46081,"_32074":46084,"_32076":46087,"_32078":46090,"_32080":46093,"_32082":46096,"_32084":46099,"_32086":46102,"_32088":46105,"_32090":46108,"_32092":46111,"_32094":46114,"_32096":46117,"_32098":46120,"_32100":46123,"_32102":46126,"_32104":46129,"_32106":46132,"_32108":46135,"_32110":46138,"_32112":46141,"_32114":46144,"_32116":46147,"_32118":46150,"_32120":46153,"_32122":46157,"_32124":46160,"_32126":46163,"_32128":46167,"_32130":46171,"_32132":46175,"_32134":46179,"_32136":46183,"_32138":46186,"_32140":46190,"_32142":46194,"_32144":46198,"_32146":46201,"_32148":46204,"_32150":46207,"_32152":46210,"_32154":46213,"_32156":46216,"_32158":46219,"_32160":46222,"_32162":46225,"_32164":46228,"_32166":46231,"_32168":46234,"_32170":46237,"_32172":46240,"_32174":46243,"_32176":46246,"_32178":46249,"_32180":46252,"_32182":46255,"_32184":46258,"_32186":46261,"_32188":46264,"_32190":46267,"_32192":46270,"_32194":46272,"_32196":46275,"_32198":46278,"_32200":46281,"_32202":46284,"_32204":46287,"_32206":46290,"_32208":46293,"_32210":46296,"_32212":46299,"_32214":46302,"_32216":46305,"_32218":46308,"_32220":46311,"_32222":46314,"_32224":46317,"_32226":46320,"_32228":46323,"_32230":46327,"_32232":46330,"_32234":46333,"_32236":46337,"_32238":46340,"_32240":46344,"_32242":46347,"_32244":46350,"_32246":46353,"_32248":46356,"_32250":46359,"_32252":46362,"_32254":46365,"_32256":46368,"_32258":46371,"_32260":46374,"_32262":46377,"_32264":46379,"_32266":46382,"_32268":46385,"_32270":46388,"_32272":46391,"_32274":46394,"_32276":46397,"_32278":46400,"_32280":46403,"_32282":46406,"_32284":46409,"_32286":46413,"_32288":46416,"_32290":46420,"_32292":46424,"_32294":46428,"_32296":46431,"_32298":46434,"_32300":46436,"_32302":46439,"_32304":46441,"_32306":46444,"_32308":46447,"_32310":46450,"_32312":46453,"_32314":46456,"_32316":46459,"_32318":46462,"_32320":46465,"_32322":46468,"_32324":46471,"_32326":46474,"_32328":46477,"_32330":46479,"_32332":46482,"_32334":46485,"_32336":46488,"_32338":46491,"_32340":46494,"_32342":46497,"_32344":46500,"_32346":46503,"_32348":46506,"_32350":46509,"_32352":46512,"_32354":46515},{"_2783":15,"_24069":15,"_5":11891,"_2311":39303,"_24384":39304,"_16893":39308,"_22829":15},"Deploy from AWS Marketplace",[39305,39306,39307],"Docs","Deployment","Other models",[],{"_2783":16,"_24069":15,"_16893":39310,"_5":16788,"_22829":15,"_2311":39311},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_2783":17,"_24069":15,"_5":24381,"_16893":39313,"_22829":39314,"_2311":39315},[],"/docs/deployment/aws-marketplace#before-you-begin","Before you begin",{"_2783":18,"_24069":15,"_5":24381,"_16893":39317,"_22829":39318,"_2311":39319},[],"/docs/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_2783":19,"_24069":15,"_5":24381,"_16893":39321,"_22829":39322,"_2311":39323},[],"/docs/deployment/aws-marketplace#open-the-offer","Open the offer",{"_2783":20,"_24069":15,"_5":24381,"_16893":39325,"_22829":39326,"_2311":39327},[],"/docs/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_2783":21,"_24069":15,"_5":24381,"_16893":39329,"_22829":39330,"_2311":39331},[],"/docs/deployment/aws-marketplace#limit-network-access","Limit network access",{"_2783":22,"_24069":15,"_5":24381,"_16893":39333,"_22829":39334,"_2311":39335},[],"/docs/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_2783":23,"_24069":15,"_5":24381,"_16893":39337,"_22829":39338,"_2311":39339},[],"/docs/deployment/aws-marketplace#next-step","Next step",{"_2783":24,"_24069":15,"_16893":39341,"_5":16788,"_22829":15,"_2311":39342},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_2783":25,"_24069":15,"_16893":39344,"_5":16788,"_22829":39314,"_2311":39345},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_2783":26,"_24069":15,"_16893":39347,"_5":16788,"_22829":39314,"_2311":39348},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_2783":27,"_24069":15,"_16893":39350,"_5":16788,"_22829":39314,"_2311":39351},[],"A security group allowing the necessary endpoints.",{"_2783":28,"_24069":15,"_16893":39353,"_5":16788,"_22829":39318,"_2311":39354},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_2783":29,"_24069":15,"_16893":39356,"_5":16788,"_22829":39318,"_2311":39357},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_2783":30,"_24069":15,"_16893":39359,"_5":16788,"_22829":39318,"_2311":39360},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_2783":31,"_24069":15,"_16893":39362,"_5":16788,"_22829":39322,"_2311":39363},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_2783":32,"_24069":15,"_16893":39365,"_5":16788,"_22829":39326,"_2311":39366},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_2783":33,"_24069":15,"_16893":39368,"_5":16788,"_22829":39330,"_2311":39369},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_2783":34,"_24069":15,"_16893":39371,"_5":16788,"_22829":39334,"_2311":39372},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_2783":35,"_24069":15,"_16893":39374,"_5":16788,"_22829":39338,"_2311":39375},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_2783":36,"_24069":36,"_5":11891,"_2311":39377,"_24384":39378,"_16893":39379,"_22829":36},"Deploy Lamassu",[39305,39306],[],{"_2783":37,"_24069":36,"_16893":39381,"_5":16788,"_22829":36,"_2311":39382},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_2783":38,"_24069":36,"_5":24381,"_16893":39384,"_22829":39385,"_2311":39386},[],"/docs/deployment/overview#choose-a-model","Choose a model",{"_2783":39,"_24069":36,"_5":24381,"_16893":39388,"_22829":39389,"_2311":39390},[],"/docs/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_2783":40,"_24069":36,"_5":24381,"_16893":39392,"_22829":39393,"_2311":39394},[],"/docs/deployment/overview#after-deployment","After deployment",{"_2783":41,"_24069":36,"_16893":39396,"_5":16788,"_22829":36,"_2311":39397},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_2783":42,"_24069":36,"_16893":39399,"_5":16788,"_22829":39385,"_2311":39400},[],"Model",{"_2783":43,"_24069":36,"_16893":39402,"_5":16788,"_22829":39385,"_2311":39403},[],"Recommended for",{"_2783":44,"_24069":36,"_16893":39405,"_5":16788,"_22829":39385,"_2311":39406},[],"Who operates the infrastructure",{"_2783":45,"_24069":36,"_16893":39408,"_5":16788,"_22829":39385,"_2311":39409},[],"Starting point",{"_2783":46,"_24069":36,"_16893":39411,"_5":16788,"_22829":39385,"_2311":39412},[],"Kubernetes self-managed",{"_2783":47,"_24069":36,"_16893":39414,"_5":16788,"_22829":39385,"_2311":39415},[],"Production, regulated environments and custom deployments",{"_2783":48,"_24069":36,"_16893":39417,"_5":16788,"_22829":39385,"_2311":39418},[],"Your team",{"_2783":49,"_24069":36,"_16893":39420,"_5":16788,"_22829":39385,"_2311":39421},[],"Helm or Fastlane",{"_2783":50,"_24069":36,"_16893":39423,"_5":16788,"_22829":39385,"_2311":39424},[],"AWS Marketplace",{"_2783":51,"_24069":36,"_16893":39426,"_5":16788,"_22829":39385,"_2311":39427},[],"Evaluation or a dedicated deployment inside an AWS account",{"_2783":52,"_24069":36,"_16893":39429,"_5":16788,"_22829":39385,"_2311":39418},[],{"_2783":53,"_24069":36,"_16893":39431,"_5":16788,"_22829":39385,"_2311":39432},[],"Preconfigured image on EC2",{"_2783":54,"_24069":36,"_16893":39434,"_5":16788,"_22829":39385,"_2311":39435},[],"SaaS",{"_2783":55,"_24069":36,"_16893":39437,"_5":16788,"_22829":39385,"_2311":39438},[],"Teams that want to use the platform without operating it",{"_2783":56,"_24069":36,"_16893":39440,"_5":16788,"_22829":39385,"_2311":39441},[],"Lamassu",{"_2783":57,"_24069":36,"_16893":39443,"_5":16788,"_22829":39385,"_2311":39444},[],"Managed subscription",{"_2783":58,"_24069":36,"_16893":39446,"_5":16788,"_22829":39385,"_2311":39447},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2783":59,"_24069":36,"_16893":39449,"_5":16788,"_22829":39385,"_2311":39450},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2783":60,"_24069":36,"_16893":39452,"_5":16788,"_22829":39385,"_2311":39453},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_2783":61,"_24069":36,"_16893":39455,"_5":16788,"_22829":39389,"_2311":39456},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_2783":62,"_24069":36,"_16893":39458,"_5":16788,"_22829":39393,"_2311":39459},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_2783":63,"_24069":63,"_5":11891,"_2311":39461,"_24384":39462,"_16893":39463,"_22829":63},"Use Lamassu as SaaS",[39305,39306,39307],[],{"_2783":64,"_24069":63,"_16893":39465,"_5":16788,"_22829":63,"_2311":39466},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_2783":65,"_24069":63,"_5":24381,"_16893":39468,"_22829":39469,"_2311":39470},[],"/docs/deployment/saas#what-the-service-manages","What the service manages",{"_2783":66,"_24069":63,"_5":24381,"_16893":39472,"_22829":39473,"_2311":39474},[],"/docs/deployment/saas#plans","Plans",{"_2783":67,"_24069":63,"_5":24381,"_16893":39476,"_22829":39477,"_2311":39478},[],"/docs/deployment/saas#request-access","Request access",{"_2783":68,"_24069":63,"_16893":39480,"_5":16788,"_22829":63,"_2311":39481},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_2783":69,"_24069":63,"_16893":39483,"_5":16788,"_22829":39469,"_2311":39484},[],"Platform availability and maintenance.",{"_2783":70,"_24069":63,"_16893":39486,"_5":16788,"_22829":39469,"_2311":39487},[],"Automatic backups.",{"_2783":71,"_24069":63,"_16893":39489,"_5":16788,"_22829":39469,"_2311":39490},[],"Version upgrades.",{"_2783":72,"_24069":63,"_16893":39492,"_5":16788,"_22829":39469,"_2311":39493},[],"Technical support and SLA according to your plan.",{"_2783":73,"_24069":63,"_16893":39495,"_5":16788,"_22829":39473,"_2311":39496},[],"Plan",{"_2783":74,"_24069":63,"_16893":39498,"_5":16788,"_22829":39473,"_2311":39499},[],"Devices",{"_2783":75,"_24069":63,"_16893":39501,"_5":16788,"_22829":39473,"_2311":39502},[],"Support",{"_2783":76,"_24069":63,"_16893":39504,"_5":16788,"_22829":39473,"_2311":39505},[],"SLA",{"_2783":77,"_24069":63,"_16893":39507,"_5":16788,"_22829":39473,"_2311":39508},[],"Starter",{"_2783":78,"_24069":63,"_16893":39510,"_5":16788,"_22829":39473,"_2311":39511},[],"Up to 1,000",{"_2783":79,"_24069":63,"_16893":39513,"_5":16788,"_22829":39473,"_2311":39514},[],"Email",{"_2783":80,"_24069":63,"_16893":39516,"_5":16788,"_22829":39473,"_2311":39517},[],"99.5 %",{"_2783":81,"_24069":63,"_16893":39519,"_5":16788,"_22829":39473,"_2311":39520},[],"Professional",{"_2783":82,"_24069":63,"_16893":39522,"_5":16788,"_22829":39473,"_2311":39523},[],"Up to 10,000",{"_2783":83,"_24069":63,"_16893":39525,"_5":16788,"_22829":39473,"_2311":39526},[],"Email and chat",{"_2783":84,"_24069":63,"_16893":39528,"_5":16788,"_22829":39473,"_2311":39529},[],"99.9 %",{"_2783":85,"_24069":63,"_16893":39531,"_5":16788,"_22829":39473,"_2311":39532},[],"Enterprise",{"_2783":86,"_24069":63,"_16893":39534,"_5":16788,"_22829":39473,"_2311":39535},[],"Unlimited",{"_2783":87,"_24069":63,"_16893":39537,"_5":16788,"_22829":39473,"_2311":39538},[],"Dedicated",{"_2783":88,"_24069":63,"_16893":39540,"_5":16788,"_22829":39473,"_2311":39541},[],"99.99 %",{"_2783":89,"_24069":63,"_16893":39543,"_5":16788,"_22829":39477,"_2311":39544},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_2783":90,"_24069":63,"_16893":39546,"_5":16788,"_22829":39477,"_2311":39547},[],"When you receive your instance's credentials, continue with Get started.",{"_2783":91,"_24069":91,"_5":11891,"_2311":39549,"_24384":39550,"_16893":39551,"_22829":91},"Fastlane",[39305,39306,39412],[],{"_2783":92,"_24069":91,"_16893":39553,"_5":16788,"_22829":91,"_2311":39554},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_2783":93,"_24069":91,"_5":24381,"_16893":39556,"_22829":39557,"_2311":39558},[],"/docs/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_2783":94,"_24069":91,"_5":24381,"_16893":39560,"_22829":39561,"_2311":39562},[],"/docs/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_2783":95,"_24069":91,"_5":24381,"_16893":39564,"_22829":39565,"_2311":39315},[],"/docs/deployment/self-hosted/fastlane#before-you-begin",{"_2783":96,"_24069":91,"_5":24381,"_16893":39567,"_22829":39568,"_2311":39569},[],"/docs/deployment/self-hosted/fastlane#quick-start","Quick start",{"_2783":97,"_24069":91,"_5":24381,"_16893":39571,"_22829":39572,"_2311":39573},[],"/docs/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_2783":98,"_24069":91,"_5":24381,"_16893":39575,"_22829":39576,"_2311":39577},[],"/docs/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_2783":99,"_24069":91,"_5":24381,"_16893":39579,"_22829":39580,"_2311":39581},[],"/docs/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_2783":100,"_24069":91,"_5":24381,"_16893":39583,"_22829":39584,"_2311":39585},[],"/docs/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_2783":101,"_24069":91,"_5":24381,"_16893":39587,"_22829":39588,"_2311":39589},[],"/docs/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_2783":102,"_24069":91,"_5":24381,"_16893":39591,"_22829":39592,"_2311":39593},[],"/docs/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_2783":103,"_24069":91,"_16893":39595,"_5":16788,"_22829":39557,"_2311":39596},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_2783":104,"_24069":91,"_16893":39598,"_5":16788,"_22829":39557,"_2311":39599},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_2783":105,"_24069":91,"_16893":39601,"_5":16788,"_22829":39561,"_2311":39602},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_2783":106,"_24069":91,"_16893":39604,"_5":16788,"_22829":39561,"_2311":39605},[],"Fastlane installs or configures",{"_2783":107,"_24069":91,"_16893":39607,"_5":16788,"_22829":39561,"_2311":39608},[],"You still provide",{"_2783":108,"_24069":91,"_16893":39610,"_5":16788,"_22829":39561,"_2311":39611},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_2783":109,"_24069":91,"_16893":39613,"_5":16788,"_22829":39561,"_2311":39614},[],"The Kubernetes cluster, nodes and persistent storage",{"_2783":110,"_24069":91,"_16893":39616,"_5":16788,"_22829":39561,"_2311":39617},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_2783":111,"_24069":91,"_16893":39619,"_5":16788,"_22829":39561,"_2311":39620},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_2783":112,"_24069":91,"_16893":39622,"_5":16788,"_22829":39561,"_2311":39623},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_2783":113,"_24069":91,"_16893":39625,"_5":16788,"_22829":39561,"_2311":39626},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_2783":114,"_24069":91,"_16893":39628,"_5":16788,"_22829":39561,"_2311":39629},[],"Optional observability and lab HSM components",{"_2783":115,"_24069":91,"_16893":39631,"_5":16788,"_22829":39561,"_2311":39632},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_2783":116,"_24069":91,"_16893":39634,"_5":16788,"_22829":39561,"_2311":39635},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_2783":117,"_24069":91,"_16893":39637,"_5":16788,"_22829":39565,"_2311":39638},[],"You need:",{"_2783":118,"_24069":91,"_16893":39640,"_5":16788,"_22829":39565,"_2311":39641},[],"an existing Kubernetes cluster",{"_2783":119,"_24069":91,"_16893":39643,"_5":16788,"_22829":39565,"_2311":39644},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_2783":120,"_24069":91,"_16893":39646,"_5":16788,"_22829":39565,"_2311":39647},[],"`yq`",{"_2783":121,"_24069":91,"_16893":39649,"_5":16788,"_22829":39565,"_2311":19088},[],{"_2783":122,"_24069":91,"_16893":39651,"_5":16788,"_22829":39565,"_2311":39652},[],"`jq` only when using `--sample-data`",{"_2783":123,"_24069":91,"_16893":39654,"_5":16788,"_22829":39565,"_2311":39655},[],"free external ports 80 and 443 on a single-node K3s host",{"_2783":124,"_24069":91,"_16893":39657,"_5":16788,"_22829":39565,"_2311":39658},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_2783":125,"_24069":91,"_16893":39660,"_5":16788,"_22829":39565,"_2311":39661},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_2783":126,"_24069":91,"_16893":39663,"_5":16788,"_22829":39568,"_2311":39664},[],"Run the script from a clone of the Helm repository:",{"_2783":127,"_24069":91,"_16893":39666,"_5":16788,"_22829":39568,"_2311":39667},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_2783":128,"_24069":91,"_16893":39669,"_5":16788,"_22829":39572,"_2311":39670},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_2783":129,"_24069":91,"_16893":39672,"_5":16788,"_22829":39572,"_2311":39673},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_2783":130,"_24069":91,"_16893":39675,"_5":16788,"_22829":39572,"_2311":39676},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_2783":131,"_24069":91,"_16893":39678,"_5":16788,"_22829":39572,"_2311":39679},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_2783":132,"_24069":91,"_16893":39681,"_5":16788,"_22829":39576,"_2311":39682},[],"Option",{"_2783":133,"_24069":91,"_16893":39684,"_5":16788,"_22829":39576,"_2311":39685},[],"Default",{"_2783":134,"_24069":91,"_16893":39687,"_5":16788,"_22829":39576,"_2311":39688},[],"Purpose",{"_2783":135,"_24069":91,"_16893":39690,"_5":16788,"_22829":39576,"_2311":39691},[],"`-h`, `--help`",{"_2783":136,"_24069":91,"_16893":39693,"_5":16788,"_22829":39576,"_2311":39694},[],"—",{"_2783":137,"_24069":91,"_16893":39696,"_5":16788,"_22829":39576,"_2311":39697},[],"Show help",{"_2783":138,"_24069":91,"_16893":39699,"_5":16788,"_22829":39576,"_2311":39700},[],"`-c`, `--context`",{"_2783":139,"_24069":91,"_16893":39702,"_5":16788,"_22829":39576,"_2311":39703},[],"current context",{"_2783":140,"_24069":91,"_16893":39705,"_5":16788,"_22829":39576,"_2311":39706},[],"Select the kubeconfig context for kubectl and Helm",{"_2783":141,"_24069":91,"_16893":39708,"_5":16788,"_22829":39576,"_2311":39709},[],"`-n`, `--non-interactive`",{"_2783":142,"_24069":91,"_16893":39711,"_5":16788,"_22829":39576,"_2311":5183},[],{"_2783":143,"_24069":91,"_16893":39713,"_5":16788,"_22829":39576,"_2311":39714},[],"Skip prompts and generate dependency credentials",{"_2783":144,"_24069":91,"_16893":39716,"_5":16788,"_22829":39576,"_2311":39717},[],"`-ns`, `--namespace`",{"_2783":145,"_24069":91,"_16893":39719,"_5":16788,"_22829":39576,"_2311":39720},[],"`lamassu-dev`",{"_2783":146,"_24069":91,"_16893":39722,"_5":16788,"_22829":39576,"_2311":39723},[],"Namespace for the installation",{"_2783":147,"_24069":91,"_16893":39725,"_5":16788,"_22829":39576,"_2311":39726},[],"`-d`, `--domain`",{"_2783":148,"_24069":91,"_16893":39728,"_5":16788,"_22829":39576,"_2311":39729},[],"`dev.lamassu.io`",{"_2783":149,"_24069":91,"_16893":39731,"_5":16788,"_22829":39576,"_2311":39732},[],"Domain used by the UI, OIDC and certificate",{"_2783":150,"_24069":91,"_16893":39734,"_5":16788,"_22829":39576,"_2311":39735},[],"`-v`, `--version`",{"_2783":151,"_24069":91,"_16893":39737,"_5":16788,"_22829":39576,"_2311":12106},[],{"_2783":152,"_24069":91,"_16893":39739,"_5":16788,"_22829":39576,"_2311":39740},[],"Lamassu chart version",{"_2783":153,"_24069":91,"_16893":39742,"_5":16788,"_22829":39576,"_2311":39743},[],"`--https-port`",{"_2783":154,"_24069":91,"_16893":39745,"_5":16788,"_22829":39576,"_2311":39746},[],"`443`",{"_2783":155,"_24069":91,"_16893":39748,"_5":16788,"_22829":39576,"_2311":39749},[],"Gateway HTTPS listener port",{"_2783":156,"_24069":91,"_16893":39751,"_5":16788,"_22829":39576,"_2311":39752},[],"`--http-port`",{"_2783":157,"_24069":91,"_16893":39754,"_5":16788,"_22829":39576,"_2311":39755},[],"`80`",{"_2783":158,"_24069":91,"_16893":39757,"_5":16788,"_22829":39576,"_2311":39758},[],"Gateway HTTP listener port",{"_2783":159,"_24069":91,"_16893":39760,"_5":16788,"_22829":39576,"_2311":39761},[],"`--tls-crt`",{"_2783":160,"_24069":91,"_16893":39763,"_5":16788,"_22829":39576,"_2311":39694},[],{"_2783":161,"_24069":91,"_16893":39765,"_5":16788,"_22829":39576,"_2311":39766},[],"PEM certificate for downstream TLS",{"_2783":162,"_24069":91,"_16893":39768,"_5":16788,"_22829":39576,"_2311":39769},[],"`--tls-key`",{"_2783":163,"_24069":91,"_16893":39771,"_5":16788,"_22829":39576,"_2311":39694},[],{"_2783":164,"_24069":91,"_16893":39773,"_5":16788,"_22829":39576,"_2311":39774},[],"PEM private key for downstream TLS",{"_2783":165,"_24069":91,"_16893":39776,"_5":16788,"_22829":39576,"_2311":39777},[],"`-l`, `--local-chart-path`",{"_2783":166,"_24069":91,"_16893":39779,"_5":16788,"_22829":39576,"_2311":39780},[],"repository chart",{"_2783":167,"_24069":91,"_16893":39782,"_5":16788,"_22829":39576,"_2311":39783},[],"Use an unpacked local Lamassu chart",{"_2783":168,"_24069":91,"_16893":39785,"_5":16788,"_22829":39576,"_2311":39786},[],"`-ip`, `--gateway-ip`",{"_2783":169,"_24069":91,"_16893":39788,"_5":16788,"_22829":39576,"_2311":7050},[],{"_2783":170,"_24069":91,"_16893":39790,"_5":16788,"_22829":39576,"_2311":39791},[],"Override the address written to `gateway.addresses`",{"_2783":171,"_24069":91,"_16893":39793,"_5":16788,"_22829":39576,"_2311":39794},[],"`--otel`",{"_2783":172,"_24069":91,"_16893":39796,"_5":16788,"_22829":39576,"_2311":5183},[],{"_2783":173,"_24069":91,"_16893":39798,"_5":16788,"_22829":39576,"_2311":39799},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_2783":174,"_24069":91,"_16893":39801,"_5":16788,"_22829":39576,"_2311":39802},[],"`--sample-data`",{"_2783":175,"_24069":91,"_16893":39804,"_5":16788,"_22829":39576,"_2311":5183},[],{"_2783":176,"_24069":91,"_16893":39806,"_5":16788,"_22829":39576,"_2311":39807},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_2783":177,"_24069":91,"_16893":39809,"_5":16788,"_22829":39576,"_2311":39810},[],"`--with-hsm`",{"_2783":178,"_24069":91,"_16893":39812,"_5":16788,"_22829":39576,"_2311":5183},[],{"_2783":179,"_24069":91,"_16893":39814,"_5":16788,"_22829":39576,"_2311":39815},[],"Install lab HSM components and configure KMS for PKCS#11",{"_2783":180,"_24069":91,"_16893":39817,"_5":16788,"_22829":39576,"_2311":39818},[],"`--softhsm-chart-path`",{"_2783":181,"_24069":91,"_16893":39820,"_5":16788,"_22829":39576,"_2311":39821},[],"`./charts/softhsm`",{"_2783":182,"_24069":91,"_16893":39823,"_5":16788,"_22829":39576,"_2311":39824},[],"Use a different local SoftHSM chart",{"_2783":183,"_24069":91,"_16893":39826,"_5":16788,"_22829":39576,"_2311":39827},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_2783":184,"_24069":91,"_16893":39829,"_5":16788,"_22829":39580,"_2311":39830},[],"Fastlane:",{"_2783":185,"_24069":91,"_16893":39832,"_5":16788,"_22829":39580,"_2311":39833},[],"validates local tools and the selected cluster",{"_2783":186,"_24069":91,"_16893":39835,"_5":16788,"_22829":39580,"_2311":39836},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_2783":187,"_24069":91,"_16893":39838,"_5":16788,"_22829":39580,"_2311":39839},[],"creates the namespace",{"_2783":188,"_24069":91,"_16893":39841,"_5":16788,"_22829":39580,"_2311":39842},[],"installs PostgreSQL and creates the required databases",{"_2783":189,"_24069":91,"_16893":39844,"_5":16788,"_22829":39580,"_2311":39845},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_2783":190,"_24069":91,"_16893":39847,"_5":16788,"_22829":39580,"_2311":39848},[],"installs RabbitMQ",{"_2783":191,"_24069":91,"_16893":39850,"_5":16788,"_22829":39580,"_2311":39851},[],"optionally installs observability and lab HSM components",{"_2783":192,"_24069":91,"_16893":39853,"_5":16788,"_22829":39580,"_2311":39854},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_2783":193,"_24069":91,"_16893":39856,"_5":16788,"_22829":39580,"_2311":39857},[],"optionally loads sample data",{"_2783":194,"_24069":91,"_16893":39859,"_5":16788,"_22829":39580,"_2311":39860},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_2783":195,"_24069":91,"_16893":39862,"_5":16788,"_22829":39584,"_2311":39863},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_2783":196,"_24069":91,"_16893":39865,"_5":16788,"_22829":39584,"_2311":39866},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_2783":197,"_24069":91,"_16893":39868,"_5":16788,"_22829":39588,"_2311":39869},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use.",{"_2783":198,"_24069":91,"_16893":39871,"_5":16788,"_22829":39588,"_2311":39872},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_2783":199,"_24069":91,"_16893":39874,"_5":16788,"_22829":39588,"_2311":39875},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_2783":200,"_24069":91,"_16893":39877,"_5":16788,"_22829":39592,"_2311":39878},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_2783":201,"_24069":201,"_5":11891,"_2311":39880,"_24384":39881,"_16893":39882,"_22829":201},"Install with Helm",[39305,39306,39412],[],{"_2783":202,"_24069":201,"_16893":39884,"_5":16788,"_22829":201,"_2311":39885},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_2783":203,"_24069":201,"_5":24381,"_16893":39887,"_22829":39888,"_2311":39889},[],"/docs/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_2783":204,"_24069":201,"_5":24381,"_16893":39891,"_22829":39892,"_2311":39315},[],"/docs/deployment/self-hosted/helm#before-you-begin",{"_2783":205,"_24069":201,"_5":24381,"_16893":39894,"_22829":39895,"_2311":39896},[],"/docs/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_2783":206,"_24069":201,"_5":24381,"_16893":39898,"_22829":39899,"_2311":39900},[],"/docs/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_2783":207,"_24069":201,"_5":24381,"_16893":39902,"_22829":39903,"_2311":39904},[],"/docs/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_2783":208,"_24069":201,"_5":24381,"_16893":39906,"_22829":39907,"_2311":39908},[],"/docs/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_2783":209,"_24069":201,"_5":24381,"_16893":39910,"_22829":39911,"_2311":39912},[],"/docs/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_2783":210,"_24069":201,"_5":24381,"_16893":39914,"_22829":39915,"_2311":39916},[],"/docs/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_2783":211,"_24069":201,"_5":24381,"_16893":39918,"_22829":39919,"_2311":39920},[],"/docs/deployment/self-hosted/helm#production-decisions","Production decisions",{"_2783":212,"_24069":201,"_16893":39922,"_5":16788,"_22829":39888,"_2311":39923},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_2783":213,"_24069":201,"_16893":39925,"_5":16788,"_22829":39892,"_2311":39926},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_2783":214,"_24069":201,"_16893":39928,"_5":16788,"_22829":39892,"_2311":39929},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_2783":215,"_24069":201,"_16893":39931,"_5":16788,"_22829":39892,"_2311":39932},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_2783":216,"_24069":201,"_16893":39934,"_5":16788,"_22829":39892,"_2311":39935},[],"a reachable RabbitMQ broker and credentials",{"_2783":217,"_24069":201,"_16893":39937,"_5":16788,"_22829":39892,"_2311":39938},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_2783":218,"_24069":201,"_16893":39940,"_5":16788,"_22829":39892,"_2311":39941},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_2783":219,"_24069":201,"_16893":39943,"_5":16788,"_22829":39892,"_2311":39944},[],"cert-manager 1.14+; for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_2783":220,"_24069":201,"_16893":39946,"_5":16788,"_22829":39892,"_2311":39947},[],"a StorageClass and an external traffic design",{"_2783":221,"_24069":201,"_16893":39949,"_5":16788,"_22829":39892,"_2311":39950},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_2783":222,"_24069":201,"_16893":39952,"_5":16788,"_22829":39892,"_2311":39953},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_2783":223,"_24069":201,"_16893":39955,"_5":16788,"_22829":39892,"_2311":39956},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_2783":224,"_24069":201,"_16893":39958,"_5":16788,"_22829":39895,"_2311":39959},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_2783":225,"_24069":201,"_16893":39961,"_5":16788,"_22829":39895,"_2311":39962},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_2783":226,"_24069":201,"_16893":39964,"_5":16788,"_22829":39895,"_2311":39965},[],"Install cert-manager separately before Lamassu. The current chart renders its self-signed issuer and CA certificate resources even when `tls.type: external` makes the Gateway use an existing TLS Secret. Selecting external TLS therefore does not remove the cert-manager prerequisite.",{"_2783":227,"_24069":201,"_16893":39967,"_5":16788,"_22829":39899,"_2311":39968},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_2783":228,"_24069":201,"_16893":39970,"_5":16788,"_22829":39899,"_2311":39971},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_2783":229,"_24069":201,"_16893":39973,"_5":16788,"_22829":39899,"_2311":39974},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_2783":230,"_24069":201,"_16893":39976,"_5":16788,"_22829":39903,"_2311":39977},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it:",{"_2783":231,"_24069":201,"_16893":39979,"_5":16788,"_22829":39907,"_2311":39980},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_2783":232,"_24069":201,"_16893":39982,"_5":16788,"_22829":39907,"_2311":39983},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_2783":233,"_24069":201,"_16893":39985,"_5":16788,"_22829":39907,"_2311":39986},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_2783":234,"_24069":201,"_16893":39988,"_5":16788,"_22829":39907,"_2311":39989},[],"See Access control for the principal and policy model.",{"_2783":235,"_24069":201,"_16893":39991,"_5":16788,"_22829":39911,"_2311":39992},[],"To install a local checkout instead:",{"_2783":236,"_24069":201,"_16893":39994,"_5":16788,"_22829":39915,"_2311":39995},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_2783":237,"_24069":201,"_16893":39997,"_5":16788,"_22829":39915,"_2311":39998},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_2783":238,"_24069":201,"_16893":40000,"_5":16788,"_22829":39919,"_2311":40001},[],"Before going live, review:",{"_2783":239,"_24069":201,"_16893":40003,"_5":16788,"_22829":39919,"_2311":40004},[],"backup and recovery for PostgreSQL and persistent volumes",{"_2783":240,"_24069":201,"_16893":40006,"_5":16788,"_22829":39919,"_2311":40007},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_2783":241,"_24069":201,"_16893":40009,"_5":16788,"_22829":39919,"_2311":40010},[],"shared VA storage before increasing VA replicas",{"_2783":242,"_24069":201,"_16893":40012,"_5":16788,"_22829":39919,"_2311":40013},[],"managed OIDC roles and removal of evaluation credentials",{"_2783":243,"_24069":201,"_16893":40015,"_5":16788,"_22829":39919,"_2311":40016},[],"a trusted TLS issuer or externally managed certificate",{"_2783":244,"_24069":201,"_16893":40018,"_5":16788,"_22829":39919,"_2311":40019},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_2783":245,"_24069":201,"_16893":40021,"_5":16788,"_22829":39919,"_2311":40022},[],"SMTP, observability and alert delivery",{"_2783":246,"_24069":201,"_16893":40024,"_5":16788,"_22829":39919,"_2311":40025},[],"the migration notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_2783":247,"_24069":201,"_16893":40027,"_5":16788,"_22829":39919,"_2311":40028},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_2783":248,"_24069":248,"_5":11891,"_2311":40030,"_24384":40031,"_16893":40032,"_22829":248},"Expose the Gateway",[39305,39306,39412],[],{"_2783":249,"_24069":248,"_16893":40034,"_5":16788,"_22829":248,"_2311":40035},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_2783":250,"_24069":248,"_5":24381,"_16893":40037,"_22829":40038,"_2311":40039},[],"/docs/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_2783":251,"_24069":248,"_5":24381,"_16893":40041,"_22829":40042,"_2311":40043},[],"/docs/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_2783":252,"_24069":248,"_5":24381,"_16893":40045,"_22829":40046,"_2311":40047},[],"/docs/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_2783":253,"_24069":248,"_5":24381,"_16893":40049,"_22829":40050,"_2311":40051},[],"/docs/deployment/self-hosted/networking#k3s","K3s",{"_2783":254,"_24069":248,"_5":24381,"_16893":40053,"_22829":40054,"_2311":40055},[],"/docs/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_2783":255,"_24069":248,"_5":24381,"_16893":40057,"_22829":40058,"_2311":40059},[],"/docs/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_2783":256,"_24069":248,"_5":24381,"_16893":40061,"_22829":40062,"_2311":40063},[],"/docs/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_2783":257,"_24069":248,"_5":24381,"_16893":40065,"_22829":40066,"_2311":40067},[],"/docs/deployment/self-hosted/networking#decision-guide","Decision guide",{"_2783":258,"_24069":248,"_5":24381,"_16893":40069,"_22829":40070,"_2311":40071},[],"/docs/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_2783":259,"_24069":248,"_16893":40073,"_5":16788,"_22829":40038,"_2311":40074},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_2783":260,"_24069":248,"_16893":40076,"_5":16788,"_22829":40038,"_2311":40077},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_2783":261,"_24069":248,"_16893":40079,"_5":16788,"_22829":40042,"_2311":40080},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_2783":262,"_24069":248,"_16893":40082,"_5":16788,"_22829":40042,"_2311":40083},[],"Set it only when:",{"_2783":263,"_24069":248,"_16893":40085,"_5":16788,"_22829":40042,"_2311":40086},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_2783":264,"_24069":248,"_16893":40088,"_5":16788,"_22829":40042,"_2311":40089},[],"that address is allocated to this Gateway",{"_2783":265,"_24069":248,"_16893":40091,"_5":16788,"_22829":40042,"_2311":40092},[],"the surrounding network already routes traffic for it to the cluster",{"_2783":266,"_24069":248,"_16893":40094,"_5":16788,"_22829":40042,"_2311":40095},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_2783":267,"_24069":248,"_16893":40097,"_5":16788,"_22829":40042,"_2311":40098},[],"Keep these two settings separate:",{"_2783":268,"_24069":248,"_16893":40100,"_5":16788,"_22829":40042,"_2311":40101},[],"`gateway.addresses` requests an address for the Gateway.",{"_2783":269,"_24069":248,"_16893":40103,"_5":16788,"_22829":40042,"_2311":40104},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_2783":270,"_24069":248,"_16893":40106,"_5":16788,"_22829":40042,"_2311":40107},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_2783":271,"_24069":248,"_16893":40109,"_5":16788,"_22829":40046,"_2311":40110},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_2783":272,"_24069":248,"_16893":40112,"_5":16788,"_22829":40046,"_2311":40113},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_2783":273,"_24069":248,"_16893":40115,"_5":16788,"_22829":40050,"_2311":40116},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_2783":274,"_24069":248,"_16893":40118,"_5":16788,"_22829":40050,"_2311":40119},[],"For the recommended design:",{"_2783":275,"_24069":248,"_16893":40121,"_5":16788,"_22829":40050,"_2311":40122},[],"Use only one externally exposed Lamassu Gateway.",{"_2783":276,"_24069":248,"_16893":40124,"_5":16788,"_22829":40050,"_2311":40125},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_2783":277,"_24069":248,"_16893":40127,"_5":16788,"_22829":40050,"_2311":40128},[],"Allow those ports through the VM firewall and any upstream security group.",{"_2783":278,"_24069":248,"_16893":40130,"_5":16788,"_22829":40050,"_2311":40131},[],"Point DNS at the VM's reachable address.",{"_2783":279,"_24069":248,"_16893":40133,"_5":16788,"_22829":40050,"_2311":40134},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_2783":280,"_24069":248,"_16893":40136,"_5":16788,"_22829":40054,"_2311":40137},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_2783":281,"_24069":248,"_16893":40139,"_5":16788,"_22829":40058,"_2311":40140},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_2783":282,"_24069":248,"_16893":40142,"_5":16788,"_22829":40058,"_2311":40143},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_2783":283,"_24069":248,"_16893":40145,"_5":16788,"_22829":40062,"_2311":40146},[],"First decide whether you need three independent data planes or only three hostnames.",{"_2783":284,"_24069":248,"_16893":40148,"_5":16788,"_22829":40062,"_2311":40149},[],"Requirement",{"_2783":285,"_24069":248,"_16893":40151,"_5":16788,"_22829":40062,"_2311":40152},[],"Recommended design",{"_2783":286,"_24069":248,"_16893":40154,"_5":16788,"_22829":40062,"_2311":40155},[],"Consequence",{"_2783":287,"_24069":248,"_16893":40157,"_5":16788,"_22829":40062,"_2311":40158},[],"Several Lamassu URLs or services",{"_2783":288,"_24069":248,"_16893":40160,"_5":16788,"_22829":40062,"_2311":40161},[],"One Gateway with multiple routes",{"_2783":289,"_24069":248,"_16893":40163,"_5":16788,"_22829":40062,"_2311":40164},[],"One IP and one proxy fleet; this is the chart default",{"_2783":290,"_24069":248,"_16893":40166,"_5":16788,"_22829":40062,"_2311":40167},[],"Independent Gateways and separate external IPs",{"_2783":291,"_24069":248,"_16893":40169,"_5":16788,"_22829":40062,"_2311":40170},[],"One VIP per Gateway",{"_2783":292,"_24069":248,"_16893":40172,"_5":16788,"_22829":40062,"_2311":40173},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_2783":293,"_24069":248,"_16893":40175,"_5":16788,"_22829":40062,"_2311":40176},[],"Independent Gateways on one node and one IP",{"_2783":294,"_24069":248,"_16893":40178,"_5":16788,"_22829":40062,"_2311":40179},[],"Use different external ports",{"_2783":295,"_24069":248,"_16893":40181,"_5":16788,"_22829":40062,"_2311":40182},[],"Clients must include non-standard ports",{"_2783":296,"_24069":248,"_16893":40184,"_5":16788,"_22829":40062,"_2311":40185},[],"Separate TLS/mTLS termination behind one IP",{"_2783":297,"_24069":248,"_16893":40187,"_5":16788,"_22829":40062,"_2311":40188},[],"Front-door SNI routing to internal Gateways",{"_2783":298,"_24069":248,"_16893":40190,"_5":16788,"_22829":40062,"_2311":40191},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_2783":299,"_24069":248,"_16893":40193,"_5":16788,"_22829":40062,"_2311":40194},[],"Separate Gateway resources but shared proxy infrastructure",{"_2783":300,"_24069":248,"_16893":40196,"_5":16788,"_22829":40062,"_2311":40197},[],"Envoy merged-Gateway mode",{"_2783":301,"_24069":248,"_16893":40199,"_5":16788,"_22829":40062,"_2311":40200},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_2783":302,"_24069":248,"_16893":40202,"_5":16788,"_22829":40062,"_2311":40203},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_2783":303,"_24069":248,"_16893":40205,"_5":16788,"_22829":40062,"_2311":40206},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_2783":304,"_24069":248,"_16893":40208,"_5":16788,"_22829":40062,"_2311":40209},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_2783":305,"_24069":248,"_16893":40211,"_5":16788,"_22829":40062,"_2311":40212},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_2783":306,"_24069":248,"_16893":40214,"_5":16788,"_22829":40066,"_2311":40215},[],"If one Gateway can own TLS and routing, use the chart default.",{"_2783":307,"_24069":248,"_16893":40217,"_5":16788,"_22829":40066,"_2311":40218},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_2783":308,"_24069":248,"_16893":40220,"_5":16788,"_22829":40066,"_2311":40221},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_2783":309,"_24069":248,"_16893":40223,"_5":16788,"_22829":40066,"_2311":40224},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_2783":310,"_24069":248,"_16893":40226,"_5":16788,"_22829":40066,"_2311":40227},[],"If none of those are possible, use different external ports or change the external network design.",{"_2783":311,"_24069":248,"_16893":40229,"_5":16788,"_22829":40070,"_2311":40230},[],"Check, in order:",{"_2783":312,"_24069":248,"_16893":40232,"_5":16788,"_22829":40070,"_2311":40233},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_2783":313,"_24069":248,"_16893":40235,"_5":16788,"_22829":40070,"_2311":40236},[],"Its status contains the expected address.",{"_2783":314,"_24069":248,"_16893":40238,"_5":16788,"_22829":40070,"_2311":40239},[],"The generated `LoadBalancer` Service has a usable external address.",{"_2783":315,"_24069":248,"_16893":40241,"_5":16788,"_22829":40070,"_2311":40242},[],"Port 443 reaches that address from the client network.",{"_2783":316,"_24069":248,"_16893":40244,"_5":16788,"_22829":40070,"_2311":40245},[],"DNS resolves to the externally reachable endpoint.",{"_2783":317,"_24069":248,"_16893":40247,"_5":16788,"_22829":40070,"_2311":40248},[],"The certificate contains the DNS name or IP used by the client.",{"_2783":318,"_24069":248,"_16893":40250,"_5":16788,"_22829":40070,"_2311":40251},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_2783":319,"_24069":319,"_5":11891,"_2311":39412,"_24384":40253,"_16893":40254,"_22829":319},[39305,39306,39412],[],{"_2783":320,"_24069":319,"_16893":40256,"_5":16788,"_22829":319,"_2311":40257},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_2783":321,"_24069":319,"_5":24381,"_16893":40259,"_22829":40260,"_2311":40261},[],"/docs/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_2783":322,"_24069":319,"_5":24381,"_16893":40263,"_22829":40264,"_2311":40265},[],"/docs/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_2783":323,"_24069":319,"_5":24381,"_16893":40267,"_22829":40268,"_2311":40269},[],"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_2783":324,"_24069":319,"_5":24381,"_16893":40271,"_22829":40272,"_2311":40273},[],"/docs/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_2783":325,"_24069":319,"_5":24381,"_16893":40275,"_22829":40276,"_2311":40277},[],"/docs/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_2783":326,"_24069":319,"_5":24381,"_16893":40279,"_22829":40280,"_2311":40281},[],"/docs/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_2783":327,"_24069":319,"_16893":40283,"_5":16788,"_22829":40260,"_2311":40284},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_2783":328,"_24069":319,"_16893":40286,"_5":16788,"_22829":40264,"_2311":40287},[],"Workflow",{"_2783":329,"_24069":319,"_16893":40289,"_5":16788,"_22829":40264,"_2311":40290},[],"Use it for",{"_2783":330,"_24069":319,"_16893":40292,"_5":16788,"_22829":40264,"_2311":40293},[],"What it installs",{"_2783":331,"_24069":319,"_16893":40295,"_5":16788,"_22829":40264,"_2311":40296},[],"Helm",{"_2783":332,"_24069":319,"_16893":40298,"_5":16788,"_22829":40264,"_2311":40299},[],"Production and controlled environments",{"_2783":333,"_24069":319,"_16893":40301,"_5":16788,"_22829":40264,"_2311":40302},[],"Lamassu services and Gateway API resources",{"_2783":334,"_24069":319,"_16893":40304,"_5":16788,"_22829":40264,"_2311":39549},[],{"_2783":335,"_24069":319,"_16893":40306,"_5":16788,"_22829":40264,"_2311":40307},[],"Evaluation, demos, CI and small lab clusters",{"_2783":336,"_24069":319,"_16893":40309,"_5":16788,"_22829":40264,"_2311":40310},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_2783":337,"_24069":319,"_16893":40312,"_5":16788,"_22829":40268,"_2311":40313},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_2783":338,"_24069":319,"_16893":40315,"_5":16788,"_22829":40268,"_2311":40316},[],"Area",{"_2783":339,"_24069":319,"_16893":40318,"_5":16788,"_22829":40268,"_2311":40319},[],"The Lamassu chart provides",{"_2783":340,"_24069":319,"_16893":40321,"_5":16788,"_22829":40268,"_2311":40322},[],"You provide",{"_2783":341,"_24069":319,"_16893":40324,"_5":16788,"_22829":40268,"_2311":40325},[],"Lamassu applications",{"_2783":342,"_24069":319,"_16893":40327,"_5":16788,"_22829":40268,"_2311":40328},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_2783":343,"_24069":319,"_16893":40330,"_5":16788,"_22829":40268,"_2311":40331},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_2783":344,"_24069":319,"_16893":40333,"_5":16788,"_22829":40268,"_2311":40334},[],"PostgreSQL data",{"_2783":345,"_24069":319,"_16893":40336,"_5":16788,"_22829":40268,"_2311":40337},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_2783":346,"_24069":319,"_16893":40339,"_5":16788,"_22829":40268,"_2311":40340},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_2783":347,"_24069":319,"_16893":40342,"_5":16788,"_22829":40268,"_2311":40343},[],"Messaging",{"_2783":348,"_24069":319,"_16893":40345,"_5":16788,"_22829":40268,"_2311":40346},[],"RabbitMQ connection configuration for the Lamassu services",{"_2783":349,"_24069":319,"_16893":40348,"_5":16788,"_22829":40268,"_2311":40349},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_2783":350,"_24069":319,"_16893":40351,"_5":16788,"_22829":40268,"_2311":40352},[],"Identity",{"_2783":351,"_24069":319,"_16893":40354,"_5":16788,"_22829":40268,"_2311":40355},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_2783":352,"_24069":319,"_16893":40357,"_5":16788,"_22829":40268,"_2311":40358},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_2783":353,"_24069":319,"_16893":40360,"_5":16788,"_22829":40268,"_2311":40361},[],"External routing",{"_2783":354,"_24069":319,"_16893":40363,"_5":16788,"_22829":40268,"_2311":40364},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_2783":355,"_24069":319,"_16893":40366,"_5":16788,"_22829":40268,"_2311":40367},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_2783":356,"_24069":319,"_16893":40369,"_5":16788,"_22829":40268,"_2311":40370},[],"TLS",{"_2783":357,"_24069":319,"_16893":40372,"_5":16788,"_22829":40268,"_2311":40373},[],"cert-manager `Issuer` and CA `Certificate` resources; either a chart-managed downstream `Certificate` or a reference to your TLS Secret",{"_2783":358,"_24069":319,"_16893":40375,"_5":16788,"_22829":40268,"_2311":40376},[],"cert-manager itself; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_2783":359,"_24069":319,"_16893":40378,"_5":16788,"_22829":40268,"_2311":40379},[],"Persistent application data",{"_2783":360,"_24069":319,"_16893":40381,"_5":16788,"_22829":40268,"_2311":40382},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_2783":361,"_24069":319,"_16893":40384,"_5":16788,"_22829":40268,"_2311":40385},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_2783":362,"_24069":319,"_16893":40387,"_5":16788,"_22829":40268,"_2311":40388},[],"Optional integrations",{"_2783":363,"_24069":319,"_16893":40390,"_5":16788,"_22829":40268,"_2311":40391},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_2783":364,"_24069":319,"_16893":40393,"_5":16788,"_22829":40268,"_2311":40394},[],"The observability backends, cloud credentials and production HSM or external key service",{"_2783":365,"_24069":319,"_16893":40396,"_5":16788,"_22829":40268,"_2311":40397},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_2783":366,"_24069":319,"_16893":40399,"_5":16788,"_22829":40268,"_2311":40400},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_2783":367,"_24069":319,"_16893":40402,"_5":16788,"_22829":40272,"_2311":40403},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_2783":368,"_24069":319,"_16893":40405,"_5":16788,"_22829":40272,"_2311":40406},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_2783":369,"_24069":319,"_16893":40408,"_5":16788,"_22829":40276,"_2311":40409},[],"Kubernetes 1.24 or newer",{"_2783":370,"_24069":319,"_16893":40411,"_5":16788,"_22829":40276,"_2311":40412},[],"Helm 3.2 or newer",{"_2783":371,"_24069":319,"_16893":40414,"_5":16788,"_22829":40276,"_2311":40415},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_2783":372,"_24069":319,"_16893":40417,"_5":16788,"_22829":40276,"_2311":40418},[],"cert-manager 1.14 or newer; the current chart renders cert-manager issuer and certificate resources",{"_2783":373,"_24069":319,"_16893":40420,"_5":16788,"_22829":40276,"_2311":40421},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_2783":374,"_24069":319,"_16893":40423,"_5":16788,"_22829":40276,"_2311":40424},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_2783":375,"_24069":319,"_16893":40426,"_5":16788,"_22829":40276,"_2311":40427},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer.",{"_2783":376,"_24069":319,"_16893":40429,"_5":16788,"_22829":40280,"_2311":40430},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2783":377,"_24069":319,"_16893":40432,"_5":16788,"_22829":40280,"_2311":40433},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2783":378,"_24069":319,"_16893":40435,"_5":16788,"_22829":40280,"_2311":40436},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2783":379,"_24069":379,"_5":11891,"_2311":40438,"_24384":40439,"_16893":40441,"_22829":379},"Deployment troubleshooting",[39305,39306,40440],"Operations",[],{"_2783":380,"_24069":379,"_16893":40443,"_5":16788,"_22829":379,"_2311":40444},[],"Diagnose access, service health and infrastructure dependencies.",{"_2783":381,"_24069":379,"_5":24381,"_16893":40446,"_22829":40447,"_2311":40448},[],"/docs/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_2783":382,"_24069":379,"_5":24381,"_16893":40450,"_22829":40451,"_2311":40452},[],"/docs/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_2783":383,"_24069":379,"_5":24381,"_16893":40454,"_22829":40455,"_2311":40456},[],"/docs/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_2783":384,"_24069":379,"_5":24381,"_16893":40458,"_22829":40459,"_2311":40460},[],"/docs/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_2783":385,"_24069":379,"_5":24381,"_16893":40462,"_22829":40463,"_2311":40464},[],"/docs/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_2783":386,"_24069":379,"_5":24381,"_16893":40466,"_22829":40467,"_2311":40468},[],"/docs/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_2783":387,"_24069":379,"_5":24381,"_16893":40470,"_22829":40471,"_2311":40472},[],"/docs/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_2783":388,"_24069":379,"_5":24381,"_16893":40474,"_22829":40475,"_2311":40476},[],"/docs/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_2783":389,"_24069":379,"_5":24381,"_16893":40478,"_22829":40479,"_2311":40480},[],"/docs/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_2783":390,"_24069":379,"_5":24381,"_16893":40482,"_22829":40483,"_2311":40484},[],"/docs/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_2783":391,"_24069":379,"_5":24381,"_16893":40486,"_22829":40487,"_2311":40488},[],"/docs/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_2783":392,"_24069":379,"_5":24381,"_16893":40490,"_22829":40491,"_2311":40492},[],"/docs/deployment/troubleshooting#observability","Observability",{"_2783":393,"_24069":379,"_16893":40494,"_5":16788,"_22829":379,"_2311":40495},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_2783":394,"_24069":379,"_16893":40497,"_5":16788,"_22829":40451,"_2311":40498},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_2783":395,"_24069":379,"_16893":40500,"_5":16788,"_22829":40455,"_2311":40501},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_2783":396,"_24069":379,"_16893":40503,"_5":16788,"_22829":40459,"_2311":40504},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_2783":397,"_24069":379,"_16893":40506,"_5":16788,"_22829":40463,"_2311":40507},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_2783":398,"_24069":379,"_16893":40509,"_5":16788,"_22829":40467,"_2311":40510},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_2783":399,"_24069":379,"_16893":40512,"_5":16788,"_22829":40471,"_2311":40513},[],"Replace the placeholders with your real release, namespace and deployment.",{"_2783":400,"_24069":379,"_16893":40515,"_5":16788,"_22829":40471,"_2311":40516},[],"Also run the chart's connectivity test:",{"_2783":401,"_24069":379,"_16893":40518,"_5":16788,"_22829":40471,"_2311":40519},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_2783":402,"_24069":379,"_16893":40521,"_5":16788,"_22829":40471,"_2311":40522},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_2783":403,"_24069":379,"_16893":40524,"_5":16788,"_22829":40475,"_2311":40525},[],"If you receive a 401:",{"_2783":404,"_24069":379,"_16893":40527,"_5":16788,"_22829":40475,"_2311":40528},[],"check that the UI's OIDC authority is reachable from the browser;",{"_2783":405,"_24069":379,"_16893":40530,"_5":16788,"_22829":40475,"_2311":40531},[],"verify issuer, audience and expiration of the token;",{"_2783":406,"_24069":379,"_16893":40533,"_5":16788,"_22829":40475,"_2311":40534},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_2783":407,"_24069":379,"_16893":40536,"_5":16788,"_22829":40475,"_2311":40537},[],"check that the provider's public and internal routes point to the same realm.",{"_2783":408,"_24069":379,"_16893":40539,"_5":16788,"_22829":40475,"_2311":40540},[],"If login succeeds but the APIs return 403:",{"_2783":409,"_24069":379,"_16893":40542,"_5":16788,"_22829":40475,"_2311":40543},[],"inspect the token's real claims;",{"_2783":410,"_24069":379,"_16893":40545,"_5":16788,"_22829":40475,"_2311":40546},[],"confirm they match an active principal;",{"_2783":411,"_24069":379,"_16893":40548,"_5":16788,"_22829":40475,"_2311":40549},[],"review the policies granted to that principal;",{"_2783":412,"_24069":379,"_16893":40551,"_5":16788,"_22829":40475,"_2311":40552},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_2783":413,"_24069":379,"_16893":40554,"_5":16788,"_22829":40475,"_2311":40555},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_2783":414,"_24069":379,"_16893":40557,"_5":16788,"_22829":40479,"_2311":40558},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_2783":415,"_24069":379,"_16893":40560,"_5":16788,"_22829":40479,"_2311":40561},[],"Locate the authz pod and Service.",{"_2783":416,"_24069":379,"_16893":40563,"_5":16788,"_22829":40479,"_2311":40564},[],"Check /health, logs and its database connection.",{"_2783":417,"_24069":379,"_16893":40566,"_5":16788,"_22829":40479,"_2311":40567},[],"Verify the DNS and port configured in externalAuthorization.",{"_2783":418,"_24069":379,"_16893":40569,"_5":16788,"_22829":40479,"_2311":40570},[],"Check the check route is /v1/ext\\_authz/check.",{"_2783":419,"_24069":379,"_16893":40572,"_5":16788,"_22829":40479,"_2311":40573},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_2783":420,"_24069":379,"_16893":40575,"_5":16788,"_22829":40483,"_2311":40576},[],"Review kubectl describe pod first. Common causes are:",{"_2783":421,"_24069":379,"_16893":40578,"_5":16788,"_22829":40483,"_2311":40579},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_2783":422,"_24069":379,"_16893":40581,"_5":16788,"_22829":40483,"_2311":40582},[],"unbound persistent volume;",{"_2783":423,"_24069":379,"_16893":40584,"_5":16788,"_22829":40483,"_2311":40585},[],"inaccessible image or incorrect pull policy;",{"_2783":424,"_24069":379,"_16893":40587,"_5":16788,"_22829":40483,"_2311":40588},[],"invalid cryptographic engine configuration;",{"_2783":425,"_24069":379,"_16893":40590,"_5":16788,"_22829":40483,"_2311":40591},[],"CPU or memory limits set too low;",{"_2783":426,"_24069":379,"_16893":40593,"_5":16788,"_22829":40483,"_2311":40594},[],"an incomplete prior migration.",{"_2783":427,"_24069":379,"_16893":40596,"_5":16788,"_22829":40483,"_2311":40597},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_2783":428,"_24069":379,"_16893":40599,"_5":16788,"_22829":40483,"_2311":40600},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_2783":429,"_24069":379,"_16893":40602,"_5":16788,"_22829":40487,"_2311":40603},[],"Domain and audit events depend on the bus publisher:",{"_2783":430,"_24069":379,"_16893":40605,"_5":16788,"_22829":40487,"_2311":40606},[],"verify it is enabled in the emitting service;",{"_2783":431,"_24069":379,"_16893":40608,"_5":16788,"_22829":40487,"_2311":40609},[],"check AMQP connectivity and credentials;",{"_2783":432,"_24069":379,"_16893":40611,"_5":16788,"_22829":40487,"_2311":40612},[],"review exchange, routing key, queues and consumers;",{"_2783":433,"_24069":379,"_16893":40614,"_5":16788,"_22829":40487,"_2311":40615},[],"inspect dead-letter queues;",{"_2783":434,"_24069":379,"_16893":40617,"_5":16788,"_22829":40487,"_2311":40618},[],"alert on orphan durable queues and backlog growth.",{"_2783":435,"_24069":379,"_16893":40620,"_5":16788,"_22829":40487,"_2311":40621},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_2783":436,"_24069":379,"_16893":40623,"_5":16788,"_22829":40491,"_2311":40624},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_2783":437,"_24069":379,"_16893":40626,"_5":16788,"_22829":40491,"_2311":40627},[],"Before closing an incident, record:",{"_2783":438,"_24069":379,"_16893":40629,"_5":16788,"_22829":40491,"_2311":40630},[],"the confirmed cause;",{"_2783":439,"_24069":379,"_16893":40632,"_5":16788,"_22829":40491,"_2311":40633},[],"the time scope and affected resources;",{"_2783":440,"_24069":379,"_16893":40635,"_5":16788,"_22829":40491,"_2311":40636},[],"the commands or queries used;",{"_2783":441,"_24069":379,"_16893":40638,"_5":16788,"_22829":40491,"_2311":40639},[],"the applied change and how to revert it;",{"_2783":442,"_24069":379,"_16893":40641,"_5":16788,"_22829":40491,"_2311":40642},[],"validation from a consumer;",{"_2783":443,"_24069":379,"_16893":40644,"_5":16788,"_22829":40491,"_2311":40645},[],"the preventive action and its owner.",{"_2783":444,"_24069":444,"_5":11891,"_2311":40647,"_24384":40648,"_16893":40651,"_22829":444},"Access control",[39305,40649,40650],"Platform","Administration",[],{"_2783":445,"_24069":444,"_16893":40653,"_5":16788,"_22829":444,"_2311":40654},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_2783":446,"_24069":444,"_5":24381,"_16893":40656,"_22829":40657,"_2311":40658},[],"/docs/platform/administration/access-control#essential-concepts","Essential concepts",{"_2783":447,"_24069":444,"_5":24381,"_16893":40660,"_22829":40661,"_2311":40662},[],"/docs/platform/administration/access-control#two-decision-systems","Two decision systems",{"_2783":448,"_24069":444,"_5":24381,"_16893":40664,"_22829":40665,"_2311":40666},[],"/docs/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_2783":449,"_24069":444,"_5":24381,"_16893":40668,"_22829":40669,"_2311":40670},[],"/docs/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_2783":450,"_24069":444,"_5":24381,"_16893":40672,"_22829":40673,"_2311":40674},[],"/docs/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_2783":451,"_24069":444,"_5":24381,"_16893":40676,"_22829":40677,"_2311":40678},[],"/docs/platform/administration/access-control#oidc-principals","OIDC principals",{"_2783":452,"_24069":444,"_5":24381,"_16893":40680,"_22829":40681,"_2311":40682},[],"/docs/platform/administration/access-control#x509-principals","X.509 principals",{"_2783":453,"_24069":444,"_5":24381,"_16893":40684,"_22829":40685,"_2311":40686},[],"/docs/platform/administration/access-control#when-several-principals-match","When several principals match",{"_2783":454,"_24069":444,"_5":24381,"_16893":40688,"_22829":40689,"_2311":40690},[],"/docs/platform/administration/access-control#how-policies-express-access","How policies express access",{"_2783":455,"_24069":444,"_5":24381,"_16893":40692,"_22829":40693,"_2311":40694},[],"/docs/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_2783":456,"_24069":444,"_5":24381,"_16893":40696,"_22829":40697,"_2311":40698},[],"/docs/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_2783":457,"_24069":444,"_5":24381,"_16893":40700,"_22829":40701,"_2311":40702},[],"/docs/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_2783":458,"_24069":444,"_5":24381,"_16893":40704,"_22829":40705,"_2311":40706},[],"/docs/platform/administration/access-control#http-rules","HTTP rules",{"_2783":459,"_24069":444,"_5":24381,"_16893":40708,"_22829":40709,"_2311":40710},[],"/docs/platform/administration/access-control#included-policies","Included policies",{"_2783":460,"_24069":444,"_5":24381,"_16893":40712,"_22829":40713,"_2311":39908},[],"/docs/platform/administration/access-control#provision-the-first-administrator",{"_2783":461,"_24069":444,"_5":24381,"_16893":40715,"_22829":40716,"_2311":40717},[],"/docs/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_2783":462,"_24069":444,"_5":24381,"_16893":40719,"_22829":40720,"_2311":40721},[],"/docs/platform/administration/access-control#configure-the-two-jwt-validations","Configure the two JWT validations",{"_2783":463,"_24069":444,"_5":24381,"_16893":40723,"_22829":40724,"_2311":40725},[],"/docs/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_2783":464,"_24069":444,"_5":24381,"_16893":40727,"_22829":40728,"_2311":40729},[],"/docs/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_2783":465,"_24069":444,"_5":24381,"_16893":40731,"_22829":40732,"_2311":40733},[],"/docs/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_2783":466,"_24069":444,"_5":24381,"_16893":40735,"_22829":40736,"_2311":40737},[],"/docs/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_2783":467,"_24069":444,"_5":24381,"_16893":40739,"_22829":40740,"_2311":40741},[],"/docs/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_2783":468,"_24069":444,"_5":24381,"_16893":40743,"_22829":40744,"_2311":40745},[],"/docs/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_2783":469,"_24069":444,"_5":24381,"_16893":40747,"_22829":40748,"_2311":40749},[],"/docs/platform/administration/access-control#operational-checklist","Operational checklist",{"_2783":470,"_24069":444,"_5":24381,"_16893":40751,"_22829":40752,"_2311":40753},[],"/docs/platform/administration/access-control#diagnostics","Diagnostics",{"_2783":471,"_24069":444,"_5":24381,"_16893":40755,"_22829":40756,"_2311":40757},[],"/docs/platform/administration/access-control#the-response-is-401","The response is 401",{"_2783":472,"_24069":444,"_5":24381,"_16893":40759,"_22829":40760,"_2311":40761},[],"/docs/platform/administration/access-control#the-response-is-403","The response is 403",{"_2783":473,"_24069":444,"_5":24381,"_16893":40763,"_22829":40764,"_2311":40765},[],"/docs/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_2783":474,"_24069":444,"_5":24381,"_16893":40767,"_22829":40768,"_2311":40769},[],"/docs/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_2783":475,"_24069":444,"_16893":40771,"_5":16788,"_22829":444,"_2311":40772},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_2783":476,"_24069":444,"_16893":40774,"_5":16788,"_22829":444,"_2311":40775},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_2783":477,"_24069":444,"_16893":40777,"_5":16788,"_22829":444,"_2311":40778},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_2783":478,"_24069":444,"_16893":40780,"_5":16788,"_22829":40657,"_2311":40781},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_2783":479,"_24069":444,"_16893":40783,"_5":16788,"_22829":40657,"_2311":40784},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_2783":480,"_24069":444,"_16893":40786,"_5":16788,"_22829":40657,"_2311":40787},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_2783":481,"_24069":444,"_16893":40789,"_5":16788,"_22829":40657,"_2311":40790},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_2783":482,"_24069":444,"_16893":40792,"_5":16788,"_22829":40657,"_2311":40793},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_2783":483,"_24069":444,"_16893":40795,"_5":16788,"_22829":40657,"_2311":40796},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and one of its policies must allow the requested operation.",{"_2783":484,"_24069":444,"_16893":40798,"_5":16788,"_22829":40661,"_2311":40799},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_2783":485,"_24069":444,"_16893":40801,"_5":16788,"_22829":40661,"_2311":40802},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_2783":486,"_24069":444,"_16893":40804,"_5":16788,"_22829":40665,"_2311":40805},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_2783":487,"_24069":444,"_16893":40807,"_5":16788,"_22829":40665,"_2311":40808},[],"The decision is made **before forwarding the request to the service**:",{"_2783":488,"_24069":444,"_16893":40810,"_5":16788,"_22829":40665,"_2311":40811},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_2783":489,"_24069":444,"_16893":40813,"_5":16788,"_22829":40665,"_2311":40814},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_2783":490,"_24069":444,"_16893":40816,"_5":16788,"_22829":40665,"_2311":40817},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_2783":491,"_24069":444,"_16893":40819,"_5":16788,"_22829":40665,"_2311":40820},[],"It separately loads the policies granted to each principal.",{"_2783":492,"_24069":444,"_16893":40822,"_5":16788,"_22829":40665,"_2311":40823},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_2783":493,"_24069":444,"_16893":40825,"_5":16788,"_22829":40665,"_2311":40826},[],"`authz` looks for an HTTP rule granting that action.",{"_2783":494,"_24069":444,"_16893":40828,"_5":16788,"_22829":40665,"_2311":40829},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy.",{"_2783":495,"_24069":444,"_16893":40831,"_5":16788,"_22829":40665,"_2311":40832},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_2783":496,"_24069":444,"_16893":40834,"_5":16788,"_22829":40665,"_2311":40835},[],"When it allows access, `authz` returns the selected principal in `x-current-user`. The Gateway can propagate that header to the service to preserve the identity context.",{"_2783":497,"_24069":444,"_16893":40837,"_5":16788,"_22829":40665,"_2311":40838},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, the schema must declare a constraint relating a request value to a normalized attribute of the principal.",{"_2783":498,"_24069":444,"_16893":40840,"_5":16788,"_22829":40669,"_2311":40841},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_2783":499,"_24069":444,"_16893":40843,"_5":16788,"_22829":40669,"_2311":40844},[],"The decision is made with the domain operation context:",{"_2783":500,"_24069":444,"_16893":40846,"_5":16788,"_22829":40669,"_2311":40847},[],"The middleware extracts the credential and resolves the matching principals.",{"_2783":501,"_24069":444,"_16893":40849,"_5":16788,"_22829":40669,"_2311":40850},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_2783":502,"_24069":444,"_16893":40852,"_5":16788,"_22829":40669,"_2311":40853},[],"`authz` gathers the entity rules of the granted policies.",{"_2783":503,"_24069":444,"_16893":40855,"_5":16788,"_22829":40669,"_2311":40856},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_2783":504,"_24069":444,"_16893":40858,"_5":16788,"_22829":40669,"_2311":40859},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_2783":505,"_24069":444,"_16893":40861,"_5":16788,"_22829":40669,"_2311":40862},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_2783":506,"_24069":444,"_16893":40864,"_5":16788,"_22829":40669,"_2311":40865},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_2783":507,"_24069":444,"_16893":40867,"_5":16788,"_22829":40669,"_2311":40868},[],"Actions fall into two groups:",{"_2783":508,"_24069":444,"_16893":40870,"_5":16788,"_22829":40669,"_2311":40871},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_2783":509,"_24069":444,"_16893":40873,"_5":16788,"_22829":40669,"_2311":40874},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_2783":510,"_24069":444,"_16893":40876,"_5":16788,"_22829":40669,"_2311":40877},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_2783":511,"_24069":444,"_16893":40879,"_5":16788,"_22829":40673,"_2311":40880},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_2783":512,"_24069":444,"_16893":40882,"_5":16788,"_22829":40673,"_2311":40883},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_2783":513,"_24069":444,"_16893":40885,"_5":16788,"_22829":40673,"_2311":40886},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it. Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_2783":514,"_24069":444,"_16893":40888,"_5":16788,"_22829":40677,"_2311":40889},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_2783":515,"_24069":444,"_16893":40891,"_5":16788,"_22829":40677,"_2311":40892},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_2783":516,"_24069":444,"_16893":40894,"_5":16788,"_22829":40677,"_2311":40895},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_2783":517,"_24069":444,"_16893":40897,"_5":16788,"_22829":40677,"_2311":40898},[],"The implemented operators are:",{"_2783":518,"_24069":444,"_16893":40900,"_5":16788,"_22829":40677,"_2311":40901},[],"`equals`, for exact equality;",{"_2783":519,"_24069":444,"_16893":40903,"_5":16788,"_22829":40677,"_2311":40904},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_2783":520,"_24069":444,"_16893":40906,"_5":16788,"_22829":40677,"_2311":40907},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_2783":521,"_24069":444,"_16893":40909,"_5":16788,"_22829":40677,"_2311":40910},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_2783":522,"_24069":444,"_16893":40912,"_5":16788,"_22829":40681,"_2311":40913},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_2783":523,"_24069":444,"_16893":40915,"_5":16788,"_22829":40681,"_2311":40916},[],"The available modes are:",{"_2783":524,"_24069":444,"_16893":40918,"_5":16788,"_22829":40681,"_2311":40919},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_2783":525,"_24069":444,"_16893":40921,"_5":16788,"_22829":40681,"_2311":40922},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_2783":526,"_24069":444,"_16893":40924,"_5":16788,"_22829":40681,"_2311":40925},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_2783":527,"_24069":444,"_16893":40927,"_5":16788,"_22829":40681,"_2311":40928},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_2783":528,"_24069":444,"_16893":40930,"_5":16788,"_22829":40681,"_2311":40931},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_2783":529,"_24069":444,"_16893":40933,"_5":16788,"_22829":40681,"_2311":40934},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_2783":530,"_24069":444,"_16893":40936,"_5":16788,"_22829":40685,"_2311":40937},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_2783":531,"_24069":444,"_16893":40939,"_5":16788,"_22829":40685,"_2311":40940},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_2783":532,"_24069":444,"_16893":40942,"_5":16788,"_22829":40685,"_2311":40943},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_2783":533,"_24069":444,"_16893":40945,"_5":16788,"_22829":40685,"_2311":40946},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_2783":534,"_24069":444,"_16893":40948,"_5":16788,"_22829":40693,"_2311":40949},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_2783":535,"_24069":444,"_16893":40951,"_5":16788,"_22829":40693,"_2311":40952},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_2783":536,"_24069":444,"_16893":40954,"_5":16788,"_22829":40697,"_2311":40955},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_2783":537,"_24069":444,"_16893":40957,"_5":16788,"_22829":40697,"_2311":40958},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_2783":538,"_24069":444,"_16893":40960,"_5":16788,"_22829":40701,"_2311":40961},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_2783":539,"_24069":444,"_16893":40963,"_5":16788,"_22829":40701,"_2311":40964},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_2783":540,"_24069":444,"_16893":40966,"_5":16788,"_22829":40701,"_2311":40967},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_2783":541,"_24069":444,"_16893":40969,"_5":16788,"_22829":40705,"_2311":40970},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_2783":542,"_24069":444,"_16893":40972,"_5":16788,"_22829":40705,"_2311":40973},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_2783":543,"_24069":444,"_16893":40975,"_5":16788,"_22829":40705,"_2311":40976},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_2783":544,"_24069":444,"_16893":40978,"_5":16788,"_22829":40709,"_2311":40979},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_2783":545,"_24069":444,"_16893":40981,"_5":16788,"_22829":40709,"_2311":40982},[],"full and read-only access to certificates and authorities;",{"_2783":546,"_24069":444,"_16893":40984,"_5":16788,"_22829":40709,"_2311":40985},[],"full and read-only access to the KMS;",{"_2783":547,"_24069":444,"_16893":40987,"_5":16788,"_22829":40709,"_2311":40988},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_2783":548,"_24069":444,"_16893":40990,"_5":16788,"_22829":40709,"_2311":40991},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_2783":549,"_24069":444,"_16893":40993,"_5":16788,"_22829":40709,"_2311":40994},[],"console access;",{"_2783":550,"_24069":444,"_16893":40996,"_5":16788,"_22829":40709,"_2311":40997},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_2783":551,"_24069":444,"_16893":40999,"_5":16788,"_22829":40709,"_2311":41000},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_2783":552,"_24069":444,"_16893":41002,"_5":16788,"_22829":40709,"_2311":41003},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_2783":553,"_24069":444,"_16893":41005,"_5":16788,"_22829":40713,"_2311":41006},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_2783":554,"_24069":444,"_16893":41008,"_5":16788,"_22829":40713,"_2311":41009},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_2783":555,"_24069":444,"_16893":41011,"_5":16788,"_22829":40713,"_2311":41012},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_2783":556,"_24069":444,"_16893":41014,"_5":16788,"_22829":40716,"_2311":41015},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_2783":557,"_24069":444,"_16893":41017,"_5":16788,"_22829":40720,"_2311":41018},[],"The Gateway uses `auth.authentication.apiGateway.jwks` to authenticate requests. `authz` uses `services.authz.jwkUrl` to resolve OIDC principals. Both endpoints must contain the keys of the same issuer and be reachable from their respective components.",{"_2783":558,"_24069":444,"_16893":41020,"_5":16788,"_22829":40724,"_2311":41021},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_2783":559,"_24069":444,"_16893":41023,"_5":16788,"_22829":40728,"_2311":41024},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_2783":560,"_24069":444,"_16893":41026,"_5":16788,"_22829":40732,"_2311":41027},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_2783":561,"_24069":444,"_16893":41029,"_5":16788,"_22829":40736,"_2311":41030},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_2783":562,"_24069":444,"_16893":41032,"_5":16788,"_22829":40736,"_2311":41033},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_2783":563,"_24069":444,"_16893":41035,"_5":16788,"_22829":40740,"_2311":41036},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_2783":564,"_24069":444,"_16893":41038,"_5":16788,"_22829":40740,"_2311":41039},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_2783":565,"_24069":444,"_16893":41041,"_5":16788,"_22829":40740,"_2311":41042},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_2783":566,"_24069":444,"_16893":41044,"_5":16788,"_22829":40740,"_2311":41045},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_2783":567,"_24069":444,"_16893":41047,"_5":16788,"_22829":40740,"_2311":41048},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_2783":568,"_24069":444,"_16893":41050,"_5":16788,"_22829":40740,"_2311":41051},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_2783":569,"_24069":444,"_16893":41053,"_5":16788,"_22829":40740,"_2311":41054},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_2783":570,"_24069":444,"_16893":41056,"_5":16788,"_22829":40740,"_2311":41057},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_2783":571,"_24069":444,"_16893":41059,"_5":16788,"_22829":40744,"_2311":41060},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_2783":572,"_24069":444,"_16893":41062,"_5":16788,"_22829":40744,"_2311":41063},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_2783":573,"_24069":444,"_16893":41065,"_5":16788,"_22829":40744,"_2311":41066},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_2783":574,"_24069":444,"_16893":41068,"_5":16788,"_22829":40748,"_2311":41069},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_2783":575,"_24069":444,"_16893":41071,"_5":16788,"_22829":40748,"_2311":41072},[],"Use groups or stable roles for people and independent identities for automations.",{"_2783":576,"_24069":444,"_16893":41074,"_5":16788,"_22829":40748,"_2311":41075},[],"Keep at least two recovery administrators and test their access periodically.",{"_2783":577,"_24069":444,"_16893":41077,"_5":16788,"_22829":40748,"_2311":41078},[],"Review active principals, their matches and their grants after IdP changes.",{"_2783":578,"_24069":444,"_16893":41080,"_5":16788,"_22829":40748,"_2311":41081},[],"Search for wildcards in policies before upgrading Lamassu.",{"_2783":579,"_24069":444,"_16893":41083,"_5":16788,"_22829":40748,"_2311":41084},[],"Always test one allowed and one denied operation for each role.",{"_2783":580,"_24069":444,"_16893":41086,"_5":16788,"_22829":40748,"_2311":41087},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_2783":581,"_24069":444,"_16893":41089,"_5":16788,"_22829":40756,"_2311":41090},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_2783":582,"_24069":444,"_16893":41092,"_5":16788,"_22829":40760,"_2311":41093},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_2783":583,"_24069":444,"_16893":41095,"_5":16788,"_22829":40760,"_2311":41096},[],"that an active principal of the correct type exists;",{"_2783":584,"_24069":444,"_16893":41098,"_5":16788,"_22829":40760,"_2311":41099},[],"that the claim paths and values match the real token exactly;",{"_2783":585,"_24069":444,"_16893":41101,"_5":16788,"_22829":40760,"_2311":41102},[],"that all of the principal's conditions hold;",{"_2783":586,"_24069":444,"_16893":41104,"_5":16788,"_22829":40760,"_2311":41105},[],"that the principal has the expected policy granted;",{"_2783":587,"_24069":444,"_16893":41107,"_5":16788,"_22829":40760,"_2311":41108},[],"that the policy includes the action and the requested resource type or route;",{"_2783":588,"_24069":444,"_16893":41110,"_5":16788,"_22829":40760,"_2311":41111},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_2783":589,"_24069":444,"_16893":41113,"_5":16788,"_22829":40760,"_2311":41114},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure.",{"_2783":590,"_24069":444,"_16893":41116,"_5":16788,"_22829":40764,"_2311":41117},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_2783":591,"_24069":444,"_16893":41119,"_5":16788,"_22829":40768,"_2311":41120},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_2783":592,"_24069":444,"_16893":41122,"_5":16788,"_22829":40768,"_2311":41123},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_2783":593,"_24069":593,"_5":11891,"_2311":41125,"_24384":41126,"_16893":41127,"_22829":593},"Alerts and subscriptions",[39305,40649,40650],[],{"_2783":594,"_24069":593,"_16893":41129,"_5":16788,"_22829":593,"_2311":41130},[],"Send PKI events to people and external systems.",{"_2783":595,"_24069":593,"_5":24381,"_16893":41132,"_22829":41133,"_2311":41134},[],"/docs/platform/administration/alerts#how-it-works","How it works",{"_2783":596,"_24069":593,"_5":24381,"_16893":41136,"_22829":41137,"_2311":41138},[],"/docs/platform/administration/alerts#available-channels","Available channels",{"_2783":597,"_24069":593,"_5":24381,"_16893":41140,"_22829":41141,"_2311":41142},[],"/docs/platform/administration/alerts#create-a-subscription","Create a subscription",{"_2783":598,"_24069":593,"_5":24381,"_16893":41144,"_22829":41145,"_2311":41146},[],"/docs/platform/administration/alerts#choose-the-event","Choose the event",{"_2783":599,"_24069":593,"_5":24381,"_16893":41148,"_22829":41149,"_2311":41150},[],"/docs/platform/administration/alerts#configure-the-destination","Configure the destination",{"_2783":600,"_24069":593,"_5":24381,"_16893":41152,"_22829":41153,"_2311":41154},[],"/docs/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_2783":601,"_24069":593,"_5":24381,"_16893":41156,"_22829":41157,"_2311":41158},[],"/docs/platform/administration/alerts#review-and-activate","Review and activate",{"_2783":602,"_24069":593,"_5":24381,"_16893":41160,"_22829":41161,"_2311":41162},[],"/docs/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_2783":603,"_24069":593,"_5":24381,"_16893":41164,"_22829":41165,"_2311":41166},[],"/docs/platform/administration/alerts#event-families","Event families",{"_2783":604,"_24069":593,"_16893":41168,"_5":16788,"_22829":593,"_2311":41169},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_2783":605,"_24069":593,"_16893":41171,"_5":16788,"_22829":41133,"_2311":41172},[],"A service publishes a domain event.",{"_2783":606,"_24069":593,"_16893":41174,"_5":16788,"_22829":41133,"_2311":41175},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_2783":607,"_24069":593,"_16893":41177,"_5":16788,"_22829":41133,"_2311":41178},[],"Each subscription's filter decides whether it should be notified.",{"_2783":608,"_24069":593,"_16893":41180,"_5":16788,"_22829":41133,"_2311":41181},[],"Lamassu delivers the event to the configured channel.",{"_2783":609,"_24069":593,"_16893":41183,"_5":16788,"_22829":41133,"_2311":41184},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_2783":610,"_24069":593,"_16893":41186,"_5":16788,"_22829":41137,"_2311":41187},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address.",{"_2783":611,"_24069":593,"_16893":41189,"_5":16788,"_22829":41137,"_2311":41190},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_2783":612,"_24069":593,"_16893":41192,"_5":16788,"_22829":41137,"_2311":41193},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_2783":613,"_24069":593,"_16893":41195,"_5":16788,"_22829":41145,"_2311":41196},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_2783":614,"_24069":593,"_16893":41198,"_5":16788,"_22829":41149,"_2311":41199},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_2783":615,"_24069":593,"_16893":41201,"_5":16788,"_22829":41153,"_2311":41202},[],"Add a filter if you don't want to receive every instance of the event.",{"_2783":616,"_24069":593,"_16893":41204,"_5":16788,"_22829":41153,"_2311":41205},[],"**None** notifies all instances of the event.",{"_2783":617,"_24069":593,"_16893":41207,"_5":16788,"_22829":41153,"_2311":41208},[],"**JSON Path** evaluates one or more specific fields.",{"_2783":618,"_24069":593,"_16893":41210,"_5":16788,"_22829":41153,"_2311":41211},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_2783":619,"_24069":593,"_16893":41213,"_5":16788,"_22829":41153,"_2311":41214},[],"**JavaScript** lets you express custom logic.",{"_2783":620,"_24069":593,"_16893":41216,"_5":16788,"_22829":41153,"_2311":41217},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_2783":621,"_24069":593,"_16893":41219,"_5":16788,"_22829":41157,"_2311":41220},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_2783":622,"_24069":593,"_16893":41222,"_5":16788,"_22829":41161,"_2311":41223},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_2783":623,"_24069":593,"_16893":41225,"_5":16788,"_22829":41165,"_2311":41226},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_2783":624,"_24069":593,"_16893":41228,"_5":16788,"_22829":41165,"_2311":41229},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_2783":625,"_24069":593,"_16893":41231,"_5":16788,"_22829":41165,"_2311":41232},[],"**Profiles:** `profile.create`, `profile.update` and `profile.delete`.",{"_2783":626,"_24069":593,"_16893":41234,"_5":16788,"_22829":41165,"_2311":41235},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_2783":627,"_24069":593,"_16893":41237,"_5":16788,"_22829":41165,"_2311":41238},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_2783":628,"_24069":593,"_16893":41240,"_5":16788,"_22829":41165,"_2311":41241},[],"**Validation:** `va.role.crl.create`.",{"_2783":629,"_24069":593,"_16893":41243,"_5":16788,"_22829":41165,"_2311":41244},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign.message` and `kms.delete`.",{"_2783":630,"_24069":593,"_16893":41246,"_5":16788,"_22829":41165,"_2311":41247},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_2783":631,"_24069":631,"_5":11891,"_2311":41249,"_24384":41250,"_16893":41251,"_22829":631},"Audit logs",[39305,40649,40650],[],{"_2783":632,"_24069":631,"_16893":41253,"_5":16788,"_22829":631,"_2311":41254},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_2783":633,"_24069":631,"_5":24381,"_16893":41256,"_22829":41257,"_2311":41258},[],"/docs/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_2783":634,"_24069":631,"_5":24381,"_16893":41260,"_22829":41261,"_2311":41262},[],"/docs/platform/administration/audit-logs#coverage","Coverage",{"_2783":635,"_24069":631,"_5":24381,"_16893":41264,"_22829":41265,"_2311":41266},[],"/docs/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_2783":636,"_24069":631,"_5":24381,"_16893":41268,"_22829":41269,"_2311":41270},[],"/docs/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_2783":637,"_24069":631,"_5":24381,"_16893":41272,"_22829":41273,"_2311":41274},[],"/docs/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_2783":638,"_24069":631,"_5":24381,"_16893":41276,"_22829":41277,"_2311":41278},[],"/docs/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_2783":639,"_24069":631,"_5":24381,"_16893":41280,"_22829":41281,"_2311":41282},[],"/docs/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_2783":640,"_24069":631,"_5":24381,"_16893":41284,"_22829":41285,"_2311":41286},[],"/docs/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_2783":641,"_24069":631,"_5":24381,"_16893":41288,"_22829":41289,"_2311":41290},[],"/docs/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_2783":642,"_24069":631,"_5":24381,"_16893":41292,"_22829":41293,"_2311":41294},[],"/docs/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_2783":643,"_24069":631,"_5":24381,"_16893":41296,"_22829":41297,"_2311":41298},[],"/docs/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_2783":644,"_24069":631,"_16893":41300,"_5":16788,"_22829":631,"_2311":41301},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_2783":645,"_24069":631,"_16893":41303,"_5":16788,"_22829":41257,"_2311":41304},[],"The audit body includes:",{"_2783":646,"_24069":631,"_16893":41306,"_5":16788,"_22829":41257,"_2311":41307},[],"input: data received by the operation;",{"_2783":647,"_24069":631,"_16893":41309,"_5":16788,"_22829":41257,"_2311":41310},[],"has\\_error: whether the service returned an error;",{"_2783":648,"_24069":631,"_16893":41312,"_5":16788,"_22829":41257,"_2311":41313},[],"output: produced result or error message;",{"_2783":649,"_24069":631,"_16893":41315,"_5":16788,"_22829":41257,"_2311":41316},[],"principals: identifiers of the principals that matched the request.",{"_2783":650,"_24069":631,"_16893":41318,"_5":16788,"_22829":41257,"_2311":41319},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_2783":651,"_24069":631,"_16893":41321,"_5":16788,"_22829":41257,"_2311":41322},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_2783":652,"_24069":631,"_16893":41324,"_5":16788,"_22829":41261,"_2311":41325},[],"The backend applies auditing to mutations of:",{"_2783":653,"_24069":631,"_16893":41327,"_5":16788,"_22829":41261,"_2311":41328},[],"authorities, certificates and issuance profiles;",{"_2783":654,"_24069":631,"_16893":41330,"_5":16788,"_22829":41261,"_2311":41331},[],"keys and KMS engines;",{"_2783":655,"_24069":631,"_16893":41333,"_5":16788,"_22829":41261,"_2311":41334},[],"devices and identities;",{"_2783":656,"_24069":631,"_16893":41336,"_5":16788,"_22829":41261,"_2311":41337},[],"DMSs and enrollment operations;",{"_2783":657,"_24069":631,"_16893":41339,"_5":16788,"_22829":41261,"_2311":41340},[],"validation functions and CRL;",{"_2783":658,"_24069":631,"_16893":41342,"_5":16788,"_22829":41261,"_2311":41343},[],"principals, policies and authorization grants.",{"_2783":659,"_24069":631,"_16893":41345,"_5":16788,"_22829":41261,"_2311":41346},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_2783":660,"_24069":631,"_16893":41348,"_5":16788,"_22829":41265,"_2311":41349},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_2783":661,"_24069":631,"_16893":41351,"_5":16788,"_22829":41265,"_2311":41352},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_2783":662,"_24069":631,"_16893":41354,"_5":16788,"_22829":41265,"_2311":41355},[],"Design the consumer to:",{"_2783":663,"_24069":631,"_16893":41357,"_5":16788,"_22829":41265,"_2311":41358},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_2783":664,"_24069":631,"_16893":41360,"_5":16788,"_22829":41265,"_2311":41361},[],"keep the complete CloudEvent unmodified;",{"_2783":665,"_24069":631,"_16893":41363,"_5":16788,"_22829":41265,"_2311":41364},[],"record the ingestion time and detect duplicates by ID;",{"_2783":666,"_24069":631,"_16893":41366,"_5":16788,"_22829":41265,"_2311":41367},[],"encrypt in transit and at rest;",{"_2783":667,"_24069":631,"_16893":41369,"_5":16788,"_22829":41265,"_2311":41370},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_2783":668,"_24069":631,"_16893":41372,"_5":16788,"_22829":41265,"_2311":41373},[],"apply an explicit retention and legal hold policy;",{"_2783":669,"_24069":631,"_16893":41375,"_5":16788,"_22829":41265,"_2311":41376},[],"alert if it stops consuming or the pending queue grows.",{"_2783":670,"_24069":631,"_16893":41378,"_5":16788,"_22829":41269,"_2311":41379},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_2783":671,"_24069":631,"_16893":41381,"_5":16788,"_22829":41269,"_2311":41382},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_2783":672,"_24069":631,"_16893":41384,"_5":16788,"_22829":41277,"_2311":41385},[],"Start from the reported time and normalize every source to UTC.",{"_2783":673,"_24069":631,"_16893":41387,"_5":16788,"_22829":41281,"_2311":41388},[],"Filter by event type, service source and resource identifier.",{"_2783":674,"_24069":631,"_16893":41390,"_5":16788,"_22829":41285,"_2311":41391},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_2783":675,"_24069":631,"_16893":41393,"_5":16788,"_22829":41289,"_2311":41394},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_2783":676,"_24069":631,"_16893":41396,"_5":16788,"_22829":41293,"_2311":41397},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_2783":677,"_24069":631,"_16893":41399,"_5":16788,"_22829":41297,"_2311":41400},[],"Generate a controlled mutation in a test environment and check that:",{"_2783":678,"_24069":631,"_16893":41402,"_5":16788,"_22829":41297,"_2311":41403},[],"a successful audit event appears;",{"_2783":679,"_24069":631,"_16893":41405,"_5":16788,"_22829":41297,"_2311":41406},[],"the principal matches the identity used;",{"_2783":680,"_24069":631,"_16893":41408,"_5":16788,"_22829":41297,"_2311":41409},[],"the consumer persists it exactly once;",{"_2783":681,"_24069":631,"_16893":41411,"_5":16788,"_22829":41297,"_2311":41412},[],"it can be retrieved by resource, actor and period;",{"_2783":682,"_24069":631,"_16893":41414,"_5":16788,"_22829":41297,"_2311":41415},[],"a consumer outage raises an alert.",{"_2783":683,"_24069":631,"_16893":41417,"_5":16788,"_22829":41297,"_2311":41418},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_2783":684,"_24069":684,"_5":11891,"_2311":41420,"_24384":41421,"_16893":41422,"_22829":684},"Platform architecture",[39305,40649],[],{"_2783":685,"_24069":684,"_16893":41424,"_5":16788,"_22829":684,"_2311":41425},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_2783":686,"_24069":684,"_5":24381,"_16893":41427,"_22829":41428,"_2311":41429},[],"/docs/platform/concepts/architecture#control-plane","Control plane",{"_2783":687,"_24069":684,"_5":24381,"_16893":41431,"_22829":41432,"_2311":41433},[],"/docs/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_2783":688,"_24069":684,"_5":24381,"_16893":41435,"_22829":41436,"_2311":41437},[],"/docs/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_2783":689,"_24069":684,"_5":24381,"_16893":41439,"_22829":41440,"_2311":41441},[],"/docs/platform/concepts/architecture#status-and-validation","Status and validation",{"_2783":690,"_24069":684,"_5":24381,"_16893":41443,"_22829":41444,"_2311":41445},[],"/docs/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_2783":691,"_24069":684,"_16893":41447,"_5":16788,"_22829":684,"_2311":41448},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_2783":692,"_24069":684,"_16893":41450,"_5":16788,"_22829":684,"_2311":41451},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_2783":693,"_24069":684,"_16893":41453,"_5":16788,"_22829":41428,"_2311":41454},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_2783":694,"_24069":684,"_16893":41456,"_5":16788,"_22829":41432,"_2311":41457},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_2783":695,"_24069":684,"_16893":41459,"_5":16788,"_22829":41436,"_2311":41460},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_2783":696,"_24069":684,"_16893":41462,"_5":16788,"_22829":41440,"_2311":41463},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_2783":697,"_24069":684,"_16893":41465,"_5":16788,"_22829":41444,"_2311":41466},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_2783":698,"_24069":698,"_5":11891,"_2311":41468,"_24384":41469,"_16893":41470,"_22829":698},"How Lamassu works",[39305,40649],[],{"_2783":699,"_24069":698,"_16893":41472,"_5":16788,"_22829":698,"_2311":41473},[],"The mental model of trust, keys, certificates and devices.",{"_2783":700,"_24069":698,"_5":24381,"_16893":41475,"_22829":41476,"_2311":41477},[],"/docs/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_2783":701,"_24069":698,"_5":24381,"_16893":41479,"_22829":41480,"_2311":41481},[],"/docs/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_2783":702,"_24069":698,"_16893":41483,"_5":16788,"_22829":698,"_2311":41484},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_2783":703,"_24069":698,"_16893":41486,"_5":16788,"_22829":41476,"_2311":41487},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_2783":704,"_24069":698,"_16893":41489,"_5":16788,"_22829":41476,"_2311":41490},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_2783":705,"_24069":698,"_16893":41492,"_5":16788,"_22829":41476,"_2311":41493},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_2783":706,"_24069":698,"_16893":41495,"_5":16788,"_22829":41476,"_2311":41496},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_2783":707,"_24069":698,"_16893":41498,"_5":16788,"_22829":41476,"_2311":41499},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_2783":708,"_24069":698,"_16893":41501,"_5":16788,"_22829":41480,"_2311":41502},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_2783":709,"_24069":698,"_16893":41504,"_5":16788,"_22829":41480,"_2311":41505},[],"A DMS relates that CA to an enrollment policy.",{"_2783":710,"_24069":698,"_16893":41507,"_5":16788,"_22829":41480,"_2311":41508},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_2783":711,"_24069":698,"_16893":41510,"_5":16788,"_22829":41480,"_2311":41511},[],"Lamassu keeps the inventory, history and status of the identity.",{"_2783":712,"_24069":698,"_16893":41513,"_5":16788,"_22829":41480,"_2311":41514},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_2783":713,"_24069":698,"_16893":41516,"_5":16788,"_22829":41480,"_2311":41517},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_2783":714,"_24069":698,"_16893":41519,"_5":16788,"_22829":41480,"_2311":41520},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2783":715,"_24069":715,"_5":11891,"_2311":41522,"_24384":41523,"_16893":41525,"_22829":715},"Devices and identities",[39305,40649,41524,41522],"IoT Fleets",[],{"_2783":716,"_24069":715,"_16893":41527,"_5":16788,"_22829":715,"_2311":41528},[],"Register, inspect and retire devices while checking their current identity and history.",{"_2783":717,"_24069":715,"_5":24381,"_16893":41530,"_22829":41531,"_2311":41532},[],"/docs/platform/iot-fleets/device-management#device-states","Device states",{"_2783":718,"_24069":715,"_5":24381,"_16893":41534,"_22829":41535,"_2311":41536},[],"/docs/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_2783":719,"_24069":715,"_5":24381,"_16893":41538,"_22829":41539,"_2311":41540},[],"/docs/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_2783":720,"_24069":715,"_5":24381,"_16893":41542,"_22829":41543,"_2311":41544},[],"/docs/platform/iot-fleets/device-management#create-the-device","Create the device",{"_2783":721,"_24069":715,"_5":24381,"_16893":41546,"_22829":41547,"_2311":41548},[],"/docs/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_2783":722,"_24069":715,"_5":24381,"_16893":41550,"_22829":41551,"_2311":41552},[],"/docs/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_2783":723,"_24069":715,"_5":24381,"_16893":41554,"_22829":41555,"_2311":41556},[],"/docs/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_2783":724,"_24069":715,"_5":24381,"_16893":41558,"_22829":41559,"_2311":41560},[],"/docs/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_2783":725,"_24069":715,"_5":24381,"_16893":41562,"_22829":41563,"_2311":41564},[],"/docs/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_2783":726,"_24069":715,"_5":24381,"_16893":41566,"_22829":41567,"_2311":41568},[],"/docs/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_2783":727,"_24069":715,"_5":24381,"_16893":41570,"_22829":41571,"_2311":41572},[],"/docs/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_2783":728,"_24069":715,"_16893":41574,"_5":16788,"_22829":715,"_2311":41575},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_2783":729,"_24069":715,"_16893":41577,"_5":16788,"_22829":715,"_2311":41578},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_2783":730,"_24069":715,"_16893":41580,"_5":16788,"_22829":41531,"_2311":41581},[],"Operational view",{"_2783":731,"_24069":715,"_16893":41583,"_5":16788,"_22829":41531,"_2311":41584},[],"Meaning",{"_2783":732,"_24069":715,"_16893":41586,"_5":16788,"_22829":41531,"_2311":41587},[],"**No Identity**",{"_2783":733,"_24069":715,"_16893":41589,"_5":16788,"_22829":41531,"_2311":41590},[],"A record exists without an associated identity.",{"_2783":734,"_24069":715,"_16893":41592,"_5":16788,"_22829":41531,"_2311":41593},[],"**Active**",{"_2783":735,"_24069":715,"_16893":41595,"_5":16788,"_22829":41531,"_2311":41596},[],"The slot is active; also check certificate dates, status and usages.",{"_2783":736,"_24069":715,"_16893":41598,"_5":16788,"_22829":41531,"_2311":41599},[],"**Renewal Pending**",{"_2783":737,"_24069":715,"_16893":41601,"_5":16788,"_22829":41531,"_2311":41602},[],"The identity is in the operational renewal window.",{"_2783":738,"_24069":715,"_16893":41604,"_5":16788,"_22829":41531,"_2311":41605},[],"**Expiring Soon**",{"_2783":739,"_24069":715,"_16893":41607,"_5":16788,"_22829":41531,"_2311":41608},[],"Expiration is approaching according to configured thresholds.",{"_2783":740,"_24069":715,"_16893":41610,"_5":16788,"_22829":41531,"_2311":41611},[],"**Expired**",{"_2783":741,"_24069":715,"_16893":41613,"_5":16788,"_22829":41531,"_2311":41614},[],"The identity has expired.",{"_2783":742,"_24069":715,"_16893":41616,"_5":16788,"_22829":41531,"_2311":41617},[],"**Revoked**",{"_2783":743,"_24069":715,"_16893":41619,"_5":16788,"_22829":41531,"_2311":41620},[],"The identity is marked revoked.",{"_2783":744,"_24069":715,"_16893":41622,"_5":16788,"_22829":41531,"_2311":41623},[],"**Decommissioned**",{"_2783":745,"_24069":715,"_16893":41625,"_5":16788,"_22829":41531,"_2311":41626},[],"The record is retired and ordinary updates do not restore operation.",{"_2783":746,"_24069":715,"_16893":41628,"_5":16788,"_22829":41531,"_2311":41629},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_2783":747,"_24069":715,"_16893":41631,"_5":16788,"_22829":41535,"_2311":41632},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_2783":748,"_24069":715,"_16893":41634,"_5":16788,"_22829":41535,"_2311":41635},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_2783":749,"_24069":715,"_16893":41637,"_5":16788,"_22829":41535,"_2311":41638},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_2783":750,"_24069":715,"_16893":41640,"_5":16788,"_22829":41535,"_2311":41641},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_2783":751,"_24069":715,"_16893":41643,"_5":16788,"_22829":41539,"_2311":41644},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_2783":752,"_24069":715,"_16893":41646,"_5":16788,"_22829":41543,"_2311":41647},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_2783":753,"_24069":715,"_16893":41649,"_5":16788,"_22829":41547,"_2311":41650},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_2783":754,"_24069":715,"_16893":41652,"_5":16788,"_22829":41551,"_2311":41653},[],"Add model, environment or location tags and an icon according to your inventory.",{"_2783":755,"_24069":715,"_16893":41655,"_5":16788,"_22829":41555,"_2311":41656},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_2783":756,"_24069":715,"_16893":41658,"_5":16788,"_22829":41555,"_2311":41659},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_2783":757,"_24069":715,"_16893":41661,"_5":16788,"_22829":41559,"_2311":41662},[],"From **No Identity**, use **Assign Identity**:",{"_2783":758,"_24069":715,"_16893":41664,"_5":16788,"_22829":41559,"_2311":41665},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_2783":759,"_24069":715,"_16893":41667,"_5":16788,"_22829":41559,"_2311":41668},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_2783":760,"_24069":715,"_16893":41670,"_5":16788,"_22829":41559,"_2311":41671},[],"Confirm and read the serial, active version and history again.",{"_2783":761,"_24069":715,"_16893":41673,"_5":16788,"_22829":41559,"_2311":41674},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_2783":762,"_24069":715,"_16893":41676,"_5":16788,"_22829":41559,"_2311":41677},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_2783":763,"_24069":715,"_16893":41679,"_5":16788,"_22829":41563,"_2311":41680},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_2783":764,"_24069":715,"_16893":41682,"_5":16788,"_22829":41563,"_2311":41683},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_2783":765,"_24069":715,"_16893":41685,"_5":16788,"_22829":41567,"_2311":41686},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_2783":766,"_24069":715,"_16893":41688,"_5":16788,"_22829":41567,"_2311":41689},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_2783":767,"_24069":715,"_16893":41691,"_5":16788,"_22829":41567,"_2311":41692},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_2783":768,"_24069":715,"_16893":41694,"_5":16788,"_22829":41567,"_2311":41695},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_2783":769,"_24069":715,"_16893":41697,"_5":16788,"_22829":41571,"_2311":41698},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2783":770,"_24069":715,"_16893":41700,"_5":16788,"_22829":41571,"_2311":41701},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2783":771,"_24069":771,"_5":11891,"_2311":41703,"_24384":41704,"_16893":41706,"_22829":771},"Bootstrap identity and authentication",[39305,40649,41524,41522,41705],"Enrollment with PKI",[],{"_2783":772,"_24069":771,"_16893":41708,"_5":16788,"_22829":771,"_2311":41709},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_2783":773,"_24069":771,"_5":24381,"_16893":41711,"_22829":41712,"_2311":41713},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_2783":774,"_24069":771,"_5":24381,"_16893":41715,"_22829":41716,"_2311":41717},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_2783":775,"_24069":771,"_5":24381,"_16893":41719,"_22829":41720,"_2311":41721},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_2783":776,"_24069":771,"_5":24381,"_16893":41723,"_22829":41724,"_2311":41725},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_2783":777,"_24069":771,"_5":24381,"_16893":41727,"_22829":41728,"_2311":41729},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_2783":778,"_24069":771,"_16893":41731,"_5":16788,"_22829":771,"_2311":41732},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_2783":779,"_24069":771,"_16893":41734,"_5":16788,"_22829":41712,"_2311":41735},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_2783":780,"_24069":771,"_16893":41737,"_5":16788,"_22829":41712,"_2311":41738},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_2783":781,"_24069":771,"_16893":41740,"_5":16788,"_22829":41716,"_2311":41741},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_2783":782,"_24069":771,"_16893":41743,"_5":16788,"_22829":41716,"_2311":41744},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_2783":783,"_24069":771,"_16893":41746,"_5":16788,"_22829":41716,"_2311":41747},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_2783":784,"_24069":771,"_16893":41749,"_5":16788,"_22829":41720,"_2311":41750},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_2783":785,"_24069":771,"_16893":41752,"_5":16788,"_22829":41720,"_2311":41753},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_2783":786,"_24069":771,"_16893":41755,"_5":16788,"_22829":41724,"_2311":41756},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout.",{"_2783":787,"_24069":771,"_16893":41758,"_5":16788,"_22829":41724,"_2311":41759},[],"Example body:",{"_2783":788,"_24069":771,"_16893":41761,"_5":16788,"_22829":41724,"_2311":41762},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_2783":789,"_24069":771,"_16893":41764,"_5":16788,"_22829":41724,"_2311":41765},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_2783":790,"_24069":771,"_16893":41767,"_5":16788,"_22829":41724,"_2311":41768},[],"Continuation requires a successful HTTP response and JSON:",{"_2783":791,"_24069":771,"_16893":41770,"_5":16788,"_22829":41724,"_2311":41771},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_2783":792,"_24069":771,"_16893":41773,"_5":16788,"_22829":41728,"_2311":41774},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_2783":793,"_24069":771,"_16893":41776,"_5":16788,"_22829":41728,"_2311":41777},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_2783":794,"_24069":794,"_5":11891,"_2311":41779,"_24384":41780,"_16893":41781,"_22829":794},"Configure and operate the DMS",[39305,40649,41524,41522,41705],[],{"_2783":795,"_24069":794,"_16893":41783,"_5":16788,"_22829":794,"_2311":41784},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_2783":796,"_24069":794,"_5":24381,"_16893":41786,"_22829":41787,"_2311":39315},[],"/docs/platform/iot-fleets/enrollment/dms#before-you-begin",{"_2783":797,"_24069":794,"_5":24381,"_16893":41789,"_22829":41790,"_2311":41791},[],"/docs/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_2783":798,"_24069":794,"_5":24381,"_16893":41793,"_22829":41794,"_2311":41795},[],"/docs/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_2783":799,"_24069":794,"_5":24381,"_16893":41797,"_22829":41798,"_2311":41799},[],"/docs/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_2783":800,"_24069":794,"_5":24381,"_16893":41801,"_22829":41802,"_2311":41803},[],"/docs/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_2783":801,"_24069":794,"_5":24381,"_16893":41805,"_22829":41806,"_2311":41807},[],"/docs/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_2783":802,"_24069":794,"_5":24381,"_16893":41809,"_22829":41810,"_2311":41811},[],"/docs/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_2783":803,"_24069":794,"_5":24381,"_16893":41813,"_22829":41814,"_2311":41815},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_2783":804,"_24069":794,"_5":24381,"_16893":41817,"_22829":41818,"_2311":41819},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_2783":805,"_24069":794,"_5":24381,"_16893":41821,"_22829":41822,"_2311":41823},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_2783":806,"_24069":794,"_5":24381,"_16893":41825,"_22829":41826,"_2311":41827},[],"/docs/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_2783":807,"_24069":794,"_5":24381,"_16893":41829,"_22829":41830,"_2311":41831},[],"/docs/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_2783":808,"_24069":794,"_5":24381,"_16893":41833,"_22829":41834,"_2311":41835},[],"/docs/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_2783":809,"_24069":794,"_5":24381,"_16893":41837,"_22829":41838,"_2311":41839},[],"/docs/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_2783":810,"_24069":794,"_5":24381,"_16893":41841,"_22829":41842,"_2311":41843},[],"/docs/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_2783":811,"_24069":794,"_5":24381,"_16893":41845,"_22829":41846,"_2311":41847},[],"/docs/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_2783":812,"_24069":794,"_5":24381,"_16893":41849,"_22829":41850,"_2311":41851},[],"/docs/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_2783":813,"_24069":794,"_16893":41853,"_5":16788,"_22829":794,"_2311":41854},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_2783":814,"_24069":794,"_16893":41856,"_5":16788,"_22829":41787,"_2311":41857},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_2783":815,"_24069":794,"_16893":41859,"_5":16788,"_22829":41787,"_2311":41860},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_2783":816,"_24069":794,"_16893":41862,"_5":16788,"_22829":41794,"_2311":41863},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_2783":817,"_24069":794,"_16893":41865,"_5":16788,"_22829":41798,"_2311":41866},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_2783":818,"_24069":794,"_16893":41868,"_5":16788,"_22829":41802,"_2311":41869},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_2783":819,"_24069":794,"_16893":41871,"_5":16788,"_22829":41806,"_2311":41872},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_2783":820,"_24069":794,"_16893":41874,"_5":16788,"_22829":41810,"_2311":41875},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_2783":821,"_24069":794,"_16893":41877,"_5":16788,"_22829":41818,"_2311":41878},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_2783":822,"_24069":794,"_16893":41880,"_5":16788,"_22829":41818,"_2311":41881},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_2783":823,"_24069":794,"_16893":41883,"_5":16788,"_22829":41822,"_2311":41884},[],"`settings.enrollment_settings` field",{"_2783":824,"_24069":794,"_16893":41886,"_5":16788,"_22829":41822,"_2311":41887},[],"Decision",{"_2783":825,"_24069":794,"_16893":41889,"_5":16788,"_22829":41822,"_2311":41890},[],"`protocol`",{"_2783":826,"_24069":794,"_16893":41892,"_5":16788,"_22829":41822,"_2311":41893},[],"`EST_RFC7030` for these operations.",{"_2783":827,"_24069":794,"_16893":41895,"_5":16788,"_22829":41822,"_2311":41896},[],"`enrollment_ca`",{"_2783":828,"_24069":794,"_16893":41898,"_5":16788,"_22829":41822,"_2311":41899},[],"ID of the signing CA.",{"_2783":829,"_24069":794,"_16893":41901,"_5":16788,"_22829":41822,"_2311":41902},[],"`verify_csr_signature`",{"_2783":830,"_24069":794,"_16893":41904,"_5":16788,"_22829":41822,"_2311":41905},[],"Keep `true` to verify CSR key possession.",{"_2783":831,"_24069":794,"_16893":41907,"_5":16788,"_22829":41822,"_2311":41908},[],"`enable_replaceable_enrollment`",{"_2783":832,"_24069":794,"_16893":41910,"_5":16788,"_22829":41822,"_2311":41911},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_2783":833,"_24069":794,"_16893":41913,"_5":16788,"_22829":41822,"_2311":41914},[],"`est_rfc7030_settings.auth_mode`",{"_2783":834,"_24069":794,"_16893":41916,"_5":16788,"_22829":41822,"_2311":41917},[],"One of the four authentication modes.",{"_2783":835,"_24069":794,"_16893":41919,"_5":16788,"_22829":41822,"_2311":41920},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_2783":836,"_24069":794,"_16893":41922,"_5":16788,"_22829":41826,"_2311":41923},[],"The blocks are independent:",{"_2783":837,"_24069":794,"_16893":41925,"_5":16788,"_22829":41826,"_2311":41926},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_2783":838,"_24069":794,"_16893":41928,"_5":16788,"_22829":41826,"_2311":41929},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_2783":839,"_24069":794,"_16893":41931,"_5":16788,"_22829":41826,"_2311":41932},[],"`auth_mode`",{"_2783":840,"_24069":794,"_16893":41934,"_5":16788,"_22829":41826,"_2311":41935},[],"Control applied in the configured operation",{"_2783":841,"_24069":794,"_16893":41937,"_5":16788,"_22829":41826,"_2311":41938},[],"`CLIENT_CERTIFICATE`",{"_2783":842,"_24069":794,"_16893":41940,"_5":16788,"_22829":41826,"_2311":41941},[],"Presented certificate validation.",{"_2783":843,"_24069":794,"_16893":41943,"_5":16788,"_22829":41826,"_2311":41944},[],"`EXTERNAL_WEBHOOK`",{"_2783":844,"_24069":794,"_16893":41946,"_5":16788,"_22829":41826,"_2311":41947},[],"Configured webhook authorization.",{"_2783":845,"_24069":794,"_16893":41949,"_5":16788,"_22829":41826,"_2311":41950},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_2783":846,"_24069":794,"_16893":41952,"_5":16788,"_22829":41826,"_2311":41953},[],"Certificate validation followed by webhook approval.",{"_2783":847,"_24069":794,"_16893":41955,"_5":16788,"_22829":41826,"_2311":41956},[],"`NO_AUTH`",{"_2783":848,"_24069":794,"_16893":41958,"_5":16788,"_22829":41826,"_2311":41959},[],"No DMS requester authentication.",{"_2783":849,"_24069":794,"_16893":41961,"_5":16788,"_22829":41826,"_2311":41962},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_2783":850,"_24069":794,"_16893":41964,"_5":16788,"_22829":41826,"_2311":41965},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_2783":851,"_24069":794,"_16893":41967,"_5":16788,"_22829":41826,"_2311":41968},[],"For certificate re-enrollment, the validator uses the enrollment CA, then `additional_validation_cas`, and `enable_expired_renewal`. Do not assume copying initial `validation_cas` changes those issuers.",{"_2783":852,"_24069":794,"_16893":41970,"_5":16788,"_22829":41826,"_2311":41971},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_2783":853,"_24069":794,"_16893":41973,"_5":16788,"_22829":41826,"_2311":41974},[],"Migration `20260604110000` copies initial authentication into renewal settings if missing and the required structure exists. It preserves existing configuration. After upgrading, read both blocks; if your version’s console does not expose independent settings, use the DMS API.",{"_2783":854,"_24069":794,"_16893":41976,"_5":16788,"_22829":41830,"_2311":41977},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_2783":855,"_24069":794,"_16893":41979,"_5":16788,"_22829":41834,"_2311":41980},[],"`settings.reenrollment_settings` field",{"_2783":856,"_24069":794,"_16893":41982,"_5":16788,"_22829":41834,"_2311":39688},[],{"_2783":857,"_24069":794,"_16893":41984,"_5":16788,"_22829":41834,"_2311":41985},[],"`reenrollment_delta`",{"_2783":858,"_24069":794,"_16893":41987,"_5":16788,"_22829":41834,"_2311":41988},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_2783":859,"_24069":794,"_16893":41990,"_5":16788,"_22829":41834,"_2311":41991},[],"`preventive_delta`",{"_2783":860,"_24069":794,"_16893":41993,"_5":16788,"_22829":41834,"_2311":41994},[],"Preventive operational monitoring threshold.",{"_2783":861,"_24069":794,"_16893":41996,"_5":16788,"_22829":41834,"_2311":41997},[],"`critical_delta`",{"_2783":862,"_24069":794,"_16893":41999,"_5":16788,"_22829":41834,"_2311":42000},[],"Critical operational monitoring threshold.",{"_2783":863,"_24069":794,"_16893":42002,"_5":16788,"_22829":41834,"_2311":42003},[],"`enable_expired_renewal`",{"_2783":864,"_24069":794,"_16893":42005,"_5":16788,"_22829":41834,"_2311":42006},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_2783":865,"_24069":794,"_16893":42008,"_5":16788,"_22829":41834,"_2311":42009},[],"`additional_validation_cas`",{"_2783":866,"_24069":794,"_16893":42011,"_5":16788,"_22829":41834,"_2311":42012},[],"Additional mTLS credential issuers during migration.",{"_2783":867,"_24069":794,"_16893":42014,"_5":16788,"_22829":41834,"_2311":42015},[],"`revoke_on_reenrollment`",{"_2783":868,"_24069":794,"_16893":42017,"_5":16788,"_22829":41834,"_2311":42018},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_2783":869,"_24069":794,"_16893":42020,"_5":16788,"_22829":41834,"_2311":42021},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_2783":870,"_24069":794,"_16893":42023,"_5":16788,"_22829":41838,"_2311":42024},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. Algorithm and size come from its `key` field; the profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_2783":871,"_24069":794,"_16893":42026,"_5":16788,"_22829":41842,"_2311":39682},[],{"_2783":872,"_24069":794,"_16893":42028,"_5":16788,"_22829":41842,"_2311":42029},[],"Published material",{"_2783":873,"_24069":794,"_16893":42031,"_5":16788,"_22829":41842,"_2311":42032},[],"**Include Lamassu System CA**",{"_2783":874,"_24069":794,"_16893":42034,"_5":16788,"_22829":41842,"_2311":42035},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_2783":875,"_24069":794,"_16893":42037,"_5":16788,"_22829":41842,"_2311":42038},[],"**Include Enrollment CA**",{"_2783":876,"_24069":794,"_16893":42040,"_5":16788,"_22829":41842,"_2311":42041},[],"Selected issuing CA certificate.",{"_2783":877,"_24069":794,"_16893":42043,"_5":16788,"_22829":41842,"_2311":42044},[],"**Managed CAs**",{"_2783":878,"_24069":794,"_16893":42046,"_5":16788,"_22829":41842,"_2311":42047},[],"Explicitly selected CA certificates.",{"_2783":879,"_24069":794,"_16893":42049,"_5":16788,"_22829":41842,"_2311":42050},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_2783":880,"_24069":794,"_16893":42052,"_5":16788,"_22829":41846,"_2311":42053},[],"**Edit** changes name, settings and metadata. Backend updates replace these complete blocks; read the DMS before sending API edits to avoid losing fields.",{"_2783":881,"_24069":794,"_16893":42055,"_5":16788,"_22829":41846,"_2311":42056},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_2783":882,"_24069":794,"_16893":42058,"_5":16788,"_22829":41846,"_2311":42059},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_2783":883,"_24069":794,"_16893":42061,"_5":16788,"_22829":41850,"_2311":42062},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_2783":884,"_24069":884,"_5":11891,"_2311":42064,"_24384":42065,"_16893":42066,"_22829":884},"Integrate the EST client",[39305,40649,41524,41522,41705],[],{"_2783":885,"_24069":884,"_16893":42068,"_5":16788,"_22829":884,"_2311":42069},[],"Prepare trust, send a CSR and check the identity you receive.",{"_2783":886,"_24069":884,"_5":24381,"_16893":42071,"_22829":42072,"_2311":39315},[],"/docs/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_2783":887,"_24069":884,"_5":24381,"_16893":42074,"_22829":42075,"_2311":42076},[],"/docs/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_2783":888,"_24069":884,"_5":24381,"_16893":42078,"_22829":42079,"_2311":42080},[],"/docs/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_2783":889,"_24069":884,"_5":24381,"_16893":42082,"_22829":42083,"_2311":42084},[],"/docs/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_2783":890,"_24069":884,"_5":24381,"_16893":42086,"_22829":42087,"_2311":42088},[],"/docs/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_2783":891,"_24069":884,"_5":24381,"_16893":42090,"_22829":42091,"_2311":42092},[],"/docs/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_2783":892,"_24069":884,"_16893":42094,"_5":16788,"_22829":884,"_2311":42095},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_2783":893,"_24069":884,"_16893":42097,"_5":16788,"_22829":42072,"_2311":42098},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_2783":894,"_24069":884,"_16893":42100,"_5":16788,"_22829":42072,"_2311":42101},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_2783":895,"_24069":884,"_16893":42103,"_5":16788,"_22829":42072,"_2311":42104},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_2783":896,"_24069":884,"_16893":42106,"_5":16788,"_22829":42075,"_2311":42107},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_2783":897,"_24069":884,"_16893":42109,"_5":16788,"_22829":42075,"_2311":42110},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_2783":898,"_24069":884,"_16893":42112,"_5":16788,"_22829":42079,"_2311":42113},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_2783":899,"_24069":884,"_16893":42115,"_5":16788,"_22829":42079,"_2311":42116},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_2783":900,"_24069":884,"_16893":42118,"_5":16788,"_22829":42083,"_2311":42119},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_2783":901,"_24069":884,"_16893":42121,"_5":16788,"_22829":42083,"_2311":42122},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_2783":902,"_24069":884,"_16893":42124,"_5":16788,"_22829":42087,"_2311":42125},[],"For a root that issues directly:",{"_2783":903,"_24069":884,"_16893":42127,"_5":16788,"_22829":42087,"_2311":42128},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_2783":904,"_24069":884,"_16893":42130,"_5":16788,"_22829":42087,"_2311":42131},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_2783":905,"_24069":884,"_16893":42133,"_5":16788,"_22829":42091,"_2311":42134},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_2783":906,"_24069":906,"_5":11891,"_2311":42136,"_24384":42137,"_16893":42138,"_22829":906},"EST reference",[39305,40649,41524,41522,41705],[],{"_2783":907,"_24069":906,"_16893":42140,"_5":16788,"_22829":906,"_2311":42141},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_2783":908,"_24069":906,"_5":24381,"_16893":42143,"_22829":42144,"_2311":42145},[],"/docs/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_2783":909,"_24069":906,"_5":24381,"_16893":42147,"_22829":42148,"_2311":18303},[],"/docs/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2783":910,"_24069":906,"_5":24381,"_16893":42150,"_22829":42151,"_2311":20997},[],"/docs/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2783":911,"_24069":906,"_5":24381,"_16893":42153,"_22829":42154,"_2311":21004},[],"/docs/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2783":912,"_24069":906,"_5":24381,"_16893":42156,"_22829":42157,"_2311":20373},[],"/docs/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2783":913,"_24069":906,"_5":24381,"_16893":42159,"_22829":42160,"_2311":42161},[],"/docs/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_2783":914,"_24069":906,"_5":24381,"_16893":42163,"_22829":42164,"_2311":42165},[],"/docs/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_2783":915,"_24069":906,"_5":24381,"_16893":42167,"_22829":42168,"_2311":42169},[],"/docs/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_2783":916,"_24069":906,"_16893":42171,"_5":16788,"_22829":906,"_2311":42172},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_2783":917,"_24069":906,"_16893":42174,"_5":16788,"_22829":42144,"_2311":42175},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_2783":918,"_24069":906,"_16893":42177,"_5":16788,"_22829":42144,"_2311":42178},[],"Operation",{"_2783":919,"_24069":906,"_16893":42180,"_5":16788,"_22829":42144,"_2311":42181},[],"Method",{"_2783":920,"_24069":906,"_16893":42183,"_5":16788,"_22829":42144,"_2311":42184},[],"Authentication and condition",{"_2783":921,"_24069":906,"_16893":42186,"_5":16788,"_22829":42144,"_2311":42187},[],"`/cacerts`",{"_2783":922,"_24069":906,"_16893":42189,"_5":16788,"_22829":42144,"_2311":42190},[],"GET",{"_2783":923,"_24069":906,"_16893":42192,"_5":16788,"_22829":42144,"_2311":42193},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_2783":924,"_24069":906,"_16893":42195,"_5":16788,"_22829":42144,"_2311":42196},[],"`/simpleenroll`",{"_2783":925,"_24069":906,"_16893":42198,"_5":16788,"_22829":42144,"_2311":42199},[],"POST",{"_2783":926,"_24069":906,"_16893":42201,"_5":16788,"_22829":42144,"_2311":42202},[],"Initial authentication and DMS registration/replacement policy.",{"_2783":927,"_24069":906,"_16893":42204,"_5":16788,"_22829":42144,"_2311":42205},[],"`/simplereenroll`",{"_2783":928,"_24069":906,"_16893":42207,"_5":16788,"_22829":42144,"_2311":42199},[],{"_2783":929,"_24069":906,"_16893":42209,"_5":16788,"_22829":42144,"_2311":42210},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_2783":930,"_24069":906,"_16893":42212,"_5":16788,"_22829":42144,"_2311":42213},[],"`/serverkeygen`",{"_2783":931,"_24069":906,"_16893":42215,"_5":16788,"_22829":42144,"_2311":42199},[],{"_2783":932,"_24069":906,"_16893":42217,"_5":16788,"_22829":42144,"_2311":42218},[],"Initial authentication and admission; server generation enabled.",{"_2783":933,"_24069":906,"_16893":42220,"_5":16788,"_22829":42144,"_2311":42221},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_2783":934,"_24069":906,"_16893":42223,"_5":16788,"_22829":42148,"_2311":42224},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_2783":935,"_24069":906,"_16893":42226,"_5":16788,"_22829":42148,"_2311":42227},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_2783":936,"_24069":906,"_16893":42229,"_5":16788,"_22829":42151,"_2311":42230},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_2783":937,"_24069":906,"_16893":42232,"_5":16788,"_22829":42151,"_2311":42233},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_2783":938,"_24069":906,"_16893":42235,"_5":16788,"_22829":42154,"_2311":42236},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_2783":939,"_24069":906,"_16893":42238,"_5":16788,"_22829":42154,"_2311":42239},[],"The enrollment CA or an additional CA validates the credential in mTLS mode. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_2783":940,"_24069":906,"_16893":42241,"_5":16788,"_22829":42157,"_2311":42242},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_2783":941,"_24069":906,"_16893":42244,"_5":16788,"_22829":42157,"_2311":42245},[],"The code supports RSA and ECDSA with 224, 256, 384 or 521 bits. An unrecognized ECDSA size can fall back to 256; explicitly select a compatible size and check the resulting key. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_2783":942,"_24069":906,"_16893":42247,"_5":16788,"_22829":42160,"_2311":42248},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_2783":943,"_24069":906,"_16893":42250,"_5":16788,"_22829":42160,"_2311":42251},[],"Part",{"_2783":944,"_24069":906,"_16893":42253,"_5":16788,"_22829":42160,"_2311":42254},[],"Content after decoding its Base64",{"_2783":945,"_24069":906,"_16893":42256,"_5":16788,"_22829":42160,"_2311":42257},[],"`application/pkcs8`",{"_2783":946,"_24069":906,"_16893":42259,"_5":16788,"_22829":42160,"_2311":42260},[],"Unencrypted DER PKCS#8 private key.",{"_2783":947,"_24069":906,"_16893":42262,"_5":16788,"_22829":42160,"_2311":42263},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_2783":948,"_24069":906,"_16893":42265,"_5":16788,"_22829":42160,"_2311":42266},[],"DER PKCS#7 containing the issued certificate.",{"_2783":949,"_24069":906,"_16893":42268,"_5":16788,"_22829":42160,"_2311":42269},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_2783":950,"_24069":906,"_16893":42271,"_5":16788,"_22829":42164,"_2311":42272},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_2783":951,"_24069":906,"_16893":42274,"_5":16788,"_22829":42164,"_2311":42275},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_2783":952,"_24069":906,"_16893":42277,"_5":16788,"_22829":42164,"_2311":42278},[],"Convert and check the result:",{"_2783":953,"_24069":906,"_16893":42280,"_5":16788,"_22829":42164,"_2311":42281},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_2783":954,"_24069":906,"_16893":42283,"_5":16788,"_22829":42168,"_2311":42284},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_2783":955,"_24069":906,"_16893":42286,"_5":16788,"_22829":42168,"_2311":42287},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_2783":956,"_24069":956,"_5":11891,"_2311":41705,"_24384":42289,"_16893":42290,"_22829":956},[39305,40649,41524,41522,41705],[],{"_2783":957,"_24069":956,"_16893":42292,"_5":16788,"_22829":956,"_2311":42293},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_2783":958,"_24069":956,"_5":24381,"_16893":42295,"_22829":42296,"_2311":42297},[],"/docs/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_2783":959,"_24069":956,"_5":24381,"_16893":42299,"_22829":42300,"_2311":42301},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_2783":960,"_24069":956,"_5":24381,"_16893":42303,"_22829":42304,"_2311":42305},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_2783":961,"_24069":956,"_5":24381,"_16893":42307,"_22829":42308,"_2311":42309},[],"/docs/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_2783":962,"_24069":956,"_16893":42311,"_5":16788,"_22829":956,"_2311":42312},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_2783":963,"_24069":956,"_16893":42314,"_5":16788,"_22829":42296,"_2311":42315},[],"The administrator prepares the CA, issuance profile and DMS.",{"_2783":964,"_24069":956,"_16893":42317,"_5":16788,"_22829":42296,"_2311":42318},[],"The integrator installs initial EST server trust and an admission credential.",{"_2783":965,"_24069":956,"_16893":42320,"_5":16788,"_22829":42296,"_2311":42321},[],"The client requests an identity for its `Device ID` through EST.",{"_2783":966,"_24069":956,"_16893":42323,"_5":16788,"_22829":42296,"_2311":42324},[],"Certificate, device binding and key/certificate installation are checked.",{"_2783":967,"_24069":956,"_16893":42326,"_5":16788,"_22829":42296,"_2311":42327},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_2783":968,"_24069":956,"_16893":42329,"_5":16788,"_22829":42296,"_2311":42330},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_2783":969,"_24069":956,"_16893":42332,"_5":16788,"_22829":42300,"_2311":42333},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2783":970,"_24069":956,"_16893":42335,"_5":16788,"_22829":42300,"_2311":42336},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2783":971,"_24069":956,"_16893":42338,"_5":16788,"_22829":42300,"_2311":42339},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2783":972,"_24069":956,"_16893":42341,"_5":16788,"_22829":42300,"_2311":42342},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2783":973,"_24069":956,"_16893":42344,"_5":16788,"_22829":42304,"_2311":42345},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2783":974,"_24069":956,"_16893":42347,"_5":16788,"_22829":42304,"_2311":42348},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2783":975,"_24069":956,"_16893":42350,"_5":16788,"_22829":42304,"_2311":42351},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2783":976,"_24069":956,"_16893":42353,"_5":16788,"_22829":42304,"_2311":42354},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2783":977,"_24069":956,"_16893":42356,"_5":16788,"_22829":42308,"_2311":42357},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract and migrations, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_2783":978,"_24069":956,"_16893":42359,"_5":16788,"_22829":42308,"_2311":42360},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_2783":979,"_24069":979,"_5":11891,"_2311":42362,"_24384":42363,"_16893":42364,"_22829":979},"Provisioning strategies",[39305,40649,41524,41522,41705],[],{"_2783":980,"_24069":979,"_16893":42366,"_5":16788,"_22829":979,"_2311":42367},[],"Choose device registration, identity authorization and key generation.",{"_2783":981,"_24069":979,"_5":24381,"_16893":42369,"_22829":42370,"_2311":42371},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_2783":982,"_24069":979,"_5":24381,"_16893":42373,"_22829":42374,"_2311":42375},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_2783":983,"_24069":979,"_5":24381,"_16893":42377,"_22829":42378,"_2311":42379},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_2783":984,"_24069":979,"_5":24381,"_16893":42381,"_22829":42382,"_2311":42383},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_2783":985,"_24069":979,"_5":24381,"_16893":42385,"_22829":42386,"_2311":42387},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_2783":986,"_24069":979,"_16893":42389,"_5":16788,"_22829":979,"_2311":42390},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_2783":987,"_24069":979,"_16893":42392,"_5":16788,"_22829":42370,"_2311":42393},[],"Path",{"_2783":988,"_24069":979,"_16893":42395,"_5":16788,"_22829":42370,"_2311":42396},[],"When the device exists",{"_2783":989,"_24069":979,"_16893":42398,"_5":16788,"_22829":42370,"_2311":42399},[],"What to check",{"_2783":990,"_24069":979,"_16893":42401,"_5":16788,"_22829":42370,"_2311":42402},[],"Manual assignment",{"_2783":991,"_24069":979,"_16893":42404,"_5":16788,"_22829":42370,"_2311":42405},[],"An operator creates it before associating a certificate.",{"_2783":992,"_24069":979,"_16893":42407,"_5":16788,"_22829":42370,"_2311":42408},[],"ID, owning DMS, certificate CN and bound serial.",{"_2783":993,"_24069":979,"_16893":42410,"_5":16788,"_22829":42370,"_2311":42411},[],"EST with `JITP`",{"_2783":994,"_24069":979,"_16893":42413,"_5":16788,"_22829":42370,"_2311":42414},[],"Created for an unknown CN during `/simpleenroll`.",{"_2783":995,"_24069":979,"_16893":42416,"_5":16788,"_22829":42370,"_2311":42417},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_2783":996,"_24069":979,"_16893":42419,"_5":16788,"_22829":42370,"_2311":42420},[],"EST with `PRE_REGISTRATION`",{"_2783":997,"_24069":979,"_16893":42422,"_5":16788,"_22829":42370,"_2311":42423},[],"Must exist before `/simpleenroll`.",{"_2783":998,"_24069":979,"_16893":42425,"_5":16788,"_22829":42370,"_2311":42426},[],"Approved record, same DMS and replacement conditions for your version.",{"_2783":999,"_24069":979,"_16893":42428,"_5":16788,"_22829":42370,"_2311":42429},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_2783":1000,"_24069":979,"_16893":42431,"_5":16788,"_22829":42370,"_2311":42432},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_2783":1001,"_24069":979,"_16893":42434,"_5":16788,"_22829":42374,"_2311":42435},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_2783":1002,"_24069":979,"_16893":42437,"_5":16788,"_22829":42374,"_2311":42438},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_2783":1003,"_24069":979,"_16893":42440,"_5":16788,"_22829":42374,"_2311":42441},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_2783":1004,"_24069":979,"_16893":42443,"_5":16788,"_22829":42378,"_2311":42444},[],"Decide initial enrollment and re-enrollment separately:",{"_2783":1005,"_24069":979,"_16893":42446,"_5":16788,"_22829":42378,"_2311":42447},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_2783":1006,"_24069":979,"_16893":42449,"_5":16788,"_22829":42378,"_2311":42450},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_2783":1007,"_24069":979,"_16893":42452,"_5":16788,"_22829":42378,"_2311":42453},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_2783":1008,"_24069":979,"_16893":42455,"_5":16788,"_22829":42378,"_2311":42456},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_2783":1009,"_24069":979,"_16893":42458,"_5":16788,"_22829":42378,"_2311":42459},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_2783":1010,"_24069":979,"_16893":42461,"_5":16788,"_22829":42382,"_2311":39682},[],{"_2783":1011,"_24069":979,"_16893":42463,"_5":16788,"_22829":42382,"_2311":42464},[],"Material crossing EST",{"_2783":1012,"_24069":979,"_16893":42466,"_5":16788,"_22829":42382,"_2311":42467},[],"Device-generated key",{"_2783":1013,"_24069":979,"_16893":42469,"_5":16788,"_22829":42382,"_2311":42470},[],"Public CSR and certificate; the key stays on the client.",{"_2783":1014,"_24069":979,"_16893":42472,"_5":16788,"_22829":42382,"_2311":42473},[],"Existing device key",{"_2783":1015,"_24069":979,"_16893":42475,"_5":16788,"_22829":42382,"_2311":42476},[],"CSR signed with that key and a new certificate.",{"_2783":1016,"_24069":979,"_16893":42478,"_5":16788,"_22829":42382,"_2311":41839},[],{"_2783":1017,"_24069":979,"_16893":42480,"_5":16788,"_22829":42382,"_2311":42481},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_2783":1018,"_24069":979,"_16893":42483,"_5":16788,"_22829":42382,"_2311":42484},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_2783":1019,"_24069":979,"_16893":42486,"_5":16788,"_22829":42386,"_2311":42487},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_2783":1020,"_24069":1020,"_5":11891,"_2311":42489,"_24384":42490,"_16893":42491,"_22829":1020},"Renewal and recovery",[39305,40649,41524,41522,41705],[],{"_2783":1021,"_24069":1020,"_16893":42493,"_5":16788,"_22829":1020,"_2311":42494},[],"Renew without losing the identity and recover devices according to their actual state.",{"_2783":1022,"_24069":1020,"_5":24381,"_16893":42496,"_22829":42497,"_2311":42498},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_2783":1023,"_24069":1020,"_5":24381,"_16893":42500,"_22829":42501,"_2311":42502},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_2783":1024,"_24069":1020,"_5":24381,"_16893":42504,"_22829":42505,"_2311":42506},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_2783":1025,"_24069":1020,"_5":24381,"_16893":42508,"_22829":42509,"_2311":42510},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_2783":1026,"_24069":1020,"_5":24381,"_16893":42512,"_22829":42513,"_2311":42514},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_2783":1027,"_24069":1020,"_16893":42516,"_5":16788,"_22829":1020,"_2311":42517},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_2783":1028,"_24069":1020,"_16893":42519,"_5":16788,"_22829":42497,"_2311":42520},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_2783":1029,"_24069":1020,"_16893":42522,"_5":16788,"_22829":42497,"_2311":42523},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_2783":1030,"_24069":1020,"_16893":42525,"_5":16788,"_22829":42497,"_2311":42526},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_2783":1031,"_24069":1020,"_16893":42528,"_5":16788,"_22829":42497,"_2311":42529},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_2783":1032,"_24069":1020,"_16893":42531,"_5":16788,"_22829":42501,"_2311":42532},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_2783":1033,"_24069":1020,"_16893":42534,"_5":16788,"_22829":42501,"_2311":42535},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_2783":1034,"_24069":1020,"_16893":42537,"_5":16788,"_22829":42505,"_2311":42538},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_2783":1035,"_24069":1020,"_16893":42540,"_5":16788,"_22829":42505,"_2311":42541},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_2783":1036,"_24069":1020,"_16893":42543,"_5":16788,"_22829":42505,"_2311":42544},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_2783":1037,"_24069":1020,"_16893":42546,"_5":16788,"_22829":42509,"_2311":42547},[],"Situation",{"_2783":1038,"_24069":1020,"_16893":42549,"_5":16788,"_22829":42509,"_2311":42550},[],"Procedure",{"_2783":1039,"_24069":1020,"_16893":42552,"_5":16788,"_22829":42509,"_2311":42553},[],"Valid certificate, outside the window",{"_2783":1040,"_24069":1020,"_16893":42555,"_5":16788,"_22829":42509,"_2311":42556},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_2783":1041,"_24069":1020,"_16893":42558,"_5":16788,"_22829":42509,"_2311":42559},[],"Expired certificate, key available",{"_2783":1042,"_24069":1020,"_16893":42561,"_5":16788,"_22829":42509,"_2311":42562},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_2783":1043,"_24069":1020,"_16893":42564,"_5":16788,"_22829":42509,"_2311":42565},[],"Renewal through webhook or `NO_AUTH`",{"_2783":1044,"_24069":1020,"_16893":42567,"_5":16788,"_22829":42509,"_2311":42568},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_2783":1045,"_24069":1020,"_16893":42570,"_5":16788,"_22829":42509,"_2311":42571},[],"Lost or inaccessible key",{"_2783":1046,"_24069":1020,"_16893":42573,"_5":16788,"_22829":42509,"_2311":42574},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_2783":1047,"_24069":1020,"_16893":42576,"_5":16788,"_22829":42509,"_2311":42577},[],"Current identity revoked",{"_2783":1048,"_24069":1020,"_16893":42579,"_5":16788,"_22829":42509,"_2311":42580},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_2783":1049,"_24069":1020,"_16893":42582,"_5":16788,"_22829":42509,"_2311":42583},[],"Device without an identity",{"_2783":1050,"_24069":1020,"_16893":42585,"_5":16788,"_22829":42509,"_2311":42586},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_2783":1051,"_24069":1020,"_16893":42588,"_5":16788,"_22829":42509,"_2311":42589},[],"Retired device",{"_2783":1052,"_24069":1020,"_16893":42591,"_5":16788,"_22829":42509,"_2311":42592},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_2783":1053,"_24069":1020,"_16893":42594,"_5":16788,"_22829":42509,"_2311":42595},[],"Timeout, HTTP 500 or installation failure",{"_2783":1054,"_24069":1020,"_16893":42597,"_5":16788,"_22829":42509,"_2311":42598},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_2783":1055,"_24069":1020,"_16893":42600,"_5":16788,"_22829":42513,"_2311":42601},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_2783":1056,"_24069":1020,"_16893":42603,"_5":16788,"_22829":42513,"_2311":42604},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_2783":1057,"_24069":1057,"_5":11891,"_2311":42606,"_24384":42607,"_16893":42608,"_22829":1057},"Enrollment troubleshooting",[39305,40649,41524,41522,41705],[],{"_2783":1058,"_24069":1057,"_16893":42610,"_5":16788,"_22829":1057,"_2311":42611},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_2783":1059,"_24069":1057,"_5":24381,"_16893":42613,"_22829":42614,"_2311":42615},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_2783":1060,"_24069":1057,"_5":24381,"_16893":42617,"_22829":42618,"_2311":42619},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_2783":1061,"_24069":1057,"_5":24381,"_16893":42621,"_22829":42622,"_2311":42169},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_2783":1062,"_24069":1057,"_5":24381,"_16893":42624,"_22829":42625,"_2311":42626},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_2783":1063,"_24069":1057,"_16893":42628,"_5":16788,"_22829":1057,"_2311":42629},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_2783":1064,"_24069":1057,"_16893":42631,"_5":16788,"_22829":42618,"_2311":42632},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_2783":1065,"_24069":1057,"_16893":42634,"_5":16788,"_22829":42618,"_2311":42635},[],"Symptom or message",{"_2783":1066,"_24069":1057,"_16893":42637,"_5":16788,"_22829":42618,"_2311":42399},[],{"_2783":1067,"_24069":1057,"_16893":42639,"_5":16788,"_22829":42618,"_2311":42640},[],"curl rejects TLS, name or issuer",{"_2783":1068,"_24069":1057,"_16893":42642,"_5":16788,"_22829":42618,"_2311":42643},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_2783":1069,"_24069":1057,"_16893":42645,"_5":16788,"_22829":42618,"_2311":42646},[],"404 or missing APS",{"_2783":1070,"_24069":1057,"_16893":42648,"_5":16788,"_22829":42618,"_2311":42649},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_2783":1071,"_24069":1057,"_16893":42651,"_5":16788,"_22829":42618,"_2311":42652},[],"400, CSR or format error",{"_2783":1072,"_24069":1057,"_16893":42654,"_5":16788,"_22829":42618,"_2311":42655},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_2783":1073,"_24069":1057,"_16893":42657,"_5":16788,"_22829":42618,"_2311":42658},[],"Missing credential or invalid certificate",{"_2783":1074,"_24069":1057,"_16893":42660,"_5":16788,"_22829":42618,"_2311":42661},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_2783":1075,"_24069":1057,"_16893":42663,"_5":16788,"_22829":42618,"_2311":42664},[],"Webhook denies, times out or responds without authorization",{"_2783":1076,"_24069":1057,"_16893":42666,"_5":16788,"_22829":42618,"_2311":42667},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_2783":1077,"_24069":1057,"_16893":42669,"_5":16788,"_22829":42618,"_2311":42670},[],"`device not preregistered`",{"_2783":1078,"_24069":1057,"_16893":42672,"_5":16788,"_22829":42618,"_2311":42673},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_2783":1079,"_24069":1057,"_16893":42675,"_5":16788,"_22829":42618,"_2311":42676},[],"`forbiddenNewEnrollment`",{"_2783":1080,"_24069":1057,"_16893":42678,"_5":16788,"_22829":42618,"_2311":42679},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_2783":1081,"_24069":1057,"_16893":42681,"_5":16788,"_22829":42618,"_2311":42682},[],"Different owning DMS",{"_2783":1082,"_24069":1057,"_16893":42684,"_5":16788,"_22829":42618,"_2311":42685},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_2783":1083,"_24069":1057,"_16893":42687,"_5":16788,"_22829":42618,"_2311":42688},[],"`invalid RawSubject bytes`",{"_2783":1084,"_24069":1057,"_16893":42690,"_5":16788,"_22829":42618,"_2311":42691},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_2783":1085,"_24069":1057,"_16893":42693,"_5":16788,"_22829":42618,"_2311":42694},[],"`invalid reenroll window`",{"_2783":1086,"_24069":1057,"_16893":42696,"_5":16788,"_22829":42618,"_2311":42697},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_2783":1087,"_24069":1057,"_16893":42699,"_5":16788,"_22829":42618,"_2311":42700},[],"Current certificate revoked",{"_2783":1088,"_24069":1057,"_16893":42702,"_5":16788,"_22829":42618,"_2311":42703},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_2783":1089,"_24069":1057,"_16893":42705,"_5":16788,"_22829":42618,"_2311":42706},[],"CA, profile or signing error",{"_2783":1090,"_24069":1057,"_16893":42708,"_5":16788,"_22829":42618,"_2311":42709},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_2783":1091,"_24069":1057,"_16893":42711,"_5":16788,"_22829":42618,"_2311":42712},[],"HTTP 200 without a device connection",{"_2783":1092,"_24069":1057,"_16893":42714,"_5":16788,"_22829":42618,"_2311":42715},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_2783":1093,"_24069":1057,"_16893":42717,"_5":16788,"_22829":42618,"_2311":42718},[],"Timeout or error after issuance",{"_2783":1094,"_24069":1057,"_16893":42720,"_5":16788,"_22829":42618,"_2311":42721},[],"New certificates, current slot and previous identity's state before retrying.",{"_2783":1095,"_24069":1057,"_16893":42723,"_5":16788,"_22829":42622,"_2311":42724},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode after migration and Gateway behavior with expired certificates and the bootstrap CA.",{"_2783":1096,"_24069":1057,"_16893":42726,"_5":16788,"_22829":42622,"_2311":42727},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_2783":1097,"_24069":1057,"_16893":42729,"_5":16788,"_22829":42625,"_2311":42730},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_2783":1098,"_24069":1057,"_16893":42732,"_5":16788,"_22829":42625,"_2311":42733},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_2783":1099,"_24069":1057,"_16893":42735,"_5":16788,"_22829":42625,"_2311":42736},[],"Verify the CSR locally and relate its CN to the inventory.",{"_2783":1100,"_24069":1057,"_16893":42738,"_5":16788,"_22829":42625,"_2311":42739},[],"Make one request, save headers/body and query the device and certificates.",{"_2783":1101,"_24069":1057,"_16893":42741,"_5":16788,"_22829":42625,"_2311":42742},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_2783":1102,"_24069":1057,"_16893":42744,"_5":16788,"_22829":42625,"_2311":42745},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_2783":1103,"_24069":1057,"_16893":42747,"_5":16788,"_22829":42625,"_2311":42748},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_2783":1104,"_24069":1104,"_5":11891,"_2311":42750,"_24384":42751,"_16893":42752,"_22829":1104},"Trust distribution and updates",[39305,40649,41524,41522,41705],[],{"_2783":1105,"_24069":1104,"_16893":42754,"_5":16788,"_22829":1104,"_2311":42755},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_2783":1106,"_24069":1104,"_5":24381,"_16893":42757,"_22829":42758,"_2311":42759},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_2783":1107,"_24069":1104,"_5":24381,"_16893":42761,"_22829":42762,"_2311":42763},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_2783":1108,"_24069":1104,"_5":24381,"_16893":42765,"_22829":42766,"_2311":42767},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_2783":1109,"_24069":1104,"_5":24381,"_16893":42769,"_22829":42770,"_2311":42771},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_2783":1110,"_24069":1104,"_5":24381,"_16893":42773,"_22829":42774,"_2311":42775},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_2783":1111,"_24069":1104,"_16893":42777,"_5":16788,"_22829":1104,"_2311":42778},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_2783":1112,"_24069":1104,"_16893":42780,"_5":16788,"_22829":42758,"_2311":42781},[],"Relationship",{"_2783":1113,"_24069":1104,"_16893":42783,"_5":16788,"_22829":42758,"_2311":42784},[],"Material prepared by its owner",{"_2783":1114,"_24069":1104,"_16893":42786,"_5":16788,"_22829":42758,"_2311":42787},[],"Device → EST server",{"_2783":1115,"_24069":1104,"_16893":42789,"_5":16788,"_22829":42758,"_2311":42790},[],"Previously verified server root, chain or pin and TLS name.",{"_2783":1116,"_24069":1104,"_16893":42792,"_5":16788,"_22829":42758,"_2311":42793},[],"DMS → requester",{"_2783":1117,"_24069":1104,"_16893":42795,"_5":16788,"_22829":42758,"_2311":42796},[],"CAs and rules authorizing initial or renewal credentials.",{"_2783":1118,"_24069":1104,"_16893":42798,"_5":16788,"_22829":42758,"_2311":42799},[],"Consumer → device",{"_2783":1119,"_24069":1104,"_16893":42801,"_5":16788,"_22829":42758,"_2311":42802},[],"Operational identity roots, intermediates, validation and permissions.",{"_2783":1120,"_24069":1104,"_16893":42804,"_5":16788,"_22829":42758,"_2311":42805},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_2783":1121,"_24069":1104,"_16893":42807,"_5":16788,"_22829":42762,"_2311":42808},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_2783":1122,"_24069":1104,"_16893":42810,"_5":16788,"_22829":42762,"_2311":42811},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_2783":1123,"_24069":1104,"_16893":42813,"_5":16788,"_22829":42766,"_2311":42814},[],"Keep initial EST server trust separate from identity consumer trust.",{"_2783":1124,"_24069":1104,"_16893":42816,"_5":16788,"_22829":42766,"_2311":42817},[],"Select policy-approved roots as anchors.",{"_2783":1125,"_24069":1104,"_16893":42819,"_5":16788,"_22829":42766,"_2311":42820},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_2783":1126,"_24069":1104,"_16893":42822,"_5":16788,"_22829":42766,"_2311":42823},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_2783":1127,"_24069":1104,"_16893":42825,"_5":16788,"_22829":42766,"_2311":42826},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_2783":1128,"_24069":1104,"_16893":42828,"_5":16788,"_22829":42766,"_2311":42829},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_2783":1129,"_24069":1104,"_16893":42831,"_5":16788,"_22829":42770,"_2311":42832},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_2783":1130,"_24069":1104,"_16893":42834,"_5":16788,"_22829":42770,"_2311":42835},[],"In the DMS, separate distributed CAs from `additional_validation_cas`, used for re-enrollment credentials. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_2783":1131,"_24069":1104,"_16893":42837,"_5":16788,"_22829":42770,"_2311":42838},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_2783":1132,"_24069":1104,"_16893":42840,"_5":16788,"_22829":42774,"_2311":42841},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_2783":1133,"_24069":1133,"_5":11891,"_2311":42843,"_24384":42844,"_16893":42846,"_22829":1133},"AWS IoT Core",[39305,40649,41524,41522,42845],"Integrations",[],{"_2783":1134,"_24069":1133,"_16893":42848,"_5":16788,"_22829":1133,"_2311":42849},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_2783":1135,"_24069":1133,"_5":24381,"_16893":42851,"_22829":42852,"_2311":42853},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_2783":1136,"_24069":1133,"_5":24381,"_16893":42855,"_22829":42856,"_2311":42857},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_2783":1137,"_24069":1133,"_5":24381,"_16893":42859,"_22829":42860,"_2311":42861},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_2783":1138,"_24069":1133,"_5":24381,"_16893":42863,"_22829":42864,"_2311":42865},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_2783":1139,"_24069":1133,"_5":24381,"_16893":42867,"_22829":42868,"_2311":42869},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_2783":1140,"_24069":1133,"_5":24381,"_16893":42871,"_22829":42872,"_2311":42873},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_2783":1141,"_24069":1133,"_5":24381,"_16893":42875,"_22829":42876,"_2311":42877},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_2783":1142,"_24069":1133,"_5":24381,"_16893":42879,"_22829":42880,"_2311":42881},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_2783":1143,"_24069":1133,"_5":24381,"_16893":42883,"_22829":42884,"_2311":42885},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_2783":1144,"_24069":1133,"_5":24381,"_16893":42887,"_22829":42888,"_2311":42889},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_2783":1145,"_24069":1133,"_5":24381,"_16893":42891,"_22829":42892,"_2311":42893},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_2783":1146,"_24069":1133,"_5":24381,"_16893":42895,"_22829":42896,"_2311":42897},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_2783":1147,"_24069":1133,"_5":24381,"_16893":42899,"_22829":42900,"_2311":42901},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_2783":1148,"_24069":1133,"_5":24381,"_16893":42903,"_22829":42904,"_2311":42905},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_2783":1149,"_24069":1133,"_5":24381,"_16893":42907,"_22829":42908,"_2311":42909},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_2783":1150,"_24069":1133,"_5":24381,"_16893":42911,"_22829":42912,"_2311":42913},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_2783":1151,"_24069":1133,"_5":24381,"_16893":42915,"_22829":42916,"_2311":42917},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_2783":1152,"_24069":1133,"_5":24381,"_16893":42919,"_22829":42920,"_2311":42921},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_2783":1153,"_24069":1133,"_5":24381,"_16893":42923,"_22829":42924,"_2311":42925},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_2783":1154,"_24069":1133,"_5":24381,"_16893":42927,"_22829":42928,"_2311":42929},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_2783":1155,"_24069":1133,"_16893":42931,"_5":16788,"_22829":1133,"_2311":42932},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_2783":1156,"_24069":1133,"_16893":42934,"_5":16788,"_22829":1133,"_2311":42935},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_2783":1157,"_24069":1133,"_16893":42937,"_5":16788,"_22829":1133,"_2311":42938},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_2783":1158,"_24069":1133,"_16893":42940,"_5":16788,"_22829":42852,"_2311":42941},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_2783":1159,"_24069":1133,"_16893":42943,"_5":16788,"_22829":42852,"_2311":42944},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_2783":1160,"_24069":1133,"_16893":42946,"_5":16788,"_22829":42852,"_2311":42947},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_2783":1161,"_24069":1133,"_16893":42949,"_5":16788,"_22829":42852,"_2311":42950},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_2783":1162,"_24069":1133,"_16893":42952,"_5":16788,"_22829":42856,"_2311":42953},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_2783":1163,"_24069":1133,"_16893":42955,"_5":16788,"_22829":42860,"_2311":42956},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_2783":1164,"_24069":1133,"_16893":42958,"_5":16788,"_22829":42860,"_2311":42959},[],"IAM action",{"_2783":1165,"_24069":1133,"_16893":42961,"_5":16788,"_22829":42860,"_2311":39688},[],{"_2783":1166,"_24069":1133,"_16893":42963,"_5":16788,"_22829":42860,"_2311":42964},[],"`iot:GetRegistrationCode`",{"_2783":1167,"_24069":1133,"_16893":42966,"_5":16788,"_22829":42860,"_2311":42967},[],"Obtain the verification code for CA registration in the Primary Account",{"_2783":1168,"_24069":1133,"_16893":42969,"_5":16788,"_22829":42860,"_2311":42970},[],"`iot:RegisterCACertificate`",{"_2783":1169,"_24069":1133,"_16893":42972,"_5":16788,"_22829":42860,"_2311":42973},[],"Register the CA in AWS IoT",{"_2783":1170,"_24069":1133,"_16893":42975,"_5":16788,"_22829":42860,"_2311":42976},[],"`iot:DescribeCACertificate`",{"_2783":1171,"_24069":1133,"_16893":42978,"_5":16788,"_22829":42860,"_2311":42979},[],"Check the CA registration status",{"_2783":1172,"_24069":1133,"_16893":42981,"_5":16788,"_22829":42860,"_2311":42982},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_2783":1173,"_24069":1133,"_16893":42984,"_5":16788,"_22829":42860,"_2311":42985},[],"Create or update Things in IoT Core",{"_2783":1174,"_24069":1133,"_16893":42987,"_5":16788,"_22829":42860,"_2311":42988},[],"`iot:RegisterThing`",{"_2783":1175,"_24069":1133,"_16893":42990,"_5":16788,"_22829":42860,"_2311":42991},[],"Provision Things through a template",{"_2783":1176,"_24069":1133,"_16893":42993,"_5":16788,"_22829":42860,"_2311":42994},[],"`iot:RegisterCertificate`",{"_2783":1177,"_24069":1133,"_16893":42996,"_5":16788,"_22829":42860,"_2311":42997},[],"Register device certificates",{"_2783":1178,"_24069":1133,"_16893":42999,"_5":16788,"_22829":42860,"_2311":43000},[],"`iot:UpdateCertificate`",{"_2783":1179,"_24069":1133,"_16893":43002,"_5":16788,"_22829":42860,"_2311":43003},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_2783":1180,"_24069":1133,"_16893":43005,"_5":16788,"_22829":42860,"_2311":43006},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_2783":1181,"_24069":1133,"_16893":43008,"_5":16788,"_22829":42860,"_2311":43009},[],"Create and attach IoT policies",{"_2783":1182,"_24069":1133,"_16893":43011,"_5":16788,"_22829":42860,"_2311":43012},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_2783":1183,"_24069":1133,"_16893":43014,"_5":16788,"_22829":42860,"_2311":43015},[],"Manage Thing groups",{"_2783":1184,"_24069":1133,"_16893":43017,"_5":16788,"_22829":42860,"_2311":43018},[],"`iot:CreateProvisioningTemplate`",{"_2783":1185,"_24069":1133,"_16893":43020,"_5":16788,"_22829":42860,"_2311":43021},[],"Create JITP templates",{"_2783":1186,"_24069":1133,"_16893":43023,"_5":16788,"_22829":42860,"_2311":43024},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_2783":1187,"_24069":1133,"_16893":43026,"_5":16788,"_22829":42860,"_2311":43027},[],"Read and write the Device Shadow",{"_2783":1188,"_24069":1133,"_16893":43029,"_5":16788,"_22829":42860,"_2311":43030},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_2783":1189,"_24069":1133,"_16893":43032,"_5":16788,"_22829":42864,"_2311":43033},[],"Parameter",{"_2783":1190,"_24069":1133,"_16893":43035,"_5":16788,"_22829":42864,"_2311":43036},[],"Type",{"_2783":1191,"_24069":1133,"_16893":43038,"_5":16788,"_22829":42864,"_2311":43039},[],"Required",{"_2783":1192,"_24069":1133,"_16893":43041,"_5":16788,"_22829":42864,"_2311":43042},[],"Description",{"_2783":1193,"_24069":1133,"_16893":43044,"_5":16788,"_22829":42864,"_2311":43045},[],"`connector_id`",{"_2783":1194,"_24069":1133,"_16893":43047,"_5":16788,"_22829":42864,"_2311":20125},[],{"_2783":1195,"_24069":1133,"_16893":43049,"_5":16788,"_22829":42864,"_2311":43050},[],"Yes",{"_2783":1196,"_24069":1133,"_16893":43052,"_5":16788,"_22829":42864,"_2311":43053},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_2783":1197,"_24069":1133,"_16893":43055,"_5":16788,"_22829":42864,"_2311":43056},[],"`aws_config.region`",{"_2783":1198,"_24069":1133,"_16893":43058,"_5":16788,"_22829":42864,"_2311":20125},[],{"_2783":1199,"_24069":1133,"_16893":43060,"_5":16788,"_22829":42864,"_2311":43050},[],{"_2783":1200,"_24069":1133,"_16893":43062,"_5":16788,"_22829":42864,"_2311":43063},[],"AWS region where the connector operates.",{"_2783":1201,"_24069":1133,"_16893":43065,"_5":16788,"_22829":42864,"_2311":43066},[],"`aws_config.auth_method`",{"_2783":1202,"_24069":1133,"_16893":43068,"_5":16788,"_22829":42864,"_2311":20125},[],{"_2783":1203,"_24069":1133,"_16893":43070,"_5":16788,"_22829":42864,"_2311":43050},[],{"_2783":1204,"_24069":1133,"_16893":43072,"_5":16788,"_22829":42864,"_2311":43073},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_2783":1205,"_24069":1133,"_16893":43075,"_5":16788,"_22829":42864,"_2311":43076},[],"`aws_config.access_key_id`",{"_2783":1206,"_24069":1133,"_16893":43078,"_5":16788,"_22829":42864,"_2311":20125},[],{"_2783":1207,"_24069":1133,"_16893":43080,"_5":16788,"_22829":42864,"_2311":43081},[],"Only with `auth_method=static`",{"_2783":1208,"_24069":1133,"_16893":43083,"_5":16788,"_22829":42864,"_2311":43084},[],"AWS access key.",{"_2783":1209,"_24069":1133,"_16893":43086,"_5":16788,"_22829":42864,"_2311":43087},[],"`aws_config.secret_access_key`",{"_2783":1210,"_24069":1133,"_16893":43089,"_5":16788,"_22829":42864,"_2311":20125},[],{"_2783":1211,"_24069":1133,"_16893":43091,"_5":16788,"_22829":42864,"_2311":43081},[],{"_2783":1212,"_24069":1133,"_16893":43093,"_5":16788,"_22829":42864,"_2311":43094},[],"AWS secret key.",{"_2783":1213,"_24069":1133,"_16893":43096,"_5":16788,"_22829":42864,"_2311":43097},[],"`aws_config.session_token`",{"_2783":1214,"_24069":1133,"_16893":43099,"_5":16788,"_22829":42864,"_2311":20125},[],{"_2783":1215,"_24069":1133,"_16893":43101,"_5":16788,"_22829":42864,"_2311":43102},[],"No",{"_2783":1216,"_24069":1133,"_16893":43104,"_5":16788,"_22829":42864,"_2311":43105},[],"Session token (with `auth_method=static`).",{"_2783":1217,"_24069":1133,"_16893":43107,"_5":16788,"_22829":42864,"_2311":43108},[],"`aws_config.role_arn`",{"_2783":1218,"_24069":1133,"_16893":43110,"_5":16788,"_22829":42864,"_2311":20125},[],{"_2783":1219,"_24069":1133,"_16893":43112,"_5":16788,"_22829":42864,"_2311":43113},[],"Only with `auth_method=role`",{"_2783":1220,"_24069":1133,"_16893":43115,"_5":16788,"_22829":42864,"_2311":43116},[],"ARN of the role to assume.",{"_2783":1221,"_24069":1133,"_16893":43118,"_5":16788,"_22829":42864,"_2311":43119},[],"`aws_config.endpoint_url`",{"_2783":1222,"_24069":1133,"_16893":43121,"_5":16788,"_22829":42864,"_2311":20125},[],{"_2783":1223,"_24069":1133,"_16893":43123,"_5":16788,"_22829":42864,"_2311":43102},[],{"_2783":1224,"_24069":1133,"_16893":43125,"_5":16788,"_22829":42864,"_2311":43126},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_2783":1225,"_24069":1133,"_16893":43128,"_5":16788,"_22829":42864,"_2311":43129},[],"`subscriber_event_bus`",{"_2783":1226,"_24069":1133,"_16893":43131,"_5":16788,"_22829":42864,"_2311":14201},[],{"_2783":1227,"_24069":1133,"_16893":43133,"_5":16788,"_22829":42864,"_2311":43050},[],{"_2783":1228,"_24069":1133,"_16893":43135,"_5":16788,"_22829":42864,"_2311":43136},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_2783":1229,"_24069":1133,"_16893":43138,"_5":16788,"_22829":42864,"_2311":43139},[],"`dms_manager_client`",{"_2783":1230,"_24069":1133,"_16893":43141,"_5":16788,"_22829":42864,"_2311":20125},[],{"_2783":1231,"_24069":1133,"_16893":43143,"_5":16788,"_22829":42864,"_2311":43050},[],{"_2783":1232,"_24069":1133,"_16893":43145,"_5":16788,"_22829":42864,"_2311":43146},[],"HTTP URL of Lamassu's DMS Manager service.",{"_2783":1233,"_24069":1133,"_16893":43148,"_5":16788,"_22829":42864,"_2311":43149},[],"`device_manager_client`",{"_2783":1234,"_24069":1133,"_16893":43151,"_5":16788,"_22829":42864,"_2311":20125},[],{"_2783":1235,"_24069":1133,"_16893":43153,"_5":16788,"_22829":42864,"_2311":43050},[],{"_2783":1236,"_24069":1133,"_16893":43155,"_5":16788,"_22829":42864,"_2311":43156},[],"HTTP URL of Lamassu's Device Manager.",{"_2783":1237,"_24069":1133,"_16893":43158,"_5":16788,"_22829":42864,"_2311":43159},[],"`ca_client`",{"_2783":1238,"_24069":1133,"_16893":43161,"_5":16788,"_22829":42864,"_2311":20125},[],{"_2783":1239,"_24069":1133,"_16893":43163,"_5":16788,"_22829":42864,"_2311":43050},[],{"_2783":1240,"_24069":1133,"_16893":43165,"_5":16788,"_22829":42864,"_2311":43166},[],"HTTP URL of Lamassu's CA service.",{"_2783":1241,"_24069":1133,"_16893":43168,"_5":16788,"_22829":42868,"_2311":43169},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_2783":1242,"_24069":1133,"_16893":43171,"_5":16788,"_22829":42872,"_2311":43172},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_2783":1243,"_24069":1133,"_16893":43174,"_5":16788,"_22829":42872,"_2311":43175},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_2783":1244,"_24069":1133,"_16893":43177,"_5":16788,"_22829":42876,"_2311":43178},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_2783":1245,"_24069":1133,"_16893":43180,"_5":16788,"_22829":42876,"_2311":43181},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_2783":1246,"_24069":1133,"_16893":43183,"_5":16788,"_22829":42876,"_2311":43184},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_2783":1247,"_24069":1133,"_16893":43186,"_5":16788,"_22829":42876,"_2311":43187},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_2783":1248,"_24069":1133,"_16893":43189,"_5":16788,"_22829":42876,"_2311":43190},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_2783":1249,"_24069":1133,"_16893":43192,"_5":16788,"_22829":42876,"_2311":43193},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_2783":1250,"_24069":1133,"_16893":43195,"_5":16788,"_22829":42880,"_2311":43196},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_2783":1251,"_24069":1133,"_16893":43198,"_5":16788,"_22829":42884,"_2311":43199},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_2783":1252,"_24069":1133,"_16893":43201,"_5":16788,"_22829":42884,"_2311":43202},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_2783":1253,"_24069":1133,"_16893":43204,"_5":16788,"_22829":42888,"_2311":43205},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_2783":1254,"_24069":1133,"_16893":43207,"_5":16788,"_22829":42892,"_2311":43208},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_2783":1255,"_24069":1133,"_16893":43210,"_5":16788,"_22829":42892,"_2311":43211},[],"Creates or updates the IoT policies configured in the DMS.",{"_2783":1256,"_24069":1133,"_16893":43213,"_5":16788,"_22829":42892,"_2311":43214},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_2783":1257,"_24069":1133,"_16893":43216,"_5":16788,"_22829":42892,"_2311":43217},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_2783":1258,"_24069":1133,"_16893":43219,"_5":16788,"_22829":42892,"_2311":43220},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_2783":1259,"_24069":1133,"_16893":43222,"_5":16788,"_22829":42892,"_2311":43223},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_2783":1260,"_24069":1133,"_16893":43225,"_5":16788,"_22829":42892,"_2311":43226},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_2783":1261,"_24069":1133,"_16893":43228,"_5":16788,"_22829":42896,"_2311":43229},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. This template is created or updated at the moment the DMS is created or updated in Lamassu — not at device enrollment time. From then on, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_2783":1262,"_24069":1133,"_16893":43231,"_5":16788,"_22829":42896,"_2311":43232},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_2783":1263,"_24069":1133,"_16893":43234,"_5":16788,"_22829":42896,"_2311":43235},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_2783":1264,"_24069":1133,"_16893":43237,"_5":16788,"_22829":42900,"_2311":43238},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_2783":1265,"_24069":1133,"_16893":43240,"_5":16788,"_22829":42900,"_2311":43241},[],"The full flow from the device's perspective is:",{"_2783":1266,"_24069":1133,"_16893":43243,"_5":16788,"_22829":42900,"_2311":43244},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_2783":1267,"_24069":1133,"_16893":43246,"_5":16788,"_22829":42904,"_2311":43247},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_2783":1268,"_24069":1133,"_16893":43249,"_5":16788,"_22829":42904,"_2311":43250},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_2783":1269,"_24069":1133,"_16893":43252,"_5":16788,"_22829":42904,"_2311":43253},[],"For the JITP flow to work correctly:",{"_2783":1270,"_24069":1133,"_16893":43255,"_5":16788,"_22829":42904,"_2311":43256},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_2783":1271,"_24069":1133,"_16893":43258,"_5":16788,"_22829":42904,"_2311":43259},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_2783":1272,"_24069":1133,"_16893":43261,"_5":16788,"_22829":42904,"_2311":43262},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_2783":1273,"_24069":1133,"_16893":43264,"_5":16788,"_22829":42904,"_2311":43265},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_2783":1274,"_24069":1133,"_16893":43267,"_5":16788,"_22829":42908,"_2311":43268},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_2783":1275,"_24069":1133,"_16893":43270,"_5":16788,"_22829":42908,"_2311":43271},[],"Status in Lamassu",{"_2783":1276,"_24069":1133,"_16893":43273,"_5":16788,"_22829":42908,"_2311":43274},[],"Revocation reason",{"_2783":1277,"_24069":1133,"_16893":43276,"_5":16788,"_22829":42908,"_2311":43277},[],"Status in AWS IoT Core",{"_2783":1278,"_24069":1133,"_16893":43279,"_5":16788,"_22829":42908,"_2311":43280},[],"`Active`",{"_2783":1279,"_24069":1133,"_16893":43282,"_5":16788,"_22829":42908,"_2311":43283},[],"None",{"_2783":1280,"_24069":1133,"_16893":43285,"_5":16788,"_22829":42908,"_2311":43286},[],"`ACTIVE`",{"_2783":1281,"_24069":1133,"_16893":43288,"_5":16788,"_22829":42908,"_2311":43289},[],"`Revoked`",{"_2783":1282,"_24069":1133,"_16893":43291,"_5":16788,"_22829":42908,"_2311":43292},[],"`certificateHold`",{"_2783":1283,"_24069":1133,"_16893":43294,"_5":16788,"_22829":42908,"_2311":43295},[],"`INACTIVE`",{"_2783":1284,"_24069":1133,"_16893":43297,"_5":16788,"_22829":42908,"_2311":43289},[],{"_2783":1285,"_24069":1133,"_16893":43299,"_5":16788,"_22829":42908,"_2311":43300},[],"Any other reason",{"_2783":1286,"_24069":1133,"_16893":43302,"_5":16788,"_22829":42908,"_2311":43303},[],"`REVOKED`",{"_2783":1287,"_24069":1133,"_16893":43305,"_5":16788,"_22829":42908,"_2311":43306},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_2783":1288,"_24069":1133,"_16893":43308,"_5":16788,"_22829":42912,"_2311":43309},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_2783":1289,"_24069":1133,"_16893":43311,"_5":16788,"_22829":42912,"_2311":43312},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_2783":1290,"_24069":1133,"_16893":43314,"_5":16788,"_22829":42912,"_2311":43315},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_2783":1291,"_24069":1133,"_16893":43317,"_5":16788,"_22829":42916,"_2311":43318},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_2783":1292,"_24069":1133,"_16893":43320,"_5":16788,"_22829":42916,"_2311":43321},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_2783":1293,"_24069":1133,"_16893":43323,"_5":16788,"_22829":42920,"_2311":43324},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_2783":1294,"_24069":1133,"_16893":43326,"_5":16788,"_22829":42920,"_2311":43327},[],"There are two action types:",{"_2783":1295,"_24069":1133,"_16893":43329,"_5":16788,"_22829":42920,"_2311":43330},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_2783":1296,"_24069":1133,"_16893":43332,"_5":16788,"_22829":42920,"_2311":43333},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_2783":1297,"_24069":1133,"_16893":43335,"_5":16788,"_22829":42920,"_2311":43336},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_2783":1298,"_24069":1133,"_16893":43338,"_5":16788,"_22829":42924,"_2311":43339},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_2783":1299,"_24069":1133,"_16893":43341,"_5":16788,"_22829":42924,"_2311":43342},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_2783":1300,"_24069":1133,"_16893":43344,"_5":16788,"_22829":42924,"_2311":43345},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_2783":1301,"_24069":1133,"_16893":43347,"_5":16788,"_22829":42928,"_2311":43348},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_2783":1302,"_24069":1133,"_16893":43350,"_5":16788,"_22829":42928,"_2311":43351},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_2783":1303,"_24069":1133,"_16893":43353,"_5":16788,"_22829":42928,"_2311":43354},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_2783":1304,"_24069":1133,"_16893":43356,"_5":16788,"_22829":42928,"_2311":43357},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_2783":1305,"_24069":1133,"_16893":43359,"_5":16788,"_22829":42928,"_2311":43360},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_2783":1306,"_24069":1133,"_16893":43362,"_5":16788,"_22829":42928,"_2311":43363},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_2783":1307,"_24069":1133,"_16893":43365,"_5":16788,"_22829":42928,"_2311":43366},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_2783":1308,"_24069":1133,"_16893":43368,"_5":16788,"_22829":42928,"_2311":43369},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_2783":1309,"_24069":1133,"_16893":43371,"_5":16788,"_22829":42928,"_2311":43372},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_2783":1310,"_24069":1133,"_16893":43374,"_5":16788,"_22829":42928,"_2311":43375},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_2783":1311,"_24069":1133,"_16893":43377,"_5":16788,"_22829":42928,"_2311":43378},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_2783":1312,"_24069":1133,"_16893":43380,"_5":16788,"_22829":42928,"_2311":43381},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_2783":1313,"_24069":1133,"_16893":43383,"_5":16788,"_22829":42928,"_2311":43384},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_2783":1314,"_24069":1133,"_16893":43386,"_5":16788,"_22829":42928,"_2311":43387},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_2783":1315,"_24069":1133,"_16893":43389,"_5":16788,"_22829":42928,"_2311":43390},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_2783":1316,"_24069":1133,"_16893":43392,"_5":16788,"_22829":42928,"_2311":43393},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_2783":1317,"_24069":1133,"_16893":43395,"_5":16788,"_22829":42928,"_2311":43396},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_2783":1318,"_24069":1133,"_16893":43398,"_5":16788,"_22829":42928,"_2311":43399},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_2783":1319,"_24069":1133,"_16893":43401,"_5":16788,"_22829":42928,"_2311":43402},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2783":1320,"_24069":1133,"_16893":43404,"_5":16788,"_22829":42928,"_2311":43405},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2783":1321,"_24069":1133,"_16893":43407,"_5":16788,"_22829":42928,"_2311":43408},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_2783":1322,"_24069":1322,"_5":11891,"_2311":41524,"_24384":43410,"_16893":43411,"_22829":1322},[39305,40649,41524],[],{"_2783":1323,"_24069":1322,"_16893":43413,"_5":16788,"_22829":1322,"_2311":43414},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_2783":1324,"_24069":1322,"_5":24381,"_16893":43416,"_22829":43417,"_2311":43418},[],"/docs/platform/iot-fleets/overview#start-here","Start here",{"_2783":1325,"_24069":1322,"_5":24381,"_16893":43420,"_22829":43421,"_2311":41522},[],"/docs/platform/iot-fleets/overview#devices-and-identities",{"_2783":1326,"_24069":1322,"_5":24381,"_16893":43423,"_22829":43424,"_2311":41705},[],"/docs/platform/iot-fleets/overview#enrollment-with-pki",{"_2783":1327,"_24069":1322,"_5":24381,"_16893":43426,"_22829":43427,"_2311":42845},[],"/docs/platform/iot-fleets/overview#integrations",{"_2783":1328,"_24069":1322,"_5":24381,"_16893":43429,"_22829":43430,"_2311":43431},[],"/docs/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_2783":1329,"_24069":1322,"_16893":43433,"_5":16788,"_22829":1322,"_2311":43434},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_2783":1330,"_24069":1322,"_16893":43436,"_5":16788,"_22829":43417,"_2311":43437},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_2783":1331,"_24069":1322,"_16893":43439,"_5":16788,"_22829":43417,"_2311":43440},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_2783":1332,"_24069":1322,"_16893":43442,"_5":16788,"_22829":43421,"_2311":43443},[],"Resource",{"_2783":1333,"_24069":1322,"_16893":43445,"_5":16788,"_22829":43421,"_2311":43446},[],"What it represents",{"_2783":1334,"_24069":1322,"_16893":43448,"_5":16788,"_22829":43421,"_2311":43449},[],"**Device**",{"_2783":1335,"_24069":1322,"_16893":43451,"_5":16788,"_22829":43421,"_2311":43452},[],"An inventory entry with an identifier, owning DMS and classification.",{"_2783":1336,"_24069":1322,"_16893":43454,"_5":16788,"_22829":43421,"_2311":43455},[],"**Identity**",{"_2783":1337,"_24069":1322,"_16893":43457,"_5":16788,"_22829":43421,"_2311":43458},[],"The device's association with its certificates: an active version and a history.",{"_2783":1338,"_24069":1322,"_16893":43460,"_5":16788,"_22829":43421,"_2311":43461},[],"**DMS**",{"_2783":1339,"_24069":1322,"_16893":43463,"_5":16788,"_22829":43421,"_2311":43464},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_2783":1340,"_24069":1322,"_16893":43466,"_5":16788,"_22829":43421,"_2311":43467},[],"**Fleet**",{"_2783":1341,"_24069":1322,"_16893":43469,"_5":16788,"_22829":43421,"_2311":43470},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_2783":1342,"_24069":1322,"_16893":43472,"_5":16788,"_22829":43421,"_2311":43473},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_2783":1343,"_24069":1322,"_16893":43475,"_5":16788,"_22829":43421,"_2311":43476},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_2783":1344,"_24069":1322,"_16893":43478,"_5":16788,"_22829":43424,"_2311":43479},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_2783":1345,"_24069":1322,"_16893":43481,"_5":16788,"_22829":43424,"_2311":43482},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_2783":1346,"_24069":1322,"_16893":43484,"_5":16788,"_22829":43424,"_2311":43485},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_2783":1347,"_24069":1322,"_16893":43487,"_5":16788,"_22829":43424,"_2311":43488},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_2783":1348,"_24069":1322,"_16893":43490,"_5":16788,"_22829":43424,"_2311":43491},[],"**Result:** request the certificate, install it and check its association with the device.",{"_2783":1349,"_24069":1322,"_16893":43493,"_5":16788,"_22829":43424,"_2311":43494},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_2783":1350,"_24069":1322,"_16893":43496,"_5":16788,"_22829":43424,"_2311":43497},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2783":1351,"_24069":1322,"_16893":43499,"_5":16788,"_22829":43424,"_2311":43500},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2783":1352,"_24069":1322,"_16893":43502,"_5":16788,"_22829":43427,"_2311":43503},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_2783":1353,"_24069":1322,"_16893":43505,"_5":16788,"_22829":43427,"_2311":43506},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_2783":1354,"_24069":1322,"_16893":43508,"_5":16788,"_22829":43430,"_2311":43509},[],"Participant",{"_2783":1355,"_24069":1322,"_16893":43511,"_5":16788,"_22829":43430,"_2311":43512},[],"Responsibility",{"_2783":1356,"_24069":1322,"_16893":43514,"_5":16788,"_22829":43430,"_2311":43515},[],"PKI administrator",{"_2783":1357,"_24069":1322,"_16893":43517,"_5":16788,"_22829":43430,"_2311":43518},[],"CA, issuance profile, chain and revocation publication.",{"_2783":1358,"_24069":1322,"_16893":43520,"_5":16788,"_22829":43430,"_2311":43521},[],"Provisioning administrator",{"_2783":1359,"_24069":1322,"_16893":43523,"_5":16788,"_22829":43430,"_2311":43524},[],"DMS, admission, authentication per operation and inventory.",{"_2783":1360,"_24069":1322,"_16893":43526,"_5":16788,"_22829":43430,"_2311":43527},[],"Device integrator",{"_2783":1361,"_24069":1322,"_16893":43529,"_5":16788,"_22829":43430,"_2311":43530},[],"Initial credential, key, EST client, trust and certificate installation.",{"_2783":1362,"_24069":1322,"_16893":43532,"_5":16788,"_22829":43430,"_2311":43533},[],"Consumer integrator",{"_2783":1363,"_24069":1322,"_16893":43535,"_5":16788,"_22829":43430,"_2311":43536},[],"Trusted issuers, validation and device permissions in the destination.",{"_2783":1364,"_24069":1322,"_16893":43538,"_5":16788,"_22829":43430,"_2311":43539},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_2783":1365,"_24069":1365,"_5":11891,"_2311":43541,"_24384":43542,"_16893":43544,"_22829":1365},"Enroll and connect your first device",[39305,40649,41524,43543],"Getting started",[],{"_2783":1366,"_24069":1365,"_16893":43546,"_5":16788,"_22829":1365,"_2311":43547},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_2783":1367,"_24069":1365,"_5":24381,"_16893":43549,"_22829":43550,"_2311":39315},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_2783":1368,"_24069":1365,"_5":24381,"_16893":43552,"_22829":43553,"_2311":43554},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_2783":1369,"_24069":1365,"_5":24381,"_16893":43556,"_22829":43557,"_2311":43558},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_2783":1370,"_24069":1365,"_5":24381,"_16893":43560,"_22829":43561,"_2311":43562},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_2783":1371,"_24069":1365,"_5":24381,"_16893":43564,"_22829":43565,"_2311":43566},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_2783":1372,"_24069":1365,"_5":24381,"_16893":43568,"_22829":43569,"_2311":43570},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_2783":1373,"_24069":1365,"_5":24381,"_16893":43572,"_22829":43573,"_2311":43574},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_2783":1374,"_24069":1365,"_5":24381,"_16893":43576,"_22829":43577,"_2311":43578},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_2783":1375,"_24069":1365,"_16893":43580,"_5":16788,"_22829":1365,"_2311":43581},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_2783":1376,"_24069":1365,"_16893":43583,"_5":16788,"_22829":43550,"_2311":43584},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_2783":1377,"_24069":1365,"_16893":43586,"_5":16788,"_22829":43550,"_2311":43587},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_2783":1378,"_24069":1365,"_16893":43589,"_5":16788,"_22829":43550,"_2311":43590},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_2783":1379,"_24069":1365,"_16893":43592,"_5":16788,"_22829":43550,"_2311":43593},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_2783":1380,"_24069":1365,"_16893":43595,"_5":16788,"_22829":43550,"_2311":43596},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_2783":1381,"_24069":1365,"_16893":43598,"_5":16788,"_22829":43553,"_2311":43599},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_2783":1382,"_24069":1365,"_16893":43601,"_5":16788,"_22829":43553,"_2311":43602},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_2783":1383,"_24069":1365,"_16893":43604,"_5":16788,"_22829":43557,"_2311":43605},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_2783":1384,"_24069":1365,"_16893":43607,"_5":16788,"_22829":43557,"_2311":43608},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_2783":1385,"_24069":1365,"_16893":43610,"_5":16788,"_22829":43557,"_2311":43611},[],"Setting",{"_2783":1386,"_24069":1365,"_16893":43613,"_5":16788,"_22829":43557,"_2311":43614},[],"Evaluation value",{"_2783":1387,"_24069":1365,"_16893":43616,"_5":16788,"_22829":43557,"_2311":43617},[],"Enrollment CA",{"_2783":1388,"_24069":1365,"_16893":43619,"_5":16788,"_22829":43557,"_2311":43620},[],"Issuing root from `device-root.pem`.",{"_2783":1389,"_24069":1365,"_16893":43622,"_5":16788,"_22829":43557,"_2311":41831},[],{"_2783":1390,"_24069":1365,"_16893":43624,"_5":16788,"_22829":43557,"_2311":43625},[],"The 1-hour leaf profile you just prepared.",{"_2783":1391,"_24069":1365,"_16893":43627,"_5":16788,"_22829":43557,"_2311":43628},[],"Protocol / Registration Mode",{"_2783":1392,"_24069":1365,"_16893":43630,"_5":16788,"_22829":43557,"_2311":43631},[],"`EST_RFC7030` / `JITP`.",{"_2783":1393,"_24069":1365,"_16893":43633,"_5":16788,"_22829":43557,"_2311":43634},[],"Verify CSR Signature",{"_2783":1394,"_24069":1365,"_16893":43636,"_5":16788,"_22829":43557,"_2311":43637},[],"Enabled.",{"_2783":1395,"_24069":1365,"_16893":43639,"_5":16788,"_22829":43557,"_2311":43640},[],"Enable Replaceable Enrollment",{"_2783":1396,"_24069":1365,"_16893":43642,"_5":16788,"_22829":43557,"_2311":43643},[],"Disabled; the ID must be new.",{"_2783":1397,"_24069":1365,"_16893":43645,"_5":16788,"_22829":43557,"_2311":43646},[],"Initial authentication",{"_2783":1398,"_24069":1365,"_16893":43648,"_5":16788,"_22829":43557,"_2311":43649},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_2783":1399,"_24069":1365,"_16893":43651,"_5":16788,"_22829":43557,"_2311":43652},[],"Renewal authentication",{"_2783":1400,"_24069":1365,"_16893":43654,"_5":16788,"_22829":43557,"_2311":43655},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_2783":1401,"_24069":1365,"_16893":43657,"_5":16788,"_22829":43557,"_2311":43658},[],"Additional Validation CAs / Enable Expired Renewal",{"_2783":1402,"_24069":1365,"_16893":43660,"_5":16788,"_22829":43557,"_2311":43661},[],"Empty list for this direct issuance / disabled.",{"_2783":1403,"_24069":1365,"_16893":43663,"_5":16788,"_22829":43557,"_2311":43664},[],"Re-enrollment Delta",{"_2783":1404,"_24069":1365,"_16893":43666,"_5":16788,"_22829":43557,"_2311":43667},[],"1 hour.",{"_2783":1405,"_24069":1365,"_16893":43669,"_5":16788,"_22829":43557,"_2311":43670},[],"Preventive / Critical Delta",{"_2783":1406,"_24069":1365,"_16893":43672,"_5":16788,"_22829":43557,"_2311":43673},[],"30 minutes / 10 minutes.",{"_2783":1407,"_24069":1365,"_16893":43675,"_5":16788,"_22829":43557,"_2311":43676},[],"Revoke on Re-enrollment",{"_2783":1408,"_24069":1365,"_16893":43678,"_5":16788,"_22829":43557,"_2311":43679},[],"Disabled to test the successor before retiring the previous identity.",{"_2783":1409,"_24069":1365,"_16893":43681,"_5":16788,"_22829":43557,"_2311":41839},[],{"_2783":1410,"_24069":1365,"_16893":43683,"_5":16788,"_22829":43557,"_2311":43684},[],"Disabled; the operational key is generated in the client.",{"_2783":1411,"_24069":1365,"_16893":43686,"_5":16788,"_22829":43557,"_2311":43687},[],"CA Distribution",{"_2783":1412,"_24069":1365,"_16893":43689,"_5":16788,"_22829":43557,"_2311":43690},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_2783":1413,"_24069":1365,"_16893":43692,"_5":16788,"_22829":43557,"_2311":43693},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. If your console does not expose the independent block, configure and check the resource through the DMS API and DMS guide.",{"_2783":1414,"_24069":1365,"_16893":43695,"_5":16788,"_22829":43561,"_2311":43696},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_2783":1415,"_24069":1365,"_16893":43698,"_5":16788,"_22829":43561,"_2311":43699},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_2783":1416,"_24069":1365,"_16893":43701,"_5":16788,"_22829":43565,"_2311":43702},[],"Generate a new key and CSR with the selected identifier:",{"_2783":1417,"_24069":1365,"_16893":43704,"_5":16788,"_22829":43565,"_2311":43705},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_2783":1418,"_24069":1365,"_16893":43707,"_5":16788,"_22829":43565,"_2311":43708},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_2783":1419,"_24069":1365,"_16893":43710,"_5":16788,"_22829":43569,"_2311":43711},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_2783":1420,"_24069":1365,"_16893":43713,"_5":16788,"_22829":43569,"_2311":43714},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_2783":1421,"_24069":1365,"_16893":43716,"_5":16788,"_22829":43573,"_2311":43717},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_2783":1422,"_24069":1365,"_16893":43719,"_5":16788,"_22829":43573,"_2311":43720},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_2783":1423,"_24069":1365,"_16893":43722,"_5":16788,"_22829":43573,"_2311":43723},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_2783":1424,"_24069":1365,"_16893":43725,"_5":16788,"_22829":43573,"_2311":43726},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_2783":1425,"_24069":1365,"_16893":43728,"_5":16788,"_22829":43573,"_2311":43729},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_2783":1426,"_24069":1365,"_16893":43731,"_5":16788,"_22829":43577,"_2311":43732},[],"Check",{"_2783":1427,"_24069":1365,"_16893":43734,"_5":16788,"_22829":43577,"_2311":43735},[],"Expected result",{"_2783":1428,"_24069":1365,"_16893":43737,"_5":16788,"_22829":43577,"_2311":43738},[],"Registration",{"_2783":1429,"_24069":1365,"_16893":43740,"_5":16788,"_22829":43577,"_2311":43741},[],"ID created automatically and correct DMS.",{"_2783":1430,"_24069":1365,"_16893":43743,"_5":16788,"_22829":43577,"_2311":43744},[],"Certificate",{"_2783":1431,"_24069":1365,"_16893":43746,"_5":16788,"_22829":43577,"_2311":43747},[],"CN, profile, serial and key verified.",{"_2783":1432,"_24069":1365,"_16893":43749,"_5":16788,"_22829":43577,"_2311":43750},[],"Inventory",{"_2783":1433,"_24069":1365,"_16893":43752,"_5":16788,"_22829":43577,"_2311":43753},[],"Received serial visible as the current identity and in history.",{"_2783":1434,"_24069":1365,"_16893":43755,"_5":16788,"_22829":43577,"_2311":43756},[],"Consumer",{"_2783":1435,"_24069":1365,"_16893":43758,"_5":16788,"_22829":43577,"_2311":43759},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_2783":1436,"_24069":1365,"_16893":43761,"_5":16788,"_22829":43577,"_2311":43762},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_2783":1437,"_24069":1365,"_16893":43764,"_5":16788,"_22829":43577,"_2311":43765},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_2783":1438,"_24069":1438,"_5":11891,"_2311":41540,"_24384":43767,"_16893":43768,"_22829":1438},[39305,40649,41524,43543],[],{"_2783":1439,"_24069":1438,"_16893":43770,"_5":16788,"_22829":1438,"_2311":43771},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_2783":1440,"_24069":1438,"_5":24381,"_16893":43773,"_22829":43774,"_2311":39315},[],"/docs/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_2783":1441,"_24069":1438,"_5":24381,"_16893":43776,"_22829":43777,"_2311":43778},[],"/docs/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_2783":1442,"_24069":1438,"_5":24381,"_16893":43780,"_22829":43781,"_2311":43782},[],"/docs/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_2783":1443,"_24069":1438,"_5":24381,"_16893":43784,"_22829":43785,"_2311":43786},[],"/docs/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_2783":1444,"_24069":1438,"_5":24381,"_16893":43788,"_22829":43789,"_2311":43790},[],"/docs/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_2783":1445,"_24069":1438,"_5":24381,"_16893":43792,"_22829":43793,"_2311":43794},[],"/docs/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_2783":1446,"_24069":1438,"_5":24381,"_16893":43796,"_22829":43797,"_2311":43735},[],"/docs/platform/iot-fleets/quickstarts/register-device#expected-result",{"_2783":1447,"_24069":1438,"_5":24381,"_16893":43799,"_22829":43800,"_2311":43801},[],"/docs/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_2783":1448,"_24069":1438,"_5":24381,"_16893":43803,"_22829":43804,"_2311":43805},[],"/docs/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_2783":1449,"_24069":1438,"_16893":43807,"_5":16788,"_22829":1438,"_2311":43808},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_2783":1450,"_24069":1438,"_16893":43810,"_5":16788,"_22829":1438,"_2311":43811},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_2783":1451,"_24069":1438,"_16893":43813,"_5":16788,"_22829":43774,"_2311":43814},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_2783":1452,"_24069":1438,"_16893":43816,"_5":16788,"_22829":43774,"_2311":43817},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_2783":1453,"_24069":1438,"_16893":43819,"_5":16788,"_22829":43774,"_2311":43820},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_2783":1454,"_24069":1438,"_16893":43822,"_5":16788,"_22829":43774,"_2311":43823},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_2783":1455,"_24069":1438,"_16893":43825,"_5":16788,"_22829":43777,"_2311":43826},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_2783":1456,"_24069":1438,"_16893":43828,"_5":16788,"_22829":43777,"_2311":43829},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_2783":1457,"_24069":1438,"_16893":43831,"_5":16788,"_22829":43777,"_2311":43832},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_2783":1458,"_24069":1438,"_16893":43834,"_5":16788,"_22829":43777,"_2311":43835},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_2783":1459,"_24069":1438,"_16893":43837,"_5":16788,"_22829":43777,"_2311":43838},[],"Set **Authentication Mode** to `CLIENT_CERTIFICATE` and add the CA whose initial certificates you will accept in **Validation CAs**. For this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and server key generation disabled if you will not use it.",{"_2783":1460,"_24069":1438,"_16893":43840,"_5":16788,"_22829":43777,"_2311":43841},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_2783":1461,"_24069":1438,"_16893":43843,"_5":16788,"_22829":43777,"_2311":43844},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_2783":1462,"_24069":1438,"_16893":43846,"_5":16788,"_22829":43777,"_2311":43847},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_2783":1463,"_24069":1438,"_16893":43849,"_5":16788,"_22829":43781,"_2311":43850},[],"Open **Managed Devices** and the registration action. Complete:",{"_2783":1464,"_24069":1438,"_16893":43852,"_5":16788,"_22829":43781,"_2311":43853},[],"**Device ID**: `device-001`.",{"_2783":1465,"_24069":1438,"_16893":43855,"_5":16788,"_22829":43781,"_2311":43856},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_2783":1466,"_24069":1438,"_16893":43858,"_5":16788,"_22829":43781,"_2311":43859},[],"**Icon** and **Tags**: optional classification.",{"_2783":1467,"_24069":1438,"_16893":43861,"_5":16788,"_22829":43781,"_2311":43862},[],"Confirm registration.",{"_2783":1468,"_24069":1438,"_16893":43864,"_5":16788,"_22829":43785,"_2311":43865},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_2783":1469,"_24069":1438,"_16893":43867,"_5":16788,"_22829":43785,"_2311":43868},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_2783":1470,"_24069":1438,"_16893":43870,"_5":16788,"_22829":43789,"_2311":43871},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_2783":1471,"_24069":1438,"_16893":43873,"_5":16788,"_22829":43789,"_2311":43874},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_2783":1472,"_24069":1438,"_16893":43876,"_5":16788,"_22829":43793,"_2311":43877},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_2783":1473,"_24069":1438,"_16893":43879,"_5":16788,"_22829":43793,"_2311":43880},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_2783":1474,"_24069":1438,"_16893":43882,"_5":16788,"_22829":43797,"_2311":43732},[],{"_2783":1475,"_24069":1438,"_16893":43884,"_5":16788,"_22829":43797,"_2311":43885},[],"Result",{"_2783":1476,"_24069":1438,"_16893":43887,"_5":16788,"_22829":43797,"_2311":43888},[],"Device",{"_2783":1477,"_24069":1438,"_16893":43890,"_5":16788,"_22829":43797,"_2311":43891},[],"`device-001` appears in inventory with the expected DMS.",{"_2783":1478,"_24069":1438,"_16893":43893,"_5":16788,"_22829":43797,"_2311":43894},[],"Current identity",{"_2783":1479,"_24069":1438,"_16893":43896,"_5":16788,"_22829":43797,"_2311":43897},[],"The associated certificate matches the one you verified in PKI.",{"_2783":1480,"_24069":1438,"_16893":43899,"_5":16788,"_22829":43797,"_2311":43900},[],"History",{"_2783":1481,"_24069":1438,"_16893":43902,"_5":16788,"_22829":43797,"_2311":43903},[],"The associated issuance appears with its serial number and dates.",{"_2783":1482,"_24069":1438,"_16893":43905,"_5":16788,"_22829":43797,"_2311":43906},[],"Key and certificate",{"_2783":1483,"_24069":1438,"_16893":43908,"_5":16788,"_22829":43797,"_2311":43909},[],"You have the verified pair ready to install on the device.",{"_2783":1484,"_24069":1438,"_16893":43911,"_5":16788,"_22829":43800,"_2311":43912},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_2783":1485,"_24069":1438,"_16893":43914,"_5":16788,"_22829":43800,"_2311":43915},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_2783":1486,"_24069":1438,"_16893":43917,"_5":16788,"_22829":43800,"_2311":43918},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_2783":1487,"_24069":1438,"_16893":43920,"_5":16788,"_22829":43800,"_2311":43921},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_2783":1488,"_24069":1438,"_16893":43923,"_5":16788,"_22829":43804,"_2311":43924},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_2783":1489,"_24069":1438,"_16893":43926,"_5":16788,"_22829":43804,"_2311":43927},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_2783":1490,"_24069":1438,"_16893":43929,"_5":16788,"_22829":43804,"_2311":43930},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_2783":1491,"_24069":1491,"_5":11891,"_2311":43932,"_24384":43933,"_16893":43934,"_22829":1491},"Lamassu IoT Platform",[39305,40649],[],{"_2783":1492,"_24069":1491,"_16893":43936,"_5":16788,"_22829":1491,"_2311":43937},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_2783":1493,"_24069":1491,"_5":24381,"_16893":43939,"_22829":43940,"_2311":43418},[],"/docs/platform/overview#start-here",{"_2783":1494,"_24069":1491,"_5":24381,"_16893":43942,"_22829":43943,"_2311":43944},[],"/docs/platform/overview#choose-your-path","Choose your path",{"_2783":1495,"_24069":1491,"_5":24381,"_16893":43946,"_22829":43947,"_2311":43948},[],"/docs/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_2783":1496,"_24069":1491,"_5":24381,"_16893":43950,"_22829":43951,"_2311":43952},[],"/docs/platform/overview#core-capabilities","Core capabilities",{"_2783":1497,"_24069":1491,"_5":24381,"_16893":43954,"_22829":43955,"_2311":43956},[],"/docs/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_2783":1498,"_24069":1491,"_5":24381,"_16893":43958,"_22829":43959,"_2311":43960},[],"/docs/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_2783":1499,"_24069":1491,"_5":24381,"_16893":43962,"_22829":43963,"_2311":43964},[],"/docs/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_2783":1500,"_24069":1491,"_5":24381,"_16893":43966,"_22829":43967,"_2311":43968},[],"/docs/platform/overview#automate-device-identities","Automate device identities",{"_2783":1501,"_24069":1491,"_5":24381,"_16893":43970,"_22829":43971,"_2311":43972},[],"/docs/platform/overview#publish-validation-status","Publish validation status",{"_2783":1502,"_24069":1491,"_5":24381,"_16893":43974,"_22829":43975,"_2311":43976},[],"/docs/platform/overview#react-to-events","React to events",{"_2783":1503,"_24069":1491,"_5":24381,"_16893":43978,"_22829":43979,"_2311":43980},[],"/docs/platform/overview#operational-reference","Operational reference",{"_2783":1504,"_24069":1491,"_16893":43982,"_5":16788,"_22829":1491,"_2311":43983},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_2783":1505,"_24069":1491,"_16893":43985,"_5":16788,"_22829":43940,"_2311":43986},[],"Choose the result you need:",{"_2783":1506,"_24069":1491,"_16893":43988,"_5":16788,"_22829":43940,"_2311":43989},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2783":1507,"_24069":1491,"_16893":43991,"_5":16788,"_22829":43940,"_2311":43992},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2783":1508,"_24069":1491,"_16893":43994,"_5":16788,"_22829":43940,"_2311":43995},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_2783":1509,"_24069":1491,"_16893":43997,"_5":16788,"_22829":43943,"_2311":43998},[],"Section",{"_2783":1510,"_24069":1491,"_16893":44000,"_5":16788,"_22829":43943,"_2311":44001},[],"What you manage",{"_2783":1511,"_24069":1491,"_16893":44003,"_5":16788,"_22829":43943,"_2311":44004},[],"Entry point",{"_2783":1512,"_24069":1491,"_16893":44006,"_5":16788,"_22829":43943,"_2311":44007},[],"**PKI**",{"_2783":1513,"_24069":1491,"_16893":44009,"_5":16788,"_22829":43943,"_2311":44010},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_2783":1514,"_24069":1491,"_16893":44012,"_5":16788,"_22829":43943,"_2311":44013},[],"PKI overview",{"_2783":1515,"_24069":1491,"_16893":44015,"_5":16788,"_22829":43943,"_2311":44016},[],"**IoT Fleets**",{"_2783":1516,"_24069":1491,"_16893":44018,"_5":16788,"_22829":43943,"_2311":44019},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_2783":1517,"_24069":1491,"_16893":44021,"_5":16788,"_22829":43943,"_2311":44022},[],"IoT Fleets overview",{"_2783":1518,"_24069":1491,"_16893":44024,"_5":16788,"_22829":43943,"_2311":44025},[],"**Administration**",{"_2783":1519,"_24069":1491,"_16893":44027,"_5":16788,"_22829":43943,"_2311":44028},[],"Operator permissions, audit and event subscriptions.",{"_2783":1520,"_24069":1491,"_16893":44030,"_5":16788,"_22829":43943,"_2311":40647},[],{"_2783":1521,"_24069":1491,"_16893":44032,"_5":16788,"_22829":43943,"_2311":44033},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_2783":1522,"_24069":1491,"_16893":44035,"_5":16788,"_22829":43947,"_2311":44036},[],"An identity's journey connects four responsibilities:",{"_2783":1523,"_24069":1491,"_16893":44038,"_5":16788,"_22829":43947,"_2311":44039},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_2783":1524,"_24069":1491,"_16893":44041,"_5":16788,"_22829":43947,"_2311":44042},[],"The provisioning administrator configures the DMS and initial trust.",{"_2783":1525,"_24069":1491,"_16893":44044,"_5":16788,"_22829":43947,"_2311":44045},[],"The device client requests a certificate and installs it with the matching key.",{"_2783":1526,"_24069":1491,"_16893":44047,"_5":16788,"_22829":43947,"_2311":44048},[],"The consumer validates the identity and applies its access permissions.",{"_2783":1527,"_24069":1491,"_16893":44050,"_5":16788,"_22829":43947,"_2311":44051},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_2783":1528,"_24069":1491,"_16893":44053,"_5":16788,"_22829":43955,"_2311":44054},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_2783":1529,"_24069":1491,"_16893":44056,"_5":16788,"_22829":43959,"_2311":44057},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_2783":1530,"_24069":1491,"_16893":44059,"_5":16788,"_22829":43963,"_2311":44060},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_2783":1531,"_24069":1491,"_16893":44062,"_5":16788,"_22829":43967,"_2311":44063},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_2783":1532,"_24069":1491,"_16893":44065,"_5":16788,"_22829":43971,"_2311":44066},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_2783":1533,"_24069":1491,"_16893":44068,"_5":16788,"_22829":43975,"_2311":44069},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_2783":1534,"_24069":1491,"_16893":44071,"_5":16788,"_22829":43979,"_2311":43512},[],{"_2783":1535,"_24069":1491,"_16893":44073,"_5":16788,"_22829":43979,"_2311":44074},[],"What it prepares or checks",{"_2783":1536,"_24069":1491,"_16893":44076,"_5":16788,"_22829":43979,"_2311":43515},[],{"_2783":1537,"_24069":1491,"_16893":44078,"_5":16788,"_22829":43979,"_2311":44079},[],"Key custody, CA hierarchy, profiles and validation.",{"_2783":1538,"_24069":1491,"_16893":44081,"_5":16788,"_22829":43979,"_2311":44082},[],"Fleet administrator",{"_2783":1539,"_24069":1491,"_16893":44084,"_5":16788,"_22829":43979,"_2311":44085},[],"DMS, device admission, renewal policy and inventory.",{"_2783":1540,"_24069":1491,"_16893":44087,"_5":16788,"_22829":43979,"_2311":43527},[],{"_2783":1541,"_24069":1491,"_16893":44089,"_5":16788,"_22829":43979,"_2311":44090},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_2783":1542,"_24069":1491,"_16893":44092,"_5":16788,"_22829":43979,"_2311":43533},[],{"_2783":1543,"_24069":1491,"_16893":44094,"_5":16788,"_22829":43979,"_2311":44095},[],"Issuer trust, certificate validation and permissions in the destination.",{"_2783":1544,"_24069":1491,"_16893":44097,"_5":16788,"_22829":43979,"_2311":44098},[],"Infrastructure operator",{"_2783":1545,"_24069":1491,"_16893":44100,"_5":16788,"_22829":43979,"_2311":44101},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_2783":1546,"_24069":1491,"_16893":44103,"_5":16788,"_22829":43979,"_2311":44104},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_2783":1547,"_24069":1547,"_5":11891,"_2311":44106,"_24384":44107,"_16893":44110,"_22829":1547},"CA hierarchy and rotation",[39305,40649,44108,44109],"PKI","Keys, authorities and certificates",[],{"_2783":1548,"_24069":1547,"_16893":44112,"_5":16788,"_22829":1547,"_2311":44113},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_2783":1549,"_24069":1547,"_5":24381,"_16893":44115,"_22829":44116,"_2311":44117},[],"/docs/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_2783":1550,"_24069":1547,"_5":24381,"_16893":44119,"_22829":44120,"_2311":44121},[],"/docs/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_2783":1551,"_24069":1547,"_5":24381,"_16893":44123,"_22829":44124,"_2311":44125},[],"/docs/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_2783":1552,"_24069":1547,"_5":24381,"_16893":44127,"_22829":44128,"_2311":44129},[],"/docs/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_2783":1553,"_24069":1547,"_5":24381,"_16893":44131,"_22829":44132,"_2311":44133},[],"/docs/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_2783":1554,"_24069":1547,"_5":24381,"_16893":44135,"_22829":44136,"_2311":44137},[],"/docs/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_2783":1555,"_24069":1547,"_5":24381,"_16893":44139,"_22829":44140,"_2311":44141},[],"/docs/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_2783":1556,"_24069":1547,"_5":24381,"_16893":44143,"_22829":44144,"_2311":44145},[],"/docs/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_2783":1557,"_24069":1547,"_5":24381,"_16893":44147,"_22829":44148,"_2311":44149},[],"/docs/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_2783":1558,"_24069":1547,"_5":24381,"_16893":44151,"_22829":44152,"_2311":44153},[],"/docs/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_2783":1559,"_24069":1547,"_5":24381,"_16893":44155,"_22829":44156,"_2311":44157},[],"/docs/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_2783":1560,"_24069":1547,"_5":24381,"_16893":44159,"_22829":44160,"_2311":44161},[],"/docs/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_2783":1561,"_24069":1547,"_16893":44163,"_5":16788,"_22829":1547,"_2311":44164},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_2783":1562,"_24069":1547,"_16893":44166,"_5":16788,"_22829":1547,"_2311":44167},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_2783":1563,"_24069":1547,"_16893":44169,"_5":16788,"_22829":44116,"_2311":44170},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_2783":1564,"_24069":1547,"_16893":44172,"_5":16788,"_22829":44116,"_2311":44173},[],"environment, such as production and preproduction;",{"_2783":1565,"_24069":1547,"_16893":44175,"_5":16788,"_22829":44116,"_2311":44176},[],"owner or operating team;",{"_2783":1566,"_24069":1547,"_16893":44178,"_5":16788,"_22829":44116,"_2311":44179},[],"device family or manufacturing process;",{"_2783":1567,"_24069":1547,"_16893":44181,"_5":16788,"_22829":44116,"_2311":44182},[],"region or regulatory requirement;",{"_2783":1568,"_24069":1547,"_16893":44184,"_5":16788,"_22829":44116,"_2311":44185},[],"cryptographic engine or key policy;",{"_2783":1569,"_24069":1547,"_16893":44187,"_5":16788,"_22829":44116,"_2311":44188},[],"maintenance window and renewal cadence.",{"_2783":1570,"_24069":1547,"_16893":44190,"_5":16788,"_22829":44116,"_2311":44191},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_2783":1571,"_24069":1547,"_16893":44193,"_5":16788,"_22829":44116,"_2311":44194},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_2783":1572,"_24069":1547,"_16893":44196,"_5":16788,"_22829":44120,"_2311":44197},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_2783":1573,"_24069":1547,"_16893":44199,"_5":16788,"_22829":44120,"_2311":44200},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_2783":1574,"_24069":1547,"_16893":44202,"_5":16788,"_22829":44120,"_2311":44203},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_2783":1575,"_24069":1547,"_16893":44205,"_5":16788,"_22829":44124,"_2311":44206},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_2783":1576,"_24069":1547,"_16893":44208,"_5":16788,"_22829":44124,"_2311":44209},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_2783":1577,"_24069":1547,"_16893":44211,"_5":16788,"_22829":44124,"_2311":44212},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_2783":1578,"_24069":1547,"_16893":44214,"_5":16788,"_22829":44124,"_2311":44215},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_2783":1579,"_24069":1547,"_16893":44217,"_5":16788,"_22829":44132,"_2311":44218},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_2783":1580,"_24069":1547,"_16893":44220,"_5":16788,"_22829":44136,"_2311":44221},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_2783":1581,"_24069":1547,"_16893":44223,"_5":16788,"_22829":44140,"_2311":44224},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_2783":1582,"_24069":1547,"_16893":44226,"_5":16788,"_22829":44144,"_2311":44227},[],"Update the enrollment CA and profile of the DMSs. Keep the additional validation CAs if old certificates still need to be accepted during re-enrollment.",{"_2783":1583,"_24069":1547,"_16893":44229,"_5":16788,"_22829":44148,"_2311":44230},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_2783":1584,"_24069":1547,"_16893":44232,"_5":16788,"_22829":44152,"_2311":44233},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance and from the distributed CAs. Revoke it if policy requires it.",{"_2783":1585,"_24069":1547,"_16893":44235,"_5":16788,"_22829":44156,"_2311":44236},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_2783":1586,"_24069":1547,"_16893":44238,"_5":16788,"_22829":44156,"_2311":44239},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_2783":1587,"_24069":1547,"_16893":44241,"_5":16788,"_22829":44156,"_2311":44242},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_2783":1588,"_24069":1547,"_16893":44244,"_5":16788,"_22829":44156,"_2311":44245},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_2783":1589,"_24069":1547,"_16893":44247,"_5":16788,"_22829":44160,"_2311":44248},[],"The new chain ends in an anchor installed by the consumer.",{"_2783":1590,"_24069":1547,"_16893":44250,"_5":16788,"_22829":44160,"_2311":44251},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_2783":1591,"_24069":1547,"_16893":44253,"_5":16788,"_22829":44160,"_2311":44254},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_2783":1592,"_24069":1547,"_16893":44256,"_5":16788,"_22829":44160,"_2311":44257},[],"Re-enrollment accepts the old identity during the planned period.",{"_2783":1593,"_24069":1547,"_16893":44259,"_5":16788,"_22829":44160,"_2311":44260},[],"OCSP and CRL respond for the authorities that remain active.",{"_2783":1594,"_24069":1547,"_16893":44262,"_5":16788,"_22829":44160,"_2311":44263},[],"No DMS is left accidentally issuing from the old CA.",{"_2783":1595,"_24069":1547,"_16893":44265,"_5":16788,"_22829":44160,"_2311":44266},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_2783":1596,"_24069":1596,"_5":11891,"_2311":44268,"_24384":44269,"_16893":44270,"_22829":1596},"Certification authorities",[39305,40649,44108,44109],[],{"_2783":1597,"_24069":1596,"_16893":44272,"_5":16788,"_22829":1596,"_2311":44273},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_2783":1598,"_24069":1596,"_5":24381,"_16893":44275,"_22829":44276,"_2311":44277},[],"/docs/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_2783":1599,"_24069":1596,"_5":24381,"_16893":44279,"_22829":44280,"_2311":44281},[],"/docs/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_2783":1600,"_24069":1596,"_5":24381,"_16893":44283,"_22829":44284,"_2311":39315},[],"/docs/platform/pki/certificate-authorities#before-you-begin",{"_2783":1601,"_24069":1596,"_5":24381,"_16893":44286,"_22829":44287,"_2311":44288},[],"/docs/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_2783":1602,"_24069":1596,"_5":24381,"_16893":44290,"_22829":44291,"_2311":44292},[],"/docs/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_2783":1603,"_24069":1596,"_5":24381,"_16893":44294,"_22829":44295,"_2311":44296},[],"/docs/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_2783":1604,"_24069":1596,"_5":24381,"_16893":44298,"_22829":44299,"_2311":44300},[],"/docs/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_2783":1605,"_24069":1596,"_5":24381,"_16893":44302,"_22829":44303,"_2311":44304},[],"/docs/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_2783":1606,"_24069":1596,"_5":24381,"_16893":44306,"_22829":44307,"_2311":44308},[],"/docs/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_2783":1607,"_24069":1596,"_5":24381,"_16893":44310,"_22829":44311,"_2311":44312},[],"/docs/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_2783":1608,"_24069":1596,"_5":24381,"_16893":44314,"_22829":44315,"_2311":44316},[],"/docs/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_2783":1609,"_24069":1596,"_5":24381,"_16893":44318,"_22829":44319,"_2311":44320},[],"/docs/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_2783":1610,"_24069":1596,"_5":24381,"_16893":44322,"_22829":44323,"_2311":44324},[],"/docs/platform/pki/certificate-authorities#load-the-material","Load the material",{"_2783":1611,"_24069":1596,"_5":24381,"_16893":44326,"_22829":44327,"_2311":44328},[],"/docs/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_2783":1612,"_24069":1596,"_5":24381,"_16893":44330,"_22829":44331,"_2311":44332},[],"/docs/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_2783":1613,"_24069":1596,"_5":24381,"_16893":44334,"_22829":44335,"_2311":44336},[],"/docs/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_2783":1614,"_24069":1596,"_5":24381,"_16893":44338,"_22829":44339,"_2311":44340},[],"/docs/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_2783":1615,"_24069":1596,"_5":24381,"_16893":44342,"_22829":44343,"_2311":44344},[],"/docs/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_2783":1616,"_24069":1596,"_5":24381,"_16893":44346,"_22829":44347,"_2311":44348},[],"/docs/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_2783":1617,"_24069":1596,"_5":24381,"_16893":44350,"_22829":44351,"_2311":44352},[],"/docs/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_2783":1618,"_24069":1596,"_5":24381,"_16893":44354,"_22829":44355,"_2311":44356},[],"/docs/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_2783":1619,"_24069":1596,"_5":24381,"_16893":44358,"_22829":44359,"_2311":44360},[],"/docs/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_2783":1620,"_24069":1596,"_16893":44362,"_5":16788,"_22829":1596,"_2311":44363},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_2783":1621,"_24069":1596,"_16893":44365,"_5":16788,"_22829":1596,"_2311":44366},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_2783":1622,"_24069":1596,"_16893":44368,"_5":16788,"_22829":1596,"_2311":44369},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_2783":1623,"_24069":1596,"_16893":44371,"_5":16788,"_22829":44276,"_2311":44372},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_2783":1624,"_24069":1596,"_16893":44374,"_5":16788,"_22829":44276,"_2311":44375},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_2783":1625,"_24069":1596,"_16893":44377,"_5":16788,"_22829":44276,"_2311":44378},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_2783":1626,"_24069":1596,"_16893":44380,"_5":16788,"_22829":44276,"_2311":44381},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_2783":1627,"_24069":1596,"_16893":44383,"_5":16788,"_22829":44276,"_2311":44384},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_2783":1628,"_24069":1596,"_16893":44386,"_5":16788,"_22829":44284,"_2311":44387},[],"Decide whether the CA will be a root or an intermediate.",{"_2783":1629,"_24069":1596,"_16893":44389,"_5":16788,"_22829":44284,"_2311":44390},[],"Choose the engine that will keep the key.",{"_2783":1630,"_24069":1596,"_16893":44392,"_5":16788,"_22829":44284,"_2311":44393},[],"Define a validity longer than that of the certificates it will issue.",{"_2783":1631,"_24069":1596,"_16893":44395,"_5":16788,"_22829":44284,"_2311":44396},[],"For an intermediate CA, make sure the parent CA is active.",{"_2783":1632,"_24069":1596,"_16893":44398,"_5":16788,"_22829":44287,"_2311":44399},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_2783":1633,"_24069":1596,"_16893":44401,"_5":16788,"_22829":44291,"_2311":44402},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_2783":1634,"_24069":1596,"_16893":44404,"_5":16788,"_22829":44291,"_2311":44405},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_2783":1635,"_24069":1596,"_16893":44407,"_5":16788,"_22829":44295,"_2311":44408},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_2783":1636,"_24069":1596,"_16893":44410,"_5":16788,"_22829":44299,"_2311":44411},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_2783":1637,"_24069":1596,"_16893":44413,"_5":16788,"_22829":44299,"_2311":44414},[],"`C`: two-letter ISO 3166-1 country code.",{"_2783":1638,"_24069":1596,"_16893":44416,"_5":16788,"_22829":44299,"_2311":44417},[],"`ST`: state or province.",{"_2783":1639,"_24069":1596,"_16893":44419,"_5":16788,"_22829":44299,"_2311":44420},[],"`L`: locality.",{"_2783":1640,"_24069":1596,"_16893":44422,"_5":16788,"_22829":44299,"_2311":44423},[],"`O`: organization.",{"_2783":1641,"_24069":1596,"_16893":44425,"_5":16788,"_22829":44299,"_2311":44426},[],"`OU`: organizational unit.",{"_2783":1642,"_24069":1596,"_16893":44428,"_5":16788,"_22829":44299,"_2311":44429},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_2783":1643,"_24069":1596,"_16893":44431,"_5":16788,"_22829":44303,"_2311":44432},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_2783":1644,"_24069":1596,"_16893":44434,"_5":16788,"_22829":44303,"_2311":44435},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_2783":1645,"_24069":1596,"_16893":44437,"_5":16788,"_22829":44307,"_2311":44438},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_2783":1646,"_24069":1596,"_16893":44440,"_5":16788,"_22829":44307,"_2311":44441},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_2783":1647,"_24069":1596,"_16893":44443,"_5":16788,"_22829":44311,"_2311":44444},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_2783":1648,"_24069":1596,"_16893":44446,"_5":16788,"_22829":44311,"_2311":44447},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_2783":1649,"_24069":1596,"_16893":44449,"_5":16788,"_22829":44315,"_2311":44450},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_2783":1650,"_24069":1596,"_16893":44452,"_5":16788,"_22829":44319,"_2311":44453},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_2783":1651,"_24069":1596,"_16893":44455,"_5":16788,"_22829":44323,"_2311":44456},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_2783":1652,"_24069":1596,"_16893":44458,"_5":16788,"_22829":44327,"_2311":44459},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_2783":1653,"_24069":1596,"_16893":44461,"_5":16788,"_22829":44331,"_2311":44462},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_2783":1654,"_24069":1596,"_16893":44464,"_5":16788,"_22829":44331,"_2311":44465},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_2783":1655,"_24069":1596,"_16893":44467,"_5":16788,"_22829":44335,"_2311":44468},[],"Open a CA from the inventory to review:",{"_2783":1656,"_24069":1596,"_16893":44470,"_5":16788,"_22829":44335,"_2311":44471},[],"Status and validity period.",{"_2783":1657,"_24069":1596,"_16893":44473,"_5":16788,"_22829":44335,"_2311":44474},[],"Certificate and chain in PEM format.",{"_2783":1658,"_24069":1596,"_16893":44476,"_5":16788,"_22829":44335,"_2311":44477},[],"Number of active, expired and revoked certificates.",{"_2783":1659,"_24069":1596,"_16893":44479,"_5":16788,"_22829":44335,"_2311":44480},[],"Certificates issued in **Issued Certificates**.",{"_2783":1660,"_24069":1596,"_16893":44482,"_5":16788,"_22829":44335,"_2311":44483},[],"The CRL linked to the authority.",{"_2783":1661,"_24069":1596,"_16893":44485,"_5":16788,"_22829":44335,"_2311":44486},[],"Metadata and the associated cryptographic engine.",{"_2783":1662,"_24069":1596,"_16893":44488,"_5":16788,"_22829":44335,"_2311":44489},[],"You can filter the inventory by name, status and CA type.",{"_2783":1663,"_24069":1596,"_16893":44491,"_5":16788,"_22829":44339,"_2311":44492},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_2783":1664,"_24069":1596,"_16893":44494,"_5":16788,"_22829":44339,"_2311":44495},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_2783":1665,"_24069":1596,"_16893":44497,"_5":16788,"_22829":44339,"_2311":44498},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_2783":1666,"_24069":1596,"_16893":44500,"_5":16788,"_22829":44339,"_2311":44501},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_2783":1667,"_24069":1596,"_16893":44503,"_5":16788,"_22829":44343,"_2311":44504},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_2783":1668,"_24069":1596,"_16893":44506,"_5":16788,"_22829":44347,"_2311":44507},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_2783":1669,"_24069":1596,"_16893":44509,"_5":16788,"_22829":44351,"_2311":44510},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_2783":1670,"_24069":1596,"_16893":44512,"_5":16788,"_22829":44355,"_2311":44513},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_2783":1671,"_24069":1596,"_16893":44515,"_5":16788,"_22829":44359,"_2311":44516},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_2783":1672,"_24069":1596,"_16893":44518,"_5":16788,"_22829":44359,"_2311":44519},[],"Permanent deletion is only available after revoking. Delete the record only when your retention and audit policy allows it.",{"_2783":1673,"_24069":1673,"_5":11891,"_2311":44521,"_24384":44522,"_16893":44523,"_22829":1673},"Certificate profiles",[39305,40649,44108,44109],[],{"_2783":1674,"_24069":1673,"_16893":44525,"_5":16788,"_22829":1673,"_2311":44526},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_2783":1675,"_24069":1673,"_5":24381,"_16893":44528,"_22829":44529,"_2311":44530},[],"/docs/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_2783":1676,"_24069":1673,"_5":24381,"_16893":44532,"_22829":44533,"_2311":44534},[],"/docs/platform/pki/certificate-profiles#validity","Validity",{"_2783":1677,"_24069":1673,"_5":24381,"_16893":44536,"_22829":44537,"_2311":44538},[],"/docs/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_2783":1678,"_24069":1673,"_5":24381,"_16893":44540,"_22829":44541,"_2311":44542},[],"/docs/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_2783":1679,"_24069":1673,"_5":24381,"_16893":44544,"_22829":44545,"_2311":44546},[],"/docs/platform/pki/certificate-profiles#subject","Subject",{"_2783":1680,"_24069":1673,"_5":24381,"_16893":44548,"_22829":44549,"_2311":44550},[],"/docs/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_2783":1681,"_24069":1673,"_5":24381,"_16893":44552,"_22829":44553,"_2311":44554},[],"/docs/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_2783":1682,"_24069":1673,"_5":24381,"_16893":44556,"_22829":44557,"_2311":44558},[],"/docs/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_2783":1683,"_24069":1673,"_5":24381,"_16893":44560,"_22829":44561,"_2311":44562},[],"/docs/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_2783":1684,"_24069":1673,"_5":24381,"_16893":44564,"_22829":44565,"_2311":44566},[],"/docs/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_2783":1685,"_24069":1673,"_5":24381,"_16893":44568,"_22829":44569,"_2311":44570},[],"/docs/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_2783":1686,"_24069":1673,"_5":24381,"_16893":44572,"_22829":44573,"_2311":44574},[],"/docs/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_2783":1687,"_24069":1673,"_5":24381,"_16893":44576,"_22829":44577,"_2311":44578},[],"/docs/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_2783":1688,"_24069":1673,"_5":24381,"_16893":44580,"_22829":44581,"_2311":44582},[],"/docs/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_2783":1689,"_24069":1673,"_5":24381,"_16893":44584,"_22829":44585,"_2311":44586},[],"/docs/platform/pki/certificate-profiles#design-examples","Design examples",{"_2783":1690,"_24069":1673,"_5":24381,"_16893":44588,"_22829":44589,"_2311":44590},[],"/docs/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_2783":1691,"_24069":1673,"_16893":44592,"_5":16788,"_22829":1673,"_2311":44593},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_2783":1692,"_24069":1673,"_16893":44595,"_5":16788,"_22829":1673,"_2311":44596},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_2783":1693,"_24069":1673,"_16893":44598,"_5":16788,"_22829":44533,"_2311":44599},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_2783":1694,"_24069":1673,"_16893":44601,"_5":16788,"_22829":44533,"_2311":44602},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_2783":1695,"_24069":1673,"_16893":44604,"_5":16788,"_22829":44537,"_2311":44605},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_2783":1696,"_24069":1673,"_16893":44607,"_5":16788,"_22829":44541,"_2311":44608},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_2783":1697,"_24069":1673,"_16893":44610,"_5":16788,"_22829":44541,"_2311":44611},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_2783":1698,"_24069":1673,"_16893":44613,"_5":16788,"_22829":44541,"_2311":44614},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_2783":1699,"_24069":1673,"_16893":44616,"_5":16788,"_22829":44545,"_2311":44617},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_2783":1700,"_24069":1673,"_16893":44619,"_5":16788,"_22829":44549,"_2311":44620},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_2783":1701,"_24069":1673,"_16893":44622,"_5":16788,"_22829":44549,"_2311":44623},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_2783":1702,"_24069":1673,"_16893":44625,"_5":16788,"_22829":44553,"_2311":44626},[],"The cryptographic enforcement can:",{"_2783":1703,"_24069":1673,"_16893":44628,"_5":16788,"_22829":44553,"_2311":44629},[],"allow or block RSA keys;",{"_2783":1704,"_24069":1673,"_16893":44631,"_5":16788,"_22829":44553,"_2311":44632},[],"limit the supported RSA sizes;",{"_2783":1705,"_24069":1673,"_16893":44634,"_5":16788,"_22829":44553,"_2311":44635},[],"allow or block ECDSA keys;",{"_2783":1706,"_24069":1673,"_16893":44637,"_5":16788,"_22829":44553,"_2311":44638},[],"limit the supported ECDSA sizes or curves.",{"_2783":1707,"_24069":1673,"_16893":44640,"_5":16788,"_22829":44553,"_2311":44641},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_2783":1708,"_24069":1673,"_16893":44643,"_5":16788,"_22829":44557,"_2311":44644},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_2783":1709,"_24069":1673,"_16893":44646,"_5":16788,"_22829":44557,"_2311":42178},[],{"_2783":1710,"_24069":1673,"_16893":44648,"_5":16788,"_22829":44557,"_2311":44649},[],"First choice",{"_2783":1711,"_24069":1673,"_16893":44651,"_5":16788,"_22829":44557,"_2311":44652},[],"Second choice",{"_2783":1712,"_24069":1673,"_16893":44654,"_5":16788,"_22829":44557,"_2311":44655},[],"If neither is supplied",{"_2783":1713,"_24069":1673,"_16893":44657,"_5":16788,"_22829":44557,"_2311":44658},[],"Direct signing with a CA",{"_2783":1714,"_24069":1673,"_16893":44660,"_5":16788,"_22829":44557,"_2311":44661},[],"`issuance_profile` embedded in the request",{"_2783":1715,"_24069":1673,"_16893":44663,"_5":16788,"_22829":44557,"_2311":44664},[],"Request `issuance_profile_id`",{"_2783":1716,"_24069":1673,"_16893":44666,"_5":16788,"_22829":44557,"_2311":44667},[],"CA default profile (`profile_id`).",{"_2783":1717,"_24069":1673,"_16893":44669,"_5":16788,"_22829":44557,"_2311":44670},[],"Issuance through a DMS",{"_2783":1718,"_24069":1673,"_16893":44672,"_5":16788,"_22829":44557,"_2311":44673},[],"`settings.issuance_profile_id`",{"_2783":1719,"_24069":1673,"_16893":44675,"_5":16788,"_22829":44557,"_2311":44676},[],"`settings.issuance_profile` embedded in the DMS",{"_2783":1720,"_24069":1673,"_16893":44678,"_5":16788,"_22829":44557,"_2311":44679},[],"Enrollment CA default profile.",{"_2783":1721,"_24069":1673,"_16893":44681,"_5":16788,"_22829":44557,"_2311":44682},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_2783":1722,"_24069":1673,"_16893":44684,"_5":16788,"_22829":44557,"_2311":44685},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_2783":1723,"_24069":1673,"_16893":44687,"_5":16788,"_22829":44565,"_2311":44688},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_2783":1724,"_24069":1673,"_16893":44690,"_5":16788,"_22829":44569,"_2311":44691},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_2783":1725,"_24069":1673,"_16893":44693,"_5":16788,"_22829":44573,"_2311":44694},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_2783":1726,"_24069":1673,"_16893":44696,"_5":16788,"_22829":44577,"_2311":44697},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_2783":1727,"_24069":1673,"_16893":44699,"_5":16788,"_22829":44581,"_2311":44700},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_2783":1728,"_24069":1673,"_16893":44702,"_5":16788,"_22829":44581,"_2311":44703},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_2783":1729,"_24069":1673,"_16893":44705,"_5":16788,"_22829":44585,"_2311":44706},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_2783":1730,"_24069":1673,"_16893":44708,"_5":16788,"_22829":44585,"_2311":44709},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_2783":1731,"_24069":1673,"_16893":44711,"_5":16788,"_22829":44585,"_2311":44712},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_2783":1732,"_24069":1673,"_16893":44714,"_5":16788,"_22829":44585,"_2311":44715},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_2783":1733,"_24069":1673,"_16893":44717,"_5":16788,"_22829":44589,"_2311":44718},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_2783":1734,"_24069":1673,"_16893":44720,"_5":16788,"_22829":44589,"_2311":44721},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_2783":1735,"_24069":1735,"_5":11891,"_2311":44723,"_24384":44724,"_16893":44726,"_22829":1735},"Certificate validation",[39305,40649,44108,44725],"Validation",[],{"_2783":1736,"_24069":1735,"_16893":44728,"_5":16788,"_22829":1735,"_2311":44729},[],"Check chain, identity, purpose and revocation from the consumer.",{"_2783":1737,"_24069":1735,"_5":24381,"_16893":44731,"_22829":44732,"_2311":44733},[],"/docs/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_2783":1738,"_24069":1735,"_5":24381,"_16893":44735,"_22829":44736,"_2311":44737},[],"/docs/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_2783":1739,"_24069":1735,"_5":24381,"_16893":44739,"_22829":44740,"_2311":44741},[],"/docs/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_2783":1740,"_24069":1735,"_16893":44743,"_5":16788,"_22829":1735,"_2311":44744},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_2783":1741,"_24069":1735,"_16893":44746,"_5":16788,"_22829":44732,"_2311":44747},[],"Verify these criteria together:",{"_2783":1742,"_24069":1735,"_16893":44749,"_5":16788,"_22829":44732,"_2311":43732},[],{"_2783":1743,"_24069":1735,"_16893":44751,"_5":16788,"_22829":44732,"_2311":44752},[],"Required result",{"_2783":1744,"_24069":1735,"_16893":44754,"_5":16788,"_22829":44732,"_2311":44755},[],"Chain and signature",{"_2783":1745,"_24069":1735,"_16893":44757,"_5":16788,"_22829":44732,"_2311":44758},[],"Valid chain to a root deliberately installed in the consumer.",{"_2783":1746,"_24069":1735,"_16893":44760,"_5":16788,"_22829":44732,"_2311":44761},[],"Dates",{"_2783":1747,"_24069":1735,"_16893":44763,"_5":16788,"_22829":44732,"_2311":44764},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_2783":1748,"_24069":1735,"_16893":44766,"_5":16788,"_22829":44732,"_2311":40352},[],{"_2783":1749,"_24069":1735,"_16893":44768,"_5":16788,"_22829":44732,"_2311":44769},[],"Name, SAN or identifier matches the expected peer.",{"_2783":1750,"_24069":1735,"_16893":44771,"_5":16788,"_22829":44732,"_2311":39688},[],{"_2783":1751,"_24069":1735,"_16893":44773,"_5":16788,"_22829":44732,"_2311":44774},[],"KU, EKU and constraints permit the specific operation.",{"_2783":1752,"_24069":1735,"_16893":44776,"_5":16788,"_22829":44732,"_2311":44777},[],"Revocation",{"_2783":1753,"_24069":1735,"_16893":44779,"_5":16788,"_22829":44732,"_2311":44780},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_2783":1754,"_24069":1735,"_16893":44782,"_5":16788,"_22829":44732,"_2311":44783},[],"Authorization",{"_2783":1755,"_24069":1735,"_16893":44785,"_5":16788,"_22829":44732,"_2311":44786},[],"The application permits that identity to perform the action.",{"_2783":1756,"_24069":1735,"_16893":44788,"_5":16788,"_22829":44732,"_2311":44789},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_2783":1757,"_24069":1735,"_16893":44791,"_5":16788,"_22829":44736,"_2311":44792},[],"Mechanism",{"_2783":1758,"_24069":1735,"_16893":44794,"_5":16788,"_22829":44736,"_2311":44795},[],"When to use it",{"_2783":1759,"_24069":1735,"_16893":44797,"_5":16788,"_22829":44736,"_2311":44798},[],"What you must maintain",{"_2783":1760,"_24069":1735,"_16893":44800,"_5":16788,"_22829":44736,"_2311":44801},[],"OCSP",{"_2783":1761,"_24069":1735,"_16893":44803,"_5":16788,"_22829":44736,"_2311":44804},[],"Status query for a specific certificate.",{"_2783":1762,"_24069":1735,"_16893":44806,"_5":16788,"_22829":44736,"_2311":44807},[],"Responder access, signature verification and cache/freshness policy.",{"_2783":1763,"_24069":1735,"_16893":44809,"_5":16788,"_22829":44736,"_2311":44810},[],"CRL",{"_2783":1764,"_24069":1735,"_16893":44812,"_5":16788,"_22829":44736,"_2311":44813},[],"Local checks for many certificates or offline operation.",{"_2783":1765,"_24069":1735,"_16893":44815,"_5":16788,"_22829":44736,"_2311":44816},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_2783":1766,"_24069":1735,"_16893":44818,"_5":16788,"_22829":44736,"_2311":44819},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_2783":1767,"_24069":1735,"_16893":44821,"_5":16788,"_22829":44736,"_2311":44822},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_2783":1768,"_24069":1735,"_16893":44824,"_5":16788,"_22829":44740,"_2311":44825},[],"Accept a current, authorized certificate with a known chain.",{"_2783":1769,"_24069":1735,"_16893":44827,"_5":16788,"_22829":44740,"_2311":44828},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_2783":1770,"_24069":1735,"_16893":44830,"_5":16788,"_22829":44740,"_2311":44831},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_2783":1771,"_24069":1735,"_16893":44833,"_5":16788,"_22829":44740,"_2311":44834},[],"Check that a new connection with that identity is rejected.",{"_2783":1772,"_24069":1735,"_16893":44836,"_5":16788,"_22829":44740,"_2311":44837},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_2783":1773,"_24069":1735,"_16893":44839,"_5":16788,"_22829":44740,"_2311":44840},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_2783":1774,"_24069":1735,"_16893":44842,"_5":16788,"_22829":44740,"_2311":44843},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_2783":1775,"_24069":1735,"_16893":44845,"_5":16788,"_22829":44740,"_2311":44846},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_2783":1776,"_24069":1735,"_16893":44848,"_5":16788,"_22829":44740,"_2311":44849},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_2783":1777,"_24069":1777,"_5":11891,"_2311":44851,"_24384":44852,"_16893":44853,"_22829":1777},"Certificates",[39305,40649,44108,44109],[],{"_2783":1778,"_24069":1777,"_16893":44855,"_5":16788,"_22829":1777,"_2311":44856},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_2783":1779,"_24069":1777,"_5":24381,"_16893":44858,"_22829":44859,"_2311":44860},[],"/docs/platform/pki/certificates#find-a-certificate","Find a certificate",{"_2783":1780,"_24069":1777,"_5":24381,"_16893":44862,"_22829":44863,"_2311":44864},[],"/docs/platform/pki/certificates#download-the-certificate","Download the certificate",{"_2783":1781,"_24069":1777,"_5":24381,"_16893":44866,"_22829":44867,"_2311":44868},[],"/docs/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_2783":1782,"_24069":1777,"_5":24381,"_16893":44870,"_22829":44871,"_2311":44872},[],"/docs/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_2783":1783,"_24069":1777,"_5":24381,"_16893":44874,"_22829":44875,"_2311":44876},[],"/docs/platform/pki/certificates#open-the-action","Open the action",{"_2783":1784,"_24069":1777,"_5":24381,"_16893":44878,"_22829":44879,"_2311":44880},[],"/docs/platform/pki/certificates#choose-a-reason","Choose a reason",{"_2783":1785,"_24069":1777,"_5":24381,"_16893":44882,"_22829":44883,"_2311":44884},[],"/docs/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_2783":1786,"_24069":1777,"_5":24381,"_16893":44886,"_22829":44887,"_2311":44888},[],"/docs/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_2783":1787,"_24069":1777,"_5":24381,"_16893":44890,"_22829":44891,"_2311":44892},[],"/docs/platform/pki/certificates#continue","Continue",{"_2783":1788,"_24069":1777,"_16893":44894,"_5":16788,"_22829":1777,"_2311":44895},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_2783":1789,"_24069":1777,"_16893":44897,"_5":16788,"_22829":44859,"_2311":44898},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_2783":1790,"_24069":1777,"_16893":44900,"_5":16788,"_22829":44859,"_2311":44901},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_2783":1791,"_24069":1777,"_16893":44903,"_5":16788,"_22829":44863,"_2311":44904},[],"Download the PEM and inspect it:",{"_2783":1792,"_24069":1777,"_16893":44906,"_5":16788,"_22829":44863,"_2311":44907},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_2783":1793,"_24069":1777,"_16893":44909,"_5":16788,"_22829":44867,"_2311":44910},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_2783":1794,"_24069":1777,"_16893":44912,"_5":16788,"_22829":44867,"_2311":44913},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_2783":1795,"_24069":1777,"_16893":44915,"_5":16788,"_22829":44867,"_2311":44916},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_2783":1796,"_24069":1777,"_16893":44918,"_5":16788,"_22829":44867,"_2311":44919},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_2783":1797,"_24069":1777,"_16893":44921,"_5":16788,"_22829":44867,"_2311":44922},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_2783":1798,"_24069":1777,"_16893":44924,"_5":16788,"_22829":44867,"_2311":44925},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_2783":1799,"_24069":1777,"_16893":44927,"_5":16788,"_22829":44867,"_2311":44928},[],"For browser key generation, follow Issue your first certificate.",{"_2783":1800,"_24069":1777,"_16893":44930,"_5":16788,"_22829":44871,"_2311":44931},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_2783":1801,"_24069":1777,"_16893":44933,"_5":16788,"_22829":44875,"_2311":44934},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_2783":1802,"_24069":1777,"_16893":44936,"_5":16788,"_22829":44879,"_2311":44937},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_2783":1803,"_24069":1777,"_16893":44939,"_5":16788,"_22829":44883,"_2311":44940},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_2783":1804,"_24069":1777,"_16893":44942,"_5":16788,"_22829":44883,"_2311":44943},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_2783":1805,"_24069":1777,"_16893":44945,"_5":16788,"_22829":44883,"_2311":44946},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_2783":1806,"_24069":1777,"_16893":44948,"_5":16788,"_22829":44887,"_2311":44949},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_2783":1807,"_24069":1777,"_16893":44951,"_5":16788,"_22829":44887,"_2311":44952},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_2783":1808,"_24069":1777,"_16893":44954,"_5":16788,"_22829":44887,"_2311":44955},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_2783":1809,"_24069":1777,"_16893":44957,"_5":16788,"_22829":44891,"_2311":44958},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_2783":1810,"_24069":1777,"_16893":44960,"_5":16788,"_22829":44891,"_2311":44961},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_2783":1811,"_24069":1811,"_5":11891,"_2311":44963,"_24384":44964,"_16893":44966,"_22829":1811},"Certificate lifecycle",[39305,40649,44108,44965],"Concepts",[],{"_2783":1812,"_24069":1811,"_16893":44968,"_5":16788,"_22829":1811,"_2311":44969},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_2783":1813,"_24069":1811,"_5":24381,"_16893":44971,"_22829":44972,"_2311":44973},[],"/docs/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_2783":1814,"_24069":1811,"_5":24381,"_16893":44975,"_22829":44976,"_2311":44977},[],"/docs/platform/pki/concepts/certificate-lifecycle#request","Request",{"_2783":1815,"_24069":1811,"_5":24381,"_16893":44979,"_22829":44980,"_2311":44981},[],"/docs/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_2783":1816,"_24069":1811,"_5":24381,"_16893":44983,"_22829":44984,"_2311":44985},[],"/docs/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_2783":1817,"_24069":1811,"_5":24381,"_16893":44987,"_22829":44988,"_2311":44989},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_2783":1818,"_24069":1811,"_5":24381,"_16893":44991,"_22829":44992,"_2311":44993},[],"/docs/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_2783":1819,"_24069":1811,"_5":24381,"_16893":44995,"_22829":44996,"_2311":44997},[],"/docs/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_2783":1820,"_24069":1811,"_5":24381,"_16893":44999,"_22829":45000,"_2311":45001},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_2783":1821,"_24069":1811,"_5":24381,"_16893":45003,"_22829":45004,"_2311":45005},[],"/docs/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_2783":1822,"_24069":1811,"_5":24381,"_16893":45007,"_22829":45008,"_2311":45009},[],"/docs/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_2783":1823,"_24069":1811,"_16893":45011,"_5":16788,"_22829":1811,"_2311":45012},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_2783":1824,"_24069":1811,"_16893":45014,"_5":16788,"_22829":44976,"_2311":45015},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_2783":1825,"_24069":1811,"_16893":45017,"_5":16788,"_22829":44980,"_2311":45018},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_2783":1826,"_24069":1811,"_16893":45020,"_5":16788,"_22829":44984,"_2311":45021},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_2783":1827,"_24069":1811,"_16893":45023,"_5":16788,"_22829":44988,"_2311":45024},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_2783":1828,"_24069":1811,"_16893":45026,"_5":16788,"_22829":44992,"_2311":45027},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_2783":1829,"_24069":1811,"_16893":45029,"_5":16788,"_22829":44996,"_2311":45030},[],"Lamassu persists four X.509 states:",{"_2783":1830,"_24069":1811,"_16893":45032,"_5":16788,"_22829":44996,"_2311":45033},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_2783":1831,"_24069":1811,"_16893":45035,"_5":16788,"_22829":44996,"_2311":45036},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_2783":1832,"_24069":1811,"_16893":45038,"_5":16788,"_22829":44996,"_2311":45039},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_2783":1833,"_24069":1811,"_16893":45041,"_5":16788,"_22829":44996,"_2311":45042},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_2783":1834,"_24069":1811,"_16893":45044,"_5":16788,"_22829":44996,"_2311":45045},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_2783":1835,"_24069":1811,"_16893":45047,"_5":16788,"_22829":45000,"_2311":45048},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_2783":1836,"_24069":1811,"_16893":45050,"_5":16788,"_22829":45000,"_2311":45051},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_2783":1837,"_24069":1811,"_16893":45053,"_5":16788,"_22829":45000,"_2311":45054},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_2783":1838,"_24069":1811,"_16893":45056,"_5":16788,"_22829":45004,"_2311":45057},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_2783":1839,"_24069":1811,"_16893":45059,"_5":16788,"_22829":45004,"_2311":45060},[],"Before confirming:",{"_2783":1840,"_24069":1811,"_16893":45062,"_5":16788,"_22829":45004,"_2311":45063},[],"Identify DMSs, devices and services that trust that chain.",{"_2783":1841,"_24069":1811,"_16893":45065,"_5":16788,"_22829":45004,"_2311":45066},[],"Distribute the new chain of trust.",{"_2783":1842,"_24069":1811,"_16893":45068,"_5":16788,"_22829":45004,"_2311":45069},[],"Reissue the necessary identities.",{"_2783":1843,"_24069":1811,"_16893":45071,"_5":16788,"_22829":45004,"_2311":45072},[],"Check OCSP and CRL from a real consumer.",{"_2783":1844,"_24069":1811,"_16893":45074,"_5":16788,"_22829":45004,"_2311":45075},[],"Revoke the old CA once no legitimate traffic remains.",{"_2783":1845,"_24069":1811,"_16893":45077,"_5":16788,"_22829":45004,"_2311":45078},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_2783":1846,"_24069":1811,"_16893":45080,"_5":16788,"_22829":45008,"_2311":45081},[],"Certificates entering the preventive or critical renewal window.",{"_2783":1847,"_24069":1811,"_16893":45083,"_5":16788,"_22829":45008,"_2311":45084},[],"Repeated enrollment or re-enrollment failures.",{"_2783":1848,"_24069":1811,"_16893":45086,"_5":16788,"_22829":45008,"_2311":45087},[],"Status changes and revocation reasons.",{"_2783":1849,"_24069":1811,"_16893":45089,"_5":16788,"_22829":45008,"_2311":45090},[],"OCSP and CRL publication and validity.",{"_2783":1850,"_24069":1811,"_16893":45092,"_5":16788,"_22829":45008,"_2311":45093},[],"Dependencies still presenting a replaced certificate.",{"_2783":1851,"_24069":1811,"_16893":45095,"_5":16788,"_22829":45008,"_2311":45096},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_2783":1852,"_24069":1852,"_5":11891,"_2311":45098,"_24384":45099,"_16893":45100,"_22829":1852},"Trust model",[39305,40649,44108,44965],[],{"_2783":1853,"_24069":1852,"_16893":45102,"_5":16788,"_22829":1852,"_2311":45103},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_2783":1854,"_24069":1852,"_5":24381,"_16893":45105,"_22829":45106,"_2311":45107},[],"/docs/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_2783":1855,"_24069":1852,"_5":24381,"_16893":45109,"_22829":45110,"_2311":45111},[],"/docs/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_2783":1856,"_24069":1852,"_5":24381,"_16893":45113,"_22829":45114,"_2311":45115},[],"/docs/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_2783":1857,"_24069":1852,"_5":24381,"_16893":45117,"_22829":45118,"_2311":45119},[],"/docs/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_2783":1858,"_24069":1852,"_5":24381,"_16893":45121,"_22829":45122,"_2311":45123},[],"/docs/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_2783":1859,"_24069":1852,"_5":24381,"_16893":45125,"_22829":45126,"_2311":45127},[],"/docs/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_2783":1860,"_24069":1852,"_5":24381,"_16893":45129,"_22829":45130,"_2311":45131},[],"/docs/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_2783":1861,"_24069":1852,"_5":24381,"_16893":45133,"_22829":45134,"_2311":45135},[],"/docs/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_2783":1862,"_24069":1852,"_5":24381,"_16893":45137,"_22829":45138,"_2311":45139},[],"/docs/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_2783":1863,"_24069":1852,"_5":24381,"_16893":45141,"_22829":45142,"_2311":45143},[],"/docs/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_2783":1864,"_24069":1852,"_16893":45145,"_5":16788,"_22829":1852,"_2311":45146},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_2783":1865,"_24069":1852,"_16893":45148,"_5":16788,"_22829":45110,"_2311":45149},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_2783":1866,"_24069":1852,"_16893":45151,"_5":16788,"_22829":45114,"_2311":45152},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_2783":1867,"_24069":1852,"_16893":45154,"_5":16788,"_22829":45118,"_2311":45155},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_2783":1868,"_24069":1852,"_16893":45157,"_5":16788,"_22829":45122,"_2311":45158},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_2783":1869,"_24069":1852,"_16893":45160,"_5":16788,"_22829":45126,"_2311":45161},[],"The device proves it can enroll according to the DMS policy.",{"_2783":1870,"_24069":1852,"_16893":45163,"_5":16788,"_22829":45126,"_2311":45164},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_2783":1871,"_24069":1852,"_16893":45166,"_5":16788,"_22829":45126,"_2311":45167},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_2783":1872,"_24069":1852,"_16893":45169,"_5":16788,"_22829":45126,"_2311":45170},[],"The device installs the certificate and the chain it needs.",{"_2783":1873,"_24069":1852,"_16893":45172,"_5":16788,"_22829":45126,"_2311":45173},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_2783":1874,"_24069":1852,"_16893":45175,"_5":16788,"_22829":45126,"_2311":45176},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_2783":1875,"_24069":1852,"_16893":45178,"_5":16788,"_22829":45130,"_2311":45179},[],"A DMS relates three sets that are worth designing separately:",{"_2783":1876,"_24069":1852,"_16893":45181,"_5":16788,"_22829":45130,"_2311":45182},[],"**Enrollment CA:** signs the new identities.",{"_2783":1877,"_24069":1852,"_16893":45184,"_5":16788,"_22829":45130,"_2311":45185},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, Lamassu tries the enrollment CA first and then the additional validation CAs.",{"_2783":1878,"_24069":1852,"_16893":45187,"_5":16788,"_22829":45130,"_2311":45188},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_2783":1879,"_24069":1852,"_16893":45190,"_5":16788,"_22829":45130,"_2311":45191},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_2783":1880,"_24069":1852,"_16893":45193,"_5":16788,"_22829":45134,"_2311":45194},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_2783":1881,"_24069":1852,"_16893":45196,"_5":16788,"_22829":45134,"_2311":45197},[],"that the current date is between `Not Before` and `Not After`;",{"_2783":1882,"_24069":1852,"_16893":45199,"_5":16788,"_22829":45134,"_2311":45200},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_2783":1883,"_24069":1852,"_16893":45202,"_5":16788,"_22829":45134,"_2311":45203},[],"that names, SANs and subject match the expected identity;",{"_2783":1884,"_24069":1852,"_16893":45205,"_5":16788,"_22829":45134,"_2311":45206},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_2783":1885,"_24069":1852,"_16893":45208,"_5":16788,"_22829":45134,"_2311":45209},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_2783":1886,"_24069":1852,"_16893":45211,"_5":16788,"_22829":45134,"_2311":45212},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_2783":1887,"_24069":1852,"_16893":45214,"_5":16788,"_22829":45138,"_2311":45215},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_2783":1888,"_24069":1852,"_16893":45217,"_5":16788,"_22829":45142,"_2311":45218},[],"Keep the root out of daily operations, or with very restricted access.",{"_2783":1889,"_24069":1852,"_16893":45220,"_5":16788,"_22829":45142,"_2311":45221},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_2783":1890,"_24069":1852,"_16893":45223,"_5":16788,"_22829":45142,"_2311":45224},[],"Assign explicit profiles to every use case.",{"_2783":1891,"_24069":1852,"_16893":45226,"_5":16788,"_22829":45142,"_2311":45227},[],"Distribute the new trust before starting a rotation.",{"_2783":1892,"_24069":1852,"_16893":45229,"_5":16788,"_22829":45142,"_2311":45230},[],"Keep enough overlap to renew a disconnected fleet.",{"_2783":1893,"_24069":1852,"_16893":45232,"_5":16788,"_22829":45142,"_2311":45233},[],"Validate from the consuming system, not only from the Lamassu console.",{"_2783":1894,"_24069":1852,"_16893":45235,"_5":16788,"_22829":45142,"_2311":45236},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_2783":1895,"_24069":1895,"_5":11891,"_2311":45238,"_24384":45239,"_16893":45240,"_22829":1895},"Revocation lists (CRL)",[39305,40649,44108,44725],[],{"_2783":1896,"_24069":1895,"_16893":45242,"_5":16788,"_22829":1895,"_2311":45243},[],"Generate and distribute signed lists to validate certificates offline.",{"_2783":1897,"_24069":1895,"_5":24381,"_16893":45245,"_22829":45246,"_2311":45247},[],"/docs/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_2783":1898,"_24069":1895,"_5":24381,"_16893":45249,"_22829":45250,"_2311":45251},[],"/docs/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_2783":1899,"_24069":1895,"_5":24381,"_16893":45253,"_22829":45254,"_2311":45255},[],"/docs/platform/pki/crl#crl-contents","CRL contents",{"_2783":1900,"_24069":1895,"_5":24381,"_16893":45257,"_22829":45258,"_2311":45259},[],"/docs/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_2783":1901,"_24069":1895,"_5":24381,"_16893":45261,"_22829":45262,"_2311":45263},[],"/docs/platform/pki/crl#va-role-management-api","VA role management API",{"_2783":1902,"_24069":1895,"_5":24381,"_16893":45265,"_22829":45266,"_2311":45267},[],"/docs/platform/pki/crl#from-the-interface","From the interface",{"_2783":1903,"_24069":1895,"_5":24381,"_16893":45269,"_22829":45270,"_2311":45271},[],"/docs/platform/pki/crl#references","References",{"_2783":1904,"_24069":1895,"_16893":45273,"_5":16788,"_22829":1895,"_2311":45274},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_2783":1905,"_24069":1895,"_16893":45276,"_5":16788,"_22829":45246,"_2311":45277},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_2783":1906,"_24069":1895,"_16893":45279,"_5":16788,"_22829":45246,"_2311":45280},[],"`crl_options` field",{"_2783":1907,"_24069":1895,"_16893":45282,"_5":16788,"_22829":45246,"_2311":39688},[],{"_2783":1908,"_24069":1895,"_16893":45284,"_5":16788,"_22829":45246,"_2311":45285},[],"Backend initial value",{"_2783":1909,"_24069":1895,"_16893":45287,"_5":16788,"_22829":45246,"_2311":45288},[],"`validity`",{"_2783":1910,"_24069":1895,"_16893":45290,"_5":16788,"_22829":45246,"_2311":45291},[],"Time from `thisUpdate` to `nextUpdate`.",{"_2783":1911,"_24069":1895,"_16893":45293,"_5":16788,"_22829":45246,"_2311":45294},[],"7 days.",{"_2783":1912,"_24069":1895,"_16893":45296,"_5":16788,"_22829":45246,"_2311":45297},[],"`refresh_interval`",{"_2783":1913,"_24069":1895,"_16893":45299,"_5":16788,"_22829":45246,"_2311":45300},[],"Time since publication that triggers scheduled renewal.",{"_2783":1914,"_24069":1895,"_16893":45302,"_5":16788,"_22829":45246,"_2311":45303},[],"6 days and 23 hours.",{"_2783":1915,"_24069":1895,"_16893":45305,"_5":16788,"_22829":45246,"_2311":45306},[],"`regenerate_on_revoke`",{"_2783":1916,"_24069":1895,"_16893":45308,"_5":16788,"_22829":45246,"_2311":45309},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_2783":1917,"_24069":1895,"_16893":45311,"_5":16788,"_22829":45246,"_2311":45312},[],"`true`.",{"_2783":1918,"_24069":1895,"_16893":45314,"_5":16788,"_22829":45246,"_2311":45315},[],"`subject_key_id_signer`",{"_2783":1919,"_24069":1895,"_16893":45317,"_5":16788,"_22829":45246,"_2311":45318},[],"Configuration field initialized with the CA’s SKI.",{"_2783":1920,"_24069":1895,"_16893":45320,"_5":16788,"_22829":45246,"_2311":45321},[],"CA SKI.",{"_2783":1921,"_24069":1895,"_16893":45323,"_5":16788,"_22829":45246,"_2311":45324},[],"The generator uses the key of the CA identified by the requested SKI. Do not interpret `subject_key_id_signer` as verified support for a different delegated CA: changing that field does not change the signer in this flow.",{"_2783":1922,"_24069":1895,"_16893":45326,"_5":16788,"_22829":45246,"_2311":45327},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_2783":1923,"_24069":1895,"_16893":45329,"_5":16788,"_22829":45250,"_2311":45330},[],"The scheduled job requests another list when `refresh_interval` is reached or when the list approaches expiration within the configured watch period. This depends on working jobs, storage and signing; it does not guarantee renewal during a service failure.",{"_2783":1924,"_24069":1895,"_16893":45332,"_5":16788,"_22829":45250,"_2311":45333},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_2783":1925,"_24069":1895,"_16893":45335,"_5":16788,"_22829":45250,"_2311":45336},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_2783":1926,"_24069":1895,"_16893":45338,"_5":16788,"_22829":45254,"_2311":45339},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_2783":1927,"_24069":1895,"_16893":45341,"_5":16788,"_22829":45254,"_2311":45342},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_2783":1928,"_24069":1895,"_16893":45344,"_5":16788,"_22829":45258,"_2311":45345},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_2783":1929,"_24069":1895,"_16893":45347,"_5":16788,"_22829":45258,"_2311":45348},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_2783":1930,"_24069":1895,"_16893":45350,"_5":16788,"_22829":45258,"_2311":45351},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_2783":1931,"_24069":1895,"_16893":45353,"_5":16788,"_22829":45258,"_2311":45354},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_2783":1932,"_24069":1895,"_16893":45356,"_5":16788,"_22829":45258,"_2311":45357},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_2783":1933,"_24069":1895,"_16893":45359,"_5":16788,"_22829":45262,"_2311":45360},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_2783":1934,"_24069":1895,"_16893":45362,"_5":16788,"_22829":45262,"_2311":42181},[],{"_2783":1935,"_24069":1895,"_16893":45364,"_5":16788,"_22829":45262,"_2311":45365},[],"Relative path",{"_2783":1936,"_24069":1895,"_16893":45367,"_5":16788,"_22829":45262,"_2311":42178},[],{"_2783":1937,"_24069":1895,"_16893":45369,"_5":16788,"_22829":45262,"_2311":45370},[],"`GET`",{"_2783":1938,"_24069":1895,"_16893":45372,"_5":16788,"_22829":45262,"_2311":45373},[],"`/v1/roles/{ca-ski}`",{"_2783":1939,"_24069":1895,"_16893":45375,"_5":16788,"_22829":45262,"_2311":45376},[],"Read `crl_options` and `latest_crl`.",{"_2783":1940,"_24069":1895,"_16893":45378,"_5":16788,"_22829":45262,"_2311":45379},[],"`PUT`",{"_2783":1941,"_24069":1895,"_16893":45381,"_5":16788,"_22829":45262,"_2311":45373},[],{"_2783":1942,"_24069":1895,"_16893":45383,"_5":16788,"_22829":45262,"_2311":45384},[],"Replace CRL configuration.",{"_2783":1943,"_24069":1895,"_16893":45386,"_5":16788,"_22829":45262,"_2311":45387},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_2783":1944,"_24069":1895,"_16893":45389,"_5":16788,"_22829":45262,"_2311":45390},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_2783":1945,"_24069":1895,"_16893":45392,"_5":16788,"_22829":45266,"_2311":45393},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_2783":1946,"_24069":1895,"_16893":45395,"_5":16788,"_22829":45270,"_2311":45396},[],"RFC 5280: X.509 and CRL profile.",{"_2783":1947,"_24069":1895,"_16893":45398,"_5":16788,"_22829":45270,"_2311":45399},[],"OpenSSL: openssl-crl.",{"_2783":1948,"_24069":1895,"_16893":45401,"_5":16788,"_22829":45270,"_2311":45402},[],"OpenSSL: openssl-verify.",{"_2783":1949,"_24069":1895,"_16893":45404,"_5":16788,"_22829":45270,"_2311":45405},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_2783":1950,"_24069":1895,"_16893":45407,"_5":16788,"_22829":45270,"_2311":45408},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2783":1951,"_24069":1951,"_5":11891,"_2311":45410,"_24384":45411,"_16893":45412,"_22829":1951},"Keys and cryptographic engines",[39305,40649,44108,44109],[],{"_2783":1952,"_24069":1951,"_16893":45414,"_5":16788,"_22829":1951,"_2311":45415},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_2783":1953,"_24069":1951,"_5":24381,"_16893":45417,"_22829":45418,"_2311":45419},[],"/docs/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_2783":1954,"_24069":1951,"_5":24381,"_16893":45421,"_22829":45422,"_2311":45423},[],"/docs/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_2783":1955,"_24069":1951,"_5":24381,"_16893":45425,"_22829":45426,"_2311":45427},[],"/docs/platform/pki/key-management#file-system","File System",{"_2783":1956,"_24069":1951,"_5":24381,"_16893":45429,"_22829":45430,"_2311":45431},[],"/docs/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_2783":1957,"_24069":1951,"_5":24381,"_16893":45433,"_22829":45434,"_2311":45435},[],"/docs/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_2783":1958,"_24069":1951,"_5":24381,"_16893":45437,"_22829":45438,"_2311":45439},[],"/docs/platform/pki/key-management#aws-kms","AWS KMS",{"_2783":1959,"_24069":1951,"_5":24381,"_16893":45441,"_22829":45442,"_2311":45443},[],"/docs/platform/pki/key-management#pkcs11","PKCS#11",{"_2783":1960,"_24069":1951,"_5":24381,"_16893":45445,"_22829":45446,"_2311":45447},[],"/docs/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_2783":1961,"_24069":1951,"_5":24381,"_16893":45449,"_22829":45450,"_2311":45451},[],"/docs/platform/pki/key-management#key-inventory","Key inventory",{"_2783":1962,"_24069":1951,"_5":24381,"_16893":45453,"_22829":45454,"_2311":45455},[],"/docs/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_2783":1963,"_24069":1951,"_5":24381,"_16893":45457,"_22829":45458,"_2311":45459},[],"/docs/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_2783":1964,"_24069":1951,"_5":24381,"_16893":45461,"_22829":45462,"_2311":45463},[],"/docs/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_2783":1965,"_24069":1951,"_5":24381,"_16893":45465,"_22829":45466,"_2311":45467},[],"/docs/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_2783":1966,"_24069":1951,"_5":24381,"_16893":45469,"_22829":45470,"_2311":45471},[],"/docs/platform/pki/key-management#view-details","View details",{"_2783":1967,"_24069":1951,"_5":24381,"_16893":45473,"_22829":45474,"_2311":45475},[],"/docs/platform/pki/key-management#sign-and-verify","Sign and verify",{"_2783":1968,"_24069":1951,"_5":24381,"_16893":45477,"_22829":45478,"_2311":45479},[],"/docs/platform/pki/key-management#sign","Sign",{"_2783":1969,"_24069":1951,"_5":24381,"_16893":45481,"_22829":45482,"_2311":45483},[],"/docs/platform/pki/key-management#verify","Verify",{"_2783":1970,"_24069":1951,"_5":24381,"_16893":45485,"_22829":45486,"_2311":45487},[],"/docs/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_2783":1971,"_24069":1951,"_5":24381,"_16893":45489,"_22829":45490,"_2311":45491},[],"/docs/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_2783":1972,"_24069":1951,"_5":24381,"_16893":45493,"_22829":45494,"_2311":45495},[],"/docs/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_2783":1973,"_24069":1951,"_16893":45497,"_5":16788,"_22829":1951,"_2311":45498},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_2783":1974,"_24069":1951,"_16893":45500,"_5":16788,"_22829":1951,"_2311":45501},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_2783":1975,"_24069":1951,"_16893":45503,"_5":16788,"_22829":45418,"_2311":45504},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_2783":1976,"_24069":1951,"_16893":45506,"_5":16788,"_22829":45418,"_2311":45507},[],"In practice, it lets you:",{"_2783":1977,"_24069":1951,"_16893":45509,"_5":16788,"_22829":45418,"_2311":45510},[],"Generate new key pairs from Lamassu IoT.",{"_2783":1978,"_24069":1951,"_16893":45512,"_5":16788,"_22829":45418,"_2311":45513},[],"Import keys created externally.",{"_2783":1979,"_24069":1951,"_16893":45515,"_5":16788,"_22829":45418,"_2311":45516},[],"Delegate custody and cryptographic operations to external engines.",{"_2783":1980,"_24069":1951,"_16893":45518,"_5":16788,"_22829":45418,"_2311":45519},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_2783":1981,"_24069":1951,"_16893":45521,"_5":16788,"_22829":45422,"_2311":45522},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_2783":1982,"_24069":1951,"_16893":45524,"_5":16788,"_22829":45422,"_2311":45525},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_2783":1983,"_24069":1951,"_16893":45527,"_5":16788,"_22829":45422,"_2311":45528},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_2783":1984,"_24069":1951,"_16893":45530,"_5":16788,"_22829":45426,"_2311":45531},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_2783":1985,"_24069":1951,"_16893":45533,"_5":16788,"_22829":45430,"_2311":45534},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_2783":1986,"_24069":1951,"_16893":45536,"_5":16788,"_22829":45434,"_2311":45537},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_2783":1987,"_24069":1951,"_16893":45539,"_5":16788,"_22829":45438,"_2311":45540},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_2783":1988,"_24069":1951,"_16893":45542,"_5":16788,"_22829":45442,"_2311":45543},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_2783":1989,"_24069":1951,"_16893":45545,"_5":16788,"_22829":45446,"_2311":45546},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_2783":1990,"_24069":1951,"_16893":45548,"_5":16788,"_22829":45446,"_2311":45549},[],"Lamassu shows the enabled engines in the console.",{"_2783":1991,"_24069":1951,"_16893":45551,"_5":16788,"_22829":45446,"_2311":45552},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_2783":1992,"_24069":1951,"_16893":45554,"_5":16788,"_22829":45446,"_2311":45555},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_2783":1993,"_24069":1951,"_16893":45557,"_5":16788,"_22829":45450,"_2311":45558},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_2783":1994,"_24069":1951,"_16893":45560,"_5":16788,"_22829":45450,"_2311":45561},[],"The table includes the following fields:",{"_2783":1995,"_24069":1951,"_16893":45563,"_5":16788,"_22829":45450,"_2311":45564},[],"**Name**: descriptive name of the key.",{"_2783":1996,"_24069":1951,"_16893":45566,"_5":16788,"_22829":45450,"_2311":45567},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_2783":1997,"_24069":1951,"_16893":45569,"_5":16788,"_22829":45450,"_2311":45570},[],"**Strength**: visual indicator of cryptographic strength.",{"_2783":1998,"_24069":1951,"_16893":45572,"_5":16788,"_22829":45450,"_2311":45573},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_2783":1999,"_24069":1951,"_16893":45575,"_5":16788,"_22829":45450,"_2311":45576},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_2783":2000,"_24069":1951,"_16893":45578,"_5":16788,"_22829":45450,"_2311":45579},[],"**Aliases**: alternative names associated with the key.",{"_2783":2001,"_24069":1951,"_16893":45581,"_5":16788,"_22829":45450,"_2311":45582},[],"**Tags**: labels for classification and search.",{"_2783":2002,"_24069":1951,"_16893":45584,"_5":16788,"_22829":45450,"_2311":45585},[],"**Related Entities**: certificates or other entities linked to that key.",{"_2783":2003,"_24069":1951,"_16893":45587,"_5":16788,"_22829":45450,"_2311":45588},[],"From this view you also reach the most common actions:",{"_2783":2004,"_24069":1951,"_16893":45590,"_5":16788,"_22829":45450,"_2311":45591},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_2783":2005,"_24069":1951,"_16893":45593,"_5":16788,"_22829":45450,"_2311":45594},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_2783":2006,"_24069":1951,"_16893":45596,"_5":16788,"_22829":45450,"_2311":45597},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_2783":2007,"_24069":1951,"_16893":45599,"_5":16788,"_22829":45450,"_2311":45600},[],"**Delete Key** to remove the key from the system.",{"_2783":2008,"_24069":1951,"_16893":45602,"_5":16788,"_22829":45454,"_2311":45603},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_2783":2009,"_24069":1951,"_16893":45605,"_5":16788,"_22829":45458,"_2311":45606},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_2783":2010,"_24069":1951,"_16893":45608,"_5":16788,"_22829":45458,"_2311":45609},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_2783":2011,"_24069":1951,"_16893":45611,"_5":16788,"_22829":45458,"_2311":45612},[],"**Key Name**: unique and descriptive name.",{"_2783":2012,"_24069":1951,"_16893":45614,"_5":16788,"_22829":45458,"_2311":45615},[],"**Crypto Engine**: engine that will keep the key.",{"_2783":2013,"_24069":1951,"_16893":45617,"_5":16788,"_22829":45458,"_2311":45618},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_2783":2014,"_24069":1951,"_16893":45620,"_5":16788,"_22829":45458,"_2311":45621},[],"**Tags**: metadata to classify the key.",{"_2783":2015,"_24069":1951,"_16893":45623,"_5":16788,"_22829":45458,"_2311":45624},[],"**Metadata**: additional information for advanced uses.",{"_2783":2016,"_24069":1951,"_16893":45626,"_5":16788,"_22829":45462,"_2311":45627},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_2783":2017,"_24069":1951,"_16893":45629,"_5":16788,"_22829":45462,"_2311":45630},[],"When you have an exportable private key and the destination engine supports import.",{"_2783":2018,"_24069":1951,"_16893":45632,"_5":16788,"_22829":45462,"_2311":45633},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_2783":2019,"_24069":1951,"_16893":45635,"_5":16788,"_22829":45462,"_2311":45636},[],"When Lamassu must operate with a root of trust created by a third party.",{"_2783":2020,"_24069":1951,"_16893":45638,"_5":16788,"_22829":45462,"_2311":45639},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_2783":2021,"_24069":1951,"_16893":45641,"_5":16788,"_22829":45462,"_2311":45642},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_2783":2022,"_24069":1951,"_16893":45644,"_5":16788,"_22829":45462,"_2311":45645},[],"**Crypto Engine**: engine that will keep the imported key.",{"_2783":2023,"_24069":1951,"_16893":45647,"_5":16788,"_22829":45462,"_2311":45648},[],"**Tags**: labels for organization and search.",{"_2783":2024,"_24069":1951,"_16893":45650,"_5":16788,"_22829":45462,"_2311":45651},[],"**Metadata**: additional optional information.",{"_2783":2025,"_24069":1951,"_16893":45653,"_5":16788,"_22829":45462,"_2311":45654},[],"**Private Key (PEM)**: private key in PEM format.",{"_2783":2026,"_24069":1951,"_16893":45656,"_5":16788,"_22829":45462,"_2311":45657},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_2783":2027,"_24069":1951,"_16893":45659,"_5":16788,"_22829":45466,"_2311":45660},[],"Each registered key has a detail view and several operational actions.",{"_2783":2028,"_24069":1951,"_16893":45662,"_5":16788,"_22829":45470,"_2311":45663},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_2783":2029,"_24069":1951,"_16893":45665,"_5":16788,"_22829":45470,"_2311":45666},[],"The **Overview** tab shows, among others, these fields:",{"_2783":2030,"_24069":1951,"_16893":45668,"_5":16788,"_22829":45470,"_2311":45669},[],"**Key Name**: descriptive name.",{"_2783":2031,"_24069":1951,"_16893":45671,"_5":16788,"_22829":45470,"_2311":45672},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_2783":2032,"_24069":1951,"_16893":45674,"_5":16788,"_22829":45470,"_2311":45675},[],"**Tags**: associated labels.",{"_2783":2033,"_24069":1951,"_16893":45677,"_5":16788,"_22829":45470,"_2311":45678},[],"**Aliases**: alternative names.",{"_2783":2034,"_24069":1951,"_16893":45680,"_5":16788,"_22829":45470,"_2311":45681},[],"**Crypto Engine**: engine where the key resides.",{"_2783":2035,"_24069":1951,"_16893":45683,"_5":16788,"_22829":45470,"_2311":45684},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_2783":2036,"_24069":1951,"_16893":45686,"_5":16788,"_22829":45470,"_2311":45687},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_2783":2037,"_24069":1951,"_16893":45689,"_5":16788,"_22829":45470,"_2311":45690},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_2783":2038,"_24069":1951,"_16893":45692,"_5":16788,"_22829":45474,"_2311":45693},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_2783":2039,"_24069":1951,"_16893":45695,"_5":16788,"_22829":45474,"_2311":45696},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_2783":2040,"_24069":1951,"_16893":45698,"_5":16788,"_22829":45474,"_2311":45699},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_2783":2041,"_24069":1951,"_16893":45701,"_5":16788,"_22829":45478,"_2311":45702},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_2783":2042,"_24069":1951,"_16893":45704,"_5":16788,"_22829":45478,"_2311":45705},[],"Main fields:",{"_2783":2043,"_24069":1951,"_16893":45707,"_5":16788,"_22829":45478,"_2311":45708},[],"**Algorithm**: signing algorithm available for the key type.",{"_2783":2044,"_24069":1951,"_16893":45710,"_5":16788,"_22829":45478,"_2311":45711},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_2783":2045,"_24069":1951,"_16893":45713,"_5":16788,"_22829":45478,"_2311":45714},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_2783":2046,"_24069":1951,"_16893":45716,"_5":16788,"_22829":45478,"_2311":45717},[],"**Message**: content to sign.",{"_2783":2047,"_24069":1951,"_16893":45719,"_5":16788,"_22829":45478,"_2311":45720},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_2783":2048,"_24069":1951,"_16893":45722,"_5":16788,"_22829":45482,"_2311":45723},[],"This tab checks whether a signature corresponds to the associated public key.",{"_2783":2049,"_24069":1951,"_16893":45725,"_5":16788,"_22829":45482,"_2311":45705},[],{"_2783":2050,"_24069":1951,"_16893":45727,"_5":16788,"_22829":45482,"_2311":45728},[],"**Algorithm**: must match the algorithm used for the signature.",{"_2783":2051,"_24069":1951,"_16893":45730,"_5":16788,"_22829":45482,"_2311":45731},[],"**Message Type**: `Raw` or `Digest`.",{"_2783":2052,"_24069":1951,"_16893":45733,"_5":16788,"_22829":45482,"_2311":45734},[],"**Payload Encoding**: encoding of the message.",{"_2783":2053,"_24069":1951,"_16893":45736,"_5":16788,"_22829":45482,"_2311":45737},[],"**Message**: original message or hash.",{"_2783":2054,"_24069":1951,"_16893":45739,"_5":16788,"_22829":45482,"_2311":45740},[],"**Signature**: signature to check.",{"_2783":2055,"_24069":1951,"_16893":45742,"_5":16788,"_22829":45482,"_2311":45743},[],"**Result**: indicator of the validation result.",{"_2783":2056,"_24069":1951,"_16893":45745,"_5":16788,"_22829":45486,"_2311":45746},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_2783":2057,"_24069":1951,"_16893":45748,"_5":16788,"_22829":45486,"_2311":45749},[],"This flow is useful for:",{"_2783":2058,"_24069":1951,"_16893":45751,"_5":16788,"_22829":45486,"_2311":45752},[],"Requesting certificates from an external CA.",{"_2783":2059,"_24069":1951,"_16893":45754,"_5":16788,"_22829":45486,"_2311":45755},[],"Renewing an identity while keeping the same key.",{"_2783":2060,"_24069":1951,"_16893":45757,"_5":16788,"_22829":45486,"_2311":45758},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_2783":2061,"_24069":1951,"_16893":45760,"_5":16788,"_22829":45486,"_2311":45761},[],"**Common Name (CN)**: main name of the identity.",{"_2783":2062,"_24069":1951,"_16893":45763,"_5":16788,"_22829":45486,"_2311":45764},[],"**Organization (O)**: organization or company.",{"_2783":2063,"_24069":1951,"_16893":45766,"_5":16788,"_22829":45486,"_2311":45767},[],"**Organizational Unit (OU)**: department or unit.",{"_2783":2064,"_24069":1951,"_16893":45769,"_5":16788,"_22829":45486,"_2311":45770},[],"**Country (C)**: two-letter country code.",{"_2783":2065,"_24069":1951,"_16893":45772,"_5":16788,"_22829":45486,"_2311":45773},[],"**State / Province (ST)**: state or province.",{"_2783":2066,"_24069":1951,"_16893":45775,"_5":16788,"_22829":45486,"_2311":45776},[],"**Locality (L)**: city or locality.",{"_2783":2067,"_24069":1951,"_16893":45778,"_5":16788,"_22829":45486,"_2311":45779},[],"**Email Address**: contact email.",{"_2783":2068,"_24069":1951,"_16893":45781,"_5":16788,"_22829":45486,"_2311":45782},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_2783":2069,"_24069":1951,"_16893":45784,"_5":16788,"_22829":45486,"_2311":45785},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_2783":2070,"_24069":1951,"_16893":45787,"_5":16788,"_22829":45490,"_2311":45788},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_2783":2071,"_24069":1951,"_16893":45790,"_5":16788,"_22829":45490,"_2311":45791},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_2783":2072,"_24069":1951,"_16893":45793,"_5":16788,"_22829":45494,"_2311":45794},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_2783":2073,"_24069":2073,"_5":11891,"_2311":45796,"_24384":45797,"_16893":45798,"_22829":2073},"Online validation with OCSP",[39305,40649,44108,44725],[],{"_2783":2074,"_24069":2073,"_16893":45800,"_5":16788,"_22829":2073,"_2311":45801},[],"Query signed status and verify the responder’s response.",{"_2783":2075,"_24069":2073,"_5":24381,"_16893":45803,"_22829":45804,"_2311":45805},[],"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_2783":2076,"_24069":2073,"_5":24381,"_16893":45807,"_22829":45808,"_2311":45809},[],"/docs/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_2783":2077,"_24069":2073,"_5":24381,"_16893":45811,"_22829":45812,"_2311":45813},[],"/docs/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_2783":2078,"_24069":2073,"_5":24381,"_16893":45815,"_22829":45816,"_2311":45817},[],"/docs/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_2783":2079,"_24069":2073,"_5":24381,"_16893":45819,"_22829":45820,"_2311":45821},[],"/docs/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_2783":2080,"_24069":2073,"_5":24381,"_16893":45823,"_22829":45824,"_2311":45271},[],"/docs/platform/pki/ocsp#references",{"_2783":2081,"_24069":2073,"_16893":45826,"_5":16788,"_22829":2073,"_2311":45827},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_2783":2082,"_24069":2073,"_16893":45829,"_5":16788,"_22829":45804,"_2311":45830},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_2783":2083,"_24069":2073,"_16893":45832,"_5":16788,"_22829":45804,"_2311":45833},[],"Record status",{"_2783":2084,"_24069":2073,"_16893":45835,"_5":16788,"_22829":45804,"_2311":45836},[],"Signed response",{"_2783":2085,"_24069":2073,"_16893":45838,"_5":16788,"_22829":45804,"_2311":43286},[],{"_2783":2086,"_24069":2073,"_16893":45840,"_5":16788,"_22829":45804,"_2311":45841},[],"`Good`.",{"_2783":2087,"_24069":2073,"_16893":45843,"_5":16788,"_22829":45804,"_2311":43303},[],{"_2783":2088,"_24069":2073,"_16893":45845,"_5":16788,"_22829":45804,"_2311":45846},[],"`Revoked`, with revocation reason and timestamp.",{"_2783":2089,"_24069":2073,"_16893":45848,"_5":16788,"_22829":45804,"_2311":45849},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_2783":2090,"_24069":2073,"_16893":45851,"_5":16788,"_22829":45804,"_2311":45852},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_2783":2091,"_24069":2073,"_16893":45854,"_5":16788,"_22829":45804,"_2311":45855},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_2783":2092,"_24069":2073,"_16893":45857,"_5":16788,"_22829":45804,"_2311":45858},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_2783":2093,"_24069":2073,"_16893":45860,"_5":16788,"_22829":45804,"_2311":45861},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_2783":2094,"_24069":2073,"_16893":45863,"_5":16788,"_22829":45808,"_2311":45864},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_2783":2095,"_24069":2073,"_16893":45866,"_5":16788,"_22829":45808,"_2311":45867},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_2783":2096,"_24069":2073,"_16893":45869,"_5":16788,"_22829":45812,"_2311":45870},[],"The service accepts:",{"_2783":2097,"_24069":2073,"_16893":45872,"_5":16788,"_22829":45812,"_2311":42181},[],{"_2783":2098,"_24069":2073,"_16893":45874,"_5":16788,"_22829":45812,"_2311":45875},[],"VA service path",{"_2783":2099,"_24069":2073,"_16893":45877,"_5":16788,"_22829":45812,"_2311":45878},[],"Format",{"_2783":2100,"_24069":2073,"_16893":45880,"_5":16788,"_22829":45812,"_2311":45881},[],"`POST`",{"_2783":2101,"_24069":2073,"_16893":45883,"_5":16788,"_22829":45812,"_2311":45884},[],"`/ocsp`",{"_2783":2102,"_24069":2073,"_16893":45886,"_5":16788,"_22829":45812,"_2311":45887},[],"DER request, `Content-Type: application/ocsp-request`.",{"_2783":2103,"_24069":2073,"_16893":45889,"_5":16788,"_22829":45812,"_2311":45370},[],{"_2783":2104,"_24069":2073,"_16893":45891,"_5":16788,"_22829":45812,"_2311":45892},[],"`/ocsp/{ocsp_request}`",{"_2783":2105,"_24069":2073,"_16893":45894,"_5":16788,"_22829":45812,"_2311":45895},[],"DER request encoded using padded URL Base64.",{"_2783":2106,"_24069":2073,"_16893":45897,"_5":16788,"_22829":45812,"_2311":45898},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_2783":2107,"_24069":2073,"_16893":45900,"_5":16788,"_22829":45816,"_2311":45901},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_2783":2108,"_24069":2073,"_16893":45903,"_5":16788,"_22829":45816,"_2311":45904},[],"Generate the request:",{"_2783":2109,"_24069":2073,"_16893":45906,"_5":16788,"_22829":45816,"_2311":45907},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_2783":2110,"_24069":2073,"_16893":45909,"_5":16788,"_22829":45816,"_2311":45910},[],"Replace the example URL with the inspected endpoint:",{"_2783":2111,"_24069":2073,"_16893":45912,"_5":16788,"_22829":45816,"_2311":45913},[],"Verify the returned DER:",{"_2783":2112,"_24069":2073,"_16893":45915,"_5":16788,"_22829":45816,"_2311":45916},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_2783":2113,"_24069":2073,"_16893":45918,"_5":16788,"_22829":45820,"_2311":45919},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_2783":2114,"_24069":2073,"_16893":45921,"_5":16788,"_22829":45820,"_2311":45922},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_2783":2115,"_24069":2073,"_16893":45924,"_5":16788,"_22829":45824,"_2311":45925},[],"RFC 6960: OCSP.",{"_2783":2116,"_24069":2073,"_16893":45927,"_5":16788,"_22829":45824,"_2311":45928},[],"OpenSSL: openssl-ocsp.",{"_2783":2117,"_24069":2073,"_16893":45930,"_5":16788,"_22829":45824,"_2311":45931},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_2783":2118,"_24069":2073,"_16893":45933,"_5":16788,"_22829":45824,"_2311":45408},[],{"_2783":2119,"_24069":2119,"_5":11891,"_2311":44108,"_24384":45935,"_16893":45936,"_22829":2119},[39305,40649,44108],[],{"_2783":2120,"_24069":2119,"_16893":45938,"_5":16788,"_22829":2119,"_2311":45939},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_2783":2121,"_24069":2119,"_5":24381,"_16893":45941,"_22829":45942,"_2311":43418},[],"/docs/platform/pki/overview#start-here",{"_2783":2122,"_24069":2119,"_5":24381,"_16893":45944,"_22829":45945,"_2311":45946},[],"/docs/platform/pki/overview#what-you-need","What you need",{"_2783":2123,"_24069":2119,"_5":24381,"_16893":45948,"_22829":45949,"_2311":43952},[],"/docs/platform/pki/overview#core-capabilities",{"_2783":2124,"_24069":2119,"_5":24381,"_16893":45951,"_22829":45952,"_2311":43956},[],"/docs/platform/pki/overview#build-your-trust-hierarchy",{"_2783":2125,"_24069":2119,"_5":24381,"_16893":45954,"_22829":45955,"_2311":43960},[],"/docs/platform/pki/overview#protect-cryptographic-keys",{"_2783":2126,"_24069":2119,"_5":24381,"_16893":45957,"_22829":45958,"_2311":43964},[],"/docs/platform/pki/overview#issue-and-control-certificates",{"_2783":2127,"_24069":2119,"_5":24381,"_16893":45960,"_22829":45961,"_2311":43972},[],"/docs/platform/pki/overview#publish-validation-status",{"_2783":2128,"_24069":2119,"_5":24381,"_16893":45963,"_22829":45964,"_2311":45965},[],"/docs/platform/pki/overview#how-to-check-the-result","How to check the result",{"_2783":2129,"_24069":2119,"_5":24381,"_16893":45967,"_22829":45968,"_2311":44892},[],"/docs/platform/pki/overview#continue",{"_2783":2130,"_24069":2119,"_16893":45970,"_5":16788,"_22829":2119,"_2311":45971},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_2783":2131,"_24069":2119,"_16893":45973,"_5":16788,"_22829":45942,"_2311":45974},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_2783":2132,"_24069":2119,"_16893":45976,"_5":16788,"_22829":45942,"_2311":45977},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_2783":2133,"_24069":2119,"_16893":45979,"_5":16788,"_22829":45945,"_2311":45980},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_2783":2134,"_24069":2119,"_16893":45982,"_5":16788,"_22829":45945,"_2311":45983},[],"An available cryptographic engine to keep the authority's key.",{"_2783":2135,"_24069":2119,"_16893":45985,"_5":16788,"_22829":45945,"_2311":45986},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_2783":2136,"_24069":2119,"_16893":45988,"_5":16788,"_22829":45945,"_2311":45989},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_2783":2137,"_24069":2119,"_16893":45991,"_5":16788,"_22829":45945,"_2311":45992},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_2783":2138,"_24069":2119,"_16893":45994,"_5":16788,"_22829":45952,"_2311":45995},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_2783":2139,"_24069":2119,"_16893":45997,"_5":16788,"_22829":45955,"_2311":45998},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_2783":2140,"_24069":2119,"_16893":46000,"_5":16788,"_22829":45958,"_2311":46001},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_2783":2141,"_24069":2119,"_16893":46003,"_5":16788,"_22829":45961,"_2311":46004},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_2783":2142,"_24069":2119,"_16893":46006,"_5":16788,"_22829":45964,"_2311":46007},[],"An active certificate in the console is one part of the check. Also verify that:",{"_2783":2143,"_24069":2119,"_16893":46009,"_5":16788,"_22829":45964,"_2311":46010},[],"its subject and extensions identify the expected client;",{"_2783":2144,"_24069":2119,"_16893":46012,"_5":16788,"_22829":45964,"_2311":46013},[],"its public key matches the client's private key;",{"_2783":2145,"_24069":2119,"_16893":46015,"_5":16788,"_22829":45964,"_2311":46016},[],"its chain reaches a root trusted by the consumer;",{"_2783":2146,"_24069":2119,"_16893":46018,"_5":16788,"_22829":45964,"_2311":46019},[],"its dates and usages allow the operation;",{"_2783":2147,"_24069":2119,"_16893":46021,"_5":16788,"_22829":45964,"_2311":46022},[],"the consumer applies revocation checks and authorization.",{"_2783":2148,"_24069":2119,"_16893":46024,"_5":16788,"_22829":45964,"_2311":46025},[],"The issuance path includes the first independent checks.",{"_2783":2149,"_24069":2119,"_16893":46027,"_5":16788,"_22829":45968,"_2311":46028},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2783":2150,"_24069":2119,"_16893":46030,"_5":16788,"_22829":45968,"_2311":46031},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2783":2151,"_24069":2119,"_16893":46033,"_5":16788,"_22829":45968,"_2311":46034},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2783":2152,"_24069":2152,"_5":11891,"_2311":46036,"_24384":46037,"_16893":46038,"_22829":2152},"Create your first CA",[39305,40649,44108,43543],[],{"_2783":2153,"_24069":2152,"_16893":46040,"_5":16788,"_22829":2152,"_2311":46041},[],"Create an evaluation root and check its certificate before issuing.",{"_2783":2154,"_24069":2152,"_5":24381,"_16893":46043,"_22829":46044,"_2311":39315},[],"/docs/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_2783":2155,"_24069":2152,"_5":24381,"_16893":46046,"_22829":46047,"_2311":46048},[],"/docs/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard","Open the creation wizard",{"_2783":2156,"_24069":2152,"_5":24381,"_16893":46050,"_22829":46051,"_2311":46052},[],"/docs/platform/pki/quickstarts/create-certificate-authority#select-the-key","Select the key",{"_2783":2157,"_24069":2152,"_5":24381,"_16893":46054,"_22829":46055,"_2311":46056},[],"/docs/platform/pki/quickstarts/create-certificate-authority#define-the-authority","Define the authority",{"_2783":2158,"_24069":2152,"_5":24381,"_16893":46058,"_22829":46059,"_2311":46060},[],"/docs/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca","Review and create the CA",{"_2783":2159,"_24069":2152,"_5":24381,"_16893":46062,"_22829":46063,"_2311":46064},[],"/docs/platform/pki/quickstarts/create-certificate-authority#verify-the-result","Verify the result",{"_2783":2160,"_24069":2152,"_5":24381,"_16893":46066,"_22829":46067,"_2311":46068},[],"/docs/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_2783":2161,"_24069":2152,"_5":24381,"_16893":46070,"_22829":46071,"_2311":43801},[],"/docs/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_2783":2162,"_24069":2152,"_5":24381,"_16893":46073,"_22829":46074,"_2311":39339},[],"/docs/platform/pki/quickstarts/create-certificate-authority#next-step",{"_2783":2163,"_24069":2152,"_16893":46076,"_5":16788,"_22829":2152,"_2311":46077},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_2783":2164,"_24069":2152,"_16893":46079,"_5":16788,"_22829":46044,"_2311":46080},[],"Console access and permission to create keys and authorities.",{"_2783":2165,"_24069":2152,"_16893":46082,"_5":16788,"_22829":46044,"_2311":46083},[],"An available cryptographic engine that supports the chosen algorithm.",{"_2783":2166,"_24069":2152,"_16893":46085,"_5":16788,"_22829":46044,"_2311":46086},[],"OpenSSL 3.x to check the downloaded certificate.",{"_2783":2167,"_24069":2152,"_16893":46088,"_5":16788,"_22829":46044,"_2311":46089},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_2783":2168,"_24069":2152,"_16893":46091,"_5":16788,"_22829":46047,"_2311":46092},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_2783":2169,"_24069":2152,"_16893":46094,"_5":16788,"_22829":46047,"_2311":46095},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_2783":2170,"_24069":2152,"_16893":46097,"_5":16788,"_22829":46051,"_2311":46098},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_2783":2171,"_24069":2152,"_16893":46100,"_5":16788,"_22829":46051,"_2311":46101},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_2783":2172,"_24069":2152,"_16893":46103,"_5":16788,"_22829":46055,"_2311":46104},[],"Select **Root CA** and complete:",{"_2783":2173,"_24069":2152,"_16893":46106,"_5":16788,"_22829":46055,"_2311":46107},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_2783":2174,"_24069":2152,"_16893":46109,"_5":16788,"_22829":46055,"_2311":46110},[],"**Subject**: organization and country details for your evaluation.",{"_2783":2175,"_24069":2152,"_16893":46112,"_5":16788,"_22829":46055,"_2311":46113},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_2783":2176,"_24069":2152,"_16893":46115,"_5":16788,"_22829":46055,"_2311":46116},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_2783":2177,"_24069":2152,"_16893":46118,"_5":16788,"_22829":46055,"_2311":46119},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_2783":2178,"_24069":2152,"_16893":46121,"_5":16788,"_22829":46059,"_2311":46122},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_2783":2179,"_24069":2152,"_16893":46124,"_5":16788,"_22829":46063,"_2311":46125},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_2783":2180,"_24069":2152,"_16893":46127,"_5":16788,"_22829":46063,"_2311":46128},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_2783":2181,"_24069":2152,"_16893":46130,"_5":16788,"_22829":46067,"_2311":46131},[],"Run from the directory where you saved `ca.pem`:",{"_2783":2182,"_24069":2152,"_16893":46133,"_5":16788,"_22829":46067,"_2311":46134},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_2783":2183,"_24069":2152,"_16893":46136,"_5":16788,"_22829":46067,"_2311":46137},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_2783":2184,"_24069":2152,"_16893":46139,"_5":16788,"_22829":46071,"_2311":46140},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_2783":2185,"_24069":2152,"_16893":46142,"_5":16788,"_22829":46071,"_2311":46143},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_2783":2186,"_24069":2152,"_16893":46145,"_5":16788,"_22829":46071,"_2311":46146},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_2783":2187,"_24069":2152,"_16893":46148,"_5":16788,"_22829":46071,"_2311":46149},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_2783":2188,"_24069":2152,"_16893":46151,"_5":16788,"_22829":46074,"_2311":46152},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_2783":2189,"_24069":2189,"_5":11891,"_2311":46154,"_24384":46155,"_16893":46156,"_22829":2189},"Issue and verify a certificate",[39305,40649,44108,43543],[],{"_2783":2190,"_24069":2189,"_16893":46158,"_5":16788,"_22829":2189,"_2311":46159},[],"Issue a client certificate and check content, chain and key correspondence.",{"_2783":2191,"_24069":2189,"_5":24381,"_16893":46161,"_22829":46162,"_2311":39315},[],"/docs/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_2783":2192,"_24069":2189,"_5":24381,"_16893":46164,"_22829":46165,"_2311":46166},[],"/docs/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_2783":2193,"_24069":2189,"_5":24381,"_16893":46168,"_22829":46169,"_2311":46170},[],"/docs/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_2783":2194,"_24069":2189,"_5":24381,"_16893":46172,"_22829":46173,"_2311":46174},[],"/docs/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_2783":2195,"_24069":2189,"_5":24381,"_16893":46176,"_22829":46177,"_2311":46178},[],"/docs/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_2783":2196,"_24069":2189,"_5":24381,"_16893":46180,"_22829":46181,"_2311":46182},[],"/docs/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_2783":2197,"_24069":2189,"_5":24381,"_16893":46184,"_22829":46185,"_2311":46064},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-result",{"_2783":2198,"_24069":2189,"_5":24381,"_16893":46187,"_22829":46188,"_2311":46189},[],"/docs/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_2783":2199,"_24069":2189,"_5":24381,"_16893":46191,"_22829":46192,"_2311":46193},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_2783":2200,"_24069":2189,"_5":24381,"_16893":46195,"_22829":46196,"_2311":46197},[],"/docs/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_2783":2201,"_24069":2189,"_5":24381,"_16893":46199,"_22829":46200,"_2311":43801},[],"/docs/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_2783":2202,"_24069":2189,"_5":24381,"_16893":46202,"_22829":46203,"_2311":39339},[],"/docs/platform/pki/quickstarts/issue-certificate#next-step",{"_2783":2203,"_24069":2189,"_16893":46205,"_5":16788,"_22829":2189,"_2311":46206},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_2783":2204,"_24069":2189,"_16893":46208,"_5":16788,"_22829":46162,"_2311":46209},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_2783":2205,"_24069":2189,"_16893":46211,"_5":16788,"_22829":46162,"_2311":46212},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_2783":2206,"_24069":2189,"_16893":46214,"_5":16788,"_22829":46162,"_2311":46215},[],"OpenSSL 3.x and a working directory with restricted access.",{"_2783":2207,"_24069":2189,"_16893":46217,"_5":16788,"_22829":46162,"_2311":46218},[],"A client identifier: here we use `device-001`.",{"_2783":2208,"_24069":2189,"_16893":46220,"_5":16788,"_22829":46162,"_2311":46221},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_2783":2209,"_24069":2189,"_16893":46223,"_5":16788,"_22829":46165,"_2311":46224},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_2783":2210,"_24069":2189,"_16893":46226,"_5":16788,"_22829":46169,"_2311":46227},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_2783":2211,"_24069":2189,"_16893":46229,"_5":16788,"_22829":46169,"_2311":46230},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_2783":2212,"_24069":2189,"_16893":46232,"_5":16788,"_22829":46173,"_2311":46233},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_2783":2213,"_24069":2189,"_16893":46235,"_5":16788,"_22829":46173,"_2311":46236},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_2783":2214,"_24069":2189,"_16893":46238,"_5":16788,"_22829":46177,"_2311":46239},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_2783":2215,"_24069":2189,"_16893":46241,"_5":16788,"_22829":46177,"_2311":46242},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_2783":2216,"_24069":2189,"_16893":46244,"_5":16788,"_22829":46181,"_2311":46245},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_2783":2217,"_24069":2189,"_16893":46247,"_5":16788,"_22829":46185,"_2311":46248},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_2783":2218,"_24069":2189,"_16893":46250,"_5":16788,"_22829":46188,"_2311":46251},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_2783":2219,"_24069":2189,"_16893":46253,"_5":16788,"_22829":46192,"_2311":46254},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_2783":2220,"_24069":2189,"_16893":46256,"_5":16788,"_22829":46192,"_2311":46257},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_2783":2221,"_24069":2189,"_16893":46259,"_5":16788,"_22829":46192,"_2311":46260},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_2783":2222,"_24069":2189,"_16893":46262,"_5":16788,"_22829":46196,"_2311":46263},[],"In Bash, compare the two public-key digests:",{"_2783":2223,"_24069":2189,"_16893":46265,"_5":16788,"_22829":46196,"_2311":46266},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_2783":2224,"_24069":2189,"_16893":46268,"_5":16788,"_22829":46196,"_2311":46269},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_2783":2225,"_24069":2189,"_16893":46271,"_5":16788,"_22829":46200,"_2311":43885},[],{"_2783":2226,"_24069":2189,"_16893":46273,"_5":16788,"_22829":46200,"_2311":46274},[],"What to review",{"_2783":2227,"_24069":2189,"_16893":46276,"_5":16788,"_22829":46200,"_2311":46277},[],"The CA rejects issuance",{"_2783":2228,"_24069":2189,"_16893":46279,"_5":16788,"_22829":46200,"_2311":46280},[],"Permissions, CA state and key, algorithm and profile.",{"_2783":2229,"_24069":2189,"_16893":46282,"_5":16788,"_22829":46200,"_2311":46283},[],"Different subject or usages",{"_2783":2230,"_24069":2189,"_16893":46285,"_5":16788,"_22829":46200,"_2311":46286},[],"Applied profile and requested values.",{"_2783":2231,"_24069":2189,"_16893":46288,"_5":16788,"_22829":46200,"_2311":46289},[],"Issuer cannot be found",{"_2783":2232,"_24069":2189,"_16893":46291,"_5":16788,"_22829":46200,"_2311":46292},[],"Downloaded CA and required intermediate chain.",{"_2783":2233,"_24069":2189,"_16893":46294,"_5":16788,"_22829":46200,"_2311":46295},[],"Validity fails",{"_2783":2234,"_24069":2189,"_16893":46297,"_5":16788,"_22829":46200,"_2311":46298},[],"Certificate and CA dates, and the computer's clock.",{"_2783":2235,"_24069":2189,"_16893":46300,"_5":16788,"_22829":46200,"_2311":46301},[],"Public-key digests differ",{"_2783":2236,"_24069":2189,"_16893":46303,"_5":16788,"_22829":46200,"_2311":46304},[],"Certificate and key files from the same issuance.",{"_2783":2237,"_24069":2189,"_16893":46306,"_5":16788,"_22829":46200,"_2311":46307},[],"See PKI diagnostics to narrow an issuance failure.",{"_2783":2238,"_24069":2189,"_16893":46309,"_5":16788,"_22829":46203,"_2311":46310},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_2783":2239,"_24069":2189,"_16893":46312,"_5":16788,"_22829":46203,"_2311":46313},[],"Manage certificates for inspection, status and revocation.",{"_2783":2240,"_24069":2189,"_16893":46315,"_5":16788,"_22829":46203,"_2311":46316},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_2783":2241,"_24069":2189,"_16893":46318,"_5":16788,"_22829":46203,"_2311":46319},[],"Prepare EST for the device to request its next identities.",{"_2783":2242,"_24069":2189,"_16893":46321,"_5":16788,"_22829":46203,"_2311":46322},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_2783":2243,"_24069":2243,"_5":11891,"_2311":46324,"_24384":46325,"_16893":46326,"_22829":2243},"PKI getting started",[39305,40649,44108,43543],[],{"_2783":2244,"_24069":2243,"_16893":46328,"_5":16788,"_22829":2243,"_2311":46329},[],"Create a CA, issue a client certificate and check its chain and key.",{"_2783":2245,"_24069":2243,"_5":24381,"_16893":46331,"_22829":46332,"_2311":39315},[],"/docs/platform/pki/quickstarts/overview#before-you-begin",{"_2783":2246,"_24069":2243,"_5":24381,"_16893":46334,"_22829":46335,"_2311":46336},[],"/docs/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_2783":2247,"_24069":2243,"_5":24381,"_16893":46338,"_22829":46339,"_2311":43735},[],"/docs/platform/pki/quickstarts/overview#expected-result",{"_2783":2248,"_24069":2243,"_5":24381,"_16893":46341,"_22829":46342,"_2311":46343},[],"/docs/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_2783":2249,"_24069":2243,"_16893":46345,"_5":16788,"_22829":2243,"_2311":46346},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_2783":2250,"_24069":2243,"_16893":46348,"_5":16788,"_22829":46332,"_2311":46349},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_2783":2251,"_24069":2243,"_16893":46351,"_5":16788,"_22829":46332,"_2311":46352},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_2783":2252,"_24069":2243,"_16893":46354,"_5":16788,"_22829":46332,"_2311":46355},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_2783":2253,"_24069":2243,"_16893":46357,"_5":16788,"_22829":46332,"_2311":46358},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_2783":2254,"_24069":2243,"_16893":46360,"_5":16788,"_22829":46332,"_2311":46361},[],"A working directory with restricted access for the downloaded key.",{"_2783":2255,"_24069":2243,"_16893":46363,"_5":16788,"_22829":46335,"_2311":46364},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2783":2256,"_24069":2243,"_16893":46366,"_5":16788,"_22829":46335,"_2311":46367},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2783":2257,"_24069":2243,"_16893":46369,"_5":16788,"_22829":46335,"_2311":46370},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_2783":2258,"_24069":2243,"_16893":46372,"_5":16788,"_22829":46335,"_2311":46373},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_2783":2259,"_24069":2243,"_16893":46375,"_5":16788,"_22829":46339,"_2311":46376},[],"File or resource",{"_2783":2260,"_24069":2243,"_16893":46378,"_5":16788,"_22829":46339,"_2311":43732},[],{"_2783":2261,"_24069":2243,"_16893":46380,"_5":16788,"_22829":46339,"_2311":46381},[],"Active root CA and `ca.pem`",{"_2783":2262,"_24069":2243,"_16893":46383,"_5":16788,"_22829":46339,"_2311":46384},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_2783":2263,"_24069":2243,"_16893":46386,"_5":16788,"_22829":46339,"_2311":46387},[],"End-entity certificate and `device.crt`",{"_2783":2264,"_24069":2243,"_16893":46389,"_5":16788,"_22829":46339,"_2311":46390},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_2783":2265,"_24069":2243,"_16893":46392,"_5":16788,"_22829":46339,"_2311":46393},[],"Private key `device.key`",{"_2783":2266,"_24069":2243,"_16893":46395,"_5":16788,"_22829":46339,"_2311":46396},[],"Its public key matches the one included in `device.crt`.",{"_2783":2267,"_24069":2243,"_16893":46398,"_5":16788,"_22829":46339,"_2311":46399},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_2783":2268,"_24069":2243,"_16893":46401,"_5":16788,"_22829":46342,"_2311":46402},[],"To operate certificates, continue with Certificates and Validation.",{"_2783":2269,"_24069":2243,"_16893":46404,"_5":16788,"_22829":46342,"_2311":46405},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_2783":2270,"_24069":2243,"_16893":46407,"_5":16788,"_22829":46342,"_2311":46408},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_2783":2271,"_24069":2271,"_5":11891,"_2311":46410,"_24384":46411,"_16893":46412,"_22829":2271},"PKI troubleshooting",[39305,40649,44108,42929],[],{"_2783":2272,"_24069":2271,"_16893":46414,"_5":16788,"_22829":2271,"_2311":46415},[],"Diagnose certificate issuance, OCSP and CRL.",{"_2783":2273,"_24069":2271,"_5":24381,"_16893":46417,"_22829":46418,"_2311":46419},[],"/docs/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_2783":2274,"_24069":2271,"_5":24381,"_16893":46421,"_22829":46422,"_2311":46423},[],"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_2783":2275,"_24069":2271,"_5":24381,"_16893":46425,"_22829":46426,"_2311":46427},[],"/docs/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_2783":2276,"_24069":2271,"_16893":46429,"_5":16788,"_22829":2271,"_2311":46430},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_2783":2277,"_24069":2271,"_16893":46432,"_5":16788,"_22829":2271,"_2311":46433},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_2783":2278,"_24069":2271,"_16893":46435,"_5":16788,"_22829":46418,"_2311":43732},[],{"_2783":2279,"_24069":2271,"_16893":46437,"_5":16788,"_22829":46418,"_2311":46438},[],"What to inspect",{"_2783":2280,"_24069":2271,"_16893":46440,"_5":16788,"_22829":46418,"_2311":39339},[],{"_2783":2281,"_24069":2271,"_16893":46442,"_5":16788,"_22829":46418,"_2311":46443},[],"CA",{"_2783":2282,"_24069":2271,"_16893":46445,"_5":16788,"_22829":46418,"_2311":46446},[],"Exists, is active and has usable dates.",{"_2783":2283,"_24069":2271,"_16893":46448,"_5":16788,"_22829":46418,"_2311":46449},[],"Authorities.",{"_2783":2284,"_24069":2271,"_16893":46451,"_5":16788,"_22829":46418,"_2311":46452},[],"Key",{"_2783":2285,"_24069":2271,"_16893":46454,"_5":16788,"_22829":46418,"_2311":46455},[],"The record has a usable private key and the engine can sign.",{"_2783":2286,"_24069":2271,"_16893":46457,"_5":16788,"_22829":46418,"_2311":46458},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_2783":2287,"_24069":2271,"_16893":46460,"_5":16788,"_22829":46418,"_2311":46461},[],"CSR",{"_2783":2288,"_24069":2271,"_16893":46463,"_5":16788,"_22829":46418,"_2311":46464},[],"Correct PEM and verifiable signature.",{"_2783":2289,"_24069":2271,"_16893":46466,"_5":16788,"_22829":46418,"_2311":46467},[],"`openssl req -in request.csr -noout -verify -text`.",{"_2783":2290,"_24069":2271,"_16893":46469,"_5":16788,"_22829":46418,"_2311":46470},[],"Profile",{"_2783":2291,"_24069":2271,"_16893":46472,"_5":16788,"_22829":46418,"_2311":46473},[],"Selected source, existing ID, allowed algorithm and size.",{"_2783":2292,"_24069":2271,"_16893":46475,"_5":16788,"_22829":46418,"_2311":46476},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_2783":2293,"_24069":2271,"_16893":46478,"_5":16788,"_22829":46418,"_2311":43885},[],{"_2783":2294,"_24069":2271,"_16893":46480,"_5":16788,"_22829":46418,"_2311":46481},[],"Appropriate subject, SAN, usages and dates.",{"_2783":2295,"_24069":2271,"_16893":46483,"_5":16788,"_22829":46418,"_2311":46484},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_2783":2296,"_24069":2271,"_16893":46486,"_5":16788,"_22829":46418,"_2311":46487},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_2783":2297,"_24069":2271,"_16893":46489,"_5":16788,"_22829":46418,"_2311":46490},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_2783":2298,"_24069":2271,"_16893":46492,"_5":16788,"_22829":46422,"_2311":46493},[],"Check each boundary independently:",{"_2783":2299,"_24069":2271,"_16893":46495,"_5":16788,"_22829":46422,"_2311":46496},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_2783":2300,"_24069":2271,"_16893":46498,"_5":16788,"_22829":46422,"_2311":46499},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_2783":2301,"_24069":2271,"_16893":46501,"_5":16788,"_22829":46422,"_2311":46502},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_2783":2302,"_24069":2271,"_16893":46504,"_5":16788,"_22829":46422,"_2311":46505},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_2783":2303,"_24069":2271,"_16893":46507,"_5":16788,"_22829":46422,"_2311":46508},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_2783":2304,"_24069":2271,"_16893":46510,"_5":16788,"_22829":46422,"_2311":46511},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_2783":2305,"_24069":2271,"_16893":46513,"_5":16788,"_22829":46426,"_2311":46514},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_2783":2306,"_24069":2271,"_16893":46516,"_5":16788,"_22829":46426,"_2311":46517},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.","count","sorting",{"_46521":46522,"_46523":46524,"_46525":46526,"_46527":46528,"_14693":2333,"_55710":2333},"language","english","sortableProperties",[2311,24069,5,22829],"sortablePropertiesWithTypes",{"_2311":20125,"_24069":20125,"_5":20125,"_22829":20125},"sorts",{"_2311":46529,"_24069":48825,"_5":51120,"_22829":53415},{"_3710":46530,"_46531":46532,"_5":20125},{"_11654":6924,"_11974":5548,"_11981":5503,"_23326":5640,"_22912":2754,"_16026":2546,"_11675":3088,"_11682":2651,"_23288":4377,"_23627":3884,"_23637":2683,"_23301":4068,"_27793":5856,"_23648":16211,"_27798":23747,"_27801":3751,"_27804":3686,"_27807":18652,"_27810":2548,"_23949":2696,"_27815":2557,"_27817":18843,"_23985":6039,"_23939":5132,"_27821":2632,"_27824":5897,"_27826":6958,"_23666":19162,"_23944":11465,"_24003":5002,"_27831":4918,"_27833":3713,"_27835":3790,"_27837":2988,"_27839":8726,"_27841":3387,"_27843":2923,"_27845":4326,"_27847":2688,"_23339":18391,"_27850":8482,"_27852":2748,"_23333":4433,"_27855":4713,"_27857":21961,"_27859":5489,"_27862":6135,"_23369":2752,"_27866":19228,"_23279":15051,"_27869":6139,"_23306":4117,"_27872":9156,"_27874":2646,"_27877":5719,"_23980":5083,"_27880":4642,"_27882":5760,"_27885":2684,"_27887":13062,"_27889":7987,"_27891":8481,"_27893":6111,"_16029":6133,"_27896":20378,"_27898":6014,"_27900":5968,"_23660":7722,"_27903":11296,"_27905":4716,"_27907":4089,"_27909":5867,"_27911":14657,"_27913":3452,"_27915":3192,"_24055":2935,"_23687":3356,"_27919":4613,"_27921":4899,"_23317":2714,"_27924":3589,"_27926":6093,"_27928":3683,"_23998":2737,"_27931":10002,"_27933":13765,"_27935":14430,"_27937":7723,"_27939":2590,"_23415