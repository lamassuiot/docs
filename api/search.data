60,"_41667":129863,"_41669":129866,"_41671":129869,"_41673":129872,"_41675":129875,"_41677":129878,"_41679":129881,"_41681":129884,"_41683":129887,"_41685":129890,"_41687":129893,"_41689":129896,"_41692":129899,"_41694":129902,"_41696":129905,"_41698":129908,"_41700":129911,"_41702":129914,"_41704":129917,"_41706":129920,"_41708":129923,"_41710":129926,"_41712":129929,"_41714":129932,"_41716":129935,"_41718":129938,"_41720":129941,"_41722":129944,"_41724":129947,"_41726":129950,"_41728":129953,"_41730":129956,"_41732":129959,"_41734":129962,"_41736":129965,"_41738":129968,"_41740":129971,"_41742":129974,"_41744":129977,"_41746":129980,"_41748":129983,"_41750":129986,"_41752":129989,"_41754":129992,"_41757":129995,"_41759":129998,"_41761":130001},{"_3640":72930,"_31229":72930,"_5":15259,"_3090":120680,"_31567":120681,"_21648":120684,"_28426":72930},"Despliega desde AWS Marketplace",[51054,120682,120683],"Despliegue","Otros modelos",[],{"_3640":72931,"_31229":72930,"_21648":120686,"_5":14899,"_28426":72930,"_3090":120687},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3640":72932,"_31229":72930,"_5":31564,"_21648":120689,"_28426":120690,"_3090":120691},[],"/docs/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3640":72933,"_31229":72930,"_5":31564,"_21648":120693,"_28426":120694,"_3090":120695},[],"/docs/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3640":72934,"_31229":72930,"_5":31564,"_21648":120697,"_28426":120698,"_3090":120699},[],"/docs/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3640":72935,"_31229":72930,"_5":31564,"_21648":120701,"_28426":120702,"_3090":120703},[],"/docs/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3640":72936,"_31229":72930,"_5":31564,"_21648":120705,"_28426":120706,"_3090":120707},[],"/docs/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3640":72937,"_31229":72930,"_5":31564,"_21648":120709,"_28426":120710,"_3090":120711},[],"/docs/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3640":72938,"_31229":72930,"_5":31564,"_21648":120713,"_28426":120714,"_3090":120715},[],"/docs/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3640":72939,"_31229":72930,"_21648":120717,"_5":14899,"_28426":72930,"_3090":120718},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3640":72940,"_31229":72930,"_21648":120720,"_5":14899,"_28426":120690,"_3090":120721},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3640":72941,"_31229":72930,"_21648":120723,"_5":14899,"_28426":120690,"_3090":120724},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3640":72942,"_31229":72930,"_21648":120726,"_5":14899,"_28426":120690,"_3090":120727},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3640":72943,"_31229":72930,"_21648":120729,"_5":14899,"_28426":120694,"_3090":120730},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3640":72944,"_31229":72930,"_21648":120732,"_5":14899,"_28426":120694,"_3090":120733},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3640":72945,"_31229":72930,"_21648":120735,"_5":14899,"_28426":120694,"_3090":120736},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3640":72946,"_31229":72930,"_21648":120738,"_5":14899,"_28426":120698,"_3090":120739},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3640":72947,"_31229":72930,"_21648":120741,"_5":14899,"_28426":120702,"_3090":120742},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3640":72948,"_31229":72930,"_21648":120744,"_5":14899,"_28426":120706,"_3090":120745},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3640":72949,"_31229":72930,"_21648":120747,"_5":14899,"_28426":120710,"_3090":120748},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3640":72950,"_31229":72930,"_21648":120750,"_5":14899,"_28426":120714,"_3090":120751},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3640":72951,"_31229":72951,"_5":15259,"_3090":120753,"_31567":120754,"_21648":120755,"_28426":72951},"Despliega Lamassu",[51054,120682],[],{"_3640":72952,"_31229":72951,"_21648":120757,"_5":14899,"_28426":72951,"_3090":120758},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3640":72953,"_31229":72951,"_5":31564,"_21648":120760,"_28426":120761,"_3090":120762},[],"/docs/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3640":72954,"_31229":72951,"_5":31564,"_21648":120764,"_28426":120765,"_3090":120766},[],"/docs/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3640":72955,"_31229":72951,"_5":31564,"_21648":120768,"_28426":120769,"_3090":120770},[],"/docs/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3640":72956,"_31229":72951,"_21648":120772,"_5":14899,"_28426":72951,"_3090":120773},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3640":72957,"_31229":72951,"_21648":120775,"_5":14899,"_28426":120761,"_3090":120776},[],"Modelo",{"_3640":72958,"_31229":72951,"_21648":120778,"_5":14899,"_28426":120761,"_3090":120779},[],"Recomendado para",{"_3640":72959,"_31229":72951,"_21648":120781,"_5":14899,"_28426":120761,"_3090":120782},[],"Quién opera la infraestructura",{"_3640":72960,"_31229":72951,"_21648":120784,"_5":14899,"_28426":120761,"_3090":120785},[],"Punto de partida",{"_3640":72961,"_31229":72951,"_21648":120787,"_5":14899,"_28426":120761,"_3090":51161},[],{"_3640":72962,"_31229":72951,"_21648":120789,"_5":14899,"_28426":120761,"_3090":120790},[],"Producción, entornos regulados y despliegues personalizados",{"_3640":72963,"_31229":72951,"_21648":120792,"_5":14899,"_28426":120761,"_3090":120793},[],"Tu equipo",{"_3640":72964,"_31229":72951,"_21648":120795,"_5":14899,"_28426":120761,"_3090":120796},[],"Helm o Fastlane",{"_3640":72965,"_31229":72951,"_21648":120798,"_5":14899,"_28426":120761,"_3090":51173},[],{"_3640":72966,"_31229":72951,"_21648":120800,"_5":14899,"_28426":120761,"_3090":120801},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3640":72967,"_31229":72951,"_21648":120803,"_5":14899,"_28426":120761,"_3090":120793},[],{"_3640":72968,"_31229":72951,"_21648":120805,"_5":14899,"_28426":120761,"_3090":120806},[],"Imagen preconfigurada en EC2",{"_3640":72969,"_31229":72951,"_21648":120808,"_5":14899,"_28426":120761,"_3090":51184},[],{"_3640":72970,"_31229":72951,"_21648":120810,"_5":14899,"_28426":120761,"_3090":120811},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3640":72971,"_31229":72951,"_21648":120813,"_5":14899,"_28426":120761,"_3090":51190},[],{"_3640":72972,"_31229":72951,"_21648":120815,"_5":14899,"_28426":120761,"_3090":120816},[],"Suscripción gestionada",{"_3640":72973,"_31229":72951,"_21648":120818,"_5":14899,"_28426":120761,"_3090":120819},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3640":72974,"_31229":72951,"_21648":120821,"_5":14899,"_28426":120761,"_3090":120822},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3640":72975,"_31229":72951,"_21648":120824,"_5":14899,"_28426":120761,"_3090":120825},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3640":72976,"_31229":72951,"_21648":120827,"_5":14899,"_28426":120765,"_3090":120828},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3640":72977,"_31229":72951,"_21648":120830,"_5":14899,"_28426":120769,"_3090":120831},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3640":72978,"_31229":72978,"_5":15259,"_3090":120833,"_31567":120834,"_21648":120835,"_28426":72978},"Utiliza Lamassu como SaaS",[51054,120682,120683],[],{"_3640":72979,"_31229":72978,"_21648":120837,"_5":14899,"_28426":72978,"_3090":120838},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3640":72980,"_31229":72978,"_5":31564,"_21648":120840,"_28426":120841,"_3090":120842},[],"/docs/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3640":72981,"_31229":72978,"_5":31564,"_21648":120844,"_28426":120845,"_3090":120846},[],"/docs/es/deployment/saas#planes","Planes",{"_3640":72982,"_31229":72978,"_5":31564,"_21648":120848,"_28426":120849,"_3090":120850},[],"/docs/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3640":72983,"_31229":72978,"_21648":120852,"_5":14899,"_28426":72978,"_3090":120853},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3640":72984,"_31229":72978,"_21648":120855,"_5":14899,"_28426":120841,"_3090":120856},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3640":72985,"_31229":72978,"_21648":120858,"_5":14899,"_28426":120841,"_3090":120859},[],"Copias de seguridad automáticas.",{"_3640":72986,"_31229":72978,"_21648":120861,"_5":14899,"_28426":120841,"_3090":120862},[],"Actualizaciones de versión.",{"_3640":72987,"_31229":72978,"_21648":120864,"_5":14899,"_28426":120841,"_3090":120865},[],"Soporte técnico y SLA según el plan contratado.",{"_3640":72988,"_31229":72978,"_21648":120867,"_5":14899,"_28426":120845,"_3090":51245},[],{"_3640":72989,"_31229":72978,"_21648":120869,"_5":14899,"_28426":120845,"_3090":120870},[],"Dispositivos",{"_3640":72990,"_31229":72978,"_21648":120872,"_5":14899,"_28426":120845,"_3090":120873},[],"Soporte",{"_3640":72991,"_31229":72978,"_21648":120875,"_5":14899,"_28426":120845,"_3090":51254},[],{"_3640":72992,"_31229":72978,"_21648":120877,"_5":14899,"_28426":120845,"_3090":51257},[],{"_3640":72993,"_31229":72978,"_21648":120879,"_5":14899,"_28426":120845,"_3090":120880},[],"Hasta 1.000",{"_3640":72994,"_31229":72978,"_21648":120882,"_5":14899,"_28426":120845,"_3090":51263},[],{"_3640":72995,"_31229":72978,"_21648":120884,"_5":14899,"_28426":120845,"_3090":120885},[],"99,5 %",{"_3640":72996,"_31229":72978,"_21648":120887,"_5":14899,"_28426":120845,"_3090":51269},[],{"_3640":72997,"_31229":72978,"_21648":120889,"_5":14899,"_28426":120845,"_3090":120890},[],"Hasta 10.000",{"_3640":72998,"_31229":72978,"_21648":120892,"_5":14899,"_28426":120845,"_3090":120893},[],"Email y chat",{"_3640":72999,"_31229":72978,"_21648":120895,"_5":14899,"_28426":120845,"_3090":120896},[],"99,9 %",{"_3640":73000,"_31229":72978,"_21648":120898,"_5":14899,"_28426":120845,"_3090":51281},[],{"_3640":73001,"_31229":72978,"_21648":120900,"_5":14899,"_28426":120845,"_3090":120901},[],"Ilimitados",{"_3640":73002,"_31229":72978,"_21648":120903,"_5":14899,"_28426":120845,"_3090":120904},[],"Dedicado",{"_3640":73003,"_31229":72978,"_21648":120906,"_5":14899,"_28426":120845,"_3090":120907},[],"99,99 %",{"_3640":73004,"_31229":72978,"_21648":120909,"_5":14899,"_28426":120849,"_3090":120910},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3640":73005,"_31229":72978,"_21648":120912,"_5":14899,"_28426":120849,"_3090":120913},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3640":73006,"_31229":73006,"_5":15259,"_3090":51298,"_31567":120915,"_21648":120917,"_28426":73006},[51054,120682,120916],"Kubernetes autogestionado",[],{"_3640":73007,"_31229":73006,"_21648":120919,"_5":14899,"_28426":73006,"_3090":120920},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3640":73008,"_31229":73006,"_5":31564,"_21648":120922,"_28426":120923,"_3090":120924},[],"/docs/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3640":73009,"_31229":73006,"_5":31564,"_21648":120926,"_28426":120927,"_3090":120928},[],"/docs/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3640":73010,"_31229":73006,"_5":31564,"_21648":120930,"_28426":120931,"_3090":120932},[],"/docs/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3640":73011,"_31229":73006,"_5":31564,"_21648":120934,"_28426":120935,"_3090":120936},[],"/docs/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3640":73012,"_31229":73006,"_5":31564,"_21648":120938,"_28426":120939,"_3090":120940},[],"/docs/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3640":73013,"_31229":73006,"_5":31564,"_21648":120942,"_28426":120943,"_3090":120944},[],"/docs/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3640":73014,"_31229":73006,"_5":31564,"_21648":120946,"_28426":120947,"_3090":120948},[],"/docs/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3640":73015,"_31229":73006,"_5":31564,"_21648":120950,"_28426":120951,"_3090":120952},[],"/docs/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3640":73016,"_31229":73006,"_5":31564,"_21648":120954,"_28426":120955,"_3090":120956},[],"/docs/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3640":73017,"_31229":73006,"_5":31564,"_21648":120958,"_28426":120959,"_3090":120960},[],"/docs/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3640":73018,"_31229":73006,"_5":31564,"_21648":120962,"_28426":120963,"_3090":120964},[],"/docs/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3640":73019,"_31229":73006,"_21648":120966,"_5":14899,"_28426":120923,"_3090":120967},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3640":73020,"_31229":73006,"_21648":120969,"_5":14899,"_28426":120923,"_3090":120970},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3640":73021,"_31229":73006,"_21648":120972,"_5":14899,"_28426":120927,"_3090":120973},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3640":73022,"_31229":73006,"_21648":120975,"_5":14899,"_28426":120927,"_3090":120976},[],"Fastlane instala o configura",{"_3640":73023,"_31229":73006,"_21648":120978,"_5":14899,"_28426":120927,"_3090":120979},[],"Tú sigues proporcionando",{"_3640":73024,"_31229":73006,"_21648":120981,"_5":14899,"_28426":120927,"_3090":120982},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3640":73025,"_31229":73006,"_21648":120984,"_5":14899,"_28426":120927,"_3090":120985},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3640":73026,"_31229":73006,"_21648":120987,"_5":14899,"_28426":120927,"_3090":120988},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3640":73027,"_31229":73006,"_21648":120990,"_5":14899,"_28426":120927,"_3090":120991},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3640":73028,"_31229":73006,"_21648":120993,"_5":14899,"_28426":120927,"_3090":120994},[],"Un flujo de certificado self-signed para Lamassu, credenciales de las dependencias almacenadas en Secrets de Kubernetes (mediante el External Secrets Operator) y un usuario inicial",{"_3640":73029,"_31229":73006,"_21648":120996,"_5":14899,"_28426":120927,"_3090":120997},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3640":73030,"_31229":73006,"_21648":120999,"_5":14899,"_28426":120927,"_3090":121000},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3640":73031,"_31229":73006,"_21648":121002,"_5":14899,"_28426":120927,"_3090":121003},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3640":73032,"_31229":73006,"_21648":121005,"_5":14899,"_28426":120927,"_3090":121006},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3640":73033,"_31229":73006,"_21648":121008,"_5":14899,"_28426":120931,"_3090":121009},[],"Necesitas:",{"_3640":73034,"_31229":73006,"_21648":121011,"_5":14899,"_28426":120931,"_3090":121012},[],"un clúster Kubernetes existente",{"_3640":73035,"_31229":73006,"_21648":121014,"_5":14899,"_28426":120931,"_3090":121015},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3640":73036,"_31229":73006,"_21648":121017,"_5":14899,"_28426":120931,"_3090":51400},[],{"_3640":73037,"_31229":73006,"_21648":121019,"_5":14899,"_28426":120931,"_3090":24461},[],{"_3640":73038,"_31229":73006,"_21648":121021,"_5":14899,"_28426":120931,"_3090":121022},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3640":73039,"_31229":73006,"_21648":121024,"_5":14899,"_28426":120931,"_3090":121025},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3640":73040,"_31229":73006,"_21648":121027,"_5":14899,"_28426":120931,"_3090":121028},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3640":73041,"_31229":73006,"_21648":121030,"_5":14899,"_28426":120931,"_3090":121031},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3640":73042,"_31229":73006,"_21648":121033,"_5":14899,"_28426":120931,"_3090":121034},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3640":73043,"_31229":73006,"_21648":121036,"_5":14899,"_28426":120935,"_3090":121037},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3640":73044,"_31229":73006,"_21648":121039,"_5":14899,"_28426":120935,"_3090":121040},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3640":73045,"_31229":73006,"_21648":121042,"_5":14899,"_28426":120939,"_3090":121043},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3640":73046,"_31229":73006,"_21648":121045,"_5":14899,"_28426":120939,"_3090":121046},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3640":73047,"_31229":73006,"_21648":121048,"_5":14899,"_28426":120939,"_3090":121049},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3640":73048,"_31229":73006,"_21648":121051,"_5":14899,"_28426":120939,"_3090":121052},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3640":73049,"_31229":73006,"_21648":121054,"_5":14899,"_28426":120943,"_3090":121055},[],"Opción",{"_3640":73050,"_31229":73006,"_21648":121057,"_5":14899,"_28426":120943,"_3090":121058},[],"Valor predeterminado",{"_3640":73051,"_31229":73006,"_21648":121060,"_5":14899,"_28426":120943,"_3090":121061},[],"Propósito",{"_3640":73052,"_31229":73006,"_21648":121063,"_5":14899,"_28426":120943,"_3090":51447},[],{"_3640":73053,"_31229":73006,"_21648":121065,"_5":14899,"_28426":120943,"_3090":51450},[],{"_3640":73054,"_31229":73006,"_21648":121067,"_5":14899,"_28426":120943,"_3090":121068},[],"Muestra la ayuda",{"_3640":73055,"_31229":73006,"_21648":121070,"_5":14899,"_28426":120943,"_3090":51456},[],{"_3640":73056,"_31229":73006,"_21648":121072,"_5":14899,"_28426":120943,"_3090":121073},[],"contexto actual",{"_3640":73057,"_31229":73006,"_21648":121075,"_5":14899,"_28426":120943,"_3090":121076},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3640":73058,"_31229":73006,"_21648":121078,"_5":14899,"_28426":120943,"_3090":51465},[],{"_3640":73059,"_31229":73006,"_21648":121080,"_5":14899,"_28426":120943,"_3090":6820},[],{"_3640":73060,"_31229":73006,"_21648":121082,"_5":14899,"_28426":120943,"_3090":121083},[],"Omite prompts y genera credenciales para las dependencias",{"_3640":73061,"_31229":73006,"_21648":121085,"_5":14899,"_28426":120943,"_3090":51473},[],{"_3640":73062,"_31229":73006,"_21648":121087,"_5":14899,"_28426":120943,"_3090":51476},[],{"_3640":73063,"_31229":73006,"_21648":121089,"_5":14899,"_28426":120943,"_3090":121090},[],"Namespace de la instalación",{"_3640":73064,"_31229":73006,"_21648":121092,"_5":14899,"_28426":120943,"_3090":51482},[],{"_3640":73065,"_31229":73006,"_21648":121094,"_5":14899,"_28426":120943,"_3090":51485},[],{"_3640":73066,"_31229":73006,"_21648":121096,"_5":14899,"_28426":120943,"_3090":121097},[],"Dominio usado por la UI, OIDC y el certificado",{"_3640":73067,"_31229":73006,"_21648":121099,"_5":14899,"_28426":120943,"_3090":51491},[],{"_3640":73068,"_31229":73006,"_21648":121101,"_5":14899,"_28426":120943,"_3090":15611},[],{"_3640":73069,"_31229":73006,"_21648":121103,"_5":14899,"_28426":120943,"_3090":121104},[],"Versión del chart de Lamassu",{"_3640":73070,"_31229":73006,"_21648":121106,"_5":14899,"_28426":120943,"_3090":51499},[],{"_3640":73071,"_31229":73006,"_21648":121108,"_5":14899,"_28426":120943,"_3090":51502},[],{"_3640":73072,"_31229":73006,"_21648":121110,"_5":14899,"_28426":120943,"_3090":121111},[],"Puerto del listener HTTPS",{"_3640":73073,"_31229":73006,"_21648":121113,"_5":14899,"_28426":120943,"_3090":51508},[],{"_3640":73074,"_31229":73006,"_21648":121115,"_5":14899,"_28426":120943,"_3090":51511},[],{"_3640":73075,"_31229":73006,"_21648":121117,"_5":14899,"_28426":120943,"_3090":121118},[],"Puerto del listener HTTP",{"_3640":73076,"_31229":73006,"_21648":121120,"_5":14899,"_28426":120943,"_3090":51517},[],{"_3640":73077,"_31229":73006,"_21648":121122,"_5":14899,"_28426":120943,"_3090":51450},[],{"_3640":73078,"_31229":73006,"_21648":121124,"_5":14899,"_28426":120943,"_3090":121125},[],"Certificado PEM para TLS downstream",{"_3640":73079,"_31229":73006,"_21648":121127,"_5":14899,"_28426":120943,"_3090":51525},[],{"_3640":73080,"_31229":73006,"_21648":121129,"_5":14899,"_28426":120943,"_3090":51450},[],{"_3640":73081,"_31229":73006,"_21648":121131,"_5":14899,"_28426":120943,"_3090":121132},[],"Clave privada PEM para TLS downstream",{"_3640":73082,"_31229":73006,"_21648":121134,"_5":14899,"_28426":120943,"_3090":51533},[],{"_3640":73083,"_31229":73006,"_21648":121136,"_5":14899,"_28426":120943,"_3090":121137},[],"chart del repositorio",{"_3640":73084,"_31229":73006,"_21648":121139,"_5":14899,"_28426":120943,"_3090":121140},[],"Usa un chart local de Lamassu sin empaquetar",{"_3640":73085,"_31229":73006,"_21648":121142,"_5":14899,"_28426":120943,"_3090":51542},[],{"_3640":73086,"_31229":73006,"_21648":121144,"_5":14899,"_28426":120943,"_3090":121145},[],"detección automática",{"_3640":73087,"_31229":73006,"_21648":121147,"_5":14899,"_28426":120943,"_3090":121148},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3640":73088,"_31229":73006,"_21648":121150,"_5":14899,"_28426":120943,"_3090":51550},[],{"_3640":73089,"_31229":73006,"_21648":121152,"_5":14899,"_28426":120943,"_3090":6820},[],{"_3640":73090,"_31229":73006,"_21648":121154,"_5":14899,"_28426":120943,"_3090":121155},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3640":73091,"_31229":73006,"_21648":121157,"_5":14899,"_28426":120943,"_3090":51558},[],{"_3640":73092,"_31229":73006,"_21648":121159,"_5":14899,"_28426":120943,"_3090":6820},[],{"_3640":73093,"_31229":73006,"_21648":121161,"_5":14899,"_28426":120943,"_3090":121162},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3640":73094,"_31229":73006,"_21648":121164,"_5":14899,"_28426":120943,"_3090":51566},[],{"_3640":73095,"_31229":73006,"_21648":121166,"_5":14899,"_28426":120943,"_3090":6820},[],{"_3640":73096,"_31229":73006,"_21648":121168,"_5":14899,"_28426":120943,"_3090":121169},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3640":73097,"_31229":73006,"_21648":121171,"_5":14899,"_28426":120943,"_3090":51574},[],{"_3640":73098,"_31229":73006,"_21648":121173,"_5":14899,"_28426":120943,"_3090":6820},[],{"_3640":73099,"_31229":73006,"_21648":121175,"_5":14899,"_28426":120943,"_3090":121176},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3640":73100,"_31229":73006,"_21648":121178,"_5":14899,"_28426":120943,"_3090":51582},[],{"_3640":73101,"_31229":73006,"_21648":121180,"_5":14899,"_28426":120943,"_3090":51585},[],{"_3640":73102,"_31229":73006,"_21648":121182,"_5":14899,"_28426":120943,"_3090":121183},[],"Usa otro chart local de SoftHSM",{"_3640":73103,"_31229":73006,"_21648":121185,"_5":14899,"_28426":120943,"_3090":121186},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3640":73104,"_31229":73006,"_21648":121188,"_5":14899,"_28426":120947,"_3090":121189},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3640":73105,"_31229":73006,"_21648":121191,"_5":14899,"_28426":120947,"_3090":121192},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3640":73106,"_31229":73006,"_21648":121194,"_5":14899,"_28426":120947,"_3090":121195},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3640":73107,"_31229":73006,"_21648":121197,"_5":14899,"_28426":120947,"_3090":121198},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3640":73108,"_31229":73006,"_21648":121200,"_5":14899,"_28426":120947,"_3090":121201},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3640":73109,"_31229":73006,"_21648":121203,"_5":14899,"_28426":120947,"_3090":121204},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3640":73110,"_31229":73006,"_21648":121206,"_5":14899,"_28426":120951,"_3090":51612},[],{"_3640":73111,"_31229":73006,"_21648":121208,"_5":14899,"_28426":120951,"_3090":121209},[],"valida las herramientas locales y el clúster seleccionado",{"_3640":73112,"_31229":73006,"_21648":121211,"_5":14899,"_28426":120951,"_3090":121212},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3640":73113,"_31229":73006,"_21648":121214,"_5":14899,"_28426":120951,"_3090":121215},[],"crea el namespace",{"_3640":73114,"_31229":73006,"_21648":121217,"_5":14899,"_28426":120951,"_3090":121218},[],"instala el External Secrets Operator y crea las credenciales de PostgreSQL, RabbitMQ y del administrador de Keycloak como Secrets a través de un `ClusterSecretStore` Fake",{"_3640":73115,"_31229":73006,"_21648":121220,"_5":14899,"_28426":120951,"_3090":121221},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3640":73116,"_31229":73006,"_21648":121223,"_5":14899,"_28426":120951,"_3090":121224},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3640":73117,"_31229":73006,"_21648":121226,"_5":14899,"_28426":120951,"_3090":121227},[],"instala RabbitMQ",{"_3640":73118,"_31229":73006,"_21648":121229,"_5":14899,"_28426":120951,"_3090":121230},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3640":73119,"_31229":73006,"_21648":121232,"_5":14899,"_28426":120951,"_3090":121233},[],"genera `lamassu.yaml`, que referencia los Secrets en lugar de credenciales inline, e instala el chart de Lamassu",{"_3640":73120,"_31229":73006,"_21648":121235,"_5":14899,"_28426":120951,"_3090":121236},[],"carga datos de ejemplo opcionalmente",{"_3640":73121,"_31229":73006,"_21648":121238,"_5":14899,"_28426":120951,"_3090":121239},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3640":73122,"_31229":73006,"_21648":121241,"_5":14899,"_28426":120955,"_3090":121242},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3640":73123,"_31229":73006,"_21648":121244,"_5":14899,"_28426":120955,"_3090":121245},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3640":73124,"_31229":73006,"_21648":121247,"_5":14899,"_28426":120959,"_3090":121248},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak y las almacena en Secrets de Kubernetes a través del `ClusterSecretStore` Fake del External Secrets Operator. Fastlane escribe `lamassu.yaml` en el directorio actual referenciando esos Secrets — el archivo de valores ya no contiene las credenciales.",{"_3640":73125,"_31229":73006,"_21648":121250,"_5":14899,"_28426":120959,"_3090":121251},[],"La contraseña del administrador de Keycloak ya no se imprime por pantalla. Recupérala del Secret cuando la necesites:",{"_3640":73126,"_31229":73006,"_21648":121253,"_5":14899,"_28426":120959,"_3090":121254},[],"El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3640":73127,"_31229":73006,"_21648":121256,"_5":14899,"_28426":120959,"_3090":121257},[],"El `ClusterSecretStore` Fake almacena las credenciales en texto plano y es solo para laboratorio: sustitúyelo por un proveedor ESO real para cualquier uso que vaya más allá de un entorno desechable. Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3640":73128,"_31229":73006,"_21648":121259,"_5":14899,"_28426":120963,"_3090":121260},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3640":73129,"_31229":73129,"_5":15259,"_3090":121262,"_31567":121263,"_21648":121264,"_28426":73129},"Instala con Helm",[51054,120682,120916],[],{"_3640":73130,"_31229":73129,"_21648":121266,"_5":14899,"_28426":73129,"_3090":121267},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3640":73131,"_31229":73129,"_5":31564,"_21648":121269,"_28426":121270,"_3090":121271},[],"/docs/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3640":73132,"_31229":73129,"_5":31564,"_21648":121273,"_28426":121274,"_3090":120932},[],"/docs/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3640":73133,"_31229":73129,"_5":31564,"_21648":121276,"_28426":121277,"_3090":121278},[],"/docs/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3640":73134,"_31229":73129,"_5":31564,"_21648":121280,"_28426":121281,"_3090":121282},[],"/docs/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3640":73135,"_31229":73129,"_5":31564,"_21648":121284,"_28426":121285,"_3090":121286},[],"/docs/es/deployment/self-hosted/helm#credenciales-en-secrets-de-kubernetes","Credenciales en Secrets de Kubernetes",{"_3640":73136,"_31229":73129,"_5":31564,"_21648":121288,"_28426":121289,"_3090":121290},[],"/docs/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3640":73137,"_31229":73129,"_5":31564,"_21648":121292,"_28426":121293,"_3090":121294},[],"/docs/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3640":73138,"_31229":73129,"_5":31564,"_21648":121296,"_28426":121297,"_3090":121298},[],"/docs/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3640":73139,"_31229":73129,"_5":31564,"_21648":121300,"_28426":121301,"_3090":121302},[],"/docs/es/deployment/self-hosted/helm#terminal-experimental-del-dashboard-opcional","Terminal experimental del dashboard (opcional)",{"_3640":73140,"_31229":73129,"_5":31564,"_21648":121304,"_28426":121305,"_3090":121306},[],"/docs/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3640":73141,"_31229":73129,"_5":31564,"_21648":121308,"_28426":121309,"_3090":121310},[],"/docs/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3640":73142,"_31229":73129,"_5":31564,"_21648":121312,"_28426":121313,"_3090":121314},[],"/docs/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3640":73143,"_31229":73129,"_5":31564,"_21648":121316,"_28426":121317,"_3090":121318},[],"/docs/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3640":73144,"_31229":73129,"_21648":121320,"_5":14899,"_28426":121270,"_3090":121321},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3640":73145,"_31229":73129,"_21648":121323,"_5":14899,"_28426":121274,"_3090":121324},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3640":73146,"_31229":73129,"_21648":121326,"_5":14899,"_28426":121274,"_3090":121327},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3640":73147,"_31229":73129,"_21648":121329,"_5":14899,"_28426":121274,"_3090":121330},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3640":73148,"_31229":73129,"_21648":121332,"_5":14899,"_28426":121274,"_3090":121333},[],"un broker RabbitMQ accesible y sus credenciales",{"_3640":73149,"_31229":73129,"_21648":121335,"_5":14899,"_28426":121274,"_3090":121336},[],"Secrets de Kubernetes en el namespace del release con las credenciales de PostgreSQL y RabbitMQ (y las credenciales SMTP cuando el SMTP exija autenticación) — el chart lee las credenciales de Secrets y rechaza los valores inline (consulta Credenciales en Secrets de Kubernetes)",{"_3640":73150,"_31229":73129,"_21648":121338,"_5":14899,"_28426":121274,"_3090":121339},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3640":73151,"_31229":73129,"_21648":121341,"_5":14899,"_28426":121274,"_3090":121342},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3640":73152,"_31229":73129,"_21648":121344,"_5":14899,"_28426":121274,"_3090":121345},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3640":73153,"_31229":73129,"_21648":121347,"_5":14899,"_28426":121274,"_3090":121348},[],"una StorageClass y un diseño de tráfico externo",{"_3640":73154,"_31229":73129,"_21648":121350,"_5":14899,"_28426":121274,"_3090":121351},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3640":73155,"_31229":73129,"_21648":121353,"_5":14899,"_28426":121274,"_3090":121354},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3640":73156,"_31229":73129,"_21648":121356,"_5":14899,"_28426":121274,"_3090":121357},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3640":73157,"_31229":73129,"_21648":121359,"_5":14899,"_28426":121277,"_3090":121360},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3640":73158,"_31229":73129,"_21648":121362,"_5":14899,"_28426":121277,"_3090":121363},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3640":73159,"_31229":73129,"_21648":121365,"_5":14899,"_28426":121277,"_3090":121366},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3640":73160,"_31229":73129,"_21648":121368,"_5":14899,"_28426":121281,"_3090":121369},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3640":73161,"_31229":73129,"_21648":121371,"_5":14899,"_28426":121281,"_3090":121372},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3640":73162,"_31229":73129,"_21648":121374,"_5":14899,"_28426":121281,"_3090":121375},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3640":73163,"_31229":73129,"_21648":121377,"_5":14899,"_28426":121281,"_3090":121378},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3640":73164,"_31229":73129,"_21648":121380,"_5":14899,"_28426":121285,"_3090":121381},[],"El chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release. Referéncialas con `existingSecret` más las claves de datos `usernameKey` y `passwordKey`; los valores inline `username` y `password` se han eliminado y `values.schema.json` los rechaza.",{"_3640":73165,"_31229":73129,"_21648":121383,"_5":14899,"_28426":121285,"_3090":121384},[],"Los Secrets deben existir antes de instalar o actualizar: el job de migración de pre-install y pre-upgrade se conecta a PostgreSQL con el Secret de PostgreSQL, y los contenedores de los servicios leen las credenciales de AMQP y SMTP cuando arrancan.",{"_3640":73166,"_31229":73129,"_21648":121386,"_5":14899,"_28426":121285,"_3090":121387},[],"`postgres.existingSecret` (por defecto `lamassu-postgres`) y `amqp.existingSecret` (por defecto `lamassu-amqp`) son obligatorios siempre.",{"_3640":73167,"_31229":73129,"_21648":121389,"_5":14899,"_28426":121285,"_3090":121390},[],"`services.alerts.smtp_server.existingSecret` está vacío por defecto, lo que significa SMTP sin autenticación. Defínelo, junto con sus nombres de clave, solo cuando tu servidor SMTP exija autenticación.",{"_3640":73168,"_31229":73129,"_21648":121392,"_5":14899,"_28426":121285,"_3090":121393},[],"Cada entrada de `services.authz.credentials` nombra su `database` y usa el Secret global de PostgreSQL — `postgres.existingSecret` con sus nombres de clave configurados — salvo que la entrada defina su propio `existingSecret`.",{"_3640":73169,"_31229":73129,"_21648":121395,"_5":14899,"_28426":121285,"_3090":121396},[],"Cambiar el contenido de un Secret no reinicia los pods que lo consumen: los servicios leen las credenciales cuando arrancan. Reinicia los pods afectados después de rotar una credencial.",{"_3640":73170,"_31229":73129,"_21648":121398,"_5":14899,"_28426":121285,"_3090":121399},[],"Para producción, gestiona los Secrets con el External Secrets Operator (ESO), que el chart no instala. El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` de prueba, los recursos `ExternalSecret` y la espera antes de instalar el chart. Su proveedor Fake es solo para pruebas — sustitúyelo por la configuración de tu proveedor para cualquier uso que vaya más allá de un entorno desechable; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager y otros proveedores están documentados en external-secrets.io.",{"_3640":73171,"_31229":73129,"_21648":121401,"_5":14899,"_28426":121285,"_3090":121402},[],"Solo estas credenciales pasan a Secrets: el resto de values, como la configuración de conectores o de motores criptográficos, sigue configurándose en el archivo de values.",{"_3640":73172,"_31229":73129,"_21648":121404,"_5":14899,"_28426":121289,"_3090":121405},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3640":73173,"_31229":73129,"_21648":121407,"_5":14899,"_28426":121293,"_3090":121408},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3640":73174,"_31229":73129,"_21648":121410,"_5":14899,"_28426":121293,"_3090":121411},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3640":73175,"_31229":73129,"_21648":121413,"_5":14899,"_28426":121293,"_3090":121414},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3640":73176,"_31229":73129,"_21648":121416,"_5":14899,"_28426":121293,"_3090":121417},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — el security context del pod por defecto del chart ya define `fsGroup: 65532` para todos los pods de servicio, por lo que este ajuste solo se aplica cuando se ha sobrescrito un `podSecurityContext` explícito sin `fsGroup` y hay un Secret de cliente AMQP configurado — y usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3640":73177,"_31229":73129,"_21648":121419,"_5":14899,"_28426":121293,"_3090":121420},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3640":73178,"_31229":73129,"_21648":121422,"_5":14899,"_28426":121293,"_3090":121423},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3640":73179,"_31229":73129,"_21648":121425,"_5":14899,"_28426":121293,"_3090":121426},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3640":73180,"_31229":73129,"_21648":121428,"_5":14899,"_28426":121297,"_3090":121429},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3640":73181,"_31229":73129,"_21648":121431,"_5":14899,"_28426":121297,"_3090":121432},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3640":73182,"_31229":73129,"_21648":121434,"_5":14899,"_28426":121297,"_3090":121435},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3640":73183,"_31229":73129,"_21648":121437,"_5":14899,"_28426":121297,"_3090":121438},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3640":73184,"_31229":73129,"_21648":121440,"_5":14899,"_28426":121301,"_3090":121441},[],"El dashboard incluye un terminal experimental en el navegador para trabajar con los dispositivos. Está deshabilitado por defecto; actívalo en el archivo de valores:",{"_3640":73185,"_31229":73129,"_21648":121443,"_5":14899,"_28426":121301,"_3090":121444},[],"Para habilitar el terminal se requiere la autorización externa: define `auth.externalAuthorization.enabled: true` y `auth.externalAuthorization.failOpen: false`. Si no, el chart se niega a renderizar el release, porque el endpoint WebSocket del terminal quedaría expuesto a través del Gateway sin autorización externa.",{"_3640":73186,"_31229":73129,"_21648":121446,"_5":14899,"_28426":121301,"_3090":121447},[],"Solo las identidades que tengan concedida la política precargada \"Terminal Network\" pueden abrir sesiones de terminal. Consulta Control de acceso para saber cómo se asignan las políticas.",{"_3640":73187,"_31229":73129,"_21648":121449,"_5":14899,"_28426":121301,"_3090":121450},[],"Ten en cuenta que, incluso con el terminal habilitado, los pods dentro del clúster pueden seguir llegando directamente al servicio de la UI salvo que las network policies restrinjan ese acceso: la autorización externa se aplica al tráfico que entra por el Gateway.",{"_3640":73188,"_31229":73129,"_21648":121452,"_5":14899,"_28426":121305,"_3090":121453},[],"Para instalar un checkout local:",{"_3640":73189,"_31229":73129,"_21648":121455,"_5":14899,"_28426":121309,"_3090":121456},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3640":73190,"_31229":73129,"_21648":121458,"_5":14899,"_28426":121309,"_3090":121459},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3640":73191,"_31229":73129,"_21648":121461,"_5":14899,"_28426":121313,"_3090":121462},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3640":73192,"_31229":73129,"_21648":121464,"_5":14899,"_28426":121313,"_3090":121465},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3640":73193,"_31229":73129,"_21648":121467,"_5":14899,"_28426":121313,"_3090":121468},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3640":73194,"_31229":73129,"_21648":121470,"_5":14899,"_28426":121313,"_3090":121471},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3640":73195,"_31229":73129,"_21648":121473,"_5":14899,"_28426":121313,"_3090":121474},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3640":73196,"_31229":73129,"_21648":121476,"_5":14899,"_28426":121317,"_3090":121477},[],"Antes de pasar a producción, revisa:",{"_3640":73197,"_31229":73129,"_21648":121479,"_5":14899,"_28426":121317,"_3090":121480},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3640":73198,"_31229":73129,"_21648":121482,"_5":14899,"_28426":121317,"_3090":121483},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3640":73199,"_31229":73129,"_21648":121485,"_5":14899,"_28426":121317,"_3090":121486},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3640":73200,"_31229":73129,"_21648":121488,"_5":14899,"_28426":121317,"_3090":121489},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3640":73201,"_31229":73129,"_21648":121491,"_5":14899,"_28426":121317,"_3090":121492},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3640":73202,"_31229":73129,"_21648":121494,"_5":14899,"_28426":121317,"_3090":121495},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3640":73203,"_31229":73129,"_21648":121497,"_5":14899,"_28426":121317,"_3090":121498},[],"SMTP, observabilidad y entrega de alertas",{"_3640":73204,"_31229":73129,"_21648":121500,"_5":14899,"_28426":121317,"_3090":121501},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3640":73205,"_31229":73129,"_21648":121503,"_5":14899,"_28426":121317,"_3090":121504},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3640":73206,"_31229":73206,"_5":15259,"_3090":121506,"_31567":121507,"_21648":121508,"_28426":73206},"Expón el Gateway",[51054,120682,120916],[],{"_3640":73207,"_31229":73206,"_21648":121510,"_5":14899,"_28426":73206,"_3090":121511},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3640":73208,"_31229":73206,"_5":31564,"_21648":121513,"_28426":121514,"_3090":121515},[],"/docs/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3640":73209,"_31229":73206,"_5":31564,"_21648":121517,"_28426":121518,"_3090":121519},[],"/docs/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3640":73210,"_31229":73206,"_5":31564,"_21648":121521,"_28426":121522,"_3090":121523},[],"/docs/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3640":73211,"_31229":73206,"_5":31564,"_21648":121525,"_28426":121526,"_3090":51933},[],"/docs/es/deployment/self-hosted/networking#k3s",{"_3640":73212,"_31229":73206,"_5":31564,"_21648":121528,"_28426":121529,"_3090":121530},[],"/docs/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3640":73213,"_31229":73206,"_5":31564,"_21648":121532,"_28426":121533,"_3090":121534},[],"/docs/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3640":73214,"_31229":73206,"_5":31564,"_21648":121536,"_28426":121537,"_3090":121538},[],"/docs/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3640":73215,"_31229":73206,"_5":31564,"_21648":121540,"_28426":121541,"_3090":121542},[],"/docs/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3640":73216,"_31229":73206,"_5":31564,"_21648":121544,"_28426":121545,"_3090":121546},[],"/docs/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3640":73217,"_31229":73206,"_5":31564,"_21648":121548,"_28426":121549,"_3090":121550},[],"/docs/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3640":73218,"_31229":73206,"_5":31564,"_21648":121552,"_28426":121553,"_3090":121554},[],"/docs/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3640":73219,"_31229":73206,"_21648":121556,"_5":14899,"_28426":121514,"_3090":121557},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3640":73220,"_31229":73206,"_21648":121559,"_5":14899,"_28426":121514,"_3090":121560},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3640":73221,"_31229":73206,"_21648":121562,"_5":14899,"_28426":121518,"_3090":121563},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3640":73222,"_31229":73206,"_21648":121565,"_5":14899,"_28426":121518,"_3090":121566},[],"Defínelo únicamente cuando:",{"_3640":73223,"_31229":73206,"_21648":121568,"_5":14899,"_28426":121518,"_3090":121569},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3640":73224,"_31229":73206,"_21648":121571,"_5":14899,"_28426":121518,"_3090":121572},[],"esa dirección está asignada a este Gateway",{"_3640":73225,"_31229":73206,"_21648":121574,"_5":14899,"_28426":121518,"_3090":121575},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3640":73226,"_31229":73206,"_21648":121577,"_5":14899,"_28426":121518,"_3090":121578},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3640":73227,"_31229":73206,"_21648":121580,"_5":14899,"_28426":121518,"_3090":121581},[],"No confundas estos valores:",{"_3640":73228,"_31229":73206,"_21648":121583,"_5":14899,"_28426":121518,"_3090":121584},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3640":73229,"_31229":73206,"_21648":121586,"_5":14899,"_28426":121518,"_3090":121587},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3640":73230,"_31229":73206,"_21648":121589,"_5":14899,"_28426":121518,"_3090":121590},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3640":73231,"_31229":73206,"_21648":121592,"_5":14899,"_28426":121522,"_3090":121593},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3640":73232,"_31229":73206,"_21648":121595,"_5":14899,"_28426":121522,"_3090":121596},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3640":73233,"_31229":73206,"_21648":121598,"_5":14899,"_28426":121526,"_3090":121599},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3640":73234,"_31229":73206,"_21648":121601,"_5":14899,"_28426":121526,"_3090":121602},[],"Para el diseño recomendado:",{"_3640":73235,"_31229":73206,"_21648":121604,"_5":14899,"_28426":121526,"_3090":121605},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3640":73236,"_31229":73206,"_21648":121607,"_5":14899,"_28426":121526,"_3090":121608},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3640":73237,"_31229":73206,"_21648":121610,"_5":14899,"_28426":121526,"_3090":121611},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3640":73238,"_31229":73206,"_21648":121613,"_5":14899,"_28426":121526,"_3090":121614},[],"Apunta DNS a la dirección accesible de la VM.",{"_3640":73239,"_31229":73206,"_21648":121616,"_5":14899,"_28426":121526,"_3090":121617},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3640":73240,"_31229":73206,"_21648":121619,"_5":14899,"_28426":121529,"_3090":121620},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3640":73241,"_31229":73206,"_21648":121622,"_5":14899,"_28426":121533,"_3090":121623},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3640":73242,"_31229":73206,"_21648":121625,"_5":14899,"_28426":121533,"_3090":121626},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3640":73243,"_31229":73206,"_21648":121628,"_5":14899,"_28426":121537,"_3090":121629},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3640":73244,"_31229":73206,"_21648":121631,"_5":14899,"_28426":121537,"_3090":121632},[],"Requisito",{"_3640":73245,"_31229":73206,"_21648":121634,"_5":14899,"_28426":121537,"_3090":121635},[],"Diseño recomendado",{"_3640":73246,"_31229":73206,"_21648":121637,"_5":14899,"_28426":121537,"_3090":121638},[],"Consecuencia",{"_3640":73247,"_31229":73206,"_21648":121640,"_5":14899,"_28426":121537,"_3090":121641},[],"Varias URL o servicios de Lamassu",{"_3640":73248,"_31229":73206,"_21648":121643,"_5":14899,"_28426":121537,"_3090":121644},[],"Un Gateway con varias rutas",{"_3640":73249,"_31229":73206,"_21648":121646,"_5":14899,"_28426":121537,"_3090":121647},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3640":73250,"_31229":73206,"_21648":121649,"_5":14899,"_28426":121537,"_3090":121650},[],"Gateways independientes e IP externas distintas",{"_3640":73251,"_31229":73206,"_21648":121652,"_5":14899,"_28426":121537,"_3090":121653},[],"Una VIP por Gateway",{"_3640":73252,"_31229":73206,"_21648":121655,"_5":14899,"_28426":121537,"_3090":121656},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3640":73253,"_31229":73206,"_21648":121658,"_5":14899,"_28426":121537,"_3090":121659},[],"Gateways independientes, un nodo y una IP",{"_3640":73254,"_31229":73206,"_21648":121661,"_5":14899,"_28426":121537,"_3090":121662},[],"Puertos externos diferentes",{"_3640":73255,"_31229":73206,"_21648":121664,"_5":14899,"_28426":121537,"_3090":121665},[],"Los clientes deben indicar puertos no estándar",{"_3640":73256,"_31229":73206,"_21648":121667,"_5":14899,"_28426":121537,"_3090":121668},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3640":73257,"_31229":73206,"_21648":121670,"_5":14899,"_28426":121537,"_3090":121671},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3640":73258,"_31229":73206,"_21648":121673,"_5":14899,"_28426":121537,"_3090":121674},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3640":73259,"_31229":73206,"_21648":121676,"_5":14899,"_28426":121537,"_3090":121677},[],"Recursos Gateway separados pero proxy compartido",{"_3640":73260,"_31229":73206,"_21648":121679,"_5":14899,"_28426":121537,"_3090":121680},[],"Modo merged Gateway de Envoy",{"_3640":73261,"_31229":73206,"_21648":121682,"_5":14899,"_28426":121537,"_3090":121683},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3640":73262,"_31229":73206,"_21648":121685,"_5":14899,"_28426":121537,"_3090":121686},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3640":73263,"_31229":73206,"_21648":121688,"_5":14899,"_28426":121537,"_3090":121689},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3640":73264,"_31229":73206,"_21648":121691,"_5":14899,"_28426":121537,"_3090":121692},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3640":73265,"_31229":73206,"_21648":121694,"_5":14899,"_28426":121537,"_3090":121695},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3640":73266,"_31229":73206,"_21648":121697,"_5":14899,"_28426":121541,"_3090":121698},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3640":73267,"_31229":73206,"_21648":121700,"_5":14899,"_28426":121545,"_3090":121701},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3640":73268,"_31229":73206,"_21648":121703,"_5":14899,"_28426":121545,"_3090":121704},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3640":73269,"_31229":73206,"_21648":121706,"_5":14899,"_28426":121545,"_3090":121707},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3640":73270,"_31229":73206,"_21648":121709,"_5":14899,"_28426":121545,"_3090":121710},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3640":73271,"_31229":73206,"_21648":121712,"_5":14899,"_28426":121545,"_3090":121713},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3640":73272,"_31229":73206,"_21648":121715,"_5":14899,"_28426":121549,"_3090":121716},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3640":73273,"_31229":73206,"_21648":121718,"_5":14899,"_28426":121549,"_3090":121719},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3640":73274,"_31229":73206,"_21648":121721,"_5":14899,"_28426":121553,"_3090":121722},[],"Comprueba, en orden:",{"_3640":73275,"_31229":73206,"_21648":121724,"_5":14899,"_28426":121553,"_3090":121725},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3640":73276,"_31229":73206,"_21648":121727,"_5":14899,"_28426":121553,"_3090":121728},[],"Su estado contiene la dirección esperada.",{"_3640":73277,"_31229":73206,"_21648":121730,"_5":14899,"_28426":121553,"_3090":121731},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3640":73278,"_31229":73206,"_21648":121733,"_5":14899,"_28426":121553,"_3090":121734},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3640":73279,"_31229":73206,"_21648":121736,"_5":14899,"_28426":121553,"_3090":121737},[],"DNS resuelve al endpoint accesible externamente.",{"_3640":73280,"_31229":73206,"_21648":121739,"_5":14899,"_28426":121553,"_3090":121740},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3640":73281,"_31229":73206,"_21648":121742,"_5":14899,"_28426":121553,"_3090":121743},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3640":73282,"_31229":73282,"_5":15259,"_3090":51161,"_31567":121745,"_21648":121746,"_28426":73282},[51054,120682,120916],[],{"_3640":73283,"_31229":73282,"_21648":121748,"_5":14899,"_28426":73282,"_3090":121749},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3640":73284,"_31229":73282,"_5":31564,"_21648":121751,"_28426":121752,"_3090":121753},[],"/docs/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3640":73285,"_31229":73282,"_5":31564,"_21648":121755,"_28426":121756,"_3090":121757},[],"/docs/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3640":73286,"_31229":73282,"_5":31564,"_21648":121759,"_28426":121760,"_3090":121761},[],"/docs/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3640":73287,"_31229":73282,"_5":31564,"_21648":121763,"_28426":121764,"_3090":121765},[],"/docs/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3640":73288,"_31229":73282,"_5":31564,"_21648":121767,"_28426":121768,"_3090":121769},[],"/docs/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3640":73289,"_31229":73282,"_5":31564,"_21648":121771,"_28426":121772,"_3090":121773},[],"/docs/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3640":73290,"_31229":73282,"_21648":121775,"_5":14899,"_28426":121752,"_3090":121776},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3640":73291,"_31229":73282,"_21648":121778,"_5":14899,"_28426":121756,"_3090":121779},[],"Flujo",{"_3640":73292,"_31229":73282,"_21648":121781,"_5":14899,"_28426":121756,"_3090":121782},[],"Úsalo para",{"_3640":73293,"_31229":73282,"_21648":121784,"_5":14899,"_28426":121756,"_3090":121785},[],"Qué instala",{"_3640":73294,"_31229":73282,"_21648":121787,"_5":14899,"_28426":121756,"_3090":52195},[],{"_3640":73295,"_31229":73282,"_21648":121789,"_5":14899,"_28426":121756,"_3090":121790},[],"Producción y entornos controlados",{"_3640":73296,"_31229":73282,"_21648":121792,"_5":14899,"_28426":121756,"_3090":121793},[],"Servicios de Lamassu y recursos de Gateway API",{"_3640":73297,"_31229":73282,"_21648":121795,"_5":14899,"_28426":121756,"_3090":51298},[],{"_3640":73298,"_31229":73282,"_21648":121797,"_5":14899,"_28426":121756,"_3090":121798},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3640":73299,"_31229":73282,"_21648":121800,"_5":14899,"_28426":121756,"_3090":121801},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3640":73300,"_31229":73282,"_21648":121803,"_5":14899,"_28426":121760,"_3090":121804},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3640":73301,"_31229":73282,"_21648":121806,"_5":14899,"_28426":121760,"_3090":121807},[],"Área",{"_3640":73302,"_31229":73282,"_21648":121809,"_5":14899,"_28426":121760,"_3090":121810},[],"El chart de Lamassu proporciona",{"_3640":73303,"_31229":73282,"_21648":121812,"_5":14899,"_28426":121760,"_3090":121813},[],"Tú proporcionas",{"_3640":73304,"_31229":73282,"_21648":121815,"_5":14899,"_28426":121760,"_3090":121816},[],"Aplicaciones Lamassu",{"_3640":73305,"_31229":73282,"_21648":121818,"_5":14899,"_28426":121760,"_3090":121819},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3640":73306,"_31229":73282,"_21648":121821,"_5":14899,"_28426":121760,"_3090":121822},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3640":73307,"_31229":73282,"_21648":121824,"_5":14899,"_28426":121760,"_3090":121825},[],"Datos PostgreSQL",{"_3640":73308,"_31229":73282,"_21648":121827,"_5":14899,"_28426":121760,"_3090":121828},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3640":73309,"_31229":73282,"_21648":121830,"_5":14899,"_28426":121760,"_3090":121831},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3640":73310,"_31229":73282,"_21648":121833,"_5":14899,"_28426":121760,"_3090":121834},[],"Mensajería",{"_3640":73311,"_31229":73282,"_21648":121836,"_5":14899,"_28426":121760,"_3090":121837},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3640":73312,"_31229":73282,"_21648":121839,"_5":14899,"_28426":121760,"_3090":121840},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3640":73313,"_31229":73282,"_21648":121842,"_5":14899,"_28426":121760,"_3090":121843},[],"Identidad",{"_3640":73314,"_31229":73282,"_21648":121845,"_5":14899,"_28426":121760,"_3090":121846},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3640":73315,"_31229":73282,"_21648":121848,"_5":14899,"_28426":121760,"_3090":121849},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3640":73316,"_31229":73282,"_21648":121851,"_5":14899,"_28426":121760,"_3090":121852},[],"Enrutamiento externo",{"_3640":73317,"_31229":73282,"_21648":121854,"_5":14899,"_28426":121760,"_3090":121855},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3640":73318,"_31229":73282,"_21648":121857,"_5":14899,"_28426":121760,"_3090":121858},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3640":73319,"_31229":73282,"_21648":121860,"_5":14899,"_28426":121760,"_3090":52269},[],{"_3640":73320,"_31229":73282,"_21648":121862,"_5":14899,"_28426":121760,"_3090":121863},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3640":73321,"_31229":73282,"_21648":121865,"_5":14899,"_28426":121760,"_3090":121866},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3640":73322,"_31229":73282,"_21648":121868,"_5":14899,"_28426":121760,"_3090":121869},[],"Datos persistentes de la aplicación",{"_3640":73323,"_31229":73282,"_21648":121871,"_5":14899,"_28426":121760,"_3090":121872},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3640":73324,"_31229":73282,"_21648":121874,"_5":14899,"_28426":121760,"_3090":121875},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3640":73325,"_31229":73282,"_21648":121877,"_5":14899,"_28426":121760,"_3090":121878},[],"Integraciones opcionales",{"_3640":73326,"_31229":73282,"_21648":121880,"_5":14899,"_28426":121760,"_3090":121881},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3640":73327,"_31229":73282,"_21648":121883,"_5":14899,"_28426":121760,"_3090":121884},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3640":73328,"_31229":73282,"_21648":121886,"_5":14899,"_28426":121760,"_3090":121887},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3640":73329,"_31229":73282,"_21648":121889,"_5":14899,"_28426":121760,"_3090":121890},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3640":73330,"_31229":73282,"_21648":121892,"_5":14899,"_28426":121764,"_3090":121893},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3640":73331,"_31229":73282,"_21648":121895,"_5":14899,"_28426":121764,"_3090":121896},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3640":73332,"_31229":73282,"_21648":121898,"_5":14899,"_28426":121768,"_3090":121899},[],"Kubernetes 1.24 o posterior",{"_3640":73333,"_31229":73282,"_21648":121901,"_5":14899,"_28426":121768,"_3090":121902},[],"Helm 3.2 o posterior",{"_3640":73334,"_31229":73282,"_21648":121904,"_5":14899,"_28426":121768,"_3090":121905},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3640":73335,"_31229":73282,"_21648":121907,"_5":14899,"_28426":121768,"_3090":121908},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3640":73336,"_31229":73282,"_21648":121910,"_5":14899,"_28426":121768,"_3090":121911},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3640":73337,"_31229":73282,"_21648":121913,"_5":14899,"_28426":121768,"_3090":121914},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3640":73338,"_31229":73282,"_21648":121916,"_5":14899,"_28426":121768,"_3090":121917},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3640":73339,"_31229":73282,"_21648":121919,"_5":14899,"_28426":121772,"_3090":121920},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3640":73340,"_31229":73282,"_21648":121922,"_5":14899,"_28426":121772,"_3090":121923},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3640":73341,"_31229":73282,"_21648":121925,"_5":14899,"_28426":121772,"_3090":121926},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3640":73342,"_31229":73282,"_21648":121928,"_5":14899,"_28426":121772,"_3090":121929},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3640":73343,"_31229":73343,"_5":15259,"_3090":121931,"_31567":121932,"_21648":121934,"_28426":73343},"Resolución de problemas de despliegue",[51054,120682,121933],"Operación",[],{"_3640":73344,"_31229":73343,"_21648":121936,"_5":14899,"_28426":73343,"_3090":121937},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3640":73345,"_31229":73343,"_5":31564,"_21648":121939,"_28426":121940,"_3090":121941},[],"/docs/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3640":73346,"_31229":73343,"_5":31564,"_21648":121943,"_28426":121944,"_3090":121945},[],"/docs/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3640":73347,"_31229":73343,"_5":31564,"_21648":121947,"_28426":121948,"_3090":121949},[],"/docs/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3640":73348,"_31229":73343,"_5":31564,"_21648":121951,"_28426":121952,"_3090":121953},[],"/docs/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3640":73349,"_31229":73343,"_5":31564,"_21648":121955,"_28426":121956,"_3090":121957},[],"/docs/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3640":73350,"_31229":73343,"_5":31564,"_21648":121959,"_28426":121960,"_3090":121961},[],"/docs/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3640":73351,"_31229":73343,"_5":31564,"_21648":121963,"_28426":121964,"_3090":121965},[],"/docs/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3640":73352,"_31229":73343,"_5":31564,"_21648":121967,"_28426":121968,"_3090":121969},[],"/docs/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3640":73353,"_31229":73343,"_5":31564,"_21648":121971,"_28426":121972,"_3090":121973},[],"/docs/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3640":73354,"_31229":73343,"_5":31564,"_21648":121975,"_28426":121976,"_3090":121977},[],"/docs/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3640":73355,"_31229":73343,"_5":31564,"_21648":121979,"_28426":121980,"_3090":121981},[],"/docs/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3640":73356,"_31229":73343,"_5":31564,"_21648":121983,"_28426":121984,"_3090":121985},[],"/docs/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3640":73357,"_31229":73343,"_5":31564,"_21648":121987,"_28426":121988,"_3090":121989},[],"/docs/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3640":73358,"_31229":73343,"_21648":121991,"_5":14899,"_28426":73343,"_3090":121992},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3640":73359,"_31229":73343,"_21648":121994,"_5":14899,"_28426":121944,"_3090":121995},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3640":73360,"_31229":73343,"_21648":121997,"_5":14899,"_28426":121948,"_3090":121998},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3640":73361,"_31229":73343,"_21648":122000,"_5":14899,"_28426":121952,"_3090":122001},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3640":73362,"_31229":73343,"_21648":122003,"_5":14899,"_28426":121956,"_3090":122004},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3640":73363,"_31229":73343,"_21648":122006,"_5":14899,"_28426":121960,"_3090":122007},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3640":73364,"_31229":73343,"_21648":122009,"_5":14899,"_28426":121964,"_3090":122010},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3640":73365,"_31229":73343,"_21648":122012,"_5":14899,"_28426":121964,"_3090":122013},[],"Ejecuta también la prueba de conectividad del chart:",{"_3640":73366,"_31229":73343,"_21648":122015,"_5":14899,"_28426":121964,"_3090":122016},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3640":73367,"_31229":73343,"_21648":122018,"_5":14899,"_28426":121964,"_3090":122019},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3640":73368,"_31229":73343,"_21648":122021,"_5":14899,"_28426":121968,"_3090":122022},[],"Si recibes un 401:",{"_3640":73369,"_31229":73343,"_21648":122024,"_5":14899,"_28426":121968,"_3090":122025},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3640":73370,"_31229":73343,"_21648":122027,"_5":14899,"_28426":121968,"_3090":122028},[],"verifica emisor, audiencia y expiración del token;",{"_3640":73371,"_31229":73343,"_21648":122030,"_5":14899,"_28426":121968,"_3090":122031},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3640":73372,"_31229":73343,"_21648":122033,"_5":14899,"_28426":121968,"_3090":122034},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3640":73373,"_31229":73343,"_21648":122036,"_5":14899,"_28426":121968,"_3090":122037},[],"Si el login termina pero las APIs devuelven 403:",{"_3640":73374,"_31229":73343,"_21648":122039,"_5":14899,"_28426":121968,"_3090":122040},[],"inspecciona los claims reales del token;",{"_3640":73375,"_31229":73343,"_21648":122042,"_5":14899,"_28426":121968,"_3090":122043},[],"confirma que coinciden con un principal activo;",{"_3640":73376,"_31229":73343,"_21648":122045,"_5":14899,"_28426":121968,"_3090":122046},[],"revisa las políticas concedidas al principal;",{"_3640":73377,"_31229":73343,"_21648":122048,"_5":14899,"_28426":121968,"_3090":122049},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3640":73378,"_31229":73343,"_21648":122051,"_5":14899,"_28426":121968,"_3090":122052},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3640":73379,"_31229":73343,"_21648":122054,"_5":14899,"_28426":121972,"_3090":122055},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3640":73380,"_31229":73343,"_21648":122057,"_5":14899,"_28426":121972,"_3090":122058},[],"Localiza el pod y Service de authz.",{"_3640":73381,"_31229":73343,"_21648":122060,"_5":14899,"_28426":121972,"_3090":122061},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3640":73382,"_31229":73343,"_21648":122063,"_5":14899,"_28426":121972,"_3090":122064},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3640":73383,"_31229":73343,"_21648":122066,"_5":14899,"_28426":121972,"_3090":122067},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3640":73384,"_31229":73343,"_21648":122069,"_5":14899,"_28426":121972,"_3090":122070},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3640":73385,"_31229":73343,"_21648":122072,"_5":14899,"_28426":121976,"_3090":122073},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3640":73386,"_31229":73343,"_21648":122075,"_5":14899,"_28426":121980,"_3090":122076},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3640":73387,"_31229":73343,"_21648":122078,"_5":14899,"_28426":121980,"_3090":122079},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3640":73388,"_31229":73343,"_21648":122081,"_5":14899,"_28426":121980,"_3090":122082},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3640":73389,"_31229":73343,"_21648":122084,"_5":14899,"_28426":121980,"_3090":122085},[],"volumen persistente sin enlazar;",{"_3640":73390,"_31229":73343,"_21648":122087,"_5":14899,"_28426":121980,"_3090":122088},[],"imagen inaccesible o política de pull incorrecta;",{"_3640":73391,"_31229":73343,"_21648":122090,"_5":14899,"_28426":121980,"_3090":122091},[],"configuración inválida del motor criptográfico;",{"_3640":73392,"_31229":73343,"_21648":122093,"_5":14899,"_28426":121980,"_3090":122094},[],"límites de CPU o memoria demasiado bajos;",{"_3640":73393,"_31229":73343,"_21648":122096,"_5":14899,"_28426":121980,"_3090":122097},[],"migración previa incompleta.",{"_3640":73394,"_31229":73343,"_21648":122099,"_5":14899,"_28426":121980,"_3090":122100},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3640":73395,"_31229":73343,"_21648":122102,"_5":14899,"_28426":121980,"_3090":122103},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3640":73396,"_31229":73343,"_21648":122105,"_5":14899,"_28426":121980,"_3090":122106},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3640":73397,"_31229":73343,"_21648":122108,"_5":14899,"_28426":121984,"_3090":122109},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3640":73398,"_31229":73343,"_21648":122111,"_5":14899,"_28426":121984,"_3090":122112},[],"verifica que esté habilitado en el servicio emisor;",{"_3640":73399,"_31229":73343,"_21648":122114,"_5":14899,"_28426":121984,"_3090":122115},[],"comprueba conectividad y credenciales AMQP;",{"_3640":73400,"_31229":73343,"_21648":122117,"_5":14899,"_28426":121984,"_3090":122118},[],"revisa exchange, routing key, colas y consumidores;",{"_3640":73401,"_31229":73343,"_21648":122120,"_5":14899,"_28426":121984,"_3090":122121},[],"inspecciona dead-letter queues;",{"_3640":73402,"_31229":73343,"_21648":122123,"_5":14899,"_28426":121984,"_3090":122124},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3640":73403,"_31229":73343,"_21648":122126,"_5":14899,"_28426":121984,"_3090":122127},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3640":73404,"_31229":73343,"_21648":122129,"_5":14899,"_28426":121984,"_3090":122130},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3640":73405,"_31229":73343,"_21648":122132,"_5":14899,"_28426":121984,"_3090":122133},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3640":73406,"_31229":73343,"_21648":122135,"_5":14899,"_28426":121984,"_3090":122136},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3640":73407,"_31229":73343,"_21648":122138,"_5":14899,"_28426":121984,"_3090":122139},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3640":73408,"_31229":73343,"_21648":122141,"_5":14899,"_28426":121984,"_3090":122142},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3640":73409,"_31229":73343,"_21648":122144,"_5":14899,"_28426":121984,"_3090":122145},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3640":73410,"_31229":73343,"_21648":122147,"_5":14899,"_28426":121988,"_3090":122148},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3640":73411,"_31229":73343,"_21648":122150,"_5":14899,"_28426":121988,"_3090":122151},[],"Antes de cerrar una incidencia, guarda:",{"_3640":73412,"_31229":73343,"_21648":122153,"_5":14899,"_28426":121988,"_3090":122154},[],"causa confirmada;",{"_3640":73413,"_31229":73343,"_21648":122156,"_5":14899,"_28426":121988,"_3090":122157},[],"alcance temporal y recursos afectados;",{"_3640":73414,"_31229":73343,"_21648":122159,"_5":14899,"_28426":121988,"_3090":122160},[],"comandos o consultas utilizados;",{"_3640":73415,"_31229":73343,"_21648":122162,"_5":14899,"_28426":121988,"_3090":122163},[],"cambio aplicado y forma de revertirlo;",{"_3640":73416,"_31229":73343,"_21648":122165,"_5":14899,"_28426":121988,"_3090":122166},[],"validación desde un consumidor;",{"_3640":73417,"_31229":73343,"_21648":122168,"_5":14899,"_28426":121988,"_3090":122169},[],"acción preventiva y propietario.",{"_3640":73418,"_31229":73418,"_5":15259,"_3090":122171,"_31567":122172,"_21648":122176,"_28426":73418},"Modelo de datos",[51054,122173,122174,122175],"Plataforma","Administración","Control de acceso",[],{"_3640":73419,"_31229":73418,"_21648":122178,"_5":14899,"_28426":73418,"_3090":122179},[],"Entidades y relaciones del esquema pki.json que utiliza authz para evaluar políticas de acceso.",{"_3640":73420,"_31229":73418,"_5":31564,"_21648":122181,"_28426":122182,"_3090":122183},[],"/docs/es/platform/administration/access-control/data-model#relaciones-del-esquema","Relaciones del esquema",{"_3640":73421,"_31229":73418,"_5":31564,"_21648":122185,"_28426":122186,"_3090":122187},[],"/docs/es/platform/administration/access-control/data-model#entidades-del-esquema","Entidades del esquema",{"_3640":73422,"_31229":73418,"_21648":122189,"_5":14899,"_28426":73418,"_3090":122190},[],"El esquema `connectors/authz/pki.json` define las entidades del dominio `pki` para el control de acceso. Una política identifica el tipo de recurso mediante `namespace: pki`, `schema_name` y `entity_type`. Por ejemplo, `ca.certificate` corresponde al esquema `ca` y al tipo de entidad `certificate`.",{"_3640":73423,"_31229":73418,"_21648":122192,"_5":14899,"_28426":122182,"_3090":122193},[],"Cada flecha sale de la entidad que declara la relación y apunta a su `target_entity`. Debajo de la etiqueta aparece el valor de `foreign_key`, la columna de origen. En `pki.json`, el `name` de cada relación coincide con esa columna. El diagrama se puede pulsar para ampliarlo y recorrerlo.",{"_3640":73424,"_31229":73418,"_21648":122195,"_5":14899,"_28426":122182,"_3090":122196},[],"Una política puede propagar acciones desde la entidad referenciada hacia la que declara la relación. Por ejemplo, para conceder lectura de los dispositivos de un DMS, la regla parte de `dmsmanager.dms`, apunta a `devicemanager.device` y especifica `via: dms_owner`.",{"_3640":73425,"_31229":73418,"_21648":122198,"_5":14899,"_28426":122182,"_3090":122199},[],"En los filtros de acceso heredado, `authz` compara la columna `foreign_key` con la primera columna de `primary_key` de la entidad referenciada. Así, `subject_common_name` se compara con `device.id`, `issuer_meta_serial_number` con `ca_certificate.id` y los enlaces hacia `kms_key` con `kms_key.key_id`.",{"_3640":73426,"_31229":73418,"_21648":122201,"_5":14899,"_28426":122186,"_3090":122202},[],"Entidad (`schema_name.entity_type`)",{"_3640":73427,"_31229":73418,"_21648":122204,"_5":14899,"_28426":122186,"_3090":122205},[],"Tabla (`table_name`)",{"_3640":73428,"_31229":73418,"_21648":122207,"_5":14899,"_28426":122186,"_3090":122208},[],"Clave (`primary_key`)",{"_3640":73429,"_31229":73418,"_21648":122210,"_5":14899,"_28426":122186,"_3090":52620},[],{"_3640":73430,"_31229":73418,"_21648":122212,"_5":14899,"_28426":122186,"_3090":52623},[],{"_3640":73431,"_31229":73418,"_21648":122214,"_5":14899,"_28426":122186,"_3090":52626},[],{"_3640":73432,"_31229":73418,"_21648":122216,"_5":14899,"_28426":122186,"_3090":52629},[],{"_3640":73433,"_31229":73418,"_21648":122218,"_5":14899,"_28426":122186,"_3090":52632},[],{"_3640":73434,"_31229":73418,"_21648":122220,"_5":14899,"_28426":122186,"_3090":52635},[],{"_3640":73435,"_31229":73418,"_21648":122222,"_5":14899,"_28426":122186,"_3090":52638},[],{"_3640":73436,"_31229":73418,"_21648":122224,"_5":14899,"_28426":122186,"_3090":52641},[],{"_3640":73437,"_31229":73418,"_21648":122226,"_5":14899,"_28426":122186,"_3090":52635},[],{"_3640":73438,"_31229":73418,"_21648":122228,"_5":14899,"_28426":122186,"_3090":52646},[],{"_3640":73439,"_31229":73418,"_21648":122230,"_5":14899,"_28426":122186,"_3090":52649},[],{"_3640":73440,"_31229":73418,"_21648":122232,"_5":14899,"_28426":122186,"_3090":52652},[],{"_3640":73441,"_31229":73418,"_21648":122234,"_5":14899,"_28426":122186,"_3090":52655},[],{"_3640":73442,"_31229":73418,"_21648":122236,"_5":14899,"_28426":122186,"_3090":52658},[],{"_3640":73443,"_31229":73418,"_21648":122238,"_5":14899,"_28426":122186,"_3090":52635},[],{"_3640":73444,"_31229":73418,"_21648":122240,"_5":14899,"_28426":122186,"_3090":52663},[],{"_3640":73445,"_31229":73418,"_21648":122242,"_5":14899,"_28426":122186,"_3090":52666},[],{"_3640":73446,"_31229":73418,"_21648":122244,"_5":14899,"_28426":122186,"_3090":52635},[],{"_3640":73447,"_31229":73418,"_21648":122246,"_5":14899,"_28426":122186,"_3090":52671},[],{"_3640":73448,"_31229":73418,"_21648":122248,"_5":14899,"_28426":122186,"_3090":52674},[],{"_3640":73449,"_31229":73418,"_21648":122250,"_5":14899,"_28426":122186,"_3090":52635},[],{"_3640":73450,"_31229":73418,"_21648":122252,"_5":14899,"_28426":122186,"_3090":52679},[],{"_3640":73451,"_31229":73418,"_21648":122254,"_5":14899,"_28426":122186,"_3090":52682},[],{"_3640":73452,"_31229":73418,"_21648":122256,"_5":14899,"_28426":122186,"_3090":52635},[],{"_3640":73453,"_31229":73418,"_21648":122258,"_5":14899,"_28426":122186,"_3090":52687},[],{"_3640":73454,"_31229":73418,"_21648":122260,"_5":14899,"_28426":122186,"_3090":52690},[],{"_3640":73455,"_31229":73418,"_21648":122262,"_5":14899,"_28426":122186,"_3090":52693},[],{"_3640":73456,"_31229":73418,"_21648":122264,"_5":14899,"_28426":122186,"_3090":52696},[],{"_3640":73457,"_31229":73418,"_21648":122266,"_5":14899,"_28426":122186,"_3090":52699},[],{"_3640":73458,"_31229":73418,"_21648":122268,"_5":14899,"_28426":122186,"_3090":52702},[],{"_3640":73459,"_31229":73418,"_21648":122270,"_5":14899,"_28426":122186,"_3090":122271},[],"Los eventos, las suscripciones y los grupos de dispositivos tienen acciones y filtros propios. Sus listas `relations` están vacías y tienen cero referencias entrantes en el esquema. Para `ca.certificate`, `view_tables` también registra `certificates_view`.",{"_3640":73460,"_31229":73418,"_21648":122273,"_5":14899,"_28426":122186,"_3090":122274},[],"Cada entidad declara sus acciones sobre instancias en `atomic_actions`, sus acciones sin identificador de recurso en `global_actions` y las columnas y tipos que admite en `column_filters` mediante `filterable`.",{"_3640":73461,"_31229":73418,"_21648":122276,"_5":14899,"_28426":122186,"_3090":122277},[],"<Card title=\"Acceso heredado por relaciones\" href=\"/docs/platform/administration/access-control#acceso-heredado-por-relaciones\" />",{"_3640":73462,"_31229":73462,"_5":15259,"_3090":122279,"_31567":122280,"_21648":122281,"_28426":73462},"Visión general del control de acceso",[51054,122173,122174,122175],[],{"_3640":73463,"_31229":73462,"_21648":122283,"_5":14899,"_28426":73462,"_3090":122284},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3640":73464,"_31229":73462,"_5":31564,"_21648":122286,"_28426":122287,"_3090":122288},[],"/docs/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3640":73465,"_31229":73462,"_5":31564,"_21648":122290,"_28426":122291,"_3090":122292},[],"/docs/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3640":73466,"_31229":73462,"_5":31564,"_21648":122294,"_28426":122295,"_3090":122296},[],"/docs/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3640":73467,"_31229":73462,"_5":31564,"_21648":122298,"_28426":122299,"_3090":122300},[],"/docs/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3640":73468,"_31229":73462,"_5":31564,"_21648":122302,"_28426":122303,"_3090":122304},[],"/docs/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3640":73469,"_31229":73462,"_5":31564,"_21648":122306,"_28426":122307,"_3090":122308},[],"/docs/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3640":73470,"_31229":73462,"_5":31564,"_21648":122310,"_28426":122311,"_3090":122312},[],"/docs/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3640":73471,"_31229":73462,"_5":31564,"_21648":122314,"_28426":122315,"_3090":122316},[],"/docs/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3640":73472,"_31229":73462,"_5":31564,"_21648":122318,"_28426":122319,"_3090":122320},[],"/docs/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3640":73473,"_31229":73462,"_5":31564,"_21648":122322,"_28426":122323,"_3090":122324},[],"/docs/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3640":73474,"_31229":73462,"_5":31564,"_21648":122326,"_28426":122327,"_3090":122328},[],"/docs/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3640":73475,"_31229":73462,"_5":31564,"_21648":122330,"_28426":122331,"_3090":122332},[],"/docs/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3640":73476,"_31229":73462,"_5":31564,"_21648":122334,"_28426":122335,"_3090":122336},[],"/docs/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3640":73477,"_31229":73462,"_5":31564,"_21648":122338,"_28426":122339,"_3090":122340},[],"/docs/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3640":73478,"_31229":73462,"_5":31564,"_21648":122342,"_28426":122343,"_3090":122344},[],"/docs/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3640":73479,"_31229":73462,"_5":31564,"_21648":122346,"_28426":122347,"_3090":121298},[],"/docs/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3640":73480,"_31229":73462,"_5":31564,"_21648":122349,"_28426":122350,"_3090":122351},[],"/docs/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3640":73481,"_31229":73462,"_5":31564,"_21648":122353,"_28426":122354,"_3090":122355},[],"/docs/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3640":73482,"_31229":73462,"_5":31564,"_21648":122357,"_28426":122358,"_3090":122359},[],"/docs/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3640":73483,"_31229":73462,"_5":31564,"_21648":122361,"_28426":122362,"_3090":122363},[],"/docs/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3640":73484,"_31229":73462,"_5":31564,"_21648":122365,"_28426":122366,"_3090":122367},[],"/docs/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3640":73485,"_31229":73462,"_5":31564,"_21648":122369,"_28426":122370,"_3090":122371},[],"/docs/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3640":73486,"_31229":73462,"_5":31564,"_21648":122373,"_28426":122374,"_3090":122375},[],"/docs/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3640":73487,"_31229":73462,"_5":31564,"_21648":122377,"_28426":122378,"_3090":122379},[],"/docs/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3640":73488,"_31229":73462,"_5":31564,"_21648":122381,"_28426":122382,"_3090":122383},[],"/docs/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3640":73489,"_31229":73462,"_5":31564,"_21648":122385,"_28426":122386,"_3090":122387},[],"/docs/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3640":73490,"_31229":73462,"_5":31564,"_21648":122389,"_28426":122390,"_3090":122391},[],"/docs/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3640":73491,"_31229":73462,"_5":31564,"_21648":122393,"_28426":122394,"_3090":122395},[],"/docs/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3640":73492,"_31229":73462,"_5":31564,"_21648":122397,"_28426":122398,"_3090":122399},[],"/docs/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3640":73493,"_31229":73462,"_5":31564,"_21648":122401,"_28426":122402,"_3090":122403},[],"/docs/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3640":73494,"_31229":73462,"_5":31564,"_21648":122405,"_28426":122406,"_3090":122407},[],"/docs/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3640":73495,"_31229":73462,"_21648":122409,"_5":14899,"_28426":73462,"_3090":122410},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3640":73496,"_31229":73462,"_21648":122412,"_5":14899,"_28426":73462,"_3090":122413},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3640":73497,"_31229":73462,"_21648":122415,"_5":14899,"_28426":73462,"_3090":122416},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3640":73498,"_31229":73462,"_21648":122418,"_5":14899,"_28426":122287,"_3090":122419},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3640":73499,"_31229":73462,"_21648":122421,"_5":14899,"_28426":122287,"_3090":122422},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3640":73500,"_31229":73462,"_21648":122424,"_5":14899,"_28426":122287,"_3090":122425},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3640":73501,"_31229":73462,"_21648":122427,"_5":14899,"_28426":122287,"_3090":122428},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3640":73502,"_31229":73462,"_21648":122430,"_5":14899,"_28426":122287,"_3090":122431},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3640":73503,"_31229":73462,"_21648":122433,"_5":14899,"_28426":122287,"_3090":122434},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3640":73504,"_31229":73462,"_21648":122436,"_5":14899,"_28426":122291,"_3090":122437},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3640":73505,"_31229":73462,"_21648":122439,"_5":14899,"_28426":122291,"_3090":122440},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3640":73506,"_31229":73462,"_21648":122442,"_5":14899,"_28426":122295,"_3090":122443},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3640":73507,"_31229":73462,"_21648":122445,"_5":14899,"_28426":122295,"_3090":122446},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3640":73508,"_31229":73462,"_21648":122448,"_5":14899,"_28426":122295,"_3090":122449},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3640":73509,"_31229":73462,"_21648":122451,"_5":14899,"_28426":122295,"_3090":122452},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3640":73510,"_31229":73462,"_21648":122454,"_5":14899,"_28426":122295,"_3090":122455},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3640":73511,"_31229":73462,"_21648":122457,"_5":14899,"_28426":122295,"_3090":122458},[],"Carga por separado las políticas concedidas a cada principal.",{"_3640":73512,"_31229":73462,"_21648":122460,"_5":14899,"_28426":122295,"_3090":122461},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3640":73513,"_31229":73462,"_21648":122463,"_5":14899,"_28426":122295,"_3090":122464},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3640":73514,"_31229":73462,"_21648":122466,"_5":14899,"_28426":122295,"_3090":122467},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3640":73515,"_31229":73462,"_21648":122469,"_5":14899,"_28426":122295,"_3090":122470},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3640":73516,"_31229":73462,"_21648":122472,"_5":14899,"_28426":122295,"_3090":122473},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3640":73517,"_31229":73462,"_21648":122475,"_5":14899,"_28426":122295,"_3090":122476},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3640":73518,"_31229":73462,"_21648":122478,"_5":14899,"_28426":122299,"_3090":122479},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3640":73519,"_31229":73462,"_21648":122481,"_5":14899,"_28426":122299,"_3090":122482},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3640":73520,"_31229":73462,"_21648":122484,"_5":14899,"_28426":122299,"_3090":122485},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3640":73521,"_31229":73462,"_21648":122487,"_5":14899,"_28426":122299,"_3090":122488},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3640":73522,"_31229":73462,"_21648":122490,"_5":14899,"_28426":122299,"_3090":122491},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3640":73523,"_31229":73462,"_21648":122493,"_5":14899,"_28426":122299,"_3090":122494},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3640":73524,"_31229":73462,"_21648":122496,"_5":14899,"_28426":122299,"_3090":122497},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3640":73525,"_31229":73462,"_21648":122499,"_5":14899,"_28426":122299,"_3090":122500},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3640":73526,"_31229":73462,"_21648":122502,"_5":14899,"_28426":122299,"_3090":122503},[],"Un esquema también puede hacer que una ruta individual acepte la credencial por la URL. **`query_token: true` en una ruta** hace que acepte el token de acceso OIDC del parámetro de consulta `access_token`, pero solo cuando la petición no lleva ni una cabecera `Authorization: Bearer` ni una cabecera de certificado de cliente: la credencial en una cabecera siempre prevalece. El token se valida y autoriza exactamente igual que un token Bearer, así que la acción de la ruta sigue exigiendo un grant, y las rutas que no activan esta opción nunca leen el parámetro de consulta. La terminal experimental del dashboard usa este mecanismo, porque la conexión WebSocket que abre su cliente de navegador no puede establecer cabeceras de petición.",{"_3640":73527,"_31229":73462,"_21648":122505,"_5":14899,"_28426":122299,"_3090":122506},[],"Las cadenas de consulta suelen quedar registradas. `authz` sustituye el valor de `access_token` por `REDACTED` en sus propios logs de decisión, pero otros logs que capturan la URL —el access log del Gateway, los logs de petición de los servicios, el tracing— no la redactan. Reserva `query_token` para rutas WebSocket y tokens de corta duración.",{"_3640":73528,"_31229":73462,"_21648":122508,"_5":14899,"_28426":122303,"_3090":122509},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3640":73529,"_31229":73462,"_21648":122511,"_5":14899,"_28426":122303,"_3090":122512},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3640":73530,"_31229":73462,"_21648":122514,"_5":14899,"_28426":122303,"_3090":122515},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3640":73531,"_31229":73462,"_21648":122517,"_5":14899,"_28426":122303,"_3090":122518},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3640":73532,"_31229":73462,"_21648":122520,"_5":14899,"_28426":122303,"_3090":122521},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3640":73533,"_31229":73462,"_21648":122523,"_5":14899,"_28426":122303,"_3090":122524},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3640":73534,"_31229":73462,"_21648":122526,"_5":14899,"_28426":122303,"_3090":122527},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3640":73535,"_31229":73462,"_21648":122529,"_5":14899,"_28426":122303,"_3090":122530},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3640":73536,"_31229":73462,"_21648":122532,"_5":14899,"_28426":122303,"_3090":122533},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3640":73537,"_31229":73462,"_21648":122535,"_5":14899,"_28426":122303,"_3090":122536},[],"Las acciones se dividen en dos grupos:",{"_3640":73538,"_31229":73462,"_21648":122538,"_5":14899,"_28426":122303,"_3090":122539},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3640":73539,"_31229":73462,"_21648":122541,"_5":14899,"_28426":122303,"_3090":122542},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3640":73540,"_31229":73462,"_21648":122544,"_5":14899,"_28426":122303,"_3090":122545},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3640":73541,"_31229":73462,"_21648":122547,"_5":14899,"_28426":122307,"_3090":122548},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3640":73542,"_31229":73462,"_21648":122550,"_5":14899,"_28426":122307,"_3090":122551},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3640":73543,"_31229":73462,"_21648":122553,"_5":14899,"_28426":122307,"_3090":122554},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3640":73544,"_31229":73462,"_21648":122556,"_5":14899,"_28426":122311,"_3090":122557},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3640":73545,"_31229":73462,"_21648":122559,"_5":14899,"_28426":122311,"_3090":122560},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3640":73546,"_31229":73462,"_21648":122562,"_5":14899,"_28426":122311,"_3090":122563},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3640":73547,"_31229":73462,"_21648":122565,"_5":14899,"_28426":122311,"_3090":122566},[],"Los operadores implementados son:",{"_3640":73548,"_31229":73462,"_21648":122568,"_5":14899,"_28426":122311,"_3090":122569},[],"`equals`, para igualdad exacta;",{"_3640":73549,"_31229":73462,"_21648":122571,"_5":14899,"_28426":122311,"_3090":122572},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3640":73550,"_31229":73462,"_21648":122574,"_5":14899,"_28426":122311,"_3090":122575},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3640":73551,"_31229":73462,"_21648":122577,"_5":14899,"_28426":122311,"_3090":122578},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3640":73552,"_31229":73462,"_21648":122580,"_5":14899,"_28426":122315,"_3090":122581},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3640":73553,"_31229":73462,"_21648":122583,"_5":14899,"_28426":122315,"_3090":122584},[],"Los modos disponibles son:",{"_3640":73554,"_31229":73462,"_21648":122586,"_5":14899,"_28426":122315,"_3090":122587},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3640":73555,"_31229":73462,"_21648":122589,"_5":14899,"_28426":122315,"_3090":122590},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3640":73556,"_31229":73462,"_21648":122592,"_5":14899,"_28426":122315,"_3090":122593},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3640":73557,"_31229":73462,"_21648":122595,"_5":14899,"_28426":122315,"_3090":122596},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3640":73558,"_31229":73462,"_21648":122598,"_5":14899,"_28426":122315,"_3090":122599},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3640":73559,"_31229":73462,"_21648":122601,"_5":14899,"_28426":122315,"_3090":122602},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3640":73560,"_31229":73462,"_21648":122604,"_5":14899,"_28426":122319,"_3090":122605},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3640":73561,"_31229":73462,"_21648":122607,"_5":14899,"_28426":122319,"_3090":122608},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3640":73562,"_31229":73462,"_21648":122610,"_5":14899,"_28426":122319,"_3090":122611},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3640":73563,"_31229":73462,"_21648":122613,"_5":14899,"_28426":122319,"_3090":122614},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3640":73564,"_31229":73462,"_21648":122616,"_5":14899,"_28426":122327,"_3090":122617},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3640":73565,"_31229":73462,"_21648":122619,"_5":14899,"_28426":122327,"_3090":122620},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3640":73566,"_31229":73462,"_21648":122622,"_5":14899,"_28426":122331,"_3090":122623},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3640":73567,"_31229":73462,"_21648":122625,"_5":14899,"_28426":122331,"_3090":122626},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3640":73568,"_31229":73462,"_21648":122628,"_5":14899,"_28426":122331,"_3090":122629},[],"El modelo de datos muestra cómo se conectan los recursos sobre los que se aplican las reglas de entidad.",{"_3640":73569,"_31229":73462,"_21648":122631,"_5":14899,"_28426":122331,"_3090":122632},[],"Una regla solo puede seguir relaciones que el esquema de datos declare entre sus dos entidades. Puedes referenciar la relación por su nombre o por su columna de clave foránea —ambas formas son equivalentes— y es el esquema el que decide qué columna utiliza la consulta. Al guardar una política, `authz` comprueba cada relación contra los esquemas cargados: una que ningún esquema declare, o que apunte a una entidad no cargada, se rechaza en ese momento.",{"_3640":73570,"_31229":73462,"_21648":122634,"_5":14899,"_28426":122331,"_3090":122635},[],"Las políticas almacenadas antes de esta validación pueden contener todavía relaciones que los esquemas no declaran. Esa relación no concede nada: `authz` registra una advertencia, `skipping relation that grants nothing`, indicando la política y la relación, y continúa evaluando el resto de la política. La referencia siempre se resuelve contra el esquema antes de construir cualquier consulta, por lo que una relación no declarada nunca puede alterarla. Si el acceso heredado se reduce tras una actualización, busca esta advertencia en los logs de `authz` y corrige la relación de la política afectada.",{"_3640":73571,"_31229":73462,"_21648":122637,"_5":14899,"_28426":122335,"_3090":122638},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3640":73572,"_31229":73462,"_21648":122640,"_5":14899,"_28426":122335,"_3090":122641},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3640":73573,"_31229":73462,"_21648":122643,"_5":14899,"_28426":122335,"_3090":122644},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3640":73574,"_31229":73462,"_21648":122646,"_5":14899,"_28426":122339,"_3090":122647},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3640":73575,"_31229":73462,"_21648":122649,"_5":14899,"_28426":122339,"_3090":122650},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3640":73576,"_31229":73462,"_21648":122652,"_5":14899,"_28426":122339,"_3090":122653},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3640":73577,"_31229":73462,"_21648":122655,"_5":14899,"_28426":122339,"_3090":122656},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3640":73578,"_31229":73462,"_21648":122658,"_5":14899,"_28426":122339,"_3090":122659},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3640":73579,"_31229":73462,"_21648":122661,"_5":14899,"_28426":122339,"_3090":122662},[],"Ten en cuenta que:",{"_3640":73580,"_31229":73462,"_21648":122664,"_5":14899,"_28426":122339,"_3090":122665},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3640":73581,"_31229":73462,"_21648":122667,"_5":14899,"_28426":122339,"_3090":122668},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3640":73582,"_31229":73462,"_21648":122670,"_5":14899,"_28426":122339,"_3090":122671},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3640":73583,"_31229":73462,"_21648":122673,"_5":14899,"_28426":122343,"_3090":122674},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3640":73584,"_31229":73462,"_21648":122676,"_5":14899,"_28426":122343,"_3090":122677},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3640":73585,"_31229":73462,"_21648":122679,"_5":14899,"_28426":122343,"_3090":122680},[],"acceso completo y de solo lectura a KMS;",{"_3640":73586,"_31229":73462,"_21648":122682,"_5":14899,"_28426":122343,"_3090":122683},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3640":73587,"_31229":73462,"_21648":122685,"_5":14899,"_28426":122343,"_3090":122686},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3640":73588,"_31229":73462,"_21648":122688,"_5":14899,"_28426":122343,"_3090":122689},[],"acceso a la interfaz;",{"_3640":73589,"_31229":73462,"_21648":122691,"_5":14899,"_28426":122343,"_3090":122692},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3640":73590,"_31229":73462,"_21648":122694,"_5":14899,"_28426":122343,"_3090":122695},[],"acceso a la terminal experimental del dashboard (Terminal Network);",{"_3640":73591,"_31229":73462,"_21648":122697,"_5":14899,"_28426":122343,"_3090":122698},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3640":73592,"_31229":73462,"_21648":122700,"_5":14899,"_28426":122343,"_3090":122701},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3640":73593,"_31229":73462,"_21648":122703,"_5":14899,"_28426":122343,"_3090":122704},[],"La política de Terminal Network la crea la precarga de `authz` la próxima vez que `authz` arranque tras la actualización. Las políticas precargadas son políticas del sistema —sus identificadores empiezan por `lamassu.`— y no se pueden editar a través de la API.",{"_3640":73594,"_31229":73462,"_21648":122706,"_5":14899,"_28426":122347,"_3090":122707},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3640":73595,"_31229":73462,"_21648":122709,"_5":14899,"_28426":122347,"_3090":122710},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3640":73596,"_31229":73462,"_21648":122712,"_5":14899,"_28426":122347,"_3090":122713},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3640":73597,"_31229":73462,"_21648":122715,"_5":14899,"_28426":122350,"_3090":122716},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3640":73598,"_31229":73462,"_21648":122718,"_5":14899,"_28426":122354,"_3090":122719},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3640":73599,"_31229":73462,"_21648":122721,"_5":14899,"_28426":122354,"_3090":122722},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3640":73600,"_31229":73462,"_21648":122724,"_5":14899,"_28426":122358,"_3090":122725},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3640":73601,"_31229":73462,"_21648":122727,"_5":14899,"_28426":122362,"_3090":122728},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3640":73602,"_31229":73462,"_21648":122730,"_5":14899,"_28426":122366,"_3090":122731},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3640":73603,"_31229":73462,"_21648":122733,"_5":14899,"_28426":122370,"_3090":122734},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3640":73604,"_31229":73462,"_21648":122736,"_5":14899,"_28426":122370,"_3090":122737},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3640":73605,"_31229":73462,"_21648":122739,"_5":14899,"_28426":122374,"_3090":122740},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3640":73606,"_31229":73462,"_21648":122742,"_5":14899,"_28426":122374,"_3090":122743},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3640":73607,"_31229":73462,"_21648":122745,"_5":14899,"_28426":122374,"_3090":122746},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3640":73608,"_31229":73462,"_21648":122748,"_5":14899,"_28426":122374,"_3090":122749},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3640":73609,"_31229":73462,"_21648":122751,"_5":14899,"_28426":122374,"_3090":122752},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3640":73610,"_31229":73462,"_21648":122754,"_5":14899,"_28426":122374,"_3090":122755},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3640":73611,"_31229":73462,"_21648":122757,"_5":14899,"_28426":122374,"_3090":122758},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3640":73612,"_31229":73462,"_21648":122760,"_5":14899,"_28426":122374,"_3090":122761},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3640":73613,"_31229":73462,"_21648":122763,"_5":14899,"_28426":122378,"_3090":122764},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3640":73614,"_31229":73462,"_21648":122766,"_5":14899,"_28426":122378,"_3090":122767},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3640":73615,"_31229":73462,"_21648":122769,"_5":14899,"_28426":122378,"_3090":122770},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3640":73616,"_31229":73462,"_21648":122772,"_5":14899,"_28426":122382,"_3090":122773},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3640":73617,"_31229":73462,"_21648":122775,"_5":14899,"_28426":122382,"_3090":122776},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3640":73618,"_31229":73462,"_21648":122778,"_5":14899,"_28426":122382,"_3090":122779},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3640":73619,"_31229":73462,"_21648":122781,"_5":14899,"_28426":122382,"_3090":122782},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3640":73620,"_31229":73462,"_21648":122784,"_5":14899,"_28426":122382,"_3090":122785},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3640":73621,"_31229":73462,"_21648":122787,"_5":14899,"_28426":122382,"_3090":122788},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3640":73622,"_31229":73462,"_21648":122790,"_5":14899,"_28426":122382,"_3090":122791},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3640":73623,"_31229":73462,"_21648":122793,"_5":14899,"_28426":122382,"_3090":122794},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3640":73624,"_31229":73462,"_21648":122796,"_5":14899,"_28426":122390,"_3090":122797},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3640":73625,"_31229":73462,"_21648":122799,"_5":14899,"_28426":122394,"_3090":122800},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3640":73626,"_31229":73462,"_21648":122802,"_5":14899,"_28426":122394,"_3090":122803},[],"que exista un principal activo del tipo correcto;",{"_3640":73627,"_31229":73462,"_21648":122805,"_5":14899,"_28426":122394,"_3090":122806},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3640":73628,"_31229":73462,"_21648":122808,"_5":14899,"_28426":122394,"_3090":122809},[],"que todas las condiciones del principal se cumplan;",{"_3640":73629,"_31229":73462,"_21648":122811,"_5":14899,"_28426":122394,"_3090":122812},[],"que el principal tenga concedida la política esperada;",{"_3640":73630,"_31229":73462,"_21648":122814,"_5":14899,"_28426":122394,"_3090":122815},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3640":73631,"_31229":73462,"_21648":122817,"_5":14899,"_28426":122394,"_3090":122818},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3640":73632,"_31229":73462,"_21648":122820,"_5":14899,"_28426":122394,"_3090":122821},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3640":73633,"_31229":73462,"_21648":122823,"_5":14899,"_28426":122394,"_3090":122824},[],"Si una política que dependía de acceso heredado dejó de concederlo tras una actualización, busca en los logs de `authz` el mensaje `skipping relation that grants nothing`: la advertencia indica la política y la relación que los esquemas ya no declaran. Corrige la relación de esa política para que coincida con los esquemas actuales.",{"_3640":73634,"_31229":73462,"_21648":122826,"_5":14899,"_28426":122398,"_3090":122827},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3640":73635,"_31229":73462,"_21648":122829,"_5":14899,"_28426":122402,"_3090":122830},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3640":73636,"_31229":73462,"_21648":122832,"_5":14899,"_28426":122406,"_3090":122833},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3640":73637,"_31229":73462,"_21648":122835,"_5":14899,"_28426":122406,"_3090":122836},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3640":73638,"_31229":73638,"_5":15259,"_3090":122838,"_31567":122839,"_21648":122840,"_28426":73638},"Alertas y suscripciones",[51054,122173,122174],[],{"_3640":73639,"_31229":73638,"_21648":122842,"_5":14899,"_28426":73638,"_3090":122843},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3640":73640,"_31229":73638,"_5":31564,"_21648":122845,"_28426":122846,"_3090":122847},[],"/docs/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3640":73641,"_31229":73638,"_5":31564,"_21648":122849,"_28426":122850,"_3090":122851},[],"/docs/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3640":73642,"_31229":73638,"_5":31564,"_21648":122853,"_28426":122854,"_3090":122855},[],"/docs/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3640":73643,"_31229":73638,"_5":31564,"_21648":122857,"_28426":122858,"_3090":122859},[],"/docs/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3640":73644,"_31229":73638,"_5":31564,"_21648":122861,"_28426":122862,"_3090":122863},[],"/docs/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3640":73645,"_31229":73638,"_5":31564,"_21648":122865,"_28426":122866,"_3090":122867},[],"/docs/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3640":73646,"_31229":73638,"_5":31564,"_21648":122869,"_28426":122870,"_3090":122871},[],"/docs/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3640":73647,"_31229":73638,"_5":31564,"_21648":122873,"_28426":122874,"_3090":122875},[],"/docs/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3640":73648,"_31229":73638,"_5":31564,"_21648":122877,"_28426":122878,"_3090":122879},[],"/docs/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3640":73649,"_31229":73638,"_5":31564,"_21648":122881,"_28426":122882,"_3090":122883},[],"/docs/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3640":73650,"_31229":73638,"_5":31564,"_21648":122885,"_28426":122886,"_3090":122887},[],"/docs/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3640":73651,"_31229":73638,"_21648":122889,"_5":14899,"_28426":73638,"_3090":122890},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3640":73652,"_31229":73638,"_21648":122892,"_5":14899,"_28426":122846,"_3090":122893},[],"Un servicio publica un evento de dominio.",{"_3640":73653,"_31229":73638,"_21648":122895,"_5":14899,"_28426":122846,"_3090":122896},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3640":73654,"_31229":73638,"_21648":122898,"_5":14899,"_28426":122846,"_3090":122899},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3640":73655,"_31229":73638,"_21648":122901,"_5":14899,"_28426":122846,"_3090":122902},[],"Lamassu entrega el evento al canal configurado.",{"_3640":73656,"_31229":73638,"_21648":122904,"_5":14899,"_28426":122846,"_3090":122905},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3640":73657,"_31229":73638,"_21648":122907,"_5":14899,"_28426":122850,"_3090":122908},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3640":73658,"_31229":73638,"_21648":122910,"_5":14899,"_28426":122850,"_3090":122911},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3640":73659,"_31229":73638,"_21648":122913,"_5":14899,"_28426":122850,"_3090":122914},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3640":73660,"_31229":73638,"_21648":122916,"_5":14899,"_28426":122850,"_3090":122917},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3640":73661,"_31229":73638,"_21648":122919,"_5":14899,"_28426":122850,"_3090":122920},[],"`apikey_options` necesita `header` y `key`.",{"_3640":73662,"_31229":73638,"_21648":122922,"_5":14899,"_28426":122850,"_3090":122923},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3640":73663,"_31229":73638,"_21648":122925,"_5":14899,"_28426":122850,"_3090":122926},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3640":73664,"_31229":73638,"_21648":122928,"_5":14899,"_28426":122850,"_3090":122929},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3640":73665,"_31229":73638,"_21648":122931,"_5":14899,"_28426":122858,"_3090":122932},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3640":73666,"_31229":73638,"_21648":122934,"_5":14899,"_28426":122862,"_3090":122935},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3640":73667,"_31229":73638,"_21648":122937,"_5":14899,"_28426":122866,"_3090":122938},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3640":73668,"_31229":73638,"_21648":122940,"_5":14899,"_28426":122866,"_3090":122941},[],"**None** notifica todas las instancias del evento.",{"_3640":73669,"_31229":73638,"_21648":122943,"_5":14899,"_28426":122866,"_3090":122944},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3640":73670,"_31229":73638,"_21648":122946,"_5":14899,"_28426":122866,"_3090":122947},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3640":73671,"_31229":73638,"_21648":122949,"_5":14899,"_28426":122866,"_3090":122950},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3640":73672,"_31229":73638,"_21648":122952,"_5":14899,"_28426":122866,"_3090":122953},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3640":73673,"_31229":73638,"_21648":122955,"_5":14899,"_28426":122866,"_3090":122956},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3640":73674,"_31229":73638,"_21648":122958,"_5":14899,"_28426":122870,"_3090":122959},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3640":73675,"_31229":73638,"_21648":122961,"_5":14899,"_28426":122874,"_3090":122962},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3640":73676,"_31229":73638,"_21648":122964,"_5":14899,"_28426":122874,"_3090":122965},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3640":73677,"_31229":73638,"_21648":122967,"_5":14899,"_28426":122874,"_3090":122968},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3640":73678,"_31229":73638,"_21648":122970,"_5":14899,"_28426":122874,"_3090":122971},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3640":73679,"_31229":73638,"_21648":122973,"_5":14899,"_28426":122874,"_3090":122974},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3640":73680,"_31229":73638,"_21648":122976,"_5":14899,"_28426":122874,"_3090":122977},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3640":73681,"_31229":73638,"_21648":122979,"_5":14899,"_28426":122874,"_3090":122980},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3640":73682,"_31229":73638,"_21648":122982,"_5":14899,"_28426":122874,"_3090":122983},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3640":73683,"_31229":73638,"_21648":122985,"_5":14899,"_28426":122878,"_3090":122986},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3640":73684,"_31229":73638,"_21648":122988,"_5":14899,"_28426":122878,"_3090":122989},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3640":73685,"_31229":73638,"_21648":122991,"_5":14899,"_28426":122878,"_3090":122992},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3640":73686,"_31229":73638,"_21648":122994,"_5":14899,"_28426":122878,"_3090":122995},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3640":73687,"_31229":73638,"_21648":122997,"_5":14899,"_28426":122878,"_3090":122998},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3640":73688,"_31229":73638,"_21648":123000,"_5":14899,"_28426":122878,"_3090":123001},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3640":73689,"_31229":73638,"_21648":123003,"_5":14899,"_28426":122878,"_3090":123004},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3640":73690,"_31229":73638,"_21648":123006,"_5":14899,"_28426":122878,"_3090":123007},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3640":73691,"_31229":73638,"_21648":123009,"_5":14899,"_28426":122882,"_3090":123010},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3640":73692,"_31229":73638,"_21648":123012,"_5":14899,"_28426":122882,"_3090":123013},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3640":73693,"_31229":73638,"_21648":123015,"_5":14899,"_28426":122886,"_3090":123016},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3640":73694,"_31229":73638,"_21648":123018,"_5":14899,"_28426":122886,"_3090":123019},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3640":73695,"_31229":73638,"_21648":123021,"_5":14899,"_28426":122886,"_3090":123022},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3640":73696,"_31229":73638,"_21648":123024,"_5":14899,"_28426":122886,"_3090":123025},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3640":73697,"_31229":73638,"_21648":123027,"_5":14899,"_28426":122886,"_3090":123028},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3640":73698,"_31229":73638,"_21648":123030,"_5":14899,"_28426":122886,"_3090":123031},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` y `va.crl-settings.delete`.",{"_3640":73699,"_31229":73638,"_21648":123033,"_5":14899,"_28426":122886,"_3090":123034},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3640":73700,"_31229":73638,"_21648":123036,"_5":14899,"_28426":122886,"_3090":123037},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3640":73701,"_31229":73638,"_21648":123039,"_5":14899,"_28426":122886,"_3090":123040},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3640":73702,"_31229":73638,"_21648":123042,"_5":14899,"_28426":122886,"_3090":123043},[],"La VA publica además `va.crl-settings.finalize` cuando una CA se revoca de forma permanente o caduca, `va.crl-settings.archive` cuando la CA se elimina, y `va.crl-settings.delete` cuando se eliminan ajustes archivados.",{"_3640":73703,"_31229":73703,"_5":15259,"_3090":123045,"_31567":123046,"_21648":123047,"_28426":73703},"Registros de auditoría",[51054,122173,122174],[],{"_3640":73704,"_31229":73703,"_21648":123049,"_5":14899,"_28426":73703,"_3090":123050},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3640":73705,"_31229":73703,"_5":31564,"_21648":123052,"_28426":123053,"_3090":123054},[],"/docs/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3640":73706,"_31229":73703,"_5":31564,"_21648":123056,"_28426":123057,"_3090":123058},[],"/docs/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3640":73707,"_31229":73703,"_5":31564,"_21648":123060,"_28426":123061,"_3090":123062},[],"/docs/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3640":73708,"_31229":73703,"_5":31564,"_21648":123064,"_28426":123065,"_3090":123066},[],"/docs/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3640":73709,"_31229":73703,"_5":31564,"_21648":123068,"_28426":123069,"_3090":123070},[],"/docs/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3640":73710,"_31229":73703,"_5":31564,"_21648":123072,"_28426":123073,"_3090":123074},[],"/docs/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3640":73711,"_31229":73703,"_5":31564,"_21648":123076,"_28426":123077,"_3090":123078},[],"/docs/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3640":73712,"_31229":73703,"_5":31564,"_21648":123080,"_28426":123081,"_3090":123082},[],"/docs/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3640":73713,"_31229":73703,"_5":31564,"_21648":123084,"_28426":123085,"_3090":123086},[],"/docs/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3640":73714,"_31229":73703,"_5":31564,"_21648":123088,"_28426":123089,"_3090":123090},[],"/docs/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3640":73715,"_31229":73703,"_5":31564,"_21648":123092,"_28426":123093,"_3090":123094},[],"/docs/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3640":73716,"_31229":73703,"_21648":123096,"_5":14899,"_28426":73703,"_3090":123097},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3640":73717,"_31229":73703,"_21648":123099,"_5":14899,"_28426":123053,"_3090":123100},[],"El cuerpo de auditoría incluye:",{"_3640":73718,"_31229":73703,"_21648":123102,"_5":14899,"_28426":123053,"_3090":123103},[],"input: datos recibidos por la operación;",{"_3640":73719,"_31229":73703,"_21648":123105,"_5":14899,"_28426":123053,"_3090":123106},[],"has\\_error: indica si el servicio devolvió un error;",{"_3640":73720,"_31229":73703,"_21648":123108,"_5":14899,"_28426":123053,"_3090":123109},[],"output: resultado producido o mensaje de error;",{"_3640":73721,"_31229":73703,"_21648":123111,"_5":14899,"_28426":123053,"_3090":123112},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3640":73722,"_31229":73703,"_21648":123114,"_5":14899,"_28426":123053,"_3090":123115},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3640":73723,"_31229":73703,"_21648":123117,"_5":14899,"_28426":123053,"_3090":123118},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3640":73724,"_31229":73703,"_21648":123120,"_5":14899,"_28426":123057,"_3090":123121},[],"El backend aplica auditoría a mutaciones de:",{"_3640":73725,"_31229":73703,"_21648":123123,"_5":14899,"_28426":123057,"_3090":123124},[],"autoridades, certificados y perfiles de emisión;",{"_3640":73726,"_31229":73703,"_21648":123126,"_5":14899,"_28426":123057,"_3090":123127},[],"claves y motores KMS;",{"_3640":73727,"_31229":73703,"_21648":123129,"_5":14899,"_28426":123057,"_3090":123130},[],"dispositivos e identidades;",{"_3640":73728,"_31229":73703,"_21648":123132,"_5":14899,"_28426":123057,"_3090":123133},[],"DMS y operaciones de enrolamiento;",{"_3640":73729,"_31229":73703,"_21648":123135,"_5":14899,"_28426":123057,"_3090":123136},[],"funciones de validación y CRL;",{"_3640":73730,"_31229":73703,"_21648":123138,"_5":14899,"_28426":123057,"_3090":123139},[],"principales, políticas y concesiones de autorización.",{"_3640":73731,"_31229":73703,"_21648":123141,"_5":14899,"_28426":123057,"_3090":123142},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3640":73732,"_31229":73703,"_21648":123144,"_5":14899,"_28426":123061,"_3090":123145},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3640":73733,"_31229":73703,"_21648":123147,"_5":14899,"_28426":123061,"_3090":123148},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3640":73734,"_31229":73703,"_21648":123150,"_5":14899,"_28426":123061,"_3090":123151},[],"Diseña el consumidor para:",{"_3640":73735,"_31229":73703,"_21648":123153,"_5":14899,"_28426":123061,"_3090":123154},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3640":73736,"_31229":73703,"_21648":123156,"_5":14899,"_28426":123061,"_3090":123157},[],"conservar el CloudEvent completo sin modificar;",{"_3640":73737,"_31229":73703,"_21648":123159,"_5":14899,"_28426":123061,"_3090":123160},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3640":73738,"_31229":73703,"_21648":123162,"_5":14899,"_28426":123061,"_3090":123163},[],"cifrar en tránsito y en reposo;",{"_3640":73739,"_31229":73703,"_21648":123165,"_5":14899,"_28426":123061,"_3090":123166},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3640":73740,"_31229":73703,"_21648":123168,"_5":14899,"_28426":123061,"_3090":123169},[],"aplicar una política explícita de retención y legal hold;",{"_3640":73741,"_31229":73703,"_21648":123171,"_5":14899,"_28426":123061,"_3090":123172},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3640":73742,"_31229":73703,"_21648":123174,"_5":14899,"_28426":123065,"_3090":123175},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3640":73743,"_31229":73703,"_21648":123177,"_5":14899,"_28426":123065,"_3090":123178},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3640":73744,"_31229":73703,"_21648":123180,"_5":14899,"_28426":123073,"_3090":123181},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3640":73745,"_31229":73703,"_21648":123183,"_5":14899,"_28426":123077,"_3090":123184},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3640":73746,"_31229":73703,"_21648":123186,"_5":14899,"_28426":123081,"_3090":123187},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3640":73747,"_31229":73703,"_21648":123189,"_5":14899,"_28426":123085,"_3090":123190},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3640":73748,"_31229":73703,"_21648":123192,"_5":14899,"_28426":123089,"_3090":123193},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3640":73749,"_31229":73703,"_21648":123195,"_5":14899,"_28426":123093,"_3090":123196},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3640":73750,"_31229":73703,"_21648":123198,"_5":14899,"_28426":123093,"_3090":123199},[],"aparece un evento de auditoría correcto;",{"_3640":73751,"_31229":73703,"_21648":123201,"_5":14899,"_28426":123093,"_3090":123202},[],"el principal coincide con la identidad utilizada;",{"_3640":73752,"_31229":73703,"_21648":123204,"_5":14899,"_28426":123093,"_3090":123205},[],"el consumidor lo persiste una sola vez;",{"_3640":73753,"_31229":73703,"_21648":123207,"_5":14899,"_28426":123093,"_3090":123208},[],"puede recuperarse por recurso, actor y periodo;",{"_3640":73754,"_31229":73703,"_21648":123210,"_5":14899,"_28426":123093,"_3090":123211},[],"una interrupción del consumidor produce una alerta.",{"_3640":73755,"_31229":73703,"_21648":123213,"_5":14899,"_28426":123093,"_3090":123214},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3640":73756,"_31229":73756,"_5":15259,"_3090":123216,"_31567":123217,"_21648":123218,"_28426":73756},"Arquitectura de la plataforma",[51054,122173],[],{"_3640":73757,"_31229":73756,"_21648":123220,"_5":14899,"_28426":73756,"_3090":123221},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3640":73758,"_31229":73756,"_5":31564,"_21648":123223,"_28426":123224,"_3090":123225},[],"/docs/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3640":73759,"_31229":73756,"_5":31564,"_21648":123227,"_28426":123228,"_3090":123229},[],"/docs/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3640":73760,"_31229":73756,"_5":31564,"_21648":123231,"_28426":123232,"_3090":123233},[],"/docs/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3640":73761,"_31229":73756,"_5":31564,"_21648":123235,"_28426":123236,"_3090":123237},[],"/docs/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3640":73762,"_31229":73756,"_5":31564,"_21648":123239,"_28426":123240,"_3090":123241},[],"/docs/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3640":73763,"_31229":73756,"_21648":123243,"_5":14899,"_28426":73756,"_3090":123244},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3640":73764,"_31229":73756,"_21648":123246,"_5":14899,"_28426":73756,"_3090":123247},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3640":73765,"_31229":73756,"_21648":123249,"_5":14899,"_28426":123224,"_3090":123250},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3640":73766,"_31229":73756,"_21648":123252,"_5":14899,"_28426":123228,"_3090":123253},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3640":73767,"_31229":73756,"_21648":123255,"_5":14899,"_28426":123232,"_3090":123256},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3640":73768,"_31229":73756,"_21648":123258,"_5":14899,"_28426":123236,"_3090":123259},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3640":73769,"_31229":73756,"_21648":123261,"_5":14899,"_28426":123240,"_3090":123262},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3640":73770,"_31229":73770,"_5":15259,"_3090":123264,"_31567":123265,"_21648":123266,"_28426":73770},"Cómo funciona Lamassu",[51054,122173],[],{"_3640":73771,"_31229":73770,"_21648":123268,"_5":14899,"_28426":73770,"_3090":123269},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3640":73772,"_31229":73770,"_5":31564,"_21648":123271,"_28426":123272,"_3090":123273},[],"/docs/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3640":73773,"_31229":73770,"_5":31564,"_21648":123275,"_28426":123276,"_3090":123277},[],"/docs/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3640":73774,"_31229":73770,"_21648":123279,"_5":14899,"_28426":73770,"_3090":123280},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3640":73775,"_31229":73770,"_21648":123282,"_5":14899,"_28426":123272,"_3090":123283},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3640":73776,"_31229":73770,"_21648":123285,"_5":14899,"_28426":123272,"_3090":123286},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3640":73777,"_31229":73770,"_21648":123288,"_5":14899,"_28426":123272,"_3090":123289},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3640":73778,"_31229":73770,"_21648":123291,"_5":14899,"_28426":123272,"_3090":123292},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3640":73779,"_31229":73770,"_21648":123294,"_5":14899,"_28426":123272,"_3090":123295},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3640":73780,"_31229":73770,"_21648":123297,"_5":14899,"_28426":123276,"_3090":123298},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3640":73781,"_31229":73770,"_21648":123300,"_5":14899,"_28426":123276,"_3090":123301},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3640":73782,"_31229":73770,"_21648":123303,"_5":14899,"_28426":123276,"_3090":123304},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3640":73783,"_31229":73770,"_21648":123306,"_5":14899,"_28426":123276,"_3090":123307},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3640":73784,"_31229":73770,"_21648":123309,"_5":14899,"_28426":123276,"_3090":123310},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3640":73785,"_31229":73770,"_21648":123312,"_5":14899,"_28426":123276,"_3090":123313},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3640":73786,"_31229":73770,"_21648":123315,"_5":14899,"_28426":123276,"_3090":123316},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3640":73787,"_31229":73787,"_5":15259,"_3090":123318,"_31567":123319,"_21648":123320,"_28426":73787},"Dispositivos e identidades",[51054,122173,53754,123318],[],{"_3640":73788,"_31229":73787,"_21648":123322,"_5":14899,"_28426":73787,"_3090":123323},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3640":73789,"_31229":73787,"_5":31564,"_21648":123325,"_28426":123326,"_3090":123327},[],"/docs/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3640":73790,"_31229":73787,"_5":31564,"_21648":123329,"_28426":123330,"_3090":123331},[],"/docs/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3640":73791,"_31229":73787,"_5":31564,"_21648":123333,"_28426":123334,"_3090":123335},[],"/docs/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3640":73792,"_31229":73787,"_5":31564,"_21648":123337,"_28426":123338,"_3090":123339},[],"/docs/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3640":73793,"_31229":73787,"_5":31564,"_21648":123341,"_28426":123342,"_3090":123343},[],"/docs/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3640":73794,"_31229":73787,"_5":31564,"_21648":123345,"_28426":123346,"_3090":123347},[],"/docs/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3640":73795,"_31229":73787,"_5":31564,"_21648":123349,"_28426":123350,"_3090":123351},[],"/docs/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3640":73796,"_31229":73787,"_5":31564,"_21648":123353,"_28426":123354,"_3090":123355},[],"/docs/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3640":73797,"_31229":73787,"_5":31564,"_21648":123357,"_28426":123358,"_3090":123359},[],"/docs/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3640":73798,"_31229":73787,"_5":31564,"_21648":123361,"_28426":123362,"_3090":123363},[],"/docs/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3640":73799,"_31229":73787,"_5":31564,"_21648":123365,"_28426":123366,"_3090":123367},[],"/docs/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3640":73800,"_31229":73787,"_21648":123369,"_5":14899,"_28426":73787,"_3090":123370},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3640":73801,"_31229":73787,"_21648":123372,"_5":14899,"_28426":73787,"_3090":123373},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3640":73802,"_31229":73787,"_21648":123375,"_5":14899,"_28426":123326,"_3090":123376},[],"Vista operativa",{"_3640":73803,"_31229":73787,"_21648":123378,"_5":14899,"_28426":123326,"_3090":123379},[],"Interpretación",{"_3640":73804,"_31229":73787,"_21648":123381,"_5":14899,"_28426":123326,"_3090":53817},[],{"_3640":73805,"_31229":73787,"_21648":123383,"_5":14899,"_28426":123326,"_3090":123384},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3640":73806,"_31229":73787,"_21648":123386,"_5":14899,"_28426":123326,"_3090":53823},[],{"_3640":73807,"_31229":73787,"_21648":123388,"_5":14899,"_28426":123326,"_3090":123389},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3640":73808,"_31229":73787,"_21648":123391,"_5":14899,"_28426":123326,"_3090":53829},[],{"_3640":73809,"_31229":73787,"_21648":123393,"_5":14899,"_28426":123326,"_3090":123394},[],"La identidad está en la ventana operativa de renovación.",{"_3640":73810,"_31229":73787,"_21648":123396,"_5":14899,"_28426":123326,"_3090":53835},[],{"_3640":73811,"_31229":73787,"_21648":123398,"_5":14899,"_28426":123326,"_3090":123399},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3640":73812,"_31229":73787,"_21648":123401,"_5":14899,"_28426":123326,"_3090":53841},[],{"_3640":73813,"_31229":73787,"_21648":123403,"_5":14899,"_28426":123326,"_3090":123404},[],"La identidad ha vencido.",{"_3640":73814,"_31229":73787,"_21648":123406,"_5":14899,"_28426":123326,"_3090":53847},[],{"_3640":73815,"_31229":73787,"_21648":123408,"_5":14899,"_28426":123326,"_3090":123409},[],"La identidad está marcada como revocada. Una suspensión en cascada desde su CA se muestra aquí y se levanta al reactivar esa CA.",{"_3640":73816,"_31229":73787,"_21648":123411,"_5":14899,"_28426":123326,"_3090":53853},[],{"_3640":73817,"_31229":73787,"_21648":123413,"_5":14899,"_28426":123326,"_3090":123414},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3640":73818,"_31229":73787,"_21648":123416,"_5":14899,"_28426":123326,"_3090":123417},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3640":73819,"_31229":73787,"_21648":123419,"_5":14899,"_28426":123330,"_3090":123420},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3640":73820,"_31229":73787,"_21648":123422,"_5":14899,"_28426":123330,"_3090":123423},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3640":73821,"_31229":73787,"_21648":123425,"_5":14899,"_28426":123330,"_3090":123426},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3640":73822,"_31229":73787,"_21648":123428,"_5":14899,"_28426":123330,"_3090":123429},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3640":73823,"_31229":73787,"_21648":123431,"_5":14899,"_28426":123334,"_3090":123432},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3640":73824,"_31229":73787,"_21648":123434,"_5":14899,"_28426":123338,"_3090":123435},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3640":73825,"_31229":73787,"_21648":123437,"_5":14899,"_28426":123342,"_3090":123438},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3640":73826,"_31229":73787,"_21648":123440,"_5":14899,"_28426":123346,"_3090":123441},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3640":73827,"_31229":73787,"_21648":123443,"_5":14899,"_28426":123350,"_3090":123444},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3640":73828,"_31229":73787,"_21648":123446,"_5":14899,"_28426":123350,"_3090":123447},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3640":73829,"_31229":73787,"_21648":123449,"_5":14899,"_28426":123354,"_3090":123450},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3640":73830,"_31229":73787,"_21648":123452,"_5":14899,"_28426":123354,"_3090":123453},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3640":73831,"_31229":73787,"_21648":123455,"_5":14899,"_28426":123354,"_3090":123456},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3640":73832,"_31229":73787,"_21648":123458,"_5":14899,"_28426":123354,"_3090":123459},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3640":73833,"_31229":73787,"_21648":123461,"_5":14899,"_28426":123354,"_3090":123462},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3640":73834,"_31229":73787,"_21648":123464,"_5":14899,"_28426":123354,"_3090":123465},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3640":73835,"_31229":73787,"_21648":123467,"_5":14899,"_28426":123358,"_3090":123468},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3640":73836,"_31229":73787,"_21648":123470,"_5":14899,"_28426":123358,"_3090":123471},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3640":73837,"_31229":73787,"_21648":123473,"_5":14899,"_28426":123358,"_3090":123474},[],"Un certificado suspendido por una cascada de suspensión de una CA se muestra como **Revoked** y vuelve a estar activo cuando se reactiva esa CA. Si su certificado caducó durante la suspensión, el trabajo de monitorización lo marca de nuevo como caducado tras la reactivación. Si tú revocas una identidad suspendida, esa revocación es permanente.",{"_3640":73838,"_31229":73787,"_21648":123476,"_5":14899,"_28426":123362,"_3090":123477},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3640":73839,"_31229":73787,"_21648":123479,"_5":14899,"_28426":123362,"_3090":123480},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3640":73840,"_31229":73787,"_21648":123482,"_5":14899,"_28426":123362,"_3090":123483},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3640":73841,"_31229":73787,"_21648":123485,"_5":14899,"_28426":123362,"_3090":123486},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3640":73842,"_31229":73787,"_21648":123488,"_5":14899,"_28426":123366,"_3090":123489},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3640":73843,"_31229":73787,"_21648":123491,"_5":14899,"_28426":123366,"_3090":123492},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3640":73844,"_31229":73844,"_5":15259,"_3090":123494,"_31567":123495,"_21648":123497,"_28426":73844},"Identidad inicial y autenticación",[51054,122173,53754,123318,123496],"Enrolamiento con PKI",[],{"_3640":73845,"_31229":73844,"_21648":123499,"_5":14899,"_28426":73844,"_3090":123500},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3640":73846,"_31229":73844,"_5":31564,"_21648":123502,"_28426":123503,"_3090":123504},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3640":73847,"_31229":73844,"_5":31564,"_21648":123506,"_28426":123507,"_3090":123508},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3640":73848,"_31229":73844,"_5":31564,"_21648":123510,"_28426":123511,"_3090":123512},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3640":73849,"_31229":73844,"_5":31564,"_21648":123514,"_28426":123515,"_3090":123516},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3640":73850,"_31229":73844,"_5":31564,"_21648":123518,"_28426":123519,"_3090":123520},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3640":73851,"_31229":73844,"_21648":123522,"_5":14899,"_28426":73844,"_3090":123523},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3640":73852,"_31229":73844,"_21648":123525,"_5":14899,"_28426":123503,"_3090":123526},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3640":73853,"_31229":73844,"_21648":123528,"_5":14899,"_28426":123503,"_3090":123529},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3640":73854,"_31229":73844,"_21648":123531,"_5":14899,"_28426":123507,"_3090":123532},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. El validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3640":73855,"_31229":73844,"_21648":123534,"_5":14899,"_28426":123507,"_3090":123535},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3640":73856,"_31229":73844,"_21648":123537,"_5":14899,"_28426":123507,"_3090":123538},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3640":73857,"_31229":73844,"_21648":123540,"_5":14899,"_28426":123511,"_3090":123541},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3640":73858,"_31229":73844,"_21648":123543,"_5":14899,"_28426":123511,"_3090":123544},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3640":73859,"_31229":73844,"_21648":123546,"_5":14899,"_28426":123515,"_3090":123547},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3640":73860,"_31229":73844,"_21648":123549,"_5":14899,"_28426":123515,"_3090":123550},[],"Ejemplo de cuerpo:",{"_3640":73861,"_31229":73844,"_21648":123552,"_5":14899,"_28426":123515,"_3090":123553},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3640":73862,"_31229":73844,"_21648":123555,"_5":14899,"_28426":123515,"_3090":123556},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3640":73863,"_31229":73844,"_21648":123558,"_5":14899,"_28426":123515,"_3090":123559},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3640":73864,"_31229":73844,"_21648":123561,"_5":14899,"_28426":123515,"_3090":123562},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3640":73865,"_31229":73844,"_21648":123564,"_5":14899,"_28426":123519,"_3090":123565},[],"El DMS busca primero el certificado presentado en Lamassu; los certificados que emitió y gestiona se comprueban con su estado almacenado. Los certificados externos se comprueban mediante sus servidores OCSP y, después, sus puntos de distribución CRL. Por defecto, una revocación no verificable es un rechazo, no una aceptación: un certificado que no gestiona Lamassu y no lista ningún endpoint OCSP o CRL se rechaza, salvo que se active `allow_unverifiable_revocation` en el bloque de esa operación (consulta Autenticación por operación).",{"_3640":73866,"_31229":73844,"_21648":123567,"_5":14899,"_28426":123519,"_3090":123568},[],"Un certificado que sí lista endpoints se exige con un estándar más estricto, con o sin la opción: los endpoints que no responden, la evidencia caducada o inválida o un estado no concluyente (desconocido) rechazan el certificado. La evidencia debe estar fresca — `thisUpdate` no en el futuro, `nextUpdate` no superado, y una respuesta sin `nextUpdate` solo se acepta mientras tenga menos de unas 24 horas — y las respuestas OCSP deben estar firmadas por el propio emisor del certificado o por un responder delegado que lleve el EKU `id-kp-OCSPSigning` y esté dentro de su validez. Un veredicto de revocado se respeta con independencia de su antigüedad. Cada solicitud OCSP o CRL tiene un timeout de 10 segundos.",{"_3640":73867,"_31229":73844,"_21648":123570,"_5":14899,"_28426":123519,"_3090":123571},[],"Queda un matiz: una respuesta OCSP Good o una CRL firmadas y capturadas antes de una revocación siguen validando hasta su `nextUpdate` (hasta unas 24 horas sin `nextUpdate`). La revocación se propaga a los dispositivos al ritmo con que los responders publican evidencia, no en el momento de la revocación.",{"_3640":73868,"_31229":73844,"_21648":123573,"_5":14899,"_28426":123519,"_3090":123574},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3640":73869,"_31229":73869,"_5":15259,"_3090":123576,"_31567":123577,"_21648":123578,"_28426":73869},"Configura y opera el DMS",[51054,122173,53754,123318,123496],[],{"_3640":73870,"_31229":73869,"_21648":123580,"_5":14899,"_28426":73869,"_3090":123581},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3640":73871,"_31229":73869,"_5":31564,"_21648":123583,"_28426":123584,"_3090":120691},[],"/docs/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3640":73872,"_31229":73869,"_5":31564,"_21648":123586,"_28426":123587,"_3090":123588},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3640":73873,"_31229":73869,"_5":31564,"_21648":123590,"_28426":123591,"_3090":123592},[],"/docs/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3640":73874,"_31229":73869,"_5":31564,"_21648":123594,"_28426":123595,"_3090":123596},[],"/docs/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3640":73875,"_31229":73869,"_5":31564,"_21648":123598,"_28426":123599,"_3090":123600},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3640":73876,"_31229":73869,"_5":31564,"_21648":123602,"_28426":123603,"_3090":123604},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3640":73877,"_31229":73869,"_5":31564,"_21648":123606,"_28426":123607,"_3090":123608},[],"/docs/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3640":73878,"_31229":73869,"_5":31564,"_21648":123610,"_28426":123611,"_3090":123612},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3640":73879,"_31229":73869,"_5":31564,"_21648":123614,"_28426":123615,"_3090":54058},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3640":73880,"_31229":73869,"_5":31564,"_21648":123617,"_28426":123618,"_3090":54062},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3640":73881,"_31229":73869,"_5":31564,"_21648":123620,"_28426":123621,"_3090":123622},[],"/docs/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3640":73882,"_31229":73869,"_5":31564,"_21648":123624,"_28426":123625,"_3090":123626},[],"/docs/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3640":73883,"_31229":73869,"_5":31564,"_21648":123628,"_28426":123629,"_3090":123630},[],"/docs/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3640":73884,"_31229":73869,"_5":31564,"_21648":123632,"_28426":123633,"_3090":123634},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3640":73885,"_31229":73869,"_5":31564,"_21648":123636,"_28426":123637,"_3090":54082},[],"/docs/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3640":73886,"_31229":73869,"_5":31564,"_21648":123639,"_28426":123640,"_3090":123641},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3640":73887,"_31229":73869,"_5":31564,"_21648":123643,"_28426":123644,"_3090":123645},[],"/docs/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3640":73888,"_31229":73869,"_5":31564,"_21648":123647,"_28426":123648,"_3090":123649},[],"/docs/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3640":73889,"_31229":73869,"_21648":123651,"_5":14899,"_28426":73869,"_3090":123652},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3640":73890,"_31229":73869,"_21648":123654,"_5":14899,"_28426":123584,"_3090":123655},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3640":73891,"_31229":73869,"_21648":123657,"_5":14899,"_28426":123584,"_3090":123658},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3640":73892,"_31229":73869,"_21648":123660,"_5":14899,"_28426":123591,"_3090":123661},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3640":73893,"_31229":73869,"_21648":123663,"_5":14899,"_28426":123595,"_3090":123664},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3640":73894,"_31229":73869,"_21648":123666,"_5":14899,"_28426":123599,"_3090":123667},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3640":73895,"_31229":73869,"_21648":123669,"_5":14899,"_28426":123603,"_3090":123670},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3640":73896,"_31229":73869,"_21648":123672,"_5":14899,"_28426":123607,"_3090":123673},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3640":73897,"_31229":73869,"_21648":123675,"_5":14899,"_28426":123615,"_3090":123676},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3640":73898,"_31229":73869,"_21648":123678,"_5":14899,"_28426":123615,"_3090":123679},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. Un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3640":73899,"_31229":73869,"_21648":123681,"_5":14899,"_28426":123618,"_3090":123682},[],"Campo de `settings.enrollment_settings`",{"_3640":73900,"_31229":73869,"_21648":123684,"_5":14899,"_28426":123618,"_3090":123685},[],"Decisión",{"_3640":73901,"_31229":73869,"_21648":123687,"_5":14899,"_28426":123618,"_3090":54133},[],{"_3640":73902,"_31229":73869,"_21648":123689,"_5":14899,"_28426":123618,"_3090":123690},[],"`EST_RFC7030` para estas operaciones.",{"_3640":73903,"_31229":73869,"_21648":123692,"_5":14899,"_28426":123618,"_3090":54139},[],{"_3640":73904,"_31229":73869,"_21648":123694,"_5":14899,"_28426":123618,"_3090":123695},[],"ID de la CA que firmará.",{"_3640":73905,"_31229":73869,"_21648":123697,"_5":14899,"_28426":123618,"_3090":54145},[],{"_3640":73906,"_31229":73869,"_21648":123699,"_5":14899,"_28426":123618,"_3090":123700},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3640":73907,"_31229":73869,"_21648":123702,"_5":14899,"_28426":123618,"_3090":54151},[],{"_3640":73908,"_31229":73869,"_21648":123704,"_5":14899,"_28426":123618,"_3090":123705},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3640":73909,"_31229":73869,"_21648":123707,"_5":14899,"_28426":123618,"_3090":54157},[],{"_3640":73910,"_31229":73869,"_21648":123709,"_5":14899,"_28426":123618,"_3090":123710},[],"Uno de los cuatro modos de autenticación.",{"_3640":73911,"_31229":73869,"_21648":123712,"_5":14899,"_28426":123618,"_3090":123713},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3640":73912,"_31229":73869,"_21648":123715,"_5":14899,"_28426":123621,"_3090":123716},[],"Los bloques son independientes:",{"_3640":73913,"_31229":73869,"_21648":123718,"_5":14899,"_28426":123621,"_3090":123719},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3640":73914,"_31229":73869,"_21648":123721,"_5":14899,"_28426":123621,"_3090":123722},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3640":73915,"_31229":73869,"_21648":123724,"_5":14899,"_28426":123621,"_3090":54175},[],{"_3640":73916,"_31229":73869,"_21648":123726,"_5":14899,"_28426":123621,"_3090":123727},[],"Control aplicado en la operación configurada",{"_3640":73917,"_31229":73869,"_21648":123729,"_5":14899,"_28426":123621,"_3090":54181},[],{"_3640":73918,"_31229":73869,"_21648":123731,"_5":14899,"_28426":123621,"_3090":123732},[],"Validación del certificado presentado.",{"_3640":73919,"_31229":73869,"_21648":123734,"_5":14899,"_28426":123621,"_3090":54187},[],{"_3640":73920,"_31229":73869,"_21648":123736,"_5":14899,"_28426":123621,"_3090":123737},[],"Autorización del webhook configurado.",{"_3640":73921,"_31229":73869,"_21648":123739,"_5":14899,"_28426":123621,"_3090":54193},[],{"_3640":73922,"_31229":73869,"_21648":123741,"_5":14899,"_28426":123621,"_3090":123742},[],"Validación del certificado y, después, aprobación del webhook.",{"_3640":73923,"_31229":73869,"_21648":123744,"_5":14899,"_28426":123621,"_3090":54199},[],{"_3640":73924,"_31229":73869,"_21648":123746,"_5":14899,"_28426":123621,"_3090":123747},[],"Sin autenticación del solicitante por el DMS.",{"_3640":73925,"_31229":73869,"_21648":123749,"_5":14899,"_28426":123621,"_3090":123750},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3640":73926,"_31229":73869,"_21648":123752,"_5":14899,"_28426":123621,"_3090":123753},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired`, `chain_level_validation` y `allow_unverifiable_revocation`. El validador recibe una credencial de certificado; el flujo no garantiza transportar hasta él todas las intermedias del handshake. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3640":73927,"_31229":73869,"_21648":123755,"_5":14899,"_28426":123621,"_3090":123756},[],"El editor de autenticación ofrece el interruptor **Allow certificates without revocation information** (`allow_unverifiable_revocation`, desactivado por defecto). Cuando está activado, se aceptan certificados — y CAs intermedias de la cadena — que Lamassu no gestiona y que no declaran ningún endpoint OCSP o CRL; las respuestas de revocación inaccesibles, obsoletas o no concluyentes se rechazan siempre. Mientras el interruptor esté activado, la consola muestra una alerta de aviso: **Revocation will not be verified** — un certificado revocado sin endpoint OCSP o CRL, y no gestionado por Lamassu, será aceptado, y esto se aplica también a las CAs intermedias de la cadena.",{"_3640":73928,"_31229":73869,"_21648":123758,"_5":14899,"_28426":123621,"_3090":123759},[],"El mismo interruptor se ofrece tanto en el editor de autenticación de enrolamiento como en el de reenrolamiento, y se almacena por bloque dentro de `est_rfc7030_settings.client_certificate_settings`; un DMS almacenado antes de que existiera el campo se carga con el interruptor desactivado. La consola también muestra una alerta de aviso siempre que una opción de autenticación esté en su estado inseguro — **Allow expired certificates** activado, **Allow expired renewal** activado o **Verify CSR signature** desactivado — y la nota de No authentication se presenta también como alerta de aviso.",{"_3640":73929,"_31229":73869,"_21648":123761,"_5":14899,"_28426":123621,"_3090":123762},[],"La revocación se comprueba en cada certificado presentado. En el enrolamiento inicial se comprueban el certificado de cliente **y** todas las CAs intermedias entre él y la CA de validación, cada una frente a su emisor; los certificados adicionales que envíe el dispositivo en el handshake se ignoran. Una CA de validación revocada en Lamassu rechaza la operación: se usa la primera CA de validación que valide el certificado, y una revocada no se sustituye por las demás CAs de validación. Los certificados emitidos y gestionados por Lamassu se comprueban con su estado almacenado. Los certificados externos se comprueban mediante sus endpoints OCSP y CRL, y la operación falla cerrada cuando la revocación no puede verificarse: solo `allow_unverifiable_revocation` — `false` por defecto en ambos bloques — relaja el caso de un certificado externo que no lista ningún endpoint. Los endpoints que existen pero no responden, devuelven evidencia caducada o inválida, o reportan un estado no concluyente se rechazan siempre, lo que diga la opción. Los detalles y la evidencia que deben presentar los endpoints están en Revocación y comprobaciones.",{"_3640":73930,"_31229":73869,"_21648":123764,"_5":14899,"_28426":123621,"_3090":123765},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`. El reenrolamiento comprueba la revocación solo del certificado de cliente; esa comprobación la rige el `allow_unverifiable_revocation` propio del bloque de reenrolamiento.",{"_3640":73931,"_31229":73869,"_21648":123767,"_5":14899,"_28426":123621,"_3090":123768},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3640":73932,"_31229":73869,"_21648":123770,"_5":14899,"_28426":123625,"_3090":123771},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3640":73933,"_31229":73869,"_21648":123773,"_5":14899,"_28426":123625,"_3090":123774},[],"Campo de `external_webhook_settings`",{"_3640":73934,"_31229":73869,"_21648":123776,"_5":14899,"_28426":123625,"_3090":123685},[],{"_3640":73935,"_31229":73869,"_21648":123778,"_5":14899,"_28426":123625,"_3090":54234},[],{"_3640":73936,"_31229":73869,"_21648":123780,"_5":14899,"_28426":123625,"_3090":123781},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3640":73937,"_31229":73869,"_21648":123783,"_5":14899,"_28426":123625,"_3090":54240},[],{"_3640":73938,"_31229":73869,"_21648":123785,"_5":14899,"_28426":123625,"_3090":123786},[],"`POST` o `PUT`; `POST` por defecto.",{"_3640":73939,"_31229":73869,"_21648":123788,"_5":14899,"_28426":123625,"_3090":54246},[],{"_3640":73940,"_31229":73869,"_21648":123790,"_5":14899,"_28426":123625,"_3090":123791},[],"Etiqueta usada en los logs del servicio.",{"_3640":73941,"_31229":73869,"_21648":123793,"_5":14899,"_28426":123625,"_3090":54252},[],{"_3640":73942,"_31229":73869,"_21648":123795,"_5":14899,"_28426":123625,"_3090":123796},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3640":73943,"_31229":73869,"_21648":123798,"_5":14899,"_28426":123625,"_3090":54258},[],{"_3640":73944,"_31229":73869,"_21648":123800,"_5":14899,"_28426":123625,"_3090":123801},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3640":73945,"_31229":73869,"_21648":123803,"_5":14899,"_28426":123625,"_3090":54264},[],{"_3640":73946,"_31229":73869,"_21648":123805,"_5":14899,"_28426":123625,"_3090":123806},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3640":73947,"_31229":73869,"_21648":123808,"_5":14899,"_28426":123625,"_3090":54270},[],{"_3640":73948,"_31229":73869,"_21648":123810,"_5":14899,"_28426":123625,"_3090":123811},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3640":73949,"_31229":73869,"_21648":123813,"_5":14899,"_28426":123625,"_3090":54276},[],{"_3640":73950,"_31229":73869,"_21648":123815,"_5":14899,"_28426":123625,"_3090":123816},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3640":73951,"_31229":73869,"_21648":123818,"_5":14899,"_28426":123625,"_3090":54282},[],{"_3640":73952,"_31229":73869,"_21648":123820,"_5":14899,"_28426":123625,"_3090":123821},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3640":73953,"_31229":73869,"_21648":123823,"_5":14899,"_28426":123625,"_3090":54288},[],{"_3640":73954,"_31229":73869,"_21648":123825,"_5":14899,"_28426":123625,"_3090":123826},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3640":73955,"_31229":73869,"_21648":123828,"_5":14899,"_28426":123625,"_3090":123829},[],"Reglas de esa configuración:",{"_3640":73956,"_31229":73869,"_21648":123831,"_5":14899,"_28426":123625,"_3090":123832},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3640":73957,"_31229":73869,"_21648":123834,"_5":14899,"_28426":123625,"_3090":123835},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3640":73958,"_31229":73869,"_21648":123837,"_5":14899,"_28426":123625,"_3090":123838},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3640":73959,"_31229":73869,"_21648":123840,"_5":14899,"_28426":123625,"_3090":123841},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3640":73960,"_31229":73869,"_21648":123843,"_5":14899,"_28426":123625,"_3090":123844},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3640":73961,"_31229":73869,"_21648":123846,"_5":14899,"_28426":123625,"_3090":123847},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3640":73962,"_31229":73869,"_21648":123849,"_5":14899,"_28426":123625,"_3090":123850},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3640":73963,"_31229":73869,"_21648":123852,"_5":14899,"_28426":123625,"_3090":123853},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3640":73964,"_31229":73869,"_21648":123855,"_5":14899,"_28426":123625,"_3090":123856},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3640":73965,"_31229":73869,"_21648":123858,"_5":14899,"_28426":123629,"_3090":123859},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3640":73966,"_31229":73869,"_21648":123861,"_5":14899,"_28426":123633,"_3090":123862},[],"Campo de `settings.reenrollment_settings`",{"_3640":73967,"_31229":73869,"_21648":123864,"_5":14899,"_28426":123633,"_3090":123865},[],"Función",{"_3640":73968,"_31229":73869,"_21648":123867,"_5":14899,"_28426":123633,"_3090":54332},[],{"_3640":73969,"_31229":73869,"_21648":123869,"_5":14899,"_28426":123633,"_3090":123870},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3640":73970,"_31229":73869,"_21648":123872,"_5":14899,"_28426":123633,"_3090":54338},[],{"_3640":73971,"_31229":73869,"_21648":123874,"_5":14899,"_28426":123633,"_3090":123875},[],"Umbral operativo preventivo de monitorización.",{"_3640":73972,"_31229":73869,"_21648":123877,"_5":14899,"_28426":123633,"_3090":54344},[],{"_3640":73973,"_31229":73869,"_21648":123879,"_5":14899,"_28426":123633,"_3090":123880},[],"Umbral operativo crítico de monitorización.",{"_3640":73974,"_31229":73869,"_21648":123882,"_5":14899,"_28426":123633,"_3090":54350},[],{"_3640":73975,"_31229":73869,"_21648":123884,"_5":14899,"_28426":123633,"_3090":123885},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3640":73976,"_31229":73869,"_21648":123887,"_5":14899,"_28426":123633,"_3090":54356},[],{"_3640":73977,"_31229":73869,"_21648":123889,"_5":14899,"_28426":123633,"_3090":123890},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3640":73978,"_31229":73869,"_21648":123892,"_5":14899,"_28426":123633,"_3090":54362},[],{"_3640":73979,"_31229":73869,"_21648":123894,"_5":14899,"_28426":123633,"_3090":123895},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3640":73980,"_31229":73869,"_21648":123897,"_5":14899,"_28426":123633,"_3090":123898},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3640":73981,"_31229":73869,"_21648":123900,"_5":14899,"_28426":123637,"_3090":123901},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3640":73982,"_31229":73869,"_21648":123903,"_5":14899,"_28426":123640,"_3090":121055},[],{"_3640":73983,"_31229":73869,"_21648":123905,"_5":14899,"_28426":123640,"_3090":123906},[],"Qué publica",{"_3640":73984,"_31229":73869,"_21648":123908,"_5":14899,"_28426":123640,"_3090":54379},[],{"_3640":73985,"_31229":73869,"_21648":123910,"_5":14899,"_28426":123640,"_3090":123911},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3640":73986,"_31229":73869,"_21648":123913,"_5":14899,"_28426":123640,"_3090":54385},[],{"_3640":73987,"_31229":73869,"_21648":123915,"_5":14899,"_28426":123640,"_3090":123916},[],"Certificado de la CA emisora seleccionada.",{"_3640":73988,"_31229":73869,"_21648":123918,"_5":14899,"_28426":123640,"_3090":54391},[],{"_3640":73989,"_31229":73869,"_21648":123920,"_5":14899,"_28426":123640,"_3090":123921},[],"Certificados de las CAs elegidas explícitamente.",{"_3640":73990,"_31229":73869,"_21648":123923,"_5":14899,"_28426":123640,"_3090":123924},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3640":73991,"_31229":73869,"_21648":123926,"_5":14899,"_28426":123644,"_3090":123927},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3640":73992,"_31229":73869,"_21648":123929,"_5":14899,"_28426":123644,"_3090":123930},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3640":73993,"_31229":73869,"_21648":123932,"_5":14899,"_28426":123644,"_3090":123933},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3640":73994,"_31229":73869,"_21648":123935,"_5":14899,"_28426":123648,"_3090":123936},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3640":73995,"_31229":73995,"_5":15259,"_3090":123938,"_31567":123939,"_21648":123940,"_28426":73995},"Integra el cliente EST",[51054,122173,53754,123318,123496],[],{"_3640":73996,"_31229":73995,"_21648":123942,"_5":14899,"_28426":73995,"_3090":123943},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3640":73997,"_31229":73995,"_5":31564,"_21648":123945,"_28426":123946,"_3090":120691},[],"/docs/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3640":73998,"_31229":73995,"_5":31564,"_21648":123948,"_28426":123949,"_3090":123950},[],"/docs/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3640":73999,"_31229":73995,"_5":31564,"_21648":123952,"_28426":123953,"_3090":123954},[],"/docs/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3640":74000,"_31229":73995,"_5":31564,"_21648":123956,"_28426":123957,"_3090":123958},[],"/docs/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3640":74001,"_31229":73995,"_5":31564,"_21648":123960,"_28426":123961,"_3090":123962},[],"/docs/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3640":74002,"_31229":73995,"_5":31564,"_21648":123964,"_28426":123965,"_3090":123966},[],"/docs/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3640":74003,"_31229":73995,"_21648":123968,"_5":14899,"_28426":73995,"_3090":123969},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3640":74004,"_31229":73995,"_21648":123971,"_5":14899,"_28426":123946,"_3090":123972},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3640":74005,"_31229":73995,"_21648":123974,"_5":14899,"_28426":123946,"_3090":123975},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3640":74006,"_31229":73995,"_21648":123977,"_5":14899,"_28426":123946,"_3090":123978},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3640":74007,"_31229":73995,"_21648":123980,"_5":14899,"_28426":123949,"_3090":123981},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3640":74008,"_31229":73995,"_21648":123983,"_5":14899,"_28426":123949,"_3090":123984},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3640":74009,"_31229":73995,"_21648":123986,"_5":14899,"_28426":123953,"_3090":123987},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3640":74010,"_31229":73995,"_21648":123989,"_5":14899,"_28426":123953,"_3090":123990},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3640":74011,"_31229":73995,"_21648":123992,"_5":14899,"_28426":123957,"_3090":123993},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3640":74012,"_31229":73995,"_21648":123995,"_5":14899,"_28426":123957,"_3090":123996},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3640":74013,"_31229":73995,"_21648":123998,"_5":14899,"_28426":123961,"_3090":123999},[],"Para el caso de una raíz que emite directamente:",{"_3640":74014,"_31229":73995,"_21648":124001,"_5":14899,"_28426":123961,"_3090":124002},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3640":74015,"_31229":73995,"_21648":124004,"_5":14899,"_28426":123961,"_3090":124005},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3640":74016,"_31229":73995,"_21648":124007,"_5":14899,"_28426":123965,"_3090":124008},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3640":74017,"_31229":74017,"_5":15259,"_3090":124010,"_31567":124011,"_21648":124012,"_28426":74017},"Referencia EST",[51054,122173,53754,123318,123496],[],{"_3640":74018,"_31229":74017,"_21648":124014,"_5":14899,"_28426":74017,"_3090":124015},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3640":74019,"_31229":74017,"_5":31564,"_21648":124017,"_28426":124018,"_3090":124019},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3640":74020,"_31229":74017,"_5":31564,"_21648":124021,"_28426":124022,"_3090":23451},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3640":74021,"_31229":74017,"_5":31564,"_21648":124024,"_28426":124025,"_3090":26966},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3640":74022,"_31229":74017,"_5":31564,"_21648":124027,"_28426":124028,"_3090":26973},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3640":74023,"_31229":74017,"_5":31564,"_21648":124030,"_28426":124031,"_3090":26235},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3640":74024,"_31229":74017,"_5":31564,"_21648":124033,"_28426":124034,"_3090":124035},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3640":74025,"_31229":74017,"_5":31564,"_21648":124037,"_28426":124038,"_3090":124039},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3640":74026,"_31229":74017,"_5":31564,"_21648":124041,"_28426":124042,"_3090":124043},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3640":74027,"_31229":74017,"_21648":124045,"_5":14899,"_28426":74017,"_3090":124046},[],"Referencia del servicio EST de Lamassu, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3640":74028,"_31229":74017,"_21648":124048,"_5":14899,"_28426":124018,"_3090":124049},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3640":74029,"_31229":74017,"_21648":124051,"_5":14899,"_28426":124018,"_3090":121933},[],{"_3640":74030,"_31229":74017,"_21648":124053,"_5":14899,"_28426":124018,"_3090":124054},[],"Método",{"_3640":74031,"_31229":74017,"_21648":124056,"_5":14899,"_28426":124018,"_3090":124057},[],"Autenticación y condición",{"_3640":74032,"_31229":74017,"_21648":124059,"_5":14899,"_28426":124018,"_3090":54534},[],{"_3640":74033,"_31229":74017,"_21648":124061,"_5":14899,"_28426":124018,"_3090":54537},[],{"_3640":74034,"_31229":74017,"_21648":124063,"_5":14899,"_28426":124018,"_3090":124064},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3640":74035,"_31229":74017,"_21648":124066,"_5":14899,"_28426":124018,"_3090":54543},[],{"_3640":74036,"_31229":74017,"_21648":124068,"_5":14899,"_28426":124018,"_3090":54546},[],{"_3640":74037,"_31229":74017,"_21648":124070,"_5":14899,"_28426":124018,"_3090":124071},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3640":74038,"_31229":74017,"_21648":124073,"_5":14899,"_28426":124018,"_3090":54552},[],{"_3640":74039,"_31229":74017,"_21648":124075,"_5":14899,"_28426":124018,"_3090":54546},[],{"_3640":74040,"_31229":74017,"_21648":124077,"_5":14899,"_28426":124018,"_3090":124078},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3640":74041,"_31229":74017,"_21648":124080,"_5":14899,"_28426":124018,"_3090":54560},[],{"_3640":74042,"_31229":74017,"_21648":124082,"_5":14899,"_28426":124018,"_3090":54546},[],{"_3640":74043,"_31229":74017,"_21648":124084,"_5":14899,"_28426":124018,"_3090":124085},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3640":74044,"_31229":74017,"_21648":124087,"_5":14899,"_28426":124018,"_3090":124088},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3640":74045,"_31229":74017,"_21648":124090,"_5":14899,"_28426":124022,"_3090":124091},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3640":74046,"_31229":74017,"_21648":124093,"_5":14899,"_28426":124022,"_3090":124094},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3640":74047,"_31229":74017,"_21648":124096,"_5":14899,"_28426":124025,"_3090":124097},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3640":74048,"_31229":74017,"_21648":124099,"_5":14899,"_28426":124025,"_3090":124100},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3640":74049,"_31229":74017,"_21648":124102,"_5":14899,"_28426":124028,"_3090":124103},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3640":74050,"_31229":74017,"_21648":124105,"_5":14899,"_28426":124028,"_3090":124106},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Con los valores por defecto, un certificado de cliente cuya revocación no puede verificarse también se rechaza; la guía de DMS describe `allow_unverifiable_revocation`. Consulta Renovación para instalación y recuperación.",{"_3640":74051,"_31229":74017,"_21648":124108,"_5":14899,"_28426":124031,"_3090":124109},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3640":74052,"_31229":74017,"_21648":124111,"_5":14899,"_28426":124031,"_3090":124112},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3640":74053,"_31229":74017,"_21648":124114,"_5":14899,"_28426":124034,"_3090":124115},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3640":74054,"_31229":74017,"_21648":124117,"_5":14899,"_28426":124034,"_3090":124118},[],"Parte",{"_3640":74055,"_31229":74017,"_21648":124120,"_5":14899,"_28426":124034,"_3090":124121},[],"Contenido tras decodificar su Base64",{"_3640":74056,"_31229":74017,"_21648":124123,"_5":14899,"_28426":124034,"_3090":54604},[],{"_3640":74057,"_31229":74017,"_21648":124125,"_5":14899,"_28426":124034,"_3090":124126},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3640":74058,"_31229":74017,"_21648":124128,"_5":14899,"_28426":124034,"_3090":54610},[],{"_3640":74059,"_31229":74017,"_21648":124130,"_5":14899,"_28426":124034,"_3090":124131},[],"PKCS#7 DER con el certificado emitido.",{"_3640":74060,"_31229":74017,"_21648":124133,"_5":14899,"_28426":124034,"_3090":124134},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3640":74061,"_31229":74017,"_21648":124136,"_5":14899,"_28426":124038,"_3090":124137},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3640":74062,"_31229":74017,"_21648":124139,"_5":14899,"_28426":124038,"_3090":124140},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3640":74063,"_31229":74017,"_21648":124142,"_5":14899,"_28426":124038,"_3090":124143},[],"Convierte y comprueba el resultado:",{"_3640":74064,"_31229":74017,"_21648":124145,"_5":14899,"_28426":124038,"_3090":124146},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3640":74065,"_31229":74017,"_21648":124148,"_5":14899,"_28426":124042,"_3090":124149},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3640":74066,"_31229":74017,"_21648":124151,"_5":14899,"_28426":124042,"_3090":124152},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3640":74067,"_31229":74067,"_5":15259,"_3090":123496,"_31567":124154,"_21648":124155,"_28426":74067},[51054,122173,53754,123318,123496],[],{"_3640":74068,"_31229":74067,"_21648":124157,"_5":14899,"_28426":74067,"_3090":124158},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3640":74069,"_31229":74067,"_5":31564,"_21648":124160,"_28426":124161,"_3090":124162},[],"/docs/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3640":74070,"_31229":74067,"_5":31564,"_21648":124164,"_28426":124165,"_3090":124166},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3640":74071,"_31229":74067,"_5":31564,"_21648":124168,"_28426":124169,"_3090":124170},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3640":74072,"_31229":74067,"_21648":124172,"_5":14899,"_28426":74067,"_3090":124173},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3640":74073,"_31229":74067,"_21648":124175,"_5":14899,"_28426":124161,"_3090":124176},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3640":74074,"_31229":74067,"_21648":124178,"_5":14899,"_28426":124161,"_3090":124179},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3640":74075,"_31229":74067,"_21648":124181,"_5":14899,"_28426":124161,"_3090":124182},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3640":74076,"_31229":74067,"_21648":124184,"_5":14899,"_28426":124161,"_3090":124185},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3640":74077,"_31229":74067,"_21648":124187,"_5":14899,"_28426":124161,"_3090":124188},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3640":74078,"_31229":74067,"_21648":124190,"_5":14899,"_28426":124161,"_3090":124191},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3640":74079,"_31229":74067,"_21648":124193,"_5":14899,"_28426":124165,"_3090":124194},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3640":74080,"_31229":74067,"_21648":124196,"_5":14899,"_28426":124165,"_3090":124197},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3640":74081,"_31229":74067,"_21648":124199,"_5":14899,"_28426":124165,"_3090":124200},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3640":74082,"_31229":74067,"_21648":124202,"_5":14899,"_28426":124165,"_3090":124203},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3640":74083,"_31229":74067,"_21648":124205,"_5":14899,"_28426":124169,"_3090":124206},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3640":74084,"_31229":74067,"_21648":124208,"_5":14899,"_28426":124169,"_3090":124209},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3640":74085,"_31229":74067,"_21648":124211,"_5":14899,"_28426":124169,"_3090":124212},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3640":74086,"_31229":74067,"_21648":124214,"_5":14899,"_28426":124169,"_3090":124215},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3640":74087,"_31229":74067,"_21648":124217,"_5":14899,"_28426":124169,"_3090":124218},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3640":74088,"_31229":74088,"_5":15259,"_3090":124220,"_31567":124221,"_21648":124222,"_28426":74088},"Estrategias de aprovisionamiento",[51054,122173,53754,123318,123496],[],{"_3640":74089,"_31229":74088,"_21648":124224,"_5":14899,"_28426":74088,"_3090":124225},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3640":74090,"_31229":74088,"_5":31564,"_21648":124227,"_28426":124228,"_3090":124229},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3640":74091,"_31229":74088,"_5":31564,"_21648":124231,"_28426":124232,"_3090":124233},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3640":74092,"_31229":74088,"_5":31564,"_21648":124235,"_28426":124236,"_3090":124237},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3640":74093,"_31229":74088,"_5":31564,"_21648":124239,"_28426":124240,"_3090":124241},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3640":74094,"_31229":74088,"_5":31564,"_21648":124243,"_28426":124244,"_3090":124245},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3640":74095,"_31229":74088,"_21648":124247,"_5":14899,"_28426":74088,"_3090":124248},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3640":74096,"_31229":74088,"_21648":124250,"_5":14899,"_28426":124228,"_3090":124251},[],"Recorrido",{"_3640":74097,"_31229":74088,"_21648":124253,"_5":14899,"_28426":124228,"_3090":124254},[],"Cuándo existe el dispositivo",{"_3640":74098,"_31229":74088,"_21648":124256,"_5":14899,"_28426":124228,"_3090":124257},[],"Qué compruebas",{"_3640":74099,"_31229":74088,"_21648":124259,"_5":14899,"_28426":124228,"_3090":124260},[],"Asignación manual",{"_3640":74100,"_31229":74088,"_21648":124262,"_5":14899,"_28426":124228,"_3090":124263},[],"El operador lo crea antes de asociar un certificado.",{"_3640":74101,"_31229":74088,"_21648":124265,"_5":14899,"_28426":124228,"_3090":124266},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3640":74102,"_31229":74088,"_21648":124268,"_5":14899,"_28426":124228,"_3090":124269},[],"EST con `JITP`",{"_3640":74103,"_31229":74088,"_21648":124271,"_5":14899,"_28426":124228,"_3090":124272},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3640":74104,"_31229":74088,"_21648":124274,"_5":14899,"_28426":124228,"_3090":124275},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3640":74105,"_31229":74088,"_21648":124277,"_5":14899,"_28426":124228,"_3090":124278},[],"EST con `PRE_REGISTRATION`",{"_3640":74106,"_31229":74088,"_21648":124280,"_5":14899,"_28426":124228,"_3090":124281},[],"Debe existir antes de `/simpleenroll`.",{"_3640":74107,"_31229":74088,"_21648":124283,"_5":14899,"_28426":124228,"_3090":124284},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3640":74108,"_31229":74088,"_21648":124286,"_5":14899,"_28426":124228,"_3090":124287},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3640":74109,"_31229":74088,"_21648":124289,"_5":14899,"_28426":124228,"_3090":124290},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3640":74110,"_31229":74088,"_21648":124292,"_5":14899,"_28426":124232,"_3090":124293},[],"Encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3640":74111,"_31229":74088,"_21648":124295,"_5":14899,"_28426":124232,"_3090":124296},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3640":74112,"_31229":74088,"_21648":124298,"_5":14899,"_28426":124232,"_3090":124299},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3640":74113,"_31229":74088,"_21648":124301,"_5":14899,"_28426":124236,"_3090":124302},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3640":74114,"_31229":74088,"_21648":124304,"_5":14899,"_28426":124236,"_3090":124305},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3640":74115,"_31229":74088,"_21648":124307,"_5":14899,"_28426":124236,"_3090":124308},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3640":74116,"_31229":74088,"_21648":124310,"_5":14899,"_28426":124236,"_3090":124311},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3640":74117,"_31229":74088,"_21648":124313,"_5":14899,"_28426":124236,"_3090":124314},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3640":74118,"_31229":74088,"_21648":124316,"_5":14899,"_28426":124236,"_3090":124317},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3640":74119,"_31229":74088,"_21648":124319,"_5":14899,"_28426":124240,"_3090":121055},[],{"_3640":74120,"_31229":74088,"_21648":124321,"_5":14899,"_28426":124240,"_3090":124322},[],"Material que atraviesa EST",{"_3640":74121,"_31229":74088,"_21648":124324,"_5":14899,"_28426":124240,"_3090":124325},[],"Clave generada por el dispositivo",{"_3640":74122,"_31229":74088,"_21648":124327,"_5":14899,"_28426":124240,"_3090":124328},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3640":74123,"_31229":74088,"_21648":124330,"_5":14899,"_28426":124240,"_3090":124331},[],"Clave ya disponible en el dispositivo",{"_3640":74124,"_31229":74088,"_21648":124333,"_5":14899,"_28426":124240,"_3090":124334},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3640":74125,"_31229":74088,"_21648":124336,"_5":14899,"_28426":124240,"_3090":54082},[],{"_3640":74126,"_31229":74088,"_21648":124338,"_5":14899,"_28426":124240,"_3090":124339},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3640":74127,"_31229":74088,"_21648":124341,"_5":14899,"_28426":124240,"_3090":124342},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3640":74128,"_31229":74088,"_21648":124344,"_5":14899,"_28426":124244,"_3090":124345},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3640":74129,"_31229":74129,"_5":15259,"_3090":124347,"_31567":124348,"_21648":124349,"_28426":74129},"Renovación y recuperación",[51054,122173,53754,123318,123496],[],{"_3640":74130,"_31229":74129,"_21648":124351,"_5":14899,"_28426":74129,"_3090":124352},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3640":74131,"_31229":74129,"_5":31564,"_21648":124354,"_28426":124355,"_3090":124356},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3640":74132,"_31229":74129,"_5":31564,"_21648":124358,"_28426":124359,"_3090":124360},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3640":74133,"_31229":74129,"_5":31564,"_21648":124362,"_28426":124363,"_3090":124364},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3640":74134,"_31229":74129,"_5":31564,"_21648":124366,"_28426":124367,"_3090":124368},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3640":74135,"_31229":74129,"_5":31564,"_21648":124370,"_28426":124371,"_3090":124372},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3640":74136,"_31229":74129,"_21648":124374,"_5":14899,"_28426":74129,"_3090":124375},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3640":74137,"_31229":74129,"_21648":124377,"_5":14899,"_28426":124355,"_3090":124378},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3640":74138,"_31229":74129,"_21648":124380,"_5":14899,"_28426":124355,"_3090":124381},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3640":74139,"_31229":74129,"_21648":124383,"_5":14899,"_28426":124355,"_3090":124384},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3640":74140,"_31229":74129,"_21648":124386,"_5":14899,"_28426":124355,"_3090":124387},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3640":74141,"_31229":74129,"_21648":124389,"_5":14899,"_28426":124359,"_3090":124390},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3640":74142,"_31229":74129,"_21648":124392,"_5":14899,"_28426":124359,"_3090":124393},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3640":74143,"_31229":74129,"_21648":124395,"_5":14899,"_28426":124363,"_3090":124396},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3640":74144,"_31229":74129,"_21648":124398,"_5":14899,"_28426":124363,"_3090":124399},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3640":74145,"_31229":74129,"_21648":124401,"_5":14899,"_28426":124363,"_3090":124402},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3640":74146,"_31229":74129,"_21648":124404,"_5":14899,"_28426":124367,"_3090":124405},[],"Situación",{"_3640":74147,"_31229":74129,"_21648":124407,"_5":14899,"_28426":124367,"_3090":124408},[],"Procedimiento",{"_3640":74148,"_31229":74129,"_21648":124410,"_5":14899,"_28426":124367,"_3090":124411},[],"Certificado vigente, fuera de ventana",{"_3640":74149,"_31229":74129,"_21648":124413,"_5":14899,"_28426":124367,"_3090":124414},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3640":74150,"_31229":74129,"_21648":124416,"_5":14899,"_28426":124367,"_3090":124417},[],"Certificado vencido, clave disponible",{"_3640":74151,"_31229":74129,"_21648":124419,"_5":14899,"_28426":124367,"_3090":124420},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3640":74152,"_31229":74129,"_21648":124422,"_5":14899,"_28426":124367,"_3090":124423},[],"Renovación por webhook o `NO_AUTH`",{"_3640":74153,"_31229":74129,"_21648":124425,"_5":14899,"_28426":124367,"_3090":124426},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3640":74154,"_31229":74129,"_21648":124428,"_5":14899,"_28426":124367,"_3090":124429},[],"Clave perdida o inaccesible",{"_3640":74155,"_31229":74129,"_21648":124431,"_5":14899,"_28426":124367,"_3090":124432},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3640":74156,"_31229":74129,"_21648":124434,"_5":14899,"_28426":124367,"_3090":124435},[],"Identidad actual revocada",{"_3640":74157,"_31229":74129,"_21648":124437,"_5":14899,"_28426":124367,"_3090":124438},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3640":74158,"_31229":74129,"_21648":124440,"_5":14899,"_28426":124367,"_3090":124441},[],"Dispositivo sin identidad",{"_3640":74159,"_31229":74129,"_21648":124443,"_5":14899,"_28426":124367,"_3090":124444},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3640":74160,"_31229":74129,"_21648":124446,"_5":14899,"_28426":124367,"_3090":124447},[],"Dispositivo retirado",{"_3640":74161,"_31229":74129,"_21648":124449,"_5":14899,"_28426":124367,"_3090":124450},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3640":74162,"_31229":74129,"_21648":124452,"_5":14899,"_28426":124367,"_3090":124453},[],"Timeout, HTTP 500 o fallo de instalación",{"_3640":74163,"_31229":74129,"_21648":124455,"_5":14899,"_28426":124367,"_3090":124456},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3640":74164,"_31229":74129,"_21648":124458,"_5":14899,"_28426":124371,"_3090":124459},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3640":74165,"_31229":74129,"_21648":124461,"_5":14899,"_28426":124371,"_3090":124462},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3640":74166,"_31229":74166,"_5":15259,"_3090":124464,"_31567":124465,"_21648":124466,"_28426":74166},"Diagnóstico de enrolamiento",[51054,122173,53754,123318,123496],[],{"_3640":74167,"_31229":74166,"_21648":124468,"_5":14899,"_28426":74166,"_3090":124469},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3640":74168,"_31229":74166,"_5":31564,"_21648":124471,"_28426":124472,"_3090":124473},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3640":74169,"_31229":74166,"_5":31564,"_21648":124475,"_28426":124476,"_3090":124477},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3640":74170,"_31229":74166,"_5":31564,"_21648":124479,"_28426":124480,"_3090":124043},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3640":74171,"_31229":74166,"_5":31564,"_21648":124482,"_28426":124483,"_3090":124484},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3640":74172,"_31229":74166,"_21648":124486,"_5":14899,"_28426":74166,"_3090":124487},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3640":74173,"_31229":74166,"_21648":124489,"_5":14899,"_28426":124476,"_3090":124490},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3640":74174,"_31229":74166,"_21648":124492,"_5":14899,"_28426":124476,"_3090":124493},[],"Síntoma o mensaje",{"_3640":74175,"_31229":74166,"_21648":124495,"_5":14899,"_28426":124476,"_3090":124496},[],"Qué revisar",{"_3640":74176,"_31229":74166,"_21648":124498,"_5":14899,"_28426":124476,"_3090":124499},[],"curl rechaza TLS, nombre o emisor",{"_3640":74177,"_31229":74166,"_21648":124501,"_5":14899,"_28426":124476,"_3090":124502},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3640":74178,"_31229":74166,"_21648":124504,"_5":14899,"_28426":124476,"_3090":124505},[],"404 o APS ausente",{"_3640":74179,"_31229":74166,"_21648":124507,"_5":14899,"_28426":124476,"_3090":124508},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3640":74180,"_31229":74166,"_21648":124510,"_5":14899,"_28426":124476,"_3090":124511},[],"400, error de CSR o formato",{"_3640":74181,"_31229":74166,"_21648":124513,"_5":14899,"_28426":124476,"_3090":124514},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3640":74182,"_31229":74166,"_21648":124516,"_5":14899,"_28426":124476,"_3090":124517},[],"Credencial ausente o certificado no válido",{"_3640":74183,"_31229":74166,"_21648":124519,"_5":14899,"_28426":124476,"_3090":124520},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3640":74184,"_31229":74166,"_21648":124522,"_5":14899,"_28426":124476,"_3090":124523},[],"El enrolamiento o el reenrolamiento rechaza un certificado por revocación no verificable",{"_3640":74185,"_31229":74166,"_21648":124525,"_5":14899,"_28426":124476,"_3090":124526},[],"Si el certificado lo gestiona Lamassu, si sus endpoints OCSP/CRL están configurados y son alcanzables desde el servicio, y si `allow_unverifiable_revocation` está activo en el bloque de esa operación. Consulta DMS y Revocación y comprobaciones.",{"_3640":74186,"_31229":74166,"_21648":124528,"_5":14899,"_28426":124476,"_3090":124529},[],"Webhook deniega, expira o responde sin autorización",{"_3640":74187,"_31229":74166,"_21648":124531,"_5":14899,"_28426":124476,"_3090":124532},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3640":74188,"_31229":74166,"_21648":124534,"_5":14899,"_28426":124476,"_3090":55016},[],{"_3640":74189,"_31229":74166,"_21648":124536,"_5":14899,"_28426":124476,"_3090":124537},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3640":74190,"_31229":74166,"_21648":124539,"_5":14899,"_28426":124476,"_3090":55022},[],{"_3640":74191,"_31229":74166,"_21648":124541,"_5":14899,"_28426":124476,"_3090":124542},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3640":74192,"_31229":74166,"_21648":124544,"_5":14899,"_28426":124476,"_3090":55028},[],{"_3640":74193,"_31229":74166,"_21648":124546,"_5":14899,"_28426":124476,"_3090":124547},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3640":74194,"_31229":74166,"_21648":124549,"_5":14899,"_28426":124476,"_3090":55034},[],{"_3640":74195,"_31229":74166,"_21648":124551,"_5":14899,"_28426":124476,"_3090":124552},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3640":74196,"_31229":74166,"_21648":124554,"_5":14899,"_28426":124476,"_3090":55040},[],{"_3640":74197,"_31229":74166,"_21648":124556,"_5":14899,"_28426":124476,"_3090":124557},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3640":74198,"_31229":74166,"_21648":124559,"_5":14899,"_28426":124476,"_3090":124560},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3640":74199,"_31229":74166,"_21648":124562,"_5":14899,"_28426":124476,"_3090":124563},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3640":74200,"_31229":74166,"_21648":124565,"_5":14899,"_28426":124476,"_3090":124566},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3640":74201,"_31229":74166,"_21648":124568,"_5":14899,"_28426":124476,"_3090":124569},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3640":74202,"_31229":74166,"_21648":124571,"_5":14899,"_28426":124476,"_3090":55058},[],{"_3640":74203,"_31229":74166,"_21648":124573,"_5":14899,"_28426":124476,"_3090":124574},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3640":74204,"_31229":74166,"_21648":124576,"_5":14899,"_28426":124476,"_3090":55064},[],{"_3640":74205,"_31229":74166,"_21648":124578,"_5":14899,"_28426":124476,"_3090":124579},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3640":74206,"_31229":74166,"_21648":124581,"_5":14899,"_28426":124476,"_3090":124582},[],"DMS propietario distinto",{"_3640":74207,"_31229":74166,"_21648":124584,"_5":14899,"_28426":124476,"_3090":124585},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3640":74208,"_31229":74166,"_21648":124587,"_5":14899,"_28426":124476,"_3090":55076},[],{"_3640":74209,"_31229":74166,"_21648":124589,"_5":14899,"_28426":124476,"_3090":124590},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3640":74210,"_31229":74166,"_21648":124592,"_5":14899,"_28426":124476,"_3090":55082},[],{"_3640":74211,"_31229":74166,"_21648":124594,"_5":14899,"_28426":124476,"_3090":124595},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3640":74212,"_31229":74166,"_21648":124597,"_5":14899,"_28426":124476,"_3090":124598},[],"Certificado actual revocado",{"_3640":74213,"_31229":74166,"_21648":124600,"_5":14899,"_28426":124476,"_3090":124601},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3640":74214,"_31229":74166,"_21648":124603,"_5":14899,"_28426":124476,"_3090":124604},[],"Error de CA, perfil o firma",{"_3640":74215,"_31229":74166,"_21648":124606,"_5":14899,"_28426":124476,"_3090":124607},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3640":74216,"_31229":74166,"_21648":124609,"_5":14899,"_28426":124476,"_3090":124610},[],"HTTP 200 sin conexión del dispositivo",{"_3640":74217,"_31229":74166,"_21648":124612,"_5":14899,"_28426":124476,"_3090":124613},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3640":74218,"_31229":74166,"_21648":124615,"_5":14899,"_28426":124476,"_3090":124616},[],"Timeout o error después de emitir",{"_3640":74219,"_31229":74166,"_21648":124618,"_5":14899,"_28426":124476,"_3090":124619},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3640":74220,"_31229":74166,"_21648":124621,"_5":14899,"_28426":124480,"_3090":124622},[],"Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3640":74221,"_31229":74166,"_21648":124624,"_5":14899,"_28426":124480,"_3090":124625},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3640":74222,"_31229":74166,"_21648":124627,"_5":14899,"_28426":124483,"_3090":124628},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3640":74223,"_31229":74166,"_21648":124630,"_5":14899,"_28426":124483,"_3090":124631},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3640":74224,"_31229":74166,"_21648":124633,"_5":14899,"_28426":124483,"_3090":124634},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3640":74225,"_31229":74166,"_21648":124636,"_5":14899,"_28426":124483,"_3090":124637},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3640":74226,"_31229":74166,"_21648":124639,"_5":14899,"_28426":124483,"_3090":124640},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3640":74227,"_31229":74166,"_21648":124642,"_5":14899,"_28426":124483,"_3090":124643},[],"Las comprobaciones externas de revocación del bootstrap fallan cerradas: un certificado cuya revocación no puede verificarse — incluido un estado OCSP Unknown — se rechaza por defecto. Solo `allow_unverifiable_revocation` en el bloque de esa operación (consulta DMS) lo relaja, y solo para certificados que no llevan ningún endpoint OCSP/CRL; los endpoints que no responden, devuelven evidencia caducada o no concluyente se rechazan, lo que diga la opción. Consulta Revocación y comprobaciones. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3640":74228,"_31229":74166,"_21648":124645,"_5":14899,"_28426":124483,"_3090":124646},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3640":74229,"_31229":74229,"_5":15259,"_3090":124648,"_31567":124649,"_21648":124650,"_28426":74229},"Distribución y actualización de confianza",[51054,122173,53754,123318,123496],[],{"_3640":74230,"_31229":74229,"_21648":124652,"_5":14899,"_28426":74229,"_3090":124653},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3640":74231,"_31229":74229,"_5":31564,"_21648":124655,"_28426":124656,"_3090":124657},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3640":74232,"_31229":74229,"_5":31564,"_21648":124659,"_28426":124660,"_3090":124661},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3640":74233,"_31229":74229,"_5":31564,"_21648":124663,"_28426":124664,"_3090":124665},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3640":74234,"_31229":74229,"_5":31564,"_21648":124667,"_28426":124668,"_3090":124669},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3640":74235,"_31229":74229,"_5":31564,"_21648":124671,"_28426":124672,"_3090":124673},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3640":74236,"_31229":74229,"_21648":124675,"_5":14899,"_28426":74229,"_3090":124676},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3640":74237,"_31229":74229,"_21648":124678,"_5":14899,"_28426":124656,"_3090":124679},[],"Relación",{"_3640":74238,"_31229":74229,"_21648":124681,"_5":14899,"_28426":124656,"_3090":124682},[],"Material que prepara el responsable",{"_3640":74239,"_31229":74229,"_21648":124684,"_5":14899,"_28426":124656,"_3090":124685},[],"Dispositivo → servidor EST",{"_3640":74240,"_31229":74229,"_21648":124687,"_5":14899,"_28426":124656,"_3090":124688},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3640":74241,"_31229":74229,"_21648":124690,"_5":14899,"_28426":124656,"_3090":124691},[],"DMS → solicitante",{"_3640":74242,"_31229":74229,"_21648":124693,"_5":14899,"_28426":124656,"_3090":124694},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3640":74243,"_31229":74229,"_21648":124696,"_5":14899,"_28426":124656,"_3090":124697},[],"Consumidor → dispositivo",{"_3640":74244,"_31229":74229,"_21648":124699,"_5":14899,"_28426":124656,"_3090":124700},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3640":74245,"_31229":74229,"_21648":124702,"_5":14899,"_28426":124656,"_3090":124703},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3640":74246,"_31229":74229,"_21648":124705,"_5":14899,"_28426":124660,"_3090":124706},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3640":74247,"_31229":74229,"_21648":124708,"_5":14899,"_28426":124660,"_3090":124709},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3640":74248,"_31229":74229,"_21648":124711,"_5":14899,"_28426":124664,"_3090":124712},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3640":74249,"_31229":74229,"_21648":124714,"_5":14899,"_28426":124664,"_3090":124715},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3640":74250,"_31229":74229,"_21648":124717,"_5":14899,"_28426":124664,"_3090":124718},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3640":74251,"_31229":74229,"_21648":124720,"_5":14899,"_28426":124664,"_3090":124721},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3640":74252,"_31229":74229,"_21648":124723,"_5":14899,"_28426":124664,"_3090":124724},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3640":74253,"_31229":74229,"_21648":124726,"_5":14899,"_28426":124664,"_3090":124727},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3640":74254,"_31229":74229,"_21648":124729,"_5":14899,"_28426":124668,"_3090":124730},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3640":74255,"_31229":74229,"_21648":124732,"_5":14899,"_28426":124668,"_3090":124733},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3640":74256,"_31229":74229,"_21648":124735,"_5":14899,"_28426":124668,"_3090":124736},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3640":74257,"_31229":74229,"_21648":124738,"_5":14899,"_28426":124672,"_3090":124739},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3640":74258,"_31229":74258,"_5":15259,"_3090":55231,"_31567":124741,"_21648":124743,"_28426":74258},[51054,122173,53754,123318,124742],"Integraciones",[],{"_3640":74259,"_31229":74258,"_21648":124745,"_5":14899,"_28426":74258,"_3090":124746},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3640":74260,"_31229":74258,"_5":31564,"_21648":124748,"_28426":124749,"_3090":124750},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3640":74261,"_31229":74258,"_5":31564,"_21648":124752,"_28426":124753,"_3090":124754},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3640":74262,"_31229":74258,"_5":31564,"_21648":124756,"_28426":124757,"_3090":124758},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3640":74263,"_31229":74258,"_5":31564,"_21648":124760,"_28426":124761,"_3090":124762},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3640":74264,"_31229":74258,"_5":31564,"_21648":124764,"_28426":124765,"_3090":124766},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3640":74265,"_31229":74258,"_5":31564,"_21648":124768,"_28426":124769,"_3090":124770},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3640":74266,"_31229":74258,"_5":31564,"_21648":124772,"_28426":124773,"_3090":124774},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3640":74267,"_31229":74258,"_5":31564,"_21648":124776,"_28426":124777,"_3090":124778},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3640":74268,"_31229":74258,"_5":31564,"_21648":124780,"_28426":124781,"_3090":55273},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3640":74269,"_31229":74258,"_5":31564,"_21648":124783,"_28426":124784,"_3090":55277},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3640":74270,"_31229":74258,"_5":31564,"_21648":124786,"_28426":124787,"_3090":124788},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3640":74271,"_31229":74258,"_5":31564,"_21648":124790,"_28426":124791,"_3090":124792},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3640":74272,"_31229":74258,"_5":31564,"_21648":124794,"_28426":124795,"_3090":124796},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3640":74273,"_31229":74258,"_5":31564,"_21648":124798,"_28426":124799,"_3090":124800},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3640":74274,"_31229":74258,"_5":31564,"_21648":124802,"_28426":124803,"_3090":124804},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3640":74275,"_31229":74258,"_5":31564,"_21648":124806,"_28426":124807,"_3090":124808},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3640":74276,"_31229":74258,"_5":31564,"_21648":124810,"_28426":124811,"_3090":124812},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3640":74277,"_31229":74258,"_5":31564,"_21648":124814,"_28426":124815,"_3090":124816},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3640":74278,"_31229":74258,"_5":31564,"_21648":124818,"_28426":124819,"_3090":124820},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3640":74279,"_31229":74258,"_5":31564,"_21648":124822,"_28426":124823,"_3090":124824},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3640":74280,"_31229":74258,"_5":31564,"_21648":124826,"_28426":124827,"_3090":124828},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3640":74281,"_31229":74258,"_5":31564,"_21648":124830,"_28426":124831,"_3090":124832},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3640":74282,"_31229":74258,"_5":31564,"_21648":124834,"_28426":124835,"_3090":124836},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3640":74283,"_31229":74258,"_5":31564,"_21648":124838,"_28426":124839,"_3090":124840},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3640":74284,"_31229":74258,"_5":31564,"_21648":124842,"_28426":124843,"_3090":124844},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3640":74285,"_31229":74258,"_21648":124846,"_5":14899,"_28426":74258,"_3090":124847},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3640":74286,"_31229":74258,"_21648":124849,"_5":14899,"_28426":74258,"_3090":124850},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3640":74287,"_31229":74258,"_21648":124852,"_5":14899,"_28426":74258,"_3090":124853},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3640":74288,"_31229":74258,"_21648":124855,"_5":14899,"_28426":124749,"_3090":124856},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3640":74289,"_31229":74258,"_21648":124858,"_5":14899,"_28426":124749,"_3090":124859},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3640":74290,"_31229":74258,"_21648":124861,"_5":14899,"_28426":124749,"_3090":124862},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3640":74291,"_31229":74258,"_21648":124864,"_5":14899,"_28426":124749,"_3090":124865},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3640":74292,"_31229":74258,"_21648":124867,"_5":14899,"_28426":124753,"_3090":124868},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3640":74293,"_31229":74258,"_21648":124870,"_5":14899,"_28426":124757,"_3090":124871},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3640":74294,"_31229":74258,"_21648":124873,"_5":14899,"_28426":124757,"_3090":124874},[],"Acción IAM",{"_3640":74295,"_31229":74258,"_21648":124876,"_5":14899,"_28426":124757,"_3090":121061},[],{"_3640":74296,"_31229":74258,"_21648":124878,"_5":14899,"_28426":124757,"_3090":55372},[],{"_3640":74297,"_31229":74258,"_21648":124880,"_5":14899,"_28426":124757,"_3090":124881},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3640":74298,"_31229":74258,"_21648":124883,"_5":14899,"_28426":124757,"_3090":55378},[],{"_3640":74299,"_31229":74258,"_21648":124885,"_5":14899,"_28426":124757,"_3090":124886},[],"Registrar la CA en AWS IoT",{"_3640":74300,"_31229":74258,"_21648":124888,"_5":14899,"_28426":124757,"_3090":55384},[],{"_3640":74301,"_31229":74258,"_21648":124890,"_5":14899,"_28426":124757,"_3090":124891},[],"Consultar el estado del registro de la CA",{"_3640":74302,"_31229":74258,"_21648":124893,"_5":14899,"_28426":124757,"_3090":55390},[],{"_3640":74303,"_31229":74258,"_21648":124895,"_5":14899,"_28426":124757,"_3090":124896},[],"Crear o actualizar Things en IoT Core",{"_3640":74304,"_31229":74258,"_21648":124898,"_5":14899,"_28426":124757,"_3090":55396},[],{"_3640":74305,"_31229":74258,"_21648":124900,"_5":14899,"_28426":124757,"_3090":124901},[],"Aprovisionar Things mediante plantilla",{"_3640":74306,"_31229":74258,"_21648":124903,"_5":14899,"_28426":124757,"_3090":55402},[],{"_3640":74307,"_31229":74258,"_21648":124905,"_5":14899,"_28426":124757,"_3090":124906},[],"Registrar certificados de dispositivo",{"_3640":74308,"_31229":74258,"_21648":124908,"_5":14899,"_28426":124757,"_3090":55408},[],{"_3640":74309,"_31229":74258,"_21648":124910,"_5":14899,"_28426":124757,"_3090":124911},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3640":74310,"_31229":74258,"_21648":124913,"_5":14899,"_28426":124757,"_3090":55414},[],{"_3640":74311,"_31229":74258,"_21648":124915,"_5":14899,"_28426":124757,"_3090":124916},[],"Crear y adjuntar políticas IoT",{"_3640":74312,"_31229":74258,"_21648":124918,"_5":14899,"_28426":124757,"_3090":55420},[],{"_3640":74313,"_31229":74258,"_21648":124920,"_5":14899,"_28426":124757,"_3090":124921},[],"Gestionar grupos de Things",{"_3640":74314,"_31229":74258,"_21648":124923,"_5":14899,"_28426":124757,"_3090":55426},[],{"_3640":74315,"_31229":74258,"_21648":124925,"_5":14899,"_28426":124757,"_3090":124926},[],"Crear plantillas JITP",{"_3640":74316,"_31229":74258,"_21648":124928,"_5":14899,"_28426":124757,"_3090":55432},[],{"_3640":74317,"_31229":74258,"_21648":124930,"_5":14899,"_28426":124757,"_3090":124931},[],"Leer y escribir el Device Shadow",{"_3640":74318,"_31229":74258,"_21648":124933,"_5":14899,"_28426":124757,"_3090":124934},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3640":74319,"_31229":74258,"_21648":124936,"_5":14899,"_28426":124761,"_3090":124937},[],"Parámetro",{"_3640":74320,"_31229":74258,"_21648":124939,"_5":14899,"_28426":124761,"_3090":124940},[],"Tipo",{"_3640":74321,"_31229":74258,"_21648":124942,"_5":14899,"_28426":124761,"_3090":124943},[],"Requerido",{"_3640":74322,"_31229":74258,"_21648":124945,"_5":14899,"_28426":124761,"_3090":124946},[],"Descripción",{"_3640":74323,"_31229":74258,"_21648":124948,"_5":14899,"_28426":124761,"_3090":55453},[],{"_3640":74324,"_31229":74258,"_21648":124950,"_5":14899,"_28426":124761,"_3090":25835},[],{"_3640":74325,"_31229":74258,"_21648":124952,"_5":14899,"_28426":124761,"_3090":124953},[],"Sí",{"_3640":74326,"_31229":74258,"_21648":124955,"_5":14899,"_28426":124761,"_3090":124956},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3640":74327,"_31229":74258,"_21648":124958,"_5":14899,"_28426":124761,"_3090":55464},[],{"_3640":74328,"_31229":74258,"_21648":124960,"_5":14899,"_28426":124761,"_3090":25835},[],{"_3640":74329,"_31229":74258,"_21648":124962,"_5":14899,"_28426":124761,"_3090":124953},[],{"_3640":74330,"_31229":74258,"_21648":124964,"_5":14899,"_28426":124761,"_3090":124965},[],"Región AWS donde opera el conector.",{"_3640":74331,"_31229":74258,"_21648":124967,"_5":14899,"_28426":124761,"_3090":55474},[],{"_3640":74332,"_31229":74258,"_21648":124969,"_5":14899,"_28426":124761,"_3090":25835},[],{"_3640":74333,"_31229":74258,"_21648":124971,"_5":14899,"_28426":124761,"_3090":124953},[],{"_3640":74334,"_31229":74258,"_21648":124973,"_5":14899,"_28426":124761,"_3090":124974},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3640":74335,"_31229":74258,"_21648":124976,"_5":14899,"_28426":124761,"_3090":55484},[],{"_3640":74336,"_31229":74258,"_21648":124978,"_5":14899,"_28426":124761,"_3090":25835},[],{"_3640":74337,"_31229":74258,"_21648":124980,"_5":14899,"_28426":124761,"_3090":124981},[],"Solo con `auth_method=static`",{"_3640":74338,"_31229":74258,"_21648":124983,"_5":14899,"_28426":124761,"_3090":124984},[],"Clave de acceso AWS.",{"_3640":74339,"_31229":74258,"_21648":124986,"_5":14899,"_28426":124761,"_3090":55495},[],{"_3640":74340,"_31229":74258,"_21648":124988,"_5":14899,"_28426":124761,"_3090":25835},[],{"_3640":74341,"_31229":74258,"_21648":124990,"_5":14899,"_28426":124761,"_3090":124981},[],{"_3640":74342,"_31229":74258,"_21648":124992,"_5":14899,"_28426":124761,"_3090":124993},[],"Clave secreta AWS.",{"_3640":74343,"_31229":74258,"_21648":124995,"_5":14899,"_28426":124761,"_3090":55505},[],{"_3640":74344,"_31229":74258,"_21648":124997,"_5":14899,"_28426":124761,"_3090":25835},[],{"_3640":74345,"_31229":74258,"_21648":124999,"_5":14899,"_28426":124761,"_3090":55510},[],{"_3640":74346,"_31229":74258,"_21648":125001,"_5":14899,"_28426":124761,"_3090":125002},[],"Token de sesión (con `auth_method=static`).",{"_3640":74347,"_31229":74258,"_21648":125004,"_5":14899,"_28426":124761,"_3090":55516},[],{"_3640":74348,"_31229":74258,"_21648":125006,"_5":14899,"_28426":124761,"_3090":25835},[],{"_3640":74349,"_31229":74258,"_21648":125008,"_5":14899,"_28426":124761,"_3090":125009},[],"Solo con `auth_method=role`",{"_3640":74350,"_31229":74258,"_21648":125011,"_5":14899,"_28426":124761,"_3090":125012},[],"ARN del rol a asumir.",{"_3640":74351,"_31229":74258,"_21648":125014,"_5":14899,"_28426":124761,"_3090":55527},[],{"_3640":74352,"_31229":74258,"_21648":125016,"_5":14899,"_28426":124761,"_3090":25835},[],{"_3640":74353,"_31229":74258,"_21648":125018,"_5":14899,"_28426":124761,"_3090":55510},[],{"_3640":74354,"_31229":74258,"_21648":125020,"_5":14899,"_28426":124761,"_3090":125021},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3640":74355,"_31229":74258,"_21648":125023,"_5":14899,"_28426":124761,"_3090":55537},[],{"_3640":74356,"_31229":74258,"_21648":125025,"_5":14899,"_28426":124761,"_3090":93182},[],{"_3640":74357,"_31229":74258,"_21648":125027,"_5":14899,"_28426":124761,"_3090":124953},[],{"_3640":74358,"_31229":74258,"_21648":125029,"_5":14899,"_28426":124761,"_3090":125030},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3640":74359,"_31229":74258,"_21648":125032,"_5":14899,"_28426":124761,"_3090":55547},[],{"_3640":74360,"_31229":74258,"_21648":125034,"_5":14899,"_28426":124761,"_3090":25835},[],{"_3640":74361,"_31229":74258,"_21648":125036,"_5":14899,"_28426":124761,"_3090":124953},[],{"_3640":74362,"_31229":74258,"_21648":125038,"_5":14899,"_28426":124761,"_3090":125039},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3640":74363,"_31229":74258,"_21648":125041,"_5":14899,"_28426":124761,"_3090":55557},[],{"_3640":74364,"_31229":74258,"_21648":125043,"_5":14899,"_28426":124761,"_3090":25835},[],{"_3640":74365,"_31229":74258,"_21648":125045,"_5":14899,"_28426":124761,"_3090":124953},[],{"_3640":74366,"_31229":74258,"_21648":125047,"_5":14899,"_28426":124761,"_3090":125048},[],"URL HTTP del Device Manager de Lamassu.",{"_3640":74367,"_31229":74258,"_21648":125050,"_5":14899,"_28426":124761,"_3090":55567},[],{"_3640":74368,"_31229":74258,"_21648":125052,"_5":14899,"_28426":124761,"_3090":25835},[],{"_3640":74369,"_31229":74258,"_21648":125054,"_5":14899,"_28426":124761,"_3090":124953},[],{"_3640":74370,"_31229":74258,"_21648":125056,"_5":14899,"_28426":124761,"_3090":125057},[],"URL HTTP del servicio de CA de Lamassu.",{"_3640":74371,"_31229":74258,"_21648":125059,"_5":14899,"_28426":124765,"_3090":125060},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3640":74372,"_31229":74258,"_21648":125062,"_5":14899,"_28426":124765,"_3090":125063},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3640":74373,"_31229":74258,"_21648":125065,"_5":14899,"_28426":124765,"_3090":125066},[],"Tipo de CloudEvent",{"_3640":74374,"_31229":74258,"_21648":125068,"_5":14899,"_28426":124765,"_3090":125069},[],"Recurso en Lamassu",{"_3640":74375,"_31229":74258,"_21648":125071,"_5":14899,"_28426":124765,"_3090":125072},[],"Recurso AWS",{"_3640":74376,"_31229":74258,"_21648":125074,"_5":14899,"_28426":124765,"_3090":125075},[],"Acciones IAM",{"_3640":74377,"_31229":74258,"_21648":125077,"_5":14899,"_28426":124765,"_3090":125078},[],"Llamadas AWS y efecto",{"_3640":74378,"_31229":74258,"_21648":125080,"_5":14899,"_28426":124765,"_3090":125081},[],"Dónde en esta página",{"_3640":74379,"_31229":74258,"_21648":125083,"_5":14899,"_28426":124765,"_3090":55601},[],{"_3640":74380,"_31229":74258,"_21648":125085,"_5":14899,"_28426":124765,"_3090":55604},[],{"_3640":74381,"_31229":74258,"_21648":125087,"_5":14899,"_28426":124765,"_3090":55607},[],{"_3640":74382,"_31229":74258,"_21648":125089,"_5":14899,"_28426":124765,"_3090":55610},[],{"_3640":74383,"_31229":74258,"_21648":125091,"_5":14899,"_28426":124765,"_3090":125092},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3640":74384,"_31229":74258,"_21648":125094,"_5":14899,"_28426":124765,"_3090":124778},[],{"_3640":74385,"_31229":74258,"_21648":125096,"_5":14899,"_28426":124765,"_3090":55618},[],{"_3640":74386,"_31229":74258,"_21648":125098,"_5":14899,"_28426":124765,"_3090":55621},[],{"_3640":74387,"_31229":74258,"_21648":125100,"_5":14899,"_28426":124765,"_3090":55624},[],{"_3640":74388,"_31229":74258,"_21648":125102,"_5":14899,"_28426":124765,"_3090":55627},[],{"_3640":74389,"_31229":74258,"_21648":125104,"_5":14899,"_28426":124765,"_3090":125105},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3640":74390,"_31229":74258,"_21648":125107,"_5":14899,"_28426":124765,"_3090":124804},[],{"_3640":74391,"_31229":74258,"_21648":125109,"_5":14899,"_28426":124765,"_3090":55635},[],{"_3640":74392,"_31229":74258,"_21648":125111,"_5":14899,"_28426":124765,"_3090":125112},[],"Dispositivo",{"_3640":74393,"_31229":74258,"_21648":125114,"_5":14899,"_28426":124765,"_3090":55641},[],{"_3640":74394,"_31229":74258,"_21648":125116,"_5":14899,"_28426":124765,"_3090":55644},[],{"_3640":74395,"_31229":74258,"_21648":125118,"_5":14899,"_28426":124765,"_3090":125119},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3640":74396,"_31229":74258,"_21648":125121,"_5":14899,"_28426":124765,"_3090":124812},[],{"_3640":74397,"_31229":74258,"_21648":125123,"_5":14899,"_28426":124765,"_3090":55652},[],{"_3640":74398,"_31229":74258,"_21648":125125,"_5":14899,"_28426":124765,"_3090":125126},[],"Certificado",{"_3640":74399,"_31229":74258,"_21648":125128,"_5":14899,"_28426":124765,"_3090":55658},[],{"_3640":74400,"_31229":74258,"_21648":125130,"_5":14899,"_28426":124765,"_3090":125131},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3640":74401,"_31229":74258,"_21648":125133,"_5":14899,"_28426":124765,"_3090":125134},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3640":74402,"_31229":74258,"_21648":125136,"_5":14899,"_28426":124765,"_3090":124824},[],{"_3640":74403,"_31229":74258,"_21648":125138,"_5":14899,"_28426":124765,"_3090":55669},[],{"_3640":74404,"_31229":74258,"_21648":125140,"_5":14899,"_28426":124765,"_3090":125141},[],"Certificado / Dispositivo",{"_3640":74405,"_31229":74258,"_21648":125143,"_5":14899,"_28426":124765,"_3090":55675},[],{"_3640":74406,"_31229":74258,"_21648":125145,"_5":14899,"_28426":124765,"_3090":51450},[],{"_3640":74407,"_31229":74258,"_21648":125147,"_5":14899,"_28426":124765,"_3090":125148},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3640":74408,"_31229":74258,"_21648":125150,"_5":14899,"_28426":124765,"_3090":124832},[],{"_3640":74409,"_31229":74258,"_21648":125152,"_5":14899,"_28426":124769,"_3090":125153},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3640":74410,"_31229":74258,"_21648":125155,"_5":14899,"_28426":124773,"_3090":125156},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3640":74411,"_31229":74258,"_21648":125158,"_5":14899,"_28426":124773,"_3090":125159},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3640":74412,"_31229":74258,"_21648":125161,"_5":14899,"_28426":124777,"_3090":125162},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3640":74413,"_31229":74258,"_21648":125164,"_5":14899,"_28426":124777,"_3090":125165},[],"Transición",{"_3640":74414,"_31229":74258,"_21648":125167,"_5":14899,"_28426":124777,"_3090":125168},[],"Llamadas AWS",{"_3640":74415,"_31229":74258,"_21648":125170,"_5":14899,"_28426":124777,"_3090":125171},[],"`NoRegistrada` → `Solicitada`",{"_3640":74416,"_31229":74258,"_21648":125173,"_5":14899,"_28426":124777,"_3090":125174},[],"ninguna (solo escritura de metadatos)",{"_3640":74417,"_31229":74258,"_21648":125176,"_5":14899,"_28426":124777,"_3090":125177},[],"`Solicitada` → `Registrando`",{"_3640":74418,"_31229":74258,"_21648":125179,"_5":14899,"_28426":124777,"_3090":125180},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3640":74419,"_31229":74258,"_21648":125182,"_5":14899,"_28426":124777,"_3090":125183},[],"`Registrando` → `Completada`",{"_3640":74420,"_31229":74258,"_21648":125185,"_5":14899,"_28426":124777,"_3090":125186},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3640":74421,"_31229":74258,"_21648":125188,"_5":14899,"_28426":124777,"_3090":125189},[],"`Registrando` → `Fallida`",{"_3640":74422,"_31229":74258,"_21648":125191,"_5":14899,"_28426":124777,"_3090":125192},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3640":74423,"_31229":74258,"_21648":125194,"_5":14899,"_28426":124777,"_3090":125195},[],"`Fallida` / `Completada` → `Solicitada`",{"_3640":74424,"_31229":74258,"_21648":125197,"_5":14899,"_28426":124777,"_3090":125198},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3640":74425,"_31229":74258,"_21648":125200,"_5":14899,"_28426":124781,"_3090":125201},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3640":74426,"_31229":74258,"_21648":125203,"_5":14899,"_28426":124781,"_3090":125204},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3640":74427,"_31229":74258,"_21648":125206,"_5":14899,"_28426":124781,"_3090":125207},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3640":74428,"_31229":74258,"_21648":125209,"_5":14899,"_28426":124781,"_3090":125210},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3640":74429,"_31229":74258,"_21648":125212,"_5":14899,"_28426":124781,"_3090":125213},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3640":74430,"_31229":74258,"_21648":125215,"_5":14899,"_28426":124781,"_3090":125216},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3640":74431,"_31229":74258,"_21648":125218,"_5":14899,"_28426":124784,"_3090":125219},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3640":74432,"_31229":74258,"_21648":125221,"_5":14899,"_28426":124787,"_3090":125222},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3640":74433,"_31229":74258,"_21648":125224,"_5":14899,"_28426":124787,"_3090":125225},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3640":74434,"_31229":74258,"_21648":125227,"_5":14899,"_28426":124791,"_3090":125228},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3640":74435,"_31229":74258,"_21648":125230,"_5":14899,"_28426":124795,"_3090":125231},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3640":74436,"_31229":74258,"_21648":125233,"_5":14899,"_28426":124795,"_3090":125234},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3640":74437,"_31229":74258,"_21648":125236,"_5":14899,"_28426":124795,"_3090":125237},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3640":74438,"_31229":74258,"_21648":125239,"_5":14899,"_28426":124795,"_3090":125240},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3640":74439,"_31229":74258,"_21648":125242,"_5":14899,"_28426":124795,"_3090":125243},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3640":74440,"_31229":74258,"_21648":125245,"_5":14899,"_28426":124795,"_3090":125246},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3640":74441,"_31229":74258,"_21648":125248,"_5":14899,"_28426":124799,"_3090":125249},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3640":74442,"_31229":74258,"_21648":125251,"_5":14899,"_28426":124799,"_3090":125252},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3640":74443,"_31229":74258,"_21648":125254,"_5":14899,"_28426":124799,"_3090":125255},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3640":74444,"_31229":74258,"_21648":125257,"_5":14899,"_28426":124799,"_3090":125258},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3640":74445,"_31229":74258,"_21648":125260,"_5":14899,"_28426":124799,"_3090":125261},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3640":74446,"_31229":74258,"_21648":125263,"_5":14899,"_28426":124803,"_3090":125264},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3640":74447,"_31229":74258,"_21648":125266,"_5":14899,"_28426":124803,"_3090":125165},[],{"_3640":74448,"_31229":74258,"_21648":125268,"_5":14899,"_28426":124803,"_3090":125168},[],{"_3640":74449,"_31229":74258,"_21648":125270,"_5":14899,"_28426":124803,"_3090":125271},[],"`SinConfigurar` → `None` / `Auto`",{"_3640":74450,"_31229":74258,"_21648":125273,"_5":14899,"_28426":124803,"_3090":125274},[],"ninguna (solo configuración)",{"_3640":74451,"_31229":74258,"_21648":125276,"_5":14899,"_28426":124803,"_3090":55812},[],{"_3640":74452,"_31229":74258,"_21648":125278,"_5":14899,"_28426":124803,"_3090":125274},[],{"_3640":74453,"_31229":74258,"_21648":125280,"_5":14899,"_28426":124803,"_3090":125281},[],"Cualquiera → `Jitp`",{"_3640":74454,"_31229":74258,"_21648":125283,"_5":14899,"_28426":124803,"_3090":125284},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3640":74455,"_31229":74258,"_21648":125286,"_5":14899,"_28426":124803,"_3090":55823},[],{"_3640":74456,"_31229":74258,"_21648":125288,"_5":14899,"_28426":124803,"_3090":125289},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3640":74457,"_31229":74258,"_21648":125291,"_5":14899,"_28426":124807,"_3090":125292},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3640":74458,"_31229":74258,"_21648":125294,"_5":14899,"_28426":124807,"_3090":125295},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3640":74459,"_31229":74258,"_21648":125297,"_5":14899,"_28426":124807,"_3090":125298},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3640":74460,"_31229":74258,"_21648":125300,"_5":14899,"_28426":124811,"_3090":125301},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3640":74461,"_31229":74258,"_21648":125303,"_5":14899,"_28426":124811,"_3090":125165},[],{"_3640":74462,"_31229":74258,"_21648":125305,"_5":14899,"_28426":124811,"_3090":125168},[],{"_3640":74463,"_31229":74258,"_21648":125307,"_5":14899,"_28426":124811,"_3090":125308},[],"`Ausente` → `Aprovisionado`",{"_3640":74464,"_31229":74258,"_21648":125310,"_5":14899,"_28426":124811,"_3090":125311},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3640":74465,"_31229":74258,"_21648":125313,"_5":14899,"_28426":124811,"_3090":125314},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3640":74466,"_31229":74258,"_21648":125316,"_5":14899,"_28426":124811,"_3090":125317},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3640":74467,"_31229":74258,"_21648":125319,"_5":14899,"_28426":124811,"_3090":125320},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3640":74468,"_31229":74258,"_21648":125322,"_5":14899,"_28426":124815,"_3090":125323},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3640":74469,"_31229":74258,"_21648":125325,"_5":14899,"_28426":124815,"_3090":125326},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3640":74470,"_31229":74258,"_21648":125328,"_5":14899,"_28426":124815,"_3090":125329},[],"Para que el flujo JITP funcione correctamente:",{"_3640":74471,"_31229":74258,"_21648":125331,"_5":14899,"_28426":124815,"_3090":125332},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3640":74472,"_31229":74258,"_21648":125334,"_5":14899,"_28426":124815,"_3090":125335},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3640":74473,"_31229":74258,"_21648":125337,"_5":14899,"_28426":124815,"_3090":125338},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3640":74474,"_31229":74258,"_21648":125340,"_5":14899,"_28426":124815,"_3090":125341},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3640":74475,"_31229":74258,"_21648":125343,"_5":14899,"_28426":124819,"_3090":125344},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3640":74476,"_31229":74258,"_21648":125346,"_5":14899,"_28426":124819,"_3090":125347},[],"Estado en Lamassu",{"_3640":74477,"_31229":74258,"_21648":125349,"_5":14899,"_28426":124819,"_3090":125350},[],"Razón de revocación",{"_3640":74478,"_31229":74258,"_21648":125352,"_5":14899,"_28426":124819,"_3090":125353},[],"Estado en AWS IoT Core",{"_3640":74479,"_31229":74258,"_21648":125355,"_5":14899,"_28426":124819,"_3090":55893},[],{"_3640":74480,"_31229":74258,"_21648":125357,"_5":14899,"_28426":124819,"_3090":125358},[],"Ninguna",{"_3640":74481,"_31229":74258,"_21648":125360,"_5":14899,"_28426":124819,"_3090":55899},[],{"_3640":74482,"_31229":74258,"_21648":125362,"_5":14899,"_28426":124819,"_3090":55902},[],{"_3640":74483,"_31229":74258,"_21648":125364,"_5":14899,"_28426":124819,"_3090":55905},[],{"_3640":74484,"_31229":74258,"_21648":125366,"_5":14899,"_28426":124819,"_3090":55908},[],{"_3640":74485,"_31229":74258,"_21648":125368,"_5":14899,"_28426":124819,"_3090":55902},[],{"_3640":74486,"_31229":74258,"_21648":125370,"_5":14899,"_28426":124819,"_3090":125371},[],"Cualquier otra razón",{"_3640":74487,"_31229":74258,"_21648":125373,"_5":14899,"_28426":124819,"_3090":55916},[],{"_3640":74488,"_31229":74258,"_21648":125375,"_5":14899,"_28426":124819,"_3090":125376},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3640":74489,"_31229":74258,"_21648":125378,"_5":14899,"_28426":124823,"_3090":125379},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3640":74490,"_31229":74258,"_21648":125381,"_5":14899,"_28426":124823,"_3090":125165},[],{"_3640":74491,"_31229":74258,"_21648":125383,"_5":14899,"_28426":124823,"_3090":125168},[],{"_3640":74492,"_31229":74258,"_21648":125385,"_5":14899,"_28426":124823,"_3090":125386},[],"`NoSincronizado` → `Active`",{"_3640":74493,"_31229":74258,"_21648":125388,"_5":14899,"_28426":124823,"_3090":55408},[],{"_3640":74494,"_31229":74258,"_21648":125390,"_5":14899,"_28426":124823,"_3090":55934},[],{"_3640":74495,"_31229":74258,"_21648":125392,"_5":14899,"_28426":124823,"_3090":125393},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3640":74496,"_31229":74258,"_21648":125395,"_5":14899,"_28426":124823,"_3090":55940},[],{"_3640":74497,"_31229":74258,"_21648":125397,"_5":14899,"_28426":124823,"_3090":125393},[],{"_3640":74498,"_31229":74258,"_21648":125399,"_5":14899,"_28426":124823,"_3090":55945},[],{"_3640":74499,"_31229":74258,"_21648":125401,"_5":14899,"_28426":124823,"_3090":55408},[],{"_3640":74500,"_31229":74258,"_21648":125403,"_5":14899,"_28426":124823,"_3090":55950},[],{"_3640":74501,"_31229":74258,"_21648":125405,"_5":14899,"_28426":124823,"_3090":125406},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3640":74502,"_31229":74258,"_21648":125408,"_5":14899,"_28426":124827,"_3090":125409},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3640":74503,"_31229":74258,"_21648":125411,"_5":14899,"_28426":124827,"_3090":125412},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3640":74504,"_31229":74258,"_21648":125414,"_5":14899,"_28426":124827,"_3090":125415},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3640":74505,"_31229":74258,"_21648":125417,"_5":14899,"_28426":124831,"_3090":125418},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3640":74506,"_31229":74258,"_21648":125420,"_5":14899,"_28426":124831,"_3090":125421},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3640":74507,"_31229":74258,"_21648":125423,"_5":14899,"_28426":124835,"_3090":125424},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3640":74508,"_31229":74258,"_21648":125426,"_5":14899,"_28426":124835,"_3090":125427},[],"Existen dos tipos de acciones:",{"_3640":74509,"_31229":74258,"_21648":125429,"_5":14899,"_28426":124835,"_3090":125430},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3640":74510,"_31229":74258,"_21648":125432,"_5":14899,"_28426":124835,"_3090":125433},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3640":74511,"_31229":74258,"_21648":125435,"_5":14899,"_28426":124835,"_3090":125436},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3640":74512,"_31229":74258,"_21648":125438,"_5":14899,"_28426":124839,"_3090":125439},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3640":74513,"_31229":74258,"_21648":125441,"_5":14899,"_28426":124839,"_3090":125442},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3640":74514,"_31229":74258,"_21648":125444,"_5":14899,"_28426":124839,"_3090":125445},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3640":74515,"_31229":74258,"_21648":125447,"_5":14899,"_28426":124843,"_3090":125448},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3640":74516,"_31229":74258,"_21648":125450,"_5":14899,"_28426":124843,"_3090":125451},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3640":74517,"_31229":74258,"_21648":125453,"_5":14899,"_28426":124843,"_3090":125454},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3640":74518,"_31229":74258,"_21648":125456,"_5":14899,"_28426":124843,"_3090":125457},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3640":74519,"_31229":74258,"_21648":125459,"_5":14899,"_28426":124843,"_3090":125460},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3640":74520,"_31229":74258,"_21648":125462,"_5":14899,"_28426":124843,"_3090":125463},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3640":74521,"_31229":74258,"_21648":125465,"_5":14899,"_28426":124843,"_3090":125466},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3640":74522,"_31229":74258,"_21648":125468,"_5":14899,"_28426":124843,"_3090":125469},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3640":74523,"_31229":74258,"_21648":125471,"_5":14899,"_28426":124843,"_3090":125472},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3640":74524,"_31229":74258,"_21648":125474,"_5":14899,"_28426":124843,"_3090":125475},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3640":74525,"_31229":74258,"_21648":125477,"_5":14899,"_28426":124843,"_3090":125478},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3640":74526,"_31229":74258,"_21648":125480,"_5":14899,"_28426":124843,"_3090":125481},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3640":74527,"_31229":74258,"_21648":125483,"_5":14899,"_28426":124843,"_3090":125484},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3640":74528,"_31229":74258,"_21648":125486,"_5":14899,"_28426":124843,"_3090":125487},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3640":74529,"_31229":74258,"_21648":125489,"_5":14899,"_28426":124843,"_3090":125490},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3640":74530,"_31229":74258,"_21648":125492,"_5":14899,"_28426":124843,"_3090":125493},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3640":74531,"_31229":74258,"_21648":125495,"_5":14899,"_28426":124843,"_3090":125496},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3640":74532,"_31229":74258,"_21648":125498,"_5":14899,"_28426":124843,"_3090":125499},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3640":74533,"_31229":74258,"_21648":125501,"_5":14899,"_28426":124843,"_3090":125502},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3640":74534,"_31229":74258,"_21648":125504,"_5":14899,"_28426":124843,"_3090":125505},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3640":74535,"_31229":74258,"_21648":125507,"_5":14899,"_28426":124843,"_3090":125508},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3640":74536,"_31229":74258,"_21648":125510,"_5":14899,"_28426":124843,"_3090":125511},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3640":74537,"_31229":74258,"_21648":125513,"_5":14899,"_28426":124843,"_3090":125514},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3640":74538,"_31229":74258,"_21648":125516,"_5":14899,"_28426":124843,"_3090":125517},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3640":74539,"_31229":74539,"_5":15259,"_3090":53754,"_31567":125519,"_21648":125520,"_28426":74539},[51054,122173,53754],[],{"_3640":74540,"_31229":74539,"_21648":125522,"_5":14899,"_28426":74539,"_3090":125523},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3640":74541,"_31229":74539,"_5":31564,"_21648":125525,"_28426":125526,"_3090":125527},[],"/docs/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3640":74542,"_31229":74539,"_5":31564,"_21648":125529,"_28426":125530,"_3090":123318},[],"/docs/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3640":74543,"_31229":74539,"_5":31564,"_21648":125532,"_28426":125533,"_3090":123496},[],"/docs/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3640":74544,"_31229":74539,"_5":31564,"_21648":125535,"_28426":125536,"_3090":124742},[],"/docs/es/platform/iot-fleets/overview#integraciones",{"_3640":74545,"_31229":74539,"_5":31564,"_21648":125538,"_28426":125539,"_3090":125540},[],"/docs/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3640":74546,"_31229":74539,"_21648":125542,"_5":14899,"_28426":74539,"_3090":125543},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3640":74547,"_31229":74539,"_21648":125545,"_5":14899,"_28426":125526,"_3090":125546},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3640":74548,"_31229":74539,"_21648":125548,"_5":14899,"_28426":125526,"_3090":125549},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3640":74549,"_31229":74539,"_21648":125551,"_5":14899,"_28426":125530,"_3090":125552},[],"Recurso",{"_3640":74550,"_31229":74539,"_21648":125554,"_5":14899,"_28426":125530,"_3090":125555},[],"Qué representa",{"_3640":74551,"_31229":74539,"_21648":125557,"_5":14899,"_28426":125530,"_3090":125558},[],"**Dispositivo**",{"_3640":74552,"_31229":74539,"_21648":125560,"_5":14899,"_28426":125530,"_3090":125561},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3640":74553,"_31229":74539,"_21648":125563,"_5":14899,"_28426":125530,"_3090":125564},[],"**Identidad**",{"_3640":74554,"_31229":74539,"_21648":125566,"_5":14899,"_28426":125530,"_3090":125567},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3640":74555,"_31229":74539,"_21648":125569,"_5":14899,"_28426":125530,"_3090":56117},[],{"_3640":74556,"_31229":74539,"_21648":125571,"_5":14899,"_28426":125530,"_3090":125572},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3640":74557,"_31229":74539,"_21648":125574,"_5":14899,"_28426":125530,"_3090":125575},[],"**Flota**",{"_3640":74558,"_31229":74539,"_21648":125577,"_5":14899,"_28426":125530,"_3090":125578},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3640":74559,"_31229":74539,"_21648":125580,"_5":14899,"_28426":125530,"_3090":125581},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3640":74560,"_31229":74539,"_21648":125583,"_5":14899,"_28426":125530,"_3090":125584},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3640":74561,"_31229":74539,"_21648":125586,"_5":14899,"_28426":125533,"_3090":125587},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3640":74562,"_31229":74539,"_21648":125589,"_5":14899,"_28426":125533,"_3090":125590},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3640":74563,"_31229":74539,"_21648":125592,"_5":14899,"_28426":125533,"_3090":125593},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3640":74564,"_31229":74539,"_21648":125595,"_5":14899,"_28426":125533,"_3090":125596},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3640":74565,"_31229":74539,"_21648":125598,"_5":14899,"_28426":125533,"_3090":125599},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3640":74566,"_31229":74539,"_21648":125601,"_5":14899,"_28426":125533,"_3090":125602},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3640":74567,"_31229":74539,"_21648":125604,"_5":14899,"_28426":125533,"_3090":125605},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3640":74568,"_31229":74539,"_21648":125607,"_5":14899,"_28426":125533,"_3090":125608},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3640":74569,"_31229":74539,"_21648":125610,"_5":14899,"_28426":125536,"_3090":125611},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3640":74570,"_31229":74539,"_21648":125613,"_5":14899,"_28426":125536,"_3090":125614},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3640":74571,"_31229":74539,"_21648":125616,"_5":14899,"_28426":125539,"_3090":125617},[],"Participante",{"_3640":74572,"_31229":74539,"_21648":125619,"_5":14899,"_28426":125539,"_3090":125620},[],"Responsabilidad",{"_3640":74573,"_31229":74539,"_21648":125622,"_5":14899,"_28426":125539,"_3090":125623},[],"Administrador PKI",{"_3640":74574,"_31229":74539,"_21648":125625,"_5":14899,"_28426":125539,"_3090":125626},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3640":74575,"_31229":74539,"_21648":125628,"_5":14899,"_28426":125539,"_3090":125629},[],"Administrador del aprovisionamiento",{"_3640":74576,"_31229":74539,"_21648":125631,"_5":14899,"_28426":125539,"_3090":125632},[],"DMS, admisión, autenticación por operación e inventario.",{"_3640":74577,"_31229":74539,"_21648":125634,"_5":14899,"_28426":125539,"_3090":125635},[],"Integrador del dispositivo",{"_3640":74578,"_31229":74539,"_21648":125637,"_5":14899,"_28426":125539,"_3090":125638},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3640":74579,"_31229":74539,"_21648":125640,"_5":14899,"_28426":125539,"_3090":125641},[],"Integrador del consumidor",{"_3640":74580,"_31229":74539,"_21648":125643,"_5":14899,"_28426":125539,"_3090":125644},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3640":74581,"_31229":74539,"_21648":125646,"_5":14899,"_28426":125539,"_3090":125647},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3640":74582,"_31229":74582,"_5":15259,"_3090":125649,"_31567":125650,"_21648":125652,"_28426":74582},"Enrola y conecta tu primer dispositivo",[51054,122173,53754,125651],"Primeros pasos",[],{"_3640":74583,"_31229":74582,"_21648":125654,"_5":14899,"_28426":74582,"_3090":125655},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3640":74584,"_31229":74582,"_5":31564,"_21648":125657,"_28426":125658,"_3090":120691},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3640":74585,"_31229":74582,"_5":31564,"_21648":125660,"_28426":125661,"_3090":125662},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3640":74586,"_31229":74582,"_5":31564,"_21648":125664,"_28426":125665,"_3090":125666},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3640":74587,"_31229":74582,"_5":31564,"_21648":125668,"_28426":125669,"_3090":125670},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3640":74588,"_31229":74582,"_5":31564,"_21648":125672,"_28426":125673,"_3090":125674},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3640":74589,"_31229":74582,"_5":31564,"_21648":125676,"_28426":125677,"_3090":125678},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3640":74590,"_31229":74582,"_5":31564,"_21648":125680,"_28426":125681,"_3090":125682},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3640":74591,"_31229":74582,"_5":31564,"_21648":125684,"_28426":125685,"_3090":125686},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3640":74592,"_31229":74582,"_21648":125688,"_5":14899,"_28426":74582,"_3090":125689},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3640":74593,"_31229":74582,"_21648":125691,"_5":14899,"_28426":125658,"_3090":125692},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3640":74594,"_31229":74582,"_21648":125694,"_5":14899,"_28426":125658,"_3090":125695},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3640":74595,"_31229":74582,"_21648":125697,"_5":14899,"_28426":125658,"_3090":125698},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3640":74596,"_31229":74582,"_21648":125700,"_5":14899,"_28426":125658,"_3090":125701},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3640":74597,"_31229":74582,"_21648":125703,"_5":14899,"_28426":125658,"_3090":125704},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3640":74598,"_31229":74582,"_21648":125706,"_5":14899,"_28426":125661,"_3090":125707},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3640":74599,"_31229":74582,"_21648":125709,"_5":14899,"_28426":125661,"_3090":125710},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3640":74600,"_31229":74582,"_21648":125712,"_5":14899,"_28426":125665,"_3090":125713},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3640":74601,"_31229":74582,"_21648":125715,"_5":14899,"_28426":125665,"_3090":125716},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3640":74602,"_31229":74582,"_21648":125718,"_5":14899,"_28426":125665,"_3090":125719},[],"Ajuste",{"_3640":74603,"_31229":74582,"_21648":125721,"_5":14899,"_28426":125665,"_3090":125722},[],"Valor de evaluación",{"_3640":74604,"_31229":74582,"_21648":125724,"_5":14899,"_28426":125665,"_3090":56273},[],{"_3640":74605,"_31229":74582,"_21648":125726,"_5":14899,"_28426":125665,"_3090":125727},[],"Raíz emisora de `device-root.pem`.",{"_3640":74606,"_31229":74582,"_21648":125729,"_5":14899,"_28426":125665,"_3090":123630},[],{"_3640":74607,"_31229":74582,"_21648":125731,"_5":14899,"_28426":125665,"_3090":125732},[],"Perfil final de 1 hora que acabas de preparar.",{"_3640":74608,"_31229":74582,"_21648":125734,"_5":14899,"_28426":125665,"_3090":56284},[],{"_3640":74609,"_31229":74582,"_21648":125736,"_5":14899,"_28426":125665,"_3090":56287},[],{"_3640":74610,"_31229":74582,"_21648":125738,"_5":14899,"_28426":125665,"_3090":56290},[],{"_3640":74611,"_31229":74582,"_21648":125740,"_5":14899,"_28426":125665,"_3090":125741},[],"Habilitado.",{"_3640":74612,"_31229":74582,"_21648":125743,"_5":14899,"_28426":125665,"_3090":56296},[],{"_3640":74613,"_31229":74582,"_21648":125745,"_5":14899,"_28426":125665,"_3090":125746},[],"Deshabilitado; el ID debe ser nuevo.",{"_3640":74614,"_31229":74582,"_21648":125748,"_5":14899,"_28426":125665,"_3090":125749},[],"Autenticación inicial",{"_3640":74615,"_31229":74582,"_21648":125751,"_5":14899,"_28426":125665,"_3090":125752},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3640":74616,"_31229":74582,"_21648":125754,"_5":14899,"_28426":125665,"_3090":125755},[],"Autenticación de renovación",{"_3640":74617,"_31229":74582,"_21648":125757,"_5":14899,"_28426":125665,"_3090":125758},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3640":74618,"_31229":74582,"_21648":125760,"_5":14899,"_28426":125665,"_3090":56314},[],{"_3640":74619,"_31229":74582,"_21648":125762,"_5":14899,"_28426":125665,"_3090":125763},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3640":74620,"_31229":74582,"_21648":125765,"_5":14899,"_28426":125665,"_3090":56320},[],{"_3640":74621,"_31229":74582,"_21648":125767,"_5":14899,"_28426":125665,"_3090":125768},[],"1 hora.",{"_3640":74622,"_31229":74582,"_21648":125770,"_5":14899,"_28426":125665,"_3090":56326},[],{"_3640":74623,"_31229":74582,"_21648":125772,"_5":14899,"_28426":125665,"_3090":125773},[],"30 minutos / 10 minutos.",{"_3640":74624,"_31229":74582,"_21648":125775,"_5":14899,"_28426":125665,"_3090":56332},[],{"_3640":74625,"_31229":74582,"_21648":125777,"_5":14899,"_28426":125665,"_3090":125778},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3640":74626,"_31229":74582,"_21648":125780,"_5":14899,"_28426":125665,"_3090":54082},[],{"_3640":74627,"_31229":74582,"_21648":125782,"_5":14899,"_28426":125665,"_3090":125783},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3640":74628,"_31229":74582,"_21648":125785,"_5":14899,"_28426":125665,"_3090":56343},[],{"_3640":74629,"_31229":74582,"_21648":125787,"_5":14899,"_28426":125665,"_3090":125788},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3640":74630,"_31229":74582,"_21648":125790,"_5":14899,"_28426":125665,"_3090":125791},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3640":74631,"_31229":74582,"_21648":125793,"_5":14899,"_28426":125669,"_3090":125794},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3640":74632,"_31229":74582,"_21648":125796,"_5":14899,"_28426":125669,"_3090":125797},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3640":74633,"_31229":74582,"_21648":125799,"_5":14899,"_28426":125673,"_3090":125800},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3640":74634,"_31229":74582,"_21648":125802,"_5":14899,"_28426":125673,"_3090":125803},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3640":74635,"_31229":74582,"_21648":125805,"_5":14899,"_28426":125673,"_3090":125806},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3640":74636,"_31229":74582,"_21648":125808,"_5":14899,"_28426":125677,"_3090":125809},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3640":74637,"_31229":74582,"_21648":125811,"_5":14899,"_28426":125677,"_3090":125812},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3640":74638,"_31229":74582,"_21648":125814,"_5":14899,"_28426":125681,"_3090":125815},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3640":74639,"_31229":74582,"_21648":125817,"_5":14899,"_28426":125681,"_3090":125818},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3640":74640,"_31229":74582,"_21648":125820,"_5":14899,"_28426":125681,"_3090":125821},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3640":74641,"_31229":74582,"_21648":125823,"_5":14899,"_28426":125681,"_3090":125824},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3640":74642,"_31229":74582,"_21648":125826,"_5":14899,"_28426":125681,"_3090":125827},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3640":74643,"_31229":74582,"_21648":125829,"_5":14899,"_28426":125685,"_3090":125830},[],"Comprobación",{"_3640":74644,"_31229":74582,"_21648":125832,"_5":14899,"_28426":125685,"_3090":125833},[],"Resultado esperado",{"_3640":74645,"_31229":74582,"_21648":125835,"_5":14899,"_28426":125685,"_3090":125836},[],"Registro",{"_3640":74646,"_31229":74582,"_21648":125838,"_5":14899,"_28426":125685,"_3090":125839},[],"ID creado automáticamente y DMS correcto.",{"_3640":74647,"_31229":74582,"_21648":125841,"_5":14899,"_28426":125685,"_3090":125126},[],{"_3640":74648,"_31229":74582,"_21648":125843,"_5":14899,"_28426":125685,"_3090":125844},[],"CN, perfil, serie y clave verificados.",{"_3640":74649,"_31229":74582,"_21648":125846,"_5":14899,"_28426":125685,"_3090":125847},[],"Inventario",{"_3640":74650,"_31229":74582,"_21648":125849,"_5":14899,"_28426":125685,"_3090":125850},[],"Serie recibida visible como identidad actual y en el historial.",{"_3640":74651,"_31229":74582,"_21648":125852,"_5":14899,"_28426":125685,"_3090":125853},[],"Consumidor",{"_3640":74652,"_31229":74582,"_21648":125855,"_5":14899,"_28426":125685,"_3090":125856},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3640":74653,"_31229":74582,"_21648":125858,"_5":14899,"_28426":125685,"_3090":125859},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3640":74654,"_31229":74582,"_21648":125861,"_5":14899,"_28426":125685,"_3090":125862},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3640":74655,"_31229":74655,"_5":15259,"_3090":123335,"_31567":125864,"_21648":125865,"_28426":74655},[51054,122173,53754,125651],[],{"_3640":74656,"_31229":74655,"_21648":125867,"_5":14899,"_28426":74655,"_3090":125868},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3640":74657,"_31229":74655,"_5":31564,"_21648":125870,"_28426":125871,"_3090":120691},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3640":74658,"_31229":74655,"_5":31564,"_21648":125873,"_28426":125874,"_3090":125875},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3640":74659,"_31229":74655,"_5":31564,"_21648":125877,"_28426":125878,"_3090":125879},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3640":74660,"_31229":74655,"_5":31564,"_21648":125881,"_28426":125882,"_3090":125883},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3640":74661,"_31229":74655,"_5":31564,"_21648":125885,"_28426":125886,"_3090":125887},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3640":74662,"_31229":74655,"_5":31564,"_21648":125889,"_28426":125890,"_3090":125891},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3640":74663,"_31229":74655,"_5":31564,"_21648":125893,"_28426":125894,"_3090":125833},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3640":74664,"_31229":74655,"_5":31564,"_21648":125896,"_28426":125897,"_3090":125898},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3640":74665,"_31229":74655,"_5":31564,"_21648":125900,"_28426":125901,"_3090":125902},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3640":74666,"_31229":74655,"_21648":125904,"_5":14899,"_28426":74655,"_3090":125905},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3640":74667,"_31229":74655,"_21648":125907,"_5":14899,"_28426":74655,"_3090":125908},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3640":74668,"_31229":74655,"_21648":125910,"_5":14899,"_28426":125871,"_3090":125911},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3640":74669,"_31229":74655,"_21648":125913,"_5":14899,"_28426":125871,"_3090":125914},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3640":74670,"_31229":74655,"_21648":125916,"_5":14899,"_28426":125871,"_3090":125917},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3640":74671,"_31229":74655,"_21648":125919,"_5":14899,"_28426":125871,"_3090":125920},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3640":74672,"_31229":74655,"_21648":125922,"_5":14899,"_28426":125874,"_3090":125923},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3640":74673,"_31229":74655,"_21648":125925,"_5":14899,"_28426":125874,"_3090":125926},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3640":74674,"_31229":74655,"_21648":125928,"_5":14899,"_28426":125874,"_3090":125929},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3640":74675,"_31229":74655,"_21648":125931,"_5":14899,"_28426":125874,"_3090":125932},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3640":74676,"_31229":74655,"_21648":125934,"_5":14899,"_28426":125874,"_3090":125935},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3640":74677,"_31229":74655,"_21648":125937,"_5":14899,"_28426":125874,"_3090":125938},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3640":74678,"_31229":74655,"_21648":125940,"_5":14899,"_28426":125874,"_3090":125941},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3640":74679,"_31229":74655,"_21648":125943,"_5":14899,"_28426":125874,"_3090":125944},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3640":74680,"_31229":74655,"_21648":125946,"_5":14899,"_28426":125878,"_3090":125947},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3640":74681,"_31229":74655,"_21648":125949,"_5":14899,"_28426":125878,"_3090":56508},[],{"_3640":74682,"_31229":74655,"_21648":125951,"_5":14899,"_28426":125878,"_3090":125952},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3640":74683,"_31229":74655,"_21648":125954,"_5":14899,"_28426":125878,"_3090":125955},[],"**Icon** y **Tags**: clasificación opcional.",{"_3640":74684,"_31229":74655,"_21648":125957,"_5":14899,"_28426":125878,"_3090":125958},[],"Confirma el registro.",{"_3640":74685,"_31229":74655,"_21648":125960,"_5":14899,"_28426":125882,"_3090":125961},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3640":74686,"_31229":74655,"_21648":125963,"_5":14899,"_28426":125882,"_3090":125964},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3640":74687,"_31229":74655,"_21648":125966,"_5":14899,"_28426":125886,"_3090":125967},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3640":74688,"_31229":74655,"_21648":125969,"_5":14899,"_28426":125886,"_3090":125970},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3640":74689,"_31229":74655,"_21648":125972,"_5":14899,"_28426":125890,"_3090":125973},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3640":74690,"_31229":74655,"_21648":125975,"_5":14899,"_28426":125890,"_3090":125976},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3640":74691,"_31229":74655,"_21648":125978,"_5":14899,"_28426":125894,"_3090":125830},[],{"_3640":74692,"_31229":74655,"_21648":125980,"_5":14899,"_28426":125894,"_3090":125981},[],"Resultado",{"_3640":74693,"_31229":74655,"_21648":125983,"_5":14899,"_28426":125894,"_3090":125112},[],{"_3640":74694,"_31229":74655,"_21648":125985,"_5":14899,"_28426":125894,"_3090":125986},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3640":74695,"_31229":74655,"_21648":125988,"_5":14899,"_28426":125894,"_3090":125989},[],"Identidad actual",{"_3640":74696,"_31229":74655,"_21648":125991,"_5":14899,"_28426":125894,"_3090":125992},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3640":74697,"_31229":74655,"_21648":125994,"_5":14899,"_28426":125894,"_3090":125995},[],"Historial",{"_3640":74698,"_31229":74655,"_21648":125997,"_5":14899,"_28426":125894,"_3090":125998},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3640":74699,"_31229":74655,"_21648":126000,"_5":14899,"_28426":125894,"_3090":126001},[],"Clave y certificado",{"_3640":74700,"_31229":74655,"_21648":126003,"_5":14899,"_28426":125894,"_3090":126004},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3640":74701,"_31229":74655,"_21648":126006,"_5":14899,"_28426":125897,"_3090":126007},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3640":74702,"_31229":74655,"_21648":126009,"_5":14899,"_28426":125897,"_3090":126010},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3640":74703,"_31229":74655,"_21648":126012,"_5":14899,"_28426":125897,"_3090":126013},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3640":74704,"_31229":74655,"_21648":126015,"_5":14899,"_28426":125897,"_3090":126016},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3640":74705,"_31229":74655,"_21648":126018,"_5":14899,"_28426":125901,"_3090":126019},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3640":74706,"_31229":74655,"_21648":126021,"_5":14899,"_28426":125901,"_3090":126022},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3640":74707,"_31229":74655,"_21648":126024,"_5":14899,"_28426":125901,"_3090":126025},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3640":74708,"_31229":74708,"_5":15259,"_3090":126027,"_31567":126028,"_21648":126029,"_28426":74708},"Plataforma Lamassu IoT",[51054,122173],[],{"_3640":74709,"_31229":74708,"_21648":126031,"_5":14899,"_28426":74708,"_3090":126032},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3640":74710,"_31229":74708,"_5":31564,"_21648":126034,"_28426":126035,"_3090":125527},[],"/docs/es/platform/overview#empieza-aquí",{"_3640":74711,"_31229":74708,"_5":31564,"_21648":126037,"_28426":126038,"_3090":126039},[],"/docs/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3640":74712,"_31229":74708,"_5":31564,"_21648":126041,"_28426":126042,"_3090":126043},[],"/docs/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3640":74713,"_31229":74708,"_5":31564,"_21648":126045,"_28426":126046,"_3090":126047},[],"/docs/es/platform/overview#capacidades-principales","Capacidades principales",{"_3640":74714,"_31229":74708,"_5":31564,"_21648":126049,"_28426":126050,"_3090":126051},[],"/docs/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3640":74715,"_31229":74708,"_5":31564,"_21648":126053,"_28426":126054,"_3090":126055},[],"/docs/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3640":74716,"_31229":74708,"_5":31564,"_21648":126057,"_28426":126058,"_3090":126059},[],"/docs/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3640":74717,"_31229":74708,"_5":31564,"_21648":126061,"_28426":126062,"_3090":126063},[],"/docs/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3640":74718,"_31229":74708,"_5":31564,"_21648":126065,"_28426":126066,"_3090":126067},[],"/docs/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3640":74719,"_31229":74708,"_5":31564,"_21648":126069,"_28426":126070,"_3090":126071},[],"/docs/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3640":74720,"_31229":74708,"_5":31564,"_21648":126073,"_28426":126074,"_3090":126075},[],"/docs/es/platform/overview#referencia-operativa","Referencia operativa",{"_3640":74721,"_31229":74708,"_21648":126077,"_5":14899,"_28426":74708,"_3090":126078},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3640":74722,"_31229":74708,"_21648":126080,"_5":14899,"_28426":126035,"_3090":126081},[],"Elige el resultado que necesitas obtener:",{"_3640":74723,"_31229":74708,"_21648":126083,"_5":14899,"_28426":126035,"_3090":126084},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3640":74724,"_31229":74708,"_21648":126086,"_5":14899,"_28426":126035,"_3090":126087},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3640":74725,"_31229":74708,"_21648":126089,"_5":14899,"_28426":126035,"_3090":126090},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3640":74726,"_31229":74708,"_21648":126092,"_5":14899,"_28426":126038,"_3090":126093},[],"Bloque",{"_3640":74727,"_31229":74708,"_21648":126095,"_5":14899,"_28426":126038,"_3090":126096},[],"Qué gestionas",{"_3640":74728,"_31229":74708,"_21648":126098,"_5":14899,"_28426":126038,"_3090":126099},[],"Punto de entrada",{"_3640":74729,"_31229":74708,"_21648":126101,"_5":14899,"_28426":126038,"_3090":56661},[],{"_3640":74730,"_31229":74708,"_21648":126103,"_5":14899,"_28426":126038,"_3090":126104},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3640":74731,"_31229":74708,"_21648":126106,"_5":14899,"_28426":126038,"_3090":126107},[],"Visión general de PKI",{"_3640":74732,"_31229":74708,"_21648":126109,"_5":14899,"_28426":126038,"_3090":56670},[],{"_3640":74733,"_31229":74708,"_21648":126111,"_5":14899,"_28426":126038,"_3090":126112},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3640":74734,"_31229":74708,"_21648":126114,"_5":14899,"_28426":126038,"_3090":126115},[],"Visión general de IoT Fleets",{"_3640":74735,"_31229":74708,"_21648":126117,"_5":14899,"_28426":126038,"_3090":126118},[],"**Administración**",{"_3640":74736,"_31229":74708,"_21648":126120,"_5":14899,"_28426":126038,"_3090":126121},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3640":74737,"_31229":74708,"_21648":126123,"_5":14899,"_28426":126038,"_3090":122175},[],{"_3640":74738,"_31229":74708,"_21648":126125,"_5":14899,"_28426":126038,"_3090":126126},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3640":74739,"_31229":74708,"_21648":126128,"_5":14899,"_28426":126042,"_3090":126129},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3640":74740,"_31229":74708,"_21648":126131,"_5":14899,"_28426":126042,"_3090":126132},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3640":74741,"_31229":74708,"_21648":126134,"_5":14899,"_28426":126042,"_3090":126135},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3640":74742,"_31229":74708,"_21648":126137,"_5":14899,"_28426":126042,"_3090":126138},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3640":74743,"_31229":74708,"_21648":126140,"_5":14899,"_28426":126042,"_3090":126141},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3640":74744,"_31229":74708,"_21648":126143,"_5":14899,"_28426":126042,"_3090":126144},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3640":74745,"_31229":74708,"_21648":126146,"_5":14899,"_28426":126050,"_3090":126147},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3640":74746,"_31229":74708,"_21648":126149,"_5":14899,"_28426":126054,"_3090":126150},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3640":74747,"_31229":74708,"_21648":126152,"_5":14899,"_28426":126058,"_3090":126153},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3640":74748,"_31229":74708,"_21648":126155,"_5":14899,"_28426":126062,"_3090":126156},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3640":74749,"_31229":74708,"_21648":126158,"_5":14899,"_28426":126066,"_3090":126159},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3640":74750,"_31229":74708,"_21648":126161,"_5":14899,"_28426":126070,"_3090":126162},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3640":74751,"_31229":74708,"_21648":126164,"_5":14899,"_28426":126074,"_3090":125620},[],{"_3640":74752,"_31229":74708,"_21648":126166,"_5":14899,"_28426":126074,"_3090":126167},[],"Qué prepara o comprueba",{"_3640":74753,"_31229":74708,"_21648":126169,"_5":14899,"_28426":126074,"_3090":125623},[],{"_3640":74754,"_31229":74708,"_21648":126171,"_5":14899,"_28426":126074,"_3090":126172},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3640":74755,"_31229":74708,"_21648":126174,"_5":14899,"_28426":126074,"_3090":126175},[],"Administrador de la flota",{"_3640":74756,"_31229":74708,"_21648":126177,"_5":14899,"_28426":126074,"_3090":126178},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3640":74757,"_31229":74708,"_21648":126180,"_5":14899,"_28426":126074,"_3090":125635},[],{"_3640":74758,"_31229":74708,"_21648":126182,"_5":14899,"_28426":126074,"_3090":126183},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3640":74759,"_31229":74708,"_21648":126185,"_5":14899,"_28426":126074,"_3090":125641},[],{"_3640":74760,"_31229":74708,"_21648":126187,"_5":14899,"_28426":126074,"_3090":126188},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3640":74761,"_31229":74708,"_21648":126190,"_5":14899,"_28426":126074,"_3090":126191},[],"Operador de infraestructura",{"_3640":74762,"_31229":74708,"_21648":126193,"_5":14899,"_28426":126074,"_3090":126194},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3640":74763,"_31229":74708,"_21648":126196,"_5":14899,"_28426":126074,"_3090":126197},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3640":74764,"_31229":74764,"_5":15259,"_3090":126199,"_31567":126200,"_21648":126202,"_28426":74764},"Jerarquía y rotación de CAs",[51054,122173,56762,126201],"Claves, autoridades y certificados",[],{"_3640":74765,"_31229":74764,"_21648":126204,"_5":14899,"_28426":74764,"_3090":126205},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3640":74766,"_31229":74764,"_5":31564,"_21648":126207,"_28426":126208,"_3090":126209},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3640":74767,"_31229":74764,"_5":31564,"_21648":126211,"_28426":126212,"_3090":126213},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3640":74768,"_31229":74764,"_5":31564,"_21648":126215,"_28426":126216,"_3090":126217},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3640":74769,"_31229":74764,"_5":31564,"_21648":126219,"_28426":126220,"_3090":126221},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3640":74770,"_31229":74764,"_5":31564,"_21648":126223,"_28426":126224,"_3090":126225},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3640":74771,"_31229":74764,"_5":31564,"_21648":126227,"_28426":126228,"_3090":126229},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3640":74772,"_31229":74764,"_5":31564,"_21648":126231,"_28426":126232,"_3090":126233},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3640":74773,"_31229":74764,"_5":31564,"_21648":126235,"_28426":126236,"_3090":126237},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3640":74774,"_31229":74764,"_5":31564,"_21648":126239,"_28426":126240,"_3090":126241},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3640":74775,"_31229":74764,"_5":31564,"_21648":126243,"_28426":126244,"_3090":126245},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3640":74776,"_31229":74764,"_5":31564,"_21648":126247,"_28426":126248,"_3090":126249},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3640":74777,"_31229":74764,"_5":31564,"_21648":126251,"_28426":126252,"_3090":126253},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3640":74778,"_31229":74764,"_21648":126255,"_5":14899,"_28426":74764,"_3090":126256},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3640":74779,"_31229":74764,"_21648":126258,"_5":14899,"_28426":74764,"_3090":126259},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3640":74780,"_31229":74764,"_21648":126261,"_5":14899,"_28426":126208,"_3090":126262},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3640":74781,"_31229":74764,"_21648":126264,"_5":14899,"_28426":126208,"_3090":126265},[],"entorno, como producción y preproducción;",{"_3640":74782,"_31229":74764,"_21648":126267,"_5":14899,"_28426":126208,"_3090":126268},[],"propietario o equipo operador;",{"_3640":74783,"_31229":74764,"_21648":126270,"_5":14899,"_28426":126208,"_3090":126271},[],"familia de dispositivos o proceso de fabricación;",{"_3640":74784,"_31229":74764,"_21648":126273,"_5":14899,"_28426":126208,"_3090":126274},[],"región o requisito regulatorio;",{"_3640":74785,"_31229":74764,"_21648":126276,"_5":14899,"_28426":126208,"_3090":126277},[],"motor criptográfico o política de clave;",{"_3640":74786,"_31229":74764,"_21648":126279,"_5":14899,"_28426":126208,"_3090":126280},[],"ventana de mantenimiento y ritmo de renovación.",{"_3640":74787,"_31229":74764,"_21648":126282,"_5":14899,"_28426":126208,"_3090":126283},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3640":74788,"_31229":74764,"_21648":126285,"_5":14899,"_28426":126208,"_3090":126286},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3640":74789,"_31229":74764,"_21648":126288,"_5":14899,"_28426":126212,"_3090":126289},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3640":74790,"_31229":74764,"_21648":126291,"_5":14899,"_28426":126212,"_3090":126292},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir. Una CA sin ajustes de CRL — por ejemplo, una importada sin su clave o sin `cRLSign` — obtiene los ajustes inicializados con la reemisión cuando el nuevo certificado incluye `cRLSign`; en caso contrario se queda sin ellos. Consulta la guía de CRL.",{"_3640":74791,"_31229":74764,"_21648":126294,"_5":14899,"_28426":126212,"_3090":126295},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3640":74792,"_31229":74764,"_21648":126297,"_5":14899,"_28426":126212,"_3090":126298},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Una CA subordinada la firma su CA padre, de modo que esta también debe estar `ACTIVE` y dentro de su periodo de validez; en caso contrario la reemisión falla con `400`. Anticípate a estas condiciones.",{"_3640":74793,"_31229":74764,"_21648":126300,"_5":14899,"_28426":126216,"_3090":126301},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3640":74794,"_31229":74764,"_21648":126303,"_5":14899,"_28426":126216,"_3090":126304},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3640":74795,"_31229":74764,"_21648":126306,"_5":14899,"_28426":126216,"_3090":126307},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3640":74796,"_31229":74764,"_21648":126309,"_5":14899,"_28426":126216,"_3090":126310},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3640":74797,"_31229":74764,"_21648":126312,"_5":14899,"_28426":126224,"_3090":126313},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3640":74798,"_31229":74764,"_21648":126315,"_5":14899,"_28426":126228,"_3090":126316},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3640":74799,"_31229":74764,"_21648":126318,"_5":14899,"_28426":126232,"_3090":126319},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3640":74800,"_31229":74764,"_21648":126321,"_5":14899,"_28426":126236,"_3090":126322},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3640":74801,"_31229":74764,"_21648":126324,"_5":14899,"_28426":126240,"_3090":126325},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3640":74802,"_31229":74764,"_21648":126327,"_5":14899,"_28426":126244,"_3090":126328},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3640":74803,"_31229":74764,"_21648":126330,"_5":14899,"_28426":126248,"_3090":126331},[],"Lamassu guarda la revocación de la CA y después aplica la misma revocación a sus CAs hijas y certificados emitidos. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3640":74804,"_31229":74764,"_21648":126333,"_5":14899,"_28426":126248,"_3090":126334},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3640":74805,"_31229":74764,"_21648":126336,"_5":14899,"_28426":126248,"_3090":126337},[],"`CertificateHold` es la excepción reversible. Suspender una CA suspende sus CAs hijas activas y sus certificados emitidos con `CertificateHold` y los marca como suspendidos por esa CA. Al reactivar la CA — a `ACTIVE` o a cualquier otro estado no revocado, como `EXPIRED` — se reactivan exactamente los descendientes que siguen suspendidos y conservan esa marca. Las suspensiones colocadas manualmente antes o después de la cascada no se tocan, y cualquier cambio de estado posterior de un descendiente elimina la marca. Revocar definitivamente una CA suspendida con cualquier otra razón sigue siendo permanente: los descendientes se revocan con `CessationOfOperation` y no pueden restaurarse.",{"_3640":74806,"_31229":74764,"_21648":126339,"_5":14899,"_28426":126248,"_3090":126340},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3640":74807,"_31229":74764,"_21648":126342,"_5":14899,"_28426":126252,"_3090":126343},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3640":74808,"_31229":74764,"_21648":126345,"_5":14899,"_28426":126252,"_3090":126346},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3640":74809,"_31229":74764,"_21648":126348,"_5":14899,"_28426":126252,"_3090":126349},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3640":74810,"_31229":74764,"_21648":126351,"_5":14899,"_28426":126252,"_3090":126352},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3640":74811,"_31229":74764,"_21648":126354,"_5":14899,"_28426":126252,"_3090":126355},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3640":74812,"_31229":74764,"_21648":126357,"_5":14899,"_28426":126252,"_3090":126358},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3640":74813,"_31229":74764,"_21648":126360,"_5":14899,"_28426":126252,"_3090":126361},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3640":74814,"_31229":74814,"_5":15259,"_3090":126363,"_31567":126364,"_21648":126365,"_28426":74814},"Autoridades de certificación",[51054,122173,56762,126201],[],{"_3640":74815,"_31229":74814,"_21648":126367,"_5":14899,"_28426":74814,"_3090":126368},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3640":74816,"_31229":74814,"_5":31564,"_21648":126370,"_28426":126371,"_3090":126372},[],"/docs/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3640":74817,"_31229":74814,"_5":31564,"_21648":126374,"_28426":126375,"_3090":126376},[],"/docs/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3640":74818,"_31229":74814,"_5":31564,"_21648":126378,"_28426":126379,"_3090":120691},[],"/docs/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3640":74819,"_31229":74814,"_5":31564,"_21648":126381,"_28426":126382,"_3090":126383},[],"/docs/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3640":74820,"_31229":74814,"_5":31564,"_21648":126385,"_28426":126386,"_3090":126387},[],"/docs/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3640":74821,"_31229":74814,"_5":31564,"_21648":126389,"_28426":126390,"_3090":126391},[],"/docs/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3640":74822,"_31229":74814,"_5":31564,"_21648":126393,"_28426":126394,"_3090":126395},[],"/docs/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3640":74823,"_31229":74814,"_5":31564,"_21648":126397,"_28426":126398,"_3090":126399},[],"/docs/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3640":74824,"_31229":74814,"_5":31564,"_21648":126401,"_28426":126402,"_3090":126403},[],"/docs/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3640":74825,"_31229":74814,"_5":31564,"_21648":126405,"_28426":126406,"_3090":126407},[],"/docs/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3640":74826,"_31229":74814,"_5":31564,"_21648":126409,"_28426":126410,"_3090":126411},[],"/docs/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3640":74827,"_31229":74814,"_5":31564,"_21648":126413,"_28426":126414,"_3090":126415},[],"/docs/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3640":74828,"_31229":74814,"_5":31564,"_21648":126417,"_28426":126418,"_3090":126419},[],"/docs/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3640":74829,"_31229":74814,"_5":31564,"_21648":126421,"_28426":126422,"_3090":126423},[],"/docs/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3640":74830,"_31229":74814,"_5":31564,"_21648":126425,"_28426":126426,"_3090":126427},[],"/docs/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3640":74831,"_31229":74814,"_5":31564,"_21648":126429,"_28426":126430,"_3090":126431},[],"/docs/es/platform/pki/certificate-authorities#estados-de-una-ca","Estados de una CA",{"_3640":74832,"_31229":74814,"_5":31564,"_21648":126433,"_28426":126434,"_3090":126435},[],"/docs/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3640":74833,"_31229":74814,"_5":31564,"_21648":126437,"_28426":126438,"_3090":126439},[],"/docs/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3640":74834,"_31229":74814,"_5":31564,"_21648":126441,"_28426":126442,"_3090":126443},[],"/docs/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3640":74835,"_31229":74814,"_5":31564,"_21648":126445,"_28426":126446,"_3090":126447},[],"/docs/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3640":74836,"_31229":74814,"_5":31564,"_21648":126449,"_28426":126450,"_3090":126451},[],"/docs/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3640":74837,"_31229":74814,"_5":31564,"_21648":126453,"_28426":126454,"_3090":126455},[],"/docs/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3640":74838,"_31229":74814,"_5":31564,"_21648":126457,"_28426":126458,"_3090":126459},[],"/docs/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3640":74839,"_31229":74814,"_5":31564,"_21648":126461,"_28426":126462,"_3090":126463},[],"/docs/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3640":74840,"_31229":74814,"_21648":126465,"_5":14899,"_28426":74814,"_3090":126466},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3640":74841,"_31229":74814,"_21648":126468,"_5":14899,"_28426":74814,"_3090":126469},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3640":74842,"_31229":74814,"_21648":126471,"_5":14899,"_28426":74814,"_3090":126472},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3640":74843,"_31229":74814,"_21648":126474,"_5":14899,"_28426":126371,"_3090":126475},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3640":74844,"_31229":74814,"_21648":126477,"_5":14899,"_28426":126371,"_3090":126478},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3640":74845,"_31229":74814,"_21648":126480,"_5":14899,"_28426":126371,"_3090":126481},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3640":74846,"_31229":74814,"_21648":126483,"_5":14899,"_28426":126371,"_3090":126484},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3640":74847,"_31229":74814,"_21648":126486,"_5":14899,"_28426":126371,"_3090":126487},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3640":74848,"_31229":74814,"_21648":126489,"_5":14899,"_28426":126379,"_3090":126490},[],"Decide si la CA será raíz o intermedia.",{"_3640":74849,"_31229":74814,"_21648":126492,"_5":14899,"_28426":126379,"_3090":126493},[],"Elige el motor que custodiará la clave.",{"_3640":74850,"_31229":74814,"_21648":126495,"_5":14899,"_28426":126379,"_3090":126496},[],"Define una validez superior a la de los certificados que emitirá.",{"_3640":74851,"_31229":74814,"_21648":126498,"_5":14899,"_28426":126379,"_3090":126499},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3640":74852,"_31229":74814,"_21648":126501,"_5":14899,"_28426":126382,"_3090":126502},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3640":74853,"_31229":74814,"_21648":126504,"_5":14899,"_28426":126386,"_3090":126505},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3640":74854,"_31229":74814,"_21648":126507,"_5":14899,"_28426":126386,"_3090":126508},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3640":74855,"_31229":74814,"_21648":126510,"_5":14899,"_28426":126390,"_3090":126511},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3640":74856,"_31229":74814,"_21648":126513,"_5":14899,"_28426":126394,"_3090":126514},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3640":74857,"_31229":74814,"_21648":126516,"_5":14899,"_28426":126394,"_3090":126517},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3640":74858,"_31229":74814,"_21648":126519,"_5":14899,"_28426":126394,"_3090":126520},[],"`ST`: estado o provincia.",{"_3640":74859,"_31229":74814,"_21648":126522,"_5":14899,"_28426":126394,"_3090":126523},[],"`L`: localidad.",{"_3640":74860,"_31229":74814,"_21648":126525,"_5":14899,"_28426":126394,"_3090":126526},[],"`O`: organización.",{"_3640":74861,"_31229":74814,"_21648":126528,"_5":14899,"_28426":126394,"_3090":126529},[],"`OU`: unidad organizativa.",{"_3640":74862,"_31229":74814,"_21648":126531,"_5":14899,"_28426":126394,"_3090":126532},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3640":74863,"_31229":74814,"_21648":126534,"_5":14899,"_28426":126398,"_3090":126535},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3640":74864,"_31229":74814,"_21648":126537,"_5":14899,"_28426":126398,"_3090":126538},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3640":74865,"_31229":74814,"_21648":126540,"_5":14899,"_28426":126402,"_3090":126541},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3640":74866,"_31229":74814,"_21648":126543,"_5":14899,"_28426":126402,"_3090":126544},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3640":74867,"_31229":74814,"_21648":126546,"_5":14899,"_28426":126406,"_3090":126547},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3640":74868,"_31229":74814,"_21648":126549,"_5":14899,"_28426":126406,"_3090":126550},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3640":74869,"_31229":74814,"_21648":126552,"_5":14899,"_28426":126410,"_3090":126553},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3640":74870,"_31229":74814,"_21648":126555,"_5":14899,"_28426":126410,"_3090":126556},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3640":74871,"_31229":74814,"_21648":126558,"_5":14899,"_28426":126410,"_3090":126559},[],"Un certificado cuyo periodo de validez ya ha terminado, como el de una autoridad externa retirada, se acepta y, cuando Lamassu aún no tiene un registro de ese certificado, la CA se almacena como `EXPIRED` desde el principio, igual que al importar un certificado simple. Si la importación reutiliza el registro de una CA eliminada (véase arriba y Elimina una CA), se conserva el estado anterior aunque el certificado haya caducado entretanto. Una CA `EXPIRED` rechaza los cambios de estado; consulta el ciclo de vida del certificado.",{"_3640":74872,"_31229":74814,"_21648":126561,"_5":14899,"_28426":126410,"_3090":126562},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3640":74873,"_31229":74814,"_21648":126564,"_5":14899,"_28426":126414,"_3090":126565},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3640":74874,"_31229":74814,"_21648":126567,"_5":14899,"_28426":126418,"_3090":126568},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3640":74875,"_31229":74814,"_21648":126570,"_5":14899,"_28426":126418,"_3090":126571},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3640":74876,"_31229":74814,"_21648":126573,"_5":14899,"_28426":126422,"_3090":126574},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3640":74877,"_31229":74814,"_21648":126576,"_5":14899,"_28426":126426,"_3090":126577},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3640":74878,"_31229":74814,"_21648":126579,"_5":14899,"_28426":126426,"_3090":126580},[],"Una CA importada cuya clave está en el KMS y cuyo certificado incluye `cRLSign` recibe automáticamente sus ajustes de CRL y su primera CRL; sin una clave en el KMS o sin `cRLSign` no los recibe, y esto no es un error de importación (consulta CRL).",{"_3640":74879,"_31229":74814,"_21648":126582,"_5":14899,"_28426":126426,"_3090":126583},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3640":74880,"_31229":74814,"_21648":126585,"_5":14899,"_28426":126430,"_3090":126586},[],"Una CA solo firma en `ACTIVE`. Desde ahí puede pasar a `EXPIRED` o a `REVOKED`, y de esos estados solo sale por la eliminación, salvo en un caso: la revocación con `CertificateHold` se puede deshacer.",{"_3640":74881,"_31229":74814,"_21648":126588,"_5":14899,"_28426":126430,"_3090":126589},[],"**Caducidad.** El monitor de expiración marca como `EXPIRED` las CAs `ACTIVE` cuyo periodo de validez ha terminado. Hasta que se ejecuta, la CA ya no firma, porque Lamassu comprueba las fechas (Emite certificados).",{"_3640":74882,"_31229":74814,"_21648":126591,"_5":14899,"_28426":126430,"_3090":126592},[],"**Revocación.** Revocar con la razón `CertificateHold` es reversible. Una revocación con cualquier otra razón, igual que `EXPIRED`, rechaza todo cambio de estado posterior. Revocar, también con `CertificateHold`, actúa además sobre las CAs subordinadas y los certificados que emitió: Revoca una CA.",{"_3640":74883,"_31229":74814,"_21648":126594,"_5":14899,"_28426":126430,"_3090":126595},[],"**Eliminación.** Solo una CA revocada con otra razón o caducada puede eliminarse; una importada sin clave, desde cualquier estado. Condiciones y efectos en Elimina una CA.",{"_3640":74884,"_31229":74814,"_21648":126597,"_5":14899,"_28426":126434,"_3090":126598},[],"Abre una CA desde el inventario para consultar:",{"_3640":74885,"_31229":74814,"_21648":126600,"_5":14899,"_28426":126434,"_3090":126601},[],"Estado y periodo de validez.",{"_3640":74886,"_31229":74814,"_21648":126603,"_5":14899,"_28426":126434,"_3090":126604},[],"Certificado y cadena en formato PEM.",{"_3640":74887,"_31229":74814,"_21648":126606,"_5":14899,"_28426":126434,"_3090":126607},[],"Número de certificados activos, expirados y revocados.",{"_3640":74888,"_31229":74814,"_21648":126609,"_5":14899,"_28426":126434,"_3090":126610},[],"Certificados emitidos en **Issued Certificates**.",{"_3640":74889,"_31229":74814,"_21648":126612,"_5":14899,"_28426":126434,"_3090":126613},[],"CRL vinculada a la autoridad.",{"_3640":74890,"_31229":74814,"_21648":126615,"_5":14899,"_28426":126434,"_3090":126616},[],"Metadatos y motor criptográfico asociado.",{"_3640":74891,"_31229":74814,"_21648":126618,"_5":14899,"_28426":126434,"_3090":126619},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3640":74892,"_31229":74814,"_21648":126621,"_5":14899,"_28426":126438,"_3090":126622},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3640":74893,"_31229":74814,"_21648":126624,"_5":14899,"_28426":126438,"_3090":126625},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3640":74894,"_31229":74814,"_21648":126627,"_5":14899,"_28426":126438,"_3090":126628},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3640":74895,"_31229":74814,"_21648":126630,"_5":14899,"_28426":126438,"_3090":126631},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3640":74896,"_31229":74814,"_21648":126633,"_5":14899,"_28426":126438,"_3090":126634},[],"La clave de una CA solo firma certificados. La API de CA no tiene ningún endpoint para firmar o verificar datos arbitrarios. Para firmar y verificar un mensaje con una clave, utiliza las operaciones del KMS descritas en Gestión de claves, sujetas a sus propios permisos.",{"_3640":74897,"_31229":74814,"_21648":126636,"_5":14899,"_28426":126438,"_3090":126637},[],"Una CA solo firma mientras su estado es `ACTIVE` y la hora actual está dentro del periodo de validez de su certificado. Lamassu comprueba ambas condiciones porque el estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración. En caso contrario, la petición falla con `400` y el mensaje `CA Status inconsistent`, antes de llamar al KMS. La misma comprobación se aplica cuando la CA firma el certificado de una CA subordinada, también al crearla o reemitirla.",{"_3640":74898,"_31229":74814,"_21648":126639,"_5":14899,"_28426":126442,"_3090":126640},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Con `CertificateHold` la cascada es reversible: los descendientes quedan suspendidos y se restauran al reactivar la CA. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Sigue las condiciones de revocación en cascada.",{"_3640":74899,"_31229":74814,"_21648":126642,"_5":14899,"_28426":126446,"_3090":126643},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3640":74900,"_31229":74814,"_21648":126645,"_5":14899,"_28426":126450,"_3090":126646},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3640":74901,"_31229":74814,"_21648":126648,"_5":14899,"_28426":126454,"_3090":126649},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3640":74902,"_31229":74814,"_21648":126651,"_5":14899,"_28426":126458,"_3090":126652},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3640":74903,"_31229":74814,"_21648":126654,"_5":14899,"_28426":126462,"_3090":126655},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3640":74904,"_31229":74814,"_21648":126657,"_5":14899,"_28426":126462,"_3090":126658},[],"Lo que la eliminación hace con lo emitido por la CA depende de su estado. Eliminar una CA activa importada sin clave cuyo periodo de validez no ha terminado solo elimina el registro de Lamassu: la CA, sus descendientes y los certificados que emitió conservan su estado, ya que la CA sigue operando fuera de Lamassu — su clave nunca estuvo en Lamassu. Pero si el periodo de validez ya terminó y el estado almacenado sigue siendo `ACTIVE` — el estado almacenado puede ir por detrás de las fechas hasta que se ejecute el monitor de expiración —, para la eliminación la CA cuenta como caducada. Eliminar una CA revocada o caducada revoca lo que emitió con `CessationOfOperation`, la misma cascada que al revocar una CA. Para retirar una CA activa sin clave junto con todo lo que emitió, revócala primero con `POST /v1/cas/:id/status` y después elimínala.",{"_3640":74905,"_31229":74814,"_21648":126660,"_5":14899,"_28426":126462,"_3090":126661},[],"Los ajustes de CRL de la CA se conservan. La eliminación se rechaza con un error `409` mientras sigan `ACTIVE`: la VA debe publicar primero la CRL final de la CA, lo que puede tardar hasta aproximadamente una hora después de la revocación con la programación predeterminada del trabajo, así que reintenta cuando se haya publicado la CRL final. Una CA caducada se finaliza sin CRL final, y una CA en retención (`CertificateHold`) se rechaza con un mensaje que te pide revocarla de forma permanente primero. La eliminación también se rechaza con un `409` cuando la clave de la CA firma las CRLs de otra CA: el error nombra a esa CA, así que cambia su firmante de CRL, o elimínala o revócala, antes de eliminar esta. La CA y todos sus descendientes se comprueban antes de eliminar nada; si alguno no puede eliminarse, no cambia nada.",{"_3640":74906,"_31229":74814,"_21648":126663,"_5":14899,"_28426":126462,"_3090":126664},[],"Tras la eliminación, los ajustes quedan archivados y la última CRL sigue sirviéndose pero nunca se regenera; puedes eliminarlos cuando ningún certificado emitido por la CA necesite ya evidencia de revocación, con `DELETE /v1/crl-settings/{ca-id}` o desde la página **Verification Authorities** de la consola. Borrarlos deja de servir la CRL y no puede deshacerse. Ajusta la validez y el firmante antes de revocar o eliminar la CA (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3640":74907,"_31229":74814,"_21648":126666,"_5":14899,"_28426":126462,"_3090":126667},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: hasta que se eliminen esos ajustes, estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3640":74908,"_31229":74908,"_5":15259,"_3090":126669,"_31567":126670,"_21648":126671,"_28426":74908},"Perfiles de certificado",[51054,122173,56762,126201],[],{"_3640":74909,"_31229":74908,"_21648":126673,"_5":14899,"_28426":74908,"_3090":126674},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3640":74910,"_31229":74908,"_5":31564,"_21648":126676,"_28426":126677,"_3090":126678},[],"/docs/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3640":74911,"_31229":74908,"_5":31564,"_21648":126680,"_28426":126681,"_3090":126682},[],"/docs/es/platform/pki/certificate-profiles#validez","Validez",{"_3640":74912,"_31229":74908,"_5":31564,"_21648":126684,"_28426":126685,"_3090":126686},[],"/docs/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3640":74913,"_31229":74908,"_5":31564,"_21648":126688,"_28426":126689,"_3090":126690},[],"/docs/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3640":74914,"_31229":74908,"_5":31564,"_21648":126692,"_28426":126693,"_3090":126694},[],"/docs/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3640":74915,"_31229":74908,"_5":31564,"_21648":126696,"_28426":126697,"_3090":126698},[],"/docs/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3640":74916,"_31229":74908,"_5":31564,"_21648":126700,"_28426":126701,"_3090":126702},[],"/docs/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3640":74917,"_31229":74908,"_5":31564,"_21648":126704,"_28426":126705,"_3090":126706},[],"/docs/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3640":74918,"_31229":74908,"_5":31564,"_21648":126708,"_28426":126709,"_3090":126710},[],"/docs/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3640":74919,"_31229":74908,"_5":31564,"_21648":126712,"_28426":126713,"_3090":126714},[],"/docs/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3640":74920,"_31229":74908,"_5":31564,"_21648":126716,"_28426":126717,"_3090":126718},[],"/docs/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3640":74921,"_31229":74908,"_5":31564,"_21648":126720,"_28426":126721,"_3090":126722},[],"/docs/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3640":74922,"_31229":74908,"_5":31564,"_21648":126724,"_28426":126725,"_3090":126726},[],"/docs/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3640":74923,"_31229":74908,"_5":31564,"_21648":126728,"_28426":126729,"_3090":126730},[],"/docs/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3640":74924,"_31229":74908,"_5":31564,"_21648":126732,"_28426":126733,"_3090":126734},[],"/docs/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3640":74925,"_31229":74908,"_5":31564,"_21648":126736,"_28426":126737,"_3090":126738},[],"/docs/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3640":74926,"_31229":74908,"_21648":126740,"_5":14899,"_28426":74908,"_3090":126741},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3640":74927,"_31229":74908,"_21648":126743,"_5":14899,"_28426":74908,"_3090":126744},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3640":74928,"_31229":74908,"_21648":126746,"_5":14899,"_28426":126681,"_3090":126747},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3640":74929,"_31229":74908,"_21648":126749,"_5":14899,"_28426":126681,"_3090":126750},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3640":74930,"_31229":74908,"_21648":126752,"_5":14899,"_28426":126685,"_3090":126753},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3640":74931,"_31229":74908,"_21648":126755,"_5":14899,"_28426":126689,"_3090":126756},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3640":74932,"_31229":74908,"_21648":126758,"_5":14899,"_28426":126689,"_3090":126759},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3640":74933,"_31229":74908,"_21648":126761,"_5":14899,"_28426":126689,"_3090":126762},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3640":74934,"_31229":74908,"_21648":126764,"_5":14899,"_28426":126693,"_3090":126765},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3640":74935,"_31229":74908,"_21648":126767,"_5":14899,"_28426":126697,"_3090":126768},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3640":74936,"_31229":74908,"_21648":126770,"_5":14899,"_28426":126697,"_3090":126771},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3640":74937,"_31229":74908,"_21648":126773,"_5":14899,"_28426":126701,"_3090":126774},[],"La aplicación criptográfica puede:",{"_3640":74938,"_31229":74908,"_21648":126776,"_5":14899,"_28426":126701,"_3090":126777},[],"permitir o bloquear claves RSA;",{"_3640":74939,"_31229":74908,"_21648":126779,"_5":14899,"_28426":126701,"_3090":126780},[],"limitar los tamaños RSA admitidos;",{"_3640":74940,"_31229":74908,"_21648":126782,"_5":14899,"_28426":126701,"_3090":126783},[],"permitir o bloquear claves ECDSA;",{"_3640":74941,"_31229":74908,"_21648":126785,"_5":14899,"_28426":126701,"_3090":126786},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3640":74942,"_31229":74908,"_21648":126788,"_5":14899,"_28426":126701,"_3090":126789},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3640":74943,"_31229":74908,"_21648":126791,"_5":14899,"_28426":126705,"_3090":126792},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3640":74944,"_31229":74908,"_21648":126794,"_5":14899,"_28426":126705,"_3090":121933},[],{"_3640":74945,"_31229":74908,"_21648":126796,"_5":14899,"_28426":126705,"_3090":126797},[],"Primera opción",{"_3640":74946,"_31229":74908,"_21648":126799,"_5":14899,"_28426":126705,"_3090":126800},[],"Segunda opción",{"_3640":74947,"_31229":74908,"_21648":126802,"_5":14899,"_28426":126705,"_3090":126803},[],"Si no hay ninguna",{"_3640":74948,"_31229":74908,"_21648":126805,"_5":14899,"_28426":126705,"_3090":126806},[],"Firma directa con una CA",{"_3640":74949,"_31229":74908,"_21648":126808,"_5":14899,"_28426":126705,"_3090":126809},[],"`issuance_profile` incluido en la solicitud",{"_3640":74950,"_31229":74908,"_21648":126811,"_5":14899,"_28426":126705,"_3090":126812},[],"`issuance_profile_id` de la solicitud",{"_3640":74951,"_31229":74908,"_21648":126814,"_5":14899,"_28426":126705,"_3090":126815},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3640":74952,"_31229":74908,"_21648":126817,"_5":14899,"_28426":126705,"_3090":126818},[],"Emisión mediante DMS",{"_3640":74953,"_31229":74908,"_21648":126820,"_5":14899,"_28426":126705,"_3090":57383},[],{"_3640":74954,"_31229":74908,"_21648":126822,"_5":14899,"_28426":126705,"_3090":126823},[],"`settings.issuance_profile` incluido en el DMS",{"_3640":74955,"_31229":74908,"_21648":126825,"_5":14899,"_28426":126705,"_3090":126826},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3640":74956,"_31229":74908,"_21648":126828,"_5":14899,"_28426":126705,"_3090":126829},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3640":74957,"_31229":74908,"_21648":126831,"_5":14899,"_28426":126705,"_3090":126832},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3640":74958,"_31229":74908,"_21648":126834,"_5":14899,"_28426":126713,"_3090":126835},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3640":74959,"_31229":74908,"_21648":126837,"_5":14899,"_28426":126717,"_3090":126838},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3640":74960,"_31229":74908,"_21648":126840,"_5":14899,"_28426":126721,"_3090":126841},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3640":74961,"_31229":74908,"_21648":126843,"_5":14899,"_28426":126725,"_3090":126844},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3640":74962,"_31229":74908,"_21648":126846,"_5":14899,"_28426":126729,"_3090":126847},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3640":74963,"_31229":74908,"_21648":126849,"_5":14899,"_28426":126729,"_3090":126850},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3640":74964,"_31229":74908,"_21648":126852,"_5":14899,"_28426":126733,"_3090":126853},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3640":74965,"_31229":74908,"_21648":126855,"_5":14899,"_28426":126733,"_3090":126856},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3640":74966,"_31229":74908,"_21648":126858,"_5":14899,"_28426":126733,"_3090":126859},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3640":74967,"_31229":74908,"_21648":126861,"_5":14899,"_28426":126733,"_3090":126862},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3640":74968,"_31229":74908,"_21648":126864,"_5":14899,"_28426":126737,"_3090":126865},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3640":74969,"_31229":74908,"_21648":126867,"_5":14899,"_28426":126737,"_3090":126868},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3640":74970,"_31229":74970,"_5":15259,"_3090":126870,"_31567":126871,"_21648":126873,"_28426":74970},"Validación de certificados",[51054,122173,56762,126872],"Validación",[],{"_3640":74971,"_31229":74970,"_21648":126875,"_5":14899,"_28426":74970,"_3090":126876},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3640":74972,"_31229":74970,"_5":31564,"_21648":126878,"_28426":126879,"_3090":126880},[],"/docs/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3640":74973,"_31229":74970,"_5":31564,"_21648":126882,"_28426":126883,"_3090":126884},[],"/docs/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3640":74974,"_31229":74970,"_5":31564,"_21648":126886,"_28426":126887,"_3090":126888},[],"/docs/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3640":74975,"_31229":74970,"_21648":126890,"_5":14899,"_28426":74970,"_3090":126891},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3640":74976,"_31229":74970,"_21648":126893,"_5":14899,"_28426":126879,"_3090":126894},[],"Verifica estos criterios juntos:",{"_3640":74977,"_31229":74970,"_21648":126896,"_5":14899,"_28426":126879,"_3090":125830},[],{"_3640":74978,"_31229":74970,"_21648":126898,"_5":14899,"_28426":126879,"_3090":126899},[],"Resultado necesario",{"_3640":74979,"_31229":74970,"_21648":126901,"_5":14899,"_28426":126879,"_3090":126902},[],"Cadena y firma",{"_3640":74980,"_31229":74970,"_21648":126904,"_5":14899,"_28426":126879,"_3090":126905},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3640":74981,"_31229":74970,"_21648":126907,"_5":14899,"_28426":126879,"_3090":126908},[],"Fechas",{"_3640":74982,"_31229":74970,"_21648":126910,"_5":14899,"_28426":126879,"_3090":126911},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3640":74983,"_31229":74970,"_21648":126913,"_5":14899,"_28426":126879,"_3090":121843},[],{"_3640":74984,"_31229":74970,"_21648":126915,"_5":14899,"_28426":126879,"_3090":126916},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3640":74985,"_31229":74970,"_21648":126918,"_5":14899,"_28426":126879,"_3090":126919},[],"Uso",{"_3640":74986,"_31229":74970,"_21648":126921,"_5":14899,"_28426":126879,"_3090":126922},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3640":74987,"_31229":74970,"_21648":126924,"_5":14899,"_28426":126879,"_3090":126925},[],"Revocación",{"_3640":74988,"_31229":74970,"_21648":126927,"_5":14899,"_28426":126879,"_3090":126928},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3640":74989,"_31229":74970,"_21648":126930,"_5":14899,"_28426":126879,"_3090":126931},[],"Autorización",{"_3640":74990,"_31229":74970,"_21648":126933,"_5":14899,"_28426":126879,"_3090":126934},[],"La aplicación permite la acción a esa identidad.",{"_3640":74991,"_31229":74970,"_21648":126936,"_5":14899,"_28426":126879,"_3090":126937},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3640":74992,"_31229":74970,"_21648":126939,"_5":14899,"_28426":126883,"_3090":126940},[],"Mecanismo",{"_3640":74993,"_31229":74970,"_21648":126942,"_5":14899,"_28426":126883,"_3090":126943},[],"Cuándo utilizarlo",{"_3640":74994,"_31229":74970,"_21648":126945,"_5":14899,"_28426":126883,"_3090":126946},[],"Qué debes mantener",{"_3640":74995,"_31229":74970,"_21648":126948,"_5":14899,"_28426":126883,"_3090":57511},[],{"_3640":74996,"_31229":74970,"_21648":126950,"_5":14899,"_28426":126883,"_3090":126951},[],"Consulta del estado de un certificado concreto.",{"_3640":74997,"_31229":74970,"_21648":126953,"_5":14899,"_28426":126883,"_3090":126954},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3640":74998,"_31229":74970,"_21648":126956,"_5":14899,"_28426":126883,"_3090":57520},[],{"_3640":74999,"_31229":74970,"_21648":126958,"_5":14899,"_28426":126883,"_3090":126959},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3640":75000,"_31229":74970,"_21648":126961,"_5":14899,"_28426":126883,"_3090":126962},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3640":75001,"_31229":74970,"_21648":126964,"_5":14899,"_28426":126883,"_3090":126965},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3640":75002,"_31229":74970,"_21648":126967,"_5":14899,"_28426":126883,"_3090":126968},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3640":75003,"_31229":74970,"_21648":126970,"_5":14899,"_28426":126887,"_3090":126971},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3640":75004,"_31229":74970,"_21648":126973,"_5":14899,"_28426":126887,"_3090":126974},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3640":75005,"_31229":74970,"_21648":126976,"_5":14899,"_28426":126887,"_3090":126977},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3640":75006,"_31229":74970,"_21648":126979,"_5":14899,"_28426":126887,"_3090":126980},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3640":75007,"_31229":74970,"_21648":126982,"_5":14899,"_28426":126887,"_3090":126983},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3640":75008,"_31229":74970,"_21648":126985,"_5":14899,"_28426":126887,"_3090":126986},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3640":75009,"_31229":74970,"_21648":126988,"_5":14899,"_28426":126887,"_3090":126989},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3640":75010,"_31229":74970,"_21648":126991,"_5":14899,"_28426":126887,"_3090":126992},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3640":75011,"_31229":74970,"_21648":126994,"_5":14899,"_28426":126887,"_3090":126995},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3640":75012,"_31229":75012,"_5":15259,"_3090":126997,"_31567":126998,"_21648":126999,"_28426":75012},"Certificados",[51054,122173,56762,126201],[],{"_3640":75013,"_31229":75012,"_21648":127001,"_5":14899,"_28426":75012,"_3090":127002},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3640":75014,"_31229":75012,"_5":31564,"_21648":127004,"_28426":127005,"_3090":127006},[],"/docs/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3640":75015,"_31229":75012,"_5":31564,"_21648":127008,"_28426":127009,"_3090":127010},[],"/docs/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3640":75016,"_31229":75012,"_5":31564,"_21648":127012,"_28426":127013,"_3090":127014},[],"/docs/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3640":75017,"_31229":75012,"_5":31564,"_21648":127016,"_28426":127017,"_3090":127018},[],"/docs/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3640":75018,"_31229":75012,"_5":31564,"_21648":127020,"_28426":127021,"_3090":127022},[],"/docs/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3640":75019,"_31229":75012,"_5":31564,"_21648":127024,"_28426":127025,"_3090":127026},[],"/docs/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3640":75020,"_31229":75012,"_5":31564,"_21648":127028,"_28426":127029,"_3090":127030},[],"/docs/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3640":75021,"_31229":75012,"_5":31564,"_21648":127032,"_28426":127033,"_3090":127034},[],"/docs/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3640":75022,"_31229":75012,"_5":31564,"_21648":127036,"_28426":127037,"_3090":127038},[],"/docs/es/platform/pki/certificates#continúa","Continúa",{"_3640":75023,"_31229":75012,"_21648":127040,"_5":14899,"_28426":75012,"_3090":127041},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3640":75024,"_31229":75012,"_21648":127043,"_5":14899,"_28426":127005,"_3090":127044},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3640":75025,"_31229":75012,"_21648":127046,"_5":14899,"_28426":127005,"_3090":127047},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3640":75026,"_31229":75012,"_21648":127049,"_5":14899,"_28426":127005,"_3090":127050},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3640":75027,"_31229":75012,"_21648":127052,"_5":14899,"_28426":127005,"_3090":127053},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3640":75028,"_31229":75012,"_21648":127055,"_5":14899,"_28426":127005,"_3090":127056},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3640":75029,"_31229":75012,"_21648":127058,"_5":14899,"_28426":127005,"_3090":127059},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3640":75030,"_31229":75012,"_21648":127061,"_5":14899,"_28426":127005,"_3090":127062},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3640":75031,"_31229":75012,"_21648":127064,"_5":14899,"_28426":127009,"_3090":127065},[],"Descarga el PEM e inspecciónalo:",{"_3640":75032,"_31229":75012,"_21648":127067,"_5":14899,"_28426":127009,"_3090":127068},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3640":75033,"_31229":75012,"_21648":127070,"_5":14899,"_28426":127013,"_3090":127071},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3640":75034,"_31229":75012,"_21648":127073,"_5":14899,"_28426":127013,"_3090":127074},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3640":75035,"_31229":75012,"_21648":127076,"_5":14899,"_28426":127013,"_3090":127077},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3640":75036,"_31229":75012,"_21648":127079,"_5":14899,"_28426":127013,"_3090":127080},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3640":75037,"_31229":75012,"_21648":127082,"_5":14899,"_28426":127013,"_3090":127083},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3640":75038,"_31229":75012,"_21648":127085,"_5":14899,"_28426":127013,"_3090":127086},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3640":75039,"_31229":75012,"_21648":127088,"_5":14899,"_28426":127013,"_3090":127089},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3640":75040,"_31229":75012,"_21648":127091,"_5":14899,"_28426":127017,"_3090":127092},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3640":75041,"_31229":75012,"_21648":127094,"_5":14899,"_28426":127021,"_3090":127095},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3640":75042,"_31229":75012,"_21648":127097,"_5":14899,"_28426":127025,"_3090":127098},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3640":75043,"_31229":75012,"_21648":127100,"_5":14899,"_28426":127029,"_3090":127101},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3640":75044,"_31229":75012,"_21648":127103,"_5":14899,"_28426":127029,"_3090":127104},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3640":75045,"_31229":75012,"_21648":127106,"_5":14899,"_28426":127029,"_3090":127107},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3640":75046,"_31229":75012,"_21648":127109,"_5":14899,"_28426":127033,"_3090":127110},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3640":75047,"_31229":75012,"_21648":127112,"_5":14899,"_28426":127033,"_3090":127113},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3640":75048,"_31229":75012,"_21648":127115,"_5":14899,"_28426":127033,"_3090":127116},[],"Esto no revierte una revocación definitiva ni la cascada de una CA revocada para siempre; la suspensión en cascada desde una CA se levanta reactivando esa CA.",{"_3640":75049,"_31229":75012,"_21648":127118,"_5":14899,"_28426":127037,"_3090":127119},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3640":75050,"_31229":75012,"_21648":127121,"_5":14899,"_28426":127037,"_3090":127122},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3640":75051,"_31229":75051,"_5":15259,"_3090":127124,"_31567":127125,"_21648":127127,"_28426":75051},"Ciclo de vida de un certificado",[51054,122173,56762,127126],"Conceptos",[],{"_3640":75052,"_31229":75051,"_21648":127129,"_5":14899,"_28426":75051,"_3090":127130},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3640":75053,"_31229":75051,"_5":31564,"_21648":127132,"_28426":127133,"_3090":127134},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3640":75054,"_31229":75051,"_5":31564,"_21648":127136,"_28426":127137,"_3090":127138},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3640":75055,"_31229":75051,"_5":31564,"_21648":127140,"_28426":127141,"_3090":127142},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3640":75056,"_31229":75051,"_5":31564,"_21648":127144,"_28426":127145,"_3090":127146},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3640":75057,"_31229":75051,"_5":31564,"_21648":127148,"_28426":127149,"_3090":127150},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3640":75058,"_31229":75051,"_5":31564,"_21648":127152,"_28426":127153,"_3090":127154},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3640":75059,"_31229":75051,"_5":31564,"_21648":127156,"_28426":127157,"_3090":124824},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3640":75060,"_31229":75051,"_5":31564,"_21648":127159,"_28426":127160,"_3090":127161},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3640":75061,"_31229":75051,"_5":31564,"_21648":127163,"_28426":127164,"_3090":127165},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3640":75062,"_31229":75051,"_5":31564,"_21648":127167,"_28426":127168,"_3090":127169},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3640":75063,"_31229":75051,"_21648":127171,"_5":14899,"_28426":75051,"_3090":127172},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3640":75064,"_31229":75051,"_21648":127174,"_5":14899,"_28426":127137,"_3090":127175},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3640":75065,"_31229":75051,"_21648":127177,"_5":14899,"_28426":127141,"_3090":127178},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3640":75066,"_31229":75051,"_21648":127180,"_5":14899,"_28426":127145,"_3090":127181},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3640":75067,"_31229":75051,"_21648":127183,"_5":14899,"_28426":127149,"_3090":127184},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3640":75068,"_31229":75051,"_21648":127186,"_5":14899,"_28426":127153,"_3090":127187},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3640":75069,"_31229":75051,"_21648":127189,"_5":14899,"_28426":127157,"_3090":127190},[],"Lamassu persiste cuatro estados X.509:",{"_3640":75070,"_31229":75051,"_21648":127192,"_5":14899,"_28426":127157,"_3090":127193},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3640":75071,"_31229":75051,"_21648":127195,"_5":14899,"_28426":127157,"_3090":127196},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3640":75072,"_31229":75051,"_21648":127198,"_5":14899,"_28426":127157,"_3090":127199},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3640":75073,"_31229":75051,"_21648":127201,"_5":14899,"_28426":127157,"_3090":127202},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3640":75074,"_31229":75051,"_21648":127204,"_5":14899,"_28426":127157,"_3090":127205},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3640":75075,"_31229":75051,"_21648":127207,"_5":14899,"_28426":127160,"_3090":127208},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3640":75076,"_31229":75051,"_21648":127210,"_5":14899,"_28426":127160,"_3090":127211},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3640":75077,"_31229":75051,"_21648":127213,"_5":14899,"_28426":127160,"_3090":127214},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3640":75078,"_31229":75051,"_21648":127216,"_5":14899,"_28426":127164,"_3090":127217},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes. Una cascada con `CertificateHold` los suspende de forma reversible: al reactivar la CA se restauran los que sigan suspendidos. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3640":75079,"_31229":75051,"_21648":127219,"_5":14899,"_28426":127164,"_3090":127220},[],"Antes de confirmar:",{"_3640":75080,"_31229":75051,"_21648":127222,"_5":14899,"_28426":127164,"_3090":127223},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3640":75081,"_31229":75051,"_21648":127225,"_5":14899,"_28426":127164,"_3090":127226},[],"Distribuye la nueva cadena de confianza.",{"_3640":75082,"_31229":75051,"_21648":127228,"_5":14899,"_28426":127164,"_3090":127229},[],"Reemite las identidades necesarias.",{"_3640":75083,"_31229":75051,"_21648":127231,"_5":14899,"_28426":127164,"_3090":127232},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3640":75084,"_31229":75051,"_21648":127234,"_5":14899,"_28426":127164,"_3090":127235},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3640":75085,"_31229":75051,"_21648":127237,"_5":14899,"_28426":127164,"_3090":127238},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3640":75086,"_31229":75051,"_21648":127240,"_5":14899,"_28426":127168,"_3090":127241},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3640":75087,"_31229":75051,"_21648":127243,"_5":14899,"_28426":127168,"_3090":127244},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3640":75088,"_31229":75051,"_21648":127246,"_5":14899,"_28426":127168,"_3090":127247},[],"Cambios de estado y razones de revocación.",{"_3640":75089,"_31229":75051,"_21648":127249,"_5":14899,"_28426":127168,"_3090":127250},[],"Publicación y vigencia de OCSP y CRLs.",{"_3640":75090,"_31229":75051,"_21648":127252,"_5":14899,"_28426":127168,"_3090":127253},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3640":75091,"_31229":75051,"_21648":127255,"_5":14899,"_28426":127168,"_3090":127256},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3640":75092,"_31229":75092,"_5":15259,"_3090":127258,"_31567":127259,"_21648":127260,"_28426":75092},"Modelo de confianza",[51054,122173,56762,127126],[],{"_3640":75093,"_31229":75092,"_21648":127262,"_5":14899,"_28426":75092,"_3090":127263},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3640":75094,"_31229":75092,"_5":31564,"_21648":127265,"_28426":127266,"_3090":127267},[],"/docs/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3640":75095,"_31229":75092,"_5":31564,"_21648":127269,"_28426":127270,"_3090":127271},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3640":75096,"_31229":75092,"_5":31564,"_21648":127273,"_28426":127274,"_3090":127275},[],"/docs/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3640":75097,"_31229":75092,"_5":31564,"_21648":127277,"_28426":127278,"_3090":127279},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3640":75098,"_31229":75092,"_5":31564,"_21648":127281,"_28426":127282,"_3090":127283},[],"/docs/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3640":75099,"_31229":75092,"_5":31564,"_21648":127285,"_28426":127286,"_3090":127287},[],"/docs/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3640":75100,"_31229":75092,"_5":31564,"_21648":127289,"_28426":127290,"_3090":127291},[],"/docs/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3640":75101,"_31229":75092,"_5":31564,"_21648":127293,"_28426":127294,"_3090":127295},[],"/docs/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3640":75102,"_31229":75092,"_5":31564,"_21648":127297,"_28426":127298,"_3090":127299},[],"/docs/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3640":75103,"_31229":75092,"_5":31564,"_21648":127301,"_28426":127302,"_3090":127303},[],"/docs/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3640":75104,"_31229":75092,"_21648":127305,"_5":14899,"_28426":75092,"_3090":127306},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3640":75105,"_31229":75092,"_21648":127308,"_5":14899,"_28426":127270,"_3090":127309},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3640":75106,"_31229":75092,"_21648":127311,"_5":14899,"_28426":127274,"_3090":127312},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3640":75107,"_31229":75092,"_21648":127314,"_5":14899,"_28426":127278,"_3090":127315},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3640":75108,"_31229":75092,"_21648":127317,"_5":14899,"_28426":127282,"_3090":127318},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3640":75109,"_31229":75092,"_21648":127320,"_5":14899,"_28426":127286,"_3090":127321},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3640":75110,"_31229":75092,"_21648":127323,"_5":14899,"_28426":127286,"_3090":127324},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3640":75111,"_31229":75092,"_21648":127326,"_5":14899,"_28426":127286,"_3090":127327},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3640":75112,"_31229":75092,"_21648":127329,"_5":14899,"_28426":127286,"_3090":127330},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3640":75113,"_31229":75092,"_21648":127332,"_5":14899,"_28426":127286,"_3090":127333},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3640":75114,"_31229":75092,"_21648":127335,"_5":14899,"_28426":127286,"_3090":127336},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3640":75115,"_31229":75092,"_21648":127338,"_5":14899,"_28426":127290,"_3090":127339},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3640":75116,"_31229":75092,"_21648":127341,"_5":14899,"_28426":127290,"_3090":127342},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3640":75117,"_31229":75092,"_21648":127344,"_5":14899,"_28426":127290,"_3090":127345},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3640":75118,"_31229":75092,"_21648":127347,"_5":14899,"_28426":127290,"_3090":127348},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3640":75119,"_31229":75092,"_21648":127350,"_5":14899,"_28426":127290,"_3090":127351},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3640":75120,"_31229":75092,"_21648":127353,"_5":14899,"_28426":127294,"_3090":127354},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3640":75121,"_31229":75092,"_21648":127356,"_5":14899,"_28426":127294,"_3090":127357},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3640":75122,"_31229":75092,"_21648":127359,"_5":14899,"_28426":127294,"_3090":127360},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3640":75123,"_31229":75092,"_21648":127362,"_5":14899,"_28426":127294,"_3090":127363},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3640":75124,"_31229":75092,"_21648":127365,"_5":14899,"_28426":127294,"_3090":127366},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3640":75125,"_31229":75092,"_21648":127368,"_5":14899,"_28426":127294,"_3090":127369},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3640":75126,"_31229":75092,"_21648":127371,"_5":14899,"_28426":127294,"_3090":127372},[],"Durante la autenticación mTLS de un DMS, Lamassu comprueba la revocación y falla cerrada: un certificado cuya revocación no puede verificarse se rechaza por defecto. La opción `allow_unverifiable_revocation` del DMS (consulta DMS) es la excepción, y solo relaja los certificados que no llevan ningún endpoint OCSP/CRL. Diseña los perfiles y puntos de distribución para que la comprobación tenga éxito.",{"_3640":75127,"_31229":75092,"_21648":127374,"_5":14899,"_28426":127298,"_3090":127375},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3640":75128,"_31229":75092,"_21648":127377,"_5":14899,"_28426":127302,"_3090":127378},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3640":75129,"_31229":75092,"_21648":127380,"_5":14899,"_28426":127302,"_3090":127381},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3640":75130,"_31229":75092,"_21648":127383,"_5":14899,"_28426":127302,"_3090":127384},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3640":75131,"_31229":75092,"_21648":127386,"_5":14899,"_28426":127302,"_3090":127387},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3640":75132,"_31229":75092,"_21648":127389,"_5":14899,"_28426":127302,"_3090":127390},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3640":75133,"_31229":75092,"_21648":127392,"_5":14899,"_28426":127302,"_3090":127393},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3640":75134,"_31229":75092,"_21648":127395,"_5":14899,"_28426":127302,"_3090":127396},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3640":75135,"_31229":75135,"_5":15259,"_3090":127398,"_31567":127399,"_21648":127400,"_28426":75135},"Listas de revocación (CRL)",[51054,122173,56762,126872],[],{"_3640":75136,"_31229":75135,"_21648":127402,"_5":14899,"_28426":75135,"_3090":127403},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3640":75137,"_31229":75135,"_5":31564,"_21648":127405,"_28426":127406,"_3090":127407},[],"/docs/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3640":75138,"_31229":75135,"_5":31564,"_21648":127409,"_28426":127410,"_3090":127411},[],"/docs/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3640":75139,"_31229":75135,"_5":31564,"_21648":127413,"_28426":127414,"_3090":127415},[],"/docs/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3640":75140,"_31229":75135,"_5":31564,"_21648":127417,"_28426":127418,"_3090":127419},[],"/docs/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3640":75141,"_31229":75135,"_5":31564,"_21648":127421,"_28426":127422,"_3090":127423},[],"/docs/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3640":75142,"_31229":75135,"_5":31564,"_21648":127425,"_28426":127426,"_3090":127427},[],"/docs/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3640":75143,"_31229":75135,"_5":31564,"_21648":127429,"_28426":127430,"_3090":127431},[],"/docs/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3640":75144,"_31229":75135,"_5":31564,"_21648":127433,"_28426":127434,"_3090":127435},[],"/docs/es/platform/pki/crl#referencias","Referencias",{"_3640":75145,"_31229":75135,"_21648":127437,"_5":14899,"_28426":75135,"_3090":127438},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3640":75146,"_31229":75135,"_21648":127440,"_5":14899,"_28426":127406,"_3090":127441},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La VA los crea al crear una CA; al importar una CA cuya clave está en el KMS — importada con la clave privada, o que el KMS ya tenía — y cuyo certificado incluye `cRLSign`: esa CA publica su primera CRL de inmediato, igual que una creada; y al reemitir una CA sin ajustes con un certificado que pueda firmar CRLs. Una CA importada cuya clave no está en el KMS, o cuyo certificado carece de `cRLSign`, no recibe ajustes: la importación termina sin error, y los endpoints de CRL de la CA informan de que faltan los ajustes. Los ajustes nunca se crean retroactivamente: una CA que no los tiene se queda sin ellos hasta que se reemita. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3640":75147,"_31229":75135,"_21648":127443,"_5":14899,"_28426":127406,"_3090":127444},[],"Campo",{"_3640":75148,"_31229":75135,"_21648":127446,"_5":14899,"_28426":127406,"_3090":123865},[],{"_3640":75149,"_31229":75135,"_21648":127448,"_5":14899,"_28426":127406,"_3090":52702},[],{"_3640":75150,"_31229":75135,"_21648":127450,"_5":14899,"_28426":127406,"_3090":127451},[],"ID de la CA a la que pertenecen los ajustes.",{"_3640":75151,"_31229":75135,"_21648":127453,"_5":14899,"_28426":127406,"_3090":58019},[],{"_3640":75152,"_31229":75135,"_21648":127455,"_5":14899,"_28426":127406,"_3090":127456},[],"Ciclo de vida de los ajustes. Los `ACTIVE` generan CRLs. Los `FINAL` pertenecen a una CA revocada de forma permanente o caducada: la primera publica una CRL final, válida hasta que expire el certificado actual de la CA, y la segunda pasa a `FINAL` sin CRL final. Los `ARCHIVED` pertenecen a una CA eliminada: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3640":75153,"_31229":75135,"_21648":127458,"_5":14899,"_28426":127406,"_3090":58025},[],{"_3640":75154,"_31229":75135,"_21648":127460,"_5":14899,"_28426":127406,"_3090":127461},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3640":75155,"_31229":75135,"_21648":127463,"_5":14899,"_28426":127406,"_3090":58031},[],{"_3640":75156,"_31229":75135,"_21648":127465,"_5":14899,"_28426":127406,"_3090":127466},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3640":75157,"_31229":75135,"_21648":127468,"_5":14899,"_28426":127406,"_3090":127469},[],"Campo de `crl_options`",{"_3640":75158,"_31229":75135,"_21648":127471,"_5":14899,"_28426":127406,"_3090":123865},[],{"_3640":75159,"_31229":75135,"_21648":127473,"_5":14899,"_28426":127406,"_3090":127474},[],"Valor inicial",{"_3640":75160,"_31229":75135,"_21648":127476,"_5":14899,"_28426":127406,"_3090":58045},[],{"_3640":75161,"_31229":75135,"_21648":127478,"_5":14899,"_28426":127406,"_3090":127479},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3640":75162,"_31229":75135,"_21648":127481,"_5":14899,"_28426":127406,"_3090":127482},[],"7 días.",{"_3640":75163,"_31229":75135,"_21648":127484,"_5":14899,"_28426":127406,"_3090":58054},[],{"_3640":75164,"_31229":75135,"_21648":127486,"_5":14899,"_28426":127406,"_3090":127487},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3640":75165,"_31229":75135,"_21648":127489,"_5":14899,"_28426":127406,"_3090":127490},[],"6 días y 23 horas.",{"_3640":75166,"_31229":75135,"_21648":127492,"_5":14899,"_28426":127406,"_3090":58063},[],{"_3640":75167,"_31229":75135,"_21648":127494,"_5":14899,"_28426":127406,"_3090":127495},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3640":75168,"_31229":75135,"_21648":127497,"_5":14899,"_28426":127406,"_3090":58069},[],{"_3640":75169,"_31229":75135,"_21648":127499,"_5":14899,"_28426":127406,"_3090":58072},[],{"_3640":75170,"_31229":75135,"_21648":127501,"_5":14899,"_28426":127406,"_3090":127502},[],"Número de serie del certificado existente que firma la CRL.",{"_3640":75171,"_31229":75135,"_21648":127504,"_5":14899,"_28426":127406,"_3090":127505},[],"Número de serie del certificado actual de la CA.",{"_3640":75172,"_31229":75135,"_21648":127507,"_5":14899,"_28426":127406,"_3090":127508},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3640":75173,"_31229":75135,"_21648":127510,"_5":14899,"_28426":127406,"_3090":127511},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3640":75174,"_31229":75135,"_21648":127513,"_5":14899,"_28426":127406,"_3090":127514},[],"Las decisiones del ciclo de vida de la CRL — cuándo deja de publicarse y cuándo expira la CRL final — usan únicamente el certificado actual de la CA. Si un certificado reemitido expira antes que un certificado antiguo que sigue vigente, la publicación de CRLs puede detenerse, o la CRL final puede expirar, mientras el certificado antiguo siga vigente. Es una limitación aceptada del comportamiento actual.",{"_3640":75175,"_31229":75135,"_21648":127516,"_5":14899,"_28426":127406,"_3090":127517},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Una CA que no tiene ajustes — por ejemplo, una importada sin `cRLSign` — no tiene nada que actualizar: la única vía para obtenerlos es reemitir la CA con un certificado que incluya `cRLSign`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3640":75176,"_31229":75135,"_21648":127519,"_5":14899,"_28426":127406,"_3090":127520},[],"Eliminar una CA conserva sus ajustes de CRL; permanecen hasta que borres los archivados por API o desde la página Verification Authorities de la consola (consulta API de gestión de los ajustes de CRL). Lo que ocurre con ellos depende de cómo terminó la CA:",{"_3640":75177,"_31229":75135,"_21648":127522,"_5":14899,"_28426":127406,"_3090":127523},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3640":75178,"_31229":75135,"_21648":127525,"_5":14899,"_28426":127406,"_3090":127526},[],"Revocar una CA de forma permanente o dejar que caduque finaliza sus ajustes: su `status` pasa a `FINAL`, cualquier `PUT` devuelve 409 y no se genera ninguna CRL nueva. Una CA revocada permanentemente publica una CRL final, válida hasta que expire el certificado actual de la CA; una CA caducada no recibe ninguna. Eliminar después la CA archiva sus ajustes, que pasan a comportarse como los archivados de la migración.",{"_3640":75179,"_31229":75135,"_21648":127528,"_5":14899,"_28426":127406,"_3090":127529},[],"Los ajustes dejan de poder editarse mientras su `status` no sea `ACTIVE`. Ajusta validez y firmante antes de revocar o eliminar una CA.",{"_3640":75180,"_31229":75135,"_21648":127531,"_5":14899,"_28426":127406,"_3090":127532},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3640":75181,"_31229":75135,"_21648":127534,"_5":14899,"_28426":127406,"_3090":127535},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3640":75182,"_31229":75135,"_21648":127537,"_5":14899,"_28426":127406,"_3090":127538},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3640":75183,"_31229":75135,"_21648":127540,"_5":14899,"_28426":127410,"_3090":127541},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3640":75184,"_31229":75135,"_21648":127543,"_5":14899,"_28426":127410,"_3090":127544},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3640":75185,"_31229":75135,"_21648":127546,"_5":14899,"_28426":127410,"_3090":127547},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3640":75186,"_31229":75135,"_21648":127549,"_5":14899,"_28426":127410,"_3090":127550},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3640":75187,"_31229":75135,"_21648":127552,"_5":14899,"_28426":127414,"_3090":127553},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3640":75188,"_31229":75135,"_21648":127555,"_5":14899,"_28426":127414,"_3090":127556},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3640":75189,"_31229":75135,"_21648":127558,"_5":14899,"_28426":127414,"_3090":127559},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3640":75190,"_31229":75135,"_21648":127561,"_5":14899,"_28426":127414,"_3090":127562},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3640":75191,"_31229":75135,"_21648":127564,"_5":14899,"_28426":127414,"_3090":127565},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3640":75192,"_31229":75135,"_21648":127567,"_5":14899,"_28426":127414,"_3090":127568},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3640":75193,"_31229":75135,"_21648":127570,"_5":14899,"_28426":127414,"_3090":127571},[],"Los ajustes con `status` distinto de `ACTIVE` — `FINAL` o `ARCHIVED` — se omiten: nada regenera su CRL.",{"_3640":75194,"_31229":75135,"_21648":127573,"_5":14899,"_28426":127414,"_3090":127574},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3640":75195,"_31229":75135,"_21648":127576,"_5":14899,"_28426":127414,"_3090":127577},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3640":75196,"_31229":75135,"_21648":127579,"_5":14899,"_28426":127418,"_3090":127580},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3640":75197,"_31229":75135,"_21648":127582,"_5":14899,"_28426":127418,"_3090":127583},[],"Cuando la VA tiene dominios configurados, la lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con esas URLs de distribución; una VA sin dominios configurados publica la lista sin IDP, y una CRL sin IDP cubre todos los certificados de su CA. Cuando la extensión está presente, comprueba que tu cliente la interpreta y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3640":75198,"_31229":75135,"_21648":127585,"_5":14899,"_28426":127422,"_3090":127586},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3640":75199,"_31229":75135,"_21648":127588,"_5":14899,"_28426":127422,"_3090":127589},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3640":75200,"_31229":75135,"_21648":127591,"_5":14899,"_28426":127422,"_3090":127592},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3640":75201,"_31229":75135,"_21648":127594,"_5":14899,"_28426":127422,"_3090":127595},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3640":75202,"_31229":75135,"_21648":127597,"_5":14899,"_28426":127422,"_3090":127598},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3640":75203,"_31229":75135,"_21648":127600,"_5":14899,"_28426":127426,"_3090":127601},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3640":75204,"_31229":75135,"_21648":127603,"_5":14899,"_28426":127426,"_3090":124054},[],{"_3640":75205,"_31229":75135,"_21648":127605,"_5":14899,"_28426":127426,"_3090":127606},[],"Path relativo",{"_3640":75206,"_31229":75135,"_21648":127608,"_5":14899,"_28426":127426,"_3090":121933},[],{"_3640":75207,"_31229":75135,"_21648":127610,"_5":14899,"_28426":127426,"_3090":58184},[],{"_3640":75208,"_31229":75135,"_21648":127612,"_5":14899,"_28426":127426,"_3090":58187},[],{"_3640":75209,"_31229":75135,"_21648":127614,"_5":14899,"_28426":127426,"_3090":127615},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3640":75210,"_31229":75135,"_21648":127617,"_5":14899,"_28426":127426,"_3090":58184},[],{"_3640":75211,"_31229":75135,"_21648":127619,"_5":14899,"_28426":127426,"_3090":58195},[],{"_3640":75212,"_31229":75135,"_21648":127621,"_5":14899,"_28426":127426,"_3090":127622},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3640":75213,"_31229":75135,"_21648":127624,"_5":14899,"_28426":127426,"_3090":58201},[],{"_3640":75214,"_31229":75135,"_21648":127626,"_5":14899,"_28426":127426,"_3090":58195},[],{"_3640":75215,"_31229":75135,"_21648":127628,"_5":14899,"_28426":127426,"_3090":127629},[],"Sustituir la configuración de CRL de una CA.",{"_3640":75216,"_31229":75135,"_21648":127631,"_5":14899,"_28426":127426,"_3090":58209},[],{"_3640":75217,"_31229":75135,"_21648":127633,"_5":14899,"_28426":127426,"_3090":58195},[],{"_3640":75218,"_31229":75135,"_21648":127635,"_5":14899,"_28426":127426,"_3090":127636},[],"Eliminar los ajustes de CRL archivados de una CA.",{"_3640":75219,"_31229":75135,"_21648":127638,"_5":14899,"_28426":127426,"_3090":127639},[],"Necesitas autenticación y permisos de lectura, actualización o borrado de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3640":75220,"_31229":75135,"_21648":127641,"_5":14899,"_28426":127426,"_3090":127642},[],"Los ajustes archivados, cuya CA ya no existe, pueden eliminarse con `DELETE`: la llamada devuelve 204 en caso de éxito, 404 cuando la CA no tiene ajustes y 409 mientras los ajustes no estén todavía archivados. Tras el borrado, el endpoint público `/crl/{id}` y cualquier endpoint heredado `/crl/<ski>` dejan de servir la lista de la CA, aunque los ficheros de CRL publicados permanecen en el bucket. Conserva los ajustes archivados mientras cualquier certificado emitido por la CA pueda necesitar evidencia de revocación: `DELETE` deja de servir la lista inmediatamente, independientemente de la validez de `latest_crl`. La acción no puede deshacerse.",{"_3640":75221,"_31229":75135,"_21648":127644,"_5":14899,"_28426":127426,"_3090":127645},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3640":75222,"_31229":75135,"_21648":127647,"_5":14899,"_28426":127430,"_3090":127648},[],"Síntoma",{"_3640":75223,"_31229":75135,"_21648":127650,"_5":14899,"_28426":127430,"_3090":127651},[],"Causa",{"_3640":75224,"_31229":75135,"_21648":127653,"_5":14899,"_28426":127430,"_3090":127654},[],"Acción",{"_3640":75225,"_31229":75135,"_21648":127656,"_5":14899,"_28426":127430,"_3090":127657},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3640":75226,"_31229":75135,"_21648":127659,"_5":14899,"_28426":127430,"_3090":127660},[],"Los ajustes no están `ACTIVE`: revocar la CA de forma permanente o dejar que caduque los finalizó, o la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3640":75227,"_31229":75135,"_21648":127662,"_5":14899,"_28426":127430,"_3090":127663},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3640":75228,"_31229":75135,"_21648":127665,"_5":14899,"_28426":127430,"_3090":127666},[],"`DELETE /v1/crl-settings/{ca-id}` devuelve 409.",{"_3640":75229,"_31229":75135,"_21648":127668,"_5":14899,"_28426":127430,"_3090":127669},[],"Los ajustes no están todavía `ARCHIVED`: la CA no se ha eliminado.",{"_3640":75230,"_31229":75135,"_21648":127671,"_5":14899,"_28426":127430,"_3090":127672},[],"Elimina primero la CA; su eliminación archiva los ajustes.",{"_3640":75231,"_31229":75135,"_21648":127674,"_5":14899,"_28426":127430,"_3090":127675},[],"`PUT` devuelve 400.",{"_3640":75232,"_31229":75135,"_21648":127677,"_5":14899,"_28426":127430,"_3090":127678},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3640":75233,"_31229":75135,"_21648":127680,"_5":14899,"_28426":127430,"_3090":127681},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3640":75234,"_31229":75135,"_21648":127683,"_5":14899,"_28426":127430,"_3090":127684},[],"`PUT` devuelve 404.",{"_3640":75235,"_31229":75135,"_21648":127686,"_5":14899,"_28426":127430,"_3090":127687},[],"La CA o el certificado firmante nuevo no existen, o la CA no tiene ajustes de CRL, por ejemplo porque se importó sin su clave o su certificado carece de `cRLSign`.",{"_3640":75236,"_31229":75135,"_21648":127689,"_5":14899,"_28426":127430,"_3090":127690},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3640":75237,"_31229":75135,"_21648":127692,"_5":14899,"_28426":127430,"_3090":127693},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3640":75238,"_31229":75135,"_21648":127695,"_5":14899,"_28426":127430,"_3090":127696},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3640":75239,"_31229":75135,"_21648":127698,"_5":14899,"_28426":127430,"_3090":127699},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3640":75240,"_31229":75135,"_21648":127701,"_5":14899,"_28426":127430,"_3090":127702},[],"La CRL no cambia tras revocar un certificado.",{"_3640":75241,"_31229":75135,"_21648":127704,"_5":14899,"_28426":127430,"_3090":127705},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3640":75242,"_31229":75135,"_21648":127707,"_5":14899,"_28426":127430,"_3090":127708},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3640":75243,"_31229":75135,"_21648":127710,"_5":14899,"_28426":127430,"_3090":127711},[],"Un verificador rechaza la CRL por el emisor.",{"_3640":75244,"_31229":75135,"_21648":127713,"_5":14899,"_28426":127430,"_3090":127714},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3640":75245,"_31229":75135,"_21648":127716,"_5":14899,"_28426":127430,"_3090":127717},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3640":75246,"_31229":75135,"_21648":127719,"_5":14899,"_28426":127434,"_3090":127720},[],"RFC 5280: perfil X.509 y CRL.",{"_3640":75247,"_31229":75135,"_21648":127722,"_5":14899,"_28426":127434,"_3090":58301},[],{"_3640":75248,"_31229":75135,"_21648":127724,"_5":14899,"_28426":127434,"_3090":58304},[],{"_3640":75249,"_31229":75135,"_21648":127726,"_5":14899,"_28426":127434,"_3090":127727},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3640":75250,"_31229":75135,"_21648":127729,"_5":14899,"_28426":127434,"_3090":127730},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3640":75251,"_31229":75251,"_5":15259,"_3090":127732,"_31567":127733,"_21648":127734,"_28426":75251},"Claves y motores criptográficos",[51054,122173,56762,126201],[],{"_3640":75252,"_31229":75251,"_21648":127736,"_5":14899,"_28426":75251,"_3090":127737},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3640":75253,"_31229":75251,"_5":31564,"_21648":127739,"_28426":127740,"_3090":127741},[],"/docs/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3640":75254,"_31229":75251,"_5":31564,"_21648":127743,"_28426":127744,"_3090":127745},[],"/docs/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3640":75255,"_31229":75251,"_5":31564,"_21648":127747,"_28426":127748,"_3090":58329},[],"/docs/es/platform/pki/key-management#file-system",{"_3640":75256,"_31229":75251,"_5":31564,"_21648":127750,"_28426":127751,"_3090":58333},[],"/docs/es/platform/pki/key-management#hashicorp-vault",{"_3640":75257,"_31229":75251,"_5":31564,"_21648":127753,"_28426":127754,"_3090":58337},[],"/docs/es/platform/pki/key-management#aws-secrets-manager",{"_3640":75258,"_31229":75251,"_5":31564,"_21648":127756,"_28426":127757,"_3090":58341},[],"/docs/es/platform/pki/key-management#aws-kms",{"_3640":75259,"_31229":75251,"_5":31564,"_21648":127759,"_28426":127760,"_3090":58345},[],"/docs/es/platform/pki/key-management#pkcs11",{"_3640":75260,"_31229":75251,"_5":31564,"_21648":127762,"_28426":127763,"_3090":58349},[],"/docs/es/platform/pki/key-management#azure-key-vault",{"_3640":75261,"_31229":75251,"_5":31564,"_21648":127765,"_28426":127766,"_3090":127767},[],"/docs/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3640":75262,"_31229":75251,"_5":31564,"_21648":127769,"_28426":127770,"_3090":127771},[],"/docs/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3640":75263,"_31229":75251,"_5":31564,"_21648":127773,"_28426":127774,"_3090":127775},[],"/docs/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3640":75264,"_31229":75251,"_5":31564,"_21648":127777,"_28426":127778,"_3090":127779},[],"/docs/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3640":75265,"_31229":75251,"_5":31564,"_21648":127781,"_28426":127782,"_3090":127783},[],"/docs/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3640":75266,"_31229":75251,"_5":31564,"_21648":127785,"_28426":127786,"_3090":127787},[],"/docs/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3640":75267,"_31229":75251,"_5":31564,"_21648":127789,"_28426":127790,"_3090":127791},[],"/docs/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3640":75268,"_31229":75251,"_5":31564,"_21648":127793,"_28426":127794,"_3090":58381},[],"/docs/es/platform/pki/key-management#sign",{"_3640":75269,"_31229":75251,"_5":31564,"_21648":127796,"_28426":127797,"_3090":58385},[],"/docs/es/platform/pki/key-management#verify",{"_3640":75270,"_31229":75251,"_5":31564,"_21648":127799,"_28426":127800,"_3090":127801},[],"/docs/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3640":75271,"_31229":75251,"_5":31564,"_21648":127803,"_28426":127804,"_3090":127805},[],"/docs/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3640":75272,"_31229":75251,"_5":31564,"_21648":127807,"_28426":127808,"_3090":127809},[],"/docs/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3640":75273,"_31229":75251,"_21648":127811,"_5":14899,"_28426":75251,"_3090":127812},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3640":75274,"_31229":75251,"_21648":127814,"_5":14899,"_28426":75251,"_3090":127815},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3640":75275,"_31229":75251,"_21648":127817,"_5":14899,"_28426":127740,"_3090":127818},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3640":75276,"_31229":75251,"_21648":127820,"_5":14899,"_28426":127740,"_3090":127821},[],"En la práctica, permite:",{"_3640":75277,"_31229":75251,"_21648":127823,"_5":14899,"_28426":127740,"_3090":127824},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3640":75278,"_31229":75251,"_21648":127826,"_5":14899,"_28426":127740,"_3090":127827},[],"Importar claves creadas externamente.",{"_3640":75279,"_31229":75251,"_21648":127829,"_5":14899,"_28426":127740,"_3090":127830},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3640":75280,"_31229":75251,"_21648":127832,"_5":14899,"_28426":127740,"_3090":127833},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3640":75281,"_31229":75251,"_21648":127835,"_5":14899,"_28426":127744,"_3090":127836},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3640":75282,"_31229":75251,"_21648":127838,"_5":14899,"_28426":127744,"_3090":127839},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3640":75283,"_31229":75251,"_21648":127841,"_5":14899,"_28426":127744,"_3090":127842},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3640":75284,"_31229":75251,"_21648":127844,"_5":14899,"_28426":127748,"_3090":127845},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3640":75285,"_31229":75251,"_21648":127847,"_5":14899,"_28426":127751,"_3090":127848},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3640":75286,"_31229":75251,"_21648":127850,"_5":14899,"_28426":127751,"_3090":127851},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3640":75287,"_31229":75251,"_21648":127853,"_5":14899,"_28426":127754,"_3090":127854},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3640":75288,"_31229":75251,"_21648":127856,"_5":14899,"_28426":127757,"_3090":127857},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3640":75289,"_31229":75251,"_21648":127859,"_5":14899,"_28426":127760,"_3090":127860},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3640":75290,"_31229":75251,"_21648":127862,"_5":14899,"_28426":127763,"_3090":127863},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3640":75291,"_31229":75251,"_21648":127865,"_5":14899,"_28426":127763,"_3090":127866},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3640":75292,"_31229":75251,"_21648":127868,"_5":14899,"_28426":127763,"_3090":127869},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3640":75293,"_31229":75251,"_21648":127871,"_5":14899,"_28426":127763,"_3090":127872},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3640":75294,"_31229":75251,"_21648":127874,"_5":14899,"_28426":127766,"_3090":127875},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3640":75295,"_31229":75251,"_21648":127877,"_5":14899,"_28426":127766,"_3090":127878},[],"La tabla incluye los siguientes campos:",{"_3640":75296,"_31229":75251,"_21648":127880,"_5":14899,"_28426":127766,"_3090":127881},[],"**Name**: nombre descriptivo de la clave.",{"_3640":75297,"_31229":75251,"_21648":127883,"_5":14899,"_28426":127766,"_3090":127884},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3640":75298,"_31229":75251,"_21648":127886,"_5":14899,"_28426":127766,"_3090":127887},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3640":75299,"_31229":75251,"_21648":127889,"_5":14899,"_28426":127766,"_3090":127890},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3640":75300,"_31229":75251,"_21648":127892,"_5":14899,"_28426":127766,"_3090":127893},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3640":75301,"_31229":75251,"_21648":127895,"_5":14899,"_28426":127766,"_3090":127896},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3640":75302,"_31229":75251,"_21648":127898,"_5":14899,"_28426":127766,"_3090":127899},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3640":75303,"_31229":75251,"_21648":127901,"_5":14899,"_28426":127766,"_3090":127902},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3640":75304,"_31229":75251,"_21648":127904,"_5":14899,"_28426":127766,"_3090":127905},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3640":75305,"_31229":75251,"_21648":127907,"_5":14899,"_28426":127766,"_3090":127908},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3640":75306,"_31229":75251,"_21648":127910,"_5":14899,"_28426":127766,"_3090":127911},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3640":75307,"_31229":75251,"_21648":127913,"_5":14899,"_28426":127766,"_3090":127914},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3640":75308,"_31229":75251,"_21648":127916,"_5":14899,"_28426":127766,"_3090":127917},[],"**Delete Key** para eliminar la clave del sistema.",{"_3640":75309,"_31229":75251,"_21648":127919,"_5":14899,"_28426":127770,"_3090":127920},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3640":75310,"_31229":75251,"_21648":127922,"_5":14899,"_28426":127774,"_3090":127923},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3640":75311,"_31229":75251,"_21648":127925,"_5":14899,"_28426":127774,"_3090":127926},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3640":75312,"_31229":75251,"_21648":127928,"_5":14899,"_28426":127774,"_3090":127929},[],"**Key Name**: nombre único y descriptivo.",{"_3640":75313,"_31229":75251,"_21648":127931,"_5":14899,"_28426":127774,"_3090":127932},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3640":75314,"_31229":75251,"_21648":127934,"_5":14899,"_28426":127774,"_3090":127935},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3640":75315,"_31229":75251,"_21648":127937,"_5":14899,"_28426":127774,"_3090":127938},[],"**Tags**: metadatos para clasificar la clave.",{"_3640":75316,"_31229":75251,"_21648":127940,"_5":14899,"_28426":127774,"_3090":127941},[],"**Metadata**: información adicional para usos avanzados.",{"_3640":75317,"_31229":75251,"_21648":127943,"_5":14899,"_28426":127778,"_3090":127944},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3640":75318,"_31229":75251,"_21648":127946,"_5":14899,"_28426":127778,"_3090":127947},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3640":75319,"_31229":75251,"_21648":127949,"_5":14899,"_28426":127778,"_3090":127950},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3640":75320,"_31229":75251,"_21648":127952,"_5":14899,"_28426":127778,"_3090":127953},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3640":75321,"_31229":75251,"_21648":127955,"_5":14899,"_28426":127778,"_3090":127956},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3640":75322,"_31229":75251,"_21648":127958,"_5":14899,"_28426":127778,"_3090":127959},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3640":75323,"_31229":75251,"_21648":127961,"_5":14899,"_28426":127778,"_3090":127962},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3640":75324,"_31229":75251,"_21648":127964,"_5":14899,"_28426":127778,"_3090":127965},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3640":75325,"_31229":75251,"_21648":127967,"_5":14899,"_28426":127778,"_3090":127968},[],"**Metadata**: información adicional opcional.",{"_3640":75326,"_31229":75251,"_21648":127970,"_5":14899,"_28426":127778,"_3090":127971},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3640":75327,"_31229":75251,"_21648":127973,"_5":14899,"_28426":127778,"_3090":127974},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3640":75328,"_31229":75251,"_21648":127976,"_5":14899,"_28426":127782,"_3090":127977},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3640":75329,"_31229":75251,"_21648":127979,"_5":14899,"_28426":127786,"_3090":127980},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3640":75330,"_31229":75251,"_21648":127982,"_5":14899,"_28426":127786,"_3090":127983},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3640":75331,"_31229":75251,"_21648":127985,"_5":14899,"_28426":127786,"_3090":127986},[],"**Key Name**: nombre descriptivo.",{"_3640":75332,"_31229":75251,"_21648":127988,"_5":14899,"_28426":127786,"_3090":127989},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3640":75333,"_31229":75251,"_21648":127991,"_5":14899,"_28426":127786,"_3090":127992},[],"**Tags**: etiquetas asociadas.",{"_3640":75334,"_31229":75251,"_21648":127994,"_5":14899,"_28426":127786,"_3090":127995},[],"**Aliases**: nombres alternativos.",{"_3640":75335,"_31229":75251,"_21648":127997,"_5":14899,"_28426":127786,"_3090":127998},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3640":75336,"_31229":75251,"_21648":128000,"_5":14899,"_28426":127786,"_3090":128001},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3640":75337,"_31229":75251,"_21648":128003,"_5":14899,"_28426":127786,"_3090":128004},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3640":75338,"_31229":75251,"_21648":128006,"_5":14899,"_28426":127786,"_3090":128007},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3640":75339,"_31229":75251,"_21648":128009,"_5":14899,"_28426":127790,"_3090":128010},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3640":75340,"_31229":75251,"_21648":128012,"_5":14899,"_28426":127790,"_3090":128013},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3640":75341,"_31229":75251,"_21648":128015,"_5":14899,"_28426":127790,"_3090":128016},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3640":75342,"_31229":75251,"_21648":128018,"_5":14899,"_28426":127794,"_3090":128019},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3640":75343,"_31229":75251,"_21648":128021,"_5":14899,"_28426":127794,"_3090":128022},[],"Campos principales:",{"_3640":75344,"_31229":75251,"_21648":128024,"_5":14899,"_28426":127794,"_3090":128025},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3640":75345,"_31229":75251,"_21648":128027,"_5":14899,"_28426":127794,"_3090":128028},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3640":75346,"_31229":75251,"_21648":128030,"_5":14899,"_28426":127794,"_3090":128031},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3640":75347,"_31229":75251,"_21648":128033,"_5":14899,"_28426":127794,"_3090":128034},[],"**Message**: contenido que se va a firmar.",{"_3640":75348,"_31229":75251,"_21648":128036,"_5":14899,"_28426":127794,"_3090":128037},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3640":75349,"_31229":75251,"_21648":128039,"_5":14899,"_28426":127797,"_3090":128040},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3640":75350,"_31229":75251,"_21648":128042,"_5":14899,"_28426":127797,"_3090":128022},[],{"_3640":75351,"_31229":75251,"_21648":128044,"_5":14899,"_28426":127797,"_3090":128045},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3640":75352,"_31229":75251,"_21648":128047,"_5":14899,"_28426":127797,"_3090":128048},[],"**Message Type**: `Raw` o `Digest`.",{"_3640":75353,"_31229":75251,"_21648":128050,"_5":14899,"_28426":127797,"_3090":128051},[],"**Payload Encoding**: codificación del mensaje.",{"_3640":75354,"_31229":75251,"_21648":128053,"_5":14899,"_28426":127797,"_3090":128054},[],"**Message**: mensaje original o hash.",{"_3640":75355,"_31229":75251,"_21648":128056,"_5":14899,"_28426":127797,"_3090":128057},[],"**Signature**: firma que se desea comprobar.",{"_3640":75356,"_31229":75251,"_21648":128059,"_5":14899,"_28426":127797,"_3090":128060},[],"**Result**: indicador del resultado de la validación.",{"_3640":75357,"_31229":75251,"_21648":128062,"_5":14899,"_28426":127800,"_3090":128063},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3640":75358,"_31229":75251,"_21648":128065,"_5":14899,"_28426":127800,"_3090":128066},[],"Este flujo es útil para:",{"_3640":75359,"_31229":75251,"_21648":128068,"_5":14899,"_28426":127800,"_3090":128069},[],"Solicitar certificados a una CA externa.",{"_3640":75360,"_31229":75251,"_21648":128071,"_5":14899,"_28426":127800,"_3090":128072},[],"Renovar una identidad manteniendo la misma clave.",{"_3640":75361,"_31229":75251,"_21648":128074,"_5":14899,"_28426":127800,"_3090":128075},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3640":75362,"_31229":75251,"_21648":128077,"_5":14899,"_28426":127800,"_3090":128078},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3640":75363,"_31229":75251,"_21648":128080,"_5":14899,"_28426":127800,"_3090":128081},[],"**Organization (O)**: organización o empresa.",{"_3640":75364,"_31229":75251,"_21648":128083,"_5":14899,"_28426":127800,"_3090":128084},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3640":75365,"_31229":75251,"_21648":128086,"_5":14899,"_28426":127800,"_3090":128087},[],"**Country (C)**: código de país de dos letras.",{"_3640":75366,"_31229":75251,"_21648":128089,"_5":14899,"_28426":127800,"_3090":128090},[],"**State / Province (ST)**: estado o provincia.",{"_3640":75367,"_31229":75251,"_21648":128092,"_5":14899,"_28426":127800,"_3090":128093},[],"**Locality (L)**: ciudad o localidad.",{"_3640":75368,"_31229":75251,"_21648":128095,"_5":14899,"_28426":127800,"_3090":128096},[],"**Email Address**: correo de contacto.",{"_3640":75369,"_31229":75251,"_21648":128098,"_5":14899,"_28426":127800,"_3090":128099},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3640":75370,"_31229":75251,"_21648":128101,"_5":14899,"_28426":127800,"_3090":128102},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3640":75371,"_31229":75251,"_21648":128104,"_5":14899,"_28426":127804,"_3090":128105},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3640":75372,"_31229":75251,"_21648":128107,"_5":14899,"_28426":127804,"_3090":128108},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3640":75373,"_31229":75251,"_21648":128110,"_5":14899,"_28426":127808,"_3090":128111},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3640":75374,"_31229":75251,"_21648":128113,"_5":14899,"_28426":127808,"_3090":128114},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. El KMS también se niega a eliminar una clave que firma la CRL de una CA cuyos ajustes de CRL siguen `ACTIVE`, con el mismo `409` `key is in use`; esa referencia se libera cuando los ajustes se finalizan, después de que la CA se revoca de forma permanente o caduca (consulta CRL). La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3640":75375,"_31229":75375,"_5":15259,"_3090":128116,"_31567":128117,"_21648":128118,"_28426":75375},"Validación online con OCSP",[51054,122173,56762,126872],[],{"_3640":75376,"_31229":75375,"_21648":128120,"_5":14899,"_28426":75375,"_3090":128121},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3640":75377,"_31229":75375,"_5":31564,"_21648":128123,"_28426":128124,"_3090":128125},[],"/docs/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3640":75378,"_31229":75375,"_5":31564,"_21648":128127,"_28426":128128,"_3090":128129},[],"/docs/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3640":75379,"_31229":75375,"_5":31564,"_21648":128131,"_28426":128132,"_3090":128133},[],"/docs/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3640":75380,"_31229":75375,"_5":31564,"_21648":128135,"_28426":128136,"_3090":128137},[],"/docs/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3640":75381,"_31229":75375,"_5":31564,"_21648":128139,"_28426":128140,"_3090":128141},[],"/docs/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3640":75382,"_31229":75375,"_5":31564,"_21648":128143,"_28426":128144,"_3090":127435},[],"/docs/es/platform/pki/ocsp#referencias",{"_3640":75383,"_31229":75375,"_21648":128146,"_5":14899,"_28426":75375,"_3090":128147},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3640":75384,"_31229":75375,"_21648":128149,"_5":14899,"_28426":128124,"_3090":128150},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3640":75385,"_31229":75375,"_21648":128152,"_5":14899,"_28426":128124,"_3090":128153},[],"Estado del registro",{"_3640":75386,"_31229":75375,"_21648":128155,"_5":14899,"_28426":128124,"_3090":128156},[],"Respuesta firmada",{"_3640":75387,"_31229":75375,"_21648":128158,"_5":14899,"_28426":128124,"_3090":55899},[],{"_3640":75388,"_31229":75375,"_21648":128160,"_5":14899,"_28426":128124,"_3090":58749},[],{"_3640":75389,"_31229":75375,"_21648":128162,"_5":14899,"_28426":128124,"_3090":55916},[],{"_3640":75390,"_31229":75375,"_21648":128164,"_5":14899,"_28426":128124,"_3090":128165},[],"`Revoked`, con razón y fecha de revocación.",{"_3640":75391,"_31229":75375,"_21648":128167,"_5":14899,"_28426":128124,"_3090":128168},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3640":75392,"_31229":75375,"_21648":128170,"_5":14899,"_28426":128124,"_3090":128171},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3640":75393,"_31229":75375,"_21648":128173,"_5":14899,"_28426":128124,"_3090":128174},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3640":75394,"_31229":75375,"_21648":128176,"_5":14899,"_28426":128124,"_3090":128177},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3640":75395,"_31229":75375,"_21648":128179,"_5":14899,"_28426":128124,"_3090":128180},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3640":75396,"_31229":75375,"_21648":128182,"_5":14899,"_28426":128128,"_3090":128183},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3640":75397,"_31229":75375,"_21648":128185,"_5":14899,"_28426":128128,"_3090":128186},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3640":75398,"_31229":75375,"_21648":128188,"_5":14899,"_28426":128132,"_3090":128189},[],"El servicio acepta:",{"_3640":75399,"_31229":75375,"_21648":128191,"_5":14899,"_28426":128132,"_3090":124054},[],{"_3640":75400,"_31229":75375,"_21648":128193,"_5":14899,"_28426":128132,"_3090":128194},[],"Ruta del servicio VA",{"_3640":75401,"_31229":75375,"_21648":128196,"_5":14899,"_28426":128132,"_3090":128197},[],"Formato",{"_3640":75402,"_31229":75375,"_21648":128199,"_5":14899,"_28426":128132,"_3090":58789},[],{"_3640":75403,"_31229":75375,"_21648":128201,"_5":14899,"_28426":128132,"_3090":58792},[],{"_3640":75404,"_31229":75375,"_21648":128203,"_5":14899,"_28426":128132,"_3090":128204},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3640":75405,"_31229":75375,"_21648":128206,"_5":14899,"_28426":128132,"_3090":58184},[],{"_3640":75406,"_31229":75375,"_21648":128208,"_5":14899,"_28426":128132,"_3090":58800},[],{"_3640":75407,"_31229":75375,"_21648":128210,"_5":14899,"_28426":128132,"_3090":128211},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3640":75408,"_31229":75375,"_21648":128213,"_5":14899,"_28426":128132,"_3090":128214},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3640":75409,"_31229":75375,"_21648":128216,"_5":14899,"_28426":128136,"_3090":128217},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3640":75410,"_31229":75375,"_21648":128219,"_5":14899,"_28426":128136,"_3090":128220},[],"Genera la solicitud:",{"_3640":75411,"_31229":75375,"_21648":128222,"_5":14899,"_28426":128136,"_3090":128223},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3640":75412,"_31229":75375,"_21648":128225,"_5":14899,"_28426":128136,"_3090":128226},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3640":75413,"_31229":75375,"_21648":128228,"_5":14899,"_28426":128136,"_3090":128229},[],"Verifica el DER recibido:",{"_3640":75414,"_31229":75375,"_21648":128231,"_5":14899,"_28426":128136,"_3090":128232},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3640":75415,"_31229":75375,"_21648":128234,"_5":14899,"_28426":128140,"_3090":128235},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3640":75416,"_31229":75375,"_21648":128237,"_5":14899,"_28426":128140,"_3090":128238},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3640":75417,"_31229":75375,"_21648":128240,"_5":14899,"_28426":128144,"_3090":58833},[],{"_3640":75418,"_31229":75375,"_21648":128242,"_5":14899,"_28426":128144,"_3090":58836},[],{"_3640":75419,"_31229":75375,"_21648":128244,"_5":14899,"_28426":128144,"_3090":128245},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3640":75420,"_31229":75375,"_21648":128247,"_5":14899,"_28426":128144,"_3090":127730},[],{"_3640":75421,"_31229":75421,"_5":15259,"_3090":56762,"_31567":128249,"_21648":128250,"_28426":75421},[51054,122173,56762],[],{"_3640":75422,"_31229":75421,"_21648":128252,"_5":14899,"_28426":75421,"_3090":128253},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3640":75423,"_31229":75421,"_5":31564,"_21648":128255,"_28426":128256,"_3090":125527},[],"/docs/es/platform/pki/overview#empieza-aquí",{"_3640":75424,"_31229":75421,"_5":31564,"_21648":128258,"_28426":128259,"_3090":128260},[],"/docs/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3640":75425,"_31229":75421,"_5":31564,"_21648":128262,"_28426":128263,"_3090":126047},[],"/docs/es/platform/pki/overview#capacidades-principales",{"_3640":75426,"_31229":75421,"_5":31564,"_21648":128265,"_28426":128266,"_3090":126051},[],"/docs/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3640":75427,"_31229":75421,"_5":31564,"_21648":128268,"_28426":128269,"_3090":126055},[],"/docs/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3640":75428,"_31229":75421,"_5":31564,"_21648":128271,"_28426":128272,"_3090":126059},[],"/docs/es/platform/pki/overview#emite-y-controla-certificados",{"_3640":75429,"_31229":75421,"_5":31564,"_21648":128274,"_28426":128275,"_3090":126067},[],"/docs/es/platform/pki/overview#publica-el-estado-de-validación",{"_3640":75430,"_31229":75421,"_5":31564,"_21648":128277,"_28426":128278,"_3090":128279},[],"/docs/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3640":75431,"_31229":75421,"_5":31564,"_21648":128281,"_28426":128282,"_3090":127038},[],"/docs/es/platform/pki/overview#continúa",{"_3640":75432,"_31229":75421,"_21648":128284,"_5":14899,"_28426":75421,"_3090":128285},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3640":75433,"_31229":75421,"_21648":128287,"_5":14899,"_28426":128256,"_3090":128288},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3640":75434,"_31229":75421,"_21648":128290,"_5":14899,"_28426":128256,"_3090":128291},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3640":75435,"_31229":75421,"_21648":128293,"_5":14899,"_28426":128259,"_3090":128294},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3640":75436,"_31229":75421,"_21648":128296,"_5":14899,"_28426":128259,"_3090":128297},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3640":75437,"_31229":75421,"_21648":128299,"_5":14899,"_28426":128259,"_3090":128300},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3640":75438,"_31229":75421,"_21648":128302,"_5":14899,"_28426":128259,"_3090":128303},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3640":75439,"_31229":75421,"_21648":128305,"_5":14899,"_28426":128259,"_3090":128306},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3640":75440,"_31229":75421,"_21648":128308,"_5":14899,"_28426":128266,"_3090":128309},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3640":75441,"_31229":75421,"_21648":128311,"_5":14899,"_28426":128269,"_3090":128312},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3640":75442,"_31229":75421,"_21648":128314,"_5":14899,"_28426":128272,"_3090":128315},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3640":75443,"_31229":75421,"_21648":128317,"_5":14899,"_28426":128275,"_3090":128318},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3640":75444,"_31229":75421,"_21648":128320,"_5":14899,"_28426":128278,"_3090":128321},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3640":75445,"_31229":75421,"_21648":128323,"_5":14899,"_28426":128278,"_3090":128324},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3640":75446,"_31229":75421,"_21648":128326,"_5":14899,"_28426":128278,"_3090":128327},[],"su clave pública corresponda a la clave privada del cliente;",{"_3640":75447,"_31229":75421,"_21648":128329,"_5":14899,"_28426":128278,"_3090":128330},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3640":75448,"_31229":75421,"_21648":128332,"_5":14899,"_28426":128278,"_3090":128333},[],"sus fechas y usos permitan la operación;",{"_3640":75449,"_31229":75421,"_21648":128335,"_5":14899,"_28426":128278,"_3090":128336},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3640":75450,"_31229":75421,"_21648":128338,"_5":14899,"_28426":128278,"_3090":128339},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3640":75451,"_31229":75421,"_21648":128341,"_5":14899,"_28426":128282,"_3090":128342},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3640":75452,"_31229":75421,"_21648":128344,"_5":14899,"_28426":128282,"_3090":128345},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3640":75453,"_31229":75421,"_21648":128347,"_5":14899,"_28426":128282,"_3090":128348},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3640":75454,"_31229":75454,"_5":15259,"_3090":128350,"_31567":128351,"_21648":128352,"_28426":75454},"Crea tu primera CA",[51054,122173,56762,125651],[],{"_3640":75455,"_31229":75454,"_21648":128354,"_5":14899,"_28426":75454,"_3090":128355},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3640":75456,"_31229":75454,"_5":31564,"_21648":128357,"_28426":128358,"_3090":120691},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3640":75457,"_31229":75454,"_5":31564,"_21648":128360,"_28426":128361,"_3090":128362},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3640":75458,"_31229":75454,"_5":31564,"_21648":128364,"_28426":128365,"_3090":128366},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3640":75459,"_31229":75454,"_5":31564,"_21648":128368,"_28426":128369,"_3090":128370},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3640":75460,"_31229":75454,"_5":31564,"_21648":128372,"_28426":128373,"_3090":128374},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3640":75461,"_31229":75454,"_5":31564,"_21648":128376,"_28426":128377,"_3090":128378},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3640":75462,"_31229":75454,"_5":31564,"_21648":128380,"_28426":128381,"_3090":128382},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3640":75463,"_31229":75454,"_5":31564,"_21648":128384,"_28426":128385,"_3090":125898},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3640":75464,"_31229":75454,"_5":31564,"_21648":128387,"_28426":128388,"_3090":120715},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3640":75465,"_31229":75454,"_21648":128390,"_5":14899,"_28426":75454,"_3090":128391},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3640":75466,"_31229":75454,"_21648":128393,"_5":14899,"_28426":128358,"_3090":128394},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3640":75467,"_31229":75454,"_21648":128396,"_5":14899,"_28426":128358,"_3090":128397},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3640":75468,"_31229":75454,"_21648":128399,"_5":14899,"_28426":128358,"_3090":128400},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3640":75469,"_31229":75454,"_21648":128402,"_5":14899,"_28426":128358,"_3090":128403},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3640":75470,"_31229":75454,"_21648":128405,"_5":14899,"_28426":128361,"_3090":128406},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3640":75471,"_31229":75454,"_21648":128408,"_5":14899,"_28426":128361,"_3090":128409},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3640":75472,"_31229":75454,"_21648":128411,"_5":14899,"_28426":128365,"_3090":128412},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3640":75473,"_31229":75454,"_21648":128414,"_5":14899,"_28426":128365,"_3090":128415},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3640":75474,"_31229":75454,"_21648":128417,"_5":14899,"_28426":128369,"_3090":128418},[],"Selecciona **Root CA** y completa:",{"_3640":75475,"_31229":75454,"_21648":128420,"_5":14899,"_28426":128369,"_3090":59015},[],{"_3640":75476,"_31229":75454,"_21648":128422,"_5":14899,"_28426":128369,"_3090":128423},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3640":75477,"_31229":75454,"_21648":128425,"_5":14899,"_28426":128369,"_3090":128426},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3640":75478,"_31229":75454,"_21648":128428,"_5":14899,"_28426":128369,"_3090":128429},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3640":75479,"_31229":75454,"_21648":128431,"_5":14899,"_28426":128369,"_3090":128432},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3640":75480,"_31229":75454,"_21648":128434,"_5":14899,"_28426":128373,"_3090":128435},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3640":75481,"_31229":75454,"_21648":128437,"_5":14899,"_28426":128377,"_3090":128438},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3640":75482,"_31229":75454,"_21648":128440,"_5":14899,"_28426":128377,"_3090":128441},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3640":75483,"_31229":75454,"_21648":128443,"_5":14899,"_28426":128381,"_3090":128444},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3640":75484,"_31229":75454,"_21648":128446,"_5":14899,"_28426":128381,"_3090":128447},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3640":75485,"_31229":75454,"_21648":128449,"_5":14899,"_28426":128381,"_3090":128450},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3640":75486,"_31229":75454,"_21648":128452,"_5":14899,"_28426":128385,"_3090":128453},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3640":75487,"_31229":75454,"_21648":128455,"_5":14899,"_28426":128385,"_3090":128456},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3640":75488,"_31229":75454,"_21648":128458,"_5":14899,"_28426":128385,"_3090":128459},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3640":75489,"_31229":75454,"_21648":128461,"_5":14899,"_28426":128385,"_3090":128462},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3640":75490,"_31229":75454,"_21648":128464,"_5":14899,"_28426":128388,"_3090":128465},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3640":75491,"_31229":75491,"_5":15259,"_3090":128467,"_31567":128468,"_21648":128469,"_28426":75491},"Emite y verifica un certificado",[51054,122173,56762,125651],[],{"_3640":75492,"_31229":75491,"_21648":128471,"_5":14899,"_28426":75491,"_3090":128472},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3640":75493,"_31229":75491,"_5":31564,"_21648":128474,"_28426":128475,"_3090":120691},[],"/docs/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3640":75494,"_31229":75491,"_5":31564,"_21648":128477,"_28426":128478,"_3090":128479},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3640":75495,"_31229":75491,"_5":31564,"_21648":128481,"_28426":128482,"_3090":128483},[],"/docs/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3640":75496,"_31229":75491,"_5":31564,"_21648":128485,"_28426":128486,"_3090":128487},[],"/docs/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3640":75497,"_31229":75491,"_5":31564,"_21648":128489,"_28426":128490,"_3090":128491},[],"/docs/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3640":75498,"_31229":75491,"_5":31564,"_21648":128493,"_28426":128494,"_3090":128495},[],"/docs/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3640":75499,"_31229":75491,"_5":31564,"_21648":128497,"_28426":128498,"_3090":128499},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3640":75500,"_31229":75491,"_5":31564,"_21648":128501,"_28426":128502,"_3090":128503},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3640":75501,"_31229":75491,"_5":31564,"_21648":128505,"_28426":128506,"_3090":128507},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3640":75502,"_31229":75491,"_5":31564,"_21648":128509,"_28426":128510,"_3090":128511},[],"/docs/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3640":75503,"_31229":75491,"_5":31564,"_21648":128513,"_28426":128514,"_3090":125898},[],"/docs/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3640":75504,"_31229":75491,"_5":31564,"_21648":128516,"_28426":128517,"_3090":120715},[],"/docs/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3640":75505,"_31229":75491,"_21648":128519,"_5":14899,"_28426":75491,"_3090":128520},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3640":75506,"_31229":75491,"_21648":128522,"_5":14899,"_28426":128475,"_3090":128523},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3640":75507,"_31229":75491,"_21648":128525,"_5":14899,"_28426":128475,"_3090":128526},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3640":75508,"_31229":75491,"_21648":128528,"_5":14899,"_28426":128475,"_3090":128529},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3640":75509,"_31229":75491,"_21648":128531,"_5":14899,"_28426":128475,"_3090":128532},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3640":75510,"_31229":75491,"_21648":128534,"_5":14899,"_28426":128475,"_3090":128535},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3640":75511,"_31229":75491,"_21648":128537,"_5":14899,"_28426":128478,"_3090":128538},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3640":75512,"_31229":75491,"_21648":128540,"_5":14899,"_28426":128482,"_3090":128541},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3640":75513,"_31229":75491,"_21648":128543,"_5":14899,"_28426":128482,"_3090":128544},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3640":75514,"_31229":75491,"_21648":128546,"_5":14899,"_28426":128486,"_3090":128547},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3640":75515,"_31229":75491,"_21648":128549,"_5":14899,"_28426":128486,"_3090":128550},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3640":75516,"_31229":75491,"_21648":128552,"_5":14899,"_28426":128490,"_3090":128553},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3640":75517,"_31229":75491,"_21648":128555,"_5":14899,"_28426":128490,"_3090":128556},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3640":75518,"_31229":75491,"_21648":128558,"_5":14899,"_28426":128494,"_3090":128559},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3640":75519,"_31229":75491,"_21648":128561,"_5":14899,"_28426":128498,"_3090":128562},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3640":75520,"_31229":75491,"_21648":128564,"_5":14899,"_28426":128502,"_3090":128565},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3640":75521,"_31229":75491,"_21648":128567,"_5":14899,"_28426":128506,"_3090":128568},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3640":75522,"_31229":75491,"_21648":128570,"_5":14899,"_28426":128506,"_3090":128571},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3640":75523,"_31229":75491,"_21648":128573,"_5":14899,"_28426":128506,"_3090":128574},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3640":75524,"_31229":75491,"_21648":128576,"_5":14899,"_28426":128510,"_3090":128577},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3640":75525,"_31229":75491,"_21648":128579,"_5":14899,"_28426":128510,"_3090":128580},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3640":75526,"_31229":75491,"_21648":128582,"_5":14899,"_28426":128510,"_3090":128583},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3640":75527,"_31229":75491,"_21648":128585,"_5":14899,"_28426":128514,"_3090":125981},[],{"_3640":75528,"_31229":75491,"_21648":128587,"_5":14899,"_28426":128514,"_3090":124496},[],{"_3640":75529,"_31229":75491,"_21648":128589,"_5":14899,"_28426":128514,"_3090":128590},[],"La CA rechaza la emisión",{"_3640":75530,"_31229":75491,"_21648":128592,"_5":14899,"_28426":128514,"_3090":128593},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3640":75531,"_31229":75491,"_21648":128595,"_5":14899,"_28426":128514,"_3090":128596},[],"Sujeto o usos diferentes",{"_3640":75532,"_31229":75491,"_21648":128598,"_5":14899,"_28426":128514,"_3090":128599},[],"Perfil aplicado y valores solicitados.",{"_3640":75533,"_31229":75491,"_21648":128601,"_5":14899,"_28426":128514,"_3090":128602},[],"No se encuentra el emisor",{"_3640":75534,"_31229":75491,"_21648":128604,"_5":14899,"_28426":128514,"_3090":128605},[],"CA descargada y cadena intermedia necesaria.",{"_3640":75535,"_31229":75491,"_21648":128607,"_5":14899,"_28426":128514,"_3090":128608},[],"Falla la vigencia",{"_3640":75536,"_31229":75491,"_21648":128610,"_5":14899,"_28426":128514,"_3090":128611},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3640":75537,"_31229":75491,"_21648":128613,"_5":14899,"_28426":128514,"_3090":128614},[],"Los resúmenes de clave difieren",{"_3640":75538,"_31229":75491,"_21648":128616,"_5":14899,"_28426":128514,"_3090":128617},[],"Archivos de certificado y clave de la misma emisión.",{"_3640":75539,"_31229":75491,"_21648":128619,"_5":14899,"_28426":128514,"_3090":128620},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3640":75540,"_31229":75491,"_21648":128622,"_5":14899,"_28426":128517,"_3090":128623},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3640":75541,"_31229":75491,"_21648":128625,"_5":14899,"_28426":128517,"_3090":128626},[],"Gestionar certificados para inspección, estado y revocación.",{"_3640":75542,"_31229":75491,"_21648":128628,"_5":14899,"_28426":128517,"_3090":128629},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3640":75543,"_31229":75491,"_21648":128631,"_5":14899,"_28426":128517,"_3090":128632},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3640":75544,"_31229":75491,"_21648":128634,"_5":14899,"_28426":128517,"_3090":128635},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3640":75545,"_31229":75545,"_5":15259,"_3090":128637,"_31567":128638,"_21648":128639,"_28426":75545},"Primeros pasos de PKI",[51054,122173,56762,125651],[],{"_3640":75546,"_31229":75545,"_21648":128641,"_5":14899,"_28426":75545,"_3090":128642},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3640":75547,"_31229":75545,"_5":31564,"_21648":128644,"_28426":128645,"_3090":120691},[],"/docs/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3640":75548,"_31229":75545,"_5":31564,"_21648":128647,"_28426":128648,"_3090":128649},[],"/docs/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3640":75549,"_31229":75545,"_5":31564,"_21648":128651,"_28426":128652,"_3090":125833},[],"/docs/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3640":75550,"_31229":75545,"_5":31564,"_21648":128654,"_28426":128655,"_3090":128656},[],"/docs/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3640":75551,"_31229":75545,"_21648":128658,"_5":14899,"_28426":75545,"_3090":128659},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3640":75552,"_31229":75545,"_21648":128661,"_5":14899,"_28426":128645,"_3090":128662},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3640":75553,"_31229":75545,"_21648":128664,"_5":14899,"_28426":128645,"_3090":128665},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3640":75554,"_31229":75545,"_21648":128667,"_5":14899,"_28426":128645,"_3090":128668},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3640":75555,"_31229":75545,"_21648":128670,"_5":14899,"_28426":128645,"_3090":128671},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3640":75556,"_31229":75545,"_21648":128673,"_5":14899,"_28426":128645,"_3090":128674},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3640":75557,"_31229":75545,"_21648":128676,"_5":14899,"_28426":128648,"_3090":128677},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3640":75558,"_31229":75545,"_21648":128679,"_5":14899,"_28426":128648,"_3090":128680},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3640":75559,"_31229":75545,"_21648":128682,"_5":14899,"_28426":128648,"_3090":128683},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3640":75560,"_31229":75545,"_21648":128685,"_5":14899,"_28426":128648,"_3090":128686},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3640":75561,"_31229":75545,"_21648":128688,"_5":14899,"_28426":128652,"_3090":128689},[],"Archivo o recurso",{"_3640":75562,"_31229":75545,"_21648":128691,"_5":14899,"_28426":128652,"_3090":125830},[],{"_3640":75563,"_31229":75545,"_21648":128693,"_5":14899,"_28426":128652,"_3090":128694},[],"CA raíz activa y `ca.pem`",{"_3640":75564,"_31229":75545,"_21648":128696,"_5":14899,"_28426":128652,"_3090":128697},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3640":75565,"_31229":75545,"_21648":128699,"_5":14899,"_28426":128652,"_3090":128700},[],"Certificado final y `device.crt`",{"_3640":75566,"_31229":75545,"_21648":128702,"_5":14899,"_28426":128652,"_3090":128703},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3640":75567,"_31229":75545,"_21648":128705,"_5":14899,"_28426":128652,"_3090":128706},[],"Clave privada `device.key`",{"_3640":75568,"_31229":75545,"_21648":128708,"_5":14899,"_28426":128652,"_3090":128709},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3640":75569,"_31229":75545,"_21648":128711,"_5":14899,"_28426":128652,"_3090":128712},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3640":75570,"_31229":75545,"_21648":128714,"_5":14899,"_28426":128655,"_3090":128715},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3640":75571,"_31229":75545,"_21648":128717,"_5":14899,"_28426":128655,"_3090":128718},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3640":75572,"_31229":75545,"_21648":128720,"_5":14899,"_28426":128655,"_3090":128721},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3640":75573,"_31229":75573,"_5":15259,"_3090":128723,"_31567":128724,"_21648":128726,"_28426":75573},"Resolución de problemas PKI",[51054,122173,56762,128725],"Resolución de problemas",[],{"_3640":75574,"_31229":75573,"_21648":128728,"_5":14899,"_28426":75573,"_3090":128729},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3640":75575,"_31229":75573,"_5":31564,"_21648":128731,"_28426":128732,"_3090":128733},[],"/docs/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3640":75576,"_31229":75573,"_5":31564,"_21648":128735,"_28426":128736,"_3090":128737},[],"/docs/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3640":75577,"_31229":75573,"_5":31564,"_21648":128739,"_28426":128740,"_3090":128741},[],"/docs/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3640":75578,"_31229":75573,"_21648":128743,"_5":14899,"_28426":75573,"_3090":128744},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3640":75579,"_31229":75573,"_21648":128746,"_5":14899,"_28426":75573,"_3090":128747},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3640":75580,"_31229":75573,"_21648":128749,"_5":14899,"_28426":128732,"_3090":125830},[],{"_3640":75581,"_31229":75573,"_21648":128751,"_5":14899,"_28426":128732,"_3090":124496},[],{"_3640":75582,"_31229":75573,"_21648":128753,"_5":14899,"_28426":128732,"_3090":120715},[],{"_3640":75583,"_31229":75573,"_21648":128755,"_5":14899,"_28426":128732,"_3090":55604},[],{"_3640":75584,"_31229":75573,"_21648":128757,"_5":14899,"_28426":128732,"_3090":128758},[],"Existe, está activa y sus fechas son utilizables.",{"_3640":75585,"_31229":75573,"_21648":128760,"_5":14899,"_28426":128732,"_3090":128761},[],"Autoridades.",{"_3640":75586,"_31229":75573,"_21648":128763,"_5":14899,"_28426":128732,"_3090":128764},[],"Clave",{"_3640":75587,"_31229":75573,"_21648":128766,"_5":14899,"_28426":128732,"_3090":128767},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3640":75588,"_31229":75573,"_21648":128769,"_5":14899,"_28426":128732,"_3090":128770},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3640":75589,"_31229":75573,"_21648":128772,"_5":14899,"_28426":128732,"_3090":59369},[],{"_3640":75590,"_31229":75573,"_21648":128774,"_5":14899,"_28426":128732,"_3090":128775},[],"PEM correcto y firma verificable.",{"_3640":75591,"_31229":75573,"_21648":128777,"_5":14899,"_28426":128732,"_3090":59375},[],{"_3640":75592,"_31229":75573,"_21648":128779,"_5":14899,"_28426":128732,"_3090":128780},[],"Perfil",{"_3640":75593,"_31229":75573,"_21648":128782,"_5":14899,"_28426":128732,"_3090":128783},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3640":75594,"_31229":75573,"_21648":128785,"_5":14899,"_28426":128732,"_3090":128786},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3640":75595,"_31229":75573,"_21648":128788,"_5":14899,"_28426":128732,"_3090":125981},[],{"_3640":75596,"_31229":75573,"_21648":128790,"_5":14899,"_28426":128732,"_3090":128791},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3640":75597,"_31229":75573,"_21648":128793,"_5":14899,"_28426":128732,"_3090":128794},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3640":75598,"_31229":75573,"_21648":128796,"_5":14899,"_28426":128732,"_3090":128797},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3640":75599,"_31229":75573,"_21648":128799,"_5":14899,"_28426":128732,"_3090":128800},[],"Si la emisión falla con `400` y `CA Status inconsistent`, la CA emisora no está `ACTIVE` o está fuera del periodo de validez de su certificado. El estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración, así que comprueba también las fechas. Reemite la CA mientras siga vigente o emite desde otra CA.",{"_3640":75600,"_31229":75573,"_21648":128802,"_5":14899,"_28426":128732,"_3090":128803},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Si es subordinada, comprueba también el estado y las fechas de su CA padre. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3640":75601,"_31229":75573,"_21648":128805,"_5":14899,"_28426":128736,"_3090":128806},[],"Revisa cada frontera por separado:",{"_3640":75602,"_31229":75573,"_21648":128808,"_5":14899,"_28426":128736,"_3090":128809},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3640":75603,"_31229":75573,"_21648":128811,"_5":14899,"_28426":128736,"_3090":128812},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3640":75604,"_31229":75573,"_21648":128814,"_5":14899,"_28426":128736,"_3090":128815},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3640":75605,"_31229":75573,"_21648":128817,"_5":14899,"_28426":128736,"_3090":128818},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3640":75606,"_31229":75573,"_21648":128820,"_5":14899,"_28426":128736,"_3090":128821},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3640":75607,"_31229":75573,"_21648":128823,"_5":14899,"_28426":128736,"_3090":128824},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Una suspensión en cascada desde una CA se levanta reactivando esa CA; la cascada de una CA revocada definitivamente no. Revisa todos los estados y los errores individuales de la operación.",{"_3640":75608,"_31229":75573,"_21648":128826,"_5":14899,"_28426":128740,"_3090":128827},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3640":75609,"_31229":75573,"_21648":128829,"_5":14899,"_28426":128740,"_3090":128830},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3640":75610,"_31229":75610,"_5":15259,"_3090":128832,"_31567":128833,"_21648":128834,"_28426":75610},"Seguridad",[51054],[],{"_3640":75611,"_31229":75610,"_21648":128836,"_5":14899,"_28426":75610,"_3090":128837},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3640":75612,"_31229":75610,"_5":31564,"_21648":128839,"_28426":128840,"_3090":128841},[],"/docs/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3640":75613,"_31229":75610,"_5":31564,"_21648":128843,"_28426":128844,"_3090":128845},[],"/docs/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3640":75614,"_31229":75610,"_5":31564,"_21648":128847,"_28426":128848,"_3090":128849},[],"/docs/es/security#versiones-soportadas","Versiones soportadas",{"_3640":75615,"_31229":75610,"_5":31564,"_21648":128851,"_28426":128852,"_3090":128853},[],"/docs/es/security#divulgación-responsable","Divulgación responsable",{"_3640":75616,"_31229":75610,"_21648":128855,"_5":14899,"_28426":75610,"_3090":128856},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3640":75617,"_31229":75610,"_21648":128858,"_5":14899,"_28426":128840,"_3090":128859},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3640":75618,"_31229":75610,"_21648":128861,"_5":14899,"_28426":128840,"_3090":128862},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3640":75619,"_31229":75610,"_21648":128864,"_5":14899,"_28426":128840,"_3090":15538},[],{"_3640":75620,"_31229":75610,"_21648":128866,"_5":14899,"_28426":128840,"_3090":15467},[],{"_3640":75621,"_31229":75610,"_21648":128868,"_5":14899,"_28426":128840,"_3090":15525},[],{"_3640":75622,"_31229":75610,"_21648":128870,"_5":14899,"_28426":128840,"_3090":128871},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3640":75623,"_31229":75610,"_21648":128873,"_5":14899,"_28426":128840,"_3090":128874},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3640":75624,"_31229":75610,"_21648":128876,"_5":14899,"_28426":128844,"_3090":128877},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3640":75625,"_31229":75610,"_21648":128879,"_5":14899,"_28426":128844,"_3090":128880},[],"No incluyas en el reporte:",{"_3640":75626,"_31229":75610,"_21648":128882,"_5":14899,"_28426":128844,"_3090":128883},[],"Credenciales, tokens o claves privadas",{"_3640":75627,"_31229":75610,"_21648":128885,"_5":14899,"_28426":128844,"_3090":128886},[],"Datos de clientes o información identificable de clientes",{"_3640":75628,"_31229":75610,"_21648":128888,"_5":14899,"_28426":128844,"_3090":128889},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3640":75629,"_31229":75610,"_21648":128891,"_5":14899,"_28426":128848,"_3090":128892},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3640":75630,"_31229":75610,"_21648":128894,"_5":14899,"_28426":128848,"_3090":128895},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3640":75631,"_31229":75610,"_21648":128897,"_5":14899,"_28426":128852,"_3090":128898},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3640":75632,"_31229":75610,"_21648":128900,"_5":14899,"_28426":128852,"_3090":128901},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3640":75633,"_31229":75610,"_21648":128903,"_5":14899,"_28426":128852,"_3090":128904},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3640":75634,"_31229":75610,"_21648":128906,"_5":14899,"_28426":128852,"_3090":128907},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3640":75635,"_31229":75610,"_21648":128909,"_5":14899,"_28426":128852,"_3090":128910},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3640":75636,"_31229":75636,"_5":15259,"_3090":128912,"_31567":128913,"_21648":128915,"_28426":75636},"3.8.0 a 4.0.0",[51054,128914],"Actualizaciones",[],{"_3640":75637,"_31229":75636,"_21648":128917,"_5":14899,"_28426":75636,"_3090":128918},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3640":75638,"_31229":75636,"_5":31564,"_21648":128920,"_28426":128921,"_3090":128922},[],"/docs/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3640":75639,"_31229":75636,"_5":31564,"_21648":128924,"_28426":128925,"_3090":128926},[],"/docs/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3640":75640,"_31229":75636,"_5":31564,"_21648":128928,"_28426":128929,"_3090":128930},[],"/docs/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3640":75641,"_31229":75636,"_5":31564,"_21648":128932,"_28426":128933,"_3090":128934},[],"/docs/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3640":75642,"_31229":75636,"_5":31564,"_21648":128936,"_28426":128937,"_3090":128938},[],"/docs/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3640":75643,"_31229":75636,"_5":31564,"_21648":128940,"_28426":128941,"_3090":128942},[],"/docs/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3640":75644,"_31229":75636,"_5":31564,"_21648":128944,"_28426":128945,"_3090":59544},[],"/docs/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3640":75645,"_31229":75636,"_5":31564,"_21648":128947,"_28426":128948,"_3090":128949},[],"/docs/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3640":75646,"_31229":75636,"_5":31564,"_21648":128951,"_28426":128952,"_3090":128953},[],"/docs/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3640":75647,"_31229":75636,"_5":31564,"_21648":128955,"_28426":128956,"_3090":128957},[],"/docs/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3640":75648,"_31229":75636,"_5":31564,"_21648":128959,"_28426":128960,"_3090":121286},[],"/docs/es/upgrades/3-8-0-to-4-0-0#credenciales-en-secrets-de-kubernetes",{"_3640":75649,"_31229":75636,"_5":31564,"_21648":128962,"_28426":128963,"_3090":128964},[],"/docs/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3640":75650,"_31229":75636,"_5":31564,"_21648":128966,"_28426":128967,"_3090":128968},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3640":75651,"_31229":75636,"_5":31564,"_21648":128970,"_28426":128971,"_3090":128972},[],"/docs/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3640":75652,"_31229":75636,"_5":31564,"_21648":128974,"_28426":128975,"_3090":128976},[],"/docs/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3640":75653,"_31229":75636,"_5":31564,"_21648":128978,"_28426":128979,"_3090":128980},[],"/docs/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3640":75654,"_31229":75636,"_5":31564,"_21648":128982,"_28426":128983,"_3090":128984},[],"/docs/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3640":75655,"_31229":75636,"_5":31564,"_21648":128986,"_28426":128987,"_3090":128988},[],"/docs/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3640":75656,"_31229":75636,"_5":31564,"_21648":128990,"_28426":128991,"_3090":128992},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3640":75657,"_31229":75636,"_5":31564,"_21648":128994,"_28426":128995,"_3090":128996},[],"/docs/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3640":75658,"_31229":75636,"_5":31564,"_21648":128998,"_28426":128999,"_3090":129000},[],"/docs/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3640":75659,"_31229":75636,"_5":31564,"_21648":129002,"_28426":129003,"_3090":129004},[],"/docs/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3640":75660,"_31229":75636,"_5":31564,"_21648":129006,"_28426":129007,"_3090":129008},[],"/docs/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3640":75661,"_31229":75636,"_5":31564,"_21648":129010,"_28426":129011,"_3090":129012},[],"/docs/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3640":75662,"_31229":75636,"_5":31564,"_21648":129014,"_28426":129015,"_3090":129016},[],"/docs/es/upgrades/3-8-0-to-4-0-0#comprobaciones-de-revocación-que-fallan-cerradas","Comprobaciones de revocación que fallan cerradas",{"_3640":75663,"_31229":75636,"_5":31564,"_21648":129018,"_28426":129019,"_3090":129020},[],"/docs/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3640":75664,"_31229":75636,"_5":31564,"_21648":129022,"_28426":129023,"_3090":129024},[],"/docs/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3640":75665,"_31229":75636,"_5":31564,"_21648":129026,"_28426":129027,"_3090":129028},[],"/docs/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3640":75666,"_31229":75636,"_5":31564,"_21648":129030,"_28426":129031,"_3090":129032},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3640":75667,"_31229":75636,"_5":31564,"_21648":129034,"_28426":129035,"_3090":129036},[],"/docs/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3640":75668,"_31229":75636,"_5":31564,"_21648":129038,"_28426":129039,"_3090":129040},[],"/docs/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3640":75669,"_31229":75636,"_5":31564,"_21648":129042,"_28426":129043,"_3090":129044},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3640":75670,"_31229":75636,"_5":31564,"_21648":129046,"_28426":129047,"_3090":129048},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eliminación-de-los-endpoints-de-firma-arbitraria-de-la-ca","Eliminación de los endpoints de firma arbitraria de la CA",{"_3640":75671,"_31229":75636,"_5":31564,"_21648":129050,"_28426":129051,"_3090":129052},[],"/docs/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3640":75672,"_31229":75636,"_5":31564,"_21648":129054,"_28426":129055,"_3090":129056},[],"/docs/es/upgrades/3-8-0-to-4-0-0#endpoints-de-firma-de-ca-eliminados","Endpoints de firma de CA eliminados",{"_3640":75673,"_31229":75636,"_5":31564,"_21648":129058,"_28426":129059,"_3090":129060},[],"/docs/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3640":75674,"_31229":75636,"_5":31564,"_21648":129062,"_28426":129063,"_3090":129064},[],"/docs/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3640":75675,"_31229":75636,"_5":31564,"_21648":129066,"_28426":129067,"_3090":129068},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3640":75676,"_31229":75636,"_5":31564,"_21648":129070,"_28426":129071,"_3090":129072},[],"/docs/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3640":75677,"_31229":75636,"_5":31564,"_21648":129074,"_28426":129075,"_3090":129076},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3640":75678,"_31229":75636,"_5":31564,"_21648":129078,"_28426":129079,"_3090":129080},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3640":75679,"_31229":75636,"_5":31564,"_21648":129082,"_28426":129083,"_3090":129084},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3640":75680,"_31229":75636,"_5":31564,"_21648":129086,"_28426":129087,"_3090":129088},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3640":75681,"_31229":75636,"_5":31564,"_21648":129090,"_28426":129091,"_3090":129092},[],"/docs/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3640":75682,"_31229":75636,"_5":31564,"_21648":129094,"_28426":129095,"_3090":124844},[],"/docs/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3640":75683,"_31229":75636,"_5":31564,"_21648":129097,"_28426":129098,"_3090":129099},[],"/docs/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3640":75684,"_31229":75636,"_5":31564,"_21648":129101,"_28426":129102,"_3090":129103},[],"/docs/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3640":75685,"_31229":75636,"_21648":129105,"_5":14899,"_28426":75636,"_3090":129106},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3640":75686,"_31229":75636,"_21648":129108,"_5":14899,"_28426":75636,"_3090":129109},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3640":75687,"_31229":75636,"_21648":129111,"_5":14899,"_28426":75636,"_3090":129112},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3640":75688,"_31229":75636,"_21648":129114,"_5":14899,"_28426":75636,"_3090":129115},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3640":75689,"_31229":75636,"_21648":129117,"_5":14899,"_28426":75636,"_3090":129118},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3640":75690,"_31229":75636,"_21648":129120,"_5":14899,"_28426":75636,"_3090":129121},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3640":75691,"_31229":75636,"_21648":129123,"_5":14899,"_28426":75636,"_3090":129124},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3640":75692,"_31229":75636,"_21648":129126,"_5":14899,"_28426":128925,"_3090":129127},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3640":75693,"_31229":75636,"_21648":129129,"_5":14899,"_28426":128925,"_3090":129130},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3640":75694,"_31229":75636,"_21648":129132,"_5":14899,"_28426":128929,"_3090":129133},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3640":75695,"_31229":75636,"_21648":129135,"_5":14899,"_28426":128929,"_3090":129136},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3640":75696,"_31229":75636,"_21648":129138,"_5":14899,"_28426":128933,"_3090":129139},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3640":75697,"_31229":75636,"_21648":129141,"_5":14899,"_28426":128937,"_3090":129142},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3640":75698,"_31229":75636,"_21648":129144,"_5":14899,"_28426":128937,"_3090":129145},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3640":75699,"_31229":75636,"_21648":129147,"_5":14899,"_28426":128937,"_3090":129148},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3640":75700,"_31229":75636,"_21648":129150,"_5":14899,"_28426":128937,"_3090":129151},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3640":75701,"_31229":75636,"_21648":129153,"_5":14899,"_28426":128937,"_3090":129154},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3640":75702,"_31229":75636,"_21648":129156,"_5":14899,"_28426":128941,"_3090":129157},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3640":75703,"_31229":75636,"_21648":129159,"_5":14899,"_28426":128941,"_3090":129160},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3640":75704,"_31229":75636,"_21648":129162,"_5":14899,"_28426":128941,"_3090":129163},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3640":75705,"_31229":75636,"_21648":129165,"_5":14899,"_28426":128941,"_3090":129166},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3640":75706,"_31229":75636,"_21648":129168,"_5":14899,"_28426":128941,"_3090":129169},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3640":75707,"_31229":75636,"_21648":129171,"_5":14899,"_28426":128941,"_3090":129172},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3640":75708,"_31229":75636,"_21648":129174,"_5":14899,"_28426":128945,"_3090":129175},[],"Cambio",{"_3640":75709,"_31229":75636,"_21648":129177,"_5":14899,"_28426":128945,"_3090":129178},[],"A quién afecta",{"_3640":75710,"_31229":75636,"_21648":129180,"_5":14899,"_28426":128945,"_3090":129181},[],"Gravedad",{"_3640":75711,"_31229":75636,"_21648":129183,"_5":14899,"_28426":128945,"_3090":127654},[],{"_3640":75712,"_31229":75636,"_21648":129185,"_5":14899,"_28426":128945,"_3090":128953},[],{"_3640":75713,"_31229":75636,"_21648":129187,"_5":14899,"_28426":128945,"_3090":129188},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3640":75714,"_31229":75636,"_21648":129190,"_5":14899,"_28426":128945,"_3090":129191},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3640":75715,"_31229":75636,"_21648":129193,"_5":14899,"_28426":128945,"_3090":129194},[],"Copiar los datos a los volúmenes nuevos",{"_3640":75716,"_31229":75636,"_21648":129196,"_5":14899,"_28426":128945,"_3090":128957},[],{"_3640":75717,"_31229":75636,"_21648":129198,"_5":14899,"_28426":128945,"_3090":129199},[],"Todas las releases de Helm",{"_3640":75718,"_31229":75636,"_21648":129201,"_5":14899,"_28426":128945,"_3090":129202},[],"Alta: `helm upgrade` falla",{"_3640":75719,"_31229":75636,"_21648":129204,"_5":14899,"_28426":128945,"_3090":129205},[],"Eliminar o renombrar las claves heredadas",{"_3640":75720,"_31229":75636,"_21648":129207,"_5":14899,"_28426":128945,"_3090":121286},[],{"_3640":75721,"_31229":75636,"_21648":129209,"_5":14899,"_28426":128945,"_3090":129199},[],{"_3640":75722,"_31229":75636,"_21648":129211,"_5":14899,"_28426":128945,"_3090":129212},[],"Alta: `helm upgrade` falla con credenciales inline",{"_3640":75723,"_31229":75636,"_21648":129214,"_5":14899,"_28426":128945,"_3090":129215},[],"Crear primero los Secrets; consulta el paso 2",{"_3640":75724,"_31229":75636,"_21648":129217,"_5":14899,"_28426":128945,"_3090":128964},[],{"_3640":75725,"_31229":75636,"_21648":129219,"_5":14899,"_28426":128945,"_3090":129220},[],"Todos los despliegues",{"_3640":75726,"_31229":75636,"_21648":129222,"_5":14899,"_28426":128945,"_3090":129223},[],"Alta: sin principal de bootstrap no hay administrador",{"_3640":75727,"_31229":75636,"_21648":129225,"_5":14899,"_28426":128945,"_3090":129226},[],"Configurar `services.authz`",{"_3640":75728,"_31229":75636,"_21648":129228,"_5":14899,"_28426":128945,"_3090":128968},[],{"_3640":75729,"_31229":75636,"_21648":129230,"_5":14899,"_28426":128945,"_3090":129199},[],{"_3640":75730,"_31229":75636,"_21648":129232,"_5":14899,"_28426":128945,"_3090":129233},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3640":75731,"_31229":75636,"_21648":129235,"_5":14899,"_28426":128945,"_3090":129236},[],"Mover JWKS y roles a `services.authz`",{"_3640":75732,"_31229":75636,"_21648":129238,"_5":14899,"_28426":128945,"_3090":128988},[],{"_3640":75733,"_31229":75636,"_21648":129240,"_5":14899,"_28426":128945,"_3090":129241},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3640":75734,"_31229":75636,"_21648":129243,"_5":14899,"_28426":128945,"_3090":129244},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3640":75735,"_31229":75636,"_21648":129246,"_5":14899,"_28426":128945,"_3090":129247},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3640":75736,"_31229":75636,"_21648":129249,"_5":14899,"_28426":128945,"_3090":128992},[],{"_3640":75737,"_31229":75636,"_21648":129251,"_5":14899,"_28426":128945,"_3090":129252},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3640":75738,"_31229":75636,"_21648":129254,"_5":14899,"_28426":128945,"_3090":129255},[],"Alta: el backend ya no arranca con ellos",{"_3640":75739,"_31229":75636,"_21648":129257,"_5":14899,"_28426":128945,"_3090":129258},[],"Pasar a PostgreSQL antes de actualizar",{"_3640":75740,"_31229":75636,"_21648":129260,"_5":14899,"_28426":128945,"_3090":129040},[],{"_3640":75741,"_31229":75636,"_21648":129262,"_5":14899,"_28426":128945,"_3090":129263},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3640":75742,"_31229":75636,"_21648":129265,"_5":14899,"_28426":128945,"_3090":129266},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3640":75743,"_31229":75636,"_21648":129268,"_5":14899,"_28426":128945,"_3090":129269},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3640":75744,"_31229":75636,"_21648":129271,"_5":14899,"_28426":128945,"_3090":129272},[],"Webhooks con referencias a archivos",{"_3640":75745,"_31229":75636,"_21648":129274,"_5":14899,"_28426":128945,"_3090":129275},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3640":75746,"_31229":75636,"_21648":129277,"_5":14899,"_28426":128945,"_3090":129278},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3640":75747,"_31229":75636,"_21648":129280,"_5":14899,"_28426":128945,"_3090":129281},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3640":75748,"_31229":75636,"_21648":129283,"_5":14899,"_28426":128945,"_3090":128972},[],{"_3640":75749,"_31229":75636,"_21648":129285,"_5":14899,"_28426":128945,"_3090":129286},[],"Releases con identidades por servicio o material de claves montado",{"_3640":75750,"_31229":75636,"_21648":129288,"_5":14899,"_28426":128945,"_3090":129289},[],"Media: los servicios no pueden leer sus archivos",{"_3640":75751,"_31229":75636,"_21648":129291,"_5":14899,"_28426":128945,"_3090":129292},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3640":75752,"_31229":75636,"_21648":129294,"_5":14899,"_28426":128945,"_3090":128976},[],{"_3640":75753,"_31229":75636,"_21648":129296,"_5":14899,"_28426":128945,"_3090":129297},[],"Releases que definen `amqp.tls`",{"_3640":75754,"_31229":75636,"_21648":129299,"_5":14899,"_28426":128945,"_3090":129300},[],"Media: los clientes se conectan al puerto equivocado",{"_3640":75755,"_31229":75636,"_21648":129302,"_5":14899,"_28426":128945,"_3090":129303},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3640":75756,"_31229":75636,"_21648":129305,"_5":14899,"_28426":128945,"_3090":128996},[],{"_3640":75757,"_31229":75636,"_21648":129307,"_5":14899,"_28426":128945,"_3090":129308},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3640":75758,"_31229":75636,"_21648":129310,"_5":14899,"_28426":128945,"_3090":129311},[],"Media: las claves de CA quedan sin gestionar",{"_3640":75759,"_31229":75636,"_21648":129313,"_5":14899,"_28426":128945,"_3090":129314},[],"Ejecutar la migración de CA a KMS",{"_3640":75760,"_31229":75636,"_21648":129316,"_5":14899,"_28426":128945,"_3090":129317},[],"Verificación del certificado del receptor",{"_3640":75761,"_31229":75636,"_21648":129319,"_5":14899,"_28426":128945,"_3090":129320},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3640":75762,"_31229":75636,"_21648":129322,"_5":14899,"_28426":128945,"_3090":129323},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3640":75763,"_31229":75636,"_21648":129325,"_5":14899,"_28426":128945,"_3090":129326},[],"Poner `insecure_skip_verify` a `false`",{"_3640":75764,"_31229":75636,"_21648":129328,"_5":14899,"_28426":128945,"_3090":129012},[],{"_3640":75765,"_31229":75636,"_21648":129330,"_5":14899,"_28426":128945,"_3090":129331},[],"Scripts y consolas que editan DMS por API",{"_3640":75766,"_31229":75636,"_21648":129333,"_5":14899,"_28426":128945,"_3090":129334},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3640":75767,"_31229":75636,"_21648":129336,"_5":14899,"_28426":128945,"_3090":129337},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3640":75768,"_31229":75636,"_21648":129339,"_5":14899,"_28426":128945,"_3090":129016},[],{"_3640":75769,"_31229":75636,"_21648":129341,"_5":14899,"_28426":128945,"_3090":129342},[],"Todos los despliegues con dispositivos que presentan certificados no gestionados por Lamassu",{"_3640":75770,"_31229":75636,"_21648":129344,"_5":14899,"_28426":128945,"_3090":129345},[],"Media: el enrolamiento o el reenrolamiento de esos dispositivos falla",{"_3640":75771,"_31229":75636,"_21648":129347,"_5":14899,"_28426":128945,"_3090":129348},[],"Poner `allow_unverifiable_revocation` a `true` en los bloques DMS afectados, o asegurarse de que los certificados llevan puntos de distribución OCSP/CRL alcanzables",{"_3640":75772,"_31229":75636,"_21648":129350,"_5":14899,"_28426":128945,"_3090":129036},[],{"_3640":75773,"_31229":75636,"_21648":129352,"_5":14899,"_28426":128945,"_3090":129353},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3640":75774,"_31229":75636,"_21648":129355,"_5":14899,"_28426":128945,"_3090":129356},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3640":75775,"_31229":75636,"_21648":129358,"_5":14899,"_28426":128945,"_3090":129359},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3640":75776,"_31229":75636,"_21648":129361,"_5":14899,"_28426":128945,"_3090":129044},[],{"_3640":75777,"_31229":75636,"_21648":129363,"_5":14899,"_28426":128945,"_3090":129364},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3640":75778,"_31229":75636,"_21648":129366,"_5":14899,"_28426":128945,"_3090":129367},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3640":75779,"_31229":75636,"_21648":129369,"_5":14899,"_28426":128945,"_3090":129370},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3640":75780,"_31229":75636,"_21648":129372,"_5":14899,"_28426":128945,"_3090":129048},[],{"_3640":75781,"_31229":75636,"_21648":129374,"_5":14899,"_28426":128945,"_3090":129375},[],"Clientes que firman o verifican datos arbitrarios con la API o el SDK de Go de la CA, y suscripciones de alertas al evento `ca.sign.signature`",{"_3640":75782,"_31229":75636,"_21648":129377,"_5":14899,"_28426":128945,"_3090":129378},[],"Media: los endpoints, los métodos del SDK y el evento dejan de existir",{"_3640":75783,"_31229":75636,"_21648":129380,"_5":14899,"_28426":128945,"_3090":129381},[],"Firmar y verificar con claves del KMS; eliminar las suscripciones al evento",{"_3640":75784,"_31229":75636,"_21648":129383,"_5":14899,"_28426":128945,"_3090":129032},[],{"_3640":75785,"_31229":75636,"_21648":129385,"_5":14899,"_28426":128945,"_3090":129386},[],"Consumidores que leen el campo `events` del dispositivo",{"_3640":75786,"_31229":75636,"_21648":129388,"_5":14899,"_28426":128945,"_3090":129389},[],"Media: el campo desaparece",{"_3640":75787,"_31229":75636,"_21648":129391,"_5":14899,"_28426":128945,"_3090":129392},[],"Usar los nuevos endpoints de eventos",{"_3640":75788,"_31229":75636,"_21648":129394,"_5":14899,"_28426":128945,"_3090":129060},[],{"_3640":75789,"_31229":75636,"_21648":129396,"_5":14899,"_28426":128945,"_3090":129397},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3640":75790,"_31229":75636,"_21648":129399,"_5":14899,"_28426":128945,"_3090":129400},[],"Media: la migración de la VA aborta",{"_3640":75791,"_31229":75636,"_21648":129402,"_5":14899,"_28426":128945,"_3090":129403},[],"Corregir los roles afectados antes de actualizar",{"_3640":75792,"_31229":75636,"_21648":129405,"_5":14899,"_28426":128945,"_3090":128980},[],{"_3640":75793,"_31229":75636,"_21648":129407,"_5":14899,"_28426":128945,"_3090":129408},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3640":75794,"_31229":75636,"_21648":129410,"_5":14899,"_28426":128945,"_3090":129411},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3640":75795,"_31229":75636,"_21648":129413,"_5":14899,"_28426":128945,"_3090":129414},[],"Actualizar el archivo de values",{"_3640":75796,"_31229":75636,"_21648":129416,"_5":14899,"_28426":128945,"_3090":129024},[],{"_3640":75797,"_31229":75636,"_21648":129418,"_5":14899,"_28426":128945,"_3090":129419},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3640":75798,"_31229":75636,"_21648":129421,"_5":14899,"_28426":128945,"_3090":129422},[],"Baja: prevalece el ID de la URL",{"_3640":75799,"_31229":75636,"_21648":129424,"_5":14899,"_28426":128945,"_3090":129425},[],"Enviar el ID en la URL",{"_3640":75800,"_31229":75636,"_21648":129427,"_5":14899,"_28426":128945,"_3090":129052},[],{"_3640":75801,"_31229":75636,"_21648":129429,"_5":14899,"_28426":128945,"_3090":129430},[],"Clientes que envían un `id` al crear o importar CAs",{"_3640":75802,"_31229":75636,"_21648":129432,"_5":14899,"_28426":128945,"_3090":129433},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3640":75803,"_31229":75636,"_21648":129435,"_5":14899,"_28426":128945,"_3090":129436},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3640":75804,"_31229":75636,"_21648":129438,"_5":14899,"_28426":128945,"_3090":129056},[],{"_3640":75805,"_31229":75636,"_21648":129440,"_5":14899,"_28426":128945,"_3090":129441},[],"Clientes de API y SDK que llaman a `/v1/cas/{id}/signature/sign` o `/verify`, y suscripciones de alertas sobre `ca.sign.signature`",{"_3640":75806,"_31229":75636,"_21648":129443,"_5":14899,"_28426":128945,"_3090":129444},[],"Media: las llamadas devuelven `404` y las suscripciones no se disparan nunca",{"_3640":75807,"_31229":75636,"_21648":129446,"_5":14899,"_28426":128945,"_3090":129447},[],"Utilizar las operaciones `sign` y `verify` del KMS",{"_3640":75808,"_31229":75636,"_21648":129449,"_5":14899,"_28426":128945,"_3090":129028},[],{"_3640":75809,"_31229":75636,"_21648":129451,"_5":14899,"_28426":128945,"_3090":129452},[],"Consumidores que comparan el `type` del certificado",{"_3640":75810,"_31229":75636,"_21648":129454,"_5":14899,"_28426":128945,"_3090":129455},[],"Baja: dos valores cambian de nombre",{"_3640":75811,"_31229":75636,"_21648":129457,"_5":14899,"_28426":128945,"_3090":129458},[],"Adaptar los consumidores",{"_3640":75812,"_31229":75636,"_21648":129460,"_5":14899,"_28426":128945,"_3090":129020},[],{"_3640":75813,"_31229":75636,"_21648":129462,"_5":14899,"_28426":128945,"_3090":129463},[],"Cualquier DMS",{"_3640":75814,"_31229":75636,"_21648":129465,"_5":14899,"_28426":128945,"_3090":129466},[],"Baja: solo informativo",{"_3640":75815,"_31229":75636,"_21648":129468,"_5":14899,"_28426":128945,"_3090":129469},[],"Revisar ambos bloques antes de editar",{"_3640":75816,"_31229":75636,"_21648":129471,"_5":14899,"_28426":128952,"_3090":129472},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3640":75817,"_31229":75636,"_21648":129474,"_5":14899,"_28426":128952,"_3090":129475},[],"El paso 4 de la guía de migración copia los datos.",{"_3640":75818,"_31229":75636,"_21648":129477,"_5":14899,"_28426":128956,"_3090":129478},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3640":75819,"_31229":75636,"_21648":129480,"_5":14899,"_28426":128960,"_3090":129481},[],"En 4.0.0 el chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release en lugar de valores inline: `postgres.existingSecret`, `amqp.existingSecret` y — cuando hay autenticación SMTP configurada — `services.alerts.smtp_server.existingSecret`, cada uno con `usernameKey` y `passwordKey` nombrando las claves de datos del Secret. Los valores inline `postgres.username`/`postgres.password` y `amqp.username`/`amqp.password` se eliminan y `values.schema.json` los rechaza, así que un archivo de values de 3.8.0 hace fallar `helm lint` y `helm upgrade` hasta que las credenciales pasen a Secrets.",{"_3640":75820,"_31229":75636,"_21648":129483,"_5":14899,"_28426":128960,"_3090":129484},[],"Los Secrets deben existir antes de ejecutar `helm upgrade`: el job de base de datos de pre-upgrade se conecta a PostgreSQL con ellos. El paso 2 los crea mediante el External Secrets Operator.",{"_3640":75821,"_31229":75636,"_21648":129486,"_5":14899,"_28426":128963,"_3090":129487},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3640":75822,"_31229":75636,"_21648":129489,"_5":14899,"_28426":128967,"_3090":129490},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3640":75823,"_31229":75636,"_21648":129492,"_5":14899,"_28426":128971,"_3090":129493},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3640":75824,"_31229":75636,"_21648":129495,"_5":14899,"_28426":128971,"_3090":129496},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3640":75825,"_31229":75636,"_21648":129498,"_5":14899,"_28426":128971,"_3090":129499},[],"Los pods llevan ahora un `fsGroup: 65532` a nivel de pod con `fsGroupChangePolicy: OnRootMismatch`, que se salta los cambios recursivos de propiedad cuando la raíz del volumen ya tiene el grupo esperado. Si tus herramientas de backup o jobs usan otro GID, verifica que sigan pudiendo acceder a los volúmenes que necesitan.",{"_3640":75826,"_31229":75636,"_21648":129501,"_5":14899,"_28426":128975,"_3090":129502},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3640":75827,"_31229":75636,"_21648":129504,"_5":14899,"_28426":128979,"_3090":129505},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3640":75828,"_31229":75636,"_21648":129507,"_5":14899,"_28426":128979,"_3090":129508},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3640":75829,"_31229":75636,"_21648":129510,"_5":14899,"_28426":128979,"_3090":129511},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3640":75830,"_31229":75636,"_21648":129513,"_5":14899,"_28426":128979,"_3090":129514},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3640":75831,"_31229":75636,"_21648":129516,"_5":14899,"_28426":128979,"_3090":129517},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3640":75832,"_31229":75636,"_21648":129519,"_5":14899,"_28426":128979,"_3090":129520},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3640":75833,"_31229":75636,"_21648":129522,"_5":14899,"_28426":128987,"_3090":129523},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3640":75834,"_31229":75636,"_21648":129525,"_5":14899,"_28426":128987,"_3090":129526},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3640":75835,"_31229":75636,"_21648":129528,"_5":14899,"_28426":128987,"_3090":129529},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3640":75836,"_31229":75636,"_21648":129531,"_5":14899,"_28426":128987,"_3090":129532},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3640":75837,"_31229":75636,"_21648":129534,"_5":14899,"_28426":128987,"_3090":129535},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3640":75838,"_31229":75636,"_21648":129537,"_5":14899,"_28426":128991,"_3090":129538},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3640":75839,"_31229":75636,"_21648":129540,"_5":14899,"_28426":128995,"_3090":129541},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3640":75840,"_31229":75636,"_21648":129543,"_5":14899,"_28426":128995,"_3090":129544},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3640":75841,"_31229":75636,"_21648":129546,"_5":14899,"_28426":128995,"_3090":129547},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3640":75842,"_31229":75636,"_21648":129549,"_5":14899,"_28426":128995,"_3090":129550},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3640":75843,"_31229":75636,"_21648":129552,"_5":14899,"_28426":128995,"_3090":129553},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3640":75844,"_31229":75636,"_21648":129555,"_5":14899,"_28426":128995,"_3090":129556},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3640":75845,"_31229":75636,"_21648":129558,"_5":14899,"_28426":128995,"_3090":129559},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3640":75846,"_31229":75636,"_21648":129561,"_5":14899,"_28426":128995,"_3090":129562},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3640":75847,"_31229":75636,"_21648":129564,"_5":14899,"_28426":128999,"_3090":129565},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3640":75848,"_31229":75636,"_21648":129567,"_5":14899,"_28426":129007,"_3090":129568},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3640":75849,"_31229":75636,"_21648":129570,"_5":14899,"_28426":129007,"_3090":129571},[],"Campo en 3.8.0",{"_3640":75850,"_31229":75636,"_21648":129573,"_5":14899,"_28426":129007,"_3090":129574},[],"Campo en 4.0.0",{"_3640":75851,"_31229":75636,"_21648":129576,"_5":14899,"_28426":129007,"_3090":60175},[],{"_3640":75852,"_31229":75636,"_21648":129578,"_5":14899,"_28426":129007,"_3090":129579},[],"`insecure_skip_verify` (con el valor negado)",{"_3640":75853,"_31229":75636,"_21648":129581,"_5":14899,"_28426":129007,"_3090":60181},[],{"_3640":75854,"_31229":75636,"_21648":129583,"_5":14899,"_28426":129007,"_3090":60184},[],{"_3640":75855,"_31229":75636,"_21648":129585,"_5":14899,"_28426":129007,"_3090":60187},[],{"_3640":75856,"_31229":75636,"_21648":129587,"_5":14899,"_28426":129007,"_3090":60190},[],{"_3640":75857,"_31229":75636,"_21648":129589,"_5":14899,"_28426":129007,"_3090":60193},[],{"_3640":75858,"_31229":75636,"_21648":129591,"_5":14899,"_28426":129007,"_3090":60196},[],{"_3640":75859,"_31229":75636,"_21648":129593,"_5":14899,"_28426":129007,"_3090":129594},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3640":75860,"_31229":75636,"_21648":129596,"_5":14899,"_28426":129007,"_3090":129597},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3640":75861,"_31229":75636,"_21648":129599,"_5":14899,"_28426":129007,"_3090":129600},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3640":75862,"_31229":75636,"_21648":129602,"_5":14899,"_28426":129011,"_3090":129603},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3640":75863,"_31229":75636,"_21648":129605,"_5":14899,"_28426":129011,"_3090":129606},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3640":75864,"_31229":75636,"_21648":129608,"_5":14899,"_28426":129011,"_3090":129609},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3640":75865,"_31229":75636,"_21648":129611,"_5":14899,"_28426":129015,"_3090":129612},[],"El enrolamiento y el reenrolamiento comprueban ahora la revocación de los certificados presentados y fallan cerrados cuando no puede verificarse. No hay migración: todo DMS preexistente tiene la nueva opción `allow_unverifiable_revocation` con su valor por defecto `false`, así que un certificado que no gestiona Lamassu y no lleva puntos de distribución OCSP o CRL se rechaza hasta que la opción se ponga a `true` en el bloque afectado, de forma independiente en el bloque de enrolamiento y en el de reenrolamiento.",{"_3640":75866,"_31229":75636,"_21648":129614,"_5":14899,"_28426":129015,"_3090":129615},[],"Los certificados que sí llevan endpoints siguen comprobándose con rigor: los endpoints que no responden o devuelven respuestas caducadas o no concluyentes rechazan el certificado aunque `allow_unverifiable_revocation` esté activo, y los certificados gestionados por Lamassu no se ven afectados porque se usa su estado almacenado. Una CA de validación revocada en Lamassu también rechaza la operación, sin recurrir a las demás CAs de validación. Consulta la guía de DMS y Revocación y comprobaciones.",{"_3640":75867,"_31229":75636,"_21648":129617,"_5":14899,"_28426":129019,"_3090":129618},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3640":75868,"_31229":75636,"_21648":129620,"_5":14899,"_28426":129023,"_3090":129621},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3640":75869,"_31229":75636,"_21648":129623,"_5":14899,"_28426":129027,"_3090":129624},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3640":75870,"_31229":75636,"_21648":129626,"_5":14899,"_28426":129031,"_3090":129627},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3640":75871,"_31229":75636,"_21648":129629,"_5":14899,"_28426":129031,"_3090":129630},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3640":75872,"_31229":75636,"_21648":129632,"_5":14899,"_28426":129031,"_3090":129633},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3640":75873,"_31229":75636,"_21648":129635,"_5":14899,"_28426":129031,"_3090":129636},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3640":75874,"_31229":75636,"_21648":129638,"_5":14899,"_28426":129035,"_3090":129639},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3640":75875,"_31229":75636,"_21648":129641,"_5":14899,"_28426":129039,"_3090":129642},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3640":75876,"_31229":75636,"_21648":129644,"_5":14899,"_28426":129039,"_3090":129645},[],"Ruta",{"_3640":75877,"_31229":75636,"_21648":129647,"_5":14899,"_28426":129039,"_3090":121933},[],{"_3640":75878,"_31229":75636,"_21648":129649,"_5":14899,"_28426":129039,"_3090":60255},[],{"_3640":75879,"_31229":75636,"_21648":129651,"_5":14899,"_28426":129039,"_3090":129652},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3640":75880,"_31229":75636,"_21648":129654,"_5":14899,"_28426":129039,"_3090":60261},[],{"_3640":75881,"_31229":75636,"_21648":129656,"_5":14899,"_28426":129039,"_3090":129657},[],"Lee los ajustes de una CA.",{"_3640":75882,"_31229":75636,"_21648":129659,"_5":14899,"_28426":129039,"_3090":60267},[],{"_3640":75883,"_31229":75636,"_21648":129661,"_5":14899,"_28426":129039,"_3090":129662},[],"Sustituye los `crl_options`.",{"_3640":75884,"_31229":75636,"_21648":129664,"_5":14899,"_28426":129039,"_3090":60273},[],{"_3640":75885,"_31229":75636,"_21648":129666,"_5":14899,"_28426":129039,"_3090":129667},[],"Elimina los ajustes archivados de una CA.",{"_3640":75886,"_31229":75636,"_21648":129669,"_5":14899,"_28426":129039,"_3090":129670},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE`, `FINAL` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3640":75887,"_31229":75636,"_21648":129672,"_5":14899,"_28426":129039,"_3090":129673},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3640":75888,"_31229":75636,"_21648":129675,"_5":14899,"_28426":129039,"_3090":129676},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3640":75889,"_31229":75636,"_21648":129678,"_5":14899,"_28426":129039,"_3090":129679},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3640":75890,"_31229":75636,"_21648":129681,"_5":14899,"_28426":129039,"_3090":129682},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3640":75891,"_31229":75636,"_21648":129684,"_5":14899,"_28426":129039,"_3090":129685},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3640":75892,"_31229":75636,"_21648":129687,"_5":14899,"_28426":129039,"_3090":129688},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3640":75893,"_31229":75636,"_21648":129690,"_5":14899,"_28426":129039,"_3090":129691},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3640":75894,"_31229":75636,"_21648":129693,"_5":14899,"_28426":129039,"_3090":129694},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3640":75895,"_31229":75636,"_21648":129696,"_5":14899,"_28426":129039,"_3090":129697},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3640":75896,"_31229":75636,"_21648":129699,"_5":14899,"_28426":129039,"_3090":129700},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. La entidad incorpora la acción atómica `delete`, una relación `signer_key_id` con las claves del KMS y las columnas filtrables `signer_engine_id` y `signer_key_id`; concede la acción nueva a quien pueda borrar ajustes de CRL archivados. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3640":75897,"_31229":75636,"_21648":129702,"_5":14899,"_28426":129043,"_3090":129703},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3640":75898,"_31229":75636,"_21648":129705,"_5":14899,"_28426":129047,"_3090":129706},[],"`POST /v1/cas/{id}/signature/sign` y `POST /v1/cas/{id}/signature/verify` ya no existen: el servicio de CA ya no firma ni verifica datos arbitrarios, de modo que la clave privada de una CA solo firma certificados. Los métodos `CAService.SignatureSign` y `CAService.SignatureVerify` del SDK de Go también se eliminan, y el evento `ca.sign.signature` deja de publicarse, así que las suscripciones de alertas y los consumidores del bus de eventos que se basen en él nunca vuelven a dispararse — elimina esas suscripciones y redirige a los consumidores. Firma y verifica datos arbitrarios con una clave del KMS, mediante `POST /api/kms/v1/keys/{id}/sign` y `POST /api/kms/v1/keys/{id}/verify` (en el SDK de Go, `KMSService.SignMessage` y `KMSService.VerifySignature`); el equivalente en la consola se describe en Firmar y verificar. Una CA además solo se acepta para firmar cuando su ventana de validez incluye el momento actual, aunque su estado almacenado siga mostrando `ACTIVE`.",{"_3640":75899,"_31229":75636,"_21648":129708,"_5":14899,"_28426":129051,"_3090":129709},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3640":75900,"_31229":75636,"_21648":129711,"_5":14899,"_28426":129055,"_3090":129712},[],"La clave de una CA ahora solo firma certificados. 3.8.0 permitía firmar datos arbitrarios con la clave de una CA mediante `POST /v1/cas/{id}/signature/sign` y comprobar el resultado con `POST /v1/cas/{id}/signature/verify`. 4.0.0 elimina ambos endpoints, los métodos `SignatureSign` y `SignatureVerify` de `CAService` en el SDK de Go y el evento `ca.sign.signature`. Una suscripción de alertas a ese evento deja de dispararse: elimínala o muévela a otro evento.",{"_3640":75901,"_31229":75636,"_21648":129714,"_5":14899,"_28426":129055,"_3090":129715},[],"Para firmar y verificar datos, utiliza las operaciones del KMS `POST /v1/keys/{id}/sign` y `POST /v1/keys/{id}/verify`, que tienen su propia autorización. Firmar un certificado con una CA que no está `ACTIVE`, o cuyo periodo de validez no incluye la hora actual, falla ahora con `400`, aunque el estado almacenado aún no haya pasado a `EXPIRED`: consulta Autoridades de certificación.",{"_3640":75902,"_31229":75636,"_21648":129717,"_5":14899,"_28426":129059,"_3090":129718},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3640":75903,"_31229":75636,"_21648":129720,"_5":14899,"_28426":129063,"_3090":129721},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3640":75904,"_31229":75636,"_21648":129723,"_5":14899,"_28426":129067,"_3090":129724},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3640":75905,"_31229":75636,"_21648":129726,"_5":14899,"_28426":129067,"_3090":129727},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3640":75906,"_31229":75636,"_21648":129729,"_5":14899,"_28426":129067,"_3090":129730},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3640":75907,"_31229":75636,"_21648":129732,"_5":14899,"_28426":129067,"_3090":129733},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3640":75908,"_31229":75636,"_21648":129735,"_5":14899,"_28426":129067,"_3090":129736},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3640":75909,"_31229":75636,"_21648":129738,"_5":14899,"_28426":129067,"_3090":129739},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3640":75910,"_31229":75636,"_21648":129741,"_5":14899,"_28426":129071,"_3090":129742},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3640":75911,"_31229":75636,"_21648":129744,"_5":14899,"_28426":129071,"_3090":129745},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3640":75912,"_31229":75636,"_21648":129747,"_5":14899,"_28426":129071,"_3090":129748},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3640":75913,"_31229":75636,"_21648":129750,"_5":14899,"_28426":129071,"_3090":129751},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3640":75914,"_31229":75636,"_21648":129753,"_5":14899,"_28426":129071,"_3090":129754},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3640":75915,"_31229":75636,"_21648":129756,"_5":14899,"_28426":129075,"_3090":129757},[],"**Crea los Secrets de credenciales.** El chart de 4.0.0 lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes, y el job de base de datos de pre-upgrade las necesita antes de que se ejecute la actualización. Copia las credenciales de 3.8.0 a tu proveedor de gestión de secretos y crea los Secrets con el External Secrets Operator (ESO), que el chart no instala:",{"_3640":75916,"_31229":75636,"_21648":129759,"_5":14899,"_28426":129075,"_3090":129760},[],"Configura ESO y su proveedor (`SecretStore` o `ClusterSecretStore`).",{"_3640":75917,"_31229":75636,"_21648":129762,"_5":14899,"_28426":129075,"_3090":129763},[],"Crea un `ExternalSecret` por cada conjunto de credenciales que uses. Su Secret de destino debe vivir en el namespace de la release, llamarse como el valor `existingSecret` correspondiente y contener estas claves:",{"_3640":75918,"_31229":75636,"_21648":129765,"_5":14899,"_28426":129075,"_3090":60375},[],{"_3640":75919,"_31229":75636,"_21648":129767,"_5":14899,"_28426":129075,"_3090":129768},[],"Claves de datos obligatorias",{"_3640":75920,"_31229":75636,"_21648":129770,"_5":14899,"_28426":129075,"_3090":129771},[],"Cuándo",{"_3640":75921,"_31229":75636,"_21648":129773,"_5":14899,"_28426":129075,"_3090":129774},[],"`lamassu-postgres` (por defecto de `postgres.existingSecret`)",{"_3640":75922,"_31229":75636,"_21648":129776,"_5":14899,"_28426":129075,"_3090":60387},[],{"_3640":75923,"_31229":75636,"_21648":129778,"_5":14899,"_28426":129075,"_3090":129779},[],"Siempre",{"_3640":75924,"_31229":75636,"_21648":129781,"_5":14899,"_28426":129075,"_3090":129782},[],"`lamassu-amqp` (por defecto de `amqp.existingSecret`)",{"_3640":75925,"_31229":75636,"_21648":129784,"_5":14899,"_28426":129075,"_3090":60387},[],{"_3640":75926,"_31229":75636,"_21648":129786,"_5":14899,"_28426":129075,"_3090":129779},[],{"_3640":75927,"_31229":75636,"_21648":129788,"_5":14899,"_28426":129075,"_3090":60400},[],{"_3640":75928,"_31229":75636,"_21648":129790,"_5":14899,"_28426":129075,"_3090":60387},[],{"_3640":75929,"_31229":75636,"_21648":129792,"_5":14899,"_28426":129075,"_3090":129793},[],"Solo cuando hay autenticación SMTP",{"_3640":75930,"_31229":75636,"_21648":129795,"_5":14899,"_28426":129075,"_3090":129796},[],"Espera a que cada `ExternalSecret` esté Ready y verifica los Secrets generados antes de ejecutar la actualización.",{"_3640":75931,"_31229":75636,"_21648":129798,"_5":14899,"_28426":129075,"_3090":129799},[],"No cambies las contraseñas de la base de datos ni del broker como parte de esta migración: ESO sincroniza credenciales en Secrets, pero no actualiza los usuarios configurados en el servidor PostgreSQL ni en el broker. Quitar credenciales del archivo de values no deshace la exposición previa — si se llegaron a subir a Git, rotarlas cuando la migración se haya completado.",{"_3640":75932,"_31229":75636,"_21648":129801,"_5":14899,"_28426":129075,"_3090":129802},[],"El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` Fake de prueba, los recursos `ExternalSecret` y la espera de la sincronización. Su proveedor Fake es solo para pruebas; para producción, sustitúyelo por la configuración de tu proveedor.",{"_3640":75933,"_31229":75636,"_21648":129804,"_5":14899,"_28426":129075,"_3090":129805},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3640":75934,"_31229":75636,"_21648":129807,"_5":14899,"_28426":129075,"_3090":129808},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3640":75935,"_31229":75636,"_21648":129810,"_5":14899,"_28426":129075,"_3090":129811},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se exige el campo `database` de cada entrada; los `hostname` y `port` por esquema se siguen aceptando pero se ignoran — la conexión usa siempre los `postgres.hostname` y `postgres.port` globales con el Secret de credenciales de PostgreSQL global, `postgres.existingSecret` con sus nombres de clave configurados, salvo que la entrada defina su propio `existingSecret` (con `usernameKey` y `passwordKey` opcionales).",{"_3640":75936,"_31229":75636,"_21648":129813,"_5":14899,"_28426":129075,"_3090":129814},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3640":75937,"_31229":75636,"_21648":129816,"_5":14899,"_28426":129075,"_3090":129817},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3640":75938,"_31229":75636,"_21648":129819,"_5":14899,"_28426":129075,"_3090":129820},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3640":75939,"_31229":75636,"_21648":129822,"_5":14899,"_28426":129075,"_3090":129823},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3640":75940,"_31229":75636,"_21648":129825,"_5":14899,"_28426":129075,"_3090":129826},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3640":75941,"_31229":75636,"_21648":129828,"_5":14899,"_28426":129075,"_3090":129829},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3640":75942,"_31229":75636,"_21648":129831,"_5":14899,"_28426":129075,"_3090":129832},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3640":75943,"_31229":75636,"_21648":129834,"_5":14899,"_28426":129075,"_3090":129835},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3640":75944,"_31229":75636,"_21648":129837,"_5":14899,"_28426":129075,"_3090":129838},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida. Antes de ejecutar el paso 3, confirma que cada `ExternalSecret` de credenciales esté Ready y que los Secrets generados contengan las claves esperadas.",{"_3640":75945,"_31229":75636,"_21648":129840,"_5":14899,"_28426":129079,"_3090":129841},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3640":75946,"_31229":75636,"_21648":129843,"_5":14899,"_28426":129079,"_3090":129844},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3640":75947,"_31229":75636,"_21648":129846,"_5":14899,"_28426":129083,"_3090":129847},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3640":75948,"_31229":75636,"_21648":129849,"_5":14899,"_28426":129083,"_3090":129850},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3640":75949,"_31229":75636,"_21648":129852,"_5":14899,"_28426":129083,"_3090":129853},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3640":75950,"_31229":75636,"_21648":129855,"_5":14899,"_28426":129083,"_3090":129856},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3640":75951,"_31229":75636,"_21648":129858,"_5":14899,"_28426":129083,"_3090":129859},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3640":75952,"_31229":75636,"_21648":129861,"_5":14899,"_28426":129083,"_3090":129862},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3640":75953,"_31229":75636,"_21648":129864,"_5":14899,"_28426":129083,"_3090":129865},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3640":75954,"_31229":75636,"_21648":129867,"_5":14899,"_28426":129083,"_3090":129868},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3640":75955,"_31229":75636,"_21648":129870,"_5":14899,"_28426":129083,"_3090":129871},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3640":75956,"_31229":75636,"_21648":129873,"_5":14899,"_28426":129083,"_3090":129874},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3640":75957,"_31229":75636,"_21648":129876,"_5":14899,"_28426":129083,"_3090":129877},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3640":75958,"_31229":75636,"_21648":129879,"_5":14899,"_28426":129087,"_3090":129880},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3640":75959,"_31229":75636,"_21648":129882,"_5":14899,"_28426":129087,"_3090":129883},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3640":75960,"_31229":75636,"_21648":129885,"_5":14899,"_28426":129091,"_3090":129886},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3640":75961,"_31229":75636,"_21648":129888,"_5":14899,"_28426":129091,"_3090":129889},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3640":75962,"_31229":75636,"_21648":129891,"_5":14899,"_28426":129091,"_3090":129892},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` requiere que `ca` y `kms` se hayan migrado primero: falla con `ca schema not found: migrate the ca schema before the va schema` o `kms schema not found: migrate the kms schema before the va schema` si falta alguno de los dos.",{"_3640":75963,"_31229":75636,"_21648":129894,"_5":14899,"_28426":129091,"_3090":129895},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates`, `SELECT` sobre `ca.ca_certificates`, y `USAGE` sobre `kms` más `SELECT` y `REFERENCES` sobre `kms.kms_keys`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`. Tras migrar `va`, si el servicio de CA corre con un usuario distinto, concédele `USAGE` sobre el esquema `va` y `SELECT` sobre `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): el servicio de CA lee `va.crl_settings` cuando elimina una CA, y sin estos permisos toda eliminación de una CA que tenga motor criptográfico falla con `permission denied for schema va` (o `for table crl_settings`).",{"_3640":75964,"_31229":75636,"_21648":129897,"_5":14899,"_28426":129091,"_3090":129898},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3640":75965,"_31229":75636,"_21648":129900,"_5":14899,"_28426":129091,"_3090":129901},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3640":75966,"_31229":75636,"_21648":129903,"_5":14899,"_28426":129091,"_3090":129904},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3640":75967,"_31229":75636,"_21648":129906,"_5":14899,"_28426":129091,"_3090":129907},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3640":75968,"_31229":75636,"_21648":129909,"_5":14899,"_28426":129095,"_3090":129910},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3640":75969,"_31229":75636,"_21648":129912,"_5":14899,"_28426":129095,"_3090":129913},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3640":75970,"_31229":75636,"_21648":129915,"_5":14899,"_28426":129095,"_3090":129916},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3640":75971,"_31229":75636,"_21648":129918,"_5":14899,"_28426":129095,"_3090":129919},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3640":75972,"_31229":75636,"_21648":129921,"_5":14899,"_28426":129095,"_3090":129922},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3640":75973,"_31229":75636,"_21648":129924,"_5":14899,"_28426":129095,"_3090":129925},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3640":75974,"_31229":75636,"_21648":129927,"_5":14899,"_28426":129095,"_3090":129928},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3640":75975,"_31229":75636,"_21648":129930,"_5":14899,"_28426":129095,"_3090":129931},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que las migraciones de los esquemas `ca` y `va`.",{"_3640":75976,"_31229":75636,"_21648":129933,"_5":14899,"_28426":129095,"_3090":129934},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3640":75977,"_31229":75636,"_21648":129936,"_5":14899,"_28426":129095,"_3090":129937},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3640":75978,"_31229":75636,"_21648":129939,"_5":14899,"_28426":129095,"_3090":129940},[],"**Una migración o un servicio falla con `permission denied for table ...` o `permission denied for schema ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración, y `permission denied for schema va` (o `for table crl_settings`) al eliminar una CA sin los permisos de `va`. Concede los privilegios que falten y vuelve a ejecutar.",{"_3640":75979,"_31229":75636,"_21648":129942,"_5":14899,"_28426":129098,"_3090":129943},[],"Tras la actualización, comprueba en este orden:",{"_3640":75980,"_31229":75636,"_21648":129945,"_5":14899,"_28426":129098,"_3090":129946},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3640":75981,"_31229":75636,"_21648":129948,"_5":14899,"_28426":129098,"_3090":129949},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3640":75982,"_31229":75636,"_21648":129951,"_5":14899,"_28426":129098,"_3090":129952},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3640":75983,"_31229":75636,"_21648":129954,"_5":14899,"_28426":129098,"_3090":129955},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3640":75984,"_31229":75636,"_21648":129957,"_5":14899,"_28426":129098,"_3090":129958},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3640":75985,"_31229":75636,"_21648":129960,"_5":14899,"_28426":129098,"_3090":129961},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3640":75986,"_31229":75636,"_21648":129963,"_5":14899,"_28426":129098,"_3090":129964},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3640":75987,"_31229":75636,"_21648":129966,"_5":14899,"_28426":129098,"_3090":129967},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3640":75988,"_31229":75636,"_21648":129969,"_5":14899,"_28426":129098,"_3090":129970},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3640":75989,"_31229":75636,"_21648":129972,"_5":14899,"_28426":129098,"_3090":129973},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3640":75990,"_31229":75636,"_21648":129975,"_5":14899,"_28426":129098,"_3090":129976},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3640":75991,"_31229":75636,"_21648":129978,"_5":14899,"_28426":129098,"_3090":129979},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3640":75992,"_31229":75636,"_21648":129981,"_5":14899,"_28426":129098,"_3090":129982},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3640":75993,"_31229":75636,"_21648":129984,"_5":14899,"_28426":129098,"_3090":129985},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3640":75994,"_31229":75636,"_21648":129987,"_5":14899,"_28426":129098,"_3090":129988},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3640":75995,"_31229":75636,"_21648":129990,"_5":14899,"_28426":129102,"_3090":129991},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3640":75996,"_31229":75636,"_21648":129993,"_5":14899,"_28426":129102,"_3090":129994},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3640":75997,"_31229":75636,"_21648":129996,"_5":14899,"_28426":129102,"_3090":129997},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3640":75998,"_31229":75636,"_21648":129999,"_5":14899,"_28426":129102,"_3090":130000},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3640":75999,"_31229":75636,"_21648":130002,"_5":14899,"_28426":129102,"_3090":130003},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_60618":130005,"_60620":130006,"_60622":130007,"_60624":130008,"_18780":3125,"_72923":3125},"spanish",[3090,31229,5,28426],{"_3090":25835,"_31229":25835,"_5":25835,"_28426":25835},{"_3090":130009,"_31229":133082,"_5":136155,"_28426":139228},{"_4845":130010,"_60628":130011,"_5":25835},{"_14980":7263,"_15359":6917,"_15378":6066,"_30229":8004,"_15365":4228,"_20555":3383,"_15001":17323,"_15008":22335,"_30171":21792,"_30579":7962,"_30606":9617,"_30205":4588,"_35622":5174,"_30308":19731,"_30650":10251,"_35629":5608,"_35632":4370,"_35635":7329,"_35638":3381,"_31052":3499,"_35643":23949,"_35645":26241,"_31087":13865,"_15374":31245,"_35649":7849,"_35652":10859,"_35654":11396,"_30634":3594,"_31072":13309,"_31100":18411,"_35659":3319,"_35661":6245,"_35663":3263,"_30319":5172,"_35666":3702,"_35668":6774,"_35670":7940,"_35672":8024,"_35674":15029,"_30242":11401,"_35677":3829,"_35679":5050,"_30236":3203,"_30671":7521,"_35683":27973,"_35685":10792,"_35688":4590,"_30282":9273,"_35692":8532,"_30162":5346,"_35695":6094,"_30210":4564,"_35698":4586,"_35700":13777,"_35703":11743,"_15368":16876,"_35706":6204,"_35708":11433,"_35711":14977,"_35713":6910,"_35715":7746,"_35717":3200,"_35719":6581,"_20558":3585,"_35722":7822,"_35724":3756,"_30183":4103,"_30628":3487,"_35728":6925,"_35730":3850,"_35732":7380,"_31116":3607,"_35735":3807,"_35737":4333,"_35739":4500,"_31209":6571,"_30687":12322,"_35743":4337,"_35745":3402,"_30220":15417,"_35748":7888,"_35750":3500,"_35752":7707,"_31132":26901,"_30302":12803,"_29682":4086,"_35757":7638,"_35759":23454,"_35761":5202,"_30345":8909,"_35765":7303,"_30622":8908,"_35769":12938,"_35771":3545,"_35773":7952,"_35775":8137,"_35777":3453,"_35779":7249,"_30334":5173,"_30584":5670,"_35783":3367,"_35785":7325,"_35787":4649,"_35790":4276,"_35792":6507,"_35794":9383,"_35796":17417,"_35798":6611,"_35800":7876,"_35802":4274,"_