space`",{"_7914":76,"_22115":34,"_18751":31978,"_5":22248,"_15096":31841,"_1571":31979},[],"`lamassu-dev`",{"_7914":77,"_22115":34,"_18751":31981,"_5":22248,"_15096":31841,"_1571":31982},[],"Namespace Kubernetes donde se despliegan los recursos",{"_7914":78,"_22115":34,"_18751":31984,"_5":22248,"_15096":31841,"_1571":31985},[],"`-d`, `--domain`",{"_7914":79,"_22115":34,"_18751":31987,"_5":22248,"_15096":31841,"_1571":31988},[],"`dev.lamassu.io`",{"_7914":80,"_22115":34,"_18751":31990,"_5":22248,"_15096":31841,"_1571":31991},[],"Dominio usado para endpoint y certificados TLS",{"_7914":81,"_22115":34,"_18751":31993,"_5":22248,"_15096":31841,"_1571":31994},[],"`-v`, `--version`",{"_7914":82,"_22115":34,"_18751":31996,"_5":22248,"_15096":31841,"_1571":31997},[],"`latest`",{"_7914":83,"_22115":34,"_18751":31999,"_5":22248,"_15096":31841,"_1571":32000},[],"Versión del chart Helm de Lamassu",{"_7914":84,"_22115":34,"_18751":32002,"_5":22248,"_15096":31841,"_1571":32003},[],"`--https-port`",{"_7914":85,"_22115":34,"_18751":32005,"_5":22248,"_15096":31841,"_1571":32006},[],"`443`",{"_7914":86,"_22115":34,"_18751":32008,"_5":22248,"_15096":31841,"_1571":32009},[],"Puerto HTTPS del gateway",{"_7914":87,"_22115":34,"_18751":32011,"_5":22248,"_15096":31841,"_1571":32012},[],"`--http-port`",{"_7914":88,"_22115":34,"_18751":32014,"_5":22248,"_15096":31841,"_1571":32015},[],"`80`",{"_7914":89,"_22115":34,"_18751":32017,"_5":22248,"_15096":31841,"_1571":32018},[],"Puerto HTTP del gateway",{"_7914":90,"_22115":34,"_18751":32020,"_5":22248,"_15096":31841,"_1571":32021},[],"`--offline`",{"_7914":91,"_22115":34,"_18751":32023,"_5":22248,"_15096":31841,"_1571":31970},[],{"_7914":92,"_22115":34,"_18751":32025,"_5":22248,"_15096":31841,"_1571":32026},[],"Activa modo offline",{"_7914":93,"_22115":34,"_18751":32028,"_5":22248,"_15096":31841,"_1571":32029},[],"`--tls-crt`",{"_7914":94,"_22115":34,"_18751":32031,"_5":22248,"_15096":31841,"_1571":3011},[],{"_7914":95,"_22115":34,"_18751":32033,"_5":22248,"_15096":31841,"_1571":32034},[],"Ruta al certificado TLS (PEM)",{"_7914":96,"_22115":34,"_18751":32036,"_5":22248,"_15096":31841,"_1571":32037},[],"`--tls-key`",{"_7914":97,"_22115":34,"_18751":32039,"_5":22248,"_15096":31841,"_1571":3011},[],{"_7914":98,"_22115":34,"_18751":32041,"_5":22248,"_15096":31841,"_1571":32042},[],"Ruta a la clave privada TLS (PEM)",{"_7914":99,"_22115":34,"_18751":32044,"_5":22248,"_15096":31841,"_1571":32045},[],"`--helm-chart-lamassu`",{"_7914":100,"_22115":34,"_18751":32047,"_5":22248,"_15096":31841,"_1571":3011},[],{"_7914":101,"_22115":34,"_18751":32049,"_5":22248,"_15096":31841,"_1571":32050},[],"Ruta a chart local Lamassu (`.tgz`)",{"_7914":102,"_22115":34,"_18751":32052,"_5":22248,"_15096":31841,"_1571":32053},[],"`--helm-chart-postgres`",{"_7914":103,"_22115":34,"_18751":32055,"_5":22248,"_15096":31841,"_1571":3011},[],{"_7914":104,"_22115":34,"_18751":32057,"_5":22248,"_15096":31841,"_1571":32058},[],"Ruta a chart local PostgreSQL (`.tgz`)",{"_7914":105,"_22115":34,"_18751":32060,"_5":22248,"_15096":31841,"_1571":32061},[],"`--helm-chart-keycloak`",{"_7914":106,"_22115":34,"_18751":32063,"_5":22248,"_15096":31841,"_1571":3011},[],{"_7914":107,"_22115":34,"_18751":32065,"_5":22248,"_15096":31841,"_1571":32066},[],"Ruta a chart local Keycloak (`.tgz`)",{"_7914":108,"_22115":34,"_18751":32068,"_5":22248,"_15096":31841,"_1571":32069},[],"`--helm-chart-rabbitmq`",{"_7914":109,"_22115":34,"_18751":32071,"_5":22248,"_15096":31841,"_1571":3011},[],{"_7914":110,"_22115":34,"_18751":32073,"_5":22248,"_15096":31841,"_1571":32074},[],"Ruta a chart local RabbitMQ (`.tgz`)",{"_7914":111,"_22115":34,"_18751":32076,"_5":22248,"_15096":31841,"_1571":32077},[],"`-l`, `--local-chart-path`",{"_7914":112,"_22115":34,"_18751":32079,"_5":22248,"_15096":31841,"_1571":3011},[],{"_7914":113,"_22115":34,"_18751":32081,"_5":22248,"_15096":31841,"_1571":32082},[],"Ruta a directorio local descomprimido del chart Lamassu",{"_7914":114,"_22115":34,"_18751":32084,"_5":22248,"_15096":31845,"_1571":32085},[],"La función `detect_distribution` identifica la distribución con el siguiente orden de prioridad:",{"_7914":115,"_22115":34,"_18751":32087,"_5":22248,"_15096":31845,"_1571":32088},[],"`microk8s`",{"_7914":116,"_22115":34,"_18751":32090,"_5":22248,"_15096":31845,"_1571":32091},[],"`k3s`",{"_7914":117,"_22115":34,"_18751":32093,"_5":22248,"_15096":31845,"_1571":32094},[],"`kind`",{"_7914":118,"_22115":34,"_18751":32096,"_5":22248,"_15096":31845,"_1571":32097},[],"Kubernetes estándar",{"_7914":119,"_22115":34,"_18751":32099,"_5":22248,"_15096":31845,"_1571":32100},[],"Comportamientos específicos:",{"_7914":120,"_22115":34,"_18751":32102,"_5":22248,"_15096":31845,"_1571":32103},[],"En `microk8s`, los comandos se ejecutan con prefijos `microk8s kubectl` y `microk8s helm`.",{"_7914":121,"_22115":34,"_18751":32105,"_5":22248,"_15096":31845,"_1571":32106},[],"En `kind`, el script muestra una advertencia de uso exclusivo para pruebas.",{"_7914":122,"_22115":34,"_18751":32108,"_5":22248,"_15096":31849,"_1571":32109},[],"La función `check_dependencies` valida prerequisitos según la distribución detectada.",{"_7914":123,"_22115":34,"_18751":32111,"_5":22248,"_15096":31849,"_1571":32112},[],"Requisitos generales:",{"_7914":124,"_22115":34,"_18751":32114,"_5":22248,"_15096":31849,"_1571":32115},[],"`yq`",{"_7914":125,"_22115":34,"_18751":32117,"_5":22248,"_15096":31849,"_1571":32118},[],"CLI de la distribución detectada",{"_7914":126,"_22115":34,"_18751":32120,"_5":22248,"_15096":31849,"_1571":32121},[],"Requisitos específicos:",{"_7914":127,"_22115":34,"_18751":32123,"_5":22248,"_15096":31849,"_1571":32124},[],"Distribución",{"_7914":128,"_22115":34,"_18751":32126,"_5":22248,"_15096":31849,"_1571":32127},[],"Herramientas requeridas",{"_7914":129,"_22115":34,"_18751":32129,"_5":22248,"_15096":31849,"_1571":32091},[],{"_7914":130,"_22115":34,"_18751":32131,"_5":22248,"_15096":31849,"_1571":32132},[],"`kubectl`, `helm`",{"_7914":131,"_22115":34,"_18751":32134,"_5":22248,"_15096":31849,"_1571":32088},[],{"_7914":132,"_22115":34,"_18751":32136,"_5":22248,"_15096":31849,"_1571":32137},[],"`microk8s kubectl`, `microk8s helm`",{"_7914":133,"_22115":34,"_18751":32139,"_5":22248,"_15096":31853,"_1571":32140},[],"Se valida que estén habilitados:",{"_7914":134,"_22115":34,"_18751":32142,"_5":22248,"_15096":31853,"_1571":32143},[],"`helm`",{"_7914":135,"_22115":34,"_18751":32145,"_5":22248,"_15096":31853,"_1571":32146},[],"`hostpath-storage`",{"_7914":136,"_22115":34,"_18751":32148,"_5":22248,"_15096":31853,"_1571":32149},[],"`dns`",{"_7914":137,"_22115":34,"_18751":32151,"_5":22248,"_15096":31853,"_1571":32152},[],"`cert-manager`",{"_7914":138,"_22115":34,"_18751":32154,"_5":22248,"_15096":31853,"_1571":32155},[],"También se verifica un release Helm de Envoy Gateway llamado `eg` en el namespace `envoy-gateway-system`.\nSi no existe, se instala automáticamente la versión `v1.3.0` y se crea un `GatewayClass` llamado `eg`.",{"_7914":139,"_22115":34,"_18751":32157,"_5":22248,"_15096":31861,"_1571":32158},[],"La función `request_config_data` solicita:",{"_7914":140,"_22115":34,"_18751":32160,"_5":22248,"_15096":31861,"_1571":32161},[],"Dominio Lamassu",{"_7914":141,"_22115":34,"_18751":32163,"_5":22248,"_15096":31861,"_1571":32164},[],"Usuario y contraseña admin PostgreSQL",{"_7914":142,"_22115":34,"_18751":32166,"_5":22248,"_15096":31861,"_1571":32167},[],"Usuario y contraseña admin RabbitMQ",{"_7914":143,"_22115":34,"_18751":32169,"_5":22248,"_15096":31861,"_1571":32170},[],"Usuario y contraseña admin Keycloak",{"_7914":144,"_22115":34,"_18751":32172,"_5":22248,"_15096":31861,"_1571":32173},[],"Namespace Kubernetes",{"_7914":145,"_22115":34,"_18751":32175,"_5":22248,"_15096":31865,"_1571":32176},[],"Se generan credenciales aleatorias de 30 caracteres alfanuméricos.",{"_7914":146,"_22115":34,"_18751":32178,"_5":22248,"_15096":31865,"_1571":32179},[],"Se usan valores por defecto para dominio y namespace, salvo que se sobrescriban con flags.",{"_7914":147,"_22115":34,"_18751":32181,"_5":22248,"_15096":31869,"_1571":32182},[],"El script admite dos estrategias para obtener charts Helm.",{"_7914":148,"_22115":34,"_18751":32184,"_5":22248,"_15096":31873,"_1571":32185},[],"Los charts se descargan desde repositorios remotos.",{"_7914":149,"_22115":34,"_18751":32187,"_5":22248,"_15096":31877,"_1571":32188},[],"Requiere obligatoriamente rutas a los cuatro charts:",{"_7914":150,"_22115":34,"_18751":32190,"_5":22248,"_15096":31877,"_1571":32045},[],{"_7914":151,"_22115":34,"_18751":32192,"_5":22248,"_15096":31877,"_1571":32053},[],{"_7914":152,"_22115":34,"_18751":32194,"_5":22248,"_15096":31877,"_1571":32061},[],{"_7914":153,"_22115":34,"_18751":32196,"_5":22248,"_15096":31877,"_1571":32069},[],{"_7914":154,"_22115":34,"_18751":32198,"_5":22248,"_15096":31877,"_1571":32199},[],"Si falta cualquiera de ellos, el script finaliza con error.",{"_7914":155,"_22115":34,"_18751":32201,"_5":22248,"_15096":31877,"_1571":32202},[],"En este modo se fuerza:",{"_7914":156,"_22115":34,"_18751":32204,"_5":22248,"_15096":31885,"_1571":32205},[],"Chart: `oci://registry-1.docker.io/cloudpirates/postgres`",{"_7914":157,"_22115":34,"_18751":32207,"_5":22248,"_15096":31885,"_1571":32208},[],"Versión del chart: `0.19.0`",{"_7914":158,"_22115":34,"_18751":32210,"_5":22248,"_15096":31885,"_1571":32211},[],"Release: `postgres`",{"_7914":159,"_22115":34,"_18751":32213,"_5":22248,"_15096":31885,"_1571":32214},[],"`fullnameOverride: \"postgresql\"`",{"_7914":160,"_22115":34,"_18751":32216,"_5":22248,"_15096":31885,"_1571":32217},[],"Se crea un script SQL de inicialización con estas bases de datos:",{"_7914":161,"_22115":34,"_18751":32219,"_5":22248,"_15096":31885,"_1571":32220},[],"Base de datos",{"_7914":162,"_22115":34,"_18751":32222,"_5":22248,"_15096":31885,"_1571":32223},[],"Servicio",{"_7914":163,"_22115":34,"_18751":32225,"_5":22248,"_15096":31885,"_1571":32226},[],"`auth`",{"_7914":164,"_22115":34,"_18751":32228,"_5":22248,"_15096":31885,"_1571":31938},[],{"_7914":165,"_22115":34,"_18751":32230,"_5":22248,"_15096":31885,"_1571":32231},[],"`alerts`",{"_7914":166,"_22115":34,"_18751":32233,"_5":22248,"_15096":31885,"_1571":32234},[],"Alerts",{"_7914":167,"_22115":34,"_18751":32236,"_5":22248,"_15096":31885,"_1571":32237},[],"`ca`",{"_7914":168,"_22115":34,"_18751":32239,"_5":22248,"_15096":31885,"_1571":32240},[],"CA",{"_7914":169,"_22115":34,"_18751":32242,"_5":22248,"_15096":31885,"_1571":32243},[],"`va`",{"_7914":170,"_22115":34,"_18751":32245,"_5":22248,"_15096":31885,"_1571":32246},[],"VA",{"_7914":171,"_22115":34,"_18751":32248,"_5":22248,"_15096":31885,"_1571":32249},[],"`cloudproxy`",{"_7914":172,"_22115":34,"_18751":32251,"_5":22248,"_15096":31885,"_1571":32252},[],"Cloud Proxy",{"_7914":173,"_22115":34,"_18751":32254,"_5":22248,"_15096":31885,"_1571":32255},[],"`devicemanager`",{"_7914":174,"_22115":34,"_18751":32257,"_5":22248,"_15096":31885,"_1571":32258},[],"Device Manager",{"_7914":175,"_22115":34,"_18751":32260,"_5":22248,"_15096":31885,"_1571":32261},[],"`dmsmanager`",{"_7914":176,"_22115":34,"_18751":32263,"_5":22248,"_15096":31885,"_1571":32264},[],"DMS Manager",{"_7914":177,"_22115":34,"_18751":32266,"_5":22248,"_15096":31885,"_1571":32267},[],"`kms`",{"_7914":178,"_22115":34,"_18751":32269,"_5":22248,"_15096":31885,"_1571":32270},[],"KMS",{"_7914":179,"_22115":34,"_18751":32272,"_5":22248,"_15096":31889,"_1571":32273},[],"Chart: `oci://registry-1.docker.io/cloudpirates/keycloak`",{"_7914":180,"_22115":34,"_18751":32275,"_5":22248,"_15096":31889,"_1571":32276},[],"Versión del chart: `0.20.0`",{"_7914":181,"_22115":34,"_18751":32278,"_5":22248,"_15096":31889,"_1571":32279},[],"Release: `auth`",{"_7914":182,"_22115":34,"_18751":32281,"_5":22248,"_15096":31889,"_1571":32282},[],"Uso de base de datos externa: `postgresql:5432/auth`",{"_7914":183,"_22115":34,"_18751":32284,"_5":22248,"_15096":31889,"_1571":32285},[],"Imagen de Keycloak fijada en `keycloak/keycloak:26.6.0`",{"_7914":184,"_22115":34,"_18751":32287,"_5":22248,"_15096":31889,"_1571":32288},[],"`httpRelativePath: /auth/`",{"_7914":185,"_22115":34,"_18751":32290,"_5":22248,"_15096":31889,"_1571":32291},[],"`proxyHeaders: xforwarded`",{"_7914":186,"_22115":34,"_18751":32293,"_5":22248,"_15096":31889,"_1571":32294},[],"Configuración automática del realm `lamassu`:",{"_7914":187,"_22115":34,"_18751":32296,"_5":22248,"_15096":31889,"_1571":32297},[],"Rol: `pki-admin`",{"_7914":188,"_22115":34,"_18751":32299,"_5":22248,"_15096":31889,"_1571":32300},[],"Usuario inicial: `lamassu` / `lamassu` (cambio obligatorio)",{"_7914":189,"_22115":34,"_18751":32302,"_5":22248,"_15096":31889,"_1571":32303},[],"Cliente público: `frontend` con `/*` en redirect URIs",{"_7914":190,"_22115":34,"_18751":32305,"_5":22248,"_15096":31889,"_1571":32306},[],"En modo online se descarga automáticamente un tema personalizado desde:",{"_7914":191,"_22115":34,"_18751":32308,"_5":22248,"_15096":31889,"_1571":32309},[],"`github.com/lamassuiot/keycloak-theme`",{"_7914":192,"_22115":34,"_18751":32311,"_5":22248,"_15096":31893,"_1571":32312},[],"Chart: `oci://registry-1.docker.io/cloudpirates/rabbitmq`",{"_7914":193,"_22115":34,"_18751":32314,"_5":22248,"_15096":31893,"_1571":32276},[],{"_7914":194,"_22115":34,"_18751":32316,"_5":22248,"_15096":31893,"_1571":32317},[],"Release: `rabbitmq`",{"_7914":195,"_22115":34,"_18751":32319,"_5":22248,"_15096":31893,"_1571":32320},[],"`fullnameOverride: \"rabbitmq\"`",{"_7914":196,"_22115":34,"_18751":32322,"_5":22248,"_15096":31893,"_1571":32323},[],"Credenciales inyectadas dinámicamente mediante `yq`",{"_7914":197,"_22115":34,"_18751":32325,"_5":22248,"_15096":31897,"_1571":32326},[],"Se genera un archivo `lamassu.yaml` que se pasa a `helm install`.",{"_7914":198,"_22115":34,"_18751":32328,"_5":22248,"_15096":31897,"_1571":32329},[],"Configuraciones principales:",{"_7914":199,"_22115":34,"_18751":32331,"_5":22248,"_15096":31897,"_1571":32332},[],"PostgreSQL: host `postgresql`, puerto `5432`",{"_7914":200,"_22115":34,"_18751":32334,"_5":22248,"_15096":31897,"_1571":32335},[],"AMQP: host `rabbitmq`, puerto `5672`, TLS deshabilitado",{"_7914":201,"_22115":34,"_18751":32337,"_5":22248,"_15096":31897,"_1571":32338},[],"OIDC JWKS:\n`http://auth-keycloak.<NAMESPACE>/auth/realms/lamassu/protocol/openid-connect/certs`",{"_7914":202,"_22115":34,"_18751":32340,"_5":22248,"_15096":31897,"_1571":32341},[],"Ruta adicional de gateway: `/auth -> auth-keycloak:8080`",{"_7914":203,"_22115":34,"_18751":32343,"_5":22248,"_15096":31897,"_1571":32344},[],"Direcciones de gateway: IP(s) obtenidas con `hostname -I`",{"_7914":204,"_22115":34,"_18751":32346,"_5":22248,"_15096":31897,"_1571":32347},[],"Puertos de gateway: desde `--https-port` y `--http-port`",{"_7914":205,"_22115":34,"_18751":32349,"_5":22248,"_15096":31897,"_1571":32350},[],"Dominios CA: valor de `--domain`",{"_7914":206,"_22115":34,"_18751":32352,"_5":22248,"_15096":31897,"_1571":32353},[],"Cuando se ejecuta en modo online y no se usa `--local-chart-path`, el script añade el repositorio Helm:",{"_7914":207,"_22115":34,"_18751":32355,"_5":22248,"_15096":31897,"_1571":32356},[],"Después instala el release `lamassu` usando la versión indicada por `--version` si se ha proporcionado.",{"_7914":208,"_22115":34,"_18751":32358,"_5":22248,"_15096":31897,"_1571":32359},[],"Si `--https-port` es distinto de `443`, el puerto se añade al dominio antes de escribirlo en `values`.",{"_7914":209,"_22115":34,"_18751":32361,"_5":22248,"_15096":31905,"_1571":32362},[],"Si se proporcionan:",{"_7914":210,"_22115":34,"_18751":32364,"_5":22248,"_15096":31905,"_1571":32029},[],{"_7914":211,"_22115":34,"_18751":32366,"_5":22248,"_15096":31905,"_1571":32037},[],{"_7914":212,"_22115":34,"_18751":32368,"_5":22248,"_15096":31905,"_1571":32369},[],"Se crea un secret Kubernetes:",{"_7914":213,"_22115":34,"_18751":32371,"_5":22248,"_15096":31905,"_1571":32372},[],"`downstream-provided-crt`",{"_7914":214,"_22115":34,"_18751":32374,"_5":22248,"_15096":31905,"_1571":32375},[],"Y se configura:",{"_7914":215,"_22115":34,"_18751":32377,"_5":22248,"_15096":31909,"_1571":32378},[],"Si no se proporciona certificado:",{"_7914":216,"_22115":34,"_18751":32380,"_5":22248,"_15096":31909,"_1571":32381},[],"Además, el script crea un `Issuer` self-signed y el recurso `Certificate`.",{"_7914":217,"_22115":34,"_18751":32383,"_5":22248,"_15096":31909,"_1571":32384},[],"Si el usuario quiere reutilizar un `Issuer` o `ClusterIssuer` corporativo, ese flujo no lo automatiza Fastlane; en ese caso es preferible un despliegue manual del chart con un archivo `values.yaml` propio.",{"_7914":218,"_22115":34,"_18751":32386,"_5":22248,"_15096":31913,"_1571":32387},[],"En caso de éxito, se muestra:",{"_7914":219,"_22115":34,"_18751":32389,"_5":22248,"_15096":31913,"_1571":32390},[],"URL de Lamassu UI: `https://<DOMAIN>`",{"_7914":220,"_22115":34,"_18751":32392,"_5":22248,"_15096":31913,"_1571":32393},[],"Credenciales iniciales: `lamassu / lamassu`",{"_7914":221,"_22115":34,"_18751":32395,"_5":22248,"_15096":31913,"_1571":32396},[],"Consola Keycloak: `https://<DOMAIN>/auth/admin`",{"_7914":222,"_22115":34,"_18751":32398,"_5":22248,"_15096":31913,"_1571":32399},[],"Credenciales admin de Keycloak",{"_7914":223,"_22115":34,"_18751":32401,"_5":22248,"_15096":31913,"_1571":32402},[],"El usuario `lamassu` se crea con:",{"_7914":224,"_22115":34,"_18751":32404,"_5":22248,"_15096":31913,"_1571":32405},[],"Por tanto, debe cambiar contraseña en el primer acceso.",{"_7914":225,"_22115":34,"_18751":32407,"_5":22248,"_15096":31917,"_1571":32408},[],"El script está pensado también para validaciones rápidas y smoke tests locales. Tras la instalación puede ejecutarse:",{"_7914":226,"_22115":34,"_18751":32410,"_5":22248,"_15096":31917,"_1571":32411},[],"El chart incluye una prueba que valida conectividad contra `ca`, `dms-manager`, `device-manager`, `va` y `ui`.",{"_7914":227,"_22115":34,"_18751":32413,"_5":22248,"_15096":31917,"_1571":32414},[],"Ejemplo:",{"_7914":228,"_22115":34,"_18751":32416,"_5":22248,"_15096":31917,"_1571":32417},[],"En este escenario:",{"_7914":229,"_22115":34,"_18751":32419,"_5":22248,"_15096":31917,"_1571":32420},[],"`-n`: modo no interactivo",{"_7914":230,"_22115":34,"_18751":32422,"_5":22248,"_15096":31917,"_1571":32423},[],"`-ns`: namespace específico",{"_7914":231,"_22115":34,"_18751":32425,"_5":22248,"_15096":31917,"_1571":32426},[],"`-d`: dominio de CI",{"_7914":232,"_22115":34,"_18751":32428,"_5":22248,"_15096":31917,"_1571":32429},[],"`-l`: chart local",{"_7914":233,"_22115":34,"_18751":32431,"_5":22248,"_15096":31925,"_1571":32432},[],"`lamassu-fast-lane.sh` proporciona un mecanismo totalmente automatizado para desplegar un entorno Lamassu funcional en Kubernetes en pocos minutos, integrando base de datos, autenticación, mensajería, gateway y TLS.",{"_7914":234,"_22115":34,"_18751":32434,"_5":22248,"_15096":31925,"_1571":32435},[],"Está optimizado para rapidez, reproducibilidad y uso en entornos no productivos, con soporte para escenarios offline y pipelines de CI.",{"_7914":235,"_22115":235,"_5":22243,"_1571":32437,"_22256":32438,"_18751":32439,"_15096":235},"Introducción",[31753,31754,31805],[],{"_7914":236,"_22115":235,"_18751":32441,"_5":22248,"_15096":235,"_1571":32442},[],"Despliegue de Lamassu IoT en infraestructura on-premise gestionada con Kubernetes",{"_7914":237,"_22115":235,"_5":22253,"_18751":32444,"_15096":32445,"_1571":32446},[],"/docs/despliegue/onprem#despliegue-onprem-con-kubernetes","Despliegue OnPrem con Kubernetes",{"_7914":238,"_22115":235,"_5":22253,"_18751":32448,"_15096":32449,"_1571":32450},[],"/docs/despliegue/onprem#quickstart","Quickstart",{"_7914":239,"_22115":235,"_5":22253,"_18751":32452,"_15096":32453,"_1571":32454},[],"/docs/despliegue/onprem#qué-se-despliega","Qué se despliega",{"_7914":240,"_22115":235,"_5":22253,"_18751":32456,"_15096":32457,"_1571":32458},[],"/docs/despliegue/onprem#requisitos-previos","Requisitos previos",{"_7914":241,"_22115":235,"_5":22253,"_18751":32460,"_15096":32461,"_1571":32462},[],"/docs/despliegue/onprem#opciones-de-despliegue","Opciones de despliegue",{"_7914":242,"_22115":235,"_5":22253,"_18751":32464,"_15096":32465,"_1571":32466},[],"/docs/despliegue/onprem#1-despliegue-manual-con-helm","1\\. Despliegue manual con Helm",{"_7914":243,"_22115":235,"_5":22253,"_18751":32468,"_15096":32469,"_1571":32470},[],"/docs/despliegue/onprem#2-despliegue-automatizado-con-fastlane","2\\. Despliegue automatizado con Fastlane",{"_7914":244,"_22115":235,"_5":22253,"_18751":32472,"_15096":32473,"_1571":32474},[],"/docs/despliegue/onprem#arquitectura","Arquitectura",{"_7914":245,"_22115":235,"_5":22253,"_18751":32476,"_15096":32477,"_1571":32478},[],"/docs/despliegue/onprem#instalación-manual-con-helm","Instalación manual con Helm",{"_7914":246,"_22115":235,"_5":22253,"_18751":32480,"_15096":32481,"_1571":32482},[],"/docs/despliegue/onprem#valores-mínimos-que-deben-definirse","Valores mínimos que deben definirse",{"_7914":247,"_22115":235,"_5":22253,"_18751":32484,"_15096":32485,"_1571":32486},[],"/docs/despliegue/onprem#áreas-de-configuración-más-relevantes","Áreas de configuración más relevantes",{"_7914":248,"_22115":235,"_5":22253,"_18751":32488,"_15096":32489,"_1571":32490},[],"/docs/despliegue/onprem#verificación-del-despliegue","Verificación del despliegue",{"_7914":249,"_22115":235,"_5":22253,"_18751":32492,"_15096":32493,"_1571":32494},[],"/docs/despliegue/onprem#repositorio-helm","Repositorio Helm",{"_7914":250,"_22115":235,"_5":22253,"_18751":32496,"_15096":32497,"_1571":32498},[],"/docs/despliegue/onprem#softhsm-como-complemento-opcional","SoftHSM como complemento opcional",{"_7914":251,"_22115":235,"_5":22253,"_18751":32500,"_15096":32501,"_1571":32502},[],"/docs/despliegue/onprem#versionado-y-migraciones","Versionado y migraciones",{"_7914":252,"_22115":235,"_18751":32504,"_5":22248,"_15096":32445,"_1571":32505},[],"Lamassu IoT puede desplegarse en infraestructura propia mediante **Kubernetes**, tanto en clústeres gestionados internamente como en entornos self-managed.",{"_7914":253,"_22115":235,"_18751":32507,"_5":22248,"_15096":32445,"_1571":32508},[],"La referencia principal para este despliegue es el repositorio `lamassu-helm`, que incluye:",{"_7914":254,"_22115":235,"_18751":32510,"_5":22248,"_15096":32445,"_1571":32511},[],"el chart principal de Lamassu",{"_7914":255,"_22115":235,"_18751":32513,"_5":22248,"_15096":32445,"_1571":32514},[],"un chart auxiliar de SoftHSM",{"_7914":256,"_22115":235,"_18751":32516,"_5":22248,"_15096":32445,"_1571":32517},[],"el script de despliegue automatizado `scripts/lamassu-fast-lane.sh`",{"_7914":257,"_22115":235,"_18751":32519,"_5":22248,"_15096":32449,"_1571":32520},[],"Si lo que necesitas es levantar un entorno funcional lo antes posible, la vía más rápida es usar Fastlane desde el repositorio `lamassu-helm`:",{"_7914":258,"_22115":235,"_18751":32522,"_5":22248,"_15096":32449,"_1571":32523},[],"Ese flujo:",{"_7914":259,"_22115":235,"_18751":32525,"_5":22248,"_15096":32449,"_1571":32526},[],"crea o reutiliza el namespace indicado",{"_7914":260,"_22115":235,"_18751":32528,"_5":22248,"_15096":32449,"_1571":32529},[],"instala PostgreSQL, Keycloak y RabbitMQ",{"_7914":261,"_22115":235,"_18751":32531,"_5":22248,"_15096":32449,"_1571":32532},[],"despliega el chart de Lamassu",{"_7914":262,"_22115":235,"_18751":32534,"_5":22248,"_15096":32449,"_1571":32535},[],"deja la UI expuesta en `https://<dominio>`",{"_7914":263,"_22115":235,"_18751":32537,"_5":22248,"_15096":32449,"_1571":32538},[],"Si buscas un despliegue productivo o más controlado, sigue con la instalación manual mediante Helm que se describe más abajo.",{"_7914":264,"_22115":235,"_18751":32540,"_5":22248,"_15096":32453,"_1571":32541},[],"El chart principal `charts/lamassu`, actualmente en la serie `3.7.x`, despliega estos componentes:",{"_7914":265,"_22115":235,"_18751":32543,"_5":22248,"_15096":32453,"_1571":32544},[],"`ui`",{"_7914":266,"_22115":235,"_18751":32546,"_5":22248,"_15096":32453,"_1571":32237},[],{"_7914":267,"_22115":235,"_18751":32548,"_5":22248,"_15096":32453,"_1571":32243},[],{"_7914":268,"_22115":235,"_18751":32550,"_5":22248,"_15096":32453,"_1571":32267},[],{"_7914":269,"_22115":235,"_18751":32552,"_5":22248,"_15096":32453,"_1571":32553},[],"`device-manager`",{"_7914":270,"_22115":235,"_18751":32555,"_5":22248,"_15096":32453,"_1571":32556},[],"`dms-manager`",{"_7914":271,"_22115":235,"_18751":32558,"_5":22248,"_15096":32453,"_1571":32231},[],{"_7914":272,"_22115":235,"_18751":32560,"_5":22248,"_15096":32453,"_1571":32561},[],"recursos de Gateway API y políticas de Envoy Gateway",{"_7914":273,"_22115":235,"_18751":32563,"_5":22248,"_15096":32453,"_1571":32564},[],"job de migraciones de base de datos",{"_7914":274,"_22115":235,"_18751":32566,"_5":22248,"_15096":32457,"_1571":32567},[],"Clúster Kubernetes `1.19+`",{"_7914":275,"_22115":235,"_18751":32569,"_5":22248,"_15096":32457,"_1571":32570},[],"`kubectl` configurado con acceso al clúster",{"_7914":276,"_22115":235,"_18751":32572,"_5":22248,"_15096":32457,"_1571":32573},[],"Helm `3.2.0+`",{"_7914":277,"_22115":235,"_18751":32575,"_5":22248,"_15096":32457,"_1571":32576},[],"`cert-manager 1.14+` para la gestión de certificados cuando se usa `tls.type=certManager`",{"_7914":278,"_22115":235,"_18751":32578,"_5":22248,"_15096":32457,"_1571":32579},[],"`Envoy Gateway 1.3.0+`, ya que el chart publica servicios mediante Gateway API y no mediante Ingress",{"_7914":279,"_22115":235,"_18751":32581,"_5":22248,"_15096":32457,"_1571":32582},[],"Acceso a un registro de contenedores o imágenes previamente importadas si se trabaja en modo offline",{"_7914":280,"_22115":235,"_18751":32584,"_5":22248,"_15096":32457,"_1571":32585},[],"Almacenamiento persistente disponible para PostgreSQL, RabbitMQ, VA y KMS",{"_7914":281,"_22115":235,"_18751":32587,"_5":22248,"_15096":32461,"_1571":32588},[],"Hay dos formas de desplegar Lamassu on-prem:",{"_7914":282,"_22115":235,"_18751":32590,"_5":22248,"_15096":32465,"_1571":32591},[],"Es la opción recomendada para entornos productivos o controlados, donde PostgreSQL, RabbitMQ, Keycloak, certificados y direccionamiento del Gateway ya están definidos por el equipo de plataforma.",{"_7914":283,"_22115":235,"_18751":32593,"_5":22248,"_15096":32469,"_1571":32594},[],"Es la opción más útil para pruebas, demos, CI o bootstrap rápido de un entorno. Fastlane levanta PostgreSQL, Keycloak, RabbitMQ y Lamassu en un único flujo. Su comportamiento está documentado en la página siguiente.",{"_7914":284,"_22115":235,"_18751":32596,"_5":22248,"_15096":32473,"_1571":32597},[],"Lamassu IoT se despliega como un conjunto de microservicios Kubernetes independientes. El chart principal crea `Deployment`, `StatefulSet`, `Service`, `ConfigMap`, `HTTPRoute`, `Gateway`, certificados y recursos auxiliares según los valores definidos.",{"_7914":285,"_22115":235,"_18751":32599,"_5":22248,"_15096":32473,"_1571":32600},[],"Dependencias externas requeridas por el chart principal:",{"_7914":286,"_22115":235,"_18751":32602,"_5":22248,"_15096":32473,"_1571":31935},[],{"_7914":287,"_22115":235,"_18751":32604,"_5":22248,"_15096":32473,"_1571":31941},[],{"_7914":288,"_22115":235,"_18751":32606,"_5":22248,"_15096":32473,"_1571":32607},[],"proveedor OIDC, típicamente Keycloak",{"_7914":289,"_22115":235,"_18751":32609,"_5":22248,"_15096":32473,"_1571":32610},[],"El chart no instala estas dependencias por sí solo. Para un despliegue manual hay que provisionarlas antes. Si se busca un entorno funcional rápido para laboratorio o validación, el script Fastlane sí instala PostgreSQL, RabbitMQ y Keycloak además del chart de Lamassu.",{"_7914":290,"_22115":235,"_18751":32612,"_5":22248,"_15096":32477,"_1571":32613},[],"Agregar el repositorio Helm:",{"_7914":291,"_22115":235,"_18751":32615,"_5":22248,"_15096":32477,"_1571":32616},[],"O instalar desde una copia local del repositorio:",{"_7914":292,"_22115":235,"_18751":32618,"_5":22248,"_15096":32481,"_1571":32619},[],"Los valores por defecto del chart son deliberadamente incompletos para dependencias externas. Como mínimo, un despliegue manual debe definir:",{"_7914":293,"_22115":235,"_18751":32621,"_5":22248,"_15096":32481,"_1571":32622},[],"`postgres.hostname`, `postgres.username`, `postgres.password`",{"_7914":294,"_22115":235,"_18751":32624,"_5":22248,"_15096":32481,"_1571":32625},[],"`amqp.hostname`, `amqp.username`, `amqp.password`",{"_7914":295,"_22115":235,"_18751":32627,"_5":22248,"_15096":32481,"_1571":32628},[],"`auth.oidc.frontend.authority`",{"_7914":296,"_22115":235,"_18751":32630,"_5":22248,"_15096":32481,"_1571":32631},[],"`auth.oidc.apiGateway.jwks`",{"_7914":297,"_22115":235,"_18751":32633,"_5":22248,"_15096":32481,"_1571":32634},[],"`services.ca.domains`",{"_7914":298,"_22115":235,"_18751":32636,"_5":22248,"_15096":32481,"_1571":32637},[],"`gateway.addresses` o una estrategia equivalente de publicación según el clúster",{"_7914":299,"_22115":235,"_18751":32639,"_5":22248,"_15096":32481,"_1571":32640},[],"`tls.*` según se use `certManager` o certificado externo",{"_7914":300,"_22115":235,"_18751":32642,"_5":22248,"_15096":32481,"_1571":32643},[],"Ejemplo base:",{"_7914":301,"_22115":235,"_18751":32645,"_5":22248,"_15096":32485,"_1571":32646},[],"Área",{"_7914":302,"_22115":235,"_18751":32648,"_5":22248,"_15096":32485,"_1571":32649},[],"Valores clave",{"_7914":303,"_22115":235,"_18751":32651,"_5":22248,"_15096":32485,"_1571":32652},[],"Uso",{"_7914":304,"_22115":235,"_18751":32654,"_5":22248,"_15096":32485,"_1571":32655},[],"TLS",{"_7914":305,"_22115":235,"_18751":32657,"_5":22248,"_15096":32485,"_1571":32658},[],"`tls.type`, `tls.certManagerOptions.*`, `tls.externalOptions.secretName`",{"_7914":306,"_22115":235,"_18751":32660,"_5":22248,"_15096":32485,"_1571":32661},[],"Certificado downstream del Gateway",{"_7914":307,"_22115":235,"_18751":32663,"_5":22248,"_15096":32485,"_1571":32664},[],"Gateway",{"_7914":308,"_22115":235,"_18751":32666,"_5":22248,"_15096":32485,"_1571":32667},[],"`gateway.addresses`, `gateway.ports.*`, `gateway.extraRouting`",{"_7914":309,"_22115":235,"_18751":32669,"_5":22248,"_15096":32485,"_1571":32670},[],"Exposición de UI y APIs vía Envoy Gateway",{"_7914":310,"_22115":235,"_18751":32672,"_5":22248,"_15096":32485,"_1571":32220},[],{"_7914":311,"_22115":235,"_18751":32674,"_5":22248,"_15096":32485,"_1571":32675},[],"`postgres.*`",{"_7914":312,"_22115":235,"_18751":32677,"_5":22248,"_15096":32485,"_1571":32678},[],"Conexión a PostgreSQL externa",{"_7914":313,"_22115":235,"_18751":32680,"_5":22248,"_15096":32485,"_1571":32681},[],"Mensajería",{"_7914":314,"_22115":235,"_18751":32683,"_5":22248,"_15096":32485,"_1571":32684},[],"`amqp.*`",{"_7914":315,"_22115":235,"_18751":32686,"_5":22248,"_15096":32485,"_1571":32687},[],"Conexión a RabbitMQ",{"_7914":316,"_22115":235,"_18751":32689,"_5":22248,"_15096":32485,"_1571":32690},[],"OIDC",{"_7914":317,"_22115":235,"_18751":32692,"_5":22248,"_15096":32485,"_1571":32693},[],"`auth.oidc.frontend.*`, `auth.oidc.apiGateway.jwks`",{"_7914":318,"_22115":235,"_18751":32695,"_5":22248,"_15096":32485,"_1571":32696},[],"Login de UI y validación JWT en el Gateway",{"_7914":319,"_22115":235,"_18751":32698,"_5":22248,"_15096":32485,"_1571":32240},[],{"_7914":320,"_22115":235,"_18751":32700,"_5":22248,"_15096":32485,"_1571":32634},[],{"_7914":321,"_22115":235,"_18751":32702,"_5":22248,"_15096":32485,"_1571":32703},[],"Dominios autorizados para CA y certificados",{"_7914":322,"_22115":235,"_18751":32705,"_5":22248,"_15096":32485,"_1571":32270},[],{"_7914":323,"_22115":235,"_18751":32707,"_5":22248,"_15096":32485,"_1571":32708},[],"`services.kms.cryptoEngines.*`",{"_7914":324,"_22115":235,"_18751":32710,"_5":22248,"_15096":32485,"_1571":32711},[],"Motor criptográfico y almacenamiento de claves",{"_7914":325,"_22115":235,"_18751":32713,"_5":22248,"_15096":32485,"_1571":32234},[],{"_7914":326,"_22115":235,"_18751":32715,"_5":22248,"_15096":32485,"_1571":32716},[],"`services.alerts.smtp_server.*`",{"_7914":327,"_22115":235,"_18751":32718,"_5":22248,"_15096":32485,"_1571":32719},[],"Envío de correo para alertas",{"_7914":328,"_22115":235,"_18751":32721,"_5":22248,"_15096":32489,"_1571":32722},[],"El chart incluye una prueba Helm en `charts/lamassu/templates/tests/test-connections.yml`. Tras instalarlo, puede validarse con:",{"_7914":329,"_22115":235,"_18751":32724,"_5":22248,"_15096":32489,"_1571":32725},[],"La prueba comprueba al menos:",{"_7914":330,"_22115":235,"_18751":32727,"_5":22248,"_15096":32489,"_1571":32728},[],"salud de `ca`",{"_7914":331,"_22115":235,"_18751":32730,"_5":22248,"_15096":32489,"_1571":32731},[],"salud de `dms-manager`",{"_7914":332,"_22115":235,"_18751":32733,"_5":22248,"_15096":32489,"_1571":32734},[],"salud de `device-manager`",{"_7914":333,"_22115":235,"_18751":32736,"_5":22248,"_15096":32489,"_1571":32737},[],"salud de `va`",{"_7914":334,"_22115":235,"_18751":32739,"_5":22248,"_15096":32489,"_1571":32740},[],"respuesta HTML esperada del servicio `ui`",{"_7914":335,"_22115":235,"_18751":32742,"_5":22248,"_15096":32493,"_1571":32743},[],"El repositorio `lamassu-helm` está organizado en tres bloques principales:",{"_7914":336,"_22115":235,"_18751":32745,"_5":22248,"_15096":32493,"_1571":32746},[],"`charts/lamassu`: chart principal de Lamassu",{"_7914":337,"_22115":235,"_18751":32748,"_5":22248,"_15096":32493,"_1571":32749},[],"`charts/softhsm`: chart opcional para laboratorios o escenarios de integración con PKCS#11 emulado",{"_7914":338,"_22115":235,"_18751":32751,"_5":22248,"_15096":32493,"_1571":32752},[],"`scripts/lamassu-fast-lane.sh`: automatización para levantar dependencias y desplegar Lamassu con intervención mínima",{"_7914":339,"_22115":235,"_18751":32754,"_5":22248,"_15096":32497,"_1571":32755},[],"El chart `charts/softhsm` no forma parte del despliegue estándar, pero resulta útil en entornos de laboratorio cuando se necesita simular un HSM compatible con PKCS#11. No sustituye al backend KMS principal; sirve como soporte para pruebas o integraciones concretas.",{"_7914":340,"_22115":235,"_18751":32757,"_5":22248,"_15096":32501,"_1571":32758},[],"La serie actual del chart principal es `3.7.x`. Para upgrades entre versiones, el repositorio incluye guías específicas en `charts/lamassu/CHANGELOG/`, especialmente en cambios importantes como la adopción de Envoy Gateway o la introducción del servicio KMS.",{"_7914":341,"_22115":341,"_5":22243,"_1571":32760,"_22256":32761,"_18751":32762,"_15096":341},"SaaS · Suscripción",[31753,31754,31812],[],{"_7914":342,"_22115":341,"_18751":32764,"_5":22248,"_15096":341,"_1571":32765},[],"Acceso a Lamassu IoT como servicio gestionado basado en suscripción",{"_7914":343,"_22115":341,"_5":22253,"_18751":32767,"_15096":32768,"_1571":32769},[],"/docs/despliegue/saas#lamassu-iot-saas--basada-en-suscripción","Lamassu IoT SaaS – Basada en suscripción",{"_7914":344,"_22115":341,"_5":22253,"_18751":32771,"_15096":32772,"_1571":32773},[],"/docs/despliegue/saas#qué-incluye-la-suscripción","¿Qué incluye la suscripción?",{"_7914":345,"_22115":341,"_5":22253,"_18751":32775,"_15096":32776,"_1571":32777},[],"/docs/despliegue/saas#planes-disponibles","Planes disponibles",{"_7914":346,"_22115":341,"_5":22253,"_18751":32779,"_15096":32780,"_1571":32781},[],"/docs/despliegue/saas#contacto","Contacto",{"_7914":347,"_22115":341,"_18751":32783,"_5":22248,"_15096":32768,"_1571":32784},[],"La modalidad **SaaS** de Lamassu IoT ofrece acceso completo a la plataforma como servicio totalmente gestionado por LKS Next, sin necesidad de gestionar infraestructura propia.",{"_7914":348,"_22115":341,"_18751":32786,"_5":22248,"_15096":32772,"_1571":32787},[],"Acceso a la plataforma Lamassu IoT completamente gestionada",{"_7914":349,"_22115":341,"_18751":32789,"_5":22248,"_15096":32772,"_1571":32790},[],"Alta disponibilidad y backups automáticos",{"_7914":350,"_22115":341,"_18751":32792,"_5":22248,"_15096":32772,"_1571":32793},[],"Actualizaciones automáticas a las últimas versiones",{"_7914":351,"_22115":341,"_18751":32795,"_5":22248,"_15096":32772,"_1571":32796},[],"Soporte técnico incluido",{"_7914":352,"_22115":341,"_18751":32798,"_5":22248,"_15096":32772,"_1571":32799},[],"SLA garantizado",{"_7914":353,"_22115":341,"_18751":32801,"_5":22248,"_15096":32776,"_1571":32802},[],"Plan",{"_7914":354,"_22115":341,"_18751":32804,"_5":22248,"_15096":32776,"_1571":32805},[],"Dispositivos",{"_7914":355,"_22115":341,"_18751":32807,"_5":22248,"_15096":32776,"_1571":32808},[],"Soporte",{"_7914":356,"_22115":341,"_18751":32810,"_5":22248,"_15096":32776,"_1571":32811},[],"SLA",{"_7914":357,"_22115":341,"_18751":32813,"_5":22248,"_15096":32776,"_1571":32814},[],"Starter",{"_7914":358,"_22115":341,"_18751":32816,"_5":22248,"_15096":32776,"_1571":32817},[],"Hasta 1.000",{"_7914":359,"_22115":341,"_18751":32819,"_5":22248,"_15096":32776,"_1571":32820},[],"Email",{"_7914":360,"_22115":341,"_18751":32822,"_5":22248,"_15096":32776,"_1571":32823},[],"99,5%",{"_7914":361,"_22115":341,"_18751":32825,"_5":22248,"_15096":32776,"_1571":32826},[],"Professional",{"_7914":362,"_22115":341,"_18751":32828,"_5":22248,"_15096":32776,"_1571":32829},[],"Hasta 10.000",{"_7914":363,"_22115":341,"_18751":32831,"_5":22248,"_15096":32776,"_1571":32832},[],"Email + Chat",{"_7914":364,"_22115":341,"_18751":32834,"_5":22248,"_15096":32776,"_1571":32835},[],"99,9%",{"_7914":365,"_22115":341,"_18751":32837,"_5":22248,"_15096":32776,"_1571":32838},[],"Enterprise",{"_7914":366,"_22115":341,"_18751":32840,"_5":22248,"_15096":32776,"_1571":32841},[],"Ilimitado",{"_7914":367,"_22115":341,"_18751":32843,"_5":22248,"_15096":32776,"_1571":32844},[],"Dedicado",{"_7914":368,"_22115":341,"_18751":32846,"_5":22248,"_15096":32776,"_1571":32847},[],"99,99%",{"_7914":369,"_22115":341,"_18751":32849,"_5":22248,"_15096":32780,"_1571":32850},[],"Para suscribirte o solicitar una demo, contacta con el equipo de Lamassu IoT a través de lamassu.io.",{"_7914":370,"_22115":370,"_5":22243,"_1571":32852,"_22256":32853,"_18751":32854,"_15096":370},"Manual de Usuario",[31753,32852],[],{"_7914":371,"_22115":370,"_18751":32856,"_5":22248,"_15096":370,"_1571":32857},[],"Guía completa de uso de la plataforma Lamassu IoT",{"_7914":372,"_22115":370,"_5":22253,"_18751":32859,"_15096":32860,"_1571":32861},[],"/docs/manual#servicios-core","Servicios Core",{"_7914":373,"_22115":370,"_5":22253,"_18751":32863,"_15096":32864,"_1571":32865},[],"/docs/manual#integraciones-con-terceros","Integraciones con terceros",{"_7914":374,"_22115":370,"_18751":32867,"_5":22248,"_15096":370,"_1571":32868},[],"Bienvenido al **Manual de Usuario de Lamassu IoT**. Esta documentación cubre todas las funcionalidades de la plataforma para la gestión de identidades digitales en entornos IoT industriales.",{"_7914":375,"_22115":370,"_18751":32870,"_5":22248,"_15096":32860,"_1571":32871},[],"<Card title=\"Gestión de Claves (KMS)\" description=\"Motores criptográficos, generación e importación de claves\" href=\"/docs/manual/servicios-core/kms\" />",{"_7914":376,"_22115":370,"_18751":32873,"_5":22248,"_15096":32860,"_1571":32874},[],"<Card title=\"Entidades de Confianza (CAs)\" description=\"Creación, importación y gestión de Autoridades de Certificación\" href=\"/docs/manual/servicios-core/cas\" />",{"_7914":377,"_22115":370,"_18751":32876,"_5":22248,"_15096":32860,"_1571":32877},[],"<Card title=\"Gestión de Certificados\" description=\"Visualización y revocación de certificados emitidos\" href=\"/docs/manual/servicios-core/certificates\" />",{"_7914":378,"_22115":370,"_18751":32879,"_5":22248,"_15096":32860,"_1571":32880},[],"<Card title=\"Validación de Certificados (VA)\" description=\"Servicios OCSP y CRL\" href=\"/docs/manual/servicios-core/validation\" />",{"_7914":379,"_22115":370,"_18751":32882,"_5":22248,"_15096":32860,"_1571":32883},[],"<Card title=\"Registration Authority (RA)\" description=\"Automatización del ciclo de vida de certificados y protocolo EST\" href=\"/docs/manual/servicios-core/ra\" />",{"_7914":380,"_22115":370,"_18751":32885,"_5":22248,"_15096":32860,"_1571":32886},[],"<Card title=\"Dispositivos e Identidades\" description=\"Gestión de End Entities y ciclo de vida de dispositivos IoT\" href=\"/docs/manual/servicios-core/devices\" />",{"_7914":381,"_22115":370,"_18751":32888,"_5":22248,"_15096":32860,"_1571":32889},[],"<Card title=\"Alertas y Suscripciones\" description=\"Monitorización de eventos y notificaciones\" href=\"/docs/manual/servicios-core/alerts\" />",{"_7914":382,"_22115":370,"_18751":32891,"_5":22248,"_15096":32864,"_1571":32892},[],"<Card title=\"Integración AWS IoT Core\" description=\"Aprovisionamiento de dispositivos en AWS IoT Core\" href=\"/docs/manual/integraciones/aws\" />",{"_7914":383,"_22115":383,"_5":22243,"_1571":32894,"_22256":32895,"_18751":32896,"_15096":383},"Integración con AWS IoT Core",[31753,32852,32865],[],{"_7914":384,"_22115":383,"_18751":32898,"_5":22248,"_15096":383,"_1571":32899},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_7914":385,"_22115":383,"_5":22253,"_18751":32901,"_15096":32902,"_1571":32903},[],"/docs/manual/integraciones/aws#arquitectura-del-conector","Arquitectura del conector",{"_7914":386,"_22115":383,"_5":22253,"_18751":32905,"_15096":32906,"_1571":32907},[],"/docs/manual/integraciones/aws#prerrequisitos","Prerrequisitos",{"_7914":387,"_22115":383,"_5":22253,"_18751":32909,"_15096":32910,"_1571":32911},[],"/docs/manual/integraciones/aws#permisos-iam-necesarios","Permisos IAM necesarios",{"_7914":388,"_22115":383,"_5":22253,"_18751":32913,"_15096":32914,"_1571":32915},[],"/docs/manual/integraciones/aws#parámetros-de-configuración","Parámetros de configuración",{"_7914":389,"_22115":383,"_5":22253,"_18751":32917,"_15096":32918,"_1571":32919},[],"/docs/manual/integraciones/aws#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_7914":390,"_22115":383,"_5":22253,"_18751":32921,"_15096":32922,"_1571":32923},[],"/docs/manual/integraciones/aws#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_7914":391,"_22115":383,"_5":22253,"_18751":32925,"_15096":32926,"_1571":32927},[],"/docs/manual/integraciones/aws#primary-account","Primary Account",{"_7914":392,"_22115":383,"_5":22253,"_18751":32929,"_15096":32930,"_1571":32931},[],"/docs/manual/integraciones/aws#secondary-account-sni-only","Secondary Account (SNI-only)",{"_7914":393,"_22115":383,"_5":22253,"_18751":32933,"_15096":32934,"_1571":32935},[],"/docs/manual/integraciones/aws#configuración-del-dms","Configuración del DMS",{"_7914":394,"_22115":383,"_5":22253,"_18751":32937,"_15096":32938,"_1571":32939},[],"/docs/manual/integraciones/aws#modo-none","Modo `none`",{"_7914":395,"_22115":383,"_5":22253,"_18751":32941,"_15096":32942,"_1571":32943},[],"/docs/manual/integraciones/aws#modo-auto","Modo `auto`",{"_7914":396,"_22115":383,"_5":22253,"_18751":32945,"_15096":32946,"_1571":32947},[],"/docs/manual/integraciones/aws#modo-jitp","Modo `jitp`",{"_7914":397,"_22115":383,"_5":22253,"_18751":32949,"_15096":32950,"_1571":32951},[],"/docs/manual/integraciones/aws#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_7914":398,"_22115":383,"_5":22253,"_18751":32953,"_15096":32954,"_1571":32955},[],"/docs/manual/integraciones/aws#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_7914":399,"_22115":383,"_5":22253,"_18751":32957,"_15096":32958,"_1571":32959},[],"/docs/manual/integraciones/aws#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_7914":400,"_22115":383,"_5":22253,"_18751":32961,"_15096":32962,"_1571":32963},[],"/docs/manual/integraciones/aws#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_7914":401,"_22115":383,"_5":22253,"_18751":32965,"_15096":32966,"_1571":32967},[],"/docs/manual/integraciones/aws#device-shadow-y-automatización","Device Shadow y automatización",{"_7914":402,"_22115":383,"_5":22253,"_18751":32969,"_15096":32970,"_1571":32971},[],"/docs/manual/integraciones/aws#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_7914":403,"_22115":383,"_5":22253,"_18751":32973,"_15096":32974,"_1571":32975},[],"/docs/manual/integraciones/aws#políticas-de-aws-iot","Políticas de AWS IoT",{"_7914":404,"_22115":383,"_5":22253,"_18751":32977,"_15096":32978,"_1571":32979},[],"/docs/manual/integraciones/aws#solución-de-problemas","Solución de problemas",{"_7914":405,"_22115":383,"_18751":32981,"_5":22248,"_15096":383,"_1571":32982},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_7914":406,"_22115":383,"_18751":32984,"_5":22248,"_15096":383,"_1571":32985},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_7914":407,"_22115":383,"_18751":32987,"_5":22248,"_15096":383,"_1571":32988},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_7914":408,"_22115":383,"_18751":32990,"_5":22248,"_15096":32902,"_1571":32991},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_7914":409,"_22115":383,"_18751":32993,"_5":22248,"_15096":32902,"_1571":32994},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_7914":410,"_22115":383,"_18751":32996,"_5":22248,"_15096":32902,"_1571":32997},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_7914":411,"_22115":383,"_18751":32999,"_5":22248,"_15096":32902,"_1571":33000},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_7914":412,"_22115":383,"_18751":33002,"_5":22248,"_15096":32906,"_1571":33003},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_7914":413,"_22115":383,"_18751":33005,"_5":22248,"_15096":32910,"_1571":33006},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_7914":414,"_22115":383,"_18751":33008,"_5":22248,"_15096":32910,"_1571":33009},[],"Acción IAM",{"_7914":415,"_22115":383,"_18751":33011,"_5":22248,"_15096":32910,"_1571":33012},[],"Propósito",{"_7914":416,"_22115":383,"_18751":33014,"_5":22248,"_15096":32910,"_1571":33015},[],"`iot:GetRegistrationCode`",{"_7914":417,"_22115":383,"_18751":33017,"_5":22248,"_15096":32910,"_1571":33018},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_7914":418,"_22115":383,"_18751":33020,"_5":22248,"_15096":32910,"_1571":33021},[],"`iot:RegisterCACertificate`",{"_7914":419,"_22115":383,"_18751":33023,"_5":22248,"_15096":32910,"_1571":33024},[],"Registrar la CA en AWS IoT",{"_7914":420,"_22115":383,"_18751":33026,"_5":22248,"_15096":32910,"_1571":33027},[],"`iot:DescribeCACertificate`",{"_7914":421,"_22115":383,"_18751":33029,"_5":22248,"_15096":32910,"_1571":33030},[],"Consultar el estado del registro de la CA",{"_7914":422,"_22115":383,"_18751":33032,"_5":22248,"_15096":32910,"_1571":33033},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_7914":423,"_22115":383,"_18751":33035,"_5":22248,"_15096":32910,"_1571":33036},[],"Crear o actualizar Things en IoT Core",{"_7914":424,"_22115":383,"_18751":33038,"_5":22248,"_15096":32910,"_1571":33039},[],"`iot:RegisterThing`",{"_7914":425,"_22115":383,"_18751":33041,"_5":22248,"_15096":32910,"_1571":33042},[],"Aprovisionar Things mediante plantilla",{"_7914":426,"_22115":383,"_18751":33044,"_5":22248,"_15096":32910,"_1571":33045},[],"`iot:RegisterCertificate`",{"_7914":427,"_22115":383,"_18751":33047,"_5":22248,"_15096":32910,"_1571":33048},[],"Registrar certificados de dispositivo",{"_7914":428,"_22115":383,"_18751":33050,"_5":22248,"_15096":32910,"_1571":33051},[],"`iot:UpdateCertificate`",{"_7914":429,"_22115":383,"_18751":33053,"_5":22248,"_15096":32910,"_1571":33054},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_7914":430,"_22115":383,"_18751":33056,"_5":22248,"_15096":32910,"_1571":33057},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_7914":431,"_22115":383,"_18751":33059,"_5":22248,"_15096":32910,"_1571":33060},[],"Crear y adjuntar políticas IoT",{"_7914":432,"_22115":383,"_18751":33062,"_5":22248,"_15096":32910,"_1571":33063},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_7914":433,"_22115":383,"_18751":33065,"_5":22248,"_15096":32910,"_1571":33066},[],"Gestionar grupos de Things",{"_7914":434,"_22115":383,"_18751":33068,"_5":22248,"_15096":32910,"_1571":33069},[],"`iot:CreateProvisioningTemplate`",{"_7914":435,"_22115":383,"_18751":33071,"_5":22248,"_15096":32910,"_1571":33072},[],"Crear plantillas JITP",{"_7914":436,"_22115":383,"_18751":33074,"_5":22248,"_15096":32910,"_1571":33075},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_7914":437,"_22115":383,"_18751":33077,"_5":22248,"_15096":32910,"_1571":33078},[],"Leer y escribir el Device Shadow",{"_7914":438,"_22115":383,"_18751":33080,"_5":22248,"_15096":32910,"_1571":33081},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_7914":439,"_22115":383,"_18751":33083,"_5":22248,"_15096":32914,"_1571":33084},[],"Parámetro",{"_7914":440,"_22115":383,"_18751":33086,"_5":22248,"_15096":32914,"_1571":33087},[],"Tipo",{"_7914":441,"_22115":383,"_18751":33089,"_5":22248,"_15096":32914,"_1571":33090},[],"Requerido",{"_7914":442,"_22115":383,"_18751":33092,"_5":22248,"_15096":32914,"_1571":31956},[],{"_7914":443,"_22115":383,"_18751":33094,"_5":22248,"_15096":32914,"_1571":33095},[],"`connector_id`",{"_7914":444,"_22115":383,"_18751":33097,"_5":22248,"_15096":32914,"_1571":11523},[],{"_7914":445,"_22115":383,"_18751":33099,"_5":22248,"_15096":32914,"_1571":33100},[],"Sí",{"_7914":446,"_22115":383,"_18751":33102,"_5":22248,"_15096":32914,"_1571":33103},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_7914":447,"_22115":383,"_18751":33105,"_5":22248,"_15096":32914,"_1571":33106},[],"`aws_config.region`",{"_7914":448,"_22115":383,"_18751":33108,"_5":22248,"_15096":32914,"_1571":11523},[],{"_7914":449,"_22115":383,"_18751":33110,"_5":22248,"_15096":32914,"_1571":33100},[],{"_7914":450,"_22115":383,"_18751":33112,"_5":22248,"_15096":32914,"_1571":33113},[],"Región AWS donde opera el conector.",{"_7914":451,"_22115":383,"_18751":33115,"_5":22248,"_15096":32914,"_1571":33116},[],"`aws_config.auth_method`",{"_7914":452,"_22115":383,"_18751":33118,"_5":22248,"_15096":32914,"_1571":11523},[],{"_7914":453,"_22115":383,"_18751":33120,"_5":22248,"_15096":32914,"_1571":33100},[],{"_7914":454,"_22115":383,"_18751":33122,"_5":22248,"_15096":32914,"_1571":33123},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_7914":455,"_22115":383,"_18751":33125,"_5":22248,"_15096":32914,"_1571":33126},[],"`aws_config.access_key_id`",{"_7914":456,"_22115":383,"_18751":33128,"_5":22248,"_15096":32914,"_1571":11523},[],{"_7914":457,"_22115":383,"_18751":33130,"_5":22248,"_15096":32914,"_1571":33131},[],"Solo con `auth_method=static`",{"_7914":458,"_22115":383,"_18751":33133,"_5":22248,"_15096":32914,"_1571":33134},[],"Clave de acceso AWS.",{"_7914":459,"_22115":383,"_18751":33136,"_5":22248,"_15096":32914,"_1571":33137},[],"`aws_config.secret_access_key`",{"_7914":460,"_22115":383,"_18751":33139,"_5":22248,"_15096":32914,"_1571":11523},[],{"_7914":461,"_22115":383,"_18751":33141,"_5":22248,"_15096":32914,"_1571":33131},[],{"_7914":462,"_22115":383,"_18751":33143,"_5":22248,"_15096":32914,"_1571":33144},[],"Clave secreta AWS.",{"_7914":463,"_22115":383,"_18751":33146,"_5":22248,"_15096":32914,"_1571":33147},[],"`aws_config.session_token`",{"_7914":464,"_22115":383,"_18751":33149,"_5":22248,"_15096":32914,"_1571":11523},[],{"_7914":465,"_22115":383,"_18751":33151,"_5":22248,"_15096":32914,"_1571":33152},[],"No",{"_7914":466,"_22115":383,"_18751":33154,"_5":22248,"_15096":32914,"_1571":33155},[],"Token de sesión (con `auth_method=static`).",{"_7914":467,"_22115":383,"_18751":33157,"_5":22248,"_15096":32914,"_1571":33158},[],"`aws_config.role_arn`",{"_7914":468,"_22115":383,"_18751":33160,"_5":22248,"_15096":32914,"_1571":11523},[],{"_7914":469,"_22115":383,"_18751":33162,"_5":22248,"_15096":32914,"_1571":33163},[],"Solo con `auth_method=role`",{"_7914":470,"_22115":383,"_18751":33165,"_5":22248,"_15096":32914,"_1571":33166},[],"ARN del rol a asumir.",{"_7914":471,"_22115":383,"_18751":33168,"_5":22248,"_15096":32914,"_1571":33169},[],"`aws_config.endpoint_url`",{"_7914":472,"_22115":383,"_18751":33171,"_5":22248,"_15096":32914,"_1571":11523},[],{"_7914":473,"_22115":383,"_18751":33173,"_5":22248,"_15096":32914,"_1571":33152},[],{"_7914":474,"_22115":383,"_18751":33175,"_5":22248,"_15096":32914,"_1571":33176},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_7914":475,"_22115":383,"_18751":33178,"_5":22248,"_15096":32914,"_1571":33179},[],"`subscriber_event_bus`",{"_7914":476,"_22115":383,"_18751":33181,"_5":22248,"_15096":32914,"_1571":19056},[],{"_7914":477,"_22115":383,"_18751":33183,"_5":22248,"_15096":32914,"_1571":33100},[],{"_7914":478,"_22115":383,"_18751":33185,"_5":22248,"_15096":32914,"_1571":33186},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_7914":479,"_22115":383,"_18751":33188,"_5":22248,"_15096":32914,"_1571":33189},[],"`dms_manager_client`",{"_7914":480,"_22115":383,"_18751":33191,"_5":22248,"_15096":32914,"_1571":11523},[],{"_7914":481,"_22115":383,"_18751":33193,"_5":22248,"_15096":32914,"_1571":33100},[],{"_7914":482,"_22115":383,"_18751":33195,"_5":22248,"_15096":32914,"_1571":33196},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_7914":483,"_22115":383,"_18751":33198,"_5":22248,"_15096":32914,"_1571":33199},[],"`device_manager_client`",{"_7914":484,"_22115":383,"_18751":33201,"_5":22248,"_15096":32914,"_1571":11523},[],{"_7914":485,"_22115":383,"_18751":33203,"_5":22248,"_15096":32914,"_1571":33100},[],{"_7914":486,"_22115":383,"_18751":33205,"_5":22248,"_15096":32914,"_1571":33206},[],"URL HTTP del Device Manager de Lamassu.",{"_7914":487,"_22115":383,"_18751":33208,"_5":22248,"_15096":32914,"_1571":33209},[],"`ca_client`",{"_7914":488,"_22115":383,"_18751":33211,"_5":22248,"_15096":32914,"_1571":11523},[],{"_7914":489,"_22115":383,"_18751":33213,"_5":22248,"_15096":32914,"_1571":33100},[],{"_7914":490,"_22115":383,"_18751":33215,"_5":22248,"_15096":32914,"_1571":33216},[],"URL HTTP del servicio de CA de Lamassu.",{"_7914":491,"_22115":383,"_18751":33218,"_5":22248,"_15096":32918,"_1571":33219},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_7914":492,"_22115":383,"_18751":33221,"_5":22248,"_15096":32922,"_1571":33222},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_7914":493,"_22115":383,"_18751":33224,"_5":22248,"_15096":32922,"_1571":33225},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_7914":494,"_22115":383,"_18751":33227,"_5":22248,"_15096":32926,"_1571":33228},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_7914":495,"_22115":383,"_18751":33230,"_5":22248,"_15096":32926,"_1571":33231},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_7914":496,"_22115":383,"_18751":33233,"_5":22248,"_15096":32926,"_1571":33234},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_7914":497,"_22115":383,"_18751":33236,"_5":22248,"_15096":32926,"_1571":33237},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_7914":498,"_22115":383,"_18751":33239,"_5":22248,"_15096":32926,"_1571":33240},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_7914":499,"_22115":383,"_18751":33242,"_5":22248,"_15096":32926,"_1571":33243},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_7914":500,"_22115":383,"_18751":33245,"_5":22248,"_15096":32930,"_1571":33246},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_7914":501,"_22115":383,"_18751":33248,"_5":22248,"_15096":32934,"_1571":33249},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_7914":502,"_22115":383,"_18751":33251,"_5":22248,"_15096":32934,"_1571":33252},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_7914":503,"_22115":383,"_18751":33254,"_5":22248,"_15096":32938,"_1571":33255},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_7914":504,"_22115":383,"_18751":33257,"_5":22248,"_15096":32942,"_1571":33258},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_7914":505,"_22115":383,"_18751":33260,"_5":22248,"_15096":32942,"_1571":33261},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_7914":506,"_22115":383,"_18751":33263,"_5":22248,"_15096":32942,"_1571":33264},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_7914":507,"_22115":383,"_18751":33266,"_5":22248,"_15096":32942,"_1571":33267},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_7914":508,"_22115":383,"_18751":33269,"_5":22248,"_15096":32942,"_1571":33270},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_7914":509,"_22115":383,"_18751":33272,"_5":22248,"_15096":32942,"_1571":33273},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_7914":510,"_22115":383,"_18751":33275,"_5":22248,"_15096":32946,"_1571":33276},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_7914":511,"_22115":383,"_18751":33278,"_5":22248,"_15096":32946,"_1571":33279},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_7914":512,"_22115":383,"_18751":33281,"_5":22248,"_15096":32946,"_1571":33282},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_7914":513,"_22115":383,"_18751":33284,"_5":22248,"_15096":32950,"_1571":33285},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_7914":514,"_22115":383,"_18751":33287,"_5":22248,"_15096":32950,"_1571":33288},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_7914":515,"_22115":383,"_18751":33290,"_5":22248,"_15096":32950,"_1571":33291},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_7914":516,"_22115":383,"_18751":33293,"_5":22248,"_15096":32954,"_1571":33294},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_7914":517,"_22115":383,"_18751":33296,"_5":22248,"_15096":32954,"_1571":33297},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_7914":518,"_22115":383,"_18751":33299,"_5":22248,"_15096":32954,"_1571":33300},[],"Para que el flujo JITP funcione correctamente:",{"_7914":519,"_22115":383,"_18751":33302,"_5":22248,"_15096":32954,"_1571":33303},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_7914":520,"_22115":383,"_18751":33305,"_5":22248,"_15096":32954,"_1571":33306},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_7914":521,"_22115":383,"_18751":33308,"_5":22248,"_15096":32954,"_1571":33309},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_7914":522,"_22115":383,"_18751":33311,"_5":22248,"_15096":32954,"_1571":33312},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_7914":523,"_22115":383,"_18751":33314,"_5":22248,"_15096":32958,"_1571":33315},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_7914":524,"_22115":383,"_18751":33317,"_5":22248,"_15096":32958,"_1571":33318},[],"Estado en Lamassu",{"_7914":525,"_22115":383,"_18751":33320,"_5":22248,"_15096":32958,"_1571":33321},[],"Razón de revocación",{"_7914":526,"_22115":383,"_18751":33323,"_5":22248,"_15096":32958,"_1571":33324},[],"Estado en AWS IoT Core",{"_7914":527,"_22115":383,"_18751":33326,"_5":22248,"_15096":32958,"_1571":33327},[],"`Active`",{"_7914":528,"_22115":383,"_18751":33329,"_5":22248,"_15096":32958,"_1571":33330},[],"—",{"_7914":529,"_22115":383,"_18751":33332,"_5":22248,"_15096":32958,"_1571":33333},[],"`ACTIVE`",{"_7914":530,"_22115":383,"_18751":33335,"_5":22248,"_15096":32958,"_1571":33336},[],"`Revoked`",{"_7914":531,"_22115":383,"_18751":33338,"_5":22248,"_15096":32958,"_1571":33339},[],"`certificateHold`",{"_7914":532,"_22115":383,"_18751":33341,"_5":22248,"_15096":32958,"_1571":33342},[],"`INACTIVE`",{"_7914":533,"_22115":383,"_18751":33344,"_5":22248,"_15096":32958,"_1571":33336},[],{"_7914":534,"_22115":383,"_18751":33346,"_5":22248,"_15096":32958,"_1571":33347},[],"Cualquier otra razón",{"_7914":535,"_22115":383,"_18751":33349,"_5":22248,"_15096":32958,"_1571":33350},[],"`REVOKED`",{"_7914":536,"_22115":383,"_18751":33352,"_5":22248,"_15096":32958,"_1571":33353},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_7914":537,"_22115":383,"_18751":33355,"_5":22248,"_15096":32962,"_1571":33356},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_7914":538,"_22115":383,"_18751":33358,"_5":22248,"_15096":32962,"_1571":33359},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_7914":539,"_22115":383,"_18751":33361,"_5":22248,"_15096":32962,"_1571":33362},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_7914":540,"_22115":383,"_18751":33364,"_5":22248,"_15096":32966,"_1571":33365},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_7914":541,"_22115":383,"_18751":33367,"_5":22248,"_15096":32966,"_1571":33368},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_7914":542,"_22115":383,"_18751":33370,"_5":22248,"_15096":32970,"_1571":33371},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_7914":543,"_22115":383,"_18751":33373,"_5":22248,"_15096":32970,"_1571":33374},[],"Existen dos tipos de acciones:",{"_7914":544,"_22115":383,"_18751":33376,"_5":22248,"_15096":32970,"_1571":33377},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_7914":545,"_22115":383,"_18751":33379,"_5":22248,"_15096":32970,"_1571":33380},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_7914":546,"_22115":383,"_18751":33382,"_5":22248,"_15096":32970,"_1571":33383},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_7914":547,"_22115":383,"_18751":33385,"_5":22248,"_15096":32974,"_1571":33386},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_7914":548,"_22115":383,"_18751":33388,"_5":22248,"_15096":32974,"_1571":33389},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_7914":549,"_22115":383,"_18751":33391,"_5":22248,"_15096":32974,"_1571":33392},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_7914":550,"_22115":383,"_18751":33394,"_5":22248,"_15096":32978,"_1571":33395},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_7914":551,"_22115":383,"_18751":33397,"_5":22248,"_15096":32978,"_1571":33398},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_7914":552,"_22115":383,"_18751":33400,"_5":22248,"_15096":32978,"_1571":33401},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_7914":553,"_22115":383,"_18751":33403,"_5":22248,"_15096":32978,"_1571":33404},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_7914":554,"_22115":383,"_18751":33406,"_5":22248,"_15096":32978,"_1571":33407},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_7914":555,"_22115":383,"_18751":33409,"_5":22248,"_15096":32978,"_1571":33410},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_7914":556,"_22115":383,"_18751":33412,"_5":22248,"_15096":32978,"_1571":33413},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_7914":557,"_22115":383,"_18751":33415,"_5":22248,"_15096":32978,"_1571":33416},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_7914":558,"_22115":383,"_18751":33418,"_5":22248,"_15096":32978,"_1571":33419},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_7914":559,"_22115":383,"_18751":33421,"_5":22248,"_15096":32978,"_1571":33422},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_7914":560,"_22115":383,"_18751":33424,"_5":22248,"_15096":32978,"_1571":33425},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_7914":561,"_22115":383,"_18751":33427,"_5":22248,"_15096":32978,"_1571":33428},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_7914":562,"_22115":383,"_18751":33430,"_5":22248,"_15096":32978,"_1571":33431},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_7914":563,"_22115":383,"_18751":33433,"_5":22248,"_15096":32978,"_1571":33434},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_7914":564,"_22115":383,"_18751":33436,"_5":22248,"_15096":32978,"_1571":33437},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_7914":565,"_22115":383,"_18751":33439,"_5":22248,"_15096":32978,"_1571":33440},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_7914":566,"_22115":383,"_18751":33442,"_5":22248,"_15096":32978,"_1571":33443},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_7914":567,"_22115":383,"_18751":33445,"_5":22248,"_15096":32978,"_1571":33446},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_7914":568,"_22115":383,"_18751":33448,"_5":22248,"_15096":32978,"_1571":33449},[],"<Card title=\"Configurar un DMS\" href=\"/docs/manual/servicios-core/ra\" />",{"_7914":569,"_22115":383,"_18751":33451,"_5":22248,"_15096":32978,"_1571":33452},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/manual/servicios-core/est\" />",{"_7914":570,"_22115":383,"_18751":33454,"_5":22248,"_15096":32978,"_1571":33455},[],"<Card title=\"Gestión de certificados\" href=\"/docs/manual/servicios-core/certificates\" />",{"_7914":571,"_22115":571,"_5":22243,"_1571":33457,"_22256":33458,"_18751":33459,"_15096":571},"[Alerts] Alertas y Suscripciones",[31753,32852,32861],[],{"_7914":572,"_22115":571,"_18751":33461,"_5":22248,"_15096":571,"_1571":33462},[],"Monitorización proactiva mediante eventos y suscripciones",{"_7914":573,"_22115":571,"_5":22253,"_18751":33464,"_15096":33465,"_1571":33466},[],"/docs/manual/servicios-core/alerts#alertas","Alertas",{"_7914":574,"_22115":571,"_5":22253,"_18751":33468,"_15096":33469,"_1571":33470},[],"/docs/manual/servicios-core/alerts#eventos-y-suscripciones","Eventos y Suscripciones",{"_7914":575,"_22115":571,"_5":22253,"_18751":33472,"_15096":33473,"_1571":33474},[],"/docs/manual/servicios-core/alerts#gestión-de-suscripciones","Gestión de Suscripciones",{"_7914":576,"_22115":571,"_5":22253,"_18751":33476,"_15096":33477,"_1571":33478},[],"/docs/manual/servicios-core/alerts#filtros-y-condiciones","Filtros y condiciones",{"_7914":577,"_22115":571,"_5":22253,"_18751":33480,"_15096":33481,"_1571":33482},[],"/docs/manual/servicios-core/alerts#confirmación-de-la-suscripción","Confirmación de la suscripción",{"_7914":578,"_22115":571,"_5":22253,"_18751":33484,"_15096":33485,"_1571":33486},[],"/docs/manual/servicios-core/alerts#gestión-de-suscripciones-existentes","Gestión de Suscripciones Existentes",{"_7914":579,"_22115":571,"_5":22253,"_18751":33488,"_15096":33489,"_1571":33490},[],"/docs/manual/servicios-core/alerts#catálogo-de-eventos-del-sistema","Catálogo de Eventos del Sistema",{"_7914":580,"_22115":571,"_18751":33492,"_5":22248,"_15096":33465,"_1571":33493},[],"La funcionalidad de **Alertas** en Lamassu IoT es una herramienta avanzada para la monitorización y la observación del estado de la PKI. Va más allá de la simple visualización, permitiendo a los usuarios **reaccionar de forma proactiva y automatizada** a los eventos que ocurren en la infraestructura. Esta capacidad es crucial en entornos de IoT, donde el número de dispositivos y la frecuencia de las operaciones hacen inviable la monitorización manual. A través de la gestión de suscripciones, los administradores pueden asegurarse de que eventos críticos, como la revocación de un certificado o la detección de un intento de registro fallido, no pasen desapercibidos, lo que mejora la seguridad y la resiliencia del sistema.",{"_7914":581,"_22115":571,"_18751":33495,"_5":22248,"_15096":33469,"_1571":33496},[],"La página principal de alertas presenta una lista exhaustiva de todos los **tipos de eventos** que pueden ser generados por la PKI de Lamassu IoT. Estos eventos cubren un amplio espectro de actividades, desde operaciones de ciclo de vida de certificados y dispositivos hasta cambios de estado en las RA. Para cada tipo de evento, la interfaz proporciona un conjunto de métricas clave que facilitan la toma de decisiones:",{"_7914":582,"_22115":571,"_18751":33498,"_5":22248,"_15096":33469,"_1571":33499},[],"**Last Seen**: Muestra cuándo ocurrió la última instancia del evento. Esto ayuda a identificar si un evento es recurrente o si ha ocurrido recientemente, lo cual es fundamental para el diagnóstico.",{"_7914":583,"_22115":571,"_18751":33501,"_5":22248,"_15096":33469,"_1571":33502},[],"**Counter**: Indica el número total de veces que el evento ha sido registrado en el sistema. Un contador alto puede señalar una tendencia, un problema subyacente en un dispositivo o una configuración errónea.",{"_7914":584,"_22115":571,"_18751":33504,"_5":22248,"_15096":33469,"_1571":33505},[],"**Subscriptions**: Informa si ya existen suscripciones activas para ese evento, evitando la creación de suscripciones duplicadas y proporcionando una visión general de la monitorización ya implementada.",{"_7914":585,"_22115":571,"_18751":33507,"_5":22248,"_15096":33469,"_1571":33508},[],"**Actions**: El botón **Subscribe** permite iniciar el proceso de creación de una nueva suscripción, adaptada a las necesidades específicas del usuario o equipo.",{"_7914":586,"_22115":571,"_18751":33510,"_5":22248,"_15096":33469,"_1571":33511},[],"Adicionalmente, al expandir la información de cada evento, se presenta un **ejemplo de la estructura de datos JSON** de la última instancia registrada. Esta información es de gran valor, ya que permite a los desarrolladores y administradores entender con precisión el esquema de la notificación y cómo procesarla en sistemas externos, como un sistema de gestión de incidentes o una aplicación de automatización.",{"_7914":587,"_22115":571,"_18751":33513,"_5":22248,"_15096":33473,"_1571":33514},[],"Para cada evento, se puede crear una suscripción a la que se envían notificaciones cuando el evento ocurre. Este proceso permite a los administradores del sistema personalizar qué eventos monitorizan y cómo son notificados. La configuración de las suscripciones, incluyendo el destino de las notificaciones, se gestiona de forma individual para cada tipo de evento.",{"_7914":588,"_22115":571,"_18751":33516,"_5":22248,"_15096":33473,"_1571":33517},[],"Al pulsar sobre el botón **Subscribe** se abre un modal de configuración que permite seleccionar uno de los tres mecanismos de notificación disponibles en Lamassu IoT.",{"_7914":589,"_22115":571,"_18751":33519,"_5":22248,"_15096":33473,"_1571":33520},[],"**Email Notification**: Envía una notificación por correo electrónico a una dirección específica cada vez que el evento se registra. Para configurar este método, solo es necesario proporcionar la dirección de correo electrónico de destino.",{"_7914":590,"_22115":571,"_18751":33522,"_5":22248,"_15096":33473,"_1571":33523},[],"**Microsoft Teams Webhook**: Utiliza un webhook para enviar una notificación al canal de Microsoft Teams configurado, lo que permite integrar las alertas directamente en los flujos de trabajo de colaboración. Se debe proporcionar un nombre para la suscripción y la URL del webhook de Microsoft Teams.",{"_7914":591,"_22115":571,"_18751":33525,"_5":22248,"_15096":33473,"_1571":33526},[],"**Webhook**: Envía una notificación en formato JSON a una URL de webhook personalizada, lo que permite integrar las alertas con cualquier servicio o aplicación que soporte este protocolo. Para este mecanismo, se debe especificar un nombre, el **Método HTTP** (siempre **POST** o **PUT**) y la URL de destino. El documento JSON del evento se entregará como el cuerpo de la solicitud HTTP.",{"_7914":592,"_22115":571,"_18751":33528,"_5":22248,"_15096":33477,"_1571":33529},[],"Después de seleccionar el mecanismo de notificación, se puede establecer un filtro para determinar las condiciones que deben cumplirse para que el evento sea notificado. Esto permite un control más granular y evita recibir notificaciones irrelevantes. Los formatos de filtro disponibles son:",{"_7914":593,"_22115":571,"_18751":33531,"_5":22248,"_15096":33477,"_1571":33532},[],"**None**: No se aplica ningún filtro. Se enviarán notificaciones para todas las instancias del evento.",{"_7914":594,"_22115":571,"_18751":33534,"_5":22248,"_15096":33477,"_1571":33535},[],"**JSON Path**: Utiliza la sintaxis de JSON Path para evaluar una condición sobre un campo específico del evento JSON.",{"_7914":595,"_22115":571,"_18751":33537,"_5":22248,"_15096":33477,"_1571":33538},[],"**JSON Schema**: Permite aplicar un esquema JSON para validar el evento. Las notificaciones solo se enviarán si el evento cumple con el esquema definido. Esto es útil para asegurar que solo se procesen eventos con un formato de datos esperado y consistente.",{"_7914":596,"_22115":571,"_18751":33540,"_5":22248,"_15096":33477,"_1571":33541},[],"**Javascript**: Permite escribir una función de JavaScript personalizada para evaluar condiciones complejas sobre el evento JSON. Por ejemplo, la función `function (event) { return event.data.status == \"NO_IDENTITY\"; }` podría usarse para notificar solo cuando el estado de un dispositivo cambia a \"No Identity\". Esto ofrece la mayor flexibilidad, ya que se pueden aplicar lógicas avanzadas para filtrar los eventos antes de que se envíen las notificaciones.",{"_7914":597,"_22115":571,"_18751":33543,"_5":22248,"_15096":33481,"_1571":33544},[],"El último paso del proceso es la **confirmación**. Una vez que se ha configurado el canal de notificación y el filtro (si corresponde), la interfaz muestra un resumen de la suscripción. Aquí puedes revisar el tipo de evento, el canal de notificación seleccionado y la condición del filtro antes de confirmar.",{"_7914":598,"_22115":571,"_18751":33546,"_5":22248,"_15096":33481,"_1571":33547},[],"Al hacer clic en **Confirm Subscription**, la suscripción se activa y Lamassu IoT comenzará a enviar notificaciones basadas en la configuración que has establecido.",{"_7914":599,"_22115":571,"_18751":33549,"_5":22248,"_15096":33485,"_1571":33550},[],"Para gestionar una suscripción que ya está activa, simplemente selecciónala en el listado de la página principal de alertas. Al hacerlo, se abrirá un modal de **Subscription Details** que muestra toda la información de la suscripción. Desde esta ventana, se pueden realizar las siguientes acciones:",{"_7914":600,"_22115":571,"_18751":33552,"_5":22248,"_15096":33485,"_1571":33553},[],"**Ver detalles**: Muestra información completa sobre la suscripción, incluyendo su tipo de evento, el canal de notificación, los detalles de contacto (como la dirección de correo electrónico) y las condiciones de filtrado aplicadas.",{"_7914":601,"_22115":571,"_18751":33555,"_5":22248,"_15096":33485,"_1571":33556},[],"**Editar**: Permite modificar la configuración de la suscripción, como el canal de notificación o el filtro.",{"_7914":602,"_22115":571,"_18751":33558,"_5":22248,"_15096":33485,"_1571":33559},[],"**Anular suscripción (Unsubscribe)**: Desactiva y elimina la suscripción. Esta acción es útil cuando una alerta ya no es necesaria.",{"_7914":603,"_22115":571,"_18751":33561,"_5":22248,"_15096":33489,"_1571":33562},[],"La siguiente tabla resume los eventos que pueden ser generados por la plataforma Lamassu IoT, clasificados por el componente que los origina.",{"_7914":604,"_22115":571,"_18751":33564,"_5":22248,"_15096":33489,"_1571":33565},[],"Evento",{"_7914":605,"_22115":571,"_18751":33567,"_5":22248,"_15096":33489,"_1571":31956},[],{"_7914":606,"_22115":571,"_18751":33569,"_5":22248,"_15096":33489,"_1571":33570},[],"**ca.create**",{"_7914":607,"_22115":571,"_18751":33572,"_5":22248,"_15096":33489,"_1571":33573},[],"Creación de una CA",{"_7914":608,"_22115":571,"_18751":33575,"_5":22248,"_15096":33489,"_1571":33576},[],"**ca.import**",{"_7914":609,"_22115":571,"_18751":33578,"_5":22248,"_15096":33489,"_1571":33579},[],"Importación de una CA",{"_7914":610,"_22115":571,"_18751":33581,"_5":22248,"_15096":33489,"_1571":33582},[],"**ca.profile.update**",{"_7914":611,"_22115":571,"_18751":33584,"_5":22248,"_15096":33489,"_1571":33585},[],"Actualización de perfil de CA",{"_7914":612,"_22115":571,"_18751":33587,"_5":22248,"_15096":33489,"_1571":33588},[],"**ca.reissue**",{"_7914":613,"_22115":571,"_18751":33590,"_5":22248,"_15096":33489,"_1571":33591},[],"Reemisión de una CA",{"_7914":614,"_22115":571,"_18751":33593,"_5":22248,"_15096":33489,"_1571":33594},[],"**ca.sign.certificate**",{"_7914":615,"_22115":571,"_18751":33596,"_5":22248,"_15096":33489,"_1571":33597},[],"Firma / emisión de certificado",{"_7914":616,"_22115":571,"_18751":33599,"_5":22248,"_15096":33489,"_1571":33600},[],"**ca.signature.sign**",{"_7914":617,"_22115":571,"_18751":33602,"_5":22248,"_15096":33489,"_1571":33603},[],"Operación de firma criptográfica",{"_7914":618,"_22115":571,"_18751":33605,"_5":22248,"_15096":33489,"_1571":33606},[],"**ca.delete**",{"_7914":619,"_22115":571,"_18751":33608,"_5":22248,"_15096":33489,"_1571":33609},[],"Eliminación de una CA",{"_7914":620,"_22115":571,"_18751":33611,"_5":22248,"_15096":33489,"_1571":33612},[],"**certificate.delete**",{"_7914":621,"_22115":571,"_18751":33614,"_5":22248,"_15096":33489,"_1571":33615},[],"Eliminación de un certificado",{"_7914":622,"_22115":571,"_18751":33617,"_5":22248,"_15096":33489,"_1571":33618},[],"**profile.create**",{"_7914":623,"_22115":571,"_18751":33620,"_5":22248,"_15096":33489,"_1571":33621},[],"Creación de perfil de emisión",{"_7914":624,"_22115":571,"_18751":33623,"_5":22248,"_15096":33489,"_1571":33624},[],"**profile.update**",{"_7914":625,"_22115":571,"_18751":33626,"_5":22248,"_15096":33489,"_1571":33627},[],"Actualización de perfil de emisión",{"_7914":626,"_22115":571,"_18751":33629,"_5":22248,"_15096":33489,"_1571":33630},[],"**profile.delete**",{"_7914":627,"_22115":571,"_18751":33632,"_5":22248,"_15096":33489,"_1571":33633},[],"Eliminación de perfil de emisión",{"_7914":628,"_22115":571,"_18751":33635,"_5":22248,"_15096":33489,"_1571":33636},[],"**dms.create**",{"_7914":629,"_22115":571,"_18751":33638,"_5":22248,"_15096":33489,"_1571":33639},[],"Creación de un DMS",{"_7914":630,"_22115":571,"_18751":33641,"_5":22248,"_15096":33489,"_1571":33642},[],"**dms.update**",{"_7914":631,"_22115":571,"_18751":33644,"_5":22248,"_15096":33489,"_1571":33645},[],"Actualización de un DMS",{"_7914":632,"_22115":571,"_18751":33647,"_5":22248,"_15096":33489,"_1571":33648},[],"**dms.delete**",{"_7914":633,"_22115":571,"_18751":33650,"_5":22248,"_15096":33489,"_1571":33651},[],"Eliminación de un DMS",{"_7914":634,"_22115":571,"_18751":33653,"_5":22248,"_15096":33489,"_1571":33654},[],"**dms.enroll**",{"_7914":635,"_22115":571,"_18751":33656,"_5":22248,"_15096":33489,"_1571":33657},[],"Inscripción (enroll) de dispositivo",{"_7914":636,"_22115":571,"_18751":33659,"_5":22248,"_15096":33489,"_1571":33660},[],"**dms.reenroll**",{"_7914":637,"_22115":571,"_18751":33662,"_5":22248,"_15096":33489,"_1571":33663},[],"Re-inscripción (reenroll) de dispositivo",{"_7914":638,"_22115":571,"_18751":33665,"_5":22248,"_15096":33489,"_1571":33666},[],"**dms.bind-device-id**",{"_7914":639,"_22115":571,"_18751":33668,"_5":22248,"_15096":33489,"_1571":33669},[],"Asociación de identidad a dispositivo",{"_7914":640,"_22115":571,"_18751":33671,"_5":22248,"_15096":33489,"_1571":33672},[],"**device.create**",{"_7914":641,"_22115":571,"_18751":33674,"_5":22248,"_15096":33489,"_1571":33675},[],"Creación de dispositivo",{"_7914":642,"_22115":571,"_18751":33677,"_5":22248,"_15096":33489,"_1571":33678},[],"**device.identity.update**",{"_7914":643,"_22115":571,"_18751":33680,"_5":22248,"_15096":33489,"_1571":33681},[],"Actualización de identidad del dispositivo",{"_7914":644,"_22115":571,"_18751":33683,"_5":22248,"_15096":33489,"_1571":33684},[],"**device.status.update**",{"_7914":645,"_22115":571,"_18751":33686,"_5":22248,"_15096":33489,"_1571":33687},[],"Cambio de estado del dispositivo",{"_7914":646,"_22115":571,"_18751":33689,"_5":22248,"_15096":33489,"_1571":33690},[],"**device.metadata.update**",{"_7914":647,"_22115":571,"_18751":33692,"_5":22248,"_15096":33489,"_1571":33693},[],"Actualización de metadatos del dispositivo",{"_7914":648,"_22115":571,"_18751":33695,"_5":22248,"_15096":33489,"_1571":33696},[],"**device.delete**",{"_7914":649,"_22115":571,"_18751":33698,"_5":22248,"_15096":33489,"_1571":33699},[],"Eliminación de un dispositivo",{"_7914":650,"_22115":571,"_18751":33701,"_5":22248,"_15096":33489,"_1571":33702},[],"**va.role.crl.create**",{"_7914":651,"_22115":571,"_18751":33704,"_5":22248,"_15096":33489,"_1571":33705},[],"Cálculo/creación de CRL",{"_7914":652,"_22115":571,"_18751":33707,"_5":22248,"_15096":33489,"_1571":33708},[],"**kms.create**",{"_7914":653,"_22115":571,"_18751":33710,"_5":22248,"_15096":33489,"_1571":33711},[],"Creación de clave en KMS",{"_7914":654,"_22115":571,"_18751":33713,"_5":22248,"_15096":33489,"_1571":33714},[],"**kms.import**",{"_7914":655,"_22115":571,"_18751":33716,"_5":22248,"_15096":33489,"_1571":33717},[],"Importación de una clave KMS",{"_7914":656,"_22115":571,"_18751":33719,"_5":22248,"_15096":33489,"_1571":33720},[],"**kms.update.metadata**",{"_7914":657,"_22115":571,"_18751":33722,"_5":22248,"_15096":33489,"_1571":33723},[],"Actualización de metadatos de clave KMS",{"_7914":658,"_22115":571,"_18751":33725,"_5":22248,"_15096":33489,"_1571":33726},[],"**kms.update.aliases**",{"_7914":659,"_22115":571,"_18751":33728,"_5":22248,"_15096":33489,"_1571":33729},[],"Actualización de alias de clave KMS",{"_7914":660,"_22115":571,"_18751":33731,"_5":22248,"_15096":33489,"_1571":33732},[],"**kms.update.name**",{"_7914":661,"_22115":571,"_18751":33734,"_5":22248,"_15096":33489,"_1571":33735},[],"Cambio de nombre de una clave KMS",{"_7914":662,"_22115":571,"_18751":33737,"_5":22248,"_15096":33489,"_1571":33738},[],"**kms.update.tags**",{"_7914":663,"_22115":571,"_18751":33740,"_5":22248,"_15096":33489,"_1571":33741},[],"Actualización de etiquetas (tags) de clave KMS",{"_7914":664,"_22115":571,"_18751":33743,"_5":22248,"_15096":33489,"_1571":33744},[],"**kms.delete**",{"_7914":665,"_22115":571,"_18751":33746,"_5":22248,"_15096":33489,"_1571":33747},[],"Eliminación de una clave KMS",{"_7914":666,"_22115":571,"_18751":33749,"_5":22248,"_15096":33489,"_1571":33750},[],"**kms.sign.message**",{"_7914":667,"_22115":571,"_18751":33752,"_5":22248,"_15096":33489,"_1571":33753},[],"Firma de un mensaje con clave KMS",{"_7914":668,"_22115":571,"_18751":33755,"_5":22248,"_15096":33489,"_1571":33756},[],"**kms.verify.signature**",{"_7914":669,"_22115":571,"_18751":33758,"_5":22248,"_15096":33489,"_1571":33759},[],"Verificación de firma con clave KMS",{"_7914":670,"_22115":670,"_5":22243,"_1571":33761,"_22256":33762,"_18751":33763,"_15096":670},"[CA] Gestión de Entidades de Confianza",[31753,32852,32861],[],{"_7914":671,"_22115":670,"_18751":33765,"_5":22248,"_15096":670,"_1571":33766},[],"Creación y gestión de Autoridades de Certificación en Lamassu IoT",{"_7914":672,"_22115":670,"_5":22253,"_18751":33768,"_15096":33769,"_1571":33770},[],"/docs/manual/servicios-core/cas#gestión-de-entidades-de-confianza","Gestión de entidades de confianza",{"_7914":673,"_22115":670,"_5":22253,"_18751":33772,"_15096":33773,"_1571":33774},[],"/docs/manual/servicios-core/cas#creación-de-entidades-de-certificación","Creación de entidades de certificación",{"_7914":674,"_22115":670,"_5":22253,"_18751":33776,"_15096":33777,"_1571":33778},[],"/docs/manual/servicios-core/cas#creación-de-una-nueva-autoridad-de-certificación","Creación de una nueva autoridad de certificación",{"_7914":675,"_22115":670,"_5":22253,"_18751":33780,"_15096":33781,"_1571":33782},[],"/docs/manual/servicios-core/cas#creación-de-cas-a-partir-de-claves-del-kms","Creación de CAs a partir de claves del KMS",{"_7914":676,"_22115":670,"_5":22253,"_18751":33784,"_15096":33785,"_1571":33786},[],"/docs/manual/servicios-core/cas#importación-de-autoridades-de-certificación","Importación de autoridades de certificación",{"_7914":677,"_22115":670,"_5":22253,"_18751":33788,"_15096":33789,"_1571":33790},[],"/docs/manual/servicios-core/cas#operando-con-entidades-de-confianza","Operando con entidades de confianza",{"_7914":678,"_22115":670,"_5":22253,"_18751":33792,"_15096":33793,"_1571":33794},[],"/docs/manual/servicios-core/cas#visualización-de-autoridades-de-certificación","Visualización de autoridades de certificación",{"_7914":679,"_22115":670,"_5":22253,"_18751":33796,"_15096":33797,"_1571":33798},[],"/docs/manual/servicios-core/cas#emisión-de-certificados","Emisión de certificados",{"_7914":680,"_22115":670,"_5":22253,"_18751":33800,"_15096":33801,"_1571":33802},[],"/docs/manual/servicios-core/cas#revocación-de-cas-y-certificados","Revocación de CAs y certificados",{"_7914":681,"_22115":670,"_18751":33804,"_5":22248,"_15096":33773,"_1571":33805},[],"Para acceder a la creación de nuevas entidades certificación se debe acceder la opción de entidades de certificación del menú lateral y luego seleccionar la acción de creación de nueva CA.",{"_7914":682,"_22115":670,"_18751":33807,"_5":22248,"_15096":33773,"_1571":33808},[],"Actualmente hay disponibles 3 acciones:",{"_7914":683,"_22115":670,"_18751":33810,"_5":22248,"_15096":33773,"_1571":33811},[],"**Creación de una nueva autoridad de certificación**, esta acción generará un nuevo par de claves para soportar la nueva autoridad de certificación.",{"_7914":684,"_22115":670,"_18751":33813,"_5":22248,"_15096":33773,"_1571":33814},[],"**Importar una nueva autoridad de certificación generada externamente**, permite importar en Lamassu una autoridad de certificación, cuyo par de claves ha sido generado de manera externa.",{"_7914":685,"_22115":670,"_18751":33816,"_5":22248,"_15096":33773,"_1571":33817},[],"**Importar un certificado de autoridad de certificación sin clave privada**, en este caso se importa la CA para poder usarla en procesos de validación y no como fuente de nuevos certificados gestionados por Lamassu.",{"_7914":686,"_22115":670,"_18751":33819,"_5":22248,"_15096":33777,"_1571":33820},[],"La creación de una Autoridad de Certificación (CA) es un proceso fundamental en el establecimiento de una infraestructura de clave pública (PKI). Lamassu IoT permite provisionar tanto autoridades raíz como intermedias mediante la generación automática de pares de claves criptográficas que son gestionados de forma segura por el sistema integrado de gestión de claves.",{"_7914":687,"_22115":670,"_18751":33822,"_5":22248,"_15096":33777,"_1571":33823},[],"En el formulario de creación se definen los siguientes bloques de configuración.",{"_7914":688,"_22115":670,"_18751":33825,"_5":22248,"_15096":33777,"_1571":33826},[],"**Motor criptográfico**",{"_7914":689,"_22115":670,"_18751":33828,"_5":22248,"_15096":33777,"_1571":33829},[],"**Selector:** Desplegable con motores disponibles, ofrece los configurados en el sistema.",{"_7914":690,"_22115":670,"_18751":33831,"_5":22248,"_15096":33777,"_1571":33832},[],"**Ejemplo mostrado:** go1.24.3",{"_7914":691,"_22115":670,"_18751":33834,"_5":22248,"_15096":33777,"_1571":33835},[],"**Función:** Permite seleccionar el motor criptográfico deseado",{"_7914":692,"_22115":670,"_18751":33837,"_5":22248,"_15096":33777,"_1571":33838},[],"**Parámetros de clave**",{"_7914":693,"_22115":670,"_18751":33840,"_5":22248,"_15096":33777,"_1571":33841},[],"**Key Type:** RSA / EC (Elliptic Curve)",{"_7914":694,"_22115":670,"_18751":33843,"_5":22248,"_15096":33777,"_1571":33844},[],"**Key Size:**",{"_7914":695,"_22115":670,"_18751":33846,"_5":22248,"_15096":33777,"_1571":33847},[],"RSA: 1024, 2048, 3072, 4096 bits",{"_7914":696,"_22115":670,"_18751":33849,"_5":22248,"_15096":33777,"_1571":33850},[],"EC: P-256, P-384, P-521",{"_7914":697,"_22115":670,"_18751":33852,"_5":22248,"_15096":33777,"_1571":33853},[],"**Recomendado:** EC P-384",{"_7914":698,"_22115":670,"_18751":33855,"_5":22248,"_15096":33777,"_1571":33856},[],"**Perfil de emisión del certificado de la CA**",{"_7914":699,"_22115":670,"_18751":33858,"_5":22248,"_15096":33777,"_1571":33859},[],"Aquí se puede seleccionar un perfil existente o definir uno en línea para la operación. Ese perfil permite especificar la duración de la CA que se está creando y los `Key Usage` y `Extended Key Usage` del certificado de soporte.",{"_7914":700,"_22115":670,"_18751":33861,"_5":22248,"_15096":33777,"_1571":33862},[],"Si no se proporciona ningún perfil se aplicará uno por defecto con los usos de clave básicos.",{"_7914":701,"_22115":670,"_18751":33864,"_5":22248,"_15096":33777,"_1571":33865},[],"**Configuración de la CA**",{"_7914":702,"_22115":670,"_18751":33867,"_5":22248,"_15096":33777,"_1571":33868},[],"**Tipo de CA**",{"_7914":703,"_22115":670,"_18751":33870,"_5":22248,"_15096":33777,"_1571":33871},[],"**Root CA:** Autoridad raíz autofirmada",{"_7914":704,"_22115":670,"_18751":33873,"_5":22248,"_15096":33777,"_1571":33874},[],"**Intermediate CA:** Autoridad subordinada",{"_7914":705,"_22115":670,"_18751":33876,"_5":22248,"_15096":33777,"_1571":33877},[],"**Emisor**",{"_7914":706,"_22115":670,"_18751":33879,"_5":22248,"_15096":33777,"_1571":33880},[],"**Root CA:** Self-signed (auto-firmada)",{"_7914":707,"_22115":670,"_18751":33882,"_5":22248,"_15096":33777,"_1571":33883},[],"**Intermediate CA:** Selector desplegable de CA superior disponible",{"_7914":708,"_22115":670,"_18751":33885,"_5":22248,"_15096":33777,"_1571":33886},[],"Permite seleccionar la CA padre que firmará la nueva CA intermedia",{"_7914":709,"_22115":670,"_18751":33888,"_5":22248,"_15096":33777,"_1571":33889},[],"**Identificación**",{"_7914":710,"_22115":670,"_18751":33891,"_5":22248,"_15096":33777,"_1571":33892},[],"**CA ID:** Generado automáticamente (formato UUID),no puede ser modificado. Estos IDs los gestiona el sistema.",{"_7914":711,"_22115":670,"_18751":33894,"_5":22248,"_15096":33777,"_1571":33895},[],"Ejemplo: 8f7c170-c84e-4c08-904f-8d3247c77fc2",{"_7914":712,"_22115":670,"_18751":33897,"_5":22248,"_15096":33777,"_1571":33898},[],"**CA Name:** Nombre descriptivo (obligatorio)",{"_7914":713,"_22115":670,"_18751":33900,"_5":22248,"_15096":33777,"_1571":33901},[],"Ejemplo: Lamassu IoT Secure Services CA",{"_7914":714,"_22115":670,"_18751":33903,"_5":22248,"_15096":33777,"_1571":33904},[],"**Subject Distinguished Name (DN)**",{"_7914":715,"_22115":670,"_18751":33906,"_5":22248,"_15096":33777,"_1571":33907},[],"Campos opcionales:",{"_7914":716,"_22115":670,"_18751":33909,"_5":22248,"_15096":33777,"_1571":33910},[],"**Country (C):** Código país ISO 3166-1 (2 letras)",{"_7914":717,"_22115":670,"_18751":33912,"_5":22248,"_15096":33777,"_1571":33913},[],"Ejemplo: US, ES, DE",{"_7914":718,"_22115":670,"_18751":33915,"_5":22248,"_15096":33777,"_1571":33916},[],"**State/Province (ST):** Estado o provincia",{"_7914":719,"_22115":670,"_18751":33918,"_5":22248,"_15096":33777,"_1571":33919},[],"Ejemplo: California, Madrid",{"_7914":720,"_22115":670,"_18751":33921,"_5":22248,"_15096":33777,"_1571":33922},[],"**Locality (L):** Ciudad o localidad",{"_7914":721,"_22115":670,"_18751":33924,"_5":22248,"_15096":33777,"_1571":33925},[],"Ejemplo: San Francisco, Arrasate",{"_7914":722,"_22115":670,"_18751":33927,"_5":22248,"_15096":33777,"_1571":33928},[],"**Organization (O):** Nombre de la organización",{"_7914":723,"_22115":670,"_18751":33930,"_5":22248,"_15096":33777,"_1571":33931},[],"Ejemplo: Lamassu IoT Corp",{"_7914":724,"_22115":670,"_18751":33933,"_5":22248,"_15096":33777,"_1571":33934},[],"**Organizational Unit (OU):** Unidad organizacional",{"_7914":725,"_22115":670,"_18751":33936,"_5":22248,"_15096":33777,"_1571":33937},[],"Ejemplo: Secure Devices Division",{"_7914":726,"_22115":670,"_18751":33939,"_5":22248,"_15096":33777,"_1571":33940},[],"El \"Certification Authority Name\" configurado se utilizará como Common Name (CN) del subject del certificado de la CA.",{"_7914":727,"_22115":670,"_18751":33942,"_5":22248,"_15096":33777,"_1571":33943},[],"**Configuración de expiración**\nLa configuración de expiración define la validez temporal tanto del certificado de la propia CA como de los certificados que ésta emitirá por defecto. Si se ha seleccionado un perfil se dará prioridad al dato proporcionado en el perfil.",{"_7914":728,"_22115":670,"_18751":33945,"_5":22248,"_15096":33777,"_1571":33946},[],"Para el certificado de la CA (`CA Certificate Expiration`):",{"_7914":729,"_22115":670,"_18751":33948,"_5":22248,"_15096":33777,"_1571":33949},[],"**Función:** Establece la duración de validez del certificado de la Autoridad de Certificación",{"_7914":730,"_22115":670,"_18751":33951,"_5":22248,"_15096":33777,"_1571":33952},[],"**Implicación:** Una vez expirado, la CA no podrá emitir nuevos certificados válidos",{"_7914":731,"_22115":670,"_18751":33954,"_5":22248,"_15096":33777,"_1571":33955},[],"**Duración:** Configurable según necesidades organizacionales",{"_7914":732,"_22115":670,"_18751":33957,"_5":22248,"_15096":33777,"_1571":33958},[],"**Valor por defecto:** 10 años (10y)",{"_7914":733,"_22115":670,"_18751":33960,"_5":22248,"_15096":33777,"_1571":33961},[],"**Consideración:** Debe ser mayor que la duración de los certificados que emitirá",{"_7914":734,"_22115":670,"_18751":33963,"_5":22248,"_15096":33777,"_1571":33964},[],"La expiración de la CA se puede definir como un expresión de duración, fijar una fecha fija, o marcarla como indefinida, lo que en términos prácticos permitirá la emisión de una CA sin caducidad.",{"_7914":735,"_22115":670,"_18751":33966,"_5":22248,"_15096":33777,"_1571":33967},[],"En el caso de expresar una duración, las unidades permitidas son: y (años), w (semanas), d (días), h (horas), m (minutos) y s (segundos), pudiendo componer expresiones como la siguiente: *5y 8w 4d 2h 1m 2s*",{"_7914":736,"_22115":670,"_18751":33969,"_5":22248,"_15096":33777,"_1571":33970},[],"En caso de elegir la opción de fecha específica, se ofrecerá un calendario para seleccionar la fecha de caducidad.",{"_7914":737,"_22115":670,"_18751":33972,"_5":22248,"_15096":33777,"_1571":33973},[],"Para el caso de indefinido, se fijará la fecha de expiración máxima permitida.",{"_7914":738,"_22115":670,"_18751":33975,"_5":22248,"_15096":33777,"_1571":33976},[],"Para la expiración por defecto de certificados finales (`Default End-Entity Certificate Issuance Expiration`):",{"_7914":739,"_22115":670,"_18751":33978,"_5":22248,"_15096":33777,"_1571":33979},[],"**Función:** Define la duración predeterminada para certificados emitidos por esta CA",{"_7914":740,"_22115":670,"_18751":33981,"_5":22248,"_15096":33777,"_1571":33982},[],"**Aplicación:** Se aplica automáticamente a nuevos certificados si no se especifica otra duración",{"_7914":741,"_22115":670,"_18751":33984,"_5":22248,"_15096":33777,"_1571":33985},[],"**Flexibilidad:** Puede ser modificada individualmente al emitir cada certificado",{"_7914":742,"_22115":670,"_18751":33987,"_5":22248,"_15096":33777,"_1571":33988},[],"**Valor por defecto:** 1 año (1y)",{"_7914":743,"_22115":670,"_18751":33990,"_5":22248,"_15096":33777,"_1571":33991},[],"Se expresa en los mismos términos que la caducidad de la CA.",{"_7914":744,"_22115":670,"_18751":33993,"_5":22248,"_15096":33777,"_1571":33994},[],"Una vez creada la CA debe ser visible en el listado de CAs del sistema.",{"_7914":745,"_22115":670,"_18751":33996,"_5":22248,"_15096":33781,"_1571":33997},[],"Lamassu IoT permite la creación de CAs a partir de claves previamente generadas o importadas en el servicio KMS. Una vez seleccionada la opción &#x2A;*Create New CA (Existing Key)** se muestra el formulario de creación de CAs con los siguientes elementos diferenciales respecto a la creación de la CA a partir de un nuevo par de claves descrito en el punto anterior.",{"_7914":746,"_22115":670,"_18751":33999,"_5":22248,"_15096":33781,"_1571":34000},[],"En este caso, primero se solicita la selección de la clave de soporte para esta nueva CA.",{"_7914":747,"_22115":670,"_18751":34002,"_5":22248,"_15096":33781,"_1571":34003},[],"Se abre un popup que permite al usuario seleccionar la clave deseada de entre las disponibles en el KMS. Una vez seleccionada la clave, el proceso continúa como se describe en el punto anterior.",{"_7914":748,"_22115":670,"_18751":34005,"_5":22248,"_15096":33785,"_1571":34006},[],"La importación de entidades de certificación permite importar en el sistema una CA que ha sido generada de manera externa. Para ello se sigue el siguiente proceso:",{"_7914":749,"_22115":670,"_18751":34008,"_5":22248,"_15096":33785,"_1571":34009},[],"Se debe seleccionar el motor que gestionará el par de claves importado.",{"_7914":750,"_22115":670,"_18751":34011,"_5":22248,"_15096":33785,"_1571":33829},[],{"_7914":751,"_22115":670,"_18751":34013,"_5":22248,"_15096":33785,"_1571":33832},[],{"_7914":752,"_22115":670,"_18751":34015,"_5":22248,"_15096":33785,"_1571":33835},[],{"_7914":753,"_22115":670,"_18751":34017,"_5":22248,"_15096":33785,"_1571":34018},[],"También se define la expiración por defecto de certificados finales (`Default End-Entity Certificate Issuance Expiration`):",{"_7914":754,"_22115":670,"_18751":34020,"_5":22248,"_15096":33785,"_1571":33979},[],{"_7914":755,"_22115":670,"_18751":34022,"_5":22248,"_15096":33785,"_1571":33982},[],{"_7914":756,"_22115":670,"_18751":34024,"_5":22248,"_15096":33785,"_1571":33985},[],{"_7914":757,"_22115":670,"_18751":34026,"_5":22248,"_15096":33785,"_1571":33988},[],{"_7914":758,"_22115":670,"_18751":34028,"_5":22248,"_15096":33785,"_1571":33991},[],{"_7914":759,"_22115":670,"_18751":34030,"_5":22248,"_15096":33785,"_1571":34031},[],"Se debe proporcionar de manera obligatoria:",{"_7914":760,"_22115":670,"_18751":34033,"_5":22248,"_15096":33785,"_1571":34034},[],"Certificado de la CA en formato PEM. Se comprueba que el certificado importado corresponda con el de una CA.",{"_7914":761,"_22115":670,"_18751":34036,"_5":22248,"_15096":33785,"_1571":34037},[],"Clave privada de la CA en formato PEM",{"_7914":762,"_22115":670,"_18751":34039,"_5":22248,"_15096":33785,"_1571":34040},[],"De manera opcional se proporcionarán en formato PEM la cadena de certificados de la cadena de validación en caso de importar una CA subordinada.",{"_7914":763,"_22115":670,"_18751":34042,"_5":22248,"_15096":33793,"_1571":34043},[],"Accediendo a la sección de autoridades de certificación se mostrará el listado de CAs registradas en el sistema. El listado permitirá el filtro mediante el nombre de la CA, el estado o el tipo de CA.",{"_7914":764,"_22115":670,"_18751":34045,"_5":22248,"_15096":33793,"_1571":34046},[],"La acción de ver detalles da acceso a los detalles de la CA y a diferentes opciones de gestión.",{"_7914":765,"_22115":670,"_18751":34048,"_5":22248,"_15096":33793,"_1571":34049},[],"En los detalles se muestra el resumen del estado de los certificados emitidos por la CA: certificados activos, expirados y revocados.",{"_7914":766,"_22115":670,"_18751":34051,"_5":22248,"_15096":33793,"_1571":34052},[],"Se ofrecen dos acciones:",{"_7914":767,"_22115":670,"_18751":34054,"_5":22248,"_15096":33793,"_1571":34055},[],"la descarga de la CRL vinculada a la CA que permitirá a otros sistemas realizar comprobaciones de vigencia de los certificados emitidos por la CA de manera desconectada.",{"_7914":768,"_22115":670,"_18751":34057,"_5":22248,"_15096":33793,"_1571":34058},[],"la acción de revocación de la CA",{"_7914":769,"_22115":670,"_18751":34060,"_5":22248,"_15096":33793,"_1571":34061},[],"Se muestra información detallada, el certificado en formato PEM y se da acceso a la relación de certificados emitidos por la CA a través de la pestaña “Issued Certificates”",{"_7914":770,"_22115":670,"_18751":34063,"_5":22248,"_15096":33797,"_1571":34064},[],"La acción de emisión de certificados se puede realizar desde la pestaña “Issued Certificates” de los detalles de la CA, mediante la acción “Issue New”.",{"_7914":771,"_22115":670,"_18751":34066,"_5":22248,"_15096":33797,"_1571":34067},[],"La funcionalidad de emisión es accesible también desde el listado de CAs mediante la acción correspondiente de emisión.",{"_7914":772,"_22115":670,"_18751":34069,"_5":22248,"_15096":33797,"_1571":34070},[],"Y desde la funcionalidad  listado completo de certificados emitidos por Lamassu mediante la acción “Issue Certificate”",{"_7914":773,"_22115":670,"_18751":34072,"_5":22248,"_15096":33797,"_1571":34073},[],"En este caso se solicitará la selección de una CA antes de acceder al formulario de emisión.",{"_7914":774,"_22115":670,"_18751":34075,"_5":22248,"_15096":33797,"_1571":34076},[],"El formulario de emisión de certificados ofrece 2 opciones para la emisión:",{"_7914":775,"_22115":670,"_18751":34078,"_5":22248,"_15096":33797,"_1571":34079},[],"Emisión a partir de una clave privada y el CSR generado en el browser",{"_7914":776,"_22115":670,"_18751":34081,"_5":22248,"_15096":33797,"_1571":34082},[],"Emisión a partir de un CSR generado de manera externa",{"_7914":777,"_22115":670,"_18751":34084,"_5":22248,"_15096":33797,"_1571":34085},[],"**Emisión a partir de una clave privada y el CSR generados en el browser**",{"_7914":778,"_22115":670,"_18751":34087,"_5":22248,"_15096":33797,"_1571":34088},[],"El usuario proporciona la información requerida para la creación del CSR, la consola genera una clave In Place y genera el CSR correspondiente mediante el cual se solicita la emisión del certificado a la CA.",{"_7914":779,"_22115":670,"_18751":34090,"_5":22248,"_15096":33797,"_1571":34091},[],"**Método de emisión:** Seleccionar  \"Generate Key & CSR in Browser\" para la generación del par de claves y la solicitud de certificado (CSR) directamente en el navegador",{"_7914":780,"_22115":670,"_18751":34093,"_5":22248,"_15096":33797,"_1571":34094},[],"**Certificate Subject (Sujeto del certificado)**",{"_7914":781,"_22115":670,"_18751":34096,"_5":22248,"_15096":33797,"_1571":34097},[],"**Common Name (CN)**",{"_7914":782,"_22115":670,"_18751":34099,"_5":22248,"_15096":33797,"_1571":34100},[],"**Campo:** Obligatorio",{"_7914":783,"_22115":670,"_18751":34102,"_5":22248,"_15096":33797,"_1571":34103},[],"**Función:** Identifica de forma única al titular del certificado",{"_7914":784,"_22115":670,"_18751":34105,"_5":22248,"_15096":33797,"_1571":34106},[],"**Ejemplos:**",{"_7914":785,"_22115":670,"_18751":34108,"_5":22248,"_15096":33797,"_1571":34109},[],"Para dispositivos: device001.company.com",{"_7914":786,"_22115":670,"_18751":34111,"_5":22248,"_15096":33797,"_1571":34112},[],"Para usuarios: john.doe\\@company.com",{"_7914":787,"_22115":670,"_18751":34114,"_5":22248,"_15096":33797,"_1571":34115},[],"Para servicios: api.service.company.com",{"_7914":788,"_22115":670,"_18751":34117,"_5":22248,"_15096":33797,"_1571":34118},[],"**Campos Organizacionales**",{"_7914":789,"_22115":670,"_18751":34120,"_5":22248,"_15096":33797,"_1571":34121},[],"**Organizational Unit (OU):** Unidad organizacional del titular",{"_7914":790,"_22115":670,"_18751":34123,"_5":22248,"_15096":33797,"_1571":34124},[],"Ejemplo: IT Department, Manufacturing",{"_7914":791,"_22115":670,"_18751":34126,"_5":22248,"_15096":33797,"_1571":33928},[],{"_7914":792,"_22115":670,"_18751":34128,"_5":22248,"_15096":33797,"_1571":34129},[],"Ejemplo: LamassuIoT Corp, Acme Industries",{"_7914":793,"_22115":670,"_18751":34131,"_5":22248,"_15096":33797,"_1571":34132},[],"**Información Geográfica**",{"_7914":794,"_22115":670,"_18751":34134,"_5":22248,"_15096":33797,"_1571":34135},[],"**Locality (L):** Ciudad o localidad del titular",{"_7914":795,"_22115":670,"_18751":34137,"_5":22248,"_15096":33797,"_1571":33916},[],{"_7914":796,"_22115":670,"_18751":34139,"_5":22248,"_15096":33797,"_1571":34140},[],"**Country (C):** Código de país ISO 3166-1 (2 letras)",{"_7914":797,"_22115":670,"_18751":34142,"_5":22248,"_15096":33797,"_1571":34143},[],"Valor por defecto mostrado: US",{"_7914":798,"_22115":670,"_18751":34145,"_5":22248,"_15096":33797,"_1571":34146},[],"**Subject Alternative Names (SANs)**\nLos SANs proporcionan identificadores alternativos para el certificado, permitiendo que un mismo certificado sea válido para múltiples nombres o direcciones.",{"_7914":799,"_22115":670,"_18751":34148,"_5":22248,"_15096":33797,"_1571":34149},[],"**Tipos de SAN Disponibles**",{"_7914":800,"_22115":670,"_18751":34151,"_5":22248,"_15096":33797,"_1571":34152},[],"**DNS:** Nombres de dominio",{"_7914":801,"_22115":670,"_18751":34154,"_5":22248,"_15096":33797,"_1571":34155},[],"Ejemplo: example.com, \\*.example.com",{"_7914":802,"_22115":670,"_18751":34157,"_5":22248,"_15096":33797,"_1571":34158},[],"**IP Address:** Direcciones IP",{"_7914":803,"_22115":670,"_18751":34160,"_5":22248,"_15096":33797,"_1571":34161},[],"**Email:** Direcciones de correo electrónico",{"_7914":804,"_22115":670,"_18751":34163,"_5":22248,"_15096":33797,"_1571":34164},[],"**URI:** Identificadores de recursos uniformes",{"_7914":805,"_22115":670,"_18751":34166,"_5":22248,"_15096":33797,"_1571":34167},[],"Es posible añadir múltiples SAN de cada tipo, se selecciona el tipo, añadiendo el valor y pulsando la acción “Add”.",{"_7914":806,"_22115":670,"_18751":34169,"_5":22248,"_15096":33797,"_1571":34170},[],"**Key Generation Details (Detalles de generación de claves)**\nSe debe especificar el tipo de clave a ser generada para la solicitud del certificado.",{"_7914":807,"_22115":670,"_18751":34172,"_5":22248,"_15096":33797,"_1571":34173},[],"**Algorithm (Algoritmo)**",{"_7914":808,"_22115":670,"_18751":34175,"_5":22248,"_15096":33797,"_1571":34176},[],"**ECDSA:** Algoritmo de curva elíptica, se debe especificar la curva a utilizar",{"_7914":809,"_22115":670,"_18751":34178,"_5":22248,"_15096":33797,"_1571":34179},[],"**RSA:** Algoritmo RSA tradicional, se debe indicar el tamaño de clave",{"_7914":810,"_22115":670,"_18751":34181,"_5":22248,"_15096":33797,"_1571":34182},[],"**Certificate Configuration (Configuración del certificado)**",{"_7914":811,"_22115":670,"_18751":34184,"_5":22248,"_15096":33797,"_1571":34185},[],"**Validity Duration (Duración de validez)**",{"_7914":812,"_22115":670,"_18751":34187,"_5":22248,"_15096":33797,"_1571":34188},[],"Indica la fecha de expiración del certificado a emitir como una expresión de duración",{"_7914":813,"_22115":670,"_18751":34190,"_5":22248,"_15096":33797,"_1571":34191},[],"**Campo:** Configurable según necesidades",{"_7914":814,"_22115":670,"_18751":34193,"_5":22248,"_15096":33797,"_1571":33988},[],{"_7914":815,"_22115":670,"_18751":34195,"_5":22248,"_15096":33797,"_1571":34196},[],"**Unidades válidas:** y (años), w (semanas), d (días), h (horas), m (minutos), s (segundos)",{"_7914":816,"_22115":670,"_18751":34198,"_5":22248,"_15096":33797,"_1571":34199},[],"**Consideración:** No puede exceder la validez de la CA emisora",{"_7914":817,"_22115":670,"_18751":34201,"_5":22248,"_15096":33797,"_1571":34202},[],"**Key Usage (Uso de claves)**\nDefine los propósitos criptográficos para los que puede utilizarse la clave privada del certificado.",{"_7914":818,"_22115":670,"_18751":34204,"_5":22248,"_15096":33797,"_1571":34205},[],"**Usos Básicos**",{"_7914":819,"_22115":670,"_18751":34207,"_5":22248,"_15096":33797,"_1571":34208},[],"**Digital Signature:** ✓ (marcado por defecto) - Firmas digitales",{"_7914":820,"_22115":670,"_18751":34210,"_5":22248,"_15096":33797,"_1571":34211},[],"**Content Commitment (Non-Repudiation):** No repudio",{"_7914":821,"_22115":670,"_18751":34213,"_5":22248,"_15096":33797,"_1571":34214},[],"**Key Encipherment:** Cifrado de claves",{"_7914":822,"_22115":670,"_18751":34216,"_5":22248,"_15096":33797,"_1571":34217},[],"**Data Encipherment:** Cifrado de datos",{"_7914":823,"_22115":670,"_18751":34219,"_5":22248,"_15096":33797,"_1571":34220},[],"**Key Agreement:** Acuerdo de claves",{"_7914":824,"_22115":670,"_18751":34222,"_5":22248,"_15096":33797,"_1571":34223},[],"**Certificate Signing:** Firma de certificados",{"_7914":825,"_22115":670,"_18751":34225,"_5":22248,"_15096":33797,"_1571":34226},[],"**CRL Signing:** Firma de listas de revocación",{"_7914":826,"_22115":670,"_18751":34228,"_5":22248,"_15096":33797,"_1571":34229},[],"**Encipher Only:** Solo cifrado",{"_7914":827,"_22115":670,"_18751":34231,"_5":22248,"_15096":33797,"_1571":34232},[],"**Decipher Only:** Solo descifrado",{"_7914":828,"_22115":670,"_18751":34234,"_5":22248,"_15096":33797,"_1571":34235},[],"**Uso Extendido de Claves**",{"_7914":829,"_22115":670,"_18751":34237,"_5":22248,"_15096":33797,"_1571":34238},[],"Especifica aplicaciones específicas para las que está autorizado el certificado.",{"_7914":830,"_22115":670,"_18751":34240,"_5":22248,"_15096":33797,"_1571":34241},[],"**Server Authentication:** ✓ (marcado por defecto) - Autenticación de servidor",{"_7914":831,"_22115":670,"_18751":34243,"_5":22248,"_15096":33797,"_1571":34244},[],"**Client Authentication:** ✓ (marcado por defecto) - Autenticación de cliente",{"_7914":832,"_22115":670,"_18751":34246,"_5":22248,"_15096":33797,"_1571":34247},[],"**Code Signing:** Firma de código",{"_7914":833,"_22115":670,"_18751":34249,"_5":22248,"_15096":33797,"_1571":34250},[],"**Email Protection:** Protección de correo electrónico",{"_7914":834,"_22115":670,"_18751":34252,"_5":22248,"_15096":33797,"_1571":34253},[],"**Time Stamping:** Sellado de tiempo",{"_7914":835,"_22115":670,"_18751":34255,"_5":22248,"_15096":33797,"_1571":34256},[],"**OCSP Signing:** Firma de respuestas OCSP",{"_7914":836,"_22115":670,"_18751":34258,"_5":22248,"_15096":33797,"_1571":34259},[],"Una vez completado los campos del formulario se solicita la emisión del certificado obteniendo el certificado y la clave privada generada en formato PEM. Esta clave privada no se almacena debe ser descargada y custodiada por el usuario ya que no se podrá volver a obtener.",{"_7914":837,"_22115":670,"_18751":34261,"_5":22248,"_15096":33797,"_1571":34262},[],"**Emisión a partir de un CSR generado de manera externa**",{"_7914":838,"_22115":670,"_18751":34264,"_5":22248,"_15096":33797,"_1571":34265},[],"Mediante esta opción se podrá realizar la emisión de certificados a partir de CSRs que hayan sido generados de manera externa. Para ello en el selector de modo del formulario de emisión es necesario seleccionar “Upload Existing CSR”.",{"_7914":839,"_22115":670,"_18751":34267,"_5":22248,"_15096":33797,"_1571":34268},[],"Se debe proporcionar un CSR válido que contenga los detalles del certificado a emitir, Subject Name, SANs,..",{"_7914":840,"_22115":670,"_18751":34270,"_5":22248,"_15096":33797,"_1571":34271},[],"Adicionalmente se proporcionará la duración deseada para el certificado y los usos permitidos. Con esta información se procederá a la emisión como se describe en el apartado anterior.",{"_7914":841,"_22115":670,"_18751":34273,"_5":22248,"_15096":33801,"_1571":34274},[],"La revocación de una Autoridad de Certificación (CA) es una acción crítica que invalida todos los certificados emitidos por esa CA, lo que puede causar interrupciones generalizadas en los dispositivos y servicios que confían en ella. Este proceso es irreversible y debe realizarse con extrema precaución.",{"_7914":842,"_22115":670,"_18751":34276,"_5":22248,"_15096":33801,"_1571":34277},[],"Para iniciar el proceso, entra en la sección de Autoridades de Certificación y localiza la CA deseada usando los filtros por **Nombre**, **Estado** y **Tipo**.",{"_7914":843,"_22115":670,"_18751":34279,"_5":22248,"_15096":33801,"_1571":34280},[],"Accede a la ficha de detalle de la CA. Allí se muestran la información general, los certificados PEM, los metadatos y los certificados emitidos, además del botón **Revoke CA**.",{"_7914":844,"_22115":670,"_18751":34282,"_5":22248,"_15096":33801,"_1571":34283},[],"Al pulsar **Revoke CA** se abre una ventana de confirmación con una advertencia sobre el impacto de la acción. En ese cuadro hay que seleccionar una **Razón de Revocación**. Las opciones incluyen:",{"_7914":845,"_22115":670,"_18751":34285,"_5":22248,"_15096":33801,"_1571":34286},[],"Unspecified (No especificado)",{"_7914":846,"_22115":670,"_18751":34288,"_5":22248,"_15096":33801,"_1571":34289},[],"KeyCompromise (Compromiso de clave)",{"_7914":847,"_22115":670,"_18751":34291,"_5":22248,"_15096":33801,"_1571":34292},[],"CACompromise (Compromiso de CA)",{"_7914":848,"_22115":670,"_18751":34294,"_5":22248,"_15096":33801,"_1571":34295},[],"AffiliationChanged (Afiliación cambiada)",{"_7914":849,"_22115":670,"_18751":34297,"_5":22248,"_15096":33801,"_1571":34298},[],"Superseded (Sustituida)",{"_7914":850,"_22115":670,"_18751":34300,"_5":22248,"_15096":33801,"_1571":34301},[],"CessationOfOperation (Cese de operación)",{"_7914":851,"_22115":670,"_18751":34303,"_5":22248,"_15096":33801,"_1571":34304},[],"CertificateHold (Retención de certificado)",{"_7914":852,"_22115":670,"_18751":34306,"_5":22248,"_15096":33801,"_1571":34307},[],"RemoveFromCRL (Eliminar de la CRL)",{"_7914":853,"_22115":670,"_18751":34309,"_5":22248,"_15096":33801,"_1571":34310},[],"Para evitar revocaciones accidentales, el sistema pedirá confirmar el nombre de la CA. En el campo de texto, escribe el **nombre exacto de la CA** que estás revocando. Una vez introducido correctamente, se habilitará el botón **Confirm Revocation**.",{"_7914":854,"_22115":670,"_18751":34312,"_5":22248,"_15096":33801,"_1571":34313},[],"Haz clic en el botón **Confirm Revocation**. Una vez completada la revocación, la CA cambiará su estado a **REVOKED** (Revocada) en la página de detalles, y ya no podrás emitir certificados nuevos con ella. En su lugar, verás la opción **Permanently Delete** (Eliminar Permanentemente).",{"_7914":855,"_22115":670,"_18751":34315,"_5":22248,"_15096":33801,"_1571":34316},[],"Consideraciones importantes:",{"_7914":856,"_22115":670,"_18751":34318,"_5":22248,"_15096":33801,"_1571":34319},[],"Impacto: La revocación de una CA es una acción irreversible que afectará a todos los dispositivos y servicios que dependen de ella. Asegúrate de comprender completamente las implicaciones antes de proceder.",{"_7914":857,"_22115":670,"_18751":34321,"_5":22248,"_15096":33801,"_1571":34322},[],"Eliminación Permanente: Después de la revocación, tendrás la opción de eliminar permanentemente la CA. Esta acción eliminará la CA del sistema de Lamassu IoT.",{"_7914":858,"_22115":858,"_5":22243,"_1571":34324,"_22256":34325,"_18751":34326,"_15096":858},"[Certs] Gestión de Certificados",[31753,32852,32861],[],{"_7914":859,"_22115":858,"_18751":34328,"_5":22248,"_15096":858,"_1571":34329},[],"Visualización y gestión de certificados emitidos",{"_7914":860,"_22115":858,"_5":22253,"_18751":34331,"_15096":34332,"_1571":34333},[],"/docs/manual/servicios-core/certificates#gestión-de-certificados","Gestión de certificados",{"_7914":861,"_22115":858,"_5":22253,"_18751":34335,"_15096":34336,"_1571":34337},[],"/docs/manual/servicios-core/certificates#revocación-de-certificados","Revocación de certificados",{"_7914":862,"_22115":858,"_18751":34339,"_5":22248,"_15096":34332,"_1571":34340},[],"Los certificados emitidos por Lamassu son accesibles, tanto desde la pestaña de Issued Certificates de los detalles de una CA como desde la opción “Certificates” del menú lateral.\\\nEn la pestaña de “Issued Certificates” se muestran los certificados emitidos por la CA seleccionada.",{"_7914":863,"_22115":858,"_18751":34342,"_5":22248,"_15096":34332,"_1571":34343},[],"Como desde la opción “Certificates” del menú lateral, donde se presentan todos los certificados emitidos por Lamassu independientemente de la CA que lo haya emitido. Esta pantalla incluye la opción de filtro de los certificados por CN, número de serie, estado y por la CA que lo emitió.",{"_7914":864,"_22115":858,"_18751":34345,"_5":22248,"_15096":34332,"_1571":34346},[],"Por cada certificado se incluye un conjunto de acciones vinculadas al certificado.\\\nAcceso a los detalles “View Details”, un mecanismo de inspección rápida (Quick Inspect) con la información básica del certificado, la opción de descarga en formato PEM y el acceso a las acciones de revocación.\\\nLa vista de detalle, proporciona información adicional y el acceso a las acciones de revocación.",{"_7914":865,"_22115":858,"_18751":34348,"_5":22248,"_15096":34336,"_1571":34349},[],"Ya sea desde las acciones del listado de certificados, como desde la vista de detalle se puede desencadenar la acción de revocación. Al pulsar sobre “Revoke Certificate” se abre una ventana modal en la que se debe seleccionar la razón de la revocación.",{"_7914":866,"_22115":858,"_18751":34351,"_5":22248,"_15096":34336,"_1571":34352},[],"Es importante destacar que la única razón reversible es “CertificateHold”, una revocación por cualquier otra  razón no podrá ser revertida. En caso de seleccionar “CertificateHold” se ofrecerá una acción de reactivación.",{"_7914":867,"_22115":867,"_5":22243,"_1571":34354,"_22256":34355,"_18751":34356,"_15096":867},"[Devices] Dispositivos e Identidades",[31753,32852,32861],[],{"_7914":868,"_22115":867,"_18751":34358,"_5":22248,"_15096":867,"_1571":34359},[],"Gestión de dispositivos IoT y sus identidades digitales",{"_7914":869,"_22115":867,"_5":22253,"_18751":34361,"_15096":34362,"_1571":34363},[],"/docs/manual/servicios-core/devices#dispositivos-y-gestión-de-las-identidades--end-entities","Dispositivos y gestión de las identidades – End entities",{"_7914":870,"_22115":867,"_5":22253,"_18751":34365,"_15096":34366,"_1571":34367},[],"/docs/manual/servicios-core/devices#visualización-de-dispositivos-gestionados","Visualización de Dispositivos Gestionados",{"_7914":871,"_22115":867,"_5":22253,"_18751":34369,"_15096":34370,"_1571":34371},[],"/docs/manual/servicios-core/devices#detalle-del-dispositivo-historial-de-certificados","Detalle del Dispositivo: Historial de Certificados",{"_7914":872,"_22115":867,"_5":22253,"_18751":34373,"_15096":34374,"_1571":34375},[],"/docs/manual/servicios-core/devices#detalle-del-dispositivo-línea-de-tiempo-de-eventos","Detalle del Dispositivo: Línea de tiempo de eventos",{"_7914":873,"_22115":867,"_5":22253,"_18751":34377,"_15096":34378,"_1571":34379},[],"/docs/manual/servicios-core/devices#registro-de-nuevos-dispositivos","Registro de Nuevos Dispositivos",{"_7914":874,"_22115":867,"_5":22253,"_18751":34381,"_15096":34382,"_1571":34383},[],"/docs/manual/servicios-core/devices#asignación-manual-de-identidad","Asignación Manual de Identidad",{"_7914":875,"_22115":867,"_5":22253,"_18751":34385,"_15096":34386,"_1571":34387},[],"/docs/manual/servicios-core/devices#revocación-de-identidad","Revocación de Identidad",{"_7914":876,"_22115":867,"_5":22253,"_18751":34389,"_15096":34390,"_1571":34391},[],"/docs/manual/servicios-core/devices#desactivación-de-dispositivos-decommissioning","Desactivación de Dispositivos (Decommissioning)",{"_7914":877,"_22115":867,"_18751":34393,"_5":22248,"_15096":34362,"_1571":34394},[],"La gestión del ciclo de vida de las identidades de los dispositivos es una funcionalidad central en Lamassu IoT. Esta sección del manual se enfoca en la visualización y administración de las identidades de los dispositivos ya enrolados, conocidos como *End Entities* (entidades finales). Permite una visión completa del estado, los certificados y los eventos históricos de cada dispositivo, facilitando su monitorización y control a lo largo de su ciclo de vida.",{"_7914":878,"_22115":867,"_18751":34396,"_5":22248,"_15096":34366,"_1571":34397},[],"La página de **Dispositivos** (Managed Devices) ofrece una vista general de todos los dispositivos registrados en el sistema. Puedes ver un resumen del estado de cada dispositivo, su grupo, la fecha de creación y las etiquetas asociadas. Esta visualización es clave para tener una perspectiva general del parque de dispositivos y su salud respecto al estado de su identidad.",{"_7914":879,"_22115":867,"_18751":34399,"_5":22248,"_15096":34366,"_1571":34400},[],"Para facilitar la búsqueda y el seguimiento, la interfaz permite filtrar los dispositivos por **Device ID** y por **Tags**. Además, se puede filtrar por los siguientes estados:",{"_7914":880,"_22115":867,"_18751":34402,"_5":22248,"_15096":34366,"_1571":34403},[],"**Active**: El dispositivo y su certificado están en uso y son válidos.",{"_7914":881,"_22115":867,"_18751":34405,"_5":22248,"_15096":34366,"_1571":34406},[],"**No Identity**: El dispositivo existe en el sistema, pero no tiene una identidad digital (certificado) asociada.",{"_7914":882,"_22115":867,"_18751":34408,"_5":22248,"_15096":34366,"_1571":34409},[],"**Renewal Pending**: El dispositivo se encuentra en la ventana de tiempo de renovación y su certificado expirará pronto.",{"_7914":883,"_22115":867,"_18751":34411,"_5":22248,"_15096":34366,"_1571":34412},[],"**Expiring Soon**: El certificado del dispositivo está a punto de caducar.",{"_7914":884,"_22115":867,"_18751":34414,"_5":22248,"_15096":34366,"_1571":34415},[],"**Expired**: El certificado del dispositivo ha caducado.",{"_7914":885,"_22115":867,"_18751":34417,"_5":22248,"_15096":34366,"_1571":34418},[],"**Revoked**: El certificado del dispositivo ha sido revocado.",{"_7914":886,"_22115":867,"_18751":34420,"_5":22248,"_15096":34366,"_1571":34421},[],"**Decommissioned**: El dispositivo ha sido dado de baja y ya no está en uso.",{"_7914":887,"_22115":867,"_18751":34423,"_5":22248,"_15096":34370,"_1571":34424},[],"Al seleccionar un dispositivo específico, se accede a su página de detalles. La pestaña de **Historial de Certificados** muestra un registro cronológico de todos los certificados X.509 que han sido asociados a la identidad de ese dispositivo. Aquí se pueden ver detalles como el número de serie, el estado del certificado (por ejemplo, activo, expirado o revocado), el nombre común, la CA emisora y los periodos de validez.",{"_7914":888,"_22115":867,"_18751":34426,"_5":22248,"_15096":34370,"_1571":34427},[],"Esta funcionalidad es fundamental para auditar y rastrear la historia de la identidad del dispositivo, lo que permite identificar si un certificado ha sido reemplazado o revocado en algún momento.",{"_7914":889,"_22115":867,"_18751":34429,"_5":22248,"_15096":34374,"_1571":34430},[],"La pestaña de **Línea de tiempo de eventos** (Device Event Timeline) proporciona un registro detallado y cronológico de los eventos más importantes relacionados con el dispositivo y su identidad. Estos eventos pueden incluir el aprovisionamiento inicial, la renovación de certificados o cambios de estado.",{"_7914":890,"_22115":867,"_18751":34432,"_5":22248,"_15096":34374,"_1571":34433},[],"Esta línea de tiempo es una herramienta poderosa para el análisis forense y la resolución de problemas, ya que permite ver la secuencia exacta de las acciones que han ocurrido en la vida del dispositivo.",{"_7914":891,"_22115":867,"_18751":34435,"_5":22248,"_15096":34378,"_1571":34436},[],"Además de la gestión de dispositivos ya enrolados, Lamassu IoT permite el registro manual de nuevos dispositivos. Esto es particularmente útil para el modo de registro por **Pre-registration**, donde la identidad del dispositivo debe existir en el sistema antes de que pueda solicitar un certificado.",{"_7914":892,"_22115":867,"_18751":34438,"_5":22248,"_15096":34378,"_1571":34439},[],"El proceso de registro de un nuevo dispositivo se realiza a través de un formulario que permite configurar los siguientes campos:",{"_7914":893,"_22115":867,"_18751":34441,"_5":22248,"_15096":34378,"_1571":34442},[],"**Device ID (GUID)**: Es el identificador único del dispositivo, normalmente un GUID (Globally Unique Identifier).",{"_7914":894,"_22115":867,"_18751":34444,"_5":22248,"_15096":34378,"_1571":34445},[],"**Registration Authority**: Se debe seleccionar la RA a la que se asociará el dispositivo, lo que definirá las políticas de *enrollment* y *re-enrollment* que se aplicarán.",{"_7914":895,"_22115":867,"_18751":34447,"_5":22248,"_15096":34378,"_1571":34448},[],"**Device Registration Profile**: En esta sección se pueden configurar aspectos visuales para facilitar la identificación del dispositivo.",{"_7914":896,"_22115":867,"_18751":34450,"_5":22248,"_15096":34378,"_1571":34451},[],"**Icon**: Permite seleccionar un icono que represente visualmente el tipo de dispositivo.",{"_7914":897,"_22115":867,"_18751":34453,"_5":22248,"_15096":34378,"_1571":34454},[],"**Tags**: Se pueden añadir etiquetas para agrupar y organizar el dispositivo con otros de características similares.",{"_7914":898,"_22115":867,"_18751":34456,"_5":22248,"_15096":34378,"_1571":34457},[],"Una vez registrado, el dispositivo aparecerá en el listado de dispositivos con el estado **No Identity** hasta que complete el proceso de *enrollment* y obtenga su primer certificado.",{"_7914":899,"_22115":867,"_18751":34459,"_5":22248,"_15096":34382,"_1571":34460},[],"La **Asignación manual de identidad** es una acción que solo está disponible para dispositivos en estado **No Identity**, es decir, que han sido registrados en el sistema pero aún no tienen un certificado asignado. Esta funcionalidad permite vincular un certificado ya existente o emitir uno nuevo de forma manual.",{"_7914":900,"_22115":867,"_18751":34462,"_5":22248,"_15096":34382,"_1571":34463},[],"El proceso se lleva a cabo desde la vista de detalles del dispositivo:",{"_7914":901,"_22115":867,"_18751":34465,"_5":22248,"_15096":34382,"_1571":34466},[],"**Iniciar la asignación**: Se hace clic en el botón **Assign Identity**. Esto abrirá una ventana emergente.",{"_7914":902,"_22115":867,"_18751":34468,"_5":22248,"_15096":34382,"_1571":34469},[],"**Vincular certificado existente**: La aplicación buscará certificados activos con un Common Name (CN) que coincida con el Device ID. Si se encuentra un certificado, se puede seleccionar y vincular al dispositivo.",{"_7914":903,"_22115":867,"_18751":34471,"_5":22248,"_15096":34382,"_1571":34472},[],"**Emitir un nuevo certificado**: Si no se encuentra un certificado existente, o si se desea emitir uno nuevo, se puede seleccionar la opción **Issue New Instead**. Esto te permite elegir la **Certification Authority** que emitirá el nuevo certificado para el dispositivo. Se muestran por defecto las CAs vinculadas a la RA que gestiona ell dispositivo.",{"_7914":904,"_22115":867,"_18751":34474,"_5":22248,"_15096":34382,"_1571":34475},[],"**Confirmar y asignar**: Una vez seleccionado el certificado (existente o nuevo), se confirma la asignación. El dispositivo pasará del estado **No Identity** al estado **Active** y el certificado aparecerá en su historial.",{"_7914":905,"_22115":867,"_18751":34477,"_5":22248,"_15096":34386,"_1571":34478},[],"La revocación de la identidad es un proceso crítico para la seguridad que permite invalidar un certificado antes de su fecha de caducidad. Esta acción es irreversible. En Lamassu IoT, la revocación se realiza desde la sección de detalle del dispositivo, específicamente desde la línea de tiempo de eventos.",{"_7914":906,"_22115":867,"_18751":34480,"_5":22248,"_15096":34386,"_1571":34481},[],"El proceso de revocación se lleva a cabo de la siguiente manera:",{"_7914":907,"_22115":867,"_18751":34483,"_5":22248,"_15096":34386,"_1571":34484},[],"**Acceder a la revocación**: En la sección **Device Event Timeline**, junto al último certificado **Active**, se encuentra la opción de **Revoke**. Al hacer clic en ella, se abre una ventana de confirmación.",{"_7914":908,"_22115":867,"_18751":34486,"_5":22248,"_15096":34386,"_1571":34487},[],"**Seleccionar el motivo de revocación**: La ventana emergente solicita seleccionar un motivo de revocación (Revocation Reason). Esto es esencial para el registro de auditoría y la generación de la CRL (Certificate Revocation List). Los motivos disponibles, definidos en el **RFC 5280**, y otros adicionales son:",{"_7914":909,"_22115":867,"_18751":34489,"_5":22248,"_15096":34386,"_1571":34490},[],"**Unspecified**: Motivo de revocación no especificado.",{"_7914":910,"_22115":867,"_18751":34492,"_5":22248,"_15096":34386,"_1571":34493},[],"**KeyCompromise**: La clave privada del certificado ha sido comprometida.",{"_7914":911,"_22115":867,"_18751":34495,"_5":22248,"_15096":34386,"_1571":34496},[],"**CACompromise**: La clave privada de la CA ha sido comprometida.",{"_7914":912,"_22115":867,"_18751":34498,"_5":22248,"_15096":34386,"_1571":34499},[],"**AffiliationChanged**: El nombre del sujeto o su afiliación ha cambiado.",{"_7914":913,"_22115":867,"_18751":34501,"_5":22248,"_15096":34386,"_1571":34502},[],"**Superseded**: El certificado ha sido reemplazado por uno nuevo.",{"_7914":914,"_22115":867,"_18751":34504,"_5":22248,"_15096":34386,"_1571":34505},[],"**CessationOfOperation**: La entidad ha dejado de operar o usar el certificado.",{"_7914":915,"_22115":867,"_18751":34507,"_5":22248,"_15096":34386,"_1571":34508},[],"**CertificateHold**: El certificado está temporalmente en espera de revocación.",{"_7914":916,"_22115":867,"_18751":34510,"_5":22248,"_15096":34386,"_1571":34511},[],"**RemoveFromCRL**: Se usa en un *delta-CRL* para indicar que el certificado fue previamente puesto en espera y ahora debe ser revocado definitivamente.",{"_7914":917,"_22115":867,"_18751":34513,"_5":22248,"_15096":34386,"_1571":34514},[],"**PrivilegeWithdrawn**: Se han retirado los privilegios de la entidad asociada al certificado.",{"_7914":918,"_22115":867,"_18751":34516,"_5":22248,"_15096":34386,"_1571":34517},[],"**AACompromise**: La clave de un servidor de autorización de atributos ha sido comprometida.",{"_7914":919,"_22115":867,"_18751":34519,"_5":22248,"_15096":34386,"_1571":34520},[],"**WeakAlgorithmOrKey**: La clave o el algoritmo del certificado se consideran débiles o han sido comprometidos.",{"_7914":920,"_22115":867,"_18751":34522,"_5":22248,"_15096":34386,"_1571":34523},[],"**Confirmar la revocación**: Una vez seleccionado el motivo, se confirma la acción. El estado del certificado cambiará a **Revoked** en la línea de tiempo y en el historial de certificados. El certificado revocado dejará de ser válido.\nEs importante destacar que, una vez revocado un certificado, la identidad del dispositivo puede ser restaurada asignándole un nuevo certificado válido. En caso de que la razón de revocación sea CertificateHold, se permitirá la reactivación.",{"_7914":921,"_22115":867,"_18751":34525,"_5":22248,"_15096":34390,"_1571":34526},[],"El *Decommissioning* es el proceso irreversible de dar de baja un dispositivo de forma definitiva del sistema. A diferencia de la revocación, que sólo invalida el certificado, la desactivación revoca todos los certificados asociados al dispositivo y le impide obtener nuevas identidades en el futuro. Es una acción de seguridad crítica que se utiliza cuando un dispositivo es retirado permanentemente o ya no es de confianza.",{"_7914":922,"_22115":867,"_18751":34528,"_5":22248,"_15096":34390,"_1571":34529},[],"El proceso se realiza de la siguiente manera:",{"_7914":923,"_22115":867,"_18751":34531,"_5":22248,"_15096":34390,"_1571":34532},[],"**Acceder a la acción**: Desde la vista de detalles de un dispositivo activo, se hace clic en el botón **Decommission**.",{"_7914":924,"_22115":867,"_18751":34534,"_5":22248,"_15096":34390,"_1571":34535},[],"**Confirmar la acción irreversible**: Aparecerá una ventana de advertencia que explica que la acción es irreversible y que se revocarán todos los certificados asociados al dispositivo, impidiendo que vuelva a obtener una identidad.",{"_7914":925,"_22115":867,"_18751":34537,"_5":22248,"_15096":34390,"_1571":34538},[],"**Confirmar y desactivar**: Al confirmar la desactivación, el sistema revoca el certificado activo del dispositivo con la razón CessationOfOperation y cambia su estado a **Decommissioned**. El dispositivo ya no podrá realizar operaciones con la PKI.",{"_7914":926,"_22115":926,"_5":22243,"_1571":34540,"_22256":34541,"_18751":34542,"_15096":926},"EST: Enrollment over Secure Transport",[31753,32852,32861],[],{"_7914":927,"_22115":926,"_18751":34544,"_5":22248,"_15096":926,"_1571":34545},[],"Guía del protocolo EST en Lamassu IoT, con la configuración del DMS para el administrador PKI y la referencia de endpoints para el integrador de dispositivos.",{"_7914":928,"_22115":926,"_5":22253,"_18751":34547,"_15096":34548,"_1571":34540},[],"/docs/manual/servicios-core/est#est-enrollment-over-secure-transport",{"_7914":929,"_22115":926,"_5":22253,"_18751":34550,"_15096":34551,"_1571":32935},[],"/docs/manual/servicios-core/est#configuración-del-dms",{"_7914":930,"_22115":926,"_5":22253,"_18751":34553,"_15096":34554,"_1571":32458},[],"/docs/manual/servicios-core/est#requisitos-previos",{"_7914":931,"_22115":926,"_5":22253,"_18751":34556,"_15096":34557,"_1571":34558},[],"/docs/manual/servicios-core/est#configuración-de-enrollment","Configuración de enrollment",{"_7914":932,"_22115":926,"_5":22253,"_18751":34560,"_15096":34561,"_1571":34562},[],"/docs/manual/servicios-core/est#enrollment-device-registration","Enrollment Device Registration",{"_7914":933,"_22115":926,"_5":22253,"_18751":34564,"_15096":34565,"_1571":34566},[],"/docs/manual/servicios-core/est#enrollment-settings","Enrollment Settings",{"_7914":934,"_22115":926,"_5":22253,"_18751":34568,"_15096":34569,"_1571":34570},[],"/docs/manual/servicios-core/est#perfil-de-emisión","Perfil de emisión",{"_7914":935,"_22115":926,"_5":22253,"_18751":34572,"_15096":34573,"_1571":34574},[],"/docs/manual/servicios-core/est#configuración-de-re-enrollment","Configuración de re-enrollment",{"_7914":936,"_22115":926,"_5":22253,"_18751":34576,"_15096":34577,"_1571":34578},[],"/docs/manual/servicios-core/est#configuración-de-serverkeygen","Configuración de ServerKeyGen",{"_7914":937,"_22115":926,"_5":22253,"_18751":34580,"_15096":34581,"_1571":34582},[],"/docs/manual/servicios-core/est#verificar-la-configuración","Verificar la configuración",{"_7914":938,"_22115":926,"_5":22253,"_18751":34584,"_15096":34585,"_1571":34586},[],"/docs/manual/servicios-core/est#integración-de-dispositivos","Integración de dispositivos",{"_7914":939,"_22115":926,"_5":22253,"_18751":34588,"_15096":34589,"_1571":34590},[],"/docs/manual/servicios-core/est#antes-de-empezar","Antes de empezar",{"_7914":940,"_22115":926,"_5":22253,"_18751":34592,"_15096":34593,"_1571":34594},[],"/docs/manual/servicios-core/est#resumen-del-flujo","Resumen del flujo",{"_7914":941,"_22115":926,"_5":22253,"_18751":34596,"_15096":34597,"_1571":34598},[],"/docs/manual/servicios-core/est#modelo-de-autenticación-del-cliente","Modelo de autenticación del cliente",{"_7914":942,"_22115":926,"_5":22253,"_18751":34600,"_15096":34601,"_1571":34602},[],"/docs/manual/servicios-core/est#referencia-de-endpoints","Referencia de endpoints",{"_7914":943,"_22115":926,"_5":22253,"_18751":34604,"_15096":34605,"_1571":34606},[],"/docs/manual/servicios-core/est#cacerts","`/cacerts`",{"_7914":944,"_22115":926,"_5":22253,"_18751":34608,"_15096":34609,"_1571":34610},[],"/docs/manual/servicios-core/est#simpleenroll","`/simpleenroll`",{"_7914":945,"_22115":926,"_5":22253,"_18751":34612,"_15096":34613,"_1571":34614},[],"/docs/manual/servicios-core/est#simplereenroll","`/simplereenroll`",{"_7914":946,"_22115":926,"_5":22253,"_18751":34616,"_15096":34617,"_1571":34618},[],"/docs/manual/servicios-core/est#serverkeygen","`/serverkeygen`",{"_7914":947,"_22115":926,"_5":22253,"_18751":34620,"_15096":34621,"_1571":34622},[],"/docs/manual/servicios-core/est#flujos-completos","Flujos completos",{"_7914":948,"_22115":926,"_5":22253,"_18751":34624,"_15096":34625,"_1571":34626},[],"/docs/manual/servicios-core/est#ejemplo-end-to-end-enroll","Ejemplo end-to-end: enroll",{"_7914":949,"_22115":926,"_5":22253,"_18751":34628,"_15096":34629,"_1571":34630},[],"/docs/manual/servicios-core/est#ejemplo-end-to-end-reenroll","Ejemplo end-to-end: reenroll",{"_7914":950,"_22115":926,"_5":22253,"_18751":34632,"_15096":34633,"_1571":34634},[],"/docs/manual/servicios-core/est#próximos-pasos-tras-el-enrolamiento","Próximos pasos tras el enrolamiento",{"_7914":951,"_22115":926,"_5":22253,"_18751":34636,"_15096":34637,"_1571":34638},[],"/docs/manual/servicios-core/est#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_7914":952,"_22115":926,"_5":22253,"_18751":34640,"_15096":34641,"_1571":34642},[],"/docs/manual/servicios-core/est#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_7914":953,"_22115":926,"_5":22253,"_18751":34644,"_15096":34645,"_1571":34646},[],"/docs/manual/servicios-core/est#notas-de-compatibilidad","Notas de compatibilidad",{"_7914":954,"_22115":926,"_18751":34648,"_5":22248,"_15096":34548,"_1571":34649},[],"Lamassu IoT implementa el protocolo &#x2A;*EST (Enrollment over Secure Transport)** descrito en el RFC 7030 como su único mecanismo de inscripción de certificados para dispositivos. Cada DMS expone los endpoints EST, valida al dispositivo y aplica sus propias políticas de autenticación, registro y renovación — actuando como autoridad de registro (RA) frente al cliente.",{"_7914":955,"_22115":926,"_18751":34651,"_5":22248,"_15096":34548,"_1571":34652},[],"La entidad que emite y firma criptográficamente el certificado es siempre la **CA asociada al DMS**, no el DMS. El DMS coordina el proceso: recibe el CSR, autentica al dispositivo y aplica la política de emisión. Esta distinción es relevante para el administrador PKI al seleccionar la `EnrollmentCA` y para el integrador al interpretar la cadena de confianza recibida de `/cacerts`.",{"_7914":956,"_22115":926,"_18751":34654,"_5":22248,"_15096":34548,"_1571":34655},[],"Esta guía está dividida en dos partes:",{"_7914":957,"_22115":926,"_18751":34657,"_5":22248,"_15096":34548,"_1571":34658},[],"Configuración del DMS, para el administrador PKI.",{"_7914":958,"_22115":926,"_18751":34660,"_5":22248,"_15096":34548,"_1571":34661},[],"Integración de dispositivos, para quien consume los endpoints EST desde firmware, scripts o servicios de aprovisionamiento.",{"_7914":959,"_22115":926,"_18751":34663,"_5":22248,"_15096":34548,"_1571":34664},[],"Si solo necesita una orientación rápida, este es el recorrido recomendado:",{"_7914":960,"_22115":926,"_18751":34666,"_5":22248,"_15096":34548,"_1571":34667},[],"Perfil",{"_7914":961,"_22115":926,"_18751":34669,"_5":22248,"_15096":34548,"_1571":34670},[],"Leer primero",{"_7914":962,"_22115":926,"_18751":34672,"_5":22248,"_15096":34548,"_1571":34673},[],"Después",{"_7914":963,"_22115":926,"_18751":34675,"_5":22248,"_15096":34548,"_1571":34676},[],"Administrador PKI",{"_7914":964,"_22115":926,"_18751":34678,"_5":22248,"_15096":34548,"_1571":32935},[],{"_7914":965,"_22115":926,"_18751":34680,"_5":22248,"_15096":34548,"_1571":34638},[],{"_7914":966,"_22115":926,"_18751":34682,"_5":22248,"_15096":34548,"_1571":34683},[],"Integrador de dispositivos",{"_7914":967,"_22115":926,"_18751":34685,"_5":22248,"_15096":34548,"_1571":34590},[],{"_7914":968,"_22115":926,"_18751":34687,"_5":22248,"_15096":34548,"_1571":34688},[],"Los endpoints `/cacerts`, `/simpleenroll`, `/simplereenroll` o `/serverkeygen`, según el flujo",{"_7914":969,"_22115":926,"_18751":34690,"_5":22248,"_15096":34554,"_1571":34691},[],"Antes de configurar un DMS para EST, deben existir los siguientes recursos en la plataforma:",{"_7914":970,"_22115":926,"_18751":34693,"_5":22248,"_15096":34554,"_1571":34694},[],"**Una CA disponible**: la CA que actuará como `EnrollmentCA` debe estar creada y en estado activo en Lamassu. Si el modo de autenticación es `CLIENT_CERTIFICATE`, también deben estar creadas las CAs de validación del certificado bootstrap.",{"_7914":971,"_22115":926,"_18751":34696,"_5":22248,"_15096":34554,"_1571":34697},[],"**Un DMS creado**: el DMS al que se aplicará esta configuración debe existir previamente. La configuración EST se aplica sobre un DMS existente, no lo crea.",{"_7914":972,"_22115":926,"_18751":34699,"_5":22248,"_15096":34554,"_1571":34700},[],"Conviene separar cuatro bloques de configuración:",{"_7914":973,"_22115":926,"_18751":34702,"_5":22248,"_15096":34554,"_1571":34703},[],"Cómo se realizará el enrollment inicial, incluyendo el modo de alta y la autenticación del cliente.",{"_7914":974,"_22115":926,"_18751":34705,"_5":22248,"_15096":34554,"_1571":34706},[],"Cómo se gestionará el re-enrollment de certificados ya emitidos.",{"_7914":975,"_22115":926,"_18751":34708,"_5":22248,"_15096":34554,"_1571":34709},[],"Cómo se configurará el endpoint cacerts para la distribución de las CAs de confianza utilizadas por los dispositivos.",{"_7914":976,"_22115":926,"_18751":34711,"_5":22248,"_15096":34554,"_1571":34712},[],"Si se habilitará la generación de claves en servidor mediante `ServerKeyGen`.",{"_7914":977,"_22115":926,"_18751":34714,"_5":22248,"_15096":34561,"_1571":34715},[],"En esta sección se define cómo se registran los dispositivos nuevos y con qué credenciales se autentican.",{"_7914":978,"_22115":926,"_18751":34717,"_5":22248,"_15096":34561,"_1571":34718},[],"**Registration Mode**: determina el comportamiento al recibir una inscripción inicial. En modo `JITP` (*Just-In-Time Provisioning*), el dispositivo se crea automáticamente la primera vez que se presenta, aplicando los tags, metadatos e icono definidos en el perfil de aprovisionamiento. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente en la plataforma; si no existe, la solicitud se rechaza con `device not preregistered`. El modo JITP es adecuado para flotas grandes donde el inventario se construye durante el despliegue; el modo `PRE_REGISTRATION` encaja en entornos de alta seguridad donde cada dispositivo se aprueba de forma explícita antes de recibir un certificado.",{"_7914":979,"_22115":926,"_18751":34720,"_5":22248,"_15096":34561,"_1571":34721},[],"**Tags**: se aplican a cada dispositivo creado automáticamente por este DMS. Son opcionales y solo tienen efecto en modo JITP. Los tags permiten mejorar la búsqueda de dispositivos.",{"_7914":980,"_22115":926,"_18751":34723,"_5":22248,"_15096":34561,"_1571":34724},[],"**Icon**: se aplica a cada dispositivo creado automáticamente por este DMS. Es opcional y solo tiene efecto en modo JITP. Únicamente visual.",{"_7914":981,"_22115":926,"_18751":34726,"_5":22248,"_15096":34565,"_1571":34727},[],"**Enrollment CA**: identifica la CA que firmará los certificados de identidad emitidos a través de este DMS. Su elección determina la cadena de confianza que el dispositivo recibirá y la raíz contra la que los sistemas de backend validarán los certificados de flota.",{"_7914":982,"_22115":926,"_18751":34729,"_5":22248,"_15096":34565,"_1571":34730},[],"**Allow Override Enrollment** (`enable_replaceable_enrollment`): permite que un dispositivo ya enrolado vuelva a inscribirse mediante `/simpleenroll`. Cuando está activa, el certificado anterior se revoca con la razón `superseded` y el slot de identidad se actualiza. Cuando está inactiva, un segundo intento de `simpleenroll` se rechaza con `forbiddenNewEnrollment`. Esta opción debe habilitarse con precaución en entornos de producción, ya que permite sustituir la identidad de un dispositivo sin pasar por el flujo de re-enrollment.",{"_7914":983,"_22115":926,"_18751":34732,"_5":22248,"_15096":34565,"_1571":34733},[],"**Verify CSR Signature** (`verify_csr_signature`): controla si el servidor valida la firma del CSR contra la clave pública declarada en él (prueba de posesión PKCS#10). Cuando está inactiva, un solicitante podría enviar un CSR con una clave pública que no controla y obtener un certificado vinculado a ella. Para flotas IoT en redes abiertas debe estar activa.",{"_7914":984,"_22115":926,"_18751":34735,"_5":22248,"_15096":34565,"_1571":34736},[],"**Authentication Mode**: define cómo el DMS valida la identidad del dispositivo durante el enrollment. Los cuatro modos disponibles son:",{"_7914":985,"_22115":926,"_18751":34738,"_5":22248,"_15096":34565,"_1571":34739},[],"Modo",{"_7914":986,"_22115":926,"_18751":34741,"_5":22248,"_15096":34565,"_1571":31956},[],{"_7914":987,"_22115":926,"_18751":34743,"_5":22248,"_15096":34565,"_1571":34744},[],"`CLIENT_CERTIFICATE`",{"_7914":988,"_22115":926,"_18751":34746,"_5":22248,"_15096":34565,"_1571":34747},[],"mTLS. El dispositivo presenta un certificado X.509 emitido por alguna de las CAs declaradas en **Validation CAs**.",{"_7914":989,"_22115":926,"_18751":34749,"_5":22248,"_15096":34565,"_1571":34750},[],"`EXTERNAL_WEBHOOK`",{"_7914":990,"_22115":926,"_18751":34752,"_5":22248,"_15096":34565,"_1571":34753},[],"La decisión de autorización se delega en un servicio HTTP externo. Solo aplica en `/simpleenroll`; en `/simplereenroll` este modo degrada silenciosamente a `NO_AUTH`.",{"_7914":991,"_22115":926,"_18751":34755,"_5":22248,"_15096":34565,"_1571":34756},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_7914":992,"_22115":926,"_18751":34758,"_5":22248,"_15096":34565,"_1571":34759},[],"Combina los dos anteriores: se exige un certificado cliente válido **y** la confirmación del webhook externo.",{"_7914":993,"_22115":926,"_18751":34761,"_5":22248,"_15096":34565,"_1571":34762},[],"`NO_AUTH`",{"_7914":994,"_22115":926,"_18751":34764,"_5":22248,"_15096":34565,"_1571":34765},[],"Sin autenticación. Cualquier CSR se acepta. **Exclusivo para entornos de laboratorio o redes de aprovisionamiento aisladas**; no debe usarse en producción.",{"_7914":995,"_22115":926,"_18751":34767,"_5":22248,"_15096":34565,"_1571":34768},[],"Cuando el modo es `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`, se configuran además estos parámetros:",{"_7914":996,"_22115":926,"_18751":34770,"_5":22248,"_15096":34565,"_1571":34771},[],"**Validation CAs**: lista de CAs de confianza para validar el certificado bootstrap presentado por el dispositivo.",{"_7914":997,"_22115":926,"_18751":34773,"_5":22248,"_15096":34565,"_1571":34774},[],"**Chain Validation Level**: profundidad máxima de la cadena de validación. El valor `-1` valida la cadena completa hasta la CA raíz.",{"_7914":998,"_22115":926,"_18751":34776,"_5":22248,"_15096":34565,"_1571":34777},[],"**Allow Authenticating Expired Certificates**: si está activo, acepta certificados cliente caducados. Es útil en escenarios de recuperación donde el dispositivo no pudo renovar su certificado a tiempo.",{"_7914":999,"_22115":926,"_18751":34779,"_5":22248,"_15096":34565,"_1571":34780},[],"Cuando el modo incluye `EXTERNAL_WEBHOOK`, se configuran además estos parámetros:",{"_7914":1000,"_22115":926,"_18751":34782,"_5":22248,"_15096":34565,"_1571":34783},[],"**Webhook URL**: dirección del servicio externo que decidirá la autorización.",{"_7914":1001,"_22115":926,"_18751":34785,"_5":22248,"_15096":34565,"_1571":34786},[],"**HTTP Method**: método HTTP utilizado para invocar el webhook. Admite `POST` (por defecto) o `PUT`; ambos son equivalentes para el webhook, solo cambia el verbo con el que Lamassu realiza la llamada.",{"_7914":1002,"_22115":926,"_18751":34788,"_5":22248,"_15096":34565,"_1571":34789},[],"**Timeout**: tiempo máximo de espera de la llamada al webhook. Si no se especifica, el valor por defecto es de **10 segundos**; superado ese plazo sin respuesta, Lamassu deniega la operación.",{"_7914":1003,"_22115":926,"_18751":34791,"_5":22248,"_15096":34565,"_1571":34792},[],"**Webhook Authentication Mode**: modo de autenticación del webhook hacia el servicio externo, por ejemplo `ApiKey`, `OIDC` o `mTLS`.",{"_7914":1004,"_22115":926,"_18751":34794,"_5":22248,"_15096":34565,"_1571":34795},[],"El contrato exacto que debe implementar el servicio webhook (esquema de petición y respuesta, ejemplos) está publicado como especificación OpenAPI: referencia del webhook de autorización.",{"_7914":1005,"_22115":926,"_18751":34797,"_5":22248,"_15096":34569,"_1571":34798},[],"El comportamiento del certificado emitido no lo determina únicamente el CSR del dispositivo, sino el **perfil de emisión** (`IssuanceProfile`) asociado al DMS. El integrador no configura este perfil, pero sus reglas afectan al contenido del certificado final:",{"_7914":1006,"_22115":926,"_18751":34800,"_5":22248,"_15096":34569,"_1571":34801},[],"Campo",{"_7914":1007,"_22115":926,"_18751":34803,"_5":22248,"_15096":34569,"_1571":33087},[],{"_7914":1008,"_22115":926,"_18751":34805,"_5":22248,"_15096":34569,"_1571":34806},[],"Efecto sobre el certificado emitido",{"_7914":1009,"_22115":926,"_18751":34808,"_5":22248,"_15096":34569,"_1571":34809},[],"`HonorSubject`",{"_7914":1010,"_22115":926,"_18751":34811,"_5":22248,"_15096":34569,"_1571":20460},[],{"_7914":1011,"_22115":926,"_18751":34813,"_5":22248,"_15096":34569,"_1571":34814},[],"Si `true`, el subject del CSR se traslada literalmente al certificado. Si `false`, la CA aplica la plantilla del perfil e ignora el subject del CSR.",{"_7914":1012,"_22115":926,"_18751":34816,"_5":22248,"_15096":34569,"_1571":34817},[],"`HonorKeyUsage`",{"_7914":1013,"_22115":926,"_18751":34819,"_5":22248,"_15096":34569,"_1571":20460},[],{"_7914":1014,"_22115":926,"_18751":34821,"_5":22248,"_15096":34569,"_1571":34822},[],"Si `true`, el `KeyUsage` del CSR se respeta. Si `false`, se aplica la plantilla del perfil.",{"_7914":1015,"_22115":926,"_18751":34824,"_5":22248,"_15096":34569,"_1571":34825},[],"`HonorExtendedKeyUsages`",{"_7914":1016,"_22115":926,"_18751":34827,"_5":22248,"_15096":34569,"_1571":20460},[],{"_7914":1017,"_22115":926,"_18751":34829,"_5":22248,"_15096":34569,"_1571":34830},[],"Igual que `HonorKeyUsage`, pero para `ExtKeyUsage`.",{"_7914":1018,"_22115":926,"_18751":34832,"_5":22248,"_15096":34569,"_1571":34833},[],"`HonorExtensions`",{"_7914":1019,"_22115":926,"_18751":34835,"_5":22248,"_15096":34569,"_1571":20460},[],{"_7914":1020,"_22115":926,"_18751":34837,"_5":22248,"_15096":34569,"_1571":34838},[],"Controla si el resto de extensiones del CSR (SAN, CDP, etc.) se incluyen en el certificado.",{"_7914":1021,"_22115":926,"_18751":34840,"_5":22248,"_15096":34569,"_1571":34841},[],"Esto es relevante para el integrador: el `KeyUsage`, `ExtKeyUsage` y los SAN que declara el CSR pueden no aparecer tal cual en el certificado final si el perfil así lo decide. Consulte con el administrador PKI si el certificado emitido no contiene las extensiones esperadas.",{"_7914":1022,"_22115":926,"_18751":34843,"_5":22248,"_15096":34573,"_1571":34844},[],"La sección **Re-Enrollment Settings** controla el proceso de renovación de certificados. El re-enrollment puede realizarse únicamente cuando el certificado está dentro de la ventana configurada, y opcionalmente también cuando el certificado ya ha caducado.",{"_7914":1023,"_22115":926,"_18751":34846,"_5":22248,"_15096":34573,"_1571":34847},[],"**Revoke On Re-Enroll**: si está activo, el certificado anterior se revoca automáticamente con la razón `superseded` una vez emitido el nuevo.",{"_7914":1024,"_22115":926,"_18751":34849,"_5":22248,"_15096":34573,"_1571":34850},[],"**Allow Expired Renewal**: permite renovar un certificado ya caducado. Es útil cuando un dispositivo ha estado desconectado y no pudo renovar dentro de la ventana.",{"_7914":1025,"_22115":926,"_18751":34852,"_5":22248,"_15096":34573,"_1571":34853},[],"**Allowed Renewal Delta**: ventana de tiempo previa a la caducidad durante la cual se permite el re-enrollment. Antes de que se abra esta ventana, la solicitud se rechaza con `invalid reenroll window`.",{"_7914":1026,"_22115":926,"_18751":34855,"_5":22248,"_15096":34573,"_1571":34856},[],"**Preventive Renewal Delta**: tiempo previo a la caducidad a partir del cual se emiten alertas de renovación preventiva.",{"_7914":1027,"_22115":926,"_18751":34858,"_5":22248,"_15096":34573,"_1571":34859},[],"**Critical Renewal Delta**: umbral más cercano al vencimiento que activa alertas de estado crítico.",{"_7914":1028,"_22115":926,"_18751":34861,"_5":22248,"_15096":34573,"_1571":34862},[],"**Additional Validation CAs**: CAs adicionales aceptadas como emisoras del certificado en vigor durante el re-enrollment. Permite migrar a una nueva CA de enrolamiento sin interrumpir la renovación de dispositivos ya enrolados con la CA anterior.",{"_7914":1029,"_22115":926,"_18751":34864,"_5":22248,"_15096":34577,"_1571":34865},[],"La sección **Server Key Generation** permite que Lamassu genere el par de claves del dispositivo en el servidor y lo devuelva junto con el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada.",{"_7914":1030,"_22115":926,"_18751":34867,"_5":22248,"_15096":34577,"_1571":34868},[],"La opción **Enable Server-Side Key Generation** activa el endpoint `/serverkeygen`. Cuando está inactiva, cualquier llamada a ese endpoint se rechaza con `server key generation not enabled`.",{"_7914":1031,"_22115":926,"_18751":34870,"_5":22248,"_15096":34577,"_1571":34871},[],"**Key Type** selecciona el algoritmo: `RSA` o `ECDSA`. El campo &#x2A;*Key Size (bits)** determina el tamaño de la clave. Para ECDSA, el tamaño en bits determina también la curva: 256 corresponde a P-256, 384 a P-384 y 521 a P-521.",{"_7914":1032,"_22115":926,"_18751":34873,"_5":22248,"_15096":34577,"_1571":34874},[],"La clave se genera en el motor software del servidor, no en un Crypto Engine de hardware como AWS KMS o PKCS#11. La única protección de la clave en tránsito es el canal TLS; no se aplica cifrado adicional (CMS EnvelopedData) sobre la clave antes de enviarla al dispositivo. Consulte el apartado `/serverkeygen` de la referencia para integrador para conocer el formato exacto de la respuesta y las consideraciones de seguridad.",{"_7914":1033,"_22115":926,"_18751":34876,"_5":22248,"_15096":34581,"_1571":34877},[],"Una vez aplicados los ajustes de enrollment, re-enrollment y ServerKeyGen, puede confirmar que el DMS está operativo de las siguientes formas:",{"_7914":1034,"_22115":926,"_18751":34879,"_5":22248,"_15096":34581,"_1571":34880},[],"**Desde la consola**: accede al detalle del DMS y comprueba que la sección EST muestra la CA de enrolamiento asignada y el modo de autenticación configurado.",{"_7914":1035,"_22115":926,"_18751":34882,"_5":22248,"_15096":34581,"_1571":34883},[],"**Con una solicitud de prueba**: invoca el endpoint `/cacerts` del DMS desde un cliente `curl` con la confianza del servidor. Una respuesta `200 OK` con contenido base64 confirma que el DMS está activo y que la CA de enrolamiento es accesible.",{"_7914":1036,"_22115":926,"_18751":34885,"_5":22248,"_15096":34581,"_1571":34886},[],"Si el DMS no existe o la CA no está disponible, el servidor responde con `DMS not found` u otro mensaje de error. Consulte la sección Diagnóstico y compatibilidad para interpretar los mensajes de error.",{"_7914":1037,"_22115":926,"_18751":34888,"_5":22248,"_15096":34585,"_1571":34889},[],"*Esta sección está dirigida al integrador de dispositivos.*",{"_7914":1038,"_22115":926,"_18751":34891,"_5":22248,"_15096":34585,"_1571":34892},[],"Los endpoints EST de Lamassu se publican bajo el prefijo `/.well-known/est` y exigen siempre la presencia del segmento de ruta `{aps}`, que se interpreta como el identificador del DMS al que se dirige la operación. La asociación es directa: el valor de `{aps}` recibido en la URL se utiliza como ID de DMS al consultar el almacén interno. Las variantes registradas sin `{aps}` (por ejemplo `/.well-known/est/cacerts`) están enrutadas en el código, pero su gestor exige el campo `APS` y devuelve `400 Bad Request` con el mensaje `Field validation for 'APS' failed` cuando el segmento no se proporciona.",{"_7914":1039,"_22115":926,"_18751":34894,"_5":22248,"_15096":34585,"_1571":34895},[],"Esta parte sigue el orden habitual de trabajo del integrador: primero los requisitos previos y el modelo de autenticación, después la referencia de cada endpoint y, al final, ejemplos completos y material de diagnóstico.",{"_7914":1040,"_22115":926,"_18751":34897,"_5":22248,"_15096":34589,"_1571":34898},[],"El administrador PKI debe haber configurado un DMS con el protocolo `EST_RFC7030`, una CA de enrolamiento asignada y al menos un modo de autenticación. Sin esa configuración previa, Lamassu rechaza cualquier solicitud de enrolamiento. Los detalles de esa configuración se encuentran en la sección de configuración del DMS de esta misma página.",{"_7914":1041,"_22115":926,"_18751":34900,"_5":22248,"_15096":34589,"_1571":34901},[],"Antes de realizar la primera llamada, asegúrese de tener:",{"_7914":1042,"_22115":926,"_18751":34903,"_5":22248,"_15096":34589,"_1571":34904},[],"Elemento",{"_7914":1043,"_22115":926,"_18751":34906,"_5":22248,"_15096":34589,"_1571":31956},[],{"_7914":1044,"_22115":926,"_18751":34908,"_5":22248,"_15096":34589,"_1571":34909},[],"**URL del host EST**",{"_7914":1045,"_22115":926,"_18751":34911,"_5":22248,"_15096":34589,"_1571":34912},[],"Dirección base del servidor, por ejemplo `https://est.lamassu.example`. La proporciona el administrador PKI.",{"_7914":1046,"_22115":926,"_18751":34914,"_5":22248,"_15096":34589,"_1571":34915},[],"**Ancla de confianza del servidor** (`lamassu-trust.pem`)",{"_7914":1047,"_22115":926,"_18751":34917,"_5":22248,"_15096":34589,"_1571":34918},[],"Certificado raíz o intermedio con el que validar el TLS del servidor Lamassu. Sin él, el cliente rechazará el certificado del servidor.",{"_7914":1048,"_22115":926,"_18751":34920,"_5":22248,"_15096":34589,"_1571":34921},[],"**Certificado bootstrap + clave privada**",{"_7914":1049,"_22115":926,"_18751":34923,"_5":22248,"_15096":34589,"_1571":34924},[],"Solo para modos `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`. Es el certificado de aprovisionamiento emitido por alguna de las `ValidationCAs` del DMS, normalmente una CA dedicada al provisioning y distinta de la CA de enrolamiento.",{"_7914":1050,"_22115":926,"_18751":34926,"_5":22248,"_15096":34589,"_1571":34927},[],"**ID del DMS** (`{aps}`)",{"_7914":1051,"_22115":926,"_18751":34929,"_5":22248,"_15096":34589,"_1571":34930},[],"Identificador del DMS que aparece en todas las rutas EST. Lo proporciona el administrador PKI.",{"_7914":1052,"_22115":926,"_18751":34932,"_5":22248,"_15096":34593,"_1571":34933},[],"Caso",{"_7914":1053,"_22115":926,"_18751":34935,"_5":22248,"_15096":34593,"_1571":34936},[],"Credencial habitual",{"_7914":1054,"_22115":926,"_18751":34938,"_5":22248,"_15096":34593,"_1571":34939},[],"Endpoint principal",{"_7914":1055,"_22115":926,"_18751":34941,"_5":22248,"_15096":34593,"_1571":34942},[],"Resultado",{"_7914":1056,"_22115":926,"_18751":34944,"_5":22248,"_15096":34593,"_1571":34945},[],"Alta inicial",{"_7914":1057,"_22115":926,"_18751":34947,"_5":22248,"_15096":34593,"_1571":34948},[],"Certificado bootstrap o el modo definido en `AuthMode`",{"_7914":1058,"_22115":926,"_18751":34950,"_5":22248,"_15096":34593,"_1571":34610},[],{"_7914":1059,"_22115":926,"_18751":34952,"_5":22248,"_15096":34593,"_1571":34953},[],"Certificado de dispositivo",{"_7914":1060,"_22115":926,"_18751":34955,"_5":22248,"_15096":34593,"_1571":34956},[],"Renovación",{"_7914":1061,"_22115":926,"_18751":34958,"_5":22248,"_15096":34593,"_1571":34959},[],"Certificado actual del dispositivo",{"_7914":1062,"_22115":926,"_18751":34961,"_5":22248,"_15096":34593,"_1571":34614},[],{"_7914":1063,"_22115":926,"_18751":34963,"_5":22248,"_15096":34593,"_1571":34964},[],"Certificado renovado",{"_7914":1064,"_22115":926,"_18751":34966,"_5":22248,"_15096":34593,"_1571":34967},[],"Descarga de confianza",{"_7914":1065,"_22115":926,"_18751":34969,"_5":22248,"_15096":34593,"_1571":34970},[],"TLS del servidor",{"_7914":1066,"_22115":926,"_18751":34972,"_5":22248,"_15096":34593,"_1571":34606},[],{"_7914":1067,"_22115":926,"_18751":34974,"_5":22248,"_15096":34593,"_1571":34975},[],"PKCS#7 o PEM con certificados",{"_7914":1068,"_22115":926,"_18751":34977,"_5":22248,"_15096":34593,"_1571":34978},[],"Clave generada en servidor",{"_7914":1069,"_22115":926,"_18751":34980,"_5":22248,"_15096":34593,"_1571":34981},[],"Igual que `/simpleenroll`",{"_7914":1070,"_22115":926,"_18751":34983,"_5":22248,"_15096":34593,"_1571":34618},[],{"_7914":1071,"_22115":926,"_18751":34985,"_5":22248,"_15096":34593,"_1571":34986},[],"Clave privada PKCS#8 + certificado",{"_7914":1072,"_22115":926,"_18751":34988,"_5":22248,"_15096":34597,"_1571":34989},[],"La implementación de Lamassu reconoce cuatro configuraciones de autenticación para `/simpleenroll`, expresadas mediante el campo `EnrollmentOptionsESTRFC7030.AuthMode` del DMS. Tres son modos simples (`CLIENT_CERTIFICATE`, `EXTERNAL_WEBHOOK`, `NO_AUTH`) y una combina dos controles (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`). El cliente debe presentarse en el modo que el DMS espera; cualquier otra combinación genera un fallo en la inscripción.",{"_7914":1073,"_22115":926,"_18751":34991,"_5":22248,"_15096":34597,"_1571":34992},[],"Modo (`AuthMode`)",{"_7914":1074,"_22115":926,"_18751":34994,"_5":22248,"_15096":34597,"_1571":31956},[],{"_7914":1075,"_22115":926,"_18751":34996,"_5":22248,"_15096":34597,"_1571":34997},[],"Credencial esperada",{"_7914":1076,"_22115":926,"_18751":34999,"_5":22248,"_15096":34597,"_1571":35000},[],"Aplica en enroll",{"_7914":1077,"_22115":926,"_18751":35002,"_5":22248,"_15096":34597,"_1571":35003},[],"Aplica en reenroll",{"_7914":1078,"_22115":926,"_18751":35005,"_5":22248,"_15096":34597,"_1571":34744},[],{"_7914":1079,"_22115":926,"_18751":35007,"_5":22248,"_15096":34597,"_1571":35008},[],"mTLS con certificado X.509",{"_7914":1080,"_22115":926,"_18751":35010,"_5":22248,"_15096":34597,"_1571":35011},[],"Certificado y clave privada cliente",{"_7914":1081,"_22115":926,"_18751":35013,"_5":22248,"_15096":34597,"_1571":33100},[],{"_7914":1082,"_22115":926,"_18751":35015,"_5":22248,"_15096":34597,"_1571":35016},[],"Sí (con el certificado en vigor)",{"_7914":1083,"_22115":926,"_18751":35018,"_5":22248,"_15096":34597,"_1571":34756},[],{"_7914":1084,"_22115":926,"_18751":35020,"_5":22248,"_15096":34597,"_1571":35021},[],"mTLS más validación por webhook",{"_7914":1085,"_22115":926,"_18751":35023,"_5":22248,"_15096":34597,"_1571":35024},[],"Certificado y clave privada cliente, más aprobación del webhook",{"_7914":1086,"_22115":926,"_18751":35026,"_5":22248,"_15096":34597,"_1571":33100},[],{"_7914":1087,"_22115":926,"_18751":35028,"_5":22248,"_15096":34597,"_1571":35029},[],"No como combinación; en reenroll no mantiene ambos controles",{"_7914":1088,"_22115":926,"_18751":35031,"_5":22248,"_15096":34597,"_1571":34750},[],{"_7914":1089,"_22115":926,"_18751":35033,"_5":22248,"_15096":34597,"_1571":35034},[],"Webhook externo de autorización",{"_7914":1090,"_22115":926,"_18751":35036,"_5":22248,"_15096":34597,"_1571":35037},[],"Ninguna en el canal TLS",{"_7914":1091,"_22115":926,"_18751":35039,"_5":22248,"_15096":34597,"_1571":33100},[],{"_7914":1092,"_22115":926,"_18751":35041,"_5":22248,"_15096":34597,"_1571":35042},[],"No, degrada a `NO_AUTH`",{"_7914":1093,"_22115":926,"_18751":35044,"_5":22248,"_15096":34597,"_1571":34762},[],{"_7914":1094,"_22115":926,"_18751":35046,"_5":22248,"_15096":34597,"_1571":35047},[],"Sin autenticación",{"_7914":1095,"_22115":926,"_18751":35049,"_5":22248,"_15096":34597,"_1571":35050},[],"Ninguna",{"_7914":1096,"_22115":926,"_18751":35052,"_5":22248,"_15096":34597,"_1571":35053},[],"Sí (uso restringido)",{"_7914":1097,"_22115":926,"_18751":35055,"_5":22248,"_15096":34597,"_1571":35053},[],{"_7914":1098,"_22115":926,"_18751":35057,"_5":22248,"_15096":34597,"_1571":35058},[],"JWT **no es un modo de autenticación válido en EST**. El extractor de identidad JWT existe en el código pero solo se evalúa en la API de administración de Lamassu. Cualquier *Bearer token* enviado a `/.well-known/est/...` se ignora silenciosamente. Cuando el DMS está configurado con `AuthMode: CLIENT_CERTIFICATE`, una petición que solo aporte JWT se rechaza por falta de certificado cliente. Cuando el DMS está en `AuthMode: NO_AUTH`, la petición se procesa como tal y el JWT no añade ni resta autorización.",{"_7914":1099,"_22115":926,"_18751":35060,"_5":22248,"_15096":34597,"_1571":35061},[],"**`CLIENT_CERTIFICATE`**: el cliente presenta un certificado X.509 emitido por una de las CAs declaradas en `AuthOptionsMTLS.ValidationCAs`. El proceso valida la cadena del certificado contra esas CAs mediante los parámetros `ValidationCAs`, `AllowExpired` y `ChainLevelValidation`. Además, el servicio comprueba el estado de revocación en tres pasos: primero busca el cert en la base de datos local de Lamassu; si no lo encuentra, consulta los responders OCSP listados en la extensión AIA; si OCSP falla, intenta los CRL Distribution Points (CDP). Un certificado revocado interrumpe la inscripción con `certificate is revoked`.",{"_7914":1100,"_22115":926,"_18751":35063,"_5":22248,"_15096":34597,"_1571":33084},[],{"_7914":1101,"_22115":926,"_18751":35065,"_5":22248,"_15096":34597,"_1571":33087},[],{"_7914":1102,"_22115":926,"_18751":35067,"_5":22248,"_15096":34597,"_1571":31956},[],{"_7914":1103,"_22115":926,"_18751":35069,"_5":22248,"_15096":34597,"_1571":35070},[],"`ValidationCAs`",{"_7914":1104,"_22115":926,"_18751":35072,"_5":22248,"_15096":34597,"_1571":35073},[],"lista de IDs de CA",{"_7914":1105,"_22115":926,"_18751":35075,"_5":22248,"_15096":34597,"_1571":35076},[],"CAs de confianza para validar el certificado bootstrap (en enroll) o el certificado en vigor (en reenroll).",{"_7914":1106,"_22115":926,"_18751":35078,"_5":22248,"_15096":34597,"_1571":35079},[],"`AllowExpired`",{"_7914":1107,"_22115":926,"_18751":35081,"_5":22248,"_15096":34597,"_1571":20460},[],{"_7914":1108,"_22115":926,"_18751":35083,"_5":22248,"_15096":34597,"_1571":35084},[],"Si está activado, acepta certificados cliente caducados. Si es `false`, los certificados expirados se rechazan.",{"_7914":1109,"_22115":926,"_18751":35086,"_5":22248,"_15096":34597,"_1571":35087},[],"`ChainLevelValidation`",{"_7914":1110,"_22115":926,"_18751":35089,"_5":22248,"_15096":34597,"_1571":4288},[],{"_7914":1111,"_22115":926,"_18751":35091,"_5":22248,"_15096":34597,"_1571":35092},[],"Si es mayor que cero, recorta la cadena de validación al número de niveles indicado.",{"_7914":1112,"_22115":926,"_18751":35094,"_5":22248,"_15096":34597,"_1571":35095},[],"**`EXTERNAL_WEBHOOK`**: Lamassu delega la decisión de autorización en un servicio HTTP externo. El servidor EST construye una petición `POST` al webhook configurado con un cuerpo JSON que reproduce el contexto de la inscripción.",{"_7914":1113,"_22115":926,"_18751":35097,"_5":22248,"_15096":34597,"_1571":35098},[],"El valor del campo `csr` es la **codificación base64 del PEM** del CSR (no el DER, y no el PEM en claro). El webhook debe responder con `2xx` y un cuerpo JSON `{\"authorized\": true}` para continuar; cualquier otra respuesta aborta el enrolamiento con `external webhook denied enrollment`. Un `204 No Content` **no es una respuesta válida** aunque sea un código `2xx`: Lamassu exige un cuerpo JSON con el campo `authorized`, así que un webhook que responda sin cuerpo deniega la operación igual que un error.",{"_7914":1114,"_22115":926,"_18751":35100,"_5":22248,"_15096":34597,"_1571":35101},[],"**`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`**: combina los dos modos anteriores durante `/simpleenroll` — el cliente debe presentar un certificado mTLS válido y el webhook debe devolver `authorized: true`. En `/simplereenroll` la combinación no se conserva: el chequeo conjunto mTLS + webhook no se mantiene, por lo que el integrador no debe asumir que las mismas garantías del enrollment inicial aplican en reenroll.",{"_7914":1115,"_22115":926,"_18751":35103,"_5":22248,"_15096":34597,"_1571":35104},[],"**`NO_AUTH`**: el DMS acepta cualquier CSR sin validar identidad del cliente. Lamassu emite un aviso en su log (`DMS is configured with NoAuth, allowing enrollment`) y procede al alta. Debe restringirse a entornos controlados (una red de aprovisionamiento aislada); cualquier red expuesta a internet con un DMS en `NO_AUTH` queda abierta a la emisión de certificados por terceros no autorizados.",{"_7914":1116,"_22115":926,"_18751":35106,"_5":22248,"_15096":34601,"_1571":35107},[],"Las siguientes secciones describen los endpoints en el orden más habitual de uso dentro del ciclo de vida del dispositivo:",{"_7914":1117,"_22115":926,"_18751":35109,"_5":22248,"_15096":34601,"_1571":35110},[],"`/cacerts`: descarga de la cadena de confianza.",{"_7914":1118,"_22115":926,"_18751":35112,"_5":22248,"_15096":34601,"_1571":35113},[],"`/simpleenroll`: inscripción inicial del certificado.",{"_7914":1119,"_22115":926,"_18751":35115,"_5":22248,"_15096":34601,"_1571":35116},[],"`/simplereenroll`: renovación de un certificado ya emitido.",{"_7914":1120,"_22115":926,"_18751":35118,"_5":22248,"_15096":34601,"_1571":35119},[],"`/serverkeygen`: inscripción con generación de clave en servidor.",{"_7914":1121,"_22115":926,"_18751":35121,"_5":22248,"_15096":34605,"_1571":35122},[],"El endpoint `GET /.well-known/est/{aps}/cacerts` distribuye los certificados que el dispositivo necesita para validar al servidor EST y al resto de las CAs gestionadas por el DMS. Lamassu inserta los certificados en este orden: primero el certificado **downstream** del servidor Lamassu, que es la hoja TLS del servidor y no una CA, útil para pinning si `IncludeLamassuSystemCA` está activado; después la lista `ManagedCAs` declarada en el DMS; y por último la CA de enrolamiento, si `IncludeEnrollmentCA` está activado.",{"_7914":1122,"_22115":926,"_18751":35124,"_5":22248,"_15096":34605,"_1571":35125},[],"Campo de `CADistributionSettings`",{"_7914":1123,"_22115":926,"_18751":35127,"_5":22248,"_15096":34605,"_1571":33087},[],{"_7914":1124,"_22115":926,"_18751":35129,"_5":22248,"_15096":34605,"_1571":31956},[],{"_7914":1125,"_22115":926,"_18751":35131,"_5":22248,"_15096":34605,"_1571":35132},[],"`IncludeLamassuSystemCA`",{"_7914":1126,"_22115":926,"_18751":35134,"_5":22248,"_15096":34605,"_1571":20460},[],{"_7914":1127,"_22115":926,"_18751":35136,"_5":22248,"_15096":34605,"_1571":35137},[],"Incluye el certificado *downstream* del servidor Lamassu, es decir, la hoja TLS que el cliente puede usar para anclar la conexión. Es un cert de extremo, no una CA.",{"_7914":1128,"_22115":926,"_18751":35139,"_5":22248,"_15096":34605,"_1571":35140},[],"`IncludeEnrollmentCA`",{"_7914":1129,"_22115":926,"_18751":35142,"_5":22248,"_15096":34605,"_1571":20460},[],{"_7914":1130,"_22115":926,"_18751":35144,"_5":22248,"_15096":34605,"_1571":35145},[],"Incluye la CA emisora del DMS, es decir, la que firmará los certificados de dispositivo.",{"_7914":1131,"_22115":926,"_18751":35147,"_5":22248,"_15096":34605,"_1571":35148},[],"`ManagedCAs`",{"_7914":1132,"_22115":926,"_18751":35150,"_5":22248,"_15096":34605,"_1571":35073},[],{"_7914":1133,"_22115":926,"_18751":35152,"_5":22248,"_15096":34605,"_1571":35153},[],"CAs adicionales que se publican como anclas de confianza al dispositivo.",{"_7914":1134,"_22115":926,"_18751":35155,"_5":22248,"_15096":34605,"_1571":35156},[],"El formato por defecto es PKCS#7 *degenerate* (sólo certificados) codificado en base64. La respuesta declara `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El base64 viene troceado en líneas de **76 caracteres** terminadas en CRLF, una anchura conforme con S/MIME (RFC 5751), no los 64 que sugieren ciertas guías de RFC 7030. Este troceo aplica únicamente a `/cacerts` y `/simpleenroll`; las partes internas de `/serverkeygen` no llevan wrap, como se explica más abajo.",{"_7914":1135,"_22115":926,"_18751":35158,"_5":22248,"_15096":34605,"_1571":35159},[],"El PKCS#7 *degenerate* es un **conjunto** de certificados sin orden semántico definido. Aunque Lamassu los inserta en el orden indicado, el integrador no debe asumir ese orden al validar cadenas: la cadena debe construirse por correspondencia `Subject`/`Issuer` (o por AKI/SKI), no por la posición en la respuesta.",{"_7914":1136,"_22115":926,"_18751":35161,"_5":22248,"_15096":34605,"_1571":35162},[],"El flag `-i` (ignore garbage) ayuda a tolerar el CRLF que Lamassu añade y es necesario en algunos `base64` (BusyBox, BSD); en GNU coreutils se ignora.",{"_7914":1137,"_22115":926,"_18751":35164,"_5":22248,"_15096":34605,"_1571":35165},[],"Lamassu añade además una extensión sobre el RFC: si el cliente envía la cabecera `Accept: application/x-pem-file`, el servidor responde con la concatenación PEM de los mismos certificados, sin el envoltorio PKCS#7. Esto facilita el consumo desde scripts. La extensión también funciona en `/simpleenroll` y `/simplereenroll`.",{"_7914":1138,"_22115":926,"_18751":35167,"_5":22248,"_15096":34609,"_1571":35168},[],"El endpoint `POST /.well-known/est/{aps}/simpleenroll` recibe un CSR y devuelve el certificado emitido. El cuerpo de la petición debe ser el **PKCS#10 (CSR) en DER, codificado en base64** sin saltos de línea. La base64 envuelve directamente al DER, no al PEM. La cabecera `Content-Type` debe valer `application/pkcs10`. Si el `Content-Type` es diferente, el servidor responde `400` con `content-type must be application/pkcs10`; si el cuerpo no es base64 válido, responde `400` con `body payload must be base64 encoded`.",{"_7914":1139,"_22115":926,"_18751":35170,"_5":22248,"_15096":34609,"_1571":35171},[],"La respuesta sigue el mismo envoltorio que `/cacerts`: PKCS#7 *degenerate* en base64, con `Content-Type: application/pkcs7-mime; smime-type=certs-only`. El PKCS#7 contiene **únicamente el certificado de hoja** recién emitido; no incluye la CA emisora ni intermediarios. Esto cumple RFC 7030 §4.2.3 (donde la cadena es opcional) pero implica que el integrador debe combinar este certificado con la cadena obtenida de `/cacerts` antes de presentarlo a cualquier relying party que valide cadena completa (por ejemplo, un broker MQTT con mTLS estricta).",{"_7914":1140,"_22115":926,"_18751":35173,"_5":22248,"_15096":34609,"_1571":35174},[],"Varios campos del DMS gobiernan el comportamiento de `/simpleenroll`. El integrador no los configura, pero conviene conocerlos para interpretar los rechazos.",{"_7914":1141,"_22115":926,"_18751":35176,"_5":22248,"_15096":34609,"_1571":34801},[],{"_7914":1142,"_22115":926,"_18751":35178,"_5":22248,"_15096":34609,"_1571":33087},[],{"_7914":1143,"_22115":926,"_18751":35180,"_5":22248,"_15096":34609,"_1571":35181},[],"Efecto",{"_7914":1144,"_22115":926,"_18751":35183,"_5":22248,"_15096":34609,"_1571":35184},[],"`EnrollmentSettings.RegistrationMode`",{"_7914":1145,"_22115":926,"_18751":35186,"_5":22248,"_15096":34609,"_1571":35187},[],"`JITP` / `PRE_REGISTRATION`",{"_7914":1146,"_22115":926,"_18751":35189,"_5":22248,"_15096":34609,"_1571":35190},[],"Decide si el dispositivo se crea automáticamente en la primera inscripción (`JITP`) o si debe existir previamente (`PRE_REGISTRATION`).",{"_7914":1147,"_22115":926,"_18751":35192,"_5":22248,"_15096":34609,"_1571":35193},[],"`EnrollmentSettings.EnableReplaceableEnrollment`",{"_7914":1148,"_22115":926,"_18751":35195,"_5":22248,"_15096":34609,"_1571":20460},[],{"_7914":1149,"_22115":926,"_18751":35197,"_5":22248,"_15096":34609,"_1571":35198},[],"Si es `true`, un dispositivo ya enrolado puede volver a inscribirse mediante `/simpleenroll`; el certificado anterior se revoca con razón `superseded`. Si es `false`, el segundo intento se rechaza con `forbiddenNewEnrollment`.",{"_7914":1150,"_22115":926,"_18751":35200,"_5":22248,"_15096":34609,"_1571":35201},[],"`EnrollmentSettings.VerifyCSRSignature`",{"_7914":1151,"_22115":926,"_18751":35203,"_5":22248,"_15096":34609,"_1571":20460},[],{"_7914":1152,"_22115":926,"_18751":35205,"_5":22248,"_15096":34609,"_1571":35206},[],"Si es `true`, el servidor valida la firma del CSR contra la clave pública declarada en él (proof-of-possession estándar de PKCS#10/RFC 2986). Si es `false`, se omite la prueba de posesión. Para flotas IoT en redes abiertas debe estar en `true`.",{"_7914":1153,"_22115":926,"_18751":35208,"_5":22248,"_15096":34609,"_1571":35209},[],"En modo `JITP`, el primer `simpleenroll` con un `CommonName` que aún no existe en Lamassu crea el dispositivo automáticamente. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente; un `CommonName` desconocido se rechaza con `device not preregistered`. Consulte Configuración de enrollment para más detalles sobre ambos modos y el comportamiento del perfil de emisión.",{"_7914":1154,"_22115":926,"_18751":35211,"_5":22248,"_15096":34613,"_1571":35212},[],"El endpoint `POST /.well-known/est/{aps}/simplereenroll` renueva el certificado de un dispositivo ya enrolado. El formato del cuerpo es idéntico al de `/simpleenroll` (DER base64 sin saltos, `Content-Type: application/pkcs10`). La diferencia está en la autenticación: el cliente debe presentar **el certificado en vigor** del dispositivo (no el bootstrap) como credencial mTLS.",{"_7914":1155,"_22115":926,"_18751":35214,"_5":22248,"_15096":34613,"_1571":35215},[],"Si el DMS está configurado con `AuthMode: EXTERNAL_WEBHOOK`, el webhook **no se invoca** durante `/simplereenroll`. El flujo de renovación degrada silenciosamente a `NO_AUTH`: cualquier cliente que conozca un `CommonName` válido puede solicitar reenroll para ese dispositivo sin autenticación (`allowing reenroll: using NO AUTH mode` en el log). Un DMS con `EXTERNAL_WEBHOOK` no debe usarse en producción para flujos de reenroll a menos que se controle la red de acceso al endpoint.",{"_7914":1156,"_22115":926,"_18751":35217,"_5":22248,"_15096":34613,"_1571":35218},[],"El comportamiento del reenroll está condicionado por varios campos de `ReEnrollmentSettings`:",{"_7914":1157,"_22115":926,"_18751":35220,"_5":22248,"_15096":34613,"_1571":34801},[],{"_7914":1158,"_22115":926,"_18751":35222,"_5":22248,"_15096":34613,"_1571":33087},[],{"_7914":1159,"_22115":926,"_18751":35224,"_5":22248,"_15096":34613,"_1571":35181},[],{"_7914":1160,"_22115":926,"_18751":35226,"_5":22248,"_15096":34613,"_1571":35227},[],"`ReEnrollmentDelta`",{"_7914":1161,"_22115":926,"_18751":35229,"_5":22248,"_15096":34613,"_1571":35230},[],"duración",{"_7914":1162,"_22115":926,"_18751":35232,"_5":22248,"_15096":34613,"_1571":35233},[],"Define la ventana de renovación: el cliente solo puede renovar a partir de `NotAfter - ReEnrollmentDelta`. Antes de ese instante, el servidor responde con `invalid reenroll window`.",{"_7914":1163,"_22115":926,"_18751":35235,"_5":22248,"_15096":34613,"_1571":35236},[],"`EnableExpiredRenewal`",{"_7914":1164,"_22115":926,"_18751":35238,"_5":22248,"_15096":34613,"_1571":20460},[],{"_7914":1165,"_22115":926,"_18751":35240,"_5":22248,"_15096":34613,"_1571":35241},[],"Si es `true`, acepta certificados ya caducados como prueba de identidad. Si es `false`, un certificado expirado provoca `expired certificate`.",{"_7914":1166,"_22115":926,"_18751":35243,"_5":22248,"_15096":34613,"_1571":35244},[],"`RevokeOnReEnrollment`",{"_7914":1167,"_22115":926,"_18751":35246,"_5":22248,"_15096":34613,"_1571":20460},[],{"_7914":1168,"_22115":926,"_18751":35248,"_5":22248,"_15096":34613,"_1571":35249},[],"Si es `true`, revoca automáticamente el certificado anterior tras emitir el nuevo, con la razón `superseded` (código 4 de RFC 5280).",{"_7914":1169,"_22115":926,"_18751":35251,"_5":22248,"_15096":34613,"_1571":35252},[],"`AdditionalValidationCAs`",{"_7914":1170,"_22115":926,"_18751":35254,"_5":22248,"_15096":34613,"_1571":35073},[],{"_7914":1171,"_22115":926,"_18751":35256,"_5":22248,"_15096":34613,"_1571":35257},[],"CAs adicionales que el servidor admite como emisores válidos del certificado en vigor, además de la CA de enrolamiento del DMS.",{"_7914":1172,"_22115":926,"_18751":35259,"_5":22248,"_15096":34613,"_1571":35260},[],"**Inmutabilidad del subject**: el CSR de renovación debe tener exactamente el mismo subject que el certificado en vigor. Lamassu compara, byte a byte, el `RawSubject` del CSR con el del certificado (`slices.Compare`). Si los bytes difieren, el servidor cae a una comparación semántica de respaldo sobre los atributos `CommonName`, `OrganizationalUnit`, `Organization`, `Locality`, `Province` y `Country`. Si todos esos atributos coinciden, el reenroll continúa pese a la diferencia de bytes (rescata casos donde solo cambia la codificación, `PrintableString` frente a `UTF8String`). Si algún atributo difiere, el reenroll se aborta con `invalid RawSubject bytes`. El integrador debe regenerar el CSR con exactamente el mismo subject que en la inscripción inicial para no depender del comportamiento de fallback.",{"_7914":1173,"_22115":926,"_18751":35262,"_5":22248,"_15096":34613,"_1571":35263},[],"**Validación de la cadena del certificado presentado**: la validación se intenta primero contra la CA de enrolamiento del DMS; si falla, recorre las `AdditionalValidationCAs`. La validación es \"shallow\": cada CA se prueba como ancla, no se compone una cadena multinivel. El cliente debe presentar la cadena completa en el handshake mTLS. Un certificado revocado aborta el reenroll con `certificate is revoked`.",{"_7914":1174,"_22115":926,"_18751":35265,"_5":22248,"_15096":34617,"_1571":35266},[],"El endpoint `POST /.well-known/est/{aps}/serverkeygen` permite que Lamassu genere el par de claves del dispositivo en el servidor y devuelva, en la misma respuesta, la clave privada y el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada o flujos donde la clave se aprovisiona durante la fabricación.",{"_7914":1175,"_22115":926,"_18751":35268,"_5":22248,"_15096":34617,"_1571":35269},[],"Este endpoint requiere que `ServerKeyGen.Enabled` valga `true` en el DMS. Si no está activado, el servidor responde con `server key generation not enabled`. La autenticación se aplica igual que en `/simpleenroll`: el integrador presenta la credencial que corresponda al `AuthMode` del DMS.",{"_7914":1176,"_22115":926,"_18751":35271,"_5":22248,"_15096":34617,"_1571":35272},[],"El algoritmo y el tamaño de la clave generada se deciden por el DMS, no por el cliente.",{"_7914":1177,"_22115":926,"_18751":35274,"_5":22248,"_15096":34617,"_1571":35275},[],"Tipo de clave",{"_7914":1178,"_22115":926,"_18751":35277,"_5":22248,"_15096":34617,"_1571":35278},[],"Parámetro válido",{"_7914":1179,"_22115":926,"_18751":35280,"_5":22248,"_15096":34617,"_1571":35281},[],"Curva NIST equivalente",{"_7914":1180,"_22115":926,"_18751":35283,"_5":22248,"_15096":34617,"_1571":35284},[],"Comportamiento ante valores no válidos",{"_7914":1181,"_22115":926,"_18751":35286,"_5":22248,"_15096":34617,"_1571":35287},[],"`RSA`",{"_7914":1182,"_22115":926,"_18751":35289,"_5":22248,"_15096":34617,"_1571":35290},[],"Cualquier número de bits aceptado por `crypto/rsa` (típico: 2048, 3072, 4096)",{"_7914":1183,"_22115":926,"_18751":35292,"_5":22248,"_15096":34617,"_1571":35293},[],"No aplica",{"_7914":1184,"_22115":926,"_18751":35295,"_5":22248,"_15096":34617,"_1571":35296},[],"Si el valor no es válido para RSA, la generación falla y devuelve `500`.",{"_7914":1185,"_22115":926,"_18751":35298,"_5":22248,"_15096":34617,"_1571":35299},[],"`ECDSA`",{"_7914":1186,"_22115":926,"_18751":35301,"_5":22248,"_15096":34617,"_1571":35302},[],"224, 256, 384, 521",{"_7914":1187,"_22115":926,"_18751":35304,"_5":22248,"_15096":34617,"_1571":35305},[],"P-224 / P-256 (prime256v1) / P-384 / P-521",{"_7914":1188,"_22115":926,"_18751":35307,"_5":22248,"_15096":34617,"_1571":35308},[],"Cualquier otro valor degrada **silenciosamente** a P-256, solo con un aviso en log (`invalid key size of N for ECDSA. Defaulting to 256 curve`). El cliente no recibe error: el certificado se emite con una curva distinta de la solicitada.",{"_7914":1189,"_22115":926,"_18751":35310,"_5":22248,"_15096":34617,"_1571":35311},[],"El CSR enviado por el cliente sirve únicamente para transportar el subject y las extensiones; la prueba de posesión PKCS#10 no aplica aquí porque el cliente no es quien generó la clave. Lamassu descarta la clave pública del CSR original, genera un par de claves nuevo con su entropía interna, en motor software y no en un Crypto Engine de hardware como AWS KMS o PKCS#11, construye un CSR nuevo con esa clave y procede a una inscripción interna equivalente a `/simpleenroll`.",{"_7914":1190,"_22115":926,"_18751":35313,"_5":22248,"_15096":34617,"_1571":35314},[],"La respuesta es un `multipart/mixed` con el boundary literal `estServerLamassuBoundary`. Contiene dos partes:",{"_7914":1191,"_22115":926,"_18751":35316,"_5":22248,"_15096":34617,"_1571":35317},[],"La clave privada en formato **PKCS#8 sin cifrar**, codificada en base64 dentro de una parte con `Content-Type: application/pkcs8`.",{"_7914":1192,"_22115":926,"_18751":35319,"_5":22248,"_15096":34617,"_1571":35320},[],"El certificado emitido en PKCS#7 *degenerate* base64, dentro de una parte con `Content-Type: application/pkcs7-mime; smime-type=certs-only`.",{"_7914":1193,"_22115":926,"_18751":35322,"_5":22248,"_15096":34617,"_1571":35323},[],"A diferencia de `/cacerts` y `/simpleenroll`, donde el base64 va troceado en líneas de 76 caracteres, cada parte de `/serverkeygen` viaja como **una única línea base64 sin saltos**. Cualquier proxy inverso que reescriba el cuerpo (por ejemplo, normalizando line endings) puede romper el parseo.",{"_7914":1194,"_22115":926,"_18751":35325,"_5":22248,"_15096":34617,"_1571":35326},[],"Este endpoint invierte el principio PKI por el que el subscriber controla su clave privada. La clave se serializa en PKCS#8 sin cifrar (`PrivateKeyInfo`, sin `EncryptedPrivateKeyInfo`). No se aplica el envoltorio CMS `EnvelopedData` contemplado en RFC 7030 §4.4.2; no se aplica AES key wrap ni cifrado simétrico por contraseña. La única protección es el TLS del canal. El integrador debe garantizar que: (a) ningún proxy inverso termine TLS y registre el cuerpo de la respuesta; (b) la clave se cifre en reposo inmediatamente tras recibirla; (c) la cuenta de auditoría en el servidor Lamassu queda como punto único de origen de la clave.",{"_7914":1195,"_22115":926,"_18751":35328,"_5":22248,"_15096":34617,"_1571":35329},[],"Para separar las dos partes, el siguiente fragmento usa `awk` con el boundary literal. Funciona con la estructura exacta de Lamassu (cada parte = headers + línea en blanco + una sola línea base64); cualquier proxy intermedio que reescriba el cuerpo lo romperá.",{"_7914":1196,"_22115":926,"_18751":35331,"_5":22248,"_15096":34621,"_1571":35332},[],"Una vez revisados los endpoints por separado, estos ejemplos muestran cómo encadenarlos en dos escenarios habituales: el alta inicial de un dispositivo y la renovación de un certificado ya emitido.",{"_7914":1197,"_22115":926,"_18751":35334,"_5":22248,"_15096":34625,"_1571":35335},[],"El siguiente script ilustra el proceso completo de inscripción de un dispositivo con clave EC P-256 generada localmente y autenticación mTLS contra un certificado bootstrap.",{"_7914":1198,"_22115":926,"_18751":35337,"_5":22248,"_15096":34629,"_1571":35338},[],"El siguiente script reproduce un proceso de renovación: detecta la expiración del certificado actual, regenera el CSR con el **mismo subject** y se autentica con el certificado en vigor.",{"_7914":1199,"_22115":926,"_18751":35340,"_5":22248,"_15096":34633,"_1571":35341},[],"Una vez que el dispositivo ha obtenido su certificado de identidad, los pasos habituales son:",{"_7914":1200,"_22115":926,"_18751":35343,"_5":22248,"_15096":34633,"_1571":35344},[],"**Instalar la cadena de confianza** (`cacerts.pem`) en el almacén de confianza del dispositivo. El broker MQTT, el servidor HTTPS o cualquier relying party que valide mTLS necesitará esta cadena.",{"_7914":1201,"_22115":926,"_18751":35346,"_5":22248,"_15096":34633,"_1571":35347},[],"**Combinar el certificado de hoja con la cadena** antes de presentarlo en conexiones mTLS. La respuesta de `/simpleenroll` contiene solo el certificado de hoja; el relying party puede rechazar la conexión si no recibe la cadena completa.",{"_7914":1202,"_22115":926,"_18751":35349,"_5":22248,"_15096":34633,"_1571":35350},[],"**Planificar la renovación**: configurar en el dispositivo un temporizador que invoque `/simplereenroll` dentro de la ventana `ReEnrollmentDelta` antes de la caducidad del certificado. No espere a que caduque salvo que `EnableExpiredRenewal` esté activo.",{"_7914":1203,"_22115":926,"_18751":35352,"_5":22248,"_15096":34641,"_1571":35353},[],"Lamassu mapea casi todos los errores de negocio a `500 Internal Server Error`, no a `4xx`. El código de estado HTTP no es suficiente para distinguir entre un error de red y un error de política. El integrador debe inspeccionar el campo `err` del cuerpo JSON (`{\"err\": \"<mensaje>\"}`) para determinar la causa exacta del fallo.",{"_7914":1204,"_22115":926,"_18751":35355,"_5":22248,"_15096":34641,"_1571":35356},[],"HTTP",{"_7914":1205,"_22115":926,"_18751":35358,"_5":22248,"_15096":34641,"_1571":35359},[],"Mensaje",{"_7914":1206,"_22115":926,"_18751":35361,"_5":22248,"_15096":34641,"_1571":35362},[],"Causa",{"_7914":1207,"_22115":926,"_18751":35364,"_5":22248,"_15096":34641,"_1571":35365},[],"Acción del integrador",{"_7914":1208,"_22115":926,"_18751":35367,"_5":22248,"_15096":34641,"_1571":19571},[],{"_7914":1209,"_22115":926,"_18751":35369,"_5":22248,"_15096":34641,"_1571":35370},[],"`Field validation for 'APS' failed`",{"_7914":1210,"_22115":926,"_18751":35372,"_5":22248,"_15096":34641,"_1571":35373},[],"El segmento `{aps}` falta en la URL.",{"_7914":1211,"_22115":926,"_18751":35375,"_5":22248,"_15096":34641,"_1571":35376},[],"Incluir el ID del DMS en la ruta.",{"_7914":1212,"_22115":926,"_18751":35378,"_5":22248,"_15096":34641,"_1571":19571},[],{"_7914":1213,"_22115":926,"_18751":35380,"_5":22248,"_15096":34641,"_1571":35381},[],"`content-type must be application/pkcs10`",{"_7914":1214,"_22115":926,"_18751":35383,"_5":22248,"_15096":34641,"_1571":35384},[],"Cabecera `Content-Type` ausente o incorrecta.",{"_7914":1215,"_22115":926,"_18751":35386,"_5":22248,"_15096":34641,"_1571":35387},[],"Fijar `Content-Type: application/pkcs10`.",{"_7914":1216,"_22115":926,"_18751":35389,"_5":22248,"_15096":34641,"_1571":19571},[],{"_7914":1217,"_22115":926,"_18751":35391,"_5":22248,"_15096":34641,"_1571":35392},[],"`body payload must be base64 encoded`",{"_7914":1218,"_22115":926,"_18751":35394,"_5":22248,"_15096":34641,"_1571":35395},[],"El cuerpo no es base64 válido.",{"_7914":1219,"_22115":926,"_18751":35397,"_5":22248,"_15096":34641,"_1571":35398},[],"Usar `base64 -w 0` para evitar saltos de línea.",{"_7914":1220,"_22115":926,"_18751":35400,"_5":22248,"_15096":34641,"_1571":20096},[],{"_7914":1221,"_22115":926,"_18751":35402,"_5":22248,"_15096":34641,"_1571":35403},[],"`DMS not found`",{"_7914":1222,"_22115":926,"_18751":35405,"_5":22248,"_15096":34641,"_1571":35406},[],"El valor `{aps}` no se corresponde con ningún DMS.",{"_7914":1223,"_22115":926,"_18751":35408,"_5":22248,"_15096":34641,"_1571":35409},[],"Verificar el identificador con el administrador PKI.",{"_7914":1224,"_22115":926,"_18751":35411,"_5":22248,"_15096":34641,"_1571":20096},[],{"_7914":1225,"_22115":926,"_18751":35413,"_5":22248,"_15096":34641,"_1571":35414},[],"`invalid certificate`",{"_7914":1226,"_22115":926,"_18751":35416,"_5":22248,"_15096":34641,"_1571":35417},[],"El certificado cliente no es válido contra `ValidationCAs`.",{"_7914":1227,"_22115":926,"_18751":35419,"_5":22248,"_15096":34641,"_1571":35420},[],"Comprobar la cadena del certificado bootstrap.",{"_7914":1228,"_22115":926,"_18751":35422,"_5":22248,"_15096":34641,"_1571":20096},[],{"_7914":1229,"_22115":926,"_18751":35424,"_5":22248,"_15096":34641,"_1571":35425},[],"`certificate is revoked`",{"_7914":1230,"_22115":926,"_18751":35427,"_5":22248,"_15096":34641,"_1571":35428},[],"El certificado **presentado como credencial mTLS** está revocado en Lamassu o vía OCSP/CRL externos.",{"_7914":1231,"_22115":926,"_18751":35430,"_5":22248,"_15096":34641,"_1571":35431},[],"Solicitar un nuevo certificado bootstrap o investigar la revocación.",{"_7914":1232,"_22115":926,"_18751":35433,"_5":22248,"_15096":34641,"_1571":20096},[],{"_7914":1233,"_22115":926,"_18751":35435,"_5":22248,"_15096":34641,"_1571":35436},[],"`revoked certificate`",{"_7914":1234,"_22115":926,"_18751":35438,"_5":22248,"_15096":34641,"_1571":35439},[],"En reenroll, el certificado **activo del dispositivo en la base de datos** figura como revocado.",{"_7914":1235,"_22115":926,"_18751":35441,"_5":22248,"_15096":34641,"_1571":35442},[],"Revisar el estado del slot de identidad; si la revocación fue intencional, emitir un nuevo enroll en lugar de reenroll.",{"_7914":1236,"_22115":926,"_18751":35444,"_5":22248,"_15096":34641,"_1571":20096},[],{"_7914":1237,"_22115":926,"_18751":35446,"_5":22248,"_15096":34641,"_1571":35447},[],"`expired certificate`",{"_7914":1238,"_22115":926,"_18751":35449,"_5":22248,"_15096":34641,"_1571":35450},[],"El certificado presentado ha caducado y el DMS no permite `AllowExpired`/`EnableExpiredRenewal`.",{"_7914":1239,"_22115":926,"_18751":35452,"_5":22248,"_15096":34641,"_1571":35453},[],"Renovar antes de la caducidad o solicitar habilitar `EnableExpiredRenewal`.",{"_7914":1240,"_22115":926,"_18751":35455,"_5":22248,"_15096":34641,"_1571":20096},[],{"_7914":1241,"_22115":926,"_18751":35457,"_5":22248,"_15096":34641,"_1571":35458},[],"`forbiddenNewEnrollment`",{"_7914":1242,"_22115":926,"_18751":35460,"_5":22248,"_15096":34641,"_1571":35461},[],"El dispositivo ya está enrolado y `EnableReplaceableEnrollment` es `false`.",{"_7914":1243,"_22115":926,"_18751":35463,"_5":22248,"_15096":34641,"_1571":35464},[],"Usar `/simplereenroll` o pedir al administrador que habilite el flag.",{"_7914":1244,"_22115":926,"_18751":35466,"_5":22248,"_15096":34641,"_1571":20096},[],{"_7914":1245,"_22115":926,"_18751":35468,"_5":22248,"_15096":34641,"_1571":35469},[],"`device not preregistered`",{"_7914":1246,"_22115":926,"_18751":35471,"_5":22248,"_15096":34641,"_1571":35472},[],"El DMS está en `PRE_REGISTRATION` y el dispositivo no existe.",{"_7914":1247,"_22115":926,"_18751":35474,"_5":22248,"_15096":34641,"_1571":35475},[],"Registrar el dispositivo antes de inscribirlo.",{"_7914":1248,"_22115":926,"_18751":35477,"_5":22248,"_15096":34641,"_1571":20096},[],{"_7914":1249,"_22115":926,"_18751":35479,"_5":22248,"_15096":34641,"_1571":35480},[],"`invalid reenroll window`",{"_7914":1250,"_22115":926,"_18751":35482,"_5":22248,"_15096":34641,"_1571":35483},[],"Se intenta renovar antes de `NotAfter - ReEnrollmentDelta`.",{"_7914":1251,"_22115":926,"_18751":35485,"_5":22248,"_15096":34641,"_1571":35486},[],"Esperar a la apertura de la ventana o pedir un `ReEnrollmentDelta` mayor.",{"_7914":1252,"_22115":926,"_18751":35488,"_5":22248,"_15096":34641,"_1571":20096},[],{"_7914":1253,"_22115":926,"_18751":35490,"_5":22248,"_15096":34641,"_1571":35491},[],"`invalid RawSubject bytes`",{"_7914":1254,"_22115":926,"_18751":35493,"_5":22248,"_15096":34641,"_1571":35494},[],"El subject del CSR de renovación no coincide con el del certificado en vigor.",{"_7914":1255,"_22115":926,"_18751":35496,"_5":22248,"_15096":34641,"_1571":35497},[],"Regenerar el CSR con el subject exacto del cert anterior.",{"_7914":1256,"_22115":926,"_18751":35499,"_5":22248,"_15096":34641,"_1571":20096},[],{"_7914":1257,"_22115":926,"_18751":35501,"_5":22248,"_15096":34641,"_1571":35502},[],"`external webhook denied enrollment`",{"_7914":1258,"_22115":926,"_18751":35504,"_5":22248,"_15096":34641,"_1571":35505},[],"El webhook devolvió un código no `2xx` o `authorized != true`.",{"_7914":1259,"_22115":926,"_18751":35507,"_5":22248,"_15096":34641,"_1571":35508},[],"Revisar los logs del servicio webhook.",{"_7914":1260,"_22115":926,"_18751":35510,"_5":22248,"_15096":34641,"_1571":20096},[],{"_7914":1261,"_22115":926,"_18751":35512,"_5":22248,"_15096":34641,"_1571":35513},[],"`server key generation not enabled`",{"_7914":1262,"_22115":926,"_18751":35515,"_5":22248,"_15096":34641,"_1571":35516},[],"`/serverkeygen` está deshabilitado en el DMS.",{"_7914":1263,"_22115":926,"_18751":35518,"_5":22248,"_15096":34641,"_1571":35519},[],"Pedir al administrador activar `ServerKeyGen.Enabled`.",{"_7914":1264,"_22115":926,"_18751":35521,"_5":22248,"_15096":34641,"_1571":35522},[],"Para los mensajes que no figuren en esta tabla, los logs del servidor Lamassu (con los campos `func`, `dms`, `device-cn`, `step`, `auth-method`, `auth-status`) son el primer lugar donde buscar la causa.",{"_7914":1265,"_22115":926,"_18751":35524,"_5":22248,"_15096":34645,"_1571":35525},[],"La implementación de Lamassu se ajusta al RFC 7030 en lo esencial pero introduce varias particularidades que pueden afectar a clientes EST estrictos o a librerías de terceros:",{"_7914":1266,"_22115":926,"_18751":35527,"_5":22248,"_15096":34645,"_1571":35528},[],"Los endpoints `/csrattrs` y `/fullcmc` del RFC 7030 **no están implementados** en Lamassu. Un cliente que invoque `/.well-known/est/<DMS_ID>/csrattrs` recibirá `404 Not Found` en lugar del `204 No Content` que el RFC sugiere para \"sin atributos\". Las librerías EST estrictas deben configurarse para no intentar `csrattrs`.",{"_7914":1267,"_22115":926,"_18751":35530,"_5":22248,"_15096":34645,"_1571":35531},[],"El base64 de la respuesta de `/cacerts` y `/simpleenroll` se trocea en líneas de **76 caracteres** terminadas con CRLF (conforme con S/MIME, RFC 5751). Las partes de `/serverkeygen` no aplican wrap.",{"_7914":1268,"_22115":926,"_18751":35533,"_5":22248,"_15096":34645,"_1571":35534},[],"El boundary del `multipart/mixed` en `/serverkeygen` está fijado y no se puede negociar.",{"_7914":1269,"_22115":926,"_18751":35536,"_5":22248,"_15096":34645,"_1571":35537},[],"El segmento `{aps}` es **obligatorio** en todas las rutas EST. Las rutas registradas sin `{aps}` están en el código pero responden `400`.",{"_7914":1270,"_22115":926,"_18751":35539,"_5":22248,"_15096":34645,"_1571":35540},[],"El cuerpo de `/cacerts`, `/simpleenroll` y `/simplereenroll` puede devolverse como PEM concatenado si el cliente envía `Accept: application/x-pem-file`. Esta es una extensión específica de Lamassu y no aparece en el RFC.",{"_7914":1271,"_22115":926,"_18751":35542,"_5":22248,"_15096":34645,"_1571":35543},[],"El servidor no rechaza explícitamente CSRs firmados con SHA-1 o MD5; el integrador debe generar el CSR con SHA-256 o superior.",{"_7914":1272,"_22115":926,"_18751":35545,"_5":22248,"_15096":34645,"_1571":35546},[],"<Card title=\"Visión general del DMS\" href=\"/docs/manual/servicios-core/ra\" />",{"_7914":1273,"_22115":926,"_18751":35548,"_5":22248,"_15096":34645,"_1571":35549},[],"<Card title=\"Validación OCSP\" href=\"/docs/manual/servicios-core/validation-ocsp\" />",{"_7914":1274,"_22115":926,"_18751":35551,"_5":22248,"_15096":34645,"_1571":35552},[],"<Card title=\"Gestionar dispositivos\" href=\"/docs/manual/servicios-core/devices\" />",{"_7914":1275,"_22115":1275,"_5":22243,"_1571":35554,"_22256":35555,"_18751":35556,"_15096":1275},"[KMS] Gestión de Claves Criptográficas",[31753,32852,32861],[],{"_7914":1276,"_22115":1275,"_18751":35558,"_5":22248,"_15096":1275,"_1571":35559},[],"Gestión y operación de claves criptográficas en Lamassu IoT",{"_7914":1277,"_22115":1275,"_5":22253,"_18751":35561,"_15096":35562,"_1571":35563},[],"/docs/manual/servicios-core/kms#gestión-de-claves-criptográficas","Gestión de claves criptográficas",{"_7914":1278,"_22115":1275,"_5":22253,"_18751":35565,"_15096":35566,"_1571":35567},[],"/docs/manual/servicios-core/kms#qué-resuelve-el-kms","Qué resuelve el KMS",{"_7914":1279,"_22115":1275,"_5":22253,"_18751":35569,"_15096":35570,"_1571":35571},[],"/docs/manual/servicios-core/kms#motores-criptográficos","Motores criptográficos",{"_7914":1280,"_22115":1275,"_5":22253,"_18751":35573,"_15096":35574,"_1571":35575},[],"/docs/manual/servicios-core/kms#inventario-de-claves","Inventario de claves",{"_7914":1281,"_22115":1275,"_5":22253,"_18751":35577,"_15096":35578,"_1571":35579},[],"/docs/manual/servicios-core/kms#crear-o-importar-claves","Crear o importar claves",{"_7914":1282,"_22115":1275,"_5":22253,"_18751":35581,"_15096":35582,"_1571":35583},[],"/docs/manual/servicios-core/kms#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_7914":1283,"_22115":1275,"_5":22253,"_18751":35585,"_15096":35586,"_1571":35587},[],"/docs/manual/servicios-core/kms#importar-un-par-existente","Importar un par existente",{"_7914":1284,"_22115":1275,"_5":22253,"_18751":35589,"_15096":35590,"_1571":35591},[],"/docs/manual/servicios-core/kms#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_7914":1285,"_22115":1275,"_5":22253,"_18751":35593,"_15096":35594,"_1571":35595},[],"/docs/manual/servicios-core/kms#ver-detalles","Ver detalles",{"_7914":1286,"_22115":1275,"_5":22253,"_18751":35597,"_15096":35598,"_1571":35599},[],"/docs/manual/servicios-core/kms#firmar-y-verificar","Firmar y verificar",{"_7914":1287,"_22115":1275,"_5":22253,"_18751":35601,"_15096":35602,"_1571":35603},[],"/docs/manual/servicios-core/kms#sign","Sign",{"_7914":1288,"_22115":1275,"_5":22253,"_18751":35605,"_15096":35606,"_1571":35607},[],"/docs/manual/servicios-core/kms#verify","Verify",{"_7914":1289,"_22115":1275,"_5":22253,"_18751":35609,"_15096":35610,"_1571":35611},[],"/docs/manual/servicios-core/kms#generar-un-csr","Generar un CSR",{"_7914":1290,"_22115":1275,"_5":22253,"_18751":35613,"_15096":35614,"_1571":35615},[],"/docs/manual/servicios-core/kms#firma-local-con-pkcs11","Firma local con PKCS#11",{"_7914":1291,"_22115":1275,"_18751":35617,"_5":22248,"_15096":35562,"_1571":35618},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_7914":1292,"_22115":1275,"_18751":35620,"_5":22248,"_15096":35562,"_1571":35621},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_7914":1293,"_22115":1275,"_18751":35623,"_5":22248,"_15096":35566,"_1571":35624},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_7914":1294,"_22115":1275,"_18751":35626,"_5":22248,"_15096":35566,"_1571":35627},[],"En la práctica, permite:",{"_7914":1295,"_22115":1275,"_18751":35629,"_5":22248,"_15096":35566,"_1571":35630},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_7914":1296,"_22115":1275,"_18751":35632,"_5":22248,"_15096":35566,"_1571":35633},[],"Importar claves creadas externamente.",{"_7914":1297,"_22115":1275,"_18751":35635,"_5":22248,"_15096":35566,"_1571":35636},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_7914":1298,"_22115":1275,"_18751":35638,"_5":22248,"_15096":35566,"_1571":35639},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_7914":1299,"_22115":1275,"_18751":35641,"_5":22248,"_15096":35570,"_1571":35642},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_7914":1300,"_22115":1275,"_18751":35644,"_5":22248,"_15096":35570,"_1571":35645},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_7914":1301,"_22115":1275,"_18751":35647,"_5":22248,"_15096":35570,"_1571":35648},[],"Actualmente, Lamassu soporta los siguientes motores:",{"_7914":1302,"_22115":1275,"_18751":35650,"_5":22248,"_15096":35570,"_1571":35651},[],"Crypto Engine",{"_7914":1303,"_22115":1275,"_18751":35653,"_5":22248,"_15096":35570,"_1571":35654},[],"Nivel de seguridad",{"_7914":1304,"_22115":1275,"_18751":35656,"_5":22248,"_15096":35570,"_1571":35657},[],"OnPrem / Cloud",{"_7914":1305,"_22115":1275,"_18751":35659,"_5":22248,"_15096":35570,"_1571":35660},[],"Coste adicional",{"_7914":1306,"_22115":1275,"_18751":35662,"_5":22248,"_15096":35570,"_1571":35663},[],"Generación de claves",{"_7914":1307,"_22115":1275,"_18751":35665,"_5":22248,"_15096":35570,"_1571":35666},[],"Persistencia *at-rest* segura",{"_7914":1308,"_22115":1275,"_18751":35668,"_5":22248,"_15096":35570,"_1571":35669},[],"Filtración de claves",{"_7914":1309,"_22115":1275,"_18751":35671,"_5":22248,"_15096":35570,"_1571":35672},[],"Consideraciones",{"_7914":1310,"_22115":1275,"_18751":35674,"_5":22248,"_15096":35570,"_1571":35675},[],"File System",{"_7914":1311,"_22115":1275,"_18751":35677,"_5":22248,"_15096":35570,"_1571":11239},[],{"_7914":1312,"_22115":1275,"_18751":35679,"_5":22248,"_15096":35570,"_1571":35680},[],"OnPrem y Cloud",{"_7914":1313,"_22115":1275,"_18751":35682,"_5":22248,"_15096":35570,"_1571":33152},[],{"_7914":1314,"_22115":1275,"_18751":35684,"_5":22248,"_15096":35570,"_1571":35685},[],"**Entropía software**. La generación se realiza con las librerías criptográficas de Go.",{"_7914":1315,"_22115":1275,"_18751":35687,"_5":22248,"_15096":35570,"_1571":35688},[],"**Insegura**. Delegada en el sistema de archivos.",{"_7914":1316,"_22115":1275,"_18751":35690,"_5":22248,"_15096":35570,"_1571":35688},[],{"_7914":1317,"_22115":1275,"_18751":35692,"_5":22248,"_15096":35570,"_1571":35693},[],"No recomendado para producción.",{"_7914":1318,"_22115":1275,"_18751":35695,"_5":22248,"_15096":35570,"_1571":35696},[],"HashiCorp Vault",{"_7914":1319,"_22115":1275,"_18751":35698,"_5":22248,"_15096":35570,"_1571":4002},[],{"_7914":1320,"_22115":1275,"_18751":35700,"_5":22248,"_15096":35570,"_1571":35680},[],{"_7914":1321,"_22115":1275,"_18751":35702,"_5":22248,"_15096":35570,"_1571":33152},[],{"_7914":1322,"_22115":1275,"_18751":35704,"_5":22248,"_15096":35570,"_1571":35705},[],"Depende de la configuración de Vault.",{"_7914":1323,"_22115":1275,"_18751":35707,"_5":22248,"_15096":35570,"_1571":35708},[],"**Segura**",{"_7914":1324,"_22115":1275,"_18751":35710,"_5":22248,"_15096":35570,"_1571":35711},[],"**Insegura**. Un administrador con permisos suficientes puede visualizar la clave privada.",{"_7914":1325,"_22115":1275,"_18751":35713,"_5":22248,"_15096":35570,"_1571":35714},[],"Conviene limitar al máximo el acceso administrativo y custodiar correctamente las claves de *unseal*.",{"_7914":1326,"_22115":1275,"_18751":35716,"_5":22248,"_15096":35570,"_1571":35717},[],"AWS Secrets Manager",{"_7914":1327,"_22115":1275,"_18751":35719,"_5":22248,"_15096":35570,"_1571":4002},[],{"_7914":1328,"_22115":1275,"_18751":35721,"_5":22248,"_15096":35570,"_1571":35722},[],"Cloud",{"_7914":1329,"_22115":1275,"_18751":35724,"_5":22248,"_15096":35570,"_1571":33100},[],{"_7914":1330,"_22115":1275,"_18751":35726,"_5":22248,"_15096":35570,"_1571":35727},[],"Depende del proceso de alta de la clave.",{"_7914":1331,"_22115":1275,"_18751":35729,"_5":22248,"_15096":35570,"_1571":35708},[],{"_7914":1332,"_22115":1275,"_18751":35731,"_5":22248,"_15096":35570,"_1571":35711},[],{"_7914":1333,"_22115":1275,"_18751":35733,"_5":22248,"_15096":35570,"_1571":35734},[],"La protección *at-rest* la proporciona AWS, pero no evita el acceso administrativo al material privado.",{"_7914":1334,"_22115":1275,"_18751":35736,"_5":22248,"_15096":35570,"_1571":35737},[],"AWS KMS",{"_7914":1335,"_22115":1275,"_18751":35739,"_5":22248,"_15096":35570,"_1571":13367},[],{"_7914":1336,"_22115":1275,"_18751":35741,"_5":22248,"_15096":35570,"_1571":35722},[],{"_7914":1337,"_22115":1275,"_18751":35743,"_5":22248,"_15096":35570,"_1571":33100},[],{"_7914":1338,"_22115":1275,"_18751":35745,"_5":22248,"_15096":35570,"_1571":35746},[],"**Entropía hardware**",{"_7914":1339,"_22115":1275,"_18751":35748,"_5":22248,"_15096":35570,"_1571":35708},[],{"_7914":1340,"_22115":1275,"_18751":35750,"_5":22248,"_15096":35570,"_1571":35708},[],{"_7914":1341,"_22115":1275,"_18751":35752,"_5":22248,"_15096":35570,"_1571":35753},[],"Aunque la clave privada no se expone, un actor con permisos suficientes podría usarla para firmar artefactos.",{"_7914":1342,"_22115":1275,"_18751":35755,"_5":22248,"_15096":35570,"_1571":35756},[],"PKCS11",{"_7914":1343,"_22115":1275,"_18751":35758,"_5":22248,"_15096":35570,"_1571":35759},[],"3\\*",{"_7914":1344,"_22115":1275,"_18751":35761,"_5":22248,"_15096":35570,"_1571":35762},[],"AirGap OnPrem y Cloud",{"_7914":1345,"_22115":1275,"_18751":35764,"_5":22248,"_15096":35570,"_1571":35765},[],"Depende del hardware o del servicio usado. Puede integrarse con HSMs OnPrem o con ofertas Key as a Service.",{"_7914":1346,"_22115":1275,"_18751":35767,"_5":22248,"_15096":35570,"_1571":35746},[],{"_7914":1347,"_22115":1275,"_18751":35769,"_5":22248,"_15096":35570,"_1571":35770},[],"**Segura**\\*",{"_7914":1348,"_22115":1275,"_18751":35772,"_5":22248,"_15096":35570,"_1571":35773},[],"Depende del HSM",{"_7914":1349,"_22115":1275,"_18751":35775,"_5":22248,"_15096":35570,"_1571":35776},[],"El nivel real depende de la implementación PKCS11 y del HSM utilizado.",{"_7914":1350,"_22115":1275,"_18751":35778,"_5":22248,"_15096":35570,"_1571":35779},[],"Lamassu muestra en la consola el listado completo de motores habilitados.",{"_7914":1351,"_22115":1275,"_18751":35781,"_5":22248,"_15096":35570,"_1571":35782},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_7914":1352,"_22115":1275,"_18751":35784,"_5":22248,"_15096":35570,"_1571":35785},[],"Durante el despliegue es obligatorio definir un motor por defecto. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_7914":1353,"_22115":1275,"_18751":35787,"_5":22248,"_15096":35574,"_1571":35788},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_7914":1354,"_22115":1275,"_18751":35790,"_5":22248,"_15096":35574,"_1571":35791},[],"La tabla incluye los siguientes campos:",{"_7914":1355,"_22115":1275,"_18751":35793,"_5":22248,"_15096":35574,"_1571":35794},[],"**Name**: nombre descriptivo de la clave.",{"_7914":1356,"_22115":1275,"_18751":35796,"_5":22248,"_15096":35574,"_1571":35797},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_7914":1357,"_22115":1275,"_18751":35799,"_5":22248,"_15096":35574,"_1571":35800},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_7914":1358,"_22115":1275,"_18751":35802,"_5":22248,"_15096":35574,"_1571":35803},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_7914":1359,"_22115":1275,"_18751":35805,"_5":22248,"_15096":35574,"_1571":35806},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_7914":1360,"_22115":1275,"_18751":35808,"_5":22248,"_15096":35574,"_1571":35809},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_7914":1361,"_22115":1275,"_18751":35811,"_5":22248,"_15096":35574,"_1571":35812},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_7914":1362,"_22115":1275,"_18751":35814,"_5":22248,"_15096":35574,"_1571":35815},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_7914":1363,"_22115":1275,"_18751":35817,"_5":22248,"_15096":35574,"_1571":35818},[],"Desde esta vista también se accede a las acciones más habituales:",{"_7914":1364,"_22115":1275,"_18751":35820,"_5":22248,"_15096":35574,"_1571":35821},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_7914":1365,"_22115":1275,"_18751":35823,"_5":22248,"_15096":35574,"_1571":35824},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_7914":1366,"_22115":1275,"_18751":35826,"_5":22248,"_15096":35574,"_1571":35827},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_7914":1367,"_22115":1275,"_18751":35829,"_5":22248,"_15096":35574,"_1571":35830},[],"**Delete Key** para eliminar la clave del sistema.",{"_7914":1368,"_22115":1275,"_18751":35832,"_5":22248,"_15096":35578,"_1571":35833},[],"El alta de claves se realiza desde el asistente que se abre con **Create New Key**.",{"_7914":1369,"_22115":1275,"_18751":35835,"_5":22248,"_15096":35582,"_1571":35836},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_7914":1370,"_22115":1275,"_18751":35838,"_5":22248,"_15096":35582,"_1571":35839},[],"En la primera pantalla del asistente, elija **Generate New Key Pair** y después defina los parámetros principales:",{"_7914":1371,"_22115":1275,"_18751":35841,"_5":22248,"_15096":35582,"_1571":35842},[],"**Key Name**: nombre único y descriptivo.",{"_7914":1372,"_22115":1275,"_18751":35844,"_5":22248,"_15096":35582,"_1571":35845},[],"**Crypto Engine**: motor que custodiará la clave.",{"_7914":1373,"_22115":1275,"_18751":35847,"_5":22248,"_15096":35582,"_1571":35848},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_7914":1374,"_22115":1275,"_18751":35850,"_5":22248,"_15096":35582,"_1571":35851},[],"**Tags**: metadatos para clasificar la clave.",{"_7914":1375,"_22115":1275,"_18751":35853,"_5":22248,"_15096":35582,"_1571":35854},[],"**Metadata**: información adicional para usos avanzados.",{"_7914":1376,"_22115":1275,"_18751":35856,"_5":22248,"_15096":35586,"_1571":35857},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_7914":1377,"_22115":1275,"_18751":35859,"_5":22248,"_15096":35586,"_1571":35860},[],"Cuando la clave se ha generado en un entorno aislado o en un HSM externo.",{"_7914":1378,"_22115":1275,"_18751":35862,"_5":22248,"_15096":35586,"_1571":35863},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_7914":1379,"_22115":1275,"_18751":35865,"_5":22248,"_15096":35586,"_1571":35866},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_7914":1380,"_22115":1275,"_18751":35868,"_5":22248,"_15096":35586,"_1571":35869},[],"En el asistente, elija **Import Existing Key Pair** y complete los campos solicitados:",{"_7914":1381,"_22115":1275,"_18751":35871,"_5":22248,"_15096":35586,"_1571":35872},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_7914":1382,"_22115":1275,"_18751":35874,"_5":22248,"_15096":35586,"_1571":35875},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_7914":1383,"_22115":1275,"_18751":35877,"_5":22248,"_15096":35586,"_1571":35878},[],"**Tags**: etiquetas para organización y búsqueda.",{"_7914":1384,"_22115":1275,"_18751":35880,"_5":22248,"_15096":35586,"_1571":35881},[],"**Metadata**: información adicional opcional.",{"_7914":1385,"_22115":1275,"_18751":35883,"_5":22248,"_15096":35586,"_1571":35884},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_7914":1386,"_22115":1275,"_18751":35886,"_5":22248,"_15096":35586,"_1571":35887},[],"Una vez completado el asistente, la clave queda almacenada en el motor seleccionado y puede utilizarse para firma, generación de CSR y el resto de operaciones soportadas por KMS.",{"_7914":1387,"_22115":1275,"_18751":35889,"_5":22248,"_15096":35590,"_1571":35890},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_7914":1388,"_22115":1275,"_18751":35892,"_5":22248,"_15096":35594,"_1571":35893},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_7914":1389,"_22115":1275,"_18751":35895,"_5":22248,"_15096":35594,"_1571":35896},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_7914":1390,"_22115":1275,"_18751":35898,"_5":22248,"_15096":35594,"_1571":35899},[],"**Key Name**: nombre descriptivo.",{"_7914":1391,"_22115":1275,"_18751":35901,"_5":22248,"_15096":35594,"_1571":35902},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_7914":1392,"_22115":1275,"_18751":35904,"_5":22248,"_15096":35594,"_1571":35905},[],"**Tags**: etiquetas asociadas.",{"_7914":1393,"_22115":1275,"_18751":35907,"_5":22248,"_15096":35594,"_1571":35908},[],"**Aliases**: nombres alternativos.",{"_7914":1394,"_22115":1275,"_18751":35910,"_5":22248,"_15096":35594,"_1571":35911},[],"**Crypto Engine**: motor en el que reside la clave.",{"_7914":1395,"_22115":1275,"_18751":35913,"_5":22248,"_15096":35594,"_1571":35914},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_7914":1396,"_22115":1275,"_18751":35916,"_5":22248,"_15096":35594,"_1571":35917},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_7914":1397,"_22115":1275,"_18751":35919,"_5":22248,"_15096":35594,"_1571":35920},[],"La pestaña **Public Key** presenta la clave pública en formato PEM, lista para consulta o copia.",{"_7914":1398,"_22115":1275,"_18751":35922,"_5":22248,"_15096":35598,"_1571":35923},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_7914":1399,"_22115":1275,"_18751":35925,"_5":22248,"_15096":35598,"_1571":35926},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_7914":1400,"_22115":1275,"_18751":35928,"_5":22248,"_15096":35602,"_1571":35929},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_7914":1401,"_22115":1275,"_18751":35931,"_5":22248,"_15096":35602,"_1571":35932},[],"Campos principales:",{"_7914":1402,"_22115":1275,"_18751":35934,"_5":22248,"_15096":35602,"_1571":35935},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_7914":1403,"_22115":1275,"_18751":35937,"_5":22248,"_15096":35602,"_1571":35938},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_7914":1404,"_22115":1275,"_18751":35940,"_5":22248,"_15096":35602,"_1571":35941},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_7914":1405,"_22115":1275,"_18751":35943,"_5":22248,"_15096":35602,"_1571":35944},[],"**Message**: contenido que se va a firmar.",{"_7914":1406,"_22115":1275,"_18751":35946,"_5":22248,"_15096":35602,"_1571":35947},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_7914":1407,"_22115":1275,"_18751":35949,"_5":22248,"_15096":35606,"_1571":35950},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_7914":1408,"_22115":1275,"_18751":35952,"_5":22248,"_15096":35606,"_1571":35932},[],{"_7914":1409,"_22115":1275,"_18751":35954,"_5":22248,"_15096":35606,"_1571":35955},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_7914":1410,"_22115":1275,"_18751":35957,"_5":22248,"_15096":35606,"_1571":35958},[],"**Message Type**: `Raw` o `Digest`.",{"_7914":1411,"_22115":1275,"_18751":35960,"_5":22248,"_15096":35606,"_1571":35961},[],"**Payload Encoding**: codificación del mensaje.",{"_7914":1412,"_22115":1275,"_18751":35963,"_5":22248,"_15096":35606,"_1571":35964},[],"**Message**: mensaje original o hash.",{"_7914":1413,"_22115":1275,"_18751":35966,"_5":22248,"_15096":35606,"_1571":35967},[],"**Signature**: firma que se desea comprobar.",{"_7914":1414,"_22115":1275,"_18751":35969,"_5":22248,"_15096":35606,"_1571":35970},[],"**Result**: indicador del resultado de la validación.",{"_7914":1415,"_22115":1275,"_18751":35972,"_5":22248,"_15096":35610,"_1571":35973},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_7914":1416,"_22115":1275,"_18751":35975,"_5":22248,"_15096":35610,"_1571":35976},[],"Este flujo es útil para:",{"_7914":1417,"_22115":1275,"_18751":35978,"_5":22248,"_15096":35610,"_1571":35979},[],"Solicitar certificados a una CA externa.",{"_7914":1418,"_22115":1275,"_18751":35981,"_5":22248,"_15096":35610,"_1571":35982},[],"Renovar una identidad manteniendo la misma clave.",{"_7914":1419,"_22115":1275,"_18751":35984,"_5":22248,"_15096":35610,"_1571":35985},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_7914":1420,"_22115":1275,"_18751":35987,"_5":22248,"_15096":35610,"_1571":35988},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_7914":1421,"_22115":1275,"_18751":35990,"_5":22248,"_15096":35610,"_1571":35991},[],"**Organization (O)**: organización o empresa.",{"_7914":1422,"_22115":1275,"_18751":35993,"_5":22248,"_15096":35610,"_1571":35994},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_7914":1423,"_22115":1275,"_18751":35996,"_5":22248,"_15096":35610,"_1571":35997},[],"**Country (C)**: código de país de dos letras.",{"_7914":1424,"_22115":1275,"_18751":35999,"_5":22248,"_15096":35610,"_1571":36000},[],"**State / Province (ST)**: estado o provincia.",{"_7914":1425,"_22115":1275,"_18751":36002,"_5":22248,"_15096":35610,"_1571":36003},[],"**Locality (L)**: ciudad o localidad.",{"_7914":1426,"_22115":1275,"_18751":36005,"_5":22248,"_15096":35610,"_1571":36006},[],"**Email Address**: correo de contacto.",{"_7914":1427,"_22115":1275,"_18751":36008,"_5":22248,"_15096":35610,"_1571":36009},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_7914":1428,"_22115":1275,"_18751":36011,"_5":22248,"_15096":35610,"_1571":36012},[],"Una vez completado el formulario, Lamassu genera la CSR y la presenta para su descarga o copia.",{"_7914":1429,"_22115":1275,"_18751":36014,"_5":22248,"_15096":35614,"_1571":36015},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_7914":1430,"_22115":1275,"_18751":36017,"_5":22248,"_15096":35614,"_1571":36018},[],"Esta opción muestra los pasos necesarios para configurar el entorno local, cargar el módulo PKCS#11 y ejecutar firmas con herramientas como OpenSSL sin extraer la clave privada del entorno custodiado.",{"_7914":1431,"_22115":1431,"_5":22243,"_1571":36020,"_22256":36021,"_18751":36022,"_15096":1431},"[DMS] Device Management Service",[31753,32852,32861],[],{"_7914":1432,"_22115":1431,"_18751":36024,"_5":22248,"_15096":1431,"_1571":36025},[],"Visión general del Device Management Service en Lamassu IoT - concepto, panel de gestión y configuración común a todos los protocolos de enrolamiento.",{"_7914":1433,"_22115":1431,"_5":22253,"_18751":36027,"_15096":36028,"_1571":36029},[],"/docs/manual/servicios-core/ra#device-management-service","Device Management Service",{"_7914":1434,"_22115":1431,"_5":22253,"_18751":36031,"_15096":36032,"_1571":34590},[],"/docs/manual/servicios-core/ra#antes-de-empezar",{"_7914":1435,"_22115":1431,"_5":22253,"_18751":36034,"_15096":36035,"_1571":36036},[],"/docs/manual/servicios-core/ra#panel-de-dms","Panel de DMS",{"_7914":1436,"_22115":1431,"_5":22253,"_18751":36038,"_15096":36039,"_1571":36040},[],"/docs/manual/servicios-core/ra#distribución-de-entidades-de-confianza","Distribución de entidades de confianza",{"_7914":1437,"_22115":1431,"_5":22253,"_18751":36042,"_15096":36043,"_1571":36044},[],"/docs/manual/servicios-core/ra#protocolos-de-enrolamiento","Protocolos de enrolamiento",{"_7914":1438,"_22115":1431,"_18751":36046,"_5":22248,"_15096":36028,"_1571":36047},[],"El &#x2A;*DMS (Device Management Service)** es el componente de Lamassu IoT que actúa como Autoridad de Registro (RA) frente a los dispositivos. Cada DMS recibe las solicitudes de certificado, valida la identidad del solicitante según las políticas configuradas y encarga la emisión a la CA asignada. El resultado es un canal de aprovisionamiento controlado e independiente por flota, línea de producto o entorno.",{"_7914":1439,"_22115":1431,"_18751":36049,"_5":22248,"_15096":36028,"_1571":36050},[],"En la práctica, cada DMS representa un punto de entrada diferenciado: tiene su propia CA de enrolamiento, sus propias reglas de autenticación y su propia ventana de renovación. Una organización puede operar varios DMS en paralelo - por ejemplo, uno para dispositivos de campo y otro para pasarelas internas - con políticas completamente distintas en cada caso.",{"_7914":1440,"_22115":1431,"_18751":36052,"_5":22248,"_15096":36032,"_1571":36053},[],"Para crear un DMS es necesario que exista al menos una CA activa en la plataforma, ya que el DMS requiere seleccionar una CA de enrolamiento. El usuario debe disponer del rol de administrador PKI o de permisos equivalentes sobre el módulo DMS.",{"_7914":1441,"_22115":1431,"_18751":36055,"_5":22248,"_15096":36035,"_1571":36056},[],"El panel lista todos los DMS configurados en la plataforma. Cada entrada muestra el nombre del DMS, el protocolo de enrolamiento activo y la CA de enrolamiento asignada. Desde el menú de opciones de cada DMS están disponibles las siguientes acciones:",{"_7914":1442,"_22115":1431,"_18751":36058,"_5":22248,"_15096":36035,"_1571":36059},[],"Acción",{"_7914":1443,"_22115":1431,"_18751":36061,"_5":22248,"_15096":36035,"_1571":31956},[],{"_7914":1444,"_22115":1431,"_18751":36063,"_5":22248,"_15096":36035,"_1571":36064},[],"**Edit**",{"_7914":1445,"_22115":1431,"_18751":36066,"_5":22248,"_15096":36035,"_1571":36067},[],"Modifica la configuración del DMS.",{"_7914":1446,"_22115":1431,"_18751":36069,"_5":22248,"_15096":36035,"_1571":36070},[],"**Go to DMS owned devices**",{"_7914":1447,"_22115":1431,"_18751":36072,"_5":22248,"_15096":36035,"_1571":36073},[],"Abre el listado de dispositivos gestionados por este DMS.",{"_7914":1448,"_22115":1431,"_18751":36075,"_5":22248,"_15096":36035,"_1571":36076},[],"**Show/Edit Metadata**",{"_7914":1449,"_22115":1431,"_18751":36078,"_5":22248,"_15096":36035,"_1571":36079},[],"Accede a los metadatos del DMS para usos avanzados.",{"_7914":1450,"_22115":1431,"_18751":36081,"_5":22248,"_15096":36035,"_1571":36082},[],"**EST (RFC-7030)**",{"_7914":1451,"_22115":1431,"_18751":36084,"_5":22248,"_15096":36035,"_1571":36085},[],"Muestra los endpoints EST del DMS con su URL base y ejemplos de invocación.",{"_7914":1452,"_22115":1431,"_18751":36087,"_5":22248,"_15096":36035,"_1571":36088},[],"**Delete**",{"_7914":1453,"_22115":1431,"_18751":36090,"_5":22248,"_15096":36035,"_1571":36091},[],"Elimina el DMS y su configuración. Acción irreversible.",{"_7914":1454,"_22115":1431,"_18751":36093,"_5":22248,"_15096":36039,"_1571":36094},[],"La sección **CA Distribution** controla qué certificados de CA recibe el dispositivo al consultar el endpoint de distribución de confianza del protocolo activo. Esta configuración es independiente del protocolo de enrolamiento: los parámetros tienen el mismo significado con independencia de cómo el dispositivo obtenga sus certificados.",{"_7914":1455,"_22115":1431,"_18751":36096,"_5":22248,"_15096":36039,"_1571":33084},[],{"_7914":1456,"_22115":1431,"_18751":36098,"_5":22248,"_15096":36039,"_1571":31956},[],{"_7914":1457,"_22115":1431,"_18751":36100,"_5":22248,"_15096":36039,"_1571":36101},[],"**Include Lamassu System CA**",{"_7914":1458,"_22115":1431,"_18751":36103,"_5":22248,"_15096":36039,"_1571":36104},[],"Incluye el certificado TLS del servidor Lamassu en la respuesta. Este es el certificado de extremo del servidor, no una CA - útil para *pinning* de la conexión.",{"_7914":1459,"_22115":1431,"_18751":36106,"_5":22248,"_15096":36039,"_1571":36107},[],"**Include Enrollment CA**",{"_7914":1460,"_22115":1431,"_18751":36109,"_5":22248,"_15096":36039,"_1571":36110},[],"Incluye la CA emisora configurada en este DMS, es decir, la que firmará los certificados de dispositivo.",{"_7914":1461,"_22115":1431,"_18751":36112,"_5":22248,"_15096":36039,"_1571":36113},[],"**Managed CAs**",{"_7914":1462,"_22115":1431,"_18751":36115,"_5":22248,"_15096":36039,"_1571":36116},[],"CAs adicionales distribuidas al dispositivo como anclas de confianza.",{"_7914":1463,"_22115":1431,"_18751":36118,"_5":22248,"_15096":36043,"_1571":36119},[],"El DMS expone un protocolo de enrolamiento a los dispositivos. En la versión actual de Lamassu, el único protocolo soportado es &#x2A;*EST (RFC 7030)**. La configuración del protocolo y la guía de integración para dispositivos se encuentran en las páginas correspondientes.",{"_7914":1464,"_22115":1431,"_18751":36121,"_5":22248,"_15096":36043,"_1571":36122},[],"<Card title=\"EST (RFC 7030)\" href=\"/docs/manual/servicios-core/est\" />",{"_7914":1465,"_22115":1431,"_18751":36124,"_5":22248,"_15096":36043,"_1571":35552},[],{"_7914":1466,"_22115":1466,"_5":22243,"_1571":36126,"_22256":36127,"_18751":36128,"_15096":1466},"[VA] Servicio CRL",[31753,32852,32861],[],{"_7914":1467,"_22115":1466,"_18751":36130,"_5":22248,"_15096":1466,"_1571":36131},[],"Gestión y consulta de listas de revocación para validación offline",{"_7914":1468,"_22115":1466,"_5":22253,"_18751":36133,"_15096":36134,"_1571":36135},[],"/docs/manual/servicios-core/validation-crl#servicio-crl","Servicio CRL",{"_7914":1469,"_22115":1466,"_5":22253,"_18751":36137,"_15096":36138,"_1571":36139},[],"/docs/manual/servicios-core/validation-crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_7914":1470,"_22115":1466,"_5":22253,"_18751":36141,"_15096":36142,"_1571":36143},[],"/docs/manual/servicios-core/validation-crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_7914":1471,"_22115":1466,"_5":22253,"_18751":36145,"_15096":36146,"_1571":36147},[],"/docs/manual/servicios-core/validation-crl#contenido-de-la-crl","Contenido de la CRL",{"_7914":1472,"_22115":1466,"_5":22253,"_18751":36149,"_15096":36150,"_1571":36151},[],"/docs/manual/servicios-core/validation-crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_7914":1473,"_22115":1466,"_5":22253,"_18751":36153,"_15096":36154,"_1571":36155},[],"/docs/manual/servicios-core/validation-crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_7914":1474,"_22115":1466,"_5":22253,"_18751":36157,"_15096":36158,"_1571":36159},[],"/docs/manual/servicios-core/validation-crl#desde-la-interfaz","Desde la interfaz",{"_7914":1475,"_22115":1466,"_5":22253,"_18751":36161,"_15096":36162,"_1571":36163},[],"/docs/manual/servicios-core/validation-crl#referencias","Referencias",{"_7914":1476,"_22115":1466,"_18751":36165,"_5":22248,"_15096":36134,"_1571":36166},[],"Una CRL (*Certificate Revocation List*) es una lista firmada que contiene los números de serie de los certificados revocados antes de su fecha de caducidad. A diferencia de OCSP, no requiere una consulta en tiempo real: la parte que confía descarga la lista periódicamente y la consulta de forma local.",{"_7914":1477,"_22115":1466,"_18751":36168,"_5":22248,"_15096":36134,"_1571":36169},[],"Lamassu genera y mantiene una CRL por cada CA que gestiona. Cada CRL está firmada con la clave privada de la propia CA emisora y se almacena en el sistema de almacenamiento de objetos configurado en la plataforma.",{"_7914":1478,"_22115":1466,"_18751":36171,"_5":22248,"_15096":36138,"_1571":36172},[],"La publicación de la CRL de cada CA se controla mediante un *rol VA*. Este objeto define cómo se genera, cuándo se regenera y qué clave se utiliza para firmarla.",{"_7914":1479,"_22115":1466,"_18751":36174,"_5":22248,"_15096":36138,"_1571":36175},[],"Los parámetros principales son:",{"_7914":1480,"_22115":1466,"_18751":36177,"_5":22248,"_15096":36138,"_1571":33084},[],{"_7914":1481,"_22115":1466,"_18751":36179,"_5":22248,"_15096":36138,"_1571":31953},[],{"_7914":1482,"_22115":1466,"_18751":36181,"_5":22248,"_15096":36138,"_1571":31956},[],{"_7914":1483,"_22115":1466,"_18751":36183,"_5":22248,"_15096":36138,"_1571":36184},[],"`validity`",{"_7914":1484,"_22115":1466,"_18751":36186,"_5":22248,"_15096":36138,"_1571":36187},[],"7 días",{"_7914":1485,"_22115":1466,"_18751":36189,"_5":22248,"_15096":36138,"_1571":36190},[],"Período de validez de cada CRL emitida, reflejado en el campo `nextUpdate`.",{"_7914":1486,"_22115":1466,"_18751":36192,"_5":22248,"_15096":36138,"_1571":36193},[],"`refresh_interval`",{"_7914":1487,"_22115":1466,"_18751":36195,"_5":22248,"_15096":36138,"_1571":36196},[],"\\~6 días y 23 horas",{"_7914":1488,"_22115":1466,"_18751":36198,"_5":22248,"_15096":36138,"_1571":36199},[],"Intervalo mínimo entre regeneraciones periódicas programadas.",{"_7914":1489,"_22115":1466,"_18751":36201,"_5":22248,"_15096":36138,"_1571":36202},[],"`regenerate_on_revoke`",{"_7914":1490,"_22115":1466,"_18751":36204,"_5":22248,"_15096":36138,"_1571":36205},[],"`true`",{"_7914":1491,"_22115":1466,"_18751":36207,"_5":22248,"_15096":36138,"_1571":36208},[],"Cuando se revoca un certificado, se genera una nueva CRL de inmediato sin esperar al ciclo periódico.",{"_7914":1492,"_22115":1466,"_18751":36210,"_5":22248,"_15096":36138,"_1571":36211},[],"El campo `subject_key_id_signer` identifica la CA cuya clave privada firma la CRL. Por defecto, cada CA firma su propia CRL.",{"_7914":1493,"_22115":1466,"_18751":36213,"_5":22248,"_15096":36138,"_1571":36214},[],"Cada CRL lleva un número de versión incremental. Lamassu almacena todas las versiones en la ruta `pki/va/crl/{subject_key_id}/{version}.crl` del almacenamiento de objetos.",{"_7914":1494,"_22115":1466,"_18751":36216,"_5":22248,"_15096":36142,"_1571":36217},[],"Un proceso en segundo plano supervisa los roles VA activos. Cuando la validez restante de la CRL vigente cae por debajo del período de vigilancia configurado (*blind period*), el sistema solicita la generación de una nueva CRL. Así se evita que la CRL publicada caduque sin que exista una versión válida disponible.",{"_7914":1495,"_22115":1466,"_18751":36219,"_5":22248,"_15096":36142,"_1571":36220},[],"Además, cuando `regenerate_on_revoke` está activo, que es el comportamiento por defecto, cualquier revocación de un certificado desencadena inmediatamente la generación de una nueva CRL para la CA afectada. Esto reduce al mínimo el tiempo entre la revocación y su publicación.",{"_7914":1496,"_22115":1466,"_18751":36222,"_5":22248,"_15096":36146,"_1571":36223},[],"Cada entrada de la CRL incluye el número de serie del certificado revocado, la fecha de revocación y el código de razón conforme a RFC 5280.",{"_7914":1497,"_22115":1466,"_18751":36225,"_5":22248,"_15096":36146,"_1571":36226},[],"La CRL incluye también la extensión *Issuing Distribution Point* (IDP, OID 2.5.29.28), marcada como crítica, que indica la URL pública desde la que puede descargarse. Esa URL apunta al endpoint `/crl/{subject_key_id}` de cada dominio VA configurado.",{"_7914":1498,"_22115":1466,"_18751":36228,"_5":22248,"_15096":36150,"_1571":36229},[],"La CRL más reciente de una CA se puede obtener directamente sin autenticación:",{"_7914":1499,"_22115":1466,"_18751":36231,"_5":22248,"_15096":36150,"_1571":36232},[],"La respuesta tiene `Content-Type: application/pkix-crl` y contiene la CRL en formato DER.",{"_7914":1500,"_22115":1466,"_18751":36234,"_5":22248,"_15096":36154,"_1571":36235},[],"El rol VA de una CA se puede consultar y actualizar mediante la API:",{"_7914":1501,"_22115":1466,"_18751":36237,"_5":22248,"_15096":36154,"_1571":36238},[],"Método",{"_7914":1502,"_22115":1466,"_18751":36240,"_5":22248,"_15096":36154,"_1571":36241},[],"Ruta",{"_7914":1503,"_22115":1466,"_18751":36243,"_5":22248,"_15096":36154,"_1571":31956},[],{"_7914":1504,"_22115":1466,"_18751":36245,"_5":22248,"_15096":36154,"_1571":36246},[],"`GET`",{"_7914":1505,"_22115":1466,"_18751":36248,"_5":22248,"_15096":36154,"_1571":36249},[],"`/v1/roles/{ca-ski}`",{"_7914":1506,"_22115":1466,"_18751":36251,"_5":22248,"_15096":36154,"_1571":36252},[],"Devuelve la configuración del rol VA y los metadatos de la última CRL emitida.",{"_7914":1507,"_22115":1466,"_18751":36254,"_5":22248,"_15096":36154,"_1571":36255},[],"`PUT`",{"_7914":1508,"_22115":1466,"_18751":36257,"_5":22248,"_15096":36154,"_1571":36249},[],{"_7914":1509,"_22115":1466,"_18751":36259,"_5":22248,"_15096":36154,"_1571":36260},[],"Actualiza los parámetros de la configuración del rol VA (`validity`, `refresh_interval`, `regenerate_on_revoke`).",{"_7914":1510,"_22115":1466,"_18751":36262,"_5":22248,"_15096":36154,"_1571":36263},[],"Ejemplo de consulta del rol VA:",{"_7914":1511,"_22115":1466,"_18751":36265,"_5":22248,"_15096":36154,"_1571":36266},[],"La respuesta incluye el campo `latest_crl` con la versión, la fecha de inicio de validez y la fecha de caducidad de la CRL actualmente publicada.",{"_7914":1512,"_22115":1466,"_18751":36268,"_5":22248,"_15096":36158,"_1571":36269},[],"Desde el panel de detalle de una CA es posible previsualizar el contenido de la CRL activa y descargarla directamente para su uso offline o para importarla en aplicaciones que realicen validación local.",{"_7914":1513,"_22115":1466,"_18751":36271,"_5":22248,"_15096":36162,"_1571":36272},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile*",{"_7914":1514,"_22115":1466,"_18751":36274,"_5":22248,"_15096":36162,"_1571":36275},[],"<Card title=\"Servicio OCSP\" href=\"/docs/manual/servicios-core/validation-ocsp\" />",{"_7914":1515,"_22115":1466,"_18751":36277,"_5":22248,"_15096":36162,"_1571":36278},[],"<Card title=\"Validación de certificados\" href=\"/docs/manual/servicios-core/validation\" />",{"_7914":1516,"_22115":1516,"_5":22243,"_1571":36280,"_22256":36281,"_18751":36282,"_15096":1516},"[VA] Servicio OCSP",[31753,32852,32861],[],{"_7914":1517,"_22115":1516,"_18751":36284,"_5":22248,"_15096":1516,"_1571":36285},[],"Validación online del estado de certificados mediante OCSP",{"_7914":1518,"_22115":1516,"_5":22253,"_18751":36287,"_15096":36288,"_1571":36289},[],"/docs/manual/servicios-core/validation-ocsp#servicio-ocsp","Servicio OCSP",{"_7914":1519,"_22115":1516,"_5":22253,"_18751":36291,"_15096":36292,"_1571":36293},[],"/docs/manual/servicios-core/validation-ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_7914":1520,"_22115":1516,"_5":22253,"_18751":36295,"_15096":36296,"_1571":36297},[],"/docs/manual/servicios-core/validation-ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_7914":1521,"_22115":1516,"_5":22253,"_18751":36299,"_15096":36300,"_1571":36301},[],"/docs/manual/servicios-core/validation-ocsp#endpoints-http","Endpoints HTTP",{"_7914":1522,"_22115":1516,"_5":22253,"_18751":36303,"_15096":36304,"_1571":36305},[],"/docs/manual/servicios-core/validation-ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_7914":1523,"_22115":1516,"_5":22253,"_18751":36307,"_15096":36308,"_1571":36163},[],"/docs/manual/servicios-core/validation-ocsp#referencias",{"_7914":1524,"_22115":1516,"_18751":36310,"_5":22248,"_15096":36288,"_1571":36311},[],"OCSP (Online Certificate Status Protocol) es el mecanismo que permite a una parte que confía comprobar, en tiempo real, si un certificado concreto está vigente o ha sido revocado. En lugar de descargar una lista completa de certificados revocados, el cliente envía una consulta con el número de serie del certificado y recibe una respuesta firmada con el estado actual.",{"_7914":1525,"_22115":1516,"_18751":36313,"_5":22248,"_15096":36288,"_1571":36314},[],"Lamassu integra un respondedor OCSP propio que atiende estas consultas consultando directamente la base de datos interna de certificados. No se requiere ningún componente externo.",{"_7914":1526,"_22115":1516,"_18751":36316,"_5":22248,"_15096":36292,"_1571":36317},[],"Cuando un cliente solicita el estado de un certificado, el respondedor localiza el certificado por su número de serie y determina su estado según el registro interno:",{"_7914":1527,"_22115":1516,"_18751":36319,"_5":22248,"_15096":36292,"_1571":36320},[],"Si el certificado está activo, la respuesta indica `Good`.",{"_7914":1528,"_22115":1516,"_18751":36322,"_5":22248,"_15096":36292,"_1571":36323},[],"Si el certificado ha sido revocado, la respuesta indica `Revoked` e incluye la marca de tiempo de revocación y el código de razón conforme a RFC 5280.",{"_7914":1529,"_22115":1516,"_18751":36325,"_5":22248,"_15096":36292,"_1571":36326},[],"Si el número de serie no se encuentra o el estado no es reconocible, la respuesta indica `Unknown`.",{"_7914":1530,"_22115":1516,"_18751":36328,"_5":22248,"_15096":36292,"_1571":36329},[],"La respuesta OCSP es firmada por la CA emisora del certificado consultado, utilizando el motor criptográfico asociado a esa CA. Lamassu no utiliza un certificado delegado de firma OCSP: la CA actúa directamente como respondedor.",{"_7914":1531,"_22115":1516,"_18751":36331,"_5":22248,"_15096":36292,"_1571":36332},[],"Cada respuesta tiene una ventana de validez de 24 horas, reflejada en los campos `thisUpdate` y `nextUpdate` de la respuesta. Los clientes que cacheen respuestas deben tener en cuenta esta ventana al determinar durante cuánto tiempo una respuesta sigue siendo válida.",{"_7914":1532,"_22115":1516,"_18751":36334,"_5":22248,"_15096":36296,"_1571":36335},[],"La URL del respondedor OCSP se incorpora automáticamente en la extensión AIA (*Authority Information Access*) de todos los certificados emitidos por Lamassu. Los clientes que verifican certificados pueden leer esta URL directamente del certificado sin necesidad de configuración adicional.",{"_7914":1533,"_22115":1516,"_18751":36337,"_5":22248,"_15096":36300,"_1571":36338},[],"El respondedor acepta consultas en dos formatos, ambos definidos en RFC 6960:",{"_7914":1534,"_22115":1516,"_18751":36340,"_5":22248,"_15096":36300,"_1571":36238},[],{"_7914":1535,"_22115":1516,"_18751":36342,"_5":22248,"_15096":36300,"_1571":36241},[],{"_7914":1536,"_22115":1516,"_18751":36344,"_5":22248,"_15096":36300,"_1571":31956},[],{"_7914":1537,"_22115":1516,"_18751":36346,"_5":22248,"_15096":36300,"_1571":36246},[],{"_7914":1538,"_22115":1516,"_18751":36348,"_5":22248,"_15096":36300,"_1571":36349},[],"`/ocsp/{ocsp_request}`",{"_7914":1539,"_22115":1516,"_18751":36351,"_5":22248,"_15096":36300,"_1571":36352},[],"La petición OCSP va codificada en Base64url en la propia URL.",{"_7914":1540,"_22115":1516,"_18751":36354,"_5":22248,"_15096":36300,"_1571":36355},[],"`POST`",{"_7914":1541,"_22115":1516,"_18751":36357,"_5":22248,"_15096":36300,"_1571":36358},[],"`/ocsp`",{"_7914":1542,"_22115":1516,"_18751":36360,"_5":22248,"_15096":36300,"_1571":36361},[],"La petición OCSP va en el cuerpo de la petición con `Content-Type: application/ocsp-request`.",{"_7914":1543,"_22115":1516,"_18751":36363,"_5":22248,"_15096":36300,"_1571":36364},[],"Ejemplo de consulta con `curl` mediante POST:",{"_7914":1544,"_22115":1516,"_18751":36366,"_5":22248,"_15096":36300,"_1571":36367},[],"La respuesta tiene `Content-Type: application/ocsp-response` y contiene la respuesta OCSP en formato DER.",{"_7914":1545,"_22115":1516,"_18751":36369,"_5":22248,"_15096":36304,"_1571":36370},[],"Desde la pantalla de certificados de Lamassu es posible lanzar una petición OCSP directamente sobre el certificado seleccionado mediante la acción **OCSP Check**. Esta acción muestra el estado devuelto por el respondedor sin necesidad de herramientas externas.",{"_7914":1546,"_22115":1516,"_18751":36372,"_5":22248,"_15096":36308,"_1571":36373},[],"RFC 6960 - *X.509 Internet Public Key Infrastructure Online Certificate Status Protocol – OCSP*",{"_7914":1547,"_22115":1516,"_18751":36375,"_5":22248,"_15096":36308,"_1571":36376},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile* (razones de revocación, sección 5.3.1)",{"_7914":1548,"_22115":1516,"_18751":36378,"_5":22248,"_15096":36308,"_1571":36379},[],"<Card title=\"Servicio CRL\" href=\"/docs/manual/servicios-core/validation-crl\" />",{"_7914":1549,"_22115":1516,"_18751":36381,"_5":22248,"_15096":36308,"_1571":36278},[],{"_7914":1550,"_22115":1550,"_5":22243,"_1571":36383,"_22256":36384,"_18751":36385,"_15096":1550},"[VA] Validación de Certificados",[31753,32852,32861],[],{"_7914":1551,"_22115":1550,"_18751":36387,"_5":22248,"_15096":1550,"_1571":36388},[],"Servicios OCSP y CRL para validación de certificados",{"_7914":1552,"_22115":1550,"_5":22253,"_18751":36390,"_15096":36391,"_1571":36392},[],"/docs/manual/servicios-core/validation#validación-de-certificados--va","Validación de certificados – VA",{"_7914":1553,"_22115":1550,"_18751":36394,"_5":22248,"_15096":36391,"_1571":36395},[],"Lamassu ofrece dos mecanismos complementarios para validar el estado de los certificados emitidos por la plataforma:",{"_7914":1554,"_22115":1550,"_18751":36397,"_5":22248,"_15096":36391,"_1571":36398},[],"`OCSP`, para consultas online y en tiempo real del estado del certificado.",{"_7914":1555,"_22115":1550,"_18751":36400,"_5":22248,"_15096":36391,"_1571":36401},[],"`CRL`, para distribución y consulta offline de listas de revocación.",{"_7914":1556,"_22115":1550,"_18751":36403,"_5":22248,"_15096":36391,"_1571":36404},[],"En el menú lateral del módulo `VA` encontrarás cada capacidad documentada en su propia página.",{"_7914":1557,"_22115":1557,"_5":22243,"_1571":36406,"_18751":36407,"_15096":1557},"Test",[],{"_7914":1558,"_22115":1557,"_18751":36409,"_5":22248,"_15096":1557,"_1571":36410},[],"A document to test Fumadocs",{"_7914":1559,"_22115":1557,"_5":22253,"_18751":36412,"_15096":36413,"_1571":36414},[],"/docs/test#cards","Cards",{"_7914":1560,"_22115":1557,"_5":22253,"_18751":36416,"_15096":36417,"_1571":36418},[],"/docs/test#codeblock","CodeBlock",{"_7914":1561,"_22115":1557,"_5":22253,"_18751":36420,"_15096":36421,"_1571":36422},[],"/docs/test#list","List",{"_7914":1562,"_22115":1557,"_18751":36424,"_5":22248,"_15096":1557,"_1571":36425},[],"Hey there!",{"_7914":1563,"_22115":1557,"_18751":36427,"_5":22248,"_15096":36413,"_1571":36428},[],"<Card title=\"Learn more about Next.js\" href=\"https://nextjs.org/docs\" />",{"_7914":1564,"_22115":1557,"_187