8":105362,"_34260":105365,"_34262":105368,"_34264":105371,"_34266":105374,"_34268":105377,"_34270":105380,"_34272":105383,"_34274":105385},{"_2926":59057,"_25561":59057,"_5":12525,"_2452":97924,"_25885":97925,"_17855":97928,"_24230":59057},"Despliega desde AWS Marketplace",[41651,97926,97927],"Despliegue","Otros modelos",[],{"_2926":59058,"_25561":59057,"_17855":97930,"_5":17750,"_24230":59057,"_2452":97931},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_2926":59059,"_25561":59057,"_5":25882,"_17855":97933,"_24230":97934,"_2452":97935},[],"/docs/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_2926":59060,"_25561":59057,"_5":25882,"_17855":97937,"_24230":97938,"_2452":97939},[],"/docs/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_2926":59061,"_25561":59057,"_5":25882,"_17855":97941,"_24230":97942,"_2452":97943},[],"/docs/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_2926":59062,"_25561":59057,"_5":25882,"_17855":97945,"_24230":97946,"_2452":97947},[],"/docs/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_2926":59063,"_25561":59057,"_5":25882,"_17855":97949,"_24230":97950,"_2452":97951},[],"/docs/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_2926":59064,"_25561":59057,"_5":25882,"_17855":97953,"_24230":97954,"_2452":97955},[],"/docs/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_2926":59065,"_25561":59057,"_5":25882,"_17855":97957,"_24230":97958,"_2452":97959},[],"/docs/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_2926":59066,"_25561":59057,"_17855":97961,"_5":17750,"_24230":59057,"_2452":97962},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_2926":59067,"_25561":59057,"_17855":97964,"_5":17750,"_24230":97934,"_2452":97965},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_2926":59068,"_25561":59057,"_17855":97967,"_5":17750,"_24230":97934,"_2452":97968},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_2926":59069,"_25561":59057,"_17855":97970,"_5":17750,"_24230":97934,"_2452":97971},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_2926":59070,"_25561":59057,"_17855":97973,"_5":17750,"_24230":97938,"_2452":97974},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_2926":59071,"_25561":59057,"_17855":97976,"_5":17750,"_24230":97938,"_2452":97977},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_2926":59072,"_25561":59057,"_17855":97979,"_5":17750,"_24230":97938,"_2452":97980},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_2926":59073,"_25561":59057,"_17855":97982,"_5":17750,"_24230":97942,"_2452":97983},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_2926":59074,"_25561":59057,"_17855":97985,"_5":17750,"_24230":97946,"_2452":97986},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_2926":59075,"_25561":59057,"_17855":97988,"_5":17750,"_24230":97950,"_2452":97989},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_2926":59076,"_25561":59057,"_17855":97991,"_5":17750,"_24230":97954,"_2452":97992},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_2926":59077,"_25561":59057,"_17855":97994,"_5":17750,"_24230":97958,"_2452":97995},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_2926":59078,"_25561":59078,"_5":12525,"_2452":97997,"_25885":97998,"_17855":97999,"_24230":59078},"Despliega Lamassu",[41651,97926],[],{"_2926":59079,"_25561":59078,"_17855":98001,"_5":17750,"_24230":59078,"_2452":98002},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_2926":59080,"_25561":59078,"_5":25882,"_17855":98004,"_24230":98005,"_2452":98006},[],"/docs/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_2926":59081,"_25561":59078,"_5":25882,"_17855":98008,"_24230":98009,"_2452":98010},[],"/docs/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_2926":59082,"_25561":59078,"_5":25882,"_17855":98012,"_24230":98013,"_2452":98014},[],"/docs/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_2926":59083,"_25561":59078,"_17855":98016,"_5":17750,"_24230":59078,"_2452":98017},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_2926":59084,"_25561":59078,"_17855":98019,"_5":17750,"_24230":98005,"_2452":98020},[],"Modelo",{"_2926":59085,"_25561":59078,"_17855":98022,"_5":17750,"_24230":98005,"_2452":98023},[],"Recomendado para",{"_2926":59086,"_25561":59078,"_17855":98025,"_5":17750,"_24230":98005,"_2452":98026},[],"Quién opera la infraestructura",{"_2926":59087,"_25561":59078,"_17855":98028,"_5":17750,"_24230":98005,"_2452":98029},[],"Punto de partida",{"_2926":59088,"_25561":59078,"_17855":98031,"_5":17750,"_24230":98005,"_2452":41758},[],{"_2926":59089,"_25561":59078,"_17855":98033,"_5":17750,"_24230":98005,"_2452":98034},[],"Producción, entornos regulados y despliegues personalizados",{"_2926":59090,"_25561":59078,"_17855":98036,"_5":17750,"_24230":98005,"_2452":98037},[],"Tu equipo",{"_2926":59091,"_25561":59078,"_17855":98039,"_5":17750,"_24230":98005,"_2452":98040},[],"Helm o Fastlane",{"_2926":59092,"_25561":59078,"_17855":98042,"_5":17750,"_24230":98005,"_2452":41770},[],{"_2926":59093,"_25561":59078,"_17855":98044,"_5":17750,"_24230":98005,"_2452":98045},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_2926":59094,"_25561":59078,"_17855":98047,"_5":17750,"_24230":98005,"_2452":98037},[],{"_2926":59095,"_25561":59078,"_17855":98049,"_5":17750,"_24230":98005,"_2452":98050},[],"Imagen preconfigurada en EC2",{"_2926":59096,"_25561":59078,"_17855":98052,"_5":17750,"_24230":98005,"_2452":41781},[],{"_2926":59097,"_25561":59078,"_17855":98054,"_5":17750,"_24230":98005,"_2452":98055},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_2926":59098,"_25561":59078,"_17855":98057,"_5":17750,"_24230":98005,"_2452":41787},[],{"_2926":59099,"_25561":59078,"_17855":98059,"_5":17750,"_24230":98005,"_2452":98060},[],"Suscripción gestionada",{"_2926":59100,"_25561":59078,"_17855":98062,"_5":17750,"_24230":98005,"_2452":98063},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2926":59101,"_25561":59078,"_17855":98065,"_5":17750,"_24230":98005,"_2452":98066},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2926":59102,"_25561":59078,"_17855":98068,"_5":17750,"_24230":98005,"_2452":98069},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_2926":59103,"_25561":59078,"_17855":98071,"_5":17750,"_24230":98009,"_2452":98072},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_2926":59104,"_25561":59078,"_17855":98074,"_5":17750,"_24230":98013,"_2452":98075},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_2926":59105,"_25561":59105,"_5":12525,"_2452":98077,"_25885":98078,"_17855":98079,"_24230":59105},"Utiliza Lamassu como SaaS",[41651,97926,97927],[],{"_2926":59106,"_25561":59105,"_17855":98081,"_5":17750,"_24230":59105,"_2452":98082},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_2926":59107,"_25561":59105,"_5":25882,"_17855":98084,"_24230":98085,"_2452":98086},[],"/docs/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_2926":59108,"_25561":59105,"_5":25882,"_17855":98088,"_24230":98089,"_2452":98090},[],"/docs/es/deployment/saas#planes","Planes",{"_2926":59109,"_25561":59105,"_5":25882,"_17855":98092,"_24230":98093,"_2452":98094},[],"/docs/es/deployment/saas#solicita-acceso","Solicita acceso",{"_2926":59110,"_25561":59105,"_17855":98096,"_5":17750,"_24230":59105,"_2452":98097},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_2926":59111,"_25561":59105,"_17855":98099,"_5":17750,"_24230":98085,"_2452":98100},[],"Disponibilidad y mantenimiento de la plataforma.",{"_2926":59112,"_25561":59105,"_17855":98102,"_5":17750,"_24230":98085,"_2452":98103},[],"Copias de seguridad automáticas.",{"_2926":59113,"_25561":59105,"_17855":98105,"_5":17750,"_24230":98085,"_2452":98106},[],"Actualizaciones de versión.",{"_2926":59114,"_25561":59105,"_17855":98108,"_5":17750,"_24230":98085,"_2452":98109},[],"Soporte técnico y SLA según el plan contratado.",{"_2926":59115,"_25561":59105,"_17855":98111,"_5":17750,"_24230":98089,"_2452":41842},[],{"_2926":59116,"_25561":59105,"_17855":98113,"_5":17750,"_24230":98089,"_2452":98114},[],"Dispositivos",{"_2926":59117,"_25561":59105,"_17855":98116,"_5":17750,"_24230":98089,"_2452":98117},[],"Soporte",{"_2926":59118,"_25561":59105,"_17855":98119,"_5":17750,"_24230":98089,"_2452":41851},[],{"_2926":59119,"_25561":59105,"_17855":98121,"_5":17750,"_24230":98089,"_2452":41854},[],{"_2926":59120,"_25561":59105,"_17855":98123,"_5":17750,"_24230":98089,"_2452":98124},[],"Hasta 1.000",{"_2926":59121,"_25561":59105,"_17855":98126,"_5":17750,"_24230":98089,"_2452":41860},[],{"_2926":59122,"_25561":59105,"_17855":98128,"_5":17750,"_24230":98089,"_2452":98129},[],"99,5 %",{"_2926":59123,"_25561":59105,"_17855":98131,"_5":17750,"_24230":98089,"_2452":41866},[],{"_2926":59124,"_25561":59105,"_17855":98133,"_5":17750,"_24230":98089,"_2452":98134},[],"Hasta 10.000",{"_2926":59125,"_25561":59105,"_17855":98136,"_5":17750,"_24230":98089,"_2452":98137},[],"Email y chat",{"_2926":59126,"_25561":59105,"_17855":98139,"_5":17750,"_24230":98089,"_2452":98140},[],"99,9 %",{"_2926":59127,"_25561":59105,"_17855":98142,"_5":17750,"_24230":98089,"_2452":41878},[],{"_2926":59128,"_25561":59105,"_17855":98144,"_5":17750,"_24230":98089,"_2452":98145},[],"Ilimitados",{"_2926":59129,"_25561":59105,"_17855":98147,"_5":17750,"_24230":98089,"_2452":98148},[],"Dedicado",{"_2926":59130,"_25561":59105,"_17855":98150,"_5":17750,"_24230":98089,"_2452":98151},[],"99,99 %",{"_2926":59131,"_25561":59105,"_17855":98153,"_5":17750,"_24230":98093,"_2452":98154},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_2926":59132,"_25561":59105,"_17855":98156,"_5":17750,"_24230":98093,"_2452":98157},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_2926":59133,"_25561":59133,"_5":12525,"_2452":41895,"_25885":98159,"_17855":98161,"_24230":59133},[41651,97926,98160],"Kubernetes autogestionado",[],{"_2926":59134,"_25561":59133,"_17855":98163,"_5":17750,"_24230":59133,"_2452":98164},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_2926":59135,"_25561":59133,"_5":25882,"_17855":98166,"_24230":98167,"_2452":98168},[],"/docs/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_2926":59136,"_25561":59133,"_5":25882,"_17855":98170,"_24230":98171,"_2452":98172},[],"/docs/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_2926":59137,"_25561":59133,"_5":25882,"_17855":98174,"_24230":98175,"_2452":98176},[],"/docs/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_2926":59138,"_25561":59133,"_5":25882,"_17855":98178,"_24230":98179,"_2452":98180},[],"/docs/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_2926":59139,"_25561":59133,"_5":25882,"_17855":98182,"_24230":98183,"_2452":98184},[],"/docs/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_2926":59140,"_25561":59133,"_5":25882,"_17855":98186,"_24230":98187,"_2452":98188},[],"/docs/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_2926":59141,"_25561":59133,"_5":25882,"_17855":98190,"_24230":98191,"_2452":98192},[],"/docs/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_2926":59142,"_25561":59133,"_5":25882,"_17855":98194,"_24230":98195,"_2452":98196},[],"/docs/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_2926":59143,"_25561":59133,"_5":25882,"_17855":98198,"_24230":98199,"_2452":98200},[],"/docs/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_2926":59144,"_25561":59133,"_5":25882,"_17855":98202,"_24230":98203,"_2452":98204},[],"/docs/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_2926":59145,"_25561":59133,"_17855":98206,"_5":17750,"_24230":98167,"_2452":98207},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_2926":59146,"_25561":59133,"_17855":98209,"_5":17750,"_24230":98167,"_2452":98210},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_2926":59147,"_25561":59133,"_17855":98212,"_5":17750,"_24230":98171,"_2452":98213},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_2926":59148,"_25561":59133,"_17855":98215,"_5":17750,"_24230":98171,"_2452":98216},[],"Fastlane instala o configura",{"_2926":59149,"_25561":59133,"_17855":98218,"_5":17750,"_24230":98171,"_2452":98219},[],"Tú sigues proporcionando",{"_2926":59150,"_25561":59133,"_17855":98221,"_5":17750,"_24230":98171,"_2452":98222},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_2926":59151,"_25561":59133,"_17855":98224,"_5":17750,"_24230":98171,"_2452":98225},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_2926":59152,"_25561":59133,"_17855":98227,"_5":17750,"_24230":98171,"_2452":98228},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_2926":59153,"_25561":59133,"_17855":98230,"_5":17750,"_24230":98171,"_2452":98231},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_2926":59154,"_25561":59133,"_17855":98233,"_5":17750,"_24230":98171,"_2452":98234},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_2926":59155,"_25561":59133,"_17855":98236,"_5":17750,"_24230":98171,"_2452":98237},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_2926":59156,"_25561":59133,"_17855":98239,"_5":17750,"_24230":98171,"_2452":98240},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_2926":59157,"_25561":59133,"_17855":98242,"_5":17750,"_24230":98171,"_2452":98243},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_2926":59158,"_25561":59133,"_17855":98245,"_5":17750,"_24230":98171,"_2452":98246},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_2926":59159,"_25561":59133,"_17855":98248,"_5":17750,"_24230":98175,"_2452":98249},[],"Necesitas:",{"_2926":59160,"_25561":59133,"_17855":98251,"_5":17750,"_24230":98175,"_2452":98252},[],"un clúster Kubernetes existente",{"_2926":59161,"_25561":59133,"_17855":98254,"_5":17750,"_24230":98175,"_2452":98255},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_2926":59162,"_25561":59133,"_17855":98257,"_5":17750,"_24230":98175,"_2452":41993},[],{"_2926":59163,"_25561":59133,"_17855":98259,"_5":17750,"_24230":98175,"_2452":20208},[],{"_2926":59164,"_25561":59133,"_17855":98261,"_5":17750,"_24230":98175,"_2452":98262},[],"`jq` solo si usas `--sample-data`",{"_2926":59165,"_25561":59133,"_17855":98264,"_5":17750,"_24230":98175,"_2452":98265},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_2926":59166,"_25561":59133,"_17855":98267,"_5":17750,"_24230":98175,"_2452":98268},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_2926":59167,"_25561":59133,"_17855":98270,"_5":17750,"_24230":98175,"_2452":98271},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_2926":59168,"_25561":59133,"_17855":98273,"_5":17750,"_24230":98179,"_2452":98274},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_2926":59169,"_25561":59133,"_17855":98276,"_5":17750,"_24230":98179,"_2452":98277},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_2926":59170,"_25561":59133,"_17855":98279,"_5":17750,"_24230":98183,"_2452":98280},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_2926":59171,"_25561":59133,"_17855":98282,"_5":17750,"_24230":98183,"_2452":98283},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_2926":59172,"_25561":59133,"_17855":98285,"_5":17750,"_24230":98183,"_2452":98286},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_2926":59173,"_25561":59133,"_17855":98288,"_5":17750,"_24230":98183,"_2452":98289},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_2926":59174,"_25561":59133,"_17855":98291,"_5":17750,"_24230":98187,"_2452":98292},[],"Opción",{"_2926":59175,"_25561":59133,"_17855":98294,"_5":17750,"_24230":98187,"_2452":98295},[],"Valor predeterminado",{"_2926":59176,"_25561":59133,"_17855":98297,"_5":17750,"_24230":98187,"_2452":98298},[],"Propósito",{"_2926":59177,"_25561":59133,"_17855":98300,"_5":17750,"_24230":98187,"_2452":42037},[],{"_2926":59178,"_25561":59133,"_17855":98302,"_5":17750,"_24230":98187,"_2452":42040},[],{"_2926":59179,"_25561":59133,"_17855":98304,"_5":17750,"_24230":98187,"_2452":98305},[],"Muestra la ayuda",{"_2926":59180,"_25561":59133,"_17855":98307,"_5":17750,"_24230":98187,"_2452":42046},[],{"_2926":59181,"_25561":59133,"_17855":98309,"_5":17750,"_24230":98187,"_2452":98310},[],"contexto actual",{"_2926":59182,"_25561":59133,"_17855":98312,"_5":17750,"_24230":98187,"_2452":98313},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_2926":59183,"_25561":59133,"_17855":98315,"_5":17750,"_24230":98187,"_2452":42055},[],{"_2926":59184,"_25561":59133,"_17855":98317,"_5":17750,"_24230":98187,"_2452":5458},[],{"_2926":59185,"_25561":59133,"_17855":98319,"_5":17750,"_24230":98187,"_2452":98320},[],"Omite prompts y genera credenciales para las dependencias",{"_2926":59186,"_25561":59133,"_17855":98322,"_5":17750,"_24230":98187,"_2452":42063},[],{"_2926":59187,"_25561":59133,"_17855":98324,"_5":17750,"_24230":98187,"_2452":42066},[],{"_2926":59188,"_25561":59133,"_17855":98326,"_5":17750,"_24230":98187,"_2452":98327},[],"Namespace de la instalación",{"_2926":59189,"_25561":59133,"_17855":98329,"_5":17750,"_24230":98187,"_2452":42072},[],{"_2926":59190,"_25561":59133,"_17855":98331,"_5":17750,"_24230":98187,"_2452":42075},[],{"_2926":59191,"_25561":59133,"_17855":98333,"_5":17750,"_24230":98187,"_2452":98334},[],"Dominio usado por la UI, OIDC y el certificado",{"_2926":59192,"_25561":59133,"_17855":98336,"_5":17750,"_24230":98187,"_2452":42081},[],{"_2926":59193,"_25561":59133,"_17855":98338,"_5":17750,"_24230":98187,"_2452":12756},[],{"_2926":59194,"_25561":59133,"_17855":98340,"_5":17750,"_24230":98187,"_2452":98341},[],"Versión del chart de Lamassu",{"_2926":59195,"_25561":59133,"_17855":98343,"_5":17750,"_24230":98187,"_2452":42089},[],{"_2926":59196,"_25561":59133,"_17855":98345,"_5":17750,"_24230":98187,"_2452":42092},[],{"_2926":59197,"_25561":59133,"_17855":98347,"_5":17750,"_24230":98187,"_2452":98348},[],"Puerto del listener HTTPS",{"_2926":59198,"_25561":59133,"_17855":98350,"_5":17750,"_24230":98187,"_2452":42098},[],{"_2926":59199,"_25561":59133,"_17855":98352,"_5":17750,"_24230":98187,"_2452":42101},[],{"_2926":59200,"_25561":59133,"_17855":98354,"_5":17750,"_24230":98187,"_2452":98355},[],"Puerto del listener HTTP",{"_2926":59201,"_25561":59133,"_17855":98357,"_5":17750,"_24230":98187,"_2452":42107},[],{"_2926":59202,"_25561":59133,"_17855":98359,"_5":17750,"_24230":98187,"_2452":42040},[],{"_2926":59203,"_25561":59133,"_17855":98361,"_5":17750,"_24230":98187,"_2452":98362},[],"Certificado PEM para TLS downstream",{"_2926":59204,"_25561":59133,"_17855":98364,"_5":17750,"_24230":98187,"_2452":42115},[],{"_2926":59205,"_25561":59133,"_17855":98366,"_5":17750,"_24230":98187,"_2452":42040},[],{"_2926":59206,"_25561":59133,"_17855":98368,"_5":17750,"_24230":98187,"_2452":98369},[],"Clave privada PEM para TLS downstream",{"_2926":59207,"_25561":59133,"_17855":98371,"_5":17750,"_24230":98187,"_2452":42123},[],{"_2926":59208,"_25561":59133,"_17855":98373,"_5":17750,"_24230":98187,"_2452":98374},[],"chart del repositorio",{"_2926":59209,"_25561":59133,"_17855":98376,"_5":17750,"_24230":98187,"_2452":98377},[],"Usa un chart local de Lamassu sin empaquetar",{"_2926":59210,"_25561":59133,"_17855":98379,"_5":17750,"_24230":98187,"_2452":42132},[],{"_2926":59211,"_25561":59133,"_17855":98381,"_5":17750,"_24230":98187,"_2452":98382},[],"detección automática",{"_2926":59212,"_25561":59133,"_17855":98384,"_5":17750,"_24230":98187,"_2452":98385},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_2926":59213,"_25561":59133,"_17855":98387,"_5":17750,"_24230":98187,"_2452":42140},[],{"_2926":59214,"_25561":59133,"_17855":98389,"_5":17750,"_24230":98187,"_2452":5458},[],{"_2926":59215,"_25561":59133,"_17855":98391,"_5":17750,"_24230":98187,"_2452":98392},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_2926":59216,"_25561":59133,"_17855":98394,"_5":17750,"_24230":98187,"_2452":42148},[],{"_2926":59217,"_25561":59133,"_17855":98396,"_5":17750,"_24230":98187,"_2452":5458},[],{"_2926":59218,"_25561":59133,"_17855":98398,"_5":17750,"_24230":98187,"_2452":98399},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_2926":59219,"_25561":59133,"_17855":98401,"_5":17750,"_24230":98187,"_2452":42156},[],{"_2926":59220,"_25561":59133,"_17855":98403,"_5":17750,"_24230":98187,"_2452":5458},[],{"_2926":59221,"_25561":59133,"_17855":98405,"_5":17750,"_24230":98187,"_2452":98406},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_2926":59222,"_25561":59133,"_17855":98408,"_5":17750,"_24230":98187,"_2452":42164},[],{"_2926":59223,"_25561":59133,"_17855":98410,"_5":17750,"_24230":98187,"_2452":42167},[],{"_2926":59224,"_25561":59133,"_17855":98412,"_5":17750,"_24230":98187,"_2452":98413},[],"Usa otro chart local de SoftHSM",{"_2926":59225,"_25561":59133,"_17855":98415,"_5":17750,"_24230":98187,"_2452":98416},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_2926":59226,"_25561":59133,"_17855":98418,"_5":17750,"_24230":98191,"_2452":42176},[],{"_2926":59227,"_25561":59133,"_17855":98420,"_5":17750,"_24230":98191,"_2452":98421},[],"valida las herramientas locales y el clúster seleccionado",{"_2926":59228,"_25561":59133,"_17855":98423,"_5":17750,"_24230":98191,"_2452":98424},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_2926":59229,"_25561":59133,"_17855":98426,"_5":17750,"_24230":98191,"_2452":98427},[],"crea el namespace",{"_2926":59230,"_25561":59133,"_17855":98429,"_5":17750,"_24230":98191,"_2452":98430},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_2926":59231,"_25561":59133,"_17855":98432,"_5":17750,"_24230":98191,"_2452":98433},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_2926":59232,"_25561":59133,"_17855":98435,"_5":17750,"_24230":98191,"_2452":98436},[],"instala RabbitMQ",{"_2926":59233,"_25561":59133,"_17855":98438,"_5":17750,"_24230":98191,"_2452":98439},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_2926":59234,"_25561":59133,"_17855":98441,"_5":17750,"_24230":98191,"_2452":98442},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_2926":59235,"_25561":59133,"_17855":98444,"_5":17750,"_24230":98191,"_2452":98445},[],"carga datos de ejemplo opcionalmente",{"_2926":59236,"_25561":59133,"_17855":98447,"_5":17750,"_24230":98191,"_2452":98448},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_2926":59237,"_25561":59133,"_17855":98450,"_5":17750,"_24230":98195,"_2452":98451},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_2926":59238,"_25561":59133,"_17855":98453,"_5":17750,"_24230":98195,"_2452":98454},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_2926":59239,"_25561":59133,"_17855":98456,"_5":17750,"_24230":98199,"_2452":98457},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso.",{"_2926":59240,"_25561":59133,"_17855":98459,"_5":17750,"_24230":98199,"_2452":98460},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_2926":59241,"_25561":59133,"_17855":98462,"_5":17750,"_24230":98199,"_2452":98463},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_2926":59242,"_25561":59133,"_17855":98465,"_5":17750,"_24230":98203,"_2452":98466},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_2926":59243,"_25561":59243,"_5":12525,"_2452":98468,"_25885":98469,"_17855":98470,"_24230":59243},"Instala con Helm",[41651,97926,98160],[],{"_2926":59244,"_25561":59243,"_17855":98472,"_5":17750,"_24230":59243,"_2452":98473},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_2926":59245,"_25561":59243,"_5":25882,"_17855":98475,"_24230":98476,"_2452":98477},[],"/docs/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_2926":59246,"_25561":59243,"_5":25882,"_17855":98479,"_24230":98480,"_2452":98176},[],"/docs/es/deployment/self-hosted/helm#antes-de-comenzar",{"_2926":59247,"_25561":59243,"_5":25882,"_17855":98482,"_24230":98483,"_2452":98484},[],"/docs/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_2926":59248,"_25561":59243,"_5":25882,"_17855":98486,"_24230":98487,"_2452":98488},[],"/docs/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_2926":59249,"_25561":59243,"_5":25882,"_17855":98490,"_24230":98491,"_2452":98492},[],"/docs/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_2926":59250,"_25561":59243,"_5":25882,"_17855":98494,"_24230":98495,"_2452":98496},[],"/docs/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_2926":59251,"_25561":59243,"_5":25882,"_17855":98498,"_24230":98499,"_2452":98500},[],"/docs/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_2926":59252,"_25561":59243,"_5":25882,"_17855":98502,"_24230":98503,"_2452":98504},[],"/docs/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_2926":59253,"_25561":59243,"_5":25882,"_17855":98506,"_24230":98507,"_2452":98508},[],"/docs/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_2926":59254,"_25561":59243,"_17855":98510,"_5":17750,"_24230":98476,"_2452":98511},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_2926":59255,"_25561":59243,"_17855":98513,"_5":17750,"_24230":98480,"_2452":98514},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_2926":59256,"_25561":59243,"_17855":98516,"_5":17750,"_24230":98480,"_2452":98517},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_2926":59257,"_25561":59243,"_17855":98519,"_5":17750,"_24230":98480,"_2452":98520},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_2926":59258,"_25561":59243,"_17855":98522,"_5":17750,"_24230":98480,"_2452":98523},[],"un broker RabbitMQ accesible y sus credenciales",{"_2926":59259,"_25561":59243,"_17855":98525,"_5":17750,"_24230":98480,"_2452":98526},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_2926":59260,"_25561":59243,"_17855":98528,"_5":17750,"_24230":98480,"_2452":98529},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_2926":59261,"_25561":59243,"_17855":98531,"_5":17750,"_24230":98480,"_2452":98532},[],"cert-manager 1.14+; para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_2926":59262,"_25561":59243,"_17855":98534,"_5":17750,"_24230":98480,"_2452":98535},[],"una StorageClass y un diseño de tráfico externo",{"_2926":59263,"_25561":59243,"_17855":98537,"_5":17750,"_24230":98480,"_2452":98538},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_2926":59264,"_25561":59243,"_17855":98540,"_5":17750,"_24230":98480,"_2452":98541},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_2926":59265,"_25561":59243,"_17855":98543,"_5":17750,"_24230":98480,"_2452":98544},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_2926":59266,"_25561":59243,"_17855":98546,"_5":17750,"_24230":98483,"_2452":98547},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_2926":59267,"_25561":59243,"_17855":98549,"_5":17750,"_24230":98483,"_2452":98550},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_2926":59268,"_25561":59243,"_17855":98552,"_5":17750,"_24230":98483,"_2452":98553},[],"Instala cert-manager por separado antes de Lamassu. El chart actual renderiza sus recursos de issuer self-signed y certificado CA incluso cuando `tls.type: external` hace que el Gateway use un Secret TLS existente. Seleccionar TLS externo no elimina por tanto el requisito de cert-manager.",{"_2926":59269,"_25561":59243,"_17855":98555,"_5":17750,"_24230":98487,"_2452":98556},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_2926":59270,"_25561":59243,"_17855":98558,"_5":17750,"_24230":98487,"_2452":98559},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_2926":59271,"_25561":59243,"_17855":98561,"_5":17750,"_24230":98487,"_2452":98562},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_2926":59272,"_25561":59243,"_17855":98564,"_5":17750,"_24230":98491,"_2452":98565},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo:",{"_2926":59273,"_25561":59243,"_17855":98567,"_5":17750,"_24230":98495,"_2452":98568},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_2926":59274,"_25561":59243,"_17855":98570,"_5":17750,"_24230":98495,"_2452":98571},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_2926":59275,"_25561":59243,"_17855":98573,"_5":17750,"_24230":98495,"_2452":98574},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_2926":59276,"_25561":59243,"_17855":98576,"_5":17750,"_24230":98495,"_2452":98577},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_2926":59277,"_25561":59243,"_17855":98579,"_5":17750,"_24230":98499,"_2452":98580},[],"Para instalar un checkout local:",{"_2926":59278,"_25561":59243,"_17855":98582,"_5":17750,"_24230":98503,"_2452":98583},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_2926":59279,"_25561":59243,"_17855":98585,"_5":17750,"_24230":98503,"_2452":98586},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_2926":59280,"_25561":59243,"_17855":98588,"_5":17750,"_24230":98507,"_2452":98589},[],"Antes de pasar a producción, revisa:",{"_2926":59281,"_25561":59243,"_17855":98591,"_5":17750,"_24230":98507,"_2452":98592},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_2926":59282,"_25561":59243,"_17855":98594,"_5":17750,"_24230":98507,"_2452":98595},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_2926":59283,"_25561":59243,"_17855":98597,"_5":17750,"_24230":98507,"_2452":98598},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_2926":59284,"_25561":59243,"_17855":98600,"_5":17750,"_24230":98507,"_2452":98601},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_2926":59285,"_25561":59243,"_17855":98603,"_5":17750,"_24230":98507,"_2452":98604},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_2926":59286,"_25561":59243,"_17855":98606,"_5":17750,"_24230":98507,"_2452":98607},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_2926":59287,"_25561":59243,"_17855":98609,"_5":17750,"_24230":98507,"_2452":98610},[],"SMTP, observabilidad y entrega de alertas",{"_2926":59288,"_25561":59243,"_17855":98612,"_5":17750,"_24230":98507,"_2452":98613},[],"las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_2926":59289,"_25561":59243,"_17855":98615,"_5":17750,"_24230":98507,"_2452":98616},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_2926":59290,"_25561":59290,"_5":12525,"_2452":98618,"_25885":98619,"_17855":98620,"_24230":59290},"Expón el Gateway",[41651,97926,98160],[],{"_2926":59291,"_25561":59290,"_17855":98622,"_5":17750,"_24230":59290,"_2452":98623},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_2926":59292,"_25561":59290,"_5":25882,"_17855":98625,"_24230":98626,"_2452":98627},[],"/docs/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_2926":59293,"_25561":59290,"_5":25882,"_17855":98629,"_24230":98630,"_2452":98631},[],"/docs/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_2926":59294,"_25561":59290,"_5":25882,"_17855":98633,"_24230":98634,"_2452":98635},[],"/docs/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_2926":59295,"_25561":59290,"_5":25882,"_17855":98637,"_24230":98638,"_2452":42397},[],"/docs/es/deployment/self-hosted/networking#k3s",{"_2926":59296,"_25561":59290,"_5":25882,"_17855":98640,"_24230":98641,"_2452":98642},[],"/docs/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_2926":59297,"_25561":59290,"_5":25882,"_17855":98644,"_24230":98645,"_2452":98646},[],"/docs/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_2926":59298,"_25561":59290,"_5":25882,"_17855":98648,"_24230":98649,"_2452":98650},[],"/docs/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_2926":59299,"_25561":59290,"_5":25882,"_17855":98652,"_24230":98653,"_2452":98654},[],"/docs/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_2926":59300,"_25561":59290,"_5":25882,"_17855":98656,"_24230":98657,"_2452":98658},[],"/docs/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_2926":59301,"_25561":59290,"_17855":98660,"_5":17750,"_24230":98626,"_2452":98661},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_2926":59302,"_25561":59290,"_17855":98663,"_5":17750,"_24230":98626,"_2452":98664},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_2926":59303,"_25561":59290,"_17855":98666,"_5":17750,"_24230":98630,"_2452":98667},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_2926":59304,"_25561":59290,"_17855":98669,"_5":17750,"_24230":98630,"_2452":98670},[],"Defínelo únicamente cuando:",{"_2926":59305,"_25561":59290,"_17855":98672,"_5":17750,"_24230":98630,"_2452":98673},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_2926":59306,"_25561":59290,"_17855":98675,"_5":17750,"_24230":98630,"_2452":98676},[],"esa dirección está asignada a este Gateway",{"_2926":59307,"_25561":59290,"_17855":98678,"_5":17750,"_24230":98630,"_2452":98679},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_2926":59308,"_25561":59290,"_17855":98681,"_5":17750,"_24230":98630,"_2452":98682},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_2926":59309,"_25561":59290,"_17855":98684,"_5":17750,"_24230":98630,"_2452":98685},[],"No confundas estos valores:",{"_2926":59310,"_25561":59290,"_17855":98687,"_5":17750,"_24230":98630,"_2452":98688},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_2926":59311,"_25561":59290,"_17855":98690,"_5":17750,"_24230":98630,"_2452":98691},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_2926":59312,"_25561":59290,"_17855":98693,"_5":17750,"_24230":98630,"_2452":98694},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_2926":59313,"_25561":59290,"_17855":98696,"_5":17750,"_24230":98634,"_2452":98697},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_2926":59314,"_25561":59290,"_17855":98699,"_5":17750,"_24230":98634,"_2452":98700},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_2926":59315,"_25561":59290,"_17855":98702,"_5":17750,"_24230":98638,"_2452":98703},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_2926":59316,"_25561":59290,"_17855":98705,"_5":17750,"_24230":98638,"_2452":98706},[],"Para el diseño recomendado:",{"_2926":59317,"_25561":59290,"_17855":98708,"_5":17750,"_24230":98638,"_2452":98709},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_2926":59318,"_25561":59290,"_17855":98711,"_5":17750,"_24230":98638,"_2452":98712},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_2926":59319,"_25561":59290,"_17855":98714,"_5":17750,"_24230":98638,"_2452":98715},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_2926":59320,"_25561":59290,"_17855":98717,"_5":17750,"_24230":98638,"_2452":98718},[],"Apunta DNS a la dirección accesible de la VM.",{"_2926":59321,"_25561":59290,"_17855":98720,"_5":17750,"_24230":98638,"_2452":98721},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_2926":59322,"_25561":59290,"_17855":98723,"_5":17750,"_24230":98641,"_2452":98724},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_2926":59323,"_25561":59290,"_17855":98726,"_5":17750,"_24230":98645,"_2452":98727},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_2926":59324,"_25561":59290,"_17855":98729,"_5":17750,"_24230":98645,"_2452":98730},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_2926":59325,"_25561":59290,"_17855":98732,"_5":17750,"_24230":98649,"_2452":98733},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_2926":59326,"_25561":59290,"_17855":98735,"_5":17750,"_24230":98649,"_2452":98736},[],"Requisito",{"_2926":59327,"_25561":59290,"_17855":98738,"_5":17750,"_24230":98649,"_2452":98739},[],"Diseño recomendado",{"_2926":59328,"_25561":59290,"_17855":98741,"_5":17750,"_24230":98649,"_2452":98742},[],"Consecuencia",{"_2926":59329,"_25561":59290,"_17855":98744,"_5":17750,"_24230":98649,"_2452":98745},[],"Varias URL o servicios de Lamassu",{"_2926":59330,"_25561":59290,"_17855":98747,"_5":17750,"_24230":98649,"_2452":98748},[],"Un Gateway con varias rutas",{"_2926":59331,"_25561":59290,"_17855":98750,"_5":17750,"_24230":98649,"_2452":98751},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_2926":59332,"_25561":59290,"_17855":98753,"_5":17750,"_24230":98649,"_2452":98754},[],"Gateways independientes e IP externas distintas",{"_2926":59333,"_25561":59290,"_17855":98756,"_5":17750,"_24230":98649,"_2452":98757},[],"Una VIP por Gateway",{"_2926":59334,"_25561":59290,"_17855":98759,"_5":17750,"_24230":98649,"_2452":98760},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_2926":59335,"_25561":59290,"_17855":98762,"_5":17750,"_24230":98649,"_2452":98763},[],"Gateways independientes, un nodo y una IP",{"_2926":59336,"_25561":59290,"_17855":98765,"_5":17750,"_24230":98649,"_2452":98766},[],"Puertos externos diferentes",{"_2926":59337,"_25561":59290,"_17855":98768,"_5":17750,"_24230":98649,"_2452":98769},[],"Los clientes deben indicar puertos no estándar",{"_2926":59338,"_25561":59290,"_17855":98771,"_5":17750,"_24230":98649,"_2452":98772},[],"Terminación TLS/mTLS separada detrás de una IP",{"_2926":59339,"_25561":59290,"_17855":98774,"_5":17750,"_24230":98649,"_2452":98775},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_2926":59340,"_25561":59290,"_17855":98777,"_5":17750,"_24230":98649,"_2452":98778},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_2926":59341,"_25561":59290,"_17855":98780,"_5":17750,"_24230":98649,"_2452":98781},[],"Recursos Gateway separados pero proxy compartido",{"_2926":59342,"_25561":59290,"_17855":98783,"_5":17750,"_24230":98649,"_2452":98784},[],"Modo merged Gateway de Envoy",{"_2926":59343,"_25561":59290,"_17855":98786,"_5":17750,"_24230":98649,"_2452":98787},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_2926":59344,"_25561":59290,"_17855":98789,"_5":17750,"_24230":98649,"_2452":98790},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_2926":59345,"_25561":59290,"_17855":98792,"_5":17750,"_24230":98649,"_2452":98793},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_2926":59346,"_25561":59290,"_17855":98795,"_5":17750,"_24230":98649,"_2452":98796},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_2926":59347,"_25561":59290,"_17855":98798,"_5":17750,"_24230":98649,"_2452":98799},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_2926":59348,"_25561":59290,"_17855":98801,"_5":17750,"_24230":98653,"_2452":98802},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_2926":59349,"_25561":59290,"_17855":98804,"_5":17750,"_24230":98653,"_2452":98805},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_2926":59350,"_25561":59290,"_17855":98807,"_5":17750,"_24230":98653,"_2452":98808},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_2926":59351,"_25561":59290,"_17855":98810,"_5":17750,"_24230":98653,"_2452":98811},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_2926":59352,"_25561":59290,"_17855":98813,"_5":17750,"_24230":98653,"_2452":98814},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_2926":59353,"_25561":59290,"_17855":98816,"_5":17750,"_24230":98657,"_2452":98817},[],"Comprueba, en orden:",{"_2926":59354,"_25561":59290,"_17855":98819,"_5":17750,"_24230":98657,"_2452":98820},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_2926":59355,"_25561":59290,"_17855":98822,"_5":17750,"_24230":98657,"_2452":98823},[],"Su estado contiene la dirección esperada.",{"_2926":59356,"_25561":59290,"_17855":98825,"_5":17750,"_24230":98657,"_2452":98826},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_2926":59357,"_25561":59290,"_17855":98828,"_5":17750,"_24230":98657,"_2452":98829},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_2926":59358,"_25561":59290,"_17855":98831,"_5":17750,"_24230":98657,"_2452":98832},[],"DNS resuelve al endpoint accesible externamente.",{"_2926":59359,"_25561":59290,"_17855":98834,"_5":17750,"_24230":98657,"_2452":98835},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_2926":59360,"_25561":59290,"_17855":98837,"_5":17750,"_24230":98657,"_2452":98838},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_2926":59361,"_25561":59361,"_5":12525,"_2452":41758,"_25885":98840,"_17855":98841,"_24230":59361},[41651,97926,98160],[],{"_2926":59362,"_25561":59361,"_17855":98843,"_5":17750,"_24230":59361,"_2452":98844},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_2926":59363,"_25561":59361,"_5":25882,"_17855":98846,"_24230":98847,"_2452":98848},[],"/docs/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_2926":59364,"_25561":59361,"_5":25882,"_17855":98850,"_24230":98851,"_2452":98852},[],"/docs/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_2926":59365,"_25561":59361,"_5":25882,"_17855":98854,"_24230":98855,"_2452":98856},[],"/docs/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_2926":59366,"_25561":59361,"_5":25882,"_17855":98858,"_24230":98859,"_2452":98860},[],"/docs/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_2926":59367,"_25561":59361,"_5":25882,"_17855":98862,"_24230":98863,"_2452":98864},[],"/docs/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_2926":59368,"_25561":59361,"_5":25882,"_17855":98866,"_24230":98867,"_2452":98868},[],"/docs/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_2926":59369,"_25561":59361,"_17855":98870,"_5":17750,"_24230":98847,"_2452":98871},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_2926":59370,"_25561":59361,"_17855":98873,"_5":17750,"_24230":98851,"_2452":98874},[],"Flujo",{"_2926":59371,"_25561":59361,"_17855":98876,"_5":17750,"_24230":98851,"_2452":98877},[],"Úsalo para",{"_2926":59372,"_25561":59361,"_17855":98879,"_5":17750,"_24230":98851,"_2452":98880},[],"Qué instala",{"_2926":59373,"_25561":59361,"_17855":98882,"_5":17750,"_24230":98851,"_2452":42642},[],{"_2926":59374,"_25561":59361,"_17855":98884,"_5":17750,"_24230":98851,"_2452":98885},[],"Producción y entornos controlados",{"_2926":59375,"_25561":59361,"_17855":98887,"_5":17750,"_24230":98851,"_2452":98888},[],"Servicios de Lamassu y recursos de Gateway API",{"_2926":59376,"_25561":59361,"_17855":98890,"_5":17750,"_24230":98851,"_2452":41895},[],{"_2926":59377,"_25561":59361,"_17855":98892,"_5":17750,"_24230":98851,"_2452":98893},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_2926":59378,"_25561":59361,"_17855":98895,"_5":17750,"_24230":98851,"_2452":98896},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_2926":59379,"_25561":59361,"_17855":98898,"_5":17750,"_24230":98855,"_2452":98899},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_2926":59380,"_25561":59361,"_17855":98901,"_5":17750,"_24230":98855,"_2452":98902},[],"Área",{"_2926":59381,"_25561":59361,"_17855":98904,"_5":17750,"_24230":98855,"_2452":98905},[],"El chart de Lamassu proporciona",{"_2926":59382,"_25561":59361,"_17855":98907,"_5":17750,"_24230":98855,"_2452":98908},[],"Tú proporcionas",{"_2926":59383,"_25561":59361,"_17855":98910,"_5":17750,"_24230":98855,"_2452":98911},[],"Aplicaciones Lamassu",{"_2926":59384,"_25561":59361,"_17855":98913,"_5":17750,"_24230":98855,"_2452":98914},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_2926":59385,"_25561":59361,"_17855":98916,"_5":17750,"_24230":98855,"_2452":98917},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_2926":59386,"_25561":59361,"_17855":98919,"_5":17750,"_24230":98855,"_2452":98920},[],"Datos PostgreSQL",{"_2926":59387,"_25561":59361,"_17855":98922,"_5":17750,"_24230":98855,"_2452":98923},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_2926":59388,"_25561":59361,"_17855":98925,"_5":17750,"_24230":98855,"_2452":98926},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_2926":59389,"_25561":59361,"_17855":98928,"_5":17750,"_24230":98855,"_2452":98929},[],"Mensajería",{"_2926":59390,"_25561":59361,"_17855":98931,"_5":17750,"_24230":98855,"_2452":98932},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu",{"_2926":59391,"_25561":59361,"_17855":98934,"_5":17750,"_24230":98855,"_2452":98935},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_2926":59392,"_25561":59361,"_17855":98937,"_5":17750,"_24230":98855,"_2452":98938},[],"Identidad",{"_2926":59393,"_25561":59361,"_17855":98940,"_5":17750,"_24230":98855,"_2452":98941},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_2926":59394,"_25561":59361,"_17855":98943,"_5":17750,"_24230":98855,"_2452":98944},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_2926":59395,"_25561":59361,"_17855":98946,"_5":17750,"_24230":98855,"_2452":98947},[],"Enrutamiento externo",{"_2926":59396,"_25561":59361,"_17855":98949,"_5":17750,"_24230":98855,"_2452":98950},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_2926":59397,"_25561":59361,"_17855":98952,"_5":17750,"_24230":98855,"_2452":98953},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_2926":59398,"_25561":59361,"_17855":98955,"_5":17750,"_24230":98855,"_2452":42716},[],{"_2926":59399,"_25561":59361,"_17855":98957,"_5":17750,"_24230":98855,"_2452":98958},[],"Recursos `Issuer` y `Certificate` CA de cert-manager; un `Certificate` downstream gestionado por el chart o una referencia a tu Secret TLS",{"_2926":59400,"_25561":59361,"_17855":98960,"_5":17750,"_24230":98855,"_2452":98961},[],"cert-manager; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_2926":59401,"_25561":59361,"_17855":98963,"_5":17750,"_24230":98855,"_2452":98964},[],"Datos persistentes de la aplicación",{"_2926":59402,"_25561":59361,"_17855":98966,"_5":17750,"_24230":98855,"_2452":98967},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_2926":59403,"_25561":59361,"_17855":98969,"_5":17750,"_24230":98855,"_2452":98970},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_2926":59404,"_25561":59361,"_17855":98972,"_5":17750,"_24230":98855,"_2452":98973},[],"Integraciones opcionales",{"_2926":59405,"_25561":59361,"_17855":98975,"_5":17750,"_24230":98855,"_2452":98976},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_2926":59406,"_25561":59361,"_17855":98978,"_5":17750,"_24230":98855,"_2452":98979},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_2926":59407,"_25561":59361,"_17855":98981,"_5":17750,"_24230":98855,"_2452":98982},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_2926":59408,"_25561":59361,"_17855":98984,"_5":17750,"_24230":98855,"_2452":98985},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_2926":59409,"_25561":59361,"_17855":98987,"_5":17750,"_24230":98859,"_2452":98988},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_2926":59410,"_25561":59361,"_17855":98990,"_5":17750,"_24230":98859,"_2452":98991},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_2926":59411,"_25561":59361,"_17855":98993,"_5":17750,"_24230":98863,"_2452":98994},[],"Kubernetes 1.24 o posterior",{"_2926":59412,"_25561":59361,"_17855":98996,"_5":17750,"_24230":98863,"_2452":98997},[],"Helm 3.2 o posterior",{"_2926":59413,"_25561":59361,"_17855":98999,"_5":17750,"_24230":98863,"_2452":99000},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_2926":59414,"_25561":59361,"_17855":99002,"_5":17750,"_24230":98863,"_2452":99003},[],"cert-manager 1.14 o posterior; el chart actual renderiza recursos issuer y certificate de cert-manager",{"_2926":59415,"_25561":59361,"_17855":99005,"_5":17750,"_24230":98863,"_2452":99006},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_2926":59416,"_25561":59361,"_17855":99008,"_5":17750,"_24230":98863,"_2452":99009},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_2926":59417,"_25561":59361,"_17855":99011,"_5":17750,"_24230":98863,"_2452":99012},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior.",{"_2926":59418,"_25561":59361,"_17855":99014,"_5":17750,"_24230":98867,"_2452":99015},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2926":59419,"_25561":59361,"_17855":99017,"_5":17750,"_24230":98867,"_2452":99018},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2926":59420,"_25561":59361,"_17855":99020,"_5":17750,"_24230":98867,"_2452":99021},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2926":59421,"_25561":59421,"_5":12525,"_2452":99023,"_25885":99024,"_17855":99026,"_24230":59421},"Resolución de problemas de despliegue",[41651,97926,99025],"Operación",[],{"_2926":59422,"_25561":59421,"_17855":99028,"_5":17750,"_24230":59421,"_2452":99029},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_2926":59423,"_25561":59421,"_5":25882,"_17855":99031,"_24230":99032,"_2452":99033},[],"/docs/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_2926":59424,"_25561":59421,"_5":25882,"_17855":99035,"_24230":99036,"_2452":99037},[],"/docs/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_2926":59425,"_25561":59421,"_5":25882,"_17855":99039,"_24230":99040,"_2452":99041},[],"/docs/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_2926":59426,"_25561":59421,"_5":25882,"_17855":99043,"_24230":99044,"_2452":99045},[],"/docs/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_2926":59427,"_25561":59421,"_5":25882,"_17855":99047,"_24230":99048,"_2452":99049},[],"/docs/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_2926":59428,"_25561":59421,"_5":25882,"_17855":99051,"_24230":99052,"_2452":99053},[],"/docs/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_2926":59429,"_25561":59421,"_5":25882,"_17855":99055,"_24230":99056,"_2452":99057},[],"/docs/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_2926":59430,"_25561":59421,"_5":25882,"_17855":99059,"_24230":99060,"_2452":99061},[],"/docs/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_2926":59431,"_25561":59421,"_5":25882,"_17855":99063,"_24230":99064,"_2452":99065},[],"/docs/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_2926":59432,"_25561":59421,"_5":25882,"_17855":99067,"_24230":99068,"_2452":99069},[],"/docs/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_2926":59433,"_25561":59421,"_5":25882,"_17855":99071,"_24230":99072,"_2452":99073},[],"/docs/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_2926":59434,"_25561":59421,"_5":25882,"_17855":99075,"_24230":99076,"_2452":99077},[],"/docs/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_2926":59435,"_25561":59421,"_17855":99079,"_5":17750,"_24230":59421,"_2452":99080},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_2926":59436,"_25561":59421,"_17855":99082,"_5":17750,"_24230":99036,"_2452":99083},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_2926":59437,"_25561":59421,"_17855":99085,"_5":17750,"_24230":99040,"_2452":99086},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_2926":59438,"_25561":59421,"_17855":99088,"_5":17750,"_24230":99044,"_2452":99089},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_2926":59439,"_25561":59421,"_17855":99091,"_5":17750,"_24230":99048,"_2452":99092},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_2926":59440,"_25561":59421,"_17855":99094,"_5":17750,"_24230":99052,"_2452":99095},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_2926":59441,"_25561":59421,"_17855":99097,"_5":17750,"_24230":99056,"_2452":99098},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_2926":59442,"_25561":59421,"_17855":99100,"_5":17750,"_24230":99056,"_2452":99101},[],"Ejecuta también la prueba de conectividad del chart:",{"_2926":59443,"_25561":59421,"_17855":99103,"_5":17750,"_24230":99056,"_2452":99104},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_2926":59444,"_25561":59421,"_17855":99106,"_5":17750,"_24230":99056,"_2452":99107},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_2926":59445,"_25561":59421,"_17855":99109,"_5":17750,"_24230":99060,"_2452":99110},[],"Si recibes un 401:",{"_2926":59446,"_25561":59421,"_17855":99112,"_5":17750,"_24230":99060,"_2452":99113},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_2926":59447,"_25561":59421,"_17855":99115,"_5":17750,"_24230":99060,"_2452":99116},[],"verifica emisor, audiencia y expiración del token;",{"_2926":59448,"_25561":59421,"_17855":99118,"_5":17750,"_24230":99060,"_2452":99119},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_2926":59449,"_25561":59421,"_17855":99121,"_5":17750,"_24230":99060,"_2452":99122},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_2926":59450,"_25561":59421,"_17855":99124,"_5":17750,"_24230":99060,"_2452":99125},[],"Si el login termina pero las APIs devuelven 403:",{"_2926":59451,"_25561":59421,"_17855":99127,"_5":17750,"_24230":99060,"_2452":99128},[],"inspecciona los claims reales del token;",{"_2926":59452,"_25561":59421,"_17855":99130,"_5":17750,"_24230":99060,"_2452":99131},[],"confirma que coinciden con un principal activo;",{"_2926":59453,"_25561":59421,"_17855":99133,"_5":17750,"_24230":99060,"_2452":99134},[],"revisa las políticas concedidas al principal;",{"_2926":59454,"_25561":59421,"_17855":99136,"_5":17750,"_24230":99060,"_2452":99137},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_2926":59455,"_25561":59421,"_17855":99139,"_5":17750,"_24230":99060,"_2452":99140},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_2926":59456,"_25561":59421,"_17855":99142,"_5":17750,"_24230":99064,"_2452":99143},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_2926":59457,"_25561":59421,"_17855":99145,"_5":17750,"_24230":99064,"_2452":99146},[],"Localiza el pod y Service de authz.",{"_2926":59458,"_25561":59421,"_17855":99148,"_5":17750,"_24230":99064,"_2452":99149},[],"Comprueba /health, logs y conexión a su base de datos.",{"_2926":59459,"_25561":59421,"_17855":99151,"_5":17750,"_24230":99064,"_2452":99152},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_2926":59460,"_25561":59421,"_17855":99154,"_5":17750,"_24230":99064,"_2452":99155},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_2926":59461,"_25561":59421,"_17855":99157,"_5":17750,"_24230":99064,"_2452":99158},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_2926":59462,"_25561":59421,"_17855":99160,"_5":17750,"_24230":99068,"_2452":99161},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_2926":59463,"_25561":59421,"_17855":99163,"_5":17750,"_24230":99068,"_2452":99164},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_2926":59464,"_25561":59421,"_17855":99166,"_5":17750,"_24230":99068,"_2452":99167},[],"volumen persistente sin enlazar;",{"_2926":59465,"_25561":59421,"_17855":99169,"_5":17750,"_24230":99068,"_2452":99170},[],"imagen inaccesible o política de pull incorrecta;",{"_2926":59466,"_25561":59421,"_17855":99172,"_5":17750,"_24230":99068,"_2452":99173},[],"configuración inválida del motor criptográfico;",{"_2926":59467,"_25561":59421,"_17855":99175,"_5":17750,"_24230":99068,"_2452":99176},[],"límites de CPU o memoria demasiado bajos;",{"_2926":59468,"_25561":59421,"_17855":99178,"_5":17750,"_24230":99068,"_2452":99179},[],"migración previa incompleta.",{"_2926":59469,"_25561":59421,"_17855":99181,"_5":17750,"_24230":99068,"_2452":99182},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_2926":59470,"_25561":59421,"_17855":99184,"_5":17750,"_24230":99068,"_2452":99185},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_2926":59471,"_25561":59421,"_17855":99187,"_5":17750,"_24230":99072,"_2452":99188},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_2926":59472,"_25561":59421,"_17855":99190,"_5":17750,"_24230":99072,"_2452":99191},[],"verifica que esté habilitado en el servicio emisor;",{"_2926":59473,"_25561":59421,"_17855":99193,"_5":17750,"_24230":99072,"_2452":99194},[],"comprueba conectividad y credenciales AMQP;",{"_2926":59474,"_25561":59421,"_17855":99196,"_5":17750,"_24230":99072,"_2452":99197},[],"revisa exchange, routing key, colas y consumidores;",{"_2926":59475,"_25561":59421,"_17855":99199,"_5":17750,"_24230":99072,"_2452":99200},[],"inspecciona dead-letter queues;",{"_2926":59476,"_25561":59421,"_17855":99202,"_5":17750,"_24230":99072,"_2452":99203},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_2926":59477,"_25561":59421,"_17855":99205,"_5":17750,"_24230":99072,"_2452":99206},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_2926":59478,"_25561":59421,"_17855":99208,"_5":17750,"_24230":99076,"_2452":99209},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_2926":59479,"_25561":59421,"_17855":99211,"_5":17750,"_24230":99076,"_2452":99212},[],"Antes de cerrar una incidencia, guarda:",{"_2926":59480,"_25561":59421,"_17855":99214,"_5":17750,"_24230":99076,"_2452":99215},[],"causa confirmada;",{"_2926":59481,"_25561":59421,"_17855":99217,"_5":17750,"_24230":99076,"_2452":99218},[],"alcance temporal y recursos afectados;",{"_2926":59482,"_25561":59421,"_17855":99220,"_5":17750,"_24230":99076,"_2452":99221},[],"comandos o consultas utilizados;",{"_2926":59483,"_25561":59421,"_17855":99223,"_5":17750,"_24230":99076,"_2452":99224},[],"cambio aplicado y forma de revertirlo;",{"_2926":59484,"_25561":59421,"_17855":99226,"_5":17750,"_24230":99076,"_2452":99227},[],"validación desde un consumidor;",{"_2926":59485,"_25561":59421,"_17855":99229,"_5":17750,"_24230":99076,"_2452":99230},[],"acción preventiva y propietario.",{"_2926":59486,"_25561":59486,"_5":12525,"_2452":99232,"_25885":99233,"_17855":99236,"_24230":59486},"Control de acceso",[41651,99234,99235],"Plataforma","Administración",[],{"_2926":59487,"_25561":59486,"_17855":99238,"_5":17750,"_24230":59486,"_2452":99239},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_2926":59488,"_25561":59486,"_5":25882,"_17855":99241,"_24230":99242,"_2452":99243},[],"/docs/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_2926":59489,"_25561":59486,"_5":25882,"_17855":99245,"_24230":99246,"_2452":99247},[],"/docs/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_2926":59490,"_25561":59486,"_5":25882,"_17855":99249,"_24230":99250,"_2452":99251},[],"/docs/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_2926":59491,"_25561":59486,"_5":25882,"_17855":99253,"_24230":99254,"_2452":99255},[],"/docs/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_2926":59492,"_25561":59486,"_5":25882,"_17855":99257,"_24230":99258,"_2452":99259},[],"/docs/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_2926":59493,"_25561":59486,"_5":25882,"_17855":99261,"_24230":99262,"_2452":99263},[],"/docs/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_2926":59494,"_25561":59486,"_5":25882,"_17855":99265,"_24230":99266,"_2452":99267},[],"/docs/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_2926":59495,"_25561":59486,"_5":25882,"_17855":99269,"_24230":99270,"_2452":99271},[],"/docs/es/platform/administration/access-control#principales-x509","Principales X.509",{"_2926":59496,"_25561":59486,"_5":25882,"_17855":99273,"_24230":99274,"_2452":99275},[],"/docs/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_2926":59497,"_25561":59486,"_5":25882,"_17855":99277,"_24230":99278,"_2452":99279},[],"/docs/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_2926":59498,"_25561":59486,"_5":25882,"_17855":99281,"_24230":99282,"_2452":99283},[],"/docs/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_2926":59499,"_25561":59486,"_5":25882,"_17855":99285,"_24230":99286,"_2452":99287},[],"/docs/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_2926":59500,"_25561":59486,"_5":25882,"_17855":99289,"_24230":99290,"_2452":99291},[],"/docs/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_2926":59501,"_25561":59486,"_5":25882,"_17855":99293,"_24230":99294,"_2452":99295},[],"/docs/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_2926":59502,"_25561":59486,"_5":25882,"_17855":99297,"_24230":99298,"_2452":99299},[],"/docs/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_2926":59503,"_25561":59486,"_5":25882,"_17855":99301,"_24230":99302,"_2452":98496},[],"/docs/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_2926":59504,"_25561":59486,"_5":25882,"_17855":99304,"_24230":99305,"_2452":99306},[],"/docs/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_2926":59505,"_25561":59486,"_5":25882,"_17855":99308,"_24230":99309,"_2452":99310},[],"/docs/es/platform/administration/access-control#configura-las-dos-validaciones-jwt","Configura las dos validaciones JWT",{"_2926":59506,"_25561":59486,"_5":25882,"_17855":99312,"_24230":99313,"_2452":99314},[],"/docs/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_2926":59507,"_25561":59486,"_5":25882,"_17855":99316,"_24230":99317,"_2452":99318},[],"/docs/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_2926":59508,"_25561":59486,"_5":25882,"_17855":99320,"_24230":99321,"_2452":99322},[],"/docs/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_2926":59509,"_25561":59486,"_5":25882,"_17855":99324,"_24230":99325,"_2452":99326},[],"/docs/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_2926":59510,"_25561":59486,"_5":25882,"_17855":99328,"_24230":99329,"_2452":99330},[],"/docs/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_2926":59511,"_25561":59486,"_5":25882,"_17855":99332,"_24230":99333,"_2452":99334},[],"/docs/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_2926":59512,"_25561":59486,"_5":25882,"_17855":99336,"_24230":99337,"_2452":99338},[],"/docs/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_2926":59513,"_25561":59486,"_5":25882,"_17855":99340,"_24230":99341,"_2452":99342},[],"/docs/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_2926":59514,"_25561":59486,"_5":25882,"_17855":99344,"_24230":99345,"_2452":99346},[],"/docs/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_2926":59515,"_25561":59486,"_5":25882,"_17855":99348,"_24230":99349,"_2452":99350},[],"/docs/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_2926":59516,"_25561":59486,"_5":25882,"_17855":99352,"_24230":99353,"_2452":99354},[],"/docs/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_2926":59517,"_25561":59486,"_5":25882,"_17855":99356,"_24230":99357,"_2452":99358},[],"/docs/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_2926":59518,"_25561":59486,"_5":25882,"_17855":99360,"_24230":99361,"_2452":99362},[],"/docs/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_2926":59519,"_25561":59486,"_17855":99364,"_5":17750,"_24230":59486,"_2452":99365},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_2926":59520,"_25561":59486,"_17855":99367,"_5":17750,"_24230":59486,"_2452":99368},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_2926":59521,"_25561":59486,"_17855":99370,"_5":17750,"_24230":59486,"_2452":99371},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_2926":59522,"_25561":59486,"_17855":99373,"_5":17750,"_24230":99242,"_2452":99374},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_2926":59523,"_25561":59486,"_17855":99376,"_5":17750,"_24230":99242,"_2452":99377},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_2926":59524,"_25561":59486,"_17855":99379,"_5":17750,"_24230":99242,"_2452":99380},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_2926":59525,"_25561":59486,"_17855":99382,"_5":17750,"_24230":99242,"_2452":99383},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_2926":59526,"_25561":59486,"_17855":99385,"_5":17750,"_24230":99242,"_2452":99386},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_2926":59527,"_25561":59486,"_17855":99388,"_5":17750,"_24230":99242,"_2452":99389},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_2926":59528,"_25561":59486,"_17855":99391,"_5":17750,"_24230":99246,"_2452":99392},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_2926":59529,"_25561":59486,"_17855":99394,"_5":17750,"_24230":99246,"_2452":99395},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_2926":59530,"_25561":59486,"_17855":99397,"_5":17750,"_24230":99250,"_2452":99398},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_2926":59531,"_25561":59486,"_17855":99400,"_5":17750,"_24230":99250,"_2452":99401},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_2926":59532,"_25561":59486,"_17855":99403,"_5":17750,"_24230":99250,"_2452":99404},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_2926":59533,"_25561":59486,"_17855":99406,"_5":17750,"_24230":99250,"_2452":99407},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_2926":59534,"_25561":59486,"_17855":99409,"_5":17750,"_24230":99250,"_2452":99410},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_2926":59535,"_25561":59486,"_17855":99412,"_5":17750,"_24230":99250,"_2452":99413},[],"Carga por separado las políticas concedidas a cada principal.",{"_2926":59536,"_25561":59486,"_17855":99415,"_5":17750,"_24230":99250,"_2452":99416},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_2926":59537,"_25561":59486,"_17855":99418,"_5":17750,"_24230":99250,"_2452":99419},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_2926":59538,"_25561":59486,"_17855":99421,"_5":17750,"_24230":99250,"_2452":99422},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_2926":59539,"_25561":59486,"_17855":99424,"_5":17750,"_24230":99250,"_2452":99425},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_2926":59540,"_25561":59486,"_17855":99427,"_5":17750,"_24230":99250,"_2452":99428},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_2926":59541,"_25561":59486,"_17855":99430,"_5":17750,"_24230":99250,"_2452":99431},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_2926":59542,"_25561":59486,"_17855":99433,"_5":17750,"_24230":99254,"_2452":99434},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_2926":59543,"_25561":59486,"_17855":99436,"_5":17750,"_24230":99254,"_2452":99437},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_2926":59544,"_25561":59486,"_17855":99439,"_5":17750,"_24230":99254,"_2452":99440},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_2926":59545,"_25561":59486,"_17855":99442,"_5":17750,"_24230":99254,"_2452":99443},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_2926":59546,"_25561":59486,"_17855":99445,"_5":17750,"_24230":99254,"_2452":99446},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_2926":59547,"_25561":59486,"_17855":99448,"_5":17750,"_24230":99254,"_2452":99449},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_2926":59548,"_25561":59486,"_17855":99451,"_5":17750,"_24230":99254,"_2452":99452},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_2926":59549,"_25561":59486,"_17855":99454,"_5":17750,"_24230":99254,"_2452":99455},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_2926":59550,"_25561":59486,"_17855":99457,"_5":17750,"_24230":99258,"_2452":99458},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_2926":59551,"_25561":59486,"_17855":99460,"_5":17750,"_24230":99258,"_2452":99461},[],"La decisión se toma con el contexto de la operación de dominio:",{"_2926":59552,"_25561":59486,"_17855":99463,"_5":17750,"_24230":99258,"_2452":99464},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_2926":59553,"_25561":59486,"_17855":99466,"_5":17750,"_24230":99258,"_2452":99467},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_2926":59554,"_25561":59486,"_17855":99469,"_5":17750,"_24230":99258,"_2452":99470},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_2926":59555,"_25561":59486,"_17855":99472,"_5":17750,"_24230":99258,"_2452":99473},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_2926":59556,"_25561":59486,"_17855":99475,"_5":17750,"_24230":99258,"_2452":99476},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_2926":59557,"_25561":59486,"_17855":99478,"_5":17750,"_24230":99258,"_2452":99479},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_2926":59558,"_25561":59486,"_17855":99481,"_5":17750,"_24230":99258,"_2452":99482},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_2926":59559,"_25561":59486,"_17855":99484,"_5":17750,"_24230":99258,"_2452":99485},[],"Las acciones se dividen en dos grupos:",{"_2926":59560,"_25561":59486,"_17855":99487,"_5":17750,"_24230":99258,"_2452":99488},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_2926":59561,"_25561":59486,"_17855":99490,"_5":17750,"_24230":99258,"_2452":99491},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_2926":59562,"_25561":59486,"_17855":99493,"_5":17750,"_24230":99258,"_2452":99494},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_2926":59563,"_25561":59486,"_17855":99496,"_5":17750,"_24230":99262,"_2452":99497},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_2926":59564,"_25561":59486,"_17855":99499,"_5":17750,"_24230":99262,"_2452":99500},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_2926":59565,"_25561":59486,"_17855":99502,"_5":17750,"_24230":99262,"_2452":99503},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_2926":59566,"_25561":59486,"_17855":99505,"_5":17750,"_24230":99266,"_2452":99506},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_2926":59567,"_25561":59486,"_17855":99508,"_5":17750,"_24230":99266,"_2452":99509},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_2926":59568,"_25561":59486,"_17855":99511,"_5":17750,"_24230":99266,"_2452":99512},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_2926":59569,"_25561":59486,"_17855":99514,"_5":17750,"_24230":99266,"_2452":99515},[],"Los operadores implementados son:",{"_2926":59570,"_25561":59486,"_17855":99517,"_5":17750,"_24230":99266,"_2452":99518},[],"`equals`, para igualdad exacta;",{"_2926":59571,"_25561":59486,"_17855":99520,"_5":17750,"_24230":99266,"_2452":99521},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_2926":59572,"_25561":59486,"_17855":99523,"_5":17750,"_24230":99266,"_2452":99524},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_2926":59573,"_25561":59486,"_17855":99526,"_5":17750,"_24230":99266,"_2452":99527},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_2926":59574,"_25561":59486,"_17855":99529,"_5":17750,"_24230":99270,"_2452":99530},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_2926":59575,"_25561":59486,"_17855":99532,"_5":17750,"_24230":99270,"_2452":99533},[],"Los modos disponibles son:",{"_2926":59576,"_25561":59486,"_17855":99535,"_5":17750,"_24230":99270,"_2452":99536},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_2926":59577,"_25561":59486,"_17855":99538,"_5":17750,"_24230":99270,"_2452":99539},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_2926":59578,"_25561":59486,"_17855":99541,"_5":17750,"_24230":99270,"_2452":99542},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_2926":59579,"_25561":59486,"_17855":99544,"_5":17750,"_24230":99270,"_2452":99545},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_2926":59580,"_25561":59486,"_17855":99547,"_5":17750,"_24230":99270,"_2452":99548},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_2926":59581,"_25561":59486,"_17855":99550,"_5":17750,"_24230":99270,"_2452":99551},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_2926":59582,"_25561":59486,"_17855":99553,"_5":17750,"_24230":99274,"_2452":99554},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_2926":59583,"_25561":59486,"_17855":99556,"_5":17750,"_24230":99274,"_2452":99557},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_2926":59584,"_25561":59486,"_17855":99559,"_5":17750,"_24230":99274,"_2452":99560},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_2926":59585,"_25561":59486,"_17855":99562,"_5":17750,"_24230":99274,"_2452":99563},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_2926":59586,"_25561":59486,"_17855":99565,"_5":17750,"_24230":99282,"_2452":99566},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_2926":59587,"_25561":59486,"_17855":99568,"_5":17750,"_24230":99282,"_2452":99569},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_2926":59588,"_25561":59486,"_17855":99571,"_5":17750,"_24230":99286,"_2452":99572},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_2926":59589,"_25561":59486,"_17855":99574,"_5":17750,"_24230":99286,"_2452":99575},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_2926":59590,"_25561":59486,"_17855":99577,"_5":17750,"_24230":99290,"_2452":99578},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_2926":59591,"_25561":59486,"_17855":99580,"_5":17750,"_24230":99290,"_2452":99581},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_2926":59592,"_25561":59486,"_17855":99583,"_5":17750,"_24230":99290,"_2452":99584},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_2926":59593,"_25561":59486,"_17855":99586,"_5":17750,"_24230":99294,"_2452":99587},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_2926":59594,"_25561":59486,"_17855":99589,"_5":17750,"_24230":99294,"_2452":99590},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_2926":59595,"_25561":59486,"_17855":99592,"_5":17750,"_24230":99294,"_2452":99593},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_2926":59596,"_25561":59486,"_17855":99595,"_5":17750,"_24230":99294,"_2452":99596},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_2926":59597,"_25561":59486,"_17855":99598,"_5":17750,"_24230":99294,"_2452":99599},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_2926":59598,"_25561":59486,"_17855":99601,"_5":17750,"_24230":99294,"_2452":99602},[],"Ten en cuenta que:",{"_2926":59599,"_25561":59486,"_17855":99604,"_5":17750,"_24230":99294,"_2452":99605},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_2926":59600,"_25561":59486,"_17855":99607,"_5":17750,"_24230":99294,"_2452":99608},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_2926":59601,"_25561":59486,"_17855":99610,"_5":17750,"_24230":99294,"_2452":99611},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_2926":59602,"_25561":59486,"_17855":99613,"_5":17750,"_24230":99298,"_2452":99614},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_2926":59603,"_25561":59486,"_17855":99616,"_5":17750,"_24230":99298,"_2452":99617},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_2926":59604,"_25561":59486,"_17855":99619,"_5":17750,"_24230":99298,"_2452":99620},[],"acceso completo y de solo lectura a KMS;",{"_2926":59605,"_25561":59486,"_17855":99622,"_5":17750,"_24230":99298,"_2452":99623},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_2926":59606,"_25561":59486,"_17855":99625,"_5":17750,"_24230":99298,"_2452":99626},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_2926":59607,"_25561":59486,"_17855":99628,"_5":17750,"_24230":99298,"_2452":99629},[],"acceso a la interfaz;",{"_2926":59608,"_25561":59486,"_17855":99631,"_5":17750,"_24230":99298,"_2452":99632},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_2926":59609,"_25561":59486,"_17855":99634,"_5":17750,"_24230":99298,"_2452":99635},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_2926":59610,"_25561":59486,"_17855":99637,"_5":17750,"_24230":99298,"_2452":99638},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_2926":59611,"_25561":59486,"_17855":99640,"_5":17750,"_24230":99302,"_2452":99641},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_2926":59612,"_25561":59486,"_17855":99643,"_5":17750,"_24230":99302,"_2452":99644},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_2926":59613,"_25561":59486,"_17855":99646,"_5":17750,"_24230":99302,"_2452":99647},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_2926":59614,"_25561":59486,"_17855":99649,"_5":17750,"_24230":99305,"_2452":99650},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_2926":59615,"_25561":59486,"_17855":99652,"_5":17750,"_24230":99309,"_2452":99653},[],"El Gateway utiliza `auth.authentication.apiGateway.jwks` para autenticar peticiones. `authz` utiliza `services.authz.jwkUrl` para resolver los principales OIDC. Ambos endpoints deben contener las claves del mismo emisor y ser alcanzables desde sus respectivos componentes.",{"_2926":59616,"_25561":59486,"_17855":99655,"_5":17750,"_24230":99313,"_2452":99656},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_2926":59617,"_25561":59486,"_17855":99658,"_5":17750,"_24230":99317,"_2452":99659},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_2926":59618,"_25561":59486,"_17855":99661,"_5":17750,"_24230":99321,"_2452":99662},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_2926":59619,"_25561":59486,"_17855":99664,"_5":17750,"_24230":99325,"_2452":99665},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_2926":59620,"_25561":59486,"_17855":99667,"_5":17750,"_24230":99325,"_2452":99668},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_2926":59621,"_25561":59486,"_17855":99670,"_5":17750,"_24230":99329,"_2452":99671},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_2926":59622,"_25561":59486,"_17855":99673,"_5":17750,"_24230":99329,"_2452":99674},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_2926":59623,"_25561":59486,"_17855":99676,"_5":17750,"_24230":99329,"_2452":99677},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_2926":59624,"_25561":59486,"_17855":99679,"_5":17750,"_24230":99329,"_2452":99680},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_2926":59625,"_25561":59486,"_17855":99682,"_5":17750,"_24230":99329,"_2452":99683},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_2926":59626,"_25561":59486,"_17855":99685,"_5":17750,"_24230":99329,"_2452":99686},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_2926":59627,"_25561":59486,"_17855":99688,"_5":17750,"_24230":99329,"_2452":99689},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_2926":59628,"_25561":59486,"_17855":99691,"_5":17750,"_24230":99329,"_2452":99692},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_2926":59629,"_25561":59486,"_17855":99694,"_5":17750,"_24230":99333,"_2452":99695},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_2926":59630,"_25561":59486,"_17855":99697,"_5":17750,"_24230":99333,"_2452":99698},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_2926":59631,"_25561":59486,"_17855":99700,"_5":17750,"_24230":99333,"_2452":99701},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_2926":59632,"_25561":59486,"_17855":99703,"_5":17750,"_24230":99337,"_2452":99704},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_2926":59633,"_25561":59486,"_17855":99706,"_5":17750,"_24230":99337,"_2452":99707},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_2926":59634,"_25561":59486,"_17855":99709,"_5":17750,"_24230":99337,"_2452":99710},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_2926":59635,"_25561":59486,"_17855":99712,"_5":17750,"_24230":99337,"_2452":99713},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_2926":59636,"_25561":59486,"_17855":99715,"_5":17750,"_24230":99337,"_2452":99716},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_2926":59637,"_25561":59486,"_17855":99718,"_5":17750,"_24230":99337,"_2452":99719},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_2926":59638,"_25561":59486,"_17855":99721,"_5":17750,"_24230":99337,"_2452":99722},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_2926":59639,"_25561":59486,"_17855":99724,"_5":17750,"_24230":99337,"_2452":99725},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_2926":59640,"_25561":59486,"_17855":99727,"_5":17750,"_24230":99345,"_2452":99728},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_2926":59641,"_25561":59486,"_17855":99730,"_5":17750,"_24230":99349,"_2452":99731},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_2926":59642,"_25561":59486,"_17855":99733,"_5":17750,"_24230":99349,"_2452":99734},[],"que exista un principal activo del tipo correcto;",{"_2926":59643,"_25561":59486,"_17855":99736,"_5":17750,"_24230":99349,"_2452":99737},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_2926":59644,"_25561":59486,"_17855":99739,"_5":17750,"_24230":99349,"_2452":99740},[],"que todas las condiciones del principal se cumplan;",{"_2926":59645,"_25561":59486,"_17855":99742,"_5":17750,"_24230":99349,"_2452":99743},[],"que el principal tenga concedida la política esperada;",{"_2926":59646,"_25561":59486,"_17855":99745,"_5":17750,"_24230":99349,"_2452":99746},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_2926":59647,"_25561":59486,"_17855":99748,"_5":17750,"_24230":99349,"_2452":99749},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_2926":59648,"_25561":59486,"_17855":99751,"_5":17750,"_24230":99349,"_2452":99752},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway.",{"_2926":59649,"_25561":59486,"_17855":99754,"_5":17750,"_24230":99353,"_2452":99755},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_2926":59650,"_25561":59486,"_17855":99757,"_5":17750,"_24230":99357,"_2452":99758},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_2926":59651,"_25561":59486,"_17855":99760,"_5":17750,"_24230":99361,"_2452":99761},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_2926":59652,"_25561":59486,"_17855":99763,"_5":17750,"_24230":99361,"_2452":99764},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_2926":59653,"_25561":59653,"_5":12525,"_2452":99766,"_25885":99767,"_17855":99768,"_24230":59653},"Alertas y suscripciones",[41651,99234,99235],[],{"_2926":59654,"_25561":59653,"_17855":99770,"_5":17750,"_24230":59653,"_2452":99771},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_2926":59655,"_25561":59653,"_5":25882,"_17855":99773,"_24230":99774,"_2452":99775},[],"/docs/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_2926":59656,"_25561":59653,"_5":25882,"_17855":99777,"_24230":99778,"_2452":99779},[],"/docs/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_2926":59657,"_25561":59653,"_5":25882,"_17855":99781,"_24230":99782,"_2452":99783},[],"/docs/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_2926":59658,"_25561":59653,"_5":25882,"_17855":99785,"_24230":99786,"_2452":99787},[],"/docs/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_2926":59659,"_25561":59653,"_5":25882,"_17855":99789,"_24230":99790,"_2452":99791},[],"/docs/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_2926":59660,"_25561":59653,"_5":25882,"_17855":99793,"_24230":99794,"_2452":99795},[],"/docs/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_2926":59661,"_25561":59653,"_5":25882,"_17855":99797,"_24230":99798,"_2452":99799},[],"/docs/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_2926":59662,"_25561":59653,"_5":25882,"_17855":99801,"_24230":99802,"_2452":99803},[],"/docs/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_2926":59663,"_25561":59653,"_5":25882,"_17855":99805,"_24230":99806,"_2452":99807},[],"/docs/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_2926":59664,"_25561":59653,"_5":25882,"_17855":99809,"_24230":99810,"_2452":99811},[],"/docs/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_2926":59665,"_25561":59653,"_17855":99813,"_5":17750,"_24230":59653,"_2452":99814},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_2926":59666,"_25561":59653,"_17855":99816,"_5":17750,"_24230":99774,"_2452":99817},[],"Un servicio publica un evento de dominio.",{"_2926":59667,"_25561":59653,"_17855":99819,"_5":17750,"_24230":99774,"_2452":99820},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_2926":59668,"_25561":59653,"_17855":99822,"_5":17750,"_24230":99774,"_2452":99823},[],"El filtro de cada suscripción decide si debe notificarse.",{"_2926":59669,"_25561":59653,"_17855":99825,"_5":17750,"_24230":99774,"_2452":99826},[],"Lamassu entrega el evento al canal configurado.",{"_2926":59670,"_25561":59653,"_17855":99828,"_5":17750,"_24230":99774,"_2452":99829},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_2926":59671,"_25561":59653,"_17855":99831,"_5":17750,"_24230":99778,"_2452":99832},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_2926":59672,"_25561":59653,"_17855":99834,"_5":17750,"_24230":99778,"_2452":99835},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_2926":59673,"_25561":59653,"_17855":99837,"_5":17750,"_24230":99778,"_2452":99838},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_2926":59674,"_25561":59653,"_17855":99840,"_5":17750,"_24230":99778,"_2452":99841},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_2926":59675,"_25561":59653,"_17855":99843,"_5":17750,"_24230":99778,"_2452":99844},[],"`apikey_options` necesita `header` y `key`.",{"_2926":59676,"_25561":59653,"_17855":99846,"_5":17750,"_24230":99778,"_2452":99847},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_2926":59677,"_25561":59653,"_17855":99849,"_5":17750,"_24230":99778,"_2452":99850},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_2926":59678,"_25561":59653,"_17855":99852,"_5":17750,"_24230":99778,"_2452":99853},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_2926":59679,"_25561":59653,"_17855":99855,"_5":17750,"_24230":99786,"_2452":99856},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_2926":59680,"_25561":59653,"_17855":99858,"_5":17750,"_24230":99790,"_2452":99859},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_2926":59681,"_25561":59653,"_17855":99861,"_5":17750,"_24230":99794,"_2452":99862},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_2926":59682,"_25561":59653,"_17855":99864,"_5":17750,"_24230":99794,"_2452":99865},[],"**None** notifica todas las instancias del evento.",{"_2926":59683,"_25561":59653,"_17855":99867,"_5":17750,"_24230":99794,"_2452":99868},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_2926":59684,"_25561":59653,"_17855":99870,"_5":17750,"_24230":99794,"_2452":99871},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_2926":59685,"_25561":59653,"_17855":99873,"_5":17750,"_24230":99794,"_2452":99874},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_2926":59686,"_25561":59653,"_17855":99876,"_5":17750,"_24230":99794,"_2452":99877},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_2926":59687,"_25561":59653,"_17855":99879,"_5":17750,"_24230":99798,"_2452":99880},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_2926":59688,"_25561":59653,"_17855":99882,"_5":17750,"_24230":99802,"_2452":99883},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_2926":59689,"_25561":59653,"_17855":99885,"_5":17750,"_24230":99802,"_2452":99886},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_2926":59690,"_25561":59653,"_17855":99888,"_5":17750,"_24230":99802,"_2452":99889},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_2926":59691,"_25561":59653,"_17855":99891,"_5":17750,"_24230":99802,"_2452":99892},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_2926":59692,"_25561":59653,"_17855":99894,"_5":17750,"_24230":99802,"_2452":99895},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_2926":59693,"_25561":59653,"_17855":99897,"_5":17750,"_24230":99802,"_2452":99898},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_2926":59694,"_25561":59653,"_17855":99900,"_5":17750,"_24230":99802,"_2452":99901},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_2926":59695,"_25561":59653,"_17855":99903,"_5":17750,"_24230":99802,"_2452":99904},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_2926":59696,"_25561":59653,"_17855":99906,"_5":17750,"_24230":99806,"_2452":99907},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_2926":59697,"_25561":59653,"_17855":99909,"_5":17750,"_24230":99810,"_2452":99910},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_2926":59698,"_25561":59653,"_17855":99912,"_5":17750,"_24230":99810,"_2452":99913},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_2926":59699,"_25561":59653,"_17855":99915,"_5":17750,"_24230":99810,"_2452":99916},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_2926":59700,"_25561":59653,"_17855":99918,"_5":17750,"_24230":99810,"_2452":99919},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_2926":59701,"_25561":59653,"_17855":99921,"_5":17750,"_24230":99810,"_2452":99922},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_2926":59702,"_25561":59653,"_17855":99924,"_5":17750,"_24230":99810,"_2452":99925},[],"**Validación:** `va.role.crl.create`.",{"_2926":59703,"_25561":59653,"_17855":99927,"_5":17750,"_24230":99810,"_2452":99928},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_2926":59704,"_25561":59653,"_17855":99930,"_5":17750,"_24230":99810,"_2452":99931},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_2926":59705,"_25561":59705,"_5":12525,"_2452":99933,"_25885":99934,"_17855":99935,"_24230":59705},"Registros de auditoría",[41651,99234,99235],[],{"_2926":59706,"_25561":59705,"_17855":99937,"_5":17750,"_24230":59705,"_2452":99938},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_2926":59707,"_25561":59705,"_5":25882,"_17855":99940,"_24230":99941,"_2452":99942},[],"/docs/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_2926":59708,"_25561":59705,"_5":25882,"_17855":99944,"_24230":99945,"_2452":99946},[],"/docs/es/platform/administration/audit-logs#cobertura","Cobertura",{"_2926":59709,"_25561":59705,"_5":25882,"_17855":99948,"_24230":99949,"_2452":99950},[],"/docs/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_2926":59710,"_25561":59705,"_5":25882,"_17855":99952,"_24230":99953,"_2452":99954},[],"/docs/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_2926":59711,"_25561":59705,"_5":25882,"_17855":99956,"_24230":99957,"_2452":99958},[],"/docs/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_2926":59712,"_25561":59705,"_5":25882,"_17855":99960,"_24230":99961,"_2452":99962},[],"/docs/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_2926":59713,"_25561":59705,"_5":25882,"_17855":99964,"_24230":99965,"_2452":99966},[],"/docs/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_2926":59714,"_25561":59705,"_5":25882,"_17855":99968,"_24230":99969,"_2452":99970},[],"/docs/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_2926":59715,"_25561":59705,"_5":25882,"_17855":99972,"_24230":99973,"_2452":99974},[],"/docs/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_2926":59716,"_25561":59705,"_5":25882,"_17855":99976,"_24230":99977,"_2452":99978},[],"/docs/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_2926":59717,"_25561":59705,"_5":25882,"_17855":99980,"_24230":99981,"_2452":99982},[],"/docs/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_2926":59718,"_25561":59705,"_17855":99984,"_5":17750,"_24230":59705,"_2452":99985},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_2926":59719,"_25561":59705,"_17855":99987,"_5":17750,"_24230":99941,"_2452":99988},[],"El cuerpo de auditoría incluye:",{"_2926":59720,"_25561":59705,"_17855":99990,"_5":17750,"_24230":99941,"_2452":99991},[],"input: datos recibidos por la operación;",{"_2926":59721,"_25561":59705,"_17855":99993,"_5":17750,"_24230":99941,"_2452":99994},[],"has\\_error: indica si el servicio devolvió un error;",{"_2926":59722,"_25561":59705,"_17855":99996,"_5":17750,"_24230":99941,"_2452":99997},[],"output: resultado producido o mensaje de error;",{"_2926":59723,"_25561":59705,"_17855":99999,"_5":17750,"_24230":99941,"_2452":100000},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_2926":59724,"_25561":59705,"_17855":100002,"_5":17750,"_24230":99941,"_2452":100003},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_2926":59725,"_25561":59705,"_17855":100005,"_5":17750,"_24230":99941,"_2452":100006},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_2926":59726,"_25561":59705,"_17855":100008,"_5":17750,"_24230":99945,"_2452":100009},[],"El backend aplica auditoría a mutaciones de:",{"_2926":59727,"_25561":59705,"_17855":100011,"_5":17750,"_24230":99945,"_2452":100012},[],"autoridades, certificados y perfiles de emisión;",{"_2926":59728,"_25561":59705,"_17855":100014,"_5":17750,"_24230":99945,"_2452":100015},[],"claves y motores KMS;",{"_2926":59729,"_25561":59705,"_17855":100017,"_5":17750,"_24230":99945,"_2452":100018},[],"dispositivos e identidades;",{"_2926":59730,"_25561":59705,"_17855":100020,"_5":17750,"_24230":99945,"_2452":100021},[],"DMS y operaciones de enrolamiento;",{"_2926":59731,"_25561":59705,"_17855":100023,"_5":17750,"_24230":99945,"_2452":100024},[],"funciones de validación y CRL;",{"_2926":59732,"_25561":59705,"_17855":100026,"_5":17750,"_24230":99945,"_2452":100027},[],"principales, políticas y concesiones de autorización.",{"_2926":59733,"_25561":59705,"_17855":100029,"_5":17750,"_24230":99945,"_2452":100030},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_2926":59734,"_25561":59705,"_17855":100032,"_5":17750,"_24230":99949,"_2452":100033},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_2926":59735,"_25561":59705,"_17855":100035,"_5":17750,"_24230":99949,"_2452":100036},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_2926":59736,"_25561":59705,"_17855":100038,"_5":17750,"_24230":99949,"_2452":100039},[],"Diseña el consumidor para:",{"_2926":59737,"_25561":59705,"_17855":100041,"_5":17750,"_24230":99949,"_2452":100042},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_2926":59738,"_25561":59705,"_17855":100044,"_5":17750,"_24230":99949,"_2452":100045},[],"conservar el CloudEvent completo sin modificar;",{"_2926":59739,"_25561":59705,"_17855":100047,"_5":17750,"_24230":99949,"_2452":100048},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_2926":59740,"_25561":59705,"_17855":100050,"_5":17750,"_24230":99949,"_2452":100051},[],"cifrar en tránsito y en reposo;",{"_2926":59741,"_25561":59705,"_17855":100053,"_5":17750,"_24230":99949,"_2452":100054},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_2926":59742,"_25561":59705,"_17855":100056,"_5":17750,"_24230":99949,"_2452":100057},[],"aplicar una política explícita de retención y legal hold;",{"_2926":59743,"_25561":59705,"_17855":100059,"_5":17750,"_24230":99949,"_2452":100060},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_2926":59744,"_25561":59705,"_17855":100062,"_5":17750,"_24230":99953,"_2452":100063},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_2926":59745,"_25561":59705,"_17855":100065,"_5":17750,"_24230":99953,"_2452":100066},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_2926":59746,"_25561":59705,"_17855":100068,"_5":17750,"_24230":99961,"_2452":100069},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_2926":59747,"_25561":59705,"_17855":100071,"_5":17750,"_24230":99965,"_2452":100072},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_2926":59748,"_25561":59705,"_17855":100074,"_5":17750,"_24230":99969,"_2452":100075},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_2926":59749,"_25561":59705,"_17855":100077,"_5":17750,"_24230":99973,"_2452":100078},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_2926":59750,"_25561":59705,"_17855":100080,"_5":17750,"_24230":99977,"_2452":100081},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_2926":59751,"_25561":59705,"_17855":100083,"_5":17750,"_24230":99981,"_2452":100084},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_2926":59752,"_25561":59705,"_17855":100086,"_5":17750,"_24230":99981,"_2452":100087},[],"aparece un evento de auditoría correcto;",{"_2926":59753,"_25561":59705,"_17855":100089,"_5":17750,"_24230":99981,"_2452":100090},[],"el principal coincide con la identidad utilizada;",{"_2926":59754,"_25561":59705,"_17855":100092,"_5":17750,"_24230":99981,"_2452":100093},[],"el consumidor lo persiste una sola vez;",{"_2926":59755,"_25561":59705,"_17855":100095,"_5":17750,"_24230":99981,"_2452":100096},[],"puede recuperarse por recurso, actor y periodo;",{"_2926":59756,"_25561":59705,"_17855":100098,"_5":17750,"_24230":99981,"_2452":100099},[],"una interrupción del consumidor produce una alerta.",{"_2926":59757,"_25561":59705,"_17855":100101,"_5":17750,"_24230":99981,"_2452":100102},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_2926":59758,"_25561":59758,"_5":12525,"_2452":100104,"_25885":100105,"_17855":100106,"_24230":59758},"Arquitectura de la plataforma",[41651,99234],[],{"_2926":59759,"_25561":59758,"_17855":100108,"_5":17750,"_24230":59758,"_2452":100109},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_2926":59760,"_25561":59758,"_5":25882,"_17855":100111,"_24230":100112,"_2452":100113},[],"/docs/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_2926":59761,"_25561":59758,"_5":25882,"_17855":100115,"_24230":100116,"_2452":100117},[],"/docs/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_2926":59762,"_25561":59758,"_5":25882,"_17855":100119,"_24230":100120,"_2452":100121},[],"/docs/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_2926":59763,"_25561":59758,"_5":25882,"_17855":100123,"_24230":100124,"_2452":100125},[],"/docs/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_2926":59764,"_25561":59758,"_5":25882,"_17855":100127,"_24230":100128,"_2452":100129},[],"/docs/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_2926":59765,"_25561":59758,"_17855":100131,"_5":17750,"_24230":59758,"_2452":100132},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_2926":59766,"_25561":59758,"_17855":100134,"_5":17750,"_24230":59758,"_2452":100135},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_2926":59767,"_25561":59758,"_17855":100137,"_5":17750,"_24230":100112,"_2452":100138},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_2926":59768,"_25561":59758,"_17855":100140,"_5":17750,"_24230":100116,"_2452":100141},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_2926":59769,"_25561":59758,"_17855":100143,"_5":17750,"_24230":100120,"_2452":100144},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_2926":59770,"_25561":59758,"_17855":100146,"_5":17750,"_24230":100124,"_2452":100147},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_2926":59771,"_25561":59758,"_17855":100149,"_5":17750,"_24230":100128,"_2452":100150},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_2926":59772,"_25561":59772,"_5":12525,"_2452":100152,"_25885":100153,"_17855":100154,"_24230":59772},"Cómo funciona Lamassu",[41651,99234],[],{"_2926":59773,"_25561":59772,"_17855":100156,"_5":17750,"_24230":59772,"_2452":100157},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_2926":59774,"_25561":59772,"_5":25882,"_17855":100159,"_24230":100160,"_2452":100161},[],"/docs/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_2926":59775,"_25561":59772,"_5":25882,"_17855":100163,"_24230":100164,"_2452":100165},[],"/docs/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_2926":59776,"_25561":59772,"_17855":100167,"_5":17750,"_24230":59772,"_2452":100168},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_2926":59777,"_25561":59772,"_17855":100170,"_5":17750,"_24230":100160,"_2452":100171},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_2926":59778,"_25561":59772,"_17855":100173,"_5":17750,"_24230":100160,"_2452":100174},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_2926":59779,"_25561":59772,"_17855":100176,"_5":17750,"_24230":100160,"_2452":100177},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_2926":59780,"_25561":59772,"_17855":100179,"_5":17750,"_24230":100160,"_2452":100180},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_2926":59781,"_25561":59772,"_17855":100182,"_5":17750,"_24230":100160,"_2452":100183},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_2926":59782,"_25561":59772,"_17855":100185,"_5":17750,"_24230":100164,"_2452":100186},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_2926":59783,"_25561":59772,"_17855":100188,"_5":17750,"_24230":100164,"_2452":100189},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_2926":59784,"_25561":59772,"_17855":100191,"_5":17750,"_24230":100164,"_2452":100192},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_2926":59785,"_25561":59772,"_17855":100194,"_5":17750,"_24230":100164,"_2452":100195},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_2926":59786,"_25561":59772,"_17855":100197,"_5":17750,"_24230":100164,"_2452":100198},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_2926":59787,"_25561":59772,"_17855":100200,"_5":17750,"_24230":100164,"_2452":100201},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_2926":59788,"_25561":59772,"_17855":100203,"_5":17750,"_24230":100164,"_2452":100204},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2926":59789,"_25561":59789,"_5":12525,"_2452":100206,"_25885":100207,"_17855":100208,"_24230":59789},"Dispositivos e identidades",[41651,99234,43969,100206],[],{"_2926":59790,"_25561":59789,"_17855":100210,"_5":17750,"_24230":59789,"_2452":100211},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_2926":59791,"_25561":59789,"_5":25882,"_17855":100213,"_24230":100214,"_2452":100215},[],"/docs/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_2926":59792,"_25561":59789,"_5":25882,"_17855":100217,"_24230":100218,"_2452":100219},[],"/docs/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_2926":59793,"_25561":59789,"_5":25882,"_17855":100221,"_24230":100222,"_2452":100223},[],"/docs/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_2926":59794,"_25561":59789,"_5":25882,"_17855":100225,"_24230":100226,"_2452":100227},[],"/docs/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_2926":59795,"_25561":59789,"_5":25882,"_17855":100229,"_24230":100230,"_2452":100231},[],"/docs/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_2926":59796,"_25561":59789,"_5":25882,"_17855":100233,"_24230":100234,"_2452":100235},[],"/docs/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_2926":59797,"_25561":59789,"_5":25882,"_17855":100237,"_24230":100238,"_2452":100239},[],"/docs/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_2926":59798,"_25561":59789,"_5":25882,"_17855":100241,"_24230":100242,"_2452":100243},[],"/docs/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_2926":59799,"_25561":59789,"_5":25882,"_17855":100245,"_24230":100246,"_2452":100247},[],"/docs/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_2926":59800,"_25561":59789,"_5":25882,"_17855":100249,"_24230":100250,"_2452":100251},[],"/docs/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_2926":59801,"_25561":59789,"_5":25882,"_17855":100253,"_24230":100254,"_2452":100255},[],"/docs/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_2926":59802,"_25561":59789,"_17855":100257,"_5":17750,"_24230":59789,"_2452":100258},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_2926":59803,"_25561":59789,"_17855":100260,"_5":17750,"_24230":59789,"_2452":100261},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_2926":59804,"_25561":59789,"_17855":100263,"_5":17750,"_24230":100214,"_2452":100264},[],"Vista operativa",{"_2926":59805,"_25561":59789,"_17855":100266,"_5":17750,"_24230":100214,"_2452":100267},[],"Interpretación",{"_2926":59806,"_25561":59789,"_17855":100269,"_5":17750,"_24230":100214,"_2452":44032},[],{"_2926":59807,"_25561":59789,"_17855":100271,"_5":17750,"_24230":100214,"_2452":100272},[],"Hay registro, pero todavía no hay identidad asociada.",{"_2926":59808,"_25561":59789,"_17855":100274,"_5":17750,"_24230":100214,"_2452":44038},[],{"_2926":59809,"_25561":59789,"_17855":100276,"_5":17750,"_24230":100214,"_2452":100277},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_2926":59810,"_25561":59789,"_17855":100279,"_5":17750,"_24230":100214,"_2452":44044},[],{"_2926":59811,"_25561":59789,"_17855":100281,"_5":17750,"_24230":100214,"_2452":100282},[],"La identidad está en la ventana operativa de renovación.",{"_2926":59812,"_25561":59789,"_17855":100284,"_5":17750,"_24230":100214,"_2452":44050},[],{"_2926":59813,"_25561":59789,"_17855":100286,"_5":17750,"_24230":100214,"_2452":100287},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_2926":59814,"_25561":59789,"_17855":100289,"_5":17750,"_24230":100214,"_2452":44056},[],{"_2926":59815,"_25561":59789,"_17855":100291,"_5":17750,"_24230":100214,"_2452":100292},[],"La identidad ha vencido.",{"_2926":59816,"_25561":59789,"_17855":100294,"_5":17750,"_24230":100214,"_2452":44062},[],{"_2926":59817,"_25561":59789,"_17855":100296,"_5":17750,"_24230":100214,"_2452":100297},[],"La identidad está marcada como revocada.",{"_2926":59818,"_25561":59789,"_17855":100299,"_5":17750,"_24230":100214,"_2452":44068},[],{"_2926":59819,"_25561":59789,"_17855":100301,"_5":17750,"_24230":100214,"_2452":100302},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_2926":59820,"_25561":59789,"_17855":100304,"_5":17750,"_24230":100214,"_2452":100305},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_2926":59821,"_25561":59789,"_17855":100307,"_5":17750,"_24230":100218,"_2452":100308},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_2926":59822,"_25561":59789,"_17855":100310,"_5":17750,"_24230":100218,"_2452":100311},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_2926":59823,"_25561":59789,"_17855":100313,"_5":17750,"_24230":100218,"_2452":100314},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_2926":59824,"_25561":59789,"_17855":100316,"_5":17750,"_24230":100218,"_2452":100317},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_2926":59825,"_25561":59789,"_17855":100319,"_5":17750,"_24230":100222,"_2452":100320},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_2926":59826,"_25561":59789,"_17855":100322,"_5":17750,"_24230":100226,"_2452":100323},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_2926":59827,"_25561":59789,"_17855":100325,"_5":17750,"_24230":100230,"_2452":100326},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_2926":59828,"_25561":59789,"_17855":100328,"_5":17750,"_24230":100234,"_2452":100329},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_2926":59829,"_25561":59789,"_17855":100331,"_5":17750,"_24230":100238,"_2452":100332},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_2926":59830,"_25561":59789,"_17855":100334,"_5":17750,"_24230":100238,"_2452":100335},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_2926":59831,"_25561":59789,"_17855":100337,"_5":17750,"_24230":100242,"_2452":100338},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_2926":59832,"_25561":59789,"_17855":100340,"_5":17750,"_24230":100242,"_2452":100341},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_2926":59833,"_25561":59789,"_17855":100343,"_5":17750,"_24230":100242,"_2452":100344},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_2926":59834,"_25561":59789,"_17855":100346,"_5":17750,"_24230":100242,"_2452":100347},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_2926":59835,"_25561":59789,"_17855":100349,"_5":17750,"_24230":100242,"_2452":100350},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_2926":59836,"_25561":59789,"_17855":100352,"_5":17750,"_24230":100242,"_2452":100353},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_2926":59837,"_25561":59789,"_17855":100355,"_5":17750,"_24230":100246,"_2452":100356},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_2926":59838,"_25561":59789,"_17855":100358,"_5":17750,"_24230":100246,"_2452":100359},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_2926":59839,"_25561":59789,"_17855":100361,"_5":17750,"_24230":100250,"_2452":100362},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_2926":59840,"_25561":59789,"_17855":100364,"_5":17750,"_24230":100250,"_2452":100365},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_2926":59841,"_25561":59789,"_17855":100367,"_5":17750,"_24230":100250,"_2452":100368},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_2926":59842,"_25561":59789,"_17855":100370,"_5":17750,"_24230":100250,"_2452":100371},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_2926":59843,"_25561":59789,"_17855":100373,"_5":17750,"_24230":100254,"_2452":100374},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2926":59844,"_25561":59789,"_17855":100376,"_5":17750,"_24230":100254,"_2452":100377},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2926":59845,"_25561":59845,"_5":12525,"_2452":100379,"_25885":100380,"_17855":100382,"_24230":59845},"Identidad inicial y autenticación",[41651,99234,43969,100206,100381],"Enrolamiento con PKI",[],{"_2926":59846,"_25561":59845,"_17855":100384,"_5":17750,"_24230":59845,"_2452":100385},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_2926":59847,"_25561":59845,"_5":25882,"_17855":100387,"_24230":100388,"_2452":100389},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_2926":59848,"_25561":59845,"_5":25882,"_17855":100391,"_24230":100392,"_2452":100393},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_2926":59849,"_25561":59845,"_5":25882,"_17855":100395,"_24230":100396,"_2452":100397},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_2926":59850,"_25561":59845,"_5":25882,"_17855":100399,"_24230":100400,"_2452":100401},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_2926":59851,"_25561":59845,"_5":25882,"_17855":100403,"_24230":100404,"_2452":100405},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_2926":59852,"_25561":59845,"_17855":100407,"_5":17750,"_24230":59845,"_2452":100408},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_2926":59853,"_25561":59845,"_17855":100410,"_5":17750,"_24230":100388,"_2452":100411},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_2926":59854,"_25561":59845,"_17855":100413,"_5":17750,"_24230":100388,"_2452":100414},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_2926":59855,"_25561":59845,"_17855":100416,"_5":17750,"_24230":100392,"_2452":100417},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_2926":59856,"_25561":59845,"_17855":100419,"_5":17750,"_24230":100392,"_2452":100420},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_2926":59857,"_25561":59845,"_17855":100422,"_5":17750,"_24230":100392,"_2452":100423},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_2926":59858,"_25561":59845,"_17855":100425,"_5":17750,"_24230":100396,"_2452":100426},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_2926":59859,"_25561":59845,"_17855":100428,"_5":17750,"_24230":100396,"_2452":100429},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_2926":59860,"_25561":59845,"_17855":100431,"_5":17750,"_24230":100400,"_2452":100432},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_2926":59861,"_25561":59845,"_17855":100434,"_5":17750,"_24230":100400,"_2452":100435},[],"Ejemplo de cuerpo:",{"_2926":59862,"_25561":59845,"_17855":100437,"_5":17750,"_24230":100400,"_2452":100438},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_2926":59863,"_25561":59845,"_17855":100440,"_5":17750,"_24230":100400,"_2452":100441},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_2926":59864,"_25561":59845,"_17855":100443,"_5":17750,"_24230":100400,"_2452":100444},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_2926":59865,"_25561":59845,"_17855":100446,"_5":17750,"_24230":100400,"_2452":100447},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_2926":59866,"_25561":59845,"_17855":100449,"_5":17750,"_24230":100404,"_2452":100450},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_2926":59867,"_25561":59845,"_17855":100452,"_5":17750,"_24230":100404,"_2452":100453},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_2926":59868,"_25561":59868,"_5":12525,"_2452":100455,"_25885":100456,"_17855":100457,"_24230":59868},"Configura y opera el DMS",[41651,99234,43969,100206,100381],[],{"_2926":59869,"_25561":59868,"_17855":100459,"_5":17750,"_24230":59868,"_2452":100460},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_2926":59870,"_25561":59868,"_5":25882,"_17855":100462,"_24230":100463,"_2452":97935},[],"/docs/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_2926":59871,"_25561":59868,"_5":25882,"_17855":100465,"_24230":100466,"_2452":100467},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_2926":59872,"_25561":59868,"_5":25882,"_17855":100469,"_24230":100470,"_2452":100471},[],"/docs/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_2926":59873,"_25561":59868,"_5":25882,"_17855":100473,"_24230":100474,"_2452":100475},[],"/docs/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_2926":59874,"_25561":59868,"_5":25882,"_17855":100477,"_24230":100478,"_2452":100479},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_2926":59875,"_25561":59868,"_5":25882,"_17855":100481,"_24230":100482,"_2452":100483},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_2926":59876,"_25561":59868,"_5":25882,"_17855":100485,"_24230":100486,"_2452":100487},[],"/docs/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_2926":59877,"_25561":59868,"_5":25882,"_17855":100489,"_24230":100490,"_2452":100491},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_2926":59878,"_25561":59868,"_5":25882,"_17855":100493,"_24230":100494,"_2452":44264},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_2926":59879,"_25561":59868,"_5":25882,"_17855":100496,"_24230":100497,"_2452":44268},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_2926":59880,"_25561":59868,"_5":25882,"_17855":100499,"_24230":100500,"_2452":100501},[],"/docs/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_2926":59881,"_25561":59868,"_5":25882,"_17855":100503,"_24230":100504,"_2452":100505},[],"/docs/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_2926":59882,"_25561":59868,"_5":25882,"_17855":100507,"_24230":100508,"_2452":100509},[],"/docs/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_2926":59883,"_25561":59868,"_5":25882,"_17855":100511,"_24230":100512,"_2452":100513},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_2926":59884,"_25561":59868,"_5":25882,"_17855":100515,"_24230":100516,"_2452":44288},[],"/docs/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_2926":59885,"_25561":59868,"_5":25882,"_17855":100518,"_24230":100519,"_2452":100520},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_2926":59886,"_25561":59868,"_5":25882,"_17855":100522,"_24230":100523,"_2452":100524},[],"/docs/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_2926":59887,"_25561":59868,"_5":25882,"_17855":100526,"_24230":100527,"_2452":100528},[],"/docs/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_2926":59888,"_25561":59868,"_17855":100530,"_5":17750,"_24230":59868,"_2452":100531},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_2926":59889,"_25561":59868,"_17855":100533,"_5":17750,"_24230":100463,"_2452":100534},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_2926":59890,"_25561":59868,"_17855":100536,"_5":17750,"_24230":100463,"_2452":100537},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_2926":59891,"_25561":59868,"_17855":100539,"_5":17750,"_24230":100470,"_2452":100540},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_2926":59892,"_25561":59868,"_17855":100542,"_5":17750,"_24230":100474,"_2452":100543},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_2926":59893,"_25561":59868,"_17855":100545,"_5":17750,"_24230":100478,"_2452":100546},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_2926":59894,"_25561":59868,"_17855":100548,"_5":17750,"_24230":100482,"_2452":100549},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_2926":59895,"_25561":59868,"_17855":100551,"_5":17750,"_24230":100486,"_2452":100552},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_2926":59896,"_25561":59868,"_17855":100554,"_5":17750,"_24230":100494,"_2452":100555},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_2926":59897,"_25561":59868,"_17855":100557,"_5":17750,"_24230":100494,"_2452":100558},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_2926":59898,"_25561":59868,"_17855":100560,"_5":17750,"_24230":100497,"_2452":100561},[],"Campo de `settings.enrollment_settings`",{"_2926":59899,"_25561":59868,"_17855":100563,"_5":17750,"_24230":100497,"_2452":100564},[],"Decisión",{"_2926":59900,"_25561":59868,"_17855":100566,"_5":17750,"_24230":100497,"_2452":44339},[],{"_2926":59901,"_25561":59868,"_17855":100568,"_5":17750,"_24230":100497,"_2452":100569},[],"`EST_RFC7030` para estas operaciones.",{"_2926":59902,"_25561":59868,"_17855":100571,"_5":17750,"_24230":100497,"_2452":44345},[],{"_2926":59903,"_25561":59868,"_17855":100573,"_5":17750,"_24230":100497,"_2452":100574},[],"ID de la CA que firmará.",{"_2926":59904,"_25561":59868,"_17855":100576,"_5":17750,"_24230":100497,"_2452":44351},[],{"_2926":59905,"_25561":59868,"_17855":100578,"_5":17750,"_24230":100497,"_2452":100579},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_2926":59906,"_25561":59868,"_17855":100581,"_5":17750,"_24230":100497,"_2452":44357},[],{"_2926":59907,"_25561":59868,"_17855":100583,"_5":17750,"_24230":100497,"_2452":100584},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_2926":59908,"_25561":59868,"_17855":100586,"_5":17750,"_24230":100497,"_2452":44363},[],{"_2926":59909,"_25561":59868,"_17855":100588,"_5":17750,"_24230":100497,"_2452":100589},[],"Uno de los cuatro modos de autenticación.",{"_2926":59910,"_25561":59868,"_17855":100591,"_5":17750,"_24230":100497,"_2452":100592},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_2926":59911,"_25561":59868,"_17855":100594,"_5":17750,"_24230":100500,"_2452":100595},[],"Los bloques son independientes:",{"_2926":59912,"_25561":59868,"_17855":100597,"_5":17750,"_24230":100500,"_2452":100598},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_2926":59913,"_25561":59868,"_17855":100600,"_5":17750,"_24230":100500,"_2452":100601},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_2926":59914,"_25561":59868,"_17855":100603,"_5":17750,"_24230":100500,"_2452":44381},[],{"_2926":59915,"_25561":59868,"_17855":100605,"_5":17750,"_24230":100500,"_2452":100606},[],"Control aplicado en la operación configurada",{"_2926":59916,"_25561":59868,"_17855":100608,"_5":17750,"_24230":100500,"_2452":44387},[],{"_2926":59917,"_25561":59868,"_17855":100610,"_5":17750,"_24230":100500,"_2452":100611},[],"Validación del certificado presentado.",{"_2926":59918,"_25561":59868,"_17855":100613,"_5":17750,"_24230":100500,"_2452":44393},[],{"_2926":59919,"_25561":59868,"_17855":100615,"_5":17750,"_24230":100500,"_2452":100616},[],"Autorización del webhook configurado.",{"_2926":59920,"_25561":59868,"_17855":100618,"_5":17750,"_24230":100500,"_2452":44399},[],{"_2926":59921,"_25561":59868,"_17855":100620,"_5":17750,"_24230":100500,"_2452":100621},[],"Validación del certificado y, después, aprobación del webhook.",{"_2926":59922,"_25561":59868,"_17855":100623,"_5":17750,"_24230":100500,"_2452":44405},[],{"_2926":59923,"_25561":59868,"_17855":100625,"_5":17750,"_24230":100500,"_2452":100626},[],"Sin autenticación del solicitante por el DMS.",{"_2926":59924,"_25561":59868,"_17855":100628,"_5":17750,"_24230":100500,"_2452":100629},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_2926":59925,"_25561":59868,"_17855":100631,"_5":17750,"_24230":100500,"_2452":100632},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_2926":59926,"_25561":59868,"_17855":100634,"_5":17750,"_24230":100500,"_2452":100635},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_2926":59927,"_25561":59868,"_17855":100637,"_5":17750,"_24230":100500,"_2452":100638},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_2926":59928,"_25561":59868,"_17855":100640,"_5":17750,"_24230":100504,"_2452":100641},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_2926":59929,"_25561":59868,"_17855":100643,"_5":17750,"_24230":100504,"_2452":100644},[],"Campo de `external_webhook_settings`",{"_2926":59930,"_25561":59868,"_17855":100646,"_5":17750,"_24230":100504,"_2452":100564},[],{"_2926":59931,"_25561":59868,"_17855":100648,"_5":17750,"_24230":100504,"_2452":44431},[],{"_2926":59932,"_25561":59868,"_17855":100650,"_5":17750,"_24230":100504,"_2452":100651},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_2926":59933,"_25561":59868,"_17855":100653,"_5":17750,"_24230":100504,"_2452":44437},[],{"_2926":59934,"_25561":59868,"_17855":100655,"_5":17750,"_24230":100504,"_2452":100656},[],"`POST` o `PUT`; `POST` por defecto.",{"_2926":59935,"_25561":59868,"_17855":100658,"_5":17750,"_24230":100504,"_2452":44443},[],{"_2926":59936,"_25561":59868,"_17855":100660,"_5":17750,"_24230":100504,"_2452":100661},[],"Etiqueta usada en los logs del servicio.",{"_2926":59937,"_25561":59868,"_17855":100663,"_5":17750,"_24230":100504,"_2452":44449},[],{"_2926":59938,"_25561":59868,"_17855":100665,"_5":17750,"_24230":100504,"_2452":100666},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_2926":59939,"_25561":59868,"_17855":100668,"_5":17750,"_24230":100504,"_2452":44455},[],{"_2926":59940,"_25561":59868,"_17855":100670,"_5":17750,"_24230":100504,"_2452":100671},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_2926":59941,"_25561":59868,"_17855":100673,"_5":17750,"_24230":100504,"_2452":44461},[],{"_2926":59942,"_25561":59868,"_17855":100675,"_5":17750,"_24230":100504,"_2452":100676},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_2926":59943,"_25561":59868,"_17855":100678,"_5":17750,"_24230":100504,"_2452":44467},[],{"_2926":59944,"_25561":59868,"_17855":100680,"_5":17750,"_24230":100504,"_2452":100681},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_2926":59945,"_25561":59868,"_17855":100683,"_5":17750,"_24230":100504,"_2452":44473},[],{"_2926":59946,"_25561":59868,"_17855":100685,"_5":17750,"_24230":100504,"_2452":100686},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_2926":59947,"_25561":59868,"_17855":100688,"_5":17750,"_24230":100504,"_2452":44479},[],{"_2926":59948,"_25561":59868,"_17855":100690,"_5":17750,"_24230":100504,"_2452":100691},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_2926":59949,"_25561":59868,"_17855":100693,"_5":17750,"_24230":100504,"_2452":100694},[],"Reglas de esa configuración:",{"_2926":59950,"_25561":59868,"_17855":100696,"_5":17750,"_24230":100504,"_2452":100697},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_2926":59951,"_25561":59868,"_17855":100699,"_5":17750,"_24230":100504,"_2452":100700},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_2926":59952,"_25561":59868,"_17855":100702,"_5":17750,"_24230":100504,"_2452":100703},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_2926":59953,"_25561":59868,"_17855":100705,"_5":17750,"_24230":100504,"_2452":100706},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_2926":59954,"_25561":59868,"_17855":100708,"_5":17750,"_24230":100504,"_2452":100709},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_2926":59955,"_25561":59868,"_17855":100711,"_5":17750,"_24230":100504,"_2452":100712},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_2926":59956,"_25561":59868,"_17855":100714,"_5":17750,"_24230":100504,"_2452":100715},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar, y si la consola de tu versión no expone la configuración independiente, utiliza la API DMS.",{"_2926":59957,"_25561":59868,"_17855":100717,"_5":17750,"_24230":100504,"_2452":100718},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_2926":59958,"_25561":59868,"_17855":100720,"_5":17750,"_24230":100504,"_2452":100721},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_2926":59959,"_25561":59868,"_17855":100723,"_5":17750,"_24230":100508,"_2452":100724},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_2926":59960,"_25561":59868,"_17855":100726,"_5":17750,"_24230":100512,"_2452":100727},[],"Campo de `settings.reenrollment_settings`",{"_2926":59961,"_25561":59868,"_17855":100729,"_5":17750,"_24230":100512,"_2452":100730},[],"Función",{"_2926":59962,"_25561":59868,"_17855":100732,"_5":17750,"_24230":100512,"_2452":44523},[],{"_2926":59963,"_25561":59868,"_17855":100734,"_5":17750,"_24230":100512,"_2452":100735},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_2926":59964,"_25561":59868,"_17855":100737,"_5":17750,"_24230":100512,"_2452":44529},[],{"_2926":59965,"_25561":59868,"_17855":100739,"_5":17750,"_24230":100512,"_2452":100740},[],"Umbral operativo preventivo de monitorización.",{"_2926":59966,"_25561":59868,"_17855":100742,"_5":17750,"_24230":100512,"_2452":44535},[],{"_2926":59967,"_25561":59868,"_17855":100744,"_5":17750,"_24230":100512,"_2452":100745},[],"Umbral operativo crítico de monitorización.",{"_2926":59968,"_25561":59868,"_17855":100747,"_5":17750,"_24230":100512,"_2452":44541},[],{"_2926":59969,"_25561":59868,"_17855":100749,"_5":17750,"_24230":100512,"_2452":100750},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_2926":59970,"_25561":59868,"_17855":100752,"_5":17750,"_24230":100512,"_2452":44547},[],{"_2926":59971,"_25561":59868,"_17855":100754,"_5":17750,"_24230":100512,"_2452":100755},[],"CAs de validación adicionales para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_2926":59972,"_25561":59868,"_17855":100757,"_5":17750,"_24230":100512,"_2452":44553},[],{"_2926":59973,"_25561":59868,"_17855":100759,"_5":17750,"_24230":100512,"_2452":100760},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_2926":59974,"_25561":59868,"_17855":100762,"_5":17750,"_24230":100512,"_2452":100763},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_2926":59975,"_25561":59868,"_17855":100765,"_5":17750,"_24230":100516,"_2452":100766},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. Algoritmo y tamaño proceden de su campo `key`; el perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_2926":59976,"_25561":59868,"_17855":100768,"_5":17750,"_24230":100519,"_2452":98292},[],{"_2926":59977,"_25561":59868,"_17855":100770,"_5":17750,"_24230":100519,"_2452":100771},[],"Qué publica",{"_2926":59978,"_25561":59868,"_17855":100773,"_5":17750,"_24230":100519,"_2452":44570},[],{"_2926":59979,"_25561":59868,"_17855":100775,"_5":17750,"_24230":100519,"_2452":100776},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_2926":59980,"_25561":59868,"_17855":100778,"_5":17750,"_24230":100519,"_2452":44576},[],{"_2926":59981,"_25561":59868,"_17855":100780,"_5":17750,"_24230":100519,"_2452":100781},[],"Certificado de la CA emisora seleccionada.",{"_2926":59982,"_25561":59868,"_17855":100783,"_5":17750,"_24230":100519,"_2452":44582},[],{"_2926":59983,"_25561":59868,"_17855":100785,"_5":17750,"_24230":100519,"_2452":100786},[],"Certificados de las CAs elegidas explícitamente.",{"_2926":59984,"_25561":59868,"_17855":100788,"_5":17750,"_24230":100519,"_2452":100789},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_2926":59985,"_25561":59868,"_17855":100791,"_5":17750,"_24230":100523,"_2452":100792},[],"**Edit** cambia nombre, ajustes y metadatos. La actualización del backend sustituye esos bloques completos; al usar la API, lee el DMS antes de enviar una edición para no perder campos.",{"_2926":59986,"_25561":59868,"_17855":100794,"_5":17750,"_24230":100523,"_2452":100795},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_2926":59987,"_25561":59868,"_17855":100797,"_5":17750,"_24230":100523,"_2452":100798},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_2926":59988,"_25561":59868,"_17855":100800,"_5":17750,"_24230":100527,"_2452":100801},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_2926":59989,"_25561":59989,"_5":12525,"_2452":100803,"_25885":100804,"_17855":100805,"_24230":59989},"Integra el cliente EST",[41651,99234,43969,100206,100381],[],{"_2926":59990,"_25561":59989,"_17855":100807,"_5":17750,"_24230":59989,"_2452":100808},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_2926":59991,"_25561":59989,"_5":25882,"_17855":100810,"_24230":100811,"_2452":97935},[],"/docs/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_2926":59992,"_25561":59989,"_5":25882,"_17855":100813,"_24230":100814,"_2452":100815},[],"/docs/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_2926":59993,"_25561":59989,"_5":25882,"_17855":100817,"_24230":100818,"_2452":100819},[],"/docs/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_2926":59994,"_25561":59989,"_5":25882,"_17855":100821,"_24230":100822,"_2452":100823},[],"/docs/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_2926":59995,"_25561":59989,"_5":25882,"_17855":100825,"_24230":100826,"_2452":100827},[],"/docs/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_2926":59996,"_25561":59989,"_5":25882,"_17855":100829,"_24230":100830,"_2452":100831},[],"/docs/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_2926":59997,"_25561":59989,"_17855":100833,"_5":17750,"_24230":59989,"_2452":100834},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_2926":59998,"_25561":59989,"_17855":100836,"_5":17750,"_24230":100811,"_2452":100837},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_2926":59999,"_25561":59989,"_17855":100839,"_5":17750,"_24230":100811,"_2452":100840},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_2926":60000,"_25561":59989,"_17855":100842,"_5":17750,"_24230":100811,"_2452":100843},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_2926":60001,"_25561":59989,"_17855":100845,"_5":17750,"_24230":100814,"_2452":100846},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_2926":60002,"_25561":59989,"_17855":100848,"_5":17750,"_24230":100814,"_2452":100849},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_2926":60003,"_25561":59989,"_17855":100851,"_5":17750,"_24230":100818,"_2452":100852},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_2926":60004,"_25561":59989,"_17855":100854,"_5":17750,"_24230":100818,"_2452":100855},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_2926":60005,"_25561":59989,"_17855":100857,"_5":17750,"_24230":100822,"_2452":100858},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_2926":60006,"_25561":59989,"_17855":100860,"_5":17750,"_24230":100822,"_2452":100861},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_2926":60007,"_25561":59989,"_17855":100863,"_5":17750,"_24230":100826,"_2452":100864},[],"Para el caso de una raíz que emite directamente:",{"_2926":60008,"_25561":59989,"_17855":100866,"_5":17750,"_24230":100826,"_2452":100867},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_2926":60009,"_25561":59989,"_17855":100869,"_5":17750,"_24230":100826,"_2452":100870},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_2926":60010,"_25561":59989,"_17855":100872,"_5":17750,"_24230":100830,"_2452":100873},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_2926":60011,"_25561":60011,"_5":12525,"_2452":100875,"_25885":100876,"_17855":100877,"_24230":60011},"Referencia EST",[41651,99234,43969,100206,100381],[],{"_2926":60012,"_25561":60011,"_17855":100879,"_5":17750,"_24230":60011,"_2452":100880},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_2926":60013,"_25561":60011,"_5":25882,"_17855":100882,"_24230":100883,"_2452":100884},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_2926":60014,"_25561":60011,"_5":25882,"_17855":100886,"_24230":100887,"_2452":19404},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2926":60015,"_25561":60011,"_5":25882,"_17855":100889,"_24230":100890,"_2452":22211},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2926":60016,"_25561":60011,"_5":25882,"_17855":100892,"_24230":100893,"_2452":22218},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2926":60017,"_25561":60011,"_5":25882,"_17855":100895,"_24230":100896,"_2452":21577},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2926":60018,"_25561":60011,"_5":25882,"_17855":100898,"_24230":100899,"_2452":100900},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_2926":60019,"_25561":60011,"_5":25882,"_17855":100902,"_24230":100903,"_2452":100904},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_2926":60020,"_25561":60011,"_5":25882,"_17855":100906,"_24230":100907,"_2452":100908},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_2926":60021,"_25561":60011,"_17855":100910,"_5":17750,"_24230":60011,"_2452":100911},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_2926":60022,"_25561":60011,"_17855":100913,"_5":17750,"_24230":100883,"_2452":100914},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_2926":60023,"_25561":60011,"_17855":100916,"_5":17750,"_24230":100883,"_2452":99025},[],{"_2926":60024,"_25561":60011,"_17855":100918,"_5":17750,"_24230":100883,"_2452":100919},[],"Método",{"_2926":60025,"_25561":60011,"_17855":100921,"_5":17750,"_24230":100883,"_2452":100922},[],"Autenticación y condición",{"_2926":60026,"_25561":60011,"_17855":100924,"_5":17750,"_24230":100883,"_2452":44725},[],{"_2926":60027,"_25561":60011,"_17855":100926,"_5":17750,"_24230":100883,"_2452":44728},[],{"_2926":60028,"_25561":60011,"_17855":100928,"_5":17750,"_24230":100883,"_2452":100929},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_2926":60029,"_25561":60011,"_17855":100931,"_5":17750,"_24230":100883,"_2452":44734},[],{"_2926":60030,"_25561":60011,"_17855":100933,"_5":17750,"_24230":100883,"_2452":44737},[],{"_2926":60031,"_25561":60011,"_17855":100935,"_5":17750,"_24230":100883,"_2452":100936},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_2926":60032,"_25561":60011,"_17855":100938,"_5":17750,"_24230":100883,"_2452":44743},[],{"_2926":60033,"_25561":60011,"_17855":100940,"_5":17750,"_24230":100883,"_2452":44737},[],{"_2926":60034,"_25561":60011,"_17855":100942,"_5":17750,"_24230":100883,"_2452":100943},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_2926":60035,"_25561":60011,"_17855":100945,"_5":17750,"_24230":100883,"_2452":44751},[],{"_2926":60036,"_25561":60011,"_17855":100947,"_5":17750,"_24230":100883,"_2452":44737},[],{"_2926":60037,"_25561":60011,"_17855":100949,"_5":17750,"_24230":100883,"_2452":100950},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_2926":60038,"_25561":60011,"_17855":100952,"_5":17750,"_24230":100883,"_2452":100953},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_2926":60039,"_25561":60011,"_17855":100955,"_5":17750,"_24230":100887,"_2452":100956},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_2926":60040,"_25561":60011,"_17855":100958,"_5":17750,"_24230":100887,"_2452":100959},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_2926":60041,"_25561":60011,"_17855":100961,"_5":17750,"_24230":100890,"_2452":100962},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_2926":60042,"_25561":60011,"_17855":100964,"_5":17750,"_24230":100890,"_2452":100965},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_2926":60043,"_25561":60011,"_17855":100967,"_5":17750,"_24230":100893,"_2452":100968},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_2926":60044,"_25561":60011,"_17855":100970,"_5":17750,"_24230":100893,"_2452":100971},[],"La CA de enrolamiento o una CA de validación configurada en el bloque de reenrolamiento valida la credencial en el modo mTLS. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_2926":60045,"_25561":60011,"_17855":100973,"_5":17750,"_24230":100896,"_2452":100974},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_2926":60046,"_25561":60011,"_17855":100976,"_5":17750,"_24230":100896,"_2452":100977},[],"El código admite RSA y ECDSA de 224, 256, 384 o 521 bits. Un tamaño ECDSA no reconocido puede producir fallback a 256; elige explícitamente un tamaño compatible y comprueba la clave resultante. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_2926":60047,"_25561":60011,"_17855":100979,"_5":17750,"_24230":100899,"_2452":100980},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_2926":60048,"_25561":60011,"_17855":100982,"_5":17750,"_24230":100899,"_2452":100983},[],"Parte",{"_2926":60049,"_25561":60011,"_17855":100985,"_5":17750,"_24230":100899,"_2452":100986},[],"Contenido tras decodificar su Base64",{"_2926":60050,"_25561":60011,"_17855":100988,"_5":17750,"_24230":100899,"_2452":44795},[],{"_2926":60051,"_25561":60011,"_17855":100990,"_5":17750,"_24230":100899,"_2452":100991},[],"Clave privada PKCS#8 DER sin cifrar.",{"_2926":60052,"_25561":60011,"_17855":100993,"_5":17750,"_24230":100899,"_2452":44801},[],{"_2926":60053,"_25561":60011,"_17855":100995,"_5":17750,"_24230":100899,"_2452":100996},[],"PKCS#7 DER con el certificado emitido.",{"_2926":60054,"_25561":60011,"_17855":100998,"_5":17750,"_24230":100899,"_2452":100999},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_2926":60055,"_25561":60011,"_17855":101001,"_5":17750,"_24230":100903,"_2452":101002},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_2926":60056,"_25561":60011,"_17855":101004,"_5":17750,"_24230":100903,"_2452":101005},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_2926":60057,"_25561":60011,"_17855":101007,"_5":17750,"_24230":100903,"_2452":101008},[],"Convierte y comprueba el resultado:",{"_2926":60058,"_25561":60011,"_17855":101010,"_5":17750,"_24230":100903,"_2452":101011},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_2926":60059,"_25561":60011,"_17855":101013,"_5":17750,"_24230":100907,"_2452":101014},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_2926":60060,"_25561":60011,"_17855":101016,"_5":17750,"_24230":100907,"_2452":101017},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_2926":60061,"_25561":60061,"_5":12525,"_2452":100381,"_25885":101019,"_17855":101020,"_24230":60061},[41651,99234,43969,100206,100381],[],{"_2926":60062,"_25561":60061,"_17855":101022,"_5":17750,"_24230":60061,"_2452":101023},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_2926":60063,"_25561":60061,"_5":25882,"_17855":101025,"_24230":101026,"_2452":101027},[],"/docs/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_2926":60064,"_25561":60061,"_5":25882,"_17855":101029,"_24230":101030,"_2452":101031},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_2926":60065,"_25561":60061,"_5":25882,"_17855":101033,"_24230":101034,"_2452":101035},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_2926":60066,"_25561":60061,"_5":25882,"_17855":101037,"_24230":101038,"_2452":101039},[],"/docs/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_2926":60067,"_25561":60061,"_17855":101041,"_5":17750,"_24230":60061,"_2452":101042},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_2926":60068,"_25561":60061,"_17855":101044,"_5":17750,"_24230":101026,"_2452":101045},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_2926":60069,"_25561":60061,"_17855":101047,"_5":17750,"_24230":101026,"_2452":101048},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_2926":60070,"_25561":60061,"_17855":101050,"_5":17750,"_24230":101026,"_2452":101051},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_2926":60071,"_25561":60061,"_17855":101053,"_5":17750,"_24230":101026,"_2452":101054},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_2926":60072,"_25561":60061,"_17855":101056,"_5":17750,"_24230":101026,"_2452":101057},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_2926":60073,"_25561":60061,"_17855":101059,"_5":17750,"_24230":101026,"_2452":101060},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_2926":60074,"_25561":60061,"_17855":101062,"_5":17750,"_24230":101030,"_2452":101063},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2926":60075,"_25561":60061,"_17855":101065,"_5":17750,"_24230":101030,"_2452":101066},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2926":60076,"_25561":60061,"_17855":101068,"_5":17750,"_24230":101030,"_2452":101069},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2926":60077,"_25561":60061,"_17855":101071,"_5":17750,"_24230":101030,"_2452":101072},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2926":60078,"_25561":60061,"_17855":101074,"_5":17750,"_24230":101034,"_2452":101075},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2926":60079,"_25561":60061,"_17855":101077,"_5":17750,"_24230":101034,"_2452":101078},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2926":60080,"_25561":60061,"_17855":101080,"_5":17750,"_24230":101034,"_2452":101081},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2926":60081,"_25561":60061,"_17855":101083,"_5":17750,"_24230":101034,"_2452":101084},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2926":60082,"_25561":60061,"_17855":101086,"_5":17750,"_24230":101038,"_2452":101087},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_2926":60083,"_25561":60061,"_17855":101089,"_5":17750,"_24230":101038,"_2452":101090},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_2926":60084,"_25561":60084,"_5":12525,"_2452":101092,"_25885":101093,"_17855":101094,"_24230":60084},"Estrategias de aprovisionamiento",[41651,99234,43969,100206,100381],[],{"_2926":60085,"_25561":60084,"_17855":101096,"_5":17750,"_24230":60084,"_2452":101097},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_2926":60086,"_25561":60084,"_5":25882,"_17855":101099,"_24230":101100,"_2452":101101},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_2926":60087,"_25561":60084,"_5":25882,"_17855":101103,"_24230":101104,"_2452":101105},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_2926":60088,"_25561":60084,"_5":25882,"_17855":101107,"_24230":101108,"_2452":101109},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_2926":60089,"_25561":60084,"_5":25882,"_17855":101111,"_24230":101112,"_2452":101113},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_2926":60090,"_25561":60084,"_5":25882,"_17855":101115,"_24230":101116,"_2452":101117},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_2926":60091,"_25561":60084,"_17855":101119,"_5":17750,"_24230":60084,"_2452":101120},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_2926":60092,"_25561":60084,"_17855":101122,"_5":17750,"_24230":101100,"_2452":101123},[],"Recorrido",{"_2926":60093,"_25561":60084,"_17855":101125,"_5":17750,"_24230":101100,"_2452":101126},[],"Cuándo existe el dispositivo",{"_2926":60094,"_25561":60084,"_17855":101128,"_5":17750,"_24230":101100,"_2452":101129},[],"Qué compruebas",{"_2926":60095,"_25561":60084,"_17855":101131,"_5":17750,"_24230":101100,"_2452":101132},[],"Asignación manual",{"_2926":60096,"_25561":60084,"_17855":101134,"_5":17750,"_24230":101100,"_2452":101135},[],"El operador lo crea antes de asociar un certificado.",{"_2926":60097,"_25561":60084,"_17855":101137,"_5":17750,"_24230":101100,"_2452":101138},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_2926":60098,"_25561":60084,"_17855":101140,"_5":17750,"_24230":101100,"_2452":101141},[],"EST con `JITP`",{"_2926":60099,"_25561":60084,"_17855":101143,"_5":17750,"_24230":101100,"_2452":101144},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_2926":60100,"_25561":60084,"_17855":101146,"_5":17750,"_24230":101100,"_2452":101147},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_2926":60101,"_25561":60084,"_17855":101149,"_5":17750,"_24230":101100,"_2452":101150},[],"EST con `PRE_REGISTRATION`",{"_2926":60102,"_25561":60084,"_17855":101152,"_5":17750,"_24230":101100,"_2452":101153},[],"Debe existir antes de `/simpleenroll`.",{"_2926":60103,"_25561":60084,"_17855":101155,"_5":17750,"_24230":101100,"_2452":101156},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_2926":60104,"_25561":60084,"_17855":101158,"_5":17750,"_24230":101100,"_2452":101159},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_2926":60105,"_25561":60084,"_17855":101161,"_5":17750,"_24230":101100,"_2452":101162},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_2926":60106,"_25561":60084,"_17855":101164,"_5":17750,"_24230":101104,"_2452":101165},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_2926":60107,"_25561":60084,"_17855":101167,"_5":17750,"_24230":101104,"_2452":101168},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_2926":60108,"_25561":60084,"_17855":101170,"_5":17750,"_24230":101104,"_2452":101171},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_2926":60109,"_25561":60084,"_17855":101173,"_5":17750,"_24230":101108,"_2452":101174},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_2926":60110,"_25561":60084,"_17855":101176,"_5":17750,"_24230":101108,"_2452":101177},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_2926":60111,"_25561":60084,"_17855":101179,"_5":17750,"_24230":101108,"_2452":101180},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_2926":60112,"_25561":60084,"_17855":101182,"_5":17750,"_24230":101108,"_2452":101183},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_2926":60113,"_25561":60084,"_17855":101185,"_5":17750,"_24230":101108,"_2452":101186},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_2926":60114,"_25561":60084,"_17855":101188,"_5":17750,"_24230":101108,"_2452":101189},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_2926":60115,"_25561":60084,"_17855":101191,"_5":17750,"_24230":101112,"_2452":98292},[],{"_2926":60116,"_25561":60084,"_17855":101193,"_5":17750,"_24230":101112,"_2452":101194},[],"Material que atraviesa EST",{"_2926":60117,"_25561":60084,"_17855":101196,"_5":17750,"_24230":101112,"_2452":101197},[],"Clave generada por el dispositivo",{"_2926":60118,"_25561":60084,"_17855":101199,"_5":17750,"_24230":101112,"_2452":101200},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_2926":60119,"_25561":60084,"_17855":101202,"_5":17750,"_24230":101112,"_2452":101203},[],"Clave ya disponible en el dispositivo",{"_2926":60120,"_25561":60084,"_17855":101205,"_5":17750,"_24230":101112,"_2452":101206},[],"CSR firmada con la clave existente y certificado nuevo.",{"_2926":60121,"_25561":60084,"_17855":101208,"_5":17750,"_24230":101112,"_2452":44288},[],{"_2926":60122,"_25561":60084,"_17855":101210,"_5":17750,"_24230":101112,"_2452":101211},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_2926":60123,"_25561":60084,"_17855":101213,"_5":17750,"_24230":101112,"_2452":101214},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_2926":60124,"_25561":60084,"_17855":101216,"_5":17750,"_24230":101116,"_2452":101217},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_2926":60125,"_25561":60125,"_5":12525,"_2452":101219,"_25885":101220,"_17855":101221,"_24230":60125},"Renovación y recuperación",[41651,99234,43969,100206,100381],[],{"_2926":60126,"_25561":60125,"_17855":101223,"_5":17750,"_24230":60125,"_2452":101224},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_2926":60127,"_25561":60125,"_5":25882,"_17855":101226,"_24230":101227,"_2452":101228},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_2926":60128,"_25561":60125,"_5":25882,"_17855":101230,"_24230":101231,"_2452":101232},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_2926":60129,"_25561":60125,"_5":25882,"_17855":101234,"_24230":101235,"_2452":101236},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_2926":60130,"_25561":60125,"_5":25882,"_17855":101238,"_24230":101239,"_2452":101240},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_2926":60131,"_25561":60125,"_5":25882,"_17855":101242,"_24230":101243,"_2452":101244},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_2926":60132,"_25561":60125,"_17855":101246,"_5":17750,"_24230":60125,"_2452":101247},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_2926":60133,"_25561":60125,"_17855":101249,"_5":17750,"_24230":101227,"_2452":101250},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_2926":60134,"_25561":60125,"_17855":101252,"_5":17750,"_24230":101227,"_2452":101253},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_2926":60135,"_25561":60125,"_17855":101255,"_5":17750,"_24230":101227,"_2452":101256},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_2926":60136,"_25561":60125,"_17855":101258,"_5":17750,"_24230":101227,"_2452":101259},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_2926":60137,"_25561":60125,"_17855":101261,"_5":17750,"_24230":101231,"_2452":101262},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_2926":60138,"_25561":60125,"_17855":101264,"_5":17750,"_24230":101231,"_2452":101265},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_2926":60139,"_25561":60125,"_17855":101267,"_5":17750,"_24230":101235,"_2452":101268},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_2926":60140,"_25561":60125,"_17855":101270,"_5":17750,"_24230":101235,"_2452":101271},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_2926":60141,"_25561":60125,"_17855":101273,"_5":17750,"_24230":101235,"_2452":101274},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_2926":60142,"_25561":60125,"_17855":101276,"_5":17750,"_24230":101239,"_2452":101277},[],"Situación",{"_2926":60143,"_25561":60125,"_17855":101279,"_5":17750,"_24230":101239,"_2452":101280},[],"Procedimiento",{"_2926":60144,"_25561":60125,"_17855":101282,"_5":17750,"_24230":101239,"_2452":101283},[],"Certificado vigente, fuera de ventana",{"_2926":60145,"_25561":60125,"_17855":101285,"_5":17750,"_24230":101239,"_2452":101286},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_2926":60146,"_25561":60125,"_17855":101288,"_5":17750,"_24230":101239,"_2452":101289},[],"Certificado vencido, clave disponible",{"_2926":60147,"_25561":60125,"_17855":101291,"_5":17750,"_24230":101239,"_2452":101292},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_2926":60148,"_25561":60125,"_17855":101294,"_5":17750,"_24230":101239,"_2452":101295},[],"Renovación por webhook o `NO_AUTH`",{"_2926":60149,"_25561":60125,"_17855":101297,"_5":17750,"_24230":101239,"_2452":101298},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_2926":60150,"_25561":60125,"_17855":101300,"_5":17750,"_24230":101239,"_2452":101301},[],"Clave perdida o inaccesible",{"_2926":60151,"_25561":60125,"_17855":101303,"_5":17750,"_24230":101239,"_2452":101304},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_2926":60152,"_25561":60125,"_17855":101306,"_5":17750,"_24230":101239,"_2452":101307},[],"Identidad actual revocada",{"_2926":60153,"_25561":60125,"_17855":101309,"_5":17750,"_24230":101239,"_2452":101310},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_2926":60154,"_25561":60125,"_17855":101312,"_5":17750,"_24230":101239,"_2452":101313},[],"Dispositivo sin identidad",{"_2926":60155,"_25561":60125,"_17855":101315,"_5":17750,"_24230":101239,"_2452":101316},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_2926":60156,"_25561":60125,"_17855":101318,"_5":17750,"_24230":101239,"_2452":101319},[],"Dispositivo retirado",{"_2926":60157,"_25561":60125,"_17855":101321,"_5":17750,"_24230":101239,"_2452":101322},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_2926":60158,"_25561":60125,"_17855":101324,"_5":17750,"_24230":101239,"_2452":101325},[],"Timeout, HTTP 500 o fallo de instalación",{"_2926":60159,"_25561":60125,"_17855":101327,"_5":17750,"_24230":101239,"_2452":101328},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_2926":60160,"_25561":60125,"_17855":101330,"_5":17750,"_24230":101243,"_2452":101331},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_2926":60161,"_25561":60125,"_17855":101333,"_5":17750,"_24230":101243,"_2452":101334},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_2926":60162,"_25561":60162,"_5":12525,"_2452":101336,"_25885":101337,"_17855":101338,"_24230":60162},"Diagnóstico de enrolamiento",[41651,99234,43969,100206,100381],[],{"_2926":60163,"_25561":60162,"_17855":101340,"_5":17750,"_24230":60162,"_2452":101341},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_2926":60164,"_25561":60162,"_5":25882,"_17855":101343,"_24230":101344,"_2452":101345},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_2926":60165,"_25561":60162,"_5":25882,"_17855":101347,"_24230":101348,"_2452":101349},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_2926":60166,"_25561":60162,"_5":25882,"_17855":101351,"_24230":101352,"_2452":100908},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_2926":60167,"_25561":60162,"_5":25882,"_17855":101354,"_24230":101355,"_2452":101356},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_2926":60168,"_25561":60162,"_17855":101358,"_5":17750,"_24230":60162,"_2452":101359},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_2926":60169,"_25561":60162,"_17855":101361,"_5":17750,"_24230":101348,"_2452":101362},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_2926":60170,"_25561":60162,"_17855":101364,"_5":17750,"_24230":101348,"_2452":101365},[],"Síntoma o mensaje",{"_2926":60171,"_25561":60162,"_17855":101367,"_5":17750,"_24230":101348,"_2452":101368},[],"Qué revisar",{"_2926":60172,"_25561":60162,"_17855":101370,"_5":17750,"_24230":101348,"_2452":101371},[],"curl rechaza TLS, nombre o emisor",{"_2926":60173,"_25561":60162,"_17855":101373,"_5":17750,"_24230":101348,"_2452":101374},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_2926":60174,"_25561":60162,"_17855":101376,"_5":17750,"_24230":101348,"_2452":101377},[],"404 o APS ausente",{"_2926":60175,"_25561":60162,"_17855":101379,"_5":17750,"_24230":101348,"_2452":101380},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_2926":60176,"_25561":60162,"_17855":101382,"_5":17750,"_24230":101348,"_2452":101383},[],"400, error de CSR o formato",{"_2926":60177,"_25561":60162,"_17855":101385,"_5":17750,"_24230":101348,"_2452":101386},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_2926":60178,"_25561":60162,"_17855":101388,"_5":17750,"_24230":101348,"_2452":101389},[],"Credencial ausente o certificado no válido",{"_2926":60179,"_25561":60162,"_17855":101391,"_5":17750,"_24230":101348,"_2452":101392},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_2926":60180,"_25561":60162,"_17855":101394,"_5":17750,"_24230":101348,"_2452":101395},[],"Webhook deniega, expira o responde sin autorización",{"_2926":60181,"_25561":60162,"_17855":101397,"_5":17750,"_24230":101348,"_2452":101398},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_2926":60182,"_25561":60162,"_17855":101400,"_5":17750,"_24230":101348,"_2452":45208},[],{"_2926":60183,"_25561":60162,"_17855":101402,"_5":17750,"_24230":101348,"_2452":101403},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_2926":60184,"_25561":60162,"_17855":101405,"_5":17750,"_24230":101348,"_2452":45214},[],{"_2926":60185,"_25561":60162,"_17855":101407,"_5":17750,"_24230":101348,"_2452":101408},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_2926":60186,"_25561":60162,"_17855":101410,"_5":17750,"_24230":101348,"_2452":45220},[],{"_2926":60187,"_25561":60162,"_17855":101412,"_5":17750,"_24230":101348,"_2452":101413},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_2926":60188,"_25561":60162,"_17855":101415,"_5":17750,"_24230":101348,"_2452":45226},[],{"_2926":60189,"_25561":60162,"_17855":101417,"_5":17750,"_24230":101348,"_2452":101418},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_2926":60190,"_25561":60162,"_17855":101420,"_5":17750,"_24230":101348,"_2452":45232},[],{"_2926":60191,"_25561":60162,"_17855":101422,"_5":17750,"_24230":101348,"_2452":101423},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_2926":60192,"_25561":60162,"_17855":101425,"_5":17750,"_24230":101348,"_2452":101426},[],"400 `struct validation error` al crear o actualizar un DMS",{"_2926":60193,"_25561":60162,"_17855":101428,"_5":17750,"_24230":101348,"_2452":101429},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_2926":60194,"_25561":60162,"_17855":101431,"_5":17750,"_24230":101348,"_2452":101432},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_2926":60195,"_25561":60162,"_17855":101434,"_5":17750,"_24230":101348,"_2452":101435},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_2926":60196,"_25561":60162,"_17855":101437,"_5":17750,"_24230":101348,"_2452":45250},[],{"_2926":60197,"_25561":60162,"_17855":101439,"_5":17750,"_24230":101348,"_2452":101440},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_2926":60198,"_25561":60162,"_17855":101442,"_5":17750,"_24230":101348,"_2452":45256},[],{"_2926":60199,"_25561":60162,"_17855":101444,"_5":17750,"_24230":101348,"_2452":101445},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_2926":60200,"_25561":60162,"_17855":101447,"_5":17750,"_24230":101348,"_2452":101448},[],"DMS propietario distinto",{"_2926":60201,"_25561":60162,"_17855":101450,"_5":17750,"_24230":101348,"_2452":101451},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_2926":60202,"_25561":60162,"_17855":101453,"_5":17750,"_24230":101348,"_2452":45268},[],{"_2926":60203,"_25561":60162,"_17855":101455,"_5":17750,"_24230":101348,"_2452":101456},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_2926":60204,"_25561":60162,"_17855":101458,"_5":17750,"_24230":101348,"_2452":45274},[],{"_2926":60205,"_25561":60162,"_17855":101460,"_5":17750,"_24230":101348,"_2452":101461},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_2926":60206,"_25561":60162,"_17855":101463,"_5":17750,"_24230":101348,"_2452":101464},[],"Certificado actual revocado",{"_2926":60207,"_25561":60162,"_17855":101466,"_5":17750,"_24230":101348,"_2452":101467},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_2926":60208,"_25561":60162,"_17855":101469,"_5":17750,"_24230":101348,"_2452":101470},[],"Error de CA, perfil o firma",{"_2926":60209,"_25561":60162,"_17855":101472,"_5":17750,"_24230":101348,"_2452":101473},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_2926":60210,"_25561":60162,"_17855":101475,"_5":17750,"_24230":101348,"_2452":101476},[],"HTTP 200 sin conexión del dispositivo",{"_2926":60211,"_25561":60162,"_17855":101478,"_5":17750,"_24230":101348,"_2452":101479},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_2926":60212,"_25561":60162,"_17855":101481,"_5":17750,"_24230":101348,"_2452":101482},[],"Timeout o error después de emitir",{"_2926":60213,"_25561":60162,"_17855":101484,"_5":17750,"_24230":101348,"_2452":101485},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_2926":60214,"_25561":60162,"_17855":101487,"_5":17750,"_24230":101352,"_2452":101488},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_2926":60215,"_25561":60162,"_17855":101490,"_5":17750,"_24230":101352,"_2452":101491},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_2926":60216,"_25561":60162,"_17855":101493,"_5":17750,"_24230":101355,"_2452":101494},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_2926":60217,"_25561":60162,"_17855":101496,"_5":17750,"_24230":101355,"_2452":101497},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_2926":60218,"_25561":60162,"_17855":101499,"_5":17750,"_24230":101355,"_2452":101500},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_2926":60219,"_25561":60162,"_17855":101502,"_5":17750,"_24230":101355,"_2452":101503},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_2926":60220,"_25561":60162,"_17855":101505,"_5":17750,"_24230":101355,"_2452":101506},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_2926":60221,"_25561":60162,"_17855":101508,"_5":17750,"_24230":101355,"_2452":101509},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_2926":60222,"_25561":60162,"_17855":101511,"_5":17750,"_24230":101355,"_2452":101512},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_2926":60223,"_25561":60223,"_5":12525,"_2452":101514,"_25885":101515,"_17855":101516,"_24230":60223},"Distribución y actualización de confianza",[41651,99234,43969,100206,100381],[],{"_2926":60224,"_25561":60223,"_17855":101518,"_5":17750,"_24230":60223,"_2452":101519},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_2926":60225,"_25561":60223,"_5":25882,"_17855":101521,"_24230":101522,"_2452":101523},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_2926":60226,"_25561":60223,"_5":25882,"_17855":101525,"_24230":101526,"_2452":101527},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_2926":60227,"_25561":60223,"_5":25882,"_17855":101529,"_24230":101530,"_2452":101531},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_2926":60228,"_25561":60223,"_5":25882,"_17855":101533,"_24230":101534,"_2452":101535},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_2926":60229,"_25561":60223,"_5":25882,"_17855":101537,"_24230":101538,"_2452":101539},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_2926":60230,"_25561":60223,"_17855":101541,"_5":17750,"_24230":60223,"_2452":101542},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_2926":60231,"_25561":60223,"_17855":101544,"_5":17750,"_24230":101522,"_2452":101545},[],"Relación",{"_2926":60232,"_25561":60223,"_17855":101547,"_5":17750,"_24230":101522,"_2452":101548},[],"Material que prepara el responsable",{"_2926":60233,"_25561":60223,"_17855":101550,"_5":17750,"_24230":101522,"_2452":101551},[],"Dispositivo → servidor EST",{"_2926":60234,"_25561":60223,"_17855":101553,"_5":17750,"_24230":101522,"_2452":101554},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_2926":60235,"_25561":60223,"_17855":101556,"_5":17750,"_24230":101522,"_2452":101557},[],"DMS → solicitante",{"_2926":60236,"_25561":60223,"_17855":101559,"_5":17750,"_24230":101522,"_2452":101560},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_2926":60237,"_25561":60223,"_17855":101562,"_5":17750,"_24230":101522,"_2452":101563},[],"Consumidor → dispositivo",{"_2926":60238,"_25561":60223,"_17855":101565,"_5":17750,"_24230":101522,"_2452":101566},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_2926":60239,"_25561":60223,"_17855":101568,"_5":17750,"_24230":101522,"_2452":101569},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_2926":60240,"_25561":60223,"_17855":101571,"_5":17750,"_24230":101526,"_2452":101572},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_2926":60241,"_25561":60223,"_17855":101574,"_5":17750,"_24230":101526,"_2452":101575},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_2926":60242,"_25561":60223,"_17855":101577,"_5":17750,"_24230":101530,"_2452":101578},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_2926":60243,"_25561":60223,"_17855":101580,"_5":17750,"_24230":101530,"_2452":101581},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_2926":60244,"_25561":60223,"_17855":101583,"_5":17750,"_24230":101530,"_2452":101584},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_2926":60245,"_25561":60223,"_17855":101586,"_5":17750,"_24230":101530,"_2452":101587},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_2926":60246,"_25561":60223,"_17855":101589,"_5":17750,"_24230":101530,"_2452":101590},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_2926":60247,"_25561":60223,"_17855":101592,"_5":17750,"_24230":101530,"_2452":101593},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_2926":60248,"_25561":60223,"_17855":101595,"_5":17750,"_24230":101534,"_2452":101596},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_2926":60249,"_25561":60223,"_17855":101598,"_5":17750,"_24230":101534,"_2452":101599},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Al cambiar la CA de enrolamiento, añade a esa lista la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_2926":60250,"_25561":60223,"_17855":101601,"_5":17750,"_24230":101534,"_2452":101602},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_2926":60251,"_25561":60223,"_17855":101604,"_5":17750,"_24230":101538,"_2452":101605},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_2926":60252,"_25561":60252,"_5":12525,"_2452":45423,"_25885":101607,"_17855":101609,"_24230":60252},[41651,99234,43969,100206,101608],"Integraciones",[],{"_2926":60253,"_25561":60252,"_17855":101611,"_5":17750,"_24230":60252,"_2452":101612},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_2926":60254,"_25561":60252,"_5":25882,"_17855":101614,"_24230":101615,"_2452":101616},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_2926":60255,"_25561":60252,"_5":25882,"_17855":101618,"_24230":101619,"_2452":101620},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_2926":60256,"_25561":60252,"_5":25882,"_17855":101622,"_24230":101623,"_2452":101624},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_2926":60257,"_25561":60252,"_5":25882,"_17855":101626,"_24230":101627,"_2452":101628},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_2926":60258,"_25561":60252,"_5":25882,"_17855":101630,"_24230":101631,"_2452":101632},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_2926":60259,"_25561":60252,"_5":25882,"_17855":101634,"_24230":101635,"_2452":101636},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_2926":60260,"_25561":60252,"_5":25882,"_17855":101638,"_24230":101639,"_2452":45457},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_2926":60261,"_25561":60252,"_5":25882,"_17855":101641,"_24230":101642,"_2452":45461},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_2926":60262,"_25561":60252,"_5":25882,"_17855":101644,"_24230":101645,"_2452":101646},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_2926":60263,"_25561":60252,"_5":25882,"_17855":101648,"_24230":101649,"_2452":101650},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_2926":60264,"_25561":60252,"_5":25882,"_17855":101652,"_24230":101653,"_2452":101654},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_2926":60265,"_25561":60252,"_5":25882,"_17855":101656,"_24230":101657,"_2452":101658},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_2926":60266,"_25561":60252,"_5":25882,"_17855":101660,"_24230":101661,"_2452":101662},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_2926":60267,"_25561":60252,"_5":25882,"_17855":101664,"_24230":101665,"_2452":101666},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_2926":60268,"_25561":60252,"_5":25882,"_17855":101668,"_24230":101669,"_2452":101670},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_2926":60269,"_25561":60252,"_5":25882,"_17855":101672,"_24230":101673,"_2452":101674},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_2926":60270,"_25561":60252,"_5":25882,"_17855":101676,"_24230":101677,"_2452":101678},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_2926":60271,"_25561":60252,"_5":25882,"_17855":101680,"_24230":101681,"_2452":101682},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_2926":60272,"_25561":60252,"_5":25882,"_17855":101684,"_24230":101685,"_2452":101686},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_2926":60273,"_25561":60252,"_5":25882,"_17855":101688,"_24230":101689,"_2452":101690},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_2926":60274,"_25561":60252,"_17855":101692,"_5":17750,"_24230":60252,"_2452":101693},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_2926":60275,"_25561":60252,"_17855":101695,"_5":17750,"_24230":60252,"_2452":101696},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_2926":60276,"_25561":60252,"_17855":101698,"_5":17750,"_24230":60252,"_2452":101699},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_2926":60277,"_25561":60252,"_17855":101701,"_5":17750,"_24230":101615,"_2452":101702},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_2926":60278,"_25561":60252,"_17855":101704,"_5":17750,"_24230":101615,"_2452":101705},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_2926":60279,"_25561":60252,"_17855":101707,"_5":17750,"_24230":101615,"_2452":101708},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_2926":60280,"_25561":60252,"_17855":101710,"_5":17750,"_24230":101615,"_2452":101711},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_2926":60281,"_25561":60252,"_17855":101713,"_5":17750,"_24230":101619,"_2452":101714},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_2926":60282,"_25561":60252,"_17855":101716,"_5":17750,"_24230":101623,"_2452":101717},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_2926":60283,"_25561":60252,"_17855":101719,"_5":17750,"_24230":101623,"_2452":101720},[],"Acción IAM",{"_2926":60284,"_25561":60252,"_17855":101722,"_5":17750,"_24230":101623,"_2452":98298},[],{"_2926":60285,"_25561":60252,"_17855":101724,"_5":17750,"_24230":101623,"_2452":45544},[],{"_2926":60286,"_25561":60252,"_17855":101726,"_5":17750,"_24230":101623,"_2452":101727},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_2926":60287,"_25561":60252,"_17855":101729,"_5":17750,"_24230":101623,"_2452":45550},[],{"_2926":60288,"_25561":60252,"_17855":101731,"_5":17750,"_24230":101623,"_2452":101732},[],"Registrar la CA en AWS IoT",{"_2926":60289,"_25561":60252,"_17855":101734,"_5":17750,"_24230":101623,"_2452":45556},[],{"_2926":60290,"_25561":60252,"_17855":101736,"_5":17750,"_24230":101623,"_2452":101737},[],"Consultar el estado del registro de la CA",{"_2926":60291,"_25561":60252,"_17855":101739,"_5":17750,"_24230":101623,"_2452":45562},[],{"_2926":60292,"_25561":60252,"_17855":101741,"_5":17750,"_24230":101623,"_2452":101742},[],"Crear o actualizar Things en IoT Core",{"_2926":60293,"_25561":60252,"_17855":101744,"_5":17750,"_24230":101623,"_2452":45568},[],{"_2926":60294,"_25561":60252,"_17855":101746,"_5":17750,"_24230":101623,"_2452":101747},[],"Aprovisionar Things mediante plantilla",{"_2926":60295,"_25561":60252,"_17855":101749,"_5":17750,"_24230":101623,"_2452":45574},[],{"_2926":60296,"_25561":60252,"_17855":101751,"_5":17750,"_24230":101623,"_2452":101752},[],"Registrar certificados de dispositivo",{"_2926":60297,"_25561":60252,"_17855":101754,"_5":17750,"_24230":101623,"_2452":45580},[],{"_2926":60298,"_25561":60252,"_17855":101756,"_5":17750,"_24230":101623,"_2452":101757},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_2926":60299,"_25561":60252,"_17855":101759,"_5":17750,"_24230":101623,"_2452":45586},[],{"_2926":60300,"_25561":60252,"_17855":101761,"_5":17750,"_24230":101623,"_2452":101762},[],"Crear y adjuntar políticas IoT",{"_2926":60301,"_25561":60252,"_17855":101764,"_5":17750,"_24230":101623,"_2452":45592},[],{"_2926":60302,"_25561":60252,"_17855":101766,"_5":17750,"_24230":101623,"_2452":101767},[],"Gestionar grupos de Things",{"_2926":60303,"_25561":60252,"_17855":101769,"_5":17750,"_24230":101623,"_2452":45598},[],{"_2926":60304,"_25561":60252,"_17855":101771,"_5":17750,"_24230":101623,"_2452":101772},[],"Crear plantillas JITP",{"_2926":60305,"_25561":60252,"_17855":101774,"_5":17750,"_24230":101623,"_2452":45604},[],{"_2926":60306,"_25561":60252,"_17855":101776,"_5":17750,"_24230":101623,"_2452":101777},[],"Leer y escribir el Device Shadow",{"_2926":60307,"_25561":60252,"_17855":101779,"_5":17750,"_24230":101623,"_2452":101780},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_2926":60308,"_25561":60252,"_17855":101782,"_5":17750,"_24230":101627,"_2452":101783},[],"Parámetro",{"_2926":60309,"_25561":60252,"_17855":101785,"_5":17750,"_24230":101627,"_2452":101786},[],"Tipo",{"_2926":60310,"_25561":60252,"_17855":101788,"_5":17750,"_24230":101627,"_2452":101789},[],"Requerido",{"_2926":60311,"_25561":60252,"_17855":101791,"_5":17750,"_24230":101627,"_2452":101792},[],"Descripción",{"_2926":60312,"_25561":60252,"_17855":101794,"_5":17750,"_24230":101627,"_2452":45625},[],{"_2926":60313,"_25561":60252,"_17855":101796,"_5":17750,"_24230":101627,"_2452":21321},[],{"_2926":60314,"_25561":60252,"_17855":101798,"_5":17750,"_24230":101627,"_2452":101799},[],"Sí",{"_2926":60315,"_25561":60252,"_17855":101801,"_5":17750,"_24230":101627,"_2452":101802},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_2926":60316,"_25561":60252,"_17855":101804,"_5":17750,"_24230":101627,"_2452":45636},[],{"_2926":60317,"_25561":60252,"_17855":101806,"_5":17750,"_24230":101627,"_2452":21321},[],{"_2926":60318,"_25561":60252,"_17855":101808,"_5":17750,"_24230":101627,"_2452":101799},[],{"_2926":60319,"_25561":60252,"_17855":101810,"_5":17750,"_24230":101627,"_2452":101811},[],"Región AWS donde opera el conector.",{"_2926":60320,"_25561":60252,"_17855":101813,"_5":17750,"_24230":101627,"_2452":45646},[],{"_2926":60321,"_25561":60252,"_17855":101815,"_5":17750,"_24230":101627,"_2452":21321},[],{"_2926":60322,"_25561":60252,"_17855":101817,"_5":17750,"_24230":101627,"_2452":101799},[],{"_2926":60323,"_25561":60252,"_17855":101819,"_5":17750,"_24230":101627,"_2452":101820},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_2926":60324,"_25561":60252,"_17855":101822,"_5":17750,"_24230":101627,"_2452":45656},[],{"_2926":60325,"_25561":60252,"_17855":101824,"_5":17750,"_24230":101627,"_2452":21321},[],{"_2926":60326,"_25561":60252,"_17855":101826,"_5":17750,"_24230":101627,"_2452":101827},[],"Solo con `auth_method=static`",{"_2926":60327,"_25561":60252,"_17855":101829,"_5":17750,"_24230":101627,"_2452":101830},[],"Clave de acceso AWS.",{"_2926":60328,"_25561":60252,"_17855":101832,"_5":17750,"_24230":101627,"_2452":45667},[],{"_2926":60329,"_25561":60252,"_17855":101834,"_5":17750,"_24230":101627,"_2452":21321},[],{"_2926":60330,"_25561":60252,"_17855":101836,"_5":17750,"_24230":101627,"_2452":101827},[],{"_2926":60331,"_25561":60252,"_17855":101838,"_5":17750,"_24230":101627,"_2452":101839},[],"Clave secreta AWS.",{"_2926":60332,"_25561":60252,"_17855":101841,"_5":17750,"_24230":101627,"_2452":45677},[],{"_2926":60333,"_25561":60252,"_17855":101843,"_5":17750,"_24230":101627,"_2452":21321},[],{"_2926":60334,"_25561":60252,"_17855":101845,"_5":17750,"_24230":101627,"_2452":45682},[],{"_2926":60335,"_25561":60252,"_17855":101847,"_5":17750,"_24230":101627,"_2452":101848},[],"Token de sesión (con `auth_method=static`).",{"_2926":60336,"_25561":60252,"_17855":101850,"_5":17750,"_24230":101627,"_2452":45688},[],{"_2926":60337,"_25561":60252,"_17855":101852,"_5":17750,"_24230":101627,"_2452":21321},[],{"_2926":60338,"_25561":60252,"_17855":101854,"_5":17750,"_24230":101627,"_2452":101855},[],"Solo con `auth_method=role`",{"_2926":60339,"_25561":60252,"_17855":101857,"_5":17750,"_24230":101627,"_2452":101858},[],"ARN del rol a asumir.",{"_2926":60340,"_25561":60252,"_17855":101860,"_5":17750,"_24230":101627,"_2452":45699},[],{"_2926":60341,"_25561":60252,"_17855":101862,"_5":17750,"_24230":101627,"_2452":21321},[],{"_2926":60342,"_25561":60252,"_17855":101864,"_5":17750,"_24230":101627,"_2452":45682},[],{"_2926":60343,"_25561":60252,"_17855":101866,"_5":17750,"_24230":101627,"_2452":101867},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_2926":60344,"_25561":60252,"_17855":101869,"_5":17750,"_24230":101627,"_2452":45709},[],{"_2926":60345,"_25561":60252,"_17855":101871,"_5":17750,"_24230":101627,"_2452":14978},[],{"_2926":60346,"_25561":60252,"_17855":101873,"_5":17750,"_24230":101627,"_2452":101799},[],{"_2926":60347,"_25561":60252,"_17855":101875,"_5":17750,"_24230":101627,"_2452":101876},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_2926":60348,"_25561":60252,"_17855":101878,"_5":17750,"_24230":101627,"_2452":45719},[],{"_2926":60349,"_25561":60252,"_17855":101880,"_5":17750,"_24230":101627,"_2452":21321},[],{"_2926":60350,"_25561":60252,"_17855":101882,"_5":17750,"_24230":101627,"_2452":101799},[],{"_2926":60351,"_25561":60252,"_17855":101884,"_5":17750,"_24230":101627,"_2452":101885},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_2926":60352,"_25561":60252,"_17855":101887,"_5":17750,"_24230":101627,"_2452":45729},[],{"_2926":60353,"_25561":60252,"_17855":101889,"_5":17750,"_24230":101627,"_2452":21321},[],{"_2926":60354,"_25561":60252,"_17855":101891,"_5":17750,"_24230":101627,"_2452":101799},[],{"_2926":60355,"_25561":60252,"_17855":101893,"_5":17750,"_24230":101627,"_2452":101894},[],"URL HTTP del Device Manager de Lamassu.",{"_2926":60356,"_25561":60252,"_17855":101896,"_5":17750,"_24230":101627,"_2452":45739},[],{"_2926":60357,"_25561":60252,"_17855":101898,"_5":17750,"_24230":101627,"_2452":21321},[],{"_2926":60358,"_25561":60252,"_17855":101900,"_5":17750,"_24230":101627,"_2452":101799},[],{"_2926":60359,"_25561":60252,"_17855":101902,"_5":17750,"_24230":101627,"_2452":101903},[],"URL HTTP del servicio de CA de Lamassu.",{"_2926":60360,"_25561":60252,"_17855":101905,"_5":17750,"_24230":101631,"_2452":101906},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_2926":60361,"_25561":60252,"_17855":101908,"_5":17750,"_24230":101635,"_2452":101909},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_2926":60362,"_25561":60252,"_17855":101911,"_5":17750,"_24230":101635,"_2452":101912},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_2926":60363,"_25561":60252,"_17855":101914,"_5":17750,"_24230":101639,"_2452":101915},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_2926":60364,"_25561":60252,"_17855":101917,"_5":17750,"_24230":101639,"_2452":101918},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_2926":60365,"_25561":60252,"_17855":101920,"_5":17750,"_24230":101639,"_2452":101921},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_2926":60366,"_25561":60252,"_17855":101923,"_5":17750,"_24230":101639,"_2452":101924},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_2926":60367,"_25561":60252,"_17855":101926,"_5":17750,"_24230":101639,"_2452":101927},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_2926":60368,"_25561":60252,"_17855":101929,"_5":17750,"_24230":101639,"_2452":101930},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_2926":60369,"_25561":60252,"_17855":101932,"_5":17750,"_24230":101642,"_2452":101933},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_2926":60370,"_25561":60252,"_17855":101935,"_5":17750,"_24230":101645,"_2452":101936},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_2926":60371,"_25561":60252,"_17855":101938,"_5":17750,"_24230":101645,"_2452":101939},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_2926":60372,"_25561":60252,"_17855":101941,"_5":17750,"_24230":101649,"_2452":101942},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_2926":60373,"_25561":60252,"_17855":101944,"_5":17750,"_24230":101653,"_2452":101945},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_2926":60374,"_25561":60252,"_17855":101947,"_5":17750,"_24230":101653,"_2452":101948},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_2926":60375,"_25561":60252,"_17855":101950,"_5":17750,"_24230":101653,"_2452":101951},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_2926":60376,"_25561":60252,"_17855":101953,"_5":17750,"_24230":101653,"_2452":101954},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_2926":60377,"_25561":60252,"_17855":101956,"_5":17750,"_24230":101653,"_2452":101957},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_2926":60378,"_25561":60252,"_17855":101959,"_5":17750,"_24230":101653,"_2452":101960},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_2926":60379,"_25561":60252,"_17855":101962,"_5":17750,"_24230":101657,"_2452":101963},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_2926":60380,"_25561":60252,"_17855":101965,"_5":17750,"_24230":101657,"_2452":101966},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_2926":60381,"_25561":60252,"_17855":101968,"_5":17750,"_24230":101657,"_2452":101969},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_2926":60382,"_25561":60252,"_17855":101971,"_5":17750,"_24230":101661,"_2452":101972},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_2926":60383,"_25561":60252,"_17855":101974,"_5":17750,"_24230":101661,"_2452":101975},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_2926":60384,"_25561":60252,"_17855":101977,"_5":17750,"_24230":101661,"_2452":101978},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_2926":60385,"_25561":60252,"_17855":101980,"_5":17750,"_24230":101665,"_2452":101981},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_2926":60386,"_25561":60252,"_17855":101983,"_5":17750,"_24230":101665,"_2452":101984},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_2926":60387,"_25561":60252,"_17855":101986,"_5":17750,"_24230":101665,"_2452":101987},[],"Para que el flujo JITP funcione correctamente:",{"_2926":60388,"_25561":60252,"_17855":101989,"_5":17750,"_24230":101665,"_2452":101990},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_2926":60389,"_25561":60252,"_17855":101992,"_5":17750,"_24230":101665,"_2452":101993},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_2926":60390,"_25561":60252,"_17855":101995,"_5":17750,"_24230":101665,"_2452":101996},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_2926":60391,"_25561":60252,"_17855":101998,"_5":17750,"_24230":101665,"_2452":101999},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_2926":60392,"_25561":60252,"_17855":102001,"_5":17750,"_24230":101669,"_2452":102002},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_2926":60393,"_25561":60252,"_17855":102004,"_5":17750,"_24230":101669,"_2452":102005},[],"Estado en Lamassu",{"_2926":60394,"_25561":60252,"_17855":102007,"_5":17750,"_24230":101669,"_2452":102008},[],"Razón de revocación",{"_2926":60395,"_25561":60252,"_17855":102010,"_5":17750,"_24230":101669,"_2452":102011},[],"Estado en AWS IoT Core",{"_2926":60396,"_25561":60252,"_17855":102013,"_5":17750,"_24230":101669,"_2452":45860},[],{"_2926":60397,"_25561":60252,"_17855":102015,"_5":17750,"_24230":101669,"_2452":102016},[],"Ninguna",{"_2926":60398,"_25561":60252,"_17855":102018,"_5":17750,"_24230":101669,"_2452":45866},[],{"_2926":60399,"_25561":60252,"_17855":102020,"_5":17750,"_24230":101669,"_2452":45869},[],{"_2926":60400,"_25561":60252,"_17855":102022,"_5":17750,"_24230":101669,"_2452":45872},[],{"_2926":60401,"_25561":60252,"_17855":102024,"_5":17750,"_24230":101669,"_2452":45875},[],{"_2926":60402,"_25561":60252,"_17855":102026,"_5":17750,"_24230":101669,"_2452":45869},[],{"_2926":60403,"_25561":60252,"_17855":102028,"_5":17750,"_24230":101669,"_2452":102029},[],"Cualquier otra razón",{"_2926":60404,"_25561":60252,"_17855":102031,"_5":17750,"_24230":101669,"_2452":45883},[],{"_2926":60405,"_25561":60252,"_17855":102033,"_5":17750,"_24230":101669,"_2452":102034},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_2926":60406,"_25561":60252,"_17855":102036,"_5":17750,"_24230":101673,"_2452":102037},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_2926":60407,"_25561":60252,"_17855":102039,"_5":17750,"_24230":101673,"_2452":102040},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_2926":60408,"_25561":60252,"_17855":102042,"_5":17750,"_24230":101673,"_2452":102043},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_2926":60409,"_25561":60252,"_17855":102045,"_5":17750,"_24230":101677,"_2452":102046},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_2926":60410,"_25561":60252,"_17855":102048,"_5":17750,"_24230":101677,"_2452":102049},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_2926":60411,"_25561":60252,"_17855":102051,"_5":17750,"_24230":101681,"_2452":102052},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_2926":60412,"_25561":60252,"_17855":102054,"_5":17750,"_24230":101681,"_2452":102055},[],"Existen dos tipos de acciones:",{"_2926":60413,"_25561":60252,"_17855":102057,"_5":17750,"_24230":101681,"_2452":102058},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_2926":60414,"_25561":60252,"_17855":102060,"_5":17750,"_24230":101681,"_2452":102061},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_2926":60415,"_25561":60252,"_17855":102063,"_5":17750,"_24230":101681,"_2452":102064},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_2926":60416,"_25561":60252,"_17855":102066,"_5":17750,"_24230":101685,"_2452":102067},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_2926":60417,"_25561":60252,"_17855":102069,"_5":17750,"_24230":101685,"_2452":102070},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_2926":60418,"_25561":60252,"_17855":102072,"_5":17750,"_24230":101685,"_2452":102073},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_2926":60419,"_25561":60252,"_17855":102075,"_5":17750,"_24230":101689,"_2452":102076},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_2926":60420,"_25561":60252,"_17855":102078,"_5":17750,"_24230":101689,"_2452":102079},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_2926":60421,"_25561":60252,"_17855":102081,"_5":17750,"_24230":101689,"_2452":102082},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_2926":60422,"_25561":60252,"_17855":102084,"_5":17750,"_24230":101689,"_2452":102085},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_2926":60423,"_25561":60252,"_17855":102087,"_5":17750,"_24230":101689,"_2452":102088},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_2926":60424,"_25561":60252,"_17855":102090,"_5":17750,"_24230":101689,"_2452":102091},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_2926":60425,"_25561":60252,"_17855":102093,"_5":17750,"_24230":101689,"_2452":102094},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_2926":60426,"_25561":60252,"_17855":102096,"_5":17750,"_24230":101689,"_2452":102097},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_2926":60427,"_25561":60252,"_17855":102099,"_5":17750,"_24230":101689,"_2452":102100},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_2926":60428,"_25561":60252,"_17855":102102,"_5":17750,"_24230":101689,"_2452":102103},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_2926":60429,"_25561":60252,"_17855":102105,"_5":17750,"_24230":101689,"_2452":102106},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_2926":60430,"_25561":60252,"_17855":102108,"_5":17750,"_24230":101689,"_2452":102109},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_2926":60431,"_25561":60252,"_17855":102111,"_5":17750,"_24230":101689,"_2452":102112},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_2926":60432,"_25561":60252,"_17855":102114,"_5":17750,"_24230":101689,"_2452":102115},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_2926":60433,"_25561":60252,"_17855":102117,"_5":17750,"_24230":101689,"_2452":102118},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_2926":60434,"_25561":60252,"_17855":102120,"_5":17750,"_24230":101689,"_2452":102121},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_2926":60435,"_25561":60252,"_17855":102123,"_5":17750,"_24230":101689,"_2452":102124},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_2926":60436,"_25561":60252,"_17855":102126,"_5":17750,"_24230":101689,"_2452":102127},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_2926":60437,"_25561":60252,"_17855":102129,"_5":17750,"_24230":101689,"_2452":102130},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2926":60438,"_25561":60252,"_17855":102132,"_5":17750,"_24230":101689,"_2452":102133},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2926":60439,"_25561":60252,"_17855":102135,"_5":17750,"_24230":101689,"_2452":102136},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_2926":60440,"_25561":60440,"_5":12525,"_2452":43969,"_25885":102138,"_17855":102139,"_24230":60440},[41651,99234,43969],[],{"_2926":60441,"_25561":60440,"_17855":102141,"_5":17750,"_24230":60440,"_2452":102142},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_2926":60442,"_25561":60440,"_5":25882,"_17855":102144,"_24230":102145,"_2452":102146},[],"/docs/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_2926":60443,"_25561":60440,"_5":25882,"_17855":102148,"_24230":102149,"_2452":100206},[],"/docs/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_2926":60444,"_25561":60440,"_5":25882,"_17855":102151,"_24230":102152,"_2452":100381},[],"/docs/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_2926":60445,"_25561":60440,"_5":25882,"_17855":102154,"_24230":102155,"_2452":101608},[],"/docs/es/platform/iot-fleets/overview#integraciones",{"_2926":60446,"_25561":60440,"_5":25882,"_17855":102157,"_24230":102158,"_2452":102159},[],"/docs/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_2926":60447,"_25561":60440,"_17855":102161,"_5":17750,"_24230":60440,"_2452":102162},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_2926":60448,"_25561":60440,"_17855":102164,"_5":17750,"_24230":102145,"_2452":102165},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_2926":60449,"_25561":60440,"_17855":102167,"_5":17750,"_24230":102145,"_2452":102168},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_2926":60450,"_25561":60440,"_17855":102170,"_5":17750,"_24230":102149,"_2452":102171},[],"Recurso",{"_2926":60451,"_25561":60440,"_17855":102173,"_5":17750,"_24230":102149,"_2452":102174},[],"Qué representa",{"_2926":60452,"_25561":60440,"_17855":102176,"_5":17750,"_24230":102149,"_2452":102177},[],"**Dispositivo**",{"_2926":60453,"_25561":60440,"_17855":102179,"_5":17750,"_24230":102149,"_2452":102180},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_2926":60454,"_25561":60440,"_17855":102182,"_5":17750,"_24230":102149,"_2452":102183},[],"**Identidad**",{"_2926":60455,"_25561":60440,"_17855":102185,"_5":17750,"_24230":102149,"_2452":102186},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_2926":60456,"_25561":60440,"_17855":102188,"_5":17750,"_24230":102149,"_2452":46041},[],{"_2926":60457,"_25561":60440,"_17855":102190,"_5":17750,"_24230":102149,"_2452":102191},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_2926":60458,"_25561":60440,"_17855":102193,"_5":17750,"_24230":102149,"_2452":102194},[],"**Flota**",{"_2926":60459,"_25561":60440,"_17855":102196,"_5":17750,"_24230":102149,"_2452":102197},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_2926":60460,"_25561":60440,"_17855":102199,"_5":17750,"_24230":102149,"_2452":102200},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_2926":60461,"_25561":60440,"_17855":102202,"_5":17750,"_24230":102149,"_2452":102203},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_2926":60462,"_25561":60440,"_17855":102205,"_5":17750,"_24230":102152,"_2452":102206},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_2926":60463,"_25561":60440,"_17855":102208,"_5":17750,"_24230":102152,"_2452":102209},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_2926":60464,"_25561":60440,"_17855":102211,"_5":17750,"_24230":102152,"_2452":102212},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_2926":60465,"_25561":60440,"_17855":102214,"_5":17750,"_24230":102152,"_2452":102215},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_2926":60466,"_25561":60440,"_17855":102217,"_5":17750,"_24230":102152,"_2452":102218},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_2926":60467,"_25561":60440,"_17855":102220,"_5":17750,"_24230":102152,"_2452":102221},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_2926":60468,"_25561":60440,"_17855":102223,"_5":17750,"_24230":102152,"_2452":102224},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2926":60469,"_25561":60440,"_17855":102226,"_5":17750,"_24230":102152,"_2452":102227},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2926":60470,"_25561":60440,"_17855":102229,"_5":17750,"_24230":102155,"_2452":102230},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_2926":60471,"_25561":60440,"_17855":102232,"_5":17750,"_24230":102155,"_2452":102233},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_2926":60472,"_25561":60440,"_17855":102235,"_5":17750,"_24230":102158,"_2452":102236},[],"Participante",{"_2926":60473,"_25561":60440,"_17855":102238,"_5":17750,"_24230":102158,"_2452":102239},[],"Responsabilidad",{"_2926":60474,"_25561":60440,"_17855":102241,"_5":17750,"_24230":102158,"_2452":102242},[],"Administrador PKI",{"_2926":60475,"_25561":60440,"_17855":102244,"_5":17750,"_24230":102158,"_2452":102245},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_2926":60476,"_25561":60440,"_17855":102247,"_5":17750,"_24230":102158,"_2452":102248},[],"Administrador del aprovisionamiento",{"_2926":60477,"_25561":60440,"_17855":102250,"_5":17750,"_24230":102158,"_2452":102251},[],"DMS, admisión, autenticación por operación e inventario.",{"_2926":60478,"_25561":60440,"_17855":102253,"_5":17750,"_24230":102158,"_2452":102254},[],"Integrador del dispositivo",{"_2926":60479,"_25561":60440,"_17855":102256,"_5":17750,"_24230":102158,"_2452":102257},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_2926":60480,"_25561":60440,"_17855":102259,"_5":17750,"_24230":102158,"_2452":102260},[],"Integrador del consumidor",{"_2926":60481,"_25561":60440,"_17855":102262,"_5":17750,"_24230":102158,"_2452":102263},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_2926":60482,"_25561":60440,"_17855":102265,"_5":17750,"_24230":102158,"_2452":102266},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_2926":60483,"_25561":60483,"_5":12525,"_2452":102268,"_25885":102269,"_17855":102271,"_24230":60483},"Enrola y conecta tu primer dispositivo",[41651,99234,43969,102270],"Primeros pasos",[],{"_2926":60484,"_25561":60483,"_17855":102273,"_5":17750,"_24230":60483,"_2452":102274},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_2926":60485,"_25561":60483,"_5":25882,"_17855":102276,"_24230":102277,"_2452":97935},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_2926":60486,"_25561":60483,"_5":25882,"_17855":102279,"_24230":102280,"_2452":102281},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_2926":60487,"_25561":60483,"_5":25882,"_17855":102283,"_24230":102284,"_2452":102285},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_2926":60488,"_25561":60483,"_5":25882,"_17855":102287,"_24230":102288,"_2452":102289},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_2926":60489,"_25561":60483,"_5":25882,"_17855":102291,"_24230":102292,"_2452":102293},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_2926":60490,"_25561":60483,"_5":25882,"_17855":102295,"_24230":102296,"_2452":102297},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_2926":60491,"_25561":60483,"_5":25882,"_17855":102299,"_24230":102300,"_2452":102301},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_2926":60492,"_25561":60483,"_5":25882,"_17855":102303,"_24230":102304,"_2452":102305},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_2926":60493,"_25561":60483,"_17855":102307,"_5":17750,"_24230":60483,"_2452":102308},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_2926":60494,"_25561":60483,"_17855":102310,"_5":17750,"_24230":102277,"_2452":102311},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_2926":60495,"_25561":60483,"_17855":102313,"_5":17750,"_24230":102277,"_2452":102314},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_2926":60496,"_25561":60483,"_17855":102316,"_5":17750,"_24230":102277,"_2452":102317},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_2926":60497,"_25561":60483,"_17855":102319,"_5":17750,"_24230":102277,"_2452":102320},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_2926":60498,"_25561":60483,"_17855":102322,"_5":17750,"_24230":102277,"_2452":102323},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_2926":60499,"_25561":60483,"_17855":102325,"_5":17750,"_24230":102280,"_2452":102326},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_2926":60500,"_25561":60483,"_17855":102328,"_5":17750,"_24230":102280,"_2452":102329},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_2926":60501,"_25561":60483,"_17855":102331,"_5":17750,"_24230":102284,"_2452":102332},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_2926":60502,"_25561":60483,"_17855":102334,"_5":17750,"_24230":102284,"_2452":102335},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_2926":60503,"_25561":60483,"_17855":102337,"_5":17750,"_24230":102284,"_2452":102338},[],"Ajuste",{"_2926":60504,"_25561":60483,"_17855":102340,"_5":17750,"_24230":102284,"_2452":102341},[],"Valor de evaluación",{"_2926":60505,"_25561":60483,"_17855":102343,"_5":17750,"_24230":102284,"_2452":46197},[],{"_2926":60506,"_25561":60483,"_17855":102345,"_5":17750,"_24230":102284,"_2452":102346},[],"Raíz emisora de `device-root.pem`.",{"_2926":60507,"_25561":60483,"_17855":102348,"_5":17750,"_24230":102284,"_2452":100509},[],{"_2926":60508,"_25561":60483,"_17855":102350,"_5":17750,"_24230":102284,"_2452":102351},[],"Perfil final de 1 hora que acabas de preparar.",{"_2926":60509,"_25561":60483,"_17855":102353,"_5":17750,"_24230":102284,"_2452":46208},[],{"_2926":60510,"_25561":60483,"_17855":102355,"_5":17750,"_24230":102284,"_2452":46211},[],{"_2926":60511,"_25561":60483,"_17855":102357,"_5":17750,"_24230":102284,"_2452":46214},[],{"_2926":60512,"_25561":60483,"_17855":102359,"_5":17750,"_24230":102284,"_2452":102360},[],"Habilitado.",{"_2926":60513,"_25561":60483,"_17855":102362,"_5":17750,"_24230":102284,"_2452":46220},[],{"_2926":60514,"_25561":60483,"_17855":102364,"_5":17750,"_24230":102284,"_2452":102365},[],"Deshabilitado; el ID debe ser nuevo.",{"_2926":60515,"_25561":60483,"_17855":102367,"_5":17750,"_24230":102284,"_2452":102368},[],"Autenticación inicial",{"_2926":60516,"_25561":60483,"_17855":102370,"_5":17750,"_24230":102284,"_2452":102371},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_2926":60517,"_25561":60483,"_17855":102373,"_5":17750,"_24230":102284,"_2452":102374},[],"Autenticación de renovación",{"_2926":60518,"_25561":60483,"_17855":102376,"_5":17750,"_24230":102284,"_2452":102377},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_2926":60519,"_25561":60483,"_17855":102379,"_5":17750,"_24230":102284,"_2452":46238},[],{"_2926":60520,"_25561":60483,"_17855":102381,"_5":17750,"_24230":102284,"_2452":102382},[],"Lista vacía para esta emisión directa / deshabilitado.",{"_2926":60521,"_25561":60483,"_17855":102384,"_5":17750,"_24230":102284,"_2452":46244},[],{"_2926":60522,"_25561":60483,"_17855":102386,"_5":17750,"_24230":102284,"_2452":102387},[],"1 hora.",{"_2926":60523,"_25561":60483,"_17855":102389,"_5":17750,"_24230":102284,"_2452":46250},[],{"_2926":60524,"_25561":60483,"_17855":102391,"_5":17750,"_24230":102284,"_2452":102392},[],"30 minutos / 10 minutos.",{"_2926":60525,"_25561":60483,"_17855":102394,"_5":17750,"_24230":102284,"_2452":46256},[],{"_2926":60526,"_25561":60483,"_17855":102396,"_5":17750,"_24230":102284,"_2452":102397},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_2926":60527,"_25561":60483,"_17855":102399,"_5":17750,"_24230":102284,"_2452":44288},[],{"_2926":60528,"_25561":60483,"_17855":102401,"_5":17750,"_24230":102284,"_2452":102402},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_2926":60529,"_25561":60483,"_17855":102404,"_5":17750,"_24230":102284,"_2452":46267},[],{"_2926":60530,"_25561":60483,"_17855":102406,"_5":17750,"_24230":102284,"_2452":102407},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_2926":60531,"_25561":60483,"_17855":102409,"_5":17750,"_24230":102284,"_2452":102410},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. Si tu consola no expone el bloque independiente, configura y comprueba el recurso mediante la API DMS y la guía DMS.",{"_2926":60532,"_25561":60483,"_17855":102412,"_5":17750,"_24230":102288,"_2452":102413},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_2926":60533,"_25561":60483,"_17855":102415,"_5":17750,"_24230":102288,"_2452":102416},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_2926":60534,"_25561":60483,"_17855":102418,"_5":17750,"_24230":102292,"_2452":102419},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_2926":60535,"_25561":60483,"_17855":102421,"_5":17750,"_24230":102292,"_2452":102422},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_2926":60536,"_25561":60483,"_17855":102424,"_5":17750,"_24230":102292,"_2452":102425},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_2926":60537,"_25561":60483,"_17855":102427,"_5":17750,"_24230":102296,"_2452":102428},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_2926":60538,"_25561":60483,"_17855":102430,"_5":17750,"_24230":102296,"_2452":102431},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_2926":60539,"_25561":60483,"_17855":102433,"_5":17750,"_24230":102300,"_2452":102434},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_2926":60540,"_25561":60483,"_17855":102436,"_5":17750,"_24230":102300,"_2452":102437},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_2926":60541,"_25561":60483,"_17855":102439,"_5":17750,"_24230":102300,"_2452":102440},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_2926":60542,"_25561":60483,"_17855":102442,"_5":17750,"_24230":102300,"_2452":102443},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_2926":60543,"_25561":60483,"_17855":102445,"_5":17750,"_24230":102300,"_2452":102446},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_2926":60544,"_25561":60483,"_17855":102448,"_5":17750,"_24230":102304,"_2452":102449},[],"Comprobación",{"_2926":60545,"_25561":60483,"_17855":102451,"_5":17750,"_24230":102304,"_2452":102452},[],"Resultado esperado",{"_2926":60546,"_25561":60483,"_17855":102454,"_5":17750,"_24230":102304,"_2452":102455},[],"Registro",{"_2926":60547,"_25561":60483,"_17855":102457,"_5":17750,"_24230":102304,"_2452":102458},[],"ID creado automáticamente y DMS correcto.",{"_2926":60548,"_25561":60483,"_17855":102460,"_5":17750,"_24230":102304,"_2452":102461},[],"Certificado",{"_2926":60549,"_25561":60483,"_17855":102463,"_5":17750,"_24230":102304,"_2452":102464},[],"CN, perfil, serie y clave verificados.",{"_2926":60550,"_25561":60483,"_17855":102466,"_5":17750,"_24230":102304,"_2452":102467},[],"Inventario",{"_2926":60551,"_25561":60483,"_17855":102469,"_5":17750,"_24230":102304,"_2452":102470},[],"Serie recibida visible como identidad actual y en el historial.",{"_2926":60552,"_25561":60483,"_17855":102472,"_5":17750,"_24230":102304,"_2452":102473},[],"Consumidor",{"_2926":60553,"_25561":60483,"_17855":102475,"_5":17750,"_24230":102304,"_2452":102476},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_2926":60554,"_25561":60483,"_17855":102478,"_5":17750,"_24230":102304,"_2452":102479},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_2926":60555,"_25561":60483,"_17855":102481,"_5":17750,"_24230":102304,"_2452":102482},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_2926":60556,"_25561":60556,"_5":12525,"_2452":100223,"_25885":102484,"_17855":102485,"_24230":60556},[41651,99234,43969,102270],[],{"_2926":60557,"_25561":60556,"_17855":102487,"_5":17750,"_24230":60556,"_2452":102488},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_2926":60558,"_25561":60556,"_5":25882,"_17855":102490,"_24230":102491,"_2452":97935},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_2926":60559,"_25561":60556,"_5":25882,"_17855":102493,"_24230":102494,"_2452":102495},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_2926":60560,"_25561":60556,"_5":25882,"_17855":102497,"_24230":102498,"_2452":102499},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_2926":60561,"_25561":60556,"_5":25882,"_17855":102501,"_24230":102502,"_2452":102503},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_2926":60562,"_25561":60556,"_5":25882,"_17855":102505,"_24230":102506,"_2452":102507},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_2926":60563,"_25561":60556,"_5":25882,"_17855":102509,"_24230":102510,"_2452":102511},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_2926":60564,"_25561":60556,"_5":25882,"_17855":102513,"_24230":102514,"_2452":102452},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_2926":60565,"_25561":60556,"_5":25882,"_17855":102516,"_24230":102517,"_2452":102518},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_2926":60566,"_25561":60556,"_5":25882,"_17855":102520,"_24230":102521,"_2452":102522},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_2926":60567,"_25561":60556,"_17855":102524,"_5":17750,"_24230":60556,"_2452":102525},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_2926":60568,"_25561":60556,"_17855":102527,"_5":17750,"_24230":60556,"_2452":102528},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_2926":60569,"_25561":60556,"_17855":102530,"_5":17750,"_24230":102491,"_2452":102531},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_2926":60570,"_25561":60556,"_17855":102533,"_5":17750,"_24230":102491,"_2452":102534},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_2926":60571,"_25561":60556,"_17855":102536,"_5":17750,"_24230":102491,"_2452":102537},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_2926":60572,"_25561":60556,"_17855":102539,"_5":17750,"_24230":102491,"_2452":102540},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_2926":60573,"_25561":60556,"_17855":102542,"_5":17750,"_24230":102494,"_2452":102543},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_2926":60574,"_25561":60556,"_17855":102545,"_5":17750,"_24230":102494,"_2452":102546},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_2926":60575,"_25561":60556,"_17855":102548,"_5":17750,"_24230":102494,"_2452":102549},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_2926":60576,"_25561":60556,"_17855":102551,"_5":17750,"_24230":102494,"_2452":102552},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_2926":60577,"_25561":60556,"_17855":102554,"_5":17750,"_24230":102494,"_2452":102555},[],"Configura **Authentication Mode** como `CLIENT_CERTIFICATE` y añade en **Validation CAs** la CA cuyos certificados iniciales aceptarás. Para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deshabilitada la generación de claves en servidor si no la vas a utilizar.",{"_2926":60578,"_25561":60556,"_17855":102557,"_5":17750,"_24230":102494,"_2452":102558},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_2926":60579,"_25561":60556,"_17855":102560,"_5":17750,"_24230":102494,"_2452":102561},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_2926":60580,"_25561":60556,"_17855":102563,"_5":17750,"_24230":102494,"_2452":102564},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_2926":60581,"_25561":60556,"_17855":102566,"_5":17750,"_24230":102498,"_2452":102567},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_2926":60582,"_25561":60556,"_17855":102569,"_5":17750,"_24230":102498,"_2452":46433},[],{"_2926":60583,"_25561":60556,"_17855":102571,"_5":17750,"_24230":102498,"_2452":102572},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_2926":60584,"_25561":60556,"_17855":102574,"_5":17750,"_24230":102498,"_2452":102575},[],"**Icon** y **Tags**: clasificación opcional.",{"_2926":60585,"_25561":60556,"_17855":102577,"_5":17750,"_24230":102498,"_2452":102578},[],"Confirma el registro.",{"_2926":60586,"_25561":60556,"_17855":102580,"_5":17750,"_24230":102502,"_2452":102581},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_2926":60587,"_25561":60556,"_17855":102583,"_5":17750,"_24230":102502,"_2452":102584},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_2926":60588,"_25561":60556,"_17855":102586,"_5":17750,"_24230":102506,"_2452":102587},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_2926":60589,"_25561":60556,"_17855":102589,"_5":17750,"_24230":102506,"_2452":102590},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_2926":60590,"_25561":60556,"_17855":102592,"_5":17750,"_24230":102510,"_2452":102593},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_2926":60591,"_25561":60556,"_17855":102595,"_5":17750,"_24230":102510,"_2452":102596},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_2926":60592,"_25561":60556,"_17855":102598,"_5":17750,"_24230":102514,"_2452":102449},[],{"_2926":60593,"_25561":60556,"_17855":102600,"_5":17750,"_24230":102514,"_2452":102601},[],"Resultado",{"_2926":60594,"_25561":60556,"_17855":102603,"_5":17750,"_24230":102514,"_2452":102604},[],"Dispositivo",{"_2926":60595,"_25561":60556,"_17855":102606,"_5":17750,"_24230":102514,"_2452":102607},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_2926":60596,"_25561":60556,"_17855":102609,"_5":17750,"_24230":102514,"_2452":102610},[],"Identidad actual",{"_2926":60597,"_25561":60556,"_17855":102612,"_5":17750,"_24230":102514,"_2452":102613},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_2926":60598,"_25561":60556,"_17855":102615,"_5":17750,"_24230":102514,"_2452":102616},[],"Historial",{"_2926":60599,"_25561":60556,"_17855":102618,"_5":17750,"_24230":102514,"_2452":102619},[],"La emisión asociada aparece con su número de serie y fechas.",{"_2926":60600,"_25561":60556,"_17855":102621,"_5":17750,"_24230":102514,"_2452":102622},[],"Clave y certificado",{"_2926":60601,"_25561":60556,"_17855":102624,"_5":17750,"_24230":102514,"_2452":102625},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_2926":60602,"_25561":60556,"_17855":102627,"_5":17750,"_24230":102517,"_2452":102628},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_2926":60603,"_25561":60556,"_17855":102630,"_5":17750,"_24230":102517,"_2452":102631},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_2926":60604,"_25561":60556,"_17855":102633,"_5":17750,"_24230":102517,"_2452":102634},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_2926":60605,"_25561":60556,"_17855":102636,"_5":17750,"_24230":102517,"_2452":102637},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_2926":60606,"_25561":60556,"_17855":102639,"_5":17750,"_24230":102521,"_2452":102640},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_2926":60607,"_25561":60556,"_17855":102642,"_5":17750,"_24230":102521,"_2452":102643},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_2926":60608,"_25561":60556,"_17855":102645,"_5":17750,"_24230":102521,"_2452":102646},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_2926":60609,"_25561":60609,"_5":12525,"_2452":102648,"_25885":102649,"_17855":102650,"_24230":60609},"Plataforma Lamassu IoT",[41651,99234],[],{"_2926":60610,"_25561":60609,"_17855":102652,"_5":17750,"_24230":60609,"_2452":102653},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_2926":60611,"_25561":60609,"_5":25882,"_17855":102655,"_24230":102656,"_2452":102146},[],"/docs/es/platform/overview#empieza-aquí",{"_2926":60612,"_25561":60609,"_5":25882,"_17855":102658,"_24230":102659,"_2452":102660},[],"/docs/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_2926":60613,"_25561":60609,"_5":25882,"_17855":102662,"_24230":102663,"_2452":102664},[],"/docs/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_2926":60614,"_25561":60609,"_5":25882,"_17855":102666,"_24230":102667,"_2452":102668},[],"/docs/es/platform/overview#capacidades-principales","Capacidades principales",{"_2926":60615,"_25561":60609,"_5":25882,"_17855":102670,"_24230":102671,"_2452":102672},[],"/docs/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_2926":60616,"_25561":60609,"_5":25882,"_17855":102674,"_24230":102675,"_2452":102676},[],"/docs/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_2926":60617,"_25561":60609,"_5":25882,"_17855":102678,"_24230":102679,"_2452":102680},[],"/docs/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_2926":60618,"_25561":60609,"_5":25882,"_17855":102682,"_24230":102683,"_2452":102684},[],"/docs/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_2926":60619,"_25561":60609,"_5":25882,"_17855":102686,"_24230":102687,"_2452":102688},[],"/docs/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_2926":60620,"_25561":60609,"_5":25882,"_17855":102690,"_24230":102691,"_2452":102692},[],"/docs/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_2926":60621,"_25561":60609,"_5":25882,"_17855":102694,"_24230":102695,"_2452":102696},[],"/docs/es/platform/overview#referencia-operativa","Referencia operativa",{"_2926":60622,"_25561":60609,"_17855":102698,"_5":17750,"_24230":60609,"_2452":102699},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_2926":60623,"_25561":60609,"_17855":102701,"_5":17750,"_24230":102656,"_2452":102702},[],"Elige el resultado que necesitas obtener:",{"_2926":60624,"_25561":60609,"_17855":102704,"_5":17750,"_24230":102656,"_2452":102705},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2926":60625,"_25561":60609,"_17855":102707,"_5":17750,"_24230":102656,"_2452":102708},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2926":60626,"_25561":60609,"_17855":102710,"_5":17750,"_24230":102656,"_2452":102711},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_2926":60627,"_25561":60609,"_17855":102713,"_5":17750,"_24230":102659,"_2452":102714},[],"Bloque",{"_2926":60628,"_25561":60609,"_17855":102716,"_5":17750,"_24230":102659,"_2452":102717},[],"Qué gestionas",{"_2926":60629,"_25561":60609,"_17855":102719,"_5":17750,"_24230":102659,"_2452":102720},[],"Punto de entrada",{"_2926":60630,"_25561":60609,"_17855":102722,"_5":17750,"_24230":102659,"_2452":46587},[],{"_2926":60631,"_25561":60609,"_17855":102724,"_5":17750,"_24230":102659,"_2452":102725},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_2926":60632,"_25561":60609,"_17855":102727,"_5":17750,"_24230":102659,"_2452":102728},[],"Visión general de PKI",{"_2926":60633,"_25561":60609,"_17855":102730,"_5":17750,"_24230":102659,"_2452":46596},[],{"_2926":60634,"_25561":60609,"_17855":102732,"_5":17750,"_24230":102659,"_2452":102733},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_2926":60635,"_25561":60609,"_17855":102735,"_5":17750,"_24230":102659,"_2452":102736},[],"Visión general de IoT Fleets",{"_2926":60636,"_25561":60609,"_17855":102738,"_5":17750,"_24230":102659,"_2452":102739},[],"**Administración**",{"_2926":60637,"_25561":60609,"_17855":102741,"_5":17750,"_24230":102659,"_2452":102742},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_2926":60638,"_25561":60609,"_17855":102744,"_5":17750,"_24230":102659,"_2452":99232},[],{"_2926":60639,"_25561":60609,"_17855":102746,"_5":17750,"_24230":102659,"_2452":102747},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_2926":60640,"_25561":60609,"_17855":102749,"_5":17750,"_24230":102663,"_2452":102750},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_2926":60641,"_25561":60609,"_17855":102752,"_5":17750,"_24230":102663,"_2452":102753},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_2926":60642,"_25561":60609,"_17855":102755,"_5":17750,"_24230":102663,"_2452":102756},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_2926":60643,"_25561":60609,"_17855":102758,"_5":17750,"_24230":102663,"_2452":102759},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_2926":60644,"_25561":60609,"_17855":102761,"_5":17750,"_24230":102663,"_2452":102762},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_2926":60645,"_25561":60609,"_17855":102764,"_5":17750,"_24230":102663,"_2452":102765},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_2926":60646,"_25561":60609,"_17855":102767,"_5":17750,"_24230":102671,"_2452":102768},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_2926":60647,"_25561":60609,"_17855":102770,"_5":17750,"_24230":102675,"_2452":102771},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_2926":60648,"_25561":60609,"_17855":102773,"_5":17750,"_24230":102679,"_2452":102774},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_2926":60649,"_25561":60609,"_17855":102776,"_5":17750,"_24230":102683,"_2452":102777},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_2926":60650,"_25561":60609,"_17855":102779,"_5":17750,"_24230":102687,"_2452":102780},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_2926":60651,"_25561":60609,"_17855":102782,"_5":17750,"_24230":102691,"_2452":102783},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_2926":60652,"_25561":60609,"_17855":102785,"_5":17750,"_24230":102695,"_2452":102239},[],{"_2926":60653,"_25561":60609,"_17855":102787,"_5":17750,"_24230":102695,"_2452":102788},[],"Qué prepara o comprueba",{"_2926":60654,"_25561":60609,"_17855":102790,"_5":17750,"_24230":102695,"_2452":102242},[],{"_2926":60655,"_25561":60609,"_17855":102792,"_5":17750,"_24230":102695,"_2452":102793},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_2926":60656,"_25561":60609,"_17855":102795,"_5":17750,"_24230":102695,"_2452":102796},[],"Administrador de la flota",{"_2926":60657,"_25561":60609,"_17855":102798,"_5":17750,"_24230":102695,"_2452":102799},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_2926":60658,"_25561":60609,"_17855":102801,"_5":17750,"_24230":102695,"_2452":102254},[],{"_2926":60659,"_25561":60609,"_17855":102803,"_5":17750,"_24230":102695,"_2452":102804},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_2926":60660,"_25561":60609,"_17855":102806,"_5":17750,"_24230":102695,"_2452":102260},[],{"_2926":60661,"_25561":60609,"_17855":102808,"_5":17750,"_24230":102695,"_2452":102809},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_2926":60662,"_25561":60609,"_17855":102811,"_5":17750,"_24230":102695,"_2452":102812},[],"Operador de infraestructura",{"_2926":60663,"_25561":60609,"_17855":102814,"_5":17750,"_24230":102695,"_2452":102815},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_2926":60664,"_25561":60609,"_17855":102817,"_5":17750,"_24230":102695,"_2452":102818},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_2926":60665,"_25561":60665,"_5":12525,"_2452":102820,"_25885":102821,"_17855":102823,"_24230":60665},"Jerarquía y rotación de CAs",[41651,99234,46688,102822],"Claves, autoridades y certificados",[],{"_2926":60666,"_25561":60665,"_17855":102825,"_5":17750,"_24230":60665,"_2452":102826},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_2926":60667,"_25561":60665,"_5":25882,"_17855":102828,"_24230":102829,"_2452":102830},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_2926":60668,"_25561":60665,"_5":25882,"_17855":102832,"_24230":102833,"_2452":102834},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_2926":60669,"_25561":60665,"_5":25882,"_17855":102836,"_24230":102837,"_2452":102838},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_2926":60670,"_25561":60665,"_5":25882,"_17855":102840,"_24230":102841,"_2452":102842},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_2926":60671,"_25561":60665,"_5":25882,"_17855":102844,"_24230":102845,"_2452":102846},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_2926":60672,"_25561":60665,"_5":25882,"_17855":102848,"_24230":102849,"_2452":102850},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_2926":60673,"_25561":60665,"_5":25882,"_17855":102852,"_24230":102853,"_2452":102854},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_2926":60674,"_25561":60665,"_5":25882,"_17855":102856,"_24230":102857,"_2452":102858},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_2926":60675,"_25561":60665,"_5":25882,"_17855":102860,"_24230":102861,"_2452":102862},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_2926":60676,"_25561":60665,"_5":25882,"_17855":102864,"_24230":102865,"_2452":102866},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_2926":60677,"_25561":60665,"_5":25882,"_17855":102868,"_24230":102869,"_2452":102870},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_2926":60678,"_25561":60665,"_5":25882,"_17855":102872,"_24230":102873,"_2452":102874},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_2926":60679,"_25561":60665,"_17855":102876,"_5":17750,"_24230":60665,"_2452":102877},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_2926":60680,"_25561":60665,"_17855":102879,"_5":17750,"_24230":60665,"_2452":102880},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_2926":60681,"_25561":60665,"_17855":102882,"_5":17750,"_24230":102829,"_2452":102883},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_2926":60682,"_25561":60665,"_17855":102885,"_5":17750,"_24230":102829,"_2452":102886},[],"entorno, como producción y preproducción;",{"_2926":60683,"_25561":60665,"_17855":102888,"_5":17750,"_24230":102829,"_2452":102889},[],"propietario o equipo operador;",{"_2926":60684,"_25561":60665,"_17855":102891,"_5":17750,"_24230":102829,"_2452":102892},[],"familia de dispositivos o proceso de fabricación;",{"_2926":60685,"_25561":60665,"_17855":102894,"_5":17750,"_24230":102829,"_2452":102895},[],"región o requisito regulatorio;",{"_2926":60686,"_25561":60665,"_17855":102897,"_5":17750,"_24230":102829,"_2452":102898},[],"motor criptográfico o política de clave;",{"_2926":60687,"_25561":60665,"_17855":102900,"_5":17750,"_24230":102829,"_2452":102901},[],"ventana de mantenimiento y ritmo de renovación.",{"_2926":60688,"_25561":60665,"_17855":102903,"_5":17750,"_24230":102829,"_2452":102904},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_2926":60689,"_25561":60665,"_17855":102906,"_5":17750,"_24230":102829,"_2452":102907},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_2926":60690,"_25561":60665,"_17855":102909,"_5":17750,"_24230":102833,"_2452":102910},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_2926":60691,"_25561":60665,"_17855":102912,"_5":17750,"_24230":102833,"_2452":102913},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_2926":60692,"_25561":60665,"_17855":102915,"_5":17750,"_24230":102833,"_2452":102916},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_2926":60693,"_25561":60665,"_17855":102918,"_5":17750,"_24230":102837,"_2452":102919},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_2926":60694,"_25561":60665,"_17855":102921,"_5":17750,"_24230":102837,"_2452":102922},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_2926":60695,"_25561":60665,"_17855":102924,"_5":17750,"_24230":102837,"_2452":102925},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_2926":60696,"_25561":60665,"_17855":102927,"_5":17750,"_24230":102837,"_2452":102928},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_2926":60697,"_25561":60665,"_17855":102930,"_5":17750,"_24230":102845,"_2452":102931},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_2926":60698,"_25561":60665,"_17855":102933,"_5":17750,"_24230":102849,"_2452":102934},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_2926":60699,"_25561":60665,"_17855":102936,"_5":17750,"_24230":102853,"_2452":102937},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_2926":60700,"_25561":60665,"_17855":102939,"_5":17750,"_24230":102857,"_2452":102940},[],"Actualiza la CA de enrolamiento y el perfil de los DMS y añade la CA anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS mientras sigan renovando cohortes con certificados antiguos. La guía DMS documenta ese ajuste.",{"_2926":60701,"_25561":60665,"_17855":102942,"_5":17750,"_24230":102861,"_2452":102943},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_2926":60702,"_25561":60665,"_17855":102945,"_5":17750,"_24230":102865,"_2452":102946},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión y de las CAs distribuidas. Revócala si la política lo exige.",{"_2926":60703,"_25561":60665,"_17855":102948,"_5":17750,"_24230":102869,"_2452":102949},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_2926":60704,"_25561":60665,"_17855":102951,"_5":17750,"_24230":102869,"_2452":102952},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_2926":60705,"_25561":60665,"_17855":102954,"_5":17750,"_24230":102869,"_2452":102955},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_2926":60706,"_25561":60665,"_17855":102957,"_5":17750,"_24230":102869,"_2452":102958},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_2926":60707,"_25561":60665,"_17855":102960,"_5":17750,"_24230":102873,"_2452":102961},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_2926":60708,"_25561":60665,"_17855":102963,"_5":17750,"_24230":102873,"_2452":102964},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_2926":60709,"_25561":60665,"_17855":102966,"_5":17750,"_24230":102873,"_2452":102967},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_2926":60710,"_25561":60665,"_17855":102969,"_5":17750,"_24230":102873,"_2452":102970},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_2926":60711,"_25561":60665,"_17855":102972,"_5":17750,"_24230":102873,"_2452":102973},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_2926":60712,"_25561":60665,"_17855":102975,"_5":17750,"_24230":102873,"_2452":102976},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_2926":60713,"_25561":60665,"_17855":102978,"_5":17750,"_24230":102873,"_2452":102979},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_2926":60714,"_25561":60714,"_5":12525,"_2452":102981,"_25885":102982,"_17855":102983,"_24230":60714},"Autoridades de certificación",[41651,99234,46688,102822],[],{"_2926":60715,"_25561":60714,"_17855":102985,"_5":17750,"_24230":60714,"_2452":102986},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_2926":60716,"_25561":60714,"_5":25882,"_17855":102988,"_24230":102989,"_2452":102990},[],"/docs/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_2926":60717,"_25561":60714,"_5":25882,"_17855":102992,"_24230":102993,"_2452":102994},[],"/docs/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_2926":60718,"_25561":60714,"_5":25882,"_17855":102996,"_24230":102997,"_2452":97935},[],"/docs/es/platform/pki/certificate-authorities#antes-de-empezar",{"_2926":60719,"_25561":60714,"_5":25882,"_17855":102999,"_24230":103000,"_2452":103001},[],"/docs/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_2926":60720,"_25561":60714,"_5":25882,"_17855":103003,"_24230":103004,"_2452":103005},[],"/docs/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_2926":60721,"_25561":60714,"_5":25882,"_17855":103007,"_24230":103008,"_2452":103009},[],"/docs/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_2926":60722,"_25561":60714,"_5":25882,"_17855":103011,"_24230":103012,"_2452":103013},[],"/docs/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_2926":60723,"_25561":60714,"_5":25882,"_17855":103015,"_24230":103016,"_2452":103017},[],"/docs/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_2926":60724,"_25561":60714,"_5":25882,"_17855":103019,"_24230":103020,"_2452":103021},[],"/docs/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_2926":60725,"_25561":60714,"_5":25882,"_17855":103023,"_24230":103024,"_2452":103025},[],"/docs/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_2926":60726,"_25561":60714,"_5":25882,"_17855":103027,"_24230":103028,"_2452":103029},[],"/docs/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_2926":60727,"_25561":60714,"_5":25882,"_17855":103031,"_24230":103032,"_2452":103033},[],"/docs/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_2926":60728,"_25561":60714,"_5":25882,"_17855":103035,"_24230":103036,"_2452":103037},[],"/docs/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_2926":60729,"_25561":60714,"_5":25882,"_17855":103039,"_24230":103040,"_2452":103041},[],"/docs/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_2926":60730,"_25561":60714,"_5":25882,"_17855":103043,"_24230":103044,"_2452":103045},[],"/docs/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_2926":60731,"_25561":60714,"_5":25882,"_17855":103047,"_24230":103048,"_2452":103049},[],"/docs/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_2926":60732,"_25561":60714,"_5":25882,"_17855":103051,"_24230":103052,"_2452":103053},[],"/docs/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_2926":60733,"_25561":60714,"_5":25882,"_17855":103055,"_24230":103056,"_2452":103057},[],"/docs/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_2926":60734,"_25561":60714,"_5":25882,"_17855":103059,"_24230":103060,"_2452":103061},[],"/docs/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_2926":60735,"_25561":60714,"_5":25882,"_17855":103063,"_24230":103064,"_2452":103065},[],"/docs/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_2926":60736,"_25561":60714,"_5":25882,"_17855":103067,"_24230":103068,"_2452":103069},[],"/docs/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_2926":60737,"_25561":60714,"_5":25882,"_17855":103071,"_24230":103072,"_2452":103073},[],"/docs/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_2926":60738,"_25561":60714,"_17855":103075,"_5":17750,"_24230":60714,"_2452":103076},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_2926":60739,"_25561":60714,"_17855":103078,"_5":17750,"_24230":60714,"_2452":103079},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_2926":60740,"_25561":60714,"_17855":103081,"_5":17750,"_24230":60714,"_2452":103082},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_2926":60741,"_25561":60714,"_17855":103084,"_5":17750,"_24230":102989,"_2452":103085},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_2926":60742,"_25561":60714,"_17855":103087,"_5":17750,"_24230":102989,"_2452":103088},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_2926":60743,"_25561":60714,"_17855":103090,"_5":17750,"_24230":102989,"_2452":103091},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_2926":60744,"_25561":60714,"_17855":103093,"_5":17750,"_24230":102989,"_2452":103094},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_2926":60745,"_25561":60714,"_17855":103096,"_5":17750,"_24230":102989,"_2452":103097},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_2926":60746,"_25561":60714,"_17855":103099,"_5":17750,"_24230":102997,"_2452":103100},[],"Decide si la CA será raíz o intermedia.",{"_2926":60747,"_25561":60714,"_17855":103102,"_5":17750,"_24230":102997,"_2452":103103},[],"Elige el motor que custodiará la clave.",{"_2926":60748,"_25561":60714,"_17855":103105,"_5":17750,"_24230":102997,"_2452":103106},[],"Define una validez superior a la de los certificados que emitirá.",{"_2926":60749,"_25561":60714,"_17855":103108,"_5":17750,"_24230":102997,"_2452":103109},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_2926":60750,"_25561":60714,"_17855":103111,"_5":17750,"_24230":103000,"_2452":103112},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_2926":60751,"_25561":60714,"_17855":103114,"_5":17750,"_24230":103004,"_2452":103115},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_2926":60752,"_25561":60714,"_17855":103117,"_5":17750,"_24230":103004,"_2452":103118},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_2926":60753,"_25561":60714,"_17855":103120,"_5":17750,"_24230":103008,"_2452":103121},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_2926":60754,"_25561":60714,"_17855":103123,"_5":17750,"_24230":103012,"_2452":103124},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_2926":60755,"_25561":60714,"_17855":103126,"_5":17750,"_24230":103012,"_2452":103127},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_2926":60756,"_25561":60714,"_17855":103129,"_5":17750,"_24230":103012,"_2452":103130},[],"`ST`: estado o provincia.",{"_2926":60757,"_25561":60714,"_17855":103132,"_5":17750,"_24230":103012,"_2452":103133},[],"`L`: localidad.",{"_2926":60758,"_25561":60714,"_17855":103135,"_5":17750,"_24230":103012,"_2452":103136},[],"`O`: organización.",{"_2926":60759,"_25561":60714,"_17855":103138,"_5":17750,"_24230":103012,"_2452":103139},[],"`OU`: unidad organizativa.",{"_2926":60760,"_25561":60714,"_17855":103141,"_5":17750,"_24230":103012,"_2452":103142},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_2926":60761,"_25561":60714,"_17855":103144,"_5":17750,"_24230":103016,"_2452":103145},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_2926":60762,"_25561":60714,"_17855":103147,"_5":17750,"_24230":103016,"_2452":103148},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_2926":60763,"_25561":60714,"_17855":103150,"_5":17750,"_24230":103020,"_2452":103151},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_2926":60764,"_25561":60714,"_17855":103153,"_5":17750,"_24230":103020,"_2452":103154},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_2926":60765,"_25561":60714,"_17855":103156,"_5":17750,"_24230":103024,"_2452":103157},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_2926":60766,"_25561":60714,"_17855":103159,"_5":17750,"_24230":103024,"_2452":103160},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_2926":60767,"_25561":60714,"_17855":103162,"_5":17750,"_24230":103028,"_2452":103163},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_2926":60768,"_25561":60714,"_17855":103165,"_5":17750,"_24230":103032,"_2452":103166},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_2926":60769,"_25561":60714,"_17855":103168,"_5":17750,"_24230":103036,"_2452":103169},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_2926":60770,"_25561":60714,"_17855":103171,"_5":17750,"_24230":103040,"_2452":103172},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_2926":60771,"_25561":60714,"_17855":103174,"_5":17750,"_24230":103044,"_2452":103175},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_2926":60772,"_25561":60714,"_17855":103177,"_5":17750,"_24230":103044,"_2452":103178},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_2926":60773,"_25561":60714,"_17855":103180,"_5":17750,"_24230":103048,"_2452":103181},[],"Abre una CA desde el inventario para consultar:",{"_2926":60774,"_25561":60714,"_17855":103183,"_5":17750,"_24230":103048,"_2452":103184},[],"Estado y periodo de validez.",{"_2926":60775,"_25561":60714,"_17855":103186,"_5":17750,"_24230":103048,"_2452":103187},[],"Certificado y cadena en formato PEM.",{"_2926":60776,"_25561":60714,"_17855":103189,"_5":17750,"_24230":103048,"_2452":103190},[],"Número de certificados activos, expirados y revocados.",{"_2926":60777,"_25561":60714,"_17855":103192,"_5":17750,"_24230":103048,"_2452":103193},[],"Certificados emitidos en **Issued Certificates**.",{"_2926":60778,"_25561":60714,"_17855":103195,"_5":17750,"_24230":103048,"_2452":103196},[],"CRL vinculada a la autoridad.",{"_2926":60779,"_25561":60714,"_17855":103198,"_5":17750,"_24230":103048,"_2452":103199},[],"Metadatos y motor criptográfico asociado.",{"_2926":60780,"_25561":60714,"_17855":103201,"_5":17750,"_24230":103048,"_2452":103202},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_2926":60781,"_25561":60714,"_17855":103204,"_5":17750,"_24230":103052,"_2452":103205},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_2926":60782,"_25561":60714,"_17855":103207,"_5":17750,"_24230":103052,"_2452":103208},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_2926":60783,"_25561":60714,"_17855":103210,"_5":17750,"_24230":103052,"_2452":103211},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_2926":60784,"_25561":60714,"_17855":103213,"_5":17750,"_24230":103052,"_2452":103214},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_2926":60785,"_25561":60714,"_17855":103216,"_5":17750,"_24230":103056,"_2452":103217},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_2926":60786,"_25561":60714,"_17855":103219,"_5":17750,"_24230":103060,"_2452":103220},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_2926":60787,"_25561":60714,"_17855":103222,"_5":17750,"_24230":103064,"_2452":103223},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_2926":60788,"_25561":60714,"_17855":103225,"_5":17750,"_24230":103068,"_2452":103226},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_2926":60789,"_25561":60714,"_17855":103228,"_5":17750,"_24230":103072,"_2452":103229},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_2926":60790,"_25561":60714,"_17855":103231,"_5":17750,"_24230":103072,"_2452":103232},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_2926":60791,"_25561":60791,"_5":12525,"_2452":103234,"_25885":103235,"_17855":103236,"_24230":60791},"Perfiles de certificado",[41651,99234,46688,102822],[],{"_2926":60792,"_25561":60791,"_17855":103238,"_5":17750,"_24230":60791,"_2452":103239},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_2926":60793,"_25561":60791,"_5":25882,"_17855":103241,"_24230":103242,"_2452":103243},[],"/docs/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_2926":60794,"_25561":60791,"_5":25882,"_17855":103245,"_24230":103246,"_2452":103247},[],"/docs/es/platform/pki/certificate-profiles#validez","Validez",{"_2926":60795,"_25561":60791,"_5":25882,"_17855":103249,"_24230":103250,"_2452":103251},[],"/docs/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_2926":60796,"_25561":60791,"_5":25882,"_17855":103253,"_24230":103254,"_2452":103255},[],"/docs/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_2926":60797,"_25561":60791,"_5":25882,"_17855":103257,"_24230":103258,"_2452":103259},[],"/docs/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_2926":60798,"_25561":60791,"_5":25882,"_17855":103261,"_24230":103262,"_2452":103263},[],"/docs/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_2926":60799,"_25561":60791,"_5":25882,"_17855":103265,"_24230":103266,"_2452":103267},[],"/docs/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_2926":60800,"_25561":60791,"_5":25882,"_17855":103269,"_24230":103270,"_2452":103271},[],"/docs/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_2926":60801,"_25561":60791,"_5":25882,"_17855":103273,"_24230":103274,"_2452":103275},[],"/docs/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_2926":60802,"_25561":60791,"_5":25882,"_17855":103277,"_24230":103278,"_2452":103279},[],"/docs/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_2926":60803,"_25561":60791,"_5":25882,"_17855":103281,"_24230":103282,"_2452":103283},[],"/docs/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_2926":60804,"_25561":60791,"_5":25882,"_17855":103285,"_24230":103286,"_2452":103287},[],"/docs/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_2926":60805,"_25561":60791,"_5":25882,"_17855":103289,"_24230":103290,"_2452":103291},[],"/docs/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_2926":60806,"_25561":60791,"_5":25882,"_17855":103293,"_24230":103294,"_2452":103295},[],"/docs/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_2926":60807,"_25561":60791,"_5":25882,"_17855":103297,"_24230":103298,"_2452":103299},[],"/docs/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_2926":60808,"_25561":60791,"_5":25882,"_17855":103301,"_24230":103302,"_2452":103303},[],"/docs/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_2926":60809,"_25561":60791,"_17855":103305,"_5":17750,"_24230":60791,"_2452":103306},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_2926":60810,"_25561":60791,"_17855":103308,"_5":17750,"_24230":60791,"_2452":103309},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_2926":60811,"_25561":60791,"_17855":103311,"_5":17750,"_24230":103246,"_2452":103312},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_2926":60812,"_25561":60791,"_17855":103314,"_5":17750,"_24230":103246,"_2452":103315},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_2926":60813,"_25561":60791,"_17855":103317,"_5":17750,"_24230":103250,"_2452":103318},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_2926":60814,"_25561":60791,"_17855":103320,"_5":17750,"_24230":103254,"_2452":103321},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_2926":60815,"_25561":60791,"_17855":103323,"_5":17750,"_24230":103254,"_2452":103324},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_2926":60816,"_25561":60791,"_17855":103326,"_5":17750,"_24230":103254,"_2452":103327},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_2926":60817,"_25561":60791,"_17855":103329,"_5":17750,"_24230":103258,"_2452":103330},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_2926":60818,"_25561":60791,"_17855":103332,"_5":17750,"_24230":103262,"_2452":103333},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_2926":60819,"_25561":60791,"_17855":103335,"_5":17750,"_24230":103262,"_2452":103336},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_2926":60820,"_25561":60791,"_17855":103338,"_5":17750,"_24230":103266,"_2452":103339},[],"La aplicación criptográfica puede:",{"_2926":60821,"_25561":60791,"_17855":103341,"_5":17750,"_24230":103266,"_2452":103342},[],"permitir o bloquear claves RSA;",{"_2926":60822,"_25561":60791,"_17855":103344,"_5":17750,"_24230":103266,"_2452":103345},[],"limitar los tamaños RSA admitidos;",{"_2926":60823,"_25561":60791,"_17855":103347,"_5":17750,"_24230":103266,"_2452":103348},[],"permitir o bloquear claves ECDSA;",{"_2926":60824,"_25561":60791,"_17855":103350,"_5":17750,"_24230":103266,"_2452":103351},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_2926":60825,"_25561":60791,"_17855":103353,"_5":17750,"_24230":103266,"_2452":103354},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_2926":60826,"_25561":60791,"_17855":103356,"_5":17750,"_24230":103270,"_2452":103357},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_2926":60827,"_25561":60791,"_17855":103359,"_5":17750,"_24230":103270,"_2452":99025},[],{"_2926":60828,"_25561":60791,"_17855":103361,"_5":17750,"_24230":103270,"_2452":103362},[],"Primera opción",{"_2926":60829,"_25561":60791,"_17855":103364,"_5":17750,"_24230":103270,"_2452":103365},[],"Segunda opción",{"_2926":60830,"_25561":60791,"_17855":103367,"_5":17750,"_24230":103270,"_2452":103368},[],"Si no hay ninguna",{"_2926":60831,"_25561":60791,"_17855":103370,"_5":17750,"_24230":103270,"_2452":103371},[],"Firma directa con una CA",{"_2926":60832,"_25561":60791,"_17855":103373,"_5":17750,"_24230":103270,"_2452":103374},[],"`issuance_profile` incluido en la solicitud",{"_2926":60833,"_25561":60791,"_17855":103376,"_5":17750,"_24230":103270,"_2452":103377},[],"`issuance_profile_id` de la solicitud",{"_2926":60834,"_25561":60791,"_17855":103379,"_5":17750,"_24230":103270,"_2452":103380},[],"Perfil predeterminado de la CA (`profile_id`).",{"_2926":60835,"_25561":60791,"_17855":103382,"_5":17750,"_24230":103270,"_2452":103383},[],"Emisión mediante DMS",{"_2926":60836,"_25561":60791,"_17855":103385,"_5":17750,"_24230":103270,"_2452":47253},[],{"_2926":60837,"_25561":60791,"_17855":103387,"_5":17750,"_24230":103270,"_2452":103388},[],"`settings.issuance_profile` incluido en el DMS",{"_2926":60838,"_25561":60791,"_17855":103390,"_5":17750,"_24230":103270,"_2452":103391},[],"Perfil predeterminado de la CA de enrolamiento.",{"_2926":60839,"_25561":60791,"_17855":103393,"_5":17750,"_24230":103270,"_2452":103394},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_2926":60840,"_25561":60791,"_17855":103396,"_5":17750,"_24230":103270,"_2452":103397},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_2926":60841,"_25561":60791,"_17855":103399,"_5":17750,"_24230":103278,"_2452":103400},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_2926":60842,"_25561":60791,"_17855":103402,"_5":17750,"_24230":103282,"_2452":103403},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_2926":60843,"_25561":60791,"_17855":103405,"_5":17750,"_24230":103286,"_2452":103406},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_2926":60844,"_25561":60791,"_17855":103408,"_5":17750,"_24230":103290,"_2452":103409},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_2926":60845,"_25561":60791,"_17855":103411,"_5":17750,"_24230":103294,"_2452":103412},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_2926":60846,"_25561":60791,"_17855":103414,"_5":17750,"_24230":103294,"_2452":103415},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_2926":60847,"_25561":60791,"_17855":103417,"_5":17750,"_24230":103298,"_2452":103418},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_2926":60848,"_25561":60791,"_17855":103420,"_5":17750,"_24230":103298,"_2452":103421},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_2926":60849,"_25561":60791,"_17855":103423,"_5":17750,"_24230":103298,"_2452":103424},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_2926":60850,"_25561":60791,"_17855":103426,"_5":17750,"_24230":103298,"_2452":103427},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_2926":60851,"_25561":60791,"_17855":103429,"_5":17750,"_24230":103302,"_2452":103430},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_2926":60852,"_25561":60791,"_17855":103432,"_5":17750,"_24230":103302,"_2452":103433},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_2926":60853,"_25561":60853,"_5":12525,"_2452":103435,"_25885":103436,"_17855":103438,"_24230":60853},"Validación de certificados",[41651,99234,46688,103437],"Validación",[],{"_2926":60854,"_25561":60853,"_17855":103440,"_5":17750,"_24230":60853,"_2452":103441},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_2926":60855,"_25561":60853,"_5":25882,"_17855":103443,"_24230":103444,"_2452":103445},[],"/docs/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_2926":60856,"_25561":60853,"_5":25882,"_17855":103447,"_24230":103448,"_2452":103449},[],"/docs/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_2926":60857,"_25561":60853,"_5":25882,"_17855":103451,"_24230":103452,"_2452":103453},[],"/docs/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_2926":60858,"_25561":60853,"_17855":103455,"_5":17750,"_24230":60853,"_2452":103456},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_2926":60859,"_25561":60853,"_17855":103458,"_5":17750,"_24230":103444,"_2452":103459},[],"Verifica estos criterios juntos:",{"_2926":60860,"_25561":60853,"_17855":103461,"_5":17750,"_24230":103444,"_2452":102449},[],{"_2926":60861,"_25561":60853,"_17855":103463,"_5":17750,"_24230":103444,"_2452":103464},[],"Resultado necesario",{"_2926":60862,"_25561":60853,"_17855":103466,"_5":17750,"_24230":103444,"_2452":103467},[],"Cadena y firma",{"_2926":60863,"_25561":60853,"_17855":103469,"_5":17750,"_24230":103444,"_2452":103470},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_2926":60864,"_25561":60853,"_17855":103472,"_5":17750,"_24230":103444,"_2452":103473},[],"Fechas",{"_2926":60865,"_25561":60853,"_17855":103475,"_5":17750,"_24230":103444,"_2452":103476},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_2926":60866,"_25561":60853,"_17855":103478,"_5":17750,"_24230":103444,"_2452":98938},[],{"_2926":60867,"_25561":60853,"_17855":103480,"_5":17750,"_24230":103444,"_2452":103481},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_2926":60868,"_25561":60853,"_17855":103483,"_5":17750,"_24230":103444,"_2452":103484},[],"Uso",{"_2926":60869,"_25561":60853,"_17855":103486,"_5":17750,"_24230":103444,"_2452":103487},[],"KU, EKU y restricciones permiten la operación concreta.",{"_2926":60870,"_25561":60853,"_17855":103489,"_5":17750,"_24230":103444,"_2452":103490},[],"Revocación",{"_2926":60871,"_25561":60853,"_17855":103492,"_5":17750,"_24230":103444,"_2452":103493},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_2926":60872,"_25561":60853,"_17855":103495,"_5":17750,"_24230":103444,"_2452":103496},[],"Autorización",{"_2926":60873,"_25561":60853,"_17855":103498,"_5":17750,"_24230":103444,"_2452":103499},[],"La aplicación permite la acción a esa identidad.",{"_2926":60874,"_25561":60853,"_17855":103501,"_5":17750,"_24230":103444,"_2452":103502},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_2926":60875,"_25561":60853,"_17855":103504,"_5":17750,"_24230":103448,"_2452":103505},[],"Mecanismo",{"_2926":60876,"_25561":60853,"_17855":103507,"_5":17750,"_24230":103448,"_2452":103508},[],"Cuándo utilizarlo",{"_2926":60877,"_25561":60853,"_17855":103510,"_5":17750,"_24230":103448,"_2452":103511},[],"Qué debes mantener",{"_2926":60878,"_25561":60853,"_17855":103513,"_5":17750,"_24230":103448,"_2452":47381},[],{"_2926":60879,"_25561":60853,"_17855":103515,"_5":17750,"_24230":103448,"_2452":103516},[],"Consulta del estado de un certificado concreto.",{"_2926":60880,"_25561":60853,"_17855":103518,"_5":17750,"_24230":103448,"_2452":103519},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_2926":60881,"_25561":60853,"_17855":103521,"_5":17750,"_24230":103448,"_2452":47390},[],{"_2926":60882,"_25561":60853,"_17855":103523,"_5":17750,"_24230":103448,"_2452":103524},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_2926":60883,"_25561":60853,"_17855":103526,"_5":17750,"_24230":103448,"_2452":103527},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_2926":60884,"_25561":60853,"_17855":103529,"_5":17750,"_24230":103448,"_2452":103530},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_2926":60885,"_25561":60853,"_17855":103532,"_5":17750,"_24230":103448,"_2452":103533},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_2926":60886,"_25561":60853,"_17855":103535,"_5":17750,"_24230":103452,"_2452":103536},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_2926":60887,"_25561":60853,"_17855":103538,"_5":17750,"_24230":103452,"_2452":103539},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_2926":60888,"_25561":60853,"_17855":103541,"_5":17750,"_24230":103452,"_2452":103542},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_2926":60889,"_25561":60853,"_17855":103544,"_5":17750,"_24230":103452,"_2452":103545},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_2926":60890,"_25561":60853,"_17855":103547,"_5":17750,"_24230":103452,"_2452":103548},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_2926":60891,"_25561":60853,"_17855":103550,"_5":17750,"_24230":103452,"_2452":103551},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_2926":60892,"_25561":60853,"_17855":103553,"_5":17750,"_24230":103452,"_2452":103554},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_2926":60893,"_25561":60853,"_17855":103556,"_5":17750,"_24230":103452,"_2452":103557},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_2926":60894,"_25561":60853,"_17855":103559,"_5":17750,"_24230":103452,"_2452":103560},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_2926":60895,"_25561":60895,"_5":12525,"_2452":103562,"_25885":103563,"_17855":103564,"_24230":60895},"Certificados",[41651,99234,46688,102822],[],{"_2926":60896,"_25561":60895,"_17855":103566,"_5":17750,"_24230":60895,"_2452":103567},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_2926":60897,"_25561":60895,"_5":25882,"_17855":103569,"_24230":103570,"_2452":103571},[],"/docs/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_2926":60898,"_25561":60895,"_5":25882,"_17855":103573,"_24230":103574,"_2452":103575},[],"/docs/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_2926":60899,"_25561":60895,"_5":25882,"_17855":103577,"_24230":103578,"_2452":103579},[],"/docs/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_2926":60900,"_25561":60895,"_5":25882,"_17855":103581,"_24230":103582,"_2452":103583},[],"/docs/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_2926":60901,"_25561":60895,"_5":25882,"_17855":103585,"_24230":103586,"_2452":103587},[],"/docs/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_2926":60902,"_25561":60895,"_5":25882,"_17855":103589,"_24230":103590,"_2452":103591},[],"/docs/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_2926":60903,"_25561":60895,"_5":25882,"_17855":103593,"_24230":103594,"_2452":103595},[],"/docs/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_2926":60904,"_25561":60895,"_5":25882,"_17855":103597,"_24230":103598,"_2452":103599},[],"/docs/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_2926":60905,"_25561":60895,"_5":25882,"_17855":103601,"_24230":103602,"_2452":103603},[],"/docs/es/platform/pki/certificates#continúa","Continúa",{"_2926":60906,"_25561":60895,"_17855":103605,"_5":17750,"_24230":60895,"_2452":103606},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_2926":60907,"_25561":60895,"_17855":103608,"_5":17750,"_24230":103570,"_2452":103609},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_2926":60908,"_25561":60895,"_17855":103611,"_5":17750,"_24230":103570,"_2452":103612},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_2926":60909,"_25561":60895,"_17855":103614,"_5":17750,"_24230":103574,"_2452":103615},[],"Descarga el PEM e inspecciónalo:",{"_2926":60910,"_25561":60895,"_17855":103617,"_5":17750,"_24230":103574,"_2452":103618},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_2926":60911,"_25561":60895,"_17855":103620,"_5":17750,"_24230":103578,"_2452":103621},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_2926":60912,"_25561":60895,"_17855":103623,"_5":17750,"_24230":103578,"_2452":103624},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_2926":60913,"_25561":60895,"_17855":103626,"_5":17750,"_24230":103578,"_2452":103627},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_2926":60914,"_25561":60895,"_17855":103629,"_5":17750,"_24230":103578,"_2452":103630},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_2926":60915,"_25561":60895,"_17855":103632,"_5":17750,"_24230":103578,"_2452":103633},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_2926":60916,"_25561":60895,"_17855":103635,"_5":17750,"_24230":103578,"_2452":103636},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_2926":60917,"_25561":60895,"_17855":103638,"_5":17750,"_24230":103578,"_2452":103639},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_2926":60918,"_25561":60895,"_17855":103641,"_5":17750,"_24230":103582,"_2452":103642},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_2926":60919,"_25561":60895,"_17855":103644,"_5":17750,"_24230":103586,"_2452":103645},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_2926":60920,"_25561":60895,"_17855":103647,"_5":17750,"_24230":103590,"_2452":103648},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_2926":60921,"_25561":60895,"_17855":103650,"_5":17750,"_24230":103594,"_2452":103651},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_2926":60922,"_25561":60895,"_17855":103653,"_5":17750,"_24230":103594,"_2452":103654},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_2926":60923,"_25561":60895,"_17855":103656,"_5":17750,"_24230":103594,"_2452":103657},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_2926":60924,"_25561":60895,"_17855":103659,"_5":17750,"_24230":103598,"_2452":103660},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_2926":60925,"_25561":60895,"_17855":103662,"_5":17750,"_24230":103598,"_2452":103663},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_2926":60926,"_25561":60895,"_17855":103665,"_5":17750,"_24230":103598,"_2452":103666},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_2926":60927,"_25561":60895,"_17855":103668,"_5":17750,"_24230":103602,"_2452":103669},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_2926":60928,"_25561":60895,"_17855":103671,"_5":17750,"_24230":103602,"_2452":103672},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_2926":60929,"_25561":60929,"_5":12525,"_2452":103674,"_25885":103675,"_17855":103677,"_24230":60929},"Ciclo de vida de un certificado",[41651,99234,46688,103676],"Conceptos",[],{"_2926":60930,"_25561":60929,"_17855":103679,"_5":17750,"_24230":60929,"_2452":103680},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_2926":60931,"_25561":60929,"_5":25882,"_17855":103682,"_24230":103683,"_2452":103684},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_2926":60932,"_25561":60929,"_5":25882,"_17855":103686,"_24230":103687,"_2452":103688},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_2926":60933,"_25561":60929,"_5":25882,"_17855":103690,"_24230":103691,"_2452":103692},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_2926":60934,"_25561":60929,"_5":25882,"_17855":103694,"_24230":103695,"_2452":103696},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_2926":60935,"_25561":60929,"_5":25882,"_17855":103698,"_24230":103699,"_2452":103700},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_2926":60936,"_25561":60929,"_5":25882,"_17855":103702,"_24230":103703,"_2452":103704},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_2926":60937,"_25561":60929,"_5":25882,"_17855":103706,"_24230":103707,"_2452":103708},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_2926":60938,"_25561":60929,"_5":25882,"_17855":103710,"_24230":103711,"_2452":103712},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_2926":60939,"_25561":60929,"_5":25882,"_17855":103714,"_24230":103715,"_2452":103716},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_2926":60940,"_25561":60929,"_5":25882,"_17855":103718,"_24230":103719,"_2452":103720},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_2926":60941,"_25561":60929,"_17855":103722,"_5":17750,"_24230":60929,"_2452":103723},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_2926":60942,"_25561":60929,"_17855":103725,"_5":17750,"_24230":103687,"_2452":103726},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_2926":60943,"_25561":60929,"_17855":103728,"_5":17750,"_24230":103691,"_2452":103729},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_2926":60944,"_25561":60929,"_17855":103731,"_5":17750,"_24230":103695,"_2452":103732},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_2926":60945,"_25561":60929,"_17855":103734,"_5":17750,"_24230":103699,"_2452":103735},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_2926":60946,"_25561":60929,"_17855":103737,"_5":17750,"_24230":103703,"_2452":103738},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_2926":60947,"_25561":60929,"_17855":103740,"_5":17750,"_24230":103707,"_2452":103741},[],"Lamassu persiste cuatro estados X.509:",{"_2926":60948,"_25561":60929,"_17855":103743,"_5":17750,"_24230":103707,"_2452":103744},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_2926":60949,"_25561":60929,"_17855":103746,"_5":17750,"_24230":103707,"_2452":103747},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_2926":60950,"_25561":60929,"_17855":103749,"_5":17750,"_24230":103707,"_2452":103750},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_2926":60951,"_25561":60929,"_17855":103752,"_5":17750,"_24230":103707,"_2452":103753},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_2926":60952,"_25561":60929,"_17855":103755,"_5":17750,"_24230":103707,"_2452":103756},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_2926":60953,"_25561":60929,"_17855":103758,"_5":17750,"_24230":103711,"_2452":103759},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_2926":60954,"_25561":60929,"_17855":103761,"_5":17750,"_24230":103711,"_2452":103762},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_2926":60955,"_25561":60929,"_17855":103764,"_5":17750,"_24230":103711,"_2452":103765},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_2926":60956,"_25561":60929,"_17855":103767,"_5":17750,"_24230":103715,"_2452":103768},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_2926":60957,"_25561":60929,"_17855":103770,"_5":17750,"_24230":103715,"_2452":103771},[],"Antes de confirmar:",{"_2926":60958,"_25561":60929,"_17855":103773,"_5":17750,"_24230":103715,"_2452":103774},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_2926":60959,"_25561":60929,"_17855":103776,"_5":17750,"_24230":103715,"_2452":103777},[],"Distribuye la nueva cadena de confianza.",{"_2926":60960,"_25561":60929,"_17855":103779,"_5":17750,"_24230":103715,"_2452":103780},[],"Reemite las identidades necesarias.",{"_2926":60961,"_25561":60929,"_17855":103782,"_5":17750,"_24230":103715,"_2452":103783},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_2926":60962,"_25561":60929,"_17855":103785,"_5":17750,"_24230":103715,"_2452":103786},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_2926":60963,"_25561":60929,"_17855":103788,"_5":17750,"_24230":103715,"_2452":103789},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_2926":60964,"_25561":60929,"_17855":103791,"_5":17750,"_24230":103719,"_2452":103792},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_2926":60965,"_25561":60929,"_17855":103794,"_5":17750,"_24230":103719,"_2452":103795},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_2926":60966,"_25561":60929,"_17855":103797,"_5":17750,"_24230":103719,"_2452":103798},[],"Cambios de estado y razones de revocación.",{"_2926":60967,"_25561":60929,"_17855":103800,"_5":17750,"_24230":103719,"_2452":103801},[],"Publicación y vigencia de OCSP y CRLs.",{"_2926":60968,"_25561":60929,"_17855":103803,"_5":17750,"_24230":103719,"_2452":103804},[],"Dependencias que todavía presentan un certificado sustituido.",{"_2926":60969,"_25561":60929,"_17855":103806,"_5":17750,"_24230":103719,"_2452":103807},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_2926":60970,"_25561":60970,"_5":12525,"_2452":103809,"_25885":103810,"_17855":103811,"_24230":60970},"Modelo de confianza",[41651,99234,46688,103676],[],{"_2926":60971,"_25561":60970,"_17855":103813,"_5":17750,"_24230":60970,"_2452":103814},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_2926":60972,"_25561":60970,"_5":25882,"_17855":103816,"_24230":103817,"_2452":103818},[],"/docs/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_2926":60973,"_25561":60970,"_5":25882,"_17855":103820,"_24230":103821,"_2452":103822},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_2926":60974,"_25561":60970,"_5":25882,"_17855":103824,"_24230":103825,"_2452":103826},[],"/docs/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_2926":60975,"_25561":60970,"_5":25882,"_17855":103828,"_24230":103829,"_2452":103830},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_2926":60976,"_25561":60970,"_5":25882,"_17855":103832,"_24230":103833,"_2452":103834},[],"/docs/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_2926":60977,"_25561":60970,"_5":25882,"_17855":103836,"_24230":103837,"_2452":103838},[],"/docs/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_2926":60978,"_25561":60970,"_5":25882,"_17855":103840,"_24230":103841,"_2452":103842},[],"/docs/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_2926":60979,"_25561":60970,"_5":25882,"_17855":103844,"_24230":103845,"_2452":103846},[],"/docs/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_2926":60980,"_25561":60970,"_5":25882,"_17855":103848,"_24230":103849,"_2452":103850},[],"/docs/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_2926":60981,"_25561":60970,"_5":25882,"_17855":103852,"_24230":103853,"_2452":103854},[],"/docs/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_2926":60982,"_25561":60970,"_17855":103856,"_5":17750,"_24230":60970,"_2452":103857},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_2926":60983,"_25561":60970,"_17855":103859,"_5":17750,"_24230":103821,"_2452":103860},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_2926":60984,"_25561":60970,"_17855":103862,"_5":17750,"_24230":103825,"_2452":103863},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_2926":60985,"_25561":60970,"_17855":103865,"_5":17750,"_24230":103829,"_2452":103866},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_2926":60986,"_25561":60970,"_17855":103868,"_5":17750,"_24230":103833,"_2452":103869},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_2926":60987,"_25561":60970,"_17855":103871,"_5":17750,"_24230":103837,"_2452":103872},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_2926":60988,"_25561":60970,"_17855":103874,"_5":17750,"_24230":103837,"_2452":103875},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_2926":60989,"_25561":60970,"_17855":103877,"_5":17750,"_24230":103837,"_2452":103878},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_2926":60990,"_25561":60970,"_17855":103880,"_5":17750,"_24230":103837,"_2452":103881},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_2926":60991,"_25561":60970,"_17855":103883,"_5":17750,"_24230":103837,"_2452":103884},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_2926":60992,"_25561":60970,"_17855":103886,"_5":17750,"_24230":103837,"_2452":103887},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_2926":60993,"_25561":60970,"_17855":103889,"_5":17750,"_24230":103841,"_2452":103890},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_2926":60994,"_25561":60970,"_17855":103892,"_5":17750,"_24230":103841,"_2452":103893},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_2926":60995,"_25561":60970,"_17855":103895,"_5":17750,"_24230":103841,"_2452":103896},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, Lamassu prueba primero la CA de enrolamiento y después las CAs de validación configuradas en el bloque de re-enrolamiento.",{"_2926":60996,"_25561":60970,"_17855":103898,"_5":17750,"_24230":103841,"_2452":103899},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_2926":60997,"_25561":60970,"_17855":103901,"_5":17750,"_24230":103841,"_2452":103902},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_2926":60998,"_25561":60970,"_17855":103904,"_5":17750,"_24230":103845,"_2452":103905},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_2926":60999,"_25561":60970,"_17855":103907,"_5":17750,"_24230":103845,"_2452":103908},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_2926":61000,"_25561":60970,"_17855":103910,"_5":17750,"_24230":103845,"_2452":103911},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_2926":61001,"_25561":60970,"_17855":103913,"_5":17750,"_24230":103845,"_2452":103914},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_2926":61002,"_25561":60970,"_17855":103916,"_5":17750,"_24230":103845,"_2452":103917},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_2926":61003,"_25561":60970,"_17855":103919,"_5":17750,"_24230":103845,"_2452":103920},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_2926":61004,"_25561":60970,"_17855":103922,"_5":17750,"_24230":103845,"_2452":103923},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_2926":61005,"_25561":60970,"_17855":103925,"_5":17750,"_24230":103849,"_2452":103926},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_2926":61006,"_25561":60970,"_17855":103928,"_5":17750,"_24230":103853,"_2452":103929},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_2926":61007,"_25561":60970,"_17855":103931,"_5":17750,"_24230":103853,"_2452":103932},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_2926":61008,"_25561":60970,"_17855":103934,"_5":17750,"_24230":103853,"_2452":103935},[],"Asigna perfiles explícitos a cada caso de uso.",{"_2926":61009,"_25561":60970,"_17855":103937,"_5":17750,"_24230":103853,"_2452":103938},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_2926":61010,"_25561":60970,"_17855":103940,"_5":17750,"_24230":103853,"_2452":103941},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_2926":61011,"_25561":60970,"_17855":103943,"_5":17750,"_24230":103853,"_2452":103944},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_2926":61012,"_25561":60970,"_17855":103946,"_5":17750,"_24230":103853,"_2452":103947},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_2926":61013,"_25561":61013,"_5":12525,"_2452":103949,"_25885":103950,"_17855":103951,"_24230":61013},"Listas de revocación (CRL)",[41651,99234,46688,103437],[],{"_2926":61014,"_25561":61013,"_17855":103953,"_5":17750,"_24230":61013,"_2452":103954},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_2926":61015,"_25561":61013,"_5":25882,"_17855":103956,"_24230":103957,"_2452":103958},[],"/docs/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_2926":61016,"_25561":61013,"_5":25882,"_17855":103960,"_24230":103961,"_2452":103962},[],"/docs/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_2926":61017,"_25561":61013,"_5":25882,"_17855":103964,"_24230":103965,"_2452":103966},[],"/docs/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_2926":61018,"_25561":61013,"_5":25882,"_17855":103968,"_24230":103969,"_2452":103970},[],"/docs/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_2926":61019,"_25561":61013,"_5":25882,"_17855":103972,"_24230":103973,"_2452":103974},[],"/docs/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_2926":61020,"_25561":61013,"_5":25882,"_17855":103976,"_24230":103977,"_2452":103978},[],"/docs/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_2926":61021,"_25561":61013,"_5":25882,"_17855":103980,"_24230":103981,"_2452":103982},[],"/docs/es/platform/pki/crl#referencias","Referencias",{"_2926":61022,"_25561":61013,"_17855":103984,"_5":17750,"_24230":61013,"_2452":103985},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_2926":61023,"_25561":61013,"_17855":103987,"_5":17750,"_24230":103957,"_2452":103988},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_2926":61024,"_25561":61013,"_17855":103990,"_5":17750,"_24230":103957,"_2452":103991},[],"Campo de `crl_options`",{"_2926":61025,"_25561":61013,"_17855":103993,"_5":17750,"_24230":103957,"_2452":100730},[],{"_2926":61026,"_25561":61013,"_17855":103995,"_5":17750,"_24230":103957,"_2452":103996},[],"Valor inicial del backend",{"_2926":61027,"_25561":61013,"_17855":103998,"_5":17750,"_24230":103957,"_2452":47868},[],{"_2926":61028,"_25561":61013,"_17855":104000,"_5":17750,"_24230":103957,"_2452":104001},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_2926":61029,"_25561":61013,"_17855":104003,"_5":17750,"_24230":103957,"_2452":104004},[],"7 días.",{"_2926":61030,"_25561":61013,"_17855":104006,"_5":17750,"_24230":103957,"_2452":47877},[],{"_2926":61031,"_25561":61013,"_17855":104008,"_5":17750,"_24230":103957,"_2452":104009},[],"Plazo desde la publicación que activa la renovación programada.",{"_2926":61032,"_25561":61013,"_17855":104011,"_5":17750,"_24230":103957,"_2452":104012},[],"6 días y 23 horas.",{"_2926":61033,"_25561":61013,"_17855":104014,"_5":17750,"_24230":103957,"_2452":47886},[],{"_2926":61034,"_25561":61013,"_17855":104016,"_5":17750,"_24230":103957,"_2452":104017},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_2926":61035,"_25561":61013,"_17855":104019,"_5":17750,"_24230":103957,"_2452":47892},[],{"_2926":61036,"_25561":61013,"_17855":104021,"_5":17750,"_24230":103957,"_2452":47895},[],{"_2926":61037,"_25561":61013,"_17855":104023,"_5":17750,"_24230":103957,"_2452":104024},[],"Campo de configuración inicializado con el SKI de la CA.",{"_2926":61038,"_25561":61013,"_17855":104026,"_5":17750,"_24230":103957,"_2452":104027},[],"SKI de la CA.",{"_2926":61039,"_25561":61013,"_17855":104029,"_5":17750,"_24230":103957,"_2452":104030},[],"El generador utiliza la clave de la CA identificada por el SKI solicitado. No interpretes `subject_key_id_signer` como soporte verificado de una CA delegada distinta: cambiar el campo no cambia el firmante en ese flujo.",{"_2926":61040,"_25561":61013,"_17855":104032,"_5":17750,"_24230":103957,"_2452":104033},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_2926":61041,"_25561":61013,"_17855":104035,"_5":17750,"_24230":103961,"_2452":104036},[],"El trabajo programado solicita otra lista cuando se alcanza `refresh_interval` o cuando la lista está próxima a vencer según el periodo de vigilancia configurado. Esto depende de que el trabajo, almacenamiento y firma funcionen; no garantiza renovación ante un fallo del servicio.",{"_2926":61042,"_25561":61013,"_17855":104038,"_5":17750,"_24230":103961,"_2452":104039},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_2926":61043,"_25561":61013,"_17855":104041,"_5":17750,"_24230":103961,"_2452":104042},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_2926":61044,"_25561":61013,"_17855":104044,"_5":17750,"_24230":103965,"_2452":104045},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_2926":61045,"_25561":61013,"_17855":104047,"_5":17750,"_24230":103965,"_2452":104048},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_2926":61046,"_25561":61013,"_17855":104050,"_5":17750,"_24230":103969,"_2452":104051},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_2926":61047,"_25561":61013,"_17855":104053,"_5":17750,"_24230":103969,"_2452":104054},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_2926":61048,"_25561":61013,"_17855":104056,"_5":17750,"_24230":103969,"_2452":104057},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_2926":61049,"_25561":61013,"_17855":104059,"_5":17750,"_24230":103969,"_2452":104060},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_2926":61050,"_25561":61013,"_17855":104062,"_5":17750,"_24230":103969,"_2452":104063},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_2926":61051,"_25561":61013,"_17855":104065,"_5":17750,"_24230":103973,"_2452":104066},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_2926":61052,"_25561":61013,"_17855":104068,"_5":17750,"_24230":103973,"_2452":100919},[],{"_2926":61053,"_25561":61013,"_17855":104070,"_5":17750,"_24230":103973,"_2452":104071},[],"Path relativo",{"_2926":61054,"_25561":61013,"_17855":104073,"_5":17750,"_24230":103973,"_2452":99025},[],{"_2926":61055,"_25561":61013,"_17855":104075,"_5":17750,"_24230":103973,"_2452":47950},[],{"_2926":61056,"_25561":61013,"_17855":104077,"_5":17750,"_24230":103973,"_2452":47953},[],{"_2926":61057,"_25561":61013,"_17855":104079,"_5":17750,"_24230":103973,"_2452":104080},[],"Consultar `crl_options` y `latest_crl`.",{"_2926":61058,"_25561":61013,"_17855":104082,"_5":17750,"_24230":103973,"_2452":47959},[],{"_2926":61059,"_25561":61013,"_17855":104084,"_5":17750,"_24230":103973,"_2452":47953},[],{"_2926":61060,"_25561":61013,"_17855":104086,"_5":17750,"_24230":103973,"_2452":104087},[],"Sustituir la configuración de CRL.",{"_2926":61061,"_25561":61013,"_17855":104089,"_5":17750,"_24230":103973,"_2452":104090},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_2926":61062,"_25561":61013,"_17855":104092,"_5":17750,"_24230":103973,"_2452":104093},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_2926":61063,"_25561":61013,"_17855":104095,"_5":17750,"_24230":103977,"_2452":104096},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_2926":61064,"_25561":61013,"_17855":104098,"_5":17750,"_24230":103981,"_2452":104099},[],"RFC 5280: perfil X.509 y CRL.",{"_2926":61065,"_25561":61013,"_17855":104101,"_5":17750,"_24230":103981,"_2452":47979},[],{"_2926":61066,"_25561":61013,"_17855":104103,"_5":17750,"_24230":103981,"_2452":47982},[],{"_2926":61067,"_25561":61013,"_17855":104105,"_5":17750,"_24230":103981,"_2452":104106},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_2926":61068,"_25561":61013,"_17855":104108,"_5":17750,"_24230":103981,"_2452":104109},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2926":61069,"_25561":61069,"_5":12525,"_2452":104111,"_25885":104112,"_17855":104113,"_24230":61069},"Claves y motores criptográficos",[41651,99234,46688,102822],[],{"_2926":61070,"_25561":61069,"_17855":104115,"_5":17750,"_24230":61069,"_2452":104116},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_2926":61071,"_25561":61069,"_5":25882,"_17855":104118,"_24230":104119,"_2452":104120},[],"/docs/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_2926":61072,"_25561":61069,"_5":25882,"_17855":104122,"_24230":104123,"_2452":104124},[],"/docs/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_2926":61073,"_25561":61069,"_5":25882,"_17855":104126,"_24230":104127,"_2452":48007},[],"/docs/es/platform/pki/key-management#file-system",{"_2926":61074,"_25561":61069,"_5":25882,"_17855":104129,"_24230":104130,"_2452":48011},[],"/docs/es/platform/pki/key-management#hashicorp-vault",{"_2926":61075,"_25561":61069,"_5":25882,"_17855":104132,"_24230":104133,"_2452":48015},[],"/docs/es/platform/pki/key-management#aws-secrets-manager",{"_2926":61076,"_25561":61069,"_5":25882,"_17855":104135,"_24230":104136,"_2452":48019},[],"/docs/es/platform/pki/key-management#aws-kms",{"_2926":61077,"_25561":61069,"_5":25882,"_17855":104138,"_24230":104139,"_2452":48023},[],"/docs/es/platform/pki/key-management#pkcs11",{"_2926":61078,"_25561":61069,"_5":25882,"_17855":104141,"_24230":104142,"_2452":48027},[],"/docs/es/platform/pki/key-management#azure-key-vault",{"_2926":61079,"_25561":61069,"_5":25882,"_17855":104144,"_24230":104145,"_2452":104146},[],"/docs/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_2926":61080,"_25561":61069,"_5":25882,"_17855":104148,"_24230":104149,"_2452":104150},[],"/docs/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_2926":61081,"_25561":61069,"_5":25882,"_17855":104152,"_24230":104153,"_2452":104154},[],"/docs/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_2926":61082,"_25561":61069,"_5":25882,"_17855":104156,"_24230":104157,"_2452":104158},[],"/docs/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_2926":61083,"_25561":61069,"_5":25882,"_17855":104160,"_24230":104161,"_2452":104162},[],"/docs/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_2926":61084,"_25561":61069,"_5":25882,"_17855":104164,"_24230":104165,"_2452":104166},[],"/docs/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_2926":61085,"_25561":61069,"_5":25882,"_17855":104168,"_24230":104169,"_2452":104170},[],"/docs/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_2926":61086,"_25561":61069,"_5":25882,"_17855":104172,"_24230":104173,"_2452":48059},[],"/docs/es/platform/pki/key-management#sign",{"_2926":61087,"_25561":61069,"_5":25882,"_17855":104175,"_24230":104176,"_2452":48063},[],"/docs/es/platform/pki/key-management#verify",{"_2926":61088,"_25561":61069,"_5":25882,"_17855":104178,"_24230":104179,"_2452":104180},[],"/docs/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_2926":61089,"_25561":61069,"_5":25882,"_17855":104182,"_24230":104183,"_2452":104184},[],"/docs/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_2926":61090,"_25561":61069,"_5":25882,"_17855":104186,"_24230":104187,"_2452":104188},[],"/docs/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_2926":61091,"_25561":61069,"_17855":104190,"_5":17750,"_24230":61069,"_2452":104191},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_2926":61092,"_25561":61069,"_17855":104193,"_5":17750,"_24230":61069,"_2452":104194},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_2926":61093,"_25561":61069,"_17855":104196,"_5":17750,"_24230":104119,"_2452":104197},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_2926":61094,"_25561":61069,"_17855":104199,"_5":17750,"_24230":104119,"_2452":104200},[],"En la práctica, permite:",{"_2926":61095,"_25561":61069,"_17855":104202,"_5":17750,"_24230":104119,"_2452":104203},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_2926":61096,"_25561":61069,"_17855":104205,"_5":17750,"_24230":104119,"_2452":104206},[],"Importar claves creadas externamente.",{"_2926":61097,"_25561":61069,"_17855":104208,"_5":17750,"_24230":104119,"_2452":104209},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_2926":61098,"_25561":61069,"_17855":104211,"_5":17750,"_24230":104119,"_2452":104212},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_2926":61099,"_25561":61069,"_17855":104214,"_5":17750,"_24230":104123,"_2452":104215},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_2926":61100,"_25561":61069,"_17855":104217,"_5":17750,"_24230":104123,"_2452":104218},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_2926":61101,"_25561":61069,"_17855":104220,"_5":17750,"_24230":104123,"_2452":104221},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_2926":61102,"_25561":61069,"_17855":104223,"_5":17750,"_24230":104127,"_2452":104224},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_2926":61103,"_25561":61069,"_17855":104226,"_5":17750,"_24230":104130,"_2452":104227},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_2926":61104,"_25561":61069,"_17855":104229,"_5":17750,"_24230":104133,"_2452":104230},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_2926":61105,"_25561":61069,"_17855":104232,"_5":17750,"_24230":104136,"_2452":104233},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_2926":61106,"_25561":61069,"_17855":104235,"_5":17750,"_24230":104139,"_2452":104236},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_2926":61107,"_25561":61069,"_17855":104238,"_5":17750,"_24230":104142,"_2452":104239},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_2926":61108,"_25561":61069,"_17855":104241,"_5":17750,"_24230":104142,"_2452":104242},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_2926":61109,"_25561":61069,"_17855":104244,"_5":17750,"_24230":104142,"_2452":104245},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_2926":61110,"_25561":61069,"_17855":104247,"_5":17750,"_24230":104142,"_2452":104248},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_2926":61111,"_25561":61069,"_17855":104250,"_5":17750,"_24230":104145,"_2452":104251},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_2926":61112,"_25561":61069,"_17855":104253,"_5":17750,"_24230":104145,"_2452":104254},[],"La tabla incluye los siguientes campos:",{"_2926":61113,"_25561":61069,"_17855":104256,"_5":17750,"_24230":104145,"_2452":104257},[],"**Name**: nombre descriptivo de la clave.",{"_2926":61114,"_25561":61069,"_17855":104259,"_5":17750,"_24230":104145,"_2452":104260},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_2926":61115,"_25561":61069,"_17855":104262,"_5":17750,"_24230":104145,"_2452":104263},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_2926":61116,"_25561":61069,"_17855":104265,"_5":17750,"_24230":104145,"_2452":104266},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_2926":61117,"_25561":61069,"_17855":104268,"_5":17750,"_24230":104145,"_2452":104269},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_2926":61118,"_25561":61069,"_17855":104271,"_5":17750,"_24230":104145,"_2452":104272},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_2926":61119,"_25561":61069,"_17855":104274,"_5":17750,"_24230":104145,"_2452":104275},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_2926":61120,"_25561":61069,"_17855":104277,"_5":17750,"_24230":104145,"_2452":104278},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_2926":61121,"_25561":61069,"_17855":104280,"_5":17750,"_24230":104145,"_2452":104281},[],"Desde esta vista también se accede a las acciones más habituales:",{"_2926":61122,"_25561":61069,"_17855":104283,"_5":17750,"_24230":104145,"_2452":104284},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_2926":61123,"_25561":61069,"_17855":104286,"_5":17750,"_24230":104145,"_2452":104287},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_2926":61124,"_25561":61069,"_17855":104289,"_5":17750,"_24230":104145,"_2452":104290},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_2926":61125,"_25561":61069,"_17855":104292,"_5":17750,"_24230":104145,"_2452":104293},[],"**Delete Key** para eliminar la clave del sistema.",{"_2926":61126,"_25561":61069,"_17855":104295,"_5":17750,"_24230":104149,"_2452":104296},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_2926":61127,"_25561":61069,"_17855":104298,"_5":17750,"_24230":104153,"_2452":104299},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_2926":61128,"_25561":61069,"_17855":104301,"_5":17750,"_24230":104153,"_2452":104302},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_2926":61129,"_25561":61069,"_17855":104304,"_5":17750,"_24230":104153,"_2452":104305},[],"**Key Name**: nombre único y descriptivo.",{"_2926":61130,"_25561":61069,"_17855":104307,"_5":17750,"_24230":104153,"_2452":104308},[],"**Crypto Engine**: motor que custodiará la clave.",{"_2926":61131,"_25561":61069,"_17855":104310,"_5":17750,"_24230":104153,"_2452":104311},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_2926":61132,"_25561":61069,"_17855":104313,"_5":17750,"_24230":104153,"_2452":104314},[],"**Tags**: metadatos para clasificar la clave.",{"_2926":61133,"_25561":61069,"_17855":104316,"_5":17750,"_24230":104153,"_2452":104317},[],"**Metadata**: información adicional para usos avanzados.",{"_2926":61134,"_25561":61069,"_17855":104319,"_5":17750,"_24230":104157,"_2452":104320},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_2926":61135,"_25561":61069,"_17855":104322,"_5":17750,"_24230":104157,"_2452":104323},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_2926":61136,"_25561":61069,"_17855":104325,"_5":17750,"_24230":104157,"_2452":104326},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_2926":61137,"_25561":61069,"_17855":104328,"_5":17750,"_24230":104157,"_2452":104329},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_2926":61138,"_25561":61069,"_17855":104331,"_5":17750,"_24230":104157,"_2452":104332},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_2926":61139,"_25561":61069,"_17855":104334,"_5":17750,"_24230":104157,"_2452":104335},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_2926":61140,"_25561":61069,"_17855":104337,"_5":17750,"_24230":104157,"_2452":104338},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_2926":61141,"_25561":61069,"_17855":104340,"_5":17750,"_24230":104157,"_2452":104341},[],"**Tags**: etiquetas para organización y búsqueda.",{"_2926":61142,"_25561":61069,"_17855":104343,"_5":17750,"_24230":104157,"_2452":104344},[],"**Metadata**: información adicional opcional.",{"_2926":61143,"_25561":61069,"_17855":104346,"_5":17750,"_24230":104157,"_2452":104347},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_2926":61144,"_25561":61069,"_17855":104349,"_5":17750,"_24230":104157,"_2452":104350},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_2926":61145,"_25561":61069,"_17855":104352,"_5":17750,"_24230":104161,"_2452":104353},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_2926":61146,"_25561":61069,"_17855":104355,"_5":17750,"_24230":104165,"_2452":104356},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_2926":61147,"_25561":61069,"_17855":104358,"_5":17750,"_24230":104165,"_2452":104359},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_2926":61148,"_25561":61069,"_17855":104361,"_5":17750,"_24230":104165,"_2452":104362},[],"**Key Name**: nombre descriptivo.",{"_2926":61149,"_25561":61069,"_17855":104364,"_5":17750,"_24230":104165,"_2452":104365},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_2926":61150,"_25561":61069,"_17855":104367,"_5":17750,"_24230":104165,"_2452":104368},[],"**Tags**: etiquetas asociadas.",{"_2926":61151,"_25561":61069,"_17855":104370,"_5":17750,"_24230":104165,"_2452":104371},[],"**Aliases**: nombres alternativos.",{"_2926":61152,"_25561":61069,"_17855":104373,"_5":17750,"_24230":104165,"_2452":104374},[],"**Crypto Engine**: motor en el que reside la clave.",{"_2926":61153,"_25561":61069,"_17855":104376,"_5":17750,"_24230":104165,"_2452":104377},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_2926":61154,"_25561":61069,"_17855":104379,"_5":17750,"_24230":104165,"_2452":104380},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_2926":61155,"_25561":61069,"_17855":104382,"_5":17750,"_24230":104165,"_2452":104383},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_2926":61156,"_25561":61069,"_17855":104385,"_5":17750,"_24230":104169,"_2452":104386},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_2926":61157,"_25561":61069,"_17855":104388,"_5":17750,"_24230":104169,"_2452":104389},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_2926":61158,"_25561":61069,"_17855":104391,"_5":17750,"_24230":104169,"_2452":104392},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_2926":61159,"_25561":61069,"_17855":104394,"_5":17750,"_24230":104173,"_2452":104395},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_2926":61160,"_25561":61069,"_17855":104397,"_5":17750,"_24230":104173,"_2452":104398},[],"Campos principales:",{"_2926":61161,"_25561":61069,"_17855":104400,"_5":17750,"_24230":104173,"_2452":104401},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_2926":61162,"_25561":61069,"_17855":104403,"_5":17750,"_24230":104173,"_2452":104404},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_2926":61163,"_25561":61069,"_17855":104406,"_5":17750,"_24230":104173,"_2452":104407},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_2926":61164,"_25561":61069,"_17855":104409,"_5":17750,"_24230":104173,"_2452":104410},[],"**Message**: contenido que se va a firmar.",{"_2926":61165,"_25561":61069,"_17855":104412,"_5":17750,"_24230":104173,"_2452":104413},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_2926":61166,"_25561":61069,"_17855":104415,"_5":17750,"_24230":104176,"_2452":104416},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_2926":61167,"_25561":61069,"_17855":104418,"_5":17750,"_24230":104176,"_2452":104398},[],{"_2926":61168,"_25561":61069,"_17855":104420,"_5":17750,"_24230":104176,"_2452":104421},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_2926":61169,"_25561":61069,"_17855":104423,"_5":17750,"_24230":104176,"_2452":104424},[],"**Message Type**: `Raw` o `Digest`.",{"_2926":61170,"_25561":61069,"_17855":104426,"_5":17750,"_24230":104176,"_2452":104427},[],"**Payload Encoding**: codificación del mensaje.",{"_2926":61171,"_25561":61069,"_17855":104429,"_5":17750,"_24230":104176,"_2452":104430},[],"**Message**: mensaje original o hash.",{"_2926":61172,"_25561":61069,"_17855":104432,"_5":17750,"_24230":104176,"_2452":104433},[],"**Signature**: firma que se desea comprobar.",{"_2926":61173,"_25561":61069,"_17855":104435,"_5":17750,"_24230":104176,"_2452":104436},[],"**Result**: indicador del resultado de la validación.",{"_2926":61174,"_25561":61069,"_17855":104438,"_5":17750,"_24230":104179,"_2452":104439},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_2926":61175,"_25561":61069,"_17855":104441,"_5":17750,"_24230":104179,"_2452":104442},[],"Este flujo es útil para:",{"_2926":61176,"_25561":61069,"_17855":104444,"_5":17750,"_24230":104179,"_2452":104445},[],"Solicitar certificados a una CA externa.",{"_2926":61177,"_25561":61069,"_17855":104447,"_5":17750,"_24230":104179,"_2452":104448},[],"Renovar una identidad manteniendo la misma clave.",{"_2926":61178,"_25561":61069,"_17855":104450,"_5":17750,"_24230":104179,"_2452":104451},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_2926":61179,"_25561":61069,"_17855":104453,"_5":17750,"_24230":104179,"_2452":104454},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_2926":61180,"_25561":61069,"_17855":104456,"_5":17750,"_24230":104179,"_2452":104457},[],"**Organization (O)**: organización o empresa.",{"_2926":61181,"_25561":61069,"_17855":104459,"_5":17750,"_24230":104179,"_2452":104460},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_2926":61182,"_25561":61069,"_17855":104462,"_5":17750,"_24230":104179,"_2452":104463},[],"**Country (C)**: código de país de dos letras.",{"_2926":61183,"_25561":61069,"_17855":104465,"_5":17750,"_24230":104179,"_2452":104466},[],"**State / Province (ST)**: estado o provincia.",{"_2926":61184,"_25561":61069,"_17855":104468,"_5":17750,"_24230":104179,"_2452":104469},[],"**Locality (L)**: ciudad o localidad.",{"_2926":61185,"_25561":61069,"_17855":104471,"_5":17750,"_24230":104179,"_2452":104472},[],"**Email Address**: correo de contacto.",{"_2926":61186,"_25561":61069,"_17855":104474,"_5":17750,"_24230":104179,"_2452":104475},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_2926":61187,"_25561":61069,"_17855":104477,"_5":17750,"_24230":104179,"_2452":104478},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_2926":61188,"_25561":61069,"_17855":104480,"_5":17750,"_24230":104183,"_2452":104481},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_2926":61189,"_25561":61069,"_17855":104483,"_5":17750,"_24230":104183,"_2452":48371},[],{"_2926":61190,"_25561":61069,"_17855":104485,"_5":17750,"_24230":104187,"_2452":104486},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_2926":61191,"_25561":61191,"_5":12525,"_2452":104488,"_25885":104489,"_17855":104490,"_24230":61191},"Validación online con OCSP",[41651,99234,46688,103437],[],{"_2926":61192,"_25561":61191,"_17855":104492,"_5":17750,"_24230":61191,"_2452":104493},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_2926":61193,"_25561":61191,"_5":25882,"_17855":104495,"_24230":104496,"_2452":104497},[],"/docs/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_2926":61194,"_25561":61191,"_5":25882,"_17855":104499,"_24230":104500,"_2452":104501},[],"/docs/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_2926":61195,"_25561":61191,"_5":25882,"_17855":104503,"_24230":104504,"_2452":104505},[],"/docs/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_2926":61196,"_25561":61191,"_5":25882,"_17855":104507,"_24230":104508,"_2452":104509},[],"/docs/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_2926":61197,"_25561":61191,"_5":25882,"_17855":104511,"_24230":104512,"_2452":104513},[],"/docs/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_2926":61198,"_25561":61191,"_5":25882,"_17855":104515,"_24230":104516,"_2452":103982},[],"/docs/es/platform/pki/ocsp#referencias",{"_2926":61199,"_25561":61191,"_17855":104518,"_5":17750,"_24230":61191,"_2452":104519},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_2926":61200,"_25561":61191,"_17855":104521,"_5":17750,"_24230":104496,"_2452":104522},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_2926":61201,"_25561":61191,"_17855":104524,"_5":17750,"_24230":104496,"_2452":104525},[],"Estado del registro",{"_2926":61202,"_25561":61191,"_17855":104527,"_5":17750,"_24230":104496,"_2452":104528},[],"Respuesta firmada",{"_2926":61203,"_25561":61191,"_17855":104530,"_5":17750,"_24230":104496,"_2452":45866},[],{"_2926":61204,"_25561":61191,"_17855":104532,"_5":17750,"_24230":104496,"_2452":48421},[],{"_2926":61205,"_25561":61191,"_17855":104534,"_5":17750,"_24230":104496,"_2452":45883},[],{"_2926":61206,"_25561":61191,"_17855":104536,"_5":17750,"_24230":104496,"_2452":104537},[],"`Revoked`, con razón y fecha de revocación.",{"_2926":61207,"_25561":61191,"_17855":104539,"_5":17750,"_24230":104496,"_2452":104540},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_2926":61208,"_25561":61191,"_17855":104542,"_5":17750,"_24230":104496,"_2452":104543},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_2926":61209,"_25561":61191,"_17855":104545,"_5":17750,"_24230":104496,"_2452":104546},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_2926":61210,"_25561":61191,"_17855":104548,"_5":17750,"_24230":104496,"_2452":104549},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_2926":61211,"_25561":61191,"_17855":104551,"_5":17750,"_24230":104496,"_2452":104552},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_2926":61212,"_25561":61191,"_17855":104554,"_5":17750,"_24230":104500,"_2452":104555},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_2926":61213,"_25561":61191,"_17855":104557,"_5":17750,"_24230":104500,"_2452":104558},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_2926":61214,"_25561":61191,"_17855":104560,"_5":17750,"_24230":104504,"_2452":104561},[],"El servicio acepta:",{"_2926":61215,"_25561":61191,"_17855":104563,"_5":17750,"_24230":104504,"_2452":100919},[],{"_2926":61216,"_25561":61191,"_17855":104565,"_5":17750,"_24230":104504,"_2452":104566},[],"Ruta del servicio VA",{"_2926":61217,"_25561":61191,"_17855":104568,"_5":17750,"_24230":104504,"_2452":104569},[],"Formato",{"_2926":61218,"_25561":61191,"_17855":104571,"_5":17750,"_24230":104504,"_2452":48461},[],{"_2926":61219,"_25561":61191,"_17855":104573,"_5":17750,"_24230":104504,"_2452":48464},[],{"_2926":61220,"_25561":61191,"_17855":104575,"_5":17750,"_24230":104504,"_2452":104576},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_2926":61221,"_25561":61191,"_17855":104578,"_5":17750,"_24230":104504,"_2452":47950},[],{"_2926":61222,"_25561":61191,"_17855":104580,"_5":17750,"_24230":104504,"_2452":48472},[],{"_2926":61223,"_25561":61191,"_17855":104582,"_5":17750,"_24230":104504,"_2452":104583},[],"Solicitud DER codificada en Base64 URL con padding.",{"_2926":61224,"_25561":61191,"_17855":104585,"_5":17750,"_24230":104504,"_2452":104586},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_2926":61225,"_25561":61191,"_17855":104588,"_5":17750,"_24230":104508,"_2452":104589},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_2926":61226,"_25561":61191,"_17855":104591,"_5":17750,"_24230":104508,"_2452":104592},[],"Genera la solicitud:",{"_2926":61227,"_25561":61191,"_17855":104594,"_5":17750,"_24230":104508,"_2452":104595},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_2926":61228,"_25561":61191,"_17855":104597,"_5":17750,"_24230":104508,"_2452":104598},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_2926":61229,"_25561":61191,"_17855":104600,"_5":17750,"_24230":104508,"_2452":104601},[],"Verifica el DER recibido:",{"_2926":61230,"_25561":61191,"_17855":104603,"_5":17750,"_24230":104508,"_2452":104604},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_2926":61231,"_25561":61191,"_17855":104606,"_5":17750,"_24230":104512,"_2452":104607},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_2926":61232,"_25561":61191,"_17855":104609,"_5":17750,"_24230":104512,"_2452":104610},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_2926":61233,"_25561":61191,"_17855":104612,"_5":17750,"_24230":104516,"_2452":48505},[],{"_2926":61234,"_25561":61191,"_17855":104614,"_5":17750,"_24230":104516,"_2452":48508},[],{"_2926":61235,"_25561":61191,"_17855":104616,"_5":17750,"_24230":104516,"_2452":104617},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_2926":61236,"_25561":61191,"_17855":104619,"_5":17750,"_24230":104516,"_2452":104109},[],{"_2926":61237,"_25561":61237,"_5":12525,"_2452":46688,"_25885":104621,"_17855":104622,"_24230":61237},[41651,99234,46688],[],{"_2926":61238,"_25561":61237,"_17855":104624,"_5":17750,"_24230":61237,"_2452":104625},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_2926":61239,"_25561":61237,"_5":25882,"_17855":104627,"_24230":104628,"_2452":102146},[],"/docs/es/platform/pki/overview#empieza-aquí",{"_2926":61240,"_25561":61237,"_5":25882,"_17855":104630,"_24230":104631,"_2452":104632},[],"/docs/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_2926":61241,"_25561":61237,"_5":25882,"_17855":104634,"_24230":104635,"_2452":102668},[],"/docs/es/platform/pki/overview#capacidades-principales",{"_2926":61242,"_25561":61237,"_5":25882,"_17855":104637,"_24230":104638,"_2452":102672},[],"/docs/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_2926":61243,"_25561":61237,"_5":25882,"_17855":104640,"_24230":104641,"_2452":102676},[],"/docs/es/platform/pki/overview#protege-las-claves-criptográficas",{"_2926":61244,"_25561":61237,"_5":25882,"_17855":104643,"_24230":104644,"_2452":102680},[],"/docs/es/platform/pki/overview#emite-y-controla-certificados",{"_2926":61245,"_25561":61237,"_5":25882,"_17855":104646,"_24230":104647,"_2452":102688},[],"/docs/es/platform/pki/overview#publica-el-estado-de-validación",{"_2926":61246,"_25561":61237,"_5":25882,"_17855":104649,"_24230":104650,"_2452":104651},[],"/docs/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_2926":61247,"_25561":61237,"_5":25882,"_17855":104653,"_24230":104654,"_2452":103603},[],"/docs/es/platform/pki/overview#continúa",{"_2926":61248,"_25561":61237,"_17855":104656,"_5":17750,"_24230":61237,"_2452":104657},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_2926":61249,"_25561":61237,"_17855":104659,"_5":17750,"_24230":104628,"_2452":104660},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_2926":61250,"_25561":61237,"_17855":104662,"_5":17750,"_24230":104628,"_2452":104663},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_2926":61251,"_25561":61237,"_17855":104665,"_5":17750,"_24230":104631,"_2452":104666},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_2926":61252,"_25561":61237,"_17855":104668,"_5":17750,"_24230":104631,"_2452":104669},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_2926":61253,"_25561":61237,"_17855":104671,"_5":17750,"_24230":104631,"_2452":104672},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_2926":61254,"_25561":61237,"_17855":104674,"_5":17750,"_24230":104631,"_2452":104675},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_2926":61255,"_25561":61237,"_17855":104677,"_5":17750,"_24230":104631,"_2452":104678},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_2926":61256,"_25561":61237,"_17855":104680,"_5":17750,"_24230":104638,"_2452":104681},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_2926":61257,"_25561":61237,"_17855":104683,"_5":17750,"_24230":104641,"_2452":104684},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_2926":61258,"_25561":61237,"_17855":104686,"_5":17750,"_24230":104644,"_2452":104687},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_2926":61259,"_25561":61237,"_17855":104689,"_5":17750,"_24230":104647,"_2452":104690},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_2926":61260,"_25561":61237,"_17855":104692,"_5":17750,"_24230":104650,"_2452":104693},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_2926":61261,"_25561":61237,"_17855":104695,"_5":17750,"_24230":104650,"_2452":104696},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_2926":61262,"_25561":61237,"_17855":104698,"_5":17750,"_24230":104650,"_2452":104699},[],"su clave pública corresponda a la clave privada del cliente;",{"_2926":61263,"_25561":61237,"_17855":104701,"_5":17750,"_24230":104650,"_2452":104702},[],"su cadena alcance una raíz confiable para el consumidor;",{"_2926":61264,"_25561":61237,"_17855":104704,"_5":17750,"_24230":104650,"_2452":104705},[],"sus fechas y usos permitan la operación;",{"_2926":61265,"_25561":61237,"_17855":104707,"_5":17750,"_24230":104650,"_2452":104708},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_2926":61266,"_25561":61237,"_17855":104710,"_5":17750,"_24230":104650,"_2452":104711},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_2926":61267,"_25561":61237,"_17855":104713,"_5":17750,"_24230":104654,"_2452":104714},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2926":61268,"_25561":61237,"_17855":104716,"_5":17750,"_24230":104654,"_2452":104717},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2926":61269,"_25561":61237,"_17855":104719,"_5":17750,"_24230":104654,"_2452":104720},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2926":61270,"_25561":61270,"_5":12525,"_2452":104722,"_25885":104723,"_17855":104724,"_24230":61270},"Crea tu primera CA",[41651,99234,46688,102270],[],{"_2926":61271,"_25561":61270,"_17855":104726,"_5":17750,"_24230":61270,"_2452":104727},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_2926":61272,"_25561":61270,"_5":25882,"_17855":104729,"_24230":104730,"_2452":97935},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_2926":61273,"_25561":61270,"_5":25882,"_17855":104732,"_24230":104733,"_2452":104734},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_2926":61274,"_25561":61270,"_5":25882,"_17855":104736,"_24230":104737,"_2452":104738},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_2926":61275,"_25561":61270,"_5":25882,"_17855":104740,"_24230":104741,"_2452":104742},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_2926":61276,"_25561":61270,"_5":25882,"_17855":104744,"_24230":104745,"_2452":104746},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_2926":61277,"_25561":61270,"_5":25882,"_17855":104748,"_24230":104749,"_2452":104750},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_2926":61278,"_25561":61270,"_5":25882,"_17855":104752,"_24230":104753,"_2452":104754},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_2926":61279,"_25561":61270,"_5":25882,"_17855":104756,"_24230":104757,"_2452":102518},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_2926":61280,"_25561":61270,"_5":25882,"_17855":104759,"_24230":104760,"_2452":97959},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_2926":61281,"_25561":61270,"_17855":104762,"_5":17750,"_24230":61270,"_2452":104763},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_2926":61282,"_25561":61270,"_17855":104765,"_5":17750,"_24230":104730,"_2452":104766},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_2926":61283,"_25561":61270,"_17855":104768,"_5":17750,"_24230":104730,"_2452":104769},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_2926":61284,"_25561":61270,"_17855":104771,"_5":17750,"_24230":104730,"_2452":104772},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_2926":61285,"_25561":61270,"_17855":104774,"_5":17750,"_24230":104730,"_2452":104775},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_2926":61286,"_25561":61270,"_17855":104777,"_5":17750,"_24230":104733,"_2452":104778},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_2926":61287,"_25561":61270,"_17855":104780,"_5":17750,"_24230":104733,"_2452":104781},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_2926":61288,"_25561":61270,"_17855":104783,"_5":17750,"_24230":104737,"_2452":104784},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_2926":61289,"_25561":61270,"_17855":104786,"_5":17750,"_24230":104737,"_2452":104787},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_2926":61290,"_25561":61270,"_17855":104789,"_5":17750,"_24230":104741,"_2452":104790},[],"Selecciona **Root CA** y completa:",{"_2926":61291,"_25561":61270,"_17855":104792,"_5":17750,"_24230":104741,"_2452":48687},[],{"_2926":61292,"_25561":61270,"_17855":104794,"_5":17750,"_24230":104741,"_2452":104795},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_2926":61293,"_25561":61270,"_17855":104797,"_5":17750,"_24230":104741,"_2452":104798},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_2926":61294,"_25561":61270,"_17855":104800,"_5":17750,"_24230":104741,"_2452":104801},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_2926":61295,"_25561":61270,"_17855":104803,"_5":17750,"_24230":104741,"_2452":104804},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_2926":61296,"_25561":61270,"_17855":104806,"_5":17750,"_24230":104745,"_2452":104807},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_2926":61297,"_25561":61270,"_17855":104809,"_5":17750,"_24230":104749,"_2452":104810},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_2926":61298,"_25561":61270,"_17855":104812,"_5":17750,"_24230":104749,"_2452":104813},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_2926":61299,"_25561":61270,"_17855":104815,"_5":17750,"_24230":104753,"_2452":104816},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_2926":61300,"_25561":61270,"_17855":104818,"_5":17750,"_24230":104753,"_2452":104819},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_2926":61301,"_25561":61270,"_17855":104821,"_5":17750,"_24230":104753,"_2452":104822},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_2926":61302,"_25561":61270,"_17855":104824,"_5":17750,"_24230":104757,"_2452":104825},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_2926":61303,"_25561":61270,"_17855":104827,"_5":17750,"_24230":104757,"_2452":104828},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_2926":61304,"_25561":61270,"_17855":104830,"_5":17750,"_24230":104757,"_2452":104831},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_2926":61305,"_25561":61270,"_17855":104833,"_5":17750,"_24230":104757,"_2452":104834},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_2926":61306,"_25561":61270,"_17855":104836,"_5":17750,"_24230":104760,"_2452":104837},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_2926":61307,"_25561":61307,"_5":12525,"_2452":104839,"_25885":104840,"_17855":104841,"_24230":61307},"Emite y verifica un certificado",[41651,99234,46688,102270],[],{"_2926":61308,"_25561":61307,"_17855":104843,"_5":17750,"_24230":61307,"_2452":104844},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_2926":61309,"_25561":61307,"_5":25882,"_17855":104846,"_24230":104847,"_2452":97935},[],"/docs/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_2926":61310,"_25561":61307,"_5":25882,"_17855":104849,"_24230":104850,"_2452":104851},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_2926":61311,"_25561":61307,"_5":25882,"_17855":104853,"_24230":104854,"_2452":104855},[],"/docs/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_2926":61312,"_25561":61307,"_5":25882,"_17855":104857,"_24230":104858,"_2452":104859},[],"/docs/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_2926":61313,"_25561":61307,"_5":25882,"_17855":104861,"_24230":104862,"_2452":104863},[],"/docs/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_2926":61314,"_25561":61307,"_5":25882,"_17855":104865,"_24230":104866,"_2452":104867},[],"/docs/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_2926":61315,"_25561":61307,"_5":25882,"_17855":104869,"_24230":104870,"_2452":104750},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_2926":61316,"_25561":61307,"_5":25882,"_17855":104872,"_24230":104873,"_2452":104874},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_2926":61317,"_25561":61307,"_5":25882,"_17855":104876,"_24230":104877,"_2452":104878},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_2926":61318,"_25561":61307,"_5":25882,"_17855":104880,"_24230":104881,"_2452":104882},[],"/docs/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_2926":61319,"_25561":61307,"_5":25882,"_17855":104884,"_24230":104885,"_2452":102518},[],"/docs/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_2926":61320,"_25561":61307,"_5":25882,"_17855":104887,"_24230":104888,"_2452":97959},[],"/docs/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_2926":61321,"_25561":61307,"_17855":104890,"_5":17750,"_24230":61307,"_2452":104891},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_2926":61322,"_25561":61307,"_17855":104893,"_5":17750,"_24230":104847,"_2452":104894},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_2926":61323,"_25561":61307,"_17855":104896,"_5":17750,"_24230":104847,"_2452":104897},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_2926":61324,"_25561":61307,"_17855":104899,"_5":17750,"_24230":104847,"_2452":104900},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_2926":61325,"_25561":61307,"_17855":104902,"_5":17750,"_24230":104847,"_2452":104903},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_2926":61326,"_25561":61307,"_17855":104905,"_5":17750,"_24230":104847,"_2452":104906},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_2926":61327,"_25561":61307,"_17855":104908,"_5":17750,"_24230":104850,"_2452":104909},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_2926":61328,"_25561":61307,"_17855":104911,"_5":17750,"_24230":104854,"_2452":104912},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_2926":61329,"_25561":61307,"_17855":104914,"_5":17750,"_24230":104854,"_2452":104915},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_2926":61330,"_25561":61307,"_17855":104917,"_5":17750,"_24230":104858,"_2452":104918},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_2926":61331,"_25561":61307,"_17855":104920,"_5":17750,"_24230":104858,"_2452":104921},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_2926":61332,"_25561":61307,"_17855":104923,"_5":17750,"_24230":104862,"_2452":104924},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_2926":61333,"_25561":61307,"_17855":104926,"_5":17750,"_24230":104862,"_2452":104927},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_2926":61334,"_25561":61307,"_17855":104929,"_5":17750,"_24230":104866,"_2452":104930},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_2926":61335,"_25561":61307,"_17855":104932,"_5":17750,"_24230":104870,"_2452":104933},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_2926":61336,"_25561":61307,"_17855":104935,"_5":17750,"_24230":104873,"_2452":104936},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_2926":61337,"_25561":61307,"_17855":104938,"_5":17750,"_24230":104877,"_2452":104939},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_2926":61338,"_25561":61307,"_17855":104941,"_5":17750,"_24230":104877,"_2452":104942},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_2926":61339,"_25561":61307,"_17855":104944,"_5":17750,"_24230":104877,"_2452":104945},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_2926":61340,"_25561":61307,"_17855":104947,"_5":17750,"_24230":104881,"_2452":104948},[],"En Bash, compara los dos resúmenes de clave pública:",{"_2926":61341,"_25561":61307,"_17855":104950,"_5":17750,"_24230":104881,"_2452":104951},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_2926":61342,"_25561":61307,"_17855":104953,"_5":17750,"_24230":104881,"_2452":104954},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_2926":61343,"_25561":61307,"_17855":104956,"_5":17750,"_24230":104885,"_2452":102601},[],{"_2926":61344,"_25561":61307,"_17855":104958,"_5":17750,"_24230":104885,"_2452":101368},[],{"_2926":61345,"_25561":61307,"_17855":104960,"_5":17750,"_24230":104885,"_2452":104961},[],"La CA rechaza la emisión",{"_2926":61346,"_25561":61307,"_17855":104963,"_5":17750,"_24230":104885,"_2452":104964},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_2926":61347,"_25561":61307,"_17855":104966,"_5":17750,"_24230":104885,"_2452":104967},[],"Sujeto o usos diferentes",{"_2926":61348,"_25561":61307,"_17855":104969,"_5":17750,"_24230":104885,"_2452":104970},[],"Perfil aplicado y valores solicitados.",{"_2926":61349,"_25561":61307,"_17855":104972,"_5":17750,"_24230":104885,"_2452":104973},[],"No se encuentra el emisor",{"_2926":61350,"_25561":61307,"_17855":104975,"_5":17750,"_24230":104885,"_2452":104976},[],"CA descargada y cadena intermedia necesaria.",{"_2926":61351,"_25561":61307,"_17855":104978,"_5":17750,"_24230":104885,"_2452":104979},[],"Falla la vigencia",{"_2926":61352,"_25561":61307,"_17855":104981,"_5":17750,"_24230":104885,"_2452":104982},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_2926":61353,"_25561":61307,"_17855":104984,"_5":17750,"_24230":104885,"_2452":104985},[],"Los resúmenes de clave difieren",{"_2926":61354,"_25561":61307,"_17855":104987,"_5":17750,"_24230":104885,"_2452":104988},[],"Archivos de certificado y clave de la misma emisión.",{"_2926":61355,"_25561":61307,"_17855":104990,"_5":17750,"_24230":104885,"_2452":104991},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_2926":61356,"_25561":61307,"_17855":104993,"_5":17750,"_24230":104888,"_2452":104994},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_2926":61357,"_25561":61307,"_17855":104996,"_5":17750,"_24230":104888,"_2452":104997},[],"Gestionar certificados para inspección, estado y revocación.",{"_2926":61358,"_25561":61307,"_17855":104999,"_5":17750,"_24230":104888,"_2452":105000},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_2926":61359,"_25561":61307,"_17855":105002,"_5":17750,"_24230":104888,"_2452":105003},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_2926":61360,"_25561":61307,"_17855":105005,"_5":17750,"_24230":104888,"_2452":105006},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_2926":61361,"_25561":61361,"_5":12525,"_2452":105008,"_25885":105009,"_17855":105010,"_24230":61361},"Primeros pasos de PKI",[41651,99234,46688,102270],[],{"_2926":61362,"_25561":61361,"_17855":105012,"_5":17750,"_24230":61361,"_2452":105013},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_2926":61363,"_25561":61361,"_5":25882,"_17855":105015,"_24230":105016,"_2452":97935},[],"/docs/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_2926":61364,"_25561":61361,"_5":25882,"_17855":105018,"_24230":105019,"_2452":105020},[],"/docs/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_2926":61365,"_25561":61361,"_5":25882,"_17855":105022,"_24230":105023,"_2452":102452},[],"/docs/es/platform/pki/quickstarts/overview#resultado-esperado",{"_2926":61366,"_25561":61361,"_5":25882,"_17855":105025,"_24230":105026,"_2452":105027},[],"/docs/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_2926":61367,"_25561":61361,"_17855":105029,"_5":17750,"_24230":61361,"_2452":105030},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_2926":61368,"_25561":61361,"_17855":105032,"_5":17750,"_24230":105016,"_2452":105033},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_2926":61369,"_25561":61361,"_17855":105035,"_5":17750,"_24230":105016,"_2452":105036},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_2926":61370,"_25561":61361,"_17855":105038,"_5":17750,"_24230":105016,"_2452":105039},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_2926":61371,"_25561":61361,"_17855":105041,"_5":17750,"_24230":105016,"_2452":105042},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_2926":61372,"_25561":61361,"_17855":105044,"_5":17750,"_24230":105016,"_2452":105045},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_2926":61373,"_25561":61361,"_17855":105047,"_5":17750,"_24230":105019,"_2452":105048},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2926":61374,"_25561":61361,"_17855":105050,"_5":17750,"_24230":105019,"_2452":105051},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2926":61375,"_25561":61361,"_17855":105053,"_5":17750,"_24230":105019,"_2452":105054},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_2926":61376,"_25561":61361,"_17855":105056,"_5":17750,"_24230":105019,"_2452":105057},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_2926":61377,"_25561":61361,"_17855":105059,"_5":17750,"_24230":105023,"_2452":105060},[],"Archivo o recurso",{"_2926":61378,"_25561":61361,"_17855":105062,"_5":17750,"_24230":105023,"_2452":102449},[],{"_2926":61379,"_25561":61361,"_17855":105064,"_5":17750,"_24230":105023,"_2452":105065},[],"CA raíz activa y `ca.pem`",{"_2926":61380,"_25561":61361,"_17855":105067,"_5":17750,"_24230":105023,"_2452":105068},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_2926":61381,"_25561":61361,"_17855":105070,"_5":17750,"_24230":105023,"_2452":105071},[],"Certificado final y `device.crt`",{"_2926":61382,"_25561":61361,"_17855":105073,"_5":17750,"_24230":105023,"_2452":105074},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_2926":61383,"_25561":61361,"_17855":105076,"_5":17750,"_24230":105023,"_2452":105077},[],"Clave privada `device.key`",{"_2926":61384,"_25561":61361,"_17855":105079,"_5":17750,"_24230":105023,"_2452":105080},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_2926":61385,"_25561":61361,"_17855":105082,"_5":17750,"_24230":105023,"_2452":105083},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_2926":61386,"_25561":61361,"_17855":105085,"_5":17750,"_24230":105026,"_2452":105086},[],"Para operar certificados, continúa con Certificados y Validación.",{"_2926":61387,"_25561":61361,"_17855":105088,"_5":17750,"_24230":105026,"_2452":105089},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_2926":61388,"_25561":61361,"_17855":105091,"_5":17750,"_24230":105026,"_2452":105092},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_2926":61389,"_25561":61389,"_5":12525,"_2452":105094,"_25885":105095,"_17855":105097,"_24230":61389},"Resolución de problemas PKI",[41651,99234,46688,105096],"Resolución de problemas",[],{"_2926":61390,"_25561":61389,"_17855":105099,"_5":17750,"_24230":61389,"_2452":105100},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_2926":61391,"_25561":61389,"_5":25882,"_17855":105102,"_24230":105103,"_2452":105104},[],"/docs/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_2926":61392,"_25561":61389,"_5":25882,"_17855":105106,"_24230":105107,"_2452":105108},[],"/docs/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_2926":61393,"_25561":61389,"_5":25882,"_17855":105110,"_24230":105111,"_2452":105112},[],"/docs/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_2926":61394,"_25561":61389,"_17855":105114,"_5":17750,"_24230":61389,"_2452":105115},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_2926":61395,"_25561":61389,"_17855":105117,"_5":17750,"_24230":61389,"_2452":105118},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_2926":61396,"_25561":61389,"_17855":105120,"_5":17750,"_24230":105103,"_2452":102449},[],{"_2926":61397,"_25561":61389,"_17855":105122,"_5":17750,"_24230":105103,"_2452":101368},[],{"_2926":61398,"_25561":61389,"_17855":105124,"_5":17750,"_24230":105103,"_2452":97959},[],{"_2926":61399,"_25561":61389,"_17855":105126,"_5":17750,"_24230":105103,"_2452":49023},[],{"_2926":61400,"_25561":61389,"_17855":105128,"_5":17750,"_24230":105103,"_2452":105129},[],"Existe, está activa y sus fechas son utilizables.",{"_2926":61401,"_25561":61389,"_17855":105131,"_5":17750,"_24230":105103,"_2452":105132},[],"Autoridades.",{"_2926":61402,"_25561":61389,"_17855":105134,"_5":17750,"_24230":105103,"_2452":105135},[],"Clave",{"_2926":61403,"_25561":61389,"_17855":105137,"_5":17750,"_24230":105103,"_2452":105138},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_2926":61404,"_25561":61389,"_17855":105140,"_5":17750,"_24230":105103,"_2452":105141},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_2926":61405,"_25561":61389,"_17855":105143,"_5":17750,"_24230":105103,"_2452":49041},[],{"_2926":61406,"_25561":61389,"_17855":105145,"_5":17750,"_24230":105103,"_2452":105146},[],"PEM correcto y firma verificable.",{"_2926":61407,"_25561":61389,"_17855":105148,"_5":17750,"_24230":105103,"_2452":49047},[],{"_2926":61408,"_25561":61389,"_17855":105150,"_5":17750,"_24230":105103,"_2452":105151},[],"Perfil",{"_2926":61409,"_25561":61389,"_17855":105153,"_5":17750,"_24230":105103,"_2452":105154},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_2926":61410,"_25561":61389,"_17855":105156,"_5":17750,"_24230":105103,"_2452":105157},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_2926":61411,"_25561":61389,"_17855":105159,"_5":17750,"_24230":105103,"_2452":102601},[],{"_2926":61412,"_25561":61389,"_17855":105161,"_5":17750,"_24230":105103,"_2452":105162},[],"Sujeto, SAN, usos y fechas adecuados.",{"_2926":61413,"_25561":61389,"_17855":105164,"_5":17750,"_24230":105103,"_2452":105165},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_2926":61414,"_25561":61389,"_17855":105167,"_5":17750,"_24230":105103,"_2452":105168},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_2926":61415,"_25561":61389,"_17855":105170,"_5":17750,"_24230":105103,"_2452":105171},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_2926":61416,"_25561":61389,"_17855":105173,"_5":17750,"_24230":105107,"_2452":105174},[],"Revisa cada frontera por separado:",{"_2926":61417,"_25561":61389,"_17855":105176,"_5":17750,"_24230":105107,"_2452":105177},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_2926":61418,"_25561":61389,"_17855":105179,"_5":17750,"_24230":105107,"_2452":105180},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_2926":61419,"_25561":61389,"_17855":105182,"_5":17750,"_24230":105107,"_2452":105183},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_2926":61420,"_25561":61389,"_17855":105185,"_5":17750,"_24230":105107,"_2452":105186},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_2926":61421,"_25561":61389,"_17855":105188,"_5":17750,"_24230":105107,"_2452":105189},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_2926":61422,"_25561":61389,"_17855":105191,"_5":17750,"_24230":105107,"_2452":105192},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_2926":61423,"_25561":61389,"_17855":105194,"_5":17750,"_24230":105111,"_2452":105195},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_2926":61424,"_25561":61389,"_17855":105197,"_5":17750,"_24230":105111,"_2452":105198},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_2926":61425,"_25561":61425,"_5":12525,"_2452":105200,"_25885":105201,"_17855":105203,"_24230":61425},"3.8.0 a 4.0.0",[41651,105202],"Actualizaciones",[],{"_2926":61426,"_25561":61425,"_17855":105205,"_5":17750,"_24230":61425,"_2452":105206},[],"Cambios de 4.0.0 que afectan a la configuración de los DMS, qué puede fallar tras actualizar desde 3.8.0 y cómo comprobarlo.",{"_2926":61427,"_25561":61425,"_5":25882,"_17855":105208,"_24230":105209,"_2452":105210},[],"/docs/es/upgrades/3-8-0-to-4-0-0#resumen","Resumen",{"_2926":61428,"_25561":61425,"_5":25882,"_17855":105212,"_24230":105213,"_2452":105214},[],"/docs/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_2926":61429,"_25561":61425,"_5":25882,"_17855":105216,"_24230":105217,"_2452":105218},[],"/docs/es/upgrades/3-8-0-to-4-0-0#webhooks-con-referencias-a-archivos","Webhooks con referencias a archivos",{"_2926":61430,"_25561":61425,"_5":25882,"_17855":105220,"_24230":105221,"_2452":105222},[],"/docs/es/upgrades/3-8-0-to-4-0-0#verificación-del-certificado-del-receptor","Verificación del certificado del receptor",{"_2926":61431,"_25561":61425,"_5":25882,"_17855":105224,"_24230":105225,"_2452":105226},[],"/docs/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_2926":61432,"_25561":61425,"_5":25882,"_17855":105228,"_24230":105229,"_2452":105230},[],"/docs/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_2926":61433,"_25561":61425,"_5":25882,"_17855":105232,"_24230":105233,"_2452":105234},[],"/docs/es/upgrades/3-8-0-to-4-0-0#lista-de-verificación","Lista de verificación",{"_2926":61434,"_25561":61425,"_17855":105236,"_5":17750,"_24230":61425,"_2452":105237},[],"La actualización de 3.8.0 a 4.0.0 migra automáticamente la configuración almacenada de los DMS. Casi todo se convierte sin intervención, pero hay tres cambios que pueden dejar enrolamientos fallando o configuraciones con valores inesperados si no se revisan. Esta página indica qué cambia, qué síntomas produce y qué hacer en cada caso. El comportamiento vigente de cada funcionalidad está en las páginas de DMS.",{"_2926":61435,"_25561":61425,"_17855":105239,"_5":17750,"_24230":105209,"_2452":105240},[],"Cambio",{"_2926":61436,"_25561":61425,"_17855":105242,"_5":17750,"_24230":105209,"_2452":105243},[],"Quién se ve afectado",{"_2926":61437,"_25561":61425,"_17855":105245,"_5":17750,"_24230":105209,"_2452":105246},[],"Gravedad",{"_2926":61438,"_25561":61425,"_17855":105248,"_5":17750,"_24230":105209,"_2452":105249},[],"Acción",{"_2926":61439,"_25561":61425,"_17855":105251,"_5":17750,"_24230":105209,"_2452":105218},[],{"_2926":61440,"_25561":61425,"_17855":105253,"_5":17750,"_24230":105209,"_2452":105254},[],"DMS con webhook cuyo certificado o clave de mTLS eran rutas de archivo",{"_2926":61441,"_25561":61425,"_17855":105256,"_5":17750,"_24230":105209,"_2452":105257},[],"Alta: los enrolamientos y reenrolamientos que llaman al webhook fallan",{"_2926":61442,"_25561":61425,"_17855":105259,"_5":17750,"_24230":105209,"_2452":105260},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_2926":61443,"_25561":61425,"_17855":105262,"_5":17750,"_24230":105209,"_2452":105222},[],{"_2926":61444,"_25561":61425,"_17855":105264,"_5":17750,"_24230":105209,"_2452":105265},[],"DMS con webhook que tenían `validate_server_cert: false`",{"_2926":61445,"_25561":61425,"_17855":105267,"_5":17750,"_24230":105209,"_2452":105268},[],"Media: las credenciales del webhook viajan sin verificar al receptor",{"_2926":61446,"_25561":61425,"_17855":105270,"_5":17750,"_24230":105209,"_2452":105271},[],"Poner `insecure_skip_verify` a `false`",{"_2926":61447,"_25561":61425,"_17855":105273,"_5":17750,"_24230":105209,"_2452":105226},[],{"_2926":61448,"_25561":61425,"_17855":105275,"_5":17750,"_24230":105209,"_2452":105276},[],"Scripts y consolas que editan DMS por API",{"_2926":61449,"_25561":61425,"_17855":105278,"_5":17750,"_24230":105209,"_2452":105279},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_2926":61450,"_25561":61425,"_17855":105281,"_5":17750,"_24230":105209,"_2452":105282},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_2926":61451,"_25561":61425,"_17855":105284,"_5":17750,"_24230":105209,"_2452":105230},[],{"_2926":61452,"_25561":61425,"_17855":105286,"_5":17750,"_24230":105209,"_2452":105287},[],"Cualquier DMS",{"_2926":61453,"_25561":61425,"_17855":105289,"_5":17750,"_24230":105209,"_2452":105290},[],"Baja: solo informativo",{"_2926":61454,"_25561":61425,"_17855":105292,"_5":17750,"_24230":105209,"_2452":105293},[],"Revisar ambos bloques antes de editar",{"_2926":61455,"_25561":61425,"_17855":105295,"_5":17750,"_24230":105209,"_2452":105296},[],"Al final se incluye una lista de verificación para confirmar el resultado.",{"_2926":61456,"_25561":61425,"_17855":105298,"_5":17750,"_24230":105213,"_2452":105299},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual. Los campos se renombran de la siguiente manera:",{"_2926":61457,"_25561":61425,"_17855":105301,"_5":17750,"_24230":105213,"_2452":105302},[],"Campo en 3.8.0",{"_2926":61458,"_25561":61425,"_17855":105304,"_5":17750,"_24230":105213,"_2452":105305},[],"Campo en 4.0.0",{"_2926":61459,"_25561":61425,"_17855":105307,"_5":17750,"_24230":105213,"_2452":49207},[],{"_2926":61460,"_25561":61425,"_17855":105309,"_5":17750,"_24230":105213,"_2452":105310},[],"`insecure_skip_verify` (con el valor negado)",{"_2926":61461,"_25561":61425,"_17855":105312,"_5":17750,"_24230":105213,"_2452":49213},[],{"_2926":61462,"_25561":61425,"_17855":105314,"_5":17750,"_24230":105213,"_2452":49216},[],{"_2926":61463,"_25561":61425,"_17855":105316,"_5":17750,"_24230":105213,"_2452":49219},[],{"_2926":61464,"_25561":61425,"_17855":105318,"_5":17750,"_24230":105213,"_2452":49222},[],{"_2926":61465,"_25561":61425,"_17855":105320,"_5":17750,"_24230":105213,"_2452":49225},[],{"_2926":61466,"_25561":61425,"_17855":105322,"_5":17750,"_24230":105213,"_2452":49228},[],{"_2926":61467,"_25561":61425,"_17855":105324,"_5":17750,"_24230":105213,"_2452":105325},[],"Cuando el certificado y la clave heredados de mTLS son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren ninguna acción. Los dos casos siguientes son los que sí la requieren.",{"_2926":61468,"_25561":61425,"_17855":105327,"_5":17750,"_24230":105217,"_2452":105328},[],"Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos, y lo hace en cada llamada, sea cual sea el modo de autenticación configurado. El efecto es que todos los enrolamientos y reenrolamientos que invocan ese webhook fallan hasta corregir la configuración.",{"_2926":61469,"_25561":61425,"_17855":105330,"_5":17750,"_24230":105217,"_2452":105331},[],"Para corregirlo hay dos opciones, según el webhook:",{"_2926":61470,"_25561":61425,"_17855":105333,"_5":17750,"_24230":105217,"_2452":105334},[],"Si el webhook usa mTLS, volver a introducir el certificado y la clave como PEM, en Base64 o en texto plano.",{"_2926":61471,"_25561":61425,"_17855":105336,"_5":17750,"_24230":105217,"_2452":105337},[],"Si el webhook no usa mTLS, eliminar los campos de archivo sobrantes.",{"_2926":61472,"_25561":61425,"_17855":105339,"_5":17750,"_24230":105217,"_2452":105340},[],"Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`).",{"_2926":61473,"_25561":61425,"_17855":105342,"_5":17750,"_24230":105217,"_2452":105343},[],"Existe una variante del mismo problema: si la configuración almacenada guarda rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content`, toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`) falla la validación. Los ajustes se sustituyen al completo, de modo que la configuración almacenada debe reenviarse con el certificado y la clave como PEM.",{"_2926":61474,"_25561":61425,"_17855":105345,"_5":17750,"_24230":105221,"_2452":105346},[],"Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`. Por tanto, la verificación del certificado del receptor sigue sin realizarse hasta que se ponga ese campo a `false`.",{"_2926":61475,"_25561":61425,"_17855":105348,"_5":17750,"_24230":105221,"_2452":105349},[],"Conviene corregirlo en cada configuración migrada. El canal de autorización del webhook transporta la API key o el bearer token, de modo que saltarse la verificación expone esas credenciales a un atacante con posición de red. Solo se justifica mantener `insecure_skip_verify: true` si el certificado del receptor no es verificable de forma deliberada.",{"_2926":61476,"_25561":61425,"_17855":105351,"_5":17750,"_24230":105225,"_2452":105352},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`.",{"_2926":61477,"_25561":61425,"_17855":105354,"_5":17750,"_24230":105225,"_2452":105355},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_2926":61478,"_25561":61425,"_17855":105357,"_5":17750,"_24230":105225,"_2452":105358},[],"Lo que sí cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se ignora en silencio porque los campos JSON desconocidos se descartan, y las respuestas GET ya no lo incluyen. En consecuencia, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin devolver ningún error. Para evitarlo, leer siempre el DMS antes de enviar una edición y reutilizar el formato que devuelve la API.",{"_2926":61479,"_25561":61425,"_17855":105360,"_5":17750,"_24230":105229,"_2452":105361},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero antes de editar un DMS conviene leer ambos bloques para no modificar uno creyendo que se está editando el otro.",{"_2926":61480,"_25561":61425,"_17855":105363,"_5":17750,"_24230":105229,"_2452":105364},[],"Si la versión de la consola no expone los ajustes independientes, pueden editarse mediante la API DMS.",{"_2926":61481,"_25561":61425,"_17855":105366,"_5":17750,"_24230":105233,"_2452":105367},[],"Tras aplicar la actualización, comprobar en este orden:",{"_2926":61482,"_25561":61425,"_17855":105369,"_5":17750,"_24230":105233,"_2452":105370},[],"**Webhooks sin campos de archivo.** Listar los DMS que usan webhook en enrolamiento o reenrolamiento y confirmar que cada bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_2926":61483,"_25561":61425,"_17855":105372,"_5":17750,"_24230":105233,"_2452":105373},[],"**Verificación del receptor.** Confirmar que `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_2926":61484,"_25561":61425,"_17855":105375,"_5":17750,"_24230":105233,"_2452":105376},[],"**Entrega.** Lanzar, o esperar a que ocurra, un enrolamiento o reenrolamiento a través de cada webhook migrado y confirmar que la llamada de autorización se completa.",{"_2926":61485,"_25561":61425,"_17855":105378,"_5":17750,"_24230":105233,"_2452":105379},[],"**Conjunto de confianza.** Leer `est_rfc7030_settings.client_certificate_settings.validation_cas` y confirmar que contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_2926":61486,"_25561":61425,"_17855":105381,"_5":17750,"_24230":105233,"_2452":105382},[],"**Clientes de la API.** Actualizar los scripts y consolas que usen el formato antiguo del DMS (`additional_validation_cas` plano, o los campos `mtls`, `apikey` y `oidc` heredados), ya que descartan esos valores sin avisar.",{"_2926":61487,"_25561":61425,"_17855":105384,"_5":17750,"_24230":105233,"_2452":102130},[],{"_2926":61488,"_25561":61425,"_17855":105386,"_5":17750,"_24230":105233,"_2452":105387},[],"<Card title=\"API DMS\" href=\"/docs/api-reference/dms-manager\" />",{"_49297":105389,"_49299":105390,"_49301":105391,"_49303":105392,"_15501":2474,"_59050":2474},"spanish",[2452,25561,5,24230