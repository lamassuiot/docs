3008},[],{"_7897":110,"_22053":34,"_18699":32006,"_5":22186,"_15048":31774,"_1570":32007},[],"Ruta a chart local RabbitMQ (`.tgz`)",{"_7897":111,"_22053":34,"_18699":32009,"_5":22186,"_15048":31774,"_1570":32010},[],"`-l`, `--local-chart-path`",{"_7897":112,"_22053":34,"_18699":32012,"_5":22186,"_15048":31774,"_1570":3008},[],{"_7897":113,"_22053":34,"_18699":32014,"_5":22186,"_15048":31774,"_1570":32015},[],"Ruta a directorio local descomprimido del chart Lamassu",{"_7897":114,"_22053":34,"_18699":32017,"_5":22186,"_15048":31778,"_1570":32018},[],"La función `detect_distribution` identifica la distribución con el siguiente orden de prioridad:",{"_7897":115,"_22053":34,"_18699":32020,"_5":22186,"_15048":31778,"_1570":32021},[],"`microk8s`",{"_7897":116,"_22053":34,"_18699":32023,"_5":22186,"_15048":31778,"_1570":32024},[],"`k3s`",{"_7897":117,"_22053":34,"_18699":32026,"_5":22186,"_15048":31778,"_1570":32027},[],"`kind`",{"_7897":118,"_22053":34,"_18699":32029,"_5":22186,"_15048":31778,"_1570":32030},[],"Kubernetes estándar",{"_7897":119,"_22053":34,"_18699":32032,"_5":22186,"_15048":31778,"_1570":32033},[],"Comportamientos específicos:",{"_7897":120,"_22053":34,"_18699":32035,"_5":22186,"_15048":31778,"_1570":32036},[],"En `microk8s`, los comandos se ejecutan con prefijos `microk8s kubectl` y `microk8s helm`.",{"_7897":121,"_22053":34,"_18699":32038,"_5":22186,"_15048":31778,"_1570":32039},[],"En `kind`, el script muestra una advertencia de uso exclusivo para pruebas.",{"_7897":122,"_22053":34,"_18699":32041,"_5":22186,"_15048":31782,"_1570":32042},[],"La función `check_dependencies` valida prerequisitos según la distribución detectada.",{"_7897":123,"_22053":34,"_18699":32044,"_5":22186,"_15048":31782,"_1570":32045},[],"Requisitos generales:",{"_7897":124,"_22053":34,"_18699":32047,"_5":22186,"_15048":31782,"_1570":32048},[],"`yq`",{"_7897":125,"_22053":34,"_18699":32050,"_5":22186,"_15048":31782,"_1570":32051},[],"CLI de la distribución detectada",{"_7897":126,"_22053":34,"_18699":32053,"_5":22186,"_15048":31782,"_1570":32054},[],"Requisitos específicos:",{"_7897":127,"_22053":34,"_18699":32056,"_5":22186,"_15048":31782,"_1570":32057},[],"Distribución",{"_7897":128,"_22053":34,"_18699":32059,"_5":22186,"_15048":31782,"_1570":32060},[],"Herramientas requeridas",{"_7897":129,"_22053":34,"_18699":32062,"_5":22186,"_15048":31782,"_1570":32024},[],{"_7897":130,"_22053":34,"_18699":32064,"_5":22186,"_15048":31782,"_1570":32065},[],"`kubectl`, `helm`",{"_7897":131,"_22053":34,"_18699":32067,"_5":22186,"_15048":31782,"_1570":32021},[],{"_7897":132,"_22053":34,"_18699":32069,"_5":22186,"_15048":31782,"_1570":32070},[],"`microk8s kubectl`, `microk8s helm`",{"_7897":133,"_22053":34,"_18699":32072,"_5":22186,"_15048":31786,"_1570":32073},[],"Se valida que estén habilitados:",{"_7897":134,"_22053":34,"_18699":32075,"_5":22186,"_15048":31786,"_1570":32076},[],"`helm`",{"_7897":135,"_22053":34,"_18699":32078,"_5":22186,"_15048":31786,"_1570":32079},[],"`hostpath-storage`",{"_7897":136,"_22053":34,"_18699":32081,"_5":22186,"_15048":31786,"_1570":32082},[],"`dns`",{"_7897":137,"_22053":34,"_18699":32084,"_5":22186,"_15048":31786,"_1570":32085},[],"`cert-manager`",{"_7897":138,"_22053":34,"_18699":32087,"_5":22186,"_15048":31786,"_1570":32088},[],"También se verifica un release Helm de Envoy Gateway llamado `eg` en el namespace `envoy-gateway-system`.\nSi no existe, se instala automáticamente la versión `v1.3.0` y se crea un `GatewayClass` llamado `eg`.",{"_7897":139,"_22053":34,"_18699":32090,"_5":22186,"_15048":31794,"_1570":32091},[],"La función `request_config_data` solicita:",{"_7897":140,"_22053":34,"_18699":32093,"_5":22186,"_15048":31794,"_1570":32094},[],"Dominio Lamassu",{"_7897":141,"_22053":34,"_18699":32096,"_5":22186,"_15048":31794,"_1570":32097},[],"Usuario y contraseña admin PostgreSQL",{"_7897":142,"_22053":34,"_18699":32099,"_5":22186,"_15048":31794,"_1570":32100},[],"Usuario y contraseña admin RabbitMQ",{"_7897":143,"_22053":34,"_18699":32102,"_5":22186,"_15048":31794,"_1570":32103},[],"Usuario y contraseña admin Keycloak",{"_7897":144,"_22053":34,"_18699":32105,"_5":22186,"_15048":31794,"_1570":32106},[],"Namespace Kubernetes",{"_7897":145,"_22053":34,"_18699":32108,"_5":22186,"_15048":31798,"_1570":32109},[],"Se generan credenciales aleatorias de 30 caracteres alfanuméricos.",{"_7897":146,"_22053":34,"_18699":32111,"_5":22186,"_15048":31798,"_1570":32112},[],"Se usan valores por defecto para dominio y namespace, salvo que se sobrescriban con flags.",{"_7897":147,"_22053":34,"_18699":32114,"_5":22186,"_15048":31802,"_1570":32115},[],"El script admite dos estrategias para obtener charts Helm.",{"_7897":148,"_22053":34,"_18699":32117,"_5":22186,"_15048":31806,"_1570":32118},[],"Los charts se descargan desde repositorios remotos.",{"_7897":149,"_22053":34,"_18699":32120,"_5":22186,"_15048":31810,"_1570":32121},[],"Requiere obligatoriamente rutas a los cuatro charts:",{"_7897":150,"_22053":34,"_18699":32123,"_5":22186,"_15048":31810,"_1570":31978},[],{"_7897":151,"_22053":34,"_18699":32125,"_5":22186,"_15048":31810,"_1570":31986},[],{"_7897":152,"_22053":34,"_18699":32127,"_5":22186,"_15048":31810,"_1570":31994},[],{"_7897":153,"_22053":34,"_18699":32129,"_5":22186,"_15048":31810,"_1570":32002},[],{"_7897":154,"_22053":34,"_18699":32131,"_5":22186,"_15048":31810,"_1570":32132},[],"Si falta cualquiera de ellos, el script finaliza con error.",{"_7897":155,"_22053":34,"_18699":32134,"_5":22186,"_15048":31810,"_1570":32135},[],"En este modo se fuerza:",{"_7897":156,"_22053":34,"_18699":32137,"_5":22186,"_15048":31818,"_1570":32138},[],"Chart: `oci://registry-1.docker.io/cloudpirates/postgres`",{"_7897":157,"_22053":34,"_18699":32140,"_5":22186,"_15048":31818,"_1570":32141},[],"Versión del chart: `0.19.0`",{"_7897":158,"_22053":34,"_18699":32143,"_5":22186,"_15048":31818,"_1570":32144},[],"Release: `postgres`",{"_7897":159,"_22053":34,"_18699":32146,"_5":22186,"_15048":31818,"_1570":32147},[],"`fullnameOverride: \"postgresql\"`",{"_7897":160,"_22053":34,"_18699":32149,"_5":22186,"_15048":31818,"_1570":32150},[],"Se crea un script SQL de inicialización con estas bases de datos:",{"_7897":161,"_22053":34,"_18699":32152,"_5":22186,"_15048":31818,"_1570":32153},[],"Base de datos",{"_7897":162,"_22053":34,"_18699":32155,"_5":22186,"_15048":31818,"_1570":32156},[],"Servicio",{"_7897":163,"_22053":34,"_18699":32158,"_5":22186,"_15048":31818,"_1570":32159},[],"`auth`",{"_7897":164,"_22053":34,"_18699":32161,"_5":22186,"_15048":31818,"_1570":31871},[],{"_7897":165,"_22053":34,"_18699":32163,"_5":22186,"_15048":31818,"_1570":32164},[],"`alerts`",{"_7897":166,"_22053":34,"_18699":32166,"_5":22186,"_15048":31818,"_1570":32167},[],"Alerts",{"_7897":167,"_22053":34,"_18699":32169,"_5":22186,"_15048":31818,"_1570":32170},[],"`ca`",{"_7897":168,"_22053":34,"_18699":32172,"_5":22186,"_15048":31818,"_1570":32173},[],"CA",{"_7897":169,"_22053":34,"_18699":32175,"_5":22186,"_15048":31818,"_1570":32176},[],"`va`",{"_7897":170,"_22053":34,"_18699":32178,"_5":22186,"_15048":31818,"_1570":32179},[],"VA",{"_7897":171,"_22053":34,"_18699":32181,"_5":22186,"_15048":31818,"_1570":32182},[],"`cloudproxy`",{"_7897":172,"_22053":34,"_18699":32184,"_5":22186,"_15048":31818,"_1570":32185},[],"Cloud Proxy",{"_7897":173,"_22053":34,"_18699":32187,"_5":22186,"_15048":31818,"_1570":32188},[],"`devicemanager`",{"_7897":174,"_22053":34,"_18699":32190,"_5":22186,"_15048":31818,"_1570":32191},[],"Device Manager",{"_7897":175,"_22053":34,"_18699":32193,"_5":22186,"_15048":31818,"_1570":32194},[],"`dmsmanager`",{"_7897":176,"_22053":34,"_18699":32196,"_5":22186,"_15048":31818,"_1570":32197},[],"DMS Manager",{"_7897":177,"_22053":34,"_18699":32199,"_5":22186,"_15048":31818,"_1570":32200},[],"`kms`",{"_7897":178,"_22053":34,"_18699":32202,"_5":22186,"_15048":31818,"_1570":32203},[],"KMS",{"_7897":179,"_22053":34,"_18699":32205,"_5":22186,"_15048":31822,"_1570":32206},[],"Chart: `oci://registry-1.docker.io/cloudpirates/keycloak`",{"_7897":180,"_22053":34,"_18699":32208,"_5":22186,"_15048":31822,"_1570":32209},[],"Versión del chart: `0.20.0`",{"_7897":181,"_22053":34,"_18699":32211,"_5":22186,"_15048":31822,"_1570":32212},[],"Release: `auth`",{"_7897":182,"_22053":34,"_18699":32214,"_5":22186,"_15048":31822,"_1570":32215},[],"Uso de base de datos externa: `postgresql:5432/auth`",{"_7897":183,"_22053":34,"_18699":32217,"_5":22186,"_15048":31822,"_1570":32218},[],"Imagen de Keycloak fijada en `keycloak/keycloak:26.6.0`",{"_7897":184,"_22053":34,"_18699":32220,"_5":22186,"_15048":31822,"_1570":32221},[],"`httpRelativePath: /auth/`",{"_7897":185,"_22053":34,"_18699":32223,"_5":22186,"_15048":31822,"_1570":32224},[],"`proxyHeaders: xforwarded`",{"_7897":186,"_22053":34,"_18699":32226,"_5":22186,"_15048":31822,"_1570":32227},[],"Configuración automática del realm `lamassu`:",{"_7897":187,"_22053":34,"_18699":32229,"_5":22186,"_15048":31822,"_1570":32230},[],"Rol: `pki-admin`",{"_7897":188,"_22053":34,"_18699":32232,"_5":22186,"_15048":31822,"_1570":32233},[],"Usuario inicial: `lamassu` / `lamassu` (cambio obligatorio)",{"_7897":189,"_22053":34,"_18699":32235,"_5":22186,"_15048":31822,"_1570":32236},[],"Cliente público: `frontend` con `/*` en redirect URIs",{"_7897":190,"_22053":34,"_18699":32238,"_5":22186,"_15048":31822,"_1570":32239},[],"En modo online se descarga automáticamente un tema personalizado desde:",{"_7897":191,"_22053":34,"_18699":32241,"_5":22186,"_15048":31822,"_1570":32242},[],"`github.com/lamassuiot/keycloak-theme`",{"_7897":192,"_22053":34,"_18699":32244,"_5":22186,"_15048":31826,"_1570":32245},[],"Chart: `oci://registry-1.docker.io/cloudpirates/rabbitmq`",{"_7897":193,"_22053":34,"_18699":32247,"_5":22186,"_15048":31826,"_1570":32209},[],{"_7897":194,"_22053":34,"_18699":32249,"_5":22186,"_15048":31826,"_1570":32250},[],"Release: `rabbitmq`",{"_7897":195,"_22053":34,"_18699":32252,"_5":22186,"_15048":31826,"_1570":32253},[],"`fullnameOverride: \"rabbitmq\"`",{"_7897":196,"_22053":34,"_18699":32255,"_5":22186,"_15048":31826,"_1570":32256},[],"Credenciales inyectadas dinámicamente mediante `yq`",{"_7897":197,"_22053":34,"_18699":32258,"_5":22186,"_15048":31830,"_1570":32259},[],"Se genera un archivo `lamassu.yaml` que se pasa a `helm install`.",{"_7897":198,"_22053":34,"_18699":32261,"_5":22186,"_15048":31830,"_1570":32262},[],"Configuraciones principales:",{"_7897":199,"_22053":34,"_18699":32264,"_5":22186,"_15048":31830,"_1570":32265},[],"PostgreSQL: host `postgresql`, puerto `5432`",{"_7897":200,"_22053":34,"_18699":32267,"_5":22186,"_15048":31830,"_1570":32268},[],"AMQP: host `rabbitmq`, puerto `5672`, TLS deshabilitado",{"_7897":201,"_22053":34,"_18699":32270,"_5":22186,"_15048":31830,"_1570":32271},[],"OIDC JWKS:\n`http://auth-keycloak.<NAMESPACE>/auth/realms/lamassu/protocol/openid-connect/certs`",{"_7897":202,"_22053":34,"_18699":32273,"_5":22186,"_15048":31830,"_1570":32274},[],"Ruta adicional de gateway: `/auth -> auth-keycloak:8080`",{"_7897":203,"_22053":34,"_18699":32276,"_5":22186,"_15048":31830,"_1570":32277},[],"Direcciones de gateway: IP(s) obtenidas con `hostname -I`",{"_7897":204,"_22053":34,"_18699":32279,"_5":22186,"_15048":31830,"_1570":32280},[],"Puertos de gateway: desde `--https-port` y `--http-port`",{"_7897":205,"_22053":34,"_18699":32282,"_5":22186,"_15048":31830,"_1570":32283},[],"Dominios CA: valor de `--domain`",{"_7897":206,"_22053":34,"_18699":32285,"_5":22186,"_15048":31830,"_1570":32286},[],"Cuando se ejecuta en modo online y no se usa `--local-chart-path`, el script añade el repositorio Helm:",{"_7897":207,"_22053":34,"_18699":32288,"_5":22186,"_15048":31830,"_1570":32289},[],"Después instala el release `lamassu` usando la versión indicada por `--version` si se ha proporcionado.",{"_7897":208,"_22053":34,"_18699":32291,"_5":22186,"_15048":31830,"_1570":32292},[],"Si `--https-port` es distinto de `443`, el puerto se añade al dominio antes de escribirlo en `values`.",{"_7897":209,"_22053":34,"_18699":32294,"_5":22186,"_15048":31838,"_1570":32295},[],"Si se proporcionan:",{"_7897":210,"_22053":34,"_18699":32297,"_5":22186,"_15048":31838,"_1570":31962},[],{"_7897":211,"_22053":34,"_18699":32299,"_5":22186,"_15048":31838,"_1570":31970},[],{"_7897":212,"_22053":34,"_18699":32301,"_5":22186,"_15048":31838,"_1570":32302},[],"Se crea un secret Kubernetes:",{"_7897":213,"_22053":34,"_18699":32304,"_5":22186,"_15048":31838,"_1570":32305},[],"`downstream-provided-crt`",{"_7897":214,"_22053":34,"_18699":32307,"_5":22186,"_15048":31838,"_1570":32308},[],"Y se configura:",{"_7897":215,"_22053":34,"_18699":32310,"_5":22186,"_15048":31842,"_1570":32311},[],"Si no se proporciona certificado:",{"_7897":216,"_22053":34,"_18699":32313,"_5":22186,"_15048":31842,"_1570":32314},[],"Además, el script crea un `Issuer` self-signed y el recurso `Certificate`.",{"_7897":217,"_22053":34,"_18699":32316,"_5":22186,"_15048":31842,"_1570":32317},[],"Si el usuario quiere reutilizar un `Issuer` o `ClusterIssuer` corporativo, ese flujo no lo automatiza Fastlane; en ese caso es preferible un despliegue manual del chart con un archivo `values.yaml` propio.",{"_7897":218,"_22053":34,"_18699":32319,"_5":22186,"_15048":31846,"_1570":32320},[],"En caso de éxito, se muestra:",{"_7897":219,"_22053":34,"_18699":32322,"_5":22186,"_15048":31846,"_1570":32323},[],"URL de Lamassu UI: `https://<DOMAIN>`",{"_7897":220,"_22053":34,"_18699":32325,"_5":22186,"_15048":31846,"_1570":32326},[],"Credenciales iniciales: `lamassu / lamassu`",{"_7897":221,"_22053":34,"_18699":32328,"_5":22186,"_15048":31846,"_1570":32329},[],"Consola Keycloak: `https://<DOMAIN>/auth/admin`",{"_7897":222,"_22053":34,"_18699":32331,"_5":22186,"_15048":31846,"_1570":32332},[],"Credenciales admin de Keycloak",{"_7897":223,"_22053":34,"_18699":32334,"_5":22186,"_15048":31846,"_1570":32335},[],"El usuario `lamassu` se crea con:",{"_7897":224,"_22053":34,"_18699":32337,"_5":22186,"_15048":31846,"_1570":32338},[],"Por tanto, debe cambiar contraseña en el primer acceso.",{"_7897":225,"_22053":34,"_18699":32340,"_5":22186,"_15048":31850,"_1570":32341},[],"El script está pensado también para validaciones rápidas y smoke tests locales. Tras la instalación puede ejecutarse:",{"_7897":226,"_22053":34,"_18699":32343,"_5":22186,"_15048":31850,"_1570":32344},[],"El chart incluye una prueba que valida conectividad contra `ca`, `dms-manager`, `device-manager`, `va` y `ui`.",{"_7897":227,"_22053":34,"_18699":32346,"_5":22186,"_15048":31850,"_1570":32347},[],"Ejemplo:",{"_7897":228,"_22053":34,"_18699":32349,"_5":22186,"_15048":31850,"_1570":32350},[],"En este escenario:",{"_7897":229,"_22053":34,"_18699":32352,"_5":22186,"_15048":31850,"_1570":32353},[],"`-n`: modo no interactivo",{"_7897":230,"_22053":34,"_18699":32355,"_5":22186,"_15048":31850,"_1570":32356},[],"`-ns`: namespace específico",{"_7897":231,"_22053":34,"_18699":32358,"_5":22186,"_15048":31850,"_1570":32359},[],"`-d`: dominio de CI",{"_7897":232,"_22053":34,"_18699":32361,"_5":22186,"_15048":31850,"_1570":32362},[],"`-l`: chart local",{"_7897":233,"_22053":34,"_18699":32364,"_5":22186,"_15048":31858,"_1570":32365},[],"`lamassu-fast-lane.sh` proporciona un mecanismo totalmente automatizado para desplegar un entorno Lamassu funcional en Kubernetes en pocos minutos, integrando base de datos, autenticación, mensajería, gateway y TLS.",{"_7897":234,"_22053":34,"_18699":32367,"_5":22186,"_15048":31858,"_1570":32368},[],"Está optimizado para rapidez, reproducibilidad y uso en entornos no productivos, con soporte para escenarios offline y pipelines de CI.",{"_7897":235,"_22053":235,"_5":22181,"_1570":32370,"_22194":32371,"_18699":32372,"_15048":235},"Introducción",[31686,31687,31738],[],{"_7897":236,"_22053":235,"_18699":32374,"_5":22186,"_15048":235,"_1570":32375},[],"Despliegue de Lamassu IoT en infraestructura on-premise gestionada con Kubernetes",{"_7897":237,"_22053":235,"_5":22191,"_18699":32377,"_15048":32378,"_1570":32379},[],"/docs/despliegue/onprem#despliegue-onprem-con-kubernetes","Despliegue OnPrem con Kubernetes",{"_7897":238,"_22053":235,"_5":22191,"_18699":32381,"_15048":32382,"_1570":32383},[],"/docs/despliegue/onprem#quickstart","Quickstart",{"_7897":239,"_22053":235,"_5":22191,"_18699":32385,"_15048":32386,"_1570":32387},[],"/docs/despliegue/onprem#qué-se-despliega","Qué se despliega",{"_7897":240,"_22053":235,"_5":22191,"_18699":32389,"_15048":32390,"_1570":32391},[],"/docs/despliegue/onprem#requisitos-previos","Requisitos previos",{"_7897":241,"_22053":235,"_5":22191,"_18699":32393,"_15048":32394,"_1570":32395},[],"/docs/despliegue/onprem#opciones-de-despliegue","Opciones de despliegue",{"_7897":242,"_22053":235,"_5":22191,"_18699":32397,"_15048":32398,"_1570":32399},[],"/docs/despliegue/onprem#1-despliegue-manual-con-helm","1\\. Despliegue manual con Helm",{"_7897":243,"_22053":235,"_5":22191,"_18699":32401,"_15048":32402,"_1570":32403},[],"/docs/despliegue/onprem#2-despliegue-automatizado-con-fastlane","2\\. Despliegue automatizado con Fastlane",{"_7897":244,"_22053":235,"_5":22191,"_18699":32405,"_15048":32406,"_1570":32407},[],"/docs/despliegue/onprem#arquitectura","Arquitectura",{"_7897":245,"_22053":235,"_5":22191,"_18699":32409,"_15048":32410,"_1570":32411},[],"/docs/despliegue/onprem#instalación-manual-con-helm","Instalación manual con Helm",{"_7897":246,"_22053":235,"_5":22191,"_18699":32413,"_15048":32414,"_1570":32415},[],"/docs/despliegue/onprem#valores-mínimos-que-deben-definirse","Valores mínimos que deben definirse",{"_7897":247,"_22053":235,"_5":22191,"_18699":32417,"_15048":32418,"_1570":32419},[],"/docs/despliegue/onprem#áreas-de-configuración-más-relevantes","Áreas de configuración más relevantes",{"_7897":248,"_22053":235,"_5":22191,"_18699":32421,"_15048":32422,"_1570":32423},[],"/docs/despliegue/onprem#verificación-del-despliegue","Verificación del despliegue",{"_7897":249,"_22053":235,"_5":22191,"_18699":32425,"_15048":32426,"_1570":32427},[],"/docs/despliegue/onprem#repositorio-helm","Repositorio Helm",{"_7897":250,"_22053":235,"_5":22191,"_18699":32429,"_15048":32430,"_1570":32431},[],"/docs/despliegue/onprem#softhsm-como-complemento-opcional","SoftHSM como complemento opcional",{"_7897":251,"_22053":235,"_5":22191,"_18699":32433,"_15048":32434,"_1570":32435},[],"/docs/despliegue/onprem#versionado-y-migraciones","Versionado y migraciones",{"_7897":252,"_22053":235,"_18699":32437,"_5":22186,"_15048":32378,"_1570":32438},[],"Lamassu IoT puede desplegarse en infraestructura propia mediante **Kubernetes**, tanto en clústeres gestionados internamente como en entornos self-managed.",{"_7897":253,"_22053":235,"_18699":32440,"_5":22186,"_15048":32378,"_1570":32441},[],"La referencia principal para este despliegue es el repositorio `lamassu-helm`, que incluye:",{"_7897":254,"_22053":235,"_18699":32443,"_5":22186,"_15048":32378,"_1570":32444},[],"el chart principal de Lamassu",{"_7897":255,"_22053":235,"_18699":32446,"_5":22186,"_15048":32378,"_1570":32447},[],"un chart auxiliar de SoftHSM",{"_7897":256,"_22053":235,"_18699":32449,"_5":22186,"_15048":32378,"_1570":32450},[],"el script de despliegue automatizado `scripts/lamassu-fast-lane.sh`",{"_7897":257,"_22053":235,"_18699":32452,"_5":22186,"_15048":32382,"_1570":32453},[],"Si lo que necesitas es levantar un entorno funcional lo antes posible, la vía más rápida es usar Fastlane desde el repositorio `lamassu-helm`:",{"_7897":258,"_22053":235,"_18699":32455,"_5":22186,"_15048":32382,"_1570":32456},[],"Ese flujo:",{"_7897":259,"_22053":235,"_18699":32458,"_5":22186,"_15048":32382,"_1570":32459},[],"crea o reutiliza el namespace indicado",{"_7897":260,"_22053":235,"_18699":32461,"_5":22186,"_15048":32382,"_1570":32462},[],"instala PostgreSQL, Keycloak y RabbitMQ",{"_7897":261,"_22053":235,"_18699":32464,"_5":22186,"_15048":32382,"_1570":32465},[],"despliega el chart de Lamassu",{"_7897":262,"_22053":235,"_18699":32467,"_5":22186,"_15048":32382,"_1570":32468},[],"deja la UI expuesta en `https://<dominio>`",{"_7897":263,"_22053":235,"_18699":32470,"_5":22186,"_15048":32382,"_1570":32471},[],"Si buscas un despliegue productivo o más controlado, sigue con la instalación manual mediante Helm que se describe más abajo.",{"_7897":264,"_22053":235,"_18699":32473,"_5":22186,"_15048":32386,"_1570":32474},[],"El chart principal `charts/lamassu`, actualmente en la serie `3.7.x`, despliega estos componentes:",{"_7897":265,"_22053":235,"_18699":32476,"_5":22186,"_15048":32386,"_1570":32477},[],"`ui`",{"_7897":266,"_22053":235,"_18699":32479,"_5":22186,"_15048":32386,"_1570":32170},[],{"_7897":267,"_22053":235,"_18699":32481,"_5":22186,"_15048":32386,"_1570":32176},[],{"_7897":268,"_22053":235,"_18699":32483,"_5":22186,"_15048":32386,"_1570":32200},[],{"_7897":269,"_22053":235,"_18699":32485,"_5":22186,"_15048":32386,"_1570":32486},[],"`device-manager`",{"_7897":270,"_22053":235,"_18699":32488,"_5":22186,"_15048":32386,"_1570":32489},[],"`dms-manager`",{"_7897":271,"_22053":235,"_18699":32491,"_5":22186,"_15048":32386,"_1570":32164},[],{"_7897":272,"_22053":235,"_18699":32493,"_5":22186,"_15048":32386,"_1570":32494},[],"recursos de Gateway API y políticas de Envoy Gateway",{"_7897":273,"_22053":235,"_18699":32496,"_5":22186,"_15048":32386,"_1570":32497},[],"job de migraciones de base de datos",{"_7897":274,"_22053":235,"_18699":32499,"_5":22186,"_15048":32390,"_1570":32500},[],"Clúster Kubernetes `1.19+`",{"_7897":275,"_22053":235,"_18699":32502,"_5":22186,"_15048":32390,"_1570":32503},[],"`kubectl` configurado con acceso al clúster",{"_7897":276,"_22053":235,"_18699":32505,"_5":22186,"_15048":32390,"_1570":32506},[],"Helm `3.2.0+`",{"_7897":277,"_22053":235,"_18699":32508,"_5":22186,"_15048":32390,"_1570":32509},[],"`cert-manager 1.14+` para la gestión de certificados cuando se usa `tls.type=certManager`",{"_7897":278,"_22053":235,"_18699":32511,"_5":22186,"_15048":32390,"_1570":32512},[],"`Envoy Gateway 1.3.0+`, ya que el chart publica servicios mediante Gateway API y no mediante Ingress",{"_7897":279,"_22053":235,"_18699":32514,"_5":22186,"_15048":32390,"_1570":32515},[],"Acceso a un registro de contenedores o imágenes previamente importadas si se trabaja en modo offline",{"_7897":280,"_22053":235,"_18699":32517,"_5":22186,"_15048":32390,"_1570":32518},[],"Almacenamiento persistente disponible para PostgreSQL, RabbitMQ, VA y KMS",{"_7897":281,"_22053":235,"_18699":32520,"_5":22186,"_15048":32394,"_1570":32521},[],"Hay dos formas de desplegar Lamassu on-prem:",{"_7897":282,"_22053":235,"_18699":32523,"_5":22186,"_15048":32398,"_1570":32524},[],"Es la opción recomendada para entornos productivos o controlados, donde PostgreSQL, RabbitMQ, Keycloak, certificados y direccionamiento del Gateway ya están definidos por el equipo de plataforma.",{"_7897":283,"_22053":235,"_18699":32526,"_5":22186,"_15048":32402,"_1570":32527},[],"Es la opción más útil para pruebas, demos, CI o bootstrap rápido de un entorno. Fastlane levanta PostgreSQL, Keycloak, RabbitMQ y Lamassu en un único flujo. Su comportamiento está documentado en la página siguiente.",{"_7897":284,"_22053":235,"_18699":32529,"_5":22186,"_15048":32406,"_1570":32530},[],"Lamassu IoT se despliega como un conjunto de microservicios Kubernetes independientes. El chart principal crea `Deployment`, `StatefulSet`, `Service`, `ConfigMap`, `HTTPRoute`, `Gateway`, certificados y recursos auxiliares según los valores definidos.",{"_7897":285,"_22053":235,"_18699":32532,"_5":22186,"_15048":32406,"_1570":32533},[],"Dependencias externas requeridas por el chart principal:",{"_7897":286,"_22053":235,"_18699":32535,"_5":22186,"_15048":32406,"_1570":31868},[],{"_7897":287,"_22053":235,"_18699":32537,"_5":22186,"_15048":32406,"_1570":31874},[],{"_7897":288,"_22053":235,"_18699":32539,"_5":22186,"_15048":32406,"_1570":32540},[],"proveedor OIDC, típicamente Keycloak",{"_7897":289,"_22053":235,"_18699":32542,"_5":22186,"_15048":32406,"_1570":32543},[],"El chart no instala estas dependencias por sí solo. Para un despliegue manual hay que provisionarlas antes. Si se busca un entorno funcional rápido para laboratorio o validación, el script Fastlane sí instala PostgreSQL, RabbitMQ y Keycloak además del chart de Lamassu.",{"_7897":290,"_22053":235,"_18699":32545,"_5":22186,"_15048":32410,"_1570":32546},[],"Agregar el repositorio Helm:",{"_7897":291,"_22053":235,"_18699":32548,"_5":22186,"_15048":32410,"_1570":32549},[],"O instalar desde una copia local del repositorio:",{"_7897":292,"_22053":235,"_18699":32551,"_5":22186,"_15048":32414,"_1570":32552},[],"Los valores por defecto del chart son deliberadamente incompletos para dependencias externas. Como mínimo, un despliegue manual debe definir:",{"_7897":293,"_22053":235,"_18699":32554,"_5":22186,"_15048":32414,"_1570":32555},[],"`postgres.hostname`, `postgres.username`, `postgres.password`",{"_7897":294,"_22053":235,"_18699":32557,"_5":22186,"_15048":32414,"_1570":32558},[],"`amqp.hostname`, `amqp.username`, `amqp.password`",{"_7897":295,"_22053":235,"_18699":32560,"_5":22186,"_15048":32414,"_1570":32561},[],"`auth.oidc.frontend.authority`",{"_7897":296,"_22053":235,"_18699":32563,"_5":22186,"_15048":32414,"_1570":32564},[],"`auth.oidc.apiGateway.jwks`",{"_7897":297,"_22053":235,"_18699":32566,"_5":22186,"_15048":32414,"_1570":32567},[],"`services.ca.domains`",{"_7897":298,"_22053":235,"_18699":32569,"_5":22186,"_15048":32414,"_1570":32570},[],"`gateway.addresses` o una estrategia equivalente de publicación según el clúster",{"_7897":299,"_22053":235,"_18699":32572,"_5":22186,"_15048":32414,"_1570":32573},[],"`tls.*` según se use `certManager` o certificado externo",{"_7897":300,"_22053":235,"_18699":32575,"_5":22186,"_15048":32414,"_1570":32576},[],"Ejemplo base:",{"_7897":301,"_22053":235,"_18699":32578,"_5":22186,"_15048":32418,"_1570":32579},[],"Área",{"_7897":302,"_22053":235,"_18699":32581,"_5":22186,"_15048":32418,"_1570":32582},[],"Valores clave",{"_7897":303,"_22053":235,"_18699":32584,"_5":22186,"_15048":32418,"_1570":32585},[],"Uso",{"_7897":304,"_22053":235,"_18699":32587,"_5":22186,"_15048":32418,"_1570":32588},[],"TLS",{"_7897":305,"_22053":235,"_18699":32590,"_5":22186,"_15048":32418,"_1570":32591},[],"`tls.type`, `tls.certManagerOptions.*`, `tls.externalOptions.secretName`",{"_7897":306,"_22053":235,"_18699":32593,"_5":22186,"_15048":32418,"_1570":32594},[],"Certificado downstream del Gateway",{"_7897":307,"_22053":235,"_18699":32596,"_5":22186,"_15048":32418,"_1570":32597},[],"Gateway",{"_7897":308,"_22053":235,"_18699":32599,"_5":22186,"_15048":32418,"_1570":32600},[],"`gateway.addresses`, `gateway.ports.*`, `gateway.extraRouting`",{"_7897":309,"_22053":235,"_18699":32602,"_5":22186,"_15048":32418,"_1570":32603},[],"Exposición de UI y APIs vía Envoy Gateway",{"_7897":310,"_22053":235,"_18699":32605,"_5":22186,"_15048":32418,"_1570":32153},[],{"_7897":311,"_22053":235,"_18699":32607,"_5":22186,"_15048":32418,"_1570":32608},[],"`postgres.*`",{"_7897":312,"_22053":235,"_18699":32610,"_5":22186,"_15048":32418,"_1570":32611},[],"Conexión a PostgreSQL externa",{"_7897":313,"_22053":235,"_18699":32613,"_5":22186,"_15048":32418,"_1570":32614},[],"Mensajería",{"_7897":314,"_22053":235,"_18699":32616,"_5":22186,"_15048":32418,"_1570":32617},[],"`amqp.*`",{"_7897":315,"_22053":235,"_18699":32619,"_5":22186,"_15048":32418,"_1570":32620},[],"Conexión a RabbitMQ",{"_7897":316,"_22053":235,"_18699":32622,"_5":22186,"_15048":32418,"_1570":32623},[],"OIDC",{"_7897":317,"_22053":235,"_18699":32625,"_5":22186,"_15048":32418,"_1570":32626},[],"`auth.oidc.frontend.*`, `auth.oidc.apiGateway.jwks`",{"_7897":318,"_22053":235,"_18699":32628,"_5":22186,"_15048":32418,"_1570":32629},[],"Login de UI y validación JWT en el Gateway",{"_7897":319,"_22053":235,"_18699":32631,"_5":22186,"_15048":32418,"_1570":32173},[],{"_7897":320,"_22053":235,"_18699":32633,"_5":22186,"_15048":32418,"_1570":32567},[],{"_7897":321,"_22053":235,"_18699":32635,"_5":22186,"_15048":32418,"_1570":32636},[],"Dominios autorizados para CA y certificados",{"_7897":322,"_22053":235,"_18699":32638,"_5":22186,"_15048":32418,"_1570":32203},[],{"_7897":323,"_22053":235,"_18699":32640,"_5":22186,"_15048":32418,"_1570":32641},[],"`services.kms.cryptoEngines.*`",{"_7897":324,"_22053":235,"_18699":32643,"_5":22186,"_15048":32418,"_1570":32644},[],"Motor criptográfico y almacenamiento de claves",{"_7897":325,"_22053":235,"_18699":32646,"_5":22186,"_15048":32418,"_1570":32167},[],{"_7897":326,"_22053":235,"_18699":32648,"_5":22186,"_15048":32418,"_1570":32649},[],"`services.alerts.smtp_server.*`",{"_7897":327,"_22053":235,"_18699":32651,"_5":22186,"_15048":32418,"_1570":32652},[],"Envío de correo para alertas",{"_7897":328,"_22053":235,"_18699":32654,"_5":22186,"_15048":32422,"_1570":32655},[],"El chart incluye una prueba Helm en `charts/lamassu/templates/tests/test-connections.yml`. Tras instalarlo, puede validarse con:",{"_7897":329,"_22053":235,"_18699":32657,"_5":22186,"_15048":32422,"_1570":32658},[],"La prueba comprueba al menos:",{"_7897":330,"_22053":235,"_18699":32660,"_5":22186,"_15048":32422,"_1570":32661},[],"salud de `ca`",{"_7897":331,"_22053":235,"_18699":32663,"_5":22186,"_15048":32422,"_1570":32664},[],"salud de `dms-manager`",{"_7897":332,"_22053":235,"_18699":32666,"_5":22186,"_15048":32422,"_1570":32667},[],"salud de `device-manager`",{"_7897":333,"_22053":235,"_18699":32669,"_5":22186,"_15048":32422,"_1570":32670},[],"salud de `va`",{"_7897":334,"_22053":235,"_18699":32672,"_5":22186,"_15048":32422,"_1570":32673},[],"respuesta HTML esperada del servicio `ui`",{"_7897":335,"_22053":235,"_18699":32675,"_5":22186,"_15048":32426,"_1570":32676},[],"El repositorio `lamassu-helm` está organizado en tres bloques principales:",{"_7897":336,"_22053":235,"_18699":32678,"_5":22186,"_15048":32426,"_1570":32679},[],"`charts/lamassu`: chart principal de Lamassu",{"_7897":337,"_22053":235,"_18699":32681,"_5":22186,"_15048":32426,"_1570":32682},[],"`charts/softhsm`: chart opcional para laboratorios o escenarios de integración con PKCS#11 emulado",{"_7897":338,"_22053":235,"_18699":32684,"_5":22186,"_15048":32426,"_1570":32685},[],"`scripts/lamassu-fast-lane.sh`: automatización para levantar dependencias y desplegar Lamassu con intervención mínima",{"_7897":339,"_22053":235,"_18699":32687,"_5":22186,"_15048":32430,"_1570":32688},[],"El chart `charts/softhsm` no forma parte del despliegue estándar, pero resulta útil en entornos de laboratorio cuando se necesita simular un HSM compatible con PKCS#11. No sustituye al backend KMS principal; sirve como soporte para pruebas o integraciones concretas.",{"_7897":340,"_22053":235,"_18699":32690,"_5":22186,"_15048":32434,"_1570":32691},[],"La serie actual del chart principal es `3.7.x`. Para upgrades entre versiones, el repositorio incluye guías específicas en `charts/lamassu/CHANGELOG/`, especialmente en cambios importantes como la adopción de Envoy Gateway o la introducción del servicio KMS.",{"_7897":341,"_22053":341,"_5":22181,"_1570":32693,"_22194":32694,"_18699":32695,"_15048":341},"SaaS · Suscripción",[31686,31687,31745],[],{"_7897":342,"_22053":341,"_18699":32697,"_5":22186,"_15048":341,"_1570":32698},[],"Acceso a Lamassu IoT como servicio gestionado basado en suscripción",{"_7897":343,"_22053":341,"_5":22191,"_18699":32700,"_15048":32701,"_1570":32702},[],"/docs/despliegue/saas#lamassu-iot-saas--basada-en-suscripción","Lamassu IoT SaaS – Basada en suscripción",{"_7897":344,"_22053":341,"_5":22191,"_18699":32704,"_15048":32705,"_1570":32706},[],"/docs/despliegue/saas#qué-incluye-la-suscripción","¿Qué incluye la suscripción?",{"_7897":345,"_22053":341,"_5":22191,"_18699":32708,"_15048":32709,"_1570":32710},[],"/docs/despliegue/saas#planes-disponibles","Planes disponibles",{"_7897":346,"_22053":341,"_5":22191,"_18699":32712,"_15048":32713,"_1570":32714},[],"/docs/despliegue/saas#contacto","Contacto",{"_7897":347,"_22053":341,"_18699":32716,"_5":22186,"_15048":32701,"_1570":32717},[],"La modalidad **SaaS** de Lamassu IoT ofrece acceso completo a la plataforma como servicio totalmente gestionado por LKS Next, sin necesidad de gestionar infraestructura propia.",{"_7897":348,"_22053":341,"_18699":32719,"_5":22186,"_15048":32705,"_1570":32720},[],"Acceso a la plataforma Lamassu IoT completamente gestionada",{"_7897":349,"_22053":341,"_18699":32722,"_5":22186,"_15048":32705,"_1570":32723},[],"Alta disponibilidad y backups automáticos",{"_7897":350,"_22053":341,"_18699":32725,"_5":22186,"_15048":32705,"_1570":32726},[],"Actualizaciones automáticas a las últimas versiones",{"_7897":351,"_22053":341,"_18699":32728,"_5":22186,"_15048":32705,"_1570":32729},[],"Soporte técnico incluido",{"_7897":352,"_22053":341,"_18699":32731,"_5":22186,"_15048":32705,"_1570":32732},[],"SLA garantizado",{"_7897":353,"_22053":341,"_18699":32734,"_5":22186,"_15048":32709,"_1570":32735},[],"Plan",{"_7897":354,"_22053":341,"_18699":32737,"_5":22186,"_15048":32709,"_1570":32738},[],"Dispositivos",{"_7897":355,"_22053":341,"_18699":32740,"_5":22186,"_15048":32709,"_1570":32741},[],"Soporte",{"_7897":356,"_22053":341,"_18699":32743,"_5":22186,"_15048":32709,"_1570":32744},[],"SLA",{"_7897":357,"_22053":341,"_18699":32746,"_5":22186,"_15048":32709,"_1570":32747},[],"Starter",{"_7897":358,"_22053":341,"_18699":32749,"_5":22186,"_15048":32709,"_1570":32750},[],"Hasta 1.000",{"_7897":359,"_22053":341,"_18699":32752,"_5":22186,"_15048":32709,"_1570":32753},[],"Email",{"_7897":360,"_22053":341,"_18699":32755,"_5":22186,"_15048":32709,"_1570":32756},[],"99,5%",{"_7897":361,"_22053":341,"_18699":32758,"_5":22186,"_15048":32709,"_1570":32759},[],"Professional",{"_7897":362,"_22053":341,"_18699":32761,"_5":22186,"_15048":32709,"_1570":32762},[],"Hasta 10.000",{"_7897":363,"_22053":341,"_18699":32764,"_5":22186,"_15048":32709,"_1570":32765},[],"Email + Chat",{"_7897":364,"_22053":341,"_18699":32767,"_5":22186,"_15048":32709,"_1570":32768},[],"99,9%",{"_7897":365,"_22053":341,"_18699":32770,"_5":22186,"_15048":32709,"_1570":32771},[],"Enterprise",{"_7897":366,"_22053":341,"_18699":32773,"_5":22186,"_15048":32709,"_1570":32774},[],"Ilimitado",{"_7897":367,"_22053":341,"_18699":32776,"_5":22186,"_15048":32709,"_1570":32777},[],"Dedicado",{"_7897":368,"_22053":341,"_18699":32779,"_5":22186,"_15048":32709,"_1570":32780},[],"99,99%",{"_7897":369,"_22053":341,"_18699":32782,"_5":22186,"_15048":32713,"_1570":32783},[],"Para suscribirte o solicitar una demo, contacta con el equipo de Lamassu IoT a través de lamassu.io.",{"_7897":370,"_22053":370,"_5":22181,"_1570":32785,"_22194":32786,"_18699":32787,"_15048":370},"Manual de Usuario",[31686,32785],[],{"_7897":371,"_22053":370,"_18699":32789,"_5":22186,"_15048":370,"_1570":32790},[],"Guía completa de uso de la plataforma Lamassu IoT",{"_7897":372,"_22053":370,"_5":22191,"_18699":32792,"_15048":32793,"_1570":32794},[],"/docs/manual#servicios-core","Servicios Core",{"_7897":373,"_22053":370,"_5":22191,"_18699":32796,"_15048":32797,"_1570":32798},[],"/docs/manual#integraciones-con-terceros","Integraciones con terceros",{"_7897":374,"_22053":370,"_18699":32800,"_5":22186,"_15048":370,"_1570":32801},[],"Bienvenido al **Manual de Usuario de Lamassu IoT**. Esta documentación cubre todas las funcionalidades de la plataforma para la gestión de identidades digitales en entornos IoT industriales.",{"_7897":375,"_22053":370,"_18699":32803,"_5":22186,"_15048":32793,"_1570":32804},[],"<Card title=\"Gestión de Claves (KMS)\" description=\"Motores criptográficos, generación e importación de claves\" href=\"/docs/manual/servicios-core/kms\" />",{"_7897":376,"_22053":370,"_18699":32806,"_5":22186,"_15048":32793,"_1570":32807},[],"<Card title=\"Entidades de Confianza (CAs)\" description=\"Creación, importación y gestión de Autoridades de Certificación\" href=\"/docs/manual/servicios-core/cas\" />",{"_7897":377,"_22053":370,"_18699":32809,"_5":22186,"_15048":32793,"_1570":32810},[],"<Card title=\"Gestión de Certificados\" description=\"Visualización y revocación de certificados emitidos\" href=\"/docs/manual/servicios-core/certificates\" />",{"_7897":378,"_22053":370,"_18699":32812,"_5":22186,"_15048":32793,"_1570":32813},[],"<Card title=\"Validación de Certificados (VA)\" description=\"Servicios OCSP y CRL\" href=\"/docs/manual/servicios-core/validation\" />",{"_7897":379,"_22053":370,"_18699":32815,"_5":22186,"_15048":32793,"_1570":32816},[],"<Card title=\"Registration Authority (RA)\" description=\"Automatización del ciclo de vida de certificados y protocolo EST\" href=\"/docs/manual/servicios-core/ra\" />",{"_7897":380,"_22053":370,"_18699":32818,"_5":22186,"_15048":32793,"_1570":32819},[],"<Card title=\"Dispositivos e Identidades\" description=\"Gestión de End Entities y ciclo de vida de dispositivos IoT\" href=\"/docs/manual/servicios-core/devices\" />",{"_7897":381,"_22053":370,"_18699":32821,"_5":22186,"_15048":32793,"_1570":32822},[],"<Card title=\"Alertas y Suscripciones\" description=\"Monitorización de eventos y notificaciones\" href=\"/docs/manual/servicios-core/alerts\" />",{"_7897":382,"_22053":370,"_18699":32824,"_5":22186,"_15048":32797,"_1570":32825},[],"<Card title=\"Integración AWS IoT Core\" description=\"Aprovisionamiento de dispositivos en AWS IoT Core\" href=\"/docs/manual/integraciones/aws\" />",{"_7897":383,"_22053":383,"_5":22181,"_1570":32827,"_22194":32828,"_18699":32829,"_15048":383},"Integración con AWS IoT Core",[31686,32785,32798],[],{"_7897":384,"_22053":383,"_18699":32831,"_5":22186,"_15048":383,"_1570":32832},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_7897":385,"_22053":383,"_5":22191,"_18699":32834,"_15048":32835,"_1570":32836},[],"/docs/manual/integraciones/aws#arquitectura-del-conector","Arquitectura del conector",{"_7897":386,"_22053":383,"_5":22191,"_18699":32838,"_15048":32839,"_1570":32840},[],"/docs/manual/integraciones/aws#prerrequisitos","Prerrequisitos",{"_7897":387,"_22053":383,"_5":22191,"_18699":32842,"_15048":32843,"_1570":32844},[],"/docs/manual/integraciones/aws#permisos-iam-necesarios","Permisos IAM necesarios",{"_7897":388,"_22053":383,"_5":22191,"_18699":32846,"_15048":32847,"_1570":32848},[],"/docs/manual/integraciones/aws#parámetros-de-configuración","Parámetros de configuración",{"_7897":389,"_22053":383,"_5":22191,"_18699":32850,"_15048":32851,"_1570":32852},[],"/docs/manual/integraciones/aws#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_7897":390,"_22053":383,"_5":22191,"_18699":32854,"_15048":32855,"_1570":32856},[],"/docs/manual/integraciones/aws#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_7897":391,"_22053":383,"_5":22191,"_18699":32858,"_15048":32859,"_1570":32860},[],"/docs/manual/integraciones/aws#primary-account","Primary Account",{"_7897":392,"_22053":383,"_5":22191,"_18699":32862,"_15048":32863,"_1570":32864},[],"/docs/manual/integraciones/aws#secondary-account-sni-only","Secondary Account (SNI-only)",{"_7897":393,"_22053":383,"_5":22191,"_18699":32866,"_15048":32867,"_1570":32868},[],"/docs/manual/integraciones/aws#configuración-del-dms","Configuración del DMS",{"_7897":394,"_22053":383,"_5":22191,"_18699":32870,"_15048":32871,"_1570":32872},[],"/docs/manual/integraciones/aws#modo-none","Modo `none`",{"_7897":395,"_22053":383,"_5":22191,"_18699":32874,"_15048":32875,"_1570":32876},[],"/docs/manual/integraciones/aws#modo-auto","Modo `auto`",{"_7897":396,"_22053":383,"_5":22191,"_18699":32878,"_15048":32879,"_1570":32880},[],"/docs/manual/integraciones/aws#modo-jitp","Modo `jitp`",{"_7897":397,"_22053":383,"_5":22191,"_18699":32882,"_15048":32883,"_1570":32884},[],"/docs/manual/integraciones/aws#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_7897":398,"_22053":383,"_5":22191,"_18699":32886,"_15048":32887,"_1570":32888},[],"/docs/manual/integraciones/aws#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_7897":399,"_22053":383,"_5":22191,"_18699":32890,"_15048":32891,"_1570":32892},[],"/docs/manual/integraciones/aws#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_7897":400,"_22053":383,"_5":22191,"_18699":32894,"_15048":32895,"_1570":32896},[],"/docs/manual/integraciones/aws#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_7897":401,"_22053":383,"_5":22191,"_18699":32898,"_15048":32899,"_1570":32900},[],"/docs/manual/integraciones/aws#device-shadow-y-automatización","Device Shadow y automatización",{"_7897":402,"_22053":383,"_5":22191,"_18699":32902,"_15048":32903,"_1570":32904},[],"/docs/manual/integraciones/aws#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_7897":403,"_22053":383,"_5":22191,"_18699":32906,"_15048":32907,"_1570":32908},[],"/docs/manual/integraciones/aws#políticas-de-aws-iot","Políticas de AWS IoT",{"_7897":404,"_22053":383,"_5":22191,"_18699":32910,"_15048":32911,"_1570":32912},[],"/docs/manual/integraciones/aws#solución-de-problemas","Solución de problemas",{"_7897":405,"_22053":383,"_18699":32914,"_5":22186,"_15048":383,"_1570":32915},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_7897":406,"_22053":383,"_18699":32917,"_5":22186,"_15048":383,"_1570":32918},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_7897":407,"_22053":383,"_18699":32920,"_5":22186,"_15048":383,"_1570":32921},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_7897":408,"_22053":383,"_18699":32923,"_5":22186,"_15048":32835,"_1570":32924},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_7897":409,"_22053":383,"_18699":32926,"_5":22186,"_15048":32835,"_1570":32927},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_7897":410,"_22053":383,"_18699":32929,"_5":22186,"_15048":32835,"_1570":32930},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_7897":411,"_22053":383,"_18699":32932,"_5":22186,"_15048":32835,"_1570":32933},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_7897":412,"_22053":383,"_18699":32935,"_5":22186,"_15048":32839,"_1570":32936},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_7897":413,"_22053":383,"_18699":32938,"_5":22186,"_15048":32843,"_1570":32939},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_7897":414,"_22053":383,"_18699":32941,"_5":22186,"_15048":32843,"_1570":32942},[],"Acción IAM",{"_7897":415,"_22053":383,"_18699":32944,"_5":22186,"_15048":32843,"_1570":32945},[],"Propósito",{"_7897":416,"_22053":383,"_18699":32947,"_5":22186,"_15048":32843,"_1570":32948},[],"`iot:GetRegistrationCode`",{"_7897":417,"_22053":383,"_18699":32950,"_5":22186,"_15048":32843,"_1570":32951},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_7897":418,"_22053":383,"_18699":32953,"_5":22186,"_15048":32843,"_1570":32954},[],"`iot:RegisterCACertificate`",{"_7897":419,"_22053":383,"_18699":32956,"_5":22186,"_15048":32843,"_1570":32957},[],"Registrar la CA en AWS IoT",{"_7897":420,"_22053":383,"_18699":32959,"_5":22186,"_15048":32843,"_1570":32960},[],"`iot:DescribeCACertificate`",{"_7897":421,"_22053":383,"_18699":32962,"_5":22186,"_15048":32843,"_1570":32963},[],"Consultar el estado del registro de la CA",{"_7897":422,"_22053":383,"_18699":32965,"_5":22186,"_15048":32843,"_1570":32966},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_7897":423,"_22053":383,"_18699":32968,"_5":22186,"_15048":32843,"_1570":32969},[],"Crear o actualizar Things en IoT Core",{"_7897":424,"_22053":383,"_18699":32971,"_5":22186,"_15048":32843,"_1570":32972},[],"`iot:RegisterThing`",{"_7897":425,"_22053":383,"_18699":32974,"_5":22186,"_15048":32843,"_1570":32975},[],"Aprovisionar Things mediante plantilla",{"_7897":426,"_22053":383,"_18699":32977,"_5":22186,"_15048":32843,"_1570":32978},[],"`iot:RegisterCertificate`",{"_7897":427,"_22053":383,"_18699":32980,"_5":22186,"_15048":32843,"_1570":32981},[],"Registrar certificados de dispositivo",{"_7897":428,"_22053":383,"_18699":32983,"_5":22186,"_15048":32843,"_1570":32984},[],"`iot:UpdateCertificate`",{"_7897":429,"_22053":383,"_18699":32986,"_5":22186,"_15048":32843,"_1570":32987},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_7897":430,"_22053":383,"_18699":32989,"_5":22186,"_15048":32843,"_1570":32990},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_7897":431,"_22053":383,"_18699":32992,"_5":22186,"_15048":32843,"_1570":32993},[],"Crear y adjuntar políticas IoT",{"_7897":432,"_22053":383,"_18699":32995,"_5":22186,"_15048":32843,"_1570":32996},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_7897":433,"_22053":383,"_18699":32998,"_5":22186,"_15048":32843,"_1570":32999},[],"Gestionar grupos de Things",{"_7897":434,"_22053":383,"_18699":33001,"_5":22186,"_15048":32843,"_1570":33002},[],"`iot:CreateProvisioningTemplate`",{"_7897":435,"_22053":383,"_18699":33004,"_5":22186,"_15048":32843,"_1570":33005},[],"Crear plantillas JITP",{"_7897":436,"_22053":383,"_18699":33007,"_5":22186,"_15048":32843,"_1570":33008},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_7897":437,"_22053":383,"_18699":33010,"_5":22186,"_15048":32843,"_1570":33011},[],"Leer y escribir el Device Shadow",{"_7897":438,"_22053":383,"_18699":33013,"_5":22186,"_15048":32843,"_1570":33014},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_7897":439,"_22053":383,"_18699":33016,"_5":22186,"_15048":32847,"_1570":33017},[],"Parámetro",{"_7897":440,"_22053":383,"_18699":33019,"_5":22186,"_15048":32847,"_1570":33020},[],"Tipo",{"_7897":441,"_22053":383,"_18699":33022,"_5":22186,"_15048":32847,"_1570":33023},[],"Requerido",{"_7897":442,"_22053":383,"_18699":33025,"_5":22186,"_15048":32847,"_1570":31889},[],{"_7897":443,"_22053":383,"_18699":33027,"_5":22186,"_15048":32847,"_1570":33028},[],"`connector_id`",{"_7897":444,"_22053":383,"_18699":33030,"_5":22186,"_15048":32847,"_1570":11501},[],{"_7897":445,"_22053":383,"_18699":33032,"_5":22186,"_15048":32847,"_1570":33033},[],"Sí",{"_7897":446,"_22053":383,"_18699":33035,"_5":22186,"_15048":32847,"_1570":33036},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_7897":447,"_22053":383,"_18699":33038,"_5":22186,"_15048":32847,"_1570":33039},[],"`aws_config.region`",{"_7897":448,"_22053":383,"_18699":33041,"_5":22186,"_15048":32847,"_1570":11501},[],{"_7897":449,"_22053":383,"_18699":33043,"_5":22186,"_15048":32847,"_1570":33033},[],{"_7897":450,"_22053":383,"_18699":33045,"_5":22186,"_15048":32847,"_1570":33046},[],"Región AWS donde opera el conector.",{"_7897":451,"_22053":383,"_18699":33048,"_5":22186,"_15048":32847,"_1570":33049},[],"`aws_config.auth_method`",{"_7897":452,"_22053":383,"_18699":33051,"_5":22186,"_15048":32847,"_1570":11501},[],{"_7897":453,"_22053":383,"_18699":33053,"_5":22186,"_15048":32847,"_1570":33033},[],{"_7897":454,"_22053":383,"_18699":33055,"_5":22186,"_15048":32847,"_1570":33056},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_7897":455,"_22053":383,"_18699":33058,"_5":22186,"_15048":32847,"_1570":33059},[],"`aws_config.access_key_id`",{"_7897":456,"_22053":383,"_18699":33061,"_5":22186,"_15048":32847,"_1570":11501},[],{"_7897":457,"_22053":383,"_18699":33063,"_5":22186,"_15048":32847,"_1570":33064},[],"Solo con `auth_method=static`",{"_7897":458,"_22053":383,"_18699":33066,"_5":22186,"_15048":32847,"_1570":33067},[],"Clave de acceso AWS.",{"_7897":459,"_22053":383,"_18699":33069,"_5":22186,"_15048":32847,"_1570":33070},[],"`aws_config.secret_access_key`",{"_7897":460,"_22053":383,"_18699":33072,"_5":22186,"_15048":32847,"_1570":11501},[],{"_7897":461,"_22053":383,"_18699":33074,"_5":22186,"_15048":32847,"_1570":33064},[],{"_7897":462,"_22053":383,"_18699":33076,"_5":22186,"_15048":32847,"_1570":33077},[],"Clave secreta AWS.",{"_7897":463,"_22053":383,"_18699":33079,"_5":22186,"_15048":32847,"_1570":33080},[],"`aws_config.session_token`",{"_7897":464,"_22053":383,"_18699":33082,"_5":22186,"_15048":32847,"_1570":11501},[],{"_7897":465,"_22053":383,"_18699":33084,"_5":22186,"_15048":32847,"_1570":33085},[],"No",{"_7897":466,"_22053":383,"_18699":33087,"_5":22186,"_15048":32847,"_1570":33088},[],"Token de sesión (con `auth_method=static`).",{"_7897":467,"_22053":383,"_18699":33090,"_5":22186,"_15048":32847,"_1570":33091},[],"`aws_config.role_arn`",{"_7897":468,"_22053":383,"_18699":33093,"_5":22186,"_15048":32847,"_1570":11501},[],{"_7897":469,"_22053":383,"_18699":33095,"_5":22186,"_15048":32847,"_1570":33096},[],"Solo con `auth_method=role`",{"_7897":470,"_22053":383,"_18699":33098,"_5":22186,"_15048":32847,"_1570":33099},[],"ARN del rol a asumir.",{"_7897":471,"_22053":383,"_18699":33101,"_5":22186,"_15048":32847,"_1570":33102},[],"`aws_config.endpoint_url`",{"_7897":472,"_22053":383,"_18699":33104,"_5":22186,"_15048":32847,"_1570":11501},[],{"_7897":473,"_22053":383,"_18699":33106,"_5":22186,"_15048":32847,"_1570":33085},[],{"_7897":474,"_22053":383,"_18699":33108,"_5":22186,"_15048":32847,"_1570":33109},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_7897":475,"_22053":383,"_18699":33111,"_5":22186,"_15048":32847,"_1570":33112},[],"`subscriber_event_bus`",{"_7897":476,"_22053":383,"_18699":33114,"_5":22186,"_15048":32847,"_1570":19004},[],{"_7897":477,"_22053":383,"_18699":33116,"_5":22186,"_15048":32847,"_1570":33033},[],{"_7897":478,"_22053":383,"_18699":33118,"_5":22186,"_15048":32847,"_1570":33119},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_7897":479,"_22053":383,"_18699":33121,"_5":22186,"_15048":32847,"_1570":33122},[],"`dms_manager_client`",{"_7897":480,"_22053":383,"_18699":33124,"_5":22186,"_15048":32847,"_1570":11501},[],{"_7897":481,"_22053":383,"_18699":33126,"_5":22186,"_15048":32847,"_1570":33033},[],{"_7897":482,"_22053":383,"_18699":33128,"_5":22186,"_15048":32847,"_1570":33129},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_7897":483,"_22053":383,"_18699":33131,"_5":22186,"_15048":32847,"_1570":33132},[],"`device_manager_client`",{"_7897":484,"_22053":383,"_18699":33134,"_5":22186,"_15048":32847,"_1570":11501},[],{"_7897":485,"_22053":383,"_18699":33136,"_5":22186,"_15048":32847,"_1570":33033},[],{"_7897":486,"_22053":383,"_18699":33138,"_5":22186,"_15048":32847,"_1570":33139},[],"URL HTTP del Device Manager de Lamassu.",{"_7897":487,"_22053":383,"_18699":33141,"_5":22186,"_15048":32847,"_1570":33142},[],"`ca_client`",{"_7897":488,"_22053":383,"_18699":33144,"_5":22186,"_15048":32847,"_1570":11501},[],{"_7897":489,"_22053":383,"_18699":33146,"_5":22186,"_15048":32847,"_1570":33033},[],{"_7897":490,"_22053":383,"_18699":33148,"_5":22186,"_15048":32847,"_1570":33149},[],"URL HTTP del servicio de CA de Lamassu.",{"_7897":491,"_22053":383,"_18699":33151,"_5":22186,"_15048":32851,"_1570":33152},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_7897":492,"_22053":383,"_18699":33154,"_5":22186,"_15048":32855,"_1570":33155},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_7897":493,"_22053":383,"_18699":33157,"_5":22186,"_15048":32855,"_1570":33158},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_7897":494,"_22053":383,"_18699":33160,"_5":22186,"_15048":32859,"_1570":33161},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_7897":495,"_22053":383,"_18699":33163,"_5":22186,"_15048":32859,"_1570":33164},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_7897":496,"_22053":383,"_18699":33166,"_5":22186,"_15048":32859,"_1570":33167},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_7897":497,"_22053":383,"_18699":33169,"_5":22186,"_15048":32859,"_1570":33170},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_7897":498,"_22053":383,"_18699":33172,"_5":22186,"_15048":32859,"_1570":33173},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_7897":499,"_22053":383,"_18699":33175,"_5":22186,"_15048":32859,"_1570":33176},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_7897":500,"_22053":383,"_18699":33178,"_5":22186,"_15048":32863,"_1570":33179},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_7897":501,"_22053":383,"_18699":33181,"_5":22186,"_15048":32867,"_1570":33182},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_7897":502,"_22053":383,"_18699":33184,"_5":22186,"_15048":32867,"_1570":33185},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_7897":503,"_22053":383,"_18699":33187,"_5":22186,"_15048":32871,"_1570":33188},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_7897":504,"_22053":383,"_18699":33190,"_5":22186,"_15048":32875,"_1570":33191},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_7897":505,"_22053":383,"_18699":33193,"_5":22186,"_15048":32875,"_1570":33194},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_7897":506,"_22053":383,"_18699":33196,"_5":22186,"_15048":32875,"_1570":33197},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_7897":507,"_22053":383,"_18699":33199,"_5":22186,"_15048":32875,"_1570":33200},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_7897":508,"_22053":383,"_18699":33202,"_5":22186,"_15048":32875,"_1570":33203},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_7897":509,"_22053":383,"_18699":33205,"_5":22186,"_15048":32875,"_1570":33206},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_7897":510,"_22053":383,"_18699":33208,"_5":22186,"_15048":32879,"_1570":33209},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_7897":511,"_22053":383,"_18699":33211,"_5":22186,"_15048":32879,"_1570":33212},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_7897":512,"_22053":383,"_18699":33214,"_5":22186,"_15048":32879,"_1570":33215},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_7897":513,"_22053":383,"_18699":33217,"_5":22186,"_15048":32883,"_1570":33218},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_7897":514,"_22053":383,"_18699":33220,"_5":22186,"_15048":32883,"_1570":33221},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_7897":515,"_22053":383,"_18699":33223,"_5":22186,"_15048":32883,"_1570":33224},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_7897":516,"_22053":383,"_18699":33226,"_5":22186,"_15048":32887,"_1570":33227},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_7897":517,"_22053":383,"_18699":33229,"_5":22186,"_15048":32887,"_1570":33230},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_7897":518,"_22053":383,"_18699":33232,"_5":22186,"_15048":32887,"_1570":33233},[],"Para que el flujo JITP funcione correctamente:",{"_7897":519,"_22053":383,"_18699":33235,"_5":22186,"_15048":32887,"_1570":33236},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_7897":520,"_22053":383,"_18699":33238,"_5":22186,"_15048":32887,"_1570":33239},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_7897":521,"_22053":383,"_18699":33241,"_5":22186,"_15048":32887,"_1570":33242},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_7897":522,"_22053":383,"_18699":33244,"_5":22186,"_15048":32887,"_1570":33245},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_7897":523,"_22053":383,"_18699":33247,"_5":22186,"_15048":32891,"_1570":33248},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_7897":524,"_22053":383,"_18699":33250,"_5":22186,"_15048":32891,"_1570":33251},[],"Estado en Lamassu",{"_7897":525,"_22053":383,"_18699":33253,"_5":22186,"_15048":32891,"_1570":33254},[],"Razón de revocación",{"_7897":526,"_22053":383,"_18699":33256,"_5":22186,"_15048":32891,"_1570":33257},[],"Estado en AWS IoT Core",{"_7897":527,"_22053":383,"_18699":33259,"_5":22186,"_15048":32891,"_1570":33260},[],"`Active`",{"_7897":528,"_22053":383,"_18699":33262,"_5":22186,"_15048":32891,"_1570":33263},[],"—",{"_7897":529,"_22053":383,"_18699":33265,"_5":22186,"_15048":32891,"_1570":33266},[],"`ACTIVE`",{"_7897":530,"_22053":383,"_18699":33268,"_5":22186,"_15048":32891,"_1570":33269},[],"`Revoked`",{"_7897":531,"_22053":383,"_18699":33271,"_5":22186,"_15048":32891,"_1570":33272},[],"`certificateHold`",{"_7897":532,"_22053":383,"_18699":33274,"_5":22186,"_15048":32891,"_1570":33275},[],"`INACTIVE`",{"_7897":533,"_22053":383,"_18699":33277,"_5":22186,"_15048":32891,"_1570":33269},[],{"_7897":534,"_22053":383,"_18699":33279,"_5":22186,"_15048":32891,"_1570":33280},[],"Cualquier otra razón",{"_7897":535,"_22053":383,"_18699":33282,"_5":22186,"_15048":32891,"_1570":33283},[],"`REVOKED`",{"_7897":536,"_22053":383,"_18699":33285,"_5":22186,"_15048":32891,"_1570":33286},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_7897":537,"_22053":383,"_18699":33288,"_5":22186,"_15048":32895,"_1570":33289},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_7897":538,"_22053":383,"_18699":33291,"_5":22186,"_15048":32895,"_1570":33292},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_7897":539,"_22053":383,"_18699":33294,"_5":22186,"_15048":32895,"_1570":33295},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_7897":540,"_22053":383,"_18699":33297,"_5":22186,"_15048":32899,"_1570":33298},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_7897":541,"_22053":383,"_18699":33300,"_5":22186,"_15048":32899,"_1570":33301},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_7897":542,"_22053":383,"_18699":33303,"_5":22186,"_15048":32903,"_1570":33304},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_7897":543,"_22053":383,"_18699":33306,"_5":22186,"_15048":32903,"_1570":33307},[],"Existen dos tipos de acciones:",{"_7897":544,"_22053":383,"_18699":33309,"_5":22186,"_15048":32903,"_1570":33310},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_7897":545,"_22053":383,"_18699":33312,"_5":22186,"_15048":32903,"_1570":33313},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_7897":546,"_22053":383,"_18699":33315,"_5":22186,"_15048":32903,"_1570":33316},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_7897":547,"_22053":383,"_18699":33318,"_5":22186,"_15048":32907,"_1570":33319},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_7897":548,"_22053":383,"_18699":33321,"_5":22186,"_15048":32907,"_1570":33322},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_7897":549,"_22053":383,"_18699":33324,"_5":22186,"_15048":32907,"_1570":33325},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_7897":550,"_22053":383,"_18699":33327,"_5":22186,"_15048":32911,"_1570":33328},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_7897":551,"_22053":383,"_18699":33330,"_5":22186,"_15048":32911,"_1570":33331},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_7897":552,"_22053":383,"_18699":33333,"_5":22186,"_15048":32911,"_1570":33334},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_7897":553,"_22053":383,"_18699":33336,"_5":22186,"_15048":32911,"_1570":33337},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_7897":554,"_22053":383,"_18699":33339,"_5":22186,"_15048":32911,"_1570":33340},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_7897":555,"_22053":383,"_18699":33342,"_5":22186,"_15048":32911,"_1570":33343},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_7897":556,"_22053":383,"_18699":33345,"_5":22186,"_15048":32911,"_1570":33346},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_7897":557,"_22053":383,"_18699":33348,"_5":22186,"_15048":32911,"_1570":33349},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_7897":558,"_22053":383,"_18699":33351,"_5":22186,"_15048":32911,"_1570":33352},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_7897":559,"_22053":383,"_18699":33354,"_5":22186,"_15048":32911,"_1570":33355},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_7897":560,"_22053":383,"_18699":33357,"_5":22186,"_15048":32911,"_1570":33358},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_7897":561,"_22053":383,"_18699":33360,"_5":22186,"_15048":32911,"_1570":33361},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_7897":562,"_22053":383,"_18699":33363,"_5":22186,"_15048":32911,"_1570":33364},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_7897":563,"_22053":383,"_18699":33366,"_5":22186,"_15048":32911,"_1570":33367},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_7897":564,"_22053":383,"_18699":33369,"_5":22186,"_15048":32911,"_1570":33370},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_7897":565,"_22053":383,"_18699":33372,"_5":22186,"_15048":32911,"_1570":33373},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_7897":566,"_22053":383,"_18699":33375,"_5":22186,"_15048":32911,"_1570":33376},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_7897":567,"_22053":383,"_18699":33378,"_5":22186,"_15048":32911,"_1570":33379},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_7897":568,"_22053":383,"_18699":33381,"_5":22186,"_15048":32911,"_1570":33382},[],"<Card title=\"Configurar un DMS\" href=\"/docs/manual/servicios-core/ra\" />",{"_7897":569,"_22053":383,"_18699":33384,"_5":22186,"_15048":32911,"_1570":33385},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/manual/servicios-core/est\" />",{"_7897":570,"_22053":383,"_18699":33387,"_5":22186,"_15048":32911,"_1570":33388},[],"<Card title=\"Gestión de certificados\" href=\"/docs/manual/servicios-core/certificates\" />",{"_7897":571,"_22053":571,"_5":22181,"_1570":33390,"_22194":33391,"_18699":33392,"_15048":571},"[Alerts] Alertas y Suscripciones",[31686,32785,32794],[],{"_7897":572,"_22053":571,"_18699":33394,"_5":22186,"_15048":571,"_1570":33395},[],"Monitorización proactiva mediante eventos y suscripciones",{"_7897":573,"_22053":571,"_5":22191,"_18699":33397,"_15048":33398,"_1570":33399},[],"/docs/manual/servicios-core/alerts#alertas","Alertas",{"_7897":574,"_22053":571,"_5":22191,"_18699":33401,"_15048":33402,"_1570":33403},[],"/docs/manual/servicios-core/alerts#eventos-y-suscripciones","Eventos y Suscripciones",{"_7897":575,"_22053":571,"_5":22191,"_18699":33405,"_15048":33406,"_1570":33407},[],"/docs/manual/servicios-core/alerts#gestión-de-suscripciones","Gestión de Suscripciones",{"_7897":576,"_22053":571,"_5":22191,"_18699":33409,"_15048":33410,"_1570":33411},[],"/docs/manual/servicios-core/alerts#filtros-y-condiciones","Filtros y condiciones",{"_7897":577,"_22053":571,"_5":22191,"_18699":33413,"_15048":33414,"_1570":33415},[],"/docs/manual/servicios-core/alerts#confirmación-de-la-suscripción","Confirmación de la suscripción",{"_7897":578,"_22053":571,"_5":22191,"_18699":33417,"_15048":33418,"_1570":33419},[],"/docs/manual/servicios-core/alerts#gestión-de-suscripciones-existentes","Gestión de Suscripciones Existentes",{"_7897":579,"_22053":571,"_5":22191,"_18699":33421,"_15048":33422,"_1570":33423},[],"/docs/manual/servicios-core/alerts#catálogo-de-eventos-del-sistema","Catálogo de Eventos del Sistema",{"_7897":580,"_22053":571,"_18699":33425,"_5":22186,"_15048":33398,"_1570":33426},[],"La funcionalidad de **Alertas** en Lamassu IoT es una herramienta avanzada para la monitorización y la observación del estado de la PKI. Va más allá de la simple visualización, permitiendo a los usuarios **reaccionar de forma proactiva y automatizada** a los eventos que ocurren en la infraestructura. Esta capacidad es crucial en entornos de IoT, donde el número de dispositivos y la frecuencia de las operaciones hacen inviable la monitorización manual. A través de la gestión de suscripciones, los administradores pueden asegurarse de que eventos críticos, como la revocación de un certificado o la detección de un intento de registro fallido, no pasen desapercibidos, lo que mejora la seguridad y la resiliencia del sistema.",{"_7897":581,"_22053":571,"_18699":33428,"_5":22186,"_15048":33402,"_1570":33429},[],"La página principal de alertas presenta una lista exhaustiva de todos los **tipos de eventos** que pueden ser generados por la PKI de Lamassu IoT. Estos eventos cubren un amplio espectro de actividades, desde operaciones de ciclo de vida de certificados y dispositivos hasta cambios de estado en las RA. Para cada tipo de evento, la interfaz proporciona un conjunto de métricas clave que facilitan la toma de decisiones:",{"_7897":582,"_22053":571,"_18699":33431,"_5":22186,"_15048":33402,"_1570":33432},[],"**Last Seen**: Muestra cuándo ocurrió la última instancia del evento. Esto ayuda a identificar si un evento es recurrente o si ha ocurrido recientemente, lo cual es fundamental para el diagnóstico.",{"_7897":583,"_22053":571,"_18699":33434,"_5":22186,"_15048":33402,"_1570":33435},[],"**Counter**: Indica el número total de veces que el evento ha sido registrado en el sistema. Un contador alto puede señalar una tendencia, un problema subyacente en un dispositivo o una configuración errónea.",{"_7897":584,"_22053":571,"_18699":33437,"_5":22186,"_15048":33402,"_1570":33438},[],"**Subscriptions**: Informa si ya existen suscripciones activas para ese evento, evitando la creación de suscripciones duplicadas y proporcionando una visión general de la monitorización ya implementada.",{"_7897":585,"_22053":571,"_18699":33440,"_5":22186,"_15048":33402,"_1570":33441},[],"**Actions**: El botón **Subscribe** permite iniciar el proceso de creación de una nueva suscripción, adaptada a las necesidades específicas del usuario o equipo.",{"_7897":586,"_22053":571,"_18699":33443,"_5":22186,"_15048":33402,"_1570":33444},[],"Adicionalmente, al expandir la información de cada evento, se presenta un **ejemplo de la estructura de datos JSON** de la última instancia registrada. Esta información es de gran valor, ya que permite a los desarrolladores y administradores entender con precisión el esquema de la notificación y cómo procesarla en sistemas externos, como un sistema de gestión de incidentes o una aplicación de automatización.",{"_7897":587,"_22053":571,"_18699":33446,"_5":22186,"_15048":33406,"_1570":33447},[],"Para cada evento, se puede crear una suscripción a la que se envían notificaciones cuando el evento ocurre. Este proceso permite a los administradores del sistema personalizar qué eventos monitorizan y cómo son notificados. La configuración de las suscripciones, incluyendo el destino de las notificaciones, se gestiona de forma individual para cada tipo de evento.",{"_7897":588,"_22053":571,"_18699":33449,"_5":22186,"_15048":33406,"_1570":33450},[],"Al pulsar sobre el botón **Subscribe** se abre un modal de configuración que permite seleccionar uno de los tres mecanismos de notificación disponibles en Lamassu IoT.",{"_7897":589,"_22053":571,"_18699":33452,"_5":22186,"_15048":33406,"_1570":33453},[],"**Email Notification**: Envía una notificación por correo electrónico a una dirección específica cada vez que el evento se registra. Para configurar este método, solo es necesario proporcionar la dirección de correo electrónico de destino.",{"_7897":590,"_22053":571,"_18699":33455,"_5":22186,"_15048":33406,"_1570":33456},[],"**Microsoft Teams Webhook**: Utiliza un webhook para enviar una notificación al canal de Microsoft Teams configurado, lo que permite integrar las alertas directamente en los flujos de trabajo de colaboración. Se debe proporcionar un nombre para la suscripción y la URL del webhook de Microsoft Teams.",{"_7897":591,"_22053":571,"_18699":33458,"_5":22186,"_15048":33406,"_1570":33459},[],"**Webhook**: Envía una notificación en formato JSON a una URL de webhook personalizada, lo que permite integrar las alertas con cualquier servicio o aplicación que soporte este protocolo. Para este mecanismo, se debe especificar un nombre, el **Método HTTP** (siempre **POST** o **PUT**) y la URL de destino. El documento JSON del evento se entregará como el cuerpo de la solicitud HTTP.",{"_7897":592,"_22053":571,"_18699":33461,"_5":22186,"_15048":33410,"_1570":33462},[],"Después de seleccionar el mecanismo de notificación, se puede establecer un filtro para determinar las condiciones que deben cumplirse para que el evento sea notificado. Esto permite un control más granular y evita recibir notificaciones irrelevantes. Los formatos de filtro disponibles son:",{"_7897":593,"_22053":571,"_18699":33464,"_5":22186,"_15048":33410,"_1570":33465},[],"**None**: No se aplica ningún filtro. Se enviarán notificaciones para todas las instancias del evento.",{"_7897":594,"_22053":571,"_18699":33467,"_5":22186,"_15048":33410,"_1570":33468},[],"**JSON Path**: Utiliza la sintaxis de JSON Path para evaluar una condición sobre un campo específico del evento JSON.",{"_7897":595,"_22053":571,"_18699":33470,"_5":22186,"_15048":33410,"_1570":33471},[],"**JSON Schema**: Permite aplicar un esquema JSON para validar el evento. Las notificaciones solo se enviarán si el evento cumple con el esquema definido. Esto es útil para asegurar que solo se procesen eventos con un formato de datos esperado y consistente.",{"_7897":596,"_22053":571,"_18699":33473,"_5":22186,"_15048":33410,"_1570":33474},[],"**Javascript**: Permite escribir una función de JavaScript personalizada para evaluar condiciones complejas sobre el evento JSON. Por ejemplo, la función `function (event) { return event.data.status == \"NO_IDENTITY\"; }` podría usarse para notificar solo cuando el estado de un dispositivo cambia a \"No Identity\". Esto ofrece la mayor flexibilidad, ya que se pueden aplicar lógicas avanzadas para filtrar los eventos antes de que se envíen las notificaciones.",{"_7897":597,"_22053":571,"_18699":33476,"_5":22186,"_15048":33414,"_1570":33477},[],"El último paso del proceso es la **confirmación**. Una vez que se ha configurado el canal de notificación y el filtro (si corresponde), la interfaz muestra un resumen de la suscripción. Aquí puedes revisar el tipo de evento, el canal de notificación seleccionado y la condición del filtro antes de confirmar.",{"_7897":598,"_22053":571,"_18699":33479,"_5":22186,"_15048":33414,"_1570":33480},[],"Al hacer clic en **Confirm Subscription**, la suscripción se activa y Lamassu IoT comenzará a enviar notificaciones basadas en la configuración que has establecido.",{"_7897":599,"_22053":571,"_18699":33482,"_5":22186,"_15048":33418,"_1570":33483},[],"Para gestionar una suscripción que ya está activa, simplemente selecciónala en el listado de la página principal de alertas. Al hacerlo, se abrirá un modal de **Subscription Details** que muestra toda la información de la suscripción. Desde esta ventana, se pueden realizar las siguientes acciones:",{"_7897":600,"_22053":571,"_18699":33485,"_5":22186,"_15048":33418,"_1570":33486},[],"**Ver detalles**: Muestra información completa sobre la suscripción, incluyendo su tipo de evento, el canal de notificación, los detalles de contacto (como la dirección de correo electrónico) y las condiciones de filtrado aplicadas.",{"_7897":601,"_22053":571,"_18699":33488,"_5":22186,"_15048":33418,"_1570":33489},[],"**Editar**: Permite modificar la configuración de la suscripción, como el canal de notificación o el filtro.",{"_7897":602,"_22053":571,"_18699":33491,"_5":22186,"_15048":33418,"_1570":33492},[],"**Anular suscripción (Unsubscribe)**: Desactiva y elimina la suscripción. Esta acción es útil cuando una alerta ya no es necesaria.",{"_7897":603,"_22053":571,"_18699":33494,"_5":22186,"_15048":33422,"_1570":33495},[],"La siguiente tabla resume los eventos que pueden ser generados por la plataforma Lamassu IoT, clasificados por el componente que los origina.",{"_7897":604,"_22053":571,"_18699":33497,"_5":22186,"_15048":33422,"_1570":33498},[],"Evento",{"_7897":605,"_22053":571,"_18699":33500,"_5":22186,"_15048":33422,"_1570":31889},[],{"_7897":606,"_22053":571,"_18699":33502,"_5":22186,"_15048":33422,"_1570":33503},[],"**ca.create**",{"_7897":607,"_22053":571,"_18699":33505,"_5":22186,"_15048":33422,"_1570":33506},[],"Creación de una CA",{"_7897":608,"_22053":571,"_18699":33508,"_5":22186,"_15048":33422,"_1570":33509},[],"**ca.import**",{"_7897":609,"_22053":571,"_18699":33511,"_5":22186,"_15048":33422,"_1570":33512},[],"Importación de una CA",{"_7897":610,"_22053":571,"_18699":33514,"_5":22186,"_15048":33422,"_1570":33515},[],"**ca.profile.update**",{"_7897":611,"_22053":571,"_18699":33517,"_5":22186,"_15048":33422,"_1570":33518},[],"Actualización de perfil de CA",{"_7897":612,"_22053":571,"_18699":33520,"_5":22186,"_15048":33422,"_1570":33521},[],"**ca.reissue**",{"_7897":613,"_22053":571,"_18699":33523,"_5":22186,"_15048":33422,"_1570":33524},[],"Reemisión de una CA",{"_7897":614,"_22053":571,"_18699":33526,"_5":22186,"_15048":33422,"_1570":33527},[],"**ca.sign.certificate**",{"_7897":615,"_22053":571,"_18699":33529,"_5":22186,"_15048":33422,"_1570":33530},[],"Firma / emisión de certificado",{"_7897":616,"_22053":571,"_18699":33532,"_5":22186,"_15048":33422,"_1570":33533},[],"**ca.signature.sign**",{"_7897":617,"_22053":571,"_18699":33535,"_5":22186,"_15048":33422,"_1570":33536},[],"Operación de firma criptográfica",{"_7897":618,"_22053":571,"_18699":33538,"_5":22186,"_15048":33422,"_1570":33539},[],"**ca.delete**",{"_7897":619,"_22053":571,"_18699":33541,"_5":22186,"_15048":33422,"_1570":33542},[],"Eliminación de una CA",{"_7897":620,"_22053":571,"_18699":33544,"_5":22186,"_15048":33422,"_1570":33545},[],"**certificate.delete**",{"_7897":621,"_22053":571,"_18699":33547,"_5":22186,"_15048":33422,"_1570":33548},[],"Eliminación de un certificado",{"_7897":622,"_22053":571,"_18699":33550,"_5":22186,"_15048":33422,"_1570":33551},[],"**profile.create**",{"_7897":623,"_22053":571,"_18699":33553,"_5":22186,"_15048":33422,"_1570":33554},[],"Creación de perfil de emisión",{"_7897":624,"_22053":571,"_18699":33556,"_5":22186,"_15048":33422,"_1570":33557},[],"**profile.update**",{"_7897":625,"_22053":571,"_18699":33559,"_5":22186,"_15048":33422,"_1570":33560},[],"Actualización de perfil de emisión",{"_7897":626,"_22053":571,"_18699":33562,"_5":22186,"_15048":33422,"_1570":33563},[],"**profile.delete**",{"_7897":627,"_22053":571,"_18699":33565,"_5":22186,"_15048":33422,"_1570":33566},[],"Eliminación de perfil de emisión",{"_7897":628,"_22053":571,"_18699":33568,"_5":22186,"_15048":33422,"_1570":33569},[],"**dms.create**",{"_7897":629,"_22053":571,"_18699":33571,"_5":22186,"_15048":33422,"_1570":33572},[],"Creación de un DMS",{"_7897":630,"_22053":571,"_18699":33574,"_5":22186,"_15048":33422,"_1570":33575},[],"**dms.update**",{"_7897":631,"_22053":571,"_18699":33577,"_5":22186,"_15048":33422,"_1570":33578},[],"Actualización de un DMS",{"_7897":632,"_22053":571,"_18699":33580,"_5":22186,"_15048":33422,"_1570":33581},[],"**dms.delete**",{"_7897":633,"_22053":571,"_18699":33583,"_5":22186,"_15048":33422,"_1570":33584},[],"Eliminación de un DMS",{"_7897":634,"_22053":571,"_18699":33586,"_5":22186,"_15048":33422,"_1570":33587},[],"**dms.enroll**",{"_7897":635,"_22053":571,"_18699":33589,"_5":22186,"_15048":33422,"_1570":33590},[],"Inscripción (enroll) de dispositivo",{"_7897":636,"_22053":571,"_18699":33592,"_5":22186,"_15048":33422,"_1570":33593},[],"**dms.reenroll**",{"_7897":637,"_22053":571,"_18699":33595,"_5":22186,"_15048":33422,"_1570":33596},[],"Re-inscripción (reenroll) de dispositivo",{"_7897":638,"_22053":571,"_18699":33598,"_5":22186,"_15048":33422,"_1570":33599},[],"**dms.bind-device-id**",{"_7897":639,"_22053":571,"_18699":33601,"_5":22186,"_15048":33422,"_1570":33602},[],"Asociación de identidad a dispositivo",{"_7897":640,"_22053":571,"_18699":33604,"_5":22186,"_15048":33422,"_1570":33605},[],"**device.create**",{"_7897":641,"_22053":571,"_18699":33607,"_5":22186,"_15048":33422,"_1570":33608},[],"Creación de dispositivo",{"_7897":642,"_22053":571,"_18699":33610,"_5":22186,"_15048":33422,"_1570":33611},[],"**device.identity.update**",{"_7897":643,"_22053":571,"_18699":33613,"_5":22186,"_15048":33422,"_1570":33614},[],"Actualización de identidad del dispositivo",{"_7897":644,"_22053":571,"_18699":33616,"_5":22186,"_15048":33422,"_1570":33617},[],"**device.status.update**",{"_7897":645,"_22053":571,"_18699":33619,"_5":22186,"_15048":33422,"_1570":33620},[],"Cambio de estado del dispositivo",{"_7897":646,"_22053":571,"_18699":33622,"_5":22186,"_15048":33422,"_1570":33623},[],"**device.metadata.update**",{"_7897":647,"_22053":571,"_18699":33625,"_5":22186,"_15048":33422,"_1570":33626},[],"Actualización de metadatos del dispositivo",{"_7897":648,"_22053":571,"_18699":33628,"_5":22186,"_15048":33422,"_1570":33629},[],"**device.delete**",{"_7897":649,"_22053":571,"_18699":33631,"_5":22186,"_15048":33422,"_1570":33632},[],"Eliminación de un dispositivo",{"_7897":650,"_22053":571,"_18699":33634,"_5":22186,"_15048":33422,"_1570":33635},[],"**va.role.crl.create**",{"_7897":651,"_22053":571,"_18699":33637,"_5":22186,"_15048":33422,"_1570":33638},[],"Cálculo/creación de CRL",{"_7897":652,"_22053":571,"_18699":33640,"_5":22186,"_15048":33422,"_1570":33641},[],"**kms.create**",{"_7897":653,"_22053":571,"_18699":33643,"_5":22186,"_15048":33422,"_1570":33644},[],"Creación de clave en KMS",{"_7897":654,"_22053":571,"_18699":33646,"_5":22186,"_15048":33422,"_1570":33647},[],"**kms.import**",{"_7897":655,"_22053":571,"_18699":33649,"_5":22186,"_15048":33422,"_1570":33650},[],"Importación de una clave KMS",{"_7897":656,"_22053":571,"_18699":33652,"_5":22186,"_15048":33422,"_1570":33653},[],"**kms.update.metadata**",{"_7897":657,"_22053":571,"_18699":33655,"_5":22186,"_15048":33422,"_1570":33656},[],"Actualización de metadatos de clave KMS",{"_7897":658,"_22053":571,"_18699":33658,"_5":22186,"_15048":33422,"_1570":33659},[],"**kms.update.aliases**",{"_7897":659,"_22053":571,"_18699":33661,"_5":22186,"_15048":33422,"_1570":33662},[],"Actualización de alias de clave KMS",{"_7897":660,"_22053":571,"_18699":33664,"_5":22186,"_15048":33422,"_1570":33665},[],"**kms.update.name**",{"_7897":661,"_22053":571,"_18699":33667,"_5":22186,"_15048":33422,"_1570":33668},[],"Cambio de nombre de una clave KMS",{"_7897":662,"_22053":571,"_18699":33670,"_5":22186,"_15048":33422,"_1570":33671},[],"**kms.update.tags**",{"_7897":663,"_22053":571,"_18699":33673,"_5":22186,"_15048":33422,"_1570":33674},[],"Actualización de etiquetas (tags) de clave KMS",{"_7897":664,"_22053":571,"_18699":33676,"_5":22186,"_15048":33422,"_1570":33677},[],"**kms.delete**",{"_7897":665,"_22053":571,"_18699":33679,"_5":22186,"_15048":33422,"_1570":33680},[],"Eliminación de una clave KMS",{"_7897":666,"_22053":571,"_18699":33682,"_5":22186,"_15048":33422,"_1570":33683},[],"**kms.sign.message**",{"_7897":667,"_22053":571,"_18699":33685,"_5":22186,"_15048":33422,"_1570":33686},[],"Firma de un mensaje con clave KMS",{"_7897":668,"_22053":571,"_18699":33688,"_5":22186,"_15048":33422,"_1570":33689},[],"**kms.verify.signature**",{"_7897":669,"_22053":571,"_18699":33691,"_5":22186,"_15048":33422,"_1570":33692},[],"Verificación de firma con clave KMS",{"_7897":670,"_22053":670,"_5":22181,"_1570":33694,"_22194":33695,"_18699":33696,"_15048":670},"[CA] Gestión de Entidades de Confianza",[31686,32785,32794],[],{"_7897":671,"_22053":670,"_18699":33698,"_5":22186,"_15048":670,"_1570":33699},[],"Creación y gestión de Autoridades de Certificación en Lamassu IoT",{"_7897":672,"_22053":670,"_5":22191,"_18699":33701,"_15048":33702,"_1570":33703},[],"/docs/manual/servicios-core/cas#gestión-de-entidades-de-confianza","Gestión de entidades de confianza",{"_7897":673,"_22053":670,"_5":22191,"_18699":33705,"_15048":33706,"_1570":33707},[],"/docs/manual/servicios-core/cas#creación-de-entidades-de-certificación","Creación de entidades de certificación",{"_7897":674,"_22053":670,"_5":22191,"_18699":33709,"_15048":33710,"_1570":33711},[],"/docs/manual/servicios-core/cas#creación-de-una-nueva-autoridad-de-certificación","Creación de una nueva autoridad de certificación",{"_7897":675,"_22053":670,"_5":22191,"_18699":33713,"_15048":33714,"_1570":33715},[],"/docs/manual/servicios-core/cas#creación-de-cas-a-partir-de-claves-del-kms","Creación de CAs a partir de claves del KMS",{"_7897":676,"_22053":670,"_5":22191,"_18699":33717,"_15048":33718,"_1570":33719},[],"/docs/manual/servicios-core/cas#importación-de-autoridades-de-certificación","Importación de autoridades de certificación",{"_7897":677,"_22053":670,"_5":22191,"_18699":33721,"_15048":33722,"_1570":33723},[],"/docs/manual/servicios-core/cas#operando-con-entidades-de-confianza","Operando con entidades de confianza",{"_7897":678,"_22053":670,"_5":22191,"_18699":33725,"_15048":33726,"_1570":33727},[],"/docs/manual/servicios-core/cas#visualización-de-autoridades-de-certificación","Visualización de autoridades de certificación",{"_7897":679,"_22053":670,"_5":22191,"_18699":33729,"_15048":33730,"_1570":33731},[],"/docs/manual/servicios-core/cas#emisión-de-certificados","Emisión de certificados",{"_7897":680,"_22053":670,"_5":22191,"_18699":33733,"_15048":33734,"_1570":33735},[],"/docs/manual/servicios-core/cas#revocación-de-cas-y-certificados","Revocación de CAs y certificados",{"_7897":681,"_22053":670,"_18699":33737,"_5":22186,"_15048":33706,"_1570":33738},[],"Para acceder a la creación de nuevas entidades certificación se debe acceder la opción de entidades de certificación del menú lateral y luego seleccionar la acción de creación de nueva CA.",{"_7897":682,"_22053":670,"_18699":33740,"_5":22186,"_15048":33706,"_1570":33741},[],"Actualmente hay disponibles 3 acciones:",{"_7897":683,"_22053":670,"_18699":33743,"_5":22186,"_15048":33706,"_1570":33744},[],"**Creación de una nueva autoridad de certificación**, esta acción generará un nuevo par de claves para soportar la nueva autoridad de certificación.",{"_7897":684,"_22053":670,"_18699":33746,"_5":22186,"_15048":33706,"_1570":33747},[],"**Importar una nueva autoridad de certificación generada externamente**, permite importar en Lamassu una autoridad de certificación, cuyo par de claves ha sido generado de manera externa.",{"_7897":685,"_22053":670,"_18699":33749,"_5":22186,"_15048":33706,"_1570":33750},[],"**Importar un certificado de autoridad de certificación sin clave privada**, en este caso se importa la CA para poder usarla en procesos de validación y no como fuente de nuevos certificados gestionados por Lamassu.",{"_7897":686,"_22053":670,"_18699":33752,"_5":22186,"_15048":33710,"_1570":33753},[],"La creación de una Autoridad de Certificación (CA) es un proceso fundamental en el establecimiento de una infraestructura de clave pública (PKI). Lamassu IoT permite provisionar tanto autoridades raíz como intermedias mediante la generación automática de pares de claves criptográficas que son gestionados de forma segura por el sistema integrado de gestión de claves.",{"_7897":687,"_22053":670,"_18699":33755,"_5":22186,"_15048":33710,"_1570":33756},[],"En el formulario de creación se definen los siguientes bloques de configuración.",{"_7897":688,"_22053":670,"_18699":33758,"_5":22186,"_15048":33710,"_1570":33759},[],"**Motor criptográfico**",{"_7897":689,"_22053":670,"_18699":33761,"_5":22186,"_15048":33710,"_1570":33762},[],"**Selector:** Desplegable con motores disponibles, ofrece los configurados en el sistema.",{"_7897":690,"_22053":670,"_18699":33764,"_5":22186,"_15048":33710,"_1570":33765},[],"**Ejemplo mostrado:** go1.24.3",{"_7897":691,"_22053":670,"_18699":33767,"_5":22186,"_15048":33710,"_1570":33768},[],"**Función:** Permite seleccionar el motor criptográfico deseado",{"_7897":692,"_22053":670,"_18699":33770,"_5":22186,"_15048":33710,"_1570":33771},[],"**Parámetros de clave**",{"_7897":693,"_22053":670,"_18699":33773,"_5":22186,"_15048":33710,"_1570":33774},[],"**Key Type:** RSA / EC (Elliptic Curve)",{"_7897":694,"_22053":670,"_18699":33776,"_5":22186,"_15048":33710,"_1570":33777},[],"**Key Size:**",{"_7897":695,"_22053":670,"_18699":33779,"_5":22186,"_15048":33710,"_1570":33780},[],"RSA: 1024, 2048, 3072, 4096 bits",{"_7897":696,"_22053":670,"_18699":33782,"_5":22186,"_15048":33710,"_1570":33783},[],"EC: P-256, P-384, P-521",{"_7897":697,"_22053":670,"_18699":33785,"_5":22186,"_15048":33710,"_1570":33786},[],"**Recomendado:** EC P-384",{"_7897":698,"_22053":670,"_18699":33788,"_5":22186,"_15048":33710,"_1570":33789},[],"**Perfil de emisión del certificado de la CA**",{"_7897":699,"_22053":670,"_18699":33791,"_5":22186,"_15048":33710,"_1570":33792},[],"Aquí se puede seleccionar un perfil existente o definir uno en línea para la operación. Ese perfil permite especificar la duración de la CA que se está creando y los `Key Usage` y `Extended Key Usage` del certificado de soporte.",{"_7897":700,"_22053":670,"_18699":33794,"_5":22186,"_15048":33710,"_1570":33795},[],"Si no se proporciona ningún perfil se aplicará uno por defecto con los usos de clave básicos.",{"_7897":701,"_22053":670,"_18699":33797,"_5":22186,"_15048":33710,"_1570":33798},[],"**Configuración de la CA**",{"_7897":702,"_22053":670,"_18699":33800,"_5":22186,"_15048":33710,"_1570":33801},[],"**Tipo de CA**",{"_7897":703,"_22053":670,"_18699":33803,"_5":22186,"_15048":33710,"_1570":33804},[],"**Root CA:** Autoridad raíz autofirmada",{"_7897":704,"_22053":670,"_18699":33806,"_5":22186,"_15048":33710,"_1570":33807},[],"**Intermediate CA:** Autoridad subordinada",{"_7897":705,"_22053":670,"_18699":33809,"_5":22186,"_15048":33710,"_1570":33810},[],"**Emisor**",{"_7897":706,"_22053":670,"_18699":33812,"_5":22186,"_15048":33710,"_1570":33813},[],"**Root CA:** Self-signed (auto-firmada)",{"_7897":707,"_22053":670,"_18699":33815,"_5":22186,"_15048":33710,"_1570":33816},[],"**Intermediate CA:** Selector desplegable de CA superior disponible",{"_7897":708,"_22053":670,"_18699":33818,"_5":22186,"_15048":33710,"_1570":33819},[],"Permite seleccionar la CA padre que firmará la nueva CA intermedia",{"_7897":709,"_22053":670,"_18699":33821,"_5":22186,"_15048":33710,"_1570":33822},[],"**Identificación**",{"_7897":710,"_22053":670,"_18699":33824,"_5":22186,"_15048":33710,"_1570":33825},[],"**CA ID:** Generado automáticamente (formato UUID),no puede ser modificado. Estos IDs los gestiona el sistema.",{"_7897":711,"_22053":670,"_18699":33827,"_5":22186,"_15048":33710,"_1570":33828},[],"Ejemplo: 8f7c170-c84e-4c08-904f-8d3247c77fc2",{"_7897":712,"_22053":670,"_18699":33830,"_5":22186,"_15048":33710,"_1570":33831},[],"**CA Name:** Nombre descriptivo (obligatorio)",{"_7897":713,"_22053":670,"_18699":33833,"_5":22186,"_15048":33710,"_1570":33834},[],"Ejemplo: Lamassu IoT Secure Services CA",{"_7897":714,"_22053":670,"_18699":33836,"_5":22186,"_15048":33710,"_1570":33837},[],"**Subject Distinguished Name (DN)**",{"_7897":715,"_22053":670,"_18699":33839,"_5":22186,"_15048":33710,"_1570":33840},[],"Campos opcionales:",{"_7897":716,"_22053":670,"_18699":33842,"_5":22186,"_15048":33710,"_1570":33843},[],"**Country (C):** Código país ISO 3166-1 (2 letras)",{"_7897":717,"_22053":670,"_18699":33845,"_5":22186,"_15048":33710,"_1570":33846},[],"Ejemplo: US, ES, DE",{"_7897":718,"_22053":670,"_18699":33848,"_5":22186,"_15048":33710,"_1570":33849},[],"**State/Province (ST):** Estado o provincia",{"_7897":719,"_22053":670,"_18699":33851,"_5":22186,"_15048":33710,"_1570":33852},[],"Ejemplo: California, Madrid",{"_7897":720,"_22053":670,"_18699":33854,"_5":22186,"_15048":33710,"_1570":33855},[],"**Locality (L):** Ciudad o localidad",{"_7897":721,"_22053":670,"_18699":33857,"_5":22186,"_15048":33710,"_1570":33858},[],"Ejemplo: San Francisco, Arrasate",{"_7897":722,"_22053":670,"_18699":33860,"_5":22186,"_15048":33710,"_1570":33861},[],"**Organization (O):** Nombre de la organización",{"_7897":723,"_22053":670,"_18699":33863,"_5":22186,"_15048":33710,"_1570":33864},[],"Ejemplo: Lamassu IoT Corp",{"_7897":724,"_22053":670,"_18699":33866,"_5":22186,"_15048":33710,"_1570":33867},[],"**Organizational Unit (OU):** Unidad organizacional",{"_7897":725,"_22053":670,"_18699":33869,"_5":22186,"_15048":33710,"_1570":33870},[],"Ejemplo: Secure Devices Division",{"_7897":726,"_22053":670,"_18699":33872,"_5":22186,"_15048":33710,"_1570":33873},[],"El \"Certification Authority Name\" configurado se utilizará como Common Name (CN) del subject del certificado de la CA.",{"_7897":727,"_22053":670,"_18699":33875,"_5":22186,"_15048":33710,"_1570":33876},[],"**Configuración de expiración**\nLa configuración de expiración define la validez temporal tanto del certificado de la propia CA como de los certificados que ésta emitirá por defecto. Si se ha seleccionado un perfil se dará prioridad al dato proporcionado en el perfil.",{"_7897":728,"_22053":670,"_18699":33878,"_5":22186,"_15048":33710,"_1570":33879},[],"Para el certificado de la CA (`CA Certificate Expiration`):",{"_7897":729,"_22053":670,"_18699":33881,"_5":22186,"_15048":33710,"_1570":33882},[],"**Función:** Establece la duración de validez del certificado de la Autoridad de Certificación",{"_7897":730,"_22053":670,"_18699":33884,"_5":22186,"_15048":33710,"_1570":33885},[],"**Implicación:** Una vez expirado, la CA no podrá emitir nuevos certificados válidos",{"_7897":731,"_22053":670,"_18699":33887,"_5":22186,"_15048":33710,"_1570":33888},[],"**Duración:** Configurable según necesidades organizacionales",{"_7897":732,"_22053":670,"_18699":33890,"_5":22186,"_15048":33710,"_1570":33891},[],"**Valor por defecto:** 10 años (10y)",{"_7897":733,"_22053":670,"_18699":33893,"_5":22186,"_15048":33710,"_1570":33894},[],"**Consideración:** Debe ser mayor que la duración de los certificados que emitirá",{"_7897":734,"_22053":670,"_18699":33896,"_5":22186,"_15048":33710,"_1570":33897},[],"La expiración de la CA se puede definir como un expresión de duración, fijar una fecha fija, o marcarla como indefinida, lo que en términos prácticos permitirá la emisión de una CA sin caducidad.",{"_7897":735,"_22053":670,"_18699":33899,"_5":22186,"_15048":33710,"_1570":33900},[],"En el caso de expresar una duración, las unidades permitidas son: y (años), w (semanas), d (días), h (horas), m (minutos) y s (segundos), pudiendo componer expresiones como la siguiente: *5y 8w 4d 2h 1m 2s*",{"_7897":736,"_22053":670,"_18699":33902,"_5":22186,"_15048":33710,"_1570":33903},[],"En caso de elegir la opción de fecha específica, se ofrecerá un calendario para seleccionar la fecha de caducidad.",{"_7897":737,"_22053":670,"_18699":33905,"_5":22186,"_15048":33710,"_1570":33906},[],"Para el caso de indefinido, se fijará la fecha de expiración máxima permitida.",{"_7897":738,"_22053":670,"_18699":33908,"_5":22186,"_15048":33710,"_1570":33909},[],"Para la expiración por defecto de certificados finales (`Default End-Entity Certificate Issuance Expiration`):",{"_7897":739,"_22053":670,"_18699":33911,"_5":22186,"_15048":33710,"_1570":33912},[],"**Función:** Define la duración predeterminada para certificados emitidos por esta CA",{"_7897":740,"_22053":670,"_18699":33914,"_5":22186,"_15048":33710,"_1570":33915},[],"**Aplicación:** Se aplica automáticamente a nuevos certificados si no se especifica otra duración",{"_7897":741,"_22053":670,"_18699":33917,"_5":22186,"_15048":33710,"_1570":33918},[],"**Flexibilidad:** Puede ser modificada individualmente al emitir cada certificado",{"_7897":742,"_22053":670,"_18699":33920,"_5":22186,"_15048":33710,"_1570":33921},[],"**Valor por defecto:** 1 año (1y)",{"_7897":743,"_22053":670,"_18699":33923,"_5":22186,"_15048":33710,"_1570":33924},[],"Se expresa en los mismos términos que la caducidad de la CA.",{"_7897":744,"_22053":670,"_18699":33926,"_5":22186,"_15048":33710,"_1570":33927},[],"Una vez creada la CA debe ser visible en el listado de CAs del sistema.",{"_7897":745,"_22053":670,"_18699":33929,"_5":22186,"_15048":33714,"_1570":33930},[],"Lamassu IoT permite la creación de CAs a partir de claves previamente generadas o importadas en el servicio KMS. Una vez seleccionada la opción &#x2A;*Create New CA (Existing Key)** se muestra el formulario de creación de CAs con los siguientes elementos diferenciales respecto a la creación de la CA a partir de un nuevo par de claves descrito en el punto anterior.",{"_7897":746,"_22053":670,"_18699":33932,"_5":22186,"_15048":33714,"_1570":33933},[],"En este caso, primero se solicita la selección de la clave de soporte para esta nueva CA.",{"_7897":747,"_22053":670,"_18699":33935,"_5":22186,"_15048":33714,"_1570":33936},[],"Se abre un popup que permite al usuario seleccionar la clave deseada de entre las disponibles en el KMS. Una vez seleccionada la clave, el proceso continúa como se describe en el punto anterior.",{"_7897":748,"_22053":670,"_18699":33938,"_5":22186,"_15048":33718,"_1570":33939},[],"La importación de entidades de certificación permite importar en el sistema una CA que ha sido generada de manera externa. Para ello se sigue el siguiente proceso:",{"_7897":749,"_22053":670,"_18699":33941,"_5":22186,"_15048":33718,"_1570":33942},[],"Se debe seleccionar el motor que gestionará el par de claves importado.",{"_7897":750,"_22053":670,"_18699":33944,"_5":22186,"_15048":33718,"_1570":33762},[],{"_7897":751,"_22053":670,"_18699":33946,"_5":22186,"_15048":33718,"_1570":33765},[],{"_7897":752,"_22053":670,"_18699":33948,"_5":22186,"_15048":33718,"_1570":33768},[],{"_7897":753,"_22053":670,"_18699":33950,"_5":22186,"_15048":33718,"_1570":33951},[],"También se define la expiración por defecto de certificados finales (`Default End-Entity Certificate Issuance Expiration`):",{"_7897":754,"_22053":670,"_18699":33953,"_5":22186,"_15048":33718,"_1570":33912},[],{"_7897":755,"_22053":670,"_18699":33955,"_5":22186,"_15048":33718,"_1570":33915},[],{"_7897":756,"_22053":670,"_18699":33957,"_5":22186,"_15048":33718,"_1570":33918},[],{"_7897":757,"_22053":670,"_18699":33959,"_5":22186,"_15048":33718,"_1570":33921},[],{"_7897":758,"_22053":670,"_18699":33961,"_5":22186,"_15048":33718,"_1570":33924},[],{"_7897":759,"_22053":670,"_18699":33963,"_5":22186,"_15048":33718,"_1570":33964},[],"Se debe proporcionar de manera obligatoria:",{"_7897":760,"_22053":670,"_18699":33966,"_5":22186,"_15048":33718,"_1570":33967},[],"Certificado de la CA en formato PEM. Se comprueba que el certificado importado corresponda con el de una CA.",{"_7897":761,"_22053":670,"_18699":33969,"_5":22186,"_15048":33718,"_1570":33970},[],"Clave privada de la CA en formato PEM",{"_7897":762,"_22053":670,"_18699":33972,"_5":22186,"_15048":33718,"_1570":33973},[],"De manera opcional se proporcionarán en formato PEM la cadena de certificados de la cadena de validación en caso de importar una CA subordinada.",{"_7897":763,"_22053":670,"_18699":33975,"_5":22186,"_15048":33726,"_1570":33976},[],"Accediendo a la sección de autoridades de certificación se mostrará el listado de CAs registradas en el sistema. El listado permitirá el filtro mediante el nombre de la CA, el estado o el tipo de CA.",{"_7897":764,"_22053":670,"_18699":33978,"_5":22186,"_15048":33726,"_1570":33979},[],"La acción de ver detalles da acceso a los detalles de la CA y a diferentes opciones de gestión.",{"_7897":765,"_22053":670,"_18699":33981,"_5":22186,"_15048":33726,"_1570":33982},[],"En los detalles se muestra el resumen del estado de los certificados emitidos por la CA: certificados activos, expirados y revocados.",{"_7897":766,"_22053":670,"_18699":33984,"_5":22186,"_15048":33726,"_1570":33985},[],"Se ofrecen dos acciones:",{"_7897":767,"_22053":670,"_18699":33987,"_5":22186,"_15048":33726,"_1570":33988},[],"la descarga de la CRL vinculada a la CA que permitirá a otros sistemas realizar comprobaciones de vigencia de los certificados emitidos por la CA de manera desconectada.",{"_7897":768,"_22053":670,"_18699":33990,"_5":22186,"_15048":33726,"_1570":33991},[],"la acción de revocación de la CA",{"_7897":769,"_22053":670,"_18699":33993,"_5":22186,"_15048":33726,"_1570":33994},[],"Se muestra información detallada, el certificado en formato PEM y se da acceso a la relación de certificados emitidos por la CA a través de la pestaña “Issued Certificates”",{"_7897":770,"_22053":670,"_18699":33996,"_5":22186,"_15048":33730,"_1570":33997},[],"La acción de emisión de certificados se puede realizar desde la pestaña “Issued Certificates” de los detalles de la CA, mediante la acción “Issue New”.",{"_7897":771,"_22053":670,"_18699":33999,"_5":22186,"_15048":33730,"_1570":34000},[],"La funcionalidad de emisión es accesible también desde el listado de CAs mediante la acción correspondiente de emisión.",{"_7897":772,"_22053":670,"_18699":34002,"_5":22186,"_15048":33730,"_1570":34003},[],"Y desde la funcionalidad  listado completo de certificados emitidos por Lamassu mediante la acción “Issue Certificate”",{"_7897":773,"_22053":670,"_18699":34005,"_5":22186,"_15048":33730,"_1570":34006},[],"En este caso se solicitará la selección de una CA antes de acceder al formulario de emisión.",{"_7897":774,"_22053":670,"_18699":34008,"_5":22186,"_15048":33730,"_1570":34009},[],"El formulario de emisión de certificados ofrece 2 opciones para la emisión:",{"_7897":775,"_22053":670,"_18699":34011,"_5":22186,"_15048":33730,"_1570":34012},[],"Emisión a partir de una clave privada y el CSR generado en el browser",{"_7897":776,"_22053":670,"_18699":34014,"_5":22186,"_15048":33730,"_1570":34015},[],"Emisión a partir de un CSR generado de manera externa",{"_7897":777,"_22053":670,"_18699":34017,"_5":22186,"_15048":33730,"_1570":34018},[],"**Emisión a partir de una clave privada y el CSR generados en el browser**",{"_7897":778,"_22053":670,"_18699":34020,"_5":22186,"_15048":33730,"_1570":34021},[],"El usuario proporciona la información requerida para la creación del CSR, la consola genera una clave In Place y genera el CSR correspondiente mediante el cual se solicita la emisión del certificado a la CA.",{"_7897":779,"_22053":670,"_18699":34023,"_5":22186,"_15048":33730,"_1570":34024},[],"**Método de emisión:** Seleccionar  \"Generate Key & CSR in Browser\" para la generación del par de claves y la solicitud de certificado (CSR) directamente en el navegador",{"_7897":780,"_22053":670,"_18699":34026,"_5":22186,"_15048":33730,"_1570":34027},[],"**Certificate Subject (Sujeto del certificado)**",{"_7897":781,"_22053":670,"_18699":34029,"_5":22186,"_15048":33730,"_1570":34030},[],"**Common Name (CN)**",{"_7897":782,"_22053":670,"_18699":34032,"_5":22186,"_15048":33730,"_1570":34033},[],"**Campo:** Obligatorio",{"_7897":783,"_22053":670,"_18699":34035,"_5":22186,"_15048":33730,"_1570":34036},[],"**Función:** Identifica de forma única al titular del certificado",{"_7897":784,"_22053":670,"_18699":34038,"_5":22186,"_15048":33730,"_1570":34039},[],"**Ejemplos:**",{"_7897":785,"_22053":670,"_18699":34041,"_5":22186,"_15048":33730,"_1570":34042},[],"Para dispositivos: device001.company.com",{"_7897":786,"_22053":670,"_18699":34044,"_5":22186,"_15048":33730,"_1570":34045},[],"Para usuarios: john.doe\\@company.com",{"_7897":787,"_22053":670,"_18699":34047,"_5":22186,"_15048":33730,"_1570":34048},[],"Para servicios: api.service.company.com",{"_7897":788,"_22053":670,"_18699":34050,"_5":22186,"_15048":33730,"_1570":34051},[],"**Campos Organizacionales**",{"_7897":789,"_22053":670,"_18699":34053,"_5":22186,"_15048":33730,"_1570":34054},[],"**Organizational Unit (OU):** Unidad organizacional del titular",{"_7897":790,"_22053":670,"_18699":34056,"_5":22186,"_15048":33730,"_1570":34057},[],"Ejemplo: IT Department, Manufacturing",{"_7897":791,"_22053":670,"_18699":34059,"_5":22186,"_15048":33730,"_1570":33861},[],{"_7897":792,"_22053":670,"_18699":34061,"_5":22186,"_15048":33730,"_1570":34062},[],"Ejemplo: LamassuIoT Corp, Acme Industries",{"_7897":793,"_22053":670,"_18699":34064,"_5":22186,"_15048":33730,"_1570":34065},[],"**Información Geográfica**",{"_7897":794,"_22053":670,"_18699":34067,"_5":22186,"_15048":33730,"_1570":34068},[],"**Locality (L):** Ciudad o localidad del titular",{"_7897":795,"_22053":670,"_18699":34070,"_5":22186,"_15048":33730,"_1570":33849},[],{"_7897":796,"_22053":670,"_18699":34072,"_5":22186,"_15048":33730,"_1570":34073},[],"**Country (C):** Código de país ISO 3166-1 (2 letras)",{"_7897":797,"_22053":670,"_18699":34075,"_5":22186,"_15048":33730,"_1570":34076},[],"Valor por defecto mostrado: US",{"_7897":798,"_22053":670,"_18699":34078,"_5":22186,"_15048":33730,"_1570":34079},[],"**Subject Alternative Names (SANs)**\nLos SANs proporcionan identificadores alternativos para el certificado, permitiendo que un mismo certificado sea válido para múltiples nombres o direcciones.",{"_7897":799,"_22053":670,"_18699":34081,"_5":22186,"_15048":33730,"_1570":34082},[],"**Tipos de SAN Disponibles**",{"_7897":800,"_22053":670,"_18699":34084,"_5":22186,"_15048":33730,"_1570":34085},[],"**DNS:** Nombres de dominio",{"_7897":801,"_22053":670,"_18699":34087,"_5":22186,"_15048":33730,"_1570":34088},[],"Ejemplo: example.com, \\*.example.com",{"_7897":802,"_22053":670,"_18699":34090,"_5":22186,"_15048":33730,"_1570":34091},[],"**IP Address:** Direcciones IP",{"_7897":803,"_22053":670,"_18699":34093,"_5":22186,"_15048":33730,"_1570":34094},[],"**Email:** Direcciones de correo electrónico",{"_7897":804,"_22053":670,"_18699":34096,"_5":22186,"_15048":33730,"_1570":34097},[],"**URI:** Identificadores de recursos uniformes",{"_7897":805,"_22053":670,"_18699":34099,"_5":22186,"_15048":33730,"_1570":34100},[],"Es posible añadir múltiples SAN de cada tipo, se selecciona el tipo, añadiendo el valor y pulsando la acción “Add”.",{"_7897":806,"_22053":670,"_18699":34102,"_5":22186,"_15048":33730,"_1570":34103},[],"**Key Generation Details (Detalles de generación de claves)**\nSe debe especificar el tipo de clave a ser generada para la solicitud del certificado.",{"_7897":807,"_22053":670,"_18699":34105,"_5":22186,"_15048":33730,"_1570":34106},[],"**Algorithm (Algoritmo)**",{"_7897":808,"_22053":670,"_18699":34108,"_5":22186,"_15048":33730,"_1570":34109},[],"**ECDSA:** Algoritmo de curva elíptica, se debe especificar la curva a utilizar",{"_7897":809,"_22053":670,"_18699":34111,"_5":22186,"_15048":33730,"_1570":34112},[],"**RSA:** Algoritmo RSA tradicional, se debe indicar el tamaño de clave",{"_7897":810,"_22053":670,"_18699":34114,"_5":22186,"_15048":33730,"_1570":34115},[],"**Certificate Configuration (Configuración del certificado)**",{"_7897":811,"_22053":670,"_18699":34117,"_5":22186,"_15048":33730,"_1570":34118},[],"**Validity Duration (Duración de validez)**",{"_7897":812,"_22053":670,"_18699":34120,"_5":22186,"_15048":33730,"_1570":34121},[],"Indica la fecha de expiración del certificado a emitir como una expresión de duración",{"_7897":813,"_22053":670,"_18699":34123,"_5":22186,"_15048":33730,"_1570":34124},[],"**Campo:** Configurable según necesidades",{"_7897":814,"_22053":670,"_18699":34126,"_5":22186,"_15048":33730,"_1570":33921},[],{"_7897":815,"_22053":670,"_18699":34128,"_5":22186,"_15048":33730,"_1570":34129},[],"**Unidades válidas:** y (años), w (semanas), d (días), h (horas), m (minutos), s (segundos)",{"_7897":816,"_22053":670,"_18699":34131,"_5":22186,"_15048":33730,"_1570":34132},[],"**Consideración:** No puede exceder la validez de la CA emisora",{"_7897":817,"_22053":670,"_18699":34134,"_5":22186,"_15048":33730,"_1570":34135},[],"**Key Usage (Uso de claves)**\nDefine los propósitos criptográficos para los que puede utilizarse la clave privada del certificado.",{"_7897":818,"_22053":670,"_18699":34137,"_5":22186,"_15048":33730,"_1570":34138},[],"**Usos Básicos**",{"_7897":819,"_22053":670,"_18699":34140,"_5":22186,"_15048":33730,"_1570":34141},[],"**Digital Signature:** ✓ (marcado por defecto) - Firmas digitales",{"_7897":820,"_22053":670,"_18699":34143,"_5":22186,"_15048":33730,"_1570":34144},[],"**Content Commitment (Non-Repudiation):** No repudio",{"_7897":821,"_22053":670,"_18699":34146,"_5":22186,"_15048":33730,"_1570":34147},[],"**Key Encipherment:** Cifrado de claves",{"_7897":822,"_22053":670,"_18699":34149,"_5":22186,"_15048":33730,"_1570":34150},[],"**Data Encipherment:** Cifrado de datos",{"_7897":823,"_22053":670,"_18699":34152,"_5":22186,"_15048":33730,"_1570":34153},[],"**Key Agreement:** Acuerdo de claves",{"_7897":824,"_22053":670,"_18699":34155,"_5":22186,"_15048":33730,"_1570":34156},[],"**Certificate Signing:** Firma de certificados",{"_7897":825,"_22053":670,"_18699":34158,"_5":22186,"_15048":33730,"_1570":34159},[],"**CRL Signing:** Firma de listas de revocación",{"_7897":826,"_22053":670,"_18699":34161,"_5":22186,"_15048":33730,"_1570":34162},[],"**Encipher Only:** Solo cifrado",{"_7897":827,"_22053":670,"_18699":34164,"_5":22186,"_15048":33730,"_1570":34165},[],"**Decipher Only:** Solo descifrado",{"_7897":828,"_22053":670,"_18699":34167,"_5":22186,"_15048":33730,"_1570":34168},[],"**Uso Extendido de Claves**",{"_7897":829,"_22053":670,"_18699":34170,"_5":22186,"_15048":33730,"_1570":34171},[],"Especifica aplicaciones específicas para las que está autorizado el certificado.",{"_7897":830,"_22053":670,"_18699":34173,"_5":22186,"_15048":33730,"_1570":34174},[],"**Server Authentication:** ✓ (marcado por defecto) - Autenticación de servidor",{"_7897":831,"_22053":670,"_18699":34176,"_5":22186,"_15048":33730,"_1570":34177},[],"**Client Authentication:** ✓ (marcado por defecto) - Autenticación de cliente",{"_7897":832,"_22053":670,"_18699":34179,"_5":22186,"_15048":33730,"_1570":34180},[],"**Code Signing:** Firma de código",{"_7897":833,"_22053":670,"_18699":34182,"_5":22186,"_15048":33730,"_1570":34183},[],"**Email Protection:** Protección de correo electrónico",{"_7897":834,"_22053":670,"_18699":34185,"_5":22186,"_15048":33730,"_1570":34186},[],"**Time Stamping:** Sellado de tiempo",{"_7897":835,"_22053":670,"_18699":34188,"_5":22186,"_15048":33730,"_1570":34189},[],"**OCSP Signing:** Firma de respuestas OCSP",{"_7897":836,"_22053":670,"_18699":34191,"_5":22186,"_15048":33730,"_1570":34192},[],"Una vez completado los campos del formulario se solicita la emisión del certificado obteniendo el certificado y la clave privada generada en formato PEM. Esta clave privada no se almacena debe ser descargada y custodiada por el usuario ya que no se podrá volver a obtener.",{"_7897":837,"_22053":670,"_18699":34194,"_5":22186,"_15048":33730,"_1570":34195},[],"**Emisión a partir de un CSR generado de manera externa**",{"_7897":838,"_22053":670,"_18699":34197,"_5":22186,"_15048":33730,"_1570":34198},[],"Mediante esta opción se podrá realizar la emisión de certificados a partir de CSRs que hayan sido generados de manera externa. Para ello en el selector de modo del formulario de emisión es necesario seleccionar “Upload Existing CSR”.",{"_7897":839,"_22053":670,"_18699":34200,"_5":22186,"_15048":33730,"_1570":34201},[],"Se debe proporcionar un CSR válido que contenga los detalles del certificado a emitir, Subject Name, SANs,..",{"_7897":840,"_22053":670,"_18699":34203,"_5":22186,"_15048":33730,"_1570":34204},[],"Adicionalmente se proporcionará la duración deseada para el certificado y los usos permitidos. Con esta información se procederá a la emisión como se describe en el apartado anterior.",{"_7897":841,"_22053":670,"_18699":34206,"_5":22186,"_15048":33734,"_1570":34207},[],"La revocación de una Autoridad de Certificación (CA) es una acción crítica que invalida todos los certificados emitidos por esa CA, lo que puede causar interrupciones generalizadas en los dispositivos y servicios que confían en ella. Este proceso es irreversible y debe realizarse con extrema precaución.",{"_7897":842,"_22053":670,"_18699":34209,"_5":22186,"_15048":33734,"_1570":34210},[],"Para iniciar el proceso, entra en la sección de Autoridades de Certificación y localiza la CA deseada usando los filtros por **Nombre**, **Estado** y **Tipo**.",{"_7897":843,"_22053":670,"_18699":34212,"_5":22186,"_15048":33734,"_1570":34213},[],"Accede a la ficha de detalle de la CA. Allí se muestran la información general, los certificados PEM, los metadatos y los certificados emitidos, además del botón **Revoke CA**.",{"_7897":844,"_22053":670,"_18699":34215,"_5":22186,"_15048":33734,"_1570":34216},[],"Al pulsar **Revoke CA** se abre una ventana de confirmación con una advertencia sobre el impacto de la acción. En ese cuadro hay que seleccionar una **Razón de Revocación**. Las opciones incluyen:",{"_7897":845,"_22053":670,"_18699":34218,"_5":22186,"_15048":33734,"_1570":34219},[],"Unspecified (No especificado)",{"_7897":846,"_22053":670,"_18699":34221,"_5":22186,"_15048":33734,"_1570":34222},[],"KeyCompromise (Compromiso de clave)",{"_7897":847,"_22053":670,"_18699":34224,"_5":22186,"_15048":33734,"_1570":34225},[],"CACompromise (Compromiso de CA)",{"_7897":848,"_22053":670,"_18699":34227,"_5":22186,"_15048":33734,"_1570":34228},[],"AffiliationChanged (Afiliación cambiada)",{"_7897":849,"_22053":670,"_18699":34230,"_5":22186,"_15048":33734,"_1570":34231},[],"Superseded (Sustituida)",{"_7897":850,"_22053":670,"_18699":34233,"_5":22186,"_15048":33734,"_1570":34234},[],"CessationOfOperation (Cese de operación)",{"_7897":851,"_22053":670,"_18699":34236,"_5":22186,"_15048":33734,"_1570":34237},[],"CertificateHold (Retención de certificado)",{"_7897":852,"_22053":670,"_18699":34239,"_5":22186,"_15048":33734,"_1570":34240},[],"RemoveFromCRL (Eliminar de la CRL)",{"_7897":853,"_22053":670,"_18699":34242,"_5":22186,"_15048":33734,"_1570":34243},[],"Para evitar revocaciones accidentales, el sistema pedirá confirmar el nombre de la CA. En el campo de texto, escribe el **nombre exacto de la CA** que estás revocando. Una vez introducido correctamente, se habilitará el botón **Confirm Revocation**.",{"_7897":854,"_22053":670,"_18699":34245,"_5":22186,"_15048":33734,"_1570":34246},[],"Haz clic en el botón **Confirm Revocation**. Una vez completada la revocación, la CA cambiará su estado a **REVOKED** (Revocada) en la página de detalles, y ya no podrás emitir certificados nuevos con ella. En su lugar, verás la opción **Permanently Delete** (Eliminar Permanentemente).",{"_7897":855,"_22053":670,"_18699":34248,"_5":22186,"_15048":33734,"_1570":34249},[],"Consideraciones importantes:",{"_7897":856,"_22053":670,"_18699":34251,"_5":22186,"_15048":33734,"_1570":34252},[],"Impacto: La revocación de una CA es una acción irreversible que afectará a todos los dispositivos y servicios que dependen de ella. Asegúrate de comprender completamente las implicaciones antes de proceder.",{"_7897":857,"_22053":670,"_18699":34254,"_5":22186,"_15048":33734,"_1570":34255},[],"Eliminación Permanente: Después de la revocación, tendrás la opción de eliminar permanentemente la CA. Esta acción eliminará la CA del sistema de Lamassu IoT.",{"_7897":858,"_22053":858,"_5":22181,"_1570":34257,"_22194":34258,"_18699":34259,"_15048":858},"[Certs] Gestión de Certificados",[31686,32785,32794],[],{"_7897":859,"_22053":858,"_18699":34261,"_5":22186,"_15048":858,"_1570":34262},[],"Visualización y gestión de certificados emitidos",{"_7897":860,"_22053":858,"_5":22191,"_18699":34264,"_15048":34265,"_1570":34266},[],"/docs/manual/servicios-core/certificates#gestión-de-certificados","Gestión de certificados",{"_7897":861,"_22053":858,"_5":22191,"_18699":34268,"_15048":34269,"_1570":34270},[],"/docs/manual/servicios-core/certificates#revocación-de-certificados","Revocación de certificados",{"_7897":862,"_22053":858,"_18699":34272,"_5":22186,"_15048":34265,"_1570":34273},[],"Los certificados emitidos por Lamassu son accesibles, tanto desde la pestaña de Issued Certificates de los detalles de una CA como desde la opción “Certificates” del menú lateral.\\\nEn la pestaña de “Issued Certificates” se muestran los certificados emitidos por la CA seleccionada.",{"_7897":863,"_22053":858,"_18699":34275,"_5":22186,"_15048":34265,"_1570":34276},[],"Como desde la opción “Certificates” del menú lateral, donde se presentan todos los certificados emitidos por Lamassu independientemente de la CA que lo haya emitido. Esta pantalla incluye la opción de filtro de los certificados por CN, número de serie, estado y por la CA que lo emitió.",{"_7897":864,"_22053":858,"_18699":34278,"_5":22186,"_15048":34265,"_1570":34279},[],"Por cada certificado se incluye un conjunto de acciones vinculadas al certificado.\\\nAcceso a los detalles “View Details”, un mecanismo de inspección rápida (Quick Inspect) con la información básica del certificado, la opción de descarga en formato PEM y el acceso a las acciones de revocación.\\\nLa vista de detalle, proporciona información adicional y el acceso a las acciones de revocación.",{"_7897":865,"_22053":858,"_18699":34281,"_5":22186,"_15048":34269,"_1570":34282},[],"Ya sea desde las acciones del listado de certificados, como desde la vista de detalle se puede desencadenar la acción de revocación. Al pulsar sobre “Revoke Certificate” se abre una ventana modal en la que se debe seleccionar la razón de la revocación.",{"_7897":866,"_22053":858,"_18699":34284,"_5":22186,"_15048":34269,"_1570":34285},[],"Es importante destacar que la única razón reversible es “CertificateHold”, una revocación por cualquier otra  razón no podrá ser revertida. En caso de seleccionar “CertificateHold” se ofrecerá una acción de reactivación.",{"_7897":867,"_22053":867,"_5":22181,"_1570":34287,"_22194":34288,"_18699":34289,"_15048":867},"[Devices] Dispositivos e Identidades",[31686,32785,32794],[],{"_7897":868,"_22053":867,"_18699":34291,"_5":22186,"_15048":867,"_1570":34292},[],"Gestión de dispositivos IoT y sus identidades digitales",{"_7897":869,"_22053":867,"_5":22191,"_18699":34294,"_15048":34295,"_1570":34296},[],"/docs/manual/servicios-core/devices#dispositivos-y-gestión-de-las-identidades--end-entities","Dispositivos y gestión de las identidades – End entities",{"_7897":870,"_22053":867,"_5":22191,"_18699":34298,"_15048":34299,"_1570":34300},[],"/docs/manual/servicios-core/devices#visualización-de-dispositivos-gestionados","Visualización de Dispositivos Gestionados",{"_7897":871,"_22053":867,"_5":22191,"_18699":34302,"_15048":34303,"_1570":34304},[],"/docs/manual/servicios-core/devices#detalle-del-dispositivo-historial-de-certificados","Detalle del Dispositivo: Historial de Certificados",{"_7897":872,"_22053":867,"_5":22191,"_18699":34306,"_15048":34307,"_1570":34308},[],"/docs/manual/servicios-core/devices#detalle-del-dispositivo-línea-de-tiempo-de-eventos","Detalle del Dispositivo: Línea de tiempo de eventos",{"_7897":873,"_22053":867,"_5":22191,"_18699":34310,"_15048":34311,"_1570":34312},[],"/docs/manual/servicios-core/devices#registro-de-nuevos-dispositivos","Registro de Nuevos Dispositivos",{"_7897":874,"_22053":867,"_5":22191,"_18699":34314,"_15048":34315,"_1570":34316},[],"/docs/manual/servicios-core/devices#asignación-manual-de-identidad","Asignación Manual de Identidad",{"_7897":875,"_22053":867,"_5":22191,"_18699":34318,"_15048":34319,"_1570":34320},[],"/docs/manual/servicios-core/devices#revocación-de-identidad","Revocación de Identidad",{"_7897":876,"_22053":867,"_5":22191,"_18699":34322,"_15048":34323,"_1570":34324},[],"/docs/manual/servicios-core/devices#desactivación-de-dispositivos-decommissioning","Desactivación de Dispositivos (Decommissioning)",{"_7897":877,"_22053":867,"_18699":34326,"_5":22186,"_15048":34295,"_1570":34327},[],"La gestión del ciclo de vida de las identidades de los dispositivos es una funcionalidad central en Lamassu IoT. Esta sección del manual se enfoca en la visualización y administración de las identidades de los dispositivos ya enrolados, conocidos como *End Entities* (entidades finales). Permite una visión completa del estado, los certificados y los eventos históricos de cada dispositivo, facilitando su monitorización y control a lo largo de su ciclo de vida.",{"_7897":878,"_22053":867,"_18699":34329,"_5":22186,"_15048":34299,"_1570":34330},[],"La página de **Dispositivos** (Managed Devices) ofrece una vista general de todos los dispositivos registrados en el sistema. Puedes ver un resumen del estado de cada dispositivo, su grupo, la fecha de creación y las etiquetas asociadas. Esta visualización es clave para tener una perspectiva general del parque de dispositivos y su salud respecto al estado de su identidad.",{"_7897":879,"_22053":867,"_18699":34332,"_5":22186,"_15048":34299,"_1570":34333},[],"Para facilitar la búsqueda y el seguimiento, la interfaz permite filtrar los dispositivos por **Device ID** y por **Tags**. Además, se puede filtrar por los siguientes estados:",{"_7897":880,"_22053":867,"_18699":34335,"_5":22186,"_15048":34299,"_1570":34336},[],"**Active**: El dispositivo y su certificado están en uso y son válidos.",{"_7897":881,"_22053":867,"_18699":34338,"_5":22186,"_15048":34299,"_1570":34339},[],"**No Identity**: El dispositivo existe en el sistema, pero no tiene una identidad digital (certificado) asociada.",{"_7897":882,"_22053":867,"_18699":34341,"_5":22186,"_15048":34299,"_1570":34342},[],"**Renewal Pending**: El dispositivo se encuentra en la ventana de tiempo de renovación y su certificado expirará pronto.",{"_7897":883,"_22053":867,"_18699":34344,"_5":22186,"_15048":34299,"_1570":34345},[],"**Expiring Soon**: El certificado del dispositivo está a punto de caducar.",{"_7897":884,"_22053":867,"_18699":34347,"_5":22186,"_15048":34299,"_1570":34348},[],"**Expired**: El certificado del dispositivo ha caducado.",{"_7897":885,"_22053":867,"_18699":34350,"_5":22186,"_15048":34299,"_1570":34351},[],"**Revoked**: El certificado del dispositivo ha sido revocado.",{"_7897":886,"_22053":867,"_18699":34353,"_5":22186,"_15048":34299,"_1570":34354},[],"**Decommissioned**: El dispositivo ha sido dado de baja y ya no está en uso.",{"_7897":887,"_22053":867,"_18699":34356,"_5":22186,"_15048":34303,"_1570":34357},[],"Al seleccionar un dispositivo específico, se accede a su página de detalles. La pestaña de **Historial de Certificados** muestra un registro cronológico de todos los certificados X.509 que han sido asociados a la identidad de ese dispositivo. Aquí se pueden ver detalles como el número de serie, el estado del certificado (por ejemplo, activo, expirado o revocado), el nombre común, la CA emisora y los periodos de validez.",{"_7897":888,"_22053":867,"_18699":34359,"_5":22186,"_15048":34303,"_1570":34360},[],"Esta funcionalidad es fundamental para auditar y rastrear la historia de la identidad del dispositivo, lo que permite identificar si un certificado ha sido reemplazado o revocado en algún momento.",{"_7897":889,"_22053":867,"_18699":34362,"_5":22186,"_15048":34307,"_1570":34363},[],"La pestaña de **Línea de tiempo de eventos** (Device Event Timeline) proporciona un registro detallado y cronológico de los eventos más importantes relacionados con el dispositivo y su identidad. Estos eventos pueden incluir el aprovisionamiento inicial, la renovación de certificados o cambios de estado.",{"_7897":890,"_22053":867,"_18699":34365,"_5":22186,"_15048":34307,"_1570":34366},[],"Esta línea de tiempo es una herramienta poderosa para el análisis forense y la resolución de problemas, ya que permite ver la secuencia exacta de las acciones que han ocurrido en la vida del dispositivo.",{"_7897":891,"_22053":867,"_18699":34368,"_5":22186,"_15048":34311,"_1570":34369},[],"Además de la gestión de dispositivos ya enrolados, Lamassu IoT permite el registro manual de nuevos dispositivos. Esto es particularmente útil para el modo de registro por **Pre-registration**, donde la identidad del dispositivo debe existir en el sistema antes de que pueda solicitar un certificado.",{"_7897":892,"_22053":867,"_18699":34371,"_5":22186,"_15048":34311,"_1570":34372},[],"El proceso de registro de un nuevo dispositivo se realiza a través de un formulario que permite configurar los siguientes campos:",{"_7897":893,"_22053":867,"_18699":34374,"_5":22186,"_15048":34311,"_1570":34375},[],"**Device ID (GUID)**: Es el identificador único del dispositivo, normalmente un GUID (Globally Unique Identifier).",{"_7897":894,"_22053":867,"_18699":34377,"_5":22186,"_15048":34311,"_1570":34378},[],"**Registration Authority**: Se debe seleccionar la RA a la que se asociará el dispositivo, lo que definirá las políticas de *enrollment* y *re-enrollment* que se aplicarán.",{"_7897":895,"_22053":867,"_18699":34380,"_5":22186,"_15048":34311,"_1570":34381},[],"**Device Registration Profile**: En esta sección se pueden configurar aspectos visuales para facilitar la identificación del dispositivo.",{"_7897":896,"_22053":867,"_18699":34383,"_5":22186,"_15048":34311,"_1570":34384},[],"**Icon**: Permite seleccionar un icono que represente visualmente el tipo de dispositivo.",{"_7897":897,"_22053":867,"_18699":34386,"_5":22186,"_15048":34311,"_1570":34387},[],"**Tags**: Se pueden añadir etiquetas para agrupar y organizar el dispositivo con otros de características similares.",{"_7897":898,"_22053":867,"_18699":34389,"_5":22186,"_15048":34311,"_1570":34390},[],"Una vez registrado, el dispositivo aparecerá en el listado de dispositivos con el estado **No Identity** hasta que complete el proceso de *enrollment* y obtenga su primer certificado.",{"_7897":899,"_22053":867,"_18699":34392,"_5":22186,"_15048":34315,"_1570":34393},[],"La **Asignación manual de identidad** es una acción que solo está disponible para dispositivos en estado **No Identity**, es decir, que han sido registrados en el sistema pero aún no tienen un certificado asignado. Esta funcionalidad permite vincular un certificado ya existente o emitir uno nuevo de forma manual.",{"_7897":900,"_22053":867,"_18699":34395,"_5":22186,"_15048":34315,"_1570":34396},[],"El proceso se lleva a cabo desde la vista de detalles del dispositivo:",{"_7897":901,"_22053":867,"_18699":34398,"_5":22186,"_15048":34315,"_1570":34399},[],"**Iniciar la asignación**: Se hace clic en el botón **Assign Identity**. Esto abrirá una ventana emergente.",{"_7897":902,"_22053":867,"_18699":34401,"_5":22186,"_15048":34315,"_1570":34402},[],"**Vincular certificado existente**: La aplicación buscará certificados activos con un Common Name (CN) que coincida con el Device ID. Si se encuentra un certificado, se puede seleccionar y vincular al dispositivo.",{"_7897":903,"_22053":867,"_18699":34404,"_5":22186,"_15048":34315,"_1570":34405},[],"**Emitir un nuevo certificado**: Si no se encuentra un certificado existente, o si se desea emitir uno nuevo, se puede seleccionar la opción **Issue New Instead**. Esto te permite elegir la **Certification Authority** que emitirá el nuevo certificado para el dispositivo. Se muestran por defecto las CAs vinculadas a la RA que gestiona ell dispositivo.",{"_7897":904,"_22053":867,"_18699":34407,"_5":22186,"_15048":34315,"_1570":34408},[],"**Confirmar y asignar**: Una vez seleccionado el certificado (existente o nuevo), se confirma la asignación. El dispositivo pasará del estado **No Identity** al estado **Active** y el certificado aparecerá en su historial.",{"_7897":905,"_22053":867,"_18699":34410,"_5":22186,"_15048":34319,"_1570":34411},[],"La revocación de la identidad es un proceso crítico para la seguridad que permite invalidar un certificado antes de su fecha de caducidad. Esta acción es irreversible. En Lamassu IoT, la revocación se realiza desde la sección de detalle del dispositivo, específicamente desde la línea de tiempo de eventos.",{"_7897":906,"_22053":867,"_18699":34413,"_5":22186,"_15048":34319,"_1570":34414},[],"El proceso de revocación se lleva a cabo de la siguiente manera:",{"_7897":907,"_22053":867,"_18699":34416,"_5":22186,"_15048":34319,"_1570":34417},[],"**Acceder a la revocación**: En la sección **Device Event Timeline**, junto al último certificado **Active**, se encuentra la opción de **Revoke**. Al hacer clic en ella, se abre una ventana de confirmación.",{"_7897":908,"_22053":867,"_18699":34419,"_5":22186,"_15048":34319,"_1570":34420},[],"**Seleccionar el motivo de revocación**: La ventana emergente solicita seleccionar un motivo de revocación (Revocation Reason). Esto es esencial para el registro de auditoría y la generación de la CRL (Certificate Revocation List). Los motivos disponibles, definidos en el **RFC 5280**, y otros adicionales son:",{"_7897":909,"_22053":867,"_18699":34422,"_5":22186,"_15048":34319,"_1570":34423},[],"**Unspecified**: Motivo de revocación no especificado.",{"_7897":910,"_22053":867,"_18699":34425,"_5":22186,"_15048":34319,"_1570":34426},[],"**KeyCompromise**: La clave privada del certificado ha sido comprometida.",{"_7897":911,"_22053":867,"_18699":34428,"_5":22186,"_15048":34319,"_1570":34429},[],"**CACompromise**: La clave privada de la CA ha sido comprometida.",{"_7897":912,"_22053":867,"_18699":34431,"_5":22186,"_15048":34319,"_1570":34432},[],"**AffiliationChanged**: El nombre del sujeto o su afiliación ha cambiado.",{"_7897":913,"_22053":867,"_18699":34434,"_5":22186,"_15048":34319,"_1570":34435},[],"**Superseded**: El certificado ha sido reemplazado por uno nuevo.",{"_7897":914,"_22053":867,"_18699":34437,"_5":22186,"_15048":34319,"_1570":34438},[],"**CessationOfOperation**: La entidad ha dejado de operar o usar el certificado.",{"_7897":915,"_22053":867,"_18699":34440,"_5":22186,"_15048":34319,"_1570":34441},[],"**CertificateHold**: El certificado está temporalmente en espera de revocación.",{"_7897":916,"_22053":867,"_18699":34443,"_5":22186,"_15048":34319,"_1570":34444},[],"**RemoveFromCRL**: Se usa en un *delta-CRL* para indicar que el certificado fue previamente puesto en espera y ahora debe ser revocado definitivamente.",{"_7897":917,"_22053":867,"_18699":34446,"_5":22186,"_15048":34319,"_1570":34447},[],"**PrivilegeWithdrawn**: Se han retirado los privilegios de la entidad asociada al certificado.",{"_7897":918,"_22053":867,"_18699":34449,"_5":22186,"_15048":34319,"_1570":34450},[],"**AACompromise**: La clave de un servidor de autorización de atributos ha sido comprometida.",{"_7897":919,"_22053":867,"_18699":34452,"_5":22186,"_15048":34319,"_1570":34453},[],"**WeakAlgorithmOrKey**: La clave o el algoritmo del certificado se consideran débiles o han sido comprometidos.",{"_7897":920,"_22053":867,"_18699":34455,"_5":22186,"_15048":34319,"_1570":34456},[],"**Confirmar la revocación**: Una vez seleccionado el motivo, se confirma la acción. El estado del certificado cambiará a **Revoked** en la línea de tiempo y en el historial de certificados. El certificado revocado dejará de ser válido.\nEs importante destacar que, una vez revocado un certificado, la identidad del dispositivo puede ser restaurada asignándole un nuevo certificado válido. En caso de que la razón de revocación sea CertificateHold, se permitirá la reactivación.",{"_7897":921,"_22053":867,"_18699":34458,"_5":22186,"_15048":34323,"_1570":34459},[],"El *Decommissioning* es el proceso irreversible de dar de baja un dispositivo de forma definitiva del sistema. A diferencia de la revocación, que sólo invalida el certificado, la desactivación revoca todos los certificados asociados al dispositivo y le impide obtener nuevas identidades en el futuro. Es una acción de seguridad crítica que se utiliza cuando un dispositivo es retirado permanentemente o ya no es de confianza.",{"_7897":922,"_22053":867,"_18699":34461,"_5":22186,"_15048":34323,"_1570":34462},[],"El proceso se realiza de la siguiente manera:",{"_7897":923,"_22053":867,"_18699":34464,"_5":22186,"_15048":34323,"_1570":34465},[],"**Acceder a la acción**: Desde la vista de detalles de un dispositivo activo, se hace clic en el botón **Decommission**.",{"_7897":924,"_22053":867,"_18699":34467,"_5":22186,"_15048":34323,"_1570":34468},[],"**Confirmar la acción irreversible**: Aparecerá una ventana de advertencia que explica que la acción es irreversible y que se revocarán todos los certificados asociados al dispositivo, impidiendo que vuelva a obtener una identidad.",{"_7897":925,"_22053":867,"_18699":34470,"_5":22186,"_15048":34323,"_1570":34471},[],"**Confirmar y desactivar**: Al confirmar la desactivación, el sistema revoca el certificado activo del dispositivo con la razón CessationOfOperation y cambia su estado a **Decommissioned**. El dispositivo ya no podrá realizar operaciones con la PKI.",{"_7897":926,"_22053":926,"_5":22181,"_1570":34473,"_22194":34474,"_18699":34475,"_15048":926},"EST: Enrollment over Secure Transport",[31686,32785,32794],[],{"_7897":927,"_22053":926,"_18699":34477,"_5":22186,"_15048":926,"_1570":34478},[],"Guía del protocolo EST en Lamassu IoT, con la configuración del DMS para el administrador PKI y la referencia de endpoints para el integrador de dispositivos.",{"_7897":928,"_22053":926,"_5":22191,"_18699":34480,"_15048":34481,"_1570":34473},[],"/docs/manual/servicios-core/est#est-enrollment-over-secure-transport",{"_7897":929,"_22053":926,"_5":22191,"_18699":34483,"_15048":34484,"_1570":32868},[],"/docs/manual/servicios-core/est#configuración-del-dms",{"_7897":930,"_22053":926,"_5":22191,"_18699":34486,"_15048":34487,"_1570":32391},[],"/docs/manual/servicios-core/est#requisitos-previos",{"_7897":931,"_22053":926,"_5":22191,"_18699":34489,"_15048":34490,"_1570":34491},[],"/docs/manual/servicios-core/est#configuración-de-enrollment","Configuración de enrollment",{"_7897":932,"_22053":926,"_5":22191,"_18699":34493,"_15048":34494,"_1570":34495},[],"/docs/manual/servicios-core/est#enrollment-device-registration","Enrollment Device Registration",{"_7897":933,"_22053":926,"_5":22191,"_18699":34497,"_15048":34498,"_1570":34499},[],"/docs/manual/servicios-core/est#enrollment-settings","Enrollment Settings",{"_7897":934,"_22053":926,"_5":22191,"_18699":34501,"_15048":34502,"_1570":34503},[],"/docs/manual/servicios-core/est#perfil-de-emisión","Perfil de emisión",{"_7897":935,"_22053":926,"_5":22191,"_18699":34505,"_15048":34506,"_1570":34507},[],"/docs/manual/servicios-core/est#configuración-de-re-enrollment","Configuración de re-enrollment",{"_7897":936,"_22053":926,"_5":22191,"_18699":34509,"_15048":34510,"_1570":34511},[],"/docs/manual/servicios-core/est#configuración-de-serverkeygen","Configuración de ServerKeyGen",{"_7897":937,"_22053":926,"_5":22191,"_18699":34513,"_15048":34514,"_1570":34515},[],"/docs/manual/servicios-core/est#verificar-la-configuración","Verificar la configuración",{"_7897":938,"_22053":926,"_5":22191,"_18699":34517,"_15048":34518,"_1570":34519},[],"/docs/manual/servicios-core/est#integración-de-dispositivos","Integración de dispositivos",{"_7897":939,"_22053":926,"_5":22191,"_18699":34521,"_15048":34522,"_1570":34523},[],"/docs/manual/servicios-core/est#antes-de-empezar","Antes de empezar",{"_7897":940,"_22053":926,"_5":22191,"_18699":34525,"_15048":34526,"_1570":34527},[],"/docs/manual/servicios-core/est#resumen-del-flujo","Resumen del flujo",{"_7897":941,"_22053":926,"_5":22191,"_18699":34529,"_15048":34530,"_1570":34531},[],"/docs/manual/servicios-core/est#modelo-de-autenticación-del-cliente","Modelo de autenticación del cliente",{"_7897":942,"_22053":926,"_5":22191,"_18699":34533,"_15048":34534,"_1570":34535},[],"/docs/manual/servicios-core/est#referencia-de-endpoints","Referencia de endpoints",{"_7897":943,"_22053":926,"_5":22191,"_18699":34537,"_15048":34538,"_1570":34539},[],"/docs/manual/servicios-core/est#cacerts","`/cacerts`",{"_7897":944,"_22053":926,"_5":22191,"_18699":34541,"_15048":34542,"_1570":34543},[],"/docs/manual/servicios-core/est#simpleenroll","`/simpleenroll`",{"_7897":945,"_22053":926,"_5":22191,"_18699":34545,"_15048":34546,"_1570":34547},[],"/docs/manual/servicios-core/est#simplereenroll","`/simplereenroll`",{"_7897":946,"_22053":926,"_5":22191,"_18699":34549,"_15048":34550,"_1570":34551},[],"/docs/manual/servicios-core/est#serverkeygen","`/serverkeygen`",{"_7897":947,"_22053":926,"_5":22191,"_18699":34553,"_15048":34554,"_1570":34555},[],"/docs/manual/servicios-core/est#flujos-completos","Flujos completos",{"_7897":948,"_22053":926,"_5":22191,"_18699":34557,"_15048":34558,"_1570":34559},[],"/docs/manual/servicios-core/est#ejemplo-end-to-end-enroll","Ejemplo end-to-end: enroll",{"_7897":949,"_22053":926,"_5":22191,"_18699":34561,"_15048":34562,"_1570":34563},[],"/docs/manual/servicios-core/est#ejemplo-end-to-end-reenroll","Ejemplo end-to-end: reenroll",{"_7897":950,"_22053":926,"_5":22191,"_18699":34565,"_15048":34566,"_1570":34567},[],"/docs/manual/servicios-core/est#próximos-pasos-tras-el-enrolamiento","Próximos pasos tras el enrolamiento",{"_7897":951,"_22053":926,"_5":22191,"_18699":34569,"_15048":34570,"_1570":34571},[],"/docs/manual/servicios-core/est#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_7897":952,"_22053":926,"_5":22191,"_18699":34573,"_15048":34574,"_1570":34575},[],"/docs/manual/servicios-core/est#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_7897":953,"_22053":926,"_5":22191,"_18699":34577,"_15048":34578,"_1570":34579},[],"/docs/manual/servicios-core/est#notas-de-compatibilidad","Notas de compatibilidad",{"_7897":954,"_22053":926,"_18699":34581,"_5":22186,"_15048":34481,"_1570":34582},[],"Lamassu IoT implementa el protocolo &#x2A;*EST (Enrollment over Secure Transport)** descrito en el RFC 7030 como su único mecanismo de inscripción de certificados para dispositivos. Cada DMS expone los endpoints EST, valida al dispositivo y aplica sus propias políticas de autenticación, registro y renovación — actuando como autoridad de registro (RA) frente al cliente.",{"_7897":955,"_22053":926,"_18699":34584,"_5":22186,"_15048":34481,"_1570":34585},[],"La entidad que emite y firma criptográficamente el certificado es siempre la **CA asociada al DMS**, no el DMS. El DMS coordina el proceso: recibe el CSR, autentica al dispositivo y aplica la política de emisión. Esta distinción es relevante para el administrador PKI al seleccionar la `EnrollmentCA` y para el integrador al interpretar la cadena de confianza recibida de `/cacerts`.",{"_7897":956,"_22053":926,"_18699":34587,"_5":22186,"_15048":34481,"_1570":34588},[],"Esta guía está dividida en dos partes:",{"_7897":957,"_22053":926,"_18699":34590,"_5":22186,"_15048":34481,"_1570":34591},[],"Configuración del DMS, para el administrador PKI.",{"_7897":958,"_22053":926,"_18699":34593,"_5":22186,"_15048":34481,"_1570":34594},[],"Integración de dispositivos, para quien consume los endpoints EST desde firmware, scripts o servicios de aprovisionamiento.",{"_7897":959,"_22053":926,"_18699":34596,"_5":22186,"_15048":34481,"_1570":34597},[],"Si solo necesita una orientación rápida, este es el recorrido recomendado:",{"_7897":960,"_22053":926,"_18699":34599,"_5":22186,"_15048":34481,"_1570":34600},[],"Perfil",{"_7897":961,"_22053":926,"_18699":34602,"_5":22186,"_15048":34481,"_1570":34603},[],"Leer primero",{"_7897":962,"_22053":926,"_18699":34605,"_5":22186,"_15048":34481,"_1570":34606},[],"Después",{"_7897":963,"_22053":926,"_18699":34608,"_5":22186,"_15048":34481,"_1570":34609},[],"Administrador PKI",{"_7897":964,"_22053":926,"_18699":34611,"_5":22186,"_15048":34481,"_1570":32868},[],{"_7897":965,"_22053":926,"_18699":34613,"_5":22186,"_15048":34481,"_1570":34571},[],{"_7897":966,"_22053":926,"_18699":34615,"_5":22186,"_15048":34481,"_1570":34616},[],"Integrador de dispositivos",{"_7897":967,"_22053":926,"_18699":34618,"_5":22186,"_15048":34481,"_1570":34523},[],{"_7897":968,"_22053":926,"_18699":34620,"_5":22186,"_15048":34481,"_1570":34621},[],"Los endpoints `/cacerts`, `/simpleenroll`, `/simplereenroll` o `/serverkeygen`, según el flujo",{"_7897":969,"_22053":926,"_18699":34623,"_5":22186,"_15048":34487,"_1570":34624},[],"Antes de configurar un DMS para EST, deben existir los siguientes recursos en la plataforma:",{"_7897":970,"_22053":926,"_18699":34626,"_5":22186,"_15048":34487,"_1570":34627},[],"**Una CA disponible**: la CA que actuará como `EnrollmentCA` debe estar creada y en estado activo en Lamassu. Si el modo de autenticación es `CLIENT_CERTIFICATE`, también deben estar creadas las CAs de validación del certificado bootstrap.",{"_7897":971,"_22053":926,"_18699":34629,"_5":22186,"_15048":34487,"_1570":34630},[],"**Un DMS creado**: el DMS al que se aplicará esta configuración debe existir previamente. La configuración EST se aplica sobre un DMS existente, no lo crea.",{"_7897":972,"_22053":926,"_18699":34632,"_5":22186,"_15048":34487,"_1570":34633},[],"Conviene separar cuatro bloques de configuración:",{"_7897":973,"_22053":926,"_18699":34635,"_5":22186,"_15048":34487,"_1570":34636},[],"Cómo se realizará el enrollment inicial, incluyendo el modo de alta y la autenticación del cliente.",{"_7897":974,"_22053":926,"_18699":34638,"_5":22186,"_15048":34487,"_1570":34639},[],"Cómo se gestionará el re-enrollment de certificados ya emitidos.",{"_7897":975,"_22053":926,"_18699":34641,"_5":22186,"_15048":34487,"_1570":34642},[],"Cómo se configurará el endpoint cacerts para la distribución de las CAs de confianza utilizadas por los dispositivos.",{"_7897":976,"_22053":926,"_18699":34644,"_5":22186,"_15048":34487,"_1570":34645},[],"Si se habilitará la generación de claves en servidor mediante `ServerKeyGen`.",{"_7897":977,"_22053":926,"_18699":34647,"_5":22186,"_15048":34494,"_1570":34648},[],"En esta sección se define cómo se registran los dispositivos nuevos y con qué credenciales se autentican.",{"_7897":978,"_22053":926,"_18699":34650,"_5":22186,"_15048":34494,"_1570":34651},[],"**Registration Mode**: determina el comportamiento al recibir una inscripción inicial. En modo `JITP` (*Just-In-Time Provisioning*), el dispositivo se crea automáticamente la primera vez que se presenta, aplicando los tags, metadatos e icono definidos en el perfil de aprovisionamiento. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente en la plataforma; si no existe, la solicitud se rechaza con `device not preregistered`. El modo JITP es adecuado para flotas grandes donde el inventario se construye durante el despliegue; el modo `PRE_REGISTRATION` encaja en entornos de alta seguridad donde cada dispositivo se aprueba de forma explícita antes de recibir un certificado.",{"_7897":979,"_22053":926,"_18699":34653,"_5":22186,"_15048":34494,"_1570":34654},[],"**Tags**: se aplican a cada dispositivo creado automáticamente por este DMS. Son opcionales y solo tienen efecto en modo JITP. Los tags permiten mejorar la búsqueda de dispositivos.",{"_7897":980,"_22053":926,"_18699":34656,"_5":22186,"_15048":34494,"_1570":34657},[],"**Icon**: se aplica a cada dispositivo creado automáticamente por este DMS. Es opcional y solo tiene efecto en modo JITP. Únicamente visual.",{"_7897":981,"_22053":926,"_18699":34659,"_5":22186,"_15048":34498,"_1570":34660},[],"**Enrollment CA**: identifica la CA que firmará los certificados de identidad emitidos a través de este DMS. Su elección determina la cadena de confianza que el dispositivo recibirá y la raíz contra la que los sistemas de backend validarán los certificados de flota.",{"_7897":982,"_22053":926,"_18699":34662,"_5":22186,"_15048":34498,"_1570":34663},[],"**Allow Override Enrollment** (`enable_replaceable_enrollment`): permite que un dispositivo ya enrolado vuelva a inscribirse mediante `/simpleenroll`. Cuando está activa, el certificado anterior se revoca con la razón `superseded` y el slot de identidad se actualiza. Cuando está inactiva, un segundo intento de `simpleenroll` se rechaza con `forbiddenNewEnrollment`. Esta opción debe habilitarse con precaución en entornos de producción, ya que permite sustituir la identidad de un dispositivo sin pasar por el flujo de re-enrollment.",{"_7897":983,"_22053":926,"_18699":34665,"_5":22186,"_15048":34498,"_1570":34666},[],"**Verify CSR Signature** (`verify_csr_signature`): controla si el servidor valida la firma del CSR contra la clave pública declarada en él (prueba de posesión PKCS#10). Cuando está inactiva, un solicitante podría enviar un CSR con una clave pública que no controla y obtener un certificado vinculado a ella. Para flotas IoT en redes abiertas debe estar activa.",{"_7897":984,"_22053":926,"_18699":34668,"_5":22186,"_15048":34498,"_1570":34669},[],"**Authentication Mode**: define cómo el DMS valida la identidad del dispositivo durante el enrollment. Los cuatro modos disponibles son:",{"_7897":985,"_22053":926,"_18699":34671,"_5":22186,"_15048":34498,"_1570":34672},[],"Modo",{"_7897":986,"_22053":926,"_18699":34674,"_5":22186,"_15048":34498,"_1570":31889},[],{"_7897":987,"_22053":926,"_18699":34676,"_5":22186,"_15048":34498,"_1570":34677},[],"`CLIENT_CERTIFICATE`",{"_7897":988,"_22053":926,"_18699":34679,"_5":22186,"_15048":34498,"_1570":34680},[],"mTLS. El dispositivo presenta un certificado X.509 emitido por alguna de las CAs declaradas en **Validation CAs**.",{"_7897":989,"_22053":926,"_18699":34682,"_5":22186,"_15048":34498,"_1570":34683},[],"`EXTERNAL_WEBHOOK`",{"_7897":990,"_22053":926,"_18699":34685,"_5":22186,"_15048":34498,"_1570":34686},[],"La decisión de autorización se delega en un servicio HTTP externo. Solo aplica en `/simpleenroll`; en `/simplereenroll` este modo degrada silenciosamente a `NO_AUTH`.",{"_7897":991,"_22053":926,"_18699":34688,"_5":22186,"_15048":34498,"_1570":34689},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_7897":992,"_22053":926,"_18699":34691,"_5":22186,"_15048":34498,"_1570":34692},[],"Combina los dos anteriores: se exige un certificado cliente válido **y** la confirmación del webhook externo.",{"_7897":993,"_22053":926,"_18699":34694,"_5":22186,"_15048":34498,"_1570":34695},[],"`NO_AUTH`",{"_7897":994,"_22053":926,"_18699":34697,"_5":22186,"_15048":34498,"_1570":34698},[],"Sin autenticación. Cualquier CSR se acepta. **Exclusivo para entornos de laboratorio o redes de aprovisionamiento aisladas**; no debe usarse en producción.",{"_7897":995,"_22053":926,"_18699":34700,"_5":22186,"_15048":34498,"_1570":34701},[],"Cuando el modo es `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`, se configuran además estos parámetros:",{"_7897":996,"_22053":926,"_18699":34703,"_5":22186,"_15048":34498,"_1570":34704},[],"**Validation CAs**: lista de CAs de confianza para validar el certificado bootstrap presentado por el dispositivo.",{"_7897":997,"_22053":926,"_18699":34706,"_5":22186,"_15048":34498,"_1570":34707},[],"**Chain Validation Level**: profundidad máxima de la cadena de validación. El valor `-1` valida la cadena completa hasta la CA raíz.",{"_7897":998,"_22053":926,"_18699":34709,"_5":22186,"_15048":34498,"_1570":34710},[],"**Allow Authenticating Expired Certificates**: si está activo, acepta certificados cliente caducados. Es útil en escenarios de recuperación donde el dispositivo no pudo renovar su certificado a tiempo.",{"_7897":999,"_22053":926,"_18699":34712,"_5":22186,"_15048":34498,"_1570":34713},[],"Cuando el modo incluye `EXTERNAL_WEBHOOK`, se configuran además estos parámetros:",{"_7897":1000,"_22053":926,"_18699":34715,"_5":22186,"_15048":34498,"_1570":34716},[],"**Webhook URL**: dirección del servicio externo que decidirá la autorización.",{"_7897":1001,"_22053":926,"_18699":34718,"_5":22186,"_15048":34498,"_1570":34719},[],"**HTTP Method**: método HTTP utilizado para invocar el webhook.",{"_7897":1002,"_22053":926,"_18699":34721,"_5":22186,"_15048":34498,"_1570":34722},[],"**Timeout**: tiempo máximo de espera de la llamada al webhook.",{"_7897":1003,"_22053":926,"_18699":34724,"_5":22186,"_15048":34498,"_1570":34725},[],"**Webhook Authentication Mode**: modo de autenticación del webhook hacia el servicio externo, por ejemplo `ApiKey`, `OIDC` o `mTLS`.",{"_7897":1004,"_22053":926,"_18699":34727,"_5":22186,"_15048":34502,"_1570":34728},[],"El comportamiento del certificado emitido no lo determina únicamente el CSR del dispositivo, sino el **perfil de emisión** (`IssuanceProfile`) asociado al DMS. El integrador no configura este perfil, pero sus reglas afectan al contenido del certificado final:",{"_7897":1005,"_22053":926,"_18699":34730,"_5":22186,"_15048":34502,"_1570":34731},[],"Campo",{"_7897":1006,"_22053":926,"_18699":34733,"_5":22186,"_15048":34502,"_1570":33020},[],{"_7897":1007,"_22053":926,"_18699":34735,"_5":22186,"_15048":34502,"_1570":34736},[],"Efecto sobre el certificado emitido",{"_7897":1008,"_22053":926,"_18699":34738,"_5":22186,"_15048":34502,"_1570":34739},[],"`HonorSubject`",{"_7897":1009,"_22053":926,"_18699":34741,"_5":22186,"_15048":34502,"_1570":20403},[],{"_7897":1010,"_22053":926,"_18699":34743,"_5":22186,"_15048":34502,"_1570":34744},[],"Si `true`, el subject del CSR se traslada literalmente al certificado. Si `false`, la CA aplica la plantilla del perfil e ignora el subject del CSR.",{"_7897":1011,"_22053":926,"_18699":34746,"_5":22186,"_15048":34502,"_1570":34747},[],"`HonorKeyUsage`",{"_7897":1012,"_22053":926,"_18699":34749,"_5":22186,"_15048":34502,"_1570":20403},[],{"_7897":1013,"_22053":926,"_18699":34751,"_5":22186,"_15048":34502,"_1570":34752},[],"Si `true`, el `KeyUsage` del CSR se respeta. Si `false`, se aplica la plantilla del perfil.",{"_7897":1014,"_22053":926,"_18699":34754,"_5":22186,"_15048":34502,"_1570":34755},[],"`HonorExtendedKeyUsages`",{"_7897":1015,"_22053":926,"_18699":34757,"_5":22186,"_15048":34502,"_1570":20403},[],{"_7897":1016,"_22053":926,"_18699":34759,"_5":22186,"_15048":34502,"_1570":34760},[],"Igual que `HonorKeyUsage`, pero para `ExtKeyUsage`.",{"_7897":1017,"_22053":926,"_18699":34762,"_5":22186,"_15048":34502,"_1570":34763},[],"`HonorExtensions`",{"_7897":1018,"_22053":926,"_18699":34765,"_5":22186,"_15048":34502,"_1570":20403},[],{"_7897":1019,"_22053":926,"_18699":34767,"_5":22186,"_15048":34502,"_1570":34768},[],"Controla si el resto de extensiones del CSR (SAN, CDP, etc.) se incluyen en el certificado.",{"_7897":1020,"_22053":926,"_18699":34770,"_5":22186,"_15048":34502,"_1570":34771},[],"Esto es relevante para el integrador: el `KeyUsage`, `ExtKeyUsage` y los SAN que declara el CSR pueden no aparecer tal cual en el certificado final si el perfil así lo decide. Consulte con el administrador PKI si el certificado emitido no contiene las extensiones esperadas.",{"_7897":1021,"_22053":926,"_18699":34773,"_5":22186,"_15048":34506,"_1570":34774},[],"La sección **Re-Enrollment Settings** controla el proceso de renovación de certificados. El re-enrollment puede realizarse únicamente cuando el certificado está dentro de la ventana configurada, y opcionalmente también cuando el certificado ya ha caducado.",{"_7897":1022,"_22053":926,"_18699":34776,"_5":22186,"_15048":34506,"_1570":34777},[],"**Revoke On Re-Enroll**: si está activo, el certificado anterior se revoca automáticamente con la razón `superseded` una vez emitido el nuevo.",{"_7897":1023,"_22053":926,"_18699":34779,"_5":22186,"_15048":34506,"_1570":34780},[],"**Allow Expired Renewal**: permite renovar un certificado ya caducado. Es útil cuando un dispositivo ha estado desconectado y no pudo renovar dentro de la ventana.",{"_7897":1024,"_22053":926,"_18699":34782,"_5":22186,"_15048":34506,"_1570":34783},[],"**Allowed Renewal Delta**: ventana de tiempo previa a la caducidad durante la cual se permite el re-enrollment. Antes de que se abra esta ventana, la solicitud se rechaza con `invalid reenroll window`.",{"_7897":1025,"_22053":926,"_18699":34785,"_5":22186,"_15048":34506,"_1570":34786},[],"**Preventive Renewal Delta**: tiempo previo a la caducidad a partir del cual se emiten alertas de renovación preventiva.",{"_7897":1026,"_22053":926,"_18699":34788,"_5":22186,"_15048":34506,"_1570":34789},[],"**Critical Renewal Delta**: umbral más cercano al vencimiento que activa alertas de estado crítico.",{"_7897":1027,"_22053":926,"_18699":34791,"_5":22186,"_15048":34506,"_1570":34792},[],"**Additional Validation CAs**: CAs adicionales aceptadas como emisoras del certificado en vigor durante el re-enrollment. Permite migrar a una nueva CA de enrolamiento sin interrumpir la renovación de dispositivos ya enrolados con la CA anterior.",{"_7897":1028,"_22053":926,"_18699":34794,"_5":22186,"_15048":34510,"_1570":34795},[],"La sección **Server Key Generation** permite que Lamassu genere el par de claves del dispositivo en el servidor y lo devuelva junto con el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada.",{"_7897":1029,"_22053":926,"_18699":34797,"_5":22186,"_15048":34510,"_1570":34798},[],"La opción **Enable Server-Side Key Generation** activa el endpoint `/serverkeygen`. Cuando está inactiva, cualquier llamada a ese endpoint se rechaza con `server key generation not enabled`.",{"_7897":1030,"_22053":926,"_18699":34800,"_5":22186,"_15048":34510,"_1570":34801},[],"**Key Type** selecciona el algoritmo: `RSA` o `ECDSA`. El campo &#x2A;*Key Size (bits)** determina el tamaño de la clave. Para ECDSA, el tamaño en bits determina también la curva: 256 corresponde a P-256, 384 a P-384 y 521 a P-521.",{"_7897":1031,"_22053":926,"_18699":34803,"_5":22186,"_15048":34510,"_1570":34804},[],"La clave se genera en el motor software del servidor, no en un Crypto Engine de hardware como AWS KMS o PKCS#11. La única protección de la clave en tránsito es el canal TLS; no se aplica cifrado adicional (CMS EnvelopedData) sobre la clave antes de enviarla al dispositivo. Consulte el apartado `/serverkeygen` de la referencia para integrador para conocer el formato exacto de la respuesta y las consideraciones de seguridad.",{"_7897":1032,"_22053":926,"_18699":34806,"_5":22186,"_15048":34514,"_1570":34807},[],"Una vez aplicados los ajustes de enrollment, re-enrollment y ServerKeyGen, puede confirmar que el DMS está operativo de las siguientes formas:",{"_7897":1033,"_22053":926,"_18699":34809,"_5":22186,"_15048":34514,"_1570":34810},[],"**Desde la consola**: accede al detalle del DMS y comprueba que la sección EST muestra la CA de enrolamiento asignada y el modo de autenticación configurado.",{"_7897":1034,"_22053":926,"_18699":34812,"_5":22186,"_15048":34514,"_1570":34813},[],"**Con una solicitud de prueba**: invoca el endpoint `/cacerts` del DMS desde un cliente `curl` con la confianza del servidor. Una respuesta `200 OK` con contenido base64 confirma que el DMS está activo y que la CA de enrolamiento es accesible.",{"_7897":1035,"_22053":926,"_18699":34815,"_5":22186,"_15048":34514,"_1570":34816},[],"Si el DMS no existe o la CA no está disponible, el servidor responde con `DMS not found` u otro mensaje de error. Consulte la sección Diagnóstico y compatibilidad para interpretar los mensajes de error.",{"_7897":1036,"_22053":926,"_18699":34818,"_5":22186,"_15048":34518,"_1570":34819},[],"*Esta sección está dirigida al integrador de dispositivos.*",{"_7897":1037,"_22053":926,"_18699":34821,"_5":22186,"_15048":34518,"_1570":34822},[],"Los endpoints EST de Lamassu se publican bajo el prefijo `/.well-known/est` y exigen siempre la presencia del segmento de ruta `{aps}`, que se interpreta como el identificador del DMS al que se dirige la operación. La asociación es directa: el valor de `{aps}` recibido en la URL se utiliza como ID de DMS al consultar el almacén interno. Las variantes registradas sin `{aps}` (por ejemplo `/.well-known/est/cacerts`) están enrutadas en el código, pero su gestor exige el campo `APS` y devuelve `400 Bad Request` con el mensaje `Field validation for 'APS' failed` cuando el segmento no se proporciona.",{"_7897":1038,"_22053":926,"_18699":34824,"_5":22186,"_15048":34518,"_1570":34825},[],"Esta parte sigue el orden habitual de trabajo del integrador: primero los requisitos previos y el modelo de autenticación, después la referencia de cada endpoint y, al final, ejemplos completos y material de diagnóstico.",{"_7897":1039,"_22053":926,"_18699":34827,"_5":22186,"_15048":34522,"_1570":34828},[],"El administrador PKI debe haber configurado un DMS con el protocolo `EST_RFC7030`, una CA de enrolamiento asignada y al menos un modo de autenticación. Sin esa configuración previa, Lamassu rechaza cualquier solicitud de enrolamiento. Los detalles de esa configuración se encuentran en la sección de configuración del DMS de esta misma página.",{"_7897":1040,"_22053":926,"_18699":34830,"_5":22186,"_15048":34522,"_1570":34831},[],"Antes de realizar la primera llamada, asegúrese de tener:",{"_7897":1041,"_22053":926,"_18699":34833,"_5":22186,"_15048":34522,"_1570":34834},[],"Elemento",{"_7897":1042,"_22053":926,"_18699":34836,"_5":22186,"_15048":34522,"_1570":31889},[],{"_7897":1043,"_22053":926,"_18699":34838,"_5":22186,"_15048":34522,"_1570":34839},[],"**URL del host EST**",{"_7897":1044,"_22053":926,"_18699":34841,"_5":22186,"_15048":34522,"_1570":34842},[],"Dirección base del servidor, por ejemplo `https://est.lamassu.example`. La proporciona el administrador PKI.",{"_7897":1045,"_22053":926,"_18699":34844,"_5":22186,"_15048":34522,"_1570":34845},[],"**Ancla de confianza del servidor** (`lamassu-trust.pem`)",{"_7897":1046,"_22053":926,"_18699":34847,"_5":22186,"_15048":34522,"_1570":34848},[],"Certificado raíz o intermedio con el que validar el TLS del servidor Lamassu. Sin él, el cliente rechazará el certificado del servidor.",{"_7897":1047,"_22053":926,"_18699":34850,"_5":22186,"_15048":34522,"_1570":34851},[],"**Certificado bootstrap + clave privada**",{"_7897":1048,"_22053":926,"_18699":34853,"_5":22186,"_15048":34522,"_1570":34854},[],"Solo para modos `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`. Es el certificado de aprovisionamiento emitido por alguna de las `ValidationCAs` del DMS, normalmente una CA dedicada al provisioning y distinta de la CA de enrolamiento.",{"_7897":1049,"_22053":926,"_18699":34856,"_5":22186,"_15048":34522,"_1570":34857},[],"**ID del DMS** (`{aps}`)",{"_7897":1050,"_22053":926,"_18699":34859,"_5":22186,"_15048":34522,"_1570":34860},[],"Identificador del DMS que aparece en todas las rutas EST. Lo proporciona el administrador PKI.",{"_7897":1051,"_22053":926,"_18699":34862,"_5":22186,"_15048":34526,"_1570":34863},[],"Caso",{"_7897":1052,"_22053":926,"_18699":34865,"_5":22186,"_15048":34526,"_1570":34866},[],"Credencial habitual",{"_7897":1053,"_22053":926,"_18699":34868,"_5":22186,"_15048":34526,"_1570":34869},[],"Endpoint principal",{"_7897":1054,"_22053":926,"_18699":34871,"_5":22186,"_15048":34526,"_1570":34872},[],"Resultado",{"_7897":1055,"_22053":926,"_18699":34874,"_5":22186,"_15048":34526,"_1570":34875},[],"Alta inicial",{"_7897":1056,"_22053":926,"_18699":34877,"_5":22186,"_15048":34526,"_1570":34878},[],"Certificado bootstrap o el modo definido en `AuthMode`",{"_7897":1057,"_22053":926,"_18699":34880,"_5":22186,"_15048":34526,"_1570":34543},[],{"_7897":1058,"_22053":926,"_18699":34882,"_5":22186,"_15048":34526,"_1570":34883},[],"Certificado de dispositivo",{"_7897":1059,"_22053":926,"_18699":34885,"_5":22186,"_15048":34526,"_1570":34886},[],"Renovación",{"_7897":1060,"_22053":926,"_18699":34888,"_5":22186,"_15048":34526,"_1570":34889},[],"Certificado actual del dispositivo",{"_7897":1061,"_22053":926,"_18699":34891,"_5":22186,"_15048":34526,"_1570":34547},[],{"_7897":1062,"_22053":926,"_18699":34893,"_5":22186,"_15048":34526,"_1570":34894},[],"Certificado renovado",{"_7897":1063,"_22053":926,"_18699":34896,"_5":22186,"_15048":34526,"_1570":34897},[],"Descarga de confianza",{"_7897":1064,"_22053":926,"_18699":34899,"_5":22186,"_15048":34526,"_1570":34900},[],"TLS del servidor",{"_7897":1065,"_22053":926,"_18699":34902,"_5":22186,"_15048":34526,"_1570":34539},[],{"_7897":1066,"_22053":926,"_18699":34904,"_5":22186,"_15048":34526,"_1570":34905},[],"PKCS#7 o PEM con certificados",{"_7897":1067,"_22053":926,"_18699":34907,"_5":22186,"_15048":34526,"_1570":34908},[],"Clave generada en servidor",{"_7897":1068,"_22053":926,"_18699":34910,"_5":22186,"_15048":34526,"_1570":34911},[],"Igual que `/simpleenroll`",{"_7897":1069,"_22053":926,"_18699":34913,"_5":22186,"_15048":34526,"_1570":34551},[],{"_7897":1070,"_22053":926,"_18699":34915,"_5":22186,"_15048":34526,"_1570":34916},[],"Clave privada PKCS#8 + certificado",{"_7897":1071,"_22053":926,"_18699":34918,"_5":22186,"_15048":34530,"_1570":34919},[],"La implementación de Lamassu reconoce cuatro configuraciones de autenticación para `/simpleenroll`, expresadas mediante el campo `EnrollmentOptionsESTRFC7030.AuthMode` del DMS. Tres son modos simples (`CLIENT_CERTIFICATE`, `EXTERNAL_WEBHOOK`, `NO_AUTH`) y una combina dos controles (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`). El cliente debe presentarse en el modo que el DMS espera; cualquier otra combinación genera un fallo en la inscripción.",{"_7897":1072,"_22053":926,"_18699":34921,"_5":22186,"_15048":34530,"_1570":34922},[],"Modo (`AuthMode`)",{"_7897":1073,"_22053":926,"_18699":34924,"_5":22186,"_15048":34530,"_1570":31889},[],{"_7897":1074,"_22053":926,"_18699":34926,"_5":22186,"_15048":34530,"_1570":34927},[],"Credencial esperada",{"_7897":1075,"_22053":926,"_18699":34929,"_5":22186,"_15048":34530,"_1570":34930},[],"Aplica en enroll",{"_7897":1076,"_22053":926,"_18699":34932,"_5":22186,"_15048":34530,"_1570":34933},[],"Aplica en reenroll",{"_7897":1077,"_22053":926,"_18699":34935,"_5":22186,"_15048":34530,"_1570":34677},[],{"_7897":1078,"_22053":926,"_18699":34937,"_5":22186,"_15048":34530,"_1570":34938},[],"mTLS con certificado X.509",{"_7897":1079,"_22053":926,"_18699":34940,"_5":22186,"_15048":34530,"_1570":34941},[],"Certificado y clave privada cliente",{"_7897":1080,"_22053":926,"_18699":34943,"_5":22186,"_15048":34530,"_1570":33033},[],{"_7897":1081,"_22053":926,"_18699":34945,"_5":22186,"_15048":34530,"_1570":34946},[],"Sí (con el certificado en vigor)",{"_7897":1082,"_22053":926,"_18699":34948,"_5":22186,"_15048":34530,"_1570":34689},[],{"_7897":1083,"_22053":926,"_18699":34950,"_5":22186,"_15048":34530,"_1570":34951},[],"mTLS más validación por webhook",{"_7897":1084,"_22053":926,"_18699":34953,"_5":22186,"_15048":34530,"_1570":34954},[],"Certificado y clave privada cliente, más aprobación del webhook",{"_7897":1085,"_22053":926,"_18699":34956,"_5":22186,"_15048":34530,"_1570":33033},[],{"_7897":1086,"_22053":926,"_18699":34958,"_5":22186,"_15048":34530,"_1570":34959},[],"No como combinación; en reenroll no mantiene ambos controles",{"_7897":1087,"_22053":926,"_18699":34961,"_5":22186,"_15048":34530,"_1570":34683},[],{"_7897":1088,"_22053":926,"_18699":34963,"_5":22186,"_15048":34530,"_1570":34964},[],"Webhook externo de autorización",{"_7897":1089,"_22053":926,"_18699":34966,"_5":22186,"_15048":34530,"_1570":34967},[],"Ninguna en el canal TLS",{"_7897":1090,"_22053":926,"_18699":34969,"_5":22186,"_15048":34530,"_1570":33033},[],{"_7897":1091,"_22053":926,"_18699":34971,"_5":22186,"_15048":34530,"_1570":34972},[],"No, degrada a `NO_AUTH`",{"_7897":1092,"_22053":926,"_18699":34974,"_5":22186,"_15048":34530,"_1570":34695},[],{"_7897":1093,"_22053":926,"_18699":34976,"_5":22186,"_15048":34530,"_1570":34977},[],"Sin autenticación",{"_7897":1094,"_22053":926,"_18699":34979,"_5":22186,"_15048":34530,"_1570":34980},[],"Ninguna",{"_7897":1095,"_22053":926,"_18699":34982,"_5":22186,"_15048":34530,"_1570":34983},[],"Sí (uso restringido)",{"_7897":1096,"_22053":926,"_18699":34985,"_5":22186,"_15048":34530,"_1570":34983},[],{"_7897":1097,"_22053":926,"_18699":34987,"_5":22186,"_15048":34530,"_1570":34988},[],"JWT **no es un modo de autenticación válido en EST**. El extractor de identidad JWT existe en el código pero solo se evalúa en la API de administración de Lamassu. Cualquier *Bearer token* enviado a `/.well-known/est/...` se ignora silenciosamente. Cuando el DMS está configurado con `AuthMode: CLIENT_CERTIFICATE`, una petición que solo aporte JWT se rechaza por falta de certificado cliente. Cuando el DMS está en `AuthMode: NO_AUTH`, la petición se procesa como tal y el JWT no añade ni resta autorización.",{"_7897":1098,"_22053":926,"_18699":34990,"_5":22186,"_15048":34530,"_1570":34991},[],"**`CLIENT_CERTIFICATE`**: el cliente presenta un certificado X.509 emitido por una de las CAs declaradas en `AuthOptionsMTLS.ValidationCAs`. El proceso valida la cadena del certificado contra esas CAs mediante los parámetros `ValidationCAs`, `AllowExpired` y `ChainLevelValidation`. Además, el servicio comprueba el estado de revocación en tres pasos: primero busca el cert en la base de datos local de Lamassu; si no lo encuentra, consulta los responders OCSP listados en la extensión AIA; si OCSP falla, intenta los CRL Distribution Points (CDP). Un certificado revocado interrumpe la inscripción con `certificate is revoked`.",{"_7897":1099,"_22053":926,"_18699":34993,"_5":22186,"_15048":34530,"_1570":33017},[],{"_7897":1100,"_22053":926,"_18699":34995,"_5":22186,"_15048":34530,"_1570":33020},[],{"_7897":1101,"_22053":926,"_18699":34997,"_5":22186,"_15048":34530,"_1570":31889},[],{"_7897":1102,"_22053":926,"_18699":34999,"_5":22186,"_15048":34530,"_1570":35000},[],"`ValidationCAs`",{"_7897":1103,"_22053":926,"_18699":35002,"_5":22186,"_15048":34530,"_1570":35003},[],"lista de IDs de CA",{"_7897":1104,"_22053":926,"_18699":35005,"_5":22186,"_15048":34530,"_1570":35006},[],"CAs de confianza para validar el certificado bootstrap (en enroll) o el certificado en vigor (en reenroll).",{"_7897":1105,"_22053":926,"_18699":35008,"_5":22186,"_15048":34530,"_1570":35009},[],"`AllowExpired`",{"_7897":1106,"_22053":926,"_18699":35011,"_5":22186,"_15048":34530,"_1570":20403},[],{"_7897":1107,"_22053":926,"_18699":35013,"_5":22186,"_15048":34530,"_1570":35014},[],"Si está activado, acepta certificados cliente caducados. Si es `false`, los certificados expirados se rechazan.",{"_7897":1108,"_22053":926,"_18699":35016,"_5":22186,"_15048":34530,"_1570":35017},[],"`ChainLevelValidation`",{"_7897":1109,"_22053":926,"_18699":35019,"_5":22186,"_15048":34530,"_1570":4285},[],{"_7897":1110,"_22053":926,"_18699":35021,"_5":22186,"_15048":34530,"_1570":35022},[],"Si es mayor que cero, recorta la cadena de validación al número de niveles indicado.",{"_7897":1111,"_22053":926,"_18699":35024,"_5":22186,"_15048":34530,"_1570":35025},[],"**`EXTERNAL_WEBHOOK`**: Lamassu delega la decisión de autorización en un servicio HTTP externo. El servidor EST construye una petición `POST` al webhook configurado con un cuerpo JSON que reproduce el contexto de la inscripción.",{"_7897":1112,"_22053":926,"_18699":35027,"_5":22186,"_15048":34530,"_1570":35028},[],"El valor del campo `csr` es la **codificación base64 del PEM** del CSR (no el DER, y no el PEM en claro). El webhook debe responder con `2xx` y `{\"authorized\": true}` para continuar; cualquier otra respuesta aborta el enrolamiento con `external webhook denied enrollment`.",{"_7897":1113,"_22053":926,"_18699":35030,"_5":22186,"_15048":34530,"_1570":35031},[],"**`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`**: combina los dos modos anteriores durante `/simpleenroll` — el cliente debe presentar un certificado mTLS válido y el webhook debe devolver `authorized: true`. En `/simplereenroll` la combinación no se conserva: el chequeo conjunto mTLS + webhook no se mantiene, por lo que el integrador no debe asumir que las mismas garantías del enrollment inicial aplican en reenroll.",{"_7897":1114,"_22053":926,"_18699":35033,"_5":22186,"_15048":34530,"_1570":35034},[],"**`NO_AUTH`**: el DMS acepta cualquier CSR sin validar identidad del cliente. Lamassu emite un aviso en su log (`DMS is configured with NoAuth, allowing enrollment`) y procede al alta. Debe restringirse a entornos controlados (una red de aprovisionamiento aislada); cualquier red expuesta a internet con un DMS en `NO_AUTH` queda abierta a la emisión de certificados por terceros no autorizados.",{"_7897":1115,"_22053":926,"_18699":35036,"_5":22186,"_15048":34534,"_1570":35037},[],"Las siguientes secciones describen los endpoints en el orden más habitual de uso dentro del ciclo de vida del dispositivo:",{"_7897":1116,"_22053":926,"_18699":35039,"_5":22186,"_15048":34534,"_1570":35040},[],"`/cacerts`: descarga de la cadena de confianza.",{"_7897":1117,"_22053":926,"_18699":35042,"_5":22186,"_15048":34534,"_1570":35043},[],"`/simpleenroll`: inscripción inicial del certificado.",{"_7897":1118,"_22053":926,"_18699":35045,"_5":22186,"_15048":34534,"_1570":35046},[],"`/simplereenroll`: renovación de un certificado ya emitido.",{"_7897":1119,"_22053":926,"_18699":35048,"_5":22186,"_15048":34534,"_1570":35049},[],"`/serverkeygen`: inscripción con generación de clave en servidor.",{"_7897":1120,"_22053":926,"_18699":35051,"_5":22186,"_15048":34538,"_1570":35052},[],"El endpoint `GET /.well-known/est/{aps}/cacerts` distribuye los certificados que el dispositivo necesita para validar al servidor EST y al resto de las CAs gestionadas por el DMS. Lamassu inserta los certificados en este orden: primero el certificado **downstream** del servidor Lamassu, que es la hoja TLS del servidor y no una CA, útil para pinning si `IncludeLamassuSystemCA` está activado; después la lista `ManagedCAs` declarada en el DMS; y por último la CA de enrolamiento, si `IncludeEnrollmentCA` está activado.",{"_7897":1121,"_22053":926,"_18699":35054,"_5":22186,"_15048":34538,"_1570":35055},[],"Campo de `CADistributionSettings`",{"_7897":1122,"_22053":926,"_18699":35057,"_5":22186,"_15048":34538,"_1570":33020},[],{"_7897":1123,"_22053":926,"_18699":35059,"_5":22186,"_15048":34538,"_1570":31889},[],{"_7897":1124,"_22053":926,"_18699":35061,"_5":22186,"_15048":34538,"_1570":35062},[],"`IncludeLamassuSystemCA`",{"_7897":1125,"_22053":926,"_18699":35064,"_5":22186,"_15048":34538,"_1570":20403},[],{"_7897":1126,"_22053":926,"_18699":35066,"_5":22186,"_15048":34538,"_1570":35067},[],"Incluye el certificado *downstream* del servidor Lamassu, es decir, la hoja TLS que el cliente puede usar para anclar la conexión. Es un cert de extremo, no una CA.",{"_7897":1127,"_22053":926,"_18699":35069,"_5":22186,"_15048":34538,"_1570":35070},[],"`IncludeEnrollmentCA`",{"_7897":1128,"_22053":926,"_18699":35072,"_5":22186,"_15048":34538,"_1570":20403},[],{"_7897":1129,"_22053":926,"_18699":35074,"_5":22186,"_15048":34538,"_1570":35075},[],"Incluye la CA emisora del DMS, es decir, la que firmará los certificados de dispositivo.",{"_7897":1130,"_22053":926,"_18699":35077,"_5":22186,"_15048":34538,"_1570":35078},[],"`ManagedCAs`",{"_7897":1131,"_22053":926,"_18699":35080,"_5":22186,"_15048":34538,"_1570":35003},[],{"_7897":1132,"_22053":926,"_18699":35082,"_5":22186,"_15048":34538,"_1570":35083},[],"CAs adicionales que se publican como anclas de confianza al dispositivo.",{"_7897":1133,"_22053":926,"_18699":35085,"_5":22186,"_15048":34538,"_1570":35086},[],"El formato por defecto es PKCS#7 *degenerate* (sólo certificados) codificado en base64. La respuesta declara `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El base64 viene troceado en líneas de **76 caracteres** terminadas en CRLF, una anchura conforme con S/MIME (RFC 5751), no los 64 que sugieren ciertas guías de RFC 7030. Este troceo aplica únicamente a `/cacerts` y `/simpleenroll`; las partes internas de `/serverkeygen` no llevan wrap, como se explica más abajo.",{"_7897":1134,"_22053":926,"_18699":35088,"_5":22186,"_15048":34538,"_1570":35089},[],"El PKCS#7 *degenerate* es un **conjunto** de certificados sin orden semántico definido. Aunque Lamassu los inserta en el orden indicado, el integrador no debe asumir ese orden al validar cadenas: la cadena debe construirse por correspondencia `Subject`/`Issuer` (o por AKI/SKI), no por la posición en la respuesta.",{"_7897":1135,"_22053":926,"_18699":35091,"_5":22186,"_15048":34538,"_1570":35092},[],"El flag `-i` (ignore garbage) ayuda a tolerar el CRLF que Lamassu añade y es necesario en algunos `base64` (BusyBox, BSD); en GNU coreutils se ignora.",{"_7897":1136,"_22053":926,"_18699":35094,"_5":22186,"_15048":34538,"_1570":35095},[],"Lamassu añade además una extensión sobre el RFC: si el cliente envía la cabecera `Accept: application/x-pem-file`, el servidor responde con la concatenación PEM de los mismos certificados, sin el envoltorio PKCS#7. Esto facilita el consumo desde scripts. La extensión también funciona en `/simpleenroll` y `/simplereenroll`.",{"_7897":1137,"_22053":926,"_18699":35097,"_5":22186,"_15048":34542,"_1570":35098},[],"El endpoint `POST /.well-known/est/{aps}/simpleenroll` recibe un CSR y devuelve el certificado emitido. El cuerpo de la petición debe ser el **PKCS#10 (CSR) en DER, codificado en base64** sin saltos de línea. La base64 envuelve directamente al DER, no al PEM. La cabecera `Content-Type` debe valer `application/pkcs10`. Si el `Content-Type` es diferente, el servidor responde `400` con `content-type must be application/pkcs10`; si el cuerpo no es base64 válido, responde `400` con `body payload must be base64 encoded`.",{"_7897":1138,"_22053":926,"_18699":35100,"_5":22186,"_15048":34542,"_1570":35101},[],"La respuesta sigue el mismo envoltorio que `/cacerts`: PKCS#7 *degenerate* en base64, con `Content-Type: application/pkcs7-mime; smime-type=certs-only`. El PKCS#7 contiene **únicamente el certificado de hoja** recién emitido; no incluye la CA emisora ni intermediarios. Esto cumple RFC 7030 §4.2.3 (donde la cadena es opcional) pero implica que el integrador debe combinar este certificado con la cadena obtenida de `/cacerts` antes de presentarlo a cualquier relying party que valide cadena completa (por ejemplo, un broker MQTT con mTLS estricta).",{"_7897":1139,"_22053":926,"_18699":35103,"_5":22186,"_15048":34542,"_1570":35104},[],"Varios campos del DMS gobiernan el comportamiento de `/simpleenroll`. El integrador no los configura, pero conviene conocerlos para interpretar los rechazos.",{"_7897":1140,"_22053":926,"_18699":35106,"_5":22186,"_15048":34542,"_1570":34731},[],{"_7897":1141,"_22053":926,"_18699":35108,"_5":22186,"_15048":34542,"_1570":33020},[],{"_7897":1142,"_22053":926,"_18699":35110,"_5":22186,"_15048":34542,"_1570":35111},[],"Efecto",{"_7897":1143,"_22053":926,"_18699":35113,"_5":22186,"_15048":34542,"_1570":35114},[],"`EnrollmentSettings.RegistrationMode`",{"_7897":1144,"_22053":926,"_18699":35116,"_5":22186,"_15048":34542,"_1570":35117},[],"`JITP` / `PRE_REGISTRATION`",{"_7897":1145,"_22053":926,"_18699":35119,"_5":22186,"_15048":34542,"_1570":35120},[],"Decide si el dispositivo se crea automáticamente en la primera inscripción (`JITP`) o si debe existir previamente (`PRE_REGISTRATION`).",{"_7897":1146,"_22053":926,"_18699":35122,"_5":22186,"_15048":34542,"_1570":35123},[],"`EnrollmentSettings.EnableReplaceableEnrollment`",{"_7897":1147,"_22053":926,"_18699":35125,"_5":22186,"_15048":34542,"_1570":20403},[],{"_7897":1148,"_22053":926,"_18699":35127,"_5":22186,"_15048":34542,"_1570":35128},[],"Si es `true`, un dispositivo ya enrolado puede volver a inscribirse mediante `/simpleenroll`; el certificado anterior se revoca con razón `superseded`. Si es `false`, el segundo intento se rechaza con `forbiddenNewEnrollment`.",{"_7897":1149,"_22053":926,"_18699":35130,"_5":22186,"_15048":34542,"_1570":35131},[],"`EnrollmentSettings.VerifyCSRSignature`",{"_7897":1150,"_22053":926,"_18699":35133,"_5":22186,"_15048":34542,"_1570":20403},[],{"_7897":1151,"_22053":926,"_18699":35135,"_5":22186,"_15048":34542,"_1570":35136},[],"Si es `true`, el servidor valida la firma del CSR contra la clave pública declarada en él (proof-of-possession estándar de PKCS#10/RFC 2986). Si es `false`, se omite la prueba de posesión. Para flotas IoT en redes abiertas debe estar en `true`.",{"_7897":1152,"_22053":926,"_18699":35138,"_5":22186,"_15048":34542,"_1570":35139},[],"En modo `JITP`, el primer `simpleenroll` con un `CommonName` que aún no existe en Lamassu crea el dispositivo automáticamente. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente; un `CommonName` desconocido se rechaza con `device not preregistered`. Consulte Configuración de enrollment para más detalles sobre ambos modos y el comportamiento del perfil de emisión.",{"_7897":1153,"_22053":926,"_18699":35141,"_5":22186,"_15048":34546,"_1570":35142},[],"El endpoint `POST /.well-known/est/{aps}/simplereenroll` renueva el certificado de un dispositivo ya enrolado. El formato del cuerpo es idéntico al de `/simpleenroll` (DER base64 sin saltos, `Content-Type: application/pkcs10`). La diferencia está en la autenticación: el cliente debe presentar **el certificado en vigor** del dispositivo (no el bootstrap) como credencial mTLS.",{"_7897":1154,"_22053":926,"_18699":35144,"_5":22186,"_15048":34546,"_1570":35145},[],"Si el DMS está configurado con `AuthMode: EXTERNAL_WEBHOOK`, el webhook **no se invoca** durante `/simplereenroll`. El flujo de renovación degrada silenciosamente a `NO_AUTH`: cualquier cliente que conozca un `CommonName` válido puede solicitar reenroll para ese dispositivo sin autenticación (`allowing reenroll: using NO AUTH mode` en el log). Un DMS con `EXTERNAL_WEBHOOK` no debe usarse en producción para flujos de reenroll a menos que se controle la red de acceso al endpoint.",{"_7897":1155,"_22053":926,"_18699":35147,"_5":22186,"_15048":34546,"_1570":35148},[],"El comportamiento del reenroll está condicionado por varios campos de `ReEnrollmentSettings`:",{"_7897":1156,"_22053":926,"_18699":35150,"_5":22186,"_15048":34546,"_1570":34731},[],{"_7897":1157,"_22053":926,"_18699":35152,"_5":22186,"_15048":34546,"_1570":33020},[],{"_7897":1158,"_22053":926,"_18699":35154,"_5":22186,"_15048":34546,"_1570":35111},[],{"_7897":1159,"_22053":926,"_18699":35156,"_5":22186,"_15048":34546,"_1570":35157},[],"`ReEnrollmentDelta`",{"_7897":1160,"_22053":926,"_18699":35159,"_5":22186,"_15048":34546,"_1570":35160},[],"duración",{"_7897":1161,"_22053":926,"_18699":35162,"_5":22186,"_15048":34546,"_1570":35163},[],"Define la ventana de renovación: el cliente solo puede renovar a partir de `NotAfter - ReEnrollmentDelta`. Antes de ese instante, el servidor responde con `invalid reenroll window`.",{"_7897":1162,"_22053":926,"_18699":35165,"_5":22186,"_15048":34546,"_1570":35166},[],"`EnableExpiredRenewal`",{"_7897":1163,"_22053":926,"_18699":35168,"_5":22186,"_15048":34546,"_1570":20403},[],{"_7897":1164,"_22053":926,"_18699":35170,"_5":22186,"_15048":34546,"_1570":35171},[],"Si es `true`, acepta certificados ya caducados como prueba de identidad. Si es `false`, un certificado expirado provoca `expired certificate`.",{"_7897":1165,"_22053":926,"_18699":35173,"_5":22186,"_15048":34546,"_1570":35174},[],"`RevokeOnReEnrollment`",{"_7897":1166,"_22053":926,"_18699":35176,"_5":22186,"_15048":34546,"_1570":20403},[],{"_7897":1167,"_22053":926,"_18699":35178,"_5":22186,"_15048":34546,"_1570":35179},[],"Si es `true`, revoca automáticamente el certificado anterior tras emitir el nuevo, con la razón `superseded` (código 4 de RFC 5280).",{"_7897":1168,"_22053":926,"_18699":35181,"_5":22186,"_15048":34546,"_1570":35182},[],"`AdditionalValidationCAs`",{"_7897":1169,"_22053":926,"_18699":35184,"_5":22186,"_15048":34546,"_1570":35003},[],{"_7897":1170,"_22053":926,"_18699":35186,"_5":22186,"_15048":34546,"_1570":35187},[],"CAs adicionales que el servidor admite como emisores válidos del certificado en vigor, además de la CA de enrolamiento del DMS.",{"_7897":1171,"_22053":926,"_18699":35189,"_5":22186,"_15048":34546,"_1570":35190},[],"**Inmutabilidad del subject**: el CSR de renovación debe tener exactamente el mismo subject que el certificado en vigor. Lamassu compara, byte a byte, el `RawSubject` del CSR con el del certificado (`slices.Compare`). Si los bytes difieren, el servidor cae a una comparación semántica de respaldo sobre los atributos `CommonName`, `OrganizationalUnit`, `Organization`, `Locality`, `Province` y `Country`. Si todos esos atributos coinciden, el reenroll continúa pese a la diferencia de bytes (rescata casos donde solo cambia la codificación, `PrintableString` frente a `UTF8String`). Si algún atributo difiere, el reenroll se aborta con `invalid RawSubject bytes`. El integrador debe regenerar el CSR con exactamente el mismo subject que en la inscripción inicial para no depender del comportamiento de fallback.",{"_7897":1172,"_22053":926,"_18699":35192,"_5":22186,"_15048":34546,"_1570":35193},[],"**Validación de la cadena del certificado presentado**: la validación se intenta primero contra la CA de enrolamiento del DMS; si falla, recorre las `AdditionalValidationCAs`. La validación es \"shallow\": cada CA se prueba como ancla, no se compone una cadena multinivel. El cliente debe presentar la cadena completa en el handshake mTLS. Un certificado revocado aborta el reenroll con `certificate is revoked`.",{"_7897":1173,"_22053":926,"_18699":35195,"_5":22186,"_15048":34550,"_1570":35196},[],"El endpoint `POST /.well-known/est/{aps}/serverkeygen` permite que Lamassu genere el par de claves del dispositivo en el servidor y devuelva, en la misma respuesta, la clave privada y el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada o flujos donde la clave se aprovisiona durante la fabricación.",{"_7897":1174,"_22053":926,"_18699":35198,"_5":22186,"_15048":34550,"_1570":35199},[],"Este endpoint requiere que `ServerKeyGen.Enabled` valga `true` en el DMS. Si no está activado, el servidor responde con `server key generation not enabled`. La autenticación se aplica igual que en `/simpleenroll`: el integrador presenta la credencial que corresponda al `AuthMode` del DMS.",{"_7897":1175,"_22053":926,"_18699":35201,"_5":22186,"_15048":34550,"_1570":35202},[],"El algoritmo y el tamaño de la clave generada se deciden por el DMS, no por el cliente.",{"_7897":1176,"_22053":926,"_18699":35204,"_5":22186,"_15048":34550,"_1570":35205},[],"Tipo de clave",{"_7897":1177,"_22053":926,"_18699":35207,"_5":22186,"_15048":34550,"_1570":35208},[],"Parámetro válido",{"_7897":1178,"_22053":926,"_18699":35210,"_5":22186,"_15048":34550,"_1570":35211},[],"Curva NIST equivalente",{"_7897":1179,"_22053":926,"_18699":35213,"_5":22186,"_15048":34550,"_1570":35214},[],"Comportamiento ante valores no válidos",{"_7897":1180,"_22053":926,"_18699":35216,"_5":22186,"_15048":34550,"_1570":35217},[],"`RSA`",{"_7897":1181,"_22053":926,"_18699":35219,"_5":22186,"_15048":34550,"_1570":35220},[],"Cualquier número de bits aceptado por `crypto/rsa` (típico: 2048, 3072, 4096)",{"_7897":1182,"_22053":926,"_18699":35222,"_5":22186,"_15048":34550,"_1570":35223},[],"No aplica",{"_7897":1183,"_22053":926,"_18699":35225,"_5":22186,"_15048":34550,"_1570":35226},[],"Si el valor no es válido para RSA, la generación falla y devuelve `500`.",{"_7897":1184,"_22053":926,"_18699":35228,"_5":22186,"_15048":34550,"_1570":35229},[],"`ECDSA`",{"_7897":1185,"_22053":926,"_18699":35231,"_5":22186,"_15048":34550,"_1570":35232},[],"224, 256, 384, 521",{"_7897":1186,"_22053":926,"_18699":35234,"_5":22186,"_15048":34550,"_1570":35235},[],"P-224 / P-256 (prime256v1) / P-384 / P-521",{"_7897":1187,"_22053":926,"_18699":35237,"_5":22186,"_15048":34550,"_1570":35238},[],"Cualquier otro valor degrada **silenciosamente** a P-256, solo con un aviso en log (`invalid key size of N for ECDSA. Defaulting to 256 curve`). El cliente no recibe error: el certificado se emite con una curva distinta de la solicitada.",{"_7897":1188,"_22053":926,"_18699":35240,"_5":22186,"_15048":34550,"_1570":35241},[],"El CSR enviado por el cliente sirve únicamente para transportar el subject y las extensiones; la prueba de posesión PKCS#10 no aplica aquí porque el cliente no es quien generó la clave. Lamassu descarta la clave pública del CSR original, genera un par de claves nuevo con su entropía interna, en motor software y no en un Crypto Engine de hardware como AWS KMS o PKCS#11, construye un CSR nuevo con esa clave y procede a una inscripción interna equivalente a `/simpleenroll`.",{"_7897":1189,"_22053":926,"_18699":35243,"_5":22186,"_15048":34550,"_1570":35244},[],"La respuesta es un `multipart/mixed` con el boundary literal `estServerLamassuBoundary`. Contiene dos partes:",{"_7897":1190,"_22053":926,"_18699":35246,"_5":22186,"_15048":34550,"_1570":35247},[],"La clave privada en formato **PKCS#8 sin cifrar**, codificada en base64 dentro de una parte con `Content-Type: application/pkcs8`.",{"_7897":1191,"_22053":926,"_18699":35249,"_5":22186,"_15048":34550,"_1570":35250},[],"El certificado emitido en PKCS#7 *degenerate* base64, dentro de una parte con `Content-Type: application/pkcs7-mime; smime-type=certs-only`.",{"_7897":1192,"_22053":926,"_18699":35252,"_5":22186,"_15048":34550,"_1570":35253},[],"A diferencia de `/cacerts` y `/simpleenroll`, donde el base64 va troceado en líneas de 76 caracteres, cada parte de `/serverkeygen` viaja como **una única línea base64 sin saltos**. Cualquier proxy inverso que reescriba el cuerpo (por ejemplo, normalizando line endings) puede romper el parseo.",{"_7897":1193,"_22053":926,"_18699":35255,"_5":22186,"_15048":34550,"_1570":35256},[],"Este endpoint invierte el principio PKI por el que el subscriber controla su clave privada. La clave se serializa en PKCS#8 sin cifrar (`PrivateKeyInfo`, sin `EncryptedPrivateKeyInfo`). No se aplica el envoltorio CMS `EnvelopedData` contemplado en RFC 7030 §4.4.2; no se aplica AES key wrap ni cifrado simétrico por contraseña. La única protección es el TLS del canal. El integrador debe garantizar que: (a) ningún proxy inverso termine TLS y registre el cuerpo de la respuesta; (b) la clave se cifre en reposo inmediatamente tras recibirla; (c) la cuenta de auditoría en el servidor Lamassu queda como punto único de origen de la clave.",{"_7897":1194,"_22053":926,"_18699":35258,"_5":22186,"_15048":34550,"_1570":35259},[],"Para separar las dos partes, el siguiente fragmento usa `awk` con el boundary literal. Funciona con la estructura exacta de Lamassu (cada parte = headers + línea en blanco + una sola línea base64); cualquier proxy intermedio que reescriba el cuerpo lo romperá.",{"_7897":1195,"_22053":926,"_18699":35261,"_5":22186,"_15048":34554,"_1570":35262},[],"Una vez revisados los endpoints por separado, estos ejemplos muestran cómo encadenarlos en dos escenarios habituales: el alta inicial de un dispositivo y la renovación de un certificado ya emitido.",{"_7897":1196,"_22053":926,"_18699":35264,"_5":22186,"_15048":34558,"_1570":35265},[],"El siguiente script ilustra el proceso completo de inscripción de un dispositivo con clave EC P-256 generada localmente y autenticación mTLS contra un certificado bootstrap.",{"_7897":1197,"_22053":926,"_18699":35267,"_5":22186,"_15048":34562,"_1570":35268},[],"El siguiente script reproduce un proceso de renovación: detecta la expiración del certificado actual, regenera el CSR con el **mismo subject** y se autentica con el certificado en vigor.",{"_7897":1198,"_22053":926,"_18699":35270,"_5":22186,"_15048":34566,"_1570":35271},[],"Una vez que el dispositivo ha obtenido su certificado de identidad, los pasos habituales son:",{"_7897":1199,"_22053":926,"_18699":35273,"_5":22186,"_15048":34566,"_1570":35274},[],"**Instalar la cadena de confianza** (`cacerts.pem`) en el almacén de confianza del dispositivo. El broker MQTT, el servidor HTTPS o cualquier relying party que valide mTLS necesitará esta cadena.",{"_7897":1200,"_22053":926,"_18699":35276,"_5":22186,"_15048":34566,"_1570":35277},[],"**Combinar el certificado de hoja con la cadena** antes de presentarlo en conexiones mTLS. La respuesta de `/simpleenroll` contiene solo el certificado de hoja; el relying party puede rechazar la conexión si no recibe la cadena completa.",{"_7897":1201,"_22053":926,"_18699":35279,"_5":22186,"_15048":34566,"_1570":35280},[],"**Planificar la renovación**: configurar en el dispositivo un temporizador que invoque `/simplereenroll` dentro de la ventana `ReEnrollmentDelta` antes de la caducidad del certificado. No espere a que caduque salvo que `EnableExpiredRenewal` esté activo.",{"_7897":1202,"_22053":926,"_18699":35282,"_5":22186,"_15048":34574,"_1570":35283},[],"Lamassu mapea casi todos los errores de negocio a `500 Internal Server Error`, no a `4xx`. El código de estado HTTP no es suficiente para distinguir entre un error de red y un error de política. El integrador debe inspeccionar el campo `err` del cuerpo JSON (`{\"err\": \"<mensaje>\"}`) para determinar la causa exacta del fallo.",{"_7897":1203,"_22053":926,"_18699":35285,"_5":22186,"_15048":34574,"_1570":35286},[],"HTTP",{"_7897":1204,"_22053":926,"_18699":35288,"_5":22186,"_15048":34574,"_1570":35289},[],"Mensaje",{"_7897":1205,"_22053":926,"_18699":35291,"_5":22186,"_15048":34574,"_1570":35292},[],"Causa",{"_7897":1206,"_22053":926,"_18699":35294,"_5":22186,"_15048":34574,"_1570":35295},[],"Acción del integrador",{"_7897":1207,"_22053":926,"_18699":35297,"_5":22186,"_15048":34574,"_1570":19514},[],{"_7897":1208,"_22053":926,"_18699":35299,"_5":22186,"_15048":34574,"_1570":35300},[],"`Field validation for 'APS' failed`",{"_7897":1209,"_22053":926,"_18699":35302,"_5":22186,"_15048":34574,"_1570":35303},[],"El segmento `{aps}` falta en la URL.",{"_7897":1210,"_22053":926,"_18699":35305,"_5":22186,"_15048":34574,"_1570":35306},[],"Incluir el ID del DMS en la ruta.",{"_7897":1211,"_22053":926,"_18699":35308,"_5":22186,"_15048":34574,"_1570":19514},[],{"_7897":1212,"_22053":926,"_18699":35310,"_5":22186,"_15048":34574,"_1570":35311},[],"`content-type must be application/pkcs10`",{"_7897":1213,"_22053":926,"_18699":35313,"_5":22186,"_15048":34574,"_1570":35314},[],"Cabecera `Content-Type` ausente o incorrecta.",{"_7897":1214,"_22053":926,"_18699":35316,"_5":22186,"_15048":34574,"_1570":35317},[],"Fijar `Content-Type: application/pkcs10`.",{"_7897":1215,"_22053":926,"_18699":35319,"_5":22186,"_15048":34574,"_1570":19514},[],{"_7897":1216,"_22053":926,"_18699":35321,"_5":22186,"_15048":34574,"_1570":35322},[],"`body payload must be base64 encoded`",{"_7897":1217,"_22053":926,"_18699":35324,"_5":22186,"_15048":34574,"_1570":35325},[],"El cuerpo no es base64 válido.",{"_7897":1218,"_22053":926,"_18699":35327,"_5":22186,"_15048":34574,"_1570":35328},[],"Usar `base64 -w 0` para evitar saltos de línea.",{"_7897":1219,"_22053":926,"_18699":35330,"_5":22186,"_15048":34574,"_1570":20039},[],{"_7897":1220,"_22053":926,"_18699":35332,"_5":22186,"_15048":34574,"_1570":35333},[],"`DMS not found`",{"_7897":1221,"_22053":926,"_18699":35335,"_5":22186,"_15048":34574,"_1570":35336},[],"El valor `{aps}` no se corresponde con ningún DMS.",{"_7897":1222,"_22053":926,"_18699":35338,"_5":22186,"_15048":34574,"_1570":35339},[],"Verificar el identificador con el administrador PKI.",{"_7897":1223,"_22053":926,"_18699":35341,"_5":22186,"_15048":34574,"_1570":20039},[],{"_7897":1224,"_22053":926,"_18699":35343,"_5":22186,"_15048":34574,"_1570":35344},[],"`invalid certificate`",{"_7897":1225,"_22053":926,"_18699":35346,"_5":22186,"_15048":34574,"_1570":35347},[],"El certificado cliente no es válido contra `ValidationCAs`.",{"_7897":1226,"_22053":926,"_18699":35349,"_5":22186,"_15048":34574,"_1570":35350},[],"Comprobar la cadena del certificado bootstrap.",{"_7897":1227,"_22053":926,"_18699":35352,"_5":22186,"_15048":34574,"_1570":20039},[],{"_7897":1228,"_22053":926,"_18699":35354,"_5":22186,"_15048":34574,"_1570":35355},[],"`certificate is revoked`",{"_7897":1229,"_22053":926,"_18699":35357,"_5":22186,"_15048":34574,"_1570":35358},[],"El certificado **presentado como credencial mTLS** está revocado en Lamassu o vía OCSP/CRL externos.",{"_7897":1230,"_22053":926,"_18699":35360,"_5":22186,"_15048":34574,"_1570":35361},[],"Solicitar un nuevo certificado bootstrap o investigar la revocación.",{"_7897":1231,"_22053":926,"_18699":35363,"_5":22186,"_15048":34574,"_1570":20039},[],{"_7897":1232,"_22053":926,"_18699":35365,"_5":22186,"_15048":34574,"_1570":35366},[],"`revoked certificate`",{"_7897":1233,"_22053":926,"_18699":35368,"_5":22186,"_15048":34574,"_1570":35369},[],"En reenroll, el certificado **activo del dispositivo en la base de datos** figura como revocado.",{"_7897":1234,"_22053":926,"_18699":35371,"_5":22186,"_15048":34574,"_1570":35372},[],"Revisar el estado del slot de identidad; si la revocación fue intencional, emitir un nuevo enroll en lugar de reenroll.",{"_7897":1235,"_22053":926,"_18699":35374,"_5":22186,"_15048":34574,"_1570":20039},[],{"_7897":1236,"_22053":926,"_18699":35376,"_5":22186,"_15048":34574,"_1570":35377},[],"`expired certificate`",{"_7897":1237,"_22053":926,"_18699":35379,"_5":22186,"_15048":34574,"_1570":35380},[],"El certificado presentado ha caducado y el DMS no permite `AllowExpired`/`EnableExpiredRenewal`.",{"_7897":1238,"_22053":926,"_18699":35382,"_5":22186,"_15048":34574,"_1570":35383},[],"Renovar antes de la caducidad o solicitar habilitar `EnableExpiredRenewal`.",{"_7897":1239,"_22053":926,"_18699":35385,"_5":22186,"_15048":34574,"_1570":20039},[],{"_7897":1240,"_22053":926,"_18699":35387,"_5":22186,"_15048":34574,"_1570":35388},[],"`forbiddenNewEnrollment`",{"_7897":1241,"_22053":926,"_18699":35390,"_5":22186,"_15048":34574,"_1570":35391},[],"El dispositivo ya está enrolado y `EnableReplaceableEnrollment` es `false`.",{"_7897":1242,"_22053":926,"_18699":35393,"_5":22186,"_15048":34574,"_1570":35394},[],"Usar `/simplereenroll` o pedir al administrador que habilite el flag.",{"_7897":1243,"_22053":926,"_18699":35396,"_5":22186,"_15048":34574,"_1570":20039},[],{"_7897":1244,"_22053":926,"_18699":35398,"_5":22186,"_15048":34574,"_1570":35399},[],"`device not preregistered`",{"_7897":1245,"_22053":926,"_18699":35401,"_5":22186,"_15048":34574,"_1570":35402},[],"El DMS está en `PRE_REGISTRATION` y el dispositivo no existe.",{"_7897":1246,"_22053":926,"_18699":35404,"_5":22186,"_15048":34574,"_1570":35405},[],"Registrar el dispositivo antes de inscribirlo.",{"_7897":1247,"_22053":926,"_18699":35407,"_5":22186,"_15048":34574,"_1570":20039},[],{"_7897":1248,"_22053":926,"_18699":35409,"_5":22186,"_15048":34574,"_1570":35410},[],"`invalid reenroll window`",{"_7897":1249,"_22053":926,"_18699":35412,"_5":22186,"_15048":34574,"_1570":35413},[],"Se intenta renovar antes de `NotAfter - ReEnrollmentDelta`.",{"_7897":1250,"_22053":926,"_18699":35415,"_5":22186,"_15048":34574,"_1570":35416},[],"Esperar a la apertura de la ventana o pedir un `ReEnrollmentDelta` mayor.",{"_7897":1251,"_22053":926,"_18699":35418,"_5":22186,"_15048":34574,"_1570":20039},[],{"_7897":1252,"_22053":926,"_18699":35420,"_5":22186,"_15048":34574,"_1570":35421},[],"`invalid RawSubject bytes`",{"_7897":1253,"_22053":926,"_18699":35423,"_5":22186,"_15048":34574,"_1570":35424},[],"El subject del CSR de renovación no coincide con el del certificado en vigor.",{"_7897":1254,"_22053":926,"_18699":35426,"_5":22186,"_15048":34574,"_1570":35427},[],"Regenerar el CSR con el subject exacto del cert anterior.",{"_7897":1255,"_22053":926,"_18699":35429,"_5":22186,"_15048":34574,"_1570":20039},[],{"_7897":1256,"_22053":926,"_18699":35431,"_5":22186,"_15048":34574,"_1570":35432},[],"`external webhook denied enrollment`",{"_7897":1257,"_22053":926,"_18699":35434,"_5":22186,"_15048":34574,"_1570":35435},[],"El webhook devolvió un código no `2xx` o `authorized != true`.",{"_7897":1258,"_22053":926,"_18699":35437,"_5":22186,"_15048":34574,"_1570":35438},[],"Revisar los logs del servicio webhook.",{"_7897":1259,"_22053":926,"_18699":35440,"_5":22186,"_15048":34574,"_1570":20039},[],{"_7897":1260,"_22053":926,"_18699":35442,"_5":22186,"_15048":34574,"_1570":35443},[],"`server key generation not enabled`",{"_7897":1261,"_22053":926,"_18699":35445,"_5":22186,"_15048":34574,"_1570":35446},[],"`/serverkeygen` está deshabilitado en el DMS.",{"_7897":1262,"_22053":926,"_18699":35448,"_5":22186,"_15048":34574,"_1570":35449},[],"Pedir al administrador activar `ServerKeyGen.Enabled`.",{"_7897":1263,"_22053":926,"_18699":35451,"_5":22186,"_15048":34574,"_1570":35452},[],"Para los mensajes que no figuren en esta tabla, los logs del servidor Lamassu (con los campos `func`, `dms`, `device-cn`, `step`, `auth-method`, `auth-status`) son el primer lugar donde buscar la causa.",{"_7897":1264,"_22053":926,"_18699":35454,"_5":22186,"_15048":34578,"_1570":35455},[],"La implementación de Lamassu se ajusta al RFC 7030 en lo esencial pero introduce varias particularidades que pueden afectar a clientes EST estrictos o a librerías de terceros:",{"_7897":1265,"_22053":926,"_18699":35457,"_5":22186,"_15048":34578,"_1570":35458},[],"Los endpoints `/csrattrs` y `/fullcmc` del RFC 7030 **no están implementados** en Lamassu. Un cliente que invoque `/.well-known/est/<DMS_ID>/csrattrs` recibirá `404 Not Found` en lugar del `204 No Content` que el RFC sugiere para \"sin atributos\". Las librerías EST estrictas deben configurarse para no intentar `csrattrs`.",{"_7897":1266,"_22053":926,"_18699":35460,"_5":22186,"_15048":34578,"_1570":35461},[],"El base64 de la respuesta de `/cacerts` y `/simpleenroll` se trocea en líneas de **76 caracteres** terminadas con CRLF (conforme con S/MIME, RFC 5751). Las partes de `/serverkeygen` no aplican wrap.",{"_7897":1267,"_22053":926,"_18699":35463,"_5":22186,"_15048":34578,"_1570":35464},[],"El boundary del `multipart/mixed` en `/serverkeygen` está fijado y no se puede negociar.",{"_7897":1268,"_22053":926,"_18699":35466,"_5":22186,"_15048":34578,"_1570":35467},[],"El segmento `{aps}` es **obligatorio** en todas las rutas EST. Las rutas registradas sin `{aps}` están en el código pero responden `400`.",{"_7897":1269,"_22053":926,"_18699":35469,"_5":22186,"_15048":34578,"_1570":35470},[],"El cuerpo de `/cacerts`, `/simpleenroll` y `/simplereenroll` puede devolverse como PEM concatenado si el cliente envía `Accept: application/x-pem-file`. Esta es una extensión específica de Lamassu y no aparece en el RFC.",{"_7897":1270,"_22053":926,"_18699":35472,"_5":22186,"_15048":34578,"_1570":35473},[],"El servidor no rechaza explícitamente CSRs firmados con SHA-1 o MD5; el integrador debe generar el CSR con SHA-256 o superior.",{"_7897":1271,"_22053":926,"_18699":35475,"_5":22186,"_15048":34578,"_1570":35476},[],"<Card title=\"Visión general del DMS\" href=\"/docs/manual/servicios-core/ra\" />",{"_7897":1272,"_22053":926,"_18699":35478,"_5":22186,"_15048":34578,"_1570":35479},[],"<Card title=\"Validación OCSP\" href=\"/docs/manual/servicios-core/validation-ocsp\" />",{"_7897":1273,"_22053":926,"_18699":35481,"_5":22186,"_15048":34578,"_1570":35482},[],"<Card title=\"Gestionar dispositivos\" href=\"/docs/manual/servicios-core/devices\" />",{"_7897":1274,"_22053":1274,"_5":22181,"_1570":35484,"_22194":35485,"_18699":35486,"_15048":1274},"[KMS] Gestión de Claves Criptográficas",[31686,32785,32794],[],{"_7897":1275,"_22053":1274,"_18699":35488,"_5":22186,"_15048":1274,"_1570":35489},[],"Gestión y operación de claves criptográficas en Lamassu IoT",{"_7897":1276,"_22053":1274,"_5":22191,"_18699":35491,"_15048":35492,"_1570":35493},[],"/docs/manual/servicios-core/kms#gestión-de-claves-criptográficas","Gestión de claves criptográficas",{"_7897":1277,"_22053":1274,"_5":22191,"_18699":35495,"_15048":35496,"_1570":35497},[],"/docs/manual/servicios-core/kms#qué-resuelve-el-kms","Qué resuelve el KMS",{"_7897":1278,"_22053":1274,"_5":22191,"_18699":35499,"_15048":35500,"_1570":35501},[],"/docs/manual/servicios-core/kms#motores-criptográficos","Motores criptográficos",{"_7897":1279,"_22053":1274,"_5":22191,"_18699":35503,"_15048":35504,"_1570":35505},[],"/docs/manual/servicios-core/kms#inventario-de-claves","Inventario de claves",{"_7897":1280,"_22053":1274,"_5":22191,"_18699":35507,"_15048":35508,"_1570":35509},[],"/docs/manual/servicios-core/kms#crear-o-importar-claves","Crear o importar claves",{"_7897":1281,"_22053":1274,"_5":22191,"_18699":35511,"_15048":35512,"_1570":35513},[],"/docs/manual/servicios-core/kms#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_7897":1282,"_22053":1274,"_5":22191,"_18699":35515,"_15048":35516,"_1570":35517},[],"/docs/manual/servicios-core/kms#importar-un-par-existente","Importar un par existente",{"_7897":1283,"_22053":1274,"_5":22191,"_18699":35519,"_15048":35520,"_1570":35521},[],"/docs/manual/servicios-core/kms#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_7897":1284,"_22053":1274,"_5":22191,"_18699":35523,"_15048":35524,"_1570":35525},[],"/docs/manual/servicios-core/kms#ver-detalles","Ver detalles",{"_7897":1285,"_22053":1274,"_5":22191,"_18699":35527,"_15048":35528,"_1570":35529},[],"/docs/manual/servicios-core/kms#firmar-y-verificar","Firmar y verificar",{"_7897":1286,"_22053":1274,"_5":22191,"_18699":35531,"_15048":35532,"_1570":35533},[],"/docs/manual/servicios-core/kms#sign","Sign",{"_7897":1287,"_22053":1274,"_5":22191,"_18699":35535,"_15048":35536,"_1570":35537},[],"/docs/manual/servicios-core/kms#verify","Verify",{"_7897":1288,"_22053":1274,"_5":22191,"_18699":35539,"_15048":35540,"_1570":35541},[],"/docs/manual/servicios-core/kms#generar-un-csr","Generar un CSR",{"_7897":1289,"_22053":1274,"_5":22191,"_18699":35543,"_15048":35544,"_1570":35545},[],"/docs/manual/servicios-core/kms#firma-local-con-pkcs11","Firma local con PKCS#11",{"_7897":1290,"_22053":1274,"_18699":35547,"_5":22186,"_15048":35492,"_1570":35548},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_7897":1291,"_22053":1274,"_18699":35550,"_5":22186,"_15048":35492,"_1570":35551},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_7897":1292,"_22053":1274,"_18699":35553,"_5":22186,"_15048":35496,"_1570":35554},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_7897":1293,"_22053":1274,"_18699":35556,"_5":22186,"_15048":35496,"_1570":35557},[],"En la práctica, permite:",{"_7897":1294,"_22053":1274,"_18699":35559,"_5":22186,"_15048":35496,"_1570":35560},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_7897":1295,"_22053":1274,"_18699":35562,"_5":22186,"_15048":35496,"_1570":35563},[],"Importar claves creadas externamente.",{"_7897":1296,"_22053":1274,"_18699":35565,"_5":22186,"_15048":35496,"_1570":35566},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_7897":1297,"_22053":1274,"_18699":35568,"_5":22186,"_15048":35496,"_1570":35569},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_7897":1298,"_22053":1274,"_18699":35571,"_5":22186,"_15048":35500,"_1570":35572},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_7897":1299,"_22053":1274,"_18699":35574,"_5":22186,"_15048":35500,"_1570":35575},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_7897":1300,"_22053":1274,"_18699":35577,"_5":22186,"_15048":35500,"_1570":35578},[],"Actualmente, Lamassu soporta los siguientes motores:",{"_7897":1301,"_22053":1274,"_18699":35580,"_5":22186,"_15048":35500,"_1570":35581},[],"Crypto Engine",{"_7897":1302,"_22053":1274,"_18699":35583,"_5":22186,"_15048":35500,"_1570":35584},[],"Nivel de seguridad",{"_7897":1303,"_22053":1274,"_18699":35586,"_5":22186,"_15048":35500,"_1570":35587},[],"OnPrem / Cloud",{"_7897":1304,"_22053":1274,"_18699":35589,"_5":22186,"_15048":35500,"_1570":35590},[],"Coste adicional",{"_7897":1305,"_22053":1274,"_18699":35592,"_5":22186,"_15048":35500,"_1570":35593},[],"Generación de claves",{"_7897":1306,"_22053":1274,"_18699":35595,"_5":22186,"_15048":35500,"_1570":35596},[],"Persistencia *at-rest* segura",{"_7897":1307,"_22053":1274,"_18699":35598,"_5":22186,"_15048":35500,"_1570":35599},[],"Filtración de claves",{"_7897":1308,"_22053":1274,"_18699":35601,"_5":22186,"_15048":35500,"_1570":35602},[],"Consideraciones",{"_7897":1309,"_22053":1274,"_18699":35604,"_5":22186,"_15048":35500,"_1570":35605},[],"File System",{"_7897":1310,"_22053":1274,"_18699":35607,"_5":22186,"_15048":35500,"_1570":11217},[],{"_7897":1311,"_22053":1274,"_18699":35609,"_5":22186,"_15048":35500,"_1570":35610},[],"OnPrem y Cloud",{"_7897":1312,"_22053":1274,"_18699":35612,"_5":22186,"_15048":35500,"_1570":33085},[],{"_7897":1313,"_22053":1274,"_18699":35614,"_5":22186,"_15048":35500,"_1570":35615},[],"**Entropía software**. La generación se realiza con las librerías criptográficas de Go.",{"_7897":1314,"_22053":1274,"_18699":35617,"_5":22186,"_15048":35500,"_1570":35618},[],"**Insegura**. Delegada en el sistema de archivos.",{"_7897":1315,"_22053":1274,"_18699":35620,"_5":22186,"_15048":35500,"_1570":35618},[],{"_7897":1316,"_22053":1274,"_18699":35622,"_5":22186,"_15048":35500,"_1570":35623},[],"No recomendado para producción.",{"_7897":1317,"_22053":1274,"_18699":35625,"_5":22186,"_15048":35500,"_1570":35626},[],"HashiCorp Vault",{"_7897":1318,"_22053":1274,"_18699":35628,"_5":22186,"_15048":35500,"_1570":3999},[],{"_7897":1319,"_22053":1274,"_18699":35630,"_5":22186,"_15048":35500,"_1570":35610},[],{"_7897":1320,"_22053":1274,"_18699":35632,"_5":22186,"_15048":35500,"_1570":33085},[],{"_7897":1321,"_22053":1274,"_18699":35634,"_5":22186,"_15048":35500,"_1570":35635},[],"Depende de la configuración de Vault.",{"_7897":1322,"_22053":1274,"_18699":35637,"_5":22186,"_15048":35500,"_1570":35638},[],"**Segura**",{"_7897":1323,"_22053":1274,"_18699":35640,"_5":22186,"_15048":35500,"_1570":35641},[],"**Insegura**. Un administrador con permisos suficientes puede visualizar la clave privada.",{"_7897":1324,"_22053":1274,"_18699":35643,"_5":22186,"_15048":35500,"_1570":35644},[],"Conviene limitar al máximo el acceso administrativo y custodiar correctamente las claves de *unseal*.",{"_7897":1325,"_22053":1274,"_18699":35646,"_5":22186,"_15048":35500,"_1570":35647},[],"AWS Secrets Manager",{"_7897":1326,"_22053":1274,"_18699":35649,"_5":22186,"_15048":35500,"_1570":3999},[],{"_7897":1327,"_22053":1274,"_18699":35651,"_5":22186,"_15048":35500,"_1570":35652},[],"Cloud",{"_7897":1328,"_22053":1274,"_18699":35654,"_5":22186,"_15048":35500,"_1570":33033},[],{"_7897":1329,"_22053":1274,"_18699":35656,"_5":22186,"_15048":35500,"_1570":35657},[],"Depende del proceso de alta de la clave.",{"_7897":1330,"_22053":1274,"_18699":35659,"_5":22186,"_15048":35500,"_1570":35638},[],{"_7897":1331,"_22053":1274,"_18699":35661,"_5":22186,"_15048":35500,"_1570":35641},[],{"_7897":1332,"_22053":1274,"_18699":35663,"_5":22186,"_15048":35500,"_1570":35664},[],"La protección *at-rest* la proporciona AWS, pero no evita el acceso administrativo al material privado.",{"_7897":1333,"_22053":1274,"_18699":35666,"_5":22186,"_15048":35500,"_1570":35667},[],"AWS KMS",{"_7897":1334,"_22053":1274,"_18699":35669,"_5":22186,"_15048":35500,"_1570":13329},[],{"_7897":1335,"_22053":1274,"_18699":35671,"_5":22186,"_15048":35500,"_1570":35652},[],{"_7897":1336,"_22053":1274,"_18699":35673,"_5":22186,"_15048":35500,"_1570":33033},[],{"_7897":1337,"_22053":1274,"_18699":35675,"_5":22186,"_15048":35500,"_1570":35676},[],"**Entropía hardware**",{"_7897":1338,"_22053":1274,"_18699":35678,"_5":22186,"_15048":35500,"_1570":35638},[],{"_7897":1339,"_22053":1274,"_18699":35680,"_5":22186,"_15048":35500,"_1570":35638},[],{"_7897":1340,"_22053":1274,"_18699":35682,"_5":22186,"_15048":35500,"_1570":35683},[],"Aunque la clave privada no se expone, un actor con permisos suficientes podría usarla para firmar artefactos.",{"_7897":1341,"_22053":1274,"_18699":35685,"_5":22186,"_15048":35500,"_1570":35686},[],"PKCS11",{"_7897":1342,"_22053":1274,"_18699":35688,"_5":22186,"_15048":35500,"_1570":35689},[],"3\\*",{"_7897":1343,"_22053":1274,"_18699":35691,"_5":22186,"_15048":35500,"_1570":35692},[],"AirGap OnPrem y Cloud",{"_7897":1344,"_22053":1274,"_18699":35694,"_5":22186,"_15048":35500,"_1570":35695},[],"Depende del hardware o del servicio usado. Puede integrarse con HSMs OnPrem o con ofertas Key as a Service.",{"_7897":1345,"_22053":1274,"_18699":35697,"_5":22186,"_15048":35500,"_1570":35676},[],{"_7897":1346,"_22053":1274,"_18699":35699,"_5":22186,"_15048":35500,"_1570":35700},[],"**Segura**\\*",{"_7897":1347,"_22053":1274,"_18699":35702,"_5":22186,"_15048":35500,"_1570":35703},[],"Depende del HSM",{"_7897":1348,"_22053":1274,"_18699":35705,"_5":22186,"_15048":35500,"_1570":35706},[],"El nivel real depende de la implementación PKCS11 y del HSM utilizado.",{"_7897":1349,"_22053":1274,"_18699":35708,"_5":22186,"_15048":35500,"_1570":35709},[],"Lamassu muestra en la consola el listado completo de motores habilitados.",{"_7897":1350,"_22053":1274,"_18699":35711,"_5":22186,"_15048":35500,"_1570":35712},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_7897":1351,"_22053":1274,"_18699":35714,"_5":22186,"_15048":35500,"_1570":35715},[],"Durante el despliegue es obligatorio definir un motor por defecto. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_7897":1352,"_22053":1274,"_18699":35717,"_5":22186,"_15048":35504,"_1570":35718},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_7897":1353,"_22053":1274,"_18699":35720,"_5":22186,"_15048":35504,"_1570":35721},[],"La tabla incluye los siguientes campos:",{"_7897":1354,"_22053":1274,"_18699":35723,"_5":22186,"_15048":35504,"_1570":35724},[],"**Name**: nombre descriptivo de la clave.",{"_7897":1355,"_22053":1274,"_18699":35726,"_5":22186,"_15048":35504,"_1570":35727},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_7897":1356,"_22053":1274,"_18699":35729,"_5":22186,"_15048":35504,"_1570":35730},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_7897":1357,"_22053":1274,"_18699":35732,"_5":22186,"_15048":35504,"_1570":35733},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_7897":1358,"_22053":1274,"_18699":35735,"_5":22186,"_15048":35504,"_1570":35736},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_7897":1359,"_22053":1274,"_18699":35738,"_5":22186,"_15048":35504,"_1570":35739},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_7897":1360,"_22053":1274,"_18699":35741,"_5":22186,"_15048":35504,"_1570":35742},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_7897":1361,"_22053":1274,"_18699":35744,"_5":22186,"_15048":35504,"_1570":35745},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_7897":1362,"_22053":1274,"_18699":35747,"_5":22186,"_15048":35504,"_1570":35748},[],"Desde esta vista también se accede a las acciones más habituales:",{"_7897":1363,"_22053":1274,"_18699":35750,"_5":22186,"_15048":35504,"_1570":35751},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_7897":1364,"_22053":1274,"_18699":35753,"_5":22186,"_15048":35504,"_1570":35754},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_7897":1365,"_22053":1274,"_18699":35756,"_5":22186,"_15048":35504,"_1570":35757},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_7897":1366,"_22053":1274,"_18699":35759,"_5":22186,"_15048":35504,"_1570":35760},[],"**Delete Key** para eliminar la clave del sistema.",{"_7897":1367,"_22053":1274,"_18699":35762,"_5":22186,"_15048":35508,"_1570":35763},[],"El alta de claves se realiza desde el asistente que se abre con **Create New Key**.",{"_7897":1368,"_22053":1274,"_18699":35765,"_5":22186,"_15048":35512,"_1570":35766},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_7897":1369,"_22053":1274,"_18699":35768,"_5":22186,"_15048":35512,"_1570":35769},[],"En la primera pantalla del asistente, elija **Generate New Key Pair** y después defina los parámetros principales:",{"_7897":1370,"_22053":1274,"_18699":35771,"_5":22186,"_15048":35512,"_1570":35772},[],"**Key Name**: nombre único y descriptivo.",{"_7897":1371,"_22053":1274,"_18699":35774,"_5":22186,"_15048":35512,"_1570":35775},[],"**Crypto Engine**: motor que custodiará la clave.",{"_7897":1372,"_22053":1274,"_18699":35777,"_5":22186,"_15048":35512,"_1570":35778},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_7897":1373,"_22053":1274,"_18699":35780,"_5":22186,"_15048":35512,"_1570":35781},[],"**Tags**: metadatos para clasificar la clave.",{"_7897":1374,"_22053":1274,"_18699":35783,"_5":22186,"_15048":35512,"_1570":35784},[],"**Metadata**: información adicional para usos avanzados.",{"_7897":1375,"_22053":1274,"_18699":35786,"_5":22186,"_15048":35516,"_1570":35787},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_7897":1376,"_22053":1274,"_18699":35789,"_5":22186,"_15048":35516,"_1570":35790},[],"Cuando la clave se ha generado en un entorno aislado o en un HSM externo.",{"_7897":1377,"_22053":1274,"_18699":35792,"_5":22186,"_15048":35516,"_1570":35793},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_7897":1378,"_22053":1274,"_18699":35795,"_5":22186,"_15048":35516,"_1570":35796},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_7897":1379,"_22053":1274,"_18699":35798,"_5":22186,"_15048":35516,"_1570":35799},[],"En el asistente, elija **Import Existing Key Pair** y complete los campos solicitados:",{"_7897":1380,"_22053":1274,"_18699":35801,"_5":22186,"_15048":35516,"_1570":35802},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_7897":1381,"_22053":1274,"_18699":35804,"_5":22186,"_15048":35516,"_1570":35805},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_7897":1382,"_22053":1274,"_18699":35807,"_5":22186,"_15048":35516,"_1570":35808},[],"**Tags**: etiquetas para organización y búsqueda.",{"_7897":1383,"_22053":1274,"_18699":35810,"_5":22186,"_15048":35516,"_1570":35811},[],"**Metadata**: información adicional opcional.",{"_7897":1384,"_22053":1274,"_18699":35813,"_5":22186,"_15048":35516,"_1570":35814},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_7897":1385,"_22053":1274,"_18699":35816,"_5":22186,"_15048":35516,"_1570":35817},[],"Una vez completado el asistente, la clave queda almacenada en el motor seleccionado y puede utilizarse para firma, generación de CSR y el resto de operaciones soportadas por KMS.",{"_7897":1386,"_22053":1274,"_18699":35819,"_5":22186,"_15048":35520,"_1570":35820},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_7897":1387,"_22053":1274,"_18699":35822,"_5":22186,"_15048":35524,"_1570":35823},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_7897":1388,"_22053":1274,"_18699":35825,"_5":22186,"_15048":35524,"_1570":35826},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_7897":1389,"_22053":1274,"_18699":35828,"_5":22186,"_15048":35524,"_1570":35829},[],"**Key Name**: nombre descriptivo.",{"_7897":1390,"_22053":1274,"_18699":35831,"_5":22186,"_15048":35524,"_1570":35832},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_7897":1391,"_22053":1274,"_18699":35834,"_5":22186,"_15048":35524,"_1570":35835},[],"**Tags**: etiquetas asociadas.",{"_7897":1392,"_22053":1274,"_18699":35837,"_5":22186,"_15048":35524,"_1570":35838},[],"**Aliases**: nombres alternativos.",{"_7897":1393,"_22053":1274,"_18699":35840,"_5":22186,"_15048":35524,"_1570":35841},[],"**Crypto Engine**: motor en el que reside la clave.",{"_7897":1394,"_22053":1274,"_18699":35843,"_5":22186,"_15048":35524,"_1570":35844},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_7897":1395,"_22053":1274,"_18699":35846,"_5":22186,"_15048":35524,"_1570":35847},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_7897":1396,"_22053":1274,"_18699":35849,"_5":22186,"_15048":35524,"_1570":35850},[],"La pestaña **Public Key** presenta la clave pública en formato PEM, lista para consulta o copia.",{"_7897":1397,"_22053":1274,"_18699":35852,"_5":22186,"_15048":35528,"_1570":35853},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_7897":1398,"_22053":1274,"_18699":35855,"_5":22186,"_15048":35528,"_1570":35856},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_7897":1399,"_22053":1274,"_18699":35858,"_5":22186,"_15048":35532,"_1570":35859},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_7897":1400,"_22053":1274,"_18699":35861,"_5":22186,"_15048":35532,"_1570":35862},[],"Campos principales:",{"_7897":1401,"_22053":1274,"_18699":35864,"_5":22186,"_15048":35532,"_1570":35865},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_7897":1402,"_22053":1274,"_18699":35867,"_5":22186,"_15048":35532,"_1570":35868},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_7897":1403,"_22053":1274,"_18699":35870,"_5":22186,"_15048":35532,"_1570":35871},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_7897":1404,"_22053":1274,"_18699":35873,"_5":22186,"_15048":35532,"_1570":35874},[],"**Message**: contenido que se va a firmar.",{"_7897":1405,"_22053":1274,"_18699":35876,"_5":22186,"_15048":35532,"_1570":35877},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_7897":1406,"_22053":1274,"_18699":35879,"_5":22186,"_15048":35536,"_1570":35880},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_7897":1407,"_22053":1274,"_18699":35882,"_5":22186,"_15048":35536,"_1570":35862},[],{"_7897":1408,"_22053":1274,"_18699":35884,"_5":22186,"_15048":35536,"_1570":35885},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_7897":1409,"_22053":1274,"_18699":35887,"_5":22186,"_15048":35536,"_1570":35888},[],"**Message Type**: `Raw` o `Digest`.",{"_7897":1410,"_22053":1274,"_18699":35890,"_5":22186,"_15048":35536,"_1570":35891},[],"**Payload Encoding**: codificación del mensaje.",{"_7897":1411,"_22053":1274,"_18699":35893,"_5":22186,"_15048":35536,"_1570":35894},[],"**Message**: mensaje original o hash.",{"_7897":1412,"_22053":1274,"_18699":35896,"_5":22186,"_15048":35536,"_1570":35897},[],"**Signature**: firma que se desea comprobar.",{"_7897":1413,"_22053":1274,"_18699":35899,"_5":22186,"_15048":35536,"_1570":35900},[],"**Result**: indicador del resultado de la validación.",{"_7897":1414,"_22053":1274,"_18699":35902,"_5":22186,"_15048":35540,"_1570":35903},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_7897":1415,"_22053":1274,"_18699":35905,"_5":22186,"_15048":35540,"_1570":35906},[],"Este flujo es útil para:",{"_7897":1416,"_22053":1274,"_18699":35908,"_5":22186,"_15048":35540,"_1570":35909},[],"Solicitar certificados a una CA externa.",{"_7897":1417,"_22053":1274,"_18699":35911,"_5":22186,"_15048":35540,"_1570":35912},[],"Renovar una identidad manteniendo la misma clave.",{"_7897":1418,"_22053":1274,"_18699":35914,"_5":22186,"_15048":35540,"_1570":35915},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_7897":1419,"_22053":1274,"_18699":35917,"_5":22186,"_15048":35540,"_1570":35918},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_7897":1420,"_22053":1274,"_18699":35920,"_5":22186,"_15048":35540,"_1570":35921},[],"**Organization (O)**: organización o empresa.",{"_7897":1421,"_22053":1274,"_18699":35923,"_5":22186,"_15048":35540,"_1570":35924},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_7897":1422,"_22053":1274,"_18699":35926,"_5":22186,"_15048":35540,"_1570":35927},[],"**Country (C)**: código de país de dos letras.",{"_7897":1423,"_22053":1274,"_18699":35929,"_5":22186,"_15048":35540,"_1570":35930},[],"**State / Province (ST)**: estado o provincia.",{"_7897":1424,"_22053":1274,"_18699":35932,"_5":22186,"_15048":35540,"_1570":35933},[],"**Locality (L)**: ciudad o localidad.",{"_7897":1425,"_22053":1274,"_18699":35935,"_5":22186,"_15048":35540,"_1570":35936},[],"**Email Address**: correo de contacto.",{"_7897":1426,"_22053":1274,"_18699":35938,"_5":22186,"_15048":35540,"_1570":35939},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_7897":1427,"_22053":1274,"_18699":35941,"_5":22186,"_15048":35540,"_1570":35942},[],"Una vez completado el formulario, Lamassu genera la CSR y la presenta para su descarga o copia.",{"_7897":1428,"_22053":1274,"_18699":35944,"_5":22186,"_15048":35544,"_1570":35945},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_7897":1429,"_22053":1274,"_18699":35947,"_5":22186,"_15048":35544,"_1570":35948},[],"Esta opción muestra los pasos necesarios para configurar el entorno local, cargar el módulo PKCS#11 y ejecutar firmas con herramientas como OpenSSL sin extraer la clave privada del entorno custodiado.",{"_7897":1430,"_22053":1430,"_5":22181,"_1570":35950,"_22194":35951,"_18699":35952,"_15048":1430},"[DMS] Device Management Service",[31686,32785,32794],[],{"_7897":1431,"_22053":1430,"_18699":35954,"_5":22186,"_15048":1430,"_1570":35955},[],"Visión general del Device Management Service en Lamassu IoT - concepto, panel de gestión y configuración común a todos los protocolos de enrolamiento.",{"_7897":1432,"_22053":1430,"_5":22191,"_18699":35957,"_15048":35958,"_1570":35959},[],"/docs/manual/servicios-core/ra#device-management-service","Device Management Service",{"_7897":1433,"_22053":1430,"_5":22191,"_18699":35961,"_15048":35962,"_1570":34523},[],"/docs/manual/servicios-core/ra#antes-de-empezar",{"_7897":1434,"_22053":1430,"_5":22191,"_18699":35964,"_15048":35965,"_1570":35966},[],"/docs/manual/servicios-core/ra#panel-de-dms","Panel de DMS",{"_7897":1435,"_22053":1430,"_5":22191,"_18699":35968,"_15048":35969,"_1570":35970},[],"/docs/manual/servicios-core/ra#distribución-de-entidades-de-confianza","Distribución de entidades de confianza",{"_7897":1436,"_22053":1430,"_5":22191,"_18699":35972,"_15048":35973,"_1570":35974},[],"/docs/manual/servicios-core/ra#protocolos-de-enrolamiento","Protocolos de enrolamiento",{"_7897":1437,"_22053":1430,"_18699":35976,"_5":22186,"_15048":35958,"_1570":35977},[],"El &#x2A;*DMS (Device Management Service)** es el componente de Lamassu IoT que actúa como Autoridad de Registro (RA) frente a los dispositivos. Cada DMS recibe las solicitudes de certificado, valida la identidad del solicitante según las políticas configuradas y encarga la emisión a la CA asignada. El resultado es un canal de aprovisionamiento controlado e independiente por flota, línea de producto o entorno.",{"_7897":1438,"_22053":1430,"_18699":35979,"_5":22186,"_15048":35958,"_1570":35980},[],"En la práctica, cada DMS representa un punto de entrada diferenciado: tiene su propia CA de enrolamiento, sus propias reglas de autenticación y su propia ventana de renovación. Una organización puede operar varios DMS en paralelo - por ejemplo, uno para dispositivos de campo y otro para pasarelas internas - con políticas completamente distintas en cada caso.",{"_7897":1439,"_22053":1430,"_18699":35982,"_5":22186,"_15048":35962,"_1570":35983},[],"Para crear un DMS es necesario que exista al menos una CA activa en la plataforma, ya que el DMS requiere seleccionar una CA de enrolamiento. El usuario debe disponer del rol de administrador PKI o de permisos equivalentes sobre el módulo DMS.",{"_7897":1440,"_22053":1430,"_18699":35985,"_5":22186,"_15048":35965,"_1570":35986},[],"El panel lista todos los DMS configurados en la plataforma. Cada entrada muestra el nombre del DMS, el protocolo de enrolamiento activo y la CA de enrolamiento asignada. Desde el menú de opciones de cada DMS están disponibles las siguientes acciones:",{"_7897":1441,"_22053":1430,"_18699":35988,"_5":22186,"_15048":35965,"_1570":35989},[],"Acción",{"_7897":1442,"_22053":1430,"_18699":35991,"_5":22186,"_15048":35965,"_1570":31889},[],{"_7897":1443,"_22053":1430,"_18699":35993,"_5":22186,"_15048":35965,"_1570":35994},[],"**Edit**",{"_7897":1444,"_22053":1430,"_18699":35996,"_5":22186,"_15048":35965,"_1570":35997},[],"Modifica la configuración del DMS.",{"_7897":1445,"_22053":1430,"_18699":35999,"_5":22186,"_15048":35965,"_1570":36000},[],"**Go to DMS owned devices**",{"_7897":1446,"_22053":1430,"_18699":36002,"_5":22186,"_15048":35965,"_1570":36003},[],"Abre el listado de dispositivos gestionados por este DMS.",{"_7897":1447,"_22053":1430,"_18699":36005,"_5":22186,"_15048":35965,"_1570":36006},[],"**Show/Edit Metadata**",{"_7897":1448,"_22053":1430,"_18699":36008,"_5":22186,"_15048":35965,"_1570":36009},[],"Accede a los metadatos del DMS para usos avanzados.",{"_7897":1449,"_22053":1430,"_18699":36011,"_5":22186,"_15048":35965,"_1570":36012},[],"**EST (RFC-7030)**",{"_7897":1450,"_22053":1430,"_18699":36014,"_5":22186,"_15048":35965,"_1570":36015},[],"Muestra los endpoints EST del DMS con su URL base y ejemplos de invocación.",{"_7897":1451,"_22053":1430,"_18699":36017,"_5":22186,"_15048":35965,"_1570":36018},[],"**Delete**",{"_7897":1452,"_22053":1430,"_18699":36020,"_5":22186,"_15048":35965,"_1570":36021},[],"Elimina el DMS y su configuración. Acción irreversible.",{"_7897":1453,"_22053":1430,"_18699":36023,"_5":22186,"_15048":35969,"_1570":36024},[],"La sección **CA Distribution** controla qué certificados de CA recibe el dispositivo al consultar el endpoint de distribución de confianza del protocolo activo. Esta configuración es independiente del protocolo de enrolamiento: los parámetros tienen el mismo significado con independencia de cómo el dispositivo obtenga sus certificados.",{"_7897":1454,"_22053":1430,"_18699":36026,"_5":22186,"_15048":35969,"_1570":33017},[],{"_7897":1455,"_22053":1430,"_18699":36028,"_5":22186,"_15048":35969,"_1570":31889},[],{"_7897":1456,"_22053":1430,"_18699":36030,"_5":22186,"_15048":35969,"_1570":36031},[],"**Include Lamassu System CA**",{"_7897":1457,"_22053":1430,"_18699":36033,"_5":22186,"_15048":35969,"_1570":36034},[],"Incluye el certificado TLS del servidor Lamassu en la respuesta. Este es el certificado de extremo del servidor, no una CA - útil para *pinning* de la conexión.",{"_7897":1458,"_22053":1430,"_18699":36036,"_5":22186,"_15048":35969,"_1570":36037},[],"**Include Enrollment CA**",{"_7897":1459,"_22053":1430,"_18699":36039,"_5":22186,"_15048":35969,"_1570":36040},[],"Incluye la CA emisora configurada en este DMS, es decir, la que firmará los certificados de dispositivo.",{"_7897":1460,"_22053":1430,"_18699":36042,"_5":22186,"_15048":35969,"_1570":36043},[],"**Managed CAs**",{"_7897":1461,"_22053":1430,"_18699":36045,"_5":22186,"_15048":35969,"_1570":36046},[],"CAs adicionales distribuidas al dispositivo como anclas de confianza.",{"_7897":1462,"_22053":1430,"_18699":36048,"_5":22186,"_15048":35973,"_1570":36049},[],"El DMS expone un protocolo de enrolamiento a los dispositivos. En la versión actual de Lamassu, el único protocolo soportado es &#x2A;*EST (RFC 7030)**. La configuración del protocolo y la guía de integración para dispositivos se encuentran en las páginas correspondientes.",{"_7897":1463,"_22053":1430,"_18699":36051,"_5":22186,"_15048":35973,"_1570":36052},[],"<Card title=\"EST (RFC 7030)\" href=\"/docs/manual/servicios-core/est\" />",{"_7897":1464,"_22053":1430,"_18699":36054,"_5":22186,"_15048":35973,"_1570":35482},[],{"_7897":1465,"_22053":1465,"_5":22181,"_1570":36056,"_22194":36057,"_18699":36058,"_15048":1465},"[VA] Servicio CRL",[31686,32785,32794],[],{"_7897":1466,"_22053":1465,"_18699":36060,"_5":22186,"_15048":1465,"_1570":36061},[],"Gestión y consulta de listas de revocación para validación offline",{"_7897":1467,"_22053":1465,"_5":22191,"_18699":36063,"_15048":36064,"_1570":36065},[],"/docs/manual/servicios-core/validation-crl#servicio-crl","Servicio CRL",{"_7897":1468,"_22053":1465,"_5":22191,"_18699":36067,"_15048":36068,"_1570":36069},[],"/docs/manual/servicios-core/validation-crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_7897":1469,"_22053":1465,"_5":22191,"_18699":36071,"_15048":36072,"_1570":36073},[],"/docs/manual/servicios-core/validation-crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_7897":1470,"_22053":1465,"_5":22191,"_18699":36075,"_15048":36076,"_1570":36077},[],"/docs/manual/servicios-core/validation-crl#contenido-de-la-crl","Contenido de la CRL",{"_7897":1471,"_22053":1465,"_5":22191,"_18699":36079,"_15048":36080,"_1570":36081},[],"/docs/manual/servicios-core/validation-crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_7897":1472,"_22053":1465,"_5":22191,"_18699":36083,"_15048":36084,"_1570":36085},[],"/docs/manual/servicios-core/validation-crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_7897":1473,"_22053":1465,"_5":22191,"_18699":36087,"_15048":36088,"_1570":36089},[],"/docs/manual/servicios-core/validation-crl#desde-la-interfaz","Desde la interfaz",{"_7897":1474,"_22053":1465,"_5":22191,"_18699":36091,"_15048":36092,"_1570":36093},[],"/docs/manual/servicios-core/validation-crl#referencias","Referencias",{"_7897":1475,"_22053":1465,"_18699":36095,"_5":22186,"_15048":36064,"_1570":36096},[],"Una CRL (*Certificate Revocation List*) es una lista firmada que contiene los números de serie de los certificados revocados antes de su fecha de caducidad. A diferencia de OCSP, no requiere una consulta en tiempo real: la parte que confía descarga la lista periódicamente y la consulta de forma local.",{"_7897":1476,"_22053":1465,"_18699":36098,"_5":22186,"_15048":36064,"_1570":36099},[],"Lamassu genera y mantiene una CRL por cada CA que gestiona. Cada CRL está firmada con la clave privada de la propia CA emisora y se almacena en el sistema de almacenamiento de objetos configurado en la plataforma.",{"_7897":1477,"_22053":1465,"_18699":36101,"_5":22186,"_15048":36068,"_1570":36102},[],"La publicación de la CRL de cada CA se controla mediante un *rol VA*. Este objeto define cómo se genera, cuándo se regenera y qué clave se utiliza para firmarla.",{"_7897":1478,"_22053":1465,"_18699":36104,"_5":22186,"_15048":36068,"_1570":36105},[],"Los parámetros principales son:",{"_7897":1479,"_22053":1465,"_18699":36107,"_5":22186,"_15048":36068,"_1570":33017},[],{"_7897":1480,"_22053":1465,"_18699":36109,"_5":22186,"_15048":36068,"_1570":31886},[],{"_7897":1481,"_22053":1465,"_18699":36111,"_5":22186,"_15048":36068,"_1570":31889},[],{"_7897":1482,"_22053":1465,"_18699":36113,"_5":22186,"_15048":36068,"_1570":36114},[],"`validity`",{"_7897":1483,"_22053":1465,"_18699":36116,"_5":22186,"_15048":36068,"_1570":36117},[],"7 días",{"_7897":1484,"_22053":1465,"_18699":36119,"_5":22186,"_15048":36068,"_1570":36120},[],"Período de validez de cada CRL emitida, reflejado en el campo `nextUpdate`.",{"_7897":1485,"_22053":1465,"_18699":36122,"_5":22186,"_15048":36068,"_1570":36123},[],"`refresh_interval`",{"_7897":1486,"_22053":1465,"_18699":36125,"_5":22186,"_15048":36068,"_1570":36126},[],"\\~6 días y 23 horas",{"_7897":1487,"_22053":1465,"_18699":36128,"_5":22186,"_15048":36068,"_1570":36129},[],"Intervalo mínimo entre regeneraciones periódicas programadas.",{"_7897":1488,"_22053":1465,"_18699":36131,"_5":22186,"_15048":36068,"_1570":36132},[],"`regenerate_on_revoke`",{"_7897":1489,"_22053":1465,"_18699":36134,"_5":22186,"_15048":36068,"_1570":36135},[],"`true`",{"_7897":1490,"_22053":1465,"_18699":36137,"_5":22186,"_15048":36068,"_1570":36138},[],"Cuando se revoca un certificado, se genera una nueva CRL de inmediato sin esperar al ciclo periódico.",{"_7897":1491,"_22053":1465,"_18699":36140,"_5":22186,"_15048":36068,"_1570":36141},[],"El campo `subject_key_id_signer` identifica la CA cuya clave privada firma la CRL. Por defecto, cada CA firma su propia CRL.",{"_7897":1492,"_22053":1465,"_18699":36143,"_5":22186,"_15048":36068,"_1570":36144},[],"Cada CRL lleva un número de versión incremental. Lamassu almacena todas las versiones en la ruta `pki/va/crl/{subject_key_id}/{version}.crl` del almacenamiento de objetos.",{"_7897":1493,"_22053":1465,"_18699":36146,"_5":22186,"_15048":36072,"_1570":36147},[],"Un proceso en segundo plano supervisa los roles VA activos. Cuando la validez restante de la CRL vigente cae por debajo del período de vigilancia configurado (*blind period*), el sistema solicita la generación de una nueva CRL. Así se evita que la CRL publicada caduque sin que exista una versión válida disponible.",{"_7897":1494,"_22053":1465,"_18699":36149,"_5":22186,"_15048":36072,"_1570":36150},[],"Además, cuando `regenerate_on_revoke` está activo, que es el comportamiento por defecto, cualquier revocación de un certificado desencadena inmediatamente la generación de una nueva CRL para la CA afectada. Esto reduce al mínimo el tiempo entre la revocación y su publicación.",{"_7897":1495,"_22053":1465,"_18699":36152,"_5":22186,"_15048":36076,"_1570":36153},[],"Cada entrada de la CRL incluye el número de serie del certificado revocado, la fecha de revocación y el código de razón conforme a RFC 5280.",{"_7897":1496,"_22053":1465,"_18699":36155,"_5":22186,"_15048":36076,"_1570":36156},[],"La CRL incluye también la extensión *Issuing Distribution Point* (IDP, OID 2.5.29.28), marcada como crítica, que indica la URL pública desde la que puede descargarse. Esa URL apunta al endpoint `/crl/{subject_key_id}` de cada dominio VA configurado.",{"_7897":1497,"_22053":1465,"_18699":36158,"_5":22186,"_15048":36080,"_1570":36159},[],"La CRL más reciente de una CA se puede obtener directamente sin autenticación:",{"_7897":1498,"_22053":1465,"_18699":36161,"_5":22186,"_15048":36080,"_1570":36162},[],"La respuesta tiene `Content-Type: application/pkix-crl` y contiene la CRL en formato DER.",{"_7897":1499,"_22053":1465,"_18699":36164,"_5":22186,"_15048":36084,"_1570":36165},[],"El rol VA de una CA se puede consultar y actualizar mediante la API:",{"_7897":1500,"_22053":1465,"_18699":36167,"_5":22186,"_15048":36084,"_1570":36168},[],"Método",{"_7897":1501,"_22053":1465,"_18699":36170,"_5":22186,"_15048":36084,"_1570":36171},[],"Ruta",{"_7897":1502,"_22053":1465,"_18699":36173,"_5":22186,"_15048":36084,"_1570":31889},[],{"_7897":1503,"_22053":1465,"_18699":36175,"_5":22186,"_15048":36084,"_1570":36176},[],"`GET`",{"_7897":1504,"_22053":1465,"_18699":36178,"_5":22186,"_15048":36084,"_1570":36179},[],"`/v1/roles/{ca-ski}`",{"_7897":1505,"_22053":1465,"_18699":36181,"_5":22186,"_15048":36084,"_1570":36182},[],"Devuelve la configuración del rol VA y los metadatos de la última CRL emitida.",{"_7897":1506,"_22053":1465,"_18699":36184,"_5":22186,"_15048":36084,"_1570":36185},[],"`PUT`",{"_7897":1507,"_22053":1465,"_18699":36187,"_5":22186,"_15048":36084,"_1570":36179},[],{"_7897":1508,"_22053":1465,"_18699":36189,"_5":22186,"_15048":36084,"_1570":36190},[],"Actualiza los parámetros de la configuración del rol VA (`validity`, `refresh_interval`, `regenerate_on_revoke`).",{"_7897":1509,"_22053":1465,"_18699":36192,"_5":22186,"_15048":36084,"_1570":36193},[],"Ejemplo de consulta del rol VA:",{"_7897":1510,"_22053":1465,"_18699":36195,"_5":22186,"_15048":36084,"_1570":36196},[],"La respuesta incluye el campo `latest_crl` con la versión, la fecha de inicio de validez y la fecha de caducidad de la CRL actualmente publicada.",{"_7897":1511,"_22053":1465,"_18699":36198,"_5":22186,"_15048":36088,"_1570":36199},[],"Desde el panel de detalle de una CA es posible previsualizar el contenido de la CRL activa y descargarla directamente para su uso offline o para importarla en aplicaciones que realicen validación local.",{"_7897":1512,"_22053":1465,"_18699":36201,"_5":22186,"_15048":36092,"_1570":36202},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile*",{"_7897":1513,"_22053":1465,"_18699":36204,"_5":22186,"_15048":36092,"_1570":36205},[],"<Card title=\"Servicio OCSP\" href=\"/docs/manual/servicios-core/validation-ocsp\" />",{"_7897":1514,"_22053":1465,"_18699":36207,"_5":22186,"_15048":36092,"_1570":36208},[],"<Card title=\"Validación de certificados\" href=\"/docs/manual/servicios-core/validation\" />",{"_7897":1515,"_22053":1515,"_5":22181,"_1570":36210,"_22194":36211,"_18699":36212,"_15048":1515},"[VA] Servicio OCSP",[31686,32785,32794],[],{"_7897":1516,"_22053":1515,"_18699":36214,"_5":22186,"_15048":1515,"_1570":36215},[],"Validación online del estado de certificados mediante OCSP",{"_7897":1517,"_22053":1515,"_5":22191,"_18699":36217,"_15048":36218,"_1570":36219},[],"/docs/manual/servicios-core/validation-ocsp#servicio-ocsp","Servicio OCSP",{"_7897":1518,"_22053":1515,"_5":22191,"_18699":36221,"_15048":36222,"_1570":36223},[],"/docs/manual/servicios-core/validation-ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_7897":1519,"_22053":1515,"_5":22191,"_18699":36225,"_15048":36226,"_1570":36227},[],"/docs/manual/servicios-core/validation-ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_7897":1520,"_22053":1515,"_5":22191,"_18699":36229,"_15048":36230,"_1570":36231},[],"/docs/manual/servicios-core/validation-ocsp#endpoints-http","Endpoints HTTP",{"_7897":1521,"_22053":1515,"_5":22191,"_18699":36233,"_15048":36234,"_1570":36235},[],"/docs/manual/servicios-core/validation-ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_7897":1522,"_22053":1515,"_5":22191,"_18699":36237,"_15048":36238,"_1570":36093},[],"/docs/manual/servicios-core/validation-ocsp#referencias",{"_7897":1523,"_22053":1515,"_18699":36240,"_5":22186,"_15048":36218,"_1570":36241},[],"OCSP (Online Certificate Status Protocol) es el mecanismo que permite a una parte que confía comprobar, en tiempo real, si un certificado concreto está vigente o ha sido revocado. En lugar de descargar una lista completa de certificados revocados, el cliente envía una consulta con el número de serie del certificado y recibe una respuesta firmada con el estado actual.",{"_7897":1524,"_22053":1515,"_18699":36243,"_5":22186,"_15048":36218,"_1570":36244},[],"Lamassu integra un respondedor OCSP propio que atiende estas consultas consultando directamente la base de datos interna de certificados. No se requiere ningún componente externo.",{"_7897":1525,"_22053":1515,"_18699":36246,"_5":22186,"_15048":36222,"_1570":36247},[],"Cuando un cliente solicita el estado de un certificado, el respondedor localiza el certificado por su número de serie y determina su estado según el registro interno:",{"_7897":1526,"_22053":1515,"_18699":36249,"_5":22186,"_15048":36222,"_1570":36250},[],"Si el certificado está activo, la respuesta indica `Good`.",{"_7897":1527,"_22053":1515,"_18699":36252,"_5":22186,"_15048":36222,"_1570":36253},[],"Si el certificado ha sido revocado, la respuesta indica `Revoked` e incluye la marca de tiempo de revocación y el código de razón conforme a RFC 5280.",{"_7897":1528,"_22053":1515,"_18699":36255,"_5":22186,"_15048":36222,"_1570":36256},[],"Si el número de serie no se encuentra o el estado no es reconocible, la respuesta indica `Unknown`.",{"_7897":1529,"_22053":1515,"_18699":36258,"_5":22186,"_15048":36222,"_1570":36259},[],"La respuesta OCSP es firmada por la CA emisora del certificado consultado, utilizando el motor criptográfico asociado a esa CA. Lamassu no utiliza un certificado delegado de firma OCSP: la CA actúa directamente como respondedor.",{"_7897":1530,"_22053":1515,"_18699":36261,"_5":22186,"_15048":36222,"_1570":36262},[],"Cada respuesta tiene una ventana de validez de 24 horas, reflejada en los campos `thisUpdate` y `nextUpdate` de la respuesta. Los clientes que cacheen respuestas deben tener en cuenta esta ventana al determinar durante cuánto tiempo una respuesta sigue siendo válida.",{"_7897":1531,"_22053":1515,"_18699":36264,"_5":22186,"_15048":36226,"_1570":36265},[],"La URL del respondedor OCSP se incorpora automáticamente en la extensión AIA (*Authority Information Access*) de todos los certificados emitidos por Lamassu. Los clientes que verifican certificados pueden leer esta URL directamente del certificado sin necesidad de configuración adicional.",{"_7897":1532,"_22053":1515,"_18699":36267,"_5":22186,"_15048":36230,"_1570":36268},[],"El respondedor acepta consultas en dos formatos, ambos definidos en RFC 6960:",{"_7897":1533,"_22053":1515,"_18699":36270,"_5":22186,"_15048":36230,"_1570":36168},[],{"_7897":1534,"_22053":1515,"_18699":36272,"_5":22186,"_15048":36230,"_1570":36171},[],{"_7897":1535,"_22053":1515,"_18699":36274,"_5":22186,"_15048":36230,"_1570":31889},[],{"_7897":1536,"_22053":1515,"_18699":36276,"_5":22186,"_15048":36230,"_1570":36176},[],{"_7897":1537,"_22053":1515,"_18699":36278,"_5":22186,"_15048":36230,"_1570":36279},[],"`/ocsp/{ocsp_request}`",{"_7897":1538,"_22053":1515,"_18699":36281,"_5":22186,"_15048":36230,"_1570":36282},[],"La petición OCSP va codificada en Base64url en la propia URL.",{"_7897":1539,"_22053":1515,"_18699":36284,"_5":22186,"_15048":36230,"_1570":36285},[],"`POST`",{"_7897":1540,"_22053":1515,"_18699":36287,"_5":22186,"_15048":36230,"_1570":36288},[],"`/ocsp`",{"_7897":1541,"_22053":1515,"_18699":36290,"_5":22186,"_15048":36230,"_1570":36291},[],"La petición OCSP va en el cuerpo de la petición con `Content-Type: application/ocsp-request`.",{"_7897":1542,"_22053":1515,"_18699":36293,"_5":22186,"_15048":36230,"_1570":36294},[],"Ejemplo de consulta con `curl` mediante POST:",{"_7897":1543,"_22053":1515,"_18699":36296,"_5":22186,"_15048":36230,"_1570":36297},[],"La respuesta tiene `Content-Type: application/ocsp-response` y contiene la respuesta OCSP en formato DER.",{"_7897":1544,"_22053":1515,"_18699":36299,"_5":22186,"_15048":36234,"_1570":36300},[],"Desde la pantalla de certificados de Lamassu es posible lanzar una petición OCSP directamente sobre el certificado seleccionado mediante la acción **OCSP Check**. Esta acción muestra el estado devuelto por el respondedor sin necesidad de herramientas externas.",{"_7897":1545,"_22053":1515,"_18699":36302,"_5":22186,"_15048":36238,"_1570":36303},[],"RFC 6960 - *X.509 Internet Public Key Infrastructure Online Certificate Status Protocol – OCSP*",{"_7897":1546,"_22053":1515,"_18699":36305,"_5":22186,"_15048":36238,"_1570":36306},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile* (razones de revocación, sección 5.3.1)",{"_7897":1547,"_22053":1515,"_18699":36308,"_5":22186,"_15048":36238,"_1570":36309},[],"<Card title=\"Servicio CRL\" href=\"/docs/manual/servicios-core/validation-crl\" />",{"_7897":1548,"_22053":1515,"_18699":36311,"_5":22186,"_15048":36238,"_1570":36208},[],{"_7897":1549,"_22053":1549,"_5":22181,"_1570":36313,"_22194":36314,"_18699":36315,"_15048":1549},"[VA] Validación de Certificados",[31686,32785,32794],[],{"_7897":1550,"_22053":1549,"_18699":36317,"_5":22186,"_15048":1549,"_1570":36318},[],"Servicios OCSP y CRL para validación de certificados",{"_7897":1551,"_22053":1549,"_5":22191,"_18699":36320,"_15048":36321,"_1570":36322},[],"/docs/manual/servicios-core/validation#validación-de-certificados--va","Validación de certificados – VA",{"_7897":1552,"_22053":1549,"_18699":36324,"_5":22186,"_15048":36321,"_1570":36325},[],"Lamassu ofrece dos mecanismos complementarios para validar el estado de los certificados emitidos por la plataforma:",{"_7897":1553,"_22053":1549,"_18699":36327,"_5":22186,"_15048":36321,"_1570":36328},[],"`OCSP`, para consultas online y en tiempo real del estado del certificado.",{"_7897":1554,"_22053":1549,"_18699":36330,"_5":22186,"_15048":36321,"_1570":36331},[],"`CRL`, para distribución y consulta offline de listas de revocación.",{"_7897":1555,"_22053":1549,"_18699":36333,"_5":22186,"_15048":36321,"_1570":36334},[],"En el menú lateral del módulo `VA` encontrarás cada capacidad documentada en su propia página.",{"_7897":1556,"_22053":1556,"_5":22181,"_1570":36336,"_18699":36337,"_15048":1556},"Test",[],{"_7897":1557,"_22053":1556,"_18699":36339,"_5":22186,"_15048":1556,"_1570":36340},[],"A document to test Fumadocs",{"_7897":1558,"_22053":1556,"_5":22191,"_18699":36342,"_15048":36343,"_1570":36344},[],"/docs/test#cards","Cards",{"_7897":1559,"_22053":1556,"_5":22191,"_18699":36346,"_15048":36347,"_1570":36348},[],"/docs/test#codeblock","CodeBlock",{"_7897":1560,"_22053":1556,"_5":22191,"_18699":36350,"_15048":36351,"_1570":36352},[],"/docs/test#list","List",{"_7897":1561,"_22053":1556,"_18699":36354,"_5":22186,"_15048":1556,"_1570":36355},[],"Hey there!",{"_7897":1562,"_22053":1556,"_18699":36357,"_5":22186,"_15048":36343,"_1570":36358},[],"<Card title=\"Learn more about Next.js\" href=\"https://nextjs.org/docs\" />",{"_7897":1563,"_22053":1556,"_18699":36360,"_5":22186,"_15048":36343,"_1570":36361},[],"<Card title=\"Learn more about Fumadocs\" href=\"https://fumadocs.dev\" />",{"_7897":1564,"_22053":1556,"_18699":36363,"_5":22186,"_15048":36351,"_1570":36364},[],"Hello",{"_7897":1565,"_22053":1556,"_18699":36366,"_5":22186,"