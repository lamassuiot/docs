946":116006},[],"/docs/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3461":70005,"_30106":70000,"_5":30435,"_20907":116008,"_27392":116009,"_2946":116010},[],"/docs/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3461":70006,"_30106":70000,"_5":30435,"_20907":116012,"_27392":116013,"_2946":116014},[],"/docs/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3461":70007,"_30106":70000,"_5":30435,"_20907":116016,"_27392":116017,"_2946":116018},[],"/docs/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3461":70008,"_30106":70000,"_5":30435,"_20907":116020,"_27392":116021,"_2946":116022},[],"/docs/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3461":70009,"_30106":70000,"_20907":116024,"_5":14363,"_27392":70000,"_2946":116025},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3461":70010,"_30106":70000,"_20907":116027,"_5":14363,"_27392":115997,"_2946":116028},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3461":70011,"_30106":70000,"_20907":116030,"_5":14363,"_27392":115997,"_2946":116031},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3461":70012,"_30106":70000,"_20907":116033,"_5":14363,"_27392":115997,"_2946":116034},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3461":70013,"_30106":70000,"_20907":116036,"_5":14363,"_27392":116001,"_2946":116037},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3461":70014,"_30106":70000,"_20907":116039,"_5":14363,"_27392":116001,"_2946":116040},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3461":70015,"_30106":70000,"_20907":116042,"_5":14363,"_27392":116001,"_2946":116043},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3461":70016,"_30106":70000,"_20907":116045,"_5":14363,"_27392":116005,"_2946":116046},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3461":70017,"_30106":70000,"_20907":116048,"_5":14363,"_27392":116009,"_2946":116049},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3461":70018,"_30106":70000,"_20907":116051,"_5":14363,"_27392":116013,"_2946":116052},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3461":70019,"_30106":70000,"_20907":116054,"_5":14363,"_27392":116017,"_2946":116055},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3461":70020,"_30106":70000,"_20907":116057,"_5":14363,"_27392":116021,"_2946":116058},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3461":70021,"_30106":70021,"_5":14715,"_2946":116060,"_30438":116061,"_20907":116062,"_27392":70021},"Despliega Lamassu",[49125,115989],[],{"_3461":70022,"_30106":70021,"_20907":116064,"_5":14363,"_27392":70021,"_2946":116065},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3461":70023,"_30106":70021,"_5":30435,"_20907":116067,"_27392":116068,"_2946":116069},[],"/docs/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3461":70024,"_30106":70021,"_5":30435,"_20907":116071,"_27392":116072,"_2946":116073},[],"/docs/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3461":70025,"_30106":70021,"_5":30435,"_20907":116075,"_27392":116076,"_2946":116077},[],"/docs/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3461":70026,"_30106":70021,"_20907":116079,"_5":14363,"_27392":70021,"_2946":116080},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3461":70027,"_30106":70021,"_20907":116082,"_5":14363,"_27392":116068,"_2946":116083},[],"Modelo",{"_3461":70028,"_30106":70021,"_20907":116085,"_5":14363,"_27392":116068,"_2946":116086},[],"Recomendado para",{"_3461":70029,"_30106":70021,"_20907":116088,"_5":14363,"_27392":116068,"_2946":116089},[],"Quién opera la infraestructura",{"_3461":70030,"_30106":70021,"_20907":116091,"_5":14363,"_27392":116068,"_2946":116092},[],"Punto de partida",{"_3461":70031,"_30106":70021,"_20907":116094,"_5":14363,"_27392":116068,"_2946":49232},[],{"_3461":70032,"_30106":70021,"_20907":116096,"_5":14363,"_27392":116068,"_2946":116097},[],"Producción, entornos regulados y despliegues personalizados",{"_3461":70033,"_30106":70021,"_20907":116099,"_5":14363,"_27392":116068,"_2946":116100},[],"Tu equipo",{"_3461":70034,"_30106":70021,"_20907":116102,"_5":14363,"_27392":116068,"_2946":116103},[],"Helm o Fastlane",{"_3461":70035,"_30106":70021,"_20907":116105,"_5":14363,"_27392":116068,"_2946":49244},[],{"_3461":70036,"_30106":70021,"_20907":116107,"_5":14363,"_27392":116068,"_2946":116108},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3461":70037,"_30106":70021,"_20907":116110,"_5":14363,"_27392":116068,"_2946":116100},[],{"_3461":70038,"_30106":70021,"_20907":116112,"_5":14363,"_27392":116068,"_2946":116113},[],"Imagen preconfigurada en EC2",{"_3461":70039,"_30106":70021,"_20907":116115,"_5":14363,"_27392":116068,"_2946":49255},[],{"_3461":70040,"_30106":70021,"_20907":116117,"_5":14363,"_27392":116068,"_2946":116118},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3461":70041,"_30106":70021,"_20907":116120,"_5":14363,"_27392":116068,"_2946":49261},[],{"_3461":70042,"_30106":70021,"_20907":116122,"_5":14363,"_27392":116068,"_2946":116123},[],"Suscripción gestionada",{"_3461":70043,"_30106":70021,"_20907":116125,"_5":14363,"_27392":116068,"_2946":116126},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3461":70044,"_30106":70021,"_20907":116128,"_5":14363,"_27392":116068,"_2946":116129},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3461":70045,"_30106":70021,"_20907":116131,"_5":14363,"_27392":116068,"_2946":116132},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3461":70046,"_30106":70021,"_20907":116134,"_5":14363,"_27392":116072,"_2946":116135},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3461":70047,"_30106":70021,"_20907":116137,"_5":14363,"_27392":116076,"_2946":116138},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3461":70048,"_30106":70048,"_5":14715,"_2946":116140,"_30438":116141,"_20907":116142,"_27392":70048},"Utiliza Lamassu como SaaS",[49125,115989,115990],[],{"_3461":70049,"_30106":70048,"_20907":116144,"_5":14363,"_27392":70048,"_2946":116145},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3461":70050,"_30106":70048,"_5":30435,"_20907":116147,"_27392":116148,"_2946":116149},[],"/docs/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3461":70051,"_30106":70048,"_5":30435,"_20907":116151,"_27392":116152,"_2946":116153},[],"/docs/es/deployment/saas#planes","Planes",{"_3461":70052,"_30106":70048,"_5":30435,"_20907":116155,"_27392":116156,"_2946":116157},[],"/docs/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3461":70053,"_30106":70048,"_20907":116159,"_5":14363,"_27392":70048,"_2946":116160},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3461":70054,"_30106":70048,"_20907":116162,"_5":14363,"_27392":116148,"_2946":116163},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3461":70055,"_30106":70048,"_20907":116165,"_5":14363,"_27392":116148,"_2946":116166},[],"Copias de seguridad automáticas.",{"_3461":70056,"_30106":70048,"_20907":116168,"_5":14363,"_27392":116148,"_2946":116169},[],"Actualizaciones de versión.",{"_3461":70057,"_30106":70048,"_20907":116171,"_5":14363,"_27392":116148,"_2946":116172},[],"Soporte técnico y SLA según el plan contratado.",{"_3461":70058,"_30106":70048,"_20907":116174,"_5":14363,"_27392":116152,"_2946":49316},[],{"_3461":70059,"_30106":70048,"_20907":116176,"_5":14363,"_27392":116152,"_2946":116177},[],"Dispositivos",{"_3461":70060,"_30106":70048,"_20907":116179,"_5":14363,"_27392":116152,"_2946":116180},[],"Soporte",{"_3461":70061,"_30106":70048,"_20907":116182,"_5":14363,"_27392":116152,"_2946":49325},[],{"_3461":70062,"_30106":70048,"_20907":116184,"_5":14363,"_27392":116152,"_2946":49328},[],{"_3461":70063,"_30106":70048,"_20907":116186,"_5":14363,"_27392":116152,"_2946":116187},[],"Hasta 1.000",{"_3461":70064,"_30106":70048,"_20907":116189,"_5":14363,"_27392":116152,"_2946":49334},[],{"_3461":70065,"_30106":70048,"_20907":116191,"_5":14363,"_27392":116152,"_2946":116192},[],"99,5 %",{"_3461":70066,"_30106":70048,"_20907":116194,"_5":14363,"_27392":116152,"_2946":49340},[],{"_3461":70067,"_30106":70048,"_20907":116196,"_5":14363,"_27392":116152,"_2946":116197},[],"Hasta 10.000",{"_3461":70068,"_30106":70048,"_20907":116199,"_5":14363,"_27392":116152,"_2946":116200},[],"Email y chat",{"_3461":70069,"_30106":70048,"_20907":116202,"_5":14363,"_27392":116152,"_2946":116203},[],"99,9 %",{"_3461":70070,"_30106":70048,"_20907":116205,"_5":14363,"_27392":116152,"_2946":49352},[],{"_3461":70071,"_30106":70048,"_20907":116207,"_5":14363,"_27392":116152,"_2946":116208},[],"Ilimitados",{"_3461":70072,"_30106":70048,"_20907":116210,"_5":14363,"_27392":116152,"_2946":116211},[],"Dedicado",{"_3461":70073,"_30106":70048,"_20907":116213,"_5":14363,"_27392":116152,"_2946":116214},[],"99,99 %",{"_3461":70074,"_30106":70048,"_20907":116216,"_5":14363,"_27392":116156,"_2946":116217},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3461":70075,"_30106":70048,"_20907":116219,"_5":14363,"_27392":116156,"_2946":116220},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3461":70076,"_30106":70076,"_5":14715,"_2946":49369,"_30438":116222,"_20907":116224,"_27392":70076},[49125,115989,116223],"Kubernetes autogestionado",[],{"_3461":70077,"_30106":70076,"_20907":116226,"_5":14363,"_27392":70076,"_2946":116227},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3461":70078,"_30106":70076,"_5":30435,"_20907":116229,"_27392":116230,"_2946":116231},[],"/docs/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3461":70079,"_30106":70076,"_5":30435,"_20907":116233,"_27392":116234,"_2946":116235},[],"/docs/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3461":70080,"_30106":70076,"_5":30435,"_20907":116237,"_27392":116238,"_2946":116239},[],"/docs/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3461":70081,"_30106":70076,"_5":30435,"_20907":116241,"_27392":116242,"_2946":116243},[],"/docs/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3461":70082,"_30106":70076,"_5":30435,"_20907":116245,"_27392":116246,"_2946":116247},[],"/docs/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3461":70083,"_30106":70076,"_5":30435,"_20907":116249,"_27392":116250,"_2946":116251},[],"/docs/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3461":70084,"_30106":70076,"_5":30435,"_20907":116253,"_27392":116254,"_2946":116255},[],"/docs/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3461":70085,"_30106":70076,"_5":30435,"_20907":116257,"_27392":116258,"_2946":116259},[],"/docs/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3461":70086,"_30106":70076,"_5":30435,"_20907":116261,"_27392":116262,"_2946":116263},[],"/docs/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3461":70087,"_30106":70076,"_5":30435,"_20907":116265,"_27392":116266,"_2946":116267},[],"/docs/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3461":70088,"_30106":70076,"_5":30435,"_20907":116269,"_27392":116270,"_2946":116271},[],"/docs/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3461":70089,"_30106":70076,"_20907":116273,"_5":14363,"_27392":116230,"_2946":116274},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3461":70090,"_30106":70076,"_20907":116276,"_5":14363,"_27392":116230,"_2946":116277},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3461":70091,"_30106":70076,"_20907":116279,"_5":14363,"_27392":116234,"_2946":116280},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3461":70092,"_30106":70076,"_20907":116282,"_5":14363,"_27392":116234,"_2946":116283},[],"Fastlane instala o configura",{"_3461":70093,"_30106":70076,"_20907":116285,"_5":14363,"_27392":116234,"_2946":116286},[],"Tú sigues proporcionando",{"_3461":70094,"_30106":70076,"_20907":116288,"_5":14363,"_27392":116234,"_2946":116289},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3461":70095,"_30106":70076,"_20907":116291,"_5":14363,"_27392":116234,"_2946":116292},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3461":70096,"_30106":70076,"_20907":116294,"_5":14363,"_27392":116234,"_2946":116295},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3461":70097,"_30106":70076,"_20907":116297,"_5":14363,"_27392":116234,"_2946":116298},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3461":70098,"_30106":70076,"_20907":116300,"_5":14363,"_27392":116234,"_2946":116301},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3461":70099,"_30106":70076,"_20907":116303,"_5":14363,"_27392":116234,"_2946":116304},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3461":70100,"_30106":70076,"_20907":116306,"_5":14363,"_27392":116234,"_2946":116307},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3461":70101,"_30106":70076,"_20907":116309,"_5":14363,"_27392":116234,"_2946":116310},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3461":70102,"_30106":70076,"_20907":116312,"_5":14363,"_27392":116234,"_2946":116313},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3461":70103,"_30106":70076,"_20907":116315,"_5":14363,"_27392":116238,"_2946":116316},[],"Necesitas:",{"_3461":70104,"_30106":70076,"_20907":116318,"_5":14363,"_27392":116238,"_2946":116319},[],"un clúster Kubernetes existente",{"_3461":70105,"_30106":70076,"_20907":116321,"_5":14363,"_27392":116238,"_2946":116322},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3461":70106,"_30106":70076,"_20907":116324,"_5":14363,"_27392":116238,"_2946":49471},[],{"_3461":70107,"_30106":70076,"_20907":116326,"_5":14363,"_27392":116238,"_2946":23628},[],{"_3461":70108,"_30106":70076,"_20907":116328,"_5":14363,"_27392":116238,"_2946":116329},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3461":70109,"_30106":70076,"_20907":116331,"_5":14363,"_27392":116238,"_2946":116332},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3461":70110,"_30106":70076,"_20907":116334,"_5":14363,"_27392":116238,"_2946":116335},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3461":70111,"_30106":70076,"_20907":116337,"_5":14363,"_27392":116238,"_2946":116338},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3461":70112,"_30106":70076,"_20907":116340,"_5":14363,"_27392":116238,"_2946":116341},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3461":70113,"_30106":70076,"_20907":116343,"_5":14363,"_27392":116242,"_2946":116344},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3461":70114,"_30106":70076,"_20907":116346,"_5":14363,"_27392":116242,"_2946":116347},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3461":70115,"_30106":70076,"_20907":116349,"_5":14363,"_27392":116246,"_2946":116350},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3461":70116,"_30106":70076,"_20907":116352,"_5":14363,"_27392":116246,"_2946":116353},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3461":70117,"_30106":70076,"_20907":116355,"_5":14363,"_27392":116246,"_2946":116356},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3461":70118,"_30106":70076,"_20907":116358,"_5":14363,"_27392":116246,"_2946":116359},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3461":70119,"_30106":70076,"_20907":116361,"_5":14363,"_27392":116250,"_2946":116362},[],"Opción",{"_3461":70120,"_30106":70076,"_20907":116364,"_5":14363,"_27392":116250,"_2946":116365},[],"Valor predeterminado",{"_3461":70121,"_30106":70076,"_20907":116367,"_5":14363,"_27392":116250,"_2946":116368},[],"Propósito",{"_3461":70122,"_30106":70076,"_20907":116370,"_5":14363,"_27392":116250,"_2946":49518},[],{"_3461":70123,"_30106":70076,"_20907":116372,"_5":14363,"_27392":116250,"_2946":49521},[],{"_3461":70124,"_30106":70076,"_20907":116374,"_5":14363,"_27392":116250,"_2946":116375},[],"Muestra la ayuda",{"_3461":70125,"_30106":70076,"_20907":116377,"_5":14363,"_27392":116250,"_2946":49527},[],{"_3461":70126,"_30106":70076,"_20907":116379,"_5":14363,"_27392":116250,"_2946":116380},[],"contexto actual",{"_3461":70127,"_30106":70076,"_20907":116382,"_5":14363,"_27392":116250,"_2946":116383},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3461":70128,"_30106":70076,"_20907":116385,"_5":14363,"_27392":116250,"_2946":49536},[],{"_3461":70129,"_30106":70076,"_20907":116387,"_5":14363,"_27392":116250,"_2946":6523},[],{"_3461":70130,"_30106":70076,"_20907":116389,"_5":14363,"_27392":116250,"_2946":116390},[],"Omite prompts y genera credenciales para las dependencias",{"_3461":70131,"_30106":70076,"_20907":116392,"_5":14363,"_27392":116250,"_2946":49544},[],{"_3461":70132,"_30106":70076,"_20907":116394,"_5":14363,"_27392":116250,"_2946":49547},[],{"_3461":70133,"_30106":70076,"_20907":116396,"_5":14363,"_27392":116250,"_2946":116397},[],"Namespace de la instalación",{"_3461":70134,"_30106":70076,"_20907":116399,"_5":14363,"_27392":116250,"_2946":49553},[],{"_3461":70135,"_30106":70076,"_20907":116401,"_5":14363,"_27392":116250,"_2946":49556},[],{"_3461":70136,"_30106":70076,"_20907":116403,"_5":14363,"_27392":116250,"_2946":116404},[],"Dominio usado por la UI, OIDC y el certificado",{"_3461":70137,"_30106":70076,"_20907":116406,"_5":14363,"_27392":116250,"_2946":49562},[],{"_3461":70138,"_30106":70076,"_20907":116408,"_5":14363,"_27392":116250,"_2946":15061},[],{"_3461":70139,"_30106":70076,"_20907":116410,"_5":14363,"_27392":116250,"_2946":116411},[],"Versión del chart de Lamassu",{"_3461":70140,"_30106":70076,"_20907":116413,"_5":14363,"_27392":116250,"_2946":49570},[],{"_3461":70141,"_30106":70076,"_20907":116415,"_5":14363,"_27392":116250,"_2946":49573},[],{"_3461":70142,"_30106":70076,"_20907":116417,"_5":14363,"_27392":116250,"_2946":116418},[],"Puerto del listener HTTPS",{"_3461":70143,"_30106":70076,"_20907":116420,"_5":14363,"_27392":116250,"_2946":49579},[],{"_3461":70144,"_30106":70076,"_20907":116422,"_5":14363,"_27392":116250,"_2946":49582},[],{"_3461":70145,"_30106":70076,"_20907":116424,"_5":14363,"_27392":116250,"_2946":116425},[],"Puerto del listener HTTP",{"_3461":70146,"_30106":70076,"_20907":116427,"_5":14363,"_27392":116250,"_2946":49588},[],{"_3461":70147,"_30106":70076,"_20907":116429,"_5":14363,"_27392":116250,"_2946":49521},[],{"_3461":70148,"_30106":70076,"_20907":116431,"_5":14363,"_27392":116250,"_2946":116432},[],"Certificado PEM para TLS downstream",{"_3461":70149,"_30106":70076,"_20907":116434,"_5":14363,"_27392":116250,"_2946":49596},[],{"_3461":70150,"_30106":70076,"_20907":116436,"_5":14363,"_27392":116250,"_2946":49521},[],{"_3461":70151,"_30106":70076,"_20907":116438,"_5":14363,"_27392":116250,"_2946":116439},[],"Clave privada PEM para TLS downstream",{"_3461":70152,"_30106":70076,"_20907":116441,"_5":14363,"_27392":116250,"_2946":49604},[],{"_3461":70153,"_30106":70076,"_20907":116443,"_5":14363,"_27392":116250,"_2946":116444},[],"chart del repositorio",{"_3461":70154,"_30106":70076,"_20907":116446,"_5":14363,"_27392":116250,"_2946":116447},[],"Usa un chart local de Lamassu sin empaquetar",{"_3461":70155,"_30106":70076,"_20907":116449,"_5":14363,"_27392":116250,"_2946":49613},[],{"_3461":70156,"_30106":70076,"_20907":116451,"_5":14363,"_27392":116250,"_2946":116452},[],"detección automática",{"_3461":70157,"_30106":70076,"_20907":116454,"_5":14363,"_27392":116250,"_2946":116455},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3461":70158,"_30106":70076,"_20907":116457,"_5":14363,"_27392":116250,"_2946":49621},[],{"_3461":70159,"_30106":70076,"_20907":116459,"_5":14363,"_27392":116250,"_2946":6523},[],{"_3461":70160,"_30106":70076,"_20907":116461,"_5":14363,"_27392":116250,"_2946":116462},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3461":70161,"_30106":70076,"_20907":116464,"_5":14363,"_27392":116250,"_2946":49629},[],{"_3461":70162,"_30106":70076,"_20907":116466,"_5":14363,"_27392":116250,"_2946":6523},[],{"_3461":70163,"_30106":70076,"_20907":116468,"_5":14363,"_27392":116250,"_2946":116469},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3461":70164,"_30106":70076,"_20907":116471,"_5":14363,"_27392":116250,"_2946":49637},[],{"_3461":70165,"_30106":70076,"_20907":116473,"_5":14363,"_27392":116250,"_2946":6523},[],{"_3461":70166,"_30106":70076,"_20907":116475,"_5":14363,"_27392":116250,"_2946":116476},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3461":70167,"_30106":70076,"_20907":116478,"_5":14363,"_27392":116250,"_2946":49645},[],{"_3461":70168,"_30106":70076,"_20907":116480,"_5":14363,"_27392":116250,"_2946":6523},[],{"_3461":70169,"_30106":70076,"_20907":116482,"_5":14363,"_27392":116250,"_2946":116483},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3461":70170,"_30106":70076,"_20907":116485,"_5":14363,"_27392":116250,"_2946":49653},[],{"_3461":70171,"_30106":70076,"_20907":116487,"_5":14363,"_27392":116250,"_2946":49656},[],{"_3461":70172,"_30106":70076,"_20907":116489,"_5":14363,"_27392":116250,"_2946":116490},[],"Usa otro chart local de SoftHSM",{"_3461":70173,"_30106":70076,"_20907":116492,"_5":14363,"_27392":116250,"_2946":116493},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3461":70174,"_30106":70076,"_20907":116495,"_5":14363,"_27392":116254,"_2946":116496},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3461":70175,"_30106":70076,"_20907":116498,"_5":14363,"_27392":116254,"_2946":116499},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3461":70176,"_30106":70076,"_20907":116501,"_5":14363,"_27392":116254,"_2946":116502},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3461":70177,"_30106":70076,"_20907":116504,"_5":14363,"_27392":116254,"_2946":116505},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3461":70178,"_30106":70076,"_20907":116507,"_5":14363,"_27392":116254,"_2946":116508},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3461":70179,"_30106":70076,"_20907":116510,"_5":14363,"_27392":116254,"_2946":116511},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3461":70180,"_30106":70076,"_20907":116513,"_5":14363,"_27392":116258,"_2946":49683},[],{"_3461":70181,"_30106":70076,"_20907":116515,"_5":14363,"_27392":116258,"_2946":116516},[],"valida las herramientas locales y el clúster seleccionado",{"_3461":70182,"_30106":70076,"_20907":116518,"_5":14363,"_27392":116258,"_2946":116519},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3461":70183,"_30106":70076,"_20907":116521,"_5":14363,"_27392":116258,"_2946":116522},[],"crea el namespace",{"_3461":70184,"_30106":70076,"_20907":116524,"_5":14363,"_27392":116258,"_2946":116525},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3461":70185,"_30106":70076,"_20907":116527,"_5":14363,"_27392":116258,"_2946":116528},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3461":70186,"_30106":70076,"_20907":116530,"_5":14363,"_27392":116258,"_2946":116531},[],"instala RabbitMQ",{"_3461":70187,"_30106":70076,"_20907":116533,"_5":14363,"_27392":116258,"_2946":116534},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3461":70188,"_30106":70076,"_20907":116536,"_5":14363,"_27392":116258,"_2946":116537},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3461":70189,"_30106":70076,"_20907":116539,"_5":14363,"_27392":116258,"_2946":116540},[],"carga datos de ejemplo opcionalmente",{"_3461":70190,"_30106":70076,"_20907":116542,"_5":14363,"_27392":116258,"_2946":116543},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3461":70191,"_30106":70076,"_20907":116545,"_5":14363,"_27392":116262,"_2946":116546},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3461":70192,"_30106":70076,"_20907":116548,"_5":14363,"_27392":116262,"_2946":116549},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3461":70193,"_30106":70076,"_20907":116551,"_5":14363,"_27392":116266,"_2946":116552},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3461":70194,"_30106":70076,"_20907":116554,"_5":14363,"_27392":116266,"_2946":116555},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3461":70195,"_30106":70076,"_20907":116557,"_5":14363,"_27392":116266,"_2946":116558},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3461":70196,"_30106":70076,"_20907":116560,"_5":14363,"_27392":116270,"_2946":116561},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3461":70197,"_30106":70197,"_5":14715,"_2946":116563,"_30438":116564,"_20907":116565,"_27392":70197},"Instala con Helm",[49125,115989,116223],[],{"_3461":70198,"_30106":70197,"_20907":116567,"_5":14363,"_27392":70197,"_2946":116568},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3461":70199,"_30106":70197,"_5":30435,"_20907":116570,"_27392":116571,"_2946":116572},[],"/docs/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3461":70200,"_30106":70197,"_5":30435,"_20907":116574,"_27392":116575,"_2946":116239},[],"/docs/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3461":70201,"_30106":70197,"_5":30435,"_20907":116577,"_27392":116578,"_2946":116579},[],"/docs/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3461":70202,"_30106":70197,"_5":30435,"_20907":116581,"_27392":116582,"_2946":116583},[],"/docs/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3461":70203,"_30106":70197,"_5":30435,"_20907":116585,"_27392":116586,"_2946":116587},[],"/docs/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3461":70204,"_30106":70197,"_5":30435,"_20907":116589,"_27392":116590,"_2946":116591},[],"/docs/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3461":70205,"_30106":70197,"_5":30435,"_20907":116593,"_27392":116594,"_2946":116595},[],"/docs/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3461":70206,"_30106":70197,"_5":30435,"_20907":116597,"_27392":116598,"_2946":116599},[],"/docs/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3461":70207,"_30106":70197,"_5":30435,"_20907":116601,"_27392":116602,"_2946":116603},[],"/docs/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3461":70208,"_30106":70197,"_5":30435,"_20907":116605,"_27392":116606,"_2946":116607},[],"/docs/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3461":70209,"_30106":70197,"_5":30435,"_20907":116609,"_27392":116610,"_2946":116611},[],"/docs/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3461":70210,"_30106":70197,"_20907":116613,"_5":14363,"_27392":116571,"_2946":116614},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3461":70211,"_30106":70197,"_20907":116616,"_5":14363,"_27392":116575,"_2946":116617},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3461":70212,"_30106":70197,"_20907":116619,"_5":14363,"_27392":116575,"_2946":116620},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3461":70213,"_30106":70197,"_20907":116622,"_5":14363,"_27392":116575,"_2946":116623},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3461":70214,"_30106":70197,"_20907":116625,"_5":14363,"_27392":116575,"_2946":116626},[],"un broker RabbitMQ accesible y sus credenciales",{"_3461":70215,"_30106":70197,"_20907":116628,"_5":14363,"_27392":116575,"_2946":116629},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3461":70216,"_30106":70197,"_20907":116631,"_5":14363,"_27392":116575,"_2946":116632},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3461":70217,"_30106":70197,"_20907":116634,"_5":14363,"_27392":116575,"_2946":116635},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3461":70218,"_30106":70197,"_20907":116637,"_5":14363,"_27392":116575,"_2946":116638},[],"una StorageClass y un diseño de tráfico externo",{"_3461":70219,"_30106":70197,"_20907":116640,"_5":14363,"_27392":116575,"_2946":116641},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3461":70220,"_30106":70197,"_20907":116643,"_5":14363,"_27392":116575,"_2946":116644},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3461":70221,"_30106":70197,"_20907":116646,"_5":14363,"_27392":116575,"_2946":116647},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3461":70222,"_30106":70197,"_20907":116649,"_5":14363,"_27392":116578,"_2946":116650},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3461":70223,"_30106":70197,"_20907":116652,"_5":14363,"_27392":116578,"_2946":116653},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3461":70224,"_30106":70197,"_20907":116655,"_5":14363,"_27392":116578,"_2946":116656},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3461":70225,"_30106":70197,"_20907":116658,"_5":14363,"_27392":116582,"_2946":116659},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3461":70226,"_30106":70197,"_20907":116661,"_5":14363,"_27392":116582,"_2946":116662},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3461":70227,"_30106":70197,"_20907":116664,"_5":14363,"_27392":116582,"_2946":116665},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3461":70228,"_30106":70197,"_20907":116667,"_5":14363,"_27392":116582,"_2946":116668},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3461":70229,"_30106":70197,"_20907":116670,"_5":14363,"_27392":116586,"_2946":116671},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3461":70230,"_30106":70197,"_20907":116673,"_5":14363,"_27392":116590,"_2946":116674},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3461":70231,"_30106":70197,"_20907":116676,"_5":14363,"_27392":116590,"_2946":116677},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3461":70232,"_30106":70197,"_20907":116679,"_5":14363,"_27392":116590,"_2946":116680},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3461":70233,"_30106":70197,"_20907":116682,"_5":14363,"_27392":116590,"_2946":116683},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3461":70234,"_30106":70197,"_20907":116685,"_5":14363,"_27392":116590,"_2946":116686},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3461":70235,"_30106":70197,"_20907":116688,"_5":14363,"_27392":116590,"_2946":116689},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3461":70236,"_30106":70197,"_20907":116691,"_5":14363,"_27392":116590,"_2946":116692},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3461":70237,"_30106":70197,"_20907":116694,"_5":14363,"_27392":116594,"_2946":116695},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3461":70238,"_30106":70197,"_20907":116697,"_5":14363,"_27392":116594,"_2946":116698},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3461":70239,"_30106":70197,"_20907":116700,"_5":14363,"_27392":116594,"_2946":116701},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3461":70240,"_30106":70197,"_20907":116703,"_5":14363,"_27392":116594,"_2946":116704},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3461":70241,"_30106":70197,"_20907":116706,"_5":14363,"_27392":116598,"_2946":116707},[],"Para instalar un checkout local:",{"_3461":70242,"_30106":70197,"_20907":116709,"_5":14363,"_27392":116602,"_2946":116710},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3461":70243,"_30106":70197,"_20907":116712,"_5":14363,"_27392":116602,"_2946":116713},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3461":70244,"_30106":70197,"_20907":116715,"_5":14363,"_27392":116606,"_2946":116716},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3461":70245,"_30106":70197,"_20907":116718,"_5":14363,"_27392":116606,"_2946":116719},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3461":70246,"_30106":70197,"_20907":116721,"_5":14363,"_27392":116606,"_2946":116722},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3461":70247,"_30106":70197,"_20907":116724,"_5":14363,"_27392":116606,"_2946":116725},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3461":70248,"_30106":70197,"_20907":116727,"_5":14363,"_27392":116606,"_2946":116728},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3461":70249,"_30106":70197,"_20907":116730,"_5":14363,"_27392":116610,"_2946":116731},[],"Antes de pasar a producción, revisa:",{"_3461":70250,"_30106":70197,"_20907":116733,"_5":14363,"_27392":116610,"_2946":116734},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3461":70251,"_30106":70197,"_20907":116736,"_5":14363,"_27392":116610,"_2946":116737},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3461":70252,"_30106":70197,"_20907":116739,"_5":14363,"_27392":116610,"_2946":116740},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3461":70253,"_30106":70197,"_20907":116742,"_5":14363,"_27392":116610,"_2946":116743},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3461":70254,"_30106":70197,"_20907":116745,"_5":14363,"_27392":116610,"_2946":116746},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3461":70255,"_30106":70197,"_20907":116748,"_5":14363,"_27392":116610,"_2946":116749},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3461":70256,"_30106":70197,"_20907":116751,"_5":14363,"_27392":116610,"_2946":116752},[],"SMTP, observabilidad y entrega de alertas",{"_3461":70257,"_30106":70197,"_20907":116754,"_5":14363,"_27392":116610,"_2946":116755},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3461":70258,"_30106":70197,"_20907":116757,"_5":14363,"_27392":116610,"_2946":116758},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3461":70259,"_30106":70259,"_5":14715,"_2946":116760,"_30438":116761,"_20907":116762,"_27392":70259},"Expón el Gateway",[49125,115989,116223],[],{"_3461":70260,"_30106":70259,"_20907":116764,"_5":14363,"_27392":70259,"_2946":116765},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3461":70261,"_30106":70259,"_5":30435,"_20907":116767,"_27392":116768,"_2946":116769},[],"/docs/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3461":70262,"_30106":70259,"_5":30435,"_20907":116771,"_27392":116772,"_2946":116773},[],"/docs/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3461":70263,"_30106":70259,"_5":30435,"_20907":116775,"_27392":116776,"_2946":116777},[],"/docs/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3461":70264,"_30106":70259,"_5":30435,"_20907":116779,"_27392":116780,"_2946":49951},[],"/docs/es/deployment/self-hosted/networking#k3s",{"_3461":70265,"_30106":70259,"_5":30435,"_20907":116782,"_27392":116783,"_2946":116784},[],"/docs/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3461":70266,"_30106":70259,"_5":30435,"_20907":116786,"_27392":116787,"_2946":116788},[],"/docs/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3461":70267,"_30106":70259,"_5":30435,"_20907":116790,"_27392":116791,"_2946":116792},[],"/docs/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3461":70268,"_30106":70259,"_5":30435,"_20907":116794,"_27392":116795,"_2946":116796},[],"/docs/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3461":70269,"_30106":70259,"_5":30435,"_20907":116798,"_27392":116799,"_2946":116800},[],"/docs/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3461":70270,"_30106":70259,"_5":30435,"_20907":116802,"_27392":116803,"_2946":116804},[],"/docs/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3461":70271,"_30106":70259,"_20907":116806,"_5":14363,"_27392":116768,"_2946":116807},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3461":70272,"_30106":70259,"_20907":116809,"_5":14363,"_27392":116768,"_2946":116810},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3461":70273,"_30106":70259,"_20907":116812,"_5":14363,"_27392":116772,"_2946":116813},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3461":70274,"_30106":70259,"_20907":116815,"_5":14363,"_27392":116772,"_2946":116816},[],"Defínelo únicamente cuando:",{"_3461":70275,"_30106":70259,"_20907":116818,"_5":14363,"_27392":116772,"_2946":116819},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3461":70276,"_30106":70259,"_20907":116821,"_5":14363,"_27392":116772,"_2946":116822},[],"esa dirección está asignada a este Gateway",{"_3461":70277,"_30106":70259,"_20907":116824,"_5":14363,"_27392":116772,"_2946":116825},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3461":70278,"_30106":70259,"_20907":116827,"_5":14363,"_27392":116772,"_2946":116828},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3461":70279,"_30106":70259,"_20907":116830,"_5":14363,"_27392":116772,"_2946":116831},[],"No confundas estos valores:",{"_3461":70280,"_30106":70259,"_20907":116833,"_5":14363,"_27392":116772,"_2946":116834},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3461":70281,"_30106":70259,"_20907":116836,"_5":14363,"_27392":116772,"_2946":116837},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3461":70282,"_30106":70259,"_20907":116839,"_5":14363,"_27392":116772,"_2946":116840},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3461":70283,"_30106":70259,"_20907":116842,"_5":14363,"_27392":116776,"_2946":116843},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3461":70284,"_30106":70259,"_20907":116845,"_5":14363,"_27392":116776,"_2946":116846},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3461":70285,"_30106":70259,"_20907":116848,"_5":14363,"_27392":116780,"_2946":116849},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3461":70286,"_30106":70259,"_20907":116851,"_5":14363,"_27392":116780,"_2946":116852},[],"Para el diseño recomendado:",{"_3461":70287,"_30106":70259,"_20907":116854,"_5":14363,"_27392":116780,"_2946":116855},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3461":70288,"_30106":70259,"_20907":116857,"_5":14363,"_27392":116780,"_2946":116858},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3461":70289,"_30106":70259,"_20907":116860,"_5":14363,"_27392":116780,"_2946":116861},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3461":70290,"_30106":70259,"_20907":116863,"_5":14363,"_27392":116780,"_2946":116864},[],"Apunta DNS a la dirección accesible de la VM.",{"_3461":70291,"_30106":70259,"_20907":116866,"_5":14363,"_27392":116780,"_2946":116867},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3461":70292,"_30106":70259,"_20907":116869,"_5":14363,"_27392":116783,"_2946":116870},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3461":70293,"_30106":70259,"_20907":116872,"_5":14363,"_27392":116787,"_2946":116873},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3461":70294,"_30106":70259,"_20907":116875,"_5":14363,"_27392":116787,"_2946":116876},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3461":70295,"_30106":70259,"_20907":116878,"_5":14363,"_27392":116791,"_2946":116879},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3461":70296,"_30106":70259,"_20907":116881,"_5":14363,"_27392":116791,"_2946":116882},[],"Requisito",{"_3461":70297,"_30106":70259,"_20907":116884,"_5":14363,"_27392":116791,"_2946":116885},[],"Diseño recomendado",{"_3461":70298,"_30106":70259,"_20907":116887,"_5":14363,"_27392":116791,"_2946":116888},[],"Consecuencia",{"_3461":70299,"_30106":70259,"_20907":116890,"_5":14363,"_27392":116791,"_2946":116891},[],"Varias URL o servicios de Lamassu",{"_3461":70300,"_30106":70259,"_20907":116893,"_5":14363,"_27392":116791,"_2946":116894},[],"Un Gateway con varias rutas",{"_3461":70301,"_30106":70259,"_20907":116896,"_5":14363,"_27392":116791,"_2946":116897},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3461":70302,"_30106":70259,"_20907":116899,"_5":14363,"_27392":116791,"_2946":116900},[],"Gateways independientes e IP externas distintas",{"_3461":70303,"_30106":70259,"_20907":116902,"_5":14363,"_27392":116791,"_2946":116903},[],"Una VIP por Gateway",{"_3461":70304,"_30106":70259,"_20907":116905,"_5":14363,"_27392":116791,"_2946":116906},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3461":70305,"_30106":70259,"_20907":116908,"_5":14363,"_27392":116791,"_2946":116909},[],"Gateways independientes, un nodo y una IP",{"_3461":70306,"_30106":70259,"_20907":116911,"_5":14363,"_27392":116791,"_2946":116912},[],"Puertos externos diferentes",{"_3461":70307,"_30106":70259,"_20907":116914,"_5":14363,"_27392":116791,"_2946":116915},[],"Los clientes deben indicar puertos no estándar",{"_3461":70308,"_30106":70259,"_20907":116917,"_5":14363,"_27392":116791,"_2946":116918},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3461":70309,"_30106":70259,"_20907":116920,"_5":14363,"_27392":116791,"_2946":116921},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3461":70310,"_30106":70259,"_20907":116923,"_5":14363,"_27392":116791,"_2946":116924},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3461":70311,"_30106":70259,"_20907":116926,"_5":14363,"_27392":116791,"_2946":116927},[],"Recursos Gateway separados pero proxy compartido",{"_3461":70312,"_30106":70259,"_20907":116929,"_5":14363,"_27392":116791,"_2946":116930},[],"Modo merged Gateway de Envoy",{"_3461":70313,"_30106":70259,"_20907":116932,"_5":14363,"_27392":116791,"_2946":116933},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3461":70314,"_30106":70259,"_20907":116935,"_5":14363,"_27392":116791,"_2946":116936},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3461":70315,"_30106":70259,"_20907":116938,"_5":14363,"_27392":116791,"_2946":116939},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3461":70316,"_30106":70259,"_20907":116941,"_5":14363,"_27392":116791,"_2946":116942},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3461":70317,"_30106":70259,"_20907":116944,"_5":14363,"_27392":116791,"_2946":116945},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3461":70318,"_30106":70259,"_20907":116947,"_5":14363,"_27392":116795,"_2946":116948},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3461":70319,"_30106":70259,"_20907":116950,"_5":14363,"_27392":116795,"_2946":116951},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3461":70320,"_30106":70259,"_20907":116953,"_5":14363,"_27392":116795,"_2946":116954},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3461":70321,"_30106":70259,"_20907":116956,"_5":14363,"_27392":116795,"_2946":116957},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3461":70322,"_30106":70259,"_20907":116959,"_5":14363,"_27392":116795,"_2946":116960},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3461":70323,"_30106":70259,"_20907":116962,"_5":14363,"_27392":116799,"_2946":116963},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3461":70324,"_30106":70259,"_20907":116965,"_5":14363,"_27392":116799,"_2946":116966},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3461":70325,"_30106":70259,"_20907":116968,"_5":14363,"_27392":116803,"_2946":116969},[],"Comprueba, en orden:",{"_3461":70326,"_30106":70259,"_20907":116971,"_5":14363,"_27392":116803,"_2946":116972},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3461":70327,"_30106":70259,"_20907":116974,"_5":14363,"_27392":116803,"_2946":116975},[],"Su estado contiene la dirección esperada.",{"_3461":70328,"_30106":70259,"_20907":116977,"_5":14363,"_27392":116803,"_2946":116978},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3461":70329,"_30106":70259,"_20907":116980,"_5":14363,"_27392":116803,"_2946":116981},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3461":70330,"_30106":70259,"_20907":116983,"_5":14363,"_27392":116803,"_2946":116984},[],"DNS resuelve al endpoint accesible externamente.",{"_3461":70331,"_30106":70259,"_20907":116986,"_5":14363,"_27392":116803,"_2946":116987},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3461":70332,"_30106":70259,"_20907":116989,"_5":14363,"_27392":116803,"_2946":116990},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3461":70333,"_30106":70333,"_5":14715,"_2946":49232,"_30438":116992,"_20907":116993,"_27392":70333},[49125,115989,116223],[],{"_3461":70334,"_30106":70333,"_20907":116995,"_5":14363,"_27392":70333,"_2946":116996},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3461":70335,"_30106":70333,"_5":30435,"_20907":116998,"_27392":116999,"_2946":117000},[],"/docs/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3461":70336,"_30106":70333,"_5":30435,"_20907":117002,"_27392":117003,"_2946":117004},[],"/docs/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3461":70337,"_30106":70333,"_5":30435,"_20907":117006,"_27392":117007,"_2946":117008},[],"/docs/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3461":70338,"_30106":70333,"_5":30435,"_20907":117010,"_27392":117011,"_2946":117012},[],"/docs/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3461":70339,"_30106":70333,"_5":30435,"_20907":117014,"_27392":117015,"_2946":117016},[],"/docs/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3461":70340,"_30106":70333,"_5":30435,"_20907":117018,"_27392":117019,"_2946":117020},[],"/docs/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3461":70341,"_30106":70333,"_20907":117022,"_5":14363,"_27392":116999,"_2946":117023},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3461":70342,"_30106":70333,"_20907":117025,"_5":14363,"_27392":117003,"_2946":117026},[],"Flujo",{"_3461":70343,"_30106":70333,"_20907":117028,"_5":14363,"_27392":117003,"_2946":117029},[],"Úsalo para",{"_3461":70344,"_30106":70333,"_20907":117031,"_5":14363,"_27392":117003,"_2946":117032},[],"Qué instala",{"_3461":70345,"_30106":70333,"_20907":117034,"_5":14363,"_27392":117003,"_2946":50206},[],{"_3461":70346,"_30106":70333,"_20907":117036,"_5":14363,"_27392":117003,"_2946":117037},[],"Producción y entornos controlados",{"_3461":70347,"_30106":70333,"_20907":117039,"_5":14363,"_27392":117003,"_2946":117040},[],"Servicios de Lamassu y recursos de Gateway API",{"_3461":70348,"_30106":70333,"_20907":117042,"_5":14363,"_27392":117003,"_2946":49369},[],{"_3461":70349,"_30106":70333,"_20907":117044,"_5":14363,"_27392":117003,"_2946":117045},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3461":70350,"_30106":70333,"_20907":117047,"_5":14363,"_27392":117003,"_2946":117048},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3461":70351,"_30106":70333,"_20907":117050,"_5":14363,"_27392":117007,"_2946":117051},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3461":70352,"_30106":70333,"_20907":117053,"_5":14363,"_27392":117007,"_2946":117054},[],"Área",{"_3461":70353,"_30106":70333,"_20907":117056,"_5":14363,"_27392":117007,"_2946":117057},[],"El chart de Lamassu proporciona",{"_3461":70354,"_30106":70333,"_20907":117059,"_5":14363,"_27392":117007,"_2946":117060},[],"Tú proporcionas",{"_3461":70355,"_30106":70333,"_20907":117062,"_5":14363,"_27392":117007,"_2946":117063},[],"Aplicaciones Lamassu",{"_3461":70356,"_30106":70333,"_20907":117065,"_5":14363,"_27392":117007,"_2946":117066},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3461":70357,"_30106":70333,"_20907":117068,"_5":14363,"_27392":117007,"_2946":117069},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3461":70358,"_30106":70333,"_20907":117071,"_5":14363,"_27392":117007,"_2946":117072},[],"Datos PostgreSQL",{"_3461":70359,"_30106":70333,"_20907":117074,"_5":14363,"_27392":117007,"_2946":117075},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3461":70360,"_30106":70333,"_20907":117077,"_5":14363,"_27392":117007,"_2946":117078},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3461":70361,"_30106":70333,"_20907":117080,"_5":14363,"_27392":117007,"_2946":117081},[],"Mensajería",{"_3461":70362,"_30106":70333,"_20907":117083,"_5":14363,"_27392":117007,"_2946":117084},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3461":70363,"_30106":70333,"_20907":117086,"_5":14363,"_27392":117007,"_2946":117087},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3461":70364,"_30106":70333,"_20907":117089,"_5":14363,"_27392":117007,"_2946":117090},[],"Identidad",{"_3461":70365,"_30106":70333,"_20907":117092,"_5":14363,"_27392":117007,"_2946":117093},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3461":70366,"_30106":70333,"_20907":117095,"_5":14363,"_27392":117007,"_2946":117096},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3461":70367,"_30106":70333,"_20907":117098,"_5":14363,"_27392":117007,"_2946":117099},[],"Enrutamiento externo",{"_3461":70368,"_30106":70333,"_20907":117101,"_5":14363,"_27392":117007,"_2946":117102},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3461":70369,"_30106":70333,"_20907":117104,"_5":14363,"_27392":117007,"_2946":117105},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3461":70370,"_30106":70333,"_20907":117107,"_5":14363,"_27392":117007,"_2946":50280},[],{"_3461":70371,"_30106":70333,"_20907":117109,"_5":14363,"_27392":117007,"_2946":117110},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3461":70372,"_30106":70333,"_20907":117112,"_5":14363,"_27392":117007,"_2946":117113},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3461":70373,"_30106":70333,"_20907":117115,"_5":14363,"_27392":117007,"_2946":117116},[],"Datos persistentes de la aplicación",{"_3461":70374,"_30106":70333,"_20907":117118,"_5":14363,"_27392":117007,"_2946":117119},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3461":70375,"_30106":70333,"_20907":117121,"_5":14363,"_27392":117007,"_2946":117122},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3461":70376,"_30106":70333,"_20907":117124,"_5":14363,"_27392":117007,"_2946":117125},[],"Integraciones opcionales",{"_3461":70377,"_30106":70333,"_20907":117127,"_5":14363,"_27392":117007,"_2946":117128},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3461":70378,"_30106":70333,"_20907":117130,"_5":14363,"_27392":117007,"_2946":117131},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3461":70379,"_30106":70333,"_20907":117133,"_5":14363,"_27392":117007,"_2946":117134},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3461":70380,"_30106":70333,"_20907":117136,"_5":14363,"_27392":117007,"_2946":117137},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3461":70381,"_30106":70333,"_20907":117139,"_5":14363,"_27392":117011,"_2946":117140},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3461":70382,"_30106":70333,"_20907":117142,"_5":14363,"_27392":117011,"_2946":117143},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3461":70383,"_30106":70333,"_20907":117145,"_5":14363,"_27392":117015,"_2946":117146},[],"Kubernetes 1.24 o posterior",{"_3461":70384,"_30106":70333,"_20907":117148,"_5":14363,"_27392":117015,"_2946":117149},[],"Helm 3.2 o posterior",{"_3461":70385,"_30106":70333,"_20907":117151,"_5":14363,"_27392":117015,"_2946":117152},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3461":70386,"_30106":70333,"_20907":117154,"_5":14363,"_27392":117015,"_2946":117155},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3461":70387,"_30106":70333,"_20907":117157,"_5":14363,"_27392":117015,"_2946":117158},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3461":70388,"_30106":70333,"_20907":117160,"_5":14363,"_27392":117015,"_2946":117161},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3461":70389,"_30106":70333,"_20907":117163,"_5":14363,"_27392":117015,"_2946":117164},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3461":70390,"_30106":70333,"_20907":117166,"_5":14363,"_27392":117019,"_2946":117167},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3461":70391,"_30106":70333,"_20907":117169,"_5":14363,"_27392":117019,"_2946":117170},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3461":70392,"_30106":70333,"_20907":117172,"_5":14363,"_27392":117019,"_2946":117173},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3461":70393,"_30106":70333,"_20907":117175,"_5":14363,"_27392":117019,"_2946":117176},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3461":70394,"_30106":70394,"_5":14715,"_2946":117178,"_30438":117179,"_20907":117181,"_27392":70394},"Resolución de problemas de despliegue",[49125,115989,117180],"Operación",[],{"_3461":70395,"_30106":70394,"_20907":117183,"_5":14363,"_27392":70394,"_2946":117184},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3461":70396,"_30106":70394,"_5":30435,"_20907":117186,"_27392":117187,"_2946":117188},[],"/docs/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3461":70397,"_30106":70394,"_5":30435,"_20907":117190,"_27392":117191,"_2946":117192},[],"/docs/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3461":70398,"_30106":70394,"_5":30435,"_20907":117194,"_27392":117195,"_2946":117196},[],"/docs/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3461":70399,"_30106":70394,"_5":30435,"_20907":117198,"_27392":117199,"_2946":117200},[],"/docs/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3461":70400,"_30106":70394,"_5":30435,"_20907":117202,"_27392":117203,"_2946":117204},[],"/docs/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3461":70401,"_30106":70394,"_5":30435,"_20907":117206,"_27392":117207,"_2946":117208},[],"/docs/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3461":70402,"_30106":70394,"_5":30435,"_20907":117210,"_27392":117211,"_2946":117212},[],"/docs/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3461":70403,"_30106":70394,"_5":30435,"_20907":117214,"_27392":117215,"_2946":117216},[],"/docs/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3461":70404,"_30106":70394,"_5":30435,"_20907":117218,"_27392":117219,"_2946":117220},[],"/docs/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3461":70405,"_30106":70394,"_5":30435,"_20907":117222,"_27392":117223,"_2946":117224},[],"/docs/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3461":70406,"_30106":70394,"_5":30435,"_20907":117226,"_27392":117227,"_2946":117228},[],"/docs/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3461":70407,"_30106":70394,"_5":30435,"_20907":117230,"_27392":117231,"_2946":117232},[],"/docs/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3461":70408,"_30106":70394,"_5":30435,"_20907":117234,"_27392":117235,"_2946":117236},[],"/docs/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3461":70409,"_30106":70394,"_20907":117238,"_5":14363,"_27392":70394,"_2946":117239},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3461":70410,"_30106":70394,"_20907":117241,"_5":14363,"_27392":117191,"_2946":117242},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3461":70411,"_30106":70394,"_20907":117244,"_5":14363,"_27392":117195,"_2946":117245},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3461":70412,"_30106":70394,"_20907":117247,"_5":14363,"_27392":117199,"_2946":117248},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3461":70413,"_30106":70394,"_20907":117250,"_5":14363,"_27392":117203,"_2946":117251},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3461":70414,"_30106":70394,"_20907":117253,"_5":14363,"_27392":117207,"_2946":117254},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3461":70415,"_30106":70394,"_20907":117256,"_5":14363,"_27392":117211,"_2946":117257},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3461":70416,"_30106":70394,"_20907":117259,"_5":14363,"_27392":117211,"_2946":117260},[],"Ejecuta también la prueba de conectividad del chart:",{"_3461":70417,"_30106":70394,"_20907":117262,"_5":14363,"_27392":117211,"_2946":117263},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3461":70418,"_30106":70394,"_20907":117265,"_5":14363,"_27392":117211,"_2946":117266},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3461":70419,"_30106":70394,"_20907":117268,"_5":14363,"_27392":117215,"_2946":117269},[],"Si recibes un 401:",{"_3461":70420,"_30106":70394,"_20907":117271,"_5":14363,"_27392":117215,"_2946":117272},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3461":70421,"_30106":70394,"_20907":117274,"_5":14363,"_27392":117215,"_2946":117275},[],"verifica emisor, audiencia y expiración del token;",{"_3461":70422,"_30106":70394,"_20907":117277,"_5":14363,"_27392":117215,"_2946":117278},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3461":70423,"_30106":70394,"_20907":117280,"_5":14363,"_27392":117215,"_2946":117281},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3461":70424,"_30106":70394,"_20907":117283,"_5":14363,"_27392":117215,"_2946":117284},[],"Si el login termina pero las APIs devuelven 403:",{"_3461":70425,"_30106":70394,"_20907":117286,"_5":14363,"_27392":117215,"_2946":117287},[],"inspecciona los claims reales del token;",{"_3461":70426,"_30106":70394,"_20907":117289,"_5":14363,"_27392":117215,"_2946":117290},[],"confirma que coinciden con un principal activo;",{"_3461":70427,"_30106":70394,"_20907":117292,"_5":14363,"_27392":117215,"_2946":117293},[],"revisa las políticas concedidas al principal;",{"_3461":70428,"_30106":70394,"_20907":117295,"_5":14363,"_27392":117215,"_2946":117296},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3461":70429,"_30106":70394,"_20907":117298,"_5":14363,"_27392":117215,"_2946":117299},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3461":70430,"_30106":70394,"_20907":117301,"_5":14363,"_27392":117219,"_2946":117302},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3461":70431,"_30106":70394,"_20907":117304,"_5":14363,"_27392":117219,"_2946":117305},[],"Localiza el pod y Service de authz.",{"_3461":70432,"_30106":70394,"_20907":117307,"_5":14363,"_27392":117219,"_2946":117308},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3461":70433,"_30106":70394,"_20907":117310,"_5":14363,"_27392":117219,"_2946":117311},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3461":70434,"_30106":70394,"_20907":117313,"_5":14363,"_27392":117219,"_2946":117314},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3461":70435,"_30106":70394,"_20907":117316,"_5":14363,"_27392":117219,"_2946":117317},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3461":70436,"_30106":70394,"_20907":117319,"_5":14363,"_27392":117223,"_2946":117320},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3461":70437,"_30106":70394,"_20907":117322,"_5":14363,"_27392":117227,"_2946":117323},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3461":70438,"_30106":70394,"_20907":117325,"_5":14363,"_27392":117227,"_2946":117326},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3461":70439,"_30106":70394,"_20907":117328,"_5":14363,"_27392":117227,"_2946":117329},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3461":70440,"_30106":70394,"_20907":117331,"_5":14363,"_27392":117227,"_2946":117332},[],"volumen persistente sin enlazar;",{"_3461":70441,"_30106":70394,"_20907":117334,"_5":14363,"_27392":117227,"_2946":117335},[],"imagen inaccesible o política de pull incorrecta;",{"_3461":70442,"_30106":70394,"_20907":117337,"_5":14363,"_27392":117227,"_2946":117338},[],"configuración inválida del motor criptográfico;",{"_3461":70443,"_30106":70394,"_20907":117340,"_5":14363,"_27392":117227,"_2946":117341},[],"límites de CPU o memoria demasiado bajos;",{"_3461":70444,"_30106":70394,"_20907":117343,"_5":14363,"_27392":117227,"_2946":117344},[],"migración previa incompleta.",{"_3461":70445,"_30106":70394,"_20907":117346,"_5":14363,"_27392":117227,"_2946":117347},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3461":70446,"_30106":70394,"_20907":117349,"_5":14363,"_27392":117227,"_2946":117350},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3461":70447,"_30106":70394,"_20907":117352,"_5":14363,"_27392":117227,"_2946":117353},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3461":70448,"_30106":70394,"_20907":117355,"_5":14363,"_27392":117231,"_2946":117356},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3461":70449,"_30106":70394,"_20907":117358,"_5":14363,"_27392":117231,"_2946":117359},[],"verifica que esté habilitado en el servicio emisor;",{"_3461":70450,"_30106":70394,"_20907":117361,"_5":14363,"_27392":117231,"_2946":117362},[],"comprueba conectividad y credenciales AMQP;",{"_3461":70451,"_30106":70394,"_20907":117364,"_5":14363,"_27392":117231,"_2946":117365},[],"revisa exchange, routing key, colas y consumidores;",{"_3461":70452,"_30106":70394,"_20907":117367,"_5":14363,"_27392":117231,"_2946":117368},[],"inspecciona dead-letter queues;",{"_3461":70453,"_30106":70394,"_20907":117370,"_5":14363,"_27392":117231,"_2946":117371},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3461":70454,"_30106":70394,"_20907":117373,"_5":14363,"_27392":117231,"_2946":117374},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3461":70455,"_30106":70394,"_20907":117376,"_5":14363,"_27392":117231,"_2946":117377},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3461":70456,"_30106":70394,"_20907":117379,"_5":14363,"_27392":117231,"_2946":117380},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3461":70457,"_30106":70394,"_20907":117382,"_5":14363,"_27392":117231,"_2946":117383},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3461":70458,"_30106":70394,"_20907":117385,"_5":14363,"_27392":117231,"_2946":117386},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3461":70459,"_30106":70394,"_20907":117388,"_5":14363,"_27392":117231,"_2946":117389},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3461":70460,"_30106":70394,"_20907":117391,"_5":14363,"_27392":117231,"_2946":117392},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3461":70461,"_30106":70394,"_20907":117394,"_5":14363,"_27392":117235,"_2946":117395},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3461":70462,"_30106":70394,"_20907":117397,"_5":14363,"_27392":117235,"_2946":117398},[],"Antes de cerrar una incidencia, guarda:",{"_3461":70463,"_30106":70394,"_20907":117400,"_5":14363,"_27392":117235,"_2946":117401},[],"causa confirmada;",{"_3461":70464,"_30106":70394,"_20907":117403,"_5":14363,"_27392":117235,"_2946":117404},[],"alcance temporal y recursos afectados;",{"_3461":70465,"_30106":70394,"_20907":117406,"_5":14363,"_27392":117235,"_2946":117407},[],"comandos o consultas utilizados;",{"_3461":70466,"_30106":70394,"_20907":117409,"_5":14363,"_27392":117235,"_2946":117410},[],"cambio aplicado y forma de revertirlo;",{"_3461":70467,"_30106":70394,"_20907":117412,"_5":14363,"_27392":117235,"_2946":117413},[],"validación desde un consumidor;",{"_3461":70468,"_30106":70394,"_20907":117415,"_5":14363,"_27392":117235,"_2946":117416},[],"acción preventiva y propietario.",{"_3461":70469,"_30106":70469,"_5":14715,"_2946":117418,"_30438":117419,"_20907":117422,"_27392":70469},"Control de acceso",[49125,117420,117421],"Plataforma","Administración",[],{"_3461":70470,"_30106":70469,"_20907":117424,"_5":14363,"_27392":70469,"_2946":117425},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3461":70471,"_30106":70469,"_5":30435,"_20907":117427,"_27392":117428,"_2946":117429},[],"/docs/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3461":70472,"_30106":70469,"_5":30435,"_20907":117431,"_27392":117432,"_2946":117433},[],"/docs/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3461":70473,"_30106":70469,"_5":30435,"_20907":117435,"_27392":117436,"_2946":117437},[],"/docs/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3461":70474,"_30106":70469,"_5":30435,"_20907":117439,"_27392":117440,"_2946":117441},[],"/docs/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3461":70475,"_30106":70469,"_5":30435,"_20907":117443,"_27392":117444,"_2946":117445},[],"/docs/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3461":70476,"_30106":70469,"_5":30435,"_20907":117447,"_27392":117448,"_2946":117449},[],"/docs/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3461":70477,"_30106":70469,"_5":30435,"_20907":117451,"_27392":117452,"_2946":117453},[],"/docs/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3461":70478,"_30106":70469,"_5":30435,"_20907":117455,"_27392":117456,"_2946":117457},[],"/docs/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3461":70479,"_30106":70469,"_5":30435,"_20907":117459,"_27392":117460,"_2946":117461},[],"/docs/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3461":70480,"_30106":70469,"_5":30435,"_20907":117463,"_27392":117464,"_2946":117465},[],"/docs/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3461":70481,"_30106":70469,"_5":30435,"_20907":117467,"_27392":117468,"_2946":117469},[],"/docs/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3461":70482,"_30106":70469,"_5":30435,"_20907":117471,"_27392":117472,"_2946":117473},[],"/docs/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3461":70483,"_30106":70469,"_5":30435,"_20907":117475,"_27392":117476,"_2946":117477},[],"/docs/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3461":70484,"_30106":70469,"_5":30435,"_20907":117479,"_27392":117480,"_2946":117481},[],"/docs/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3461":70485,"_30106":70469,"_5":30435,"_20907":117483,"_27392":117484,"_2946":117485},[],"/docs/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3461":70486,"_30106":70469,"_5":30435,"_20907":117487,"_27392":117488,"_2946":116595},[],"/docs/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3461":70487,"_30106":70469,"_5":30435,"_20907":117490,"_27392":117491,"_2946":117492},[],"/docs/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3461":70488,"_30106":70469,"_5":30435,"_20907":117494,"_27392":117495,"_2946":117496},[],"/docs/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3461":70489,"_30106":70469,"_5":30435,"_20907":117498,"_27392":117499,"_2946":117500},[],"/docs/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3461":70490,"_30106":70469,"_5":30435,"_20907":117502,"_27392":117503,"_2946":117504},[],"/docs/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3461":70491,"_30106":70469,"_5":30435,"_20907":117506,"_27392":117507,"_2946":117508},[],"/docs/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3461":70492,"_30106":70469,"_5":30435,"_20907":117510,"_27392":117511,"_2946":117512},[],"/docs/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3461":70493,"_30106":70469,"_5":30435,"_20907":117514,"_27392":117515,"_2946":117516},[],"/docs/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3461":70494,"_30106":70469,"_5":30435,"_20907":117518,"_27392":117519,"_2946":117520},[],"/docs/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3461":70495,"_30106":70469,"_5":30435,"_20907":117522,"_27392":117523,"_2946":117524},[],"/docs/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3461":70496,"_30106":70469,"_5":30435,"_20907":117526,"_27392":117527,"_2946":117528},[],"/docs/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3461":70497,"_30106":70469,"_5":30435,"_20907":117530,"_27392":117531,"_2946":117532},[],"/docs/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3461":70498,"_30106":70469,"_5":30435,"_20907":117534,"_27392":117535,"_2946":117536},[],"/docs/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3461":70499,"_30106":70469,"_5":30435,"_20907":117538,"_27392":117539,"_2946":117540},[],"/docs/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3461":70500,"_30106":70469,"_5":30435,"_20907":117542,"_27392":117543,"_2946":117544},[],"/docs/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3461":70501,"_30106":70469,"_5":30435,"_20907":117546,"_27392":117547,"_2946":117548},[],"/docs/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3461":70502,"_30106":70469,"_20907":117550,"_5":14363,"_27392":70469,"_2946":117551},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3461":70503,"_30106":70469,"_20907":117553,"_5":14363,"_27392":70469,"_2946":117554},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3461":70504,"_30106":70469,"_20907":117556,"_5":14363,"_27392":70469,"_2946":117557},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3461":70505,"_30106":70469,"_20907":117559,"_5":14363,"_27392":117428,"_2946":117560},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3461":70506,"_30106":70469,"_20907":117562,"_5":14363,"_27392":117428,"_2946":117563},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3461":70507,"_30106":70469,"_20907":117565,"_5":14363,"_27392":117428,"_2946":117566},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3461":70508,"_30106":70469,"_20907":117568,"_5":14363,"_27392":117428,"_2946":117569},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3461":70509,"_30106":70469,"_20907":117571,"_5":14363,"_27392":117428,"_2946":117572},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3461":70510,"_30106":70469,"_20907":117574,"_5":14363,"_27392":117428,"_2946":117575},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3461":70511,"_30106":70469,"_20907":117577,"_5":14363,"_27392":117432,"_2946":117578},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3461":70512,"_30106":70469,"_20907":117580,"_5":14363,"_27392":117432,"_2946":117581},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3461":70513,"_30106":70469,"_20907":117583,"_5":14363,"_27392":117436,"_2946":117584},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3461":70514,"_30106":70469,"_20907":117586,"_5":14363,"_27392":117436,"_2946":117587},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3461":70515,"_30106":70469,"_20907":117589,"_5":14363,"_27392":117436,"_2946":117590},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3461":70516,"_30106":70469,"_20907":117592,"_5":14363,"_27392":117436,"_2946":117593},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3461":70517,"_30106":70469,"_20907":117595,"_5":14363,"_27392":117436,"_2946":117596},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3461":70518,"_30106":70469,"_20907":117598,"_5":14363,"_27392":117436,"_2946":117599},[],"Carga por separado las políticas concedidas a cada principal.",{"_3461":70519,"_30106":70469,"_20907":117601,"_5":14363,"_27392":117436,"_2946":117602},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3461":70520,"_30106":70469,"_20907":117604,"_5":14363,"_27392":117436,"_2946":117605},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3461":70521,"_30106":70469,"_20907":117607,"_5":14363,"_27392":117436,"_2946":117608},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3461":70522,"_30106":70469,"_20907":117610,"_5":14363,"_27392":117436,"_2946":117611},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3461":70523,"_30106":70469,"_20907":117613,"_5":14363,"_27392":117436,"_2946":117614},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_3461":70524,"_30106":70469,"_20907":117616,"_5":14363,"_27392":117436,"_2946":117617},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3461":70525,"_30106":70469,"_20907":117619,"_5":14363,"_27392":117440,"_2946":117620},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3461":70526,"_30106":70469,"_20907":117622,"_5":14363,"_27392":117440,"_2946":117623},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3461":70527,"_30106":70469,"_20907":117625,"_5":14363,"_27392":117440,"_2946":117626},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3461":70528,"_30106":70469,"_20907":117628,"_5":14363,"_27392":117440,"_2946":117629},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3461":70529,"_30106":70469,"_20907":117631,"_5":14363,"_27392":117440,"_2946":117632},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3461":70530,"_30106":70469,"_20907":117634,"_5":14363,"_27392":117440,"_2946":117635},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3461":70531,"_30106":70469,"_20907":117637,"_5":14363,"_27392":117440,"_2946":117638},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3461":70532,"_30106":70469,"_20907":117640,"_5":14363,"_27392":117440,"_2946":117641},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3461":70533,"_30106":70469,"_20907":117643,"_5":14363,"_27392":117444,"_2946":117644},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3461":70534,"_30106":70469,"_20907":117646,"_5":14363,"_27392":117444,"_2946":117647},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3461":70535,"_30106":70469,"_20907":117649,"_5":14363,"_27392":117444,"_2946":117650},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3461":70536,"_30106":70469,"_20907":117652,"_5":14363,"_27392":117444,"_2946":117653},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3461":70537,"_30106":70469,"_20907":117655,"_5":14363,"_27392":117444,"_2946":117656},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3461":70538,"_30106":70469,"_20907":117658,"_5":14363,"_27392":117444,"_2946":117659},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3461":70539,"_30106":70469,"_20907":117661,"_5":14363,"_27392":117444,"_2946":117662},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3461":70540,"_30106":70469,"_20907":117664,"_5":14363,"_27392":117444,"_2946":117665},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3461":70541,"_30106":70469,"_20907":117667,"_5":14363,"_27392":117444,"_2946":117668},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3461":70542,"_30106":70469,"_20907":117670,"_5":14363,"_27392":117444,"_2946":117671},[],"Las acciones se dividen en dos grupos:",{"_3461":70543,"_30106":70469,"_20907":117673,"_5":14363,"_27392":117444,"_2946":117674},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3461":70544,"_30106":70469,"_20907":117676,"_5":14363,"_27392":117444,"_2946":117677},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3461":70545,"_30106":70469,"_20907":117679,"_5":14363,"_27392":117444,"_2946":117680},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3461":70546,"_30106":70469,"_20907":117682,"_5":14363,"_27392":117448,"_2946":117683},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3461":70547,"_30106":70469,"_20907":117685,"_5":14363,"_27392":117448,"_2946":117686},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3461":70548,"_30106":70469,"_20907":117688,"_5":14363,"_27392":117448,"_2946":117689},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3461":70549,"_30106":70469,"_20907":117691,"_5":14363,"_27392":117452,"_2946":117692},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3461":70550,"_30106":70469,"_20907":117694,"_5":14363,"_27392":117452,"_2946":117695},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3461":70551,"_30106":70469,"_20907":117697,"_5":14363,"_27392":117452,"_2946":117698},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3461":70552,"_30106":70469,"_20907":117700,"_5":14363,"_27392":117452,"_2946":117701},[],"Los operadores implementados son:",{"_3461":70553,"_30106":70469,"_20907":117703,"_5":14363,"_27392":117452,"_2946":117704},[],"`equals`, para igualdad exacta;",{"_3461":70554,"_30106":70469,"_20907":117706,"_5":14363,"_27392":117452,"_2946":117707},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3461":70555,"_30106":70469,"_20907":117709,"_5":14363,"_27392":117452,"_2946":117710},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3461":70556,"_30106":70469,"_20907":117712,"_5":14363,"_27392":117452,"_2946":117713},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3461":70557,"_30106":70469,"_20907":117715,"_5":14363,"_27392":117456,"_2946":117716},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3461":70558,"_30106":70469,"_20907":117718,"_5":14363,"_27392":117456,"_2946":117719},[],"Los modos disponibles son:",{"_3461":70559,"_30106":70469,"_20907":117721,"_5":14363,"_27392":117456,"_2946":117722},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3461":70560,"_30106":70469,"_20907":117724,"_5":14363,"_27392":117456,"_2946":117725},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3461":70561,"_30106":70469,"_20907":117727,"_5":14363,"_27392":117456,"_2946":117728},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3461":70562,"_30106":70469,"_20907":117730,"_5":14363,"_27392":117456,"_2946":117731},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3461":70563,"_30106":70469,"_20907":117733,"_5":14363,"_27392":117456,"_2946":117734},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3461":70564,"_30106":70469,"_20907":117736,"_5":14363,"_27392":117456,"_2946":117737},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3461":70565,"_30106":70469,"_20907":117739,"_5":14363,"_27392":117460,"_2946":117740},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3461":70566,"_30106":70469,"_20907":117742,"_5":14363,"_27392":117460,"_2946":117743},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3461":70567,"_30106":70469,"_20907":117745,"_5":14363,"_27392":117460,"_2946":117746},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3461":70568,"_30106":70469,"_20907":117748,"_5":14363,"_27392":117460,"_2946":117749},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3461":70569,"_30106":70469,"_20907":117751,"_5":14363,"_27392":117468,"_2946":117752},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3461":70570,"_30106":70469,"_20907":117754,"_5":14363,"_27392":117468,"_2946":117755},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3461":70571,"_30106":70469,"_20907":117757,"_5":14363,"_27392":117472,"_2946":117758},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3461":70572,"_30106":70469,"_20907":117760,"_5":14363,"_27392":117472,"_2946":117761},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3461":70573,"_30106":70469,"_20907":117763,"_5":14363,"_27392":117476,"_2946":117764},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3461":70574,"_30106":70469,"_20907":117766,"_5":14363,"_27392":117476,"_2946":117767},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3461":70575,"_30106":70469,"_20907":117769,"_5":14363,"_27392":117476,"_2946":117770},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3461":70576,"_30106":70469,"_20907":117772,"_5":14363,"_27392":117480,"_2946":117773},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3461":70577,"_30106":70469,"_20907":117775,"_5":14363,"_27392":117480,"_2946":117776},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3461":70578,"_30106":70469,"_20907":117778,"_5":14363,"_27392":117480,"_2946":117779},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3461":70579,"_30106":70469,"_20907":117781,"_5":14363,"_27392":117480,"_2946":117782},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3461":70580,"_30106":70469,"_20907":117784,"_5":14363,"_27392":117480,"_2946":117785},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3461":70581,"_30106":70469,"_20907":117787,"_5":14363,"_27392":117480,"_2946":117788},[],"Ten en cuenta que:",{"_3461":70582,"_30106":70469,"_20907":117790,"_5":14363,"_27392":117480,"_2946":117791},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3461":70583,"_30106":70469,"_20907":117793,"_5":14363,"_27392":117480,"_2946":117794},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3461":70584,"_30106":70469,"_20907":117796,"_5":14363,"_27392":117480,"_2946":117797},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3461":70585,"_30106":70469,"_20907":117799,"_5":14363,"_27392":117484,"_2946":117800},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3461":70586,"_30106":70469,"_20907":117802,"_5":14363,"_27392":117484,"_2946":117803},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3461":70587,"_30106":70469,"_20907":117805,"_5":14363,"_27392":117484,"_2946":117806},[],"acceso completo y de solo lectura a KMS;",{"_3461":70588,"_30106":70469,"_20907":117808,"_5":14363,"_27392":117484,"_2946":117809},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3461":70589,"_30106":70469,"_20907":117811,"_5":14363,"_27392":117484,"_2946":117812},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3461":70590,"_30106":70469,"_20907":117814,"_5":14363,"_27392":117484,"_2946":117815},[],"acceso a la interfaz;",{"_3461":70591,"_30106":70469,"_20907":117817,"_5":14363,"_27392":117484,"_2946":117818},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3461":70592,"_30106":70469,"_20907":117820,"_5":14363,"_27392":117484,"_2946":117821},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3461":70593,"_30106":70469,"_20907":117823,"_5":14363,"_27392":117484,"_2946":117824},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3461":70594,"_30106":70469,"_20907":117826,"_5":14363,"_27392":117488,"_2946":117827},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3461":70595,"_30106":70469,"_20907":117829,"_5":14363,"_27392":117488,"_2946":117830},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3461":70596,"_30106":70469,"_20907":117832,"_5":14363,"_27392":117488,"_2946":117833},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3461":70597,"_30106":70469,"_20907":117835,"_5":14363,"_27392":117491,"_2946":117836},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3461":70598,"_30106":70469,"_20907":117838,"_5":14363,"_27392":117495,"_2946":117839},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3461":70599,"_30106":70469,"_20907":117841,"_5":14363,"_27392":117495,"_2946":117842},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3461":70600,"_30106":70469,"_20907":117844,"_5":14363,"_27392":117499,"_2946":117845},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3461":70601,"_30106":70469,"_20907":117847,"_5":14363,"_27392":117503,"_2946":117848},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3461":70602,"_30106":70469,"_20907":117850,"_5":14363,"_27392":117507,"_2946":117851},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3461":70603,"_30106":70469,"_20907":117853,"_5":14363,"_27392":117511,"_2946":117854},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3461":70604,"_30106":70469,"_20907":117856,"_5":14363,"_27392":117511,"_2946":117857},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3461":70605,"_30106":70469,"_20907":117859,"_5":14363,"_27392":117515,"_2946":117860},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3461":70606,"_30106":70469,"_20907":117862,"_5":14363,"_27392":117515,"_2946":117863},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3461":70607,"_30106":70469,"_20907":117865,"_5":14363,"_27392":117515,"_2946":117866},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3461":70608,"_30106":70469,"_20907":117868,"_5":14363,"_27392":117515,"_2946":117869},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3461":70609,"_30106":70469,"_20907":117871,"_5":14363,"_27392":117515,"_2946":117872},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3461":70610,"_30106":70469,"_20907":117874,"_5":14363,"_27392":117515,"_2946":117875},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3461":70611,"_30106":70469,"_20907":117877,"_5":14363,"_27392":117515,"_2946":117878},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3461":70612,"_30106":70469,"_20907":117880,"_5":14363,"_27392":117515,"_2946":117881},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3461":70613,"_30106":70469,"_20907":117883,"_5":14363,"_27392":117519,"_2946":117884},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3461":70614,"_30106":70469,"_20907":117886,"_5":14363,"_27392":117519,"_2946":117887},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3461":70615,"_30106":70469,"_20907":117889,"_5":14363,"_27392":117519,"_2946":117890},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3461":70616,"_30106":70469,"_20907":117892,"_5":14363,"_27392":117523,"_2946":117893},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3461":70617,"_30106":70469,"_20907":117895,"_5":14363,"_27392":117523,"_2946":117896},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3461":70618,"_30106":70469,"_20907":117898,"_5":14363,"_27392":117523,"_2946":117899},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3461":70619,"_30106":70469,"_20907":117901,"_5":14363,"_27392":117523,"_2946":117902},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3461":70620,"_30106":70469,"_20907":117904,"_5":14363,"_27392":117523,"_2946":117905},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3461":70621,"_30106":70469,"_20907":117907,"_5":14363,"_27392":117523,"_2946":117908},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3461":70622,"_30106":70469,"_20907":117910,"_5":14363,"_27392":117523,"_2946":117911},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3461":70623,"_30106":70469,"_20907":117913,"_5":14363,"_27392":117523,"_2946":117914},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3461":70624,"_30106":70469,"_20907":117916,"_5":14363,"_27392":117531,"_2946":117917},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3461":70625,"_30106":70469,"_20907":117919,"_5":14363,"_27392":117535,"_2946":117920},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3461":70626,"_30106":70469,"_20907":117922,"_5":14363,"_27392":117535,"_2946":117923},[],"que exista un principal activo del tipo correcto;",{"_3461":70627,"_30106":70469,"_20907":117925,"_5":14363,"_27392":117535,"_2946":117926},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3461":70628,"_30106":70469,"_20907":117928,"_5":14363,"_27392":117535,"_2946":117929},[],"que todas las condiciones del principal se cumplan;",{"_3461":70629,"_30106":70469,"_20907":117931,"_5":14363,"_27392":117535,"_2946":117932},[],"que el principal tenga concedida la política esperada;",{"_3461":70630,"_30106":70469,"_20907":117934,"_5":14363,"_27392":117535,"_2946":117935},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3461":70631,"_30106":70469,"_20907":117937,"_5":14363,"_27392":117535,"_2946":117938},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3461":70632,"_30106":70469,"_20907":117940,"_5":14363,"_27392":117535,"_2946":117941},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3461":70633,"_30106":70469,"_20907":117943,"_5":14363,"_27392":117539,"_2946":117944},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3461":70634,"_30106":70469,"_20907":117946,"_5":14363,"_27392":117543,"_2946":117947},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3461":70635,"_30106":70469,"_20907":117949,"_5":14363,"_27392":117547,"_2946":117950},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3461":70636,"_30106":70469,"_20907":117952,"_5":14363,"_27392":117547,"_2946":117953},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3461":70637,"_30106":70637,"_5":14715,"_2946":117955,"_30438":117956,"_20907":117957,"_27392":70637},"Alertas y suscripciones",[49125,117420,117421],[],{"_3461":70638,"_30106":70637,"_20907":117959,"_5":14363,"_27392":70637,"_2946":117960},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3461":70639,"_30106":70637,"_5":30435,"_20907":117962,"_27392":117963,"_2946":117964},[],"/docs/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3461":70640,"_30106":70637,"_5":30435,"_20907":117966,"_27392":117967,"_2946":117968},[],"/docs/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3461":70641,"_30106":70637,"_5":30435,"_20907":117970,"_27392":117971,"_2946":117972},[],"/docs/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3461":70642,"_30106":70637,"_5":30435,"_20907":117974,"_27392":117975,"_2946":117976},[],"/docs/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3461":70643,"_30106":70637,"_5":30435,"_20907":117978,"_27392":117979,"_2946":117980},[],"/docs/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3461":70644,"_30106":70637,"_5":30435,"_20907":117982,"_27392":117983,"_2946":117984},[],"/docs/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3461":70645,"_30106":70637,"_5":30435,"_20907":117986,"_27392":117987,"_2946":117988},[],"/docs/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3461":70646,"_30106":70637,"_5":30435,"_20907":117990,"_27392":117991,"_2946":117992},[],"/docs/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3461":70647,"_30106":70637,"_5":30435,"_20907":117994,"_27392":117995,"_2946":117996},[],"/docs/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3461":70648,"_30106":70637,"_5":30435,"_20907":117998,"_27392":117999,"_2946":118000},[],"/docs/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3461":70649,"_30106":70637,"_5":30435,"_20907":118002,"_27392":118003,"_2946":118004},[],"/docs/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3461":70650,"_30106":70637,"_20907":118006,"_5":14363,"_27392":70637,"_2946":118007},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3461":70651,"_30106":70637,"_20907":118009,"_5":14363,"_27392":117963,"_2946":118010},[],"Un servicio publica un evento de dominio.",{"_3461":70652,"_30106":70637,"_20907":118012,"_5":14363,"_27392":117963,"_2946":118013},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3461":70653,"_30106":70637,"_20907":118015,"_5":14363,"_27392":117963,"_2946":118016},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3461":70654,"_30106":70637,"_20907":118018,"_5":14363,"_27392":117963,"_2946":118019},[],"Lamassu entrega el evento al canal configurado.",{"_3461":70655,"_30106":70637,"_20907":118021,"_5":14363,"_27392":117963,"_2946":118022},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3461":70656,"_30106":70637,"_20907":118024,"_5":14363,"_27392":117967,"_2946":118025},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3461":70657,"_30106":70637,"_20907":118027,"_5":14363,"_27392":117967,"_2946":118028},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3461":70658,"_30106":70637,"_20907":118030,"_5":14363,"_27392":117967,"_2946":118031},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3461":70659,"_30106":70637,"_20907":118033,"_5":14363,"_27392":117967,"_2946":118034},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3461":70660,"_30106":70637,"_20907":118036,"_5":14363,"_27392":117967,"_2946":118037},[],"`apikey_options` necesita `header` y `key`.",{"_3461":70661,"_30106":70637,"_20907":118039,"_5":14363,"_27392":117967,"_2946":118040},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3461":70662,"_30106":70637,"_20907":118042,"_5":14363,"_27392":117967,"_2946":118043},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3461":70663,"_30106":70637,"_20907":118045,"_5":14363,"_27392":117967,"_2946":118046},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3461":70664,"_30106":70637,"_20907":118048,"_5":14363,"_27392":117975,"_2946":118049},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3461":70665,"_30106":70637,"_20907":118051,"_5":14363,"_27392":117979,"_2946":118052},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3461":70666,"_30106":70637,"_20907":118054,"_5":14363,"_27392":117983,"_2946":118055},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3461":70667,"_30106":70637,"_20907":118057,"_5":14363,"_27392":117983,"_2946":118058},[],"**None** notifica todas las instancias del evento.",{"_3461":70668,"_30106":70637,"_20907":118060,"_5":14363,"_27392":117983,"_2946":118061},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3461":70669,"_30106":70637,"_20907":118063,"_5":14363,"_27392":117983,"_2946":118064},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3461":70670,"_30106":70637,"_20907":118066,"_5":14363,"_27392":117983,"_2946":118067},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3461":70671,"_30106":70637,"_20907":118069,"_5":14363,"_27392":117983,"_2946":118070},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3461":70672,"_30106":70637,"_20907":118072,"_5":14363,"_27392":117983,"_2946":118073},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3461":70673,"_30106":70637,"_20907":118075,"_5":14363,"_27392":117987,"_2946":118076},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3461":70674,"_30106":70637,"_20907":118078,"_5":14363,"_27392":117991,"_2946":118079},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3461":70675,"_30106":70637,"_20907":118081,"_5":14363,"_27392":117991,"_2946":118082},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3461":70676,"_30106":70637,"_20907":118084,"_5":14363,"_27392":117991,"_2946":118085},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3461":70677,"_30106":70637,"_20907":118087,"_5":14363,"_27392":117991,"_2946":118088},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3461":70678,"_30106":70637,"_20907":118090,"_5":14363,"_27392":117991,"_2946":118091},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3461":70679,"_30106":70637,"_20907":118093,"_5":14363,"_27392":117991,"_2946":118094},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3461":70680,"_30106":70637,"_20907":118096,"_5":14363,"_27392":117991,"_2946":118097},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3461":70681,"_30106":70637,"_20907":118099,"_5":14363,"_27392":117991,"_2946":118100},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3461":70682,"_30106":70637,"_20907":118102,"_5":14363,"_27392":117995,"_2946":118103},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3461":70683,"_30106":70637,"_20907":118105,"_5":14363,"_27392":117995,"_2946":118106},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3461":70684,"_30106":70637,"_20907":118108,"_5":14363,"_27392":117995,"_2946":118109},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3461":70685,"_30106":70637,"_20907":118111,"_5":14363,"_27392":117995,"_2946":118112},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3461":70686,"_30106":70637,"_20907":118114,"_5":14363,"_27392":117995,"_2946":118115},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3461":70687,"_30106":70637,"_20907":118117,"_5":14363,"_27392":117995,"_2946":118118},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3461":70688,"_30106":70637,"_20907":118120,"_5":14363,"_27392":117995,"_2946":118121},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3461":70689,"_30106":70637,"_20907":118123,"_5":14363,"_27392":117995,"_2946":118124},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3461":70690,"_30106":70637,"_20907":118126,"_5":14363,"_27392":117999,"_2946":118127},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3461":70691,"_30106":70637,"_20907":118129,"_5":14363,"_27392":117999,"_2946":118130},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3461":70692,"_30106":70637,"_20907":118132,"_5":14363,"_27392":118003,"_2946":118133},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3461":70693,"_30106":70637,"_20907":118135,"_5":14363,"_27392":118003,"_2946":118136},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3461":70694,"_30106":70637,"_20907":118138,"_5":14363,"_27392":118003,"_2946":118139},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3461":70695,"_30106":70637,"_20907":118141,"_5":14363,"_27392":118003,"_2946":118142},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3461":70696,"_30106":70637,"_20907":118144,"_5":14363,"_27392":118003,"_2946":118145},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3461":70697,"_30106":70637,"_20907":118147,"_5":14363,"_27392":118003,"_2946":118148},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init` y `va.crl-settings.update`.",{"_3461":70698,"_30106":70637,"_20907":118150,"_5":14363,"_27392":118003,"_2946":118151},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3461":70699,"_30106":70637,"_20907":118153,"_5":14363,"_27392":118003,"_2946":118154},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3461":70700,"_30106":70637,"_20907":118156,"_5":14363,"_27392":118003,"_2946":118157},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3461":70701,"_30106":70701,"_5":14715,"_2946":118159,"_30438":118160,"_20907":118161,"_27392":70701},"Registros de auditoría",[49125,117420,117421],[],{"_3461":70702,"_30106":70701,"_20907":118163,"_5":14363,"_27392":70701,"_2946":118164},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3461":70703,"_30106":70701,"_5":30435,"_20907":118166,"_27392":118167,"_2946":118168},[],"/docs/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3461":70704,"_30106":70701,"_5":30435,"_20907":118170,"_27392":118171,"_2946":118172},[],"/docs/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3461":70705,"_30106":70701,"_5":30435,"_20907":118174,"_27392":118175,"_2946":118176},[],"/docs/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3461":70706,"_30106":70701,"_5":30435,"_20907":118178,"_27392":118179,"_2946":118180},[],"/docs/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3461":70707,"_30106":70701,"_5":30435,"_20907":118182,"_27392":118183,"_2946":118184},[],"/docs/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3461":70708,"_30106":70701,"_5":30435,"_20907":118186,"_27392":118187,"_2946":118188},[],"/docs/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3461":70709,"_30106":70701,"_5":30435,"_20907":118190,"_27392":118191,"_2946":118192},[],"/docs/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3461":70710,"_30106":70701,"_5":30435,"_20907":118194,"_27392":118195,"_2946":118196},[],"/docs/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3461":70711,"_30106":70701,"_5":30435,"_20907":118198,"_27392":118199,"_2946":118200},[],"/docs/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3461":70712,"_30106":70701,"_5":30435,"_20907":118202,"_27392":118203,"_2946":118204},[],"/docs/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3461":70713,"_30106":70701,"_5":30435,"_20907":118206,"_27392":118207,"_2946":118208},[],"/docs/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3461":70714,"_30106":70701,"_20907":118210,"_5":14363,"_27392":70701,"_2946":118211},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3461":70715,"_30106":70701,"_20907":118213,"_5":14363,"_27392":118167,"_2946":118214},[],"El cuerpo de auditoría incluye:",{"_3461":70716,"_30106":70701,"_20907":118216,"_5":14363,"_27392":118167,"_2946":118217},[],"input: datos recibidos por la operación;",{"_3461":70717,"_30106":70701,"_20907":118219,"_5":14363,"_27392":118167,"_2946":118220},[],"has\\_error: indica si el servicio devolvió un error;",{"_3461":70718,"_30106":70701,"_20907":118222,"_5":14363,"_27392":118167,"_2946":118223},[],"output: resultado producido o mensaje de error;",{"_3461":70719,"_30106":70701,"_20907":118225,"_5":14363,"_27392":118167,"_2946":118226},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3461":70720,"_30106":70701,"_20907":118228,"_5":14363,"_27392":118167,"_2946":118229},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3461":70721,"_30106":70701,"_20907":118231,"_5":14363,"_27392":118167,"_2946":118232},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3461":70722,"_30106":70701,"_20907":118234,"_5":14363,"_27392":118171,"_2946":118235},[],"El backend aplica auditoría a mutaciones de:",{"_3461":70723,"_30106":70701,"_20907":118237,"_5":14363,"_27392":118171,"_2946":118238},[],"autoridades, certificados y perfiles de emisión;",{"_3461":70724,"_30106":70701,"_20907":118240,"_5":14363,"_27392":118171,"_2946":118241},[],"claves y motores KMS;",{"_3461":70725,"_30106":70701,"_20907":118243,"_5":14363,"_27392":118171,"_2946":118244},[],"dispositivos e identidades;",{"_3461":70726,"_30106":70701,"_20907":118246,"_5":14363,"_27392":118171,"_2946":118247},[],"DMS y operaciones de enrolamiento;",{"_3461":70727,"_30106":70701,"_20907":118249,"_5":14363,"_27392":118171,"_2946":118250},[],"funciones de validación y CRL;",{"_3461":70728,"_30106":70701,"_20907":118252,"_5":14363,"_27392":118171,"_2946":118253},[],"principales, políticas y concesiones de autorización.",{"_3461":70729,"_30106":70701,"_20907":118255,"_5":14363,"_27392":118171,"_2946":118256},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3461":70730,"_30106":70701,"_20907":118258,"_5":14363,"_27392":118175,"_2946":118259},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3461":70731,"_30106":70701,"_20907":118261,"_5":14363,"_27392":118175,"_2946":118262},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3461":70732,"_30106":70701,"_20907":118264,"_5":14363,"_27392":118175,"_2946":118265},[],"Diseña el consumidor para:",{"_3461":70733,"_30106":70701,"_20907":118267,"_5":14363,"_27392":118175,"_2946":118268},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3461":70734,"_30106":70701,"_20907":118270,"_5":14363,"_27392":118175,"_2946":118271},[],"conservar el CloudEvent completo sin modificar;",{"_3461":70735,"_30106":70701,"_20907":118273,"_5":14363,"_27392":118175,"_2946":118274},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3461":70736,"_30106":70701,"_20907":118276,"_5":14363,"_27392":118175,"_2946":118277},[],"cifrar en tránsito y en reposo;",{"_3461":70737,"_30106":70701,"_20907":118279,"_5":14363,"_27392":118175,"_2946":118280},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3461":70738,"_30106":70701,"_20907":118282,"_5":14363,"_27392":118175,"_2946":118283},[],"aplicar una política explícita de retención y legal hold;",{"_3461":70739,"_30106":70701,"_20907":118285,"_5":14363,"_27392":118175,"_2946":118286},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3461":70740,"_30106":70701,"_20907":118288,"_5":14363,"_27392":118179,"_2946":118289},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3461":70741,"_30106":70701,"_20907":118291,"_5":14363,"_27392":118179,"_2946":118292},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3461":70742,"_30106":70701,"_20907":118294,"_5":14363,"_27392":118187,"_2946":118295},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3461":70743,"_30106":70701,"_20907":118297,"_5":14363,"_27392":118191,"_2946":118298},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3461":70744,"_30106":70701,"_20907":118300,"_5":14363,"_27392":118195,"_2946":118301},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3461":70745,"_30106":70701,"_20907":118303,"_5":14363,"_27392":118199,"_2946":118304},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3461":70746,"_30106":70701,"_20907":118306,"_5":14363,"_27392":118203,"_2946":118307},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3461":70747,"_30106":70701,"_20907":118309,"_5":14363,"_27392":118207,"_2946":118310},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3461":70748,"_30106":70701,"_20907":118312,"_5":14363,"_27392":118207,"_2946":118313},[],"aparece un evento de auditoría correcto;",{"_3461":70749,"_30106":70701,"_20907":118315,"_5":14363,"_27392":118207,"_2946":118316},[],"el principal coincide con la identidad utilizada;",{"_3461":70750,"_30106":70701,"_20907":118318,"_5":14363,"_27392":118207,"_2946":118319},[],"el consumidor lo persiste una sola vez;",{"_3461":70751,"_30106":70701,"_20907":118321,"_5":14363,"_27392":118207,"_2946":118322},[],"puede recuperarse por recurso, actor y periodo;",{"_3461":70752,"_30106":70701,"_20907":118324,"_5":14363,"_27392":118207,"_2946":118325},[],"una interrupción del consumidor produce una alerta.",{"_3461":70753,"_30106":70701,"_20907":118327,"_5":14363,"_27392":118207,"_2946":118328},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3461":70754,"_30106":70754,"_5":14715,"_2946":118330,"_30438":118331,"_20907":118332,"_27392":70754},"Arquitectura de la plataforma",[49125,117420],[],{"_3461":70755,"_30106":70754,"_20907":118334,"_5":14363,"_27392":70754,"_2946":118335},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3461":70756,"_30106":70754,"_5":30435,"_20907":118337,"_27392":118338,"_2946":118339},[],"/docs/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3461":70757,"_30106":70754,"_5":30435,"_20907":118341,"_27392":118342,"_2946":118343},[],"/docs/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3461":70758,"_30106":70754,"_5":30435,"_20907":118345,"_27392":118346,"_2946":118347},[],"/docs/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3461":70759,"_30106":70754,"_5":30435,"_20907":118349,"_27392":118350,"_2946":118351},[],"/docs/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3461":70760,"_30106":70754,"_5":30435,"_20907":118353,"_27392":118354,"_2946":118355},[],"/docs/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3461":70761,"_30106":70754,"_20907":118357,"_5":14363,"_27392":70754,"_2946":118358},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3461":70762,"_30106":70754,"_20907":118360,"_5":14363,"_27392":70754,"_2946":118361},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3461":70763,"_30106":70754,"_20907":118363,"_5":14363,"_27392":118338,"_2946":118364},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3461":70764,"_30106":70754,"_20907":118366,"_5":14363,"_27392":118342,"_2946":118367},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3461":70765,"_30106":70754,"_20907":118369,"_5":14363,"_27392":118346,"_2946":118370},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3461":70766,"_30106":70754,"_20907":118372,"_5":14363,"_27392":118350,"_2946":118373},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3461":70767,"_30106":70754,"_20907":118375,"_5":14363,"_27392":118354,"_2946":118376},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3461":70768,"_30106":70768,"_5":14715,"_2946":118378,"_30438":118379,"_20907":118380,"_27392":70768},"Cómo funciona Lamassu",[49125,117420],[],{"_3461":70769,"_30106":70768,"_20907":118382,"_5":14363,"_27392":70768,"_2946":118383},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3461":70770,"_30106":70768,"_5":30435,"_20907":118385,"_27392":118386,"_2946":118387},[],"/docs/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3461":70771,"_30106":70768,"_5":30435,"_20907":118389,"_27392":118390,"_2946":118391},[],"/docs/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3461":70772,"_30106":70768,"_20907":118393,"_5":14363,"_27392":70768,"_2946":118394},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3461":70773,"_30106":70768,"_20907":118396,"_5":14363,"_27392":118386,"_2946":118397},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3461":70774,"_30106":70768,"_20907":118399,"_5":14363,"_27392":118386,"_2946":118400},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3461":70775,"_30106":70768,"_20907":118402,"_5":14363,"_27392":118386,"_2946":118403},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3461":70776,"_30106":70768,"_20907":118405,"_5":14363,"_27392":118386,"_2946":118406},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3461":70777,"_30106":70768,"_20907":118408,"_5":14363,"_27392":118386,"_2946":118409},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3461":70778,"_30106":70768,"_20907":118411,"_5":14363,"_27392":118390,"_2946":118412},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3461":70779,"_30106":70768,"_20907":118414,"_5":14363,"_27392":118390,"_2946":118415},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3461":70780,"_30106":70768,"_20907":118417,"_5":14363,"_27392":118390,"_2946":118418},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3461":70781,"_30106":70768,"_20907":118420,"_5":14363,"_27392":118390,"_2946":118421},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3461":70782,"_30106":70768,"_20907":118423,"_5":14363,"_27392":118390,"_2946":118424},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3461":70783,"_30106":70768,"_20907":118426,"_5":14363,"_27392":118390,"_2946":118427},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3461":70784,"_30106":70768,"_20907":118429,"_5":14363,"_27392":118390,"_2946":118430},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3461":70785,"_30106":70785,"_5":14715,"_2946":118432,"_30438":118433,"_20907":118434,"_27392":70785},"Dispositivos e identidades",[49125,117420,51607,118432],[],{"_3461":70786,"_30106":70785,"_20907":118436,"_5":14363,"_27392":70785,"_2946":118437},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3461":70787,"_30106":70785,"_5":30435,"_20907":118439,"_27392":118440,"_2946":118441},[],"/docs/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3461":70788,"_30106":70785,"_5":30435,"_20907":118443,"_27392":118444,"_2946":118445},[],"/docs/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3461":70789,"_30106":70785,"_5":30435,"_20907":118447,"_27392":118448,"_2946":118449},[],"/docs/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3461":70790,"_30106":70785,"_5":30435,"_20907":118451,"_27392":118452,"_2946":118453},[],"/docs/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3461":70791,"_30106":70785,"_5":30435,"_20907":118455,"_27392":118456,"_2946":118457},[],"/docs/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3461":70792,"_30106":70785,"_5":30435,"_20907":118459,"_27392":118460,"_2946":118461},[],"/docs/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3461":70793,"_30106":70785,"_5":30435,"_20907":118463,"_27392":118464,"_2946":118465},[],"/docs/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3461":70794,"_30106":70785,"_5":30435,"_20907":118467,"_27392":118468,"_2946":118469},[],"/docs/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3461":70795,"_30106":70785,"_5":30435,"_20907":118471,"_27392":118472,"_2946":118473},[],"/docs/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3461":70796,"_30106":70785,"_5":30435,"_20907":118475,"_27392":118476,"_2946":118477},[],"/docs/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3461":70797,"_30106":70785,"_5":30435,"_20907":118479,"_27392":118480,"_2946":118481},[],"/docs/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3461":70798,"_30106":70785,"_20907":118483,"_5":14363,"_27392":70785,"_2946":118484},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3461":70799,"_30106":70785,"_20907":118486,"_5":14363,"_27392":70785,"_2946":118487},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3461":70800,"_30106":70785,"_20907":118489,"_5":14363,"_27392":118440,"_2946":118490},[],"Vista operativa",{"_3461":70801,"_30106":70785,"_20907":118492,"_5":14363,"_27392":118440,"_2946":118493},[],"Interpretación",{"_3461":70802,"_30106":70785,"_20907":118495,"_5":14363,"_27392":118440,"_2946":51670},[],{"_3461":70803,"_30106":70785,"_20907":118497,"_5":14363,"_27392":118440,"_2946":118498},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3461":70804,"_30106":70785,"_20907":118500,"_5":14363,"_27392":118440,"_2946":51676},[],{"_3461":70805,"_30106":70785,"_20907":118502,"_5":14363,"_27392":118440,"_2946":118503},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3461":70806,"_30106":70785,"_20907":118505,"_5":14363,"_27392":118440,"_2946":51682},[],{"_3461":70807,"_30106":70785,"_20907":118507,"_5":14363,"_27392":118440,"_2946":118508},[],"La identidad está en la ventana operativa de renovación.",{"_3461":70808,"_30106":70785,"_20907":118510,"_5":14363,"_27392":118440,"_2946":51688},[],{"_3461":70809,"_30106":70785,"_20907":118512,"_5":14363,"_27392":118440,"_2946":118513},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3461":70810,"_30106":70785,"_20907":118515,"_5":14363,"_27392":118440,"_2946":51694},[],{"_3461":70811,"_30106":70785,"_20907":118517,"_5":14363,"_27392":118440,"_2946":118518},[],"La identidad ha vencido.",{"_3461":70812,"_30106":70785,"_20907":118520,"_5":14363,"_27392":118440,"_2946":51700},[],{"_3461":70813,"_30106":70785,"_20907":118522,"_5":14363,"_27392":118440,"_2946":118523},[],"La identidad está marcada como revocada.",{"_3461":70814,"_30106":70785,"_20907":118525,"_5":14363,"_27392":118440,"_2946":51706},[],{"_3461":70815,"_30106":70785,"_20907":118527,"_5":14363,"_27392":118440,"_2946":118528},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3461":70816,"_30106":70785,"_20907":118530,"_5":14363,"_27392":118440,"_2946":118531},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3461":70817,"_30106":70785,"_20907":118533,"_5":14363,"_27392":118444,"_2946":118534},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3461":70818,"_30106":70785,"_20907":118536,"_5":14363,"_27392":118444,"_2946":118537},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3461":70819,"_30106":70785,"_20907":118539,"_5":14363,"_27392":118444,"_2946":118540},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3461":70820,"_30106":70785,"_20907":118542,"_5":14363,"_27392":118444,"_2946":118543},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3461":70821,"_30106":70785,"_20907":118545,"_5":14363,"_27392":118448,"_2946":118546},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3461":70822,"_30106":70785,"_20907":118548,"_5":14363,"_27392":118452,"_2946":118549},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3461":70823,"_30106":70785,"_20907":118551,"_5":14363,"_27392":118456,"_2946":118552},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3461":70824,"_30106":70785,"_20907":118554,"_5":14363,"_27392":118460,"_2946":118555},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3461":70825,"_30106":70785,"_20907":118557,"_5":14363,"_27392":118464,"_2946":118558},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3461":70826,"_30106":70785,"_20907":118560,"_5":14363,"_27392":118464,"_2946":118561},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3461":70827,"_30106":70785,"_20907":118563,"_5":14363,"_27392":118468,"_2946":118564},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3461":70828,"_30106":70785,"_20907":118566,"_5":14363,"_27392":118468,"_2946":118567},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3461":70829,"_30106":70785,"_20907":118569,"_5":14363,"_27392":118468,"_2946":118570},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3461":70830,"_30106":70785,"_20907":118572,"_5":14363,"_27392":118468,"_2946":118573},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3461":70831,"_30106":70785,"_20907":118575,"_5":14363,"_27392":118468,"_2946":118576},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3461":70832,"_30106":70785,"_20907":118578,"_5":14363,"_27392":118468,"_2946":118579},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3461":70833,"_30106":70785,"_20907":118581,"_5":14363,"_27392":118472,"_2946":118582},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3461":70834,"_30106":70785,"_20907":118584,"_5":14363,"_27392":118472,"_2946":118585},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3461":70835,"_30106":70785,"_20907":118587,"_5":14363,"_27392":118476,"_2946":118588},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3461":70836,"_30106":70785,"_20907":118590,"_5":14363,"_27392":118476,"_2946":118591},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3461":70837,"_30106":70785,"_20907":118593,"_5":14363,"_27392":118476,"_2946":118594},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3461":70838,"_30106":70785,"_20907":118596,"_5":14363,"_27392":118476,"_2946":118597},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3461":70839,"_30106":70785,"_20907":118599,"_5":14363,"_27392":118480,"_2946":118600},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3461":70840,"_30106":70785,"_20907":118602,"_5":14363,"_27392":118480,"_2946":118603},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3461":70841,"_30106":70841,"_5":14715,"_2946":118605,"_30438":118606,"_20907":118608,"_27392":70841},"Identidad inicial y autenticación",[49125,117420,51607,118432,118607],"Enrolamiento con PKI",[],{"_3461":70842,"_30106":70841,"_20907":118610,"_5":14363,"_27392":70841,"_2946":118611},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3461":70843,"_30106":70841,"_5":30435,"_20907":118613,"_27392":118614,"_2946":118615},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3461":70844,"_30106":70841,"_5":30435,"_20907":118617,"_27392":118618,"_2946":118619},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3461":70845,"_30106":70841,"_5":30435,"_20907":118621,"_27392":118622,"_2946":118623},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3461":70846,"_30106":70841,"_5":30435,"_20907":118625,"_27392":118626,"_2946":118627},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3461":70847,"_30106":70841,"_5":30435,"_20907":118629,"_27392":118630,"_2946":118631},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3461":70848,"_30106":70841,"_20907":118633,"_5":14363,"_27392":70841,"_2946":118634},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3461":70849,"_30106":70841,"_20907":118636,"_5":14363,"_27392":118614,"_2946":118637},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3461":70850,"_30106":70841,"_20907":118639,"_5":14363,"_27392":118614,"_2946":118640},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3461":70851,"_30106":70841,"_20907":118642,"_5":14363,"_27392":118618,"_2946":118643},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3461":70852,"_30106":70841,"_20907":118645,"_5":14363,"_27392":118618,"_2946":118646},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3461":70853,"_30106":70841,"_20907":118648,"_5":14363,"_27392":118618,"_2946":118649},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3461":70854,"_30106":70841,"_20907":118651,"_5":14363,"_27392":118622,"_2946":118652},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3461":70855,"_30106":70841,"_20907":118654,"_5":14363,"_27392":118622,"_2946":118655},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3461":70856,"_30106":70841,"_20907":118657,"_5":14363,"_27392":118626,"_2946":118658},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3461":70857,"_30106":70841,"_20907":118660,"_5":14363,"_27392":118626,"_2946":118661},[],"Ejemplo de cuerpo:",{"_3461":70858,"_30106":70841,"_20907":118663,"_5":14363,"_27392":118626,"_2946":118664},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3461":70859,"_30106":70841,"_20907":118666,"_5":14363,"_27392":118626,"_2946":118667},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3461":70860,"_30106":70841,"_20907":118669,"_5":14363,"_27392":118626,"_2946":118670},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3461":70861,"_30106":70841,"_20907":118672,"_5":14363,"_27392":118626,"_2946":118673},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3461":70862,"_30106":70841,"_20907":118675,"_5":14363,"_27392":118630,"_2946":118676},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3461":70863,"_30106":70841,"_20907":118678,"_5":14363,"_27392":118630,"_2946":118679},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3461":70864,"_30106":70864,"_5":14715,"_2946":118681,"_30438":118682,"_20907":118683,"_27392":70864},"Configura y opera el DMS",[49125,117420,51607,118432,118607],[],{"_3461":70865,"_30106":70864,"_20907":118685,"_5":14363,"_27392":70864,"_2946":118686},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3461":70866,"_30106":70864,"_5":30435,"_20907":118688,"_27392":118689,"_2946":115998},[],"/docs/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3461":70867,"_30106":70864,"_5":30435,"_20907":118691,"_27392":118692,"_2946":118693},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3461":70868,"_30106":70864,"_5":30435,"_20907":118695,"_27392":118696,"_2946":118697},[],"/docs/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3461":70869,"_30106":70864,"_5":30435,"_20907":118699,"_27392":118700,"_2946":118701},[],"/docs/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3461":70870,"_30106":70864,"_5":30435,"_20907":118703,"_27392":118704,"_2946":118705},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3461":70871,"_30106":70864,"_5":30435,"_20907":118707,"_27392":118708,"_2946":118709},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3461":70872,"_30106":70864,"_5":30435,"_20907":118711,"_27392":118712,"_2946":118713},[],"/docs/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3461":70873,"_30106":70864,"_5":30435,"_20907":118715,"_27392":118716,"_2946":118717},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3461":70874,"_30106":70864,"_5":30435,"_20907":118719,"_27392":118720,"_2946":51902},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3461":70875,"_30106":70864,"_5":30435,"_20907":118722,"_27392":118723,"_2946":51906},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3461":70876,"_30106":70864,"_5":30435,"_20907":118725,"_27392":118726,"_2946":118727},[],"/docs/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3461":70877,"_30106":70864,"_5":30435,"_20907":118729,"_27392":118730,"_2946":118731},[],"/docs/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3461":70878,"_30106":70864,"_5":30435,"_20907":118733,"_27392":118734,"_2946":118735},[],"/docs/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3461":70879,"_30106":70864,"_5":30435,"_20907":118737,"_27392":118738,"_2946":118739},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3461":70880,"_30106":70864,"_5":30435,"_20907":118741,"_27392":118742,"_2946":51926},[],"/docs/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3461":70881,"_30106":70864,"_5":30435,"_20907":118744,"_27392":118745,"_2946":118746},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3461":70882,"_30106":70864,"_5":30435,"_20907":118748,"_27392":118749,"_2946":118750},[],"/docs/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3461":70883,"_30106":70864,"_5":30435,"_20907":118752,"_27392":118753,"_2946":118754},[],"/docs/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3461":70884,"_30106":70864,"_20907":118756,"_5":14363,"_27392":70864,"_2946":118757},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3461":70885,"_30106":70864,"_20907":118759,"_5":14363,"_27392":118689,"_2946":118760},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3461":70886,"_30106":70864,"_20907":118762,"_5":14363,"_27392":118689,"_2946":118763},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3461":70887,"_30106":70864,"_20907":118765,"_5":14363,"_27392":118696,"_2946":118766},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3461":70888,"_30106":70864,"_20907":118768,"_5":14363,"_27392":118700,"_2946":118769},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3461":70889,"_30106":70864,"_20907":118771,"_5":14363,"_27392":118704,"_2946":118772},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3461":70890,"_30106":70864,"_20907":118774,"_5":14363,"_27392":118708,"_2946":118775},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3461":70891,"_30106":70864,"_20907":118777,"_5":14363,"_27392":118712,"_2946":118778},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3461":70892,"_30106":70864,"_20907":118780,"_5":14363,"_27392":118720,"_2946":118781},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3461":70893,"_30106":70864,"_20907":118783,"_5":14363,"_27392":118720,"_2946":118784},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3461":70894,"_30106":70864,"_20907":118786,"_5":14363,"_27392":118723,"_2946":118787},[],"Campo de `settings.enrollment_settings`",{"_3461":70895,"_30106":70864,"_20907":118789,"_5":14363,"_27392":118723,"_2946":118790},[],"Decisión",{"_3461":70896,"_30106":70864,"_20907":118792,"_5":14363,"_27392":118723,"_2946":51977},[],{"_3461":70897,"_30106":70864,"_20907":118794,"_5":14363,"_27392":118723,"_2946":118795},[],"`EST_RFC7030` para estas operaciones.",{"_3461":70898,"_30106":70864,"_20907":118797,"_5":14363,"_27392":118723,"_2946":51983},[],{"_3461":70899,"_30106":70864,"_20907":118799,"_5":14363,"_27392":118723,"_2946":118800},[],"ID de la CA que firmará.",{"_3461":70900,"_30106":70864,"_20907":118802,"_5":14363,"_27392":118723,"_2946":51989},[],{"_3461":70901,"_30106":70864,"_20907":118804,"_5":14363,"_27392":118723,"_2946":118805},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3461":70902,"_30106":70864,"_20907":118807,"_5":14363,"_27392":118723,"_2946":51995},[],{"_3461":70903,"_30106":70864,"_20907":118809,"_5":14363,"_27392":118723,"_2946":118810},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3461":70904,"_30106":70864,"_20907":118812,"_5":14363,"_27392":118723,"_2946":52001},[],{"_3461":70905,"_30106":70864,"_20907":118814,"_5":14363,"_27392":118723,"_2946":118815},[],"Uno de los cuatro modos de autenticación.",{"_3461":70906,"_30106":70864,"_20907":118817,"_5":14363,"_27392":118723,"_2946":118818},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3461":70907,"_30106":70864,"_20907":118820,"_5":14363,"_27392":118726,"_2946":118821},[],"Los bloques son independientes:",{"_3461":70908,"_30106":70864,"_20907":118823,"_5":14363,"_27392":118726,"_2946":118824},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3461":70909,"_30106":70864,"_20907":118826,"_5":14363,"_27392":118726,"_2946":118827},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3461":70910,"_30106":70864,"_20907":118829,"_5":14363,"_27392":118726,"_2946":52019},[],{"_3461":70911,"_30106":70864,"_20907":118831,"_5":14363,"_27392":118726,"_2946":118832},[],"Control aplicado en la operación configurada",{"_3461":70912,"_30106":70864,"_20907":118834,"_5":14363,"_27392":118726,"_2946":52025},[],{"_3461":70913,"_30106":70864,"_20907":118836,"_5":14363,"_27392":118726,"_2946":118837},[],"Validación del certificado presentado.",{"_3461":70914,"_30106":70864,"_20907":118839,"_5":14363,"_27392":118726,"_2946":52031},[],{"_3461":70915,"_30106":70864,"_20907":118841,"_5":14363,"_27392":118726,"_2946":118842},[],"Autorización del webhook configurado.",{"_3461":70916,"_30106":70864,"_20907":118844,"_5":14363,"_27392":118726,"_2946":52037},[],{"_3461":70917,"_30106":70864,"_20907":118846,"_5":14363,"_27392":118726,"_2946":118847},[],"Validación del certificado y, después, aprobación del webhook.",{"_3461":70918,"_30106":70864,"_20907":118849,"_5":14363,"_27392":118726,"_2946":52043},[],{"_3461":70919,"_30106":70864,"_20907":118851,"_5":14363,"_27392":118726,"_2946":118852},[],"Sin autenticación del solicitante por el DMS.",{"_3461":70920,"_30106":70864,"_20907":118854,"_5":14363,"_27392":118726,"_2946":118855},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3461":70921,"_30106":70864,"_20907":118857,"_5":14363,"_27392":118726,"_2946":118858},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3461":70922,"_30106":70864,"_20907":118860,"_5":14363,"_27392":118726,"_2946":118861},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3461":70923,"_30106":70864,"_20907":118863,"_5":14363,"_27392":118726,"_2946":118864},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3461":70924,"_30106":70864,"_20907":118866,"_5":14363,"_27392":118730,"_2946":118867},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3461":70925,"_30106":70864,"_20907":118869,"_5":14363,"_27392":118730,"_2946":118870},[],"Campo de `external_webhook_settings`",{"_3461":70926,"_30106":70864,"_20907":118872,"_5":14363,"_27392":118730,"_2946":118790},[],{"_3461":70927,"_30106":70864,"_20907":118874,"_5":14363,"_27392":118730,"_2946":52069},[],{"_3461":70928,"_30106":70864,"_20907":118876,"_5":14363,"_27392":118730,"_2946":118877},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3461":70929,"_30106":70864,"_20907":118879,"_5":14363,"_27392":118730,"_2946":52075},[],{"_3461":70930,"_30106":70864,"_20907":118881,"_5":14363,"_27392":118730,"_2946":118882},[],"`POST` o `PUT`; `POST` por defecto.",{"_3461":70931,"_30106":70864,"_20907":118884,"_5":14363,"_27392":118730,"_2946":52081},[],{"_3461":70932,"_30106":70864,"_20907":118886,"_5":14363,"_27392":118730,"_2946":118887},[],"Etiqueta usada en los logs del servicio.",{"_3461":70933,"_30106":70864,"_20907":118889,"_5":14363,"_27392":118730,"_2946":52087},[],{"_3461":70934,"_30106":70864,"_20907":118891,"_5":14363,"_27392":118730,"_2946":118892},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3461":70935,"_30106":70864,"_20907":118894,"_5":14363,"_27392":118730,"_2946":52093},[],{"_3461":70936,"_30106":70864,"_20907":118896,"_5":14363,"_27392":118730,"_2946":118897},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3461":70937,"_30106":70864,"_20907":118899,"_5":14363,"_27392":118730,"_2946":52099},[],{"_3461":70938,"_30106":70864,"_20907":118901,"_5":14363,"_27392":118730,"_2946":118902},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3461":70939,"_30106":70864,"_20907":118904,"_5":14363,"_27392":118730,"_2946":52105},[],{"_3461":70940,"_30106":70864,"_20907":118906,"_5":14363,"_27392":118730,"_2946":118907},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3461":70941,"_30106":70864,"_20907":118909,"_5":14363,"_27392":118730,"_2946":52111},[],{"_3461":70942,"_30106":70864,"_20907":118911,"_5":14363,"_27392":118730,"_2946":118912},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3461":70943,"_30106":70864,"_20907":118914,"_5":14363,"_27392":118730,"_2946":52117},[],{"_3461":70944,"_30106":70864,"_20907":118916,"_5":14363,"_27392":118730,"_2946":118917},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3461":70945,"_30106":70864,"_20907":118919,"_5":14363,"_27392":118730,"_2946":52123},[],{"_3461":70946,"_30106":70864,"_20907":118921,"_5":14363,"_27392":118730,"_2946":118922},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3461":70947,"_30106":70864,"_20907":118924,"_5":14363,"_27392":118730,"_2946":118925},[],"Reglas de esa configuración:",{"_3461":70948,"_30106":70864,"_20907":118927,"_5":14363,"_27392":118730,"_2946":118928},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3461":70949,"_30106":70864,"_20907":118930,"_5":14363,"_27392":118730,"_2946":118931},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3461":70950,"_30106":70864,"_20907":118933,"_5":14363,"_27392":118730,"_2946":118934},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3461":70951,"_30106":70864,"_20907":118936,"_5":14363,"_27392":118730,"_2946":118937},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3461":70952,"_30106":70864,"_20907":118939,"_5":14363,"_27392":118730,"_2946":118940},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3461":70953,"_30106":70864,"_20907":118942,"_5":14363,"_27392":118730,"_2946":118943},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3461":70954,"_30106":70864,"_20907":118945,"_5":14363,"_27392":118730,"_2946":118946},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3461":70955,"_30106":70864,"_20907":118948,"_5":14363,"_27392":118730,"_2946":118949},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3461":70956,"_30106":70864,"_20907":118951,"_5":14363,"_27392":118730,"_2946":118952},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3461":70957,"_30106":70864,"_20907":118954,"_5":14363,"_27392":118734,"_2946":118955},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3461":70958,"_30106":70864,"_20907":118957,"_5":14363,"_27392":118738,"_2946":118958},[],"Campo de `settings.reenrollment_settings`",{"_3461":70959,"_30106":70864,"_20907":118960,"_5":14363,"_27392":118738,"_2946":118961},[],"Función",{"_3461":70960,"_30106":70864,"_20907":118963,"_5":14363,"_27392":118738,"_2946":52167},[],{"_3461":70961,"_30106":70864,"_20907":118965,"_5":14363,"_27392":118738,"_2946":118966},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3461":70962,"_30106":70864,"_20907":118968,"_5":14363,"_27392":118738,"_2946":52173},[],{"_3461":70963,"_30106":70864,"_20907":118970,"_5":14363,"_27392":118738,"_2946":118971},[],"Umbral operativo preventivo de monitorización.",{"_3461":70964,"_30106":70864,"_20907":118973,"_5":14363,"_27392":118738,"_2946":52179},[],{"_3461":70965,"_30106":70864,"_20907":118975,"_5":14363,"_27392":118738,"_2946":118976},[],"Umbral operativo crítico de monitorización.",{"_3461":70966,"_30106":70864,"_20907":118978,"_5":14363,"_27392":118738,"_2946":52185},[],{"_3461":70967,"_30106":70864,"_20907":118980,"_5":14363,"_27392":118738,"_2946":118981},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3461":70968,"_30106":70864,"_20907":118983,"_5":14363,"_27392":118738,"_2946":52191},[],{"_3461":70969,"_30106":70864,"_20907":118985,"_5":14363,"_27392":118738,"_2946":118986},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3461":70970,"_30106":70864,"_20907":118988,"_5":14363,"_27392":118738,"_2946":52197},[],{"_3461":70971,"_30106":70864,"_20907":118990,"_5":14363,"_27392":118738,"_2946":118991},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3461":70972,"_30106":70864,"_20907":118993,"_5":14363,"_27392":118738,"_2946":118994},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3461":70973,"_30106":70864,"_20907":118996,"_5":14363,"_27392":118742,"_2946":118997},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3461":70974,"_30106":70864,"_20907":118999,"_5":14363,"_27392":118745,"_2946":116362},[],{"_3461":70975,"_30106":70864,"_20907":119001,"_5":14363,"_27392":118745,"_2946":119002},[],"Qué publica",{"_3461":70976,"_30106":70864,"_20907":119004,"_5":14363,"_27392":118745,"_2946":52214},[],{"_3461":70977,"_30106":70864,"_20907":119006,"_5":14363,"_27392":118745,"_2946":119007},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3461":70978,"_30106":70864,"_20907":119009,"_5":14363,"_27392":118745,"_2946":52220},[],{"_3461":70979,"_30106":70864,"_20907":119011,"_5":14363,"_27392":118745,"_2946":119012},[],"Certificado de la CA emisora seleccionada.",{"_3461":70980,"_30106":70864,"_20907":119014,"_5":14363,"_27392":118745,"_2946":52226},[],{"_3461":70981,"_30106":70864,"_20907":119016,"_5":14363,"_27392":118745,"_2946":119017},[],"Certificados de las CAs elegidas explícitamente.",{"_3461":70982,"_30106":70864,"_20907":119019,"_5":14363,"_27392":118745,"_2946":119020},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3461":70983,"_30106":70864,"_20907":119022,"_5":14363,"_27392":118749,"_2946":119023},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3461":70984,"_30106":70864,"_20907":119025,"_5":14363,"_27392":118749,"_2946":119026},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3461":70985,"_30106":70864,"_20907":119028,"_5":14363,"_27392":118749,"_2946":119029},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3461":70986,"_30106":70864,"_20907":119031,"_5":14363,"_27392":118753,"_2946":119032},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3461":70987,"_30106":70987,"_5":14715,"_2946":119034,"_30438":119035,"_20907":119036,"_27392":70987},"Integra el cliente EST",[49125,117420,51607,118432,118607],[],{"_3461":70988,"_30106":70987,"_20907":119038,"_5":14363,"_27392":70987,"_2946":119039},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3461":70989,"_30106":70987,"_5":30435,"_20907":119041,"_27392":119042,"_2946":115998},[],"/docs/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3461":70990,"_30106":70987,"_5":30435,"_20907":119044,"_27392":119045,"_2946":119046},[],"/docs/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3461":70991,"_30106":70987,"_5":30435,"_20907":119048,"_27392":119049,"_2946":119050},[],"/docs/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3461":70992,"_30106":70987,"_5":30435,"_20907":119052,"_27392":119053,"_2946":119054},[],"/docs/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3461":70993,"_30106":70987,"_5":30435,"_20907":119056,"_27392":119057,"_2946":119058},[],"/docs/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3461":70994,"_30106":70987,"_5":30435,"_20907":119060,"_27392":119061,"_2946":119062},[],"/docs/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3461":70995,"_30106":70987,"_20907":119064,"_5":14363,"_27392":70987,"_2946":119065},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3461":70996,"_30106":70987,"_20907":119067,"_5":14363,"_27392":119042,"_2946":119068},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3461":70997,"_30106":70987,"_20907":119070,"_5":14363,"_27392":119042,"_2946":119071},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3461":70998,"_30106":70987,"_20907":119073,"_5":14363,"_27392":119042,"_2946":119074},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3461":70999,"_30106":70987,"_20907":119076,"_5":14363,"_27392":119045,"_2946":119077},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3461":71000,"_30106":70987,"_20907":119079,"_5":14363,"_27392":119045,"_2946":119080},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3461":71001,"_30106":70987,"_20907":119082,"_5":14363,"_27392":119049,"_2946":119083},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3461":71002,"_30106":70987,"_20907":119085,"_5":14363,"_27392":119049,"_2946":119086},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3461":71003,"_30106":70987,"_20907":119088,"_5":14363,"_27392":119053,"_2946":119089},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3461":71004,"_30106":70987,"_20907":119091,"_5":14363,"_27392":119053,"_2946":119092},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3461":71005,"_30106":70987,"_20907":119094,"_5":14363,"_27392":119057,"_2946":119095},[],"Para el caso de una raíz que emite directamente:",{"_3461":71006,"_30106":70987,"_20907":119097,"_5":14363,"_27392":119057,"_2946":119098},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3461":71007,"_30106":70987,"_20907":119100,"_5":14363,"_27392":119057,"_2946":119101},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3461":71008,"_30106":70987,"_20907":119103,"_5":14363,"_27392":119061,"_2946":119104},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3461":71009,"_30106":71009,"_5":14715,"_2946":119106,"_30438":119107,"_20907":119108,"_27392":71009},"Referencia EST",[49125,117420,51607,118432,118607],[],{"_3461":71010,"_30106":71009,"_20907":119110,"_5":14363,"_27392":71009,"_2946":119111},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3461":71011,"_30106":71009,"_5":30435,"_20907":119113,"_27392":119114,"_2946":119115},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3461":71012,"_30106":71009,"_5":30435,"_20907":119117,"_27392":119118,"_2946":22658},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3461":71013,"_30106":71009,"_5":30435,"_20907":119120,"_27392":119121,"_2946":26007},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3461":71014,"_30106":71009,"_5":30435,"_20907":119123,"_27392":119124,"_2946":26014},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3461":71015,"_30106":71009,"_5":30435,"_20907":119126,"_27392":119127,"_2946":25333},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3461":71016,"_30106":71009,"_5":30435,"_20907":119129,"_27392":119130,"_2946":119131},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3461":71017,"_30106":71009,"_5":30435,"_20907":119133,"_27392":119134,"_2946":119135},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3461":71018,"_30106":71009,"_5":30435,"_20907":119137,"_27392":119138,"_2946":119139},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3461":71019,"_30106":71009,"_20907":119141,"_5":14363,"_27392":71009,"_2946":119142},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3461":71020,"_30106":71009,"_20907":119144,"_5":14363,"_27392":119114,"_2946":119145},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3461":71021,"_30106":71009,"_20907":119147,"_5":14363,"_27392":119114,"_2946":117180},[],{"_3461":71022,"_30106":71009,"_20907":119149,"_5":14363,"_27392":119114,"_2946":119150},[],"Método",{"_3461":71023,"_30106":71009,"_20907":119152,"_5":14363,"_27392":119114,"_2946":119153},[],"Autenticación y condición",{"_3461":71024,"_30106":71009,"_20907":119155,"_5":14363,"_27392":119114,"_2946":52369},[],{"_3461":71025,"_30106":71009,"_20907":119157,"_5":14363,"_27392":119114,"_2946":52372},[],{"_3461":71026,"_30106":71009,"_20907":119159,"_5":14363,"_27392":119114,"_2946":119160},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3461":71027,"_30106":71009,"_20907":119162,"_5":14363,"_27392":119114,"_2946":52378},[],{"_3461":71028,"_30106":71009,"_20907":119164,"_5":14363,"_27392":119114,"_2946":52381},[],{"_3461":71029,"_30106":71009,"_20907":119166,"_5":14363,"_27392":119114,"_2946":119167},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3461":71030,"_30106":71009,"_20907":119169,"_5":14363,"_27392":119114,"_2946":52387},[],{"_3461":71031,"_30106":71009,"_20907":119171,"_5":14363,"_27392":119114,"_2946":52381},[],{"_3461":71032,"_30106":71009,"_20907":119173,"_5":14363,"_27392":119114,"_2946":119174},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3461":71033,"_30106":71009,"_20907":119176,"_5":14363,"_27392":119114,"_2946":52395},[],{"_3461":71034,"_30106":71009,"_20907":119178,"_5":14363,"_27392":119114,"_2946":52381},[],{"_3461":71035,"_30106":71009,"_20907":119180,"_5":14363,"_27392":119114,"_2946":119181},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3461":71036,"_30106":71009,"_20907":119183,"_5":14363,"_27392":119114,"_2946":119184},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3461":71037,"_30106":71009,"_20907":119186,"_5":14363,"_27392":119118,"_2946":119187},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3461":71038,"_30106":71009,"_20907":119189,"_5":14363,"_27392":119118,"_2946":119190},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3461":71039,"_30106":71009,"_20907":119192,"_5":14363,"_27392":119121,"_2946":119193},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3461":71040,"_30106":71009,"_20907":119195,"_5":14363,"_27392":119121,"_2946":119196},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3461":71041,"_30106":71009,"_20907":119198,"_5":14363,"_27392":119124,"_2946":119199},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3461":71042,"_30106":71009,"_20907":119201,"_5":14363,"_27392":119124,"_2946":119202},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3461":71043,"_30106":71009,"_20907":119204,"_5":14363,"_27392":119127,"_2946":119205},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3461":71044,"_30106":71009,"_20907":119207,"_5":14363,"_27392":119127,"_2946":119208},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3461":71045,"_30106":71009,"_20907":119210,"_5":14363,"_27392":119130,"_2946":119211},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3461":71046,"_30106":71009,"_20907":119213,"_5":14363,"_27392":119130,"_2946":119214},[],"Parte",{"_3461":71047,"_30106":71009,"_20907":119216,"_5":14363,"_27392":119130,"_2946":119217},[],"Contenido tras decodificar su Base64",{"_3461":71048,"_30106":71009,"_20907":119219,"_5":14363,"_27392":119130,"_2946":52439},[],{"_3461":71049,"_30106":71009,"_20907":119221,"_5":14363,"_27392":119130,"_2946":119222},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3461":71050,"_30106":71009,"_20907":119224,"_5":14363,"_27392":119130,"_2946":52445},[],{"_3461":71051,"_30106":71009,"_20907":119226,"_5":14363,"_27392":119130,"_2946":119227},[],"PKCS#7 DER con el certificado emitido.",{"_3461":71052,"_30106":71009,"_20907":119229,"_5":14363,"_27392":119130,"_2946":119230},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3461":71053,"_30106":71009,"_20907":119232,"_5":14363,"_27392":119134,"_2946":119233},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3461":71054,"_30106":71009,"_20907":119235,"_5":14363,"_27392":119134,"_2946":119236},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3461":71055,"_30106":71009,"_20907":119238,"_5":14363,"_27392":119134,"_2946":119239},[],"Convierte y comprueba el resultado:",{"_3461":71056,"_30106":71009,"_20907":119241,"_5":14363,"_27392":119134,"_2946":119242},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3461":71057,"_30106":71009,"_20907":119244,"_5":14363,"_27392":119138,"_2946":119245},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3461":71058,"_30106":71009,"_20907":119247,"_5":14363,"_27392":119138,"_2946":119248},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3461":71059,"_30106":71059,"_5":14715,"_2946":118607,"_30438":119250,"_20907":119251,"_27392":71059},[49125,117420,51607,118432,118607],[],{"_3461":71060,"_30106":71059,"_20907":119253,"_5":14363,"_27392":71059,"_2946":119254},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3461":71061,"_30106":71059,"_5":30435,"_20907":119256,"_27392":119257,"_2946":119258},[],"/docs/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3461":71062,"_30106":71059,"_5":30435,"_20907":119260,"_27392":119261,"_2946":119262},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3461":71063,"_30106":71059,"_5":30435,"_20907":119264,"_27392":119265,"_2946":119266},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3461":71064,"_30106":71059,"_5":30435,"_20907":119268,"_27392":119269,"_2946":119270},[],"/docs/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3461":71065,"_30106":71059,"_20907":119272,"_5":14363,"_27392":71059,"_2946":119273},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3461":71066,"_30106":71059,"_20907":119275,"_5":14363,"_27392":119257,"_2946":119276},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3461":71067,"_30106":71059,"_20907":119278,"_5":14363,"_27392":119257,"_2946":119279},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3461":71068,"_30106":71059,"_20907":119281,"_5":14363,"_27392":119257,"_2946":119282},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3461":71069,"_30106":71059,"_20907":119284,"_5":14363,"_27392":119257,"_2946":119285},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3461":71070,"_30106":71059,"_20907":119287,"_5":14363,"_27392":119257,"_2946":119288},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3461":71071,"_30106":71059,"_20907":119290,"_5":14363,"_27392":119257,"_2946":119291},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3461":71072,"_30106":71059,"_20907":119293,"_5":14363,"_27392":119261,"_2946":119294},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3461":71073,"_30106":71059,"_20907":119296,"_5":14363,"_27392":119261,"_2946":119297},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3461":71074,"_30106":71059,"_20907":119299,"_5":14363,"_27392":119261,"_2946":119300},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3461":71075,"_30106":71059,"_20907":119302,"_5":14363,"_27392":119261,"_2946":119303},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3461":71076,"_30106":71059,"_20907":119305,"_5":14363,"_27392":119265,"_2946":119306},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3461":71077,"_30106":71059,"_20907":119308,"_5":14363,"_27392":119265,"_2946":119309},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3461":71078,"_30106":71059,"_20907":119311,"_5":14363,"_27392":119265,"_2946":119312},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3461":71079,"_30106":71059,"_20907":119314,"_5":14363,"_27392":119265,"_2946":119315},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3461":71080,"_30106":71059,"_20907":119317,"_5":14363,"_27392":119269,"_2946":119318},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3461":71081,"_30106":71059,"_20907":119320,"_5":14363,"_27392":119269,"_2946":119321},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3461":71082,"_30106":71082,"_5":14715,"_2946":119323,"_30438":119324,"_20907":119325,"_27392":71082},"Estrategias de aprovisionamiento",[49125,117420,51607,118432,118607],[],{"_3461":71083,"_30106":71082,"_20907":119327,"_5":14363,"_27392":71082,"_2946":119328},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3461":71084,"_30106":71082,"_5":30435,"_20907":119330,"_27392":119331,"_2946":119332},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3461":71085,"_30106":71082,"_5":30435,"_20907":119334,"_27392":119335,"_2946":119336},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3461":71086,"_30106":71082,"_5":30435,"_20907":119338,"_27392":119339,"_2946":119340},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3461":71087,"_30106":71082,"_5":30435,"_20907":119342,"_27392":119343,"_2946":119344},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3461":71088,"_30106":71082,"_5":30435,"_20907":119346,"_27392":119347,"_2946":119348},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3461":71089,"_30106":71082,"_20907":119350,"_5":14363,"_27392":71082,"_2946":119351},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3461":71090,"_30106":71082,"_20907":119353,"_5":14363,"_27392":119331,"_2946":119354},[],"Recorrido",{"_3461":71091,"_30106":71082,"_20907":119356,"_5":14363,"_27392":119331,"_2946":119357},[],"Cuándo existe el dispositivo",{"_3461":71092,"_30106":71082,"_20907":119359,"_5":14363,"_27392":119331,"_2946":119360},[],"Qué compruebas",{"_3461":71093,"_30106":71082,"_20907":119362,"_5":14363,"_27392":119331,"_2946":119363},[],"Asignación manual",{"_3461":71094,"_30106":71082,"_20907":119365,"_5":14363,"_27392":119331,"_2946":119366},[],"El operador lo crea antes de asociar un certificado.",{"_3461":71095,"_30106":71082,"_20907":119368,"_5":14363,"_27392":119331,"_2946":119369},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3461":71096,"_30106":71082,"_20907":119371,"_5":14363,"_27392":119331,"_2946":119372},[],"EST con `JITP`",{"_3461":71097,"_30106":71082,"_20907":119374,"_5":14363,"_27392":119331,"_2946":119375},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3461":71098,"_30106":71082,"_20907":119377,"_5":14363,"_27392":119331,"_2946":119378},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3461":71099,"_30106":71082,"_20907":119380,"_5":14363,"_27392":119331,"_2946":119381},[],"EST con `PRE_REGISTRATION`",{"_3461":71100,"_30106":71082,"_20907":119383,"_5":14363,"_27392":119331,"_2946":119384},[],"Debe existir antes de `/simpleenroll`.",{"_3461":71101,"_30106":71082,"_20907":119386,"_5":14363,"_27392":119331,"_2946":119387},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3461":71102,"_30106":71082,"_20907":119389,"_5":14363,"_27392":119331,"_2946":119390},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3461":71103,"_30106":71082,"_20907":119392,"_5":14363,"_27392":119331,"_2946":119393},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3461":71104,"_30106":71082,"_20907":119395,"_5":14363,"_27392":119335,"_2946":119396},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3461":71105,"_30106":71082,"_20907":119398,"_5":14363,"_27392":119335,"_2946":119399},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3461":71106,"_30106":71082,"_20907":119401,"_5":14363,"_27392":119335,"_2946":119402},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3461":71107,"_30106":71082,"_20907":119404,"_5":14363,"_27392":119339,"_2946":119405},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3461":71108,"_30106":71082,"_20907":119407,"_5":14363,"_27392":119339,"_2946":119408},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3461":71109,"_30106":71082,"_20907":119410,"_5":14363,"_27392":119339,"_2946":119411},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3461":71110,"_30106":71082,"_20907":119413,"_5":14363,"_27392":119339,"_2946":119414},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3461":71111,"_30106":71082,"_20907":119416,"_5":14363,"_27392":119339,"_2946":119417},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3461":71112,"_30106":71082,"_20907":119419,"_5":14363,"_27392":119339,"_2946":119420},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3461":71113,"_30106":71082,"_20907":119422,"_5":14363,"_27392":119343,"_2946":116362},[],{"_3461":71114,"_30106":71082,"_20907":119424,"_5":14363,"_27392":119343,"_2946":119425},[],"Material que atraviesa EST",{"_3461":71115,"_30106":71082,"_20907":119427,"_5":14363,"_27392":119343,"_2946":119428},[],"Clave generada por el dispositivo",{"_3461":71116,"_30106":71082,"_20907":119430,"_5":14363,"_27392":119343,"_2946":119431},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3461":71117,"_30106":71082,"_20907":119433,"_5":14363,"_27392":119343,"_2946":119434},[],"Clave ya disponible en el dispositivo",{"_3461":71118,"_30106":71082,"_20907":119436,"_5":14363,"_27392":119343,"_2946":119437},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3461":71119,"_30106":71082,"_20907":119439,"_5":14363,"_27392":119343,"_2946":51926},[],{"_3461":71120,"_30106":71082,"_20907":119441,"_5":14363,"_27392":119343,"_2946":119442},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3461":71121,"_30106":71082,"_20907":119444,"_5":14363,"_27392":119343,"_2946":119445},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3461":71122,"_30106":71082,"_20907":119447,"_5":14363,"_27392":119347,"_2946":119448},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3461":71123,"_30106":71123,"_5":14715,"_2946":119450,"_30438":119451,"_20907":119452,"_27392":71123},"Renovación y recuperación",[49125,117420,51607,118432,118607],[],{"_3461":71124,"_30106":71123,"_20907":119454,"_5":14363,"_27392":71123,"_2946":119455},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3461":71125,"_30106":71123,"_5":30435,"_20907":119457,"_27392":119458,"_2946":119459},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3461":71126,"_30106":71123,"_5":30435,"_20907":119461,"_27392":119462,"_2946":119463},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3461":71127,"_30106":71123,"_5":30435,"_20907":119465,"_27392":119466,"_2946":119467},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3461":71128,"_30106":71123,"_5":30435,"_20907":119469,"_27392":119470,"_2946":119471},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3461":71129,"_30106":71123,"_5":30435,"_20907":119473,"_27392":119474,"_2946":119475},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3461":71130,"_30106":71123,"_20907":119477,"_5":14363,"_27392":71123,"_2946":119478},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3461":71131,"_30106":71123,"_20907":119480,"_5":14363,"_27392":119458,"_2946":119481},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3461":71132,"_30106":71123,"_20907":119483,"_5":14363,"_27392":119458,"_2946":119484},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3461":71133,"_30106":71123,"_20907":119486,"_5":14363,"_27392":119458,"_2946":119487},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3461":71134,"_30106":71123,"_20907":119489,"_5":14363,"_27392":119458,"_2946":119490},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3461":71135,"_30106":71123,"_20907":119492,"_5":14363,"_27392":119462,"_2946":119493},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3461":71136,"_30106":71123,"_20907":119495,"_5":14363,"_27392":119462,"_2946":119496},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3461":71137,"_30106":71123,"_20907":119498,"_5":14363,"_27392":119466,"_2946":119499},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3461":71138,"_30106":71123,"_20907":119501,"_5":14363,"_27392":119466,"_2946":119502},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3461":71139,"_30106":71123,"_20907":119504,"_5":14363,"_27392":119466,"_2946":119505},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3461":71140,"_30106":71123,"_20907":119507,"_5":14363,"_27392":119470,"_2946":119508},[],"Situación",{"_3461":71141,"_30106":71123,"_20907":119510,"_5":14363,"_27392":119470,"_2946":119511},[],"Procedimiento",{"_3461":71142,"_30106":71123,"_20907":119513,"_5":14363,"_27392":119470,"_2946":119514},[],"Certificado vigente, fuera de ventana",{"_3461":71143,"_30106":71123,"_20907":119516,"_5":14363,"_27392":119470,"_2946":119517},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3461":71144,"_30106":71123,"_20907":119519,"_5":14363,"_27392":119470,"_2946":119520},[],"Certificado vencido, clave disponible",{"_3461":71145,"_30106":71123,"_20907":119522,"_5":14363,"_27392":119470,"_2946":119523},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3461":71146,"_30106":71123,"_20907":119525,"_5":14363,"_27392":119470,"_2946":119526},[],"Renovación por webhook o `NO_AUTH`",{"_3461":71147,"_30106":71123,"_20907":119528,"_5":14363,"_27392":119470,"_2946":119529},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3461":71148,"_30106":71123,"_20907":119531,"_5":14363,"_27392":119470,"_2946":119532},[],"Clave perdida o inaccesible",{"_3461":71149,"_30106":71123,"_20907":119534,"_5":14363,"_27392":119470,"_2946":119535},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3461":71150,"_30106":71123,"_20907":119537,"_5":14363,"_27392":119470,"_2946":119538},[],"Identidad actual revocada",{"_3461":71151,"_30106":71123,"_20907":119540,"_5":14363,"_27392":119470,"_2946":119541},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3461":71152,"_30106":71123,"_20907":119543,"_5":14363,"_27392":119470,"_2946":119544},[],"Dispositivo sin identidad",{"_3461":71153,"_30106":71123,"_20907":119546,"_5":14363,"_27392":119470,"_2946":119547},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3461":71154,"_30106":71123,"_20907":119549,"_5":14363,"_27392":119470,"_2946":119550},[],"Dispositivo retirado",{"_3461":71155,"_30106":71123,"_20907":119552,"_5":14363,"_27392":119470,"_2946":119553},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3461":71156,"_30106":71123,"_20907":119555,"_5":14363,"_27392":119470,"_2946":119556},[],"Timeout, HTTP 500 o fallo de instalación",{"_3461":71157,"_30106":71123,"_20907":119558,"_5":14363,"_27392":119470,"_2946":119559},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3461":71158,"_30106":71123,"_20907":119561,"_5":14363,"_27392":119474,"_2946":119562},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3461":71159,"_30106":71123,"_20907":119564,"_5":14363,"_27392":119474,"_2946":119565},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3461":71160,"_30106":71160,"_5":14715,"_2946":119567,"_30438":119568,"_20907":119569,"_27392":71160},"Diagnóstico de enrolamiento",[49125,117420,51607,118432,118607],[],{"_3461":71161,"_30106":71160,"_20907":119571,"_5":14363,"_27392":71160,"_2946":119572},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3461":71162,"_30106":71160,"_5":30435,"_20907":119574,"_27392":119575,"_2946":119576},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3461":71163,"_30106":71160,"_5":30435,"_20907":119578,"_27392":119579,"_2946":119580},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3461":71164,"_30106":71160,"_5":30435,"_20907":119582,"_27392":119583,"_2946":119139},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3461":71165,"_30106":71160,"_5":30435,"_20907":119585,"_27392":119586,"_2946":119587},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3461":71166,"_30106":71160,"_20907":119589,"_5":14363,"_27392":71160,"_2946":119590},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3461":71167,"_30106":71160,"_20907":119592,"_5":14363,"_27392":119579,"_2946":119593},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3461":71168,"_30106":71160,"_20907":119595,"_5":14363,"_27392":119579,"_2946":119596},[],"Síntoma o mensaje",{"_3461":71169,"_30106":71160,"_20907":119598,"_5":14363,"_27392":119579,"_2946":119599},[],"Qué revisar",{"_3461":71170,"_30106":71160,"_20907":119601,"_5":14363,"_27392":119579,"_2946":119602},[],"curl rechaza TLS, nombre o emisor",{"_3461":71171,"_30106":71160,"_20907":119604,"_5":14363,"_27392":119579,"_2946":119605},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3461":71172,"_30106":71160,"_20907":119607,"_5":14363,"_27392":119579,"_2946":119608},[],"404 o APS ausente",{"_3461":71173,"_30106":71160,"_20907":119610,"_5":14363,"_27392":119579,"_2946":119611},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3461":71174,"_30106":71160,"_20907":119613,"_5":14363,"_27392":119579,"_2946":119614},[],"400, error de CSR o formato",{"_3461":71175,"_30106":71160,"_20907":119616,"_5":14363,"_27392":119579,"_2946":119617},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3461":71176,"_30106":71160,"_20907":119619,"_5":14363,"_27392":119579,"_2946":119620},[],"Credencial ausente o certificado no válido",{"_3461":71177,"_30106":71160,"_20907":119622,"_5":14363,"_27392":119579,"_2946":119623},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3461":71178,"_30106":71160,"_20907":119625,"_5":14363,"_27392":119579,"_2946":119626},[],"Webhook deniega, expira o responde sin autorización",{"_3461":71179,"_30106":71160,"_20907":119628,"_5":14363,"_27392":119579,"_2946":119629},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3461":71180,"_30106":71160,"_20907":119631,"_5":14363,"_27392":119579,"_2946":52852},[],{"_3461":71181,"_30106":71160,"_20907":119633,"_5":14363,"_27392":119579,"_2946":119634},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3461":71182,"_30106":71160,"_20907":119636,"_5":14363,"_27392":119579,"_2946":52858},[],{"_3461":71183,"_30106":71160,"_20907":119638,"_5":14363,"_27392":119579,"_2946":119639},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3461":71184,"_30106":71160,"_20907":119641,"_5":14363,"_27392":119579,"_2946":52864},[],{"_3461":71185,"_30106":71160,"_20907":119643,"_5":14363,"_27392":119579,"_2946":119644},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3461":71186,"_30106":71160,"_20907":119646,"_5":14363,"_27392":119579,"_2946":52870},[],{"_3461":71187,"_30106":71160,"_20907":119648,"_5":14363,"_27392":119579,"_2946":119649},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3461":71188,"_30106":71160,"_20907":119651,"_5":14363,"_27392":119579,"_2946":52876},[],{"_3461":71189,"_30106":71160,"_20907":119653,"_5":14363,"_27392":119579,"_2946":119654},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3461":71190,"_30106":71160,"_20907":119656,"_5":14363,"_27392":119579,"_2946":119657},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3461":71191,"_30106":71160,"_20907":119659,"_5":14363,"_27392":119579,"_2946":119660},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3461":71192,"_30106":71160,"_20907":119662,"_5":14363,"_27392":119579,"_2946":119663},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3461":71193,"_30106":71160,"_20907":119665,"_5":14363,"_27392":119579,"_2946":119666},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3461":71194,"_30106":71160,"_20907":119668,"_5":14363,"_27392":119579,"_2946":52894},[],{"_3461":71195,"_30106":71160,"_20907":119670,"_5":14363,"_27392":119579,"_2946":119671},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3461":71196,"_30106":71160,"_20907":119673,"_5":14363,"_27392":119579,"_2946":52900},[],{"_3461":71197,"_30106":71160,"_20907":119675,"_5":14363,"_27392":119579,"_2946":119676},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3461":71198,"_30106":71160,"_20907":119678,"_5":14363,"_27392":119579,"_2946":119679},[],"DMS propietario distinto",{"_3461":71199,"_30106":71160,"_20907":119681,"_5":14363,"_27392":119579,"_2946":119682},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3461":71200,"_30106":71160,"_20907":119684,"_5":14363,"_27392":119579,"_2946":52912},[],{"_3461":71201,"_30106":71160,"_20907":119686,"_5":14363,"_27392":119579,"_2946":119687},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3461":71202,"_30106":71160,"_20907":119689,"_5":14363,"_27392":119579,"_2946":52918},[],{"_3461":71203,"_30106":71160,"_20907":119691,"_5":14363,"_27392":119579,"_2946":119692},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3461":71204,"_30106":71160,"_20907":119694,"_5":14363,"_27392":119579,"_2946":119695},[],"Certificado actual revocado",{"_3461":71205,"_30106":71160,"_20907":119697,"_5":14363,"_27392":119579,"_2946":119698},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3461":71206,"_30106":71160,"_20907":119700,"_5":14363,"_27392":119579,"_2946":119701},[],"Error de CA, perfil o firma",{"_3461":71207,"_30106":71160,"_20907":119703,"_5":14363,"_27392":119579,"_2946":119704},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3461":71208,"_30106":71160,"_20907":119706,"_5":14363,"_27392":119579,"_2946":119707},[],"HTTP 200 sin conexión del dispositivo",{"_3461":71209,"_30106":71160,"_20907":119709,"_5":14363,"_27392":119579,"_2946":119710},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3461":71210,"_30106":71160,"_20907":119712,"_5":14363,"_27392":119579,"_2946":119713},[],"Timeout o error después de emitir",{"_3461":71211,"_30106":71160,"_20907":119715,"_5":14363,"_27392":119579,"_2946":119716},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3461":71212,"_30106":71160,"_20907":119718,"_5":14363,"_27392":119583,"_2946":119719},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3461":71213,"_30106":71160,"_20907":119721,"_5":14363,"_27392":119583,"_2946":119722},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3461":71214,"_30106":71160,"_20907":119724,"_5":14363,"_27392":119586,"_2946":119725},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3461":71215,"_30106":71160,"_20907":119727,"_5":14363,"_27392":119586,"_2946":119728},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3461":71216,"_30106":71160,"_20907":119730,"_5":14363,"_27392":119586,"_2946":119731},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3461":71217,"_30106":71160,"_20907":119733,"_5":14363,"_27392":119586,"_2946":119734},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3461":71218,"_30106":71160,"_20907":119736,"_5":14363,"_27392":119586,"_2946":119737},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3461":71219,"_30106":71160,"_20907":119739,"_5":14363,"_27392":119586,"_2946":119740},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3461":71220,"_30106":71160,"_20907":119742,"_5":14363,"_27392":119586,"_2946":119743},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3461":71221,"_30106":71221,"_5":14715,"_2946":119745,"_30438":119746,"_20907":119747,"_27392":71221},"Distribución y actualización de confianza",[49125,117420,51607,118432,118607],[],{"_3461":71222,"_30106":71221,"_20907":119749,"_5":14363,"_27392":71221,"_2946":119750},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3461":71223,"_30106":71221,"_5":30435,"_20907":119752,"_27392":119753,"_2946":119754},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3461":71224,"_30106":71221,"_5":30435,"_20907":119756,"_27392":119757,"_2946":119758},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3461":71225,"_30106":71221,"_5":30435,"_20907":119760,"_27392":119761,"_2946":119762},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3461":71226,"_30106":71221,"_5":30435,"_20907":119764,"_27392":119765,"_2946":119766},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3461":71227,"_30106":71221,"_5":30435,"_20907":119768,"_27392":119769,"_2946":119770},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3461":71228,"_30106":71221,"_20907":119772,"_5":14363,"_27392":71221,"_2946":119773},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3461":71229,"_30106":71221,"_20907":119775,"_5":14363,"_27392":119753,"_2946":119776},[],"Relación",{"_3461":71230,"_30106":71221,"_20907":119778,"_5":14363,"_27392":119753,"_2946":119779},[],"Material que prepara el responsable",{"_3461":71231,"_30106":71221,"_20907":119781,"_5":14363,"_27392":119753,"_2946":119782},[],"Dispositivo → servidor EST",{"_3461":71232,"_30106":71221,"_20907":119784,"_5":14363,"_27392":119753,"_2946":119785},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3461":71233,"_30106":71221,"_20907":119787,"_5":14363,"_27392":119753,"_2946":119788},[],"DMS → solicitante",{"_3461":71234,"_30106":71221,"_20907":119790,"_5":14363,"_27392":119753,"_2946":119791},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3461":71235,"_30106":71221,"_20907":119793,"_5":14363,"_27392":119753,"_2946":119794},[],"Consumidor → dispositivo",{"_3461":71236,"_30106":71221,"_20907":119796,"_5":14363,"_27392":119753,"_2946":119797},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3461":71237,"_30106":71221,"_20907":119799,"_5":14363,"_27392":119753,"_2946":119800},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3461":71238,"_30106":71221,"_20907":119802,"_5":14363,"_27392":119757,"_2946":119803},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3461":71239,"_30106":71221,"_20907":119805,"_5":14363,"_27392":119757,"_2946":119806},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3461":71240,"_30106":71221,"_20907":119808,"_5":14363,"_27392":119761,"_2946":119809},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3461":71241,"_30106":71221,"_20907":119811,"_5":14363,"_27392":119761,"_2946":119812},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3461":71242,"_30106":71221,"_20907":119814,"_5":14363,"_27392":119761,"_2946":119815},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3461":71243,"_30106":71221,"_20907":119817,"_5":14363,"_27392":119761,"_2946":119818},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3461":71244,"_30106":71221,"_20907":119820,"_5":14363,"_27392":119761,"_2946":119821},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3461":71245,"_30106":71221,"_20907":119823,"_5":14363,"_27392":119761,"_2946":119824},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3461":71246,"_30106":71221,"_20907":119826,"_5":14363,"_27392":119765,"_2946":119827},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3461":71247,"_30106":71221,"_20907":119829,"_5":14363,"_27392":119765,"_2946":119830},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3461":71248,"_30106":71221,"_20907":119832,"_5":14363,"_27392":119765,"_2946":119833},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3461":71249,"_30106":71221,"_20907":119835,"_5":14363,"_27392":119769,"_2946":119836},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3461":71250,"_30106":71250,"_5":14715,"_2946":53067,"_30438":119838,"_20907":119840,"_27392":71250},[49125,117420,51607,118432,119839],"Integraciones",[],{"_3461":71251,"_30106":71250,"_20907":119842,"_5":14363,"_27392":71250,"_2946":119843},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3461":71252,"_30106":71250,"_5":30435,"_20907":119845,"_27392":119846,"_2946":119847},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3461":71253,"_30106":71250,"_5":30435,"_20907":119849,"_27392":119850,"_2946":119851},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3461":71254,"_30106":71250,"_5":30435,"_20907":119853,"_27392":119854,"_2946":119855},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3461":71255,"_30106":71250,"_5":30435,"_20907":119857,"_27392":119858,"_2946":119859},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3461":71256,"_30106":71250,"_5":30435,"_20907":119861,"_27392":119862,"_2946":119863},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3461":71257,"_30106":71250,"_5":30435,"_20907":119865,"_27392":119866,"_2946":119867},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3461":71258,"_30106":71250,"_5":30435,"_20907":119869,"_27392":119870,"_2946":119871},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3461":71259,"_30106":71250,"_5":30435,"_20907":119873,"_27392":119874,"_2946":119875},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3461":71260,"_30106":71250,"_5":30435,"_20907":119877,"_27392":119878,"_2946":53109},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3461":71261,"_30106":71250,"_5":30435,"_20907":119880,"_27392":119881,"_2946":53113},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3461":71262,"_30106":71250,"_5":30435,"_20907":119883,"_27392":119884,"_2946":119885},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3461":71263,"_30106":71250,"_5":30435,"_20907":119887,"_27392":119888,"_2946":119889},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3461":71264,"_30106":71250,"_5":30435,"_20907":119891,"_27392":119892,"_2946":119893},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3461":71265,"_30106":71250,"_5":30435,"_20907":119895,"_27392":119896,"_2946":119897},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3461":71266,"_30106":71250,"_5":30435,"_20907":119899,"_27392":119900,"_2946":119901},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3461":71267,"_30106":71250,"_5":30435,"_20907":119903,"_27392":119904,"_2946":119905},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3461":71268,"_30106":71250,"_5":30435,"_20907":119907,"_27392":119908,"_2946":119909},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3461":71269,"_30106":71250,"_5":30435,"_20907":119911,"_27392":119912,"_2946":119913},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3461":71270,"_30106":71250,"_5":30435,"_20907":119915,"_27392":119916,"_2946":119917},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3461":71271,"_30106":71250,"_5":30435,"_20907":119919,"_27392":119920,"_2946":119921},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3461":71272,"_30106":71250,"_5":30435,"_20907":119923,"_27392":119924,"_2946":119925},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3461":71273,"_30106":71250,"_5":30435,"_20907":119927,"_27392":119928,"_2946":119929},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3461":71274,"_30106":71250,"_5":30435,"_20907":119931,"_27392":119932,"_2946":119933},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3461":71275,"_30106":71250,"_5":30435,"_20907":119935,"_27392":119936,"_2946":119937},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3461":71276,"_30106":71250,"_5":30435,"_20907":119939,"_27392":119940,"_2946":119941},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3461":71277,"_30106":71250,"_20907":119943,"_5":14363,"_27392":71250,"_2946":119944},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3461":71278,"_30106":71250,"_20907":119946,"_5":14363,"_27392":71250,"_2946":119947},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3461":71279,"_30106":71250,"_20907":119949,"_5":14363,"_27392":71250,"_2946":119950},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3461":71280,"_30106":71250,"_20907":119952,"_5":14363,"_27392":119846,"_2946":119953},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3461":71281,"_30106":71250,"_20907":119955,"_5":14363,"_27392":119846,"_2946":119956},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3461":71282,"_30106":71250,"_20907":119958,"_5":14363,"_27392":119846,"_2946":119959},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3461":71283,"_30106":71250,"_20907":119961,"_5":14363,"_27392":119846,"_2946":119962},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3461":71284,"_30106":71250,"_20907":119964,"_5":14363,"_27392":119850,"_2946":119965},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3461":71285,"_30106":71250,"_20907":119967,"_5":14363,"_27392":119854,"_2946":119968},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3461":71286,"_30106":71250,"_20907":119970,"_5":14363,"_27392":119854,"_2946":119971},[],"Acción IAM",{"_3461":71287,"_30106":71250,"_20907":119973,"_5":14363,"_27392":119854,"_2946":116368},[],{"_3461":71288,"_30106":71250,"_20907":119975,"_5":14363,"_27392":119854,"_2946":53208},[],{"_3461":71289,"_30106":71250,"_20907":119977,"_5":14363,"_27392":119854,"_2946":119978},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3461":71290,"_30106":71250,"_20907":119980,"_5":14363,"_27392":119854,"_2946":53214},[],{"_3461":71291,"_30106":71250,"_20907":119982,"_5":14363,"_27392":119854,"_2946":119983},[],"Registrar la CA en AWS IoT",{"_3461":71292,"_30106":71250,"_20907":119985,"_5":14363,"_27392":119854,"_2946":53220},[],{"_3461":71293,"_30106":71250,"_20907":119987,"_5":14363,"_27392":119854,"_2946":119988},[],"Consultar el estado del registro de la CA",{"_3461":71294,"_30106":71250,"_20907":119990,"_5":14363,"_27392":119854,"_2946":53226},[],{"_3461":71295,"_30106":71250,"_20907":119992,"_5":14363,"_27392":119854,"_2946":119993},[],"Crear o actualizar Things en IoT Core",{"_3461":71296,"_30106":71250,"_20907":119995,"_5":14363,"_27392":119854,"_2946":53232},[],{"_3461":71297,"_30106":71250,"_20907":119997,"_5":14363,"_27392":119854,"_2946":119998},[],"Aprovisionar Things mediante plantilla",{"_3461":71298,"_30106":71250,"_20907":120000,"_5":14363,"_27392":119854,"_2946":53238},[],{"_3461":71299,"_30106":71250,"_20907":120002,"_5":14363,"_27392":119854,"_2946":120003},[],"Registrar certificados de dispositivo",{"_3461":71300,"_30106":71250,"_20907":120005,"_5":14363,"_27392":119854,"_2946":53244},[],{"_3461":71301,"_30106":71250,"_20907":120007,"_5":14363,"_27392":119854,"_2946":120008},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3461":71302,"_30106":71250,"_20907":120010,"_5":14363,"_27392":119854,"_2946":53250},[],{"_3461":71303,"_30106":71250,"_20907":120012,"_5":14363,"_27392":119854,"_2946":120013},[],"Crear y adjuntar políticas IoT",{"_3461":71304,"_30106":71250,"_20907":120015,"_5":14363,"_27392":119854,"_2946":53256},[],{"_3461":71305,"_30106":71250,"_20907":120017,"_5":14363,"_27392":119854,"_2946":120018},[],"Gestionar grupos de Things",{"_3461":71306,"_30106":71250,"_20907":120020,"_5":14363,"_27392":119854,"_2946":53262},[],{"_3461":71307,"_30106":71250,"_20907":120022,"_5":14363,"_27392":119854,"_2946":120023},[],"Crear plantillas JITP",{"_3461":71308,"_30106":71250,"_20907":120025,"_5":14363,"_27392":119854,"_2946":53268},[],{"_3461":71309,"_30106":71250,"_20907":120027,"_5":14363,"_27392":119854,"_2946":120028},[],"Leer y escribir el Device Shadow",{"_3461":71310,"_30106":71250,"_20907":120030,"_5":14363,"_27392":119854,"_2946":120031},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3461":71311,"_30106":71250,"_20907":120033,"_5":14363,"_27392":119858,"_2946":120034},[],"Parámetro",{"_3461":71312,"_30106":71250,"_20907":120036,"_5":14363,"_27392":119858,"_2946":120037},[],"Tipo",{"_3461":71313,"_30106":71250,"_20907":120039,"_5":14363,"_27392":119858,"_2946":120040},[],"Requerido",{"_3461":71314,"_30106":71250,"_20907":120042,"_5":14363,"_27392":119858,"_2946":120043},[],"Descripción",{"_3461":71315,"_30106":71250,"_20907":120045,"_5":14363,"_27392":119858,"_2946":53289},[],{"_3461":71316,"_30106":71250,"_20907":120047,"_5":14363,"_27392":119858,"_2946":24973},[],{"_3461":71317,"_30106":71250,"_20907":120049,"_5":14363,"_27392":119858,"_2946":120050},[],"Sí",{"_3461":71318,"_30106":71250,"_20907":120052,"_5":14363,"_27392":119858,"_2946":120053},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3461":71319,"_30106":71250,"_20907":120055,"_5":14363,"_27392":119858,"_2946":53300},[],{"_3461":71320,"_30106":71250,"_20907":120057,"_5":14363,"_27392":119858,"_2946":24973},[],{"_3461":71321,"_30106":71250,"_20907":120059,"_5":14363,"_27392":119858,"_2946":120050},[],{"_3461":71322,"_30106":71250,"_20907":120061,"_5":14363,"_27392":119858,"_2946":120062},[],"Región AWS donde opera el conector.",{"_3461":71323,"_30106":71250,"_20907":120064,"_5":14363,"_27392":119858,"_2946":53310},[],{"_3461":71324,"_30106":71250,"_20907":120066,"_5":14363,"_27392":119858,"_2946":24973},[],{"_3461":71325,"_30106":71250,"_20907":120068,"_5":14363,"_27392":119858,"_2946":120050},[],{"_3461":71326,"_30106":71250,"_20907":120070,"_5":14363,"_27392":119858,"_2946":120071},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3461":71327,"_30106":71250,"_20907":120073,"_5":14363,"_27392":119858,"_2946":53320},[],{"_3461":71328,"_30106":71250,"_20907":120075,"_5":14363,"_27392":119858,"_2946":24973},[],{"_3461":71329,"_30106":71250,"_20907":120077,"_5":14363,"_27392":119858,"_2946":120078},[],"Solo con `auth_method=static`",{"_3461":71330,"_30106":71250,"_20907":120080,"_5":14363,"_27392":119858,"_2946":120081},[],"Clave de acceso AWS.",{"_3461":71331,"_30106":71250,"_20907":120083,"_5":14363,"_27392":119858,"_2946":53331},[],{"_3461":71332,"_30106":71250,"_20907":120085,"_5":14363,"_27392":119858,"_2946":24973},[],{"_3461":71333,"_30106":71250,"_20907":120087,"_5":14363,"_27392":119858,"_2946":120078},[],{"_3461":71334,"_30106":71250,"_20907":120089,"_5":14363,"_27392":119858,"_2946":120090},[],"Clave secreta AWS.",{"_3461":71335,"_30106":71250,"_20907":120092,"_5":14363,"_27392":119858,"_2946":53341},[],{"_3461":71336,"_30106":71250,"_20907":120094,"_5":14363,"_27392":119858,"_2946":24973},[],{"_3461":71337,"_30106":71250,"_20907":120096,"_5":14363,"_27392":119858,"_2946":53346},[],{"_3461":71338,"_30106":71250,"_20907":120098,"_5":14363,"_27392":119858,"_2946":120099},[],"Token de sesión (con `auth_method=static`).",{"_3461":71339,"_30106":71250,"_20907":120101,"_5":14363,"_27392":119858,"_2946":53352},[],{"_3461":71340,"_30106":71250,"_20907":120103,"_5":14363,"_27392":119858,"_2946":24973},[],{"_3461":71341,"_30106":71250,"_20907":120105,"_5":14363,"_27392":119858,"_2946":120106},[],"Solo con `auth_method=role`",{"_3461":71342,"_30106":71250,"_20907":120108,"_5":14363,"_27392":119858,"_2946":120109},[],"ARN del rol a asumir.",{"_3461":71343,"_30106":71250,"_20907":120111,"_5":14363,"_27392":119858,"_2946":53363},[],{"_3461":71344,"_30106":71250,"_20907":120113,"_5":14363,"_27392":119858,"_2946":24973},[],{"_3461":71345,"_30106":71250,"_20907":120115,"_5":14363,"_27392":119858,"_2946":53346},[],{"_3461":71346,"_30106":71250,"_20907":120117,"_5":14363,"_27392":119858,"_2946":120118},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3461":71347,"_30106":71250,"_20907":120120,"_5":14363,"_27392":119858,"_2946":53373},[],{"_3461":71348,"_30106":71250,"_20907":120122,"_5":14363,"_27392":119858,"_2946":89556},[],{"_3461":71349,"_30106":71250,"_20907":120124,"_5":14363,"_27392":119858,"_2946":120050},[],{"_3461":71350,"_30106":71250,"_20907":120126,"_5":14363,"_27392":119858,"_2946":120127},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3461":71351,"_30106":71250,"_20907":120129,"_5":14363,"_27392":119858,"_2946":53383},[],{"_3461":71352,"_30106":71250,"_20907":120131,"_5":14363,"_27392":119858,"_2946":24973},[],{"_3461":71353,"_30106":71250,"_20907":120133,"_5":14363,"_27392":119858,"_2946":120050},[],{"_3461":71354,"_30106":71250,"_20907":120135,"_5":14363,"_27392":119858,"_2946":120136},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3461":71355,"_30106":71250,"_20907":120138,"_5":14363,"_27392":119858,"_2946":53393},[],{"_3461":71356,"_30106":71250,"_20907":120140,"_5":14363,"_27392":119858,"_2946":24973},[],{"_3461":71357,"_30106":71250,"_20907":120142,"_5":14363,"_27392":119858,"_2946":120050},[],{"_3461":71358,"_30106":71250,"_20907":120144,"_5":14363,"_27392":119858,"_2946":120145},[],"URL HTTP del Device Manager de Lamassu.",{"_3461":71359,"_30106":71250,"_20907":120147,"_5":14363,"_27392":119858,"_2946":53403},[],{"_3461":71360,"_30106":71250,"_20907":120149,"_5":14363,"_27392":119858,"_2946":24973},[],{"_3461":71361,"_30106":71250,"_20907":120151,"_5":14363,"_27392":119858,"_2946":120050},[],{"_3461":71362,"_30106":71250,"_20907":120153,"_5":14363,"_27392":119858,"_2946":120154},[],"URL HTTP del servicio de CA de Lamassu.",{"_3461":71363,"_30106":71250,"_20907":120156,"_5":14363,"_27392":119862,"_2946":120157},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3461":71364,"_30106":71250,"_20907":120159,"_5":14363,"_27392":119862,"_2946":120160},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3461":71365,"_30106":71250,"_20907":120162,"_5":14363,"_27392":119862,"_2946":120163},[],"Tipo de CloudEvent",{"_3461":71366,"_30106":71250,"_20907":120165,"_5":14363,"_27392":119862,"_2946":120166},[],"Recurso en Lamassu",{"_3461":71367,"_30106":71250,"_20907":120168,"_5":14363,"_27392":119862,"_2946":120169},[],"Recurso AWS",{"_3461":71368,"_30106":71250,"_20907":120171,"_5":14363,"_27392":119862,"_2946":120172},[],"Acciones IAM",{"_3461":71369,"_30106":71250,"_20907":120174,"_5":14363,"_27392":119862,"_2946":120175},[],"Llamadas AWS y efecto",{"_3461":71370,"_30106":71250,"_20907":120177,"_5":14363,"_27392":119862,"_2946":120178},[],"Dónde en esta página",{"_3461":71371,"_30106":71250,"_20907":120180,"_5":14363,"_27392":119862,"_2946":53437},[],{"_3461":71372,"_30106":71250,"_20907":120182,"_5":14363,"_27392":119862,"_2946":53440},[],{"_3461":71373,"_30106":71250,"_20907":120184,"_5":14363,"_27392":119862,"_2946":53443},[],{"_3461":71374,"_30106":71250,"_20907":120186,"_5":14363,"_27392":119862,"_2946":53446},[],{"_3461":71375,"_30106":71250,"_20907":120188,"_5":14363,"_27392":119862,"_2946":120189},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3461":71376,"_30106":71250,"_20907":120191,"_5":14363,"_27392":119862,"_2946":119875},[],{"_3461":71377,"_30106":71250,"_20907":120193,"_5":14363,"_27392":119862,"_2946":53454},[],{"_3461":71378,"_30106":71250,"_20907":120195,"_5":14363,"_27392":119862,"_2946":53457},[],{"_3461":71379,"_30106":71250,"_20907":120197,"_5":14363,"_27392":119862,"_2946":53460},[],{"_3461":71380,"_30106":71250,"_20907":120199,"_5":14363,"_27392":119862,"_2946":53463},[],{"_3461":71381,"_30106":71250,"_20907":120201,"_5":14363,"_27392":119862,"_2946":120202},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3461":71382,"_30106":71250,"_20907":120204,"_5":14363,"_27392":119862,"_2946":119901},[],{"_3461":71383,"_30106":71250,"_20907":120206,"_5":14363,"_27392":119862,"_2946":53471},[],{"_3461":71384,"_30106":71250,"_20907":120208,"_5":14363,"_27392":119862,"_2946":120209},[],"Dispositivo",{"_3461":71385,"_30106":71250,"_20907":120211,"_5":14363,"_27392":119862,"_2946":53477},[],{"_3461":71386,"_30106":71250,"_20907":120213,"_5":14363,"_27392":119862,"_2946":53480},[],{"_3461":71387,"_30106":71250,"_20907":120215,"_5":14363,"_27392":119862,"_2946":120216},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3461":71388,"_30106":71250,"_20907":120218,"_5":14363,"_27392":119862,"_2946":119909},[],{"_3461":71389,"_30106":71250,"_20907":120220,"_5":14363,"_27392":119862,"_2946":53488},[],{"_3461":71390,"_30106":71250,"_20907":120222,"_5":14363,"_27392":119862,"_2946":120223},[],"Certificado",{"_3461":71391,"_30106":71250,"_20907":120225,"_5":14363,"_27392":119862,"_2946":53494},[],{"_3461":71392,"_30106":71250,"_20907":120227,"_5":14363,"_27392":119862,"_2946":120228},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3461":71393,"_30106":71250,"_20907":120230,"_5":14363,"_27392":119862,"_2946":120231},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3461":71394,"_30106":71250,"_20907":120233,"_5":14363,"_27392":119862,"_2946":119921},[],{"_3461":71395,"_30106":71250,"_20907":120235,"_5":14363,"_27392":119862,"_2946":53505},[],{"_3461":71396,"_30106":71250,"_20907":120237,"_5":14363,"_27392":119862,"_2946":120238},[],"Certificado / Dispositivo",{"_3461":71397,"_30106":71250,"_20907":120240,"_5":14363,"_27392":119862,"_2946":53511},[],{"_3461":71398,"_30106":71250,"_20907":120242,"_5":14363,"_27392":119862,"_2946":49521},[],{"_3461":71399,"_30106":71250,"_20907":120244,"_5":14363,"_27392":119862,"_2946":120245},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3461":71400,"_30106":71250,"_20907":120247,"_5":14363,"_27392":119862,"_2946":119929},[],{"_3461":71401,"_30106":71250,"_20907":120249,"_5":14363,"_27392":119866,"_2946":120250},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3461":71402,"_30106":71250,"_20907":120252,"_5":14363,"_27392":119870,"_2946":120253},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3461":71403,"_30106":71250,"_20907":120255,"_5":14363,"_27392":119870,"_2946":120256},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3461":71404,"_30106":71250,"_20907":120258,"_5":14363,"_27392":119874,"_2946":120259},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3461":71405,"_30106":71250,"_20907":120261,"_5":14363,"_27392":119874,"_2946":120262},[],"Transición",{"_3461":71406,"_30106":71250,"_20907":120264,"_5":14363,"_27392":119874,"_2946":120265},[],"Llamadas AWS",{"_3461":71407,"_30106":71250,"_20907":120267,"_5":14363,"_27392":119874,"_2946":120268},[],"`NoRegistrada` → `Solicitada`",{"_3461":71408,"_30106":71250,"_20907":120270,"_5":14363,"_27392":119874,"_2946":120271},[],"ninguna (solo escritura de metadatos)",{"_3461":71409,"_30106":71250,"_20907":120273,"_5":14363,"_27392":119874,"_2946":120274},[],"`Solicitada` → `Registrando`",{"_3461":71410,"_30106":71250,"_20907":120276,"_5":14363,"_27392":119874,"_2946":120277},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3461":71411,"_30106":71250,"_20907":120279,"_5":14363,"_27392":119874,"_2946":120280},[],"`Registrando` → `Completada`",{"_3461":71412,"_30106":71250,"_20907":120282,"_5":14363,"_27392":119874,"_2946":120283},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3461":71413,"_30106":71250,"_20907":120285,"_5":14363,"_27392":119874,"_2946":120286},[],"`Registrando` → `Fallida`",{"_3461":71414,"_30106":71250,"_20907":120288,"_5":14363,"_27392":119874,"_2946":120289},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3461":71415,"_30106":71250,"_20907":120291,"_5":14363,"_27392":119874,"_2946":120292},[],"`Fallida` / `Completada` → `Solicitada`",{"_3461":71416,"_30106":71250,"_20907":120294,"_5":14363,"_27392":119874,"_2946":120295},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3461":71417,"_30106":71250,"_20907":120297,"_5":14363,"_27392":119878,"_2946":120298},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3461":71418,"_30106":71250,"_20907":120300,"_5":14363,"_27392":119878,"_2946":120301},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3461":71419,"_30106":71250,"_20907":120303,"_5":14363,"_27392":119878,"_2946":120304},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3461":71420,"_30106":71250,"_20907":120306,"_5":14363,"_27392":119878,"_2946":120307},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3461":71421,"_30106":71250,"_20907":120309,"_5":14363,"_27392":119878,"_2946":120310},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3461":71422,"_30106":71250,"_20907":120312,"_5":14363,"_27392":119878,"_2946":120313},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3461":71423,"_30106":71250,"_20907":120315,"_5":14363,"_27392":119881,"_2946":120316},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3461":71424,"_30106":71250,"_20907":120318,"_5":14363,"_27392":119884,"_2946":120319},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3461":71425,"_30106":71250,"_20907":120321,"_5":14363,"_27392":119884,"_2946":120322},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3461":71426,"_30106":71250,"_20907":120324,"_5":14363,"_27392":119888,"_2946":120325},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3461":71427,"_30106":71250,"_20907":120327,"_5":14363,"_27392":119892,"_2946":120328},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3461":71428,"_30106":71250,"_20907":120330,"_5":14363,"_27392":119892,"_2946":120331},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3461":71429,"_30106":71250,"_20907":120333,"_5":14363,"_27392":119892,"_2946":120334},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3461":71430,"_30106":71250,"_20907":120336,"_5":14363,"_27392":119892,"_2946":120337},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3461":71431,"_30106":71250,"_20907":120339,"_5":14363,"_27392":119892,"_2946":120340},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3461":71432,"_30106":71250,"_20907":120342,"_5":14363,"_27392":119892,"_2946":120343},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3461":71433,"_30106":71250,"_20907":120345,"_5":14363,"_27392":119896,"_2946":120346},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3461":71434,"_30106":71250,"_20907":120348,"_5":14363,"_27392":119896,"_2946":120349},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3461":71435,"_30106":71250,"_20907":120351,"_5":14363,"_27392":119896,"_2946":120352},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3461":71436,"_30106":71250,"_20907":120354,"_5":14363,"_27392":119896,"_2946":120355},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3461":71437,"_30106":71250,"_20907":120357,"_5":14363,"_27392":119896,"_2946":120358},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3461":71438,"_30106":71250,"_20907":120360,"_5":14363,"_27392":119900,"_2946":120361},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3461":71439,"_30106":71250,"_20907":120363,"_5":14363,"_27392":119900,"_2946":120262},[],{"_3461":71440,"_30106":71250,"_20907":120365,"_5":14363,"_27392":119900,"_2946":120265},[],{"_3461":71441,"_30106":71250,"_20907":120367,"_5":14363,"_27392":119900,"_2946":120368},[],"`SinConfigurar` → `None` / `Auto`",{"_3461":71442,"_30106":71250,"_20907":120370,"_5":14363,"_27392":119900,"_2946":120371},[],"ninguna (solo configuración)",{"_3461":71443,"_30106":71250,"_20907":120373,"_5":14363,"_27392":119900,"_2946":53648},[],{"_3461":71444,"_30106":71250,"_20907":120375,"_5":14363,"_27392":119900,"_2946":120371},[],{"_3461":71445,"_30106":71250,"_20907":120377,"_5":14363,"_27392":119900,"_2946":120378},[],"Cualquiera → `Jitp`",{"_3461":71446,"_30106":71250,"_20907":120380,"_5":14363,"_27392":119900,"_2946":120381},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3461":71447,"_30106":71250,"_20907":120383,"_5":14363,"_27392":119900,"_2946":53659},[],{"_3461":71448,"_30106":71250,"_20907":120385,"_5":14363,"_27392":119900,"_2946":120386},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3461":71449,"_30106":71250,"_20907":120388,"_5":14363,"_27392":119904,"_2946":120389},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3461":71450,"_30106":71250,"_20907":120391,"_5":14363,"_27392":119904,"_2946":120392},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3461":71451,"_30106":71250,"_20907":120394,"_5":14363,"_27392":119904,"_2946":120395},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3461":71452,"_30106":71250,"_20907":120397,"_5":14363,"_27392":119908,"_2946":120398},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3461":71453,"_30106":71250,"_20907":120400,"_5":14363,"_27392":119908,"_2946":120262},[],{"_3461":71454,"_30106":71250,"_20907":120402,"_5":14363,"_27392":119908,"_2946":120265},[],{"_3461":71455,"_30106":71250,"_20907":120404,"_5":14363,"_27392":119908,"_2946":120405},[],"`Ausente` → `Aprovisionado`",{"_3461":71456,"_30106":71250,"_20907":120407,"_5":14363,"_27392":119908,"_2946":120408},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3461":71457,"_30106":71250,"_20907":120410,"_5":14363,"_27392":119908,"_2946":120411},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3461":71458,"_30106":71250,"_20907":120413,"_5":14363,"_27392":119908,"_2946":120414},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3461":71459,"_30106":71250,"_20907":120416,"_5":14363,"_27392":119908,"_2946":120417},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3461":71460,"_30106":71250,"_20907":120419,"_5":14363,"_27392":119912,"_2946":120420},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3461":71461,"_30106":71250,"_20907":120422,"_5":14363,"_27392":119912,"_2946":120423},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3461":71462,"_30106":71250,"_20907":120425,"_5":14363,"_27392":119912,"_2946":120426},[],"Para que el flujo JITP funcione correctamente:",{"_3461":71463,"_30106":71250,"_20907":120428,"_5":14363,"_27392":119912,"_2946":120429},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3461":71464,"_30106":71250,"_20907":120431,"_5":14363,"_27392":119912,"_2946":120432},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3461":71465,"_30106":71250,"_20907":120434,"_5":14363,"_27392":119912,"_2946":120435},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3461":71466,"_30106":71250,"_20907":120437,"_5":14363,"_27392":119912,"_2946":120438},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3461":71467,"_30106":71250,"_20907":120440,"_5":14363,"_27392":119916,"_2946":120441},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3461":71468,"_30106":71250,"_20907":120443,"_5":14363,"_27392":119916,"_2946":120444},[],"Estado en Lamassu",{"_3461":71469,"_30106":71250,"_20907":120446,"_5":14363,"_27392":119916,"_2946":120447},[],"Razón de revocación",{"_3461":71470,"_30106":71250,"_20907":120449,"_5":14363,"_27392":119916,"_2946":120450},[],"Estado en AWS IoT Core",{"_3461":71471,"_30106":71250,"_20907":120452,"_5":14363,"_27392":119916,"_2946":53729},[],{"_3461":71472,"_30106":71250,"_20907":120454,"_5":14363,"_27392":119916,"_2946":120455},[],"Ninguna",{"_3461":71473,"_30106":71250,"_20907":120457,"_5":14363,"_27392":119916,"_2946":53735},[],{"_3461":71474,"_30106":71250,"_20907":120459,"_5":14363,"_27392":119916,"_2946":53738},[],{"_3461":71475,"_30106":71250,"_20907":120461,"_5":14363,"_27392":119916,"_2946":53741},[],{"_3461":71476,"_30106":71250,"_20907":120463,"_5":14363,"_27392":119916,"_2946":53744},[],{"_3461":71477,"_30106":71250,"_20907":120465,"_5":14363,"_27392":119916,"_2946":53738},[],{"_3461":71478,"_30106":71250,"_20907":120467,"_5":14363,"_27392":119916,"_2946":120468},[],"Cualquier otra razón",{"_3461":71479,"_30106":71250,"_20907":120470,"_5":14363,"_27392":119916,"_2946":53752},[],{"_3461":71480,"_30106":71250,"_20907":120472,"_5":14363,"_27392":119916,"_2946":120473},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3461":71481,"_30106":71250,"_20907":120475,"_5":14363,"_27392":119920,"_2946":120476},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3461":71482,"_30106":71250,"_20907":120478,"_5":14363,"_27392":119920,"_2946":120262},[],{"_3461":71483,"_30106":71250,"_20907":120480,"_5":14363,"_27392":119920,"_2946":120265},[],{"_3461":71484,"_30106":71250,"_20907":120482,"_5":14363,"_27392":119920,"_2946":120483},[],"`NoSincronizado` → `Active`",{"_3461":71485,"_30106":71250,"_20907":120485,"_5":14363,"_27392":119920,"_2946":53244},[],{"_3461":71486,"_30106":71250,"_20907":120487,"_5":14363,"_27392":119920,"_2946":53770},[],{"_3461":71487,"_30106":71250,"_20907":120489,"_5":14363,"_27392":119920,"_2946":120490},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3461":71488,"_30106":71250,"_20907":120492,"_5":14363,"_27392":119920,"_2946":53776},[],{"_3461":71489,"_30106":71250,"_20907":120494,"_5":14363,"_27392":119920,"_2946":120490},[],{"_3461":71490,"_30106":71250,"_20907":120496,"_5":14363,"_27392":119920,"_2946":53781},[],{"_3461":71491,"_30106":71250,"_20907":120498,"_5":14363,"_27392":119920,"_2946":53244},[],{"_3461":71492,"_30106":71250,"_20907":120500,"_5":14363,"_27392":119920,"_2946":53786},[],{"_3461":71493,"_30106":71250,"_20907":120502,"_5":14363,"_27392":119920,"_2946":120503},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3461":71494,"_30106":71250,"_20907":120505,"_5":14363,"_27392":119924,"_2946":120506},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3461":71495,"_30106":71250,"_20907":120508,"_5":14363,"_27392":119924,"_2946":120509},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3461":71496,"_30106":71250,"_20907":120511,"_5":14363,"_27392":119924,"_2946":120512},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3461":71497,"_30106":71250,"_20907":120514,"_5":14363,"_27392":119928,"_2946":120515},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3461":71498,"_30106":71250,"_20907":120517,"_5":14363,"_27392":119928,"_2946":120518},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3461":71499,"_30106":71250,"_20907":120520,"_5":14363,"_27392":119932,"_2946":120521},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3461":71500,"_30106":71250,"_20907":120523,"_5":14363,"_27392":119932,"_2946":120524},[],"Existen dos tipos de acciones:",{"_3461":71501,"_30106":71250,"_20907":120526,"_5":14363,"_27392":119932,"_2946":120527},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3461":71502,"_30106":71250,"_20907":120529,"_5":14363,"_27392":119932,"_2946":120530},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3461":71503,"_30106":71250,"_20907":120532,"_5":14363,"_27392":119932,"_2946":120533},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3461":71504,"_30106":71250,"_20907":120535,"_5":14363,"_27392":119936,"_2946":120536},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3461":71505,"_30106":71250,"_20907":120538,"_5":14363,"_27392":119936,"_2946":120539},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3461":71506,"_30106":71250,"_20907":120541,"_5":14363,"_27392":119936,"_2946":120542},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3461":71507,"_30106":71250,"_20907":120544,"_5":14363,"_27392":119940,"_2946":120545},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3461":71508,"_30106":71250,"_20907":120547,"_5":14363,"_27392":119940,"_2946":120548},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3461":71509,"_30106":71250,"_20907":120550,"_5":14363,"_27392":119940,"_2946":120551},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3461":71510,"_30106":71250,"_20907":120553,"_5":14363,"_27392":119940,"_2946":120554},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3461":71511,"_30106":71250,"_20907":120556,"_5":14363,"_27392":119940,"_2946":120557},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3461":71512,"_30106":71250,"_20907":120559,"_5":14363,"_27392":119940,"_2946":120560},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3461":71513,"_30106":71250,"_20907":120562,"_5":14363,"_27392":119940,"_2946":120563},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3461":71514,"_30106":71250,"_20907":120565,"_5":14363,"_27392":119940,"_2946":120566},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3461":71515,"_30106":71250,"_20907":120568,"_5":14363,"_27392":119940,"_2946":120569},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3461":71516,"_30106":71250,"_20907":120571,"_5":14363,"_27392":119940,"_2946":120572},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3461":71517,"_30106":71250,"_20907":120574,"_5":14363,"_27392":119940,"_2946":120575},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3461":71518,"_30106":71250,"_20907":120577,"_5":14363,"_27392":119940,"_2946":120578},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3461":71519,"_30106":71250,"_20907":120580,"_5":14363,"_27392":119940,"_2946":120581},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3461":71520,"_30106":71250,"_20907":120583,"_5":14363,"_27392":119940,"_2946":120584},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3461":71521,"_30106":71250,"_20907":120586,"_5":14363,"_27392":119940,"_2946":120587},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3461":71522,"_30106":71250,"_20907":120589,"_5":14363,"_27392":119940,"_2946":120590},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3461":71523,"_30106":71250,"_20907":120592,"_5":14363,"_27392":119940,"_2946":120593},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3461":71524,"_30106":71250,"_20907":120595,"_5":14363,"_27392":119940,"_2946":120596},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3461":71525,"_30106":71250,"_20907":120598,"_5":14363,"_27392":119940,"_2946":120599},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3461":71526,"_30106":71250,"_20907":120601,"_5":14363,"_27392":119940,"_2946":120602},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3461":71527,"_30106":71250,"_20907":120604,"_5":14363,"_27392":119940,"_2946":120605},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3461":71528,"_30106":71250,"_20907":120607,"_5":14363,"_27392":119940,"_2946":120608},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3461":71529,"_30106":71250,"_20907":120610,"_5":14363,"_27392":119940,"_2946":120611},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3461":71530,"_30106":71250,"_20907":120613,"_5":14363,"_27392":119940,"_2946":120614},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3461":71531,"_30106":71531,"_5":14715,"_2946":51607,"_30438":120616,"_20907":120617,"_27392":71531},[49125,117420,51607],[],{"_3461":71532,"_30106":71531,"_20907":120619,"_5":14363,"_27392":71531,"_2946":120620},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3461":71533,"_30106":71531,"_5":30435,"_20907":120622,"_27392":120623,"_2946":120624},[],"/docs/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3461":71534,"_30106":71531,"_5":30435,"_20907":120626,"_27392":120627,"_2946":118432},[],"/docs/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3461":71535,"_30106":71531,"_5":30435,"_20907":120629,"_27392":120630,"_2946":118607},[],"/docs/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3461":71536,"_30106":71531,"_5":30435,"_20907":120632,"_27392":120633,"_2946":119839},[],"/docs/es/platform/iot-fleets/overview#integraciones",{"_3461":71537,"_30106":71531,"_5":30435,"_20907":120635,"_27392":120636,"_2946":120637},[],"/docs/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3461":71538,"_30106":71531,"_20907":120639,"_5":14363,"_27392":71531,"_2946":120640},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3461":71539,"_30106":71531,"_20907":120642,"_5":14363,"_27392":120623,"_2946":120643},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3461":71540,"_30106":71531,"_20907":120645,"_5":14363,"_27392":120623,"_2946":120646},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3461":71541,"_30106":71531,"_20907":120648,"_5":14363,"_27392":120627,"_2946":120649},[],"Recurso",{"_3461":71542,"_30106":71531,"_20907":120651,"_5":14363,"_27392":120627,"_2946":120652},[],"Qué representa",{"_3461":71543,"_30106":71531,"_20907":120654,"_5":14363,"_27392":120627,"_2946":120655},[],"**Dispositivo**",{"_3461":71544,"_30106":71531,"_20907":120657,"_5":14363,"_27392":120627,"_2946":120658},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3461":71545,"_30106":71531,"_20907":120660,"_5":14363,"_27392":120627,"_2946":120661},[],"**Identidad**",{"_3461":71546,"_30106":71531,"_20907":120663,"_5":14363,"_27392":120627,"_2946":120664},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3461":71547,"_30106":71531,"_20907":120666,"_5":14363,"_27392":120627,"_2946":53953},[],{"_3461":71548,"_30106":71531,"_20907":120668,"_5":14363,"_27392":120627,"_2946":120669},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3461":71549,"_30106":71531,"_20907":120671,"_5":14363,"_27392":120627,"_2946":120672},[],"**Flota**",{"_3461":71550,"_30106":71531,"_20907":120674,"_5":14363,"_27392":120627,"_2946":120675},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3461":71551,"_30106":71531,"_20907":120677,"_5":14363,"_27392":120627,"_2946":120678},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3461":71552,"_30106":71531,"_20907":120680,"_5":14363,"_27392":120627,"_2946":120681},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3461":71553,"_30106":71531,"_20907":120683,"_5":14363,"_27392":120630,"_2946":120684},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3461":71554,"_30106":71531,"_20907":120686,"_5":14363,"_27392":120630,"_2946":120687},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3461":71555,"_30106":71531,"_20907":120689,"_5":14363,"_27392":120630,"_2946":120690},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3461":71556,"_30106":71531,"_20907":120692,"_5":14363,"_27392":120630,"_2946":120693},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3461":71557,"_30106":71531,"_20907":120695,"_5":14363,"_27392":120630,"_2946":120696},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3461":71558,"_30106":71531,"_20907":120698,"_5":14363,"_27392":120630,"_2946":120699},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3461":71559,"_30106":71531,"_20907":120701,"_5":14363,"_27392":120630,"_2946":120702},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3461":71560,"_30106":71531,"_20907":120704,"_5":14363,"_27392":120630,"_2946":120705},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3461":71561,"_30106":71531,"_20907":120707,"_5":14363,"_27392":120633,"_2946":120708},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3461":71562,"_30106":71531,"_20907":120710,"_5":14363,"_27392":120633,"_2946":120711},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3461":71563,"_30106":71531,"_20907":120713,"_5":14363,"_27392":120636,"_2946":120714},[],"Participante",{"_3461":71564,"_30106":71531,"_20907":120716,"_5":14363,"_27392":120636,"_2946":120717},[],"Responsabilidad",{"_3461":71565,"_30106":71531,"_20907":120719,"_5":14363,"_27392":120636,"_2946":120720},[],"Administrador PKI",{"_3461":71566,"_30106":71531,"_20907":120722,"_5":14363,"_27392":120636,"_2946":120723},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3461":71567,"_30106":71531,"_20907":120725,"_5":14363,"_27392":120636,"_2946":120726},[],"Administrador del aprovisionamiento",{"_3461":71568,"_30106":71531,"_20907":120728,"_5":14363,"_27392":120636,"_2946":120729},[],"DMS, admisión, autenticación por operación e inventario.",{"_3461":71569,"_30106":71531,"_20907":120731,"_5":14363,"_27392":120636,"_2946":120732},[],"Integrador del dispositivo",{"_3461":71570,"_30106":71531,"_20907":120734,"_5":14363,"_27392":120636,"_2946":120735},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3461":71571,"_30106":71531,"_20907":120737,"_5":14363,"_27392":120636,"_2946":120738},[],"Integrador del consumidor",{"_3461":71572,"_30106":71531,"_20907":120740,"_5":14363,"_27392":120636,"_2946":120741},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3461":71573,"_30106":71531,"_20907":120743,"_5":14363,"_27392":120636,"_2946":120744},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3461":71574,"_30106":71574,"_5":14715,"_2946":120746,"_30438":120747,"_20907":120749,"_27392":71574},"Enrola y conecta tu primer dispositivo",[49125,117420,51607,120748],"Primeros pasos",[],{"_3461":71575,"_30106":71574,"_20907":120751,"_5":14363,"_27392":71574,"_2946":120752},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3461":71576,"_30106":71574,"_5":30435,"_20907":120754,"_27392":120755,"_2946":115998},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3461":71577,"_30106":71574,"_5":30435,"_20907":120757,"_27392":120758,"_2946":120759},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3461":71578,"_30106":71574,"_5":30435,"_20907":120761,"_27392":120762,"_2946":120763},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3461":71579,"_30106":71574,"_5":30435,"_20907":120765,"_27392":120766,"_2946":120767},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3461":71580,"_30106":71574,"_5":30435,"_20907":120769,"_27392":120770,"_2946":120771},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3461":71581,"_30106":71574,"_5":30435,"_20907":120773,"_27392":120774,"_2946":120775},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3461":71582,"_30106":71574,"_5":30435,"_20907":120777,"_27392":120778,"_2946":120779},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3461":71583,"_30106":71574,"_5":30435,"_20907":120781,"_27392":120782,"_2946":120783},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3461":71584,"_30106":71574,"_20907":120785,"_5":14363,"_27392":71574,"_2946":120786},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3461":71585,"_30106":71574,"_20907":120788,"_5":14363,"_27392":120755,"_2946":120789},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3461":71586,"_30106":71574,"_20907":120791,"_5":14363,"_27392":120755,"_2946":120792},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3461":71587,"_30106":71574,"_20907":120794,"_5":14363,"_27392":120755,"_2946":120795},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3461":71588,"_30106":71574,"_20907":120797,"_5":14363,"_27392":120755,"_2946":120798},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3461":71589,"_30106":71574,"_20907":120800,"_5":14363,"_27392":120755,"_2946":120801},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3461":71590,"_30106":71574,"_20907":120803,"_5":14363,"_27392":120758,"_2946":120804},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3461":71591,"_30106":71574,"_20907":120806,"_5":14363,"_27392":120758,"_2946":120807},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3461":71592,"_30106":71574,"_20907":120809,"_5":14363,"_27392":120762,"_2946":120810},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3461":71593,"_30106":71574,"_20907":120812,"_5":14363,"_27392":120762,"_2946":120813},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3461":71594,"_30106":71574,"_20907":120815,"_5":14363,"_27392":120762,"_2946":120816},[],"Ajuste",{"_3461":71595,"_30106":71574,"_20907":120818,"_5":14363,"_27392":120762,"_2946":120819},[],"Valor de evaluación",{"_3461":71596,"_30106":71574,"_20907":120821,"_5":14363,"_27392":120762,"_2946":54109},[],{"_3461":71597,"_30106":71574,"_20907":120823,"_5":14363,"_27392":120762,"_2946":120824},[],"Raíz emisora de `device-root.pem`.",{"_3461":71598,"_30106":71574,"_20907":120826,"_5":14363,"_27392":120762,"_2946":118735},[],{"_3461":71599,"_30106":71574,"_20907":120828,"_5":14363,"_27392":120762,"_2946":120829},[],"Perfil final de 1 hora que acabas de preparar.",{"_3461":71600,"_30106":71574,"_20907":120831,"_5":14363,"_27392":120762,"_2946":54120},[],{"_3461":71601,"_30106":71574,"_20907":120833,"_5":14363,"_27392":120762,"_2946":54123},[],{"_3461":71602,"_30106":71574,"_20907":120835,"_5":14363,"_27392":120762,"_2946":54126},[],{"_3461":71603,"_30106":71574,"_20907":120837,"_5":14363,"_27392":120762,"_2946":120838},[],"Habilitado.",{"_3461":71604,"_30106":71574,"_20907":120840,"_5":14363,"_27392":120762,"_2946":54132},[],{"_3461":71605,"_30106":71574,"_20907":120842,"_5":14363,"_27392":120762,"_2946":120843},[],"Deshabilitado; el ID debe ser nuevo.",{"_3461":71606,"_30106":71574,"_20907":120845,"_5":14363,"_27392":120762,"_2946":120846},[],"Autenticación inicial",{"_3461":71607,"_30106":71574,"_20907":120848,"_5":14363,"_27392":120762,"_2946":120849},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3461":71608,"_30106":71574,"_20907":120851,"_5":14363,"_27392":120762,"_2946":120852},[],"Autenticación de renovación",{"_3461":71609,"_30106":71574,"_20907":120854,"_5":14363,"_27392":120762,"_2946":120855},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3461":71610,"_30106":71574,"_20907":120857,"_5":14363,"_27392":120762,"_2946":54150},[],{"_3461":71611,"_30106":71574,"_20907":120859,"_5":14363,"_27392":120762,"_2946":120860},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3461":71612,"_30106":71574,"_20907":120862,"_5":14363,"_27392":120762,"_2946":54156},[],{"_3461":71613,"_30106":71574,"_20907":120864,"_5":14363,"_27392":120762,"_2946":120865},[],"1 hora.",{"_3461":71614,"_30106":71574,"_20907":120867,"_5":14363,"_27392":120762,"_2946":54162},[],{"_3461":71615,"_30106":71574,"_20907":120869,"_5":14363,"_27392":120762,"_2946":120870},[],"30 minutos / 10 minutos.",{"_3461":71616,"_30106":71574,"_20907":120872,"_5":14363,"_27392":120762,"_2946":54168},[],{"_3461":71617,"_30106":71574,"_20907":120874,"_5":14363,"_27392":120762,"_2946":120875},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3461":71618,"_30106":71574,"_20907":120877,"_5":14363,"_27392":120762,"_2946":51926},[],{"_3461":71619,"_30106":71574,"_20907":120879,"_5":14363,"_27392":120762,"_2946":120880},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3461":71620,"_30106":71574,"_20907":120882,"_5":14363,"_27392":120762,"_2946":54179},[],{"_3461":71621,"_30106":71574,"_20907":120884,"_5":14363,"_27392":120762,"_2946":120885},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3461":71622,"_30106":71574,"_20907":120887,"_5":14363,"_27392":120762,"_2946":120888},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3461":71623,"_30106":71574,"_20907":120890,"_5":14363,"_27392":120766,"_2946":120891},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3461":71624,"_30106":71574,"_20907":120893,"_5":14363,"_27392":120766,"_2946":120894},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3461":71625,"_30106":71574,"_20907":120896,"_5":14363,"_27392":120770,"_2946":120897},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3461":71626,"_30106":71574,"_20907":120899,"_5":14363,"_27392":120770,"_2946":120900},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3461":71627,"_30106":71574,"_20907":120902,"_5":14363,"_27392":120770,"_2946":120903},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3461":71628,"_30106":71574,"_20907":120905,"_5":14363,"_27392":120774,"_2946":120906},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3461":71629,"_30106":71574,"_20907":120908,"_5":14363,"_27392":120774,"_2946":120909},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3461":71630,"_30106":71574,"_20907":120911,"_5":14363,"_27392":120778,"_2946":120912},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3461":71631,"_30106":71574,"_20907":120914,"_5":14363,"_27392":120778,"_2946":120915},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3461":71632,"_30106":71574,"_20907":120917,"_5":14363,"_27392":120778,"_2946":120918},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3461":71633,"_30106":71574,"_20907":120920,"_5":14363,"_27392":120778,"_2946":120921},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3461":71634,"_30106":71574,"_20907":120923,"_5":14363,"_27392":120778,"_2946":120924},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3461":71635,"_30106":71574,"_20907":120926,"_5":14363,"_27392":120782,"_2946":120927},[],"Comprobación",{"_3461":71636,"_30106":71574,"_20907":120929,"_5":14363,"_27392":120782,"_2946":120930},[],"Resultado esperado",{"_3461":71637,"_30106":71574,"_20907":120932,"_5":14363,"_27392":120782,"_2946":120933},[],"Registro",{"_3461":71638,"_30106":71574,"_20907":120935,"_5":14363,"_27392":120782,"_2946":120936},[],"ID creado automáticamente y DMS correcto.",{"_3461":71639,"_30106":71574,"_20907":120938,"_5":14363,"_27392":120782,"_2946":120223},[],{"_3461":71640,"_30106":71574,"_20907":120940,"_5":14363,"_27392":120782,"_2946":120941},[],"CN, perfil, serie y clave verificados.",{"_3461":71641,"_30106":71574,"_20907":120943,"_5":14363,"_27392":120782,"_2946":120944},[],"Inventario",{"_3461":71642,"_30106":71574,"_20907":120946,"_5":14363,"_27392":120782,"_2946":120947},[],"Serie recibida visible como identidad actual y en el historial.",{"_3461":71643,"_30106":71574,"_20907":120949,"_5":14363,"_27392":120782,"_2946":120950},[],"Consumidor",{"_3461":71644,"_30106":71574,"_20907":120952,"_5":14363,"_27392":120782,"_2946":120953},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3461":71645,"_30106":71574,"_20907":120955,"_5":14363,"_27392":120782,"_2946":120956},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3461":71646,"_30106":71574,"_20907":120958,"_5":14363,"_27392":120782,"_2946":120959},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3461":71647,"_30106":71647,"_5":14715,"_2946":118449,"_30438":120961,"_20907":120962,"_27392":71647},[49125,117420,51607,120748],[],{"_3461":71648,"_30106":71647,"_20907":120964,"_5":14363,"_27392":71647,"_2946":120965},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3461":71649,"_30106":71647,"_5":30435,"_20907":120967,"_27392":120968,"_2946":115998},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3461":71650,"_30106":71647,"_5":30435,"_20907":120970,"_27392":120971,"_2946":120972},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3461":71651,"_30106":71647,"_5":30435,"_20907":120974,"_27392":120975,"_2946":120976},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3461":71652,"_30106":71647,"_5":30435,"_20907":120978,"_27392":120979,"_2946":120980},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3461":71653,"_30106":71647,"_5":30435,"_20907":120982,"_27392":120983,"_2946":120984},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3461":71654,"_30106":71647,"_5":30435,"_20907":120986,"_27392":120987,"_2946":120988},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3461":71655,"_30106":71647,"_5":30435,"_20907":120990,"_27392":120991,"_2946":120930},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3461":71656,"_30106":71647,"_5":30435,"_20907":120993,"_27392":120994,"_2946":120995},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3461":71657,"_30106":71647,"_5":30435,"_20907":120997,"_27392":120998,"_2946":120999},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3461":71658,"_30106":71647,"_20907":121001,"_5":14363,"_27392":71647,"_2946":121002},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3461":71659,"_30106":71647,"_20907":121004,"_5":14363,"_27392":71647,"_2946":121005},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3461":71660,"_30106":71647,"_20907":121007,"_5":14363,"_27392":120968,"_2946":121008},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3461":71661,"_30106":71647,"_20907":121010,"_5":14363,"_27392":120968,"_2946":121011},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3461":71662,"_30106":71647,"_20907":121013,"_5":14363,"_27392":120968,"_2946":121014},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3461":71663,"_30106":71647,"_20907":121016,"_5":14363,"_27392":120968,"_2946":121017},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3461":71664,"_30106":71647,"_20907":121019,"_5":14363,"_27392":120971,"_2946":121020},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3461":71665,"_30106":71647,"_20907":121022,"_5":14363,"_27392":120971,"_2946":121023},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3461":71666,"_30106":71647,"_20907":121025,"_5":14363,"_27392":120971,"_2946":121026},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3461":71667,"_30106":71647,"_20907":121028,"_5":14363,"_27392":120971,"_2946":121029},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3461":71668,"_30106":71647,"_20907":121031,"_5":14363,"_27392":120971,"_2946":121032},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3461":71669,"_30106":71647,"_20907":121034,"_5":14363,"_27392":120971,"_2946":121035},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3461":71670,"_30106":71647,"_20907":121037,"_5":14363,"_27392":120971,"_2946":121038},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3461":71671,"_30106":71647,"_20907":121040,"_5":14363,"_27392":120971,"_2946":121041},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3461":71672,"_30106":71647,"_20907":121043,"_5":14363,"_27392":120975,"_2946":121044},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3461":71673,"_30106":71647,"_20907":121046,"_5":14363,"_27392":120975,"_2946":54344},[],{"_3461":71674,"_30106":71647,"_20907":121048,"_5":14363,"_27392":120975,"_2946":121049},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3461":71675,"_30106":71647,"_20907":121051,"_5":14363,"_27392":120975,"_2946":121052},[],"**Icon** y **Tags**: clasificación opcional.",{"_3461":71676,"_30106":71647,"_20907":121054,"_5":14363,"_27392":120975,"_2946":121055},[],"Confirma el registro.",{"_3461":71677,"_30106":71647,"_20907":121057,"_5":14363,"_27392":120979,"_2946":121058},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3461":71678,"_30106":71647,"_20907":121060,"_5":14363,"_27392":120979,"_2946":121061},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3461":71679,"_30106":71647,"_20907":121063,"_5":14363,"_27392":120983,"_2946":121064},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3461":71680,"_30106":71647,"_20907":121066,"_5":14363,"_27392":120983,"_2946":121067},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3461":71681,"_30106":71647,"_20907":121069,"_5":14363,"_27392":120987,"_2946":121070},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3461":71682,"_30106":71647,"_20907":121072,"_5":14363,"_27392":120987,"_2946":121073},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3461":71683,"_30106":71647,"_20907":121075,"_5":14363,"_27392":120991,"_2946":120927},[],{"_3461":71684,"_30106":71647,"_20907":121077,"_5":14363,"_27392":120991,"_2946":121078},[],"Resultado",{"_3461":71685,"_30106":71647,"_20907":121080,"_5":14363,"_27392":120991,"_2946":120209},[],{"_3461":71686,"_30106":71647,"_20907":121082,"_5":14363,"_27392":120991,"_2946":121083},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3461":71687,"_30106":71647,"_20907":121085,"_5":14363,"_27392":120991,"_2946":121086},[],"Identidad actual",{"_3461":71688,"_30106":71647,"_20907":121088,"_5":14363,"_27392":120991,"_2946":121089},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3461":71689,"_30106":71647,"_20907":121091,"_5":14363,"_27392":120991,"_2946":121092},[],"Historial",{"_3461":71690,"_30106":71647,"_20907":121094,"_5":14363,"_27392":120991,"_2946":121095},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3461":71691,"_30106":71647,"_20907":121097,"_5":14363,"_27392":120991,"_2946":121098},[],"Clave y certificado",{"_3461":71692,"_30106":71647,"_20907":121100,"_5":14363,"_27392":120991,"_2946":121101},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3461":71693,"_30106":71647,"_20907":121103,"_5":14363,"_27392":120994,"_2946":121104},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3461":71694,"_30106":71647,"_20907":121106,"_5":14363,"_27392":120994,"_2946":121107},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3461":71695,"_30106":71647,"_20907":121109,"_5":14363,"_27392":120994,"_2946":121110},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3461":71696,"_30106":71647,"_20907":121112,"_5":14363,"_27392":120994,"_2946":121113},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3461":71697,"_30106":71647,"_20907":121115,"_5":14363,"_27392":120998,"_2946":121116},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3461":71698,"_30106":71647,"_20907":121118,"_5":14363,"_27392":120998,"_2946":121119},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3461":71699,"_30106":71647,"_20907":121121,"_5":14363,"_27392":120998,"_2946":121122},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3461":71700,"_30106":71700,"_5":14715,"_2946":121124,"_30438":121125,"_20907":121126,"_27392":71700},"Plataforma Lamassu IoT",[49125,117420],[],{"_3461":71701,"_30106":71700,"_20907":121128,"_5":14363,"_27392":71700,"_2946":121129},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3461":71702,"_30106":71700,"_5":30435,"_20907":121131,"_27392":121132,"_2946":120624},[],"/docs/es/platform/overview#empieza-aquí",{"_3461":71703,"_30106":71700,"_5":30435,"_20907":121134,"_27392":121135,"_2946":121136},[],"/docs/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3461":71704,"_30106":71700,"_5":30435,"_20907":121138,"_27392":121139,"_2946":121140},[],"/docs/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3461":71705,"_30106":71700,"_5":30435,"_20907":121142,"_27392":121143,"_2946":121144},[],"/docs/es/platform/overview#capacidades-principales","Capacidades principales",{"_3461":71706,"_30106":71700,"_5":30435,"_20907":121146,"_27392":121147,"_2946":121148},[],"/docs/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3461":71707,"_30106":71700,"_5":30435,"_20907":121150,"_27392":121151,"_2946":121152},[],"/docs/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3461":71708,"_30106":71700,"_5":30435,"_20907":121154,"_27392":121155,"_2946":121156},[],"/docs/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3461":71709,"_30106":71700,"_5":30435,"_20907":121158,"_27392":121159,"_2946":121160},[],"/docs/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3461":71710,"_30106":71700,"_5":30435,"_20907":121162,"_27392":121163,"_2946":121164},[],"/docs/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3461":71711,"_30106":71700,"_5":30435,"_20907":121166,"_27392":121167,"_2946":121168},[],"/docs/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3461":71712,"_30106":71700,"_5":30435,"_20907":121170,"_27392":121171,"_2946":121172},[],"/docs/es/platform/overview#referencia-operativa","Referencia operativa",{"_3461":71713,"_30106":71700,"_20907":121174,"_5":14363,"_27392":71700,"_2946":121175},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3461":71714,"_30106":71700,"_20907":121177,"_5":14363,"_27392":121132,"_2946":121178},[],"Elige el resultado que necesitas obtener:",{"_3461":71715,"_30106":71700,"_20907":121180,"_5":14363,"_27392":121132,"_2946":121181},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3461":71716,"_30106":71700,"_20907":121183,"_5":14363,"_27392":121132,"_2946":121184},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3461":71717,"_30106":71700,"_20907":121186,"_5":14363,"_27392":121132,"_2946":121187},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3461":71718,"_30106":71700,"_20907":121189,"_5":14363,"_27392":121135,"_2946":121190},[],"Bloque",{"_3461":71719,"_30106":71700,"_20907":121192,"_5":14363,"_27392":121135,"_2946":121193},[],"Qué gestionas",{"_3461":71720,"_30106":71700,"_20907":121195,"_5":14363,"_27392":121135,"_2946":121196},[],"Punto de entrada",{"_3461":71721,"_30106":71700,"_20907":121198,"_5":14363,"_27392":121135,"_2946":54497},[],{"_3461":71722,"_30106":71700,"_20907":121200,"_5":14363,"_27392":121135,"_2946":121201},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3461":71723,"_30106":71700,"_20907":121203,"_5":14363,"_27392":121135,"_2946":121204},[],"Visión general de PKI",{"_3461":71724,"_30106":71700,"_20907":121206,"_5":14363,"_27392":121135,"_2946":54506},[],{"_3461":71725,"_30106":71700,"_20907":121208,"_5":14363,"_27392":121135,"_2946":121209},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3461":71726,"_30106":71700,"_20907":121211,"_5":14363,"_27392":121135,"_2946":121212},[],"Visión general de IoT Fleets",{"_3461":71727,"_30106":71700,"_20907":121214,"_5":14363,"_27392":121135,"_2946":121215},[],"**Administración**",{"_3461":71728,"_30106":71700,"_20907":121217,"_5":14363,"_27392":121135,"_2946":121218},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3461":71729,"_30106":71700,"_20907":121220,"_5":14363,"_27392":121135,"_2946":117418},[],{"_3461":71730,"_30106":71700,"_20907":121222,"_5":14363,"_27392":121135,"_2946":121223},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3461":71731,"_30106":71700,"_20907":121225,"_5":14363,"_27392":121139,"_2946":121226},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3461":71732,"_30106":71700,"_20907":121228,"_5":14363,"_27392":121139,"_2946":121229},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3461":71733,"_30106":71700,"_20907":121231,"_5":14363,"_27392":121139,"_2946":121232},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3461":71734,"_30106":71700,"_20907":121234,"_5":14363,"_27392":121139,"_2946":121235},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3461":71735,"_30106":71700,"_20907":121237,"_5":14363,"_27392":121139,"_2946":121238},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3461":71736,"_30106":71700,"_20907":121240,"_5":14363,"_27392":121139,"_2946":121241},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3461":71737,"_30106":71700,"_20907":121243,"_5":14363,"_27392":121147,"_2946":121244},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3461":71738,"_30106":71700,"_20907":121246,"_5":14363,"_27392":121151,"_2946":121247},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3461":71739,"_30106":71700,"_20907":121249,"_5":14363,"_27392":121155,"_2946":121250},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3461":71740,"_30106":71700,"_20907":121252,"_5":14363,"_27392":121159,"_2946":121253},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3461":71741,"_30106":71700,"_20907":121255,"_5":14363,"_27392":121163,"_2946":121256},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3461":71742,"_30106":71700,"_20907":121258,"_5":14363,"_27392":121167,"_2946":121259},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3461":71743,"_30106":71700,"_20907":121261,"_5":14363,"_27392":121171,"_2946":120717},[],{"_3461":71744,"_30106":71700,"_20907":121263,"_5":14363,"_27392":121171,"_2946":121264},[],"Qué prepara o comprueba",{"_3461":71745,"_30106":71700,"_20907":121266,"_5":14363,"_27392":121171,"_2946":120720},[],{"_3461":71746,"_30106":71700,"_20907":121268,"_5":14363,"_27392":121171,"_2946":121269},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3461":71747,"_30106":71700,"_20907":121271,"_5":14363,"_27392":121171,"_2946":121272},[],"Administrador de la flota",{"_3461":71748,"_30106":71700,"_20907":121274,"_5":14363,"_27392":121171,"_2946":121275},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3461":71749,"_30106":71700,"_20907":121277,"_5":14363,"_27392":121171,"_2946":120732},[],{"_3461":71750,"_30106":71700,"_20907":121279,"_5":14363,"_27392":121171,"_2946":121280},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3461":71751,"_30106":71700,"_20907":121282,"_5":14363,"_27392":121171,"_2946":120738},[],{"_3461":71752,"_30106":71700,"_20907":121284,"_5":14363,"_27392":121171,"_2946":121285},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3461":71753,"_30106":71700,"_20907":121287,"_5":14363,"_27392":121171,"_2946":121288},[],"Operador de infraestructura",{"_3461":71754,"_30106":71700,"_20907":121290,"_5":14363,"_27392":121171,"_2946":121291},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3461":71755,"_30106":71700,"_20907":121293,"_5":14363,"_27392":121171,"_2946":121294},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3461":71756,"_30106":71756,"_5":14715,"_2946":121296,"_30438":121297,"_20907":121299,"_27392":71756},"Jerarquía y rotación de CAs",[49125,117420,54598,121298],"Claves, autoridades y certificados",[],{"_3461":71757,"_30106":71756,"_20907":121301,"_5":14363,"_27392":71756,"_2946":121302},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3461":71758,"_30106":71756,"_5":30435,"_20907":121304,"_27392":121305,"_2946":121306},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3461":71759,"_30106":71756,"_5":30435,"_20907":121308,"_27392":121309,"_2946":121310},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3461":71760,"_30106":71756,"_5":30435,"_20907":121312,"_27392":121313,"_2946":121314},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3461":71761,"_30106":71756,"_5":30435,"_20907":121316,"_27392":121317,"_2946":121318},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3461":71762,"_30106":71756,"_5":30435,"_20907":121320,"_27392":121321,"_2946":121322},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3461":71763,"_30106":71756,"_5":30435,"_20907":121324,"_27392":121325,"_2946":121326},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3461":71764,"_30106":71756,"_5":30435,"_20907":121328,"_27392":121329,"_2946":121330},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3461":71765,"_30106":71756,"_5":30435,"_20907":121332,"_27392":121333,"_2946":121334},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3461":71766,"_30106":71756,"_5":30435,"_20907":121336,"_27392":121337,"_2946":121338},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3461":71767,"_30106":71756,"_5":30435,"_20907":121340,"_27392":121341,"_2946":121342},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3461":71768,"_30106":71756,"_5":30435,"_20907":121344,"_27392":121345,"_2946":121346},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3461":71769,"_30106":71756,"_5":30435,"_20907":121348,"_27392":121349,"_2946":121350},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3461":71770,"_30106":71756,"_20907":121352,"_5":14363,"_27392":71756,"_2946":121353},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3461":71771,"_30106":71756,"_20907":121355,"_5":14363,"_27392":71756,"_2946":121356},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3461":71772,"_30106":71756,"_20907":121358,"_5":14363,"_27392":121305,"_2946":121359},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3461":71773,"_30106":71756,"_20907":121361,"_5":14363,"_27392":121305,"_2946":121362},[],"entorno, como producción y preproducción;",{"_3461":71774,"_30106":71756,"_20907":121364,"_5":14363,"_27392":121305,"_2946":121365},[],"propietario o equipo operador;",{"_3461":71775,"_30106":71756,"_20907":121367,"_5":14363,"_27392":121305,"_2946":121368},[],"familia de dispositivos o proceso de fabricación;",{"_3461":71776,"_30106":71756,"_20907":121370,"_5":14363,"_27392":121305,"_2946":121371},[],"región o requisito regulatorio;",{"_3461":71777,"_30106":71756,"_20907":121373,"_5":14363,"_27392":121305,"_2946":121374},[],"motor criptográfico o política de clave;",{"_3461":71778,"_30106":71756,"_20907":121376,"_5":14363,"_27392":121305,"_2946":121377},[],"ventana de mantenimiento y ritmo de renovación.",{"_3461":71779,"_30106":71756,"_20907":121379,"_5":14363,"_27392":121305,"_2946":121380},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3461":71780,"_30106":71756,"_20907":121382,"_5":14363,"_27392":121305,"_2946":121383},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3461":71781,"_30106":71756,"_20907":121385,"_5":14363,"_27392":121309,"_2946":121386},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3461":71782,"_30106":71756,"_20907":121388,"_5":14363,"_27392":121309,"_2946":121389},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir; consulta la guía de CRL.",{"_3461":71783,"_30106":71756,"_20907":121391,"_5":14363,"_27392":121309,"_2946":121392},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3461":71784,"_30106":71756,"_20907":121394,"_5":14363,"_27392":121309,"_2946":121395},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3461":71785,"_30106":71756,"_20907":121397,"_5":14363,"_27392":121313,"_2946":121398},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3461":71786,"_30106":71756,"_20907":121400,"_5":14363,"_27392":121313,"_2946":121401},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3461":71787,"_30106":71756,"_20907":121403,"_5":14363,"_27392":121313,"_2946":121404},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3461":71788,"_30106":71756,"_20907":121406,"_5":14363,"_27392":121313,"_2946":121407},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3461":71789,"_30106":71756,"_20907":121409,"_5":14363,"_27392":121321,"_2946":121410},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3461":71790,"_30106":71756,"_20907":121412,"_5":14363,"_27392":121325,"_2946":121413},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3461":71791,"_30106":71756,"_20907":121415,"_5":14363,"_27392":121329,"_2946":121416},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3461":71792,"_30106":71756,"_20907":121418,"_5":14363,"_27392":121333,"_2946":121419},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3461":71793,"_30106":71756,"_20907":121421,"_5":14363,"_27392":121337,"_2946":121422},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3461":71794,"_30106":71756,"_20907":121424,"_5":14363,"_27392":121341,"_2946":121425},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3461":71795,"_30106":71756,"_20907":121427,"_5":14363,"_27392":121345,"_2946":121428},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3461":71796,"_30106":71756,"_20907":121430,"_5":14363,"_27392":121345,"_2946":121431},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3461":71797,"_30106":71756,"_20907":121433,"_5":14363,"_27392":121345,"_2946":121434},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3461":71798,"_30106":71756,"_20907":121436,"_5":14363,"_27392":121345,"_2946":121437},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3461":71799,"_30106":71756,"_20907":121439,"_5":14363,"_27392":121349,"_2946":121440},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3461":71800,"_30106":71756,"_20907":121442,"_5":14363,"_27392":121349,"_2946":121443},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3461":71801,"_30106":71756,"_20907":121445,"_5":14363,"_27392":121349,"_2946":121446},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3461":71802,"_30106":71756,"_20907":121448,"_5":14363,"_27392":121349,"_2946":121449},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3461":71803,"_30106":71756,"_20907":121451,"_5":14363,"_27392":121349,"_2946":121452},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3461":71804,"_30106":71756,"_20907":121454,"_5":14363,"_27392":121349,"_2946":121455},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3461":71805,"_30106":71756,"_20907":121457,"_5":14363,"_27392":121349,"_2946":121458},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3461":71806,"_30106":71806,"_5":14715,"_2946":121460,"_30438":121461,"_20907":121462,"_27392":71806},"Autoridades de certificación",[49125,117420,54598,121298],[],{"_3461":71807,"_30106":71806,"_20907":121464,"_5":14363,"_27392":71806,"_2946":121465},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3461":71808,"_30106":71806,"_5":30435,"_20907":121467,"_27392":121468,"_2946":121469},[],"/docs/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3461":71809,"_30106":71806,"_5":30435,"_20907":121471,"_27392":121472,"_2946":121473},[],"/docs/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3461":71810,"_30106":71806,"_5":30435,"_20907":121475,"_27392":121476,"_2946":115998},[],"/docs/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3461":71811,"_30106":71806,"_5":30435,"_20907":121478,"_27392":121479,"_2946":121480},[],"/docs/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3461":71812,"_30106":71806,"_5":30435,"_20907":121482,"_27392":121483,"_2946":121484},[],"/docs/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3461":71813,"_30106":71806,"_5":30435,"_20907":121486,"_27392":121487,"_2946":121488},[],"/docs/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3461":71814,"_30106":71806,"_5":30435,"_20907":121490,"_27392":121491,"_2946":121492},[],"/docs/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3461":71815,"_30106":71806,"_5":30435,"_20907":121494,"_27392":121495,"_2946":121496},[],"/docs/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3461":71816,"_30106":71806,"_5":30435,"_20907":121498,"_27392":121499,"_2946":121500},[],"/docs/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3461":71817,"_30106":71806,"_5":30435,"_20907":121502,"_27392":121503,"_2946":121504},[],"/docs/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3461":71818,"_30106":71806,"_5":30435,"_20907":121506,"_27392":121507,"_2946":121508},[],"/docs/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3461":71819,"_30106":71806,"_5":30435,"_20907":121510,"_27392":121511,"_2946":121512},[],"/docs/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3461":71820,"_30106":71806,"_5":30435,"_20907":121514,"_27392":121515,"_2946":121516},[],"/docs/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3461":71821,"_30106":71806,"_5":30435,"_20907":121518,"_27392":121519,"_2946":121520},[],"/docs/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3461":71822,"_30106":71806,"_5":30435,"_20907":121522,"_27392":121523,"_2946":121524},[],"/docs/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3461":71823,"_30106":71806,"_5":30435,"_20907":121526,"_27392":121527,"_2946":121528},[],"/docs/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3461":71824,"_30106":71806,"_5":30435,"_20907":121530,"_27392":121531,"_2946":121532},[],"/docs/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3461":71825,"_30106":71806,"_5":30435,"_20907":121534,"_27392":121535,"_2946":121536},[],"/docs/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3461":71826,"_30106":71806,"_5":30435,"_20907":121538,"_27392":121539,"_2946":121540},[],"/docs/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3461":71827,"_30106":71806,"_5":30435,"_20907":121542,"_27392":121543,"_2946":121544},[],"/docs/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3461":71828,"_30106":71806,"_5":30435,"_20907":121546,"_27392":121547,"_2946":121548},[],"/docs/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3461":71829,"_30106":71806,"_5":30435,"_20907":121550,"_27392":121551,"_2946":121552},[],"/docs/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3461":71830,"_30106":71806,"_5":30435,"_20907":121554,"_27392":121555,"_2946":121556},[],"/docs/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3461":71831,"_30106":71806,"_20907":121558,"_5":14363,"_27392":71806,"_2946":121559},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3461":71832,"_30106":71806,"_20907":121561,"_5":14363,"_27392":71806,"_2946":121562},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3461":71833,"_30106":71806,"_20907":121564,"_5":14363,"_27392":71806,"_2946":121565},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3461":71834,"_30106":71806,"_20907":121567,"_5":14363,"_27392":121468,"_2946":121568},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3461":71835,"_30106":71806,"_20907":121570,"_5":14363,"_27392":121468,"_2946":121571},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3461":71836,"_30106":71806,"_20907":121573,"_5":14363,"_27392":121468,"_2946":121574},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3461":71837,"_30106":71806,"_20907":121576,"_5":14363,"_27392":121468,"_2946":121577},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3461":71838,"_30106":71806,"_20907":121579,"_5":14363,"_27392":121468,"_2946":121580},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3461":71839,"_30106":71806,"_20907":121582,"_5":14363,"_27392":121476,"_2946":121583},[],"Decide si la CA será raíz o intermedia.",{"_3461":71840,"_30106":71806,"_20907":121585,"_5":14363,"_27392":121476,"_2946":121586},[],"Elige el motor que custodiará la clave.",{"_3461":71841,"_30106":71806,"_20907":121588,"_5":14363,"_27392":121476,"_2946":121589},[],"Define una validez superior a la de los certificados que emitirá.",{"_3461":71842,"_30106":71806,"_20907":121591,"_5":14363,"_27392":121476,"_2946":121592},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3461":71843,"_30106":71806,"_20907":121594,"_5":14363,"_27392":121479,"_2946":121595},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3461":71844,"_30106":71806,"_20907":121597,"_5":14363,"_27392":121483,"_2946":121598},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3461":71845,"_30106":71806,"_20907":121600,"_5":14363,"_27392":121483,"_2946":121601},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3461":71846,"_30106":71806,"_20907":121603,"_5":14363,"_27392":121487,"_2946":121604},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3461":71847,"_30106":71806,"_20907":121606,"_5":14363,"_27392":121491,"_2946":121607},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3461":71848,"_30106":71806,"_20907":121609,"_5":14363,"_27392":121491,"_2946":121610},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3461":71849,"_30106":71806,"_20907":121612,"_5":14363,"_27392":121491,"_2946":121613},[],"`ST`: estado o provincia.",{"_3461":71850,"_30106":71806,"_20907":121615,"_5":14363,"_27392":121491,"_2946":121616},[],"`L`: localidad.",{"_3461":71851,"_30106":71806,"_20907":121618,"_5":14363,"_27392":121491,"_2946":121619},[],"`O`: organización.",{"_3461":71852,"_30106":71806,"_20907":121621,"_5":14363,"_27392":121491,"_2946":121622},[],"`OU`: unidad organizativa.",{"_3461":71853,"_30106":71806,"_20907":121624,"_5":14363,"_27392":121491,"_2946":121625},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3461":71854,"_30106":71806,"_20907":121627,"_5":14363,"_27392":121495,"_2946":121628},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3461":71855,"_30106":71806,"_20907":121630,"_5":14363,"_27392":121495,"_2946":121631},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3461":71856,"_30106":71806,"_20907":121633,"_5":14363,"_27392":121499,"_2946":121634},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3461":71857,"_30106":71806,"_20907":121636,"_5":14363,"_27392":121499,"_2946":121637},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3461":71858,"_30106":71806,"_20907":121639,"_5":14363,"_27392":121503,"_2946":121640},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3461":71859,"_30106":71806,"_20907":121642,"_5":14363,"_27392":121503,"_2946":121643},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3461":71860,"_30106":71806,"_20907":121645,"_5":14363,"_27392":121507,"_2946":121646},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3461":71861,"_30106":71806,"_20907":121648,"_5":14363,"_27392":121507,"_2946":121649},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3461":71862,"_30106":71806,"_20907":121651,"_5":14363,"_27392":121507,"_2946":121652},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3461":71863,"_30106":71806,"_20907":121654,"_5":14363,"_27392":121511,"_2946":121655},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3461":71864,"_30106":71806,"_20907":121657,"_5":14363,"_27392":121515,"_2946":121658},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3461":71865,"_30106":71806,"_20907":121660,"_5":14363,"_27392":121515,"_2946":121661},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3461":71866,"_30106":71806,"_20907":121663,"_5":14363,"_27392":121519,"_2946":121664},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3461":71867,"_30106":71806,"_20907":121666,"_5":14363,"_27392":121523,"_2946":121667},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3461":71868,"_30106":71806,"_20907":121669,"_5":14363,"_27392":121523,"_2946":121670},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3461":71869,"_30106":71806,"_20907":121672,"_5":14363,"_27392":121527,"_2946":121673},[],"Abre una CA desde el inventario para consultar:",{"_3461":71870,"_30106":71806,"_20907":121675,"_5":14363,"_27392":121527,"_2946":121676},[],"Estado y periodo de validez.",{"_3461":71871,"_30106":71806,"_20907":121678,"_5":14363,"_27392":121527,"_2946":121679},[],"Certificado y cadena en formato PEM.",{"_3461":71872,"_30106":71806,"_20907":121681,"_5":14363,"_27392":121527,"_2946":121682},[],"Número de certificados activos, expirados y revocados.",{"_3461":71873,"_30106":71806,"_20907":121684,"_5":14363,"_27392":121527,"_2946":121685},[],"Certificados emitidos en **Issued Certificates**.",{"_3461":71874,"_30106":71806,"_20907":121687,"_5":14363,"_27392":121527,"_2946":121688},[],"CRL vinculada a la autoridad.",{"_3461":71875,"_30106":71806,"_20907":121690,"_5":14363,"_27392":121527,"_2946":121691},[],"Metadatos y motor criptográfico asociado.",{"_3461":71876,"_30106":71806,"_20907":121693,"_5":14363,"_27392":121527,"_2946":121694},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3461":71877,"_30106":71806,"_20907":121696,"_5":14363,"_27392":121531,"_2946":121697},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3461":71878,"_30106":71806,"_20907":121699,"_5":14363,"_27392":121531,"_2946":121700},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3461":71879,"_30106":71806,"_20907":121702,"_5":14363,"_27392":121531,"_2946":121703},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3461":71880,"_30106":71806,"_20907":121705,"_5":14363,"_27392":121531,"_2946":121706},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3461":71881,"_30106":71806,"_20907":121708,"_5":14363,"_27392":121535,"_2946":121709},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3461":71882,"_30106":71806,"_20907":121711,"_5":14363,"_27392":121539,"_2946":121712},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3461":71883,"_30106":71806,"_20907":121714,"_5":14363,"_27392":121543,"_2946":121715},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3461":71884,"_30106":71806,"_20907":121717,"_5":14363,"_27392":121547,"_2946":121718},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3461":71885,"_30106":71806,"_20907":121720,"_5":14363,"_27392":121551,"_2946":121721},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3461":71886,"_30106":71806,"_20907":121723,"_5":14363,"_27392":121555,"_2946":121724},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3461":71887,"_30106":71806,"_20907":121726,"_5":14363,"_27392":121555,"_2946":121727},[],"Los ajustes de CRL de la CA se conservan y no pueden borrarse por API. La última CRL sigue sirviéndose, pero una vez desaparecida la CA nada la regenera, así que ajusta antes su validez y su firmante (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3461":71888,"_30106":71806,"_20907":121729,"_5":14363,"_27392":121555,"_2946":121730},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3461":71889,"_30106":71889,"_5":14715,"_2946":121732,"_30438":121733,"_20907":121734,"_27392":71889},"Perfiles de certificado",[49125,117420,54598,121298],[],{"_3461":71890,"_30106":71889,"_20907":121736,"_5":14363,"_27392":71889,"_2946":121737},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3461":71891,"_30106":71889,"_5":30435,"_20907":121739,"_27392":121740,"_2946":121741},[],"/docs/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3461":71892,"_30106":71889,"_5":30435,"_20907":121743,"_27392":121744,"_2946":121745},[],"/docs/es/platform/pki/certificate-profiles#validez","Validez",{"_3461":71893,"_30106":71889,"_5":30435,"_20907":121747,"_27392":121748,"_2946":121749},[],"/docs/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3461":71894,"_30106":71889,"_5":30435,"_20907":121751,"_27392":121752,"_2946":121753},[],"/docs/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3461":71895,"_30106":71889,"_5":30435,"_20907":121755,"_27392":121756,"_2946":121757},[],"/docs/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3461":71896,"_30106":71889,"_5":30435,"_20907":121759,"_27392":121760,"_2946":121761},[],"/docs/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3461":71897,"_30106":71889,"_5":30435,"_20907":121763,"_27392":121764,"_2946":121765},[],"/docs/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3461":71898,"_30106":71889,"_5":30435,"_20907":121767,"_27392":121768,"_2946":121769},[],"/docs/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3461":71899,"_30106":71889,"_5":30435,"_20907":121771,"_27392":121772,"_2946":121773},[],"/docs/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3461":71900,"_30106":71889,"_5":30435,"_20907":121775,"_27392":121776,"_2946":121777},[],"/docs/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3461":71901,"_30106":71889,"_5":30435,"_20907":121779,"_27392":121780,"_2946":121781},[],"/docs/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3461":71902,"_30106":71889,"_5":30435,"_20907":121783,"_27392":121784,"_2946":121785},[],"/docs/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3461":71903,"_30106":71889,"_5":30435,"_20907":121787,"_27392":121788,"_2946":121789},[],"/docs/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3461":71904,"_30106":71889,"_5":30435,"_20907":121791,"_27392":121792,"_2946":121793},[],"/docs/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3461":71905,"_30106":71889,"_5":30435,"_20907":121795,"_27392":121796,"_2946":121797},[],"/docs/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3461":71906,"_30106":71889,"_5":30435,"_20907":121799,"_27392":121800,"_2946":121801},[],"/docs/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3461":71907,"_30106":71889,"_20907":121803,"_5":14363,"_27392":71889,"_2946":121804},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3461":71908,"_30106":71889,"_20907":121806,"_5":14363,"_27392":71889,"_2946":121807},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3461":71909,"_30106":71889,"_20907":121809,"_5":14363,"_27392":121744,"_2946":121810},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3461":71910,"_30106":71889,"_20907":121812,"_5":14363,"_27392":121744,"_2946":121813},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3461":71911,"_30106":71889,"_20907":121815,"_5":14363,"_27392":121748,"_2946":121816},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_3461":71912,"_30106":71889,"_20907":121818,"_5":14363,"_27392":121752,"_2946":121819},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3461":71913,"_30106":71889,"_20907":121821,"_5":14363,"_27392":121752,"_2946":121822},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3461":71914,"_30106":71889,"_20907":121824,"_5":14363,"_27392":121752,"_2946":121825},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3461":71915,"_30106":71889,"_20907":121827,"_5":14363,"_27392":121756,"_2946":121828},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3461":71916,"_30106":71889,"_20907":121830,"_5":14363,"_27392":121760,"_2946":121831},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3461":71917,"_30106":71889,"_20907":121833,"_5":14363,"_27392":121760,"_2946":121834},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3461":71918,"_30106":71889,"_20907":121836,"_5":14363,"_27392":121764,"_2946":121837},[],"La aplicación criptográfica puede:",{"_3461":71919,"_30106":71889,"_20907":121839,"_5":14363,"_27392":121764,"_2946":121840},[],"permitir o bloquear claves RSA;",{"_3461":71920,"_30106":71889,"_20907":121842,"_5":14363,"_27392":121764,"_2946":121843},[],"limitar los tamaños RSA admitidos;",{"_3461":71921,"_30106":71889,"_20907":121845,"_5":14363,"_27392":121764,"_2946":121846},[],"permitir o bloquear claves ECDSA;",{"_3461":71922,"_30106":71889,"_20907":121848,"_5":14363,"_27392":121764,"_2946":121849},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3461":71923,"_30106":71889,"_20907":121851,"_5":14363,"_27392":121764,"_2946":121852},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3461":71924,"_30106":71889,"_20907":121854,"_5":14363,"_27392":121768,"_2946":121855},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3461":71925,"_30106":71889,"_20907":121857,"_5":14363,"_27392":121768,"_2946":117180},[],{"_3461":71926,"_30106":71889,"_20907":121859,"_5":14363,"_27392":121768,"_2946":121860},[],"Primera opción",{"_3461":71927,"_30106":71889,"_20907":121862,"_5":14363,"_27392":121768,"_2946":121863},[],"Segunda opción",{"_3461":71928,"_30106":71889,"_20907":121865,"_5":14363,"_27392":121768,"_2946":121866},[],"Si no hay ninguna",{"_3461":71929,"_30106":71889,"_20907":121868,"_5":14363,"_27392":121768,"_2946":121869},[],"Firma directa con una CA",{"_3461":71930,"_30106":71889,"_20907":121871,"_5":14363,"_27392":121768,"_2946":121872},[],"`issuance_profile` incluido en la solicitud",{"_3461":71931,"_30106":71889,"_20907":121874,"_5":14363,"_27392":121768,"_2946":121875},[],"`issuance_profile_id` de la solicitud",{"_3461":71932,"_30106":71889,"_20907":121877,"_5":14363,"_27392":121768,"_2946":121878},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3461":71933,"_30106":71889,"_20907":121880,"_5":14363,"_27392":121768,"_2946":121881},[],"Emisión mediante DMS",{"_3461":71934,"_30106":71889,"_20907":121883,"_5":14363,"_27392":121768,"_2946":55185},[],{"_3461":71935,"_30106":71889,"_20907":121885,"_5":14363,"_27392":121768,"_2946":121886},[],"`settings.issuance_profile` incluido en el DMS",{"_3461":71936,"_30106":71889,"_20907":121888,"_5":14363,"_27392":121768,"_2946":121889},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3461":71937,"_30106":71889,"_20907":121891,"_5":14363,"_27392":121768,"_2946":121892},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3461":71938,"_30106":71889,"_20907":121894,"_5":14363,"_27392":121768,"_2946":121895},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3461":71939,"_30106":71889,"_20907":121897,"_5":14363,"_27392":121776,"_2946":121898},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3461":71940,"_30106":71889,"_20907":121900,"_5":14363,"_27392":121780,"_2946":121901},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3461":71941,"_30106":71889,"_20907":121903,"_5":14363,"_27392":121784,"_2946":121904},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3461":71942,"_30106":71889,"_20907":121906,"_5":14363,"_27392":121788,"_2946":121907},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3461":71943,"_30106":71889,"_20907":121909,"_5":14363,"_27392":121792,"_2946":121910},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3461":71944,"_30106":71889,"_20907":121912,"_5":14363,"_27392":121792,"_2946":121913},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3461":71945,"_30106":71889,"_20907":121915,"_5":14363,"_27392":121796,"_2946":121916},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3461":71946,"_30106":71889,"_20907":121918,"_5":14363,"_27392":121796,"_2946":121919},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3461":71947,"_30106":71889,"_20907":121921,"_5":14363,"_27392":121796,"_2946":121922},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3461":71948,"_30106":71889,"_20907":121924,"_5":14363,"_27392":121796,"_2946":121925},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3461":71949,"_30106":71889,"_20907":121927,"_5":14363,"_27392":121800,"_2946":121928},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3461":71950,"_30106":71889,"_20907":121930,"_5":14363,"_27392":121800,"_2946":121931},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3461":71951,"_30106":71951,"_5":14715,"_2946":121933,"_30438":121934,"_20907":121936,"_27392":71951},"Validación de certificados",[49125,117420,54598,121935],"Validación",[],{"_3461":71952,"_30106":71951,"_20907":121938,"_5":14363,"_27392":71951,"_2946":121939},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3461":71953,"_30106":71951,"_5":30435,"_20907":121941,"_27392":121942,"_2946":121943},[],"/docs/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3461":71954,"_30106":71951,"_5":30435,"_20907":121945,"_27392":121946,"_2946":121947},[],"/docs/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3461":71955,"_30106":71951,"_5":30435,"_20907":121949,"_27392":121950,"_2946":121951},[],"/docs/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3461":71956,"_30106":71951,"_20907":121953,"_5":14363,"_27392":71951,"_2946":121954},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3461":71957,"_30106":71951,"_20907":121956,"_5":14363,"_27392":121942,"_2946":121957},[],"Verifica estos criterios juntos:",{"_3461":71958,"_30106":71951,"_20907":121959,"_5":14363,"_27392":121942,"_2946":120927},[],{"_3461":71959,"_30106":71951,"_20907":121961,"_5":14363,"_27392":121942,"_2946":121962},[],"Resultado necesario",{"_3461":71960,"_30106":71951,"_20907":121964,"_5":14363,"_27392":121942,"_2946":121965},[],"Cadena y firma",{"_3461":71961,"_30106":71951,"_20907":121967,"_5":14363,"_27392":121942,"_2946":121968},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3461":71962,"_30106":71951,"_20907":121970,"_5":14363,"_27392":121942,"_2946":121971},[],"Fechas",{"_3461":71963,"_30106":71951,"_20907":121973,"_5":14363,"_27392":121942,"_2946":121974},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3461":71964,"_30106":71951,"_20907":121976,"_5":14363,"_27392":121942,"_2946":117090},[],{"_3461":71965,"_30106":71951,"_20907":121978,"_5":14363,"_27392":121942,"_2946":121979},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3461":71966,"_30106":71951,"_20907":121981,"_5":14363,"_27392":121942,"_2946":121982},[],"Uso",{"_3461":71967,"_30106":71951,"_20907":121984,"_5":14363,"_27392":121942,"_2946":121985},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3461":71968,"_30106":71951,"_20907":121987,"_5":14363,"_27392":121942,"_2946":121988},[],"Revocación",{"_3461":71969,"_30106":71951,"_20907":121990,"_5":14363,"_27392":121942,"_2946":121991},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3461":71970,"_30106":71951,"_20907":121993,"_5":14363,"_27392":121942,"_2946":121994},[],"Autorización",{"_3461":71971,"_30106":71951,"_20907":121996,"_5":14363,"_27392":121942,"_2946":121997},[],"La aplicación permite la acción a esa identidad.",{"_3461":71972,"_30106":71951,"_20907":121999,"_5":14363,"_27392":121942,"_2946":122000},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3461":71973,"_30106":71951,"_20907":122002,"_5":14363,"_27392":121946,"_2946":122003},[],"Mecanismo",{"_3461":71974,"_30106":71951,"_20907":122005,"_5":14363,"_27392":121946,"_2946":122006},[],"Cuándo utilizarlo",{"_3461":71975,"_30106":71951,"_20907":122008,"_5":14363,"_27392":121946,"_2946":122009},[],"Qué debes mantener",{"_3461":71976,"_30106":71951,"_20907":122011,"_5":14363,"_27392":121946,"_2946":55313},[],{"_3461":71977,"_30106":71951,"_20907":122013,"_5":14363,"_27392":121946,"_2946":122014},[],"Consulta del estado de un certificado concreto.",{"_3461":71978,"_30106":71951,"_20907":122016,"_5":14363,"_27392":121946,"_2946":122017},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3461":71979,"_30106":71951,"_20907":122019,"_5":14363,"_27392":121946,"_2946":55322},[],{"_3461":71980,"_30106":71951,"_20907":122021,"_5":14363,"_27392":121946,"_2946":122022},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3461":71981,"_30106":71951,"_20907":122024,"_5":14363,"_27392":121946,"_2946":122025},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3461":71982,"_30106":71951,"_20907":122027,"_5":14363,"_27392":121946,"_2946":122028},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3461":71983,"_30106":71951,"_20907":122030,"_5":14363,"_27392":121946,"_2946":122031},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3461":71984,"_30106":71951,"_20907":122033,"_5":14363,"_27392":121950,"_2946":122034},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3461":71985,"_30106":71951,"_20907":122036,"_5":14363,"_27392":121950,"_2946":122037},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3461":71986,"_30106":71951,"_20907":122039,"_5":14363,"_27392":121950,"_2946":122040},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3461":71987,"_30106":71951,"_20907":122042,"_5":14363,"_27392":121950,"_2946":122043},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3461":71988,"_30106":71951,"_20907":122045,"_5":14363,"_27392":121950,"_2946":122046},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3461":71989,"_30106":71951,"_20907":122048,"_5":14363,"_27392":121950,"_2946":122049},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3461":71990,"_30106":71951,"_20907":122051,"_5":14363,"_27392":121950,"_2946":122052},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3461":71991,"_30106":71951,"_20907":122054,"_5":14363,"_27392":121950,"_2946":122055},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3461":71992,"_30106":71951,"_20907":122057,"_5":14363,"_27392":121950,"_2946":122058},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3461":71993,"_30106":71993,"_5":14715,"_2946":122060,"_30438":122061,"_20907":122062,"_27392":71993},"Certificados",[49125,117420,54598,121298],[],{"_3461":71994,"_30106":71993,"_20907":122064,"_5":14363,"_27392":71993,"_2946":122065},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3461":71995,"_30106":71993,"_5":30435,"_20907":122067,"_27392":122068,"_2946":122069},[],"/docs/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3461":71996,"_30106":71993,"_5":30435,"_20907":122071,"_27392":122072,"_2946":122073},[],"/docs/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3461":71997,"_30106":71993,"_5":30435,"_20907":122075,"_27392":122076,"_2946":122077},[],"/docs/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3461":71998,"_30106":71993,"_5":30435,"_20907":122079,"_27392":122080,"_2946":122081},[],"/docs/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3461":71999,"_30106":71993,"_5":30435,"_20907":122083,"_27392":122084,"_2946":122085},[],"/docs/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3461":72000,"_30106":71993,"_5":30435,"_20907":122087,"_27392":122088,"_2946":122089},[],"/docs/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3461":72001,"_30106":71993,"_5":30435,"_20907":122091,"_27392":122092,"_2946":122093},[],"/docs/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3461":72002,"_30106":71993,"_5":30435,"_20907":122095,"_27392":122096,"_2946":122097},[],"/docs/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3461":72003,"_30106":71993,"_5":30435,"_20907":122099,"_27392":122100,"_2946":122101},[],"/docs/es/platform/pki/certificates#continúa","Continúa",{"_3461":72004,"_30106":71993,"_20907":122103,"_5":14363,"_27392":71993,"_2946":122104},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3461":72005,"_30106":71993,"_20907":122106,"_5":14363,"_27392":122068,"_2946":122107},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3461":72006,"_30106":71993,"_20907":122109,"_5":14363,"_27392":122068,"_2946":122110},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3461":72007,"_30106":71993,"_20907":122112,"_5":14363,"_27392":122068,"_2946":122113},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3461":72008,"_30106":71993,"_20907":122115,"_5":14363,"_27392":122068,"_2946":122116},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3461":72009,"_30106":71993,"_20907":122118,"_5":14363,"_27392":122068,"_2946":122119},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3461":72010,"_30106":71993,"_20907":122121,"_5":14363,"_27392":122068,"_2946":122122},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3461":72011,"_30106":71993,"_20907":122124,"_5":14363,"_27392":122068,"_2946":122125},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3461":72012,"_30106":71993,"_20907":122127,"_5":14363,"_27392":122072,"_2946":122128},[],"Descarga el PEM e inspecciónalo:",{"_3461":72013,"_30106":71993,"_20907":122130,"_5":14363,"_27392":122072,"_2946":122131},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3461":72014,"_30106":71993,"_20907":122133,"_5":14363,"_27392":122076,"_2946":122134},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3461":72015,"_30106":71993,"_20907":122136,"_5":14363,"_27392":122076,"_2946":122137},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3461":72016,"_30106":71993,"_20907":122139,"_5":14363,"_27392":122076,"_2946":122140},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3461":72017,"_30106":71993,"_20907":122142,"_5":14363,"_27392":122076,"_2946":122143},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3461":72018,"_30106":71993,"_20907":122145,"_5":14363,"_27392":122076,"_2946":122146},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3461":72019,"_30106":71993,"_20907":122148,"_5":14363,"_27392":122076,"_2946":122149},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3461":72020,"_30106":71993,"_20907":122151,"_5":14363,"_27392":122076,"_2946":122152},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3461":72021,"_30106":71993,"_20907":122154,"_5":14363,"_27392":122080,"_2946":122155},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3461":72022,"_30106":71993,"_20907":122157,"_5":14363,"_27392":122084,"_2946":122158},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3461":72023,"_30106":71993,"_20907":122160,"_5":14363,"_27392":122088,"_2946":122161},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3461":72024,"_30106":71993,"_20907":122163,"_5":14363,"_27392":122092,"_2946":122164},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3461":72025,"_30106":71993,"_20907":122166,"_5":14363,"_27392":122092,"_2946":122167},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3461":72026,"_30106":71993,"_20907":122169,"_5":14363,"_27392":122092,"_2946":122170},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3461":72027,"_30106":71993,"_20907":122172,"_5":14363,"_27392":122096,"_2946":122173},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3461":72028,"_30106":71993,"_20907":122175,"_5":14363,"_27392":122096,"_2946":122176},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3461":72029,"_30106":71993,"_20907":122178,"_5":14363,"_27392":122096,"_2946":122179},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3461":72030,"_30106":71993,"_20907":122181,"_5":14363,"_27392":122100,"_2946":122182},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3461":72031,"_30106":71993,"_20907":122184,"_5":14363,"_27392":122100,"_2946":122185},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3461":72032,"_30106":72032,"_5":14715,"_2946":122187,"_30438":122188,"_20907":122190,"_27392":72032},"Ciclo de vida de un certificado",[49125,117420,54598,122189],"Conceptos",[],{"_3461":72033,"_30106":72032,"_20907":122192,"_5":14363,"_27392":72032,"_2946":122193},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3461":72034,"_30106":72032,"_5":30435,"_20907":122195,"_27392":122196,"_2946":122197},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3461":72035,"_30106":72032,"_5":30435,"_20907":122199,"_27392":122200,"_2946":122201},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3461":72036,"_30106":72032,"_5":30435,"_20907":122203,"_27392":122204,"_2946":122205},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3461":72037,"_30106":72032,"_5":30435,"_20907":122207,"_27392":122208,"_2946":122209},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3461":72038,"_30106":72032,"_5":30435,"_20907":122211,"_27392":122212,"_2946":122213},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3461":72039,"_30106":72032,"_5":30435,"_20907":122215,"_27392":122216,"_2946":122217},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3461":72040,"_30106":72032,"_5":30435,"_20907":122219,"_27392":122220,"_2946":119921},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3461":72041,"_30106":72032,"_5":30435,"_20907":122222,"_27392":122223,"_2946":122224},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3461":72042,"_30106":72032,"_5":30435,"_20907":122226,"_27392":122227,"_2946":122228},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3461":72043,"_30106":72032,"_5":30435,"_20907":122230,"_27392":122231,"_2946":122232},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3461":72044,"_30106":72032,"_20907":122234,"_5":14363,"_27392":72032,"_2946":122235},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3461":72045,"_30106":72032,"_20907":122237,"_5":14363,"_27392":122200,"_2946":122238},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3461":72046,"_30106":72032,"_20907":122240,"_5":14363,"_27392":122204,"_2946":122241},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3461":72047,"_30106":72032,"_20907":122243,"_5":14363,"_27392":122208,"_2946":122244},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3461":72048,"_30106":72032,"_20907":122246,"_5":14363,"_27392":122212,"_2946":122247},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3461":72049,"_30106":72032,"_20907":122249,"_5":14363,"_27392":122216,"_2946":122250},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3461":72050,"_30106":72032,"_20907":122252,"_5":14363,"_27392":122220,"_2946":122253},[],"Lamassu persiste cuatro estados X.509:",{"_3461":72051,"_30106":72032,"_20907":122255,"_5":14363,"_27392":122220,"_2946":122256},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3461":72052,"_30106":72032,"_20907":122258,"_5":14363,"_27392":122220,"_2946":122259},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3461":72053,"_30106":72032,"_20907":122261,"_5":14363,"_27392":122220,"_2946":122262},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3461":72054,"_30106":72032,"_20907":122264,"_5":14363,"_27392":122220,"_2946":122265},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3461":72055,"_30106":72032,"_20907":122267,"_5":14363,"_27392":122220,"_2946":122268},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3461":72056,"_30106":72032,"_20907":122270,"_5":14363,"_27392":122223,"_2946":122271},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3461":72057,"_30106":72032,"_20907":122273,"_5":14363,"_27392":122223,"_2946":122274},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3461":72058,"_30106":72032,"_20907":122276,"_5":14363,"_27392":122223,"_2946":122277},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3461":72059,"_30106":72032,"_20907":122279,"_5":14363,"_27392":122227,"_2946":122280},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3461":72060,"_30106":72032,"_20907":122282,"_5":14363,"_27392":122227,"_2946":122283},[],"Antes de confirmar:",{"_3461":72061,"_30106":72032,"_20907":122285,"_5":14363,"_27392":122227,"_2946":122286},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3461":72062,"_30106":72032,"_20907":122288,"_5":14363,"_27392":122227,"_2946":122289},[],"Distribuye la nueva cadena de confianza.",{"_3461":72063,"_30106":72032,"_20907":122291,"_5":14363,"_27392":122227,"_2946":122292},[],"Reemite las identidades necesarias.",{"_3461":72064,"_30106":72032,"_20907":122294,"_5":14363,"_27392":122227,"_2946":122295},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3461":72065,"_30106":72032,"_20907":122297,"_5":14363,"_27392":122227,"_2946":122298},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3461":72066,"_30106":72032,"_20907":122300,"_5":14363,"_27392":122227,"_2946":122301},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3461":72067,"_30106":72032,"_20907":122303,"_5":14363,"_27392":122231,"_2946":122304},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3461":72068,"_30106":72032,"_20907":122306,"_5":14363,"_27392":122231,"_2946":122307},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3461":72069,"_30106":72032,"_20907":122309,"_5":14363,"_27392":122231,"_2946":122310},[],"Cambios de estado y razones de revocación.",{"_3461":72070,"_30106":72032,"_20907":122312,"_5":14363,"_27392":122231,"_2946":122313},[],"Publicación y vigencia de OCSP y CRLs.",{"_3461":72071,"_30106":72032,"_20907":122315,"_5":14363,"_27392":122231,"_2946":122316},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3461":72072,"_30106":72032,"_20907":122318,"_5":14363,"_27392":122231,"_2946":122319},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3461":72073,"_30106":72073,"_5":14715,"_2946":122321,"_30438":122322,"_20907":122323,"_27392":72073},"Modelo de confianza",[49125,117420,54598,122189],[],{"_3461":72074,"_30106":72073,"_20907":122325,"_5":14363,"_27392":72073,"_2946":122326},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3461":72075,"_30106":72073,"_5":30435,"_20907":122328,"_27392":122329,"_2946":122330},[],"/docs/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3461":72076,"_30106":72073,"_5":30435,"_20907":122332,"_27392":122333,"_2946":122334},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3461":72077,"_30106":72073,"_5":30435,"_20907":122336,"_27392":122337,"_2946":122338},[],"/docs/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3461":72078,"_30106":72073,"_5":30435,"_20907":122340,"_27392":122341,"_2946":122342},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3461":72079,"_30106":72073,"_5":30435,"_20907":122344,"_27392":122345,"_2946":122346},[],"/docs/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3461":72080,"_30106":72073,"_5":30435,"_20907":122348,"_27392":122349,"_2946":122350},[],"/docs/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3461":72081,"_30106":72073,"_5":30435,"_20907":122352,"_27392":122353,"_2946":122354},[],"/docs/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3461":72082,"_30106":72073,"_5":30435,"_20907":122356,"_27392":122357,"_2946":122358},[],"/docs/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3461":72083,"_30106":72073,"_5":30435,"_20907":122360,"_27392":122361,"_2946":122362},[],"/docs/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3461":72084,"_30106":72073,"_5":30435,"_20907":122364,"_27392":122365,"_2946":122366},[],"/docs/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3461":72085,"_30106":72073,"_20907":122368,"_5":14363,"_27392":72073,"_2946":122369},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3461":72086,"_30106":72073,"_20907":122371,"_5":14363,"_27392":122333,"_2946":122372},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3461":72087,"_30106":72073,"_20907":122374,"_5":14363,"_27392":122337,"_2946":122375},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3461":72088,"_30106":72073,"_20907":122377,"_5":14363,"_27392":122341,"_2946":122378},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3461":72089,"_30106":72073,"_20907":122380,"_5":14363,"_27392":122345,"_2946":122381},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3461":72090,"_30106":72073,"_20907":122383,"_5":14363,"_27392":122349,"_2946":122384},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3461":72091,"_30106":72073,"_20907":122386,"_5":14363,"_27392":122349,"_2946":122387},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3461":72092,"_30106":72073,"_20907":122389,"_5":14363,"_27392":122349,"_2946":122390},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3461":72093,"_30106":72073,"_20907":122392,"_5":14363,"_27392":122349,"_2946":122393},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3461":72094,"_30106":72073,"_20907":122395,"_5":14363,"_27392":122349,"_2946":122396},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3461":72095,"_30106":72073,"_20907":122398,"_5":14363,"_27392":122349,"_2946":122399},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3461":72096,"_30106":72073,"_20907":122401,"_5":14363,"_27392":122353,"_2946":122402},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3461":72097,"_30106":72073,"_20907":122404,"_5":14363,"_27392":122353,"_2946":122405},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3461":72098,"_30106":72073,"_20907":122407,"_5":14363,"_27392":122353,"_2946":122408},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3461":72099,"_30106":72073,"_20907":122410,"_5":14363,"_27392":122353,"_2946":122411},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3461":72100,"_30106":72073,"_20907":122413,"_5":14363,"_27392":122353,"_2946":122414},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3461":72101,"_30106":72073,"_20907":122416,"_5":14363,"_27392":122357,"_2946":122417},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3461":72102,"_30106":72073,"_20907":122419,"_5":14363,"_27392":122357,"_2946":122420},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3461":72103,"_30106":72073,"_20907":122422,"_5":14363,"_27392":122357,"_2946":122423},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3461":72104,"_30106":72073,"_20907":122425,"_5":14363,"_27392":122357,"_2946":122426},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3461":72105,"_30106":72073,"_20907":122428,"_5":14363,"_27392":122357,"_2946":122429},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3461":72106,"_30106":72073,"_20907":122431,"_5":14363,"_27392":122357,"_2946":122432},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3461":72107,"_30106":72073,"_20907":122434,"_5":14363,"_27392":122357,"_2946":122435},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3461":72108,"_30106":72073,"_20907":122437,"_5":14363,"_27392":122361,"_2946":122438},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3461":72109,"_30106":72073,"_20907":122440,"_5":14363,"_27392":122365,"_2946":122441},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3461":72110,"_30106":72073,"_20907":122443,"_5":14363,"_27392":122365,"_2946":122444},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3461":72111,"_30106":72073,"_20907":122446,"_5":14363,"_27392":122365,"_2946":122447},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3461":72112,"_30106":72073,"_20907":122449,"_5":14363,"_27392":122365,"_2946":122450},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3461":72113,"_30106":72073,"_20907":122452,"_5":14363,"_27392":122365,"_2946":122453},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3461":72114,"_30106":72073,"_20907":122455,"_5":14363,"_27392":122365,"_2946":122456},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3461":72115,"_30106":72073,"_20907":122458,"_5":14363,"_27392":122365,"_2946":122459},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3461":72116,"_30106":72116,"_5":14715,"_2946":122461,"_30438":122462,"_20907":122463,"_27392":72116},"Listas de revocación (CRL)",[49125,117420,54598,121935],[],{"_3461":72117,"_30106":72116,"_20907":122465,"_5":14363,"_27392":72116,"_2946":122466},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3461":72118,"_30106":72116,"_5":30435,"_20907":122468,"_27392":122469,"_2946":122470},[],"/docs/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3461":72119,"_30106":72116,"_5":30435,"_20907":122472,"_27392":122473,"_2946":122474},[],"/docs/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3461":72120,"_30106":72116,"_5":30435,"_20907":122476,"_27392":122477,"_2946":122478},[],"/docs/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3461":72121,"_30106":72116,"_5":30435,"_20907":122480,"_27392":122481,"_2946":122482},[],"/docs/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3461":72122,"_30106":72116,"_5":30435,"_20907":122484,"_27392":122485,"_2946":122486},[],"/docs/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3461":72123,"_30106":72116,"_5":30435,"_20907":122488,"_27392":122489,"_2946":122490},[],"/docs/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3461":72124,"_30106":72116,"_5":30435,"_20907":122492,"_27392":122493,"_2946":122494},[],"/docs/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3461":72125,"_30106":72116,"_5":30435,"_20907":122496,"_27392":122497,"_2946":122498},[],"/docs/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3461":72126,"_30106":72116,"_5":30435,"_20907":122500,"_27392":122501,"_2946":122502},[],"/docs/es/platform/pki/crl#referencias","Referencias",{"_3461":72127,"_30106":72116,"_20907":122504,"_5":14363,"_27392":72116,"_2946":122505},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3461":72128,"_30106":72116,"_20907":122507,"_5":14363,"_27392":122469,"_2946":122508},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3461":72129,"_30106":72116,"_20907":122510,"_5":14363,"_27392":122469,"_2946":122511},[],"Campo",{"_3461":72130,"_30106":72116,"_20907":122513,"_5":14363,"_27392":122469,"_2946":118961},[],{"_3461":72131,"_30106":72116,"_20907":122515,"_5":14363,"_27392":122469,"_2946":55820},[],{"_3461":72132,"_30106":72116,"_20907":122517,"_5":14363,"_27392":122469,"_2946":122518},[],"ID de la CA a la que pertenecen los ajustes.",{"_3461":72133,"_30106":72116,"_20907":122520,"_5":14363,"_27392":122469,"_2946":55826},[],{"_3461":72134,"_30106":72116,"_20907":122522,"_5":14363,"_27392":122469,"_2946":122523},[],"Los ajustes `ACTIVE` generan CRLs. Los `ARCHIVED` pertenecen a una CA que ya no existe: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3461":72135,"_30106":72116,"_20907":122525,"_5":14363,"_27392":122469,"_2946":55832},[],{"_3461":72136,"_30106":72116,"_20907":122527,"_5":14363,"_27392":122469,"_2946":122528},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3461":72137,"_30106":72116,"_20907":122530,"_5":14363,"_27392":122469,"_2946":55838},[],{"_3461":72138,"_30106":72116,"_20907":122532,"_5":14363,"_27392":122469,"_2946":122533},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3461":72139,"_30106":72116,"_20907":122535,"_5":14363,"_27392":122469,"_2946":122536},[],"Campo de `crl_options`",{"_3461":72140,"_30106":72116,"_20907":122538,"_5":14363,"_27392":122469,"_2946":118961},[],{"_3461":72141,"_30106":72116,"_20907":122540,"_5":14363,"_27392":122469,"_2946":122541},[],"Valor inicial",{"_3461":72142,"_30106":72116,"_20907":122543,"_5":14363,"_27392":122469,"_2946":55852},[],{"_3461":72143,"_30106":72116,"_20907":122545,"_5":14363,"_27392":122469,"_2946":122546},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3461":72144,"_30106":72116,"_20907":122548,"_5":14363,"_27392":122469,"_2946":122549},[],"7 días.",{"_3461":72145,"_30106":72116,"_20907":122551,"_5":14363,"_27392":122469,"_2946":55861},[],{"_3461":72146,"_30106":72116,"_20907":122553,"_5":14363,"_27392":122469,"_2946":122554},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3461":72147,"_30106":72116,"_20907":122556,"_5":14363,"_27392":122469,"_2946":122557},[],"6 días y 23 horas.",{"_3461":72148,"_30106":72116,"_20907":122559,"_5":14363,"_27392":122469,"_2946":55870},[],{"_3461":72149,"_30106":72116,"_20907":122561,"_5":14363,"_27392":122469,"_2946":122562},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3461":72150,"_30106":72116,"_20907":122564,"_5":14363,"_27392":122469,"_2946":55876},[],{"_3461":72151,"_30106":72116,"_20907":122566,"_5":14363,"_27392":122469,"_2946":55879},[],{"_3461":72152,"_30106":72116,"_20907":122568,"_5":14363,"_27392":122469,"_2946":122569},[],"Número de serie del certificado existente que firma la CRL.",{"_3461":72153,"_30106":72116,"_20907":122571,"_5":14363,"_27392":122469,"_2946":122572},[],"Número de serie del certificado actual de la CA.",{"_3461":72154,"_30106":72116,"_20907":122574,"_5":14363,"_27392":122469,"_2946":122575},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3461":72155,"_30106":72116,"_20907":122577,"_5":14363,"_27392":122469,"_2946":122578},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3461":72156,"_30106":72116,"_20907":122580,"_5":14363,"_27392":122469,"_2946":122581},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3461":72157,"_30106":72116,"_20907":122583,"_5":14363,"_27392":122469,"_2946":122584},[],"Eliminar una CA conserva sus ajustes de CRL, que no pueden borrarse por API. Qué ocurre después depende de cuándo se eliminó la CA:",{"_3461":72158,"_30106":72116,"_20907":122586,"_5":14363,"_27392":122469,"_2946":122587},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3461":72159,"_30106":72116,"_20907":122589,"_5":14363,"_27392":122469,"_2946":122590},[],"Una CA eliminada con 4.0.0 en marcha deja ajustes `ACTIVE`. La última CRL sigue sirviéndose, pero una vez vencida nada la regenera: el trabajo de renovación registra `something went wrong while calculating CRL for CA <ca-id>` en cada ciclo porque ya no puede resolver la CA. Las opciones siguen editándose mientras el firmante no cambie; cambiarlo falla, porque ya no queda ninguna CA con la que coincidir.",{"_3461":72160,"_30106":72116,"_20907":122592,"_5":14363,"_27392":122469,"_2946":122593},[],"Ajusta validez y firmante antes de eliminar una CA.",{"_3461":72161,"_30106":72116,"_20907":122595,"_5":14363,"_27392":122469,"_2946":122596},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3461":72162,"_30106":72116,"_20907":122598,"_5":14363,"_27392":122469,"_2946":122599},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3461":72163,"_30106":72116,"_20907":122601,"_5":14363,"_27392":122469,"_2946":122602},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3461":72164,"_30106":72116,"_20907":122604,"_5":14363,"_27392":122473,"_2946":122605},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3461":72165,"_30106":72116,"_20907":122607,"_5":14363,"_27392":122473,"_2946":122608},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3461":72166,"_30106":72116,"_20907":122610,"_5":14363,"_27392":122473,"_2946":122611},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3461":72167,"_30106":72116,"_20907":122613,"_5":14363,"_27392":122473,"_2946":122614},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3461":72168,"_30106":72116,"_20907":122616,"_5":14363,"_27392":122477,"_2946":122617},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3461":72169,"_30106":72116,"_20907":122619,"_5":14363,"_27392":122477,"_2946":122620},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3461":72170,"_30106":72116,"_20907":122622,"_5":14363,"_27392":122477,"_2946":122623},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3461":72171,"_30106":72116,"_20907":122625,"_5":14363,"_27392":122477,"_2946":122626},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3461":72172,"_30106":72116,"_20907":122628,"_5":14363,"_27392":122477,"_2946":122629},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3461":72173,"_30106":72116,"_20907":122631,"_5":14363,"_27392":122477,"_2946":122632},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3461":72174,"_30106":72116,"_20907":122634,"_5":14363,"_27392":122477,"_2946":122635},[],"Los ajustes con `status` `ARCHIVED` se omiten: nada regenera su CRL.",{"_3461":72175,"_30106":72116,"_20907":122637,"_5":14363,"_27392":122477,"_2946":122638},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3461":72176,"_30106":72116,"_20907":122640,"_5":14363,"_27392":122477,"_2946":122641},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3461":72177,"_30106":72116,"_20907":122643,"_5":14363,"_27392":122481,"_2946":122644},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3461":72178,"_30106":72116,"_20907":122646,"_5":14363,"_27392":122481,"_2946":122647},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3461":72179,"_30106":72116,"_20907":122649,"_5":14363,"_27392":122485,"_2946":122650},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3461":72180,"_30106":72116,"_20907":122652,"_5":14363,"_27392":122485,"_2946":122653},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3461":72181,"_30106":72116,"_20907":122655,"_5":14363,"_27392":122485,"_2946":122656},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3461":72182,"_30106":72116,"_20907":122658,"_5":14363,"_27392":122485,"_2946":122659},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3461":72183,"_30106":72116,"_20907":122661,"_5":14363,"_27392":122485,"_2946":122662},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3461":72184,"_30106":72116,"_20907":122664,"_5":14363,"_27392":122489,"_2946":122665},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3461":72185,"_30106":72116,"_20907":122667,"_5":14363,"_27392":122489,"_2946":119150},[],{"_3461":72186,"_30106":72116,"_20907":122669,"_5":14363,"_27392":122489,"_2946":122670},[],"Path relativo",{"_3461":72187,"_30106":72116,"_20907":122672,"_5":14363,"_27392":122489,"_2946":117180},[],{"_3461":72188,"_30106":72116,"_20907":122674,"_5":14363,"_27392":122489,"_2946":55988},[],{"_3461":72189,"_30106":72116,"_20907":122676,"_5":14363,"_27392":122489,"_2946":55991},[],{"_3461":72190,"_30106":72116,"_20907":122678,"_5":14363,"_27392":122489,"_2946":122679},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3461":72191,"_30106":72116,"_20907":122681,"_5":14363,"_27392":122489,"_2946":55988},[],{"_3461":72192,"_30106":72116,"_20907":122683,"_5":14363,"_27392":122489,"_2946":55999},[],{"_3461":72193,"_30106":72116,"_20907":122685,"_5":14363,"_27392":122489,"_2946":122686},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3461":72194,"_30106":72116,"_20907":122688,"_5":14363,"_27392":122489,"_2946":56005},[],{"_3461":72195,"_30106":72116,"_20907":122690,"_5":14363,"_27392":122489,"_2946":55999},[],{"_3461":72196,"_30106":72116,"_20907":122692,"_5":14363,"_27392":122489,"_2946":122693},[],"Sustituir la configuración de CRL de una CA.",{"_3461":72197,"_30106":72116,"_20907":122695,"_5":14363,"_27392":122489,"_2946":122696},[],"Necesitas autenticación y permisos de lectura o actualización de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3461":72198,"_30106":72116,"_20907":122698,"_5":14363,"_27392":122489,"_2946":122699},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3461":72199,"_30106":72116,"_20907":122701,"_5":14363,"_27392":122493,"_2946":122702},[],"Síntoma",{"_3461":72200,"_30106":72116,"_20907":122704,"_5":14363,"_27392":122493,"_2946":122705},[],"Causa",{"_3461":72201,"_30106":72116,"_20907":122707,"_5":14363,"_27392":122493,"_2946":122708},[],"Acción",{"_3461":72202,"_30106":72116,"_20907":122710,"_5":14363,"_27392":122493,"_2946":122711},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3461":72203,"_30106":72116,"_20907":122713,"_5":14363,"_27392":122493,"_2946":122714},[],"Los ajustes no están `ACTIVE`: la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3461":72204,"_30106":72116,"_20907":122716,"_5":14363,"_27392":122493,"_2946":122717},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3461":72205,"_30106":72116,"_20907":122719,"_5":14363,"_27392":122493,"_2946":122720},[],"`PUT` devuelve 400.",{"_3461":72206,"_30106":72116,"_20907":122722,"_5":14363,"_27392":122493,"_2946":122723},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3461":72207,"_30106":72116,"_20907":122725,"_5":14363,"_27392":122493,"_2946":122726},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3461":72208,"_30106":72116,"_20907":122728,"_5":14363,"_27392":122493,"_2946":122729},[],"`PUT` devuelve 404.",{"_3461":72209,"_30106":72116,"_20907":122731,"_5":14363,"_27392":122493,"_2946":122732},[],"La CA o el certificado firmante nuevo no existen (por ejemplo, la CA se eliminó), o la CA no tiene ajustes de CRL (por ejemplo, una CA importada).",{"_3461":72210,"_30106":72116,"_20907":122734,"_5":14363,"_27392":122493,"_2946":122735},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3461":72211,"_30106":72116,"_20907":122737,"_5":14363,"_27392":122493,"_2946":122738},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3461":72212,"_30106":72116,"_20907":122740,"_5":14363,"_27392":122493,"_2946":122741},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3461":72213,"_30106":72116,"_20907":122743,"_5":14363,"_27392":122493,"_2946":122744},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3461":72214,"_30106":72116,"_20907":122746,"_5":14363,"_27392":122493,"_2946":122747},[],"La CRL no cambia tras revocar un certificado.",{"_3461":72215,"_30106":72116,"_20907":122749,"_5":14363,"_27392":122493,"_2946":122750},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3461":72216,"_30106":72116,"_20907":122752,"_5":14363,"_27392":122493,"_2946":122753},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3461":72217,"_30106":72116,"_20907":122755,"_5":14363,"_27392":122493,"_2946":122756},[],"Un verificador rechaza la CRL por el emisor.",{"_3461":72218,"_30106":72116,"_20907":122758,"_5":14363,"_27392":122493,"_2946":122759},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3461":72219,"_30106":72116,"_20907":122761,"_5":14363,"_27392":122493,"_2946":122762},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3461":72220,"_30106":72116,"_20907":122764,"_5":14363,"_27392":122497,"_2946":122765},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Los ajustes VA de la CA también permiten seleccionar el firmante de la CRL: el selector de certificados solo ofrece certificados que tienen clave privada y el uso de clave `cRLSign`. Si el certificado de un firmante configurado no puede resolverse, la interfaz muestra `Unknown Certificate (Serial: X)` o `Certificate details unavailable (Serial: X)`. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3461":72221,"_30106":72116,"_20907":122767,"_5":14363,"_27392":122501,"_2946":122768},[],"RFC 5280: perfil X.509 y CRL.",{"_3461":72222,"_30106":72116,"_20907":122770,"_5":14363,"_27392":122501,"_2946":56088},[],{"_3461":72223,"_30106":72116,"_20907":122772,"_5":14363,"_27392":122501,"_2946":56091},[],{"_3461":72224,"_30106":72116,"_20907":122774,"_5":14363,"_27392":122501,"_2946":122775},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3461":72225,"_30106":72116,"_20907":122777,"_5":14363,"_27392":122501,"_2946":122778},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3461":72226,"_30106":72226,"_5":14715,"_2946":122780,"_30438":122781,"_20907":122782,"_27392":72226},"Claves y motores criptográficos",[49125,117420,54598,121298],[],{"_3461":72227,"_30106":72226,"_20907":122784,"_5":14363,"_27392":72226,"_2946":122785},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3461":72228,"_30106":72226,"_5":30435,"_20907":122787,"_27392":122788,"_2946":122789},[],"/docs/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3461":72229,"_30106":72226,"_5":30435,"_20907":122791,"_27392":122792,"_2946":122793},[],"/docs/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3461":72230,"_30106":72226,"_5":30435,"_20907":122795,"_27392":122796,"_2946":56116},[],"/docs/es/platform/pki/key-management#file-system",{"_3461":72231,"_30106":72226,"_5":30435,"_20907":122798,"_27392":122799,"_2946":56120},[],"/docs/es/platform/pki/key-management#hashicorp-vault",{"_3461":72232,"_30106":72226,"_5":30435,"_20907":122801,"_27392":122802,"_2946":56124},[],"/docs/es/platform/pki/key-management#aws-secrets-manager",{"_3461":72233,"_30106":72226,"_5":30435,"_20907":122804,"_27392":122805,"_2946":56128},[],"/docs/es/platform/pki/key-management#aws-kms",{"_3461":72234,"_30106":72226,"_5":30435,"_20907":122807,"_27392":122808,"_2946":56132},[],"/docs/es/platform/pki/key-management#pkcs11",{"_3461":72235,"_30106":72226,"_5":30435,"_20907":122810,"_27392":122811,"_2946":56136},[],"/docs/es/platform/pki/key-management#azure-key-vault",{"_3461":72236,"_30106":72226,"_5":30435,"_20907":122813,"_27392":122814,"_2946":122815},[],"/docs/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3461":72237,"_30106":72226,"_5":30435,"_20907":122817,"_27392":122818,"_2946":122819},[],"/docs/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3461":72238,"_30106":72226,"_5":30435,"_20907":122821,"_27392":122822,"_2946":122823},[],"/docs/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3461":72239,"_30106":72226,"_5":30435,"_20907":122825,"_27392":122826,"_2946":122827},[],"/docs/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3461":72240,"_30106":72226,"_5":30435,"_20907":122829,"_27392":122830,"_2946":122831},[],"/docs/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3461":72241,"_30106":72226,"_5":30435,"_20907":122833,"_27392":122834,"_2946":122835},[],"/docs/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3461":72242,"_30106":72226,"_5":30435,"_20907":122837,"_27392":122838,"_2946":122839},[],"/docs/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3461":72243,"_30106":72226,"_5":30435,"_20907":122841,"_27392":122842,"_2946":56168},[],"/docs/es/platform/pki/key-management#sign",{"_3461":72244,"_30106":72226,"_5":30435,"_20907":122844,"_27392":122845,"_2946":56172},[],"/docs/es/platform/pki/key-management#verify",{"_3461":72245,"_30106":72226,"_5":30435,"_20907":122847,"_27392":122848,"_2946":122849},[],"/docs/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3461":72246,"_30106":72226,"_5":30435,"_20907":122851,"_27392":122852,"_2946":122853},[],"/docs/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3461":72247,"_30106":72226,"_5":30435,"_20907":122855,"_27392":122856,"_2946":122857},[],"/docs/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3461":72248,"_30106":72226,"_20907":122859,"_5":14363,"_27392":72226,"_2946":122860},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3461":72249,"_30106":72226,"_20907":122862,"_5":14363,"_27392":72226,"_2946":122863},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3461":72250,"_30106":72226,"_20907":122865,"_5":14363,"_27392":122788,"_2946":122866},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3461":72251,"_30106":72226,"_20907":122868,"_5":14363,"_27392":122788,"_2946":122869},[],"En la práctica, permite:",{"_3461":72252,"_30106":72226,"_20907":122871,"_5":14363,"_27392":122788,"_2946":122872},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3461":72253,"_30106":72226,"_20907":122874,"_5":14363,"_27392":122788,"_2946":122875},[],"Importar claves creadas externamente.",{"_3461":72254,"_30106":72226,"_20907":122877,"_5":14363,"_27392":122788,"_2946":122878},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3461":72255,"_30106":72226,"_20907":122880,"_5":14363,"_27392":122788,"_2946":122881},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3461":72256,"_30106":72226,"_20907":122883,"_5":14363,"_27392":122792,"_2946":122884},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3461":72257,"_30106":72226,"_20907":122886,"_5":14363,"_27392":122792,"_2946":122887},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3461":72258,"_30106":72226,"_20907":122889,"_5":14363,"_27392":122792,"_2946":122890},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3461":72259,"_30106":72226,"_20907":122892,"_5":14363,"_27392":122796,"_2946":122893},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3461":72260,"_30106":72226,"_20907":122895,"_5":14363,"_27392":122799,"_2946":122896},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3461":72261,"_30106":72226,"_20907":122898,"_5":14363,"_27392":122799,"_2946":122899},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3461":72262,"_30106":72226,"_20907":122901,"_5":14363,"_27392":122802,"_2946":122902},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3461":72263,"_30106":72226,"_20907":122904,"_5":14363,"_27392":122805,"_2946":122905},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3461":72264,"_30106":72226,"_20907":122907,"_5":14363,"_27392":122808,"_2946":122908},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3461":72265,"_30106":72226,"_20907":122910,"_5":14363,"_27392":122811,"_2946":122911},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3461":72266,"_30106":72226,"_20907":122913,"_5":14363,"_27392":122811,"_2946":122914},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3461":72267,"_30106":72226,"_20907":122916,"_5":14363,"_27392":122811,"_2946":122917},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3461":72268,"_30106":72226,"_20907":122919,"_5":14363,"_27392":122811,"_2946":122920},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3461":72269,"_30106":72226,"_20907":122922,"_5":14363,"_27392":122814,"_2946":122923},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3461":72270,"_30106":72226,"_20907":122925,"_5":14363,"_27392":122814,"_2946":122926},[],"La tabla incluye los siguientes campos:",{"_3461":72271,"_30106":72226,"_20907":122928,"_5":14363,"_27392":122814,"_2946":122929},[],"**Name**: nombre descriptivo de la clave.",{"_3461":72272,"_30106":72226,"_20907":122931,"_5":14363,"_27392":122814,"_2946":122932},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3461":72273,"_30106":72226,"_20907":122934,"_5":14363,"_27392":122814,"_2946":122935},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3461":72274,"_30106":72226,"_20907":122937,"_5":14363,"_27392":122814,"_2946":122938},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3461":72275,"_30106":72226,"_20907":122940,"_5":14363,"_27392":122814,"_2946":122941},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3461":72276,"_30106":72226,"_20907":122943,"_5":14363,"_27392":122814,"_2946":122944},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3461":72277,"_30106":72226,"_20907":122946,"_5":14363,"_27392":122814,"_2946":122947},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3461":72278,"_30106":72226,"_20907":122949,"_5":14363,"_27392":122814,"_2946":122950},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3461":72279,"_30106":72226,"_20907":122952,"_5":14363,"_27392":122814,"_2946":122953},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3461":72280,"_30106":72226,"_20907":122955,"_5":14363,"_27392":122814,"_2946":122956},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3461":72281,"_30106":72226,"_20907":122958,"_5":14363,"_27392":122814,"_2946":122959},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3461":72282,"_30106":72226,"_20907":122961,"_5":14363,"_27392":122814,"_2946":122962},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3461":72283,"_30106":72226,"_20907":122964,"_5":14363,"_27392":122814,"_2946":122965},[],"**Delete Key** para eliminar la clave del sistema.",{"_3461":72284,"_30106":72226,"_20907":122967,"_5":14363,"_27392":122818,"_2946":122968},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3461":72285,"_30106":72226,"_20907":122970,"_5":14363,"_27392":122822,"_2946":122971},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3461":72286,"_30106":72226,"_20907":122973,"_5":14363,"_27392":122822,"_2946":122974},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3461":72287,"_30106":72226,"_20907":122976,"_5":14363,"_27392":122822,"_2946":122977},[],"**Key Name**: nombre único y descriptivo.",{"_3461":72288,"_30106":72226,"_20907":122979,"_5":14363,"_27392":122822,"_2946":122980},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3461":72289,"_30106":72226,"_20907":122982,"_5":14363,"_27392":122822,"_2946":122983},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3461":72290,"_30106":72226,"_20907":122985,"_5":14363,"_27392":122822,"_2946":122986},[],"**Tags**: metadatos para clasificar la clave.",{"_3461":72291,"_30106":72226,"_20907":122988,"_5":14363,"_27392":122822,"_2946":122989},[],"**Metadata**: información adicional para usos avanzados.",{"_3461":72292,"_30106":72226,"_20907":122991,"_5":14363,"_27392":122826,"_2946":122992},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3461":72293,"_30106":72226,"_20907":122994,"_5":14363,"_27392":122826,"_2946":122995},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3461":72294,"_30106":72226,"_20907":122997,"_5":14363,"_27392":122826,"_2946":122998},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3461":72295,"_30106":72226,"_20907":123000,"_5":14363,"_27392":122826,"_2946":123001},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3461":72296,"_30106":72226,"_20907":123003,"_5":14363,"_27392":122826,"_2946":123004},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3461":72297,"_30106":72226,"_20907":123006,"_5":14363,"_27392":122826,"_2946":123007},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3461":72298,"_30106":72226,"_20907":123009,"_5":14363,"_27392":122826,"_2946":123010},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3461":72299,"_30106":72226,"_20907":123012,"_5":14363,"_27392":122826,"_2946":123013},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3461":72300,"_30106":72226,"_20907":123015,"_5":14363,"_27392":122826,"_2946":123016},[],"**Metadata**: información adicional opcional.",{"_3461":72301,"_30106":72226,"_20907":123018,"_5":14363,"_27392":122826,"_2946":123019},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3461":72302,"_30106":72226,"_20907":123021,"_5":14363,"_27392":122826,"_2946":123022},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3461":72303,"_30106":72226,"_20907":123024,"_5":14363,"_27392":122830,"_2946":123025},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3461":72304,"_30106":72226,"_20907":123027,"_5":14363,"_27392":122834,"_2946":123028},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3461":72305,"_30106":72226,"_20907":123030,"_5":14363,"_27392":122834,"_2946":123031},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3461":72306,"_30106":72226,"_20907":123033,"_5":14363,"_27392":122834,"_2946":123034},[],"**Key Name**: nombre descriptivo.",{"_3461":72307,"_30106":72226,"_20907":123036,"_5":14363,"_27392":122834,"_2946":123037},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3461":72308,"_30106":72226,"_20907":123039,"_5":14363,"_27392":122834,"_2946":123040},[],"**Tags**: etiquetas asociadas.",{"_3461":72309,"_30106":72226,"_20907":123042,"_5":14363,"_27392":122834,"_2946":123043},[],"**Aliases**: nombres alternativos.",{"_3461":72310,"_30106":72226,"_20907":123045,"_5":14363,"_27392":122834,"_2946":123046},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3461":72311,"_30106":72226,"_20907":123048,"_5":14363,"_27392":122834,"_2946":123049},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3461":72312,"_30106":72226,"_20907":123051,"_5":14363,"_27392":122834,"_2946":123052},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3461":72313,"_30106":72226,"_20907":123054,"_5":14363,"_27392":122834,"_2946":123055},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3461":72314,"_30106":72226,"_20907":123057,"_5":14363,"_27392":122838,"_2946":123058},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3461":72315,"_30106":72226,"_20907":123060,"_5":14363,"_27392":122838,"_2946":123061},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3461":72316,"_30106":72226,"_20907":123063,"_5":14363,"_27392":122838,"_2946":123064},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3461":72317,"_30106":72226,"_20907":123066,"_5":14363,"_27392":122842,"_2946":123067},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3461":72318,"_30106":72226,"_20907":123069,"_5":14363,"_27392":122842,"_2946":123070},[],"Campos principales:",{"_3461":72319,"_30106":72226,"_20907":123072,"_5":14363,"_27392":122842,"_2946":123073},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3461":72320,"_30106":72226,"_20907":123075,"_5":14363,"_27392":122842,"_2946":123076},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3461":72321,"_30106":72226,"_20907":123078,"_5":14363,"_27392":122842,"_2946":123079},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3461":72322,"_30106":72226,"_20907":123081,"_5":14363,"_27392":122842,"_2946":123082},[],"**Message**: contenido que se va a firmar.",{"_3461":72323,"_30106":72226,"_20907":123084,"_5":14363,"_27392":122842,"_2946":123085},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3461":72324,"_30106":72226,"_20907":123087,"_5":14363,"_27392":122845,"_2946":123088},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3461":72325,"_30106":72226,"_20907":123090,"_5":14363,"_27392":122845,"_2946":123070},[],{"_3461":72326,"_30106":72226,"_20907":123092,"_5":14363,"_27392":122845,"_2946":123093},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3461":72327,"_30106":72226,"_20907":123095,"_5":14363,"_27392":122845,"_2946":123096},[],"**Message Type**: `Raw` o `Digest`.",{"_3461":72328,"_30106":72226,"_20907":123098,"_5":14363,"_27392":122845,"_2946":123099},[],"**Payload Encoding**: codificación del mensaje.",{"_3461":72329,"_30106":72226,"_20907":123101,"_5":14363,"_27392":122845,"_2946":123102},[],"**Message**: mensaje original o hash.",{"_3461":72330,"_30106":72226,"_20907":123104,"_5":14363,"_27392":122845,"_2946":123105},[],"**Signature**: firma que se desea comprobar.",{"_3461":72331,"_30106":72226,"_20907":123107,"_5":14363,"_27392":122845,"_2946":123108},[],"**Result**: indicador del resultado de la validación.",{"_3461":72332,"_30106":72226,"_20907":123110,"_5":14363,"_27392":122848,"_2946":123111},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3461":72333,"_30106":72226,"_20907":123113,"_5":14363,"_27392":122848,"_2946":123114},[],"Este flujo es útil para:",{"_3461":72334,"_30106":72226,"_20907":123116,"_5":14363,"_27392":122848,"_2946":123117},[],"Solicitar certificados a una CA externa.",{"_3461":72335,"_30106":72226,"_20907":123119,"_5":14363,"_27392":122848,"_2946":123120},[],"Renovar una identidad manteniendo la misma clave.",{"_3461":72336,"_30106":72226,"_20907":123122,"_5":14363,"_27392":122848,"_2946":123123},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3461":72337,"_30106":72226,"_20907":123125,"_5":14363,"_27392":122848,"_2946":123126},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3461":72338,"_30106":72226,"_20907":123128,"_5":14363,"_27392":122848,"_2946":123129},[],"**Organization (O)**: organización o empresa.",{"_3461":72339,"_30106":72226,"_20907":123131,"_5":14363,"_27392":122848,"_2946":123132},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3461":72340,"_30106":72226,"_20907":123134,"_5":14363,"_27392":122848,"_2946":123135},[],"**Country (C)**: código de país de dos letras.",{"_3461":72341,"_30106":72226,"_20907":123137,"_5":14363,"_27392":122848,"_2946":123138},[],"**State / Province (ST)**: estado o provincia.",{"_3461":72342,"_30106":72226,"_20907":123140,"_5":14363,"_27392":122848,"_2946":123141},[],"**Locality (L)**: ciudad o localidad.",{"_3461":72343,"_30106":72226,"_20907":123143,"_5":14363,"_27392":122848,"_2946":123144},[],"**Email Address**: correo de contacto.",{"_3461":72344,"_30106":72226,"_20907":123146,"_5":14363,"_27392":122848,"_2946":123147},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3461":72345,"_30106":72226,"_20907":123149,"_5":14363,"_27392":122848,"_2946":123150},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3461":72346,"_30106":72226,"_20907":123152,"_5":14363,"_27392":122852,"_2946":123153},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3461":72347,"_30106":72226,"_20907":123155,"_5":14363,"_27392":122852,"_2946":123156},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3461":72348,"_30106":72226,"_20907":123158,"_5":14363,"_27392":122856,"_2946":123159},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3461":72349,"_30106":72226,"_20907":123161,"_5":14363,"_27392":122856,"_2946":123162},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3461":72350,"_30106":72350,"_5":14715,"_2946":123164,"_30438":123165,"_20907":123166,"_27392":72350},"Validación online con OCSP",[49125,117420,54598,121935],[],{"_3461":72351,"_30106":72350,"_20907":123168,"_5":14363,"_27392":72350,"_2946":123169},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3461":72352,"_30106":72350,"_5":30435,"_20907":123171,"_27392":123172,"_2946":123173},[],"/docs/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3461":72353,"_30106":72350,"_5":30435,"_20907":123175,"_27392":123176,"_2946":123177},[],"/docs/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3461":72354,"_30106":72350,"_5":30435,"_20907":123179,"_27392":123180,"_2946":123181},[],"/docs/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3461":72355,"_30106":72350,"_5":30435,"_20907":123183,"_27392":123184,"_2946":123185},[],"/docs/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3461":72356,"_30106":72350,"_5":30435,"_20907":123187,"_27392":123188,"_2946":123189},[],"/docs/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3461":72357,"_30106":72350,"_5":30435,"_20907":123191,"_27392":123192,"_2946":122502},[],"/docs/es/platform/pki/ocsp#referencias",{"_3461":72358,"_30106":72350,"_20907":123194,"_5":14363,"_27392":72350,"_2946":123195},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3461":72359,"_30106":72350,"_20907":123197,"_5":14363,"_27392":123172,"_2946":123198},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3461":72360,"_30106":72350,"_20907":123200,"_5":14363,"_27392":123172,"_2946":123201},[],"Estado del registro",{"_3461":72361,"_30106":72350,"_20907":123203,"_5":14363,"_27392":123172,"_2946":123204},[],"Respuesta firmada",{"_3461":72362,"_30106":72350,"_20907":123206,"_5":14363,"_27392":123172,"_2946":53735},[],{"_3461":72363,"_30106":72350,"_20907":123208,"_5":14363,"_27392":123172,"_2946":56536},[],{"_3461":72364,"_30106":72350,"_20907":123210,"_5":14363,"_27392":123172,"_2946":53752},[],{"_3461":72365,"_30106":72350,"_20907":123212,"_5":14363,"_27392":123172,"_2946":123213},[],"`Revoked`, con razón y fecha de revocación.",{"_3461":72366,"_30106":72350,"_20907":123215,"_5":14363,"_27392":123172,"_2946":123216},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3461":72367,"_30106":72350,"_20907":123218,"_5":14363,"_27392":123172,"_2946":123219},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3461":72368,"_30106":72350,"_20907":123221,"_5":14363,"_27392":123172,"_2946":123222},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3461":72369,"_30106":72350,"_20907":123224,"_5":14363,"_27392":123172,"_2946":123225},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3461":72370,"_30106":72350,"_20907":123227,"_5":14363,"_27392":123172,"_2946":123228},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3461":72371,"_30106":72350,"_20907":123230,"_5":14363,"_27392":123176,"_2946":123231},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3461":72372,"_30106":72350,"_20907":123233,"_5":14363,"_27392":123176,"_2946":123234},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3461":72373,"_30106":72350,"_20907":123236,"_5":14363,"_27392":123180,"_2946":123237},[],"El servicio acepta:",{"_3461":72374,"_30106":72350,"_20907":123239,"_5":14363,"_27392":123180,"_2946":119150},[],{"_3461":72375,"_30106":72350,"_20907":123241,"_5":14363,"_27392":123180,"_2946":123242},[],"Ruta del servicio VA",{"_3461":72376,"_30106":72350,"_20907":123244,"_5":14363,"_27392":123180,"_2946":123245},[],"Formato",{"_3461":72377,"_30106":72350,"_20907":123247,"_5":14363,"_27392":123180,"_2946":56576},[],{"_3461":72378,"_30106":72350,"_20907":123249,"_5":14363,"_27392":123180,"_2946":56579},[],{"_3461":72379,"_30106":72350,"_20907":123251,"_5":14363,"_27392":123180,"_2946":123252},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3461":72380,"_30106":72350,"_20907":123254,"_5":14363,"_27392":123180,"_2946":55988},[],{"_3461":72381,"_30106":72350,"_20907":123256,"_5":14363,"_27392":123180,"_2946":56587},[],{"_3461":72382,"_30106":72350,"_20907":123258,"_5":14363,"_27392":123180,"_2946":123259},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3461":72383,"_30106":72350,"_20907":123261,"_5":14363,"_27392":123180,"_2946":123262},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3461":72384,"_30106":72350,"_20907":123264,"_5":14363,"_27392":123184,"_2946":123265},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3461":72385,"_30106":72350,"_20907":123267,"_5":14363,"_27392":123184,"_2946":123268},[],"Genera la solicitud:",{"_3461":72386,"_30106":72350,"_20907":123270,"_5":14363,"_27392":123184,"_2946":123271},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3461":72387,"_30106":72350,"_20907":123273,"_5":14363,"_27392":123184,"_2946":123274},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3461":72388,"_30106":72350,"_20907":123276,"_5":14363,"_27392":123184,"_2946":123277},[],"Verifica el DER recibido:",{"_3461":72389,"_30106":72350,"_20907":123279,"_5":14363,"_27392":123184,"_2946":123280},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3461":72390,"_30106":72350,"_20907":123282,"_5":14363,"_27392":123188,"_2946":123283},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3461":72391,"_30106":72350,"_20907":123285,"_5":14363,"_27392":123188,"_2946":123286},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3461":72392,"_30106":72350,"_20907":123288,"_5":14363,"_27392":123192,"_2946":56620},[],{"_3461":72393,"_30106":72350,"_20907":123290,"_5":14363,"_27392":123192,"_2946":56623},[],{"_3461":72394,"_30106":72350,"_20907":123292,"_5":14363,"_27392":123192,"_2946":123293},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3461":72395,"_30106":72350,"_20907":123295,"_5":14363,"_27392":123192,"_2946":122778},[],{"_3461":72396,"_30106":72396,"_5":14715,"_2946":54598,"_30438":123297,"_20907":123298,"_27392":72396},[49125,117420,54598],[],{"_3461":72397,"_30106":72396,"_20907":123300,"_5":14363,"_27392":72396,"_2946":123301},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3461":72398,"_30106":72396,"_5":30435,"_20907":123303,"_27392":123304,"_2946":120624},[],"/docs/es/platform/pki/overview#empieza-aquí",{"_3461":72399,"_30106":72396,"_5":30435,"_20907":123306,"_27392":123307,"_2946":123308},[],"/docs/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3461":72400,"_30106":72396,"_5":30435,"_20907":123310,"_27392":123311,"_2946":121144},[],"/docs/es/platform/pki/overview#capacidades-principales",{"_3461":72401,"_30106":72396,"_5":30435,"_20907":123313,"_27392":123314,"_2946":121148},[],"/docs/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3461":72402,"_30106":72396,"_5":30435,"_20907":123316,"_27392":123317,"_2946":121152},[],"/docs/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3461":72403,"_30106":72396,"_5":30435,"_20907":123319,"_27392":123320,"_2946":121156},[],"/docs/es/platform/pki/overview#emite-y-controla-certificados",{"_3461":72404,"_30106":72396,"_5":30435,"_20907":123322,"_27392":123323,"_2946":121164},[],"/docs/es/platform/pki/overview#publica-el-estado-de-validación",{"_3461":72405,"_30106":72396,"_5":30435,"_20907":123325,"_27392":123326,"_2946":123327},[],"/docs/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3461":72406,"_30106":72396,"_5":30435,"_20907":123329,"_27392":123330,"_2946":122101},[],"/docs/es/platform/pki/overview#continúa",{"_3461":72407,"_30106":72396,"_20907":123332,"_5":14363,"_27392":72396,"_2946":123333},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3461":72408,"_30106":72396,"_20907":123335,"_5":14363,"_27392":123304,"_2946":123336},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3461":72409,"_30106":72396,"_20907":123338,"_5":14363,"_27392":123304,"_2946":123339},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3461":72410,"_30106":72396,"_20907":123341,"_5":14363,"_27392":123307,"_2946":123342},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3461":72411,"_30106":72396,"_20907":123344,"_5":14363,"_27392":123307,"_2946":123345},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3461":72412,"_30106":72396,"_20907":123347,"_5":14363,"_27392":123307,"_2946":123348},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3461":72413,"_30106":72396,"_20907":123350,"_5":14363,"_27392":123307,"_2946":123351},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3461":72414,"_30106":72396,"_20907":123353,"_5":14363,"_27392":123307,"_2946":123354},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3461":72415,"_30106":72396,"_20907":123356,"_5":14363,"_27392":123314,"_2946":123357},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3461":72416,"_30106":72396,"_20907":123359,"_5":14363,"_27392":123317,"_2946":123360},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3461":72417,"_30106":72396,"_20907":123362,"_5":14363,"_27392":123320,"_2946":123363},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3461":72418,"_30106":72396,"_20907":123365,"_5":14363,"_27392":123323,"_2946":123366},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3461":72419,"_30106":72396,"_20907":123368,"_5":14363,"_27392":123326,"_2946":123369},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3461":72420,"_30106":72396,"_20907":123371,"_5":14363,"_27392":123326,"_2946":123372},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3461":72421,"_30106":72396,"_20907":123374,"_5":14363,"_27392":123326,"_2946":123375},[],"su clave pública corresponda a la clave privada del cliente;",{"_3461":72422,"_30106":72396,"_20907":123377,"_5":14363,"_27392":123326,"_2946":123378},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3461":72423,"_30106":72396,"_20907":123380,"_5":14363,"_27392":123326,"_2946":123381},[],"sus fechas y usos permitan la operación;",{"_3461":72424,"_30106":72396,"_20907":123383,"_5":14363,"_27392":123326,"_2946":123384},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3461":72425,"_30106":72396,"_20907":123386,"_5":14363,"_27392":123326,"_2946":123387},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3461":72426,"_30106":72396,"_20907":123389,"_5":14363,"_27392":123330,"_2946":123390},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3461":72427,"_30106":72396,"_20907":123392,"_5":14363,"_27392":123330,"_2946":123393},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3461":72428,"_30106":72396,"_20907":123395,"_5":14363,"_27392":123330,"_2946":123396},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3461":72429,"_30106":72429,"_5":14715,"_2946":123398,"_30438":123399,"_20907":123400,"_27392":72429},"Crea tu primera CA",[49125,117420,54598,120748],[],{"_3461":72430,"_30106":72429,"_20907":123402,"_5":14363,"_27392":72429,"_2946":123403},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3461":72431,"_30106":72429,"_5":30435,"_20907":123405,"_27392":123406,"_2946":115998},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3461":72432,"_30106":72429,"_5":30435,"_20907":123408,"_27392":123409,"_2946":123410},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3461":72433,"_30106":72429,"_5":30435,"_20907":123412,"_27392":123413,"_2946":123414},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3461":72434,"_30106":72429,"_5":30435,"_20907":123416,"_27392":123417,"_2946":123418},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3461":72435,"_30106":72429,"_5":30435,"_20907":123420,"_27392":123421,"_2946":123422},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3461":72436,"_30106":72429,"_5":30435,"_20907":123424,"_27392":123425,"_2946":123426},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3461":72437,"_30106":72429,"_5":30435,"_20907":123428,"_27392":123429,"_2946":123430},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3461":72438,"_30106":72429,"_5":30435,"_20907":123432,"_27392":123433,"_2946":120995},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3461":72439,"_30106":72429,"_5":30435,"_20907":123435,"_27392":123436,"_2946":116022},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3461":72440,"_30106":72429,"_20907":123438,"_5":14363,"_27392":72429,"_2946":123439},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3461":72441,"_30106":72429,"_20907":123441,"_5":14363,"_27392":123406,"_2946":123442},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3461":72442,"_30106":72429,"_20907":123444,"_5":14363,"_27392":123406,"_2946":123445},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3461":72443,"_30106":72429,"_20907":123447,"_5":14363,"_27392":123406,"_2946":123448},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3461":72444,"_30106":72429,"_20907":123450,"_5":14363,"_27392":123406,"_2946":123451},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3461":72445,"_30106":72429,"_20907":123453,"_5":14363,"_27392":123409,"_2946":123454},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3461":72446,"_30106":72429,"_20907":123456,"_5":14363,"_27392":123409,"_2946":123457},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3461":72447,"_30106":72429,"_20907":123459,"_5":14363,"_27392":123413,"_2946":123460},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3461":72448,"_30106":72429,"_20907":123462,"_5":14363,"_27392":123413,"_2946":123463},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3461":72449,"_30106":72429,"_20907":123465,"_5":14363,"_27392":123417,"_2946":123466},[],"Selecciona **Root CA** y completa:",{"_3461":72450,"_30106":72429,"_20907":123468,"_5":14363,"_27392":123417,"_2946":56802},[],{"_3461":72451,"_30106":72429,"_20907":123470,"_5":14363,"_27392":123417,"_2946":123471},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3461":72452,"_30106":72429,"_20907":123473,"_5":14363,"_27392":123417,"_2946":123474},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3461":72453,"_30106":72429,"_20907":123476,"_5":14363,"_27392":123417,"_2946":123477},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3461":72454,"_30106":72429,"_20907":123479,"_5":14363,"_27392":123417,"_2946":123480},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3461":72455,"_30106":72429,"_20907":123482,"_5":14363,"_27392":123421,"_2946":123483},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3461":72456,"_30106":72429,"_20907":123485,"_5":14363,"_27392":123425,"_2946":123486},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3461":72457,"_30106":72429,"_20907":123488,"_5":14363,"_27392":123425,"_2946":123489},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3461":72458,"_30106":72429,"_20907":123491,"_5":14363,"_27392":123429,"_2946":123492},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3461":72459,"_30106":72429,"_20907":123494,"_5":14363,"_27392":123429,"_2946":123495},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3461":72460,"_30106":72429,"_20907":123497,"_5":14363,"_27392":123429,"_2946":123498},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3461":72461,"_30106":72429,"_20907":123500,"_5":14363,"_27392":123433,"_2946":123501},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3461":72462,"_30106":72429,"_20907":123503,"_5":14363,"_27392":123433,"_2946":123504},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3461":72463,"_30106":72429,"_20907":123506,"_5":14363,"_27392":123433,"_2946":123507},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3461":72464,"_30106":72429,"_20907":123509,"_5":14363,"_27392":123433,"_2946":123510},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3461":72465,"_30106":72429,"_20907":123512,"_5":14363,"_27392":123436,"_2946":123513},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3461":72466,"_30106":72466,"_5":14715,"_2946":123515,"_30438":123516,"_20907":123517,"_27392":72466},"Emite y verifica un certificado",[49125,117420,54598,120748],[],{"_3461":72467,"_30106":72466,"_20907":123519,"_5":14363,"_27392":72466,"_2946":123520},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3461":72468,"_30106":72466,"_5":30435,"_20907":123522,"_27392":123523,"_2946":115998},[],"/docs/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3461":72469,"_30106":72466,"_5":30435,"_20907":123525,"_27392":123526,"_2946":123527},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3461":72470,"_30106":72466,"_5":30435,"_20907":123529,"_27392":123530,"_2946":123531},[],"/docs/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3461":72471,"_30106":72466,"_5":30435,"_20907":123533,"_27392":123534,"_2946":123535},[],"/docs/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3461":72472,"_30106":72466,"_5":30435,"_20907":123537,"_27392":123538,"_2946":123539},[],"/docs/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3461":72473,"_30106":72466,"_5":30435,"_20907":123541,"_27392":123542,"_2946":123543},[],"/docs/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3461":72474,"_30106":72466,"_5":30435,"_20907":123545,"_27392":123546,"_2946":123547},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3461":72475,"_30106":72466,"_5":30435,"_20907":123549,"_27392":123550,"_2946":123551},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3461":72476,"_30106":72466,"_5":30435,"_20907":123553,"_27392":123554,"_2946":123555},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3461":72477,"_30106":72466,"_5":30435,"_20907":123557,"_27392":123558,"_2946":123559},[],"/docs/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3461":72478,"_30106":72466,"_5":30435,"_20907":123561,"_27392":123562,"_2946":120995},[],"/docs/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3461":72479,"_30106":72466,"_5":30435,"_20907":123564,"_27392":123565,"_2946":116022},[],"/docs/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3461":72480,"_30106":72466,"_20907":123567,"_5":14363,"_27392":72466,"_2946":123568},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3461":72481,"_30106":72466,"_20907":123570,"_5":14363,"_27392":123523,"_2946":123571},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3461":72482,"_30106":72466,"_20907":123573,"_5":14363,"_27392":123523,"_2946":123574},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3461":72483,"_30106":72466,"_20907":123576,"_5":14363,"_27392":123523,"_2946":123577},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3461":72484,"_30106":72466,"_20907":123579,"_5":14363,"_27392":123523,"_2946":123580},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3461":72485,"_30106":72466,"_20907":123582,"_5":14363,"_27392":123523,"_2946":123583},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3461":72486,"_30106":72466,"_20907":123585,"_5":14363,"_27392":123526,"_2946":123586},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3461":72487,"_30106":72466,"_20907":123588,"_5":14363,"_27392":123530,"_2946":123589},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3461":72488,"_30106":72466,"_20907":123591,"_5":14363,"_27392":123530,"_2946":123592},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3461":72489,"_30106":72466,"_20907":123594,"_5":14363,"_27392":123534,"_2946":123595},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3461":72490,"_30106":72466,"_20907":123597,"_5":14363,"_27392":123534,"_2946":123598},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3461":72491,"_30106":72466,"_20907":123600,"_5":14363,"_27392":123538,"_2946":123601},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3461":72492,"_30106":72466,"_20907":123603,"_5":14363,"_27392":123538,"_2946":123604},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3461":72493,"_30106":72466,"_20907":123606,"_5":14363,"_27392":123542,"_2946":123607},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3461":72494,"_30106":72466,"_20907":123609,"_5":14363,"_27392":123546,"_2946":123610},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3461":72495,"_30106":72466,"_20907":123612,"_5":14363,"_27392":123550,"_2946":123613},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3461":72496,"_30106":72466,"_20907":123615,"_5":14363,"_27392":123554,"_2946":123616},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3461":72497,"_30106":72466,"_20907":123618,"_5":14363,"_27392":123554,"_2946":123619},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3461":72498,"_30106":72466,"_20907":123621,"_5":14363,"_27392":123554,"_2946":123622},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3461":72499,"_30106":72466,"_20907":123624,"_5":14363,"_27392":123558,"_2946":123625},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3461":72500,"_30106":72466,"_20907":123627,"_5":14363,"_27392":123558,"_2946":123628},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3461":72501,"_30106":72466,"_20907":123630,"_5":14363,"_27392":123558,"_2946":123631},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3461":72502,"_30106":72466,"_20907":123633,"_5":14363,"_27392":123562,"_2946":121078},[],{"_3461":72503,"_30106":72466,"_20907":123635,"_5":14363,"_27392":123562,"_2946":119599},[],{"_3461":72504,"_30106":72466,"_20907":123637,"_5":14363,"_27392":123562,"_2946":123638},[],"La CA rechaza la emisión",{"_3461":72505,"_30106":72466,"_20907":123640,"_5":14363,"_27392":123562,"_2946":123641},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3461":72506,"_30106":72466,"_20907":123643,"_5":14363,"_27392":123562,"_2946":123644},[],"Sujeto o usos diferentes",{"_3461":72507,"_30106":72466,"_20907":123646,"_5":14363,"_27392":123562,"_2946":123647},[],"Perfil aplicado y valores solicitados.",{"_3461":72508,"_30106":72466,"_20907":123649,"_5":14363,"_27392":123562,"_2946":123650},[],"No se encuentra el emisor",{"_3461":72509,"_30106":72466,"_20907":123652,"_5":14363,"_27392":123562,"_2946":123653},[],"CA descargada y cadena intermedia necesaria.",{"_3461":72510,"_30106":72466,"_20907":123655,"_5":14363,"_27392":123562,"_2946":123656},[],"Falla la vigencia",{"_3461":72511,"_30106":72466,"_20907":123658,"_5":14363,"_27392":123562,"_2946":123659},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3461":72512,"_30106":72466,"_20907":123661,"_5":14363,"_27392":123562,"_2946":123662},[],"Los resúmenes de clave difieren",{"_3461":72513,"_30106":72466,"_20907":123664,"_5":14363,"_27392":123562,"_2946":123665},[],"Archivos de certificado y clave de la misma emisión.",{"_3461":72514,"_30106":72466,"_20907":123667,"_5":14363,"_27392":123562,"_2946":123668},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3461":72515,"_30106":72466,"_20907":123670,"_5":14363,"_27392":123565,"_2946":123671},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3461":72516,"_30106":72466,"_20907":123673,"_5":14363,"_27392":123565,"_2946":123674},[],"Gestionar certificados para inspección, estado y revocación.",{"_3461":72517,"_30106":72466,"_20907":123676,"_5":14363,"_27392":123565,"_2946":123677},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3461":72518,"_30106":72466,"_20907":123679,"_5":14363,"_27392":123565,"_2946":123680},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3461":72519,"_30106":72466,"_20907":123682,"_5":14363,"_27392":123565,"_2946":123683},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3461":72520,"_30106":72520,"_5":14715,"_2946":123685,"_30438":123686,"_20907":123687,"_27392":72520},"Primeros pasos de PKI",[49125,117420,54598,120748],[],{"_3461":72521,"_30106":72520,"_20907":123689,"_5":14363,"_27392":72520,"_2946":123690},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3461":72522,"_30106":72520,"_5":30435,"_20907":123692,"_27392":123693,"_2946":115998},[],"/docs/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3461":72523,"_30106":72520,"_5":30435,"_20907":123695,"_27392":123696,"_2946":123697},[],"/docs/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3461":72524,"_30106":72520,"_5":30435,"_20907":123699,"_27392":123700,"_2946":120930},[],"/docs/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3461":72525,"_30106":72520,"_5":30435,"_20907":123702,"_27392":123703,"_2946":123704},[],"/docs/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3461":72526,"_30106":72520,"_20907":123706,"_5":14363,"_27392":72520,"_2946":123707},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3461":72527,"_30106":72520,"_20907":123709,"_5":14363,"_27392":123693,"_2946":123710},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3461":72528,"_30106":72520,"_20907":123712,"_5":14363,"_27392":123693,"_2946":123713},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3461":72529,"_30106":72520,"_20907":123715,"_5":14363,"_27392":123693,"_2946":123716},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3461":72530,"_30106":72520,"_20907":123718,"_5":14363,"_27392":123693,"_2946":123719},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3461":72531,"_30106":72520,"_20907":123721,"_5":14363,"_27392":123693,"_2946":123722},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3461":72532,"_30106":72520,"_20907":123724,"_5":14363,"_27392":123696,"_2946":123725},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3461":72533,"_30106":72520,"_20907":123727,"_5":14363,"_27392":123696,"_2946":123728},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3461":72534,"_30106":72520,"_20907":123730,"_5":14363,"_27392":123696,"_2946":123731},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3461":72535,"_30106":72520,"_20907":123733,"_5":14363,"_27392":123696,"_2946":123734},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3461":72536,"_30106":72520,"_20907":123736,"_5":14363,"_27392":123700,"_2946":123737},[],"Archivo o recurso",{"_3461":72537,"_30106":72520,"_20907":123739,"_5":14363,"_27392":123700,"_2946":120927},[],{"_3461":72538,"_30106":72520,"_20907":123741,"_5":14363,"_27392":123700,"_2946":123742},[],"CA raíz activa y `ca.pem`",{"_3461":72539,"_30106":72520,"_20907":123744,"_5":14363,"_27392":123700,"_2946":123745},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3461":72540,"_30106":72520,"_20907":123747,"_5":14363,"_27392":123700,"_2946":123748},[],"Certificado final y `device.crt`",{"_3461":72541,"_30106":72520,"_20907":123750,"_5":14363,"_27392":123700,"_2946":123751},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3461":72542,"_30106":72520,"_20907":123753,"_5":14363,"_27392":123700,"_2946":123754},[],"Clave privada `device.key`",{"_3461":72543,"_30106":72520,"_20907":123756,"_5":14363,"_27392":123700,"_2946":123757},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3461":72544,"_30106":72520,"_20907":123759,"_5":14363,"_27392":123700,"_2946":123760},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3461":72545,"_30106":72520,"_20907":123762,"_5":14363,"_27392":123703,"_2946":123763},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3461":72546,"_30106":72520,"_20907":123765,"_5":14363,"_27392":123703,"_2946":123766},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3461":72547,"_30106":72520,"_20907":123768,"_5":14363,"_27392":123703,"_2946":123769},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3461":72548,"_30106":72548,"_5":14715,"_2946":123771,"_30438":123772,"_20907":123774,"_27392":72548},"Resolución de problemas PKI",[49125,117420,54598,123773],"Resolución de problemas",[],{"_3461":72549,"_30106":72548,"_20907":123776,"_5":14363,"_27392":72548,"_2946":123777},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3461":72550,"_30106":72548,"_5":30435,"_20907":123779,"_27392":123780,"_2946":123781},[],"/docs/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3461":72551,"_30106":72548,"_5":30435,"_20907":123783,"_27392":123784,"_2946":123785},[],"/docs/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3461":72552,"_30106":72548,"_5":30435,"_20907":123787,"_27392":123788,"_2946":123789},[],"/docs/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3461":72553,"_30106":72548,"_20907":123791,"_5":14363,"_27392":72548,"_2946":123792},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3461":72554,"_30106":72548,"_20907":123794,"_5":14363,"_27392":72548,"_2946":123795},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3461":72555,"_30106":72548,"_20907":123797,"_5":14363,"_27392":123780,"_2946":120927},[],{"_3461":72556,"_30106":72548,"_20907":123799,"_5":14363,"_27392":123780,"_2946":119599},[],{"_3461":72557,"_30106":72548,"_20907":123801,"_5":14363,"_27392":123780,"_2946":116022},[],{"_3461":72558,"_30106":72548,"_20907":123803,"_5":14363,"_27392":123780,"_2946":53440},[],{"_3461":72559,"_30106":72548,"_20907":123805,"_5":14363,"_27392":123780,"_2946":123806},[],"Existe, está activa y sus fechas son utilizables.",{"_3461":72560,"_30106":72548,"_20907":123808,"_5":14363,"_27392":123780,"_2946":123809},[],"Autoridades.",{"_3461":72561,"_30106":72548,"_20907":123811,"_5":14363,"_27392":123780,"_2946":123812},[],"Clave",{"_3461":72562,"_30106":72548,"_20907":123814,"_5":14363,"_27392":123780,"_2946":123815},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3461":72563,"_30106":72548,"_20907":123817,"_5":14363,"_27392":123780,"_2946":123818},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3461":72564,"_30106":72548,"_20907":123820,"_5":14363,"_27392":123780,"_2946":57156},[],{"_3461":72565,"_30106":72548,"_20907":123822,"_5":14363,"_27392":123780,"_2946":123823},[],"PEM correcto y firma verificable.",{"_3461":72566,"_30106":72548,"_20907":123825,"_5":14363,"_27392":123780,"_2946":57162},[],{"_3461":72567,"_30106":72548,"_20907":123827,"_5":14363,"_27392":123780,"_2946":123828},[],"Perfil",{"_3461":72568,"_30106":72548,"_20907":123830,"_5":14363,"_27392":123780,"_2946":123831},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3461":72569,"_30106":72548,"_20907":123833,"_5":14363,"_27392":123780,"_2946":123834},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3461":72570,"_30106":72548,"_20907":123836,"_5":14363,"_27392":123780,"_2946":121078},[],{"_3461":72571,"_30106":72548,"_20907":123838,"_5":14363,"_27392":123780,"_2946":123839},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3461":72572,"_30106":72548,"_20907":123841,"_5":14363,"_27392":123780,"_2946":123842},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3461":72573,"_30106":72548,"_20907":123844,"_5":14363,"_27392":123780,"_2946":123845},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3461":72574,"_30106":72548,"_20907":123847,"_5":14363,"_27392":123780,"_2946":123848},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3461":72575,"_30106":72548,"_20907":123850,"_5":14363,"_27392":123784,"_2946":123851},[],"Revisa cada frontera por separado:",{"_3461":72576,"_30106":72548,"_20907":123853,"_5":14363,"_27392":123784,"_2946":123854},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3461":72577,"_30106":72548,"_20907":123856,"_5":14363,"_27392":123784,"_2946":123857},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3461":72578,"_30106":72548,"_20907":123859,"_5":14363,"_27392":123784,"_2946":123860},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3461":72579,"_30106":72548,"_20907":123862,"_5":14363,"_27392":123784,"_2946":123863},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3461":72580,"_30106":72548,"_20907":123865,"_5":14363,"_27392":123784,"_2946":123866},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3461":72581,"_30106":72548,"_20907":123868,"_5":14363,"_27392":123784,"_2946":123869},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3461":72582,"_30106":72548,"_20907":123871,"_5":14363,"_27392":123788,"_2946":123872},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3461":72583,"_30106":72548,"_20907":123874,"_5":14363,"_27392":123788,"_2946":123875},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3461":72584,"_30106":72584,"_5":14715,"_2946":123877,"_30438":123878,"_20907":123879,"_27392":72584},"Seguridad",[49125],[],{"_3461":72585,"_30106":72584,"_20907":123881,"_5":14363,"_27392":72584,"_2946":123882},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3461":72586,"_30106":72584,"_5":30435,"_20907":123884,"_27392":123885,"_2946":123886},[],"/docs/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3461":72587,"_30106":72584,"_5":30435,"_20907":123888,"_27392":123889,"_2946":123890},[],"/docs/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3461":72588,"_30106":72584,"_5":30435,"_20907":123892,"_27392":123893,"_2946":123894},[],"/docs/es/security#versiones-soportadas","Versiones soportadas",{"_3461":72589,"_30106":72584,"_5":30435,"_20907":123896,"_27392":123897,"_2946":123898},[],"/docs/es/security#divulgación-responsable","Divulgación responsable",{"_3461":72590,"_30106":72584,"_20907":123900,"_5":14363,"_27392":72584,"_2946":123901},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3461":72591,"_30106":72584,"_20907":123903,"_5":14363,"_27392":123885,"_2946":123904},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3461":72592,"_30106":72584,"_20907":123906,"_5":14363,"_27392":123885,"_2946":123907},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3461":72593,"_30106":72584,"_20907":123909,"_5":14363,"_27392":123885,"_2946":14988},[],{"_3461":72594,"_30106":72584,"_20907":123911,"_5":14363,"_27392":123885,"_2946":14928},[],{"_3461":72595,"_30106":72584,"_20907":123913,"_5":14363,"_27392":123885,"_2946":14975},[],{"_3461":72596,"_30106":72584,"_20907":123915,"_5":14363,"_27392":123885,"_2946":123916},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3461":72597,"_30106":72584,"_20907":123918,"_5":14363,"_27392":123885,"_2946":123919},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3461":72598,"_30106":72584,"_20907":123921,"_5":14363,"_27392":123889,"_2946":123922},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3461":72599,"_30106":72584,"_20907":123924,"_5":14363,"_27392":123889,"_2946":123925},[],"No incluyas en el reporte:",{"_3461":72600,"_30106":72584,"_20907":123927,"_5":14363,"_27392":123889,"_2946":123928},[],"Credenciales, tokens o claves privadas",{"_3461":72601,"_30106":72584,"_20907":123930,"_5":14363,"_27392":123889,"_2946":123931},[],"Datos de clientes o información identificable de clientes",{"_3461":72602,"_30106":72584,"_20907":123933,"_5":14363,"_27392":123889,"_2946":123934},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3461":72603,"_30106":72584,"_20907":123936,"_5":14363,"_27392":123893,"_2946":123937},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3461":72604,"_30106":72584,"_20907":123939,"_5":14363,"_27392":123893,"_2946":123940},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3461":72605,"_30106":72584,"_20907":123942,"_5":14363,"_27392":123897,"_2946":123943},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3461":72606,"_30106":72584,"_20907":123945,"_5":14363,"_27392":123897,"_2946":123946},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3461":72607,"_30106":72584,"_20907":123948,"_5":14363,"_27392":123897,"_2946":123949},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3461":72608,"_30106":72584,"_20907":123951,"_5":14363,"_27392":123897,"_2946":123952},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3461":72609,"_30106":72584,"_20907":123954,"_5":14363,"_27392":123897,"_2946":123955},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3461":72610,"_30106":72610,"_5":14715,"_2946":123957,"_30438":123958,"_20907":123960,"_27392":72610},"3.8.0 a 4.0.0",[49125,123959],"Actualizaciones",[],{"_3461":72611,"_30106":72610,"_20907":123962,"_5":14363,"_27392":72610,"_2946":123963},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3461":72612,"_30106":72610,"_5":30435,"_20907":123965,"_27392":123966,"_2946":123967},[],"/docs/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3461":72613,"_30106":72610,"_5":30435,"_20907":123969,"_27392":123970,"_2946":123971},[],"/docs/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3461":72614,"_30106":72610,"_5":30435,"_20907":123973,"_27392":123974,"_2946":123975},[],"/docs/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3461":72615,"_30106":72610,"_5":30435,"_20907":123977,"_27392":123978,"_2946":123979},[],"/docs/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3461":72616,"_30106":72610,"_5":30435,"_20907":123981,"_27392":123982,"_2946":123983},[],"/docs/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3461":72617,"_30106":72610,"_5":30435,"_20907":123985,"_27392":123986,"_2946":123987},[],"/docs/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3461":72618,"_30106":72610,"_5":30435,"_20907":123989,"_27392":123990,"_2946":57328},[],"/docs/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3461":72619,"_30106":72610,"_5":30435,"_20907":123992,"_27392":123993,"_2946":123994},[],"/docs/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3461":72620,"_30106":72610,"_5":30435,"_20907":123996,"_27392":123997,"_2946":123998},[],"/docs/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3461":72621,"_30106":72610,"_5":30435,"_20907":124000,"_27392":124001,"_2946":124002},[],"/docs/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3461":72622,"_30106":72610,"_5":30435,"_20907":124004,"_27392":124005,"_2946":124006},[],"/docs/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3461":72623,"_30106":72610,"_5":30435,"_20907":124008,"_27392":124009,"_2946":124010},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3461":72624,"_30106":72610,"_5":30435,"_20907":124012,"_27392":124013,"_2946":124014},[],"/docs/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3461":72625,"_30106":72610,"_5":30435,"_20907":124016,"_27392":124017,"_2946":124018},[],"/docs/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3461":72626,"_30106":72610,"_5":30435,"_20907":124020,"_27392":124021,"_2946":124022},[],"/docs/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3461":72627,"_30106":72610,"_5":30435,"_20907":124024,"_27392":124025,"_2946":124026},[],"/docs/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3461":72628,"_30106":72610,"_5":30435,"_20907":124028,"_27392":124029,"_2946":124030},[],"/docs/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3461":72629,"_30106":72610,"_5":30435,"_20907":124032,"_27392":124033,"_2946":124034},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3461":72630,"_30106":72610,"_5":30435,"_20907":124036,"_27392":124037,"_2946":124038},[],"/docs/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3461":72631,"_30106":72610,"_5":30435,"_20907":124040,"_27392":124041,"_2946":124042},[],"/docs/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3461":72632,"_30106":72610,"_5":30435,"_20907":124044,"_27392":124045,"_2946":124046},[],"/docs/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3461":72633,"_30106":72610,"_5":30435,"_20907":124048,"_27392":124049,"_2946":124050},[],"/docs/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3461":72634,"_30106":72610,"_5":30435,"_20907":124052,"_27392":124053,"_2946":124054},[],"/docs/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3461":72635,"_30106":72610,"_5":30435,"_20907":124056,"_27392":124057,"_2946":124058},[],"/docs/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3461":72636,"_30106":72610,"_5":30435,"_20907":124060,"_27392":124061,"_2946":124062},[],"/docs/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3461":72637,"_30106":72610,"_5":30435,"_20907":124064,"_27392":124065,"_2946":124066},[],"/docs/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3461":72638,"_30106":72610,"_5":30435,"_20907":124068,"_27392":124069,"_2946":124070},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3461":72639,"_30106":72610,"_5":30435,"_20907":124072,"_27392":124073,"_2946":124074},[],"/docs/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3461":72640,"_30106":72610,"_5":30435,"_20907":124076,"_27392":124077,"_2946":124078},[],"/docs/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3461":72641,"_30106":72610,"_5":30435,"_20907":124080,"_27392":124081,"_2946":124082},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3461":72642,"_30106":72610,"_5":30435,"_20907":124084,"_27392":124085,"_2946":124086},[],"/docs/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3461":72643,"_30106":72610,"_5":30435,"_20907":124088,"_27392":124089,"_2946":124090},[],"/docs/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3461":72644,"_30106":72610,"_5":30435,"_20907":124092,"_27392":124093,"_2946":124094},[],"/docs/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3461":72645,"_30106":72610,"_5":30435,"_20907":124096,"_27392":124097,"_2946":124098},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3461":72646,"_30106":72610,"_5":30435,"_20907":124100,"_27392":124101,"_2946":124102},[],"/docs/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3461":72647,"_30106":72610,"_5":30435,"_20907":124104,"_27392":124105,"_2946":124106},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3461":72648,"_30106":72610,"_5":30435,"_20907":124108,"_27392":124109,"_2946":124110},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3461":72649,"_30106":72610,"_5":30435,"_20907":124112,"_27392":124113,"_2946":124114},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3461":72650,"_30106":72610,"_5":30435,"_20907":124116,"_27392":124117,"_2946":124118},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3461":72651,"_30106":72610,"_5":30435,"_20907":124120,"_27392":124121,"_2946":124122},[],"/docs/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3461":72652,"_30106":72610,"_5":30435,"_20907":124124,"_27392":124125,"_2946":119941},[],"/docs/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3461":72653,"_30106":72610,"_5":30435,"_20907":124127,"_27392":124128,"_2946":124129},[],"/docs/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3461":72654,"_30106":72610,"_5":30435,"_20907":124131,"_27392":124132,"_2946":124133},[],"/docs/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3461":72655,"_30106":72610,"_20907":124135,"_5":14363,"_27392":72610,"_2946":124136},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3461":72656,"_30106":72610,"_20907":124138,"_5":14363,"_27392":72610,"_2946":124139},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3461":72657,"_30106":72610,"_20907":124141,"_5":14363,"_27392":72610,"_2946":124142},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3461":72658,"_30106":72610,"_20907":124144,"_5":14363,"_27392":72610,"_2946":124145},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3461":72659,"_30106":72610,"_20907":124147,"_5":14363,"_27392":72610,"_2946":124148},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3461":72660,"_30106":72610,"_20907":124150,"_5":14363,"_27392":72610,"_2946":124151},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3461":72661,"_30106":72610,"_20907":124153,"_5":14363,"_27392":72610,"_2946":124154},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3461":72662,"_30106":72610,"_20907":124156,"_5":14363,"_27392":123970,"_2946":124157},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3461":72663,"_30106":72610,"_20907":124159,"_5":14363,"_27392":123970,"_2946":124160},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3461":72664,"_30106":72610,"_20907":124162,"_5":14363,"_27392":123974,"_2946":124163},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3461":72665,"_30106":72610,"_20907":124165,"_5":14363,"_27392":123974,"_2946":124166},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3461":72666,"_30106":72610,"_20907":124168,"_5":14363,"_27392":123978,"_2946":124169},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3461":72667,"_30106":72610,"_20907":124171,"_5":14363,"_27392":123982,"_2946":124172},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3461":72668,"_30106":72610,"_20907":124174,"_5":14363,"_27392":123982,"_2946":124175},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3461":72669,"_30106":72610,"_20907":124177,"_5":14363,"_27392":123982,"_2946":124178},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3461":72670,"_30106":72610,"_20907":124180,"_5":14363,"_27392":123982,"_2946":124181},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3461":72671,"_30106":72610,"_20907":124183,"_5":14363,"_27392":123982,"_2946":124184},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3461":72672,"_30106":72610,"_20907":124186,"_5":14363,"_27392":123986,"_2946":124187},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3461":72673,"_30106":72610,"_20907":124189,"_5":14363,"_27392":123986,"_2946":124190},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3461":72674,"_30106":72610,"_20907":124192,"_5":14363,"_27392":123986,"_2946":124193},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3461":72675,"_30106":72610,"_20907":124195,"_5":14363,"_27392":123986,"_2946":124196},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3461":72676,"_30106":72610,"_20907":124198,"_5":14363,"_27392":123986,"_2946":124199},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3461":72677,"_30106":72610,"_20907":124201,"_5":14363,"_27392":123986,"_2946":124202},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3461":72678,"_30106":72610,"_20907":124204,"_5":14363,"_27392":123990,"_2946":124205},[],"Cambio",{"_3461":72679,"_30106":72610,"_20907":124207,"_5":14363,"_27392":123990,"_2946":124208},[],"A quién afecta",{"_3461":72680,"_30106":72610,"_20907":124210,"_5":14363,"_27392":123990,"_2946":124211},[],"Gravedad",{"_3461":72681,"_30106":72610,"_20907":124213,"_5":14363,"_27392":123990,"_2946":122708},[],{"_3461":72682,"_30106":72610,"_20907":124215,"_5":14363,"_27392":123990,"_2946":123998},[],{"_3461":72683,"_30106":72610,"_20907":124217,"_5":14363,"_27392":123990,"_2946":124218},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3461":72684,"_30106":72610,"_20907":124220,"_5":14363,"_27392":123990,"_2946":124221},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3461":72685,"_30106":72610,"_20907":124223,"_5":14363,"_27392":123990,"_2946":124224},[],"Copiar los datos a los volúmenes nuevos",{"_3461":72686,"_30106":72610,"_20907":124226,"_5":14363,"_27392":123990,"_2946":124002},[],{"_3461":72687,"_30106":72610,"_20907":124228,"_5":14363,"_27392":123990,"_2946":124229},[],"Todas las releases de Helm",{"_3461":72688,"_30106":72610,"_20907":124231,"_5":14363,"_27392":123990,"_2946":124232},[],"Alta: `helm upgrade` falla",{"_3461":72689,"_30106":72610,"_20907":124234,"_5":14363,"_27392":123990,"_2946":124235},[],"Eliminar o renombrar las claves heredadas",{"_3461":72690,"_30106":72610,"_20907":124237,"_5":14363,"_27392":123990,"_2946":124006},[],{"_3461":72691,"_30106":72610,"_20907":124239,"_5":14363,"_27392":123990,"_2946":124240},[],"Todos los despliegues",{"_3461":72692,"_30106":72610,"_20907":124242,"_5":14363,"_27392":123990,"_2946":124243},[],"Alta: sin principal de bootstrap no hay administrador",{"_3461":72693,"_30106":72610,"_20907":124245,"_5":14363,"_27392":123990,"_2946":124246},[],"Configurar `services.authz`",{"_3461":72694,"_30106":72610,"_20907":124248,"_5":14363,"_27392":123990,"_2946":124010},[],{"_3461":72695,"_30106":72610,"_20907":124250,"_5":14363,"_27392":123990,"_2946":124229},[],{"_3461":72696,"_30106":72610,"_20907":124252,"_5":14363,"_27392":123990,"_2946":124253},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3461":72697,"_30106":72610,"_20907":124255,"_5":14363,"_27392":123990,"_2946":124256},[],"Mover JWKS y roles a `services.authz`",{"_3461":72698,"_30106":72610,"_20907":124258,"_5":14363,"_27392":123990,"_2946":124030},[],{"_3461":72699,"_30106":72610,"_20907":124260,"_5":14363,"_27392":123990,"_2946":124261},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3461":72700,"_30106":72610,"_20907":124263,"_5":14363,"_27392":123990,"_2946":124264},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3461":72701,"_30106":72610,"_20907":124266,"_5":14363,"_27392":123990,"_2946":124267},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3461":72702,"_30106":72610,"_20907":124269,"_5":14363,"_27392":123990,"_2946":124034},[],{"_3461":72703,"_30106":72610,"_20907":124271,"_5":14363,"_27392":123990,"_2946":124272},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3461":72704,"_30106":72610,"_20907":124274,"_5":14363,"_27392":123990,"_2946":124275},[],"Alta: el backend ya no arranca con ellos",{"_3461":72705,"_30106":72610,"_20907":124277,"_5":14363,"_27392":123990,"_2946":124278},[],"Pasar a PostgreSQL antes de actualizar",{"_3461":72706,"_30106":72610,"_20907":124280,"_5":14363,"_27392":123990,"_2946":124078},[],{"_3461":72707,"_30106":72610,"_20907":124282,"_5":14363,"_27392":123990,"_2946":124283},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3461":72708,"_30106":72610,"_20907":124285,"_5":14363,"_27392":123990,"_2946":124286},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3461":72709,"_30106":72610,"_20907":124288,"_5":14363,"_27392":123990,"_2946":124289},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3461":72710,"_30106":72610,"_20907":124291,"_5":14363,"_27392":123990,"_2946":124292},[],"Webhooks con referencias a archivos",{"_3461":72711,"_30106":72610,"_20907":124294,"_5":14363,"_27392":123990,"_2946":124295},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3461":72712,"_30106":72610,"_20907":124297,"_5":14363,"_27392":123990,"_2946":124298},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3461":72713,"_30106":72610,"_20907":124300,"_5":14363,"_27392":123990,"_2946":124301},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3461":72714,"_30106":72610,"_20907":124303,"_5":14363,"_27392":123990,"_2946":124014},[],{"_3461":72715,"_30106":72610,"_20907":124305,"_5":14363,"_27392":123990,"_2946":124306},[],"Releases con identidades por servicio o material de claves montado",{"_3461":72716,"_30106":72610,"_20907":124308,"_5":14363,"_27392":123990,"_2946":124309},[],"Media: los servicios no pueden leer sus archivos",{"_3461":72717,"_30106":72610,"_20907":124311,"_5":14363,"_27392":123990,"_2946":124312},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3461":72718,"_30106":72610,"_20907":124314,"_5":14363,"_27392":123990,"_2946":124018},[],{"_3461":72719,"_30106":72610,"_20907":124316,"_5":14363,"_27392":123990,"_2946":124317},[],"Releases que definen `amqp.tls`",{"_3461":72720,"_30106":72610,"_20907":124319,"_5":14363,"_27392":123990,"_2946":124320},[],"Media: los clientes se conectan al puerto equivocado",{"_3461":72721,"_30106":72610,"_20907":124322,"_5":14363,"_27392":123990,"_2946":124323},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3461":72722,"_30106":72610,"_20907":124325,"_5":14363,"_27392":123990,"_2946":124038},[],{"_3461":72723,"_30106":72610,"_20907":124327,"_5":14363,"_27392":123990,"_2946":124328},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3461":72724,"_30106":72610,"_20907":124330,"_5":14363,"_27392":123990,"_2946":124331},[],"Media: las claves de CA quedan sin gestionar",{"_3461":72725,"_30106":72610,"_20907":124333,"_5":14363,"_27392":123990,"_2946":124334},[],"Ejecutar la migración de CA a KMS",{"_3461":72726,"_30106":72610,"_20907":124336,"_5":14363,"_27392":123990,"_2946":124337},[],"Verificación del certificado del receptor",{"_3461":72727,"_30106":72610,"_20907":124339,"_5":14363,"_27392":123990,"_2946":124340},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3461":72728,"_30106":72610,"_20907":124342,"_5":14363,"_27392":123990,"_2946":124343},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3461":72729,"_30106":72610,"_20907":124345,"_5":14363,"_27392":123990,"_2946":124346},[],"Poner `insecure_skip_verify` a `false`",{"_3461":72730,"_30106":72610,"_20907":124348,"_5":14363,"_27392":123990,"_2946":124054},[],{"_3461":72731,"_30106":72610,"_20907":124350,"_5":14363,"_27392":123990,"_2946":124351},[],"Scripts y consolas que editan DMS por API",{"_3461":72732,"_30106":72610,"_20907":124353,"_5":14363,"_27392":123990,"_2946":124354},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3461":72733,"_30106":72610,"_20907":124356,"_5":14363,"_27392":123990,"_2946":124357},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3461":72734,"_30106":72610,"_20907":124359,"_5":14363,"_27392":123990,"_2946":124074},[],{"_3461":72735,"_30106":72610,"_20907":124361,"_5":14363,"_27392":123990,"_2946":124362},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3461":72736,"_30106":72610,"_20907":124364,"_5":14363,"_27392":123990,"_2946":124365},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3461":72737,"_30106":72610,"_20907":124367,"_5":14363,"_27392":123990,"_2946":124368},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3461":72738,"_30106":72610,"_20907":124370,"_5":14363,"_27392":123990,"_2946":124082},[],{"_3461":72739,"_30106":72610,"_20907":124372,"_5":14363,"_27392":123990,"_2946":124373},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3461":72740,"_30106":72610,"_20907":124375,"_5":14363,"_27392":123990,"_2946":124376},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3461":72741,"_30106":72610,"_20907":124378,"_5":14363,"_27392":123990,"_2946":124379},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3461":72742,"_30106":72610,"_20907":124381,"_5":14363,"_27392":123990,"_2946":124070},[],{"_3461":72743,"_30106":72610,"_20907":124383,"_5":14363,"_27392":123990,"_2946":124384},[],"Consumidores que leen el campo `events` del dispositivo",{"_3461":72744,"_30106":72610,"_20907":124386,"_5":14363,"_27392":123990,"_2946":124387},[],"Media: el campo desaparece",{"_3461":72745,"_30106":72610,"_20907":124389,"_5":14363,"_27392":123990,"_2946":124390},[],"Usar los nuevos endpoints de eventos",{"_3461":72746,"_30106":72610,"_20907":124392,"_5":14363,"_27392":123990,"_2946":124090},[],{"_3461":72747,"_30106":72610,"_20907":124394,"_5":14363,"_27392":123990,"_2946":124395},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3461":72748,"_30106":72610,"_20907":124397,"_5":14363,"_27392":123990,"_2946":124398},[],"Media: la migración de la VA aborta",{"_3461":72749,"_30106":72610,"_20907":124400,"_5":14363,"_27392":123990,"_2946":124401},[],"Corregir los roles afectados antes de actualizar",{"_3461":72750,"_30106":72610,"_20907":124403,"_5":14363,"_27392":123990,"_2946":124022},[],{"_3461":72751,"_30106":72610,"_20907":124405,"_5":14363,"_27392":123990,"_2946":124406},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3461":72752,"_30106":72610,"_20907":124408,"_5":14363,"_27392":123990,"_2946":124409},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3461":72753,"_30106":72610,"_20907":124411,"_5":14363,"_27392":123990,"_2946":124412},[],"Actualizar el archivo de values",{"_3461":72754,"_30106":72610,"_20907":124414,"_5":14363,"_27392":123990,"_2946":124062},[],{"_3461":72755,"_30106":72610,"_20907":124416,"_5":14363,"_27392":123990,"_2946":124417},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3461":72756,"_30106":72610,"_20907":124419,"_5":14363,"_27392":123990,"_2946":124420},[],"Baja: prevalece el ID de la URL",{"_3461":72757,"_30106":72610,"_20907":124422,"_5":14363,"_27392":123990,"_2946":124423},[],"Enviar el ID en la URL",{"_3461":72758,"_30106":72610,"_20907":124425,"_5":14363,"_27392":123990,"_2946":124086},[],{"_3461":72759,"_30106":72610,"_20907":124427,"_5":14363,"_27392":123990,"_2946":124428},[],"Clientes que envían un `id` al crear o importar CAs",{"_3461":72760,"_30106":72610,"_20907":124430,"_5":14363,"_27392":123990,"_2946":124431},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3461":72761,"_30106":72610,"_20907":124433,"_5":14363,"_27392":123990,"_2946":124434},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3461":72762,"_30106":72610,"_20907":124436,"_5":14363,"_27392":123990,"_2946":124066},[],{"_3461":72763,"_30106":72610,"_20907":124438,"_5":14363,"_27392":123990,"_2946":124439},[],"Consumidores que comparan el `type` del certificado",{"_3461":72764,"_30106":72610,"_20907":124441,"_5":14363,"_27392":123990,"_2946":124442},[],"Baja: dos valores cambian de nombre",{"_3461":72765,"_30106":72610,"_20907":124444,"_5":14363,"_27392":123990,"_2946":124445},[],"Adaptar los consumidores",{"_3461":72766,"_30106":72610,"_20907":124447,"_5":14363,"_27392":123990,"_2946":124058},[],{"_3461":72767,"_30106":72610,"_20907":124449,"_5":14363,"_27392":123990,"_2946":124450},[],"Cualquier DMS",{"_3461":72768,"_30106":72610,"_20907":124452,"_5":14363,"_27392":123990,"_2946":124453},[],"Baja: solo informativo",{"_3461":72769,"_30106":72610,"_20907":124455,"_5":14363,"_27392":123990,"_2946":124456},[],"Revisar ambos bloques antes de editar",{"_3461":72770,"_30106":72610,"_20907":124458,"_5":14363,"_27392":123997,"_2946":124459},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3461":72771,"_30106":72610,"_20907":124461,"_5":14363,"_27392":123997,"_2946":124462},[],"El paso 4 de la guía de migración copia los datos.",{"_3461":72772,"_30106":72610,"_20907":124464,"_5":14363,"_27392":124001,"_2946":124465},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3461":72773,"_30106":72610,"_20907":124467,"_5":14363,"_27392":124005,"_2946":124468},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3461":72774,"_30106":72610,"_20907":124470,"_5":14363,"_27392":124009,"_2946":124471},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3461":72775,"_30106":72610,"_20907":124473,"_5":14363,"_27392":124013,"_2946":124474},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3461":72776,"_30106":72610,"_20907":124476,"_5":14363,"_27392":124013,"_2946":124477},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3461":72777,"_30106":72610,"_20907":124479,"_5":14363,"_27392":124017,"_2946":124480},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3461":72778,"_30106":72610,"_20907":124482,"_5":14363,"_27392":124021,"_2946":124483},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3461":72779,"_30106":72610,"_20907":124485,"_5":14363,"_27392":124021,"_2946":124486},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3461":72780,"_30106":72610,"_20907":124488,"_5":14363,"_27392":124021,"_2946":124489},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3461":72781,"_30106":72610,"_20907":124491,"_5":14363,"_27392":124021,"_2946":124492},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3461":72782,"_30106":72610,"_20907":124494,"_5":14363,"_27392":124021,"_2946":124495},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3461":72783,"_30106":72610,"_20907":124497,"_5":14363,"_27392":124021,"_2946":124498},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3461":72784,"_30106":72610,"_20907":124500,"_5":14363,"_27392":124029,"_2946":124501},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3461":72785,"_30106":72610,"_20907":124503,"_5":14363,"_27392":124029,"_2946":124504},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3461":72786,"_30106":72610,"_20907":124506,"_5":14363,"_27392":124029,"_2946":124507},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3461":72787,"_30106":72610,"_20907":124509,"_5":14363,"_27392":124029,"_2946":124510},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3461":72788,"_30106":72610,"_20907":124512,"_5":14363,"_27392":124029,"_2946":124513},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3461":72789,"_30106":72610,"_20907":124515,"_5":14363,"_27392":124033,"_2946":124516},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3461":72790,"_30106":72610,"_20907":124518,"_5":14363,"_27392":124037,"_2946":124519},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3461":72791,"_30106":72610,"_20907":124521,"_5":14363,"_27392":124037,"_2946":124522},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3461":72792,"_30106":72610,"_20907":124524,"_5":14363,"_27392":124037,"_2946":124525},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3461":72793,"_30106":72610,"_20907":124527,"_5":14363,"_27392":124037,"_2946":124528},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3461":72794,"_30106":72610,"_20907":124530,"_5":14363,"_27392":124037,"_2946":124531},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3461":72795,"_30106":72610,"_20907":124533,"_5":14363,"_27392":124037,"_2946":124534},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3461":72796,"_30106":72610,"_20907":124536,"_5":14363,"_27392":124037,"_2946":124537},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3461":72797,"_30106":72610,"_20907":124539,"_5":14363,"_27392":124037,"_2946":124540},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3461":72798,"_30106":72610,"_20907":124542,"_5":14363,"_27392":124041,"_2946":124543},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3461":72799,"_30106":72610,"_20907":124545,"_5":14363,"_27392":124049,"_2946":124546},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3461":72800,"_30106":72610,"_20907":124548,"_5":14363,"_27392":124049,"_2946":124549},[],"Campo en 3.8.0",{"_3461":72801,"_30106":72610,"_20907":124551,"_5":14363,"_27392":124049,"_2946":124552},[],"Campo en 4.0.0",{"_3461":72802,"_30106":72610,"_20907":124554,"_5":14363,"_27392":124049,"_2946":57893},[],{"_3461":72803,"_30106":72610,"_20907":124556,"_5":14363,"_27392":124049,"_2946":124557},[],"`insecure_skip_verify` (con el valor negado)",{"_3461":72804,"_30106":72610,"_20907":124559,"_5":14363,"_27392":124049,"_2946":57899},[],{"_3461":72805,"_30106":72610,"_20907":124561,"_5":14363,"_27392":124049,"_2946":57902},[],{"_3461":72806,"_30106":72610,"_20907":124563,"_5":14363,"_27392":124049,"_2946":57905},[],{"_3461":72807,"_30106":72610,"_20907":124565,"_5":14363,"_27392":124049,"_2946":57908},[],{"_3461":72808,"_30106":72610,"_20907":124567,"_5":14363,"_27392":124049,"_2946":57911},[],{"_3461":72809,"_30106":72610,"_20907":124569,"_5":14363,"_27392":124049,"_2946":57914},[],{"_3461":72810,"_30106":72610,"_20907":124571,"_5":14363,"_27392":124049,"_2946":124572},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3461":72811,"_30106":72610,"_20907":124574,"_5":14363,"_27392":124049,"_2946":124575},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3461":72812,"_30106":72610,"_20907":124577,"_5":14363,"_27392":124049,"_2946":124578},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3461":72813,"_30106":72610,"_20907":124580,"_5":14363,"_27392":124053,"_2946":124581},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3461":72814,"_30106":72610,"_20907":124583,"_5":14363,"_27392":124053,"_2946":124584},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3461":72815,"_30106":72610,"_20907":124586,"_5":14363,"_27392":124053,"_2946":124587},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3461":72816,"_30106":72610,"_20907":124589,"_5":14363,"_27392":124057,"_2946":124590},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3461":72817,"_30106":72610,"_20907":124592,"_5":14363,"_27392":124061,"_2946":124593},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3461":72818,"_30106":72610,"_20907":124595,"_5":14363,"_27392":124065,"_2946":124596},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3461":72819,"_30106":72610,"_20907":124598,"_5":14363,"_27392":124069,"_2946":124599},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3461":72820,"_30106":72610,"_20907":124601,"_5":14363,"_27392":124069,"_2946":124602},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3461":72821,"_30106":72610,"_20907":124604,"_5":14363,"_27392":124069,"_2946":124605},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3461":72822,"_30106":72610,"_20907":124607,"_5":14363,"_27392":124069,"_2946":124608},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3461":72823,"_30106":72610,"_20907":124610,"_5":14363,"_27392":124073,"_2946":124611},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3461":72824,"_30106":72610,"_20907":124613,"_5":14363,"_27392":124077,"_2946":124614},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3461":72825,"_30106":72610,"_20907":124616,"_5":14363,"_27392":124077,"_2946":124617},[],"Ruta",{"_3461":72826,"_30106":72610,"_20907":124619,"_5":14363,"_27392":124077,"_2946":117180},[],{"_3461":72827,"_30106":72610,"_20907":124621,"_5":14363,"_27392":124077,"_2946":57967},[],{"_3461":72828,"_30106":72610,"_20907":124623,"_5":14363,"_27392":124077,"_2946":124624},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3461":72829,"_30106":72610,"_20907":124626,"_5":14363,"_27392":124077,"_2946":57973},[],{"_3461":72830,"_30106":72610,"_20907":124628,"_5":14363,"_27392":124077,"_2946":124629},[],"Lee los ajustes de una CA.",{"_3461":72831,"_30106":72610,"_20907":124631,"_5":14363,"_27392":124077,"_2946":57979},[],{"_3461":72832,"_30106":72610,"_20907":124633,"_5":14363,"_27392":124077,"_2946":124634},[],"Sustituye los `crl_options`.",{"_3461":72833,"_30106":72610,"_20907":124636,"_5":14363,"_27392":124077,"_2946":124637},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3461":72834,"_30106":72610,"_20907":124639,"_5":14363,"_27392":124077,"_2946":124640},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3461":72835,"_30106":72610,"_20907":124642,"_5":14363,"_27392":124077,"_2946":124643},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3461":72836,"_30106":72610,"_20907":124645,"_5":14363,"_27392":124077,"_2946":124646},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3461":72837,"_30106":72610,"_20907":124648,"_5":14363,"_27392":124077,"_2946":124649},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3461":72838,"_30106":72610,"_20907":124651,"_5":14363,"_27392":124077,"_2946":124652},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3461":72839,"_30106":72610,"_20907":124654,"_5":14363,"_27392":124077,"_2946":124655},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3461":72840,"_30106":72610,"_20907":124657,"_5":14363,"_27392":124077,"_2946":124658},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3461":72841,"_30106":72610,"_20907":124660,"_5":14363,"_27392":124077,"_2946":124661},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3461":72842,"_30106":72610,"_20907":124663,"_5":14363,"_27392":124077,"_2946":124664},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3461":72843,"_30106":72610,"_20907":124666,"_5":14363,"_27392":124077,"_2946":124667},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3461":72844,"_30106":72610,"_20907":124669,"_5":14363,"_27392":124081,"_2946":124670},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3461":72845,"_30106":72610,"_20907":124672,"_5":14363,"_27392":124085,"_2946":124673},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3461":72846,"_30106":72610,"_20907":124675,"_5":14363,"_27392":124089,"_2946":124676},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3461":72847,"_30106":72610,"_20907":124678,"_5":14363,"_27392":124093,"_2946":124679},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3461":72848,"_30106":72610,"_20907":124681,"_5":14363,"_27392":124097,"_2946":124682},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3461":72849,"_30106":72610,"_20907":124684,"_5":14363,"_27392":124097,"_2946":124685},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3461":72850,"_30106":72610,"_20907":124687,"_5":14363,"_27392":124097,"_2946":124688},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3461":72851,"_30106":72610,"_20907":124690,"_5":14363,"_27392":124097,"_2946":124691},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3461":72852,"_30106":72610,"_20907":124693,"_5":14363,"_27392":124097,"_2946":124694},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3461":72853,"_30106":72610,"_20907":124696,"_5":14363,"_27392":124097,"_2946":124697},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3461":72854,"_30106":72610,"_20907":124699,"_5":14363,"_27392":124101,"_2946":124700},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3461":72855,"_30106":72610,"_20907":124702,"_5":14363,"_27392":124101,"_2946":124703},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3461":72856,"_30106":72610,"_20907":124705,"_5":14363,"_27392":124101,"_2946":124706},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3461":72857,"_30106":72610,"_20907":124708,"_5":14363,"_27392":124101,"_2946":124709},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3461":72858,"_30106":72610,"_20907":124711,"_5":14363,"_27392":124101,"_2946":124712},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3461":72859,"_30106":72610,"_20907":124714,"_5":14363,"_27392":124105,"_2946":124715},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3461":72860,"_30106":72610,"_20907":124717,"_5":14363,"_27392":124105,"_2946":124718},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3461":72861,"_30106":72610,"_20907":124720,"_5":14363,"_27392":124105,"_2946":124721},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3461":72862,"_30106":72610,"_20907":124723,"_5":14363,"_27392":124105,"_2946":124724},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3461":72863,"_30106":72610,"_20907":124726,"_5":14363,"_27392":124105,"_2946":124727},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3461":72864,"_30106":72610,"_20907":124729,"_5":14363,"_27392":124105,"_2946":124730},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3461":72865,"_30106":72610,"_20907":124732,"_5":14363,"_27392":124105,"_2946":124733},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3461":72866,"_30106":72610,"_20907":124735,"_5":14363,"_27392":124105,"_2946":124736},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3461":72867,"_30106":72610,"_20907":124738,"_5":14363,"_27392":124105,"_2946":124739},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3461":72868,"_30106":72610,"_20907":124741,"_5":14363,"_27392":124105,"_2946":124742},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3461":72869,"_30106":72610,"_20907":124744,"_5":14363,"_27392":124105,"_2946":124745},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3461":72870,"_30106":72610,"_20907":124747,"_5":14363,"_27392":124105,"_2946":124748},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3461":72871,"_30106":72610,"_20907":124750,"_5":14363,"_27392":124109,"_2946":124751},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3461":72872,"_30106":72610,"_20907":124753,"_5":14363,"_27392":124109,"_2946":124754},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3461":72873,"_30106":72610,"_20907":124756,"_5":14363,"_27392":124113,"_2946":124757},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3461":72874,"_30106":72610,"_20907":124759,"_5":14363,"_27392":124113,"_2946":124760},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3461":72875,"_30106":72610,"_20907":124762,"_5":14363,"_27392":124113,"_2946":124763},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3461":72876,"_30106":72610,"_20907":124765,"_5":14363,"_27392":124113,"_2946":124766},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3461":72877,"_30106":72610,"_20907":124768,"_5":14363,"_27392":124113,"_2946":124769},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3461":72878,"_30106":72610,"_20907":124771,"_5":14363,"_27392":124113,"_2946":124772},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3461":72879,"_30106":72610,"_20907":124774,"_5":14363,"_27392":124113,"_2946":124775},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3461":72880,"_30106":72610,"_20907":124777,"_5":14363,"_27392":124113,"_2946":124778},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3461":72881,"_30106":72610,"_20907":124780,"_5":14363,"_27392":124113,"_2946":124781},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3461":72882,"_30106":72610,"_20907":124783,"_5":14363,"_27392":124113,"_2946":124784},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3461":72883,"_30106":72610,"_20907":124786,"_5":14363,"_27392":124113,"_2946":124787},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3461":72884,"_30106":72610,"_20907":124789,"_5":14363,"_27392":124117,"_2946":124790},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3461":72885,"_30106":72610,"_20907":124792,"_5":14363,"_27392":124117,"_2946":124793},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3461":72886,"_30106":72610,"_20907":124795,"_5":14363,"_27392":124121,"_2946":124796},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3461":72887,"_30106":72610,"_20907":124798,"_5":14363,"_27392":124121,"_2946":124799},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3461":72888,"_30106":72610,"_20907":124801,"_5":14363,"_27392":124121,"_2946":124802},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` también requiere que `ca` se haya migrado primero.",{"_3461":72889,"_30106":72610,"_20907":124804,"_5":14363,"_27392":124121,"_2946":124805},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates` y `SELECT` sobre `ca.ca_certificates`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`.",{"_3461":72890,"_30106":72610,"_20907":124807,"_5":14363,"_27392":124121,"_2946":124808},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3461":72891,"_30106":72610,"_20907":124810,"_5":14363,"_27392":124121,"_2946":124811},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3461":72892,"_30106":72610,"_20907":124813,"_5":14363,"_27392":124121,"_2946":124814},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3461":72893,"_30106":72610,"_20907":124816,"_5":14363,"_27392":124121,"_2946":124817},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3461":72894,"_30106":72610,"_20907":124819,"_5":14363,"_27392":124125,"_2946":124820},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3461":72895,"_30106":72610,"_20907":124822,"_5":14363,"_27392":124125,"_2946":124823},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3461":72896,"_30106":72610,"_20907":124825,"_5":14363,"_27392":124125,"_2946":124826},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3461":72897,"_30106":72610,"_20907":124828,"_5":14363,"_27392":124125,"_2946":124829},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3461":72898,"_30106":72610,"_20907":124831,"_5":14363,"_27392":124125,"_2946":124832},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3461":72899,"_30106":72610,"_20907":124834,"_5":14363,"_27392":124125,"_2946":124835},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3461":72900,"_30106":72610,"_20907":124837,"_5":14363,"_27392":124125,"_2946":124838},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3461":72901,"_30106":72610,"_20907":124840,"_5":14363,"_27392":124125,"_2946":124841},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que la del esquema `ca`.",{"_3461":72902,"_30106":72610,"_20907":124843,"_5":14363,"_27392":124125,"_2946":124844},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3461":72903,"_30106":72610,"_20907":124846,"_5":14363,"_27392":124125,"_2946":124847},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3461":72904,"_30106":72610,"_20907":124849,"_5":14363,"_27392":124125,"_2946":124850},[],"**Una migración o un servicio falla con `permission denied for table ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración. Concede los privilegios que falten y vuelve a ejecutar.",{"_3461":72905,"_30106":72610,"_20907":124852,"_5":14363,"_27392":124128,"_2946":124853},[],"Tras la actualización, comprueba en este orden:",{"_3461":72906,"_30106":72610,"_20907":124855,"_5":14363,"_27392":124128,"_2946":124856},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3461":72907,"_30106":72610,"_20907":124858,"_5":14363,"_27392":124128,"_2946":124859},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3461":72908,"_30106":72610,"_20907":124861,"_5":14363,"_27392":124128,"_2946":124862},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3461":72909,"_30106":72610,"_20907":124864,"_5":14363,"_27392":124128,"_2946":124865},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3461":72910,"_30106":72610,"_20907":124867,"_5":14363,"_27392":124128,"_2946":124868},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3461":72911,"_30106":72610,"_20907":124870,"_5":14363,"_27392":124128,"_2946":124871},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3461":72912,"_30106":72610,"_20907":124873,"_5":14363,"_27392":124128,"_2946":124874},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3461":72913,"_30106":72610,"_20907":124876,"_5":14363,"_27392":124128,"_2946":124877},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3461":72914,"_30106":72610,"_20907":124879,"_5":14363,"_27392":124128,"_2946":124880},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3461":72915,"_30106":72610,"_20907":124882,"_5":14363,"_27392":124128,"_2946":124883},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3461":72916,"_30106":72610,"_20907":124885,"_5":14363,"_27392":124128,"_2946":124886},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3461":72917,"_30106":72610,"_20907":124888,"_5":14363,"_27392":124128,"_2946":124889},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3461":72918,"_30106":72610,"_20907":124891,"_5":14363,"_27392":124128,"_2946":124892},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3461":72919,"_30106":72610,"_20907":124894,"_5":14363,"_27392":124128,"_2946":124895},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3461":72920,"_30106":72610,"_20907":124897,"_5":14363,"_27392":124128,"_2946":124898},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3461":72921,"_30106":72610,"_20907":124900,"_5":14363,"_27392":124132,"_2946":124901},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3461":72922,"_30106":72610,"_20907":124903,"_5":14363,"_27392":124132,"_2946":124904},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3461":72923,"_30106":72610,"_20907":124906,"_5":14363,"_27392":124132,"_2946":124907},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3461":72924,"_30106":72610,"_20907":124909,"_5":14363,"_27392":124132,"_2946":124910},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3461":72925,"_30106":72610,"_20907":124912,"_5":14363,"_27392":124132,"_2946":124913},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_58264":124915,"_58266":124916,"_58268":124917,"_58270":124918,"_18124":2981,"_69993":2981},"spanish",[2946,30106,5,27392],{"_2946":24973,"_30106":24973,"_5":24973,"_27392":24973},{"_2946":124919,"_30106":127848,"_5":130777,"_27392":133706},{"_4641":124920,"_58274":124921,"_5":24973},{"_14439":7563,"_14820":11306,"_14839":5958,"_29109":3440,"_14826":6540,"_19839":6173,"_14460":6960,"_14467":13283,"_29051":20324,"_29460":14234,"_29481":6531,"_29085":7017,"_34421":12253,"_29188":20319,"_29525":9849,"_34428":22816,"_34431":5810,"_34434":7000,"_34437":18138,"_29932":3346,"_34442":9369,"_34444":7280,"_29962":5129,"_14835":15797,"_34448":7490,"_34451":5819,"_34453":7633,"_29509":23564,"_29927":4795,"_29975":12169,"_34458":6011,"_34460":3763,"_34462":6985,"_29205":6361,"_34465":5148,"_34467":3804,"_34469":7814,"_34471":7126,"_34473":28632,"_29122":4684,"_34476":4613,"_34478":5050,"_29116":8798,"_29546":11072,"_34482":3585,"_34484":