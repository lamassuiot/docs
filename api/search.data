7336":53624,"_37338":53627,"_37340":53630,"_37343":53633,"_37345":53636,"_37347":53639,"_37349":53642,"_37351":53645,"_37353":53648,"_37355":53651,"_37357":53654,"_37359":53657,"_37361":53660,"_37363":53663,"_37365":53666,"_37367":53669,"_37369":53672,"_37371":53675,"_37373":53678,"_37375":53681,"_37377":53684,"_37379":53687,"_37381":53690,"_37383":53693,"_37386":53696,"_37388":53699,"_37390":53702,"_37392":53705},{"_3170":15,"_28022":15,"_5":13637,"_2665":45404,"_28344":45405,"_19417":45409,"_25514":15},"Deploy from AWS Marketplace",[45406,45407,45408],"Docs","Deployment","Other models",[],{"_3170":16,"_28022":15,"_19417":45411,"_5":13306,"_25514":15,"_2665":45412},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3170":17,"_28022":15,"_5":28341,"_19417":45414,"_25514":45415,"_2665":45416},[],"/docs/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3170":18,"_28022":15,"_5":28341,"_19417":45418,"_25514":45419,"_2665":45420},[],"/docs/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3170":19,"_28022":15,"_5":28341,"_19417":45422,"_25514":45423,"_2665":45424},[],"/docs/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3170":20,"_28022":15,"_5":28341,"_19417":45426,"_25514":45427,"_2665":45428},[],"/docs/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3170":21,"_28022":15,"_5":28341,"_19417":45430,"_25514":45431,"_2665":45432},[],"/docs/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3170":22,"_28022":15,"_5":28341,"_19417":45434,"_25514":45435,"_2665":45436},[],"/docs/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3170":23,"_28022":15,"_5":28341,"_19417":45438,"_25514":45439,"_2665":45440},[],"/docs/deployment/aws-marketplace#next-step","Next step",{"_3170":24,"_28022":15,"_19417":45442,"_5":13306,"_25514":15,"_2665":45443},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3170":25,"_28022":15,"_19417":45445,"_5":13306,"_25514":45415,"_2665":45446},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3170":26,"_28022":15,"_19417":45448,"_5":13306,"_25514":45415,"_2665":45449},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3170":27,"_28022":15,"_19417":45451,"_5":13306,"_25514":45415,"_2665":45452},[],"A security group allowing the necessary endpoints.",{"_3170":28,"_28022":15,"_19417":45454,"_5":13306,"_25514":45419,"_2665":45455},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3170":29,"_28022":15,"_19417":45457,"_5":13306,"_25514":45419,"_2665":45458},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3170":30,"_28022":15,"_19417":45460,"_5":13306,"_25514":45419,"_2665":45461},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3170":31,"_28022":15,"_19417":45463,"_5":13306,"_25514":45423,"_2665":45464},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3170":32,"_28022":15,"_19417":45466,"_5":13306,"_25514":45427,"_2665":45467},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3170":33,"_28022":15,"_19417":45469,"_5":13306,"_25514":45431,"_2665":45470},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3170":34,"_28022":15,"_19417":45472,"_5":13306,"_25514":45435,"_2665":45473},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3170":35,"_28022":15,"_19417":45475,"_5":13306,"_25514":45439,"_2665":45476},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3170":36,"_28022":36,"_5":13637,"_2665":45478,"_28344":45479,"_19417":45480,"_25514":36},"Deploy Lamassu",[45406,45407],[],{"_3170":37,"_28022":36,"_19417":45482,"_5":13306,"_25514":36,"_2665":45483},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3170":38,"_28022":36,"_5":28341,"_19417":45485,"_25514":45486,"_2665":45487},[],"/docs/deployment/overview#choose-a-model","Choose a model",{"_3170":39,"_28022":36,"_5":28341,"_19417":45489,"_25514":45490,"_2665":45491},[],"/docs/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3170":40,"_28022":36,"_5":28341,"_19417":45493,"_25514":45494,"_2665":45495},[],"/docs/deployment/overview#after-deployment","After deployment",{"_3170":41,"_28022":36,"_19417":45497,"_5":13306,"_25514":36,"_2665":45498},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3170":42,"_28022":36,"_19417":45500,"_5":13306,"_25514":45486,"_2665":45501},[],"Model",{"_3170":43,"_28022":36,"_19417":45503,"_5":13306,"_25514":45486,"_2665":45504},[],"Recommended for",{"_3170":44,"_28022":36,"_19417":45506,"_5":13306,"_25514":45486,"_2665":45507},[],"Who operates the infrastructure",{"_3170":45,"_28022":36,"_19417":45509,"_5":13306,"_25514":45486,"_2665":45510},[],"Starting point",{"_3170":46,"_28022":36,"_19417":45512,"_5":13306,"_25514":45486,"_2665":45513},[],"Kubernetes self-managed",{"_3170":47,"_28022":36,"_19417":45515,"_5":13306,"_25514":45486,"_2665":45516},[],"Production, regulated environments and custom deployments",{"_3170":48,"_28022":36,"_19417":45518,"_5":13306,"_25514":45486,"_2665":45519},[],"Your team",{"_3170":49,"_28022":36,"_19417":45521,"_5":13306,"_25514":45486,"_2665":45522},[],"Helm or Fastlane",{"_3170":50,"_28022":36,"_19417":45524,"_5":13306,"_25514":45486,"_2665":45525},[],"AWS Marketplace",{"_3170":51,"_28022":36,"_19417":45527,"_5":13306,"_25514":45486,"_2665":45528},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3170":52,"_28022":36,"_19417":45530,"_5":13306,"_25514":45486,"_2665":45519},[],{"_3170":53,"_28022":36,"_19417":45532,"_5":13306,"_25514":45486,"_2665":45533},[],"Preconfigured image on EC2",{"_3170":54,"_28022":36,"_19417":45535,"_5":13306,"_25514":45486,"_2665":45536},[],"SaaS",{"_3170":55,"_28022":36,"_19417":45538,"_5":13306,"_25514":45486,"_2665":45539},[],"Teams that want to use the platform without operating it",{"_3170":56,"_28022":36,"_19417":45541,"_5":13306,"_25514":45486,"_2665":45542},[],"Lamassu",{"_3170":57,"_28022":36,"_19417":45544,"_5":13306,"_25514":45486,"_2665":45545},[],"Managed subscription",{"_3170":58,"_28022":36,"_19417":45547,"_5":13306,"_25514":45486,"_2665":45548},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3170":59,"_28022":36,"_19417":45550,"_5":13306,"_25514":45486,"_2665":45551},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3170":60,"_28022":36,"_19417":45553,"_5":13306,"_25514":45486,"_2665":45554},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3170":61,"_28022":36,"_19417":45556,"_5":13306,"_25514":45490,"_2665":45557},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3170":62,"_28022":36,"_19417":45559,"_5":13306,"_25514":45494,"_2665":45560},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3170":63,"_28022":63,"_5":13637,"_2665":45562,"_28344":45563,"_19417":45564,"_25514":63},"Use Lamassu as SaaS",[45406,45407,45408],[],{"_3170":64,"_28022":63,"_19417":45566,"_5":13306,"_25514":63,"_2665":45567},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3170":65,"_28022":63,"_5":28341,"_19417":45569,"_25514":45570,"_2665":45571},[],"/docs/deployment/saas#what-the-service-manages","What the service manages",{"_3170":66,"_28022":63,"_5":28341,"_19417":45573,"_25514":45574,"_2665":45575},[],"/docs/deployment/saas#plans","Plans",{"_3170":67,"_28022":63,"_5":28341,"_19417":45577,"_25514":45578,"_2665":45579},[],"/docs/deployment/saas#request-access","Request access",{"_3170":68,"_28022":63,"_19417":45581,"_5":13306,"_25514":63,"_2665":45582},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3170":69,"_28022":63,"_19417":45584,"_5":13306,"_25514":45570,"_2665":45585},[],"Platform availability and maintenance.",{"_3170":70,"_28022":63,"_19417":45587,"_5":13306,"_25514":45570,"_2665":45588},[],"Automatic backups.",{"_3170":71,"_28022":63,"_19417":45590,"_5":13306,"_25514":45570,"_2665":45591},[],"Version upgrades.",{"_3170":72,"_28022":63,"_19417":45593,"_5":13306,"_25514":45570,"_2665":45594},[],"Technical support and SLA according to your plan.",{"_3170":73,"_28022":63,"_19417":45596,"_5":13306,"_25514":45574,"_2665":45597},[],"Plan",{"_3170":74,"_28022":63,"_19417":45599,"_5":13306,"_25514":45574,"_2665":45600},[],"Devices",{"_3170":75,"_28022":63,"_19417":45602,"_5":13306,"_25514":45574,"_2665":45603},[],"Support",{"_3170":76,"_28022":63,"_19417":45605,"_5":13306,"_25514":45574,"_2665":45606},[],"SLA",{"_3170":77,"_28022":63,"_19417":45608,"_5":13306,"_25514":45574,"_2665":45609},[],"Starter",{"_3170":78,"_28022":63,"_19417":45611,"_5":13306,"_25514":45574,"_2665":45612},[],"Up to 1,000",{"_3170":79,"_28022":63,"_19417":45614,"_5":13306,"_25514":45574,"_2665":45615},[],"Email",{"_3170":80,"_28022":63,"_19417":45617,"_5":13306,"_25514":45574,"_2665":45618},[],"99.5 %",{"_3170":81,"_28022":63,"_19417":45620,"_5":13306,"_25514":45574,"_2665":45621},[],"Professional",{"_3170":82,"_28022":63,"_19417":45623,"_5":13306,"_25514":45574,"_2665":45624},[],"Up to 10,000",{"_3170":83,"_28022":63,"_19417":45626,"_5":13306,"_25514":45574,"_2665":45627},[],"Email and chat",{"_3170":84,"_28022":63,"_19417":45629,"_5":13306,"_25514":45574,"_2665":45630},[],"99.9 %",{"_3170":85,"_28022":63,"_19417":45632,"_5":13306,"_25514":45574,"_2665":45633},[],"Enterprise",{"_3170":86,"_28022":63,"_19417":45635,"_5":13306,"_25514":45574,"_2665":45636},[],"Unlimited",{"_3170":87,"_28022":63,"_19417":45638,"_5":13306,"_25514":45574,"_2665":45639},[],"Dedicated",{"_3170":88,"_28022":63,"_19417":45641,"_5":13306,"_25514":45574,"_2665":45642},[],"99.99 %",{"_3170":89,"_28022":63,"_19417":45644,"_5":13306,"_25514":45578,"_2665":45645},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3170":90,"_28022":63,"_19417":45647,"_5":13306,"_25514":45578,"_2665":45648},[],"When you receive your instance's credentials, continue with Get started.",{"_3170":91,"_28022":91,"_5":13637,"_2665":45650,"_28344":45651,"_19417":45652,"_25514":91},"Fastlane",[45406,45407,45513],[],{"_3170":92,"_28022":91,"_19417":45654,"_5":13306,"_25514":91,"_2665":45655},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3170":93,"_28022":91,"_5":28341,"_19417":45657,"_25514":45658,"_2665":45659},[],"/docs/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3170":94,"_28022":91,"_5":28341,"_19417":45661,"_25514":45662,"_2665":45663},[],"/docs/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3170":95,"_28022":91,"_5":28341,"_19417":45665,"_25514":45666,"_2665":45416},[],"/docs/deployment/self-hosted/fastlane#before-you-begin",{"_3170":96,"_28022":91,"_5":28341,"_19417":45668,"_25514":45669,"_2665":45670},[],"/docs/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3170":97,"_28022":91,"_5":28341,"_19417":45672,"_25514":45673,"_2665":45674},[],"/docs/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3170":98,"_28022":91,"_5":28341,"_19417":45676,"_25514":45677,"_2665":45678},[],"/docs/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3170":99,"_28022":91,"_5":28341,"_19417":45680,"_25514":45681,"_2665":45682},[],"/docs/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3170":100,"_28022":91,"_5":28341,"_19417":45684,"_25514":45685,"_2665":45686},[],"/docs/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3170":101,"_28022":91,"_5":28341,"_19417":45688,"_25514":45689,"_2665":45690},[],"/docs/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3170":102,"_28022":91,"_5":28341,"_19417":45692,"_25514":45693,"_2665":45694},[],"/docs/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3170":103,"_28022":91,"_5":28341,"_19417":45696,"_25514":45697,"_2665":45698},[],"/docs/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3170":104,"_28022":91,"_19417":45700,"_5":13306,"_25514":45658,"_2665":45701},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3170":105,"_28022":91,"_19417":45703,"_5":13306,"_25514":45658,"_2665":45704},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3170":106,"_28022":91,"_19417":45706,"_5":13306,"_25514":45662,"_2665":45707},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3170":107,"_28022":91,"_19417":45709,"_5":13306,"_25514":45662,"_2665":45710},[],"Fastlane installs or configures",{"_3170":108,"_28022":91,"_19417":45712,"_5":13306,"_25514":45662,"_2665":45713},[],"You still provide",{"_3170":109,"_28022":91,"_19417":45715,"_5":13306,"_25514":45662,"_2665":45716},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3170":110,"_28022":91,"_19417":45718,"_5":13306,"_25514":45662,"_2665":45719},[],"The Kubernetes cluster, nodes and persistent storage",{"_3170":111,"_28022":91,"_19417":45721,"_5":13306,"_25514":45662,"_2665":45722},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3170":112,"_28022":91,"_19417":45724,"_5":13306,"_25514":45662,"_2665":45725},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3170":113,"_28022":91,"_19417":45727,"_5":13306,"_25514":45662,"_2665":45728},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3170":114,"_28022":91,"_19417":45730,"_5":13306,"_25514":45662,"_2665":45731},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3170":115,"_28022":91,"_19417":45733,"_5":13306,"_25514":45662,"_2665":45734},[],"Optional observability and lab HSM components",{"_3170":116,"_28022":91,"_19417":45736,"_5":13306,"_25514":45662,"_2665":45737},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3170":117,"_28022":91,"_19417":45739,"_5":13306,"_25514":45662,"_2665":45740},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3170":118,"_28022":91,"_19417":45742,"_5":13306,"_25514":45666,"_2665":45743},[],"You need:",{"_3170":119,"_28022":91,"_19417":45745,"_5":13306,"_25514":45666,"_2665":45746},[],"an existing Kubernetes cluster",{"_3170":120,"_28022":91,"_19417":45748,"_5":13306,"_25514":45666,"_2665":45749},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3170":121,"_28022":91,"_19417":45751,"_5":13306,"_25514":45666,"_2665":45752},[],"`yq`",{"_3170":122,"_28022":91,"_19417":45754,"_5":13306,"_25514":45666,"_2665":21993},[],{"_3170":123,"_28022":91,"_19417":45756,"_5":13306,"_25514":45666,"_2665":45757},[],"`jq` only when using `--sample-data` or `--development`",{"_3170":124,"_28022":91,"_19417":45759,"_5":13306,"_25514":45666,"_2665":45760},[],"`ssh-keygen` only when using `--with-hsm`",{"_3170":125,"_28022":91,"_19417":45762,"_5":13306,"_25514":45666,"_2665":45763},[],"free external ports 80 and 443 on a single-node K3s host",{"_3170":126,"_28022":91,"_19417":45765,"_5":13306,"_25514":45666,"_2665":45766},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3170":127,"_28022":91,"_19417":45768,"_5":13306,"_25514":45666,"_2665":45769},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3170":128,"_28022":91,"_19417":45771,"_5":13306,"_25514":45669,"_2665":45772},[],"Run the script from a clone of the Helm repository:",{"_3170":129,"_28022":91,"_19417":45774,"_5":13306,"_25514":45669,"_2665":45775},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3170":130,"_28022":91,"_19417":45777,"_5":13306,"_25514":45673,"_2665":45778},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3170":131,"_28022":91,"_19417":45780,"_5":13306,"_25514":45673,"_2665":45781},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3170":132,"_28022":91,"_19417":45783,"_5":13306,"_25514":45673,"_2665":45784},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3170":133,"_28022":91,"_19417":45786,"_5":13306,"_25514":45673,"_2665":45787},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3170":134,"_28022":91,"_19417":45789,"_5":13306,"_25514":45677,"_2665":45790},[],"Option",{"_3170":135,"_28022":91,"_19417":45792,"_5":13306,"_25514":45677,"_2665":45793},[],"Default",{"_3170":136,"_28022":91,"_19417":45795,"_5":13306,"_25514":45677,"_2665":45796},[],"Purpose",{"_3170":137,"_28022":91,"_19417":45798,"_5":13306,"_25514":45677,"_2665":45799},[],"`-h`, `--help`",{"_3170":138,"_28022":91,"_19417":45801,"_5":13306,"_25514":45677,"_2665":45802},[],"—",{"_3170":139,"_28022":91,"_19417":45804,"_5":13306,"_25514":45677,"_2665":45805},[],"Show help",{"_3170":140,"_28022":91,"_19417":45807,"_5":13306,"_25514":45677,"_2665":45808},[],"`-c`, `--context`",{"_3170":141,"_28022":91,"_19417":45810,"_5":13306,"_25514":45677,"_2665":45811},[],"current context",{"_3170":142,"_28022":91,"_19417":45813,"_5":13306,"_25514":45677,"_2665":45814},[],"Select the kubeconfig context for kubectl and Helm",{"_3170":143,"_28022":91,"_19417":45816,"_5":13306,"_25514":45677,"_2665":45817},[],"`-n`, `--non-interactive`",{"_3170":144,"_28022":91,"_19417":45819,"_5":13306,"_25514":45677,"_2665":5961},[],{"_3170":145,"_28022":91,"_19417":45821,"_5":13306,"_25514":45677,"_2665":45822},[],"Skip prompts and generate dependency credentials",{"_3170":146,"_28022":91,"_19417":45824,"_5":13306,"_25514":45677,"_2665":45825},[],"`-ns`, `--namespace`",{"_3170":147,"_28022":91,"_19417":45827,"_5":13306,"_25514":45677,"_2665":45828},[],"`lamassu-dev`",{"_3170":148,"_28022":91,"_19417":45830,"_5":13306,"_25514":45677,"_2665":45831},[],"Namespace for the installation",{"_3170":149,"_28022":91,"_19417":45833,"_5":13306,"_25514":45677,"_2665":45834},[],"`-d`, `--domain`",{"_3170":150,"_28022":91,"_19417":45836,"_5":13306,"_25514":45677,"_2665":45837},[],"`dev.lamassu.io`",{"_3170":151,"_28022":91,"_19417":45839,"_5":13306,"_25514":45677,"_2665":45840},[],"Domain used by the UI, OIDC and certificate",{"_3170":152,"_28022":91,"_19417":45842,"_5":13306,"_25514":45677,"_2665":45843},[],"`-v`, `--version`",{"_3170":153,"_28022":91,"_19417":45845,"_5":13306,"_25514":45677,"_2665":13931},[],{"_3170":154,"_28022":91,"_19417":45847,"_5":13306,"_25514":45677,"_2665":45848},[],"Lamassu chart version",{"_3170":155,"_28022":91,"_19417":45850,"_5":13306,"_25514":45677,"_2665":45851},[],"`--https-port`",{"_3170":156,"_28022":91,"_19417":45853,"_5":13306,"_25514":45677,"_2665":45854},[],"`443`",{"_3170":157,"_28022":91,"_19417":45856,"_5":13306,"_25514":45677,"_2665":45857},[],"Gateway HTTPS listener port",{"_3170":158,"_28022":91,"_19417":45859,"_5":13306,"_25514":45677,"_2665":45860},[],"`--http-port`",{"_3170":159,"_28022":91,"_19417":45862,"_5":13306,"_25514":45677,"_2665":45863},[],"`80`",{"_3170":160,"_28022":91,"_19417":45865,"_5":13306,"_25514":45677,"_2665":45866},[],"Gateway HTTP listener port",{"_3170":161,"_28022":91,"_19417":45868,"_5":13306,"_25514":45677,"_2665":45869},[],"`--tls-crt`",{"_3170":162,"_28022":91,"_19417":45871,"_5":13306,"_25514":45677,"_2665":45802},[],{"_3170":163,"_28022":91,"_19417":45873,"_5":13306,"_25514":45677,"_2665":45874},[],"PEM certificate for downstream TLS",{"_3170":164,"_28022":91,"_19417":45876,"_5":13306,"_25514":45677,"_2665":45877},[],"`--tls-key`",{"_3170":165,"_28022":91,"_19417":45879,"_5":13306,"_25514":45677,"_2665":45802},[],{"_3170":166,"_28022":91,"_19417":45881,"_5":13306,"_25514":45677,"_2665":45882},[],"PEM private key for downstream TLS",{"_3170":167,"_28022":91,"_19417":45884,"_5":13306,"_25514":45677,"_2665":45885},[],"`-l`, `--local-chart-path`",{"_3170":168,"_28022":91,"_19417":45887,"_5":13306,"_25514":45677,"_2665":45888},[],"repository chart",{"_3170":169,"_28022":91,"_19417":45890,"_5":13306,"_25514":45677,"_2665":45891},[],"Use an unpacked local Lamassu chart",{"_3170":170,"_28022":91,"_19417":45893,"_5":13306,"_25514":45677,"_2665":45894},[],"`-ip`, `--gateway-ip`",{"_3170":171,"_28022":91,"_19417":45896,"_5":13306,"_25514":45677,"_2665":8019},[],{"_3170":172,"_28022":91,"_19417":45898,"_5":13306,"_25514":45677,"_2665":45899},[],"Override the address written to `gateway.addresses`",{"_3170":173,"_28022":91,"_19417":45901,"_5":13306,"_25514":45677,"_2665":45902},[],"`--otel`",{"_3170":174,"_28022":91,"_19417":45904,"_5":13306,"_25514":45677,"_2665":5961},[],{"_3170":175,"_28022":91,"_19417":45906,"_5":13306,"_25514":45677,"_2665":45907},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3170":176,"_28022":91,"_19417":45909,"_5":13306,"_25514":45677,"_2665":45910},[],"`--development`",{"_3170":177,"_28022":91,"_19417":45912,"_5":13306,"_25514":45677,"_2665":5961},[],{"_3170":178,"_28022":91,"_19417":45914,"_5":13306,"_25514":45677,"_2665":45915},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3170":179,"_28022":91,"_19417":45917,"_5":13306,"_25514":45677,"_2665":45918},[],"`--sample-data`",{"_3170":180,"_28022":91,"_19417":45920,"_5":13306,"_25514":45677,"_2665":5961},[],{"_3170":181,"_28022":91,"_19417":45922,"_5":13306,"_25514":45677,"_2665":45923},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3170":182,"_28022":91,"_19417":45925,"_5":13306,"_25514":45677,"_2665":45926},[],"`--with-hsm`",{"_3170":183,"_28022":91,"_19417":45928,"_5":13306,"_25514":45677,"_2665":5961},[],{"_3170":184,"_28022":91,"_19417":45930,"_5":13306,"_25514":45677,"_2665":45931},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3170":185,"_28022":91,"_19417":45933,"_5":13306,"_25514":45677,"_2665":45934},[],"`--softhsm-chart-path`",{"_3170":186,"_28022":91,"_19417":45936,"_5":13306,"_25514":45677,"_2665":45937},[],"`./charts/softhsm`",{"_3170":187,"_28022":91,"_19417":45939,"_5":13306,"_25514":45677,"_2665":45940},[],"Use a different local SoftHSM chart",{"_3170":188,"_28022":91,"_19417":45942,"_5":13306,"_25514":45677,"_2665":45943},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3170":189,"_28022":91,"_19417":45945,"_5":13306,"_25514":45681,"_2665":45946},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3170":190,"_28022":91,"_19417":45948,"_5":13306,"_25514":45681,"_2665":45949},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3170":191,"_28022":91,"_19417":45951,"_5":13306,"_25514":45681,"_2665":45952},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3170":192,"_28022":91,"_19417":45954,"_5":13306,"_25514":45681,"_2665":45955},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3170":193,"_28022":91,"_19417":45957,"_5":13306,"_25514":45681,"_2665":45958},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3170":194,"_28022":91,"_19417":45960,"_5":13306,"_25514":45681,"_2665":45961},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3170":195,"_28022":91,"_19417":45963,"_5":13306,"_25514":45685,"_2665":45964},[],"Fastlane:",{"_3170":196,"_28022":91,"_19417":45966,"_5":13306,"_25514":45685,"_2665":45967},[],"validates local tools and the selected cluster",{"_3170":197,"_28022":91,"_19417":45969,"_5":13306,"_25514":45685,"_2665":45970},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3170":198,"_28022":91,"_19417":45972,"_5":13306,"_25514":45685,"_2665":45973},[],"creates the namespace",{"_3170":199,"_28022":91,"_19417":45975,"_5":13306,"_25514":45685,"_2665":45976},[],"installs PostgreSQL and creates the required databases",{"_3170":200,"_28022":91,"_19417":45978,"_5":13306,"_25514":45685,"_2665":45979},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3170":201,"_28022":91,"_19417":45981,"_5":13306,"_25514":45685,"_2665":45982},[],"installs RabbitMQ",{"_3170":202,"_28022":91,"_19417":45984,"_5":13306,"_25514":45685,"_2665":45985},[],"optionally installs observability and lab HSM components",{"_3170":203,"_28022":91,"_19417":45987,"_5":13306,"_25514":45685,"_2665":45988},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3170":204,"_28022":91,"_19417":45990,"_5":13306,"_25514":45685,"_2665":45991},[],"optionally loads sample data",{"_3170":205,"_28022":91,"_19417":45993,"_5":13306,"_25514":45685,"_2665":45994},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3170":206,"_28022":91,"_19417":45996,"_5":13306,"_25514":45689,"_2665":45997},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3170":207,"_28022":91,"_19417":45999,"_5":13306,"_25514":45689,"_2665":46000},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3170":208,"_28022":91,"_19417":46002,"_5":13306,"_25514":45693,"_2665":46003},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3170":209,"_28022":91,"_19417":46005,"_5":13306,"_25514":45693,"_2665":46006},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3170":210,"_28022":91,"_19417":46008,"_5":13306,"_25514":45693,"_2665":46009},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3170":211,"_28022":91,"_19417":46011,"_5":13306,"_25514":45697,"_2665":46012},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3170":212,"_28022":212,"_5":13637,"_2665":46014,"_28344":46015,"_19417":46016,"_25514":212},"Install with Helm",[45406,45407,45513],[],{"_3170":213,"_28022":212,"_19417":46018,"_5":13306,"_25514":212,"_2665":46019},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3170":214,"_28022":212,"_5":28341,"_19417":46021,"_25514":46022,"_2665":46023},[],"/docs/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3170":215,"_28022":212,"_5":28341,"_19417":46025,"_25514":46026,"_2665":45416},[],"/docs/deployment/self-hosted/helm#before-you-begin",{"_3170":216,"_28022":212,"_5":28341,"_19417":46028,"_25514":46029,"_2665":46030},[],"/docs/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3170":217,"_28022":212,"_5":28341,"_19417":46032,"_25514":46033,"_2665":46034},[],"/docs/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3170":218,"_28022":212,"_5":28341,"_19417":46036,"_25514":46037,"_2665":46038},[],"/docs/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3170":219,"_28022":212,"_5":28341,"_19417":46040,"_25514":46041,"_2665":46042},[],"/docs/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3170":220,"_28022":212,"_5":28341,"_19417":46044,"_25514":46045,"_2665":46046},[],"/docs/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3170":221,"_28022":212,"_5":28341,"_19417":46048,"_25514":46049,"_2665":46050},[],"/docs/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3170":222,"_28022":212,"_5":28341,"_19417":46052,"_25514":46053,"_2665":46054},[],"/docs/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3170":223,"_28022":212,"_19417":46056,"_5":13306,"_25514":46022,"_2665":46057},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3170":224,"_28022":212,"_19417":46059,"_5":13306,"_25514":46026,"_2665":46060},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3170":225,"_28022":212,"_19417":46062,"_5":13306,"_25514":46026,"_2665":46063},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3170":226,"_28022":212,"_19417":46065,"_5":13306,"_25514":46026,"_2665":46066},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3170":227,"_28022":212,"_19417":46068,"_5":13306,"_25514":46026,"_2665":46069},[],"a reachable RabbitMQ broker and credentials",{"_3170":228,"_28022":212,"_19417":46071,"_5":13306,"_25514":46026,"_2665":46072},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3170":229,"_28022":212,"_19417":46074,"_5":13306,"_25514":46026,"_2665":46075},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3170":230,"_28022":212,"_19417":46077,"_5":13306,"_25514":46026,"_2665":46078},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3170":231,"_28022":212,"_19417":46080,"_5":13306,"_25514":46026,"_2665":46081},[],"a StorageClass and an external traffic design",{"_3170":232,"_28022":212,"_19417":46083,"_5":13306,"_25514":46026,"_2665":46084},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3170":233,"_28022":212,"_19417":46086,"_5":13306,"_25514":46026,"_2665":46087},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3170":234,"_28022":212,"_19417":46089,"_5":13306,"_25514":46026,"_2665":46090},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3170":235,"_28022":212,"_19417":46092,"_5":13306,"_25514":46029,"_2665":46093},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3170":236,"_28022":212,"_19417":46095,"_5":13306,"_25514":46029,"_2665":46096},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3170":237,"_28022":212,"_19417":46098,"_5":13306,"_25514":46029,"_2665":46099},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3170":238,"_28022":212,"_19417":46101,"_5":13306,"_25514":46033,"_2665":46102},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3170":239,"_28022":212,"_19417":46104,"_5":13306,"_25514":46033,"_2665":46105},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3170":240,"_28022":212,"_19417":46107,"_5":13306,"_25514":46033,"_2665":46108},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3170":241,"_28022":212,"_19417":46110,"_5":13306,"_25514":46037,"_2665":46111},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3170":242,"_28022":212,"_19417":46113,"_5":13306,"_25514":46041,"_2665":46114},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3170":243,"_28022":212,"_19417":46116,"_5":13306,"_25514":46041,"_2665":46117},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3170":244,"_28022":212,"_19417":46119,"_5":13306,"_25514":46041,"_2665":46120},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3170":245,"_28022":212,"_19417":46122,"_5":13306,"_25514":46041,"_2665":46123},[],"See Access control for the principal and policy model.",{"_3170":246,"_28022":212,"_19417":46125,"_5":13306,"_25514":46045,"_2665":46126},[],"To install a local checkout instead:",{"_3170":247,"_28022":212,"_19417":46128,"_5":13306,"_25514":46049,"_2665":46129},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3170":248,"_28022":212,"_19417":46131,"_5":13306,"_25514":46049,"_2665":46132},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3170":249,"_28022":212,"_19417":46134,"_5":13306,"_25514":46053,"_2665":46135},[],"Before going live, review:",{"_3170":250,"_28022":212,"_19417":46137,"_5":13306,"_25514":46053,"_2665":46138},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3170":251,"_28022":212,"_19417":46140,"_5":13306,"_25514":46053,"_2665":46141},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3170":252,"_28022":212,"_19417":46143,"_5":13306,"_25514":46053,"_2665":46144},[],"shared VA storage before increasing VA replicas",{"_3170":253,"_28022":212,"_19417":46146,"_5":13306,"_25514":46053,"_2665":46147},[],"managed OIDC roles and removal of evaluation credentials",{"_3170":254,"_28022":212,"_19417":46149,"_5":13306,"_25514":46053,"_2665":46150},[],"a trusted TLS issuer or externally managed certificate",{"_3170":255,"_28022":212,"_19417":46152,"_5":13306,"_25514":46053,"_2665":46153},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3170":256,"_28022":212,"_19417":46155,"_5":13306,"_25514":46053,"_2665":46156},[],"SMTP, observability and alert delivery",{"_3170":257,"_28022":212,"_19417":46158,"_5":13306,"_25514":46053,"_2665":46159},[],"the version upgrade guides and the notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_3170":258,"_28022":212,"_19417":46161,"_5":13306,"_25514":46053,"_2665":46162},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3170":259,"_28022":259,"_5":13637,"_2665":46164,"_28344":46165,"_19417":46166,"_25514":259},"Expose the Gateway",[45406,45407,45513],[],{"_3170":260,"_28022":259,"_19417":46168,"_5":13306,"_25514":259,"_2665":46169},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3170":261,"_28022":259,"_5":28341,"_19417":46171,"_25514":46172,"_2665":46173},[],"/docs/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3170":262,"_28022":259,"_5":28341,"_19417":46175,"_25514":46176,"_2665":46177},[],"/docs/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3170":263,"_28022":259,"_5":28341,"_19417":46179,"_25514":46180,"_2665":46181},[],"/docs/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3170":264,"_28022":259,"_5":28341,"_19417":46183,"_25514":46184,"_2665":46185},[],"/docs/deployment/self-hosted/networking#k3s","K3s",{"_3170":265,"_28022":259,"_5":28341,"_19417":46187,"_25514":46188,"_2665":46189},[],"/docs/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3170":266,"_28022":259,"_5":28341,"_19417":46191,"_25514":46192,"_2665":46193},[],"/docs/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3170":267,"_28022":259,"_5":28341,"_19417":46195,"_25514":46196,"_2665":46197},[],"/docs/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3170":268,"_28022":259,"_5":28341,"_19417":46199,"_25514":46200,"_2665":46201},[],"/docs/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3170":269,"_28022":259,"_5":28341,"_19417":46203,"_25514":46204,"_2665":46205},[],"/docs/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3170":270,"_28022":259,"_5":28341,"_19417":46207,"_25514":46208,"_2665":46209},[],"/docs/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3170":271,"_28022":259,"_19417":46211,"_5":13306,"_25514":46172,"_2665":46212},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3170":272,"_28022":259,"_19417":46214,"_5":13306,"_25514":46172,"_2665":46215},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3170":273,"_28022":259,"_19417":46217,"_5":13306,"_25514":46176,"_2665":46218},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3170":274,"_28022":259,"_19417":46220,"_5":13306,"_25514":46176,"_2665":46221},[],"Set it only when:",{"_3170":275,"_28022":259,"_19417":46223,"_5":13306,"_25514":46176,"_2665":46224},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3170":276,"_28022":259,"_19417":46226,"_5":13306,"_25514":46176,"_2665":46227},[],"that address is allocated to this Gateway",{"_3170":277,"_28022":259,"_19417":46229,"_5":13306,"_25514":46176,"_2665":46230},[],"the surrounding network already routes traffic for it to the cluster",{"_3170":278,"_28022":259,"_19417":46232,"_5":13306,"_25514":46176,"_2665":46233},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3170":279,"_28022":259,"_19417":46235,"_5":13306,"_25514":46176,"_2665":46236},[],"Keep these two settings separate:",{"_3170":280,"_28022":259,"_19417":46238,"_5":13306,"_25514":46176,"_2665":46239},[],"`gateway.addresses` requests an address for the Gateway.",{"_3170":281,"_28022":259,"_19417":46241,"_5":13306,"_25514":46176,"_2665":46242},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3170":282,"_28022":259,"_19417":46244,"_5":13306,"_25514":46176,"_2665":46245},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3170":283,"_28022":259,"_19417":46247,"_5":13306,"_25514":46180,"_2665":46248},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3170":284,"_28022":259,"_19417":46250,"_5":13306,"_25514":46180,"_2665":46251},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3170":285,"_28022":259,"_19417":46253,"_5":13306,"_25514":46184,"_2665":46254},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3170":286,"_28022":259,"_19417":46256,"_5":13306,"_25514":46184,"_2665":46257},[],"For the recommended design:",{"_3170":287,"_28022":259,"_19417":46259,"_5":13306,"_25514":46184,"_2665":46260},[],"Use only one externally exposed Lamassu Gateway.",{"_3170":288,"_28022":259,"_19417":46262,"_5":13306,"_25514":46184,"_2665":46263},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3170":289,"_28022":259,"_19417":46265,"_5":13306,"_25514":46184,"_2665":46266},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3170":290,"_28022":259,"_19417":46268,"_5":13306,"_25514":46184,"_2665":46269},[],"Point DNS at the VM's reachable address.",{"_3170":291,"_28022":259,"_19417":46271,"_5":13306,"_25514":46184,"_2665":46272},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3170":292,"_28022":259,"_19417":46274,"_5":13306,"_25514":46188,"_2665":46275},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3170":293,"_28022":259,"_19417":46277,"_5":13306,"_25514":46192,"_2665":46278},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3170":294,"_28022":259,"_19417":46280,"_5":13306,"_25514":46192,"_2665":46281},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3170":295,"_28022":259,"_19417":46283,"_5":13306,"_25514":46196,"_2665":46284},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3170":296,"_28022":259,"_19417":46286,"_5":13306,"_25514":46196,"_2665":46287},[],"Requirement",{"_3170":297,"_28022":259,"_19417":46289,"_5":13306,"_25514":46196,"_2665":46290},[],"Recommended design",{"_3170":298,"_28022":259,"_19417":46292,"_5":13306,"_25514":46196,"_2665":46293},[],"Consequence",{"_3170":299,"_28022":259,"_19417":46295,"_5":13306,"_25514":46196,"_2665":46296},[],"Several Lamassu URLs or services",{"_3170":300,"_28022":259,"_19417":46298,"_5":13306,"_25514":46196,"_2665":46299},[],"One Gateway with multiple routes",{"_3170":301,"_28022":259,"_19417":46301,"_5":13306,"_25514":46196,"_2665":46302},[],"One IP and one proxy fleet; this is the chart default",{"_3170":302,"_28022":259,"_19417":46304,"_5":13306,"_25514":46196,"_2665":46305},[],"Independent Gateways and separate external IPs",{"_3170":303,"_28022":259,"_19417":46307,"_5":13306,"_25514":46196,"_2665":46308},[],"One VIP per Gateway",{"_3170":304,"_28022":259,"_19417":46310,"_5":13306,"_25514":46196,"_2665":46311},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3170":305,"_28022":259,"_19417":46313,"_5":13306,"_25514":46196,"_2665":46314},[],"Independent Gateways on one node and one IP",{"_3170":306,"_28022":259,"_19417":46316,"_5":13306,"_25514":46196,"_2665":46317},[],"Use different external ports",{"_3170":307,"_28022":259,"_19417":46319,"_5":13306,"_25514":46196,"_2665":46320},[],"Clients must include non-standard ports",{"_3170":308,"_28022":259,"_19417":46322,"_5":13306,"_25514":46196,"_2665":46323},[],"Separate TLS/mTLS termination behind one IP",{"_3170":309,"_28022":259,"_19417":46325,"_5":13306,"_25514":46196,"_2665":46326},[],"Front-door SNI routing to internal Gateways",{"_3170":310,"_28022":259,"_19417":46328,"_5":13306,"_25514":46196,"_2665":46329},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3170":311,"_28022":259,"_19417":46331,"_5":13306,"_25514":46196,"_2665":46332},[],"Separate Gateway resources but shared proxy infrastructure",{"_3170":312,"_28022":259,"_19417":46334,"_5":13306,"_25514":46196,"_2665":46335},[],"Envoy merged-Gateway mode",{"_3170":313,"_28022":259,"_19417":46337,"_5":13306,"_25514":46196,"_2665":46338},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3170":314,"_28022":259,"_19417":46340,"_5":13306,"_25514":46196,"_2665":46341},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3170":315,"_28022":259,"_19417":46343,"_5":13306,"_25514":46196,"_2665":46344},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3170":316,"_28022":259,"_19417":46346,"_5":13306,"_25514":46196,"_2665":46347},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3170":317,"_28022":259,"_19417":46349,"_5":13306,"_25514":46196,"_2665":46350},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3170":318,"_28022":259,"_19417":46352,"_5":13306,"_25514":46200,"_2665":46353},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3170":319,"_28022":259,"_19417":46355,"_5":13306,"_25514":46200,"_2665":46356},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3170":320,"_28022":259,"_19417":46358,"_5":13306,"_25514":46200,"_2665":46359},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3170":321,"_28022":259,"_19417":46361,"_5":13306,"_25514":46200,"_2665":46362},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3170":322,"_28022":259,"_19417":46364,"_5":13306,"_25514":46200,"_2665":46365},[],"If none of those are possible, use different external ports or change the external network design.",{"_3170":323,"_28022":259,"_19417":46367,"_5":13306,"_25514":46204,"_2665":46368},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3170":324,"_28022":259,"_19417":46370,"_5":13306,"_25514":46204,"_2665":46371},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3170":325,"_28022":259,"_19417":46373,"_5":13306,"_25514":46208,"_2665":46374},[],"Check, in order:",{"_3170":326,"_28022":259,"_19417":46376,"_5":13306,"_25514":46208,"_2665":46377},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3170":327,"_28022":259,"_19417":46379,"_5":13306,"_25514":46208,"_2665":46380},[],"Its status contains the expected address.",{"_3170":328,"_28022":259,"_19417":46382,"_5":13306,"_25514":46208,"_2665":46383},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3170":329,"_28022":259,"_19417":46385,"_5":13306,"_25514":46208,"_2665":46386},[],"Port 443 reaches that address from the client network.",{"_3170":330,"_28022":259,"_19417":46388,"_5":13306,"_25514":46208,"_2665":46389},[],"DNS resolves to the externally reachable endpoint.",{"_3170":331,"_28022":259,"_19417":46391,"_5":13306,"_25514":46208,"_2665":46392},[],"The certificate contains the DNS name or IP used by the client.",{"_3170":332,"_28022":259,"_19417":46394,"_5":13306,"_25514":46208,"_2665":46395},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3170":333,"_28022":333,"_5":13637,"_2665":45513,"_28344":46397,"_19417":46398,"_25514":333},[45406,45407,45513],[],{"_3170":334,"_28022":333,"_19417":46400,"_5":13306,"_25514":333,"_2665":46401},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3170":335,"_28022":333,"_5":28341,"_19417":46403,"_25514":46404,"_2665":46405},[],"/docs/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3170":336,"_28022":333,"_5":28341,"_19417":46407,"_25514":46408,"_2665":46409},[],"/docs/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3170":337,"_28022":333,"_5":28341,"_19417":46411,"_25514":46412,"_2665":46413},[],"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3170":338,"_28022":333,"_5":28341,"_19417":46415,"_25514":46416,"_2665":46417},[],"/docs/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3170":339,"_28022":333,"_5":28341,"_19417":46419,"_25514":46420,"_2665":46421},[],"/docs/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3170":340,"_28022":333,"_5":28341,"_19417":46423,"_25514":46424,"_2665":46425},[],"/docs/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3170":341,"_28022":333,"_19417":46427,"_5":13306,"_25514":46404,"_2665":46428},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3170":342,"_28022":333,"_19417":46430,"_5":13306,"_25514":46408,"_2665":46431},[],"Workflow",{"_3170":343,"_28022":333,"_19417":46433,"_5":13306,"_25514":46408,"_2665":46434},[],"Use it for",{"_3170":344,"_28022":333,"_19417":46436,"_5":13306,"_25514":46408,"_2665":46437},[],"What it installs",{"_3170":345,"_28022":333,"_19417":46439,"_5":13306,"_25514":46408,"_2665":46440},[],"Helm",{"_3170":346,"_28022":333,"_19417":46442,"_5":13306,"_25514":46408,"_2665":46443},[],"Production and controlled environments",{"_3170":347,"_28022":333,"_19417":46445,"_5":13306,"_25514":46408,"_2665":46446},[],"Lamassu services and Gateway API resources",{"_3170":348,"_28022":333,"_19417":46448,"_5":13306,"_25514":46408,"_2665":45650},[],{"_3170":349,"_28022":333,"_19417":46450,"_5":13306,"_25514":46408,"_2665":46451},[],"Evaluation, demos, CI and small lab clusters",{"_3170":350,"_28022":333,"_19417":46453,"_5":13306,"_25514":46408,"_2665":46454},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3170":351,"_28022":333,"_19417":46456,"_5":13306,"_25514":46412,"_2665":46457},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3170":352,"_28022":333,"_19417":46459,"_5":13306,"_25514":46412,"_2665":46460},[],"Area",{"_3170":353,"_28022":333,"_19417":46462,"_5":13306,"_25514":46412,"_2665":46463},[],"The Lamassu chart provides",{"_3170":354,"_28022":333,"_19417":46465,"_5":13306,"_25514":46412,"_2665":46466},[],"You provide",{"_3170":355,"_28022":333,"_19417":46468,"_5":13306,"_25514":46412,"_2665":46469},[],"Lamassu applications",{"_3170":356,"_28022":333,"_19417":46471,"_5":13306,"_25514":46412,"_2665":46472},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3170":357,"_28022":333,"_19417":46474,"_5":13306,"_25514":46412,"_2665":46475},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3170":358,"_28022":333,"_19417":46477,"_5":13306,"_25514":46412,"_2665":46478},[],"PostgreSQL data",{"_3170":359,"_28022":333,"_19417":46480,"_5":13306,"_25514":46412,"_2665":46481},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3170":360,"_28022":333,"_19417":46483,"_5":13306,"_25514":46412,"_2665":46484},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3170":361,"_28022":333,"_19417":46486,"_5":13306,"_25514":46412,"_2665":46487},[],"Messaging",{"_3170":362,"_28022":333,"_19417":46489,"_5":13306,"_25514":46412,"_2665":46490},[],"RabbitMQ connection configuration for the Lamassu services",{"_3170":363,"_28022":333,"_19417":46492,"_5":13306,"_25514":46412,"_2665":46493},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3170":364,"_28022":333,"_19417":46495,"_5":13306,"_25514":46412,"_2665":46496},[],"Identity",{"_3170":365,"_28022":333,"_19417":46498,"_5":13306,"_25514":46412,"_2665":46499},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3170":366,"_28022":333,"_19417":46501,"_5":13306,"_25514":46412,"_2665":46502},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3170":367,"_28022":333,"_19417":46504,"_5":13306,"_25514":46412,"_2665":46505},[],"External routing",{"_3170":368,"_28022":333,"_19417":46507,"_5":13306,"_25514":46412,"_2665":46508},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3170":369,"_28022":333,"_19417":46510,"_5":13306,"_25514":46412,"_2665":46511},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3170":370,"_28022":333,"_19417":46513,"_5":13306,"_25514":46412,"_2665":46514},[],"TLS",{"_3170":371,"_28022":333,"_19417":46516,"_5":13306,"_25514":46412,"_2665":46517},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3170":372,"_28022":333,"_19417":46519,"_5":13306,"_25514":46412,"_2665":46520},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3170":373,"_28022":333,"_19417":46522,"_5":13306,"_25514":46412,"_2665":46523},[],"Persistent application data",{"_3170":374,"_28022":333,"_19417":46525,"_5":13306,"_25514":46412,"_2665":46526},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3170":375,"_28022":333,"_19417":46528,"_5":13306,"_25514":46412,"_2665":46529},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3170":376,"_28022":333,"_19417":46531,"_5":13306,"_25514":46412,"_2665":46532},[],"Optional integrations",{"_3170":377,"_28022":333,"_19417":46534,"_5":13306,"_25514":46412,"_2665":46535},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3170":378,"_28022":333,"_19417":46537,"_5":13306,"_25514":46412,"_2665":46538},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3170":379,"_28022":333,"_19417":46540,"_5":13306,"_25514":46412,"_2665":46541},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3170":380,"_28022":333,"_19417":46543,"_5":13306,"_25514":46412,"_2665":46544},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3170":381,"_28022":333,"_19417":46546,"_5":13306,"_25514":46416,"_2665":46547},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3170":382,"_28022":333,"_19417":46549,"_5":13306,"_25514":46416,"_2665":46550},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3170":383,"_28022":333,"_19417":46552,"_5":13306,"_25514":46420,"_2665":46553},[],"Kubernetes 1.24 or newer",{"_3170":384,"_28022":333,"_19417":46555,"_5":13306,"_25514":46420,"_2665":46556},[],"Helm 3.2 or newer",{"_3170":385,"_28022":333,"_19417":46558,"_5":13306,"_25514":46420,"_2665":46559},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3170":386,"_28022":333,"_19417":46561,"_5":13306,"_25514":46420,"_2665":46562},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3170":387,"_28022":333,"_19417":46564,"_5":13306,"_25514":46420,"_2665":46565},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3170":388,"_28022":333,"_19417":46567,"_5":13306,"_25514":46420,"_2665":46568},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3170":389,"_28022":333,"_19417":46570,"_5":13306,"_25514":46420,"_2665":46571},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3170":390,"_28022":333,"_19417":46573,"_5":13306,"_25514":46424,"_2665":46574},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3170":391,"_28022":333,"_19417":46576,"_5":13306,"_25514":46424,"_2665":46577},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3170":392,"_28022":333,"_19417":46579,"_5":13306,"_25514":46424,"_2665":46580},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3170":393,"_28022":333,"_19417":46582,"_5":13306,"_25514":46424,"_2665":46583},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3170":394,"_28022":394,"_5":13637,"_2665":46585,"_28344":46586,"_19417":46588,"_25514":394},"Deployment troubleshooting",[45406,45407,46587],"Operations",[],{"_3170":395,"_28022":394,"_19417":46590,"_5":13306,"_25514":394,"_2665":46591},[],"Diagnose access, service health and infrastructure dependencies.",{"_3170":396,"_28022":394,"_5":28341,"_19417":46593,"_25514":46594,"_2665":46595},[],"/docs/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3170":397,"_28022":394,"_5":28341,"_19417":46597,"_25514":46598,"_2665":46599},[],"/docs/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3170":398,"_28022":394,"_5":28341,"_19417":46601,"_25514":46602,"_2665":46603},[],"/docs/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3170":399,"_28022":394,"_5":28341,"_19417":46605,"_25514":46606,"_2665":46607},[],"/docs/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3170":400,"_28022":394,"_5":28341,"_19417":46609,"_25514":46610,"_2665":46611},[],"/docs/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3170":401,"_28022":394,"_5":28341,"_19417":46613,"_25514":46614,"_2665":46615},[],"/docs/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3170":402,"_28022":394,"_5":28341,"_19417":46617,"_25514":46618,"_2665":46619},[],"/docs/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3170":403,"_28022":394,"_5":28341,"_19417":46621,"_25514":46622,"_2665":46623},[],"/docs/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3170":404,"_28022":394,"_5":28341,"_19417":46625,"_25514":46626,"_2665":46627},[],"/docs/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3170":405,"_28022":394,"_5":28341,"_19417":46629,"_25514":46630,"_2665":46631},[],"/docs/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3170":406,"_28022":394,"_5":28341,"_19417":46633,"_25514":46634,"_2665":46635},[],"/docs/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3170":407,"_28022":394,"_5":28341,"_19417":46637,"_25514":46638,"_2665":46639},[],"/docs/deployment/troubleshooting#observability","Observability",{"_3170":408,"_28022":394,"_19417":46641,"_5":13306,"_25514":394,"_2665":46642},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3170":409,"_28022":394,"_19417":46644,"_5":13306,"_25514":46598,"_2665":46645},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3170":410,"_28022":394,"_19417":46647,"_5":13306,"_25514":46602,"_2665":46648},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3170":411,"_28022":394,"_19417":46650,"_5":13306,"_25514":46606,"_2665":46651},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3170":412,"_28022":394,"_19417":46653,"_5":13306,"_25514":46610,"_2665":46654},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3170":413,"_28022":394,"_19417":46656,"_5":13306,"_25514":46614,"_2665":46657},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3170":414,"_28022":394,"_19417":46659,"_5":13306,"_25514":46618,"_2665":46660},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3170":415,"_28022":394,"_19417":46662,"_5":13306,"_25514":46618,"_2665":46663},[],"Also run the chart's connectivity test:",{"_3170":416,"_28022":394,"_19417":46665,"_5":13306,"_25514":46618,"_2665":46666},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3170":417,"_28022":394,"_19417":46668,"_5":13306,"_25514":46618,"_2665":46669},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3170":418,"_28022":394,"_19417":46671,"_5":13306,"_25514":46622,"_2665":46672},[],"If you receive a 401:",{"_3170":419,"_28022":394,"_19417":46674,"_5":13306,"_25514":46622,"_2665":46675},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3170":420,"_28022":394,"_19417":46677,"_5":13306,"_25514":46622,"_2665":46678},[],"verify issuer, audience and expiration of the token;",{"_3170":421,"_28022":394,"_19417":46680,"_5":13306,"_25514":46622,"_2665":46681},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3170":422,"_28022":394,"_19417":46683,"_5":13306,"_25514":46622,"_2665":46684},[],"check that the provider's public and internal routes point to the same realm.",{"_3170":423,"_28022":394,"_19417":46686,"_5":13306,"_25514":46622,"_2665":46687},[],"If login succeeds but the APIs return 403:",{"_3170":424,"_28022":394,"_19417":46689,"_5":13306,"_25514":46622,"_2665":46690},[],"inspect the token's real claims;",{"_3170":425,"_28022":394,"_19417":46692,"_5":13306,"_25514":46622,"_2665":46693},[],"confirm they match an active principal;",{"_3170":426,"_28022":394,"_19417":46695,"_5":13306,"_25514":46622,"_2665":46696},[],"review the policies granted to that principal;",{"_3170":427,"_28022":394,"_19417":46698,"_5":13306,"_25514":46622,"_2665":46699},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3170":428,"_28022":394,"_19417":46701,"_5":13306,"_25514":46622,"_2665":46702},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3170":429,"_28022":394,"_19417":46704,"_5":13306,"_25514":46626,"_2665":46705},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3170":430,"_28022":394,"_19417":46707,"_5":13306,"_25514":46626,"_2665":46708},[],"Locate the authz pod and Service.",{"_3170":431,"_28022":394,"_19417":46710,"_5":13306,"_25514":46626,"_2665":46711},[],"Check /health, logs and its database connection.",{"_3170":432,"_28022":394,"_19417":46713,"_5":13306,"_25514":46626,"_2665":46714},[],"Verify the DNS and port configured in externalAuthorization.",{"_3170":433,"_28022":394,"_19417":46716,"_5":13306,"_25514":46626,"_2665":46717},[],"Check the check route is /v1/ext\\_authz/check.",{"_3170":434,"_28022":394,"_19417":46719,"_5":13306,"_25514":46626,"_2665":46720},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3170":435,"_28022":394,"_19417":46722,"_5":13306,"_25514":46630,"_2665":46723},[],"Review kubectl describe pod first. Common causes are:",{"_3170":436,"_28022":394,"_19417":46725,"_5":13306,"_25514":46630,"_2665":46726},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3170":437,"_28022":394,"_19417":46728,"_5":13306,"_25514":46630,"_2665":46729},[],"unbound persistent volume;",{"_3170":438,"_28022":394,"_19417":46731,"_5":13306,"_25514":46630,"_2665":46732},[],"inaccessible image or incorrect pull policy;",{"_3170":439,"_28022":394,"_19417":46734,"_5":13306,"_25514":46630,"_2665":46735},[],"invalid cryptographic engine configuration;",{"_3170":440,"_28022":394,"_19417":46737,"_5":13306,"_25514":46630,"_2665":46738},[],"CPU or memory limits set too low;",{"_3170":441,"_28022":394,"_19417":46740,"_5":13306,"_25514":46630,"_2665":46741},[],"an incomplete prior migration.",{"_3170":442,"_28022":394,"_19417":46743,"_5":13306,"_25514":46630,"_2665":46744},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3170":443,"_28022":394,"_19417":46746,"_5":13306,"_25514":46630,"_2665":46747},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3170":444,"_28022":394,"_19417":46749,"_5":13306,"_25514":46630,"_2665":46750},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3170":445,"_28022":394,"_19417":46752,"_5":13306,"_25514":46634,"_2665":46753},[],"Domain and audit events depend on the bus publisher:",{"_3170":446,"_28022":394,"_19417":46755,"_5":13306,"_25514":46634,"_2665":46756},[],"verify it is enabled in the emitting service;",{"_3170":447,"_28022":394,"_19417":46758,"_5":13306,"_25514":46634,"_2665":46759},[],"check AMQP connectivity and credentials;",{"_3170":448,"_28022":394,"_19417":46761,"_5":13306,"_25514":46634,"_2665":46762},[],"review exchange, routing key, queues and consumers;",{"_3170":449,"_28022":394,"_19417":46764,"_5":13306,"_25514":46634,"_2665":46765},[],"inspect dead-letter queues;",{"_3170":450,"_28022":394,"_19417":46767,"_5":13306,"_25514":46634,"_2665":46768},[],"alert on orphan durable queues and backlog growth.",{"_3170":451,"_28022":394,"_19417":46770,"_5":13306,"_25514":46634,"_2665":46771},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3170":452,"_28022":394,"_19417":46773,"_5":13306,"_25514":46638,"_2665":46774},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_3170":453,"_28022":394,"_19417":46776,"_5":13306,"_25514":46638,"_2665":46777},[],"Before closing an incident, record:",{"_3170":454,"_28022":394,"_19417":46779,"_5":13306,"_25514":46638,"_2665":46780},[],"the confirmed cause;",{"_3170":455,"_28022":394,"_19417":46782,"_5":13306,"_25514":46638,"_2665":46783},[],"the time scope and affected resources;",{"_3170":456,"_28022":394,"_19417":46785,"_5":13306,"_25514":46638,"_2665":46786},[],"the commands or queries used;",{"_3170":457,"_28022":394,"_19417":46788,"_5":13306,"_25514":46638,"_2665":46789},[],"the applied change and how to revert it;",{"_3170":458,"_28022":394,"_19417":46791,"_5":13306,"_25514":46638,"_2665":46792},[],"validation from a consumer;",{"_3170":459,"_28022":394,"_19417":46794,"_5":13306,"_25514":46638,"_2665":46795},[],"the preventive action and its owner.",{"_3170":460,"_28022":460,"_5":13637,"_2665":46797,"_28344":46798,"_19417":46801,"_25514":460},"Access control",[45406,46799,46800],"Platform","Administration",[],{"_3170":461,"_28022":460,"_19417":46803,"_5":13306,"_25514":460,"_2665":46804},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3170":462,"_28022":460,"_5":28341,"_19417":46806,"_25514":46807,"_2665":46808},[],"/docs/platform/administration/access-control#essential-concepts","Essential concepts",{"_3170":463,"_28022":460,"_5":28341,"_19417":46810,"_25514":46811,"_2665":46812},[],"/docs/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3170":464,"_28022":460,"_5":28341,"_19417":46814,"_25514":46815,"_2665":46816},[],"/docs/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3170":465,"_28022":460,"_5":28341,"_19417":46818,"_25514":46819,"_2665":46820},[],"/docs/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3170":466,"_28022":460,"_5":28341,"_19417":46822,"_25514":46823,"_2665":46824},[],"/docs/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3170":467,"_28022":460,"_5":28341,"_19417":46826,"_25514":46827,"_2665":46828},[],"/docs/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3170":468,"_28022":460,"_5":28341,"_19417":46830,"_25514":46831,"_2665":46832},[],"/docs/platform/administration/access-control#oidc-principals","OIDC principals",{"_3170":469,"_28022":460,"_5":28341,"_19417":46834,"_25514":46835,"_2665":46836},[],"/docs/platform/administration/access-control#x509-principals","X.509 principals",{"_3170":470,"_28022":460,"_5":28341,"_19417":46838,"_25514":46839,"_2665":46840},[],"/docs/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3170":471,"_28022":460,"_5":28341,"_19417":46842,"_25514":46843,"_2665":46844},[],"/docs/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3170":472,"_28022":460,"_5":28341,"_19417":46846,"_25514":46847,"_2665":46848},[],"/docs/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3170":473,"_28022":460,"_5":28341,"_19417":46850,"_25514":46851,"_2665":46852},[],"/docs/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3170":474,"_28022":460,"_5":28341,"_19417":46854,"_25514":46855,"_2665":46856},[],"/docs/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3170":475,"_28022":460,"_5":28341,"_19417":46858,"_25514":46859,"_2665":46860},[],"/docs/platform/administration/access-control#http-rules","HTTP rules",{"_3170":476,"_28022":460,"_5":28341,"_19417":46862,"_25514":46863,"_2665":46864},[],"/docs/platform/administration/access-control#included-policies","Included policies",{"_3170":477,"_28022":460,"_5":28341,"_19417":46866,"_25514":46867,"_2665":46042},[],"/docs/platform/administration/access-control#provision-the-first-administrator",{"_3170":478,"_28022":460,"_5":28341,"_19417":46869,"_25514":46870,"_2665":46871},[],"/docs/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3170":479,"_28022":460,"_5":28341,"_19417":46873,"_25514":46874,"_2665":46875},[],"/docs/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3170":480,"_28022":460,"_5":28341,"_19417":46877,"_25514":46878,"_2665":46879},[],"/docs/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3170":481,"_28022":460,"_5":28341,"_19417":46881,"_25514":46882,"_2665":46883},[],"/docs/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3170":482,"_28022":460,"_5":28341,"_19417":46885,"_25514":46886,"_2665":46887},[],"/docs/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3170":483,"_28022":460,"_5":28341,"_19417":46889,"_25514":46890,"_2665":46891},[],"/docs/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3170":484,"_28022":460,"_5":28341,"_19417":46893,"_25514":46894,"_2665":46895},[],"/docs/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3170":485,"_28022":460,"_5":28341,"_19417":46897,"_25514":46898,"_2665":46899},[],"/docs/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3170":486,"_28022":460,"_5":28341,"_19417":46901,"_25514":46902,"_2665":46903},[],"/docs/platform/administration/access-control#operational-checklist","Operational checklist",{"_3170":487,"_28022":460,"_5":28341,"_19417":46905,"_25514":46906,"_2665":46907},[],"/docs/platform/administration/access-control#diagnostics","Diagnostics",{"_3170":488,"_28022":460,"_5":28341,"_19417":46909,"_25514":46910,"_2665":46911},[],"/docs/platform/administration/access-control#the-response-is-401","The response is 401",{"_3170":489,"_28022":460,"_5":28341,"_19417":46913,"_25514":46914,"_2665":46915},[],"/docs/platform/administration/access-control#the-response-is-403","The response is 403",{"_3170":490,"_28022":460,"_5":28341,"_19417":46917,"_25514":46918,"_2665":46919},[],"/docs/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3170":491,"_28022":460,"_5":28341,"_19417":46921,"_25514":46922,"_2665":46923},[],"/docs/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3170":492,"_28022":460,"_5":28341,"_19417":46925,"_25514":46926,"_2665":46927},[],"/docs/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3170":493,"_28022":460,"_19417":46929,"_5":13306,"_25514":460,"_2665":46930},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3170":494,"_28022":460,"_19417":46932,"_5":13306,"_25514":460,"_2665":46933},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3170":495,"_28022":460,"_19417":46935,"_5":13306,"_25514":460,"_2665":46936},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3170":496,"_28022":460,"_19417":46938,"_5":13306,"_25514":46807,"_2665":46939},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3170":497,"_28022":460,"_19417":46941,"_5":13306,"_25514":46807,"_2665":46942},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3170":498,"_28022":460,"_19417":46944,"_5":13306,"_25514":46807,"_2665":46945},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3170":499,"_28022":460,"_19417":46947,"_5":13306,"_25514":46807,"_2665":46948},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3170":500,"_28022":460,"_19417":46950,"_5":13306,"_25514":46807,"_2665":46951},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3170":501,"_28022":460,"_19417":46953,"_5":13306,"_25514":46807,"_2665":46954},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3170":502,"_28022":460,"_19417":46956,"_5":13306,"_25514":46811,"_2665":46957},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3170":503,"_28022":460,"_19417":46959,"_5":13306,"_25514":46811,"_2665":46960},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3170":504,"_28022":460,"_19417":46962,"_5":13306,"_25514":46815,"_2665":46963},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3170":505,"_28022":460,"_19417":46965,"_5":13306,"_25514":46815,"_2665":46966},[],"The decision is made **before forwarding the request to the service**:",{"_3170":506,"_28022":460,"_19417":46968,"_5":13306,"_25514":46815,"_2665":46969},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3170":507,"_28022":460,"_19417":46971,"_5":13306,"_25514":46815,"_2665":46972},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3170":508,"_28022":460,"_19417":46974,"_5":13306,"_25514":46815,"_2665":46975},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3170":509,"_28022":460,"_19417":46977,"_5":13306,"_25514":46815,"_2665":46978},[],"It separately loads the policies granted to each principal.",{"_3170":510,"_28022":460,"_19417":46980,"_5":13306,"_25514":46815,"_2665":46981},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3170":511,"_28022":460,"_19417":46983,"_5":13306,"_25514":46815,"_2665":46984},[],"`authz` looks for an HTTP rule granting that action.",{"_3170":512,"_28022":460,"_19417":46986,"_5":13306,"_25514":46815,"_2665":46987},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3170":513,"_28022":460,"_19417":46989,"_5":13306,"_25514":46815,"_2665":46990},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3170":514,"_28022":460,"_19417":46992,"_5":13306,"_25514":46815,"_2665":46993},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_3170":515,"_28022":460,"_19417":46995,"_5":13306,"_25514":46815,"_2665":46996},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3170":516,"_28022":460,"_19417":46998,"_5":13306,"_25514":46819,"_2665":46999},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3170":517,"_28022":460,"_19417":47001,"_5":13306,"_25514":46819,"_2665":47002},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3170":518,"_28022":460,"_19417":47004,"_5":13306,"_25514":46819,"_2665":47005},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3170":519,"_28022":460,"_19417":47007,"_5":13306,"_25514":46819,"_2665":47008},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3170":520,"_28022":460,"_19417":47010,"_5":13306,"_25514":46819,"_2665":47011},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3170":521,"_28022":460,"_19417":47013,"_5":13306,"_25514":46819,"_2665":47014},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3170":522,"_28022":460,"_19417":47016,"_5":13306,"_25514":46819,"_2665":47017},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3170":523,"_28022":460,"_19417":47019,"_5":13306,"_25514":46819,"_2665":47020},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3170":524,"_28022":460,"_19417":47022,"_5":13306,"_25514":46823,"_2665":47023},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3170":525,"_28022":460,"_19417":47025,"_5":13306,"_25514":46823,"_2665":47026},[],"The decision is made with the domain operation context:",{"_3170":526,"_28022":460,"_19417":47028,"_5":13306,"_25514":46823,"_2665":47029},[],"The middleware extracts the credential and resolves the matching principals.",{"_3170":527,"_28022":460,"_19417":47031,"_5":13306,"_25514":46823,"_2665":47032},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3170":528,"_28022":460,"_19417":47034,"_5":13306,"_25514":46823,"_2665":47035},[],"`authz` gathers the entity rules of the granted policies.",{"_3170":529,"_28022":460,"_19417":47037,"_5":13306,"_25514":46823,"_2665":47038},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3170":530,"_28022":460,"_19417":47040,"_5":13306,"_25514":46823,"_2665":47041},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3170":531,"_28022":460,"_19417":47043,"_5":13306,"_25514":46823,"_2665":47044},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3170":532,"_28022":460,"_19417":47046,"_5":13306,"_25514":46823,"_2665":47047},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3170":533,"_28022":460,"_19417":47049,"_5":13306,"_25514":46823,"_2665":47050},[],"Actions fall into two groups:",{"_3170":534,"_28022":460,"_19417":47052,"_5":13306,"_25514":46823,"_2665":47053},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3170":535,"_28022":460,"_19417":47055,"_5":13306,"_25514":46823,"_2665":47056},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3170":536,"_28022":460,"_19417":47058,"_5":13306,"_25514":46823,"_2665":47059},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3170":537,"_28022":460,"_19417":47061,"_5":13306,"_25514":46827,"_2665":47062},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3170":538,"_28022":460,"_19417":47064,"_5":13306,"_25514":46827,"_2665":47065},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3170":539,"_28022":460,"_19417":47067,"_5":13306,"_25514":46827,"_2665":47068},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3170":540,"_28022":460,"_19417":47070,"_5":13306,"_25514":46831,"_2665":47071},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3170":541,"_28022":460,"_19417":47073,"_5":13306,"_25514":46831,"_2665":47074},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3170":542,"_28022":460,"_19417":47076,"_5":13306,"_25514":46831,"_2665":47077},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3170":543,"_28022":460,"_19417":47079,"_5":13306,"_25514":46831,"_2665":47080},[],"The implemented operators are:",{"_3170":544,"_28022":460,"_19417":47082,"_5":13306,"_25514":46831,"_2665":47083},[],"`equals`, for exact equality;",{"_3170":545,"_28022":460,"_19417":47085,"_5":13306,"_25514":46831,"_2665":47086},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3170":546,"_28022":460,"_19417":47088,"_5":13306,"_25514":46831,"_2665":47089},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3170":547,"_28022":460,"_19417":47091,"_5":13306,"_25514":46831,"_2665":47092},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3170":548,"_28022":460,"_19417":47094,"_5":13306,"_25514":46835,"_2665":47095},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3170":549,"_28022":460,"_19417":47097,"_5":13306,"_25514":46835,"_2665":47098},[],"The available modes are:",{"_3170":550,"_28022":460,"_19417":47100,"_5":13306,"_25514":46835,"_2665":47101},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3170":551,"_28022":460,"_19417":47103,"_5":13306,"_25514":46835,"_2665":47104},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3170":552,"_28022":460,"_19417":47106,"_5":13306,"_25514":46835,"_2665":47107},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3170":553,"_28022":460,"_19417":47109,"_5":13306,"_25514":46835,"_2665":47110},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3170":554,"_28022":460,"_19417":47112,"_5":13306,"_25514":46835,"_2665":47113},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3170":555,"_28022":460,"_19417":47115,"_5":13306,"_25514":46835,"_2665":47116},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3170":556,"_28022":460,"_19417":47118,"_5":13306,"_25514":46839,"_2665":47119},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3170":557,"_28022":460,"_19417":47121,"_5":13306,"_25514":46839,"_2665":47122},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3170":558,"_28022":460,"_19417":47124,"_5":13306,"_25514":46839,"_2665":47125},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3170":559,"_28022":460,"_19417":47127,"_5":13306,"_25514":46839,"_2665":47128},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3170":560,"_28022":460,"_19417":47130,"_5":13306,"_25514":46847,"_2665":47131},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3170":561,"_28022":460,"_19417":47133,"_5":13306,"_25514":46847,"_2665":47134},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3170":562,"_28022":460,"_19417":47136,"_5":13306,"_25514":46851,"_2665":47137},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3170":563,"_28022":460,"_19417":47139,"_5":13306,"_25514":46851,"_2665":47140},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3170":564,"_28022":460,"_19417":47142,"_5":13306,"_25514":46855,"_2665":47143},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3170":565,"_28022":460,"_19417":47145,"_5":13306,"_25514":46855,"_2665":47146},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3170":566,"_28022":460,"_19417":47148,"_5":13306,"_25514":46855,"_2665":47149},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3170":567,"_28022":460,"_19417":47151,"_5":13306,"_25514":46859,"_2665":47152},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3170":568,"_28022":460,"_19417":47154,"_5":13306,"_25514":46859,"_2665":47155},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3170":569,"_28022":460,"_19417":47157,"_5":13306,"_25514":46859,"_2665":47158},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3170":570,"_28022":460,"_19417":47160,"_5":13306,"_25514":46859,"_2665":47161},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3170":571,"_28022":460,"_19417":47163,"_5":13306,"_25514":46859,"_2665":47164},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3170":572,"_28022":460,"_19417":47166,"_5":13306,"_25514":46859,"_2665":47167},[],"Note that:",{"_3170":573,"_28022":460,"_19417":47169,"_5":13306,"_25514":46859,"_2665":47170},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3170":574,"_28022":460,"_19417":47172,"_5":13306,"_25514":46859,"_2665":47173},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3170":575,"_28022":460,"_19417":47175,"_5":13306,"_25514":46859,"_2665":47176},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3170":576,"_28022":460,"_19417":47178,"_5":13306,"_25514":46863,"_2665":47179},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3170":577,"_28022":460,"_19417":47181,"_5":13306,"_25514":46863,"_2665":47182},[],"full and read-only access to certificates and authorities;",{"_3170":578,"_28022":460,"_19417":47184,"_5":13306,"_25514":46863,"_2665":47185},[],"full and read-only access to the KMS;",{"_3170":579,"_28022":460,"_19417":47187,"_5":13306,"_25514":46863,"_2665":47188},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3170":580,"_28022":460,"_19417":47190,"_5":13306,"_25514":46863,"_2665":47191},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3170":581,"_28022":460,"_19417":47193,"_5":13306,"_25514":46863,"_2665":47194},[],"console access;",{"_3170":582,"_28022":460,"_19417":47196,"_5":13306,"_25514":46863,"_2665":47197},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3170":583,"_28022":460,"_19417":47199,"_5":13306,"_25514":46863,"_2665":47200},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3170":584,"_28022":460,"_19417":47202,"_5":13306,"_25514":46863,"_2665":47203},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3170":585,"_28022":460,"_19417":47205,"_5":13306,"_25514":46867,"_2665":47206},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3170":586,"_28022":460,"_19417":47208,"_5":13306,"_25514":46867,"_2665":47209},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3170":587,"_28022":460,"_19417":47211,"_5":13306,"_25514":46867,"_2665":47212},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3170":588,"_28022":460,"_19417":47214,"_5":13306,"_25514":46870,"_2665":47215},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3170":589,"_28022":460,"_19417":47217,"_5":13306,"_25514":46874,"_2665":47218},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3170":590,"_28022":460,"_19417":47220,"_5":13306,"_25514":46874,"_2665":47221},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3170":591,"_28022":460,"_19417":47223,"_5":13306,"_25514":46878,"_2665":47224},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3170":592,"_28022":460,"_19417":47226,"_5":13306,"_25514":46882,"_2665":47227},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3170":593,"_28022":460,"_19417":47229,"_5":13306,"_25514":46886,"_2665":47230},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3170":594,"_28022":460,"_19417":47232,"_5":13306,"_25514":46890,"_2665":47233},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3170":595,"_28022":460,"_19417":47235,"_5":13306,"_25514":46890,"_2665":47236},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3170":596,"_28022":460,"_19417":47238,"_5":13306,"_25514":46894,"_2665":47239},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3170":597,"_28022":460,"_19417":47241,"_5":13306,"_25514":46894,"_2665":47242},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3170":598,"_28022":460,"_19417":47244,"_5":13306,"_25514":46894,"_2665":47245},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3170":599,"_28022":460,"_19417":47247,"_5":13306,"_25514":46894,"_2665":47248},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3170":600,"_28022":460,"_19417":47250,"_5":13306,"_25514":46894,"_2665":47251},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3170":601,"_28022":460,"_19417":47253,"_5":13306,"_25514":46894,"_2665":47254},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3170":602,"_28022":460,"_19417":47256,"_5":13306,"_25514":46894,"_2665":47257},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3170":603,"_28022":460,"_19417":47259,"_5":13306,"_25514":46894,"_2665":47260},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3170":604,"_28022":460,"_19417":47262,"_5":13306,"_25514":46898,"_2665":47263},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3170":605,"_28022":460,"_19417":47265,"_5":13306,"_25514":46898,"_2665":47266},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3170":606,"_28022":460,"_19417":47268,"_5":13306,"_25514":46898,"_2665":47269},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3170":607,"_28022":460,"_19417":47271,"_5":13306,"_25514":46902,"_2665":47272},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3170":608,"_28022":460,"_19417":47274,"_5":13306,"_25514":46902,"_2665":47275},[],"Use groups or stable roles for people and independent identities for automations.",{"_3170":609,"_28022":460,"_19417":47277,"_5":13306,"_25514":46902,"_2665":47278},[],"Keep at least two recovery administrators and test their access periodically.",{"_3170":610,"_28022":460,"_19417":47280,"_5":13306,"_25514":46902,"_2665":47281},[],"Review active principals, their matches and their grants after IdP changes.",{"_3170":611,"_28022":460,"_19417":47283,"_5":13306,"_25514":46902,"_2665":47284},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3170":612,"_28022":460,"_19417":47286,"_5":13306,"_25514":46902,"_2665":47287},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3170":613,"_28022":460,"_19417":47289,"_5":13306,"_25514":46902,"_2665":47290},[],"Always test one allowed and one denied operation for each role.",{"_3170":614,"_28022":460,"_19417":47292,"_5":13306,"_25514":46902,"_2665":47293},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3170":615,"_28022":460,"_19417":47295,"_5":13306,"_25514":46910,"_2665":47296},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3170":616,"_28022":460,"_19417":47298,"_5":13306,"_25514":46914,"_2665":47299},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3170":617,"_28022":460,"_19417":47301,"_5":13306,"_25514":46914,"_2665":47302},[],"that an active principal of the correct type exists;",{"_3170":618,"_28022":460,"_19417":47304,"_5":13306,"_25514":46914,"_2665":47305},[],"that the claim paths and values match the real token exactly;",{"_3170":619,"_28022":460,"_19417":47307,"_5":13306,"_25514":46914,"_2665":47308},[],"that all of the principal's conditions hold;",{"_3170":620,"_28022":460,"_19417":47310,"_5":13306,"_25514":46914,"_2665":47311},[],"that the principal has the expected policy granted;",{"_3170":621,"_28022":460,"_19417":47313,"_5":13306,"_25514":46914,"_2665":47314},[],"that the policy includes the action and the requested resource type or route;",{"_3170":622,"_28022":460,"_19417":47316,"_5":13306,"_25514":46914,"_2665":47317},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3170":623,"_28022":460,"_19417":47319,"_5":13306,"_25514":46914,"_2665":47320},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry instrumentation enabled, each decision also produces a span — `engine.CheckHTTP` on the Gateway path — whose attributes record `authz.allowed`, the matched policy and the matched principal, so you can correlate the denial with the Gateway trace.",{"_3170":624,"_28022":460,"_19417":47322,"_5":13306,"_25514":46918,"_2665":47323},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3170":625,"_28022":460,"_19417":47325,"_5":13306,"_25514":46922,"_2665":47326},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3170":626,"_28022":460,"_19417":47328,"_5":13306,"_25514":46926,"_2665":47329},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3170":627,"_28022":460,"_19417":47331,"_5":13306,"_25514":46926,"_2665":47332},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3170":628,"_28022":628,"_5":13637,"_2665":47334,"_28344":47335,"_19417":47336,"_25514":628},"Alerts and subscriptions",[45406,46799,46800],[],{"_3170":629,"_28022":628,"_19417":47338,"_5":13306,"_25514":628,"_2665":47339},[],"Send PKI events to people and external systems.",{"_3170":630,"_28022":628,"_5":28341,"_19417":47341,"_25514":47342,"_2665":47343},[],"/docs/platform/administration/alerts#how-it-works","How it works",{"_3170":631,"_28022":628,"_5":28341,"_19417":47345,"_25514":47346,"_2665":47347},[],"/docs/platform/administration/alerts#available-channels","Available channels",{"_3170":632,"_28022":628,"_5":28341,"_19417":47349,"_25514":47350,"_2665":47351},[],"/docs/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3170":633,"_28022":628,"_5":28341,"_19417":47353,"_25514":47354,"_2665":47355},[],"/docs/platform/administration/alerts#choose-the-event","Choose the event",{"_3170":634,"_28022":628,"_5":28341,"_19417":47357,"_25514":47358,"_2665":47359},[],"/docs/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3170":635,"_28022":628,"_5":28341,"_19417":47361,"_25514":47362,"_2665":47363},[],"/docs/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3170":636,"_28022":628,"_5":28341,"_19417":47365,"_25514":47366,"_2665":47367},[],"/docs/platform/administration/alerts#review-and-activate","Review and activate",{"_3170":637,"_28022":628,"_5":28341,"_19417":47369,"_25514":47370,"_2665":47371},[],"/docs/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3170":638,"_28022":628,"_5":28341,"_19417":47373,"_25514":47374,"_2665":47375},[],"/docs/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3170":639,"_28022":628,"_5":28341,"_19417":47377,"_25514":47378,"_2665":47379},[],"/docs/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3170":640,"_28022":628,"_5":28341,"_19417":47381,"_25514":47382,"_2665":47383},[],"/docs/platform/administration/alerts#event-families","Event families",{"_3170":641,"_28022":628,"_19417":47385,"_5":13306,"_25514":628,"_2665":47386},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3170":642,"_28022":628,"_19417":47388,"_5":13306,"_25514":47342,"_2665":47389},[],"A service publishes a domain event.",{"_3170":643,"_28022":628,"_19417":47391,"_5":13306,"_25514":47342,"_2665":47392},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3170":644,"_28022":628,"_19417":47394,"_5":13306,"_25514":47342,"_2665":47395},[],"Each subscription's filter decides whether it should be notified.",{"_3170":645,"_28022":628,"_19417":47397,"_5":13306,"_25514":47342,"_2665":47398},[],"Lamassu delivers the event to the configured channel.",{"_3170":646,"_28022":628,"_19417":47400,"_5":13306,"_25514":47342,"_2665":47401},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3170":647,"_28022":628,"_19417":47403,"_5":13306,"_25514":47346,"_2665":47404},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3170":648,"_28022":628,"_19417":47406,"_5":13306,"_25514":47346,"_2665":47407},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3170":649,"_28022":628,"_19417":47409,"_5":13306,"_25514":47346,"_2665":47410},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3170":650,"_28022":628,"_19417":47412,"_5":13306,"_25514":47346,"_2665":47413},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3170":651,"_28022":628,"_19417":47415,"_5":13306,"_25514":47346,"_2665":47416},[],"`apikey_options` requires `header` and `key`.",{"_3170":652,"_28022":628,"_19417":47418,"_5":13306,"_25514":47346,"_2665":47419},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3170":653,"_28022":628,"_19417":47421,"_5":13306,"_25514":47346,"_2665":47422},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3170":654,"_28022":628,"_19417":47424,"_5":13306,"_25514":47346,"_2665":47425},[],"The alerts API reference documents the full `http_client` schema.",{"_3170":655,"_28022":628,"_19417":47427,"_5":13306,"_25514":47354,"_2665":47428},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3170":656,"_28022":628,"_19417":47430,"_5":13306,"_25514":47358,"_2665":47431},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3170":657,"_28022":628,"_19417":47433,"_5":13306,"_25514":47362,"_2665":47434},[],"Add a filter if you don't want to receive every instance of the event.",{"_3170":658,"_28022":628,"_19417":47436,"_5":13306,"_25514":47362,"_2665":47437},[],"**None** notifies all instances of the event.",{"_3170":659,"_28022":628,"_19417":47439,"_5":13306,"_25514":47362,"_2665":47440},[],"**JSON Path** evaluates one or more specific fields.",{"_3170":660,"_28022":628,"_19417":47442,"_5":13306,"_25514":47362,"_2665":47443},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3170":661,"_28022":628,"_19417":47445,"_5":13306,"_25514":47362,"_2665":47446},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3170":662,"_28022":628,"_19417":47448,"_5":13306,"_25514":47362,"_2665":47449},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3170":663,"_28022":628,"_19417":47451,"_5":13306,"_25514":47366,"_2665":47452},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3170":664,"_28022":628,"_19417":47454,"_5":13306,"_25514":47370,"_2665":47455},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3170":665,"_28022":628,"_19417":47457,"_5":13306,"_25514":47370,"_2665":47458},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3170":666,"_28022":628,"_19417":47460,"_5":13306,"_25514":47370,"_2665":47461},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3170":667,"_28022":628,"_19417":47463,"_5":13306,"_25514":47370,"_2665":47464},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3170":668,"_28022":628,"_19417":47466,"_5":13306,"_25514":47370,"_2665":47467},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3170":669,"_28022":628,"_19417":47469,"_5":13306,"_25514":47370,"_2665":47470},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3170":670,"_28022":628,"_19417":47472,"_5":13306,"_25514":47370,"_2665":47473},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3170":671,"_28022":628,"_19417":47475,"_5":13306,"_25514":47370,"_2665":47476},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3170":672,"_28022":628,"_19417":47478,"_5":13306,"_25514":47374,"_2665":47479},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3170":673,"_28022":628,"_19417":47481,"_5":13306,"_25514":47374,"_2665":47482},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3170":674,"_28022":628,"_19417":47484,"_5":13306,"_25514":47374,"_2665":47485},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3170":675,"_28022":628,"_19417":47487,"_5":13306,"_25514":47374,"_2665":47488},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3170":676,"_28022":628,"_19417":47490,"_5":13306,"_25514":47374,"_2665":47491},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3170":677,"_28022":628,"_19417":47493,"_5":13306,"_25514":47374,"_2665":47494},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3170":678,"_28022":628,"_19417":47496,"_5":13306,"_25514":47374,"_2665":47497},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3170":679,"_28022":628,"_19417":47499,"_5":13306,"_25514":47374,"_2665":47500},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3170":680,"_28022":628,"_19417":47502,"_5":13306,"_25514":47378,"_2665":47503},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3170":681,"_28022":628,"_19417":47505,"_5":13306,"_25514":47378,"_2665":47506},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3170":682,"_28022":628,"_19417":47508,"_5":13306,"_25514":47382,"_2665":47509},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3170":683,"_28022":628,"_19417":47511,"_5":13306,"_25514":47382,"_2665":47512},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3170":684,"_28022":628,"_19417":47514,"_5":13306,"_25514":47382,"_2665":47515},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3170":685,"_28022":628,"_19417":47517,"_5":13306,"_25514":47382,"_2665":47518},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3170":686,"_28022":628,"_19417":47520,"_5":13306,"_25514":47382,"_2665":47521},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3170":687,"_28022":628,"_19417":47523,"_5":13306,"_25514":47382,"_2665":47524},[],"**Validation:** `va.role.crl.create`.",{"_3170":688,"_28022":628,"_19417":47526,"_5":13306,"_25514":47382,"_2665":47527},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3170":689,"_28022":628,"_19417":47529,"_5":13306,"_25514":47382,"_2665":47530},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3170":690,"_28022":690,"_5":13637,"_2665":47532,"_28344":47533,"_19417":47534,"_25514":690},"Audit logs",[45406,46799,46800],[],{"_3170":691,"_28022":690,"_19417":47536,"_5":13306,"_25514":690,"_2665":47537},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3170":692,"_28022":690,"_5":28341,"_19417":47539,"_25514":47540,"_2665":47541},[],"/docs/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3170":693,"_28022":690,"_5":28341,"_19417":47543,"_25514":47544,"_2665":47545},[],"/docs/platform/administration/audit-logs#coverage","Coverage",{"_3170":694,"_28022":690,"_5":28341,"_19417":47547,"_25514":47548,"_2665":47549},[],"/docs/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3170":695,"_28022":690,"_5":28341,"_19417":47551,"_25514":47552,"_2665":47553},[],"/docs/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3170":696,"_28022":690,"_5":28341,"_19417":47555,"_25514":47556,"_2665":47557},[],"/docs/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3170":697,"_28022":690,"_5":28341,"_19417":47559,"_25514":47560,"_2665":47561},[],"/docs/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3170":698,"_28022":690,"_5":28341,"_19417":47563,"_25514":47564,"_2665":47565},[],"/docs/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3170":699,"_28022":690,"_5":28341,"_19417":47567,"_25514":47568,"_2665":47569},[],"/docs/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3170":700,"_28022":690,"_5":28341,"_19417":47571,"_25514":47572,"_2665":47573},[],"/docs/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3170":701,"_28022":690,"_5":28341,"_19417":47575,"_25514":47576,"_2665":47577},[],"/docs/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3170":702,"_28022":690,"_5":28341,"_19417":47579,"_25514":47580,"_2665":47581},[],"/docs/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3170":703,"_28022":690,"_19417":47583,"_5":13306,"_25514":690,"_2665":47584},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3170":704,"_28022":690,"_19417":47586,"_5":13306,"_25514":47540,"_2665":47587},[],"The audit body includes:",{"_3170":705,"_28022":690,"_19417":47589,"_5":13306,"_25514":47540,"_2665":47590},[],"input: data received by the operation;",{"_3170":706,"_28022":690,"_19417":47592,"_5":13306,"_25514":47540,"_2665":47593},[],"has\\_error: whether the service returned an error;",{"_3170":707,"_28022":690,"_19417":47595,"_5":13306,"_25514":47540,"_2665":47596},[],"output: produced result or error message;",{"_3170":708,"_28022":690,"_19417":47598,"_5":13306,"_25514":47540,"_2665":47599},[],"principals: identifiers of the principals that matched the request.",{"_3170":709,"_28022":690,"_19417":47601,"_5":13306,"_25514":47540,"_2665":47602},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3170":710,"_28022":690,"_19417":47604,"_5":13306,"_25514":47540,"_2665":47605},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3170":711,"_28022":690,"_19417":47607,"_5":13306,"_25514":47544,"_2665":47608},[],"The backend applies auditing to mutations of:",{"_3170":712,"_28022":690,"_19417":47610,"_5":13306,"_25514":47544,"_2665":47611},[],"authorities, certificates and issuance profiles;",{"_3170":713,"_28022":690,"_19417":47613,"_5":13306,"_25514":47544,"_2665":47614},[],"keys and KMS engines;",{"_3170":714,"_28022":690,"_19417":47616,"_5":13306,"_25514":47544,"_2665":47617},[],"devices and identities;",{"_3170":715,"_28022":690,"_19417":47619,"_5":13306,"_25514":47544,"_2665":47620},[],"DMSs and enrollment operations;",{"_3170":716,"_28022":690,"_19417":47622,"_5":13306,"_25514":47544,"_2665":47623},[],"validation functions and CRL;",{"_3170":717,"_28022":690,"_19417":47625,"_5":13306,"_25514":47544,"_2665":47626},[],"principals, policies and authorization grants.",{"_3170":718,"_28022":690,"_19417":47628,"_5":13306,"_25514":47544,"_2665":47629},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3170":719,"_28022":690,"_19417":47631,"_5":13306,"_25514":47548,"_2665":47632},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3170":720,"_28022":690,"_19417":47634,"_5":13306,"_25514":47548,"_2665":47635},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3170":721,"_28022":690,"_19417":47637,"_5":13306,"_25514":47548,"_2665":47638},[],"Design the consumer to:",{"_3170":722,"_28022":690,"_19417":47640,"_5":13306,"_25514":47548,"_2665":47641},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3170":723,"_28022":690,"_19417":47643,"_5":13306,"_25514":47548,"_2665":47644},[],"keep the complete CloudEvent unmodified;",{"_3170":724,"_28022":690,"_19417":47646,"_5":13306,"_25514":47548,"_2665":47647},[],"record the ingestion time and detect duplicates by ID;",{"_3170":725,"_28022":690,"_19417":47649,"_5":13306,"_25514":47548,"_2665":47650},[],"encrypt in transit and at rest;",{"_3170":726,"_28022":690,"_19417":47652,"_5":13306,"_25514":47548,"_2665":47653},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3170":727,"_28022":690,"_19417":47655,"_5":13306,"_25514":47548,"_2665":47656},[],"apply an explicit retention and legal hold policy;",{"_3170":728,"_28022":690,"_19417":47658,"_5":13306,"_25514":47548,"_2665":47659},[],"alert if it stops consuming or the pending queue grows.",{"_3170":729,"_28022":690,"_19417":47661,"_5":13306,"_25514":47552,"_2665":47662},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3170":730,"_28022":690,"_19417":47664,"_5":13306,"_25514":47552,"_2665":47665},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3170":731,"_28022":690,"_19417":47667,"_5":13306,"_25514":47560,"_2665":47668},[],"Start from the reported time and normalize every source to UTC.",{"_3170":732,"_28022":690,"_19417":47670,"_5":13306,"_25514":47564,"_2665":47671},[],"Filter by event type, service source and resource identifier.",{"_3170":733,"_28022":690,"_19417":47673,"_5":13306,"_25514":47568,"_2665":47674},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3170":734,"_28022":690,"_19417":47676,"_5":13306,"_25514":47572,"_2665":47677},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3170":735,"_28022":690,"_19417":47679,"_5":13306,"_25514":47576,"_2665":47680},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3170":736,"_28022":690,"_19417":47682,"_5":13306,"_25514":47580,"_2665":47683},[],"Generate a controlled mutation in a test environment and check that:",{"_3170":737,"_28022":690,"_19417":47685,"_5":13306,"_25514":47580,"_2665":47686},[],"a successful audit event appears;",{"_3170":738,"_28022":690,"_19417":47688,"_5":13306,"_25514":47580,"_2665":47689},[],"the principal matches the identity used;",{"_3170":739,"_28022":690,"_19417":47691,"_5":13306,"_25514":47580,"_2665":47692},[],"the consumer persists it exactly once;",{"_3170":740,"_28022":690,"_19417":47694,"_5":13306,"_25514":47580,"_2665":47695},[],"it can be retrieved by resource, actor and period;",{"_3170":741,"_28022":690,"_19417":47697,"_5":13306,"_25514":47580,"_2665":47698},[],"a consumer outage raises an alert.",{"_3170":742,"_28022":690,"_19417":47700,"_5":13306,"_25514":47580,"_2665":47701},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3170":743,"_28022":743,"_5":13637,"_2665":47703,"_28344":47704,"_19417":47705,"_25514":743},"Platform architecture",[45406,46799],[],{"_3170":744,"_28022":743,"_19417":47707,"_5":13306,"_25514":743,"_2665":47708},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3170":745,"_28022":743,"_5":28341,"_19417":47710,"_25514":47711,"_2665":47712},[],"/docs/platform/concepts/architecture#control-plane","Control plane",{"_3170":746,"_28022":743,"_5":28341,"_19417":47714,"_25514":47715,"_2665":47716},[],"/docs/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3170":747,"_28022":743,"_5":28341,"_19417":47718,"_25514":47719,"_2665":47720},[],"/docs/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3170":748,"_28022":743,"_5":28341,"_19417":47722,"_25514":47723,"_2665":47724},[],"/docs/platform/concepts/architecture#status-and-validation","Status and validation",{"_3170":749,"_28022":743,"_5":28341,"_19417":47726,"_25514":47727,"_2665":47728},[],"/docs/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3170":750,"_28022":743,"_19417":47730,"_5":13306,"_25514":743,"_2665":47731},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3170":751,"_28022":743,"_19417":47733,"_5":13306,"_25514":743,"_2665":47734},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3170":752,"_28022":743,"_19417":47736,"_5":13306,"_25514":47711,"_2665":47737},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3170":753,"_28022":743,"_19417":47739,"_5":13306,"_25514":47715,"_2665":47740},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3170":754,"_28022":743,"_19417":47742,"_5":13306,"_25514":47719,"_2665":47743},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3170":755,"_28022":743,"_19417":47745,"_5":13306,"_25514":47723,"_2665":47746},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3170":756,"_28022":743,"_19417":47748,"_5":13306,"_25514":47727,"_2665":47749},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3170":757,"_28022":757,"_5":13637,"_2665":47751,"_28344":47752,"_19417":47753,"_25514":757},"How Lamassu works",[45406,46799],[],{"_3170":758,"_28022":757,"_19417":47755,"_5":13306,"_25514":757,"_2665":47756},[],"The mental model of trust, keys, certificates and devices.",{"_3170":759,"_28022":757,"_5":28341,"_19417":47758,"_25514":47759,"_2665":47760},[],"/docs/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3170":760,"_28022":757,"_5":28341,"_19417":47762,"_25514":47763,"_2665":47764},[],"/docs/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3170":761,"_28022":757,"_19417":47766,"_5":13306,"_25514":757,"_2665":47767},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3170":762,"_28022":757,"_19417":47769,"_5":13306,"_25514":47759,"_2665":47770},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3170":763,"_28022":757,"_19417":47772,"_5":13306,"_25514":47759,"_2665":47773},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3170":764,"_28022":757,"_19417":47775,"_5":13306,"_25514":47759,"_2665":47776},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3170":765,"_28022":757,"_19417":47778,"_5":13306,"_25514":47759,"_2665":47779},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3170":766,"_28022":757,"_19417":47781,"_5":13306,"_25514":47759,"_2665":47782},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3170":767,"_28022":757,"_19417":47784,"_5":13306,"_25514":47763,"_2665":47785},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3170":768,"_28022":757,"_19417":47787,"_5":13306,"_25514":47763,"_2665":47788},[],"A DMS relates that CA to an enrollment policy.",{"_3170":769,"_28022":757,"_19417":47790,"_5":13306,"_25514":47763,"_2665":47791},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3170":770,"_28022":757,"_19417":47793,"_5":13306,"_25514":47763,"_2665":47794},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3170":771,"_28022":757,"_19417":47796,"_5":13306,"_25514":47763,"_2665":47797},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3170":772,"_28022":757,"_19417":47799,"_5":13306,"_25514":47763,"_2665":47800},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3170":773,"_28022":757,"_19417":47802,"_5":13306,"_25514":47763,"_2665":47803},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3170":774,"_28022":774,"_5":13637,"_2665":47805,"_28344":47806,"_19417":47808,"_25514":774},"Devices and identities",[45406,46799,47807,47805],"IoT Fleets",[],{"_3170":775,"_28022":774,"_19417":47810,"_5":13306,"_25514":774,"_2665":47811},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3170":776,"_28022":774,"_5":28341,"_19417":47813,"_25514":47814,"_2665":47815},[],"/docs/platform/iot-fleets/device-management#device-states","Device states",{"_3170":777,"_28022":774,"_5":28341,"_19417":47817,"_25514":47818,"_2665":47819},[],"/docs/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3170":778,"_28022":774,"_5":28341,"_19417":47821,"_25514":47822,"_2665":47823},[],"/docs/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3170":779,"_28022":774,"_5":28341,"_19417":47825,"_25514":47826,"_2665":47827},[],"/docs/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3170":780,"_28022":774,"_5":28341,"_19417":47829,"_25514":47830,"_2665":47831},[],"/docs/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3170":781,"_28022":774,"_5":28341,"_19417":47833,"_25514":47834,"_2665":47835},[],"/docs/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3170":782,"_28022":774,"_5":28341,"_19417":47837,"_25514":47838,"_2665":47839},[],"/docs/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3170":783,"_28022":774,"_5":28341,"_19417":47841,"_25514":47842,"_2665":47843},[],"/docs/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3170":784,"_28022":774,"_5":28341,"_19417":47845,"_25514":47846,"_2665":47847},[],"/docs/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3170":785,"_28022":774,"_5":28341,"_19417":47849,"_25514":47850,"_2665":47851},[],"/docs/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3170":786,"_28022":774,"_5":28341,"_19417":47853,"_25514":47854,"_2665":47855},[],"/docs/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3170":787,"_28022":774,"_19417":47857,"_5":13306,"_25514":774,"_2665":47858},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3170":788,"_28022":774,"_19417":47860,"_5":13306,"_25514":774,"_2665":47861},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3170":789,"_28022":774,"_19417":47863,"_5":13306,"_25514":47814,"_2665":47864},[],"Operational view",{"_3170":790,"_28022":774,"_19417":47866,"_5":13306,"_25514":47814,"_2665":47867},[],"Meaning",{"_3170":791,"_28022":774,"_19417":47869,"_5":13306,"_25514":47814,"_2665":47870},[],"**No Identity**",{"_3170":792,"_28022":774,"_19417":47872,"_5":13306,"_25514":47814,"_2665":47873},[],"A record exists without an associated identity.",{"_3170":793,"_28022":774,"_19417":47875,"_5":13306,"_25514":47814,"_2665":47876},[],"**Active**",{"_3170":794,"_28022":774,"_19417":47878,"_5":13306,"_25514":47814,"_2665":47879},[],"The slot is active; also check certificate dates, status and usages.",{"_3170":795,"_28022":774,"_19417":47881,"_5":13306,"_25514":47814,"_2665":47882},[],"**Renewal Pending**",{"_3170":796,"_28022":774,"_19417":47884,"_5":13306,"_25514":47814,"_2665":47885},[],"The identity is in the operational renewal window.",{"_3170":797,"_28022":774,"_19417":47887,"_5":13306,"_25514":47814,"_2665":47888},[],"**Expiring Soon**",{"_3170":798,"_28022":774,"_19417":47890,"_5":13306,"_25514":47814,"_2665":47891},[],"Expiration is approaching according to configured thresholds.",{"_3170":799,"_28022":774,"_19417":47893,"_5":13306,"_25514":47814,"_2665":47894},[],"**Expired**",{"_3170":800,"_28022":774,"_19417":47896,"_5":13306,"_25514":47814,"_2665":47897},[],"The identity has expired.",{"_3170":801,"_28022":774,"_19417":47899,"_5":13306,"_25514":47814,"_2665":47900},[],"**Revoked**",{"_3170":802,"_28022":774,"_19417":47902,"_5":13306,"_25514":47814,"_2665":47903},[],"The identity is marked revoked.",{"_3170":803,"_28022":774,"_19417":47905,"_5":13306,"_25514":47814,"_2665":47906},[],"**Decommissioned**",{"_3170":804,"_28022":774,"_19417":47908,"_5":13306,"_25514":47814,"_2665":47909},[],"The record is retired and ordinary updates do not restore operation.",{"_3170":805,"_28022":774,"_19417":47911,"_5":13306,"_25514":47814,"_2665":47912},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3170":806,"_28022":774,"_19417":47914,"_5":13306,"_25514":47818,"_2665":47915},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3170":807,"_28022":774,"_19417":47917,"_5":13306,"_25514":47818,"_2665":47918},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3170":808,"_28022":774,"_19417":47920,"_5":13306,"_25514":47818,"_2665":47921},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3170":809,"_28022":774,"_19417":47923,"_5":13306,"_25514":47818,"_2665":47924},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3170":810,"_28022":774,"_19417":47926,"_5":13306,"_25514":47822,"_2665":47927},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3170":811,"_28022":774,"_19417":47929,"_5":13306,"_25514":47826,"_2665":47930},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3170":812,"_28022":774,"_19417":47932,"_5":13306,"_25514":47830,"_2665":47933},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3170":813,"_28022":774,"_19417":47935,"_5":13306,"_25514":47834,"_2665":47936},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3170":814,"_28022":774,"_19417":47938,"_5":13306,"_25514":47838,"_2665":47939},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3170":815,"_28022":774,"_19417":47941,"_5":13306,"_25514":47838,"_2665":47942},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3170":816,"_28022":774,"_19417":47944,"_5":13306,"_25514":47842,"_2665":47945},[],"From **No Identity**, use **Assign Identity**:",{"_3170":817,"_28022":774,"_19417":47947,"_5":13306,"_25514":47842,"_2665":47948},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3170":818,"_28022":774,"_19417":47950,"_5":13306,"_25514":47842,"_2665":47951},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3170":819,"_28022":774,"_19417":47953,"_5":13306,"_25514":47842,"_2665":47954},[],"Confirm and read the serial, active version and history again.",{"_3170":820,"_28022":774,"_19417":47956,"_5":13306,"_25514":47842,"_2665":47957},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3170":821,"_28022":774,"_19417":47959,"_5":13306,"_25514":47842,"_2665":47960},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3170":822,"_28022":774,"_19417":47962,"_5":13306,"_25514":47846,"_2665":47963},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3170":823,"_28022":774,"_19417":47965,"_5":13306,"_25514":47846,"_2665":47966},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3170":824,"_28022":774,"_19417":47968,"_5":13306,"_25514":47850,"_2665":47969},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3170":825,"_28022":774,"_19417":47971,"_5":13306,"_25514":47850,"_2665":47972},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3170":826,"_28022":774,"_19417":47974,"_5":13306,"_25514":47850,"_2665":47975},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3170":827,"_28022":774,"_19417":47977,"_5":13306,"_25514":47850,"_2665":47978},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3170":828,"_28022":774,"_19417":47980,"_5":13306,"_25514":47854,"_2665":47981},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3170":829,"_28022":774,"_19417":47983,"_5":13306,"_25514":47854,"_2665":47984},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3170":830,"_28022":830,"_5":13637,"_2665":47986,"_28344":47987,"_19417":47989,"_25514":830},"Bootstrap identity and authentication",[45406,46799,47807,47805,47988],"Enrollment with PKI",[],{"_3170":831,"_28022":830,"_19417":47991,"_5":13306,"_25514":830,"_2665":47992},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3170":832,"_28022":830,"_5":28341,"_19417":47994,"_25514":47995,"_2665":47996},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3170":833,"_28022":830,"_5":28341,"_19417":47998,"_25514":47999,"_2665":48000},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3170":834,"_28022":830,"_5":28341,"_19417":48002,"_25514":48003,"_2665":48004},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3170":835,"_28022":830,"_5":28341,"_19417":48006,"_25514":48007,"_2665":48008},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3170":836,"_28022":830,"_5":28341,"_19417":48010,"_25514":48011,"_2665":48012},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3170":837,"_28022":830,"_19417":48014,"_5":13306,"_25514":830,"_2665":48015},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3170":838,"_28022":830,"_19417":48017,"_5":13306,"_25514":47995,"_2665":48018},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3170":839,"_28022":830,"_19417":48020,"_5":13306,"_25514":47995,"_2665":48021},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3170":840,"_28022":830,"_19417":48023,"_5":13306,"_25514":47999,"_2665":48024},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3170":841,"_28022":830,"_19417":48026,"_5":13306,"_25514":47999,"_2665":48027},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3170":842,"_28022":830,"_19417":48029,"_5":13306,"_25514":47999,"_2665":48030},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3170":843,"_28022":830,"_19417":48032,"_5":13306,"_25514":48003,"_2665":48033},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3170":844,"_28022":830,"_19417":48035,"_5":13306,"_25514":48003,"_2665":48036},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3170":845,"_28022":830,"_19417":48038,"_5":13306,"_25514":48007,"_2665":48039},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3170":846,"_28022":830,"_19417":48041,"_5":13306,"_25514":48007,"_2665":48042},[],"Example body:",{"_3170":847,"_28022":830,"_19417":48044,"_5":13306,"_25514":48007,"_2665":48045},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3170":848,"_28022":830,"_19417":48047,"_5":13306,"_25514":48007,"_2665":48048},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3170":849,"_28022":830,"_19417":48050,"_5":13306,"_25514":48007,"_2665":48051},[],"Continuation requires a successful HTTP response and JSON:",{"_3170":850,"_28022":830,"_19417":48053,"_5":13306,"_25514":48007,"_2665":48054},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3170":851,"_28022":830,"_19417":48056,"_5":13306,"_25514":48011,"_2665":48057},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3170":852,"_28022":830,"_19417":48059,"_5":13306,"_25514":48011,"_2665":48060},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3170":853,"_28022":853,"_5":13637,"_2665":48062,"_28344":48063,"_19417":48064,"_25514":853},"Configure and operate the DMS",[45406,46799,47807,47805,47988],[],{"_3170":854,"_28022":853,"_19417":48066,"_5":13306,"_25514":853,"_2665":48067},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3170":855,"_28022":853,"_5":28341,"_19417":48069,"_25514":48070,"_2665":45416},[],"/docs/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3170":856,"_28022":853,"_5":28341,"_19417":48072,"_25514":48073,"_2665":48074},[],"/docs/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3170":857,"_28022":853,"_5":28341,"_19417":48076,"_25514":48077,"_2665":48078},[],"/docs/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3170":858,"_28022":853,"_5":28341,"_19417":48080,"_25514":48081,"_2665":48082},[],"/docs/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3170":859,"_28022":853,"_5":28341,"_19417":48084,"_25514":48085,"_2665":48086},[],"/docs/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3170":860,"_28022":853,"_5":28341,"_19417":48088,"_25514":48089,"_2665":48090},[],"/docs/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3170":861,"_28022":853,"_5":28341,"_19417":48092,"_25514":48093,"_2665":48094},[],"/docs/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3170":862,"_28022":853,"_5":28341,"_19417":48096,"_25514":48097,"_2665":48098},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3170":863,"_28022":853,"_5":28341,"_19417":48100,"_25514":48101,"_2665":48102},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3170":864,"_28022":853,"_5":28341,"_19417":48104,"_25514":48105,"_2665":48106},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3170":865,"_28022":853,"_5":28341,"_19417":48108,"_25514":48109,"_2665":48110},[],"/docs/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3170":866,"_28022":853,"_5":28341,"_19417":48112,"_25514":48113,"_2665":48114},[],"/docs/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3170":867,"_28022":853,"_5":28341,"_19417":48116,"_25514":48117,"_2665":48118},[],"/docs/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3170":868,"_28022":853,"_5":28341,"_19417":48120,"_25514":48121,"_2665":48122},[],"/docs/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3170":869,"_28022":853,"_5":28341,"_19417":48124,"_25514":48125,"_2665":48126},[],"/docs/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3170":870,"_28022":853,"_5":28341,"_19417":48128,"_25514":48129,"_2665":48130},[],"/docs/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3170":871,"_28022":853,"_5":28341,"_19417":48132,"_25514":48133,"_2665":48134},[],"/docs/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3170":872,"_28022":853,"_5":28341,"_19417":48136,"_25514":48137,"_2665":48138},[],"/docs/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3170":873,"_28022":853,"_19417":48140,"_5":13306,"_25514":853,"_2665":48141},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3170":874,"_28022":853,"_19417":48143,"_5":13306,"_25514":48070,"_2665":48144},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3170":875,"_28022":853,"_19417":48146,"_5":13306,"_25514":48070,"_2665":48147},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3170":876,"_28022":853,"_19417":48149,"_5":13306,"_25514":48077,"_2665":48150},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3170":877,"_28022":853,"_19417":48152,"_5":13306,"_25514":48081,"_2665":48153},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3170":878,"_28022":853,"_19417":48155,"_5":13306,"_25514":48085,"_2665":48156},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3170":879,"_28022":853,"_19417":48158,"_5":13306,"_25514":48089,"_2665":48159},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3170":880,"_28022":853,"_19417":48161,"_5":13306,"_25514":48093,"_2665":48162},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3170":881,"_28022":853,"_19417":48164,"_5":13306,"_25514":48101,"_2665":48165},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3170":882,"_28022":853,"_19417":48167,"_5":13306,"_25514":48101,"_2665":48168},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3170":883,"_28022":853,"_19417":48170,"_5":13306,"_25514":48105,"_2665":48171},[],"`settings.enrollment_settings` field",{"_3170":884,"_28022":853,"_19417":48173,"_5":13306,"_25514":48105,"_2665":48174},[],"Decision",{"_3170":885,"_28022":853,"_19417":48176,"_5":13306,"_25514":48105,"_2665":48177},[],"`protocol`",{"_3170":886,"_28022":853,"_19417":48179,"_5":13306,"_25514":48105,"_2665":48180},[],"`EST_RFC7030` for these operations.",{"_3170":887,"_28022":853,"_19417":48182,"_5":13306,"_25514":48105,"_2665":48183},[],"`enrollment_ca`",{"_3170":888,"_28022":853,"_19417":48185,"_5":13306,"_25514":48105,"_2665":48186},[],"ID of the signing CA.",{"_3170":889,"_28022":853,"_19417":48188,"_5":13306,"_25514":48105,"_2665":48189},[],"`verify_csr_signature`",{"_3170":890,"_28022":853,"_19417":48191,"_5":13306,"_25514":48105,"_2665":48192},[],"Keep `true` to verify CSR key possession.",{"_3170":891,"_28022":853,"_19417":48194,"_5":13306,"_25514":48105,"_2665":48195},[],"`enable_replaceable_enrollment`",{"_3170":892,"_28022":853,"_19417":48197,"_5":13306,"_25514":48105,"_2665":48198},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3170":893,"_28022":853,"_19417":48200,"_5":13306,"_25514":48105,"_2665":48201},[],"`est_rfc7030_settings.auth_mode`",{"_3170":894,"_28022":853,"_19417":48203,"_5":13306,"_25514":48105,"_2665":48204},[],"One of the four authentication modes.",{"_3170":895,"_28022":853,"_19417":48206,"_5":13306,"_25514":48105,"_2665":48207},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3170":896,"_28022":853,"_19417":48209,"_5":13306,"_25514":48109,"_2665":48210},[],"The blocks are independent:",{"_3170":897,"_28022":853,"_19417":48212,"_5":13306,"_25514":48109,"_2665":48213},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3170":898,"_28022":853,"_19417":48215,"_5":13306,"_25514":48109,"_2665":48216},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3170":899,"_28022":853,"_19417":48218,"_5":13306,"_25514":48109,"_2665":48219},[],"`auth_mode`",{"_3170":900,"_28022":853,"_19417":48221,"_5":13306,"_25514":48109,"_2665":48222},[],"Control applied in the configured operation",{"_3170":901,"_28022":853,"_19417":48224,"_5":13306,"_25514":48109,"_2665":48225},[],"`CLIENT_CERTIFICATE`",{"_3170":902,"_28022":853,"_19417":48227,"_5":13306,"_25514":48109,"_2665":48228},[],"Presented certificate validation.",{"_3170":903,"_28022":853,"_19417":48230,"_5":13306,"_25514":48109,"_2665":48231},[],"`EXTERNAL_WEBHOOK`",{"_3170":904,"_28022":853,"_19417":48233,"_5":13306,"_25514":48109,"_2665":48234},[],"Configured webhook authorization.",{"_3170":905,"_28022":853,"_19417":48236,"_5":13306,"_25514":48109,"_2665":48237},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3170":906,"_28022":853,"_19417":48239,"_5":13306,"_25514":48109,"_2665":48240},[],"Certificate validation followed by webhook approval.",{"_3170":907,"_28022":853,"_19417":48242,"_5":13306,"_25514":48109,"_2665":48243},[],"`NO_AUTH`",{"_3170":908,"_28022":853,"_19417":48245,"_5":13306,"_25514":48109,"_2665":48246},[],"No DMS requester authentication.",{"_3170":909,"_28022":853,"_19417":48248,"_5":13306,"_25514":48109,"_2665":48249},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3170":910,"_28022":853,"_19417":48251,"_5":13306,"_25514":48109,"_2665":48252},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3170":911,"_28022":853,"_19417":48254,"_5":13306,"_25514":48109,"_2665":48255},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3170":912,"_28022":853,"_19417":48257,"_5":13306,"_25514":48109,"_2665":48258},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3170":913,"_28022":853,"_19417":48260,"_5":13306,"_25514":48113,"_2665":48261},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3170":914,"_28022":853,"_19417":48263,"_5":13306,"_25514":48113,"_2665":48264},[],"`external_webhook_settings` field",{"_3170":915,"_28022":853,"_19417":48266,"_5":13306,"_25514":48113,"_2665":48174},[],{"_3170":916,"_28022":853,"_19417":48268,"_5":13306,"_25514":48113,"_2665":48269},[],"`url`",{"_3170":917,"_28022":853,"_19417":48271,"_5":13306,"_25514":48113,"_2665":48272},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3170":918,"_28022":853,"_19417":48274,"_5":13306,"_25514":48113,"_2665":48275},[],"`method`",{"_3170":919,"_28022":853,"_19417":48277,"_5":13306,"_25514":48113,"_2665":48278},[],"`POST` or `PUT`; `POST` by default.",{"_3170":920,"_28022":853,"_19417":48280,"_5":13306,"_25514":48113,"_2665":48281},[],"`name`",{"_3170":921,"_28022":853,"_19417":48283,"_5":13306,"_25514":48113,"_2665":48284},[],"Label used in service logs.",{"_3170":922,"_28022":853,"_19417":48286,"_5":13306,"_25514":48113,"_2665":48287},[],"`config.auth_mode`",{"_3170":923,"_28022":853,"_19417":48289,"_5":13306,"_25514":48113,"_2665":48290},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3170":924,"_28022":853,"_19417":48292,"_5":13306,"_25514":48113,"_2665":48293},[],"`config.log_level`",{"_3170":925,"_28022":853,"_19417":48295,"_5":13306,"_25514":48113,"_2665":48296},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3170":926,"_28022":853,"_19417":48298,"_5":13306,"_25514":48113,"_2665":48299},[],"`config.apikey_options`",{"_3170":927,"_28022":853,"_19417":48301,"_5":13306,"_25514":48113,"_2665":48302},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3170":928,"_28022":853,"_19417":48304,"_5":13306,"_25514":48113,"_2665":48305},[],"`config.jwt_options`",{"_3170":929,"_28022":853,"_19417":48307,"_5":13306,"_25514":48113,"_2665":48308},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3170":930,"_28022":853,"_19417":48310,"_5":13306,"_25514":48113,"_2665":48311},[],"`config.mtls_options`",{"_3170":931,"_28022":853,"_19417":48313,"_5":13306,"_25514":48113,"_2665":48314},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3170":932,"_28022":853,"_19417":48316,"_5":13306,"_25514":48113,"_2665":48317},[],"`config.insecure_skip_verify`",{"_3170":933,"_28022":853,"_19417":48319,"_5":13306,"_25514":48113,"_2665":48320},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3170":934,"_28022":853,"_19417":48322,"_5":13306,"_25514":48113,"_2665":48323},[],"`config.call_timeout`",{"_3170":935,"_28022":853,"_19417":48325,"_5":13306,"_25514":48113,"_2665":48326},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3170":936,"_28022":853,"_19417":48328,"_5":13306,"_25514":48113,"_2665":48329},[],"Rules for that configuration:",{"_3170":937,"_28022":853,"_19417":48331,"_5":13306,"_25514":48113,"_2665":48332},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3170":938,"_28022":853,"_19417":48334,"_5":13306,"_25514":48113,"_2665":48335},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3170":939,"_28022":853,"_19417":48337,"_5":13306,"_25514":48113,"_2665":48338},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3170":940,"_28022":853,"_19417":48340,"_5":13306,"_25514":48113,"_2665":48341},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3170":941,"_28022":853,"_19417":48343,"_5":13306,"_25514":48113,"_2665":48344},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3170":942,"_28022":853,"_19417":48346,"_5":13306,"_25514":48113,"_2665":48347},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3170":943,"_28022":853,"_19417":48349,"_5":13306,"_25514":48113,"_2665":48350},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3170":944,"_28022":853,"_19417":48352,"_5":13306,"_25514":48113,"_2665":48353},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3170":945,"_28022":853,"_19417":48355,"_5":13306,"_25514":48113,"_2665":48356},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3170":946,"_28022":853,"_19417":48358,"_5":13306,"_25514":48117,"_2665":48359},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3170":947,"_28022":853,"_19417":48361,"_5":13306,"_25514":48121,"_2665":48362},[],"`settings.reenrollment_settings` field",{"_3170":948,"_28022":853,"_19417":48364,"_5":13306,"_25514":48121,"_2665":45796},[],{"_3170":949,"_28022":853,"_19417":48366,"_5":13306,"_25514":48121,"_2665":48367},[],"`reenrollment_delta`",{"_3170":950,"_28022":853,"_19417":48369,"_5":13306,"_25514":48121,"_2665":48370},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3170":951,"_28022":853,"_19417":48372,"_5":13306,"_25514":48121,"_2665":48373},[],"`preventive_delta`",{"_3170":952,"_28022":853,"_19417":48375,"_5":13306,"_25514":48121,"_2665":48376},[],"Preventive operational monitoring threshold.",{"_3170":953,"_28022":853,"_19417":48378,"_5":13306,"_25514":48121,"_2665":48379},[],"`critical_delta`",{"_3170":954,"_28022":853,"_19417":48381,"_5":13306,"_25514":48121,"_2665":48382},[],"Critical operational monitoring threshold.",{"_3170":955,"_28022":853,"_19417":48384,"_5":13306,"_25514":48121,"_2665":48385},[],"`enable_expired_renewal`",{"_3170":956,"_28022":853,"_19417":48387,"_5":13306,"_25514":48121,"_2665":48388},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3170":957,"_28022":853,"_19417":48390,"_5":13306,"_25514":48121,"_2665":48391},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3170":958,"_28022":853,"_19417":48393,"_5":13306,"_25514":48121,"_2665":48394},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3170":959,"_28022":853,"_19417":48396,"_5":13306,"_25514":48121,"_2665":48397},[],"`revoke_on_reenrollment`",{"_3170":960,"_28022":853,"_19417":48399,"_5":13306,"_25514":48121,"_2665":48400},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3170":961,"_28022":853,"_19417":48402,"_5":13306,"_25514":48121,"_2665":48403},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3170":962,"_28022":853,"_19417":48405,"_5":13306,"_25514":48125,"_2665":48406},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3170":963,"_28022":853,"_19417":48408,"_5":13306,"_25514":48129,"_2665":45790},[],{"_3170":964,"_28022":853,"_19417":48410,"_5":13306,"_25514":48129,"_2665":48411},[],"Published material",{"_3170":965,"_28022":853,"_19417":48413,"_5":13306,"_25514":48129,"_2665":48414},[],"**Include Lamassu System CA**",{"_3170":966,"_28022":853,"_19417":48416,"_5":13306,"_25514":48129,"_2665":48417},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3170":967,"_28022":853,"_19417":48419,"_5":13306,"_25514":48129,"_2665":48420},[],"**Include Enrollment CA**",{"_3170":968,"_28022":853,"_19417":48422,"_5":13306,"_25514":48129,"_2665":48423},[],"Selected issuing CA certificate.",{"_3170":969,"_28022":853,"_19417":48425,"_5":13306,"_25514":48129,"_2665":48426},[],"**Managed CAs**",{"_3170":970,"_28022":853,"_19417":48428,"_5":13306,"_25514":48129,"_2665":48429},[],"Explicitly selected CA certificates.",{"_3170":971,"_28022":853,"_19417":48431,"_5":13306,"_25514":48129,"_2665":48432},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3170":972,"_28022":853,"_19417":48434,"_5":13306,"_25514":48133,"_2665":48435},[],"**Edit** changes name, settings and metadata. Backend updates replace these complete blocks; read the DMS before sending API edits to avoid losing fields.",{"_3170":973,"_28022":853,"_19417":48437,"_5":13306,"_25514":48133,"_2665":48438},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3170":974,"_28022":853,"_19417":48440,"_5":13306,"_25514":48133,"_2665":48441},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3170":975,"_28022":853,"_19417":48443,"_5":13306,"_25514":48137,"_2665":48444},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3170":976,"_28022":976,"_5":13637,"_2665":48446,"_28344":48447,"_19417":48448,"_25514":976},"Integrate the EST client",[45406,46799,47807,47805,47988],[],{"_3170":977,"_28022":976,"_19417":48450,"_5":13306,"_25514":976,"_2665":48451},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3170":978,"_28022":976,"_5":28341,"_19417":48453,"_25514":48454,"_2665":45416},[],"/docs/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3170":979,"_28022":976,"_5":28341,"_19417":48456,"_25514":48457,"_2665":48458},[],"/docs/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3170":980,"_28022":976,"_5":28341,"_19417":48460,"_25514":48461,"_2665":48462},[],"/docs/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3170":981,"_28022":976,"_5":28341,"_19417":48464,"_25514":48465,"_2665":48466},[],"/docs/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3170":982,"_28022":976,"_5":28341,"_19417":48468,"_25514":48469,"_2665":48470},[],"/docs/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3170":983,"_28022":976,"_5":28341,"_19417":48472,"_25514":48473,"_2665":48474},[],"/docs/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3170":984,"_28022":976,"_19417":48476,"_5":13306,"_25514":976,"_2665":48477},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3170":985,"_28022":976,"_19417":48479,"_5":13306,"_25514":48454,"_2665":48480},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3170":986,"_28022":976,"_19417":48482,"_5":13306,"_25514":48454,"_2665":48483},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3170":987,"_28022":976,"_19417":48485,"_5":13306,"_25514":48454,"_2665":48486},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3170":988,"_28022":976,"_19417":48488,"_5":13306,"_25514":48457,"_2665":48489},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3170":989,"_28022":976,"_19417":48491,"_5":13306,"_25514":48457,"_2665":48492},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3170":990,"_28022":976,"_19417":48494,"_5":13306,"_25514":48461,"_2665":48495},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3170":991,"_28022":976,"_19417":48497,"_5":13306,"_25514":48461,"_2665":48498},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3170":992,"_28022":976,"_19417":48500,"_5":13306,"_25514":48465,"_2665":48501},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3170":993,"_28022":976,"_19417":48503,"_5":13306,"_25514":48465,"_2665":48504},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3170":994,"_28022":976,"_19417":48506,"_5":13306,"_25514":48469,"_2665":48507},[],"For a root that issues directly:",{"_3170":995,"_28022":976,"_19417":48509,"_5":13306,"_25514":48469,"_2665":48510},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3170":996,"_28022":976,"_19417":48512,"_5":13306,"_25514":48469,"_2665":48513},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3170":997,"_28022":976,"_19417":48515,"_5":13306,"_25514":48473,"_2665":48516},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3170":998,"_28022":998,"_5":13637,"_2665":48518,"_28344":48519,"_19417":48520,"_25514":998},"EST reference",[45406,46799,47807,47805,47988],[],{"_3170":999,"_28022":998,"_19417":48522,"_5":13306,"_25514":998,"_2665":48523},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3170":1000,"_28022":998,"_5":28341,"_19417":48525,"_25514":48526,"_2665":48527},[],"/docs/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3170":1001,"_28022":998,"_5":28341,"_19417":48529,"_25514":48530,"_2665":21102},[],"/docs/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3170":1002,"_28022":998,"_5":28341,"_19417":48532,"_25514":48533,"_2665":24200},[],"/docs/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3170":1003,"_28022":998,"_5":28341,"_19417":48535,"_25514":48536,"_2665":24207},[],"/docs/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3170":1004,"_28022":998,"_5":28341,"_19417":48538,"_25514":48539,"_2665":23552},[],"/docs/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3170":1005,"_28022":998,"_5":28341,"_19417":48541,"_25514":48542,"_2665":48543},[],"/docs/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3170":1006,"_28022":998,"_5":28341,"_19417":48545,"_25514":48546,"_2665":48547},[],"/docs/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3170":1007,"_28022":998,"_5":28341,"_19417":48549,"_25514":48550,"_2665":48551},[],"/docs/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3170":1008,"_28022":998,"_19417":48553,"_5":13306,"_25514":998,"_2665":48554},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3170":1009,"_28022":998,"_19417":48556,"_5":13306,"_25514":48526,"_2665":48557},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3170":1010,"_28022":998,"_19417":48559,"_5":13306,"_25514":48526,"_2665":48560},[],"Operation",{"_3170":1011,"_28022":998,"_19417":48562,"_5":13306,"_25514":48526,"_2665":48563},[],"Method",{"_3170":1012,"_28022":998,"_19417":48565,"_5":13306,"_25514":48526,"_2665":48566},[],"Authentication and condition",{"_3170":1013,"_28022":998,"_19417":48568,"_5":13306,"_25514":48526,"_2665":48569},[],"`/cacerts`",{"_3170":1014,"_28022":998,"_19417":48571,"_5":13306,"_25514":48526,"_2665":48572},[],"GET",{"_3170":1015,"_28022":998,"_19417":48574,"_5":13306,"_25514":48526,"_2665":48575},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3170":1016,"_28022":998,"_19417":48577,"_5":13306,"_25514":48526,"_2665":48578},[],"`/simpleenroll`",{"_3170":1017,"_28022":998,"_19417":48580,"_5":13306,"_25514":48526,"_2665":48581},[],"POST",{"_3170":1018,"_28022":998,"_19417":48583,"_5":13306,"_25514":48526,"_2665":48584},[],"Initial authentication and DMS registration/replacement policy.",{"_3170":1019,"_28022":998,"_19417":48586,"_5":13306,"_25514":48526,"_2665":48587},[],"`/simplereenroll`",{"_3170":1020,"_28022":998,"_19417":48589,"_5":13306,"_25514":48526,"_2665":48581},[],{"_3170":1021,"_28022":998,"_19417":48591,"_5":13306,"_25514":48526,"_2665":48592},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3170":1022,"_28022":998,"_19417":48594,"_5":13306,"_25514":48526,"_2665":48595},[],"`/serverkeygen`",{"_3170":1023,"_28022":998,"_19417":48597,"_5":13306,"_25514":48526,"_2665":48581},[],{"_3170":1024,"_28022":998,"_19417":48599,"_5":13306,"_25514":48526,"_2665":48600},[],"Initial authentication and admission; server generation enabled.",{"_3170":1025,"_28022":998,"_19417":48602,"_5":13306,"_25514":48526,"_2665":48603},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3170":1026,"_28022":998,"_19417":48605,"_5":13306,"_25514":48530,"_2665":48606},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3170":1027,"_28022":998,"_19417":48608,"_5":13306,"_25514":48530,"_2665":48609},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3170":1028,"_28022":998,"_19417":48611,"_5":13306,"_25514":48533,"_2665":48612},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3170":1029,"_28022":998,"_19417":48614,"_5":13306,"_25514":48533,"_2665":48615},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3170":1030,"_28022":998,"_19417":48617,"_5":13306,"_25514":48536,"_2665":48618},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3170":1031,"_28022":998,"_19417":48620,"_5":13306,"_25514":48536,"_2665":48621},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3170":1032,"_28022":998,"_19417":48623,"_5":13306,"_25514":48539,"_2665":48624},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3170":1033,"_28022":998,"_19417":48626,"_5":13306,"_25514":48539,"_2665":48627},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3170":1034,"_28022":998,"_19417":48629,"_5":13306,"_25514":48542,"_2665":48630},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3170":1035,"_28022":998,"_19417":48632,"_5":13306,"_25514":48542,"_2665":48633},[],"Part",{"_3170":1036,"_28022":998,"_19417":48635,"_5":13306,"_25514":48542,"_2665":48636},[],"Content after decoding its Base64",{"_3170":1037,"_28022":998,"_19417":48638,"_5":13306,"_25514":48542,"_2665":48639},[],"`application/pkcs8`",{"_3170":1038,"_28022":998,"_19417":48641,"_5":13306,"_25514":48542,"_2665":48642},[],"Unencrypted DER PKCS#8 private key.",{"_3170":1039,"_28022":998,"_19417":48644,"_5":13306,"_25514":48542,"_2665":48645},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3170":1040,"_28022":998,"_19417":48647,"_5":13306,"_25514":48542,"_2665":48648},[],"DER PKCS#7 containing the issued certificate.",{"_3170":1041,"_28022":998,"_19417":48650,"_5":13306,"_25514":48542,"_2665":48651},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3170":1042,"_28022":998,"_19417":48653,"_5":13306,"_25514":48546,"_2665":48654},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3170":1043,"_28022":998,"_19417":48656,"_5":13306,"_25514":48546,"_2665":48657},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3170":1044,"_28022":998,"_19417":48659,"_5":13306,"_25514":48546,"_2665":48660},[],"Convert and check the result:",{"_3170":1045,"_28022":998,"_19417":48662,"_5":13306,"_25514":48546,"_2665":48663},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3170":1046,"_28022":998,"_19417":48665,"_5":13306,"_25514":48550,"_2665":48666},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3170":1047,"_28022":998,"_19417":48668,"_5":13306,"_25514":48550,"_2665":48669},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3170":1048,"_28022":1048,"_5":13637,"_2665":47988,"_28344":48671,"_19417":48672,"_25514":1048},[45406,46799,47807,47805,47988],[],{"_3170":1049,"_28022":1048,"_19417":48674,"_5":13306,"_25514":1048,"_2665":48675},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3170":1050,"_28022":1048,"_5":28341,"_19417":48677,"_25514":48678,"_2665":48679},[],"/docs/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3170":1051,"_28022":1048,"_5":28341,"_19417":48681,"_25514":48682,"_2665":48683},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3170":1052,"_28022":1048,"_5":28341,"_19417":48685,"_25514":48686,"_2665":48687},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3170":1053,"_28022":1048,"_5":28341,"_19417":48689,"_25514":48690,"_2665":48691},[],"/docs/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3170":1054,"_28022":1048,"_19417":48693,"_5":13306,"_25514":1048,"_2665":48694},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3170":1055,"_28022":1048,"_19417":48696,"_5":13306,"_25514":48678,"_2665":48697},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3170":1056,"_28022":1048,"_19417":48699,"_5":13306,"_25514":48678,"_2665":48700},[],"The integrator installs initial EST server trust and an admission credential.",{"_3170":1057,"_28022":1048,"_19417":48702,"_5":13306,"_25514":48678,"_2665":48703},[],"The client requests an identity for its `Device ID` through EST.",{"_3170":1058,"_28022":1048,"_19417":48705,"_5":13306,"_25514":48678,"_2665":48706},[],"Certificate, device binding and key/certificate installation are checked.",{"_3170":1059,"_28022":1048,"_19417":48708,"_5":13306,"_25514":48678,"_2665":48709},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3170":1060,"_28022":1048,"_19417":48711,"_5":13306,"_25514":48678,"_2665":48712},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3170":1061,"_28022":1048,"_19417":48714,"_5":13306,"_25514":48682,"_2665":48715},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3170":1062,"_28022":1048,"_19417":48717,"_5":13306,"_25514":48682,"_2665":48718},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3170":1063,"_28022":1048,"_19417":48720,"_5":13306,"_25514":48682,"_2665":48721},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3170":1064,"_28022":1048,"_19417":48723,"_5":13306,"_25514":48682,"_2665":48724},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3170":1065,"_28022":1048,"_19417":48726,"_5":13306,"_25514":48686,"_2665":48727},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3170":1066,"_28022":1048,"_19417":48729,"_5":13306,"_25514":48686,"_2665":48730},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3170":1067,"_28022":1048,"_19417":48732,"_5":13306,"_25514":48686,"_2665":48733},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3170":1068,"_28022":1048,"_19417":48735,"_5":13306,"_25514":48686,"_2665":48736},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3170":1069,"_28022":1048,"_19417":48738,"_5":13306,"_25514":48690,"_2665":48739},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3170":1070,"_28022":1048,"_19417":48741,"_5":13306,"_25514":48690,"_2665":48742},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3170":1071,"_28022":1071,"_5":13637,"_2665":48744,"_28344":48745,"_19417":48746,"_25514":1071},"Provisioning strategies",[45406,46799,47807,47805,47988],[],{"_3170":1072,"_28022":1071,"_19417":48748,"_5":13306,"_25514":1071,"_2665":48749},[],"Choose device registration, identity authorization and key generation.",{"_3170":1073,"_28022":1071,"_5":28341,"_19417":48751,"_25514":48752,"_2665":48753},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3170":1074,"_28022":1071,"_5":28341,"_19417":48755,"_25514":48756,"_2665":48757},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3170":1075,"_28022":1071,"_5":28341,"_19417":48759,"_25514":48760,"_2665":48761},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3170":1076,"_28022":1071,"_5":28341,"_19417":48763,"_25514":48764,"_2665":48765},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3170":1077,"_28022":1071,"_5":28341,"_19417":48767,"_25514":48768,"_2665":48769},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3170":1078,"_28022":1071,"_19417":48771,"_5":13306,"_25514":1071,"_2665":48772},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3170":1079,"_28022":1071,"_19417":48774,"_5":13306,"_25514":48752,"_2665":48775},[],"Path",{"_3170":1080,"_28022":1071,"_19417":48777,"_5":13306,"_25514":48752,"_2665":48778},[],"When the device exists",{"_3170":1081,"_28022":1071,"_19417":48780,"_5":13306,"_25514":48752,"_2665":48781},[],"What to check",{"_3170":1082,"_28022":1071,"_19417":48783,"_5":13306,"_25514":48752,"_2665":48784},[],"Manual assignment",{"_3170":1083,"_28022":1071,"_19417":48786,"_5":13306,"_25514":48752,"_2665":48787},[],"An operator creates it before associating a certificate.",{"_3170":1084,"_28022":1071,"_19417":48789,"_5":13306,"_25514":48752,"_2665":48790},[],"ID, owning DMS, certificate CN and bound serial.",{"_3170":1085,"_28022":1071,"_19417":48792,"_5":13306,"_25514":48752,"_2665":48793},[],"EST with `JITP`",{"_3170":1086,"_28022":1071,"_19417":48795,"_5":13306,"_25514":48752,"_2665":48796},[],"Created for an unknown CN during `/simpleenroll`.",{"_3170":1087,"_28022":1071,"_19417":48798,"_5":13306,"_25514":48752,"_2665":48799},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3170":1088,"_28022":1071,"_19417":48801,"_5":13306,"_25514":48752,"_2665":48802},[],"EST with `PRE_REGISTRATION`",{"_3170":1089,"_28022":1071,"_19417":48804,"_5":13306,"_25514":48752,"_2665":48805},[],"Must exist before `/simpleenroll`.",{"_3170":1090,"_28022":1071,"_19417":48807,"_5":13306,"_25514":48752,"_2665":48808},[],"Approved record, same DMS and replacement conditions for your version.",{"_3170":1091,"_28022":1071,"_19417":48810,"_5":13306,"_25514":48752,"_2665":48811},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3170":1092,"_28022":1071,"_19417":48813,"_5":13306,"_25514":48752,"_2665":48814},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3170":1093,"_28022":1071,"_19417":48816,"_5":13306,"_25514":48756,"_2665":48817},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3170":1094,"_28022":1071,"_19417":48819,"_5":13306,"_25514":48756,"_2665":48820},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3170":1095,"_28022":1071,"_19417":48822,"_5":13306,"_25514":48756,"_2665":48823},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3170":1096,"_28022":1071,"_19417":48825,"_5":13306,"_25514":48760,"_2665":48826},[],"Decide initial enrollment and re-enrollment separately:",{"_3170":1097,"_28022":1071,"_19417":48828,"_5":13306,"_25514":48760,"_2665":48829},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3170":1098,"_28022":1071,"_19417":48831,"_5":13306,"_25514":48760,"_2665":48832},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3170":1099,"_28022":1071,"_19417":48834,"_5":13306,"_25514":48760,"_2665":48835},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3170":1100,"_28022":1071,"_19417":48837,"_5":13306,"_25514":48760,"_2665":48838},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3170":1101,"_28022":1071,"_19417":48840,"_5":13306,"_25514":48760,"_2665":48841},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3170":1102,"_28022":1071,"_19417":48843,"_5":13306,"_25514":48764,"_2665":45790},[],{"_3170":1103,"_28022":1071,"_19417":48845,"_5":13306,"_25514":48764,"_2665":48846},[],"Material crossing EST",{"_3170":1104,"_28022":1071,"_19417":48848,"_5":13306,"_25514":48764,"_2665":48849},[],"Device-generated key",{"_3170":1105,"_28022":1071,"_19417":48851,"_5":13306,"_25514":48764,"_2665":48852},[],"Public CSR and certificate; the key stays on the client.",{"_3170":1106,"_28022":1071,"_19417":48854,"_5":13306,"_25514":48764,"_2665":48855},[],"Existing device key",{"_3170":1107,"_28022":1071,"_19417":48857,"_5":13306,"_25514":48764,"_2665":48858},[],"CSR signed with that key and a new certificate.",{"_3170":1108,"_28022":1071,"_19417":48860,"_5":13306,"_25514":48764,"_2665":48126},[],{"_3170":1109,"_28022":1071,"_19417":48862,"_5":13306,"_25514":48764,"_2665":48863},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3170":1110,"_28022":1071,"_19417":48865,"_5":13306,"_25514":48764,"_2665":48866},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3170":1111,"_28022":1071,"_19417":48868,"_5":13306,"_25514":48768,"_2665":48869},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3170":1112,"_28022":1112,"_5":13637,"_2665":48871,"_28344":48872,"_19417":48873,"_25514":1112},"Renewal and recovery",[45406,46799,47807,47805,47988],[],{"_3170":1113,"_28022":1112,"_19417":48875,"_5":13306,"_25514":1112,"_2665":48876},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3170":1114,"_28022":1112,"_5":28341,"_19417":48878,"_25514":48879,"_2665":48880},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3170":1115,"_28022":1112,"_5":28341,"_19417":48882,"_25514":48883,"_2665":48884},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3170":1116,"_28022":1112,"_5":28341,"_19417":48886,"_25514":48887,"_2665":48888},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3170":1117,"_28022":1112,"_5":28341,"_19417":48890,"_25514":48891,"_2665":48892},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3170":1118,"_28022":1112,"_5":28341,"_19417":48894,"_25514":48895,"_2665":48896},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3170":1119,"_28022":1112,"_19417":48898,"_5":13306,"_25514":1112,"_2665":48899},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3170":1120,"_28022":1112,"_19417":48901,"_5":13306,"_25514":48879,"_2665":48902},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3170":1121,"_28022":1112,"_19417":48904,"_5":13306,"_25514":48879,"_2665":48905},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3170":1122,"_28022":1112,"_19417":48907,"_5":13306,"_25514":48879,"_2665":48908},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3170":1123,"_28022":1112,"_19417":48910,"_5":13306,"_25514":48879,"_2665":48911},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3170":1124,"_28022":1112,"_19417":48913,"_5":13306,"_25514":48883,"_2665":48914},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3170":1125,"_28022":1112,"_19417":48916,"_5":13306,"_25514":48883,"_2665":48917},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3170":1126,"_28022":1112,"_19417":48919,"_5":13306,"_25514":48887,"_2665":48920},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3170":1127,"_28022":1112,"_19417":48922,"_5":13306,"_25514":48887,"_2665":48923},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3170":1128,"_28022":1112,"_19417":48925,"_5":13306,"_25514":48887,"_2665":48926},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3170":1129,"_28022":1112,"_19417":48928,"_5":13306,"_25514":48891,"_2665":48929},[],"Situation",{"_3170":1130,"_28022":1112,"_19417":48931,"_5":13306,"_25514":48891,"_2665":48932},[],"Procedure",{"_3170":1131,"_28022":1112,"_19417":48934,"_5":13306,"_25514":48891,"_2665":48935},[],"Valid certificate, outside the window",{"_3170":1132,"_28022":1112,"_19417":48937,"_5":13306,"_25514":48891,"_2665":48938},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3170":1133,"_28022":1112,"_19417":48940,"_5":13306,"_25514":48891,"_2665":48941},[],"Expired certificate, key available",{"_3170":1134,"_28022":1112,"_19417":48943,"_5":13306,"_25514":48891,"_2665":48944},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3170":1135,"_28022":1112,"_19417":48946,"_5":13306,"_25514":48891,"_2665":48947},[],"Renewal through webhook or `NO_AUTH`",{"_3170":1136,"_28022":1112,"_19417":48949,"_5":13306,"_25514":48891,"_2665":48950},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3170":1137,"_28022":1112,"_19417":48952,"_5":13306,"_25514":48891,"_2665":48953},[],"Lost or inaccessible key",{"_3170":1138,"_28022":1112,"_19417":48955,"_5":13306,"_25514":48891,"_2665":48956},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3170":1139,"_28022":1112,"_19417":48958,"_5":13306,"_25514":48891,"_2665":48959},[],"Current identity revoked",{"_3170":1140,"_28022":1112,"_19417":48961,"_5":13306,"_25514":48891,"_2665":48962},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3170":1141,"_28022":1112,"_19417":48964,"_5":13306,"_25514":48891,"_2665":48965},[],"Device without an identity",{"_3170":1142,"_28022":1112,"_19417":48967,"_5":13306,"_25514":48891,"_2665":48968},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3170":1143,"_28022":1112,"_19417":48970,"_5":13306,"_25514":48891,"_2665":48971},[],"Retired device",{"_3170":1144,"_28022":1112,"_19417":48973,"_5":13306,"_25514":48891,"_2665":48974},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3170":1145,"_28022":1112,"_19417":48976,"_5":13306,"_25514":48891,"_2665":48977},[],"Timeout, HTTP 500 or installation failure",{"_3170":1146,"_28022":1112,"_19417":48979,"_5":13306,"_25514":48891,"_2665":48980},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3170":1147,"_28022":1112,"_19417":48982,"_5":13306,"_25514":48895,"_2665":48983},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3170":1148,"_28022":1112,"_19417":48985,"_5":13306,"_25514":48895,"_2665":48986},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3170":1149,"_28022":1149,"_5":13637,"_2665":48988,"_28344":48989,"_19417":48990,"_25514":1149},"Enrollment troubleshooting",[45406,46799,47807,47805,47988],[],{"_3170":1150,"_28022":1149,"_19417":48992,"_5":13306,"_25514":1149,"_2665":48993},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3170":1151,"_28022":1149,"_5":28341,"_19417":48995,"_25514":48996,"_2665":48997},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3170":1152,"_28022":1149,"_5":28341,"_19417":48999,"_25514":49000,"_2665":49001},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3170":1153,"_28022":1149,"_5":28341,"_19417":49003,"_25514":49004,"_2665":48551},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3170":1154,"_28022":1149,"_5":28341,"_19417":49006,"_25514":49007,"_2665":49008},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3170":1155,"_28022":1149,"_19417":49010,"_5":13306,"_25514":1149,"_2665":49011},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3170":1156,"_28022":1149,"_19417":49013,"_5":13306,"_25514":49000,"_2665":49014},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3170":1157,"_28022":1149,"_19417":49016,"_5":13306,"_25514":49000,"_2665":49017},[],"Symptom or message",{"_3170":1158,"_28022":1149,"_19417":49019,"_5":13306,"_25514":49000,"_2665":48781},[],{"_3170":1159,"_28022":1149,"_19417":49021,"_5":13306,"_25514":49000,"_2665":49022},[],"curl rejects TLS, name or issuer",{"_3170":1160,"_28022":1149,"_19417":49024,"_5":13306,"_25514":49000,"_2665":49025},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3170":1161,"_28022":1149,"_19417":49027,"_5":13306,"_25514":49000,"_2665":49028},[],"404 or missing APS",{"_3170":1162,"_28022":1149,"_19417":49030,"_5":13306,"_25514":49000,"_2665":49031},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3170":1163,"_28022":1149,"_19417":49033,"_5":13306,"_25514":49000,"_2665":49034},[],"400, CSR or format error",{"_3170":1164,"_28022":1149,"_19417":49036,"_5":13306,"_25514":49000,"_2665":49037},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3170":1165,"_28022":1149,"_19417":49039,"_5":13306,"_25514":49000,"_2665":49040},[],"Missing credential or invalid certificate",{"_3170":1166,"_28022":1149,"_19417":49042,"_5":13306,"_25514":49000,"_2665":49043},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3170":1167,"_28022":1149,"_19417":49045,"_5":13306,"_25514":49000,"_2665":49046},[],"Webhook denies, times out or responds without authorization",{"_3170":1168,"_28022":1149,"_19417":49048,"_5":13306,"_25514":49000,"_2665":49049},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3170":1169,"_28022":1149,"_19417":49051,"_5":13306,"_25514":49000,"_2665":49052},[],"`unexpected status code: <n>: redirects are not followed`",{"_3170":1170,"_28022":1149,"_19417":49054,"_5":13306,"_25514":49000,"_2665":49055},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3170":1171,"_28022":1149,"_19417":49057,"_5":13306,"_25514":49000,"_2665":49058},[],"`webhook response exceeds 1048576 bytes`",{"_3170":1172,"_28022":1149,"_19417":49060,"_5":13306,"_25514":49000,"_2665":49061},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3170":1173,"_28022":1149,"_19417":49063,"_5":13306,"_25514":49000,"_2665":49064},[],"`webhook config must not reference files`",{"_3170":1174,"_28022":1149,"_19417":49066,"_5":13306,"_25514":49000,"_2665":49067},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3170":1175,"_28022":1149,"_19417":49069,"_5":13306,"_25514":49000,"_2665":49070},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3170":1176,"_28022":1149,"_19417":49072,"_5":13306,"_25514":49000,"_2665":49073},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3170":1177,"_28022":1149,"_19417":49075,"_5":13306,"_25514":49000,"_2665":49076},[],"`webhook mTLS certificate and key are invalid: …`",{"_3170":1178,"_28022":1149,"_19417":49078,"_5":13306,"_25514":49000,"_2665":49079},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3170":1179,"_28022":1149,"_19417":49081,"_5":13306,"_25514":49000,"_2665":49082},[],"400 `struct validation error` creating or updating a DMS",{"_3170":1180,"_28022":1149,"_19417":49084,"_5":13306,"_25514":49000,"_2665":49085},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3170":1181,"_28022":1149,"_19417":49087,"_5":13306,"_25514":49000,"_2665":49088},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3170":1182,"_28022":1149,"_19417":49090,"_5":13306,"_25514":49000,"_2665":49091},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3170":1183,"_28022":1149,"_19417":49093,"_5":13306,"_25514":49000,"_2665":49094},[],"`device not preregistered`",{"_3170":1184,"_28022":1149,"_19417":49096,"_5":13306,"_25514":49000,"_2665":49097},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3170":1185,"_28022":1149,"_19417":49099,"_5":13306,"_25514":49000,"_2665":49100},[],"`forbiddenNewEnrollment`",{"_3170":1186,"_28022":1149,"_19417":49102,"_5":13306,"_25514":49000,"_2665":49103},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3170":1187,"_28022":1149,"_19417":49105,"_5":13306,"_25514":49000,"_2665":49106},[],"Different owning DMS",{"_3170":1188,"_28022":1149,"_19417":49108,"_5":13306,"_25514":49000,"_2665":49109},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3170":1189,"_28022":1149,"_19417":49111,"_5":13306,"_25514":49000,"_2665":49112},[],"`invalid RawSubject bytes`",{"_3170":1190,"_28022":1149,"_19417":49114,"_5":13306,"_25514":49000,"_2665":49115},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3170":1191,"_28022":1149,"_19417":49117,"_5":13306,"_25514":49000,"_2665":49118},[],"`invalid reenroll window`",{"_3170":1192,"_28022":1149,"_19417":49120,"_5":13306,"_25514":49000,"_2665":49121},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3170":1193,"_28022":1149,"_19417":49123,"_5":13306,"_25514":49000,"_2665":49124},[],"Current certificate revoked",{"_3170":1194,"_28022":1149,"_19417":49126,"_5":13306,"_25514":49000,"_2665":49127},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3170":1195,"_28022":1149,"_19417":49129,"_5":13306,"_25514":49000,"_2665":49130},[],"CA, profile or signing error",{"_3170":1196,"_28022":1149,"_19417":49132,"_5":13306,"_25514":49000,"_2665":49133},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3170":1197,"_28022":1149,"_19417":49135,"_5":13306,"_25514":49000,"_2665":49136},[],"HTTP 200 without a device connection",{"_3170":1198,"_28022":1149,"_19417":49138,"_5":13306,"_25514":49000,"_2665":49139},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3170":1199,"_28022":1149,"_19417":49141,"_5":13306,"_25514":49000,"_2665":49142},[],"Timeout or error after issuance",{"_3170":1200,"_28022":1149,"_19417":49144,"_5":13306,"_25514":49000,"_2665":49145},[],"New certificates, current slot and previous identity's state before retrying.",{"_3170":1201,"_28022":1149,"_19417":49147,"_5":13306,"_25514":49004,"_2665":49148},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3170":1202,"_28022":1149,"_19417":49150,"_5":13306,"_25514":49004,"_2665":49151},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3170":1203,"_28022":1149,"_19417":49153,"_5":13306,"_25514":49007,"_2665":49154},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3170":1204,"_28022":1149,"_19417":49156,"_5":13306,"_25514":49007,"_2665":49157},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3170":1205,"_28022":1149,"_19417":49159,"_5":13306,"_25514":49007,"_2665":49160},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3170":1206,"_28022":1149,"_19417":49162,"_5":13306,"_25514":49007,"_2665":49163},[],"Make one request, save headers/body and query the device and certificates.",{"_3170":1207,"_28022":1149,"_19417":49165,"_5":13306,"_25514":49007,"_2665":49166},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3170":1208,"_28022":1149,"_19417":49168,"_5":13306,"_25514":49007,"_2665":49169},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3170":1209,"_28022":1149,"_19417":49171,"_5":13306,"_25514":49007,"_2665":49172},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3170":1210,"_28022":1210,"_5":13637,"_2665":49174,"_28344":49175,"_19417":49176,"_25514":1210},"Trust distribution and updates",[45406,46799,47807,47805,47988],[],{"_3170":1211,"_28022":1210,"_19417":49178,"_5":13306,"_25514":1210,"_2665":49179},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3170":1212,"_28022":1210,"_5":28341,"_19417":49181,"_25514":49182,"_2665":49183},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3170":1213,"_28022":1210,"_5":28341,"_19417":49185,"_25514":49186,"_2665":49187},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3170":1214,"_28022":1210,"_5":28341,"_19417":49189,"_25514":49190,"_2665":49191},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3170":1215,"_28022":1210,"_5":28341,"_19417":49193,"_25514":49194,"_2665":49195},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3170":1216,"_28022":1210,"_5":28341,"_19417":49197,"_25514":49198,"_2665":49199},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3170":1217,"_28022":1210,"_19417":49201,"_5":13306,"_25514":1210,"_2665":49202},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3170":1218,"_28022":1210,"_19417":49204,"_5":13306,"_25514":49182,"_2665":49205},[],"Relationship",{"_3170":1219,"_28022":1210,"_19417":49207,"_5":13306,"_25514":49182,"_2665":49208},[],"Material prepared by its owner",{"_3170":1220,"_28022":1210,"_19417":49210,"_5":13306,"_25514":49182,"_2665":49211},[],"Device → EST server",{"_3170":1221,"_28022":1210,"_19417":49213,"_5":13306,"_25514":49182,"_2665":49214},[],"Previously verified server root, chain or pin and TLS name.",{"_3170":1222,"_28022":1210,"_19417":49216,"_5":13306,"_25514":49182,"_2665":49217},[],"DMS → requester",{"_3170":1223,"_28022":1210,"_19417":49219,"_5":13306,"_25514":49182,"_2665":49220},[],"CAs and rules authorizing initial or renewal credentials.",{"_3170":1224,"_28022":1210,"_19417":49222,"_5":13306,"_25514":49182,"_2665":49223},[],"Consumer → device",{"_3170":1225,"_28022":1210,"_19417":49225,"_5":13306,"_25514":49182,"_2665":49226},[],"Operational identity roots, intermediates, validation and permissions.",{"_3170":1226,"_28022":1210,"_19417":49228,"_5":13306,"_25514":49182,"_2665":49229},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3170":1227,"_28022":1210,"_19417":49231,"_5":13306,"_25514":49186,"_2665":49232},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3170":1228,"_28022":1210,"_19417":49234,"_5":13306,"_25514":49186,"_2665":49235},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3170":1229,"_28022":1210,"_19417":49237,"_5":13306,"_25514":49190,"_2665":49238},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3170":1230,"_28022":1210,"_19417":49240,"_5":13306,"_25514":49190,"_2665":49241},[],"Select policy-approved roots as anchors.",{"_3170":1231,"_28022":1210,"_19417":49243,"_5":13306,"_25514":49190,"_2665":49244},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3170":1232,"_28022":1210,"_19417":49246,"_5":13306,"_25514":49190,"_2665":49247},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3170":1233,"_28022":1210,"_19417":49249,"_5":13306,"_25514":49190,"_2665":49250},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3170":1234,"_28022":1210,"_19417":49252,"_5":13306,"_25514":49190,"_2665":49253},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3170":1235,"_28022":1210,"_19417":49255,"_5":13306,"_25514":49194,"_2665":49256},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3170":1236,"_28022":1210,"_19417":49258,"_5":13306,"_25514":49194,"_2665":49259},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3170":1237,"_28022":1210,"_19417":49261,"_5":13306,"_25514":49194,"_2665":49262},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3170":1238,"_28022":1210,"_19417":49264,"_5":13306,"_25514":49198,"_2665":49265},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3170":1239,"_28022":1239,"_5":13637,"_2665":49267,"_28344":49268,"_19417":49270,"_25514":1239},"AWS IoT Core",[45406,46799,47807,47805,49269],"Integrations",[],{"_3170":1240,"_28022":1239,"_19417":49272,"_5":13306,"_25514":1239,"_2665":49273},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3170":1241,"_28022":1239,"_5":28341,"_19417":49275,"_25514":49276,"_2665":49277},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3170":1242,"_28022":1239,"_5":28341,"_19417":49279,"_25514":49280,"_2665":49281},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3170":1243,"_28022":1239,"_5":28341,"_19417":49283,"_25514":49284,"_2665":49285},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3170":1244,"_28022":1239,"_5":28341,"_19417":49287,"_25514":49288,"_2665":49289},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3170":1245,"_28022":1239,"_5":28341,"_19417":49291,"_25514":49292,"_2665":49293},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3170":1246,"_28022":1239,"_5":28341,"_19417":49295,"_25514":49296,"_2665":49297},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3170":1247,"_28022":1239,"_5":28341,"_19417":49299,"_25514":49300,"_2665":49301},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3170":1248,"_28022":1239,"_5":28341,"_19417":49303,"_25514":49304,"_2665":49305},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3170":1249,"_28022":1239,"_5":28341,"_19417":49307,"_25514":49308,"_2665":49309},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3170":1250,"_28022":1239,"_5":28341,"_19417":49311,"_25514":49312,"_2665":49313},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3170":1251,"_28022":1239,"_5":28341,"_19417":49315,"_25514":49316,"_2665":49317},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3170":1252,"_28022":1239,"_5":28341,"_19417":49319,"_25514":49320,"_2665":49321},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3170":1253,"_28022":1239,"_5":28341,"_19417":49323,"_25514":49324,"_2665":49325},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3170":1254,"_28022":1239,"_5":28341,"_19417":49327,"_25514":49328,"_2665":49329},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3170":1255,"_28022":1239,"_5":28341,"_19417":49331,"_25514":49332,"_2665":49333},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3170":1256,"_28022":1239,"_5":28341,"_19417":49335,"_25514":49336,"_2665":49337},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3170":1257,"_28022":1239,"_5":28341,"_19417":49339,"_25514":49340,"_2665":49341},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3170":1258,"_28022":1239,"_5":28341,"_19417":49343,"_25514":49344,"_2665":49345},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3170":1259,"_28022":1239,"_5":28341,"_19417":49347,"_25514":49348,"_2665":49349},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3170":1260,"_28022":1239,"_5":28341,"_19417":49351,"_25514":49352,"_2665":49353},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3170":1261,"_28022":1239,"_19417":49355,"_5":13306,"_25514":1239,"_2665":49356},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3170":1262,"_28022":1239,"_19417":49358,"_5":13306,"_25514":1239,"_2665":49359},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3170":1263,"_28022":1239,"_19417":49361,"_5":13306,"_25514":1239,"_2665":49362},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3170":1264,"_28022":1239,"_19417":49364,"_5":13306,"_25514":49276,"_2665":49365},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3170":1265,"_28022":1239,"_19417":49367,"_5":13306,"_25514":49276,"_2665":49368},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3170":1266,"_28022":1239,"_19417":49370,"_5":13306,"_25514":49276,"_2665":49371},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3170":1267,"_28022":1239,"_19417":49373,"_5":13306,"_25514":49276,"_2665":49374},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3170":1268,"_28022":1239,"_19417":49376,"_5":13306,"_25514":49280,"_2665":49377},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3170":1269,"_28022":1239,"_19417":49379,"_5":13306,"_25514":49284,"_2665":49380},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3170":1270,"_28022":1239,"_19417":49382,"_5":13306,"_25514":49284,"_2665":49383},[],"IAM action",{"_3170":1271,"_28022":1239,"_19417":49385,"_5":13306,"_25514":49284,"_2665":45796},[],{"_3170":1272,"_28022":1239,"_19417":49387,"_5":13306,"_25514":49284,"_2665":49388},[],"`iot:GetRegistrationCode`",{"_3170":1273,"_28022":1239,"_19417":49390,"_5":13306,"_25514":49284,"_2665":49391},[],"Obtain the verification code for CA registration in the Primary Account",{"_3170":1274,"_28022":1239,"_19417":49393,"_5":13306,"_25514":49284,"_2665":49394},[],"`iot:RegisterCACertificate`",{"_3170":1275,"_28022":1239,"_19417":49396,"_5":13306,"_25514":49284,"_2665":49397},[],"Register the CA in AWS IoT",{"_3170":1276,"_28022":1239,"_19417":49399,"_5":13306,"_25514":49284,"_2665":49400},[],"`iot:DescribeCACertificate`",{"_3170":1277,"_28022":1239,"_19417":49402,"_5":13306,"_25514":49284,"_2665":49403},[],"Check the CA registration status",{"_3170":1278,"_28022":1239,"_19417":49405,"_5":13306,"_25514":49284,"_2665":49406},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3170":1279,"_28022":1239,"_19417":49408,"_5":13306,"_25514":49284,"_2665":49409},[],"Create or update Things in IoT Core",{"_3170":1280,"_28022":1239,"_19417":49411,"_5":13306,"_25514":49284,"_2665":49412},[],"`iot:RegisterThing`",{"_3170":1281,"_28022":1239,"_19417":49414,"_5":13306,"_25514":49284,"_2665":49415},[],"Provision Things through a template",{"_3170":1282,"_28022":1239,"_19417":49417,"_5":13306,"_25514":49284,"_2665":49418},[],"`iot:RegisterCertificate`",{"_3170":1283,"_28022":1239,"_19417":49420,"_5":13306,"_25514":49284,"_2665":49421},[],"Register device certificates",{"_3170":1284,"_28022":1239,"_19417":49423,"_5":13306,"_25514":49284,"_2665":49424},[],"`iot:UpdateCertificate`",{"_3170":1285,"_28022":1239,"_19417":49426,"_5":13306,"_25514":49284,"_2665":49427},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3170":1286,"_28022":1239,"_19417":49429,"_5":13306,"_25514":49284,"_2665":49430},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3170":1287,"_28022":1239,"_19417":49432,"_5":13306,"_25514":49284,"_2665":49433},[],"Create and attach IoT policies",{"_3170":1288,"_28022":1239,"_19417":49435,"_5":13306,"_25514":49284,"_2665":49436},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3170":1289,"_28022":1239,"_19417":49438,"_5":13306,"_25514":49284,"_2665":49439},[],"Manage Thing groups",{"_3170":1290,"_28022":1239,"_19417":49441,"_5":13306,"_25514":49284,"_2665":49442},[],"`iot:CreateProvisioningTemplate`",{"_3170":1291,"_28022":1239,"_19417":49444,"_5":13306,"_25514":49284,"_2665":49445},[],"Create JITP templates",{"_3170":1292,"_28022":1239,"_19417":49447,"_5":13306,"_25514":49284,"_2665":49448},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3170":1293,"_28022":1239,"_19417":49450,"_5":13306,"_25514":49284,"_2665":49451},[],"Read and write the Device Shadow",{"_3170":1294,"_28022":1239,"_19417":49453,"_5":13306,"_25514":49284,"_2665":49454},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3170":1295,"_28022":1239,"_19417":49456,"_5":13306,"_25514":49288,"_2665":49457},[],"Parameter",{"_3170":1296,"_28022":1239,"_19417":49459,"_5":13306,"_25514":49288,"_2665":49460},[],"Type",{"_3170":1297,"_28022":1239,"_19417":49462,"_5":13306,"_25514":49288,"_2665":49463},[],"Required",{"_3170":1298,"_28022":1239,"_19417":49465,"_5":13306,"_25514":49288,"_2665":49466},[],"Description",{"_3170":1299,"_28022":1239,"_19417":49468,"_5":13306,"_25514":49288,"_2665":49469},[],"`connector_id`",{"_3170":1300,"_28022":1239,"_19417":49471,"_5":13306,"_25514":49288,"_2665":23219},[],{"_3170":1301,"_28022":1239,"_19417":49473,"_5":13306,"_25514":49288,"_2665":49474},[],"Yes",{"_3170":1302,"_28022":1239,"_19417":49476,"_5":13306,"_25514":49288,"_2665":49477},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3170":1303,"_28022":1239,"_19417":49479,"_5":13306,"_25514":49288,"_2665":49480},[],"`aws_config.region`",{"_3170":1304,"_28022":1239,"_19417":49482,"_5":13306,"_25514":49288,"_2665":23219},[],{"_3170":1305,"_28022":1239,"_19417":49484,"_5":13306,"_25514":49288,"_2665":49474},[],{"_3170":1306,"_28022":1239,"_19417":49486,"_5":13306,"_25514":49288,"_2665":49487},[],"AWS region where the connector operates.",{"_3170":1307,"_28022":1239,"_19417":49489,"_5":13306,"_25514":49288,"_2665":49490},[],"`aws_config.auth_method`",{"_3170":1308,"_28022":1239,"_19417":49492,"_5":13306,"_25514":49288,"_2665":23219},[],{"_3170":1309,"_28022":1239,"_19417":49494,"_5":13306,"_25514":49288,"_2665":49474},[],{"_3170":1310,"_28022":1239,"_19417":49496,"_5":13306,"_25514":49288,"_2665":49497},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3170":1311,"_28022":1239,"_19417":49499,"_5":13306,"_25514":49288,"_2665":49500},[],"`aws_config.access_key_id`",{"_3170":1312,"_28022":1239,"_19417":49502,"_5":13306,"_25514":49288,"_2665":23219},[],{"_3170":1313,"_28022":1239,"_19417":49504,"_5":13306,"_25514":49288,"_2665":49505},[],"Only with `auth_method=static`",{"_3170":1314,"_28022":1239,"_19417":49507,"_5":13306,"_25514":49288,"_2665":49508},[],"AWS access key.",{"_3170":1315,"_28022":1239,"_19417":49510,"_5":13306,"_25514":49288,"_2665":49511},[],"`aws_config.secret_access_key`",{"_3170":1316,"_28022":1239,"_19417":49513,"_5":13306,"_25514":49288,"_2665":23219},[],{"_3170":1317,"_28022":1239,"_19417":49515,"_5":13306,"_25514":49288,"_2665":49505},[],{"_3170":1318,"_28022":1239,"_19417":49517,"_5":13306,"_25514":49288,"_2665":49518},[],"AWS secret key.",{"_3170":1319,"_28022":1239,"_19417":49520,"_5":13306,"_25514":49288,"_2665":49521},[],"`aws_config.session_token`",{"_3170":1320,"_28022":1239,"_19417":49523,"_5":13306,"_25514":49288,"_2665":23219},[],{"_3170":1321,"_28022":1239,"_19417":49525,"_5":13306,"_25514":49288,"_2665":49526},[],"No",{"_3170":1322,"_28022":1239,"_19417":49528,"_5":13306,"_25514":49288,"_2665":49529},[],"Session token (with `auth_method=static`).",{"_3170":1323,"_28022":1239,"_19417":49531,"_5":13306,"_25514":49288,"_2665":49532},[],"`aws_config.role_arn`",{"_3170":1324,"_28022":1239,"_19417":49534,"_5":13306,"_25514":49288,"_2665":23219},[],{"_3170":1325,"_28022":1239,"_19417":49536,"_5":13306,"_25514":49288,"_2665":49537},[],"Only with `auth_method=role`",{"_3170":1326,"_28022":1239,"_19417":49539,"_5":13306,"_25514":49288,"_2665":49540},[],"ARN of the role to assume.",{"_3170":1327,"_28022":1239,"_19417":49542,"_5":13306,"_25514":49288,"_2665":49543},[],"`aws_config.endpoint_url`",{"_3170":1328,"_28022":1239,"_19417":49545,"_5":13306,"_25514":49288,"_2665":23219},[],{"_3170":1329,"_28022":1239,"_19417":49547,"_5":13306,"_25514":49288,"_2665":49526},[],{"_3170":1330,"_28022":1239,"_19417":49549,"_5":13306,"_25514":49288,"_2665":49550},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3170":1331,"_28022":1239,"_19417":49552,"_5":13306,"_25514":49288,"_2665":49553},[],"`subscriber_event_bus`",{"_3170":1332,"_28022":1239,"_19417":49555,"_5":13306,"_25514":49288,"_2665":16340},[],{"_3170":1333,"_28022":1239,"_19417":49557,"_5":13306,"_25514":49288,"_2665":49474},[],{"_3170":1334,"_28022":1239,"_19417":49559,"_5":13306,"_25514":49288,"_2665":49560},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3170":1335,"_28022":1239,"_19417":49562,"_5":13306,"_25514":49288,"_2665":49563},[],"`dms_manager_client`",{"_3170":1336,"_28022":1239,"_19417":49565,"_5":13306,"_25514":49288,"_2665":23219},[],{"_3170":1337,"_28022":1239,"_19417":49567,"_5":13306,"_25514":49288,"_2665":49474},[],{"_3170":1338,"_28022":1239,"_19417":49569,"_5":13306,"_25514":49288,"_2665":49570},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3170":1339,"_28022":1239,"_19417":49572,"_5":13306,"_25514":49288,"_2665":49573},[],"`device_manager_client`",{"_3170":1340,"_28022":1239,"_19417":49575,"_5":13306,"_25514":49288,"_2665":23219},[],{"_3170":1341,"_28022":1239,"_19417":49577,"_5":13306,"_25514":49288,"_2665":49474},[],{"_3170":1342,"_28022":1239,"_19417":49579,"_5":13306,"_25514":49288,"_2665":49580},[],"HTTP URL of Lamassu's Device Manager.",{"_3170":1343,"_28022":1239,"_19417":49582,"_5":13306,"_25514":49288,"_2665":49583},[],"`ca_client`",{"_3170":1344,"_28022":1239,"_19417":49585,"_5":13306,"_25514":49288,"_2665":23219},[],{"_3170":1345,"_28022":1239,"_19417":49587,"_5":13306,"_25514":49288,"_2665":49474},[],{"_3170":1346,"_28022":1239,"_19417":49589,"_5":13306,"_25514":49288,"_2665":49590},[],"HTTP URL of Lamassu's CA service.",{"_3170":1347,"_28022":1239,"_19417":49592,"_5":13306,"_25514":49292,"_2665":49593},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3170":1348,"_28022":1239,"_19417":49595,"_5":13306,"_25514":49296,"_2665":49596},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3170":1349,"_28022":1239,"_19417":49598,"_5":13306,"_25514":49296,"_2665":49599},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3170":1350,"_28022":1239,"_19417":49601,"_5":13306,"_25514":49300,"_2665":49602},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3170":1351,"_28022":1239,"_19417":49604,"_5":13306,"_25514":49300,"_2665":49605},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3170":1352,"_28022":1239,"_19417":49607,"_5":13306,"_25514":49300,"_2665":49608},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3170":1353,"_28022":1239,"_19417":49610,"_5":13306,"_25514":49300,"_2665":49611},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3170":1354,"_28022":1239,"_19417":49613,"_5":13306,"_25514":49300,"_2665":49614},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3170":1355,"_28022":1239,"_19417":49616,"_5":13306,"_25514":49300,"_2665":49617},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3170":1356,"_28022":1239,"_19417":49619,"_5":13306,"_25514":49304,"_2665":49620},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3170":1357,"_28022":1239,"_19417":49622,"_5":13306,"_25514":49308,"_2665":49623},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3170":1358,"_28022":1239,"_19417":49625,"_5":13306,"_25514":49308,"_2665":49626},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3170":1359,"_28022":1239,"_19417":49628,"_5":13306,"_25514":49312,"_2665":49629},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3170":1360,"_28022":1239,"_19417":49631,"_5":13306,"_25514":49316,"_2665":49632},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3170":1361,"_28022":1239,"_19417":49634,"_5":13306,"_25514":49316,"_2665":49635},[],"Creates or updates the IoT policies configured in the DMS.",{"_3170":1362,"_28022":1239,"_19417":49637,"_5":13306,"_25514":49316,"_2665":49638},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3170":1363,"_28022":1239,"_19417":49640,"_5":13306,"_25514":49316,"_2665":49641},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3170":1364,"_28022":1239,"_19417":49643,"_5":13306,"_25514":49316,"_2665":49644},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3170":1365,"_28022":1239,"_19417":49646,"_5":13306,"_25514":49316,"_2665":49647},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3170":1366,"_28022":1239,"_19417":49649,"_5":13306,"_25514":49316,"_2665":49650},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3170":1367,"_28022":1239,"_19417":49652,"_5":13306,"_25514":49320,"_2665":49653},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. This template is created or updated at the moment the DMS is created or updated in Lamassu — not at device enrollment time. From then on, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3170":1368,"_28022":1239,"_19417":49655,"_5":13306,"_25514":49320,"_2665":49656},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3170":1369,"_28022":1239,"_19417":49658,"_5":13306,"_25514":49320,"_2665":49659},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3170":1370,"_28022":1239,"_19417":49661,"_5":13306,"_25514":49324,"_2665":49662},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3170":1371,"_28022":1239,"_19417":49664,"_5":13306,"_25514":49324,"_2665":49665},[],"The full flow from the device's perspective is:",{"_3170":1372,"_28022":1239,"_19417":49667,"_5":13306,"_25514":49324,"_2665":49668},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3170":1373,"_28022":1239,"_19417":49670,"_5":13306,"_25514":49328,"_2665":49671},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3170":1374,"_28022":1239,"_19417":49673,"_5":13306,"_25514":49328,"_2665":49674},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3170":1375,"_28022":1239,"_19417":49676,"_5":13306,"_25514":49328,"_2665":49677},[],"For the JITP flow to work correctly:",{"_3170":1376,"_28022":1239,"_19417":49679,"_5":13306,"_25514":49328,"_2665":49680},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3170":1377,"_28022":1239,"_19417":49682,"_5":13306,"_25514":49328,"_2665":49683},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3170":1378,"_28022":1239,"_19417":49685,"_5":13306,"_25514":49328,"_2665":49686},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3170":1379,"_28022":1239,"_19417":49688,"_5":13306,"_25514":49328,"_2665":49689},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3170":1380,"_28022":1239,"_19417":49691,"_5":13306,"_25514":49332,"_2665":49692},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3170":1381,"_28022":1239,"_19417":49694,"_5":13306,"_25514":49332,"_2665":49695},[],"Status in Lamassu",{"_3170":1382,"_28022":1239,"_19417":49697,"_5":13306,"_25514":49332,"_2665":49698},[],"Revocation reason",{"_3170":1383,"_28022":1239,"_19417":49700,"_5":13306,"_25514":49332,"_2665":49701},[],"Status in AWS IoT Core",{"_3170":1384,"_28022":1239,"_19417":49703,"_5":13306,"_25514":49332,"_2665":49704},[],"`Active`",{"_3170":1385,"_28022":1239,"_19417":49706,"_5":13306,"_25514":49332,"_2665":49707},[],"None",{"_3170":1386,"_28022":1239,"_19417":49709,"_5":13306,"_25514":49332,"_2665":49710},[],"`ACTIVE`",{"_3170":1387,"_28022":1239,"_19417":49712,"_5":13306,"_25514":49332,"_2665":49713},[],"`Revoked`",{"_3170":1388,"_28022":1239,"_19417":49715,"_5":13306,"_25514":49332,"_2665":49716},[],"`certificateHold`",{"_3170":1389,"_28022":1239,"_19417":49718,"_5":13306,"_25514":49332,"_2665":49719},[],"`INACTIVE`",{"_3170":1390,"_28022":1239,"_19417":49721,"_5":13306,"_25514":49332,"_2665":49713},[],{"_3170":1391,"_28022":1239,"_19417":49723,"_5":13306,"_25514":49332,"_2665":49724},[],"Any other reason",{"_3170":1392,"_28022":1239,"_19417":49726,"_5":13306,"_25514":49332,"_2665":49727},[],"`REVOKED`",{"_3170":1393,"_28022":1239,"_19417":49729,"_5":13306,"_25514":49332,"_2665":49730},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3170":1394,"_28022":1239,"_19417":49732,"_5":13306,"_25514":49336,"_2665":49733},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3170":1395,"_28022":1239,"_19417":49735,"_5":13306,"_25514":49336,"_2665":49736},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3170":1396,"_28022":1239,"_19417":49738,"_5":13306,"_25514":49336,"_2665":49739},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3170":1397,"_28022":1239,"_19417":49741,"_5":13306,"_25514":49340,"_2665":49742},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3170":1398,"_28022":1239,"_19417":49744,"_5":13306,"_25514":49340,"_2665":49745},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3170":1399,"_28022":1239,"_19417":49747,"_5":13306,"_25514":49344,"_2665":49748},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3170":1400,"_28022":1239,"_19417":49750,"_5":13306,"_25514":49344,"_2665":49751},[],"There are two action types:",{"_3170":1401,"_28022":1239,"_19417":49753,"_5":13306,"_25514":49344,"_2665":49754},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3170":1402,"_28022":1239,"_19417":49756,"_5":13306,"_25514":49344,"_2665":49757},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3170":1403,"_28022":1239,"_19417":49759,"_5":13306,"_25514":49344,"_2665":49760},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3170":1404,"_28022":1239,"_19417":49762,"_5":13306,"_25514":49348,"_2665":49763},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3170":1405,"_28022":1239,"_19417":49765,"_5":13306,"_25514":49348,"_2665":49766},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3170":1406,"_28022":1239,"_19417":49768,"_5":13306,"_25514":49348,"_2665":49769},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3170":1407,"_28022":1239,"_19417":49771,"_5":13306,"_25514":49352,"_2665":49772},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3170":1408,"_28022":1239,"_19417":49774,"_5":13306,"_25514":49352,"_2665":49775},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3170":1409,"_28022":1239,"_19417":49777,"_5":13306,"_25514":49352,"_2665":49778},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3170":1410,"_28022":1239,"_19417":49780,"_5":13306,"_25514":49352,"_2665":49781},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3170":1411,"_28022":1239,"_19417":49783,"_5":13306,"_25514":49352,"_2665":49784},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3170":1412,"_28022":1239,"_19417":49786,"_5":13306,"_25514":49352,"_2665":49787},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3170":1413,"_28022":1239,"_19417":49789,"_5":13306,"_25514":49352,"_2665":49790},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3170":1414,"_28022":1239,"_19417":49792,"_5":13306,"_25514":49352,"_2665":49793},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3170":1415,"_28022":1239,"_19417":49795,"_5":13306,"_25514":49352,"_2665":49796},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3170":1416,"_28022":1239,"_19417":49798,"_5":13306,"_25514":49352,"_2665":49799},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3170":1417,"_28022":1239,"_19417":49801,"_5":13306,"_25514":49352,"_2665":49802},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3170":1418,"_28022":1239,"_19417":49804,"_5":13306,"_25514":49352,"_2665":49805},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3170":1419,"_28022":1239,"_19417":49807,"_5":13306,"_25514":49352,"_2665":49808},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3170":1420,"_28022":1239,"_19417":49810,"_5":13306,"_25514":49352,"_2665":49811},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3170":1421,"_28022":1239,"_19417":49813,"_5":13306,"_25514":49352,"_2665":49814},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3170":1422,"_28022":1239,"_19417":49816,"_5":13306,"_25514":49352,"_2665":49817},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3170":1423,"_28022":1239,"_19417":49819,"_5":13306,"_25514":49352,"_2665":49820},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3170":1424,"_28022":1239,"_19417":49822,"_5":13306,"_25514":49352,"_2665":49823},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3170":1425,"_28022":1239,"_19417":49825,"_5":13306,"_25514":49352,"_2665":49826},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3170":1426,"_28022":1239,"_19417":49828,"_5":13306,"_25514":49352,"_2665":49829},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3170":1427,"_28022":1239,"_19417":49831,"_5":13306,"_25514":49352,"_2665":49832},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3170":1428,"_28022":1428,"_5":13637,"_2665":47807,"_28344":49834,"_19417":49835,"_25514":1428},[45406,46799,47807],[],{"_3170":1429,"_28022":1428,"_19417":49837,"_5":13306,"_25514":1428,"_2665":49838},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3170":1430,"_28022":1428,"_5":28341,"_19417":49840,"_25514":49841,"_2665":49842},[],"/docs/platform/iot-fleets/overview#start-here","Start here",{"_3170":1431,"_28022":1428,"_5":28341,"_19417":49844,"_25514":49845,"_2665":47805},[],"/docs/platform/iot-fleets/overview#devices-and-identities",{"_3170":1432,"_28022":1428,"_5":28341,"_19417":49847,"_25514":49848,"_2665":47988},[],"/docs/platform/iot-fleets/overview#enrollment-with-pki",{"_3170":1433,"_28022":1428,"_5":28341,"_19417":49850,"_25514":49851,"_2665":49269},[],"/docs/platform/iot-fleets/overview#integrations",{"_3170":1434,"_28022":1428,"_5":28341,"_19417":49853,"_25514":49854,"_2665":49855},[],"/docs/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3170":1435,"_28022":1428,"_19417":49857,"_5":13306,"_25514":1428,"_2665":49858},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3170":1436,"_28022":1428,"_19417":49860,"_5":13306,"_25514":49841,"_2665":49861},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3170":1437,"_28022":1428,"_19417":49863,"_5":13306,"_25514":49841,"_2665":49864},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3170":1438,"_28022":1428,"_19417":49866,"_5":13306,"_25514":49845,"_2665":49867},[],"Resource",{"_3170":1439,"_28022":1428,"_19417":49869,"_5":13306,"_25514":49845,"_2665":49870},[],"What it represents",{"_3170":1440,"_28022":1428,"_19417":49872,"_5":13306,"_25514":49845,"_2665":49873},[],"**Device**",{"_3170":1441,"_28022":1428,"_19417":49875,"_5":13306,"_25514":49845,"_2665":49876},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3170":1442,"_28022":1428,"_19417":49878,"_5":13306,"_25514":49845,"_2665":49879},[],"**Identity**",{"_3170":1443,"_28022":1428,"_19417":49881,"_5":13306,"_25514":49845,"_2665":49882},[],"The device's association with its certificates: an active version and a history.",{"_3170":1444,"_28022":1428,"_19417":49884,"_5":13306,"_25514":49845,"_2665":49885},[],"**DMS**",{"_3170":1445,"_28022":1428,"_19417":49887,"_5":13306,"_25514":49845,"_2665":49888},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3170":1446,"_28022":1428,"_19417":49890,"_5":13306,"_25514":49845,"_2665":49891},[],"**Fleet**",{"_3170":1447,"_28022":1428,"_19417":49893,"_5":13306,"_25514":49845,"_2665":49894},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3170":1448,"_28022":1428,"_19417":49896,"_5":13306,"_25514":49845,"_2665":49897},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3170":1449,"_28022":1428,"_19417":49899,"_5":13306,"_25514":49845,"_2665":49900},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3170":1450,"_28022":1428,"_19417":49902,"_5":13306,"_25514":49848,"_2665":49903},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3170":1451,"_28022":1428,"_19417":49905,"_5":13306,"_25514":49848,"_2665":49906},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3170":1452,"_28022":1428,"_19417":49908,"_5":13306,"_25514":49848,"_2665":49909},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3170":1453,"_28022":1428,"_19417":49911,"_5":13306,"_25514":49848,"_2665":49912},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3170":1454,"_28022":1428,"_19417":49914,"_5":13306,"_25514":49848,"_2665":49915},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3170":1455,"_28022":1428,"_19417":49917,"_5":13306,"_25514":49848,"_2665":49918},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3170":1456,"_28022":1428,"_19417":49920,"_5":13306,"_25514":49848,"_2665":49921},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3170":1457,"_28022":1428,"_19417":49923,"_5":13306,"_25514":49848,"_2665":49924},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3170":1458,"_28022":1428,"_19417":49926,"_5":13306,"_25514":49851,"_2665":49927},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3170":1459,"_28022":1428,"_19417":49929,"_5":13306,"_25514":49851,"_2665":49930},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3170":1460,"_28022":1428,"_19417":49932,"_5":13306,"_25514":49854,"_2665":49933},[],"Participant",{"_3170":1461,"_28022":1428,"_19417":49935,"_5":13306,"_25514":49854,"_2665":49936},[],"Responsibility",{"_3170":1462,"_28022":1428,"_19417":49938,"_5":13306,"_25514":49854,"_2665":49939},[],"PKI administrator",{"_3170":1463,"_28022":1428,"_19417":49941,"_5":13306,"_25514":49854,"_2665":49942},[],"CA, issuance profile, chain and revocation publication.",{"_3170":1464,"_28022":1428,"_19417":49944,"_5":13306,"_25514":49854,"_2665":49945},[],"Provisioning administrator",{"_3170":1465,"_28022":1428,"_19417":49947,"_5":13306,"_25514":49854,"_2665":49948},[],"DMS, admission, authentication per operation and inventory.",{"_3170":1466,"_28022":1428,"_19417":49950,"_5":13306,"_25514":49854,"_2665":49951},[],"Device integrator",{"_3170":1467,"_28022":1428,"_19417":49953,"_5":13306,"_25514":49854,"_2665":49954},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3170":1468,"_28022":1428,"_19417":49956,"_5":13306,"_25514":49854,"_2665":49957},[],"Consumer integrator",{"_3170":1469,"_28022":1428,"_19417":49959,"_5":13306,"_25514":49854,"_2665":49960},[],"Trusted issuers, validation and device permissions in the destination.",{"_3170":1470,"_28022":1428,"_19417":49962,"_5":13306,"_25514":49854,"_2665":49963},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3170":1471,"_28022":1471,"_5":13637,"_2665":49965,"_28344":49966,"_19417":49968,"_25514":1471},"Enroll and connect your first device",[45406,46799,47807,49967],"Getting started",[],{"_3170":1472,"_28022":1471,"_19417":49970,"_5":13306,"_25514":1471,"_2665":49971},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3170":1473,"_28022":1471,"_5":28341,"_19417":49973,"_25514":49974,"_2665":45416},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3170":1474,"_28022":1471,"_5":28341,"_19417":49976,"_25514":49977,"_2665":49978},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3170":1475,"_28022":1471,"_5":28341,"_19417":49980,"_25514":49981,"_2665":49982},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3170":1476,"_28022":1471,"_5":28341,"_19417":49984,"_25514":49985,"_2665":49986},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3170":1477,"_28022":1471,"_5":28341,"_19417":49988,"_25514":49989,"_2665":49990},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3170":1478,"_28022":1471,"_5":28341,"_19417":49992,"_25514":49993,"_2665":49994},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3170":1479,"_28022":1471,"_5":28341,"_19417":49996,"_25514":49997,"_2665":49998},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3170":1480,"_28022":1471,"_5":28341,"_19417":50000,"_25514":50001,"_2665":50002},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3170":1481,"_28022":1471,"_19417":50004,"_5":13306,"_25514":1471,"_2665":50005},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3170":1482,"_28022":1471,"_19417":50007,"_5":13306,"_25514":49974,"_2665":50008},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3170":1483,"_28022":1471,"_19417":50010,"_5":13306,"_25514":49974,"_2665":50011},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3170":1484,"_28022":1471,"_19417":50013,"_5":13306,"_25514":49974,"_2665":50014},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3170":1485,"_28022":1471,"_19417":50016,"_5":13306,"_25514":49974,"_2665":50017},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3170":1486,"_28022":1471,"_19417":50019,"_5":13306,"_25514":49974,"_2665":50020},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3170":1487,"_28022":1471,"_19417":50022,"_5":13306,"_25514":49977,"_2665":50023},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3170":1488,"_28022":1471,"_19417":50025,"_5":13306,"_25514":49977,"_2665":50026},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3170":1489,"_28022":1471,"_19417":50028,"_5":13306,"_25514":49981,"_2665":50029},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3170":1490,"_28022":1471,"_19417":50031,"_5":13306,"_25514":49981,"_2665":50032},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3170":1491,"_28022":1471,"_19417":50034,"_5":13306,"_25514":49981,"_2665":50035},[],"Setting",{"_3170":1492,"_28022":1471,"_19417":50037,"_5":13306,"_25514":49981,"_2665":50038},[],"Evaluation value",{"_3170":1493,"_28022":1471,"_19417":50040,"_5":13306,"_25514":49981,"_2665":50041},[],"Enrollment CA",{"_3170":1494,"_28022":1471,"_19417":50043,"_5":13306,"_25514":49981,"_2665":50044},[],"Issuing root from `device-root.pem`.",{"_3170":1495,"_28022":1471,"_19417":50046,"_5":13306,"_25514":49981,"_2665":48118},[],{"_3170":1496,"_28022":1471,"_19417":50048,"_5":13306,"_25514":49981,"_2665":50049},[],"The 1-hour leaf profile you just prepared.",{"_3170":1497,"_28022":1471,"_19417":50051,"_5":13306,"_25514":49981,"_2665":50052},[],"Protocol / Registration Mode",{"_3170":1498,"_28022":1471,"_19417":50054,"_5":13306,"_25514":49981,"_2665":50055},[],"`EST_RFC7030` / `JITP`.",{"_3170":1499,"_28022":1471,"_19417":50057,"_5":13306,"_25514":49981,"_2665":50058},[],"Verify CSR Signature",{"_3170":1500,"_28022":1471,"_19417":50060,"_5":13306,"_25514":49981,"_2665":50061},[],"Enabled.",{"_3170":1501,"_28022":1471,"_19417":50063,"_5":13306,"_25514":49981,"_2665":50064},[],"Enable Replaceable Enrollment",{"_3170":1502,"_28022":1471,"_19417":50066,"_5":13306,"_25514":49981,"_2665":50067},[],"Disabled; the ID must be new.",{"_3170":1503,"_28022":1471,"_19417":50069,"_5":13306,"_25514":49981,"_2665":50070},[],"Initial authentication",{"_3170":1504,"_28022":1471,"_19417":50072,"_5":13306,"_25514":49981,"_2665":50073},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3170":1505,"_28022":1471,"_19417":50075,"_5":13306,"_25514":49981,"_2665":50076},[],"Renewal authentication",{"_3170":1506,"_28022":1471,"_19417":50078,"_5":13306,"_25514":49981,"_2665":50079},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3170":1507,"_28022":1471,"_19417":50081,"_5":13306,"_25514":49981,"_2665":50082},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3170":1508,"_28022":1471,"_19417":50084,"_5":13306,"_25514":49981,"_2665":50085},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3170":1509,"_28022":1471,"_19417":50087,"_5":13306,"_25514":49981,"_2665":50088},[],"Re-enrollment Delta",{"_3170":1510,"_28022":1471,"_19417":50090,"_5":13306,"_25514":49981,"_2665":50091},[],"1 hour.",{"_3170":1511,"_28022":1471,"_19417":50093,"_5":13306,"_25514":49981,"_2665":50094},[],"Preventive / Critical Delta",{"_3170":1512,"_28022":1471,"_19417":50096,"_5":13306,"_25514":49981,"_2665":50097},[],"30 minutes / 10 minutes.",{"_3170":1513,"_28022":1471,"_19417":50099,"_5":13306,"_25514":49981,"_2665":50100},[],"Revoke on Re-enrollment",{"_3170":1514,"_28022":1471,"_19417":50102,"_5":13306,"_25514":49981,"_2665":50103},[],"Disabled to test the successor before retiring the previous identity.",{"_3170":1515,"_28022":1471,"_19417":50105,"_5":13306,"_25514":49981,"_2665":48126},[],{"_3170":1516,"_28022":1471,"_19417":50107,"_5":13306,"_25514":49981,"_2665":50108},[],"Disabled; the operational key is generated in the client.",{"_3170":1517,"_28022":1471,"_19417":50110,"_5":13306,"_25514":49981,"_2665":50111},[],"CA Distribution",{"_3170":1518,"_28022":1471,"_19417":50113,"_5":13306,"_25514":49981,"_2665":50114},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3170":1519,"_28022":1471,"_19417":50116,"_5":13306,"_25514":49981,"_2665":50117},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3170":1520,"_28022":1471,"_19417":50119,"_5":13306,"_25514":49985,"_2665":50120},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3170":1521,"_28022":1471,"_19417":50122,"_5":13306,"_25514":49985,"_2665":50123},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3170":1522,"_28022":1471,"_19417":50125,"_5":13306,"_25514":49989,"_2665":50126},[],"Generate a new key and CSR with the selected identifier:",{"_3170":1523,"_28022":1471,"_19417":50128,"_5":13306,"_25514":49989,"_2665":50129},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3170":1524,"_28022":1471,"_19417":50131,"_5":13306,"_25514":49989,"_2665":50132},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3170":1525,"_28022":1471,"_19417":50134,"_5":13306,"_25514":49993,"_2665":50135},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3170":1526,"_28022":1471,"_19417":50137,"_5":13306,"_25514":49993,"_2665":50138},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3170":1527,"_28022":1471,"_19417":50140,"_5":13306,"_25514":49997,"_2665":50141},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3170":1528,"_28022":1471,"_19417":50143,"_5":13306,"_25514":49997,"_2665":50144},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3170":1529,"_28022":1471,"_19417":50146,"_5":13306,"_25514":49997,"_2665":50147},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3170":1530,"_28022":1471,"_19417":50149,"_5":13306,"_25514":49997,"_2665":50150},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3170":1531,"_28022":1471,"_19417":50152,"_5":13306,"_25514":49997,"_2665":50153},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3170":1532,"_28022":1471,"_19417":50155,"_5":13306,"_25514":50001,"_2665":50156},[],"Check",{"_3170":1533,"_28022":1471,"_19417":50158,"_5":13306,"_25514":50001,"_2665":50159},[],"Expected result",{"_3170":1534,"_28022":1471,"_19417":50161,"_5":13306,"_25514":50001,"_2665":50162},[],"Registration",{"_3170":1535,"_28022":1471,"_19417":50164,"_5":13306,"_25514":50001,"_2665":50165},[],"ID created automatically and correct DMS.",{"_3170":1536,"_28022":1471,"_19417":50167,"_5":13306,"_25514":50001,"_2665":50168},[],"Certificate",{"_3170":1537,"_28022":1471,"_19417":50170,"_5":13306,"_25514":50001,"_2665":50171},[],"CN, profile, serial and key verified.",{"_3170":1538,"_28022":1471,"_19417":50173,"_5":13306,"_25514":50001,"_2665":50174},[],"Inventory",{"_3170":1539,"_28022":1471,"_19417":50176,"_5":13306,"_25514":50001,"_2665":50177},[],"Received serial visible as the current identity and in history.",{"_3170":1540,"_28022":1471,"_19417":50179,"_5":13306,"_25514":50001,"_2665":50180},[],"Consumer",{"_3170":1541,"_28022":1471,"_19417":50182,"_5":13306,"_25514":50001,"_2665":50183},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3170":1542,"_28022":1471,"_19417":50185,"_5":13306,"_25514":50001,"_2665":50186},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3170":1543,"_28022":1471,"_19417":50188,"_5":13306,"_25514":50001,"_2665":50189},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3170":1544,"_28022":1544,"_5":13637,"_2665":47823,"_28344":50191,"_19417":50192,"_25514":1544},[45406,46799,47807,49967],[],{"_3170":1545,"_28022":1544,"_19417":50194,"_5":13306,"_25514":1544,"_2665":50195},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3170":1546,"_28022":1544,"_5":28341,"_19417":50197,"_25514":50198,"_2665":45416},[],"/docs/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3170":1547,"_28022":1544,"_5":28341,"_19417":50200,"_25514":50201,"_2665":50202},[],"/docs/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3170":1548,"_28022":1544,"_5":28341,"_19417":50204,"_25514":50205,"_2665":50206},[],"/docs/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3170":1549,"_28022":1544,"_5":28341,"_19417":50208,"_25514":50209,"_2665":50210},[],"/docs/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3170":1550,"_28022":1544,"_5":28341,"_19417":50212,"_25514":50213,"_2665":50214},[],"/docs/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3170":1551,"_28022":1544,"_5":28341,"_19417":50216,"_25514":50217,"_2665":50218},[],"/docs/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3170":1552,"_28022":1544,"_5":28341,"_19417":50220,"_25514":50221,"_2665":50159},[],"/docs/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3170":1553,"_28022":1544,"_5":28341,"_19417":50223,"_25514":50224,"_2665":50225},[],"/docs/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3170":1554,"_28022":1544,"_5":28341,"_19417":50227,"_25514":50228,"_2665":50229},[],"/docs/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3170":1555,"_28022":1544,"_19417":50231,"_5":13306,"_25514":1544,"_2665":50232},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3170":1556,"_28022":1544,"_19417":50234,"_5":13306,"_25514":1544,"_2665":50235},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3170":1557,"_28022":1544,"_19417":50237,"_5":13306,"_25514":50198,"_2665":50238},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3170":1558,"_28022":1544,"_19417":50240,"_5":13306,"_25514":50198,"_2665":50241},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3170":1559,"_28022":1544,"_19417":50243,"_5":13306,"_25514":50198,"_2665":50244},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3170":1560,"_28022":1544,"_19417":50246,"_5":13306,"_25514":50198,"_2665":50247},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3170":1561,"_28022":1544,"_19417":50249,"_5":13306,"_25514":50201,"_2665":50250},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3170":1562,"_28022":1544,"_19417":50252,"_5":13306,"_25514":50201,"_2665":50253},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3170":1563,"_28022":1544,"_19417":50255,"_5":13306,"_25514":50201,"_2665":50256},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3170":1564,"_28022":1544,"_19417":50258,"_5":13306,"_25514":50201,"_2665":50259},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3170":1565,"_28022":1544,"_19417":50261,"_5":13306,"_25514":50201,"_2665":50262},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3170":1566,"_28022":1544,"_19417":50264,"_5":13306,"_25514":50201,"_2665":50265},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3170":1567,"_28022":1544,"_19417":50267,"_5":13306,"_25514":50201,"_2665":50268},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3170":1568,"_28022":1544,"_19417":50270,"_5":13306,"_25514":50201,"_2665":50271},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3170":1569,"_28022":1544,"_19417":50273,"_5":13306,"_25514":50205,"_2665":50274},[],"Open **Managed Devices** and the registration action. Complete:",{"_3170":1570,"_28022":1544,"_19417":50276,"_5":13306,"_25514":50205,"_2665":50277},[],"**Device ID**: `device-001`.",{"_3170":1571,"_28022":1544,"_19417":50279,"_5":13306,"_25514":50205,"_2665":50280},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3170":1572,"_28022":1544,"_19417":50282,"_5":13306,"_25514":50205,"_2665":50283},[],"**Icon** and **Tags**: optional classification.",{"_3170":1573,"_28022":1544,"_19417":50285,"_5":13306,"_25514":50205,"_2665":50286},[],"Confirm registration.",{"_3170":1574,"_28022":1544,"_19417":50288,"_5":13306,"_25514":50209,"_2665":50289},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3170":1575,"_28022":1544,"_19417":50291,"_5":13306,"_25514":50209,"_2665":50292},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3170":1576,"_28022":1544,"_19417":50294,"_5":13306,"_25514":50213,"_2665":50295},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3170":1577,"_28022":1544,"_19417":50297,"_5":13306,"_25514":50213,"_2665":50298},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3170":1578,"_28022":1544,"_19417":50300,"_5":13306,"_25514":50217,"_2665":50301},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3170":1579,"_28022":1544,"_19417":50303,"_5":13306,"_25514":50217,"_2665":50304},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3170":1580,"_28022":1544,"_19417":50306,"_5":13306,"_25514":50221,"_2665":50156},[],{"_3170":1581,"_28022":1544,"_19417":50308,"_5":13306,"_25514":50221,"_2665":50309},[],"Result",{"_3170":1582,"_28022":1544,"_19417":50311,"_5":13306,"_25514":50221,"_2665":50312},[],"Device",{"_3170":1583,"_28022":1544,"_19417":50314,"_5":13306,"_25514":50221,"_2665":50315},[],"`device-001` appears in inventory with the expected DMS.",{"_3170":1584,"_28022":1544,"_19417":50317,"_5":13306,"_25514":50221,"_2665":50318},[],"Current identity",{"_3170":1585,"_28022":1544,"_19417":50320,"_5":13306,"_25514":50221,"_2665":50321},[],"The associated certificate matches the one you verified in PKI.",{"_3170":1586,"_28022":1544,"_19417":50323,"_5":13306,"_25514":50221,"_2665":50324},[],"History",{"_3170":1587,"_28022":1544,"_19417":50326,"_5":13306,"_25514":50221,"_2665":50327},[],"The associated issuance appears with its serial number and dates.",{"_3170":1588,"_28022":1544,"_19417":50329,"_5":13306,"_25514":50221,"_2665":50330},[],"Key and certificate",{"_3170":1589,"_28022":1544,"_19417":50332,"_5":13306,"_25514":50221,"_2665":50333},[],"You have the verified pair ready to install on the device.",{"_3170":1590,"_28022":1544,"_19417":50335,"_5":13306,"_25514":50224,"_2665":50336},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3170":1591,"_28022":1544,"_19417":50338,"_5":13306,"_25514":50224,"_2665":50339},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3170":1592,"_28022":1544,"_19417":50341,"_5":13306,"_25514":50224,"_2665":50342},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3170":1593,"_28022":1544,"_19417":50344,"_5":13306,"_25514":50224,"_2665":50345},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3170":1594,"_28022":1544,"_19417":50347,"_5":13306,"_25514":50228,"_2665":50348},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3170":1595,"_28022":1544,"_19417":50350,"_5":13306,"_25514":50228,"_2665":50351},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3170":1596,"_28022":1544,"_19417":50353,"_5":13306,"_25514":50228,"_2665":50354},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3170":1597,"_28022":1597,"_5":13637,"_2665":50356,"_28344":50357,"_19417":50358,"_25514":1597},"Lamassu IoT Platform",[45406,46799],[],{"_3170":1598,"_28022":1597,"_19417":50360,"_5":13306,"_25514":1597,"_2665":50361},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3170":1599,"_28022":1597,"_5":28341,"_19417":50363,"_25514":50364,"_2665":49842},[],"/docs/platform/overview#start-here",{"_3170":1600,"_28022":1597,"_5":28341,"_19417":50366,"_25514":50367,"_2665":50368},[],"/docs/platform/overview#choose-your-path","Choose your path",{"_3170":1601,"_28022":1597,"_5":28341,"_19417":50370,"_25514":50371,"_2665":50372},[],"/docs/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3170":1602,"_28022":1597,"_5":28341,"_19417":50374,"_25514":50375,"_2665":50376},[],"/docs/platform/overview#core-capabilities","Core capabilities",{"_3170":1603,"_28022":1597,"_5":28341,"_19417":50378,"_25514":50379,"_2665":50380},[],"/docs/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3170":1604,"_28022":1597,"_5":28341,"_19417":50382,"_25514":50383,"_2665":50384},[],"/docs/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3170":1605,"_28022":1597,"_5":28341,"_19417":50386,"_25514":50387,"_2665":50388},[],"/docs/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3170":1606,"_28022":1597,"_5":28341,"_19417":50390,"_25514":50391,"_2665":50392},[],"/docs/platform/overview#automate-device-identities","Automate device identities",{"_3170":1607,"_28022":1597,"_5":28341,"_19417":50394,"_25514":50395,"_2665":50396},[],"/docs/platform/overview#publish-validation-status","Publish validation status",{"_3170":1608,"_28022":1597,"_5":28341,"_19417":50398,"_25514":50399,"_2665":50400},[],"/docs/platform/overview#react-to-events","React to events",{"_3170":1609,"_28022":1597,"_5":28341,"_19417":50402,"_25514":50403,"_2665":50404},[],"/docs/platform/overview#operational-reference","Operational reference",{"_3170":1610,"_28022":1597,"_19417":50406,"_5":13306,"_25514":1597,"_2665":50407},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3170":1611,"_28022":1597,"_19417":50409,"_5":13306,"_25514":50364,"_2665":50410},[],"Choose the result you need:",{"_3170":1612,"_28022":1597,"_19417":50412,"_5":13306,"_25514":50364,"_2665":50413},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3170":1613,"_28022":1597,"_19417":50415,"_5":13306,"_25514":50364,"_2665":50416},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3170":1614,"_28022":1597,"_19417":50418,"_5":13306,"_25514":50364,"_2665":50419},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3170":1615,"_28022":1597,"_19417":50421,"_5":13306,"_25514":50367,"_2665":50422},[],"Section",{"_3170":1616,"_28022":1597,"_19417":50424,"_5":13306,"_25514":50367,"_2665":50425},[],"What you manage",{"_3170":1617,"_28022":1597,"_19417":50427,"_5":13306,"_25514":50367,"_2665":50428},[],"Entry point",{"_3170":1618,"_28022":1597,"_19417":50430,"_5":13306,"_25514":50367,"_2665":50431},[],"**PKI**",{"_3170":1619,"_28022":1597,"_19417":50433,"_5":13306,"_25514":50367,"_2665":50434},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3170":1620,"_28022":1597,"_19417":50436,"_5":13306,"_25514":50367,"_2665":50437},[],"PKI overview",{"_3170":1621,"_28022":1597,"_19417":50439,"_5":13306,"_25514":50367,"_2665":50440},[],"**IoT Fleets**",{"_3170":1622,"_28022":1597,"_19417":50442,"_5":13306,"_25514":50367,"_2665":50443},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3170":1623,"_28022":1597,"_19417":50445,"_5":13306,"_25514":50367,"_2665":50446},[],"IoT Fleets overview",{"_3170":1624,"_28022":1597,"_19417":50448,"_5":13306,"_25514":50367,"_2665":50449},[],"**Administration**",{"_3170":1625,"_28022":1597,"_19417":50451,"_5":13306,"_25514":50367,"_2665":50452},[],"Operator permissions, audit and event subscriptions.",{"_3170":1626,"_28022":1597,"_19417":50454,"_5":13306,"_25514":50367,"_2665":46797},[],{"_3170":1627,"_28022":1597,"_19417":50456,"_5":13306,"_25514":50367,"_2665":50457},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3170":1628,"_28022":1597,"_19417":50459,"_5":13306,"_25514":50371,"_2665":50460},[],"An identity's journey connects four responsibilities:",{"_3170":1629,"_28022":1597,"_19417":50462,"_5":13306,"_25514":50371,"_2665":50463},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3170":1630,"_28022":1597,"_19417":50465,"_5":13306,"_25514":50371,"_2665":50466},[],"The provisioning administrator configures the DMS and initial trust.",{"_3170":1631,"_28022":1597,"_19417":50468,"_5":13306,"_25514":50371,"_2665":50469},[],"The device client requests a certificate and installs it with the matching key.",{"_3170":1632,"_28022":1597,"_19417":50471,"_5":13306,"_25514":50371,"_2665":50472},[],"The consumer validates the identity and applies its access permissions.",{"_3170":1633,"_28022":1597,"_19417":50474,"_5":13306,"_25514":50371,"_2665":50475},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3170":1634,"_28022":1597,"_19417":50477,"_5":13306,"_25514":50379,"_2665":50478},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3170":1635,"_28022":1597,"_19417":50480,"_5":13306,"_25514":50383,"_2665":50481},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3170":1636,"_28022":1597,"_19417":50483,"_5":13306,"_25514":50387,"_2665":50484},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3170":1637,"_28022":1597,"_19417":50486,"_5":13306,"_25514":50391,"_2665":50487},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3170":1638,"_28022":1597,"_19417":50489,"_5":13306,"_25514":50395,"_2665":50490},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3170":1639,"_28022":1597,"_19417":50492,"_5":13306,"_25514":50399,"_2665":50493},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3170":1640,"_28022":1597,"_19417":50495,"_5":13306,"_25514":50403,"_2665":49936},[],{"_3170":1641,"_28022":1597,"_19417":50497,"_5":13306,"_25514":50403,"_2665":50498},[],"What it prepares or checks",{"_3170":1642,"_28022":1597,"_19417":50500,"_5":13306,"_25514":50403,"_2665":49939},[],{"_3170":1643,"_28022":1597,"_19417":50502,"_5":13306,"_25514":50403,"_2665":50503},[],"Key custody, CA hierarchy, profiles and validation.",{"_3170":1644,"_28022":1597,"_19417":50505,"_5":13306,"_25514":50403,"_2665":50506},[],"Fleet administrator",{"_3170":1645,"_28022":1597,"_19417":50508,"_5":13306,"_25514":50403,"_2665":50509},[],"DMS, device admission, renewal policy and inventory.",{"_3170":1646,"_28022":1597,"_19417":50511,"_5":13306,"_25514":50403,"_2665":49951},[],{"_3170":1647,"_28022":1597,"_19417":50513,"_5":13306,"_25514":50403,"_2665":50514},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3170":1648,"_28022":1597,"_19417":50516,"_5":13306,"_25514":50403,"_2665":49957},[],{"_3170":1649,"_28022":1597,"_19417":50518,"_5":13306,"_25514":50403,"_2665":50519},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3170":1650,"_28022":1597,"_19417":50521,"_5":13306,"_25514":50403,"_2665":50522},[],"Infrastructure operator",{"_3170":1651,"_28022":1597,"_19417":50524,"_5":13306,"_25514":50403,"_2665":50525},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3170":1652,"_28022":1597,"_19417":50527,"_5":13306,"_25514":50403,"_2665":50528},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3170":1653,"_28022":1653,"_5":13637,"_2665":50530,"_28344":50531,"_19417":50534,"_25514":1653},"CA hierarchy and rotation",[45406,46799,50532,50533],"PKI","Keys, authorities and certificates",[],{"_3170":1654,"_28022":1653,"_19417":50536,"_5":13306,"_25514":1653,"_2665":50537},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3170":1655,"_28022":1653,"_5":28341,"_19417":50539,"_25514":50540,"_2665":50541},[],"/docs/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3170":1656,"_28022":1653,"_5":28341,"_19417":50543,"_25514":50544,"_2665":50545},[],"/docs/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3170":1657,"_28022":1653,"_5":28341,"_19417":50547,"_25514":50548,"_2665":50549},[],"/docs/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3170":1658,"_28022":1653,"_5":28341,"_19417":50551,"_25514":50552,"_2665":50553},[],"/docs/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3170":1659,"_28022":1653,"_5":28341,"_19417":50555,"_25514":50556,"_2665":50557},[],"/docs/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3170":1660,"_28022":1653,"_5":28341,"_19417":50559,"_25514":50560,"_2665":50561},[],"/docs/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3170":1661,"_28022":1653,"_5":28341,"_19417":50563,"_25514":50564,"_2665":50565},[],"/docs/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3170":1662,"_28022":1653,"_5":28341,"_19417":50567,"_25514":50568,"_2665":50569},[],"/docs/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3170":1663,"_28022":1653,"_5":28341,"_19417":50571,"_25514":50572,"_2665":50573},[],"/docs/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3170":1664,"_28022":1653,"_5":28341,"_19417":50575,"_25514":50576,"_2665":50577},[],"/docs/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3170":1665,"_28022":1653,"_5":28341,"_19417":50579,"_25514":50580,"_2665":50581},[],"/docs/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3170":1666,"_28022":1653,"_5":28341,"_19417":50583,"_25514":50584,"_2665":50585},[],"/docs/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3170":1667,"_28022":1653,"_19417":50587,"_5":13306,"_25514":1653,"_2665":50588},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3170":1668,"_28022":1653,"_19417":50590,"_5":13306,"_25514":1653,"_2665":50591},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3170":1669,"_28022":1653,"_19417":50593,"_5":13306,"_25514":50540,"_2665":50594},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3170":1670,"_28022":1653,"_19417":50596,"_5":13306,"_25514":50540,"_2665":50597},[],"environment, such as production and preproduction;",{"_3170":1671,"_28022":1653,"_19417":50599,"_5":13306,"_25514":50540,"_2665":50600},[],"owner or operating team;",{"_3170":1672,"_28022":1653,"_19417":50602,"_5":13306,"_25514":50540,"_2665":50603},[],"device family or manufacturing process;",{"_3170":1673,"_28022":1653,"_19417":50605,"_5":13306,"_25514":50540,"_2665":50606},[],"region or regulatory requirement;",{"_3170":1674,"_28022":1653,"_19417":50608,"_5":13306,"_25514":50540,"_2665":50609},[],"cryptographic engine or key policy;",{"_3170":1675,"_28022":1653,"_19417":50611,"_5":13306,"_25514":50540,"_2665":50612},[],"maintenance window and renewal cadence.",{"_3170":1676,"_28022":1653,"_19417":50614,"_5":13306,"_25514":50540,"_2665":50615},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3170":1677,"_28022":1653,"_19417":50617,"_5":13306,"_25514":50540,"_2665":50618},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3170":1678,"_28022":1653,"_19417":50620,"_5":13306,"_25514":50544,"_2665":50621},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3170":1679,"_28022":1653,"_19417":50623,"_5":13306,"_25514":50544,"_2665":50624},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3170":1680,"_28022":1653,"_19417":50626,"_5":13306,"_25514":50544,"_2665":50627},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3170":1681,"_28022":1653,"_19417":50629,"_5":13306,"_25514":50548,"_2665":50630},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3170":1682,"_28022":1653,"_19417":50632,"_5":13306,"_25514":50548,"_2665":50633},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3170":1683,"_28022":1653,"_19417":50635,"_5":13306,"_25514":50548,"_2665":50636},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3170":1684,"_28022":1653,"_19417":50638,"_5":13306,"_25514":50548,"_2665":50639},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3170":1685,"_28022":1653,"_19417":50641,"_5":13306,"_25514":50556,"_2665":50642},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3170":1686,"_28022":1653,"_19417":50644,"_5":13306,"_25514":50560,"_2665":50645},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3170":1687,"_28022":1653,"_19417":50647,"_5":13306,"_25514":50564,"_2665":50648},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3170":1688,"_28022":1653,"_19417":50650,"_5":13306,"_25514":50568,"_2665":50651},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3170":1689,"_28022":1653,"_19417":50653,"_5":13306,"_25514":50572,"_2665":50654},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3170":1690,"_28022":1653,"_19417":50656,"_5":13306,"_25514":50576,"_2665":50657},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3170":1691,"_28022":1653,"_19417":50659,"_5":13306,"_25514":50580,"_2665":50660},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3170":1692,"_28022":1653,"_19417":50662,"_5":13306,"_25514":50580,"_2665":50663},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3170":1693,"_28022":1653,"_19417":50665,"_5":13306,"_25514":50580,"_2665":50666},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3170":1694,"_28022":1653,"_19417":50668,"_5":13306,"_25514":50580,"_2665":50669},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3170":1695,"_28022":1653,"_19417":50671,"_5":13306,"_25514":50584,"_2665":50672},[],"The new chain ends in an anchor installed by the consumer.",{"_3170":1696,"_28022":1653,"_19417":50674,"_5":13306,"_25514":50584,"_2665":50675},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3170":1697,"_28022":1653,"_19417":50677,"_5":13306,"_25514":50584,"_2665":50678},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3170":1698,"_28022":1653,"_19417":50680,"_5":13306,"_25514":50584,"_2665":50681},[],"Re-enrollment accepts the old identity during the planned period.",{"_3170":1699,"_28022":1653,"_19417":50683,"_5":13306,"_25514":50584,"_2665":50684},[],"OCSP and CRL respond for the authorities that remain active.",{"_3170":1700,"_28022":1653,"_19417":50686,"_5":13306,"_25514":50584,"_2665":50687},[],"No DMS is left accidentally issuing from the old CA.",{"_3170":1701,"_28022":1653,"_19417":50689,"_5":13306,"_25514":50584,"_2665":50690},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3170":1702,"_28022":1702,"_5":13637,"_2665":50692,"_28344":50693,"_19417":50694,"_25514":1702},"Certification authorities",[45406,46799,50532,50533],[],{"_3170":1703,"_28022":1702,"_19417":50696,"_5":13306,"_25514":1702,"_2665":50697},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3170":1704,"_28022":1702,"_5":28341,"_19417":50699,"_25514":50700,"_2665":50701},[],"/docs/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3170":1705,"_28022":1702,"_5":28341,"_19417":50703,"_25514":50704,"_2665":50705},[],"/docs/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3170":1706,"_28022":1702,"_5":28341,"_19417":50707,"_25514":50708,"_2665":45416},[],"/docs/platform/pki/certificate-authorities#before-you-begin",{"_3170":1707,"_28022":1702,"_5":28341,"_19417":50710,"_25514":50711,"_2665":50712},[],"/docs/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3170":1708,"_28022":1702,"_5":28341,"_19417":50714,"_25514":50715,"_2665":50716},[],"/docs/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3170":1709,"_28022":1702,"_5":28341,"_19417":50718,"_25514":50719,"_2665":50720},[],"/docs/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3170":1710,"_28022":1702,"_5":28341,"_19417":50722,"_25514":50723,"_2665":50724},[],"/docs/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3170":1711,"_28022":1702,"_5":28341,"_19417":50726,"_25514":50727,"_2665":50728},[],"/docs/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3170":1712,"_28022":1702,"_5":28341,"_19417":50730,"_25514":50731,"_2665":50732},[],"/docs/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3170":1713,"_28022":1702,"_5":28341,"_19417":50734,"_25514":50735,"_2665":50736},[],"/docs/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3170":1714,"_28022":1702,"_5":28341,"_19417":50738,"_25514":50739,"_2665":50740},[],"/docs/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3170":1715,"_28022":1702,"_5":28341,"_19417":50742,"_25514":50743,"_2665":50744},[],"/docs/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3170":1716,"_28022":1702,"_5":28341,"_19417":50746,"_25514":50747,"_2665":50748},[],"/docs/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3170":1717,"_28022":1702,"_5":28341,"_19417":50750,"_25514":50751,"_2665":50752},[],"/docs/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3170":1718,"_28022":1702,"_5":28341,"_19417":50754,"_25514":50755,"_2665":50756},[],"/docs/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3170":1719,"_28022":1702,"_5":28341,"_19417":50758,"_25514":50759,"_2665":50760},[],"/docs/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3170":1720,"_28022":1702,"_5":28341,"_19417":50762,"_25514":50763,"_2665":50764},[],"/docs/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3170":1721,"_28022":1702,"_5":28341,"_19417":50766,"_25514":50767,"_2665":50768},[],"/docs/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3170":1722,"_28022":1702,"_5":28341,"_19417":50770,"_25514":50771,"_2665":50772},[],"/docs/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3170":1723,"_28022":1702,"_5":28341,"_19417":50774,"_25514":50775,"_2665":50776},[],"/docs/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3170":1724,"_28022":1702,"_5":28341,"_19417":50778,"_25514":50779,"_2665":50780},[],"/docs/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3170":1725,"_28022":1702,"_5":28341,"_19417":50782,"_25514":50783,"_2665":50784},[],"/docs/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3170":1726,"_28022":1702,"_19417":50786,"_5":13306,"_25514":1702,"_2665":50787},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3170":1727,"_28022":1702,"_19417":50789,"_5":13306,"_25514":1702,"_2665":50790},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3170":1728,"_28022":1702,"_19417":50792,"_5":13306,"_25514":1702,"_2665":50793},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3170":1729,"_28022":1702,"_19417":50795,"_5":13306,"_25514":50700,"_2665":50796},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3170":1730,"_28022":1702,"_19417":50798,"_5":13306,"_25514":50700,"_2665":50799},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3170":1731,"_28022":1702,"_19417":50801,"_5":13306,"_25514":50700,"_2665":50802},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3170":1732,"_28022":1702,"_19417":50804,"_5":13306,"_25514":50700,"_2665":50805},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3170":1733,"_28022":1702,"_19417":50807,"_5":13306,"_25514":50700,"_2665":50808},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3170":1734,"_28022":1702,"_19417":50810,"_5":13306,"_25514":50708,"_2665":50811},[],"Decide whether the CA will be a root or an intermediate.",{"_3170":1735,"_28022":1702,"_19417":50813,"_5":13306,"_25514":50708,"_2665":50814},[],"Choose the engine that will keep the key.",{"_3170":1736,"_28022":1702,"_19417":50816,"_5":13306,"_25514":50708,"_2665":50817},[],"Define a validity longer than that of the certificates it will issue.",{"_3170":1737,"_28022":1702,"_19417":50819,"_5":13306,"_25514":50708,"_2665":50820},[],"For an intermediate CA, make sure the parent CA is active.",{"_3170":1738,"_28022":1702,"_19417":50822,"_5":13306,"_25514":50711,"_2665":50823},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3170":1739,"_28022":1702,"_19417":50825,"_5":13306,"_25514":50715,"_2665":50826},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3170":1740,"_28022":1702,"_19417":50828,"_5":13306,"_25514":50715,"_2665":50829},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3170":1741,"_28022":1702,"_19417":50831,"_5":13306,"_25514":50719,"_2665":50832},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3170":1742,"_28022":1702,"_19417":50834,"_5":13306,"_25514":50723,"_2665":50835},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3170":1743,"_28022":1702,"_19417":50837,"_5":13306,"_25514":50723,"_2665":50838},[],"`C`: two-letter ISO 3166-1 country code.",{"_3170":1744,"_28022":1702,"_19417":50840,"_5":13306,"_25514":50723,"_2665":50841},[],"`ST`: state or province.",{"_3170":1745,"_28022":1702,"_19417":50843,"_5":13306,"_25514":50723,"_2665":50844},[],"`L`: locality.",{"_3170":1746,"_28022":1702,"_19417":50846,"_5":13306,"_25514":50723,"_2665":50847},[],"`O`: organization.",{"_3170":1747,"_28022":1702,"_19417":50849,"_5":13306,"_25514":50723,"_2665":50850},[],"`OU`: organizational unit.",{"_3170":1748,"_28022":1702,"_19417":50852,"_5":13306,"_25514":50723,"_2665":50853},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3170":1749,"_28022":1702,"_19417":50855,"_5":13306,"_25514":50727,"_2665":50856},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3170":1750,"_28022":1702,"_19417":50858,"_5":13306,"_25514":50727,"_2665":50859},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3170":1751,"_28022":1702,"_19417":50861,"_5":13306,"_25514":50731,"_2665":50862},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3170":1752,"_28022":1702,"_19417":50864,"_5":13306,"_25514":50731,"_2665":50865},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3170":1753,"_28022":1702,"_19417":50867,"_5":13306,"_25514":50735,"_2665":50868},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3170":1754,"_28022":1702,"_19417":50870,"_5":13306,"_25514":50735,"_2665":50871},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3170":1755,"_28022":1702,"_19417":50873,"_5":13306,"_25514":50739,"_2665":50874},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3170":1756,"_28022":1702,"_19417":50876,"_5":13306,"_25514":50743,"_2665":50877},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3170":1757,"_28022":1702,"_19417":50879,"_5":13306,"_25514":50747,"_2665":50880},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3170":1758,"_28022":1702,"_19417":50882,"_5":13306,"_25514":50751,"_2665":50883},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3170":1759,"_28022":1702,"_19417":50885,"_5":13306,"_25514":50755,"_2665":50886},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3170":1760,"_28022":1702,"_19417":50888,"_5":13306,"_25514":50755,"_2665":50889},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3170":1761,"_28022":1702,"_19417":50891,"_5":13306,"_25514":50759,"_2665":50892},[],"Open a CA from the inventory to review:",{"_3170":1762,"_28022":1702,"_19417":50894,"_5":13306,"_25514":50759,"_2665":50895},[],"Status and validity period.",{"_3170":1763,"_28022":1702,"_19417":50897,"_5":13306,"_25514":50759,"_2665":50898},[],"Certificate and chain in PEM format.",{"_3170":1764,"_28022":1702,"_19417":50900,"_5":13306,"_25514":50759,"_2665":50901},[],"Number of active, expired and revoked certificates.",{"_3170":1765,"_28022":1702,"_19417":50903,"_5":13306,"_25514":50759,"_2665":50904},[],"Certificates issued in **Issued Certificates**.",{"_3170":1766,"_28022":1702,"_19417":50906,"_5":13306,"_25514":50759,"_2665":50907},[],"The CRL linked to the authority.",{"_3170":1767,"_28022":1702,"_19417":50909,"_5":13306,"_25514":50759,"_2665":50910},[],"Metadata and the associated cryptographic engine.",{"_3170":1768,"_28022":1702,"_19417":50912,"_5":13306,"_25514":50759,"_2665":50913},[],"You can filter the inventory by name, status and CA type.",{"_3170":1769,"_28022":1702,"_19417":50915,"_5":13306,"_25514":50763,"_2665":50916},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3170":1770,"_28022":1702,"_19417":50918,"_5":13306,"_25514":50763,"_2665":50919},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3170":1771,"_28022":1702,"_19417":50921,"_5":13306,"_25514":50763,"_2665":50922},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3170":1772,"_28022":1702,"_19417":50924,"_5":13306,"_25514":50763,"_2665":50925},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3170":1773,"_28022":1702,"_19417":50927,"_5":13306,"_25514":50767,"_2665":50928},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3170":1774,"_28022":1702,"_19417":50930,"_5":13306,"_25514":50771,"_2665":50931},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3170":1775,"_28022":1702,"_19417":50933,"_5":13306,"_25514":50775,"_2665":50934},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3170":1776,"_28022":1702,"_19417":50936,"_5":13306,"_25514":50779,"_2665":50937},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3170":1777,"_28022":1702,"_19417":50939,"_5":13306,"_25514":50783,"_2665":50940},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3170":1778,"_28022":1702,"_19417":50942,"_5":13306,"_25514":50783,"_2665":50943},[],"Permanent deletion is only available after revoking. Delete the record only when your retention and audit policy allows it.",{"_3170":1779,"_28022":1779,"_5":13637,"_2665":50945,"_28344":50946,"_19417":50947,"_25514":1779},"Certificate profiles",[45406,46799,50532,50533],[],{"_3170":1780,"_28022":1779,"_19417":50949,"_5":13306,"_25514":1779,"_2665":50950},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3170":1781,"_28022":1779,"_5":28341,"_19417":50952,"_25514":50953,"_2665":50954},[],"/docs/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3170":1782,"_28022":1779,"_5":28341,"_19417":50956,"_25514":50957,"_2665":50958},[],"/docs/platform/pki/certificate-profiles#validity","Validity",{"_3170":1783,"_28022":1779,"_5":28341,"_19417":50960,"_25514":50961,"_2665":50962},[],"/docs/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3170":1784,"_28022":1779,"_5":28341,"_19417":50964,"_25514":50965,"_2665":50966},[],"/docs/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3170":1785,"_28022":1779,"_5":28341,"_19417":50968,"_25514":50969,"_2665":50970},[],"/docs/platform/pki/certificate-profiles#subject","Subject",{"_3170":1786,"_28022":1779,"_5":28341,"_19417":50972,"_25514":50973,"_2665":50974},[],"/docs/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3170":1787,"_28022":1779,"_5":28341,"_19417":50976,"_25514":50977,"_2665":50978},[],"/docs/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3170":1788,"_28022":1779,"_5":28341,"_19417":50980,"_25514":50981,"_2665":50982},[],"/docs/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3170":1789,"_28022":1779,"_5":28341,"_19417":50984,"_25514":50985,"_2665":50986},[],"/docs/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3170":1790,"_28022":1779,"_5":28341,"_19417":50988,"_25514":50989,"_2665":50990},[],"/docs/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3170":1791,"_28022":1779,"_5":28341,"_19417":50992,"_25514":50993,"_2665":50994},[],"/docs/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3170":1792,"_28022":1779,"_5":28341,"_19417":50996,"_25514":50997,"_2665":50998},[],"/docs/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3170":1793,"_28022":1779,"_5":28341,"_19417":51000,"_25514":51001,"_2665":51002},[],"/docs/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3170":1794,"_28022":1779,"_5":28341,"_19417":51004,"_25514":51005,"_2665":51006},[],"/docs/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3170":1795,"_28022":1779,"_5":28341,"_19417":51008,"_25514":51009,"_2665":51010},[],"/docs/platform/pki/certificate-profiles#design-examples","Design examples",{"_3170":1796,"_28022":1779,"_5":28341,"_19417":51012,"_25514":51013,"_2665":51014},[],"/docs/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3170":1797,"_28022":1779,"_19417":51016,"_5":13306,"_25514":1779,"_2665":51017},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3170":1798,"_28022":1779,"_19417":51019,"_5":13306,"_25514":1779,"_2665":51020},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3170":1799,"_28022":1779,"_19417":51022,"_5":13306,"_25514":50957,"_2665":51023},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3170":1800,"_28022":1779,"_19417":51025,"_5":13306,"_25514":50957,"_2665":51026},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3170":1801,"_28022":1779,"_19417":51028,"_5":13306,"_25514":50961,"_2665":51029},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_3170":1802,"_28022":1779,"_19417":51031,"_5":13306,"_25514":50965,"_2665":51032},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3170":1803,"_28022":1779,"_19417":51034,"_5":13306,"_25514":50965,"_2665":51035},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3170":1804,"_28022":1779,"_19417":51037,"_5":13306,"_25514":50965,"_2665":51038},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3170":1805,"_28022":1779,"_19417":51040,"_5":13306,"_25514":50969,"_2665":51041},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3170":1806,"_28022":1779,"_19417":51043,"_5":13306,"_25514":50973,"_2665":51044},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3170":1807,"_28022":1779,"_19417":51046,"_5":13306,"_25514":50973,"_2665":51047},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3170":1808,"_28022":1779,"_19417":51049,"_5":13306,"_25514":50977,"_2665":51050},[],"The cryptographic enforcement can:",{"_3170":1809,"_28022":1779,"_19417":51052,"_5":13306,"_25514":50977,"_2665":51053},[],"allow or block RSA keys;",{"_3170":1810,"_28022":1779,"_19417":51055,"_5":13306,"_25514":50977,"_2665":51056},[],"limit the supported RSA sizes;",{"_3170":1811,"_28022":1779,"_19417":51058,"_5":13306,"_25514":50977,"_2665":51059},[],"allow or block ECDSA keys;",{"_3170":1812,"_28022":1779,"_19417":51061,"_5":13306,"_25514":50977,"_2665":51062},[],"limit the supported ECDSA sizes or curves.",{"_3170":1813,"_28022":1779,"_19417":51064,"_5":13306,"_25514":50977,"_2665":51065},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3170":1814,"_28022":1779,"_19417":51067,"_5":13306,"_25514":50981,"_2665":51068},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3170":1815,"_28022":1779,"_19417":51070,"_5":13306,"_25514":50981,"_2665":48560},[],{"_3170":1816,"_28022":1779,"_19417":51072,"_5":13306,"_25514":50981,"_2665":51073},[],"First choice",{"_3170":1817,"_28022":1779,"_19417":51075,"_5":13306,"_25514":50981,"_2665":51076},[],"Second choice",{"_3170":1818,"_28022":1779,"_19417":51078,"_5":13306,"_25514":50981,"_2665":51079},[],"If neither is supplied",{"_3170":1819,"_28022":1779,"_19417":51081,"_5":13306,"_25514":50981,"_2665":51082},[],"Direct signing with a CA",{"_3170":1820,"_28022":1779,"_19417":51084,"_5":13306,"_25514":50981,"_2665":51085},[],"`issuance_profile` embedded in the request",{"_3170":1821,"_28022":1779,"_19417":51087,"_5":13306,"_25514":50981,"_2665":51088},[],"Request `issuance_profile_id`",{"_3170":1822,"_28022":1779,"_19417":51090,"_5":13306,"_25514":50981,"_2665":51091},[],"CA default profile (`profile_id`).",{"_3170":1823,"_28022":1779,"_19417":51093,"_5":13306,"_25514":50981,"_2665":51094},[],"Issuance through a DMS",{"_3170":1824,"_28022":1779,"_19417":51096,"_5":13306,"_25514":50981,"_2665":51097},[],"`settings.issuance_profile_id`",{"_3170":1825,"_28022":1779,"_19417":51099,"_5":13306,"_25514":50981,"_2665":51100},[],"`settings.issuance_profile` embedded in the DMS",{"_3170":1826,"_28022":1779,"_19417":51102,"_5":13306,"_25514":50981,"_2665":51103},[],"Enrollment CA default profile.",{"_3170":1827,"_28022":1779,"_19417":51105,"_5":13306,"_25514":50981,"_2665":51106},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3170":1828,"_28022":1779,"_19417":51108,"_5":13306,"_25514":50981,"_2665":51109},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3170":1829,"_28022":1779,"_19417":51111,"_5":13306,"_25514":50989,"_2665":51112},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3170":1830,"_28022":1779,"_19417":51114,"_5":13306,"_25514":50993,"_2665":51115},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3170":1831,"_28022":1779,"_19417":51117,"_5":13306,"_25514":50997,"_2665":51118},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3170":1832,"_28022":1779,"_19417":51120,"_5":13306,"_25514":51001,"_2665":51121},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3170":1833,"_28022":1779,"_19417":51123,"_5":13306,"_25514":51005,"_2665":51124},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3170":1834,"_28022":1779,"_19417":51126,"_5":13306,"_25514":51005,"_2665":51127},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3170":1835,"_28022":1779,"_19417":51129,"_5":13306,"_25514":51009,"_2665":51130},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3170":1836,"_28022":1779,"_19417":51132,"_5":13306,"_25514":51009,"_2665":51133},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3170":1837,"_28022":1779,"_19417":51135,"_5":13306,"_25514":51009,"_2665":51136},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3170":1838,"_28022":1779,"_19417":51138,"_5":13306,"_25514":51009,"_2665":51139},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3170":1839,"_28022":1779,"_19417":51141,"_5":13306,"_25514":51013,"_2665":51142},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3170":1840,"_28022":1779,"_19417":51144,"_5":13306,"_25514":51013,"_2665":51145},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3170":1841,"_28022":1841,"_5":13637,"_2665":51147,"_28344":51148,"_19417":51150,"_25514":1841},"Certificate validation",[45406,46799,50532,51149],"Validation",[],{"_3170":1842,"_28022":1841,"_19417":51152,"_5":13306,"_25514":1841,"_2665":51153},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3170":1843,"_28022":1841,"_5":28341,"_19417":51155,"_25514":51156,"_2665":51157},[],"/docs/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3170":1844,"_28022":1841,"_5":28341,"_19417":51159,"_25514":51160,"_2665":51161},[],"/docs/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3170":1845,"_28022":1841,"_5":28341,"_19417":51163,"_25514":51164,"_2665":51165},[],"/docs/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3170":1846,"_28022":1841,"_19417":51167,"_5":13306,"_25514":1841,"_2665":51168},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3170":1847,"_28022":1841,"_19417":51170,"_5":13306,"_25514":51156,"_2665":51171},[],"Verify these criteria together:",{"_3170":1848,"_28022":1841,"_19417":51173,"_5":13306,"_25514":51156,"_2665":50156},[],{"_3170":1849,"_28022":1841,"_19417":51175,"_5":13306,"_25514":51156,"_2665":51176},[],"Required result",{"_3170":1850,"_28022":1841,"_19417":51178,"_5":13306,"_25514":51156,"_2665":51179},[],"Chain and signature",{"_3170":1851,"_28022":1841,"_19417":51181,"_5":13306,"_25514":51156,"_2665":51182},[],"Valid chain to a root deliberately installed in the consumer.",{"_3170":1852,"_28022":1841,"_19417":51184,"_5":13306,"_25514":51156,"_2665":51185},[],"Dates",{"_3170":1853,"_28022":1841,"_19417":51187,"_5":13306,"_25514":51156,"_2665":51188},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3170":1854,"_28022":1841,"_19417":51190,"_5":13306,"_25514":51156,"_2665":46496},[],{"_3170":1855,"_28022":1841,"_19417":51192,"_5":13306,"_25514":51156,"_2665":51193},[],"Name, SAN or identifier matches the expected peer.",{"_3170":1856,"_28022":1841,"_19417":51195,"_5":13306,"_25514":51156,"_2665":45796},[],{"_3170":1857,"_28022":1841,"_19417":51197,"_5":13306,"_25514":51156,"_2665":51198},[],"KU, EKU and constraints permit the specific operation.",{"_3170":1858,"_28022":1841,"_19417":51200,"_5":13306,"_25514":51156,"_2665":51201},[],"Revocation",{"_3170":1859,"_28022":1841,"_19417":51203,"_5":13306,"_25514":51156,"_2665":51204},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3170":1860,"_28022":1841,"_19417":51206,"_5":13306,"_25514":51156,"_2665":51207},[],"Authorization",{"_3170":1861,"_28022":1841,"_19417":51209,"_5":13306,"_25514":51156,"_2665":51210},[],"The application permits that identity to perform the action.",{"_3170":1862,"_28022":1841,"_19417":51212,"_5":13306,"_25514":51156,"_2665":51213},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3170":1863,"_28022":1841,"_19417":51215,"_5":13306,"_25514":51160,"_2665":51216},[],"Mechanism",{"_3170":1864,"_28022":1841,"_19417":51218,"_5":13306,"_25514":51160,"_2665":51219},[],"When to use it",{"_3170":1865,"_28022":1841,"_19417":51221,"_5":13306,"_25514":51160,"_2665":51222},[],"What you must maintain",{"_3170":1866,"_28022":1841,"_19417":51224,"_5":13306,"_25514":51160,"_2665":51225},[],"OCSP",{"_3170":1867,"_28022":1841,"_19417":51227,"_5":13306,"_25514":51160,"_2665":51228},[],"Status query for a specific certificate.",{"_3170":1868,"_28022":1841,"_19417":51230,"_5":13306,"_25514":51160,"_2665":51231},[],"Responder access, signature verification and cache/freshness policy.",{"_3170":1869,"_28022":1841,"_19417":51233,"_5":13306,"_25514":51160,"_2665":51234},[],"CRL",{"_3170":1870,"_28022":1841,"_19417":51236,"_5":13306,"_25514":51160,"_2665":51237},[],"Local checks for many certificates or offline operation.",{"_3170":1871,"_28022":1841,"_19417":51239,"_5":13306,"_25514":51160,"_2665":51240},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3170":1872,"_28022":1841,"_19417":51242,"_5":13306,"_25514":51160,"_2665":51243},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3170":1873,"_28022":1841,"_19417":51245,"_5":13306,"_25514":51160,"_2665":51246},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3170":1874,"_28022":1841,"_19417":51248,"_5":13306,"_25514":51164,"_2665":51249},[],"Accept a current, authorized certificate with a known chain.",{"_3170":1875,"_28022":1841,"_19417":51251,"_5":13306,"_25514":51164,"_2665":51252},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3170":1876,"_28022":1841,"_19417":51254,"_5":13306,"_25514":51164,"_2665":51255},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3170":1877,"_28022":1841,"_19417":51257,"_5":13306,"_25514":51164,"_2665":51258},[],"Check that a new connection with that identity is rejected.",{"_3170":1878,"_28022":1841,"_19417":51260,"_5":13306,"_25514":51164,"_2665":51261},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3170":1879,"_28022":1841,"_19417":51263,"_5":13306,"_25514":51164,"_2665":51264},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3170":1880,"_28022":1841,"_19417":51266,"_5":13306,"_25514":51164,"_2665":51267},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3170":1881,"_28022":1841,"_19417":51269,"_5":13306,"_25514":51164,"_2665":51270},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3170":1882,"_28022":1841,"_19417":51272,"_5":13306,"_25514":51164,"_2665":51273},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3170":1883,"_28022":1883,"_5":13637,"_2665":51275,"_28344":51276,"_19417":51277,"_25514":1883},"Certificates",[45406,46799,50532,50533],[],{"_3170":1884,"_28022":1883,"_19417":51279,"_5":13306,"_25514":1883,"_2665":51280},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3170":1885,"_28022":1883,"_5":28341,"_19417":51282,"_25514":51283,"_2665":51284},[],"/docs/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3170":1886,"_28022":1883,"_5":28341,"_19417":51286,"_25514":51287,"_2665":51288},[],"/docs/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3170":1887,"_28022":1883,"_5":28341,"_19417":51290,"_25514":51291,"_2665":51292},[],"/docs/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3170":1888,"_28022":1883,"_5":28341,"_19417":51294,"_25514":51295,"_2665":51296},[],"/docs/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3170":1889,"_28022":1883,"_5":28341,"_19417":51298,"_25514":51299,"_2665":51300},[],"/docs/platform/pki/certificates#open-the-action","Open the action",{"_3170":1890,"_28022":1883,"_5":28341,"_19417":51302,"_25514":51303,"_2665":51304},[],"/docs/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3170":1891,"_28022":1883,"_5":28341,"_19417":51306,"_25514":51307,"_2665":51308},[],"/docs/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3170":1892,"_28022":1883,"_5":28341,"_19417":51310,"_25514":51311,"_2665":51312},[],"/docs/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3170":1893,"_28022":1883,"_5":28341,"_19417":51314,"_25514":51315,"_2665":51316},[],"/docs/platform/pki/certificates#continue","Continue",{"_3170":1894,"_28022":1883,"_19417":51318,"_5":13306,"_25514":1883,"_2665":51319},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3170":1895,"_28022":1883,"_19417":51321,"_5":13306,"_25514":51283,"_2665":51322},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3170":1896,"_28022":1883,"_19417":51324,"_5":13306,"_25514":51283,"_2665":51325},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3170":1897,"_28022":1883,"_19417":51327,"_5":13306,"_25514":51287,"_2665":51328},[],"Download the PEM and inspect it:",{"_3170":1898,"_28022":1883,"_19417":51330,"_5":13306,"_25514":51287,"_2665":51331},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3170":1899,"_28022":1883,"_19417":51333,"_5":13306,"_25514":51291,"_2665":51334},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3170":1900,"_28022":1883,"_19417":51336,"_5":13306,"_25514":51291,"_2665":51337},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3170":1901,"_28022":1883,"_19417":51339,"_5":13306,"_25514":51291,"_2665":51340},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3170":1902,"_28022":1883,"_19417":51342,"_5":13306,"_25514":51291,"_2665":51343},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3170":1903,"_28022":1883,"_19417":51345,"_5":13306,"_25514":51291,"_2665":51346},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3170":1904,"_28022":1883,"_19417":51348,"_5":13306,"_25514":51291,"_2665":51349},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3170":1905,"_28022":1883,"_19417":51351,"_5":13306,"_25514":51291,"_2665":51352},[],"For browser key generation, follow Issue your first certificate.",{"_3170":1906,"_28022":1883,"_19417":51354,"_5":13306,"_25514":51295,"_2665":51355},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3170":1907,"_28022":1883,"_19417":51357,"_5":13306,"_25514":51299,"_2665":51358},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3170":1908,"_28022":1883,"_19417":51360,"_5":13306,"_25514":51303,"_2665":51361},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3170":1909,"_28022":1883,"_19417":51363,"_5":13306,"_25514":51307,"_2665":51364},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3170":1910,"_28022":1883,"_19417":51366,"_5":13306,"_25514":51307,"_2665":51367},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3170":1911,"_28022":1883,"_19417":51369,"_5":13306,"_25514":51307,"_2665":51370},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3170":1912,"_28022":1883,"_19417":51372,"_5":13306,"_25514":51311,"_2665":51373},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3170":1913,"_28022":1883,"_19417":51375,"_5":13306,"_25514":51311,"_2665":51376},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3170":1914,"_28022":1883,"_19417":51378,"_5":13306,"_25514":51311,"_2665":51379},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3170":1915,"_28022":1883,"_19417":51381,"_5":13306,"_25514":51315,"_2665":51382},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3170":1916,"_28022":1883,"_19417":51384,"_5":13306,"_25514":51315,"_2665":51385},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3170":1917,"_28022":1917,"_5":13637,"_2665":51387,"_28344":51388,"_19417":51390,"_25514":1917},"Certificate lifecycle",[45406,46799,50532,51389],"Concepts",[],{"_3170":1918,"_28022":1917,"_19417":51392,"_5":13306,"_25514":1917,"_2665":51393},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3170":1919,"_28022":1917,"_5":28341,"_19417":51395,"_25514":51396,"_2665":51397},[],"/docs/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3170":1920,"_28022":1917,"_5":28341,"_19417":51399,"_25514":51400,"_2665":51401},[],"/docs/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3170":1921,"_28022":1917,"_5":28341,"_19417":51403,"_25514":51404,"_2665":51405},[],"/docs/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3170":1922,"_28022":1917,"_5":28341,"_19417":51407,"_25514":51408,"_2665":51409},[],"/docs/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3170":1923,"_28022":1917,"_5":28341,"_19417":51411,"_25514":51412,"_2665":51413},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3170":1924,"_28022":1917,"_5":28341,"_19417":51415,"_25514":51416,"_2665":51417},[],"/docs/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3170":1925,"_28022":1917,"_5":28341,"_19417":51419,"_25514":51420,"_2665":51421},[],"/docs/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3170":1926,"_28022":1917,"_5":28341,"_19417":51423,"_25514":51424,"_2665":51425},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3170":1927,"_28022":1917,"_5":28341,"_19417":51427,"_25514":51428,"_2665":51429},[],"/docs/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3170":1928,"_28022":1917,"_5":28341,"_19417":51431,"_25514":51432,"_2665":51433},[],"/docs/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3170":1929,"_28022":1917,"_19417":51435,"_5":13306,"_25514":1917,"_2665":51436},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3170":1930,"_28022":1917,"_19417":51438,"_5":13306,"_25514":51400,"_2665":51439},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3170":1931,"_28022":1917,"_19417":51441,"_5":13306,"_25514":51404,"_2665":51442},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3170":1932,"_28022":1917,"_19417":51444,"_5":13306,"_25514":51408,"_2665":51445},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3170":1933,"_28022":1917,"_19417":51447,"_5":13306,"_25514":51412,"_2665":51448},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3170":1934,"_28022":1917,"_19417":51450,"_5":13306,"_25514":51416,"_2665":51451},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3170":1935,"_28022":1917,"_19417":51453,"_5":13306,"_25514":51420,"_2665":51454},[],"Lamassu persists four X.509 states:",{"_3170":1936,"_28022":1917,"_19417":51456,"_5":13306,"_25514":51420,"_2665":51457},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3170":1937,"_28022":1917,"_19417":51459,"_5":13306,"_25514":51420,"_2665":51460},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3170":1938,"_28022":1917,"_19417":51462,"_5":13306,"_25514":51420,"_2665":51463},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3170":1939,"_28022":1917,"_19417":51465,"_5":13306,"_25514":51420,"_2665":51466},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3170":1940,"_28022":1917,"_19417":51468,"_5":13306,"_25514":51420,"_2665":51469},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3170":1941,"_28022":1917,"_19417":51471,"_5":13306,"_25514":51424,"_2665":51472},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3170":1942,"_28022":1917,"_19417":51474,"_5":13306,"_25514":51424,"_2665":51475},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3170":1943,"_28022":1917,"_19417":51477,"_5":13306,"_25514":51424,"_2665":51478},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3170":1944,"_28022":1917,"_19417":51480,"_5":13306,"_25514":51428,"_2665":51481},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3170":1945,"_28022":1917,"_19417":51483,"_5":13306,"_25514":51428,"_2665":51484},[],"Before confirming:",{"_3170":1946,"_28022":1917,"_19417":51486,"_5":13306,"_25514":51428,"_2665":51487},[],"Identify DMSs, devices and services that trust that chain.",{"_3170":1947,"_28022":1917,"_19417":51489,"_5":13306,"_25514":51428,"_2665":51490},[],"Distribute the new chain of trust.",{"_3170":1948,"_28022":1917,"_19417":51492,"_5":13306,"_25514":51428,"_2665":51493},[],"Reissue the necessary identities.",{"_3170":1949,"_28022":1917,"_19417":51495,"_5":13306,"_25514":51428,"_2665":51496},[],"Check OCSP and CRL from a real consumer.",{"_3170":1950,"_28022":1917,"_19417":51498,"_5":13306,"_25514":51428,"_2665":51499},[],"Revoke the old CA once no legitimate traffic remains.",{"_3170":1951,"_28022":1917,"_19417":51501,"_5":13306,"_25514":51428,"_2665":51502},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3170":1952,"_28022":1917,"_19417":51504,"_5":13306,"_25514":51432,"_2665":51505},[],"Certificates entering the preventive or critical renewal window.",{"_3170":1953,"_28022":1917,"_19417":51507,"_5":13306,"_25514":51432,"_2665":51508},[],"Repeated enrollment or re-enrollment failures.",{"_3170":1954,"_28022":1917,"_19417":51510,"_5":13306,"_25514":51432,"_2665":51511},[],"Status changes and revocation reasons.",{"_3170":1955,"_28022":1917,"_19417":51513,"_5":13306,"_25514":51432,"_2665":51514},[],"OCSP and CRL publication and validity.",{"_3170":1956,"_28022":1917,"_19417":51516,"_5":13306,"_25514":51432,"_2665":51517},[],"Dependencies still presenting a replaced certificate.",{"_3170":1957,"_28022":1917,"_19417":51519,"_5":13306,"_25514":51432,"_2665":51520},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3170":1958,"_28022":1958,"_5":13637,"_2665":51522,"_28344":51523,"_19417":51524,"_25514":1958},"Trust model",[45406,46799,50532,51389],[],{"_3170":1959,"_28022":1958,"_19417":51526,"_5":13306,"_25514":1958,"_2665":51527},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3170":1960,"_28022":1958,"_5":28341,"_19417":51529,"_25514":51530,"_2665":51531},[],"/docs/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3170":1961,"_28022":1958,"_5":28341,"_19417":51533,"_25514":51534,"_2665":51535},[],"/docs/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3170":1962,"_28022":1958,"_5":28341,"_19417":51537,"_25514":51538,"_2665":51539},[],"/docs/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3170":1963,"_28022":1958,"_5":28341,"_19417":51541,"_25514":51542,"_2665":51543},[],"/docs/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3170":1964,"_28022":1958,"_5":28341,"_19417":51545,"_25514":51546,"_2665":51547},[],"/docs/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3170":1965,"_28022":1958,"_5":28341,"_19417":51549,"_25514":51550,"_2665":51551},[],"/docs/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3170":1966,"_28022":1958,"_5":28341,"_19417":51553,"_25514":51554,"_2665":51555},[],"/docs/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3170":1967,"_28022":1958,"_5":28341,"_19417":51557,"_25514":51558,"_2665":51559},[],"/docs/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3170":1968,"_28022":1958,"_5":28341,"_19417":51561,"_25514":51562,"_2665":51563},[],"/docs/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3170":1969,"_28022":1958,"_5":28341,"_19417":51565,"_25514":51566,"_2665":51567},[],"/docs/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3170":1970,"_28022":1958,"_19417":51569,"_5":13306,"_25514":1958,"_2665":51570},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3170":1971,"_28022":1958,"_19417":51572,"_5":13306,"_25514":51534,"_2665":51573},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3170":1972,"_28022":1958,"_19417":51575,"_5":13306,"_25514":51538,"_2665":51576},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3170":1973,"_28022":1958,"_19417":51578,"_5":13306,"_25514":51542,"_2665":51579},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3170":1974,"_28022":1958,"_19417":51581,"_5":13306,"_25514":51546,"_2665":51582},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3170":1975,"_28022":1958,"_19417":51584,"_5":13306,"_25514":51550,"_2665":51585},[],"The device proves it can enroll according to the DMS policy.",{"_3170":1976,"_28022":1958,"_19417":51587,"_5":13306,"_25514":51550,"_2665":51588},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3170":1977,"_28022":1958,"_19417":51590,"_5":13306,"_25514":51550,"_2665":51591},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3170":1978,"_28022":1958,"_19417":51593,"_5":13306,"_25514":51550,"_2665":51594},[],"The device installs the certificate and the chain it needs.",{"_3170":1979,"_28022":1958,"_19417":51596,"_5":13306,"_25514":51550,"_2665":51597},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3170":1980,"_28022":1958,"_19417":51599,"_5":13306,"_25514":51550,"_2665":51600},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3170":1981,"_28022":1958,"_19417":51602,"_5":13306,"_25514":51554,"_2665":51603},[],"A DMS relates three sets that are worth designing separately:",{"_3170":1982,"_28022":1958,"_19417":51605,"_5":13306,"_25514":51554,"_2665":51606},[],"**Enrollment CA:** signs the new identities.",{"_3170":1983,"_28022":1958,"_19417":51608,"_5":13306,"_25514":51554,"_2665":51609},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3170":1984,"_28022":1958,"_19417":51611,"_5":13306,"_25514":51554,"_2665":51612},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3170":1985,"_28022":1958,"_19417":51614,"_5":13306,"_25514":51554,"_2665":51615},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3170":1986,"_28022":1958,"_19417":51617,"_5":13306,"_25514":51558,"_2665":51618},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3170":1987,"_28022":1958,"_19417":51620,"_5":13306,"_25514":51558,"_2665":51621},[],"that the current date is between `Not Before` and `Not After`;",{"_3170":1988,"_28022":1958,"_19417":51623,"_5":13306,"_25514":51558,"_2665":51624},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3170":1989,"_28022":1958,"_19417":51626,"_5":13306,"_25514":51558,"_2665":51627},[],"that names, SANs and subject match the expected identity;",{"_3170":1990,"_28022":1958,"_19417":51629,"_5":13306,"_25514":51558,"_2665":51630},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3170":1991,"_28022":1958,"_19417":51632,"_5":13306,"_25514":51558,"_2665":51633},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3170":1992,"_28022":1958,"_19417":51635,"_5":13306,"_25514":51558,"_2665":51636},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3170":1993,"_28022":1958,"_19417":51638,"_5":13306,"_25514":51562,"_2665":51639},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3170":1994,"_28022":1958,"_19417":51641,"_5":13306,"_25514":51566,"_2665":51642},[],"Keep the root out of daily operations, or with very restricted access.",{"_3170":1995,"_28022":1958,"_19417":51644,"_5":13306,"_25514":51566,"_2665":51645},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3170":1996,"_28022":1958,"_19417":51647,"_5":13306,"_25514":51566,"_2665":51648},[],"Assign explicit profiles to every use case.",{"_3170":1997,"_28022":1958,"_19417":51650,"_5":13306,"_25514":51566,"_2665":51651},[],"Distribute the new trust before starting a rotation.",{"_3170":1998,"_28022":1958,"_19417":51653,"_5":13306,"_25514":51566,"_2665":51654},[],"Keep enough overlap to renew a disconnected fleet.",{"_3170":1999,"_28022":1958,"_19417":51656,"_5":13306,"_25514":51566,"_2665":51657},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3170":2000,"_28022":1958,"_19417":51659,"_5":13306,"_25514":51566,"_2665":51660},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3170":2001,"_28022":2001,"_5":13637,"_2665":51662,"_28344":51663,"_19417":51664,"_25514":2001},"Revocation lists (CRL)",[45406,46799,50532,51149],[],{"_3170":2002,"_28022":2001,"_19417":51666,"_5":13306,"_25514":2001,"_2665":51667},[],"Generate and distribute signed lists to validate certificates offline.",{"_3170":2003,"_28022":2001,"_5":28341,"_19417":51669,"_25514":51670,"_2665":51671},[],"/docs/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_3170":2004,"_28022":2001,"_5":28341,"_19417":51673,"_25514":51674,"_2665":51675},[],"/docs/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3170":2005,"_28022":2001,"_5":28341,"_19417":51677,"_25514":51678,"_2665":51679},[],"/docs/platform/pki/crl#crl-contents","CRL contents",{"_3170":2006,"_28022":2001,"_5":28341,"_19417":51681,"_25514":51682,"_2665":51683},[],"/docs/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3170":2007,"_28022":2001,"_5":28341,"_19417":51685,"_25514":51686,"_2665":51687},[],"/docs/platform/pki/crl#va-role-management-api","VA role management API",{"_3170":2008,"_28022":2001,"_5":28341,"_19417":51689,"_25514":51690,"_2665":51691},[],"/docs/platform/pki/crl#from-the-interface","From the interface",{"_3170":2009,"_28022":2001,"_5":28341,"_19417":51693,"_25514":51694,"_2665":51695},[],"/docs/platform/pki/crl#references","References",{"_3170":2010,"_28022":2001,"_19417":51697,"_5":13306,"_25514":2001,"_2665":51698},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3170":2011,"_28022":2001,"_19417":51700,"_5":13306,"_25514":51670,"_2665":51701},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3170":2012,"_28022":2001,"_19417":51703,"_5":13306,"_25514":51670,"_2665":51704},[],"`crl_options` field",{"_3170":2013,"_28022":2001,"_19417":51706,"_5":13306,"_25514":51670,"_2665":45796},[],{"_3170":2014,"_28022":2001,"_19417":51708,"_5":13306,"_25514":51670,"_2665":51709},[],"Backend initial value",{"_3170":2015,"_28022":2001,"_19417":51711,"_5":13306,"_25514":51670,"_2665":51712},[],"`validity`",{"_3170":2016,"_28022":2001,"_19417":51714,"_5":13306,"_25514":51670,"_2665":51715},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3170":2017,"_28022":2001,"_19417":51717,"_5":13306,"_25514":51670,"_2665":51718},[],"7 days.",{"_3170":2018,"_28022":2001,"_19417":51720,"_5":13306,"_25514":51670,"_2665":51721},[],"`refresh_interval`",{"_3170":2019,"_28022":2001,"_19417":51723,"_5":13306,"_25514":51670,"_2665":51724},[],"Time since publication that triggers scheduled renewal.",{"_3170":2020,"_28022":2001,"_19417":51726,"_5":13306,"_25514":51670,"_2665":51727},[],"6 days and 23 hours.",{"_3170":2021,"_28022":2001,"_19417":51729,"_5":13306,"_25514":51670,"_2665":51730},[],"`regenerate_on_revoke`",{"_3170":2022,"_28022":2001,"_19417":51732,"_5":13306,"_25514":51670,"_2665":51733},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3170":2023,"_28022":2001,"_19417":51735,"_5":13306,"_25514":51670,"_2665":51736},[],"`true`.",{"_3170":2024,"_28022":2001,"_19417":51738,"_5":13306,"_25514":51670,"_2665":51739},[],"`subject_key_id_signer`",{"_3170":2025,"_28022":2001,"_19417":51741,"_5":13306,"_25514":51670,"_2665":51742},[],"Configuration field initialized with the CA’s SKI.",{"_3170":2026,"_28022":2001,"_19417":51744,"_5":13306,"_25514":51670,"_2665":51745},[],"CA SKI.",{"_3170":2027,"_28022":2001,"_19417":51747,"_5":13306,"_25514":51670,"_2665":51748},[],"The generator uses the key of the CA identified by the requested SKI. Do not interpret `subject_key_id_signer` as verified support for a different delegated CA: changing that field does not change the signer in this flow.",{"_3170":2028,"_28022":2001,"_19417":51750,"_5":13306,"_25514":51670,"_2665":51751},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_3170":2029,"_28022":2001,"_19417":51753,"_5":13306,"_25514":51674,"_2665":51754},[],"The scheduled job requests another list when `refresh_interval` is reached or when the list approaches expiration within the configured watch period. This depends on working jobs, storage and signing; it does not guarantee renewal during a service failure.",{"_3170":2030,"_28022":2001,"_19417":51756,"_5":13306,"_25514":51674,"_2665":51757},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3170":2031,"_28022":2001,"_19417":51759,"_5":13306,"_25514":51674,"_2665":51760},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3170":2032,"_28022":2001,"_19417":51762,"_5":13306,"_25514":51678,"_2665":51763},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3170":2033,"_28022":2001,"_19417":51765,"_5":13306,"_25514":51678,"_2665":51766},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3170":2034,"_28022":2001,"_19417":51768,"_5":13306,"_25514":51682,"_2665":51769},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_3170":2035,"_28022":2001,"_19417":51771,"_5":13306,"_25514":51682,"_2665":51772},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3170":2036,"_28022":2001,"_19417":51774,"_5":13306,"_25514":51682,"_2665":51775},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3170":2037,"_28022":2001,"_19417":51777,"_5":13306,"_25514":51682,"_2665":51778},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3170":2038,"_28022":2001,"_19417":51780,"_5":13306,"_25514":51682,"_2665":51781},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3170":2039,"_28022":2001,"_19417":51783,"_5":13306,"_25514":51686,"_2665":51784},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3170":2040,"_28022":2001,"_19417":51786,"_5":13306,"_25514":51686,"_2665":48563},[],{"_3170":2041,"_28022":2001,"_19417":51788,"_5":13306,"_25514":51686,"_2665":51789},[],"Relative path",{"_3170":2042,"_28022":2001,"_19417":51791,"_5":13306,"_25514":51686,"_2665":48560},[],{"_3170":2043,"_28022":2001,"_19417":51793,"_5":13306,"_25514":51686,"_2665":51794},[],"`GET`",{"_3170":2044,"_28022":2001,"_19417":51796,"_5":13306,"_25514":51686,"_2665":51797},[],"`/v1/roles/{ca-ski}`",{"_3170":2045,"_28022":2001,"_19417":51799,"_5":13306,"_25514":51686,"_2665":51800},[],"Read `crl_options` and `latest_crl`.",{"_3170":2046,"_28022":2001,"_19417":51802,"_5":13306,"_25514":51686,"_2665":51803},[],"`PUT`",{"_3170":2047,"_28022":2001,"_19417":51805,"_5":13306,"_25514":51686,"_2665":51797},[],{"_3170":2048,"_28022":2001,"_19417":51807,"_5":13306,"_25514":51686,"_2665":51808},[],"Replace CRL configuration.",{"_3170":2049,"_28022":2001,"_19417":51810,"_5":13306,"_25514":51686,"_2665":51811},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_3170":2050,"_28022":2001,"_19417":51813,"_5":13306,"_25514":51686,"_2665":51814},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_3170":2051,"_28022":2001,"_19417":51816,"_5":13306,"_25514":51690,"_2665":51817},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_3170":2052,"_28022":2001,"_19417":51819,"_5":13306,"_25514":51694,"_2665":51820},[],"RFC 5280: X.509 and CRL profile.",{"_3170":2053,"_28022":2001,"_19417":51822,"_5":13306,"_25514":51694,"_2665":51823},[],"OpenSSL: openssl-crl.",{"_3170":2054,"_28022":2001,"_19417":51825,"_5":13306,"_25514":51694,"_2665":51826},[],"OpenSSL: openssl-verify.",{"_3170":2055,"_28022":2001,"_19417":51828,"_5":13306,"_25514":51694,"_2665":51829},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3170":2056,"_28022":2001,"_19417":51831,"_5":13306,"_25514":51694,"_2665":51832},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3170":2057,"_28022":2057,"_5":13637,"_2665":51834,"_28344":51835,"_19417":51836,"_25514":2057},"Keys and cryptographic engines",[45406,46799,50532,50533],[],{"_3170":2058,"_28022":2057,"_19417":51838,"_5":13306,"_25514":2057,"_2665":51839},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3170":2059,"_28022":2057,"_5":28341,"_19417":51841,"_25514":51842,"_2665":51843},[],"/docs/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3170":2060,"_28022":2057,"_5":28341,"_19417":51845,"_25514":51846,"_2665":51847},[],"/docs/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3170":2061,"_28022":2057,"_5":28341,"_19417":51849,"_25514":51850,"_2665":51851},[],"/docs/platform/pki/key-management#file-system","File System",{"_3170":2062,"_28022":2057,"_5":28341,"_19417":51853,"_25514":51854,"_2665":51855},[],"/docs/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3170":2063,"_28022":2057,"_5":28341,"_19417":51857,"_25514":51858,"_2665":51859},[],"/docs/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3170":2064,"_28022":2057,"_5":28341,"_19417":51861,"_25514":51862,"_2665":51863},[],"/docs/platform/pki/key-management#aws-kms","AWS KMS",{"_3170":2065,"_28022":2057,"_5":28341,"_19417":51865,"_25514":51866,"_2665":51867},[],"/docs/platform/pki/key-management#pkcs11","PKCS#11",{"_3170":2066,"_28022":2057,"_5":28341,"_19417":51869,"_25514":51870,"_2665":51871},[],"/docs/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3170":2067,"_28022":2057,"_5":28341,"_19417":51873,"_25514":51874,"_2665":51875},[],"/docs/platform/pki/key-management#key-inventory","Key inventory",{"_3170":2068,"_28022":2057,"_5":28341,"_19417":51877,"_25514":51878,"_2665":51879},[],"/docs/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3170":2069,"_28022":2057,"_5":28341,"_19417":51881,"_25514":51882,"_2665":51883},[],"/docs/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3170":2070,"_28022":2057,"_5":28341,"_19417":51885,"_25514":51886,"_2665":51887},[],"/docs/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3170":2071,"_28022":2057,"_5":28341,"_19417":51889,"_25514":51890,"_2665":51891},[],"/docs/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3170":2072,"_28022":2057,"_5":28341,"_19417":51893,"_25514":51894,"_2665":51895},[],"/docs/platform/pki/key-management#view-details","View details",{"_3170":2073,"_28022":2057,"_5":28341,"_19417":51897,"_25514":51898,"_2665":51899},[],"/docs/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3170":2074,"_28022":2057,"_5":28341,"_19417":51901,"_25514":51902,"_2665":51903},[],"/docs/platform/pki/key-management#sign","Sign",{"_3170":2075,"_28022":2057,"_5":28341,"_19417":51905,"_25514":51906,"_2665":51907},[],"/docs/platform/pki/key-management#verify","Verify",{"_3170":2076,"_28022":2057,"_5":28341,"_19417":51909,"_25514":51910,"_2665":51911},[],"/docs/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3170":2077,"_28022":2057,"_5":28341,"_19417":51913,"_25514":51914,"_2665":51915},[],"/docs/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3170":2078,"_28022":2057,"_5":28341,"_19417":51917,"_25514":51918,"_2665":51919},[],"/docs/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3170":2079,"_28022":2057,"_19417":51921,"_5":13306,"_25514":2057,"_2665":51922},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3170":2080,"_28022":2057,"_19417":51924,"_5":13306,"_25514":2057,"_2665":51925},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3170":2081,"_28022":2057,"_19417":51927,"_5":13306,"_25514":51842,"_2665":51928},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3170":2082,"_28022":2057,"_19417":51930,"_5":13306,"_25514":51842,"_2665":51931},[],"In practice, it lets you:",{"_3170":2083,"_28022":2057,"_19417":51933,"_5":13306,"_25514":51842,"_2665":51934},[],"Generate new key pairs from Lamassu IoT.",{"_3170":2084,"_28022":2057,"_19417":51936,"_5":13306,"_25514":51842,"_2665":51937},[],"Import keys created externally.",{"_3170":2085,"_28022":2057,"_19417":51939,"_5":13306,"_25514":51842,"_2665":51940},[],"Delegate custody and cryptographic operations to external engines.",{"_3170":2086,"_28022":2057,"_19417":51942,"_5":13306,"_25514":51842,"_2665":51943},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3170":2087,"_28022":2057,"_19417":51945,"_5":13306,"_25514":51846,"_2665":51946},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3170":2088,"_28022":2057,"_19417":51948,"_5":13306,"_25514":51846,"_2665":51949},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3170":2089,"_28022":2057,"_19417":51951,"_5":13306,"_25514":51846,"_2665":51952},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3170":2090,"_28022":2057,"_19417":51954,"_5":13306,"_25514":51850,"_2665":51955},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3170":2091,"_28022":2057,"_19417":51957,"_5":13306,"_25514":51854,"_2665":51958},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3170":2092,"_28022":2057,"_19417":51960,"_5":13306,"_25514":51854,"_2665":51961},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3170":2093,"_28022":2057,"_19417":51963,"_5":13306,"_25514":51858,"_2665":51964},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3170":2094,"_28022":2057,"_19417":51966,"_5":13306,"_25514":51862,"_2665":51967},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3170":2095,"_28022":2057,"_19417":51969,"_5":13306,"_25514":51866,"_2665":51970},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3170":2096,"_28022":2057,"_19417":51972,"_5":13306,"_25514":51870,"_2665":51973},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3170":2097,"_28022":2057,"_19417":51975,"_5":13306,"_25514":51870,"_2665":51976},[],"Lamassu shows the enabled engines in the console.",{"_3170":2098,"_28022":2057,"_19417":51978,"_5":13306,"_25514":51870,"_2665":51979},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3170":2099,"_28022":2057,"_19417":51981,"_5":13306,"_25514":51870,"_2665":51982},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3170":2100,"_28022":2057,"_19417":51984,"_5":13306,"_25514":51874,"_2665":51985},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3170":2101,"_28022":2057,"_19417":51987,"_5":13306,"_25514":51874,"_2665":51988},[],"The table includes the following fields:",{"_3170":2102,"_28022":2057,"_19417":51990,"_5":13306,"_25514":51874,"_2665":51991},[],"**Name**: descriptive name of the key.",{"_3170":2103,"_28022":2057,"_19417":51993,"_5":13306,"_25514":51874,"_2665":51994},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3170":2104,"_28022":2057,"_19417":51996,"_5":13306,"_25514":51874,"_2665":51997},[],"**Strength**: visual indicator of cryptographic strength.",{"_3170":2105,"_28022":2057,"_19417":51999,"_5":13306,"_25514":51874,"_2665":52000},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3170":2106,"_28022":2057,"_19417":52002,"_5":13306,"_25514":51874,"_2665":52003},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3170":2107,"_28022":2057,"_19417":52005,"_5":13306,"_25514":51874,"_2665":52006},[],"**Aliases**: alternative names associated with the key.",{"_3170":2108,"_28022":2057,"_19417":52008,"_5":13306,"_25514":51874,"_2665":52009},[],"**Tags**: labels for classification and search.",{"_3170":2109,"_28022":2057,"_19417":52011,"_5":13306,"_25514":51874,"_2665":52012},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3170":2110,"_28022":2057,"_19417":52014,"_5":13306,"_25514":51874,"_2665":52015},[],"From this view you also reach the most common actions:",{"_3170":2111,"_28022":2057,"_19417":52017,"_5":13306,"_25514":51874,"_2665":52018},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3170":2112,"_28022":2057,"_19417":52020,"_5":13306,"_25514":51874,"_2665":52021},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3170":2113,"_28022":2057,"_19417":52023,"_5":13306,"_25514":51874,"_2665":52024},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3170":2114,"_28022":2057,"_19417":52026,"_5":13306,"_25514":51874,"_2665":52027},[],"**Delete Key** to remove the key from the system.",{"_3170":2115,"_28022":2057,"_19417":52029,"_5":13306,"_25514":51878,"_2665":52030},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3170":2116,"_28022":2057,"_19417":52032,"_5":13306,"_25514":51882,"_2665":52033},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3170":2117,"_28022":2057,"_19417":52035,"_5":13306,"_25514":51882,"_2665":52036},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3170":2118,"_28022":2057,"_19417":52038,"_5":13306,"_25514":51882,"_2665":52039},[],"**Key Name**: unique and descriptive name.",{"_3170":2119,"_28022":2057,"_19417":52041,"_5":13306,"_25514":51882,"_2665":52042},[],"**Crypto Engine**: engine that will keep the key.",{"_3170":2120,"_28022":2057,"_19417":52044,"_5":13306,"_25514":51882,"_2665":52045},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3170":2121,"_28022":2057,"_19417":52047,"_5":13306,"_25514":51882,"_2665":52048},[],"**Tags**: metadata to classify the key.",{"_3170":2122,"_28022":2057,"_19417":52050,"_5":13306,"_25514":51882,"_2665":52051},[],"**Metadata**: additional information for advanced uses.",{"_3170":2123,"_28022":2057,"_19417":52053,"_5":13306,"_25514":51886,"_2665":52054},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3170":2124,"_28022":2057,"_19417":52056,"_5":13306,"_25514":51886,"_2665":52057},[],"When you have an exportable private key and the destination engine supports import.",{"_3170":2125,"_28022":2057,"_19417":52059,"_5":13306,"_25514":51886,"_2665":52060},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3170":2126,"_28022":2057,"_19417":52062,"_5":13306,"_25514":51886,"_2665":52063},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3170":2127,"_28022":2057,"_19417":52065,"_5":13306,"_25514":51886,"_2665":52066},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3170":2128,"_28022":2057,"_19417":52068,"_5":13306,"_25514":51886,"_2665":52069},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3170":2129,"_28022":2057,"_19417":52071,"_5":13306,"_25514":51886,"_2665":52072},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3170":2130,"_28022":2057,"_19417":52074,"_5":13306,"_25514":51886,"_2665":52075},[],"**Tags**: labels for organization and search.",{"_3170":2131,"_28022":2057,"_19417":52077,"_5":13306,"_25514":51886,"_2665":52078},[],"**Metadata**: additional optional information.",{"_3170":2132,"_28022":2057,"_19417":52080,"_5":13306,"_25514":51886,"_2665":52081},[],"**Private Key (PEM)**: private key in PEM format.",{"_3170":2133,"_28022":2057,"_19417":52083,"_5":13306,"_25514":51886,"_2665":52084},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3170":2134,"_28022":2057,"_19417":52086,"_5":13306,"_25514":51890,"_2665":52087},[],"Each registered key has a detail view and several operational actions.",{"_3170":2135,"_28022":2057,"_19417":52089,"_5":13306,"_25514":51894,"_2665":52090},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3170":2136,"_28022":2057,"_19417":52092,"_5":13306,"_25514":51894,"_2665":52093},[],"The **Overview** tab shows, among others, these fields:",{"_3170":2137,"_28022":2057,"_19417":52095,"_5":13306,"_25514":51894,"_2665":52096},[],"**Key Name**: descriptive name.",{"_3170":2138,"_28022":2057,"_19417":52098,"_5":13306,"_25514":51894,"_2665":52099},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3170":2139,"_28022":2057,"_19417":52101,"_5":13306,"_25514":51894,"_2665":52102},[],"**Tags**: associated labels.",{"_3170":2140,"_28022":2057,"_19417":52104,"_5":13306,"_25514":51894,"_2665":52105},[],"**Aliases**: alternative names.",{"_3170":2141,"_28022":2057,"_19417":52107,"_5":13306,"_25514":51894,"_2665":52108},[],"**Crypto Engine**: engine where the key resides.",{"_3170":2142,"_28022":2057,"_19417":52110,"_5":13306,"_25514":51894,"_2665":52111},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3170":2143,"_28022":2057,"_19417":52113,"_5":13306,"_25514":51894,"_2665":52114},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3170":2144,"_28022":2057,"_19417":52116,"_5":13306,"_25514":51894,"_2665":52117},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3170":2145,"_28022":2057,"_19417":52119,"_5":13306,"_25514":51898,"_2665":52120},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3170":2146,"_28022":2057,"_19417":52122,"_5":13306,"_25514":51898,"_2665":52123},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3170":2147,"_28022":2057,"_19417":52125,"_5":13306,"_25514":51898,"_2665":52126},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3170":2148,"_28022":2057,"_19417":52128,"_5":13306,"_25514":51902,"_2665":52129},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3170":2149,"_28022":2057,"_19417":52131,"_5":13306,"_25514":51902,"_2665":52132},[],"Main fields:",{"_3170":2150,"_28022":2057,"_19417":52134,"_5":13306,"_25514":51902,"_2665":52135},[],"**Algorithm**: signing algorithm available for the key type.",{"_3170":2151,"_28022":2057,"_19417":52137,"_5":13306,"_25514":51902,"_2665":52138},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3170":2152,"_28022":2057,"_19417":52140,"_5":13306,"_25514":51902,"_2665":52141},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3170":2153,"_28022":2057,"_19417":52143,"_5":13306,"_25514":51902,"_2665":52144},[],"**Message**: content to sign.",{"_3170":2154,"_28022":2057,"_19417":52146,"_5":13306,"_25514":51902,"_2665":52147},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3170":2155,"_28022":2057,"_19417":52149,"_5":13306,"_25514":51906,"_2665":52150},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3170":2156,"_28022":2057,"_19417":52152,"_5":13306,"_25514":51906,"_2665":52132},[],{"_3170":2157,"_28022":2057,"_19417":52154,"_5":13306,"_25514":51906,"_2665":52155},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3170":2158,"_28022":2057,"_19417":52157,"_5":13306,"_25514":51906,"_2665":52158},[],"**Message Type**: `Raw` or `Digest`.",{"_3170":2159,"_28022":2057,"_19417":52160,"_5":13306,"_25514":51906,"_2665":52161},[],"**Payload Encoding**: encoding of the message.",{"_3170":2160,"_28022":2057,"_19417":52163,"_5":13306,"_25514":51906,"_2665":52164},[],"**Message**: original message or hash.",{"_3170":2161,"_28022":2057,"_19417":52166,"_5":13306,"_25514":51906,"_2665":52167},[],"**Signature**: signature to check.",{"_3170":2162,"_28022":2057,"_19417":52169,"_5":13306,"_25514":51906,"_2665":52170},[],"**Result**: indicator of the validation result.",{"_3170":2163,"_28022":2057,"_19417":52172,"_5":13306,"_25514":51910,"_2665":52173},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3170":2164,"_28022":2057,"_19417":52175,"_5":13306,"_25514":51910,"_2665":52176},[],"This flow is useful for:",{"_3170":2165,"_28022":2057,"_19417":52178,"_5":13306,"_25514":51910,"_2665":52179},[],"Requesting certificates from an external CA.",{"_3170":2166,"_28022":2057,"_19417":52181,"_5":13306,"_25514":51910,"_2665":52182},[],"Renewing an identity while keeping the same key.",{"_3170":2167,"_28022":2057,"_19417":52184,"_5":13306,"_25514":51910,"_2665":52185},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3170":2168,"_28022":2057,"_19417":52187,"_5":13306,"_25514":51910,"_2665":52188},[],"**Common Name (CN)**: main name of the identity.",{"_3170":2169,"_28022":2057,"_19417":52190,"_5":13306,"_25514":51910,"_2665":52191},[],"**Organization (O)**: organization or company.",{"_3170":2170,"_28022":2057,"_19417":52193,"_5":13306,"_25514":51910,"_2665":52194},[],"**Organizational Unit (OU)**: department or unit.",{"_3170":2171,"_28022":2057,"_19417":52196,"_5":13306,"_25514":51910,"_2665":52197},[],"**Country (C)**: two-letter country code.",{"_3170":2172,"_28022":2057,"_19417":52199,"_5":13306,"_25514":51910,"_2665":52200},[],"**State / Province (ST)**: state or province.",{"_3170":2173,"_28022":2057,"_19417":52202,"_5":13306,"_25514":51910,"_2665":52203},[],"**Locality (L)**: city or locality.",{"_3170":2174,"_28022":2057,"_19417":52205,"_5":13306,"_25514":51910,"_2665":52206},[],"**Email Address**: contact email.",{"_3170":2175,"_28022":2057,"_19417":52208,"_5":13306,"_25514":51910,"_2665":52209},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3170":2176,"_28022":2057,"_19417":52211,"_5":13306,"_25514":51910,"_2665":52212},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3170":2177,"_28022":2057,"_19417":52214,"_5":13306,"_25514":51914,"_2665":52215},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3170":2178,"_28022":2057,"_19417":52217,"_5":13306,"_25514":51914,"_2665":52218},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3170":2179,"_28022":2057,"_19417":52220,"_5":13306,"_25514":51918,"_2665":52221},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3170":2180,"_28022":2180,"_5":13637,"_2665":52223,"_28344":52224,"_19417":52225,"_25514":2180},"Online validation with OCSP",[45406,46799,50532,51149],[],{"_3170":2181,"_28022":2180,"_19417":52227,"_5":13306,"_25514":2180,"_2665":52228},[],"Query signed status and verify the responder’s response.",{"_3170":2182,"_28022":2180,"_5":28341,"_19417":52230,"_25514":52231,"_2665":52232},[],"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3170":2183,"_28022":2180,"_5":28341,"_19417":52234,"_25514":52235,"_2665":52236},[],"/docs/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3170":2184,"_28022":2180,"_5":28341,"_19417":52238,"_25514":52239,"_2665":52240},[],"/docs/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3170":2185,"_28022":2180,"_5":28341,"_19417":52242,"_25514":52243,"_2665":52244},[],"/docs/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3170":2186,"_28022":2180,"_5":28341,"_19417":52246,"_25514":52247,"_2665":52248},[],"/docs/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3170":2187,"_28022":2180,"_5":28341,"_19417":52250,"_25514":52251,"_2665":51695},[],"/docs/platform/pki/ocsp#references",{"_3170":2188,"_28022":2180,"_19417":52253,"_5":13306,"_25514":2180,"_2665":52254},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3170":2189,"_28022":2180,"_19417":52256,"_5":13306,"_25514":52231,"_2665":52257},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3170":2190,"_28022":2180,"_19417":52259,"_5":13306,"_25514":52231,"_2665":52260},[],"Record status",{"_3170":2191,"_28022":2180,"_19417":52262,"_5":13306,"_25514":52231,"_2665":52263},[],"Signed response",{"_3170":2192,"_28022":2180,"_19417":52265,"_5":13306,"_25514":52231,"_2665":49710},[],{"_3170":2193,"_28022":2180,"_19417":52267,"_5":13306,"_25514":52231,"_2665":52268},[],"`Good`.",{"_3170":2194,"_28022":2180,"_19417":52270,"_5":13306,"_25514":52231,"_2665":49727},[],{"_3170":2195,"_28022":2180,"_19417":52272,"_5":13306,"_25514":52231,"_2665":52273},[],"`Revoked`, with revocation reason and timestamp.",{"_3170":2196,"_28022":2180,"_19417":52275,"_5":13306,"_25514":52231,"_2665":52276},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3170":2197,"_28022":2180,"_19417":52278,"_5":13306,"_25514":52231,"_2665":52279},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3170":2198,"_28022":2180,"_19417":52281,"_5":13306,"_25514":52231,"_2665":52282},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3170":2199,"_28022":2180,"_19417":52284,"_5":13306,"_25514":52231,"_2665":52285},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3170":2200,"_28022":2180,"_19417":52287,"_5":13306,"_25514":52231,"_2665":52288},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3170":2201,"_28022":2180,"_19417":52290,"_5":13306,"_25514":52235,"_2665":52291},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3170":2202,"_28022":2180,"_19417":52293,"_5":13306,"_25514":52235,"_2665":52294},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3170":2203,"_28022":2180,"_19417":52296,"_5":13306,"_25514":52239,"_2665":52297},[],"The service accepts:",{"_3170":2204,"_28022":2180,"_19417":52299,"_5":13306,"_25514":52239,"_2665":48563},[],{"_3170":2205,"_28022":2180,"_19417":52301,"_5":13306,"_25514":52239,"_2665":52302},[],"VA service path",{"_3170":2206,"_28022":2180,"_19417":52304,"_5":13306,"_25514":52239,"_2665":52305},[],"Format",{"_3170":2207,"_28022":2180,"_19417":52307,"_5":13306,"_25514":52239,"_2665":52308},[],"`POST`",{"_3170":2208,"_28022":2180,"_19417":52310,"_5":13306,"_25514":52239,"_2665":52311},[],"`/ocsp`",{"_3170":2209,"_28022":2180,"_19417":52313,"_5":13306,"_25514":52239,"_2665":52314},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3170":2210,"_28022":2180,"_19417":52316,"_5":13306,"_25514":52239,"_2665":51794},[],{"_3170":2211,"_28022":2180,"_19417":52318,"_5":13306,"_25514":52239,"_2665":52319},[],"`/ocsp/{ocsp_request}`",{"_3170":2212,"_28022":2180,"_19417":52321,"_5":13306,"_25514":52239,"_2665":52322},[],"DER request encoded using padded URL Base64.",{"_3170":2213,"_28022":2180,"_19417":52324,"_5":13306,"_25514":52239,"_2665":52325},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3170":2214,"_28022":2180,"_19417":52327,"_5":13306,"_25514":52243,"_2665":52328},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3170":2215,"_28022":2180,"_19417":52330,"_5":13306,"_25514":52243,"_2665":52331},[],"Generate the request:",{"_3170":2216,"_28022":2180,"_19417":52333,"_5":13306,"_25514":52243,"_2665":52334},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3170":2217,"_28022":2180,"_19417":52336,"_5":13306,"_25514":52243,"_2665":52337},[],"Replace the example URL with the inspected endpoint:",{"_3170":2218,"_28022":2180,"_19417":52339,"_5":13306,"_25514":52243,"_2665":52340},[],"Verify the returned DER:",{"_3170":2219,"_28022":2180,"_19417":52342,"_5":13306,"_25514":52243,"_2665":52343},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3170":2220,"_28022":2180,"_19417":52345,"_5":13306,"_25514":52247,"_2665":52346},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3170":2221,"_28022":2180,"_19417":52348,"_5":13306,"_25514":52247,"_2665":52349},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3170":2222,"_28022":2180,"_19417":52351,"_5":13306,"_25514":52251,"_2665":52352},[],"RFC 6960: OCSP.",{"_3170":2223,"_28022":2180,"_19417":52354,"_5":13306,"_25514":52251,"_2665":52355},[],"OpenSSL: openssl-ocsp.",{"_3170":2224,"_28022":2180,"_19417":52357,"_5":13306,"_25514":52251,"_2665":52358},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3170":2225,"_28022":2180,"_19417":52360,"_5":13306,"_25514":52251,"_2665":51832},[],{"_3170":2226,"_28022":2226,"_5":13637,"_2665":50532,"_28344":52362,"_19417":52363,"_25514":2226},[45406,46799,50532],[],{"_3170":2227,"_28022":2226,"_19417":52365,"_5":13306,"_25514":2226,"_2665":52366},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3170":2228,"_28022":2226,"_5":28341,"_19417":52368,"_25514":52369,"_2665":49842},[],"/docs/platform/pki/overview#start-here",{"_3170":2229,"_28022":2226,"_5":28341,"_19417":52371,"_25514":52372,"_2665":52373},[],"/docs/platform/pki/overview#what-you-need","What you need",{"_3170":2230,"_28022":2226,"_5":28341,"_19417":52375,"_25514":52376,"_2665":50376},[],"/docs/platform/pki/overview#core-capabilities",{"_3170":2231,"_28022":2226,"_5":28341,"_19417":52378,"_25514":52379,"_2665":50380},[],"/docs/platform/pki/overview#build-your-trust-hierarchy",{"_3170":2232,"_28022":2226,"_5":28341,"_19417":52381,"_25514":52382,"_2665":50384},[],"/docs/platform/pki/overview#protect-cryptographic-keys",{"_3170":2233,"_28022":2226,"_5":28341,"_19417":52384,"_25514":52385,"_2665":50388},[],"/docs/platform/pki/overview#issue-and-control-certificates",{"_3170":2234,"_28022":2226,"_5":28341,"_19417":52387,"_25514":52388,"_2665":50396},[],"/docs/platform/pki/overview#publish-validation-status",{"_3170":2235,"_28022":2226,"_5":28341,"_19417":52390,"_25514":52391,"_2665":52392},[],"/docs/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3170":2236,"_28022":2226,"_5":28341,"_19417":52394,"_25514":52395,"_2665":51316},[],"/docs/platform/pki/overview#continue",{"_3170":2237,"_28022":2226,"_19417":52397,"_5":13306,"_25514":2226,"_2665":52398},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3170":2238,"_28022":2226,"_19417":52400,"_5":13306,"_25514":52369,"_2665":52401},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3170":2239,"_28022":2226,"_19417":52403,"_5":13306,"_25514":52369,"_2665":52404},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3170":2240,"_28022":2226,"_19417":52406,"_5":13306,"_25514":52372,"_2665":52407},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3170":2241,"_28022":2226,"_19417":52409,"_5":13306,"_25514":52372,"_2665":52410},[],"An available cryptographic engine to keep the authority's key.",{"_3170":2242,"_28022":2226,"_19417":52412,"_5":13306,"_25514":52372,"_2665":52413},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3170":2243,"_28022":2226,"_19417":52415,"_5":13306,"_25514":52372,"_2665":52416},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3170":2244,"_28022":2226,"_19417":52418,"_5":13306,"_25514":52372,"_2665":52419},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3170":2245,"_28022":2226,"_19417":52421,"_5":13306,"_25514":52379,"_2665":52422},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3170":2246,"_28022":2226,"_19417":52424,"_5":13306,"_25514":52382,"_2665":52425},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3170":2247,"_28022":2226,"_19417":52427,"_5":13306,"_25514":52385,"_2665":52428},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3170":2248,"_28022":2226,"_19417":52430,"_5":13306,"_25514":52388,"_2665":52431},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3170":2249,"_28022":2226,"_19417":52433,"_5":13306,"_25514":52391,"_2665":52434},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3170":2250,"_28022":2226,"_19417":52436,"_5":13306,"_25514":52391,"_2665":52437},[],"its subject and extensions identify the expected client;",{"_3170":2251,"_28022":2226,"_19417":52439,"_5":13306,"_25514":52391,"_2665":52440},[],"its public key matches the client's private key;",{"_3170":2252,"_28022":2226,"_19417":52442,"_5":13306,"_25514":52391,"_2665":52443},[],"its chain reaches a root trusted by the consumer;",{"_3170":2253,"_28022":2226,"_19417":52445,"_5":13306,"_25514":52391,"_2665":52446},[],"its dates and usages allow the operation;",{"_3170":2254,"_28022":2226,"_19417":52448,"_5":13306,"_25514":52391,"_2665":52449},[],"the consumer applies revocation checks and authorization.",{"_3170":2255,"_28022":2226,"_19417":52451,"_5":13306,"_25514":52391,"_2665":52452},[],"The issuance path includes the first independent checks.",{"_3170":2256,"_28022":2226,"_19417":52454,"_5":13306,"_25514":52395,"_2665":52455},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3170":2257,"_28022":2226,"_19417":52457,"_5":13306,"_25514":52395,"_2665":52458},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3170":2258,"_28022":2226,"_19417":52460,"_5":13306,"_25514":52395,"_2665":52461},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3170":2259,"_28022":2259,"_5":13637,"_2665":52463,"_28344":52464,"_19417":52465,"_25514":2259},"Create your first CA",[45406,46799,50532,49967],[],{"_3170":2260,"_28022":2259,"_19417":52467,"_5":13306,"_25514":2259,"_2665":52468},[],"Create an evaluation root and check its certificate before issuing.",{"_3170":2261,"_28022":2259,"_5":28341,"_19417":52470,"_25514":52471,"_2665":45416},[],"/docs/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3170":2262,"_28022":2259,"_5":28341,"_19417":52473,"_25514":52474,"_2665":52475},[],"/docs/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3170":2263,"_28022":2259,"_5":28341,"_19417":52477,"_25514":52478,"_2665":52479},[],"/docs/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3170":2264,"_28022":2259,"_5":28341,"_19417":52481,"_25514":52482,"_2665":52483},[],"/docs/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3170":2265,"_28022":2259,"_5":28341,"_19417":52485,"_25514":52486,"_2665":52487},[],"/docs/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3170":2266,"_28022":2259,"_5":28341,"_19417":52489,"_25514":52490,"_2665":52491},[],"/docs/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3170":2267,"_28022":2259,"_5":28341,"_19417":52493,"_25514":52494,"_2665":52495},[],"/docs/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3170":2268,"_28022":2259,"_5":28341,"_19417":52497,"_25514":52498,"_2665":50225},[],"/docs/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3170":2269,"_28022":2259,"_5":28341,"_19417":52500,"_25514":52501,"_2665":45440},[],"/docs/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3170":2270,"_28022":2259,"_19417":52503,"_5":13306,"_25514":2259,"_2665":52504},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3170":2271,"_28022":2259,"_19417":52506,"_5":13306,"_25514":52471,"_2665":52507},[],"Console access and permission to create keys and authorities.",{"_3170":2272,"_28022":2259,"_19417":52509,"_5":13306,"_25514":52471,"_2665":52510},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3170":2273,"_28022":2259,"_19417":52512,"_5":13306,"_25514":52471,"_2665":52513},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3170":2274,"_28022":2259,"_19417":52515,"_5":13306,"_25514":52471,"_2665":52516},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3170":2275,"_28022":2259,"_19417":52518,"_5":13306,"_25514":52474,"_2665":52519},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3170":2276,"_28022":2259,"_19417":52521,"_5":13306,"_25514":52474,"_2665":52522},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3170":2277,"_28022":2259,"_19417":52524,"_5":13306,"_25514":52478,"_2665":52525},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3170":2278,"_28022":2259,"_19417":52527,"_5":13306,"_25514":52478,"_2665":52528},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3170":2279,"_28022":2259,"_19417":52530,"_5":13306,"_25514":52482,"_2665":52531},[],"Select **Root CA** and complete:",{"_3170":2280,"_28022":2259,"_19417":52533,"_5":13306,"_25514":52482,"_2665":52534},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3170":2281,"_28022":2259,"_19417":52536,"_5":13306,"_25514":52482,"_2665":52537},[],"**Subject**: organization and country details for your evaluation.",{"_3170":2282,"_28022":2259,"_19417":52539,"_5":13306,"_25514":52482,"_2665":52540},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3170":2283,"_28022":2259,"_19417":52542,"_5":13306,"_25514":52482,"_2665":52543},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3170":2284,"_28022":2259,"_19417":52545,"_5":13306,"_25514":52482,"_2665":52546},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3170":2285,"_28022":2259,"_19417":52548,"_5":13306,"_25514":52486,"_2665":52549},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3170":2286,"_28022":2259,"_19417":52551,"_5":13306,"_25514":52490,"_2665":52552},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3170":2287,"_28022":2259,"_19417":52554,"_5":13306,"_25514":52490,"_2665":52555},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3170":2288,"_28022":2259,"_19417":52557,"_5":13306,"_25514":52494,"_2665":52558},[],"Run from the directory where you saved `ca.pem`:",{"_3170":2289,"_28022":2259,"_19417":52560,"_5":13306,"_25514":52494,"_2665":52561},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3170":2290,"_28022":2259,"_19417":52563,"_5":13306,"_25514":52494,"_2665":52564},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3170":2291,"_28022":2259,"_19417":52566,"_5":13306,"_25514":52498,"_2665":52567},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3170":2292,"_28022":2259,"_19417":52569,"_5":13306,"_25514":52498,"_2665":52570},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3170":2293,"_28022":2259,"_19417":52572,"_5":13306,"_25514":52498,"_2665":52573},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3170":2294,"_28022":2259,"_19417":52575,"_5":13306,"_25514":52498,"_2665":52576},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3170":2295,"_28022":2259,"_19417":52578,"_5":13306,"_25514":52501,"_2665":52579},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3170":2296,"_28022":2296,"_5":13637,"_2665":52581,"_28344":52582,"_19417":52583,"_25514":2296},"Issue and verify a certificate",[45406,46799,50532,49967],[],{"_3170":2297,"_28022":2296,"_19417":52585,"_5":13306,"_25514":2296,"_2665":52586},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3170":2298,"_28022":2296,"_5":28341,"_19417":52588,"_25514":52589,"_2665":45416},[],"/docs/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3170":2299,"_28022":2296,"_5":28341,"_19417":52591,"_25514":52592,"_2665":52593},[],"/docs/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3170":2300,"_28022":2296,"_5":28341,"_19417":52595,"_25514":52596,"_2665":52597},[],"/docs/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3170":2301,"_28022":2296,"_5":28341,"_19417":52599,"_25514":52600,"_2665":52601},[],"/docs/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3170":2302,"_28022":2296,"_5":28341,"_19417":52603,"_25514":52604,"_2665":52605},[],"/docs/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3170":2303,"_28022":2296,"_5":28341,"_19417":52607,"_25514":52608,"_2665":52609},[],"/docs/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3170":2304,"_28022":2296,"_5":28341,"_19417":52611,"_25514":52612,"_2665":52613},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3170":2305,"_28022":2296,"_5":28341,"_19417":52615,"_25514":52616,"_2665":52617},[],"/docs/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3170":2306,"_28022":2296,"_5":28341,"_19417":52619,"_25514":52620,"_2665":52621},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3170":2307,"_28022":2296,"_5":28341,"_19417":52623,"_25514":52624,"_2665":52625},[],"/docs/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3170":2308,"_28022":2296,"_5":28341,"_19417":52627,"_25514":52628,"_2665":50225},[],"/docs/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3170":2309,"_28022":2296,"_5":28341,"_19417":52630,"_25514":52631,"_2665":45440},[],"/docs/platform/pki/quickstarts/issue-certificate#next-step",{"_3170":2310,"_28022":2296,"_19417":52633,"_5":13306,"_25514":2296,"_2665":52634},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3170":2311,"_28022":2296,"_19417":52636,"_5":13306,"_25514":52589,"_2665":52637},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3170":2312,"_28022":2296,"_19417":52639,"_5":13306,"_25514":52589,"_2665":52640},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3170":2313,"_28022":2296,"_19417":52642,"_5":13306,"_25514":52589,"_2665":52643},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3170":2314,"_28022":2296,"_19417":52645,"_5":13306,"_25514":52589,"_2665":52646},[],"A client identifier: here we use `device-001`.",{"_3170":2315,"_28022":2296,"_19417":52648,"_5":13306,"_25514":52589,"_2665":52649},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3170":2316,"_28022":2296,"_19417":52651,"_5":13306,"_25514":52592,"_2665":52652},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3170":2317,"_28022":2296,"_19417":52654,"_5":13306,"_25514":52596,"_2665":52655},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3170":2318,"_28022":2296,"_19417":52657,"_5":13306,"_25514":52596,"_2665":52658},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3170":2319,"_28022":2296,"_19417":52660,"_5":13306,"_25514":52600,"_2665":52661},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3170":2320,"_28022":2296,"_19417":52663,"_5":13306,"_25514":52600,"_2665":52664},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3170":2321,"_28022":2296,"_19417":52666,"_5":13306,"_25514":52604,"_2665":52667},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3170":2322,"_28022":2296,"_19417":52669,"_5":13306,"_25514":52604,"_2665":52670},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3170":2323,"_28022":2296,"_19417":52672,"_5":13306,"_25514":52608,"_2665":52673},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3170":2324,"_28022":2296,"_19417":52675,"_5":13306,"_25514":52612,"_2665":52676},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3170":2325,"_28022":2296,"_19417":52678,"_5":13306,"_25514":52616,"_2665":52679},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3170":2326,"_28022":2296,"_19417":52681,"_5":13306,"_25514":52620,"_2665":52682},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3170":2327,"_28022":2296,"_19417":52684,"_5":13306,"_25514":52620,"_2665":52685},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3170":2328,"_28022":2296,"_19417":52687,"_5":13306,"_25514":52620,"_2665":52688},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3170":2329,"_28022":2296,"_19417":52690,"_5":13306,"_25514":52624,"_2665":52691},[],"In Bash, compare the two public-key digests:",{"_3170":2330,"_28022":2296,"_19417":52693,"_5":13306,"_25514":52624,"_2665":52694},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3170":2331,"_28022":2296,"_19417":52696,"_5":13306,"_25514":52624,"_2665":52697},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3170":2332,"_28022":2296,"_19417":52699,"_5":13306,"_25514":52628,"_2665":50309},[],{"_3170":2333,"_28022":2296,"_19417":52701,"_5":13306,"_25514":52628,"_2665":52702},[],"What to review",{"_3170":2334,"_28022":2296,"_19417":52704,"_5":13306,"_25514":52628,"_2665":52705},[],"The CA rejects issuance",{"_3170":2335,"_28022":2296,"_19417":52707,"_5":13306,"_25514":52628,"_2665":52708},[],"Permissions, CA state and key, algorithm and profile.",{"_3170":2336,"_28022":2296,"_19417":52710,"_5":13306,"_25514":52628,"_2665":52711},[],"Different subject or usages",{"_3170":2337,"_28022":2296,"_19417":52713,"_5":13306,"_25514":52628,"_2665":52714},[],"Applied profile and requested values.",{"_3170":2338,"_28022":2296,"_19417":52716,"_5":13306,"_25514":52628,"_2665":52717},[],"Issuer cannot be found",{"_3170":2339,"_28022":2296,"_19417":52719,"_5":13306,"_25514":52628,"_2665":52720},[],"Downloaded CA and required intermediate chain.",{"_3170":2340,"_28022":2296,"_19417":52722,"_5":13306,"_25514":52628,"_2665":52723},[],"Validity fails",{"_3170":2341,"_28022":2296,"_19417":52725,"_5":13306,"_25514":52628,"_2665":52726},[],"Certificate and CA dates, and the computer's clock.",{"_3170":2342,"_28022":2296,"_19417":52728,"_5":13306,"_25514":52628,"_2665":52729},[],"Public-key digests differ",{"_3170":2343,"_28022":2296,"_19417":52731,"_5":13306,"_25514":52628,"_2665":52732},[],"Certificate and key files from the same issuance.",{"_3170":2344,"_28022":2296,"_19417":52734,"_5":13306,"_25514":52628,"_2665":52735},[],"See PKI diagnostics to narrow an issuance failure.",{"_3170":2345,"_28022":2296,"_19417":52737,"_5":13306,"_25514":52631,"_2665":52738},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3170":2346,"_28022":2296,"_19417":52740,"_5":13306,"_25514":52631,"_2665":52741},[],"Manage certificates for inspection, status and revocation.",{"_3170":2347,"_28022":2296,"_19417":52743,"_5":13306,"_25514":52631,"_2665":52744},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3170":2348,"_28022":2296,"_19417":52746,"_5":13306,"_25514":52631,"_2665":52747},[],"Prepare EST for the device to request its next identities.",{"_3170":2349,"_28022":2296,"_19417":52749,"_5":13306,"_25514":52631,"_2665":52750},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3170":2350,"_28022":2350,"_5":13637,"_2665":52752,"_28344":52753,"_19417":52754,"_25514":2350},"PKI getting started",[45406,46799,50532,49967],[],{"_3170":2351,"_28022":2350,"_19417":52756,"_5":13306,"_25514":2350,"_2665":52757},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3170":2352,"_28022":2350,"_5":28341,"_19417":52759,"_25514":52760,"_2665":45416},[],"/docs/platform/pki/quickstarts/overview#before-you-begin",{"_3170":2353,"_28022":2350,"_5":28341,"_19417":52762,"_25514":52763,"_2665":52764},[],"/docs/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3170":2354,"_28022":2350,"_5":28341,"_19417":52766,"_25514":52767,"_2665":50159},[],"/docs/platform/pki/quickstarts/overview#expected-result",{"_3170":2355,"_28022":2350,"_5":28341,"_19417":52769,"_25514":52770,"_2665":52771},[],"/docs/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3170":2356,"_28022":2350,"_19417":52773,"_5":13306,"_25514":2350,"_2665":52774},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3170":2357,"_28022":2350,"_19417":52776,"_5":13306,"_25514":52760,"_2665":52777},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3170":2358,"_28022":2350,"_19417":52779,"_5":13306,"_25514":52760,"_2665":52780},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3170":2359,"_28022":2350,"_19417":52782,"_5":13306,"_25514":52760,"_2665":52783},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3170":2360,"_28022":2350,"_19417":52785,"_5":13306,"_25514":52760,"_2665":52786},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3170":2361,"_28022":2350,"_19417":52788,"_5":13306,"_25514":52760,"_2665":52789},[],"A working directory with restricted access for the downloaded key.",{"_3170":2362,"_28022":2350,"_19417":52791,"_5":13306,"_25514":52763,"_2665":52792},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3170":2363,"_28022":2350,"_19417":52794,"_5":13306,"_25514":52763,"_2665":52795},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3170":2364,"_28022":2350,"_19417":52797,"_5":13306,"_25514":52763,"_2665":52798},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3170":2365,"_28022":2350,"_19417":52800,"_5":13306,"_25514":52763,"_2665":52801},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3170":2366,"_28022":2350,"_19417":52803,"_5":13306,"_25514":52767,"_2665":52804},[],"File or resource",{"_3170":2367,"_28022":2350,"_19417":52806,"_5":13306,"_25514":52767,"_2665":50156},[],{"_3170":2368,"_28022":2350,"_19417":52808,"_5":13306,"_25514":52767,"_2665":52809},[],"Active root CA and `ca.pem`",{"_3170":2369,"_28022":2350,"_19417":52811,"_5":13306,"_25514":52767,"_2665":52812},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3170":2370,"_28022":2350,"_19417":52814,"_5":13306,"_25514":52767,"_2665":52815},[],"End-entity certificate and `device.crt`",{"_3170":2371,"_28022":2350,"_19417":52817,"_5":13306,"_25514":52767,"_2665":52818},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3170":2372,"_28022":2350,"_19417":52820,"_5":13306,"_25514":52767,"_2665":52821},[],"Private key `device.key`",{"_3170":2373,"_28022":2350,"_19417":52823,"_5":13306,"_25514":52767,"_2665":52824},[],"Its public key matches the one included in `device.crt`.",{"_3170":2374,"_28022":2350,"_19417":52826,"_5":13306,"_25514":52767,"_2665":52827},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3170":2375,"_28022":2350,"_19417":52829,"_5":13306,"_25514":52770,"_2665":52830},[],"To operate certificates, continue with Certificates and Validation.",{"_3170":2376,"_28022":2350,"_19417":52832,"_5":13306,"_25514":52770,"_2665":52833},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3170":2377,"_28022":2350,"_19417":52835,"_5":13306,"_25514":52770,"_2665":52836},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3170":2378,"_28022":2378,"_5":13637,"_2665":52838,"_28344":52839,"_19417":52840,"_25514":2378},"PKI troubleshooting",[45406,46799,50532,49353],[],{"_3170":2379,"_28022":2378,"_19417":52842,"_5":13306,"_25514":2378,"_2665":52843},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3170":2380,"_28022":2378,"_5":28341,"_19417":52845,"_25514":52846,"_2665":52847},[],"/docs/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3170":2381,"_28022":2378,"_5":28341,"_19417":52849,"_25514":52850,"_2665":52851},[],"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3170":2382,"_28022":2378,"_5":28341,"_19417":52853,"_25514":52854,"_2665":52855},[],"/docs/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3170":2383,"_28022":2378,"_19417":52857,"_5":13306,"_25514":2378,"_2665":52858},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3170":2384,"_28022":2378,"_19417":52860,"_5":13306,"_25514":2378,"_2665":52861},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3170":2385,"_28022":2378,"_19417":52863,"_5":13306,"_25514":52846,"_2665":50156},[],{"_3170":2386,"_28022":2378,"_19417":52865,"_5":13306,"_25514":52846,"_2665":52866},[],"What to inspect",{"_3170":2387,"_28022":2378,"_19417":52868,"_5":13306,"_25514":52846,"_2665":45440},[],{"_3170":2388,"_28022":2378,"_19417":52870,"_5":13306,"_25514":52846,"_2665":52871},[],"CA",{"_3170":2389,"_28022":2378,"_19417":52873,"_5":13306,"_25514":52846,"_2665":52874},[],"Exists, is active and has usable dates.",{"_3170":2390,"_28022":2378,"_19417":52876,"_5":13306,"_25514":52846,"_2665":52877},[],"Authorities.",{"_3170":2391,"_28022":2378,"_19417":52879,"_5":13306,"_25514":52846,"_2665":52880},[],"Key",{"_3170":2392,"_28022":2378,"_19417":52882,"_5":13306,"_25514":52846,"_2665":52883},[],"The record has a usable private key and the engine can sign.",{"_3170":2393,"_28022":2378,"_19417":52885,"_5":13306,"_25514":52846,"_2665":52886},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3170":2394,"_28022":2378,"_19417":52888,"_5":13306,"_25514":52846,"_2665":52889},[],"CSR",{"_3170":2395,"_28022":2378,"_19417":52891,"_5":13306,"_25514":52846,"_2665":52892},[],"Correct PEM and verifiable signature.",{"_3170":2396,"_28022":2378,"_19417":52894,"_5":13306,"_25514":52846,"_2665":52895},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3170":2397,"_28022":2378,"_19417":52897,"_5":13306,"_25514":52846,"_2665":52898},[],"Profile",{"_3170":2398,"_28022":2378,"_19417":52900,"_5":13306,"_25514":52846,"_2665":52901},[],"Selected source, existing ID, allowed algorithm and size.",{"_3170":2399,"_28022":2378,"_19417":52903,"_5":13306,"_25514":52846,"_2665":52904},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3170":2400,"_28022":2378,"_19417":52906,"_5":13306,"_25514":52846,"_2665":50309},[],{"_3170":2401,"_28022":2378,"_19417":52908,"_5":13306,"_25514":52846,"_2665":52909},[],"Appropriate subject, SAN, usages and dates.",{"_3170":2402,"_28022":2378,"_19417":52911,"_5":13306,"_25514":52846,"_2665":52912},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3170":2403,"_28022":2378,"_19417":52914,"_5":13306,"_25514":52846,"_2665":52915},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3170":2404,"_28022":2378,"_19417":52917,"_5":13306,"_25514":52846,"_2665":52918},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3170":2405,"_28022":2378,"_19417":52920,"_5":13306,"_25514":52850,"_2665":52921},[],"Check each boundary independently:",{"_3170":2406,"_28022":2378,"_19417":52923,"_5":13306,"_25514":52850,"_2665":52924},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3170":2407,"_28022":2378,"_19417":52926,"_5":13306,"_25514":52850,"_2665":52927},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3170":2408,"_28022":2378,"_19417":52929,"_5":13306,"_25514":52850,"_2665":52930},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3170":2409,"_28022":2378,"_19417":52932,"_5":13306,"_25514":52850,"_2665":52933},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3170":2410,"_28022":2378,"_19417":52935,"_5":13306,"_25514":52850,"_2665":52936},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3170":2411,"_28022":2378,"_19417":52938,"_5":13306,"_25514":52850,"_2665":52939},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3170":2412,"_28022":2378,"_19417":52941,"_5":13306,"_25514":52854,"_2665":52942},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3170":2413,"_28022":2378,"_19417":52944,"_5":13306,"_25514":52854,"_2665":52945},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3170":2414,"_28022":2414,"_5":13637,"_2665":52947,"_28344":52948,"_19417":52950,"_25514":2414},"3.8.0 to 4.0.0",[45406,52949],"Upgrades",[],{"_3170":2415,"_28022":2414,"_19417":52952,"_5":13306,"_25514":2414,"_2665":52953},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3170":2416,"_28022":2414,"_5":28341,"_19417":52955,"_25514":52956,"_2665":52957},[],"/docs/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3170":2417,"_28022":2414,"_5":28341,"_19417":52959,"_25514":52960,"_2665":52961},[],"/docs/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3170":2418,"_28022":2414,"_5":28341,"_19417":52963,"_25514":52964,"_2665":52965},[],"/docs/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3170":2419,"_28022":2414,"_5":28341,"_19417":52967,"_25514":52968,"_2665":52969},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3170":2420,"_28022":2414,"_5":28341,"_19417":52971,"_25514":52972,"_2665":52973},[],"/docs/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3170":2421,"_28022":2414,"_5":28341,"_19417":52975,"_25514":52976,"_2665":52977},[],"/docs/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3170":2422,"_28022":2414,"_5":28341,"_19417":52979,"_25514":52980,"_2665":52981},[],"/docs/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3170":2423,"_28022":2414,"_5":28341,"_19417":52983,"_25514":52984,"_2665":52985},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3170":2424,"_28022":2414,"_5":28341,"_19417":52987,"_25514":52988,"_2665":52989},[],"/docs/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3170":2425,"_28022":2414,"_5":28341,"_19417":52991,"_25514":52992,"_2665":52993},[],"/docs/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3170":2426,"_28022":2414,"_5":28341,"_19417":52995,"_25514":52996,"_2665":52997},[],"/docs/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3170":2427,"_28022":2414,"_5":28341,"_19417":52999,"_25514":53000,"_2665":53001},[],"/docs/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3170":2428,"_28022":2414,"_5":28341,"_19417":53003,"_25514":53004,"_2665":53005},[],"/docs/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3170":2429,"_28022":2414,"_5":28341,"_19417":53007,"_25514":53008,"_2665":53009},[],"/docs/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3170":2430,"_28022":2414,"_5":28341,"_19417":53011,"_25514":53012,"_2665":53013},[],"/docs/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3170":2431,"_28022":2414,"_5":28341,"_19417":53015,"_25514":53016,"_2665":53017},[],"/docs/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3170":2432,"_28022":2414,"_5":28341,"_19417":53019,"_25514":53020,"_2665":53021},[],"/docs/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3170":2433,"_28022":2414,"_5":28341,"_19417":53023,"_25514":53024,"_2665":53025},[],"/docs/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3170":2434,"_28022":2414,"_5":28341,"_19417":53027,"_25514":53028,"_2665":53029},[],"/docs/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3170":2435,"_28022":2414,"_5":28341,"_19417":53031,"_25514":53032,"_2665":53033},[],"/docs/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3170":2436,"_28022":2414,"_5":28341,"_19417":53035,"_25514":53036,"_2665":53037},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3170":2437,"_28022":2414,"_5":28341,"_19417":53039,"_25514":53040,"_2665":53041},[],"/docs/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3170":2438,"_28022":2414,"_5":28341,"_19417":53043,"_25514":53044,"_2665":53045},[],"/docs/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3170":2439,"_28022":2414,"_5":28341,"_19417":53047,"_25514":53048,"_2665":53049},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3170":2440,"_28022":2414,"_5":28341,"_19417":53051,"_25514":53052,"_2665":53053},[],"/docs/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3170":2441,"_28022":2414,"_5":28341,"_19417":53055,"_25514":53056,"_2665":53057},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3170":2442,"_28022":2414,"_5":28341,"_19417":53059,"_25514":53060,"_2665":53061},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3170":2443,"_28022":2414,"_5":28341,"_19417":53063,"_25514":53064,"_2665":53065},[],"/docs/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3170":2444,"_28022":2414,"_5":28341,"_19417":53067,"_25514":53068,"_2665":53069},[],"/docs/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3170":2445,"_28022":2414,"_5":28341,"_19417":53071,"_25514":53072,"_2665":53073},[],"/docs/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3170":2446,"_28022":2414,"_5":28341,"_19417":53075,"_25514":53076,"_2665":53077},[],"/docs/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3170":2447,"_28022":2414,"_5":28341,"_19417":53079,"_25514":53080,"_2665":53081},[],"/docs/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3170":2448,"_28022":2414,"_5":28341,"_19417":53083,"_25514":53084,"_2665":53085},[],"/docs/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3170":2449,"_28022":2414,"_5":28341,"_19417":53087,"_25514":53088,"_2665":49353},[],"/docs/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3170":2450,"_28022":2414,"_5":28341,"_19417":53090,"_25514":53091,"_2665":53092},[],"/docs/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3170":2451,"_28022":2414,"_5":28341,"_19417":53094,"_25514":53095,"_2665":53096},[],"/docs/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3170":2452,"_28022":2414,"_19417":53098,"_5":13306,"_25514":2414,"_2665":53099},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3170":2453,"_28022":2414,"_19417":53101,"_5":13306,"_25514":2414,"_2665":53102},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3170":2454,"_28022":2414,"_19417":53104,"_5":13306,"_25514":2414,"_2665":53105},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3170":2455,"_28022":2414,"_19417":53107,"_5":13306,"_25514":2414,"_2665":53108},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3170":2456,"_28022":2414,"_19417":53110,"_5":13306,"_25514":2414,"_2665":53111},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3170":2457,"_28022":2414,"_19417":53113,"_5":13306,"_25514":2414,"_2665":53114},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3170":2458,"_28022":2414,"_19417":53116,"_5":13306,"_25514":2414,"_2665":53117},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3170":2459,"_28022":2414,"_19417":53119,"_5":13306,"_25514":52960,"_2665":53120},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3170":2460,"_28022":2414,"_19417":53122,"_5":13306,"_25514":52960,"_2665":53123},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3170":2461,"_28022":2414,"_19417":53125,"_5":13306,"_25514":52964,"_2665":53126},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3170":2462,"_28022":2414,"_19417":53128,"_5":13306,"_25514":52964,"_2665":53129},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and VA roles. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3170":2463,"_28022":2414,"_19417":53131,"_5":13306,"_25514":52968,"_2665":53132},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3170":2464,"_28022":2414,"_19417":53134,"_5":13306,"_25514":52972,"_2665":53135},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3170":2465,"_28022":2414,"_19417":53137,"_5":13306,"_25514":52972,"_2665":53138},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3170":2466,"_28022":2414,"_19417":53140,"_5":13306,"_25514":52972,"_2665":53141},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3170":2467,"_28022":2414,"_19417":53143,"_5":13306,"_25514":52972,"_2665":53144},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3170":2468,"_28022":2414,"_19417":53146,"_5":13306,"_25514":52972,"_2665":53147},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3170":2469,"_28022":2414,"_19417":53149,"_5":13306,"_25514":52976,"_2665":53150},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3170":2470,"_28022":2414,"_19417":53152,"_5":13306,"_25514":52976,"_2665":53153},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3170":2471,"_28022":2414,"_19417":53155,"_5":13306,"_25514":52976,"_2665":53156},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3170":2472,"_28022":2414,"_19417":53158,"_5":13306,"_25514":52976,"_2665":53159},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3170":2473,"_28022":2414,"_19417":53161,"_5":13306,"_25514":52976,"_2665":53162},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3170":2474,"_28022":2414,"_19417":53164,"_5":13306,"_25514":52980,"_2665":53165},[],"Change",{"_3170":2475,"_28022":2414,"_19417":53167,"_5":13306,"_25514":52980,"_2665":53168},[],"Who is affected",{"_3170":2476,"_28022":2414,"_19417":53170,"_5":13306,"_25514":52980,"_2665":53171},[],"Severity",{"_3170":2477,"_28022":2414,"_19417":53173,"_5":13306,"_25514":52980,"_2665":53174},[],"Action",{"_3170":2478,"_28022":2414,"_19417":53176,"_5":13306,"_25514":52980,"_2665":52989},[],{"_3170":2479,"_28022":2414,"_19417":53178,"_5":13306,"_25514":52980,"_2665":53179},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3170":2480,"_28022":2414,"_19417":53181,"_5":13306,"_25514":52980,"_2665":53182},[],"High: KMS and VA start on empty volumes",{"_3170":2481,"_28022":2414,"_19417":53184,"_5":13306,"_25514":52980,"_2665":53185},[],"Copy the data into the new volumes",{"_3170":2482,"_28022":2414,"_19417":53187,"_5":13306,"_25514":52980,"_2665":52993},[],{"_3170":2483,"_28022":2414,"_19417":53189,"_5":13306,"_25514":52980,"_2665":53190},[],"Every Helm release",{"_3170":2484,"_28022":2414,"_19417":53192,"_5":13306,"_25514":52980,"_2665":53193},[],"High: `helm upgrade` fails",{"_3170":2485,"_28022":2414,"_19417":53195,"_5":13306,"_25514":52980,"_2665":53196},[],"Remove or rename legacy keys",{"_3170":2486,"_28022":2414,"_19417":53198,"_5":13306,"_25514":52980,"_2665":52997},[],{"_3170":2487,"_28022":2414,"_19417":53200,"_5":13306,"_25514":52980,"_2665":53201},[],"Every deployment",{"_3170":2488,"_28022":2414,"_19417":53203,"_5":13306,"_25514":52980,"_2665":53204},[],"High: without a bootstrap principal there is no administrator",{"_3170":2489,"_28022":2414,"_19417":53206,"_5":13306,"_25514":52980,"_2665":53207},[],"Configure `services.authz`",{"_3170":2490,"_28022":2414,"_19417":53209,"_5":13306,"_25514":52980,"_2665":53001},[],{"_3170":2491,"_28022":2414,"_19417":53211,"_5":13306,"_25514":52980,"_2665":53190},[],{"_3170":2492,"_28022":2414,"_19417":53213,"_5":13306,"_25514":52980,"_2665":53214},[],"High: `helm upgrade` fails on the old keys",{"_3170":2493,"_28022":2414,"_19417":53216,"_5":13306,"_25514":52980,"_2665":53217},[],"Move JWKS and roles into `services.authz`",{"_3170":2494,"_28022":2414,"_19417":53219,"_5":13306,"_25514":52980,"_2665":53021},[],{"_3170":2495,"_28022":2414,"_19417":53221,"_5":13306,"_25514":52980,"_2665":53222},[],"3.8.0 deployments with per-service databases",{"_3170":2496,"_28022":2414,"_19417":53224,"_5":13306,"_25514":52980,"_2665":53225},[],"High: services find no data, or a migration aborts",{"_3170":2497,"_28022":2414,"_19417":53227,"_5":13306,"_25514":52980,"_2665":53228},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3170":2498,"_28022":2414,"_19417":53230,"_5":13306,"_25514":52980,"_2665":53025},[],{"_3170":2499,"_28022":2414,"_19417":53232,"_5":13306,"_25514":52980,"_2665":53233},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3170":2500,"_28022":2414,"_19417":53235,"_5":13306,"_25514":52980,"_2665":53236},[],"High: the backend no longer starts with them",{"_3170":2501,"_28022":2414,"_19417":53238,"_5":13306,"_25514":52980,"_2665":53239},[],"Move to PostgreSQL before upgrading",{"_3170":2502,"_28022":2414,"_19417":53241,"_5":13306,"_25514":52980,"_2665":53242},[],"Webhooks with file references",{"_3170":2503,"_28022":2414,"_19417":53244,"_5":13306,"_25514":52980,"_2665":53245},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3170":2504,"_28022":2414,"_19417":53247,"_5":13306,"_25514":52980,"_2665":53248},[],"High: enrollments calling the webhook fail",{"_3170":2505,"_28022":2414,"_19417":53250,"_5":13306,"_25514":52980,"_2665":53251},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3170":2506,"_28022":2414,"_19417":53253,"_5":13306,"_25514":52980,"_2665":53005},[],{"_3170":2507,"_28022":2414,"_19417":53255,"_5":13306,"_25514":52980,"_2665":53256},[],"Releases with per-service identity overrides or mounted key material",{"_3170":2508,"_28022":2414,"_19417":53258,"_5":13306,"_25514":52980,"_2665":53259},[],"Medium: services cannot read their files",{"_3170":2509,"_28022":2414,"_19417":53261,"_5":13306,"_25514":52980,"_2665":53262},[],"Remove the overrides and fix volume ownership",{"_3170":2510,"_28022":2414,"_19417":53264,"_5":13306,"_25514":52980,"_2665":53009},[],{"_3170":2511,"_28022":2414,"_19417":53266,"_5":13306,"_25514":52980,"_2665":53267},[],"Releases that set `amqp.tls`",{"_3170":2512,"_28022":2414,"_19417":53269,"_5":13306,"_25514":52980,"_2665":53270},[],"Medium: clients connect to the wrong port",{"_3170":2513,"_28022":2414,"_19417":53272,"_5":13306,"_25514":52980,"_2665":53273},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3170":2514,"_28022":2414,"_19417":53275,"_5":13306,"_25514":52980,"_2665":53029},[],{"_3170":2515,"_28022":2414,"_19417":53277,"_5":13306,"_25514":52980,"_2665":53278},[],"Installations whose CA keys predate the KMS",{"_3170":2516,"_28022":2414,"_19417":53280,"_5":13306,"_25514":52980,"_2665":53281},[],"Medium: CA keys stay unmanaged",{"_3170":2517,"_28022":2414,"_19417":53283,"_5":13306,"_25514":52980,"_2665":53284},[],"Run the CA-to-KMS migration",{"_3170":2518,"_28022":2414,"_19417":53286,"_5":13306,"_25514":52980,"_2665":53287},[],"Receiver certificate verification",{"_3170":2519,"_28022":2414,"_19417":53289,"_5":13306,"_25514":52980,"_2665":53290},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3170":2520,"_28022":2414,"_19417":53292,"_5":13306,"_25514":52980,"_2665":53293},[],"Medium: credentials go to an unverified receiver",{"_3170":2521,"_28022":2414,"_19417":53295,"_5":13306,"_25514":52980,"_2665":53296},[],"Set `insecure_skip_verify` to `false`",{"_3170":2522,"_28022":2414,"_19417":53298,"_5":13306,"_25514":52980,"_2665":53041},[],{"_3170":2523,"_28022":2414,"_19417":53300,"_5":13306,"_25514":52980,"_2665":53301},[],"Scripts and consoles that edit DMSs through the API",{"_3170":2524,"_28022":2414,"_19417":53303,"_5":13306,"_25514":52980,"_2665":53304},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3170":2525,"_28022":2414,"_19417":53306,"_5":13306,"_25514":52980,"_2665":53307},[],"Read the DMS before editing and use the new field",{"_3170":2526,"_28022":2414,"_19417":53309,"_5":13306,"_25514":52980,"_2665":53057},[],{"_3170":2527,"_28022":2414,"_19417":53311,"_5":13306,"_25514":52980,"_2665":53312},[],"Consumers that read the device `events` field",{"_3170":2528,"_28022":2414,"_19417":53314,"_5":13306,"_25514":52980,"_2665":53315},[],"Medium: the field disappears",{"_3170":2529,"_28022":2414,"_19417":53317,"_5":13306,"_25514":52980,"_2665":53318},[],"Use the new event endpoints",{"_3170":2530,"_28022":2414,"_19417":53320,"_5":13306,"_25514":52980,"_2665":53013},[],{"_3170":2531,"_28022":2414,"_19417":53322,"_5":13306,"_25514":52980,"_2665":53323},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3170":2532,"_28022":2414,"_19417":53325,"_5":13306,"_25514":52980,"_2665":53326},[],"Low to medium: validation errors or changed defaults",{"_3170":2533,"_28022":2414,"_19417":53328,"_5":13306,"_25514":52980,"_2665":53329},[],"Update the values file",{"_3170":2534,"_28022":2414,"_19417":53331,"_5":13306,"_25514":52980,"_2665":53049},[],{"_3170":2535,"_28022":2414,"_19417":53333,"_5":13306,"_25514":52980,"_2665":53334},[],"Clients that send the DMS ID in the update body",{"_3170":2536,"_28022":2414,"_19417":53336,"_5":13306,"_25514":52980,"_2665":53337},[],"Low: the ID in the URL wins",{"_3170":2537,"_28022":2414,"_19417":53339,"_5":13306,"_25514":52980,"_2665":53340},[],"Send the ID in the URL",{"_3170":2538,"_28022":2414,"_19417":53342,"_5":13306,"_25514":52980,"_2665":53053},[],{"_3170":2539,"_28022":2414,"_19417":53344,"_5":13306,"_25514":52980,"_2665":53345},[],"Consumers that match on certificate `type`",{"_3170":2540,"_28022":2414,"_19417":53347,"_5":13306,"_25514":52980,"_2665":53348},[],"Low: two values are renamed",{"_3170":2541,"_28022":2414,"_19417":53350,"_5":13306,"_25514":52980,"_2665":53351},[],"Adapt consumers",{"_3170":2542,"_28022":2414,"_19417":53353,"_5":13306,"_25514":52980,"_2665":53045},[],{"_3170":2543,"_28022":2414,"_19417":53355,"_5":13306,"_25514":52980,"_2665":53356},[],"Any DMS",{"_3170":2544,"_28022":2414,"_19417":53358,"_5":13306,"_25514":52980,"_2665":53359},[],"Low: informational",{"_3170":2545,"_28022":2414,"_19417":53361,"_5":13306,"_25514":52980,"_2665":53362},[],"Read both blocks before editing",{"_3170":2546,"_28022":2414,"_19417":53364,"_5":13306,"_25514":52988,"_2665":53365},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3170":2547,"_28022":2414,"_19417":53367,"_5":13306,"_25514":52988,"_2665":53368},[],"Step 4 of the migration guide copies the data.",{"_3170":2548,"_28022":2414,"_19417":53370,"_5":13306,"_25514":52992,"_2665":53371},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3170":2549,"_28022":2414,"_19417":53373,"_5":13306,"_25514":52996,"_2665":53374},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3170":2550,"_28022":2414,"_19417":53376,"_5":13306,"_25514":53000,"_2665":53377},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3170":2551,"_28022":2414,"_19417":53379,"_5":13306,"_25514":53004,"_2665":53380},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3170":2552,"_28022":2414,"_19417":53382,"_5":13306,"_25514":53004,"_2665":53383},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3170":2553,"_28022":2414,"_19417":53385,"_5":13306,"_25514":53008,"_2665":53386},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3170":2554,"_28022":2414,"_19417":53388,"_5":13306,"_25514":53012,"_2665":53389},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3170":2555,"_28022":2414,"_19417":53391,"_5":13306,"_25514":53012,"_2665":53392},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3170":2556,"_28022":2414,"_19417":53394,"_5":13306,"_25514":53012,"_2665":53395},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3170":2557,"_28022":2414,"_19417":53397,"_5":13306,"_25514":53012,"_2665":53398},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3170":2558,"_28022":2414,"_19417":53400,"_5":13306,"_25514":53012,"_2665":53401},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3170":2559,"_28022":2414,"_19417":53403,"_5":13306,"_25514":53012,"_2665":53404},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3170":2560,"_28022":2414,"_19417":53406,"_5":13306,"_25514":53020,"_2665":53407},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3170":2561,"_28022":2414,"_19417":53409,"_5":13306,"_25514":53020,"_2665":53410},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3170":2562,"_28022":2414,"_19417":53412,"_5":13306,"_25514":53020,"_2665":53413},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3170":2563,"_28022":2414,"_19417":53415,"_5":13306,"_25514":53020,"_2665":53416},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3170":2564,"_28022":2414,"_19417":53418,"_5":13306,"_25514":53020,"_2665":53419},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3170":2565,"_28022":2414,"_19417":53421,"_5":13306,"_25514":53024,"_2665":53422},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3170":2566,"_28022":2414,"_19417":53424,"_5":13306,"_25514":53028,"_2665":53425},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3170":2567,"_28022":2414,"_19417":53427,"_5":13306,"_25514":53028,"_2665":53428},[],"The `key_id` is the certificate's `subject_key_id` (SHA-256 of the public key).",{"_3170":2568,"_28022":2414,"_19417":53430,"_5":13306,"_25514":53028,"_2665":53431},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3170":2569,"_28022":2414,"_19417":53433,"_5":13306,"_25514":53028,"_2665":53434},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3170":2570,"_28022":2414,"_19417":53436,"_5":13306,"_25514":53028,"_2665":53437},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3170":2571,"_28022":2414,"_19417":53439,"_5":13306,"_25514":53028,"_2665":53440},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3170":2572,"_28022":2414,"_19417":53442,"_5":13306,"_25514":53036,"_2665":53443},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3170":2573,"_28022":2414,"_19417":53445,"_5":13306,"_25514":53036,"_2665":53446},[],"Field in 3.8.0",{"_3170":2574,"_28022":2414,"_19417":53448,"_5":13306,"_25514":53036,"_2665":53449},[],"Field in 4.0.0",{"_3170":2575,"_28022":2414,"_19417":53451,"_5":13306,"_25514":53036,"_2665":53452},[],"`validate_server_cert`",{"_3170":2576,"_28022":2414,"_19417":53454,"_5":13306,"_25514":53036,"_2665":53455},[],"`insecure_skip_verify` (value negated)",{"_3170":2577,"_28022":2414,"_19417":53457,"_5":13306,"_25514":53036,"_2665":53458},[],"`oidc`",{"_3170":2578,"_28022":2414,"_19417":53460,"_5":13306,"_25514":53036,"_2665":53461},[],"`jwt_options`",{"_3170":2579,"_28022":2414,"_19417":53463,"_5":13306,"_25514":53036,"_2665":53464},[],"`apikey`",{"_3170":2580,"_28022":2414,"_19417":53466,"_5":13306,"_25514":53036,"_2665":53467},[],"`apikey_options`",{"_3170":2581,"_28022":2414,"_19417":53469,"_5":13306,"_25514":53036,"_2665":53470},[],"`mtls`",{"_3170":2582,"_28022":2414,"_19417":53472,"_5":13306,"_25514":53036,"_2665":53473},[],"`mtls_options`",{"_3170":2583,"_28022":2414,"_19417":53475,"_5":13306,"_25514":53036,"_2665":53476},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3170":2584,"_28022":2414,"_19417":53478,"_5":13306,"_25514":53036,"_2665":53479},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3170":2585,"_28022":2414,"_19417":53481,"_5":13306,"_25514":53036,"_2665":53482},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3170":2586,"_28022":2414,"_19417":53484,"_5":13306,"_25514":53040,"_2665":53485},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3170":2587,"_28022":2414,"_19417":53487,"_5":13306,"_25514":53040,"_2665":53488},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3170":2588,"_28022":2414,"_19417":53490,"_5":13306,"_25514":53040,"_2665":53491},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3170":2589,"_28022":2414,"_19417":53493,"_5":13306,"_25514":53044,"_2665":53494},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3170":2590,"_28022":2414,"_19417":53496,"_5":13306,"_25514":53048,"_2665":53497},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3170":2591,"_28022":2414,"_19417":53499,"_5":13306,"_25514":53052,"_2665":53500},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3170":2592,"_28022":2414,"_19417":53502,"_5":13306,"_25514":53056,"_2665":53503},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3170":2593,"_28022":2414,"_19417":53505,"_5":13306,"_25514":53056,"_2665":53506},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3170":2594,"_28022":2414,"_19417":53508,"_5":13306,"_25514":53056,"_2665":53509},[],"`POST /v1/devices/:id/events` creates an event.",{"_3170":2595,"_28022":2414,"_19417":53511,"_5":13306,"_25514":53056,"_2665":53512},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3170":2596,"_28022":2414,"_19417":53514,"_5":13306,"_25514":53060,"_2665":53515},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3170":2597,"_28022":2414,"_19417":53517,"_5":13306,"_25514":53064,"_2665":53518},[],"Take a verifiable backup of PostgreSQL and schedule downtime. The upgrade moves every service's data into `pki`.",{"_3170":2598,"_28022":2414,"_19417":53520,"_5":13306,"_25514":53064,"_2665":53521},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3170":2599,"_28022":2414,"_19417":53523,"_5":13306,"_25514":53064,"_2665":53524},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3170":2600,"_28022":2414,"_19417":53526,"_5":13306,"_25514":53064,"_2665":53527},[],"Record the names of your local-storage PVCs:",{"_3170":2601,"_28022":2414,"_19417":53529,"_5":13306,"_25514":53064,"_2665":53530},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3170":2602,"_28022":2414,"_19417":53532,"_5":13306,"_25514":53068,"_2665":53533},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3170":2603,"_28022":2414,"_19417":53535,"_5":13306,"_25514":53068,"_2665":53536},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3170":2604,"_28022":2414,"_19417":53538,"_5":13306,"_25514":53068,"_2665":53539},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3170":2605,"_28022":2414,"_19417":53541,"_5":13306,"_25514":53068,"_2665":53542},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3170":2606,"_28022":2414,"_19417":53544,"_5":13306,"_25514":53068,"_2665":53545},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3170":2607,"_28022":2414,"_19417":53547,"_5":13306,"_25514":53068,"_2665":53548},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3170":2608,"_28022":2414,"_19417":53550,"_5":13306,"_25514":53068,"_2665":53551},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3170":2609,"_28022":2414,"_19417":53553,"_5":13306,"_25514":53068,"_2665":53554},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3170":2610,"_28022":2414,"_19417":53556,"_5":13306,"_25514":53068,"_2665":53557},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3170":2611,"_28022":2414,"_19417":53559,"_5":13306,"_25514":53068,"_2665":53560},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3170":2612,"_28022":2414,"_19417":53562,"_5":13306,"_25514":53068,"_2665":53563},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3170":2613,"_28022":2414,"_19417":53565,"_5":13306,"_25514":53068,"_2665":53566},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3170":2614,"_28022":2414,"_19417":53568,"_5":13306,"_25514":53072,"_2665":53569},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3170":2615,"_28022":2414,"_19417":53571,"_5":13306,"_25514":53072,"_2665":53572},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3170":2616,"_28022":2414,"_19417":53574,"_5":13306,"_25514":53076,"_2665":53575},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3170":2617,"_28022":2414,"_19417":53577,"_5":13306,"_25514":53076,"_2665":53578},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3170":2618,"_28022":2414,"_19417":53580,"_5":13306,"_25514":53076,"_2665":53581},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3170":2619,"_28022":2414,"_19417":53583,"_5":13306,"_25514":53076,"_2665":53584},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3170":2620,"_28022":2414,"_19417":53586,"_5":13306,"_25514":53076,"_2665":53587},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3170":2621,"_28022":2414,"_19417":53589,"_5":13306,"_25514":53076,"_2665":53590},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3170":2622,"_28022":2414,"_19417":53592,"_5":13306,"_25514":53076,"_2665":53593},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3170":2623,"_28022":2414,"_19417":53595,"_5":13306,"_25514":53076,"_2665":53596},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3170":2624,"_28022":2414,"_19417":53598,"_5":13306,"_25514":53076,"_2665":53599},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3170":2625,"_28022":2414,"_19417":53601,"_5":13306,"_25514":53076,"_2665":53602},[],"**Remove the helper and restore the recorded replica counts:**",{"_3170":2626,"_28022":2414,"_19417":53604,"_5":13306,"_25514":53076,"_2665":53605},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3170":2627,"_28022":2414,"_19417":53607,"_5":13306,"_25514":53080,"_2665":53608},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3170":2628,"_28022":2414,"_19417":53610,"_5":13306,"_25514":53080,"_2665":53611},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3170":2629,"_28022":2414,"_19417":53613,"_5":13306,"_25514":53084,"_2665":53614},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3170":2630,"_28022":2414,"_19417":53616,"_5":13306,"_25514":53084,"_2665":53617},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3170":2631,"_28022":2414,"_19417":53619,"_5":13306,"_25514":53084,"_2665":53620},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3170":2632,"_28022":2414,"_19417":53622,"_5":13306,"_25514":53084,"_2665":53623},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3170":2633,"_28022":2414,"_19417":53625,"_5":13306,"_25514":53084,"_2665":53626},[],"The `goose-lamassu` README still shows per-database examples (`dbname=ca`, `dbname=kms`) and claims the tool validates the database name, and the `ca-to-kms-migration` README still describes the pre-4.0.0 two-database layout. Follow the `dbname=pki` form on this page instead of their examples.",{"_3170":2634,"_28022":2414,"_19417":53628,"_5":13306,"_25514":53088,"_2665":53629},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3170":2635,"_28022":2414,"_19417":53631,"_5":13306,"_25514":53088,"_2665":53632},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3170":2636,"_28022":2414,"_19417":53634,"_5":13306,"_25514":53088,"_2665":53635},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3170":2637,"_28022":2414,"_19417":53637,"_5":13306,"_25514":53088,"_2665":53638},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3170":2638,"_28022":2414,"_19417":53640,"_5":13306,"_25514":53088,"_2665":53641},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted on duplicate CA IDs or missing `engine_id` values. Check the job logs, fix the privileges or the data, and re-run the upgrade.",{"_3170":2639,"_28022":2414,"_19417":53643,"_5":13306,"_25514":53088,"_2665":53644},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3170":2640,"_28022":2414,"_19417":53646,"_5":13306,"_25514":53088,"_2665":53647},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3170":2641,"_28022":2414,"_19417":53649,"_5":13306,"_25514":53091,"_2665":53650},[],"After the upgrade, check in this order:",{"_3170":2642,"_28022":2414,"_19417":53652,"_5":13306,"_25514":53091,"_2665":53653},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations.",{"_3170":2643,"_28022":2414,"_19417":53655,"_5":13306,"_25514":53091,"_2665":53656},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3170":2644,"_28022":2414,"_19417":53658,"_5":13306,"_25514":53091,"_2665":53659},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3170":2645,"_28022":2414,"_19417":53661,"_5":13306,"_25514":53091,"_2665":53662},[],"**Existing CRLs are served.** `GET /crl/<ca-ski>` on VA returns a previously issued CRL, and new CRLs are issued.",{"_3170":2646,"_28022":2414,"_19417":53664,"_5":13306,"_25514":53091,"_2665":53665},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS.",{"_3170":2647,"_28022":2414,"_19417":53667,"_5":13306,"_25514":53091,"_2665":53668},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3170":2648,"_28022":2414,"_19417":53670,"_5":13306,"_25514":53091,"_2665":53671},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3170":2649,"_28022":2414,"_19417":53673,"_5":13306,"_25514":53091,"_2665":53674},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3170":2650,"_28022":2414,"_19417":53676,"_5":13306,"_25514":53091,"_2665":53677},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3170":2651,"_28022":2414,"_19417":53679,"_5":13306,"_25514":53091,"_2665":53680},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3170":2652,"_28022":2414,"_19417":53682,"_5":13306,"_25514":53091,"_2665":53683},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3170":2653,"_28022":2414,"_19417":53685,"_5":13306,"_25514":53091,"_2665":53686},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3170":2654,"_28022":2414,"_19417":53688,"_5":13306,"_25514":53091,"_2665":53689},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3170":2655,"_28022":2414,"_19417":53691,"_5":13306,"_25514":53091,"_2665":53692},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3170":2656,"_28022":2414,"_19417":53694,"_5":13306,"_25514":53095,"_2665":53695},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3170":2657,"_28022":2414,"_19417":53697,"_5":13306,"_25514":53095,"_2665":53698},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3170":2658,"_28022":2414,"_19417":53700,"_5":13306,"_25514":53095,"_2665":53701},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3170":2659,"_28022":2414,"_19417":53703,"_5":13306,"_25514":53095,"_2665":53704},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3170":2660,"_28022":2414,"_19417":53706,"_5":13306,"_25514":53095,"_2665":53707},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_53710":53711,"_53712":53713,"_53714":53715,"_53716":53717,"_16910":2687,"_64315":2687},"language","english","sortableProperties",[2665,28022,5,25514],"sortablePropertiesWithTypes",{"_2665":23219,"_28022":23219,"_5":23219,"_25514":23219},"sorts",{"_2665":53718,"_28022":56368,"_5":59017,"_25514":61666},{"_4261":53719,"_53720":53