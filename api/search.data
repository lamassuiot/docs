s-marketplace#lanza-y-verifica","Lanza y verifica",{"_3355":68103,"_29485":68095,"_5":29814,"_20482":112728,"_26831":112729,"_2843":112730},[],"/docs/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3355":68104,"_29485":68095,"_20482":112732,"_5":14053,"_26831":68095,"_2843":112733},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3355":68105,"_29485":68095,"_20482":112735,"_5":14053,"_26831":112705,"_2843":112736},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3355":68106,"_29485":68095,"_20482":112738,"_5":14053,"_26831":112705,"_2843":112739},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3355":68107,"_29485":68095,"_20482":112741,"_5":14053,"_26831":112705,"_2843":112742},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3355":68108,"_29485":68095,"_20482":112744,"_5":14053,"_26831":112709,"_2843":112745},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3355":68109,"_29485":68095,"_20482":112747,"_5":14053,"_26831":112709,"_2843":112748},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3355":68110,"_29485":68095,"_20482":112750,"_5":14053,"_26831":112709,"_2843":112751},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3355":68111,"_29485":68095,"_20482":112753,"_5":14053,"_26831":112713,"_2843":112754},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3355":68112,"_29485":68095,"_20482":112756,"_5":14053,"_26831":112717,"_2843":112757},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3355":68113,"_29485":68095,"_20482":112759,"_5":14053,"_26831":112721,"_2843":112760},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3355":68114,"_29485":68095,"_20482":112762,"_5":14053,"_26831":112725,"_2843":112763},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3355":68115,"_29485":68095,"_20482":112765,"_5":14053,"_26831":112729,"_2843":112766},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3355":68116,"_29485":68116,"_5":14411,"_2843":112768,"_29817":112769,"_20482":112770,"_26831":68116},"Despliega Lamassu",[47939,112697],[],{"_3355":68117,"_29485":68116,"_20482":112772,"_5":14053,"_26831":68116,"_2843":112773},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3355":68118,"_29485":68116,"_5":29814,"_20482":112775,"_26831":112776,"_2843":112777},[],"/docs/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3355":68119,"_29485":68116,"_5":29814,"_20482":112779,"_26831":112780,"_2843":112781},[],"/docs/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3355":68120,"_29485":68116,"_5":29814,"_20482":112783,"_26831":112784,"_2843":112785},[],"/docs/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3355":68121,"_29485":68116,"_20482":112787,"_5":14053,"_26831":68116,"_2843":112788},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3355":68122,"_29485":68116,"_20482":112790,"_5":14053,"_26831":112776,"_2843":112791},[],"Modelo",{"_3355":68123,"_29485":68116,"_20482":112793,"_5":14053,"_26831":112776,"_2843":112794},[],"Recomendado para",{"_3355":68124,"_29485":68116,"_20482":112796,"_5":14053,"_26831":112776,"_2843":112797},[],"Quién opera la infraestructura",{"_3355":68125,"_29485":68116,"_20482":112799,"_5":14053,"_26831":112776,"_2843":112800},[],"Punto de partida",{"_3355":68126,"_29485":68116,"_20482":112802,"_5":14053,"_26831":112776,"_2843":48046},[],{"_3355":68127,"_29485":68116,"_20482":112804,"_5":14053,"_26831":112776,"_2843":112805},[],"Producción, entornos regulados y despliegues personalizados",{"_3355":68128,"_29485":68116,"_20482":112807,"_5":14053,"_26831":112776,"_2843":112808},[],"Tu equipo",{"_3355":68129,"_29485":68116,"_20482":112810,"_5":14053,"_26831":112776,"_2843":112811},[],"Helm o Fastlane",{"_3355":68130,"_29485":68116,"_20482":112813,"_5":14053,"_26831":112776,"_2843":48058},[],{"_3355":68131,"_29485":68116,"_20482":112815,"_5":14053,"_26831":112776,"_2843":112816},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3355":68132,"_29485":68116,"_20482":112818,"_5":14053,"_26831":112776,"_2843":112808},[],{"_3355":68133,"_29485":68116,"_20482":112820,"_5":14053,"_26831":112776,"_2843":112821},[],"Imagen preconfigurada en EC2",{"_3355":68134,"_29485":68116,"_20482":112823,"_5":14053,"_26831":112776,"_2843":48069},[],{"_3355":68135,"_29485":68116,"_20482":112825,"_5":14053,"_26831":112776,"_2843":112826},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3355":68136,"_29485":68116,"_20482":112828,"_5":14053,"_26831":112776,"_2843":48075},[],{"_3355":68137,"_29485":68116,"_20482":112830,"_5":14053,"_26831":112776,"_2843":112831},[],"Suscripción gestionada",{"_3355":68138,"_29485":68116,"_20482":112833,"_5":14053,"_26831":112776,"_2843":112834},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3355":68139,"_29485":68116,"_20482":112836,"_5":14053,"_26831":112776,"_2843":112837},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3355":68140,"_29485":68116,"_20482":112839,"_5":14053,"_26831":112776,"_2843":112840},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3355":68141,"_29485":68116,"_20482":112842,"_5":14053,"_26831":112780,"_2843":112843},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3355":68142,"_29485":68116,"_20482":112845,"_5":14053,"_26831":112784,"_2843":112846},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3355":68143,"_29485":68143,"_5":14411,"_2843":112848,"_29817":112849,"_20482":112850,"_26831":68143},"Utiliza Lamassu como SaaS",[47939,112697,112698],[],{"_3355":68144,"_29485":68143,"_20482":112852,"_5":14053,"_26831":68143,"_2843":112853},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3355":68145,"_29485":68143,"_5":29814,"_20482":112855,"_26831":112856,"_2843":112857},[],"/docs/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3355":68146,"_29485":68143,"_5":29814,"_20482":112859,"_26831":112860,"_2843":112861},[],"/docs/es/deployment/saas#planes","Planes",{"_3355":68147,"_29485":68143,"_5":29814,"_20482":112863,"_26831":112864,"_2843":112865},[],"/docs/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3355":68148,"_29485":68143,"_20482":112867,"_5":14053,"_26831":68143,"_2843":112868},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3355":68149,"_29485":68143,"_20482":112870,"_5":14053,"_26831":112856,"_2843":112871},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3355":68150,"_29485":68143,"_20482":112873,"_5":14053,"_26831":112856,"_2843":112874},[],"Copias de seguridad automáticas.",{"_3355":68151,"_29485":68143,"_20482":112876,"_5":14053,"_26831":112856,"_2843":112877},[],"Actualizaciones de versión.",{"_3355":68152,"_29485":68143,"_20482":112879,"_5":14053,"_26831":112856,"_2843":112880},[],"Soporte técnico y SLA según el plan contratado.",{"_3355":68153,"_29485":68143,"_20482":112882,"_5":14053,"_26831":112860,"_2843":48130},[],{"_3355":68154,"_29485":68143,"_20482":112884,"_5":14053,"_26831":112860,"_2843":112885},[],"Dispositivos",{"_3355":68155,"_29485":68143,"_20482":112887,"_5":14053,"_26831":112860,"_2843":112888},[],"Soporte",{"_3355":68156,"_29485":68143,"_20482":112890,"_5":14053,"_26831":112860,"_2843":48139},[],{"_3355":68157,"_29485":68143,"_20482":112892,"_5":14053,"_26831":112860,"_2843":48142},[],{"_3355":68158,"_29485":68143,"_20482":112894,"_5":14053,"_26831":112860,"_2843":112895},[],"Hasta 1.000",{"_3355":68159,"_29485":68143,"_20482":112897,"_5":14053,"_26831":112860,"_2843":48148},[],{"_3355":68160,"_29485":68143,"_20482":112899,"_5":14053,"_26831":112860,"_2843":112900},[],"99,5 %",{"_3355":68161,"_29485":68143,"_20482":112902,"_5":14053,"_26831":112860,"_2843":48154},[],{"_3355":68162,"_29485":68143,"_20482":112904,"_5":14053,"_26831":112860,"_2843":112905},[],"Hasta 10.000",{"_3355":68163,"_29485":68143,"_20482":112907,"_5":14053,"_26831":112860,"_2843":112908},[],"Email y chat",{"_3355":68164,"_29485":68143,"_20482":112910,"_5":14053,"_26831":112860,"_2843":112911},[],"99,9 %",{"_3355":68165,"_29485":68143,"_20482":112913,"_5":14053,"_26831":112860,"_2843":48166},[],{"_3355":68166,"_29485":68143,"_20482":112915,"_5":14053,"_26831":112860,"_2843":112916},[],"Ilimitados",{"_3355":68167,"_29485":68143,"_20482":112918,"_5":14053,"_26831":112860,"_2843":112919},[],"Dedicado",{"_3355":68168,"_29485":68143,"_20482":112921,"_5":14053,"_26831":112860,"_2843":112922},[],"99,99 %",{"_3355":68169,"_29485":68143,"_20482":112924,"_5":14053,"_26831":112864,"_2843":112925},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3355":68170,"_29485":68143,"_20482":112927,"_5":14053,"_26831":112864,"_2843":112928},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3355":68171,"_29485":68171,"_5":14411,"_2843":48183,"_29817":112930,"_20482":112932,"_26831":68171},[47939,112697,112931],"Kubernetes autogestionado",[],{"_3355":68172,"_29485":68171,"_20482":112934,"_5":14053,"_26831":68171,"_2843":112935},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3355":68173,"_29485":68171,"_5":29814,"_20482":112937,"_26831":112938,"_2843":112939},[],"/docs/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3355":68174,"_29485":68171,"_5":29814,"_20482":112941,"_26831":112942,"_2843":112943},[],"/docs/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3355":68175,"_29485":68171,"_5":29814,"_20482":112945,"_26831":112946,"_2843":112947},[],"/docs/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3355":68176,"_29485":68171,"_5":29814,"_20482":112949,"_26831":112950,"_2843":112951},[],"/docs/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3355":68177,"_29485":68171,"_5":29814,"_20482":112953,"_26831":112954,"_2843":112955},[],"/docs/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3355":68178,"_29485":68171,"_5":29814,"_20482":112957,"_26831":112958,"_2843":112959},[],"/docs/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3355":68179,"_29485":68171,"_5":29814,"_20482":112961,"_26831":112962,"_2843":112963},[],"/docs/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3355":68180,"_29485":68171,"_5":29814,"_20482":112965,"_26831":112966,"_2843":112967},[],"/docs/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3355":68181,"_29485":68171,"_5":29814,"_20482":112969,"_26831":112970,"_2843":112971},[],"/docs/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3355":68182,"_29485":68171,"_5":29814,"_20482":112973,"_26831":112974,"_2843":112975},[],"/docs/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3355":68183,"_29485":68171,"_5":29814,"_20482":112977,"_26831":112978,"_2843":112979},[],"/docs/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3355":68184,"_29485":68171,"_20482":112981,"_5":14053,"_26831":112938,"_2843":112982},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3355":68185,"_29485":68171,"_20482":112984,"_5":14053,"_26831":112938,"_2843":112985},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3355":68186,"_29485":68171,"_20482":112987,"_5":14053,"_26831":112942,"_2843":112988},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3355":68187,"_29485":68171,"_20482":112990,"_5":14053,"_26831":112942,"_2843":112991},[],"Fastlane instala o configura",{"_3355":68188,"_29485":68171,"_20482":112993,"_5":14053,"_26831":112942,"_2843":112994},[],"Tú sigues proporcionando",{"_3355":68189,"_29485":68171,"_20482":112996,"_5":14053,"_26831":112942,"_2843":112997},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3355":68190,"_29485":68171,"_20482":112999,"_5":14053,"_26831":112942,"_2843":113000},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3355":68191,"_29485":68171,"_20482":113002,"_5":14053,"_26831":112942,"_2843":113003},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3355":68192,"_29485":68171,"_20482":113005,"_5":14053,"_26831":112942,"_2843":113006},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3355":68193,"_29485":68171,"_20482":113008,"_5":14053,"_26831":112942,"_2843":113009},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3355":68194,"_29485":68171,"_20482":113011,"_5":14053,"_26831":112942,"_2843":113012},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3355":68195,"_29485":68171,"_20482":113014,"_5":14053,"_26831":112942,"_2843":113015},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3355":68196,"_29485":68171,"_20482":113017,"_5":14053,"_26831":112942,"_2843":113018},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3355":68197,"_29485":68171,"_20482":113020,"_5":14053,"_26831":112942,"_2843":113021},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3355":68198,"_29485":68171,"_20482":113023,"_5":14053,"_26831":112946,"_2843":113024},[],"Necesitas:",{"_3355":68199,"_29485":68171,"_20482":113026,"_5":14053,"_26831":112946,"_2843":113027},[],"un clúster Kubernetes existente",{"_3355":68200,"_29485":68171,"_20482":113029,"_5":14053,"_26831":112946,"_2843":113030},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3355":68201,"_29485":68171,"_20482":113032,"_5":14053,"_26831":112946,"_2843":48285},[],{"_3355":68202,"_29485":68171,"_20482":113034,"_5":14053,"_26831":112946,"_2843":23156},[],{"_3355":68203,"_29485":68171,"_20482":113036,"_5":14053,"_26831":112946,"_2843":113037},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3355":68204,"_29485":68171,"_20482":113039,"_5":14053,"_26831":112946,"_2843":113040},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3355":68205,"_29485":68171,"_20482":113042,"_5":14053,"_26831":112946,"_2843":113043},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3355":68206,"_29485":68171,"_20482":113045,"_5":14053,"_26831":112946,"_2843":113046},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3355":68207,"_29485":68171,"_20482":113048,"_5":14053,"_26831":112946,"_2843":113049},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3355":68208,"_29485":68171,"_20482":113051,"_5":14053,"_26831":112950,"_2843":113052},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3355":68209,"_29485":68171,"_20482":113054,"_5":14053,"_26831":112950,"_2843":113055},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3355":68210,"_29485":68171,"_20482":113057,"_5":14053,"_26831":112954,"_2843":113058},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3355":68211,"_29485":68171,"_20482":113060,"_5":14053,"_26831":112954,"_2843":113061},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3355":68212,"_29485":68171,"_20482":113063,"_5":14053,"_26831":112954,"_2843":113064},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3355":68213,"_29485":68171,"_20482":113066,"_5":14053,"_26831":112954,"_2843":113067},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3355":68214,"_29485":68171,"_20482":113069,"_5":14053,"_26831":112958,"_2843":113070},[],"Opción",{"_3355":68215,"_29485":68171,"_20482":113072,"_5":14053,"_26831":112958,"_2843":113073},[],"Valor predeterminado",{"_3355":68216,"_29485":68171,"_20482":113075,"_5":14053,"_26831":112958,"_2843":113076},[],"Propósito",{"_3355":68217,"_29485":68171,"_20482":113078,"_5":14053,"_26831":112958,"_2843":48332},[],{"_3355":68218,"_29485":68171,"_20482":113080,"_5":14053,"_26831":112958,"_2843":48335},[],{"_3355":68219,"_29485":68171,"_20482":113082,"_5":14053,"_26831":112958,"_2843":113083},[],"Muestra la ayuda",{"_3355":68220,"_29485":68171,"_20482":113085,"_5":14053,"_26831":112958,"_2843":48341},[],{"_3355":68221,"_29485":68171,"_20482":113087,"_5":14053,"_26831":112958,"_2843":113088},[],"contexto actual",{"_3355":68222,"_29485":68171,"_20482":113090,"_5":14053,"_26831":112958,"_2843":113091},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3355":68223,"_29485":68171,"_20482":113093,"_5":14053,"_26831":112958,"_2843":48350},[],{"_3355":68224,"_29485":68171,"_20482":113095,"_5":14053,"_26831":112958,"_2843":6342},[],{"_3355":68225,"_29485":68171,"_20482":113097,"_5":14053,"_26831":112958,"_2843":113098},[],"Omite prompts y genera credenciales para las dependencias",{"_3355":68226,"_29485":68171,"_20482":113100,"_5":14053,"_26831":112958,"_2843":48358},[],{"_3355":68227,"_29485":68171,"_20482":113102,"_5":14053,"_26831":112958,"_2843":48361},[],{"_3355":68228,"_29485":68171,"_20482":113104,"_5":14053,"_26831":112958,"_2843":113105},[],"Namespace de la instalación",{"_3355":68229,"_29485":68171,"_20482":113107,"_5":14053,"_26831":112958,"_2843":48367},[],{"_3355":68230,"_29485":68171,"_20482":113109,"_5":14053,"_26831":112958,"_2843":48370},[],{"_3355":68231,"_29485":68171,"_20482":113111,"_5":14053,"_26831":112958,"_2843":113112},[],"Dominio usado por la UI, OIDC y el certificado",{"_3355":68232,"_29485":68171,"_20482":113114,"_5":14053,"_26831":112958,"_2843":48376},[],{"_3355":68233,"_29485":68171,"_20482":113116,"_5":14053,"_26831":112958,"_2843":14740},[],{"_3355":68234,"_29485":68171,"_20482":113118,"_5":14053,"_26831":112958,"_2843":113119},[],"Versión del chart de Lamassu",{"_3355":68235,"_29485":68171,"_20482":113121,"_5":14053,"_26831":112958,"_2843":48384},[],{"_3355":68236,"_29485":68171,"_20482":113123,"_5":14053,"_26831":112958,"_2843":48387},[],{"_3355":68237,"_29485":68171,"_20482":113125,"_5":14053,"_26831":112958,"_2843":113126},[],"Puerto del listener HTTPS",{"_3355":68238,"_29485":68171,"_20482":113128,"_5":14053,"_26831":112958,"_2843":48393},[],{"_3355":68239,"_29485":68171,"_20482":113130,"_5":14053,"_26831":112958,"_2843":48396},[],{"_3355":68240,"_29485":68171,"_20482":113132,"_5":14053,"_26831":112958,"_2843":113133},[],"Puerto del listener HTTP",{"_3355":68241,"_29485":68171,"_20482":113135,"_5":14053,"_26831":112958,"_2843":48402},[],{"_3355":68242,"_29485":68171,"_20482":113137,"_5":14053,"_26831":112958,"_2843":48335},[],{"_3355":68243,"_29485":68171,"_20482":113139,"_5":14053,"_26831":112958,"_2843":113140},[],"Certificado PEM para TLS downstream",{"_3355":68244,"_29485":68171,"_20482":113142,"_5":14053,"_26831":112958,"_2843":48410},[],{"_3355":68245,"_29485":68171,"_20482":113144,"_5":14053,"_26831":112958,"_2843":48335},[],{"_3355":68246,"_29485":68171,"_20482":113146,"_5":14053,"_26831":112958,"_2843":113147},[],"Clave privada PEM para TLS downstream",{"_3355":68247,"_29485":68171,"_20482":113149,"_5":14053,"_26831":112958,"_2843":48418},[],{"_3355":68248,"_29485":68171,"_20482":113151,"_5":14053,"_26831":112958,"_2843":113152},[],"chart del repositorio",{"_3355":68249,"_29485":68171,"_20482":113154,"_5":14053,"_26831":112958,"_2843":113155},[],"Usa un chart local de Lamassu sin empaquetar",{"_3355":68250,"_29485":68171,"_20482":113157,"_5":14053,"_26831":112958,"_2843":48427},[],{"_3355":68251,"_29485":68171,"_20482":113159,"_5":14053,"_26831":112958,"_2843":113160},[],"detección automática",{"_3355":68252,"_29485":68171,"_20482":113162,"_5":14053,"_26831":112958,"_2843":113163},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3355":68253,"_29485":68171,"_20482":113165,"_5":14053,"_26831":112958,"_2843":48435},[],{"_3355":68254,"_29485":68171,"_20482":113167,"_5":14053,"_26831":112958,"_2843":6342},[],{"_3355":68255,"_29485":68171,"_20482":113169,"_5":14053,"_26831":112958,"_2843":113170},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3355":68256,"_29485":68171,"_20482":113172,"_5":14053,"_26831":112958,"_2843":48443},[],{"_3355":68257,"_29485":68171,"_20482":113174,"_5":14053,"_26831":112958,"_2843":6342},[],{"_3355":68258,"_29485":68171,"_20482":113176,"_5":14053,"_26831":112958,"_2843":113177},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3355":68259,"_29485":68171,"_20482":113179,"_5":14053,"_26831":112958,"_2843":48451},[],{"_3355":68260,"_29485":68171,"_20482":113181,"_5":14053,"_26831":112958,"_2843":6342},[],{"_3355":68261,"_29485":68171,"_20482":113183,"_5":14053,"_26831":112958,"_2843":113184},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3355":68262,"_29485":68171,"_20482":113186,"_5":14053,"_26831":112958,"_2843":48459},[],{"_3355":68263,"_29485":68171,"_20482":113188,"_5":14053,"_26831":112958,"_2843":6342},[],{"_3355":68264,"_29485":68171,"_20482":113190,"_5":14053,"_26831":112958,"_2843":113191},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3355":68265,"_29485":68171,"_20482":113193,"_5":14053,"_26831":112958,"_2843":48467},[],{"_3355":68266,"_29485":68171,"_20482":113195,"_5":14053,"_26831":112958,"_2843":48470},[],{"_3355":68267,"_29485":68171,"_20482":113197,"_5":14053,"_26831":112958,"_2843":113198},[],"Usa otro chart local de SoftHSM",{"_3355":68268,"_29485":68171,"_20482":113200,"_5":14053,"_26831":112958,"_2843":113201},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3355":68269,"_29485":68171,"_20482":113203,"_5":14053,"_26831":112962,"_2843":113204},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3355":68270,"_29485":68171,"_20482":113206,"_5":14053,"_26831":112962,"_2843":113207},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3355":68271,"_29485":68171,"_20482":113209,"_5":14053,"_26831":112962,"_2843":113210},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3355":68272,"_29485":68171,"_20482":113212,"_5":14053,"_26831":112962,"_2843":113213},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3355":68273,"_29485":68171,"_20482":113215,"_5":14053,"_26831":112962,"_2843":113216},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3355":68274,"_29485":68171,"_20482":113218,"_5":14053,"_26831":112962,"_2843":113219},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3355":68275,"_29485":68171,"_20482":113221,"_5":14053,"_26831":112966,"_2843":48497},[],{"_3355":68276,"_29485":68171,"_20482":113223,"_5":14053,"_26831":112966,"_2843":113224},[],"valida las herramientas locales y el clúster seleccionado",{"_3355":68277,"_29485":68171,"_20482":113226,"_5":14053,"_26831":112966,"_2843":113227},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3355":68278,"_29485":68171,"_20482":113229,"_5":14053,"_26831":112966,"_2843":113230},[],"crea el namespace",{"_3355":68279,"_29485":68171,"_20482":113232,"_5":14053,"_26831":112966,"_2843":113233},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3355":68280,"_29485":68171,"_20482":113235,"_5":14053,"_26831":112966,"_2843":113236},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3355":68281,"_29485":68171,"_20482":113238,"_5":14053,"_26831":112966,"_2843":113239},[],"instala RabbitMQ",{"_3355":68282,"_29485":68171,"_20482":113241,"_5":14053,"_26831":112966,"_2843":113242},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3355":68283,"_29485":68171,"_20482":113244,"_5":14053,"_26831":112966,"_2843":113245},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3355":68284,"_29485":68171,"_20482":113247,"_5":14053,"_26831":112966,"_2843":113248},[],"carga datos de ejemplo opcionalmente",{"_3355":68285,"_29485":68171,"_20482":113250,"_5":14053,"_26831":112966,"_2843":113251},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3355":68286,"_29485":68171,"_20482":113253,"_5":14053,"_26831":112970,"_2843":113254},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3355":68287,"_29485":68171,"_20482":113256,"_5":14053,"_26831":112970,"_2843":113257},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3355":68288,"_29485":68171,"_20482":113259,"_5":14053,"_26831":112974,"_2843":113260},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3355":68289,"_29485":68171,"_20482":113262,"_5":14053,"_26831":112974,"_2843":113263},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3355":68290,"_29485":68171,"_20482":113265,"_5":14053,"_26831":112974,"_2843":113266},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3355":68291,"_29485":68171,"_20482":113268,"_5":14053,"_26831":112978,"_2843":113269},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3355":68292,"_29485":68292,"_5":14411,"_2843":113271,"_29817":113272,"_20482":113273,"_26831":68292},"Instala con Helm",[47939,112697,112931],[],{"_3355":68293,"_29485":68292,"_20482":113275,"_5":14053,"_26831":68292,"_2843":113276},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3355":68294,"_29485":68292,"_5":29814,"_20482":113278,"_26831":113279,"_2843":113280},[],"/docs/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3355":68295,"_29485":68292,"_5":29814,"_20482":113282,"_26831":113283,"_2843":112947},[],"/docs/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3355":68296,"_29485":68292,"_5":29814,"_20482":113285,"_26831":113286,"_2843":113287},[],"/docs/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3355":68297,"_29485":68292,"_5":29814,"_20482":113289,"_26831":113290,"_2843":113291},[],"/docs/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3355":68298,"_29485":68292,"_5":29814,"_20482":113293,"_26831":113294,"_2843":113295},[],"/docs/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3355":68299,"_29485":68292,"_5":29814,"_20482":113297,"_26831":113298,"_2843":113299},[],"/docs/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3355":68300,"_29485":68292,"_5":29814,"_20482":113301,"_26831":113302,"_2843":113303},[],"/docs/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3355":68301,"_29485":68292,"_5":29814,"_20482":113305,"_26831":113306,"_2843":113307},[],"/docs/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3355":68302,"_29485":68292,"_5":29814,"_20482":113309,"_26831":113310,"_2843":113311},[],"/docs/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3355":68303,"_29485":68292,"_5":29814,"_20482":113313,"_26831":113314,"_2843":113315},[],"/docs/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3355":68304,"_29485":68292,"_5":29814,"_20482":113317,"_26831":113318,"_2843":113319},[],"/docs/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3355":68305,"_29485":68292,"_20482":113321,"_5":14053,"_26831":113279,"_2843":113322},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3355":68306,"_29485":68292,"_20482":113324,"_5":14053,"_26831":113283,"_2843":113325},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3355":68307,"_29485":68292,"_20482":113327,"_5":14053,"_26831":113283,"_2843":113328},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3355":68308,"_29485":68292,"_20482":113330,"_5":14053,"_26831":113283,"_2843":113331},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3355":68309,"_29485":68292,"_20482":113333,"_5":14053,"_26831":113283,"_2843":113334},[],"un broker RabbitMQ accesible y sus credenciales",{"_3355":68310,"_29485":68292,"_20482":113336,"_5":14053,"_26831":113283,"_2843":113337},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3355":68311,"_29485":68292,"_20482":113339,"_5":14053,"_26831":113283,"_2843":113340},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3355":68312,"_29485":68292,"_20482":113342,"_5":14053,"_26831":113283,"_2843":113343},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3355":68313,"_29485":68292,"_20482":113345,"_5":14053,"_26831":113283,"_2843":113346},[],"una StorageClass y un diseño de tráfico externo",{"_3355":68314,"_29485":68292,"_20482":113348,"_5":14053,"_26831":113283,"_2843":113349},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3355":68315,"_29485":68292,"_20482":113351,"_5":14053,"_26831":113283,"_2843":113352},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3355":68316,"_29485":68292,"_20482":113354,"_5":14053,"_26831":113283,"_2843":113355},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3355":68317,"_29485":68292,"_20482":113357,"_5":14053,"_26831":113286,"_2843":113358},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3355":68318,"_29485":68292,"_20482":113360,"_5":14053,"_26831":113286,"_2843":113361},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3355":68319,"_29485":68292,"_20482":113363,"_5":14053,"_26831":113286,"_2843":113364},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3355":68320,"_29485":68292,"_20482":113366,"_5":14053,"_26831":113290,"_2843":113367},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3355":68321,"_29485":68292,"_20482":113369,"_5":14053,"_26831":113290,"_2843":113370},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3355":68322,"_29485":68292,"_20482":113372,"_5":14053,"_26831":113290,"_2843":113373},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3355":68323,"_29485":68292,"_20482":113375,"_5":14053,"_26831":113290,"_2843":113376},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3355":68324,"_29485":68292,"_20482":113378,"_5":14053,"_26831":113294,"_2843":113379},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3355":68325,"_29485":68292,"_20482":113381,"_5":14053,"_26831":113298,"_2843":113382},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3355":68326,"_29485":68292,"_20482":113384,"_5":14053,"_26831":113298,"_2843":113385},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3355":68327,"_29485":68292,"_20482":113387,"_5":14053,"_26831":113298,"_2843":113388},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3355":68328,"_29485":68292,"_20482":113390,"_5":14053,"_26831":113298,"_2843":113391},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3355":68329,"_29485":68292,"_20482":113393,"_5":14053,"_26831":113298,"_2843":113394},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3355":68330,"_29485":68292,"_20482":113396,"_5":14053,"_26831":113298,"_2843":113397},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3355":68331,"_29485":68292,"_20482":113399,"_5":14053,"_26831":113298,"_2843":113400},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3355":68332,"_29485":68292,"_20482":113402,"_5":14053,"_26831":113302,"_2843":113403},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3355":68333,"_29485":68292,"_20482":113405,"_5":14053,"_26831":113302,"_2843":113406},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3355":68334,"_29485":68292,"_20482":113408,"_5":14053,"_26831":113302,"_2843":113409},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3355":68335,"_29485":68292,"_20482":113411,"_5":14053,"_26831":113302,"_2843":113412},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3355":68336,"_29485":68292,"_20482":113414,"_5":14053,"_26831":113306,"_2843":113415},[],"Para instalar un checkout local:",{"_3355":68337,"_29485":68292,"_20482":113417,"_5":14053,"_26831":113310,"_2843":113418},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3355":68338,"_29485":68292,"_20482":113420,"_5":14053,"_26831":113310,"_2843":113421},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3355":68339,"_29485":68292,"_20482":113423,"_5":14053,"_26831":113314,"_2843":113424},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3355":68340,"_29485":68292,"_20482":113426,"_5":14053,"_26831":113314,"_2843":113427},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3355":68341,"_29485":68292,"_20482":113429,"_5":14053,"_26831":113314,"_2843":113430},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3355":68342,"_29485":68292,"_20482":113432,"_5":14053,"_26831":113314,"_2843":113433},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3355":68343,"_29485":68292,"_20482":113435,"_5":14053,"_26831":113314,"_2843":113436},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3355":68344,"_29485":68292,"_20482":113438,"_5":14053,"_26831":113318,"_2843":113439},[],"Antes de pasar a producción, revisa:",{"_3355":68345,"_29485":68292,"_20482":113441,"_5":14053,"_26831":113318,"_2843":113442},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3355":68346,"_29485":68292,"_20482":113444,"_5":14053,"_26831":113318,"_2843":113445},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3355":68347,"_29485":68292,"_20482":113447,"_5":14053,"_26831":113318,"_2843":113448},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3355":68348,"_29485":68292,"_20482":113450,"_5":14053,"_26831":113318,"_2843":113451},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3355":68349,"_29485":68292,"_20482":113453,"_5":14053,"_26831":113318,"_2843":113454},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3355":68350,"_29485":68292,"_20482":113456,"_5":14053,"_26831":113318,"_2843":113457},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3355":68351,"_29485":68292,"_20482":113459,"_5":14053,"_26831":113318,"_2843":113460},[],"SMTP, observabilidad y entrega de alertas",{"_3355":68352,"_29485":68292,"_20482":113462,"_5":14053,"_26831":113318,"_2843":113463},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3355":68353,"_29485":68292,"_20482":113465,"_5":14053,"_26831":113318,"_2843":113466},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3355":68354,"_29485":68354,"_5":14411,"_2843":113468,"_29817":113469,"_20482":113470,"_26831":68354},"Expón el Gateway",[47939,112697,112931],[],{"_3355":68355,"_29485":68354,"_20482":113472,"_5":14053,"_26831":68354,"_2843":113473},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3355":68356,"_29485":68354,"_5":29814,"_20482":113475,"_26831":113476,"_2843":113477},[],"/docs/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3355":68357,"_29485":68354,"_5":29814,"_20482":113479,"_26831":113480,"_2843":113481},[],"/docs/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3355":68358,"_29485":68354,"_5":29814,"_20482":113483,"_26831":113484,"_2843":113485},[],"/docs/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3355":68359,"_29485":68354,"_5":29814,"_20482":113487,"_26831":113488,"_2843":48765},[],"/docs/es/deployment/self-hosted/networking#k3s",{"_3355":68360,"_29485":68354,"_5":29814,"_20482":113490,"_26831":113491,"_2843":113492},[],"/docs/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3355":68361,"_29485":68354,"_5":29814,"_20482":113494,"_26831":113495,"_2843":113496},[],"/docs/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3355":68362,"_29485":68354,"_5":29814,"_20482":113498,"_26831":113499,"_2843":113500},[],"/docs/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3355":68363,"_29485":68354,"_5":29814,"_20482":113502,"_26831":113503,"_2843":113504},[],"/docs/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3355":68364,"_29485":68354,"_5":29814,"_20482":113506,"_26831":113507,"_2843":113508},[],"/docs/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3355":68365,"_29485":68354,"_5":29814,"_20482":113510,"_26831":113511,"_2843":113512},[],"/docs/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3355":68366,"_29485":68354,"_20482":113514,"_5":14053,"_26831":113476,"_2843":113515},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3355":68367,"_29485":68354,"_20482":113517,"_5":14053,"_26831":113476,"_2843":113518},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3355":68368,"_29485":68354,"_20482":113520,"_5":14053,"_26831":113480,"_2843":113521},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3355":68369,"_29485":68354,"_20482":113523,"_5":14053,"_26831":113480,"_2843":113524},[],"Defínelo únicamente cuando:",{"_3355":68370,"_29485":68354,"_20482":113526,"_5":14053,"_26831":113480,"_2843":113527},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3355":68371,"_29485":68354,"_20482":113529,"_5":14053,"_26831":113480,"_2843":113530},[],"esa dirección está asignada a este Gateway",{"_3355":68372,"_29485":68354,"_20482":113532,"_5":14053,"_26831":113480,"_2843":113533},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3355":68373,"_29485":68354,"_20482":113535,"_5":14053,"_26831":113480,"_2843":113536},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3355":68374,"_29485":68354,"_20482":113538,"_5":14053,"_26831":113480,"_2843":113539},[],"No confundas estos valores:",{"_3355":68375,"_29485":68354,"_20482":113541,"_5":14053,"_26831":113480,"_2843":113542},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3355":68376,"_29485":68354,"_20482":113544,"_5":14053,"_26831":113480,"_2843":113545},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3355":68377,"_29485":68354,"_20482":113547,"_5":14053,"_26831":113480,"_2843":113548},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3355":68378,"_29485":68354,"_20482":113550,"_5":14053,"_26831":113484,"_2843":113551},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3355":68379,"_29485":68354,"_20482":113553,"_5":14053,"_26831":113484,"_2843":113554},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3355":68380,"_29485":68354,"_20482":113556,"_5":14053,"_26831":113488,"_2843":113557},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3355":68381,"_29485":68354,"_20482":113559,"_5":14053,"_26831":113488,"_2843":113560},[],"Para el diseño recomendado:",{"_3355":68382,"_29485":68354,"_20482":113562,"_5":14053,"_26831":113488,"_2843":113563},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3355":68383,"_29485":68354,"_20482":113565,"_5":14053,"_26831":113488,"_2843":113566},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3355":68384,"_29485":68354,"_20482":113568,"_5":14053,"_26831":113488,"_2843":113569},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3355":68385,"_29485":68354,"_20482":113571,"_5":14053,"_26831":113488,"_2843":113572},[],"Apunta DNS a la dirección accesible de la VM.",{"_3355":68386,"_29485":68354,"_20482":113574,"_5":14053,"_26831":113488,"_2843":113575},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3355":68387,"_29485":68354,"_20482":113577,"_5":14053,"_26831":113491,"_2843":113578},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3355":68388,"_29485":68354,"_20482":113580,"_5":14053,"_26831":113495,"_2843":113581},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3355":68389,"_29485":68354,"_20482":113583,"_5":14053,"_26831":113495,"_2843":113584},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3355":68390,"_29485":68354,"_20482":113586,"_5":14053,"_26831":113499,"_2843":113587},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3355":68391,"_29485":68354,"_20482":113589,"_5":14053,"_26831":113499,"_2843":113590},[],"Requisito",{"_3355":68392,"_29485":68354,"_20482":113592,"_5":14053,"_26831":113499,"_2843":113593},[],"Diseño recomendado",{"_3355":68393,"_29485":68354,"_20482":113595,"_5":14053,"_26831":113499,"_2843":113596},[],"Consecuencia",{"_3355":68394,"_29485":68354,"_20482":113598,"_5":14053,"_26831":113499,"_2843":113599},[],"Varias URL o servicios de Lamassu",{"_3355":68395,"_29485":68354,"_20482":113601,"_5":14053,"_26831":113499,"_2843":113602},[],"Un Gateway con varias rutas",{"_3355":68396,"_29485":68354,"_20482":113604,"_5":14053,"_26831":113499,"_2843":113605},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3355":68397,"_29485":68354,"_20482":113607,"_5":14053,"_26831":113499,"_2843":113608},[],"Gateways independientes e IP externas distintas",{"_3355":68398,"_29485":68354,"_20482":113610,"_5":14053,"_26831":113499,"_2843":113611},[],"Una VIP por Gateway",{"_3355":68399,"_29485":68354,"_20482":113613,"_5":14053,"_26831":113499,"_2843":113614},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3355":68400,"_29485":68354,"_20482":113616,"_5":14053,"_26831":113499,"_2843":113617},[],"Gateways independientes, un nodo y una IP",{"_3355":68401,"_29485":68354,"_20482":113619,"_5":14053,"_26831":113499,"_2843":113620},[],"Puertos externos diferentes",{"_3355":68402,"_29485":68354,"_20482":113622,"_5":14053,"_26831":113499,"_2843":113623},[],"Los clientes deben indicar puertos no estándar",{"_3355":68403,"_29485":68354,"_20482":113625,"_5":14053,"_26831":113499,"_2843":113626},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3355":68404,"_29485":68354,"_20482":113628,"_5":14053,"_26831":113499,"_2843":113629},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3355":68405,"_29485":68354,"_20482":113631,"_5":14053,"_26831":113499,"_2843":113632},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3355":68406,"_29485":68354,"_20482":113634,"_5":14053,"_26831":113499,"_2843":113635},[],"Recursos Gateway separados pero proxy compartido",{"_3355":68407,"_29485":68354,"_20482":113637,"_5":14053,"_26831":113499,"_2843":113638},[],"Modo merged Gateway de Envoy",{"_3355":68408,"_29485":68354,"_20482":113640,"_5":14053,"_26831":113499,"_2843":113641},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3355":68409,"_29485":68354,"_20482":113643,"_5":14053,"_26831":113499,"_2843":113644},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3355":68410,"_29485":68354,"_20482":113646,"_5":14053,"_26831":113499,"_2843":113647},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3355":68411,"_29485":68354,"_20482":113649,"_5":14053,"_26831":113499,"_2843":113650},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3355":68412,"_29485":68354,"_20482":113652,"_5":14053,"_26831":113499,"_2843":113653},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3355":68413,"_29485":68354,"_20482":113655,"_5":14053,"_26831":113503,"_2843":113656},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3355":68414,"_29485":68354,"_20482":113658,"_5":14053,"_26831":113503,"_2843":113659},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3355":68415,"_29485":68354,"_20482":113661,"_5":14053,"_26831":113503,"_2843":113662},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3355":68416,"_29485":68354,"_20482":113664,"_5":14053,"_26831":113503,"_2843":113665},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3355":68417,"_29485":68354,"_20482":113667,"_5":14053,"_26831":113503,"_2843":113668},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3355":68418,"_29485":68354,"_20482":113670,"_5":14053,"_26831":113507,"_2843":113671},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3355":68419,"_29485":68354,"_20482":113673,"_5":14053,"_26831":113507,"_2843":113674},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3355":68420,"_29485":68354,"_20482":113676,"_5":14053,"_26831":113511,"_2843":113677},[],"Comprueba, en orden:",{"_3355":68421,"_29485":68354,"_20482":113679,"_5":14053,"_26831":113511,"_2843":113680},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3355":68422,"_29485":68354,"_20482":113682,"_5":14053,"_26831":113511,"_2843":113683},[],"Su estado contiene la dirección esperada.",{"_3355":68423,"_29485":68354,"_20482":113685,"_5":14053,"_26831":113511,"_2843":113686},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3355":68424,"_29485":68354,"_20482":113688,"_5":14053,"_26831":113511,"_2843":113689},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3355":68425,"_29485":68354,"_20482":113691,"_5":14053,"_26831":113511,"_2843":113692},[],"DNS resuelve al endpoint accesible externamente.",{"_3355":68426,"_29485":68354,"_20482":113694,"_5":14053,"_26831":113511,"_2843":113695},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3355":68427,"_29485":68354,"_20482":113697,"_5":14053,"_26831":113511,"_2843":113698},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3355":68428,"_29485":68428,"_5":14411,"_2843":48046,"_29817":113700,"_20482":113701,"_26831":68428},[47939,112697,112931],[],{"_3355":68429,"_29485":68428,"_20482":113703,"_5":14053,"_26831":68428,"_2843":113704},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3355":68430,"_29485":68428,"_5":29814,"_20482":113706,"_26831":113707,"_2843":113708},[],"/docs/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3355":68431,"_29485":68428,"_5":29814,"_20482":113710,"_26831":113711,"_2843":113712},[],"/docs/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3355":68432,"_29485":68428,"_5":29814,"_20482":113714,"_26831":113715,"_2843":113716},[],"/docs/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3355":68433,"_29485":68428,"_5":29814,"_20482":113718,"_26831":113719,"_2843":113720},[],"/docs/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3355":68434,"_29485":68428,"_5":29814,"_20482":113722,"_26831":113723,"_2843":113724},[],"/docs/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3355":68435,"_29485":68428,"_5":29814,"_20482":113726,"_26831":113727,"_2843":113728},[],"/docs/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3355":68436,"_29485":68428,"_20482":113730,"_5":14053,"_26831":113707,"_2843":113731},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3355":68437,"_29485":68428,"_20482":113733,"_5":14053,"_26831":113711,"_2843":113734},[],"Flujo",{"_3355":68438,"_29485":68428,"_20482":113736,"_5":14053,"_26831":113711,"_2843":113737},[],"Úsalo para",{"_3355":68439,"_29485":68428,"_20482":113739,"_5":14053,"_26831":113711,"_2843":113740},[],"Qué instala",{"_3355":68440,"_29485":68428,"_20482":113742,"_5":14053,"_26831":113711,"_2843":49020},[],{"_3355":68441,"_29485":68428,"_20482":113744,"_5":14053,"_26831":113711,"_2843":113745},[],"Producción y entornos controlados",{"_3355":68442,"_29485":68428,"_20482":113747,"_5":14053,"_26831":113711,"_2843":113748},[],"Servicios de Lamassu y recursos de Gateway API",{"_3355":68443,"_29485":68428,"_20482":113750,"_5":14053,"_26831":113711,"_2843":48183},[],{"_3355":68444,"_29485":68428,"_20482":113752,"_5":14053,"_26831":113711,"_2843":113753},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3355":68445,"_29485":68428,"_20482":113755,"_5":14053,"_26831":113711,"_2843":113756},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3355":68446,"_29485":68428,"_20482":113758,"_5":14053,"_26831":113715,"_2843":113759},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3355":68447,"_29485":68428,"_20482":113761,"_5":14053,"_26831":113715,"_2843":113762},[],"Área",{"_3355":68448,"_29485":68428,"_20482":113764,"_5":14053,"_26831":113715,"_2843":113765},[],"El chart de Lamassu proporciona",{"_3355":68449,"_29485":68428,"_20482":113767,"_5":14053,"_26831":113715,"_2843":113768},[],"Tú proporcionas",{"_3355":68450,"_29485":68428,"_20482":113770,"_5":14053,"_26831":113715,"_2843":113771},[],"Aplicaciones Lamassu",{"_3355":68451,"_29485":68428,"_20482":113773,"_5":14053,"_26831":113715,"_2843":113774},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3355":68452,"_29485":68428,"_20482":113776,"_5":14053,"_26831":113715,"_2843":113777},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3355":68453,"_29485":68428,"_20482":113779,"_5":14053,"_26831":113715,"_2843":113780},[],"Datos PostgreSQL",{"_3355":68454,"_29485":68428,"_20482":113782,"_5":14053,"_26831":113715,"_2843":113783},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3355":68455,"_29485":68428,"_20482":113785,"_5":14053,"_26831":113715,"_2843":113786},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3355":68456,"_29485":68428,"_20482":113788,"_5":14053,"_26831":113715,"_2843":113789},[],"Mensajería",{"_3355":68457,"_29485":68428,"_20482":113791,"_5":14053,"_26831":113715,"_2843":113792},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3355":68458,"_29485":68428,"_20482":113794,"_5":14053,"_26831":113715,"_2843":113795},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3355":68459,"_29485":68428,"_20482":113797,"_5":14053,"_26831":113715,"_2843":113798},[],"Identidad",{"_3355":68460,"_29485":68428,"_20482":113800,"_5":14053,"_26831":113715,"_2843":113801},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3355":68461,"_29485":68428,"_20482":113803,"_5":14053,"_26831":113715,"_2843":113804},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3355":68462,"_29485":68428,"_20482":113806,"_5":14053,"_26831":113715,"_2843":113807},[],"Enrutamiento externo",{"_3355":68463,"_29485":68428,"_20482":113809,"_5":14053,"_26831":113715,"_2843":113810},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3355":68464,"_29485":68428,"_20482":113812,"_5":14053,"_26831":113715,"_2843":113813},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3355":68465,"_29485":68428,"_20482":113815,"_5":14053,"_26831":113715,"_2843":49094},[],{"_3355":68466,"_29485":68428,"_20482":113817,"_5":14053,"_26831":113715,"_2843":113818},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3355":68467,"_29485":68428,"_20482":113820,"_5":14053,"_26831":113715,"_2843":113821},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3355":68468,"_29485":68428,"_20482":113823,"_5":14053,"_26831":113715,"_2843":113824},[],"Datos persistentes de la aplicación",{"_3355":68469,"_29485":68428,"_20482":113826,"_5":14053,"_26831":113715,"_2843":113827},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3355":68470,"_29485":68428,"_20482":113829,"_5":14053,"_26831":113715,"_2843":113830},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3355":68471,"_29485":68428,"_20482":113832,"_5":14053,"_26831":113715,"_2843":113833},[],"Integraciones opcionales",{"_3355":68472,"_29485":68428,"_20482":113835,"_5":14053,"_26831":113715,"_2843":113836},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3355":68473,"_29485":68428,"_20482":113838,"_5":14053,"_26831":113715,"_2843":113839},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3355":68474,"_29485":68428,"_20482":113841,"_5":14053,"_26831":113715,"_2843":113842},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3355":68475,"_29485":68428,"_20482":113844,"_5":14053,"_26831":113715,"_2843":113845},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3355":68476,"_29485":68428,"_20482":113847,"_5":14053,"_26831":113719,"_2843":113848},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3355":68477,"_29485":68428,"_20482":113850,"_5":14053,"_26831":113719,"_2843":113851},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3355":68478,"_29485":68428,"_20482":113853,"_5":14053,"_26831":113723,"_2843":113854},[],"Kubernetes 1.24 o posterior",{"_3355":68479,"_29485":68428,"_20482":113856,"_5":14053,"_26831":113723,"_2843":113857},[],"Helm 3.2 o posterior",{"_3355":68480,"_29485":68428,"_20482":113859,"_5":14053,"_26831":113723,"_2843":113860},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3355":68481,"_29485":68428,"_20482":113862,"_5":14053,"_26831":113723,"_2843":113863},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3355":68482,"_29485":68428,"_20482":113865,"_5":14053,"_26831":113723,"_2843":113866},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3355":68483,"_29485":68428,"_20482":113868,"_5":14053,"_26831":113723,"_2843":113869},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3355":68484,"_29485":68428,"_20482":113871,"_5":14053,"_26831":113723,"_2843":113872},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3355":68485,"_29485":68428,"_20482":113874,"_5":14053,"_26831":113727,"_2843":113875},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3355":68486,"_29485":68428,"_20482":113877,"_5":14053,"_26831":113727,"_2843":113878},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3355":68487,"_29485":68428,"_20482":113880,"_5":14053,"_26831":113727,"_2843":113881},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3355":68488,"_29485":68428,"_20482":113883,"_5":14053,"_26831":113727,"_2843":113884},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3355":68489,"_29485":68489,"_5":14411,"_2843":113886,"_29817":113887,"_20482":113889,"_26831":68489},"Resolución de problemas de despliegue",[47939,112697,113888],"Operación",[],{"_3355":68490,"_29485":68489,"_20482":113891,"_5":14053,"_26831":68489,"_2843":113892},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3355":68491,"_29485":68489,"_5":29814,"_20482":113894,"_26831":113895,"_2843":113896},[],"/docs/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3355":68492,"_29485":68489,"_5":29814,"_20482":113898,"_26831":113899,"_2843":113900},[],"/docs/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3355":68493,"_29485":68489,"_5":29814,"_20482":113902,"_26831":113903,"_2843":113904},[],"/docs/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3355":68494,"_29485":68489,"_5":29814,"_20482":113906,"_26831":113907,"_2843":113908},[],"/docs/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3355":68495,"_29485":68489,"_5":29814,"_20482":113910,"_26831":113911,"_2843":113912},[],"/docs/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3355":68496,"_29485":68489,"_5":29814,"_20482":113914,"_26831":113915,"_2843":113916},[],"/docs/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3355":68497,"_29485":68489,"_5":29814,"_20482":113918,"_26831":113919,"_2843":113920},[],"/docs/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3355":68498,"_29485":68489,"_5":29814,"_20482":113922,"_26831":113923,"_2843":113924},[],"/docs/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3355":68499,"_29485":68489,"_5":29814,"_20482":113926,"_26831":113927,"_2843":113928},[],"/docs/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3355":68500,"_29485":68489,"_5":29814,"_20482":113930,"_26831":113931,"_2843":113932},[],"/docs/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3355":68501,"_29485":68489,"_5":29814,"_20482":113934,"_26831":113935,"_2843":113936},[],"/docs/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3355":68502,"_29485":68489,"_5":29814,"_20482":113938,"_26831":113939,"_2843":113940},[],"/docs/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3355":68503,"_29485":68489,"_5":29814,"_20482":113942,"_26831":113943,"_2843":113944},[],"/docs/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3355":68504,"_29485":68489,"_20482":113946,"_5":14053,"_26831":68489,"_2843":113947},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3355":68505,"_29485":68489,"_20482":113949,"_5":14053,"_26831":113899,"_2843":113950},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3355":68506,"_29485":68489,"_20482":113952,"_5":14053,"_26831":113903,"_2843":113953},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3355":68507,"_29485":68489,"_20482":113955,"_5":14053,"_26831":113907,"_2843":113956},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3355":68508,"_29485":68489,"_20482":113958,"_5":14053,"_26831":113911,"_2843":113959},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3355":68509,"_29485":68489,"_20482":113961,"_5":14053,"_26831":113915,"_2843":113962},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3355":68510,"_29485":68489,"_20482":113964,"_5":14053,"_26831":113919,"_2843":113965},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3355":68511,"_29485":68489,"_20482":113967,"_5":14053,"_26831":113919,"_2843":113968},[],"Ejecuta también la prueba de conectividad del chart:",{"_3355":68512,"_29485":68489,"_20482":113970,"_5":14053,"_26831":113919,"_2843":113971},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3355":68513,"_29485":68489,"_20482":113973,"_5":14053,"_26831":113919,"_2843":113974},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3355":68514,"_29485":68489,"_20482":113976,"_5":14053,"_26831":113923,"_2843":113977},[],"Si recibes un 401:",{"_3355":68515,"_29485":68489,"_20482":113979,"_5":14053,"_26831":113923,"_2843":113980},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3355":68516,"_29485":68489,"_20482":113982,"_5":14053,"_26831":113923,"_2843":113983},[],"verifica emisor, audiencia y expiración del token;",{"_3355":68517,"_29485":68489,"_20482":113985,"_5":14053,"_26831":113923,"_2843":113986},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3355":68518,"_29485":68489,"_20482":113988,"_5":14053,"_26831":113923,"_2843":113989},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3355":68519,"_29485":68489,"_20482":113991,"_5":14053,"_26831":113923,"_2843":113992},[],"Si el login termina pero las APIs devuelven 403:",{"_3355":68520,"_29485":68489,"_20482":113994,"_5":14053,"_26831":113923,"_2843":113995},[],"inspecciona los claims reales del token;",{"_3355":68521,"_29485":68489,"_20482":113997,"_5":14053,"_26831":113923,"_2843":113998},[],"confirma que coinciden con un principal activo;",{"_3355":68522,"_29485":68489,"_20482":114000,"_5":14053,"_26831":113923,"_2843":114001},[],"revisa las políticas concedidas al principal;",{"_3355":68523,"_29485":68489,"_20482":114003,"_5":14053,"_26831":113923,"_2843":114004},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3355":68524,"_29485":68489,"_20482":114006,"_5":14053,"_26831":113923,"_2843":114007},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3355":68525,"_29485":68489,"_20482":114009,"_5":14053,"_26831":113927,"_2843":114010},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3355":68526,"_29485":68489,"_20482":114012,"_5":14053,"_26831":113927,"_2843":114013},[],"Localiza el pod y Service de authz.",{"_3355":68527,"_29485":68489,"_20482":114015,"_5":14053,"_26831":113927,"_2843":114016},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3355":68528,"_29485":68489,"_20482":114018,"_5":14053,"_26831":113927,"_2843":114019},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3355":68529,"_29485":68489,"_20482":114021,"_5":14053,"_26831":113927,"_2843":114022},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3355":68530,"_29485":68489,"_20482":114024,"_5":14053,"_26831":113927,"_2843":114025},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3355":68531,"_29485":68489,"_20482":114027,"_5":14053,"_26831":113931,"_2843":114028},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3355":68532,"_29485":68489,"_20482":114030,"_5":14053,"_26831":113935,"_2843":114031},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3355":68533,"_29485":68489,"_20482":114033,"_5":14053,"_26831":113935,"_2843":114034},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3355":68534,"_29485":68489,"_20482":114036,"_5":14053,"_26831":113935,"_2843":114037},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3355":68535,"_29485":68489,"_20482":114039,"_5":14053,"_26831":113935,"_2843":114040},[],"volumen persistente sin enlazar;",{"_3355":68536,"_29485":68489,"_20482":114042,"_5":14053,"_26831":113935,"_2843":114043},[],"imagen inaccesible o política de pull incorrecta;",{"_3355":68537,"_29485":68489,"_20482":114045,"_5":14053,"_26831":113935,"_2843":114046},[],"configuración inválida del motor criptográfico;",{"_3355":68538,"_29485":68489,"_20482":114048,"_5":14053,"_26831":113935,"_2843":114049},[],"límites de CPU o memoria demasiado bajos;",{"_3355":68539,"_29485":68489,"_20482":114051,"_5":14053,"_26831":113935,"_2843":114052},[],"migración previa incompleta.",{"_3355":68540,"_29485":68489,"_20482":114054,"_5":14053,"_26831":113935,"_2843":114055},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3355":68541,"_29485":68489,"_20482":114057,"_5":14053,"_26831":113935,"_2843":114058},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3355":68542,"_29485":68489,"_20482":114060,"_5":14053,"_26831":113935,"_2843":114061},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3355":68543,"_29485":68489,"_20482":114063,"_5":14053,"_26831":113939,"_2843":114064},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3355":68544,"_29485":68489,"_20482":114066,"_5":14053,"_26831":113939,"_2843":114067},[],"verifica que esté habilitado en el servicio emisor;",{"_3355":68545,"_29485":68489,"_20482":114069,"_5":14053,"_26831":113939,"_2843":114070},[],"comprueba conectividad y credenciales AMQP;",{"_3355":68546,"_29485":68489,"_20482":114072,"_5":14053,"_26831":113939,"_2843":114073},[],"revisa exchange, routing key, colas y consumidores;",{"_3355":68547,"_29485":68489,"_20482":114075,"_5":14053,"_26831":113939,"_2843":114076},[],"inspecciona dead-letter queues;",{"_3355":68548,"_29485":68489,"_20482":114078,"_5":14053,"_26831":113939,"_2843":114079},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3355":68549,"_29485":68489,"_20482":114081,"_5":14053,"_26831":113939,"_2843":114082},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3355":68550,"_29485":68489,"_20482":114084,"_5":14053,"_26831":113939,"_2843":114085},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3355":68551,"_29485":68489,"_20482":114087,"_5":14053,"_26831":113939,"_2843":114088},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3355":68552,"_29485":68489,"_20482":114090,"_5":14053,"_26831":113939,"_2843":114091},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3355":68553,"_29485":68489,"_20482":114093,"_5":14053,"_26831":113939,"_2843":114094},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3355":68554,"_29485":68489,"_20482":114096,"_5":14053,"_26831":113939,"_2843":114097},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3355":68555,"_29485":68489,"_20482":114099,"_5":14053,"_26831":113939,"_2843":114100},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3355":68556,"_29485":68489,"_20482":114102,"_5":14053,"_26831":113943,"_2843":114103},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3355":68557,"_29485":68489,"_20482":114105,"_5":14053,"_26831":113943,"_2843":114106},[],"Antes de cerrar una incidencia, guarda:",{"_3355":68558,"_29485":68489,"_20482":114108,"_5":14053,"_26831":113943,"_2843":114109},[],"causa confirmada;",{"_3355":68559,"_29485":68489,"_20482":114111,"_5":14053,"_26831":113943,"_2843":114112},[],"alcance temporal y recursos afectados;",{"_3355":68560,"_29485":68489,"_20482":114114,"_5":14053,"_26831":113943,"_2843":114115},[],"comandos o consultas utilizados;",{"_3355":68561,"_29485":68489,"_20482":114117,"_5":14053,"_26831":113943,"_2843":114118},[],"cambio aplicado y forma de revertirlo;",{"_3355":68562,"_29485":68489,"_20482":114120,"_5":14053,"_26831":113943,"_2843":114121},[],"validación desde un consumidor;",{"_3355":68563,"_29485":68489,"_20482":114123,"_5":14053,"_26831":113943,"_2843":114124},[],"acción preventiva y propietario.",{"_3355":68564,"_29485":68564,"_5":14411,"_2843":114126,"_29817":114127,"_20482":114130,"_26831":68564},"Control de acceso",[47939,114128,114129],"Plataforma","Administración",[],{"_3355":68565,"_29485":68564,"_20482":114132,"_5":14053,"_26831":68564,"_2843":114133},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3355":68566,"_29485":68564,"_5":29814,"_20482":114135,"_26831":114136,"_2843":114137},[],"/docs/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3355":68567,"_29485":68564,"_5":29814,"_20482":114139,"_26831":114140,"_2843":114141},[],"/docs/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3355":68568,"_29485":68564,"_5":29814,"_20482":114143,"_26831":114144,"_2843":114145},[],"/docs/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3355":68569,"_29485":68564,"_5":29814,"_20482":114147,"_26831":114148,"_2843":114149},[],"/docs/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3355":68570,"_29485":68564,"_5":29814,"_20482":114151,"_26831":114152,"_2843":114153},[],"/docs/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3355":68571,"_29485":68564,"_5":29814,"_20482":114155,"_26831":114156,"_2843":114157},[],"/docs/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3355":68572,"_29485":68564,"_5":29814,"_20482":114159,"_26831":114160,"_2843":114161},[],"/docs/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3355":68573,"_29485":68564,"_5":29814,"_20482":114163,"_26831":114164,"_2843":114165},[],"/docs/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3355":68574,"_29485":68564,"_5":29814,"_20482":114167,"_26831":114168,"_2843":114169},[],"/docs/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3355":68575,"_29485":68564,"_5":29814,"_20482":114171,"_26831":114172,"_2843":114173},[],"/docs/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3355":68576,"_29485":68564,"_5":29814,"_20482":114175,"_26831":114176,"_2843":114177},[],"/docs/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3355":68577,"_29485":68564,"_5":29814,"_20482":114179,"_26831":114180,"_2843":114181},[],"/docs/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3355":68578,"_29485":68564,"_5":29814,"_20482":114183,"_26831":114184,"_2843":114185},[],"/docs/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3355":68579,"_29485":68564,"_5":29814,"_20482":114187,"_26831":114188,"_2843":114189},[],"/docs/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3355":68580,"_29485":68564,"_5":29814,"_20482":114191,"_26831":114192,"_2843":114193},[],"/docs/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3355":68581,"_29485":68564,"_5":29814,"_20482":114195,"_26831":114196,"_2843":113303},[],"/docs/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3355":68582,"_29485":68564,"_5":29814,"_20482":114198,"_26831":114199,"_2843":114200},[],"/docs/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3355":68583,"_29485":68564,"_5":29814,"_20482":114202,"_26831":114203,"_2843":114204},[],"/docs/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3355":68584,"_29485":68564,"_5":29814,"_20482":114206,"_26831":114207,"_2843":114208},[],"/docs/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3355":68585,"_29485":68564,"_5":29814,"_20482":114210,"_26831":114211,"_2843":114212},[],"/docs/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3355":68586,"_29485":68564,"_5":29814,"_20482":114214,"_26831":114215,"_2843":114216},[],"/docs/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3355":68587,"_29485":68564,"_5":29814,"_20482":114218,"_26831":114219,"_2843":114220},[],"/docs/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3355":68588,"_29485":68564,"_5":29814,"_20482":114222,"_26831":114223,"_2843":114224},[],"/docs/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3355":68589,"_29485":68564,"_5":29814,"_20482":114226,"_26831":114227,"_2843":114228},[],"/docs/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3355":68590,"_29485":68564,"_5":29814,"_20482":114230,"_26831":114231,"_2843":114232},[],"/docs/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3355":68591,"_29485":68564,"_5":29814,"_20482":114234,"_26831":114235,"_2843":114236},[],"/docs/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3355":68592,"_29485":68564,"_5":29814,"_20482":114238,"_26831":114239,"_2843":114240},[],"/docs/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3355":68593,"_29485":68564,"_5":29814,"_20482":114242,"_26831":114243,"_2843":114244},[],"/docs/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3355":68594,"_29485":68564,"_5":29814,"_20482":114246,"_26831":114247,"_2843":114248},[],"/docs/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3355":68595,"_29485":68564,"_5":29814,"_20482":114250,"_26831":114251,"_2843":114252},[],"/docs/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3355":68596,"_29485":68564,"_5":29814,"_20482":114254,"_26831":114255,"_2843":114256},[],"/docs/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3355":68597,"_29485":68564,"_20482":114258,"_5":14053,"_26831":68564,"_2843":114259},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3355":68598,"_29485":68564,"_20482":114261,"_5":14053,"_26831":68564,"_2843":114262},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3355":68599,"_29485":68564,"_20482":114264,"_5":14053,"_26831":68564,"_2843":114265},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3355":68600,"_29485":68564,"_20482":114267,"_5":14053,"_26831":114136,"_2843":114268},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3355":68601,"_29485":68564,"_20482":114270,"_5":14053,"_26831":114136,"_2843":114271},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3355":68602,"_29485":68564,"_20482":114273,"_5":14053,"_26831":114136,"_2843":114274},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3355":68603,"_29485":68564,"_20482":114276,"_5":14053,"_26831":114136,"_2843":114277},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3355":68604,"_29485":68564,"_20482":114279,"_5":14053,"_26831":114136,"_2843":114280},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3355":68605,"_29485":68564,"_20482":114282,"_5":14053,"_26831":114136,"_2843":114283},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3355":68606,"_29485":68564,"_20482":114285,"_5":14053,"_26831":114140,"_2843":114286},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3355":68607,"_29485":68564,"_20482":114288,"_5":14053,"_26831":114140,"_2843":114289},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3355":68608,"_29485":68564,"_20482":114291,"_5":14053,"_26831":114144,"_2843":114292},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3355":68609,"_29485":68564,"_20482":114294,"_5":14053,"_26831":114144,"_2843":114295},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3355":68610,"_29485":68564,"_20482":114297,"_5":14053,"_26831":114144,"_2843":114298},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3355":68611,"_29485":68564,"_20482":114300,"_5":14053,"_26831":114144,"_2843":114301},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3355":68612,"_29485":68564,"_20482":114303,"_5":14053,"_26831":114144,"_2843":114304},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3355":68613,"_29485":68564,"_20482":114306,"_5":14053,"_26831":114144,"_2843":114307},[],"Carga por separado las políticas concedidas a cada principal.",{"_3355":68614,"_29485":68564,"_20482":114309,"_5":14053,"_26831":114144,"_2843":114310},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3355":68615,"_29485":68564,"_20482":114312,"_5":14053,"_26831":114144,"_2843":114313},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3355":68616,"_29485":68564,"_20482":114315,"_5":14053,"_26831":114144,"_2843":114316},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3355":68617,"_29485":68564,"_20482":114318,"_5":14053,"_26831":114144,"_2843":114319},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3355":68618,"_29485":68564,"_20482":114321,"_5":14053,"_26831":114144,"_2843":114322},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_3355":68619,"_29485":68564,"_20482":114324,"_5":14053,"_26831":114144,"_2843":114325},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3355":68620,"_29485":68564,"_20482":114327,"_5":14053,"_26831":114148,"_2843":114328},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3355":68621,"_29485":68564,"_20482":114330,"_5":14053,"_26831":114148,"_2843":114331},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3355":68622,"_29485":68564,"_20482":114333,"_5":14053,"_26831":114148,"_2843":114334},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3355":68623,"_29485":68564,"_20482":114336,"_5":14053,"_26831":114148,"_2843":114337},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3355":68624,"_29485":68564,"_20482":114339,"_5":14053,"_26831":114148,"_2843":114340},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3355":68625,"_29485":68564,"_20482":114342,"_5":14053,"_26831":114148,"_2843":114343},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3355":68626,"_29485":68564,"_20482":114345,"_5":14053,"_26831":114148,"_2843":114346},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3355":68627,"_29485":68564,"_20482":114348,"_5":14053,"_26831":114148,"_2843":114349},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3355":68628,"_29485":68564,"_20482":114351,"_5":14053,"_26831":114152,"_2843":114352},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3355":68629,"_29485":68564,"_20482":114354,"_5":14053,"_26831":114152,"_2843":114355},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3355":68630,"_29485":68564,"_20482":114357,"_5":14053,"_26831":114152,"_2843":114358},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3355":68631,"_29485":68564,"_20482":114360,"_5":14053,"_26831":114152,"_2843":114361},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3355":68632,"_29485":68564,"_20482":114363,"_5":14053,"_26831":114152,"_2843":114364},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3355":68633,"_29485":68564,"_20482":114366,"_5":14053,"_26831":114152,"_2843":114367},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3355":68634,"_29485":68564,"_20482":114369,"_5":14053,"_26831":114152,"_2843":114370},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3355":68635,"_29485":68564,"_20482":114372,"_5":14053,"_26831":114152,"_2843":114373},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3355":68636,"_29485":68564,"_20482":114375,"_5":14053,"_26831":114152,"_2843":114376},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3355":68637,"_29485":68564,"_20482":114378,"_5":14053,"_26831":114152,"_2843":114379},[],"Las acciones se dividen en dos grupos:",{"_3355":68638,"_29485":68564,"_20482":114381,"_5":14053,"_26831":114152,"_2843":114382},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3355":68639,"_29485":68564,"_20482":114384,"_5":14053,"_26831":114152,"_2843":114385},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3355":68640,"_29485":68564,"_20482":114387,"_5":14053,"_26831":114152,"_2843":114388},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3355":68641,"_29485":68564,"_20482":114390,"_5":14053,"_26831":114156,"_2843":114391},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3355":68642,"_29485":68564,"_20482":114393,"_5":14053,"_26831":114156,"_2843":114394},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3355":68643,"_29485":68564,"_20482":114396,"_5":14053,"_26831":114156,"_2843":114397},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3355":68644,"_29485":68564,"_20482":114399,"_5":14053,"_26831":114160,"_2843":114400},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3355":68645,"_29485":68564,"_20482":114402,"_5":14053,"_26831":114160,"_2843":114403},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3355":68646,"_29485":68564,"_20482":114405,"_5":14053,"_26831":114160,"_2843":114406},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3355":68647,"_29485":68564,"_20482":114408,"_5":14053,"_26831":114160,"_2843":114409},[],"Los operadores implementados son:",{"_3355":68648,"_29485":68564,"_20482":114411,"_5":14053,"_26831":114160,"_2843":114412},[],"`equals`, para igualdad exacta;",{"_3355":68649,"_29485":68564,"_20482":114414,"_5":14053,"_26831":114160,"_2843":114415},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3355":68650,"_29485":68564,"_20482":114417,"_5":14053,"_26831":114160,"_2843":114418},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3355":68651,"_29485":68564,"_20482":114420,"_5":14053,"_26831":114160,"_2843":114421},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3355":68652,"_29485":68564,"_20482":114423,"_5":14053,"_26831":114164,"_2843":114424},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3355":68653,"_29485":68564,"_20482":114426,"_5":14053,"_26831":114164,"_2843":114427},[],"Los modos disponibles son:",{"_3355":68654,"_29485":68564,"_20482":114429,"_5":14053,"_26831":114164,"_2843":114430},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3355":68655,"_29485":68564,"_20482":114432,"_5":14053,"_26831":114164,"_2843":114433},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3355":68656,"_29485":68564,"_20482":114435,"_5":14053,"_26831":114164,"_2843":114436},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3355":68657,"_29485":68564,"_20482":114438,"_5":14053,"_26831":114164,"_2843":114439},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3355":68658,"_29485":68564,"_20482":114441,"_5":14053,"_26831":114164,"_2843":114442},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3355":68659,"_29485":68564,"_20482":114444,"_5":14053,"_26831":114164,"_2843":114445},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3355":68660,"_29485":68564,"_20482":114447,"_5":14053,"_26831":114168,"_2843":114448},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3355":68661,"_29485":68564,"_20482":114450,"_5":14053,"_26831":114168,"_2843":114451},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3355":68662,"_29485":68564,"_20482":114453,"_5":14053,"_26831":114168,"_2843":114454},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3355":68663,"_29485":68564,"_20482":114456,"_5":14053,"_26831":114168,"_2843":114457},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3355":68664,"_29485":68564,"_20482":114459,"_5":14053,"_26831":114176,"_2843":114460},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3355":68665,"_29485":68564,"_20482":114462,"_5":14053,"_26831":114176,"_2843":114463},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3355":68666,"_29485":68564,"_20482":114465,"_5":14053,"_26831":114180,"_2843":114466},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3355":68667,"_29485":68564,"_20482":114468,"_5":14053,"_26831":114180,"_2843":114469},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3355":68668,"_29485":68564,"_20482":114471,"_5":14053,"_26831":114184,"_2843":114472},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3355":68669,"_29485":68564,"_20482":114474,"_5":14053,"_26831":114184,"_2843":114475},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3355":68670,"_29485":68564,"_20482":114477,"_5":14053,"_26831":114184,"_2843":114478},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3355":68671,"_29485":68564,"_20482":114480,"_5":14053,"_26831":114188,"_2843":114481},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3355":68672,"_29485":68564,"_20482":114483,"_5":14053,"_26831":114188,"_2843":114484},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3355":68673,"_29485":68564,"_20482":114486,"_5":14053,"_26831":114188,"_2843":114487},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3355":68674,"_29485":68564,"_20482":114489,"_5":14053,"_26831":114188,"_2843":114490},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3355":68675,"_29485":68564,"_20482":114492,"_5":14053,"_26831":114188,"_2843":114493},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3355":68676,"_29485":68564,"_20482":114495,"_5":14053,"_26831":114188,"_2843":114496},[],"Ten en cuenta que:",{"_3355":68677,"_29485":68564,"_20482":114498,"_5":14053,"_26831":114188,"_2843":114499},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3355":68678,"_29485":68564,"_20482":114501,"_5":14053,"_26831":114188,"_2843":114502},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3355":68679,"_29485":68564,"_20482":114504,"_5":14053,"_26831":114188,"_2843":114505},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3355":68680,"_29485":68564,"_20482":114507,"_5":14053,"_26831":114192,"_2843":114508},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3355":68681,"_29485":68564,"_20482":114510,"_5":14053,"_26831":114192,"_2843":114511},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3355":68682,"_29485":68564,"_20482":114513,"_5":14053,"_26831":114192,"_2843":114514},[],"acceso completo y de solo lectura a KMS;",{"_3355":68683,"_29485":68564,"_20482":114516,"_5":14053,"_26831":114192,"_2843":114517},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3355":68684,"_29485":68564,"_20482":114519,"_5":14053,"_26831":114192,"_2843":114520},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3355":68685,"_29485":68564,"_20482":114522,"_5":14053,"_26831":114192,"_2843":114523},[],"acceso a la interfaz;",{"_3355":68686,"_29485":68564,"_20482":114525,"_5":14053,"_26831":114192,"_2843":114526},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3355":68687,"_29485":68564,"_20482":114528,"_5":14053,"_26831":114192,"_2843":114529},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3355":68688,"_29485":68564,"_20482":114531,"_5":14053,"_26831":114192,"_2843":114532},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3355":68689,"_29485":68564,"_20482":114534,"_5":14053,"_26831":114196,"_2843":114535},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3355":68690,"_29485":68564,"_20482":114537,"_5":14053,"_26831":114196,"_2843":114538},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3355":68691,"_29485":68564,"_20482":114540,"_5":14053,"_26831":114196,"_2843":114541},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3355":68692,"_29485":68564,"_20482":114543,"_5":14053,"_26831":114199,"_2843":114544},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3355":68693,"_29485":68564,"_20482":114546,"_5":14053,"_26831":114203,"_2843":114547},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3355":68694,"_29485":68564,"_20482":114549,"_5":14053,"_26831":114203,"_2843":114550},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3355":68695,"_29485":68564,"_20482":114552,"_5":14053,"_26831":114207,"_2843":114553},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3355":68696,"_29485":68564,"_20482":114555,"_5":14053,"_26831":114211,"_2843":114556},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3355":68697,"_29485":68564,"_20482":114558,"_5":14053,"_26831":114215,"_2843":114559},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3355":68698,"_29485":68564,"_20482":114561,"_5":14053,"_26831":114219,"_2843":114562},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3355":68699,"_29485":68564,"_20482":114564,"_5":14053,"_26831":114219,"_2843":114565},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3355":68700,"_29485":68564,"_20482":114567,"_5":14053,"_26831":114223,"_2843":114568},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3355":68701,"_29485":68564,"_20482":114570,"_5":14053,"_26831":114223,"_2843":114571},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3355":68702,"_29485":68564,"_20482":114573,"_5":14053,"_26831":114223,"_2843":114574},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3355":68703,"_29485":68564,"_20482":114576,"_5":14053,"_26831":114223,"_2843":114577},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3355":68704,"_29485":68564,"_20482":114579,"_5":14053,"_26831":114223,"_2843":114580},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3355":68705,"_29485":68564,"_20482":114582,"_5":14053,"_26831":114223,"_2843":114583},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3355":68706,"_29485":68564,"_20482":114585,"_5":14053,"_26831":114223,"_2843":114586},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3355":68707,"_29485":68564,"_20482":114588,"_5":14053,"_26831":114223,"_2843":114589},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3355":68708,"_29485":68564,"_20482":114591,"_5":14053,"_26831":114227,"_2843":114592},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3355":68709,"_29485":68564,"_20482":114594,"_5":14053,"_26831":114227,"_2843":114595},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3355":68710,"_29485":68564,"_20482":114597,"_5":14053,"_26831":114227,"_2843":114598},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3355":68711,"_29485":68564,"_20482":114600,"_5":14053,"_26831":114231,"_2843":114601},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3355":68712,"_29485":68564,"_20482":114603,"_5":14053,"_26831":114231,"_2843":114604},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3355":68713,"_29485":68564,"_20482":114606,"_5":14053,"_26831":114231,"_2843":114607},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3355":68714,"_29485":68564,"_20482":114609,"_5":14053,"_26831":114231,"_2843":114610},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3355":68715,"_29485":68564,"_20482":114612,"_5":14053,"_26831":114231,"_2843":114613},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3355":68716,"_29485":68564,"_20482":114615,"_5":14053,"_26831":114231,"_2843":114616},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3355":68717,"_29485":68564,"_20482":114618,"_5":14053,"_26831":114231,"_2843":114619},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3355":68718,"_29485":68564,"_20482":114621,"_5":14053,"_26831":114231,"_2843":114622},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3355":68719,"_29485":68564,"_20482":114624,"_5":14053,"_26831":114239,"_2843":114625},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3355":68720,"_29485":68564,"_20482":114627,"_5":14053,"_26831":114243,"_2843":114628},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3355":68721,"_29485":68564,"_20482":114630,"_5":14053,"_26831":114243,"_2843":114631},[],"que exista un principal activo del tipo correcto;",{"_3355":68722,"_29485":68564,"_20482":114633,"_5":14053,"_26831":114243,"_2843":114634},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3355":68723,"_29485":68564,"_20482":114636,"_5":14053,"_26831":114243,"_2843":114637},[],"que todas las condiciones del principal se cumplan;",{"_3355":68724,"_29485":68564,"_20482":114639,"_5":14053,"_26831":114243,"_2843":114640},[],"que el principal tenga concedida la política esperada;",{"_3355":68725,"_29485":68564,"_20482":114642,"_5":14053,"_26831":114243,"_2843":114643},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3355":68726,"_29485":68564,"_20482":114645,"_5":14053,"_26831":114243,"_2843":114646},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3355":68727,"_29485":68564,"_20482":114648,"_5":14053,"_26831":114243,"_2843":114649},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3355":68728,"_29485":68564,"_20482":114651,"_5":14053,"_26831":114247,"_2843":114652},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3355":68729,"_29485":68564,"_20482":114654,"_5":14053,"_26831":114251,"_2843":114655},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3355":68730,"_29485":68564,"_20482":114657,"_5":14053,"_26831":114255,"_2843":114658},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3355":68731,"_29485":68564,"_20482":114660,"_5":14053,"_26831":114255,"_2843":114661},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3355":68732,"_29485":68732,"_5":14411,"_2843":114663,"_29817":114664,"_20482":114665,"_26831":68732},"Alertas y suscripciones",[47939,114128,114129],[],{"_3355":68733,"_29485":68732,"_20482":114667,"_5":14053,"_26831":68732,"_2843":114668},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3355":68734,"_29485":68732,"_5":29814,"_20482":114670,"_26831":114671,"_2843":114672},[],"/docs/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3355":68735,"_29485":68732,"_5":29814,"_20482":114674,"_26831":114675,"_2843":114676},[],"/docs/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3355":68736,"_29485":68732,"_5":29814,"_20482":114678,"_26831":114679,"_2843":114680},[],"/docs/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3355":68737,"_29485":68732,"_5":29814,"_20482":114682,"_26831":114683,"_2843":114684},[],"/docs/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3355":68738,"_29485":68732,"_5":29814,"_20482":114686,"_26831":114687,"_2843":114688},[],"/docs/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3355":68739,"_29485":68732,"_5":29814,"_20482":114690,"_26831":114691,"_2843":114692},[],"/docs/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3355":68740,"_29485":68732,"_5":29814,"_20482":114694,"_26831":114695,"_2843":114696},[],"/docs/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3355":68741,"_29485":68732,"_5":29814,"_20482":114698,"_26831":114699,"_2843":114700},[],"/docs/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3355":68742,"_29485":68732,"_5":29814,"_20482":114702,"_26831":114703,"_2843":114704},[],"/docs/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3355":68743,"_29485":68732,"_5":29814,"_20482":114706,"_26831":114707,"_2843":114708},[],"/docs/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3355":68744,"_29485":68732,"_5":29814,"_20482":114710,"_26831":114711,"_2843":114712},[],"/docs/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3355":68745,"_29485":68732,"_20482":114714,"_5":14053,"_26831":68732,"_2843":114715},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3355":68746,"_29485":68732,"_20482":114717,"_5":14053,"_26831":114671,"_2843":114718},[],"Un servicio publica un evento de dominio.",{"_3355":68747,"_29485":68732,"_20482":114720,"_5":14053,"_26831":114671,"_2843":114721},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3355":68748,"_29485":68732,"_20482":114723,"_5":14053,"_26831":114671,"_2843":114724},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3355":68749,"_29485":68732,"_20482":114726,"_5":14053,"_26831":114671,"_2843":114727},[],"Lamassu entrega el evento al canal configurado.",{"_3355":68750,"_29485":68732,"_20482":114729,"_5":14053,"_26831":114671,"_2843":114730},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3355":68751,"_29485":68732,"_20482":114732,"_5":14053,"_26831":114675,"_2843":114733},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3355":68752,"_29485":68732,"_20482":114735,"_5":14053,"_26831":114675,"_2843":114736},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3355":68753,"_29485":68732,"_20482":114738,"_5":14053,"_26831":114675,"_2843":114739},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3355":68754,"_29485":68732,"_20482":114741,"_5":14053,"_26831":114675,"_2843":114742},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3355":68755,"_29485":68732,"_20482":114744,"_5":14053,"_26831":114675,"_2843":114745},[],"`apikey_options` necesita `header` y `key`.",{"_3355":68756,"_29485":68732,"_20482":114747,"_5":14053,"_26831":114675,"_2843":114748},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3355":68757,"_29485":68732,"_20482":114750,"_5":14053,"_26831":114675,"_2843":114751},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3355":68758,"_29485":68732,"_20482":114753,"_5":14053,"_26831":114675,"_2843":114754},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3355":68759,"_29485":68732,"_20482":114756,"_5":14053,"_26831":114683,"_2843":114757},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3355":68760,"_29485":68732,"_20482":114759,"_5":14053,"_26831":114687,"_2843":114760},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3355":68761,"_29485":68732,"_20482":114762,"_5":14053,"_26831":114691,"_2843":114763},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3355":68762,"_29485":68732,"_20482":114765,"_5":14053,"_26831":114691,"_2843":114766},[],"**None** notifica todas las instancias del evento.",{"_3355":68763,"_29485":68732,"_20482":114768,"_5":14053,"_26831":114691,"_2843":114769},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3355":68764,"_29485":68732,"_20482":114771,"_5":14053,"_26831":114691,"_2843":114772},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3355":68765,"_29485":68732,"_20482":114774,"_5":14053,"_26831":114691,"_2843":114775},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3355":68766,"_29485":68732,"_20482":114777,"_5":14053,"_26831":114691,"_2843":114778},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3355":68767,"_29485":68732,"_20482":114780,"_5":14053,"_26831":114691,"_2843":114781},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3355":68768,"_29485":68732,"_20482":114783,"_5":14053,"_26831":114695,"_2843":114784},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3355":68769,"_29485":68732,"_20482":114786,"_5":14053,"_26831":114699,"_2843":114787},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3355":68770,"_29485":68732,"_20482":114789,"_5":14053,"_26831":114699,"_2843":114790},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3355":68771,"_29485":68732,"_20482":114792,"_5":14053,"_26831":114699,"_2843":114793},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3355":68772,"_29485":68732,"_20482":114795,"_5":14053,"_26831":114699,"_2843":114796},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3355":68773,"_29485":68732,"_20482":114798,"_5":14053,"_26831":114699,"_2843":114799},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3355":68774,"_29485":68732,"_20482":114801,"_5":14053,"_26831":114699,"_2843":114802},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3355":68775,"_29485":68732,"_20482":114804,"_5":14053,"_26831":114699,"_2843":114805},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3355":68776,"_29485":68732,"_20482":114807,"_5":14053,"_26831":114699,"_2843":114808},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3355":68777,"_29485":68732,"_20482":114810,"_5":14053,"_26831":114703,"_2843":114811},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3355":68778,"_29485":68732,"_20482":114813,"_5":14053,"_26831":114703,"_2843":114814},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3355":68779,"_29485":68732,"_20482":114816,"_5":14053,"_26831":114703,"_2843":114817},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3355":68780,"_29485":68732,"_20482":114819,"_5":14053,"_26831":114703,"_2843":114820},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3355":68781,"_29485":68732,"_20482":114822,"_5":14053,"_26831":114703,"_2843":114823},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3355":68782,"_29485":68732,"_20482":114825,"_5":14053,"_26831":114703,"_2843":114826},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3355":68783,"_29485":68732,"_20482":114828,"_5":14053,"_26831":114703,"_2843":114829},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3355":68784,"_29485":68732,"_20482":114831,"_5":14053,"_26831":114703,"_2843":114832},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3355":68785,"_29485":68732,"_20482":114834,"_5":14053,"_26831":114707,"_2843":114835},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3355":68786,"_29485":68732,"_20482":114837,"_5":14053,"_26831":114707,"_2843":114838},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3355":68787,"_29485":68732,"_20482":114840,"_5":14053,"_26831":114711,"_2843":114841},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3355":68788,"_29485":68732,"_20482":114843,"_5":14053,"_26831":114711,"_2843":114844},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3355":68789,"_29485":68732,"_20482":114846,"_5":14053,"_26831":114711,"_2843":114847},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3355":68790,"_29485":68732,"_20482":114849,"_5":14053,"_26831":114711,"_2843":114850},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3355":68791,"_29485":68732,"_20482":114852,"_5":14053,"_26831":114711,"_2843":114853},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3355":68792,"_29485":68732,"_20482":114855,"_5":14053,"_26831":114711,"_2843":114856},[],"**Validación:** `va.role.crl.create`.",{"_3355":68793,"_29485":68732,"_20482":114858,"_5":14053,"_26831":114711,"_2843":114859},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3355":68794,"_29485":68732,"_20482":114861,"_5":14053,"_26831":114711,"_2843":114862},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3355":68795,"_29485":68795,"_5":14411,"_2843":114864,"_29817":114865,"_20482":114866,"_26831":68795},"Registros de auditoría",[47939,114128,114129],[],{"_3355":68796,"_29485":68795,"_20482":114868,"_5":14053,"_26831":68795,"_2843":114869},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3355":68797,"_29485":68795,"_5":29814,"_20482":114871,"_26831":114872,"_2843":114873},[],"/docs/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3355":68798,"_29485":68795,"_5":29814,"_20482":114875,"_26831":114876,"_2843":114877},[],"/docs/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3355":68799,"_29485":68795,"_5":29814,"_20482":114879,"_26831":114880,"_2843":114881},[],"/docs/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3355":68800,"_29485":68795,"_5":29814,"_20482":114883,"_26831":114884,"_2843":114885},[],"/docs/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3355":68801,"_29485":68795,"_5":29814,"_20482":114887,"_26831":114888,"_2843":114889},[],"/docs/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3355":68802,"_29485":68795,"_5":29814,"_20482":114891,"_26831":114892,"_2843":114893},[],"/docs/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3355":68803,"_29485":68795,"_5":29814,"_20482":114895,"_26831":114896,"_2843":114897},[],"/docs/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3355":68804,"_29485":68795,"_5":29814,"_20482":114899,"_26831":114900,"_2843":114901},[],"/docs/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3355":68805,"_29485":68795,"_5":29814,"_20482":114903,"_26831":114904,"_2843":114905},[],"/docs/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3355":68806,"_29485":68795,"_5":29814,"_20482":114907,"_26831":114908,"_2843":114909},[],"/docs/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3355":68807,"_29485":68795,"_5":29814,"_20482":114911,"_26831":114912,"_2843":114913},[],"/docs/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3355":68808,"_29485":68795,"_20482":114915,"_5":14053,"_26831":68795,"_2843":114916},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3355":68809,"_29485":68795,"_20482":114918,"_5":14053,"_26831":114872,"_2843":114919},[],"El cuerpo de auditoría incluye:",{"_3355":68810,"_29485":68795,"_20482":114921,"_5":14053,"_26831":114872,"_2843":114922},[],"input: datos recibidos por la operación;",{"_3355":68811,"_29485":68795,"_20482":114924,"_5":14053,"_26831":114872,"_2843":114925},[],"has\\_error: indica si el servicio devolvió un error;",{"_3355":68812,"_29485":68795,"_20482":114927,"_5":14053,"_26831":114872,"_2843":114928},[],"output: resultado producido o mensaje de error;",{"_3355":68813,"_29485":68795,"_20482":114930,"_5":14053,"_26831":114872,"_2843":114931},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3355":68814,"_29485":68795,"_20482":114933,"_5":14053,"_26831":114872,"_2843":114934},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3355":68815,"_29485":68795,"_20482":114936,"_5":14053,"_26831":114872,"_2843":114937},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3355":68816,"_29485":68795,"_20482":114939,"_5":14053,"_26831":114876,"_2843":114940},[],"El backend aplica auditoría a mutaciones de:",{"_3355":68817,"_29485":68795,"_20482":114942,"_5":14053,"_26831":114876,"_2843":114943},[],"autoridades, certificados y perfiles de emisión;",{"_3355":68818,"_29485":68795,"_20482":114945,"_5":14053,"_26831":114876,"_2843":114946},[],"claves y motores KMS;",{"_3355":68819,"_29485":68795,"_20482":114948,"_5":14053,"_26831":114876,"_2843":114949},[],"dispositivos e identidades;",{"_3355":68820,"_29485":68795,"_20482":114951,"_5":14053,"_26831":114876,"_2843":114952},[],"DMS y operaciones de enrolamiento;",{"_3355":68821,"_29485":68795,"_20482":114954,"_5":14053,"_26831":114876,"_2843":114955},[],"funciones de validación y CRL;",{"_3355":68822,"_29485":68795,"_20482":114957,"_5":14053,"_26831":114876,"_2843":114958},[],"principales, políticas y concesiones de autorización.",{"_3355":68823,"_29485":68795,"_20482":114960,"_5":14053,"_26831":114876,"_2843":114961},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3355":68824,"_29485":68795,"_20482":114963,"_5":14053,"_26831":114880,"_2843":114964},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3355":68825,"_29485":68795,"_20482":114966,"_5":14053,"_26831":114880,"_2843":114967},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3355":68826,"_29485":68795,"_20482":114969,"_5":14053,"_26831":114880,"_2843":114970},[],"Diseña el consumidor para:",{"_3355":68827,"_29485":68795,"_20482":114972,"_5":14053,"_26831":114880,"_2843":114973},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3355":68828,"_29485":68795,"_20482":114975,"_5":14053,"_26831":114880,"_2843":114976},[],"conservar el CloudEvent completo sin modificar;",{"_3355":68829,"_29485":68795,"_20482":114978,"_5":14053,"_26831":114880,"_2843":114979},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3355":68830,"_29485":68795,"_20482":114981,"_5":14053,"_26831":114880,"_2843":114982},[],"cifrar en tránsito y en reposo;",{"_3355":68831,"_29485":68795,"_20482":114984,"_5":14053,"_26831":114880,"_2843":114985},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3355":68832,"_29485":68795,"_20482":114987,"_5":14053,"_26831":114880,"_2843":114988},[],"aplicar una política explícita de retención y legal hold;",{"_3355":68833,"_29485":68795,"_20482":114990,"_5":14053,"_26831":114880,"_2843":114991},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3355":68834,"_29485":68795,"_20482":114993,"_5":14053,"_26831":114884,"_2843":114994},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3355":68835,"_29485":68795,"_20482":114996,"_5":14053,"_26831":114884,"_2843":114997},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3355":68836,"_29485":68795,"_20482":114999,"_5":14053,"_26831":114892,"_2843":115000},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3355":68837,"_29485":68795,"_20482":115002,"_5":14053,"_26831":114896,"_2843":115003},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3355":68838,"_29485":68795,"_20482":115005,"_5":14053,"_26831":114900,"_2843":115006},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3355":68839,"_29485":68795,"_20482":115008,"_5":14053,"_26831":114904,"_2843":115009},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3355":68840,"_29485":68795,"_20482":115011,"_5":14053,"_26831":114908,"_2843":115012},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3355":68841,"_29485":68795,"_20482":115014,"_5":14053,"_26831":114912,"_2843":115015},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3355":68842,"_29485":68795,"_20482":115017,"_5":14053,"_26831":114912,"_2843":115018},[],"aparece un evento de auditoría correcto;",{"_3355":68843,"_29485":68795,"_20482":115020,"_5":14053,"_26831":114912,"_2843":115021},[],"el principal coincide con la identidad utilizada;",{"_3355":68844,"_29485":68795,"_20482":115023,"_5":14053,"_26831":114912,"_2843":115024},[],"el consumidor lo persiste una sola vez;",{"_3355":68845,"_29485":68795,"_20482":115026,"_5":14053,"_26831":114912,"_2843":115027},[],"puede recuperarse por recurso, actor y periodo;",{"_3355":68846,"_29485":68795,"_20482":115029,"_5":14053,"_26831":114912,"_2843":115030},[],"una interrupción del consumidor produce una alerta.",{"_3355":68847,"_29485":68795,"_20482":115032,"_5":14053,"_26831":114912,"_2843":115033},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3355":68848,"_29485":68848,"_5":14411,"_2843":115035,"_29817":115036,"_20482":115037,"_26831":68848},"Arquitectura de la plataforma",[47939,114128],[],{"_3355":68849,"_29485":68848,"_20482":115039,"_5":14053,"_26831":68848,"_2843":115040},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3355":68850,"_29485":68848,"_5":29814,"_20482":115042,"_26831":115043,"_2843":115044},[],"/docs/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3355":68851,"_29485":68848,"_5":29814,"_20482":115046,"_26831":115047,"_2843":115048},[],"/docs/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3355":68852,"_29485":68848,"_5":29814,"_20482":115050,"_26831":115051,"_2843":115052},[],"/docs/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3355":68853,"_29485":68848,"_5":29814,"_20482":115054,"_26831":115055,"_2843":115056},[],"/docs/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3355":68854,"_29485":68848,"_5":29814,"_20482":115058,"_26831":115059,"_2843":115060},[],"/docs/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3355":68855,"_29485":68848,"_20482":115062,"_5":14053,"_26831":68848,"_2843":115063},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3355":68856,"_29485":68848,"_20482":115065,"_5":14053,"_26831":68848,"_2843":115066},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3355":68857,"_29485":68848,"_20482":115068,"_5":14053,"_26831":115043,"_2843":115069},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3355":68858,"_29485":68848,"_20482":115071,"_5":14053,"_26831":115047,"_2843":115072},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3355":68859,"_29485":68848,"_20482":115074,"_5":14053,"_26831":115051,"_2843":115075},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3355":68860,"_29485":68848,"_20482":115077,"_5":14053,"_26831":115055,"_2843":115078},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3355":68861,"_29485":68848,"_20482":115080,"_5":14053,"_26831":115059,"_2843":115081},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3355":68862,"_29485":68862,"_5":14411,"_2843":115083,"_29817":115084,"_20482":115085,"_26831":68862},"Cómo funciona Lamassu",[47939,114128],[],{"_3355":68863,"_29485":68862,"_20482":115087,"_5":14053,"_26831":68862,"_2843":115088},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3355":68864,"_29485":68862,"_5":29814,"_20482":115090,"_26831":115091,"_2843":115092},[],"/docs/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3355":68865,"_29485":68862,"_5":29814,"_20482":115094,"_26831":115095,"_2843":115096},[],"/docs/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3355":68866,"_29485":68862,"_20482":115098,"_5":14053,"_26831":68862,"_2843":115099},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3355":68867,"_29485":68862,"_20482":115101,"_5":14053,"_26831":115091,"_2843":115102},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3355":68868,"_29485":68862,"_20482":115104,"_5":14053,"_26831":115091,"_2843":115105},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3355":68869,"_29485":68862,"_20482":115107,"_5":14053,"_26831":115091,"_2843":115108},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3355":68870,"_29485":68862,"_20482":115110,"_5":14053,"_26831":115091,"_2843":115111},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3355":68871,"_29485":68862,"_20482":115113,"_5":14053,"_26831":115091,"_2843":115114},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3355":68872,"_29485":68862,"_20482":115116,"_5":14053,"_26831":115095,"_2843":115117},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3355":68873,"_29485":68862,"_20482":115119,"_5":14053,"_26831":115095,"_2843":115120},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3355":68874,"_29485":68862,"_20482":115122,"_5":14053,"_26831":115095,"_2843":115123},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3355":68875,"_29485":68862,"_20482":115125,"_5":14053,"_26831":115095,"_2843":115126},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3355":68876,"_29485":68862,"_20482":115128,"_5":14053,"_26831":115095,"_2843":115129},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3355":68877,"_29485":68862,"_20482":115131,"_5":14053,"_26831":115095,"_2843":115132},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3355":68878,"_29485":68862,"_20482":115134,"_5":14053,"_26831":115095,"_2843":115135},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3355":68879,"_29485":68879,"_5":14411,"_2843":115137,"_29817":115138,"_20482":115139,"_26831":68879},"Dispositivos e identidades",[47939,114128,50418,115137],[],{"_3355":68880,"_29485":68879,"_20482":115141,"_5":14053,"_26831":68879,"_2843":115142},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3355":68881,"_29485":68879,"_5":29814,"_20482":115144,"_26831":115145,"_2843":115146},[],"/docs/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3355":68882,"_29485":68879,"_5":29814,"_20482":115148,"_26831":115149,"_2843":115150},[],"/docs/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3355":68883,"_29485":68879,"_5":29814,"_20482":115152,"_26831":115153,"_2843":115154},[],"/docs/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3355":68884,"_29485":68879,"_5":29814,"_20482":115156,"_26831":115157,"_2843":115158},[],"/docs/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3355":68885,"_29485":68879,"_5":29814,"_20482":115160,"_26831":115161,"_2843":115162},[],"/docs/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3355":68886,"_29485":68879,"_5":29814,"_20482":115164,"_26831":115165,"_2843":115166},[],"/docs/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3355":68887,"_29485":68879,"_5":29814,"_20482":115168,"_26831":115169,"_2843":115170},[],"/docs/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3355":68888,"_29485":68879,"_5":29814,"_20482":115172,"_26831":115173,"_2843":115174},[],"/docs/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3355":68889,"_29485":68879,"_5":29814,"_20482":115176,"_26831":115177,"_2843":115178},[],"/docs/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3355":68890,"_29485":68879,"_5":29814,"_20482":115180,"_26831":115181,"_2843":115182},[],"/docs/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3355":68891,"_29485":68879,"_5":29814,"_20482":115184,"_26831":115185,"_2843":115186},[],"/docs/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3355":68892,"_29485":68879,"_20482":115188,"_5":14053,"_26831":68879,"_2843":115189},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3355":68893,"_29485":68879,"_20482":115191,"_5":14053,"_26831":68879,"_2843":115192},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3355":68894,"_29485":68879,"_20482":115194,"_5":14053,"_26831":115145,"_2843":115195},[],"Vista operativa",{"_3355":68895,"_29485":68879,"_20482":115197,"_5":14053,"_26831":115145,"_2843":115198},[],"Interpretación",{"_3355":68896,"_29485":68879,"_20482":115200,"_5":14053,"_26831":115145,"_2843":50481},[],{"_3355":68897,"_29485":68879,"_20482":115202,"_5":14053,"_26831":115145,"_2843":115203},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3355":68898,"_29485":68879,"_20482":115205,"_5":14053,"_26831":115145,"_2843":50487},[],{"_3355":68899,"_29485":68879,"_20482":115207,"_5":14053,"_26831":115145,"_2843":115208},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3355":68900,"_29485":68879,"_20482":115210,"_5":14053,"_26831":115145,"_2843":50493},[],{"_3355":68901,"_29485":68879,"_20482":115212,"_5":14053,"_26831":115145,"_2843":115213},[],"La identidad está en la ventana operativa de renovación.",{"_3355":68902,"_29485":68879,"_20482":115215,"_5":14053,"_26831":115145,"_2843":50499},[],{"_3355":68903,"_29485":68879,"_20482":115217,"_5":14053,"_26831":115145,"_2843":115218},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3355":68904,"_29485":68879,"_20482":115220,"_5":14053,"_26831":115145,"_2843":50505},[],{"_3355":68905,"_29485":68879,"_20482":115222,"_5":14053,"_26831":115145,"_2843":115223},[],"La identidad ha vencido.",{"_3355":68906,"_29485":68879,"_20482":115225,"_5":14053,"_26831":115145,"_2843":50511},[],{"_3355":68907,"_29485":68879,"_20482":115227,"_5":14053,"_26831":115145,"_2843":115228},[],"La identidad está marcada como revocada.",{"_3355":68908,"_29485":68879,"_20482":115230,"_5":14053,"_26831":115145,"_2843":50517},[],{"_3355":68909,"_29485":68879,"_20482":115232,"_5":14053,"_26831":115145,"_2843":115233},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3355":68910,"_29485":68879,"_20482":115235,"_5":14053,"_26831":115145,"_2843":115236},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3355":68911,"_29485":68879,"_20482":115238,"_5":14053,"_26831":115149,"_2843":115239},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3355":68912,"_29485":68879,"_20482":115241,"_5":14053,"_26831":115149,"_2843":115242},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3355":68913,"_29485":68879,"_20482":115244,"_5":14053,"_26831":115149,"_2843":115245},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3355":68914,"_29485":68879,"_20482":115247,"_5":14053,"_26831":115149,"_2843":115248},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3355":68915,"_29485":68879,"_20482":115250,"_5":14053,"_26831":115153,"_2843":115251},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3355":68916,"_29485":68879,"_20482":115253,"_5":14053,"_26831":115157,"_2843":115254},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3355":68917,"_29485":68879,"_20482":115256,"_5":14053,"_26831":115161,"_2843":115257},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3355":68918,"_29485":68879,"_20482":115259,"_5":14053,"_26831":115165,"_2843":115260},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3355":68919,"_29485":68879,"_20482":115262,"_5":14053,"_26831":115169,"_2843":115263},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3355":68920,"_29485":68879,"_20482":115265,"_5":14053,"_26831":115169,"_2843":115266},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3355":68921,"_29485":68879,"_20482":115268,"_5":14053,"_26831":115173,"_2843":115269},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3355":68922,"_29485":68879,"_20482":115271,"_5":14053,"_26831":115173,"_2843":115272},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3355":68923,"_29485":68879,"_20482":115274,"_5":14053,"_26831":115173,"_2843":115275},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3355":68924,"_29485":68879,"_20482":115277,"_5":14053,"_26831":115173,"_2843":115278},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3355":68925,"_29485":68879,"_20482":115280,"_5":14053,"_26831":115173,"_2843":115281},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3355":68926,"_29485":68879,"_20482":115283,"_5":14053,"_26831":115173,"_2843":115284},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3355":68927,"_29485":68879,"_20482":115286,"_5":14053,"_26831":115177,"_2843":115287},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3355":68928,"_29485":68879,"_20482":115289,"_5":14053,"_26831":115177,"_2843":115290},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3355":68929,"_29485":68879,"_20482":115292,"_5":14053,"_26831":115181,"_2843":115293},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3355":68930,"_29485":68879,"_20482":115295,"_5":14053,"_26831":115181,"_2843":115296},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3355":68931,"_29485":68879,"_20482":115298,"_5":14053,"_26831":115181,"_2843":115299},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3355":68932,"_29485":68879,"_20482":115301,"_5":14053,"_26831":115181,"_2843":115302},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3355":68933,"_29485":68879,"_20482":115304,"_5":14053,"_26831":115185,"_2843":115305},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3355":68934,"_29485":68879,"_20482":115307,"_5":14053,"_26831":115185,"_2843":115308},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3355":68935,"_29485":68935,"_5":14411,"_2843":115310,"_29817":115311,"_20482":115313,"_26831":68935},"Identidad inicial y autenticación",[47939,114128,50418,115137,115312],"Enrolamiento con PKI",[],{"_3355":68936,"_29485":68935,"_20482":115315,"_5":14053,"_26831":68935,"_2843":115316},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3355":68937,"_29485":68935,"_5":29814,"_20482":115318,"_26831":115319,"_2843":115320},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3355":68938,"_29485":68935,"_5":29814,"_20482":115322,"_26831":115323,"_2843":115324},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3355":68939,"_29485":68935,"_5":29814,"_20482":115326,"_26831":115327,"_2843":115328},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3355":68940,"_29485":68935,"_5":29814,"_20482":115330,"_26831":115331,"_2843":115332},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3355":68941,"_29485":68935,"_5":29814,"_20482":115334,"_26831":115335,"_2843":115336},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3355":68942,"_29485":68935,"_20482":115338,"_5":14053,"_26831":68935,"_2843":115339},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3355":68943,"_29485":68935,"_20482":115341,"_5":14053,"_26831":115319,"_2843":115342},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3355":68944,"_29485":68935,"_20482":115344,"_5":14053,"_26831":115319,"_2843":115345},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3355":68945,"_29485":68935,"_20482":115347,"_5":14053,"_26831":115323,"_2843":115348},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3355":68946,"_29485":68935,"_20482":115350,"_5":14053,"_26831":115323,"_2843":115351},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3355":68947,"_29485":68935,"_20482":115353,"_5":14053,"_26831":115323,"_2843":115354},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3355":68948,"_29485":68935,"_20482":115356,"_5":14053,"_26831":115327,"_2843":115357},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3355":68949,"_29485":68935,"_20482":115359,"_5":14053,"_26831":115327,"_2843":115360},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3355":68950,"_29485":68935,"_20482":115362,"_5":14053,"_26831":115331,"_2843":115363},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3355":68951,"_29485":68935,"_20482":115365,"_5":14053,"_26831":115331,"_2843":115366},[],"Ejemplo de cuerpo:",{"_3355":68952,"_29485":68935,"_20482":115368,"_5":14053,"_26831":115331,"_2843":115369},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3355":68953,"_29485":68935,"_20482":115371,"_5":14053,"_26831":115331,"_2843":115372},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3355":68954,"_29485":68935,"_20482":115374,"_5":14053,"_26831":115331,"_2843":115375},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3355":68955,"_29485":68935,"_20482":115377,"_5":14053,"_26831":115331,"_2843":115378},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3355":68956,"_29485":68935,"_20482":115380,"_5":14053,"_26831":115335,"_2843":115381},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3355":68957,"_29485":68935,"_20482":115383,"_5":14053,"_26831":115335,"_2843":115384},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3355":68958,"_29485":68958,"_5":14411,"_2843":115386,"_29817":115387,"_20482":115388,"_26831":68958},"Configura y opera el DMS",[47939,114128,50418,115137,115312],[],{"_3355":68959,"_29485":68958,"_20482":115390,"_5":14053,"_26831":68958,"_2843":115391},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3355":68960,"_29485":68958,"_5":29814,"_20482":115393,"_26831":115394,"_2843":112706},[],"/docs/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3355":68961,"_29485":68958,"_5":29814,"_20482":115396,"_26831":115397,"_2843":115398},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3355":68962,"_29485":68958,"_5":29814,"_20482":115400,"_26831":115401,"_2843":115402},[],"/docs/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3355":68963,"_29485":68958,"_5":29814,"_20482":115404,"_26831":115405,"_2843":115406},[],"/docs/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3355":68964,"_29485":68958,"_5":29814,"_20482":115408,"_26831":115409,"_2843":115410},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3355":68965,"_29485":68958,"_5":29814,"_20482":115412,"_26831":115413,"_2843":115414},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3355":68966,"_29485":68958,"_5":29814,"_20482":115416,"_26831":115417,"_2843":115418},[],"/docs/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3355":68967,"_29485":68958,"_5":29814,"_20482":115420,"_26831":115421,"_2843":115422},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3355":68968,"_29485":68958,"_5":29814,"_20482":115424,"_26831":115425,"_2843":50713},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3355":68969,"_29485":68958,"_5":29814,"_20482":115427,"_26831":115428,"_2843":50717},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3355":68970,"_29485":68958,"_5":29814,"_20482":115430,"_26831":115431,"_2843":115432},[],"/docs/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3355":68971,"_29485":68958,"_5":29814,"_20482":115434,"_26831":115435,"_2843":115436},[],"/docs/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3355":68972,"_29485":68958,"_5":29814,"_20482":115438,"_26831":115439,"_2843":115440},[],"/docs/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3355":68973,"_29485":68958,"_5":29814,"_20482":115442,"_26831":115443,"_2843":115444},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3355":68974,"_29485":68958,"_5":29814,"_20482":115446,"_26831":115447,"_2843":50737},[],"/docs/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3355":68975,"_29485":68958,"_5":29814,"_20482":115449,"_26831":115450,"_2843":115451},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3355":68976,"_29485":68958,"_5":29814,"_20482":115453,"_26831":115454,"_2843":115455},[],"/docs/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3355":68977,"_29485":68958,"_5":29814,"_20482":115457,"_26831":115458,"_2843":115459},[],"/docs/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3355":68978,"_29485":68958,"_20482":115461,"_5":14053,"_26831":68958,"_2843":115462},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3355":68979,"_29485":68958,"_20482":115464,"_5":14053,"_26831":115394,"_2843":115465},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3355":68980,"_29485":68958,"_20482":115467,"_5":14053,"_26831":115394,"_2843":115468},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3355":68981,"_29485":68958,"_20482":115470,"_5":14053,"_26831":115401,"_2843":115471},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3355":68982,"_29485":68958,"_20482":115473,"_5":14053,"_26831":115405,"_2843":115474},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3355":68983,"_29485":68958,"_20482":115476,"_5":14053,"_26831":115409,"_2843":115477},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3355":68984,"_29485":68958,"_20482":115479,"_5":14053,"_26831":115413,"_2843":115480},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3355":68985,"_29485":68958,"_20482":115482,"_5":14053,"_26831":115417,"_2843":115483},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3355":68986,"_29485":68958,"_20482":115485,"_5":14053,"_26831":115425,"_2843":115486},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3355":68987,"_29485":68958,"_20482":115488,"_5":14053,"_26831":115425,"_2843":115489},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3355":68988,"_29485":68958,"_20482":115491,"_5":14053,"_26831":115428,"_2843":115492},[],"Campo de `settings.enrollment_settings`",{"_3355":68989,"_29485":68958,"_20482":115494,"_5":14053,"_26831":115428,"_2843":115495},[],"Decisión",{"_3355":68990,"_29485":68958,"_20482":115497,"_5":14053,"_26831":115428,"_2843":50788},[],{"_3355":68991,"_29485":68958,"_20482":115499,"_5":14053,"_26831":115428,"_2843":115500},[],"`EST_RFC7030` para estas operaciones.",{"_3355":68992,"_29485":68958,"_20482":115502,"_5":14053,"_26831":115428,"_2843":50794},[],{"_3355":68993,"_29485":68958,"_20482":115504,"_5":14053,"_26831":115428,"_2843":115505},[],"ID de la CA que firmará.",{"_3355":68994,"_29485":68958,"_20482":115507,"_5":14053,"_26831":115428,"_2843":50800},[],{"_3355":68995,"_29485":68958,"_20482":115509,"_5":14053,"_26831":115428,"_2843":115510},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3355":68996,"_29485":68958,"_20482":115512,"_5":14053,"_26831":115428,"_2843":50806},[],{"_3355":68997,"_29485":68958,"_20482":115514,"_5":14053,"_26831":115428,"_2843":115515},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3355":68998,"_29485":68958,"_20482":115517,"_5":14053,"_26831":115428,"_2843":50812},[],{"_3355":68999,"_29485":68958,"_20482":115519,"_5":14053,"_26831":115428,"_2843":115520},[],"Uno de los cuatro modos de autenticación.",{"_3355":69000,"_29485":68958,"_20482":115522,"_5":14053,"_26831":115428,"_2843":115523},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3355":69001,"_29485":68958,"_20482":115525,"_5":14053,"_26831":115431,"_2843":115526},[],"Los bloques son independientes:",{"_3355":69002,"_29485":68958,"_20482":115528,"_5":14053,"_26831":115431,"_2843":115529},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3355":69003,"_29485":68958,"_20482":115531,"_5":14053,"_26831":115431,"_2843":115532},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3355":69004,"_29485":68958,"_20482":115534,"_5":14053,"_26831":115431,"_2843":50830},[],{"_3355":69005,"_29485":68958,"_20482":115536,"_5":14053,"_26831":115431,"_2843":115537},[],"Control aplicado en la operación configurada",{"_3355":69006,"_29485":68958,"_20482":115539,"_5":14053,"_26831":115431,"_2843":50836},[],{"_3355":69007,"_29485":68958,"_20482":115541,"_5":14053,"_26831":115431,"_2843":115542},[],"Validación del certificado presentado.",{"_3355":69008,"_29485":68958,"_20482":115544,"_5":14053,"_26831":115431,"_2843":50842},[],{"_3355":69009,"_29485":68958,"_20482":115546,"_5":14053,"_26831":115431,"_2843":115547},[],"Autorización del webhook configurado.",{"_3355":69010,"_29485":68958,"_20482":115549,"_5":14053,"_26831":115431,"_2843":50848},[],{"_3355":69011,"_29485":68958,"_20482":115551,"_5":14053,"_26831":115431,"_2843":115552},[],"Validación del certificado y, después, aprobación del webhook.",{"_3355":69012,"_29485":68958,"_20482":115554,"_5":14053,"_26831":115431,"_2843":50854},[],{"_3355":69013,"_29485":68958,"_20482":115556,"_5":14053,"_26831":115431,"_2843":115557},[],"Sin autenticación del solicitante por el DMS.",{"_3355":69014,"_29485":68958,"_20482":115559,"_5":14053,"_26831":115431,"_2843":115560},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3355":69015,"_29485":68958,"_20482":115562,"_5":14053,"_26831":115431,"_2843":115563},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3355":69016,"_29485":68958,"_20482":115565,"_5":14053,"_26831":115431,"_2843":115566},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3355":69017,"_29485":68958,"_20482":115568,"_5":14053,"_26831":115431,"_2843":115569},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3355":69018,"_29485":68958,"_20482":115571,"_5":14053,"_26831":115435,"_2843":115572},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3355":69019,"_29485":68958,"_20482":115574,"_5":14053,"_26831":115435,"_2843":115575},[],"Campo de `external_webhook_settings`",{"_3355":69020,"_29485":68958,"_20482":115577,"_5":14053,"_26831":115435,"_2843":115495},[],{"_3355":69021,"_29485":68958,"_20482":115579,"_5":14053,"_26831":115435,"_2843":50880},[],{"_3355":69022,"_29485":68958,"_20482":115581,"_5":14053,"_26831":115435,"_2843":115582},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3355":69023,"_29485":68958,"_20482":115584,"_5":14053,"_26831":115435,"_2843":50886},[],{"_3355":69024,"_29485":68958,"_20482":115586,"_5":14053,"_26831":115435,"_2843":115587},[],"`POST` o `PUT`; `POST` por defecto.",{"_3355":69025,"_29485":68958,"_20482":115589,"_5":14053,"_26831":115435,"_2843":50892},[],{"_3355":69026,"_29485":68958,"_20482":115591,"_5":14053,"_26831":115435,"_2843":115592},[],"Etiqueta usada en los logs del servicio.",{"_3355":69027,"_29485":68958,"_20482":115594,"_5":14053,"_26831":115435,"_2843":50898},[],{"_3355":69028,"_29485":68958,"_20482":115596,"_5":14053,"_26831":115435,"_2843":115597},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3355":69029,"_29485":68958,"_20482":115599,"_5":14053,"_26831":115435,"_2843":50904},[],{"_3355":69030,"_29485":68958,"_20482":115601,"_5":14053,"_26831":115435,"_2843":115602},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3355":69031,"_29485":68958,"_20482":115604,"_5":14053,"_26831":115435,"_2843":50910},[],{"_3355":69032,"_29485":68958,"_20482":115606,"_5":14053,"_26831":115435,"_2843":115607},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3355":69033,"_29485":68958,"_20482":115609,"_5":14053,"_26831":115435,"_2843":50916},[],{"_3355":69034,"_29485":68958,"_20482":115611,"_5":14053,"_26831":115435,"_2843":115612},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3355":69035,"_29485":68958,"_20482":115614,"_5":14053,"_26831":115435,"_2843":50922},[],{"_3355":69036,"_29485":68958,"_20482":115616,"_5":14053,"_26831":115435,"_2843":115617},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3355":69037,"_29485":68958,"_20482":115619,"_5":14053,"_26831":115435,"_2843":50928},[],{"_3355":69038,"_29485":68958,"_20482":115621,"_5":14053,"_26831":115435,"_2843":115622},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3355":69039,"_29485":68958,"_20482":115624,"_5":14053,"_26831":115435,"_2843":50934},[],{"_3355":69040,"_29485":68958,"_20482":115626,"_5":14053,"_26831":115435,"_2843":115627},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3355":69041,"_29485":68958,"_20482":115629,"_5":14053,"_26831":115435,"_2843":115630},[],"Reglas de esa configuración:",{"_3355":69042,"_29485":68958,"_20482":115632,"_5":14053,"_26831":115435,"_2843":115633},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3355":69043,"_29485":68958,"_20482":115635,"_5":14053,"_26831":115435,"_2843":115636},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3355":69044,"_29485":68958,"_20482":115638,"_5":14053,"_26831":115435,"_2843":115639},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3355":69045,"_29485":68958,"_20482":115641,"_5":14053,"_26831":115435,"_2843":115642},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3355":69046,"_29485":68958,"_20482":115644,"_5":14053,"_26831":115435,"_2843":115645},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3355":69047,"_29485":68958,"_20482":115647,"_5":14053,"_26831":115435,"_2843":115648},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3355":69048,"_29485":68958,"_20482":115650,"_5":14053,"_26831":115435,"_2843":115651},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3355":69049,"_29485":68958,"_20482":115653,"_5":14053,"_26831":115435,"_2843":115654},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3355":69050,"_29485":68958,"_20482":115656,"_5":14053,"_26831":115435,"_2843":115657},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3355":69051,"_29485":68958,"_20482":115659,"_5":14053,"_26831":115439,"_2843":115660},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3355":69052,"_29485":68958,"_20482":115662,"_5":14053,"_26831":115443,"_2843":115663},[],"Campo de `settings.reenrollment_settings`",{"_3355":69053,"_29485":68958,"_20482":115665,"_5":14053,"_26831":115443,"_2843":115666},[],"Función",{"_3355":69054,"_29485":68958,"_20482":115668,"_5":14053,"_26831":115443,"_2843":50978},[],{"_3355":69055,"_29485":68958,"_20482":115670,"_5":14053,"_26831":115443,"_2843":115671},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3355":69056,"_29485":68958,"_20482":115673,"_5":14053,"_26831":115443,"_2843":50984},[],{"_3355":69057,"_29485":68958,"_20482":115675,"_5":14053,"_26831":115443,"_2843":115676},[],"Umbral operativo preventivo de monitorización.",{"_3355":69058,"_29485":68958,"_20482":115678,"_5":14053,"_26831":115443,"_2843":50990},[],{"_3355":69059,"_29485":68958,"_20482":115680,"_5":14053,"_26831":115443,"_2843":115681},[],"Umbral operativo crítico de monitorización.",{"_3355":69060,"_29485":68958,"_20482":115683,"_5":14053,"_26831":115443,"_2843":50996},[],{"_3355":69061,"_29485":68958,"_20482":115685,"_5":14053,"_26831":115443,"_2843":115686},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3355":69062,"_29485":68958,"_20482":115688,"_5":14053,"_26831":115443,"_2843":51002},[],{"_3355":69063,"_29485":68958,"_20482":115690,"_5":14053,"_26831":115443,"_2843":115691},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3355":69064,"_29485":68958,"_20482":115693,"_5":14053,"_26831":115443,"_2843":51008},[],{"_3355":69065,"_29485":68958,"_20482":115695,"_5":14053,"_26831":115443,"_2843":115696},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3355":69066,"_29485":68958,"_20482":115698,"_5":14053,"_26831":115443,"_2843":115699},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3355":69067,"_29485":68958,"_20482":115701,"_5":14053,"_26831":115447,"_2843":115702},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3355":69068,"_29485":68958,"_20482":115704,"_5":14053,"_26831":115450,"_2843":113070},[],{"_3355":69069,"_29485":68958,"_20482":115706,"_5":14053,"_26831":115450,"_2843":115707},[],"Qué publica",{"_3355":69070,"_29485":68958,"_20482":115709,"_5":14053,"_26831":115450,"_2843":51025},[],{"_3355":69071,"_29485":68958,"_20482":115711,"_5":14053,"_26831":115450,"_2843":115712},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3355":69072,"_29485":68958,"_20482":115714,"_5":14053,"_26831":115450,"_2843":51031},[],{"_3355":69073,"_29485":68958,"_20482":115716,"_5":14053,"_26831":115450,"_2843":115717},[],"Certificado de la CA emisora seleccionada.",{"_3355":69074,"_29485":68958,"_20482":115719,"_5":14053,"_26831":115450,"_2843":51037},[],{"_3355":69075,"_29485":68958,"_20482":115721,"_5":14053,"_26831":115450,"_2843":115722},[],"Certificados de las CAs elegidas explícitamente.",{"_3355":69076,"_29485":68958,"_20482":115724,"_5":14053,"_26831":115450,"_2843":115725},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3355":69077,"_29485":68958,"_20482":115727,"_5":14053,"_26831":115454,"_2843":115728},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3355":69078,"_29485":68958,"_20482":115730,"_5":14053,"_26831":115454,"_2843":115731},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3355":69079,"_29485":68958,"_20482":115733,"_5":14053,"_26831":115454,"_2843":115734},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3355":69080,"_29485":68958,"_20482":115736,"_5":14053,"_26831":115458,"_2843":115737},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3355":69081,"_29485":69081,"_5":14411,"_2843":115739,"_29817":115740,"_20482":115741,"_26831":69081},"Integra el cliente EST",[47939,114128,50418,115137,115312],[],{"_3355":69082,"_29485":69081,"_20482":115743,"_5":14053,"_26831":69081,"_2843":115744},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3355":69083,"_29485":69081,"_5":29814,"_20482":115746,"_26831":115747,"_2843":112706},[],"/docs/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3355":69084,"_29485":69081,"_5":29814,"_20482":115749,"_26831":115750,"_2843":115751},[],"/docs/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3355":69085,"_29485":69081,"_5":29814,"_20482":115753,"_26831":115754,"_2843":115755},[],"/docs/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3355":69086,"_29485":69081,"_5":29814,"_20482":115757,"_26831":115758,"_2843":115759},[],"/docs/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3355":69087,"_29485":69081,"_5":29814,"_20482":115761,"_26831":115762,"_2843":115763},[],"/docs/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3355":69088,"_29485":69081,"_5":29814,"_20482":115765,"_26831":115766,"_2843":115767},[],"/docs/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3355":69089,"_29485":69081,"_20482":115769,"_5":14053,"_26831":69081,"_2843":115770},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3355":69090,"_29485":69081,"_20482":115772,"_5":14053,"_26831":115747,"_2843":115773},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3355":69091,"_29485":69081,"_20482":115775,"_5":14053,"_26831":115747,"_2843":115776},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3355":69092,"_29485":69081,"_20482":115778,"_5":14053,"_26831":115747,"_2843":115779},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3355":69093,"_29485":69081,"_20482":115781,"_5":14053,"_26831":115750,"_2843":115782},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3355":69094,"_29485":69081,"_20482":115784,"_5":14053,"_26831":115750,"_2843":115785},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3355":69095,"_29485":69081,"_20482":115787,"_5":14053,"_26831":115754,"_2843":115788},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3355":69096,"_29485":69081,"_20482":115790,"_5":14053,"_26831":115754,"_2843":115791},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3355":69097,"_29485":69081,"_20482":115793,"_5":14053,"_26831":115758,"_2843":115794},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3355":69098,"_29485":69081,"_20482":115796,"_5":14053,"_26831":115758,"_2843":115797},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3355":69099,"_29485":69081,"_20482":115799,"_5":14053,"_26831":115762,"_2843":115800},[],"Para el caso de una raíz que emite directamente:",{"_3355":69100,"_29485":69081,"_20482":115802,"_5":14053,"_26831":115762,"_2843":115803},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3355":69101,"_29485":69081,"_20482":115805,"_5":14053,"_26831":115762,"_2843":115806},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3355":69102,"_29485":69081,"_20482":115808,"_5":14053,"_26831":115766,"_2843":115809},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3355":69103,"_29485":69103,"_5":14411,"_2843":115811,"_29817":115812,"_20482":115813,"_26831":69103},"Referencia EST",[47939,114128,50418,115137,115312],[],{"_3355":69104,"_29485":69103,"_20482":115815,"_5":14053,"_26831":69103,"_2843":115816},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3355":69105,"_29485":69103,"_5":29814,"_20482":115818,"_26831":115819,"_2843":115820},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3355":69106,"_29485":69103,"_5":29814,"_20482":115822,"_26831":115823,"_2843":22243},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3355":69107,"_29485":69103,"_5":29814,"_20482":115825,"_26831":115826,"_2843":25477},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3355":69108,"_29485":69103,"_5":29814,"_20482":115828,"_26831":115829,"_2843":25484},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3355":69109,"_29485":69103,"_5":29814,"_20482":115831,"_26831":115832,"_2843":24818},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3355":69110,"_29485":69103,"_5":29814,"_20482":115834,"_26831":115835,"_2843":115836},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3355":69111,"_29485":69103,"_5":29814,"_20482":115838,"_26831":115839,"_2843":115840},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3355":69112,"_29485":69103,"_5":29814,"_20482":115842,"_26831":115843,"_2843":115844},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3355":69113,"_29485":69103,"_20482":115846,"_5":14053,"_26831":69103,"_2843":115847},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3355":69114,"_29485":69103,"_20482":115849,"_5":14053,"_26831":115819,"_2843":115850},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3355":69115,"_29485":69103,"_20482":115852,"_5":14053,"_26831":115819,"_2843":113888},[],{"_3355":69116,"_29485":69103,"_20482":115854,"_5":14053,"_26831":115819,"_2843":115855},[],"Método",{"_3355":69117,"_29485":69103,"_20482":115857,"_5":14053,"_26831":115819,"_2843":115858},[],"Autenticación y condición",{"_3355":69118,"_29485":69103,"_20482":115860,"_5":14053,"_26831":115819,"_2843":51180},[],{"_3355":69119,"_29485":69103,"_20482":115862,"_5":14053,"_26831":115819,"_2843":51183},[],{"_3355":69120,"_29485":69103,"_20482":115864,"_5":14053,"_26831":115819,"_2843":115865},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3355":69121,"_29485":69103,"_20482":115867,"_5":14053,"_26831":115819,"_2843":51189},[],{"_3355":69122,"_29485":69103,"_20482":115869,"_5":14053,"_26831":115819,"_2843":51192},[],{"_3355":69123,"_29485":69103,"_20482":115871,"_5":14053,"_26831":115819,"_2843":115872},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3355":69124,"_29485":69103,"_20482":115874,"_5":14053,"_26831":115819,"_2843":51198},[],{"_3355":69125,"_29485":69103,"_20482":115876,"_5":14053,"_26831":115819,"_2843":51192},[],{"_3355":69126,"_29485":69103,"_20482":115878,"_5":14053,"_26831":115819,"_2843":115879},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3355":69127,"_29485":69103,"_20482":115881,"_5":14053,"_26831":115819,"_2843":51206},[],{"_3355":69128,"_29485":69103,"_20482":115883,"_5":14053,"_26831":115819,"_2843":51192},[],{"_3355":69129,"_29485":69103,"_20482":115885,"_5":14053,"_26831":115819,"_2843":115886},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3355":69130,"_29485":69103,"_20482":115888,"_5":14053,"_26831":115819,"_2843":115889},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3355":69131,"_29485":69103,"_20482":115891,"_5":14053,"_26831":115823,"_2843":115892},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3355":69132,"_29485":69103,"_20482":115894,"_5":14053,"_26831":115823,"_2843":115895},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3355":69133,"_29485":69103,"_20482":115897,"_5":14053,"_26831":115826,"_2843":115898},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3355":69134,"_29485":69103,"_20482":115900,"_5":14053,"_26831":115826,"_2843":115901},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3355":69135,"_29485":69103,"_20482":115903,"_5":14053,"_26831":115829,"_2843":115904},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3355":69136,"_29485":69103,"_20482":115906,"_5":14053,"_26831":115829,"_2843":115907},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3355":69137,"_29485":69103,"_20482":115909,"_5":14053,"_26831":115832,"_2843":115910},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3355":69138,"_29485":69103,"_20482":115912,"_5":14053,"_26831":115832,"_2843":115913},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3355":69139,"_29485":69103,"_20482":115915,"_5":14053,"_26831":115835,"_2843":115916},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3355":69140,"_29485":69103,"_20482":115918,"_5":14053,"_26831":115835,"_2843":115919},[],"Parte",{"_3355":69141,"_29485":69103,"_20482":115921,"_5":14053,"_26831":115835,"_2843":115922},[],"Contenido tras decodificar su Base64",{"_3355":69142,"_29485":69103,"_20482":115924,"_5":14053,"_26831":115835,"_2843":51250},[],{"_3355":69143,"_29485":69103,"_20482":115926,"_5":14053,"_26831":115835,"_2843":115927},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3355":69144,"_29485":69103,"_20482":115929,"_5":14053,"_26831":115835,"_2843":51256},[],{"_3355":69145,"_29485":69103,"_20482":115931,"_5":14053,"_26831":115835,"_2843":115932},[],"PKCS#7 DER con el certificado emitido.",{"_3355":69146,"_29485":69103,"_20482":115934,"_5":14053,"_26831":115835,"_2843":115935},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3355":69147,"_29485":69103,"_20482":115937,"_5":14053,"_26831":115839,"_2843":115938},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3355":69148,"_29485":69103,"_20482":115940,"_5":14053,"_26831":115839,"_2843":115941},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3355":69149,"_29485":69103,"_20482":115943,"_5":14053,"_26831":115839,"_2843":115944},[],"Convierte y comprueba el resultado:",{"_3355":69150,"_29485":69103,"_20482":115946,"_5":14053,"_26831":115839,"_2843":115947},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3355":69151,"_29485":69103,"_20482":115949,"_5":14053,"_26831":115843,"_2843":115950},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3355":69152,"_29485":69103,"_20482":115952,"_5":14053,"_26831":115843,"_2843":115953},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3355":69153,"_29485":69153,"_5":14411,"_2843":115312,"_29817":115955,"_20482":115956,"_26831":69153},[47939,114128,50418,115137,115312],[],{"_3355":69154,"_29485":69153,"_20482":115958,"_5":14053,"_26831":69153,"_2843":115959},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3355":69155,"_29485":69153,"_5":29814,"_20482":115961,"_26831":115962,"_2843":115963},[],"/docs/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3355":69156,"_29485":69153,"_5":29814,"_20482":115965,"_26831":115966,"_2843":115967},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3355":69157,"_29485":69153,"_5":29814,"_20482":115969,"_26831":115970,"_2843":115971},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3355":69158,"_29485":69153,"_5":29814,"_20482":115973,"_26831":115974,"_2843":115975},[],"/docs/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3355":69159,"_29485":69153,"_20482":115977,"_5":14053,"_26831":69153,"_2843":115978},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3355":69160,"_29485":69153,"_20482":115980,"_5":14053,"_26831":115962,"_2843":115981},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3355":69161,"_29485":69153,"_20482":115983,"_5":14053,"_26831":115962,"_2843":115984},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3355":69162,"_29485":69153,"_20482":115986,"_5":14053,"_26831":115962,"_2843":115987},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3355":69163,"_29485":69153,"_20482":115989,"_5":14053,"_26831":115962,"_2843":115990},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3355":69164,"_29485":69153,"_20482":115992,"_5":14053,"_26831":115962,"_2843":115993},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3355":69165,"_29485":69153,"_20482":115995,"_5":14053,"_26831":115962,"_2843":115996},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3355":69166,"_29485":69153,"_20482":115998,"_5":14053,"_26831":115966,"_2843":115999},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3355":69167,"_29485":69153,"_20482":116001,"_5":14053,"_26831":115966,"_2843":116002},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3355":69168,"_29485":69153,"_20482":116004,"_5":14053,"_26831":115966,"_2843":116005},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3355":69169,"_29485":69153,"_20482":116007,"_5":14053,"_26831":115966,"_2843":116008},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3355":69170,"_29485":69153,"_20482":116010,"_5":14053,"_26831":115970,"_2843":116011},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3355":69171,"_29485":69153,"_20482":116013,"_5":14053,"_26831":115970,"_2843":116014},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3355":69172,"_29485":69153,"_20482":116016,"_5":14053,"_26831":115970,"_2843":116017},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3355":69173,"_29485":69153,"_20482":116019,"_5":14053,"_26831":115970,"_2843":116020},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3355":69174,"_29485":69153,"_20482":116022,"_5":14053,"_26831":115974,"_2843":116023},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3355":69175,"_29485":69153,"_20482":116025,"_5":14053,"_26831":115974,"_2843":116026},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3355":69176,"_29485":69176,"_5":14411,"_2843":116028,"_29817":116029,"_20482":116030,"_26831":69176},"Estrategias de aprovisionamiento",[47939,114128,50418,115137,115312],[],{"_3355":69177,"_29485":69176,"_20482":116032,"_5":14053,"_26831":69176,"_2843":116033},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3355":69178,"_29485":69176,"_5":29814,"_20482":116035,"_26831":116036,"_2843":116037},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3355":69179,"_29485":69176,"_5":29814,"_20482":116039,"_26831":116040,"_2843":116041},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3355":69180,"_29485":69176,"_5":29814,"_20482":116043,"_26831":116044,"_2843":116045},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3355":69181,"_29485":69176,"_5":29814,"_20482":116047,"_26831":116048,"_2843":116049},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3355":69182,"_29485":69176,"_5":29814,"_20482":116051,"_26831":116052,"_2843":116053},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3355":69183,"_29485":69176,"_20482":116055,"_5":14053,"_26831":69176,"_2843":116056},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3355":69184,"_29485":69176,"_20482":116058,"_5":14053,"_26831":116036,"_2843":116059},[],"Recorrido",{"_3355":69185,"_29485":69176,"_20482":116061,"_5":14053,"_26831":116036,"_2843":116062},[],"Cuándo existe el dispositivo",{"_3355":69186,"_29485":69176,"_20482":116064,"_5":14053,"_26831":116036,"_2843":116065},[],"Qué compruebas",{"_3355":69187,"_29485":69176,"_20482":116067,"_5":14053,"_26831":116036,"_2843":116068},[],"Asignación manual",{"_3355":69188,"_29485":69176,"_20482":116070,"_5":14053,"_26831":116036,"_2843":116071},[],"El operador lo crea antes de asociar un certificado.",{"_3355":69189,"_29485":69176,"_20482":116073,"_5":14053,"_26831":116036,"_2843":116074},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3355":69190,"_29485":69176,"_20482":116076,"_5":14053,"_26831":116036,"_2843":116077},[],"EST con `JITP`",{"_3355":69191,"_29485":69176,"_20482":116079,"_5":14053,"_26831":116036,"_2843":116080},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3355":69192,"_29485":69176,"_20482":116082,"_5":14053,"_26831":116036,"_2843":116083},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3355":69193,"_29485":69176,"_20482":116085,"_5":14053,"_26831":116036,"_2843":116086},[],"EST con `PRE_REGISTRATION`",{"_3355":69194,"_29485":69176,"_20482":116088,"_5":14053,"_26831":116036,"_2843":116089},[],"Debe existir antes de `/simpleenroll`.",{"_3355":69195,"_29485":69176,"_20482":116091,"_5":14053,"_26831":116036,"_2843":116092},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3355":69196,"_29485":69176,"_20482":116094,"_5":14053,"_26831":116036,"_2843":116095},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3355":69197,"_29485":69176,"_20482":116097,"_5":14053,"_26831":116036,"_2843":116098},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3355":69198,"_29485":69176,"_20482":116100,"_5":14053,"_26831":116040,"_2843":116101},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3355":69199,"_29485":69176,"_20482":116103,"_5":14053,"_26831":116040,"_2843":116104},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3355":69200,"_29485":69176,"_20482":116106,"_5":14053,"_26831":116040,"_2843":116107},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3355":69201,"_29485":69176,"_20482":116109,"_5":14053,"_26831":116044,"_2843":116110},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3355":69202,"_29485":69176,"_20482":116112,"_5":14053,"_26831":116044,"_2843":116113},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3355":69203,"_29485":69176,"_20482":116115,"_5":14053,"_26831":116044,"_2843":116116},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3355":69204,"_29485":69176,"_20482":116118,"_5":14053,"_26831":116044,"_2843":116119},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3355":69205,"_29485":69176,"_20482":116121,"_5":14053,"_26831":116044,"_2843":116122},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3355":69206,"_29485":69176,"_20482":116124,"_5":14053,"_26831":116044,"_2843":116125},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3355":69207,"_29485":69176,"_20482":116127,"_5":14053,"_26831":116048,"_2843":113070},[],{"_3355":69208,"_29485":69176,"_20482":116129,"_5":14053,"_26831":116048,"_2843":116130},[],"Material que atraviesa EST",{"_3355":69209,"_29485":69176,"_20482":116132,"_5":14053,"_26831":116048,"_2843":116133},[],"Clave generada por el dispositivo",{"_3355":69210,"_29485":69176,"_20482":116135,"_5":14053,"_26831":116048,"_2843":116136},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3355":69211,"_29485":69176,"_20482":116138,"_5":14053,"_26831":116048,"_2843":116139},[],"Clave ya disponible en el dispositivo",{"_3355":69212,"_29485":69176,"_20482":116141,"_5":14053,"_26831":116048,"_2843":116142},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3355":69213,"_29485":69176,"_20482":116144,"_5":14053,"_26831":116048,"_2843":50737},[],{"_3355":69214,"_29485":69176,"_20482":116146,"_5":14053,"_26831":116048,"_2843":116147},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3355":69215,"_29485":69176,"_20482":116149,"_5":14053,"_26831":116048,"_2843":116150},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3355":69216,"_29485":69176,"_20482":116152,"_5":14053,"_26831":116052,"_2843":116153},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3355":69217,"_29485":69217,"_5":14411,"_2843":116155,"_29817":116156,"_20482":116157,"_26831":69217},"Renovación y recuperación",[47939,114128,50418,115137,115312],[],{"_3355":69218,"_29485":69217,"_20482":116159,"_5":14053,"_26831":69217,"_2843":116160},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3355":69219,"_29485":69217,"_5":29814,"_20482":116162,"_26831":116163,"_2843":116164},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3355":69220,"_29485":69217,"_5":29814,"_20482":116166,"_26831":116167,"_2843":116168},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3355":69221,"_29485":69217,"_5":29814,"_20482":116170,"_26831":116171,"_2843":116172},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3355":69222,"_29485":69217,"_5":29814,"_20482":116174,"_26831":116175,"_2843":116176},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3355":69223,"_29485":69217,"_5":29814,"_20482":116178,"_26831":116179,"_2843":116180},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3355":69224,"_29485":69217,"_20482":116182,"_5":14053,"_26831":69217,"_2843":116183},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3355":69225,"_29485":69217,"_20482":116185,"_5":14053,"_26831":116163,"_2843":116186},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3355":69226,"_29485":69217,"_20482":116188,"_5":14053,"_26831":116163,"_2843":116189},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3355":69227,"_29485":69217,"_20482":116191,"_5":14053,"_26831":116163,"_2843":116192},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3355":69228,"_29485":69217,"_20482":116194,"_5":14053,"_26831":116163,"_2843":116195},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3355":69229,"_29485":69217,"_20482":116197,"_5":14053,"_26831":116167,"_2843":116198},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3355":69230,"_29485":69217,"_20482":116200,"_5":14053,"_26831":116167,"_2843":116201},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3355":69231,"_29485":69217,"_20482":116203,"_5":14053,"_26831":116171,"_2843":116204},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3355":69232,"_29485":69217,"_20482":116206,"_5":14053,"_26831":116171,"_2843":116207},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3355":69233,"_29485":69217,"_20482":116209,"_5":14053,"_26831":116171,"_2843":116210},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3355":69234,"_29485":69217,"_20482":116212,"_5":14053,"_26831":116175,"_2843":116213},[],"Situación",{"_3355":69235,"_29485":69217,"_20482":116215,"_5":14053,"_26831":116175,"_2843":116216},[],"Procedimiento",{"_3355":69236,"_29485":69217,"_20482":116218,"_5":14053,"_26831":116175,"_2843":116219},[],"Certificado vigente, fuera de ventana",{"_3355":69237,"_29485":69217,"_20482":116221,"_5":14053,"_26831":116175,"_2843":116222},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3355":69238,"_29485":69217,"_20482":116224,"_5":14053,"_26831":116175,"_2843":116225},[],"Certificado vencido, clave disponible",{"_3355":69239,"_29485":69217,"_20482":116227,"_5":14053,"_26831":116175,"_2843":116228},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3355":69240,"_29485":69217,"_20482":116230,"_5":14053,"_26831":116175,"_2843":116231},[],"Renovación por webhook o `NO_AUTH`",{"_3355":69241,"_29485":69217,"_20482":116233,"_5":14053,"_26831":116175,"_2843":116234},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3355":69242,"_29485":69217,"_20482":116236,"_5":14053,"_26831":116175,"_2843":116237},[],"Clave perdida o inaccesible",{"_3355":69243,"_29485":69217,"_20482":116239,"_5":14053,"_26831":116175,"_2843":116240},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3355":69244,"_29485":69217,"_20482":116242,"_5":14053,"_26831":116175,"_2843":116243},[],"Identidad actual revocada",{"_3355":69245,"_29485":69217,"_20482":116245,"_5":14053,"_26831":116175,"_2843":116246},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3355":69246,"_29485":69217,"_20482":116248,"_5":14053,"_26831":116175,"_2843":116249},[],"Dispositivo sin identidad",{"_3355":69247,"_29485":69217,"_20482":116251,"_5":14053,"_26831":116175,"_2843":116252},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3355":69248,"_29485":69217,"_20482":116254,"_5":14053,"_26831":116175,"_2843":116255},[],"Dispositivo retirado",{"_3355":69249,"_29485":69217,"_20482":116257,"_5":14053,"_26831":116175,"_2843":116258},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3355":69250,"_29485":69217,"_20482":116260,"_5":14053,"_26831":116175,"_2843":116261},[],"Timeout, HTTP 500 o fallo de instalación",{"_3355":69251,"_29485":69217,"_20482":116263,"_5":14053,"_26831":116175,"_2843":116264},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3355":69252,"_29485":69217,"_20482":116266,"_5":14053,"_26831":116179,"_2843":116267},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3355":69253,"_29485":69217,"_20482":116269,"_5":14053,"_26831":116179,"_2843":116270},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3355":69254,"_29485":69254,"_5":14411,"_2843":116272,"_29817":116273,"_20482":116274,"_26831":69254},"Diagnóstico de enrolamiento",[47939,114128,50418,115137,115312],[],{"_3355":69255,"_29485":69254,"_20482":116276,"_5":14053,"_26831":69254,"_2843":116277},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3355":69256,"_29485":69254,"_5":29814,"_20482":116279,"_26831":116280,"_2843":116281},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3355":69257,"_29485":69254,"_5":29814,"_20482":116283,"_26831":116284,"_2843":116285},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3355":69258,"_29485":69254,"_5":29814,"_20482":116287,"_26831":116288,"_2843":115844},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3355":69259,"_29485":69254,"_5":29814,"_20482":116290,"_26831":116291,"_2843":116292},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3355":69260,"_29485":69254,"_20482":116294,"_5":14053,"_26831":69254,"_2843":116295},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3355":69261,"_29485":69254,"_20482":116297,"_5":14053,"_26831":116284,"_2843":116298},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3355":69262,"_29485":69254,"_20482":116300,"_5":14053,"_26831":116284,"_2843":116301},[],"Síntoma o mensaje",{"_3355":69263,"_29485":69254,"_20482":116303,"_5":14053,"_26831":116284,"_2843":116304},[],"Qué revisar",{"_3355":69264,"_29485":69254,"_20482":116306,"_5":14053,"_26831":116284,"_2843":116307},[],"curl rechaza TLS, nombre o emisor",{"_3355":69265,"_29485":69254,"_20482":116309,"_5":14053,"_26831":116284,"_2843":116310},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3355":69266,"_29485":69254,"_20482":116312,"_5":14053,"_26831":116284,"_2843":116313},[],"404 o APS ausente",{"_3355":69267,"_29485":69254,"_20482":116315,"_5":14053,"_26831":116284,"_2843":116316},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3355":69268,"_29485":69254,"_20482":116318,"_5":14053,"_26831":116284,"_2843":116319},[],"400, error de CSR o formato",{"_3355":69269,"_29485":69254,"_20482":116321,"_5":14053,"_26831":116284,"_2843":116322},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3355":69270,"_29485":69254,"_20482":116324,"_5":14053,"_26831":116284,"_2843":116325},[],"Credencial ausente o certificado no válido",{"_3355":69271,"_29485":69254,"_20482":116327,"_5":14053,"_26831":116284,"_2843":116328},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3355":69272,"_29485":69254,"_20482":116330,"_5":14053,"_26831":116284,"_2843":116331},[],"Webhook deniega, expira o responde sin autorización",{"_3355":69273,"_29485":69254,"_20482":116333,"_5":14053,"_26831":116284,"_2843":116334},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3355":69274,"_29485":69254,"_20482":116336,"_5":14053,"_26831":116284,"_2843":51663},[],{"_3355":69275,"_29485":69254,"_20482":116338,"_5":14053,"_26831":116284,"_2843":116339},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3355":69276,"_29485":69254,"_20482":116341,"_5":14053,"_26831":116284,"_2843":51669},[],{"_3355":69277,"_29485":69254,"_20482":116343,"_5":14053,"_26831":116284,"_2843":116344},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3355":69278,"_29485":69254,"_20482":116346,"_5":14053,"_26831":116284,"_2843":51675},[],{"_3355":69279,"_29485":69254,"_20482":116348,"_5":14053,"_26831":116284,"_2843":116349},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3355":69280,"_29485":69254,"_20482":116351,"_5":14053,"_26831":116284,"_2843":51681},[],{"_3355":69281,"_29485":69254,"_20482":116353,"_5":14053,"_26831":116284,"_2843":116354},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3355":69282,"_29485":69254,"_20482":116356,"_5":14053,"_26831":116284,"_2843":51687},[],{"_3355":69283,"_29485":69254,"_20482":116358,"_5":14053,"_26831":116284,"_2843":116359},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3355":69284,"_29485":69254,"_20482":116361,"_5":14053,"_26831":116284,"_2843":116362},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3355":69285,"_29485":69254,"_20482":116364,"_5":14053,"_26831":116284,"_2843":116365},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3355":69286,"_29485":69254,"_20482":116367,"_5":14053,"_26831":116284,"_2843":116368},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3355":69287,"_29485":69254,"_20482":116370,"_5":14053,"_26831":116284,"_2843":116371},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3355":69288,"_29485":69254,"_20482":116373,"_5":14053,"_26831":116284,"_2843":51705},[],{"_3355":69289,"_29485":69254,"_20482":116375,"_5":14053,"_26831":116284,"_2843":116376},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3355":69290,"_29485":69254,"_20482":116378,"_5":14053,"_26831":116284,"_2843":51711},[],{"_3355":69291,"_29485":69254,"_20482":116380,"_5":14053,"_26831":116284,"_2843":116381},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3355":69292,"_29485":69254,"_20482":116383,"_5":14053,"_26831":116284,"_2843":116384},[],"DMS propietario distinto",{"_3355":69293,"_29485":69254,"_20482":116386,"_5":14053,"_26831":116284,"_2843":116387},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3355":69294,"_29485":69254,"_20482":116389,"_5":14053,"_26831":116284,"_2843":51723},[],{"_3355":69295,"_29485":69254,"_20482":116391,"_5":14053,"_26831":116284,"_2843":116392},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3355":69296,"_29485":69254,"_20482":116394,"_5":14053,"_26831":116284,"_2843":51729},[],{"_3355":69297,"_29485":69254,"_20482":116396,"_5":14053,"_26831":116284,"_2843":116397},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3355":69298,"_29485":69254,"_20482":116399,"_5":14053,"_26831":116284,"_2843":116400},[],"Certificado actual revocado",{"_3355":69299,"_29485":69254,"_20482":116402,"_5":14053,"_26831":116284,"_2843":116403},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3355":69300,"_29485":69254,"_20482":116405,"_5":14053,"_26831":116284,"_2843":116406},[],"Error de CA, perfil o firma",{"_3355":69301,"_29485":69254,"_20482":116408,"_5":14053,"_26831":116284,"_2843":116409},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3355":69302,"_29485":69254,"_20482":116411,"_5":14053,"_26831":116284,"_2843":116412},[],"HTTP 200 sin conexión del dispositivo",{"_3355":69303,"_29485":69254,"_20482":116414,"_5":14053,"_26831":116284,"_2843":116415},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3355":69304,"_29485":69254,"_20482":116417,"_5":14053,"_26831":116284,"_2843":116418},[],"Timeout o error después de emitir",{"_3355":69305,"_29485":69254,"_20482":116420,"_5":14053,"_26831":116284,"_2843":116421},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3355":69306,"_29485":69254,"_20482":116423,"_5":14053,"_26831":116288,"_2843":116424},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3355":69307,"_29485":69254,"_20482":116426,"_5":14053,"_26831":116288,"_2843":116427},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3355":69308,"_29485":69254,"_20482":116429,"_5":14053,"_26831":116291,"_2843":116430},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3355":69309,"_29485":69254,"_20482":116432,"_5":14053,"_26831":116291,"_2843":116433},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3355":69310,"_29485":69254,"_20482":116435,"_5":14053,"_26831":116291,"_2843":116436},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3355":69311,"_29485":69254,"_20482":116438,"_5":14053,"_26831":116291,"_2843":116439},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3355":69312,"_29485":69254,"_20482":116441,"_5":14053,"_26831":116291,"_2843":116442},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3355":69313,"_29485":69254,"_20482":116444,"_5":14053,"_26831":116291,"_2843":116445},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3355":69314,"_29485":69254,"_20482":116447,"_5":14053,"_26831":116291,"_2843":116448},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3355":69315,"_29485":69315,"_5":14411,"_2843":116450,"_29817":116451,"_20482":116452,"_26831":69315},"Distribución y actualización de confianza",[47939,114128,50418,115137,115312],[],{"_3355":69316,"_29485":69315,"_20482":116454,"_5":14053,"_26831":69315,"_2843":116455},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3355":69317,"_29485":69315,"_5":29814,"_20482":116457,"_26831":116458,"_2843":116459},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3355":69318,"_29485":69315,"_5":29814,"_20482":116461,"_26831":116462,"_2843":116463},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3355":69319,"_29485":69315,"_5":29814,"_20482":116465,"_26831":116466,"_2843":116467},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3355":69320,"_29485":69315,"_5":29814,"_20482":116469,"_26831":116470,"_2843":116471},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3355":69321,"_29485":69315,"_5":29814,"_20482":116473,"_26831":116474,"_2843":116475},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3355":69322,"_29485":69315,"_20482":116477,"_5":14053,"_26831":69315,"_2843":116478},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3355":69323,"_29485":69315,"_20482":116480,"_5":14053,"_26831":116458,"_2843":116481},[],"Relación",{"_3355":69324,"_29485":69315,"_20482":116483,"_5":14053,"_26831":116458,"_2843":116484},[],"Material que prepara el responsable",{"_3355":69325,"_29485":69315,"_20482":116486,"_5":14053,"_26831":116458,"_2843":116487},[],"Dispositivo → servidor EST",{"_3355":69326,"_29485":69315,"_20482":116489,"_5":14053,"_26831":116458,"_2843":116490},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3355":69327,"_29485":69315,"_20482":116492,"_5":14053,"_26831":116458,"_2843":116493},[],"DMS → solicitante",{"_3355":69328,"_29485":69315,"_20482":116495,"_5":14053,"_26831":116458,"_2843":116496},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3355":69329,"_29485":69315,"_20482":116498,"_5":14053,"_26831":116458,"_2843":116499},[],"Consumidor → dispositivo",{"_3355":69330,"_29485":69315,"_20482":116501,"_5":14053,"_26831":116458,"_2843":116502},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3355":69331,"_29485":69315,"_20482":116504,"_5":14053,"_26831":116458,"_2843":116505},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3355":69332,"_29485":69315,"_20482":116507,"_5":14053,"_26831":116462,"_2843":116508},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3355":69333,"_29485":69315,"_20482":116510,"_5":14053,"_26831":116462,"_2843":116511},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3355":69334,"_29485":69315,"_20482":116513,"_5":14053,"_26831":116466,"_2843":116514},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3355":69335,"_29485":69315,"_20482":116516,"_5":14053,"_26831":116466,"_2843":116517},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3355":69336,"_29485":69315,"_20482":116519,"_5":14053,"_26831":116466,"_2843":116520},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3355":69337,"_29485":69315,"_20482":116522,"_5":14053,"_26831":116466,"_2843":116523},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3355":69338,"_29485":69315,"_20482":116525,"_5":14053,"_26831":116466,"_2843":116526},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3355":69339,"_29485":69315,"_20482":116528,"_5":14053,"_26831":116466,"_2843":116529},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3355":69340,"_29485":69315,"_20482":116531,"_5":14053,"_26831":116470,"_2843":116532},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3355":69341,"_29485":69315,"_20482":116534,"_5":14053,"_26831":116470,"_2843":116535},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3355":69342,"_29485":69315,"_20482":116537,"_5":14053,"_26831":116470,"_2843":116538},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3355":69343,"_29485":69315,"_20482":116540,"_5":14053,"_26831":116474,"_2843":116541},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3355":69344,"_29485":69344,"_5":14411,"_2843":51878,"_29817":116543,"_20482":116545,"_26831":69344},[47939,114128,50418,115137,116544],"Integraciones",[],{"_3355":69345,"_29485":69344,"_20482":116547,"_5":14053,"_26831":69344,"_2843":116548},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3355":69346,"_29485":69344,"_5":29814,"_20482":116550,"_26831":116551,"_2843":116552},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3355":69347,"_29485":69344,"_5":29814,"_20482":116554,"_26831":116555,"_2843":116556},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3355":69348,"_29485":69344,"_5":29814,"_20482":116558,"_26831":116559,"_2843":116560},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3355":69349,"_29485":69344,"_5":29814,"_20482":116562,"_26831":116563,"_2843":116564},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3355":69350,"_29485":69344,"_5":29814,"_20482":116566,"_26831":116567,"_2843":116568},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#máquina-de-estados-de-los-recursos","Máquina de estados de los recursos",{"_3355":69351,"_29485":69344,"_5":29814,"_20482":116570,"_26831":116571,"_2843":116572},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#eventos-que-gestiona-el-conector","Eventos que gestiona el conector",{"_3355":69352,"_29485":69344,"_5":29814,"_20482":116574,"_26831":116575,"_2843":116576},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3355":69353,"_29485":69344,"_5":29814,"_20482":116578,"_26831":116579,"_2843":116580},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3355":69354,"_29485":69344,"_5":29814,"_20482":116582,"_26831":116583,"_2843":116584},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3355":69355,"_29485":69344,"_5":29814,"_20482":116586,"_26831":116587,"_2843":116588},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3355":69356,"_29485":69344,"_5":29814,"_20482":116590,"_26831":116591,"_2843":116592},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3355":69357,"_29485":69344,"_5":29814,"_20482":116594,"_26831":116595,"_2843":116596},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3355":69358,"_29485":69344,"_5":29814,"_20482":116598,"_26831":116599,"_2843":51936},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3355":69359,"_29485":69344,"_5":29814,"_20482":116601,"_26831":116602,"_2843":51940},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3355":69360,"_29485":69344,"_5":29814,"_20482":116604,"_26831":116605,"_2843":116606},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3355":69361,"_29485":69344,"_5":29814,"_20482":116608,"_26831":116609,"_2843":116610},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3355":69362,"_29485":69344,"_5":29814,"_20482":116612,"_26831":116613,"_2843":116614},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3355":69363,"_29485":69344,"_5":29814,"_20482":116616,"_26831":116617,"_2843":116618},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3355":69364,"_29485":69344,"_5":29814,"_20482":116620,"_26831":116621,"_2843":116622},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3355":69365,"_29485":69344,"_5":29814,"_20482":116624,"_26831":116625,"_2843":116626},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3355":69366,"_29485":69344,"_5":29814,"_20482":116628,"_26831":116629,"_2843":116630},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3355":69367,"_29485":69344,"_5":29814,"_20482":116632,"_26831":116633,"_2843":116634},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3355":69368,"_29485":69344,"_5":29814,"_20482":116636,"_26831":116637,"_2843":116638},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3355":69369,"_29485":69344,"_5":29814,"_20482":116640,"_26831":116641,"_2843":116642},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3355":69370,"_29485":69344,"_5":29814,"_20482":116644,"_26831":116645,"_2843":116646},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3355":69371,"_29485":69344,"_5":29814,"_20482":116648,"_26831":116649,"_2843":116650},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3355":69372,"_29485":69344,"_20482":116652,"_5":14053,"_26831":69344,"_2843":116653},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3355":69373,"_29485":69344,"_20482":116655,"_5":14053,"_26831":69344,"_2843":116656},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3355":69374,"_29485":69344,"_20482":116658,"_5":14053,"_26831":69344,"_2843":116659},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3355":69375,"_29485":69344,"_20482":116661,"_5":14053,"_26831":116551,"_2843":116662},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3355":69376,"_29485":69344,"_20482":116664,"_5":14053,"_26831":116551,"_2843":116665},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3355":69377,"_29485":69344,"_20482":116667,"_5":14053,"_26831":116551,"_2843":116668},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3355":69378,"_29485":69344,"_20482":116670,"_5":14053,"_26831":116551,"_2843":116671},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3355":69379,"_29485":69344,"_20482":116673,"_5":14053,"_26831":116555,"_2843":116674},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3355":69380,"_29485":69344,"_20482":116676,"_5":14053,"_26831":116559,"_2843":116677},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3355":69381,"_29485":69344,"_20482":116679,"_5":14053,"_26831":116559,"_2843":116680},[],"Acción IAM",{"_3355":69382,"_29485":69344,"_20482":116682,"_5":14053,"_26831":116559,"_2843":113076},[],{"_3355":69383,"_29485":69344,"_20482":116684,"_5":14053,"_26831":116559,"_2843":52023},[],{"_3355":69384,"_29485":69344,"_20482":116686,"_5":14053,"_26831":116559,"_2843":116687},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3355":69385,"_29485":69344,"_20482":116689,"_5":14053,"_26831":116559,"_2843":52029},[],{"_3355":69386,"_29485":69344,"_20482":116691,"_5":14053,"_26831":116559,"_2843":116692},[],"Registrar la CA en AWS IoT",{"_3355":69387,"_29485":69344,"_20482":116694,"_5":14053,"_26831":116559,"_2843":52035},[],{"_3355":69388,"_29485":69344,"_20482":116696,"_5":14053,"_26831":116559,"_2843":116697},[],"Consultar el estado del registro de la CA",{"_3355":69389,"_29485":69344,"_20482":116699,"_5":14053,"_26831":116559,"_2843":52041},[],{"_3355":69390,"_29485":69344,"_20482":116701,"_5":14053,"_26831":116559,"_2843":116702},[],"Crear o actualizar Things en IoT Core",{"_3355":69391,"_29485":69344,"_20482":116704,"_5":14053,"_26831":116559,"_2843":52047},[],{"_3355":69392,"_29485":69344,"_20482":116706,"_5":14053,"_26831":116559,"_2843":116707},[],"Aprovisionar Things mediante plantilla",{"_3355":69393,"_29485":69344,"_20482":116709,"_5":14053,"_26831":116559,"_2843":52053},[],{"_3355":69394,"_29485":69344,"_20482":116711,"_5":14053,"_26831":116559,"_2843":116712},[],"Registrar certificados de dispositivo",{"_3355":69395,"_29485":69344,"_20482":116714,"_5":14053,"_26831":116559,"_2843":52059},[],{"_3355":69396,"_29485":69344,"_20482":116716,"_5":14053,"_26831":116559,"_2843":116717},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3355":69397,"_29485":69344,"_20482":116719,"_5":14053,"_26831":116559,"_2843":52065},[],{"_3355":69398,"_29485":69344,"_20482":116721,"_5":14053,"_26831":116559,"_2843":116722},[],"Crear y adjuntar políticas IoT",{"_3355":69399,"_29485":69344,"_20482":116724,"_5":14053,"_26831":116559,"_2843":52071},[],{"_3355":69400,"_29485":69344,"_20482":116726,"_5":14053,"_26831":116559,"_2843":116727},[],"Gestionar grupos de Things",{"_3355":69401,"_29485":69344,"_20482":116729,"_5":14053,"_26831":116559,"_2843":52077},[],{"_3355":69402,"_29485":69344,"_20482":116731,"_5":14053,"_26831":116559,"_2843":116732},[],"Crear plantillas JITP",{"_3355":69403,"_29485":69344,"_20482":116734,"_5":14053,"_26831":116559,"_2843":52083},[],{"_3355":69404,"_29485":69344,"_20482":116736,"_5":14053,"_26831":116559,"_2843":116737},[],"Leer y escribir el Device Shadow",{"_3355":69405,"_29485":69344,"_20482":116739,"_5":14053,"_26831":116559,"_2843":116740},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3355":69406,"_29485":69344,"_20482":116742,"_5":14053,"_26831":116563,"_2843":116743},[],"Parámetro",{"_3355":69407,"_29485":69344,"_20482":116745,"_5":14053,"_26831":116563,"_2843":116746},[],"Tipo",{"_3355":69408,"_29485":69344,"_20482":116748,"_5":14053,"_26831":116563,"_2843":116749},[],"Requerido",{"_3355":69409,"_29485":69344,"_20482":116751,"_5":14053,"_26831":116563,"_2843":116752},[],"Descripción",{"_3355":69410,"_29485":69344,"_20482":116754,"_5":14053,"_26831":116563,"_2843":52104},[],{"_3355":69411,"_29485":69344,"_20482":116756,"_5":14053,"_26831":116563,"_2843":24474},[],{"_3355":69412,"_29485":69344,"_20482":116758,"_5":14053,"_26831":116563,"_2843":116759},[],"Sí",{"_3355":69413,"_29485":69344,"_20482":116761,"_5":14053,"_26831":116563,"_2843":116762},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3355":69414,"_29485":69344,"_20482":116764,"_5":14053,"_26831":116563,"_2843":52115},[],{"_3355":69415,"_29485":69344,"_20482":116766,"_5":14053,"_26831":116563,"_2843":24474},[],{"_3355":69416,"_29485":69344,"_20482":116768,"_5":14053,"_26831":116563,"_2843":116759},[],{"_3355":69417,"_29485":69344,"_20482":116770,"_5":14053,"_26831":116563,"_2843":116771},[],"Región AWS donde opera el conector.",{"_3355":69418,"_29485":69344,"_20482":116773,"_5":14053,"_26831":116563,"_2843":52125},[],{"_3355":69419,"_29485":69344,"_20482":116775,"_5":14053,"_26831":116563,"_2843":24474},[],{"_3355":69420,"_29485":69344,"_20482":116777,"_5":14053,"_26831":116563,"_2843":116759},[],{"_3355":69421,"_29485":69344,"_20482":116779,"_5":14053,"_26831":116563,"_2843":116780},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3355":69422,"_29485":69344,"_20482":116782,"_5":14053,"_26831":116563,"_2843":52135},[],{"_3355":69423,"_29485":69344,"_20482":116784,"_5":14053,"_26831":116563,"_2843":24474},[],{"_3355":69424,"_29485":69344,"_20482":116786,"_5":14053,"_26831":116563,"_2843":116787},[],"Solo con `auth_method=static`",{"_3355":69425,"_29485":69344,"_20482":116789,"_5":14053,"_26831":116563,"_2843":116790},[],"Clave de acceso AWS.",{"_3355":69426,"_29485":69344,"_20482":116792,"_5":14053,"_26831":116563,"_2843":52146},[],{"_3355":69427,"_29485":69344,"_20482":116794,"_5":14053,"_26831":116563,"_2843":24474},[],{"_3355":69428,"_29485":69344,"_20482":116796,"_5":14053,"_26831":116563,"_2843":116787},[],{"_3355":69429,"_29485":69344,"_20482":116798,"_5":14053,"_26831":116563,"_2843":116799},[],"Clave secreta AWS.",{"_3355":69430,"_29485":69344,"_20482":116801,"_5":14053,"_26831":116563,"_2843":52156},[],{"_3355":69431,"_29485":69344,"_20482":116803,"_5":14053,"_26831":116563,"_2843":24474},[],{"_3355":69432,"_29485":69344,"_20482":116805,"_5":14053,"_26831":116563,"_2843":52161},[],{"_3355":69433,"_29485":69344,"_20482":116807,"_5":14053,"_26831":116563,"_2843":116808},[],"Token de sesión (con `auth_method=static`).",{"_3355":69434,"_29485":69344,"_20482":116810,"_5":14053,"_26831":116563,"_2843":52167},[],{"_3355":69435,"_29485":69344,"_20482":116812,"_5":14053,"_26831":116563,"_2843":24474},[],{"_3355":69436,"_29485":69344,"_20482":116814,"_5":14053,"_26831":116563,"_2843":116815},[],"Solo con `auth_method=role`",{"_3355":69437,"_29485":69344,"_20482":116817,"_5":14053,"_26831":116563,"_2843":116818},[],"ARN del rol a asumir.",{"_3355":69438,"_29485":69344,"_20482":116820,"_5":14053,"_26831":116563,"_2843":52178},[],{"_3355":69439,"_29485":69344,"_20482":116822,"_5":14053,"_26831":116563,"_2843":24474},[],{"_3355":69440,"_29485":69344,"_20482":116824,"_5":14053,"_26831":116563,"_2843":52161},[],{"_3355":69441,"_29485":69344,"_20482":116826,"_5":14053,"_26831":116563,"_2843":116827},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3355":69442,"_29485":69344,"_20482":116829,"_5":14053,"_26831":116563,"_2843":52188},[],{"_3355":69443,"_29485":69344,"_20482":116831,"_5":14053,"_26831":116563,"_2843":17254},[],{"_3355":69444,"_29485":69344,"_20482":116833,"_5":14053,"_26831":116563,"_2843":116759},[],{"_3355":69445,"_29485":69344,"_20482":116835,"_5":14053,"_26831":116563,"_2843":116836},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3355":69446,"_29485":69344,"_20482":116838,"_5":14053,"_26831":116563,"_2843":52198},[],{"_3355":69447,"_29485":69344,"_20482":116840,"_5":14053,"_26831":116563,"_2843":24474},[],{"_3355":69448,"_29485":69344,"_20482":116842,"_5":14053,"_26831":116563,"_2843":116759},[],{"_3355":69449,"_29485":69344,"_20482":116844,"_5":14053,"_26831":116563,"_2843":116845},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3355":69450,"_29485":69344,"_20482":116847,"_5":14053,"_26831":116563,"_2843":52208},[],{"_3355":69451,"_29485":69344,"_20482":116849,"_5":14053,"_26831":116563,"_2843":24474},[],{"_3355":69452,"_29485":69344,"_20482":116851,"_5":14053,"_26831":116563,"_2843":116759},[],{"_3355":69453,"_29485":69344,"_20482":116853,"_5":14053,"_26831":116563,"_2843":116854},[],"URL HTTP del Device Manager de Lamassu.",{"_3355":69454,"_29485":69344,"_20482":116856,"_5":14053,"_26831":116563,"_2843":52218},[],{"_3355":69455,"_29485":69344,"_20482":116858,"_5":14053,"_26831":116563,"_2843":24474},[],{"_3355":69456,"_29485":69344,"_20482":116860,"_5":14053,"_26831":116563,"_2843":116759},[],{"_3355":69457,"_29485":69344,"_20482":116862,"_5":14053,"_26831":116563,"_2843":116863},[],"URL HTTP del servicio de CA de Lamassu.",{"_3355":69458,"_29485":69344,"_20482":116865,"_5":14053,"_26831":116567,"_2843":116866},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada transición. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3355":69459,"_29485":69344,"_20482":116868,"_5":14053,"_26831":116571,"_2843":116869},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3355":69460,"_29485":69344,"_20482":116871,"_5":14053,"_26831":116571,"_2843":116872},[],"Tipo de CloudEvent",{"_3355":69461,"_29485":69344,"_20482":116874,"_5":14053,"_26831":116571,"_2843":116875},[],"Recurso en Lamassu",{"_3355":69462,"_29485":69344,"_20482":116877,"_5":14053,"_26831":116571,"_2843":116878},[],"Recurso AWS",{"_3355":69463,"_29485":69344,"_20482":116880,"_5":14053,"_26831":116571,"_2843":116881},[],"Acciones IAM",{"_3355":69464,"_29485":69344,"_20482":116883,"_5":14053,"_26831":116571,"_2843":116884},[],"Llamadas AWS y efecto",{"_3355":69465,"_29485":69344,"_20482":116886,"_5":14053,"_26831":116571,"_2843":116887},[],"Dónde en esta página",{"_3355":69466,"_29485":69344,"_20482":116889,"_5":14053,"_26831":116571,"_2843":52252},[],{"_3355":69467,"_29485":69344,"_20482":116891,"_5":14053,"_26831":116571,"_2843":52255},[],{"_3355":69468,"_29485":69344,"_20482":116893,"_5":14053,"_26831":116571,"_2843":52258},[],{"_3355":69469,"_29485":69344,"_20482":116895,"_5":14053,"_26831":116571,"_2843":52261},[],{"_3355":69470,"_29485":69344,"_20482":116897,"_5":14053,"_26831":116571,"_2843":116898},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3355":69471,"_29485":69344,"_20482":116900,"_5":14053,"_26831":116571,"_2843":116576},[],{"_3355":69472,"_29485":69344,"_20482":116902,"_5":14053,"_26831":116571,"_2843":52269},[],{"_3355":69473,"_29485":69344,"_20482":116904,"_5":14053,"_26831":116571,"_2843":52272},[],{"_3355":69474,"_29485":69344,"_20482":116906,"_5":14053,"_26831":116571,"_2843":52275},[],{"_3355":69475,"_29485":69344,"_20482":116908,"_5":14053,"_26831":116571,"_2843":52278},[],{"_3355":69476,"_29485":69344,"_20482":116910,"_5":14053,"_26831":116571,"_2843":116911},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3355":69477,"_29485":69344,"_20482":116913,"_5":14053,"_26831":116571,"_2843":116580},[],{"_3355":69478,"_29485":69344,"_20482":116915,"_5":14053,"_26831":116571,"_2843":52286},[],{"_3355":69479,"_29485":69344,"_20482":116917,"_5":14053,"_26831":116571,"_2843":116918},[],"Dispositivo",{"_3355":69480,"_29485":69344,"_20482":116920,"_5":14053,"_26831":116571,"_2843":52292},[],{"_3355":69481,"_29485":69344,"_20482":116922,"_5":14053,"_26831":116571,"_2843":52295},[],{"_3355":69482,"_29485":69344,"_20482":116924,"_5":14053,"_26831":116571,"_2843":116925},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3355":69483,"_29485":69344,"_20482":116927,"_5":14053,"_26831":116571,"_2843":116588},[],{"_3355":69484,"_29485":69344,"_20482":116929,"_5":14053,"_26831":116571,"_2843":52303},[],{"_3355":69485,"_29485":69344,"_20482":116931,"_5":14053,"_26831":116571,"_2843":116932},[],"Certificado",{"_3355":69486,"_29485":69344,"_20482":116934,"_5":14053,"_26831":116571,"_2843":52309},[],{"_3355":69487,"_29485":69344,"_20482":116936,"_5":14053,"_26831":116571,"_2843":116937},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3355":69488,"_29485":69344,"_20482":116939,"_5":14053,"_26831":116571,"_2843":116940},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3355":69489,"_29485":69344,"_20482":116942,"_5":14053,"_26831":116571,"_2843":116584},[],{"_3355":69490,"_29485":69344,"_20482":116944,"_5":14053,"_26831":116571,"_2843":52320},[],{"_3355":69491,"_29485":69344,"_20482":116946,"_5":14053,"_26831":116571,"_2843":116947},[],"Certificado / Dispositivo",{"_3355":69492,"_29485":69344,"_20482":116949,"_5":14053,"_26831":116571,"_2843":52326},[],{"_3355":69493,"_29485":69344,"_20482":116951,"_5":14053,"_26831":116571,"_2843":48335},[],{"_3355":69494,"_29485":69344,"_20482":116953,"_5":14053,"_26831":116571,"_2843":116954},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3355":69495,"_29485":69344,"_20482":116956,"_5":14053,"_26831":116571,"_2843":116638},[],{"_3355":69496,"_29485":69344,"_20482":116958,"_5":14053,"_26831":116575,"_2843":116959},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3355":69497,"_29485":69344,"_20482":116961,"_5":14053,"_26831":116575,"_2843":116962},[],"por el campo `registration.status` de los metadatos del conector en la CA:",{"_3355":69498,"_29485":69344,"_20482":116964,"_5":14053,"_26831":116575,"_2843":116965},[],"Transición",{"_3355":69499,"_29485":69344,"_20482":116967,"_5":14053,"_26831":116575,"_2843":116968},[],"Llamadas AWS",{"_3355":69500,"_29485":69344,"_20482":116970,"_5":14053,"_26831":116575,"_2843":116971},[],"`NoRegistrada` → `Solicitada`",{"_3355":69501,"_29485":69344,"_20482":116973,"_5":14053,"_26831":116575,"_2843":116974},[],"ninguna (solo escritura de metadatos)",{"_3355":69502,"_29485":69344,"_20482":116976,"_5":14053,"_26831":116575,"_2843":116977},[],"`Solicitada` → `Registrando`",{"_3355":69503,"_29485":69344,"_20482":116979,"_5":14053,"_26831":116575,"_2843":116980},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3355":69504,"_29485":69344,"_20482":116982,"_5":14053,"_26831":116575,"_2843":116983},[],"`Registrando` → `Completada`",{"_3355":69505,"_29485":69344,"_20482":116985,"_5":14053,"_26831":116575,"_2843":116986},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3355":69506,"_29485":69344,"_20482":116988,"_5":14053,"_26831":116575,"_2843":116989},[],"`Registrando` → `Fallida`",{"_3355":69507,"_29485":69344,"_20482":116991,"_5":14053,"_26831":116575,"_2843":116992},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3355":69508,"_29485":69344,"_20482":116994,"_5":14053,"_26831":116575,"_2843":116995},[],"`Fallida` / `Completada` → `Solicitada`",{"_3355":69509,"_29485":69344,"_20482":116997,"_5":14053,"_26831":116575,"_2843":116998},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3355":69510,"_29485":69344,"_20482":117000,"_5":14053,"_26831":116579,"_2843":117001},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3355":69511,"_29485":69344,"_20482":117003,"_5":14053,"_26831":116579,"_2843":116965},[],{"_3355":69512,"_29485":69344,"_20482":117005,"_5":14053,"_26831":116579,"_2843":116968},[],{"_3355":69513,"_29485":69344,"_20482":117007,"_5":14053,"_26831":116579,"_2843":117008},[],"`SinConfigurar` → `None` / `Auto`",{"_3355":69514,"_29485":69344,"_20482":117010,"_5":14053,"_26831":116579,"_2843":117011},[],"ninguna (solo configuración)",{"_3355":69515,"_29485":69344,"_20482":117013,"_5":14053,"_26831":116579,"_2843":52391},[],{"_3355":69516,"_29485":69344,"_20482":117015,"_5":14053,"_26831":116579,"_2843":117011},[],{"_3355":69517,"_29485":69344,"_20482":117017,"_5":14053,"_26831":116579,"_2843":117018},[],"Cualquiera → `Jitp`",{"_3355":69518,"_29485":69344,"_20482":117020,"_5":14053,"_26831":116579,"_2843":117021},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3355":69519,"_29485":69344,"_20482":117023,"_5":14053,"_26831":116579,"_2843":52402},[],{"_3355":69520,"_29485":69344,"_20482":117025,"_5":14053,"_26831":116579,"_2843":117026},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3355":69521,"_29485":69344,"_20482":117028,"_5":14053,"_26831":116583,"_2843":117029},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3355":69522,"_29485":69344,"_20482":117031,"_5":14053,"_26831":116583,"_2843":116965},[],{"_3355":69523,"_29485":69344,"_20482":117033,"_5":14053,"_26831":116583,"_2843":116968},[],{"_3355":69524,"_29485":69344,"_20482":117035,"_5":14053,"_26831":116583,"_2843":117036},[],"`NoSincronizado` → `Active`",{"_3355":69525,"_29485":69344,"_20482":117038,"_5":14053,"_26831":116583,"_2843":52059},[],{"_3355":69526,"_29485":69344,"_20482":117040,"_5":14053,"_26831":116583,"_2843":52420},[],{"_3355":69527,"_29485":69344,"_20482":117042,"_5":14053,"_26831":116583,"_2843":117043},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3355":69528,"_29485":69344,"_20482":117045,"_5":14053,"_26831":116583,"_2843":52426},[],{"_3355":69529,"_29485":69344,"_20482":117047,"_5":14053,"_26831":116583,"_2843":117043},[],{"_3355":69530,"_29485":69344,"_20482":117049,"_5":14053,"_26831":116583,"_2843":52431},[],{"_3355":69531,"_29485":69344,"_20482":117051,"_5":14053,"_26831":116583,"_2843":52059},[],{"_3355":69532,"_29485":69344,"_20482":117053,"_5":14053,"_26831":116583,"_2843":52436},[],{"_3355":69533,"_29485":69344,"_20482":117055,"_5":14053,"_26831":116583,"_2843":117056},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3355":69534,"_29485":69344,"_20482":117058,"_5":14053,"_26831":116587,"_2843":117059},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3355":69535,"_29485":69344,"_20482":117061,"_5":14053,"_26831":116587,"_2843":116965},[],{"_3355":69536,"_29485":69344,"_20482":117063,"_5":14053,"_26831":116587,"_2843":116968},[],{"_3355":69537,"_29485":69344,"_20482":117065,"_5":14053,"_26831":116587,"_2843":117066},[],"`Ausente` → `Aprovisionado`",{"_3355":69538,"_29485":69344,"_20482":117068,"_5":14053,"_26831":116587,"_2843":117069},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3355":69539,"_29485":69344,"_20482":117071,"_5":14053,"_26831":116587,"_2843":117072},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3355":69540,"_29485":69344,"_20482":117074,"_5":14053,"_26831":116587,"_2843":117075},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3355":69541,"_29485":69344,"_20482":117077,"_5":14053,"_26831":116587,"_2843":117078},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3355":69542,"_29485":69344,"_20482":117080,"_5":14053,"_26831":116591,"_2843":117081},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3355":69543,"_29485":69344,"_20482":117083,"_5":14053,"_26831":116595,"_2843":117084},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3355":69544,"_29485":69344,"_20482":117086,"_5":14053,"_26831":116595,"_2843":117087},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3355":69545,"_29485":69344,"_20482":117089,"_5":14053,"_26831":116599,"_2843":117090},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3355":69546,"_29485":69344,"_20482":117092,"_5":14053,"_26831":116599,"_2843":117093},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3355":69547,"_29485":69344,"_20482":117095,"_5":14053,"_26831":116599,"_2843":117096},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3355":69548,"_29485":69344,"_20482":117098,"_5":14053,"_26831":116599,"_2843":117099},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3355":69549,"_29485":69344,"_20482":117101,"_5":14053,"_26831":116599,"_2843":117102},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3355":69550,"_29485":69344,"_20482":117104,"_5":14053,"_26831":116599,"_2843":117105},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3355":69551,"_29485":69344,"_20482":117107,"_5":14053,"_26831":116602,"_2843":117108},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3355":69552,"_29485":69344,"_20482":117110,"_5":14053,"_26831":116605,"_2843":117111},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3355":69553,"_29485":69344,"_20482":117113,"_5":14053,"_26831":116605,"_2843":117114},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3355":69554,"_29485":69344,"_20482":117116,"_5":14053,"_26831":116609,"_2843":117117},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3355":69555,"_29485":69344,"_20482":117119,"_5":14053,"_26831":116613,"_2843":117120},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3355":69556,"_29485":69344,"_20482":117122,"_5":14053,"_26831":116613,"_2843":117123},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3355":69557,"_29485":69344,"_20482":117125,"_5":14053,"_26831":116613,"_2843":117126},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3355":69558,"_29485":69344,"_20482":117128,"_5":14053,"_26831":116613,"_2843":117129},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3355":69559,"_29485":69344,"_20482":117131,"_5":14053,"_26831":116613,"_2843":117132},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3355":69560,"_29485":69344,"_20482":117134,"_5":14053,"_26831":116613,"_2843":117135},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3355":69561,"_29485":69344,"_20482":117137,"_5":14053,"_26831":116617,"_2843":117138},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3355":69562,"_29485":69344,"_20482":117140,"_5":14053,"_26831":116617,"_2843":117141},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3355":69563,"_29485":69344,"_20482":117143,"_5":14053,"_26831":116617,"_2843":117144},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3355":69564,"_29485":69344,"_20482":117146,"_5":14053,"_26831":116617,"_2843":117147},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3355":69565,"_29485":69344,"_20482":117149,"_5":14053,"_26831":116617,"_2843":117150},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3355":69566,"_29485":69344,"_20482":117152,"_5":14053,"_26831":116621,"_2843":117153},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3355":69567,"_29485":69344,"_20482":117155,"_5":14053,"_26831":116621,"_2843":117156},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3355":69568,"_29485":69344,"_20482":117158,"_5":14053,"_26831":116621,"_2843":117159},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3355":69569,"_29485":69344,"_20482":117161,"_5":14053,"_26831":116625,"_2843":117162},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3355":69570,"_29485":69344,"_20482":117164,"_5":14053,"_26831":116625,"_2843":117165},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3355":69571,"_29485":69344,"_20482":117167,"_5":14053,"_26831":116625,"_2843":117168},[],"Para que el flujo JITP funcione correctamente:",{"_3355":69572,"_29485":69344,"_20482":117170,"_5":14053,"_26831":116625,"_2843":117171},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3355":69573,"_29485":69344,"_20482":117173,"_5":14053,"_26831":116625,"_2843":117174},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3355":69574,"_29485":69344,"_20482":117176,"_5":14053,"_26831":116625,"_2843":117177},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3355":69575,"_29485":69344,"_20482":117179,"_5":14053,"_26831":116625,"_2843":117180},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3355":69576,"_29485":69344,"_20482":117182,"_5":14053,"_26831":116629,"_2843":117183},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3355":69577,"_29485":69344,"_20482":117185,"_5":14053,"_26831":116629,"_2843":117186},[],"Estado en Lamassu",{"_3355":69578,"_29485":69344,"_20482":117188,"_5":14053,"_26831":116629,"_2843":117189},[],"Razón de revocación",{"_3355":69579,"_29485":69344,"_20482":117191,"_5":14053,"_26831":116629,"_2843":117192},[],"Estado en AWS IoT Core",{"_3355":69580,"_29485":69344,"_20482":117194,"_5":14053,"_26831":116629,"_2843":52581},[],{"_3355":69581,"_29485":69344,"_20482":117196,"_5":14053,"_26831":116629,"_2843":117197},[],"Ninguna",{"_3355":69582,"_29485":69344,"_20482":117199,"_5":14053,"_26831":116629,"_2843":52587},[],{"_3355":69583,"_29485":69344,"_20482":117201,"_5":14053,"_26831":116629,"_2843":52590},[],{"_3355":69584,"_29485":69344,"_20482":117203,"_5":14053,"_26831":116629,"_2843":52593},[],{"_3355":69585,"_29485":69344,"_20482":117205,"_5":14053,"_26831":116629,"_2843":52596},[],{"_3355":69586,"_29485":69344,"_20482":117207,"_5":14053,"_26831":116629,"_2843":52590},[],{"_3355":69587,"_29485":69344,"_20482":117209,"_5":14053,"_26831":116629,"_2843":117210},[],"Cualquier otra razón",{"_3355":69588,"_29485":69344,"_20482":117212,"_5":14053,"_26831":116629,"_2843":52604},[],{"_3355":69589,"_29485":69344,"_20482":117214,"_5":14053,"_26831":116629,"_2843":117215},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3355":69590,"_29485":69344,"_20482":117217,"_5":14053,"_26831":116633,"_2843":117218},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3355":69591,"_29485":69344,"_20482":117220,"_5":14053,"_26831":116633,"_2843":117221},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3355":69592,"_29485":69344,"_20482":117223,"_5":14053,"_26831":116633,"_2843":117224},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3355":69593,"_29485":69344,"_20482":117226,"_5":14053,"_26831":116637,"_2843":117227},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3355":69594,"_29485":69344,"_20482":117229,"_5":14053,"_26831":116637,"_2843":117230},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3355":69595,"_29485":69344,"_20482":117232,"_5":14053,"_26831":116641,"_2843":117233},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3355":69596,"_29485":69344,"_20482":117235,"_5":14053,"_26831":116641,"_2843":117236},[],"Existen dos tipos de acciones:",{"_3355":69597,"_29485":69344,"_20482":117238,"_5":14053,"_26831":116641,"_2843":117239},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3355":69598,"_29485":69344,"_20482":117241,"_5":14053,"_26831":116641,"_2843":117242},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3355":69599,"_29485":69344,"_20482":117244,"_5":14053,"_26831":116641,"_2843":117245},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3355":69600,"_29485":69344,"_20482":117247,"_5":14053,"_26831":116645,"_2843":117248},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3355":69601,"_29485":69344,"_20482":117250,"_5":14053,"_26831":116645,"_2843":117251},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3355":69602,"_29485":69344,"_20482":117253,"_5":14053,"_26831":116645,"_2843":117254},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3355":69603,"_29485":69344,"_20482":117256,"_5":14053,"_26831":116649,"_2843":117257},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3355":69604,"_29485":69344,"_20482":117259,"_5":14053,"_26831":116649,"_2843":117260},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3355":69605,"_29485":69344,"_20482":117262,"_5":14053,"_26831":116649,"_2843":117263},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3355":69606,"_29485":69344,"_20482":117265,"_5":14053,"_26831":116649,"_2843":117266},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3355":69607,"_29485":69344,"_20482":117268,"_5":14053,"_26831":116649,"_2843":117269},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3355":69608,"_29485":69344,"_20482":117271,"_5":14053,"_26831":116649,"_2843":117272},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3355":69609,"_29485":69344,"_20482":117274,"_5":14053,"_26831":116649,"_2843":117275},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3355":69610,"_29485":69344,"_20482":117277,"_5":14053,"_26831":116649,"_2843":117278},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3355":69611,"_29485":69344,"_20482":117280,"_5":14053,"_26831":116649,"_2843":117281},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3355":69612,"_29485":69344,"_20482":117283,"_5":14053,"_26831":116649,"_2843":117284},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3355":69613,"_29485":69344,"_20482":117286,"_5":14053,"_26831":116649,"_2843":117287},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3355":69614,"_29485":69344,"_20482":117289,"_5":14053,"_26831":116649,"_2843":117290},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3355":69615,"_29485":69344,"_20482":117292,"_5":14053,"_26831":116649,"_2843":117293},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3355":69616,"_29485":69344,"_20482":117295,"_5":14053,"_26831":116649,"_2843":117296},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3355":69617,"_29485":69344,"_20482":117298,"_5":14053,"_26831":116649,"_2843":117299},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3355":69618,"_29485":69344,"_20482":117301,"_5":14053,"_26831":116649,"_2843":117302},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3355":69619,"_29485":69344,"_20482":117304,"_5":14053,"_26831":116649,"_2843":117305},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3355":69620,"_29485":69344,"_20482":117307,"_5":14053,"_26831":116649,"_2843":117308},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3355":69621,"_29485":69344,"_20482":117310,"_5":14053,"_26831":116649,"_2843":117311},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3355":69622,"_29485":69344,"_20482":117313,"_5":14053,"_26831":116649,"_2843":117314},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3355":69623,"_29485":69344,"_20482":117316,"_5":14053,"_26831":116649,"_2843":117317},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3355":69624,"_29485":69344,"_20482":117319,"_5":14053,"_26831":116649,"_2843":117320},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3355":69625,"_29485":69344,"_20482":117322,"_5":14053,"_26831":116649,"_2843":117323},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3355":69626,"_29485":69344,"_20482":117325,"_5":14053,"_26831":116649,"_2843":117326},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3355":69627,"_29485":69627,"_5":14411,"_2843":50418,"_29817":117328,"_20482":117329,"_26831":69627},[47939,114128,50418],[],{"_3355":69628,"_29485":69627,"_20482":117331,"_5":14053,"_26831":69627,"_2843":117332},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3355":69629,"_29485":69627,"_5":29814,"_20482":117334,"_26831":117335,"_2843":117336},[],"/docs/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3355":69630,"_29485":69627,"_5":29814,"_20482":117338,"_26831":117339,"_2843":115137},[],"/docs/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3355":69631,"_29485":69627,"_5":29814,"_20482":117341,"_26831":117342,"_2843":115312},[],"/docs/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3355":69632,"_29485":69627,"_5":29814,"_20482":117344,"_26831":117345,"_2843":116544},[],"/docs/es/platform/iot-fleets/overview#integraciones",{"_3355":69633,"_29485":69627,"_5":29814,"_20482":117347,"_26831":117348,"_2843":117349},[],"/docs/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3355":69634,"_29485":69627,"_20482":117351,"_5":14053,"_26831":69627,"_2843":117352},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3355":69635,"_29485":69627,"_20482":117354,"_5":14053,"_26831":117335,"_2843":117355},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3355":69636,"_29485":69627,"_20482":117357,"_5":14053,"_26831":117335,"_2843":117358},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3355":69637,"_29485":69627,"_20482":117360,"_5":14053,"_26831":117339,"_2843":117361},[],"Recurso",{"_3355":69638,"_29485":69627,"_20482":117363,"_5":14053,"_26831":117339,"_2843":117364},[],"Qué representa",{"_3355":69639,"_29485":69627,"_20482":117366,"_5":14053,"_26831":117339,"_2843":117367},[],"**Dispositivo**",{"_3355":69640,"_29485":69627,"_20482":117369,"_5":14053,"_26831":117339,"_2843":117370},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3355":69641,"_29485":69627,"_20482":117372,"_5":14053,"_26831":117339,"_2843":117373},[],"**Identidad**",{"_3355":69642,"_29485":69627,"_20482":117375,"_5":14053,"_26831":117339,"_2843":117376},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3355":69643,"_29485":69627,"_20482":117378,"_5":14053,"_26831":117339,"_2843":52771},[],{"_3355":69644,"_29485":69627,"_20482":117380,"_5":14053,"_26831":117339,"_2843":117381},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3355":69645,"_29485":69627,"_20482":117383,"_5":14053,"_26831":117339,"_2843":117384},[],"**Flota**",{"_3355":69646,"_29485":69627,"_20482":117386,"_5":14053,"_26831":117339,"_2843":117387},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3355":69647,"_29485":69627,"_20482":117389,"_5":14053,"_26831":117339,"_2843":117390},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3355":69648,"_29485":69627,"_20482":117392,"_5":14053,"_26831":117339,"_2843":117393},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3355":69649,"_29485":69627,"_20482":117395,"_5":14053,"_26831":117342,"_2843":117396},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3355":69650,"_29485":69627,"_20482":117398,"_5":14053,"_26831":117342,"_2843":117399},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3355":69651,"_29485":69627,"_20482":117401,"_5":14053,"_26831":117342,"_2843":117402},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3355":69652,"_29485":69627,"_20482":117404,"_5":14053,"_26831":117342,"_2843":117405},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3355":69653,"_29485":69627,"_20482":117407,"_5":14053,"_26831":117342,"_2843":117408},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3355":69654,"_29485":69627,"_20482":117410,"_5":14053,"_26831":117342,"_2843":117411},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3355":69655,"_29485":69627,"_20482":117413,"_5":14053,"_26831":117342,"_2843":117414},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3355":69656,"_29485":69627,"_20482":117416,"_5":14053,"_26831":117342,"_2843":117417},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3355":69657,"_29485":69627,"_20482":117419,"_5":14053,"_26831":117345,"_2843":117420},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3355":69658,"_29485":69627,"_20482":117422,"_5":14053,"_26831":117345,"_2843":117423},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3355":69659,"_29485":69627,"_20482":117425,"_5":14053,"_26831":117348,"_2843":117426},[],"Participante",{"_3355":69660,"_29485":69627,"_20482":117428,"_5":14053,"_26831":117348,"_2843":117429},[],"Responsabilidad",{"_3355":69661,"_29485":69627,"_20482":117431,"_5":14053,"_26831":117348,"_2843":117432},[],"Administrador PKI",{"_3355":69662,"_29485":69627,"_20482":117434,"_5":14053,"_26831":117348,"_2843":117435},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3355":69663,"_29485":69627,"_20482":117437,"_5":14053,"_26831":117348,"_2843":117438},[],"Administrador del aprovisionamiento",{"_3355":69664,"_29485":69627,"_20482":117440,"_5":14053,"_26831":117348,"_2843":117441},[],"DMS, admisión, autenticación por operación e inventario.",{"_3355":69665,"_29485":69627,"_20482":117443,"_5":14053,"_26831":117348,"_2843":117444},[],"Integrador del dispositivo",{"_3355":69666,"_29485":69627,"_20482":117446,"_5":14053,"_26831":117348,"_2843":117447},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3355":69667,"_29485":69627,"_20482":117449,"_5":14053,"_26831":117348,"_2843":117450},[],"Integrador del consumidor",{"_3355":69668,"_29485":69627,"_20482":117452,"_5":14053,"_26831":117348,"_2843":117453},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3355":69669,"_29485":69627,"_20482":117455,"_5":14053,"_26831":117348,"_2843":117456},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3355":69670,"_29485":69670,"_5":14411,"_2843":117458,"_29817":117459,"_20482":117461,"_26831":69670},"Enrola y conecta tu primer dispositivo",[47939,114128,50418,117460],"Primeros pasos",[],{"_3355":69671,"_29485":69670,"_20482":117463,"_5":14053,"_26831":69670,"_2843":117464},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3355":69672,"_29485":69670,"_5":29814,"_20482":117466,"_26831":117467,"_2843":112706},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3355":69673,"_29485":69670,"_5":29814,"_20482":117469,"_26831":117470,"_2843":117471},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3355":69674,"_29485":69670,"_5":29814,"_20482":117473,"_26831":117474,"_2843":117475},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3355":69675,"_29485":69670,"_5":29814,"_20482":117477,"_26831":117478,"_2843":117479},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3355":69676,"_29485":69670,"_5":29814,"_20482":117481,"_26831":117482,"_2843":117483},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3355":69677,"_29485":69670,"_5":29814,"_20482":117485,"_26831":117486,"_2843":117487},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3355":69678,"_29485":69670,"_5":29814,"_20482":117489,"_26831":117490,"_2843":117491},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3355":69679,"_29485":69670,"_5":29814,"_20482":117493,"_26831":117494,"_2843":117495},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3355":69680,"_29485":69670,"_20482":117497,"_5":14053,"_26831":69670,"_2843":117498},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3355":69681,"_29485":69670,"_20482":117500,"_5":14053,"_26831":117467,"_2843":117501},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3355":69682,"_29485":69670,"_20482":117503,"_5":14053,"_26831":117467,"_2843":117504},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3355":69683,"_29485":69670,"_20482":117506,"_5":14053,"_26831":117467,"_2843":117507},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3355":69684,"_29485":69670,"_20482":117509,"_5":14053,"_26831":117467,"_2843":117510},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3355":69685,"_29485":69670,"_20482":117512,"_5":14053,"_26831":117467,"_2843":117513},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3355":69686,"_29485":69670,"_20482":117515,"_5":14053,"_26831":117470,"_2843":117516},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3355":69687,"_29485":69670,"_20482":117518,"_5":14053,"_26831":117470,"_2843":117519},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3355":69688,"_29485":69670,"_20482":117521,"_5":14053,"_26831":117474,"_2843":117522},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3355":69689,"_29485":69670,"_20482":117524,"_5":14053,"_26831":117474,"_2843":117525},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3355":69690,"_29485":69670,"_20482":117527,"_5":14053,"_26831":117474,"_2843":117528},[],"Ajuste",{"_3355":69691,"_29485":69670,"_20482":117530,"_5":14053,"_26831":117474,"_2843":117531},[],"Valor de evaluación",{"_3355":69692,"_29485":69670,"_20482":117533,"_5":14053,"_26831":117474,"_2843":52927},[],{"_3355":69693,"_29485":69670,"_20482":117535,"_5":14053,"_26831":117474,"_2843":117536},[],"Raíz emisora de `device-root.pem`.",{"_3355":69694,"_29485":69670,"_20482":117538,"_5":14053,"_26831":117474,"_2843":115440},[],{"_3355":69695,"_29485":69670,"_20482":117540,"_5":14053,"_26831":117474,"_2843":117541},[],"Perfil final de 1 hora que acabas de preparar.",{"_3355":69696,"_29485":69670,"_20482":117543,"_5":14053,"_26831":117474,"_2843":52938},[],{"_3355":69697,"_29485":69670,"_20482":117545,"_5":14053,"_26831":117474,"_2843":52941},[],{"_3355":69698,"_29485":69670,"_20482":117547,"_5":14053,"_26831":117474,"_2843":52944},[],{"_3355":69699,"_29485":69670,"_20482":117549,"_5":14053,"_26831":117474,"_2843":117550},[],"Habilitado.",{"_3355":69700,"_29485":69670,"_20482":117552,"_5":14053,"_26831":117474,"_2843":52950},[],{"_3355":69701,"_29485":69670,"_20482":117554,"_5":14053,"_26831":117474,"_2843":117555},[],"Deshabilitado; el ID debe ser nuevo.",{"_3355":69702,"_29485":69670,"_20482":117557,"_5":14053,"_26831":117474,"_2843":117558},[],"Autenticación inicial",{"_3355":69703,"_29485":69670,"_20482":117560,"_5":14053,"_26831":117474,"_2843":117561},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3355":69704,"_29485":69670,"_20482":117563,"_5":14053,"_26831":117474,"_2843":117564},[],"Autenticación de renovación",{"_3355":69705,"_29485":69670,"_20482":117566,"_5":14053,"_26831":117474,"_2843":117567},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3355":69706,"_29485":69670,"_20482":117569,"_5":14053,"_26831":117474,"_2843":52968},[],{"_3355":69707,"_29485":69670,"_20482":117571,"_5":14053,"_26831":117474,"_2843":117572},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3355":69708,"_29485":69670,"_20482":117574,"_5":14053,"_26831":117474,"_2843":52974},[],{"_3355":69709,"_29485":69670,"_20482":117576,"_5":14053,"_26831":117474,"_2843":117577},[],"1 hora.",{"_3355":69710,"_29485":69670,"_20482":117579,"_5":14053,"_26831":117474,"_2843":52980},[],{"_3355":69711,"_29485":69670,"_20482":117581,"_5":14053,"_26831":117474,"_2843":117582},[],"30 minutos / 10 minutos.",{"_3355":69712,"_29485":69670,"_20482":117584,"_5":14053,"_26831":117474,"_2843":52986},[],{"_3355":69713,"_29485":69670,"_20482":117586,"_5":14053,"_26831":117474,"_2843":117587},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3355":69714,"_29485":69670,"_20482":117589,"_5":14053,"_26831":117474,"_2843":50737},[],{"_3355":69715,"_29485":69670,"_20482":117591,"_5":14053,"_26831":117474,"_2843":117592},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3355":69716,"_29485":69670,"_20482":117594,"_5":14053,"_26831":117474,"_2843":52997},[],{"_3355":69717,"_29485":69670,"_20482":117596,"_5":14053,"_26831":117474,"_2843":117597},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3355":69718,"_29485":69670,"_20482":117599,"_5":14053,"_26831":117474,"_2843":117600},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3355":69719,"_29485":69670,"_20482":117602,"_5":14053,"_26831":117478,"_2843":117603},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3355":69720,"_29485":69670,"_20482":117605,"_5":14053,"_26831":117478,"_2843":117606},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3355":69721,"_29485":69670,"_20482":117608,"_5":14053,"_26831":117482,"_2843":117609},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3355":69722,"_29485":69670,"_20482":117611,"_5":14053,"_26831":117482,"_2843":117612},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3355":69723,"_29485":69670,"_20482":117614,"_5":14053,"_26831":117482,"_2843":117615},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3355":69724,"_29485":69670,"_20482":117617,"_5":14053,"_26831":117486,"_2843":117618},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3355":69725,"_29485":69670,"_20482":117620,"_5":14053,"_26831":117486,"_2843":117621},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3355":69726,"_29485":69670,"_20482":117623,"_5":14053,"_26831":117490,"_2843":117624},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3355":69727,"_29485":69670,"_20482":117626,"_5":14053,"_26831":117490,"_2843":117627},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3355":69728,"_29485":69670,"_20482":117629,"_5":14053,"_26831":117490,"_2843":117630},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3355":69729,"_29485":69670,"_20482":117632,"_5":14053,"_26831":117490,"_2843":117633},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3355":69730,"_29485":69670,"_20482":117635,"_5":14053,"_26831":117490,"_2843":117636},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3355":69731,"_29485":69670,"_20482":117638,"_5":14053,"_26831":117494,"_2843":117639},[],"Comprobación",{"_3355":69732,"_29485":69670,"_20482":117641,"_5":14053,"_26831":117494,"_2843":117642},[],"Resultado esperado",{"_3355":69733,"_29485":69670,"_20482":117644,"_5":14053,"_26831":117494,"_2843":117645},[],"Registro",{"_3355":69734,"_29485":69670,"_20482":117647,"_5":14053,"_26831":117494,"_2843":117648},[],"ID creado automáticamente y DMS correcto.",{"_3355":69735,"_29485":69670,"_20482":117650,"_5":14053,"_26831":117494,"_2843":116932},[],{"_3355":69736,"_29485":69670,"_20482":117652,"_5":14053,"_26831":117494,"_2843":117653},[],"CN, perfil, serie y clave verificados.",{"_3355":69737,"_29485":69670,"_20482":117655,"_5":14053,"_26831":117494,"_2843":117656},[],"Inventario",{"_3355":69738,"_29485":69670,"_20482":117658,"_5":14053,"_26831":117494,"_2843":117659},[],"Serie recibida visible como identidad actual y en el historial.",{"_3355":69739,"_29485":69670,"_20482":117661,"_5":14053,"_26831":117494,"_2843":117662},[],"Consumidor",{"_3355":69740,"_29485":69670,"_20482":117664,"_5":14053,"_26831":117494,"_2843":117665},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3355":69741,"_29485":69670,"_20482":117667,"_5":14053,"_26831":117494,"_2843":117668},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3355":69742,"_29485":69670,"_20482":117670,"_5":14053,"_26831":117494,"_2843":117671},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3355":69743,"_29485":69743,"_5":14411,"_2843":115154,"_29817":117673,"_20482":117674,"_26831":69743},[47939,114128,50418,117460],[],{"_3355":69744,"_29485":69743,"_20482":117676,"_5":14053,"_26831":69743,"_2843":117677},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3355":69745,"_29485":69743,"_5":29814,"_20482":117679,"_26831":117680,"_2843":112706},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3355":69746,"_29485":69743,"_5":29814,"_20482":117682,"_26831":117683,"_2843":117684},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3355":69747,"_29485":69743,"_5":29814,"_20482":117686,"_26831":117687,"_2843":117688},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3355":69748,"_29485":69743,"_5":29814,"_20482":117690,"_26831":117691,"_2843":117692},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3355":69749,"_29485":69743,"_5":29814,"_20482":117694,"_26831":117695,"_2843":117696},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3355":69750,"_29485":69743,"_5":29814,"_20482":117698,"_26831":117699,"_2843":117700},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3355":69751,"_29485":69743,"_5":29814,"_20482":117702,"_26831":117703,"_2843":117642},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3355":69752,"_29485":69743,"_5":29814,"_20482":117705,"_26831":117706,"_2843":117707},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3355":69753,"_29485":69743,"_5":29814,"_20482":117709,"_26831":117710,"_2843":117711},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3355":69754,"_29485":69743,"_20482":117713,"_5":14053,"_26831":69743,"_2843":117714},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3355":69755,"_29485":69743,"_20482":117716,"_5":14053,"_26831":69743,"_2843":117717},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3355":69756,"_29485":69743,"_20482":117719,"_5":14053,"_26831":117680,"_2843":117720},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3355":69757,"_29485":69743,"_20482":117722,"_5":14053,"_26831":117680,"_2843":117723},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3355":69758,"_29485":69743,"_20482":117725,"_5":14053,"_26831":117680,"_2843":117726},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3355":69759,"_29485":69743,"_20482":117728,"_5":14053,"_26831":117680,"_2843":117729},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3355":69760,"_29485":69743,"_20482":117731,"_5":14053,"_26831":117683,"_2843":117732},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3355":69761,"_29485":69743,"_20482":117734,"_5":14053,"_26831":117683,"_2843":117735},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3355":69762,"_29485":69743,"_20482":117737,"_5":14053,"_26831":117683,"_2843":117738},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3355":69763,"_29485":69743,"_20482":117740,"_5":14053,"_26831":117683,"_2843":117741},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3355":69764,"_29485":69743,"_20482":117743,"_5":14053,"_26831":117683,"_2843":117744},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3355":69765,"_29485":69743,"_20482":117746,"_5":14053,"_26831":117683,"_2843":117747},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3355":69766,"_29485":69743,"_20482":117749,"_5":14053,"_26831":117683,"_2843":117750},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3355":69767,"_29485":69743,"_20482":117752,"_5":14053,"_26831":117683,"_2843":117753},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3355":69768,"_29485":69743,"_20482":117755,"_5":14053,"_26831":117687,"_2843":117756},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3355":69769,"_29485":69743,"_20482":117758,"_5":14053,"_26831":117687,"_2843":53162},[],{"_3355":69770,"_29485":69743,"_20482":117760,"_5":14053,"_26831":117687,"_2843":117761},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3355":69771,"_29485":69743,"_20482":117763,"_5":14053,"_26831":117687,"_2843":117764},[],"**Icon** y **Tags**: clasificación opcional.",{"_3355":69772,"_29485":69743,"_20482":117766,"_5":14053,"_26831":117687,"_2843":117767},[],"Confirma el registro.",{"_3355":69773,"_29485":69743,"_20482":117769,"_5":14053,"_26831":117691,"_2843":117770},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3355":69774,"_29485":69743,"_20482":117772,"_5":14053,"_26831":117691,"_2843":117773},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3355":69775,"_29485":69743,"_20482":117775,"_5":14053,"_26831":117695,"_2843":117776},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3355":69776,"_29485":69743,"_20482":117778,"_5":14053,"_26831":117695,"_2843":117779},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3355":69777,"_29485":69743,"_20482":117781,"_5":14053,"_26831":117699,"_2843":117782},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3355":69778,"_29485":69743,"_20482":117784,"_5":14053,"_26831":117699,"_2843":117785},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3355":69779,"_29485":69743,"_20482":117787,"_5":14053,"_26831":117703,"_2843":117639},[],{"_3355":69780,"_29485":69743,"_20482":117789,"_5":14053,"_26831":117703,"_2843":117790},[],"Resultado",{"_3355":69781,"_29485":69743,"_20482":117792,"_5":14053,"_26831":117703,"_2843":116918},[],{"_3355":69782,"_29485":69743,"_20482":117794,"_5":14053,"_26831":117703,"_2843":117795},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3355":69783,"_29485":69743,"_20482":117797,"_5":14053,"_26831":117703,"_2843":117798},[],"Identidad actual",{"_3355":69784,"_29485":69743,"_20482":117800,"_5":14053,"_26831":117703,"_2843":117801},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3355":69785,"_29485":69743,"_20482":117803,"_5":14053,"_26831":117703,"_2843":117804},[],"Historial",{"_3355":69786,"_29485":69743,"_20482":117806,"_5":14053,"_26831":117703,"_2843":117807},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3355":69787,"_29485":69743,"_20482":117809,"_5":14053,"_26831":117703,"_2843":117810},[],"Clave y certificado",{"_3355":69788,"_29485":69743,"_20482":117812,"_5":14053,"_26831":117703,"_2843":117813},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3355":69789,"_29485":69743,"_20482":117815,"_5":14053,"_26831":117706,"_2843":117816},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3355":69790,"_29485":69743,"_20482":117818,"_5":14053,"_26831":117706,"_2843":117819},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3355":69791,"_29485":69743,"_20482":117821,"_5":14053,"_26831":117706,"_2843":117822},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3355":69792,"_29485":69743,"_20482":117824,"_5":14053,"_26831":117706,"_2843":117825},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3355":69793,"_29485":69743,"_20482":117827,"_5":14053,"_26831":117710,"_2843":117828},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3355":69794,"_29485":69743,"_20482":117830,"_5":14053,"_26831":117710,"_2843":117831},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3355":69795,"_29485":69743,"_20482":117833,"_5":14053,"_26831":117710,"_2843":117834},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3355":69796,"_29485":69796,"_5":14411,"_2843":117836,"_29817":117837,"_20482":117838,"_26831":69796},"Plataforma Lamassu IoT",[47939,114128],[],{"_3355":69797,"_29485":69796,"_20482":117840,"_5":14053,"_26831":69796,"_2843":117841},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3355":69798,"_29485":69796,"_5":29814,"_20482":117843,"_26831":117844,"_2843":117336},[],"/docs/es/platform/overview#empieza-aquí",{"_3355":69799,"_29485":69796,"_5":29814,"_20482":117846,"_26831":117847,"_2843":117848},[],"/docs/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3355":69800,"_29485":69796,"_5":29814,"_20482":117850,"_26831":117851,"_2843":117852},[],"/docs/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3355":69801,"_29485":69796,"_5":29814,"_20482":117854,"_26831":117855,"_2843":117856},[],"/docs/es/platform/overview#capacidades-principales","Capacidades principales",{"_3355":69802,"_29485":69796,"_5":29814,"_20482":117858,"_26831":117859,"_2843":117860},[],"/docs/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3355":69803,"_29485":69796,"_5":29814,"_20482":117862,"_26831":117863,"_2843":117864},[],"/docs/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3355":69804,"_29485":69796,"_5":29814,"_20482":117866,"_26831":117867,"_2843":117868},[],"/docs/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3355":69805,"_29485":69796,"_5":29814,"_20482":117870,"_26831":117871,"_2843":117872},[],"/docs/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3355":69806,"_29485":69796,"_5":29814,"_20482":117874,"_26831":117875,"_2843":117876},[],"/docs/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3355":69807,"_29485":69796,"_5":29814,"_20482":117878,"_26831":117879,"_2843":117880},[],"/docs/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3355":69808,"_29485":69796,"_5":29814,"_20482":117882,"_26831":117883,"_2843":117884},[],"/docs/es/platform/overview#referencia-operativa","Referencia operativa",{"_3355":69809,"_29485":69796,"_20482":117886,"_5":14053,"_26831":69796,"_2843":117887},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3355":69810,"_29485":69796,"_20482":117889,"_5":14053,"_26831":117844,"_2843":117890},[],"Elige el resultado que necesitas obtener:",{"_3355":69811,"_29485":69796,"_20482":117892,"_5":14053,"_26831":117844,"_2843":117893},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3355":69812,"_29485":69796,"_20482":117895,"_5":14053,"_26831":117844,"_2843":117896},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3355":69813,"_29485":69796,"_20482":117898,"_5":14053,"_26831":117844,"_2843":117899},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3355":69814,"_29485":69796,"_20482":117901,"_5":14053,"_26831":117847,"_2843":117902},[],"Bloque",{"_3355":69815,"_29485":69796,"_20482":117904,"_5":14053,"_26831":117847,"_2843":117905},[],"Qué gestionas",{"_3355":69816,"_29485":69796,"_20482":117907,"_5":14053,"_26831":117847,"_2843":117908},[],"Punto de entrada",{"_3355":69817,"_29485":69796,"_20482":117910,"_5":14053,"_26831":117847,"_2843":53315},[],{"_3355":69818,"_29485":69796,"_20482":117912,"_5":14053,"_26831":117847,"_2843":117913},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3355":69819,"_29485":69796,"_20482":117915,"_5":14053,"_26831":117847,"_2843":117916},[],"Visión general de PKI",{"_3355":69820,"_29485":69796,"_20482":117918,"_5":14053,"_26831":117847,"_2843":53324},[],{"_3355":69821,"_29485":69796,"_20482":117920,"_5":14053,"_26831":117847,"_2843":117921},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3355":69822,"_29485":69796,"_20482":117923,"_5":14053,"_26831":117847,"_2843":117924},[],"Visión general de IoT Fleets",{"_3355":69823,"_29485":69796,"_20482":117926,"_5":14053,"_26831":117847,"_2843":117927},[],"**Administración**",{"_3355":69824,"_29485":69796,"_20482":117929,"_5":14053,"_26831":117847,"_2843":117930},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3355":69825,"_29485":69796,"_20482":117932,"_5":14053,"_26831":117847,"_2843":114126},[],{"_3355":69826,"_29485":69796,"_20482":117934,"_5":14053,"_26831":117847,"_2843":117935},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3355":69827,"_29485":69796,"_20482":117937,"_5":14053,"_26831":117851,"_2843":117938},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3355":69828,"_29485":69796,"_20482":117940,"_5":14053,"_26831":117851,"_2843":117941},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3355":69829,"_29485":69796,"_20482":117943,"_5":14053,"_26831":117851,"_2843":117944},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3355":69830,"_29485":69796,"_20482":117946,"_5":14053,"_26831":117851,"_2843":117947},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3355":69831,"_29485":69796,"_20482":117949,"_5":14053,"_26831":117851,"_2843":117950},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3355":69832,"_29485":69796,"_20482":117952,"_5":14053,"_26831":117851,"_2843":117953},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3355":69833,"_29485":69796,"_20482":117955,"_5":14053,"_26831":117859,"_2843":117956},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3355":69834,"_29485":69796,"_20482":117958,"_5":14053,"_26831":117863,"_2843":117959},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3355":69835,"_29485":69796,"_20482":117961,"_5":14053,"_26831":117867,"_2843":117962},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3355":69836,"_29485":69796,"_20482":117964,"_5":14053,"_26831":117871,"_2843":117965},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3355":69837,"_29485":69796,"_20482":117967,"_5":14053,"_26831":117875,"_2843":117968},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3355":69838,"_29485":69796,"_20482":117970,"_5":14053,"_26831":117879,"_2843":117971},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3355":69839,"_29485":69796,"_20482":117973,"_5":14053,"_26831":117883,"_2843":117429},[],{"_3355":69840,"_29485":69796,"_20482":117975,"_5":14053,"_26831":117883,"_2843":117976},[],"Qué prepara o comprueba",{"_3355":69841,"_29485":69796,"_20482":117978,"_5":14053,"_26831":117883,"_2843":117432},[],{"_3355":69842,"_29485":69796,"_20482":117980,"_5":14053,"_26831":117883,"_2843":117981},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3355":69843,"_29485":69796,"_20482":117983,"_5":14053,"_26831":117883,"_2843":117984},[],"Administrador de la flota",{"_3355":69844,"_29485":69796,"_20482":117986,"_5":14053,"_26831":117883,"_2843":117987},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3355":69845,"_29485":69796,"_20482":117989,"_5":14053,"_26831":117883,"_2843":117444},[],{"_3355":69846,"_29485":69796,"_20482":117991,"_5":14053,"_26831":117883,"_2843":117992},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3355":69847,"_29485":69796,"_20482":117994,"_5":14053,"_26831":117883,"_2843":117450},[],{"_3355":69848,"_29485":69796,"_20482":117996,"_5":14053,"_26831":117883,"_2843":117997},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3355":69849,"_29485":69796,"_20482":117999,"_5":14053,"_26831":117883,"_2843":118000},[],"Operador de infraestructura",{"_3355":69850,"_29485":69796,"_20482":118002,"_5":14053,"_26831":117883,"_2843":118003},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3355":69851,"_29485":69796,"_20482":118005,"_5":14053,"_26831":117883,"_2843":118006},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3355":69852,"_29485":69852,"_5":14411,"_2843":118008,"_29817":118009,"_20482":118011,"_26831":69852},"Jerarquía y rotación de CAs",[47939,114128,53416,118010],"Claves, autoridades y certificados",[],{"_3355":69853,"_29485":69852,"_20482":118013,"_5":14053,"_26831":69852,"_2843":118014},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3355":69854,"_29485":69852,"_5":29814,"_20482":118016,"_26831":118017,"_2843":118018},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3355":69855,"_29485":69852,"_5":29814,"_20482":118020,"_26831":118021,"_2843":118022},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3355":69856,"_29485":69852,"_5":29814,"_20482":118024,"_26831":118025,"_2843":118026},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3355":69857,"_29485":69852,"_5":29814,"_20482":118028,"_26831":118029,"_2843":118030},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3355":69858,"_29485":69852,"_5":29814,"_20482":118032,"_26831":118033,"_2843":118034},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3355":69859,"_29485":69852,"_5":29814,"_20482":118036,"_26831":118037,"_2843":118038},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3355":69860,"_29485":69852,"_5":29814,"_20482":118040,"_26831":118041,"_2843":118042},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3355":69861,"_29485":69852,"_5":29814,"_20482":118044,"_26831":118045,"_2843":118046},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3355":69862,"_29485":69852,"_5":29814,"_20482":118048,"_26831":118049,"_2843":118050},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3355":69863,"_29485":69852,"_5":29814,"_20482":118052,"_26831":118053,"_2843":118054},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3355":69864,"_29485":69852,"_5":29814,"_20482":118056,"_26831":118057,"_2843":118058},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3355":69865,"_29485":69852,"_5":29814,"_20482":118060,"_26831":118061,"_2843":118062},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3355":69866,"_29485":69852,"_20482":118064,"_5":14053,"_26831":69852,"_2843":118065},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3355":69867,"_29485":69852,"_20482":118067,"_5":14053,"_26831":69852,"_2843":118068},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3355":69868,"_29485":69852,"_20482":118070,"_5":14053,"_26831":118017,"_2843":118071},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3355":69869,"_29485":69852,"_20482":118073,"_5":14053,"_26831":118017,"_2843":118074},[],"entorno, como producción y preproducción;",{"_3355":69870,"_29485":69852,"_20482":118076,"_5":14053,"_26831":118017,"_2843":118077},[],"propietario o equipo operador;",{"_3355":69871,"_29485":69852,"_20482":118079,"_5":14053,"_26831":118017,"_2843":118080},[],"familia de dispositivos o proceso de fabricación;",{"_3355":69872,"_29485":69852,"_20482":118082,"_5":14053,"_26831":118017,"_2843":118083},[],"región o requisito regulatorio;",{"_3355":69873,"_29485":69852,"_20482":118085,"_5":14053,"_26831":118017,"_2843":118086},[],"motor criptográfico o política de clave;",{"_3355":69874,"_29485":69852,"_20482":118088,"_5":14053,"_26831":118017,"_2843":118089},[],"ventana de mantenimiento y ritmo de renovación.",{"_3355":69875,"_29485":69852,"_20482":118091,"_5":14053,"_26831":118017,"_2843":118092},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3355":69876,"_29485":69852,"_20482":118094,"_5":14053,"_26831":118017,"_2843":118095},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3355":69877,"_29485":69852,"_20482":118097,"_5":14053,"_26831":118021,"_2843":118098},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3355":69878,"_29485":69852,"_20482":118100,"_5":14053,"_26831":118021,"_2843":118101},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3355":69879,"_29485":69852,"_20482":118103,"_5":14053,"_26831":118021,"_2843":118104},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3355":69880,"_29485":69852,"_20482":118106,"_5":14053,"_26831":118025,"_2843":118107},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3355":69881,"_29485":69852,"_20482":118109,"_5":14053,"_26831":118025,"_2843":118110},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3355":69882,"_29485":69852,"_20482":118112,"_5":14053,"_26831":118025,"_2843":118113},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3355":69883,"_29485":69852,"_20482":118115,"_5":14053,"_26831":118025,"_2843":118116},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3355":69884,"_29485":69852,"_20482":118118,"_5":14053,"_26831":118033,"_2843":118119},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3355":69885,"_29485":69852,"_20482":118121,"_5":14053,"_26831":118037,"_2843":118122},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3355":69886,"_29485":69852,"_20482":118124,"_5":14053,"_26831":118041,"_2843":118125},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3355":69887,"_29485":69852,"_20482":118127,"_5":14053,"_26831":118045,"_2843":118128},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3355":69888,"_29485":69852,"_20482":118130,"_5":14053,"_26831":118049,"_2843":118131},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3355":69889,"_29485":69852,"_20482":118133,"_5":14053,"_26831":118053,"_2843":118134},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3355":69890,"_29485":69852,"_20482":118136,"_5":14053,"_26831":118057,"_2843":118137},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3355":69891,"_29485":69852,"_20482":118139,"_5":14053,"_26831":118057,"_2843":118140},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3355":69892,"_29485":69852,"_20482":118142,"_5":14053,"_26831":118057,"_2843":118143},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3355":69893,"_29485":69852,"_20482":118145,"_5":14053,"_26831":118057,"_2843":118146},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3355":69894,"_29485":69852,"_20482":118148,"_5":14053,"_26831":118061,"_2843":118149},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3355":69895,"_29485":69852,"_20482":118151,"_5":14053,"_26831":118061,"_2843":118152},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3355":69896,"_29485":69852,"_20482":118154,"_5":14053,"_26831":118061,"_2843":118155},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3355":69897,"_29485":69852,"_20482":118157,"_5":14053,"_26831":118061,"_2843":118158},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3355":69898,"_29485":69852,"_20482":118160,"_5":14053,"_26831":118061,"_2843":118161},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3355":69899,"_29485":69852,"_20482":118163,"_5":14053,"_26831":118061,"_2843":118164},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3355":69900,"_29485":69852,"_20482":118166,"_5":14053,"_26831":118061,"_2843":118167},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3355":69901,"_29485":69901,"_5":14411,"_2843":118169,"_29817":118170,"_20482":118171,"_26831":69901},"Autoridades de certificación",[47939,114128,53416,118010],[],{"_3355":69902,"_29485":69901,"_20482":118173,"_5":14053,"_26831":69901,"_2843":118174},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3355":69903,"_29485":69901,"_5":29814,"_20482":118176,"_26831":118177,"_2843":118178},[],"/docs/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3355":69904,"_29485":69901,"_5":29814,"_20482":118180,"_26831":118181,"_2843":118182},[],"/docs/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3355":69905,"_29485":69901,"_5":29814,"_20482":118184,"_26831":118185,"_2843":112706},[],"/docs/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3355":69906,"_29485":69901,"_5":29814,"_20482":118187,"_26831":118188,"_2843":118189},[],"/docs/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3355":69907,"_29485":69901,"_5":29814,"_20482":118191,"_26831":118192,"_2843":118193},[],"/docs/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3355":69908,"_29485":69901,"_5":29814,"_20482":118195,"_26831":118196,"_2843":118197},[],"/docs/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3355":69909,"_29485":69901,"_5":29814,"_20482":118199,"_26831":118200,"_2843":118201},[],"/docs/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3355":69910,"_29485":69901,"_5":29814,"_20482":118203,"_26831":118204,"_2843":118205},[],"/docs/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3355":69911,"_29485":69901,"_5":29814,"_20482":118207,"_26831":118208,"_2843":118209},[],"/docs/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3355":69912,"_29485":69901,"_5":29814,"_20482":118211,"_26831":118212,"_2843":118213},[],"/docs/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3355":69913,"_29485":69901,"_5":29814,"_20482":118215,"_26831":118216,"_2843":118217},[],"/docs/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3355":69914,"_29485":69901,"_5":29814,"_20482":118219,"_26831":118220,"_2843":118221},[],"/docs/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3355":69915,"_29485":69901,"_5":29814,"_20482":118223,"_26831":118224,"_2843":118225},[],"/docs/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3355":69916,"_29485":69901,"_5":29814,"_20482":118227,"_26831":118228,"_2843":118229},[],"/docs/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3355":69917,"_29485":69901,"_5":29814,"_20482":118231,"_26831":118232,"_2843":118233},[],"/docs/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3355":69918,"_29485":69901,"_5":29814,"_20482":118235,"_26831":118236,"_2843":118237},[],"/docs/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3355":69919,"_29485":69901,"_5":29814,"_20482":118239,"_26831":118240,"_2843":118241},[],"/docs/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3355":69920,"_29485":69901,"_5":29814,"_20482":118243,"_26831":118244,"_2843":118245},[],"/docs/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3355":69921,"_29485":69901,"_5":29814,"_20482":118247,"_26831":118248,"_2843":118249},[],"/docs/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3355":69922,"_29485":69901,"_5":29814,"_20482":118251,"_26831":118252,"_2843":118253},[],"/docs/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3355":69923,"_29485":69901,"_5":29814,"_20482":118255,"_26831":118256,"_2843":118257},[],"/docs/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3355":69924,"_29485":69901,"_5":29814,"_20482":118259,"_26831":118260,"_2843":118261},[],"/docs/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3355":69925,"_29485":69901,"_5":29814,"_20482":118263,"_26831":118264,"_2843":118265},[],"/docs/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3355":69926,"_29485":69901,"_20482":118267,"_5":14053,"_26831":69901,"_2843":118268},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3355":69927,"_29485":69901,"_20482":118270,"_5":14053,"_26831":69901,"_2843":118271},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3355":69928,"_29485":69901,"_20482":118273,"_5":14053,"_26831":69901,"_2843":118274},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3355":69929,"_29485":69901,"_20482":118276,"_5":14053,"_26831":118177,"_2843":118277},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3355":69930,"_29485":69901,"_20482":118279,"_5":14053,"_26831":118177,"_2843":118280},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3355":69931,"_29485":69901,"_20482":118282,"_5":14053,"_26831":118177,"_2843":118283},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3355":69932,"_29485":69901,"_20482":118285,"_5":14053,"_26831":118177,"_2843":118286},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3355":69933,"_29485":69901,"_20482":118288,"_5":14053,"_26831":118177,"_2843":118289},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3355":69934,"_29485":69901,"_20482":118291,"_5":14053,"_26831":118185,"_2843":118292},[],"Decide si la CA será raíz o intermedia.",{"_3355":69935,"_29485":69901,"_20482":118294,"_5":14053,"_26831":118185,"_2843":118295},[],"Elige el motor que custodiará la clave.",{"_3355":69936,"_29485":69901,"_20482":118297,"_5":14053,"_26831":118185,"_2843":118298},[],"Define una validez superior a la de los certificados que emitirá.",{"_3355":69937,"_29485":69901,"_20482":118300,"_5":14053,"_26831":118185,"_2843":118301},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3355":69938,"_29485":69901,"_20482":118303,"_5":14053,"_26831":118188,"_2843":118304},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3355":69939,"_29485":69901,"_20482":118306,"_5":14053,"_26831":118192,"_2843":118307},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3355":69940,"_29485":69901,"_20482":118309,"_5":14053,"_26831":118192,"_2843":118310},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3355":69941,"_29485":69901,"_20482":118312,"_5":14053,"_26831":118196,"_2843":118313},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3355":69942,"_29485":69901,"_20482":118315,"_5":14053,"_26831":118200,"_2843":118316},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3355":69943,"_29485":69901,"_20482":118318,"_5":14053,"_26831":118200,"_2843":118319},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3355":69944,"_29485":69901,"_20482":118321,"_5":14053,"_26831":118200,"_2843":118322},[],"`ST`: estado o provincia.",{"_3355":69945,"_29485":69901,"_20482":118324,"_5":14053,"_26831":118200,"_2843":118325},[],"`L`: localidad.",{"_3355":69946,"_29485":69901,"_20482":118327,"_5":14053,"_26831":118200,"_2843":118328},[],"`O`: organización.",{"_3355":69947,"_29485":69901,"_20482":118330,"_5":14053,"_26831":118200,"_2843":118331},[],"`OU`: unidad organizativa.",{"_3355":69948,"_29485":69901,"_20482":118333,"_5":14053,"_26831":118200,"_2843":118334},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3355":69949,"_29485":69901,"_20482":118336,"_5":14053,"_26831":118204,"_2843":118337},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3355":69950,"_29485":69901,"_20482":118339,"_5":14053,"_26831":118204,"_2843":118340},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3355":69951,"_29485":69901,"_20482":118342,"_5":14053,"_26831":118208,"_2843":118343},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3355":69952,"_29485":69901,"_20482":118345,"_5":14053,"_26831":118208,"_2843":118346},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3355":69953,"_29485":69901,"_20482":118348,"_5":14053,"_26831":118212,"_2843":118349},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3355":69954,"_29485":69901,"_20482":118351,"_5":14053,"_26831":118212,"_2843":118352},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3355":69955,"_29485":69901,"_20482":118354,"_5":14053,"_26831":118216,"_2843":118355},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3355":69956,"_29485":69901,"_20482":118357,"_5":14053,"_26831":118220,"_2843":118358},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3355":69957,"_29485":69901,"_20482":118360,"_5":14053,"_26831":118224,"_2843":118361},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3355":69958,"_29485":69901,"_20482":118363,"_5":14053,"_26831":118228,"_2843":118364},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3355":69959,"_29485":69901,"_20482":118366,"_5":14053,"_26831":118232,"_2843":118367},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3355":69960,"_29485":69901,"_20482":118369,"_5":14053,"_26831":118232,"_2843":118370},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3355":69961,"_29485":69901,"_20482":118372,"_5":14053,"_26831":118236,"_2843":118373},[],"Abre una CA desde el inventario para consultar:",{"_3355":69962,"_29485":69901,"_20482":118375,"_5":14053,"_26831":118236,"_2843":118376},[],"Estado y periodo de validez.",{"_3355":69963,"_29485":69901,"_20482":118378,"_5":14053,"_26831":118236,"_2843":118379},[],"Certificado y cadena en formato PEM.",{"_3355":69964,"_29485":69901,"_20482":118381,"_5":14053,"_26831":118236,"_2843":118382},[],"Número de certificados activos, expirados y revocados.",{"_3355":69965,"_29485":69901,"_20482":118384,"_5":14053,"_26831":118236,"_2843":118385},[],"Certificados emitidos en **Issued Certificates**.",{"_3355":69966,"_29485":69901,"_20482":118387,"_5":14053,"_26831":118236,"_2843":118388},[],"CRL vinculada a la autoridad.",{"_3355":69967,"_29485":69901,"_20482":118390,"_5":14053,"_26831":118236,"_2843":118391},[],"Metadatos y motor criptográfico asociado.",{"_3355":69968,"_29485":69901,"_20482":118393,"_5":14053,"_26831":118236,"_2843":118394},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3355":69969,"_29485":69901,"_20482":118396,"_5":14053,"_26831":118240,"_2843":118397},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3355":69970,"_29485":69901,"_20482":118399,"_5":14053,"_26831":118240,"_2843":118400},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3355":69971,"_29485":69901,"_20482":118402,"_5":14053,"_26831":118240,"_2843":118403},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3355":69972,"_29485":69901,"_20482":118405,"_5":14053,"_26831":118240,"_2843":118406},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3355":69973,"_29485":69901,"_20482":118408,"_5":14053,"_26831":118244,"_2843":118409},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3355":69974,"_29485":69901,"_20482":118411,"_5":14053,"_26831":118248,"_2843":118412},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3355":69975,"_29485":69901,"_20482":118414,"_5":14053,"_26831":118252,"_2843":118415},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3355":69976,"_29485":69901,"_20482":118417,"_5":14053,"_26831":118256,"_2843":118418},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3355":69977,"_29485":69901,"_20482":118420,"_5":14053,"_26831":118260,"_2843":118421},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3355":69978,"_29485":69901,"_20482":118423,"_5":14053,"_26831":118264,"_2843":118424},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3355":69979,"_29485":69901,"_20482":118426,"_5":14053,"_26831":118264,"_2843":118427},[],"El rol VA de la CA se conserva. Si no queda otra CA con el mismo SKI, deja de ser editable (consulta CRL), así que ajusta antes su validez y su firmante. La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3355":69980,"_29485":69901,"_20482":118429,"_5":14053,"_26831":118264,"_2843":118430},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. Si el certificado nuevo usa la misma clave, comparte el SKI con el rol VA retenido de la CA eliminada, cuyo firmante es el certificado antiguo: comprueba que la CRL se genera y, si no es así, asigna con `PUT` un firmante de la CA nueva (consulta CRL).",{"_3355":69981,"_29485":69981,"_5":14411,"_2843":118432,"_29817":118433,"_20482":118434,"_26831":69981},"Perfiles de certificado",[47939,114128,53416,118010],[],{"_3355":69982,"_29485":69981,"_20482":118436,"_5":14053,"_26831":69981,"_2843":118437},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3355":69983,"_29485":69981,"_5":29814,"_20482":118439,"_26831":118440,"_2843":118441},[],"/docs/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3355":69984,"_29485":69981,"_5":29814,"_20482":118443,"_26831":118444,"_2843":118445},[],"/docs/es/platform/pki/certificate-profiles#validez","Validez",{"_3355":69985,"_29485":69981,"_5":29814,"_20482":118447,"_26831":118448,"_2843":118449},[],"/docs/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3355":69986,"_29485":69981,"_5":29814,"_20482":118451,"_26831":118452,"_2843":118453},[],"/docs/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3355":69987,"_29485":69981,"_5":29814,"_20482":118455,"_26831":118456,"_2843":118457},[],"/docs/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3355":69988,"_29485":69981,"_5":29814,"_20482":118459,"_26831":118460,"_2843":118461},[],"/docs/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3355":69989,"_29485":69981,"_5":29814,"_20482":118463,"_26831":118464,"_2843":118465},[],"/docs/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3355":69990,"_29485":69981,"_5":29814,"_20482":118467,"_26831":118468,"_2843":118469},[],"/docs/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3355":69991,"_29485":69981,"_5":29814,"_20482":118471,"_26831":118472,"_2843":118473},[],"/docs/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3355":69992,"_29485":69981,"_5":29814,"_20482":118475,"_26831":118476,"_2843":118477},[],"/docs/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3355":69993,"_29485":69981,"_5":29814,"_20482":118479,"_26831":118480,"_2843":118481},[],"/docs/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3355":69994,"_29485":69981,"_5":29814,"_20482":118483,"_26831":118484,"_2843":118485},[],"/docs/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3355":69995,"_29485":69981,"_5":29814,"_20482":118487,"_26831":118488,"_2843":118489},[],"/docs/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3355":69996,"_29485":69981,"_5":29814,"_20482":118491,"_26831":118492,"_2843":118493},[],"/docs/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3355":69997,"_29485":69981,"_5":29814,"_20482":118495,"_26831":118496,"_2843":118497},[],"/docs/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3355":69998,"_29485":69981,"_5":29814,"_20482":118499,"_26831":118500,"_2843":118501},[],"/docs/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3355":69999,"_29485":69981,"_20482":118503,"_5":14053,"_26831":69981,"_2843":118504},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3355":70000,"_29485":69981,"_20482":118506,"_5":14053,"_26831":69981,"_2843":118507},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3355":70001,"_29485":69981,"_20482":118509,"_5":14053,"_26831":118444,"_2843":118510},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3355":70002,"_29485":69981,"_20482":118512,"_5":14053,"_26831":118444,"_2843":118513},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3355":70003,"_29485":69981,"_20482":118515,"_5":14053,"_26831":118448,"_2843":118516},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_3355":70004,"_29485":69981,"_20482":118518,"_5":14053,"_26831":118452,"_2843":118519},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3355":70005,"_29485":69981,"_20482":118521,"_5":14053,"_26831":118452,"_2843":118522},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3355":70006,"_29485":69981,"_20482":118524,"_5":14053,"_26831":118452,"_2843":118525},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3355":70007,"_29485":69981,"_20482":118527,"_5":14053,"_26831":118456,"_2843":118528},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3355":70008,"_29485":69981,"_20482":118530,"_5":14053,"_26831":118460,"_2843":118531},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3355":70009,"_29485":69981,"_20482":118533,"_5":14053,"_26831":118460,"_2843":118534},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3355":70010,"_29485":69981,"_20482":118536,"_5":14053,"_26831":118464,"_2843":118537},[],"La aplicación criptográfica puede:",{"_3355":70011,"_29485":69981,"_20482":118539,"_5":14053,"_26831":118464,"_2843":118540},[],"permitir o bloquear claves RSA;",{"_3355":70012,"_29485":69981,"_20482":118542,"_5":14053,"_26831":118464,"_2843":118543},[],"limitar los tamaños RSA admitidos;",{"_3355":70013,"_29485":69981,"_20482":118545,"_5":14053,"_26831":118464,"_2843":118546},[],"permitir o bloquear claves ECDSA;",{"_3355":70014,"_29485":69981,"_20482":118548,"_5":14053,"_26831":118464,"_2843":118549},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3355":70015,"_29485":69981,"_20482":118551,"_5":14053,"_26831":118464,"_2843":118552},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3355":70016,"_29485":69981,"_20482":118554,"_5":14053,"_26831":118468,"_2843":118555},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3355":70017,"_29485":69981,"_20482":118557,"_5":14053,"_26831":118468,"_2843":113888},[],{"_3355":70018,"_29485":69981,"_20482":118559,"_5":14053,"_26831":118468,"_2843":118560},[],"Primera opción",{"_3355":70019,"_29485":69981,"_20482":118562,"_5":14053,"_26831":118468,"_2843":118563},[],"Segunda opción",{"_3355":70020,"_29485":69981,"_20482":118565,"_5":14053,"_26831":118468,"_2843":118566},[],"Si no hay ninguna",{"_3355":70021,"_29485":69981,"_20482":118568,"_5":14053,"_26831":118468,"_2843":118569},[],"Firma directa con una CA",{"_3355":70022,"_29485":69981,"_20482":118571,"_5":14053,"_26831":118468,"_2843":118572},[],"`issuance_profile` incluido en la solicitud",{"_3355":70023,"_29485":69981,"_20482":118574,"_5":14053,"_26831":118468,"_2843":118575},[],"`issuance_profile_id` de la solicitud",{"_3355":70024,"_29485":69981,"_20482":118577,"_5":14053,"_26831":118468,"_2843":118578},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3355":70025,"_29485":69981,"_20482":118580,"_5":14053,"_26831":118468,"_2843":118581},[],"Emisión mediante DMS",{"_3355":70026,"_29485":69981,"_20482":118583,"_5":14053,"_26831":118468,"_2843":53991},[],{"_3355":70027,"_29485":69981,"_20482":118585,"_5":14053,"_26831":118468,"_2843":118586},[],"`settings.issuance_profile` incluido en el DMS",{"_3355":70028,"_29485":69981,"_20482":118588,"_5":14053,"_26831":118468,"_2843":118589},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3355":70029,"_29485":69981,"_20482":118591,"_5":14053,"_26831":118468,"_2843":118592},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3355":70030,"_29485":69981,"_20482":118594,"_5":14053,"_26831":118468,"_2843":118595},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3355":70031,"_29485":69981,"_20482":118597,"_5":14053,"_26831":118476,"_2843":118598},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3355":70032,"_29485":69981,"_20482":118600,"_5":14053,"_26831":118480,"_2843":118601},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3355":70033,"_29485":69981,"_20482":118603,"_5":14053,"_26831":118484,"_2843":118604},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3355":70034,"_29485":69981,"_20482":118606,"_5":14053,"_26831":118488,"_2843":118607},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3355":70035,"_29485":69981,"_20482":118609,"_5":14053,"_26831":118492,"_2843":118610},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3355":70036,"_29485":69981,"_20482":118612,"_5":14053,"_26831":118492,"_2843":118613},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3355":70037,"_29485":69981,"_20482":118615,"_5":14053,"_26831":118496,"_2843":118616},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3355":70038,"_29485":69981,"_20482":118618,"_5":14053,"_26831":118496,"_2843":118619},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3355":70039,"_29485":69981,"_20482":118621,"_5":14053,"_26831":118496,"_2843":118622},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3355":70040,"_29485":69981,"_20482":118624,"_5":14053,"_26831":118496,"_2843":118625},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3355":70041,"_29485":69981,"_20482":118627,"_5":14053,"_26831":118500,"_2843":118628},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3355":70042,"_29485":69981,"_20482":118630,"_5":14053,"_26831":118500,"_2843":118631},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3355":70043,"_29485":70043,"_5":14411,"_2843":118633,"_29817":118634,"_20482":118636,"_26831":70043},"Validación de certificados",[47939,114128,53416,118635],"Validación",[],{"_3355":70044,"_29485":70043,"_20482":118638,"_5":14053,"_26831":70043,"_2843":118639},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3355":70045,"_29485":70043,"_5":29814,"_20482":118641,"_26831":118642,"_2843":118643},[],"/docs/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3355":70046,"_29485":70043,"_5":29814,"_20482":118645,"_26831":118646,"_2843":118647},[],"/docs/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3355":70047,"_29485":70043,"_5":29814,"_20482":118649,"_26831":118650,"_2843":118651},[],"/docs/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3355":70048,"_29485":70043,"_20482":118653,"_5":14053,"_26831":70043,"_2843":118654},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3355":70049,"_29485":70043,"_20482":118656,"_5":14053,"_26831":118642,"_2843":118657},[],"Verifica estos criterios juntos:",{"_3355":70050,"_29485":70043,"_20482":118659,"_5":14053,"_26831":118642,"_2843":117639},[],{"_3355":70051,"_29485":70043,"_20482":118661,"_5":14053,"_26831":118642,"_2843":118662},[],"Resultado necesario",{"_3355":70052,"_29485":70043,"_20482":118664,"_5":14053,"_26831":118642,"_2843":118665},[],"Cadena y firma",{"_3355":70053,"_29485":70043,"_20482":118667,"_5":14053,"_26831":118642,"_2843":118668},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3355":70054,"_29485":70043,"_20482":118670,"_5":14053,"_26831":118642,"_2843":118671},[],"Fechas",{"_3355":70055,"_29485":70043,"_20482":118673,"_5":14053,"_26831":118642,"_2843":118674},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3355":70056,"_29485":70043,"_20482":118676,"_5":14053,"_26831":118642,"_2843":113798},[],{"_3355":70057,"_29485":70043,"_20482":118678,"_5":14053,"_26831":118642,"_2843":118679},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3355":70058,"_29485":70043,"_20482":118681,"_5":14053,"_26831":118642,"_2843":118682},[],"Uso",{"_3355":70059,"_29485":70043,"_20482":118684,"_5":14053,"_26831":118642,"_2843":118685},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3355":70060,"_29485":70043,"_20482":118687,"_5":14053,"_26831":118642,"_2843":118688},[],"Revocación",{"_3355":70061,"_29485":70043,"_20482":118690,"_5":14053,"_26831":118642,"_2843":118691},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3355":70062,"_29485":70043,"_20482":118693,"_5":14053,"_26831":118642,"_2843":118694},[],"Autorización",{"_3355":70063,"_29485":70043,"_20482":118696,"_5":14053,"_26831":118642,"_2843":118697},[],"La aplicación permite la acción a esa identidad.",{"_3355":70064,"_29485":70043,"_20482":118699,"_5":14053,"_26831":118642,"_2843":118700},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3355":70065,"_29485":70043,"_20482":118702,"_5":14053,"_26831":118646,"_2843":118703},[],"Mecanismo",{"_3355":70066,"_29485":70043,"_20482":118705,"_5":14053,"_26831":118646,"_2843":118706},[],"Cuándo utilizarlo",{"_3355":70067,"_29485":70043,"_20482":118708,"_5":14053,"_26831":118646,"_2843":118709},[],"Qué debes mantener",{"_3355":70068,"_29485":70043,"_20482":118711,"_5":14053,"_26831":118646,"_2843":54119},[],{"_3355":70069,"_29485":70043,"_20482":118713,"_5":14053,"_26831":118646,"_2843":118714},[],"Consulta del estado de un certificado concreto.",{"_3355":70070,"_29485":70043,"_20482":118716,"_5":14053,"_26831":118646,"_2843":118717},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3355":70071,"_29485":70043,"_20482":118719,"_5":14053,"_26831":118646,"_2843":54128},[],{"_3355":70072,"_29485":70043,"_20482":118721,"_5":14053,"_26831":118646,"_2843":118722},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3355":70073,"_29485":70043,"_20482":118724,"_5":14053,"_26831":118646,"_2843":118725},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3355":70074,"_29485":70043,"_20482":118727,"_5":14053,"_26831":118646,"_2843":118728},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3355":70075,"_29485":70043,"_20482":118730,"_5":14053,"_26831":118646,"_2843":118731},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3355":70076,"_29485":70043,"_20482":118733,"_5":14053,"_26831":118650,"_2843":118734},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3355":70077,"_29485":70043,"_20482":118736,"_5":14053,"_26831":118650,"_2843":118737},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3355":70078,"_29485":70043,"_20482":118739,"_5":14053,"_26831":118650,"_2843":118740},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3355":70079,"_29485":70043,"_20482":118742,"_5":14053,"_26831":118650,"_2843":118743},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3355":70080,"_29485":70043,"_20482":118745,"_5":14053,"_26831":118650,"_2843":118746},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3355":70081,"_29485":70043,"_20482":118748,"_5":14053,"_26831":118650,"_2843":118749},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3355":70082,"_29485":70043,"_20482":118751,"_5":14053,"_26831":118650,"_2843":118752},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3355":70083,"_29485":70043,"_20482":118754,"_5":14053,"_26831":118650,"_2843":118755},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3355":70084,"_29485":70043,"_20482":118757,"_5":14053,"_26831":118650,"_2843":118758},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3355":70085,"_29485":70085,"_5":14411,"_2843":118760,"_29817":118761,"_20482":118762,"_26831":70085},"Certificados",[47939,114128,53416,118010],[],{"_3355":70086,"_29485":70085,"_20482":118764,"_5":14053,"_26831":70085,"_2843":118765},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3355":70087,"_29485":70085,"_5":29814,"_20482":118767,"_26831":118768,"_2843":118769},[],"/docs/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3355":70088,"_29485":70085,"_5":29814,"_20482":118771,"_26831":118772,"_2843":118773},[],"/docs/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3355":70089,"_29485":70085,"_5":29814,"_20482":118775,"_26831":118776,"_2843":118777},[],"/docs/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3355":70090,"_29485":70085,"_5":29814,"_20482":118779,"_26831":118780,"_2843":118781},[],"/docs/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3355":70091,"_29485":70085,"_5":29814,"_20482":118783,"_26831":118784,"_2843":118785},[],"/docs/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3355":70092,"_29485":70085,"_5":29814,"_20482":118787,"_26831":118788,"_2843":118789},[],"/docs/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3355":70093,"_29485":70085,"_5":29814,"_20482":118791,"_26831":118792,"_2843":118793},[],"/docs/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3355":70094,"_29485":70085,"_5":29814,"_20482":118795,"_26831":118796,"_2843":118797},[],"/docs/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3355":70095,"_29485":70085,"_5":29814,"_20482":118799,"_26831":118800,"_2843":118801},[],"/docs/es/platform/pki/certificates#continúa","Continúa",{"_3355":70096,"_29485":70085,"_20482":118803,"_5":14053,"_26831":70085,"_2843":118804},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3355":70097,"_29485":70085,"_20482":118806,"_5":14053,"_26831":118768,"_2843":118807},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3355":70098,"_29485":70085,"_20482":118809,"_5":14053,"_26831":118768,"_2843":118810},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3355":70099,"_29485":70085,"_20482":118812,"_5":14053,"_26831":118772,"_2843":118813},[],"Descarga el PEM e inspecciónalo:",{"_3355":70100,"_29485":70085,"_20482":118815,"_5":14053,"_26831":118772,"_2843":118816},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3355":70101,"_29485":70085,"_20482":118818,"_5":14053,"_26831":118776,"_2843":118819},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3355":70102,"_29485":70085,"_20482":118821,"_5":14053,"_26831":118776,"_2843":118822},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3355":70103,"_29485":70085,"_20482":118824,"_5":14053,"_26831":118776,"_2843":118825},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3355":70104,"_29485":70085,"_20482":118827,"_5":14053,"_26831":118776,"_2843":118828},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3355":70105,"_29485":70085,"_20482":118830,"_5":14053,"_26831":118776,"_2843":118831},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3355":70106,"_29485":70085,"_20482":118833,"_5":14053,"_26831":118776,"_2843":118834},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3355":70107,"_29485":70085,"_20482":118836,"_5":14053,"_26831":118776,"_2843":118837},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3355":70108,"_29485":70085,"_20482":118839,"_5":14053,"_26831":118780,"_2843":118840},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3355":70109,"_29485":70085,"_20482":118842,"_5":14053,"_26831":118784,"_2843":118843},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3355":70110,"_29485":70085,"_20482":118845,"_5":14053,"_26831":118788,"_2843":118846},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3355":70111,"_29485":70085,"_20482":118848,"_5":14053,"_26831":118792,"_2843":118849},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3355":70112,"_29485":70085,"_20482":118851,"_5":14053,"_26831":118792,"_2843":118852},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3355":70113,"_29485":70085,"_20482":118854,"_5":14053,"_26831":118792,"_2843":118855},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3355":70114,"_29485":70085,"_20482":118857,"_5":14053,"_26831":118796,"_2843":118858},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3355":70115,"_29485":70085,"_20482":118860,"_5":14053,"_26831":118796,"_2843":118861},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3355":70116,"_29485":70085,"_20482":118863,"_5":14053,"_26831":118796,"_2843":118864},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3355":70117,"_29485":70085,"_20482":118866,"_5":14053,"_26831":118800,"_2843":118867},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3355":70118,"_29485":70085,"_20482":118869,"_5":14053,"_26831":118800,"_2843":118870},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3355":70119,"_29485":70119,"_5":14411,"_2843":118872,"_29817":118873,"_20482":118875,"_26831":70119},"Ciclo de vida de un certificado",[47939,114128,53416,118874],"Conceptos",[],{"_3355":70120,"_29485":70119,"_20482":118877,"_5":14053,"_26831":70119,"_2843":118878},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3355":70121,"_29485":70119,"_5":29814,"_20482":118880,"_26831":118881,"_2843":118882},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3355":70122,"_29485":70119,"_5":29814,"_20482":118884,"_26831":118885,"_2843":118886},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3355":70123,"_29485":70119,"_5":29814,"_20482":118888,"_26831":118889,"_2843":118890},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3355":70124,"_29485":70119,"_5":29814,"_20482":118892,"_26831":118893,"_2843":118894},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3355":70125,"_29485":70119,"_5":29814,"_20482":118896,"_26831":118897,"_2843":118898},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3355":70126,"_29485":70119,"_5":29814,"_20482":118900,"_26831":118901,"_2843":118902},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3355":70127,"_29485":70119,"_5":29814,"_20482":118904,"_26831":118905,"_2843":116584},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3355":70128,"_29485":70119,"_5":29814,"_20482":118907,"_26831":118908,"_2843":118909},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3355":70129,"_29485":70119,"_5":29814,"_20482":118911,"_26831":118912,"_2843":118913},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3355":70130,"_29485":70119,"_5":29814,"_20482":118915,"_26831":118916,"_2843":118917},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3355":70131,"_29485":70119,"_20482":118919,"_5":14053,"_26831":70119,"_2843":118920},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3355":70132,"_29485":70119,"_20482":118922,"_5":14053,"_26831":118885,"_2843":118923},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3355":70133,"_29485":70119,"_20482":118925,"_5":14053,"_26831":118889,"_2843":118926},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3355":70134,"_29485":70119,"_20482":118928,"_5":14053,"_26831":118893,"_2843":118929},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3355":70135,"_29485":70119,"_20482":118931,"_5":14053,"_26831":118897,"_2843":118932},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3355":70136,"_29485":70119,"_20482":118934,"_5":14053,"_26831":118901,"_2843":118935},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3355":70137,"_29485":70119,"_20482":118937,"_5":14053,"_26831":118905,"_2843":118938},[],"Lamassu persiste cuatro estados X.509:",{"_3355":70138,"_29485":70119,"_20482":118940,"_5":14053,"_26831":118905,"_2843":118941},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3355":70139,"_29485":70119,"_20482":118943,"_5":14053,"_26831":118905,"_2843":118944},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3355":70140,"_29485":70119,"_20482":118946,"_5":14053,"_26831":118905,"_2843":118947},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3355":70141,"_29485":70119,"_20482":118949,"_5":14053,"_26831":118905,"_2843":118950},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3355":70142,"_29485":70119,"_20482":118952,"_5":14053,"_26831":118905,"_2843":118953},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3355":70143,"_29485":70119,"_20482":118955,"_5":14053,"_26831":118908,"_2843":118956},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3355":70144,"_29485":70119,"_20482":118958,"_5":14053,"_26831":118908,"_2843":118959},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3355":70145,"_29485":70119,"_20482":118961,"_5":14053,"_26831":118908,"_2843":118962},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3355":70146,"_29485":70119,"_20482":118964,"_5":14053,"_26831":118912,"_2843":118965},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3355":70147,"_29485":70119,"_20482":118967,"_5":14053,"_26831":118912,"_2843":118968},[],"Antes de confirmar:",{"_3355":70148,"_29485":70119,"_20482":118970,"_5":14053,"_26831":118912,"_2843":118971},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3355":70149,"_29485":70119,"_20482":118973,"_5":14053,"_26831":118912,"_2843":118974},[],"Distribuye la nueva cadena de confianza.",{"_3355":70150,"_29485":70119,"_20482":118976,"_5":14053,"_26831":118912,"_2843":118977},[],"Reemite las identidades necesarias.",{"_3355":70151,"_29485":70119,"_20482":118979,"_5":14053,"_26831":118912,"_2843":118980},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3355":70152,"_29485":70119,"_20482":118982,"_5":14053,"_26831":118912,"_2843":118983},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3355":70153,"_29485":70119,"_20482":118985,"_5":14053,"_26831":118912,"_2843":118986},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3355":70154,"_29485":70119,"_20482":118988,"_5":14053,"_26831":118916,"_2843":118989},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3355":70155,"_29485":70119,"_20482":118991,"_5":14053,"_26831":118916,"_2843":118992},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3355":70156,"_29485":70119,"_20482":118994,"_5":14053,"_26831":118916,"_2843":118995},[],"Cambios de estado y razones de revocación.",{"_3355":70157,"_29485":70119,"_20482":118997,"_5":14053,"_26831":118916,"_2843":118998},[],"Publicación y vigencia de OCSP y CRLs.",{"_3355":70158,"_29485":70119,"_20482":119000,"_5":14053,"_26831":118916,"_2843":119001},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3355":70159,"_29485":70119,"_20482":119003,"_5":14053,"_26831":118916,"_2843":119004},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3355":70160,"_29485":70160,"_5":14411,"_2843":119006,"_29817":119007,"_20482":119008,"_26831":70160},"Modelo de confianza",[47939,114128,53416,118874],[],{"_3355":70161,"_29485":70160,"_20482":119010,"_5":14053,"_26831":70160,"_2843":119011},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3355":70162,"_29485":70160,"_5":29814,"_20482":119013,"_26831":119014,"_2843":119015},[],"/docs/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3355":70163,"_29485":70160,"_5":29814,"_20482":119017,"_26831":119018,"_2843":119019},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3355":70164,"_29485":70160,"_5":29814,"_20482":119021,"_26831":119022,"_2843":119023},[],"/docs/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3355":70165,"_29485":70160,"_5":29814,"_20482":119025,"_26831":119026,"_2843":119027},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3355":70166,"_29485":70160,"_5":29814,"_20482":119029,"_26831":119030,"_2843":119031},[],"/docs/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3355":70167,"_29485":70160,"_5":29814,"_20482":119033,"_26831":119034,"_2843":119035},[],"/docs/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3355":70168,"_29485":70160,"_5":29814,"_20482":119037,"_26831":119038,"_2843":119039},[],"/docs/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3355":70169,"_29485":70160,"_5":29814,"_20482":119041,"_26831":119042,"_2843":119043},[],"/docs/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3355":70170,"_29485":70160,"_5":29814,"_20482":119045,"_26831":119046,"_2843":119047},[],"/docs/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3355":70171,"_29485":70160,"_5":29814,"_20482":119049,"_26831":119050,"_2843":119051},[],"/docs/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3355":70172,"_29485":70160,"_20482":119053,"_5":14053,"_26831":70160,"_2843":119054},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3355":70173,"_29485":70160,"_20482":119056,"_5":14053,"_26831":119018,"_2843":119057},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3355":70174,"_29485":70160,"_20482":119059,"_5":14053,"_26831":119022,"_2843":119060},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3355":70175,"_29485":70160,"_20482":119062,"_5":14053,"_26831":119026,"_2843":119063},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3355":70176,"_29485":70160,"_20482":119065,"_5":14053,"_26831":119030,"_2843":119066},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3355":70177,"_29485":70160,"_20482":119068,"_5":14053,"_26831":119034,"_2843":119069},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3355":70178,"_29485":70160,"_20482":119071,"_5":14053,"_26831":119034,"_2843":119072},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3355":70179,"_29485":70160,"_20482":119074,"_5":14053,"_26831":119034,"_2843":119075},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3355":70180,"_29485":70160,"_20482":119077,"_5":14053,"_26831":119034,"_2843":119078},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3355":70181,"_29485":70160,"_20482":119080,"_5":14053,"_26831":119034,"_2843":119081},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3355":70182,"_29485":70160,"_20482":119083,"_5":14053,"_26831":119034,"_2843":119084},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3355":70183,"_29485":70160,"_20482":119086,"_5":14053,"_26831":119038,"_2843":119087},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3355":70184,"_29485":70160,"_20482":119089,"_5":14053,"_26831":119038,"_2843":119090},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3355":70185,"_29485":70160,"_20482":119092,"_5":14053,"_26831":119038,"_2843":119093},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3355":70186,"_29485":70160,"_20482":119095,"_5":14053,"_26831":119038,"_2843":119096},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3355":70187,"_29485":70160,"_20482":119098,"_5":14053,"_26831":119038,"_2843":119099},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3355":70188,"_29485":70160,"_20482":119101,"_5":14053,"_26831":119042,"_2843":119102},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3355":70189,"_29485":70160,"_20482":119104,"_5":14053,"_26831":119042,"_2843":119105},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3355":70190,"_29485":70160,"_20482":119107,"_5":14053,"_26831":119042,"_2843":119108},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3355":70191,"_29485":70160,"_20482":119110,"_5":14053,"_26831":119042,"_2843":119111},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3355":70192,"_29485":70160,"_20482":119113,"_5":14053,"_26831":119042,"_2843":119114},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3355":70193,"_29485":70160,"_20482":119116,"_5":14053,"_26831":119042,"_2843":119117},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3355":70194,"_29485":70160,"_20482":119119,"_5":14053,"_26831":119042,"_2843":119120},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3355":70195,"_29485":70160,"_20482":119122,"_5":14053,"_26831":119046,"_2843":119123},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3355":70196,"_29485":70160,"_20482":119125,"_5":14053,"_26831":119050,"_2843":119126},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3355":70197,"_29485":70160,"_20482":119128,"_5":14053,"_26831":119050,"_2843":119129},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3355":70198,"_29485":70160,"_20482":119131,"_5":14053,"_26831":119050,"_2843":119132},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3355":70199,"_29485":70160,"_20482":119134,"_5":14053,"_26831":119050,"_2843":119135},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3355":70200,"_29485":70160,"_20482":119137,"_5":14053,"_26831":119050,"_2843":119138},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3355":70201,"_29485":70160,"_20482":119140,"_5":14053,"_26831":119050,"_2843":119141},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3355":70202,"_29485":70160,"_20482":119143,"_5":14053,"_26831":119050,"_2843":119144},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3355":70203,"_29485":70203,"_5":14411,"_2843":119146,"_29817":119147,"_20482":119148,"_26831":70203},"Listas de revocación (CRL)",[47939,114128,53416,118635],[],{"_3355":70204,"_29485":70203,"_20482":119150,"_5":14053,"_26831":70203,"_2843":119151},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3355":70205,"_29485":70203,"_5":29814,"_20482":119153,"_26831":119154,"_2843":119155},[],"/docs/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_3355":70206,"_29485":70203,"_5":29814,"_20482":119157,"_26831":119158,"_2843":119159},[],"/docs/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3355":70207,"_29485":70203,"_5":29814,"_20482":119161,"_26831":119162,"_2843":119163},[],"/docs/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3355":70208,"_29485":70203,"_5":29814,"_20482":119165,"_26831":119166,"_2843":119167},[],"/docs/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3355":70209,"_29485":70203,"_5":29814,"_20482":119169,"_26831":119170,"_2843":119171},[],"/docs/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3355":70210,"_29485":70203,"_5":29814,"_20482":119173,"_26831":119174,"_2843":119175},[],"/docs/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_3355":70211,"_29485":70203,"_5":29814,"_20482":119177,"_26831":119178,"_2843":119179},[],"/docs/es/platform/pki/crl#errores-frecuentes-del-rol-va","Errores frecuentes del rol VA",{"_3355":70212,"_29485":70203,"_5":29814,"_20482":119181,"_26831":119182,"_2843":119183},[],"/docs/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3355":70213,"_29485":70203,"_5":29814,"_20482":119185,"_26831":119186,"_2843":119187},[],"/docs/es/platform/pki/crl#referencias","Referencias",{"_3355":70214,"_29485":70203,"_20482":119189,"_5":14053,"_26831":70203,"_2843":119190},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3355":70215,"_29485":70203,"_20482":119192,"_5":14053,"_26831":119154,"_2843":119193},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3355":70216,"_29485":70203,"_20482":119195,"_5":14053,"_26831":119154,"_2843":119196},[],"Campo de `crl_options`",{"_3355":70217,"_29485":70203,"_20482":119198,"_5":14053,"_26831":119154,"_2843":115666},[],{"_3355":70218,"_29485":70203,"_20482":119200,"_5":14053,"_26831":119154,"_2843":119201},[],"Valor inicial del backend",{"_3355":70219,"_29485":70203,"_20482":119203,"_5":14053,"_26831":119154,"_2843":54614},[],{"_3355":70220,"_29485":70203,"_20482":119205,"_5":14053,"_26831":119154,"_2843":119206},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3355":70221,"_29485":70203,"_20482":119208,"_5":14053,"_26831":119154,"_2843":119209},[],"7 días.",{"_3355":70222,"_29485":70203,"_20482":119211,"_5":14053,"_26831":119154,"_2843":54623},[],{"_3355":70223,"_29485":70203,"_20482":119213,"_5":14053,"_26831":119154,"_2843":119214},[],"Se guarda y se devuelve por la API, pero la VA no lo utiliza: la renovación programada no depende de él (consulta Regeneración periódica y automática).",{"_3355":70224,"_29485":70203,"_20482":119216,"_5":14053,"_26831":119154,"_2843":119217},[],"6 días y 23 horas.",{"_3355":70225,"_29485":70203,"_20482":119219,"_5":14053,"_26831":119154,"_2843":54632},[],{"_3355":70226,"_29485":70203,"_20482":119221,"_5":14053,"_26831":119154,"_2843":119222},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3355":70227,"_29485":70203,"_20482":119224,"_5":14053,"_26831":119154,"_2843":54638},[],{"_3355":70228,"_29485":70203,"_20482":119226,"_5":14053,"_26831":119154,"_2843":54641},[],{"_3355":70229,"_29485":70203,"_20482":119228,"_5":14053,"_26831":119154,"_2843":119229},[],"Número de serie del certificado existente que firma la CRL.",{"_3355":70230,"_29485":70203,"_20482":119231,"_5":14053,"_26831":119154,"_2843":119232},[],"Número de serie del certificado actual de la CA.",{"_3355":70231,"_29485":70203,"_20482":119234,"_5":14053,"_26831":119154,"_2843":119235},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3355":70232,"_29485":70203,"_20482":119237,"_5":14053,"_26831":119154,"_2843":119238},[],"Al reemitir una CA, el rol sigue apuntando al certificado anterior. Las CRL siguen siendo válidas porque ambos certificados comparten sujeto y clave, pero el certificado anterior no puede eliminarse mientras el rol lo use. Para retirarlo, actualiza el firmante del rol.",{"_3355":70233,"_29485":70203,"_20482":119240,"_5":14053,"_26831":119154,"_2843":119241},[],"Al eliminar una CA, su rol VA se conserva y no puede borrarse por API. Si no queda ninguna otra CA con el mismo SKI, el rol puede consultarse pero cualquier `PUT` devuelve 404, y el trabajo de renovación registra un aviso en cada ciclo porque ya no encuentra la CA. La API no ofrece salida; solo se corrige editando la base de datos. Si queda otra CA con ese SKI, el rol sigue siendo editable (consulta CAs que comparten clave). Ajusta validez y firmante antes de eliminar la CA.",{"_3355":70234,"_29485":70203,"_20482":119243,"_5":14053,"_26831":119154,"_2843":119244},[],"Una CA cuyo certificado no tiene `cRLSign` no puede generar su CRL ni editar su rol (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y asígnalo como firmante con `PUT`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original.",{"_3355":70235,"_29485":70203,"_20482":119246,"_5":14053,"_26831":119154,"_2843":119247},[],"El `PUT` valida siempre el firmante, aunque la petición no lo cambie. Si el firmante guardado ya no es válido, no se puede modificar ningún campo del rol, ni siquiera la validez, hasta asignar uno válido.",{"_3355":70236,"_29485":70203,"_20482":119249,"_5":14053,"_26831":119154,"_2843":119250},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_3355":70237,"_29485":70203,"_20482":119252,"_5":14053,"_26831":119158,"_2843":119253},[],"La VA identifica cada CRL por el SKI de la CA, y el SKI se deriva de su clave. Dos CAs con la misma clave tienen el mismo SKI y comparten un único rol VA y una única CRL. Ocurre al crear una CA sobre una clave ya existente del KMS, o al importar una CA cuyo certificado declara un SKI en uso. Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. El rol lo crea la primera CA y las demás lo conservan.",{"_3355":70238,"_29485":70203,"_20482":119255,"_5":14053,"_26831":119158,"_2843":119256},[],"Los certificados de todas ellas apuntan a `/crl/{ski}`, pero la lista publicada tiene como emisor a la primera CA y solo incluye sus revocaciones. Un verificador compara el emisor de la CRL con el del certificado que valida (RFC 5280, §6.3.2) y rechaza la lista si no coinciden. Según su política, el certificado queda bloqueado (*hard-fail*) o se acepta aunque esté revocado (*soft-fail*). Las revocaciones de las CAs secundarias no aparecen en ninguna lista.",{"_3355":70239,"_29485":70203,"_20482":119258,"_5":14053,"_26831":119158,"_2843":119259},[],"Si la primera CA se elimina, la generación de CRL de la restante falla porque el firmante configurado ya no corresponde a una CA con ese nombre. Hasta que se actualice el firmante del rol a un certificado de la CA restante, se sigue sirviendo la última lista publicada hasta que venza (7 días por defecto).",{"_3355":70240,"_29485":70203,"_20482":119261,"_5":14053,"_26831":119158,"_2843":119262},[],"Para detectar el problema, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos. Una CA importada con un SKI ya en uso no sustituye a la existente como emisora de la CRL, porque el emisor se resuelve a partir del firmante del rol. Sin embargo, sus propios certificados apuntan a esa misma URL y sus revocaciones no se publican. Hasta que Lamassu rechace estas importaciones, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión, así que tampoco reutilices claves entre CAs. Una CRL por CA y el rechazo de importaciones cuyo SKI colisiona con el de una CA existente están planteados en lamassuiot#834, y ninguno está implementado todavía.",{"_3355":70241,"_29485":70203,"_20482":119264,"_5":14053,"_26831":119162,"_2843":119265},[],"El trabajo programado de la VA revisa todos los roles en cada ejecución y solicita otra lista cuando a `latest_crl` le queda menos validez que el intervalo entre ejecuciones. La frecuencia se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. `refresh_interval` no interviene. Mantén `validity` claramente por encima del intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3355":70242,"_29485":70203,"_20482":119267,"_5":14053,"_26831":119162,"_2843":119268},[],"Si la generación falla (por ejemplo, por un rol sin CA o un firmante inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ski>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3355":70243,"_29485":70203,"_20482":119270,"_5":14053,"_26831":119162,"_2843":119271},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla (rol inexistente, firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3355":70244,"_29485":70203,"_20482":119273,"_5":14053,"_26831":119162,"_2843":119274},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3355":70245,"_29485":70203,"_20482":119276,"_5":14053,"_26831":119166,"_2843":119277},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3355":70246,"_29485":70203,"_20482":119279,"_5":14053,"_26831":119166,"_2843":119280},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3355":70247,"_29485":70203,"_20482":119282,"_5":14053,"_26831":119170,"_2843":119283},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_3355":70248,"_29485":70203,"_20482":119285,"_5":14053,"_26831":119170,"_2843":119286},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3355":70249,"_29485":70203,"_20482":119288,"_5":14053,"_26831":119170,"_2843":119289},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3355":70250,"_29485":70203,"_20482":119291,"_5":14053,"_26831":119170,"_2843":119292},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3355":70251,"_29485":70203,"_20482":119294,"_5":14053,"_26831":119170,"_2843":119295},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3355":70252,"_29485":70203,"_20482":119297,"_5":14053,"_26831":119174,"_2843":119298},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3355":70253,"_29485":70203,"_20482":119300,"_5":14053,"_26831":119174,"_2843":115855},[],{"_3355":70254,"_29485":70203,"_20482":119302,"_5":14053,"_26831":119174,"_2843":119303},[],"Path relativo",{"_3355":70255,"_29485":70203,"_20482":119305,"_5":14053,"_26831":119174,"_2843":113888},[],{"_3355":70256,"_29485":70203,"_20482":119307,"_5":14053,"_26831":119174,"_2843":54723},[],{"_3355":70257,"_29485":70203,"_20482":119309,"_5":14053,"_26831":119174,"_2843":54726},[],{"_3355":70258,"_29485":70203,"_20482":119311,"_5":14053,"_26831":119174,"_2843":119312},[],"Consultar `crl_options` y `latest_crl`.",{"_3355":70259,"_29485":70203,"_20482":119314,"_5":14053,"_26831":119174,"_2843":54732},[],{"_3355":70260,"_29485":70203,"_20482":119316,"_5":14053,"_26831":119174,"_2843":54726},[],{"_3355":70261,"_29485":70203,"_20482":119318,"_5":14053,"_26831":119174,"_2843":119319},[],"Sustituir la configuración de CRL.",{"_3355":70262,"_29485":70203,"_20482":119321,"_5":14053,"_26831":119174,"_2843":119322},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_3355":70263,"_29485":70203,"_20482":119324,"_5":14053,"_26831":119174,"_2843":119325},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3355":70264,"_29485":70203,"_20482":119327,"_5":14053,"_26831":119178,"_2843":119328},[],"Síntoma",{"_3355":70265,"_29485":70203,"_20482":119330,"_5":14053,"_26831":119178,"_2843":119331},[],"Causa",{"_3355":70266,"_29485":70203,"_20482":119333,"_5":14053,"_26831":119178,"_2843":119334},[],"Acción",{"_3355":70267,"_29485":70203,"_20482":119336,"_5":14053,"_26831":119178,"_2843":119337},[],"`PUT /v1/roles/{ca-ski}` devuelve 404 y `GET` devuelve 200.",{"_3355":70268,"_29485":70203,"_20482":119339,"_5":14053,"_26831":119178,"_2843":119340},[],"Se eliminó la CA del rol y no queda otra con el mismo SKI.",{"_3355":70269,"_29485":70203,"_20482":119342,"_5":14053,"_26831":119178,"_2843":119343},[],"No hay salida por API; requiere intervención en la base de datos. Evítalo ajustando el rol antes de eliminar la CA.",{"_3355":70270,"_29485":70203,"_20482":119345,"_5":14053,"_26831":119178,"_2843":119346},[],"`PUT` devuelve 400.",{"_3355":70271,"_29485":70203,"_20482":119348,"_5":14053,"_26831":119178,"_2843":119349},[],"El firmante no tiene `cRLSign`, o su sujeto y su clave no coinciden con ninguna CA de ese SKI (por ejemplo, tras eliminar la primera de dos CAs que comparten clave).",{"_3355":70272,"_29485":70203,"_20482":119351,"_5":14053,"_26831":119178,"_2843":119352},[],"Asigna con `PUT` el número de serie de un certificado válido de la CA restante.",{"_3355":70273,"_29485":70203,"_20482":119354,"_5":14053,"_26831":119178,"_2843":119355},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3355":70274,"_29485":70203,"_20482":119357,"_5":14053,"_26831":119178,"_2843":119358},[],"`crl_options.subject_key_id_signer` se sustituyó por `signer_certificate_serial_number`, que es obligatorio.",{"_3355":70275,"_29485":70203,"_20482":119360,"_5":14053,"_26831":119178,"_2843":119361},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3355":70276,"_29485":70203,"_20482":119363,"_5":14053,"_26831":119178,"_2843":119364},[],"La CRL no cambia tras revocar un certificado.",{"_3355":70277,"_29485":70203,"_20482":119366,"_5":14053,"_26831":119178,"_2843":119367},[],"`regenerate_on_revoke` es `false`, o el evento falló por falta de rol o por un firmante inválido.",{"_3355":70278,"_29485":70203,"_20482":119369,"_5":14053,"_26831":119178,"_2843":119370},[],"Revisa los logs de la VA y la cola de eventos fallidos; corrige el firmante.",{"_3355":70279,"_29485":70203,"_20482":119372,"_5":14053,"_26831":119178,"_2843":119373},[],"Un verificador rechaza la CRL por el emisor.",{"_3355":70280,"_29485":70203,"_20482":119375,"_5":14053,"_26831":119178,"_2843":119376},[],"Varias CAs comparten SKI.",{"_3355":70281,"_29485":70203,"_20482":119378,"_5":14053,"_26831":119178,"_2843":119379},[],"Consulta CAs que comparten clave.",{"_3355":70282,"_29485":70203,"_20482":119381,"_5":14053,"_26831":119182,"_2843":119382},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3355":70283,"_29485":70203,"_20482":119384,"_5":14053,"_26831":119186,"_2843":119385},[],"RFC 5280: perfil X.509 y CRL.",{"_3355":70284,"_29485":70203,"_20482":119387,"_5":14053,"_26831":119186,"_2843":54806},[],{"_3355":70285,"_29485":70203,"_20482":119389,"_5":14053,"_26831":119186,"_2843":54809},[],{"_3355":70286,"_29485":70203,"_20482":119391,"_5":14053,"_26831":119186,"_2843":119392},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3355":70287,"_29485":70203,"_20482":119394,"_5":14053,"_26831":119186,"_2843":119395},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3355":70288,"_29485":70288,"_5":14411,"_2843":119397,"_29817":119398,"_20482":119399,"_26831":70288},"Claves y motores criptográficos",[47939,114128,53416,118010],[],{"_3355":70289,"_29485":70288,"_20482":119401,"_5":14053,"_26831":70288,"_2843":119402},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3355":70290,"_29485":70288,"_5":29814,"_20482":119404,"_26831":119405,"_2843":119406},[],"/docs/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3355":70291,"_29485":70288,"_5":29814,"_20482":119408,"_26831":119409,"_2843":119410},[],"/docs/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3355":70292,"_29485":70288,"_5":29814,"_20482":119412,"_26831":119413,"_2843":54834},[],"/docs/es/platform/pki/key-management#file-system",{"_3355":70293,"_29485":70288,"_5":29814,"_20482":119415,"_26831":119416,"_2843":54838},[],"/docs/es/platform/pki/key-management#hashicorp-vault",{"_3355":70294,"_29485":70288,"_5":29814,"_20482":119418,"_26831":119419,"_2843":54842},[],"/docs/es/platform/pki/key-management#aws-secrets-manager",{"_3355":70295,"_29485":70288,"_5":29814,"_20482":119421,"_26831":119422,"_2843":54846},[],"/docs/es/platform/pki/key-management#aws-kms",{"_3355":70296,"_29485":70288,"_5":29814,"_20482":119424,"_26831":119425,"_2843":54850},[],"/docs/es/platform/pki/key-management#pkcs11",{"_3355":70297,"_29485":70288,"_5":29814,"_20482":119427,"_26831":119428,"_2843":54854},[],"/docs/es/platform/pki/key-management#azure-key-vault",{"_3355":70298,"_29485":70288,"_5":29814,"_20482":119430,"_26831":119431,"_2843":119432},[],"/docs/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3355":70299,"_29485":70288,"_5":29814,"_20482":119434,"_26831":119435,"_2843":119436},[],"/docs/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3355":70300,"_29485":70288,"_5":29814,"_20482":119438,"_26831":119439,"_2843":119440},[],"/docs/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3355":70301,"_29485":70288,"_5":29814,"_20482":119442,"_26831":119443,"_2843":119444},[],"/docs/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3355":70302,"_29485":70288,"_5":29814,"_20482":119446,"_26831":119447,"_2843":119448},[],"/docs/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3355":70303,"_29485":70288,"_5":29814,"_20482":119450,"_26831":119451,"_2843":119452},[],"/docs/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3355":70304,"_29485":70288,"_5":29814,"_20482":119454,"_26831":119455,"_2843":119456},[],"/docs/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3355":70305,"_29485":70288,"_5":29814,"_20482":119458,"_26831":119459,"_2843":54886},[],"/docs/es/platform/pki/key-management#sign",{"_3355":70306,"_29485":70288,"_5":29814,"_20482":119461,"_26831":119462,"_2843":54890},[],"/docs/es/platform/pki/key-management#verify",{"_3355":70307,"_29485":70288,"_5":29814,"_20482":119464,"_26831":119465,"_2843":119466},[],"/docs/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3355":70308,"_29485":70288,"_5":29814,"_20482":119468,"_26831":119469,"_2843":119470},[],"/docs/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3355":70309,"_29485":70288,"_5":29814,"_20482":119472,"_26831":119473,"_2843":119474},[],"/docs/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3355":70310,"_29485":70288,"_20482":119476,"_5":14053,"_26831":70288,"_2843":119477},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3355":70311,"_29485":70288,"_20482":119479,"_5":14053,"_26831":70288,"_2843":119480},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3355":70312,"_29485":70288,"_20482":119482,"_5":14053,"_26831":119405,"_2843":119483},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3355":70313,"_29485":70288,"_20482":119485,"_5":14053,"_26831":119405,"_2843":119486},[],"En la práctica, permite:",{"_3355":70314,"_29485":70288,"_20482":119488,"_5":14053,"_26831":119405,"_2843":119489},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3355":70315,"_29485":70288,"_20482":119491,"_5":14053,"_26831":119405,"_2843":119492},[],"Importar claves creadas externamente.",{"_3355":70316,"_29485":70288,"_20482":119494,"_5":14053,"_26831":119405,"_2843":119495},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3355":70317,"_29485":70288,"_20482":119497,"_5":14053,"_26831":119405,"_2843":119498},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3355":70318,"_29485":70288,"_20482":119500,"_5":14053,"_26831":119409,"_2843":119501},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3355":70319,"_29485":70288,"_20482":119503,"_5":14053,"_26831":119409,"_2843":119504},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3355":70320,"_29485":70288,"_20482":119506,"_5":14053,"_26831":119409,"_2843":119507},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3355":70321,"_29485":70288,"_20482":119509,"_5":14053,"_26831":119413,"_2843":119510},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3355":70322,"_29485":70288,"_20482":119512,"_5":14053,"_26831":119416,"_2843":119513},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3355":70323,"_29485":70288,"_20482":119515,"_5":14053,"_26831":119416,"_2843":119516},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3355":70324,"_29485":70288,"_20482":119518,"_5":14053,"_26831":119419,"_2843":119519},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3355":70325,"_29485":70288,"_20482":119521,"_5":14053,"_26831":119422,"_2843":119522},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3355":70326,"_29485":70288,"_20482":119524,"_5":14053,"_26831":119425,"_2843":119525},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3355":70327,"_29485":70288,"_20482":119527,"_5":14053,"_26831":119428,"_2843":119528},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3355":70328,"_29485":70288,"_20482":119530,"_5":14053,"_26831":119428,"_2843":119531},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3355":70329,"_29485":70288,"_20482":119533,"_5":14053,"_26831":119428,"_2843":119534},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3355":70330,"_29485":70288,"_20482":119536,"_5":14053,"_26831":119428,"_2843":119537},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3355":70331,"_29485":70288,"_20482":119539,"_5":14053,"_26831":119431,"_2843":119540},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3355":70332,"_29485":70288,"_20482":119542,"_5":14053,"_26831":119431,"_2843":119543},[],"La tabla incluye los siguientes campos:",{"_3355":70333,"_29485":70288,"_20482":119545,"_5":14053,"_26831":119431,"_2843":119546},[],"**Name**: nombre descriptivo de la clave.",{"_3355":70334,"_29485":70288,"_20482":119548,"_5":14053,"_26831":119431,"_2843":119549},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3355":70335,"_29485":70288,"_20482":119551,"_5":14053,"_26831":119431,"_2843":119552},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3355":70336,"_29485":70288,"_20482":119554,"_5":14053,"_26831":119431,"_2843":119555},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3355":70337,"_29485":70288,"_20482":119557,"_5":14053,"_26831":119431,"_2843":119558},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3355":70338,"_29485":70288,"_20482":119560,"_5":14053,"_26831":119431,"_2843":119561},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3355":70339,"_29485":70288,"_20482":119563,"_5":14053,"_26831":119431,"_2843":119564},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3355":70340,"_29485":70288,"_20482":119566,"_5":14053,"_26831":119431,"_2843":119567},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3355":70341,"_29485":70288,"_20482":119569,"_5":14053,"_26831":119431,"_2843":119570},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3355":70342,"_29485":70288,"_20482":119572,"_5":14053,"_26831":119431,"_2843":119573},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3355":70343,"_29485":70288,"_20482":119575,"_5":14053,"_26831":119431,"_2843":119576},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3355":70344,"_29485":70288,"_20482":119578,"_5":14053,"_26831":119431,"_2843":119579},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3355":70345,"_29485":70288,"_20482":119581,"_5":14053,"_26831":119431,"_2843":119582},[],"**Delete Key** para eliminar la clave del sistema.",{"_3355":70346,"_29485":70288,"_20482":119584,"_5":14053,"_26831":119435,"_2843":119585},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3355":70347,"_29485":70288,"_20482":119587,"_5":14053,"_26831":119439,"_2843":119588},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3355":70348,"_29485":70288,"_20482":119590,"_5":14053,"_26831":119439,"_2843":119591},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3355":70349,"_29485":70288,"_20482":119593,"_5":14053,"_26831":119439,"_2843":119594},[],"**Key Name**: nombre único y descriptivo.",{"_3355":70350,"_29485":70288,"_20482":119596,"_5":14053,"_26831":119439,"_2843":119597},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3355":70351,"_29485":70288,"_20482":119599,"_5":14053,"_26831":119439,"_2843":119600},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3355":70352,"_29485":70288,"_20482":119602,"_5":14053,"_26831":119439,"_2843":119603},[],"**Tags**: metadatos para clasificar la clave.",{"_3355":70353,"_29485":70288,"_20482":119605,"_5":14053,"_26831":119439,"_2843":119606},[],"**Metadata**: información adicional para usos avanzados.",{"_3355":70354,"_29485":70288,"_20482":119608,"_5":14053,"_26831":119443,"_2843":119609},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3355":70355,"_29485":70288,"_20482":119611,"_5":14053,"_26831":119443,"_2843":119612},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3355":70356,"_29485":70288,"_20482":119614,"_5":14053,"_26831":119443,"_2843":119615},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3355":70357,"_29485":70288,"_20482":119617,"_5":14053,"_26831":119443,"_2843":119618},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3355":70358,"_29485":70288,"_20482":119620,"_5":14053,"_26831":119443,"_2843":119621},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3355":70359,"_29485":70288,"_20482":119623,"_5":14053,"_26831":119443,"_2843":119624},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3355":70360,"_29485":70288,"_20482":119626,"_5":14053,"_26831":119443,"_2843":119627},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3355":70361,"_29485":70288,"_20482":119629,"_5":14053,"_26831":119443,"_2843":119630},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3355":70362,"_29485":70288,"_20482":119632,"_5":14053,"_26831":119443,"_2843":119633},[],"**Metadata**: información adicional opcional.",{"_3355":70363,"_29485":70288,"_20482":119635,"_5":14053,"_26831":119443,"_2843":119636},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3355":70364,"_29485":70288,"_20482":119638,"_5":14053,"_26831":119443,"_2843":119639},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3355":70365,"_29485":70288,"_20482":119641,"_5":14053,"_26831":119447,"_2843":119642},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3355":70366,"_29485":70288,"_20482":119644,"_5":14053,"_26831":119451,"_2843":119645},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3355":70367,"_29485":70288,"_20482":119647,"_5":14053,"_26831":119451,"_2843":119648},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3355":70368,"_29485":70288,"_20482":119650,"_5":14053,"_26831":119451,"_2843":119651},[],"**Key Name**: nombre descriptivo.",{"_3355":70369,"_29485":70288,"_20482":119653,"_5":14053,"_26831":119451,"_2843":119654},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3355":70370,"_29485":70288,"_20482":119656,"_5":14053,"_26831":119451,"_2843":119657},[],"**Tags**: etiquetas asociadas.",{"_3355":70371,"_29485":70288,"_20482":119659,"_5":14053,"_26831":119451,"_2843":119660},[],"**Aliases**: nombres alternativos.",{"_3355":70372,"_29485":70288,"_20482":119662,"_5":14053,"_26831":119451,"_2843":119663},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3355":70373,"_29485":70288,"_20482":119665,"_5":14053,"_26831":119451,"_2843":119666},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3355":70374,"_29485":70288,"_20482":119668,"_5":14053,"_26831":119451,"_2843":119669},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3355":70375,"_29485":70288,"_20482":119671,"_5":14053,"_26831":119451,"_2843":119672},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3355":70376,"_29485":70288,"_20482":119674,"_5":14053,"_26831":119455,"_2843":119675},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3355":70377,"_29485":70288,"_20482":119677,"_5":14053,"_26831":119455,"_2843":119678},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3355":70378,"_29485":70288,"_20482":119680,"_5":14053,"_26831":119455,"_2843":119681},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3355":70379,"_29485":70288,"_20482":119683,"_5":14053,"_26831":119459,"_2843":119684},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3355":70380,"_29485":70288,"_20482":119686,"_5":14053,"_26831":119459,"_2843":119687},[],"Campos principales:",{"_3355":70381,"_29485":70288,"_20482":119689,"_5":14053,"_26831":119459,"_2843":119690},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3355":70382,"_29485":70288,"_20482":119692,"_5":14053,"_26831":119459,"_2843":119693},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3355":70383,"_29485":70288,"_20482":119695,"_5":14053,"_26831":119459,"_2843":119696},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3355":70384,"_29485":70288,"_20482":119698,"_5":14053,"_26831":119459,"_2843":119699},[],"**Message**: contenido que se va a firmar.",{"_3355":70385,"_29485":70288,"_20482":119701,"_5":14053,"_26831":119459,"_2843":119702},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3355":70386,"_29485":70288,"_20482":119704,"_5":14053,"_26831":119462,"_2843":119705},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3355":70387,"_29485":70288,"_20482":119707,"_5":14053,"_26831":119462,"_2843":119687},[],{"_3355":70388,"_29485":70288,"_20482":119709,"_5":14053,"_26831":119462,"_2843":119710},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3355":70389,"_29485":70288,"_20482":119712,"_5":14053,"_26831":119462,"_2843":119713},[],"**Message Type**: `Raw` o `Digest`.",{"_3355":70390,"_29485":70288,"_20482":119715,"_5":14053,"_26831":119462,"_2843":119716},[],"**Payload Encoding**: codificación del mensaje.",{"_3355":70391,"_29485":70288,"_20482":119718,"_5":14053,"_26831":119462,"_2843":119719},[],"**Message**: mensaje original o hash.",{"_3355":70392,"_29485":70288,"_20482":119721,"_5":14053,"_26831":119462,"_2843":119722},[],"**Signature**: firma que se desea comprobar.",{"_3355":70393,"_29485":70288,"_20482":119724,"_5":14053,"_26831":119462,"_2843":119725},[],"**Result**: indicador del resultado de la validación.",{"_3355":70394,"_29485":70288,"_20482":119727,"_5":14053,"_26831":119465,"_2843":119728},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3355":70395,"_29485":70288,"_20482":119730,"_5":14053,"_26831":119465,"_2843":119731},[],"Este flujo es útil para:",{"_3355":70396,"_29485":70288,"_20482":119733,"_5":14053,"_26831":119465,"_2843":119734},[],"Solicitar certificados a una CA externa.",{"_3355":70397,"_29485":70288,"_20482":119736,"_5":14053,"_26831":119465,"_2843":119737},[],"Renovar una identidad manteniendo la misma clave.",{"_3355":70398,"_29485":70288,"_20482":119739,"_5":14053,"_26831":119465,"_2843":119740},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3355":70399,"_29485":70288,"_20482":119742,"_5":14053,"_26831":119465,"_2843":119743},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3355":70400,"_29485":70288,"_20482":119745,"_5":14053,"_26831":119465,"_2843":119746},[],"**Organization (O)**: organización o empresa.",{"_3355":70401,"_29485":70288,"_20482":119748,"_5":14053,"_26831":119465,"_2843":119749},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3355":70402,"_29485":70288,"_20482":119751,"_5":14053,"_26831":119465,"_2843":119752},[],"**Country (C)**: código de país de dos letras.",{"_3355":70403,"_29485":70288,"_20482":119754,"_5":14053,"_26831":119465,"_2843":119755},[],"**State / Province (ST)**: estado o provincia.",{"_3355":70404,"_29485":70288,"_20482":119757,"_5":14053,"_26831":119465,"_2843":119758},[],"**Locality (L)**: ciudad o localidad.",{"_3355":70405,"_29485":70288,"_20482":119760,"_5":14053,"_26831":119465,"_2843":119761},[],"**Email Address**: correo de contacto.",{"_3355":70406,"_29485":70288,"_20482":119763,"_5":14053,"_26831":119465,"_2843":119764},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3355":70407,"_29485":70288,"_20482":119766,"_5":14053,"_26831":119465,"_2843":119767},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3355":70408,"_29485":70288,"_20482":119769,"_5":14053,"_26831":119469,"_2843":119770},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3355":70409,"_29485":70288,"_20482":119772,"_5":14053,"_26831":119469,"_2843":55201},[],{"_3355":70410,"_29485":70288,"_20482":119774,"_5":14053,"_26831":119473,"_2843":119775},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3355":70411,"_29485":70411,"_5":14411,"_2843":119777,"_29817":119778,"_20482":119779,"_26831":70411},"Validación online con OCSP",[47939,114128,53416,118635],[],{"_3355":70412,"_29485":70411,"_20482":119781,"_5":14053,"_26831":70411,"_2843":119782},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3355":70413,"_29485":70411,"_5":29814,"_20482":119784,"_26831":119785,"_2843":119786},[],"/docs/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3355":70414,"_29485":70411,"_5":29814,"_20482":119788,"_26831":119789,"_2843":119790},[],"/docs/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3355":70415,"_29485":70411,"_5":29814,"_20482":119792,"_26831":119793,"_2843":119794},[],"/docs/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3355":70416,"_29485":70411,"_5":29814,"_20482":119796,"_26831":119797,"_2843":119798},[],"/docs/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3355":70417,"_29485":70411,"_5":29814,"_20482":119800,"_26831":119801,"_2843":119802},[],"/docs/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3355":70418,"_29485":70411,"_5":29814,"_20482":119804,"_26831":119805,"_2843":119187},[],"/docs/es/platform/pki/ocsp#referencias",{"_3355":70419,"_29485":70411,"_20482":119807,"_5":14053,"_26831":70411,"_2843":119808},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3355":70420,"_29485":70411,"_20482":119810,"_5":14053,"_26831":119785,"_2843":119811},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3355":70421,"_29485":70411,"_20482":119813,"_5":14053,"_26831":119785,"_2843":119814},[],"Estado del registro",{"_3355":70422,"_29485":70411,"_20482":119816,"_5":14053,"_26831":119785,"_2843":119817},[],"Respuesta firmada",{"_3355":70423,"_29485":70411,"_20482":119819,"_5":14053,"_26831":119785,"_2843":52587},[],{"_3355":70424,"_29485":70411,"_20482":119821,"_5":14053,"_26831":119785,"_2843":55251},[],{"_3355":70425,"_29485":70411,"_20482":119823,"_5":14053,"_26831":119785,"_2843":52604},[],{"_3355":70426,"_29485":70411,"_20482":119825,"_5":14053,"_26831":119785,"_2843":119826},[],"`Revoked`, con razón y fecha de revocación.",{"_3355":70427,"_29485":70411,"_20482":119828,"_5":14053,"_26831":119785,"_2843":119829},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3355":70428,"_29485":70411,"_20482":119831,"_5":14053,"_26831":119785,"_2843":119832},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3355":70429,"_29485":70411,"_20482":119834,"_5":14053,"_26831":119785,"_2843":119835},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3355":70430,"_29485":70411,"_20482":119837,"_5":14053,"_26831":119785,"_2843":119838},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3355":70431,"_29485":70411,"_20482":119840,"_5":14053,"_26831":119785,"_2843":119841},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3355":70432,"_29485":70411,"_20482":119843,"_5":14053,"_26831":119789,"_2843":119844},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3355":70433,"_29485":70411,"_20482":119846,"_5":14053,"_26831":119789,"_2843":119847},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3355":70434,"_29485":70411,"_20482":119849,"_5":14053,"_26831":119793,"_2843":119850},[],"El servicio acepta:",{"_3355":70435,"_29485":70411,"_20482":119852,"_5":14053,"_26831":119793,"_2843":115855},[],{"_3355":70436,"_29485":70411,"_20482":119854,"_5":14053,"_26831":119793,"_2843":119855},[],"Ruta del servicio VA",{"_3355":70437,"_29485":70411,"_20482":119857,"_5":14053,"_26831":119793,"_2843":119858},[],"Formato",{"_3355":70438,"_29485":70411,"_20482":119860,"_5":14053,"_26831":119793,"_2843":55291},[],{"_3355":70439,"_29485":70411,"_20482":119862,"_5":14053,"_26831":119793,"_2843":55294},[],{"_3355":70440,"_29485":70411,"_20482":119864,"_5":14053,"_26831":119793,"_2843":119865},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3355":70441,"_29485":70411,"_20482":119867,"_5":14053,"_26831":119793,"_2843":54723},[],{"_3355":70442,"_29485":70411,"_20482":119869,"_5":14053,"_26831":119793,"_2843":55302},[],{"_3355":70443,"_29485":70411,"_20482":119871,"_5":14053,"_26831":119793,"_2843":119872},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3355":70444,"_29485":70411,"_20482":119874,"_5":14053,"_26831":119793,"_2843":119875},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3355":70445,"_29485":70411,"_20482":119877,"_5":14053,"_26831":119797,"_2843":119878},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3355":70446,"_29485":70411,"_20482":119880,"_5":14053,"_26831":119797,"_2843":119881},[],"Genera la solicitud:",{"_3355":70447,"_29485":70411,"_20482":119883,"_5":14053,"_26831":119797,"_2843":119884},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3355":70448,"_29485":70411,"_20482":119886,"_5":14053,"_26831":119797,"_2843":119887},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3355":70449,"_29485":70411,"_20482":119889,"_5":14053,"_26831":119797,"_2843":119890},[],"Verifica el DER recibido:",{"_3355":70450,"_29485":70411,"_20482":119892,"_5":14053,"_26831":119797,"_2843":119893},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3355":70451,"_29485":70411,"_20482":119895,"_5":14053,"_26831":119801,"_2843":119896},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3355":70452,"_29485":70411,"_20482":119898,"_5":14053,"_26831":119801,"_2843":119899},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3355":70453,"_29485":70411,"_20482":119901,"_5":14053,"_26831":119805,"_2843":55335},[],{"_3355":70454,"_29485":70411,"_20482":119903,"_5":14053,"_26831":119805,"_2843":55338},[],{"_3355":70455,"_29485":70411,"_20482":119905,"_5":14053,"_26831":119805,"_2843":119906},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3355":70456,"_29485":70411,"_20482":119908,"_5":14053,"_26831":119805,"_2843":119395},[],{"_3355":70457,"_29485":70457,"_5":14411,"_2843":53416,"_29817":119910,"_20482":119911,"_26831":70457},[47939,114128,53416],[],{"_3355":70458,"_29485":70457,"_20482":119913,"_5":14053,"_26831":70457,"_2843":119914},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3355":70459,"_29485":70457,"_5":29814,"_20482":119916,"_26831":119917,"_2843":117336},[],"/docs/es/platform/pki/overview#empieza-aquí",{"_3355":70460,"_29485":70457,"_5":29814,"_20482":119919,"_26831":119920,"_2843":119921},[],"/docs/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3355":70461,"_29485":70457,"_5":29814,"_20482":119923,"_26831":119924,"_2843":117856},[],"/docs/es/platform/pki/overview#capacidades-principales",{"_3355":70462,"_29485":70457,"_5":29814,"_20482":119926,"_26831":119927,"_2843":117860},[],"/docs/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3355":70463,"_29485":70457,"_5":29814,"_20482":119929,"_26831":119930,"_2843":117864},[],"/docs/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3355":70464,"_29485":70457,"_5":29814,"_20482":119932,"_26831":119933,"_2843":117868},[],"/docs/es/platform/pki/overview#emite-y-controla-certificados",{"_3355":70465,"_29485":70457,"_5":29814,"_20482":119935,"_26831":119936,"_2843":117876},[],"/docs/es/platform/pki/overview#publica-el-estado-de-validación",{"_3355":70466,"_29485":70457,"_5":29814,"_20482":119938,"_26831":119939,"_2843":119940},[],"/docs/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3355":70467,"_29485":70457,"_5":29814,"_20482":119942,"_26831":119943,"_2843":118801},[],"/docs/es/platform/pki/overview#continúa",{"_3355":70468,"_29485":70457,"_20482":119945,"_5":14053,"_26831":70457,"_2843":119946},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3355":70469,"_29485":70457,"_20482":119948,"_5":14053,"_26831":119917,"_2843":119949},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3355":70470,"_29485":70457,"_20482":119951,"_5":14053,"_26831":119917,"_2843":119952},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3355":70471,"_29485":70457,"_20482":119954,"_5":14053,"_26831":119920,"_2843":119955},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3355":70472,"_29485":70457,"_20482":119957,"_5":14053,"_26831":119920,"_2843":119958},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3355":70473,"_29485":70457,"_20482":119960,"_5":14053,"_26831":119920,"_2843":119961},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3355":70474,"_29485":70457,"_20482":119963,"_5":14053,"_26831":119920,"_2843":119964},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3355":70475,"_29485":70457,"_20482":119966,"_5":14053,"_26831":119920,"_2843":119967},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3355":70476,"_29485":70457,"_20482":119969,"_5":14053,"_26831":119927,"_2843":119970},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3355":70477,"_29485":70457,"_20482":119972,"_5":14053,"_26831":119930,"_2843":119973},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3355":70478,"_29485":70457,"_20482":119975,"_5":14053,"_26831":119933,"_2843":119976},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3355":70479,"_29485":70457,"_20482":119978,"_5":14053,"_26831":119936,"_2843":119979},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3355":70480,"_29485":70457,"_20482":119981,"_5":14053,"_26831":119939,"_2843":119982},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3355":70481,"_29485":70457,"_20482":119984,"_5":14053,"_26831":119939,"_2843":119985},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3355":70482,"_29485":70457,"_20482":119987,"_5":14053,"_26831":119939,"_2843":119988},[],"su clave pública corresponda a la clave privada del cliente;",{"_3355":70483,"_29485":70457,"_20482":119990,"_5":14053,"_26831":119939,"_2843":119991},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3355":70484,"_29485":70457,"_20482":119993,"_5":14053,"_26831":119939,"_2843":119994},[],"sus fechas y usos permitan la operación;",{"_3355":70485,"_29485":70457,"_20482":119996,"_5":14053,"_26831":119939,"_2843":119997},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3355":70486,"_29485":70457,"_20482":119999,"_5":14053,"_26831":119939,"_2843":120000},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3355":70487,"_29485":70457,"_20482":120002,"_5":14053,"_26831":119943,"_2843":120003},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3355":70488,"_29485":70457,"_20482":120005,"_5":14053,"_26831":119943,"_2843":120006},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3355":70489,"_29485":70457,"_20482":120008,"_5":14053,"_26831":119943,"_2843":120009},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3355":70490,"_29485":70490,"_5":14411,"_2843":120011,"_29817":120012,"_20482":120013,"_26831":70490},"Crea tu primera CA",[47939,114128,53416,117460],[],{"_3355":70491,"_29485":70490,"_20482":120015,"_5":14053,"_26831":70490,"_2843":120016},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3355":70492,"_29485":70490,"_5":29814,"_20482":120018,"_26831":120019,"_2843":112706},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3355":70493,"_29485":70490,"_5":29814,"_20482":120021,"_26831":120022,"_2843":120023},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3355":70494,"_29485":70490,"_5":29814,"_20482":120025,"_26831":120026,"_2843":120027},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3355":70495,"_29485":70490,"_5":29814,"_20482":120029,"_26831":120030,"_2843":120031},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3355":70496,"_29485":70490,"_5":29814,"_20482":120033,"_26831":120034,"_2843":120035},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3355":70497,"_29485":70490,"_5":29814,"_20482":120037,"_26831":120038,"_2843":120039},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3355":70498,"_29485":70490,"_5":29814,"_20482":120041,"_26831":120042,"_2843":120043},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3355":70499,"_29485":70490,"_5":29814,"_20482":120045,"_26831":120046,"_2843":117707},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3355":70500,"_29485":70490,"_5":29814,"_20482":120048,"_26831":120049,"_2843":112730},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3355":70501,"_29485":70490,"_20482":120051,"_5":14053,"_26831":70490,"_2843":120052},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3355":70502,"_29485":70490,"_20482":120054,"_5":14053,"_26831":120019,"_2843":120055},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3355":70503,"_29485":70490,"_20482":120057,"_5":14053,"_26831":120019,"_2843":120058},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3355":70504,"_29485":70490,"_20482":120060,"_5":14053,"_26831":120019,"_2843":120061},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3355":70505,"_29485":70490,"_20482":120063,"_5":14053,"_26831":120019,"_2843":120064},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3355":70506,"_29485":70490,"_20482":120066,"_5":14053,"_26831":120022,"_2843":120067},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3355":70507,"_29485":70490,"_20482":120069,"_5":14053,"_26831":120022,"_2843":120070},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3355":70508,"_29485":70490,"_20482":120072,"_5":14053,"_26831":120026,"_2843":120073},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3355":70509,"_29485":70490,"_20482":120075,"_5":14053,"_26831":120026,"_2843":120076},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3355":70510,"_29485":70490,"_20482":120078,"_5":14053,"_26831":120030,"_2843":120079},[],"Selecciona **Root CA** y completa:",{"_3355":70511,"_29485":70490,"_20482":120081,"_5":14053,"_26831":120030,"_2843":55517},[],{"_3355":70512,"_29485":70490,"_20482":120083,"_5":14053,"_26831":120030,"_2843":120084},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3355":70513,"_29485":70490,"_20482":120086,"_5":14053,"_26831":120030,"_2843":120087},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3355":70514,"_29485":70490,"_20482":120089,"_5":14053,"_26831":120030,"_2843":120090},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3355":70515,"_29485":70490,"_20482":120092,"_5":14053,"_26831":120030,"_2843":120093},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3355":70516,"_29485":70490,"_20482":120095,"_5":14053,"_26831":120034,"_2843":120096},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3355":70517,"_29485":70490,"_20482":120098,"_5":14053,"_26831":120038,"_2843":120099},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3355":70518,"_29485":70490,"_20482":120101,"_5":14053,"_26831":120038,"_2843":120102},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3355":70519,"_29485":70490,"_20482":120104,"_5":14053,"_26831":120042,"_2843":120105},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3355":70520,"_29485":70490,"_20482":120107,"_5":14053,"_26831":120042,"_2843":120108},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3355":70521,"_29485":70490,"_20482":120110,"_5":14053,"_26831":120042,"_2843":120111},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3355":70522,"_29485":70490,"_20482":120113,"_5":14053,"_26831":120046,"_2843":120114},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3355":70523,"_29485":70490,"_20482":120116,"_5":14053,"_26831":120046,"_2843":120117},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3355":70524,"_29485":70490,"_20482":120119,"_5":14053,"_26831":120046,"_2843":120120},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3355":70525,"_29485":70490,"_20482":120122,"_5":14053,"_26831":120046,"_2843":120123},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3355":70526,"_29485":70490,"_20482":120125,"_5":14053,"_26831":120049,"_2843":120126},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3355":70527,"_29485":70527,"_5":14411,"_2843":120128,"_29817":120129,"_20482":120130,"_26831":70527},"Emite y verifica un certificado",[47939,114128,53416,117460],[],{"_3355":70528,"_29485":70527,"_20482":120132,"_5":14053,"_26831":70527,"_2843":120133},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3355":70529,"_29485":70527,"_5":29814,"_20482":120135,"_26831":120136,"_2843":112706},[],"/docs/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3355":70530,"_29485":70527,"_5":29814,"_20482":120138,"_26831":120139,"_2843":120140},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3355":70531,"_29485":70527,"_5":29814,"_20482":120142,"_26831":120143,"_2843":120144},[],"/docs/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3355":70532,"_29485":70527,"_5":29814,"_20482":120146,"_26831":120147,"_2843":120148},[],"/docs/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3355":70533,"_29485":70527,"_5":29814,"_20482":120150,"_26831":120151,"_2843":120152},[],"/docs/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3355":70534,"_29485":70527,"_5":29814,"_20482":120154,"_26831":120155,"_2843":120156},[],"/docs/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3355":70535,"_29485":70527,"_5":29814,"_20482":120158,"_26831":120159,"_2843":120160},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3355":70536,"_29485":70527,"_5":29814,"_20482":120162,"_26831":120163,"_2843":120164},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3355":70537,"_29485":70527,"_5":29814,"_20482":120166,"_26831":120167,"_2843":120168},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3355":70538,"_29485":70527,"_5":29814,"_20482":120170,"_26831":120171,"_2843":120172},[],"/docs/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3355":70539,"_29485":70527,"_5":29814,"_20482":120174,"_26831":120175,"_2843":117707},[],"/docs/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3355":70540,"_29485":70527,"_5":29814,"_20482":120177,"_26831":120178,"_2843":112730},[],"/docs/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3355":70541,"_29485":70527,"_20482":120180,"_5":14053,"_26831":70527,"_2843":120181},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3355":70542,"_29485":70527,"_20482":120183,"_5":14053,"_26831":120136,"_2843":120184},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3355":70543,"_29485":70527,"_20482":120186,"_5":14053,"_26831":120136,"_2843":120187},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3355":70544,"_29485":70527,"_20482":120189,"_5":14053,"_26831":120136,"_2843":120190},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3355":70545,"_29485":70527,"_20482":120192,"_5":14053,"_26831":120136,"_2843":120193},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3355":70546,"_29485":70527,"_20482":120195,"_5":14053,"_26831":120136,"_2843":120196},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3355":70547,"_29485":70527,"_20482":120198,"_5":14053,"_26831":120139,"_2843":120199},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3355":70548,"_29485":70527,"_20482":120201,"_5":14053,"_26831":120143,"_2843":120202},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3355":70549,"_29485":70527,"_20482":120204,"_5":14053,"_26831":120143,"_2843":120205},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3355":70550,"_29485":70527,"_20482":120207,"_5":14053,"_26831":120147,"_2843":120208},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3355":70551,"_29485":70527,"_20482":120210,"_5":14053,"_26831":120147,"_2843":120211},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3355":70552,"_29485":70527,"_20482":120213,"_5":14053,"_26831":120151,"_2843":120214},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3355":70553,"_29485":70527,"_20482":120216,"_5":14053,"_26831":120151,"_2843":120217},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3355":70554,"_29485":70527,"_20482":120219,"_5":14053,"_26831":120155,"_2843":120220},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3355":70555,"_29485":70527,"_20482":120222,"_5":14053,"_26831":120159,"_2843":120223},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3355":70556,"_29485":70527,"_20482":120225,"_5":14053,"_26831":120163,"_2843":120226},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3355":70557,"_29485":70527,"_20482":120228,"_5":14053,"_26831":120167,"_2843":120229},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3355":70558,"_29485":70527,"_20482":120231,"_5":14053,"_26831":120167,"_2843":120232},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3355":70559,"_29485":70527,"_20482":120234,"_5":14053,"_26831":120167,"_2843":120235},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3355":70560,"_29485":70527,"_20482":120237,"_5":14053,"_26831":120171,"_2843":120238},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3355":70561,"_29485":70527,"_20482":120240,"_5":14053,"_26831":120171,"_2843":120241},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3355":70562,"_29485":70527,"_20482":120243,"_5":14053,"_26831":120171,"_2843":120244},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3355":70563,"_29485":70527,"_20482":120246,"_5":14053,"_26831":120175,"_2843":117790},[],{"_3355":70564,"_29485":70527,"_20482":120248,"_5":14053,"_26831":120175,"_2843":116304},[],{"_3355":70565,"_29485":70527,"_20482":120250,"_5":14053,"_26831":120175,"_2843":120251},[],"La CA rechaza la emisión",{"_3355":70566,"_29485":70527,"_20482":120253,"_5":14053,"_26831":120175,"_2843":120254},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3355":70567,"_29485":70527,"_20482":120256,"_5":14053,"_26831":120175,"_2843":120257},[],"Sujeto o usos diferentes",{"_3355":70568,"_29485":70527,"_20482":120259,"_5":14053,"_26831":120175,"_2843":120260},[],"Perfil aplicado y valores solicitados.",{"_3355":70569,"_29485":70527,"_20482":120262,"_5":14053,"_26831":120175,"_2843":120263},[],"No se encuentra el emisor",{"_3355":70570,"_29485":70527,"_20482":120265,"_5":14053,"_26831":120175,"_2843":120266},[],"CA descargada y cadena intermedia necesaria.",{"_3355":70571,"_29485":70527,"_20482":120268,"_5":14053,"_26831":120175,"_2843":120269},[],"Falla la vigencia",{"_3355":70572,"_29485":70527,"_20482":120271,"_5":14053,"_26831":120175,"_2843":120272},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3355":70573,"_29485":70527,"_20482":120274,"_5":14053,"_26831":120175,"_2843":120275},[],"Los resúmenes de clave difieren",{"_3355":70574,"_29485":70527,"_20482":120277,"_5":14053,"_26831":120175,"_2843":120278},[],"Archivos de certificado y clave de la misma emisión.",{"_3355":70575,"_29485":70527,"_20482":120280,"_5":14053,"_26831":120175,"_2843":120281},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3355":70576,"_29485":70527,"_20482":120283,"_5":14053,"_26831":120178,"_2843":120284},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3355":70577,"_29485":70527,"_20482":120286,"_5":14053,"_26831":120178,"_2843":120287},[],"Gestionar certificados para inspección, estado y revocación.",{"_3355":70578,"_29485":70527,"_20482":120289,"_5":14053,"_26831":120178,"_2843":120290},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3355":70579,"_29485":70527,"_20482":120292,"_5":14053,"_26831":120178,"_2843":120293},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3355":70580,"_29485":70527,"_20482":120295,"_5":14053,"_26831":120178,"_2843":120296},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3355":70581,"_29485":70581,"_5":14411,"_2843":120298,"_29817":120299,"_20482":120300,"_26831":70581},"Primeros pasos de PKI",[47939,114128,53416,117460],[],{"_3355":70582,"_29485":70581,"_20482":120302,"_5":14053,"_26831":70581,"_2843":120303},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3355":70583,"_29485":70581,"_5":29814,"_20482":120305,"_26831":120306,"_2843":112706},[],"/docs/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3355":70584,"_29485":70581,"_5":29814,"_20482":120308,"_26831":120309,"_2843":120310},[],"/docs/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3355":70585,"_29485":70581,"_5":29814,"_20482":120312,"_26831":120313,"_2843":117642},[],"/docs/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3355":70586,"_29485":70581,"_5":29814,"_20482":120315,"_26831":120316,"_2843":120317},[],"/docs/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3355":70587,"_29485":70581,"_20482":120319,"_5":14053,"_26831":70581,"_2843":120320},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3355":70588,"_29485":70581,"_20482":120322,"_5":14053,"_26831":120306,"_2843":120323},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3355":70589,"_29485":70581,"_20482":120325,"_5":14053,"_26831":120306,"_2843":120326},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3355":70590,"_29485":70581,"_20482":120328,"_5":14053,"_26831":120306,"_2843":120329},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3355":70591,"_29485":70581,"_20482":120331,"_5":14053,"_26831":120306,"_2843":120332},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3355":70592,"_29485":70581,"_20482":120334,"_5":14053,"_26831":120306,"_2843":120335},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3355":70593,"_29485":70581,"_20482":120337,"_5":14053,"_26831":120309,"_2843":120338},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3355":70594,"_29485":70581,"_20482":120340,"_5":14053,"_26831":120309,"_2843":120341},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3355":70595,"_29485":70581,"_20482":120343,"_5":14053,"_26831":120309,"_2843":120344},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3355":70596,"_29485":70581,"_20482":120346,"_5":14053,"_26831":120309,"_2843":120347},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3355":70597,"_29485":70581,"_20482":120349,"_5":14053,"_26831":120313,"_2843":120350},[],"Archivo o recurso",{"_3355":70598,"_29485":70581,"_20482":120352,"_5":14053,"_26831":120313,"_2843":117639},[],{"_3355":70599,"_29485":70581,"_20482":120354,"_5":14053,"_26831":120313,"_2843":120355},[],"CA raíz activa y `ca.pem`",{"_3355":70600,"_29485":70581,"_20482":120357,"_5":14053,"_26831":120313,"_2843":120358},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3355":70601,"_29485":70581,"_20482":120360,"_5":14053,"_26831":120313,"_2843":120361},[],"Certificado final y `device.crt`",{"_3355":70602,"_29485":70581,"_20482":120363,"_5":14053,"_26831":120313,"_2843":120364},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3355":70603,"_29485":70581,"_20482":120366,"_5":14053,"_26831":120313,"_2843":120367},[],"Clave privada `device.key`",{"_3355":70604,"_29485":70581,"_20482":120369,"_5":14053,"_26831":120313,"_2843":120370},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3355":70605,"_29485":70581,"_20482":120372,"_5":14053,"_26831":120313,"_2843":120373},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3355":70606,"_29485":70581,"_20482":120375,"_5":14053,"_26831":120316,"_2843":120376},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3355":70607,"_29485":70581,"_20482":120378,"_5":14053,"_26831":120316,"_2843":120379},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3355":70608,"_29485":70581,"_20482":120381,"_5":14053,"_26831":120316,"_2843":120382},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3355":70609,"_29485":70609,"_5":14411,"_2843":120384,"_29817":120385,"_20482":120387,"_26831":70609},"Resolución de problemas PKI",[47939,114128,53416,120386],"Resolución de problemas",[],{"_3355":70610,"_29485":70609,"_20482":120389,"_5":14053,"_26831":70609,"_2843":120390},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3355":70611,"_29485":70609,"_5":29814,"_20482":120392,"_26831":120393,"_2843":120394},[],"/docs/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3355":70612,"_29485":70609,"_5":29814,"_20482":120396,"_26831":120397,"_2843":120398},[],"/docs/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3355":70613,"_29485":70609,"_5":29814,"_20482":120400,"_26831":120401,"_2843":120402},[],"/docs/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3355":70614,"_29485":70609,"_20482":120404,"_5":14053,"_26831":70609,"_2843":120405},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3355":70615,"_29485":70609,"_20482":120407,"_5":14053,"_26831":70609,"_2843":120408},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3355":70616,"_29485":70609,"_20482":120410,"_5":14053,"_26831":120393,"_2843":117639},[],{"_3355":70617,"_29485":70609,"_20482":120412,"_5":14053,"_26831":120393,"_2843":116304},[],{"_3355":70618,"_29485":70609,"_20482":120414,"_5":14053,"_26831":120393,"_2843":112730},[],{"_3355":70619,"_29485":70609,"_20482":120416,"_5":14053,"_26831":120393,"_2843":52255},[],{"_3355":70620,"_29485":70609,"_20482":120418,"_5":14053,"_26831":120393,"_2843":120419},[],"Existe, está activa y sus fechas son utilizables.",{"_3355":70621,"_29485":70609,"_20482":120421,"_5":14053,"_26831":120393,"_2843":120422},[],"Autoridades.",{"_3355":70622,"_29485":70609,"_20482":120424,"_5":14053,"_26831":120393,"_2843":120425},[],"Clave",{"_3355":70623,"_29485":70609,"_20482":120427,"_5":14053,"_26831":120393,"_2843":120428},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3355":70624,"_29485":70609,"_20482":120430,"_5":14053,"_26831":120393,"_2843":120431},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3355":70625,"_29485":70609,"_20482":120433,"_5":14053,"_26831":120393,"_2843":55871},[],{"_3355":70626,"_29485":70609,"_20482":120435,"_5":14053,"_26831":120393,"_2843":120436},[],"PEM correcto y firma verificable.",{"_3355":70627,"_29485":70609,"_20482":120438,"_5":14053,"_26831":120393,"_2843":55877},[],{"_3355":70628,"_29485":70609,"_20482":120440,"_5":14053,"_26831":120393,"_2843":120441},[],"Perfil",{"_3355":70629,"_29485":70609,"_20482":120443,"_5":14053,"_26831":120393,"_2843":120444},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3355":70630,"_29485":70609,"_20482":120446,"_5":14053,"_26831":120393,"_2843":120447},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3355":70631,"_29485":70609,"_20482":120449,"_5":14053,"_26831":120393,"_2843":117790},[],{"_3355":70632,"_29485":70609,"_20482":120451,"_5":14053,"_26831":120393,"_2843":120452},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3355":70633,"_29485":70609,"_20482":120454,"_5":14053,"_26831":120393,"_2843":120455},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3355":70634,"_29485":70609,"_20482":120457,"_5":14053,"_26831":120393,"_2843":120458},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3355":70635,"_29485":70609,"_20482":120460,"_5":14053,"_26831":120393,"_2843":120461},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3355":70636,"_29485":70609,"_20482":120463,"_5":14053,"_26831":120397,"_2843":120464},[],"Revisa cada frontera por separado:",{"_3355":70637,"_29485":70609,"_20482":120466,"_5":14053,"_26831":120397,"_2843":120467},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3355":70638,"_29485":70609,"_20482":120469,"_5":14053,"_26831":120397,"_2843":120470},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3355":70639,"_29485":70609,"_20482":120472,"_5":14053,"_26831":120397,"_2843":120473},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3355":70640,"_29485":70609,"_20482":120475,"_5":14053,"_26831":120397,"_2843":120476},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3355":70641,"_29485":70609,"_20482":120478,"_5":14053,"_26831":120397,"_2843":120479},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3355":70642,"_29485":70609,"_20482":120481,"_5":14053,"_26831":120397,"_2843":120482},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3355":70643,"_29485":70609,"_20482":120484,"_5":14053,"_26831":120401,"_2843":120485},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3355":70644,"_29485":70609,"_20482":120487,"_5":14053,"_26831":120401,"_2843":120488},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3355":70645,"_29485":70645,"_5":14411,"_2843":120490,"_29817":120491,"_20482":120492,"_26831":70645},"Seguridad",[47939],[],{"_3355":70646,"_29485":70645,"_20482":120494,"_5":14053,"_26831":70645,"_2843":120495},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3355":70647,"_29485":70645,"_5":29814,"_20482":120497,"_26831":120498,"_2843":120499},[],"/docs/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3355":70648,"_29485":70645,"_5":29814,"_20482":120501,"_26831":120502,"_2843":120503},[],"/docs/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3355":70649,"_29485":70645,"_5":29814,"_20482":120505,"_26831":120506,"_2843":120507},[],"/docs/es/security#versiones-soportadas","Versiones soportadas",{"_3355":70650,"_29485":70645,"_5":29814,"_20482":120509,"_26831":120510,"_2843":120511},[],"/docs/es/security#divulgación-responsable","Divulgación responsable",{"_3355":70651,"_29485":70645,"_20482":120513,"_5":14053,"_26831":70645,"_2843":120514},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3355":70652,"_29485":70645,"_20482":120516,"_5":14053,"_26831":120498,"_2843":120517},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3355":70653,"_29485":70645,"_20482":120519,"_5":14053,"_26831":120498,"_2843":120520},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3355":70654,"_29485":70645,"_20482":120522,"_5":14053,"_26831":120498,"_2843":14673},[],{"_3355":70655,"_29485":70645,"_20482":120524,"_5":14053,"_26831":120498,"_2843":14619},[],{"_3355":70656,"_29485":70645,"_20482":120526,"_5":14053,"_26831":120498,"_2843":14666},[],{"_3355":70657,"_29485":70645,"_20482":120528,"_5":14053,"_26831":120498,"_2843":120529},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3355":70658,"_29485":70645,"_20482":120531,"_5":14053,"_26831":120498,"_2843":120532},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3355":70659,"_29485":70645,"_20482":120534,"_5":14053,"_26831":120502,"_2843":120535},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3355":70660,"_29485":70645,"_20482":120537,"_5":14053,"_26831":120502,"_2843":120538},[],"No incluyas en el reporte:",{"_3355":70661,"_29485":70645,"_20482":120540,"_5":14053,"_26831":120502,"_2843":120541},[],"Credenciales, tokens o claves privadas",{"_3355":70662,"_29485":70645,"_20482":120543,"_5":14053,"_26831":120502,"_2843":120544},[],"Datos de clientes o información identificable de clientes",{"_3355":70663,"_29485":70645,"_20482":120546,"_5":14053,"_26831":120502,"_2843":120547},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3355":70664,"_29485":70645,"_20482":120549,"_5":14053,"_26831":120506,"_2843":120550},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3355":70665,"_29485":70645,"_20482":120552,"_5":14053,"_26831":120506,"_2843":120553},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3355":70666,"_29485":70645,"_20482":120555,"_5":14053,"_26831":120510,"_2843":120556},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3355":70667,"_29485":70645,"_20482":120558,"_5":14053,"_26831":120510,"_2843":120559},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3355":70668,"_29485":70645,"_20482":120561,"_5":14053,"_26831":120510,"_2843":120562},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3355":70669,"_29485":70645,"_20482":120564,"_5":14053,"_26831":120510,"_2843":120565},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3355":70670,"_29485":70645,"_20482":120567,"_5":14053,"_26831":120510,"_2843":120568},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3355":70671,"_29485":70671,"_5":14411,"_2843":120570,"_29817":120571,"_20482":120573,"_26831":70671},"3.8.0 a 4.0.0",[47939,120572],"Actualizaciones",[],{"_3355":70672,"_29485":70671,"_20482":120575,"_5":14053,"_26831":70671,"_2843":120576},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3355":70673,"_29485":70671,"_5":29814,"_20482":120578,"_26831":120579,"_2843":120580},[],"/docs/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3355":70674,"_29485":70671,"_5":29814,"_20482":120582,"_26831":120583,"_2843":120584},[],"/docs/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3355":70675,"_29485":70671,"_5":29814,"_20482":120586,"_26831":120587,"_2843":120588},[],"/docs/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3355":70676,"_29485":70671,"_5":29814,"_20482":120590,"_26831":120591,"_2843":120592},[],"/docs/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3355":70677,"_29485":70671,"_5":29814,"_20482":120594,"_26831":120595,"_2843":120596},[],"/docs/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3355":70678,"_29485":70671,"_5":29814,"_20482":120598,"_26831":120599,"_2843":120600},[],"/docs/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3355":70679,"_29485":70671,"_5":29814,"_20482":120602,"_26831":120603,"_2843":56043},[],"/docs/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3355":70680,"_29485":70671,"_5":29814,"_20482":120605,"_26831":120606,"_2843":120607},[],"/docs/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3355":70681,"_29485":70671,"_5":29814,"_20482":120609,"_26831":120610,"_2843":120611},[],"/docs/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3355":70682,"_29485":70671,"_5":29814,"_20482":120613,"_26831":120614,"_2843":120615},[],"/docs/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3355":70683,"_29485":70671,"_5":29814,"_20482":120617,"_26831":120618,"_2843":120619},[],"/docs/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3355":70684,"_29485":70671,"_5":29814,"_20482":120621,"_26831":120622,"_2843":120623},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3355":70685,"_29485":70671,"_5":29814,"_20482":120625,"_26831":120626,"_2843":120627},[],"/docs/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3355":70686,"_29485":70671,"_5":29814,"_20482":120629,"_26831":120630,"_2843":120631},[],"/docs/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3355":70687,"_29485":70671,"_5":29814,"_20482":120633,"_26831":120634,"_2843":120635},[],"/docs/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3355":70688,"_29485":70671,"_5":29814,"_20482":120637,"_26831":120638,"_2843":120639},[],"/docs/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3355":70689,"_29485":70671,"_5":29814,"_20482":120641,"_26831":120642,"_2843":120643},[],"/docs/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3355":70690,"_29485":70671,"_5":29814,"_20482":120645,"_26831":120646,"_2843":120647},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3355":70691,"_29485":70671,"_5":29814,"_20482":120649,"_26831":120650,"_2843":120651},[],"/docs/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3355":70692,"_29485":70671,"_5":29814,"_20482":120653,"_26831":120654,"_2843":120655},[],"/docs/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3355":70693,"_29485":70671,"_5":29814,"_20482":120657,"_26831":120658,"_2843":120659},[],"/docs/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3355":70694,"_29485":70671,"_5":29814,"_20482":120661,"_26831":120662,"_2843":120663},[],"/docs/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3355":70695,"_29485":70671,"_5":29814,"_20482":120665,"_26831":120666,"_2843":120667},[],"/docs/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3355":70696,"_29485":70671,"_5":29814,"_20482":120669,"_26831":120670,"_2843":120671},[],"/docs/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3355":70697,"_29485":70671,"_5":29814,"_20482":120673,"_26831":120674,"_2843":120675},[],"/docs/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3355":70698,"_29485":70671,"_5":29814,"_20482":120677,"_26831":120678,"_2843":120679},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3355":70699,"_29485":70671,"_5":29814,"_20482":120681,"_26831":120682,"_2843":120683},[],"/docs/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3355":70700,"_29485":70671,"_5":29814,"_20482":120685,"_26831":120686,"_2843":120687},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3355":70701,"_29485":70671,"_5":29814,"_20482":120689,"_26831":120690,"_2843":120691},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3355":70702,"_29485":70671,"_5":29814,"_20482":120693,"_26831":120694,"_2843":120695},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3355":70703,"_29485":70671,"_5":29814,"_20482":120697,"_26831":120698,"_2843":120699},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3355":70704,"_29485":70671,"_5":29814,"_20482":120701,"_26831":120702,"_2843":120703},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3355":70705,"_29485":70671,"_5":29814,"_20482":120705,"_26831":120706,"_2843":120707},[],"/docs/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3355":70706,"_29485":70671,"_5":29814,"_20482":120709,"_26831":120710,"_2843":116650},[],"/docs/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3355":70707,"_29485":70671,"_5":29814,"_20482":120712,"_26831":120713,"_2843":120714},[],"/docs/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3355":70708,"_29485":70671,"_5":29814,"_20482":120716,"_26831":120717,"_2843":120718},[],"/docs/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3355":70709,"_29485":70671,"_20482":120720,"_5":14053,"_26831":70671,"_2843":120721},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3355":70710,"_29485":70671,"_20482":120723,"_5":14053,"_26831":70671,"_2843":120724},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3355":70711,"_29485":70671,"_20482":120726,"_5":14053,"_26831":70671,"_2843":120727},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3355":70712,"_29485":70671,"_20482":120729,"_5":14053,"_26831":70671,"_2843":120730},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3355":70713,"_29485":70671,"_20482":120732,"_5":14053,"_26831":70671,"_2843":120733},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3355":70714,"_29485":70671,"_20482":120735,"_5":14053,"_26831":70671,"_2843":120736},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3355":70715,"_29485":70671,"_20482":120738,"_5":14053,"_26831":70671,"_2843":120739},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3355":70716,"_29485":70671,"_20482":120741,"_5":14053,"_26831":120583,"_2843":120742},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3355":70717,"_29485":70671,"_20482":120744,"_5":14053,"_26831":120583,"_2843":120745},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3355":70718,"_29485":70671,"_20482":120747,"_5":14053,"_26831":120587,"_2843":120748},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3355":70719,"_29485":70671,"_20482":120750,"_5":14053,"_26831":120587,"_2843":120751},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y roles de la VA. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3355":70720,"_29485":70671,"_20482":120753,"_5":14053,"_26831":120591,"_2843":120754},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3355":70721,"_29485":70671,"_20482":120756,"_5":14053,"_26831":120595,"_2843":120757},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3355":70722,"_29485":70671,"_20482":120759,"_5":14053,"_26831":120595,"_2843":120760},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3355":70723,"_29485":70671,"_20482":120762,"_5":14053,"_26831":120595,"_2843":120763},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3355":70724,"_29485":70671,"_20482":120765,"_5":14053,"_26831":120595,"_2843":120766},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3355":70725,"_29485":70671,"_20482":120768,"_5":14053,"_26831":120595,"_2843":120769},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3355":70726,"_29485":70671,"_20482":120771,"_5":14053,"_26831":120599,"_2843":120772},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3355":70727,"_29485":70671,"_20482":120774,"_5":14053,"_26831":120599,"_2843":120775},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3355":70728,"_29485":70671,"_20482":120777,"_5":14053,"_26831":120599,"_2843":120778},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3355":70729,"_29485":70671,"_20482":120780,"_5":14053,"_26831":120599,"_2843":120781},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3355":70730,"_29485":70671,"_20482":120783,"_5":14053,"_26831":120599,"_2843":120784},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3355":70731,"_29485":70671,"_20482":120786,"_5":14053,"_26831":120603,"_2843":120787},[],"Cambio",{"_3355":70732,"_29485":70671,"_20482":120789,"_5":14053,"_26831":120603,"_2843":120790},[],"A quién afecta",{"_3355":70733,"_29485":70671,"_20482":120792,"_5":14053,"_26831":120603,"_2843":120793},[],"Gravedad",{"_3355":70734,"_29485":70671,"_20482":120795,"_5":14053,"_26831":120603,"_2843":119334},[],{"_3355":70735,"_29485":70671,"_20482":120797,"_5":14053,"_26831":120603,"_2843":120611},[],{"_3355":70736,"_29485":70671,"_20482":120799,"_5":14053,"_26831":120603,"_2843":120800},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3355":70737,"_29485":70671,"_20482":120802,"_5":14053,"_26831":120603,"_2843":120803},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3355":70738,"_29485":70671,"_20482":120805,"_5":14053,"_26831":120603,"_2843":120806},[],"Copiar los datos a los volúmenes nuevos",{"_3355":70739,"_29485":70671,"_20482":120808,"_5":14053,"_26831":120603,"_2843":120615},[],{"_3355":70740,"_29485":70671,"_20482":120810,"_5":14053,"_26831":120603,"_2843":120811},[],"Todas las releases de Helm",{"_3355":70741,"_29485":70671,"_20482":120813,"_5":14053,"_26831":120603,"_2843":120814},[],"Alta: `helm upgrade` falla",{"_3355":70742,"_29485":70671,"_20482":120816,"_5":14053,"_26831":120603,"_2843":120817},[],"Eliminar o renombrar las claves heredadas",{"_3355":70743,"_29485":70671,"_20482":120819,"_5":14053,"_26831":120603,"_2843":120619},[],{"_3355":70744,"_29485":70671,"_20482":120821,"_5":14053,"_26831":120603,"_2843":120822},[],"Todos los despliegues",{"_3355":70745,"_29485":70671,"_20482":120824,"_5":14053,"_26831":120603,"_2843":120825},[],"Alta: sin principal de bootstrap no hay administrador",{"_3355":70746,"_29485":70671,"_20482":120827,"_5":14053,"_26831":120603,"_2843":120828},[],"Configurar `services.authz`",{"_3355":70747,"_29485":70671,"_20482":120830,"_5":14053,"_26831":120603,"_2843":120623},[],{"_3355":70748,"_29485":70671,"_20482":120832,"_5":14053,"_26831":120603,"_2843":120811},[],{"_3355":70749,"_29485":70671,"_20482":120834,"_5":14053,"_26831":120603,"_2843":120835},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3355":70750,"_29485":70671,"_20482":120837,"_5":14053,"_26831":120603,"_2843":120838},[],"Mover JWKS y roles a `services.authz`",{"_3355":70751,"_29485":70671,"_20482":120840,"_5":14053,"_26831":120603,"_2843":120643},[],{"_3355":70752,"_29485":70671,"_20482":120842,"_5":14053,"_26831":120603,"_2843":120843},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3355":70753,"_29485":70671,"_20482":120845,"_5":14053,"_26831":120603,"_2843":120846},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3355":70754,"_29485":70671,"_20482":120848,"_5":14053,"_26831":120603,"_2843":120849},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3355":70755,"_29485":70671,"_20482":120851,"_5":14053,"_26831":120603,"_2843":120647},[],{"_3355":70756,"_29485":70671,"_20482":120853,"_5":14053,"_26831":120603,"_2843":120854},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3355":70757,"_29485":70671,"_20482":120856,"_5":14053,"_26831":120603,"_2843":120857},[],"Alta: el backend ya no arranca con ellos",{"_3355":70758,"_29485":70671,"_20482":120859,"_5":14053,"_26831":120603,"_2843":120860},[],"Pasar a PostgreSQL antes de actualizar",{"_3355":70759,"_29485":70671,"_20482":120862,"_5":14053,"_26831":120603,"_2843":120863},[],"Webhooks con referencias a archivos",{"_3355":70760,"_29485":70671,"_20482":120865,"_5":14053,"_26831":120603,"_2843":120866},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3355":70761,"_29485":70671,"_20482":120868,"_5":14053,"_26831":120603,"_2843":120869},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3355":70762,"_29485":70671,"_20482":120871,"_5":14053,"_26831":120603,"_2843":120872},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3355":70763,"_29485":70671,"_20482":120874,"_5":14053,"_26831":120603,"_2843":120627},[],{"_3355":70764,"_29485":70671,"_20482":120876,"_5":14053,"_26831":120603,"_2843":120877},[],"Releases con identidades por servicio o material de claves montado",{"_3355":70765,"_29485":70671,"_20482":120879,"_5":14053,"_26831":120603,"_2843":120880},[],"Media: los servicios no pueden leer sus archivos",{"_3355":70766,"_29485":70671,"_20482":120882,"_5":14053,"_26831":120603,"_2843":120883},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3355":70767,"_29485":70671,"_20482":120885,"_5":14053,"_26831":120603,"_2843":120631},[],{"_3355":70768,"_29485":70671,"_20482":120887,"_5":14053,"_26831":120603,"_2843":120888},[],"Releases que definen `amqp.tls`",{"_3355":70769,"_29485":70671,"_20482":120890,"_5":14053,"_26831":120603,"_2843":120891},[],"Media: los clientes se conectan al puerto equivocado",{"_3355":70770,"_29485":70671,"_20482":120893,"_5":14053,"_26831":120603,"_2843":120894},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3355":70771,"_29485":70671,"_20482":120896,"_5":14053,"_26831":120603,"_2843":120651},[],{"_3355":70772,"_29485":70671,"_20482":120898,"_5":14053,"_26831":120603,"_2843":120899},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3355":70773,"_29485":70671,"_20482":120901,"_5":14053,"_26831":120603,"_2843":120902},[],"Media: las claves de CA quedan sin gestionar",{"_3355":70774,"_29485":70671,"_20482":120904,"_5":14053,"_26831":120603,"_2843":120905},[],"Ejecutar la migración de CA a KMS",{"_3355":70775,"_29485":70671,"_20482":120907,"_5":14053,"_26831":120603,"_2843":120908},[],"Verificación del certificado del receptor",{"_3355":70776,"_29485":70671,"_20482":120910,"_5":14053,"_26831":120603,"_2843":120911},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3355":70777,"_29485":70671,"_20482":120913,"_5":14053,"_26831":120603,"_2843":120914},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3355":70778,"_29485":70671,"_20482":120916,"_5":14053,"_26831":120603,"_2843":120917},[],"Poner `insecure_skip_verify` a `false`",{"_3355":70779,"_29485":70671,"_20482":120919,"_5":14053,"_26831":120603,"_2843":120663},[],{"_3355":70780,"_29485":70671,"_20482":120921,"_5":14053,"_26831":120603,"_2843":120922},[],"Scripts y consolas que editan DMS por API",{"_3355":70781,"_29485":70671,"_20482":120924,"_5":14053,"_26831":120603,"_2843":120925},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3355":70782,"_29485":70671,"_20482":120927,"_5":14053,"_26831":120603,"_2843":120928},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3355":70783,"_29485":70671,"_20482":120930,"_5":14053,"_26831":120603,"_2843":120679},[],{"_3355":70784,"_29485":70671,"_20482":120932,"_5":14053,"_26831":120603,"_2843":120933},[],"Consumidores que leen el campo `events` del dispositivo",{"_3355":70785,"_29485":70671,"_20482":120935,"_5":14053,"_26831":120603,"_2843":120936},[],"Media: el campo desaparece",{"_3355":70786,"_29485":70671,"_20482":120938,"_5":14053,"_26831":120603,"_2843":120939},[],"Usar los nuevos endpoints de eventos",{"_3355":70787,"_29485":70671,"_20482":120941,"_5":14053,"_26831":120603,"_2843":120635},[],{"_3355":70788,"_29485":70671,"_20482":120943,"_5":14053,"_26831":120603,"_2843":120944},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3355":70789,"_29485":70671,"_20482":120946,"_5":14053,"_26831":120603,"_2843":120947},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3355":70790,"_29485":70671,"_20482":120949,"_5":14053,"_26831":120603,"_2843":120950},[],"Actualizar el archivo de values",{"_3355":70791,"_29485":70671,"_20482":120952,"_5":14053,"_26831":120603,"_2843":120671},[],{"_3355":70792,"_29485":70671,"_20482":120954,"_5":14053,"_26831":120603,"_2843":120955},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3355":70793,"_29485":70671,"_20482":120957,"_5":14053,"_26831":120603,"_2843":120958},[],"Baja: prevalece el ID de la URL",{"_3355":70794,"_29485":70671,"_20482":120960,"_5":14053,"_26831":120603,"_2843":120961},[],"Enviar el ID en la URL",{"_3355":70795,"_29485":70671,"_20482":120963,"_5":14053,"_26831":120603,"_2843":120675},[],{"_3355":70796,"_29485":70671,"_20482":120965,"_5":14053,"_26831":120603,"_2843":120966},[],"Consumidores que comparan el `type` del certificado",{"_3355":70797,"_29485":70671,"_20482":120968,"_5":14053,"_26831":120603,"_2843":120969},[],"Baja: dos valores cambian de nombre",{"_3355":70798,"_29485":70671,"_20482":120971,"_5":14053,"_26831":120603,"_2843":120972},[],"Adaptar los consumidores",{"_3355":70799,"_29485":70671,"_20482":120974,"_5":14053,"_26831":120603,"_2843":120667},[],{"_3355":70800,"_29485":70671,"_20482":120976,"_5":14053,"_26831":120603,"_2843":120977},[],"Cualquier DMS",{"_3355":70801,"_29485":70671,"_20482":120979,"_5":14053,"_26831":120603,"_2843":120980},[],"Baja: solo informativo",{"_3355":70802,"_29485":70671,"_20482":120982,"_5":14053,"_26831":120603,"_2843":120983},[],"Revisar ambos bloques antes de editar",{"_3355":70803,"_29485":70671,"_20482":120985,"_5":14053,"_26831":120610,"_2843":120986},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3355":70804,"_29485":70671,"_20482":120988,"_5":14053,"_26831":120610,"_2843":120989},[],"El paso 4 de la guía de migración copia los datos.",{"_3355":70805,"_29485":70671,"_20482":120991,"_5":14053,"_26831":120614,"_2843":120992},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3355":70806,"_29485":70671,"_20482":120994,"_5":14053,"_26831":120618,"_2843":120995},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3355":70807,"_29485":70671,"_20482":120997,"_5":14053,"_26831":120622,"_2843":120998},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3355":70808,"_29485":70671,"_20482":121000,"_5":14053,"_26831":120626,"_2843":121001},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3355":70809,"_29485":70671,"_20482":121003,"_5":14053,"_26831":120626,"_2843":121004},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3355":70810,"_29485":70671,"_20482":121006,"_5":14053,"_26831":120630,"_2843":121007},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3355":70811,"_29485":70671,"_20482":121009,"_5":14053,"_26831":120634,"_2843":121010},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3355":70812,"_29485":70671,"_20482":121012,"_5":14053,"_26831":120634,"_2843":121013},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3355":70813,"_29485":70671,"_20482":121015,"_5":14053,"_26831":120634,"_2843":121016},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3355":70814,"_29485":70671,"_20482":121018,"_5":14053,"_26831":120634,"_2843":121019},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3355":70815,"_29485":70671,"_20482":121021,"_5":14053,"_26831":120634,"_2843":121022},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3355":70816,"_29485":70671,"_20482":121024,"_5":14053,"_26831":120634,"_2843":121025},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3355":70817,"_29485":70671,"_20482":121027,"_5":14053,"_26831":120642,"_2843":121028},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3355":70818,"_29485":70671,"_20482":121030,"_5":14053,"_26831":120642,"_2843":121031},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3355":70819,"_29485":70671,"_20482":121033,"_5":14053,"_26831":120642,"_2843":121034},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3355":70820,"_29485":70671,"_20482":121036,"_5":14053,"_26831":120642,"_2843":121037},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3355":70821,"_29485":70671,"_20482":121039,"_5":14053,"_26831":120642,"_2843":121040},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3355":70822,"_29485":70671,"_20482":121042,"_5":14053,"_26831":120646,"_2843":121043},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3355":70823,"_29485":70671,"_20482":121045,"_5":14053,"_26831":120650,"_2843":121046},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3355":70824,"_29485":70671,"_20482":121048,"_5":14053,"_26831":120650,"_2843":121049},[],"El `key_id` es el `subject_key_id` del certificado (SHA-256 de la clave pública).",{"_3355":70825,"_29485":70671,"_20482":121051,"_5":14053,"_26831":120650,"_2843":121052},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3355":70826,"_29485":70671,"_20482":121054,"_5":14053,"_26831":120650,"_2843":121055},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3355":70827,"_29485":70671,"_20482":121057,"_5":14053,"_26831":120650,"_2843":121058},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3355":70828,"_29485":70671,"_20482":121060,"_5":14053,"_26831":120650,"_2843":121061},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3355":70829,"_29485":70671,"_20482":121063,"_5":14053,"_26831":120658,"_2843":121064},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3355":70830,"_29485":70671,"_20482":121066,"_5":14053,"_26831":120658,"_2843":121067},[],"Campo en 3.8.0",{"_3355":70831,"_29485":70671,"_20482":121069,"_5":14053,"_26831":120658,"_2843":121070},[],"Campo en 4.0.0",{"_3355":70832,"_29485":70671,"_20482":121072,"_5":14053,"_26831":120658,"_2843":56513},[],{"_3355":70833,"_29485":70671,"_20482":121074,"_5":14053,"_26831":120658,"_2843":121075},[],"`insecure_skip_verify` (con el valor negado)",{"_3355":70834,"_29485":70671,"_20482":121077,"_5":14053,"_26831":120658,"_2843":56519},[],{"_3355":70835,"_29485":70671,"_20482":121079,"_5":14053,"_26831":120658,"_2843":56522},[],{"_3355":70836,"_29485":70671,"_20482":121081,"_5":14053,"_26831":120658,"_2843":56525},[],{"_3355":70837,"_29485":70671,"_20482":121083,"_5":14053,"_26831":120658,"_2843":56528},[],{"_3355":70838,"_29485":70671,"_20482":121085,"_5":14053,"_26831":120658,"_2843":56531},[],{"_3355":70839,"_29485":70671,"_20482":121087,"_5":14053,"_26831":120658,"_2843":56534},[],{"_3355":70840,"_29485":70671,"_20482":121089,"_5":14053,"_26831":120658,"_2843":121090},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3355":70841,"_29485":70671,"_20482":121092,"_5":14053,"_26831":120658,"_2843":121093},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3355":70842,"_29485":70671,"_20482":121095,"_5":14053,"_26831":120658,"_2843":121096},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3355":70843,"_29485":70671,"_20482":121098,"_5":14053,"_26831":120662,"_2843":121099},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3355":70844,"_29485":70671,"_20482":121101,"_5":14053,"_26831":120662,"_2843":121102},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3355":70845,"_29485":70671,"_20482":121104,"_5":14053,"_26831":120662,"_2843":121105},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3355":70846,"_29485":70671,"_20482":121107,"_5":14053,"_26831":120666,"_2843":121108},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3355":70847,"_29485":70671,"_20482":121110,"_5":14053,"_26831":120670,"_2843":121111},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3355":70848,"_29485":70671,"_20482":121113,"_5":14053,"_26831":120674,"_2843":121114},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3355":70849,"_29485":70671,"_20482":121116,"_5":14053,"_26831":120678,"_2843":121117},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3355":70850,"_29485":70671,"_20482":121119,"_5":14053,"_26831":120678,"_2843":121120},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3355":70851,"_29485":70671,"_20482":121122,"_5":14053,"_26831":120678,"_2843":121123},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3355":70852,"_29485":70671,"_20482":121125,"_5":14053,"_26831":120678,"_2843":121126},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3355":70853,"_29485":70671,"_20482":121128,"_5":14053,"_26831":120682,"_2843":121129},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3355":70854,"_29485":70671,"_20482":121131,"_5":14053,"_26831":120686,"_2843":121132},[],"Haz una copia de seguridad verificable de PostgreSQL y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`.",{"_3355":70855,"_29485":70671,"_20482":121134,"_5":14053,"_26831":120686,"_2843":121135},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3355":70856,"_29485":70671,"_20482":121137,"_5":14053,"_26831":120686,"_2843":121138},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3355":70857,"_29485":70671,"_20482":121140,"_5":14053,"_26831":120686,"_2843":121141},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3355":70858,"_29485":70671,"_20482":121143,"_5":14053,"_26831":120686,"_2843":121144},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3355":70859,"_29485":70671,"_20482":121146,"_5":14053,"_26831":120690,"_2843":121147},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3355":70860,"_29485":70671,"_20482":121149,"_5":14053,"_26831":120690,"_2843":121150},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3355":70861,"_29485":70671,"_20482":121152,"_5":14053,"_26831":120690,"_2843":121153},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3355":70862,"_29485":70671,"_20482":121155,"_5":14053,"_26831":120690,"_2843":121156},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3355":70863,"_29485":70671,"_20482":121158,"_5":14053,"_26831":120690,"_2843":121159},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3355":70864,"_29485":70671,"_20482":121161,"_5":14053,"_26831":120690,"_2843":121162},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3355":70865,"_29485":70671,"_20482":121164,"_5":14053,"_26831":120690,"_2843":121165},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3355":70866,"_29485":70671,"_20482":121167,"_5":14053,"_26831":120690,"_2843":121168},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3355":70867,"_29485":70671,"_20482":121170,"_5":14053,"_26831":120690,"_2843":121171},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3355":70868,"_29485":70671,"_20482":121173,"_5":14053,"_26831":120690,"_2843":121174},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3355":70869,"_29485":70671,"_20482":121176,"_5":14053,"_26831":120690,"_2843":121177},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3355":70870,"_29485":70671,"_20482":121179,"_5":14053,"_26831":120690,"_2843":121180},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3355":70871,"_29485":70671,"_20482":121182,"_5":14053,"_26831":120694,"_2843":121183},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3355":70872,"_29485":70671,"_20482":121185,"_5":14053,"_26831":120694,"_2843":121186},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3355":70873,"_29485":70671,"_20482":121188,"_5":14053,"_26831":120698,"_2843":121189},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3355":70874,"_29485":70671,"_20482":121191,"_5":14053,"_26831":120698,"_2843":121192},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3355":70875,"_29485":70671,"_20482":121194,"_5":14053,"_26831":120698,"_2843":121195},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3355":70876,"_29485":70671,"_20482":121197,"_5":14053,"_26831":120698,"_2843":121198},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3355":70877,"_29485":70671,"_20482":121200,"_5":14053,"_26831":120698,"_2843":121201},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3355":70878,"_29485":70671,"_20482":121203,"_5":14053,"_26831":120698,"_2843":121204},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3355":70879,"_29485":70671,"_20482":121206,"_5":14053,"_26831":120698,"_2843":121207},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3355":70880,"_29485":70671,"_20482":121209,"_5":14053,"_26831":120698,"_2843":121210},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3355":70881,"_29485":70671,"_20482":121212,"_5":14053,"_26831":120698,"_2843":121213},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3355":70882,"_29485":70671,"_20482":121215,"_5":14053,"_26831":120698,"_2843":121216},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3355":70883,"_29485":70671,"_20482":121218,"_5":14053,"_26831":120698,"_2843":121219},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3355":70884,"_29485":70671,"_20482":121221,"_5":14053,"_26831":120702,"_2843":121222},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3355":70885,"_29485":70671,"_20482":121224,"_5":14053,"_26831":120702,"_2843":121225},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3355":70886,"_29485":70671,"_20482":121227,"_5":14053,"_26831":120706,"_2843":121228},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3355":70887,"_29485":70671,"_20482":121230,"_5":14053,"_26831":120706,"_2843":121231},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3355":70888,"_29485":70671,"_20482":121233,"_5":14053,"_26831":120706,"_2843":121234},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3355":70889,"_29485":70671,"_20482":121236,"_5":14053,"_26831":120706,"_2843":121237},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3355":70890,"_29485":70671,"_20482":121239,"_5":14053,"_26831":120706,"_2843":121240},[],"El README de `goose-lamassu` aún muestra ejemplos por base de datos (`dbname=ca`, `dbname=kms`) y afirma que la herramienta valida el nombre de la base de datos, y el README de `ca-to-kms-migration` sigue describiendo el modelo de dos bases anterior a 4.0.0. Sigue la forma con `dbname=pki` de esta página en lugar de sus ejemplos.",{"_3355":70891,"_29485":70671,"_20482":121242,"_5":14053,"_26831":120710,"_2843":121243},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3355":70892,"_29485":70671,"_20482":121245,"_5":14053,"_26831":120710,"_2843":121246},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3355":70893,"_29485":70671,"_20482":121248,"_5":14053,"_26831":120710,"_2843":121249},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3355":70894,"_29485":70671,"_20482":121251,"_5":14053,"_26831":120710,"_2843":121252},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3355":70895,"_29485":70671,"_20482":121254,"_5":14053,"_26831":120710,"_2843":121255},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó por IDs de CA duplicados o por valores de `engine_id` vacíos. Revisa los logs del job, corrige los permisos o los datos y vuelve a ejecutar la actualización.",{"_3355":70896,"_29485":70671,"_20482":121257,"_5":14053,"_26831":120710,"_2843":121258},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3355":70897,"_29485":70671,"_20482":121260,"_5":14053,"_26831":120710,"_2843":121261},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3355":70898,"_29485":70671,"_20482":121263,"_5":14053,"_26831":120713,"_2843":121264},[],"Tras la actualización, comprueba en este orden:",{"_3355":70899,"_29485":70671,"_20482":121266,"_5":14053,"_26831":120713,"_2843":121267},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS.",{"_3355":70900,"_29485":70671,"_20482":121269,"_5":14053,"_26831":120713,"_2843":121270},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3355":70901,"_29485":70671,"_20482":121272,"_5":14053,"_26831":120713,"_2843":121273},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3355":70902,"_29485":70671,"_20482":121275,"_5":14053,"_26831":120713,"_2843":121276},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-ski>` sobre la VA devuelve una CRL emitida anteriormente, y se emiten CRLs nuevas.",{"_3355":70903,"_29485":70671,"_20482":121278,"_5":14053,"_26831":120713,"_2843":121279},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS.",{"_3355":70904,"_29485":70671,"_20482":121281,"_5":14053,"_26831":120713,"_2843":121282},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3355":70905,"_29485":70671,"_20482":121284,"_5":14053,"_26831":120713,"_2843":121285},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3355":70906,"_29485":70671,"_20482":121287,"_5":14053,"_26831":120713,"_2843":121288},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3355":70907,"_29485":70671,"_20482":121290,"_5":14053,"_26831":120713,"_2843":121291},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3355":70908,"_29485":70671,"_20482":121293,"_5":14053,"_26831":120713,"_2843":121294},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3355":70909,"_29485":70671,"_20482":121296,"_5":14053,"_26831":120713,"_2843":121297},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3355":70910,"_29485":70671,"_20482":121299,"_5":14053,"_26831":120713,"_2843":121300},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3355":70911,"_29485":70671,"_20482":121302,"_5":14053,"_26831":120713,"_2843":121303},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3355":70912,"_29485":70671,"_20482":121305,"_5":14053,"_26831":120713,"_2843":121306},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3355":70913,"_29485":70671,"_20482":121308,"_5":14053,"_26831":120717,"_2843":121309},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3355":70914,"_29485":70671,"_20482":121311,"_5":14053,"_26831":120717,"_2843":121312},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3355":70915,"_29485":70671,"_20482":121314,"_5":14053,"_26831":120717,"_2843":121315},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3355":70916,"_29485":70671,"_20482":121317,"_5":14053,"_26831":120717,"_2843":121318},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3355":70917,"_29485":70671,"_20482":121320,"_5":14053,"_26831":120717,"_2843":121321},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_56771":121323,"_56773":121324,"_56775":121325,"_56777":121326,"_17756":2865,"_68088":2865},"spanish",[2843,29485,5,26831],{"_2843":24474,"_29485":24474,"_5":24474,"_26831":24474},{"_2843":121327,"_29485":124153,"_5":126979,"_26831":129805},{"_4517":121328,"_56781":121329,"_5":24474},{"_14135":3140,"_14511":21482,"_14530":4582,"_12656":7037,"_14517":6991,"_19453":17829,"_14156":3901,"_14163":16374,"_28437":22337,"_28845":19727,"_28866":2982,"_28471":4832,"_33754":13732,"_28573":19905,"_28910":9603,"_33761":3298,"_33764":3879,"_33767":6809,"_33770":18774,"_29317":7385,"_33775":4545,"_33777":14183,"_29347":6846,"_14526":19693,"_33781":7294,"_33784":18775,"_33786":5113,"_28894":22335,"_29312":5513,"_29360":3832,"_33791":4313,"_33793":14010,"_33795":6793,"_28590":5626,"_33798":5385,"_33800":7822,"_33802":3199,"_33804":6821,"_33806":6765,"_28507":6808,"_33809":6285,"_33811":5585,"_28501":11491,"_28931":9291,"_33815":3878,"_33817":6986,"_33820":6302,"_28547":27051,"_33824":3593,"_28428":15181,"_33827":16650,"_28476":4631,"_33830":4905,"_33832":5675,"_33835":6757,"_14520":22673,"_33838":3881,"_33840":3566,"_33843":5844,"_33845":10227,"_33847":3847,"_33849":4927,"_33851":4504,"_19456":11623,"_33854":24486,"_33856":4069,"_28449":19732,"_28888":5384,"_33860":19695,"_33862":5782,"_33864":15432,"_29377":6042,"_33867":8658,"_33869":4577,"_33871":5809,"_29471":25487,"_28947":3203,"_33875":3944,"_33877":4049,"_28486":2929,"_33880":5794,"_33882":4606,"_33884":4923,"_29393":3258,"_28567":7413,"_27909":3554,"_