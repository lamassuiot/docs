105685,"_34346":105687,"_34348":105689,"_34350":105691,"_34352":105694,"_34354":105697,"_34356":105700,"_34358":105703,"_34360":105706,"_34362":105709,"_34364":105712,"_34366":105715,"_34368":105718,"_34370":105721,"_34372":105724,"_34374":105727,"_34377":105730,"_34379":105733,"_34381":105736,"_34383":105739,"_34385":105742,"_34387":105745,"_34389":105748,"_34391":105751,"_34393":105753},{"_2936":59276,"_25651":59276,"_5":12587,"_2462":98263,"_25975":98264,"_17922":98267,"_24317":59276},"Despliega desde AWS Marketplace",[41800,98265,98266],"Despliegue","Otros modelos",[],{"_2936":59277,"_25651":59276,"_17922":98269,"_5":17817,"_24317":59276,"_2462":98270},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_2936":59278,"_25651":59276,"_5":25972,"_17922":98272,"_24317":98273,"_2462":98274},[],"/docs/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_2936":59279,"_25651":59276,"_5":25972,"_17922":98276,"_24317":98277,"_2462":98278},[],"/docs/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_2936":59280,"_25651":59276,"_5":25972,"_17922":98280,"_24317":98281,"_2462":98282},[],"/docs/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_2936":59281,"_25651":59276,"_5":25972,"_17922":98284,"_24317":98285,"_2462":98286},[],"/docs/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_2936":59282,"_25651":59276,"_5":25972,"_17922":98288,"_24317":98289,"_2462":98290},[],"/docs/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_2936":59283,"_25651":59276,"_5":25972,"_17922":98292,"_24317":98293,"_2462":98294},[],"/docs/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_2936":59284,"_25651":59276,"_5":25972,"_17922":98296,"_24317":98297,"_2462":98298},[],"/docs/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_2936":59285,"_25651":59276,"_17922":98300,"_5":17817,"_24317":59276,"_2462":98301},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_2936":59286,"_25651":59276,"_17922":98303,"_5":17817,"_24317":98273,"_2462":98304},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_2936":59287,"_25651":59276,"_17922":98306,"_5":17817,"_24317":98273,"_2462":98307},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_2936":59288,"_25651":59276,"_17922":98309,"_5":17817,"_24317":98273,"_2462":98310},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_2936":59289,"_25651":59276,"_17922":98312,"_5":17817,"_24317":98277,"_2462":98313},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_2936":59290,"_25651":59276,"_17922":98315,"_5":17817,"_24317":98277,"_2462":98316},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_2936":59291,"_25651":59276,"_17922":98318,"_5":17817,"_24317":98277,"_2462":98319},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_2936":59292,"_25651":59276,"_17922":98321,"_5":17817,"_24317":98281,"_2462":98322},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_2936":59293,"_25651":59276,"_17922":98324,"_5":17817,"_24317":98285,"_2462":98325},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_2936":59294,"_25651":59276,"_17922":98327,"_5":17817,"_24317":98289,"_2462":98328},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_2936":59295,"_25651":59276,"_17922":98330,"_5":17817,"_24317":98293,"_2462":98331},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_2936":59296,"_25651":59276,"_17922":98333,"_5":17817,"_24317":98297,"_2462":98334},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_2936":59297,"_25651":59297,"_5":12587,"_2462":98336,"_25975":98337,"_17922":98338,"_24317":59297},"Despliega Lamassu",[41800,98265],[],{"_2936":59298,"_25651":59297,"_17922":98340,"_5":17817,"_24317":59297,"_2462":98341},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_2936":59299,"_25651":59297,"_5":25972,"_17922":98343,"_24317":98344,"_2462":98345},[],"/docs/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_2936":59300,"_25651":59297,"_5":25972,"_17922":98347,"_24317":98348,"_2462":98349},[],"/docs/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_2936":59301,"_25651":59297,"_5":25972,"_17922":98351,"_24317":98352,"_2462":98353},[],"/docs/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_2936":59302,"_25651":59297,"_17922":98355,"_5":17817,"_24317":59297,"_2462":98356},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_2936":59303,"_25651":59297,"_17922":98358,"_5":17817,"_24317":98344,"_2462":98359},[],"Modelo",{"_2936":59304,"_25651":59297,"_17922":98361,"_5":17817,"_24317":98344,"_2462":98362},[],"Recomendado para",{"_2936":59305,"_25651":59297,"_17922":98364,"_5":17817,"_24317":98344,"_2462":98365},[],"Quién opera la infraestructura",{"_2936":59306,"_25651":59297,"_17922":98367,"_5":17817,"_24317":98344,"_2462":98368},[],"Punto de partida",{"_2936":59307,"_25651":59297,"_17922":98370,"_5":17817,"_24317":98344,"_2462":41907},[],{"_2936":59308,"_25651":59297,"_17922":98372,"_5":17817,"_24317":98344,"_2462":98373},[],"Producción, entornos regulados y despliegues personalizados",{"_2936":59309,"_25651":59297,"_17922":98375,"_5":17817,"_24317":98344,"_2462":98376},[],"Tu equipo",{"_2936":59310,"_25651":59297,"_17922":98378,"_5":17817,"_24317":98344,"_2462":98379},[],"Helm o Fastlane",{"_2936":59311,"_25651":59297,"_17922":98381,"_5":17817,"_24317":98344,"_2462":41919},[],{"_2936":59312,"_25651":59297,"_17922":98383,"_5":17817,"_24317":98344,"_2462":98384},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_2936":59313,"_25651":59297,"_17922":98386,"_5":17817,"_24317":98344,"_2462":98376},[],{"_2936":59314,"_25651":59297,"_17922":98388,"_5":17817,"_24317":98344,"_2462":98389},[],"Imagen preconfigurada en EC2",{"_2936":59315,"_25651":59297,"_17922":98391,"_5":17817,"_24317":98344,"_2462":41930},[],{"_2936":59316,"_25651":59297,"_17922":98393,"_5":17817,"_24317":98344,"_2462":98394},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_2936":59317,"_25651":59297,"_17922":98396,"_5":17817,"_24317":98344,"_2462":41936},[],{"_2936":59318,"_25651":59297,"_17922":98398,"_5":17817,"_24317":98344,"_2462":98399},[],"Suscripción gestionada",{"_2936":59319,"_25651":59297,"_17922":98401,"_5":17817,"_24317":98344,"_2462":98402},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2936":59320,"_25651":59297,"_17922":98404,"_5":17817,"_24317":98344,"_2462":98405},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2936":59321,"_25651":59297,"_17922":98407,"_5":17817,"_24317":98344,"_2462":98408},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_2936":59322,"_25651":59297,"_17922":98410,"_5":17817,"_24317":98348,"_2462":98411},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_2936":59323,"_25651":59297,"_17922":98413,"_5":17817,"_24317":98352,"_2462":98414},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_2936":59324,"_25651":59324,"_5":12587,"_2462":98416,"_25975":98417,"_17922":98418,"_24317":59324},"Utiliza Lamassu como SaaS",[41800,98265,98266],[],{"_2936":59325,"_25651":59324,"_17922":98420,"_5":17817,"_24317":59324,"_2462":98421},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_2936":59326,"_25651":59324,"_5":25972,"_17922":98423,"_24317":98424,"_2462":98425},[],"/docs/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_2936":59327,"_25651":59324,"_5":25972,"_17922":98427,"_24317":98428,"_2462":98429},[],"/docs/es/deployment/saas#planes","Planes",{"_2936":59328,"_25651":59324,"_5":25972,"_17922":98431,"_24317":98432,"_2462":98433},[],"/docs/es/deployment/saas#solicita-acceso","Solicita acceso",{"_2936":59329,"_25651":59324,"_17922":98435,"_5":17817,"_24317":59324,"_2462":98436},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_2936":59330,"_25651":59324,"_17922":98438,"_5":17817,"_24317":98424,"_2462":98439},[],"Disponibilidad y mantenimiento de la plataforma.",{"_2936":59331,"_25651":59324,"_17922":98441,"_5":17817,"_24317":98424,"_2462":98442},[],"Copias de seguridad automáticas.",{"_2936":59332,"_25651":59324,"_17922":98444,"_5":17817,"_24317":98424,"_2462":98445},[],"Actualizaciones de versión.",{"_2936":59333,"_25651":59324,"_17922":98447,"_5":17817,"_24317":98424,"_2462":98448},[],"Soporte técnico y SLA según el plan contratado.",{"_2936":59334,"_25651":59324,"_17922":98450,"_5":17817,"_24317":98428,"_2462":41991},[],{"_2936":59335,"_25651":59324,"_17922":98452,"_5":17817,"_24317":98428,"_2462":98453},[],"Dispositivos",{"_2936":59336,"_25651":59324,"_17922":98455,"_5":17817,"_24317":98428,"_2462":98456},[],"Soporte",{"_2936":59337,"_25651":59324,"_17922":98458,"_5":17817,"_24317":98428,"_2462":42000},[],{"_2936":59338,"_25651":59324,"_17922":98460,"_5":17817,"_24317":98428,"_2462":42003},[],{"_2936":59339,"_25651":59324,"_17922":98462,"_5":17817,"_24317":98428,"_2462":98463},[],"Hasta 1.000",{"_2936":59340,"_25651":59324,"_17922":98465,"_5":17817,"_24317":98428,"_2462":42009},[],{"_2936":59341,"_25651":59324,"_17922":98467,"_5":17817,"_24317":98428,"_2462":98468},[],"99,5 %",{"_2936":59342,"_25651":59324,"_17922":98470,"_5":17817,"_24317":98428,"_2462":42015},[],{"_2936":59343,"_25651":59324,"_17922":98472,"_5":17817,"_24317":98428,"_2462":98473},[],"Hasta 10.000",{"_2936":59344,"_25651":59324,"_17922":98475,"_5":17817,"_24317":98428,"_2462":98476},[],"Email y chat",{"_2936":59345,"_25651":59324,"_17922":98478,"_5":17817,"_24317":98428,"_2462":98479},[],"99,9 %",{"_2936":59346,"_25651":59324,"_17922":98481,"_5":17817,"_24317":98428,"_2462":42027},[],{"_2936":59347,"_25651":59324,"_17922":98483,"_5":17817,"_24317":98428,"_2462":98484},[],"Ilimitados",{"_2936":59348,"_25651":59324,"_17922":98486,"_5":17817,"_24317":98428,"_2462":98487},[],"Dedicado",{"_2936":59349,"_25651":59324,"_17922":98489,"_5":17817,"_24317":98428,"_2462":98490},[],"99,99 %",{"_2936":59350,"_25651":59324,"_17922":98492,"_5":17817,"_24317":98432,"_2462":98493},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_2936":59351,"_25651":59324,"_17922":98495,"_5":17817,"_24317":98432,"_2462":98496},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_2936":59352,"_25651":59352,"_5":12587,"_2462":42044,"_25975":98498,"_17922":98500,"_24317":59352},[41800,98265,98499],"Kubernetes autogestionado",[],{"_2936":59353,"_25651":59352,"_17922":98502,"_5":17817,"_24317":59352,"_2462":98503},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_2936":59354,"_25651":59352,"_5":25972,"_17922":98505,"_24317":98506,"_2462":98507},[],"/docs/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_2936":59355,"_25651":59352,"_5":25972,"_17922":98509,"_24317":98510,"_2462":98511},[],"/docs/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_2936":59356,"_25651":59352,"_5":25972,"_17922":98513,"_24317":98514,"_2462":98515},[],"/docs/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_2936":59357,"_25651":59352,"_5":25972,"_17922":98517,"_24317":98518,"_2462":98519},[],"/docs/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_2936":59358,"_25651":59352,"_5":25972,"_17922":98521,"_24317":98522,"_2462":98523},[],"/docs/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_2936":59359,"_25651":59352,"_5":25972,"_17922":98525,"_24317":98526,"_2462":98527},[],"/docs/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_2936":59360,"_25651":59352,"_5":25972,"_17922":98529,"_24317":98530,"_2462":98531},[],"/docs/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_2936":59361,"_25651":59352,"_5":25972,"_17922":98533,"_24317":98534,"_2462":98535},[],"/docs/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_2936":59362,"_25651":59352,"_5":25972,"_17922":98537,"_24317":98538,"_2462":98539},[],"/docs/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_2936":59363,"_25651":59352,"_5":25972,"_17922":98541,"_24317":98542,"_2462":98543},[],"/docs/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_2936":59364,"_25651":59352,"_5":25972,"_17922":98545,"_24317":98546,"_2462":98547},[],"/docs/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_2936":59365,"_25651":59352,"_17922":98549,"_5":17817,"_24317":98506,"_2462":98550},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_2936":59366,"_25651":59352,"_17922":98552,"_5":17817,"_24317":98506,"_2462":98553},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_2936":59367,"_25651":59352,"_17922":98555,"_5":17817,"_24317":98510,"_2462":98556},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_2936":59368,"_25651":59352,"_17922":98558,"_5":17817,"_24317":98510,"_2462":98559},[],"Fastlane instala o configura",{"_2936":59369,"_25651":59352,"_17922":98561,"_5":17817,"_24317":98510,"_2462":98562},[],"Tú sigues proporcionando",{"_2936":59370,"_25651":59352,"_17922":98564,"_5":17817,"_24317":98510,"_2462":98565},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_2936":59371,"_25651":59352,"_17922":98567,"_5":17817,"_24317":98510,"_2462":98568},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_2936":59372,"_25651":59352,"_17922":98570,"_5":17817,"_24317":98510,"_2462":98571},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_2936":59373,"_25651":59352,"_17922":98573,"_5":17817,"_24317":98510,"_2462":98574},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_2936":59374,"_25651":59352,"_17922":98576,"_5":17817,"_24317":98510,"_2462":98577},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_2936":59375,"_25651":59352,"_17922":98579,"_5":17817,"_24317":98510,"_2462":98580},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_2936":59376,"_25651":59352,"_17922":98582,"_5":17817,"_24317":98510,"_2462":98583},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_2936":59377,"_25651":59352,"_17922":98585,"_5":17817,"_24317":98510,"_2462":98586},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_2936":59378,"_25651":59352,"_17922":98588,"_5":17817,"_24317":98510,"_2462":98589},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_2936":59379,"_25651":59352,"_17922":98591,"_5":17817,"_24317":98514,"_2462":98592},[],"Necesitas:",{"_2936":59380,"_25651":59352,"_17922":98594,"_5":17817,"_24317":98514,"_2462":98595},[],"un clúster Kubernetes existente",{"_2936":59381,"_25651":59352,"_17922":98597,"_5":17817,"_24317":98514,"_2462":98598},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_2936":59382,"_25651":59352,"_17922":98600,"_5":17817,"_24317":98514,"_2462":42146},[],{"_2936":59383,"_25651":59352,"_17922":98602,"_5":17817,"_24317":98514,"_2462":20275},[],{"_2936":59384,"_25651":59352,"_17922":98604,"_5":17817,"_24317":98514,"_2462":98605},[],"`jq` solo si usas `--sample-data` o `--development`",{"_2936":59385,"_25651":59352,"_17922":98607,"_5":17817,"_24317":98514,"_2462":98608},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_2936":59386,"_25651":59352,"_17922":98610,"_5":17817,"_24317":98514,"_2462":98611},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_2936":59387,"_25651":59352,"_17922":98613,"_5":17817,"_24317":98514,"_2462":98614},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_2936":59388,"_25651":59352,"_17922":98616,"_5":17817,"_24317":98518,"_2462":98617},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_2936":59389,"_25651":59352,"_17922":98619,"_5":17817,"_24317":98518,"_2462":98620},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_2936":59390,"_25651":59352,"_17922":98622,"_5":17817,"_24317":98522,"_2462":98623},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_2936":59391,"_25651":59352,"_17922":98625,"_5":17817,"_24317":98522,"_2462":98626},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_2936":59392,"_25651":59352,"_17922":98628,"_5":17817,"_24317":98522,"_2462":98629},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_2936":59393,"_25651":59352,"_17922":98631,"_5":17817,"_24317":98522,"_2462":98632},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_2936":59394,"_25651":59352,"_17922":98634,"_5":17817,"_24317":98526,"_2462":98635},[],"Opción",{"_2936":59395,"_25651":59352,"_17922":98637,"_5":17817,"_24317":98526,"_2462":98638},[],"Valor predeterminado",{"_2936":59396,"_25651":59352,"_17922":98640,"_5":17817,"_24317":98526,"_2462":98641},[],"Propósito",{"_2936":59397,"_25651":59352,"_17922":98643,"_5":17817,"_24317":98526,"_2462":42190},[],{"_2936":59398,"_25651":59352,"_17922":98645,"_5":17817,"_24317":98526,"_2462":42193},[],{"_2936":59399,"_25651":59352,"_17922":98647,"_5":17817,"_24317":98526,"_2462":98648},[],"Muestra la ayuda",{"_2936":59400,"_25651":59352,"_17922":98650,"_5":17817,"_24317":98526,"_2462":42199},[],{"_2936":59401,"_25651":59352,"_17922":98652,"_5":17817,"_24317":98526,"_2462":98653},[],"contexto actual",{"_2936":59402,"_25651":59352,"_17922":98655,"_5":17817,"_24317":98526,"_2462":98656},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_2936":59403,"_25651":59352,"_17922":98658,"_5":17817,"_24317":98526,"_2462":42208},[],{"_2936":59404,"_25651":59352,"_17922":98660,"_5":17817,"_24317":98526,"_2462":5498},[],{"_2936":59405,"_25651":59352,"_17922":98662,"_5":17817,"_24317":98526,"_2462":98663},[],"Omite prompts y genera credenciales para las dependencias",{"_2936":59406,"_25651":59352,"_17922":98665,"_5":17817,"_24317":98526,"_2462":42216},[],{"_2936":59407,"_25651":59352,"_17922":98667,"_5":17817,"_24317":98526,"_2462":42219},[],{"_2936":59408,"_25651":59352,"_17922":98669,"_5":17817,"_24317":98526,"_2462":98670},[],"Namespace de la instalación",{"_2936":59409,"_25651":59352,"_17922":98672,"_5":17817,"_24317":98526,"_2462":42225},[],{"_2936":59410,"_25651":59352,"_17922":98674,"_5":17817,"_24317":98526,"_2462":42228},[],{"_2936":59411,"_25651":59352,"_17922":98676,"_5":17817,"_24317":98526,"_2462":98677},[],"Dominio usado por la UI, OIDC y el certificado",{"_2936":59412,"_25651":59352,"_17922":98679,"_5":17817,"_24317":98526,"_2462":42234},[],{"_2936":59413,"_25651":59352,"_17922":98681,"_5":17817,"_24317":98526,"_2462":12818},[],{"_2936":59414,"_25651":59352,"_17922":98683,"_5":17817,"_24317":98526,"_2462":98684},[],"Versión del chart de Lamassu",{"_2936":59415,"_25651":59352,"_17922":98686,"_5":17817,"_24317":98526,"_2462":42242},[],{"_2936":59416,"_25651":59352,"_17922":98688,"_5":17817,"_24317":98526,"_2462":42245},[],{"_2936":59417,"_25651":59352,"_17922":98690,"_5":17817,"_24317":98526,"_2462":98691},[],"Puerto del listener HTTPS",{"_2936":59418,"_25651":59352,"_17922":98693,"_5":17817,"_24317":98526,"_2462":42251},[],{"_2936":59419,"_25651":59352,"_17922":98695,"_5":17817,"_24317":98526,"_2462":42254},[],{"_2936":59420,"_25651":59352,"_17922":98697,"_5":17817,"_24317":98526,"_2462":98698},[],"Puerto del listener HTTP",{"_2936":59421,"_25651":59352,"_17922":98700,"_5":17817,"_24317":98526,"_2462":42260},[],{"_2936":59422,"_25651":59352,"_17922":98702,"_5":17817,"_24317":98526,"_2462":42193},[],{"_2936":59423,"_25651":59352,"_17922":98704,"_5":17817,"_24317":98526,"_2462":98705},[],"Certificado PEM para TLS downstream",{"_2936":59424,"_25651":59352,"_17922":98707,"_5":17817,"_24317":98526,"_2462":42268},[],{"_2936":59425,"_25651":59352,"_17922":98709,"_5":17817,"_24317":98526,"_2462":42193},[],{"_2936":59426,"_25651":59352,"_17922":98711,"_5":17817,"_24317":98526,"_2462":98712},[],"Clave privada PEM para TLS downstream",{"_2936":59427,"_25651":59352,"_17922":98714,"_5":17817,"_24317":98526,"_2462":42276},[],{"_2936":59428,"_25651":59352,"_17922":98716,"_5":17817,"_24317":98526,"_2462":98717},[],"chart del repositorio",{"_2936":59429,"_25651":59352,"_17922":98719,"_5":17817,"_24317":98526,"_2462":98720},[],"Usa un chart local de Lamassu sin empaquetar",{"_2936":59430,"_25651":59352,"_17922":98722,"_5":17817,"_24317":98526,"_2462":42285},[],{"_2936":59431,"_25651":59352,"_17922":98724,"_5":17817,"_24317":98526,"_2462":98725},[],"detección automática",{"_2936":59432,"_25651":59352,"_17922":98727,"_5":17817,"_24317":98526,"_2462":98728},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_2936":59433,"_25651":59352,"_17922":98730,"_5":17817,"_24317":98526,"_2462":42293},[],{"_2936":59434,"_25651":59352,"_17922":98732,"_5":17817,"_24317":98526,"_2462":5498},[],{"_2936":59435,"_25651":59352,"_17922":98734,"_5":17817,"_24317":98526,"_2462":98735},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_2936":59436,"_25651":59352,"_17922":98737,"_5":17817,"_24317":98526,"_2462":42301},[],{"_2936":59437,"_25651":59352,"_17922":98739,"_5":17817,"_24317":98526,"_2462":5498},[],{"_2936":59438,"_25651":59352,"_17922":98741,"_5":17817,"_24317":98526,"_2462":98742},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_2936":59439,"_25651":59352,"_17922":98744,"_5":17817,"_24317":98526,"_2462":42309},[],{"_2936":59440,"_25651":59352,"_17922":98746,"_5":17817,"_24317":98526,"_2462":5498},[],{"_2936":59441,"_25651":59352,"_17922":98748,"_5":17817,"_24317":98526,"_2462":98749},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_2936":59442,"_25651":59352,"_17922":98751,"_5":17817,"_24317":98526,"_2462":42317},[],{"_2936":59443,"_25651":59352,"_17922":98753,"_5":17817,"_24317":98526,"_2462":5498},[],{"_2936":59444,"_25651":59352,"_17922":98755,"_5":17817,"_24317":98526,"_2462":98756},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_2936":59445,"_25651":59352,"_17922":98758,"_5":17817,"_24317":98526,"_2462":42325},[],{"_2936":59446,"_25651":59352,"_17922":98760,"_5":17817,"_24317":98526,"_2462":42328},[],{"_2936":59447,"_25651":59352,"_17922":98762,"_5":17817,"_24317":98526,"_2462":98763},[],"Usa otro chart local de SoftHSM",{"_2936":59448,"_25651":59352,"_17922":98765,"_5":17817,"_24317":98526,"_2462":98766},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_2936":59449,"_25651":59352,"_17922":98768,"_5":17817,"_24317":98530,"_2462":98769},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_2936":59450,"_25651":59352,"_17922":98771,"_5":17817,"_24317":98530,"_2462":98772},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_2936":59451,"_25651":59352,"_17922":98774,"_5":17817,"_24317":98530,"_2462":98775},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_2936":59452,"_25651":59352,"_17922":98777,"_5":17817,"_24317":98530,"_2462":98778},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_2936":59453,"_25651":59352,"_17922":98780,"_5":17817,"_24317":98530,"_2462":98781},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_2936":59454,"_25651":59352,"_17922":98783,"_5":17817,"_24317":98530,"_2462":98784},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_2936":59455,"_25651":59352,"_17922":98786,"_5":17817,"_24317":98534,"_2462":42355},[],{"_2936":59456,"_25651":59352,"_17922":98788,"_5":17817,"_24317":98534,"_2462":98789},[],"valida las herramientas locales y el clúster seleccionado",{"_2936":59457,"_25651":59352,"_17922":98791,"_5":17817,"_24317":98534,"_2462":98792},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_2936":59458,"_25651":59352,"_17922":98794,"_5":17817,"_24317":98534,"_2462":98795},[],"crea el namespace",{"_2936":59459,"_25651":59352,"_17922":98797,"_5":17817,"_24317":98534,"_2462":98798},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_2936":59460,"_25651":59352,"_17922":98800,"_5":17817,"_24317":98534,"_2462":98801},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_2936":59461,"_25651":59352,"_17922":98803,"_5":17817,"_24317":98534,"_2462":98804},[],"instala RabbitMQ",{"_2936":59462,"_25651":59352,"_17922":98806,"_5":17817,"_24317":98534,"_2462":98807},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_2936":59463,"_25651":59352,"_17922":98809,"_5":17817,"_24317":98534,"_2462":98810},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_2936":59464,"_25651":59352,"_17922":98812,"_5":17817,"_24317":98534,"_2462":98813},[],"carga datos de ejemplo opcionalmente",{"_2936":59465,"_25651":59352,"_17922":98815,"_5":17817,"_24317":98534,"_2462":98816},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_2936":59466,"_25651":59352,"_17922":98818,"_5":17817,"_24317":98538,"_2462":98819},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_2936":59467,"_25651":59352,"_17922":98821,"_5":17817,"_24317":98538,"_2462":98822},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_2936":59468,"_25651":59352,"_17922":98824,"_5":17817,"_24317":98542,"_2462":98825},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_2936":59469,"_25651":59352,"_17922":98827,"_5":17817,"_24317":98542,"_2462":98828},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_2936":59470,"_25651":59352,"_17922":98830,"_5":17817,"_24317":98542,"_2462":98831},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_2936":59471,"_25651":59352,"_17922":98833,"_5":17817,"_24317":98546,"_2462":98834},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_2936":59472,"_25651":59472,"_5":12587,"_2462":98836,"_25975":98837,"_17922":98838,"_24317":59472},"Instala con Helm",[41800,98265,98499],[],{"_2936":59473,"_25651":59472,"_17922":98840,"_5":17817,"_24317":59472,"_2462":98841},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_2936":59474,"_25651":59472,"_5":25972,"_17922":98843,"_24317":98844,"_2462":98845},[],"/docs/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_2936":59475,"_25651":59472,"_5":25972,"_17922":98847,"_24317":98848,"_2462":98515},[],"/docs/es/deployment/self-hosted/helm#antes-de-comenzar",{"_2936":59476,"_25651":59472,"_5":25972,"_17922":98850,"_24317":98851,"_2462":98852},[],"/docs/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_2936":59477,"_25651":59472,"_5":25972,"_17922":98854,"_24317":98855,"_2462":98856},[],"/docs/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_2936":59478,"_25651":59472,"_5":25972,"_17922":98858,"_24317":98859,"_2462":98860},[],"/docs/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_2936":59479,"_25651":59472,"_5":25972,"_17922":98862,"_24317":98863,"_2462":98864},[],"/docs/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_2936":59480,"_25651":59472,"_5":25972,"_17922":98866,"_24317":98867,"_2462":98868},[],"/docs/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_2936":59481,"_25651":59472,"_5":25972,"_17922":98870,"_24317":98871,"_2462":98872},[],"/docs/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_2936":59482,"_25651":59472,"_5":25972,"_17922":98874,"_24317":98875,"_2462":98876},[],"/docs/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_2936":59483,"_25651":59472,"_17922":98878,"_5":17817,"_24317":98844,"_2462":98879},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_2936":59484,"_25651":59472,"_17922":98881,"_5":17817,"_24317":98848,"_2462":98882},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_2936":59485,"_25651":59472,"_17922":98884,"_5":17817,"_24317":98848,"_2462":98885},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_2936":59486,"_25651":59472,"_17922":98887,"_5":17817,"_24317":98848,"_2462":98888},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_2936":59487,"_25651":59472,"_17922":98890,"_5":17817,"_24317":98848,"_2462":98891},[],"un broker RabbitMQ accesible y sus credenciales",{"_2936":59488,"_25651":59472,"_17922":98893,"_5":17817,"_24317":98848,"_2462":98894},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_2936":59489,"_25651":59472,"_17922":98896,"_5":17817,"_24317":98848,"_2462":98897},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_2936":59490,"_25651":59472,"_17922":98899,"_5":17817,"_24317":98848,"_2462":98900},[],"cert-manager 1.14+; para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_2936":59491,"_25651":59472,"_17922":98902,"_5":17817,"_24317":98848,"_2462":98903},[],"una StorageClass y un diseño de tráfico externo",{"_2936":59492,"_25651":59472,"_17922":98905,"_5":17817,"_24317":98848,"_2462":98906},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_2936":59493,"_25651":59472,"_17922":98908,"_5":17817,"_24317":98848,"_2462":98909},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_2936":59494,"_25651":59472,"_17922":98911,"_5":17817,"_24317":98848,"_2462":98912},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_2936":59495,"_25651":59472,"_17922":98914,"_5":17817,"_24317":98851,"_2462":98915},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_2936":59496,"_25651":59472,"_17922":98917,"_5":17817,"_24317":98851,"_2462":98918},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_2936":59497,"_25651":59472,"_17922":98920,"_5":17817,"_24317":98851,"_2462":98921},[],"Instala cert-manager por separado antes de Lamassu. El chart actual renderiza sus recursos de issuer self-signed y certificado CA incluso cuando `tls.type: external` hace que el Gateway use un Secret TLS existente. Seleccionar TLS externo no elimina por tanto el requisito de cert-manager.",{"_2936":59498,"_25651":59472,"_17922":98923,"_5":17817,"_24317":98855,"_2462":98924},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_2936":59499,"_25651":59472,"_17922":98926,"_5":17817,"_24317":98855,"_2462":98927},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_2936":59500,"_25651":59472,"_17922":98929,"_5":17817,"_24317":98855,"_2462":98930},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_2936":59501,"_25651":59472,"_17922":98932,"_5":17817,"_24317":98859,"_2462":98933},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo:",{"_2936":59502,"_25651":59472,"_17922":98935,"_5":17817,"_24317":98863,"_2462":98936},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_2936":59503,"_25651":59472,"_17922":98938,"_5":17817,"_24317":98863,"_2462":98939},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_2936":59504,"_25651":59472,"_17922":98941,"_5":17817,"_24317":98863,"_2462":98942},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_2936":59505,"_25651":59472,"_17922":98944,"_5":17817,"_24317":98863,"_2462":98945},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_2936":59506,"_25651":59472,"_17922":98947,"_5":17817,"_24317":98867,"_2462":98948},[],"Para instalar un checkout local:",{"_2936":59507,"_25651":59472,"_17922":98950,"_5":17817,"_24317":98871,"_2462":98951},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_2936":59508,"_25651":59472,"_17922":98953,"_5":17817,"_24317":98871,"_2462":98954},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_2936":59509,"_25651":59472,"_17922":98956,"_5":17817,"_24317":98875,"_2462":98957},[],"Antes de pasar a producción, revisa:",{"_2936":59510,"_25651":59472,"_17922":98959,"_5":17817,"_24317":98875,"_2462":98960},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_2936":59511,"_25651":59472,"_17922":98962,"_5":17817,"_24317":98875,"_2462":98963},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_2936":59512,"_25651":59472,"_17922":98965,"_5":17817,"_24317":98875,"_2462":98966},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_2936":59513,"_25651":59472,"_17922":98968,"_5":17817,"_24317":98875,"_2462":98969},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_2936":59514,"_25651":59472,"_17922":98971,"_5":17817,"_24317":98875,"_2462":98972},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_2936":59515,"_25651":59472,"_17922":98974,"_5":17817,"_24317":98875,"_2462":98975},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_2936":59516,"_25651":59472,"_17922":98977,"_5":17817,"_24317":98875,"_2462":98978},[],"SMTP, observabilidad y entrega de alertas",{"_2936":59517,"_25651":59472,"_17922":98980,"_5":17817,"_24317":98875,"_2462":98981},[],"las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_2936":59518,"_25651":59472,"_17922":98983,"_5":17817,"_24317":98875,"_2462":98984},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_2936":59519,"_25651":59519,"_5":12587,"_2462":98986,"_25975":98987,"_17922":98988,"_24317":59519},"Expón el Gateway",[41800,98265,98499],[],{"_2936":59520,"_25651":59519,"_17922":98990,"_5":17817,"_24317":59519,"_2462":98991},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_2936":59521,"_25651":59519,"_5":25972,"_17922":98993,"_24317":98994,"_2462":98995},[],"/docs/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_2936":59522,"_25651":59519,"_5":25972,"_17922":98997,"_24317":98998,"_2462":98999},[],"/docs/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_2936":59523,"_25651":59519,"_5":25972,"_17922":99001,"_24317":99002,"_2462":99003},[],"/docs/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_2936":59524,"_25651":59519,"_5":25972,"_17922":99005,"_24317":99006,"_2462":42576},[],"/docs/es/deployment/self-hosted/networking#k3s",{"_2936":59525,"_25651":59519,"_5":25972,"_17922":99008,"_24317":99009,"_2462":99010},[],"/docs/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_2936":59526,"_25651":59519,"_5":25972,"_17922":99012,"_24317":99013,"_2462":99014},[],"/docs/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_2936":59527,"_25651":59519,"_5":25972,"_17922":99016,"_24317":99017,"_2462":99018},[],"/docs/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_2936":59528,"_25651":59519,"_5":25972,"_17922":99020,"_24317":99021,"_2462":99022},[],"/docs/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_2936":59529,"_25651":59519,"_5":25972,"_17922":99024,"_24317":99025,"_2462":99026},[],"/docs/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_2936":59530,"_25651":59519,"_17922":99028,"_5":17817,"_24317":98994,"_2462":99029},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_2936":59531,"_25651":59519,"_17922":99031,"_5":17817,"_24317":98994,"_2462":99032},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_2936":59532,"_25651":59519,"_17922":99034,"_5":17817,"_24317":98998,"_2462":99035},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_2936":59533,"_25651":59519,"_17922":99037,"_5":17817,"_24317":98998,"_2462":99038},[],"Defínelo únicamente cuando:",{"_2936":59534,"_25651":59519,"_17922":99040,"_5":17817,"_24317":98998,"_2462":99041},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_2936":59535,"_25651":59519,"_17922":99043,"_5":17817,"_24317":98998,"_2462":99044},[],"esa dirección está asignada a este Gateway",{"_2936":59536,"_25651":59519,"_17922":99046,"_5":17817,"_24317":98998,"_2462":99047},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_2936":59537,"_25651":59519,"_17922":99049,"_5":17817,"_24317":98998,"_2462":99050},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_2936":59538,"_25651":59519,"_17922":99052,"_5":17817,"_24317":98998,"_2462":99053},[],"No confundas estos valores:",{"_2936":59539,"_25651":59519,"_17922":99055,"_5":17817,"_24317":98998,"_2462":99056},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_2936":59540,"_25651":59519,"_17922":99058,"_5":17817,"_24317":98998,"_2462":99059},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_2936":59541,"_25651":59519,"_17922":99061,"_5":17817,"_24317":98998,"_2462":99062},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_2936":59542,"_25651":59519,"_17922":99064,"_5":17817,"_24317":99002,"_2462":99065},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_2936":59543,"_25651":59519,"_17922":99067,"_5":17817,"_24317":99002,"_2462":99068},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_2936":59544,"_25651":59519,"_17922":99070,"_5":17817,"_24317":99006,"_2462":99071},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_2936":59545,"_25651":59519,"_17922":99073,"_5":17817,"_24317":99006,"_2462":99074},[],"Para el diseño recomendado:",{"_2936":59546,"_25651":59519,"_17922":99076,"_5":17817,"_24317":99006,"_2462":99077},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_2936":59547,"_25651":59519,"_17922":99079,"_5":17817,"_24317":99006,"_2462":99080},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_2936":59548,"_25651":59519,"_17922":99082,"_5":17817,"_24317":99006,"_2462":99083},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_2936":59549,"_25651":59519,"_17922":99085,"_5":17817,"_24317":99006,"_2462":99086},[],"Apunta DNS a la dirección accesible de la VM.",{"_2936":59550,"_25651":59519,"_17922":99088,"_5":17817,"_24317":99006,"_2462":99089},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_2936":59551,"_25651":59519,"_17922":99091,"_5":17817,"_24317":99009,"_2462":99092},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_2936":59552,"_25651":59519,"_17922":99094,"_5":17817,"_24317":99013,"_2462":99095},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_2936":59553,"_25651":59519,"_17922":99097,"_5":17817,"_24317":99013,"_2462":99098},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_2936":59554,"_25651":59519,"_17922":99100,"_5":17817,"_24317":99017,"_2462":99101},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_2936":59555,"_25651":59519,"_17922":99103,"_5":17817,"_24317":99017,"_2462":99104},[],"Requisito",{"_2936":59556,"_25651":59519,"_17922":99106,"_5":17817,"_24317":99017,"_2462":99107},[],"Diseño recomendado",{"_2936":59557,"_25651":59519,"_17922":99109,"_5":17817,"_24317":99017,"_2462":99110},[],"Consecuencia",{"_2936":59558,"_25651":59519,"_17922":99112,"_5":17817,"_24317":99017,"_2462":99113},[],"Varias URL o servicios de Lamassu",{"_2936":59559,"_25651":59519,"_17922":99115,"_5":17817,"_24317":99017,"_2462":99116},[],"Un Gateway con varias rutas",{"_2936":59560,"_25651":59519,"_17922":99118,"_5":17817,"_24317":99017,"_2462":99119},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_2936":59561,"_25651":59519,"_17922":99121,"_5":17817,"_24317":99017,"_2462":99122},[],"Gateways independientes e IP externas distintas",{"_2936":59562,"_25651":59519,"_17922":99124,"_5":17817,"_24317":99017,"_2462":99125},[],"Una VIP por Gateway",{"_2936":59563,"_25651":59519,"_17922":99127,"_5":17817,"_24317":99017,"_2462":99128},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_2936":59564,"_25651":59519,"_17922":99130,"_5":17817,"_24317":99017,"_2462":99131},[],"Gateways independientes, un nodo y una IP",{"_2936":59565,"_25651":59519,"_17922":99133,"_5":17817,"_24317":99017,"_2462":99134},[],"Puertos externos diferentes",{"_2936":59566,"_25651":59519,"_17922":99136,"_5":17817,"_24317":99017,"_2462":99137},[],"Los clientes deben indicar puertos no estándar",{"_2936":59567,"_25651":59519,"_17922":99139,"_5":17817,"_24317":99017,"_2462":99140},[],"Terminación TLS/mTLS separada detrás de una IP",{"_2936":59568,"_25651":59519,"_17922":99142,"_5":17817,"_24317":99017,"_2462":99143},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_2936":59569,"_25651":59519,"_17922":99145,"_5":17817,"_24317":99017,"_2462":99146},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_2936":59570,"_25651":59519,"_17922":99148,"_5":17817,"_24317":99017,"_2462":99149},[],"Recursos Gateway separados pero proxy compartido",{"_2936":59571,"_25651":59519,"_17922":99151,"_5":17817,"_24317":99017,"_2462":99152},[],"Modo merged Gateway de Envoy",{"_2936":59572,"_25651":59519,"_17922":99154,"_5":17817,"_24317":99017,"_2462":99155},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_2936":59573,"_25651":59519,"_17922":99157,"_5":17817,"_24317":99017,"_2462":99158},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_2936":59574,"_25651":59519,"_17922":99160,"_5":17817,"_24317":99017,"_2462":99161},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_2936":59575,"_25651":59519,"_17922":99163,"_5":17817,"_24317":99017,"_2462":99164},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_2936":59576,"_25651":59519,"_17922":99166,"_5":17817,"_24317":99017,"_2462":99167},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_2936":59577,"_25651":59519,"_17922":99169,"_5":17817,"_24317":99021,"_2462":99170},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_2936":59578,"_25651":59519,"_17922":99172,"_5":17817,"_24317":99021,"_2462":99173},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_2936":59579,"_25651":59519,"_17922":99175,"_5":17817,"_24317":99021,"_2462":99176},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_2936":59580,"_25651":59519,"_17922":99178,"_5":17817,"_24317":99021,"_2462":99179},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_2936":59581,"_25651":59519,"_17922":99181,"_5":17817,"_24317":99021,"_2462":99182},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_2936":59582,"_25651":59519,"_17922":99184,"_5":17817,"_24317":99025,"_2462":99185},[],"Comprueba, en orden:",{"_2936":59583,"_25651":59519,"_17922":99187,"_5":17817,"_24317":99025,"_2462":99188},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_2936":59584,"_25651":59519,"_17922":99190,"_5":17817,"_24317":99025,"_2462":99191},[],"Su estado contiene la dirección esperada.",{"_2936":59585,"_25651":59519,"_17922":99193,"_5":17817,"_24317":99025,"_2462":99194},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_2936":59586,"_25651":59519,"_17922":99196,"_5":17817,"_24317":99025,"_2462":99197},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_2936":59587,"_25651":59519,"_17922":99199,"_5":17817,"_24317":99025,"_2462":99200},[],"DNS resuelve al endpoint accesible externamente.",{"_2936":59588,"_25651":59519,"_17922":99202,"_5":17817,"_24317":99025,"_2462":99203},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_2936":59589,"_25651":59519,"_17922":99205,"_5":17817,"_24317":99025,"_2462":99206},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_2936":59590,"_25651":59590,"_5":12587,"_2462":41907,"_25975":99208,"_17922":99209,"_24317":59590},[41800,98265,98499],[],{"_2936":59591,"_25651":59590,"_17922":99211,"_5":17817,"_24317":59590,"_2462":99212},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_2936":59592,"_25651":59590,"_5":25972,"_17922":99214,"_24317":99215,"_2462":99216},[],"/docs/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_2936":59593,"_25651":59590,"_5":25972,"_17922":99218,"_24317":99219,"_2462":99220},[],"/docs/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_2936":59594,"_25651":59590,"_5":25972,"_17922":99222,"_24317":99223,"_2462":99224},[],"/docs/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_2936":59595,"_25651":59590,"_5":25972,"_17922":99226,"_24317":99227,"_2462":99228},[],"/docs/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_2936":59596,"_25651":59590,"_5":25972,"_17922":99230,"_24317":99231,"_2462":99232},[],"/docs/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_2936":59597,"_25651":59590,"_5":25972,"_17922":99234,"_24317":99235,"_2462":99236},[],"/docs/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_2936":59598,"_25651":59590,"_17922":99238,"_5":17817,"_24317":99215,"_2462":99239},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_2936":59599,"_25651":59590,"_17922":99241,"_5":17817,"_24317":99219,"_2462":99242},[],"Flujo",{"_2936":59600,"_25651":59590,"_17922":99244,"_5":17817,"_24317":99219,"_2462":99245},[],"Úsalo para",{"_2936":59601,"_25651":59590,"_17922":99247,"_5":17817,"_24317":99219,"_2462":99248},[],"Qué instala",{"_2936":59602,"_25651":59590,"_17922":99250,"_5":17817,"_24317":99219,"_2462":42821},[],{"_2936":59603,"_25651":59590,"_17922":99252,"_5":17817,"_24317":99219,"_2462":99253},[],"Producción y entornos controlados",{"_2936":59604,"_25651":59590,"_17922":99255,"_5":17817,"_24317":99219,"_2462":99256},[],"Servicios de Lamassu y recursos de Gateway API",{"_2936":59605,"_25651":59590,"_17922":99258,"_5":17817,"_24317":99219,"_2462":42044},[],{"_2936":59606,"_25651":59590,"_17922":99260,"_5":17817,"_24317":99219,"_2462":99261},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_2936":59607,"_25651":59590,"_17922":99263,"_5":17817,"_24317":99219,"_2462":99264},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_2936":59608,"_25651":59590,"_17922":99266,"_5":17817,"_24317":99223,"_2462":99267},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_2936":59609,"_25651":59590,"_17922":99269,"_5":17817,"_24317":99223,"_2462":99270},[],"Área",{"_2936":59610,"_25651":59590,"_17922":99272,"_5":17817,"_24317":99223,"_2462":99273},[],"El chart de Lamassu proporciona",{"_2936":59611,"_25651":59590,"_17922":99275,"_5":17817,"_24317":99223,"_2462":99276},[],"Tú proporcionas",{"_2936":59612,"_25651":59590,"_17922":99278,"_5":17817,"_24317":99223,"_2462":99279},[],"Aplicaciones Lamassu",{"_2936":59613,"_25651":59590,"_17922":99281,"_5":17817,"_24317":99223,"_2462":99282},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_2936":59614,"_25651":59590,"_17922":99284,"_5":17817,"_24317":99223,"_2462":99285},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_2936":59615,"_25651":59590,"_17922":99287,"_5":17817,"_24317":99223,"_2462":99288},[],"Datos PostgreSQL",{"_2936":59616,"_25651":59590,"_17922":99290,"_5":17817,"_24317":99223,"_2462":99291},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_2936":59617,"_25651":59590,"_17922":99293,"_5":17817,"_24317":99223,"_2462":99294},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_2936":59618,"_25651":59590,"_17922":99296,"_5":17817,"_24317":99223,"_2462":99297},[],"Mensajería",{"_2936":59619,"_25651":59590,"_17922":99299,"_5":17817,"_24317":99223,"_2462":99300},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu",{"_2936":59620,"_25651":59590,"_17922":99302,"_5":17817,"_24317":99223,"_2462":99303},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_2936":59621,"_25651":59590,"_17922":99305,"_5":17817,"_24317":99223,"_2462":99306},[],"Identidad",{"_2936":59622,"_25651":59590,"_17922":99308,"_5":17817,"_24317":99223,"_2462":99309},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_2936":59623,"_25651":59590,"_17922":99311,"_5":17817,"_24317":99223,"_2462":99312},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_2936":59624,"_25651":59590,"_17922":99314,"_5":17817,"_24317":99223,"_2462":99315},[],"Enrutamiento externo",{"_2936":59625,"_25651":59590,"_17922":99317,"_5":17817,"_24317":99223,"_2462":99318},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_2936":59626,"_25651":59590,"_17922":99320,"_5":17817,"_24317":99223,"_2462":99321},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_2936":59627,"_25651":59590,"_17922":99323,"_5":17817,"_24317":99223,"_2462":42895},[],{"_2936":59628,"_25651":59590,"_17922":99325,"_5":17817,"_24317":99223,"_2462":99326},[],"Recursos `Issuer` y `Certificate` CA de cert-manager; un `Certificate` downstream gestionado por el chart o una referencia a tu Secret TLS",{"_2936":59629,"_25651":59590,"_17922":99328,"_5":17817,"_24317":99223,"_2462":99329},[],"cert-manager; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_2936":59630,"_25651":59590,"_17922":99331,"_5":17817,"_24317":99223,"_2462":99332},[],"Datos persistentes de la aplicación",{"_2936":59631,"_25651":59590,"_17922":99334,"_5":17817,"_24317":99223,"_2462":99335},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_2936":59632,"_25651":59590,"_17922":99337,"_5":17817,"_24317":99223,"_2462":99338},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_2936":59633,"_25651":59590,"_17922":99340,"_5":17817,"_24317":99223,"_2462":99341},[],"Integraciones opcionales",{"_2936":59634,"_25651":59590,"_17922":99343,"_5":17817,"_24317":99223,"_2462":99344},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_2936":59635,"_25651":59590,"_17922":99346,"_5":17817,"_24317":99223,"_2462":99347},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_2936":59636,"_25651":59590,"_17922":99349,"_5":17817,"_24317":99223,"_2462":99350},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_2936":59637,"_25651":59590,"_17922":99352,"_5":17817,"_24317":99223,"_2462":99353},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_2936":59638,"_25651":59590,"_17922":99355,"_5":17817,"_24317":99227,"_2462":99356},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_2936":59639,"_25651":59590,"_17922":99358,"_5":17817,"_24317":99227,"_2462":99359},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_2936":59640,"_25651":59590,"_17922":99361,"_5":17817,"_24317":99231,"_2462":99362},[],"Kubernetes 1.24 o posterior",{"_2936":59641,"_25651":59590,"_17922":99364,"_5":17817,"_24317":99231,"_2462":99365},[],"Helm 3.2 o posterior",{"_2936":59642,"_25651":59590,"_17922":99367,"_5":17817,"_24317":99231,"_2462":99368},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_2936":59643,"_25651":59590,"_17922":99370,"_5":17817,"_24317":99231,"_2462":99371},[],"cert-manager 1.14 o posterior; el chart actual renderiza recursos issuer y certificate de cert-manager",{"_2936":59644,"_25651":59590,"_17922":99373,"_5":17817,"_24317":99231,"_2462":99374},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_2936":59645,"_25651":59590,"_17922":99376,"_5":17817,"_24317":99231,"_2462":99377},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_2936":59646,"_25651":59590,"_17922":99379,"_5":17817,"_24317":99231,"_2462":99380},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior.",{"_2936":59647,"_25651":59590,"_17922":99382,"_5":17817,"_24317":99235,"_2462":99383},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2936":59648,"_25651":59590,"_17922":99385,"_5":17817,"_24317":99235,"_2462":99386},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2936":59649,"_25651":59590,"_17922":99388,"_5":17817,"_24317":99235,"_2462":99389},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2936":59650,"_25651":59650,"_5":12587,"_2462":99391,"_25975":99392,"_17922":99394,"_24317":59650},"Resolución de problemas de despliegue",[41800,98265,99393],"Operación",[],{"_2936":59651,"_25651":59650,"_17922":99396,"_5":17817,"_24317":59650,"_2462":99397},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_2936":59652,"_25651":59650,"_5":25972,"_17922":99399,"_24317":99400,"_2462":99401},[],"/docs/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_2936":59653,"_25651":59650,"_5":25972,"_17922":99403,"_24317":99404,"_2462":99405},[],"/docs/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_2936":59654,"_25651":59650,"_5":25972,"_17922":99407,"_24317":99408,"_2462":99409},[],"/docs/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_2936":59655,"_25651":59650,"_5":25972,"_17922":99411,"_24317":99412,"_2462":99413},[],"/docs/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_2936":59656,"_25651":59650,"_5":25972,"_17922":99415,"_24317":99416,"_2462":99417},[],"/docs/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_2936":59657,"_25651":59650,"_5":25972,"_17922":99419,"_24317":99420,"_2462":99421},[],"/docs/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_2936":59658,"_25651":59650,"_5":25972,"_17922":99423,"_24317":99424,"_2462":99425},[],"/docs/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_2936":59659,"_25651":59650,"_5":25972,"_17922":99427,"_24317":99428,"_2462":99429},[],"/docs/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_2936":59660,"_25651":59650,"_5":25972,"_17922":99431,"_24317":99432,"_2462":99433},[],"/docs/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_2936":59661,"_25651":59650,"_5":25972,"_17922":99435,"_24317":99436,"_2462":99437},[],"/docs/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_2936":59662,"_25651":59650,"_5":25972,"_17922":99439,"_24317":99440,"_2462":99441},[],"/docs/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_2936":59663,"_25651":59650,"_5":25972,"_17922":99443,"_24317":99444,"_2462":99445},[],"/docs/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_2936":59664,"_25651":59650,"_17922":99447,"_5":17817,"_24317":59650,"_2462":99448},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_2936":59665,"_25651":59650,"_17922":99450,"_5":17817,"_24317":99404,"_2462":99451},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_2936":59666,"_25651":59650,"_17922":99453,"_5":17817,"_24317":99408,"_2462":99454},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_2936":59667,"_25651":59650,"_17922":99456,"_5":17817,"_24317":99412,"_2462":99457},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_2936":59668,"_25651":59650,"_17922":99459,"_5":17817,"_24317":99416,"_2462":99460},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_2936":59669,"_25651":59650,"_17922":99462,"_5":17817,"_24317":99420,"_2462":99463},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_2936":59670,"_25651":59650,"_17922":99465,"_5":17817,"_24317":99424,"_2462":99466},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_2936":59671,"_25651":59650,"_17922":99468,"_5":17817,"_24317":99424,"_2462":99469},[],"Ejecuta también la prueba de conectividad del chart:",{"_2936":59672,"_25651":59650,"_17922":99471,"_5":17817,"_24317":99424,"_2462":99472},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_2936":59673,"_25651":59650,"_17922":99474,"_5":17817,"_24317":99424,"_2462":99475},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_2936":59674,"_25651":59650,"_17922":99477,"_5":17817,"_24317":99428,"_2462":99478},[],"Si recibes un 401:",{"_2936":59675,"_25651":59650,"_17922":99480,"_5":17817,"_24317":99428,"_2462":99481},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_2936":59676,"_25651":59650,"_17922":99483,"_5":17817,"_24317":99428,"_2462":99484},[],"verifica emisor, audiencia y expiración del token;",{"_2936":59677,"_25651":59650,"_17922":99486,"_5":17817,"_24317":99428,"_2462":99487},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_2936":59678,"_25651":59650,"_17922":99489,"_5":17817,"_24317":99428,"_2462":99490},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_2936":59679,"_25651":59650,"_17922":99492,"_5":17817,"_24317":99428,"_2462":99493},[],"Si el login termina pero las APIs devuelven 403:",{"_2936":59680,"_25651":59650,"_17922":99495,"_5":17817,"_24317":99428,"_2462":99496},[],"inspecciona los claims reales del token;",{"_2936":59681,"_25651":59650,"_17922":99498,"_5":17817,"_24317":99428,"_2462":99499},[],"confirma que coinciden con un principal activo;",{"_2936":59682,"_25651":59650,"_17922":99501,"_5":17817,"_24317":99428,"_2462":99502},[],"revisa las políticas concedidas al principal;",{"_2936":59683,"_25651":59650,"_17922":99504,"_5":17817,"_24317":99428,"_2462":99505},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_2936":59684,"_25651":59650,"_17922":99507,"_5":17817,"_24317":99428,"_2462":99508},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_2936":59685,"_25651":59650,"_17922":99510,"_5":17817,"_24317":99432,"_2462":99511},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_2936":59686,"_25651":59650,"_17922":99513,"_5":17817,"_24317":99432,"_2462":99514},[],"Localiza el pod y Service de authz.",{"_2936":59687,"_25651":59650,"_17922":99516,"_5":17817,"_24317":99432,"_2462":99517},[],"Comprueba /health, logs y conexión a su base de datos.",{"_2936":59688,"_25651":59650,"_17922":99519,"_5":17817,"_24317":99432,"_2462":99520},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_2936":59689,"_25651":59650,"_17922":99522,"_5":17817,"_24317":99432,"_2462":99523},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_2936":59690,"_25651":59650,"_17922":99525,"_5":17817,"_24317":99432,"_2462":99526},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_2936":59691,"_25651":59650,"_17922":99528,"_5":17817,"_24317":99436,"_2462":99529},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_2936":59692,"_25651":59650,"_17922":99531,"_5":17817,"_24317":99436,"_2462":99532},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_2936":59693,"_25651":59650,"_17922":99534,"_5":17817,"_24317":99436,"_2462":99535},[],"volumen persistente sin enlazar;",{"_2936":59694,"_25651":59650,"_17922":99537,"_5":17817,"_24317":99436,"_2462":99538},[],"imagen inaccesible o política de pull incorrecta;",{"_2936":59695,"_25651":59650,"_17922":99540,"_5":17817,"_24317":99436,"_2462":99541},[],"configuración inválida del motor criptográfico;",{"_2936":59696,"_25651":59650,"_17922":99543,"_5":17817,"_24317":99436,"_2462":99544},[],"límites de CPU o memoria demasiado bajos;",{"_2936":59697,"_25651":59650,"_17922":99546,"_5":17817,"_24317":99436,"_2462":99547},[],"migración previa incompleta.",{"_2936":59698,"_25651":59650,"_17922":99549,"_5":17817,"_24317":99436,"_2462":99550},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_2936":59699,"_25651":59650,"_17922":99552,"_5":17817,"_24317":99436,"_2462":99553},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_2936":59700,"_25651":59650,"_17922":99555,"_5":17817,"_24317":99440,"_2462":99556},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_2936":59701,"_25651":59650,"_17922":99558,"_5":17817,"_24317":99440,"_2462":99559},[],"verifica que esté habilitado en el servicio emisor;",{"_2936":59702,"_25651":59650,"_17922":99561,"_5":17817,"_24317":99440,"_2462":99562},[],"comprueba conectividad y credenciales AMQP;",{"_2936":59703,"_25651":59650,"_17922":99564,"_5":17817,"_24317":99440,"_2462":99565},[],"revisa exchange, routing key, colas y consumidores;",{"_2936":59704,"_25651":59650,"_17922":99567,"_5":17817,"_24317":99440,"_2462":99568},[],"inspecciona dead-letter queues;",{"_2936":59705,"_25651":59650,"_17922":99570,"_5":17817,"_24317":99440,"_2462":99571},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_2936":59706,"_25651":59650,"_17922":99573,"_5":17817,"_24317":99440,"_2462":99574},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_2936":59707,"_25651":59650,"_17922":99576,"_5":17817,"_24317":99444,"_2462":99577},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_2936":59708,"_25651":59650,"_17922":99579,"_5":17817,"_24317":99444,"_2462":99580},[],"Antes de cerrar una incidencia, guarda:",{"_2936":59709,"_25651":59650,"_17922":99582,"_5":17817,"_24317":99444,"_2462":99583},[],"causa confirmada;",{"_2936":59710,"_25651":59650,"_17922":99585,"_5":17817,"_24317":99444,"_2462":99586},[],"alcance temporal y recursos afectados;",{"_2936":59711,"_25651":59650,"_17922":99588,"_5":17817,"_24317":99444,"_2462":99589},[],"comandos o consultas utilizados;",{"_2936":59712,"_25651":59650,"_17922":99591,"_5":17817,"_24317":99444,"_2462":99592},[],"cambio aplicado y forma de revertirlo;",{"_2936":59713,"_25651":59650,"_17922":99594,"_5":17817,"_24317":99444,"_2462":99595},[],"validación desde un consumidor;",{"_2936":59714,"_25651":59650,"_17922":99597,"_5":17817,"_24317":99444,"_2462":99598},[],"acción preventiva y propietario.",{"_2936":59715,"_25651":59715,"_5":12587,"_2462":99600,"_25975":99601,"_17922":99604,"_24317":59715},"Control de acceso",[41800,99602,99603],"Plataforma","Administración",[],{"_2936":59716,"_25651":59715,"_17922":99606,"_5":17817,"_24317":59715,"_2462":99607},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_2936":59717,"_25651":59715,"_5":25972,"_17922":99609,"_24317":99610,"_2462":99611},[],"/docs/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_2936":59718,"_25651":59715,"_5":25972,"_17922":99613,"_24317":99614,"_2462":99615},[],"/docs/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_2936":59719,"_25651":59715,"_5":25972,"_17922":99617,"_24317":99618,"_2462":99619},[],"/docs/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_2936":59720,"_25651":59715,"_5":25972,"_17922":99621,"_24317":99622,"_2462":99623},[],"/docs/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_2936":59721,"_25651":59715,"_5":25972,"_17922":99625,"_24317":99626,"_2462":99627},[],"/docs/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_2936":59722,"_25651":59715,"_5":25972,"_17922":99629,"_24317":99630,"_2462":99631},[],"/docs/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_2936":59723,"_25651":59715,"_5":25972,"_17922":99633,"_24317":99634,"_2462":99635},[],"/docs/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_2936":59724,"_25651":59715,"_5":25972,"_17922":99637,"_24317":99638,"_2462":99639},[],"/docs/es/platform/administration/access-control#principales-x509","Principales X.509",{"_2936":59725,"_25651":59715,"_5":25972,"_17922":99641,"_24317":99642,"_2462":99643},[],"/docs/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_2936":59726,"_25651":59715,"_5":25972,"_17922":99645,"_24317":99646,"_2462":99647},[],"/docs/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_2936":59727,"_25651":59715,"_5":25972,"_17922":99649,"_24317":99650,"_2462":99651},[],"/docs/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_2936":59728,"_25651":59715,"_5":25972,"_17922":99653,"_24317":99654,"_2462":99655},[],"/docs/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_2936":59729,"_25651":59715,"_5":25972,"_17922":99657,"_24317":99658,"_2462":99659},[],"/docs/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_2936":59730,"_25651":59715,"_5":25972,"_17922":99661,"_24317":99662,"_2462":99663},[],"/docs/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_2936":59731,"_25651":59715,"_5":25972,"_17922":99665,"_24317":99666,"_2462":99667},[],"/docs/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_2936":59732,"_25651":59715,"_5":25972,"_17922":99669,"_24317":99670,"_2462":98864},[],"/docs/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_2936":59733,"_25651":59715,"_5":25972,"_17922":99672,"_24317":99673,"_2462":99674},[],"/docs/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_2936":59734,"_25651":59715,"_5":25972,"_17922":99676,"_24317":99677,"_2462":99678},[],"/docs/es/platform/administration/access-control#configura-las-dos-validaciones-jwt","Configura las dos validaciones JWT",{"_2936":59735,"_25651":59715,"_5":25972,"_17922":99680,"_24317":99681,"_2462":99682},[],"/docs/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_2936":59736,"_25651":59715,"_5":25972,"_17922":99684,"_24317":99685,"_2462":99686},[],"/docs/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_2936":59737,"_25651":59715,"_5":25972,"_17922":99688,"_24317":99689,"_2462":99690},[],"/docs/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_2936":59738,"_25651":59715,"_5":25972,"_17922":99692,"_24317":99693,"_2462":99694},[],"/docs/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_2936":59739,"_25651":59715,"_5":25972,"_17922":99696,"_24317":99697,"_2462":99698},[],"/docs/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_2936":59740,"_25651":59715,"_5":25972,"_17922":99700,"_24317":99701,"_2462":99702},[],"/docs/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_2936":59741,"_25651":59715,"_5":25972,"_17922":99704,"_24317":99705,"_2462":99706},[],"/docs/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_2936":59742,"_25651":59715,"_5":25972,"_17922":99708,"_24317":99709,"_2462":99710},[],"/docs/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_2936":59743,"_25651":59715,"_5":25972,"_17922":99712,"_24317":99713,"_2462":99714},[],"/docs/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_2936":59744,"_25651":59715,"_5":25972,"_17922":99716,"_24317":99717,"_2462":99718},[],"/docs/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_2936":59745,"_25651":59715,"_5":25972,"_17922":99720,"_24317":99721,"_2462":99722},[],"/docs/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_2936":59746,"_25651":59715,"_5":25972,"_17922":99724,"_24317":99725,"_2462":99726},[],"/docs/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_2936":59747,"_25651":59715,"_5":25972,"_17922":99728,"_24317":99729,"_2462":99730},[],"/docs/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_2936":59748,"_25651":59715,"_17922":99732,"_5":17817,"_24317":59715,"_2462":99733},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_2936":59749,"_25651":59715,"_17922":99735,"_5":17817,"_24317":59715,"_2462":99736},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_2936":59750,"_25651":59715,"_17922":99738,"_5":17817,"_24317":59715,"_2462":99739},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_2936":59751,"_25651":59715,"_17922":99741,"_5":17817,"_24317":99610,"_2462":99742},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_2936":59752,"_25651":59715,"_17922":99744,"_5":17817,"_24317":99610,"_2462":99745},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_2936":59753,"_25651":59715,"_17922":99747,"_5":17817,"_24317":99610,"_2462":99748},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_2936":59754,"_25651":59715,"_17922":99750,"_5":17817,"_24317":99610,"_2462":99751},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_2936":59755,"_25651":59715,"_17922":99753,"_5":17817,"_24317":99610,"_2462":99754},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_2936":59756,"_25651":59715,"_17922":99756,"_5":17817,"_24317":99610,"_2462":99757},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_2936":59757,"_25651":59715,"_17922":99759,"_5":17817,"_24317":99614,"_2462":99760},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_2936":59758,"_25651":59715,"_17922":99762,"_5":17817,"_24317":99614,"_2462":99763},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_2936":59759,"_25651":59715,"_17922":99765,"_5":17817,"_24317":99618,"_2462":99766},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_2936":59760,"_25651":59715,"_17922":99768,"_5":17817,"_24317":99618,"_2462":99769},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_2936":59761,"_25651":59715,"_17922":99771,"_5":17817,"_24317":99618,"_2462":99772},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_2936":59762,"_25651":59715,"_17922":99774,"_5":17817,"_24317":99618,"_2462":99775},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_2936":59763,"_25651":59715,"_17922":99777,"_5":17817,"_24317":99618,"_2462":99778},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_2936":59764,"_25651":59715,"_17922":99780,"_5":17817,"_24317":99618,"_2462":99781},[],"Carga por separado las políticas concedidas a cada principal.",{"_2936":59765,"_25651":59715,"_17922":99783,"_5":17817,"_24317":99618,"_2462":99784},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_2936":59766,"_25651":59715,"_17922":99786,"_5":17817,"_24317":99618,"_2462":99787},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_2936":59767,"_25651":59715,"_17922":99789,"_5":17817,"_24317":99618,"_2462":99790},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_2936":59768,"_25651":59715,"_17922":99792,"_5":17817,"_24317":99618,"_2462":99793},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_2936":59769,"_25651":59715,"_17922":99795,"_5":17817,"_24317":99618,"_2462":99796},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_2936":59770,"_25651":59715,"_17922":99798,"_5":17817,"_24317":99618,"_2462":99799},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_2936":59771,"_25651":59715,"_17922":99801,"_5":17817,"_24317":99622,"_2462":99802},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_2936":59772,"_25651":59715,"_17922":99804,"_5":17817,"_24317":99622,"_2462":99805},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_2936":59773,"_25651":59715,"_17922":99807,"_5":17817,"_24317":99622,"_2462":99808},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_2936":59774,"_25651":59715,"_17922":99810,"_5":17817,"_24317":99622,"_2462":99811},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_2936":59775,"_25651":59715,"_17922":99813,"_5":17817,"_24317":99622,"_2462":99814},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_2936":59776,"_25651":59715,"_17922":99816,"_5":17817,"_24317":99622,"_2462":99817},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_2936":59777,"_25651":59715,"_17922":99819,"_5":17817,"_24317":99622,"_2462":99820},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_2936":59778,"_25651":59715,"_17922":99822,"_5":17817,"_24317":99622,"_2462":99823},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_2936":59779,"_25651":59715,"_17922":99825,"_5":17817,"_24317":99626,"_2462":99826},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_2936":59780,"_25651":59715,"_17922":99828,"_5":17817,"_24317":99626,"_2462":99829},[],"La decisión se toma con el contexto de la operación de dominio:",{"_2936":59781,"_25651":59715,"_17922":99831,"_5":17817,"_24317":99626,"_2462":99832},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_2936":59782,"_25651":59715,"_17922":99834,"_5":17817,"_24317":99626,"_2462":99835},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_2936":59783,"_25651":59715,"_17922":99837,"_5":17817,"_24317":99626,"_2462":99838},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_2936":59784,"_25651":59715,"_17922":99840,"_5":17817,"_24317":99626,"_2462":99841},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_2936":59785,"_25651":59715,"_17922":99843,"_5":17817,"_24317":99626,"_2462":99844},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_2936":59786,"_25651":59715,"_17922":99846,"_5":17817,"_24317":99626,"_2462":99847},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_2936":59787,"_25651":59715,"_17922":99849,"_5":17817,"_24317":99626,"_2462":99850},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_2936":59788,"_25651":59715,"_17922":99852,"_5":17817,"_24317":99626,"_2462":99853},[],"Las acciones se dividen en dos grupos:",{"_2936":59789,"_25651":59715,"_17922":99855,"_5":17817,"_24317":99626,"_2462":99856},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_2936":59790,"_25651":59715,"_17922":99858,"_5":17817,"_24317":99626,"_2462":99859},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_2936":59791,"_25651":59715,"_17922":99861,"_5":17817,"_24317":99626,"_2462":99862},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_2936":59792,"_25651":59715,"_17922":99864,"_5":17817,"_24317":99630,"_2462":99865},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_2936":59793,"_25651":59715,"_17922":99867,"_5":17817,"_24317":99630,"_2462":99868},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_2936":59794,"_25651":59715,"_17922":99870,"_5":17817,"_24317":99630,"_2462":99871},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_2936":59795,"_25651":59715,"_17922":99873,"_5":17817,"_24317":99634,"_2462":99874},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_2936":59796,"_25651":59715,"_17922":99876,"_5":17817,"_24317":99634,"_2462":99877},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_2936":59797,"_25651":59715,"_17922":99879,"_5":17817,"_24317":99634,"_2462":99880},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_2936":59798,"_25651":59715,"_17922":99882,"_5":17817,"_24317":99634,"_2462":99883},[],"Los operadores implementados son:",{"_2936":59799,"_25651":59715,"_17922":99885,"_5":17817,"_24317":99634,"_2462":99886},[],"`equals`, para igualdad exacta;",{"_2936":59800,"_25651":59715,"_17922":99888,"_5":17817,"_24317":99634,"_2462":99889},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_2936":59801,"_25651":59715,"_17922":99891,"_5":17817,"_24317":99634,"_2462":99892},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_2936":59802,"_25651":59715,"_17922":99894,"_5":17817,"_24317":99634,"_2462":99895},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_2936":59803,"_25651":59715,"_17922":99897,"_5":17817,"_24317":99638,"_2462":99898},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_2936":59804,"_25651":59715,"_17922":99900,"_5":17817,"_24317":99638,"_2462":99901},[],"Los modos disponibles son:",{"_2936":59805,"_25651":59715,"_17922":99903,"_5":17817,"_24317":99638,"_2462":99904},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_2936":59806,"_25651":59715,"_17922":99906,"_5":17817,"_24317":99638,"_2462":99907},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_2936":59807,"_25651":59715,"_17922":99909,"_5":17817,"_24317":99638,"_2462":99910},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_2936":59808,"_25651":59715,"_17922":99912,"_5":17817,"_24317":99638,"_2462":99913},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_2936":59809,"_25651":59715,"_17922":99915,"_5":17817,"_24317":99638,"_2462":99916},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_2936":59810,"_25651":59715,"_17922":99918,"_5":17817,"_24317":99638,"_2462":99919},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_2936":59811,"_25651":59715,"_17922":99921,"_5":17817,"_24317":99642,"_2462":99922},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_2936":59812,"_25651":59715,"_17922":99924,"_5":17817,"_24317":99642,"_2462":99925},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_2936":59813,"_25651":59715,"_17922":99927,"_5":17817,"_24317":99642,"_2462":99928},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_2936":59814,"_25651":59715,"_17922":99930,"_5":17817,"_24317":99642,"_2462":99931},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_2936":59815,"_25651":59715,"_17922":99933,"_5":17817,"_24317":99650,"_2462":99934},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_2936":59816,"_25651":59715,"_17922":99936,"_5":17817,"_24317":99650,"_2462":99937},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_2936":59817,"_25651":59715,"_17922":99939,"_5":17817,"_24317":99654,"_2462":99940},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_2936":59818,"_25651":59715,"_17922":99942,"_5":17817,"_24317":99654,"_2462":99943},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_2936":59819,"_25651":59715,"_17922":99945,"_5":17817,"_24317":99658,"_2462":99946},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_2936":59820,"_25651":59715,"_17922":99948,"_5":17817,"_24317":99658,"_2462":99949},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_2936":59821,"_25651":59715,"_17922":99951,"_5":17817,"_24317":99658,"_2462":99952},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_2936":59822,"_25651":59715,"_17922":99954,"_5":17817,"_24317":99662,"_2462":99955},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_2936":59823,"_25651":59715,"_17922":99957,"_5":17817,"_24317":99662,"_2462":99958},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_2936":59824,"_25651":59715,"_17922":99960,"_5":17817,"_24317":99662,"_2462":99961},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_2936":59825,"_25651":59715,"_17922":99963,"_5":17817,"_24317":99662,"_2462":99964},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_2936":59826,"_25651":59715,"_17922":99966,"_5":17817,"_24317":99662,"_2462":99967},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_2936":59827,"_25651":59715,"_17922":99969,"_5":17817,"_24317":99662,"_2462":99970},[],"Ten en cuenta que:",{"_2936":59828,"_25651":59715,"_17922":99972,"_5":17817,"_24317":99662,"_2462":99973},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_2936":59829,"_25651":59715,"_17922":99975,"_5":17817,"_24317":99662,"_2462":99976},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_2936":59830,"_25651":59715,"_17922":99978,"_5":17817,"_24317":99662,"_2462":99979},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_2936":59831,"_25651":59715,"_17922":99981,"_5":17817,"_24317":99666,"_2462":99982},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_2936":59832,"_25651":59715,"_17922":99984,"_5":17817,"_24317":99666,"_2462":99985},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_2936":59833,"_25651":59715,"_17922":99987,"_5":17817,"_24317":99666,"_2462":99988},[],"acceso completo y de solo lectura a KMS;",{"_2936":59834,"_25651":59715,"_17922":99990,"_5":17817,"_24317":99666,"_2462":99991},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_2936":59835,"_25651":59715,"_17922":99993,"_5":17817,"_24317":99666,"_2462":99994},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_2936":59836,"_25651":59715,"_17922":99996,"_5":17817,"_24317":99666,"_2462":99997},[],"acceso a la interfaz;",{"_2936":59837,"_25651":59715,"_17922":99999,"_5":17817,"_24317":99666,"_2462":100000},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_2936":59838,"_25651":59715,"_17922":100002,"_5":17817,"_24317":99666,"_2462":100003},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_2936":59839,"_25651":59715,"_17922":100005,"_5":17817,"_24317":99666,"_2462":100006},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_2936":59840,"_25651":59715,"_17922":100008,"_5":17817,"_24317":99670,"_2462":100009},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_2936":59841,"_25651":59715,"_17922":100011,"_5":17817,"_24317":99670,"_2462":100012},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_2936":59842,"_25651":59715,"_17922":100014,"_5":17817,"_24317":99670,"_2462":100015},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_2936":59843,"_25651":59715,"_17922":100017,"_5":17817,"_24317":99673,"_2462":100018},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_2936":59844,"_25651":59715,"_17922":100020,"_5":17817,"_24317":99677,"_2462":100021},[],"El Gateway utiliza `auth.authentication.apiGateway.jwks` para autenticar peticiones. `authz` utiliza `services.authz.jwkUrl` para resolver los principales OIDC. Ambos endpoints deben contener las claves del mismo emisor y ser alcanzables desde sus respectivos componentes.",{"_2936":59845,"_25651":59715,"_17922":100023,"_5":17817,"_24317":99681,"_2462":100024},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_2936":59846,"_25651":59715,"_17922":100026,"_5":17817,"_24317":99685,"_2462":100027},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_2936":59847,"_25651":59715,"_17922":100029,"_5":17817,"_24317":99689,"_2462":100030},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_2936":59848,"_25651":59715,"_17922":100032,"_5":17817,"_24317":99693,"_2462":100033},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_2936":59849,"_25651":59715,"_17922":100035,"_5":17817,"_24317":99693,"_2462":100036},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_2936":59850,"_25651":59715,"_17922":100038,"_5":17817,"_24317":99697,"_2462":100039},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_2936":59851,"_25651":59715,"_17922":100041,"_5":17817,"_24317":99697,"_2462":100042},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_2936":59852,"_25651":59715,"_17922":100044,"_5":17817,"_24317":99697,"_2462":100045},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_2936":59853,"_25651":59715,"_17922":100047,"_5":17817,"_24317":99697,"_2462":100048},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_2936":59854,"_25651":59715,"_17922":100050,"_5":17817,"_24317":99697,"_2462":100051},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_2936":59855,"_25651":59715,"_17922":100053,"_5":17817,"_24317":99697,"_2462":100054},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_2936":59856,"_25651":59715,"_17922":100056,"_5":17817,"_24317":99697,"_2462":100057},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_2936":59857,"_25651":59715,"_17922":100059,"_5":17817,"_24317":99697,"_2462":100060},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_2936":59858,"_25651":59715,"_17922":100062,"_5":17817,"_24317":99701,"_2462":100063},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_2936":59859,"_25651":59715,"_17922":100065,"_5":17817,"_24317":99701,"_2462":100066},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_2936":59860,"_25651":59715,"_17922":100068,"_5":17817,"_24317":99701,"_2462":100069},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_2936":59861,"_25651":59715,"_17922":100071,"_5":17817,"_24317":99705,"_2462":100072},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_2936":59862,"_25651":59715,"_17922":100074,"_5":17817,"_24317":99705,"_2462":100075},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_2936":59863,"_25651":59715,"_17922":100077,"_5":17817,"_24317":99705,"_2462":100078},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_2936":59864,"_25651":59715,"_17922":100080,"_5":17817,"_24317":99705,"_2462":100081},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_2936":59865,"_25651":59715,"_17922":100083,"_5":17817,"_24317":99705,"_2462":100084},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_2936":59866,"_25651":59715,"_17922":100086,"_5":17817,"_24317":99705,"_2462":100087},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_2936":59867,"_25651":59715,"_17922":100089,"_5":17817,"_24317":99705,"_2462":100090},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_2936":59868,"_25651":59715,"_17922":100092,"_5":17817,"_24317":99705,"_2462":100093},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_2936":59869,"_25651":59715,"_17922":100095,"_5":17817,"_24317":99713,"_2462":100096},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_2936":59870,"_25651":59715,"_17922":100098,"_5":17817,"_24317":99717,"_2462":100099},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_2936":59871,"_25651":59715,"_17922":100101,"_5":17817,"_24317":99717,"_2462":100102},[],"que exista un principal activo del tipo correcto;",{"_2936":59872,"_25651":59715,"_17922":100104,"_5":17817,"_24317":99717,"_2462":100105},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_2936":59873,"_25651":59715,"_17922":100107,"_5":17817,"_24317":99717,"_2462":100108},[],"que todas las condiciones del principal se cumplan;",{"_2936":59874,"_25651":59715,"_17922":100110,"_5":17817,"_24317":99717,"_2462":100111},[],"que el principal tenga concedida la política esperada;",{"_2936":59875,"_25651":59715,"_17922":100113,"_5":17817,"_24317":99717,"_2462":100114},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_2936":59876,"_25651":59715,"_17922":100116,"_5":17817,"_24317":99717,"_2462":100117},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_2936":59877,"_25651":59715,"_17922":100119,"_5":17817,"_24317":99717,"_2462":100120},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway.",{"_2936":59878,"_25651":59715,"_17922":100122,"_5":17817,"_24317":99721,"_2462":100123},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_2936":59879,"_25651":59715,"_17922":100125,"_5":17817,"_24317":99725,"_2462":100126},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_2936":59880,"_25651":59715,"_17922":100128,"_5":17817,"_24317":99729,"_2462":100129},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_2936":59881,"_25651":59715,"_17922":100131,"_5":17817,"_24317":99729,"_2462":100132},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_2936":59882,"_25651":59882,"_5":12587,"_2462":100134,"_25975":100135,"_17922":100136,"_24317":59882},"Alertas y suscripciones",[41800,99602,99603],[],{"_2936":59883,"_25651":59882,"_17922":100138,"_5":17817,"_24317":59882,"_2462":100139},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_2936":59884,"_25651":59882,"_5":25972,"_17922":100141,"_24317":100142,"_2462":100143},[],"/docs/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_2936":59885,"_25651":59882,"_5":25972,"_17922":100145,"_24317":100146,"_2462":100147},[],"/docs/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_2936":59886,"_25651":59882,"_5":25972,"_17922":100149,"_24317":100150,"_2462":100151},[],"/docs/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_2936":59887,"_25651":59882,"_5":25972,"_17922":100153,"_24317":100154,"_2462":100155},[],"/docs/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_2936":59888,"_25651":59882,"_5":25972,"_17922":100157,"_24317":100158,"_2462":100159},[],"/docs/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_2936":59889,"_25651":59882,"_5":25972,"_17922":100161,"_24317":100162,"_2462":100163},[],"/docs/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_2936":59890,"_25651":59882,"_5":25972,"_17922":100165,"_24317":100166,"_2462":100167},[],"/docs/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_2936":59891,"_25651":59882,"_5":25972,"_17922":100169,"_24317":100170,"_2462":100171},[],"/docs/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_2936":59892,"_25651":59882,"_5":25972,"_17922":100173,"_24317":100174,"_2462":100175},[],"/docs/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_2936":59893,"_25651":59882,"_5":25972,"_17922":100177,"_24317":100178,"_2462":100179},[],"/docs/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_2936":59894,"_25651":59882,"_17922":100181,"_5":17817,"_24317":59882,"_2462":100182},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_2936":59895,"_25651":59882,"_17922":100184,"_5":17817,"_24317":100142,"_2462":100185},[],"Un servicio publica un evento de dominio.",{"_2936":59896,"_25651":59882,"_17922":100187,"_5":17817,"_24317":100142,"_2462":100188},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_2936":59897,"_25651":59882,"_17922":100190,"_5":17817,"_24317":100142,"_2462":100191},[],"El filtro de cada suscripción decide si debe notificarse.",{"_2936":59898,"_25651":59882,"_17922":100193,"_5":17817,"_24317":100142,"_2462":100194},[],"Lamassu entrega el evento al canal configurado.",{"_2936":59899,"_25651":59882,"_17922":100196,"_5":17817,"_24317":100142,"_2462":100197},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_2936":59900,"_25651":59882,"_17922":100199,"_5":17817,"_24317":100146,"_2462":100200},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_2936":59901,"_25651":59882,"_17922":100202,"_5":17817,"_24317":100146,"_2462":100203},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_2936":59902,"_25651":59882,"_17922":100205,"_5":17817,"_24317":100146,"_2462":100206},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_2936":59903,"_25651":59882,"_17922":100208,"_5":17817,"_24317":100146,"_2462":100209},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_2936":59904,"_25651":59882,"_17922":100211,"_5":17817,"_24317":100146,"_2462":100212},[],"`apikey_options` necesita `header` y `key`.",{"_2936":59905,"_25651":59882,"_17922":100214,"_5":17817,"_24317":100146,"_2462":100215},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_2936":59906,"_25651":59882,"_17922":100217,"_5":17817,"_24317":100146,"_2462":100218},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_2936":59907,"_25651":59882,"_17922":100220,"_5":17817,"_24317":100146,"_2462":100221},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_2936":59908,"_25651":59882,"_17922":100223,"_5":17817,"_24317":100154,"_2462":100224},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_2936":59909,"_25651":59882,"_17922":100226,"_5":17817,"_24317":100158,"_2462":100227},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_2936":59910,"_25651":59882,"_17922":100229,"_5":17817,"_24317":100162,"_2462":100230},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_2936":59911,"_25651":59882,"_17922":100232,"_5":17817,"_24317":100162,"_2462":100233},[],"**None** notifica todas las instancias del evento.",{"_2936":59912,"_25651":59882,"_17922":100235,"_5":17817,"_24317":100162,"_2462":100236},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_2936":59913,"_25651":59882,"_17922":100238,"_5":17817,"_24317":100162,"_2462":100239},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_2936":59914,"_25651":59882,"_17922":100241,"_5":17817,"_24317":100162,"_2462":100242},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_2936":59915,"_25651":59882,"_17922":100244,"_5":17817,"_24317":100162,"_2462":100245},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_2936":59916,"_25651":59882,"_17922":100247,"_5":17817,"_24317":100166,"_2462":100248},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_2936":59917,"_25651":59882,"_17922":100250,"_5":17817,"_24317":100170,"_2462":100251},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_2936":59918,"_25651":59882,"_17922":100253,"_5":17817,"_24317":100170,"_2462":100254},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_2936":59919,"_25651":59882,"_17922":100256,"_5":17817,"_24317":100170,"_2462":100257},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_2936":59920,"_25651":59882,"_17922":100259,"_5":17817,"_24317":100170,"_2462":100260},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_2936":59921,"_25651":59882,"_17922":100262,"_5":17817,"_24317":100170,"_2462":100263},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_2936":59922,"_25651":59882,"_17922":100265,"_5":17817,"_24317":100170,"_2462":100266},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_2936":59923,"_25651":59882,"_17922":100268,"_5":17817,"_24317":100170,"_2462":100269},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_2936":59924,"_25651":59882,"_17922":100271,"_5":17817,"_24317":100170,"_2462":100272},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_2936":59925,"_25651":59882,"_17922":100274,"_5":17817,"_24317":100174,"_2462":100275},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_2936":59926,"_25651":59882,"_17922":100277,"_5":17817,"_24317":100178,"_2462":100278},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_2936":59927,"_25651":59882,"_17922":100280,"_5":17817,"_24317":100178,"_2462":100281},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_2936":59928,"_25651":59882,"_17922":100283,"_5":17817,"_24317":100178,"_2462":100284},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_2936":59929,"_25651":59882,"_17922":100286,"_5":17817,"_24317":100178,"_2462":100287},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_2936":59930,"_25651":59882,"_17922":100289,"_5":17817,"_24317":100178,"_2462":100290},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_2936":59931,"_25651":59882,"_17922":100292,"_5":17817,"_24317":100178,"_2462":100293},[],"**Validación:** `va.role.crl.create`.",{"_2936":59932,"_25651":59882,"_17922":100295,"_5":17817,"_24317":100178,"_2462":100296},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_2936":59933,"_25651":59882,"_17922":100298,"_5":17817,"_24317":100178,"_2462":100299},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_2936":59934,"_25651":59934,"_5":12587,"_2462":100301,"_25975":100302,"_17922":100303,"_24317":59934},"Registros de auditoría",[41800,99602,99603],[],{"_2936":59935,"_25651":59934,"_17922":100305,"_5":17817,"_24317":59934,"_2462":100306},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_2936":59936,"_25651":59934,"_5":25972,"_17922":100308,"_24317":100309,"_2462":100310},[],"/docs/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_2936":59937,"_25651":59934,"_5":25972,"_17922":100312,"_24317":100313,"_2462":100314},[],"/docs/es/platform/administration/audit-logs#cobertura","Cobertura",{"_2936":59938,"_25651":59934,"_5":25972,"_17922":100316,"_24317":100317,"_2462":100318},[],"/docs/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_2936":59939,"_25651":59934,"_5":25972,"_17922":100320,"_24317":100321,"_2462":100322},[],"/docs/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_2936":59940,"_25651":59934,"_5":25972,"_17922":100324,"_24317":100325,"_2462":100326},[],"/docs/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_2936":59941,"_25651":59934,"_5":25972,"_17922":100328,"_24317":100329,"_2462":100330},[],"/docs/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_2936":59942,"_25651":59934,"_5":25972,"_17922":100332,"_24317":100333,"_2462":100334},[],"/docs/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_2936":59943,"_25651":59934,"_5":25972,"_17922":100336,"_24317":100337,"_2462":100338},[],"/docs/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_2936":59944,"_25651":59934,"_5":25972,"_17922":100340,"_24317":100341,"_2462":100342},[],"/docs/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_2936":59945,"_25651":59934,"_5":25972,"_17922":100344,"_24317":100345,"_2462":100346},[],"/docs/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_2936":59946,"_25651":59934,"_5":25972,"_17922":100348,"_24317":100349,"_2462":100350},[],"/docs/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_2936":59947,"_25651":59934,"_17922":100352,"_5":17817,"_24317":59934,"_2462":100353},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_2936":59948,"_25651":59934,"_17922":100355,"_5":17817,"_24317":100309,"_2462":100356},[],"El cuerpo de auditoría incluye:",{"_2936":59949,"_25651":59934,"_17922":100358,"_5":17817,"_24317":100309,"_2462":100359},[],"input: datos recibidos por la operación;",{"_2936":59950,"_25651":59934,"_17922":100361,"_5":17817,"_24317":100309,"_2462":100362},[],"has\\_error: indica si el servicio devolvió un error;",{"_2936":59951,"_25651":59934,"_17922":100364,"_5":17817,"_24317":100309,"_2462":100365},[],"output: resultado producido o mensaje de error;",{"_2936":59952,"_25651":59934,"_17922":100367,"_5":17817,"_24317":100309,"_2462":100368},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_2936":59953,"_25651":59934,"_17922":100370,"_5":17817,"_24317":100309,"_2462":100371},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_2936":59954,"_25651":59934,"_17922":100373,"_5":17817,"_24317":100309,"_2462":100374},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_2936":59955,"_25651":59934,"_17922":100376,"_5":17817,"_24317":100313,"_2462":100377},[],"El backend aplica auditoría a mutaciones de:",{"_2936":59956,"_25651":59934,"_17922":100379,"_5":17817,"_24317":100313,"_2462":100380},[],"autoridades, certificados y perfiles de emisión;",{"_2936":59957,"_25651":59934,"_17922":100382,"_5":17817,"_24317":100313,"_2462":100383},[],"claves y motores KMS;",{"_2936":59958,"_25651":59934,"_17922":100385,"_5":17817,"_24317":100313,"_2462":100386},[],"dispositivos e identidades;",{"_2936":59959,"_25651":59934,"_17922":100388,"_5":17817,"_24317":100313,"_2462":100389},[],"DMS y operaciones de enrolamiento;",{"_2936":59960,"_25651":59934,"_17922":100391,"_5":17817,"_24317":100313,"_2462":100392},[],"funciones de validación y CRL;",{"_2936":59961,"_25651":59934,"_17922":100394,"_5":17817,"_24317":100313,"_2462":100395},[],"principales, políticas y concesiones de autorización.",{"_2936":59962,"_25651":59934,"_17922":100397,"_5":17817,"_24317":100313,"_2462":100398},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_2936":59963,"_25651":59934,"_17922":100400,"_5":17817,"_24317":100317,"_2462":100401},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_2936":59964,"_25651":59934,"_17922":100403,"_5":17817,"_24317":100317,"_2462":100404},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_2936":59965,"_25651":59934,"_17922":100406,"_5":17817,"_24317":100317,"_2462":100407},[],"Diseña el consumidor para:",{"_2936":59966,"_25651":59934,"_17922":100409,"_5":17817,"_24317":100317,"_2462":100410},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_2936":59967,"_25651":59934,"_17922":100412,"_5":17817,"_24317":100317,"_2462":100413},[],"conservar el CloudEvent completo sin modificar;",{"_2936":59968,"_25651":59934,"_17922":100415,"_5":17817,"_24317":100317,"_2462":100416},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_2936":59969,"_25651":59934,"_17922":100418,"_5":17817,"_24317":100317,"_2462":100419},[],"cifrar en tránsito y en reposo;",{"_2936":59970,"_25651":59934,"_17922":100421,"_5":17817,"_24317":100317,"_2462":100422},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_2936":59971,"_25651":59934,"_17922":100424,"_5":17817,"_24317":100317,"_2462":100425},[],"aplicar una política explícita de retención y legal hold;",{"_2936":59972,"_25651":59934,"_17922":100427,"_5":17817,"_24317":100317,"_2462":100428},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_2936":59973,"_25651":59934,"_17922":100430,"_5":17817,"_24317":100321,"_2462":100431},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_2936":59974,"_25651":59934,"_17922":100433,"_5":17817,"_24317":100321,"_2462":100434},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_2936":59975,"_25651":59934,"_17922":100436,"_5":17817,"_24317":100329,"_2462":100437},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_2936":59976,"_25651":59934,"_17922":100439,"_5":17817,"_24317":100333,"_2462":100440},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_2936":59977,"_25651":59934,"_17922":100442,"_5":17817,"_24317":100337,"_2462":100443},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_2936":59978,"_25651":59934,"_17922":100445,"_5":17817,"_24317":100341,"_2462":100446},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_2936":59979,"_25651":59934,"_17922":100448,"_5":17817,"_24317":100345,"_2462":100449},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_2936":59980,"_25651":59934,"_17922":100451,"_5":17817,"_24317":100349,"_2462":100452},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_2936":59981,"_25651":59934,"_17922":100454,"_5":17817,"_24317":100349,"_2462":100455},[],"aparece un evento de auditoría correcto;",{"_2936":59982,"_25651":59934,"_17922":100457,"_5":17817,"_24317":100349,"_2462":100458},[],"el principal coincide con la identidad utilizada;",{"_2936":59983,"_25651":59934,"_17922":100460,"_5":17817,"_24317":100349,"_2462":100461},[],"el consumidor lo persiste una sola vez;",{"_2936":59984,"_25651":59934,"_17922":100463,"_5":17817,"_24317":100349,"_2462":100464},[],"puede recuperarse por recurso, actor y periodo;",{"_2936":59985,"_25651":59934,"_17922":100466,"_5":17817,"_24317":100349,"_2462":100467},[],"una interrupción del consumidor produce una alerta.",{"_2936":59986,"_25651":59934,"_17922":100469,"_5":17817,"_24317":100349,"_2462":100470},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_2936":59987,"_25651":59987,"_5":12587,"_2462":100472,"_25975":100473,"_17922":100474,"_24317":59987},"Arquitectura de la plataforma",[41800,99602],[],{"_2936":59988,"_25651":59987,"_17922":100476,"_5":17817,"_24317":59987,"_2462":100477},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_2936":59989,"_25651":59987,"_5":25972,"_17922":100479,"_24317":100480,"_2462":100481},[],"/docs/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_2936":59990,"_25651":59987,"_5":25972,"_17922":100483,"_24317":100484,"_2462":100485},[],"/docs/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_2936":59991,"_25651":59987,"_5":25972,"_17922":100487,"_24317":100488,"_2462":100489},[],"/docs/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_2936":59992,"_25651":59987,"_5":25972,"_17922":100491,"_24317":100492,"_2462":100493},[],"/docs/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_2936":59993,"_25651":59987,"_5":25972,"_17922":100495,"_24317":100496,"_2462":100497},[],"/docs/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_2936":59994,"_25651":59987,"_17922":100499,"_5":17817,"_24317":59987,"_2462":100500},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_2936":59995,"_25651":59987,"_17922":100502,"_5":17817,"_24317":59987,"_2462":100503},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_2936":59996,"_25651":59987,"_17922":100505,"_5":17817,"_24317":100480,"_2462":100506},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_2936":59997,"_25651":59987,"_17922":100508,"_5":17817,"_24317":100484,"_2462":100509},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_2936":59998,"_25651":59987,"_17922":100511,"_5":17817,"_24317":100488,"_2462":100512},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_2936":59999,"_25651":59987,"_17922":100514,"_5":17817,"_24317":100492,"_2462":100515},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_2936":60000,"_25651":59987,"_17922":100517,"_5":17817,"_24317":100496,"_2462":100518},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_2936":60001,"_25651":60001,"_5":12587,"_2462":100520,"_25975":100521,"_17922":100522,"_24317":60001},"Cómo funciona Lamassu",[41800,99602],[],{"_2936":60002,"_25651":60001,"_17922":100524,"_5":17817,"_24317":60001,"_2462":100525},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_2936":60003,"_25651":60001,"_5":25972,"_17922":100527,"_24317":100528,"_2462":100529},[],"/docs/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_2936":60004,"_25651":60001,"_5":25972,"_17922":100531,"_24317":100532,"_2462":100533},[],"/docs/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_2936":60005,"_25651":60001,"_17922":100535,"_5":17817,"_24317":60001,"_2462":100536},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_2936":60006,"_25651":60001,"_17922":100538,"_5":17817,"_24317":100528,"_2462":100539},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_2936":60007,"_25651":60001,"_17922":100541,"_5":17817,"_24317":100528,"_2462":100542},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_2936":60008,"_25651":60001,"_17922":100544,"_5":17817,"_24317":100528,"_2462":100545},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_2936":60009,"_25651":60001,"_17922":100547,"_5":17817,"_24317":100528,"_2462":100548},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_2936":60010,"_25651":60001,"_17922":100550,"_5":17817,"_24317":100528,"_2462":100551},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_2936":60011,"_25651":60001,"_17922":100553,"_5":17817,"_24317":100532,"_2462":100554},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_2936":60012,"_25651":60001,"_17922":100556,"_5":17817,"_24317":100532,"_2462":100557},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_2936":60013,"_25651":60001,"_17922":100559,"_5":17817,"_24317":100532,"_2462":100560},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_2936":60014,"_25651":60001,"_17922":100562,"_5":17817,"_24317":100532,"_2462":100563},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_2936":60015,"_25651":60001,"_17922":100565,"_5":17817,"_24317":100532,"_2462":100566},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_2936":60016,"_25651":60001,"_17922":100568,"_5":17817,"_24317":100532,"_2462":100569},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_2936":60017,"_25651":60001,"_17922":100571,"_5":17817,"_24317":100532,"_2462":100572},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2936":60018,"_25651":60018,"_5":12587,"_2462":100574,"_25975":100575,"_17922":100576,"_24317":60018},"Dispositivos e identidades",[41800,99602,44148,100574],[],{"_2936":60019,"_25651":60018,"_17922":100578,"_5":17817,"_24317":60018,"_2462":100579},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_2936":60020,"_25651":60018,"_5":25972,"_17922":100581,"_24317":100582,"_2462":100583},[],"/docs/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_2936":60021,"_25651":60018,"_5":25972,"_17922":100585,"_24317":100586,"_2462":100587},[],"/docs/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_2936":60022,"_25651":60018,"_5":25972,"_17922":100589,"_24317":100590,"_2462":100591},[],"/docs/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_2936":60023,"_25651":60018,"_5":25972,"_17922":100593,"_24317":100594,"_2462":100595},[],"/docs/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_2936":60024,"_25651":60018,"_5":25972,"_17922":100597,"_24317":100598,"_2462":100599},[],"/docs/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_2936":60025,"_25651":60018,"_5":25972,"_17922":100601,"_24317":100602,"_2462":100603},[],"/docs/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_2936":60026,"_25651":60018,"_5":25972,"_17922":100605,"_24317":100606,"_2462":100607},[],"/docs/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_2936":60027,"_25651":60018,"_5":25972,"_17922":100609,"_24317":100610,"_2462":100611},[],"/docs/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_2936":60028,"_25651":60018,"_5":25972,"_17922":100613,"_24317":100614,"_2462":100615},[],"/docs/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_2936":60029,"_25651":60018,"_5":25972,"_17922":100617,"_24317":100618,"_2462":100619},[],"/docs/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_2936":60030,"_25651":60018,"_5":25972,"_17922":100621,"_24317":100622,"_2462":100623},[],"/docs/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_2936":60031,"_25651":60018,"_17922":100625,"_5":17817,"_24317":60018,"_2462":100626},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_2936":60032,"_25651":60018,"_17922":100628,"_5":17817,"_24317":60018,"_2462":100629},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_2936":60033,"_25651":60018,"_17922":100631,"_5":17817,"_24317":100582,"_2462":100632},[],"Vista operativa",{"_2936":60034,"_25651":60018,"_17922":100634,"_5":17817,"_24317":100582,"_2462":100635},[],"Interpretación",{"_2936":60035,"_25651":60018,"_17922":100637,"_5":17817,"_24317":100582,"_2462":44211},[],{"_2936":60036,"_25651":60018,"_17922":100639,"_5":17817,"_24317":100582,"_2462":100640},[],"Hay registro, pero todavía no hay identidad asociada.",{"_2936":60037,"_25651":60018,"_17922":100642,"_5":17817,"_24317":100582,"_2462":44217},[],{"_2936":60038,"_25651":60018,"_17922":100644,"_5":17817,"_24317":100582,"_2462":100645},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_2936":60039,"_25651":60018,"_17922":100647,"_5":17817,"_24317":100582,"_2462":44223},[],{"_2936":60040,"_25651":60018,"_17922":100649,"_5":17817,"_24317":100582,"_2462":100650},[],"La identidad está en la ventana operativa de renovación.",{"_2936":60041,"_25651":60018,"_17922":100652,"_5":17817,"_24317":100582,"_2462":44229},[],{"_2936":60042,"_25651":60018,"_17922":100654,"_5":17817,"_24317":100582,"_2462":100655},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_2936":60043,"_25651":60018,"_17922":100657,"_5":17817,"_24317":100582,"_2462":44235},[],{"_2936":60044,"_25651":60018,"_17922":100659,"_5":17817,"_24317":100582,"_2462":100660},[],"La identidad ha vencido.",{"_2936":60045,"_25651":60018,"_17922":100662,"_5":17817,"_24317":100582,"_2462":44241},[],{"_2936":60046,"_25651":60018,"_17922":100664,"_5":17817,"_24317":100582,"_2462":100665},[],"La identidad está marcada como revocada.",{"_2936":60047,"_25651":60018,"_17922":100667,"_5":17817,"_24317":100582,"_2462":44247},[],{"_2936":60048,"_25651":60018,"_17922":100669,"_5":17817,"_24317":100582,"_2462":100670},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_2936":60049,"_25651":60018,"_17922":100672,"_5":17817,"_24317":100582,"_2462":100673},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_2936":60050,"_25651":60018,"_17922":100675,"_5":17817,"_24317":100586,"_2462":100676},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_2936":60051,"_25651":60018,"_17922":100678,"_5":17817,"_24317":100586,"_2462":100679},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_2936":60052,"_25651":60018,"_17922":100681,"_5":17817,"_24317":100586,"_2462":100682},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_2936":60053,"_25651":60018,"_17922":100684,"_5":17817,"_24317":100586,"_2462":100685},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_2936":60054,"_25651":60018,"_17922":100687,"_5":17817,"_24317":100590,"_2462":100688},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_2936":60055,"_25651":60018,"_17922":100690,"_5":17817,"_24317":100594,"_2462":100691},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_2936":60056,"_25651":60018,"_17922":100693,"_5":17817,"_24317":100598,"_2462":100694},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_2936":60057,"_25651":60018,"_17922":100696,"_5":17817,"_24317":100602,"_2462":100697},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_2936":60058,"_25651":60018,"_17922":100699,"_5":17817,"_24317":100606,"_2462":100700},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_2936":60059,"_25651":60018,"_17922":100702,"_5":17817,"_24317":100606,"_2462":100703},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_2936":60060,"_25651":60018,"_17922":100705,"_5":17817,"_24317":100610,"_2462":100706},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_2936":60061,"_25651":60018,"_17922":100708,"_5":17817,"_24317":100610,"_2462":100709},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_2936":60062,"_25651":60018,"_17922":100711,"_5":17817,"_24317":100610,"_2462":100712},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_2936":60063,"_25651":60018,"_17922":100714,"_5":17817,"_24317":100610,"_2462":100715},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_2936":60064,"_25651":60018,"_17922":100717,"_5":17817,"_24317":100610,"_2462":100718},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_2936":60065,"_25651":60018,"_17922":100720,"_5":17817,"_24317":100610,"_2462":100721},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_2936":60066,"_25651":60018,"_17922":100723,"_5":17817,"_24317":100614,"_2462":100724},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_2936":60067,"_25651":60018,"_17922":100726,"_5":17817,"_24317":100614,"_2462":100727},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_2936":60068,"_25651":60018,"_17922":100729,"_5":17817,"_24317":100618,"_2462":100730},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_2936":60069,"_25651":60018,"_17922":100732,"_5":17817,"_24317":100618,"_2462":100733},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_2936":60070,"_25651":60018,"_17922":100735,"_5":17817,"_24317":100618,"_2462":100736},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_2936":60071,"_25651":60018,"_17922":100738,"_5":17817,"_24317":100618,"_2462":100739},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_2936":60072,"_25651":60018,"_17922":100741,"_5":17817,"_24317":100622,"_2462":100742},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2936":60073,"_25651":60018,"_17922":100744,"_5":17817,"_24317":100622,"_2462":100745},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2936":60074,"_25651":60074,"_5":12587,"_2462":100747,"_25975":100748,"_17922":100750,"_24317":60074},"Identidad inicial y autenticación",[41800,99602,44148,100574,100749],"Enrolamiento con PKI",[],{"_2936":60075,"_25651":60074,"_17922":100752,"_5":17817,"_24317":60074,"_2462":100753},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_2936":60076,"_25651":60074,"_5":25972,"_17922":100755,"_24317":100756,"_2462":100757},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_2936":60077,"_25651":60074,"_5":25972,"_17922":100759,"_24317":100760,"_2462":100761},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_2936":60078,"_25651":60074,"_5":25972,"_17922":100763,"_24317":100764,"_2462":100765},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_2936":60079,"_25651":60074,"_5":25972,"_17922":100767,"_24317":100768,"_2462":100769},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_2936":60080,"_25651":60074,"_5":25972,"_17922":100771,"_24317":100772,"_2462":100773},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_2936":60081,"_25651":60074,"_17922":100775,"_5":17817,"_24317":60074,"_2462":100776},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_2936":60082,"_25651":60074,"_17922":100778,"_5":17817,"_24317":100756,"_2462":100779},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_2936":60083,"_25651":60074,"_17922":100781,"_5":17817,"_24317":100756,"_2462":100782},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_2936":60084,"_25651":60074,"_17922":100784,"_5":17817,"_24317":100760,"_2462":100785},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_2936":60085,"_25651":60074,"_17922":100787,"_5":17817,"_24317":100760,"_2462":100788},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_2936":60086,"_25651":60074,"_17922":100790,"_5":17817,"_24317":100760,"_2462":100791},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_2936":60087,"_25651":60074,"_17922":100793,"_5":17817,"_24317":100764,"_2462":100794},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_2936":60088,"_25651":60074,"_17922":100796,"_5":17817,"_24317":100764,"_2462":100797},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_2936":60089,"_25651":60074,"_17922":100799,"_5":17817,"_24317":100768,"_2462":100800},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_2936":60090,"_25651":60074,"_17922":100802,"_5":17817,"_24317":100768,"_2462":100803},[],"Ejemplo de cuerpo:",{"_2936":60091,"_25651":60074,"_17922":100805,"_5":17817,"_24317":100768,"_2462":100806},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_2936":60092,"_25651":60074,"_17922":100808,"_5":17817,"_24317":100768,"_2462":100809},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_2936":60093,"_25651":60074,"_17922":100811,"_5":17817,"_24317":100768,"_2462":100812},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_2936":60094,"_25651":60074,"_17922":100814,"_5":17817,"_24317":100768,"_2462":100815},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_2936":60095,"_25651":60074,"_17922":100817,"_5":17817,"_24317":100772,"_2462":100818},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_2936":60096,"_25651":60074,"_17922":100820,"_5":17817,"_24317":100772,"_2462":100821},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_2936":60097,"_25651":60097,"_5":12587,"_2462":100823,"_25975":100824,"_17922":100825,"_24317":60097},"Configura y opera el DMS",[41800,99602,44148,100574,100749],[],{"_2936":60098,"_25651":60097,"_17922":100827,"_5":17817,"_24317":60097,"_2462":100828},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_2936":60099,"_25651":60097,"_5":25972,"_17922":100830,"_24317":100831,"_2462":98274},[],"/docs/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_2936":60100,"_25651":60097,"_5":25972,"_17922":100833,"_24317":100834,"_2462":100835},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_2936":60101,"_25651":60097,"_5":25972,"_17922":100837,"_24317":100838,"_2462":100839},[],"/docs/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_2936":60102,"_25651":60097,"_5":25972,"_17922":100841,"_24317":100842,"_2462":100843},[],"/docs/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_2936":60103,"_25651":60097,"_5":25972,"_17922":100845,"_24317":100846,"_2462":100847},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_2936":60104,"_25651":60097,"_5":25972,"_17922":100849,"_24317":100850,"_2462":100851},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_2936":60105,"_25651":60097,"_5":25972,"_17922":100853,"_24317":100854,"_2462":100855},[],"/docs/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_2936":60106,"_25651":60097,"_5":25972,"_17922":100857,"_24317":100858,"_2462":100859},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_2936":60107,"_25651":60097,"_5":25972,"_17922":100861,"_24317":100862,"_2462":44443},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_2936":60108,"_25651":60097,"_5":25972,"_17922":100864,"_24317":100865,"_2462":44447},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_2936":60109,"_25651":60097,"_5":25972,"_17922":100867,"_24317":100868,"_2462":100869},[],"/docs/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_2936":60110,"_25651":60097,"_5":25972,"_17922":100871,"_24317":100872,"_2462":100873},[],"/docs/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_2936":60111,"_25651":60097,"_5":25972,"_17922":100875,"_24317":100876,"_2462":100877},[],"/docs/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_2936":60112,"_25651":60097,"_5":25972,"_17922":100879,"_24317":100880,"_2462":100881},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_2936":60113,"_25651":60097,"_5":25972,"_17922":100883,"_24317":100884,"_2462":44467},[],"/docs/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_2936":60114,"_25651":60097,"_5":25972,"_17922":100886,"_24317":100887,"_2462":100888},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_2936":60115,"_25651":60097,"_5":25972,"_17922":100890,"_24317":100891,"_2462":100892},[],"/docs/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_2936":60116,"_25651":60097,"_5":25972,"_17922":100894,"_24317":100895,"_2462":100896},[],"/docs/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_2936":60117,"_25651":60097,"_17922":100898,"_5":17817,"_24317":60097,"_2462":100899},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_2936":60118,"_25651":60097,"_17922":100901,"_5":17817,"_24317":100831,"_2462":100902},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_2936":60119,"_25651":60097,"_17922":100904,"_5":17817,"_24317":100831,"_2462":100905},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_2936":60120,"_25651":60097,"_17922":100907,"_5":17817,"_24317":100838,"_2462":100908},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_2936":60121,"_25651":60097,"_17922":100910,"_5":17817,"_24317":100842,"_2462":100911},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_2936":60122,"_25651":60097,"_17922":100913,"_5":17817,"_24317":100846,"_2462":100914},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_2936":60123,"_25651":60097,"_17922":100916,"_5":17817,"_24317":100850,"_2462":100917},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_2936":60124,"_25651":60097,"_17922":100919,"_5":17817,"_24317":100854,"_2462":100920},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_2936":60125,"_25651":60097,"_17922":100922,"_5":17817,"_24317":100862,"_2462":100923},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_2936":60126,"_25651":60097,"_17922":100925,"_5":17817,"_24317":100862,"_2462":100926},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_2936":60127,"_25651":60097,"_17922":100928,"_5":17817,"_24317":100865,"_2462":100929},[],"Campo de `settings.enrollment_settings`",{"_2936":60128,"_25651":60097,"_17922":100931,"_5":17817,"_24317":100865,"_2462":100932},[],"Decisión",{"_2936":60129,"_25651":60097,"_17922":100934,"_5":17817,"_24317":100865,"_2462":44518},[],{"_2936":60130,"_25651":60097,"_17922":100936,"_5":17817,"_24317":100865,"_2462":100937},[],"`EST_RFC7030` para estas operaciones.",{"_2936":60131,"_25651":60097,"_17922":100939,"_5":17817,"_24317":100865,"_2462":44524},[],{"_2936":60132,"_25651":60097,"_17922":100941,"_5":17817,"_24317":100865,"_2462":100942},[],"ID de la CA que firmará.",{"_2936":60133,"_25651":60097,"_17922":100944,"_5":17817,"_24317":100865,"_2462":44530},[],{"_2936":60134,"_25651":60097,"_17922":100946,"_5":17817,"_24317":100865,"_2462":100947},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_2936":60135,"_25651":60097,"_17922":100949,"_5":17817,"_24317":100865,"_2462":44536},[],{"_2936":60136,"_25651":60097,"_17922":100951,"_5":17817,"_24317":100865,"_2462":100952},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_2936":60137,"_25651":60097,"_17922":100954,"_5":17817,"_24317":100865,"_2462":44542},[],{"_2936":60138,"_25651":60097,"_17922":100956,"_5":17817,"_24317":100865,"_2462":100957},[],"Uno de los cuatro modos de autenticación.",{"_2936":60139,"_25651":60097,"_17922":100959,"_5":17817,"_24317":100865,"_2462":100960},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_2936":60140,"_25651":60097,"_17922":100962,"_5":17817,"_24317":100868,"_2462":100963},[],"Los bloques son independientes:",{"_2936":60141,"_25651":60097,"_17922":100965,"_5":17817,"_24317":100868,"_2462":100966},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_2936":60142,"_25651":60097,"_17922":100968,"_5":17817,"_24317":100868,"_2462":100969},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_2936":60143,"_25651":60097,"_17922":100971,"_5":17817,"_24317":100868,"_2462":44560},[],{"_2936":60144,"_25651":60097,"_17922":100973,"_5":17817,"_24317":100868,"_2462":100974},[],"Control aplicado en la operación configurada",{"_2936":60145,"_25651":60097,"_17922":100976,"_5":17817,"_24317":100868,"_2462":44566},[],{"_2936":60146,"_25651":60097,"_17922":100978,"_5":17817,"_24317":100868,"_2462":100979},[],"Validación del certificado presentado.",{"_2936":60147,"_25651":60097,"_17922":100981,"_5":17817,"_24317":100868,"_2462":44572},[],{"_2936":60148,"_25651":60097,"_17922":100983,"_5":17817,"_24317":100868,"_2462":100984},[],"Autorización del webhook configurado.",{"_2936":60149,"_25651":60097,"_17922":100986,"_5":17817,"_24317":100868,"_2462":44578},[],{"_2936":60150,"_25651":60097,"_17922":100988,"_5":17817,"_24317":100868,"_2462":100989},[],"Validación del certificado y, después, aprobación del webhook.",{"_2936":60151,"_25651":60097,"_17922":100991,"_5":17817,"_24317":100868,"_2462":44584},[],{"_2936":60152,"_25651":60097,"_17922":100993,"_5":17817,"_24317":100868,"_2462":100994},[],"Sin autenticación del solicitante por el DMS.",{"_2936":60153,"_25651":60097,"_17922":100996,"_5":17817,"_24317":100868,"_2462":100997},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_2936":60154,"_25651":60097,"_17922":100999,"_5":17817,"_24317":100868,"_2462":101000},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_2936":60155,"_25651":60097,"_17922":101002,"_5":17817,"_24317":100868,"_2462":101003},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_2936":60156,"_25651":60097,"_17922":101005,"_5":17817,"_24317":100868,"_2462":101006},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_2936":60157,"_25651":60097,"_17922":101008,"_5":17817,"_24317":100872,"_2462":101009},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_2936":60158,"_25651":60097,"_17922":101011,"_5":17817,"_24317":100872,"_2462":101012},[],"Campo de `external_webhook_settings`",{"_2936":60159,"_25651":60097,"_17922":101014,"_5":17817,"_24317":100872,"_2462":100932},[],{"_2936":60160,"_25651":60097,"_17922":101016,"_5":17817,"_24317":100872,"_2462":44610},[],{"_2936":60161,"_25651":60097,"_17922":101018,"_5":17817,"_24317":100872,"_2462":101019},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_2936":60162,"_25651":60097,"_17922":101021,"_5":17817,"_24317":100872,"_2462":44616},[],{"_2936":60163,"_25651":60097,"_17922":101023,"_5":17817,"_24317":100872,"_2462":101024},[],"`POST` o `PUT`; `POST` por defecto.",{"_2936":60164,"_25651":60097,"_17922":101026,"_5":17817,"_24317":100872,"_2462":44622},[],{"_2936":60165,"_25651":60097,"_17922":101028,"_5":17817,"_24317":100872,"_2462":101029},[],"Etiqueta usada en los logs del servicio.",{"_2936":60166,"_25651":60097,"_17922":101031,"_5":17817,"_24317":100872,"_2462":44628},[],{"_2936":60167,"_25651":60097,"_17922":101033,"_5":17817,"_24317":100872,"_2462":101034},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_2936":60168,"_25651":60097,"_17922":101036,"_5":17817,"_24317":100872,"_2462":44634},[],{"_2936":60169,"_25651":60097,"_17922":101038,"_5":17817,"_24317":100872,"_2462":101039},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_2936":60170,"_25651":60097,"_17922":101041,"_5":17817,"_24317":100872,"_2462":44640},[],{"_2936":60171,"_25651":60097,"_17922":101043,"_5":17817,"_24317":100872,"_2462":101044},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_2936":60172,"_25651":60097,"_17922":101046,"_5":17817,"_24317":100872,"_2462":44646},[],{"_2936":60173,"_25651":60097,"_17922":101048,"_5":17817,"_24317":100872,"_2462":101049},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_2936":60174,"_25651":60097,"_17922":101051,"_5":17817,"_24317":100872,"_2462":44652},[],{"_2936":60175,"_25651":60097,"_17922":101053,"_5":17817,"_24317":100872,"_2462":101054},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_2936":60176,"_25651":60097,"_17922":101056,"_5":17817,"_24317":100872,"_2462":44658},[],{"_2936":60177,"_25651":60097,"_17922":101058,"_5":17817,"_24317":100872,"_2462":101059},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_2936":60178,"_25651":60097,"_17922":101061,"_5":17817,"_24317":100872,"_2462":101062},[],"Reglas de esa configuración:",{"_2936":60179,"_25651":60097,"_17922":101064,"_5":17817,"_24317":100872,"_2462":101065},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_2936":60180,"_25651":60097,"_17922":101067,"_5":17817,"_24317":100872,"_2462":101068},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_2936":60181,"_25651":60097,"_17922":101070,"_5":17817,"_24317":100872,"_2462":101071},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_2936":60182,"_25651":60097,"_17922":101073,"_5":17817,"_24317":100872,"_2462":101074},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_2936":60183,"_25651":60097,"_17922":101076,"_5":17817,"_24317":100872,"_2462":101077},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_2936":60184,"_25651":60097,"_17922":101079,"_5":17817,"_24317":100872,"_2462":101080},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_2936":60185,"_25651":60097,"_17922":101082,"_5":17817,"_24317":100872,"_2462":101083},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar, y si la consola de tu versión no expone la configuración independiente, utiliza la API DMS.",{"_2936":60186,"_25651":60097,"_17922":101085,"_5":17817,"_24317":100872,"_2462":101086},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_2936":60187,"_25651":60097,"_17922":101088,"_5":17817,"_24317":100872,"_2462":101089},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_2936":60188,"_25651":60097,"_17922":101091,"_5":17817,"_24317":100876,"_2462":101092},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_2936":60189,"_25651":60097,"_17922":101094,"_5":17817,"_24317":100880,"_2462":101095},[],"Campo de `settings.reenrollment_settings`",{"_2936":60190,"_25651":60097,"_17922":101097,"_5":17817,"_24317":100880,"_2462":101098},[],"Función",{"_2936":60191,"_25651":60097,"_17922":101100,"_5":17817,"_24317":100880,"_2462":44702},[],{"_2936":60192,"_25651":60097,"_17922":101102,"_5":17817,"_24317":100880,"_2462":101103},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_2936":60193,"_25651":60097,"_17922":101105,"_5":17817,"_24317":100880,"_2462":44708},[],{"_2936":60194,"_25651":60097,"_17922":101107,"_5":17817,"_24317":100880,"_2462":101108},[],"Umbral operativo preventivo de monitorización.",{"_2936":60195,"_25651":60097,"_17922":101110,"_5":17817,"_24317":100880,"_2462":44714},[],{"_2936":60196,"_25651":60097,"_17922":101112,"_5":17817,"_24317":100880,"_2462":101113},[],"Umbral operativo crítico de monitorización.",{"_2936":60197,"_25651":60097,"_17922":101115,"_5":17817,"_24317":100880,"_2462":44720},[],{"_2936":60198,"_25651":60097,"_17922":101117,"_5":17817,"_24317":100880,"_2462":101118},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_2936":60199,"_25651":60097,"_17922":101120,"_5":17817,"_24317":100880,"_2462":44726},[],{"_2936":60200,"_25651":60097,"_17922":101122,"_5":17817,"_24317":100880,"_2462":101123},[],"CAs de validación adicionales para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_2936":60201,"_25651":60097,"_17922":101125,"_5":17817,"_24317":100880,"_2462":44732},[],{"_2936":60202,"_25651":60097,"_17922":101127,"_5":17817,"_24317":100880,"_2462":101128},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_2936":60203,"_25651":60097,"_17922":101130,"_5":17817,"_24317":100880,"_2462":101131},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_2936":60204,"_25651":60097,"_17922":101133,"_5":17817,"_24317":100884,"_2462":101134},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. Algoritmo y tamaño proceden de su campo `key`; el perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_2936":60205,"_25651":60097,"_17922":101136,"_5":17817,"_24317":100887,"_2462":98635},[],{"_2936":60206,"_25651":60097,"_17922":101138,"_5":17817,"_24317":100887,"_2462":101139},[],"Qué publica",{"_2936":60207,"_25651":60097,"_17922":101141,"_5":17817,"_24317":100887,"_2462":44749},[],{"_2936":60208,"_25651":60097,"_17922":101143,"_5":17817,"_24317":100887,"_2462":101144},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_2936":60209,"_25651":60097,"_17922":101146,"_5":17817,"_24317":100887,"_2462":44755},[],{"_2936":60210,"_25651":60097,"_17922":101148,"_5":17817,"_24317":100887,"_2462":101149},[],"Certificado de la CA emisora seleccionada.",{"_2936":60211,"_25651":60097,"_17922":101151,"_5":17817,"_24317":100887,"_2462":44761},[],{"_2936":60212,"_25651":60097,"_17922":101153,"_5":17817,"_24317":100887,"_2462":101154},[],"Certificados de las CAs elegidas explícitamente.",{"_2936":60213,"_25651":60097,"_17922":101156,"_5":17817,"_24317":100887,"_2462":101157},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_2936":60214,"_25651":60097,"_17922":101159,"_5":17817,"_24317":100891,"_2462":101160},[],"**Edit** cambia nombre, ajustes y metadatos. La actualización del backend sustituye esos bloques completos; al usar la API, lee el DMS antes de enviar una edición para no perder campos.",{"_2936":60215,"_25651":60097,"_17922":101162,"_5":17817,"_24317":100891,"_2462":101163},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_2936":60216,"_25651":60097,"_17922":101165,"_5":17817,"_24317":100891,"_2462":101166},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_2936":60217,"_25651":60097,"_17922":101168,"_5":17817,"_24317":100895,"_2462":101169},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_2936":60218,"_25651":60218,"_5":12587,"_2462":101171,"_25975":101172,"_17922":101173,"_24317":60218},"Integra el cliente EST",[41800,99602,44148,100574,100749],[],{"_2936":60219,"_25651":60218,"_17922":101175,"_5":17817,"_24317":60218,"_2462":101176},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_2936":60220,"_25651":60218,"_5":25972,"_17922":101178,"_24317":101179,"_2462":98274},[],"/docs/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_2936":60221,"_25651":60218,"_5":25972,"_17922":101181,"_24317":101182,"_2462":101183},[],"/docs/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_2936":60222,"_25651":60218,"_5":25972,"_17922":101185,"_24317":101186,"_2462":101187},[],"/docs/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_2936":60223,"_25651":60218,"_5":25972,"_17922":101189,"_24317":101190,"_2462":101191},[],"/docs/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_2936":60224,"_25651":60218,"_5":25972,"_17922":101193,"_24317":101194,"_2462":101195},[],"/docs/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_2936":60225,"_25651":60218,"_5":25972,"_17922":101197,"_24317":101198,"_2462":101199},[],"/docs/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_2936":60226,"_25651":60218,"_17922":101201,"_5":17817,"_24317":60218,"_2462":101202},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_2936":60227,"_25651":60218,"_17922":101204,"_5":17817,"_24317":101179,"_2462":101205},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_2936":60228,"_25651":60218,"_17922":101207,"_5":17817,"_24317":101179,"_2462":101208},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_2936":60229,"_25651":60218,"_17922":101210,"_5":17817,"_24317":101179,"_2462":101211},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_2936":60230,"_25651":60218,"_17922":101213,"_5":17817,"_24317":101182,"_2462":101214},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_2936":60231,"_25651":60218,"_17922":101216,"_5":17817,"_24317":101182,"_2462":101217},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_2936":60232,"_25651":60218,"_17922":101219,"_5":17817,"_24317":101186,"_2462":101220},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_2936":60233,"_25651":60218,"_17922":101222,"_5":17817,"_24317":101186,"_2462":101223},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_2936":60234,"_25651":60218,"_17922":101225,"_5":17817,"_24317":101190,"_2462":101226},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_2936":60235,"_25651":60218,"_17922":101228,"_5":17817,"_24317":101190,"_2462":101229},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_2936":60236,"_25651":60218,"_17922":101231,"_5":17817,"_24317":101194,"_2462":101232},[],"Para el caso de una raíz que emite directamente:",{"_2936":60237,"_25651":60218,"_17922":101234,"_5":17817,"_24317":101194,"_2462":101235},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_2936":60238,"_25651":60218,"_17922":101237,"_5":17817,"_24317":101194,"_2462":101238},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_2936":60239,"_25651":60218,"_17922":101240,"_5":17817,"_24317":101198,"_2462":101241},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_2936":60240,"_25651":60240,"_5":12587,"_2462":101243,"_25975":101244,"_17922":101245,"_24317":60240},"Referencia EST",[41800,99602,44148,100574,100749],[],{"_2936":60241,"_25651":60240,"_17922":101247,"_5":17817,"_24317":60240,"_2462":101248},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_2936":60242,"_25651":60240,"_5":25972,"_17922":101250,"_24317":101251,"_2462":101252},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_2936":60243,"_25651":60240,"_5":25972,"_17922":101254,"_24317":101255,"_2462":19471},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2936":60244,"_25651":60240,"_5":25972,"_17922":101257,"_24317":101258,"_2462":22288},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2936":60245,"_25651":60240,"_5":25972,"_17922":101260,"_24317":101261,"_2462":22295},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2936":60246,"_25651":60240,"_5":25972,"_17922":101263,"_24317":101264,"_2462":21654},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2936":60247,"_25651":60240,"_5":25972,"_17922":101266,"_24317":101267,"_2462":101268},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_2936":60248,"_25651":60240,"_5":25972,"_17922":101270,"_24317":101271,"_2462":101272},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_2936":60249,"_25651":60240,"_5":25972,"_17922":101274,"_24317":101275,"_2462":101276},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_2936":60250,"_25651":60240,"_17922":101278,"_5":17817,"_24317":60240,"_2462":101279},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_2936":60251,"_25651":60240,"_17922":101281,"_5":17817,"_24317":101251,"_2462":101282},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_2936":60252,"_25651":60240,"_17922":101284,"_5":17817,"_24317":101251,"_2462":99393},[],{"_2936":60253,"_25651":60240,"_17922":101286,"_5":17817,"_24317":101251,"_2462":101287},[],"Método",{"_2936":60254,"_25651":60240,"_17922":101289,"_5":17817,"_24317":101251,"_2462":101290},[],"Autenticación y condición",{"_2936":60255,"_25651":60240,"_17922":101292,"_5":17817,"_24317":101251,"_2462":44904},[],{"_2936":60256,"_25651":60240,"_17922":101294,"_5":17817,"_24317":101251,"_2462":44907},[],{"_2936":60257,"_25651":60240,"_17922":101296,"_5":17817,"_24317":101251,"_2462":101297},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_2936":60258,"_25651":60240,"_17922":101299,"_5":17817,"_24317":101251,"_2462":44913},[],{"_2936":60259,"_25651":60240,"_17922":101301,"_5":17817,"_24317":101251,"_2462":44916},[],{"_2936":60260,"_25651":60240,"_17922":101303,"_5":17817,"_24317":101251,"_2462":101304},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_2936":60261,"_25651":60240,"_17922":101306,"_5":17817,"_24317":101251,"_2462":44922},[],{"_2936":60262,"_25651":60240,"_17922":101308,"_5":17817,"_24317":101251,"_2462":44916},[],{"_2936":60263,"_25651":60240,"_17922":101310,"_5":17817,"_24317":101251,"_2462":101311},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_2936":60264,"_25651":60240,"_17922":101313,"_5":17817,"_24317":101251,"_2462":44930},[],{"_2936":60265,"_25651":60240,"_17922":101315,"_5":17817,"_24317":101251,"_2462":44916},[],{"_2936":60266,"_25651":60240,"_17922":101317,"_5":17817,"_24317":101251,"_2462":101318},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_2936":60267,"_25651":60240,"_17922":101320,"_5":17817,"_24317":101251,"_2462":101321},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_2936":60268,"_25651":60240,"_17922":101323,"_5":17817,"_24317":101255,"_2462":101324},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_2936":60269,"_25651":60240,"_17922":101326,"_5":17817,"_24317":101255,"_2462":101327},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_2936":60270,"_25651":60240,"_17922":101329,"_5":17817,"_24317":101258,"_2462":101330},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_2936":60271,"_25651":60240,"_17922":101332,"_5":17817,"_24317":101258,"_2462":101333},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_2936":60272,"_25651":60240,"_17922":101335,"_5":17817,"_24317":101261,"_2462":101336},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_2936":60273,"_25651":60240,"_17922":101338,"_5":17817,"_24317":101261,"_2462":101339},[],"La CA de enrolamiento o una CA de validación configurada en el bloque de reenrolamiento valida la credencial en el modo mTLS. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_2936":60274,"_25651":60240,"_17922":101341,"_5":17817,"_24317":101264,"_2462":101342},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_2936":60275,"_25651":60240,"_17922":101344,"_5":17817,"_24317":101264,"_2462":101345},[],"El código admite RSA y ECDSA de 224, 256, 384 o 521 bits. Un tamaño ECDSA no reconocido puede producir fallback a 256; elige explícitamente un tamaño compatible y comprueba la clave resultante. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_2936":60276,"_25651":60240,"_17922":101347,"_5":17817,"_24317":101267,"_2462":101348},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_2936":60277,"_25651":60240,"_17922":101350,"_5":17817,"_24317":101267,"_2462":101351},[],"Parte",{"_2936":60278,"_25651":60240,"_17922":101353,"_5":17817,"_24317":101267,"_2462":101354},[],"Contenido tras decodificar su Base64",{"_2936":60279,"_25651":60240,"_17922":101356,"_5":17817,"_24317":101267,"_2462":44974},[],{"_2936":60280,"_25651":60240,"_17922":101358,"_5":17817,"_24317":101267,"_2462":101359},[],"Clave privada PKCS#8 DER sin cifrar.",{"_2936":60281,"_25651":60240,"_17922":101361,"_5":17817,"_24317":101267,"_2462":44980},[],{"_2936":60282,"_25651":60240,"_17922":101363,"_5":17817,"_24317":101267,"_2462":101364},[],"PKCS#7 DER con el certificado emitido.",{"_2936":60283,"_25651":60240,"_17922":101366,"_5":17817,"_24317":101267,"_2462":101367},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_2936":60284,"_25651":60240,"_17922":101369,"_5":17817,"_24317":101271,"_2462":101370},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_2936":60285,"_25651":60240,"_17922":101372,"_5":17817,"_24317":101271,"_2462":101373},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_2936":60286,"_25651":60240,"_17922":101375,"_5":17817,"_24317":101271,"_2462":101376},[],"Convierte y comprueba el resultado:",{"_2936":60287,"_25651":60240,"_17922":101378,"_5":17817,"_24317":101271,"_2462":101379},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_2936":60288,"_25651":60240,"_17922":101381,"_5":17817,"_24317":101275,"_2462":101382},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_2936":60289,"_25651":60240,"_17922":101384,"_5":17817,"_24317":101275,"_2462":101385},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_2936":60290,"_25651":60290,"_5":12587,"_2462":100749,"_25975":101387,"_17922":101388,"_24317":60290},[41800,99602,44148,100574,100749],[],{"_2936":60291,"_25651":60290,"_17922":101390,"_5":17817,"_24317":60290,"_2462":101391},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_2936":60292,"_25651":60290,"_5":25972,"_17922":101393,"_24317":101394,"_2462":101395},[],"/docs/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_2936":60293,"_25651":60290,"_5":25972,"_17922":101397,"_24317":101398,"_2462":101399},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_2936":60294,"_25651":60290,"_5":25972,"_17922":101401,"_24317":101402,"_2462":101403},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_2936":60295,"_25651":60290,"_5":25972,"_17922":101405,"_24317":101406,"_2462":101407},[],"/docs/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_2936":60296,"_25651":60290,"_17922":101409,"_5":17817,"_24317":60290,"_2462":101410},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_2936":60297,"_25651":60290,"_17922":101412,"_5":17817,"_24317":101394,"_2462":101413},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_2936":60298,"_25651":60290,"_17922":101415,"_5":17817,"_24317":101394,"_2462":101416},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_2936":60299,"_25651":60290,"_17922":101418,"_5":17817,"_24317":101394,"_2462":101419},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_2936":60300,"_25651":60290,"_17922":101421,"_5":17817,"_24317":101394,"_2462":101422},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_2936":60301,"_25651":60290,"_17922":101424,"_5":17817,"_24317":101394,"_2462":101425},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_2936":60302,"_25651":60290,"_17922":101427,"_5":17817,"_24317":101394,"_2462":101428},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_2936":60303,"_25651":60290,"_17922":101430,"_5":17817,"_24317":101398,"_2462":101431},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2936":60304,"_25651":60290,"_17922":101433,"_5":17817,"_24317":101398,"_2462":101434},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2936":60305,"_25651":60290,"_17922":101436,"_5":17817,"_24317":101398,"_2462":101437},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2936":60306,"_25651":60290,"_17922":101439,"_5":17817,"_24317":101398,"_2462":101440},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2936":60307,"_25651":60290,"_17922":101442,"_5":17817,"_24317":101402,"_2462":101443},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2936":60308,"_25651":60290,"_17922":101445,"_5":17817,"_24317":101402,"_2462":101446},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2936":60309,"_25651":60290,"_17922":101448,"_5":17817,"_24317":101402,"_2462":101449},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2936":60310,"_25651":60290,"_17922":101451,"_5":17817,"_24317":101402,"_2462":101452},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2936":60311,"_25651":60290,"_17922":101454,"_5":17817,"_24317":101406,"_2462":101455},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_2936":60312,"_25651":60290,"_17922":101457,"_5":17817,"_24317":101406,"_2462":101458},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_2936":60313,"_25651":60313,"_5":12587,"_2462":101460,"_25975":101461,"_17922":101462,"_24317":60313},"Estrategias de aprovisionamiento",[41800,99602,44148,100574,100749],[],{"_2936":60314,"_25651":60313,"_17922":101464,"_5":17817,"_24317":60313,"_2462":101465},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_2936":60315,"_25651":60313,"_5":25972,"_17922":101467,"_24317":101468,"_2462":101469},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_2936":60316,"_25651":60313,"_5":25972,"_17922":101471,"_24317":101472,"_2462":101473},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_2936":60317,"_25651":60313,"_5":25972,"_17922":101475,"_24317":101476,"_2462":101477},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_2936":60318,"_25651":60313,"_5":25972,"_17922":101479,"_24317":101480,"_2462":101481},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_2936":60319,"_25651":60313,"_5":25972,"_17922":101483,"_24317":101484,"_2462":101485},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_2936":60320,"_25651":60313,"_17922":101487,"_5":17817,"_24317":60313,"_2462":101488},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_2936":60321,"_25651":60313,"_17922":101490,"_5":17817,"_24317":101468,"_2462":101491},[],"Recorrido",{"_2936":60322,"_25651":60313,"_17922":101493,"_5":17817,"_24317":101468,"_2462":101494},[],"Cuándo existe el dispositivo",{"_2936":60323,"_25651":60313,"_17922":101496,"_5":17817,"_24317":101468,"_2462":101497},[],"Qué compruebas",{"_2936":60324,"_25651":60313,"_17922":101499,"_5":17817,"_24317":101468,"_2462":101500},[],"Asignación manual",{"_2936":60325,"_25651":60313,"_17922":101502,"_5":17817,"_24317":101468,"_2462":101503},[],"El operador lo crea antes de asociar un certificado.",{"_2936":60326,"_25651":60313,"_17922":101505,"_5":17817,"_24317":101468,"_2462":101506},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_2936":60327,"_25651":60313,"_17922":101508,"_5":17817,"_24317":101468,"_2462":101509},[],"EST con `JITP`",{"_2936":60328,"_25651":60313,"_17922":101511,"_5":17817,"_24317":101468,"_2462":101512},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_2936":60329,"_25651":60313,"_17922":101514,"_5":17817,"_24317":101468,"_2462":101515},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_2936":60330,"_25651":60313,"_17922":101517,"_5":17817,"_24317":101468,"_2462":101518},[],"EST con `PRE_REGISTRATION`",{"_2936":60331,"_25651":60313,"_17922":101520,"_5":17817,"_24317":101468,"_2462":101521},[],"Debe existir antes de `/simpleenroll`.",{"_2936":60332,"_25651":60313,"_17922":101523,"_5":17817,"_24317":101468,"_2462":101524},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_2936":60333,"_25651":60313,"_17922":101526,"_5":17817,"_24317":101468,"_2462":101527},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_2936":60334,"_25651":60313,"_17922":101529,"_5":17817,"_24317":101468,"_2462":101530},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_2936":60335,"_25651":60313,"_17922":101532,"_5":17817,"_24317":101472,"_2462":101533},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_2936":60336,"_25651":60313,"_17922":101535,"_5":17817,"_24317":101472,"_2462":101536},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_2936":60337,"_25651":60313,"_17922":101538,"_5":17817,"_24317":101472,"_2462":101539},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_2936":60338,"_25651":60313,"_17922":101541,"_5":17817,"_24317":101476,"_2462":101542},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_2936":60339,"_25651":60313,"_17922":101544,"_5":17817,"_24317":101476,"_2462":101545},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_2936":60340,"_25651":60313,"_17922":101547,"_5":17817,"_24317":101476,"_2462":101548},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_2936":60341,"_25651":60313,"_17922":101550,"_5":17817,"_24317":101476,"_2462":101551},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_2936":60342,"_25651":60313,"_17922":101553,"_5":17817,"_24317":101476,"_2462":101554},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_2936":60343,"_25651":60313,"_17922":101556,"_5":17817,"_24317":101476,"_2462":101557},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_2936":60344,"_25651":60313,"_17922":101559,"_5":17817,"_24317":101480,"_2462":98635},[],{"_2936":60345,"_25651":60313,"_17922":101561,"_5":17817,"_24317":101480,"_2462":101562},[],"Material que atraviesa EST",{"_2936":60346,"_25651":60313,"_17922":101564,"_5":17817,"_24317":101480,"_2462":101565},[],"Clave generada por el dispositivo",{"_2936":60347,"_25651":60313,"_17922":101567,"_5":17817,"_24317":101480,"_2462":101568},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_2936":60348,"_25651":60313,"_17922":101570,"_5":17817,"_24317":101480,"_2462":101571},[],"Clave ya disponible en el dispositivo",{"_2936":60349,"_25651":60313,"_17922":101573,"_5":17817,"_24317":101480,"_2462":101574},[],"CSR firmada con la clave existente y certificado nuevo.",{"_2936":60350,"_25651":60313,"_17922":101576,"_5":17817,"_24317":101480,"_2462":44467},[],{"_2936":60351,"_25651":60313,"_17922":101578,"_5":17817,"_24317":101480,"_2462":101579},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_2936":60352,"_25651":60313,"_17922":101581,"_5":17817,"_24317":101480,"_2462":101582},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_2936":60353,"_25651":60313,"_17922":101584,"_5":17817,"_24317":101484,"_2462":101585},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_2936":60354,"_25651":60354,"_5":12587,"_2462":101587,"_25975":101588,"_17922":101589,"_24317":60354},"Renovación y recuperación",[41800,99602,44148,100574,100749],[],{"_2936":60355,"_25651":60354,"_17922":101591,"_5":17817,"_24317":60354,"_2462":101592},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_2936":60356,"_25651":60354,"_5":25972,"_17922":101594,"_24317":101595,"_2462":101596},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_2936":60357,"_25651":60354,"_5":25972,"_17922":101598,"_24317":101599,"_2462":101600},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_2936":60358,"_25651":60354,"_5":25972,"_17922":101602,"_24317":101603,"_2462":101604},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_2936":60359,"_25651":60354,"_5":25972,"_17922":101606,"_24317":101607,"_2462":101608},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_2936":60360,"_25651":60354,"_5":25972,"_17922":101610,"_24317":101611,"_2462":101612},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_2936":60361,"_25651":60354,"_17922":101614,"_5":17817,"_24317":60354,"_2462":101615},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_2936":60362,"_25651":60354,"_17922":101617,"_5":17817,"_24317":101595,"_2462":101618},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_2936":60363,"_25651":60354,"_17922":101620,"_5":17817,"_24317":101595,"_2462":101621},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_2936":60364,"_25651":60354,"_17922":101623,"_5":17817,"_24317":101595,"_2462":101624},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_2936":60365,"_25651":60354,"_17922":101626,"_5":17817,"_24317":101595,"_2462":101627},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_2936":60366,"_25651":60354,"_17922":101629,"_5":17817,"_24317":101599,"_2462":101630},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_2936":60367,"_25651":60354,"_17922":101632,"_5":17817,"_24317":101599,"_2462":101633},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_2936":60368,"_25651":60354,"_17922":101635,"_5":17817,"_24317":101603,"_2462":101636},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_2936":60369,"_25651":60354,"_17922":101638,"_5":17817,"_24317":101603,"_2462":101639},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_2936":60370,"_25651":60354,"_17922":101641,"_5":17817,"_24317":101603,"_2462":101642},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_2936":60371,"_25651":60354,"_17922":101644,"_5":17817,"_24317":101607,"_2462":101645},[],"Situación",{"_2936":60372,"_25651":60354,"_17922":101647,"_5":17817,"_24317":101607,"_2462":101648},[],"Procedimiento",{"_2936":60373,"_25651":60354,"_17922":101650,"_5":17817,"_24317":101607,"_2462":101651},[],"Certificado vigente, fuera de ventana",{"_2936":60374,"_25651":60354,"_17922":101653,"_5":17817,"_24317":101607,"_2462":101654},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_2936":60375,"_25651":60354,"_17922":101656,"_5":17817,"_24317":101607,"_2462":101657},[],"Certificado vencido, clave disponible",{"_2936":60376,"_25651":60354,"_17922":101659,"_5":17817,"_24317":101607,"_2462":101660},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_2936":60377,"_25651":60354,"_17922":101662,"_5":17817,"_24317":101607,"_2462":101663},[],"Renovación por webhook o `NO_AUTH`",{"_2936":60378,"_25651":60354,"_17922":101665,"_5":17817,"_24317":101607,"_2462":101666},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_2936":60379,"_25651":60354,"_17922":101668,"_5":17817,"_24317":101607,"_2462":101669},[],"Clave perdida o inaccesible",{"_2936":60380,"_25651":60354,"_17922":101671,"_5":17817,"_24317":101607,"_2462":101672},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_2936":60381,"_25651":60354,"_17922":101674,"_5":17817,"_24317":101607,"_2462":101675},[],"Identidad actual revocada",{"_2936":60382,"_25651":60354,"_17922":101677,"_5":17817,"_24317":101607,"_2462":101678},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_2936":60383,"_25651":60354,"_17922":101680,"_5":17817,"_24317":101607,"_2462":101681},[],"Dispositivo sin identidad",{"_2936":60384,"_25651":60354,"_17922":101683,"_5":17817,"_24317":101607,"_2462":101684},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_2936":60385,"_25651":60354,"_17922":101686,"_5":17817,"_24317":101607,"_2462":101687},[],"Dispositivo retirado",{"_2936":60386,"_25651":60354,"_17922":101689,"_5":17817,"_24317":101607,"_2462":101690},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_2936":60387,"_25651":60354,"_17922":101692,"_5":17817,"_24317":101607,"_2462":101693},[],"Timeout, HTTP 500 o fallo de instalación",{"_2936":60388,"_25651":60354,"_17922":101695,"_5":17817,"_24317":101607,"_2462":101696},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_2936":60389,"_25651":60354,"_17922":101698,"_5":17817,"_24317":101611,"_2462":101699},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_2936":60390,"_25651":60354,"_17922":101701,"_5":17817,"_24317":101611,"_2462":101702},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_2936":60391,"_25651":60391,"_5":12587,"_2462":101704,"_25975":101705,"_17922":101706,"_24317":60391},"Diagnóstico de enrolamiento",[41800,99602,44148,100574,100749],[],{"_2936":60392,"_25651":60391,"_17922":101708,"_5":17817,"_24317":60391,"_2462":101709},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_2936":60393,"_25651":60391,"_5":25972,"_17922":101711,"_24317":101712,"_2462":101713},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_2936":60394,"_25651":60391,"_5":25972,"_17922":101715,"_24317":101716,"_2462":101717},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_2936":60395,"_25651":60391,"_5":25972,"_17922":101719,"_24317":101720,"_2462":101276},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_2936":60396,"_25651":60391,"_5":25972,"_17922":101722,"_24317":101723,"_2462":101724},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_2936":60397,"_25651":60391,"_17922":101726,"_5":17817,"_24317":60391,"_2462":101727},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_2936":60398,"_25651":60391,"_17922":101729,"_5":17817,"_24317":101716,"_2462":101730},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_2936":60399,"_25651":60391,"_17922":101732,"_5":17817,"_24317":101716,"_2462":101733},[],"Síntoma o mensaje",{"_2936":60400,"_25651":60391,"_17922":101735,"_5":17817,"_24317":101716,"_2462":101736},[],"Qué revisar",{"_2936":60401,"_25651":60391,"_17922":101738,"_5":17817,"_24317":101716,"_2462":101739},[],"curl rechaza TLS, nombre o emisor",{"_2936":60402,"_25651":60391,"_17922":101741,"_5":17817,"_24317":101716,"_2462":101742},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_2936":60403,"_25651":60391,"_17922":101744,"_5":17817,"_24317":101716,"_2462":101745},[],"404 o APS ausente",{"_2936":60404,"_25651":60391,"_17922":101747,"_5":17817,"_24317":101716,"_2462":101748},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_2936":60405,"_25651":60391,"_17922":101750,"_5":17817,"_24317":101716,"_2462":101751},[],"400, error de CSR o formato",{"_2936":60406,"_25651":60391,"_17922":101753,"_5":17817,"_24317":101716,"_2462":101754},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_2936":60407,"_25651":60391,"_17922":101756,"_5":17817,"_24317":101716,"_2462":101757},[],"Credencial ausente o certificado no válido",{"_2936":60408,"_25651":60391,"_17922":101759,"_5":17817,"_24317":101716,"_2462":101760},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_2936":60409,"_25651":60391,"_17922":101762,"_5":17817,"_24317":101716,"_2462":101763},[],"Webhook deniega, expira o responde sin autorización",{"_2936":60410,"_25651":60391,"_17922":101765,"_5":17817,"_24317":101716,"_2462":101766},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_2936":60411,"_25651":60391,"_17922":101768,"_5":17817,"_24317":101716,"_2462":45387},[],{"_2936":60412,"_25651":60391,"_17922":101770,"_5":17817,"_24317":101716,"_2462":101771},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_2936":60413,"_25651":60391,"_17922":101773,"_5":17817,"_24317":101716,"_2462":45393},[],{"_2936":60414,"_25651":60391,"_17922":101775,"_5":17817,"_24317":101716,"_2462":101776},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_2936":60415,"_25651":60391,"_17922":101778,"_5":17817,"_24317":101716,"_2462":45399},[],{"_2936":60416,"_25651":60391,"_17922":101780,"_5":17817,"_24317":101716,"_2462":101781},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_2936":60417,"_25651":60391,"_17922":101783,"_5":17817,"_24317":101716,"_2462":45405},[],{"_2936":60418,"_25651":60391,"_17922":101785,"_5":17817,"_24317":101716,"_2462":101786},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_2936":60419,"_25651":60391,"_17922":101788,"_5":17817,"_24317":101716,"_2462":45411},[],{"_2936":60420,"_25651":60391,"_17922":101790,"_5":17817,"_24317":101716,"_2462":101791},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_2936":60421,"_25651":60391,"_17922":101793,"_5":17817,"_24317":101716,"_2462":101794},[],"400 `struct validation error` al crear o actualizar un DMS",{"_2936":60422,"_25651":60391,"_17922":101796,"_5":17817,"_24317":101716,"_2462":101797},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_2936":60423,"_25651":60391,"_17922":101799,"_5":17817,"_24317":101716,"_2462":101800},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_2936":60424,"_25651":60391,"_17922":101802,"_5":17817,"_24317":101716,"_2462":101803},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_2936":60425,"_25651":60391,"_17922":101805,"_5":17817,"_24317":101716,"_2462":45429},[],{"_2936":60426,"_25651":60391,"_17922":101807,"_5":17817,"_24317":101716,"_2462":101808},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_2936":60427,"_25651":60391,"_17922":101810,"_5":17817,"_24317":101716,"_2462":45435},[],{"_2936":60428,"_25651":60391,"_17922":101812,"_5":17817,"_24317":101716,"_2462":101813},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_2936":60429,"_25651":60391,"_17922":101815,"_5":17817,"_24317":101716,"_2462":101816},[],"DMS propietario distinto",{"_2936":60430,"_25651":60391,"_17922":101818,"_5":17817,"_24317":101716,"_2462":101819},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_2936":60431,"_25651":60391,"_17922":101821,"_5":17817,"_24317":101716,"_2462":45447},[],{"_2936":60432,"_25651":60391,"_17922":101823,"_5":17817,"_24317":101716,"_2462":101824},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_2936":60433,"_25651":60391,"_17922":101826,"_5":17817,"_24317":101716,"_2462":45453},[],{"_2936":60434,"_25651":60391,"_17922":101828,"_5":17817,"_24317":101716,"_2462":101829},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_2936":60435,"_25651":60391,"_17922":101831,"_5":17817,"_24317":101716,"_2462":101832},[],"Certificado actual revocado",{"_2936":60436,"_25651":60391,"_17922":101834,"_5":17817,"_24317":101716,"_2462":101835},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_2936":60437,"_25651":60391,"_17922":101837,"_5":17817,"_24317":101716,"_2462":101838},[],"Error de CA, perfil o firma",{"_2936":60438,"_25651":60391,"_17922":101840,"_5":17817,"_24317":101716,"_2462":101841},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_2936":60439,"_25651":60391,"_17922":101843,"_5":17817,"_24317":101716,"_2462":101844},[],"HTTP 200 sin conexión del dispositivo",{"_2936":60440,"_25651":60391,"_17922":101846,"_5":17817,"_24317":101716,"_2462":101847},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_2936":60441,"_25651":60391,"_17922":101849,"_5":17817,"_24317":101716,"_2462":101850},[],"Timeout o error después de emitir",{"_2936":60442,"_25651":60391,"_17922":101852,"_5":17817,"_24317":101716,"_2462":101853},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_2936":60443,"_25651":60391,"_17922":101855,"_5":17817,"_24317":101720,"_2462":101856},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_2936":60444,"_25651":60391,"_17922":101858,"_5":17817,"_24317":101720,"_2462":101859},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_2936":60445,"_25651":60391,"_17922":101861,"_5":17817,"_24317":101723,"_2462":101862},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_2936":60446,"_25651":60391,"_17922":101864,"_5":17817,"_24317":101723,"_2462":101865},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_2936":60447,"_25651":60391,"_17922":101867,"_5":17817,"_24317":101723,"_2462":101868},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_2936":60448,"_25651":60391,"_17922":101870,"_5":17817,"_24317":101723,"_2462":101871},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_2936":60449,"_25651":60391,"_17922":101873,"_5":17817,"_24317":101723,"_2462":101874},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_2936":60450,"_25651":60391,"_17922":101876,"_5":17817,"_24317":101723,"_2462":101877},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_2936":60451,"_25651":60391,"_17922":101879,"_5":17817,"_24317":101723,"_2462":101880},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_2936":60452,"_25651":60452,"_5":12587,"_2462":101882,"_25975":101883,"_17922":101884,"_24317":60452},"Distribución y actualización de confianza",[41800,99602,44148,100574,100749],[],{"_2936":60453,"_25651":60452,"_17922":101886,"_5":17817,"_24317":60452,"_2462":101887},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_2936":60454,"_25651":60452,"_5":25972,"_17922":101889,"_24317":101890,"_2462":101891},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_2936":60455,"_25651":60452,"_5":25972,"_17922":101893,"_24317":101894,"_2462":101895},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_2936":60456,"_25651":60452,"_5":25972,"_17922":101897,"_24317":101898,"_2462":101899},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_2936":60457,"_25651":60452,"_5":25972,"_17922":101901,"_24317":101902,"_2462":101903},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_2936":60458,"_25651":60452,"_5":25972,"_17922":101905,"_24317":101906,"_2462":101907},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_2936":60459,"_25651":60452,"_17922":101909,"_5":17817,"_24317":60452,"_2462":101910},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_2936":60460,"_25651":60452,"_17922":101912,"_5":17817,"_24317":101890,"_2462":101913},[],"Relación",{"_2936":60461,"_25651":60452,"_17922":101915,"_5":17817,"_24317":101890,"_2462":101916},[],"Material que prepara el responsable",{"_2936":60462,"_25651":60452,"_17922":101918,"_5":17817,"_24317":101890,"_2462":101919},[],"Dispositivo → servidor EST",{"_2936":60463,"_25651":60452,"_17922":101921,"_5":17817,"_24317":101890,"_2462":101922},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_2936":60464,"_25651":60452,"_17922":101924,"_5":17817,"_24317":101890,"_2462":101925},[],"DMS → solicitante",{"_2936":60465,"_25651":60452,"_17922":101927,"_5":17817,"_24317":101890,"_2462":101928},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_2936":60466,"_25651":60452,"_17922":101930,"_5":17817,"_24317":101890,"_2462":101931},[],"Consumidor → dispositivo",{"_2936":60467,"_25651":60452,"_17922":101933,"_5":17817,"_24317":101890,"_2462":101934},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_2936":60468,"_25651":60452,"_17922":101936,"_5":17817,"_24317":101890,"_2462":101937},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_2936":60469,"_25651":60452,"_17922":101939,"_5":17817,"_24317":101894,"_2462":101940},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_2936":60470,"_25651":60452,"_17922":101942,"_5":17817,"_24317":101894,"_2462":101943},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_2936":60471,"_25651":60452,"_17922":101945,"_5":17817,"_24317":101898,"_2462":101946},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_2936":60472,"_25651":60452,"_17922":101948,"_5":17817,"_24317":101898,"_2462":101949},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_2936":60473,"_25651":60452,"_17922":101951,"_5":17817,"_24317":101898,"_2462":101952},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_2936":60474,"_25651":60452,"_17922":101954,"_5":17817,"_24317":101898,"_2462":101955},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_2936":60475,"_25651":60452,"_17922":101957,"_5":17817,"_24317":101898,"_2462":101958},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_2936":60476,"_25651":60452,"_17922":101960,"_5":17817,"_24317":101898,"_2462":101961},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_2936":60477,"_25651":60452,"_17922":101963,"_5":17817,"_24317":101902,"_2462":101964},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_2936":60478,"_25651":60452,"_17922":101966,"_5":17817,"_24317":101902,"_2462":101967},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Al cambiar la CA de enrolamiento, añade a esa lista la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_2936":60479,"_25651":60452,"_17922":101969,"_5":17817,"_24317":101902,"_2462":101970},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_2936":60480,"_25651":60452,"_17922":101972,"_5":17817,"_24317":101906,"_2462":101973},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_2936":60481,"_25651":60481,"_5":12587,"_2462":45602,"_25975":101975,"_17922":101977,"_24317":60481},[41800,99602,44148,100574,101976],"Integraciones",[],{"_2936":60482,"_25651":60481,"_17922":101979,"_5":17817,"_24317":60481,"_2462":101980},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_2936":60483,"_25651":60481,"_5":25972,"_17922":101982,"_24317":101983,"_2462":101984},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_2936":60484,"_25651":60481,"_5":25972,"_17922":101986,"_24317":101987,"_2462":101988},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_2936":60485,"_25651":60481,"_5":25972,"_17922":101990,"_24317":101991,"_2462":101992},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_2936":60486,"_25651":60481,"_5":25972,"_17922":101994,"_24317":101995,"_2462":101996},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_2936":60487,"_25651":60481,"_5":25972,"_17922":101998,"_24317":101999,"_2462":102000},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_2936":60488,"_25651":60481,"_5":25972,"_17922":102002,"_24317":102003,"_2462":102004},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_2936":60489,"_25651":60481,"_5":25972,"_17922":102006,"_24317":102007,"_2462":45636},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_2936":60490,"_25651":60481,"_5":25972,"_17922":102009,"_24317":102010,"_2462":45640},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_2936":60491,"_25651":60481,"_5":25972,"_17922":102012,"_24317":102013,"_2462":102014},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_2936":60492,"_25651":60481,"_5":25972,"_17922":102016,"_24317":102017,"_2462":102018},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_2936":60493,"_25651":60481,"_5":25972,"_17922":102020,"_24317":102021,"_2462":102022},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_2936":60494,"_25651":60481,"_5":25972,"_17922":102024,"_24317":102025,"_2462":102026},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_2936":60495,"_25651":60481,"_5":25972,"_17922":102028,"_24317":102029,"_2462":102030},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_2936":60496,"_25651":60481,"_5":25972,"_17922":102032,"_24317":102033,"_2462":102034},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_2936":60497,"_25651":60481,"_5":25972,"_17922":102036,"_24317":102037,"_2462":102038},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_2936":60498,"_25651":60481,"_5":25972,"_17922":102040,"_24317":102041,"_2462":102042},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_2936":60499,"_25651":60481,"_5":25972,"_17922":102044,"_24317":102045,"_2462":102046},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_2936":60500,"_25651":60481,"_5":25972,"_17922":102048,"_24317":102049,"_2462":102050},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_2936":60501,"_25651":60481,"_5":25972,"_17922":102052,"_24317":102053,"_2462":102054},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_2936":60502,"_25651":60481,"_5":25972,"_17922":102056,"_24317":102057,"_2462":102058},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_2936":60503,"_25651":60481,"_17922":102060,"_5":17817,"_24317":60481,"_2462":102061},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_2936":60504,"_25651":60481,"_17922":102063,"_5":17817,"_24317":60481,"_2462":102064},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_2936":60505,"_25651":60481,"_17922":102066,"_5":17817,"_24317":60481,"_2462":102067},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_2936":60506,"_25651":60481,"_17922":102069,"_5":17817,"_24317":101983,"_2462":102070},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_2936":60507,"_25651":60481,"_17922":102072,"_5":17817,"_24317":101983,"_2462":102073},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_2936":60508,"_25651":60481,"_17922":102075,"_5":17817,"_24317":101983,"_2462":102076},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_2936":60509,"_25651":60481,"_17922":102078,"_5":17817,"_24317":101983,"_2462":102079},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_2936":60510,"_25651":60481,"_17922":102081,"_5":17817,"_24317":101987,"_2462":102082},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_2936":60511,"_25651":60481,"_17922":102084,"_5":17817,"_24317":101991,"_2462":102085},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_2936":60512,"_25651":60481,"_17922":102087,"_5":17817,"_24317":101991,"_2462":102088},[],"Acción IAM",{"_2936":60513,"_25651":60481,"_17922":102090,"_5":17817,"_24317":101991,"_2462":98641},[],{"_2936":60514,"_25651":60481,"_17922":102092,"_5":17817,"_24317":101991,"_2462":45723},[],{"_2936":60515,"_25651":60481,"_17922":102094,"_5":17817,"_24317":101991,"_2462":102095},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_2936":60516,"_25651":60481,"_17922":102097,"_5":17817,"_24317":101991,"_2462":45729},[],{"_2936":60517,"_25651":60481,"_17922":102099,"_5":17817,"_24317":101991,"_2462":102100},[],"Registrar la CA en AWS IoT",{"_2936":60518,"_25651":60481,"_17922":102102,"_5":17817,"_24317":101991,"_2462":45735},[],{"_2936":60519,"_25651":60481,"_17922":102104,"_5":17817,"_24317":101991,"_2462":102105},[],"Consultar el estado del registro de la CA",{"_2936":60520,"_25651":60481,"_17922":102107,"_5":17817,"_24317":101991,"_2462":45741},[],{"_2936":60521,"_25651":60481,"_17922":102109,"_5":17817,"_24317":101991,"_2462":102110},[],"Crear o actualizar Things en IoT Core",{"_2936":60522,"_25651":60481,"_17922":102112,"_5":17817,"_24317":101991,"_2462":45747},[],{"_2936":60523,"_25651":60481,"_17922":102114,"_5":17817,"_24317":101991,"_2462":102115},[],"Aprovisionar Things mediante plantilla",{"_2936":60524,"_25651":60481,"_17922":102117,"_5":17817,"_24317":101991,"_2462":45753},[],{"_2936":60525,"_25651":60481,"_17922":102119,"_5":17817,"_24317":101991,"_2462":102120},[],"Registrar certificados de dispositivo",{"_2936":60526,"_25651":60481,"_17922":102122,"_5":17817,"_24317":101991,"_2462":45759},[],{"_2936":60527,"_25651":60481,"_17922":102124,"_5":17817,"_24317":101991,"_2462":102125},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_2936":60528,"_25651":60481,"_17922":102127,"_5":17817,"_24317":101991,"_2462":45765},[],{"_2936":60529,"_25651":60481,"_17922":102129,"_5":17817,"_24317":101991,"_2462":102130},[],"Crear y adjuntar políticas IoT",{"_2936":60530,"_25651":60481,"_17922":102132,"_5":17817,"_24317":101991,"_2462":45771},[],{"_2936":60531,"_25651":60481,"_17922":102134,"_5":17817,"_24317":101991,"_2462":102135},[],"Gestionar grupos de Things",{"_2936":60532,"_25651":60481,"_17922":102137,"_5":17817,"_24317":101991,"_2462":45777},[],{"_2936":60533,"_25651":60481,"_17922":102139,"_5":17817,"_24317":101991,"_2462":102140},[],"Crear plantillas JITP",{"_2936":60534,"_25651":60481,"_17922":102142,"_5":17817,"_24317":101991,"_2462":45783},[],{"_2936":60535,"_25651":60481,"_17922":102144,"_5":17817,"_24317":101991,"_2462":102145},[],"Leer y escribir el Device Shadow",{"_2936":60536,"_25651":60481,"_17922":102147,"_5":17817,"_24317":101991,"_2462":102148},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_2936":60537,"_25651":60481,"_17922":102150,"_5":17817,"_24317":101995,"_2462":102151},[],"Parámetro",{"_2936":60538,"_25651":60481,"_17922":102153,"_5":17817,"_24317":101995,"_2462":102154},[],"Tipo",{"_2936":60539,"_25651":60481,"_17922":102156,"_5":17817,"_24317":101995,"_2462":102157},[],"Requerido",{"_2936":60540,"_25651":60481,"_17922":102159,"_5":17817,"_24317":101995,"_2462":102160},[],"Descripción",{"_2936":60541,"_25651":60481,"_17922":102162,"_5":17817,"_24317":101995,"_2462":45804},[],{"_2936":60542,"_25651":60481,"_17922":102164,"_5":17817,"_24317":101995,"_2462":21398},[],{"_2936":60543,"_25651":60481,"_17922":102166,"_5":17817,"_24317":101995,"_2462":102167},[],"Sí",{"_2936":60544,"_25651":60481,"_17922":102169,"_5":17817,"_24317":101995,"_2462":102170},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_2936":60545,"_25651":60481,"_17922":102172,"_5":17817,"_24317":101995,"_2462":45815},[],{"_2936":60546,"_25651":60481,"_17922":102174,"_5":17817,"_24317":101995,"_2462":21398},[],{"_2936":60547,"_25651":60481,"_17922":102176,"_5":17817,"_24317":101995,"_2462":102167},[],{"_2936":60548,"_25651":60481,"_17922":102178,"_5":17817,"_24317":101995,"_2462":102179},[],"Región AWS donde opera el conector.",{"_2936":60549,"_25651":60481,"_17922":102181,"_5":17817,"_24317":101995,"_2462":45825},[],{"_2936":60550,"_25651":60481,"_17922":102183,"_5":17817,"_24317":101995,"_2462":21398},[],{"_2936":60551,"_25651":60481,"_17922":102185,"_5":17817,"_24317":101995,"_2462":102167},[],{"_2936":60552,"_25651":60481,"_17922":102187,"_5":17817,"_24317":101995,"_2462":102188},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_2936":60553,"_25651":60481,"_17922":102190,"_5":17817,"_24317":101995,"_2462":45835},[],{"_2936":60554,"_25651":60481,"_17922":102192,"_5":17817,"_24317":101995,"_2462":21398},[],{"_2936":60555,"_25651":60481,"_17922":102194,"_5":17817,"_24317":101995,"_2462":102195},[],"Solo con `auth_method=static`",{"_2936":60556,"_25651":60481,"_17922":102197,"_5":17817,"_24317":101995,"_2462":102198},[],"Clave de acceso AWS.",{"_2936":60557,"_25651":60481,"_17922":102200,"_5":17817,"_24317":101995,"_2462":45846},[],{"_2936":60558,"_25651":60481,"_17922":102202,"_5":17817,"_24317":101995,"_2462":21398},[],{"_2936":60559,"_25651":60481,"_17922":102204,"_5":17817,"_24317":101995,"_2462":102195},[],{"_2936":60560,"_25651":60481,"_17922":102206,"_5":17817,"_24317":101995,"_2462":102207},[],"Clave secreta AWS.",{"_2936":60561,"_25651":60481,"_17922":102209,"_5":17817,"_24317":101995,"_2462":45856},[],{"_2936":60562,"_25651":60481,"_17922":102211,"_5":17817,"_24317":101995,"_2462":21398},[],{"_2936":60563,"_25651":60481,"_17922":102213,"_5":17817,"_24317":101995,"_2462":45861},[],{"_2936":60564,"_25651":60481,"_17922":102215,"_5":17817,"_24317":101995,"_2462":102216},[],"Token de sesión (con `auth_method=static`).",{"_2936":60565,"_25651":60481,"_17922":102218,"_5":17817,"_24317":101995,"_2462":45867},[],{"_2936":60566,"_25651":60481,"_17922":102220,"_5":17817,"_24317":101995,"_2462":21398},[],{"_2936":60567,"_25651":60481,"_17922":102222,"_5":17817,"_24317":101995,"_2462":102223},[],"Solo con `auth_method=role`",{"_2936":60568,"_25651":60481,"_17922":102225,"_5":17817,"_24317":101995,"_2462":102226},[],"ARN del rol a asumir.",{"_2936":60569,"_25651":60481,"_17922":102228,"_5":17817,"_24317":101995,"_2462":45878},[],{"_2936":60570,"_25651":60481,"_17922":102230,"_5":17817,"_24317":101995,"_2462":21398},[],{"_2936":60571,"_25651":60481,"_17922":102232,"_5":17817,"_24317":101995,"_2462":45861},[],{"_2936":60572,"_25651":60481,"_17922":102234,"_5":17817,"_24317":101995,"_2462":102235},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_2936":60573,"_25651":60481,"_17922":102237,"_5":17817,"_24317":101995,"_2462":45888},[],{"_2936":60574,"_25651":60481,"_17922":102239,"_5":17817,"_24317":101995,"_2462":15040},[],{"_2936":60575,"_25651":60481,"_17922":102241,"_5":17817,"_24317":101995,"_2462":102167},[],{"_2936":60576,"_25651":60481,"_17922":102243,"_5":17817,"_24317":101995,"_2462":102244},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_2936":60577,"_25651":60481,"_17922":102246,"_5":17817,"_24317":101995,"_2462":45898},[],{"_2936":60578,"_25651":60481,"_17922":102248,"_5":17817,"_24317":101995,"_2462":21398},[],{"_2936":60579,"_25651":60481,"_17922":102250,"_5":17817,"_24317":101995,"_2462":102167},[],{"_2936":60580,"_25651":60481,"_17922":102252,"_5":17817,"_24317":101995,"_2462":102253},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_2936":60581,"_25651":60481,"_17922":102255,"_5":17817,"_24317":101995,"_2462":45908},[],{"_2936":60582,"_25651":60481,"_17922":102257,"_5":17817,"_24317":101995,"_2462":21398},[],{"_2936":60583,"_25651":60481,"_17922":102259,"_5":17817,"_24317":101995,"_2462":102167},[],{"_2936":60584,"_25651":60481,"_17922":102261,"_5":17817,"_24317":101995,"_2462":102262},[],"URL HTTP del Device Manager de Lamassu.",{"_2936":60585,"_25651":60481,"_17922":102264,"_5":17817,"_24317":101995,"_2462":45918},[],{"_2936":60586,"_25651":60481,"_17922":102266,"_5":17817,"_24317":101995,"_2462":21398},[],{"_2936":60587,"_25651":60481,"_17922":102268,"_5":17817,"_24317":101995,"_2462":102167},[],{"_2936":60588,"_25651":60481,"_17922":102270,"_5":17817,"_24317":101995,"_2462":102271},[],"URL HTTP del servicio de CA de Lamassu.",{"_2936":60589,"_25651":60481,"_17922":102273,"_5":17817,"_24317":101999,"_2462":102274},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_2936":60590,"_25651":60481,"_17922":102276,"_5":17817,"_24317":102003,"_2462":102277},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_2936":60591,"_25651":60481,"_17922":102279,"_5":17817,"_24317":102003,"_2462":102280},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_2936":60592,"_25651":60481,"_17922":102282,"_5":17817,"_24317":102007,"_2462":102283},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_2936":60593,"_25651":60481,"_17922":102285,"_5":17817,"_24317":102007,"_2462":102286},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_2936":60594,"_25651":60481,"_17922":102288,"_5":17817,"_24317":102007,"_2462":102289},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_2936":60595,"_25651":60481,"_17922":102291,"_5":17817,"_24317":102007,"_2462":102292},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_2936":60596,"_25651":60481,"_17922":102294,"_5":17817,"_24317":102007,"_2462":102295},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_2936":60597,"_25651":60481,"_17922":102297,"_5":17817,"_24317":102007,"_2462":102298},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_2936":60598,"_25651":60481,"_17922":102300,"_5":17817,"_24317":102010,"_2462":102301},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_2936":60599,"_25651":60481,"_17922":102303,"_5":17817,"_24317":102013,"_2462":102304},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_2936":60600,"_25651":60481,"_17922":102306,"_5":17817,"_24317":102013,"_2462":102307},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_2936":60601,"_25651":60481,"_17922":102309,"_5":17817,"_24317":102017,"_2462":102310},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_2936":60602,"_25651":60481,"_17922":102312,"_5":17817,"_24317":102021,"_2462":102313},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_2936":60603,"_25651":60481,"_17922":102315,"_5":17817,"_24317":102021,"_2462":102316},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_2936":60604,"_25651":60481,"_17922":102318,"_5":17817,"_24317":102021,"_2462":102319},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_2936":60605,"_25651":60481,"_17922":102321,"_5":17817,"_24317":102021,"_2462":102322},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_2936":60606,"_25651":60481,"_17922":102324,"_5":17817,"_24317":102021,"_2462":102325},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_2936":60607,"_25651":60481,"_17922":102327,"_5":17817,"_24317":102021,"_2462":102328},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_2936":60608,"_25651":60481,"_17922":102330,"_5":17817,"_24317":102025,"_2462":102331},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_2936":60609,"_25651":60481,"_17922":102333,"_5":17817,"_24317":102025,"_2462":102334},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_2936":60610,"_25651":60481,"_17922":102336,"_5":17817,"_24317":102025,"_2462":102337},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_2936":60611,"_25651":60481,"_17922":102339,"_5":17817,"_24317":102029,"_2462":102340},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_2936":60612,"_25651":60481,"_17922":102342,"_5":17817,"_24317":102029,"_2462":102343},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_2936":60613,"_25651":60481,"_17922":102345,"_5":17817,"_24317":102029,"_2462":102346},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_2936":60614,"_25651":60481,"_17922":102348,"_5":17817,"_24317":102033,"_2462":102349},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_2936":60615,"_25651":60481,"_17922":102351,"_5":17817,"_24317":102033,"_2462":102352},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_2936":60616,"_25651":60481,"_17922":102354,"_5":17817,"_24317":102033,"_2462":102355},[],"Para que el flujo JITP funcione correctamente:",{"_2936":60617,"_25651":60481,"_17922":102357,"_5":17817,"_24317":102033,"_2462":102358},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_2936":60618,"_25651":60481,"_17922":102360,"_5":17817,"_24317":102033,"_2462":102361},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_2936":60619,"_25651":60481,"_17922":102363,"_5":17817,"_24317":102033,"_2462":102364},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_2936":60620,"_25651":60481,"_17922":102366,"_5":17817,"_24317":102033,"_2462":102367},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_2936":60621,"_25651":60481,"_17922":102369,"_5":17817,"_24317":102037,"_2462":102370},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_2936":60622,"_25651":60481,"_17922":102372,"_5":17817,"_24317":102037,"_2462":102373},[],"Estado en Lamassu",{"_2936":60623,"_25651":60481,"_17922":102375,"_5":17817,"_24317":102037,"_2462":102376},[],"Razón de revocación",{"_2936":60624,"_25651":60481,"_17922":102378,"_5":17817,"_24317":102037,"_2462":102379},[],"Estado en AWS IoT Core",{"_2936":60625,"_25651":60481,"_17922":102381,"_5":17817,"_24317":102037,"_2462":46039},[],{"_2936":60626,"_25651":60481,"_17922":102383,"_5":17817,"_24317":102037,"_2462":102384},[],"Ninguna",{"_2936":60627,"_25651":60481,"_17922":102386,"_5":17817,"_24317":102037,"_2462":46045},[],{"_2936":60628,"_25651":60481,"_17922":102388,"_5":17817,"_24317":102037,"_2462":46048},[],{"_2936":60629,"_25651":60481,"_17922":102390,"_5":17817,"_24317":102037,"_2462":46051},[],{"_2936":60630,"_25651":60481,"_17922":102392,"_5":17817,"_24317":102037,"_2462":46054},[],{"_2936":60631,"_25651":60481,"_17922":102394,"_5":17817,"_24317":102037,"_2462":46048},[],{"_2936":60632,"_25651":60481,"_17922":102396,"_5":17817,"_24317":102037,"_2462":102397},[],"Cualquier otra razón",{"_2936":60633,"_25651":60481,"_17922":102399,"_5":17817,"_24317":102037,"_2462":46062},[],{"_2936":60634,"_25651":60481,"_17922":102401,"_5":17817,"_24317":102037,"_2462":102402},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_2936":60635,"_25651":60481,"_17922":102404,"_5":17817,"_24317":102041,"_2462":102405},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_2936":60636,"_25651":60481,"_17922":102407,"_5":17817,"_24317":102041,"_2462":102408},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_2936":60637,"_25651":60481,"_17922":102410,"_5":17817,"_24317":102041,"_2462":102411},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_2936":60638,"_25651":60481,"_17922":102413,"_5":17817,"_24317":102045,"_2462":102414},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_2936":60639,"_25651":60481,"_17922":102416,"_5":17817,"_24317":102045,"_2462":102417},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_2936":60640,"_25651":60481,"_17922":102419,"_5":17817,"_24317":102049,"_2462":102420},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_2936":60641,"_25651":60481,"_17922":102422,"_5":17817,"_24317":102049,"_2462":102423},[],"Existen dos tipos de acciones:",{"_2936":60642,"_25651":60481,"_17922":102425,"_5":17817,"_24317":102049,"_2462":102426},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_2936":60643,"_25651":60481,"_17922":102428,"_5":17817,"_24317":102049,"_2462":102429},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_2936":60644,"_25651":60481,"_17922":102431,"_5":17817,"_24317":102049,"_2462":102432},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_2936":60645,"_25651":60481,"_17922":102434,"_5":17817,"_24317":102053,"_2462":102435},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_2936":60646,"_25651":60481,"_17922":102437,"_5":17817,"_24317":102053,"_2462":102438},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_2936":60647,"_25651":60481,"_17922":102440,"_5":17817,"_24317":102053,"_2462":102441},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_2936":60648,"_25651":60481,"_17922":102443,"_5":17817,"_24317":102057,"_2462":102444},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_2936":60649,"_25651":60481,"_17922":102446,"_5":17817,"_24317":102057,"_2462":102447},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_2936":60650,"_25651":60481,"_17922":102449,"_5":17817,"_24317":102057,"_2462":102450},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_2936":60651,"_25651":60481,"_17922":102452,"_5":17817,"_24317":102057,"_2462":102453},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_2936":60652,"_25651":60481,"_17922":102455,"_5":17817,"_24317":102057,"_2462":102456},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_2936":60653,"_25651":60481,"_17922":102458,"_5":17817,"_24317":102057,"_2462":102459},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_2936":60654,"_25651":60481,"_17922":102461,"_5":17817,"_24317":102057,"_2462":102462},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_2936":60655,"_25651":60481,"_17922":102464,"_5":17817,"_24317":102057,"_2462":102465},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_2936":60656,"_25651":60481,"_17922":102467,"_5":17817,"_24317":102057,"_2462":102468},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_2936":60657,"_25651":60481,"_17922":102470,"_5":17817,"_24317":102057,"_2462":102471},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_2936":60658,"_25651":60481,"_17922":102473,"_5":17817,"_24317":102057,"_2462":102474},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_2936":60659,"_25651":60481,"_17922":102476,"_5":17817,"_24317":102057,"_2462":102477},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_2936":60660,"_25651":60481,"_17922":102479,"_5":17817,"_24317":102057,"_2462":102480},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_2936":60661,"_25651":60481,"_17922":102482,"_5":17817,"_24317":102057,"_2462":102483},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_2936":60662,"_25651":60481,"_17922":102485,"_5":17817,"_24317":102057,"_2462":102486},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_2936":60663,"_25651":60481,"_17922":102488,"_5":17817,"_24317":102057,"_2462":102489},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_2936":60664,"_25651":60481,"_17922":102491,"_5":17817,"_24317":102057,"_2462":102492},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_2936":60665,"_25651":60481,"_17922":102494,"_5":17817,"_24317":102057,"_2462":102495},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_2936":60666,"_25651":60481,"_17922":102497,"_5":17817,"_24317":102057,"_2462":102498},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2936":60667,"_25651":60481,"_17922":102500,"_5":17817,"_24317":102057,"_2462":102501},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2936":60668,"_25651":60481,"_17922":102503,"_5":17817,"_24317":102057,"_2462":102504},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_2936":60669,"_25651":60669,"_5":12587,"_2462":44148,"_25975":102506,"_17922":102507,"_24317":60669},[41800,99602,44148],[],{"_2936":60670,"_25651":60669,"_17922":102509,"_5":17817,"_24317":60669,"_2462":102510},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_2936":60671,"_25651":60669,"_5":25972,"_17922":102512,"_24317":102513,"_2462":102514},[],"/docs/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_2936":60672,"_25651":60669,"_5":25972,"_17922":102516,"_24317":102517,"_2462":100574},[],"/docs/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_2936":60673,"_25651":60669,"_5":25972,"_17922":102519,"_24317":102520,"_2462":100749},[],"/docs/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_2936":60674,"_25651":60669,"_5":25972,"_17922":102522,"_24317":102523,"_2462":101976},[],"/docs/es/platform/iot-fleets/overview#integraciones",{"_2936":60675,"_25651":60669,"_5":25972,"_17922":102525,"_24317":102526,"_2462":102527},[],"/docs/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_2936":60676,"_25651":60669,"_17922":102529,"_5":17817,"_24317":60669,"_2462":102530},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_2936":60677,"_25651":60669,"_17922":102532,"_5":17817,"_24317":102513,"_2462":102533},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_2936":60678,"_25651":60669,"_17922":102535,"_5":17817,"_24317":102513,"_2462":102536},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_2936":60679,"_25651":60669,"_17922":102538,"_5":17817,"_24317":102517,"_2462":102539},[],"Recurso",{"_2936":60680,"_25651":60669,"_17922":102541,"_5":17817,"_24317":102517,"_2462":102542},[],"Qué representa",{"_2936":60681,"_25651":60669,"_17922":102544,"_5":17817,"_24317":102517,"_2462":102545},[],"**Dispositivo**",{"_2936":60682,"_25651":60669,"_17922":102547,"_5":17817,"_24317":102517,"_2462":102548},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_2936":60683,"_25651":60669,"_17922":102550,"_5":17817,"_24317":102517,"_2462":102551},[],"**Identidad**",{"_2936":60684,"_25651":60669,"_17922":102553,"_5":17817,"_24317":102517,"_2462":102554},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_2936":60685,"_25651":60669,"_17922":102556,"_5":17817,"_24317":102517,"_2462":46220},[],{"_2936":60686,"_25651":60669,"_17922":102558,"_5":17817,"_24317":102517,"_2462":102559},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_2936":60687,"_25651":60669,"_17922":102561,"_5":17817,"_24317":102517,"_2462":102562},[],"**Flota**",{"_2936":60688,"_25651":60669,"_17922":102564,"_5":17817,"_24317":102517,"_2462":102565},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_2936":60689,"_25651":60669,"_17922":102567,"_5":17817,"_24317":102517,"_2462":102568},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_2936":60690,"_25651":60669,"_17922":102570,"_5":17817,"_24317":102517,"_2462":102571},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_2936":60691,"_25651":60669,"_17922":102573,"_5":17817,"_24317":102520,"_2462":102574},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_2936":60692,"_25651":60669,"_17922":102576,"_5":17817,"_24317":102520,"_2462":102577},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_2936":60693,"_25651":60669,"_17922":102579,"_5":17817,"_24317":102520,"_2462":102580},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_2936":60694,"_25651":60669,"_17922":102582,"_5":17817,"_24317":102520,"_2462":102583},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_2936":60695,"_25651":60669,"_17922":102585,"_5":17817,"_24317":102520,"_2462":102586},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_2936":60696,"_25651":60669,"_17922":102588,"_5":17817,"_24317":102520,"_2462":102589},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_2936":60697,"_25651":60669,"_17922":102591,"_5":17817,"_24317":102520,"_2462":102592},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2936":60698,"_25651":60669,"_17922":102594,"_5":17817,"_24317":102520,"_2462":102595},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2936":60699,"_25651":60669,"_17922":102597,"_5":17817,"_24317":102523,"_2462":102598},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_2936":60700,"_25651":60669,"_17922":102600,"_5":17817,"_24317":102523,"_2462":102601},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_2936":60701,"_25651":60669,"_17922":102603,"_5":17817,"_24317":102526,"_2462":102604},[],"Participante",{"_2936":60702,"_25651":60669,"_17922":102606,"_5":17817,"_24317":102526,"_2462":102607},[],"Responsabilidad",{"_2936":60703,"_25651":60669,"_17922":102609,"_5":17817,"_24317":102526,"_2462":102610},[],"Administrador PKI",{"_2936":60704,"_25651":60669,"_17922":102612,"_5":17817,"_24317":102526,"_2462":102613},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_2936":60705,"_25651":60669,"_17922":102615,"_5":17817,"_24317":102526,"_2462":102616},[],"Administrador del aprovisionamiento",{"_2936":60706,"_25651":60669,"_17922":102618,"_5":17817,"_24317":102526,"_2462":102619},[],"DMS, admisión, autenticación por operación e inventario.",{"_2936":60707,"_25651":60669,"_17922":102621,"_5":17817,"_24317":102526,"_2462":102622},[],"Integrador del dispositivo",{"_2936":60708,"_25651":60669,"_17922":102624,"_5":17817,"_24317":102526,"_2462":102625},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_2936":60709,"_25651":60669,"_17922":102627,"_5":17817,"_24317":102526,"_2462":102628},[],"Integrador del consumidor",{"_2936":60710,"_25651":60669,"_17922":102630,"_5":17817,"_24317":102526,"_2462":102631},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_2936":60711,"_25651":60669,"_17922":102633,"_5":17817,"_24317":102526,"_2462":102634},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_2936":60712,"_25651":60712,"_5":12587,"_2462":102636,"_25975":102637,"_17922":102639,"_24317":60712},"Enrola y conecta tu primer dispositivo",[41800,99602,44148,102638],"Primeros pasos",[],{"_2936":60713,"_25651":60712,"_17922":102641,"_5":17817,"_24317":60712,"_2462":102642},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_2936":60714,"_25651":60712,"_5":25972,"_17922":102644,"_24317":102645,"_2462":98274},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_2936":60715,"_25651":60712,"_5":25972,"_17922":102647,"_24317":102648,"_2462":102649},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_2936":60716,"_25651":60712,"_5":25972,"_17922":102651,"_24317":102652,"_2462":102653},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_2936":60717,"_25651":60712,"_5":25972,"_17922":102655,"_24317":102656,"_2462":102657},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_2936":60718,"_25651":60712,"_5":25972,"_17922":102659,"_24317":102660,"_2462":102661},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_2936":60719,"_25651":60712,"_5":25972,"_17922":102663,"_24317":102664,"_2462":102665},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_2936":60720,"_25651":60712,"_5":25972,"_17922":102667,"_24317":102668,"_2462":102669},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_2936":60721,"_25651":60712,"_5":25972,"_17922":102671,"_24317":102672,"_2462":102673},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_2936":60722,"_25651":60712,"_17922":102675,"_5":17817,"_24317":60712,"_2462":102676},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_2936":60723,"_25651":60712,"_17922":102678,"_5":17817,"_24317":102645,"_2462":102679},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_2936":60724,"_25651":60712,"_17922":102681,"_5":17817,"_24317":102645,"_2462":102682},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_2936":60725,"_25651":60712,"_17922":102684,"_5":17817,"_24317":102645,"_2462":102685},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_2936":60726,"_25651":60712,"_17922":102687,"_5":17817,"_24317":102645,"_2462":102688},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_2936":60727,"_25651":60712,"_17922":102690,"_5":17817,"_24317":102645,"_2462":102691},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_2936":60728,"_25651":60712,"_17922":102693,"_5":17817,"_24317":102648,"_2462":102694},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_2936":60729,"_25651":60712,"_17922":102696,"_5":17817,"_24317":102648,"_2462":102697},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_2936":60730,"_25651":60712,"_17922":102699,"_5":17817,"_24317":102652,"_2462":102700},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_2936":60731,"_25651":60712,"_17922":102702,"_5":17817,"_24317":102652,"_2462":102703},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_2936":60732,"_25651":60712,"_17922":102705,"_5":17817,"_24317":102652,"_2462":102706},[],"Ajuste",{"_2936":60733,"_25651":60712,"_17922":102708,"_5":17817,"_24317":102652,"_2462":102709},[],"Valor de evaluación",{"_2936":60734,"_25651":60712,"_17922":102711,"_5":17817,"_24317":102652,"_2462":46376},[],{"_2936":60735,"_25651":60712,"_17922":102713,"_5":17817,"_24317":102652,"_2462":102714},[],"Raíz emisora de `device-root.pem`.",{"_2936":60736,"_25651":60712,"_17922":102716,"_5":17817,"_24317":102652,"_2462":100877},[],{"_2936":60737,"_25651":60712,"_17922":102718,"_5":17817,"_24317":102652,"_2462":102719},[],"Perfil final de 1 hora que acabas de preparar.",{"_2936":60738,"_25651":60712,"_17922":102721,"_5":17817,"_24317":102652,"_2462":46387},[],{"_2936":60739,"_25651":60712,"_17922":102723,"_5":17817,"_24317":102652,"_2462":46390},[],{"_2936":60740,"_25651":60712,"_17922":102725,"_5":17817,"_24317":102652,"_2462":46393},[],{"_2936":60741,"_25651":60712,"_17922":102727,"_5":17817,"_24317":102652,"_2462":102728},[],"Habilitado.",{"_2936":60742,"_25651":60712,"_17922":102730,"_5":17817,"_24317":102652,"_2462":46399},[],{"_2936":60743,"_25651":60712,"_17922":102732,"_5":17817,"_24317":102652,"_2462":102733},[],"Deshabilitado; el ID debe ser nuevo.",{"_2936":60744,"_25651":60712,"_17922":102735,"_5":17817,"_24317":102652,"_2462":102736},[],"Autenticación inicial",{"_2936":60745,"_25651":60712,"_17922":102738,"_5":17817,"_24317":102652,"_2462":102739},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_2936":60746,"_25651":60712,"_17922":102741,"_5":17817,"_24317":102652,"_2462":102742},[],"Autenticación de renovación",{"_2936":60747,"_25651":60712,"_17922":102744,"_5":17817,"_24317":102652,"_2462":102745},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_2936":60748,"_25651":60712,"_17922":102747,"_5":17817,"_24317":102652,"_2462":46417},[],{"_2936":60749,"_25651":60712,"_17922":102749,"_5":17817,"_24317":102652,"_2462":102750},[],"Lista vacía para esta emisión directa / deshabilitado.",{"_2936":60750,"_25651":60712,"_17922":102752,"_5":17817,"_24317":102652,"_2462":46423},[],{"_2936":60751,"_25651":60712,"_17922":102754,"_5":17817,"_24317":102652,"_2462":102755},[],"1 hora.",{"_2936":60752,"_25651":60712,"_17922":102757,"_5":17817,"_24317":102652,"_2462":46429},[],{"_2936":60753,"_25651":60712,"_17922":102759,"_5":17817,"_24317":102652,"_2462":102760},[],"30 minutos / 10 minutos.",{"_2936":60754,"_25651":60712,"_17922":102762,"_5":17817,"_24317":102652,"_2462":46435},[],{"_2936":60755,"_25651":60712,"_17922":102764,"_5":17817,"_24317":102652,"_2462":102765},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_2936":60756,"_25651":60712,"_17922":102767,"_5":17817,"_24317":102652,"_2462":44467},[],{"_2936":60757,"_25651":60712,"_17922":102769,"_5":17817,"_24317":102652,"_2462":102770},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_2936":60758,"_25651":60712,"_17922":102772,"_5":17817,"_24317":102652,"_2462":46446},[],{"_2936":60759,"_25651":60712,"_17922":102774,"_5":17817,"_24317":102652,"_2462":102775},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_2936":60760,"_25651":60712,"_17922":102777,"_5":17817,"_24317":102652,"_2462":102778},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. Si tu consola no expone el bloque independiente, configura y comprueba el recurso mediante la API DMS y la guía DMS.",{"_2936":60761,"_25651":60712,"_17922":102780,"_5":17817,"_24317":102656,"_2462":102781},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_2936":60762,"_25651":60712,"_17922":102783,"_5":17817,"_24317":102656,"_2462":102784},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_2936":60763,"_25651":60712,"_17922":102786,"_5":17817,"_24317":102660,"_2462":102787},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_2936":60764,"_25651":60712,"_17922":102789,"_5":17817,"_24317":102660,"_2462":102790},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_2936":60765,"_25651":60712,"_17922":102792,"_5":17817,"_24317":102660,"_2462":102793},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_2936":60766,"_25651":60712,"_17922":102795,"_5":17817,"_24317":102664,"_2462":102796},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_2936":60767,"_25651":60712,"_17922":102798,"_5":17817,"_24317":102664,"_2462":102799},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_2936":60768,"_25651":60712,"_17922":102801,"_5":17817,"_24317":102668,"_2462":102802},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_2936":60769,"_25651":60712,"_17922":102804,"_5":17817,"_24317":102668,"_2462":102805},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_2936":60770,"_25651":60712,"_17922":102807,"_5":17817,"_24317":102668,"_2462":102808},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_2936":60771,"_25651":60712,"_17922":102810,"_5":17817,"_24317":102668,"_2462":102811},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_2936":60772,"_25651":60712,"_17922":102813,"_5":17817,"_24317":102668,"_2462":102814},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_2936":60773,"_25651":60712,"_17922":102816,"_5":17817,"_24317":102672,"_2462":102817},[],"Comprobación",{"_2936":60774,"_25651":60712,"_17922":102819,"_5":17817,"_24317":102672,"_2462":102820},[],"Resultado esperado",{"_2936":60775,"_25651":60712,"_17922":102822,"_5":17817,"_24317":102672,"_2462":102823},[],"Registro",{"_2936":60776,"_25651":60712,"_17922":102825,"_5":17817,"_24317":102672,"_2462":102826},[],"ID creado automáticamente y DMS correcto.",{"_2936":60777,"_25651":60712,"_17922":102828,"_5":17817,"_24317":102672,"_2462":102829},[],"Certificado",{"_2936":60778,"_25651":60712,"_17922":102831,"_5":17817,"_24317":102672,"_2462":102832},[],"CN, perfil, serie y clave verificados.",{"_2936":60779,"_25651":60712,"_17922":102834,"_5":17817,"_24317":102672,"_2462":102835},[],"Inventario",{"_2936":60780,"_25651":60712,"_17922":102837,"_5":17817,"_24317":102672,"_2462":102838},[],"Serie recibida visible como identidad actual y en el historial.",{"_2936":60781,"_25651":60712,"_17922":102840,"_5":17817,"_24317":102672,"_2462":102841},[],"Consumidor",{"_2936":60782,"_25651":60712,"_17922":102843,"_5":17817,"_24317":102672,"_2462":102844},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_2936":60783,"_25651":60712,"_17922":102846,"_5":17817,"_24317":102672,"_2462":102847},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_2936":60784,"_25651":60712,"_17922":102849,"_5":17817,"_24317":102672,"_2462":102850},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_2936":60785,"_25651":60785,"_5":12587,"_2462":100591,"_25975":102852,"_17922":102853,"_24317":60785},[41800,99602,44148,102638],[],{"_2936":60786,"_25651":60785,"_17922":102855,"_5":17817,"_24317":60785,"_2462":102856},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_2936":60787,"_25651":60785,"_5":25972,"_17922":102858,"_24317":102859,"_2462":98274},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_2936":60788,"_25651":60785,"_5":25972,"_17922":102861,"_24317":102862,"_2462":102863},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_2936":60789,"_25651":60785,"_5":25972,"_17922":102865,"_24317":102866,"_2462":102867},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_2936":60790,"_25651":60785,"_5":25972,"_17922":102869,"_24317":102870,"_2462":102871},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_2936":60791,"_25651":60785,"_5":25972,"_17922":102873,"_24317":102874,"_2462":102875},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_2936":60792,"_25651":60785,"_5":25972,"_17922":102877,"_24317":102878,"_2462":102879},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_2936":60793,"_25651":60785,"_5":25972,"_17922":102881,"_24317":102882,"_2462":102820},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_2936":60794,"_25651":60785,"_5":25972,"_17922":102884,"_24317":102885,"_2462":102886},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_2936":60795,"_25651":60785,"_5":25972,"_17922":102888,"_24317":102889,"_2462":102890},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_2936":60796,"_25651":60785,"_17922":102892,"_5":17817,"_24317":60785,"_2462":102893},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_2936":60797,"_25651":60785,"_17922":102895,"_5":17817,"_24317":60785,"_2462":102896},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_2936":60798,"_25651":60785,"_17922":102898,"_5":17817,"_24317":102859,"_2462":102899},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_2936":60799,"_25651":60785,"_17922":102901,"_5":17817,"_24317":102859,"_2462":102902},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_2936":60800,"_25651":60785,"_17922":102904,"_5":17817,"_24317":102859,"_2462":102905},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_2936":60801,"_25651":60785,"_17922":102907,"_5":17817,"_24317":102859,"_2462":102908},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_2936":60802,"_25651":60785,"_17922":102910,"_5":17817,"_24317":102862,"_2462":102911},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_2936":60803,"_25651":60785,"_17922":102913,"_5":17817,"_24317":102862,"_2462":102914},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_2936":60804,"_25651":60785,"_17922":102916,"_5":17817,"_24317":102862,"_2462":102917},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_2936":60805,"_25651":60785,"_17922":102919,"_5":17817,"_24317":102862,"_2462":102920},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_2936":60806,"_25651":60785,"_17922":102922,"_5":17817,"_24317":102862,"_2462":102923},[],"Configura **Authentication Mode** como `CLIENT_CERTIFICATE` y añade en **Validation CAs** la CA cuyos certificados iniciales aceptarás. Para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deshabilitada la generación de claves en servidor si no la vas a utilizar.",{"_2936":60807,"_25651":60785,"_17922":102925,"_5":17817,"_24317":102862,"_2462":102926},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_2936":60808,"_25651":60785,"_17922":102928,"_5":17817,"_24317":102862,"_2462":102929},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_2936":60809,"_25651":60785,"_17922":102931,"_5":17817,"_24317":102862,"_2462":102932},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_2936":60810,"_25651":60785,"_17922":102934,"_5":17817,"_24317":102866,"_2462":102935},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_2936":60811,"_25651":60785,"_17922":102937,"_5":17817,"_24317":102866,"_2462":46612},[],{"_2936":60812,"_25651":60785,"_17922":102939,"_5":17817,"_24317":102866,"_2462":102940},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_2936":60813,"_25651":60785,"_17922":102942,"_5":17817,"_24317":102866,"_2462":102943},[],"**Icon** y **Tags**: clasificación opcional.",{"_2936":60814,"_25651":60785,"_17922":102945,"_5":17817,"_24317":102866,"_2462":102946},[],"Confirma el registro.",{"_2936":60815,"_25651":60785,"_17922":102948,"_5":17817,"_24317":102870,"_2462":102949},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_2936":60816,"_25651":60785,"_17922":102951,"_5":17817,"_24317":102870,"_2462":102952},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_2936":60817,"_25651":60785,"_17922":102954,"_5":17817,"_24317":102874,"_2462":102955},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_2936":60818,"_25651":60785,"_17922":102957,"_5":17817,"_24317":102874,"_2462":102958},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_2936":60819,"_25651":60785,"_17922":102960,"_5":17817,"_24317":102878,"_2462":102961},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_2936":60820,"_25651":60785,"_17922":102963,"_5":17817,"_24317":102878,"_2462":102964},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_2936":60821,"_25651":60785,"_17922":102966,"_5":17817,"_24317":102882,"_2462":102817},[],{"_2936":60822,"_25651":60785,"_17922":102968,"_5":17817,"_24317":102882,"_2462":102969},[],"Resultado",{"_2936":60823,"_25651":60785,"_17922":102971,"_5":17817,"_24317":102882,"_2462":102972},[],"Dispositivo",{"_2936":60824,"_25651":60785,"_17922":102974,"_5":17817,"_24317":102882,"_2462":102975},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_2936":60825,"_25651":60785,"_17922":102977,"_5":17817,"_24317":102882,"_2462":102978},[],"Identidad actual",{"_2936":60826,"_25651":60785,"_17922":102980,"_5":17817,"_24317":102882,"_2462":102981},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_2936":60827,"_25651":60785,"_17922":102983,"_5":17817,"_24317":102882,"_2462":102984},[],"Historial",{"_2936":60828,"_25651":60785,"_17922":102986,"_5":17817,"_24317":102882,"_2462":102987},[],"La emisión asociada aparece con su número de serie y fechas.",{"_2936":60829,"_25651":60785,"_17922":102989,"_5":17817,"_24317":102882,"_2462":102990},[],"Clave y certificado",{"_2936":60830,"_25651":60785,"_17922":102992,"_5":17817,"_24317":102882,"_2462":102993},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_2936":60831,"_25651":60785,"_17922":102995,"_5":17817,"_24317":102885,"_2462":102996},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_2936":60832,"_25651":60785,"_17922":102998,"_5":17817,"_24317":102885,"_2462":102999},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_2936":60833,"_25651":60785,"_17922":103001,"_5":17817,"_24317":102885,"_2462":103002},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_2936":60834,"_25651":60785,"_17922":103004,"_5":17817,"_24317":102885,"_2462":103005},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_2936":60835,"_25651":60785,"_17922":103007,"_5":17817,"_24317":102889,"_2462":103008},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_2936":60836,"_25651":60785,"_17922":103010,"_5":17817,"_24317":102889,"_2462":103011},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_2936":60837,"_25651":60785,"_17922":103013,"_5":17817,"_24317":102889,"_2462":103014},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_2936":60838,"_25651":60838,"_5":12587,"_2462":103016,"_25975":103017,"_17922":103018,"_24317":60838},"Plataforma Lamassu IoT",[41800,99602],[],{"_2936":60839,"_25651":60838,"_17922":103020,"_5":17817,"_24317":60838,"_2462":103021},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_2936":60840,"_25651":60838,"_5":25972,"_17922":103023,"_24317":103024,"_2462":102514},[],"/docs/es/platform/overview#empieza-aquí",{"_2936":60841,"_25651":60838,"_5":25972,"_17922":103026,"_24317":103027,"_2462":103028},[],"/docs/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_2936":60842,"_25651":60838,"_5":25972,"_17922":103030,"_24317":103031,"_2462":103032},[],"/docs/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_2936":60843,"_25651":60838,"_5":25972,"_17922":103034,"_24317":103035,"_2462":103036},[],"/docs/es/platform/overview#capacidades-principales","Capacidades principales",{"_2936":60844,"_25651":60838,"_5":25972,"_17922":103038,"_24317":103039,"_2462":103040},[],"/docs/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_2936":60845,"_25651":60838,"_5":25972,"_17922":103042,"_24317":103043,"_2462":103044},[],"/docs/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_2936":60846,"_25651":60838,"_5":25972,"_17922":103046,"_24317":103047,"_2462":103048},[],"/docs/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_2936":60847,"_25651":60838,"_5":25972,"_17922":103050,"_24317":103051,"_2462":103052},[],"/docs/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_2936":60848,"_25651":60838,"_5":25972,"_17922":103054,"_24317":103055,"_2462":103056},[],"/docs/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_2936":60849,"_25651":60838,"_5":25972,"_17922":103058,"_24317":103059,"_2462":103060},[],"/docs/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_2936":60850,"_25651":60838,"_5":25972,"_17922":103062,"_24317":103063,"_2462":103064},[],"/docs/es/platform/overview#referencia-operativa","Referencia operativa",{"_2936":60851,"_25651":60838,"_17922":103066,"_5":17817,"_24317":60838,"_2462":103067},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_2936":60852,"_25651":60838,"_17922":103069,"_5":17817,"_24317":103024,"_2462":103070},[],"Elige el resultado que necesitas obtener:",{"_2936":60853,"_25651":60838,"_17922":103072,"_5":17817,"_24317":103024,"_2462":103073},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2936":60854,"_25651":60838,"_17922":103075,"_5":17817,"_24317":103024,"_2462":103076},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2936":60855,"_25651":60838,"_17922":103078,"_5":17817,"_24317":103024,"_2462":103079},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_2936":60856,"_25651":60838,"_17922":103081,"_5":17817,"_24317":103027,"_2462":103082},[],"Bloque",{"_2936":60857,"_25651":60838,"_17922":103084,"_5":17817,"_24317":103027,"_2462":103085},[],"Qué gestionas",{"_2936":60858,"_25651":60838,"_17922":103087,"_5":17817,"_24317":103027,"_2462":103088},[],"Punto de entrada",{"_2936":60859,"_25651":60838,"_17922":103090,"_5":17817,"_24317":103027,"_2462":46766},[],{"_2936":60860,"_25651":60838,"_17922":103092,"_5":17817,"_24317":103027,"_2462":103093},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_2936":60861,"_25651":60838,"_17922":103095,"_5":17817,"_24317":103027,"_2462":103096},[],"Visión general de PKI",{"_2936":60862,"_25651":60838,"_17922":103098,"_5":17817,"_24317":103027,"_2462":46775},[],{"_2936":60863,"_25651":60838,"_17922":103100,"_5":17817,"_24317":103027,"_2462":103101},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_2936":60864,"_25651":60838,"_17922":103103,"_5":17817,"_24317":103027,"_2462":103104},[],"Visión general de IoT Fleets",{"_2936":60865,"_25651":60838,"_17922":103106,"_5":17817,"_24317":103027,"_2462":103107},[],"**Administración**",{"_2936":60866,"_25651":60838,"_17922":103109,"_5":17817,"_24317":103027,"_2462":103110},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_2936":60867,"_25651":60838,"_17922":103112,"_5":17817,"_24317":103027,"_2462":99600},[],{"_2936":60868,"_25651":60838,"_17922":103114,"_5":17817,"_24317":103027,"_2462":103115},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_2936":60869,"_25651":60838,"_17922":103117,"_5":17817,"_24317":103031,"_2462":103118},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_2936":60870,"_25651":60838,"_17922":103120,"_5":17817,"_24317":103031,"_2462":103121},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_2936":60871,"_25651":60838,"_17922":103123,"_5":17817,"_24317":103031,"_2462":103124},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_2936":60872,"_25651":60838,"_17922":103126,"_5":17817,"_24317":103031,"_2462":103127},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_2936":60873,"_25651":60838,"_17922":103129,"_5":17817,"_24317":103031,"_2462":103130},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_2936":60874,"_25651":60838,"_17922":103132,"_5":17817,"_24317":103031,"_2462":103133},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_2936":60875,"_25651":60838,"_17922":103135,"_5":17817,"_24317":103039,"_2462":103136},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_2936":60876,"_25651":60838,"_17922":103138,"_5":17817,"_24317":103043,"_2462":103139},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_2936":60877,"_25651":60838,"_17922":103141,"_5":17817,"_24317":103047,"_2462":103142},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_2936":60878,"_25651":60838,"_17922":103144,"_5":17817,"_24317":103051,"_2462":103145},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_2936":60879,"_25651":60838,"_17922":103147,"_5":17817,"_24317":103055,"_2462":103148},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_2936":60880,"_25651":60838,"_17922":103150,"_5":17817,"_24317":103059,"_2462":103151},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_2936":60881,"_25651":60838,"_17922":103153,"_5":17817,"_24317":103063,"_2462":102607},[],{"_2936":60882,"_25651":60838,"_17922":103155,"_5":17817,"_24317":103063,"_2462":103156},[],"Qué prepara o comprueba",{"_2936":60883,"_25651":60838,"_17922":103158,"_5":17817,"_24317":103063,"_2462":102610},[],{"_2936":60884,"_25651":60838,"_17922":103160,"_5":17817,"_24317":103063,"_2462":103161},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_2936":60885,"_25651":60838,"_17922":103163,"_5":17817,"_24317":103063,"_2462":103164},[],"Administrador de la flota",{"_2936":60886,"_25651":60838,"_17922":103166,"_5":17817,"_24317":103063,"_2462":103167},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_2936":60887,"_25651":60838,"_17922":103169,"_5":17817,"_24317":103063,"_2462":102622},[],{"_2936":60888,"_25651":60838,"_17922":103171,"_5":17817,"_24317":103063,"_2462":103172},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_2936":60889,"_25651":60838,"_17922":103174,"_5":17817,"_24317":103063,"_2462":102628},[],{"_2936":60890,"_25651":60838,"_17922":103176,"_5":17817,"_24317":103063,"_2462":103177},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_2936":60891,"_25651":60838,"_17922":103179,"_5":17817,"_24317":103063,"_2462":103180},[],"Operador de infraestructura",{"_2936":60892,"_25651":60838,"_17922":103182,"_5":17817,"_24317":103063,"_2462":103183},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_2936":60893,"_25651":60838,"_17922":103185,"_5":17817,"_24317":103063,"_2462":103186},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_2936":60894,"_25651":60894,"_5":12587,"_2462":103188,"_25975":103189,"_17922":103191,"_24317":60894},"Jerarquía y rotación de CAs",[41800,99602,46867,103190],"Claves, autoridades y certificados",[],{"_2936":60895,"_25651":60894,"_17922":103193,"_5":17817,"_24317":60894,"_2462":103194},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_2936":60896,"_25651":60894,"_5":25972,"_17922":103196,"_24317":103197,"_2462":103198},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_2936":60897,"_25651":60894,"_5":25972,"_17922":103200,"_24317":103201,"_2462":103202},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_2936":60898,"_25651":60894,"_5":25972,"_17922":103204,"_24317":103205,"_2462":103206},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_2936":60899,"_25651":60894,"_5":25972,"_17922":103208,"_24317":103209,"_2462":103210},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_2936":60900,"_25651":60894,"_5":25972,"_17922":103212,"_24317":103213,"_2462":103214},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_2936":60901,"_25651":60894,"_5":25972,"_17922":103216,"_24317":103217,"_2462":103218},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_2936":60902,"_25651":60894,"_5":25972,"_17922":103220,"_24317":103221,"_2462":103222},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_2936":60903,"_25651":60894,"_5":25972,"_17922":103224,"_24317":103225,"_2462":103226},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_2936":60904,"_25651":60894,"_5":25972,"_17922":103228,"_24317":103229,"_2462":103230},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_2936":60905,"_25651":60894,"_5":25972,"_17922":103232,"_24317":103233,"_2462":103234},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_2936":60906,"_25651":60894,"_5":25972,"_17922":103236,"_24317":103237,"_2462":103238},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_2936":60907,"_25651":60894,"_5":25972,"_17922":103240,"_24317":103241,"_2462":103242},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_2936":60908,"_25651":60894,"_17922":103244,"_5":17817,"_24317":60894,"_2462":103245},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_2936":60909,"_25651":60894,"_17922":103247,"_5":17817,"_24317":60894,"_2462":103248},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_2936":60910,"_25651":60894,"_17922":103250,"_5":17817,"_24317":103197,"_2462":103251},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_2936":60911,"_25651":60894,"_17922":103253,"_5":17817,"_24317":103197,"_2462":103254},[],"entorno, como producción y preproducción;",{"_2936":60912,"_25651":60894,"_17922":103256,"_5":17817,"_24317":103197,"_2462":103257},[],"propietario o equipo operador;",{"_2936":60913,"_25651":60894,"_17922":103259,"_5":17817,"_24317":103197,"_2462":103260},[],"familia de dispositivos o proceso de fabricación;",{"_2936":60914,"_25651":60894,"_17922":103262,"_5":17817,"_24317":103197,"_2462":103263},[],"región o requisito regulatorio;",{"_2936":60915,"_25651":60894,"_17922":103265,"_5":17817,"_24317":103197,"_2462":103266},[],"motor criptográfico o política de clave;",{"_2936":60916,"_25651":60894,"_17922":103268,"_5":17817,"_24317":103197,"_2462":103269},[],"ventana de mantenimiento y ritmo de renovación.",{"_2936":60917,"_25651":60894,"_17922":103271,"_5":17817,"_24317":103197,"_2462":103272},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_2936":60918,"_25651":60894,"_17922":103274,"_5":17817,"_24317":103197,"_2462":103275},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_2936":60919,"_25651":60894,"_17922":103277,"_5":17817,"_24317":103201,"_2462":103278},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_2936":60920,"_25651":60894,"_17922":103280,"_5":17817,"_24317":103201,"_2462":103281},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_2936":60921,"_25651":60894,"_17922":103283,"_5":17817,"_24317":103201,"_2462":103284},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_2936":60922,"_25651":60894,"_17922":103286,"_5":17817,"_24317":103205,"_2462":103287},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_2936":60923,"_25651":60894,"_17922":103289,"_5":17817,"_24317":103205,"_2462":103290},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_2936":60924,"_25651":60894,"_17922":103292,"_5":17817,"_24317":103205,"_2462":103293},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_2936":60925,"_25651":60894,"_17922":103295,"_5":17817,"_24317":103205,"_2462":103296},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_2936":60926,"_25651":60894,"_17922":103298,"_5":17817,"_24317":103213,"_2462":103299},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_2936":60927,"_25651":60894,"_17922":103301,"_5":17817,"_24317":103217,"_2462":103302},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_2936":60928,"_25651":60894,"_17922":103304,"_5":17817,"_24317":103221,"_2462":103305},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_2936":60929,"_25651":60894,"_17922":103307,"_5":17817,"_24317":103225,"_2462":103308},[],"Actualiza la CA de enrolamiento y el perfil de los DMS y añade la CA anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS mientras sigan renovando cohortes con certificados antiguos. La guía DMS documenta ese ajuste.",{"_2936":60930,"_25651":60894,"_17922":103310,"_5":17817,"_24317":103229,"_2462":103311},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_2936":60931,"_25651":60894,"_17922":103313,"_5":17817,"_24317":103233,"_2462":103314},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión y de las CAs distribuidas. Revócala si la política lo exige.",{"_2936":60932,"_25651":60894,"_17922":103316,"_5":17817,"_24317":103237,"_2462":103317},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_2936":60933,"_25651":60894,"_17922":103319,"_5":17817,"_24317":103237,"_2462":103320},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_2936":60934,"_25651":60894,"_17922":103322,"_5":17817,"_24317":103237,"_2462":103323},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_2936":60935,"_25651":60894,"_17922":103325,"_5":17817,"_24317":103237,"_2462":103326},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_2936":60936,"_25651":60894,"_17922":103328,"_5":17817,"_24317":103241,"_2462":103329},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_2936":60937,"_25651":60894,"_17922":103331,"_5":17817,"_24317":103241,"_2462":103332},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_2936":60938,"_25651":60894,"_17922":103334,"_5":17817,"_24317":103241,"_2462":103335},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_2936":60939,"_25651":60894,"_17922":103337,"_5":17817,"_24317":103241,"_2462":103338},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_2936":60940,"_25651":60894,"_17922":103340,"_5":17817,"_24317":103241,"_2462":103341},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_2936":60941,"_25651":60894,"_17922":103343,"_5":17817,"_24317":103241,"_2462":103344},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_2936":60942,"_25651":60894,"_17922":103346,"_5":17817,"_24317":103241,"_2462":103347},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_2936":60943,"_25651":60943,"_5":12587,"_2462":103349,"_25975":103350,"_17922":103351,"_24317":60943},"Autoridades de certificación",[41800,99602,46867,103190],[],{"_2936":60944,"_25651":60943,"_17922":103353,"_5":17817,"_24317":60943,"_2462":103354},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_2936":60945,"_25651":60943,"_5":25972,"_17922":103356,"_24317":103357,"_2462":103358},[],"/docs/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_2936":60946,"_25651":60943,"_5":25972,"_17922":103360,"_24317":103361,"_2462":103362},[],"/docs/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_2936":60947,"_25651":60943,"_5":25972,"_17922":103364,"_24317":103365,"_2462":98274},[],"/docs/es/platform/pki/certificate-authorities#antes-de-empezar",{"_2936":60948,"_25651":60943,"_5":25972,"_17922":103367,"_24317":103368,"_2462":103369},[],"/docs/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_2936":60949,"_25651":60943,"_5":25972,"_17922":103371,"_24317":103372,"_2462":103373},[],"/docs/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_2936":60950,"_25651":60943,"_5":25972,"_17922":103375,"_24317":103376,"_2462":103377},[],"/docs/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_2936":60951,"_25651":60943,"_5":25972,"_17922":103379,"_24317":103380,"_2462":103381},[],"/docs/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_2936":60952,"_25651":60943,"_5":25972,"_17922":103383,"_24317":103384,"_2462":103385},[],"/docs/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_2936":60953,"_25651":60943,"_5":25972,"_17922":103387,"_24317":103388,"_2462":103389},[],"/docs/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_2936":60954,"_25651":60943,"_5":25972,"_17922":103391,"_24317":103392,"_2462":103393},[],"/docs/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_2936":60955,"_25651":60943,"_5":25972,"_17922":103395,"_24317":103396,"_2462":103397},[],"/docs/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_2936":60956,"_25651":60943,"_5":25972,"_17922":103399,"_24317":103400,"_2462":103401},[],"/docs/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_2936":60957,"_25651":60943,"_5":25972,"_17922":103403,"_24317":103404,"_2462":103405},[],"/docs/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_2936":60958,"_25651":60943,"_5":25972,"_17922":103407,"_24317":103408,"_2462":103409},[],"/docs/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_2936":60959,"_25651":60943,"_5":25972,"_17922":103411,"_24317":103412,"_2462":103413},[],"/docs/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_2936":60960,"_25651":60943,"_5":25972,"_17922":103415,"_24317":103416,"_2462":103417},[],"/docs/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_2936":60961,"_25651":60943,"_5":25972,"_17922":103419,"_24317":103420,"_2462":103421},[],"/docs/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_2936":60962,"_25651":60943,"_5":25972,"_17922":103423,"_24317":103424,"_2462":103425},[],"/docs/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_2936":60963,"_25651":60943,"_5":25972,"_17922":103427,"_24317":103428,"_2462":103429},[],"/docs/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_2936":60964,"_25651":60943,"_5":25972,"_17922":103431,"_24317":103432,"_2462":103433},[],"/docs/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_2936":60965,"_25651":60943,"_5":25972,"_17922":103435,"_24317":103436,"_2462":103437},[],"/docs/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_2936":60966,"_25651":60943,"_5":25972,"_17922":103439,"_24317":103440,"_2462":103441},[],"/docs/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_2936":60967,"_25651":60943,"_17922":103443,"_5":17817,"_24317":60943,"_2462":103444},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_2936":60968,"_25651":60943,"_17922":103446,"_5":17817,"_24317":60943,"_2462":103447},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_2936":60969,"_25651":60943,"_17922":103449,"_5":17817,"_24317":60943,"_2462":103450},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_2936":60970,"_25651":60943,"_17922":103452,"_5":17817,"_24317":103357,"_2462":103453},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_2936":60971,"_25651":60943,"_17922":103455,"_5":17817,"_24317":103357,"_2462":103456},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_2936":60972,"_25651":60943,"_17922":103458,"_5":17817,"_24317":103357,"_2462":103459},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_2936":60973,"_25651":60943,"_17922":103461,"_5":17817,"_24317":103357,"_2462":103462},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_2936":60974,"_25651":60943,"_17922":103464,"_5":17817,"_24317":103357,"_2462":103465},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_2936":60975,"_25651":60943,"_17922":103467,"_5":17817,"_24317":103365,"_2462":103468},[],"Decide si la CA será raíz o intermedia.",{"_2936":60976,"_25651":60943,"_17922":103470,"_5":17817,"_24317":103365,"_2462":103471},[],"Elige el motor que custodiará la clave.",{"_2936":60977,"_25651":60943,"_17922":103473,"_5":17817,"_24317":103365,"_2462":103474},[],"Define una validez superior a la de los certificados que emitirá.",{"_2936":60978,"_25651":60943,"_17922":103476,"_5":17817,"_24317":103365,"_2462":103477},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_2936":60979,"_25651":60943,"_17922":103479,"_5":17817,"_24317":103368,"_2462":103480},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_2936":60980,"_25651":60943,"_17922":103482,"_5":17817,"_24317":103372,"_2462":103483},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_2936":60981,"_25651":60943,"_17922":103485,"_5":17817,"_24317":103372,"_2462":103486},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_2936":60982,"_25651":60943,"_17922":103488,"_5":17817,"_24317":103376,"_2462":103489},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_2936":60983,"_25651":60943,"_17922":103491,"_5":17817,"_24317":103380,"_2462":103492},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_2936":60984,"_25651":60943,"_17922":103494,"_5":17817,"_24317":103380,"_2462":103495},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_2936":60985,"_25651":60943,"_17922":103497,"_5":17817,"_24317":103380,"_2462":103498},[],"`ST`: estado o provincia.",{"_2936":60986,"_25651":60943,"_17922":103500,"_5":17817,"_24317":103380,"_2462":103501},[],"`L`: localidad.",{"_2936":60987,"_25651":60943,"_17922":103503,"_5":17817,"_24317":103380,"_2462":103504},[],"`O`: organización.",{"_2936":60988,"_25651":60943,"_17922":103506,"_5":17817,"_24317":103380,"_2462":103507},[],"`OU`: unidad organizativa.",{"_2936":60989,"_25651":60943,"_17922":103509,"_5":17817,"_24317":103380,"_2462":103510},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_2936":60990,"_25651":60943,"_17922":103512,"_5":17817,"_24317":103384,"_2462":103513},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_2936":60991,"_25651":60943,"_17922":103515,"_5":17817,"_24317":103384,"_2462":103516},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_2936":60992,"_25651":60943,"_17922":103518,"_5":17817,"_24317":103388,"_2462":103519},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_2936":60993,"_25651":60943,"_17922":103521,"_5":17817,"_24317":103388,"_2462":103522},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_2936":60994,"_25651":60943,"_17922":103524,"_5":17817,"_24317":103392,"_2462":103525},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_2936":60995,"_25651":60943,"_17922":103527,"_5":17817,"_24317":103392,"_2462":103528},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_2936":60996,"_25651":60943,"_17922":103530,"_5":17817,"_24317":103396,"_2462":103531},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_2936":60997,"_25651":60943,"_17922":103533,"_5":17817,"_24317":103400,"_2462":103534},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_2936":60998,"_25651":60943,"_17922":103536,"_5":17817,"_24317":103404,"_2462":103537},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_2936":60999,"_25651":60943,"_17922":103539,"_5":17817,"_24317":103408,"_2462":103540},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_2936":61000,"_25651":60943,"_17922":103542,"_5":17817,"_24317":103412,"_2462":103543},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_2936":61001,"_25651":60943,"_17922":103545,"_5":17817,"_24317":103412,"_2462":103546},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_2936":61002,"_25651":60943,"_17922":103548,"_5":17817,"_24317":103416,"_2462":103549},[],"Abre una CA desde el inventario para consultar:",{"_2936":61003,"_25651":60943,"_17922":103551,"_5":17817,"_24317":103416,"_2462":103552},[],"Estado y periodo de validez.",{"_2936":61004,"_25651":60943,"_17922":103554,"_5":17817,"_24317":103416,"_2462":103555},[],"Certificado y cadena en formato PEM.",{"_2936":61005,"_25651":60943,"_17922":103557,"_5":17817,"_24317":103416,"_2462":103558},[],"Número de certificados activos, expirados y revocados.",{"_2936":61006,"_25651":60943,"_17922":103560,"_5":17817,"_24317":103416,"_2462":103561},[],"Certificados emitidos en **Issued Certificates**.",{"_2936":61007,"_25651":60943,"_17922":103563,"_5":17817,"_24317":103416,"_2462":103564},[],"CRL vinculada a la autoridad.",{"_2936":61008,"_25651":60943,"_17922":103566,"_5":17817,"_24317":103416,"_2462":103567},[],"Metadatos y motor criptográfico asociado.",{"_2936":61009,"_25651":60943,"_17922":103569,"_5":17817,"_24317":103416,"_2462":103570},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_2936":61010,"_25651":60943,"_17922":103572,"_5":17817,"_24317":103420,"_2462":103573},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_2936":61011,"_25651":60943,"_17922":103575,"_5":17817,"_24317":103420,"_2462":103576},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_2936":61012,"_25651":60943,"_17922":103578,"_5":17817,"_24317":103420,"_2462":103579},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_2936":61013,"_25651":60943,"_17922":103581,"_5":17817,"_24317":103420,"_2462":103582},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_2936":61014,"_25651":60943,"_17922":103584,"_5":17817,"_24317":103424,"_2462":103585},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_2936":61015,"_25651":60943,"_17922":103587,"_5":17817,"_24317":103428,"_2462":103588},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_2936":61016,"_25651":60943,"_17922":103590,"_5":17817,"_24317":103432,"_2462":103591},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_2936":61017,"_25651":60943,"_17922":103593,"_5":17817,"_24317":103436,"_2462":103594},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_2936":61018,"_25651":60943,"_17922":103596,"_5":17817,"_24317":103440,"_2462":103597},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_2936":61019,"_25651":60943,"_17922":103599,"_5":17817,"_24317":103440,"_2462":103600},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_2936":61020,"_25651":61020,"_5":12587,"_2462":103602,"_25975":103603,"_17922":103604,"_24317":61020},"Perfiles de certificado",[41800,99602,46867,103190],[],{"_2936":61021,"_25651":61020,"_17922":103606,"_5":17817,"_24317":61020,"_2462":103607},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_2936":61022,"_25651":61020,"_5":25972,"_17922":103609,"_24317":103610,"_2462":103611},[],"/docs/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_2936":61023,"_25651":61020,"_5":25972,"_17922":103613,"_24317":103614,"_2462":103615},[],"/docs/es/platform/pki/certificate-profiles#validez","Validez",{"_2936":61024,"_25651":61020,"_5":25972,"_17922":103617,"_24317":103618,"_2462":103619},[],"/docs/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_2936":61025,"_25651":61020,"_5":25972,"_17922":103621,"_24317":103622,"_2462":103623},[],"/docs/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_2936":61026,"_25651":61020,"_5":25972,"_17922":103625,"_24317":103626,"_2462":103627},[],"/docs/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_2936":61027,"_25651":61020,"_5":25972,"_17922":103629,"_24317":103630,"_2462":103631},[],"/docs/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_2936":61028,"_25651":61020,"_5":25972,"_17922":103633,"_24317":103634,"_2462":103635},[],"/docs/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_2936":61029,"_25651":61020,"_5":25972,"_17922":103637,"_24317":103638,"_2462":103639},[],"/docs/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_2936":61030,"_25651":61020,"_5":25972,"_17922":103641,"_24317":103642,"_2462":103643},[],"/docs/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_2936":61031,"_25651":61020,"_5":25972,"_17922":103645,"_24317":103646,"_2462":103647},[],"/docs/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_2936":61032,"_25651":61020,"_5":25972,"_17922":103649,"_24317":103650,"_2462":103651},[],"/docs/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_2936":61033,"_25651":61020,"_5":25972,"_17922":103653,"_24317":103654,"_2462":103655},[],"/docs/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_2936":61034,"_25651":61020,"_5":25972,"_17922":103657,"_24317":103658,"_2462":103659},[],"/docs/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_2936":61035,"_25651":61020,"_5":25972,"_17922":103661,"_24317":103662,"_2462":103663},[],"/docs/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_2936":61036,"_25651":61020,"_5":25972,"_17922":103665,"_24317":103666,"_2462":103667},[],"/docs/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_2936":61037,"_25651":61020,"_5":25972,"_17922":103669,"_24317":103670,"_2462":103671},[],"/docs/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_2936":61038,"_25651":61020,"_17922":103673,"_5":17817,"_24317":61020,"_2462":103674},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_2936":61039,"_25651":61020,"_17922":103676,"_5":17817,"_24317":61020,"_2462":103677},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_2936":61040,"_25651":61020,"_17922":103679,"_5":17817,"_24317":103614,"_2462":103680},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_2936":61041,"_25651":61020,"_17922":103682,"_5":17817,"_24317":103614,"_2462":103683},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_2936":61042,"_25651":61020,"_17922":103685,"_5":17817,"_24317":103618,"_2462":103686},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_2936":61043,"_25651":61020,"_17922":103688,"_5":17817,"_24317":103622,"_2462":103689},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_2936":61044,"_25651":61020,"_17922":103691,"_5":17817,"_24317":103622,"_2462":103692},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_2936":61045,"_25651":61020,"_17922":103694,"_5":17817,"_24317":103622,"_2462":103695},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_2936":61046,"_25651":61020,"_17922":103697,"_5":17817,"_24317":103626,"_2462":103698},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_2936":61047,"_25651":61020,"_17922":103700,"_5":17817,"_24317":103630,"_2462":103701},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_2936":61048,"_25651":61020,"_17922":103703,"_5":17817,"_24317":103630,"_2462":103704},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_2936":61049,"_25651":61020,"_17922":103706,"_5":17817,"_24317":103634,"_2462":103707},[],"La aplicación criptográfica puede:",{"_2936":61050,"_25651":61020,"_17922":103709,"_5":17817,"_24317":103634,"_2462":103710},[],"permitir o bloquear claves RSA;",{"_2936":61051,"_25651":61020,"_17922":103712,"_5":17817,"_24317":103634,"_2462":103713},[],"limitar los tamaños RSA admitidos;",{"_2936":61052,"_25651":61020,"_17922":103715,"_5":17817,"_24317":103634,"_2462":103716},[],"permitir o bloquear claves ECDSA;",{"_2936":61053,"_25651":61020,"_17922":103718,"_5":17817,"_24317":103634,"_2462":103719},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_2936":61054,"_25651":61020,"_17922":103721,"_5":17817,"_24317":103634,"_2462":103722},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_2936":61055,"_25651":61020,"_17922":103724,"_5":17817,"_24317":103638,"_2462":103725},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_2936":61056,"_25651":61020,"_17922":103727,"_5":17817,"_24317":103638,"_2462":99393},[],{"_2936":61057,"_25651":61020,"_17922":103729,"_5":17817,"_24317":103638,"_2462":103730},[],"Primera opción",{"_2936":61058,"_25651":61020,"_17922":103732,"_5":17817,"_24317":103638,"_2462":103733},[],"Segunda opción",{"_2936":61059,"_25651":61020,"_17922":103735,"_5":17817,"_24317":103638,"_2462":103736},[],"Si no hay ninguna",{"_2936":61060,"_25651":61020,"_17922":103738,"_5":17817,"_24317":103638,"_2462":103739},[],"Firma directa con una CA",{"_2936":61061,"_25651":61020,"_17922":103741,"_5":17817,"_24317":103638,"_2462":103742},[],"`issuance_profile` incluido en la solicitud",{"_2936":61062,"_25651":61020,"_17922":103744,"_5":17817,"_24317":103638,"_2462":103745},[],"`issuance_profile_id` de la solicitud",{"_2936":61063,"_25651":61020,"_17922":103747,"_5":17817,"_24317":103638,"_2462":103748},[],"Perfil predeterminado de la CA (`profile_id`).",{"_2936":61064,"_25651":61020,"_17922":103750,"_5":17817,"_24317":103638,"_2462":103751},[],"Emisión mediante DMS",{"_2936":61065,"_25651":61020,"_17922":103753,"_5":17817,"_24317":103638,"_2462":47432},[],{"_2936":61066,"_25651":61020,"_17922":103755,"_5":17817,"_24317":103638,"_2462":103756},[],"`settings.issuance_profile` incluido en el DMS",{"_2936":61067,"_25651":61020,"_17922":103758,"_5":17817,"_24317":103638,"_2462":103759},[],"Perfil predeterminado de la CA de enrolamiento.",{"_2936":61068,"_25651":61020,"_17922":103761,"_5":17817,"_24317":103638,"_2462":103762},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_2936":61069,"_25651":61020,"_17922":103764,"_5":17817,"_24317":103638,"_2462":103765},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_2936":61070,"_25651":61020,"_17922":103767,"_5":17817,"_24317":103646,"_2462":103768},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_2936":61071,"_25651":61020,"_17922":103770,"_5":17817,"_24317":103650,"_2462":103771},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_2936":61072,"_25651":61020,"_17922":103773,"_5":17817,"_24317":103654,"_2462":103774},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_2936":61073,"_25651":61020,"_17922":103776,"_5":17817,"_24317":103658,"_2462":103777},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_2936":61074,"_25651":61020,"_17922":103779,"_5":17817,"_24317":103662,"_2462":103780},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_2936":61075,"_25651":61020,"_17922":103782,"_5":17817,"_24317":103662,"_2462":103783},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_2936":61076,"_25651":61020,"_17922":103785,"_5":17817,"_24317":103666,"_2462":103786},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_2936":61077,"_25651":61020,"_17922":103788,"_5":17817,"_24317":103666,"_2462":103789},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_2936":61078,"_25651":61020,"_17922":103791,"_5":17817,"_24317":103666,"_2462":103792},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_2936":61079,"_25651":61020,"_17922":103794,"_5":17817,"_24317":103666,"_2462":103795},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_2936":61080,"_25651":61020,"_17922":103797,"_5":17817,"_24317":103670,"_2462":103798},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_2936":61081,"_25651":61020,"_17922":103800,"_5":17817,"_24317":103670,"_2462":103801},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_2936":61082,"_25651":61082,"_5":12587,"_2462":103803,"_25975":103804,"_17922":103806,"_24317":61082},"Validación de certificados",[41800,99602,46867,103805],"Validación",[],{"_2936":61083,"_25651":61082,"_17922":103808,"_5":17817,"_24317":61082,"_2462":103809},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_2936":61084,"_25651":61082,"_5":25972,"_17922":103811,"_24317":103812,"_2462":103813},[],"/docs/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_2936":61085,"_25651":61082,"_5":25972,"_17922":103815,"_24317":103816,"_2462":103817},[],"/docs/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_2936":61086,"_25651":61082,"_5":25972,"_17922":103819,"_24317":103820,"_2462":103821},[],"/docs/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_2936":61087,"_25651":61082,"_17922":103823,"_5":17817,"_24317":61082,"_2462":103824},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_2936":61088,"_25651":61082,"_17922":103826,"_5":17817,"_24317":103812,"_2462":103827},[],"Verifica estos criterios juntos:",{"_2936":61089,"_25651":61082,"_17922":103829,"_5":17817,"_24317":103812,"_2462":102817},[],{"_2936":61090,"_25651":61082,"_17922":103831,"_5":17817,"_24317":103812,"_2462":103832},[],"Resultado necesario",{"_2936":61091,"_25651":61082,"_17922":103834,"_5":17817,"_24317":103812,"_2462":103835},[],"Cadena y firma",{"_2936":61092,"_25651":61082,"_17922":103837,"_5":17817,"_24317":103812,"_2462":103838},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_2936":61093,"_25651":61082,"_17922":103840,"_5":17817,"_24317":103812,"_2462":103841},[],"Fechas",{"_2936":61094,"_25651":61082,"_17922":103843,"_5":17817,"_24317":103812,"_2462":103844},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_2936":61095,"_25651":61082,"_17922":103846,"_5":17817,"_24317":103812,"_2462":99306},[],{"_2936":61096,"_25651":61082,"_17922":103848,"_5":17817,"_24317":103812,"_2462":103849},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_2936":61097,"_25651":61082,"_17922":103851,"_5":17817,"_24317":103812,"_2462":103852},[],"Uso",{"_2936":61098,"_25651":61082,"_17922":103854,"_5":17817,"_24317":103812,"_2462":103855},[],"KU, EKU y restricciones permiten la operación concreta.",{"_2936":61099,"_25651":61082,"_17922":103857,"_5":17817,"_24317":103812,"_2462":103858},[],"Revocación",{"_2936":61100,"_25651":61082,"_17922":103860,"_5":17817,"_24317":103812,"_2462":103861},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_2936":61101,"_25651":61082,"_17922":103863,"_5":17817,"_24317":103812,"_2462":103864},[],"Autorización",{"_2936":61102,"_25651":61082,"_17922":103866,"_5":17817,"_24317":103812,"_2462":103867},[],"La aplicación permite la acción a esa identidad.",{"_2936":61103,"_25651":61082,"_17922":103869,"_5":17817,"_24317":103812,"_2462":103870},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_2936":61104,"_25651":61082,"_17922":103872,"_5":17817,"_24317":103816,"_2462":103873},[],"Mecanismo",{"_2936":61105,"_25651":61082,"_17922":103875,"_5":17817,"_24317":103816,"_2462":103876},[],"Cuándo utilizarlo",{"_2936":61106,"_25651":61082,"_17922":103878,"_5":17817,"_24317":103816,"_2462":103879},[],"Qué debes mantener",{"_2936":61107,"_25651":61082,"_17922":103881,"_5":17817,"_24317":103816,"_2462":47560},[],{"_2936":61108,"_25651":61082,"_17922":103883,"_5":17817,"_24317":103816,"_2462":103884},[],"Consulta del estado de un certificado concreto.",{"_2936":61109,"_25651":61082,"_17922":103886,"_5":17817,"_24317":103816,"_2462":103887},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_2936":61110,"_25651":61082,"_17922":103889,"_5":17817,"_24317":103816,"_2462":47569},[],{"_2936":61111,"_25651":61082,"_17922":103891,"_5":17817,"_24317":103816,"_2462":103892},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_2936":61112,"_25651":61082,"_17922":103894,"_5":17817,"_24317":103816,"_2462":103895},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_2936":61113,"_25651":61082,"_17922":103897,"_5":17817,"_24317":103816,"_2462":103898},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_2936":61114,"_25651":61082,"_17922":103900,"_5":17817,"_24317":103816,"_2462":103901},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_2936":61115,"_25651":61082,"_17922":103903,"_5":17817,"_24317":103820,"_2462":103904},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_2936":61116,"_25651":61082,"_17922":103906,"_5":17817,"_24317":103820,"_2462":103907},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_2936":61117,"_25651":61082,"_17922":103909,"_5":17817,"_24317":103820,"_2462":103910},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_2936":61118,"_25651":61082,"_17922":103912,"_5":17817,"_24317":103820,"_2462":103913},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_2936":61119,"_25651":61082,"_17922":103915,"_5":17817,"_24317":103820,"_2462":103916},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_2936":61120,"_25651":61082,"_17922":103918,"_5":17817,"_24317":103820,"_2462":103919},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_2936":61121,"_25651":61082,"_17922":103921,"_5":17817,"_24317":103820,"_2462":103922},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_2936":61122,"_25651":61082,"_17922":103924,"_5":17817,"_24317":103820,"_2462":103925},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_2936":61123,"_25651":61082,"_17922":103927,"_5":17817,"_24317":103820,"_2462":103928},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_2936":61124,"_25651":61124,"_5":12587,"_2462":103930,"_25975":103931,"_17922":103932,"_24317":61124},"Certificados",[41800,99602,46867,103190],[],{"_2936":61125,"_25651":61124,"_17922":103934,"_5":17817,"_24317":61124,"_2462":103935},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_2936":61126,"_25651":61124,"_5":25972,"_17922":103937,"_24317":103938,"_2462":103939},[],"/docs/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_2936":61127,"_25651":61124,"_5":25972,"_17922":103941,"_24317":103942,"_2462":103943},[],"/docs/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_2936":61128,"_25651":61124,"_5":25972,"_17922":103945,"_24317":103946,"_2462":103947},[],"/docs/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_2936":61129,"_25651":61124,"_5":25972,"_17922":103949,"_24317":103950,"_2462":103951},[],"/docs/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_2936":61130,"_25651":61124,"_5":25972,"_17922":103953,"_24317":103954,"_2462":103955},[],"/docs/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_2936":61131,"_25651":61124,"_5":25972,"_17922":103957,"_24317":103958,"_2462":103959},[],"/docs/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_2936":61132,"_25651":61124,"_5":25972,"_17922":103961,"_24317":103962,"_2462":103963},[],"/docs/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_2936":61133,"_25651":61124,"_5":25972,"_17922":103965,"_24317":103966,"_2462":103967},[],"/docs/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_2936":61134,"_25651":61124,"_5":25972,"_17922":103969,"_24317":103970,"_2462":103971},[],"/docs/es/platform/pki/certificates#continúa","Continúa",{"_2936":61135,"_25651":61124,"_17922":103973,"_5":17817,"_24317":61124,"_2462":103974},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_2936":61136,"_25651":61124,"_17922":103976,"_5":17817,"_24317":103938,"_2462":103977},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_2936":61137,"_25651":61124,"_17922":103979,"_5":17817,"_24317":103938,"_2462":103980},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_2936":61138,"_25651":61124,"_17922":103982,"_5":17817,"_24317":103942,"_2462":103983},[],"Descarga el PEM e inspecciónalo:",{"_2936":61139,"_25651":61124,"_17922":103985,"_5":17817,"_24317":103942,"_2462":103986},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_2936":61140,"_25651":61124,"_17922":103988,"_5":17817,"_24317":103946,"_2462":103989},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_2936":61141,"_25651":61124,"_17922":103991,"_5":17817,"_24317":103946,"_2462":103992},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_2936":61142,"_25651":61124,"_17922":103994,"_5":17817,"_24317":103946,"_2462":103995},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_2936":61143,"_25651":61124,"_17922":103997,"_5":17817,"_24317":103946,"_2462":103998},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_2936":61144,"_25651":61124,"_17922":104000,"_5":17817,"_24317":103946,"_2462":104001},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_2936":61145,"_25651":61124,"_17922":104003,"_5":17817,"_24317":103946,"_2462":104004},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_2936":61146,"_25651":61124,"_17922":104006,"_5":17817,"_24317":103946,"_2462":104007},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_2936":61147,"_25651":61124,"_17922":104009,"_5":17817,"_24317":103950,"_2462":104010},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_2936":61148,"_25651":61124,"_17922":104012,"_5":17817,"_24317":103954,"_2462":104013},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_2936":61149,"_25651":61124,"_17922":104015,"_5":17817,"_24317":103958,"_2462":104016},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_2936":61150,"_25651":61124,"_17922":104018,"_5":17817,"_24317":103962,"_2462":104019},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_2936":61151,"_25651":61124,"_17922":104021,"_5":17817,"_24317":103962,"_2462":104022},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_2936":61152,"_25651":61124,"_17922":104024,"_5":17817,"_24317":103962,"_2462":104025},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_2936":61153,"_25651":61124,"_17922":104027,"_5":17817,"_24317":103966,"_2462":104028},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_2936":61154,"_25651":61124,"_17922":104030,"_5":17817,"_24317":103966,"_2462":104031},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_2936":61155,"_25651":61124,"_17922":104033,"_5":17817,"_24317":103966,"_2462":104034},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_2936":61156,"_25651":61124,"_17922":104036,"_5":17817,"_24317":103970,"_2462":104037},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_2936":61157,"_25651":61124,"_17922":104039,"_5":17817,"_24317":103970,"_2462":104040},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_2936":61158,"_25651":61158,"_5":12587,"_2462":104042,"_25975":104043,"_17922":104045,"_24317":61158},"Ciclo de vida de un certificado",[41800,99602,46867,104044],"Conceptos",[],{"_2936":61159,"_25651":61158,"_17922":104047,"_5":17817,"_24317":61158,"_2462":104048},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_2936":61160,"_25651":61158,"_5":25972,"_17922":104050,"_24317":104051,"_2462":104052},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_2936":61161,"_25651":61158,"_5":25972,"_17922":104054,"_24317":104055,"_2462":104056},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_2936":61162,"_25651":61158,"_5":25972,"_17922":104058,"_24317":104059,"_2462":104060},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_2936":61163,"_25651":61158,"_5":25972,"_17922":104062,"_24317":104063,"_2462":104064},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_2936":61164,"_25651":61158,"_5":25972,"_17922":104066,"_24317":104067,"_2462":104068},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_2936":61165,"_25651":61158,"_5":25972,"_17922":104070,"_24317":104071,"_2462":104072},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_2936":61166,"_25651":61158,"_5":25972,"_17922":104074,"_24317":104075,"_2462":104076},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_2936":61167,"_25651":61158,"_5":25972,"_17922":104078,"_24317":104079,"_2462":104080},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_2936":61168,"_25651":61158,"_5":25972,"_17922":104082,"_24317":104083,"_2462":104084},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_2936":61169,"_25651":61158,"_5":25972,"_17922":104086,"_24317":104087,"_2462":104088},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_2936":61170,"_25651":61158,"_17922":104090,"_5":17817,"_24317":61158,"_2462":104091},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_2936":61171,"_25651":61158,"_17922":104093,"_5":17817,"_24317":104055,"_2462":104094},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_2936":61172,"_25651":61158,"_17922":104096,"_5":17817,"_24317":104059,"_2462":104097},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_2936":61173,"_25651":61158,"_17922":104099,"_5":17817,"_24317":104063,"_2462":104100},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_2936":61174,"_25651":61158,"_17922":104102,"_5":17817,"_24317":104067,"_2462":104103},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_2936":61175,"_25651":61158,"_17922":104105,"_5":17817,"_24317":104071,"_2462":104106},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_2936":61176,"_25651":61158,"_17922":104108,"_5":17817,"_24317":104075,"_2462":104109},[],"Lamassu persiste cuatro estados X.509:",{"_2936":61177,"_25651":61158,"_17922":104111,"_5":17817,"_24317":104075,"_2462":104112},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_2936":61178,"_25651":61158,"_17922":104114,"_5":17817,"_24317":104075,"_2462":104115},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_2936":61179,"_25651":61158,"_17922":104117,"_5":17817,"_24317":104075,"_2462":104118},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_2936":61180,"_25651":61158,"_17922":104120,"_5":17817,"_24317":104075,"_2462":104121},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_2936":61181,"_25651":61158,"_17922":104123,"_5":17817,"_24317":104075,"_2462":104124},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_2936":61182,"_25651":61158,"_17922":104126,"_5":17817,"_24317":104079,"_2462":104127},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_2936":61183,"_25651":61158,"_17922":104129,"_5":17817,"_24317":104079,"_2462":104130},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_2936":61184,"_25651":61158,"_17922":104132,"_5":17817,"_24317":104079,"_2462":104133},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_2936":61185,"_25651":61158,"_17922":104135,"_5":17817,"_24317":104083,"_2462":104136},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_2936":61186,"_25651":61158,"_17922":104138,"_5":17817,"_24317":104083,"_2462":104139},[],"Antes de confirmar:",{"_2936":61187,"_25651":61158,"_17922":104141,"_5":17817,"_24317":104083,"_2462":104142},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_2936":61188,"_25651":61158,"_17922":104144,"_5":17817,"_24317":104083,"_2462":104145},[],"Distribuye la nueva cadena de confianza.",{"_2936":61189,"_25651":61158,"_17922":104147,"_5":17817,"_24317":104083,"_2462":104148},[],"Reemite las identidades necesarias.",{"_2936":61190,"_25651":61158,"_17922":104150,"_5":17817,"_24317":104083,"_2462":104151},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_2936":61191,"_25651":61158,"_17922":104153,"_5":17817,"_24317":104083,"_2462":104154},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_2936":61192,"_25651":61158,"_17922":104156,"_5":17817,"_24317":104083,"_2462":104157},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_2936":61193,"_25651":61158,"_17922":104159,"_5":17817,"_24317":104087,"_2462":104160},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_2936":61194,"_25651":61158,"_17922":104162,"_5":17817,"_24317":104087,"_2462":104163},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_2936":61195,"_25651":61158,"_17922":104165,"_5":17817,"_24317":104087,"_2462":104166},[],"Cambios de estado y razones de revocación.",{"_2936":61196,"_25651":61158,"_17922":104168,"_5":17817,"_24317":104087,"_2462":104169},[],"Publicación y vigencia de OCSP y CRLs.",{"_2936":61197,"_25651":61158,"_17922":104171,"_5":17817,"_24317":104087,"_2462":104172},[],"Dependencias que todavía presentan un certificado sustituido.",{"_2936":61198,"_25651":61158,"_17922":104174,"_5":17817,"_24317":104087,"_2462":104175},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_2936":61199,"_25651":61199,"_5":12587,"_2462":104177,"_25975":104178,"_17922":104179,"_24317":61199},"Modelo de confianza",[41800,99602,46867,104044],[],{"_2936":61200,"_25651":61199,"_17922":104181,"_5":17817,"_24317":61199,"_2462":104182},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_2936":61201,"_25651":61199,"_5":25972,"_17922":104184,"_24317":104185,"_2462":104186},[],"/docs/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_2936":61202,"_25651":61199,"_5":25972,"_17922":104188,"_24317":104189,"_2462":104190},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_2936":61203,"_25651":61199,"_5":25972,"_17922":104192,"_24317":104193,"_2462":104194},[],"/docs/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_2936":61204,"_25651":61199,"_5":25972,"_17922":104196,"_24317":104197,"_2462":104198},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_2936":61205,"_25651":61199,"_5":25972,"_17922":104200,"_24317":104201,"_2462":104202},[],"/docs/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_2936":61206,"_25651":61199,"_5":25972,"_17922":104204,"_24317":104205,"_2462":104206},[],"/docs/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_2936":61207,"_25651":61199,"_5":25972,"_17922":104208,"_24317":104209,"_2462":104210},[],"/docs/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_2936":61208,"_25651":61199,"_5":25972,"_17922":104212,"_24317":104213,"_2462":104214},[],"/docs/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_2936":61209,"_25651":61199,"_5":25972,"_17922":104216,"_24317":104217,"_2462":104218},[],"/docs/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_2936":61210,"_25651":61199,"_5":25972,"_17922":104220,"_24317":104221,"_2462":104222},[],"/docs/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_2936":61211,"_25651":61199,"_17922":104224,"_5":17817,"_24317":61199,"_2462":104225},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_2936":61212,"_25651":61199,"_17922":104227,"_5":17817,"_24317":104189,"_2462":104228},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_2936":61213,"_25651":61199,"_17922":104230,"_5":17817,"_24317":104193,"_2462":104231},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_2936":61214,"_25651":61199,"_17922":104233,"_5":17817,"_24317":104197,"_2462":104234},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_2936":61215,"_25651":61199,"_17922":104236,"_5":17817,"_24317":104201,"_2462":104237},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_2936":61216,"_25651":61199,"_17922":104239,"_5":17817,"_24317":104205,"_2462":104240},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_2936":61217,"_25651":61199,"_17922":104242,"_5":17817,"_24317":104205,"_2462":104243},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_2936":61218,"_25651":61199,"_17922":104245,"_5":17817,"_24317":104205,"_2462":104246},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_2936":61219,"_25651":61199,"_17922":104248,"_5":17817,"_24317":104205,"_2462":104249},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_2936":61220,"_25651":61199,"_17922":104251,"_5":17817,"_24317":104205,"_2462":104252},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_2936":61221,"_25651":61199,"_17922":104254,"_5":17817,"_24317":104205,"_2462":104255},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_2936":61222,"_25651":61199,"_17922":104257,"_5":17817,"_24317":104209,"_2462":104258},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_2936":61223,"_25651":61199,"_17922":104260,"_5":17817,"_24317":104209,"_2462":104261},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_2936":61224,"_25651":61199,"_17922":104263,"_5":17817,"_24317":104209,"_2462":104264},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, Lamassu prueba primero la CA de enrolamiento y después las CAs de validación configuradas en el bloque de re-enrolamiento.",{"_2936":61225,"_25651":61199,"_17922":104266,"_5":17817,"_24317":104209,"_2462":104267},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_2936":61226,"_25651":61199,"_17922":104269,"_5":17817,"_24317":104209,"_2462":104270},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_2936":61227,"_25651":61199,"_17922":104272,"_5":17817,"_24317":104213,"_2462":104273},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_2936":61228,"_25651":61199,"_17922":104275,"_5":17817,"_24317":104213,"_2462":104276},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_2936":61229,"_25651":61199,"_17922":104278,"_5":17817,"_24317":104213,"_2462":104279},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_2936":61230,"_25651":61199,"_17922":104281,"_5":17817,"_24317":104213,"_2462":104282},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_2936":61231,"_25651":61199,"_17922":104284,"_5":17817,"_24317":104213,"_2462":104285},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_2936":61232,"_25651":61199,"_17922":104287,"_5":17817,"_24317":104213,"_2462":104288},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_2936":61233,"_25651":61199,"_17922":104290,"_5":17817,"_24317":104213,"_2462":104291},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_2936":61234,"_25651":61199,"_17922":104293,"_5":17817,"_24317":104217,"_2462":104294},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_2936":61235,"_25651":61199,"_17922":104296,"_5":17817,"_24317":104221,"_2462":104297},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_2936":61236,"_25651":61199,"_17922":104299,"_5":17817,"_24317":104221,"_2462":104300},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_2936":61237,"_25651":61199,"_17922":104302,"_5":17817,"_24317":104221,"_2462":104303},[],"Asigna perfiles explícitos a cada caso de uso.",{"_2936":61238,"_25651":61199,"_17922":104305,"_5":17817,"_24317":104221,"_2462":104306},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_2936":61239,"_25651":61199,"_17922":104308,"_5":17817,"_24317":104221,"_2462":104309},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_2936":61240,"_25651":61199,"_17922":104311,"_5":17817,"_24317":104221,"_2462":104312},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_2936":61241,"_25651":61199,"_17922":104314,"_5":17817,"_24317":104221,"_2462":104315},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_2936":61242,"_25651":61242,"_5":12587,"_2462":104317,"_25975":104318,"_17922":104319,"_24317":61242},"Listas de revocación (CRL)",[41800,99602,46867,103805],[],{"_2936":61243,"_25651":61242,"_17922":104321,"_5":17817,"_24317":61242,"_2462":104322},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_2936":61244,"_25651":61242,"_5":25972,"_17922":104324,"_24317":104325,"_2462":104326},[],"/docs/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_2936":61245,"_25651":61242,"_5":25972,"_17922":104328,"_24317":104329,"_2462":104330},[],"/docs/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_2936":61246,"_25651":61242,"_5":25972,"_17922":104332,"_24317":104333,"_2462":104334},[],"/docs/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_2936":61247,"_25651":61242,"_5":25972,"_17922":104336,"_24317":104337,"_2462":104338},[],"/docs/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_2936":61248,"_25651":61242,"_5":25972,"_17922":104340,"_24317":104341,"_2462":104342},[],"/docs/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_2936":61249,"_25651":61242,"_5":25972,"_17922":104344,"_24317":104345,"_2462":104346},[],"/docs/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_2936":61250,"_25651":61242,"_5":25972,"_17922":104348,"_24317":104349,"_2462":104350},[],"/docs/es/platform/pki/crl#referencias","Referencias",{"_2936":61251,"_25651":61242,"_17922":104352,"_5":17817,"_24317":61242,"_2462":104353},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_2936":61252,"_25651":61242,"_17922":104355,"_5":17817,"_24317":104325,"_2462":104356},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_2936":61253,"_25651":61242,"_17922":104358,"_5":17817,"_24317":104325,"_2462":104359},[],"Campo de `crl_options`",{"_2936":61254,"_25651":61242,"_17922":104361,"_5":17817,"_24317":104325,"_2462":101098},[],{"_2936":61255,"_25651":61242,"_17922":104363,"_5":17817,"_24317":104325,"_2462":104364},[],"Valor inicial del backend",{"_2936":61256,"_25651":61242,"_17922":104366,"_5":17817,"_24317":104325,"_2462":48047},[],{"_2936":61257,"_25651":61242,"_17922":104368,"_5":17817,"_24317":104325,"_2462":104369},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_2936":61258,"_25651":61242,"_17922":104371,"_5":17817,"_24317":104325,"_2462":104372},[],"7 días.",{"_2936":61259,"_25651":61242,"_17922":104374,"_5":17817,"_24317":104325,"_2462":48056},[],{"_2936":61260,"_25651":61242,"_17922":104376,"_5":17817,"_24317":104325,"_2462":104377},[],"Plazo desde la publicación que activa la renovación programada.",{"_2936":61261,"_25651":61242,"_17922":104379,"_5":17817,"_24317":104325,"_2462":104380},[],"6 días y 23 horas.",{"_2936":61262,"_25651":61242,"_17922":104382,"_5":17817,"_24317":104325,"_2462":48065},[],{"_2936":61263,"_25651":61242,"_17922":104384,"_5":17817,"_24317":104325,"_2462":104385},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_2936":61264,"_25651":61242,"_17922":104387,"_5":17817,"_24317":104325,"_2462":48071},[],{"_2936":61265,"_25651":61242,"_17922":104389,"_5":17817,"_24317":104325,"_2462":48074},[],{"_2936":61266,"_25651":61242,"_17922":104391,"_5":17817,"_24317":104325,"_2462":104392},[],"Campo de configuración inicializado con el SKI de la CA.",{"_2936":61267,"_25651":61242,"_17922":104394,"_5":17817,"_24317":104325,"_2462":104395},[],"SKI de la CA.",{"_2936":61268,"_25651":61242,"_17922":104397,"_5":17817,"_24317":104325,"_2462":104398},[],"El generador utiliza la clave de la CA identificada por el SKI solicitado. No interpretes `subject_key_id_signer` como soporte verificado de una CA delegada distinta: cambiar el campo no cambia el firmante en ese flujo.",{"_2936":61269,"_25651":61242,"_17922":104400,"_5":17817,"_24317":104325,"_2462":104401},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_2936":61270,"_25651":61242,"_17922":104403,"_5":17817,"_24317":104329,"_2462":104404},[],"El trabajo programado solicita otra lista cuando se alcanza `refresh_interval` o cuando la lista está próxima a vencer según el periodo de vigilancia configurado. Esto depende de que el trabajo, almacenamiento y firma funcionen; no garantiza renovación ante un fallo del servicio.",{"_2936":61271,"_25651":61242,"_17922":104406,"_5":17817,"_24317":104329,"_2462":104407},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_2936":61272,"_25651":61242,"_17922":104409,"_5":17817,"_24317":104329,"_2462":104410},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_2936":61273,"_25651":61242,"_17922":104412,"_5":17817,"_24317":104333,"_2462":104413},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_2936":61274,"_25651":61242,"_17922":104415,"_5":17817,"_24317":104333,"_2462":104416},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_2936":61275,"_25651":61242,"_17922":104418,"_5":17817,"_24317":104337,"_2462":104419},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_2936":61276,"_25651":61242,"_17922":104421,"_5":17817,"_24317":104337,"_2462":104422},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_2936":61277,"_25651":61242,"_17922":104424,"_5":17817,"_24317":104337,"_2462":104425},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_2936":61278,"_25651":61242,"_17922":104427,"_5":17817,"_24317":104337,"_2462":104428},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_2936":61279,"_25651":61242,"_17922":104430,"_5":17817,"_24317":104337,"_2462":104431},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_2936":61280,"_25651":61242,"_17922":104433,"_5":17817,"_24317":104341,"_2462":104434},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_2936":61281,"_25651":61242,"_17922":104436,"_5":17817,"_24317":104341,"_2462":101287},[],{"_2936":61282,"_25651":61242,"_17922":104438,"_5":17817,"_24317":104341,"_2462":104439},[],"Path relativo",{"_2936":61283,"_25651":61242,"_17922":104441,"_5":17817,"_24317":104341,"_2462":99393},[],{"_2936":61284,"_25651":61242,"_17922":104443,"_5":17817,"_24317":104341,"_2462":48129},[],{"_2936":61285,"_25651":61242,"_17922":104445,"_5":17817,"_24317":104341,"_2462":48132},[],{"_2936":61286,"_25651":61242,"_17922":104447,"_5":17817,"_24317":104341,"_2462":104448},[],"Consultar `crl_options` y `latest_crl`.",{"_2936":61287,"_25651":61242,"_17922":104450,"_5":17817,"_24317":104341,"_2462":48138},[],{"_2936":61288,"_25651":61242,"_17922":104452,"_5":17817,"_24317":104341,"_2462":48132},[],{"_2936":61289,"_25651":61242,"_17922":104454,"_5":17817,"_24317":104341,"_2462":104455},[],"Sustituir la configuración de CRL.",{"_2936":61290,"_25651":61242,"_17922":104457,"_5":17817,"_24317":104341,"_2462":104458},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_2936":61291,"_25651":61242,"_17922":104460,"_5":17817,"_24317":104341,"_2462":104461},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_2936":61292,"_25651":61242,"_17922":104463,"_5":17817,"_24317":104345,"_2462":104464},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_2936":61293,"_25651":61242,"_17922":104466,"_5":17817,"_24317":104349,"_2462":104467},[],"RFC 5280: perfil X.509 y CRL.",{"_2936":61294,"_25651":61242,"_17922":104469,"_5":17817,"_24317":104349,"_2462":48158},[],{"_2936":61295,"_25651":61242,"_17922":104471,"_5":17817,"_24317":104349,"_2462":48161},[],{"_2936":61296,"_25651":61242,"_17922":104473,"_5":17817,"_24317":104349,"_2462":104474},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_2936":61297,"_25651":61242,"_17922":104476,"_5":17817,"_24317":104349,"_2462":104477},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2936":61298,"_25651":61298,"_5":12587,"_2462":104479,"_25975":104480,"_17922":104481,"_24317":61298},"Claves y motores criptográficos",[41800,99602,46867,103190],[],{"_2936":61299,"_25651":61298,"_17922":104483,"_5":17817,"_24317":61298,"_2462":104484},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_2936":61300,"_25651":61298,"_5":25972,"_17922":104486,"_24317":104487,"_2462":104488},[],"/docs/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_2936":61301,"_25651":61298,"_5":25972,"_17922":104490,"_24317":104491,"_2462":104492},[],"/docs/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_2936":61302,"_25651":61298,"_5":25972,"_17922":104494,"_24317":104495,"_2462":48186},[],"/docs/es/platform/pki/key-management#file-system",{"_2936":61303,"_25651":61298,"_5":25972,"_17922":104497,"_24317":104498,"_2462":48190},[],"/docs/es/platform/pki/key-management#hashicorp-vault",{"_2936":61304,"_25651":61298,"_5":25972,"_17922":104500,"_24317":104501,"_2462":48194},[],"/docs/es/platform/pki/key-management#aws-secrets-manager",{"_2936":61305,"_25651":61298,"_5":25972,"_17922":104503,"_24317":104504,"_2462":48198},[],"/docs/es/platform/pki/key-management#aws-kms",{"_2936":61306,"_25651":61298,"_5":25972,"_17922":104506,"_24317":104507,"_2462":48202},[],"/docs/es/platform/pki/key-management#pkcs11",{"_2936":61307,"_25651":61298,"_5":25972,"_17922":104509,"_24317":104510,"_2462":48206},[],"/docs/es/platform/pki/key-management#azure-key-vault",{"_2936":61308,"_25651":61298,"_5":25972,"_17922":104512,"_24317":104513,"_2462":104514},[],"/docs/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_2936":61309,"_25651":61298,"_5":25972,"_17922":104516,"_24317":104517,"_2462":104518},[],"/docs/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_2936":61310,"_25651":61298,"_5":25972,"_17922":104520,"_24317":104521,"_2462":104522},[],"/docs/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_2936":61311,"_25651":61298,"_5":25972,"_17922":104524,"_24317":104525,"_2462":104526},[],"/docs/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_2936":61312,"_25651":61298,"_5":25972,"_17922":104528,"_24317":104529,"_2462":104530},[],"/docs/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_2936":61313,"_25651":61298,"_5":25972,"_17922":104532,"_24317":104533,"_2462":104534},[],"/docs/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_2936":61314,"_25651":61298,"_5":25972,"_17922":104536,"_24317":104537,"_2462":104538},[],"/docs/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_2936":61315,"_25651":61298,"_5":25972,"_17922":104540,"_24317":104541,"_2462":48238},[],"/docs/es/platform/pki/key-management#sign",{"_2936":61316,"_25651":61298,"_5":25972,"_17922":104543,"_24317":104544,"_2462":48242},[],"/docs/es/platform/pki/key-management#verify",{"_2936":61317,"_25651":61298,"_5":25972,"_17922":104546,"_24317":104547,"_2462":104548},[],"/docs/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_2936":61318,"_25651":61298,"_5":25972,"_17922":104550,"_24317":104551,"_2462":104552},[],"/docs/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_2936":61319,"_25651":61298,"_5":25972,"_17922":104554,"_24317":104555,"_2462":104556},[],"/docs/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_2936":61320,"_25651":61298,"_17922":104558,"_5":17817,"_24317":61298,"_2462":104559},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_2936":61321,"_25651":61298,"_17922":104561,"_5":17817,"_24317":61298,"_2462":104562},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_2936":61322,"_25651":61298,"_17922":104564,"_5":17817,"_24317":104487,"_2462":104565},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_2936":61323,"_25651":61298,"_17922":104567,"_5":17817,"_24317":104487,"_2462":104568},[],"En la práctica, permite:",{"_2936":61324,"_25651":61298,"_17922":104570,"_5":17817,"_24317":104487,"_2462":104571},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_2936":61325,"_25651":61298,"_17922":104573,"_5":17817,"_24317":104487,"_2462":104574},[],"Importar claves creadas externamente.",{"_2936":61326,"_25651":61298,"_17922":104576,"_5":17817,"_24317":104487,"_2462":104577},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_2936":61327,"_25651":61298,"_17922":104579,"_5":17817,"_24317":104487,"_2462":104580},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_2936":61328,"_25651":61298,"_17922":104582,"_5":17817,"_24317":104491,"_2462":104583},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_2936":61329,"_25651":61298,"_17922":104585,"_5":17817,"_24317":104491,"_2462":104586},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_2936":61330,"_25651":61298,"_17922":104588,"_5":17817,"_24317":104491,"_2462":104589},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_2936":61331,"_25651":61298,"_17922":104591,"_5":17817,"_24317":104495,"_2462":104592},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_2936":61332,"_25651":61298,"_17922":104594,"_5":17817,"_24317":104498,"_2462":104595},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_2936":61333,"_25651":61298,"_17922":104597,"_5":17817,"_24317":104501,"_2462":104598},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_2936":61334,"_25651":61298,"_17922":104600,"_5":17817,"_24317":104504,"_2462":104601},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_2936":61335,"_25651":61298,"_17922":104603,"_5":17817,"_24317":104507,"_2462":104604},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_2936":61336,"_25651":61298,"_17922":104606,"_5":17817,"_24317":104510,"_2462":104607},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_2936":61337,"_25651":61298,"_17922":104609,"_5":17817,"_24317":104510,"_2462":104610},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_2936":61338,"_25651":61298,"_17922":104612,"_5":17817,"_24317":104510,"_2462":104613},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_2936":61339,"_25651":61298,"_17922":104615,"_5":17817,"_24317":104510,"_2462":104616},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_2936":61340,"_25651":61298,"_17922":104618,"_5":17817,"_24317":104513,"_2462":104619},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_2936":61341,"_25651":61298,"_17922":104621,"_5":17817,"_24317":104513,"_2462":104622},[],"La tabla incluye los siguientes campos:",{"_2936":61342,"_25651":61298,"_17922":104624,"_5":17817,"_24317":104513,"_2462":104625},[],"**Name**: nombre descriptivo de la clave.",{"_2936":61343,"_25651":61298,"_17922":104627,"_5":17817,"_24317":104513,"_2462":104628},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_2936":61344,"_25651":61298,"_17922":104630,"_5":17817,"_24317":104513,"_2462":104631},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_2936":61345,"_25651":61298,"_17922":104633,"_5":17817,"_24317":104513,"_2462":104634},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_2936":61346,"_25651":61298,"_17922":104636,"_5":17817,"_24317":104513,"_2462":104637},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_2936":61347,"_25651":61298,"_17922":104639,"_5":17817,"_24317":104513,"_2462":104640},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_2936":61348,"_25651":61298,"_17922":104642,"_5":17817,"_24317":104513,"_2462":104643},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_2936":61349,"_25651":61298,"_17922":104645,"_5":17817,"_24317":104513,"_2462":104646},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_2936":61350,"_25651":61298,"_17922":104648,"_5":17817,"_24317":104513,"_2462":104649},[],"Desde esta vista también se accede a las acciones más habituales:",{"_2936":61351,"_25651":61298,"_17922":104651,"_5":17817,"_24317":104513,"_2462":104652},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_2936":61352,"_25651":61298,"_17922":104654,"_5":17817,"_24317":104513,"_2462":104655},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_2936":61353,"_25651":61298,"_17922":104657,"_5":17817,"_24317":104513,"_2462":104658},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_2936":61354,"_25651":61298,"_17922":104660,"_5":17817,"_24317":104513,"_2462":104661},[],"**Delete Key** para eliminar la clave del sistema.",{"_2936":61355,"_25651":61298,"_17922":104663,"_5":17817,"_24317":104517,"_2462":104664},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_2936":61356,"_25651":61298,"_17922":104666,"_5":17817,"_24317":104521,"_2462":104667},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_2936":61357,"_25651":61298,"_17922":104669,"_5":17817,"_24317":104521,"_2462":104670},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_2936":61358,"_25651":61298,"_17922":104672,"_5":17817,"_24317":104521,"_2462":104673},[],"**Key Name**: nombre único y descriptivo.",{"_2936":61359,"_25651":61298,"_17922":104675,"_5":17817,"_24317":104521,"_2462":104676},[],"**Crypto Engine**: motor que custodiará la clave.",{"_2936":61360,"_25651":61298,"_17922":104678,"_5":17817,"_24317":104521,"_2462":104679},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_2936":61361,"_25651":61298,"_17922":104681,"_5":17817,"_24317":104521,"_2462":104682},[],"**Tags**: metadatos para clasificar la clave.",{"_2936":61362,"_25651":61298,"_17922":104684,"_5":17817,"_24317":104521,"_2462":104685},[],"**Metadata**: información adicional para usos avanzados.",{"_2936":61363,"_25651":61298,"_17922":104687,"_5":17817,"_24317":104525,"_2462":104688},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_2936":61364,"_25651":61298,"_17922":104690,"_5":17817,"_24317":104525,"_2462":104691},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_2936":61365,"_25651":61298,"_17922":104693,"_5":17817,"_24317":104525,"_2462":104694},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_2936":61366,"_25651":61298,"_17922":104696,"_5":17817,"_24317":104525,"_2462":104697},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_2936":61367,"_25651":61298,"_17922":104699,"_5":17817,"_24317":104525,"_2462":104700},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_2936":61368,"_25651":61298,"_17922":104702,"_5":17817,"_24317":104525,"_2462":104703},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_2936":61369,"_25651":61298,"_17922":104705,"_5":17817,"_24317":104525,"_2462":104706},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_2936":61370,"_25651":61298,"_17922":104708,"_5":17817,"_24317":104525,"_2462":104709},[],"**Tags**: etiquetas para organización y búsqueda.",{"_2936":61371,"_25651":61298,"_17922":104711,"_5":17817,"_24317":104525,"_2462":104712},[],"**Metadata**: información adicional opcional.",{"_2936":61372,"_25651":61298,"_17922":104714,"_5":17817,"_24317":104525,"_2462":104715},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_2936":61373,"_25651":61298,"_17922":104717,"_5":17817,"_24317":104525,"_2462":104718},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_2936":61374,"_25651":61298,"_17922":104720,"_5":17817,"_24317":104529,"_2462":104721},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_2936":61375,"_25651":61298,"_17922":104723,"_5":17817,"_24317":104533,"_2462":104724},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_2936":61376,"_25651":61298,"_17922":104726,"_5":17817,"_24317":104533,"_2462":104727},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_2936":61377,"_25651":61298,"_17922":104729,"_5":17817,"_24317":104533,"_2462":104730},[],"**Key Name**: nombre descriptivo.",{"_2936":61378,"_25651":61298,"_17922":104732,"_5":17817,"_24317":104533,"_2462":104733},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_2936":61379,"_25651":61298,"_17922":104735,"_5":17817,"_24317":104533,"_2462":104736},[],"**Tags**: etiquetas asociadas.",{"_2936":61380,"_25651":61298,"_17922":104738,"_5":17817,"_24317":104533,"_2462":104739},[],"**Aliases**: nombres alternativos.",{"_2936":61381,"_25651":61298,"_17922":104741,"_5":17817,"_24317":104533,"_2462":104742},[],"**Crypto Engine**: motor en el que reside la clave.",{"_2936":61382,"_25651":61298,"_17922":104744,"_5":17817,"_24317":104533,"_2462":104745},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_2936":61383,"_25651":61298,"_17922":104747,"_5":17817,"_24317":104533,"_2462":104748},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_2936":61384,"_25651":61298,"_17922":104750,"_5":17817,"_24317":104533,"_2462":104751},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_2936":61385,"_25651":61298,"_17922":104753,"_5":17817,"_24317":104537,"_2462":104754},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_2936":61386,"_25651":61298,"_17922":104756,"_5":17817,"_24317":104537,"_2462":104757},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_2936":61387,"_25651":61298,"_17922":104759,"_5":17817,"_24317":104537,"_2462":104760},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_2936":61388,"_25651":61298,"_17922":104762,"_5":17817,"_24317":104541,"_2462":104763},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_2936":61389,"_25651":61298,"_17922":104765,"_5":17817,"_24317":104541,"_2462":104766},[],"Campos principales:",{"_2936":61390,"_25651":61298,"_17922":104768,"_5":17817,"_24317":104541,"_2462":104769},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_2936":61391,"_25651":61298,"_17922":104771,"_5":17817,"_24317":104541,"_2462":104772},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_2936":61392,"_25651":61298,"_17922":104774,"_5":17817,"_24317":104541,"_2462":104775},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_2936":61393,"_25651":61298,"_17922":104777,"_5":17817,"_24317":104541,"_2462":104778},[],"**Message**: contenido que se va a firmar.",{"_2936":61394,"_25651":61298,"_17922":104780,"_5":17817,"_24317":104541,"_2462":104781},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_2936":61395,"_25651":61298,"_17922":104783,"_5":17817,"_24317":104544,"_2462":104784},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_2936":61396,"_25651":61298,"_17922":104786,"_5":17817,"_24317":104544,"_2462":104766},[],{"_2936":61397,"_25651":61298,"_17922":104788,"_5":17817,"_24317":104544,"_2462":104789},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_2936":61398,"_25651":61298,"_17922":104791,"_5":17817,"_24317":104544,"_2462":104792},[],"**Message Type**: `Raw` o `Digest`.",{"_2936":61399,"_25651":61298,"_17922":104794,"_5":17817,"_24317":104544,"_2462":104795},[],"**Payload Encoding**: codificación del mensaje.",{"_2936":61400,"_25651":61298,"_17922":104797,"_5":17817,"_24317":104544,"_2462":104798},[],"**Message**: mensaje original o hash.",{"_2936":61401,"_25651":61298,"_17922":104800,"_5":17817,"_24317":104544,"_2462":104801},[],"**Signature**: firma que se desea comprobar.",{"_2936":61402,"_25651":61298,"_17922":104803,"_5":17817,"_24317":104544,"_2462":104804},[],"**Result**: indicador del resultado de la validación.",{"_2936":61403,"_25651":61298,"_17922":104806,"_5":17817,"_24317":104547,"_2462":104807},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_2936":61404,"_25651":61298,"_17922":104809,"_5":17817,"_24317":104547,"_2462":104810},[],"Este flujo es útil para:",{"_2936":61405,"_25651":61298,"_17922":104812,"_5":17817,"_24317":104547,"_2462":104813},[],"Solicitar certificados a una CA externa.",{"_2936":61406,"_25651":61298,"_17922":104815,"_5":17817,"_24317":104547,"_2462":104816},[],"Renovar una identidad manteniendo la misma clave.",{"_2936":61407,"_25651":61298,"_17922":104818,"_5":17817,"_24317":104547,"_2462":104819},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_2936":61408,"_25651":61298,"_17922":104821,"_5":17817,"_24317":104547,"_2462":104822},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_2936":61409,"_25651":61298,"_17922":104824,"_5":17817,"_24317":104547,"_2462":104825},[],"**Organization (O)**: organización o empresa.",{"_2936":61410,"_25651":61298,"_17922":104827,"_5":17817,"_24317":104547,"_2462":104828},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_2936":61411,"_25651":61298,"_17922":104830,"_5":17817,"_24317":104547,"_2462":104831},[],"**Country (C)**: código de país de dos letras.",{"_2936":61412,"_25651":61298,"_17922":104833,"_5":17817,"_24317":104547,"_2462":104834},[],"**State / Province (ST)**: estado o provincia.",{"_2936":61413,"_25651":61298,"_17922":104836,"_5":17817,"_24317":104547,"_2462":104837},[],"**Locality (L)**: ciudad o localidad.",{"_2936":61414,"_25651":61298,"_17922":104839,"_5":17817,"_24317":104547,"_2462":104840},[],"**Email Address**: correo de contacto.",{"_2936":61415,"_25651":61298,"_17922":104842,"_5":17817,"_24317":104547,"_2462":104843},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_2936":61416,"_25651":61298,"_17922":104845,"_5":17817,"_24317":104547,"_2462":104846},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_2936":61417,"_25651":61298,"_17922":104848,"_5":17817,"_24317":104551,"_2462":104849},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_2936":61418,"_25651":61298,"_17922":104851,"_5":17817,"_24317":104551,"_2462":48550},[],{"_2936":61419,"_25651":61298,"_17922":104853,"_5":17817,"_24317":104555,"_2462":104854},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_2936":61420,"_25651":61420,"_5":12587,"_2462":104856,"_25975":104857,"_17922":104858,"_24317":61420},"Validación online con OCSP",[41800,99602,46867,103805],[],{"_2936":61421,"_25651":61420,"_17922":104860,"_5":17817,"_24317":61420,"_2462":104861},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_2936":61422,"_25651":61420,"_5":25972,"_17922":104863,"_24317":104864,"_2462":104865},[],"/docs/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_2936":61423,"_25651":61420,"_5":25972,"_17922":104867,"_24317":104868,"_2462":104869},[],"/docs/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_2936":61424,"_25651":61420,"_5":25972,"_17922":104871,"_24317":104872,"_2462":104873},[],"/docs/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_2936":61425,"_25651":61420,"_5":25972,"_17922":104875,"_24317":104876,"_2462":104877},[],"/docs/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_2936":61426,"_25651":61420,"_5":25972,"_17922":104879,"_24317":104880,"_2462":104881},[],"/docs/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_2936":61427,"_25651":61420,"_5":25972,"_17922":104883,"_24317":104884,"_2462":104350},[],"/docs/es/platform/pki/ocsp#referencias",{"_2936":61428,"_25651":61420,"_17922":104886,"_5":17817,"_24317":61420,"_2462":104887},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_2936":61429,"_25651":61420,"_17922":104889,"_5":17817,"_24317":104864,"_2462":104890},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_2936":61430,"_25651":61420,"_17922":104892,"_5":17817,"_24317":104864,"_2462":104893},[],"Estado del registro",{"_2936":61431,"_25651":61420,"_17922":104895,"_5":17817,"_24317":104864,"_2462":104896},[],"Respuesta firmada",{"_2936":61432,"_25651":61420,"_17922":104898,"_5":17817,"_24317":104864,"_2462":46045},[],{"_2936":61433,"_25651":61420,"_17922":104900,"_5":17817,"_24317":104864,"_2462":48600},[],{"_2936":61434,"_25651":61420,"_17922":104902,"_5":17817,"_24317":104864,"_2462":46062},[],{"_2936":61435,"_25651":61420,"_17922":104904,"_5":17817,"_24317":104864,"_2462":104905},[],"`Revoked`, con razón y fecha de revocación.",{"_2936":61436,"_25651":61420,"_17922":104907,"_5":17817,"_24317":104864,"_2462":104908},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_2936":61437,"_25651":61420,"_17922":104910,"_5":17817,"_24317":104864,"_2462":104911},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_2936":61438,"_25651":61420,"_17922":104913,"_5":17817,"_24317":104864,"_2462":104914},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_2936":61439,"_25651":61420,"_17922":104916,"_5":17817,"_24317":104864,"_2462":104917},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_2936":61440,"_25651":61420,"_17922":104919,"_5":17817,"_24317":104864,"_2462":104920},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_2936":61441,"_25651":61420,"_17922":104922,"_5":17817,"_24317":104868,"_2462":104923},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_2936":61442,"_25651":61420,"_17922":104925,"_5":17817,"_24317":104868,"_2462":104926},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_2936":61443,"_25651":61420,"_17922":104928,"_5":17817,"_24317":104872,"_2462":104929},[],"El servicio acepta:",{"_2936":61444,"_25651":61420,"_17922":104931,"_5":17817,"_24317":104872,"_2462":101287},[],{"_2936":61445,"_25651":61420,"_17922":104933,"_5":17817,"_24317":104872,"_2462":104934},[],"Ruta del servicio VA",{"_2936":61446,"_25651":61420,"_17922":104936,"_5":17817,"_24317":104872,"_2462":104937},[],"Formato",{"_2936":61447,"_25651":61420,"_17922":104939,"_5":17817,"_24317":104872,"_2462":48640},[],{"_2936":61448,"_25651":61420,"_17922":104941,"_5":17817,"_24317":104872,"_2462":48643},[],{"_2936":61449,"_25651":61420,"_17922":104943,"_5":17817,"_24317":104872,"_2462":104944},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_2936":61450,"_25651":61420,"_17922":104946,"_5":17817,"_24317":104872,"_2462":48129},[],{"_2936":61451,"_25651":61420,"_17922":104948,"_5":17817,"_24317":104872,"_2462":48651},[],{"_2936":61452,"_25651":61420,"_17922":104950,"_5":17817,"_24317":104872,"_2462":104951},[],"Solicitud DER codificada en Base64 URL con padding.",{"_2936":61453,"_25651":61420,"_17922":104953,"_5":17817,"_24317":104872,"_2462":104954},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_2936":61454,"_25651":61420,"_17922":104956,"_5":17817,"_24317":104876,"_2462":104957},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_2936":61455,"_25651":61420,"_17922":104959,"_5":17817,"_24317":104876,"_2462":104960},[],"Genera la solicitud:",{"_2936":61456,"_25651":61420,"_17922":104962,"_5":17817,"_24317":104876,"_2462":104963},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_2936":61457,"_25651":61420,"_17922":104965,"_5":17817,"_24317":104876,"_2462":104966},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_2936":61458,"_25651":61420,"_17922":104968,"_5":17817,"_24317":104876,"_2462":104969},[],"Verifica el DER recibido:",{"_2936":61459,"_25651":61420,"_17922":104971,"_5":17817,"_24317":104876,"_2462":104972},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_2936":61460,"_25651":61420,"_17922":104974,"_5":17817,"_24317":104880,"_2462":104975},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_2936":61461,"_25651":61420,"_17922":104977,"_5":17817,"_24317":104880,"_2462":104978},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_2936":61462,"_25651":61420,"_17922":104980,"_5":17817,"_24317":104884,"_2462":48684},[],{"_2936":61463,"_25651":61420,"_17922":104982,"_5":17817,"_24317":104884,"_2462":48687},[],{"_2936":61464,"_25651":61420,"_17922":104984,"_5":17817,"_24317":104884,"_2462":104985},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_2936":61465,"_25651":61420,"_17922":104987,"_5":17817,"_24317":104884,"_2462":104477},[],{"_2936":61466,"_25651":61466,"_5":12587,"_2462":46867,"_25975":104989,"_17922":104990,"_24317":61466},[41800,99602,46867],[],{"_2936":61467,"_25651":61466,"_17922":104992,"_5":17817,"_24317":61466,"_2462":104993},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_2936":61468,"_25651":61466,"_5":25972,"_17922":104995,"_24317":104996,"_2462":102514},[],"/docs/es/platform/pki/overview#empieza-aquí",{"_2936":61469,"_25651":61466,"_5":25972,"_17922":104998,"_24317":104999,"_2462":105000},[],"/docs/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_2936":61470,"_25651":61466,"_5":25972,"_17922":105002,"_24317":105003,"_2462":103036},[],"/docs/es/platform/pki/overview#capacidades-principales",{"_2936":61471,"_25651":61466,"_5":25972,"_17922":105005,"_24317":105006,"_2462":103040},[],"/docs/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_2936":61472,"_25651":61466,"_5":25972,"_17922":105008,"_24317":105009,"_2462":103044},[],"/docs/es/platform/pki/overview#protege-las-claves-criptográficas",{"_2936":61473,"_25651":61466,"_5":25972,"_17922":105011,"_24317":105012,"_2462":103048},[],"/docs/es/platform/pki/overview#emite-y-controla-certificados",{"_2936":61474,"_25651":61466,"_5":25972,"_17922":105014,"_24317":105015,"_2462":103056},[],"/docs/es/platform/pki/overview#publica-el-estado-de-validación",{"_2936":61475,"_25651":61466,"_5":25972,"_17922":105017,"_24317":105018,"_2462":105019},[],"/docs/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_2936":61476,"_25651":61466,"_5":25972,"_17922":105021,"_24317":105022,"_2462":103971},[],"/docs/es/platform/pki/overview#continúa",{"_2936":61477,"_25651":61466,"_17922":105024,"_5":17817,"_24317":61466,"_2462":105025},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_2936":61478,"_25651":61466,"_17922":105027,"_5":17817,"_24317":104996,"_2462":105028},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_2936":61479,"_25651":61466,"_17922":105030,"_5":17817,"_24317":104996,"_2462":105031},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_2936":61480,"_25651":61466,"_17922":105033,"_5":17817,"_24317":104999,"_2462":105034},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_2936":61481,"_25651":61466,"_17922":105036,"_5":17817,"_24317":104999,"_2462":105037},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_2936":61482,"_25651":61466,"_17922":105039,"_5":17817,"_24317":104999,"_2462":105040},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_2936":61483,"_25651":61466,"_17922":105042,"_5":17817,"_24317":104999,"_2462":105043},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_2936":61484,"_25651":61466,"_17922":105045,"_5":17817,"_24317":104999,"_2462":105046},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_2936":61485,"_25651":61466,"_17922":105048,"_5":17817,"_24317":105006,"_2462":105049},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_2936":61486,"_25651":61466,"_17922":105051,"_5":17817,"_24317":105009,"_2462":105052},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_2936":61487,"_25651":61466,"_17922":105054,"_5":17817,"_24317":105012,"_2462":105055},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_2936":61488,"_25651":61466,"_17922":105057,"_5":17817,"_24317":105015,"_2462":105058},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_2936":61489,"_25651":61466,"_17922":105060,"_5":17817,"_24317":105018,"_2462":105061},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_2936":61490,"_25651":61466,"_17922":105063,"_5":17817,"_24317":105018,"_2462":105064},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_2936":61491,"_25651":61466,"_17922":105066,"_5":17817,"_24317":105018,"_2462":105067},[],"su clave pública corresponda a la clave privada del cliente;",{"_2936":61492,"_25651":61466,"_17922":105069,"_5":17817,"_24317":105018,"_2462":105070},[],"su cadena alcance una raíz confiable para el consumidor;",{"_2936":61493,"_25651":61466,"_17922":105072,"_5":17817,"_24317":105018,"_2462":105073},[],"sus fechas y usos permitan la operación;",{"_2936":61494,"_25651":61466,"_17922":105075,"_5":17817,"_24317":105018,"_2462":105076},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_2936":61495,"_25651":61466,"_17922":105078,"_5":17817,"_24317":105018,"_2462":105079},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_2936":61496,"_25651":61466,"_17922":105081,"_5":17817,"_24317":105022,"_2462":105082},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2936":61497,"_25651":61466,"_17922":105084,"_5":17817,"_24317":105022,"_2462":105085},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2936":61498,"_25651":61466,"_17922":105087,"_5":17817,"_24317":105022,"_2462":105088},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2936":61499,"_25651":61499,"_5":12587,"_2462":105090,"_25975":105091,"_17922":105092,"_24317":61499},"Crea tu primera CA",[41800,99602,46867,102638],[],{"_2936":61500,"_25651":61499,"_17922":105094,"_5":17817,"_24317":61499,"_2462":105095},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_2936":61501,"_25651":61499,"_5":25972,"_17922":105097,"_24317":105098,"_2462":98274},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_2936":61502,"_25651":61499,"_5":25972,"_17922":105100,"_24317":105101,"_2462":105102},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_2936":61503,"_25651":61499,"_5":25972,"_17922":105104,"_24317":105105,"_2462":105106},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_2936":61504,"_25651":61499,"_5":25972,"_17922":105108,"_24317":105109,"_2462":105110},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_2936":61505,"_25651":61499,"_5":25972,"_17922":105112,"_24317":105113,"_2462":105114},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_2936":61506,"_25651":61499,"_5":25972,"_17922":105116,"_24317":105117,"_2462":105118},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_2936":61507,"_25651":61499,"_5":25972,"_17922":105120,"_24317":105121,"_2462":105122},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_2936":61508,"_25651":61499,"_5":25972,"_17922":105124,"_24317":105125,"_2462":102886},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_2936":61509,"_25651":61499,"_5":25972,"_17922":105127,"_24317":105128,"_2462":98298},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_2936":61510,"_25651":61499,"_17922":105130,"_5":17817,"_24317":61499,"_2462":105131},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_2936":61511,"_25651":61499,"_17922":105133,"_5":17817,"_24317":105098,"_2462":105134},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_2936":61512,"_25651":61499,"_17922":105136,"_5":17817,"_24317":105098,"_2462":105137},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_2936":61513,"_25651":61499,"_17922":105139,"_5":17817,"_24317":105098,"_2462":105140},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_2936":61514,"_25651":61499,"_17922":105142,"_5":17817,"_24317":105098,"_2462":105143},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_2936":61515,"_25651":61499,"_17922":105145,"_5":17817,"_24317":105101,"_2462":105146},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_2936":61516,"_25651":61499,"_17922":105148,"_5":17817,"_24317":105101,"_2462":105149},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_2936":61517,"_25651":61499,"_17922":105151,"_5":17817,"_24317":105105,"_2462":105152},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_2936":61518,"_25651":61499,"_17922":105154,"_5":17817,"_24317":105105,"_2462":105155},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_2936":61519,"_25651":61499,"_17922":105157,"_5":17817,"_24317":105109,"_2462":105158},[],"Selecciona **Root CA** y completa:",{"_2936":61520,"_25651":61499,"_17922":105160,"_5":17817,"_24317":105109,"_2462":48866},[],{"_2936":61521,"_25651":61499,"_17922":105162,"_5":17817,"_24317":105109,"_2462":105163},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_2936":61522,"_25651":61499,"_17922":105165,"_5":17817,"_24317":105109,"_2462":105166},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_2936":61523,"_25651":61499,"_17922":105168,"_5":17817,"_24317":105109,"_2462":105169},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_2936":61524,"_25651":61499,"_17922":105171,"_5":17817,"_24317":105109,"_2462":105172},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_2936":61525,"_25651":61499,"_17922":105174,"_5":17817,"_24317":105113,"_2462":105175},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_2936":61526,"_25651":61499,"_17922":105177,"_5":17817,"_24317":105117,"_2462":105178},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_2936":61527,"_25651":61499,"_17922":105180,"_5":17817,"_24317":105117,"_2462":105181},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_2936":61528,"_25651":61499,"_17922":105183,"_5":17817,"_24317":105121,"_2462":105184},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_2936":61529,"_25651":61499,"_17922":105186,"_5":17817,"_24317":105121,"_2462":105187},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_2936":61530,"_25651":61499,"_17922":105189,"_5":17817,"_24317":105121,"_2462":105190},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_2936":61531,"_25651":61499,"_17922":105192,"_5":17817,"_24317":105125,"_2462":105193},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_2936":61532,"_25651":61499,"_17922":105195,"_5":17817,"_24317":105125,"_2462":105196},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_2936":61533,"_25651":61499,"_17922":105198,"_5":17817,"_24317":105125,"_2462":105199},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_2936":61534,"_25651":61499,"_17922":105201,"_5":17817,"_24317":105125,"_2462":105202},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_2936":61535,"_25651":61499,"_17922":105204,"_5":17817,"_24317":105128,"_2462":105205},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_2936":61536,"_25651":61536,"_5":12587,"_2462":105207,"_25975":105208,"_17922":105209,"_24317":61536},"Emite y verifica un certificado",[41800,99602,46867,102638],[],{"_2936":61537,"_25651":61536,"_17922":105211,"_5":17817,"_24317":61536,"_2462":105212},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_2936":61538,"_25651":61536,"_5":25972,"_17922":105214,"_24317":105215,"_2462":98274},[],"/docs/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_2936":61539,"_25651":61536,"_5":25972,"_17922":105217,"_24317":105218,"_2462":105219},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_2936":61540,"_25651":61536,"_5":25972,"_17922":105221,"_24317":105222,"_2462":105223},[],"/docs/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_2936":61541,"_25651":61536,"_5":25972,"_17922":105225,"_24317":105226,"_2462":105227},[],"/docs/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_2936":61542,"_25651":61536,"_5":25972,"_17922":105229,"_24317":105230,"_2462":105231},[],"/docs/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_2936":61543,"_25651":61536,"_5":25972,"_17922":105233,"_24317":105234,"_2462":105235},[],"/docs/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_2936":61544,"_25651":61536,"_5":25972,"_17922":105237,"_24317":105238,"_2462":105118},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_2936":61545,"_25651":61536,"_5":25972,"_17922":105240,"_24317":105241,"_2462":105242},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_2936":61546,"_25651":61536,"_5":25972,"_17922":105244,"_24317":105245,"_2462":105246},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_2936":61547,"_25651":61536,"_5":25972,"_17922":105248,"_24317":105249,"_2462":105250},[],"/docs/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_2936":61548,"_25651":61536,"_5":25972,"_17922":105252,"_24317":105253,"_2462":102886},[],"/docs/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_2936":61549,"_25651":61536,"_5":25972,"_17922":105255,"_24317":105256,"_2462":98298},[],"/docs/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_2936":61550,"_25651":61536,"_17922":105258,"_5":17817,"_24317":61536,"_2462":105259},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_2936":61551,"_25651":61536,"_17922":105261,"_5":17817,"_24317":105215,"_2462":105262},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_2936":61552,"_25651":61536,"_17922":105264,"_5":17817,"_24317":105215,"_2462":105265},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_2936":61553,"_25651":61536,"_17922":105267,"_5":17817,"_24317":105215,"_2462":105268},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_2936":61554,"_25651":61536,"_17922":105270,"_5":17817,"_24317":105215,"_2462":105271},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_2936":61555,"_25651":61536,"_17922":105273,"_5":17817,"_24317":105215,"_2462":105274},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_2936":61556,"_25651":61536,"_17922":105276,"_5":17817,"_24317":105218,"_2462":105277},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_2936":61557,"_25651":61536,"_17922":105279,"_5":17817,"_24317":105222,"_2462":105280},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_2936":61558,"_25651":61536,"_17922":105282,"_5":17817,"_24317":105222,"_2462":105283},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_2936":61559,"_25651":61536,"_17922":105285,"_5":17817,"_24317":105226,"_2462":105286},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_2936":61560,"_25651":61536,"_17922":105288,"_5":17817,"_24317":105226,"_2462":105289},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_2936":61561,"_25651":61536,"_17922":105291,"_5":17817,"_24317":105230,"_2462":105292},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_2936":61562,"_25651":61536,"_17922":105294,"_5":17817,"_24317":105230,"_2462":105295},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_2936":61563,"_25651":61536,"_17922":105297,"_5":17817,"_24317":105234,"_2462":105298},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_2936":61564,"_25651":61536,"_17922":105300,"_5":17817,"_24317":105238,"_2462":105301},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_2936":61565,"_25651":61536,"_17922":105303,"_5":17817,"_24317":105241,"_2462":105304},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_2936":61566,"_25651":61536,"_17922":105306,"_5":17817,"_24317":105245,"_2462":105307},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_2936":61567,"_25651":61536,"_17922":105309,"_5":17817,"_24317":105245,"_2462":105310},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_2936":61568,"_25651":61536,"_17922":105312,"_5":17817,"_24317":105245,"_2462":105313},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_2936":61569,"_25651":61536,"_17922":105315,"_5":17817,"_24317":105249,"_2462":105316},[],"En Bash, compara los dos resúmenes de clave pública:",{"_2936":61570,"_25651":61536,"_17922":105318,"_5":17817,"_24317":105249,"_2462":105319},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_2936":61571,"_25651":61536,"_17922":105321,"_5":17817,"_24317":105249,"_2462":105322},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_2936":61572,"_25651":61536,"_17922":105324,"_5":17817,"_24317":105253,"_2462":102969},[],{"_2936":61573,"_25651":61536,"_17922":105326,"_5":17817,"_24317":105253,"_2462":101736},[],{"_2936":61574,"_25651":61536,"_17922":105328,"_5":17817,"_24317":105253,"_2462":105329},[],"La CA rechaza la emisión",{"_2936":61575,"_25651":61536,"_17922":105331,"_5":17817,"_24317":105253,"_2462":105332},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_2936":61576,"_25651":61536,"_17922":105334,"_5":17817,"_24317":105253,"_2462":105335},[],"Sujeto o usos diferentes",{"_2936":61577,"_25651":61536,"_17922":105337,"_5":17817,"_24317":105253,"_2462":105338},[],"Perfil aplicado y valores solicitados.",{"_2936":61578,"_25651":61536,"_17922":105340,"_5":17817,"_24317":105253,"_2462":105341},[],"No se encuentra el emisor",{"_2936":61579,"_25651":61536,"_17922":105343,"_5":17817,"_24317":105253,"_2462":105344},[],"CA descargada y cadena intermedia necesaria.",{"_2936":61580,"_25651":61536,"_17922":105346,"_5":17817,"_24317":105253,"_2462":105347},[],"Falla la vigencia",{"_2936":61581,"_25651":61536,"_17922":105349,"_5":17817,"_24317":105253,"_2462":105350},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_2936":61582,"_25651":61536,"_17922":105352,"_5":17817,"_24317":105253,"_2462":105353},[],"Los resúmenes de clave difieren",{"_2936":61583,"_25651":61536,"_17922":105355,"_5":17817,"_24317":105253,"_2462":105356},[],"Archivos de certificado y clave de la misma emisión.",{"_2936":61584,"_25651":61536,"_17922":105358,"_5":17817,"_24317":105253,"_2462":105359},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_2936":61585,"_25651":61536,"_17922":105361,"_5":17817,"_24317":105256,"_2462":105362},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_2936":61586,"_25651":61536,"_17922":105364,"_5":17817,"_24317":105256,"_2462":105365},[],"Gestionar certificados para inspección, estado y revocación.",{"_2936":61587,"_25651":61536,"_17922":105367,"_5":17817,"_24317":105256,"_2462":105368},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_2936":61588,"_25651":61536,"_17922":105370,"_5":17817,"_24317":105256,"_2462":105371},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_2936":61589,"_25651":61536,"_17922":105373,"_5":17817,"_24317":105256,"_2462":105374},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_2936":61590,"_25651":61590,"_5":12587,"_2462":105376,"_25975":105377,"_17922":105378,"_24317":61590},"Primeros pasos de PKI",[41800,99602,46867,102638],[],{"_2936":61591,"_25651":61590,"_17922":105380,"_5":17817,"_24317":61590,"_2462":105381},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_2936":61592,"_25651":61590,"_5":25972,"_17922":105383,"_24317":105384,"_2462":98274},[],"/docs/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_2936":61593,"_25651":61590,"_5":25972,"_17922":105386,"_24317":105387,"_2462":105388},[],"/docs/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_2936":61594,"_25651":61590,"_5":25972,"_17922":105390,"_24317":105391,"_2462":102820},[],"/docs/es/platform/pki/quickstarts/overview#resultado-esperado",{"_2936":61595,"_25651":61590,"_5":25972,"_17922":105393,"_24317":105394,"_2462":105395},[],"/docs/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_2936":61596,"_25651":61590,"_17922":105397,"_5":17817,"_24317":61590,"_2462":105398},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_2936":61597,"_25651":61590,"_17922":105400,"_5":17817,"_24317":105384,"_2462":105401},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_2936":61598,"_25651":61590,"_17922":105403,"_5":17817,"_24317":105384,"_2462":105404},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_2936":61599,"_25651":61590,"_17922":105406,"_5":17817,"_24317":105384,"_2462":105407},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_2936":61600,"_25651":61590,"_17922":105409,"_5":17817,"_24317":105384,"_2462":105410},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_2936":61601,"_25651":61590,"_17922":105412,"_5":17817,"_24317":105384,"_2462":105413},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_2936":61602,"_25651":61590,"_17922":105415,"_5":17817,"_24317":105387,"_2462":105416},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2936":61603,"_25651":61590,"_17922":105418,"_5":17817,"_24317":105387,"_2462":105419},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2936":61604,"_25651":61590,"_17922":105421,"_5":17817,"_24317":105387,"_2462":105422},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_2936":61605,"_25651":61590,"_17922":105424,"_5":17817,"_24317":105387,"_2462":105425},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_2936":61606,"_25651":61590,"_17922":105427,"_5":17817,"_24317":105391,"_2462":105428},[],"Archivo o recurso",{"_2936":61607,"_25651":61590,"_17922":105430,"_5":17817,"_24317":105391,"_2462":102817},[],{"_2936":61608,"_25651":61590,"_17922":105432,"_5":17817,"_24317":105391,"_2462":105433},[],"CA raíz activa y `ca.pem`",{"_2936":61609,"_25651":61590,"_17922":105435,"_5":17817,"_24317":105391,"_2462":105436},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_2936":61610,"_25651":61590,"_17922":105438,"_5":17817,"_24317":105391,"_2462":105439},[],"Certificado final y `device.crt`",{"_2936":61611,"_25651":61590,"_17922":105441,"_5":17817,"_24317":105391,"_2462":105442},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_2936":61612,"_25651":61590,"_17922":105444,"_5":17817,"_24317":105391,"_2462":105445},[],"Clave privada `device.key`",{"_2936":61613,"_25651":61590,"_17922":105447,"_5":17817,"_24317":105391,"_2462":105448},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_2936":61614,"_25651":61590,"_17922":105450,"_5":17817,"_24317":105391,"_2462":105451},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_2936":61615,"_25651":61590,"_17922":105453,"_5":17817,"_24317":105394,"_2462":105454},[],"Para operar certificados, continúa con Certificados y Validación.",{"_2936":61616,"_25651":61590,"_17922":105456,"_5":17817,"_24317":105394,"_2462":105457},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_2936":61617,"_25651":61590,"_17922":105459,"_5":17817,"_24317":105394,"_2462":105460},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_2936":61618,"_25651":61618,"_5":12587,"_2462":105462,"_25975":105463,"_17922":105465,"_24317":61618},"Resolución de problemas PKI",[41800,99602,46867,105464],"Resolución de problemas",[],{"_2936":61619,"_25651":61618,"_17922":105467,"_5":17817,"_24317":61618,"_2462":105468},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_2936":61620,"_25651":61618,"_5":25972,"_17922":105470,"_24317":105471,"_2462":105472},[],"/docs/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_2936":61621,"_25651":61618,"_5":25972,"_17922":105474,"_24317":105475,"_2462":105476},[],"/docs/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_2936":61622,"_25651":61618,"_5":25972,"_17922":105478,"_24317":105479,"_2462":105480},[],"/docs/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_2936":61623,"_25651":61618,"_17922":105482,"_5":17817,"_24317":61618,"_2462":105483},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_2936":61624,"_25651":61618,"_17922":105485,"_5":17817,"_24317":61618,"_2462":105486},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_2936":61625,"_25651":61618,"_17922":105488,"_5":17817,"_24317":105471,"_2462":102817},[],{"_2936":61626,"_25651":61618,"_17922":105490,"_5":17817,"_24317":105471,"_2462":101736},[],{"_2936":61627,"_25651":61618,"_17922":105492,"_5":17817,"_24317":105471,"_2462":98298},[],{"_2936":61628,"_25651":61618,"_17922":105494,"_5":17817,"_24317":105471,"_2462":49202},[],{"_2936":61629,"_25651":61618,"_17922":105496,"_5":17817,"_24317":105471,"_2462":105497},[],"Existe, está activa y sus fechas son utilizables.",{"_2936":61630,"_25651":61618,"_17922":105499,"_5":17817,"_24317":105471,"_2462":105500},[],"Autoridades.",{"_2936":61631,"_25651":61618,"_17922":105502,"_5":17817,"_24317":105471,"_2462":105503},[],"Clave",{"_2936":61632,"_25651":61618,"_17922":105505,"_5":17817,"_24317":105471,"_2462":105506},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_2936":61633,"_25651":61618,"_17922":105508,"_5":17817,"_24317":105471,"_2462":105509},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_2936":61634,"_25651":61618,"_17922":105511,"_5":17817,"_24317":105471,"_2462":49220},[],{"_2936":61635,"_25651":61618,"_17922":105513,"_5":17817,"_24317":105471,"_2462":105514},[],"PEM correcto y firma verificable.",{"_2936":61636,"_25651":61618,"_17922":105516,"_5":17817,"_24317":105471,"_2462":49226},[],{"_2936":61637,"_25651":61618,"_17922":105518,"_5":17817,"_24317":105471,"_2462":105519},[],"Perfil",{"_2936":61638,"_25651":61618,"_17922":105521,"_5":17817,"_24317":105471,"_2462":105522},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_2936":61639,"_25651":61618,"_17922":105524,"_5":17817,"_24317":105471,"_2462":105525},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_2936":61640,"_25651":61618,"_17922":105527,"_5":17817,"_24317":105471,"_2462":102969},[],{"_2936":61641,"_25651":61618,"_17922":105529,"_5":17817,"_24317":105471,"_2462":105530},[],"Sujeto, SAN, usos y fechas adecuados.",{"_2936":61642,"_25651":61618,"_17922":105532,"_5":17817,"_24317":105471,"_2462":105533},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_2936":61643,"_25651":61618,"_17922":105535,"_5":17817,"_24317":105471,"_2462":105536},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_2936":61644,"_25651":61618,"_17922":105538,"_5":17817,"_24317":105471,"_2462":105539},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_2936":61645,"_25651":61618,"_17922":105541,"_5":17817,"_24317":105475,"_2462":105542},[],"Revisa cada frontera por separado:",{"_2936":61646,"_25651":61618,"_17922":105544,"_5":17817,"_24317":105475,"_2462":105545},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_2936":61647,"_25651":61618,"_17922":105547,"_5":17817,"_24317":105475,"_2462":105548},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_2936":61648,"_25651":61618,"_17922":105550,"_5":17817,"_24317":105475,"_2462":105551},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_2936":61649,"_25651":61618,"_17922":105553,"_5":17817,"_24317":105475,"_2462":105554},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_2936":61650,"_25651":61618,"_17922":105556,"_5":17817,"_24317":105475,"_2462":105557},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_2936":61651,"_25651":61618,"_17922":105559,"_5":17817,"_24317":105475,"_2462":105560},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_2936":61652,"_25651":61618,"_17922":105562,"_5":17817,"_24317":105479,"_2462":105563},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_2936":61653,"_25651":61618,"_17922":105565,"_5":17817,"_24317":105479,"_2462":105566},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_2936":61654,"_25651":61654,"_5":12587,"_2462":105568,"_25975":105569,"_17922":105571,"_24317":61654},"3.8.0 a 4.0.0",[41800,105570],"Actualizaciones",[],{"_2936":61655,"_25651":61654,"_17922":105573,"_5":17817,"_24317":61654,"_2462":105574},[],"Cambios de 4.0.0 que afectan a la configuración de los DMS, qué puede fallar tras actualizar desde 3.8.0 y cómo comprobarlo.",{"_2936":61656,"_25651":61654,"_5":25972,"_17922":105576,"_24317":105577,"_2462":105578},[],"/docs/es/upgrades/3-8-0-to-4-0-0#resumen","Resumen",{"_2936":61657,"_25651":61654,"_5":25972,"_17922":105580,"_24317":105581,"_2462":105582},[],"/docs/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_2936":61658,"_25651":61654,"_5":25972,"_17922":105584,"_24317":105585,"_2462":105586},[],"/docs/es/upgrades/3-8-0-to-4-0-0#webhooks-con-referencias-a-archivos","Webhooks con referencias a archivos",{"_2936":61659,"_25651":61654,"_5":25972,"_17922":105588,"_24317":105589,"_2462":105590},[],"/docs/es/upgrades/3-8-0-to-4-0-0#verificación-del-certificado-del-receptor","Verificación del certificado del receptor",{"_2936":61660,"_25651":61654,"_5":25972,"_17922":105592,"_24317":105593,"_2462":105594},[],"/docs/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_2936":61661,"_25651":61654,"_5":25972,"_17922":105596,"_24317":105597,"_2462":105598},[],"/docs/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_2936":61662,"_25651":61654,"_5":25972,"_17922":105600,"_24317":105601,"_2462":105602},[],"/docs/es/upgrades/3-8-0-to-4-0-0#lista-de-verificación","Lista de verificación",{"_2936":61663,"_25651":61654,"_17922":105604,"_5":17817,"_24317":61654,"_2462":105605},[],"La actualización de 3.8.0 a 4.0.0 migra automáticamente la configuración almacenada de los DMS. Casi todo se convierte sin intervención, pero hay tres cambios que pueden dejar enrolamientos fallando o configuraciones con valores inesperados si no se revisan. Esta página indica qué cambia, qué síntomas produce y qué hacer en cada caso. El comportamiento vigente de cada funcionalidad está en las páginas de DMS.",{"_2936":61664,"_25651":61654,"_17922":105607,"_5":17817,"_24317":105577,"_2462":105608},[],"Cambio",{"_2936":61665,"_25651":61654,"_17922":105610,"_5":17817,"_24317":105577,"_2462":105611},[],"Quién se ve afectado",{"_2936":61666,"_25651":61654,"_17922":105613,"_5":17817,"_24317":105577,"_2462":105614},[],"Gravedad",{"_2936":61667,"_25651":61654,"_17922":105616,"_5":17817,"_24317":105577,"_2462":105617},[],"Acción",{"_2936":61668,"_25651":61654,"_17922":105619,"_5":17817,"_24317":105577,"_2462":105586},[],{"_2936":61669,"_25651":61654,"_17922":105621,"_5":17817,"_24317":105577,"_2462":105622},[],"DMS con webhook cuyo certificado o clave de mTLS eran rutas de archivo",{"_2936":61670,"_25651":61654,"_17922":105624,"_5":17817,"_24317":105577,"_2462":105625},[],"Alta: los enrolamientos y reenrolamientos que llaman al webhook fallan",{"_2936":61671,"_25651":61654,"_17922":105627,"_5":17817,"_24317":105577,"_2462":105628},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_2936":61672,"_25651":61654,"_17922":105630,"_5":17817,"_24317":105577,"_2462":105590},[],{"_2936":61673,"_25651":61654,"_17922":105632,"_5":17817,"_24317":105577,"_2462":105633},[],"DMS con webhook que tenían `validate_server_cert: false`",{"_2936":61674,"_25651":61654,"_17922":105635,"_5":17817,"_24317":105577,"_2462":105636},[],"Media: las credenciales del webhook viajan sin verificar al receptor",{"_2936":61675,"_25651":61654,"_17922":105638,"_5":17817,"_24317":105577,"_2462":105639},[],"Poner `insecure_skip_verify` a `false`",{"_2936":61676,"_25651":61654,"_17922":105641,"_5":17817,"_24317":105577,"_2462":105594},[],{"_2936":61677,"_25651":61654,"_17922":105643,"_5":17817,"_24317":105577,"_2462":105644},[],"Scripts y consolas que editan DMS por API",{"_2936":61678,"_25651":61654,"_17922":105646,"_5":17817,"_24317":105577,"_2462":105647},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_2936":61679,"_25651":61654,"_17922":105649,"_5":17817,"_24317":105577,"_2462":105650},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_2936":61680,"_25651":61654,"_17922":105652,"_5":17817,"_24317":105577,"_2462":105598},[],{"_2936":61681,"_25651":61654,"_17922":105654,"_5":17817,"_24317":105577,"_2462":105655},[],"Cualquier DMS",{"_2936":61682,"_25651":61654,"_17922":105657,"_5":17817,"_24317":105577,"_2462":105658},[],"Baja: solo informativo",{"_2936":61683,"_25651":61654,"_17922":105660,"_5":17817,"_24317":105577,"_2462":105661},[],"Revisar ambos bloques antes de editar",{"_2936":61684,"_25651":61654,"_17922":105663,"_5":17817,"_24317":105577,"_2462":105664},[],"Al final se incluye una lista de verificación para confirmar el resultado.",{"_2936":61685,"_25651":61654,"_17922":105666,"_5":17817,"_24317":105581,"_2462":105667},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual. Los campos se renombran de la siguiente manera:",{"_2936":61686,"_25651":61654,"_17922":105669,"_5":17817,"_24317":105581,"_2462":105670},[],"Campo en 3.8.0",{"_2936":61687,"_25651":61654,"_17922":105672,"_5":17817,"_24317":105581,"_2462":105673},[],"Campo en 4.0.0",{"_2936":61688,"_25651":61654,"_17922":105675,"_5":17817,"_24317":105581,"_2462":49386},[],{"_2936":61689,"_25651":61654,"_17922":105677,"_5":17817,"_24317":105581,"_2462":105678},[],"`insecure_skip_verify` (con el valor negado)",{"_2936":61690,"_25651":61654,"_17922":105680,"_5":17817,"_24317":105581,"_2462":49392},[],{"_2936":61691,"_25651":61654,"_17922":105682,"_5":17817,"_24317":105581,"_2462":49395},[],{"_2936":61692,"_25651":61654,"_17922":105684,"_5":17817,"_24317":105581,"_2462":49398},[],{"_2936":61693,"_25651":61654,"_17922":105686,"_5":17817,"_24317":105581,"_2462":49401},[],{"_2936":61694,"_25651":61654,"_17922":105688,"_5":17817,"_24317":105581,"_2462":49404},[],{"_2936":61695,"_25651":61654,"_17922":105690,"_5":17817,"_24317":105581,"_2462":49407},[],{"_2936":61696,"_25651":61654,"_17922":105692,"_5":17817,"_24317":105581,"_2462":105693},[],"Cuando el certificado y la clave heredados de mTLS son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren ninguna acción. Los dos casos siguientes son los que sí la requieren.",{"_2936":61697,"_25651":61654,"_17922":105695,"_5":17817,"_24317":105585,"_2462":105696},[],"Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos, y lo hace en cada llamada, sea cual sea el modo de autenticación configurado. El efecto es que todos los enrolamientos y reenrolamientos que invocan ese webhook fallan hasta corregir la configuración.",{"_2936":61698,"_25651":61654,"_17922":105698,"_5":17817,"_24317":105585,"_2462":105699},[],"Para corregirlo hay dos opciones, según el webhook:",{"_2936":61699,"_25651":61654,"_17922":105701,"_5":17817,"_24317":105585,"_2462":105702},[],"Si el webhook usa mTLS, volver a introducir el certificado y la clave como PEM, en Base64 o en texto plano.",{"_2936":61700,"_25651":61654,"_17922":105704,"_5":17817,"_24317":105585,"_2462":105705},[],"Si el webhook no usa mTLS, eliminar los campos de archivo sobrantes.",{"_2936":61701,"_25651":61654,"_17922":105707,"_5":17817,"_24317":105585,"_2462":105708},[],"Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`).",{"_2936":61702,"_25651":61654,"_17922":105710,"_5":17817,"_24317":105585,"_2462":105711},[],"Existe una variante del mismo problema: si la configuración almacenada guarda rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content`, toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`) falla la validación. Los ajustes se sustituyen al completo, de modo que la configuración almacenada debe reenviarse con el certificado y la clave como PEM.",{"_2936":61703,"_25651":61654,"_17922":105713,"_5":17817,"_24317":105589,"_2462":105714},[],"Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`. Por tanto, la verificación del certificado del receptor sigue sin realizarse hasta que se ponga ese campo a `false`.",{"_2936":61704,"_25651":61654,"_17922":105716,"_5":17817,"_24317":105589,"_2462":105717},[],"Conviene corregirlo en cada configuración migrada. El canal de autorización del webhook transporta la API key o el bearer token, de modo que saltarse la verificación expone esas credenciales a un atacante con posición de red. Solo se justifica mantener `insecure_skip_verify: true` si el certificado del receptor no es verificable de forma deliberada.",{"_2936":61705,"_25651":61654,"_17922":105719,"_5":17817,"_24317":105593,"_2462":105720},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`.",{"_2936":61706,"_25651":61654,"_17922":105722,"_5":17817,"_24317":105593,"_2462":105723},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_2936":61707,"_25651":61654,"_17922":105725,"_5":17817,"_24317":105593,"_2462":105726},[],"Lo que sí cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se ignora en silencio porque los campos JSON desconocidos se descartan, y las respuestas GET ya no lo incluyen. En consecuencia, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin devolver ningún error. Para evitarlo, leer siempre el DMS antes de enviar una edición y reutilizar el formato que devuelve la API.",{"_2936":61708,"_25651":61654,"_17922":105728,"_5":17817,"_24317":105597,"_2462":105729},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero antes de editar un DMS conviene leer ambos bloques para no modificar uno creyendo que se está editando el otro.",{"_2936":61709,"_25651":61654,"_17922":105731,"_5":17817,"_24317":105597,"_2462":105732},[],"Si la versión de la consola no expone los ajustes independientes, pueden editarse mediante la API DMS.",{"_2936":61710,"_25651":61654,"_17922":105734,"_5":17817,"_24317":105601,"_2462":105735},[],"Tras aplicar la actualización, comprobar en este orden:",{"_2936":61711,"_25651":61654,"_17922":105737,"_5":17817,"_24317":105601,"_2462":105738},[],"**Webhooks sin campos de archivo.** Listar los DMS que usan webhook en enrolamiento o reenrolamiento y confirmar que cada bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_2936":61712,"_25651":61654,"_17922":105740,"_5":17817,"_24317":105601,"_2462":105741},[],"**Verificación del receptor.** Confirmar que `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_2936":61713,"_25651":61654,"_17922":105743,"_5":17817,"_24317":105601,"_2462":105744},[],"**Entrega.** Lanzar, o esperar a que ocurra, un enrolamiento o reenrolamiento a través de cada webhook migrado y confirmar que la llamada de autorización se completa.",{"_2936":61714,"_25651":61654,"_17922":105746,"_5":17817,"_24317":105601,"_2462":105747},[],"**Conjunto de confianza.** Leer `est_rfc7030_settings.client_certificate_settings.validation_cas` y confirmar que contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_2936":61715,"_25651":61654,"_17922":105749,"_5":17817,"_24317":105601,"_2462":105750},[],"**Clientes de la API.** Actualizar los scripts y consolas que usen el formato antiguo del DMS (`additional_validation_cas` plano, o los campos `mtls`, `apikey` y `oidc` heredados), ya que descartan esos valores sin avisar.",{"_2936":61716,"_25651":61654,"_17922":105752,"_5":17817,"_24317":105601,"_2462":102498},[],{"_2936":61717,"_25651":61654,"_17922":105754,"_5":17817,"_24317":105601,"_2462":105755},[],"<Card title=\"API DMS\" href=\"/docs/api-reference/dms-manager\" />",{"_49476":105757,"_49478":105758,"_49480":105759,"_49482":105760,"_15563":2484,"_59269":2484},"spanish",[2462,25651,5,24317],{"_2462":21398,"_25651":21398,"_5":21398,"_24317":21398},{"_2462":105761,"_25651":108206,"_5":110651,"_24317":113096},{"_3930":105762,"_49486":105763,"_5":21398},{"_12327":4002,"_12680":21658,"_12687":3550,"_24858":4913,"_24420":4303,"_17017":6389,"_12348":11942,"_12355":2830,"_24820":8737,"_25181":5877,"_25202":2653,"_24833":19562,"_29524":4291,"_25213":5815,"_29529":5288,"_29532":12736,"_29535":13636,"_29538":8710,"_29541":7776,"_25527":2902,"_29546":4313,"_29548":3671,"_25557":18812,"_25517":7322,"_29552":13423,"_29555":5445,"_29557":4246,"_25231":2626,"_25522":4041,"_25575":2855,"_29562":2852,"_29564":2536,"_29566":4117,"_29568":4051,"_29570":6245,"_29572":4440,"_29574":21403,"_29576":5551,"_29578":2793,"_24871":15361,"_29581":2761,"_29583":7162,"_24865":17283,"_29586":4739,"_29588":3383,"_29590":5833,"_29593":8950,"_24901":2725,"_29597":4611,"_24811":14319,"_29600":2611,"_24838":4261,"_29603":5170,"_29605":6430,"_2960