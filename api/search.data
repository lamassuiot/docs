7":58475,"_40469":58478,"_40471":58481,"_40473":58484,"_40475":58487,"_40477":58490,"_40480":58493,"_40482":58496,"_40484":58499,"_40486":58502,"_40488":58505,"_40490":58508,"_40492":58511,"_40494":58514,"_40496":58517,"_40498":58520,"_40500":58523,"_40502":58526,"_40504":58529,"_40506":58532,"_40508":58535,"_40510":58538,"_40512":58541,"_40514":58544,"_40516":58547,"_40518":58550,"_40520":58553,"_40522":58556,"_40524":58559,"_40526":58562,"_40528":58565,"_40530":58568,"_40533":58571,"_40535":58574,"_40537":58577,"_40539":58580},{"_3471":15,"_30355":15,"_5":14772,"_2954":49419,"_30687":49420,"_21010":49424,"_27589":15},"Deploy from AWS Marketplace",[49421,49422,49423],"Docs","Deployment","Other models",[],{"_3471":16,"_30355":15,"_21010":49426,"_5":14420,"_27589":15,"_2954":49427},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3471":17,"_30355":15,"_5":30684,"_21010":49429,"_27589":49430,"_2954":49431},[],"/docs/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3471":18,"_30355":15,"_5":30684,"_21010":49433,"_27589":49434,"_2954":49435},[],"/docs/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3471":19,"_30355":15,"_5":30684,"_21010":49437,"_27589":49438,"_2954":49439},[],"/docs/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3471":20,"_30355":15,"_5":30684,"_21010":49441,"_27589":49442,"_2954":49443},[],"/docs/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3471":21,"_30355":15,"_5":30684,"_21010":49445,"_27589":49446,"_2954":49447},[],"/docs/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3471":22,"_30355":15,"_5":30684,"_21010":49449,"_27589":49450,"_2954":49451},[],"/docs/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3471":23,"_30355":15,"_5":30684,"_21010":49453,"_27589":49454,"_2954":49455},[],"/docs/deployment/aws-marketplace#next-step","Next step",{"_3471":24,"_30355":15,"_21010":49457,"_5":14420,"_27589":15,"_2954":49458},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3471":25,"_30355":15,"_21010":49460,"_5":14420,"_27589":49430,"_2954":49461},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3471":26,"_30355":15,"_21010":49463,"_5":14420,"_27589":49430,"_2954":49464},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3471":27,"_30355":15,"_21010":49466,"_5":14420,"_27589":49430,"_2954":49467},[],"A security group allowing the necessary endpoints.",{"_3471":28,"_30355":15,"_21010":49469,"_5":14420,"_27589":49434,"_2954":49470},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3471":29,"_30355":15,"_21010":49472,"_5":14420,"_27589":49434,"_2954":49473},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3471":30,"_30355":15,"_21010":49475,"_5":14420,"_27589":49434,"_2954":49476},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3471":31,"_30355":15,"_21010":49478,"_5":14420,"_27589":49438,"_2954":49479},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3471":32,"_30355":15,"_21010":49481,"_5":14420,"_27589":49442,"_2954":49482},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3471":33,"_30355":15,"_21010":49484,"_5":14420,"_27589":49446,"_2954":49485},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3471":34,"_30355":15,"_21010":49487,"_5":14420,"_27589":49450,"_2954":49488},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3471":35,"_30355":15,"_21010":49490,"_5":14420,"_27589":49454,"_2954":49491},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3471":36,"_30355":36,"_5":14772,"_2954":49493,"_30687":49494,"_21010":49495,"_27589":36},"Deploy Lamassu",[49421,49422],[],{"_3471":37,"_30355":36,"_21010":49497,"_5":14420,"_27589":36,"_2954":49498},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3471":38,"_30355":36,"_5":30684,"_21010":49500,"_27589":49501,"_2954":49502},[],"/docs/deployment/overview#choose-a-model","Choose a model",{"_3471":39,"_30355":36,"_5":30684,"_21010":49504,"_27589":49505,"_2954":49506},[],"/docs/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3471":40,"_30355":36,"_5":30684,"_21010":49508,"_27589":49509,"_2954":49510},[],"/docs/deployment/overview#after-deployment","After deployment",{"_3471":41,"_30355":36,"_21010":49512,"_5":14420,"_27589":36,"_2954":49513},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3471":42,"_30355":36,"_21010":49515,"_5":14420,"_27589":49501,"_2954":49516},[],"Model",{"_3471":43,"_30355":36,"_21010":49518,"_5":14420,"_27589":49501,"_2954":49519},[],"Recommended for",{"_3471":44,"_30355":36,"_21010":49521,"_5":14420,"_27589":49501,"_2954":49522},[],"Who operates the infrastructure",{"_3471":45,"_30355":36,"_21010":49524,"_5":14420,"_27589":49501,"_2954":49525},[],"Starting point",{"_3471":46,"_30355":36,"_21010":49527,"_5":14420,"_27589":49501,"_2954":49528},[],"Kubernetes self-managed",{"_3471":47,"_30355":36,"_21010":49530,"_5":14420,"_27589":49501,"_2954":49531},[],"Production, regulated environments and custom deployments",{"_3471":48,"_30355":36,"_21010":49533,"_5":14420,"_27589":49501,"_2954":49534},[],"Your team",{"_3471":49,"_30355":36,"_21010":49536,"_5":14420,"_27589":49501,"_2954":49537},[],"Helm or Fastlane",{"_3471":50,"_30355":36,"_21010":49539,"_5":14420,"_27589":49501,"_2954":49540},[],"AWS Marketplace",{"_3471":51,"_30355":36,"_21010":49542,"_5":14420,"_27589":49501,"_2954":49543},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3471":52,"_30355":36,"_21010":49545,"_5":14420,"_27589":49501,"_2954":49534},[],{"_3471":53,"_30355":36,"_21010":49547,"_5":14420,"_27589":49501,"_2954":49548},[],"Preconfigured image on EC2",{"_3471":54,"_30355":36,"_21010":49550,"_5":14420,"_27589":49501,"_2954":49551},[],"SaaS",{"_3471":55,"_30355":36,"_21010":49553,"_5":14420,"_27589":49501,"_2954":49554},[],"Teams that want to use the platform without operating it",{"_3471":56,"_30355":36,"_21010":49556,"_5":14420,"_27589":49501,"_2954":49557},[],"Lamassu",{"_3471":57,"_30355":36,"_21010":49559,"_5":14420,"_27589":49501,"_2954":49560},[],"Managed subscription",{"_3471":58,"_30355":36,"_21010":49562,"_5":14420,"_27589":49501,"_2954":49563},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3471":59,"_30355":36,"_21010":49565,"_5":14420,"_27589":49501,"_2954":49566},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3471":60,"_30355":36,"_21010":49568,"_5":14420,"_27589":49501,"_2954":49569},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3471":61,"_30355":36,"_21010":49571,"_5":14420,"_27589":49505,"_2954":49572},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3471":62,"_30355":36,"_21010":49574,"_5":14420,"_27589":49509,"_2954":49575},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3471":63,"_30355":63,"_5":14772,"_2954":49577,"_30687":49578,"_21010":49579,"_27589":63},"Use Lamassu as SaaS",[49421,49422,49423],[],{"_3471":64,"_30355":63,"_21010":49581,"_5":14420,"_27589":63,"_2954":49582},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3471":65,"_30355":63,"_5":30684,"_21010":49584,"_27589":49585,"_2954":49586},[],"/docs/deployment/saas#what-the-service-manages","What the service manages",{"_3471":66,"_30355":63,"_5":30684,"_21010":49588,"_27589":49589,"_2954":49590},[],"/docs/deployment/saas#plans","Plans",{"_3471":67,"_30355":63,"_5":30684,"_21010":49592,"_27589":49593,"_2954":49594},[],"/docs/deployment/saas#request-access","Request access",{"_3471":68,"_30355":63,"_21010":49596,"_5":14420,"_27589":63,"_2954":49597},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3471":69,"_30355":63,"_21010":49599,"_5":14420,"_27589":49585,"_2954":49600},[],"Platform availability and maintenance.",{"_3471":70,"_30355":63,"_21010":49602,"_5":14420,"_27589":49585,"_2954":49603},[],"Automatic backups.",{"_3471":71,"_30355":63,"_21010":49605,"_5":14420,"_27589":49585,"_2954":49606},[],"Version upgrades.",{"_3471":72,"_30355":63,"_21010":49608,"_5":14420,"_27589":49585,"_2954":49609},[],"Technical support and SLA according to your plan.",{"_3471":73,"_30355":63,"_21010":49611,"_5":14420,"_27589":49589,"_2954":49612},[],"Plan",{"_3471":74,"_30355":63,"_21010":49614,"_5":14420,"_27589":49589,"_2954":49615},[],"Devices",{"_3471":75,"_30355":63,"_21010":49617,"_5":14420,"_27589":49589,"_2954":49618},[],"Support",{"_3471":76,"_30355":63,"_21010":49620,"_5":14420,"_27589":49589,"_2954":49621},[],"SLA",{"_3471":77,"_30355":63,"_21010":49623,"_5":14420,"_27589":49589,"_2954":49624},[],"Starter",{"_3471":78,"_30355":63,"_21010":49626,"_5":14420,"_27589":49589,"_2954":49627},[],"Up to 1,000",{"_3471":79,"_30355":63,"_21010":49629,"_5":14420,"_27589":49589,"_2954":49630},[],"Email",{"_3471":80,"_30355":63,"_21010":49632,"_5":14420,"_27589":49589,"_2954":49633},[],"99.5 %",{"_3471":81,"_30355":63,"_21010":49635,"_5":14420,"_27589":49589,"_2954":49636},[],"Professional",{"_3471":82,"_30355":63,"_21010":49638,"_5":14420,"_27589":49589,"_2954":49639},[],"Up to 10,000",{"_3471":83,"_30355":63,"_21010":49641,"_5":14420,"_27589":49589,"_2954":49642},[],"Email and chat",{"_3471":84,"_30355":63,"_21010":49644,"_5":14420,"_27589":49589,"_2954":49645},[],"99.9 %",{"_3471":85,"_30355":63,"_21010":49647,"_5":14420,"_27589":49589,"_2954":49648},[],"Enterprise",{"_3471":86,"_30355":63,"_21010":49650,"_5":14420,"_27589":49589,"_2954":49651},[],"Unlimited",{"_3471":87,"_30355":63,"_21010":49653,"_5":14420,"_27589":49589,"_2954":49654},[],"Dedicated",{"_3471":88,"_30355":63,"_21010":49656,"_5":14420,"_27589":49589,"_2954":49657},[],"99.99 %",{"_3471":89,"_30355":63,"_21010":49659,"_5":14420,"_27589":49593,"_2954":49660},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3471":90,"_30355":63,"_21010":49662,"_5":14420,"_27589":49593,"_2954":49663},[],"When you receive your instance's credentials, continue with Get started.",{"_3471":91,"_30355":91,"_5":14772,"_2954":49665,"_30687":49666,"_21010":49667,"_27589":91},"Fastlane",[49421,49422,49528],[],{"_3471":92,"_30355":91,"_21010":49669,"_5":14420,"_27589":91,"_2954":49670},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3471":93,"_30355":91,"_5":30684,"_21010":49672,"_27589":49673,"_2954":49674},[],"/docs/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3471":94,"_30355":91,"_5":30684,"_21010":49676,"_27589":49677,"_2954":49678},[],"/docs/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3471":95,"_30355":91,"_5":30684,"_21010":49680,"_27589":49681,"_2954":49431},[],"/docs/deployment/self-hosted/fastlane#before-you-begin",{"_3471":96,"_30355":91,"_5":30684,"_21010":49683,"_27589":49684,"_2954":49685},[],"/docs/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3471":97,"_30355":91,"_5":30684,"_21010":49687,"_27589":49688,"_2954":49689},[],"/docs/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3471":98,"_30355":91,"_5":30684,"_21010":49691,"_27589":49692,"_2954":49693},[],"/docs/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3471":99,"_30355":91,"_5":30684,"_21010":49695,"_27589":49696,"_2954":49697},[],"/docs/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3471":100,"_30355":91,"_5":30684,"_21010":49699,"_27589":49700,"_2954":49701},[],"/docs/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3471":101,"_30355":91,"_5":30684,"_21010":49703,"_27589":49704,"_2954":49705},[],"/docs/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3471":102,"_30355":91,"_5":30684,"_21010":49707,"_27589":49708,"_2954":49709},[],"/docs/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3471":103,"_30355":91,"_5":30684,"_21010":49711,"_27589":49712,"_2954":49713},[],"/docs/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3471":104,"_30355":91,"_21010":49715,"_5":14420,"_27589":49673,"_2954":49716},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3471":105,"_30355":91,"_21010":49718,"_5":14420,"_27589":49673,"_2954":49719},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3471":106,"_30355":91,"_21010":49721,"_5":14420,"_27589":49677,"_2954":49722},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3471":107,"_30355":91,"_21010":49724,"_5":14420,"_27589":49677,"_2954":49725},[],"Fastlane installs or configures",{"_3471":108,"_30355":91,"_21010":49727,"_5":14420,"_27589":49677,"_2954":49728},[],"You still provide",{"_3471":109,"_30355":91,"_21010":49730,"_5":14420,"_27589":49677,"_2954":49731},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3471":110,"_30355":91,"_21010":49733,"_5":14420,"_27589":49677,"_2954":49734},[],"The Kubernetes cluster, nodes and persistent storage",{"_3471":111,"_30355":91,"_21010":49736,"_5":14420,"_27589":49677,"_2954":49737},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3471":112,"_30355":91,"_21010":49739,"_5":14420,"_27589":49677,"_2954":49740},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3471":113,"_30355":91,"_21010":49742,"_5":14420,"_27589":49677,"_2954":49743},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3471":114,"_30355":91,"_21010":49745,"_5":14420,"_27589":49677,"_2954":49746},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3471":115,"_30355":91,"_21010":49748,"_5":14420,"_27589":49677,"_2954":49749},[],"Optional observability and lab HSM components",{"_3471":116,"_30355":91,"_21010":49751,"_5":14420,"_27589":49677,"_2954":49752},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3471":117,"_30355":91,"_21010":49754,"_5":14420,"_27589":49677,"_2954":49755},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3471":118,"_30355":91,"_21010":49757,"_5":14420,"_27589":49681,"_2954":49758},[],"You need:",{"_3471":119,"_30355":91,"_21010":49760,"_5":14420,"_27589":49681,"_2954":49761},[],"an existing Kubernetes cluster",{"_3471":120,"_30355":91,"_21010":49763,"_5":14420,"_27589":49681,"_2954":49764},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3471":121,"_30355":91,"_21010":49766,"_5":14420,"_27589":49681,"_2954":49767},[],"`yq`",{"_3471":122,"_30355":91,"_21010":49769,"_5":14420,"_27589":49681,"_2954":23761},[],{"_3471":123,"_30355":91,"_21010":49771,"_5":14420,"_27589":49681,"_2954":49772},[],"`jq` only when using `--sample-data` or `--development`",{"_3471":124,"_30355":91,"_21010":49774,"_5":14420,"_27589":49681,"_2954":49775},[],"`ssh-keygen` only when using `--with-hsm`",{"_3471":125,"_30355":91,"_21010":49777,"_5":14420,"_27589":49681,"_2954":49778},[],"free external ports 80 and 443 on a single-node K3s host",{"_3471":126,"_30355":91,"_21010":49780,"_5":14420,"_27589":49681,"_2954":49781},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3471":127,"_30355":91,"_21010":49783,"_5":14420,"_27589":49681,"_2954":49784},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3471":128,"_30355":91,"_21010":49786,"_5":14420,"_27589":49684,"_2954":49787},[],"Run the script from a clone of the Helm repository:",{"_3471":129,"_30355":91,"_21010":49789,"_5":14420,"_27589":49684,"_2954":49790},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3471":130,"_30355":91,"_21010":49792,"_5":14420,"_27589":49688,"_2954":49793},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3471":131,"_30355":91,"_21010":49795,"_5":14420,"_27589":49688,"_2954":49796},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3471":132,"_30355":91,"_21010":49798,"_5":14420,"_27589":49688,"_2954":49799},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3471":133,"_30355":91,"_21010":49801,"_5":14420,"_27589":49688,"_2954":49802},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3471":134,"_30355":91,"_21010":49804,"_5":14420,"_27589":49692,"_2954":49805},[],"Option",{"_3471":135,"_30355":91,"_21010":49807,"_5":14420,"_27589":49692,"_2954":49808},[],"Default",{"_3471":136,"_30355":91,"_21010":49810,"_5":14420,"_27589":49692,"_2954":49811},[],"Purpose",{"_3471":137,"_30355":91,"_21010":49813,"_5":14420,"_27589":49692,"_2954":49814},[],"`-h`, `--help`",{"_3471":138,"_30355":91,"_21010":49816,"_5":14420,"_27589":49692,"_2954":49817},[],"—",{"_3471":139,"_30355":91,"_21010":49819,"_5":14420,"_27589":49692,"_2954":49820},[],"Show help",{"_3471":140,"_30355":91,"_21010":49822,"_5":14420,"_27589":49692,"_2954":49823},[],"`-c`, `--context`",{"_3471":141,"_30355":91,"_21010":49825,"_5":14420,"_27589":49692,"_2954":49826},[],"current context",{"_3471":142,"_30355":91,"_21010":49828,"_5":14420,"_27589":49692,"_2954":49829},[],"Select the kubeconfig context for kubectl and Helm",{"_3471":143,"_30355":91,"_21010":49831,"_5":14420,"_27589":49692,"_2954":49832},[],"`-n`, `--non-interactive`",{"_3471":144,"_30355":91,"_21010":49834,"_5":14420,"_27589":49692,"_2954":6569},[],{"_3471":145,"_30355":91,"_21010":49836,"_5":14420,"_27589":49692,"_2954":49837},[],"Skip prompts and generate dependency credentials",{"_3471":146,"_30355":91,"_21010":49839,"_5":14420,"_27589":49692,"_2954":49840},[],"`-ns`, `--namespace`",{"_3471":147,"_30355":91,"_21010":49842,"_5":14420,"_27589":49692,"_2954":49843},[],"`lamassu-dev`",{"_3471":148,"_30355":91,"_21010":49845,"_5":14420,"_27589":49692,"_2954":49846},[],"Namespace for the installation",{"_3471":149,"_30355":91,"_21010":49848,"_5":14420,"_27589":49692,"_2954":49849},[],"`-d`, `--domain`",{"_3471":150,"_30355":91,"_21010":49851,"_5":14420,"_27589":49692,"_2954":49852},[],"`dev.lamassu.io`",{"_3471":151,"_30355":91,"_21010":49854,"_5":14420,"_27589":49692,"_2954":49855},[],"Domain used by the UI, OIDC and certificate",{"_3471":152,"_30355":91,"_21010":49857,"_5":14420,"_27589":49692,"_2954":49858},[],"`-v`, `--version`",{"_3471":153,"_30355":91,"_21010":49860,"_5":14420,"_27589":49692,"_2954":15124},[],{"_3471":154,"_30355":91,"_21010":49862,"_5":14420,"_27589":49692,"_2954":49863},[],"Lamassu chart version",{"_3471":155,"_30355":91,"_21010":49865,"_5":14420,"_27589":49692,"_2954":49866},[],"`--https-port`",{"_3471":156,"_30355":91,"_21010":49868,"_5":14420,"_27589":49692,"_2954":49869},[],"`443`",{"_3471":157,"_30355":91,"_21010":49871,"_5":14420,"_27589":49692,"_2954":49872},[],"Gateway HTTPS listener port",{"_3471":158,"_30355":91,"_21010":49874,"_5":14420,"_27589":49692,"_2954":49875},[],"`--http-port`",{"_3471":159,"_30355":91,"_21010":49877,"_5":14420,"_27589":49692,"_2954":49878},[],"`80`",{"_3471":160,"_30355":91,"_21010":49880,"_5":14420,"_27589":49692,"_2954":49881},[],"Gateway HTTP listener port",{"_3471":161,"_30355":91,"_21010":49883,"_5":14420,"_27589":49692,"_2954":49884},[],"`--tls-crt`",{"_3471":162,"_30355":91,"_21010":49886,"_5":14420,"_27589":49692,"_2954":49817},[],{"_3471":163,"_30355":91,"_21010":49888,"_5":14420,"_27589":49692,"_2954":49889},[],"PEM certificate for downstream TLS",{"_3471":164,"_30355":91,"_21010":49891,"_5":14420,"_27589":49692,"_2954":49892},[],"`--tls-key`",{"_3471":165,"_30355":91,"_21010":49894,"_5":14420,"_27589":49692,"_2954":49817},[],{"_3471":166,"_30355":91,"_21010":49896,"_5":14420,"_27589":49692,"_2954":49897},[],"PEM private key for downstream TLS",{"_3471":167,"_30355":91,"_21010":49899,"_5":14420,"_27589":49692,"_2954":49900},[],"`-l`, `--local-chart-path`",{"_3471":168,"_30355":91,"_21010":49902,"_5":14420,"_27589":49692,"_2954":49903},[],"repository chart",{"_3471":169,"_30355":91,"_21010":49905,"_5":14420,"_27589":49692,"_2954":49906},[],"Use an unpacked local Lamassu chart",{"_3471":170,"_30355":91,"_21010":49908,"_5":14420,"_27589":49692,"_2954":49909},[],"`-ip`, `--gateway-ip`",{"_3471":171,"_30355":91,"_21010":49911,"_5":14420,"_27589":49692,"_2954":8771},[],{"_3471":172,"_30355":91,"_21010":49913,"_5":14420,"_27589":49692,"_2954":49914},[],"Override the address written to `gateway.addresses`",{"_3471":173,"_30355":91,"_21010":49916,"_5":14420,"_27589":49692,"_2954":49917},[],"`--otel`",{"_3471":174,"_30355":91,"_21010":49919,"_5":14420,"_27589":49692,"_2954":6569},[],{"_3471":175,"_30355":91,"_21010":49921,"_5":14420,"_27589":49692,"_2954":49922},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3471":176,"_30355":91,"_21010":49924,"_5":14420,"_27589":49692,"_2954":49925},[],"`--development`",{"_3471":177,"_30355":91,"_21010":49927,"_5":14420,"_27589":49692,"_2954":6569},[],{"_3471":178,"_30355":91,"_21010":49929,"_5":14420,"_27589":49692,"_2954":49930},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3471":179,"_30355":91,"_21010":49932,"_5":14420,"_27589":49692,"_2954":49933},[],"`--sample-data`",{"_3471":180,"_30355":91,"_21010":49935,"_5":14420,"_27589":49692,"_2954":6569},[],{"_3471":181,"_30355":91,"_21010":49937,"_5":14420,"_27589":49692,"_2954":49938},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3471":182,"_30355":91,"_21010":49940,"_5":14420,"_27589":49692,"_2954":49941},[],"`--with-hsm`",{"_3471":183,"_30355":91,"_21010":49943,"_5":14420,"_27589":49692,"_2954":6569},[],{"_3471":184,"_30355":91,"_21010":49945,"_5":14420,"_27589":49692,"_2954":49946},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3471":185,"_30355":91,"_21010":49948,"_5":14420,"_27589":49692,"_2954":49949},[],"`--softhsm-chart-path`",{"_3471":186,"_30355":91,"_21010":49951,"_5":14420,"_27589":49692,"_2954":49952},[],"`./charts/softhsm`",{"_3471":187,"_30355":91,"_21010":49954,"_5":14420,"_27589":49692,"_2954":49955},[],"Use a different local SoftHSM chart",{"_3471":188,"_30355":91,"_21010":49957,"_5":14420,"_27589":49692,"_2954":49958},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3471":189,"_30355":91,"_21010":49960,"_5":14420,"_27589":49696,"_2954":49961},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3471":190,"_30355":91,"_21010":49963,"_5":14420,"_27589":49696,"_2954":49964},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3471":191,"_30355":91,"_21010":49966,"_5":14420,"_27589":49696,"_2954":49967},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3471":192,"_30355":91,"_21010":49969,"_5":14420,"_27589":49696,"_2954":49970},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3471":193,"_30355":91,"_21010":49972,"_5":14420,"_27589":49696,"_2954":49973},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3471":194,"_30355":91,"_21010":49975,"_5":14420,"_27589":49696,"_2954":49976},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3471":195,"_30355":91,"_21010":49978,"_5":14420,"_27589":49700,"_2954":49979},[],"Fastlane:",{"_3471":196,"_30355":91,"_21010":49981,"_5":14420,"_27589":49700,"_2954":49982},[],"validates local tools and the selected cluster",{"_3471":197,"_30355":91,"_21010":49984,"_5":14420,"_27589":49700,"_2954":49985},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3471":198,"_30355":91,"_21010":49987,"_5":14420,"_27589":49700,"_2954":49988},[],"creates the namespace",{"_3471":199,"_30355":91,"_21010":49990,"_5":14420,"_27589":49700,"_2954":49991},[],"installs PostgreSQL and creates the required databases",{"_3471":200,"_30355":91,"_21010":49993,"_5":14420,"_27589":49700,"_2954":49994},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3471":201,"_30355":91,"_21010":49996,"_5":14420,"_27589":49700,"_2954":49997},[],"installs RabbitMQ",{"_3471":202,"_30355":91,"_21010":49999,"_5":14420,"_27589":49700,"_2954":50000},[],"optionally installs observability and lab HSM components",{"_3471":203,"_30355":91,"_21010":50002,"_5":14420,"_27589":49700,"_2954":50003},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3471":204,"_30355":91,"_21010":50005,"_5":14420,"_27589":49700,"_2954":50006},[],"optionally loads sample data",{"_3471":205,"_30355":91,"_21010":50008,"_5":14420,"_27589":49700,"_2954":50009},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3471":206,"_30355":91,"_21010":50011,"_5":14420,"_27589":49704,"_2954":50012},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3471":207,"_30355":91,"_21010":50014,"_5":14420,"_27589":49704,"_2954":50015},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3471":208,"_30355":91,"_21010":50017,"_5":14420,"_27589":49708,"_2954":50018},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3471":209,"_30355":91,"_21010":50020,"_5":14420,"_27589":49708,"_2954":50021},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3471":210,"_30355":91,"_21010":50023,"_5":14420,"_27589":49708,"_2954":50024},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3471":211,"_30355":91,"_21010":50026,"_5":14420,"_27589":49712,"_2954":50027},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3471":212,"_30355":212,"_5":14772,"_2954":50029,"_30687":50030,"_21010":50031,"_27589":212},"Install with Helm",[49421,49422,49528],[],{"_3471":213,"_30355":212,"_21010":50033,"_5":14420,"_27589":212,"_2954":50034},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3471":214,"_30355":212,"_5":30684,"_21010":50036,"_27589":50037,"_2954":50038},[],"/docs/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3471":215,"_30355":212,"_5":30684,"_21010":50040,"_27589":50041,"_2954":49431},[],"/docs/deployment/self-hosted/helm#before-you-begin",{"_3471":216,"_30355":212,"_5":30684,"_21010":50043,"_27589":50044,"_2954":50045},[],"/docs/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3471":217,"_30355":212,"_5":30684,"_21010":50047,"_27589":50048,"_2954":50049},[],"/docs/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3471":218,"_30355":212,"_5":30684,"_21010":50051,"_27589":50052,"_2954":50053},[],"/docs/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3471":219,"_30355":212,"_5":30684,"_21010":50055,"_27589":50056,"_2954":50057},[],"/docs/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3471":220,"_30355":212,"_5":30684,"_21010":50059,"_27589":50060,"_2954":50061},[],"/docs/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3471":221,"_30355":212,"_5":30684,"_21010":50063,"_27589":50064,"_2954":50065},[],"/docs/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3471":222,"_30355":212,"_5":30684,"_21010":50067,"_27589":50068,"_2954":50069},[],"/docs/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3471":223,"_30355":212,"_5":30684,"_21010":50071,"_27589":50072,"_2954":50073},[],"/docs/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3471":224,"_30355":212,"_5":30684,"_21010":50075,"_27589":50076,"_2954":50077},[],"/docs/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3471":225,"_30355":212,"_21010":50079,"_5":14420,"_27589":50037,"_2954":50080},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3471":226,"_30355":212,"_21010":50082,"_5":14420,"_27589":50041,"_2954":50083},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3471":227,"_30355":212,"_21010":50085,"_5":14420,"_27589":50041,"_2954":50086},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3471":228,"_30355":212,"_21010":50088,"_5":14420,"_27589":50041,"_2954":50089},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3471":229,"_30355":212,"_21010":50091,"_5":14420,"_27589":50041,"_2954":50092},[],"a reachable RabbitMQ broker and credentials",{"_3471":230,"_30355":212,"_21010":50094,"_5":14420,"_27589":50041,"_2954":50095},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3471":231,"_30355":212,"_21010":50097,"_5":14420,"_27589":50041,"_2954":50098},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3471":232,"_30355":212,"_21010":50100,"_5":14420,"_27589":50041,"_2954":50101},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3471":233,"_30355":212,"_21010":50103,"_5":14420,"_27589":50041,"_2954":50104},[],"a StorageClass and an external traffic design",{"_3471":234,"_30355":212,"_21010":50106,"_5":14420,"_27589":50041,"_2954":50107},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3471":235,"_30355":212,"_21010":50109,"_5":14420,"_27589":50041,"_2954":50110},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3471":236,"_30355":212,"_21010":50112,"_5":14420,"_27589":50041,"_2954":50113},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3471":237,"_30355":212,"_21010":50115,"_5":14420,"_27589":50044,"_2954":50116},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3471":238,"_30355":212,"_21010":50118,"_5":14420,"_27589":50044,"_2954":50119},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3471":239,"_30355":212,"_21010":50121,"_5":14420,"_27589":50044,"_2954":50122},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3471":240,"_30355":212,"_21010":50124,"_5":14420,"_27589":50048,"_2954":50125},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3471":241,"_30355":212,"_21010":50127,"_5":14420,"_27589":50048,"_2954":50128},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3471":242,"_30355":212,"_21010":50130,"_5":14420,"_27589":50048,"_2954":50131},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3471":243,"_30355":212,"_21010":50133,"_5":14420,"_27589":50048,"_2954":50134},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3471":244,"_30355":212,"_21010":50136,"_5":14420,"_27589":50052,"_2954":50137},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3471":245,"_30355":212,"_21010":50139,"_5":14420,"_27589":50056,"_2954":50140},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3471":246,"_30355":212,"_21010":50142,"_5":14420,"_27589":50056,"_2954":50143},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3471":247,"_30355":212,"_21010":50145,"_5":14420,"_27589":50056,"_2954":50146},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3471":248,"_30355":212,"_21010":50148,"_5":14420,"_27589":50056,"_2954":50149},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3471":249,"_30355":212,"_21010":50151,"_5":14420,"_27589":50056,"_2954":50152},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3471":250,"_30355":212,"_21010":50154,"_5":14420,"_27589":50056,"_2954":50155},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3471":251,"_30355":212,"_21010":50157,"_5":14420,"_27589":50056,"_2954":50158},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3471":252,"_30355":212,"_21010":50160,"_5":14420,"_27589":50060,"_2954":50161},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3471":253,"_30355":212,"_21010":50163,"_5":14420,"_27589":50060,"_2954":50164},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3471":254,"_30355":212,"_21010":50166,"_5":14420,"_27589":50060,"_2954":50167},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3471":255,"_30355":212,"_21010":50169,"_5":14420,"_27589":50060,"_2954":50170},[],"See Access control for the principal and policy model.",{"_3471":256,"_30355":212,"_21010":50172,"_5":14420,"_27589":50064,"_2954":50173},[],"To install a local checkout instead:",{"_3471":257,"_30355":212,"_21010":50175,"_5":14420,"_27589":50068,"_2954":50176},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3471":258,"_30355":212,"_21010":50178,"_5":14420,"_27589":50068,"_2954":50179},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3471":259,"_30355":212,"_21010":50181,"_5":14420,"_27589":50072,"_2954":50182},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3471":260,"_30355":212,"_21010":50184,"_5":14420,"_27589":50072,"_2954":50185},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3471":261,"_30355":212,"_21010":50187,"_5":14420,"_27589":50072,"_2954":50188},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3471":262,"_30355":212,"_21010":50190,"_5":14420,"_27589":50072,"_2954":50191},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3471":263,"_30355":212,"_21010":50193,"_5":14420,"_27589":50072,"_2954":50194},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3471":264,"_30355":212,"_21010":50196,"_5":14420,"_27589":50076,"_2954":50197},[],"Before going live, review:",{"_3471":265,"_30355":212,"_21010":50199,"_5":14420,"_27589":50076,"_2954":50200},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3471":266,"_30355":212,"_21010":50202,"_5":14420,"_27589":50076,"_2954":50203},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3471":267,"_30355":212,"_21010":50205,"_5":14420,"_27589":50076,"_2954":50206},[],"shared VA storage before increasing VA replicas",{"_3471":268,"_30355":212,"_21010":50208,"_5":14420,"_27589":50076,"_2954":50209},[],"managed OIDC roles and removal of evaluation credentials",{"_3471":269,"_30355":212,"_21010":50211,"_5":14420,"_27589":50076,"_2954":50212},[],"a trusted TLS issuer or externally managed certificate",{"_3471":270,"_30355":212,"_21010":50214,"_5":14420,"_27589":50076,"_2954":50215},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3471":271,"_30355":212,"_21010":50217,"_5":14420,"_27589":50076,"_2954":50218},[],"SMTP, observability and alert delivery",{"_3471":272,"_30355":212,"_21010":50220,"_5":14420,"_27589":50076,"_2954":50221},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3471":273,"_30355":212,"_21010":50223,"_5":14420,"_27589":50076,"_2954":50224},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3471":274,"_30355":274,"_5":14772,"_2954":50226,"_30687":50227,"_21010":50228,"_27589":274},"Expose the Gateway",[49421,49422,49528],[],{"_3471":275,"_30355":274,"_21010":50230,"_5":14420,"_27589":274,"_2954":50231},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3471":276,"_30355":274,"_5":30684,"_21010":50233,"_27589":50234,"_2954":50235},[],"/docs/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3471":277,"_30355":274,"_5":30684,"_21010":50237,"_27589":50238,"_2954":50239},[],"/docs/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3471":278,"_30355":274,"_5":30684,"_21010":50241,"_27589":50242,"_2954":50243},[],"/docs/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3471":279,"_30355":274,"_5":30684,"_21010":50245,"_27589":50246,"_2954":50247},[],"/docs/deployment/self-hosted/networking#k3s","K3s",{"_3471":280,"_30355":274,"_5":30684,"_21010":50249,"_27589":50250,"_2954":50251},[],"/docs/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3471":281,"_30355":274,"_5":30684,"_21010":50253,"_27589":50254,"_2954":50255},[],"/docs/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3471":282,"_30355":274,"_5":30684,"_21010":50257,"_27589":50258,"_2954":50259},[],"/docs/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3471":283,"_30355":274,"_5":30684,"_21010":50261,"_27589":50262,"_2954":50263},[],"/docs/deployment/self-hosted/networking#client-certificates-and-identity-headers","Client certificates and identity headers",{"_3471":284,"_30355":274,"_5":30684,"_21010":50265,"_27589":50266,"_2954":50267},[],"/docs/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3471":285,"_30355":274,"_5":30684,"_21010":50269,"_27589":50270,"_2954":50271},[],"/docs/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3471":286,"_30355":274,"_5":30684,"_21010":50273,"_27589":50274,"_2954":50275},[],"/docs/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3471":287,"_30355":274,"_21010":50277,"_5":14420,"_27589":50234,"_2954":50278},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3471":288,"_30355":274,"_21010":50280,"_5":14420,"_27589":50234,"_2954":50281},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3471":289,"_30355":274,"_21010":50283,"_5":14420,"_27589":50238,"_2954":50284},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3471":290,"_30355":274,"_21010":50286,"_5":14420,"_27589":50238,"_2954":50287},[],"Set it only when:",{"_3471":291,"_30355":274,"_21010":50289,"_5":14420,"_27589":50238,"_2954":50290},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3471":292,"_30355":274,"_21010":50292,"_5":14420,"_27589":50238,"_2954":50293},[],"that address is allocated to this Gateway",{"_3471":293,"_30355":274,"_21010":50295,"_5":14420,"_27589":50238,"_2954":50296},[],"the surrounding network already routes traffic for it to the cluster",{"_3471":294,"_30355":274,"_21010":50298,"_5":14420,"_27589":50238,"_2954":50299},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3471":295,"_30355":274,"_21010":50301,"_5":14420,"_27589":50238,"_2954":50302},[],"Keep these two settings separate:",{"_3471":296,"_30355":274,"_21010":50304,"_5":14420,"_27589":50238,"_2954":50305},[],"`gateway.addresses` requests an address for the Gateway.",{"_3471":297,"_30355":274,"_21010":50307,"_5":14420,"_27589":50238,"_2954":50308},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3471":298,"_30355":274,"_21010":50310,"_5":14420,"_27589":50238,"_2954":50311},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3471":299,"_30355":274,"_21010":50313,"_5":14420,"_27589":50242,"_2954":50314},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3471":300,"_30355":274,"_21010":50316,"_5":14420,"_27589":50242,"_2954":50317},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3471":301,"_30355":274,"_21010":50319,"_5":14420,"_27589":50246,"_2954":50320},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3471":302,"_30355":274,"_21010":50322,"_5":14420,"_27589":50246,"_2954":50323},[],"For the recommended design:",{"_3471":303,"_30355":274,"_21010":50325,"_5":14420,"_27589":50246,"_2954":50326},[],"Use only one externally exposed Lamassu Gateway.",{"_3471":304,"_30355":274,"_21010":50328,"_5":14420,"_27589":50246,"_2954":50329},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3471":305,"_30355":274,"_21010":50331,"_5":14420,"_27589":50246,"_2954":50332},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3471":306,"_30355":274,"_21010":50334,"_5":14420,"_27589":50246,"_2954":50335},[],"Point DNS at the VM's reachable address.",{"_3471":307,"_30355":274,"_21010":50337,"_5":14420,"_27589":50246,"_2954":50338},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3471":308,"_30355":274,"_21010":50340,"_5":14420,"_27589":50250,"_2954":50341},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3471":309,"_30355":274,"_21010":50343,"_5":14420,"_27589":50254,"_2954":50344},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3471":310,"_30355":274,"_21010":50346,"_5":14420,"_27589":50254,"_2954":50347},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3471":311,"_30355":274,"_21010":50349,"_5":14420,"_27589":50258,"_2954":50350},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3471":312,"_30355":274,"_21010":50352,"_5":14420,"_27589":50258,"_2954":50353},[],"Requirement",{"_3471":313,"_30355":274,"_21010":50355,"_5":14420,"_27589":50258,"_2954":50356},[],"Recommended design",{"_3471":314,"_30355":274,"_21010":50358,"_5":14420,"_27589":50258,"_2954":50359},[],"Consequence",{"_3471":315,"_30355":274,"_21010":50361,"_5":14420,"_27589":50258,"_2954":50362},[],"Several Lamassu URLs or services",{"_3471":316,"_30355":274,"_21010":50364,"_5":14420,"_27589":50258,"_2954":50365},[],"One Gateway with multiple routes",{"_3471":317,"_30355":274,"_21010":50367,"_5":14420,"_27589":50258,"_2954":50368},[],"One IP and one proxy fleet; this is the chart default",{"_3471":318,"_30355":274,"_21010":50370,"_5":14420,"_27589":50258,"_2954":50371},[],"Independent Gateways and separate external IPs",{"_3471":319,"_30355":274,"_21010":50373,"_5":14420,"_27589":50258,"_2954":50374},[],"One VIP per Gateway",{"_3471":320,"_30355":274,"_21010":50376,"_5":14420,"_27589":50258,"_2954":50377},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3471":321,"_30355":274,"_21010":50379,"_5":14420,"_27589":50258,"_2954":50380},[],"Independent Gateways on one node and one IP",{"_3471":322,"_30355":274,"_21010":50382,"_5":14420,"_27589":50258,"_2954":50383},[],"Use different external ports",{"_3471":323,"_30355":274,"_21010":50385,"_5":14420,"_27589":50258,"_2954":50386},[],"Clients must include non-standard ports",{"_3471":324,"_30355":274,"_21010":50388,"_5":14420,"_27589":50258,"_2954":50389},[],"Separate TLS/mTLS termination behind one IP",{"_3471":325,"_30355":274,"_21010":50391,"_5":14420,"_27589":50258,"_2954":50392},[],"Front-door SNI routing to internal Gateways",{"_3471":326,"_30355":274,"_21010":50394,"_5":14420,"_27589":50258,"_2954":50395},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3471":327,"_30355":274,"_21010":50397,"_5":14420,"_27589":50258,"_2954":50398},[],"Separate Gateway resources but shared proxy infrastructure",{"_3471":328,"_30355":274,"_21010":50400,"_5":14420,"_27589":50258,"_2954":50401},[],"Envoy merged-Gateway mode",{"_3471":329,"_30355":274,"_21010":50403,"_5":14420,"_27589":50258,"_2954":50404},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3471":330,"_30355":274,"_21010":50406,"_5":14420,"_27589":50258,"_2954":50407},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3471":331,"_30355":274,"_21010":50409,"_5":14420,"_27589":50258,"_2954":50410},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3471":332,"_30355":274,"_21010":50412,"_5":14420,"_27589":50258,"_2954":50413},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3471":333,"_30355":274,"_21010":50415,"_5":14420,"_27589":50258,"_2954":50416},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3471":334,"_30355":274,"_21010":50418,"_5":14420,"_27589":50262,"_2954":50419},[],"The chart renders a `ClientTrafficPolicy` named `enable-mtls` on its shared Gateway automatically; no Helm value enables or disables it. TLS termination accepts requests with or without a client certificate: devices may present one, but they are not required to. Before forwarding a request, the Gateway removes identity and certificate headers that a client could otherwise supply itself: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (the Traefik spelling), `Ssl-Client-Cert` and `X-Amzn-Mtls-Clientcert`. The Traefik spelling is included because backends that accept `X-Forwarded-Tls-Client-Cert` directly would otherwise receive certificate identity data supplied by the client itself, without a client certificate having been presented. After stripping, Envoy adds its own `X-Forwarded-Client-Cert` carrying the presented certificate and its chain, so services that read certificate identity receive only gateway-generated values. No Helm value changes the list of stripped headers. The Access control page describes how `authz` uses this protection to keep `X-Principal-ID` out of reach of clients.",{"_3471":335,"_30355":274,"_21010":50421,"_5":14420,"_27589":50266,"_2954":50422},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3471":336,"_30355":274,"_21010":50424,"_5":14420,"_27589":50266,"_2954":50425},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3471":337,"_30355":274,"_21010":50427,"_5":14420,"_27589":50266,"_2954":50428},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3471":338,"_30355":274,"_21010":50430,"_5":14420,"_27589":50266,"_2954":50431},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3471":339,"_30355":274,"_21010":50433,"_5":14420,"_27589":50266,"_2954":50434},[],"If none of those are possible, use different external ports or change the external network design.",{"_3471":340,"_30355":274,"_21010":50436,"_5":14420,"_27589":50270,"_2954":50437},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3471":341,"_30355":274,"_21010":50439,"_5":14420,"_27589":50270,"_2954":50440},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3471":342,"_30355":274,"_21010":50442,"_5":14420,"_27589":50274,"_2954":50443},[],"Check, in order:",{"_3471":343,"_30355":274,"_21010":50445,"_5":14420,"_27589":50274,"_2954":50446},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3471":344,"_30355":274,"_21010":50448,"_5":14420,"_27589":50274,"_2954":50449},[],"Its status contains the expected address.",{"_3471":345,"_30355":274,"_21010":50451,"_5":14420,"_27589":50274,"_2954":50452},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3471":346,"_30355":274,"_21010":50454,"_5":14420,"_27589":50274,"_2954":50455},[],"Port 443 reaches that address from the client network.",{"_3471":347,"_30355":274,"_21010":50457,"_5":14420,"_27589":50274,"_2954":50458},[],"DNS resolves to the externally reachable endpoint.",{"_3471":348,"_30355":274,"_21010":50460,"_5":14420,"_27589":50274,"_2954":50461},[],"The certificate contains the DNS name or IP used by the client.",{"_3471":349,"_30355":274,"_21010":50463,"_5":14420,"_27589":50274,"_2954":50464},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3471":350,"_30355":350,"_5":14772,"_2954":49528,"_30687":50466,"_21010":50467,"_27589":350},[49421,49422,49528],[],{"_3471":351,"_30355":350,"_21010":50469,"_5":14420,"_27589":350,"_2954":50470},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3471":352,"_30355":350,"_5":30684,"_21010":50472,"_27589":50473,"_2954":50474},[],"/docs/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3471":353,"_30355":350,"_5":30684,"_21010":50476,"_27589":50477,"_2954":50478},[],"/docs/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3471":354,"_30355":350,"_5":30684,"_21010":50480,"_27589":50481,"_2954":50482},[],"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3471":355,"_30355":350,"_5":30684,"_21010":50484,"_27589":50485,"_2954":50486},[],"/docs/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3471":356,"_30355":350,"_5":30684,"_21010":50488,"_27589":50489,"_2954":50490},[],"/docs/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3471":357,"_30355":350,"_5":30684,"_21010":50492,"_27589":50493,"_2954":50494},[],"/docs/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3471":358,"_30355":350,"_21010":50496,"_5":14420,"_27589":50473,"_2954":50497},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3471":359,"_30355":350,"_21010":50499,"_5":14420,"_27589":50477,"_2954":50500},[],"Workflow",{"_3471":360,"_30355":350,"_21010":50502,"_5":14420,"_27589":50477,"_2954":50503},[],"Use it for",{"_3471":361,"_30355":350,"_21010":50505,"_5":14420,"_27589":50477,"_2954":50506},[],"What it installs",{"_3471":362,"_30355":350,"_21010":50508,"_5":14420,"_27589":50477,"_2954":50509},[],"Helm",{"_3471":363,"_30355":350,"_21010":50511,"_5":14420,"_27589":50477,"_2954":50512},[],"Production and controlled environments",{"_3471":364,"_30355":350,"_21010":50514,"_5":14420,"_27589":50477,"_2954":50515},[],"Lamassu services and Gateway API resources",{"_3471":365,"_30355":350,"_21010":50517,"_5":14420,"_27589":50477,"_2954":49665},[],{"_3471":366,"_30355":350,"_21010":50519,"_5":14420,"_27589":50477,"_2954":50520},[],"Evaluation, demos, CI and small lab clusters",{"_3471":367,"_30355":350,"_21010":50522,"_5":14420,"_27589":50477,"_2954":50523},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3471":368,"_30355":350,"_21010":50525,"_5":14420,"_27589":50481,"_2954":50526},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3471":369,"_30355":350,"_21010":50528,"_5":14420,"_27589":50481,"_2954":50529},[],"Area",{"_3471":370,"_30355":350,"_21010":50531,"_5":14420,"_27589":50481,"_2954":50532},[],"The Lamassu chart provides",{"_3471":371,"_30355":350,"_21010":50534,"_5":14420,"_27589":50481,"_2954":50535},[],"You provide",{"_3471":372,"_30355":350,"_21010":50537,"_5":14420,"_27589":50481,"_2954":50538},[],"Lamassu applications",{"_3471":373,"_30355":350,"_21010":50540,"_5":14420,"_27589":50481,"_2954":50541},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3471":374,"_30355":350,"_21010":50543,"_5":14420,"_27589":50481,"_2954":50544},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3471":375,"_30355":350,"_21010":50546,"_5":14420,"_27589":50481,"_2954":50547},[],"PostgreSQL data",{"_3471":376,"_30355":350,"_21010":50549,"_5":14420,"_27589":50481,"_2954":50550},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3471":377,"_30355":350,"_21010":50552,"_5":14420,"_27589":50481,"_2954":50553},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3471":378,"_30355":350,"_21010":50555,"_5":14420,"_27589":50481,"_2954":50556},[],"Messaging",{"_3471":379,"_30355":350,"_21010":50558,"_5":14420,"_27589":50481,"_2954":50559},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3471":380,"_30355":350,"_21010":50561,"_5":14420,"_27589":50481,"_2954":50562},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3471":381,"_30355":350,"_21010":50564,"_5":14420,"_27589":50481,"_2954":50565},[],"Identity",{"_3471":382,"_30355":350,"_21010":50567,"_5":14420,"_27589":50481,"_2954":50568},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3471":383,"_30355":350,"_21010":50570,"_5":14420,"_27589":50481,"_2954":50571},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3471":384,"_30355":350,"_21010":50573,"_5":14420,"_27589":50481,"_2954":50574},[],"External routing",{"_3471":385,"_30355":350,"_21010":50576,"_5":14420,"_27589":50481,"_2954":50577},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3471":386,"_30355":350,"_21010":50579,"_5":14420,"_27589":50481,"_2954":50580},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3471":387,"_30355":350,"_21010":50582,"_5":14420,"_27589":50481,"_2954":50583},[],"TLS",{"_3471":388,"_30355":350,"_21010":50585,"_5":14420,"_27589":50481,"_2954":50586},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3471":389,"_30355":350,"_21010":50588,"_5":14420,"_27589":50481,"_2954":50589},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3471":390,"_30355":350,"_21010":50591,"_5":14420,"_27589":50481,"_2954":50592},[],"Persistent application data",{"_3471":391,"_30355":350,"_21010":50594,"_5":14420,"_27589":50481,"_2954":50595},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3471":392,"_30355":350,"_21010":50597,"_5":14420,"_27589":50481,"_2954":50598},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3471":393,"_30355":350,"_21010":50600,"_5":14420,"_27589":50481,"_2954":50601},[],"Optional integrations",{"_3471":394,"_30355":350,"_21010":50603,"_5":14420,"_27589":50481,"_2954":50604},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3471":395,"_30355":350,"_21010":50606,"_5":14420,"_27589":50481,"_2954":50607},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3471":396,"_30355":350,"_21010":50609,"_5":14420,"_27589":50481,"_2954":50610},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3471":397,"_30355":350,"_21010":50612,"_5":14420,"_27589":50481,"_2954":50613},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3471":398,"_30355":350,"_21010":50615,"_5":14420,"_27589":50485,"_2954":50616},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3471":399,"_30355":350,"_21010":50618,"_5":14420,"_27589":50485,"_2954":50619},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3471":400,"_30355":350,"_21010":50621,"_5":14420,"_27589":50489,"_2954":50622},[],"Kubernetes 1.24 or newer",{"_3471":401,"_30355":350,"_21010":50624,"_5":14420,"_27589":50489,"_2954":50625},[],"Helm 3.2 or newer",{"_3471":402,"_30355":350,"_21010":50627,"_5":14420,"_27589":50489,"_2954":50628},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3471":403,"_30355":350,"_21010":50630,"_5":14420,"_27589":50489,"_2954":50631},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3471":404,"_30355":350,"_21010":50633,"_5":14420,"_27589":50489,"_2954":50634},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3471":405,"_30355":350,"_21010":50636,"_5":14420,"_27589":50489,"_2954":50637},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3471":406,"_30355":350,"_21010":50639,"_5":14420,"_27589":50489,"_2954":50640},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3471":407,"_30355":350,"_21010":50642,"_5":14420,"_27589":50493,"_2954":50643},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3471":408,"_30355":350,"_21010":50645,"_5":14420,"_27589":50493,"_2954":50646},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3471":409,"_30355":350,"_21010":50648,"_5":14420,"_27589":50493,"_2954":50649},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3471":410,"_30355":350,"_21010":50651,"_5":14420,"_27589":50493,"_2954":50652},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3471":411,"_30355":411,"_5":14772,"_2954":50654,"_30687":50655,"_21010":50657,"_27589":411},"Deployment troubleshooting",[49421,49422,50656],"Operations",[],{"_3471":412,"_30355":411,"_21010":50659,"_5":14420,"_27589":411,"_2954":50660},[],"Diagnose access, service health and infrastructure dependencies.",{"_3471":413,"_30355":411,"_5":30684,"_21010":50662,"_27589":50663,"_2954":50664},[],"/docs/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3471":414,"_30355":411,"_5":30684,"_21010":50666,"_27589":50667,"_2954":50668},[],"/docs/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3471":415,"_30355":411,"_5":30684,"_21010":50670,"_27589":50671,"_2954":50672},[],"/docs/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3471":416,"_30355":411,"_5":30684,"_21010":50674,"_27589":50675,"_2954":50676},[],"/docs/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3471":417,"_30355":411,"_5":30684,"_21010":50678,"_27589":50679,"_2954":50680},[],"/docs/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3471":418,"_30355":411,"_5":30684,"_21010":50682,"_27589":50683,"_2954":50684},[],"/docs/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3471":419,"_30355":411,"_5":30684,"_21010":50686,"_27589":50687,"_2954":50688},[],"/docs/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3471":420,"_30355":411,"_5":30684,"_21010":50690,"_27589":50691,"_2954":50692},[],"/docs/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3471":421,"_30355":411,"_5":30684,"_21010":50694,"_27589":50695,"_2954":50696},[],"/docs/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3471":422,"_30355":411,"_5":30684,"_21010":50698,"_27589":50699,"_2954":50700},[],"/docs/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3471":423,"_30355":411,"_5":30684,"_21010":50702,"_27589":50703,"_2954":50704},[],"/docs/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3471":424,"_30355":411,"_5":30684,"_21010":50706,"_27589":50707,"_2954":50708},[],"/docs/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3471":425,"_30355":411,"_5":30684,"_21010":50710,"_27589":50711,"_2954":50712},[],"/docs/deployment/troubleshooting#observability","Observability",{"_3471":426,"_30355":411,"_21010":50714,"_5":14420,"_27589":411,"_2954":50715},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3471":427,"_30355":411,"_21010":50717,"_5":14420,"_27589":50667,"_2954":50718},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3471":428,"_30355":411,"_21010":50720,"_5":14420,"_27589":50671,"_2954":50721},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3471":429,"_30355":411,"_21010":50723,"_5":14420,"_27589":50675,"_2954":50724},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3471":430,"_30355":411,"_21010":50726,"_5":14420,"_27589":50679,"_2954":50727},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3471":431,"_30355":411,"_21010":50729,"_5":14420,"_27589":50683,"_2954":50730},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3471":432,"_30355":411,"_21010":50732,"_5":14420,"_27589":50687,"_2954":50733},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3471":433,"_30355":411,"_21010":50735,"_5":14420,"_27589":50687,"_2954":50736},[],"Also run the chart's connectivity test:",{"_3471":434,"_30355":411,"_21010":50738,"_5":14420,"_27589":50687,"_2954":50739},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3471":435,"_30355":411,"_21010":50741,"_5":14420,"_27589":50687,"_2954":50742},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3471":436,"_30355":411,"_21010":50744,"_5":14420,"_27589":50691,"_2954":50745},[],"If you receive a 401:",{"_3471":437,"_30355":411,"_21010":50747,"_5":14420,"_27589":50691,"_2954":50748},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3471":438,"_30355":411,"_21010":50750,"_5":14420,"_27589":50691,"_2954":50751},[],"verify issuer, audience and expiration of the token;",{"_3471":439,"_30355":411,"_21010":50753,"_5":14420,"_27589":50691,"_2954":50754},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3471":440,"_30355":411,"_21010":50756,"_5":14420,"_27589":50691,"_2954":50757},[],"check that the provider's public and internal routes point to the same realm.",{"_3471":441,"_30355":411,"_21010":50759,"_5":14420,"_27589":50691,"_2954":50760},[],"If login succeeds but the APIs return 403:",{"_3471":442,"_30355":411,"_21010":50762,"_5":14420,"_27589":50691,"_2954":50763},[],"inspect the token's real claims;",{"_3471":443,"_30355":411,"_21010":50765,"_5":14420,"_27589":50691,"_2954":50766},[],"confirm they match an active principal;",{"_3471":444,"_30355":411,"_21010":50768,"_5":14420,"_27589":50691,"_2954":50769},[],"review the policies granted to that principal;",{"_3471":445,"_30355":411,"_21010":50771,"_5":14420,"_27589":50691,"_2954":50772},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3471":446,"_30355":411,"_21010":50774,"_5":14420,"_27589":50691,"_2954":50775},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3471":447,"_30355":411,"_21010":50777,"_5":14420,"_27589":50695,"_2954":50778},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3471":448,"_30355":411,"_21010":50780,"_5":14420,"_27589":50695,"_2954":50781},[],"Locate the authz pod and Service.",{"_3471":449,"_30355":411,"_21010":50783,"_5":14420,"_27589":50695,"_2954":50784},[],"Check /health, logs and its database connection.",{"_3471":450,"_30355":411,"_21010":50786,"_5":14420,"_27589":50695,"_2954":50787},[],"Verify the DNS and port configured in externalAuthorization.",{"_3471":451,"_30355":411,"_21010":50789,"_5":14420,"_27589":50695,"_2954":50790},[],"Check the check route is /v1/ext\\_authz/check.",{"_3471":452,"_30355":411,"_21010":50792,"_5":14420,"_27589":50695,"_2954":50793},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3471":453,"_30355":411,"_21010":50795,"_5":14420,"_27589":50699,"_2954":50796},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3471":454,"_30355":411,"_21010":50798,"_5":14420,"_27589":50703,"_2954":50799},[],"Review kubectl describe pod first. Common causes are:",{"_3471":455,"_30355":411,"_21010":50801,"_5":14420,"_27589":50703,"_2954":50802},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3471":456,"_30355":411,"_21010":50804,"_5":14420,"_27589":50703,"_2954":50805},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3471":457,"_30355":411,"_21010":50807,"_5":14420,"_27589":50703,"_2954":50808},[],"unbound persistent volume;",{"_3471":458,"_30355":411,"_21010":50810,"_5":14420,"_27589":50703,"_2954":50811},[],"inaccessible image or incorrect pull policy;",{"_3471":459,"_30355":411,"_21010":50813,"_5":14420,"_27589":50703,"_2954":50814},[],"invalid cryptographic engine configuration;",{"_3471":460,"_30355":411,"_21010":50816,"_5":14420,"_27589":50703,"_2954":50817},[],"CPU or memory limits set too low;",{"_3471":461,"_30355":411,"_21010":50819,"_5":14420,"_27589":50703,"_2954":50820},[],"an incomplete prior migration.",{"_3471":462,"_30355":411,"_21010":50822,"_5":14420,"_27589":50703,"_2954":50823},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3471":463,"_30355":411,"_21010":50825,"_5":14420,"_27589":50703,"_2954":50826},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3471":464,"_30355":411,"_21010":50828,"_5":14420,"_27589":50703,"_2954":50829},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3471":465,"_30355":411,"_21010":50831,"_5":14420,"_27589":50707,"_2954":50832},[],"Domain and audit events depend on the bus publisher:",{"_3471":466,"_30355":411,"_21010":50834,"_5":14420,"_27589":50707,"_2954":50835},[],"verify it is enabled in the emitting service;",{"_3471":467,"_30355":411,"_21010":50837,"_5":14420,"_27589":50707,"_2954":50838},[],"check AMQP connectivity and credentials;",{"_3471":468,"_30355":411,"_21010":50840,"_5":14420,"_27589":50707,"_2954":50841},[],"review exchange, routing key, queues and consumers;",{"_3471":469,"_30355":411,"_21010":50843,"_5":14420,"_27589":50707,"_2954":50844},[],"inspect dead-letter queues;",{"_3471":470,"_30355":411,"_21010":50846,"_5":14420,"_27589":50707,"_2954":50847},[],"alert on orphan durable queues and backlog growth.",{"_3471":471,"_30355":411,"_21010":50849,"_5":14420,"_27589":50707,"_2954":50850},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3471":472,"_30355":411,"_21010":50852,"_5":14420,"_27589":50707,"_2954":50853},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3471":473,"_30355":411,"_21010":50855,"_5":14420,"_27589":50707,"_2954":50856},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3471":474,"_30355":411,"_21010":50858,"_5":14420,"_27589":50707,"_2954":50859},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3471":475,"_30355":411,"_21010":50861,"_5":14420,"_27589":50707,"_2954":50862},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3471":476,"_30355":411,"_21010":50864,"_5":14420,"_27589":50707,"_2954":50865},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3471":477,"_30355":411,"_21010":50867,"_5":14420,"_27589":50707,"_2954":50868},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3471":478,"_30355":411,"_21010":50870,"_5":14420,"_27589":50711,"_2954":50871},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3471":479,"_30355":411,"_21010":50873,"_5":14420,"_27589":50711,"_2954":50874},[],"Before closing an incident, record:",{"_3471":480,"_30355":411,"_21010":50876,"_5":14420,"_27589":50711,"_2954":50877},[],"the confirmed cause;",{"_3471":481,"_30355":411,"_21010":50879,"_5":14420,"_27589":50711,"_2954":50880},[],"the time scope and affected resources;",{"_3471":482,"_30355":411,"_21010":50882,"_5":14420,"_27589":50711,"_2954":50883},[],"the commands or queries used;",{"_3471":483,"_30355":411,"_21010":50885,"_5":14420,"_27589":50711,"_2954":50886},[],"the applied change and how to revert it;",{"_3471":484,"_30355":411,"_21010":50888,"_5":14420,"_27589":50711,"_2954":50889},[],"validation from a consumer;",{"_3471":485,"_30355":411,"_21010":50891,"_5":14420,"_27589":50711,"_2954":50892},[],"the preventive action and its owner.",{"_3471":486,"_30355":486,"_5":14772,"_2954":50894,"_30687":50895,"_21010":50898,"_27589":486},"Access control",[49421,50896,50897],"Platform","Administration",[],{"_3471":487,"_30355":486,"_21010":50900,"_5":14420,"_27589":486,"_2954":50901},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3471":488,"_30355":486,"_5":30684,"_21010":50903,"_27589":50904,"_2954":50905},[],"/docs/platform/administration/access-control#essential-concepts","Essential concepts",{"_3471":489,"_30355":486,"_5":30684,"_21010":50907,"_27589":50908,"_2954":50909},[],"/docs/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3471":490,"_30355":486,"_5":30684,"_21010":50911,"_27589":50912,"_2954":50913},[],"/docs/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3471":491,"_30355":486,"_5":30684,"_21010":50915,"_27589":50916,"_2954":50917},[],"/docs/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3471":492,"_30355":486,"_5":30684,"_21010":50919,"_27589":50920,"_2954":50921},[],"/docs/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3471":493,"_30355":486,"_5":30684,"_21010":50923,"_27589":50924,"_2954":50925},[],"/docs/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3471":494,"_30355":486,"_5":30684,"_21010":50927,"_27589":50928,"_2954":50929},[],"/docs/platform/administration/access-control#oidc-principals","OIDC principals",{"_3471":495,"_30355":486,"_5":30684,"_21010":50931,"_27589":50932,"_2954":50933},[],"/docs/platform/administration/access-control#x509-principals","X.509 principals",{"_3471":496,"_30355":486,"_5":30684,"_21010":50935,"_27589":50936,"_2954":50937},[],"/docs/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3471":497,"_30355":486,"_5":30684,"_21010":50939,"_27589":50940,"_2954":50941},[],"/docs/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3471":498,"_30355":486,"_5":30684,"_21010":50943,"_27589":50944,"_2954":50945},[],"/docs/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3471":499,"_30355":486,"_5":30684,"_21010":50947,"_27589":50948,"_2954":50949},[],"/docs/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3471":500,"_30355":486,"_5":30684,"_21010":50951,"_27589":50952,"_2954":50953},[],"/docs/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3471":501,"_30355":486,"_5":30684,"_21010":50955,"_27589":50956,"_2954":50957},[],"/docs/platform/administration/access-control#http-rules","HTTP rules",{"_3471":502,"_30355":486,"_5":30684,"_21010":50959,"_27589":50960,"_2954":50961},[],"/docs/platform/administration/access-control#included-policies","Included policies",{"_3471":503,"_30355":486,"_5":30684,"_21010":50963,"_27589":50964,"_2954":50061},[],"/docs/platform/administration/access-control#provision-the-first-administrator",{"_3471":504,"_30355":486,"_5":30684,"_21010":50966,"_27589":50967,"_2954":50968},[],"/docs/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3471":505,"_30355":486,"_5":30684,"_21010":50970,"_27589":50971,"_2954":50972},[],"/docs/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3471":506,"_30355":486,"_5":30684,"_21010":50974,"_27589":50975,"_2954":50976},[],"/docs/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3471":507,"_30355":486,"_5":30684,"_21010":50978,"_27589":50979,"_2954":50980},[],"/docs/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3471":508,"_30355":486,"_5":30684,"_21010":50982,"_27589":50983,"_2954":50984},[],"/docs/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3471":509,"_30355":486,"_5":30684,"_21010":50986,"_27589":50987,"_2954":50988},[],"/docs/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3471":510,"_30355":486,"_5":30684,"_21010":50990,"_27589":50991,"_2954":50992},[],"/docs/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3471":511,"_30355":486,"_5":30684,"_21010":50994,"_27589":50995,"_2954":50996},[],"/docs/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3471":512,"_30355":486,"_5":30684,"_21010":50998,"_27589":50999,"_2954":51000},[],"/docs/platform/administration/access-control#operational-checklist","Operational checklist",{"_3471":513,"_30355":486,"_5":30684,"_21010":51002,"_27589":51003,"_2954":51004},[],"/docs/platform/administration/access-control#diagnostics","Diagnostics",{"_3471":514,"_30355":486,"_5":30684,"_21010":51006,"_27589":51007,"_2954":51008},[],"/docs/platform/administration/access-control#the-response-is-401","The response is 401",{"_3471":515,"_30355":486,"_5":30684,"_21010":51010,"_27589":51011,"_2954":51012},[],"/docs/platform/administration/access-control#the-response-is-403","The response is 403",{"_3471":516,"_30355":486,"_5":30684,"_21010":51014,"_27589":51015,"_2954":51016},[],"/docs/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3471":517,"_30355":486,"_5":30684,"_21010":51018,"_27589":51019,"_2954":51020},[],"/docs/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3471":518,"_30355":486,"_5":30684,"_21010":51022,"_27589":51023,"_2954":51024},[],"/docs/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3471":519,"_30355":486,"_21010":51026,"_5":14420,"_27589":486,"_2954":51027},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3471":520,"_30355":486,"_21010":51029,"_5":14420,"_27589":486,"_2954":51030},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3471":521,"_30355":486,"_21010":51032,"_5":14420,"_27589":486,"_2954":51033},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3471":522,"_30355":486,"_21010":51035,"_5":14420,"_27589":50904,"_2954":51036},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3471":523,"_30355":486,"_21010":51038,"_5":14420,"_27589":50904,"_2954":51039},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3471":524,"_30355":486,"_21010":51041,"_5":14420,"_27589":50904,"_2954":51042},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3471":525,"_30355":486,"_21010":51044,"_5":14420,"_27589":50904,"_2954":51045},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3471":526,"_30355":486,"_21010":51047,"_5":14420,"_27589":50904,"_2954":51048},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3471":527,"_30355":486,"_21010":51050,"_5":14420,"_27589":50904,"_2954":51051},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3471":528,"_30355":486,"_21010":51053,"_5":14420,"_27589":50908,"_2954":51054},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3471":529,"_30355":486,"_21010":51056,"_5":14420,"_27589":50908,"_2954":51057},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3471":530,"_30355":486,"_21010":51059,"_5":14420,"_27589":50912,"_2954":51060},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3471":531,"_30355":486,"_21010":51062,"_5":14420,"_27589":50912,"_2954":51063},[],"The decision is made **before forwarding the request to the service**:",{"_3471":532,"_30355":486,"_21010":51065,"_5":14420,"_27589":50912,"_2954":51066},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3471":533,"_30355":486,"_21010":51068,"_5":14420,"_27589":50912,"_2954":51069},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3471":534,"_30355":486,"_21010":51071,"_5":14420,"_27589":50912,"_2954":51072},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3471":535,"_30355":486,"_21010":51074,"_5":14420,"_27589":50912,"_2954":51075},[],"It separately loads the policies granted to each principal.",{"_3471":536,"_30355":486,"_21010":51077,"_5":14420,"_27589":50912,"_2954":51078},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3471":537,"_30355":486,"_21010":51080,"_5":14420,"_27589":50912,"_2954":51081},[],"`authz` looks for an HTTP rule granting that action.",{"_3471":538,"_30355":486,"_21010":51083,"_5":14420,"_27589":50912,"_2954":51084},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3471":539,"_30355":486,"_21010":51086,"_5":14420,"_27589":50912,"_2954":51087},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3471":540,"_30355":486,"_21010":51089,"_5":14420,"_27589":50912,"_2954":51090},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context. Clients cannot forge this header: the Gateway removes client-supplied `X-Principal-Id` (and the other forwarded identity and certificate headers) before forwarding, so only `authz` can set it. See Expose the Gateway for the full list of stripped headers.",{"_3471":541,"_30355":486,"_21010":51092,"_5":14420,"_27589":50912,"_2954":51093},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3471":542,"_30355":486,"_21010":51095,"_5":14420,"_27589":50916,"_2954":51096},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3471":543,"_30355":486,"_21010":51098,"_5":14420,"_27589":50916,"_2954":51099},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3471":544,"_30355":486,"_21010":51101,"_5":14420,"_27589":50916,"_2954":51102},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3471":545,"_30355":486,"_21010":51104,"_5":14420,"_27589":50916,"_2954":51105},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3471":546,"_30355":486,"_21010":51107,"_5":14420,"_27589":50916,"_2954":51108},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3471":547,"_30355":486,"_21010":51110,"_5":14420,"_27589":50916,"_2954":51111},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3471":548,"_30355":486,"_21010":51113,"_5":14420,"_27589":50916,"_2954":51114},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3471":549,"_30355":486,"_21010":51116,"_5":14420,"_27589":50916,"_2954":51117},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3471":550,"_30355":486,"_21010":51119,"_5":14420,"_27589":50920,"_2954":51120},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3471":551,"_30355":486,"_21010":51122,"_5":14420,"_27589":50920,"_2954":51123},[],"The decision is made with the domain operation context:",{"_3471":552,"_30355":486,"_21010":51125,"_5":14420,"_27589":50920,"_2954":51126},[],"The middleware extracts the credential and resolves the matching principals.",{"_3471":553,"_30355":486,"_21010":51128,"_5":14420,"_27589":50920,"_2954":51129},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3471":554,"_30355":486,"_21010":51131,"_5":14420,"_27589":50920,"_2954":51132},[],"`authz` gathers the entity rules of the granted policies.",{"_3471":555,"_30355":486,"_21010":51134,"_5":14420,"_27589":50920,"_2954":51135},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3471":556,"_30355":486,"_21010":51137,"_5":14420,"_27589":50920,"_2954":51138},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3471":557,"_30355":486,"_21010":51140,"_5":14420,"_27589":50920,"_2954":51141},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3471":558,"_30355":486,"_21010":51143,"_5":14420,"_27589":50920,"_2954":51144},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3471":559,"_30355":486,"_21010":51146,"_5":14420,"_27589":50920,"_2954":51147},[],"Actions fall into two groups:",{"_3471":560,"_30355":486,"_21010":51149,"_5":14420,"_27589":50920,"_2954":51150},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3471":561,"_30355":486,"_21010":51152,"_5":14420,"_27589":50920,"_2954":51153},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3471":562,"_30355":486,"_21010":51155,"_5":14420,"_27589":50920,"_2954":51156},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3471":563,"_30355":486,"_21010":51158,"_5":14420,"_27589":50924,"_2954":51159},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3471":564,"_30355":486,"_21010":51161,"_5":14420,"_27589":50924,"_2954":51162},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3471":565,"_30355":486,"_21010":51164,"_5":14420,"_27589":50924,"_2954":51165},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3471":566,"_30355":486,"_21010":51167,"_5":14420,"_27589":50928,"_2954":51168},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3471":567,"_30355":486,"_21010":51170,"_5":14420,"_27589":50928,"_2954":51171},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3471":568,"_30355":486,"_21010":51173,"_5":14420,"_27589":50928,"_2954":51174},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3471":569,"_30355":486,"_21010":51176,"_5":14420,"_27589":50928,"_2954":51177},[],"The implemented operators are:",{"_3471":570,"_30355":486,"_21010":51179,"_5":14420,"_27589":50928,"_2954":51180},[],"`equals`, for exact equality;",{"_3471":571,"_30355":486,"_21010":51182,"_5":14420,"_27589":50928,"_2954":51183},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3471":572,"_30355":486,"_21010":51185,"_5":14420,"_27589":50928,"_2954":51186},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3471":573,"_30355":486,"_21010":51188,"_5":14420,"_27589":50928,"_2954":51189},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3471":574,"_30355":486,"_21010":51191,"_5":14420,"_27589":50932,"_2954":51192},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3471":575,"_30355":486,"_21010":51194,"_5":14420,"_27589":50932,"_2954":51195},[],"The available modes are:",{"_3471":576,"_30355":486,"_21010":51197,"_5":14420,"_27589":50932,"_2954":51198},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3471":577,"_30355":486,"_21010":51200,"_5":14420,"_27589":50932,"_2954":51201},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3471":578,"_30355":486,"_21010":51203,"_5":14420,"_27589":50932,"_2954":51204},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3471":579,"_30355":486,"_21010":51206,"_5":14420,"_27589":50932,"_2954":51207},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3471":580,"_30355":486,"_21010":51209,"_5":14420,"_27589":50932,"_2954":51210},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3471":581,"_30355":486,"_21010":51212,"_5":14420,"_27589":50932,"_2954":51213},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3471":582,"_30355":486,"_21010":51215,"_5":14420,"_27589":50936,"_2954":51216},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3471":583,"_30355":486,"_21010":51218,"_5":14420,"_27589":50936,"_2954":51219},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3471":584,"_30355":486,"_21010":51221,"_5":14420,"_27589":50936,"_2954":51222},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3471":585,"_30355":486,"_21010":51224,"_5":14420,"_27589":50936,"_2954":51225},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3471":586,"_30355":486,"_21010":51227,"_5":14420,"_27589":50944,"_2954":51228},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3471":587,"_30355":486,"_21010":51230,"_5":14420,"_27589":50944,"_2954":51231},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3471":588,"_30355":486,"_21010":51233,"_5":14420,"_27589":50948,"_2954":51234},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3471":589,"_30355":486,"_21010":51236,"_5":14420,"_27589":50948,"_2954":51237},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3471":590,"_30355":486,"_21010":51239,"_5":14420,"_27589":50952,"_2954":51240},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3471":591,"_30355":486,"_21010":51242,"_5":14420,"_27589":50952,"_2954":51243},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3471":592,"_30355":486,"_21010":51245,"_5":14420,"_27589":50952,"_2954":51246},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3471":593,"_30355":486,"_21010":51248,"_5":14420,"_27589":50956,"_2954":51249},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3471":594,"_30355":486,"_21010":51251,"_5":14420,"_27589":50956,"_2954":51252},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3471":595,"_30355":486,"_21010":51254,"_5":14420,"_27589":50956,"_2954":51255},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3471":596,"_30355":486,"_21010":51257,"_5":14420,"_27589":50956,"_2954":51258},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3471":597,"_30355":486,"_21010":51260,"_5":14420,"_27589":50956,"_2954":51261},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3471":598,"_30355":486,"_21010":51263,"_5":14420,"_27589":50956,"_2954":51264},[],"Note that:",{"_3471":599,"_30355":486,"_21010":51266,"_5":14420,"_27589":50956,"_2954":51267},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3471":600,"_30355":486,"_21010":51269,"_5":14420,"_27589":50956,"_2954":51270},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3471":601,"_30355":486,"_21010":51272,"_5":14420,"_27589":50956,"_2954":51273},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3471":602,"_30355":486,"_21010":51275,"_5":14420,"_27589":50960,"_2954":51276},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3471":603,"_30355":486,"_21010":51278,"_5":14420,"_27589":50960,"_2954":51279},[],"full and read-only access to certificates and authorities;",{"_3471":604,"_30355":486,"_21010":51281,"_5":14420,"_27589":50960,"_2954":51282},[],"full and read-only access to the KMS;",{"_3471":605,"_30355":486,"_21010":51284,"_5":14420,"_27589":50960,"_2954":51285},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3471":606,"_30355":486,"_21010":51287,"_5":14420,"_27589":50960,"_2954":51288},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3471":607,"_30355":486,"_21010":51290,"_5":14420,"_27589":50960,"_2954":51291},[],"console access;",{"_3471":608,"_30355":486,"_21010":51293,"_5":14420,"_27589":50960,"_2954":51294},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3471":609,"_30355":486,"_21010":51296,"_5":14420,"_27589":50960,"_2954":51297},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3471":610,"_30355":486,"_21010":51299,"_5":14420,"_27589":50960,"_2954":51300},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3471":611,"_30355":486,"_21010":51302,"_5":14420,"_27589":50964,"_2954":51303},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3471":612,"_30355":486,"_21010":51305,"_5":14420,"_27589":50964,"_2954":51306},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3471":613,"_30355":486,"_21010":51308,"_5":14420,"_27589":50964,"_2954":51309},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3471":614,"_30355":486,"_21010":51311,"_5":14420,"_27589":50967,"_2954":51312},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3471":615,"_30355":486,"_21010":51314,"_5":14420,"_27589":50971,"_2954":51315},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3471":616,"_30355":486,"_21010":51317,"_5":14420,"_27589":50971,"_2954":51318},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3471":617,"_30355":486,"_21010":51320,"_5":14420,"_27589":50975,"_2954":51321},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3471":618,"_30355":486,"_21010":51323,"_5":14420,"_27589":50979,"_2954":51324},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3471":619,"_30355":486,"_21010":51326,"_5":14420,"_27589":50983,"_2954":51327},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3471":620,"_30355":486,"_21010":51329,"_5":14420,"_27589":50987,"_2954":51330},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3471":621,"_30355":486,"_21010":51332,"_5":14420,"_27589":50987,"_2954":51333},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3471":622,"_30355":486,"_21010":51335,"_5":14420,"_27589":50991,"_2954":51336},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3471":623,"_30355":486,"_21010":51338,"_5":14420,"_27589":50991,"_2954":51339},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3471":624,"_30355":486,"_21010":51341,"_5":14420,"_27589":50991,"_2954":51342},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3471":625,"_30355":486,"_21010":51344,"_5":14420,"_27589":50991,"_2954":51345},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3471":626,"_30355":486,"_21010":51347,"_5":14420,"_27589":50991,"_2954":51348},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3471":627,"_30355":486,"_21010":51350,"_5":14420,"_27589":50991,"_2954":51351},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3471":628,"_30355":486,"_21010":51353,"_5":14420,"_27589":50991,"_2954":51354},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3471":629,"_30355":486,"_21010":51356,"_5":14420,"_27589":50991,"_2954":51357},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3471":630,"_30355":486,"_21010":51359,"_5":14420,"_27589":50995,"_2954":51360},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3471":631,"_30355":486,"_21010":51362,"_5":14420,"_27589":50995,"_2954":51363},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3471":632,"_30355":486,"_21010":51365,"_5":14420,"_27589":50995,"_2954":51366},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3471":633,"_30355":486,"_21010":51368,"_5":14420,"_27589":50999,"_2954":51369},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3471":634,"_30355":486,"_21010":51371,"_5":14420,"_27589":50999,"_2954":51372},[],"Use groups or stable roles for people and independent identities for automations.",{"_3471":635,"_30355":486,"_21010":51374,"_5":14420,"_27589":50999,"_2954":51375},[],"Keep at least two recovery administrators and test their access periodically.",{"_3471":636,"_30355":486,"_21010":51377,"_5":14420,"_27589":50999,"_2954":51378},[],"Review active principals, their matches and their grants after IdP changes.",{"_3471":637,"_30355":486,"_21010":51380,"_5":14420,"_27589":50999,"_2954":51381},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3471":638,"_30355":486,"_21010":51383,"_5":14420,"_27589":50999,"_2954":51384},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3471":639,"_30355":486,"_21010":51386,"_5":14420,"_27589":50999,"_2954":51387},[],"Always test one allowed and one denied operation for each role.",{"_3471":640,"_30355":486,"_21010":51389,"_5":14420,"_27589":50999,"_2954":51390},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3471":641,"_30355":486,"_21010":51392,"_5":14420,"_27589":51007,"_2954":51393},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3471":642,"_30355":486,"_21010":51395,"_5":14420,"_27589":51011,"_2954":51396},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3471":643,"_30355":486,"_21010":51398,"_5":14420,"_27589":51011,"_2954":51399},[],"that an active principal of the correct type exists;",{"_3471":644,"_30355":486,"_21010":51401,"_5":14420,"_27589":51011,"_2954":51402},[],"that the claim paths and values match the real token exactly;",{"_3471":645,"_30355":486,"_21010":51404,"_5":14420,"_27589":51011,"_2954":51405},[],"that all of the principal's conditions hold;",{"_3471":646,"_30355":486,"_21010":51407,"_5":14420,"_27589":51011,"_2954":51408},[],"that the principal has the expected policy granted;",{"_3471":647,"_30355":486,"_21010":51410,"_5":14420,"_27589":51011,"_2954":51411},[],"that the policy includes the action and the requested resource type or route;",{"_3471":648,"_30355":486,"_21010":51413,"_5":14420,"_27589":51011,"_2954":51414},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3471":649,"_30355":486,"_21010":51416,"_5":14420,"_27589":51011,"_2954":51417},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3471":650,"_30355":486,"_21010":51419,"_5":14420,"_27589":51015,"_2954":51420},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3471":651,"_30355":486,"_21010":51422,"_5":14420,"_27589":51019,"_2954":51423},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3471":652,"_30355":486,"_21010":51425,"_5":14420,"_27589":51023,"_2954":51426},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3471":653,"_30355":486,"_21010":51428,"_5":14420,"_27589":51023,"_2954":51429},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3471":654,"_30355":654,"_5":14772,"_2954":51431,"_30687":51432,"_21010":51433,"_27589":654},"Alerts and subscriptions",[49421,50896,50897],[],{"_3471":655,"_30355":654,"_21010":51435,"_5":14420,"_27589":654,"_2954":51436},[],"Send PKI events to people and external systems.",{"_3471":656,"_30355":654,"_5":30684,"_21010":51438,"_27589":51439,"_2954":51440},[],"/docs/platform/administration/alerts#how-it-works","How it works",{"_3471":657,"_30355":654,"_5":30684,"_21010":51442,"_27589":51443,"_2954":51444},[],"/docs/platform/administration/alerts#available-channels","Available channels",{"_3471":658,"_30355":654,"_5":30684,"_21010":51446,"_27589":51447,"_2954":51448},[],"/docs/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3471":659,"_30355":654,"_5":30684,"_21010":51450,"_27589":51451,"_2954":51452},[],"/docs/platform/administration/alerts#choose-the-event","Choose the event",{"_3471":660,"_30355":654,"_5":30684,"_21010":51454,"_27589":51455,"_2954":51456},[],"/docs/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3471":661,"_30355":654,"_5":30684,"_21010":51458,"_27589":51459,"_2954":51460},[],"/docs/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3471":662,"_30355":654,"_5":30684,"_21010":51462,"_27589":51463,"_2954":51464},[],"/docs/platform/administration/alerts#review-and-activate","Review and activate",{"_3471":663,"_30355":654,"_5":30684,"_21010":51466,"_27589":51467,"_2954":51468},[],"/docs/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3471":664,"_30355":654,"_5":30684,"_21010":51470,"_27589":51471,"_2954":51472},[],"/docs/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3471":665,"_30355":654,"_5":30684,"_21010":51474,"_27589":51475,"_2954":51476},[],"/docs/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3471":666,"_30355":654,"_5":30684,"_21010":51478,"_27589":51479,"_2954":51480},[],"/docs/platform/administration/alerts#event-families","Event families",{"_3471":667,"_30355":654,"_21010":51482,"_5":14420,"_27589":654,"_2954":51483},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3471":668,"_30355":654,"_21010":51485,"_5":14420,"_27589":51439,"_2954":51486},[],"A service publishes a domain event.",{"_3471":669,"_30355":654,"_21010":51488,"_5":14420,"_27589":51439,"_2954":51489},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3471":670,"_30355":654,"_21010":51491,"_5":14420,"_27589":51439,"_2954":51492},[],"Each subscription's filter decides whether it should be notified.",{"_3471":671,"_30355":654,"_21010":51494,"_5":14420,"_27589":51439,"_2954":51495},[],"Lamassu delivers the event to the configured channel.",{"_3471":672,"_30355":654,"_21010":51497,"_5":14420,"_27589":51439,"_2954":51498},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3471":673,"_30355":654,"_21010":51500,"_5":14420,"_27589":51443,"_2954":51501},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3471":674,"_30355":654,"_21010":51503,"_5":14420,"_27589":51443,"_2954":51504},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3471":675,"_30355":654,"_21010":51506,"_5":14420,"_27589":51443,"_2954":51507},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3471":676,"_30355":654,"_21010":51509,"_5":14420,"_27589":51443,"_2954":51510},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3471":677,"_30355":654,"_21010":51512,"_5":14420,"_27589":51443,"_2954":51513},[],"`apikey_options` requires `header` and `key`.",{"_3471":678,"_30355":654,"_21010":51515,"_5":14420,"_27589":51443,"_2954":51516},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3471":679,"_30355":654,"_21010":51518,"_5":14420,"_27589":51443,"_2954":51519},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3471":680,"_30355":654,"_21010":51521,"_5":14420,"_27589":51443,"_2954":51522},[],"The alerts API reference documents the full `http_client` schema.",{"_3471":681,"_30355":654,"_21010":51524,"_5":14420,"_27589":51451,"_2954":51525},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3471":682,"_30355":654,"_21010":51527,"_5":14420,"_27589":51455,"_2954":51528},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3471":683,"_30355":654,"_21010":51530,"_5":14420,"_27589":51459,"_2954":51531},[],"Add a filter if you don't want to receive every instance of the event.",{"_3471":684,"_30355":654,"_21010":51533,"_5":14420,"_27589":51459,"_2954":51534},[],"**None** notifies all instances of the event.",{"_3471":685,"_30355":654,"_21010":51536,"_5":14420,"_27589":51459,"_2954":51537},[],"**JSON Path** evaluates one or more specific fields.",{"_3471":686,"_30355":654,"_21010":51539,"_5":14420,"_27589":51459,"_2954":51540},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3471":687,"_30355":654,"_21010":51542,"_5":14420,"_27589":51459,"_2954":51543},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3471":688,"_30355":654,"_21010":51545,"_5":14420,"_27589":51459,"_2954":51546},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3471":689,"_30355":654,"_21010":51548,"_5":14420,"_27589":51459,"_2954":51549},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3471":690,"_30355":654,"_21010":51551,"_5":14420,"_27589":51463,"_2954":51552},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3471":691,"_30355":654,"_21010":51554,"_5":14420,"_27589":51467,"_2954":51555},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3471":692,"_30355":654,"_21010":51557,"_5":14420,"_27589":51467,"_2954":51558},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3471":693,"_30355":654,"_21010":51560,"_5":14420,"_27589":51467,"_2954":51561},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3471":694,"_30355":654,"_21010":51563,"_5":14420,"_27589":51467,"_2954":51564},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3471":695,"_30355":654,"_21010":51566,"_5":14420,"_27589":51467,"_2954":51567},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3471":696,"_30355":654,"_21010":51569,"_5":14420,"_27589":51467,"_2954":51570},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3471":697,"_30355":654,"_21010":51572,"_5":14420,"_27589":51467,"_2954":51573},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3471":698,"_30355":654,"_21010":51575,"_5":14420,"_27589":51467,"_2954":51576},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3471":699,"_30355":654,"_21010":51578,"_5":14420,"_27589":51471,"_2954":51579},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3471":700,"_30355":654,"_21010":51581,"_5":14420,"_27589":51471,"_2954":51582},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3471":701,"_30355":654,"_21010":51584,"_5":14420,"_27589":51471,"_2954":51585},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3471":702,"_30355":654,"_21010":51587,"_5":14420,"_27589":51471,"_2954":51588},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3471":703,"_30355":654,"_21010":51590,"_5":14420,"_27589":51471,"_2954":51591},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3471":704,"_30355":654,"_21010":51593,"_5":14420,"_27589":51471,"_2954":51594},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3471":705,"_30355":654,"_21010":51596,"_5":14420,"_27589":51471,"_2954":51597},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3471":706,"_30355":654,"_21010":51599,"_5":14420,"_27589":51471,"_2954":51600},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3471":707,"_30355":654,"_21010":51602,"_5":14420,"_27589":51475,"_2954":51603},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3471":708,"_30355":654,"_21010":51605,"_5":14420,"_27589":51475,"_2954":51606},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3471":709,"_30355":654,"_21010":51608,"_5":14420,"_27589":51479,"_2954":51609},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3471":710,"_30355":654,"_21010":51611,"_5":14420,"_27589":51479,"_2954":51612},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3471":711,"_30355":654,"_21010":51614,"_5":14420,"_27589":51479,"_2954":51615},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3471":712,"_30355":654,"_21010":51617,"_5":14420,"_27589":51479,"_2954":51618},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3471":713,"_30355":654,"_21010":51620,"_5":14420,"_27589":51479,"_2954":51621},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3471":714,"_30355":654,"_21010":51623,"_5":14420,"_27589":51479,"_2954":51624},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init` and `va.crl-settings.update`.",{"_3471":715,"_30355":654,"_21010":51626,"_5":14420,"_27589":51479,"_2954":51627},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3471":716,"_30355":654,"_21010":51629,"_5":14420,"_27589":51479,"_2954":51630},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3471":717,"_30355":654,"_21010":51632,"_5":14420,"_27589":51479,"_2954":51633},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3471":718,"_30355":718,"_5":14772,"_2954":51635,"_30687":51636,"_21010":51637,"_27589":718},"Audit logs",[49421,50896,50897],[],{"_3471":719,"_30355":718,"_21010":51639,"_5":14420,"_27589":718,"_2954":51640},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3471":720,"_30355":718,"_5":30684,"_21010":51642,"_27589":51643,"_2954":51644},[],"/docs/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3471":721,"_30355":718,"_5":30684,"_21010":51646,"_27589":51647,"_2954":51648},[],"/docs/platform/administration/audit-logs#coverage","Coverage",{"_3471":722,"_30355":718,"_5":30684,"_21010":51650,"_27589":51651,"_2954":51652},[],"/docs/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3471":723,"_30355":718,"_5":30684,"_21010":51654,"_27589":51655,"_2954":51656},[],"/docs/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3471":724,"_30355":718,"_5":30684,"_21010":51658,"_27589":51659,"_2954":51660},[],"/docs/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3471":725,"_30355":718,"_5":30684,"_21010":51662,"_27589":51663,"_2954":51664},[],"/docs/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3471":726,"_30355":718,"_5":30684,"_21010":51666,"_27589":51667,"_2954":51668},[],"/docs/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3471":727,"_30355":718,"_5":30684,"_21010":51670,"_27589":51671,"_2954":51672},[],"/docs/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3471":728,"_30355":718,"_5":30684,"_21010":51674,"_27589":51675,"_2954":51676},[],"/docs/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3471":729,"_30355":718,"_5":30684,"_21010":51678,"_27589":51679,"_2954":51680},[],"/docs/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3471":730,"_30355":718,"_5":30684,"_21010":51682,"_27589":51683,"_2954":51684},[],"/docs/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3471":731,"_30355":718,"_21010":51686,"_5":14420,"_27589":718,"_2954":51687},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3471":732,"_30355":718,"_21010":51689,"_5":14420,"_27589":51643,"_2954":51690},[],"The audit body includes:",{"_3471":733,"_30355":718,"_21010":51692,"_5":14420,"_27589":51643,"_2954":51693},[],"input: data received by the operation;",{"_3471":734,"_30355":718,"_21010":51695,"_5":14420,"_27589":51643,"_2954":51696},[],"has\\_error: whether the service returned an error;",{"_3471":735,"_30355":718,"_21010":51698,"_5":14420,"_27589":51643,"_2954":51699},[],"output: produced result or error message;",{"_3471":736,"_30355":718,"_21010":51701,"_5":14420,"_27589":51643,"_2954":51702},[],"principals: identifiers of the principals that matched the request.",{"_3471":737,"_30355":718,"_21010":51704,"_5":14420,"_27589":51643,"_2954":51705},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3471":738,"_30355":718,"_21010":51707,"_5":14420,"_27589":51643,"_2954":51708},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3471":739,"_30355":718,"_21010":51710,"_5":14420,"_27589":51647,"_2954":51711},[],"The backend applies auditing to mutations of:",{"_3471":740,"_30355":718,"_21010":51713,"_5":14420,"_27589":51647,"_2954":51714},[],"authorities, certificates and issuance profiles;",{"_3471":741,"_30355":718,"_21010":51716,"_5":14420,"_27589":51647,"_2954":51717},[],"keys and KMS engines;",{"_3471":742,"_30355":718,"_21010":51719,"_5":14420,"_27589":51647,"_2954":51720},[],"devices and identities;",{"_3471":743,"_30355":718,"_21010":51722,"_5":14420,"_27589":51647,"_2954":51723},[],"DMSs and enrollment operations;",{"_3471":744,"_30355":718,"_21010":51725,"_5":14420,"_27589":51647,"_2954":51726},[],"validation functions and CRL;",{"_3471":745,"_30355":718,"_21010":51728,"_5":14420,"_27589":51647,"_2954":51729},[],"principals, policies and authorization grants.",{"_3471":746,"_30355":718,"_21010":51731,"_5":14420,"_27589":51647,"_2954":51732},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3471":747,"_30355":718,"_21010":51734,"_5":14420,"_27589":51651,"_2954":51735},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3471":748,"_30355":718,"_21010":51737,"_5":14420,"_27589":51651,"_2954":51738},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3471":749,"_30355":718,"_21010":51740,"_5":14420,"_27589":51651,"_2954":51741},[],"Design the consumer to:",{"_3471":750,"_30355":718,"_21010":51743,"_5":14420,"_27589":51651,"_2954":51744},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3471":751,"_30355":718,"_21010":51746,"_5":14420,"_27589":51651,"_2954":51747},[],"keep the complete CloudEvent unmodified;",{"_3471":752,"_30355":718,"_21010":51749,"_5":14420,"_27589":51651,"_2954":51750},[],"record the ingestion time and detect duplicates by ID;",{"_3471":753,"_30355":718,"_21010":51752,"_5":14420,"_27589":51651,"_2954":51753},[],"encrypt in transit and at rest;",{"_3471":754,"_30355":718,"_21010":51755,"_5":14420,"_27589":51651,"_2954":51756},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3471":755,"_30355":718,"_21010":51758,"_5":14420,"_27589":51651,"_2954":51759},[],"apply an explicit retention and legal hold policy;",{"_3471":756,"_30355":718,"_21010":51761,"_5":14420,"_27589":51651,"_2954":51762},[],"alert if it stops consuming or the pending queue grows.",{"_3471":757,"_30355":718,"_21010":51764,"_5":14420,"_27589":51655,"_2954":51765},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3471":758,"_30355":718,"_21010":51767,"_5":14420,"_27589":51655,"_2954":51768},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3471":759,"_30355":718,"_21010":51770,"_5":14420,"_27589":51663,"_2954":51771},[],"Start from the reported time and normalize every source to UTC.",{"_3471":760,"_30355":718,"_21010":51773,"_5":14420,"_27589":51667,"_2954":51774},[],"Filter by event type, service source and resource identifier.",{"_3471":761,"_30355":718,"_21010":51776,"_5":14420,"_27589":51671,"_2954":51777},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3471":762,"_30355":718,"_21010":51779,"_5":14420,"_27589":51675,"_2954":51780},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3471":763,"_30355":718,"_21010":51782,"_5":14420,"_27589":51679,"_2954":51783},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3471":764,"_30355":718,"_21010":51785,"_5":14420,"_27589":51683,"_2954":51786},[],"Generate a controlled mutation in a test environment and check that:",{"_3471":765,"_30355":718,"_21010":51788,"_5":14420,"_27589":51683,"_2954":51789},[],"a successful audit event appears;",{"_3471":766,"_30355":718,"_21010":51791,"_5":14420,"_27589":51683,"_2954":51792},[],"the principal matches the identity used;",{"_3471":767,"_30355":718,"_21010":51794,"_5":14420,"_27589":51683,"_2954":51795},[],"the consumer persists it exactly once;",{"_3471":768,"_30355":718,"_21010":51797,"_5":14420,"_27589":51683,"_2954":51798},[],"it can be retrieved by resource, actor and period;",{"_3471":769,"_30355":718,"_21010":51800,"_5":14420,"_27589":51683,"_2954":51801},[],"a consumer outage raises an alert.",{"_3471":770,"_30355":718,"_21010":51803,"_5":14420,"_27589":51683,"_2954":51804},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3471":771,"_30355":771,"_5":14772,"_2954":51806,"_30687":51807,"_21010":51808,"_27589":771},"Platform architecture",[49421,50896],[],{"_3471":772,"_30355":771,"_21010":51810,"_5":14420,"_27589":771,"_2954":51811},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3471":773,"_30355":771,"_5":30684,"_21010":51813,"_27589":51814,"_2954":51815},[],"/docs/platform/concepts/architecture#control-plane","Control plane",{"_3471":774,"_30355":771,"_5":30684,"_21010":51817,"_27589":51818,"_2954":51819},[],"/docs/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3471":775,"_30355":771,"_5":30684,"_21010":51821,"_27589":51822,"_2954":51823},[],"/docs/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3471":776,"_30355":771,"_5":30684,"_21010":51825,"_27589":51826,"_2954":51827},[],"/docs/platform/concepts/architecture#status-and-validation","Status and validation",{"_3471":777,"_30355":771,"_5":30684,"_21010":51829,"_27589":51830,"_2954":51831},[],"/docs/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3471":778,"_30355":771,"_21010":51833,"_5":14420,"_27589":771,"_2954":51834},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3471":779,"_30355":771,"_21010":51836,"_5":14420,"_27589":771,"_2954":51837},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3471":780,"_30355":771,"_21010":51839,"_5":14420,"_27589":51814,"_2954":51840},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3471":781,"_30355":771,"_21010":51842,"_5":14420,"_27589":51818,"_2954":51843},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3471":782,"_30355":771,"_21010":51845,"_5":14420,"_27589":51822,"_2954":51846},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3471":783,"_30355":771,"_21010":51848,"_5":14420,"_27589":51826,"_2954":51849},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3471":784,"_30355":771,"_21010":51851,"_5":14420,"_27589":51830,"_2954":51852},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3471":785,"_30355":785,"_5":14772,"_2954":51854,"_30687":51855,"_21010":51856,"_27589":785},"How Lamassu works",[49421,50896],[],{"_3471":786,"_30355":785,"_21010":51858,"_5":14420,"_27589":785,"_2954":51859},[],"The mental model of trust, keys, certificates and devices.",{"_3471":787,"_30355":785,"_5":30684,"_21010":51861,"_27589":51862,"_2954":51863},[],"/docs/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3471":788,"_30355":785,"_5":30684,"_21010":51865,"_27589":51866,"_2954":51867},[],"/docs/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3471":789,"_30355":785,"_21010":51869,"_5":14420,"_27589":785,"_2954":51870},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3471":790,"_30355":785,"_21010":51872,"_5":14420,"_27589":51862,"_2954":51873},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3471":791,"_30355":785,"_21010":51875,"_5":14420,"_27589":51862,"_2954":51876},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3471":792,"_30355":785,"_21010":51878,"_5":14420,"_27589":51862,"_2954":51879},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3471":793,"_30355":785,"_21010":51881,"_5":14420,"_27589":51862,"_2954":51882},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3471":794,"_30355":785,"_21010":51884,"_5":14420,"_27589":51862,"_2954":51885},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3471":795,"_30355":785,"_21010":51887,"_5":14420,"_27589":51866,"_2954":51888},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3471":796,"_30355":785,"_21010":51890,"_5":14420,"_27589":51866,"_2954":51891},[],"A DMS relates that CA to an enrollment policy.",{"_3471":797,"_30355":785,"_21010":51893,"_5":14420,"_27589":51866,"_2954":51894},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3471":798,"_30355":785,"_21010":51896,"_5":14420,"_27589":51866,"_2954":51897},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3471":799,"_30355":785,"_21010":51899,"_5":14420,"_27589":51866,"_2954":51900},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3471":800,"_30355":785,"_21010":51902,"_5":14420,"_27589":51866,"_2954":51903},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3471":801,"_30355":785,"_21010":51905,"_5":14420,"_27589":51866,"_2954":51906},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3471":802,"_30355":802,"_5":14772,"_2954":51908,"_30687":51909,"_21010":51911,"_27589":802},"Devices and identities",[49421,50896,51910,51908],"IoT Fleets",[],{"_3471":803,"_30355":802,"_21010":51913,"_5":14420,"_27589":802,"_2954":51914},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3471":804,"_30355":802,"_5":30684,"_21010":51916,"_27589":51917,"_2954":51918},[],"/docs/platform/iot-fleets/device-management#device-states","Device states",{"_3471":805,"_30355":802,"_5":30684,"_21010":51920,"_27589":51921,"_2954":51922},[],"/docs/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3471":806,"_30355":802,"_5":30684,"_21010":51924,"_27589":51925,"_2954":51926},[],"/docs/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3471":807,"_30355":802,"_5":30684,"_21010":51928,"_27589":51929,"_2954":51930},[],"/docs/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3471":808,"_30355":802,"_5":30684,"_21010":51932,"_27589":51933,"_2954":51934},[],"/docs/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3471":809,"_30355":802,"_5":30684,"_21010":51936,"_27589":51937,"_2954":51938},[],"/docs/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3471":810,"_30355":802,"_5":30684,"_21010":51940,"_27589":51941,"_2954":51942},[],"/docs/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3471":811,"_30355":802,"_5":30684,"_21010":51944,"_27589":51945,"_2954":51946},[],"/docs/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3471":812,"_30355":802,"_5":30684,"_21010":51948,"_27589":51949,"_2954":51950},[],"/docs/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3471":813,"_30355":802,"_5":30684,"_21010":51952,"_27589":51953,"_2954":51954},[],"/docs/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3471":814,"_30355":802,"_5":30684,"_21010":51956,"_27589":51957,"_2954":51958},[],"/docs/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3471":815,"_30355":802,"_21010":51960,"_5":14420,"_27589":802,"_2954":51961},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3471":816,"_30355":802,"_21010":51963,"_5":14420,"_27589":802,"_2954":51964},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3471":817,"_30355":802,"_21010":51966,"_5":14420,"_27589":51917,"_2954":51967},[],"Operational view",{"_3471":818,"_30355":802,"_21010":51969,"_5":14420,"_27589":51917,"_2954":51970},[],"Meaning",{"_3471":819,"_30355":802,"_21010":51972,"_5":14420,"_27589":51917,"_2954":51973},[],"**No Identity**",{"_3471":820,"_30355":802,"_21010":51975,"_5":14420,"_27589":51917,"_2954":51976},[],"A record exists without an associated identity.",{"_3471":821,"_30355":802,"_21010":51978,"_5":14420,"_27589":51917,"_2954":51979},[],"**Active**",{"_3471":822,"_30355":802,"_21010":51981,"_5":14420,"_27589":51917,"_2954":51982},[],"The slot is active; also check certificate dates, status and usages.",{"_3471":823,"_30355":802,"_21010":51984,"_5":14420,"_27589":51917,"_2954":51985},[],"**Renewal Pending**",{"_3471":824,"_30355":802,"_21010":51987,"_5":14420,"_27589":51917,"_2954":51988},[],"The identity is in the operational renewal window.",{"_3471":825,"_30355":802,"_21010":51990,"_5":14420,"_27589":51917,"_2954":51991},[],"**Expiring Soon**",{"_3471":826,"_30355":802,"_21010":51993,"_5":14420,"_27589":51917,"_2954":51994},[],"Expiration is approaching according to configured thresholds.",{"_3471":827,"_30355":802,"_21010":51996,"_5":14420,"_27589":51917,"_2954":51997},[],"**Expired**",{"_3471":828,"_30355":802,"_21010":51999,"_5":14420,"_27589":51917,"_2954":52000},[],"The identity has expired.",{"_3471":829,"_30355":802,"_21010":52002,"_5":14420,"_27589":51917,"_2954":52003},[],"**Revoked**",{"_3471":830,"_30355":802,"_21010":52005,"_5":14420,"_27589":51917,"_2954":52006},[],"The identity is marked revoked.",{"_3471":831,"_30355":802,"_21010":52008,"_5":14420,"_27589":51917,"_2954":52009},[],"**Decommissioned**",{"_3471":832,"_30355":802,"_21010":52011,"_5":14420,"_27589":51917,"_2954":52012},[],"The record is retired and ordinary updates do not restore operation.",{"_3471":833,"_30355":802,"_21010":52014,"_5":14420,"_27589":51917,"_2954":52015},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3471":834,"_30355":802,"_21010":52017,"_5":14420,"_27589":51921,"_2954":52018},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3471":835,"_30355":802,"_21010":52020,"_5":14420,"_27589":51921,"_2954":52021},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3471":836,"_30355":802,"_21010":52023,"_5":14420,"_27589":51921,"_2954":52024},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3471":837,"_30355":802,"_21010":52026,"_5":14420,"_27589":51921,"_2954":52027},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3471":838,"_30355":802,"_21010":52029,"_5":14420,"_27589":51925,"_2954":52030},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3471":839,"_30355":802,"_21010":52032,"_5":14420,"_27589":51929,"_2954":52033},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3471":840,"_30355":802,"_21010":52035,"_5":14420,"_27589":51933,"_2954":52036},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3471":841,"_30355":802,"_21010":52038,"_5":14420,"_27589":51937,"_2954":52039},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3471":842,"_30355":802,"_21010":52041,"_5":14420,"_27589":51941,"_2954":52042},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3471":843,"_30355":802,"_21010":52044,"_5":14420,"_27589":51941,"_2954":52045},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3471":844,"_30355":802,"_21010":52047,"_5":14420,"_27589":51945,"_2954":52048},[],"From **No Identity**, use **Assign Identity**:",{"_3471":845,"_30355":802,"_21010":52050,"_5":14420,"_27589":51945,"_2954":52051},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3471":846,"_30355":802,"_21010":52053,"_5":14420,"_27589":51945,"_2954":52054},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3471":847,"_30355":802,"_21010":52056,"_5":14420,"_27589":51945,"_2954":52057},[],"Confirm and read the serial, active version and history again.",{"_3471":848,"_30355":802,"_21010":52059,"_5":14420,"_27589":51945,"_2954":52060},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3471":849,"_30355":802,"_21010":52062,"_5":14420,"_27589":51945,"_2954":52063},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3471":850,"_30355":802,"_21010":52065,"_5":14420,"_27589":51949,"_2954":52066},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3471":851,"_30355":802,"_21010":52068,"_5":14420,"_27589":51949,"_2954":52069},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3471":852,"_30355":802,"_21010":52071,"_5":14420,"_27589":51953,"_2954":52072},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3471":853,"_30355":802,"_21010":52074,"_5":14420,"_27589":51953,"_2954":52075},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3471":854,"_30355":802,"_21010":52077,"_5":14420,"_27589":51953,"_2954":52078},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3471":855,"_30355":802,"_21010":52080,"_5":14420,"_27589":51953,"_2954":52081},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3471":856,"_30355":802,"_21010":52083,"_5":14420,"_27589":51957,"_2954":52084},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3471":857,"_30355":802,"_21010":52086,"_5":14420,"_27589":51957,"_2954":52087},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3471":858,"_30355":858,"_5":14772,"_2954":52089,"_30687":52090,"_21010":52092,"_27589":858},"Bootstrap identity and authentication",[49421,50896,51910,51908,52091],"Enrollment with PKI",[],{"_3471":859,"_30355":858,"_21010":52094,"_5":14420,"_27589":858,"_2954":52095},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3471":860,"_30355":858,"_5":30684,"_21010":52097,"_27589":52098,"_2954":52099},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3471":861,"_30355":858,"_5":30684,"_21010":52101,"_27589":52102,"_2954":52103},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3471":862,"_30355":858,"_5":30684,"_21010":52105,"_27589":52106,"_2954":52107},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3471":863,"_30355":858,"_5":30684,"_21010":52109,"_27589":52110,"_2954":52111},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3471":864,"_30355":858,"_5":30684,"_21010":52113,"_27589":52114,"_2954":52115},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3471":865,"_30355":858,"_21010":52117,"_5":14420,"_27589":858,"_2954":52118},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3471":866,"_30355":858,"_21010":52120,"_5":14420,"_27589":52098,"_2954":52121},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3471":867,"_30355":858,"_21010":52123,"_5":14420,"_27589":52098,"_2954":52124},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3471":868,"_30355":858,"_21010":52126,"_5":14420,"_27589":52102,"_2954":52127},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3471":869,"_30355":858,"_21010":52129,"_5":14420,"_27589":52102,"_2954":52130},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3471":870,"_30355":858,"_21010":52132,"_5":14420,"_27589":52102,"_2954":52133},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3471":871,"_30355":858,"_21010":52135,"_5":14420,"_27589":52106,"_2954":52136},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3471":872,"_30355":858,"_21010":52138,"_5":14420,"_27589":52106,"_2954":52139},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3471":873,"_30355":858,"_21010":52141,"_5":14420,"_27589":52110,"_2954":52142},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3471":874,"_30355":858,"_21010":52144,"_5":14420,"_27589":52110,"_2954":52145},[],"Example body:",{"_3471":875,"_30355":858,"_21010":52147,"_5":14420,"_27589":52110,"_2954":52148},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3471":876,"_30355":858,"_21010":52150,"_5":14420,"_27589":52110,"_2954":52151},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3471":877,"_30355":858,"_21010":52153,"_5":14420,"_27589":52110,"_2954":52154},[],"Continuation requires a successful HTTP response and JSON:",{"_3471":878,"_30355":858,"_21010":52156,"_5":14420,"_27589":52110,"_2954":52157},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3471":879,"_30355":858,"_21010":52159,"_5":14420,"_27589":52114,"_2954":52160},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3471":880,"_30355":858,"_21010":52162,"_5":14420,"_27589":52114,"_2954":52163},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3471":881,"_30355":881,"_5":14772,"_2954":52165,"_30687":52166,"_21010":52167,"_27589":881},"Configure and operate the DMS",[49421,50896,51910,51908,52091],[],{"_3471":882,"_30355":881,"_21010":52169,"_5":14420,"_27589":881,"_2954":52170},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3471":883,"_30355":881,"_5":30684,"_21010":52172,"_27589":52173,"_2954":49431},[],"/docs/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3471":884,"_30355":881,"_5":30684,"_21010":52175,"_27589":52176,"_2954":52177},[],"/docs/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3471":885,"_30355":881,"_5":30684,"_21010":52179,"_27589":52180,"_2954":52181},[],"/docs/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3471":886,"_30355":881,"_5":30684,"_21010":52183,"_27589":52184,"_2954":52185},[],"/docs/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3471":887,"_30355":881,"_5":30684,"_21010":52187,"_27589":52188,"_2954":52189},[],"/docs/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3471":888,"_30355":881,"_5":30684,"_21010":52191,"_27589":52192,"_2954":52193},[],"/docs/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3471":889,"_30355":881,"_5":30684,"_21010":52195,"_27589":52196,"_2954":52197},[],"/docs/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3471":890,"_30355":881,"_5":30684,"_21010":52199,"_27589":52200,"_2954":52201},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3471":891,"_30355":881,"_5":30684,"_21010":52203,"_27589":52204,"_2954":52205},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3471":892,"_30355":881,"_5":30684,"_21010":52207,"_27589":52208,"_2954":52209},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3471":893,"_30355":881,"_5":30684,"_21010":52211,"_27589":52212,"_2954":52213},[],"/docs/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3471":894,"_30355":881,"_5":30684,"_21010":52215,"_27589":52216,"_2954":52217},[],"/docs/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3471":895,"_30355":881,"_5":30684,"_21010":52219,"_27589":52220,"_2954":52221},[],"/docs/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3471":896,"_30355":881,"_5":30684,"_21010":52223,"_27589":52224,"_2954":52225},[],"/docs/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3471":897,"_30355":881,"_5":30684,"_21010":52227,"_27589":52228,"_2954":52229},[],"/docs/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3471":898,"_30355":881,"_5":30684,"_21010":52231,"_27589":52232,"_2954":52233},[],"/docs/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3471":899,"_30355":881,"_5":30684,"_21010":52235,"_27589":52236,"_2954":52237},[],"/docs/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3471":900,"_30355":881,"_5":30684,"_21010":52239,"_27589":52240,"_2954":52241},[],"/docs/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3471":901,"_30355":881,"_21010":52243,"_5":14420,"_27589":881,"_2954":52244},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3471":902,"_30355":881,"_21010":52246,"_5":14420,"_27589":52173,"_2954":52247},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3471":903,"_30355":881,"_21010":52249,"_5":14420,"_27589":52173,"_2954":52250},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3471":904,"_30355":881,"_21010":52252,"_5":14420,"_27589":52180,"_2954":52253},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3471":905,"_30355":881,"_21010":52255,"_5":14420,"_27589":52184,"_2954":52256},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3471":906,"_30355":881,"_21010":52258,"_5":14420,"_27589":52188,"_2954":52259},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3471":907,"_30355":881,"_21010":52261,"_5":14420,"_27589":52192,"_2954":52262},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3471":908,"_30355":881,"_21010":52264,"_5":14420,"_27589":52196,"_2954":52265},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3471":909,"_30355":881,"_21010":52267,"_5":14420,"_27589":52204,"_2954":52268},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3471":910,"_30355":881,"_21010":52270,"_5":14420,"_27589":52204,"_2954":52271},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3471":911,"_30355":881,"_21010":52273,"_5":14420,"_27589":52208,"_2954":52274},[],"`settings.enrollment_settings` field",{"_3471":912,"_30355":881,"_21010":52276,"_5":14420,"_27589":52208,"_2954":52277},[],"Decision",{"_3471":913,"_30355":881,"_21010":52279,"_5":14420,"_27589":52208,"_2954":52280},[],"`protocol`",{"_3471":914,"_30355":881,"_21010":52282,"_5":14420,"_27589":52208,"_2954":52283},[],"`EST_RFC7030` for these operations.",{"_3471":915,"_30355":881,"_21010":52285,"_5":14420,"_27589":52208,"_2954":52286},[],"`enrollment_ca`",{"_3471":916,"_30355":881,"_21010":52288,"_5":14420,"_27589":52208,"_2954":52289},[],"ID of the signing CA.",{"_3471":917,"_30355":881,"_21010":52291,"_5":14420,"_27589":52208,"_2954":52292},[],"`verify_csr_signature`",{"_3471":918,"_30355":881,"_21010":52294,"_5":14420,"_27589":52208,"_2954":52295},[],"Keep `true` to verify CSR key possession.",{"_3471":919,"_30355":881,"_21010":52297,"_5":14420,"_27589":52208,"_2954":52298},[],"`enable_replaceable_enrollment`",{"_3471":920,"_30355":881,"_21010":52300,"_5":14420,"_27589":52208,"_2954":52301},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3471":921,"_30355":881,"_21010":52303,"_5":14420,"_27589":52208,"_2954":52304},[],"`est_rfc7030_settings.auth_mode`",{"_3471":922,"_30355":881,"_21010":52306,"_5":14420,"_27589":52208,"_2954":52307},[],"One of the four authentication modes.",{"_3471":923,"_30355":881,"_21010":52309,"_5":14420,"_27589":52208,"_2954":52310},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3471":924,"_30355":881,"_21010":52312,"_5":14420,"_27589":52212,"_2954":52313},[],"The blocks are independent:",{"_3471":925,"_30355":881,"_21010":52315,"_5":14420,"_27589":52212,"_2954":52316},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3471":926,"_30355":881,"_21010":52318,"_5":14420,"_27589":52212,"_2954":52319},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3471":927,"_30355":881,"_21010":52321,"_5":14420,"_27589":52212,"_2954":52322},[],"`auth_mode`",{"_3471":928,"_30355":881,"_21010":52324,"_5":14420,"_27589":52212,"_2954":52325},[],"Control applied in the configured operation",{"_3471":929,"_30355":881,"_21010":52327,"_5":14420,"_27589":52212,"_2954":52328},[],"`CLIENT_CERTIFICATE`",{"_3471":930,"_30355":881,"_21010":52330,"_5":14420,"_27589":52212,"_2954":52331},[],"Presented certificate validation.",{"_3471":931,"_30355":881,"_21010":52333,"_5":14420,"_27589":52212,"_2954":52334},[],"`EXTERNAL_WEBHOOK`",{"_3471":932,"_30355":881,"_21010":52336,"_5":14420,"_27589":52212,"_2954":52337},[],"Configured webhook authorization.",{"_3471":933,"_30355":881,"_21010":52339,"_5":14420,"_27589":52212,"_2954":52340},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3471":934,"_30355":881,"_21010":52342,"_5":14420,"_27589":52212,"_2954":52343},[],"Certificate validation followed by webhook approval.",{"_3471":935,"_30355":881,"_21010":52345,"_5":14420,"_27589":52212,"_2954":52346},[],"`NO_AUTH`",{"_3471":936,"_30355":881,"_21010":52348,"_5":14420,"_27589":52212,"_2954":52349},[],"No DMS requester authentication.",{"_3471":937,"_30355":881,"_21010":52351,"_5":14420,"_27589":52212,"_2954":52352},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3471":938,"_30355":881,"_21010":52354,"_5":14420,"_27589":52212,"_2954":52355},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3471":939,"_30355":881,"_21010":52357,"_5":14420,"_27589":52212,"_2954":52358},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3471":940,"_30355":881,"_21010":52360,"_5":14420,"_27589":52212,"_2954":52361},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3471":941,"_30355":881,"_21010":52363,"_5":14420,"_27589":52216,"_2954":52364},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3471":942,"_30355":881,"_21010":52366,"_5":14420,"_27589":52216,"_2954":52367},[],"`external_webhook_settings` field",{"_3471":943,"_30355":881,"_21010":52369,"_5":14420,"_27589":52216,"_2954":52277},[],{"_3471":944,"_30355":881,"_21010":52371,"_5":14420,"_27589":52216,"_2954":52372},[],"`url`",{"_3471":945,"_30355":881,"_21010":52374,"_5":14420,"_27589":52216,"_2954":52375},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3471":946,"_30355":881,"_21010":52377,"_5":14420,"_27589":52216,"_2954":52378},[],"`method`",{"_3471":947,"_30355":881,"_21010":52380,"_5":14420,"_27589":52216,"_2954":52381},[],"`POST` or `PUT`; `POST` by default.",{"_3471":948,"_30355":881,"_21010":52383,"_5":14420,"_27589":52216,"_2954":52384},[],"`name`",{"_3471":949,"_30355":881,"_21010":52386,"_5":14420,"_27589":52216,"_2954":52387},[],"Label used in service logs.",{"_3471":950,"_30355":881,"_21010":52389,"_5":14420,"_27589":52216,"_2954":52390},[],"`config.auth_mode`",{"_3471":951,"_30355":881,"_21010":52392,"_5":14420,"_27589":52216,"_2954":52393},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3471":952,"_30355":881,"_21010":52395,"_5":14420,"_27589":52216,"_2954":52396},[],"`config.log_level`",{"_3471":953,"_30355":881,"_21010":52398,"_5":14420,"_27589":52216,"_2954":52399},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3471":954,"_30355":881,"_21010":52401,"_5":14420,"_27589":52216,"_2954":52402},[],"`config.apikey_options`",{"_3471":955,"_30355":881,"_21010":52404,"_5":14420,"_27589":52216,"_2954":52405},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3471":956,"_30355":881,"_21010":52407,"_5":14420,"_27589":52216,"_2954":52408},[],"`config.jwt_options`",{"_3471":957,"_30355":881,"_21010":52410,"_5":14420,"_27589":52216,"_2954":52411},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3471":958,"_30355":881,"_21010":52413,"_5":14420,"_27589":52216,"_2954":52414},[],"`config.mtls_options`",{"_3471":959,"_30355":881,"_21010":52416,"_5":14420,"_27589":52216,"_2954":52417},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3471":960,"_30355":881,"_21010":52419,"_5":14420,"_27589":52216,"_2954":52420},[],"`config.insecure_skip_verify`",{"_3471":961,"_30355":881,"_21010":52422,"_5":14420,"_27589":52216,"_2954":52423},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3471":962,"_30355":881,"_21010":52425,"_5":14420,"_27589":52216,"_2954":52426},[],"`config.call_timeout`",{"_3471":963,"_30355":881,"_21010":52428,"_5":14420,"_27589":52216,"_2954":52429},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3471":964,"_30355":881,"_21010":52431,"_5":14420,"_27589":52216,"_2954":52432},[],"Rules for that configuration:",{"_3471":965,"_30355":881,"_21010":52434,"_5":14420,"_27589":52216,"_2954":52435},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3471":966,"_30355":881,"_21010":52437,"_5":14420,"_27589":52216,"_2954":52438},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3471":967,"_30355":881,"_21010":52440,"_5":14420,"_27589":52216,"_2954":52441},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3471":968,"_30355":881,"_21010":52443,"_5":14420,"_27589":52216,"_2954":52444},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3471":969,"_30355":881,"_21010":52446,"_5":14420,"_27589":52216,"_2954":52447},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3471":970,"_30355":881,"_21010":52449,"_5":14420,"_27589":52216,"_2954":52450},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3471":971,"_30355":881,"_21010":52452,"_5":14420,"_27589":52216,"_2954":52453},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3471":972,"_30355":881,"_21010":52455,"_5":14420,"_27589":52216,"_2954":52456},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3471":973,"_30355":881,"_21010":52458,"_5":14420,"_27589":52216,"_2954":52459},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3471":974,"_30355":881,"_21010":52461,"_5":14420,"_27589":52220,"_2954":52462},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. The resolved profile — including the CA default used as fallback when the DMS defines none — must define an end-entity certificate: a `Sign as CA` profile is rejected at enrollment and re-enrollment time. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3471":975,"_30355":881,"_21010":52464,"_5":14420,"_27589":52224,"_2954":52465},[],"`settings.reenrollment_settings` field",{"_3471":976,"_30355":881,"_21010":52467,"_5":14420,"_27589":52224,"_2954":49811},[],{"_3471":977,"_30355":881,"_21010":52469,"_5":14420,"_27589":52224,"_2954":52470},[],"`reenrollment_delta`",{"_3471":978,"_30355":881,"_21010":52472,"_5":14420,"_27589":52224,"_2954":52473},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3471":979,"_30355":881,"_21010":52475,"_5":14420,"_27589":52224,"_2954":52476},[],"`preventive_delta`",{"_3471":980,"_30355":881,"_21010":52478,"_5":14420,"_27589":52224,"_2954":52479},[],"Preventive operational monitoring threshold.",{"_3471":981,"_30355":881,"_21010":52481,"_5":14420,"_27589":52224,"_2954":52482},[],"`critical_delta`",{"_3471":982,"_30355":881,"_21010":52484,"_5":14420,"_27589":52224,"_2954":52485},[],"Critical operational monitoring threshold.",{"_3471":983,"_30355":881,"_21010":52487,"_5":14420,"_27589":52224,"_2954":52488},[],"`enable_expired_renewal`",{"_3471":984,"_30355":881,"_21010":52490,"_5":14420,"_27589":52224,"_2954":52491},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3471":985,"_30355":881,"_21010":52493,"_5":14420,"_27589":52224,"_2954":52494},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3471":986,"_30355":881,"_21010":52496,"_5":14420,"_27589":52224,"_2954":52497},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3471":987,"_30355":881,"_21010":52499,"_5":14420,"_27589":52224,"_2954":52500},[],"`revoke_on_reenrollment`",{"_3471":988,"_30355":881,"_21010":52502,"_5":14420,"_27589":52224,"_2954":52503},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3471":989,"_30355":881,"_21010":52505,"_5":14420,"_27589":52224,"_2954":52506},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3471":990,"_30355":881,"_21010":52508,"_5":14420,"_27589":52228,"_2954":52509},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3471":991,"_30355":881,"_21010":52511,"_5":14420,"_27589":52232,"_2954":49805},[],{"_3471":992,"_30355":881,"_21010":52513,"_5":14420,"_27589":52232,"_2954":52514},[],"Published material",{"_3471":993,"_30355":881,"_21010":52516,"_5":14420,"_27589":52232,"_2954":52517},[],"**Include Lamassu System CA**",{"_3471":994,"_30355":881,"_21010":52519,"_5":14420,"_27589":52232,"_2954":52520},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3471":995,"_30355":881,"_21010":52522,"_5":14420,"_27589":52232,"_2954":52523},[],"**Include Enrollment CA**",{"_3471":996,"_30355":881,"_21010":52525,"_5":14420,"_27589":52232,"_2954":52526},[],"Selected issuing CA certificate.",{"_3471":997,"_30355":881,"_21010":52528,"_5":14420,"_27589":52232,"_2954":52529},[],"**Managed CAs**",{"_3471":998,"_30355":881,"_21010":52531,"_5":14420,"_27589":52232,"_2954":52532},[],"Explicitly selected CA certificates.",{"_3471":999,"_30355":881,"_21010":52534,"_5":14420,"_27589":52232,"_2954":52535},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3471":1000,"_30355":881,"_21010":52537,"_5":14420,"_27589":52236,"_2954":52538},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3471":1001,"_30355":881,"_21010":52540,"_5":14420,"_27589":52236,"_2954":52541},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3471":1002,"_30355":881,"_21010":52543,"_5":14420,"_27589":52236,"_2954":52544},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3471":1003,"_30355":881,"_21010":52546,"_5":14420,"_27589":52240,"_2954":52547},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3471":1004,"_30355":1004,"_5":14772,"_2954":52549,"_30687":52550,"_21010":52551,"_27589":1004},"Integrate the EST client",[49421,50896,51910,51908,52091],[],{"_3471":1005,"_30355":1004,"_21010":52553,"_5":14420,"_27589":1004,"_2954":52554},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3471":1006,"_30355":1004,"_5":30684,"_21010":52556,"_27589":52557,"_2954":49431},[],"/docs/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3471":1007,"_30355":1004,"_5":30684,"_21010":52559,"_27589":52560,"_2954":52561},[],"/docs/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3471":1008,"_30355":1004,"_5":30684,"_21010":52563,"_27589":52564,"_2954":52565},[],"/docs/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3471":1009,"_30355":1004,"_5":30684,"_21010":52567,"_27589":52568,"_2954":52569},[],"/docs/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3471":1010,"_30355":1004,"_5":30684,"_21010":52571,"_27589":52572,"_2954":52573},[],"/docs/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3471":1011,"_30355":1004,"_5":30684,"_21010":52575,"_27589":52576,"_2954":52577},[],"/docs/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3471":1012,"_30355":1004,"_21010":52579,"_5":14420,"_27589":1004,"_2954":52580},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3471":1013,"_30355":1004,"_21010":52582,"_5":14420,"_27589":52557,"_2954":52583},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3471":1014,"_30355":1004,"_21010":52585,"_5":14420,"_27589":52557,"_2954":52586},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3471":1015,"_30355":1004,"_21010":52588,"_5":14420,"_27589":52557,"_2954":52589},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3471":1016,"_30355":1004,"_21010":52591,"_5":14420,"_27589":52560,"_2954":52592},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3471":1017,"_30355":1004,"_21010":52594,"_5":14420,"_27589":52560,"_2954":52595},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3471":1018,"_30355":1004,"_21010":52597,"_5":14420,"_27589":52564,"_2954":52598},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3471":1019,"_30355":1004,"_21010":52600,"_5":14420,"_27589":52564,"_2954":52601},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3471":1020,"_30355":1004,"_21010":52603,"_5":14420,"_27589":52568,"_2954":52604},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3471":1021,"_30355":1004,"_21010":52606,"_5":14420,"_27589":52568,"_2954":52607},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3471":1022,"_30355":1004,"_21010":52609,"_5":14420,"_27589":52572,"_2954":52610},[],"For a root that issues directly:",{"_3471":1023,"_30355":1004,"_21010":52612,"_5":14420,"_27589":52572,"_2954":52613},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3471":1024,"_30355":1004,"_21010":52615,"_5":14420,"_27589":52572,"_2954":52616},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3471":1025,"_30355":1004,"_21010":52618,"_5":14420,"_27589":52576,"_2954":52619},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3471":1026,"_30355":1026,"_5":14772,"_2954":52621,"_30687":52622,"_21010":52623,"_27589":1026},"EST reference",[49421,50896,51910,51908,52091],[],{"_3471":1027,"_30355":1026,"_21010":52625,"_5":14420,"_27589":1026,"_2954":52626},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3471":1028,"_30355":1026,"_5":30684,"_21010":52628,"_27589":52629,"_2954":52630},[],"/docs/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3471":1029,"_30355":1026,"_5":30684,"_21010":52632,"_27589":52633,"_2954":22765},[],"/docs/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3471":1030,"_30355":1026,"_5":30684,"_21010":52635,"_27589":52636,"_2954":26172},[],"/docs/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3471":1031,"_30355":1026,"_5":30684,"_21010":52638,"_27589":52639,"_2954":26179},[],"/docs/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3471":1032,"_30355":1026,"_5":30684,"_21010":52641,"_27589":52642,"_2954":25492},[],"/docs/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3471":1033,"_30355":1026,"_5":30684,"_21010":52644,"_27589":52645,"_2954":52646},[],"/docs/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3471":1034,"_30355":1026,"_5":30684,"_21010":52648,"_27589":52649,"_2954":52650},[],"/docs/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3471":1035,"_30355":1026,"_5":30684,"_21010":52652,"_27589":52653,"_2954":52654},[],"/docs/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3471":1036,"_30355":1026,"_21010":52656,"_5":14420,"_27589":1026,"_2954":52657},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3471":1037,"_30355":1026,"_21010":52659,"_5":14420,"_27589":52629,"_2954":52660},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3471":1038,"_30355":1026,"_21010":52662,"_5":14420,"_27589":52629,"_2954":52663},[],"Operation",{"_3471":1039,"_30355":1026,"_21010":52665,"_5":14420,"_27589":52629,"_2954":52666},[],"Method",{"_3471":1040,"_30355":1026,"_21010":52668,"_5":14420,"_27589":52629,"_2954":52669},[],"Authentication and condition",{"_3471":1041,"_30355":1026,"_21010":52671,"_5":14420,"_27589":52629,"_2954":52672},[],"`/cacerts`",{"_3471":1042,"_30355":1026,"_21010":52674,"_5":14420,"_27589":52629,"_2954":52675},[],"GET",{"_3471":1043,"_30355":1026,"_21010":52677,"_5":14420,"_27589":52629,"_2954":52678},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3471":1044,"_30355":1026,"_21010":52680,"_5":14420,"_27589":52629,"_2954":52681},[],"`/simpleenroll`",{"_3471":1045,"_30355":1026,"_21010":52683,"_5":14420,"_27589":52629,"_2954":52684},[],"POST",{"_3471":1046,"_30355":1026,"_21010":52686,"_5":14420,"_27589":52629,"_2954":52687},[],"Initial authentication and DMS registration/replacement policy.",{"_3471":1047,"_30355":1026,"_21010":52689,"_5":14420,"_27589":52629,"_2954":52690},[],"`/simplereenroll`",{"_3471":1048,"_30355":1026,"_21010":52692,"_5":14420,"_27589":52629,"_2954":52684},[],{"_3471":1049,"_30355":1026,"_21010":52694,"_5":14420,"_27589":52629,"_2954":52695},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3471":1050,"_30355":1026,"_21010":52697,"_5":14420,"_27589":52629,"_2954":52698},[],"`/serverkeygen`",{"_3471":1051,"_30355":1026,"_21010":52700,"_5":14420,"_27589":52629,"_2954":52684},[],{"_3471":1052,"_30355":1026,"_21010":52702,"_5":14420,"_27589":52629,"_2954":52703},[],"Initial authentication and admission; server generation enabled.",{"_3471":1053,"_30355":1026,"_21010":52705,"_5":14420,"_27589":52629,"_2954":52706},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3471":1054,"_30355":1026,"_21010":52708,"_5":14420,"_27589":52633,"_2954":52709},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3471":1055,"_30355":1026,"_21010":52711,"_5":14420,"_27589":52633,"_2954":52712},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3471":1056,"_30355":1026,"_21010":52714,"_5":14420,"_27589":52636,"_2954":52715},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3471":1057,"_30355":1026,"_21010":52717,"_5":14420,"_27589":52636,"_2954":52718},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3471":1058,"_30355":1026,"_21010":52720,"_5":14420,"_27589":52639,"_2954":52721},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3471":1059,"_30355":1026,"_21010":52723,"_5":14420,"_27589":52639,"_2954":52724},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3471":1060,"_30355":1026,"_21010":52726,"_5":14420,"_27589":52642,"_2954":52727},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3471":1061,"_30355":1026,"_21010":52729,"_5":14420,"_27589":52642,"_2954":52730},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3471":1062,"_30355":1026,"_21010":52732,"_5":14420,"_27589":52645,"_2954":52733},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3471":1063,"_30355":1026,"_21010":52735,"_5":14420,"_27589":52645,"_2954":52736},[],"Part",{"_3471":1064,"_30355":1026,"_21010":52738,"_5":14420,"_27589":52645,"_2954":52739},[],"Content after decoding its Base64",{"_3471":1065,"_30355":1026,"_21010":52741,"_5":14420,"_27589":52645,"_2954":52742},[],"`application/pkcs8`",{"_3471":1066,"_30355":1026,"_21010":52744,"_5":14420,"_27589":52645,"_2954":52745},[],"Unencrypted DER PKCS#8 private key.",{"_3471":1067,"_30355":1026,"_21010":52747,"_5":14420,"_27589":52645,"_2954":52748},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3471":1068,"_30355":1026,"_21010":52750,"_5":14420,"_27589":52645,"_2954":52751},[],"DER PKCS#7 containing the issued certificate.",{"_3471":1069,"_30355":1026,"_21010":52753,"_5":14420,"_27589":52645,"_2954":52754},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3471":1070,"_30355":1026,"_21010":52756,"_5":14420,"_27589":52649,"_2954":52757},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3471":1071,"_30355":1026,"_21010":52759,"_5":14420,"_27589":52649,"_2954":52760},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3471":1072,"_30355":1026,"_21010":52762,"_5":14420,"_27589":52649,"_2954":52763},[],"Convert and check the result:",{"_3471":1073,"_30355":1026,"_21010":52765,"_5":14420,"_27589":52649,"_2954":52766},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3471":1074,"_30355":1026,"_21010":52768,"_5":14420,"_27589":52653,"_2954":52769},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3471":1075,"_30355":1026,"_21010":52771,"_5":14420,"_27589":52653,"_2954":52772},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3471":1076,"_30355":1076,"_5":14772,"_2954":52091,"_30687":52774,"_21010":52775,"_27589":1076},[49421,50896,51910,51908,52091],[],{"_3471":1077,"_30355":1076,"_21010":52777,"_5":14420,"_27589":1076,"_2954":52778},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3471":1078,"_30355":1076,"_5":30684,"_21010":52780,"_27589":52781,"_2954":52782},[],"/docs/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3471":1079,"_30355":1076,"_5":30684,"_21010":52784,"_27589":52785,"_2954":52786},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3471":1080,"_30355":1076,"_5":30684,"_21010":52788,"_27589":52789,"_2954":52790},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3471":1081,"_30355":1076,"_5":30684,"_21010":52792,"_27589":52793,"_2954":52794},[],"/docs/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3471":1082,"_30355":1076,"_21010":52796,"_5":14420,"_27589":1076,"_2954":52797},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3471":1083,"_30355":1076,"_21010":52799,"_5":14420,"_27589":52781,"_2954":52800},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3471":1084,"_30355":1076,"_21010":52802,"_5":14420,"_27589":52781,"_2954":52803},[],"The integrator installs initial EST server trust and an admission credential.",{"_3471":1085,"_30355":1076,"_21010":52805,"_5":14420,"_27589":52781,"_2954":52806},[],"The client requests an identity for its `Device ID` through EST.",{"_3471":1086,"_30355":1076,"_21010":52808,"_5":14420,"_27589":52781,"_2954":52809},[],"Certificate, device binding and key/certificate installation are checked.",{"_3471":1087,"_30355":1076,"_21010":52811,"_5":14420,"_27589":52781,"_2954":52812},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3471":1088,"_30355":1076,"_21010":52814,"_5":14420,"_27589":52781,"_2954":52815},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3471":1089,"_30355":1076,"_21010":52817,"_5":14420,"_27589":52785,"_2954":52818},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3471":1090,"_30355":1076,"_21010":52820,"_5":14420,"_27589":52785,"_2954":52821},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3471":1091,"_30355":1076,"_21010":52823,"_5":14420,"_27589":52785,"_2954":52824},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3471":1092,"_30355":1076,"_21010":52826,"_5":14420,"_27589":52785,"_2954":52827},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3471":1093,"_30355":1076,"_21010":52829,"_5":14420,"_27589":52789,"_2954":52830},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3471":1094,"_30355":1076,"_21010":52832,"_5":14420,"_27589":52789,"_2954":52833},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3471":1095,"_30355":1076,"_21010":52835,"_5":14420,"_27589":52789,"_2954":52836},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3471":1096,"_30355":1076,"_21010":52838,"_5":14420,"_27589":52789,"_2954":52839},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3471":1097,"_30355":1076,"_21010":52841,"_5":14420,"_27589":52793,"_2954":52842},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3471":1098,"_30355":1076,"_21010":52844,"_5":14420,"_27589":52793,"_2954":52845},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3471":1099,"_30355":1099,"_5":14772,"_2954":52847,"_30687":52848,"_21010":52849,"_27589":1099},"Provisioning strategies",[49421,50896,51910,51908,52091],[],{"_3471":1100,"_30355":1099,"_21010":52851,"_5":14420,"_27589":1099,"_2954":52852},[],"Choose device registration, identity authorization and key generation.",{"_3471":1101,"_30355":1099,"_5":30684,"_21010":52854,"_27589":52855,"_2954":52856},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3471":1102,"_30355":1099,"_5":30684,"_21010":52858,"_27589":52859,"_2954":52860},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3471":1103,"_30355":1099,"_5":30684,"_21010":52862,"_27589":52863,"_2954":52864},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3471":1104,"_30355":1099,"_5":30684,"_21010":52866,"_27589":52867,"_2954":52868},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3471":1105,"_30355":1099,"_5":30684,"_21010":52870,"_27589":52871,"_2954":52872},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3471":1106,"_30355":1099,"_21010":52874,"_5":14420,"_27589":1099,"_2954":52875},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3471":1107,"_30355":1099,"_21010":52877,"_5":14420,"_27589":52855,"_2954":52878},[],"Path",{"_3471":1108,"_30355":1099,"_21010":52880,"_5":14420,"_27589":52855,"_2954":52881},[],"When the device exists",{"_3471":1109,"_30355":1099,"_21010":52883,"_5":14420,"_27589":52855,"_2954":52884},[],"What to check",{"_3471":1110,"_30355":1099,"_21010":52886,"_5":14420,"_27589":52855,"_2954":52887},[],"Manual assignment",{"_3471":1111,"_30355":1099,"_21010":52889,"_5":14420,"_27589":52855,"_2954":52890},[],"An operator creates it before associating a certificate.",{"_3471":1112,"_30355":1099,"_21010":52892,"_5":14420,"_27589":52855,"_2954":52893},[],"ID, owning DMS, certificate CN and bound serial.",{"_3471":1113,"_30355":1099,"_21010":52895,"_5":14420,"_27589":52855,"_2954":52896},[],"EST with `JITP`",{"_3471":1114,"_30355":1099,"_21010":52898,"_5":14420,"_27589":52855,"_2954":52899},[],"Created for an unknown CN during `/simpleenroll`.",{"_3471":1115,"_30355":1099,"_21010":52901,"_5":14420,"_27589":52855,"_2954":52902},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3471":1116,"_30355":1099,"_21010":52904,"_5":14420,"_27589":52855,"_2954":52905},[],"EST with `PRE_REGISTRATION`",{"_3471":1117,"_30355":1099,"_21010":52907,"_5":14420,"_27589":52855,"_2954":52908},[],"Must exist before `/simpleenroll`.",{"_3471":1118,"_30355":1099,"_21010":52910,"_5":14420,"_27589":52855,"_2954":52911},[],"Approved record, same DMS and replacement conditions for your version.",{"_3471":1119,"_30355":1099,"_21010":52913,"_5":14420,"_27589":52855,"_2954":52914},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3471":1120,"_30355":1099,"_21010":52916,"_5":14420,"_27589":52855,"_2954":52917},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3471":1121,"_30355":1099,"_21010":52919,"_5":14420,"_27589":52859,"_2954":52920},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3471":1122,"_30355":1099,"_21010":52922,"_5":14420,"_27589":52859,"_2954":52923},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3471":1123,"_30355":1099,"_21010":52925,"_5":14420,"_27589":52859,"_2954":52926},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3471":1124,"_30355":1099,"_21010":52928,"_5":14420,"_27589":52863,"_2954":52929},[],"Decide initial enrollment and re-enrollment separately:",{"_3471":1125,"_30355":1099,"_21010":52931,"_5":14420,"_27589":52863,"_2954":52932},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3471":1126,"_30355":1099,"_21010":52934,"_5":14420,"_27589":52863,"_2954":52935},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3471":1127,"_30355":1099,"_21010":52937,"_5":14420,"_27589":52863,"_2954":52938},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3471":1128,"_30355":1099,"_21010":52940,"_5":14420,"_27589":52863,"_2954":52941},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3471":1129,"_30355":1099,"_21010":52943,"_5":14420,"_27589":52863,"_2954":52944},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3471":1130,"_30355":1099,"_21010":52946,"_5":14420,"_27589":52867,"_2954":49805},[],{"_3471":1131,"_30355":1099,"_21010":52948,"_5":14420,"_27589":52867,"_2954":52949},[],"Material crossing EST",{"_3471":1132,"_30355":1099,"_21010":52951,"_5":14420,"_27589":52867,"_2954":52952},[],"Device-generated key",{"_3471":1133,"_30355":1099,"_21010":52954,"_5":14420,"_27589":52867,"_2954":52955},[],"Public CSR and certificate; the key stays on the client.",{"_3471":1134,"_30355":1099,"_21010":52957,"_5":14420,"_27589":52867,"_2954":52958},[],"Existing device key",{"_3471":1135,"_30355":1099,"_21010":52960,"_5":14420,"_27589":52867,"_2954":52961},[],"CSR signed with that key and a new certificate.",{"_3471":1136,"_30355":1099,"_21010":52963,"_5":14420,"_27589":52867,"_2954":52229},[],{"_3471":1137,"_30355":1099,"_21010":52965,"_5":14420,"_27589":52867,"_2954":52966},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3471":1138,"_30355":1099,"_21010":52968,"_5":14420,"_27589":52867,"_2954":52969},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3471":1139,"_30355":1099,"_21010":52971,"_5":14420,"_27589":52871,"_2954":52972},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3471":1140,"_30355":1140,"_5":14772,"_2954":52974,"_30687":52975,"_21010":52976,"_27589":1140},"Renewal and recovery",[49421,50896,51910,51908,52091],[],{"_3471":1141,"_30355":1140,"_21010":52978,"_5":14420,"_27589":1140,"_2954":52979},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3471":1142,"_30355":1140,"_5":30684,"_21010":52981,"_27589":52982,"_2954":52983},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3471":1143,"_30355":1140,"_5":30684,"_21010":52985,"_27589":52986,"_2954":52987},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3471":1144,"_30355":1140,"_5":30684,"_21010":52989,"_27589":52990,"_2954":52991},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3471":1145,"_30355":1140,"_5":30684,"_21010":52993,"_27589":52994,"_2954":52995},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3471":1146,"_30355":1140,"_5":30684,"_21010":52997,"_27589":52998,"_2954":52999},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3471":1147,"_30355":1140,"_21010":53001,"_5":14420,"_27589":1140,"_2954":53002},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3471":1148,"_30355":1140,"_21010":53004,"_5":14420,"_27589":52982,"_2954":53005},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3471":1149,"_30355":1140,"_21010":53007,"_5":14420,"_27589":52982,"_2954":53008},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3471":1150,"_30355":1140,"_21010":53010,"_5":14420,"_27589":52982,"_2954":53011},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3471":1151,"_30355":1140,"_21010":53013,"_5":14420,"_27589":52982,"_2954":53014},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3471":1152,"_30355":1140,"_21010":53016,"_5":14420,"_27589":52986,"_2954":53017},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3471":1153,"_30355":1140,"_21010":53019,"_5":14420,"_27589":52986,"_2954":53020},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3471":1154,"_30355":1140,"_21010":53022,"_5":14420,"_27589":52990,"_2954":53023},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3471":1155,"_30355":1140,"_21010":53025,"_5":14420,"_27589":52990,"_2954":53026},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3471":1156,"_30355":1140,"_21010":53028,"_5":14420,"_27589":52990,"_2954":53029},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3471":1157,"_30355":1140,"_21010":53031,"_5":14420,"_27589":52994,"_2954":53032},[],"Situation",{"_3471":1158,"_30355":1140,"_21010":53034,"_5":14420,"_27589":52994,"_2954":53035},[],"Procedure",{"_3471":1159,"_30355":1140,"_21010":53037,"_5":14420,"_27589":52994,"_2954":53038},[],"Valid certificate, outside the window",{"_3471":1160,"_30355":1140,"_21010":53040,"_5":14420,"_27589":52994,"_2954":53041},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3471":1161,"_30355":1140,"_21010":53043,"_5":14420,"_27589":52994,"_2954":53044},[],"Expired certificate, key available",{"_3471":1162,"_30355":1140,"_21010":53046,"_5":14420,"_27589":52994,"_2954":53047},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3471":1163,"_30355":1140,"_21010":53049,"_5":14420,"_27589":52994,"_2954":53050},[],"Renewal through webhook or `NO_AUTH`",{"_3471":1164,"_30355":1140,"_21010":53052,"_5":14420,"_27589":52994,"_2954":53053},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3471":1165,"_30355":1140,"_21010":53055,"_5":14420,"_27589":52994,"_2954":53056},[],"Lost or inaccessible key",{"_3471":1166,"_30355":1140,"_21010":53058,"_5":14420,"_27589":52994,"_2954":53059},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3471":1167,"_30355":1140,"_21010":53061,"_5":14420,"_27589":52994,"_2954":53062},[],"Current identity revoked",{"_3471":1168,"_30355":1140,"_21010":53064,"_5":14420,"_27589":52994,"_2954":53065},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3471":1169,"_30355":1140,"_21010":53067,"_5":14420,"_27589":52994,"_2954":53068},[],"Device without an identity",{"_3471":1170,"_30355":1140,"_21010":53070,"_5":14420,"_27589":52994,"_2954":53071},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3471":1171,"_30355":1140,"_21010":53073,"_5":14420,"_27589":52994,"_2954":53074},[],"Retired device",{"_3471":1172,"_30355":1140,"_21010":53076,"_5":14420,"_27589":52994,"_2954":53077},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3471":1173,"_30355":1140,"_21010":53079,"_5":14420,"_27589":52994,"_2954":53080},[],"Timeout, HTTP 500 or installation failure",{"_3471":1174,"_30355":1140,"_21010":53082,"_5":14420,"_27589":52994,"_2954":53083},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3471":1175,"_30355":1140,"_21010":53085,"_5":14420,"_27589":52998,"_2954":53086},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3471":1176,"_30355":1140,"_21010":53088,"_5":14420,"_27589":52998,"_2954":53089},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3471":1177,"_30355":1177,"_5":14772,"_2954":53091,"_30687":53092,"_21010":53093,"_27589":1177},"Enrollment troubleshooting",[49421,50896,51910,51908,52091],[],{"_3471":1178,"_30355":1177,"_21010":53095,"_5":14420,"_27589":1177,"_2954":53096},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3471":1179,"_30355":1177,"_5":30684,"_21010":53098,"_27589":53099,"_2954":53100},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3471":1180,"_30355":1177,"_5":30684,"_21010":53102,"_27589":53103,"_2954":53104},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3471":1181,"_30355":1177,"_5":30684,"_21010":53106,"_27589":53107,"_2954":52654},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3471":1182,"_30355":1177,"_5":30684,"_21010":53109,"_27589":53110,"_2954":53111},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3471":1183,"_30355":1177,"_21010":53113,"_5":14420,"_27589":1177,"_2954":53114},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3471":1184,"_30355":1177,"_21010":53116,"_5":14420,"_27589":53103,"_2954":53117},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3471":1185,"_30355":1177,"_21010":53119,"_5":14420,"_27589":53103,"_2954":53120},[],"Symptom or message",{"_3471":1186,"_30355":1177,"_21010":53122,"_5":14420,"_27589":53103,"_2954":52884},[],{"_3471":1187,"_30355":1177,"_21010":53124,"_5":14420,"_27589":53103,"_2954":53125},[],"curl rejects TLS, name or issuer",{"_3471":1188,"_30355":1177,"_21010":53127,"_5":14420,"_27589":53103,"_2954":53128},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3471":1189,"_30355":1177,"_21010":53130,"_5":14420,"_27589":53103,"_2954":53131},[],"404 or missing APS",{"_3471":1190,"_30355":1177,"_21010":53133,"_5":14420,"_27589":53103,"_2954":53134},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3471":1191,"_30355":1177,"_21010":53136,"_5":14420,"_27589":53103,"_2954":53137},[],"400, CSR or format error",{"_3471":1192,"_30355":1177,"_21010":53139,"_5":14420,"_27589":53103,"_2954":53140},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3471":1193,"_30355":1177,"_21010":53142,"_5":14420,"_27589":53103,"_2954":53143},[],"Missing credential or invalid certificate",{"_3471":1194,"_30355":1177,"_21010":53145,"_5":14420,"_27589":53103,"_2954":53146},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3471":1195,"_30355":1177,"_21010":53148,"_5":14420,"_27589":53103,"_2954":53149},[],"Webhook denies, times out or responds without authorization",{"_3471":1196,"_30355":1177,"_21010":53151,"_5":14420,"_27589":53103,"_2954":53152},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3471":1197,"_30355":1177,"_21010":53154,"_5":14420,"_27589":53103,"_2954":53155},[],"`unexpected status code: <n>: redirects are not followed`",{"_3471":1198,"_30355":1177,"_21010":53157,"_5":14420,"_27589":53103,"_2954":53158},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3471":1199,"_30355":1177,"_21010":53160,"_5":14420,"_27589":53103,"_2954":53161},[],"`webhook response exceeds 1048576 bytes`",{"_3471":1200,"_30355":1177,"_21010":53163,"_5":14420,"_27589":53103,"_2954":53164},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3471":1201,"_30355":1177,"_21010":53166,"_5":14420,"_27589":53103,"_2954":53167},[],"`webhook config must not reference files`",{"_3471":1202,"_30355":1177,"_21010":53169,"_5":14420,"_27589":53103,"_2954":53170},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3471":1203,"_30355":1177,"_21010":53172,"_5":14420,"_27589":53103,"_2954":53173},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3471":1204,"_30355":1177,"_21010":53175,"_5":14420,"_27589":53103,"_2954":53176},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3471":1205,"_30355":1177,"_21010":53178,"_5":14420,"_27589":53103,"_2954":53179},[],"`webhook mTLS certificate and key are invalid: …`",{"_3471":1206,"_30355":1177,"_21010":53181,"_5":14420,"_27589":53103,"_2954":53182},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3471":1207,"_30355":1177,"_21010":53184,"_5":14420,"_27589":53103,"_2954":53185},[],"400 `struct validation error` creating or updating a DMS",{"_3471":1208,"_30355":1177,"_21010":53187,"_5":14420,"_27589":53103,"_2954":53188},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3471":1209,"_30355":1177,"_21010":53190,"_5":14420,"_27589":53103,"_2954":53191},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3471":1210,"_30355":1177,"_21010":53193,"_5":14420,"_27589":53103,"_2954":53194},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3471":1211,"_30355":1177,"_21010":53196,"_5":14420,"_27589":53103,"_2954":53197},[],"`device not preregistered`",{"_3471":1212,"_30355":1177,"_21010":53199,"_5":14420,"_27589":53103,"_2954":53200},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3471":1213,"_30355":1177,"_21010":53202,"_5":14420,"_27589":53103,"_2954":53203},[],"`forbiddenNewEnrollment`",{"_3471":1214,"_30355":1177,"_21010":53205,"_5":14420,"_27589":53103,"_2954":53206},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3471":1215,"_30355":1177,"_21010":53208,"_5":14420,"_27589":53103,"_2954":53209},[],"Different owning DMS",{"_3471":1216,"_30355":1177,"_21010":53211,"_5":14420,"_27589":53103,"_2954":53212},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3471":1217,"_30355":1177,"_21010":53214,"_5":14420,"_27589":53103,"_2954":53215},[],"`invalid RawSubject bytes`",{"_3471":1218,"_30355":1177,"_21010":53217,"_5":14420,"_27589":53103,"_2954":53218},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3471":1219,"_30355":1177,"_21010":53220,"_5":14420,"_27589":53103,"_2954":53221},[],"`invalid reenroll window`",{"_3471":1220,"_30355":1177,"_21010":53223,"_5":14420,"_27589":53103,"_2954":53224},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3471":1221,"_30355":1177,"_21010":53226,"_5":14420,"_27589":53103,"_2954":53227},[],"Current certificate revoked",{"_3471":1222,"_30355":1177,"_21010":53229,"_5":14420,"_27589":53103,"_2954":53230},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3471":1223,"_30355":1177,"_21010":53232,"_5":14420,"_27589":53103,"_2954":53233},[],"CA, profile or signing error",{"_3471":1224,"_30355":1177,"_21010":53235,"_5":14420,"_27589":53103,"_2954":53236},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3471":1225,"_30355":1177,"_21010":53238,"_5":14420,"_27589":53103,"_2954":53239},[],"HTTP 200 without a device connection",{"_3471":1226,"_30355":1177,"_21010":53241,"_5":14420,"_27589":53103,"_2954":53242},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3471":1227,"_30355":1177,"_21010":53244,"_5":14420,"_27589":53103,"_2954":53245},[],"Timeout or error after issuance",{"_3471":1228,"_30355":1177,"_21010":53247,"_5":14420,"_27589":53103,"_2954":53248},[],"New certificates, current slot and previous identity's state before retrying.",{"_3471":1229,"_30355":1177,"_21010":53250,"_5":14420,"_27589":53107,"_2954":53251},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3471":1230,"_30355":1177,"_21010":53253,"_5":14420,"_27589":53107,"_2954":53254},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3471":1231,"_30355":1177,"_21010":53256,"_5":14420,"_27589":53110,"_2954":53257},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3471":1232,"_30355":1177,"_21010":53259,"_5":14420,"_27589":53110,"_2954":53260},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3471":1233,"_30355":1177,"_21010":53262,"_5":14420,"_27589":53110,"_2954":53263},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3471":1234,"_30355":1177,"_21010":53265,"_5":14420,"_27589":53110,"_2954":53266},[],"Make one request, save headers/body and query the device and certificates.",{"_3471":1235,"_30355":1177,"_21010":53268,"_5":14420,"_27589":53110,"_2954":53269},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3471":1236,"_30355":1177,"_21010":53271,"_5":14420,"_27589":53110,"_2954":53272},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3471":1237,"_30355":1177,"_21010":53274,"_5":14420,"_27589":53110,"_2954":53275},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3471":1238,"_30355":1238,"_5":14772,"_2954":53277,"_30687":53278,"_21010":53279,"_27589":1238},"Trust distribution and updates",[49421,50896,51910,51908,52091],[],{"_3471":1239,"_30355":1238,"_21010":53281,"_5":14420,"_27589":1238,"_2954":53282},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3471":1240,"_30355":1238,"_5":30684,"_21010":53284,"_27589":53285,"_2954":53286},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3471":1241,"_30355":1238,"_5":30684,"_21010":53288,"_27589":53289,"_2954":53290},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3471":1242,"_30355":1238,"_5":30684,"_21010":53292,"_27589":53293,"_2954":53294},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3471":1243,"_30355":1238,"_5":30684,"_21010":53296,"_27589":53297,"_2954":53298},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3471":1244,"_30355":1238,"_5":30684,"_21010":53300,"_27589":53301,"_2954":53302},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3471":1245,"_30355":1238,"_21010":53304,"_5":14420,"_27589":1238,"_2954":53305},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3471":1246,"_30355":1238,"_21010":53307,"_5":14420,"_27589":53285,"_2954":53308},[],"Relationship",{"_3471":1247,"_30355":1238,"_21010":53310,"_5":14420,"_27589":53285,"_2954":53311},[],"Material prepared by its owner",{"_3471":1248,"_30355":1238,"_21010":53313,"_5":14420,"_27589":53285,"_2954":53314},[],"Device → EST server",{"_3471":1249,"_30355":1238,"_21010":53316,"_5":14420,"_27589":53285,"_2954":53317},[],"Previously verified server root, chain or pin and TLS name.",{"_3471":1250,"_30355":1238,"_21010":53319,"_5":14420,"_27589":53285,"_2954":53320},[],"DMS → requester",{"_3471":1251,"_30355":1238,"_21010":53322,"_5":14420,"_27589":53285,"_2954":53323},[],"CAs and rules authorizing initial or renewal credentials.",{"_3471":1252,"_30355":1238,"_21010":53325,"_5":14420,"_27589":53285,"_2954":53326},[],"Consumer → device",{"_3471":1253,"_30355":1238,"_21010":53328,"_5":14420,"_27589":53285,"_2954":53329},[],"Operational identity roots, intermediates, validation and permissions.",{"_3471":1254,"_30355":1238,"_21010":53331,"_5":14420,"_27589":53285,"_2954":53332},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3471":1255,"_30355":1238,"_21010":53334,"_5":14420,"_27589":53289,"_2954":53335},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3471":1256,"_30355":1238,"_21010":53337,"_5":14420,"_27589":53289,"_2954":53338},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3471":1257,"_30355":1238,"_21010":53340,"_5":14420,"_27589":53293,"_2954":53341},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3471":1258,"_30355":1238,"_21010":53343,"_5":14420,"_27589":53293,"_2954":53344},[],"Select policy-approved roots as anchors.",{"_3471":1259,"_30355":1238,"_21010":53346,"_5":14420,"_27589":53293,"_2954":53347},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3471":1260,"_30355":1238,"_21010":53349,"_5":14420,"_27589":53293,"_2954":53350},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3471":1261,"_30355":1238,"_21010":53352,"_5":14420,"_27589":53293,"_2954":53353},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3471":1262,"_30355":1238,"_21010":53355,"_5":14420,"_27589":53293,"_2954":53356},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3471":1263,"_30355":1238,"_21010":53358,"_5":14420,"_27589":53297,"_2954":53359},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3471":1264,"_30355":1238,"_21010":53361,"_5":14420,"_27589":53297,"_2954":53362},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3471":1265,"_30355":1238,"_21010":53364,"_5":14420,"_27589":53297,"_2954":53365},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3471":1266,"_30355":1238,"_21010":53367,"_5":14420,"_27589":53301,"_2954":53368},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3471":1267,"_30355":1267,"_5":14772,"_2954":53370,"_30687":53371,"_21010":53373,"_27589":1267},"AWS IoT Core",[49421,50896,51910,51908,53372],"Integrations",[],{"_3471":1268,"_30355":1267,"_21010":53375,"_5":14420,"_27589":1267,"_2954":53376},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3471":1269,"_30355":1267,"_5":30684,"_21010":53378,"_27589":53379,"_2954":53380},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3471":1270,"_30355":1267,"_5":30684,"_21010":53382,"_27589":53383,"_2954":53384},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3471":1271,"_30355":1267,"_5":30684,"_21010":53386,"_27589":53387,"_2954":53388},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3471":1272,"_30355":1267,"_5":30684,"_21010":53390,"_27589":53391,"_2954":53392},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3471":1273,"_30355":1267,"_5":30684,"_21010":53394,"_27589":53395,"_2954":53396},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3471":1274,"_30355":1267,"_5":30684,"_21010":53398,"_27589":53399,"_2954":53400},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3471":1275,"_30355":1267,"_5":30684,"_21010":53402,"_27589":53403,"_2954":53404},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3471":1276,"_30355":1267,"_5":30684,"_21010":53406,"_27589":53407,"_2954":53408},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3471":1277,"_30355":1267,"_5":30684,"_21010":53410,"_27589":53411,"_2954":53412},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3471":1278,"_30355":1267,"_5":30684,"_21010":53414,"_27589":53415,"_2954":53416},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3471":1279,"_30355":1267,"_5":30684,"_21010":53418,"_27589":53419,"_2954":53420},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3471":1280,"_30355":1267,"_5":30684,"_21010":53422,"_27589":53423,"_2954":53424},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3471":1281,"_30355":1267,"_5":30684,"_21010":53426,"_27589":53427,"_2954":53428},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3471":1282,"_30355":1267,"_5":30684,"_21010":53430,"_27589":53431,"_2954":53432},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3471":1283,"_30355":1267,"_5":30684,"_21010":53434,"_27589":53435,"_2954":53436},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3471":1284,"_30355":1267,"_5":30684,"_21010":53438,"_27589":53439,"_2954":53440},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3471":1285,"_30355":1267,"_5":30684,"_21010":53442,"_27589":53443,"_2954":53444},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3471":1286,"_30355":1267,"_5":30684,"_21010":53446,"_27589":53447,"_2954":53448},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3471":1287,"_30355":1267,"_5":30684,"_21010":53450,"_27589":53451,"_2954":53452},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3471":1288,"_30355":1267,"_5":30684,"_21010":53454,"_27589":53455,"_2954":53456},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3471":1289,"_30355":1267,"_5":30684,"_21010":53458,"_27589":53459,"_2954":53460},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3471":1290,"_30355":1267,"_5":30684,"_21010":53462,"_27589":53463,"_2954":53464},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3471":1291,"_30355":1267,"_5":30684,"_21010":53466,"_27589":53467,"_2954":53468},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3471":1292,"_30355":1267,"_5":30684,"_21010":53470,"_27589":53471,"_2954":53472},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3471":1293,"_30355":1267,"_5":30684,"_21010":53474,"_27589":53475,"_2954":53476},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3471":1294,"_30355":1267,"_21010":53478,"_5":14420,"_27589":1267,"_2954":53479},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3471":1295,"_30355":1267,"_21010":53481,"_5":14420,"_27589":1267,"_2954":53482},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3471":1296,"_30355":1267,"_21010":53484,"_5":14420,"_27589":1267,"_2954":53485},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3471":1297,"_30355":1267,"_21010":53487,"_5":14420,"_27589":53379,"_2954":53488},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3471":1298,"_30355":1267,"_21010":53490,"_5":14420,"_27589":53379,"_2954":53491},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3471":1299,"_30355":1267,"_21010":53493,"_5":14420,"_27589":53379,"_2954":53494},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3471":1300,"_30355":1267,"_21010":53496,"_5":14420,"_27589":53379,"_2954":53497},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3471":1301,"_30355":1267,"_21010":53499,"_5":14420,"_27589":53383,"_2954":53500},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3471":1302,"_30355":1267,"_21010":53502,"_5":14420,"_27589":53387,"_2954":53503},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3471":1303,"_30355":1267,"_21010":53505,"_5":14420,"_27589":53387,"_2954":53506},[],"IAM action",{"_3471":1304,"_30355":1267,"_21010":53508,"_5":14420,"_27589":53387,"_2954":49811},[],{"_3471":1305,"_30355":1267,"_21010":53510,"_5":14420,"_27589":53387,"_2954":53511},[],"`iot:GetRegistrationCode`",{"_3471":1306,"_30355":1267,"_21010":53513,"_5":14420,"_27589":53387,"_2954":53514},[],"Obtain the verification code for CA registration in the Primary Account",{"_3471":1307,"_30355":1267,"_21010":53516,"_5":14420,"_27589":53387,"_2954":53517},[],"`iot:RegisterCACertificate`",{"_3471":1308,"_30355":1267,"_21010":53519,"_5":14420,"_27589":53387,"_2954":53520},[],"Register the CA in AWS IoT",{"_3471":1309,"_30355":1267,"_21010":53522,"_5":14420,"_27589":53387,"_2954":53523},[],"`iot:DescribeCACertificate`",{"_3471":1310,"_30355":1267,"_21010":53525,"_5":14420,"_27589":53387,"_2954":53526},[],"Check the CA registration status",{"_3471":1311,"_30355":1267,"_21010":53528,"_5":14420,"_27589":53387,"_2954":53529},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3471":1312,"_30355":1267,"_21010":53531,"_5":14420,"_27589":53387,"_2954":53532},[],"Create or update Things in IoT Core",{"_3471":1313,"_30355":1267,"_21010":53534,"_5":14420,"_27589":53387,"_2954":53535},[],"`iot:RegisterThing`",{"_3471":1314,"_30355":1267,"_21010":53537,"_5":14420,"_27589":53387,"_2954":53538},[],"Provision Things through a template",{"_3471":1315,"_30355":1267,"_21010":53540,"_5":14420,"_27589":53387,"_2954":53541},[],"`iot:RegisterCertificate`",{"_3471":1316,"_30355":1267,"_21010":53543,"_5":14420,"_27589":53387,"_2954":53544},[],"Register device certificates",{"_3471":1317,"_30355":1267,"_21010":53546,"_5":14420,"_27589":53387,"_2954":53547},[],"`iot:UpdateCertificate`",{"_3471":1318,"_30355":1267,"_21010":53549,"_5":14420,"_27589":53387,"_2954":53550},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3471":1319,"_30355":1267,"_21010":53552,"_5":14420,"_27589":53387,"_2954":53553},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3471":1320,"_30355":1267,"_21010":53555,"_5":14420,"_27589":53387,"_2954":53556},[],"Create and attach IoT policies",{"_3471":1321,"_30355":1267,"_21010":53558,"_5":14420,"_27589":53387,"_2954":53559},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3471":1322,"_30355":1267,"_21010":53561,"_5":14420,"_27589":53387,"_2954":53562},[],"Manage Thing groups",{"_3471":1323,"_30355":1267,"_21010":53564,"_5":14420,"_27589":53387,"_2954":53565},[],"`iot:CreateProvisioningTemplate`",{"_3471":1324,"_30355":1267,"_21010":53567,"_5":14420,"_27589":53387,"_2954":53568},[],"Create JITP templates",{"_3471":1325,"_30355":1267,"_21010":53570,"_5":14420,"_27589":53387,"_2954":53571},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3471":1326,"_30355":1267,"_21010":53573,"_5":14420,"_27589":53387,"_2954":53574},[],"Read and write the Device Shadow",{"_3471":1327,"_30355":1267,"_21010":53576,"_5":14420,"_27589":53387,"_2954":53577},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3471":1328,"_30355":1267,"_21010":53579,"_5":14420,"_27589":53391,"_2954":53580},[],"Parameter",{"_3471":1329,"_30355":1267,"_21010":53582,"_5":14420,"_27589":53391,"_2954":53583},[],"Type",{"_3471":1330,"_30355":1267,"_21010":53585,"_5":14420,"_27589":53391,"_2954":53586},[],"Required",{"_3471":1331,"_30355":1267,"_21010":53588,"_5":14420,"_27589":53391,"_2954":53589},[],"Description",{"_3471":1332,"_30355":1267,"_21010":53591,"_5":14420,"_27589":53391,"_2954":53592},[],"`connector_id`",{"_3471":1333,"_30355":1267,"_21010":53594,"_5":14420,"_27589":53391,"_2954":25132},[],{"_3471":1334,"_30355":1267,"_21010":53596,"_5":14420,"_27589":53391,"_2954":53597},[],"Yes",{"_3471":1335,"_30355":1267,"_21010":53599,"_5":14420,"_27589":53391,"_2954":53600},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3471":1336,"_30355":1267,"_21010":53602,"_5":14420,"_27589":53391,"_2954":53603},[],"`aws_config.region`",{"_3471":1337,"_30355":1267,"_21010":53605,"_5":14420,"_27589":53391,"_2954":25132},[],{"_3471":1338,"_30355":1267,"_21010":53607,"_5":14420,"_27589":53391,"_2954":53597},[],{"_3471":1339,"_30355":1267,"_21010":53609,"_5":14420,"_27589":53391,"_2954":53610},[],"AWS region where the connector operates.",{"_3471":1340,"_30355":1267,"_21010":53612,"_5":14420,"_27589":53391,"_2954":53613},[],"`aws_config.auth_method`",{"_3471":1341,"_30355":1267,"_21010":53615,"_5":14420,"_27589":53391,"_2954":25132},[],{"_3471":1342,"_30355":1267,"_21010":53617,"_5":14420,"_27589":53391,"_2954":53597},[],{"_3471":1343,"_30355":1267,"_21010":53619,"_5":14420,"_27589":53391,"_2954":53620},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3471":1344,"_30355":1267,"_21010":53622,"_5":14420,"_27589":53391,"_2954":53623},[],"`aws_config.access_key_id`",{"_3471":1345,"_30355":1267,"_21010":53625,"_5":14420,"_27589":53391,"_2954":25132},[],{"_3471":1346,"_30355":1267,"_21010":53627,"_5":14420,"_27589":53391,"_2954":53628},[],"Only with `auth_method=static`",{"_3471":1347,"_30355":1267,"_21010":53630,"_5":14420,"_27589":53391,"_2954":53631},[],"AWS access key.",{"_3471":1348,"_30355":1267,"_21010":53633,"_5":14420,"_27589":53391,"_2954":53634},[],"`aws_config.secret_access_key`",{"_3471":1349,"_30355":1267,"_21010":53636,"_5":14420,"_27589":53391,"_2954":25132},[],{"_3471":1350,"_30355":1267,"_21010":53638,"_5":14420,"_27589":53391,"_2954":53628},[],{"_3471":1351,"_30355":1267,"_21010":53640,"_5":14420,"_27589":53391,"_2954":53641},[],"AWS secret key.",{"_3471":1352,"_30355":1267,"_21010":53643,"_5":14420,"_27589":53391,"_2954":53644},[],"`aws_config.session_token`",{"_3471":1353,"_30355":1267,"_21010":53646,"_5":14420,"_27589":53391,"_2954":25132},[],{"_3471":1354,"_30355":1267,"_21010":53648,"_5":14420,"_27589":53391,"_2954":53649},[],"No",{"_3471":1355,"_30355":1267,"_21010":53651,"_5":14420,"_27589":53391,"_2954":53652},[],"Session token (with `auth_method=static`).",{"_3471":1356,"_30355":1267,"_21010":53654,"_5":14420,"_27589":53391,"_2954":53655},[],"`aws_config.role_arn`",{"_3471":1357,"_30355":1267,"_21010":53657,"_5":14420,"_27589":53391,"_2954":25132},[],{"_3471":1358,"_30355":1267,"_21010":53659,"_5":14420,"_27589":53391,"_2954":53660},[],"Only with `auth_method=role`",{"_3471":1359,"_30355":1267,"_21010":53662,"_5":14420,"_27589":53391,"_2954":53663},[],"ARN of the role to assume.",{"_3471":1360,"_30355":1267,"_21010":53665,"_5":14420,"_27589":53391,"_2954":53666},[],"`aws_config.endpoint_url`",{"_3471":1361,"_30355":1267,"_21010":53668,"_5":14420,"_27589":53391,"_2954":25132},[],{"_3471":1362,"_30355":1267,"_21010":53670,"_5":14420,"_27589":53391,"_2954":53649},[],{"_3471":1363,"_30355":1267,"_21010":53672,"_5":14420,"_27589":53391,"_2954":53673},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3471":1364,"_30355":1267,"_21010":53675,"_5":14420,"_27589":53391,"_2954":53676},[],"`subscriber_event_bus`",{"_3471":1365,"_30355":1267,"_21010":53678,"_5":14420,"_27589":53391,"_2954":17682},[],{"_3471":1366,"_30355":1267,"_21010":53680,"_5":14420,"_27589":53391,"_2954":53597},[],{"_3471":1367,"_30355":1267,"_21010":53682,"_5":14420,"_27589":53391,"_2954":53683},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3471":1368,"_30355":1267,"_21010":53685,"_5":14420,"_27589":53391,"_2954":53686},[],"`dms_manager_client`",{"_3471":1369,"_30355":1267,"_21010":53688,"_5":14420,"_27589":53391,"_2954":25132},[],{"_3471":1370,"_30355":1267,"_21010":53690,"_5":14420,"_27589":53391,"_2954":53597},[],{"_3471":1371,"_30355":1267,"_21010":53692,"_5":14420,"_27589":53391,"_2954":53693},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3471":1372,"_30355":1267,"_21010":53695,"_5":14420,"_27589":53391,"_2954":53696},[],"`device_manager_client`",{"_3471":1373,"_30355":1267,"_21010":53698,"_5":14420,"_27589":53391,"_2954":25132},[],{"_3471":1374,"_30355":1267,"_21010":53700,"_5":14420,"_27589":53391,"_2954":53597},[],{"_3471":1375,"_30355":1267,"_21010":53702,"_5":14420,"_27589":53391,"_2954":53703},[],"HTTP URL of Lamassu's Device Manager.",{"_3471":1376,"_30355":1267,"_21010":53705,"_5":14420,"_27589":53391,"_2954":53706},[],"`ca_client`",{"_3471":1377,"_30355":1267,"_21010":53708,"_5":14420,"_27589":53391,"_2954":25132},[],{"_3471":1378,"_30355":1267,"_21010":53710,"_5":14420,"_27589":53391,"_2954":53597},[],{"_3471":1379,"_30355":1267,"_21010":53712,"_5":14420,"_27589":53391,"_2954":53713},[],"HTTP URL of Lamassu's CA service.",{"_3471":1380,"_30355":1267,"_21010":53715,"_5":14420,"_27589":53395,"_2954":53716},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3471":1381,"_30355":1267,"_21010":53718,"_5":14420,"_27589":53395,"_2954":53719},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3471":1382,"_30355":1267,"_21010":53721,"_5":14420,"_27589":53395,"_2954":53722},[],"CloudEvent type",{"_3471":1383,"_30355":1267,"_21010":53724,"_5":14420,"_27589":53395,"_2954":53725},[],"Lamassu resource",{"_3471":1384,"_30355":1267,"_21010":53727,"_5":14420,"_27589":53395,"_2954":53728},[],"AWS Resource",{"_3471":1385,"_30355":1267,"_21010":53730,"_5":14420,"_27589":53395,"_2954":53731},[],"IAM actions",{"_3471":1386,"_30355":1267,"_21010":53733,"_5":14420,"_27589":53395,"_2954":53734},[],"AWS calls and effect",{"_3471":1387,"_30355":1267,"_21010":53736,"_5":14420,"_27589":53395,"_2954":53737},[],"Where in this page",{"_3471":1388,"_30355":1267,"_21010":53739,"_5":14420,"_27589":53395,"_2954":53740},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3471":1389,"_30355":1267,"_21010":53742,"_5":14420,"_27589":53395,"_2954":53743},[],"CA",{"_3471":1390,"_30355":1267,"_21010":53745,"_5":14420,"_27589":53395,"_2954":53746},[],"`IoTCore/CACertificate`",{"_3471":1391,"_30355":1267,"_21010":53748,"_5":14420,"_27589":53395,"_2954":53749},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3471":1392,"_30355":1267,"_21010":53751,"_5":14420,"_27589":53395,"_2954":53752},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3471":1393,"_30355":1267,"_21010":53754,"_5":14420,"_27589":53395,"_2954":53408},[],{"_3471":1394,"_30355":1267,"_21010":53756,"_5":14420,"_27589":53395,"_2954":53757},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3471":1395,"_30355":1267,"_21010":53759,"_5":14420,"_27589":53395,"_2954":53760},[],"DMS",{"_3471":1396,"_30355":1267,"_21010":53762,"_5":14420,"_27589":53395,"_2954":53763},[],"`IoTCore/ProvisioningTemplate`",{"_3471":1397,"_30355":1267,"_21010":53765,"_5":14420,"_27589":53395,"_2954":53766},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3471":1398,"_30355":1267,"_21010":53768,"_5":14420,"_27589":53395,"_2954":53769},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3471":1399,"_30355":1267,"_21010":53771,"_5":14420,"_27589":53395,"_2954":53436},[],{"_3471":1400,"_30355":1267,"_21010":53773,"_5":14420,"_27589":53395,"_2954":53774},[],"`EventBindDeviceIdentityKey`",{"_3471":1401,"_30355":1267,"_21010":53776,"_5":14420,"_27589":53395,"_2954":53777},[],"Device",{"_3471":1402,"_30355":1267,"_21010":53779,"_5":14420,"_27589":53395,"_2954":53780},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3471":1403,"_30355":1267,"_21010":53782,"_5":14420,"_27589":53395,"_2954":53783},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3471":1404,"_30355":1267,"_21010":53785,"_5":14420,"_27589":53395,"_2954":53786},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3471":1405,"_30355":1267,"_21010":53788,"_5":14420,"_27589":53395,"_2954":53444},[],{"_3471":1406,"_30355":1267,"_21010":53790,"_5":14420,"_27589":53395,"_2954":53791},[],"`EventUpdateCertificateStatusKey`",{"_3471":1407,"_30355":1267,"_21010":53793,"_5":14420,"_27589":53395,"_2954":53794},[],"Certificate",{"_3471":1408,"_30355":1267,"_21010":53796,"_5":14420,"_27589":53395,"_2954":53797},[],"`IoTCore/Certificate`",{"_3471":1409,"_30355":1267,"_21010":53799,"_5":14420,"_27589":53395,"_2954":53800},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3471":1410,"_30355":1267,"_21010":53802,"_5":14420,"_27589":53395,"_2954":53803},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3471":1411,"_30355":1267,"_21010":53805,"_5":14420,"_27589":53395,"_2954":53456},[],{"_3471":1412,"_30355":1267,"_21010":53807,"_5":14420,"_27589":53395,"_2954":53808},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3471":1413,"_30355":1267,"_21010":53810,"_5":14420,"_27589":53395,"_2954":53811},[],"Certificate / Device",{"_3471":1414,"_30355":1267,"_21010":53813,"_5":14420,"_27589":53395,"_2954":53814},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3471":1415,"_30355":1267,"_21010":53816,"_5":14420,"_27589":53395,"_2954":49817},[],{"_3471":1416,"_30355":1267,"_21010":53818,"_5":14420,"_27589":53395,"_2954":53819},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3471":1417,"_30355":1267,"_21010":53821,"_5":14420,"_27589":53395,"_2954":53464},[],{"_3471":1418,"_30355":1267,"_21010":53823,"_5":14420,"_27589":53399,"_2954":53824},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3471":1419,"_30355":1267,"_21010":53826,"_5":14420,"_27589":53403,"_2954":53827},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3471":1420,"_30355":1267,"_21010":53829,"_5":14420,"_27589":53403,"_2954":53830},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3471":1421,"_30355":1267,"_21010":53832,"_5":14420,"_27589":53407,"_2954":53833},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3471":1422,"_30355":1267,"_21010":53835,"_5":14420,"_27589":53407,"_2954":53836},[],"Transition",{"_3471":1423,"_30355":1267,"_21010":53838,"_5":14420,"_27589":53407,"_2954":53839},[],"AWS calls",{"_3471":1424,"_30355":1267,"_21010":53841,"_5":14420,"_27589":53407,"_2954":53842},[],"`NotRegistered` → `Requested`",{"_3471":1425,"_30355":1267,"_21010":53844,"_5":14420,"_27589":53407,"_2954":53845},[],"none (metadata write only)",{"_3471":1426,"_30355":1267,"_21010":53847,"_5":14420,"_27589":53407,"_2954":53848},[],"`Requested` → `Registering`",{"_3471":1427,"_30355":1267,"_21010":53850,"_5":14420,"_27589":53407,"_2954":53851},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3471":1428,"_30355":1267,"_21010":53853,"_5":14420,"_27589":53407,"_2954":53854},[],"`Registering` → `Succeeded`",{"_3471":1429,"_30355":1267,"_21010":53856,"_5":14420,"_27589":53407,"_2954":53857},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3471":1430,"_30355":1267,"_21010":53859,"_5":14420,"_27589":53407,"_2954":53860},[],"`Registering` → `Failed`",{"_3471":1431,"_30355":1267,"_21010":53862,"_5":14420,"_27589":53407,"_2954":53863},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3471":1432,"_30355":1267,"_21010":53865,"_5":14420,"_27589":53407,"_2954":53866},[],"`Failed` / `Succeeded` → `Requested`",{"_3471":1433,"_30355":1267,"_21010":53868,"_5":14420,"_27589":53407,"_2954":53869},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3471":1434,"_30355":1267,"_21010":53871,"_5":14420,"_27589":53411,"_2954":53872},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3471":1435,"_30355":1267,"_21010":53874,"_5":14420,"_27589":53411,"_2954":53875},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3471":1436,"_30355":1267,"_21010":53877,"_5":14420,"_27589":53411,"_2954":53878},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3471":1437,"_30355":1267,"_21010":53880,"_5":14420,"_27589":53411,"_2954":53881},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3471":1438,"_30355":1267,"_21010":53883,"_5":14420,"_27589":53411,"_2954":53884},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3471":1439,"_30355":1267,"_21010":53886,"_5":14420,"_27589":53411,"_2954":53887},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3471":1440,"_30355":1267,"_21010":53889,"_5":14420,"_27589":53415,"_2954":53890},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3471":1441,"_30355":1267,"_21010":53892,"_5":14420,"_27589":53419,"_2954":53893},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3471":1442,"_30355":1267,"_21010":53895,"_5":14420,"_27589":53419,"_2954":53896},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3471":1443,"_30355":1267,"_21010":53898,"_5":14420,"_27589":53423,"_2954":53899},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3471":1444,"_30355":1267,"_21010":53901,"_5":14420,"_27589":53427,"_2954":53902},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3471":1445,"_30355":1267,"_21010":53904,"_5":14420,"_27589":53427,"_2954":53905},[],"Creates or updates the IoT policies configured in the DMS.",{"_3471":1446,"_30355":1267,"_21010":53907,"_5":14420,"_27589":53427,"_2954":53908},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3471":1447,"_30355":1267,"_21010":53910,"_5":14420,"_27589":53427,"_2954":53911},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3471":1448,"_30355":1267,"_21010":53913,"_5":14420,"_27589":53427,"_2954":53914},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3471":1449,"_30355":1267,"_21010":53916,"_5":14420,"_27589":53427,"_2954":53917},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3471":1450,"_30355":1267,"_21010":53919,"_5":14420,"_27589":53427,"_2954":53920},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3471":1451,"_30355":1267,"_21010":53922,"_5":14420,"_27589":53431,"_2954":53923},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3471":1452,"_30355":1267,"_21010":53925,"_5":14420,"_27589":53431,"_2954":53926},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3471":1453,"_30355":1267,"_21010":53928,"_5":14420,"_27589":53431,"_2954":53929},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3471":1454,"_30355":1267,"_21010":53931,"_5":14420,"_27589":53431,"_2954":53932},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3471":1455,"_30355":1267,"_21010":53934,"_5":14420,"_27589":53431,"_2954":53935},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3471":1456,"_30355":1267,"_21010":53937,"_5":14420,"_27589":53435,"_2954":53938},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3471":1457,"_30355":1267,"_21010":53940,"_5":14420,"_27589":53435,"_2954":53836},[],{"_3471":1458,"_30355":1267,"_21010":53942,"_5":14420,"_27589":53435,"_2954":53839},[],{"_3471":1459,"_30355":1267,"_21010":53944,"_5":14420,"_27589":53435,"_2954":53945},[],"`Unconfigured` → `None` / `Auto`",{"_3471":1460,"_30355":1267,"_21010":53947,"_5":14420,"_27589":53435,"_2954":53948},[],"none (configuration only)",{"_3471":1461,"_30355":1267,"_21010":53950,"_5":14420,"_27589":53435,"_2954":53951},[],"`None` ↔ `Auto`",{"_3471":1462,"_30355":1267,"_21010":53953,"_5":14420,"_27589":53435,"_2954":53948},[],{"_3471":1463,"_30355":1267,"_21010":53955,"_5":14420,"_27589":53435,"_2954":53956},[],"Any → `Jitp`",{"_3471":1464,"_30355":1267,"_21010":53958,"_5":14420,"_27589":53435,"_2954":53959},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3471":1465,"_30355":1267,"_21010":53961,"_5":14420,"_27589":53435,"_2954":53962},[],"`Jitp` → `None` / `Auto`",{"_3471":1466,"_30355":1267,"_21010":53964,"_5":14420,"_27589":53435,"_2954":53965},[],"none (the template stays in the AWS account)",{"_3471":1467,"_30355":1267,"_21010":53967,"_5":14420,"_27589":53439,"_2954":53968},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3471":1468,"_30355":1267,"_21010":53970,"_5":14420,"_27589":53439,"_2954":53971},[],"The full flow from the device's perspective is:",{"_3471":1469,"_30355":1267,"_21010":53973,"_5":14420,"_27589":53439,"_2954":53974},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3471":1470,"_30355":1267,"_21010":53976,"_5":14420,"_27589":53443,"_2954":53977},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3471":1471,"_30355":1267,"_21010":53979,"_5":14420,"_27589":53443,"_2954":53836},[],{"_3471":1472,"_30355":1267,"_21010":53981,"_5":14420,"_27589":53443,"_2954":53839},[],{"_3471":1473,"_30355":1267,"_21010":53983,"_5":14420,"_27589":53443,"_2954":53984},[],"`Absent` → `Provisioned`",{"_3471":1474,"_30355":1267,"_21010":53986,"_5":14420,"_27589":53443,"_2954":53987},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3471":1475,"_30355":1267,"_21010":53989,"_5":14420,"_27589":53443,"_2954":53990},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3471":1476,"_30355":1267,"_21010":53992,"_5":14420,"_27589":53443,"_2954":53993},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3471":1477,"_30355":1267,"_21010":53995,"_5":14420,"_27589":53443,"_2954":53996},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3471":1478,"_30355":1267,"_21010":53998,"_5":14420,"_27589":53447,"_2954":53999},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3471":1479,"_30355":1267,"_21010":54001,"_5":14420,"_27589":53447,"_2954":54002},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3471":1480,"_30355":1267,"_21010":54004,"_5":14420,"_27589":53447,"_2954":54005},[],"For the JITP flow to work correctly:",{"_3471":1481,"_30355":1267,"_21010":54007,"_5":14420,"_27589":53447,"_2954":54008},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3471":1482,"_30355":1267,"_21010":54010,"_5":14420,"_27589":53447,"_2954":54011},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3471":1483,"_30355":1267,"_21010":54013,"_5":14420,"_27589":53447,"_2954":54014},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3471":1484,"_30355":1267,"_21010":54016,"_5":14420,"_27589":53447,"_2954":54017},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3471":1485,"_30355":1267,"_21010":54019,"_5":14420,"_27589":53451,"_2954":54020},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3471":1486,"_30355":1267,"_21010":54022,"_5":14420,"_27589":53451,"_2954":54023},[],"Status in Lamassu",{"_3471":1487,"_30355":1267,"_21010":54025,"_5":14420,"_27589":53451,"_2954":54026},[],"Revocation reason",{"_3471":1488,"_30355":1267,"_21010":54028,"_5":14420,"_27589":53451,"_2954":54029},[],"Status in AWS IoT Core",{"_3471":1489,"_30355":1267,"_21010":54031,"_5":14420,"_27589":53451,"_2954":54032},[],"`Active`",{"_3471":1490,"_30355":1267,"_21010":54034,"_5":14420,"_27589":53451,"_2954":54035},[],"None",{"_3471":1491,"_30355":1267,"_21010":54037,"_5":14420,"_27589":53451,"_2954":54038},[],"`ACTIVE`",{"_3471":1492,"_30355":1267,"_21010":54040,"_5":14420,"_27589":53451,"_2954":54041},[],"`Revoked`",{"_3471":1493,"_30355":1267,"_21010":54043,"_5":14420,"_27589":53451,"_2954":54044},[],"`certificateHold`",{"_3471":1494,"_30355":1267,"_21010":54046,"_5":14420,"_27589":53451,"_2954":54047},[],"`INACTIVE`",{"_3471":1495,"_30355":1267,"_21010":54049,"_5":14420,"_27589":53451,"_2954":54041},[],{"_3471":1496,"_30355":1267,"_21010":54051,"_5":14420,"_27589":53451,"_2954":54052},[],"Any other reason",{"_3471":1497,"_30355":1267,"_21010":54054,"_5":14420,"_27589":53451,"_2954":54055},[],"`REVOKED`",{"_3471":1498,"_30355":1267,"_21010":54057,"_5":14420,"_27589":53451,"_2954":54058},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3471":1499,"_30355":1267,"_21010":54060,"_5":14420,"_27589":53455,"_2954":54061},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3471":1500,"_30355":1267,"_21010":54063,"_5":14420,"_27589":53455,"_2954":53836},[],{"_3471":1501,"_30355":1267,"_21010":54065,"_5":14420,"_27589":53455,"_2954":53839},[],{"_3471":1502,"_30355":1267,"_21010":54067,"_5":14420,"_27589":53455,"_2954":54068},[],"`NotSynced` → `Active`",{"_3471":1503,"_30355":1267,"_21010":54070,"_5":14420,"_27589":53455,"_2954":53547},[],{"_3471":1504,"_30355":1267,"_21010":54072,"_5":14420,"_27589":53455,"_2954":54073},[],"`Active` → `Inactive`",{"_3471":1505,"_30355":1267,"_21010":54075,"_5":14420,"_27589":53455,"_2954":54076},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3471":1506,"_30355":1267,"_21010":54078,"_5":14420,"_27589":53455,"_2954":54079},[],"`Active` → `Revoked`",{"_3471":1507,"_30355":1267,"_21010":54081,"_5":14420,"_27589":53455,"_2954":54076},[],{"_3471":1508,"_30355":1267,"_21010":54083,"_5":14420,"_27589":53455,"_2954":54084},[],"`Inactive` / `Revoked` → `Active`",{"_3471":1509,"_30355":1267,"_21010":54086,"_5":14420,"_27589":53455,"_2954":53547},[],{"_3471":1510,"_30355":1267,"_21010":54088,"_5":14420,"_27589":53455,"_2954":54089},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3471":1511,"_30355":1267,"_21010":54091,"_5":14420,"_27589":53455,"_2954":54092},[],"none (these states are not synced to AWS)",{"_3471":1512,"_30355":1267,"_21010":54094,"_5":14420,"_27589":53459,"_2954":54095},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3471":1513,"_30355":1267,"_21010":54097,"_5":14420,"_27589":53459,"_2954":54098},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3471":1514,"_30355":1267,"_21010":54100,"_5":14420,"_27589":53459,"_2954":54101},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3471":1515,"_30355":1267,"_21010":54103,"_5":14420,"_27589":53463,"_2954":54104},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3471":1516,"_30355":1267,"_21010":54106,"_5":14420,"_27589":53463,"_2954":54107},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3471":1517,"_30355":1267,"_21010":54109,"_5":14420,"_27589":53467,"_2954":54110},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3471":1518,"_30355":1267,"_21010":54112,"_5":14420,"_27589":53467,"_2954":54113},[],"There are two action types:",{"_3471":1519,"_30355":1267,"_21010":54115,"_5":14420,"_27589":53467,"_2954":54116},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3471":1520,"_30355":1267,"_21010":54118,"_5":14420,"_27589":53467,"_2954":54119},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3471":1521,"_30355":1267,"_21010":54121,"_5":14420,"_27589":53467,"_2954":54122},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3471":1522,"_30355":1267,"_21010":54124,"_5":14420,"_27589":53471,"_2954":54125},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3471":1523,"_30355":1267,"_21010":54127,"_5":14420,"_27589":53471,"_2954":54128},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3471":1524,"_30355":1267,"_21010":54130,"_5":14420,"_27589":53471,"_2954":54131},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3471":1525,"_30355":1267,"_21010":54133,"_5":14420,"_27589":53475,"_2954":54134},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3471":1526,"_30355":1267,"_21010":54136,"_5":14420,"_27589":53475,"_2954":54137},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3471":1527,"_30355":1267,"_21010":54139,"_5":14420,"_27589":53475,"_2954":54140},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3471":1528,"_30355":1267,"_21010":54142,"_5":14420,"_27589":53475,"_2954":54143},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3471":1529,"_30355":1267,"_21010":54145,"_5":14420,"_27589":53475,"_2954":54146},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3471":1530,"_30355":1267,"_21010":54148,"_5":14420,"_27589":53475,"_2954":54149},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3471":1531,"_30355":1267,"_21010":54151,"_5":14420,"_27589":53475,"_2954":54152},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3471":1532,"_30355":1267,"_21010":54154,"_5":14420,"_27589":53475,"_2954":54155},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3471":1533,"_30355":1267,"_21010":54157,"_5":14420,"_27589":53475,"_2954":54158},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3471":1534,"_30355":1267,"_21010":54160,"_5":14420,"_27589":53475,"_2954":54161},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3471":1535,"_30355":1267,"_21010":54163,"_5":14420,"_27589":53475,"_2954":54164},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3471":1536,"_30355":1267,"_21010":54166,"_5":14420,"_27589":53475,"_2954":54167},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3471":1537,"_30355":1267,"_21010":54169,"_5":14420,"_27589":53475,"_2954":54170},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3471":1538,"_30355":1267,"_21010":54172,"_5":14420,"_27589":53475,"_2954":54173},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3471":1539,"_30355":1267,"_21010":54175,"_5":14420,"_27589":53475,"_2954":54176},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3471":1540,"_30355":1267,"_21010":54178,"_5":14420,"_27589":53475,"_2954":54179},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3471":1541,"_30355":1267,"_21010":54181,"_5":14420,"_27589":53475,"_2954":54182},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3471":1542,"_30355":1267,"_21010":54184,"_5":14420,"_27589":53475,"_2954":54185},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3471":1543,"_30355":1267,"_21010":54187,"_5":14420,"_27589":53475,"_2954":54188},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3471":1544,"_30355":1267,"_21010":54190,"_5":14420,"_27589":53475,"_2954":54191},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3471":1545,"_30355":1267,"_21010":54193,"_5":14420,"_27589":53475,"_2954":54194},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3471":1546,"_30355":1267,"_21010":54196,"_5":14420,"_27589":53475,"_2954":54197},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3471":1547,"_30355":1267,"_21010":54199,"_5":14420,"_27589":53475,"_2954":54200},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3471":1548,"_30355":1267,"_21010":54202,"_5":14420,"_27589":53475,"_2954":54203},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3471":1549,"_30355":1549,"_5":14772,"_2954":51910,"_30687":54205,"_21010":54206,"_27589":1549},[49421,50896,51910],[],{"_3471":1550,"_30355":1549,"_21010":54208,"_5":14420,"_27589":1549,"_2954":54209},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3471":1551,"_30355":1549,"_5":30684,"_21010":54211,"_27589":54212,"_2954":54213},[],"/docs/platform/iot-fleets/overview#start-here","Start here",{"_3471":1552,"_30355":1549,"_5":30684,"_21010":54215,"_27589":54216,"_2954":51908},[],"/docs/platform/iot-fleets/overview#devices-and-identities",{"_3471":1553,"_30355":1549,"_5":30684,"_21010":54218,"_27589":54219,"_2954":52091},[],"/docs/platform/iot-fleets/overview#enrollment-with-pki",{"_3471":1554,"_30355":1549,"_5":30684,"_21010":54221,"_27589":54222,"_2954":53372},[],"/docs/platform/iot-fleets/overview#integrations",{"_3471":1555,"_30355":1549,"_5":30684,"_21010":54224,"_27589":54225,"_2954":54226},[],"/docs/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3471":1556,"_30355":1549,"_21010":54228,"_5":14420,"_27589":1549,"_2954":54229},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3471":1557,"_30355":1549,"_21010":54231,"_5":14420,"_27589":54212,"_2954":54232},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3471":1558,"_30355":1549,"_21010":54234,"_5":14420,"_27589":54212,"_2954":54235},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3471":1559,"_30355":1549,"_21010":54237,"_5":14420,"_27589":54216,"_2954":54238},[],"Resource",{"_3471":1560,"_30355":1549,"_21010":54240,"_5":14420,"_27589":54216,"_2954":54241},[],"What it represents",{"_3471":1561,"_30355":1549,"_21010":54243,"_5":14420,"_27589":54216,"_2954":54244},[],"**Device**",{"_3471":1562,"_30355":1549,"_21010":54246,"_5":14420,"_27589":54216,"_2954":54247},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3471":1563,"_30355":1549,"_21010":54249,"_5":14420,"_27589":54216,"_2954":54250},[],"**Identity**",{"_3471":1564,"_30355":1549,"_21010":54252,"_5":14420,"_27589":54216,"_2954":54253},[],"The device's association with its certificates: an active version and a history.",{"_3471":1565,"_30355":1549,"_21010":54255,"_5":14420,"_27589":54216,"_2954":54256},[],"**DMS**",{"_3471":1566,"_30355":1549,"_21010":54258,"_5":14420,"_27589":54216,"_2954":54259},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3471":1567,"_30355":1549,"_21010":54261,"_5":14420,"_27589":54216,"_2954":54262},[],"**Fleet**",{"_3471":1568,"_30355":1549,"_21010":54264,"_5":14420,"_27589":54216,"_2954":54265},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3471":1569,"_30355":1549,"_21010":54267,"_5":14420,"_27589":54216,"_2954":54268},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3471":1570,"_30355":1549,"_21010":54270,"_5":14420,"_27589":54216,"_2954":54271},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3471":1571,"_30355":1549,"_21010":54273,"_5":14420,"_27589":54219,"_2954":54274},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3471":1572,"_30355":1549,"_21010":54276,"_5":14420,"_27589":54219,"_2954":54277},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3471":1573,"_30355":1549,"_21010":54279,"_5":14420,"_27589":54219,"_2954":54280},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3471":1574,"_30355":1549,"_21010":54282,"_5":14420,"_27589":54219,"_2954":54283},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3471":1575,"_30355":1549,"_21010":54285,"_5":14420,"_27589":54219,"_2954":54286},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3471":1576,"_30355":1549,"_21010":54288,"_5":14420,"_27589":54219,"_2954":54289},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3471":1577,"_30355":1549,"_21010":54291,"_5":14420,"_27589":54219,"_2954":54292},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3471":1578,"_30355":1549,"_21010":54294,"_5":14420,"_27589":54219,"_2954":54295},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3471":1579,"_30355":1549,"_21010":54297,"_5":14420,"_27589":54222,"_2954":54298},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3471":1580,"_30355":1549,"_21010":54300,"_5":14420,"_27589":54222,"_2954":54301},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3471":1581,"_30355":1549,"_21010":54303,"_5":14420,"_27589":54225,"_2954":54304},[],"Participant",{"_3471":1582,"_30355":1549,"_21010":54306,"_5":14420,"_27589":54225,"_2954":54307},[],"Responsibility",{"_3471":1583,"_30355":1549,"_21010":54309,"_5":14420,"_27589":54225,"_2954":54310},[],"PKI administrator",{"_3471":1584,"_30355":1549,"_21010":54312,"_5":14420,"_27589":54225,"_2954":54313},[],"CA, issuance profile, chain and revocation publication.",{"_3471":1585,"_30355":1549,"_21010":54315,"_5":14420,"_27589":54225,"_2954":54316},[],"Provisioning administrator",{"_3471":1586,"_30355":1549,"_21010":54318,"_5":14420,"_27589":54225,"_2954":54319},[],"DMS, admission, authentication per operation and inventory.",{"_3471":1587,"_30355":1549,"_21010":54321,"_5":14420,"_27589":54225,"_2954":54322},[],"Device integrator",{"_3471":1588,"_30355":1549,"_21010":54324,"_5":14420,"_27589":54225,"_2954":54325},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3471":1589,"_30355":1549,"_21010":54327,"_5":14420,"_27589":54225,"_2954":54328},[],"Consumer integrator",{"_3471":1590,"_30355":1549,"_21010":54330,"_5":14420,"_27589":54225,"_2954":54331},[],"Trusted issuers, validation and device permissions in the destination.",{"_3471":1591,"_30355":1549,"_21010":54333,"_5":14420,"_27589":54225,"_2954":54334},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3471":1592,"_30355":1592,"_5":14772,"_2954":54336,"_30687":54337,"_21010":54339,"_27589":1592},"Enroll and connect your first device",[49421,50896,51910,54338],"Getting started",[],{"_3471":1593,"_30355":1592,"_21010":54341,"_5":14420,"_27589":1592,"_2954":54342},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3471":1594,"_30355":1592,"_5":30684,"_21010":54344,"_27589":54345,"_2954":49431},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3471":1595,"_30355":1592,"_5":30684,"_21010":54347,"_27589":54348,"_2954":54349},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3471":1596,"_30355":1592,"_5":30684,"_21010":54351,"_27589":54352,"_2954":54353},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3471":1597,"_30355":1592,"_5":30684,"_21010":54355,"_27589":54356,"_2954":54357},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3471":1598,"_30355":1592,"_5":30684,"_21010":54359,"_27589":54360,"_2954":54361},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3471":1599,"_30355":1592,"_5":30684,"_21010":54363,"_27589":54364,"_2954":54365},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3471":1600,"_30355":1592,"_5":30684,"_21010":54367,"_27589":54368,"_2954":54369},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3471":1601,"_30355":1592,"_5":30684,"_21010":54371,"_27589":54372,"_2954":54373},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3471":1602,"_30355":1592,"_21010":54375,"_5":14420,"_27589":1592,"_2954":54376},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3471":1603,"_30355":1592,"_21010":54378,"_5":14420,"_27589":54345,"_2954":54379},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3471":1604,"_30355":1592,"_21010":54381,"_5":14420,"_27589":54345,"_2954":54382},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3471":1605,"_30355":1592,"_21010":54384,"_5":14420,"_27589":54345,"_2954":54385},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3471":1606,"_30355":1592,"_21010":54387,"_5":14420,"_27589":54345,"_2954":54388},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3471":1607,"_30355":1592,"_21010":54390,"_5":14420,"_27589":54345,"_2954":54391},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3471":1608,"_30355":1592,"_21010":54393,"_5":14420,"_27589":54348,"_2954":54394},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3471":1609,"_30355":1592,"_21010":54396,"_5":14420,"_27589":54348,"_2954":54397},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3471":1610,"_30355":1592,"_21010":54399,"_5":14420,"_27589":54352,"_2954":54400},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3471":1611,"_30355":1592,"_21010":54402,"_5":14420,"_27589":54352,"_2954":54403},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3471":1612,"_30355":1592,"_21010":54405,"_5":14420,"_27589":54352,"_2954":54406},[],"Setting",{"_3471":1613,"_30355":1592,"_21010":54408,"_5":14420,"_27589":54352,"_2954":54409},[],"Evaluation value",{"_3471":1614,"_30355":1592,"_21010":54411,"_5":14420,"_27589":54352,"_2954":54412},[],"Enrollment CA",{"_3471":1615,"_30355":1592,"_21010":54414,"_5":14420,"_27589":54352,"_2954":54415},[],"Issuing root from `device-root.pem`.",{"_3471":1616,"_30355":1592,"_21010":54417,"_5":14420,"_27589":54352,"_2954":52221},[],{"_3471":1617,"_30355":1592,"_21010":54419,"_5":14420,"_27589":54352,"_2954":54420},[],"The 1-hour leaf profile you just prepared.",{"_3471":1618,"_30355":1592,"_21010":54422,"_5":14420,"_27589":54352,"_2954":54423},[],"Protocol / Registration Mode",{"_3471":1619,"_30355":1592,"_21010":54425,"_5":14420,"_27589":54352,"_2954":54426},[],"`EST_RFC7030` / `JITP`.",{"_3471":1620,"_30355":1592,"_21010":54428,"_5":14420,"_27589":54352,"_2954":54429},[],"Verify CSR Signature",{"_3471":1621,"_30355":1592,"_21010":54431,"_5":14420,"_27589":54352,"_2954":54432},[],"Enabled.",{"_3471":1622,"_30355":1592,"_21010":54434,"_5":14420,"_27589":54352,"_2954":54435},[],"Enable Replaceable Enrollment",{"_3471":1623,"_30355":1592,"_21010":54437,"_5":14420,"_27589":54352,"_2954":54438},[],"Disabled; the ID must be new.",{"_3471":1624,"_30355":1592,"_21010":54440,"_5":14420,"_27589":54352,"_2954":54441},[],"Initial authentication",{"_3471":1625,"_30355":1592,"_21010":54443,"_5":14420,"_27589":54352,"_2954":54444},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3471":1626,"_30355":1592,"_21010":54446,"_5":14420,"_27589":54352,"_2954":54447},[],"Renewal authentication",{"_3471":1627,"_30355":1592,"_21010":54449,"_5":14420,"_27589":54352,"_2954":54450},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3471":1628,"_30355":1592,"_21010":54452,"_5":14420,"_27589":54352,"_2954":54453},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3471":1629,"_30355":1592,"_21010":54455,"_5":14420,"_27589":54352,"_2954":54456},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3471":1630,"_30355":1592,"_21010":54458,"_5":14420,"_27589":54352,"_2954":54459},[],"Re-enrollment Delta",{"_3471":1631,"_30355":1592,"_21010":54461,"_5":14420,"_27589":54352,"_2954":54462},[],"1 hour.",{"_3471":1632,"_30355":1592,"_21010":54464,"_5":14420,"_27589":54352,"_2954":54465},[],"Preventive / Critical Delta",{"_3471":1633,"_30355":1592,"_21010":54467,"_5":14420,"_27589":54352,"_2954":54468},[],"30 minutes / 10 minutes.",{"_3471":1634,"_30355":1592,"_21010":54470,"_5":14420,"_27589":54352,"_2954":54471},[],"Revoke on Re-enrollment",{"_3471":1635,"_30355":1592,"_21010":54473,"_5":14420,"_27589":54352,"_2954":54474},[],"Disabled to test the successor before retiring the previous identity.",{"_3471":1636,"_30355":1592,"_21010":54476,"_5":14420,"_27589":54352,"_2954":52229},[],{"_3471":1637,"_30355":1592,"_21010":54478,"_5":14420,"_27589":54352,"_2954":54479},[],"Disabled; the operational key is generated in the client.",{"_3471":1638,"_30355":1592,"_21010":54481,"_5":14420,"_27589":54352,"_2954":54482},[],"CA Distribution",{"_3471":1639,"_30355":1592,"_21010":54484,"_5":14420,"_27589":54352,"_2954":54485},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3471":1640,"_30355":1592,"_21010":54487,"_5":14420,"_27589":54352,"_2954":54488},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3471":1641,"_30355":1592,"_21010":54490,"_5":14420,"_27589":54356,"_2954":54491},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3471":1642,"_30355":1592,"_21010":54493,"_5":14420,"_27589":54356,"_2954":54494},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3471":1643,"_30355":1592,"_21010":54496,"_5":14420,"_27589":54360,"_2954":54497},[],"Generate a new key and CSR with the selected identifier:",{"_3471":1644,"_30355":1592,"_21010":54499,"_5":14420,"_27589":54360,"_2954":54500},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3471":1645,"_30355":1592,"_21010":54502,"_5":14420,"_27589":54360,"_2954":54503},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3471":1646,"_30355":1592,"_21010":54505,"_5":14420,"_27589":54364,"_2954":54506},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3471":1647,"_30355":1592,"_21010":54508,"_5":14420,"_27589":54364,"_2954":54509},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3471":1648,"_30355":1592,"_21010":54511,"_5":14420,"_27589":54368,"_2954":54512},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3471":1649,"_30355":1592,"_21010":54514,"_5":14420,"_27589":54368,"_2954":54515},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3471":1650,"_30355":1592,"_21010":54517,"_5":14420,"_27589":54368,"_2954":54518},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3471":1651,"_30355":1592,"_21010":54520,"_5":14420,"_27589":54368,"_2954":54521},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3471":1652,"_30355":1592,"_21010":54523,"_5":14420,"_27589":54368,"_2954":54524},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3471":1653,"_30355":1592,"_21010":54526,"_5":14420,"_27589":54372,"_2954":54527},[],"Check",{"_3471":1654,"_30355":1592,"_21010":54529,"_5":14420,"_27589":54372,"_2954":54530},[],"Expected result",{"_3471":1655,"_30355":1592,"_21010":54532,"_5":14420,"_27589":54372,"_2954":54533},[],"Registration",{"_3471":1656,"_30355":1592,"_21010":54535,"_5":14420,"_27589":54372,"_2954":54536},[],"ID created automatically and correct DMS.",{"_3471":1657,"_30355":1592,"_21010":54538,"_5":14420,"_27589":54372,"_2954":53794},[],{"_3471":1658,"_30355":1592,"_21010":54540,"_5":14420,"_27589":54372,"_2954":54541},[],"CN, profile, serial and key verified.",{"_3471":1659,"_30355":1592,"_21010":54543,"_5":14420,"_27589":54372,"_2954":54544},[],"Inventory",{"_3471":1660,"_30355":1592,"_21010":54546,"_5":14420,"_27589":54372,"_2954":54547},[],"Received serial visible as the current identity and in history.",{"_3471":1661,"_30355":1592,"_21010":54549,"_5":14420,"_27589":54372,"_2954":54550},[],"Consumer",{"_3471":1662,"_30355":1592,"_21010":54552,"_5":14420,"_27589":54372,"_2954":54553},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3471":1663,"_30355":1592,"_21010":54555,"_5":14420,"_27589":54372,"_2954":54556},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3471":1664,"_30355":1592,"_21010":54558,"_5":14420,"_27589":54372,"_2954":54559},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3471":1665,"_30355":1665,"_5":14772,"_2954":51926,"_30687":54561,"_21010":54562,"_27589":1665},[49421,50896,51910,54338],[],{"_3471":1666,"_30355":1665,"_21010":54564,"_5":14420,"_27589":1665,"_2954":54565},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3471":1667,"_30355":1665,"_5":30684,"_21010":54567,"_27589":54568,"_2954":49431},[],"/docs/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3471":1668,"_30355":1665,"_5":30684,"_21010":54570,"_27589":54571,"_2954":54572},[],"/docs/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3471":1669,"_30355":1665,"_5":30684,"_21010":54574,"_27589":54575,"_2954":54576},[],"/docs/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3471":1670,"_30355":1665,"_5":30684,"_21010":54578,"_27589":54579,"_2954":54580},[],"/docs/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3471":1671,"_30355":1665,"_5":30684,"_21010":54582,"_27589":54583,"_2954":54584},[],"/docs/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3471":1672,"_30355":1665,"_5":30684,"_21010":54586,"_27589":54587,"_2954":54588},[],"/docs/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3471":1673,"_30355":1665,"_5":30684,"_21010":54590,"_27589":54591,"_2954":54530},[],"/docs/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3471":1674,"_30355":1665,"_5":30684,"_21010":54593,"_27589":54594,"_2954":54595},[],"/docs/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3471":1675,"_30355":1665,"_5":30684,"_21010":54597,"_27589":54598,"_2954":54599},[],"/docs/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3471":1676,"_30355":1665,"_21010":54601,"_5":14420,"_27589":1665,"_2954":54602},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3471":1677,"_30355":1665,"_21010":54604,"_5":14420,"_27589":1665,"_2954":54605},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3471":1678,"_30355":1665,"_21010":54607,"_5":14420,"_27589":54568,"_2954":54608},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3471":1679,"_30355":1665,"_21010":54610,"_5":14420,"_27589":54568,"_2954":54611},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3471":1680,"_30355":1665,"_21010":54613,"_5":14420,"_27589":54568,"_2954":54614},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3471":1681,"_30355":1665,"_21010":54616,"_5":14420,"_27589":54568,"_2954":54617},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3471":1682,"_30355":1665,"_21010":54619,"_5":14420,"_27589":54571,"_2954":54620},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3471":1683,"_30355":1665,"_21010":54622,"_5":14420,"_27589":54571,"_2954":54623},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3471":1684,"_30355":1665,"_21010":54625,"_5":14420,"_27589":54571,"_2954":54626},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3471":1685,"_30355":1665,"_21010":54628,"_5":14420,"_27589":54571,"_2954":54629},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3471":1686,"_30355":1665,"_21010":54631,"_5":14420,"_27589":54571,"_2954":54632},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3471":1687,"_30355":1665,"_21010":54634,"_5":14420,"_27589":54571,"_2954":54635},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3471":1688,"_30355":1665,"_21010":54637,"_5":14420,"_27589":54571,"_2954":54638},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3471":1689,"_30355":1665,"_21010":54640,"_5":14420,"_27589":54571,"_2954":54641},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3471":1690,"_30355":1665,"_21010":54643,"_5":14420,"_27589":54575,"_2954":54644},[],"Open **Managed Devices** and the registration action. Complete:",{"_3471":1691,"_30355":1665,"_21010":54646,"_5":14420,"_27589":54575,"_2954":54647},[],"**Device ID**: `device-001`.",{"_3471":1692,"_30355":1665,"_21010":54649,"_5":14420,"_27589":54575,"_2954":54650},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3471":1693,"_30355":1665,"_21010":54652,"_5":14420,"_27589":54575,"_2954":54653},[],"**Icon** and **Tags**: optional classification.",{"_3471":1694,"_30355":1665,"_21010":54655,"_5":14420,"_27589":54575,"_2954":54656},[],"Confirm registration.",{"_3471":1695,"_30355":1665,"_21010":54658,"_5":14420,"_27589":54579,"_2954":54659},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3471":1696,"_30355":1665,"_21010":54661,"_5":14420,"_27589":54579,"_2954":54662},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3471":1697,"_30355":1665,"_21010":54664,"_5":14420,"_27589":54583,"_2954":54665},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3471":1698,"_30355":1665,"_21010":54667,"_5":14420,"_27589":54583,"_2954":54668},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3471":1699,"_30355":1665,"_21010":54670,"_5":14420,"_27589":54587,"_2954":54671},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3471":1700,"_30355":1665,"_21010":54673,"_5":14420,"_27589":54587,"_2954":54674},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3471":1701,"_30355":1665,"_21010":54676,"_5":14420,"_27589":54591,"_2954":54527},[],{"_3471":1702,"_30355":1665,"_21010":54678,"_5":14420,"_27589":54591,"_2954":54679},[],"Result",{"_3471":1703,"_30355":1665,"_21010":54681,"_5":14420,"_27589":54591,"_2954":53777},[],{"_3471":1704,"_30355":1665,"_21010":54683,"_5":14420,"_27589":54591,"_2954":54684},[],"`device-001` appears in inventory with the expected DMS.",{"_3471":1705,"_30355":1665,"_21010":54686,"_5":14420,"_27589":54591,"_2954":54687},[],"Current identity",{"_3471":1706,"_30355":1665,"_21010":54689,"_5":14420,"_27589":54591,"_2954":54690},[],"The associated certificate matches the one you verified in PKI.",{"_3471":1707,"_30355":1665,"_21010":54692,"_5":14420,"_27589":54591,"_2954":54693},[],"History",{"_3471":1708,"_30355":1665,"_21010":54695,"_5":14420,"_27589":54591,"_2954":54696},[],"The associated issuance appears with its serial number and dates.",{"_3471":1709,"_30355":1665,"_21010":54698,"_5":14420,"_27589":54591,"_2954":54699},[],"Key and certificate",{"_3471":1710,"_30355":1665,"_21010":54701,"_5":14420,"_27589":54591,"_2954":54702},[],"You have the verified pair ready to install on the device.",{"_3471":1711,"_30355":1665,"_21010":54704,"_5":14420,"_27589":54594,"_2954":54705},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3471":1712,"_30355":1665,"_21010":54707,"_5":14420,"_27589":54594,"_2954":54708},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3471":1713,"_30355":1665,"_21010":54710,"_5":14420,"_27589":54594,"_2954":54711},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3471":1714,"_30355":1665,"_21010":54713,"_5":14420,"_27589":54594,"_2954":54714},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3471":1715,"_30355":1665,"_21010":54716,"_5":14420,"_27589":54598,"_2954":54717},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3471":1716,"_30355":1665,"_21010":54719,"_5":14420,"_27589":54598,"_2954":54720},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3471":1717,"_30355":1665,"_21010":54722,"_5":14420,"_27589":54598,"_2954":54723},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3471":1718,"_30355":1718,"_5":14772,"_2954":54725,"_30687":54726,"_21010":54727,"_27589":1718},"Lamassu IoT Platform",[49421,50896],[],{"_3471":1719,"_30355":1718,"_21010":54729,"_5":14420,"_27589":1718,"_2954":54730},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3471":1720,"_30355":1718,"_5":30684,"_21010":54732,"_27589":54733,"_2954":54213},[],"/docs/platform/overview#start-here",{"_3471":1721,"_30355":1718,"_5":30684,"_21010":54735,"_27589":54736,"_2954":54737},[],"/docs/platform/overview#choose-your-path","Choose your path",{"_3471":1722,"_30355":1718,"_5":30684,"_21010":54739,"_27589":54740,"_2954":54741},[],"/docs/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3471":1723,"_30355":1718,"_5":30684,"_21010":54743,"_27589":54744,"_2954":54745},[],"/docs/platform/overview#core-capabilities","Core capabilities",{"_3471":1724,"_30355":1718,"_5":30684,"_21010":54747,"_27589":54748,"_2954":54749},[],"/docs/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3471":1725,"_30355":1718,"_5":30684,"_21010":54751,"_27589":54752,"_2954":54753},[],"/docs/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3471":1726,"_30355":1718,"_5":30684,"_21010":54755,"_27589":54756,"_2954":54757},[],"/docs/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3471":1727,"_30355":1718,"_5":30684,"_21010":54759,"_27589":54760,"_2954":54761},[],"/docs/platform/overview#automate-device-identities","Automate device identities",{"_3471":1728,"_30355":1718,"_5":30684,"_21010":54763,"_27589":54764,"_2954":54765},[],"/docs/platform/overview#publish-validation-status","Publish validation status",{"_3471":1729,"_30355":1718,"_5":30684,"_21010":54767,"_27589":54768,"_2954":54769},[],"/docs/platform/overview#react-to-events","React to events",{"_3471":1730,"_30355":1718,"_5":30684,"_21010":54771,"_27589":54772,"_2954":54773},[],"/docs/platform/overview#operational-reference","Operational reference",{"_3471":1731,"_30355":1718,"_21010":54775,"_5":14420,"_27589":1718,"_2954":54776},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3471":1732,"_30355":1718,"_21010":54778,"_5":14420,"_27589":54733,"_2954":54779},[],"Choose the result you need:",{"_3471":1733,"_30355":1718,"_21010":54781,"_5":14420,"_27589":54733,"_2954":54782},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3471":1734,"_30355":1718,"_21010":54784,"_5":14420,"_27589":54733,"_2954":54785},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3471":1735,"_30355":1718,"_21010":54787,"_5":14420,"_27589":54733,"_2954":54788},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3471":1736,"_30355":1718,"_21010":54790,"_5":14420,"_27589":54736,"_2954":54791},[],"Section",{"_3471":1737,"_30355":1718,"_21010":54793,"_5":14420,"_27589":54736,"_2954":54794},[],"What you manage",{"_3471":1738,"_30355":1718,"_21010":54796,"_5":14420,"_27589":54736,"_2954":54797},[],"Entry point",{"_3471":1739,"_30355":1718,"_21010":54799,"_5":14420,"_27589":54736,"_2954":54800},[],"**PKI**",{"_3471":1740,"_30355":1718,"_21010":54802,"_5":14420,"_27589":54736,"_2954":54803},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3471":1741,"_30355":1718,"_21010":54805,"_5":14420,"_27589":54736,"_2954":54806},[],"PKI overview",{"_3471":1742,"_30355":1718,"_21010":54808,"_5":14420,"_27589":54736,"_2954":54809},[],"**IoT Fleets**",{"_3471":1743,"_30355":1718,"_21010":54811,"_5":14420,"_27589":54736,"_2954":54812},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3471":1744,"_30355":1718,"_21010":54814,"_5":14420,"_27589":54736,"_2954":54815},[],"IoT Fleets overview",{"_3471":1745,"_30355":1718,"_21010":54817,"_5":14420,"_27589":54736,"_2954":54818},[],"**Administration**",{"_3471":1746,"_30355":1718,"_21010":54820,"_5":14420,"_27589":54736,"_2954":54821},[],"Operator permissions, audit and event subscriptions.",{"_3471":1747,"_30355":1718,"_21010":54823,"_5":14420,"_27589":54736,"_2954":50894},[],{"_3471":1748,"_30355":1718,"_21010":54825,"_5":14420,"_27589":54736,"_2954":54826},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3471":1749,"_30355":1718,"_21010":54828,"_5":14420,"_27589":54740,"_2954":54829},[],"An identity's journey connects four responsibilities:",{"_3471":1750,"_30355":1718,"_21010":54831,"_5":14420,"_27589":54740,"_2954":54832},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3471":1751,"_30355":1718,"_21010":54834,"_5":14420,"_27589":54740,"_2954":54835},[],"The provisioning administrator configures the DMS and initial trust.",{"_3471":1752,"_30355":1718,"_21010":54837,"_5":14420,"_27589":54740,"_2954":54838},[],"The device client requests a certificate and installs it with the matching key.",{"_3471":1753,"_30355":1718,"_21010":54840,"_5":14420,"_27589":54740,"_2954":54841},[],"The consumer validates the identity and applies its access permissions.",{"_3471":1754,"_30355":1718,"_21010":54843,"_5":14420,"_27589":54740,"_2954":54844},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3471":1755,"_30355":1718,"_21010":54846,"_5":14420,"_27589":54748,"_2954":54847},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3471":1756,"_30355":1718,"_21010":54849,"_5":14420,"_27589":54752,"_2954":54850},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3471":1757,"_30355":1718,"_21010":54852,"_5":14420,"_27589":54756,"_2954":54853},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3471":1758,"_30355":1718,"_21010":54855,"_5":14420,"_27589":54760,"_2954":54856},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3471":1759,"_30355":1718,"_21010":54858,"_5":14420,"_27589":54764,"_2954":54859},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3471":1760,"_30355":1718,"_21010":54861,"_5":14420,"_27589":54768,"_2954":54862},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3471":1761,"_30355":1718,"_21010":54864,"_5":14420,"_27589":54772,"_2954":54307},[],{"_3471":1762,"_30355":1718,"_21010":54866,"_5":14420,"_27589":54772,"_2954":54867},[],"What it prepares or checks",{"_3471":1763,"_30355":1718,"_21010":54869,"_5":14420,"_27589":54772,"_2954":54310},[],{"_3471":1764,"_30355":1718,"_21010":54871,"_5":14420,"_27589":54772,"_2954":54872},[],"Key custody, CA hierarchy, profiles and validation.",{"_3471":1765,"_30355":1718,"_21010":54874,"_5":14420,"_27589":54772,"_2954":54875},[],"Fleet administrator",{"_3471":1766,"_30355":1718,"_21010":54877,"_5":14420,"_27589":54772,"_2954":54878},[],"DMS, device admission, renewal policy and inventory.",{"_3471":1767,"_30355":1718,"_21010":54880,"_5":14420,"_27589":54772,"_2954":54322},[],{"_3471":1768,"_30355":1718,"_21010":54882,"_5":14420,"_27589":54772,"_2954":54883},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3471":1769,"_30355":1718,"_21010":54885,"_5":14420,"_27589":54772,"_2954":54328},[],{"_3471":1770,"_30355":1718,"_21010":54887,"_5":14420,"_27589":54772,"_2954":54888},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3471":1771,"_30355":1718,"_21010":54890,"_5":14420,"_27589":54772,"_2954":54891},[],"Infrastructure operator",{"_3471":1772,"_30355":1718,"_21010":54893,"_5":14420,"_27589":54772,"_2954":54894},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3471":1773,"_30355":1718,"_21010":54896,"_5":14420,"_27589":54772,"_2954":54897},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3471":1774,"_30355":1774,"_5":14772,"_2954":54899,"_30687":54900,"_21010":54903,"_27589":1774},"CA hierarchy and rotation",[49421,50896,54901,54902],"PKI","Keys, authorities and certificates",[],{"_3471":1775,"_30355":1774,"_21010":54905,"_5":14420,"_27589":1774,"_2954":54906},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3471":1776,"_30355":1774,"_5":30684,"_21010":54908,"_27589":54909,"_2954":54910},[],"/docs/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3471":1777,"_30355":1774,"_5":30684,"_21010":54912,"_27589":54913,"_2954":54914},[],"/docs/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3471":1778,"_30355":1774,"_5":30684,"_21010":54916,"_27589":54917,"_2954":54918},[],"/docs/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3471":1779,"_30355":1774,"_5":30684,"_21010":54920,"_27589":54921,"_2954":54922},[],"/docs/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3471":1780,"_30355":1774,"_5":30684,"_21010":54924,"_27589":54925,"_2954":54926},[],"/docs/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3471":1781,"_30355":1774,"_5":30684,"_21010":54928,"_27589":54929,"_2954":54930},[],"/docs/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3471":1782,"_30355":1774,"_5":30684,"_21010":54932,"_27589":54933,"_2954":54934},[],"/docs/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3471":1783,"_30355":1774,"_5":30684,"_21010":54936,"_27589":54937,"_2954":54938},[],"/docs/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3471":1784,"_30355":1774,"_5":30684,"_21010":54940,"_27589":54941,"_2954":54942},[],"/docs/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3471":1785,"_30355":1774,"_5":30684,"_21010":54944,"_27589":54945,"_2954":54946},[],"/docs/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3471":1786,"_30355":1774,"_5":30684,"_21010":54948,"_27589":54949,"_2954":54950},[],"/docs/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3471":1787,"_30355":1774,"_5":30684,"_21010":54952,"_27589":54953,"_2954":54954},[],"/docs/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3471":1788,"_30355":1774,"_21010":54956,"_5":14420,"_27589":1774,"_2954":54957},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3471":1789,"_30355":1774,"_21010":54959,"_5":14420,"_27589":1774,"_2954":54960},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3471":1790,"_30355":1774,"_21010":54962,"_5":14420,"_27589":54909,"_2954":54963},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3471":1791,"_30355":1774,"_21010":54965,"_5":14420,"_27589":54909,"_2954":54966},[],"environment, such as production and preproduction;",{"_3471":1792,"_30355":1774,"_21010":54968,"_5":14420,"_27589":54909,"_2954":54969},[],"owner or operating team;",{"_3471":1793,"_30355":1774,"_21010":54971,"_5":14420,"_27589":54909,"_2954":54972},[],"device family or manufacturing process;",{"_3471":1794,"_30355":1774,"_21010":54974,"_5":14420,"_27589":54909,"_2954":54975},[],"region or regulatory requirement;",{"_3471":1795,"_30355":1774,"_21010":54977,"_5":14420,"_27589":54909,"_2954":54978},[],"cryptographic engine or key policy;",{"_3471":1796,"_30355":1774,"_21010":54980,"_5":14420,"_27589":54909,"_2954":54981},[],"maintenance window and renewal cadence.",{"_3471":1797,"_30355":1774,"_21010":54983,"_5":14420,"_27589":54909,"_2954":54984},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3471":1798,"_30355":1774,"_21010":54986,"_5":14420,"_27589":54909,"_2954":54987},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3471":1799,"_30355":1774,"_21010":54989,"_5":14420,"_27589":54913,"_2954":54990},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3471":1800,"_30355":1774,"_21010":54992,"_5":14420,"_27589":54913,"_2954":54993},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing; see the CRL guide.",{"_3471":1801,"_30355":1774,"_21010":54995,"_5":14420,"_27589":54913,"_2954":54996},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3471":1802,"_30355":1774,"_21010":54998,"_5":14420,"_27589":54913,"_2954":54999},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3471":1803,"_30355":1774,"_21010":55001,"_5":14420,"_27589":54917,"_2954":55002},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3471":1804,"_30355":1774,"_21010":55004,"_5":14420,"_27589":54917,"_2954":55005},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3471":1805,"_30355":1774,"_21010":55007,"_5":14420,"_27589":54917,"_2954":55008},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3471":1806,"_30355":1774,"_21010":55010,"_5":14420,"_27589":54917,"_2954":55011},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3471":1807,"_30355":1774,"_21010":55013,"_5":14420,"_27589":54925,"_2954":55014},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3471":1808,"_30355":1774,"_21010":55016,"_5":14420,"_27589":54929,"_2954":55017},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3471":1809,"_30355":1774,"_21010":55019,"_5":14420,"_27589":54933,"_2954":55020},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3471":1810,"_30355":1774,"_21010":55022,"_5":14420,"_27589":54937,"_2954":55023},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3471":1811,"_30355":1774,"_21010":55025,"_5":14420,"_27589":54941,"_2954":55026},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3471":1812,"_30355":1774,"_21010":55028,"_5":14420,"_27589":54945,"_2954":55029},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3471":1813,"_30355":1774,"_21010":55031,"_5":14420,"_27589":54949,"_2954":55032},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3471":1814,"_30355":1774,"_21010":55034,"_5":14420,"_27589":54949,"_2954":55035},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3471":1815,"_30355":1774,"_21010":55037,"_5":14420,"_27589":54949,"_2954":55038},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3471":1816,"_30355":1774,"_21010":55040,"_5":14420,"_27589":54949,"_2954":55041},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3471":1817,"_30355":1774,"_21010":55043,"_5":14420,"_27589":54953,"_2954":55044},[],"The new chain ends in an anchor installed by the consumer.",{"_3471":1818,"_30355":1774,"_21010":55046,"_5":14420,"_27589":54953,"_2954":55047},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3471":1819,"_30355":1774,"_21010":55049,"_5":14420,"_27589":54953,"_2954":55050},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3471":1820,"_30355":1774,"_21010":55052,"_5":14420,"_27589":54953,"_2954":55053},[],"Re-enrollment accepts the old identity during the planned period.",{"_3471":1821,"_30355":1774,"_21010":55055,"_5":14420,"_27589":54953,"_2954":55056},[],"OCSP and CRL respond for the authorities that remain active.",{"_3471":1822,"_30355":1774,"_21010":55058,"_5":14420,"_27589":54953,"_2954":55059},[],"No DMS is left accidentally issuing from the old CA.",{"_3471":1823,"_30355":1774,"_21010":55061,"_5":14420,"_27589":54953,"_2954":55062},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3471":1824,"_30355":1824,"_5":14772,"_2954":55064,"_30687":55065,"_21010":55066,"_27589":1824},"Certification authorities",[49421,50896,54901,54902],[],{"_3471":1825,"_30355":1824,"_21010":55068,"_5":14420,"_27589":1824,"_2954":55069},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3471":1826,"_30355":1824,"_5":30684,"_21010":55071,"_27589":55072,"_2954":55073},[],"/docs/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3471":1827,"_30355":1824,"_5":30684,"_21010":55075,"_27589":55076,"_2954":55077},[],"/docs/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3471":1828,"_30355":1824,"_5":30684,"_21010":55079,"_27589":55080,"_2954":49431},[],"/docs/platform/pki/certificate-authorities#before-you-begin",{"_3471":1829,"_30355":1824,"_5":30684,"_21010":55082,"_27589":55083,"_2954":55084},[],"/docs/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3471":1830,"_30355":1824,"_5":30684,"_21010":55086,"_27589":55087,"_2954":55088},[],"/docs/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3471":1831,"_30355":1824,"_5":30684,"_21010":55090,"_27589":55091,"_2954":55092},[],"/docs/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3471":1832,"_30355":1824,"_5":30684,"_21010":55094,"_27589":55095,"_2954":55096},[],"/docs/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3471":1833,"_30355":1824,"_5":30684,"_21010":55098,"_27589":55099,"_2954":55100},[],"/docs/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3471":1834,"_30355":1824,"_5":30684,"_21010":55102,"_27589":55103,"_2954":55104},[],"/docs/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3471":1835,"_30355":1824,"_5":30684,"_21010":55106,"_27589":55107,"_2954":55108},[],"/docs/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3471":1836,"_30355":1824,"_5":30684,"_21010":55110,"_27589":55111,"_2954":55112},[],"/docs/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3471":1837,"_30355":1824,"_5":30684,"_21010":55114,"_27589":55115,"_2954":55116},[],"/docs/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3471":1838,"_30355":1824,"_5":30684,"_21010":55118,"_27589":55119,"_2954":55120},[],"/docs/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3471":1839,"_30355":1824,"_5":30684,"_21010":55122,"_27589":55123,"_2954":55124},[],"/docs/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3471":1840,"_30355":1824,"_5":30684,"_21010":55126,"_27589":55127,"_2954":55128},[],"/docs/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3471":1841,"_30355":1824,"_5":30684,"_21010":55130,"_27589":55131,"_2954":55132},[],"/docs/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3471":1842,"_30355":1824,"_5":30684,"_21010":55134,"_27589":55135,"_2954":55136},[],"/docs/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3471":1843,"_30355":1824,"_5":30684,"_21010":55138,"_27589":55139,"_2954":55140},[],"/docs/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3471":1844,"_30355":1824,"_5":30684,"_21010":55142,"_27589":55143,"_2954":55144},[],"/docs/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3471":1845,"_30355":1824,"_5":30684,"_21010":55146,"_27589":55147,"_2954":55148},[],"/docs/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3471":1846,"_30355":1824,"_5":30684,"_21010":55150,"_27589":55151,"_2954":55152},[],"/docs/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3471":1847,"_30355":1824,"_5":30684,"_21010":55154,"_27589":55155,"_2954":55156},[],"/docs/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3471":1848,"_30355":1824,"_5":30684,"_21010":55158,"_27589":55159,"_2954":55160},[],"/docs/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3471":1849,"_30355":1824,"_21010":55162,"_5":14420,"_27589":1824,"_2954":55163},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3471":1850,"_30355":1824,"_21010":55165,"_5":14420,"_27589":1824,"_2954":55166},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3471":1851,"_30355":1824,"_21010":55168,"_5":14420,"_27589":1824,"_2954":55169},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3471":1852,"_30355":1824,"_21010":55171,"_5":14420,"_27589":55072,"_2954":55172},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3471":1853,"_30355":1824,"_21010":55174,"_5":14420,"_27589":55072,"_2954":55175},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3471":1854,"_30355":1824,"_21010":55177,"_5":14420,"_27589":55072,"_2954":55178},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3471":1855,"_30355":1824,"_21010":55180,"_5":14420,"_27589":55072,"_2954":55181},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3471":1856,"_30355":1824,"_21010":55183,"_5":14420,"_27589":55072,"_2954":55184},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3471":1857,"_30355":1824,"_21010":55186,"_5":14420,"_27589":55080,"_2954":55187},[],"Decide whether the CA will be a root or an intermediate.",{"_3471":1858,"_30355":1824,"_21010":55189,"_5":14420,"_27589":55080,"_2954":55190},[],"Choose the engine that will keep the key.",{"_3471":1859,"_30355":1824,"_21010":55192,"_5":14420,"_27589":55080,"_2954":55193},[],"Define a validity longer than that of the certificates it will issue.",{"_3471":1860,"_30355":1824,"_21010":55195,"_5":14420,"_27589":55080,"_2954":55196},[],"For an intermediate CA, make sure the parent CA is active.",{"_3471":1861,"_30355":1824,"_21010":55198,"_5":14420,"_27589":55083,"_2954":55199},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3471":1862,"_30355":1824,"_21010":55201,"_5":14420,"_27589":55087,"_2954":55202},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3471":1863,"_30355":1824,"_21010":55204,"_5":14420,"_27589":55087,"_2954":55205},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3471":1864,"_30355":1824,"_21010":55207,"_5":14420,"_27589":55091,"_2954":55208},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3471":1865,"_30355":1824,"_21010":55210,"_5":14420,"_27589":55095,"_2954":55211},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3471":1866,"_30355":1824,"_21010":55213,"_5":14420,"_27589":55095,"_2954":55214},[],"`C`: two-letter ISO 3166-1 country code.",{"_3471":1867,"_30355":1824,"_21010":55216,"_5":14420,"_27589":55095,"_2954":55217},[],"`ST`: state or province.",{"_3471":1868,"_30355":1824,"_21010":55219,"_5":14420,"_27589":55095,"_2954":55220},[],"`L`: locality.",{"_3471":1869,"_30355":1824,"_21010":55222,"_5":14420,"_27589":55095,"_2954":55223},[],"`O`: organization.",{"_3471":1870,"_30355":1824,"_21010":55225,"_5":14420,"_27589":55095,"_2954":55226},[],"`OU`: organizational unit.",{"_3471":1871,"_30355":1824,"_21010":55228,"_5":14420,"_27589":55095,"_2954":55229},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3471":1872,"_30355":1824,"_21010":55231,"_5":14420,"_27589":55099,"_2954":55232},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3471":1873,"_30355":1824,"_21010":55234,"_5":14420,"_27589":55099,"_2954":55235},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3471":1874,"_30355":1824,"_21010":55237,"_5":14420,"_27589":55103,"_2954":55238},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3471":1875,"_30355":1824,"_21010":55240,"_5":14420,"_27589":55103,"_2954":55241},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3471":1876,"_30355":1824,"_21010":55243,"_5":14420,"_27589":55107,"_2954":55244},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3471":1877,"_30355":1824,"_21010":55246,"_5":14420,"_27589":55107,"_2954":55247},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3471":1878,"_30355":1824,"_21010":55249,"_5":14420,"_27589":55111,"_2954":55250},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3471":1879,"_30355":1824,"_21010":55252,"_5":14420,"_27589":55111,"_2954":55253},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3471":1880,"_30355":1824,"_21010":55255,"_5":14420,"_27589":55111,"_2954":55256},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3471":1881,"_30355":1824,"_21010":55258,"_5":14420,"_27589":55115,"_2954":55259},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3471":1882,"_30355":1824,"_21010":55261,"_5":14420,"_27589":55119,"_2954":55262},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3471":1883,"_30355":1824,"_21010":55264,"_5":14420,"_27589":55119,"_2954":55265},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3471":1884,"_30355":1824,"_21010":55267,"_5":14420,"_27589":55123,"_2954":55268},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3471":1885,"_30355":1824,"_21010":55270,"_5":14420,"_27589":55127,"_2954":55271},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3471":1886,"_30355":1824,"_21010":55273,"_5":14420,"_27589":55127,"_2954":55274},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3471":1887,"_30355":1824,"_21010":55276,"_5":14420,"_27589":55131,"_2954":55277},[],"Open a CA from the inventory to review:",{"_3471":1888,"_30355":1824,"_21010":55279,"_5":14420,"_27589":55131,"_2954":55280},[],"Status and validity period.",{"_3471":1889,"_30355":1824,"_21010":55282,"_5":14420,"_27589":55131,"_2954":55283},[],"Certificate and chain in PEM format.",{"_3471":1890,"_30355":1824,"_21010":55285,"_5":14420,"_27589":55131,"_2954":55286},[],"Number of active, expired and revoked certificates.",{"_3471":1891,"_30355":1824,"_21010":55288,"_5":14420,"_27589":55131,"_2954":55289},[],"Certificates issued in **Issued Certificates**.",{"_3471":1892,"_30355":1824,"_21010":55291,"_5":14420,"_27589":55131,"_2954":55292},[],"The CRL linked to the authority.",{"_3471":1893,"_30355":1824,"_21010":55294,"_5":14420,"_27589":55131,"_2954":55295},[],"Metadata and the associated cryptographic engine.",{"_3471":1894,"_30355":1824,"_21010":55297,"_5":14420,"_27589":55131,"_2954":55298},[],"You can filter the inventory by name, status and CA type.",{"_3471":1895,"_30355":1824,"_21010":55300,"_5":14420,"_27589":55135,"_2954":55301},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3471":1896,"_30355":1824,"_21010":55303,"_5":14420,"_27589":55135,"_2954":55304},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3471":1897,"_30355":1824,"_21010":55306,"_5":14420,"_27589":55135,"_2954":55307},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3471":1898,"_30355":1824,"_21010":55309,"_5":14420,"_27589":55135,"_2954":55310},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3471":1899,"_30355":1824,"_21010":55312,"_5":14420,"_27589":55139,"_2954":55313},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3471":1900,"_30355":1824,"_21010":55315,"_5":14420,"_27589":55143,"_2954":55316},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3471":1901,"_30355":1824,"_21010":55318,"_5":14420,"_27589":55147,"_2954":55319},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3471":1902,"_30355":1824,"_21010":55321,"_5":14420,"_27589":55151,"_2954":55322},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3471":1903,"_30355":1824,"_21010":55324,"_5":14420,"_27589":55155,"_2954":55325},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3471":1904,"_30355":1824,"_21010":55327,"_5":14420,"_27589":55159,"_2954":55328},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3471":1905,"_30355":1824,"_21010":55330,"_5":14420,"_27589":55159,"_2954":55331},[],"The CA’s CRL settings are kept, and they cannot be removed through the API. The last CRL keeps being served but is never regenerated once the CA is gone, so adjust its validity and signer beforehand (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3471":1906,"_30355":1824,"_21010":55333,"_5":14420,"_27589":55159,"_2954":55334},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL).",{"_3471":1907,"_30355":1907,"_5":14772,"_2954":55336,"_30687":55337,"_21010":55338,"_27589":1907},"Certificate profiles",[49421,50896,54901,54902],[],{"_3471":1908,"_30355":1907,"_21010":55340,"_5":14420,"_27589":1907,"_2954":55341},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3471":1909,"_30355":1907,"_5":30684,"_21010":55343,"_27589":55344,"_2954":55345},[],"/docs/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3471":1910,"_30355":1907,"_5":30684,"_21010":55347,"_27589":55348,"_2954":55349},[],"/docs/platform/pki/certificate-profiles#validity","Validity",{"_3471":1911,"_30355":1907,"_5":30684,"_21010":55351,"_27589":55352,"_2954":55353},[],"/docs/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3471":1912,"_30355":1907,"_5":30684,"_21010":55355,"_27589":55356,"_2954":55357},[],"/docs/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3471":1913,"_30355":1907,"_5":30684,"_21010":55359,"_27589":55360,"_2954":55361},[],"/docs/platform/pki/certificate-profiles#subject","Subject",{"_3471":1914,"_30355":1907,"_5":30684,"_21010":55363,"_27589":55364,"_2954":55365},[],"/docs/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3471":1915,"_30355":1907,"_5":30684,"_21010":55367,"_27589":55368,"_2954":55369},[],"/docs/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3471":1916,"_30355":1907,"_5":30684,"_21010":55371,"_27589":55372,"_2954":55373},[],"/docs/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3471":1917,"_30355":1907,"_5":30684,"_21010":55375,"_27589":55376,"_2954":55377},[],"/docs/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3471":1918,"_30355":1907,"_5":30684,"_21010":55379,"_27589":55380,"_2954":55381},[],"/docs/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3471":1919,"_30355":1907,"_5":30684,"_21010":55383,"_27589":55384,"_2954":55385},[],"/docs/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3471":1920,"_30355":1907,"_5":30684,"_21010":55387,"_27589":55388,"_2954":55389},[],"/docs/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3471":1921,"_30355":1907,"_5":30684,"_21010":55391,"_27589":55392,"_2954":55393},[],"/docs/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3471":1922,"_30355":1907,"_5":30684,"_21010":55395,"_27589":55396,"_2954":55397},[],"/docs/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3471":1923,"_30355":1907,"_5":30684,"_21010":55399,"_27589":55400,"_2954":55401},[],"/docs/platform/pki/certificate-profiles#design-examples","Design examples",{"_3471":1924,"_30355":1907,"_5":30684,"_21010":55403,"_27589":55404,"_2954":55405},[],"/docs/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3471":1925,"_30355":1907,"_21010":55407,"_5":14420,"_27589":1907,"_2954":55408},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3471":1926,"_30355":1907,"_21010":55410,"_5":14420,"_27589":1907,"_2954":55411},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3471":1927,"_30355":1907,"_21010":55413,"_5":14420,"_27589":55348,"_2954":55414},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3471":1928,"_30355":1907,"_21010":55416,"_5":14420,"_27589":55348,"_2954":55417},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3471":1929,"_30355":1907,"_21010":55419,"_5":14420,"_27589":55352,"_2954":55420},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Lamassu enforces this: a profile with `Sign as CA` is consumed only when creating or reissuing a CA. Any signing request that resolves to such a profile is rejected — direct signing with a CA, including certificate issuance requests on it, and DMS enrollment or re-enrollment. Nothing validates the profile when it is saved: if a CA's default profile or a DMS profile has `Sign as CA` enabled, the problem appears on the first signing request that resolves to it — for a DMS profile, when a device tries to enroll or re-enroll — and renewal stays blocked until the profile is changed.",{"_3471":1930,"_30355":1907,"_21010":55422,"_5":14420,"_27589":55356,"_2954":55423},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3471":1931,"_30355":1907,"_21010":55425,"_5":14420,"_27589":55356,"_2954":55426},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3471":1932,"_30355":1907,"_21010":55428,"_5":14420,"_27589":55356,"_2954":55429},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3471":1933,"_30355":1907,"_21010":55431,"_5":14420,"_27589":55360,"_2954":55432},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3471":1934,"_30355":1907,"_21010":55434,"_5":14420,"_27589":55364,"_2954":55435},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3471":1935,"_30355":1907,"_21010":55437,"_5":14420,"_27589":55364,"_2954":55438},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3471":1936,"_30355":1907,"_21010":55440,"_5":14420,"_27589":55368,"_2954":55441},[],"The cryptographic enforcement can:",{"_3471":1937,"_30355":1907,"_21010":55443,"_5":14420,"_27589":55368,"_2954":55444},[],"allow or block RSA keys;",{"_3471":1938,"_30355":1907,"_21010":55446,"_5":14420,"_27589":55368,"_2954":55447},[],"limit the supported RSA sizes;",{"_3471":1939,"_30355":1907,"_21010":55449,"_5":14420,"_27589":55368,"_2954":55450},[],"allow or block ECDSA keys;",{"_3471":1940,"_30355":1907,"_21010":55452,"_5":14420,"_27589":55368,"_2954":55453},[],"limit the supported ECDSA sizes or curves.",{"_3471":1941,"_30355":1907,"_21010":55455,"_5":14420,"_27589":55368,"_2954":55456},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3471":1942,"_30355":1907,"_21010":55458,"_5":14420,"_27589":55372,"_2954":55459},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3471":1943,"_30355":1907,"_21010":55461,"_5":14420,"_27589":55372,"_2954":52663},[],{"_3471":1944,"_30355":1907,"_21010":55463,"_5":14420,"_27589":55372,"_2954":55464},[],"First choice",{"_3471":1945,"_30355":1907,"_21010":55466,"_5":14420,"_27589":55372,"_2954":55467},[],"Second choice",{"_3471":1946,"_30355":1907,"_21010":55469,"_5":14420,"_27589":55372,"_2954":55470},[],"If neither is supplied",{"_3471":1947,"_30355":1907,"_21010":55472,"_5":14420,"_27589":55372,"_2954":55473},[],"Direct signing with a CA",{"_3471":1948,"_30355":1907,"_21010":55475,"_5":14420,"_27589":55372,"_2954":55476},[],"`issuance_profile` embedded in the request",{"_3471":1949,"_30355":1907,"_21010":55478,"_5":14420,"_27589":55372,"_2954":55479},[],"Request `issuance_profile_id`",{"_3471":1950,"_30355":1907,"_21010":55481,"_5":14420,"_27589":55372,"_2954":55482},[],"CA default profile (`profile_id`).",{"_3471":1951,"_30355":1907,"_21010":55484,"_5":14420,"_27589":55372,"_2954":55485},[],"Issuance through a DMS",{"_3471":1952,"_30355":1907,"_21010":55487,"_5":14420,"_27589":55372,"_2954":55488},[],"`settings.issuance_profile_id`",{"_3471":1953,"_30355":1907,"_21010":55490,"_5":14420,"_27589":55372,"_2954":55491},[],"`settings.issuance_profile` embedded in the DMS",{"_3471":1954,"_30355":1907,"_21010":55493,"_5":14420,"_27589":55372,"_2954":55494},[],"Enrollment CA default profile.",{"_3471":1955,"_30355":1907,"_21010":55496,"_5":14420,"_27589":55372,"_2954":55497},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3471":1956,"_30355":1907,"_21010":55499,"_5":14420,"_27589":55372,"_2954":55500},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3471":1957,"_30355":1907,"_21010":55502,"_5":14420,"_27589":55380,"_2954":55503},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3471":1958,"_30355":1907,"_21010":55505,"_5":14420,"_27589":55384,"_2954":55506},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3471":1959,"_30355":1907,"_21010":55508,"_5":14420,"_27589":55388,"_2954":55509},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3471":1960,"_30355":1907,"_21010":55511,"_5":14420,"_27589":55392,"_2954":55512},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3471":1961,"_30355":1907,"_21010":55514,"_5":14420,"_27589":55396,"_2954":55515},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3471":1962,"_30355":1907,"_21010":55517,"_5":14420,"_27589":55396,"_2954":55518},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3471":1963,"_30355":1907,"_21010":55520,"_5":14420,"_27589":55400,"_2954":55521},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3471":1964,"_30355":1907,"_21010":55523,"_5":14420,"_27589":55400,"_2954":55524},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3471":1965,"_30355":1907,"_21010":55526,"_5":14420,"_27589":55400,"_2954":55527},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3471":1966,"_30355":1907,"_21010":55529,"_5":14420,"_27589":55400,"_2954":55530},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3471":1967,"_30355":1907,"_21010":55532,"_5":14420,"_27589":55404,"_2954":55533},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3471":1968,"_30355":1907,"_21010":55535,"_5":14420,"_27589":55404,"_2954":55536},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3471":1969,"_30355":1969,"_5":14772,"_2954":55538,"_30687":55539,"_21010":55541,"_27589":1969},"Certificate validation",[49421,50896,54901,55540],"Validation",[],{"_3471":1970,"_30355":1969,"_21010":55543,"_5":14420,"_27589":1969,"_2954":55544},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3471":1971,"_30355":1969,"_5":30684,"_21010":55546,"_27589":55547,"_2954":55548},[],"/docs/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3471":1972,"_30355":1969,"_5":30684,"_21010":55550,"_27589":55551,"_2954":55552},[],"/docs/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3471":1973,"_30355":1969,"_5":30684,"_21010":55554,"_27589":55555,"_2954":55556},[],"/docs/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3471":1974,"_30355":1969,"_21010":55558,"_5":14420,"_27589":1969,"_2954":55559},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3471":1975,"_30355":1969,"_21010":55561,"_5":14420,"_27589":55547,"_2954":55562},[],"Verify these criteria together:",{"_3471":1976,"_30355":1969,"_21010":55564,"_5":14420,"_27589":55547,"_2954":54527},[],{"_3471":1977,"_30355":1969,"_21010":55566,"_5":14420,"_27589":55547,"_2954":55567},[],"Required result",{"_3471":1978,"_30355":1969,"_21010":55569,"_5":14420,"_27589":55547,"_2954":55570},[],"Chain and signature",{"_3471":1979,"_30355":1969,"_21010":55572,"_5":14420,"_27589":55547,"_2954":55573},[],"Valid chain to a root deliberately installed in the consumer.",{"_3471":1980,"_30355":1969,"_21010":55575,"_5":14420,"_27589":55547,"_2954":55576},[],"Dates",{"_3471":1981,"_30355":1969,"_21010":55578,"_5":14420,"_27589":55547,"_2954":55579},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3471":1982,"_30355":1969,"_21010":55581,"_5":14420,"_27589":55547,"_2954":50565},[],{"_3471":1983,"_30355":1969,"_21010":55583,"_5":14420,"_27589":55547,"_2954":55584},[],"Name, SAN or identifier matches the expected peer.",{"_3471":1984,"_30355":1969,"_21010":55586,"_5":14420,"_27589":55547,"_2954":49811},[],{"_3471":1985,"_30355":1969,"_21010":55588,"_5":14420,"_27589":55547,"_2954":55589},[],"KU, EKU and constraints permit the specific operation.",{"_3471":1986,"_30355":1969,"_21010":55591,"_5":14420,"_27589":55547,"_2954":55592},[],"Revocation",{"_3471":1987,"_30355":1969,"_21010":55594,"_5":14420,"_27589":55547,"_2954":55595},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3471":1988,"_30355":1969,"_21010":55597,"_5":14420,"_27589":55547,"_2954":55598},[],"Authorization",{"_3471":1989,"_30355":1969,"_21010":55600,"_5":14420,"_27589":55547,"_2954":55601},[],"The application permits that identity to perform the action.",{"_3471":1990,"_30355":1969,"_21010":55603,"_5":14420,"_27589":55547,"_2954":55604},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3471":1991,"_30355":1969,"_21010":55606,"_5":14420,"_27589":55551,"_2954":55607},[],"Mechanism",{"_3471":1992,"_30355":1969,"_21010":55609,"_5":14420,"_27589":55551,"_2954":55610},[],"When to use it",{"_3471":1993,"_30355":1969,"_21010":55612,"_5":14420,"_27589":55551,"_2954":55613},[],"What you must maintain",{"_3471":1994,"_30355":1969,"_21010":55615,"_5":14420,"_27589":55551,"_2954":55616},[],"OCSP",{"_3471":1995,"_30355":1969,"_21010":55618,"_5":14420,"_27589":55551,"_2954":55619},[],"Status query for a specific certificate.",{"_3471":1996,"_30355":1969,"_21010":55621,"_5":14420,"_27589":55551,"_2954":55622},[],"Responder access, signature verification and cache/freshness policy.",{"_3471":1997,"_30355":1969,"_21010":55624,"_5":14420,"_27589":55551,"_2954":55625},[],"CRL",{"_3471":1998,"_30355":1969,"_21010":55627,"_5":14420,"_27589":55551,"_2954":55628},[],"Local checks for many certificates or offline operation.",{"_3471":1999,"_30355":1969,"_21010":55630,"_5":14420,"_27589":55551,"_2954":55631},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3471":2000,"_30355":1969,"_21010":55633,"_5":14420,"_27589":55551,"_2954":55634},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3471":2001,"_30355":1969,"_21010":55636,"_5":14420,"_27589":55551,"_2954":55637},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3471":2002,"_30355":1969,"_21010":55639,"_5":14420,"_27589":55555,"_2954":55640},[],"Accept a current, authorized certificate with a known chain.",{"_3471":2003,"_30355":1969,"_21010":55642,"_5":14420,"_27589":55555,"_2954":55643},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3471":2004,"_30355":1969,"_21010":55645,"_5":14420,"_27589":55555,"_2954":55646},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3471":2005,"_30355":1969,"_21010":55648,"_5":14420,"_27589":55555,"_2954":55649},[],"Check that a new connection with that identity is rejected.",{"_3471":2006,"_30355":1969,"_21010":55651,"_5":14420,"_27589":55555,"_2954":55652},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3471":2007,"_30355":1969,"_21010":55654,"_5":14420,"_27589":55555,"_2954":55655},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3471":2008,"_30355":1969,"_21010":55657,"_5":14420,"_27589":55555,"_2954":55658},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3471":2009,"_30355":1969,"_21010":55660,"_5":14420,"_27589":55555,"_2954":55661},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3471":2010,"_30355":1969,"_21010":55663,"_5":14420,"_27589":55555,"_2954":55664},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3471":2011,"_30355":2011,"_5":14772,"_2954":55666,"_30687":55667,"_21010":55668,"_27589":2011},"Certificates",[49421,50896,54901,54902],[],{"_3471":2012,"_30355":2011,"_21010":55670,"_5":14420,"_27589":2011,"_2954":55671},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3471":2013,"_30355":2011,"_5":30684,"_21010":55673,"_27589":55674,"_2954":55675},[],"/docs/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3471":2014,"_30355":2011,"_5":30684,"_21010":55677,"_27589":55678,"_2954":55679},[],"/docs/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3471":2015,"_30355":2011,"_5":30684,"_21010":55681,"_27589":55682,"_2954":55683},[],"/docs/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3471":2016,"_30355":2011,"_5":30684,"_21010":55685,"_27589":55686,"_2954":55687},[],"/docs/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3471":2017,"_30355":2011,"_5":30684,"_21010":55689,"_27589":55690,"_2954":55691},[],"/docs/platform/pki/certificates#open-the-action","Open the action",{"_3471":2018,"_30355":2011,"_5":30684,"_21010":55693,"_27589":55694,"_2954":55695},[],"/docs/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3471":2019,"_30355":2011,"_5":30684,"_21010":55697,"_27589":55698,"_2954":55699},[],"/docs/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3471":2020,"_30355":2011,"_5":30684,"_21010":55701,"_27589":55702,"_2954":55703},[],"/docs/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3471":2021,"_30355":2011,"_5":30684,"_21010":55705,"_27589":55706,"_2954":55707},[],"/docs/platform/pki/certificates#continue","Continue",{"_3471":2022,"_30355":2011,"_21010":55709,"_5":14420,"_27589":2011,"_2954":55710},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3471":2023,"_30355":2011,"_21010":55712,"_5":14420,"_27589":55674,"_2954":55713},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3471":2024,"_30355":2011,"_21010":55715,"_5":14420,"_27589":55674,"_2954":55716},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3471":2025,"_30355":2011,"_21010":55718,"_5":14420,"_27589":55674,"_2954":55719},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3471":2026,"_30355":2011,"_21010":55721,"_5":14420,"_27589":55674,"_2954":55722},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3471":2027,"_30355":2011,"_21010":55724,"_5":14420,"_27589":55674,"_2954":55725},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3471":2028,"_30355":2011,"_21010":55727,"_5":14420,"_27589":55674,"_2954":55728},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3471":2029,"_30355":2011,"_21010":55730,"_5":14420,"_27589":55674,"_2954":55731},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3471":2030,"_30355":2011,"_21010":55733,"_5":14420,"_27589":55678,"_2954":55734},[],"Download the PEM and inspect it:",{"_3471":2031,"_30355":2011,"_21010":55736,"_5":14420,"_27589":55678,"_2954":55737},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3471":2032,"_30355":2011,"_21010":55739,"_5":14420,"_27589":55682,"_2954":55740},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3471":2033,"_30355":2011,"_21010":55742,"_5":14420,"_27589":55682,"_2954":55743},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3471":2034,"_30355":2011,"_21010":55745,"_5":14420,"_27589":55682,"_2954":55746},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3471":2035,"_30355":2011,"_21010":55748,"_5":14420,"_27589":55682,"_2954":55749},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3471":2036,"_30355":2011,"_21010":55751,"_5":14420,"_27589":55682,"_2954":55752},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3471":2037,"_30355":2011,"_21010":55754,"_5":14420,"_27589":55682,"_2954":55755},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3471":2038,"_30355":2011,"_21010":55757,"_5":14420,"_27589":55682,"_2954":55758},[],"For browser key generation, follow Issue your first certificate.",{"_3471":2039,"_30355":2011,"_21010":55760,"_5":14420,"_27589":55686,"_2954":55761},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3471":2040,"_30355":2011,"_21010":55763,"_5":14420,"_27589":55690,"_2954":55764},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3471":2041,"_30355":2011,"_21010":55766,"_5":14420,"_27589":55694,"_2954":55767},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3471":2042,"_30355":2011,"_21010":55769,"_5":14420,"_27589":55698,"_2954":55770},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3471":2043,"_30355":2011,"_21010":55772,"_5":14420,"_27589":55698,"_2954":55773},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3471":2044,"_30355":2011,"_21010":55775,"_5":14420,"_27589":55698,"_2954":55776},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3471":2045,"_30355":2011,"_21010":55778,"_5":14420,"_27589":55702,"_2954":55779},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3471":2046,"_30355":2011,"_21010":55781,"_5":14420,"_27589":55702,"_2954":55782},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3471":2047,"_30355":2011,"_21010":55784,"_5":14420,"_27589":55702,"_2954":55785},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3471":2048,"_30355":2011,"_21010":55787,"_5":14420,"_27589":55706,"_2954":55788},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3471":2049,"_30355":2011,"_21010":55790,"_5":14420,"_27589":55706,"_2954":55791},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3471":2050,"_30355":2050,"_5":14772,"_2954":55793,"_30687":55794,"_21010":55796,"_27589":2050},"Certificate lifecycle",[49421,50896,54901,55795],"Concepts",[],{"_3471":2051,"_30355":2050,"_21010":55798,"_5":14420,"_27589":2050,"_2954":55799},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3471":2052,"_30355":2050,"_5":30684,"_21010":55801,"_27589":55802,"_2954":55803},[],"/docs/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3471":2053,"_30355":2050,"_5":30684,"_21010":55805,"_27589":55806,"_2954":55807},[],"/docs/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3471":2054,"_30355":2050,"_5":30684,"_21010":55809,"_27589":55810,"_2954":55811},[],"/docs/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3471":2055,"_30355":2050,"_5":30684,"_21010":55813,"_27589":55814,"_2954":55815},[],"/docs/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3471":2056,"_30355":2050,"_5":30684,"_21010":55817,"_27589":55818,"_2954":55819},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3471":2057,"_30355":2050,"_5":30684,"_21010":55821,"_27589":55822,"_2954":55823},[],"/docs/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3471":2058,"_30355":2050,"_5":30684,"_21010":55825,"_27589":55826,"_2954":55827},[],"/docs/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3471":2059,"_30355":2050,"_5":30684,"_21010":55829,"_27589":55830,"_2954":55831},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3471":2060,"_30355":2050,"_5":30684,"_21010":55833,"_27589":55834,"_2954":55835},[],"/docs/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3471":2061,"_30355":2050,"_5":30684,"_21010":55837,"_27589":55838,"_2954":55839},[],"/docs/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3471":2062,"_30355":2050,"_21010":55841,"_5":14420,"_27589":2050,"_2954":55842},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3471":2063,"_30355":2050,"_21010":55844,"_5":14420,"_27589":55806,"_2954":55845},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3471":2064,"_30355":2050,"_21010":55847,"_5":14420,"_27589":55810,"_2954":55848},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3471":2065,"_30355":2050,"_21010":55850,"_5":14420,"_27589":55814,"_2954":55851},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3471":2066,"_30355":2050,"_21010":55853,"_5":14420,"_27589":55818,"_2954":55854},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3471":2067,"_30355":2050,"_21010":55856,"_5":14420,"_27589":55822,"_2954":55857},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3471":2068,"_30355":2050,"_21010":55859,"_5":14420,"_27589":55826,"_2954":55860},[],"Lamassu persists four X.509 states:",{"_3471":2069,"_30355":2050,"_21010":55862,"_5":14420,"_27589":55826,"_2954":55863},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3471":2070,"_30355":2050,"_21010":55865,"_5":14420,"_27589":55826,"_2954":55866},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3471":2071,"_30355":2050,"_21010":55868,"_5":14420,"_27589":55826,"_2954":55869},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3471":2072,"_30355":2050,"_21010":55871,"_5":14420,"_27589":55826,"_2954":55872},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3471":2073,"_30355":2050,"_21010":55874,"_5":14420,"_27589":55826,"_2954":55875},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3471":2074,"_30355":2050,"_21010":55877,"_5":14420,"_27589":55830,"_2954":55878},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3471":2075,"_30355":2050,"_21010":55880,"_5":14420,"_27589":55830,"_2954":55881},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3471":2076,"_30355":2050,"_21010":55883,"_5":14420,"_27589":55830,"_2954":55884},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3471":2077,"_30355":2050,"_21010":55886,"_5":14420,"_27589":55834,"_2954":55887},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3471":2078,"_30355":2050,"_21010":55889,"_5":14420,"_27589":55834,"_2954":55890},[],"Before confirming:",{"_3471":2079,"_30355":2050,"_21010":55892,"_5":14420,"_27589":55834,"_2954":55893},[],"Identify DMSs, devices and services that trust that chain.",{"_3471":2080,"_30355":2050,"_21010":55895,"_5":14420,"_27589":55834,"_2954":55896},[],"Distribute the new chain of trust.",{"_3471":2081,"_30355":2050,"_21010":55898,"_5":14420,"_27589":55834,"_2954":55899},[],"Reissue the necessary identities.",{"_3471":2082,"_30355":2050,"_21010":55901,"_5":14420,"_27589":55834,"_2954":55902},[],"Check OCSP and CRL from a real consumer.",{"_3471":2083,"_30355":2050,"_21010":55904,"_5":14420,"_27589":55834,"_2954":55905},[],"Revoke the old CA once no legitimate traffic remains.",{"_3471":2084,"_30355":2050,"_21010":55907,"_5":14420,"_27589":55834,"_2954":55908},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3471":2085,"_30355":2050,"_21010":55910,"_5":14420,"_27589":55838,"_2954":55911},[],"Certificates entering the preventive or critical renewal window.",{"_3471":2086,"_30355":2050,"_21010":55913,"_5":14420,"_27589":55838,"_2954":55914},[],"Repeated enrollment or re-enrollment failures.",{"_3471":2087,"_30355":2050,"_21010":55916,"_5":14420,"_27589":55838,"_2954":55917},[],"Status changes and revocation reasons.",{"_3471":2088,"_30355":2050,"_21010":55919,"_5":14420,"_27589":55838,"_2954":55920},[],"OCSP and CRL publication and validity.",{"_3471":2089,"_30355":2050,"_21010":55922,"_5":14420,"_27589":55838,"_2954":55923},[],"Dependencies still presenting a replaced certificate.",{"_3471":2090,"_30355":2050,"_21010":55925,"_5":14420,"_27589":55838,"_2954":55926},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3471":2091,"_30355":2091,"_5":14772,"_2954":55928,"_30687":55929,"_21010":55930,"_27589":2091},"Trust model",[49421,50896,54901,55795],[],{"_3471":2092,"_30355":2091,"_21010":55932,"_5":14420,"_27589":2091,"_2954":55933},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3471":2093,"_30355":2091,"_5":30684,"_21010":55935,"_27589":55936,"_2954":55937},[],"/docs/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3471":2094,"_30355":2091,"_5":30684,"_21010":55939,"_27589":55940,"_2954":55941},[],"/docs/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3471":2095,"_30355":2091,"_5":30684,"_21010":55943,"_27589":55944,"_2954":55945},[],"/docs/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3471":2096,"_30355":2091,"_5":30684,"_21010":55947,"_27589":55948,"_2954":55949},[],"/docs/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3471":2097,"_30355":2091,"_5":30684,"_21010":55951,"_27589":55952,"_2954":55953},[],"/docs/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3471":2098,"_30355":2091,"_5":30684,"_21010":55955,"_27589":55956,"_2954":55957},[],"/docs/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3471":2099,"_30355":2091,"_5":30684,"_21010":55959,"_27589":55960,"_2954":55961},[],"/docs/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3471":2100,"_30355":2091,"_5":30684,"_21010":55963,"_27589":55964,"_2954":55965},[],"/docs/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3471":2101,"_30355":2091,"_5":30684,"_21010":55967,"_27589":55968,"_2954":55969},[],"/docs/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3471":2102,"_30355":2091,"_5":30684,"_21010":55971,"_27589":55972,"_2954":55973},[],"/docs/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3471":2103,"_30355":2091,"_21010":55975,"_5":14420,"_27589":2091,"_2954":55976},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3471":2104,"_30355":2091,"_21010":55978,"_5":14420,"_27589":55940,"_2954":55979},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3471":2105,"_30355":2091,"_21010":55981,"_5":14420,"_27589":55944,"_2954":55982},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3471":2106,"_30355":2091,"_21010":55984,"_5":14420,"_27589":55948,"_2954":55985},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3471":2107,"_30355":2091,"_21010":55987,"_5":14420,"_27589":55952,"_2954":55988},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3471":2108,"_30355":2091,"_21010":55990,"_5":14420,"_27589":55956,"_2954":55991},[],"The device proves it can enroll according to the DMS policy.",{"_3471":2109,"_30355":2091,"_21010":55993,"_5":14420,"_27589":55956,"_2954":55994},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3471":2110,"_30355":2091,"_21010":55996,"_5":14420,"_27589":55956,"_2954":55997},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3471":2111,"_30355":2091,"_21010":55999,"_5":14420,"_27589":55956,"_2954":56000},[],"The device installs the certificate and the chain it needs.",{"_3471":2112,"_30355":2091,"_21010":56002,"_5":14420,"_27589":55956,"_2954":56003},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3471":2113,"_30355":2091,"_21010":56005,"_5":14420,"_27589":55956,"_2954":56006},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3471":2114,"_30355":2091,"_21010":56008,"_5":14420,"_27589":55960,"_2954":56009},[],"A DMS relates three sets that are worth designing separately:",{"_3471":2115,"_30355":2091,"_21010":56011,"_5":14420,"_27589":55960,"_2954":56012},[],"**Enrollment CA:** signs the new identities.",{"_3471":2116,"_30355":2091,"_21010":56014,"_5":14420,"_27589":55960,"_2954":56015},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3471":2117,"_30355":2091,"_21010":56017,"_5":14420,"_27589":55960,"_2954":56018},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3471":2118,"_30355":2091,"_21010":56020,"_5":14420,"_27589":55960,"_2954":56021},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3471":2119,"_30355":2091,"_21010":56023,"_5":14420,"_27589":55964,"_2954":56024},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3471":2120,"_30355":2091,"_21010":56026,"_5":14420,"_27589":55964,"_2954":56027},[],"that the current date is between `Not Before` and `Not After`;",{"_3471":2121,"_30355":2091,"_21010":56029,"_5":14420,"_27589":55964,"_2954":56030},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3471":2122,"_30355":2091,"_21010":56032,"_5":14420,"_27589":55964,"_2954":56033},[],"that names, SANs and subject match the expected identity;",{"_3471":2123,"_30355":2091,"_21010":56035,"_5":14420,"_27589":55964,"_2954":56036},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3471":2124,"_30355":2091,"_21010":56038,"_5":14420,"_27589":55964,"_2954":56039},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3471":2125,"_30355":2091,"_21010":56041,"_5":14420,"_27589":55964,"_2954":56042},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3471":2126,"_30355":2091,"_21010":56044,"_5":14420,"_27589":55968,"_2954":56045},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3471":2127,"_30355":2091,"_21010":56047,"_5":14420,"_27589":55972,"_2954":56048},[],"Keep the root out of daily operations, or with very restricted access.",{"_3471":2128,"_30355":2091,"_21010":56050,"_5":14420,"_27589":55972,"_2954":56051},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3471":2129,"_30355":2091,"_21010":56053,"_5":14420,"_27589":55972,"_2954":56054},[],"Assign explicit profiles to every use case.",{"_3471":2130,"_30355":2091,"_21010":56056,"_5":14420,"_27589":55972,"_2954":56057},[],"Distribute the new trust before starting a rotation.",{"_3471":2131,"_30355":2091,"_21010":56059,"_5":14420,"_27589":55972,"_2954":56060},[],"Keep enough overlap to renew a disconnected fleet.",{"_3471":2132,"_30355":2091,"_21010":56062,"_5":14420,"_27589":55972,"_2954":56063},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3471":2133,"_30355":2091,"_21010":56065,"_5":14420,"_27589":55972,"_2954":56066},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3471":2134,"_30355":2134,"_5":14772,"_2954":56068,"_30687":56069,"_21010":56070,"_27589":2134},"Revocation lists (CRL)",[49421,50896,54901,55540],[],{"_3471":2135,"_30355":2134,"_21010":56072,"_5":14420,"_27589":2134,"_2954":56073},[],"Generate and distribute signed lists to validate certificates offline.",{"_3471":2136,"_30355":2134,"_5":30684,"_21010":56075,"_27589":56076,"_2954":56077},[],"/docs/platform/pki/crl#crl-settings","CRL settings",{"_3471":2137,"_30355":2134,"_5":30684,"_21010":56079,"_27589":56080,"_2954":56081},[],"/docs/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3471":2138,"_30355":2134,"_5":30684,"_21010":56083,"_27589":56084,"_2954":56085},[],"/docs/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3471":2139,"_30355":2134,"_5":30684,"_21010":56087,"_27589":56088,"_2954":56089},[],"/docs/platform/pki/crl#crl-contents","CRL contents",{"_3471":2140,"_30355":2134,"_5":30684,"_21010":56091,"_27589":56092,"_2954":56093},[],"/docs/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3471":2141,"_30355":2134,"_5":30684,"_21010":56095,"_27589":56096,"_2954":56097},[],"/docs/platform/pki/crl#crl-settings-api","CRL settings API",{"_3471":2142,"_30355":2134,"_5":30684,"_21010":56099,"_27589":56100,"_2954":56101},[],"/docs/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3471":2143,"_30355":2134,"_5":30684,"_21010":56103,"_27589":56104,"_2954":56105},[],"/docs/platform/pki/crl#from-the-interface","From the interface",{"_3471":2144,"_30355":2134,"_5":30684,"_21010":56107,"_27589":56108,"_2954":56109},[],"/docs/platform/pki/crl#references","References",{"_3471":2145,"_30355":2134,"_21010":56111,"_5":14420,"_27589":2134,"_2954":56112},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3471":2146,"_30355":2134,"_21010":56114,"_5":14420,"_27589":56076,"_2954":56115},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3471":2147,"_30355":2134,"_21010":56117,"_5":14420,"_27589":56076,"_2954":56118},[],"Field",{"_3471":2148,"_30355":2134,"_21010":56120,"_5":14420,"_27589":56076,"_2954":49811},[],{"_3471":2149,"_30355":2134,"_21010":56122,"_5":14420,"_27589":56076,"_2954":56123},[],"`ca_id`",{"_3471":2150,"_30355":2134,"_21010":56125,"_5":14420,"_27589":56076,"_2954":56126},[],"ID of the CA the settings belong to.",{"_3471":2151,"_30355":2134,"_21010":56128,"_5":14420,"_27589":56076,"_2954":56129},[],"`status`",{"_3471":2152,"_30355":2134,"_21010":56131,"_5":14420,"_27589":56076,"_2954":56132},[],"`ACTIVE` settings generate CRLs. `ARCHIVED` ones belong to a CA that no longer exists: their last CRL is still served, but never regenerated.",{"_3471":2153,"_30355":2134,"_21010":56134,"_5":14420,"_27589":56076,"_2954":56135},[],"`legacy_ski`",{"_3471":2154,"_30355":2134,"_21010":56137,"_5":14420,"_27589":56076,"_2954":56138},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3471":2155,"_30355":2134,"_21010":56140,"_5":14420,"_27589":56076,"_2954":56141},[],"`latest_crl`",{"_3471":2156,"_30355":2134,"_21010":56143,"_5":14420,"_27589":56076,"_2954":56144},[],"Version, validity start and end of the last published list. Read-only.",{"_3471":2157,"_30355":2134,"_21010":56146,"_5":14420,"_27589":56076,"_2954":56147},[],"`crl_options` field",{"_3471":2158,"_30355":2134,"_21010":56149,"_5":14420,"_27589":56076,"_2954":49811},[],{"_3471":2159,"_30355":2134,"_21010":56151,"_5":14420,"_27589":56076,"_2954":56152},[],"Initial value",{"_3471":2160,"_30355":2134,"_21010":56154,"_5":14420,"_27589":56076,"_2954":56155},[],"`validity`",{"_3471":2161,"_30355":2134,"_21010":56157,"_5":14420,"_27589":56076,"_2954":56158},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3471":2162,"_30355":2134,"_21010":56160,"_5":14420,"_27589":56076,"_2954":56161},[],"7 days.",{"_3471":2163,"_30355":2134,"_21010":56163,"_5":14420,"_27589":56076,"_2954":56164},[],"`refresh_interval`",{"_3471":2164,"_30355":2134,"_21010":56166,"_5":14420,"_27589":56076,"_2954":56167},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3471":2165,"_30355":2134,"_21010":56169,"_5":14420,"_27589":56076,"_2954":56170},[],"6 days and 23 hours.",{"_3471":2166,"_30355":2134,"_21010":56172,"_5":14420,"_27589":56076,"_2954":56173},[],"`regenerate_on_revoke`",{"_3471":2167,"_30355":2134,"_21010":56175,"_5":14420,"_27589":56076,"_2954":56176},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3471":2168,"_30355":2134,"_21010":56178,"_5":14420,"_27589":56076,"_2954":56179},[],"`true`.",{"_3471":2169,"_30355":2134,"_21010":56181,"_5":14420,"_27589":56076,"_2954":56182},[],"`signer_serial_number`",{"_3471":2170,"_30355":2134,"_21010":56184,"_5":14420,"_27589":56076,"_2954":56185},[],"Serial number of the existing certificate that signs the CRL.",{"_3471":2171,"_30355":2134,"_21010":56187,"_5":14420,"_27589":56076,"_2954":56188},[],"Serial number of the CA’s current certificate.",{"_3471":2172,"_30355":2134,"_21010":56190,"_5":14420,"_27589":56076,"_2954":56191},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3471":2173,"_30355":2134,"_21010":56193,"_5":14420,"_27589":56076,"_2954":56194},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3471":2174,"_30355":2134,"_21010":56196,"_5":14420,"_27589":56076,"_2954":56197},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3471":2175,"_30355":2134,"_21010":56199,"_5":14420,"_27589":56076,"_2954":56200},[],"Deleting a CA keeps its CRL settings, and they cannot be removed through the API. What happens next depends on when the CA was deleted:",{"_3471":2176,"_30355":2134,"_21010":56202,"_5":14420,"_27589":56076,"_2954":56203},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated, any `PUT` returns 409, and there is no API way back to `ACTIVE`.",{"_3471":2177,"_30355":2134,"_21010":56205,"_5":14420,"_27589":56076,"_2954":56206},[],"A CA deleted while running 4.0.0 leaves `ACTIVE` settings. The last CRL keeps being served, but once it expires nothing regenerates it: the renewal job logs `something went wrong while calculating CRL for CA <ca-id>` on every cycle because it can no longer resolve the CA. The options can still be edited while the signer is unchanged; changing the signer fails, because there is no CA left to match it.",{"_3471":2178,"_30355":2134,"_21010":56208,"_5":14420,"_27589":56076,"_2954":56209},[],"Adjust validity and signer before deleting a CA.",{"_3471":2179,"_30355":2134,"_21010":56211,"_5":14420,"_27589":56076,"_2954":56212},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3471":2180,"_30355":2134,"_21010":56214,"_5":14420,"_27589":56076,"_2954":56215},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3471":2181,"_30355":2134,"_21010":56217,"_5":14420,"_27589":56076,"_2954":56218},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3471":2182,"_30355":2134,"_21010":56220,"_5":14420,"_27589":56080,"_2954":56221},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3471":2183,"_30355":2134,"_21010":56223,"_5":14420,"_27589":56080,"_2954":56224},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3471":2184,"_30355":2134,"_21010":56226,"_5":14420,"_27589":56080,"_2954":56227},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3471":2185,"_30355":2134,"_21010":56229,"_5":14420,"_27589":56080,"_2954":56230},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3471":2186,"_30355":2134,"_21010":56232,"_5":14420,"_27589":56084,"_2954":56233},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3471":2187,"_30355":2134,"_21010":56235,"_5":14420,"_27589":56084,"_2954":56236},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3471":2188,"_30355":2134,"_21010":56238,"_5":14420,"_27589":56084,"_2954":56239},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3471":2189,"_30355":2134,"_21010":56241,"_5":14420,"_27589":56084,"_2954":56242},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3471":2190,"_30355":2134,"_21010":56244,"_5":14420,"_27589":56084,"_2954":56245},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3471":2191,"_30355":2134,"_21010":56247,"_5":14420,"_27589":56084,"_2954":56248},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3471":2192,"_30355":2134,"_21010":56250,"_5":14420,"_27589":56084,"_2954":56251},[],"Settings whose `status` is `ARCHIVED` are skipped: nothing regenerates their CRL.",{"_3471":2193,"_30355":2134,"_21010":56253,"_5":14420,"_27589":56084,"_2954":56254},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3471":2194,"_30355":2134,"_21010":56256,"_5":14420,"_27589":56084,"_2954":56257},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3471":2195,"_30355":2134,"_21010":56259,"_5":14420,"_27589":56088,"_2954":56260},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3471":2196,"_30355":2134,"_21010":56262,"_5":14420,"_27589":56088,"_2954":56263},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3471":2197,"_30355":2134,"_21010":56265,"_5":14420,"_27589":56092,"_2954":56266},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3471":2198,"_30355":2134,"_21010":56268,"_5":14420,"_27589":56092,"_2954":56269},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3471":2199,"_30355":2134,"_21010":56271,"_5":14420,"_27589":56092,"_2954":56272},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3471":2200,"_30355":2134,"_21010":56274,"_5":14420,"_27589":56092,"_2954":56275},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3471":2201,"_30355":2134,"_21010":56277,"_5":14420,"_27589":56092,"_2954":56278},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3471":2202,"_30355":2134,"_21010":56280,"_5":14420,"_27589":56096,"_2954":56281},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3471":2203,"_30355":2134,"_21010":56283,"_5":14420,"_27589":56096,"_2954":52666},[],{"_3471":2204,"_30355":2134,"_21010":56285,"_5":14420,"_27589":56096,"_2954":56286},[],"Relative path",{"_3471":2205,"_30355":2134,"_21010":56288,"_5":14420,"_27589":56096,"_2954":52663},[],{"_3471":2206,"_30355":2134,"_21010":56290,"_5":14420,"_27589":56096,"_2954":56291},[],"`GET`",{"_3471":2207,"_30355":2134,"_21010":56293,"_5":14420,"_27589":56096,"_2954":56294},[],"`/v1/crl-settings`",{"_3471":2208,"_30355":2134,"_21010":56296,"_5":14420,"_27589":56096,"_2954":56297},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3471":2209,"_30355":2134,"_21010":56299,"_5":14420,"_27589":56096,"_2954":56291},[],{"_3471":2210,"_30355":2134,"_21010":56301,"_5":14420,"_27589":56096,"_2954":56302},[],"`/v1/crl-settings/{ca-id}`",{"_3471":2211,"_30355":2134,"_21010":56304,"_5":14420,"_27589":56096,"_2954":56305},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3471":2212,"_30355":2134,"_21010":56307,"_5":14420,"_27589":56096,"_2954":56308},[],"`PUT`",{"_3471":2213,"_30355":2134,"_21010":56310,"_5":14420,"_27589":56096,"_2954":56302},[],{"_3471":2214,"_30355":2134,"_21010":56312,"_5":14420,"_27589":56096,"_2954":56313},[],"Replace the CRL configuration of a CA.",{"_3471":2215,"_30355":2134,"_21010":56315,"_5":14420,"_27589":56096,"_2954":56316},[],"You need authentication and CRL settings read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL.",{"_3471":2216,"_30355":2134,"_21010":56318,"_5":14420,"_27589":56096,"_2954":56319},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3471":2217,"_30355":2134,"_21010":56321,"_5":14420,"_27589":56100,"_2954":56322},[],"Symptom",{"_3471":2218,"_30355":2134,"_21010":56324,"_5":14420,"_27589":56100,"_2954":56325},[],"Cause",{"_3471":2219,"_30355":2134,"_21010":56327,"_5":14420,"_27589":56100,"_2954":56328},[],"Action",{"_3471":2220,"_30355":2134,"_21010":56330,"_5":14420,"_27589":56100,"_2954":56331},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3471":2221,"_30355":2134,"_21010":56333,"_5":14420,"_27589":56100,"_2954":56334},[],"The settings are not `ACTIVE`: the migration archived them because their CA was deleted before the upgrade.",{"_3471":2222,"_30355":2134,"_21010":56336,"_5":14420,"_27589":56100,"_2954":56337},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3471":2223,"_30355":2134,"_21010":56339,"_5":14420,"_27589":56100,"_2954":56340},[],"`PUT` returns 400.",{"_3471":2224,"_30355":2134,"_21010":56342,"_5":14420,"_27589":56100,"_2954":56343},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3471":2225,"_30355":2134,"_21010":56345,"_5":14420,"_27589":56100,"_2954":56346},[],"Set the serial number of a valid certificate of that CA.",{"_3471":2226,"_30355":2134,"_21010":56348,"_5":14420,"_27589":56100,"_2954":56349},[],"`PUT` returns 404.",{"_3471":2227,"_30355":2134,"_21010":56351,"_5":14420,"_27589":56100,"_2954":56352},[],"The CA or the new signer certificate does not exist (for example, the CA was deleted), or the CA has no CRL settings (for example, an imported CA).",{"_3471":2228,"_30355":2134,"_21010":56354,"_5":14420,"_27589":56100,"_2954":56355},[],"Check the CA ID and the signer serial number.",{"_3471":2229,"_30355":2134,"_21010":56357,"_5":14420,"_27589":56100,"_2954":56358},[],"`PUT` returns 400 from a 3.x client.",{"_3471":2230,"_30355":2134,"_21010":56360,"_5":14420,"_27589":56100,"_2954":56361},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3471":2231,"_30355":2134,"_21010":56363,"_5":14420,"_27589":56100,"_2954":56364},[],"Update the client to send the new field.",{"_3471":2232,"_30355":2134,"_21010":56366,"_5":14420,"_27589":56100,"_2954":56367},[],"The CRL does not change after revoking a certificate.",{"_3471":2233,"_30355":2134,"_21010":56369,"_5":14420,"_27589":56100,"_2954":56370},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3471":2234,"_30355":2134,"_21010":56372,"_5":14420,"_27589":56100,"_2954":56373},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3471":2235,"_30355":2134,"_21010":56375,"_5":14420,"_27589":56100,"_2954":56376},[],"A verifier rejects the CRL because of the issuer.",{"_3471":2236,"_30355":2134,"_21010":56378,"_5":14420,"_27589":56100,"_2954":56379},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3471":2237,"_30355":2134,"_21010":56381,"_5":14420,"_27589":56100,"_2954":56382},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3471":2238,"_30355":2134,"_21010":56384,"_5":14420,"_27589":56104,"_2954":56385},[],"A CA’s CRL settings are edited in the **Validation Authority** tab of the CA view and on the console’s **Verification Authorities** page. Both read and update them by CA ID at `/v1/crl-settings/{ca-id}`, which requires a 4.0.0 backend.",{"_3471":2239,"_30355":2134,"_21010":56387,"_5":14420,"_27589":56104,"_2954":56388},[],"If the backend has no settings for a CA yet, the tab shows a **No CRL Settings** panel stating that CRL settings are created when the CA is and may still be initializing, with a **Retry** button. While the settings load, it shows &#x2A;*Loading CRL Settings...**; a failed fetch shows **Error Loading CRL Settings**, also with a **Retry** button. The 404 row of Common CRL settings errors lists when a CA can have no settings.",{"_3471":2240,"_30355":2134,"_21010":56390,"_5":14420,"_27589":56104,"_2954":56391},[],"Settings whose CA was deleted before the 4.0.0 upgrade are `ARCHIVED`: the interface shows them read-only inside a warning alert, and the Verification Authorities page marks the CA with an **Archived** badge. Their last CRL is still served but never regenerated, and the settings cannot be edited — see Cases in which the settings can no longer be edited. Settings migrated from the SKI-keyed model show a note with their legacy CRL URL `/crl/<legacy-ski>`, which still resolves to this CA’s list.",{"_3471":2241,"_30355":2134,"_21010":56393,"_5":14420,"_27589":56104,"_2954":56394},[],"The **CRL Refresh Interval** field accepts `0`. An info alert then explains that no new CRL is generated just because time has passed — one is only generated shortly before the current one expires — and, with **Regenerate CRL Immediately on Revocation** off, that revocations are not published until then. The Verification Authorities summary shows **Disabled** for a refresh interval of `0`; the semantics are described in Periodic and automatic regeneration. The **CRL Max Validity / Cache Duration** field still requires a positive duration and rejects `0`.",{"_3471":2242,"_30355":2134,"_21010":56396,"_5":14420,"_27589":56104,"_2954":56397},[],"Editing is forgiving: a field shows its error only after you leave it. **Save CRL Settings** is always clickable; if any field is invalid when you save, the interface marks all of them, shows the errors and focuses the first invalid field instead of keeping the button disabled.",{"_3471":2243,"_30355":2134,"_21010":56399,"_5":14420,"_27589":56104,"_2954":56400},[],"The selected signer appears as a card with its issuer (the full DN in a tooltip on hover and keyboard focus, and the issuer name links to its CA when its record is available), its expiry, key algorithm, usage chips and serial number, under the footer **CRL signer — Signs the CRLs of this CA**. The certificate picker only offers certificates that have a private key and carry the `cRLSign` key usage. If a configured signer’s certificate cannot be resolved, the interface shows `Unknown Certificate (Serial: X)` or `Certificate details unavailable (Serial: X)`.",{"_3471":2244,"_30355":2134,"_21010":56402,"_5":14420,"_27589":56104,"_2954":56403},[],"The CA view lets you inspect and download the available list; the downloaded file is named `<ca-id>.crl`. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_3471":2245,"_30355":2134,"_21010":56405,"_5":14420,"_27589":56108,"_2954":56406},[],"RFC 5280: X.509 and CRL profile.",{"_3471":2246,"_30355":2134,"_21010":56408,"_5":14420,"_27589":56108,"_2954":56409},[],"OpenSSL: openssl-crl.",{"_3471":2247,"_30355":2134,"_21010":56411,"_5":14420,"_27589":56108,"_2954":56412},[],"OpenSSL: openssl-verify.",{"_3471":2248,"_30355":2134,"_21010":56414,"_5":14420,"_27589":56108,"_2954":56415},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3471":2249,"_30355":2134,"_21010":56417,"_5":14420,"_27589":56108,"_2954":56418},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3471":2250,"_30355":2250,"_5":14772,"_2954":56420,"_30687":56421,"_21010":56422,"_27589":2250},"Keys and cryptographic engines",[49421,50896,54901,54902],[],{"_3471":2251,"_30355":2250,"_21010":56424,"_5":14420,"_27589":2250,"_2954":56425},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3471":2252,"_30355":2250,"_5":30684,"_21010":56427,"_27589":56428,"_2954":56429},[],"/docs/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3471":2253,"_30355":2250,"_5":30684,"_21010":56431,"_27589":56432,"_2954":56433},[],"/docs/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3471":2254,"_30355":2250,"_5":30684,"_21010":56435,"_27589":56436,"_2954":56437},[],"/docs/platform/pki/key-management#file-system","File System",{"_3471":2255,"_30355":2250,"_5":30684,"_21010":56439,"_27589":56440,"_2954":56441},[],"/docs/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3471":2256,"_30355":2250,"_5":30684,"_21010":56443,"_27589":56444,"_2954":56445},[],"/docs/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3471":2257,"_30355":2250,"_5":30684,"_21010":56447,"_27589":56448,"_2954":56449},[],"/docs/platform/pki/key-management#aws-kms","AWS KMS",{"_3471":2258,"_30355":2250,"_5":30684,"_21010":56451,"_27589":56452,"_2954":56453},[],"/docs/platform/pki/key-management#pkcs11","PKCS#11",{"_3471":2259,"_30355":2250,"_5":30684,"_21010":56455,"_27589":56456,"_2954":56457},[],"/docs/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3471":2260,"_30355":2250,"_5":30684,"_21010":56459,"_27589":56460,"_2954":56461},[],"/docs/platform/pki/key-management#key-inventory","Key inventory",{"_3471":2261,"_30355":2250,"_5":30684,"_21010":56463,"_27589":56464,"_2954":56465},[],"/docs/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3471":2262,"_30355":2250,"_5":30684,"_21010":56467,"_27589":56468,"_2954":56469},[],"/docs/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3471":2263,"_30355":2250,"_5":30684,"_21010":56471,"_27589":56472,"_2954":56473},[],"/docs/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3471":2264,"_30355":2250,"_5":30684,"_21010":56475,"_27589":56476,"_2954":56477},[],"/docs/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3471":2265,"_30355":2250,"_5":30684,"_21010":56479,"_27589":56480,"_2954":56481},[],"/docs/platform/pki/key-management#view-details","View details",{"_3471":2266,"_30355":2250,"_5":30684,"_21010":56483,"_27589":56484,"_2954":56485},[],"/docs/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3471":2267,"_30355":2250,"_5":30684,"_21010":56487,"_27589":56488,"_2954":56489},[],"/docs/platform/pki/key-management#sign","Sign",{"_3471":2268,"_30355":2250,"_5":30684,"_21010":56491,"_27589":56492,"_2954":56493},[],"/docs/platform/pki/key-management#verify","Verify",{"_3471":2269,"_30355":2250,"_5":30684,"_21010":56495,"_27589":56496,"_2954":56497},[],"/docs/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3471":2270,"_30355":2250,"_5":30684,"_21010":56499,"_27589":56500,"_2954":56501},[],"/docs/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3471":2271,"_30355":2250,"_5":30684,"_21010":56503,"_27589":56504,"_2954":56505},[],"/docs/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3471":2272,"_30355":2250,"_21010":56507,"_5":14420,"_27589":2250,"_2954":56508},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3471":2273,"_30355":2250,"_21010":56510,"_5":14420,"_27589":2250,"_2954":56511},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3471":2274,"_30355":2250,"_21010":56513,"_5":14420,"_27589":56428,"_2954":56514},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3471":2275,"_30355":2250,"_21010":56516,"_5":14420,"_27589":56428,"_2954":56517},[],"In practice, it lets you:",{"_3471":2276,"_30355":2250,"_21010":56519,"_5":14420,"_27589":56428,"_2954":56520},[],"Generate new key pairs from Lamassu IoT.",{"_3471":2277,"_30355":2250,"_21010":56522,"_5":14420,"_27589":56428,"_2954":56523},[],"Import keys created externally.",{"_3471":2278,"_30355":2250,"_21010":56525,"_5":14420,"_27589":56428,"_2954":56526},[],"Delegate custody and cryptographic operations to external engines.",{"_3471":2279,"_30355":2250,"_21010":56528,"_5":14420,"_27589":56428,"_2954":56529},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3471":2280,"_30355":2250,"_21010":56531,"_5":14420,"_27589":56432,"_2954":56532},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3471":2281,"_30355":2250,"_21010":56534,"_5":14420,"_27589":56432,"_2954":56535},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3471":2282,"_30355":2250,"_21010":56537,"_5":14420,"_27589":56432,"_2954":56538},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3471":2283,"_30355":2250,"_21010":56540,"_5":14420,"_27589":56436,"_2954":56541},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3471":2284,"_30355":2250,"_21010":56543,"_5":14420,"_27589":56440,"_2954":56544},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3471":2285,"_30355":2250,"_21010":56546,"_5":14420,"_27589":56440,"_2954":56547},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3471":2286,"_30355":2250,"_21010":56549,"_5":14420,"_27589":56444,"_2954":56550},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3471":2287,"_30355":2250,"_21010":56552,"_5":14420,"_27589":56448,"_2954":56553},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3471":2288,"_30355":2250,"_21010":56555,"_5":14420,"_27589":56452,"_2954":56556},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3471":2289,"_30355":2250,"_21010":56558,"_5":14420,"_27589":56456,"_2954":56559},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3471":2290,"_30355":2250,"_21010":56561,"_5":14420,"_27589":56456,"_2954":56562},[],"Lamassu shows the enabled engines in the console.",{"_3471":2291,"_30355":2250,"_21010":56564,"_5":14420,"_27589":56456,"_2954":56565},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3471":2292,"_30355":2250,"_21010":56567,"_5":14420,"_27589":56456,"_2954":56568},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3471":2293,"_30355":2250,"_21010":56570,"_5":14420,"_27589":56460,"_2954":56571},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3471":2294,"_30355":2250,"_21010":56573,"_5":14420,"_27589":56460,"_2954":56574},[],"The table includes the following fields:",{"_3471":2295,"_30355":2250,"_21010":56576,"_5":14420,"_27589":56460,"_2954":56577},[],"**Name**: descriptive name of the key.",{"_3471":2296,"_30355":2250,"_21010":56579,"_5":14420,"_27589":56460,"_2954":56580},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3471":2297,"_30355":2250,"_21010":56582,"_5":14420,"_27589":56460,"_2954":56583},[],"**Strength**: visual indicator of cryptographic strength.",{"_3471":2298,"_30355":2250,"_21010":56585,"_5":14420,"_27589":56460,"_2954":56586},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3471":2299,"_30355":2250,"_21010":56588,"_5":14420,"_27589":56460,"_2954":56589},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3471":2300,"_30355":2250,"_21010":56591,"_5":14420,"_27589":56460,"_2954":56592},[],"**Aliases**: alternative names associated with the key.",{"_3471":2301,"_30355":2250,"_21010":56594,"_5":14420,"_27589":56460,"_2954":56595},[],"**Tags**: labels for classification and search.",{"_3471":2302,"_30355":2250,"_21010":56597,"_5":14420,"_27589":56460,"_2954":56598},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3471":2303,"_30355":2250,"_21010":56600,"_5":14420,"_27589":56460,"_2954":56601},[],"From this view you also reach the most common actions:",{"_3471":2304,"_30355":2250,"_21010":56603,"_5":14420,"_27589":56460,"_2954":56604},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3471":2305,"_30355":2250,"_21010":56606,"_5":14420,"_27589":56460,"_2954":56607},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3471":2306,"_30355":2250,"_21010":56609,"_5":14420,"_27589":56460,"_2954":56610},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3471":2307,"_30355":2250,"_21010":56612,"_5":14420,"_27589":56460,"_2954":56613},[],"**Delete Key** to remove the key from the system.",{"_3471":2308,"_30355":2250,"_21010":56615,"_5":14420,"_27589":56464,"_2954":56616},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3471":2309,"_30355":2250,"_21010":56618,"_5":14420,"_27589":56468,"_2954":56619},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3471":2310,"_30355":2250,"_21010":56621,"_5":14420,"_27589":56468,"_2954":56622},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3471":2311,"_30355":2250,"_21010":56624,"_5":14420,"_27589":56468,"_2954":56625},[],"**Key Name**: unique and descriptive name.",{"_3471":2312,"_30355":2250,"_21010":56627,"_5":14420,"_27589":56468,"_2954":56628},[],"**Crypto Engine**: engine that will keep the key.",{"_3471":2313,"_30355":2250,"_21010":56630,"_5":14420,"_27589":56468,"_2954":56631},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3471":2314,"_30355":2250,"_21010":56633,"_5":14420,"_27589":56468,"_2954":56634},[],"**Tags**: metadata to classify the key.",{"_3471":2315,"_30355":2250,"_21010":56636,"_5":14420,"_27589":56468,"_2954":56637},[],"**Metadata**: additional information for advanced uses.",{"_3471":2316,"_30355":2250,"_21010":56639,"_5":14420,"_27589":56472,"_2954":56640},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3471":2317,"_30355":2250,"_21010":56642,"_5":14420,"_27589":56472,"_2954":56643},[],"When you have an exportable private key and the destination engine supports import.",{"_3471":2318,"_30355":2250,"_21010":56645,"_5":14420,"_27589":56472,"_2954":56646},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3471":2319,"_30355":2250,"_21010":56648,"_5":14420,"_27589":56472,"_2954":56649},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3471":2320,"_30355":2250,"_21010":56651,"_5":14420,"_27589":56472,"_2954":56652},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3471":2321,"_30355":2250,"_21010":56654,"_5":14420,"_27589":56472,"_2954":56655},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3471":2322,"_30355":2250,"_21010":56657,"_5":14420,"_27589":56472,"_2954":56658},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3471":2323,"_30355":2250,"_21010":56660,"_5":14420,"_27589":56472,"_2954":56661},[],"**Tags**: labels for organization and search.",{"_3471":2324,"_30355":2250,"_21010":56663,"_5":14420,"_27589":56472,"_2954":56664},[],"**Metadata**: additional optional information.",{"_3471":2325,"_30355":2250,"_21010":56666,"_5":14420,"_27589":56472,"_2954":56667},[],"**Private Key (PEM)**: private key in PEM format.",{"_3471":2326,"_30355":2250,"_21010":56669,"_5":14420,"_27589":56472,"_2954":56670},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3471":2327,"_30355":2250,"_21010":56672,"_5":14420,"_27589":56476,"_2954":56673},[],"Each registered key has a detail view and several operational actions.",{"_3471":2328,"_30355":2250,"_21010":56675,"_5":14420,"_27589":56480,"_2954":56676},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3471":2329,"_30355":2250,"_21010":56678,"_5":14420,"_27589":56480,"_2954":56679},[],"The **Overview** tab shows, among others, these fields:",{"_3471":2330,"_30355":2250,"_21010":56681,"_5":14420,"_27589":56480,"_2954":56682},[],"**Key Name**: descriptive name.",{"_3471":2331,"_30355":2250,"_21010":56684,"_5":14420,"_27589":56480,"_2954":56685},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3471":2332,"_30355":2250,"_21010":56687,"_5":14420,"_27589":56480,"_2954":56688},[],"**Tags**: associated labels.",{"_3471":2333,"_30355":2250,"_21010":56690,"_5":14420,"_27589":56480,"_2954":56691},[],"**Aliases**: alternative names.",{"_3471":2334,"_30355":2250,"_21010":56693,"_5":14420,"_27589":56480,"_2954":56694},[],"**Crypto Engine**: engine where the key resides.",{"_3471":2335,"_30355":2250,"_21010":56696,"_5":14420,"_27589":56480,"_2954":56697},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3471":2336,"_30355":2250,"_21010":56699,"_5":14420,"_27589":56480,"_2954":56700},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3471":2337,"_30355":2250,"_21010":56702,"_5":14420,"_27589":56480,"_2954":56703},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3471":2338,"_30355":2250,"_21010":56705,"_5":14420,"_27589":56484,"_2954":56706},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3471":2339,"_30355":2250,"_21010":56708,"_5":14420,"_27589":56484,"_2954":56709},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3471":2340,"_30355":2250,"_21010":56711,"_5":14420,"_27589":56484,"_2954":56712},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3471":2341,"_30355":2250,"_21010":56714,"_5":14420,"_27589":56488,"_2954":56715},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3471":2342,"_30355":2250,"_21010":56717,"_5":14420,"_27589":56488,"_2954":56718},[],"Main fields:",{"_3471":2343,"_30355":2250,"_21010":56720,"_5":14420,"_27589":56488,"_2954":56721},[],"**Algorithm**: signing algorithm available for the key type.",{"_3471":2344,"_30355":2250,"_21010":56723,"_5":14420,"_27589":56488,"_2954":56724},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3471":2345,"_30355":2250,"_21010":56726,"_5":14420,"_27589":56488,"_2954":56727},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3471":2346,"_30355":2250,"_21010":56729,"_5":14420,"_27589":56488,"_2954":56730},[],"**Message**: content to sign.",{"_3471":2347,"_30355":2250,"_21010":56732,"_5":14420,"_27589":56488,"_2954":56733},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3471":2348,"_30355":2250,"_21010":56735,"_5":14420,"_27589":56492,"_2954":56736},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3471":2349,"_30355":2250,"_21010":56738,"_5":14420,"_27589":56492,"_2954":56718},[],{"_3471":2350,"_30355":2250,"_21010":56740,"_5":14420,"_27589":56492,"_2954":56741},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3471":2351,"_30355":2250,"_21010":56743,"_5":14420,"_27589":56492,"_2954":56744},[],"**Message Type**: `Raw` or `Digest`.",{"_3471":2352,"_30355":2250,"_21010":56746,"_5":14420,"_27589":56492,"_2954":56747},[],"**Payload Encoding**: encoding of the message.",{"_3471":2353,"_30355":2250,"_21010":56749,"_5":14420,"_27589":56492,"_2954":56750},[],"**Message**: original message or hash.",{"_3471":2354,"_30355":2250,"_21010":56752,"_5":14420,"_27589":56492,"_2954":56753},[],"**Signature**: signature to check.",{"_3471":2355,"_30355":2250,"_21010":56755,"_5":14420,"_27589":56492,"_2954":56756},[],"**Result**: indicator of the validation result.",{"_3471":2356,"_30355":2250,"_21010":56758,"_5":14420,"_27589":56496,"_2954":56759},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3471":2357,"_30355":2250,"_21010":56761,"_5":14420,"_27589":56496,"_2954":56762},[],"This flow is useful for:",{"_3471":2358,"_30355":2250,"_21010":56764,"_5":14420,"_27589":56496,"_2954":56765},[],"Requesting certificates from an external CA.",{"_3471":2359,"_30355":2250,"_21010":56767,"_5":14420,"_27589":56496,"_2954":56768},[],"Renewing an identity while keeping the same key.",{"_3471":2360,"_30355":2250,"_21010":56770,"_5":14420,"_27589":56496,"_2954":56771},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3471":2361,"_30355":2250,"_21010":56773,"_5":14420,"_27589":56496,"_2954":56774},[],"**Common Name (CN)**: main name of the identity.",{"_3471":2362,"_30355":2250,"_21010":56776,"_5":14420,"_27589":56496,"_2954":56777},[],"**Organization (O)**: organization or company.",{"_3471":2363,"_30355":2250,"_21010":56779,"_5":14420,"_27589":56496,"_2954":56780},[],"**Organizational Unit (OU)**: department or unit.",{"_3471":2364,"_30355":2250,"_21010":56782,"_5":14420,"_27589":56496,"_2954":56783},[],"**Country (C)**: two-letter country code.",{"_3471":2365,"_30355":2250,"_21010":56785,"_5":14420,"_27589":56496,"_2954":56786},[],"**State / Province (ST)**: state or province.",{"_3471":2366,"_30355":2250,"_21010":56788,"_5":14420,"_27589":56496,"_2954":56789},[],"**Locality (L)**: city or locality.",{"_3471":2367,"_30355":2250,"_21010":56791,"_5":14420,"_27589":56496,"_2954":56792},[],"**Email Address**: contact email.",{"_3471":2368,"_30355":2250,"_21010":56794,"_5":14420,"_27589":56496,"_2954":56795},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3471":2369,"_30355":2250,"_21010":56797,"_5":14420,"_27589":56496,"_2954":56798},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3471":2370,"_30355":2250,"_21010":56800,"_5":14420,"_27589":56500,"_2954":56801},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3471":2371,"_30355":2250,"_21010":56803,"_5":14420,"_27589":56500,"_2954":56804},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3471":2372,"_30355":2250,"_21010":56806,"_5":14420,"_27589":56504,"_2954":56807},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3471":2373,"_30355":2250,"_21010":56809,"_5":14420,"_27589":56504,"_2954":56810},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3471":2374,"_30355":2374,"_5":14772,"_2954":56812,"_30687":56813,"_21010":56814,"_27589":2374},"Online validation with OCSP",[49421,50896,54901,55540],[],{"_3471":2375,"_30355":2374,"_21010":56816,"_5":14420,"_27589":2374,"_2954":56817},[],"Query signed status and verify the responder’s response.",{"_3471":2376,"_30355":2374,"_5":30684,"_21010":56819,"_27589":56820,"_2954":56821},[],"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3471":2377,"_30355":2374,"_5":30684,"_21010":56823,"_27589":56824,"_2954":56825},[],"/docs/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3471":2378,"_30355":2374,"_5":30684,"_21010":56827,"_27589":56828,"_2954":56829},[],"/docs/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3471":2379,"_30355":2374,"_5":30684,"_21010":56831,"_27589":56832,"_2954":56833},[],"/docs/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3471":2380,"_30355":2374,"_5":30684,"_21010":56835,"_27589":56836,"_2954":56837},[],"/docs/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3471":2381,"_30355":2374,"_5":30684,"_21010":56839,"_27589":56840,"_2954":56109},[],"/docs/platform/pki/ocsp#references",{"_3471":2382,"_30355":2374,"_21010":56842,"_5":14420,"_27589":2374,"_2954":56843},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3471":2383,"_30355":2374,"_21010":56845,"_5":14420,"_27589":56820,"_2954":56846},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3471":2384,"_30355":2374,"_21010":56848,"_5":14420,"_27589":56820,"_2954":56849},[],"Record status",{"_3471":2385,"_30355":2374,"_21010":56851,"_5":14420,"_27589":56820,"_2954":56852},[],"Signed response",{"_3471":2386,"_30355":2374,"_21010":56854,"_5":14420,"_27589":56820,"_2954":54038},[],{"_3471":2387,"_30355":2374,"_21010":56856,"_5":14420,"_27589":56820,"_2954":56857},[],"`Good`.",{"_3471":2388,"_30355":2374,"_21010":56859,"_5":14420,"_27589":56820,"_2954":54055},[],{"_3471":2389,"_30355":2374,"_21010":56861,"_5":14420,"_27589":56820,"_2954":56862},[],"`Revoked`, with revocation reason and timestamp.",{"_3471":2390,"_30355":2374,"_21010":56864,"_5":14420,"_27589":56820,"_2954":56865},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3471":2391,"_30355":2374,"_21010":56867,"_5":14420,"_27589":56820,"_2954":56868},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3471":2392,"_30355":2374,"_21010":56870,"_5":14420,"_27589":56820,"_2954":56871},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3471":2393,"_30355":2374,"_21010":56873,"_5":14420,"_27589":56820,"_2954":56874},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3471":2394,"_30355":2374,"_21010":56876,"_5":14420,"_27589":56820,"_2954":56877},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3471":2395,"_30355":2374,"_21010":56879,"_5":14420,"_27589":56824,"_2954":56880},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3471":2396,"_30355":2374,"_21010":56882,"_5":14420,"_27589":56824,"_2954":56883},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3471":2397,"_30355":2374,"_21010":56885,"_5":14420,"_27589":56828,"_2954":56886},[],"The service accepts:",{"_3471":2398,"_30355":2374,"_21010":56888,"_5":14420,"_27589":56828,"_2954":52666},[],{"_3471":2399,"_30355":2374,"_21010":56890,"_5":14420,"_27589":56828,"_2954":56891},[],"VA service path",{"_3471":2400,"_30355":2374,"_21010":56893,"_5":14420,"_27589":56828,"_2954":56894},[],"Format",{"_3471":2401,"_30355":2374,"_21010":56896,"_5":14420,"_27589":56828,"_2954":56897},[],"`POST`",{"_3471":2402,"_30355":2374,"_21010":56899,"_5":14420,"_27589":56828,"_2954":56900},[],"`/ocsp`",{"_3471":2403,"_30355":2374,"_21010":56902,"_5":14420,"_27589":56828,"_2954":56903},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3471":2404,"_30355":2374,"_21010":56905,"_5":14420,"_27589":56828,"_2954":56291},[],{"_3471":2405,"_30355":2374,"_21010":56907,"_5":14420,"_27589":56828,"_2954":56908},[],"`/ocsp/{ocsp_request}`",{"_3471":2406,"_30355":2374,"_21010":56910,"_5":14420,"_27589":56828,"_2954":56911},[],"DER request encoded using padded URL Base64.",{"_3471":2407,"_30355":2374,"_21010":56913,"_5":14420,"_27589":56828,"_2954":56914},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3471":2408,"_30355":2374,"_21010":56916,"_5":14420,"_27589":56832,"_2954":56917},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3471":2409,"_30355":2374,"_21010":56919,"_5":14420,"_27589":56832,"_2954":56920},[],"Generate the request:",{"_3471":2410,"_30355":2374,"_21010":56922,"_5":14420,"_27589":56832,"_2954":56923},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3471":2411,"_30355":2374,"_21010":56925,"_5":14420,"_27589":56832,"_2954":56926},[],"Replace the example URL with the inspected endpoint:",{"_3471":2412,"_30355":2374,"_21010":56928,"_5":14420,"_27589":56832,"_2954":56929},[],"Verify the returned DER:",{"_3471":2413,"_30355":2374,"_21010":56931,"_5":14420,"_27589":56832,"_2954":56932},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3471":2414,"_30355":2374,"_21010":56934,"_5":14420,"_27589":56836,"_2954":56935},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3471":2415,"_30355":2374,"_21010":56937,"_5":14420,"_27589":56836,"_2954":56938},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3471":2416,"_30355":2374,"_21010":56940,"_5":14420,"_27589":56840,"_2954":56941},[],"RFC 6960: OCSP.",{"_3471":2417,"_30355":2374,"_21010":56943,"_5":14420,"_27589":56840,"_2954":56944},[],"OpenSSL: openssl-ocsp.",{"_3471":2418,"_30355":2374,"_21010":56946,"_5":14420,"_27589":56840,"_2954":56947},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3471":2419,"_30355":2374,"_21010":56949,"_5":14420,"_27589":56840,"_2954":56418},[],{"_3471":2420,"_30355":2420,"_5":14772,"_2954":54901,"_30687":56951,"_21010":56952,"_27589":2420},[49421,50896,54901],[],{"_3471":2421,"_30355":2420,"_21010":56954,"_5":14420,"_27589":2420,"_2954":56955},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3471":2422,"_30355":2420,"_5":30684,"_21010":56957,"_27589":56958,"_2954":54213},[],"/docs/platform/pki/overview#start-here",{"_3471":2423,"_30355":2420,"_5":30684,"_21010":56960,"_27589":56961,"_2954":56962},[],"/docs/platform/pki/overview#what-you-need","What you need",{"_3471":2424,"_30355":2420,"_5":30684,"_21010":56964,"_27589":56965,"_2954":54745},[],"/docs/platform/pki/overview#core-capabilities",{"_3471":2425,"_30355":2420,"_5":30684,"_21010":56967,"_27589":56968,"_2954":54749},[],"/docs/platform/pki/overview#build-your-trust-hierarchy",{"_3471":2426,"_30355":2420,"_5":30684,"_21010":56970,"_27589":56971,"_2954":54753},[],"/docs/platform/pki/overview#protect-cryptographic-keys",{"_3471":2427,"_30355":2420,"_5":30684,"_21010":56973,"_27589":56974,"_2954":54757},[],"/docs/platform/pki/overview#issue-and-control-certificates",{"_3471":2428,"_30355":2420,"_5":30684,"_21010":56976,"_27589":56977,"_2954":54765},[],"/docs/platform/pki/overview#publish-validation-status",{"_3471":2429,"_30355":2420,"_5":30684,"_21010":56979,"_27589":56980,"_2954":56981},[],"/docs/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3471":2430,"_30355":2420,"_5":30684,"_21010":56983,"_27589":56984,"_2954":55707},[],"/docs/platform/pki/overview#continue",{"_3471":2431,"_30355":2420,"_21010":56986,"_5":14420,"_27589":2420,"_2954":56987},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3471":2432,"_30355":2420,"_21010":56989,"_5":14420,"_27589":56958,"_2954":56990},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3471":2433,"_30355":2420,"_21010":56992,"_5":14420,"_27589":56958,"_2954":56993},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3471":2434,"_30355":2420,"_21010":56995,"_5":14420,"_27589":56961,"_2954":56996},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3471":2435,"_30355":2420,"_21010":56998,"_5":14420,"_27589":56961,"_2954":56999},[],"An available cryptographic engine to keep the authority's key.",{"_3471":2436,"_30355":2420,"_21010":57001,"_5":14420,"_27589":56961,"_2954":57002},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3471":2437,"_30355":2420,"_21010":57004,"_5":14420,"_27589":56961,"_2954":57005},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3471":2438,"_30355":2420,"_21010":57007,"_5":14420,"_27589":56961,"_2954":57008},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3471":2439,"_30355":2420,"_21010":57010,"_5":14420,"_27589":56968,"_2954":57011},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3471":2440,"_30355":2420,"_21010":57013,"_5":14420,"_27589":56971,"_2954":57014},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3471":2441,"_30355":2420,"_21010":57016,"_5":14420,"_27589":56974,"_2954":57017},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3471":2442,"_30355":2420,"_21010":57019,"_5":14420,"_27589":56977,"_2954":57020},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3471":2443,"_30355":2420,"_21010":57022,"_5":14420,"_27589":56980,"_2954":57023},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3471":2444,"_30355":2420,"_21010":57025,"_5":14420,"_27589":56980,"_2954":57026},[],"its subject and extensions identify the expected client;",{"_3471":2445,"_30355":2420,"_21010":57028,"_5":14420,"_27589":56980,"_2954":57029},[],"its public key matches the client's private key;",{"_3471":2446,"_30355":2420,"_21010":57031,"_5":14420,"_27589":56980,"_2954":57032},[],"its chain reaches a root trusted by the consumer;",{"_3471":2447,"_30355":2420,"_21010":57034,"_5":14420,"_27589":56980,"_2954":57035},[],"its dates and usages allow the operation;",{"_3471":2448,"_30355":2420,"_21010":57037,"_5":14420,"_27589":56980,"_2954":57038},[],"the consumer applies revocation checks and authorization.",{"_3471":2449,"_30355":2420,"_21010":57040,"_5":14420,"_27589":56980,"_2954":57041},[],"The issuance path includes the first independent checks.",{"_3471":2450,"_30355":2420,"_21010":57043,"_5":14420,"_27589":56984,"_2954":57044},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3471":2451,"_30355":2420,"_21010":57046,"_5":14420,"_27589":56984,"_2954":57047},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3471":2452,"_30355":2420,"_21010":57049,"_5":14420,"_27589":56984,"_2954":57050},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3471":2453,"_30355":2453,"_5":14772,"_2954":57052,"_30687":57053,"_21010":57054,"_27589":2453},"Create your first CA",[49421,50896,54901,54338],[],{"_3471":2454,"_30355":2453,"_21010":57056,"_5":14420,"_27589":2453,"_2954":57057},[],"Create an evaluation root and check its certificate before issuing.",{"_3471":2455,"_30355":2453,"_5":30684,"_21010":57059,"_27589":57060,"_2954":49431},[],"/docs/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3471":2456,"_30355":2453,"_5":30684,"_21010":57062,"_27589":57063,"_2954":57064},[],"/docs/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3471":2457,"_30355":2453,"_5":30684,"_21010":57066,"_27589":57067,"_2954":57068},[],"/docs/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3471":2458,"_30355":2453,"_5":30684,"_21010":57070,"_27589":57071,"_2954":57072},[],"/docs/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3471":2459,"_30355":2453,"_5":30684,"_21010":57074,"_27589":57075,"_2954":57076},[],"/docs/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3471":2460,"_30355":2453,"_5":30684,"_21010":57078,"_27589":57079,"_2954":57080},[],"/docs/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3471":2461,"_30355":2453,"_5":30684,"_21010":57082,"_27589":57083,"_2954":57084},[],"/docs/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3471":2462,"_30355":2453,"_5":30684,"_21010":57086,"_27589":57087,"_2954":54595},[],"/docs/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3471":2463,"_30355":2453,"_5":30684,"_21010":57089,"_27589":57090,"_2954":49455},[],"/docs/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3471":2464,"_30355":2453,"_21010":57092,"_5":14420,"_27589":2453,"_2954":57093},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3471":2465,"_30355":2453,"_21010":57095,"_5":14420,"_27589":57060,"_2954":57096},[],"Console access and permission to create keys and authorities.",{"_3471":2466,"_30355":2453,"_21010":57098,"_5":14420,"_27589":57060,"_2954":57099},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3471":2467,"_30355":2453,"_21010":57101,"_5":14420,"_27589":57060,"_2954":57102},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3471":2468,"_30355":2453,"_21010":57104,"_5":14420,"_27589":57060,"_2954":57105},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3471":2469,"_30355":2453,"_21010":57107,"_5":14420,"_27589":57063,"_2954":57108},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3471":2470,"_30355":2453,"_21010":57110,"_5":14420,"_27589":57063,"_2954":57111},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3471":2471,"_30355":2453,"_21010":57113,"_5":14420,"_27589":57067,"_2954":57114},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3471":2472,"_30355":2453,"_21010":57116,"_5":14420,"_27589":57067,"_2954":57117},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3471":2473,"_30355":2453,"_21010":57119,"_5":14420,"_27589":57071,"_2954":57120},[],"Select **Root CA** and complete:",{"_3471":2474,"_30355":2453,"_21010":57122,"_5":14420,"_27589":57071,"_2954":57123},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3471":2475,"_30355":2453,"_21010":57125,"_5":14420,"_27589":57071,"_2954":57126},[],"**Subject**: organization and country details for your evaluation.",{"_3471":2476,"_30355":2453,"_21010":57128,"_5":14420,"_27589":57071,"_2954":57129},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3471":2477,"_30355":2453,"_21010":57131,"_5":14420,"_27589":57071,"_2954":57132},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3471":2478,"_30355":2453,"_21010":57134,"_5":14420,"_27589":57071,"_2954":57135},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3471":2479,"_30355":2453,"_21010":57137,"_5":14420,"_27589":57075,"_2954":57138},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3471":2480,"_30355":2453,"_21010":57140,"_5":14420,"_27589":57079,"_2954":57141},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3471":2481,"_30355":2453,"_21010":57143,"_5":14420,"_27589":57079,"_2954":57144},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3471":2482,"_30355":2453,"_21010":57146,"_5":14420,"_27589":57083,"_2954":57147},[],"Run from the directory where you saved `ca.pem`:",{"_3471":2483,"_30355":2453,"_21010":57149,"_5":14420,"_27589":57083,"_2954":57150},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3471":2484,"_30355":2453,"_21010":57152,"_5":14420,"_27589":57083,"_2954":57153},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3471":2485,"_30355":2453,"_21010":57155,"_5":14420,"_27589":57087,"_2954":57156},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3471":2486,"_30355":2453,"_21010":57158,"_5":14420,"_27589":57087,"_2954":57159},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3471":2487,"_30355":2453,"_21010":57161,"_5":14420,"_27589":57087,"_2954":57162},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3471":2488,"_30355":2453,"_21010":57164,"_5":14420,"_27589":57087,"_2954":57165},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3471":2489,"_30355":2453,"_21010":57167,"_5":14420,"_27589":57090,"_2954":57168},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3471":2490,"_30355":2490,"_5":14772,"_2954":57170,"_30687":57171,"_21010":57172,"_27589":2490},"Issue and verify a certificate",[49421,50896,54901,54338],[],{"_3471":2491,"_30355":2490,"_21010":57174,"_5":14420,"_27589":2490,"_2954":57175},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3471":2492,"_30355":2490,"_5":30684,"_21010":57177,"_27589":57178,"_2954":49431},[],"/docs/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3471":2493,"_30355":2490,"_5":30684,"_21010":57180,"_27589":57181,"_2954":57182},[],"/docs/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3471":2494,"_30355":2490,"_5":30684,"_21010":57184,"_27589":57185,"_2954":57186},[],"/docs/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3471":2495,"_30355":2490,"_5":30684,"_21010":57188,"_27589":57189,"_2954":57190},[],"/docs/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3471":2496,"_30355":2490,"_5":30684,"_21010":57192,"_27589":57193,"_2954":57194},[],"/docs/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3471":2497,"_30355":2490,"_5":30684,"_21010":57196,"_27589":57197,"_2954":57198},[],"/docs/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3471":2498,"_30355":2490,"_5":30684,"_21010":57200,"_27589":57201,"_2954":57202},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3471":2499,"_30355":2490,"_5":30684,"_21010":57204,"_27589":57205,"_2954":57206},[],"/docs/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3471":2500,"_30355":2490,"_5":30684,"_21010":57208,"_27589":57209,"_2954":57210},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3471":2501,"_30355":2490,"_5":30684,"_21010":57212,"_27589":57213,"_2954":57214},[],"/docs/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3471":2502,"_30355":2490,"_5":30684,"_21010":57216,"_27589":57217,"_2954":54595},[],"/docs/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3471":2503,"_30355":2490,"_5":30684,"_21010":57219,"_27589":57220,"_2954":49455},[],"/docs/platform/pki/quickstarts/issue-certificate#next-step",{"_3471":2504,"_30355":2490,"_21010":57222,"_5":14420,"_27589":2490,"_2954":57223},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3471":2505,"_30355":2490,"_21010":57225,"_5":14420,"_27589":57178,"_2954":57226},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3471":2506,"_30355":2490,"_21010":57228,"_5":14420,"_27589":57178,"_2954":57229},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3471":2507,"_30355":2490,"_21010":57231,"_5":14420,"_27589":57178,"_2954":57232},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3471":2508,"_30355":2490,"_21010":57234,"_5":14420,"_27589":57178,"_2954":57235},[],"A client identifier: here we use `device-001`.",{"_3471":2509,"_30355":2490,"_21010":57237,"_5":14420,"_27589":57178,"_2954":57238},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3471":2510,"_30355":2490,"_21010":57240,"_5":14420,"_27589":57181,"_2954":57241},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3471":2511,"_30355":2490,"_21010":57243,"_5":14420,"_27589":57185,"_2954":57244},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3471":2512,"_30355":2490,"_21010":57246,"_5":14420,"_27589":57185,"_2954":57247},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3471":2513,"_30355":2490,"_21010":57249,"_5":14420,"_27589":57189,"_2954":57250},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3471":2514,"_30355":2490,"_21010":57252,"_5":14420,"_27589":57189,"_2954":57253},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3471":2515,"_30355":2490,"_21010":57255,"_5":14420,"_27589":57193,"_2954":57256},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3471":2516,"_30355":2490,"_21010":57258,"_5":14420,"_27589":57193,"_2954":57259},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3471":2517,"_30355":2490,"_21010":57261,"_5":14420,"_27589":57197,"_2954":57262},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3471":2518,"_30355":2490,"_21010":57264,"_5":14420,"_27589":57201,"_2954":57265},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3471":2519,"_30355":2490,"_21010":57267,"_5":14420,"_27589":57205,"_2954":57268},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3471":2520,"_30355":2490,"_21010":57270,"_5":14420,"_27589":57209,"_2954":57271},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3471":2521,"_30355":2490,"_21010":57273,"_5":14420,"_27589":57209,"_2954":57274},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3471":2522,"_30355":2490,"_21010":57276,"_5":14420,"_27589":57209,"_2954":57277},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3471":2523,"_30355":2490,"_21010":57279,"_5":14420,"_27589":57213,"_2954":57280},[],"In Bash, compare the two public-key digests:",{"_3471":2524,"_30355":2490,"_21010":57282,"_5":14420,"_27589":57213,"_2954":57283},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3471":2525,"_30355":2490,"_21010":57285,"_5":14420,"_27589":57213,"_2954":57286},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3471":2526,"_30355":2490,"_21010":57288,"_5":14420,"_27589":57217,"_2954":54679},[],{"_3471":2527,"_30355":2490,"_21010":57290,"_5":14420,"_27589":57217,"_2954":57291},[],"What to review",{"_3471":2528,"_30355":2490,"_21010":57293,"_5":14420,"_27589":57217,"_2954":57294},[],"The CA rejects issuance",{"_3471":2529,"_30355":2490,"_21010":57296,"_5":14420,"_27589":57217,"_2954":57297},[],"Permissions, CA state and key, algorithm and profile.",{"_3471":2530,"_30355":2490,"_21010":57299,"_5":14420,"_27589":57217,"_2954":57300},[],"Different subject or usages",{"_3471":2531,"_30355":2490,"_21010":57302,"_5":14420,"_27589":57217,"_2954":57303},[],"Applied profile and requested values.",{"_3471":2532,"_30355":2490,"_21010":57305,"_5":14420,"_27589":57217,"_2954":57306},[],"Issuer cannot be found",{"_3471":2533,"_30355":2490,"_21010":57308,"_5":14420,"_27589":57217,"_2954":57309},[],"Downloaded CA and required intermediate chain.",{"_3471":2534,"_30355":2490,"_21010":57311,"_5":14420,"_27589":57217,"_2954":57312},[],"Validity fails",{"_3471":2535,"_30355":2490,"_21010":57314,"_5":14420,"_27589":57217,"_2954":57315},[],"Certificate and CA dates, and the computer's clock.",{"_3471":2536,"_30355":2490,"_21010":57317,"_5":14420,"_27589":57217,"_2954":57318},[],"Public-key digests differ",{"_3471":2537,"_30355":2490,"_21010":57320,"_5":14420,"_27589":57217,"_2954":57321},[],"Certificate and key files from the same issuance.",{"_3471":2538,"_30355":2490,"_21010":57323,"_5":14420,"_27589":57217,"_2954":57324},[],"See PKI diagnostics to narrow an issuance failure.",{"_3471":2539,"_30355":2490,"_21010":57326,"_5":14420,"_27589":57220,"_2954":57327},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3471":2540,"_30355":2490,"_21010":57329,"_5":14420,"_27589":57220,"_2954":57330},[],"Manage certificates for inspection, status and revocation.",{"_3471":2541,"_30355":2490,"_21010":57332,"_5":14420,"_27589":57220,"_2954":57333},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3471":2542,"_30355":2490,"_21010":57335,"_5":14420,"_27589":57220,"_2954":57336},[],"Prepare EST for the device to request its next identities.",{"_3471":2543,"_30355":2490,"_21010":57338,"_5":14420,"_27589":57220,"_2954":57339},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3471":2544,"_30355":2544,"_5":14772,"_2954":57341,"_30687":57342,"_21010":57343,"_27589":2544},"PKI getting started",[49421,50896,54901,54338],[],{"_3471":2545,"_30355":2544,"_21010":57345,"_5":14420,"_27589":2544,"_2954":57346},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3471":2546,"_30355":2544,"_5":30684,"_21010":57348,"_27589":57349,"_2954":49431},[],"/docs/platform/pki/quickstarts/overview#before-you-begin",{"_3471":2547,"_30355":2544,"_5":30684,"_21010":57351,"_27589":57352,"_2954":57353},[],"/docs/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3471":2548,"_30355":2544,"_5":30684,"_21010":57355,"_27589":57356,"_2954":54530},[],"/docs/platform/pki/quickstarts/overview#expected-result",{"_3471":2549,"_30355":2544,"_5":30684,"_21010":57358,"_27589":57359,"_2954":57360},[],"/docs/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3471":2550,"_30355":2544,"_21010":57362,"_5":14420,"_27589":2544,"_2954":57363},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3471":2551,"_30355":2544,"_21010":57365,"_5":14420,"_27589":57349,"_2954":57366},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3471":2552,"_30355":2544,"_21010":57368,"_5":14420,"_27589":57349,"_2954":57369},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3471":2553,"_30355":2544,"_21010":57371,"_5":14420,"_27589":57349,"_2954":57372},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3471":2554,"_30355":2544,"_21010":57374,"_5":14420,"_27589":57349,"_2954":57375},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3471":2555,"_30355":2544,"_21010":57377,"_5":14420,"_27589":57349,"_2954":57378},[],"A working directory with restricted access for the downloaded key.",{"_3471":2556,"_30355":2544,"_21010":57380,"_5":14420,"_27589":57352,"_2954":57381},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3471":2557,"_30355":2544,"_21010":57383,"_5":14420,"_27589":57352,"_2954":57384},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3471":2558,"_30355":2544,"_21010":57386,"_5":14420,"_27589":57352,"_2954":57387},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3471":2559,"_30355":2544,"_21010":57389,"_5":14420,"_27589":57352,"_2954":57390},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3471":2560,"_30355":2544,"_21010":57392,"_5":14420,"_27589":57356,"_2954":57393},[],"File or resource",{"_3471":2561,"_30355":2544,"_21010":57395,"_5":14420,"_27589":57356,"_2954":54527},[],{"_3471":2562,"_30355":2544,"_21010":57397,"_5":14420,"_27589":57356,"_2954":57398},[],"Active root CA and `ca.pem`",{"_3471":2563,"_30355":2544,"_21010":57400,"_5":14420,"_27589":57356,"_2954":57401},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3471":2564,"_30355":2544,"_21010":57403,"_5":14420,"_27589":57356,"_2954":57404},[],"End-entity certificate and `device.crt`",{"_3471":2565,"_30355":2544,"_21010":57406,"_5":14420,"_27589":57356,"_2954":57407},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3471":2566,"_30355":2544,"_21010":57409,"_5":14420,"_27589":57356,"_2954":57410},[],"Private key `device.key`",{"_3471":2567,"_30355":2544,"_21010":57412,"_5":14420,"_27589":57356,"_2954":57413},[],"Its public key matches the one included in `device.crt`.",{"_3471":2568,"_30355":2544,"_21010":57415,"_5":14420,"_27589":57356,"_2954":57416},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3471":2569,"_30355":2544,"_21010":57418,"_5":14420,"_27589":57359,"_2954":57419},[],"To operate certificates, continue with Certificates and Validation.",{"_3471":2570,"_30355":2544,"_21010":57421,"_5":14420,"_27589":57359,"_2954":57422},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3471":2571,"_30355":2544,"_21010":57424,"_5":14420,"_27589":57359,"_2954":57425},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3471":2572,"_30355":2572,"_5":14772,"_2954":57427,"_30687":57428,"_21010":57429,"_27589":2572},"PKI troubleshooting",[49421,50896,54901,53476],[],{"_3471":2573,"_30355":2572,"_21010":57431,"_5":14420,"_27589":2572,"_2954":57432},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3471":2574,"_30355":2572,"_5":30684,"_21010":57434,"_27589":57435,"_2954":57436},[],"/docs/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3471":2575,"_30355":2572,"_5":30684,"_21010":57438,"_27589":57439,"_2954":57440},[],"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3471":2576,"_30355":2572,"_5":30684,"_21010":57442,"_27589":57443,"_2954":57444},[],"/docs/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3471":2577,"_30355":2572,"_21010":57446,"_5":14420,"_27589":2572,"_2954":57447},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3471":2578,"_30355":2572,"_21010":57449,"_5":14420,"_27589":2572,"_2954":57450},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3471":2579,"_30355":2572,"_21010":57452,"_5":14420,"_27589":57435,"_2954":54527},[],{"_3471":2580,"_30355":2572,"_21010":57454,"_5":14420,"_27589":57435,"_2954":57455},[],"What to inspect",{"_3471":2581,"_30355":2572,"_21010":57457,"_5":14420,"_27589":57435,"_2954":49455},[],{"_3471":2582,"_30355":2572,"_21010":57459,"_5":14420,"_27589":57435,"_2954":53743},[],{"_3471":2583,"_30355":2572,"_21010":57461,"_5":14420,"_27589":57435,"_2954":57462},[],"Exists, is active and has usable dates.",{"_3471":2584,"_30355":2572,"_21010":57464,"_5":14420,"_27589":57435,"_2954":57465},[],"Authorities.",{"_3471":2585,"_30355":2572,"_21010":57467,"_5":14420,"_27589":57435,"_2954":57468},[],"Key",{"_3471":2586,"_30355":2572,"_21010":57470,"_5":14420,"_27589":57435,"_2954":57471},[],"The record has a usable private key and the engine can sign.",{"_3471":2587,"_30355":2572,"_21010":57473,"_5":14420,"_27589":57435,"_2954":57474},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3471":2588,"_30355":2572,"_21010":57476,"_5":14420,"_27589":57435,"_2954":57477},[],"CSR",{"_3471":2589,"_30355":2572,"_21010":57479,"_5":14420,"_27589":57435,"_2954":57480},[],"Correct PEM and verifiable signature.",{"_3471":2590,"_30355":2572,"_21010":57482,"_5":14420,"_27589":57435,"_2954":57483},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3471":2591,"_30355":2572,"_21010":57485,"_5":14420,"_27589":57435,"_2954":57486},[],"Profile",{"_3471":2592,"_30355":2572,"_21010":57488,"_5":14420,"_27589":57435,"_2954":57489},[],"Selected source, existing ID, allowed algorithm and size.",{"_3471":2593,"_30355":2572,"_21010":57491,"_5":14420,"_27589":57435,"_2954":57492},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3471":2594,"_30355":2572,"_21010":57494,"_5":14420,"_27589":57435,"_2954":54679},[],{"_3471":2595,"_30355":2572,"_21010":57496,"_5":14420,"_27589":57435,"_2954":57497},[],"Appropriate subject, SAN, usages and dates.",{"_3471":2596,"_30355":2572,"_21010":57499,"_5":14420,"_27589":57435,"_2954":57500},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3471":2597,"_30355":2572,"_21010":57502,"_5":14420,"_27589":57435,"_2954":57503},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3471":2598,"_30355":2572,"_21010":57505,"_5":14420,"_27589":57435,"_2954":57506},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3471":2599,"_30355":2572,"_21010":57508,"_5":14420,"_27589":57439,"_2954":57509},[],"Check each boundary independently:",{"_3471":2600,"_30355":2572,"_21010":57511,"_5":14420,"_27589":57439,"_2954":57512},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3471":2601,"_30355":2572,"_21010":57514,"_5":14420,"_27589":57439,"_2954":57515},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3471":2602,"_30355":2572,"_21010":57517,"_5":14420,"_27589":57439,"_2954":57518},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3471":2603,"_30355":2572,"_21010":57520,"_5":14420,"_27589":57439,"_2954":57521},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3471":2604,"_30355":2572,"_21010":57523,"_5":14420,"_27589":57439,"_2954":57524},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3471":2605,"_30355":2572,"_21010":57526,"_5":14420,"_27589":57439,"_2954":57527},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3471":2606,"_30355":2572,"_21010":57529,"_5":14420,"_27589":57443,"_2954":57530},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3471":2607,"_30355":2572,"_21010":57532,"_5":14420,"_27589":57443,"_2954":57533},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3471":2608,"_30355":2608,"_5":14772,"_2954":57535,"_30687":57536,"_21010":57537,"_27589":2608},"Security",[49421],[],{"_3471":2609,"_30355":2608,"_21010":57539,"_5":14420,"_27589":2608,"_2954":57540},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3471":2610,"_30355":2608,"_5":30684,"_21010":57542,"_27589":57543,"_2954":57544},[],"/docs/security#report-a-vulnerability","Report a vulnerability",{"_3471":2611,"_30355":2608,"_5":30684,"_21010":57546,"_27589":57547,"_2954":57548},[],"/docs/security#what-to-include-in-a-report","What to include in a report",{"_3471":2612,"_30355":2608,"_5":30684,"_21010":57550,"_27589":57551,"_2954":57552},[],"/docs/security#supported-versions","Supported versions",{"_3471":2613,"_30355":2608,"_5":30684,"_21010":57554,"_27589":57555,"_2954":57556},[],"/docs/security#responsible-disclosure","Responsible disclosure",{"_3471":2614,"_30355":2608,"_21010":57558,"_5":14420,"_27589":2608,"_2954":57559},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3471":2615,"_30355":2608,"_21010":57561,"_5":14420,"_27589":57543,"_2954":57562},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3471":2616,"_30355":2608,"_21010":57564,"_5":14420,"_27589":57543,"_2954":57565},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3471":2617,"_30355":2608,"_21010":57567,"_5":14420,"_27589":57543,"_2954":15051},[],{"_3471":2618,"_30355":2608,"_21010":57569,"_5":14420,"_27589":57543,"_2954":14991},[],{"_3471":2619,"_30355":2608,"_21010":57571,"_5":14420,"_27589":57543,"_2954":15038},[],{"_3471":2620,"_30355":2608,"_21010":57573,"_5":14420,"_27589":57543,"_2954":57574},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3471":2621,"_30355":2608,"_21010":57576,"_5":14420,"_27589":57543,"_2954":57577},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3471":2622,"_30355":2608,"_21010":57579,"_5":14420,"_27589":57547,"_2954":57580},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3471":2623,"_30355":2608,"_21010":57582,"_5":14420,"_27589":57547,"_2954":57583},[],"Do not include in the report:",{"_3471":2624,"_30355":2608,"_21010":57585,"_5":14420,"_27589":57547,"_2954":57586},[],"Credentials, tokens, or private keys",{"_3471":2625,"_30355":2608,"_21010":57588,"_5":14420,"_27589":57547,"_2954":57589},[],"Customer data or customer-identifiable information",{"_3471":2626,"_30355":2608,"_21010":57591,"_5":14420,"_27589":57547,"_2954":57592},[],"Confidential architecture or internal infrastructure details",{"_3471":2627,"_30355":2608,"_21010":57594,"_5":14420,"_27589":57551,"_2954":57595},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3471":2628,"_30355":2608,"_21010":57597,"_5":14420,"_27589":57551,"_2954":57598},[],"For upgrade guidance, see Upgrades.",{"_3471":2629,"_30355":2608,"_21010":57600,"_5":14420,"_27589":57555,"_2954":57601},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3471":2630,"_30355":2608,"_21010":57603,"_5":14420,"_27589":57555,"_2954":57604},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3471":2631,"_30355":2608,"_21010":57606,"_5":14420,"_27589":57555,"_2954":57607},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3471":2632,"_30355":2608,"_21010":57609,"_5":14420,"_27589":57555,"_2954":57610},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3471":2633,"_30355":2608,"_21010":57612,"_5":14420,"_27589":57555,"_2954":57613},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3471":2634,"_30355":2634,"_5":14772,"_2954":57615,"_30687":57616,"_21010":57618,"_27589":2634},"3.8.0 to 4.0.0",[49421,57617],"Upgrades",[],{"_3471":2635,"_30355":2634,"_21010":57620,"_5":14420,"_27589":2634,"_2954":57621},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3471":2636,"_30355":2634,"_5":30684,"_21010":57623,"_27589":57624,"_2954":57625},[],"/docs/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3471":2637,"_30355":2634,"_5":30684,"_21010":57627,"_27589":57628,"_2954":57629},[],"/docs/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3471":2638,"_30355":2634,"_5":30684,"_21010":57631,"_27589":57632,"_2954":57633},[],"/docs/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3471":2639,"_30355":2634,"_5":30684,"_21010":57635,"_27589":57636,"_2954":57637},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3471":2640,"_30355":2634,"_5":30684,"_21010":57639,"_27589":57640,"_2954":57641},[],"/docs/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3471":2641,"_30355":2634,"_5":30684,"_21010":57643,"_27589":57644,"_2954":57645},[],"/docs/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3471":2642,"_30355":2634,"_5":30684,"_21010":57647,"_27589":57648,"_2954":57649},[],"/docs/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3471":2643,"_30355":2634,"_5":30684,"_21010":57651,"_27589":57652,"_2954":57653},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3471":2644,"_30355":2634,"_5":30684,"_21010":57655,"_27589":57656,"_2954":57657},[],"/docs/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3471":2645,"_30355":2634,"_5":30684,"_21010":57659,"_27589":57660,"_2954":57661},[],"/docs/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3471":2646,"_30355":2634,"_5":30684,"_21010":57663,"_27589":57664,"_2954":57665},[],"/docs/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3471":2647,"_30355":2634,"_5":30684,"_21010":57667,"_27589":57668,"_2954":57669},[],"/docs/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3471":2648,"_30355":2634,"_5":30684,"_21010":57671,"_27589":57672,"_2954":57673},[],"/docs/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3471":2649,"_30355":2634,"_5":30684,"_21010":57675,"_27589":57676,"_2954":57677},[],"/docs/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3471":2650,"_30355":2634,"_5":30684,"_21010":57679,"_27589":57680,"_2954":57681},[],"/docs/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3471":2651,"_30355":2634,"_5":30684,"_21010":57683,"_27589":57684,"_2954":57685},[],"/docs/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3471":2652,"_30355":2634,"_5":30684,"_21010":57687,"_27589":57688,"_2954":57689},[],"/docs/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3471":2653,"_30355":2634,"_5":30684,"_21010":57691,"_27589":57692,"_2954":57693},[],"/docs/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3471":2654,"_30355":2634,"_5":30684,"_21010":57695,"_27589":57696,"_2954":57697},[],"/docs/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3471":2655,"_30355":2634,"_5":30684,"_21010":57699,"_27589":57700,"_2954":57701},[],"/docs/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3471":2656,"_30355":2634,"_5":30684,"_21010":57703,"_27589":57704,"_2954":57705},[],"/docs/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3471":2657,"_30355":2634,"_5":30684,"_21010":57707,"_27589":57708,"_2954":57709},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3471":2658,"_30355":2634,"_5":30684,"_21010":57711,"_27589":57712,"_2954":57713},[],"/docs/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3471":2659,"_30355":2634,"_5":30684,"_21010":57715,"_27589":57716,"_2954":57717},[],"/docs/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3471":2660,"_30355":2634,"_5":30684,"_21010":57719,"_27589":57720,"_2954":57721},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3471":2661,"_30355":2634,"_5":30684,"_21010":57723,"_27589":57724,"_2954":57725},[],"/docs/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3471":2662,"_30355":2634,"_5":30684,"_21010":57727,"_27589":57728,"_2954":57729},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3471":2663,"_30355":2634,"_5":30684,"_21010":57731,"_27589":57732,"_2954":57733},[],"/docs/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3471":2664,"_30355":2634,"_5":30684,"_21010":57735,"_27589":57736,"_2954":57737},[],"/docs/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3471":2665,"_30355":2634,"_5":30684,"_21010":57739,"_27589":57740,"_2954":57741},[],"/docs/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3471":2666,"_30355":2634,"_5":30684,"_21010":57743,"_27589":57744,"_2954":57745},[],"/docs/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3471":2667,"_30355":2634,"_5":30684,"_21010":57747,"_27589":57748,"_2954":57749},[],"/docs/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3471":2668,"_30355":2634,"_5":30684,"_21010":57751,"_27589":57752,"_2954":57753},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3471":2669,"_30355":2634,"_5":30684,"_21010":57755,"_27589":57756,"_2954":57757},[],"/docs/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3471":2670,"_30355":2634,"_5":30684,"_21010":57759,"_27589":57760,"_2954":57761},[],"/docs/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3471":2671,"_30355":2634,"_5":30684,"_21010":57763,"_27589":57764,"_2954":57765},[],"/docs/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3471":2672,"_30355":2634,"_5":30684,"_21010":57767,"_27589":57768,"_2954":57769},[],"/docs/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3471":2673,"_30355":2634,"_5":30684,"_21010":57771,"_27589":57772,"_2954":57773},[],"/docs/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3471":2674,"_30355":2634,"_5":30684,"_21010":57775,"_27589":57776,"_2954":57777},[],"/docs/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3471":2675,"_30355":2634,"_5":30684,"_21010":57779,"_27589":57780,"_2954":57781},[],"/docs/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3471":2676,"_30355":2634,"_5":30684,"_21010":57783,"_27589":57784,"_2954":53476},[],"/docs/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3471":2677,"_30355":2634,"_5":30684,"_21010":57786,"_27589":57787,"_2954":57788},[],"/docs/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3471":2678,"_30355":2634,"_5":30684,"_21010":57790,"_27589":57791,"_2954":57792},[],"/docs/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3471":2679,"_30355":2634,"_21010":57794,"_5":14420,"_27589":2634,"_2954":57795},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3471":2680,"_30355":2634,"_21010":57797,"_5":14420,"_27589":2634,"_2954":57798},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3471":2681,"_30355":2634,"_21010":57800,"_5":14420,"_27589":2634,"_2954":57801},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3471":2682,"_30355":2634,"_21010":57803,"_5":14420,"_27589":2634,"_2954":57804},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3471":2683,"_30355":2634,"_21010":57806,"_5":14420,"_27589":2634,"_2954":57807},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3471":2684,"_30355":2634,"_21010":57809,"_5":14420,"_27589":2634,"_2954":57810},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3471":2685,"_30355":2634,"_21010":57812,"_5":14420,"_27589":2634,"_2954":57813},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3471":2686,"_30355":2634,"_21010":57815,"_5":14420,"_27589":57628,"_2954":57816},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3471":2687,"_30355":2634,"_21010":57818,"_5":14420,"_27589":57628,"_2954":57819},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3471":2688,"_30355":2634,"_21010":57821,"_5":14420,"_27589":57632,"_2954":57822},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3471":2689,"_30355":2634,"_21010":57824,"_5":14420,"_27589":57632,"_2954":57825},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3471":2690,"_30355":2634,"_21010":57827,"_5":14420,"_27589":57636,"_2954":57828},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3471":2691,"_30355":2634,"_21010":57830,"_5":14420,"_27589":57640,"_2954":57831},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3471":2692,"_30355":2634,"_21010":57833,"_5":14420,"_27589":57640,"_2954":57834},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3471":2693,"_30355":2634,"_21010":57836,"_5":14420,"_27589":57640,"_2954":57837},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3471":2694,"_30355":2634,"_21010":57839,"_5":14420,"_27589":57640,"_2954":57840},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3471":2695,"_30355":2634,"_21010":57842,"_5":14420,"_27589":57640,"_2954":57843},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3471":2696,"_30355":2634,"_21010":57845,"_5":14420,"_27589":57644,"_2954":57846},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3471":2697,"_30355":2634,"_21010":57848,"_5":14420,"_27589":57644,"_2954":57849},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3471":2698,"_30355":2634,"_21010":57851,"_5":14420,"_27589":57644,"_2954":57852},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3471":2699,"_30355":2634,"_21010":57854,"_5":14420,"_27589":57644,"_2954":57855},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3471":2700,"_30355":2634,"_21010":57857,"_5":14420,"_27589":57644,"_2954":57858},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3471":2701,"_30355":2634,"_21010":57860,"_5":14420,"_27589":57644,"_2954":57861},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3471":2702,"_30355":2634,"_21010":57863,"_5":14420,"_27589":57648,"_2954":57864},[],"Change",{"_3471":2703,"_30355":2634,"_21010":57866,"_5":14420,"_27589":57648,"_2954":57867},[],"Who is affected",{"_3471":2704,"_30355":2634,"_21010":57869,"_5":14420,"_27589":57648,"_2954":57870},[],"Severity",{"_3471":2705,"_30355":2634,"_21010":57872,"_5":14420,"_27589":57648,"_2954":56328},[],{"_3471":2706,"_30355":2634,"_21010":57874,"_5":14420,"_27589":57648,"_2954":57657},[],{"_3471":2707,"_30355":2634,"_21010":57876,"_5":14420,"_27589":57648,"_2954":57877},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3471":2708,"_30355":2634,"_21010":57879,"_5":14420,"_27589":57648,"_2954":57880},[],"High: KMS and VA start on empty volumes",{"_3471":2709,"_30355":2634,"_21010":57882,"_5":14420,"_27589":57648,"_2954":57883},[],"Copy the data into the new volumes",{"_3471":2710,"_30355":2634,"_21010":57885,"_5":14420,"_27589":57648,"_2954":57661},[],{"_3471":2711,"_30355":2634,"_21010":57887,"_5":14420,"_27589":57648,"_2954":57888},[],"Every Helm release",{"_3471":2712,"_30355":2634,"_21010":57890,"_5":14420,"_27589":57648,"_2954":57891},[],"High: `helm upgrade` fails",{"_3471":2713,"_30355":2634,"_21010":57893,"_5":14420,"_27589":57648,"_2954":57894},[],"Remove or rename legacy keys",{"_3471":2714,"_30355":2634,"_21010":57896,"_5":14420,"_27589":57648,"_2954":57665},[],{"_3471":2715,"_30355":2634,"_21010":57898,"_5":14420,"_27589":57648,"_2954":57899},[],"Every deployment",{"_3471":2716,"_30355":2634,"_21010":57901,"_5":14420,"_27589":57648,"_2954":57902},[],"High: without a bootstrap principal there is no administrator",{"_3471":2717,"_30355":2634,"_21010":57904,"_5":14420,"_27589":57648,"_2954":57905},[],"Configure `services.authz`",{"_3471":2718,"_30355":2634,"_21010":57907,"_5":14420,"_27589":57648,"_2954":57669},[],{"_3471":2719,"_30355":2634,"_21010":57909,"_5":14420,"_27589":57648,"_2954":57888},[],{"_3471":2720,"_30355":2634,"_21010":57911,"_5":14420,"_27589":57648,"_2954":57912},[],"High: `helm upgrade` fails on the old keys",{"_3471":2721,"_30355":2634,"_21010":57914,"_5":14420,"_27589":57648,"_2954":57915},[],"Move JWKS and roles into `services.authz`",{"_3471":2722,"_30355":2634,"_21010":57917,"_5":14420,"_27589":57648,"_2954":57689},[],{"_3471":2723,"_30355":2634,"_21010":57919,"_5":14420,"_27589":57648,"_2954":57920},[],"3.8.0 deployments with per-service databases",{"_3471":2724,"_30355":2634,"_21010":57922,"_5":14420,"_27589":57648,"_2954":57923},[],"High: services find no data, or a migration aborts",{"_3471":2725,"_30355":2634,"_21010":57925,"_5":14420,"_27589":57648,"_2954":57926},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3471":2726,"_30355":2634,"_21010":57928,"_5":14420,"_27589":57648,"_2954":57693},[],{"_3471":2727,"_30355":2634,"_21010":57930,"_5":14420,"_27589":57648,"_2954":57931},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3471":2728,"_30355":2634,"_21010":57933,"_5":14420,"_27589":57648,"_2954":57934},[],"High: the backend no longer starts with them",{"_3471":2729,"_30355":2634,"_21010":57936,"_5":14420,"_27589":57648,"_2954":57937},[],"Move to PostgreSQL before upgrading",{"_3471":2730,"_30355":2634,"_21010":57939,"_5":14420,"_27589":57648,"_2954":57737},[],{"_3471":2731,"_30355":2634,"_21010":57941,"_5":14420,"_27589":57648,"_2954":57942},[],"Every deployment; API clients, custom policies and alert subscriptions are also affected",{"_3471":2732,"_30355":2634,"_21010":57944,"_5":14420,"_27589":57648,"_2954":57945},[],"High: the `/v1/roles` routes are removed and the migration is irreversible",{"_3471":2733,"_30355":2634,"_21010":57947,"_5":14420,"_27589":57648,"_2954":57948},[],"Fix the data the migration aborts on, and back up the database and the CRL bucket",{"_3471":2734,"_30355":2634,"_21010":57950,"_5":14420,"_27589":57648,"_2954":57951},[],"Webhooks with file references",{"_3471":2735,"_30355":2634,"_21010":57953,"_5":14420,"_27589":57648,"_2954":57954},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3471":2736,"_30355":2634,"_21010":57956,"_5":14420,"_27589":57648,"_2954":57957},[],"High: enrollments calling the webhook fail",{"_3471":2737,"_30355":2634,"_21010":57959,"_5":14420,"_27589":57648,"_2954":57960},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3471":2738,"_30355":2634,"_21010":57962,"_5":14420,"_27589":57648,"_2954":57673},[],{"_3471":2739,"_30355":2634,"_21010":57964,"_5":14420,"_27589":57648,"_2954":57965},[],"Releases with per-service identity overrides or mounted key material",{"_3471":2740,"_30355":2634,"_21010":57967,"_5":14420,"_27589":57648,"_2954":57968},[],"Medium: services cannot read their files",{"_3471":2741,"_30355":2634,"_21010":57970,"_5":14420,"_27589":57648,"_2954":57971},[],"Remove the overrides and fix volume ownership",{"_3471":2742,"_30355":2634,"_21010":57973,"_5":14420,"_27589":57648,"_2954":57677},[],{"_3471":2743,"_30355":2634,"_21010":57975,"_5":14420,"_27589":57648,"_2954":57976},[],"Releases that set `amqp.tls`",{"_3471":2744,"_30355":2634,"_21010":57978,"_5":14420,"_27589":57648,"_2954":57979},[],"Medium: clients connect to the wrong port",{"_3471":2745,"_30355":2634,"_21010":57981,"_5":14420,"_27589":57648,"_2954":57982},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3471":2746,"_30355":2634,"_21010":57984,"_5":14420,"_27589":57648,"_2954":57697},[],{"_3471":2747,"_30355":2634,"_21010":57986,"_5":14420,"_27589":57648,"_2954":57987},[],"Installations whose CA keys predate the KMS",{"_3471":2748,"_30355":2634,"_21010":57989,"_5":14420,"_27589":57648,"_2954":57990},[],"Medium: CA keys stay unmanaged",{"_3471":2749,"_30355":2634,"_21010":57992,"_5":14420,"_27589":57648,"_2954":57993},[],"Run the CA-to-KMS migration",{"_3471":2750,"_30355":2634,"_21010":57995,"_5":14420,"_27589":57648,"_2954":57996},[],"Receiver certificate verification",{"_3471":2751,"_30355":2634,"_21010":57998,"_5":14420,"_27589":57648,"_2954":57999},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3471":2752,"_30355":2634,"_21010":58001,"_5":14420,"_27589":57648,"_2954":58002},[],"Medium: credentials go to an unverified receiver",{"_3471":2753,"_30355":2634,"_21010":58004,"_5":14420,"_27589":57648,"_2954":58005},[],"Set `insecure_skip_verify` to `false`",{"_3471":2754,"_30355":2634,"_21010":58007,"_5":14420,"_27589":57648,"_2954":57713},[],{"_3471":2755,"_30355":2634,"_21010":58009,"_5":14420,"_27589":57648,"_2954":58010},[],"Scripts and consoles that edit DMSs through the API",{"_3471":2756,"_30355":2634,"_21010":58012,"_5":14420,"_27589":57648,"_2954":58013},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3471":2757,"_30355":2634,"_21010":58015,"_5":14420,"_27589":57648,"_2954":58016},[],"Read the DMS before editing and use the new field",{"_3471":2758,"_30355":2634,"_21010":58018,"_5":14420,"_27589":57648,"_2954":57733},[],{"_3471":2759,"_30355":2634,"_21010":58020,"_5":14420,"_27589":57648,"_2954":58021},[],"Clients that create or update CRL settings through the API",{"_3471":2760,"_30355":2634,"_21010":58023,"_5":14420,"_27589":57648,"_2954":58024},[],"Medium: requests with the old field return an error",{"_3471":2761,"_30355":2634,"_21010":58026,"_5":14420,"_27589":57648,"_2954":58027},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3471":2762,"_30355":2634,"_21010":58029,"_5":14420,"_27589":57648,"_2954":57741},[],{"_3471":2763,"_30355":2634,"_21010":58031,"_5":14420,"_27589":57648,"_2954":58032},[],"Alert subscriptions and consumers of the VA events",{"_3471":2764,"_30355":2634,"_21010":58034,"_5":14420,"_27589":57648,"_2954":58035},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3471":2765,"_30355":2634,"_21010":58037,"_5":14420,"_27589":57648,"_2954":58038},[],"Review conditions filtering on the old event payload or subject",{"_3471":2766,"_30355":2634,"_21010":58040,"_5":14420,"_27589":57648,"_2954":57729},[],{"_3471":2767,"_30355":2634,"_21010":58042,"_5":14420,"_27589":57648,"_2954":58043},[],"Consumers that read the device `events` field",{"_3471":2768,"_30355":2634,"_21010":58045,"_5":14420,"_27589":57648,"_2954":58046},[],"Medium: the field disappears",{"_3471":2769,"_30355":2634,"_21010":58048,"_5":14420,"_27589":57648,"_2954":58049},[],"Use the new event endpoints",{"_3471":2770,"_30355":2634,"_21010":58051,"_5":14420,"_27589":57648,"_2954":57749},[],{"_3471":2771,"_30355":2634,"_21010":58053,"_5":14420,"_27589":57648,"_2954":58054},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3471":2772,"_30355":2634,"_21010":58056,"_5":14420,"_27589":57648,"_2954":58057},[],"Medium: the VA migration aborts",{"_3471":2773,"_30355":2634,"_21010":58059,"_5":14420,"_27589":57648,"_2954":58060},[],"Fix the affected roles before upgrading",{"_3471":2774,"_30355":2634,"_21010":58062,"_5":14420,"_27589":57648,"_2954":57681},[],{"_3471":2775,"_30355":2634,"_21010":58064,"_5":14420,"_27589":57648,"_2954":58065},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3471":2776,"_30355":2634,"_21010":58067,"_5":14420,"_27589":57648,"_2954":58068},[],"Low to medium: validation errors or changed defaults",{"_3471":2777,"_30355":2634,"_21010":58070,"_5":14420,"_27589":57648,"_2954":58071},[],"Update the values file",{"_3471":2778,"_30355":2634,"_21010":58073,"_5":14420,"_27589":57648,"_2954":57721},[],{"_3471":2779,"_30355":2634,"_21010":58075,"_5":14420,"_27589":57648,"_2954":58076},[],"Clients that send the DMS ID in the update body",{"_3471":2780,"_30355":2634,"_21010":58078,"_5":14420,"_27589":57648,"_2954":58079},[],"Low: the ID in the URL wins",{"_3471":2781,"_30355":2634,"_21010":58081,"_5":14420,"_27589":57648,"_2954":58082},[],"Send the ID in the URL",{"_3471":2782,"_30355":2634,"_21010":58084,"_5":14420,"_27589":57648,"_2954":57745},[],{"_3471":2783,"_30355":2634,"_21010":58086,"_5":14420,"_27589":57648,"_2954":58087},[],"Clients that send an `id` when creating or importing CAs",{"_3471":2784,"_30355":2634,"_21010":58089,"_5":14420,"_27589":57648,"_2954":58090},[],"Low: the ID in the body is ignored, and the field is removed",{"_3471":2785,"_30355":2634,"_21010":58092,"_5":14420,"_27589":57648,"_2954":58093},[],"Let the backend assign the ID and use the returned one",{"_3471":2786,"_30355":2634,"_21010":58095,"_5":14420,"_27589":57648,"_2954":57725},[],{"_3471":2787,"_30355":2634,"_21010":58097,"_5":14420,"_27589":57648,"_2954":58098},[],"Consumers that match on certificate `type`",{"_3471":2788,"_30355":2634,"_21010":58100,"_5":14420,"_27589":57648,"_2954":58101},[],"Low: two values are renamed",{"_3471":2789,"_30355":2634,"_21010":58103,"_5":14420,"_27589":57648,"_2954":58104},[],"Adapt consumers",{"_3471":2790,"_30355":2634,"_21010":58106,"_5":14420,"_27589":57648,"_2954":57717},[],{"_3471":2791,"_30355":2634,"_21010":58108,"_5":14420,"_27589":57648,"_2954":58109},[],"Any DMS",{"_3471":2792,"_30355":2634,"_21010":58111,"_5":14420,"_27589":57648,"_2954":58112},[],"Low: informational",{"_3471":2793,"_30355":2634,"_21010":58114,"_5":14420,"_27589":57648,"_2954":58115},[],"Read both blocks before editing",{"_3471":2794,"_30355":2634,"_21010":58117,"_5":14420,"_27589":57656,"_2954":58118},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3471":2795,"_30355":2634,"_21010":58120,"_5":14420,"_27589":57656,"_2954":58121},[],"Step 4 of the migration guide copies the data.",{"_3471":2796,"_30355":2634,"_21010":58123,"_5":14420,"_27589":57660,"_2954":58124},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3471":2797,"_30355":2634,"_21010":58126,"_5":14420,"_27589":57664,"_2954":58127},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3471":2798,"_30355":2634,"_21010":58129,"_5":14420,"_27589":57668,"_2954":58130},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3471":2799,"_30355":2634,"_21010":58132,"_5":14420,"_27589":57672,"_2954":58133},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3471":2800,"_30355":2634,"_21010":58135,"_5":14420,"_27589":57672,"_2954":58136},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3471":2801,"_30355":2634,"_21010":58138,"_5":14420,"_27589":57676,"_2954":58139},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3471":2802,"_30355":2634,"_21010":58141,"_5":14420,"_27589":57680,"_2954":58142},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3471":2803,"_30355":2634,"_21010":58144,"_5":14420,"_27589":57680,"_2954":58145},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3471":2804,"_30355":2634,"_21010":58147,"_5":14420,"_27589":57680,"_2954":58148},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3471":2805,"_30355":2634,"_21010":58150,"_5":14420,"_27589":57680,"_2954":58151},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3471":2806,"_30355":2634,"_21010":58153,"_5":14420,"_27589":57680,"_2954":58154},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3471":2807,"_30355":2634,"_21010":58156,"_5":14420,"_27589":57680,"_2954":58157},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3471":2808,"_30355":2634,"_21010":58159,"_5":14420,"_27589":57688,"_2954":58160},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3471":2809,"_30355":2634,"_21010":58162,"_5":14420,"_27589":57688,"_2954":58163},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3471":2810,"_30355":2634,"_21010":58165,"_5":14420,"_27589":57688,"_2954":58166},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3471":2811,"_30355":2634,"_21010":58168,"_5":14420,"_27589":57688,"_2954":58169},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3471":2812,"_30355":2634,"_21010":58171,"_5":14420,"_27589":57688,"_2954":58172},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3471":2813,"_30355":2634,"_21010":58174,"_5":14420,"_27589":57692,"_2954":58175},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3471":2814,"_30355":2634,"_21010":58177,"_5":14420,"_27589":57696,"_2954":58178},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3471":2815,"_30355":2634,"_21010":58180,"_5":14420,"_27589":57696,"_2954":58181},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3471":2816,"_30355":2634,"_21010":58183,"_5":14420,"_27589":57696,"_2954":58184},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3471":2817,"_30355":2634,"_21010":58186,"_5":14420,"_27589":57696,"_2954":58187},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3471":2818,"_30355":2634,"_21010":58189,"_5":14420,"_27589":57696,"_2954":58190},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3471":2819,"_30355":2634,"_21010":58192,"_5":14420,"_27589":57696,"_2954":58193},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3471":2820,"_30355":2634,"_21010":58195,"_5":14420,"_27589":57696,"_2954":58196},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3471":2821,"_30355":2634,"_21010":58198,"_5":14420,"_27589":57696,"_2954":58199},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3471":2822,"_30355":2634,"_21010":58201,"_5":14420,"_27589":57700,"_2954":58202},[],"Certificates now reference their KMS key, and CRL settings reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3471":2823,"_30355":2634,"_21010":58204,"_5":14420,"_27589":57708,"_2954":58205},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3471":2824,"_30355":2634,"_21010":58207,"_5":14420,"_27589":57708,"_2954":58208},[],"Field in 3.8.0",{"_3471":2825,"_30355":2634,"_21010":58210,"_5":14420,"_27589":57708,"_2954":58211},[],"Field in 4.0.0",{"_3471":2826,"_30355":2634,"_21010":58213,"_5":14420,"_27589":57708,"_2954":58214},[],"`validate_server_cert`",{"_3471":2827,"_30355":2634,"_21010":58216,"_5":14420,"_27589":57708,"_2954":58217},[],"`insecure_skip_verify` (value negated)",{"_3471":2828,"_30355":2634,"_21010":58219,"_5":14420,"_27589":57708,"_2954":58220},[],"`oidc`",{"_3471":2829,"_30355":2634,"_21010":58222,"_5":14420,"_27589":57708,"_2954":58223},[],"`jwt_options`",{"_3471":2830,"_30355":2634,"_21010":58225,"_5":14420,"_27589":57708,"_2954":58226},[],"`apikey`",{"_3471":2831,"_30355":2634,"_21010":58228,"_5":14420,"_27589":57708,"_2954":58229},[],"`apikey_options`",{"_3471":2832,"_30355":2634,"_21010":58231,"_5":14420,"_27589":57708,"_2954":58232},[],"`mtls`",{"_3471":2833,"_30355":2634,"_21010":58234,"_5":14420,"_27589":57708,"_2954":58235},[],"`mtls_options`",{"_3471":2834,"_30355":2634,"_21010":58237,"_5":14420,"_27589":57708,"_2954":58238},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3471":2835,"_30355":2634,"_21010":58240,"_5":14420,"_27589":57708,"_2954":58241},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3471":2836,"_30355":2634,"_21010":58243,"_5":14420,"_27589":57708,"_2954":58244},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3471":2837,"_30355":2634,"_21010":58246,"_5":14420,"_27589":57712,"_2954":58247},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3471":2838,"_30355":2634,"_21010":58249,"_5":14420,"_27589":57712,"_2954":58250},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3471":2839,"_30355":2634,"_21010":58252,"_5":14420,"_27589":57712,"_2954":58253},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3471":2840,"_30355":2634,"_21010":58255,"_5":14420,"_27589":57716,"_2954":58256},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3471":2841,"_30355":2634,"_21010":58258,"_5":14420,"_27589":57720,"_2954":58259},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3471":2842,"_30355":2634,"_21010":58261,"_5":14420,"_27589":57724,"_2954":58262},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3471":2843,"_30355":2634,"_21010":58264,"_5":14420,"_27589":57728,"_2954":58265},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3471":2844,"_30355":2634,"_21010":58267,"_5":14420,"_27589":57728,"_2954":58268},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3471":2845,"_30355":2634,"_21010":58270,"_5":14420,"_27589":57728,"_2954":58271},[],"`POST /v1/devices/:id/events` creates an event.",{"_3471":2846,"_30355":2634,"_21010":58273,"_5":14420,"_27589":57728,"_2954":58274},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3471":2847,"_30355":2634,"_21010":58276,"_5":14420,"_27589":57732,"_2954":58277},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3471":2848,"_30355":2634,"_21010":58279,"_5":14420,"_27589":57736,"_2954":58280},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key:",{"_3471":2849,"_30355":2634,"_21010":58282,"_5":14420,"_27589":57736,"_2954":58283},[],"Route",{"_3471":2850,"_30355":2634,"_21010":58285,"_5":14420,"_27589":57736,"_2954":52663},[],{"_3471":2851,"_30355":2634,"_21010":58287,"_5":14420,"_27589":57736,"_2954":58288},[],"`GET /v1/crl-settings`",{"_3471":2852,"_30355":2634,"_21010":58290,"_5":14420,"_27589":57736,"_2954":58291},[],"Lists the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3471":2853,"_30355":2634,"_21010":58293,"_5":14420,"_27589":57736,"_2954":58294},[],"`GET /v1/crl-settings/{ca-id}`",{"_3471":2854,"_30355":2634,"_21010":58296,"_5":14420,"_27589":57736,"_2954":58297},[],"Reads the settings of a CA.",{"_3471":2855,"_30355":2634,"_21010":58299,"_5":14420,"_27589":57736,"_2954":58300},[],"`PUT /v1/crl-settings/{ca-id}`",{"_3471":2856,"_30355":2634,"_21010":58302,"_5":14420,"_27589":57736,"_2954":58303},[],"Replaces `crl_options`.",{"_3471":2857,"_30355":2634,"_21010":58305,"_5":14420,"_27589":57736,"_2954":58306},[],"The options keep their meaning and their defaults: 7 days of `validity`, 6 days and 23 hours of `refresh_interval`, and `regenerate_on_revoke` `true`. `status` (`ACTIVE` or `ARCHIVED`), `legacy_ski` and `latest_crl` are read-only. A `PUT` validates the signer only when it changes, does not regenerate the CRL, and returns `409` when the settings are not `ACTIVE`.",{"_3471":2858,"_30355":2634,"_21010":58308,"_5":14420,"_27589":57736,"_2954":58309},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3471":2859,"_30355":2634,"_21010":58311,"_5":14420,"_27589":57736,"_2954":58312},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3471":2860,"_30355":2634,"_21010":58314,"_5":14420,"_27589":57736,"_2954":58315},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3471":2861,"_30355":2634,"_21010":58317,"_5":14420,"_27589":57736,"_2954":58318},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3471":2862,"_30355":2634,"_21010":58320,"_5":14420,"_27589":57736,"_2954":58321},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3471":2863,"_30355":2634,"_21010":58323,"_5":14420,"_27589":57736,"_2954":58324},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3471":2864,"_30355":2634,"_21010":58326,"_5":14420,"_27589":57736,"_2954":58327},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3471":2865,"_30355":2634,"_21010":58329,"_5":14420,"_27589":57736,"_2954":58330},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3471":2866,"_30355":2634,"_21010":58332,"_5":14420,"_27589":57736,"_2954":58333},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3471":2867,"_30355":2634,"_21010":58335,"_5":14420,"_27589":57736,"_2954":58336},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3471":2868,"_30355":2634,"_21010":58338,"_5":14420,"_27589":57740,"_2954":58339},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3471":2869,"_30355":2634,"_21010":58341,"_5":14420,"_27589":57744,"_2954":58342},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3471":2870,"_30355":2634,"_21010":58344,"_5":14420,"_27589":57748,"_2954":58345},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3471":2871,"_30355":2634,"_21010":58347,"_5":14420,"_27589":57752,"_2954":58348},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3471":2872,"_30355":2634,"_21010":58350,"_5":14420,"_27589":57756,"_2954":58351},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings keyed by CA ID).",{"_3471":2873,"_30355":2634,"_21010":58353,"_5":14420,"_27589":57756,"_2954":58354},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3471":2874,"_30355":2634,"_21010":58356,"_5":14420,"_27589":57756,"_2954":58357},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3471":2875,"_30355":2634,"_21010":58359,"_5":14420,"_27589":57756,"_2954":58360},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3471":2876,"_30355":2634,"_21010":58362,"_5":14420,"_27589":57756,"_2954":58363},[],"Record the names of your local-storage PVCs:",{"_3471":2877,"_30355":2634,"_21010":58365,"_5":14420,"_27589":57756,"_2954":58366},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3471":2878,"_30355":2634,"_21010":58368,"_5":14420,"_27589":57760,"_2954":58369},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3471":2879,"_30355":2634,"_21010":58371,"_5":14420,"_27589":57760,"_2954":58372},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3471":2880,"_30355":2634,"_21010":58374,"_5":14420,"_27589":57760,"_2954":58375},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3471":2881,"_30355":2634,"_21010":58377,"_5":14420,"_27589":57760,"_2954":58378},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3471":2882,"_30355":2634,"_21010":58380,"_5":14420,"_27589":57760,"_2954":58381},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3471":2883,"_30355":2634,"_21010":58383,"_5":14420,"_27589":57764,"_2954":58384},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3471":2884,"_30355":2634,"_21010":58386,"_5":14420,"_27589":57764,"_2954":58387},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3471":2885,"_30355":2634,"_21010":58389,"_5":14420,"_27589":57764,"_2954":58390},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3471":2886,"_30355":2634,"_21010":58392,"_5":14420,"_27589":57764,"_2954":58393},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3471":2887,"_30355":2634,"_21010":58395,"_5":14420,"_27589":57764,"_2954":58396},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3471":2888,"_30355":2634,"_21010":58398,"_5":14420,"_27589":57764,"_2954":58399},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3471":2889,"_30355":2634,"_21010":58401,"_5":14420,"_27589":57764,"_2954":58402},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3471":2890,"_30355":2634,"_21010":58404,"_5":14420,"_27589":57764,"_2954":58405},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3471":2891,"_30355":2634,"_21010":58407,"_5":14420,"_27589":57764,"_2954":58408},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3471":2892,"_30355":2634,"_21010":58410,"_5":14420,"_27589":57764,"_2954":58411},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3471":2893,"_30355":2634,"_21010":58413,"_5":14420,"_27589":57764,"_2954":58414},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3471":2894,"_30355":2634,"_21010":58416,"_5":14420,"_27589":57764,"_2954":58417},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3471":2895,"_30355":2634,"_21010":58419,"_5":14420,"_27589":57768,"_2954":58420},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3471":2896,"_30355":2634,"_21010":58422,"_5":14420,"_27589":57768,"_2954":58423},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3471":2897,"_30355":2634,"_21010":58425,"_5":14420,"_27589":57772,"_2954":58426},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3471":2898,"_30355":2634,"_21010":58428,"_5":14420,"_27589":57772,"_2954":58429},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3471":2899,"_30355":2634,"_21010":58431,"_5":14420,"_27589":57772,"_2954":58432},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3471":2900,"_30355":2634,"_21010":58434,"_5":14420,"_27589":57772,"_2954":58435},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3471":2901,"_30355":2634,"_21010":58437,"_5":14420,"_27589":57772,"_2954":58438},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3471":2902,"_30355":2634,"_21010":58440,"_5":14420,"_27589":57772,"_2954":58441},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3471":2903,"_30355":2634,"_21010":58443,"_5":14420,"_27589":57772,"_2954":58444},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3471":2904,"_30355":2634,"_21010":58446,"_5":14420,"_27589":57772,"_2954":58447},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3471":2905,"_30355":2634,"_21010":58449,"_5":14420,"_27589":57772,"_2954":58450},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3471":2906,"_30355":2634,"_21010":58452,"_5":14420,"_27589":57772,"_2954":58453},[],"**Remove the helper and restore the recorded replica counts:**",{"_3471":2907,"_30355":2634,"_21010":58455,"_5":14420,"_27589":57772,"_2954":58456},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3471":2908,"_30355":2634,"_21010":58458,"_5":14420,"_27589":57776,"_2954":58459},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3471":2909,"_30355":2634,"_21010":58461,"_5":14420,"_27589":57776,"_2954":58462},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3471":2910,"_30355":2634,"_21010":58464,"_5":14420,"_27589":57780,"_2954":58465},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3471":2911,"_30355":2634,"_21010":58467,"_5":14420,"_27589":57780,"_2954":58468},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3471":2912,"_30355":2634,"_21010":58470,"_5":14420,"_27589":57780,"_2954":58471},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration likewise requires `ca` to be migrated first.",{"_3471":2913,"_30355":2634,"_21010":58473,"_5":14420,"_27589":57780,"_2954":58474},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates` and `SELECT` on `ca.ca_certificates`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`.",{"_3471":2914,"_30355":2634,"_21010":58476,"_5":14420,"_27589":57780,"_2954":58477},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3471":2915,"_30355":2634,"_21010":58479,"_5":14420,"_27589":57780,"_2954":58480},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3471":2916,"_30355":2634,"_21010":58482,"_5":14420,"_27589":57780,"_2954":58483},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3471":2917,"_30355":2634,"_21010":58485,"_5":14420,"_27589":57780,"_2954":58486},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3471":2918,"_30355":2634,"_21010":58488,"_5":14420,"_27589":57784,"_2954":58489},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3471":2919,"_30355":2634,"_21010":58491,"_5":14420,"_27589":57784,"_2954":58492},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3471":2920,"_30355":2634,"_21010":58494,"_5":14420,"_27589":57784,"_2954":58495},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3471":2921,"_30355":2634,"_21010":58497,"_5":14420,"_27589":57784,"_2954":58498},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3471":2922,"_30355":2634,"_21010":58500,"_5":14420,"_27589":57784,"_2954":58501},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3471":2923,"_30355":2634,"_21010":58503,"_5":14420,"_27589":57784,"_2954":58504},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3471":2924,"_30355":2634,"_21010":58506,"_5":14420,"_27589":57784,"_2954":58507},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3471":2925,"_30355":2634,"_21010":58509,"_5":14420,"_27589":57784,"_2954":58510},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` schema migration.",{"_3471":2926,"_30355":2634,"_21010":58512,"_5":14420,"_27589":57784,"_2954":58513},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3471":2927,"_30355":2634,"_21010":58515,"_5":14420,"_27589":57784,"_2954":58516},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3471":2928,"_30355":2634,"_21010":58518,"_5":14420,"_27589":57784,"_2954":58519},[],"**A migration or service fails with `permission denied for table ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped. Grant the missing privileges and re-run.",{"_3471":2929,"_30355":2634,"_21010":58521,"_5":14420,"_27589":57787,"_2954":58522},[],"After the upgrade, check in this order:",{"_3471":2930,"_30355":2634,"_21010":58524,"_5":14420,"_27589":57787,"_2954":58525},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3471":2931,"_30355":2634,"_21010":58527,"_5":14420,"_27589":57787,"_2954":58528},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3471":2932,"_30355":2634,"_21010":58530,"_5":14420,"_27589":57787,"_2954":58531},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3471":2933,"_30355":2634,"_21010":58533,"_5":14420,"_27589":57787,"_2954":58534},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3471":2934,"_30355":2634,"_21010":58536,"_5":14420,"_27589":57787,"_2954":58537},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3471":2935,"_30355":2634,"_21010":58539,"_5":14420,"_27589":57787,"_2954":58540},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3471":2936,"_30355":2634,"_21010":58542,"_5":14420,"_27589":57787,"_2954":58543},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3471":2937,"_30355":2634,"_21010":58545,"_5":14420,"_27589":57787,"_2954":58546},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3471":2938,"_30355":2634,"_21010":58548,"_5":14420,"_27589":57787,"_2954":58549},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3471":2939,"_30355":2634,"_21010":58551,"_5":14420,"_27589":57787,"_2954":58552},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3471":2940,"_30355":2634,"_21010":58554,"_5":14420,"_27589":57787,"_2954":58555},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3471":2941,"_30355":2634,"_21010":58557,"_5":14420,"_27589":57787,"_2954":58558},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3471":2942,"_30355":2634,"_21010":58560,"_5":14420,"_27589":57787,"_2954":58561},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3471":2943,"_30355":2634,"_21010":58563,"_5":14420,"_27589":57787,"_2954":58564},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3471":2944,"_30355":2634,"_21010":58566,"_5":14420,"_27589":57787,"_2954":58567},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3471":2945,"_30355":2634,"_21010":58569,"_5":14420,"_27589":57791,"_2954":58570},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3471":2946,"_30355":2634,"_21010":58572,"_5":14420,"_27589":57791,"_2954":58573},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3471":2947,"_30355":2634,"_21010":58575,"_5":14420,"_27589":57791,"_2954":58576},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3471":2948,"_30355":2634,"_21010":58578,"_5":14420,"_27589":57791,"_2954":58579},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3471":2949,"_30355":2634,"_21010":58581,"_5":14420,"_27589":57791,"_2954":58582},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_58585":58586,"_58587":58588,"_58589":58590,"_58591":58592,"_18204":2989,"_70346":2989},"language","english","sortableProperties",[2954,30355,5,27589],"sortablePropertiesWithTypes",{"_2954":25132,"_30355":25132,"_5":25132,"_27589":25132},"sorts",{"_2954":58593,"_30355":61532,"_5":64470,"_27589":67408},{"_4653":58594,"_58595":58596,"_5":25132},{"_14496":4190,"_14883":4772,"_14902":4438,"_29358":3325,"_14889":5843,"_19930":6506,"_14517":14460,"_14524":3357,"_29300":4682,"_29709":7281,"_29730":4753,"_29334":4717,"_34675":4490,"_29437":7539,"_29774":4945,"_34682":4795,"_34685":10171,"_34688":17208,"_34691":12486,"_30181":3956,"_34696":4009,"_34698":3258,"_30211":5125,"_14898":14125,"_34702":3336,"_34705":4493,"_34707":6227,"_29758":6996,"_30176":3373,"_30224":4995,"_34712":11239,"_34714":8451,"_34716":3654,"_29454":3054,"_34719":6731,"_34721":6376,"_34723":11638,"_34725":3661,"_34727":20289,"_29371":10815,"_34730":15880,"_34732":3346,"_29365":3033,"_29795":6613,"_34736":9578,"_34738":4197,"_34741":9218,"_29411":6173,"_34745":4044,"_29291":5449,"_34748":7065,"_29339":16803,"_34751":23155,"_34753":14545,"_34756":4021,"_14892":6863,"_34759":17699,"_34761":17999,"_34764":10503,"_34766":7612,"_34768":3924,"_34770":6737,"_34772":8183,"_19933":6578,"_34775":7616,"_34777"