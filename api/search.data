60290,"_41603":60293,"_41606":60296,"_41608":60299,"_41610":60302,"_41612":60305,"_41614":60308,"_41616":60311,"_41618":60314,"_41620":60317,"_41622":60320,"_41624":60323,"_41626":60326,"_41628":60329,"_41630":60332,"_41632":60335,"_41635":60338,"_41637":60341,"_41639":60344,"_41641":60347,"_41643":60350,"_41645":60353,"_41647":60356,"_41649":60359,"_41651":60362,"_41653":60365,"_41655":60368,"_41657":60371,"_41659":60374,"_41661":60377,"_41663":60380,"_41665":60383,"_41667":60386,"_41669":60389,"_41671":60392,"_41673":60395,"_41675":60398,"_41677":60401,"_41679":60404,"_41681":60407,"_41683":60410,"_41685":60413,"_41687":60416,"_41689":60419,"_41691":60422,"_41693":60425,"_41695":60428,"_41697":60431,"_41700":60434,"_41702":60437,"_41704":60440,"_41706":60443},{"_3697":15,"_31245":15,"_5":15238,"_3074":50946,"_31570":50947,"_21577":50951,"_28435":15},"Deploy from AWS Marketplace",[50948,50949,50950],"Docs","Deployment","Other models",[],{"_3697":16,"_31245":15,"_21577":50953,"_5":14884,"_28435":15,"_3074":50954},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3697":17,"_31245":15,"_5":31567,"_21577":50956,"_28435":50957,"_3074":50958},[],"/docs/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3697":18,"_31245":15,"_5":31567,"_21577":50960,"_28435":50961,"_3074":50962},[],"/docs/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3697":19,"_31245":15,"_5":31567,"_21577":50964,"_28435":50965,"_3074":50966},[],"/docs/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3697":20,"_31245":15,"_5":31567,"_21577":50968,"_28435":50969,"_3074":50970},[],"/docs/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3697":21,"_31245":15,"_5":31567,"_21577":50972,"_28435":50973,"_3074":50974},[],"/docs/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3697":22,"_31245":15,"_5":31567,"_21577":50976,"_28435":50977,"_3074":50978},[],"/docs/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3697":23,"_31245":15,"_5":31567,"_21577":50980,"_28435":50981,"_3074":50982},[],"/docs/deployment/aws-marketplace#next-step","Next step",{"_3697":24,"_31245":15,"_21577":50984,"_5":14884,"_28435":15,"_3074":50985},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3697":25,"_31245":15,"_21577":50987,"_5":14884,"_28435":50957,"_3074":50988},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3697":26,"_31245":15,"_21577":50990,"_5":14884,"_28435":50957,"_3074":50991},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3697":27,"_31245":15,"_21577":50993,"_5":14884,"_28435":50957,"_3074":50994},[],"A security group allowing the necessary endpoints.",{"_3697":28,"_31245":15,"_21577":50996,"_5":14884,"_28435":50961,"_3074":50997},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3697":29,"_31245":15,"_21577":50999,"_5":14884,"_28435":50961,"_3074":51000},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3697":30,"_31245":15,"_21577":51002,"_5":14884,"_28435":50961,"_3074":51003},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3697":31,"_31245":15,"_21577":51005,"_5":14884,"_28435":50965,"_3074":51006},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3697":32,"_31245":15,"_21577":51008,"_5":14884,"_28435":50969,"_3074":51009},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3697":33,"_31245":15,"_21577":51011,"_5":14884,"_28435":50973,"_3074":51012},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3697":34,"_31245":15,"_21577":51014,"_5":14884,"_28435":50977,"_3074":51015},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3697":35,"_31245":15,"_21577":51017,"_5":14884,"_28435":50981,"_3074":51018},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3697":36,"_31245":36,"_5":15238,"_3074":51020,"_31570":51021,"_21577":51022,"_28435":36},"Deploy Lamassu",[50948,50949],[],{"_3697":37,"_31245":36,"_21577":51024,"_5":14884,"_28435":36,"_3074":51025},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3697":38,"_31245":36,"_5":31567,"_21577":51027,"_28435":51028,"_3074":51029},[],"/docs/deployment/overview#choose-a-model","Choose a model",{"_3697":39,"_31245":36,"_5":31567,"_21577":51031,"_28435":51032,"_3074":51033},[],"/docs/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3697":40,"_31245":36,"_5":31567,"_21577":51035,"_28435":51036,"_3074":51037},[],"/docs/deployment/overview#after-deployment","After deployment",{"_3697":41,"_31245":36,"_21577":51039,"_5":14884,"_28435":36,"_3074":51040},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3697":42,"_31245":36,"_21577":51042,"_5":14884,"_28435":51028,"_3074":51043},[],"Model",{"_3697":43,"_31245":36,"_21577":51045,"_5":14884,"_28435":51028,"_3074":51046},[],"Recommended for",{"_3697":44,"_31245":36,"_21577":51048,"_5":14884,"_28435":51028,"_3074":51049},[],"Who operates the infrastructure",{"_3697":45,"_31245":36,"_21577":51051,"_5":14884,"_28435":51028,"_3074":51052},[],"Starting point",{"_3697":46,"_31245":36,"_21577":51054,"_5":14884,"_28435":51028,"_3074":51055},[],"Kubernetes self-managed",{"_3697":47,"_31245":36,"_21577":51057,"_5":14884,"_28435":51028,"_3074":51058},[],"Production, regulated environments and custom deployments",{"_3697":48,"_31245":36,"_21577":51060,"_5":14884,"_28435":51028,"_3074":51061},[],"Your team",{"_3697":49,"_31245":36,"_21577":51063,"_5":14884,"_28435":51028,"_3074":51064},[],"Helm or Fastlane",{"_3697":50,"_31245":36,"_21577":51066,"_5":14884,"_28435":51028,"_3074":51067},[],"AWS Marketplace",{"_3697":51,"_31245":36,"_21577":51069,"_5":14884,"_28435":51028,"_3074":51070},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3697":52,"_31245":36,"_21577":51072,"_5":14884,"_28435":51028,"_3074":51061},[],{"_3697":53,"_31245":36,"_21577":51074,"_5":14884,"_28435":51028,"_3074":51075},[],"Preconfigured image on EC2",{"_3697":54,"_31245":36,"_21577":51077,"_5":14884,"_28435":51028,"_3074":51078},[],"SaaS",{"_3697":55,"_31245":36,"_21577":51080,"_5":14884,"_28435":51028,"_3074":51081},[],"Teams that want to use the platform without operating it",{"_3697":56,"_31245":36,"_21577":51083,"_5":14884,"_28435":51028,"_3074":51084},[],"Lamassu",{"_3697":57,"_31245":36,"_21577":51086,"_5":14884,"_28435":51028,"_3074":51087},[],"Managed subscription",{"_3697":58,"_31245":36,"_21577":51089,"_5":14884,"_28435":51028,"_3074":51090},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3697":59,"_31245":36,"_21577":51092,"_5":14884,"_28435":51028,"_3074":51093},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3697":60,"_31245":36,"_21577":51095,"_5":14884,"_28435":51028,"_3074":51096},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3697":61,"_31245":36,"_21577":51098,"_5":14884,"_28435":51032,"_3074":51099},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3697":62,"_31245":36,"_21577":51101,"_5":14884,"_28435":51036,"_3074":51102},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3697":63,"_31245":63,"_5":15238,"_3074":51104,"_31570":51105,"_21577":51106,"_28435":63},"Use Lamassu as SaaS",[50948,50949,50950],[],{"_3697":64,"_31245":63,"_21577":51108,"_5":14884,"_28435":63,"_3074":51109},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3697":65,"_31245":63,"_5":31567,"_21577":51111,"_28435":51112,"_3074":51113},[],"/docs/deployment/saas#what-the-service-manages","What the service manages",{"_3697":66,"_31245":63,"_5":31567,"_21577":51115,"_28435":51116,"_3074":51117},[],"/docs/deployment/saas#plans","Plans",{"_3697":67,"_31245":63,"_5":31567,"_21577":51119,"_28435":51120,"_3074":51121},[],"/docs/deployment/saas#request-access","Request access",{"_3697":68,"_31245":63,"_21577":51123,"_5":14884,"_28435":63,"_3074":51124},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3697":69,"_31245":63,"_21577":51126,"_5":14884,"_28435":51112,"_3074":51127},[],"Platform availability and maintenance.",{"_3697":70,"_31245":63,"_21577":51129,"_5":14884,"_28435":51112,"_3074":51130},[],"Automatic backups.",{"_3697":71,"_31245":63,"_21577":51132,"_5":14884,"_28435":51112,"_3074":51133},[],"Version upgrades.",{"_3697":72,"_31245":63,"_21577":51135,"_5":14884,"_28435":51112,"_3074":51136},[],"Technical support and SLA according to your plan.",{"_3697":73,"_31245":63,"_21577":51138,"_5":14884,"_28435":51116,"_3074":51139},[],"Plan",{"_3697":74,"_31245":63,"_21577":51141,"_5":14884,"_28435":51116,"_3074":51142},[],"Devices",{"_3697":75,"_31245":63,"_21577":51144,"_5":14884,"_28435":51116,"_3074":51145},[],"Support",{"_3697":76,"_31245":63,"_21577":51147,"_5":14884,"_28435":51116,"_3074":51148},[],"SLA",{"_3697":77,"_31245":63,"_21577":51150,"_5":14884,"_28435":51116,"_3074":51151},[],"Starter",{"_3697":78,"_31245":63,"_21577":51153,"_5":14884,"_28435":51116,"_3074":51154},[],"Up to 1,000",{"_3697":79,"_31245":63,"_21577":51156,"_5":14884,"_28435":51116,"_3074":51157},[],"Email",{"_3697":80,"_31245":63,"_21577":51159,"_5":14884,"_28435":51116,"_3074":51160},[],"99.5 %",{"_3697":81,"_31245":63,"_21577":51162,"_5":14884,"_28435":51116,"_3074":51163},[],"Professional",{"_3697":82,"_31245":63,"_21577":51165,"_5":14884,"_28435":51116,"_3074":51166},[],"Up to 10,000",{"_3697":83,"_31245":63,"_21577":51168,"_5":14884,"_28435":51116,"_3074":51169},[],"Email and chat",{"_3697":84,"_31245":63,"_21577":51171,"_5":14884,"_28435":51116,"_3074":51172},[],"99.9 %",{"_3697":85,"_31245":63,"_21577":51174,"_5":14884,"_28435":51116,"_3074":51175},[],"Enterprise",{"_3697":86,"_31245":63,"_21577":51177,"_5":14884,"_28435":51116,"_3074":51178},[],"Unlimited",{"_3697":87,"_31245":63,"_21577":51180,"_5":14884,"_28435":51116,"_3074":51181},[],"Dedicated",{"_3697":88,"_31245":63,"_21577":51183,"_5":14884,"_28435":51116,"_3074":51184},[],"99.99 %",{"_3697":89,"_31245":63,"_21577":51186,"_5":14884,"_28435":51120,"_3074":51187},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3697":90,"_31245":63,"_21577":51189,"_5":14884,"_28435":51120,"_3074":51190},[],"When you receive your instance's credentials, continue with Get started.",{"_3697":91,"_31245":91,"_5":15238,"_3074":51192,"_31570":51193,"_21577":51194,"_28435":91},"Fastlane",[50948,50949,51055],[],{"_3697":92,"_31245":91,"_21577":51196,"_5":14884,"_28435":91,"_3074":51197},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3697":93,"_31245":91,"_5":31567,"_21577":51199,"_28435":51200,"_3074":51201},[],"/docs/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3697":94,"_31245":91,"_5":31567,"_21577":51203,"_28435":51204,"_3074":51205},[],"/docs/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3697":95,"_31245":91,"_5":31567,"_21577":51207,"_28435":51208,"_3074":50958},[],"/docs/deployment/self-hosted/fastlane#before-you-begin",{"_3697":96,"_31245":91,"_5":31567,"_21577":51210,"_28435":51211,"_3074":51212},[],"/docs/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3697":97,"_31245":91,"_5":31567,"_21577":51214,"_28435":51215,"_3074":51216},[],"/docs/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3697":98,"_31245":91,"_5":31567,"_21577":51218,"_28435":51219,"_3074":51220},[],"/docs/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3697":99,"_31245":91,"_5":31567,"_21577":51222,"_28435":51223,"_3074":51224},[],"/docs/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3697":100,"_31245":91,"_5":31567,"_21577":51226,"_28435":51227,"_3074":51228},[],"/docs/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3697":101,"_31245":91,"_5":31567,"_21577":51230,"_28435":51231,"_3074":51232},[],"/docs/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3697":102,"_31245":91,"_5":31567,"_21577":51234,"_28435":51235,"_3074":51236},[],"/docs/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3697":103,"_31245":91,"_5":31567,"_21577":51238,"_28435":51239,"_3074":51240},[],"/docs/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3697":104,"_31245":91,"_21577":51242,"_5":14884,"_28435":51200,"_3074":51243},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3697":105,"_31245":91,"_21577":51245,"_5":14884,"_28435":51200,"_3074":51246},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3697":106,"_31245":91,"_21577":51248,"_5":14884,"_28435":51204,"_3074":51249},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3697":107,"_31245":91,"_21577":51251,"_5":14884,"_28435":51204,"_3074":51252},[],"Fastlane installs or configures",{"_3697":108,"_31245":91,"_21577":51254,"_5":14884,"_28435":51204,"_3074":51255},[],"You still provide",{"_3697":109,"_31245":91,"_21577":51257,"_5":14884,"_28435":51204,"_3074":51258},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3697":110,"_31245":91,"_21577":51260,"_5":14884,"_28435":51204,"_3074":51261},[],"The Kubernetes cluster, nodes and persistent storage",{"_3697":111,"_31245":91,"_21577":51263,"_5":14884,"_28435":51204,"_3074":51264},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3697":112,"_31245":91,"_21577":51266,"_5":14884,"_28435":51204,"_3074":51267},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3697":113,"_31245":91,"_21577":51269,"_5":14884,"_28435":51204,"_3074":51270},[],"A self-signed Lamassu certificate flow, dependency credentials stored in Kubernetes Secrets (through the External Secrets Operator) and an initial user",{"_3697":114,"_31245":91,"_21577":51272,"_5":14884,"_28435":51204,"_3074":51273},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3697":115,"_31245":91,"_21577":51275,"_5":14884,"_28435":51204,"_3074":51276},[],"Optional observability and lab HSM components",{"_3697":116,"_31245":91,"_21577":51278,"_5":14884,"_28435":51204,"_3074":51279},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3697":117,"_31245":91,"_21577":51281,"_5":14884,"_28435":51204,"_3074":51282},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3697":118,"_31245":91,"_21577":51284,"_5":14884,"_28435":51208,"_3074":51285},[],"You need:",{"_3697":119,"_31245":91,"_21577":51287,"_5":14884,"_28435":51208,"_3074":51288},[],"an existing Kubernetes cluster",{"_3697":120,"_31245":91,"_21577":51290,"_5":14884,"_28435":51208,"_3074":51291},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3697":121,"_31245":91,"_21577":51293,"_5":14884,"_28435":51208,"_3074":51294},[],"`yq`",{"_3697":122,"_31245":91,"_21577":51296,"_5":14884,"_28435":51208,"_3074":24380},[],{"_3697":123,"_31245":91,"_21577":51298,"_5":14884,"_28435":51208,"_3074":51299},[],"`jq` only when using `--sample-data` or `--development`",{"_3697":124,"_31245":91,"_21577":51301,"_5":14884,"_28435":51208,"_3074":51302},[],"`ssh-keygen` only when using `--with-hsm`",{"_3697":125,"_31245":91,"_21577":51304,"_5":14884,"_28435":51208,"_3074":51305},[],"free external ports 80 and 443 on a single-node K3s host",{"_3697":126,"_31245":91,"_21577":51307,"_5":14884,"_28435":51208,"_3074":51308},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3697":127,"_31245":91,"_21577":51310,"_5":14884,"_28435":51208,"_3074":51311},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3697":128,"_31245":91,"_21577":51313,"_5":14884,"_28435":51211,"_3074":51314},[],"Run the script from a clone of the Helm repository:",{"_3697":129,"_31245":91,"_21577":51316,"_5":14884,"_28435":51211,"_3074":51317},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3697":130,"_31245":91,"_21577":51319,"_5":14884,"_28435":51215,"_3074":51320},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3697":131,"_31245":91,"_21577":51322,"_5":14884,"_28435":51215,"_3074":51323},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3697":132,"_31245":91,"_21577":51325,"_5":14884,"_28435":51215,"_3074":51326},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3697":133,"_31245":91,"_21577":51328,"_5":14884,"_28435":51215,"_3074":51329},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3697":134,"_31245":91,"_21577":51331,"_5":14884,"_28435":51219,"_3074":51332},[],"Option",{"_3697":135,"_31245":91,"_21577":51334,"_5":14884,"_28435":51219,"_3074":51335},[],"Default",{"_3697":136,"_31245":91,"_21577":51337,"_5":14884,"_28435":51219,"_3074":51338},[],"Purpose",{"_3697":137,"_31245":91,"_21577":51340,"_5":14884,"_28435":51219,"_3074":51341},[],"`-h`, `--help`",{"_3697":138,"_31245":91,"_21577":51343,"_5":14884,"_28435":51219,"_3074":51344},[],"—",{"_3697":139,"_31245":91,"_21577":51346,"_5":14884,"_28435":51219,"_3074":51347},[],"Show help",{"_3697":140,"_31245":91,"_21577":51349,"_5":14884,"_28435":51219,"_3074":51350},[],"`-c`, `--context`",{"_3697":141,"_31245":91,"_21577":51352,"_5":14884,"_28435":51219,"_3074":51353},[],"current context",{"_3697":142,"_31245":91,"_21577":51355,"_5":14884,"_28435":51219,"_3074":51356},[],"Select the kubeconfig context for kubectl and Helm",{"_3697":143,"_31245":91,"_21577":51358,"_5":14884,"_28435":51219,"_3074":51359},[],"`-n`, `--non-interactive`",{"_3697":144,"_31245":91,"_21577":51361,"_5":14884,"_28435":51219,"_3074":6823},[],{"_3697":145,"_31245":91,"_21577":51363,"_5":14884,"_28435":51219,"_3074":51364},[],"Skip prompts and generate dependency credentials",{"_3697":146,"_31245":91,"_21577":51366,"_5":14884,"_28435":51219,"_3074":51367},[],"`-ns`, `--namespace`",{"_3697":147,"_31245":91,"_21577":51369,"_5":14884,"_28435":51219,"_3074":51370},[],"`lamassu-dev`",{"_3697":148,"_31245":91,"_21577":51372,"_5":14884,"_28435":51219,"_3074":51373},[],"Namespace for the installation",{"_3697":149,"_31245":91,"_21577":51375,"_5":14884,"_28435":51219,"_3074":51376},[],"`-d`, `--domain`",{"_3697":150,"_31245":91,"_21577":51378,"_5":14884,"_28435":51219,"_3074":51379},[],"`dev.lamassu.io`",{"_3697":151,"_31245":91,"_21577":51381,"_5":14884,"_28435":51219,"_3074":51382},[],"Domain used by the UI, OIDC and certificate",{"_3697":152,"_31245":91,"_21577":51384,"_5":14884,"_28435":51219,"_3074":51385},[],"`-v`, `--version`",{"_3697":153,"_31245":91,"_21577":51387,"_5":14884,"_28435":51219,"_3074":15562},[],{"_3697":154,"_31245":91,"_21577":51389,"_5":14884,"_28435":51219,"_3074":51390},[],"Lamassu chart version",{"_3697":155,"_31245":91,"_21577":51392,"_5":14884,"_28435":51219,"_3074":51393},[],"`--https-port`",{"_3697":156,"_31245":91,"_21577":51395,"_5":14884,"_28435":51219,"_3074":51396},[],"`443`",{"_3697":157,"_31245":91,"_21577":51398,"_5":14884,"_28435":51219,"_3074":51399},[],"Gateway HTTPS listener port",{"_3697":158,"_31245":91,"_21577":51401,"_5":14884,"_28435":51219,"_3074":51402},[],"`--http-port`",{"_3697":159,"_31245":91,"_21577":51404,"_5":14884,"_28435":51219,"_3074":51405},[],"`80`",{"_3697":160,"_31245":91,"_21577":51407,"_5":14884,"_28435":51219,"_3074":51408},[],"Gateway HTTP listener port",{"_3697":161,"_31245":91,"_21577":51410,"_5":14884,"_28435":51219,"_3074":51411},[],"`--tls-crt`",{"_3697":162,"_31245":91,"_21577":51413,"_5":14884,"_28435":51219,"_3074":51344},[],{"_3697":163,"_31245":91,"_21577":51415,"_5":14884,"_28435":51219,"_3074":51416},[],"PEM certificate for downstream TLS",{"_3697":164,"_31245":91,"_21577":51418,"_5":14884,"_28435":51219,"_3074":51419},[],"`--tls-key`",{"_3697":165,"_31245":91,"_21577":51421,"_5":14884,"_28435":51219,"_3074":51344},[],{"_3697":166,"_31245":91,"_21577":51423,"_5":14884,"_28435":51219,"_3074":51424},[],"PEM private key for downstream TLS",{"_3697":167,"_31245":91,"_21577":51426,"_5":14884,"_28435":51219,"_3074":51427},[],"`-l`, `--local-chart-path`",{"_3697":168,"_31245":91,"_21577":51429,"_5":14884,"_28435":51219,"_3074":51430},[],"repository chart",{"_3697":169,"_31245":91,"_21577":51432,"_5":14884,"_28435":51219,"_3074":51433},[],"Use an unpacked local Lamassu chart",{"_3697":170,"_31245":91,"_21577":51435,"_5":14884,"_28435":51219,"_3074":51436},[],"`-ip`, `--gateway-ip`",{"_3697":171,"_31245":91,"_21577":51438,"_5":14884,"_28435":51219,"_3074":9100},[],{"_3697":172,"_31245":91,"_21577":51440,"_5":14884,"_28435":51219,"_3074":51441},[],"Override the address written to `gateway.addresses`",{"_3697":173,"_31245":91,"_21577":51443,"_5":14884,"_28435":51219,"_3074":51444},[],"`--otel`",{"_3697":174,"_31245":91,"_21577":51446,"_5":14884,"_28435":51219,"_3074":6823},[],{"_3697":175,"_31245":91,"_21577":51448,"_5":14884,"_28435":51219,"_3074":51449},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3697":176,"_31245":91,"_21577":51451,"_5":14884,"_28435":51219,"_3074":51452},[],"`--development`",{"_3697":177,"_31245":91,"_21577":51454,"_5":14884,"_28435":51219,"_3074":6823},[],{"_3697":178,"_31245":91,"_21577":51456,"_5":14884,"_28435":51219,"_3074":51457},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3697":179,"_31245":91,"_21577":51459,"_5":14884,"_28435":51219,"_3074":51460},[],"`--sample-data`",{"_3697":180,"_31245":91,"_21577":51462,"_5":14884,"_28435":51219,"_3074":6823},[],{"_3697":181,"_31245":91,"_21577":51464,"_5":14884,"_28435":51219,"_3074":51465},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3697":182,"_31245":91,"_21577":51467,"_5":14884,"_28435":51219,"_3074":51468},[],"`--with-hsm`",{"_3697":183,"_31245":91,"_21577":51470,"_5":14884,"_28435":51219,"_3074":6823},[],{"_3697":184,"_31245":91,"_21577":51472,"_5":14884,"_28435":51219,"_3074":51473},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3697":185,"_31245":91,"_21577":51475,"_5":14884,"_28435":51219,"_3074":51476},[],"`--softhsm-chart-path`",{"_3697":186,"_31245":91,"_21577":51478,"_5":14884,"_28435":51219,"_3074":51479},[],"`./charts/softhsm`",{"_3697":187,"_31245":91,"_21577":51481,"_5":14884,"_28435":51219,"_3074":51482},[],"Use a different local SoftHSM chart",{"_3697":188,"_31245":91,"_21577":51484,"_5":14884,"_28435":51219,"_3074":51485},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3697":189,"_31245":91,"_21577":51487,"_5":14884,"_28435":51223,"_3074":51488},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3697":190,"_31245":91,"_21577":51490,"_5":14884,"_28435":51223,"_3074":51491},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3697":191,"_31245":91,"_21577":51493,"_5":14884,"_28435":51223,"_3074":51494},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3697":192,"_31245":91,"_21577":51496,"_5":14884,"_28435":51223,"_3074":51497},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3697":193,"_31245":91,"_21577":51499,"_5":14884,"_28435":51223,"_3074":51500},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3697":194,"_31245":91,"_21577":51502,"_5":14884,"_28435":51223,"_3074":51503},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3697":195,"_31245":91,"_21577":51505,"_5":14884,"_28435":51227,"_3074":51506},[],"Fastlane:",{"_3697":196,"_31245":91,"_21577":51508,"_5":14884,"_28435":51227,"_3074":51509},[],"validates local tools and the selected cluster",{"_3697":197,"_31245":91,"_21577":51511,"_5":14884,"_28435":51227,"_3074":51512},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3697":198,"_31245":91,"_21577":51514,"_5":14884,"_28435":51227,"_3074":51515},[],"creates the namespace",{"_3697":199,"_31245":91,"_21577":51517,"_5":14884,"_28435":51227,"_3074":51518},[],"installs the External Secrets Operator and creates the PostgreSQL, RabbitMQ and Keycloak administrator credentials as Secrets through a Fake `ClusterSecretStore`",{"_3697":200,"_31245":91,"_21577":51520,"_5":14884,"_28435":51227,"_3074":51521},[],"installs PostgreSQL and creates the required databases",{"_3697":201,"_31245":91,"_21577":51523,"_5":14884,"_28435":51227,"_3074":51524},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3697":202,"_31245":91,"_21577":51526,"_5":14884,"_28435":51227,"_3074":51527},[],"installs RabbitMQ",{"_3697":203,"_31245":91,"_21577":51529,"_5":14884,"_28435":51227,"_3074":51530},[],"optionally installs observability and lab HSM components",{"_3697":204,"_31245":91,"_21577":51532,"_5":14884,"_28435":51227,"_3074":51533},[],"generates `lamassu.yaml`, which references the Secrets instead of inline credentials, and installs the Lamassu chart",{"_3697":205,"_31245":91,"_21577":51535,"_5":14884,"_28435":51227,"_3074":51536},[],"optionally loads sample data",{"_3697":206,"_31245":91,"_21577":51538,"_5":14884,"_28435":51227,"_3074":51539},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3697":207,"_31245":91,"_21577":51541,"_5":14884,"_28435":51231,"_3074":51542},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3697":208,"_31245":91,"_21577":51544,"_5":14884,"_28435":51231,"_3074":51545},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3697":209,"_31245":91,"_21577":51547,"_5":14884,"_28435":51235,"_3074":51548},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords and stores them in Kubernetes Secrets through the External Secrets Operator's Fake `ClusterSecretStore`. Fastlane writes `lamassu.yaml` in the current directory referencing those Secrets — the values file no longer contains the credentials.",{"_3697":210,"_31245":91,"_21577":51550,"_5":14884,"_28435":51235,"_3074":51551},[],"The Keycloak administrator password is not printed by the script. Retrieve it from the Secret when needed:",{"_3697":211,"_31245":91,"_21577":51553,"_5":14884,"_28435":51235,"_3074":51554},[],"The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3697":212,"_31245":91,"_21577":51556,"_5":14884,"_28435":51235,"_3074":51557},[],"The Fake `ClusterSecretStore` stores the credentials in plain text and is for lab use only: replace it with a real ESO provider for anything beyond a throwaway environment. Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3697":213,"_31245":91,"_21577":51559,"_5":14884,"_28435":51239,"_3074":51560},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3697":214,"_31245":214,"_5":15238,"_3074":51562,"_31570":51563,"_21577":51564,"_28435":214},"Install with Helm",[50948,50949,51055],[],{"_3697":215,"_31245":214,"_21577":51566,"_5":14884,"_28435":214,"_3074":51567},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3697":216,"_31245":214,"_5":31567,"_21577":51569,"_28435":51570,"_3074":51571},[],"/docs/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3697":217,"_31245":214,"_5":31567,"_21577":51573,"_28435":51574,"_3074":50958},[],"/docs/deployment/self-hosted/helm#before-you-begin",{"_3697":218,"_31245":214,"_5":31567,"_21577":51576,"_28435":51577,"_3074":51578},[],"/docs/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3697":219,"_31245":214,"_5":31567,"_21577":51580,"_28435":51581,"_3074":51582},[],"/docs/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3697":220,"_31245":214,"_5":31567,"_21577":51584,"_28435":51585,"_3074":51586},[],"/docs/deployment/self-hosted/helm#credentials-in-kubernetes-secrets","Credentials in Kubernetes Secrets",{"_3697":221,"_31245":214,"_5":31567,"_21577":51588,"_28435":51589,"_3074":51590},[],"/docs/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3697":222,"_31245":214,"_5":31567,"_21577":51592,"_28435":51593,"_3074":51594},[],"/docs/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3697":223,"_31245":214,"_5":31567,"_21577":51596,"_28435":51597,"_3074":51598},[],"/docs/deployment/self-hosted/helm#device-event-stream-sse","Device event stream (SSE)",{"_3697":224,"_31245":214,"_5":31567,"_21577":51600,"_28435":51601,"_3074":51602},[],"/docs/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3697":225,"_31245":214,"_5":31567,"_21577":51604,"_28435":51605,"_3074":51606},[],"/docs/deployment/self-hosted/helm#experimental-dashboard-terminal-optional","Experimental dashboard terminal (optional)",{"_3697":226,"_31245":214,"_5":31567,"_21577":51608,"_28435":51609,"_3074":51610},[],"/docs/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3697":227,"_31245":214,"_5":31567,"_21577":51612,"_28435":51613,"_3074":51614},[],"/docs/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3697":228,"_31245":214,"_5":31567,"_21577":51616,"_28435":51617,"_3074":51618},[],"/docs/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3697":229,"_31245":214,"_5":31567,"_21577":51620,"_28435":51621,"_3074":51622},[],"/docs/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3697":230,"_31245":214,"_21577":51624,"_5":14884,"_28435":51570,"_3074":51625},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3697":231,"_31245":214,"_21577":51627,"_5":14884,"_28435":51574,"_3074":51628},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3697":232,"_31245":214,"_21577":51630,"_5":14884,"_28435":51574,"_3074":51631},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3697":233,"_31245":214,"_21577":51633,"_5":14884,"_28435":51574,"_3074":51634},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3697":234,"_31245":214,"_21577":51636,"_5":14884,"_28435":51574,"_3074":51637},[],"a reachable RabbitMQ broker and credentials",{"_3697":235,"_31245":214,"_21577":51639,"_5":14884,"_28435":51574,"_3074":51640},[],"Kubernetes Secrets in the release namespace holding the PostgreSQL and RabbitMQ credentials (and SMTP credentials when SMTP authentication is required) — the chart reads credentials from Secrets and rejects inline values (see Credentials in Kubernetes Secrets)",{"_3697":236,"_31245":214,"_21577":51642,"_5":14884,"_28435":51574,"_3074":51643},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3697":237,"_31245":214,"_21577":51645,"_5":14884,"_28435":51574,"_3074":51646},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3697":238,"_31245":214,"_21577":51648,"_5":14884,"_28435":51574,"_3074":51649},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3697":239,"_31245":214,"_21577":51651,"_5":14884,"_28435":51574,"_3074":51652},[],"a StorageClass and an external traffic design",{"_3697":240,"_31245":214,"_21577":51654,"_5":14884,"_28435":51574,"_3074":51655},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3697":241,"_31245":214,"_21577":51657,"_5":14884,"_28435":51574,"_3074":51658},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3697":242,"_31245":214,"_21577":51660,"_5":14884,"_28435":51574,"_3074":51661},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3697":243,"_31245":214,"_21577":51663,"_5":14884,"_28435":51577,"_3074":51664},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3697":244,"_31245":214,"_21577":51666,"_5":14884,"_28435":51577,"_3074":51667},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3697":245,"_31245":214,"_21577":51669,"_5":14884,"_28435":51577,"_3074":51670},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3697":246,"_31245":214,"_21577":51672,"_5":14884,"_28435":51581,"_3074":51673},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3697":247,"_31245":214,"_21577":51675,"_5":14884,"_28435":51581,"_3074":51676},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3697":248,"_31245":214,"_21577":51678,"_5":14884,"_28435":51581,"_3074":51679},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3697":249,"_31245":214,"_21577":51681,"_5":14884,"_28435":51581,"_3074":51682},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3697":250,"_31245":214,"_21577":51684,"_5":14884,"_28435":51581,"_3074":51685},[],"The chart runs workloads as `65532:65532` with the `RuntimeDefault` seccomp profile and no capabilities. It creates a dedicated ServiceAccount and does not mount its token by default. Ensure mounted volumes are accessible to that identity.",{"_3697":251,"_31245":214,"_21577":51687,"_5":14884,"_28435":51585,"_3074":51688},[],"The chart reads the PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace. Reference them with `existingSecret` plus the `usernameKey` and `passwordKey` data keys; inline `username` and `password` values are removed and rejected by `values.schema.json`.",{"_3697":252,"_31245":214,"_21577":51690,"_5":14884,"_28435":51585,"_3074":51691},[],"The Secrets must exist before you install or upgrade: the pre-install and pre-upgrade migration job connects to PostgreSQL with the PostgreSQL Secret, and the service containers read the AMQP and SMTP credentials when they start.",{"_3697":253,"_31245":214,"_21577":51693,"_5":14884,"_28435":51585,"_3074":51694},[],"`postgres.existingSecret` (default `lamassu-postgres`) and `amqp.existingSecret` (default `lamassu-amqp`) are always required.",{"_3697":254,"_31245":214,"_21577":51696,"_5":14884,"_28435":51585,"_3074":51697},[],"`services.alerts.smtp_server.existingSecret` is empty by default, which means SMTP without authentication. Set it, together with its key names, only when your SMTP server requires authentication.",{"_3697":255,"_31245":214,"_21577":51699,"_5":14884,"_28435":51585,"_3074":51700},[],"Each `services.authz.credentials` entry names its `database` and uses the global PostgreSQL Secret — `postgres.existingSecret` with its configured key names — unless the entry sets its own `existingSecret`.",{"_3697":256,"_31245":214,"_21577":51702,"_5":14884,"_28435":51585,"_3074":51703},[],"Changing a Secret's contents does not roll the pods that consume it: the services read the credentials when they start. Restart the affected pods after rotating a credential.",{"_3697":257,"_31245":214,"_21577":51705,"_5":14884,"_28435":51585,"_3074":51706},[],"For production, manage the Secrets with the External Secrets Operator (ESO), which the chart does not install. The `charts/lamassu/README.md` in the Helm repository documents a complete working example in its *Secret management* section: installing external-secrets 0.20.2, a test `ClusterSecretStore`, the `ExternalSecret` resources and the wait before installing the chart. Its Fake provider is for testing only — replace it with your provider's configuration for anything beyond a throwaway environment; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager and other providers are documented at external-secrets.io.",{"_3697":258,"_31245":214,"_21577":51708,"_5":14884,"_28435":51585,"_3074":51709},[],"Only these credentials moved into Secrets: other values, such as connector and crypto-engine settings, are still configured through the values file.",{"_3697":259,"_31245":214,"_21577":51711,"_5":14884,"_28435":51589,"_3074":51712},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3697":260,"_31245":214,"_21577":51714,"_5":14884,"_28435":51593,"_3074":51715},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3697":261,"_31245":214,"_21577":51717,"_5":14884,"_28435":51593,"_3074":51718},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3697":262,"_31245":214,"_21577":51720,"_5":14884,"_28435":51593,"_3074":51721},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3697":263,"_31245":214,"_21577":51723,"_5":14884,"_28435":51593,"_3074":51724},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — the chart's default pod security context already sets `fsGroup: 65532` for every service pod, so this top-up applies only when an explicit `podSecurityContext` without `fsGroup` was overridden and an AMQP client Secret is configured — and it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3697":264,"_31245":214,"_21577":51726,"_5":14884,"_28435":51593,"_3074":51727},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3697":265,"_31245":214,"_21577":51729,"_5":14884,"_28435":51593,"_3074":51730},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3697":266,"_31245":214,"_21577":51732,"_5":14884,"_28435":51593,"_3074":51733},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3697":267,"_31245":214,"_21577":51735,"_5":14884,"_28435":51597,"_3074":51736},[],"`services.deviceManager.sseEnabled` (default `true`) controls whether Device Manager serves its device-event stream over Server-Sent Events (SSE). With the default, the chart renders a dedicated gateway rule for the device-events endpoint with an 11-minute request timeout, because the Gateway's default request timeout is too short for these streams, which the service keeps open for up to about ten minutes. Device Manager calls that are not SSE requests keep the Gateway's default timeout.",{"_3697":268,"_31245":214,"_21577":51738,"_5":14884,"_28435":51597,"_3074":51739},[],"Set it to `false` to disable the stream: the chart then renders `sse_enabled: false` in the Device Manager configuration and omits the gateway rule, and SSE requests to the device-events endpoint fail. See Device events in the 3.8.0 to 4.0.0 upgrade guide.",{"_3697":269,"_31245":214,"_21577":51741,"_5":14884,"_28435":51601,"_3074":51742},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3697":270,"_31245":214,"_21577":51744,"_5":14884,"_28435":51601,"_3074":51745},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3697":271,"_31245":214,"_21577":51747,"_5":14884,"_28435":51601,"_3074":51748},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3697":272,"_31245":214,"_21577":51750,"_5":14884,"_28435":51601,"_3074":51751},[],"See Access control for the principal and policy model.",{"_3697":273,"_31245":214,"_21577":51753,"_5":14884,"_28435":51605,"_3074":51754},[],"The dashboard includes an experimental browser terminal for working with devices. It is disabled by default; enable it in the values file:",{"_3697":274,"_31245":214,"_21577":51756,"_5":14884,"_28435":51605,"_3074":51757},[],"Enabling the terminal requires external authorization: set `auth.externalAuthorization.enabled: true` and `auth.externalAuthorization.failOpen: false`. The chart refuses to render the release otherwise, because the terminal's WebSocket endpoint would then be exposed through the Gateway without external authorization.",{"_3697":275,"_31245":214,"_21577":51759,"_5":14884,"_28435":51605,"_3074":51760},[],"Only identities granted the preloaded \"Terminal Network\" policy can open terminal sessions. See Access control for how policies are assigned.",{"_3697":276,"_31245":214,"_21577":51762,"_5":14884,"_28435":51605,"_3074":51763},[],"Note that even with the terminal enabled, pods inside the cluster can still reach the UI service directly unless network policies restrict that access — the external authorization applies to traffic entering through the Gateway.",{"_3697":277,"_31245":214,"_21577":51765,"_5":14884,"_28435":51609,"_3074":51766},[],"To install a local checkout instead:",{"_3697":278,"_31245":214,"_21577":51768,"_5":14884,"_28435":51613,"_3074":51769},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3697":279,"_31245":214,"_21577":51771,"_5":14884,"_28435":51613,"_3074":51772},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3697":280,"_31245":214,"_21577":51774,"_5":14884,"_28435":51617,"_3074":51775},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3697":281,"_31245":214,"_21577":51777,"_5":14884,"_28435":51617,"_3074":51778},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3697":282,"_31245":214,"_21577":51780,"_5":14884,"_28435":51617,"_3074":51781},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3697":283,"_31245":214,"_21577":51783,"_5":14884,"_28435":51617,"_3074":51784},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3697":284,"_31245":214,"_21577":51786,"_5":14884,"_28435":51617,"_3074":51787},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3697":285,"_31245":214,"_21577":51789,"_5":14884,"_28435":51621,"_3074":51790},[],"Before going live, review:",{"_3697":286,"_31245":214,"_21577":51792,"_5":14884,"_28435":51621,"_3074":51793},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3697":287,"_31245":214,"_21577":51795,"_5":14884,"_28435":51621,"_3074":51796},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3697":288,"_31245":214,"_21577":51798,"_5":14884,"_28435":51621,"_3074":51799},[],"shared VA storage before increasing VA replicas",{"_3697":289,"_31245":214,"_21577":51801,"_5":14884,"_28435":51621,"_3074":51802},[],"managed OIDC roles and removal of evaluation credentials",{"_3697":290,"_31245":214,"_21577":51804,"_5":14884,"_28435":51621,"_3074":51805},[],"a trusted TLS issuer or externally managed certificate",{"_3697":291,"_31245":214,"_21577":51807,"_5":14884,"_28435":51621,"_3074":51808},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3697":292,"_31245":214,"_21577":51810,"_5":14884,"_28435":51621,"_3074":51811},[],"SMTP, observability and alert delivery",{"_3697":293,"_31245":214,"_21577":51813,"_5":14884,"_28435":51621,"_3074":51814},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3697":294,"_31245":214,"_21577":51816,"_5":14884,"_28435":51621,"_3074":51817},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3697":295,"_31245":295,"_5":15238,"_3074":51819,"_31570":51820,"_21577":51821,"_28435":295},"Expose the Gateway",[50948,50949,51055],[],{"_3697":296,"_31245":295,"_21577":51823,"_5":14884,"_28435":295,"_3074":51824},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3697":297,"_31245":295,"_5":31567,"_21577":51826,"_28435":51827,"_3074":51828},[],"/docs/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3697":298,"_31245":295,"_5":31567,"_21577":51830,"_28435":51831,"_3074":51832},[],"/docs/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3697":299,"_31245":295,"_5":31567,"_21577":51834,"_28435":51835,"_3074":51836},[],"/docs/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3697":300,"_31245":295,"_5":31567,"_21577":51838,"_28435":51839,"_3074":51840},[],"/docs/deployment/self-hosted/networking#k3s","K3s",{"_3697":301,"_31245":295,"_5":31567,"_21577":51842,"_28435":51843,"_3074":51844},[],"/docs/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3697":302,"_31245":295,"_5":31567,"_21577":51846,"_28435":51847,"_3074":51848},[],"/docs/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3697":303,"_31245":295,"_5":31567,"_21577":51850,"_28435":51851,"_3074":51852},[],"/docs/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3697":304,"_31245":295,"_5":31567,"_21577":51854,"_28435":51855,"_3074":51856},[],"/docs/deployment/self-hosted/networking#client-certificates-and-identity-headers","Client certificates and identity headers",{"_3697":305,"_31245":295,"_5":31567,"_21577":51858,"_28435":51859,"_3074":51860},[],"/docs/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3697":306,"_31245":295,"_5":31567,"_21577":51862,"_28435":51863,"_3074":51864},[],"/docs/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3697":307,"_31245":295,"_5":31567,"_21577":51866,"_28435":51867,"_3074":51868},[],"/docs/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3697":308,"_31245":295,"_21577":51870,"_5":14884,"_28435":51827,"_3074":51871},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3697":309,"_31245":295,"_21577":51873,"_5":14884,"_28435":51827,"_3074":51874},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3697":310,"_31245":295,"_21577":51876,"_5":14884,"_28435":51831,"_3074":51877},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3697":311,"_31245":295,"_21577":51879,"_5":14884,"_28435":51831,"_3074":51880},[],"Set it only when:",{"_3697":312,"_31245":295,"_21577":51882,"_5":14884,"_28435":51831,"_3074":51883},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3697":313,"_31245":295,"_21577":51885,"_5":14884,"_28435":51831,"_3074":51886},[],"that address is allocated to this Gateway",{"_3697":314,"_31245":295,"_21577":51888,"_5":14884,"_28435":51831,"_3074":51889},[],"the surrounding network already routes traffic for it to the cluster",{"_3697":315,"_31245":295,"_21577":51891,"_5":14884,"_28435":51831,"_3074":51892},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3697":316,"_31245":295,"_21577":51894,"_5":14884,"_28435":51831,"_3074":51895},[],"Keep these two settings separate:",{"_3697":317,"_31245":295,"_21577":51897,"_5":14884,"_28435":51831,"_3074":51898},[],"`gateway.addresses` requests an address for the Gateway.",{"_3697":318,"_31245":295,"_21577":51900,"_5":14884,"_28435":51831,"_3074":51901},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3697":319,"_31245":295,"_21577":51903,"_5":14884,"_28435":51831,"_3074":51904},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3697":320,"_31245":295,"_21577":51906,"_5":14884,"_28435":51835,"_3074":51907},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3697":321,"_31245":295,"_21577":51909,"_5":14884,"_28435":51835,"_3074":51910},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3697":322,"_31245":295,"_21577":51912,"_5":14884,"_28435":51839,"_3074":51913},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3697":323,"_31245":295,"_21577":51915,"_5":14884,"_28435":51839,"_3074":51916},[],"For the recommended design:",{"_3697":324,"_31245":295,"_21577":51918,"_5":14884,"_28435":51839,"_3074":51919},[],"Use only one externally exposed Lamassu Gateway.",{"_3697":325,"_31245":295,"_21577":51921,"_5":14884,"_28435":51839,"_3074":51922},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3697":326,"_31245":295,"_21577":51924,"_5":14884,"_28435":51839,"_3074":51925},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3697":327,"_31245":295,"_21577":51927,"_5":14884,"_28435":51839,"_3074":51928},[],"Point DNS at the VM's reachable address.",{"_3697":328,"_31245":295,"_21577":51930,"_5":14884,"_28435":51839,"_3074":51931},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3697":329,"_31245":295,"_21577":51933,"_5":14884,"_28435":51843,"_3074":51934},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3697":330,"_31245":295,"_21577":51936,"_5":14884,"_28435":51847,"_3074":51937},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3697":331,"_31245":295,"_21577":51939,"_5":14884,"_28435":51847,"_3074":51940},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3697":332,"_31245":295,"_21577":51942,"_5":14884,"_28435":51851,"_3074":51943},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3697":333,"_31245":295,"_21577":51945,"_5":14884,"_28435":51851,"_3074":51946},[],"Requirement",{"_3697":334,"_31245":295,"_21577":51948,"_5":14884,"_28435":51851,"_3074":51949},[],"Recommended design",{"_3697":335,"_31245":295,"_21577":51951,"_5":14884,"_28435":51851,"_3074":51952},[],"Consequence",{"_3697":336,"_31245":295,"_21577":51954,"_5":14884,"_28435":51851,"_3074":51955},[],"Several Lamassu URLs or services",{"_3697":337,"_31245":295,"_21577":51957,"_5":14884,"_28435":51851,"_3074":51958},[],"One Gateway with multiple routes",{"_3697":338,"_31245":295,"_21577":51960,"_5":14884,"_28435":51851,"_3074":51961},[],"One IP and one proxy fleet; this is the chart default",{"_3697":339,"_31245":295,"_21577":51963,"_5":14884,"_28435":51851,"_3074":51964},[],"Independent Gateways and separate external IPs",{"_3697":340,"_31245":295,"_21577":51966,"_5":14884,"_28435":51851,"_3074":51967},[],"One VIP per Gateway",{"_3697":341,"_31245":295,"_21577":51969,"_5":14884,"_28435":51851,"_3074":51970},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3697":342,"_31245":295,"_21577":51972,"_5":14884,"_28435":51851,"_3074":51973},[],"Independent Gateways on one node and one IP",{"_3697":343,"_31245":295,"_21577":51975,"_5":14884,"_28435":51851,"_3074":51976},[],"Use different external ports",{"_3697":344,"_31245":295,"_21577":51978,"_5":14884,"_28435":51851,"_3074":51979},[],"Clients must include non-standard ports",{"_3697":345,"_31245":295,"_21577":51981,"_5":14884,"_28435":51851,"_3074":51982},[],"Separate TLS/mTLS termination behind one IP",{"_3697":346,"_31245":295,"_21577":51984,"_5":14884,"_28435":51851,"_3074":51985},[],"Front-door SNI routing to internal Gateways",{"_3697":347,"_31245":295,"_21577":51987,"_5":14884,"_28435":51851,"_3074":51988},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3697":348,"_31245":295,"_21577":51990,"_5":14884,"_28435":51851,"_3074":51991},[],"Separate Gateway resources but shared proxy infrastructure",{"_3697":349,"_31245":295,"_21577":51993,"_5":14884,"_28435":51851,"_3074":51994},[],"Envoy merged-Gateway mode",{"_3697":350,"_31245":295,"_21577":51996,"_5":14884,"_28435":51851,"_3074":51997},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3697":351,"_31245":295,"_21577":51999,"_5":14884,"_28435":51851,"_3074":52000},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3697":352,"_31245":295,"_21577":52002,"_5":14884,"_28435":51851,"_3074":52003},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3697":353,"_31245":295,"_21577":52005,"_5":14884,"_28435":51851,"_3074":52006},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3697":354,"_31245":295,"_21577":52008,"_5":14884,"_28435":51851,"_3074":52009},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3697":355,"_31245":295,"_21577":52011,"_5":14884,"_28435":51855,"_3074":52012},[],"The chart renders a `ClientTrafficPolicy` named `enable-mtls` on its shared Gateway automatically; no Helm value enables or disables it. TLS termination accepts requests with or without a client certificate: devices may present one, but they are not required to. Before forwarding a request, the Gateway removes identity and certificate headers that a client could otherwise supply itself: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (the Traefik spelling), `Ssl-Client-Cert` and `X-Amzn-Mtls-Clientcert`. The Traefik spelling is included because backends that accept `X-Forwarded-Tls-Client-Cert` directly would otherwise receive certificate identity data supplied by the client itself, without a client certificate having been presented. After stripping, Envoy adds its own `X-Forwarded-Client-Cert` carrying the presented certificate and its chain, so services that read certificate identity receive only gateway-generated values. No Helm value changes the list of stripped headers. The Access control page describes how `authz` uses this protection to keep `X-Principal-ID` out of reach of clients.",{"_3697":356,"_31245":295,"_21577":52014,"_5":14884,"_28435":51859,"_3074":52015},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3697":357,"_31245":295,"_21577":52017,"_5":14884,"_28435":51859,"_3074":52018},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3697":358,"_31245":295,"_21577":52020,"_5":14884,"_28435":51859,"_3074":52021},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3697":359,"_31245":295,"_21577":52023,"_5":14884,"_28435":51859,"_3074":52024},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3697":360,"_31245":295,"_21577":52026,"_5":14884,"_28435":51859,"_3074":52027},[],"If none of those are possible, use different external ports or change the external network design.",{"_3697":361,"_31245":295,"_21577":52029,"_5":14884,"_28435":51863,"_3074":52030},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3697":362,"_31245":295,"_21577":52032,"_5":14884,"_28435":51863,"_3074":52033},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3697":363,"_31245":295,"_21577":52035,"_5":14884,"_28435":51867,"_3074":52036},[],"Check, in order:",{"_3697":364,"_31245":295,"_21577":52038,"_5":14884,"_28435":51867,"_3074":52039},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3697":365,"_31245":295,"_21577":52041,"_5":14884,"_28435":51867,"_3074":52042},[],"Its status contains the expected address.",{"_3697":366,"_31245":295,"_21577":52044,"_5":14884,"_28435":51867,"_3074":52045},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3697":367,"_31245":295,"_21577":52047,"_5":14884,"_28435":51867,"_3074":52048},[],"Port 443 reaches that address from the client network.",{"_3697":368,"_31245":295,"_21577":52050,"_5":14884,"_28435":51867,"_3074":52051},[],"DNS resolves to the externally reachable endpoint.",{"_3697":369,"_31245":295,"_21577":52053,"_5":14884,"_28435":51867,"_3074":52054},[],"The certificate contains the DNS name or IP used by the client.",{"_3697":370,"_31245":295,"_21577":52056,"_5":14884,"_28435":51867,"_3074":52057},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3697":371,"_31245":371,"_5":15238,"_3074":51055,"_31570":52059,"_21577":52060,"_28435":371},[50948,50949,51055],[],{"_3697":372,"_31245":371,"_21577":52062,"_5":14884,"_28435":371,"_3074":52063},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3697":373,"_31245":371,"_5":31567,"_21577":52065,"_28435":52066,"_3074":52067},[],"/docs/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3697":374,"_31245":371,"_5":31567,"_21577":52069,"_28435":52070,"_3074":52071},[],"/docs/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3697":375,"_31245":371,"_5":31567,"_21577":52073,"_28435":52074,"_3074":52075},[],"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3697":376,"_31245":371,"_5":31567,"_21577":52077,"_28435":52078,"_3074":52079},[],"/docs/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3697":377,"_31245":371,"_5":31567,"_21577":52081,"_28435":52082,"_3074":52083},[],"/docs/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3697":378,"_31245":371,"_5":31567,"_21577":52085,"_28435":52086,"_3074":52087},[],"/docs/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3697":379,"_31245":371,"_21577":52089,"_5":14884,"_28435":52066,"_3074":52090},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3697":380,"_31245":371,"_21577":52092,"_5":14884,"_28435":52070,"_3074":52093},[],"Workflow",{"_3697":381,"_31245":371,"_21577":52095,"_5":14884,"_28435":52070,"_3074":52096},[],"Use it for",{"_3697":382,"_31245":371,"_21577":52098,"_5":14884,"_28435":52070,"_3074":52099},[],"What it installs",{"_3697":383,"_31245":371,"_21577":52101,"_5":14884,"_28435":52070,"_3074":52102},[],"Helm",{"_3697":384,"_31245":371,"_21577":52104,"_5":14884,"_28435":52070,"_3074":52105},[],"Production and controlled environments",{"_3697":385,"_31245":371,"_21577":52107,"_5":14884,"_28435":52070,"_3074":52108},[],"Lamassu services and Gateway API resources",{"_3697":386,"_31245":371,"_21577":52110,"_5":14884,"_28435":52070,"_3074":51192},[],{"_3697":387,"_31245":371,"_21577":52112,"_5":14884,"_28435":52070,"_3074":52113},[],"Evaluation, demos, CI and small lab clusters",{"_3697":388,"_31245":371,"_21577":52115,"_5":14884,"_28435":52070,"_3074":52116},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3697":389,"_31245":371,"_21577":52118,"_5":14884,"_28435":52074,"_3074":52119},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3697":390,"_31245":371,"_21577":52121,"_5":14884,"_28435":52074,"_3074":52122},[],"Area",{"_3697":391,"_31245":371,"_21577":52124,"_5":14884,"_28435":52074,"_3074":52125},[],"The Lamassu chart provides",{"_3697":392,"_31245":371,"_21577":52127,"_5":14884,"_28435":52074,"_3074":52128},[],"You provide",{"_3697":393,"_31245":371,"_21577":52130,"_5":14884,"_28435":52074,"_3074":52131},[],"Lamassu applications",{"_3697":394,"_31245":371,"_21577":52133,"_5":14884,"_28435":52074,"_3074":52134},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3697":395,"_31245":371,"_21577":52136,"_5":14884,"_28435":52074,"_3074":52137},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3697":396,"_31245":371,"_21577":52139,"_5":14884,"_28435":52074,"_3074":52140},[],"PostgreSQL data",{"_3697":397,"_31245":371,"_21577":52142,"_5":14884,"_28435":52074,"_3074":52143},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3697":398,"_31245":371,"_21577":52145,"_5":14884,"_28435":52074,"_3074":52146},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3697":399,"_31245":371,"_21577":52148,"_5":14884,"_28435":52074,"_3074":52149},[],"Messaging",{"_3697":400,"_31245":371,"_21577":52151,"_5":14884,"_28435":52074,"_3074":52152},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3697":401,"_31245":371,"_21577":52154,"_5":14884,"_28435":52074,"_3074":52155},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3697":402,"_31245":371,"_21577":52157,"_5":14884,"_28435":52074,"_3074":52158},[],"Identity",{"_3697":403,"_31245":371,"_21577":52160,"_5":14884,"_28435":52074,"_3074":52161},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3697":404,"_31245":371,"_21577":52163,"_5":14884,"_28435":52074,"_3074":52164},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3697":405,"_31245":371,"_21577":52166,"_5":14884,"_28435":52074,"_3074":52167},[],"External routing",{"_3697":406,"_31245":371,"_21577":52169,"_5":14884,"_28435":52074,"_3074":52170},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3697":407,"_31245":371,"_21577":52172,"_5":14884,"_28435":52074,"_3074":52173},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3697":408,"_31245":371,"_21577":52175,"_5":14884,"_28435":52074,"_3074":52176},[],"TLS",{"_3697":409,"_31245":371,"_21577":52178,"_5":14884,"_28435":52074,"_3074":52179},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3697":410,"_31245":371,"_21577":52181,"_5":14884,"_28435":52074,"_3074":52182},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3697":411,"_31245":371,"_21577":52184,"_5":14884,"_28435":52074,"_3074":52185},[],"Persistent application data",{"_3697":412,"_31245":371,"_21577":52187,"_5":14884,"_28435":52074,"_3074":52188},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3697":413,"_31245":371,"_21577":52190,"_5":14884,"_28435":52074,"_3074":52191},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3697":414,"_31245":371,"_21577":52193,"_5":14884,"_28435":52074,"_3074":52194},[],"Optional integrations",{"_3697":415,"_31245":371,"_21577":52196,"_5":14884,"_28435":52074,"_3074":52197},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3697":416,"_31245":371,"_21577":52199,"_5":14884,"_28435":52074,"_3074":52200},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3697":417,"_31245":371,"_21577":52202,"_5":14884,"_28435":52074,"_3074":52203},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3697":418,"_31245":371,"_21577":52205,"_5":14884,"_28435":52074,"_3074":52206},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3697":419,"_31245":371,"_21577":52208,"_5":14884,"_28435":52078,"_3074":52209},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3697":420,"_31245":371,"_21577":52211,"_5":14884,"_28435":52078,"_3074":52212},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3697":421,"_31245":371,"_21577":52214,"_5":14884,"_28435":52082,"_3074":52215},[],"Kubernetes 1.24 or newer",{"_3697":422,"_31245":371,"_21577":52217,"_5":14884,"_28435":52082,"_3074":52218},[],"Helm 3.2 or newer",{"_3697":423,"_31245":371,"_21577":52220,"_5":14884,"_28435":52082,"_3074":52221},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3697":424,"_31245":371,"_21577":52223,"_5":14884,"_28435":52082,"_3074":52224},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3697":425,"_31245":371,"_21577":52226,"_5":14884,"_28435":52082,"_3074":52227},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3697":426,"_31245":371,"_21577":52229,"_5":14884,"_28435":52082,"_3074":52230},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3697":427,"_31245":371,"_21577":52232,"_5":14884,"_28435":52082,"_3074":52233},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3697":428,"_31245":371,"_21577":52235,"_5":14884,"_28435":52086,"_3074":52236},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3697":429,"_31245":371,"_21577":52238,"_5":14884,"_28435":52086,"_3074":52239},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3697":430,"_31245":371,"_21577":52241,"_5":14884,"_28435":52086,"_3074":52242},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3697":431,"_31245":371,"_21577":52244,"_5":14884,"_28435":52086,"_3074":52245},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3697":432,"_31245":432,"_5":15238,"_3074":52247,"_31570":52248,"_21577":52250,"_28435":432},"Deployment troubleshooting",[50948,50949,52249],"Operations",[],{"_3697":433,"_31245":432,"_21577":52252,"_5":14884,"_28435":432,"_3074":52253},[],"Diagnose access, service health and infrastructure dependencies.",{"_3697":434,"_31245":432,"_5":31567,"_21577":52255,"_28435":52256,"_3074":52257},[],"/docs/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3697":435,"_31245":432,"_5":31567,"_21577":52259,"_28435":52260,"_3074":52261},[],"/docs/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3697":436,"_31245":432,"_5":31567,"_21577":52263,"_28435":52264,"_3074":52265},[],"/docs/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3697":437,"_31245":432,"_5":31567,"_21577":52267,"_28435":52268,"_3074":52269},[],"/docs/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3697":438,"_31245":432,"_5":31567,"_21577":52271,"_28435":52272,"_3074":52273},[],"/docs/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3697":439,"_31245":432,"_5":31567,"_21577":52275,"_28435":52276,"_3074":52277},[],"/docs/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3697":440,"_31245":432,"_5":31567,"_21577":52279,"_28435":52280,"_3074":52281},[],"/docs/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3697":441,"_31245":432,"_5":31567,"_21577":52283,"_28435":52284,"_3074":52285},[],"/docs/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3697":442,"_31245":432,"_5":31567,"_21577":52287,"_28435":52288,"_3074":52289},[],"/docs/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3697":443,"_31245":432,"_5":31567,"_21577":52291,"_28435":52292,"_3074":52293},[],"/docs/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3697":444,"_31245":432,"_5":31567,"_21577":52295,"_28435":52296,"_3074":52297},[],"/docs/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3697":445,"_31245":432,"_5":31567,"_21577":52299,"_28435":52300,"_3074":52301},[],"/docs/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3697":446,"_31245":432,"_5":31567,"_21577":52303,"_28435":52304,"_3074":52305},[],"/docs/deployment/troubleshooting#observability","Observability",{"_3697":447,"_31245":432,"_21577":52307,"_5":14884,"_28435":432,"_3074":52308},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3697":448,"_31245":432,"_21577":52310,"_5":14884,"_28435":52260,"_3074":52311},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3697":449,"_31245":432,"_21577":52313,"_5":14884,"_28435":52264,"_3074":52314},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3697":450,"_31245":432,"_21577":52316,"_5":14884,"_28435":52268,"_3074":52317},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3697":451,"_31245":432,"_21577":52319,"_5":14884,"_28435":52272,"_3074":52320},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3697":452,"_31245":432,"_21577":52322,"_5":14884,"_28435":52276,"_3074":52323},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3697":453,"_31245":432,"_21577":52325,"_5":14884,"_28435":52280,"_3074":52326},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3697":454,"_31245":432,"_21577":52328,"_5":14884,"_28435":52280,"_3074":52329},[],"Also run the chart's connectivity test:",{"_3697":455,"_31245":432,"_21577":52331,"_5":14884,"_28435":52280,"_3074":52332},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3697":456,"_31245":432,"_21577":52334,"_5":14884,"_28435":52280,"_3074":52335},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3697":457,"_31245":432,"_21577":52337,"_5":14884,"_28435":52284,"_3074":52338},[],"If you receive a 401:",{"_3697":458,"_31245":432,"_21577":52340,"_5":14884,"_28435":52284,"_3074":52341},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3697":459,"_31245":432,"_21577":52343,"_5":14884,"_28435":52284,"_3074":52344},[],"verify issuer, audience and expiration of the token;",{"_3697":460,"_31245":432,"_21577":52346,"_5":14884,"_28435":52284,"_3074":52347},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3697":461,"_31245":432,"_21577":52349,"_5":14884,"_28435":52284,"_3074":52350},[],"check that the provider's public and internal routes point to the same realm.",{"_3697":462,"_31245":432,"_21577":52352,"_5":14884,"_28435":52284,"_3074":52353},[],"If login succeeds but the APIs return 403:",{"_3697":463,"_31245":432,"_21577":52355,"_5":14884,"_28435":52284,"_3074":52356},[],"inspect the token's real claims;",{"_3697":464,"_31245":432,"_21577":52358,"_5":14884,"_28435":52284,"_3074":52359},[],"confirm they match an active principal;",{"_3697":465,"_31245":432,"_21577":52361,"_5":14884,"_28435":52284,"_3074":52362},[],"review the policies granted to that principal;",{"_3697":466,"_31245":432,"_21577":52364,"_5":14884,"_28435":52284,"_3074":52365},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3697":467,"_31245":432,"_21577":52367,"_5":14884,"_28435":52284,"_3074":52368},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3697":468,"_31245":432,"_21577":52370,"_5":14884,"_28435":52288,"_3074":52371},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3697":469,"_31245":432,"_21577":52373,"_5":14884,"_28435":52288,"_3074":52374},[],"Locate the authz pod and Service.",{"_3697":470,"_31245":432,"_21577":52376,"_5":14884,"_28435":52288,"_3074":52377},[],"Check /health, logs and its database connection.",{"_3697":471,"_31245":432,"_21577":52379,"_5":14884,"_28435":52288,"_3074":52380},[],"Verify the DNS and port configured in externalAuthorization.",{"_3697":472,"_31245":432,"_21577":52382,"_5":14884,"_28435":52288,"_3074":52383},[],"Check the check route is /v1/ext\\_authz/check.",{"_3697":473,"_31245":432,"_21577":52385,"_5":14884,"_28435":52288,"_3074":52386},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3697":474,"_31245":432,"_21577":52388,"_5":14884,"_28435":52292,"_3074":52389},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3697":475,"_31245":432,"_21577":52391,"_5":14884,"_28435":52296,"_3074":52392},[],"Review kubectl describe pod first. Common causes are:",{"_3697":476,"_31245":432,"_21577":52394,"_5":14884,"_28435":52296,"_3074":52395},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3697":477,"_31245":432,"_21577":52397,"_5":14884,"_28435":52296,"_3074":52398},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3697":478,"_31245":432,"_21577":52400,"_5":14884,"_28435":52296,"_3074":52401},[],"unbound persistent volume;",{"_3697":479,"_31245":432,"_21577":52403,"_5":14884,"_28435":52296,"_3074":52404},[],"inaccessible image or incorrect pull policy;",{"_3697":480,"_31245":432,"_21577":52406,"_5":14884,"_28435":52296,"_3074":52407},[],"invalid cryptographic engine configuration;",{"_3697":481,"_31245":432,"_21577":52409,"_5":14884,"_28435":52296,"_3074":52410},[],"CPU or memory limits set too low;",{"_3697":482,"_31245":432,"_21577":52412,"_5":14884,"_28435":52296,"_3074":52413},[],"an incomplete prior migration.",{"_3697":483,"_31245":432,"_21577":52415,"_5":14884,"_28435":52296,"_3074":52416},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3697":484,"_31245":432,"_21577":52418,"_5":14884,"_28435":52296,"_3074":52419},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3697":485,"_31245":432,"_21577":52421,"_5":14884,"_28435":52296,"_3074":52422},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3697":486,"_31245":432,"_21577":52424,"_5":14884,"_28435":52300,"_3074":52425},[],"Domain and audit events depend on the bus publisher:",{"_3697":487,"_31245":432,"_21577":52427,"_5":14884,"_28435":52300,"_3074":52428},[],"verify it is enabled in the emitting service;",{"_3697":488,"_31245":432,"_21577":52430,"_5":14884,"_28435":52300,"_3074":52431},[],"check AMQP connectivity and credentials;",{"_3697":489,"_31245":432,"_21577":52433,"_5":14884,"_28435":52300,"_3074":52434},[],"review exchange, routing key, queues and consumers;",{"_3697":490,"_31245":432,"_21577":52436,"_5":14884,"_28435":52300,"_3074":52437},[],"inspect dead-letter queues;",{"_3697":491,"_31245":432,"_21577":52439,"_5":14884,"_28435":52300,"_3074":52440},[],"alert on orphan durable queues and backlog growth.",{"_3697":492,"_31245":432,"_21577":52442,"_5":14884,"_28435":52300,"_3074":52443},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3697":493,"_31245":432,"_21577":52445,"_5":14884,"_28435":52300,"_3074":52446},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3697":494,"_31245":432,"_21577":52448,"_5":14884,"_28435":52300,"_3074":52449},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3697":495,"_31245":432,"_21577":52451,"_5":14884,"_28435":52300,"_3074":52452},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3697":496,"_31245":432,"_21577":52454,"_5":14884,"_28435":52300,"_3074":52455},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3697":497,"_31245":432,"_21577":52457,"_5":14884,"_28435":52300,"_3074":52458},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3697":498,"_31245":432,"_21577":52460,"_5":14884,"_28435":52300,"_3074":52461},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3697":499,"_31245":432,"_21577":52463,"_5":14884,"_28435":52304,"_3074":52464},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3697":500,"_31245":432,"_21577":52466,"_5":14884,"_28435":52304,"_3074":52467},[],"Before closing an incident, record:",{"_3697":501,"_31245":432,"_21577":52469,"_5":14884,"_28435":52304,"_3074":52470},[],"the confirmed cause;",{"_3697":502,"_31245":432,"_21577":52472,"_5":14884,"_28435":52304,"_3074":52473},[],"the time scope and affected resources;",{"_3697":503,"_31245":432,"_21577":52475,"_5":14884,"_28435":52304,"_3074":52476},[],"the commands or queries used;",{"_3697":504,"_31245":432,"_21577":52478,"_5":14884,"_28435":52304,"_3074":52479},[],"the applied change and how to revert it;",{"_3697":505,"_31245":432,"_21577":52481,"_5":14884,"_28435":52304,"_3074":52482},[],"validation from a consumer;",{"_3697":506,"_31245":432,"_21577":52484,"_5":14884,"_28435":52304,"_3074":52485},[],"the preventive action and its owner.",{"_3697":507,"_31245":507,"_5":15238,"_3074":52487,"_31570":52488,"_21577":52492,"_28435":507},"Data model",[50948,52489,52490,52491],"Platform","Administration","Access control",[],{"_3697":508,"_31245":507,"_21577":52494,"_5":14884,"_28435":507,"_3074":52495},[],"Entities and relationships from the pki.json schema that authz uses to evaluate access policies.",{"_3697":509,"_31245":507,"_5":31567,"_21577":52497,"_28435":52498,"_3074":52499},[],"/docs/platform/administration/access-control/data-model#schema-relationships","Schema relationships",{"_3697":510,"_31245":507,"_5":31567,"_21577":52501,"_28435":52502,"_3074":52503},[],"/docs/platform/administration/access-control/data-model#schema-entities","Schema entities",{"_3697":511,"_31245":507,"_21577":52505,"_5":14884,"_28435":507,"_3074":52506},[],"The `connectors/authz/pki.json` schema defines the entities in the `pki` authorization namespace. A policy identifies a resource type through `namespace: pki`, `schema_name` and `entity_type`. For example, `ca.certificate` identifies the `certificate` entity type in the `ca` schema.",{"_3697":512,"_31245":507,"_21577":52508,"_5":14884,"_28435":52498,"_3074":52509},[],"Each arrow starts at the entity that declares the relationship and points to its `target_entity`. The value of `foreign_key`, the source column, appears below the label. In `pki.json`, each relationship's `name` matches that column. Select the diagram to enlarge it and scroll through it.",{"_3697":513,"_31245":507,"_21577":52511,"_5":14884,"_28435":52498,"_3074":52512},[],"A policy can propagate actions from the referenced entity to the one that declares the relationship. For example, to grant read access to a DMS's devices, a rule starts from `dmsmanager.dms`, targets `devicemanager.device` and specifies `via: dms_owner`.",{"_3697":514,"_31245":507,"_21577":52514,"_5":14884,"_28435":52498,"_3074":52515},[],"When filtering inherited access, `authz` matches the `foreign_key` column against the first `primary_key` column of the referenced entity. For example, it matches `subject_common_name` to `device.id`, `issuer_meta_serial_number` to `ca_certificate.id` and the links to `kms_key` to `kms_key.key_id`.",{"_3697":515,"_31245":507,"_21577":52517,"_5":14884,"_28435":52502,"_3074":52518},[],"Entity (`schema_name.entity_type`)",{"_3697":516,"_31245":507,"_21577":52520,"_5":14884,"_28435":52502,"_3074":52521},[],"Table (`table_name`)",{"_3697":517,"_31245":507,"_21577":52523,"_5":14884,"_28435":52502,"_3074":52524},[],"Key (`primary_key`)",{"_3697":518,"_31245":507,"_21577":52526,"_5":14884,"_28435":52502,"_3074":52527},[],"`alerts.event`",{"_3697":519,"_31245":507,"_21577":52529,"_5":14884,"_28435":52502,"_3074":52530},[],"`events`",{"_3697":520,"_31245":507,"_21577":52532,"_5":14884,"_28435":52502,"_3074":52533},[],"`event_type`",{"_3697":521,"_31245":507,"_21577":52535,"_5":14884,"_28435":52502,"_3074":52536},[],"`alerts.subscription`",{"_3697":522,"_31245":507,"_21577":52538,"_5":14884,"_28435":52502,"_3074":52539},[],"`subscriptions`",{"_3697":523,"_31245":507,"_21577":52541,"_5":14884,"_28435":52502,"_3074":52542},[],"`id`",{"_3697":524,"_31245":507,"_21577":52544,"_5":14884,"_28435":52502,"_3074":52545},[],"`ca.ca_certificate`",{"_3697":525,"_31245":507,"_21577":52547,"_5":14884,"_28435":52502,"_3074":52548},[],"`ca_certificates`",{"_3697":526,"_31245":507,"_21577":52550,"_5":14884,"_28435":52502,"_3074":52542},[],{"_3697":527,"_31245":507,"_21577":52552,"_5":14884,"_28435":52502,"_3074":52553},[],"`ca.certificate`",{"_3697":528,"_31245":507,"_21577":52555,"_5":14884,"_28435":52502,"_3074":52556},[],"`certificates`",{"_3697":529,"_31245":507,"_21577":52558,"_5":14884,"_28435":52502,"_3074":52559},[],"`serial_number`",{"_3697":530,"_31245":507,"_21577":52561,"_5":14884,"_28435":52502,"_3074":52562},[],"`ca.issuance_profile`",{"_3697":531,"_31245":507,"_21577":52564,"_5":14884,"_28435":52502,"_3074":52565},[],"`issuance_profiles`",{"_3697":532,"_31245":507,"_21577":52567,"_5":14884,"_28435":52502,"_3074":52542},[],{"_3697":533,"_31245":507,"_21577":52569,"_5":14884,"_28435":52502,"_3074":52570},[],"`devicemanager.device_group`",{"_3697":534,"_31245":507,"_21577":52572,"_5":14884,"_28435":52502,"_3074":52573},[],"`device_groups`",{"_3697":535,"_31245":507,"_21577":52575,"_5":14884,"_28435":52502,"_3074":52542},[],{"_3697":536,"_31245":507,"_21577":52577,"_5":14884,"_28435":52502,"_3074":52578},[],"`devicemanager.device`",{"_3697":537,"_31245":507,"_21577":52580,"_5":14884,"_28435":52502,"_3074":52581},[],"`devices`",{"_3697":538,"_31245":507,"_21577":52583,"_5":14884,"_28435":52502,"_3074":52542},[],{"_3697":539,"_31245":507,"_21577":52585,"_5":14884,"_28435":52502,"_3074":52586},[],"`dmsmanager.dms`",{"_3697":540,"_31245":507,"_21577":52588,"_5":14884,"_28435":52502,"_3074":52589},[],"`dms`",{"_3697":541,"_31245":507,"_21577":52591,"_5":14884,"_28435":52502,"_3074":52542},[],{"_3697":542,"_31245":507,"_21577":52593,"_5":14884,"_28435":52502,"_3074":52594},[],"`kms.kms_key`",{"_3697":543,"_31245":507,"_21577":52596,"_5":14884,"_28435":52502,"_3074":52597},[],"`kms_keys`",{"_3697":544,"_31245":507,"_21577":52599,"_5":14884,"_28435":52502,"_3074":52600},[],"`key_id`, `engine_id`",{"_3697":545,"_31245":507,"_21577":52602,"_5":14884,"_28435":52502,"_3074":52603},[],"`va.crl_settings`",{"_3697":546,"_31245":507,"_21577":52605,"_5":14884,"_28435":52502,"_3074":52606},[],"`crl_settings`",{"_3697":547,"_31245":507,"_21577":52608,"_5":14884,"_28435":52502,"_3074":52609},[],"`ca_id`",{"_3697":548,"_31245":507,"_21577":52611,"_5":14884,"_28435":52502,"_3074":52612},[],"Events, subscriptions and device groups have their own actions and filters. Their `relations` lists are empty and they have zero incoming references in the schema. For `ca.certificate`, `view_tables` also lists `certificates_view`.",{"_3697":549,"_31245":507,"_21577":52614,"_5":14884,"_28435":52502,"_3074":52615},[],"Each entity declares instance-level operations in `atomic_actions`, operations that require no resource ID in `global_actions`, and the columns and types accepted by `column_filters` in `filterable`.",{"_3697":550,"_31245":507,"_21577":52617,"_5":14884,"_28435":52502,"_3074":52618},[],"<Card title=\"Access inherited through relations\" href=\"/docs/platform/administration/access-control#access-inherited-through-relations\" />",{"_3697":551,"_31245":551,"_5":15238,"_3074":52620,"_31570":52621,"_21577":52622,"_28435":551},"Access control overview",[50948,52489,52490,52491],[],{"_3697":552,"_31245":551,"_21577":52624,"_5":14884,"_28435":551,"_3074":52625},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3697":553,"_31245":551,"_5":31567,"_21577":52627,"_28435":52628,"_3074":52629},[],"/docs/platform/administration/access-control#essential-concepts","Essential concepts",{"_3697":554,"_31245":551,"_5":31567,"_21577":52631,"_28435":52632,"_3074":52633},[],"/docs/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3697":555,"_31245":551,"_5":31567,"_21577":52635,"_28435":52636,"_3074":52637},[],"/docs/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3697":556,"_31245":551,"_5":31567,"_21577":52639,"_28435":52640,"_3074":52641},[],"/docs/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3697":557,"_31245":551,"_5":31567,"_21577":52643,"_28435":52644,"_3074":52645},[],"/docs/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3697":558,"_31245":551,"_5":31567,"_21577":52647,"_28435":52648,"_3074":52649},[],"/docs/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3697":559,"_31245":551,"_5":31567,"_21577":52651,"_28435":52652,"_3074":52653},[],"/docs/platform/administration/access-control#oidc-principals","OIDC principals",{"_3697":560,"_31245":551,"_5":31567,"_21577":52655,"_28435":52656,"_3074":52657},[],"/docs/platform/administration/access-control#x509-principals","X.509 principals",{"_3697":561,"_31245":551,"_5":31567,"_21577":52659,"_28435":52660,"_3074":52661},[],"/docs/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3697":562,"_31245":551,"_5":31567,"_21577":52663,"_28435":52664,"_3074":52665},[],"/docs/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3697":563,"_31245":551,"_5":31567,"_21577":52667,"_28435":52668,"_3074":52669},[],"/docs/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3697":564,"_31245":551,"_5":31567,"_21577":52671,"_28435":52672,"_3074":52673},[],"/docs/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3697":565,"_31245":551,"_5":31567,"_21577":52675,"_28435":52676,"_3074":52677},[],"/docs/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3697":566,"_31245":551,"_5":31567,"_21577":52679,"_28435":52680,"_3074":52681},[],"/docs/platform/administration/access-control#http-rules","HTTP rules",{"_3697":567,"_31245":551,"_5":31567,"_21577":52683,"_28435":52684,"_3074":52685},[],"/docs/platform/administration/access-control#included-policies","Included policies",{"_3697":568,"_31245":551,"_5":31567,"_21577":52687,"_28435":52688,"_3074":51602},[],"/docs/platform/administration/access-control#provision-the-first-administrator",{"_3697":569,"_31245":551,"_5":31567,"_21577":52690,"_28435":52691,"_3074":52692},[],"/docs/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3697":570,"_31245":551,"_5":31567,"_21577":52694,"_28435":52695,"_3074":52696},[],"/docs/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3697":571,"_31245":551,"_5":31567,"_21577":52698,"_28435":52699,"_3074":52700},[],"/docs/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3697":572,"_31245":551,"_5":31567,"_21577":52702,"_28435":52703,"_3074":52704},[],"/docs/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3697":573,"_31245":551,"_5":31567,"_21577":52706,"_28435":52707,"_3074":52708},[],"/docs/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3697":574,"_31245":551,"_5":31567,"_21577":52710,"_28435":52711,"_3074":52712},[],"/docs/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3697":575,"_31245":551,"_5":31567,"_21577":52714,"_28435":52715,"_3074":52716},[],"/docs/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3697":576,"_31245":551,"_5":31567,"_21577":52718,"_28435":52719,"_3074":52720},[],"/docs/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3697":577,"_31245":551,"_5":31567,"_21577":52722,"_28435":52723,"_3074":52724},[],"/docs/platform/administration/access-control#operational-checklist","Operational checklist",{"_3697":578,"_31245":551,"_5":31567,"_21577":52726,"_28435":52727,"_3074":52728},[],"/docs/platform/administration/access-control#diagnostics","Diagnostics",{"_3697":579,"_31245":551,"_5":31567,"_21577":52730,"_28435":52731,"_3074":52732},[],"/docs/platform/administration/access-control#the-response-is-401","The response is 401",{"_3697":580,"_31245":551,"_5":31567,"_21577":52734,"_28435":52735,"_3074":52736},[],"/docs/platform/administration/access-control#the-response-is-403","The response is 403",{"_3697":581,"_31245":551,"_5":31567,"_21577":52738,"_28435":52739,"_3074":52740},[],"/docs/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3697":582,"_31245":551,"_5":31567,"_21577":52742,"_28435":52743,"_3074":52744},[],"/docs/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3697":583,"_31245":551,"_5":31567,"_21577":52746,"_28435":52747,"_3074":52748},[],"/docs/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3697":584,"_31245":551,"_21577":52750,"_5":14884,"_28435":551,"_3074":52751},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3697":585,"_31245":551,"_21577":52753,"_5":14884,"_28435":551,"_3074":52754},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3697":586,"_31245":551,"_21577":52756,"_5":14884,"_28435":551,"_3074":52757},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3697":587,"_31245":551,"_21577":52759,"_5":14884,"_28435":52628,"_3074":52760},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3697":588,"_31245":551,"_21577":52762,"_5":14884,"_28435":52628,"_3074":52763},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3697":589,"_31245":551,"_21577":52765,"_5":14884,"_28435":52628,"_3074":52766},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3697":590,"_31245":551,"_21577":52768,"_5":14884,"_28435":52628,"_3074":52769},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3697":591,"_31245":551,"_21577":52771,"_5":14884,"_28435":52628,"_3074":52772},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3697":592,"_31245":551,"_21577":52774,"_5":14884,"_28435":52628,"_3074":52775},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3697":593,"_31245":551,"_21577":52777,"_5":14884,"_28435":52632,"_3074":52778},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3697":594,"_31245":551,"_21577":52780,"_5":14884,"_28435":52632,"_3074":52781},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3697":595,"_31245":551,"_21577":52783,"_5":14884,"_28435":52636,"_3074":52784},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3697":596,"_31245":551,"_21577":52786,"_5":14884,"_28435":52636,"_3074":52787},[],"The decision is made **before forwarding the request to the service**:",{"_3697":597,"_31245":551,"_21577":52789,"_5":14884,"_28435":52636,"_3074":52790},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3697":598,"_31245":551,"_21577":52792,"_5":14884,"_28435":52636,"_3074":52793},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3697":599,"_31245":551,"_21577":52795,"_5":14884,"_28435":52636,"_3074":52796},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3697":600,"_31245":551,"_21577":52798,"_5":14884,"_28435":52636,"_3074":52799},[],"It separately loads the policies granted to each principal.",{"_3697":601,"_31245":551,"_21577":52801,"_5":14884,"_28435":52636,"_3074":52802},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3697":602,"_31245":551,"_21577":52804,"_5":14884,"_28435":52636,"_3074":52805},[],"`authz` looks for an HTTP rule granting that action.",{"_3697":603,"_31245":551,"_21577":52807,"_5":14884,"_28435":52636,"_3074":52808},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3697":604,"_31245":551,"_21577":52810,"_5":14884,"_28435":52636,"_3074":52811},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3697":605,"_31245":551,"_21577":52813,"_5":14884,"_28435":52636,"_3074":52814},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context. Clients cannot forge this header: the Gateway removes client-supplied `X-Principal-Id` (and the other forwarded identity and certificate headers) before forwarding, so only `authz` can set it. See Expose the Gateway for the full list of stripped headers.",{"_3697":606,"_31245":551,"_21577":52816,"_5":14884,"_28435":52636,"_3074":52817},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3697":607,"_31245":551,"_21577":52819,"_5":14884,"_28435":52640,"_3074":52820},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3697":608,"_31245":551,"_21577":52822,"_5":14884,"_28435":52640,"_3074":52823},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3697":609,"_31245":551,"_21577":52825,"_5":14884,"_28435":52640,"_3074":52826},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3697":610,"_31245":551,"_21577":52828,"_5":14884,"_28435":52640,"_3074":52829},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3697":611,"_31245":551,"_21577":52831,"_5":14884,"_28435":52640,"_3074":52832},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3697":612,"_31245":551,"_21577":52834,"_5":14884,"_28435":52640,"_3074":52835},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3697":613,"_31245":551,"_21577":52837,"_5":14884,"_28435":52640,"_3074":52838},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3697":614,"_31245":551,"_21577":52840,"_5":14884,"_28435":52640,"_3074":52841},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3697":615,"_31245":551,"_21577":52843,"_5":14884,"_28435":52640,"_3074":52844},[],"A schema can also make an individual route accept the credential from the URL. **`query_token: true` on a route** makes it accept the OIDC access token from the `access_token` query parameter, but only when the request carries neither an `Authorization: Bearer` header nor a client-certificate header: a credential in a header always wins. The token is validated and authorized exactly like a Bearer token, so the route's action still requires a policy grant, and routes that do not opt in never read the query parameter. The dashboard's experimental browser terminal uses this mechanism, because the WebSocket connection its browser client opens cannot set request headers.",{"_3697":616,"_31245":551,"_21577":52846,"_5":14884,"_28435":52640,"_3074":52847},[],"Query strings are often recorded. `authz` replaces the `access_token` value with `REDACTED` in its own decision logs, but other logs that capture the URL — the Gateway access log, service request logs, tracing — are not redacted. Keep `query_token` for WebSocket routes and short-lived tokens.",{"_3697":617,"_31245":551,"_21577":52849,"_5":14884,"_28435":52644,"_3074":52850},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3697":618,"_31245":551,"_21577":52852,"_5":14884,"_28435":52644,"_3074":52853},[],"The decision is made with the domain operation context:",{"_3697":619,"_31245":551,"_21577":52855,"_5":14884,"_28435":52644,"_3074":52856},[],"The middleware extracts the credential and resolves the matching principals.",{"_3697":620,"_31245":551,"_21577":52858,"_5":14884,"_28435":52644,"_3074":52859},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3697":621,"_31245":551,"_21577":52861,"_5":14884,"_28435":52644,"_3074":52862},[],"`authz` gathers the entity rules of the granted policies.",{"_3697":622,"_31245":551,"_21577":52864,"_5":14884,"_28435":52644,"_3074":52865},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3697":623,"_31245":551,"_21577":52867,"_5":14884,"_28435":52644,"_3074":52868},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3697":624,"_31245":551,"_21577":52870,"_5":14884,"_28435":52644,"_3074":52871},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3697":625,"_31245":551,"_21577":52873,"_5":14884,"_28435":52644,"_3074":52874},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3697":626,"_31245":551,"_21577":52876,"_5":14884,"_28435":52644,"_3074":52877},[],"Actions fall into two groups:",{"_3697":627,"_31245":551,"_21577":52879,"_5":14884,"_28435":52644,"_3074":52880},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3697":628,"_31245":551,"_21577":52882,"_5":14884,"_28435":52644,"_3074":52883},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3697":629,"_31245":551,"_21577":52885,"_5":14884,"_28435":52644,"_3074":52886},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3697":630,"_31245":551,"_21577":52888,"_5":14884,"_28435":52648,"_3074":52889},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3697":631,"_31245":551,"_21577":52891,"_5":14884,"_28435":52648,"_3074":52892},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3697":632,"_31245":551,"_21577":52894,"_5":14884,"_28435":52648,"_3074":52895},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3697":633,"_31245":551,"_21577":52897,"_5":14884,"_28435":52652,"_3074":52898},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3697":634,"_31245":551,"_21577":52900,"_5":14884,"_28435":52652,"_3074":52901},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3697":635,"_31245":551,"_21577":52903,"_5":14884,"_28435":52652,"_3074":52904},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3697":636,"_31245":551,"_21577":52906,"_5":14884,"_28435":52652,"_3074":52907},[],"The implemented operators are:",{"_3697":637,"_31245":551,"_21577":52909,"_5":14884,"_28435":52652,"_3074":52910},[],"`equals`, for exact equality;",{"_3697":638,"_31245":551,"_21577":52912,"_5":14884,"_28435":52652,"_3074":52913},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3697":639,"_31245":551,"_21577":52915,"_5":14884,"_28435":52652,"_3074":52916},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3697":640,"_31245":551,"_21577":52918,"_5":14884,"_28435":52652,"_3074":52919},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3697":641,"_31245":551,"_21577":52921,"_5":14884,"_28435":52656,"_3074":52922},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3697":642,"_31245":551,"_21577":52924,"_5":14884,"_28435":52656,"_3074":52925},[],"The available modes are:",{"_3697":643,"_31245":551,"_21577":52927,"_5":14884,"_28435":52656,"_3074":52928},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3697":644,"_31245":551,"_21577":52930,"_5":14884,"_28435":52656,"_3074":52931},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3697":645,"_31245":551,"_21577":52933,"_5":14884,"_28435":52656,"_3074":52934},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3697":646,"_31245":551,"_21577":52936,"_5":14884,"_28435":52656,"_3074":52937},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3697":647,"_31245":551,"_21577":52939,"_5":14884,"_28435":52656,"_3074":52940},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3697":648,"_31245":551,"_21577":52942,"_5":14884,"_28435":52656,"_3074":52943},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3697":649,"_31245":551,"_21577":52945,"_5":14884,"_28435":52660,"_3074":52946},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3697":650,"_31245":551,"_21577":52948,"_5":14884,"_28435":52660,"_3074":52949},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3697":651,"_31245":551,"_21577":52951,"_5":14884,"_28435":52660,"_3074":52952},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3697":652,"_31245":551,"_21577":52954,"_5":14884,"_28435":52660,"_3074":52955},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3697":653,"_31245":551,"_21577":52957,"_5":14884,"_28435":52668,"_3074":52958},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3697":654,"_31245":551,"_21577":52960,"_5":14884,"_28435":52668,"_3074":52961},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3697":655,"_31245":551,"_21577":52963,"_5":14884,"_28435":52672,"_3074":52964},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3697":656,"_31245":551,"_21577":52966,"_5":14884,"_28435":52672,"_3074":52967},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3697":657,"_31245":551,"_21577":52969,"_5":14884,"_28435":52672,"_3074":52970},[],"The data model shows how the resources used in entity rules are connected.",{"_3697":658,"_31245":551,"_21577":52972,"_5":14884,"_28435":52672,"_3074":52973},[],"A rule can only follow relations that the data schema declares between its two entities. You can reference the relation by its name or by its foreign-key column — both spellings are equivalent, and it is the schema that decides which column the query uses. When you save a policy, `authz` checks every relation against the loaded schemas: one that no schema declares, or one pointing at an entity that is not loaded, is rejected at that moment.",{"_3697":659,"_31245":551,"_21577":52975,"_5":14884,"_28435":52672,"_3074":52976},[],"Policies stored before this validation may still carry relations the schemas do not declare. Such a relation grants nothing: `authz` logs a warning, `skipping relation that grants nothing`, naming the policy and the relation, and continues evaluating the rest of the policy. The reference is always resolved against the schema before any query is built, so an undeclared relation can never alter it. If inherited access narrows after an upgrade, check the `authz` logs for this warning and correct the relation of the affected policy.",{"_3697":660,"_31245":551,"_21577":52978,"_5":14884,"_28435":52676,"_3074":52979},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3697":661,"_31245":551,"_21577":52981,"_5":14884,"_28435":52676,"_3074":52982},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3697":662,"_31245":551,"_21577":52984,"_5":14884,"_28435":52676,"_3074":52985},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3697":663,"_31245":551,"_21577":52987,"_5":14884,"_28435":52680,"_3074":52988},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3697":664,"_31245":551,"_21577":52990,"_5":14884,"_28435":52680,"_3074":52991},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3697":665,"_31245":551,"_21577":52993,"_5":14884,"_28435":52680,"_3074":52994},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3697":666,"_31245":551,"_21577":52996,"_5":14884,"_28435":52680,"_3074":52997},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3697":667,"_31245":551,"_21577":52999,"_5":14884,"_28435":52680,"_3074":53000},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3697":668,"_31245":551,"_21577":53002,"_5":14884,"_28435":52680,"_3074":53003},[],"Note that:",{"_3697":669,"_31245":551,"_21577":53005,"_5":14884,"_28435":52680,"_3074":53006},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3697":670,"_31245":551,"_21577":53008,"_5":14884,"_28435":52680,"_3074":53009},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3697":671,"_31245":551,"_21577":53011,"_5":14884,"_28435":52680,"_3074":53012},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3697":672,"_31245":551,"_21577":53014,"_5":14884,"_28435":52684,"_3074":53015},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3697":673,"_31245":551,"_21577":53017,"_5":14884,"_28435":52684,"_3074":53018},[],"full and read-only access to certificates and authorities;",{"_3697":674,"_31245":551,"_21577":53020,"_5":14884,"_28435":52684,"_3074":53021},[],"full and read-only access to the KMS;",{"_3697":675,"_31245":551,"_21577":53023,"_5":14884,"_28435":52684,"_3074":53024},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3697":676,"_31245":551,"_21577":53026,"_5":14884,"_28435":52684,"_3074":53027},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3697":677,"_31245":551,"_21577":53029,"_5":14884,"_28435":52684,"_3074":53030},[],"console access;",{"_3697":678,"_31245":551,"_21577":53032,"_5":14884,"_28435":52684,"_3074":53033},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3697":679,"_31245":551,"_21577":53035,"_5":14884,"_28435":52684,"_3074":53036},[],"access to the dashboard's experimental terminal (Terminal Network);",{"_3697":680,"_31245":551,"_21577":53038,"_5":14884,"_28435":52684,"_3074":53039},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3697":681,"_31245":551,"_21577":53041,"_5":14884,"_28435":52684,"_3074":53042},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3697":682,"_31245":551,"_21577":53044,"_5":14884,"_28435":52684,"_3074":53045},[],"The Terminal Network policy is created by the `authz` preload the next time `authz` starts after the upgrade. Preloaded policies are system policies — their ids begin with `lamassu.` — and cannot be edited through the API.",{"_3697":683,"_31245":551,"_21577":53047,"_5":14884,"_28435":52688,"_3074":53048},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3697":684,"_31245":551,"_21577":53050,"_5":14884,"_28435":52688,"_3074":53051},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3697":685,"_31245":551,"_21577":53053,"_5":14884,"_28435":52688,"_3074":53054},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3697":686,"_31245":551,"_21577":53056,"_5":14884,"_28435":52691,"_3074":53057},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3697":687,"_31245":551,"_21577":53059,"_5":14884,"_28435":52695,"_3074":53060},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3697":688,"_31245":551,"_21577":53062,"_5":14884,"_28435":52695,"_3074":53063},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3697":689,"_31245":551,"_21577":53065,"_5":14884,"_28435":52699,"_3074":53066},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3697":690,"_31245":551,"_21577":53068,"_5":14884,"_28435":52703,"_3074":53069},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3697":691,"_31245":551,"_21577":53071,"_5":14884,"_28435":52707,"_3074":53072},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3697":692,"_31245":551,"_21577":53074,"_5":14884,"_28435":52711,"_3074":53075},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3697":693,"_31245":551,"_21577":53077,"_5":14884,"_28435":52711,"_3074":53078},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3697":694,"_31245":551,"_21577":53080,"_5":14884,"_28435":52715,"_3074":53081},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3697":695,"_31245":551,"_21577":53083,"_5":14884,"_28435":52715,"_3074":53084},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3697":696,"_31245":551,"_21577":53086,"_5":14884,"_28435":52715,"_3074":53087},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3697":697,"_31245":551,"_21577":53089,"_5":14884,"_28435":52715,"_3074":53090},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3697":698,"_31245":551,"_21577":53092,"_5":14884,"_28435":52715,"_3074":53093},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3697":699,"_31245":551,"_21577":53095,"_5":14884,"_28435":52715,"_3074":53096},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3697":700,"_31245":551,"_21577":53098,"_5":14884,"_28435":52715,"_3074":53099},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3697":701,"_31245":551,"_21577":53101,"_5":14884,"_28435":52715,"_3074":53102},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3697":702,"_31245":551,"_21577":53104,"_5":14884,"_28435":52719,"_3074":53105},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3697":703,"_31245":551,"_21577":53107,"_5":14884,"_28435":52719,"_3074":53108},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3697":704,"_31245":551,"_21577":53110,"_5":14884,"_28435":52719,"_3074":53111},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3697":705,"_31245":551,"_21577":53113,"_5":14884,"_28435":52723,"_3074":53114},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3697":706,"_31245":551,"_21577":53116,"_5":14884,"_28435":52723,"_3074":53117},[],"Use groups or stable roles for people and independent identities for automations.",{"_3697":707,"_31245":551,"_21577":53119,"_5":14884,"_28435":52723,"_3074":53120},[],"Keep at least two recovery administrators and test their access periodically.",{"_3697":708,"_31245":551,"_21577":53122,"_5":14884,"_28435":52723,"_3074":53123},[],"Review active principals, their matches and their grants after IdP changes.",{"_3697":709,"_31245":551,"_21577":53125,"_5":14884,"_28435":52723,"_3074":53126},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3697":710,"_31245":551,"_21577":53128,"_5":14884,"_28435":52723,"_3074":53129},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3697":711,"_31245":551,"_21577":53131,"_5":14884,"_28435":52723,"_3074":53132},[],"Always test one allowed and one denied operation for each role.",{"_3697":712,"_31245":551,"_21577":53134,"_5":14884,"_28435":52723,"_3074":53135},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3697":713,"_31245":551,"_21577":53137,"_5":14884,"_28435":52731,"_3074":53138},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3697":714,"_31245":551,"_21577":53140,"_5":14884,"_28435":52735,"_3074":53141},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3697":715,"_31245":551,"_21577":53143,"_5":14884,"_28435":52735,"_3074":53144},[],"that an active principal of the correct type exists;",{"_3697":716,"_31245":551,"_21577":53146,"_5":14884,"_28435":52735,"_3074":53147},[],"that the claim paths and values match the real token exactly;",{"_3697":717,"_31245":551,"_21577":53149,"_5":14884,"_28435":52735,"_3074":53150},[],"that all of the principal's conditions hold;",{"_3697":718,"_31245":551,"_21577":53152,"_5":14884,"_28435":52735,"_3074":53153},[],"that the principal has the expected policy granted;",{"_3697":719,"_31245":551,"_21577":53155,"_5":14884,"_28435":52735,"_3074":53156},[],"that the policy includes the action and the requested resource type or route;",{"_3697":720,"_31245":551,"_21577":53158,"_5":14884,"_28435":52735,"_3074":53159},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3697":721,"_31245":551,"_21577":53161,"_5":14884,"_28435":52735,"_3074":53162},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3697":722,"_31245":551,"_21577":53164,"_5":14884,"_28435":52735,"_3074":53165},[],"If a policy that relied on inherited access stopped granting it after an upgrade, look in the `authz` logs for `skipping relation that grants nothing`: the warning names the policy and the relation the schemas no longer declare. Correct that policy's relation so it matches the current schemas.",{"_3697":723,"_31245":551,"_21577":53167,"_5":14884,"_28435":52739,"_3074":53168},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3697":724,"_31245":551,"_21577":53170,"_5":14884,"_28435":52743,"_3074":53171},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3697":725,"_31245":551,"_21577":53173,"_5":14884,"_28435":52747,"_3074":53174},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3697":726,"_31245":551,"_21577":53176,"_5":14884,"_28435":52747,"_3074":53177},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3697":727,"_31245":727,"_5":15238,"_3074":53179,"_31570":53180,"_21577":53181,"_28435":727},"Alerts and subscriptions",[50948,52489,52490],[],{"_3697":728,"_31245":727,"_21577":53183,"_5":14884,"_28435":727,"_3074":53184},[],"Send PKI events to people and external systems.",{"_3697":729,"_31245":727,"_5":31567,"_21577":53186,"_28435":53187,"_3074":53188},[],"/docs/platform/administration/alerts#how-it-works","How it works",{"_3697":730,"_31245":727,"_5":31567,"_21577":53190,"_28435":53191,"_3074":53192},[],"/docs/platform/administration/alerts#available-channels","Available channels",{"_3697":731,"_31245":727,"_5":31567,"_21577":53194,"_28435":53195,"_3074":53196},[],"/docs/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3697":732,"_31245":727,"_5":31567,"_21577":53198,"_28435":53199,"_3074":53200},[],"/docs/platform/administration/alerts#choose-the-event","Choose the event",{"_3697":733,"_31245":727,"_5":31567,"_21577":53202,"_28435":53203,"_3074":53204},[],"/docs/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3697":734,"_31245":727,"_5":31567,"_21577":53206,"_28435":53207,"_3074":53208},[],"/docs/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3697":735,"_31245":727,"_5":31567,"_21577":53210,"_28435":53211,"_3074":53212},[],"/docs/platform/administration/alerts#review-and-activate","Review and activate",{"_3697":736,"_31245":727,"_5":31567,"_21577":53214,"_28435":53215,"_3074":53216},[],"/docs/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3697":737,"_31245":727,"_5":31567,"_21577":53218,"_28435":53219,"_3074":53220},[],"/docs/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3697":738,"_31245":727,"_5":31567,"_21577":53222,"_28435":53223,"_3074":53224},[],"/docs/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3697":739,"_31245":727,"_5":31567,"_21577":53226,"_28435":53227,"_3074":53228},[],"/docs/platform/administration/alerts#event-families","Event families",{"_3697":740,"_31245":727,"_21577":53230,"_5":14884,"_28435":727,"_3074":53231},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3697":741,"_31245":727,"_21577":53233,"_5":14884,"_28435":53187,"_3074":53234},[],"A service publishes a domain event.",{"_3697":742,"_31245":727,"_21577":53236,"_5":14884,"_28435":53187,"_3074":53237},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3697":743,"_31245":727,"_21577":53239,"_5":14884,"_28435":53187,"_3074":53240},[],"Each subscription's filter decides whether it should be notified.",{"_3697":744,"_31245":727,"_21577":53242,"_5":14884,"_28435":53187,"_3074":53243},[],"Lamassu delivers the event to the configured channel.",{"_3697":745,"_31245":727,"_21577":53245,"_5":14884,"_28435":53187,"_3074":53246},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3697":746,"_31245":727,"_21577":53248,"_5":14884,"_28435":53191,"_3074":53249},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3697":747,"_31245":727,"_21577":53251,"_5":14884,"_28435":53191,"_3074":53252},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3697":748,"_31245":727,"_21577":53254,"_5":14884,"_28435":53191,"_3074":53255},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3697":749,"_31245":727,"_21577":53257,"_5":14884,"_28435":53191,"_3074":53258},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3697":750,"_31245":727,"_21577":53260,"_5":14884,"_28435":53191,"_3074":53261},[],"`apikey_options` requires `header` and `key`.",{"_3697":751,"_31245":727,"_21577":53263,"_5":14884,"_28435":53191,"_3074":53264},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3697":752,"_31245":727,"_21577":53266,"_5":14884,"_28435":53191,"_3074":53267},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3697":753,"_31245":727,"_21577":53269,"_5":14884,"_28435":53191,"_3074":53270},[],"The alerts API reference documents the full `http_client` schema.",{"_3697":754,"_31245":727,"_21577":53272,"_5":14884,"_28435":53199,"_3074":53273},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3697":755,"_31245":727,"_21577":53275,"_5":14884,"_28435":53203,"_3074":53276},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3697":756,"_31245":727,"_21577":53278,"_5":14884,"_28435":53207,"_3074":53279},[],"Add a filter if you don't want to receive every instance of the event.",{"_3697":757,"_31245":727,"_21577":53281,"_5":14884,"_28435":53207,"_3074":53282},[],"**None** notifies all instances of the event.",{"_3697":758,"_31245":727,"_21577":53284,"_5":14884,"_28435":53207,"_3074":53285},[],"**JSON Path** evaluates one or more specific fields.",{"_3697":759,"_31245":727,"_21577":53287,"_5":14884,"_28435":53207,"_3074":53288},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3697":760,"_31245":727,"_21577":53290,"_5":14884,"_28435":53207,"_3074":53291},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3697":761,"_31245":727,"_21577":53293,"_5":14884,"_28435":53207,"_3074":53294},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3697":762,"_31245":727,"_21577":53296,"_5":14884,"_28435":53207,"_3074":53297},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3697":763,"_31245":727,"_21577":53299,"_5":14884,"_28435":53211,"_3074":53300},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3697":764,"_31245":727,"_21577":53302,"_5":14884,"_28435":53215,"_3074":53303},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3697":765,"_31245":727,"_21577":53305,"_5":14884,"_28435":53215,"_3074":53306},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3697":766,"_31245":727,"_21577":53308,"_5":14884,"_28435":53215,"_3074":53309},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3697":767,"_31245":727,"_21577":53311,"_5":14884,"_28435":53215,"_3074":53312},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3697":768,"_31245":727,"_21577":53314,"_5":14884,"_28435":53215,"_3074":53315},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3697":769,"_31245":727,"_21577":53317,"_5":14884,"_28435":53215,"_3074":53318},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3697":770,"_31245":727,"_21577":53320,"_5":14884,"_28435":53215,"_3074":53321},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3697":771,"_31245":727,"_21577":53323,"_5":14884,"_28435":53215,"_3074":53324},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3697":772,"_31245":727,"_21577":53326,"_5":14884,"_28435":53219,"_3074":53327},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3697":773,"_31245":727,"_21577":53329,"_5":14884,"_28435":53219,"_3074":53330},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3697":774,"_31245":727,"_21577":53332,"_5":14884,"_28435":53219,"_3074":53333},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3697":775,"_31245":727,"_21577":53335,"_5":14884,"_28435":53219,"_3074":53336},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3697":776,"_31245":727,"_21577":53338,"_5":14884,"_28435":53219,"_3074":53339},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3697":777,"_31245":727,"_21577":53341,"_5":14884,"_28435":53219,"_3074":53342},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3697":778,"_31245":727,"_21577":53344,"_5":14884,"_28435":53219,"_3074":53345},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3697":779,"_31245":727,"_21577":53347,"_5":14884,"_28435":53219,"_3074":53348},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3697":780,"_31245":727,"_21577":53350,"_5":14884,"_28435":53223,"_3074":53351},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3697":781,"_31245":727,"_21577":53353,"_5":14884,"_28435":53223,"_3074":53354},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3697":782,"_31245":727,"_21577":53356,"_5":14884,"_28435":53227,"_3074":53357},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3697":783,"_31245":727,"_21577":53359,"_5":14884,"_28435":53227,"_3074":53360},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3697":784,"_31245":727,"_21577":53362,"_5":14884,"_28435":53227,"_3074":53363},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3697":785,"_31245":727,"_21577":53365,"_5":14884,"_28435":53227,"_3074":53366},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3697":786,"_31245":727,"_21577":53368,"_5":14884,"_28435":53227,"_3074":53369},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3697":787,"_31245":727,"_21577":53371,"_5":14884,"_28435":53227,"_3074":53372},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` and `va.crl-settings.delete`.",{"_3697":788,"_31245":727,"_21577":53374,"_5":14884,"_28435":53227,"_3074":53375},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3697":789,"_31245":727,"_21577":53377,"_5":14884,"_28435":53227,"_3074":53378},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3697":790,"_31245":727,"_21577":53380,"_5":14884,"_28435":53227,"_3074":53381},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3697":791,"_31245":727,"_21577":53383,"_5":14884,"_28435":53227,"_3074":53384},[],"The VA also publishes `va.crl-settings.finalize` when a CA is revoked permanently or expires, `va.crl-settings.archive` when the CA is deleted, and `va.crl-settings.delete` when archived settings are removed.",{"_3697":792,"_31245":792,"_5":15238,"_3074":53386,"_31570":53387,"_21577":53388,"_28435":792},"Audit logs",[50948,52489,52490],[],{"_3697":793,"_31245":792,"_21577":53390,"_5":14884,"_28435":792,"_3074":53391},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3697":794,"_31245":792,"_5":31567,"_21577":53393,"_28435":53394,"_3074":53395},[],"/docs/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3697":795,"_31245":792,"_5":31567,"_21577":53397,"_28435":53398,"_3074":53399},[],"/docs/platform/administration/audit-logs#coverage","Coverage",{"_3697":796,"_31245":792,"_5":31567,"_21577":53401,"_28435":53402,"_3074":53403},[],"/docs/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3697":797,"_31245":792,"_5":31567,"_21577":53405,"_28435":53406,"_3074":53407},[],"/docs/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3697":798,"_31245":792,"_5":31567,"_21577":53409,"_28435":53410,"_3074":53411},[],"/docs/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3697":799,"_31245":792,"_5":31567,"_21577":53413,"_28435":53414,"_3074":53415},[],"/docs/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3697":800,"_31245":792,"_5":31567,"_21577":53417,"_28435":53418,"_3074":53419},[],"/docs/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3697":801,"_31245":792,"_5":31567,"_21577":53421,"_28435":53422,"_3074":53423},[],"/docs/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3697":802,"_31245":792,"_5":31567,"_21577":53425,"_28435":53426,"_3074":53427},[],"/docs/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3697":803,"_31245":792,"_5":31567,"_21577":53429,"_28435":53430,"_3074":53431},[],"/docs/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3697":804,"_31245":792,"_5":31567,"_21577":53433,"_28435":53434,"_3074":53435},[],"/docs/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3697":805,"_31245":792,"_21577":53437,"_5":14884,"_28435":792,"_3074":53438},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3697":806,"_31245":792,"_21577":53440,"_5":14884,"_28435":53394,"_3074":53441},[],"The audit body includes:",{"_3697":807,"_31245":792,"_21577":53443,"_5":14884,"_28435":53394,"_3074":53444},[],"input: data received by the operation;",{"_3697":808,"_31245":792,"_21577":53446,"_5":14884,"_28435":53394,"_3074":53447},[],"has\\_error: whether the service returned an error;",{"_3697":809,"_31245":792,"_21577":53449,"_5":14884,"_28435":53394,"_3074":53450},[],"output: produced result or error message;",{"_3697":810,"_31245":792,"_21577":53452,"_5":14884,"_28435":53394,"_3074":53453},[],"principals: identifiers of the principals that matched the request.",{"_3697":811,"_31245":792,"_21577":53455,"_5":14884,"_28435":53394,"_3074":53456},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3697":812,"_31245":792,"_21577":53458,"_5":14884,"_28435":53394,"_3074":53459},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3697":813,"_31245":792,"_21577":53461,"_5":14884,"_28435":53398,"_3074":53462},[],"The backend applies auditing to mutations of:",{"_3697":814,"_31245":792,"_21577":53464,"_5":14884,"_28435":53398,"_3074":53465},[],"authorities, certificates and issuance profiles;",{"_3697":815,"_31245":792,"_21577":53467,"_5":14884,"_28435":53398,"_3074":53468},[],"keys and KMS engines;",{"_3697":816,"_31245":792,"_21577":53470,"_5":14884,"_28435":53398,"_3074":53471},[],"devices and identities;",{"_3697":817,"_31245":792,"_21577":53473,"_5":14884,"_28435":53398,"_3074":53474},[],"DMSs and enrollment operations;",{"_3697":818,"_31245":792,"_21577":53476,"_5":14884,"_28435":53398,"_3074":53477},[],"validation functions and CRL;",{"_3697":819,"_31245":792,"_21577":53479,"_5":14884,"_28435":53398,"_3074":53480},[],"principals, policies and authorization grants.",{"_3697":820,"_31245":792,"_21577":53482,"_5":14884,"_28435":53398,"_3074":53483},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3697":821,"_31245":792,"_21577":53485,"_5":14884,"_28435":53402,"_3074":53486},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3697":822,"_31245":792,"_21577":53488,"_5":14884,"_28435":53402,"_3074":53489},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3697":823,"_31245":792,"_21577":53491,"_5":14884,"_28435":53402,"_3074":53492},[],"Design the consumer to:",{"_3697":824,"_31245":792,"_21577":53494,"_5":14884,"_28435":53402,"_3074":53495},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3697":825,"_31245":792,"_21577":53497,"_5":14884,"_28435":53402,"_3074":53498},[],"keep the complete CloudEvent unmodified;",{"_3697":826,"_31245":792,"_21577":53500,"_5":14884,"_28435":53402,"_3074":53501},[],"record the ingestion time and detect duplicates by ID;",{"_3697":827,"_31245":792,"_21577":53503,"_5":14884,"_28435":53402,"_3074":53504},[],"encrypt in transit and at rest;",{"_3697":828,"_31245":792,"_21577":53506,"_5":14884,"_28435":53402,"_3074":53507},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3697":829,"_31245":792,"_21577":53509,"_5":14884,"_28435":53402,"_3074":53510},[],"apply an explicit retention and legal hold policy;",{"_3697":830,"_31245":792,"_21577":53512,"_5":14884,"_28435":53402,"_3074":53513},[],"alert if it stops consuming or the pending queue grows.",{"_3697":831,"_31245":792,"_21577":53515,"_5":14884,"_28435":53406,"_3074":53516},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3697":832,"_31245":792,"_21577":53518,"_5":14884,"_28435":53406,"_3074":53519},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3697":833,"_31245":792,"_21577":53521,"_5":14884,"_28435":53414,"_3074":53522},[],"Start from the reported time and normalize every source to UTC.",{"_3697":834,"_31245":792,"_21577":53524,"_5":14884,"_28435":53418,"_3074":53525},[],"Filter by event type, service source and resource identifier.",{"_3697":835,"_31245":792,"_21577":53527,"_5":14884,"_28435":53422,"_3074":53528},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3697":836,"_31245":792,"_21577":53530,"_5":14884,"_28435":53426,"_3074":53531},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3697":837,"_31245":792,"_21577":53533,"_5":14884,"_28435":53430,"_3074":53534},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3697":838,"_31245":792,"_21577":53536,"_5":14884,"_28435":53434,"_3074":53537},[],"Generate a controlled mutation in a test environment and check that:",{"_3697":839,"_31245":792,"_21577":53539,"_5":14884,"_28435":53434,"_3074":53540},[],"a successful audit event appears;",{"_3697":840,"_31245":792,"_21577":53542,"_5":14884,"_28435":53434,"_3074":53543},[],"the principal matches the identity used;",{"_3697":841,"_31245":792,"_21577":53545,"_5":14884,"_28435":53434,"_3074":53546},[],"the consumer persists it exactly once;",{"_3697":842,"_31245":792,"_21577":53548,"_5":14884,"_28435":53434,"_3074":53549},[],"it can be retrieved by resource, actor and period;",{"_3697":843,"_31245":792,"_21577":53551,"_5":14884,"_28435":53434,"_3074":53552},[],"a consumer outage raises an alert.",{"_3697":844,"_31245":792,"_21577":53554,"_5":14884,"_28435":53434,"_3074":53555},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3697":845,"_31245":845,"_5":15238,"_3074":53557,"_31570":53558,"_21577":53559,"_28435":845},"Platform architecture",[50948,52489],[],{"_3697":846,"_31245":845,"_21577":53561,"_5":14884,"_28435":845,"_3074":53562},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3697":847,"_31245":845,"_5":31567,"_21577":53564,"_28435":53565,"_3074":53566},[],"/docs/platform/concepts/architecture#control-plane","Control plane",{"_3697":848,"_31245":845,"_5":31567,"_21577":53568,"_28435":53569,"_3074":53570},[],"/docs/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3697":849,"_31245":845,"_5":31567,"_21577":53572,"_28435":53573,"_3074":53574},[],"/docs/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3697":850,"_31245":845,"_5":31567,"_21577":53576,"_28435":53577,"_3074":53578},[],"/docs/platform/concepts/architecture#status-and-validation","Status and validation",{"_3697":851,"_31245":845,"_5":31567,"_21577":53580,"_28435":53581,"_3074":53582},[],"/docs/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3697":852,"_31245":845,"_21577":53584,"_5":14884,"_28435":845,"_3074":53585},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3697":853,"_31245":845,"_21577":53587,"_5":14884,"_28435":845,"_3074":53588},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3697":854,"_31245":845,"_21577":53590,"_5":14884,"_28435":53565,"_3074":53591},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3697":855,"_31245":845,"_21577":53593,"_5":14884,"_28435":53569,"_3074":53594},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3697":856,"_31245":845,"_21577":53596,"_5":14884,"_28435":53573,"_3074":53597},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3697":857,"_31245":845,"_21577":53599,"_5":14884,"_28435":53577,"_3074":53600},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3697":858,"_31245":845,"_21577":53602,"_5":14884,"_28435":53581,"_3074":53603},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3697":859,"_31245":859,"_5":15238,"_3074":53605,"_31570":53606,"_21577":53607,"_28435":859},"How Lamassu works",[50948,52489],[],{"_3697":860,"_31245":859,"_21577":53609,"_5":14884,"_28435":859,"_3074":53610},[],"The mental model of trust, keys, certificates and devices.",{"_3697":861,"_31245":859,"_5":31567,"_21577":53612,"_28435":53613,"_3074":53614},[],"/docs/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3697":862,"_31245":859,"_5":31567,"_21577":53616,"_28435":53617,"_3074":53618},[],"/docs/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3697":863,"_31245":859,"_21577":53620,"_5":14884,"_28435":859,"_3074":53621},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3697":864,"_31245":859,"_21577":53623,"_5":14884,"_28435":53613,"_3074":53624},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3697":865,"_31245":859,"_21577":53626,"_5":14884,"_28435":53613,"_3074":53627},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3697":866,"_31245":859,"_21577":53629,"_5":14884,"_28435":53613,"_3074":53630},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3697":867,"_31245":859,"_21577":53632,"_5":14884,"_28435":53613,"_3074":53633},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3697":868,"_31245":859,"_21577":53635,"_5":14884,"_28435":53613,"_3074":53636},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3697":869,"_31245":859,"_21577":53638,"_5":14884,"_28435":53617,"_3074":53639},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3697":870,"_31245":859,"_21577":53641,"_5":14884,"_28435":53617,"_3074":53642},[],"A DMS relates that CA to an enrollment policy.",{"_3697":871,"_31245":859,"_21577":53644,"_5":14884,"_28435":53617,"_3074":53645},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3697":872,"_31245":859,"_21577":53647,"_5":14884,"_28435":53617,"_3074":53648},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3697":873,"_31245":859,"_21577":53650,"_5":14884,"_28435":53617,"_3074":53651},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3697":874,"_31245":859,"_21577":53653,"_5":14884,"_28435":53617,"_3074":53654},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3697":875,"_31245":859,"_21577":53656,"_5":14884,"_28435":53617,"_3074":53657},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3697":876,"_31245":876,"_5":15238,"_3074":53659,"_31570":53660,"_21577":53662,"_28435":876},"Devices and identities",[50948,52489,53661,53659],"IoT Fleets",[],{"_3697":877,"_31245":876,"_21577":53664,"_5":14884,"_28435":876,"_3074":53665},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3697":878,"_31245":876,"_5":31567,"_21577":53667,"_28435":53668,"_3074":53669},[],"/docs/platform/iot-fleets/device-management#device-states","Device states",{"_3697":879,"_31245":876,"_5":31567,"_21577":53671,"_28435":53672,"_3074":53673},[],"/docs/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3697":880,"_31245":876,"_5":31567,"_21577":53675,"_28435":53676,"_3074":53677},[],"/docs/platform/iot-fleets/device-management#events-api-and-live-stream","Events API and live stream",{"_3697":881,"_31245":876,"_5":31567,"_21577":53679,"_28435":53680,"_3074":53681},[],"/docs/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3697":882,"_31245":876,"_5":31567,"_21577":53683,"_28435":53684,"_3074":53685},[],"/docs/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3697":883,"_31245":876,"_5":31567,"_21577":53687,"_28435":53688,"_3074":53689},[],"/docs/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3697":884,"_31245":876,"_5":31567,"_21577":53691,"_28435":53692,"_3074":53693},[],"/docs/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3697":885,"_31245":876,"_5":31567,"_21577":53695,"_28435":53696,"_3074":53697},[],"/docs/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3697":886,"_31245":876,"_5":31567,"_21577":53699,"_28435":53700,"_3074":53701},[],"/docs/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3697":887,"_31245":876,"_5":31567,"_21577":53703,"_28435":53704,"_3074":53705},[],"/docs/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3697":888,"_31245":876,"_5":31567,"_21577":53707,"_28435":53708,"_3074":53709},[],"/docs/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3697":889,"_31245":876,"_5":31567,"_21577":53711,"_28435":53712,"_3074":53713},[],"/docs/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3697":890,"_31245":876,"_21577":53715,"_5":14884,"_28435":876,"_3074":53716},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3697":891,"_31245":876,"_21577":53718,"_5":14884,"_28435":876,"_3074":53719},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3697":892,"_31245":876,"_21577":53721,"_5":14884,"_28435":53668,"_3074":53722},[],"Operational view",{"_3697":893,"_31245":876,"_21577":53724,"_5":14884,"_28435":53668,"_3074":53725},[],"Meaning",{"_3697":894,"_31245":876,"_21577":53727,"_5":14884,"_28435":53668,"_3074":53728},[],"**No Identity**",{"_3697":895,"_31245":876,"_21577":53730,"_5":14884,"_28435":53668,"_3074":53731},[],"A record exists without an associated identity.",{"_3697":896,"_31245":876,"_21577":53733,"_5":14884,"_28435":53668,"_3074":53734},[],"**Active**",{"_3697":897,"_31245":876,"_21577":53736,"_5":14884,"_28435":53668,"_3074":53737},[],"The slot is active; also check certificate dates, status and usages.",{"_3697":898,"_31245":876,"_21577":53739,"_5":14884,"_28435":53668,"_3074":53740},[],"**Renewal Pending**",{"_3697":899,"_31245":876,"_21577":53742,"_5":14884,"_28435":53668,"_3074":53743},[],"The identity is in the operational renewal window.",{"_3697":900,"_31245":876,"_21577":53745,"_5":14884,"_28435":53668,"_3074":53746},[],"**Expiring Soon**",{"_3697":901,"_31245":876,"_21577":53748,"_5":14884,"_28435":53668,"_3074":53749},[],"Expiration is approaching according to configured thresholds.",{"_3697":902,"_31245":876,"_21577":53751,"_5":14884,"_28435":53668,"_3074":53752},[],"**Expired**",{"_3697":903,"_31245":876,"_21577":53754,"_5":14884,"_28435":53668,"_3074":53755},[],"The identity has expired.",{"_3697":904,"_31245":876,"_21577":53757,"_5":14884,"_28435":53668,"_3074":53758},[],"**Revoked**",{"_3697":905,"_31245":876,"_21577":53760,"_5":14884,"_28435":53668,"_3074":53761},[],"The identity is marked revoked. A hold cascaded from its CA shows here and is lifted when that CA is released.",{"_3697":906,"_31245":876,"_21577":53763,"_5":14884,"_28435":53668,"_3074":53764},[],"**Decommissioned**",{"_3697":907,"_31245":876,"_21577":53766,"_5":14884,"_28435":53668,"_3074":53767},[],"The record is retired and ordinary updates do not restore operation.",{"_3697":908,"_31245":876,"_21577":53769,"_5":14884,"_28435":53668,"_3074":53770},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3697":909,"_31245":876,"_21577":53772,"_5":14884,"_28435":53672,"_3074":53773},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3697":910,"_31245":876,"_21577":53775,"_5":14884,"_28435":53672,"_3074":53776},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3697":911,"_31245":876,"_21577":53778,"_5":14884,"_28435":53672,"_3074":53779},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. In **Live** mode it follows new events and device changes (such as status or owner) automatically without reloading the page, and shows a **Connected** or **Disconnected** indicator. After an interruption it reconnects and recovers without gaps or duplicates, so **Live** shows the same content a page reload would. When live updates cannot be used — no permission, device not found, or live updates not enabled on the server — the timeline shows `Live updates unavailable: ...` with the reason, while history browsing (**Load more**) still works. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3697":912,"_31245":876,"_21577":53781,"_5":14884,"_28435":53672,"_3074":53782},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3697":913,"_31245":876,"_21577":53784,"_5":14884,"_28435":53676,"_3074":53785},[],"`GET /v1/devices/:id/events` reads a device’s events and `POST /v1/devices/:id/events` creates one.",{"_3697":914,"_31245":876,"_21577":53787,"_5":14884,"_28435":53676,"_3074":53788},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Delivery is best effort: events emitted while no client is connected are not replayed on the next connection. The server closes each stream after a maximum lifetime, 10 minutes by default and configurable with the Device Manager `sse_max_stream_duration` setting, and the client reconnects to keep receiving events. When an instance has reached its subscriber limit, set by the Device Manager `sse_max_subscribers` setting (default 1000 and shared by all streams of the instance), new streams receive a `503` response with a `Retry-After` header. Each stream also re-checks the reader's permission to read the device, and closes it when the permission is revoked or cannot be verified; reconnecting goes through the regular authorization checks again. In a Helm deployment, set `services.deviceManager.sseEnabled` to `false` to disable SSE (default `true`); see Device event stream (SSE).",{"_3697":915,"_31245":876,"_21577":53790,"_5":14884,"_28435":53676,"_3074":53791},[],"On AMQP, each Device Manager instance binds a subscriber queue named after its service ID, `device-manager-sse-<uuid>`. The queue is durable and auto-delete, with a one-hour expiration (`x-expires`), so the broker removes it when the instance stops or its connection dies and no cleanup policy is needed. Only on event-bus providers without ephemeral-subscriber support can a per-process durable queue linger after its instance stops; check those providers if you observe leftover queues.",{"_3697":916,"_31245":876,"_21577":53793,"_5":14884,"_28435":53680,"_3074":53794},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3697":917,"_31245":876,"_21577":53796,"_5":14884,"_28435":53684,"_3074":53797},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3697":918,"_31245":876,"_21577":53799,"_5":14884,"_28435":53688,"_3074":53800},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3697":919,"_31245":876,"_21577":53802,"_5":14884,"_28435":53692,"_3074":53803},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3697":920,"_31245":876,"_21577":53805,"_5":14884,"_28435":53696,"_3074":53806},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3697":921,"_31245":876,"_21577":53808,"_5":14884,"_28435":53696,"_3074":53809},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3697":922,"_31245":876,"_21577":53811,"_5":14884,"_28435":53700,"_3074":53812},[],"From **No Identity**, use **Assign Identity**:",{"_3697":923,"_31245":876,"_21577":53814,"_5":14884,"_28435":53700,"_3074":53815},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3697":924,"_31245":876,"_21577":53817,"_5":14884,"_28435":53700,"_3074":53818},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3697":925,"_31245":876,"_21577":53820,"_5":14884,"_28435":53700,"_3074":53821},[],"Confirm and read the serial, active version and history again.",{"_3697":926,"_31245":876,"_21577":53823,"_5":14884,"_28435":53700,"_3074":53824},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3697":927,"_31245":876,"_21577":53826,"_5":14884,"_28435":53700,"_3074":53827},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3697":928,"_31245":876,"_21577":53829,"_5":14884,"_28435":53704,"_3074":53830},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3697":929,"_31245":876,"_21577":53832,"_5":14884,"_28435":53704,"_3074":53833},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3697":930,"_31245":876,"_21577":53835,"_5":14884,"_28435":53704,"_3074":53836},[],"A certificate suspended by a CA hold cascade shows as **Revoked** and returns to active when the holding CA is released. If its certificate expired during the hold, the monitoring job marks it as expired again after the release. If you revoke a held identity yourself, that revocation is permanent.",{"_3697":931,"_31245":876,"_21577":53838,"_5":14884,"_28435":53708,"_3074":53839},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3697":932,"_31245":876,"_21577":53841,"_5":14884,"_28435":53708,"_3074":53842},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3697":933,"_31245":876,"_21577":53844,"_5":14884,"_28435":53708,"_3074":53845},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3697":934,"_31245":876,"_21577":53847,"_5":14884,"_28435":53708,"_3074":53848},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3697":935,"_31245":876,"_21577":53850,"_5":14884,"_28435":53712,"_3074":53851},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3697":936,"_31245":876,"_21577":53853,"_5":14884,"_28435":53712,"_3074":53854},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/est/configuration\" />",{"_3697":937,"_31245":937,"_5":15238,"_3074":53856,"_31570":53857,"_21577":53859,"_28435":937},"Configure and operate the DMS",[50948,52489,53661,53659,53858],"Enrollment with PKI",[],{"_3697":938,"_31245":937,"_21577":53861,"_5":14884,"_28435":937,"_3074":53862},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3697":939,"_31245":937,"_5":31567,"_21577":53864,"_28435":53865,"_3074":50958},[],"/docs/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3697":940,"_31245":937,"_5":31567,"_21577":53867,"_28435":53868,"_3074":53869},[],"/docs/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3697":941,"_31245":937,"_5":31567,"_21577":53871,"_28435":53872,"_3074":53873},[],"/docs/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3697":942,"_31245":937,"_5":31567,"_21577":53875,"_28435":53876,"_3074":53877},[],"/docs/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3697":943,"_31245":937,"_5":31567,"_21577":53879,"_28435":53880,"_3074":53881},[],"/docs/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3697":944,"_31245":937,"_5":31567,"_21577":53883,"_28435":53884,"_3074":53885},[],"/docs/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3697":945,"_31245":937,"_5":31567,"_21577":53887,"_28435":53888,"_3074":53889},[],"/docs/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3697":946,"_31245":937,"_5":31567,"_21577":53891,"_28435":53892,"_3074":53893},[],"/docs/platform/iot-fleets/enrollment/dms#protocol-configuration","Protocol configuration",{"_3697":947,"_31245":937,"_5":31567,"_21577":53895,"_28435":53896,"_3074":53897},[],"/docs/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3697":948,"_31245":937,"_5":31567,"_21577":53899,"_28435":53900,"_3074":53901},[],"/docs/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3697":949,"_31245":937,"_21577":53903,"_5":14884,"_28435":937,"_3074":53904},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3697":950,"_31245":937,"_21577":53906,"_5":14884,"_28435":53865,"_3074":53907},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3697":951,"_31245":937,"_21577":53909,"_5":14884,"_28435":53865,"_3074":53910},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3697":952,"_31245":937,"_21577":53912,"_5":14884,"_28435":53872,"_3074":53913},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3697":953,"_31245":937,"_21577":53915,"_5":14884,"_28435":53876,"_3074":53916},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3697":954,"_31245":937,"_21577":53918,"_5":14884,"_28435":53880,"_3074":53919},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3697":955,"_31245":937,"_21577":53921,"_5":14884,"_28435":53884,"_3074":53922},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3697":956,"_31245":937,"_21577":53924,"_5":14884,"_28435":53888,"_3074":53925},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3697":957,"_31245":937,"_21577":53927,"_5":14884,"_28435":53892,"_3074":53928},[],"See Configure EST in the DMS for registration, authentication, issuance, renewal, key generation and trust distribution.",{"_3697":958,"_31245":937,"_21577":53930,"_5":14884,"_28435":53896,"_3074":53931},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored. Authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it, including the AWS IoT connector’s JITP writeback. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3697":959,"_31245":937,"_21577":53933,"_5":14884,"_28435":53896,"_3074":53934},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3697":960,"_31245":937,"_21577":53936,"_5":14884,"_28435":53896,"_3074":53937},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3697":961,"_31245":937,"_21577":53939,"_5":14884,"_28435":53900,"_3074":53940},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3697":962,"_31245":962,"_5":15238,"_3074":53858,"_31570":53942,"_21577":53943,"_28435":962},[50948,52489,53661,53659,53858],[],{"_3697":963,"_31245":962,"_21577":53945,"_5":14884,"_28435":962,"_3074":53946},[],"Prepare device admission, registration policy and certificate issuance.",{"_3697":964,"_31245":962,"_5":31567,"_21577":53948,"_28435":53949,"_3074":53950},[],"/docs/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3697":965,"_31245":962,"_5":31567,"_21577":53952,"_28435":53953,"_3074":53954},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3697":966,"_31245":962,"_5":31567,"_21577":53956,"_28435":53957,"_3074":53958},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3697":967,"_31245":962,"_21577":53960,"_5":14884,"_28435":962,"_3074":53961},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3697":968,"_31245":962,"_21577":53963,"_5":14884,"_28435":53949,"_3074":53964},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3697":969,"_31245":962,"_21577":53966,"_5":14884,"_28435":53949,"_3074":53967},[],"The integrator installs initial EST server trust and an admission credential.",{"_3697":970,"_31245":962,"_21577":53969,"_5":14884,"_28435":53949,"_3074":53970},[],"The client requests an identity for its `Device ID` through EST.",{"_3697":971,"_31245":962,"_21577":53972,"_5":14884,"_28435":53949,"_3074":53973},[],"Certificate, device binding and key/certificate installation are checked.",{"_3697":972,"_31245":962,"_21577":53975,"_5":14884,"_28435":53949,"_3074":53976},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3697":973,"_31245":962,"_21577":53978,"_5":14884,"_28435":53949,"_3074":53979},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3697":974,"_31245":962,"_21577":53981,"_5":14884,"_28435":53953,"_3074":53982},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3697":975,"_31245":962,"_21577":53984,"_5":14884,"_28435":53953,"_3074":53985},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3697":976,"_31245":962,"_21577":53987,"_5":14884,"_28435":53957,"_3074":53988},[],"See EST (RFC 7030) to prepare authentication and initial trust, integrate the client and maintain the device identity.",{"_3697":977,"_31245":962,"_21577":53990,"_5":14884,"_28435":53957,"_3074":53991},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3697":978,"_31245":978,"_5":15238,"_3074":53993,"_31570":53994,"_21577":53995,"_28435":978},"Provisioning strategies",[50948,52489,53661,53659,53858],[],{"_3697":979,"_31245":978,"_21577":53997,"_5":14884,"_28435":978,"_3074":53998},[],"Choose device registration, identity authorization and key generation.",{"_3697":980,"_31245":978,"_5":31567,"_21577":54000,"_28435":54001,"_3074":54002},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3697":981,"_31245":978,"_5":31567,"_21577":54004,"_28435":54005,"_3074":54006},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3697":982,"_31245":978,"_5":31567,"_21577":54008,"_28435":54009,"_3074":54010},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3697":983,"_31245":978,"_5":31567,"_21577":54012,"_28435":54013,"_3074":54014},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3697":984,"_31245":978,"_5":31567,"_21577":54016,"_28435":54017,"_3074":54018},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3697":985,"_31245":978,"_21577":54020,"_5":14884,"_28435":978,"_3074":54021},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3697":986,"_31245":978,"_21577":54023,"_5":14884,"_28435":54001,"_3074":54024},[],"Path",{"_3697":987,"_31245":978,"_21577":54026,"_5":14884,"_28435":54001,"_3074":54027},[],"When the device exists",{"_3697":988,"_31245":978,"_21577":54029,"_5":14884,"_28435":54001,"_3074":54030},[],"What to check",{"_3697":989,"_31245":978,"_21577":54032,"_5":14884,"_28435":54001,"_3074":54033},[],"Manual assignment",{"_3697":990,"_31245":978,"_21577":54035,"_5":14884,"_28435":54001,"_3074":54036},[],"An operator creates it before associating a certificate.",{"_3697":991,"_31245":978,"_21577":54038,"_5":14884,"_28435":54001,"_3074":54039},[],"ID, owning DMS, certificate CN and bound serial.",{"_3697":992,"_31245":978,"_21577":54041,"_5":14884,"_28435":54001,"_3074":54042},[],"EST with `JITP`",{"_3697":993,"_31245":978,"_21577":54044,"_5":14884,"_28435":54001,"_3074":54045},[],"Created for an unknown CN during `/simpleenroll`.",{"_3697":994,"_31245":978,"_21577":54047,"_5":14884,"_28435":54001,"_3074":54048},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3697":995,"_31245":978,"_21577":54050,"_5":14884,"_28435":54001,"_3074":54051},[],"EST with `PRE_REGISTRATION`",{"_3697":996,"_31245":978,"_21577":54053,"_5":14884,"_28435":54001,"_3074":54054},[],"Must exist before `/simpleenroll`.",{"_3697":997,"_31245":978,"_21577":54056,"_5":14884,"_28435":54001,"_3074":54057},[],"Approved record, same DMS and replacement conditions for your version.",{"_3697":998,"_31245":978,"_21577":54059,"_5":14884,"_28435":54001,"_3074":54060},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3697":999,"_31245":978,"_21577":54062,"_5":14884,"_28435":54001,"_3074":54063},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3697":1000,"_31245":978,"_21577":54065,"_5":14884,"_28435":54005,"_3074":54066},[],"Finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3697":1001,"_31245":978,"_21577":54068,"_5":14884,"_28435":54005,"_3074":54069},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3697":1002,"_31245":978,"_21577":54071,"_5":14884,"_28435":54005,"_3074":54072},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3697":1003,"_31245":978,"_21577":54074,"_5":14884,"_28435":54009,"_3074":54075},[],"Decide initial enrollment and re-enrollment separately:",{"_3697":1004,"_31245":978,"_21577":54077,"_5":14884,"_28435":54009,"_3074":54078},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3697":1005,"_31245":978,"_21577":54080,"_5":14884,"_28435":54009,"_3074":54081},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3697":1006,"_31245":978,"_21577":54083,"_5":14884,"_28435":54009,"_3074":54084},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3697":1007,"_31245":978,"_21577":54086,"_5":14884,"_28435":54009,"_3074":54087},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3697":1008,"_31245":978,"_21577":54089,"_5":14884,"_28435":54009,"_3074":54090},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3697":1009,"_31245":978,"_21577":54092,"_5":14884,"_28435":54013,"_3074":51332},[],{"_3697":1010,"_31245":978,"_21577":54094,"_5":14884,"_28435":54013,"_3074":54095},[],"Material crossing EST",{"_3697":1011,"_31245":978,"_21577":54097,"_5":14884,"_28435":54013,"_3074":54098},[],"Device-generated key",{"_3697":1012,"_31245":978,"_21577":54100,"_5":14884,"_28435":54013,"_3074":54101},[],"Public CSR and certificate; the key stays on the client.",{"_3697":1013,"_31245":978,"_21577":54103,"_5":14884,"_28435":54013,"_3074":54104},[],"Existing device key",{"_3697":1014,"_31245":978,"_21577":54106,"_5":14884,"_28435":54013,"_3074":54107},[],"CSR signed with that key and a new certificate.",{"_3697":1015,"_31245":978,"_21577":54109,"_5":14884,"_28435":54013,"_3074":54110},[],"ServerKeyGen",{"_3697":1016,"_31245":978,"_21577":54112,"_5":14884,"_28435":54013,"_3074":54113},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3697":1017,"_31245":978,"_21577":54115,"_5":14884,"_28435":54013,"_3074":54116},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3697":1018,"_31245":978,"_21577":54118,"_5":14884,"_28435":54017,"_3074":54119},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3697":1019,"_31245":1019,"_5":15238,"_3074":54121,"_31570":54122,"_21577":54124,"_28435":1019},"Authentication and trust",[50948,52489,53661,54123],"EST (RFC 7030)",[],{"_3697":1020,"_31245":1019,"_21577":54126,"_5":14884,"_28435":1019,"_3074":54127},[],"Prepare credentials, authentication and trust distribution for EST.",{"_3697":1021,"_31245":1019,"_5":31567,"_21577":54129,"_28435":54130,"_3074":54131},[],"/docs/platform/iot-fleets/est/bootstrap-identity#initial-server-trust","Initial server trust",{"_3697":1022,"_31245":1019,"_5":31567,"_21577":54133,"_28435":54134,"_3074":54135},[],"/docs/platform/iot-fleets/est/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3697":1023,"_31245":1019,"_5":31567,"_21577":54137,"_28435":54138,"_3074":54139},[],"/docs/platform/iot-fleets/est/bootstrap-identity#modes-per-operation","Modes per operation",{"_3697":1024,"_31245":1019,"_5":31567,"_21577":54141,"_28435":54142,"_3074":54143},[],"/docs/platform/iot-fleets/est/bootstrap-identity#webhook-contract","Webhook contract",{"_3697":1025,"_31245":1019,"_5":31567,"_21577":54145,"_28435":54146,"_3074":54147},[],"/docs/platform/iot-fleets/est/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3697":1026,"_31245":1019,"_21577":54149,"_5":14884,"_28435":1019,"_3074":54150},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3697":1027,"_31245":1019,"_21577":54152,"_5":14884,"_28435":54130,"_3074":54153},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3697":1028,"_31245":1019,"_21577":54155,"_5":14884,"_28435":54130,"_3074":54156},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3697":1029,"_31245":1019,"_21577":54158,"_5":14884,"_28435":54134,"_3074":54159},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. The validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3697":1030,"_31245":1019,"_21577":54161,"_5":14884,"_28435":54134,"_3074":54162},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3697":1031,"_31245":1019,"_21577":54164,"_5":14884,"_28435":54134,"_3074":54165},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3697":1032,"_31245":1019,"_21577":54167,"_5":14884,"_28435":54138,"_3074":54168},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3697":1033,"_31245":1019,"_21577":54170,"_5":14884,"_28435":54138,"_3074":54171},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3697":1034,"_31245":1019,"_21577":54173,"_5":14884,"_28435":54142,"_3074":54174},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config (verification is on by default) and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3697":1035,"_31245":1019,"_21577":54176,"_5":14884,"_28435":54142,"_3074":54177},[],"Example body:",{"_3697":1036,"_31245":1019,"_21577":54179,"_5":14884,"_28435":54142,"_3074":54180},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3697":1037,"_31245":1019,"_21577":54182,"_5":14884,"_28435":54142,"_3074":54183},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3697":1038,"_31245":1019,"_21577":54185,"_5":14884,"_28435":54142,"_3074":54186},[],"Continuation requires a successful HTTP response and JSON:",{"_3697":1039,"_31245":1019,"_21577":54188,"_5":14884,"_28435":54142,"_3074":54189},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3697":1040,"_31245":1019,"_21577":54191,"_5":14884,"_28435":54146,"_3074":54192},[],"The DMS first looks up the presented certificate in Lamassu; certificates it issued and manages are checked against their stored status. External certificates are checked through their OCSP servers and then their CRL distribution points. By default, unverifiable revocation is a rejection, not an acceptance: a certificate that is not managed by Lamassu and lists no OCSP or CRL endpoint is rejected unless `allow_unverifiable_revocation` is set in that operation's block (see Authentication per operation).",{"_3697":1041,"_31245":1019,"_21577":54194,"_5":14884,"_28435":54146,"_3074":54195},[],"A certificate that does list endpoints is held to a stricter standard, with or without the option: unreachable endpoints, stale or invalid evidence, or an inconclusive (unknown) status reject the certificate. The evidence must be fresh (`thisUpdate` not in the future, `nextUpdate` not passed, and an answer without `nextUpdate` accepted only while it is less than about 24 hours old) and OCSP responses must be signed by the certificate's issuer itself or by a delegated responder that carries the `id-kp-OCSPSigning` EKU and is within its validity. A revoked verdict is honored regardless of its age. Each OCSP or CRL request has a 10-second timeout.",{"_3697":1042,"_31245":1019,"_21577":54197,"_5":14884,"_28435":54146,"_3074":54198},[],"One caveat remains: a signed Good OCSP response or CRL captured before a revocation keeps validating until its `nextUpdate` (up to about 24 hours without `nextUpdate`). Revocation propagates to devices at the pace the responders publish evidence, not at the moment of revocation.",{"_3697":1043,"_31245":1019,"_21577":54200,"_5":14884,"_28435":54146,"_3074":54201},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3697":1044,"_31245":1044,"_5":15238,"_3074":54203,"_31570":54204,"_21577":54205,"_28435":1044},"EST in Lamassu",[50948,52489,53661,54123],[],{"_3697":1045,"_31245":1044,"_21577":54207,"_5":14884,"_28435":1044,"_3074":54208},[],"Configure EST operations, authentication and trust distribution.",{"_3697":1046,"_31245":1044,"_5":31567,"_21577":54210,"_28435":54211,"_3074":54212},[],"/docs/platform/iot-fleets/est/configuration#endpoint-reference","Endpoint reference",{"_3697":1047,"_31245":1044,"_5":31567,"_21577":54214,"_28435":54215,"_3074":54216},[],"/docs/platform/iot-fleets/est/configuration#authentication-per-operation","Authentication per operation",{"_3697":1048,"_31245":1044,"_5":31567,"_21577":54218,"_28435":54219,"_3074":54220},[],"/docs/platform/iot-fleets/est/configuration#client-certificate","Client certificate",{"_3697":1049,"_31245":1044,"_5":31567,"_21577":54222,"_28435":54223,"_3074":54224},[],"/docs/platform/iot-fleets/est/configuration#external-webhook-settings","External webhook settings",{"_3697":1050,"_31245":1044,"_5":31567,"_21577":54226,"_28435":54227,"_3074":50958},[],"/docs/platform/iot-fleets/est/configuration#before-you-begin",{"_3697":1051,"_31245":1044,"_5":31567,"_21577":54229,"_28435":54230,"_3074":54231},[],"/docs/platform/iot-fleets/est/configuration#cacerts","/cacerts",{"_3697":1052,"_31245":1044,"_5":31567,"_21577":54233,"_28435":54234,"_3074":54235},[],"/docs/platform/iot-fleets/est/configuration#trust-distribution","Configuration",{"_3697":1053,"_31245":1044,"_5":31567,"_21577":54237,"_28435":54238,"_3074":54239},[],"/docs/platform/iot-fleets/est/configuration#cacerts-request-and-response","Request and response",{"_3697":1054,"_31245":1044,"_5":31567,"_21577":54241,"_28435":54242,"_3074":54243},[],"/docs/platform/iot-fleets/est/configuration#download-and-inspect-cacerts","Example",{"_3697":1055,"_31245":1044,"_5":31567,"_21577":54245,"_28435":54246,"_3074":54247},[],"/docs/platform/iot-fleets/est/configuration#simpleenroll","/simpleenroll",{"_3697":1056,"_31245":1044,"_5":31567,"_21577":54249,"_28435":54250,"_3074":54235},[],"/docs/platform/iot-fleets/est/configuration#enrollment-configuration",{"_3697":1057,"_31245":1044,"_5":31567,"_21577":54252,"_28435":54253,"_3074":54239},[],"/docs/platform/iot-fleets/est/configuration#simpleenroll-request-and-response",{"_3697":1058,"_31245":1044,"_5":31567,"_21577":54255,"_28435":54256,"_3074":54243},[],"/docs/platform/iot-fleets/est/configuration#initial-enrollment-example",{"_3697":1059,"_31245":1044,"_5":31567,"_21577":54258,"_28435":54259,"_3074":54260},[],"/docs/platform/iot-fleets/est/configuration#simplereenroll","/simplereenroll",{"_3697":1060,"_31245":1044,"_5":31567,"_21577":54262,"_28435":54263,"_3074":54235},[],"/docs/platform/iot-fleets/est/configuration#re-enrollment-configuration",{"_3697":1061,"_31245":1044,"_5":31567,"_21577":54265,"_28435":54266,"_3074":54239},[],"/docs/platform/iot-fleets/est/configuration#simplereenroll-request-and-response",{"_3697":1062,"_31245":1044,"_5":31567,"_21577":54268,"_28435":54269,"_3074":54243},[],"/docs/platform/iot-fleets/est/configuration#renewal-example",{"_3697":1063,"_31245":1044,"_5":31567,"_21577":54271,"_28435":54272,"_3074":54273},[],"/docs/platform/iot-fleets/est/configuration#recover-according-to-state","Recover according to state",{"_3697":1064,"_31245":1044,"_5":31567,"_21577":54275,"_28435":54276,"_3074":54277},[],"/docs/platform/iot-fleets/est/configuration#serverkeygen","/serverkeygen",{"_3697":1065,"_31245":1044,"_5":31567,"_21577":54279,"_28435":54280,"_3074":54235},[],"/docs/platform/iot-fleets/est/configuration#serverkeygen-configuration",{"_3697":1066,"_31245":1044,"_5":31567,"_21577":54282,"_28435":54283,"_3074":54239},[],"/docs/platform/iot-fleets/est/configuration#serverkeygen-request-and-response",{"_3697":1067,"_31245":1044,"_5":31567,"_21577":54285,"_28435":54286,"_3074":54243},[],"/docs/platform/iot-fleets/est/configuration#request-and-extraction",{"_3697":1068,"_31245":1044,"_21577":54288,"_5":14884,"_28435":1044,"_3074":54289},[],"Each DMS exposes the EST operations its devices use to obtain and renew their identity. This page describes the routes, how each operation authenticates, the DMS settings that govern each endpoint and request examples with curl and OpenSSL. To create and manage the DMS, see the DMS guide; to prepare the device's credentials and initial trust, see Authentication and trust.",{"_3697":1069,"_31245":1044,"_21577":54291,"_5":14884,"_28435":54211,"_3074":54292},[],"Each DMS publishes its operations at `/.well-known/est/{APS}/{operation}`, where `APS` is the DMS ID, not its display name. Gateway configuration determines the public host and route. The router also admits routes without the `APS` segment, but the controller requires it, so do not use them.",{"_3697":1070,"_31245":1044,"_21577":54294,"_5":14884,"_28435":54211,"_3074":54295},[],"Operation",{"_3697":1071,"_31245":1044,"_21577":54297,"_5":14884,"_28435":54211,"_3074":54298},[],"Method",{"_3697":1072,"_31245":1044,"_21577":54300,"_5":14884,"_28435":54211,"_3074":54301},[],"Authentication and condition",{"_3697":1073,"_31245":1044,"_21577":54303,"_5":14884,"_28435":54211,"_3074":54304},[],"`/cacerts`",{"_3697":1074,"_31245":1044,"_21577":54306,"_5":14884,"_28435":54211,"_3074":54307},[],"GET",{"_3697":1075,"_31245":1044,"_21577":54309,"_5":14884,"_28435":54211,"_3074":54310},[],"No EST credential required; HTTPS and infrastructure controls still apply.",{"_3697":1076,"_31245":1044,"_21577":54312,"_5":14884,"_28435":54211,"_3074":54313},[],"`/simpleenroll`",{"_3697":1077,"_31245":1044,"_21577":54315,"_5":14884,"_28435":54211,"_3074":54316},[],"POST",{"_3697":1078,"_31245":1044,"_21577":54318,"_5":14884,"_28435":54211,"_3074":54319},[],"Initial authentication and DMS registration and replacement policy.",{"_3697":1079,"_31245":1044,"_21577":54321,"_5":14884,"_28435":54211,"_3074":54322},[],"`/simplereenroll`",{"_3697":1080,"_31245":1044,"_21577":54324,"_5":14884,"_28435":54211,"_3074":54316},[],{"_3697":1081,"_31245":1044,"_21577":54326,"_5":14884,"_28435":54211,"_3074":54327},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3697":1082,"_31245":1044,"_21577":54329,"_5":14884,"_28435":54211,"_3074":54330},[],"`/serverkeygen`",{"_3697":1083,"_31245":1044,"_21577":54332,"_5":14884,"_28435":54211,"_3074":54316},[],{"_3697":1084,"_31245":1044,"_21577":54334,"_5":14884,"_28435":54211,"_3074":54335},[],"Initial authentication and server-side key generation enabled.",{"_3697":1085,"_31245":1044,"_21577":54337,"_5":14884,"_28435":54211,"_3074":54338},[],"Lamassu does not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode either; a webhook can interpret a request credential according to its own contract.",{"_3697":1086,"_31245":1044,"_21577":54340,"_5":14884,"_28435":54215,"_3074":54341},[],"The DMS authenticates the request before it applies registration and issuance rules. Each operation reads its authentication from its own `est_rfc7030_settings` block:",{"_3697":1087,"_31245":1044,"_21577":54343,"_5":14884,"_28435":54215,"_3074":54344},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3697":1088,"_31245":1044,"_21577":54346,"_5":14884,"_28435":54215,"_3074":54347},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3697":1089,"_31245":1044,"_21577":54349,"_5":14884,"_28435":54215,"_3074":54350},[],"The two blocks are stored independently and neither inherits from the other, so read both before editing. `auth_mode` accepts these values:",{"_3697":1090,"_31245":1044,"_21577":54352,"_5":14884,"_28435":54215,"_3074":54353},[],"`auth_mode`",{"_3697":1091,"_31245":1044,"_21577":54355,"_5":14884,"_28435":54215,"_3074":54356},[],"Control applied in the configured operation",{"_3697":1092,"_31245":1044,"_21577":54358,"_5":14884,"_28435":54215,"_3074":54359},[],"`CLIENT_CERTIFICATE`",{"_3697":1093,"_31245":1044,"_21577":54361,"_5":14884,"_28435":54215,"_3074":54362},[],"Presented certificate validation.",{"_3697":1094,"_31245":1044,"_21577":54364,"_5":14884,"_28435":54215,"_3074":54365},[],"`EXTERNAL_WEBHOOK`",{"_3697":1095,"_31245":1044,"_21577":54367,"_5":14884,"_28435":54215,"_3074":54368},[],"Configured webhook authorization.",{"_3697":1096,"_31245":1044,"_21577":54370,"_5":14884,"_28435":54215,"_3074":54371},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3697":1097,"_31245":1044,"_21577":54373,"_5":14884,"_28435":54215,"_3074":54374},[],"Certificate validation followed by webhook approval.",{"_3697":1098,"_31245":1044,"_21577":54376,"_5":14884,"_28435":54215,"_3074":54377},[],"`NO_AUTH`",{"_3697":1099,"_31245":1044,"_21577":54379,"_5":14884,"_28435":54215,"_3074":54380},[],"No DMS requester authentication.",{"_3697":1100,"_31245":1044,"_21577":54382,"_5":14884,"_28435":54215,"_3074":54383},[],"Webhook modes also run during re-enrollment when configured in its block. An absent or unrecognized mode makes the operation fail: there is no implicit downgrade to `NO_AUTH`. `NO_AUTH` does not establish ownership of the requested ID.",{"_3697":1101,"_31245":1044,"_21577":54385,"_5":14884,"_28435":54219,"_3074":54386},[],"The certificate modes read `client_certificate_settings` in the same block:",{"_3697":1102,"_31245":1044,"_21577":54388,"_5":14884,"_28435":54219,"_3074":54389},[],"Field",{"_3697":1103,"_31245":1044,"_21577":54391,"_5":14884,"_28435":54219,"_3074":54392},[],"Description",{"_3697":1104,"_31245":1044,"_21577":54394,"_5":14884,"_28435":54219,"_3074":54395},[],"`validation_cas`",{"_3697":1105,"_31245":1044,"_21577":54397,"_5":14884,"_28435":54219,"_3074":54398},[],"IDs of the CAs the presented certificate is validated against. The first one that validates it is used.",{"_3697":1106,"_31245":1044,"_21577":54400,"_5":14884,"_28435":54219,"_3074":54401},[],"`allow_expired`",{"_3697":1107,"_31245":1044,"_21577":54403,"_5":14884,"_28435":54219,"_3074":54404},[],"**Allow expired certificates**: accepts expired certificates in initial enrollment.",{"_3697":1108,"_31245":1044,"_21577":54406,"_5":14884,"_28435":54219,"_3074":54407},[],"`chain_level_validation`",{"_3697":1109,"_31245":1044,"_21577":54409,"_5":14884,"_28435":54219,"_3074":54410},[],"When greater than 0, only that many certificates of the presented chain are validated.",{"_3697":1110,"_31245":1044,"_21577":54412,"_5":14884,"_28435":54219,"_3074":54413},[],"`allow_unverifiable_revocation`",{"_3697":1111,"_31245":1044,"_21577":54415,"_5":14884,"_28435":54219,"_3074":54416},[],"**Allow certificates without revocation information**: accepts certificates without revocation information; `false` by default.",{"_3697":1112,"_31245":1044,"_21577":54418,"_5":14884,"_28435":54219,"_3074":54419},[],"The validator receives one certificate credential; the flow does not guarantee forwarding every handshake intermediate to it. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3697":1113,"_31245":1044,"_21577":54421,"_5":14884,"_28435":54219,"_3074":54422},[],"**Revocation.** In initial enrollment the client certificate and every intermediate CA between it and the validation CA are checked, each against its issuer; extra certificates the device sends in the handshake are ignored. Certificates managed by Lamassu are checked against their stored status, and external ones through their OCSP and CRL endpoints. The operation fails closed when revocation cannot be verified: unreachable endpoints, stale or invalid evidence and inconclusive statuses always reject the certificate. A validation CA that is revoked in Lamassu also rejects the operation, without falling back to the remaining validation CAs. Revocation and checks details the evidence the endpoints must present.",{"_3697":1114,"_31245":1044,"_21577":54424,"_5":14884,"_28435":54219,"_3074":54425},[],"`allow_unverifiable_revocation` relaxes a single case: a certificate, or an intermediate CA of the chain, that Lamassu does not manage and that lists no OCSP or CRL endpoint. With the option on, that certificate is accepted even if it is revoked, and the console shows the warning **Revocation will not be verified**. The option is set separately in the enrollment and re-enrollment blocks, and it is off in DMSs created before it existed.",{"_3697":1115,"_31245":1044,"_21577":54427,"_5":14884,"_28435":54219,"_3074":54428},[],"**Re-enrollment.** The validator tries the enrollment CA first and then the re-enrollment block's `validation_cas`. That list is optional because the enrollment CA is always trusted, and CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance: during a CA rotation, add the old issuance CA to the re-enrollment block's list. The validator compares only the presented TLS leaf against those CAs and checks only its revocation. In this block `chain_level_validation` and `allow_expired` are stored but not consulted; expiry is governed by `enable_expired_renewal`.",{"_3697":1116,"_31245":1044,"_21577":54430,"_5":14884,"_28435":54223,"_3074":54431},[],"The webhook modes read `external_webhook_settings` in the same `est_rfc7030_settings` block. These settings define the destination, method, timeout and how Lamassu authenticates to the receiver; the webhook contract describes the device credential, the request body and the expected response.",{"_3697":1117,"_31245":1044,"_21577":54433,"_5":14884,"_28435":54223,"_3074":54434},[],"`external_webhook_settings` field",{"_3697":1118,"_31245":1044,"_21577":54436,"_5":14884,"_28435":54223,"_3074":54437},[],"Decision",{"_3697":1119,"_31245":1044,"_21577":54439,"_5":14884,"_28435":54223,"_3074":54440},[],"`url`",{"_3697":1120,"_31245":1044,"_21577":54442,"_5":14884,"_28435":54223,"_3074":54443},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3697":1121,"_31245":1044,"_21577":54445,"_5":14884,"_28435":54223,"_3074":54446},[],"`method`",{"_3697":1122,"_31245":1044,"_21577":54448,"_5":14884,"_28435":54223,"_3074":54449},[],"`POST` or `PUT`; `POST` by default.",{"_3697":1123,"_31245":1044,"_21577":54451,"_5":14884,"_28435":54223,"_3074":54452},[],"`name`",{"_3697":1124,"_31245":1044,"_21577":54454,"_5":14884,"_28435":54223,"_3074":54455},[],"Label used in service logs.",{"_3697":1125,"_31245":1044,"_21577":54457,"_5":14884,"_28435":54223,"_3074":54458},[],"`config.auth_mode`",{"_3697":1126,"_31245":1044,"_21577":54460,"_5":14884,"_28435":54223,"_3074":54461},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3697":1127,"_31245":1044,"_21577":54463,"_5":14884,"_28435":54223,"_3074":54464},[],"`config.log_level`",{"_3697":1128,"_31245":1044,"_21577":54466,"_5":14884,"_28435":54223,"_3074":54467},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3697":1129,"_31245":1044,"_21577":54469,"_5":14884,"_28435":54223,"_3074":54470},[],"`config.apikey_options`",{"_3697":1130,"_31245":1044,"_21577":54472,"_5":14884,"_28435":54223,"_3074":54473},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3697":1131,"_31245":1044,"_21577":54475,"_5":14884,"_28435":54223,"_3074":54476},[],"`config.jwt_options`",{"_3697":1132,"_31245":1044,"_21577":54478,"_5":14884,"_28435":54223,"_3074":54479},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3697":1133,"_31245":1044,"_21577":54481,"_5":14884,"_28435":54223,"_3074":54482},[],"`config.mtls_options`",{"_3697":1134,"_31245":1044,"_21577":54484,"_5":14884,"_28435":54223,"_3074":54485},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3697":1135,"_31245":1044,"_21577":54487,"_5":14884,"_28435":54223,"_3074":54488},[],"`config.insecure_skip_verify`",{"_3697":1136,"_31245":1044,"_21577":54490,"_5":14884,"_28435":54223,"_3074":54491},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3697":1137,"_31245":1044,"_21577":54493,"_5":14884,"_28435":54223,"_3074":54494},[],"`config.call_timeout`",{"_3697":1138,"_31245":1044,"_21577":54496,"_5":14884,"_28435":54223,"_3074":54497},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3697":1139,"_31245":1044,"_21577":54499,"_5":14884,"_28435":54223,"_3074":54500},[],"Creating or updating a DMS that uses the webhook in any of its blocks validates this configuration. When it is invalid, the response is HTTP 400, with a body that starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config`. These rules apply:",{"_3697":1140,"_31245":1044,"_21577":54502,"_5":14884,"_28435":54223,"_3074":54503},[],"The URL, method and options must be valid, and `mtls_options.cert_content` and `key_content` must decode to a matching certificate and private key.",{"_3697":1141,"_31245":1044,"_21577":54505,"_5":14884,"_28435":54223,"_3074":54506},[],"File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid, because the service does not read files. Enter the certificate and key as PEM, Base64-encoded or plain, in `cert_content` and `key_content`.",{"_3697":1142,"_31245":1044,"_21577":54508,"_5":14884,"_28435":54223,"_3074":54509},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts (for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded`), and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas.",{"_3697":1143,"_31245":1044,"_21577":54511,"_5":14884,"_28435":54223,"_3074":54512},[],"With `config.auth_mode` set to `apikey`, `jwt` or `mtls`, the body must carry its option block (`apikey_options`, `jwt_options` or `mtls_options`) and no other. The legacy `apikey`, `oidc` and `mtls` names fail validation, and `validate_server_cert` is ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3697":1144,"_31245":1044,"_21577":54514,"_5":14884,"_28435":54223,"_3074":54515},[],"The `http_client` key belongs to alert channels; in a DMS body it is ignored. The DMS configuration goes in `external_webhook_settings.config`.",{"_3697":1145,"_31245":1044,"_21577":54517,"_5":14884,"_28435":54223,"_3074":54518},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3697":1146,"_31245":1044,"_21577":54520,"_5":14884,"_28435":54223,"_3074":54521},[],"The console exposes independent editors for the enrollment and re-enrollment authentication, with the same **Log Level**, **Call Timeout**, **HTTP Authentication** and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (`insecure_skip_verify`, off by default; the console warns when you enable it). The editor rejects file paths in the certificate and key fields, and saving rewrites `external_webhook_settings.config` with the current keys and the material Base64-encoded. Configurations migrated from 3.8.0 that referenced files or relied on `validate_server_cert: false` need fixing; see DMS webhooks.",{"_3697":1147,"_31245":1044,"_21577":54523,"_5":14884,"_28435":54227,"_3074":54524},[],"For an end-to-end first enrollment, follow Enroll and connect your first device.",{"_3697":1148,"_31245":1044,"_21577":54526,"_5":14884,"_28435":54227,"_3074":54527},[],"The examples on this page need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. They use Bash, curl with `--fail-with-body` and OpenSSL 3.x (openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal); work in a private directory. If you integrate a generic EST client, first check the Lamassu specifics described for each operation, such as the PEM response or the multipart format of `/serverkeygen`.",{"_3697":1149,"_31245":1044,"_21577":54529,"_5":14884,"_28435":54227,"_3074":54530},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Authentication and trust. Replace the host and `REPLACE_DMS_ID` with those of your installation:",{"_3697":1150,"_31245":1044,"_21577":54532,"_5":14884,"_28435":54227,"_3074":54533},[],"When a request fails, retain the HTTP code, headers and body before decoding anything. A 500 does not mean a transient failure: service denials return it too. Troubleshooting explains how to interpret them.",{"_3697":1151,"_31245":1044,"_21577":54535,"_5":14884,"_28435":54230,"_3074":54536},[],"`GET /cacerts` retrieves the certificates published by the DMS. The client can inspect the bundle and use approved certificates to build trust chains.",{"_3697":1152,"_31245":1044,"_21577":54538,"_5":14884,"_28435":54234,"_3074":54539},[],"`settings.ca_distribution_settings` determines which certificates `/cacerts` returns:",{"_3697":1153,"_31245":1044,"_21577":54541,"_5":14884,"_28435":54234,"_3074":54389},[],{"_3697":1154,"_31245":1044,"_21577":54543,"_5":14884,"_28435":54234,"_3074":54544},[],"Content it adds",{"_3697":1155,"_31245":1044,"_21577":54546,"_5":14884,"_28435":54234,"_3074":54547},[],"`include_system_ca` (**Include Lamassu System CA**)",{"_3697":1156,"_31245":1044,"_21577":54549,"_5":14884,"_28435":54234,"_3074":54550},[],"The available downstream TLS certificate. It can be a leaf, not an issuing CA.",{"_3697":1157,"_31245":1044,"_21577":54552,"_5":14884,"_28435":54234,"_3074":54553},[],"`include_enrollment_ca` (**Include Enrollment CA**)",{"_3697":1158,"_31245":1044,"_21577":54555,"_5":14884,"_28435":54234,"_3074":54556},[],"The selected enrollment CA certificate.",{"_3697":1159,"_31245":1044,"_21577":54558,"_5":14884,"_28435":54234,"_3074":54559},[],"`managed_cas` (**Managed CAs**)",{"_3697":1160,"_31245":1044,"_21577":54561,"_5":14884,"_28435":54234,"_3074":54562},[],"The explicitly selected CA certificates.",{"_3697":1161,"_31245":1044,"_21577":54564,"_5":14884,"_28435":54234,"_3074":54565},[],"The DMS does not add the ancestors of those CAs: selecting the enrollment CA does not publish its root or intermediates, which must be selected in **Managed CAs**. The set may contain leaves, roots and intermediates, including more than one hierarchy during a migration. A certificate's position does not define the chain: identify certificates by subject, issuer, AKI/SKI, signature and constraints.",{"_3697":1162,"_31245":1044,"_21577":54567,"_5":14884,"_28435":54238,"_3074":54568},[],"Send an HTTPS GET with an empty body and no EST credential. Gateway controls still apply.",{"_3697":1163,"_31245":1044,"_21577":54570,"_5":14884,"_28435":54238,"_3074":54571},[],"**Default response.** `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters.",{"_3697":1164,"_31245":1044,"_21577":54573,"_5":14884,"_28435":54238,"_3074":54574},[],"**PEM response.** Lamassu selects this format when `Accept` is exactly `application/x-pem-file` and returns the same value in `Content-Type`. The body contains the certificates in PEM.",{"_3697":1165,"_31245":1044,"_21577":54576,"_5":14884,"_28435":54242,"_3074":54577},[],"This example downloads the default response and converts it to PEM. It uses `EST_BASE` and `est-trust.pem` from Before you begin.",{"_3697":1166,"_31245":1044,"_21577":54579,"_5":14884,"_28435":54242,"_3074":54580},[],"Check fingerprints, issuers and dates against the distribution configuration. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3697":1167,"_31245":1044,"_21577":54582,"_5":14884,"_28435":54246,"_3074":54583},[],"`POST /simpleenroll` issues a device’s initial certificate from a CSR. Lamassu takes the device identifier from the CN and binds the issued certificate to the device identity. The private key stays on the client.",{"_3697":1168,"_31245":1044,"_21577":54585,"_5":14884,"_28435":54250,"_3074":54586},[],"The initial enrollment options are stored in `settings.enrollment_settings`:",{"_3697":1169,"_31245":1044,"_21577":54588,"_5":14884,"_28435":54250,"_3074":54389},[],{"_3697":1170,"_31245":1044,"_21577":54590,"_5":14884,"_28435":54250,"_3074":54392},[],{"_3697":1171,"_31245":1044,"_21577":54592,"_5":14884,"_28435":54250,"_3074":54593},[],"`protocol`",{"_3697":1172,"_31245":1044,"_21577":54595,"_5":14884,"_28435":54250,"_3074":54596},[],"`EST_RFC7030` for these operations.",{"_3697":1173,"_31245":1044,"_21577":54598,"_5":14884,"_28435":54250,"_3074":54599},[],"`enrollment_ca`",{"_3697":1174,"_31245":1044,"_21577":54601,"_5":14884,"_28435":54250,"_3074":54602},[],"ID of the CA that signs the certificates.",{"_3697":1175,"_31245":1044,"_21577":54604,"_5":14884,"_28435":54250,"_3074":54605},[],"`registration_mode`",{"_3697":1176,"_31245":1044,"_21577":54607,"_5":14884,"_28435":54250,"_3074":54608},[],"`JITP` creates an unknown device with the CSR CN as ID and the DMS as owner. `PRE_REGISTRATION` requires the ID to exist beforehand.",{"_3697":1177,"_31245":1044,"_21577":54610,"_5":14884,"_28435":54250,"_3074":54611},[],"`device_provisioning_profile`",{"_3697":1178,"_31245":1044,"_21577":54613,"_5":14884,"_28435":54250,"_3074":54614},[],"Tags, metadata and icon a device registered through JITP receives.",{"_3697":1179,"_31245":1044,"_21577":54616,"_5":14884,"_28435":54250,"_3074":54617},[],"`enable_replaceable_enrollment`",{"_3697":1180,"_31245":1044,"_21577":54619,"_5":14884,"_28435":54250,"_3074":54620},[],"Allows `/simpleenroll` for an existing ID in the same DMS.",{"_3697":1181,"_31245":1044,"_21577":54622,"_5":14884,"_28435":54250,"_3074":54623},[],"`verify_csr_signature` (**Verify CSR signature**)",{"_3697":1182,"_31245":1044,"_21577":54625,"_5":14884,"_28435":54250,"_3074":54626},[],"Verifies possession of the CSR key. Keep it `true`.",{"_3697":1183,"_31245":1044,"_21577":54628,"_5":14884,"_28435":54250,"_3074":54629},[],"`est_rfc7030_settings`",{"_3697":1184,"_31245":1044,"_21577":54631,"_5":14884,"_28435":54250,"_3074":54632},[],"Initial enrollment authentication; see Authentication per operation.",{"_3697":1185,"_31245":1044,"_21577":54634,"_5":14884,"_28435":54250,"_3074":54635},[],"**Registration and replacement.** With `PRE_REGISTRATION`, an existing device goes through the replacement check first, even without an identity; review the preregistration conditions before using this mode. Initial enrollment rejects an ID owned by another DMS. Replacement can attempt to revoke the previous certificate even if a later phase fails: it is not atomic. Do not enable it as an automatic response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3697":1186,"_31245":1044,"_21577":54637,"_5":14884,"_28435":54250,"_3074":54638},[],"**Issuance profile.** The profile is defined in `settings`, not in `enrollment_settings`, and applies to all three operations that issue certificates. `settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. The resolved profile must define an end-entity certificate: a `Sign as CA` profile is rejected at enrollment and re-enrollment time. The rules are documented in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3697":1187,"_31245":1044,"_21577":54640,"_5":14884,"_28435":54253,"_3074":54641},[],"Send `Content-Type: application/pkcs10` with a Base64-encoded DER PKCS#10 CSR in the body. Lamassu decodes the body directly as Base64, with no PEM or JSON wrapper.",{"_3697":1188,"_31245":1044,"_21577":54643,"_5":14884,"_28435":54253,"_3074":54644},[],"**Default response.** `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The PKCS#7 contains the issued certificate. Retrieve the CA certificates you need to validate its chain separately.",{"_3697":1189,"_31245":1044,"_21577":54646,"_5":14884,"_28435":54253,"_3074":54647},[],"**PEM response.** Send exactly `Accept: application/x-pem-file` to receive the certificate in PEM with `Content-Type: application/x-pem-file`.",{"_3697":1190,"_31245":1044,"_21577":54649,"_5":14884,"_28435":54256,"_3074":54650},[],"The example uses initial `CLIENT_CERTIFICATE` authentication and the files from Before you begin.",{"_3697":1191,"_31245":1044,"_21577":54652,"_5":14884,"_28435":54256,"_3074":54653},[],"**Prepare the CSR.** The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3697":1192,"_31245":1044,"_21577":54655,"_5":14884,"_28435":54256,"_3074":54656},[],"An implementation using hardware or its own store must produce the CSR through its resident key. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3697":1193,"_31245":1044,"_21577":54658,"_5":14884,"_28435":54256,"_3074":54659},[],"**Request the identity.** Send the CSR, authenticating with the bootstrap credential:",{"_3697":1194,"_31245":1044,"_21577":54661,"_5":14884,"_28435":54256,"_3074":54662},[],"If curl fails, the example stops before decoding: an error response is not a certificate. A timeout leaves the operation's result to be checked in Lamassu, so do not automatically repeat issuance.",{"_3697":1195,"_31245":1044,"_21577":54664,"_5":14884,"_28435":54256,"_3074":54665},[],"**Check and install the result.** For a root that issues directly:",{"_3697":1196,"_31245":1044,"_21577":54667,"_5":14884,"_28435":54256,"_3074":54668},[],"`cmp` must exit with code 0. Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3697":1197,"_31245":1044,"_21577":54670,"_5":14884,"_28435":54256,"_3074":54671},[],"Query the device in Lamassu: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism; association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3697":1198,"_31245":1044,"_21577":54673,"_5":14884,"_28435":54259,"_3074":54674},[],"`POST /simplereenroll` issues a successor certificate for an active identity. The client keeps the device identifier and can request the certificate with a new key.",{"_3697":1199,"_31245":1044,"_21577":54676,"_5":14884,"_28435":54263,"_3074":54677},[],"The renewal options are stored in `settings.reenrollment_settings`:",{"_3697":1200,"_31245":1044,"_21577":54679,"_5":14884,"_28435":54263,"_3074":54389},[],{"_3697":1201,"_31245":1044,"_21577":54681,"_5":14884,"_28435":54263,"_3074":54392},[],{"_3697":1202,"_31245":1044,"_21577":54683,"_5":14884,"_28435":54263,"_3074":54629},[],{"_3697":1203,"_31245":1044,"_21577":54685,"_5":14884,"_28435":54263,"_3074":54686},[],"Re-enrollment authentication, independent of the initial one; see Authentication per operation.",{"_3697":1204,"_31245":1044,"_21577":54688,"_5":14884,"_28435":54263,"_3074":54689},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3697":1205,"_31245":1044,"_21577":54691,"_5":14884,"_28435":54263,"_3074":54692},[],"Re-enrollment validation CAs, tried after the enrollment CA. Optional; typically populated during a CA rotation while devices with old-CA certificates renew.",{"_3697":1206,"_31245":1044,"_21577":54694,"_5":14884,"_28435":54263,"_3074":54695},[],"`reenrollment_delta`",{"_3697":1207,"_31245":1044,"_21577":54697,"_5":14884,"_28435":54263,"_3074":54698},[],"The renewal window opens at the active certificate’s `NotAfter` minus this delta.",{"_3697":1208,"_31245":1044,"_21577":54700,"_5":14884,"_28435":54263,"_3074":54701},[],"`preventive_delta`",{"_3697":1209,"_31245":1044,"_21577":54703,"_5":14884,"_28435":54263,"_3074":54704},[],"Preventive monitoring threshold. Produces states and notifications; it does not extend the window.",{"_3697":1210,"_31245":1044,"_21577":54706,"_5":14884,"_28435":54263,"_3074":54707},[],"`critical_delta`",{"_3697":1211,"_31245":1044,"_21577":54709,"_5":14884,"_28435":54263,"_3074":54710},[],"Critical monitoring threshold. Produces states and notifications; it does not extend the window.",{"_3697":1212,"_31245":1044,"_21577":54712,"_5":14884,"_28435":54263,"_3074":54713},[],"`enable_expired_renewal` (**Allow expired renewal**)",{"_3697":1213,"_31245":1044,"_21577":54715,"_5":14884,"_28435":54263,"_3074":54716},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3697":1214,"_31245":1044,"_21577":54718,"_5":14884,"_28435":54263,"_3074":54719},[],"`revoke_on_reenrollment` (**Revoke on Re-enrollment**)",{"_3697":1215,"_31245":1044,"_21577":54721,"_5":14884,"_28435":54263,"_3074":54722},[],"If the previous certificate is `ACTIVE`, attempts to revoke it with reason Superseded before binding its successor.",{"_3697":1216,"_31245":1044,"_21577":54724,"_5":14884,"_28435":54263,"_3074":54725},[],"The legacy flat field `reenrollment_settings.additional_validation_cas` is not part of the API: it is ignored without error, so an update body built with it empties `validation_cas`. Read the DMS before editing it through the API.",{"_3697":1217,"_31245":1044,"_21577":54727,"_5":14884,"_28435":54263,"_3074":54728},[],"Monitoring does not renew: the client must schedule the request and installation with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed; see Recover according to state.",{"_3697":1218,"_31245":1044,"_21577":54730,"_5":14884,"_28435":54266,"_3074":54731},[],"Use the same CSR format and headers as `simpleenroll`. The response contains the successor certificate in Base64-encoded DER PKCS#7, or in PEM if you send exactly `Accept: application/x-pem-file`.",{"_3697":1219,"_31245":1044,"_21577":54733,"_5":14884,"_28435":54266,"_3074":54734},[],"With certificate authentication, Lamassu requires the credential’s CN to match the CSR’s CN and compares the requested subject with the current certificate. The DMS rejects a revoked current certificate or a request made before the renewal window. Client certificate details accepted CAs, expiry and revocation checks.",{"_3697":1220,"_31245":1044,"_21577":54736,"_5":14884,"_28435":54269,"_3074":54737},[],"The example continues the initial enrollment in the same Bash session, with `device.crt` and `device.key` as the current identity.",{"_3697":1221,"_31245":1044,"_21577":54739,"_5":14884,"_28435":54269,"_3074":54740},[],"**Prepare renewal.** Before requesting the successor:",{"_3697":1222,"_31245":1044,"_21577":54742,"_5":14884,"_28435":54269,"_3074":54743},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3697":1223,"_31245":1044,"_21577":54745,"_5":14884,"_28435":54269,"_3074":54746},[],"Check the re-enrollment authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3697":1224,"_31245":1044,"_21577":54748,"_5":14884,"_28435":54269,"_3074":54749},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`.",{"_3697":1225,"_31245":1044,"_21577":54751,"_5":14884,"_28435":54269,"_3074":54752},[],"Review **Revoke on Re-enrollment**. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3697":1226,"_31245":1044,"_21577":54754,"_5":14884,"_28435":54269,"_3074":54755},[],"**Request the successor certificate.** The request authenticates with `device.crt` and `device.key`, and the CSR contains a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C, so rebuilding only the CN can lose required attributes.",{"_3697":1227,"_31245":1044,"_21577":54757,"_5":14884,"_28435":54269,"_3074":54758},[],"Also check extensions, dates and that the serial matches the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3697":1228,"_31245":1044,"_21577":54760,"_5":14884,"_28435":54269,"_3074":54761},[],"**Install and check the new pair.** Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3697":1229,"_31245":1044,"_21577":54763,"_5":14884,"_28435":54269,"_3074":54764},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3697":1230,"_31245":1044,"_21577":54766,"_5":14884,"_28435":54272,"_3074":54767},[],"Situation",{"_3697":1231,"_31245":1044,"_21577":54769,"_5":14884,"_28435":54272,"_3074":54770},[],"Procedure",{"_3697":1232,"_31245":1044,"_21577":54772,"_5":14884,"_28435":54272,"_3074":54773},[],"Valid certificate, outside the window",{"_3697":1233,"_31245":1044,"_21577":54775,"_5":14884,"_28435":54272,"_3074":54776},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3697":1234,"_31245":1044,"_21577":54778,"_5":14884,"_28435":54272,"_3074":54779},[],"Expired certificate, key available",{"_3697":1235,"_31245":1044,"_21577":54781,"_5":14884,"_28435":54272,"_3074":54782},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3697":1236,"_31245":1044,"_21577":54784,"_5":14884,"_28435":54272,"_3074":54785},[],"Renewal through webhook or `NO_AUTH`",{"_3697":1237,"_31245":1044,"_21577":54787,"_5":14884,"_28435":54272,"_3074":54788},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the webhook must explicitly authorize the recovery it permits.",{"_3697":1238,"_31245":1044,"_21577":54790,"_5":14884,"_28435":54272,"_3074":54791},[],"Lost or inaccessible key",{"_3697":1239,"_31245":1044,"_21577":54793,"_5":14884,"_28435":54272,"_3074":54794},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3697":1240,"_31245":1044,"_21577":54796,"_5":14884,"_28435":54272,"_3074":54797},[],"Current identity revoked",{"_3697":1241,"_31245":1044,"_21577":54799,"_5":14884,"_28435":54272,"_3074":54800},[],"`simplereenroll` rejects the revoked current certificate, and retaining its files does not restore a valid connection. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3697":1242,"_31245":1044,"_21577":54802,"_5":14884,"_28435":54272,"_3074":54803},[],"Device without an identity",{"_3697":1243,"_31245":1044,"_21577":54805,"_5":14884,"_28435":54272,"_3074":54806},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3697":1244,"_31245":1044,"_21577":54808,"_5":14884,"_28435":54272,"_3074":54809},[],"Retired device",{"_3697":1245,"_31245":1044,"_21577":54811,"_5":14884,"_28435":54272,"_3074":54812},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3697":1246,"_31245":1044,"_21577":54814,"_5":14884,"_28435":54272,"_3074":54815},[],"Timeout, HTTP 500 or installation failure",{"_3697":1247,"_31245":1044,"_21577":54817,"_5":14884,"_28435":54272,"_3074":54818},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3697":1248,"_31245":1044,"_21577":54820,"_5":14884,"_28435":54276,"_3074":54821},[],"`POST /serverkeygen` generates a software key in Lamassu, rebuilds the CSR with that key and performs initial enrollment. The client receives the private key and certificate.",{"_3697":1249,"_31245":1044,"_21577":54823,"_5":14884,"_28435":54280,"_3074":54824},[],"`settings.server_keygen_settings` controls key generation. The rest of the operation applies the initial enrollment configuration; before testing with a registered ID, check whether that configuration allows certificate replacement.",{"_3697":1250,"_31245":1044,"_21577":54826,"_5":14884,"_28435":54280,"_3074":54389},[],{"_3697":1251,"_31245":1044,"_21577":54828,"_5":14884,"_28435":54280,"_3074":54392},[],{"_3697":1252,"_31245":1044,"_21577":54830,"_5":14884,"_28435":54280,"_3074":54831},[],"`enabled` (**Enable server-side key generation**)",{"_3697":1253,"_31245":1044,"_21577":54833,"_5":14884,"_28435":54280,"_3074":54834},[],"Turns on the operation. With the operation disabled, the console omits the `key` field.",{"_3697":1254,"_31245":1044,"_21577":54836,"_5":14884,"_28435":54280,"_3074":54837},[],"`key.type` (**Key type**)",{"_3697":1255,"_31245":1044,"_21577":54839,"_5":14884,"_28435":54280,"_3074":54840},[],"RSA or ECDSA. The issuance profile must allow the selected algorithm and size.",{"_3697":1256,"_31245":1044,"_21577":54842,"_5":14884,"_28435":54280,"_3074":54843},[],"`key.bits`",{"_3697":1257,"_31245":1044,"_21577":54845,"_5":14884,"_28435":54280,"_3074":54846},[],"Modulus size for RSA or curve for ECDSA. The console offers 2048, 3072 or 4096 bits for RSA (default 4096) and P-256, P-384 or P-521 for ECDSA (default P-256).",{"_3697":1258,"_31245":1044,"_21577":54848,"_5":14884,"_28435":54280,"_3074":54849},[],"For ECDSA, the service also recognizes 224, 256, 384 and 521 as P-224, P-256, P-384 and P-521, and an unrecognized value selects P-256. Choose a compatible size and check the resulting key.",{"_3697":1259,"_31245":1044,"_21577":54851,"_5":14884,"_28435":54283,"_3074":54852},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The response uses this operation’s multipart format even if `Accept` asks for PEM. Lamassu generates the key in software even when the CA signs with an HSM-backed key.",{"_3697":1260,"_31245":1044,"_21577":54854,"_5":14884,"_28435":54283,"_3074":54855},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`, and contains two parts:",{"_3697":1261,"_31245":1044,"_21577":54857,"_5":14884,"_28435":54283,"_3074":54858},[],"Part",{"_3697":1262,"_31245":1044,"_21577":54860,"_5":14884,"_28435":54283,"_3074":54861},[],"Content after decoding its Base64",{"_3697":1263,"_31245":1044,"_21577":54863,"_5":14884,"_28435":54283,"_3074":54864},[],"`application/pkcs8`",{"_3697":1264,"_31245":1044,"_21577":54866,"_5":14884,"_28435":54283,"_3074":54867},[],"Unencrypted DER PKCS#8 private key.",{"_3697":1265,"_31245":1044,"_21577":54869,"_5":14884,"_28435":54283,"_3074":54870},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3697":1266,"_31245":1044,"_21577":54872,"_5":14884,"_28435":54283,"_3074":54873},[],"DER PKCS#7 containing the issued certificate.",{"_3697":1267,"_31245":1044,"_21577":54875,"_5":14884,"_28435":54283,"_3074":54876},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3697":1268,"_31245":1044,"_21577":54878,"_5":14884,"_28435":54286,"_3074":54879},[],"The example uses `EST_BASE` and the trust and bootstrap files from Before you begin. Choose an available and admitted ID, such as `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3697":1269,"_31245":1044,"_21577":54881,"_5":14884,"_28435":54286,"_3074":54882},[],"Process the MIME parts according to their headers and verify that the received key matches the certificate. Inspect the CN, serial, dates and uses, and check the association in Lamassu before installing. Protect files containing the key and remove temporary copies according to the device storage mechanism.",{"_3697":1270,"_31245":1044,"_21577":54884,"_5":14884,"_28435":54286,"_3074":54885},[],"<Card title=\"Authentication and trust\" description=\"Bootstrap credentials, the webhook contract and revocation checks.\" href=\"/docs/platform/iot-fleets/est/bootstrap-identity\" />",{"_3697":1271,"_31245":1044,"_21577":54887,"_5":14884,"_28435":54286,"_3074":54888},[],"<Card title=\"Devices and identities\" description=\"Check the slot, history and status of each issued identity.\" href=\"/docs/platform/iot-fleets/device-management\" />",{"_3697":1272,"_31245":1044,"_21577":54890,"_5":14884,"_28435":54286,"_3074":54891},[],"<Card title=\"Enrollment troubleshooting\" description=\"Locate transport, authentication, registration, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/est/troubleshooting\" />",{"_3697":1273,"_31245":1273,"_5":15238,"_3074":54893,"_31570":54894,"_21577":54895,"_28435":1273},"EST Reference",[50948,52489,53661,54123],[],{"_3697":1274,"_31245":1273,"_21577":54897,"_5":14884,"_28435":1273,"_3074":54898},[],"The Enrollment over Secure Transport protocol defined by RFC 7030.",{"_3697":1275,"_31245":1273,"_5":31567,"_21577":54900,"_28435":54901,"_3074":52249},[],"/docs/platform/iot-fleets/est#operations",{"_3697":1276,"_31245":1273,"_5":31567,"_21577":54903,"_28435":54904,"_3074":54905},[],"/docs/platform/iot-fleets/est#authentication-and-messages","Authentication and messages",{"_3697":1277,"_31245":1273,"_21577":54907,"_5":14884,"_28435":1273,"_3074":54908},[],"Enrollment over Secure Transport (EST) is a protocol for obtaining and renewing X.509 certificates over HTTPS. An EST client communicates with an EST server, which handles certificate requests and provides certification authority certificates. The standard defines messages, operations and authentication mechanisms. RFC 7030",{"_3697":1278,"_31245":1273,"_21577":54910,"_5":14884,"_28435":54901,"_3074":54911},[],"Operation paths are appended to the `/.well-known/est` prefix, which may include a label identifying the CA or service.",{"_3697":1279,"_31245":1273,"_21577":54913,"_5":14884,"_28435":54901,"_3074":54295},[],{"_3697":1280,"_31245":1273,"_21577":54915,"_5":14884,"_28435":54901,"_3074":54298},[],{"_3697":1281,"_31245":1273,"_21577":54917,"_5":14884,"_28435":54901,"_3074":51338},[],{"_3697":1282,"_31245":1273,"_21577":54919,"_5":14884,"_28435":54901,"_3074":54920},[],"Server support",{"_3697":1283,"_31245":1273,"_21577":54922,"_5":14884,"_28435":54901,"_3074":54304},[],{"_3697":1284,"_31245":1273,"_21577":54924,"_5":14884,"_28435":54901,"_3074":54307},[],{"_3697":1285,"_31245":1273,"_21577":54926,"_5":14884,"_28435":54901,"_3074":54927},[],"Retrieve CA certificates.",{"_3697":1286,"_31245":1273,"_21577":54929,"_5":14884,"_28435":54901,"_3074":54930},[],"Mandatory",{"_3697":1287,"_31245":1273,"_21577":54932,"_5":14884,"_28435":54901,"_3074":54313},[],{"_3697":1288,"_31245":1273,"_21577":54934,"_5":14884,"_28435":54901,"_3074":54316},[],{"_3697":1289,"_31245":1273,"_21577":54936,"_5":14884,"_28435":54901,"_3074":54937},[],"Request an initial certificate using a CSR.",{"_3697":1290,"_31245":1273,"_21577":54939,"_5":14884,"_28435":54901,"_3074":54930},[],{"_3697":1291,"_31245":1273,"_21577":54941,"_5":14884,"_28435":54901,"_3074":54322},[],{"_3697":1292,"_31245":1273,"_21577":54943,"_5":14884,"_28435":54901,"_3074":54316},[],{"_3697":1293,"_31245":1273,"_21577":54945,"_5":14884,"_28435":54901,"_3074":54946},[],"Request certificate renewal or rekeying.",{"_3697":1294,"_31245":1273,"_21577":54948,"_5":14884,"_28435":54901,"_3074":54930},[],{"_3697":1295,"_31245":1273,"_21577":54950,"_5":14884,"_28435":54901,"_3074":54330},[],{"_3697":1296,"_31245":1273,"_21577":54952,"_5":14884,"_28435":54901,"_3074":54316},[],{"_3697":1297,"_31245":1273,"_21577":54954,"_5":14884,"_28435":54901,"_3074":54955},[],"Request a server-generated key and its certificate.",{"_3697":1298,"_31245":1273,"_21577":54957,"_5":14884,"_28435":54901,"_3074":54958},[],"Optional",{"_3697":1299,"_31245":1273,"_21577":54960,"_5":14884,"_28435":54901,"_3074":54961},[],"`/csrattrs`",{"_3697":1300,"_31245":1273,"_21577":54963,"_5":14884,"_28435":54901,"_3074":54307},[],{"_3697":1301,"_31245":1273,"_21577":54965,"_5":14884,"_28435":54901,"_3074":54966},[],"Retrieve suggested CSR attributes.",{"_3697":1302,"_31245":1273,"_21577":54968,"_5":14884,"_28435":54901,"_3074":54958},[],{"_3697":1303,"_31245":1273,"_21577":54970,"_5":14884,"_28435":54901,"_3074":54971},[],"`/fullcmc`",{"_3697":1304,"_31245":1273,"_21577":54973,"_5":14884,"_28435":54901,"_3074":54316},[],{"_3697":1305,"_31245":1273,"_21577":54975,"_5":14884,"_28435":54901,"_3074":54976},[],"Submit a Full CMC request.",{"_3697":1306,"_31245":1273,"_21577":54978,"_5":14884,"_28435":54901,"_3074":54958},[],{"_3697":1307,"_31245":1273,"_21577":54980,"_5":14884,"_28435":54904,"_3074":54981},[],"EST uses TLS to protect the exchange. The client authenticates the server, and the server authenticates and authorizes the client using the mechanisms defined by the standard. Initial CA certificate distribution has specific conditions for establishing trust. RFC 7030, sections 3.3 and 4.1",{"_3697":1308,"_31245":1273,"_21577":54983,"_5":14884,"_28435":54904,"_3074":54984},[],"The `/simpleenroll` and `/simplereenroll` requests use a PKCS#10 CSR. The certificate response uses PKCS#7. The `/serverkeygen` response is `multipart/mixed` and contains the key and certificate. The standard also defines Full CMC requests and responses and the CSR attributes format. RFC 7030, section 3.2.4",{"_3697":1309,"_31245":1273,"_21577":54986,"_5":14884,"_28435":54904,"_3074":54987},[],"See EST in Lamassu for the available operations and their configuration.",{"_3697":1310,"_31245":1310,"_5":15238,"_3074":54989,"_31570":54990,"_21577":54991,"_28435":1310},"Enrollment troubleshooting",[50948,52489,53661,54123],[],{"_3697":1311,"_31245":1310,"_21577":54993,"_5":14884,"_28435":1310,"_3074":54994},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3697":1312,"_31245":1310,"_5":31567,"_21577":54996,"_28435":54997,"_3074":54998},[],"/docs/platform/iot-fleets/est/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3697":1313,"_31245":1310,"_5":31567,"_21577":55000,"_28435":55001,"_3074":55002},[],"/docs/platform/iot-fleets/est/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3697":1314,"_31245":1310,"_5":31567,"_21577":55004,"_28435":55005,"_3074":55006},[],"/docs/platform/iot-fleets/est/troubleshooting#compatibility-notes","Compatibility notes",{"_3697":1315,"_31245":1310,"_5":31567,"_21577":55008,"_28435":55009,"_3074":55010},[],"/docs/platform/iot-fleets/est/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3697":1316,"_31245":1310,"_21577":55012,"_5":14884,"_28435":1310,"_3074":55013},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3697":1317,"_31245":1310,"_21577":55015,"_5":14884,"_28435":55001,"_3074":55016},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3697":1318,"_31245":1310,"_21577":55018,"_5":14884,"_28435":55001,"_3074":55019},[],"Symptom or message",{"_3697":1319,"_31245":1310,"_21577":55021,"_5":14884,"_28435":55001,"_3074":54030},[],{"_3697":1320,"_31245":1310,"_21577":55023,"_5":14884,"_28435":55001,"_3074":55024},[],"curl rejects TLS, name or issuer",{"_3697":1321,"_31245":1310,"_21577":55026,"_5":14884,"_28435":55001,"_3074":55027},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3697":1322,"_31245":1310,"_21577":55029,"_5":14884,"_28435":55001,"_3074":55030},[],"404 or missing APS",{"_3697":1323,"_31245":1310,"_21577":55032,"_5":14884,"_28435":55001,"_3074":55033},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3697":1324,"_31245":1310,"_21577":55035,"_5":14884,"_28435":55001,"_3074":55036},[],"400, CSR or format error",{"_3697":1325,"_31245":1310,"_21577":55038,"_5":14884,"_28435":55001,"_3074":55039},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3697":1326,"_31245":1310,"_21577":55041,"_5":14884,"_28435":55001,"_3074":55042},[],"Missing credential or invalid certificate",{"_3697":1327,"_31245":1310,"_21577":55044,"_5":14884,"_28435":55001,"_3074":55045},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3697":1328,"_31245":1310,"_21577":55047,"_5":14884,"_28435":55001,"_3074":55048},[],"Enroll or re-enroll rejects a certificate for unverifiable revocation",{"_3697":1329,"_31245":1310,"_21577":55050,"_5":14884,"_28435":55001,"_3074":55051},[],"Whether the certificate is managed by Lamassu, whether its OCSP/CRL endpoints are configured and reachable from the service, and whether `allow_unverifiable_revocation` is set for that operation's block. See DMS and Revocation and checks.",{"_3697":1330,"_31245":1310,"_21577":55053,"_5":14884,"_28435":55001,"_3074":55054},[],"Webhook denies, times out or responds without authorization",{"_3697":1331,"_31245":1310,"_21577":55056,"_5":14884,"_28435":55001,"_3074":55057},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3697":1332,"_31245":1310,"_21577":55059,"_5":14884,"_28435":55001,"_3074":55060},[],"`unexpected status code: <n>: redirects are not followed`",{"_3697":1333,"_31245":1310,"_21577":55062,"_5":14884,"_28435":55001,"_3074":55063},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3697":1334,"_31245":1310,"_21577":55065,"_5":14884,"_28435":55001,"_3074":55066},[],"`webhook response exceeds 1048576 bytes`",{"_3697":1335,"_31245":1310,"_21577":55068,"_5":14884,"_28435":55001,"_3074":55069},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3697":1336,"_31245":1310,"_21577":55071,"_5":14884,"_28435":55001,"_3074":55072},[],"`webhook config must not reference files`",{"_3697":1337,"_31245":1310,"_21577":55074,"_5":14884,"_28435":55001,"_3074":55075},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3697":1338,"_31245":1310,"_21577":55077,"_5":14884,"_28435":55001,"_3074":55078},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3697":1339,"_31245":1310,"_21577":55080,"_5":14884,"_28435":55001,"_3074":55081},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3697":1340,"_31245":1310,"_21577":55083,"_5":14884,"_28435":55001,"_3074":55084},[],"`webhook mTLS certificate and key are invalid: …`",{"_3697":1341,"_31245":1310,"_21577":55086,"_5":14884,"_28435":55001,"_3074":55087},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3697":1342,"_31245":1310,"_21577":55089,"_5":14884,"_28435":55001,"_3074":55090},[],"400 `struct validation error` creating or updating a DMS",{"_3697":1343,"_31245":1310,"_21577":55092,"_5":14884,"_28435":55001,"_3074":55093},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3697":1344,"_31245":1310,"_21577":55095,"_5":14884,"_28435":55001,"_3074":55096},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3697":1345,"_31245":1310,"_21577":55098,"_5":14884,"_28435":55001,"_3074":55099},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3697":1346,"_31245":1310,"_21577":55101,"_5":14884,"_28435":55001,"_3074":55102},[],"`device not preregistered`",{"_3697":1347,"_31245":1310,"_21577":55104,"_5":14884,"_28435":55001,"_3074":55105},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3697":1348,"_31245":1310,"_21577":55107,"_5":14884,"_28435":55001,"_3074":55108},[],"`forbiddenNewEnrollment`",{"_3697":1349,"_31245":1310,"_21577":55110,"_5":14884,"_28435":55001,"_3074":55111},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3697":1350,"_31245":1310,"_21577":55113,"_5":14884,"_28435":55001,"_3074":55114},[],"Different owning DMS",{"_3697":1351,"_31245":1310,"_21577":55116,"_5":14884,"_28435":55001,"_3074":55117},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3697":1352,"_31245":1310,"_21577":55119,"_5":14884,"_28435":55001,"_3074":55120},[],"`invalid RawSubject bytes`",{"_3697":1353,"_31245":1310,"_21577":55122,"_5":14884,"_28435":55001,"_3074":55123},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3697":1354,"_31245":1310,"_21577":55125,"_5":14884,"_28435":55001,"_3074":55126},[],"`invalid reenroll window`",{"_3697":1355,"_31245":1310,"_21577":55128,"_5":14884,"_28435":55001,"_3074":55129},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3697":1356,"_31245":1310,"_21577":55131,"_5":14884,"_28435":55001,"_3074":55132},[],"Current certificate revoked",{"_3697":1357,"_31245":1310,"_21577":55134,"_5":14884,"_28435":55001,"_3074":55135},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3697":1358,"_31245":1310,"_21577":55137,"_5":14884,"_28435":55001,"_3074":55138},[],"CA, profile or signing error",{"_3697":1359,"_31245":1310,"_21577":55140,"_5":14884,"_28435":55001,"_3074":55141},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3697":1360,"_31245":1310,"_21577":55143,"_5":14884,"_28435":55001,"_3074":55144},[],"HTTP 200 without a device connection",{"_3697":1361,"_31245":1310,"_21577":55146,"_5":14884,"_28435":55001,"_3074":55147},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3697":1362,"_31245":1310,"_21577":55149,"_5":14884,"_28435":55001,"_3074":55150},[],"Timeout or error after issuance",{"_3697":1363,"_31245":1310,"_21577":55152,"_5":14884,"_28435":55001,"_3074":55153},[],"New certificates, current slot and previous identity's state before retrying.",{"_3697":1364,"_31245":1310,"_21577":55155,"_5":14884,"_28435":55005,"_3074":55156},[],"Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3697":1365,"_31245":1310,"_21577":55158,"_5":14884,"_28435":55005,"_3074":55159},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST in Lamassu.",{"_3697":1366,"_31245":1310,"_21577":55161,"_5":14884,"_28435":55009,"_3074":55162},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3697":1367,"_31245":1310,"_21577":55164,"_5":14884,"_28435":55009,"_3074":55165},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3697":1368,"_31245":1310,"_21577":55167,"_5":14884,"_28435":55009,"_3074":55168},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3697":1369,"_31245":1310,"_21577":55170,"_5":14884,"_28435":55009,"_3074":55171},[],"Make one request, save headers/body and query the device and certificates.",{"_3697":1370,"_31245":1310,"_21577":55173,"_5":14884,"_28435":55009,"_3074":55174},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3697":1371,"_31245":1310,"_21577":55176,"_5":14884,"_28435":55009,"_3074":55177},[],"External bootstrap revocation checks fail closed: a certificate whose revocation cannot be verified (including an OCSP Unknown status) is rejected by default. Only `allow_unverifiable_revocation` in that operation's block (see DMS) relaxes it, and only for certificates that carry no OCSP/CRL endpoint at all; unreachable, stale or inconclusive endpoints are rejected whatever the option says. See Revocation and checks. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3697":1372,"_31245":1310,"_21577":55179,"_5":14884,"_28435":55009,"_3074":55180},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3697":1373,"_31245":1373,"_5":15238,"_3074":55182,"_31570":55183,"_21577":55185,"_28435":1373},"AWS IoT Core",[50948,52489,53661,53659,55184],"Integrations",[],{"_3697":1374,"_31245":1373,"_21577":55187,"_5":14884,"_28435":1373,"_3074":55188},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3697":1375,"_31245":1373,"_5":31567,"_21577":55190,"_28435":55191,"_3074":55192},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3697":1376,"_31245":1373,"_5":31567,"_21577":55194,"_28435":55195,"_3074":55196},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3697":1377,"_31245":1373,"_5":31567,"_21577":55198,"_28435":55199,"_3074":55200},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3697":1378,"_31245":1373,"_5":31567,"_21577":55202,"_28435":55203,"_3074":55204},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3697":1379,"_31245":1373,"_5":31567,"_21577":55206,"_28435":55207,"_3074":55208},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3697":1380,"_31245":1373,"_5":31567,"_21577":55210,"_28435":55211,"_3074":55212},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3697":1381,"_31245":1373,"_5":31567,"_21577":55214,"_28435":55215,"_3074":55216},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3697":1382,"_31245":1373,"_5":31567,"_21577":55218,"_28435":55219,"_3074":55220},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3697":1383,"_31245":1373,"_5":31567,"_21577":55222,"_28435":55223,"_3074":55224},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3697":1384,"_31245":1373,"_5":31567,"_21577":55226,"_28435":55227,"_3074":55228},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3697":1385,"_31245":1373,"_5":31567,"_21577":55230,"_28435":55231,"_3074":55232},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3697":1386,"_31245":1373,"_5":31567,"_21577":55234,"_28435":55235,"_3074":55236},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3697":1387,"_31245":1373,"_5":31567,"_21577":55238,"_28435":55239,"_3074":55240},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3697":1388,"_31245":1373,"_5":31567,"_21577":55242,"_28435":55243,"_3074":55244},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3697":1389,"_31245":1373,"_5":31567,"_21577":55246,"_28435":55247,"_3074":55248},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3697":1390,"_31245":1373,"_5":31567,"_21577":55250,"_28435":55251,"_3074":55252},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3697":1391,"_31245":1373,"_5":31567,"_21577":55254,"_28435":55255,"_3074":55256},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3697":1392,"_31245":1373,"_5":31567,"_21577":55258,"_28435":55259,"_3074":55260},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3697":1393,"_31245":1373,"_5":31567,"_21577":55262,"_28435":55263,"_3074":55264},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3697":1394,"_31245":1373,"_5":31567,"_21577":55266,"_28435":55267,"_3074":55268},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3697":1395,"_31245":1373,"_5":31567,"_21577":55270,"_28435":55271,"_3074":55272},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3697":1396,"_31245":1373,"_5":31567,"_21577":55274,"_28435":55275,"_3074":55276},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3697":1397,"_31245":1373,"_5":31567,"_21577":55278,"_28435":55279,"_3074":55280},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3697":1398,"_31245":1373,"_5":31567,"_21577":55282,"_28435":55283,"_3074":55284},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3697":1399,"_31245":1373,"_5":31567,"_21577":55286,"_28435":55287,"_3074":55288},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3697":1400,"_31245":1373,"_21577":55290,"_5":14884,"_28435":1373,"_3074":55291},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3697":1401,"_31245":1373,"_21577":55293,"_5":14884,"_28435":1373,"_3074":55294},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3697":1402,"_31245":1373,"_21577":55296,"_5":14884,"_28435":1373,"_3074":55297},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3697":1403,"_31245":1373,"_21577":55299,"_5":14884,"_28435":55191,"_3074":55300},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3697":1404,"_31245":1373,"_21577":55302,"_5":14884,"_28435":55191,"_3074":55303},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3697":1405,"_31245":1373,"_21577":55305,"_5":14884,"_28435":55191,"_3074":55306},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3697":1406,"_31245":1373,"_21577":55308,"_5":14884,"_28435":55191,"_3074":55309},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3697":1407,"_31245":1373,"_21577":55311,"_5":14884,"_28435":55195,"_3074":55312},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3697":1408,"_31245":1373,"_21577":55314,"_5":14884,"_28435":55199,"_3074":55315},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3697":1409,"_31245":1373,"_21577":55317,"_5":14884,"_28435":55199,"_3074":55318},[],"IAM action",{"_3697":1410,"_31245":1373,"_21577":55320,"_5":14884,"_28435":55199,"_3074":51338},[],{"_3697":1411,"_31245":1373,"_21577":55322,"_5":14884,"_28435":55199,"_3074":55323},[],"`iot:GetRegistrationCode`",{"_3697":1412,"_31245":1373,"_21577":55325,"_5":14884,"_28435":55199,"_3074":55326},[],"Obtain the verification code for CA registration in the Primary Account",{"_3697":1413,"_31245":1373,"_21577":55328,"_5":14884,"_28435":55199,"_3074":55329},[],"`iot:RegisterCACertificate`",{"_3697":1414,"_31245":1373,"_21577":55331,"_5":14884,"_28435":55199,"_3074":55332},[],"Register the CA in AWS IoT",{"_3697":1415,"_31245":1373,"_21577":55334,"_5":14884,"_28435":55199,"_3074":55335},[],"`iot:DescribeCACertificate`",{"_3697":1416,"_31245":1373,"_21577":55337,"_5":14884,"_28435":55199,"_3074":55338},[],"Check the CA registration status",{"_3697":1417,"_31245":1373,"_21577":55340,"_5":14884,"_28435":55199,"_3074":55341},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3697":1418,"_31245":1373,"_21577":55343,"_5":14884,"_28435":55199,"_3074":55344},[],"Create or update Things in IoT Core",{"_3697":1419,"_31245":1373,"_21577":55346,"_5":14884,"_28435":55199,"_3074":55347},[],"`iot:RegisterThing`",{"_3697":1420,"_31245":1373,"_21577":55349,"_5":14884,"_28435":55199,"_3074":55350},[],"Provision Things through a template",{"_3697":1421,"_31245":1373,"_21577":55352,"_5":14884,"_28435":55199,"_3074":55353},[],"`iot:RegisterCertificate`",{"_3697":1422,"_31245":1373,"_21577":55355,"_5":14884,"_28435":55199,"_3074":55356},[],"Register device certificates",{"_3697":1423,"_31245":1373,"_21577":55358,"_5":14884,"_28435":55199,"_3074":55359},[],"`iot:UpdateCertificate`",{"_3697":1424,"_31245":1373,"_21577":55361,"_5":14884,"_28435":55199,"_3074":55362},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3697":1425,"_31245":1373,"_21577":55364,"_5":14884,"_28435":55199,"_3074":55365},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3697":1426,"_31245":1373,"_21577":55367,"_5":14884,"_28435":55199,"_3074":55368},[],"Create and attach IoT policies",{"_3697":1427,"_31245":1373,"_21577":55370,"_5":14884,"_28435":55199,"_3074":55371},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3697":1428,"_31245":1373,"_21577":55373,"_5":14884,"_28435":55199,"_3074":55374},[],"Manage Thing groups",{"_3697":1429,"_31245":1373,"_21577":55376,"_5":14884,"_28435":55199,"_3074":55377},[],"`iot:CreateProvisioningTemplate`",{"_3697":1430,"_31245":1373,"_21577":55379,"_5":14884,"_28435":55199,"_3074":55380},[],"Create JITP templates",{"_3697":1431,"_31245":1373,"_21577":55382,"_5":14884,"_28435":55199,"_3074":55383},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3697":1432,"_31245":1373,"_21577":55385,"_5":14884,"_28435":55199,"_3074":55386},[],"Read and write the Device Shadow",{"_3697":1433,"_31245":1373,"_21577":55388,"_5":14884,"_28435":55199,"_3074":55389},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3697":1434,"_31245":1373,"_21577":55391,"_5":14884,"_28435":55203,"_3074":55392},[],"Parameter",{"_3697":1435,"_31245":1373,"_21577":55394,"_5":14884,"_28435":55203,"_3074":55395},[],"Type",{"_3697":1436,"_31245":1373,"_21577":55397,"_5":14884,"_28435":55203,"_3074":55398},[],"Required",{"_3697":1437,"_31245":1373,"_21577":55400,"_5":14884,"_28435":55203,"_3074":54392},[],{"_3697":1438,"_31245":1373,"_21577":55402,"_5":14884,"_28435":55203,"_3074":55403},[],"`connector_id`",{"_3697":1439,"_31245":1373,"_21577":55405,"_5":14884,"_28435":55203,"_3074":25773},[],{"_3697":1440,"_31245":1373,"_21577":55407,"_5":14884,"_28435":55203,"_3074":55408},[],"Yes",{"_3697":1441,"_31245":1373,"_21577":55410,"_5":14884,"_28435":55203,"_3074":55411},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3697":1442,"_31245":1373,"_21577":55413,"_5":14884,"_28435":55203,"_3074":55414},[],"`aws_config.region`",{"_3697":1443,"_31245":1373,"_21577":55416,"_5":14884,"_28435":55203,"_3074":25773},[],{"_3697":1444,"_31245":1373,"_21577":55418,"_5":14884,"_28435":55203,"_3074":55408},[],{"_3697":1445,"_31245":1373,"_21577":55420,"_5":14884,"_28435":55203,"_3074":55421},[],"AWS region where the connector operates.",{"_3697":1446,"_31245":1373,"_21577":55423,"_5":14884,"_28435":55203,"_3074":55424},[],"`aws_config.auth_method`",{"_3697":1447,"_31245":1373,"_21577":55426,"_5":14884,"_28435":55203,"_3074":25773},[],{"_3697":1448,"_31245":1373,"_21577":55428,"_5":14884,"_28435":55203,"_3074":55408},[],{"_3697":1449,"_31245":1373,"_21577":55430,"_5":14884,"_28435":55203,"_3074":55431},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3697":1450,"_31245":1373,"_21577":55433,"_5":14884,"_28435":55203,"_3074":55434},[],"`aws_config.access_key_id`",{"_3697":1451,"_31245":1373,"_21577":55436,"_5":14884,"_28435":55203,"_3074":25773},[],{"_3697":1452,"_31245":1373,"_21577":55438,"_5":14884,"_28435":55203,"_3074":55439},[],"Only with `auth_method=static`",{"_3697":1453,"_31245":1373,"_21577":55441,"_5":14884,"_28435":55203,"_3074":55442},[],"AWS access key.",{"_3697":1454,"_31245":1373,"_21577":55444,"_5":14884,"_28435":55203,"_3074":55445},[],"`aws_config.secret_access_key`",{"_3697":1455,"_31245":1373,"_21577":55447,"_5":14884,"_28435":55203,"_3074":25773},[],{"_3697":1456,"_31245":1373,"_21577":55449,"_5":14884,"_28435":55203,"_3074":55439},[],{"_3697":1457,"_31245":1373,"_21577":55451,"_5":14884,"_28435":55203,"_3074":55452},[],"AWS secret key.",{"_3697":1458,"_31245":1373,"_21577":55454,"_5":14884,"_28435":55203,"_3074":55455},[],"`aws_config.session_token`",{"_3697":1459,"_31245":1373,"_21577":55457,"_5":14884,"_28435":55203,"_3074":25773},[],{"_3697":1460,"_31245":1373,"_21577":55459,"_5":14884,"_28435":55203,"_3074":55460},[],"No",{"_3697":1461,"_31245":1373,"_21577":55462,"_5":14884,"_28435":55203,"_3074":55463},[],"Session token (with `auth_method=static`).",{"_3697":1462,"_31245":1373,"_21577":55465,"_5":14884,"_28435":55203,"_3074":55466},[],"`aws_config.role_arn`",{"_3697":1463,"_31245":1373,"_21577":55468,"_5":14884,"_28435":55203,"_3074":25773},[],{"_3697":1464,"_31245":1373,"_21577":55470,"_5":14884,"_28435":55203,"_3074":55471},[],"Only with `auth_method=role`",{"_3697":1465,"_31245":1373,"_21577":55473,"_5":14884,"_28435":55203,"_3074":55474},[],"ARN of the role to assume.",{"_3697":1466,"_31245":1373,"_21577":55476,"_5":14884,"_28435":55203,"_3074":55477},[],"`aws_config.endpoint_url`",{"_3697":1467,"_31245":1373,"_21577":55479,"_5":14884,"_28435":55203,"_3074":25773},[],{"_3697":1468,"_31245":1373,"_21577":55481,"_5":14884,"_28435":55203,"_3074":55460},[],{"_3697":1469,"_31245":1373,"_21577":55483,"_5":14884,"_28435":55203,"_3074":55484},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3697":1470,"_31245":1373,"_21577":55486,"_5":14884,"_28435":55203,"_3074":55487},[],"`subscriber_event_bus`",{"_3697":1471,"_31245":1373,"_21577":55489,"_5":14884,"_28435":55203,"_3074":18189},[],{"_3697":1472,"_31245":1373,"_21577":55491,"_5":14884,"_28435":55203,"_3074":55408},[],{"_3697":1473,"_31245":1373,"_21577":55493,"_5":14884,"_28435":55203,"_3074":55494},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3697":1474,"_31245":1373,"_21577":55496,"_5":14884,"_28435":55203,"_3074":55497},[],"`dms_manager_client`",{"_3697":1475,"_31245":1373,"_21577":55499,"_5":14884,"_28435":55203,"_3074":25773},[],{"_3697":1476,"_31245":1373,"_21577":55501,"_5":14884,"_28435":55203,"_3074":55408},[],{"_3697":1477,"_31245":1373,"_21577":55503,"_5":14884,"_28435":55203,"_3074":55504},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3697":1478,"_31245":1373,"_21577":55506,"_5":14884,"_28435":55203,"_3074":55507},[],"`device_manager_client`",{"_3697":1479,"_31245":1373,"_21577":55509,"_5":14884,"_28435":55203,"_3074":25773},[],{"_3697":1480,"_31245":1373,"_21577":55511,"_5":14884,"_28435":55203,"_3074":55408},[],{"_3697":1481,"_31245":1373,"_21577":55513,"_5":14884,"_28435":55203,"_3074":55514},[],"HTTP URL of Lamassu's Device Manager.",{"_3697":1482,"_31245":1373,"_21577":55516,"_5":14884,"_28435":55203,"_3074":55517},[],"`ca_client`",{"_3697":1483,"_31245":1373,"_21577":55519,"_5":14884,"_28435":55203,"_3074":25773},[],{"_3697":1484,"_31245":1373,"_21577":55521,"_5":14884,"_28435":55203,"_3074":55408},[],{"_3697":1485,"_31245":1373,"_21577":55523,"_5":14884,"_28435":55203,"_3074":55524},[],"HTTP URL of Lamassu's CA service.",{"_3697":1486,"_31245":1373,"_21577":55526,"_5":14884,"_28435":55207,"_3074":55527},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3697":1487,"_31245":1373,"_21577":55529,"_5":14884,"_28435":55207,"_3074":55530},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3697":1488,"_31245":1373,"_21577":55532,"_5":14884,"_28435":55207,"_3074":55533},[],"CloudEvent type",{"_3697":1489,"_31245":1373,"_21577":55535,"_5":14884,"_28435":55207,"_3074":55536},[],"Lamassu resource",{"_3697":1490,"_31245":1373,"_21577":55538,"_5":14884,"_28435":55207,"_3074":55539},[],"AWS Resource",{"_3697":1491,"_31245":1373,"_21577":55541,"_5":14884,"_28435":55207,"_3074":55542},[],"IAM actions",{"_3697":1492,"_31245":1373,"_21577":55544,"_5":14884,"_28435":55207,"_3074":55545},[],"AWS calls and effect",{"_3697":1493,"_31245":1373,"_21577":55547,"_5":14884,"_28435":55207,"_3074":55548},[],"Where in this page",{"_3697":1494,"_31245":1373,"_21577":55550,"_5":14884,"_28435":55207,"_3074":55551},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3697":1495,"_31245":1373,"_21577":55553,"_5":14884,"_28435":55207,"_3074":55554},[],"CA",{"_3697":1496,"_31245":1373,"_21577":55556,"_5":14884,"_28435":55207,"_3074":55557},[],"`IoTCore/CACertificate`",{"_3697":1497,"_31245":1373,"_21577":55559,"_5":14884,"_28435":55207,"_3074":55560},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3697":1498,"_31245":1373,"_21577":55562,"_5":14884,"_28435":55207,"_3074":55563},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3697":1499,"_31245":1373,"_21577":55565,"_5":14884,"_28435":55207,"_3074":55220},[],{"_3697":1500,"_31245":1373,"_21577":55567,"_5":14884,"_28435":55207,"_3074":55568},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3697":1501,"_31245":1373,"_21577":55570,"_5":14884,"_28435":55207,"_3074":55571},[],"DMS",{"_3697":1502,"_31245":1373,"_21577":55573,"_5":14884,"_28435":55207,"_3074":55574},[],"`IoTCore/ProvisioningTemplate`",{"_3697":1503,"_31245":1373,"_21577":55576,"_5":14884,"_28435":55207,"_3074":55577},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3697":1504,"_31245":1373,"_21577":55579,"_5":14884,"_28435":55207,"_3074":55580},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3697":1505,"_31245":1373,"_21577":55582,"_5":14884,"_28435":55207,"_3074":55248},[],{"_3697":1506,"_31245":1373,"_21577":55584,"_5":14884,"_28435":55207,"_3074":55585},[],"`EventBindDeviceIdentityKey`",{"_3697":1507,"_31245":1373,"_21577":55587,"_5":14884,"_28435":55207,"_3074":55588},[],"Device",{"_3697":1508,"_31245":1373,"_21577":55590,"_5":14884,"_28435":55207,"_3074":55591},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3697":1509,"_31245":1373,"_21577":55593,"_5":14884,"_28435":55207,"_3074":55594},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3697":1510,"_31245":1373,"_21577":55596,"_5":14884,"_28435":55207,"_3074":55597},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3697":1511,"_31245":1373,"_21577":55599,"_5":14884,"_28435":55207,"_3074":55256},[],{"_3697":1512,"_31245":1373,"_21577":55601,"_5":14884,"_28435":55207,"_3074":55602},[],"`EventUpdateCertificateStatusKey`",{"_3697":1513,"_31245":1373,"_21577":55604,"_5":14884,"_28435":55207,"_3074":55605},[],"Certificate",{"_3697":1514,"_31245":1373,"_21577":55607,"_5":14884,"_28435":55207,"_3074":55608},[],"`IoTCore/Certificate`",{"_3697":1515,"_31245":1373,"_21577":55610,"_5":14884,"_28435":55207,"_3074":55611},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3697":1516,"_31245":1373,"_21577":55613,"_5":14884,"_28435":55207,"_3074":55614},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3697":1517,"_31245":1373,"_21577":55616,"_5":14884,"_28435":55207,"_3074":55268},[],{"_3697":1518,"_31245":1373,"_21577":55618,"_5":14884,"_28435":55207,"_3074":55619},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3697":1519,"_31245":1373,"_21577":55621,"_5":14884,"_28435":55207,"_3074":55622},[],"Certificate / Device",{"_3697":1520,"_31245":1373,"_21577":55624,"_5":14884,"_28435":55207,"_3074":55625},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3697":1521,"_31245":1373,"_21577":55627,"_5":14884,"_28435":55207,"_3074":51344},[],{"_3697":1522,"_31245":1373,"_21577":55629,"_5":14884,"_28435":55207,"_3074":55630},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3697":1523,"_31245":1373,"_21577":55632,"_5":14884,"_28435":55207,"_3074":55276},[],{"_3697":1524,"_31245":1373,"_21577":55634,"_5":14884,"_28435":55211,"_3074":55635},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3697":1525,"_31245":1373,"_21577":55637,"_5":14884,"_28435":55215,"_3074":55638},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3697":1526,"_31245":1373,"_21577":55640,"_5":14884,"_28435":55215,"_3074":55641},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3697":1527,"_31245":1373,"_21577":55643,"_5":14884,"_28435":55219,"_3074":55644},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3697":1528,"_31245":1373,"_21577":55646,"_5":14884,"_28435":55219,"_3074":55647},[],"Transition",{"_3697":1529,"_31245":1373,"_21577":55649,"_5":14884,"_28435":55219,"_3074":55650},[],"AWS calls",{"_3697":1530,"_31245":1373,"_21577":55652,"_5":14884,"_28435":55219,"_3074":55653},[],"`NotRegistered` → `Requested`",{"_3697":1531,"_31245":1373,"_21577":55655,"_5":14884,"_28435":55219,"_3074":55656},[],"none (metadata write only)",{"_3697":1532,"_31245":1373,"_21577":55658,"_5":14884,"_28435":55219,"_3074":55659},[],"`Requested` → `Registering`",{"_3697":1533,"_31245":1373,"_21577":55661,"_5":14884,"_28435":55219,"_3074":55662},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3697":1534,"_31245":1373,"_21577":55664,"_5":14884,"_28435":55219,"_3074":55665},[],"`Registering` → `Succeeded`",{"_3697":1535,"_31245":1373,"_21577":55667,"_5":14884,"_28435":55219,"_3074":55668},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3697":1536,"_31245":1373,"_21577":55670,"_5":14884,"_28435":55219,"_3074":55671},[],"`Registering` → `Failed`",{"_3697":1537,"_31245":1373,"_21577":55673,"_5":14884,"_28435":55219,"_3074":55674},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3697":1538,"_31245":1373,"_21577":55676,"_5":14884,"_28435":55219,"_3074":55677},[],"`Failed` / `Succeeded` → `Requested`",{"_3697":1539,"_31245":1373,"_21577":55679,"_5":14884,"_28435":55219,"_3074":55680},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3697":1540,"_31245":1373,"_21577":55682,"_5":14884,"_28435":55223,"_3074":55683},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3697":1541,"_31245":1373,"_21577":55685,"_5":14884,"_28435":55223,"_3074":55686},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3697":1542,"_31245":1373,"_21577":55688,"_5":14884,"_28435":55223,"_3074":55689},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3697":1543,"_31245":1373,"_21577":55691,"_5":14884,"_28435":55223,"_3074":55692},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3697":1544,"_31245":1373,"_21577":55694,"_5":14884,"_28435":55223,"_3074":55695},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3697":1545,"_31245":1373,"_21577":55697,"_5":14884,"_28435":55223,"_3074":55698},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3697":1546,"_31245":1373,"_21577":55700,"_5":14884,"_28435":55227,"_3074":55701},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3697":1547,"_31245":1373,"_21577":55703,"_5":14884,"_28435":55231,"_3074":55704},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3697":1548,"_31245":1373,"_21577":55706,"_5":14884,"_28435":55231,"_3074":55707},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3697":1549,"_31245":1373,"_21577":55709,"_5":14884,"_28435":55235,"_3074":55710},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3697":1550,"_31245":1373,"_21577":55712,"_5":14884,"_28435":55239,"_3074":55713},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3697":1551,"_31245":1373,"_21577":55715,"_5":14884,"_28435":55239,"_3074":55716},[],"Creates or updates the IoT policies configured in the DMS.",{"_3697":1552,"_31245":1373,"_21577":55718,"_5":14884,"_28435":55239,"_3074":55719},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3697":1553,"_31245":1373,"_21577":55721,"_5":14884,"_28435":55239,"_3074":55722},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3697":1554,"_31245":1373,"_21577":55724,"_5":14884,"_28435":55239,"_3074":55725},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3697":1555,"_31245":1373,"_21577":55727,"_5":14884,"_28435":55239,"_3074":55728},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3697":1556,"_31245":1373,"_21577":55730,"_5":14884,"_28435":55239,"_3074":55731},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3697":1557,"_31245":1373,"_21577":55733,"_5":14884,"_28435":55243,"_3074":55734},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3697":1558,"_31245":1373,"_21577":55736,"_5":14884,"_28435":55243,"_3074":55737},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3697":1559,"_31245":1373,"_21577":55739,"_5":14884,"_28435":55243,"_3074":55740},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3697":1560,"_31245":1373,"_21577":55742,"_5":14884,"_28435":55243,"_3074":55743},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3697":1561,"_31245":1373,"_21577":55745,"_5":14884,"_28435":55243,"_3074":55746},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3697":1562,"_31245":1373,"_21577":55748,"_5":14884,"_28435":55247,"_3074":55749},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3697":1563,"_31245":1373,"_21577":55751,"_5":14884,"_28435":55247,"_3074":55647},[],{"_3697":1564,"_31245":1373,"_21577":55753,"_5":14884,"_28435":55247,"_3074":55650},[],{"_3697":1565,"_31245":1373,"_21577":55755,"_5":14884,"_28435":55247,"_3074":55756},[],"`Unconfigured` → `None` / `Auto`",{"_3697":1566,"_31245":1373,"_21577":55758,"_5":14884,"_28435":55247,"_3074":55759},[],"none (configuration only)",{"_3697":1567,"_31245":1373,"_21577":55761,"_5":14884,"_28435":55247,"_3074":55762},[],"`None` ↔ `Auto`",{"_3697":1568,"_31245":1373,"_21577":55764,"_5":14884,"_28435":55247,"_3074":55759},[],{"_3697":1569,"_31245":1373,"_21577":55766,"_5":14884,"_28435":55247,"_3074":55767},[],"Any → `Jitp`",{"_3697":1570,"_31245":1373,"_21577":55769,"_5":14884,"_28435":55247,"_3074":55770},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3697":1571,"_31245":1373,"_21577":55772,"_5":14884,"_28435":55247,"_3074":55773},[],"`Jitp` → `None` / `Auto`",{"_3697":1572,"_31245":1373,"_21577":55775,"_5":14884,"_28435":55247,"_3074":55776},[],"none (the template stays in the AWS account)",{"_3697":1573,"_31245":1373,"_21577":55778,"_5":14884,"_28435":55251,"_3074":55779},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3697":1574,"_31245":1373,"_21577":55781,"_5":14884,"_28435":55251,"_3074":55782},[],"The full flow from the device's perspective is:",{"_3697":1575,"_31245":1373,"_21577":55784,"_5":14884,"_28435":55251,"_3074":55785},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3697":1576,"_31245":1373,"_21577":55787,"_5":14884,"_28435":55255,"_3074":55788},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3697":1577,"_31245":1373,"_21577":55790,"_5":14884,"_28435":55255,"_3074":55647},[],{"_3697":1578,"_31245":1373,"_21577":55792,"_5":14884,"_28435":55255,"_3074":55650},[],{"_3697":1579,"_31245":1373,"_21577":55794,"_5":14884,"_28435":55255,"_3074":55795},[],"`Absent` → `Provisioned`",{"_3697":1580,"_31245":1373,"_21577":55797,"_5":14884,"_28435":55255,"_3074":55798},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3697":1581,"_31245":1373,"_21577":55800,"_5":14884,"_28435":55255,"_3074":55801},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3697":1582,"_31245":1373,"_21577":55803,"_5":14884,"_28435":55255,"_3074":55804},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3697":1583,"_31245":1373,"_21577":55806,"_5":14884,"_28435":55255,"_3074":55807},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3697":1584,"_31245":1373,"_21577":55809,"_5":14884,"_28435":55259,"_3074":55810},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3697":1585,"_31245":1373,"_21577":55812,"_5":14884,"_28435":55259,"_3074":55813},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3697":1586,"_31245":1373,"_21577":55815,"_5":14884,"_28435":55259,"_3074":55816},[],"For the JITP flow to work correctly:",{"_3697":1587,"_31245":1373,"_21577":55818,"_5":14884,"_28435":55259,"_3074":55819},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3697":1588,"_31245":1373,"_21577":55821,"_5":14884,"_28435":55259,"_3074":55822},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3697":1589,"_31245":1373,"_21577":55824,"_5":14884,"_28435":55259,"_3074":55825},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3697":1590,"_31245":1373,"_21577":55827,"_5":14884,"_28435":55259,"_3074":55828},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3697":1591,"_31245":1373,"_21577":55830,"_5":14884,"_28435":55263,"_3074":55831},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3697":1592,"_31245":1373,"_21577":55833,"_5":14884,"_28435":55263,"_3074":55834},[],"Status in Lamassu",{"_3697":1593,"_31245":1373,"_21577":55836,"_5":14884,"_28435":55263,"_3074":55837},[],"Revocation reason",{"_3697":1594,"_31245":1373,"_21577":55839,"_5":14884,"_28435":55263,"_3074":55840},[],"Status in AWS IoT Core",{"_3697":1595,"_31245":1373,"_21577":55842,"_5":14884,"_28435":55263,"_3074":55843},[],"`Active`",{"_3697":1596,"_31245":1373,"_21577":55845,"_5":14884,"_28435":55263,"_3074":55846},[],"None",{"_3697":1597,"_31245":1373,"_21577":55848,"_5":14884,"_28435":55263,"_3074":55849},[],"`ACTIVE`",{"_3697":1598,"_31245":1373,"_21577":55851,"_5":14884,"_28435":55263,"_3074":55852},[],"`Revoked`",{"_3697":1599,"_31245":1373,"_21577":55854,"_5":14884,"_28435":55263,"_3074":55855},[],"`certificateHold`",{"_3697":1600,"_31245":1373,"_21577":55857,"_5":14884,"_28435":55263,"_3074":55858},[],"`INACTIVE`",{"_3697":1601,"_31245":1373,"_21577":55860,"_5":14884,"_28435":55263,"_3074":55852},[],{"_3697":1602,"_31245":1373,"_21577":55862,"_5":14884,"_28435":55263,"_3074":55863},[],"Any other reason",{"_3697":1603,"_31245":1373,"_21577":55865,"_5":14884,"_28435":55263,"_3074":55866},[],"`REVOKED`",{"_3697":1604,"_31245":1373,"_21577":55868,"_5":14884,"_28435":55263,"_3074":55869},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3697":1605,"_31245":1373,"_21577":55871,"_5":14884,"_28435":55267,"_3074":55872},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3697":1606,"_31245":1373,"_21577":55874,"_5":14884,"_28435":55267,"_3074":55647},[],{"_3697":1607,"_31245":1373,"_21577":55876,"_5":14884,"_28435":55267,"_3074":55650},[],{"_3697":1608,"_31245":1373,"_21577":55878,"_5":14884,"_28435":55267,"_3074":55879},[],"`NotSynced` → `Active`",{"_3697":1609,"_31245":1373,"_21577":55881,"_5":14884,"_28435":55267,"_3074":55359},[],{"_3697":1610,"_31245":1373,"_21577":55883,"_5":14884,"_28435":55267,"_3074":55884},[],"`Active` → `Inactive`",{"_3697":1611,"_31245":1373,"_21577":55886,"_5":14884,"_28435":55267,"_3074":55887},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3697":1612,"_31245":1373,"_21577":55889,"_5":14884,"_28435":55267,"_3074":55890},[],"`Active` → `Revoked`",{"_3697":1613,"_31245":1373,"_21577":55892,"_5":14884,"_28435":55267,"_3074":55887},[],{"_3697":1614,"_31245":1373,"_21577":55894,"_5":14884,"_28435":55267,"_3074":55895},[],"`Inactive` / `Revoked` → `Active`",{"_3697":1615,"_31245":1373,"_21577":55897,"_5":14884,"_28435":55267,"_3074":55359},[],{"_3697":1616,"_31245":1373,"_21577":55899,"_5":14884,"_28435":55267,"_3074":55900},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3697":1617,"_31245":1373,"_21577":55902,"_5":14884,"_28435":55267,"_3074":55903},[],"none (these states are not synced to AWS)",{"_3697":1618,"_31245":1373,"_21577":55905,"_5":14884,"_28435":55271,"_3074":55906},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3697":1619,"_31245":1373,"_21577":55908,"_5":14884,"_28435":55271,"_3074":55909},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3697":1620,"_31245":1373,"_21577":55911,"_5":14884,"_28435":55271,"_3074":55912},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3697":1621,"_31245":1373,"_21577":55914,"_5":14884,"_28435":55275,"_3074":55915},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3697":1622,"_31245":1373,"_21577":55917,"_5":14884,"_28435":55275,"_3074":55918},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3697":1623,"_31245":1373,"_21577":55920,"_5":14884,"_28435":55279,"_3074":55921},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3697":1624,"_31245":1373,"_21577":55923,"_5":14884,"_28435":55279,"_3074":55924},[],"There are two action types:",{"_3697":1625,"_31245":1373,"_21577":55926,"_5":14884,"_28435":55279,"_3074":55927},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3697":1626,"_31245":1373,"_21577":55929,"_5":14884,"_28435":55279,"_3074":55930},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3697":1627,"_31245":1373,"_21577":55932,"_5":14884,"_28435":55279,"_3074":55933},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3697":1628,"_31245":1373,"_21577":55935,"_5":14884,"_28435":55283,"_3074":55936},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3697":1629,"_31245":1373,"_21577":55938,"_5":14884,"_28435":55283,"_3074":55939},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3697":1630,"_31245":1373,"_21577":55941,"_5":14884,"_28435":55283,"_3074":55942},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3697":1631,"_31245":1373,"_21577":55944,"_5":14884,"_28435":55287,"_3074":55945},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3697":1632,"_31245":1373,"_21577":55947,"_5":14884,"_28435":55287,"_3074":55948},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3697":1633,"_31245":1373,"_21577":55950,"_5":14884,"_28435":55287,"_3074":55951},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3697":1634,"_31245":1373,"_21577":55953,"_5":14884,"_28435":55287,"_3074":55954},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3697":1635,"_31245":1373,"_21577":55956,"_5":14884,"_28435":55287,"_3074":55957},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3697":1636,"_31245":1373,"_21577":55959,"_5":14884,"_28435":55287,"_3074":55960},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3697":1637,"_31245":1373,"_21577":55962,"_5":14884,"_28435":55287,"_3074":55963},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3697":1638,"_31245":1373,"_21577":55965,"_5":14884,"_28435":55287,"_3074":55966},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3697":1639,"_31245":1373,"_21577":55968,"_5":14884,"_28435":55287,"_3074":55969},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3697":1640,"_31245":1373,"_21577":55971,"_5":14884,"_28435":55287,"_3074":55972},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3697":1641,"_31245":1373,"_21577":55974,"_5":14884,"_28435":55287,"_3074":55975},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3697":1642,"_31245":1373,"_21577":55977,"_5":14884,"_28435":55287,"_3074":55978},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3697":1643,"_31245":1373,"_21577":55980,"_5":14884,"_28435":55287,"_3074":55981},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3697":1644,"_31245":1373,"_21577":55983,"_5":14884,"_28435":55287,"_3074":55984},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3697":1645,"_31245":1373,"_21577":55986,"_5":14884,"_28435":55287,"_3074":55987},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3697":1646,"_31245":1373,"_21577":55989,"_5":14884,"_28435":55287,"_3074":55990},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3697":1647,"_31245":1373,"_21577":55992,"_5":14884,"_28435":55287,"_3074":55993},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3697":1648,"_31245":1373,"_21577":55995,"_5":14884,"_28435":55287,"_3074":55996},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3697":1649,"_31245":1373,"_21577":55998,"_5":14884,"_28435":55287,"_3074":55999},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3697":1650,"_31245":1373,"_21577":56001,"_5":14884,"_28435":55287,"_3074":56002},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3697":1651,"_31245":1373,"_21577":56004,"_5":14884,"_28435":55287,"_3074":56005},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3697":1652,"_31245":1373,"_21577":56007,"_5":14884,"_28435":55287,"_3074":56008},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3697":1653,"_31245":1373,"_21577":56010,"_5":14884,"_28435":55287,"_3074":56011},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/est\" />",{"_3697":1654,"_31245":1373,"_21577":56013,"_5":14884,"_28435":55287,"_3074":56014},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3697":1655,"_31245":1655,"_5":15238,"_3074":53661,"_31570":56016,"_21577":56017,"_28435":1655},[50948,52489,53661],[],{"_3697":1656,"_31245":1655,"_21577":56019,"_5":14884,"_28435":1655,"_3074":56020},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3697":1657,"_31245":1655,"_5":31567,"_21577":56022,"_28435":56023,"_3074":56024},[],"/docs/platform/iot-fleets/overview#start-here","Start here",{"_3697":1658,"_31245":1655,"_5":31567,"_21577":56026,"_28435":56027,"_3074":53659},[],"/docs/platform/iot-fleets/overview#devices-and-identities",{"_3697":1659,"_31245":1655,"_5":31567,"_21577":56029,"_28435":56030,"_3074":53858},[],"/docs/platform/iot-fleets/overview#enrollment-with-pki",{"_3697":1660,"_31245":1655,"_5":31567,"_21577":56032,"_28435":56033,"_3074":55184},[],"/docs/platform/iot-fleets/overview#integrations",{"_3697":1661,"_31245":1655,"_5":31567,"_21577":56035,"_28435":56036,"_3074":56037},[],"/docs/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3697":1662,"_31245":1655,"_21577":56039,"_5":14884,"_28435":1655,"_3074":56040},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3697":1663,"_31245":1655,"_21577":56042,"_5":14884,"_28435":56023,"_3074":56043},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3697":1664,"_31245":1655,"_21577":56045,"_5":14884,"_28435":56023,"_3074":56046},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3697":1665,"_31245":1655,"_21577":56048,"_5":14884,"_28435":56027,"_3074":56049},[],"Resource",{"_3697":1666,"_31245":1655,"_21577":56051,"_5":14884,"_28435":56027,"_3074":56052},[],"What it represents",{"_3697":1667,"_31245":1655,"_21577":56054,"_5":14884,"_28435":56027,"_3074":56055},[],"**Device**",{"_3697":1668,"_31245":1655,"_21577":56057,"_5":14884,"_28435":56027,"_3074":56058},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3697":1669,"_31245":1655,"_21577":56060,"_5":14884,"_28435":56027,"_3074":56061},[],"**Identity**",{"_3697":1670,"_31245":1655,"_21577":56063,"_5":14884,"_28435":56027,"_3074":56064},[],"The device's association with its certificates: an active version and a history.",{"_3697":1671,"_31245":1655,"_21577":56066,"_5":14884,"_28435":56027,"_3074":56067},[],"**DMS**",{"_3697":1672,"_31245":1655,"_21577":56069,"_5":14884,"_28435":56027,"_3074":56070},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3697":1673,"_31245":1655,"_21577":56072,"_5":14884,"_28435":56027,"_3074":56073},[],"**Fleet**",{"_3697":1674,"_31245":1655,"_21577":56075,"_5":14884,"_28435":56027,"_3074":56076},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3697":1675,"_31245":1655,"_21577":56078,"_5":14884,"_28435":56027,"_3074":56079},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3697":1676,"_31245":1655,"_21577":56081,"_5":14884,"_28435":56027,"_3074":56082},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3697":1677,"_31245":1655,"_21577":56084,"_5":14884,"_28435":56030,"_3074":56085},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3697":1678,"_31245":1655,"_21577":56087,"_5":14884,"_28435":56030,"_3074":56088},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3697":1679,"_31245":1655,"_21577":56090,"_5":14884,"_28435":56030,"_3074":56091},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3697":1680,"_31245":1655,"_21577":56093,"_5":14884,"_28435":56030,"_3074":56094},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3697":1681,"_31245":1655,"_21577":56096,"_5":14884,"_28435":56030,"_3074":56097},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3697":1682,"_31245":1655,"_21577":56099,"_5":14884,"_28435":56030,"_3074":56100},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3697":1683,"_31245":1655,"_21577":56102,"_5":14884,"_28435":56030,"_3074":56103},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3697":1684,"_31245":1655,"_21577":56105,"_5":14884,"_28435":56030,"_3074":56106},[],"<Card title=\"EST (RFC 7030)\" description=\"Find the guides for authentication, client integration and renewal.\" href=\"/docs/platform/iot-fleets/est\" />",{"_3697":1685,"_31245":1655,"_21577":56108,"_5":14884,"_28435":56033,"_3074":56109},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3697":1686,"_31245":1655,"_21577":56111,"_5":14884,"_28435":56033,"_3074":56112},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3697":1687,"_31245":1655,"_21577":56114,"_5":14884,"_28435":56036,"_3074":56115},[],"Participant",{"_3697":1688,"_31245":1655,"_21577":56117,"_5":14884,"_28435":56036,"_3074":56118},[],"Responsibility",{"_3697":1689,"_31245":1655,"_21577":56120,"_5":14884,"_28435":56036,"_3074":56121},[],"PKI administrator",{"_3697":1690,"_31245":1655,"_21577":56123,"_5":14884,"_28435":56036,"_3074":56124},[],"CA, issuance profile, chain and revocation publication.",{"_3697":1691,"_31245":1655,"_21577":56126,"_5":14884,"_28435":56036,"_3074":56127},[],"Provisioning administrator",{"_3697":1692,"_31245":1655,"_21577":56129,"_5":14884,"_28435":56036,"_3074":56130},[],"DMS, admission, authentication per operation and inventory.",{"_3697":1693,"_31245":1655,"_21577":56132,"_5":14884,"_28435":56036,"_3074":56133},[],"Device integrator",{"_3697":1694,"_31245":1655,"_21577":56135,"_5":14884,"_28435":56036,"_3074":56136},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3697":1695,"_31245":1655,"_21577":56138,"_5":14884,"_28435":56036,"_3074":56139},[],"Consumer integrator",{"_3697":1696,"_31245":1655,"_21577":56141,"_5":14884,"_28435":56036,"_3074":56142},[],"Trusted issuers, validation and device permissions in the destination.",{"_3697":1697,"_31245":1655,"_21577":56144,"_5":14884,"_28435":56036,"_3074":56145},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3697":1698,"_31245":1698,"_5":15238,"_3074":56147,"_31570":56148,"_21577":56150,"_28435":1698},"Enroll and connect your first device",[50948,52489,53661,56149],"Getting started",[],{"_3697":1699,"_31245":1698,"_21577":56152,"_5":14884,"_28435":1698,"_3074":56153},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3697":1700,"_31245":1698,"_5":31567,"_21577":56155,"_28435":56156,"_3074":50958},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3697":1701,"_31245":1698,"_5":31567,"_21577":56158,"_28435":56159,"_3074":56160},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3697":1702,"_31245":1698,"_5":31567,"_21577":56162,"_28435":56163,"_3074":56164},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3697":1703,"_31245":1698,"_5":31567,"_21577":56166,"_28435":56167,"_3074":56168},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3697":1704,"_31245":1698,"_5":31567,"_21577":56170,"_28435":56171,"_3074":56172},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3697":1705,"_31245":1698,"_5":31567,"_21577":56174,"_28435":56175,"_3074":56176},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3697":1706,"_31245":1698,"_5":31567,"_21577":56178,"_28435":56179,"_3074":56180},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3697":1707,"_31245":1698,"_5":31567,"_21577":56182,"_28435":56183,"_3074":56184},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3697":1708,"_31245":1698,"_21577":56186,"_5":14884,"_28435":1698,"_3074":56187},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3697":1709,"_31245":1698,"_21577":56189,"_5":14884,"_28435":56156,"_3074":56190},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3697":1710,"_31245":1698,"_21577":56192,"_5":14884,"_28435":56156,"_3074":56193},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3697":1711,"_31245":1698,"_21577":56195,"_5":14884,"_28435":56156,"_3074":56196},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3697":1712,"_31245":1698,"_21577":56198,"_5":14884,"_28435":56156,"_3074":56199},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3697":1713,"_31245":1698,"_21577":56201,"_5":14884,"_28435":56156,"_3074":56202},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3697":1714,"_31245":1698,"_21577":56204,"_5":14884,"_28435":56159,"_3074":56205},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3697":1715,"_31245":1698,"_21577":56207,"_5":14884,"_28435":56159,"_3074":56208},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3697":1716,"_31245":1698,"_21577":56210,"_5":14884,"_28435":56163,"_3074":56211},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3697":1717,"_31245":1698,"_21577":56213,"_5":14884,"_28435":56163,"_3074":56214},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3697":1718,"_31245":1698,"_21577":56216,"_5":14884,"_28435":56163,"_3074":56217},[],"Setting",{"_3697":1719,"_31245":1698,"_21577":56219,"_5":14884,"_28435":56163,"_3074":56220},[],"Evaluation value",{"_3697":1720,"_31245":1698,"_21577":56222,"_5":14884,"_28435":56163,"_3074":56223},[],"Enrollment CA",{"_3697":1721,"_31245":1698,"_21577":56225,"_5":14884,"_28435":56163,"_3074":56226},[],"Issuing root from `device-root.pem`.",{"_3697":1722,"_31245":1698,"_21577":56228,"_5":14884,"_28435":56163,"_3074":56229},[],"Issuance profile",{"_3697":1723,"_31245":1698,"_21577":56231,"_5":14884,"_28435":56163,"_3074":56232},[],"The 1-hour leaf profile you just prepared.",{"_3697":1724,"_31245":1698,"_21577":56234,"_5":14884,"_28435":56163,"_3074":56235},[],"Protocol / Registration Mode",{"_3697":1725,"_31245":1698,"_21577":56237,"_5":14884,"_28435":56163,"_3074":56238},[],"`EST_RFC7030` / `JITP`.",{"_3697":1726,"_31245":1698,"_21577":56240,"_5":14884,"_28435":56163,"_3074":56241},[],"Verify CSR Signature",{"_3697":1727,"_31245":1698,"_21577":56243,"_5":14884,"_28435":56163,"_3074":56244},[],"Enabled.",{"_3697":1728,"_31245":1698,"_21577":56246,"_5":14884,"_28435":56163,"_3074":56247},[],"Enable Replaceable Enrollment",{"_3697":1729,"_31245":1698,"_21577":56249,"_5":14884,"_28435":56163,"_3074":56250},[],"Disabled; the ID must be new.",{"_3697":1730,"_31245":1698,"_21577":56252,"_5":14884,"_28435":56163,"_3074":56253},[],"Initial authentication",{"_3697":1731,"_31245":1698,"_21577":56255,"_5":14884,"_28435":56163,"_3074":56256},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3697":1732,"_31245":1698,"_21577":56258,"_5":14884,"_28435":56163,"_3074":56259},[],"Renewal authentication",{"_3697":1733,"_31245":1698,"_21577":56261,"_5":14884,"_28435":56163,"_3074":56262},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3697":1734,"_31245":1698,"_21577":56264,"_5":14884,"_28435":56163,"_3074":56265},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3697":1735,"_31245":1698,"_21577":56267,"_5":14884,"_28435":56163,"_3074":56268},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3697":1736,"_31245":1698,"_21577":56270,"_5":14884,"_28435":56163,"_3074":56271},[],"Re-enrollment Delta",{"_3697":1737,"_31245":1698,"_21577":56273,"_5":14884,"_28435":56163,"_3074":56274},[],"1 hour.",{"_3697":1738,"_31245":1698,"_21577":56276,"_5":14884,"_28435":56163,"_3074":56277},[],"Preventive / Critical Delta",{"_3697":1739,"_31245":1698,"_21577":56279,"_5":14884,"_28435":56163,"_3074":56280},[],"30 minutes / 10 minutes.",{"_3697":1740,"_31245":1698,"_21577":56282,"_5":14884,"_28435":56163,"_3074":56283},[],"Revoke on Re-enrollment",{"_3697":1741,"_31245":1698,"_21577":56285,"_5":14884,"_28435":56163,"_3074":56286},[],"Disabled to test the successor before retiring the previous identity.",{"_3697":1742,"_31245":1698,"_21577":56288,"_5":14884,"_28435":56163,"_3074":54110},[],{"_3697":1743,"_31245":1698,"_21577":56290,"_5":14884,"_28435":56163,"_3074":56291},[],"Disabled; the operational key is generated in the client.",{"_3697":1744,"_31245":1698,"_21577":56293,"_5":14884,"_28435":56163,"_3074":56294},[],"CA Distribution",{"_3697":1745,"_31245":1698,"_21577":56296,"_5":14884,"_28435":56163,"_3074":56297},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3697":1746,"_31245":1698,"_21577":56299,"_5":14884,"_28435":56163,"_3074":56300},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3697":1747,"_31245":1698,"_21577":56302,"_5":14884,"_28435":56167,"_3074":56303},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3697":1748,"_31245":1698,"_21577":56305,"_5":14884,"_28435":56167,"_3074":56306},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3697":1749,"_31245":1698,"_21577":56308,"_5":14884,"_28435":56171,"_3074":56309},[],"Generate a new key and CSR with the selected identifier:",{"_3697":1750,"_31245":1698,"_21577":56311,"_5":14884,"_28435":56171,"_3074":56312},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3697":1751,"_31245":1698,"_21577":56314,"_5":14884,"_28435":56171,"_3074":56315},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3697":1752,"_31245":1698,"_21577":56317,"_5":14884,"_28435":56175,"_3074":56318},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3697":1753,"_31245":1698,"_21577":56320,"_5":14884,"_28435":56175,"_3074":56321},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3697":1754,"_31245":1698,"_21577":56323,"_5":14884,"_28435":56179,"_3074":56324},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3697":1755,"_31245":1698,"_21577":56326,"_5":14884,"_28435":56179,"_3074":56327},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3697":1756,"_31245":1698,"_21577":56329,"_5":14884,"_28435":56179,"_3074":56330},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3697":1757,"_31245":1698,"_21577":56332,"_5":14884,"_28435":56179,"_3074":56333},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3697":1758,"_31245":1698,"_21577":56335,"_5":14884,"_28435":56179,"_3074":56336},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3697":1759,"_31245":1698,"_21577":56338,"_5":14884,"_28435":56183,"_3074":56339},[],"Check",{"_3697":1760,"_31245":1698,"_21577":56341,"_5":14884,"_28435":56183,"_3074":56342},[],"Expected result",{"_3697":1761,"_31245":1698,"_21577":56344,"_5":14884,"_28435":56183,"_3074":56345},[],"Registration",{"_3697":1762,"_31245":1698,"_21577":56347,"_5":14884,"_28435":56183,"_3074":56348},[],"ID created automatically and correct DMS.",{"_3697":1763,"_31245":1698,"_21577":56350,"_5":14884,"_28435":56183,"_3074":55605},[],{"_3697":1764,"_31245":1698,"_21577":56352,"_5":14884,"_28435":56183,"_3074":56353},[],"CN, profile, serial and key verified.",{"_3697":1765,"_31245":1698,"_21577":56355,"_5":14884,"_28435":56183,"_3074":56356},[],"Inventory",{"_3697":1766,"_31245":1698,"_21577":56358,"_5":14884,"_28435":56183,"_3074":56359},[],"Received serial visible as the current identity and in history.",{"_3697":1767,"_31245":1698,"_21577":56361,"_5":14884,"_28435":56183,"_3074":56362},[],"Consumer",{"_3697":1768,"_31245":1698,"_21577":56364,"_5":14884,"_28435":56183,"_3074":56365},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3697":1769,"_31245":1698,"_21577":56367,"_5":14884,"_28435":56183,"_3074":56368},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3697":1770,"_31245":1698,"_21577":56370,"_5":14884,"_28435":56183,"_3074":56371},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3697":1771,"_31245":1771,"_5":15238,"_3074":53681,"_31570":56373,"_21577":56374,"_28435":1771},[50948,52489,53661,56149],[],{"_3697":1772,"_31245":1771,"_21577":56376,"_5":14884,"_28435":1771,"_3074":56377},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3697":1773,"_31245":1771,"_5":31567,"_21577":56379,"_28435":56380,"_3074":50958},[],"/docs/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3697":1774,"_31245":1771,"_5":31567,"_21577":56382,"_28435":56383,"_3074":56384},[],"/docs/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3697":1775,"_31245":1771,"_5":31567,"_21577":56386,"_28435":56387,"_3074":56388},[],"/docs/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3697":1776,"_31245":1771,"_5":31567,"_21577":56390,"_28435":56391,"_3074":56392},[],"/docs/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3697":1777,"_31245":1771,"_5":31567,"_21577":56394,"_28435":56395,"_3074":56396},[],"/docs/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3697":1778,"_31245":1771,"_5":31567,"_21577":56398,"_28435":56399,"_3074":56400},[],"/docs/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3697":1779,"_31245":1771,"_5":31567,"_21577":56402,"_28435":56403,"_3074":56342},[],"/docs/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3697":1780,"_31245":1771,"_5":31567,"_21577":56405,"_28435":56406,"_3074":56407},[],"/docs/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3697":1781,"_31245":1771,"_5":31567,"_21577":56409,"_28435":56410,"_3074":56411},[],"/docs/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3697":1782,"_31245":1771,"_21577":56413,"_5":14884,"_28435":1771,"_3074":56414},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3697":1783,"_31245":1771,"_21577":56416,"_5":14884,"_28435":1771,"_3074":56417},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3697":1784,"_31245":1771,"_21577":56419,"_5":14884,"_28435":56380,"_3074":56420},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3697":1785,"_31245":1771,"_21577":56422,"_5":14884,"_28435":56380,"_3074":56423},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3697":1786,"_31245":1771,"_21577":56425,"_5":14884,"_28435":56380,"_3074":56426},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3697":1787,"_31245":1771,"_21577":56428,"_5":14884,"_28435":56380,"_3074":56429},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3697":1788,"_31245":1771,"_21577":56431,"_5":14884,"_28435":56383,"_3074":56432},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3697":1789,"_31245":1771,"_21577":56434,"_5":14884,"_28435":56383,"_3074":56435},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3697":1790,"_31245":1771,"_21577":56437,"_5":14884,"_28435":56383,"_3074":56438},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3697":1791,"_31245":1771,"_21577":56440,"_5":14884,"_28435":56383,"_3074":56441},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3697":1792,"_31245":1771,"_21577":56443,"_5":14884,"_28435":56383,"_3074":56444},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3697":1793,"_31245":1771,"_21577":56446,"_5":14884,"_28435":56383,"_3074":56447},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3697":1794,"_31245":1771,"_21577":56449,"_5":14884,"_28435":56383,"_3074":56450},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3697":1795,"_31245":1771,"_21577":56452,"_5":14884,"_28435":56383,"_3074":56453},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3697":1796,"_31245":1771,"_21577":56455,"_5":14884,"_28435":56387,"_3074":56456},[],"Open **Managed Devices** and the registration action. Complete:",{"_3697":1797,"_31245":1771,"_21577":56458,"_5":14884,"_28435":56387,"_3074":56459},[],"**Device ID**: `device-001`.",{"_3697":1798,"_31245":1771,"_21577":56461,"_5":14884,"_28435":56387,"_3074":56462},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3697":1799,"_31245":1771,"_21577":56464,"_5":14884,"_28435":56387,"_3074":56465},[],"**Icon** and **Tags**: optional classification.",{"_3697":1800,"_31245":1771,"_21577":56467,"_5":14884,"_28435":56387,"_3074":56468},[],"Confirm registration.",{"_3697":1801,"_31245":1771,"_21577":56470,"_5":14884,"_28435":56391,"_3074":56471},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3697":1802,"_31245":1771,"_21577":56473,"_5":14884,"_28435":56391,"_3074":56474},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3697":1803,"_31245":1771,"_21577":56476,"_5":14884,"_28435":56395,"_3074":56477},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3697":1804,"_31245":1771,"_21577":56479,"_5":14884,"_28435":56395,"_3074":56480},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3697":1805,"_31245":1771,"_21577":56482,"_5":14884,"_28435":56399,"_3074":56483},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3697":1806,"_31245":1771,"_21577":56485,"_5":14884,"_28435":56399,"_3074":56486},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3697":1807,"_31245":1771,"_21577":56488,"_5":14884,"_28435":56403,"_3074":56339},[],{"_3697":1808,"_31245":1771,"_21577":56490,"_5":14884,"_28435":56403,"_3074":56491},[],"Result",{"_3697":1809,"_31245":1771,"_21577":56493,"_5":14884,"_28435":56403,"_3074":55588},[],{"_3697":1810,"_31245":1771,"_21577":56495,"_5":14884,"_28435":56403,"_3074":56496},[],"`device-001` appears in inventory with the expected DMS.",{"_3697":1811,"_31245":1771,"_21577":56498,"_5":14884,"_28435":56403,"_3074":56499},[],"Current identity",{"_3697":1812,"_31245":1771,"_21577":56501,"_5":14884,"_28435":56403,"_3074":56502},[],"The associated certificate matches the one you verified in PKI.",{"_3697":1813,"_31245":1771,"_21577":56504,"_5":14884,"_28435":56403,"_3074":56505},[],"History",{"_3697":1814,"_31245":1771,"_21577":56507,"_5":14884,"_28435":56403,"_3074":56508},[],"The associated issuance appears with its serial number and dates.",{"_3697":1815,"_31245":1771,"_21577":56510,"_5":14884,"_28435":56403,"_3074":56511},[],"Key and certificate",{"_3697":1816,"_31245":1771,"_21577":56513,"_5":14884,"_28435":56403,"_3074":56514},[],"You have the verified pair ready to install on the device.",{"_3697":1817,"_31245":1771,"_21577":56516,"_5":14884,"_28435":56406,"_3074":56517},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3697":1818,"_31245":1771,"_21577":56519,"_5":14884,"_28435":56406,"_3074":56520},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3697":1819,"_31245":1771,"_21577":56522,"_5":14884,"_28435":56406,"_3074":56523},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3697":1820,"_31245":1771,"_21577":56525,"_5":14884,"_28435":56406,"_3074":56526},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3697":1821,"_31245":1771,"_21577":56528,"_5":14884,"_28435":56410,"_3074":56529},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3697":1822,"_31245":1771,"_21577":56531,"_5":14884,"_28435":56410,"_3074":56532},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3697":1823,"_31245":1771,"_21577":56534,"_5":14884,"_28435":56410,"_3074":56535},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3697":1824,"_31245":1824,"_5":15238,"_3074":56537,"_31570":56538,"_21577":56539,"_28435":1824},"Lamassu IoT Platform",[50948,52489],[],{"_3697":1825,"_31245":1824,"_21577":56541,"_5":14884,"_28435":1824,"_3074":56542},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3697":1826,"_31245":1824,"_5":31567,"_21577":56544,"_28435":56545,"_3074":56024},[],"/docs/platform/overview#start-here",{"_3697":1827,"_31245":1824,"_5":31567,"_21577":56547,"_28435":56548,"_3074":56549},[],"/docs/platform/overview#choose-your-path","Choose your path",{"_3697":1828,"_31245":1824,"_5":31567,"_21577":56551,"_28435":56552,"_3074":56553},[],"/docs/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3697":1829,"_31245":1824,"_5":31567,"_21577":56555,"_28435":56556,"_3074":56557},[],"/docs/platform/overview#core-capabilities","Core capabilities",{"_3697":1830,"_31245":1824,"_5":31567,"_21577":56559,"_28435":56560,"_3074":56561},[],"/docs/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3697":1831,"_31245":1824,"_5":31567,"_21577":56563,"_28435":56564,"_3074":56565},[],"/docs/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3697":1832,"_31245":1824,"_5":31567,"_21577":56567,"_28435":56568,"_3074":56569},[],"/docs/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3697":1833,"_31245":1824,"_5":31567,"_21577":56571,"_28435":56572,"_3074":56573},[],"/docs/platform/overview#automate-device-identities","Automate device identities",{"_3697":1834,"_31245":1824,"_5":31567,"_21577":56575,"_28435":56576,"_3074":56577},[],"/docs/platform/overview#publish-validation-status","Publish validation status",{"_3697":1835,"_31245":1824,"_5":31567,"_21577":56579,"_28435":56580,"_3074":56581},[],"/docs/platform/overview#react-to-events","React to events",{"_3697":1836,"_31245":1824,"_5":31567,"_21577":56583,"_28435":56584,"_3074":56585},[],"/docs/platform/overview#operational-reference","Operational reference",{"_3697":1837,"_31245":1824,"_21577":56587,"_5":14884,"_28435":1824,"_3074":56588},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3697":1838,"_31245":1824,"_21577":56590,"_5":14884,"_28435":56545,"_3074":56591},[],"Choose the result you need:",{"_3697":1839,"_31245":1824,"_21577":56593,"_5":14884,"_28435":56545,"_3074":56594},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3697":1840,"_31245":1824,"_21577":56596,"_5":14884,"_28435":56545,"_3074":56597},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3697":1841,"_31245":1824,"_21577":56599,"_5":14884,"_28435":56545,"_3074":56600},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3697":1842,"_31245":1824,"_21577":56602,"_5":14884,"_28435":56548,"_3074":56603},[],"Section",{"_3697":1843,"_31245":1824,"_21577":56605,"_5":14884,"_28435":56548,"_3074":56606},[],"What you manage",{"_3697":1844,"_31245":1824,"_21577":56608,"_5":14884,"_28435":56548,"_3074":56609},[],"Entry point",{"_3697":1845,"_31245":1824,"_21577":56611,"_5":14884,"_28435":56548,"_3074":56612},[],"**PKI**",{"_3697":1846,"_31245":1824,"_21577":56614,"_5":14884,"_28435":56548,"_3074":56615},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3697":1847,"_31245":1824,"_21577":56617,"_5":14884,"_28435":56548,"_3074":56618},[],"PKI overview",{"_3697":1848,"_31245":1824,"_21577":56620,"_5":14884,"_28435":56548,"_3074":56621},[],"**IoT Fleets**",{"_3697":1849,"_31245":1824,"_21577":56623,"_5":14884,"_28435":56548,"_3074":56624},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3697":1850,"_31245":1824,"_21577":56626,"_5":14884,"_28435":56548,"_3074":56627},[],"IoT Fleets overview",{"_3697":1851,"_31245":1824,"_21577":56629,"_5":14884,"_28435":56548,"_3074":56630},[],"**Administration**",{"_3697":1852,"_31245":1824,"_21577":56632,"_5":14884,"_28435":56548,"_3074":56633},[],"Operator permissions, audit and event subscriptions.",{"_3697":1853,"_31245":1824,"_21577":56635,"_5":14884,"_28435":56548,"_3074":52491},[],{"_3697":1854,"_31245":1824,"_21577":56637,"_5":14884,"_28435":56548,"_3074":56638},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3697":1855,"_31245":1824,"_21577":56640,"_5":14884,"_28435":56552,"_3074":56641},[],"An identity's journey connects four responsibilities:",{"_3697":1856,"_31245":1824,"_21577":56643,"_5":14884,"_28435":56552,"_3074":56644},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3697":1857,"_31245":1824,"_21577":56646,"_5":14884,"_28435":56552,"_3074":56647},[],"The provisioning administrator configures the DMS and initial trust.",{"_3697":1858,"_31245":1824,"_21577":56649,"_5":14884,"_28435":56552,"_3074":56650},[],"The device client requests a certificate and installs it with the matching key.",{"_3697":1859,"_31245":1824,"_21577":56652,"_5":14884,"_28435":56552,"_3074":56653},[],"The consumer validates the identity and applies its access permissions.",{"_3697":1860,"_31245":1824,"_21577":56655,"_5":14884,"_28435":56552,"_3074":56656},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3697":1861,"_31245":1824,"_21577":56658,"_5":14884,"_28435":56560,"_3074":56659},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3697":1862,"_31245":1824,"_21577":56661,"_5":14884,"_28435":56564,"_3074":56662},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3697":1863,"_31245":1824,"_21577":56664,"_5":14884,"_28435":56568,"_3074":56665},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3697":1864,"_31245":1824,"_21577":56667,"_5":14884,"_28435":56572,"_3074":56668},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3697":1865,"_31245":1824,"_21577":56670,"_5":14884,"_28435":56576,"_3074":56671},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3697":1866,"_31245":1824,"_21577":56673,"_5":14884,"_28435":56580,"_3074":56674},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3697":1867,"_31245":1824,"_21577":56676,"_5":14884,"_28435":56584,"_3074":56118},[],{"_3697":1868,"_31245":1824,"_21577":56678,"_5":14884,"_28435":56584,"_3074":56679},[],"What it prepares or checks",{"_3697":1869,"_31245":1824,"_21577":56681,"_5":14884,"_28435":56584,"_3074":56121},[],{"_3697":1870,"_31245":1824,"_21577":56683,"_5":14884,"_28435":56584,"_3074":56684},[],"Key custody, CA hierarchy, profiles and validation.",{"_3697":1871,"_31245":1824,"_21577":56686,"_5":14884,"_28435":56584,"_3074":56687},[],"Fleet administrator",{"_3697":1872,"_31245":1824,"_21577":56689,"_5":14884,"_28435":56584,"_3074":56690},[],"DMS, device admission, renewal policy and inventory.",{"_3697":1873,"_31245":1824,"_21577":56692,"_5":14884,"_28435":56584,"_3074":56133},[],{"_3697":1874,"_31245":1824,"_21577":56694,"_5":14884,"_28435":56584,"_3074":56695},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3697":1875,"_31245":1824,"_21577":56697,"_5":14884,"_28435":56584,"_3074":56139},[],{"_3697":1876,"_31245":1824,"_21577":56699,"_5":14884,"_28435":56584,"_3074":56700},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3697":1877,"_31245":1824,"_21577":56702,"_5":14884,"_28435":56584,"_3074":56703},[],"Infrastructure operator",{"_3697":1878,"_31245":1824,"_21577":56705,"_5":14884,"_28435":56584,"_3074":56706},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3697":1879,"_31245":1824,"_21577":56708,"_5":14884,"_28435":56584,"_3074":56709},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3697":1880,"_31245":1880,"_5":15238,"_3074":56711,"_31570":56712,"_21577":56715,"_28435":1880},"CA hierarchy and rotation",[50948,52489,56713,56714],"PKI","Keys, authorities and certificates",[],{"_3697":1881,"_31245":1880,"_21577":56717,"_5":14884,"_28435":1880,"_3074":56718},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3697":1882,"_31245":1880,"_5":31567,"_21577":56720,"_28435":56721,"_3074":56722},[],"/docs/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3697":1883,"_31245":1880,"_5":31567,"_21577":56724,"_28435":56725,"_3074":56726},[],"/docs/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3697":1884,"_31245":1880,"_5":31567,"_21577":56728,"_28435":56729,"_3074":56730},[],"/docs/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3697":1885,"_31245":1880,"_5":31567,"_21577":56732,"_28435":56733,"_3074":56734},[],"/docs/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3697":1886,"_31245":1880,"_5":31567,"_21577":56736,"_28435":56737,"_3074":56738},[],"/docs/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3697":1887,"_31245":1880,"_5":31567,"_21577":56740,"_28435":56741,"_3074":56742},[],"/docs/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3697":1888,"_31245":1880,"_5":31567,"_21577":56744,"_28435":56745,"_3074":56746},[],"/docs/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3697":1889,"_31245":1880,"_5":31567,"_21577":56748,"_28435":56749,"_3074":56750},[],"/docs/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3697":1890,"_31245":1880,"_5":31567,"_21577":56752,"_28435":56753,"_3074":56754},[],"/docs/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3697":1891,"_31245":1880,"_5":31567,"_21577":56756,"_28435":56757,"_3074":56758},[],"/docs/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3697":1892,"_31245":1880,"_5":31567,"_21577":56760,"_28435":56761,"_3074":56762},[],"/docs/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3697":1893,"_31245":1880,"_5":31567,"_21577":56764,"_28435":56765,"_3074":56766},[],"/docs/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3697":1894,"_31245":1880,"_21577":56768,"_5":14884,"_28435":1880,"_3074":56769},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3697":1895,"_31245":1880,"_21577":56771,"_5":14884,"_28435":1880,"_3074":56772},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3697":1896,"_31245":1880,"_21577":56774,"_5":14884,"_28435":56721,"_3074":56775},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3697":1897,"_31245":1880,"_21577":56777,"_5":14884,"_28435":56721,"_3074":56778},[],"environment, such as production and preproduction;",{"_3697":1898,"_31245":1880,"_21577":56780,"_5":14884,"_28435":56721,"_3074":56781},[],"owner or operating team;",{"_3697":1899,"_31245":1880,"_21577":56783,"_5":14884,"_28435":56721,"_3074":56784},[],"device family or manufacturing process;",{"_3697":1900,"_31245":1880,"_21577":56786,"_5":14884,"_28435":56721,"_3074":56787},[],"region or regulatory requirement;",{"_3697":1901,"_31245":1880,"_21577":56789,"_5":14884,"_28435":56721,"_3074":56790},[],"cryptographic engine or key policy;",{"_3697":1902,"_31245":1880,"_21577":56792,"_5":14884,"_28435":56721,"_3074":56793},[],"maintenance window and renewal cadence.",{"_3697":1903,"_31245":1880,"_21577":56795,"_5":14884,"_28435":56721,"_3074":56796},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3697":1904,"_31245":1880,"_21577":56798,"_5":14884,"_28435":56721,"_3074":56799},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3697":1905,"_31245":1880,"_21577":56801,"_5":14884,"_28435":56725,"_3074":56802},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3697":1906,"_31245":1880,"_21577":56804,"_5":14884,"_28435":56725,"_3074":56805},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing. A CA with no CRL settings — for example, one imported without its key or without `cRLSign` — has them initialized by the reissue when the new certificate carries `cRLSign`; otherwise it keeps none. See the CRL guide.",{"_3697":1907,"_31245":1880,"_21577":56807,"_5":14884,"_28435":56725,"_3074":56808},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3697":1908,"_31245":1880,"_21577":56810,"_5":14884,"_28435":56725,"_3074":56811},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. A subordinate CA is signed by its parent, so the parent must also be `ACTIVE` and inside its validity period; otherwise the reissue fails with `400`. Plan ahead for these conditions.",{"_3697":1909,"_31245":1880,"_21577":56813,"_5":14884,"_28435":56729,"_3074":56814},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3697":1910,"_31245":1880,"_21577":56816,"_5":14884,"_28435":56729,"_3074":56817},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3697":1911,"_31245":1880,"_21577":56819,"_5":14884,"_28435":56729,"_3074":56820},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3697":1912,"_31245":1880,"_21577":56822,"_5":14884,"_28435":56729,"_3074":56823},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3697":1913,"_31245":1880,"_21577":56825,"_5":14884,"_28435":56737,"_3074":56826},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3697":1914,"_31245":1880,"_21577":56828,"_5":14884,"_28435":56741,"_3074":56829},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3697":1915,"_31245":1880,"_21577":56831,"_5":14884,"_28435":56745,"_3074":56832},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3697":1916,"_31245":1880,"_21577":56834,"_5":14884,"_28435":56749,"_3074":56835},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3697":1917,"_31245":1880,"_21577":56837,"_5":14884,"_28435":56753,"_3074":56838},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3697":1918,"_31245":1880,"_21577":56840,"_5":14884,"_28435":56757,"_3074":56841},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3697":1919,"_31245":1880,"_21577":56843,"_5":14884,"_28435":56761,"_3074":56844},[],"Lamassu saves the CA’s revocation, then applies the same revocation to child CAs and issued certificates. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3697":1920,"_31245":1880,"_21577":56846,"_5":14884,"_28435":56761,"_3074":56847},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3697":1921,"_31245":1880,"_21577":56849,"_5":14884,"_28435":56761,"_3074":56850},[],"`CertificateHold` is the reversible exception. Holding a CA suspends its active sub-CAs and issued certificates with `CertificateHold` and marks them as suspended by that CA. Releasing the CA — to `ACTIVE` or to any other non-revoked status such as `EXPIRED` — reactivates exactly the descendants still on hold that carry that mark. Holds placed manually before or after the cascade are left untouched, and any later status change of a descendant clears the mark. Revoking a held CA with any other reason remains permanent: descendants are revoked with `CessationOfOperation` and cannot be restored.",{"_3697":1922,"_31245":1880,"_21577":56852,"_5":14884,"_28435":56761,"_3074":56853},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3697":1923,"_31245":1880,"_21577":56855,"_5":14884,"_28435":56765,"_3074":56856},[],"The new chain ends in an anchor installed by the consumer.",{"_3697":1924,"_31245":1880,"_21577":56858,"_5":14884,"_28435":56765,"_3074":56859},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3697":1925,"_31245":1880,"_21577":56861,"_5":14884,"_28435":56765,"_3074":56862},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3697":1926,"_31245":1880,"_21577":56864,"_5":14884,"_28435":56765,"_3074":56865},[],"Re-enrollment accepts the old identity during the planned period.",{"_3697":1927,"_31245":1880,"_21577":56867,"_5":14884,"_28435":56765,"_3074":56868},[],"OCSP and CRL respond for the authorities that remain active.",{"_3697":1928,"_31245":1880,"_21577":56870,"_5":14884,"_28435":56765,"_3074":56871},[],"No DMS is left accidentally issuing from the old CA.",{"_3697":1929,"_31245":1880,"_21577":56873,"_5":14884,"_28435":56765,"_3074":56874},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3697":1930,"_31245":1930,"_5":15238,"_3074":56876,"_31570":56877,"_21577":56878,"_28435":1930},"Certification authorities",[50948,52489,56713,56714],[],{"_3697":1931,"_31245":1930,"_21577":56880,"_5":14884,"_28435":1930,"_3074":56881},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3697":1932,"_31245":1930,"_5":31567,"_21577":56883,"_28435":56884,"_3074":56885},[],"/docs/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3697":1933,"_31245":1930,"_5":31567,"_21577":56887,"_28435":56888,"_3074":56889},[],"/docs/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3697":1934,"_31245":1930,"_5":31567,"_21577":56891,"_28435":56892,"_3074":50958},[],"/docs/platform/pki/certificate-authorities#before-you-begin",{"_3697":1935,"_31245":1930,"_5":31567,"_21577":56894,"_28435":56895,"_3074":56896},[],"/docs/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3697":1936,"_31245":1930,"_5":31567,"_21577":56898,"_28435":56899,"_3074":56900},[],"/docs/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3697":1937,"_31245":1930,"_5":31567,"_21577":56902,"_28435":56903,"_3074":56904},[],"/docs/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3697":1938,"_31245":1930,"_5":31567,"_21577":56906,"_28435":56907,"_3074":56908},[],"/docs/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3697":1939,"_31245":1930,"_5":31567,"_21577":56910,"_28435":56911,"_3074":56912},[],"/docs/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3697":1940,"_31245":1930,"_5":31567,"_21577":56914,"_28435":56915,"_3074":56916},[],"/docs/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3697":1941,"_31245":1930,"_5":31567,"_21577":56918,"_28435":56919,"_3074":56920},[],"/docs/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3697":1942,"_31245":1930,"_5":31567,"_21577":56922,"_28435":56923,"_3074":56924},[],"/docs/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3697":1943,"_31245":1930,"_5":31567,"_21577":56926,"_28435":56927,"_3074":56928},[],"/docs/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3697":1944,"_31245":1930,"_5":31567,"_21577":56930,"_28435":56931,"_3074":56932},[],"/docs/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3697":1945,"_31245":1930,"_5":31567,"_21577":56934,"_28435":56935,"_3074":56936},[],"/docs/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3697":1946,"_31245":1930,"_5":31567,"_21577":56938,"_28435":56939,"_3074":56940},[],"/docs/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3697":1947,"_31245":1930,"_5":31567,"_21577":56942,"_28435":56943,"_3074":56944},[],"/docs/platform/pki/certificate-authorities#ca-states","CA states",{"_3697":1948,"_31245":1930,"_5":31567,"_21577":56946,"_28435":56947,"_3074":56948},[],"/docs/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3697":1949,"_31245":1930,"_5":31567,"_21577":56950,"_28435":56951,"_3074":56952},[],"/docs/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3697":1950,"_31245":1930,"_5":31567,"_21577":56954,"_28435":56955,"_3074":56956},[],"/docs/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3697":1951,"_31245":1930,"_5":31567,"_21577":56958,"_28435":56959,"_3074":56960},[],"/docs/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3697":1952,"_31245":1930,"_5":31567,"_21577":56962,"_28435":56963,"_3074":56964},[],"/docs/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3697":1953,"_31245":1930,"_5":31567,"_21577":56966,"_28435":56967,"_3074":56968},[],"/docs/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3697":1954,"_31245":1930,"_5":31567,"_21577":56970,"_28435":56971,"_3074":56972},[],"/docs/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3697":1955,"_31245":1930,"_5":31567,"_21577":56974,"_28435":56975,"_3074":56976},[],"/docs/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3697":1956,"_31245":1930,"_21577":56978,"_5":14884,"_28435":1930,"_3074":56979},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3697":1957,"_31245":1930,"_21577":56981,"_5":14884,"_28435":1930,"_3074":56982},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3697":1958,"_31245":1930,"_21577":56984,"_5":14884,"_28435":1930,"_3074":56985},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3697":1959,"_31245":1930,"_21577":56987,"_5":14884,"_28435":56884,"_3074":56988},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3697":1960,"_31245":1930,"_21577":56990,"_5":14884,"_28435":56884,"_3074":56991},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3697":1961,"_31245":1930,"_21577":56993,"_5":14884,"_28435":56884,"_3074":56994},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3697":1962,"_31245":1930,"_21577":56996,"_5":14884,"_28435":56884,"_3074":56997},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3697":1963,"_31245":1930,"_21577":56999,"_5":14884,"_28435":56884,"_3074":57000},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3697":1964,"_31245":1930,"_21577":57002,"_5":14884,"_28435":56892,"_3074":57003},[],"Decide whether the CA will be a root or an intermediate.",{"_3697":1965,"_31245":1930,"_21577":57005,"_5":14884,"_28435":56892,"_3074":57006},[],"Choose the engine that will keep the key.",{"_3697":1966,"_31245":1930,"_21577":57008,"_5":14884,"_28435":56892,"_3074":57009},[],"Define a validity longer than that of the certificates it will issue.",{"_3697":1967,"_31245":1930,"_21577":57011,"_5":14884,"_28435":56892,"_3074":57012},[],"For an intermediate CA, make sure the parent CA is active.",{"_3697":1968,"_31245":1930,"_21577":57014,"_5":14884,"_28435":56895,"_3074":57015},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3697":1969,"_31245":1930,"_21577":57017,"_5":14884,"_28435":56899,"_3074":57018},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3697":1970,"_31245":1930,"_21577":57020,"_5":14884,"_28435":56899,"_3074":57021},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3697":1971,"_31245":1930,"_21577":57023,"_5":14884,"_28435":56903,"_3074":57024},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3697":1972,"_31245":1930,"_21577":57026,"_5":14884,"_28435":56907,"_3074":57027},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3697":1973,"_31245":1930,"_21577":57029,"_5":14884,"_28435":56907,"_3074":57030},[],"`C`: two-letter ISO 3166-1 country code.",{"_3697":1974,"_31245":1930,"_21577":57032,"_5":14884,"_28435":56907,"_3074":57033},[],"`ST`: state or province.",{"_3697":1975,"_31245":1930,"_21577":57035,"_5":14884,"_28435":56907,"_3074":57036},[],"`L`: locality.",{"_3697":1976,"_31245":1930,"_21577":57038,"_5":14884,"_28435":56907,"_3074":57039},[],"`O`: organization.",{"_3697":1977,"_31245":1930,"_21577":57041,"_5":14884,"_28435":56907,"_3074":57042},[],"`OU`: organizational unit.",{"_3697":1978,"_31245":1930,"_21577":57044,"_5":14884,"_28435":56907,"_3074":57045},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3697":1979,"_31245":1930,"_21577":57047,"_5":14884,"_28435":56911,"_3074":57048},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3697":1980,"_31245":1930,"_21577":57050,"_5":14884,"_28435":56911,"_3074":57051},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3697":1981,"_31245":1930,"_21577":57053,"_5":14884,"_28435":56915,"_3074":57054},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3697":1982,"_31245":1930,"_21577":57056,"_5":14884,"_28435":56915,"_3074":57057},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3697":1983,"_31245":1930,"_21577":57059,"_5":14884,"_28435":56919,"_3074":57060},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3697":1984,"_31245":1930,"_21577":57062,"_5":14884,"_28435":56919,"_3074":57063},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3697":1985,"_31245":1930,"_21577":57065,"_5":14884,"_28435":56923,"_3074":57066},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3697":1986,"_31245":1930,"_21577":57068,"_5":14884,"_28435":56923,"_3074":57069},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3697":1987,"_31245":1930,"_21577":57071,"_5":14884,"_28435":56923,"_3074":57072},[],"A certificate whose validity period has already ended, such as that of a retired external authority, is accepted and, when Lamassu has no stored record of that certificate yet, the CA is stored as `EXPIRED` from the start, as happens when importing a plain certificate. If the import reuses the record of a deleted CA (see above and Delete a CA), the previous status is kept instead, even if the certificate has expired in the meantime. An `EXPIRED` CA rejects status changes; see certificate lifecycle.",{"_3697":1988,"_31245":1930,"_21577":57074,"_5":14884,"_28435":56923,"_3074":57075},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3697":1989,"_31245":1930,"_21577":57077,"_5":14884,"_28435":56927,"_3074":57078},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3697":1990,"_31245":1930,"_21577":57080,"_5":14884,"_28435":56931,"_3074":57081},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3697":1991,"_31245":1930,"_21577":57083,"_5":14884,"_28435":56931,"_3074":57084},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3697":1992,"_31245":1930,"_21577":57086,"_5":14884,"_28435":56935,"_3074":57087},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3697":1993,"_31245":1930,"_21577":57089,"_5":14884,"_28435":56939,"_3074":57090},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3697":1994,"_31245":1930,"_21577":57092,"_5":14884,"_28435":56939,"_3074":57093},[],"An imported CA whose key is in the KMS and whose certificate carries `cRLSign` receives its CRL settings and first CRL automatically; without a key in the KMS or without `cRLSign` it receives none, and this is not an import error (see CRL).",{"_3697":1995,"_31245":1930,"_21577":57095,"_5":14884,"_28435":56939,"_3074":57096},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3697":1996,"_31245":1930,"_21577":57098,"_5":14884,"_28435":56943,"_3074":57099},[],"A CA only signs in `ACTIVE`. From there it can move to `EXPIRED` or to `REVOKED`, and it leaves those states only by deletion, with one exception: a revocation with `CertificateHold` can be undone.",{"_3697":1997,"_31245":1930,"_21577":57101,"_5":14884,"_28435":56943,"_3074":57102},[],"**Expiry.** The expiry monitor marks as `EXPIRED` the `ACTIVE` CAs whose validity period has ended. Until it runs, the CA already does not sign, because Lamassu checks the dates (Issue certificates).",{"_3697":1998,"_31245":1930,"_21577":57104,"_5":14884,"_28435":56943,"_3074":57105},[],"**Revocation.** Revoking with the `CertificateHold` reason is reversible. A revocation with any other reason, like `EXPIRED`, rejects every later status change. Revoking, also with `CertificateHold`, additionally acts on the subordinate CAs and the certificates it issued: Revoke a CA.",{"_3697":1999,"_31245":1930,"_21577":57107,"_5":14884,"_28435":56943,"_3074":57108},[],"**Deletion.** Only a CA revoked with another reason, or an expired one, can be deleted; an imported CA without a key can be deleted from any state. Conditions and effects in Delete a CA.",{"_3697":2000,"_31245":1930,"_21577":57110,"_5":14884,"_28435":56947,"_3074":57111},[],"Open a CA from the inventory to review:",{"_3697":2001,"_31245":1930,"_21577":57113,"_5":14884,"_28435":56947,"_3074":57114},[],"Status and validity period.",{"_3697":2002,"_31245":1930,"_21577":57116,"_5":14884,"_28435":56947,"_3074":57117},[],"Certificate and chain in PEM format.",{"_3697":2003,"_31245":1930,"_21577":57119,"_5":14884,"_28435":56947,"_3074":57120},[],"Number of active, expired and revoked certificates.",{"_3697":2004,"_31245":1930,"_21577":57122,"_5":14884,"_28435":56947,"_3074":57123},[],"Certificates issued in **Issued Certificates**.",{"_3697":2005,"_31245":1930,"_21577":57125,"_5":14884,"_28435":56947,"_3074":57126},[],"The CRL linked to the authority.",{"_3697":2006,"_31245":1930,"_21577":57128,"_5":14884,"_28435":56947,"_3074":57129},[],"Metadata and the associated cryptographic engine.",{"_3697":2007,"_31245":1930,"_21577":57131,"_5":14884,"_28435":56947,"_3074":57132},[],"You can filter the inventory by name, status and CA type.",{"_3697":2008,"_31245":1930,"_21577":57134,"_5":14884,"_28435":56951,"_3074":57135},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3697":2009,"_31245":1930,"_21577":57137,"_5":14884,"_28435":56951,"_3074":57138},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3697":2010,"_31245":1930,"_21577":57140,"_5":14884,"_28435":56951,"_3074":57141},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3697":2011,"_31245":1930,"_21577":57143,"_5":14884,"_28435":56951,"_3074":57144},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3697":2012,"_31245":1930,"_21577":57146,"_5":14884,"_28435":56951,"_3074":57147},[],"A CA key signs certificates only. The CA API has no endpoint to sign or verify arbitrary data. To sign and verify a message with a key, use the KMS operations described in Key management, subject to their own permissions.",{"_3697":2013,"_31245":1930,"_21577":57149,"_5":14884,"_28435":56951,"_3074":57150},[],"A CA signs only while its status is `ACTIVE` and the current time falls inside the validity period of its certificate. Lamassu checks both, because the stored status can lag behind the dates until the expiration monitor runs. Otherwise the request fails with `400` and the message `CA Status inconsistent`, before the KMS is called. The same check applies when the CA signs the certificate of a subordinate CA, including when you create or reissue it.",{"_3697":2014,"_31245":1930,"_21577":57152,"_5":14884,"_28435":56955,"_3074":57153},[],"Revoking a CA prevents issuance and may interrupt its entire branch. With `CertificateHold` the cascade is reversible: descendants are suspended on hold and are restored when you release the CA. Any other revocation reason revokes descendants permanently with `CessationOfOperation`. Follow the cascading revocation conditions.",{"_3697":2015,"_31245":1930,"_21577":57155,"_5":14884,"_28435":56959,"_3074":57156},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3697":2016,"_31245":1930,"_21577":57158,"_5":14884,"_28435":56963,"_3074":57159},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3697":2017,"_31245":1930,"_21577":57161,"_5":14884,"_28435":56967,"_3074":57162},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3697":2018,"_31245":1930,"_21577":57164,"_5":14884,"_28435":56971,"_3074":57165},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3697":2019,"_31245":1930,"_21577":57167,"_5":14884,"_28435":56975,"_3074":57168},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3697":2020,"_31245":1930,"_21577":57170,"_5":14884,"_28435":56975,"_3074":57171},[],"What the deletion does to what the CA issued depends on its status. Deleting an active CA imported without a key whose validity period has not ended only removes the record from Lamassu: the CA, its descendants and the certificates it issued keep their status, since the CA keeps operating outside Lamassu — its key was never in Lamassu. But if the validity period has already ended while the stored status still says `ACTIVE` — the stored status can lag behind the dates until the expiration monitor runs — the CA counts as expired for deletion. Deleting a revoked or expired CA revokes what it issued with `CessationOfOperation`, the same cascade as when revoking a CA. To retire an active keyless CA together with everything it issued, revoke it first with `POST /v1/cas/:id/status` and then delete it.",{"_3697":2021,"_31245":1930,"_21577":57173,"_5":14884,"_28435":56975,"_3074":57174},[],"The CA’s CRL settings are kept. A deletion is refused with a `409` error while they are still `ACTIVE`: the VA must first publish the CA’s final CRL, which can take up to about an hour after revocation with the default job schedule, so retry after the final CRL is published. An expired CA is finalized without a final CRL, and a CA on hold (`CertificateHold`) is refused with a message asking you to revoke it permanently first. The deletion is also refused with a `409` when the CA’s key signs the CRLs of another CA: the error names that CA, so change its CRL signer, or delete or revoke it, before deleting this one. The CA and all its descendants are checked before anything is deleted; nothing changes if any of them cannot be deleted.",{"_3697":2022,"_31245":1930,"_21577":57176,"_5":14884,"_28435":56975,"_3074":57177},[],"After the deletion, the settings are archived and the last CRL keeps being served but is never regenerated; you can remove them once no certificate issued by the CA still needs revocation evidence, using `DELETE /v1/crl-settings/{ca-id}` or the console's **Verification Authorities** page. Deleting them stops the CRL from being served and cannot be undone. Adjust the validity and signer before revoking or deleting the CA (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3697":2023,"_31245":1930,"_21577":57179,"_5":14884,"_28435":56975,"_3074":57180},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: until those settings are deleted, those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL).",{"_3697":2024,"_31245":2024,"_5":15238,"_3074":57182,"_31570":57183,"_21577":57184,"_28435":2024},"Certificate profiles",[50948,52489,56713,56714],[],{"_3697":2025,"_31245":2024,"_21577":57186,"_5":14884,"_28435":2024,"_3074":57187},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3697":2026,"_31245":2024,"_5":31567,"_21577":57189,"_28435":57190,"_3074":57191},[],"/docs/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3697":2027,"_31245":2024,"_5":31567,"_21577":57193,"_28435":57194,"_3074":57195},[],"/docs/platform/pki/certificate-profiles#validity","Validity",{"_3697":2028,"_31245":2024,"_5":31567,"_21577":57197,"_28435":57198,"_3074":57199},[],"/docs/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3697":2029,"_31245":2024,"_5":31567,"_21577":57201,"_28435":57202,"_3074":57203},[],"/docs/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3697":2030,"_31245":2024,"_5":31567,"_21577":57205,"_28435":57206,"_3074":57207},[],"/docs/platform/pki/certificate-profiles#subject","Subject",{"_3697":2031,"_31245":2024,"_5":31567,"_21577":57209,"_28435":57210,"_3074":57211},[],"/docs/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3697":2032,"_31245":2024,"_5":31567,"_21577":57213,"_28435":57214,"_3074":57215},[],"/docs/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3697":2033,"_31245":2024,"_5":31567,"_21577":57217,"_28435":57218,"_3074":57219},[],"/docs/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3697":2034,"_31245":2024,"_5":31567,"_21577":57221,"_28435":57222,"_3074":57223},[],"/docs/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3697":2035,"_31245":2024,"_5":31567,"_21577":57225,"_28435":57226,"_3074":57227},[],"/docs/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3697":2036,"_31245":2024,"_5":31567,"_21577":57229,"_28435":57230,"_3074":57231},[],"/docs/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3697":2037,"_31245":2024,"_5":31567,"_21577":57233,"_28435":57234,"_3074":57235},[],"/docs/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3697":2038,"_31245":2024,"_5":31567,"_21577":57237,"_28435":57238,"_3074":57239},[],"/docs/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3697":2039,"_31245":2024,"_5":31567,"_21577":57241,"_28435":57242,"_3074":57243},[],"/docs/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3697":2040,"_31245":2024,"_5":31567,"_21577":57245,"_28435":57246,"_3074":57247},[],"/docs/platform/pki/certificate-profiles#design-examples","Design examples",{"_3697":2041,"_31245":2024,"_5":31567,"_21577":57249,"_28435":57250,"_3074":57251},[],"/docs/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3697":2042,"_31245":2024,"_21577":57253,"_5":14884,"_28435":2024,"_3074":57254},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3697":2043,"_31245":2024,"_21577":57256,"_5":14884,"_28435":2024,"_3074":57257},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3697":2044,"_31245":2024,"_21577":57259,"_5":14884,"_28435":57194,"_3074":57260},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3697":2045,"_31245":2024,"_21577":57262,"_5":14884,"_28435":57194,"_3074":57263},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3697":2046,"_31245":2024,"_21577":57265,"_5":14884,"_28435":57198,"_3074":57266},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Lamassu enforces this: a profile with `Sign as CA` is consumed only when creating or reissuing a CA. Any signing request that resolves to such a profile is rejected — direct signing with a CA, including certificate issuance requests on it, and DMS enrollment or re-enrollment. Nothing validates the profile when it is saved: if a CA's default profile or a DMS profile has `Sign as CA` enabled, the problem appears on the first signing request that resolves to it — for a DMS profile, when a device tries to enroll or re-enroll — and renewal stays blocked until the profile is changed.",{"_3697":2047,"_31245":2024,"_21577":57268,"_5":14884,"_28435":57202,"_3074":57269},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3697":2048,"_31245":2024,"_21577":57271,"_5":14884,"_28435":57202,"_3074":57272},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3697":2049,"_31245":2024,"_21577":57274,"_5":14884,"_28435":57202,"_3074":57275},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3697":2050,"_31245":2024,"_21577":57277,"_5":14884,"_28435":57206,"_3074":57278},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3697":2051,"_31245":2024,"_21577":57280,"_5":14884,"_28435":57210,"_3074":57281},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3697":2052,"_31245":2024,"_21577":57283,"_5":14884,"_28435":57210,"_3074":57284},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3697":2053,"_31245":2024,"_21577":57286,"_5":14884,"_28435":57214,"_3074":57287},[],"The cryptographic enforcement can:",{"_3697":2054,"_31245":2024,"_21577":57289,"_5":14884,"_28435":57214,"_3074":57290},[],"allow or block RSA keys;",{"_3697":2055,"_31245":2024,"_21577":57292,"_5":14884,"_28435":57214,"_3074":57293},[],"limit the supported RSA sizes;",{"_3697":2056,"_31245":2024,"_21577":57295,"_5":14884,"_28435":57214,"_3074":57296},[],"allow or block ECDSA keys;",{"_3697":2057,"_31245":2024,"_21577":57298,"_5":14884,"_28435":57214,"_3074":57299},[],"limit the supported ECDSA sizes or curves.",{"_3697":2058,"_31245":2024,"_21577":57301,"_5":14884,"_28435":57214,"_3074":57302},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3697":2059,"_31245":2024,"_21577":57304,"_5":14884,"_28435":57218,"_3074":57305},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3697":2060,"_31245":2024,"_21577":57307,"_5":14884,"_28435":57218,"_3074":54295},[],{"_3697":2061,"_31245":2024,"_21577":57309,"_5":14884,"_28435":57218,"_3074":57310},[],"First choice",{"_3697":2062,"_31245":2024,"_21577":57312,"_5":14884,"_28435":57218,"_3074":57313},[],"Second choice",{"_3697":2063,"_31245":2024,"_21577":57315,"_5":14884,"_28435":57218,"_3074":57316},[],"If neither is supplied",{"_3697":2064,"_31245":2024,"_21577":57318,"_5":14884,"_28435":57218,"_3074":57319},[],"Direct signing with a CA",{"_3697":2065,"_31245":2024,"_21577":57321,"_5":14884,"_28435":57218,"_3074":57322},[],"`issuance_profile` embedded in the request",{"_3697":2066,"_31245":2024,"_21577":57324,"_5":14884,"_28435":57218,"_3074":57325},[],"Request `issuance_profile_id`",{"_3697":2067,"_31245":2024,"_21577":57327,"_5":14884,"_28435":57218,"_3074":57328},[],"CA default profile (`profile_id`).",{"_3697":2068,"_31245":2024,"_21577":57330,"_5":14884,"_28435":57218,"_3074":57331},[],"Issuance through a DMS",{"_3697":2069,"_31245":2024,"_21577":57333,"_5":14884,"_28435":57218,"_3074":57334},[],"`settings.issuance_profile_id`",{"_3697":2070,"_31245":2024,"_21577":57336,"_5":14884,"_28435":57218,"_3074":57337},[],"`settings.issuance_profile` embedded in the DMS",{"_3697":2071,"_31245":2024,"_21577":57339,"_5":14884,"_28435":57218,"_3074":57340},[],"Enrollment CA default profile.",{"_3697":2072,"_31245":2024,"_21577":57342,"_5":14884,"_28435":57218,"_3074":57343},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3697":2073,"_31245":2024,"_21577":57345,"_5":14884,"_28435":57218,"_3074":57346},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3697":2074,"_31245":2024,"_21577":57348,"_5":14884,"_28435":57226,"_3074":57349},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3697":2075,"_31245":2024,"_21577":57351,"_5":14884,"_28435":57230,"_3074":57352},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3697":2076,"_31245":2024,"_21577":57354,"_5":14884,"_28435":57234,"_3074":57355},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3697":2077,"_31245":2024,"_21577":57357,"_5":14884,"_28435":57238,"_3074":57358},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3697":2078,"_31245":2024,"_21577":57360,"_5":14884,"_28435":57242,"_3074":57361},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3697":2079,"_31245":2024,"_21577":57363,"_5":14884,"_28435":57242,"_3074":57364},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3697":2080,"_31245":2024,"_21577":57366,"_5":14884,"_28435":57246,"_3074":57367},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3697":2081,"_31245":2024,"_21577":57369,"_5":14884,"_28435":57246,"_3074":57370},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3697":2082,"_31245":2024,"_21577":57372,"_5":14884,"_28435":57246,"_3074":57373},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3697":2083,"_31245":2024,"_21577":57375,"_5":14884,"_28435":57246,"_3074":57376},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3697":2084,"_31245":2024,"_21577":57378,"_5":14884,"_28435":57250,"_3074":57379},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3697":2085,"_31245":2024,"_21577":57381,"_5":14884,"_28435":57250,"_3074":57382},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3697":2086,"_31245":2086,"_5":15238,"_3074":57384,"_31570":57385,"_21577":57387,"_28435":2086},"Certificate validation",[50948,52489,56713,57386],"Validation",[],{"_3697":2087,"_31245":2086,"_21577":57389,"_5":14884,"_28435":2086,"_3074":57390},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3697":2088,"_31245":2086,"_5":31567,"_21577":57392,"_28435":57393,"_3074":57394},[],"/docs/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3697":2089,"_31245":2086,"_5":31567,"_21577":57396,"_28435":57397,"_3074":57398},[],"/docs/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3697":2090,"_31245":2086,"_5":31567,"_21577":57400,"_28435":57401,"_3074":57402},[],"/docs/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3697":2091,"_31245":2086,"_21577":57404,"_5":14884,"_28435":2086,"_3074":57405},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3697":2092,"_31245":2086,"_21577":57407,"_5":14884,"_28435":57393,"_3074":57408},[],"Verify these criteria together:",{"_3697":2093,"_31245":2086,"_21577":57410,"_5":14884,"_28435":57393,"_3074":56339},[],{"_3697":2094,"_31245":2086,"_21577":57412,"_5":14884,"_28435":57393,"_3074":57413},[],"Required result",{"_3697":2095,"_31245":2086,"_21577":57415,"_5":14884,"_28435":57393,"_3074":57416},[],"Chain and signature",{"_3697":2096,"_31245":2086,"_21577":57418,"_5":14884,"_28435":57393,"_3074":57419},[],"Valid chain to a root deliberately installed in the consumer.",{"_3697":2097,"_31245":2086,"_21577":57421,"_5":14884,"_28435":57393,"_3074":57422},[],"Dates",{"_3697":2098,"_31245":2086,"_21577":57424,"_5":14884,"_28435":57393,"_3074":57425},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3697":2099,"_31245":2086,"_21577":57427,"_5":14884,"_28435":57393,"_3074":52158},[],{"_3697":2100,"_31245":2086,"_21577":57429,"_5":14884,"_28435":57393,"_3074":57430},[],"Name, SAN or identifier matches the expected peer.",{"_3697":2101,"_31245":2086,"_21577":57432,"_5":14884,"_28435":57393,"_3074":51338},[],{"_3697":2102,"_31245":2086,"_21577":57434,"_5":14884,"_28435":57393,"_3074":57435},[],"KU, EKU and constraints permit the specific operation.",{"_3697":2103,"_31245":2086,"_21577":57437,"_5":14884,"_28435":57393,"_3074":57438},[],"Revocation",{"_3697":2104,"_31245":2086,"_21577":57440,"_5":14884,"_28435":57393,"_3074":57441},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3697":2105,"_31245":2086,"_21577":57443,"_5":14884,"_28435":57393,"_3074":57444},[],"Authorization",{"_3697":2106,"_31245":2086,"_21577":57446,"_5":14884,"_28435":57393,"_3074":57447},[],"The application permits that identity to perform the action.",{"_3697":2107,"_31245":2086,"_21577":57449,"_5":14884,"_28435":57393,"_3074":57450},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3697":2108,"_31245":2086,"_21577":57452,"_5":14884,"_28435":57397,"_3074":57453},[],"Mechanism",{"_3697":2109,"_31245":2086,"_21577":57455,"_5":14884,"_28435":57397,"_3074":57456},[],"When to use it",{"_3697":2110,"_31245":2086,"_21577":57458,"_5":14884,"_28435":57397,"_3074":57459},[],"What you must maintain",{"_3697":2111,"_31245":2086,"_21577":57461,"_5":14884,"_28435":57397,"_3074":57462},[],"OCSP",{"_3697":2112,"_31245":2086,"_21577":57464,"_5":14884,"_28435":57397,"_3074":57465},[],"Status query for a specific certificate.",{"_3697":2113,"_31245":2086,"_21577":57467,"_5":14884,"_28435":57397,"_3074":57468},[],"Responder access, signature verification and cache/freshness policy.",{"_3697":2114,"_31245":2086,"_21577":57470,"_5":14884,"_28435":57397,"_3074":57471},[],"CRL",{"_3697":2115,"_31245":2086,"_21577":57473,"_5":14884,"_28435":57397,"_3074":57474},[],"Local checks for many certificates or offline operation.",{"_3697":2116,"_31245":2086,"_21577":57476,"_5":14884,"_28435":57397,"_3074":57477},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3697":2117,"_31245":2086,"_21577":57479,"_5":14884,"_28435":57397,"_3074":57480},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3697":2118,"_31245":2086,"_21577":57482,"_5":14884,"_28435":57397,"_3074":57483},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3697":2119,"_31245":2086,"_21577":57485,"_5":14884,"_28435":57401,"_3074":57486},[],"Accept a current, authorized certificate with a known chain.",{"_3697":2120,"_31245":2086,"_21577":57488,"_5":14884,"_28435":57401,"_3074":57489},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3697":2121,"_31245":2086,"_21577":57491,"_5":14884,"_28435":57401,"_3074":57492},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3697":2122,"_31245":2086,"_21577":57494,"_5":14884,"_28435":57401,"_3074":57495},[],"Check that a new connection with that identity is rejected.",{"_3697":2123,"_31245":2086,"_21577":57497,"_5":14884,"_28435":57401,"_3074":57498},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3697":2124,"_31245":2086,"_21577":57500,"_5":14884,"_28435":57401,"_3074":57501},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3697":2125,"_31245":2086,"_21577":57503,"_5":14884,"_28435":57401,"_3074":57504},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3697":2126,"_31245":2086,"_21577":57506,"_5":14884,"_28435":57401,"_3074":57507},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3697":2127,"_31245":2086,"_21577":57509,"_5":14884,"_28435":57401,"_3074":57510},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3697":2128,"_31245":2128,"_5":15238,"_3074":57512,"_31570":57513,"_21577":57514,"_28435":2128},"Certificates",[50948,52489,56713,56714],[],{"_3697":2129,"_31245":2128,"_21577":57516,"_5":14884,"_28435":2128,"_3074":57517},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3697":2130,"_31245":2128,"_5":31567,"_21577":57519,"_28435":57520,"_3074":57521},[],"/docs/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3697":2131,"_31245":2128,"_5":31567,"_21577":57523,"_28435":57524,"_3074":57525},[],"/docs/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3697":2132,"_31245":2128,"_5":31567,"_21577":57527,"_28435":57528,"_3074":57529},[],"/docs/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3697":2133,"_31245":2128,"_5":31567,"_21577":57531,"_28435":57532,"_3074":57533},[],"/docs/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3697":2134,"_31245":2128,"_5":31567,"_21577":57535,"_28435":57536,"_3074":57537},[],"/docs/platform/pki/certificates#open-the-action","Open the action",{"_3697":2135,"_31245":2128,"_5":31567,"_21577":57539,"_28435":57540,"_3074":57541},[],"/docs/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3697":2136,"_31245":2128,"_5":31567,"_21577":57543,"_28435":57544,"_3074":57545},[],"/docs/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3697":2137,"_31245":2128,"_5":31567,"_21577":57547,"_28435":57548,"_3074":57549},[],"/docs/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3697":2138,"_31245":2128,"_5":31567,"_21577":57551,"_28435":57552,"_3074":57553},[],"/docs/platform/pki/certificates#continue","Continue",{"_3697":2139,"_31245":2128,"_21577":57555,"_5":14884,"_28435":2128,"_3074":57556},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3697":2140,"_31245":2128,"_21577":57558,"_5":14884,"_28435":57520,"_3074":57559},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3697":2141,"_31245":2128,"_21577":57561,"_5":14884,"_28435":57520,"_3074":57562},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3697":2142,"_31245":2128,"_21577":57564,"_5":14884,"_28435":57520,"_3074":57565},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3697":2143,"_31245":2128,"_21577":57567,"_5":14884,"_28435":57520,"_3074":57568},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3697":2144,"_31245":2128,"_21577":57570,"_5":14884,"_28435":57520,"_3074":57571},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3697":2145,"_31245":2128,"_21577":57573,"_5":14884,"_28435":57520,"_3074":57574},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3697":2146,"_31245":2128,"_21577":57576,"_5":14884,"_28435":57520,"_3074":57577},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3697":2147,"_31245":2128,"_21577":57579,"_5":14884,"_28435":57524,"_3074":57580},[],"Download the PEM and inspect it:",{"_3697":2148,"_31245":2128,"_21577":57582,"_5":14884,"_28435":57524,"_3074":57583},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3697":2149,"_31245":2128,"_21577":57585,"_5":14884,"_28435":57528,"_3074":57586},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3697":2150,"_31245":2128,"_21577":57588,"_5":14884,"_28435":57528,"_3074":57589},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3697":2151,"_31245":2128,"_21577":57591,"_5":14884,"_28435":57528,"_3074":57592},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3697":2152,"_31245":2128,"_21577":57594,"_5":14884,"_28435":57528,"_3074":57595},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3697":2153,"_31245":2128,"_21577":57597,"_5":14884,"_28435":57528,"_3074":57598},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3697":2154,"_31245":2128,"_21577":57600,"_5":14884,"_28435":57528,"_3074":57601},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3697":2155,"_31245":2128,"_21577":57603,"_5":14884,"_28435":57528,"_3074":57604},[],"For browser key generation, follow Issue your first certificate.",{"_3697":2156,"_31245":2128,"_21577":57606,"_5":14884,"_28435":57532,"_3074":57607},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3697":2157,"_31245":2128,"_21577":57609,"_5":14884,"_28435":57536,"_3074":57610},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3697":2158,"_31245":2128,"_21577":57612,"_5":14884,"_28435":57540,"_3074":57613},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3697":2159,"_31245":2128,"_21577":57615,"_5":14884,"_28435":57544,"_3074":57616},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3697":2160,"_31245":2128,"_21577":57618,"_5":14884,"_28435":57544,"_3074":57619},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3697":2161,"_31245":2128,"_21577":57621,"_5":14884,"_28435":57544,"_3074":57622},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3697":2162,"_31245":2128,"_21577":57624,"_5":14884,"_28435":57548,"_3074":57625},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3697":2163,"_31245":2128,"_21577":57627,"_5":14884,"_28435":57548,"_3074":57628},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3697":2164,"_31245":2128,"_21577":57630,"_5":14884,"_28435":57548,"_3074":57631},[],"This does not undo permanent revocation or the cascade of a CA revoked for good; the hold cascaded by a CA is lifted by releasing that CA.",{"_3697":2165,"_31245":2128,"_21577":57633,"_5":14884,"_28435":57552,"_3074":57634},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3697":2166,"_31245":2128,"_21577":57636,"_5":14884,"_28435":57552,"_3074":57637},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3697":2167,"_31245":2167,"_5":15238,"_3074":57639,"_31570":57640,"_21577":57642,"_28435":2167},"Certificate lifecycle",[50948,52489,56713,57641],"Concepts",[],{"_3697":2168,"_31245":2167,"_21577":57644,"_5":14884,"_28435":2167,"_3074":57645},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3697":2169,"_31245":2167,"_5":31567,"_21577":57647,"_28435":57648,"_3074":57649},[],"/docs/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3697":2170,"_31245":2167,"_5":31567,"_21577":57651,"_28435":57652,"_3074":57653},[],"/docs/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3697":2171,"_31245":2167,"_5":31567,"_21577":57655,"_28435":57656,"_3074":57657},[],"/docs/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3697":2172,"_31245":2167,"_5":31567,"_21577":57659,"_28435":57660,"_3074":57661},[],"/docs/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3697":2173,"_31245":2167,"_5":31567,"_21577":57663,"_28435":57664,"_3074":57665},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3697":2174,"_31245":2167,"_5":31567,"_21577":57667,"_28435":57668,"_3074":57669},[],"/docs/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3697":2175,"_31245":2167,"_5":31567,"_21577":57671,"_28435":57672,"_3074":57673},[],"/docs/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3697":2176,"_31245":2167,"_5":31567,"_21577":57675,"_28435":57676,"_3074":57677},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3697":2177,"_31245":2167,"_5":31567,"_21577":57679,"_28435":57680,"_3074":57681},[],"/docs/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3697":2178,"_31245":2167,"_5":31567,"_21577":57683,"_28435":57684,"_3074":57685},[],"/docs/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3697":2179,"_31245":2167,"_21577":57687,"_5":14884,"_28435":2167,"_3074":57688},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3697":2180,"_31245":2167,"_21577":57690,"_5":14884,"_28435":57652,"_3074":57691},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3697":2181,"_31245":2167,"_21577":57693,"_5":14884,"_28435":57656,"_3074":57694},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3697":2182,"_31245":2167,"_21577":57696,"_5":14884,"_28435":57660,"_3074":57697},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3697":2183,"_31245":2167,"_21577":57699,"_5":14884,"_28435":57664,"_3074":57700},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3697":2184,"_31245":2167,"_21577":57702,"_5":14884,"_28435":57668,"_3074":57703},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3697":2185,"_31245":2167,"_21577":57705,"_5":14884,"_28435":57672,"_3074":57706},[],"Lamassu persists four X.509 states:",{"_3697":2186,"_31245":2167,"_21577":57708,"_5":14884,"_28435":57672,"_3074":57709},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3697":2187,"_31245":2167,"_21577":57711,"_5":14884,"_28435":57672,"_3074":57712},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3697":2188,"_31245":2167,"_21577":57714,"_5":14884,"_28435":57672,"_3074":57715},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3697":2189,"_31245":2167,"_21577":57717,"_5":14884,"_28435":57672,"_3074":57718},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3697":2190,"_31245":2167,"_21577":57720,"_5":14884,"_28435":57672,"_3074":57721},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3697":2191,"_31245":2167,"_21577":57723,"_5":14884,"_28435":57676,"_3074":57724},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3697":2192,"_31245":2167,"_21577":57726,"_5":14884,"_28435":57676,"_3074":57727},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3697":2193,"_31245":2167,"_21577":57729,"_5":14884,"_28435":57676,"_3074":57730},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3697":2194,"_31245":2167,"_21577":57732,"_5":14884,"_28435":57680,"_3074":57733},[],"Revoking a CA starts a cascade that attempts to revoke descendants. A `CertificateHold` cascade suspends them reversibly: releasing the CA restores those still on hold. Any other revocation reason revokes descendants permanently with `CessationOfOperation`. Read Hierarchy and rotation for conditions and checks.",{"_3697":2195,"_31245":2167,"_21577":57735,"_5":14884,"_28435":57680,"_3074":57736},[],"Before confirming:",{"_3697":2196,"_31245":2167,"_21577":57738,"_5":14884,"_28435":57680,"_3074":57739},[],"Identify DMSs, devices and services that trust that chain.",{"_3697":2197,"_31245":2167,"_21577":57741,"_5":14884,"_28435":57680,"_3074":57742},[],"Distribute the new chain of trust.",{"_3697":2198,"_31245":2167,"_21577":57744,"_5":14884,"_28435":57680,"_3074":57745},[],"Reissue the necessary identities.",{"_3697":2199,"_31245":2167,"_21577":57747,"_5":14884,"_28435":57680,"_3074":57748},[],"Check OCSP and CRL from a real consumer.",{"_3697":2200,"_31245":2167,"_21577":57750,"_5":14884,"_28435":57680,"_3074":57751},[],"Revoke the old CA once no legitimate traffic remains.",{"_3697":2201,"_31245":2167,"_21577":57753,"_5":14884,"_28435":57680,"_3074":57754},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3697":2202,"_31245":2167,"_21577":57756,"_5":14884,"_28435":57684,"_3074":57757},[],"Certificates entering the preventive or critical renewal window.",{"_3697":2203,"_31245":2167,"_21577":57759,"_5":14884,"_28435":57684,"_3074":57760},[],"Repeated enrollment or re-enrollment failures.",{"_3697":2204,"_31245":2167,"_21577":57762,"_5":14884,"_28435":57684,"_3074":57763},[],"Status changes and revocation reasons.",{"_3697":2205,"_31245":2167,"_21577":57765,"_5":14884,"_28435":57684,"_3074":57766},[],"OCSP and CRL publication and validity.",{"_3697":2206,"_31245":2167,"_21577":57768,"_5":14884,"_28435":57684,"_3074":57769},[],"Dependencies still presenting a replaced certificate.",{"_3697":2207,"_31245":2167,"_21577":57771,"_5":14884,"_28435":57684,"_3074":57772},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3697":2208,"_31245":2208,"_5":15238,"_3074":57774,"_31570":57775,"_21577":57776,"_28435":2208},"Trust model",[50948,52489,56713,57641],[],{"_3697":2209,"_31245":2208,"_21577":57778,"_5":14884,"_28435":2208,"_3074":57779},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3697":2210,"_31245":2208,"_5":31567,"_21577":57781,"_28435":57782,"_3074":57783},[],"/docs/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3697":2211,"_31245":2208,"_5":31567,"_21577":57785,"_28435":57786,"_3074":57787},[],"/docs/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3697":2212,"_31245":2208,"_5":31567,"_21577":57789,"_28435":57790,"_3074":57791},[],"/docs/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3697":2213,"_31245":2208,"_5":31567,"_21577":57793,"_28435":57794,"_3074":57795},[],"/docs/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3697":2214,"_31245":2208,"_5":31567,"_21577":57797,"_28435":57798,"_3074":57799},[],"/docs/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3697":2215,"_31245":2208,"_5":31567,"_21577":57801,"_28435":57802,"_3074":57803},[],"/docs/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3697":2216,"_31245":2208,"_5":31567,"_21577":57805,"_28435":57806,"_3074":57807},[],"/docs/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3697":2217,"_31245":2208,"_5":31567,"_21577":57809,"_28435":57810,"_3074":57811},[],"/docs/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3697":2218,"_31245":2208,"_5":31567,"_21577":57813,"_28435":57814,"_3074":57815},[],"/docs/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3697":2219,"_31245":2208,"_5":31567,"_21577":57817,"_28435":57818,"_3074":57819},[],"/docs/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3697":2220,"_31245":2208,"_21577":57821,"_5":14884,"_28435":2208,"_3074":57822},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3697":2221,"_31245":2208,"_21577":57824,"_5":14884,"_28435":57786,"_3074":57825},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3697":2222,"_31245":2208,"_21577":57827,"_5":14884,"_28435":57790,"_3074":57828},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3697":2223,"_31245":2208,"_21577":57830,"_5":14884,"_28435":57794,"_3074":57831},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3697":2224,"_31245":2208,"_21577":57833,"_5":14884,"_28435":57798,"_3074":57834},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3697":2225,"_31245":2208,"_21577":57836,"_5":14884,"_28435":57802,"_3074":57837},[],"The device proves it can enroll according to the DMS policy.",{"_3697":2226,"_31245":2208,"_21577":57839,"_5":14884,"_28435":57802,"_3074":57840},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3697":2227,"_31245":2208,"_21577":57842,"_5":14884,"_28435":57802,"_3074":57843},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3697":2228,"_31245":2208,"_21577":57845,"_5":14884,"_28435":57802,"_3074":57846},[],"The device installs the certificate and the chain it needs.",{"_3697":2229,"_31245":2208,"_21577":57848,"_5":14884,"_28435":57802,"_3074":57849},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3697":2230,"_31245":2208,"_21577":57851,"_5":14884,"_28435":57802,"_3074":57852},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3697":2231,"_31245":2208,"_21577":57854,"_5":14884,"_28435":57806,"_3074":57855},[],"A DMS relates three sets that are worth designing separately:",{"_3697":2232,"_31245":2208,"_21577":57857,"_5":14884,"_28435":57806,"_3074":57858},[],"**Enrollment CA:** signs the new identities.",{"_3697":2233,"_31245":2208,"_21577":57860,"_5":14884,"_28435":57806,"_3074":57861},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3697":2234,"_31245":2208,"_21577":57863,"_5":14884,"_28435":57806,"_3074":57864},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3697":2235,"_31245":2208,"_21577":57866,"_5":14884,"_28435":57806,"_3074":57867},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3697":2236,"_31245":2208,"_21577":57869,"_5":14884,"_28435":57810,"_3074":57870},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3697":2237,"_31245":2208,"_21577":57872,"_5":14884,"_28435":57810,"_3074":57873},[],"that the current date is between `Not Before` and `Not After`;",{"_3697":2238,"_31245":2208,"_21577":57875,"_5":14884,"_28435":57810,"_3074":57876},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3697":2239,"_31245":2208,"_21577":57878,"_5":14884,"_28435":57810,"_3074":57879},[],"that names, SANs and subject match the expected identity;",{"_3697":2240,"_31245":2208,"_21577":57881,"_5":14884,"_28435":57810,"_3074":57882},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3697":2241,"_31245":2208,"_21577":57884,"_5":14884,"_28435":57810,"_3074":57885},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3697":2242,"_31245":2208,"_21577":57887,"_5":14884,"_28435":57810,"_3074":57888},[],"During the mTLS authentication of a DMS, Lamassu checks revocation and fails closed: a certificate whose revocation cannot be verified is rejected by default. The `allow_unverifiable_revocation` option of the DMS (see DMS) is the opt-out, and it only relaxes certificates that carry no OCSP/CRL endpoint at all. Design your profiles and distribution points so that the check succeeds.",{"_3697":2243,"_31245":2208,"_21577":57890,"_5":14884,"_28435":57814,"_3074":57891},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3697":2244,"_31245":2208,"_21577":57893,"_5":14884,"_28435":57818,"_3074":57894},[],"Keep the root out of daily operations, or with very restricted access.",{"_3697":2245,"_31245":2208,"_21577":57896,"_5":14884,"_28435":57818,"_3074":57897},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3697":2246,"_31245":2208,"_21577":57899,"_5":14884,"_28435":57818,"_3074":57900},[],"Assign explicit profiles to every use case.",{"_3697":2247,"_31245":2208,"_21577":57902,"_5":14884,"_28435":57818,"_3074":57903},[],"Distribute the new trust before starting a rotation.",{"_3697":2248,"_31245":2208,"_21577":57905,"_5":14884,"_28435":57818,"_3074":57906},[],"Keep enough overlap to renew a disconnected fleet.",{"_3697":2249,"_31245":2208,"_21577":57908,"_5":14884,"_28435":57818,"_3074":57909},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3697":2250,"_31245":2208,"_21577":57911,"_5":14884,"_28435":57818,"_3074":57912},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3697":2251,"_31245":2251,"_5":15238,"_3074":57914,"_31570":57915,"_21577":57916,"_28435":2251},"Revocation lists (CRL)",[50948,52489,56713,57386],[],{"_3697":2252,"_31245":2251,"_21577":57918,"_5":14884,"_28435":2251,"_3074":57919},[],"Generate and distribute signed lists to validate certificates offline.",{"_3697":2253,"_31245":2251,"_5":31567,"_21577":57921,"_28435":57922,"_3074":57923},[],"/docs/platform/pki/crl#crl-settings","CRL settings",{"_3697":2254,"_31245":2251,"_5":31567,"_21577":57925,"_28435":57926,"_3074":57927},[],"/docs/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3697":2255,"_31245":2251,"_5":31567,"_21577":57929,"_28435":57930,"_3074":57931},[],"/docs/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3697":2256,"_31245":2251,"_5":31567,"_21577":57933,"_28435":57934,"_3074":57935},[],"/docs/platform/pki/crl#crl-contents","CRL contents",{"_3697":2257,"_31245":2251,"_5":31567,"_21577":57937,"_28435":57938,"_3074":57939},[],"/docs/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3697":2258,"_31245":2251,"_5":31567,"_21577":57941,"_28435":57942,"_3074":57943},[],"/docs/platform/pki/crl#crl-settings-api","CRL settings API",{"_3697":2259,"_31245":2251,"_5":31567,"_21577":57945,"_28435":57946,"_3074":57947},[],"/docs/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3697":2260,"_31245":2251,"_5":31567,"_21577":57949,"_28435":57950,"_3074":57951},[],"/docs/platform/pki/crl#references","References",{"_3697":2261,"_31245":2251,"_21577":57953,"_5":14884,"_28435":2251,"_3074":57954},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3697":2262,"_31245":2251,"_21577":57956,"_5":14884,"_28435":57922,"_3074":57957},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. The VA creates them when a CA is created; when a CA is imported whose key is in the KMS — either imported with the private key or already held by the KMS — and whose certificate carries `cRLSign`: such a CA publishes its first CRL immediately, like a created one; and when a CA without settings is reissued with a certificate that can sign CRLs. An imported CA whose key is not in the KMS, or whose certificate lacks `cRLSign`, receives no settings: the import succeeds without error, and the CA's CRL endpoints report the settings as missing. Settings are never created retroactively: a CA that has none keeps none until it is reissued. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3697":2263,"_31245":2251,"_21577":57959,"_5":14884,"_28435":57922,"_3074":54389},[],{"_3697":2264,"_31245":2251,"_21577":57961,"_5":14884,"_28435":57922,"_3074":51338},[],{"_3697":2265,"_31245":2251,"_21577":57963,"_5":14884,"_28435":57922,"_3074":52609},[],{"_3697":2266,"_31245":2251,"_21577":57965,"_5":14884,"_28435":57922,"_3074":57966},[],"ID of the CA the settings belong to.",{"_3697":2267,"_31245":2251,"_21577":57968,"_5":14884,"_28435":57922,"_3074":57969},[],"`status`",{"_3697":2268,"_31245":2251,"_21577":57971,"_5":14884,"_28435":57922,"_3074":57972},[],"Lifecycle of the settings. `ACTIVE` ones generate CRLs. `FINAL` ones belong to a CA revoked permanently or expired: the first publishes one final CRL, valid until the CA's current certificate expires, and the second is turned `FINAL` without one. `ARCHIVED` ones belong to a deleted CA: their last CRL is still served, but never regenerated.",{"_3697":2269,"_31245":2251,"_21577":57974,"_5":14884,"_28435":57922,"_3074":57975},[],"`legacy_ski`",{"_3697":2270,"_31245":2251,"_21577":57977,"_5":14884,"_28435":57922,"_3074":57978},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3697":2271,"_31245":2251,"_21577":57980,"_5":14884,"_28435":57922,"_3074":57981},[],"`latest_crl`",{"_3697":2272,"_31245":2251,"_21577":57983,"_5":14884,"_28435":57922,"_3074":57984},[],"Version, validity start and end of the last published list. Read-only.",{"_3697":2273,"_31245":2251,"_21577":57986,"_5":14884,"_28435":57922,"_3074":57987},[],"`crl_options` field",{"_3697":2274,"_31245":2251,"_21577":57989,"_5":14884,"_28435":57922,"_3074":51338},[],{"_3697":2275,"_31245":2251,"_21577":57991,"_5":14884,"_28435":57922,"_3074":57992},[],"Initial value",{"_3697":2276,"_31245":2251,"_21577":57994,"_5":14884,"_28435":57922,"_3074":57995},[],"`validity`",{"_3697":2277,"_31245":2251,"_21577":57997,"_5":14884,"_28435":57922,"_3074":57998},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3697":2278,"_31245":2251,"_21577":58000,"_5":14884,"_28435":57922,"_3074":58001},[],"7 days.",{"_3697":2279,"_31245":2251,"_21577":58003,"_5":14884,"_28435":57922,"_3074":58004},[],"`refresh_interval`",{"_3697":2280,"_31245":2251,"_21577":58006,"_5":14884,"_28435":57922,"_3074":58007},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3697":2281,"_31245":2251,"_21577":58009,"_5":14884,"_28435":57922,"_3074":58010},[],"6 days and 23 hours.",{"_3697":2282,"_31245":2251,"_21577":58012,"_5":14884,"_28435":57922,"_3074":58013},[],"`regenerate_on_revoke`",{"_3697":2283,"_31245":2251,"_21577":58015,"_5":14884,"_28435":57922,"_3074":58016},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3697":2284,"_31245":2251,"_21577":58018,"_5":14884,"_28435":57922,"_3074":58019},[],"`true`.",{"_3697":2285,"_31245":2251,"_21577":58021,"_5":14884,"_28435":57922,"_3074":58022},[],"`signer_serial_number`",{"_3697":2286,"_31245":2251,"_21577":58024,"_5":14884,"_28435":57922,"_3074":58025},[],"Serial number of the existing certificate that signs the CRL.",{"_3697":2287,"_31245":2251,"_21577":58027,"_5":14884,"_28435":57922,"_3074":58028},[],"Serial number of the CA’s current certificate.",{"_3697":2288,"_31245":2251,"_21577":58030,"_5":14884,"_28435":57922,"_3074":58031},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3697":2289,"_31245":2251,"_21577":58033,"_5":14884,"_28435":57922,"_3074":58034},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3697":2290,"_31245":2251,"_21577":58036,"_5":14884,"_28435":57922,"_3074":58037},[],"The CRL lifecycle decisions — when publication stops and when the final CRL expires — use only the CA's current certificate. If a reissued certificate expires earlier than an older certificate that is still valid, CRL publication can stop, or the final CRL can expire, while the older certificate is still valid. This is an accepted limitation of the current behavior.",{"_3697":2291,"_31245":2251,"_21577":58039,"_5":14884,"_28435":57922,"_3074":58040},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. A CA that has no settings at all — for example, one imported without `cRLSign` — has nothing to update: the only way to obtain them is to reissue the CA with a certificate that carries `cRLSign`. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3697":2292,"_31245":2251,"_21577":58042,"_5":14884,"_28435":57922,"_3074":58043},[],"Deleting a CA keeps its CRL settings; they remain until you delete the archived ones through the API or from the console's Verification Authorities page (see CRL settings API). What happens to them depends on how the CA ended:",{"_3697":2293,"_31245":2251,"_21577":58045,"_5":14884,"_28435":57922,"_3074":58046},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated, any `PUT` returns 409, and there is no API way back to `ACTIVE`.",{"_3697":2294,"_31245":2251,"_21577":58048,"_5":14884,"_28435":57922,"_3074":58049},[],"Revoking a CA permanently or letting it expire finalizes its settings: their `status` becomes `FINAL`, any `PUT` returns 409, and no new CRL is generated. A permanently revoked CA publishes one final CRL, valid until the CA's current certificate expires; an expired CA gets none. Deleting the CA afterwards archives its settings, which then behave like the archived ones of the migration.",{"_3697":2295,"_31245":2251,"_21577":58051,"_5":14884,"_28435":57922,"_3074":58052},[],"The settings can no longer be edited while their `status` is not `ACTIVE`. Adjust validity and signer before revoking or deleting a CA.",{"_3697":2296,"_31245":2251,"_21577":58054,"_5":14884,"_28435":57922,"_3074":58055},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3697":2297,"_31245":2251,"_21577":58057,"_5":14884,"_28435":57922,"_3074":58058},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3697":2298,"_31245":2251,"_21577":58060,"_5":14884,"_28435":57922,"_3074":58061},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3697":2299,"_31245":2251,"_21577":58063,"_5":14884,"_28435":57926,"_3074":58064},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3697":2300,"_31245":2251,"_21577":58066,"_5":14884,"_28435":57926,"_3074":58067},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3697":2301,"_31245":2251,"_21577":58069,"_5":14884,"_28435":57926,"_3074":58070},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3697":2302,"_31245":2251,"_21577":58072,"_5":14884,"_28435":57926,"_3074":58073},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3697":2303,"_31245":2251,"_21577":58075,"_5":14884,"_28435":57930,"_3074":58076},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3697":2304,"_31245":2251,"_21577":58078,"_5":14884,"_28435":57930,"_3074":58079},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3697":2305,"_31245":2251,"_21577":58081,"_5":14884,"_28435":57930,"_3074":58082},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3697":2306,"_31245":2251,"_21577":58084,"_5":14884,"_28435":57930,"_3074":58085},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3697":2307,"_31245":2251,"_21577":58087,"_5":14884,"_28435":57930,"_3074":58088},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3697":2308,"_31245":2251,"_21577":58090,"_5":14884,"_28435":57930,"_3074":58091},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3697":2309,"_31245":2251,"_21577":58093,"_5":14884,"_28435":57930,"_3074":58094},[],"Settings whose `status` is not `ACTIVE` — `FINAL` or `ARCHIVED` — are skipped: nothing regenerates their CRL.",{"_3697":2310,"_31245":2251,"_21577":58096,"_5":14884,"_28435":57930,"_3074":58097},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3697":2311,"_31245":2251,"_21577":58099,"_5":14884,"_28435":57930,"_3074":58100},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3697":2312,"_31245":2251,"_21577":58102,"_5":14884,"_28435":57934,"_3074":58103},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3697":2313,"_31245":2251,"_21577":58105,"_5":14884,"_28435":57934,"_3074":58106},[],"When the VA has configured domains, the list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with those distribution URLs; a VA with no configured domains publishes the list without an IDP, and a CRL without an IDP covers every certificate of its CA. When the extension is present, check that your client interprets it and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3697":2314,"_31245":2251,"_21577":58108,"_5":14884,"_28435":57938,"_3074":58109},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3697":2315,"_31245":2251,"_21577":58111,"_5":14884,"_28435":57938,"_3074":58112},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3697":2316,"_31245":2251,"_21577":58114,"_5":14884,"_28435":57938,"_3074":58115},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3697":2317,"_31245":2251,"_21577":58117,"_5":14884,"_28435":57938,"_3074":58118},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3697":2318,"_31245":2251,"_21577":58120,"_5":14884,"_28435":57938,"_3074":58121},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3697":2319,"_31245":2251,"_21577":58123,"_5":14884,"_28435":57942,"_3074":58124},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3697":2320,"_31245":2251,"_21577":58126,"_5":14884,"_28435":57942,"_3074":54298},[],{"_3697":2321,"_31245":2251,"_21577":58128,"_5":14884,"_28435":57942,"_3074":58129},[],"Relative path",{"_3697":2322,"_31245":2251,"_21577":58131,"_5":14884,"_28435":57942,"_3074":54295},[],{"_3697":2323,"_31245":2251,"_21577":58133,"_5":14884,"_28435":57942,"_3074":58134},[],"`GET`",{"_3697":2324,"_31245":2251,"_21577":58136,"_5":14884,"_28435":57942,"_3074":58137},[],"`/v1/crl-settings`",{"_3697":2325,"_31245":2251,"_21577":58139,"_5":14884,"_28435":57942,"_3074":58140},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3697":2326,"_31245":2251,"_21577":58142,"_5":14884,"_28435":57942,"_3074":58134},[],{"_3697":2327,"_31245":2251,"_21577":58144,"_5":14884,"_28435":57942,"_3074":58145},[],"`/v1/crl-settings/{ca-id}`",{"_3697":2328,"_31245":2251,"_21577":58147,"_5":14884,"_28435":57942,"_3074":58148},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3697":2329,"_31245":2251,"_21577":58150,"_5":14884,"_28435":57942,"_3074":58151},[],"`PUT`",{"_3697":2330,"_31245":2251,"_21577":58153,"_5":14884,"_28435":57942,"_3074":58145},[],{"_3697":2331,"_31245":2251,"_21577":58155,"_5":14884,"_28435":57942,"_3074":58156},[],"Replace the CRL configuration of a CA.",{"_3697":2332,"_31245":2251,"_21577":58158,"_5":14884,"_28435":57942,"_3074":58159},[],"`DELETE`",{"_3697":2333,"_31245":2251,"_21577":58161,"_5":14884,"_28435":57942,"_3074":58145},[],{"_3697":2334,"_31245":2251,"_21577":58163,"_5":14884,"_28435":57942,"_3074":58164},[],"Remove the archived CRL settings of a CA.",{"_3697":2335,"_31245":2251,"_21577":58166,"_5":14884,"_28435":57942,"_3074":58167},[],"You need authentication and CRL settings read, update or delete permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL.",{"_3697":2336,"_31245":2251,"_21577":58169,"_5":14884,"_28435":57942,"_3074":58170},[],"Archived settings, whose CA no longer exists, can be removed with `DELETE`: the call returns 204 on success, 404 when the CA has no settings and 409 while the settings are not yet archived. After the deletion, the public `/crl/{id}` endpoint and any legacy `/crl/<ski>` endpoint stop serving the CA’s list, although the published CRL files remain in the bucket. Keep the archived settings while any certificate issued by the CA may still need revocation evidence: `DELETE` stops serving the list immediately, regardless of `latest_crl` validity. The action cannot be undone.",{"_3697":2337,"_31245":2251,"_21577":58172,"_5":14884,"_28435":57942,"_3074":58173},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3697":2338,"_31245":2251,"_21577":58175,"_5":14884,"_28435":57946,"_3074":58176},[],"Symptom",{"_3697":2339,"_31245":2251,"_21577":58178,"_5":14884,"_28435":57946,"_3074":58179},[],"Cause",{"_3697":2340,"_31245":2251,"_21577":58181,"_5":14884,"_28435":57946,"_3074":58182},[],"Action",{"_3697":2341,"_31245":2251,"_21577":58184,"_5":14884,"_28435":57946,"_3074":58185},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3697":2342,"_31245":2251,"_21577":58187,"_5":14884,"_28435":57946,"_3074":58188},[],"The settings are not `ACTIVE`: revoking the CA permanently or letting it expire finalized them, or the migration archived them because their CA was deleted before the upgrade.",{"_3697":2343,"_31245":2251,"_21577":58190,"_5":14884,"_28435":57946,"_3074":58191},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3697":2344,"_31245":2251,"_21577":58193,"_5":14884,"_28435":57946,"_3074":58194},[],"`DELETE /v1/crl-settings/{ca-id}` returns 409.",{"_3697":2345,"_31245":2251,"_21577":58196,"_5":14884,"_28435":57946,"_3074":58197},[],"The settings are not yet `ARCHIVED`: the CA has not been deleted.",{"_3697":2346,"_31245":2251,"_21577":58199,"_5":14884,"_28435":57946,"_3074":58200},[],"Delete the CA first; deleting it archives its settings.",{"_3697":2347,"_31245":2251,"_21577":58202,"_5":14884,"_28435":57946,"_3074":58203},[],"`PUT` returns 400.",{"_3697":2348,"_31245":2251,"_21577":58205,"_5":14884,"_28435":57946,"_3074":58206},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3697":2349,"_31245":2251,"_21577":58208,"_5":14884,"_28435":57946,"_3074":58209},[],"Set the serial number of a valid certificate of that CA.",{"_3697":2350,"_31245":2251,"_21577":58211,"_5":14884,"_28435":57946,"_3074":58212},[],"`PUT` returns 404.",{"_3697":2351,"_31245":2251,"_21577":58214,"_5":14884,"_28435":57946,"_3074":58215},[],"The CA or the new signer certificate does not exist, or the CA has no CRL settings, for example because it was imported without its key or its certificate lacks `cRLSign`.",{"_3697":2352,"_31245":2251,"_21577":58217,"_5":14884,"_28435":57946,"_3074":58218},[],"Check the CA ID and the signer serial number.",{"_3697":2353,"_31245":2251,"_21577":58220,"_5":14884,"_28435":57946,"_3074":58221},[],"`PUT` returns 400 from a 3.x client.",{"_3697":2354,"_31245":2251,"_21577":58223,"_5":14884,"_28435":57946,"_3074":58224},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3697":2355,"_31245":2251,"_21577":58226,"_5":14884,"_28435":57946,"_3074":58227},[],"Update the client to send the new field.",{"_3697":2356,"_31245":2251,"_21577":58229,"_5":14884,"_28435":57946,"_3074":58230},[],"The CRL does not change after revoking a certificate.",{"_3697":2357,"_31245":2251,"_21577":58232,"_5":14884,"_28435":57946,"_3074":58233},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3697":2358,"_31245":2251,"_21577":58235,"_5":14884,"_28435":57946,"_3074":58236},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3697":2359,"_31245":2251,"_21577":58238,"_5":14884,"_28435":57946,"_3074":58239},[],"A verifier rejects the CRL because of the issuer.",{"_3697":2360,"_31245":2251,"_21577":58241,"_5":14884,"_28435":57946,"_3074":58242},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3697":2361,"_31245":2251,"_21577":58244,"_5":14884,"_28435":57946,"_3074":58245},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3697":2362,"_31245":2251,"_21577":58247,"_5":14884,"_28435":57950,"_3074":58248},[],"RFC 5280: X.509 and CRL profile.",{"_3697":2363,"_31245":2251,"_21577":58250,"_5":14884,"_28435":57950,"_3074":58251},[],"OpenSSL: openssl-crl.",{"_3697":2364,"_31245":2251,"_21577":58253,"_5":14884,"_28435":57950,"_3074":58254},[],"OpenSSL: openssl-verify.",{"_3697":2365,"_31245":2251,"_21577":58256,"_5":14884,"_28435":57950,"_3074":58257},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3697":2366,"_31245":2251,"_21577":58259,"_5":14884,"_28435":57950,"_3074":58260},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3697":2367,"_31245":2367,"_5":15238,"_3074":58262,"_31570":58263,"_21577":58264,"_28435":2367},"Enrollment protocols",[50948,52489,56713,56714],[],{"_3697":2368,"_31245":2367,"_21577":58266,"_5":14884,"_28435":2367,"_3074":58267},[],"Request and renew certificates from a Lamassu CA.",{"_3697":2369,"_31245":2367,"_21577":58269,"_5":14884,"_28435":2367,"_3074":58270},[],"Lamassu supports EST (Enrollment over Secure Transport), defined in RFC 7030. The DMS applies the enrollment policy and the configured CA issues the certificates.",{"_3697":2370,"_31245":2367,"_21577":58272,"_5":14884,"_28435":2367,"_3074":58273},[],"Core endpoint",{"_3697":2371,"_31245":2367,"_21577":58275,"_5":14884,"_28435":2367,"_3074":51338},[],{"_3697":2372,"_31245":2367,"_21577":58277,"_5":14884,"_28435":2367,"_3074":58278},[],"`GET /cacerts`",{"_3697":2373,"_31245":2367,"_21577":58280,"_5":14884,"_28435":2367,"_3074":58281},[],"Retrieve the CA certificates published by the DMS.",{"_3697":2374,"_31245":2367,"_21577":58283,"_5":14884,"_28435":2367,"_3074":58284},[],"`POST /simpleenroll`",{"_3697":2375,"_31245":2367,"_21577":58286,"_5":14884,"_28435":2367,"_3074":54937},[],{"_3697":2376,"_31245":2367,"_21577":58288,"_5":14884,"_28435":2367,"_3074":58289},[],"`POST /simplereenroll`",{"_3697":2377,"_31245":2367,"_21577":58291,"_5":14884,"_28435":2367,"_3074":58292},[],"Request a successor to an existing certificate.",{"_3697":2378,"_31245":2367,"_21577":58294,"_5":14884,"_28435":2367,"_3074":58295},[],"See EST (RFC 7030) for client setup, authentication, request formats and optional server-side key generation.",{"_3697":2379,"_31245":2379,"_5":15238,"_3074":58297,"_31570":58298,"_21577":58299,"_28435":2379},"Keys and cryptographic engines",[50948,52489,56713,56714],[],{"_3697":2380,"_31245":2379,"_21577":58301,"_5":14884,"_28435":2379,"_3074":58302},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3697":2381,"_31245":2379,"_5":31567,"_21577":58304,"_28435":58305,"_3074":58306},[],"/docs/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3697":2382,"_31245":2379,"_5":31567,"_21577":58308,"_28435":58309,"_3074":58310},[],"/docs/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3697":2383,"_31245":2379,"_5":31567,"_21577":58312,"_28435":58313,"_3074":58314},[],"/docs/platform/pki/key-management#file-system","File System",{"_3697":2384,"_31245":2379,"_5":31567,"_21577":58316,"_28435":58317,"_3074":58318},[],"/docs/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3697":2385,"_31245":2379,"_5":31567,"_21577":58320,"_28435":58321,"_3074":58322},[],"/docs/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3697":2386,"_31245":2379,"_5":31567,"_21577":58324,"_28435":58325,"_3074":58326},[],"/docs/platform/pki/key-management#aws-kms","AWS KMS",{"_3697":2387,"_31245":2379,"_5":31567,"_21577":58328,"_28435":58329,"_3074":58330},[],"/docs/platform/pki/key-management#pkcs11","PKCS#11",{"_3697":2388,"_31245":2379,"_5":31567,"_21577":58332,"_28435":58333,"_3074":58334},[],"/docs/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3697":2389,"_31245":2379,"_5":31567,"_21577":58336,"_28435":58337,"_3074":58338},[],"/docs/platform/pki/key-management#key-inventory","Key inventory",{"_3697":2390,"_31245":2379,"_5":31567,"_21577":58340,"_28435":58341,"_3074":58342},[],"/docs/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3697":2391,"_31245":2379,"_5":31567,"_21577":58344,"_28435":58345,"_3074":58346},[],"/docs/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3697":2392,"_31245":2379,"_5":31567,"_21577":58348,"_28435":58349,"_3074":58350},[],"/docs/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3697":2393,"_31245":2379,"_5":31567,"_21577":58352,"_28435":58353,"_3074":58354},[],"/docs/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3697":2394,"_31245":2379,"_5":31567,"_21577":58356,"_28435":58357,"_3074":58358},[],"/docs/platform/pki/key-management#view-details","View details",{"_3697":2395,"_31245":2379,"_5":31567,"_21577":58360,"_28435":58361,"_3074":58362},[],"/docs/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3697":2396,"_31245":2379,"_5":31567,"_21577":58364,"_28435":58365,"_3074":58366},[],"/docs/platform/pki/key-management#sign","Sign",{"_3697":2397,"_31245":2379,"_5":31567,"_21577":58368,"_28435":58369,"_3074":58370},[],"/docs/platform/pki/key-management#verify","Verify",{"_3697":2398,"_31245":2379,"_5":31567,"_21577":58372,"_28435":58373,"_3074":58374},[],"/docs/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3697":2399,"_31245":2379,"_5":31567,"_21577":58376,"_28435":58377,"_3074":58378},[],"/docs/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3697":2400,"_31245":2379,"_5":31567,"_21577":58380,"_28435":58381,"_3074":58382},[],"/docs/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3697":2401,"_31245":2379,"_21577":58384,"_5":14884,"_28435":2379,"_3074":58385},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3697":2402,"_31245":2379,"_21577":58387,"_5":14884,"_28435":2379,"_3074":58388},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3697":2403,"_31245":2379,"_21577":58390,"_5":14884,"_28435":58305,"_3074":58391},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3697":2404,"_31245":2379,"_21577":58393,"_5":14884,"_28435":58305,"_3074":58394},[],"In practice, it lets you:",{"_3697":2405,"_31245":2379,"_21577":58396,"_5":14884,"_28435":58305,"_3074":58397},[],"Generate new key pairs from Lamassu IoT.",{"_3697":2406,"_31245":2379,"_21577":58399,"_5":14884,"_28435":58305,"_3074":58400},[],"Import keys created externally.",{"_3697":2407,"_31245":2379,"_21577":58402,"_5":14884,"_28435":58305,"_3074":58403},[],"Delegate custody and cryptographic operations to external engines.",{"_3697":2408,"_31245":2379,"_21577":58405,"_5":14884,"_28435":58305,"_3074":58406},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3697":2409,"_31245":2379,"_21577":58408,"_5":14884,"_28435":58309,"_3074":58409},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3697":2410,"_31245":2379,"_21577":58411,"_5":14884,"_28435":58309,"_3074":58412},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3697":2411,"_31245":2379,"_21577":58414,"_5":14884,"_28435":58309,"_3074":58415},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3697":2412,"_31245":2379,"_21577":58417,"_5":14884,"_28435":58313,"_3074":58418},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3697":2413,"_31245":2379,"_21577":58420,"_5":14884,"_28435":58317,"_3074":58421},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3697":2414,"_31245":2379,"_21577":58423,"_5":14884,"_28435":58317,"_3074":58424},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3697":2415,"_31245":2379,"_21577":58426,"_5":14884,"_28435":58321,"_3074":58427},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3697":2416,"_31245":2379,"_21577":58429,"_5":14884,"_28435":58325,"_3074":58430},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3697":2417,"_31245":2379,"_21577":58432,"_5":14884,"_28435":58329,"_3074":58433},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3697":2418,"_31245":2379,"_21577":58435,"_5":14884,"_28435":58333,"_3074":58436},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3697":2419,"_31245":2379,"_21577":58438,"_5":14884,"_28435":58333,"_3074":58439},[],"Lamassu shows the enabled engines in the console.",{"_3697":2420,"_31245":2379,"_21577":58441,"_5":14884,"_28435":58333,"_3074":58442},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3697":2421,"_31245":2379,"_21577":58444,"_5":14884,"_28435":58333,"_3074":58445},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3697":2422,"_31245":2379,"_21577":58447,"_5":14884,"_28435":58337,"_3074":58448},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3697":2423,"_31245":2379,"_21577":58450,"_5":14884,"_28435":58337,"_3074":58451},[],"The table includes the following fields:",{"_3697":2424,"_31245":2379,"_21577":58453,"_5":14884,"_28435":58337,"_3074":58454},[],"**Name**: descriptive name of the key.",{"_3697":2425,"_31245":2379,"_21577":58456,"_5":14884,"_28435":58337,"_3074":58457},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3697":2426,"_31245":2379,"_21577":58459,"_5":14884,"_28435":58337,"_3074":58460},[],"**Strength**: visual indicator of cryptographic strength.",{"_3697":2427,"_31245":2379,"_21577":58462,"_5":14884,"_28435":58337,"_3074":58463},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3697":2428,"_31245":2379,"_21577":58465,"_5":14884,"_28435":58337,"_3074":58466},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3697":2429,"_31245":2379,"_21577":58468,"_5":14884,"_28435":58337,"_3074":58469},[],"**Aliases**: alternative names associated with the key.",{"_3697":2430,"_31245":2379,"_21577":58471,"_5":14884,"_28435":58337,"_3074":58472},[],"**Tags**: labels for classification and search.",{"_3697":2431,"_31245":2379,"_21577":58474,"_5":14884,"_28435":58337,"_3074":58475},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3697":2432,"_31245":2379,"_21577":58477,"_5":14884,"_28435":58337,"_3074":58478},[],"From this view you also reach the most common actions:",{"_3697":2433,"_31245":2379,"_21577":58480,"_5":14884,"_28435":58337,"_3074":58481},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3697":2434,"_31245":2379,"_21577":58483,"_5":14884,"_28435":58337,"_3074":58484},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3697":2435,"_31245":2379,"_21577":58486,"_5":14884,"_28435":58337,"_3074":58487},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3697":2436,"_31245":2379,"_21577":58489,"_5":14884,"_28435":58337,"_3074":58490},[],"**Delete Key** to remove the key from the system.",{"_3697":2437,"_31245":2379,"_21577":58492,"_5":14884,"_28435":58341,"_3074":58493},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3697":2438,"_31245":2379,"_21577":58495,"_5":14884,"_28435":58345,"_3074":58496},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3697":2439,"_31245":2379,"_21577":58498,"_5":14884,"_28435":58345,"_3074":58499},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3697":2440,"_31245":2379,"_21577":58501,"_5":14884,"_28435":58345,"_3074":58502},[],"**Key Name**: unique and descriptive name.",{"_3697":2441,"_31245":2379,"_21577":58504,"_5":14884,"_28435":58345,"_3074":58505},[],"**Crypto Engine**: engine that will keep the key.",{"_3697":2442,"_31245":2379,"_21577":58507,"_5":14884,"_28435":58345,"_3074":58508},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3697":2443,"_31245":2379,"_21577":58510,"_5":14884,"_28435":58345,"_3074":58511},[],"**Tags**: metadata to classify the key.",{"_3697":2444,"_31245":2379,"_21577":58513,"_5":14884,"_28435":58345,"_3074":58514},[],"**Metadata**: additional information for advanced uses.",{"_3697":2445,"_31245":2379,"_21577":58516,"_5":14884,"_28435":58349,"_3074":58517},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3697":2446,"_31245":2379,"_21577":58519,"_5":14884,"_28435":58349,"_3074":58520},[],"When you have an exportable private key and the destination engine supports import.",{"_3697":2447,"_31245":2379,"_21577":58522,"_5":14884,"_28435":58349,"_3074":58523},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3697":2448,"_31245":2379,"_21577":58525,"_5":14884,"_28435":58349,"_3074":58526},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3697":2449,"_31245":2379,"_21577":58528,"_5":14884,"_28435":58349,"_3074":58529},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3697":2450,"_31245":2379,"_21577":58531,"_5":14884,"_28435":58349,"_3074":58532},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3697":2451,"_31245":2379,"_21577":58534,"_5":14884,"_28435":58349,"_3074":58535},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3697":2452,"_31245":2379,"_21577":58537,"_5":14884,"_28435":58349,"_3074":58538},[],"**Tags**: labels for organization and search.",{"_3697":2453,"_31245":2379,"_21577":58540,"_5":14884,"_28435":58349,"_3074":58541},[],"**Metadata**: additional optional information.",{"_3697":2454,"_31245":2379,"_21577":58543,"_5":14884,"_28435":58349,"_3074":58544},[],"**Private Key (PEM)**: private key in PEM format.",{"_3697":2455,"_31245":2379,"_21577":58546,"_5":14884,"_28435":58349,"_3074":58547},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3697":2456,"_31245":2379,"_21577":58549,"_5":14884,"_28435":58353,"_3074":58550},[],"Each registered key has a detail view and several operational actions.",{"_3697":2457,"_31245":2379,"_21577":58552,"_5":14884,"_28435":58357,"_3074":58553},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3697":2458,"_31245":2379,"_21577":58555,"_5":14884,"_28435":58357,"_3074":58556},[],"The **Overview** tab shows, among others, these fields:",{"_3697":2459,"_31245":2379,"_21577":58558,"_5":14884,"_28435":58357,"_3074":58559},[],"**Key Name**: descriptive name.",{"_3697":2460,"_31245":2379,"_21577":58561,"_5":14884,"_28435":58357,"_3074":58562},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3697":2461,"_31245":2379,"_21577":58564,"_5":14884,"_28435":58357,"_3074":58565},[],"**Tags**: associated labels.",{"_3697":2462,"_31245":2379,"_21577":58567,"_5":14884,"_28435":58357,"_3074":58568},[],"**Aliases**: alternative names.",{"_3697":2463,"_31245":2379,"_21577":58570,"_5":14884,"_28435":58357,"_3074":58571},[],"**Crypto Engine**: engine where the key resides.",{"_3697":2464,"_31245":2379,"_21577":58573,"_5":14884,"_28435":58357,"_3074":58574},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3697":2465,"_31245":2379,"_21577":58576,"_5":14884,"_28435":58357,"_3074":58577},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3697":2466,"_31245":2379,"_21577":58579,"_5":14884,"_28435":58357,"_3074":58580},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3697":2467,"_31245":2379,"_21577":58582,"_5":14884,"_28435":58361,"_3074":58583},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3697":2468,"_31245":2379,"_21577":58585,"_5":14884,"_28435":58361,"_3074":58586},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3697":2469,"_31245":2379,"_21577":58588,"_5":14884,"_28435":58361,"_3074":58589},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3697":2470,"_31245":2379,"_21577":58591,"_5":14884,"_28435":58365,"_3074":58592},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3697":2471,"_31245":2379,"_21577":58594,"_5":14884,"_28435":58365,"_3074":58595},[],"Main fields:",{"_3697":2472,"_31245":2379,"_21577":58597,"_5":14884,"_28435":58365,"_3074":58598},[],"**Algorithm**: signing algorithm available for the key type.",{"_3697":2473,"_31245":2379,"_21577":58600,"_5":14884,"_28435":58365,"_3074":58601},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3697":2474,"_31245":2379,"_21577":58603,"_5":14884,"_28435":58365,"_3074":58604},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3697":2475,"_31245":2379,"_21577":58606,"_5":14884,"_28435":58365,"_3074":58607},[],"**Message**: content to sign.",{"_3697":2476,"_31245":2379,"_21577":58609,"_5":14884,"_28435":58365,"_3074":58610},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3697":2477,"_31245":2379,"_21577":58612,"_5":14884,"_28435":58369,"_3074":58613},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3697":2478,"_31245":2379,"_21577":58615,"_5":14884,"_28435":58369,"_3074":58595},[],{"_3697":2479,"_31245":2379,"_21577":58617,"_5":14884,"_28435":58369,"_3074":58618},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3697":2480,"_31245":2379,"_21577":58620,"_5":14884,"_28435":58369,"_3074":58621},[],"**Message Type**: `Raw` or `Digest`.",{"_3697":2481,"_31245":2379,"_21577":58623,"_5":14884,"_28435":58369,"_3074":58624},[],"**Payload Encoding**: encoding of the message.",{"_3697":2482,"_31245":2379,"_21577":58626,"_5":14884,"_28435":58369,"_3074":58627},[],"**Message**: original message or hash.",{"_3697":2483,"_31245":2379,"_21577":58629,"_5":14884,"_28435":58369,"_3074":58630},[],"**Signature**: signature to check.",{"_3697":2484,"_31245":2379,"_21577":58632,"_5":14884,"_28435":58369,"_3074":58633},[],"**Result**: indicator of the validation result.",{"_3697":2485,"_31245":2379,"_21577":58635,"_5":14884,"_28435":58373,"_3074":58636},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3697":2486,"_31245":2379,"_21577":58638,"_5":14884,"_28435":58373,"_3074":58639},[],"This flow is useful for:",{"_3697":2487,"_31245":2379,"_21577":58641,"_5":14884,"_28435":58373,"_3074":58642},[],"Requesting certificates from an external CA.",{"_3697":2488,"_31245":2379,"_21577":58644,"_5":14884,"_28435":58373,"_3074":58645},[],"Renewing an identity while keeping the same key.",{"_3697":2489,"_31245":2379,"_21577":58647,"_5":14884,"_28435":58373,"_3074":58648},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3697":2490,"_31245":2379,"_21577":58650,"_5":14884,"_28435":58373,"_3074":58651},[],"**Common Name (CN)**: main name of the identity.",{"_3697":2491,"_31245":2379,"_21577":58653,"_5":14884,"_28435":58373,"_3074":58654},[],"**Organization (O)**: organization or company.",{"_3697":2492,"_31245":2379,"_21577":58656,"_5":14884,"_28435":58373,"_3074":58657},[],"**Organizational Unit (OU)**: department or unit.",{"_3697":2493,"_31245":2379,"_21577":58659,"_5":14884,"_28435":58373,"_3074":58660},[],"**Country (C)**: two-letter country code.",{"_3697":2494,"_31245":2379,"_21577":58662,"_5":14884,"_28435":58373,"_3074":58663},[],"**State / Province (ST)**: state or province.",{"_3697":2495,"_31245":2379,"_21577":58665,"_5":14884,"_28435":58373,"_3074":58666},[],"**Locality (L)**: city or locality.",{"_3697":2496,"_31245":2379,"_21577":58668,"_5":14884,"_28435":58373,"_3074":58669},[],"**Email Address**: contact email.",{"_3697":2497,"_31245":2379,"_21577":58671,"_5":14884,"_28435":58373,"_3074":58672},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3697":2498,"_31245":2379,"_21577":58674,"_5":14884,"_28435":58373,"_3074":58675},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3697":2499,"_31245":2379,"_21577":58677,"_5":14884,"_28435":58377,"_3074":58678},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3697":2500,"_31245":2379,"_21577":58680,"_5":14884,"_28435":58377,"_3074":58681},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3697":2501,"_31245":2379,"_21577":58683,"_5":14884,"_28435":58381,"_3074":58684},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3697":2502,"_31245":2379,"_21577":58686,"_5":14884,"_28435":58381,"_3074":58687},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. The KMS also refuses to delete a key that signs the CRL of a CA whose CRL settings are still `ACTIVE`, with the same `409` `key is in use`; that reference is released when the settings are finalized, after the CA is revoked permanently or expires (see CRL). Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3697":2503,"_31245":2503,"_5":15238,"_3074":58689,"_31570":58690,"_21577":58691,"_28435":2503},"Online validation with OCSP",[50948,52489,56713,57386],[],{"_3697":2504,"_31245":2503,"_21577":58693,"_5":14884,"_28435":2503,"_3074":58694},[],"Query signed status and verify the responder’s response.",{"_3697":2505,"_31245":2503,"_5":31567,"_21577":58696,"_28435":58697,"_3074":58698},[],"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3697":2506,"_31245":2503,"_5":31567,"_21577":58700,"_28435":58701,"_3074":58702},[],"/docs/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3697":2507,"_31245":2503,"_5":31567,"_21577":58704,"_28435":58705,"_3074":58706},[],"/docs/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3697":2508,"_31245":2503,"_5":31567,"_21577":58708,"_28435":58709,"_3074":58710},[],"/docs/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3697":2509,"_31245":2503,"_5":31567,"_21577":58712,"_28435":58713,"_3074":58714},[],"/docs/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3697":2510,"_31245":2503,"_5":31567,"_21577":58716,"_28435":58717,"_3074":57951},[],"/docs/platform/pki/ocsp#references",{"_3697":2511,"_31245":2503,"_21577":58719,"_5":14884,"_28435":2503,"_3074":58720},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3697":2512,"_31245":2503,"_21577":58722,"_5":14884,"_28435":58697,"_3074":58723},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3697":2513,"_31245":2503,"_21577":58725,"_5":14884,"_28435":58697,"_3074":58726},[],"Record status",{"_3697":2514,"_31245":2503,"_21577":58728,"_5":14884,"_28435":58697,"_3074":58729},[],"Signed response",{"_3697":2515,"_31245":2503,"_21577":58731,"_5":14884,"_28435":58697,"_3074":55849},[],{"_3697":2516,"_31245":2503,"_21577":58733,"_5":14884,"_28435":58697,"_3074":58734},[],"`Good`.",{"_3697":2517,"_31245":2503,"_21577":58736,"_5":14884,"_28435":58697,"_3074":55866},[],{"_3697":2518,"_31245":2503,"_21577":58738,"_5":14884,"_28435":58697,"_3074":58739},[],"`Revoked`, with revocation reason and timestamp.",{"_3697":2519,"_31245":2503,"_21577":58741,"_5":14884,"_28435":58697,"_3074":58742},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3697":2520,"_31245":2503,"_21577":58744,"_5":14884,"_28435":58697,"_3074":58745},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3697":2521,"_31245":2503,"_21577":58747,"_5":14884,"_28435":58697,"_3074":58748},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3697":2522,"_31245":2503,"_21577":58750,"_5":14884,"_28435":58697,"_3074":58751},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3697":2523,"_31245":2503,"_21577":58753,"_5":14884,"_28435":58697,"_3074":58754},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3697":2524,"_31245":2503,"_21577":58756,"_5":14884,"_28435":58701,"_3074":58757},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3697":2525,"_31245":2503,"_21577":58759,"_5":14884,"_28435":58701,"_3074":58760},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3697":2526,"_31245":2503,"_21577":58762,"_5":14884,"_28435":58705,"_3074":58763},[],"The service accepts:",{"_3697":2527,"_31245":2503,"_21577":58765,"_5":14884,"_28435":58705,"_3074":54298},[],{"_3697":2528,"_31245":2503,"_21577":58767,"_5":14884,"_28435":58705,"_3074":58768},[],"VA service path",{"_3697":2529,"_31245":2503,"_21577":58770,"_5":14884,"_28435":58705,"_3074":58771},[],"Format",{"_3697":2530,"_31245":2503,"_21577":58773,"_5":14884,"_28435":58705,"_3074":58774},[],"`POST`",{"_3697":2531,"_31245":2503,"_21577":58776,"_5":14884,"_28435":58705,"_3074":58777},[],"`/ocsp`",{"_3697":2532,"_31245":2503,"_21577":58779,"_5":14884,"_28435":58705,"_3074":58780},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3697":2533,"_31245":2503,"_21577":58782,"_5":14884,"_28435":58705,"_3074":58134},[],{"_3697":2534,"_31245":2503,"_21577":58784,"_5":14884,"_28435":58705,"_3074":58785},[],"`/ocsp/{ocsp_request}`",{"_3697":2535,"_31245":2503,"_21577":58787,"_5":14884,"_28435":58705,"_3074":58788},[],"DER request encoded using padded URL Base64.",{"_3697":2536,"_31245":2503,"_21577":58790,"_5":14884,"_28435":58705,"_3074":58791},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3697":2537,"_31245":2503,"_21577":58793,"_5":14884,"_28435":58709,"_3074":58794},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3697":2538,"_31245":2503,"_21577":58796,"_5":14884,"_28435":58709,"_3074":58797},[],"Generate the request:",{"_3697":2539,"_31245":2503,"_21577":58799,"_5":14884,"_28435":58709,"_3074":58800},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3697":2540,"_31245":2503,"_21577":58802,"_5":14884,"_28435":58709,"_3074":58803},[],"Replace the example URL with the inspected endpoint:",{"_3697":2541,"_31245":2503,"_21577":58805,"_5":14884,"_28435":58709,"_3074":58806},[],"Verify the returned DER:",{"_3697":2542,"_31245":2503,"_21577":58808,"_5":14884,"_28435":58709,"_3074":58809},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3697":2543,"_31245":2503,"_21577":58811,"_5":14884,"_28435":58713,"_3074":58812},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3697":2544,"_31245":2503,"_21577":58814,"_5":14884,"_28435":58713,"_3074":58815},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3697":2545,"_31245":2503,"_21577":58817,"_5":14884,"_28435":58717,"_3074":58818},[],"RFC 6960: OCSP.",{"_3697":2546,"_31245":2503,"_21577":58820,"_5":14884,"_28435":58717,"_3074":58821},[],"OpenSSL: openssl-ocsp.",{"_3697":2547,"_31245":2503,"_21577":58823,"_5":14884,"_28435":58717,"_3074":58824},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3697":2548,"_31245":2503,"_21577":58826,"_5":14884,"_28435":58717,"_3074":58260},[],{"_3697":2549,"_31245":2549,"_5":15238,"_3074":56713,"_31570":58828,"_21577":58829,"_28435":2549},[50948,52489,56713],[],{"_3697":2550,"_31245":2549,"_21577":58831,"_5":14884,"_28435":2549,"_3074":58832},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3697":2551,"_31245":2549,"_5":31567,"_21577":58834,"_28435":58835,"_3074":56024},[],"/docs/platform/pki/overview#start-here",{"_3697":2552,"_31245":2549,"_5":31567,"_21577":58837,"_28435":58838,"_3074":58839},[],"/docs/platform/pki/overview#what-you-need","What you need",{"_3697":2553,"_31245":2549,"_5":31567,"_21577":58841,"_28435":58842,"_3074":56557},[],"/docs/platform/pki/overview#core-capabilities",{"_3697":2554,"_31245":2549,"_5":31567,"_21577":58844,"_28435":58845,"_3074":56561},[],"/docs/platform/pki/overview#build-your-trust-hierarchy",{"_3697":2555,"_31245":2549,"_5":31567,"_21577":58847,"_28435":58848,"_3074":56565},[],"/docs/platform/pki/overview#protect-cryptographic-keys",{"_3697":2556,"_31245":2549,"_5":31567,"_21577":58850,"_28435":58851,"_3074":56569},[],"/docs/platform/pki/overview#issue-and-control-certificates",{"_3697":2557,"_31245":2549,"_5":31567,"_21577":58853,"_28435":58854,"_3074":56577},[],"/docs/platform/pki/overview#publish-validation-status",{"_3697":2558,"_31245":2549,"_5":31567,"_21577":58856,"_28435":58857,"_3074":58858},[],"/docs/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3697":2559,"_31245":2549,"_5":31567,"_21577":58860,"_28435":58861,"_3074":57553},[],"/docs/platform/pki/overview#continue",{"_3697":2560,"_31245":2549,"_21577":58863,"_5":14884,"_28435":2549,"_3074":58864},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3697":2561,"_31245":2549,"_21577":58866,"_5":14884,"_28435":58835,"_3074":58867},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3697":2562,"_31245":2549,"_21577":58869,"_5":14884,"_28435":58835,"_3074":58870},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3697":2563,"_31245":2549,"_21577":58872,"_5":14884,"_28435":58838,"_3074":58873},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3697":2564,"_31245":2549,"_21577":58875,"_5":14884,"_28435":58838,"_3074":58876},[],"An available cryptographic engine to keep the authority's key.",{"_3697":2565,"_31245":2549,"_21577":58878,"_5":14884,"_28435":58838,"_3074":58879},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3697":2566,"_31245":2549,"_21577":58881,"_5":14884,"_28435":58838,"_3074":58882},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3697":2567,"_31245":2549,"_21577":58884,"_5":14884,"_28435":58838,"_3074":58885},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3697":2568,"_31245":2549,"_21577":58887,"_5":14884,"_28435":58845,"_3074":58888},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3697":2569,"_31245":2549,"_21577":58890,"_5":14884,"_28435":58848,"_3074":58891},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3697":2570,"_31245":2549,"_21577":58893,"_5":14884,"_28435":58851,"_3074":58894},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3697":2571,"_31245":2549,"_21577":58896,"_5":14884,"_28435":58851,"_3074":58897},[],"Enrollment protocols let clients obtain and renew certificates from a Lamassu CA.",{"_3697":2572,"_31245":2549,"_21577":58899,"_5":14884,"_28435":58854,"_3074":58900},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3697":2573,"_31245":2549,"_21577":58902,"_5":14884,"_28435":58857,"_3074":58903},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3697":2574,"_31245":2549,"_21577":58905,"_5":14884,"_28435":58857,"_3074":58906},[],"its subject and extensions identify the expected client;",{"_3697":2575,"_31245":2549,"_21577":58908,"_5":14884,"_28435":58857,"_3074":58909},[],"its public key matches the client's private key;",{"_3697":2576,"_31245":2549,"_21577":58911,"_5":14884,"_28435":58857,"_3074":58912},[],"its chain reaches a root trusted by the consumer;",{"_3697":2577,"_31245":2549,"_21577":58914,"_5":14884,"_28435":58857,"_3074":58915},[],"its dates and usages allow the operation;",{"_3697":2578,"_31245":2549,"_21577":58917,"_5":14884,"_28435":58857,"_3074":58918},[],"the consumer applies revocation checks and authorization.",{"_3697":2579,"_31245":2549,"_21577":58920,"_5":14884,"_28435":58857,"_3074":58921},[],"The issuance path includes the first independent checks.",{"_3697":2580,"_31245":2549,"_21577":58923,"_5":14884,"_28435":58861,"_3074":58924},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3697":2581,"_31245":2549,"_21577":58926,"_5":14884,"_28435":58861,"_3074":58927},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3697":2582,"_31245":2549,"_21577":58929,"_5":14884,"_28435":58861,"_3074":58930},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3697":2583,"_31245":2583,"_5":15238,"_3074":58932,"_31570":58933,"_21577":58934,"_28435":2583},"Create your first CA",[50948,52489,56713,56149],[],{"_3697":2584,"_31245":2583,"_21577":58936,"_5":14884,"_28435":2583,"_3074":58937},[],"Create an evaluation root and check its certificate before issuing.",{"_3697":2585,"_31245":2583,"_5":31567,"_21577":58939,"_28435":58940,"_3074":50958},[],"/docs/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3697":2586,"_31245":2583,"_5":31567,"_21577":58942,"_28435":58943,"_3074":58944},[],"/docs/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3697":2587,"_31245":2583,"_5":31567,"_21577":58946,"_28435":58947,"_3074":58948},[],"/docs/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3697":2588,"_31245":2583,"_5":31567,"_21577":58950,"_28435":58951,"_3074":58952},[],"/docs/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3697":2589,"_31245":2583,"_5":31567,"_21577":58954,"_28435":58955,"_3074":58956},[],"/docs/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3697":2590,"_31245":2583,"_5":31567,"_21577":58958,"_28435":58959,"_3074":58960},[],"/docs/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3697":2591,"_31245":2583,"_5":31567,"_21577":58962,"_28435":58963,"_3074":58964},[],"/docs/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3697":2592,"_31245":2583,"_5":31567,"_21577":58966,"_28435":58967,"_3074":56407},[],"/docs/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3697":2593,"_31245":2583,"_5":31567,"_21577":58969,"_28435":58970,"_3074":50982},[],"/docs/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3697":2594,"_31245":2583,"_21577":58972,"_5":14884,"_28435":2583,"_3074":58973},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3697":2595,"_31245":2583,"_21577":58975,"_5":14884,"_28435":58940,"_3074":58976},[],"Console access and permission to create keys and authorities.",{"_3697":2596,"_31245":2583,"_21577":58978,"_5":14884,"_28435":58940,"_3074":58979},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3697":2597,"_31245":2583,"_21577":58981,"_5":14884,"_28435":58940,"_3074":58982},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3697":2598,"_31245":2583,"_21577":58984,"_5":14884,"_28435":58940,"_3074":58985},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3697":2599,"_31245":2583,"_21577":58987,"_5":14884,"_28435":58943,"_3074":58988},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3697":2600,"_31245":2583,"_21577":58990,"_5":14884,"_28435":58943,"_3074":58991},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3697":2601,"_31245":2583,"_21577":58993,"_5":14884,"_28435":58947,"_3074":58994},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3697":2602,"_31245":2583,"_21577":58996,"_5":14884,"_28435":58947,"_3074":58997},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3697":2603,"_31245":2583,"_21577":58999,"_5":14884,"_28435":58951,"_3074":59000},[],"Select **Root CA** and complete:",{"_3697":2604,"_31245":2583,"_21577":59002,"_5":14884,"_28435":58951,"_3074":59003},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3697":2605,"_31245":2583,"_21577":59005,"_5":14884,"_28435":58951,"_3074":59006},[],"**Subject**: organization and country details for your evaluation.",{"_3697":2606,"_31245":2583,"_21577":59008,"_5":14884,"_28435":58951,"_3074":59009},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3697":2607,"_31245":2583,"_21577":59011,"_5":14884,"_28435":58951,"_3074":59012},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3697":2608,"_31245":2583,"_21577":59014,"_5":14884,"_28435":58951,"_3074":59015},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3697":2609,"_31245":2583,"_21577":59017,"_5":14884,"_28435":58955,"_3074":59018},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3697":2610,"_31245":2583,"_21577":59020,"_5":14884,"_28435":58959,"_3074":59021},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3697":2611,"_31245":2583,"_21577":59023,"_5":14884,"_28435":58959,"_3074":59024},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3697":2612,"_31245":2583,"_21577":59026,"_5":14884,"_28435":58963,"_3074":59027},[],"Run from the directory where you saved `ca.pem`:",{"_3697":2613,"_31245":2583,"_21577":59029,"_5":14884,"_28435":58963,"_3074":59030},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3697":2614,"_31245":2583,"_21577":59032,"_5":14884,"_28435":58963,"_3074":59033},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3697":2615,"_31245":2583,"_21577":59035,"_5":14884,"_28435":58967,"_3074":59036},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3697":2616,"_31245":2583,"_21577":59038,"_5":14884,"_28435":58967,"_3074":59039},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3697":2617,"_31245":2583,"_21577":59041,"_5":14884,"_28435":58967,"_3074":59042},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3697":2618,"_31245":2583,"_21577":59044,"_5":14884,"_28435":58967,"_3074":59045},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3697":2619,"_31245":2583,"_21577":59047,"_5":14884,"_28435":58970,"_3074":59048},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3697":2620,"_31245":2620,"_5":15238,"_3074":59050,"_31570":59051,"_21577":59052,"_28435":2620},"Issue and verify a certificate",[50948,52489,56713,56149],[],{"_3697":2621,"_31245":2620,"_21577":59054,"_5":14884,"_28435":2620,"_3074":59055},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3697":2622,"_31245":2620,"_5":31567,"_21577":59057,"_28435":59058,"_3074":50958},[],"/docs/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3697":2623,"_31245":2620,"_5":31567,"_21577":59060,"_28435":59061,"_3074":59062},[],"/docs/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3697":2624,"_31245":2620,"_5":31567,"_21577":59064,"_28435":59065,"_3074":59066},[],"/docs/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3697":2625,"_31245":2620,"_5":31567,"_21577":59068,"_28435":59069,"_3074":59070},[],"/docs/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3697":2626,"_31245":2620,"_5":31567,"_21577":59072,"_28435":59073,"_3074":59074},[],"/docs/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3697":2627,"_31245":2620,"_5":31567,"_21577":59076,"_28435":59077,"_3074":59078},[],"/docs/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3697":2628,"_31245":2620,"_5":31567,"_21577":59080,"_28435":59081,"_3074":59082},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3697":2629,"_31245":2620,"_5":31567,"_21577":59084,"_28435":59085,"_3074":59086},[],"/docs/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3697":2630,"_31245":2620,"_5":31567,"_21577":59088,"_28435":59089,"_3074":59090},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3697":2631,"_31245":2620,"_5":31567,"_21577":59092,"_28435":59093,"_3074":59094},[],"/docs/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3697":2632,"_31245":2620,"_5":31567,"_21577":59096,"_28435":59097,"_3074":56407},[],"/docs/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3697":2633,"_31245":2620,"_5":31567,"_21577":59099,"_28435":59100,"_3074":50982},[],"/docs/platform/pki/quickstarts/issue-certificate#next-step",{"_3697":2634,"_31245":2620,"_21577":59102,"_5":14884,"_28435":2620,"_3074":59103},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3697":2635,"_31245":2620,"_21577":59105,"_5":14884,"_28435":59058,"_3074":59106},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3697":2636,"_31245":2620,"_21577":59108,"_5":14884,"_28435":59058,"_3074":59109},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3697":2637,"_31245":2620,"_21577":59111,"_5":14884,"_28435":59058,"_3074":59112},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3697":2638,"_31245":2620,"_21577":59114,"_5":14884,"_28435":59058,"_3074":59115},[],"A client identifier: here we use `device-001`.",{"_3697":2639,"_31245":2620,"_21577":59117,"_5":14884,"_28435":59058,"_3074":59118},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3697":2640,"_31245":2620,"_21577":59120,"_5":14884,"_28435":59061,"_3074":59121},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3697":2641,"_31245":2620,"_21577":59123,"_5":14884,"_28435":59065,"_3074":59124},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3697":2642,"_31245":2620,"_21577":59126,"_5":14884,"_28435":59065,"_3074":59127},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3697":2643,"_31245":2620,"_21577":59129,"_5":14884,"_28435":59069,"_3074":59130},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3697":2644,"_31245":2620,"_21577":59132,"_5":14884,"_28435":59069,"_3074":59133},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3697":2645,"_31245":2620,"_21577":59135,"_5":14884,"_28435":59073,"_3074":59136},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3697":2646,"_31245":2620,"_21577":59138,"_5":14884,"_28435":59073,"_3074":59139},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3697":2647,"_31245":2620,"_21577":59141,"_5":14884,"_28435":59077,"_3074":59142},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3697":2648,"_31245":2620,"_21577":59144,"_5":14884,"_28435":59081,"_3074":59145},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3697":2649,"_31245":2620,"_21577":59147,"_5":14884,"_28435":59085,"_3074":59148},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3697":2650,"_31245":2620,"_21577":59150,"_5":14884,"_28435":59089,"_3074":59151},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3697":2651,"_31245":2620,"_21577":59153,"_5":14884,"_28435":59089,"_3074":59154},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3697":2652,"_31245":2620,"_21577":59156,"_5":14884,"_28435":59089,"_3074":59157},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3697":2653,"_31245":2620,"_21577":59159,"_5":14884,"_28435":59093,"_3074":59160},[],"In Bash, compare the two public-key digests:",{"_3697":2654,"_31245":2620,"_21577":59162,"_5":14884,"_28435":59093,"_3074":59163},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3697":2655,"_31245":2620,"_21577":59165,"_5":14884,"_28435":59093,"_3074":59166},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3697":2656,"_31245":2620,"_21577":59168,"_5":14884,"_28435":59097,"_3074":56491},[],{"_3697":2657,"_31245":2620,"_21577":59170,"_5":14884,"_28435":59097,"_3074":59171},[],"What to review",{"_3697":2658,"_31245":2620,"_21577":59173,"_5":14884,"_28435":59097,"_3074":59174},[],"The CA rejects issuance",{"_3697":2659,"_31245":2620,"_21577":59176,"_5":14884,"_28435":59097,"_3074":59177},[],"Permissions, CA state and key, algorithm and profile.",{"_3697":2660,"_31245":2620,"_21577":59179,"_5":14884,"_28435":59097,"_3074":59180},[],"Different subject or usages",{"_3697":2661,"_31245":2620,"_21577":59182,"_5":14884,"_28435":59097,"_3074":59183},[],"Applied profile and requested values.",{"_3697":2662,"_31245":2620,"_21577":59185,"_5":14884,"_28435":59097,"_3074":59186},[],"Issuer cannot be found",{"_3697":2663,"_31245":2620,"_21577":59188,"_5":14884,"_28435":59097,"_3074":59189},[],"Downloaded CA and required intermediate chain.",{"_3697":2664,"_31245":2620,"_21577":59191,"_5":14884,"_28435":59097,"_3074":59192},[],"Validity fails",{"_3697":2665,"_31245":2620,"_21577":59194,"_5":14884,"_28435":59097,"_3074":59195},[],"Certificate and CA dates, and the computer's clock.",{"_3697":2666,"_31245":2620,"_21577":59197,"_5":14884,"_28435":59097,"_3074":59198},[],"Public-key digests differ",{"_3697":2667,"_31245":2620,"_21577":59200,"_5":14884,"_28435":59097,"_3074":59201},[],"Certificate and key files from the same issuance.",{"_3697":2668,"_31245":2620,"_21577":59203,"_5":14884,"_28435":59097,"_3074":59204},[],"See PKI diagnostics to narrow an issuance failure.",{"_3697":2669,"_31245":2620,"_21577":59206,"_5":14884,"_28435":59100,"_3074":59207},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3697":2670,"_31245":2620,"_21577":59209,"_5":14884,"_28435":59100,"_3074":59210},[],"Manage certificates for inspection, status and revocation.",{"_3697":2671,"_31245":2620,"_21577":59212,"_5":14884,"_28435":59100,"_3074":59213},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3697":2672,"_31245":2620,"_21577":59215,"_5":14884,"_28435":59100,"_3074":59216},[],"Prepare EST for the device to request its next identities.",{"_3697":2673,"_31245":2620,"_21577":59218,"_5":14884,"_28435":59100,"_3074":59219},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3697":2674,"_31245":2674,"_5":15238,"_3074":59221,"_31570":59222,"_21577":59223,"_28435":2674},"PKI getting started",[50948,52489,56713,56149],[],{"_3697":2675,"_31245":2674,"_21577":59225,"_5":14884,"_28435":2674,"_3074":59226},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3697":2676,"_31245":2674,"_5":31567,"_21577":59228,"_28435":59229,"_3074":50958},[],"/docs/platform/pki/quickstarts/overview#before-you-begin",{"_3697":2677,"_31245":2674,"_5":31567,"_21577":59231,"_28435":59232,"_3074":59233},[],"/docs/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3697":2678,"_31245":2674,"_5":31567,"_21577":59235,"_28435":59236,"_3074":56342},[],"/docs/platform/pki/quickstarts/overview#expected-result",{"_3697":2679,"_31245":2674,"_5":31567,"_21577":59238,"_28435":59239,"_3074":59240},[],"/docs/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3697":2680,"_31245":2674,"_21577":59242,"_5":14884,"_28435":2674,"_3074":59243},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3697":2681,"_31245":2674,"_21577":59245,"_5":14884,"_28435":59229,"_3074":59246},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3697":2682,"_31245":2674,"_21577":59248,"_5":14884,"_28435":59229,"_3074":59249},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3697":2683,"_31245":2674,"_21577":59251,"_5":14884,"_28435":59229,"_3074":59252},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3697":2684,"_31245":2674,"_21577":59254,"_5":14884,"_28435":59229,"_3074":59255},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3697":2685,"_31245":2674,"_21577":59257,"_5":14884,"_28435":59229,"_3074":59258},[],"A working directory with restricted access for the downloaded key.",{"_3697":2686,"_31245":2674,"_21577":59260,"_5":14884,"_28435":59232,"_3074":59261},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3697":2687,"_31245":2674,"_21577":59263,"_5":14884,"_28435":59232,"_3074":59264},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3697":2688,"_31245":2674,"_21577":59266,"_5":14884,"_28435":59232,"_3074":59267},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3697":2689,"_31245":2674,"_21577":59269,"_5":14884,"_28435":59232,"_3074":59270},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3697":2690,"_31245":2674,"_21577":59272,"_5":14884,"_28435":59236,"_3074":59273},[],"File or resource",{"_3697":2691,"_31245":2674,"_21577":59275,"_5":14884,"_28435":59236,"_3074":56339},[],{"_3697":2692,"_31245":2674,"_21577":59277,"_5":14884,"_28435":59236,"_3074":59278},[],"Active root CA and `ca.pem`",{"_3697":2693,"_31245":2674,"_21577":59280,"_5":14884,"_28435":59236,"_3074":59281},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3697":2694,"_31245":2674,"_21577":59283,"_5":14884,"_28435":59236,"_3074":59284},[],"End-entity certificate and `device.crt`",{"_3697":2695,"_31245":2674,"_21577":59286,"_5":14884,"_28435":59236,"_3074":59287},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3697":2696,"_31245":2674,"_21577":59289,"_5":14884,"_28435":59236,"_3074":59290},[],"Private key `device.key`",{"_3697":2697,"_31245":2674,"_21577":59292,"_5":14884,"_28435":59236,"_3074":59293},[],"Its public key matches the one included in `device.crt`.",{"_3697":2698,"_31245":2674,"_21577":59295,"_5":14884,"_28435":59236,"_3074":59296},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3697":2699,"_31245":2674,"_21577":59298,"_5":14884,"_28435":59239,"_3074":59299},[],"To operate certificates, continue with Certificates and Validation.",{"_3697":2700,"_31245":2674,"_21577":59301,"_5":14884,"_28435":59239,"_3074":59302},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3697":2701,"_31245":2674,"_21577":59304,"_5":14884,"_28435":59239,"_3074":59305},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3697":2702,"_31245":2702,"_5":15238,"_3074":59307,"_31570":59308,"_21577":59309,"_28435":2702},"PKI troubleshooting",[50948,52489,56713,55288],[],{"_3697":2703,"_31245":2702,"_21577":59311,"_5":14884,"_28435":2702,"_3074":59312},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3697":2704,"_31245":2702,"_5":31567,"_21577":59314,"_28435":59315,"_3074":59316},[],"/docs/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3697":2705,"_31245":2702,"_5":31567,"_21577":59318,"_28435":59319,"_3074":59320},[],"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3697":2706,"_31245":2702,"_5":31567,"_21577":59322,"_28435":59323,"_3074":59324},[],"/docs/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3697":2707,"_31245":2702,"_21577":59326,"_5":14884,"_28435":2702,"_3074":59327},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3697":2708,"_31245":2702,"_21577":59329,"_5":14884,"_28435":2702,"_3074":59330},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3697":2709,"_31245":2702,"_21577":59332,"_5":14884,"_28435":59315,"_3074":56339},[],{"_3697":2710,"_31245":2702,"_21577":59334,"_5":14884,"_28435":59315,"_3074":59335},[],"What to inspect",{"_3697":2711,"_31245":2702,"_21577":59337,"_5":14884,"_28435":59315,"_3074":50982},[],{"_3697":2712,"_31245":2702,"_21577":59339,"_5":14884,"_28435":59315,"_3074":55554},[],{"_3697":2713,"_31245":2702,"_21577":59341,"_5":14884,"_28435":59315,"_3074":59342},[],"Exists, is active and has usable dates.",{"_3697":2714,"_31245":2702,"_21577":59344,"_5":14884,"_28435":59315,"_3074":59345},[],"Authorities.",{"_3697":2715,"_31245":2702,"_21577":59347,"_5":14884,"_28435":59315,"_3074":59348},[],"Key",{"_3697":2716,"_31245":2702,"_21577":59350,"_5":14884,"_28435":59315,"_3074":59351},[],"The record has a usable private key and the engine can sign.",{"_3697":2717,"_31245":2702,"_21577":59353,"_5":14884,"_28435":59315,"_3074":59354},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3697":2718,"_31245":2702,"_21577":59356,"_5":14884,"_28435":59315,"_3074":59357},[],"CSR",{"_3697":2719,"_31245":2702,"_21577":59359,"_5":14884,"_28435":59315,"_3074":59360},[],"Correct PEM and verifiable signature.",{"_3697":2720,"_31245":2702,"_21577":59362,"_5":14884,"_28435":59315,"_3074":59363},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3697":2721,"_31245":2702,"_21577":59365,"_5":14884,"_28435":59315,"_3074":59366},[],"Profile",{"_3697":2722,"_31245":2702,"_21577":59368,"_5":14884,"_28435":59315,"_3074":59369},[],"Selected source, existing ID, allowed algorithm and size.",{"_3697":2723,"_31245":2702,"_21577":59371,"_5":14884,"_28435":59315,"_3074":59372},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3697":2724,"_31245":2702,"_21577":59374,"_5":14884,"_28435":59315,"_3074":56491},[],{"_3697":2725,"_31245":2702,"_21577":59376,"_5":14884,"_28435":59315,"_3074":59377},[],"Appropriate subject, SAN, usages and dates.",{"_3697":2726,"_31245":2702,"_21577":59379,"_5":14884,"_28435":59315,"_3074":59380},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3697":2727,"_31245":2702,"_21577":59382,"_5":14884,"_28435":59315,"_3074":59383},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3697":2728,"_31245":2702,"_21577":59385,"_5":14884,"_28435":59315,"_3074":59386},[],"If issuance fails with `400` and `CA Status inconsistent`, the issuing CA is not `ACTIVE` or is outside the validity period of its certificate. The stored status can lag behind the dates until the expiration monitor runs, so check the dates too. Reissue the CA while it is still valid, or issue from another CA.",{"_3697":2729,"_31245":2702,"_21577":59388,"_5":14884,"_28435":59315,"_3074":59389},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. For a subordinate CA, also check the status and dates of its parent. To change its key, use Hierarchy and rotation.",{"_3697":2730,"_31245":2702,"_21577":59391,"_5":14884,"_28435":59319,"_3074":59392},[],"Check each boundary independently:",{"_3697":2731,"_31245":2702,"_21577":59394,"_5":14884,"_28435":59319,"_3074":59395},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3697":2732,"_31245":2702,"_21577":59397,"_5":14884,"_28435":59319,"_3074":59398},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3697":2733,"_31245":2702,"_21577":59400,"_5":14884,"_28435":59319,"_3074":59401},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3697":2734,"_31245":2702,"_21577":59403,"_5":14884,"_28435":59319,"_3074":59404},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3697":2735,"_31245":2702,"_21577":59406,"_5":14884,"_28435":59319,"_3074":59407},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3697":2736,"_31245":2702,"_21577":59409,"_5":14884,"_28435":59319,"_3074":59410},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. A hold cascaded from a CA is lifted by releasing that CA; a cascade from a CA revoked for good is not. Inspect every status and individual operation failure.",{"_3697":2737,"_31245":2702,"_21577":59412,"_5":14884,"_28435":59323,"_3074":59413},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3697":2738,"_31245":2702,"_21577":59415,"_5":14884,"_28435":59323,"_3074":59416},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3697":2739,"_31245":2739,"_5":15238,"_3074":59418,"_31570":59419,"_21577":59420,"_28435":2739},"Security",[50948],[],{"_3697":2740,"_31245":2739,"_21577":59422,"_5":14884,"_28435":2739,"_3074":59423},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3697":2741,"_31245":2739,"_5":31567,"_21577":59425,"_28435":59426,"_3074":59427},[],"/docs/security#report-a-vulnerability","Report a vulnerability",{"_3697":2742,"_31245":2739,"_5":31567,"_21577":59429,"_28435":59430,"_3074":59431},[],"/docs/security#what-to-include-in-a-report","What to include in a report",{"_3697":2743,"_31245":2739,"_5":31567,"_21577":59433,"_28435":59434,"_3074":59435},[],"/docs/security#supported-versions","Supported versions",{"_3697":2744,"_31245":2739,"_5":31567,"_21577":59437,"_28435":59438,"_3074":59439},[],"/docs/security#responsible-disclosure","Responsible disclosure",{"_3697":2745,"_31245":2739,"_21577":59441,"_5":14884,"_28435":2739,"_3074":59442},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3697":2746,"_31245":2739,"_21577":59444,"_5":14884,"_28435":59426,"_3074":59445},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3697":2747,"_31245":2739,"_21577":59447,"_5":14884,"_28435":59426,"_3074":59448},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3697":2748,"_31245":2739,"_21577":59450,"_5":14884,"_28435":59426,"_3074":15494},[],{"_3697":2749,"_31245":2739,"_21577":59452,"_5":14884,"_28435":59426,"_3074":15435},[],{"_3697":2750,"_31245":2739,"_21577":59454,"_5":14884,"_28435":59426,"_3074":15481},[],{"_3697":2751,"_31245":2739,"_21577":59456,"_5":14884,"_28435":59426,"_3074":59457},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3697":2752,"_31245":2739,"_21577":59459,"_5":14884,"_28435":59426,"_3074":59460},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3697":2753,"_31245":2739,"_21577":59462,"_5":14884,"_28435":59430,"_3074":59463},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3697":2754,"_31245":2739,"_21577":59465,"_5":14884,"_28435":59430,"_3074":59466},[],"Do not include in the report:",{"_3697":2755,"_31245":2739,"_21577":59468,"_5":14884,"_28435":59430,"_3074":59469},[],"Credentials, tokens, or private keys",{"_3697":2756,"_31245":2739,"_21577":59471,"_5":14884,"_28435":59430,"_3074":59472},[],"Customer data or customer-identifiable information",{"_3697":2757,"_31245":2739,"_21577":59474,"_5":14884,"_28435":59430,"_3074":59475},[],"Confidential architecture or internal infrastructure details",{"_3697":2758,"_31245":2739,"_21577":59477,"_5":14884,"_28435":59434,"_3074":59478},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3697":2759,"_31245":2739,"_21577":59480,"_5":14884,"_28435":59434,"_3074":59481},[],"For upgrade guidance, see Upgrades.",{"_3697":2760,"_31245":2739,"_21577":59483,"_5":14884,"_28435":59438,"_3074":59484},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3697":2761,"_31245":2739,"_21577":59486,"_5":14884,"_28435":59438,"_3074":59487},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3697":2762,"_31245":2739,"_21577":59489,"_5":14884,"_28435":59438,"_3074":59490},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3697":2763,"_31245":2739,"_21577":59492,"_5":14884,"_28435":59438,"_3074":59493},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3697":2764,"_31245":2739,"_21577":59495,"_5":14884,"_28435":59438,"_3074":59496},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3697":2765,"_31245":2765,"_5":15238,"_3074":59498,"_31570":59499,"_21577":59501,"_28435":2765},"3.8.0 to 4.0.0",[50948,59500],"Upgrades",[],{"_3697":2766,"_31245":2765,"_21577":59503,"_5":14884,"_28435":2765,"_3074":59504},[],"What changes in 4.0.0, which changes break 3.8.0 API clients, event consumers and devices, how to upgrade a Helm release step by step and how to validate the result.",{"_3697":2767,"_31245":2765,"_5":31567,"_21577":59506,"_28435":59507,"_3074":59508},[],"/docs/upgrades/3-8-0-to-4-0-0#changes","Changes",{"_3697":2768,"_31245":2765,"_5":31567,"_21577":59510,"_28435":59511,"_3074":59512},[],"/docs/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3697":2769,"_31245":2765,"_5":31567,"_21577":59514,"_28435":59515,"_3074":59516},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-chart-and-deployment","Helm chart and deployment",{"_3697":2770,"_31245":2765,"_5":31567,"_21577":59518,"_28435":59519,"_3074":59520},[],"/docs/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3697":2771,"_31245":2765,"_5":31567,"_21577":59522,"_28435":59523,"_3074":59524},[],"/docs/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3697":2772,"_31245":2765,"_5":31567,"_21577":59526,"_28435":59527,"_3074":59528},[],"/docs/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3697":2773,"_31245":2765,"_5":31567,"_21577":59530,"_28435":59531,"_3074":59532},[],"/docs/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3697":2774,"_31245":2765,"_5":31567,"_21577":59534,"_28435":59535,"_3074":51586},[],"/docs/upgrades/3-8-0-to-4-0-0#credentials-in-kubernetes-secrets",{"_3697":2775,"_31245":2765,"_5":31567,"_21577":59537,"_28435":59538,"_3074":59539},[],"/docs/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3697":2776,"_31245":2765,"_5":31567,"_21577":59541,"_28435":59542,"_3074":59543},[],"/docs/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3697":2777,"_31245":2765,"_5":31567,"_21577":59545,"_28435":59546,"_3074":57444},[],"/docs/upgrades/3-8-0-to-4-0-0#authorization",{"_3697":2778,"_31245":2765,"_5":31567,"_21577":59548,"_28435":59549,"_3074":59550},[],"/docs/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3697":2779,"_31245":2765,"_5":31567,"_21577":59552,"_28435":59553,"_3074":59554},[],"/docs/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3697":2780,"_31245":2765,"_5":31567,"_21577":59556,"_28435":59557,"_3074":59558},[],"/docs/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3697":2781,"_31245":2765,"_5":31567,"_21577":59560,"_28435":59561,"_3074":59562},[],"/docs/upgrades/3-8-0-to-4-0-0#storage-and-data","Storage and data",{"_3697":2782,"_31245":2765,"_5":31567,"_21577":59564,"_28435":59565,"_3074":59566},[],"/docs/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3697":2783,"_31245":2765,"_5":31567,"_21577":59568,"_28435":59569,"_3074":59570},[],"/docs/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3697":2784,"_31245":2765,"_5":31567,"_21577":59572,"_28435":59573,"_3074":59574},[],"/docs/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3697":2785,"_31245":2765,"_5":31567,"_21577":59576,"_28435":59577,"_3074":59578},[],"/docs/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3697":2786,"_31245":2765,"_5":31567,"_21577":59580,"_28435":59581,"_3074":59582},[],"/docs/upgrades/3-8-0-to-4-0-0#crl-settings-migration","CRL settings migration",{"_3697":2787,"_31245":2765,"_5":31567,"_21577":59584,"_28435":59585,"_3074":59586},[],"/docs/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3697":2788,"_31245":2765,"_5":31567,"_21577":59588,"_28435":59589,"_3074":59590},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3697":2789,"_31245":2765,"_5":31567,"_21577":59592,"_28435":59593,"_3074":55232},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-configuration",{"_3697":2790,"_31245":2765,"_5":31567,"_21577":59595,"_28435":59596,"_3074":59597},[],"/docs/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3697":2791,"_31245":2765,"_5":31567,"_21577":59599,"_28435":59600,"_3074":59601},[],"/docs/upgrades/3-8-0-to-4-0-0#webhook-receiver-certificate-verification","Webhook receiver certificate verification",{"_3697":2792,"_31245":2765,"_5":31567,"_21577":59603,"_28435":59604,"_3074":59605},[],"/docs/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3697":2793,"_31245":2765,"_5":31567,"_21577":59607,"_28435":59608,"_3074":59609},[],"/docs/upgrades/3-8-0-to-4-0-0#api-and-sdk","API and SDK",{"_3697":2794,"_31245":2765,"_5":31567,"_21577":59611,"_28435":59612,"_3074":59613},[],"/docs/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3697":2795,"_31245":2765,"_5":31567,"_21577":59615,"_28435":59616,"_3074":59617},[],"/docs/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3697":2796,"_31245":2765,"_5":31567,"_21577":59619,"_28435":59620,"_3074":59621},[],"/docs/upgrades/3-8-0-to-4-0-0#ca-signature-endpoints-removed","CA signature endpoints removed",{"_3697":2797,"_31245":2765,"_5":31567,"_21577":59623,"_28435":59624,"_3074":59625},[],"/docs/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3697":2798,"_31245":2765,"_5":31567,"_21577":59627,"_28435":59628,"_3074":59629},[],"/docs/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3697":2799,"_31245":2765,"_5":31567,"_21577":59631,"_28435":59632,"_3074":59633},[],"/docs/upgrades/3-8-0-to-4-0-0#conflicting-kms-key-aliases","Conflicting KMS key aliases",{"_3697":2800,"_31245":2765,"_5":31567,"_21577":59635,"_28435":59636,"_3074":59637},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3697":2801,"_31245":2765,"_5":31567,"_21577":59639,"_28435":59640,"_3074":59641},[],"/docs/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3697":2802,"_31245":2765,"_5":31567,"_21577":59643,"_28435":59644,"_3074":59645},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3697":2803,"_31245":2765,"_5":31567,"_21577":59647,"_28435":59648,"_3074":59649},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3697":2804,"_31245":2765,"_5":31567,"_21577":59651,"_28435":59652,"_3074":59653},[],"/docs/upgrades/3-8-0-to-4-0-0#events","Events",{"_3697":2805,"_31245":2765,"_5":31567,"_21577":59655,"_28435":59656,"_3074":59657},[],"/docs/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3697":2806,"_31245":2765,"_5":31567,"_21577":59659,"_28435":59660,"_3074":59661},[],"/docs/upgrades/3-8-0-to-4-0-0#enrollment-behavior","Enrollment behavior",{"_3697":2807,"_31245":2765,"_5":31567,"_21577":59663,"_28435":59664,"_3074":59665},[],"/docs/upgrades/3-8-0-to-4-0-0#fail-closed-revocation-checks","Fail-closed revocation checks",{"_3697":2808,"_31245":2765,"_5":31567,"_21577":59667,"_28435":59668,"_3074":59669},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3697":2809,"_31245":2765,"_5":31567,"_21577":59671,"_28435":59672,"_3074":59673},[],"/docs/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3697":2810,"_31245":2765,"_5":31567,"_21577":59675,"_28435":59676,"_3074":59677},[],"/docs/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3697":2811,"_31245":2765,"_5":31567,"_21577":59679,"_28435":59680,"_3074":59681},[],"/docs/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3697":2812,"_31245":2765,"_5":31567,"_21577":59683,"_28435":59684,"_3074":59685},[],"/docs/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3697":2813,"_31245":2765,"_5":31567,"_21577":59687,"_28435":59688,"_3074":59689},[],"/docs/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3697":2814,"_31245":2765,"_5":31567,"_21577":59691,"_28435":59692,"_3074":59693},[],"/docs/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3697":2815,"_31245":2765,"_5":31567,"_21577":59695,"_28435":59696,"_3074":59697},[],"/docs/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3697":2816,"_31245":2765,"_5":31567,"_21577":59699,"_28435":59700,"_3074":55288},[],"/docs/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3697":2817,"_31245":2765,"_5":31567,"_21577":59702,"_28435":59703,"_3074":59704},[],"/docs/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3697":2818,"_31245":2765,"_5":31567,"_21577":59706,"_28435":59707,"_3074":59708},[],"/docs/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3697":2819,"_31245":2765,"_21577":59710,"_5":14884,"_28435":2765,"_3074":59711},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3697":2820,"_31245":2765,"_21577":59713,"_5":14884,"_28435":2765,"_3074":59714},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3697":2821,"_31245":2765,"_21577":59716,"_5":14884,"_28435":2765,"_3074":59717},[],"Changes: what is different in the deployment, the storage and the stored data, what the upgrade migrates on its own and which of these changes need your action.",{"_3697":2822,"_31245":2765,"_21577":59719,"_5":14884,"_28435":2765,"_3074":59720},[],"Breaking changes: changes to the API, the events and the behavior that clients, integrations and devices rely on, who each one affects and what to do.",{"_3697":2823,"_31245":2765,"_21577":59722,"_5":14884,"_28435":2765,"_3074":59723},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3697":2824,"_31245":2765,"_21577":59725,"_5":14884,"_28435":2765,"_3074":59726},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3697":2825,"_31245":2765,"_21577":59728,"_5":14884,"_28435":2765,"_3074":59729},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3697":2826,"_31245":2765,"_21577":59731,"_5":14884,"_28435":59507,"_3074":59732},[],"These changes alter how Lamassu is deployed, where it stores its data and how that data is converted. They do not change the API or the events: what clients, integrations and devices have to adapt to is listed under Breaking changes. Most of these changes are applied by the upgrade itself; the ones that need operator action say so, and the Helm migration guide performs that action in order.",{"_3697":2827,"_31245":2765,"_21577":59734,"_5":14884,"_28435":59511,"_3074":59735},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3697":2828,"_31245":2765,"_21577":59737,"_5":14884,"_28435":59511,"_3074":59738},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3697":2829,"_31245":2765,"_21577":59740,"_5":14884,"_28435":59511,"_3074":59741},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3697":2830,"_31245":2765,"_21577":59743,"_5":14884,"_28435":59511,"_3074":59744},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata and the aliases that equal an existing key ID (see Conflicting KMS key aliases). The VA migration turns each VA role into the CRL settings of its CA and resolves its CRL signer (see CRL settings migration).",{"_3697":2831,"_31245":2765,"_21577":59746,"_5":14884,"_28435":59511,"_3074":59747},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3697":2832,"_31245":2765,"_21577":59749,"_5":14884,"_28435":59511,"_3074":59750},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3697":2833,"_31245":2765,"_21577":59752,"_5":14884,"_28435":59519,"_3074":59753},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3697":2834,"_31245":2765,"_21577":59755,"_5":14884,"_28435":59519,"_3074":59756},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3697":2835,"_31245":2765,"_21577":59758,"_5":14884,"_28435":59519,"_3074":59759},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` and existing volumes must be accessible to that identity.",{"_3697":2836,"_31245":2765,"_21577":59761,"_5":14884,"_28435":59519,"_3074":59762},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3697":2837,"_31245":2765,"_21577":59764,"_5":14884,"_28435":59519,"_3074":59765},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3697":2838,"_31245":2765,"_21577":59767,"_5":14884,"_28435":59523,"_3074":59768},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3697":2839,"_31245":2765,"_21577":59770,"_5":14884,"_28435":59523,"_3074":59771},[],"Step 4 of the migration guide copies the data.",{"_3697":2840,"_31245":2765,"_21577":59773,"_5":14884,"_28435":59527,"_3074":59774},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3697":2841,"_31245":2765,"_21577":59776,"_5":14884,"_28435":59527,"_3074":59777},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3697":2842,"_31245":2765,"_21577":59779,"_5":14884,"_28435":59527,"_3074":59780},[],"Pods now carry a pod-level `fsGroup: 65532` with `fsGroupChangePolicy: OnRootMismatch`, which skips recursive ownership changes when the volume root already has the expected group. If your backup helpers or jobs run with a different GID, verify they can still access the volumes they need.",{"_3697":2843,"_31245":2765,"_21577":59782,"_5":14884,"_28435":59531,"_3074":59783},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3697":2844,"_31245":2765,"_21577":59785,"_5":14884,"_28435":59535,"_3074":59786},[],"In 4.0.0 the chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace instead of inline values: `postgres.existingSecret`, `amqp.existingSecret` and — when SMTP authentication is configured — `services.alerts.smtp_server.existingSecret`, each with `usernameKey` and `passwordKey` naming the Secret data keys. The inline `postgres.username`/`postgres.password` and `amqp.username`/`amqp.password` values are removed and rejected by `values.schema.json`, so a 3.8.0 values file fails `helm lint` and `helm upgrade` until the credentials move into Secrets.",{"_3697":2845,"_31245":2765,"_21577":59788,"_5":14884,"_28435":59535,"_3074":59789},[],"The Secrets must exist before `helm upgrade` runs: the pre-upgrade database job connects to PostgreSQL with them. Step 2 creates them through the External Secrets Operator.",{"_3697":2846,"_31245":2765,"_21577":59791,"_5":14884,"_28435":59538,"_3074":59792},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3697":2847,"_31245":2765,"_21577":59794,"_5":14884,"_28435":59538,"_3074":59795},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3697":2848,"_31245":2765,"_21577":59797,"_5":14884,"_28435":59538,"_3074":59798},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3697":2849,"_31245":2765,"_21577":59800,"_5":14884,"_28435":59538,"_3074":59801},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3697":2850,"_31245":2765,"_21577":59803,"_5":14884,"_28435":59538,"_3074":59804},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3697":2851,"_31245":2765,"_21577":59806,"_5":14884,"_28435":59538,"_3074":59807},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3697":2852,"_31245":2765,"_21577":59809,"_5":14884,"_28435":59542,"_3074":59810},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3697":2853,"_31245":2765,"_21577":59812,"_5":14884,"_28435":59549,"_3074":59813},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3697":2854,"_31245":2765,"_21577":59815,"_5":14884,"_28435":59549,"_3074":59816},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3697":2855,"_31245":2765,"_21577":59818,"_5":14884,"_28435":59553,"_3074":59819},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3697":2856,"_31245":2765,"_21577":59821,"_5":14884,"_28435":59557,"_3074":59822},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3697":2857,"_31245":2765,"_21577":59824,"_5":14884,"_28435":59565,"_3074":59825},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3697":2858,"_31245":2765,"_21577":59827,"_5":14884,"_28435":59565,"_3074":59828},[],"PostgreSQL is now the only storage engine. The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3697":2859,"_31245":2765,"_21577":59830,"_5":14884,"_28435":59569,"_3074":59831},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3697":2860,"_31245":2765,"_21577":59833,"_5":14884,"_28435":59569,"_3074":59834},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3697":2861,"_31245":2765,"_21577":59836,"_5":14884,"_28435":59569,"_3074":59837},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3697":2862,"_31245":2765,"_21577":59839,"_5":14884,"_28435":59569,"_3074":59840},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3697":2863,"_31245":2765,"_21577":59842,"_5":14884,"_28435":59573,"_3074":59843},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3697":2864,"_31245":2765,"_21577":59845,"_5":14884,"_28435":59573,"_3074":59846},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3697":2865,"_31245":2765,"_21577":59848,"_5":14884,"_28435":59573,"_3074":59849},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3697":2866,"_31245":2765,"_21577":59851,"_5":14884,"_28435":59573,"_3074":59852},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3697":2867,"_31245":2765,"_21577":59854,"_5":14884,"_28435":59573,"_3074":59855},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3697":2868,"_31245":2765,"_21577":59857,"_5":14884,"_28435":59573,"_3074":59858},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3697":2869,"_31245":2765,"_21577":59860,"_5":14884,"_28435":59573,"_3074":59861},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3697":2870,"_31245":2765,"_21577":59863,"_5":14884,"_28435":59573,"_3074":59864},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3697":2871,"_31245":2765,"_21577":59866,"_5":14884,"_28435":59577,"_3074":59867},[],"The migration removes the legacy `lamassu.io/kms/binded-resources` metadata and registers missing keys needed by retained certificate references in the KMS with their public key only. These entries do not recover the private key. See Key management and CRL for reference behavior.",{"_3697":2872,"_31245":2765,"_21577":59869,"_5":14884,"_28435":59581,"_3074":59870},[],"The VA migration turns each 3.8.0 VA role, keyed by the CA's SKI, into the CRL settings of a CA, keyed by its CA ID. Every CA gets its own settings, even when two CAs share a key. CRL settings keyed by CA ID describes what changes for API clients.",{"_3697":2873,"_31245":2765,"_21577":59872,"_5":14884,"_28435":59581,"_3074":59873},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3697":2874,"_31245":2765,"_21577":59875,"_5":14884,"_28435":59581,"_3074":59876},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3697":2875,"_31245":2765,"_21577":59878,"_5":14884,"_28435":59581,"_3074":59879},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3697":2876,"_31245":2765,"_21577":59881,"_5":14884,"_28435":59581,"_3074":59882},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3697":2877,"_31245":2765,"_21577":59884,"_5":14884,"_28435":59581,"_3074":59885},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3697":2878,"_31245":2765,"_21577":59887,"_5":14884,"_28435":59581,"_3074":59888},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3697":2879,"_31245":2765,"_21577":59890,"_5":14884,"_28435":59581,"_3074":59891},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3697":2880,"_31245":2765,"_21577":59893,"_5":14884,"_28435":59581,"_3074":59894},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3697":2881,"_31245":2765,"_21577":59896,"_5":14884,"_28435":59585,"_3074":59897},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3697":2882,"_31245":2765,"_21577":59899,"_5":14884,"_28435":59589,"_3074":59900},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. See Device events to adapt consumers.",{"_3697":2883,"_31245":2765,"_21577":59902,"_5":14884,"_28435":59596,"_3074":59903},[],"Re-enrollment authentication settings are independent of initial enrollment settings; no migration is required. See Authentication per operation.",{"_3697":2884,"_31245":2765,"_21577":59905,"_5":14884,"_28435":59600,"_3074":59906},[],"A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3697":2885,"_31245":2765,"_21577":59908,"_5":14884,"_28435":59604,"_3074":59909},[],"These changes alter the contract that 3.8.0 clients rely on: REST API endpoints and fields, Go SDK methods, the events the services publish, and the behavior devices see during enrollment. Clients, integrations and devices built against 3.8.0 have to adapt to them. Each one affects only the integrations that use what changed; check the “Who is affected” column. Changes to the deployment, the storage and the stored data are under Changes, even when they need action during the upgrade.",{"_3697":2886,"_31245":2765,"_21577":59911,"_5":14884,"_28435":59604,"_3074":59912},[],"Change",{"_3697":2887,"_31245":2765,"_21577":59914,"_5":14884,"_28435":59604,"_3074":59915},[],"Who is affected",{"_3697":2888,"_31245":2765,"_21577":59917,"_5":14884,"_28435":59604,"_3074":59918},[],"Severity",{"_3697":2889,"_31245":2765,"_21577":59920,"_5":14884,"_28435":59604,"_3074":58182},[],{"_3697":2890,"_31245":2765,"_21577":59922,"_5":14884,"_28435":59604,"_3074":59613},[],{"_3697":2891,"_31245":2765,"_21577":59924,"_5":14884,"_28435":59604,"_3074":59925},[],"Clients of `/v1/roles`, custom authorization policies on `va_role`, and verifiers of certificates issued after the upgrade",{"_3697":2892,"_31245":2765,"_21577":59927,"_5":14884,"_28435":59604,"_3074":59928},[],"High: the `/v1/roles` routes are removed",{"_3697":2893,"_31245":2765,"_21577":59930,"_5":14884,"_28435":59604,"_3074":59931},[],"Move clients to `/v1/crl-settings` with the CA ID and update the policies",{"_3697":2894,"_31245":2765,"_21577":59933,"_5":14884,"_28435":59604,"_3074":59637},[],{"_3697":2895,"_31245":2765,"_21577":59935,"_5":14884,"_28435":59604,"_3074":59936},[],"Clients that read or write webhook configs through the API, and DMSs whose webhook mTLS certificate or key were file paths",{"_3697":2896,"_31245":2765,"_21577":59938,"_5":14884,"_28435":59604,"_3074":59939},[],"High: enrollments calling a webhook with file references fail",{"_3697":2897,"_31245":2765,"_21577":59941,"_5":14884,"_28435":59604,"_3074":59942},[],"Use the new field names; re-enter certificate and key as PEM, or remove the file fields",{"_3697":2898,"_31245":2765,"_21577":59944,"_5":14884,"_28435":59604,"_3074":59665},[],{"_3697":2899,"_31245":2765,"_21577":59946,"_5":14884,"_28435":59604,"_3074":59947},[],"Every deployment with devices presenting certificates not managed by Lamassu",{"_3697":2900,"_31245":2765,"_21577":59949,"_5":14884,"_28435":59604,"_3074":59950},[],"Medium: enrollment or re-enrollment of those devices fails",{"_3697":2901,"_31245":2765,"_21577":59952,"_5":14884,"_28435":59604,"_3074":59953},[],"Set `allow_unverifiable_revocation` to `true` in the affected DMS blocks, or make sure the certificates carry reachable OCSP/CRL distribution points",{"_3697":2902,"_31245":2765,"_21577":59955,"_5":14884,"_28435":59604,"_3074":59641},[],{"_3697":2903,"_31245":2765,"_21577":59957,"_5":14884,"_28435":59604,"_3074":59958},[],"Scripts and consoles that edit DMSs through the API",{"_3697":2904,"_31245":2765,"_21577":59960,"_5":14884,"_28435":59604,"_3074":59961},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3697":2905,"_31245":2765,"_21577":59963,"_5":14884,"_28435":59604,"_3074":59964},[],"Read the DMS before editing and use the new field",{"_3697":2906,"_31245":2765,"_21577":59966,"_5":14884,"_28435":59604,"_3074":59617},[],{"_3697":2907,"_31245":2765,"_21577":59968,"_5":14884,"_28435":59604,"_3074":59969},[],"Clients that create or update CRL settings through the API",{"_3697":2908,"_31245":2765,"_21577":59971,"_5":14884,"_28435":59604,"_3074":59972},[],"Medium: requests with the old field return an error",{"_3697":2909,"_31245":2765,"_21577":59974,"_5":14884,"_28435":59604,"_3074":59975},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3697":2910,"_31245":2765,"_21577":59977,"_5":14884,"_28435":59604,"_3074":59657},[],{"_3697":2911,"_31245":2765,"_21577":59979,"_5":14884,"_28435":59604,"_3074":59980},[],"Alert subscriptions and consumers of the VA events",{"_3697":2912,"_31245":2765,"_21577":59982,"_5":14884,"_28435":59604,"_3074":59983},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3697":2913,"_31245":2765,"_21577":59985,"_5":14884,"_28435":59604,"_3074":59986},[],"Review conditions filtering on the old event payload or subject",{"_3697":2914,"_31245":2765,"_21577":59988,"_5":14884,"_28435":59604,"_3074":59621},[],{"_3697":2915,"_31245":2765,"_21577":59990,"_5":14884,"_28435":59604,"_3074":59991},[],"Clients that sign or verify arbitrary data through the CA API or the Go SDK, and alert subscriptions on the `ca.sign.signature` event",{"_3697":2916,"_31245":2765,"_21577":59993,"_5":14884,"_28435":59604,"_3074":59994},[],"Medium: the endpoints, the SDK methods and the event no longer exist",{"_3697":2917,"_31245":2765,"_21577":59996,"_5":14884,"_28435":59604,"_3074":59997},[],"Sign and verify with KMS keys instead; remove subscriptions on the event",{"_3697":2918,"_31245":2765,"_21577":59999,"_5":14884,"_28435":59604,"_3074":59649},[],{"_3697":2919,"_31245":2765,"_21577":60001,"_5":14884,"_28435":59604,"_3074":60002},[],"Consumers that read the device `events` field",{"_3697":2920,"_31245":2765,"_21577":60004,"_5":14884,"_28435":59604,"_3074":60005},[],"Medium: the field disappears",{"_3697":2921,"_31245":2765,"_21577":60007,"_5":14884,"_28435":59604,"_3074":60008},[],"Use the new event endpoints",{"_3697":2922,"_31245":2765,"_21577":60010,"_5":14884,"_28435":59604,"_3074":59633},[],{"_3697":2923,"_31245":2765,"_21577":60012,"_5":14884,"_28435":59604,"_3074":60013},[],"Clients using an alias equal to an existing key ID",{"_3697":2924,"_31245":2765,"_21577":60015,"_5":14884,"_28435":59604,"_3074":60016},[],"Medium: the alias is removed and the ID takes precedence",{"_3697":2925,"_31245":2765,"_21577":60018,"_5":14884,"_28435":59604,"_3074":60019},[],"Review and update affected references",{"_3697":2926,"_31245":2765,"_21577":60021,"_5":14884,"_28435":59604,"_3074":59645},[],{"_3697":2927,"_31245":2765,"_21577":60023,"_5":14884,"_28435":59604,"_3074":60024},[],"Clients that send the DMS ID in the update body",{"_3697":2928,"_31245":2765,"_21577":60026,"_5":14884,"_28435":59604,"_3074":60027},[],"Low: the ID in the URL wins",{"_3697":2929,"_31245":2765,"_21577":60029,"_5":14884,"_28435":59604,"_3074":60030},[],"Send the ID in the URL",{"_3697":2930,"_31245":2765,"_21577":60032,"_5":14884,"_28435":59604,"_3074":59625},[],{"_3697":2931,"_31245":2765,"_21577":60034,"_5":14884,"_28435":59604,"_3074":60035},[],"Clients that send an `id` when creating or importing CAs",{"_3697":2932,"_31245":2765,"_21577":60037,"_5":14884,"_28435":59604,"_3074":60038},[],"Low: the ID in the body is ignored, and the field is removed",{"_3697":2933,"_31245":2765,"_21577":60040,"_5":14884,"_28435":59604,"_3074":60041},[],"Let the backend assign the ID and use the returned one",{"_3697":2934,"_31245":2765,"_21577":60043,"_5":14884,"_28435":59604,"_3074":59629},[],{"_3697":2935,"_31245":2765,"_21577":60045,"_5":14884,"_28435":59604,"_3074":60046},[],"Consumers that match on certificate `type`",{"_3697":2936,"_31245":2765,"_21577":60048,"_5":14884,"_28435":59604,"_3074":60049},[],"Low: two values are renamed",{"_3697":2937,"_31245":2765,"_21577":60051,"_5":14884,"_28435":59604,"_3074":60052},[],"Adapt consumers",{"_3697":2938,"_31245":2765,"_21577":60054,"_5":14884,"_28435":59612,"_3074":60055},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key.",{"_3697":2939,"_31245":2765,"_21577":60057,"_5":14884,"_28435":59612,"_3074":60058},[],"Adapt clients of `/v1/roles` to `/v1/crl-settings` using the CA ID. The CRL guide describes the operations and options.",{"_3697":2940,"_31245":2765,"_21577":60060,"_5":14884,"_28435":59612,"_3074":60061},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3697":2941,"_31245":2765,"_21577":60063,"_5":14884,"_28435":59612,"_3074":60064},[],"CRL settings migration describes how the upgrade converts the stored roles, the data it aborts on and why it cannot be rolled back.",{"_3697":2942,"_31245":2765,"_21577":60066,"_5":14884,"_28435":59612,"_3074":60067},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. The entity gains the `delete` atomic action, a `signer_key_id` relation to KMS keys, and the filterable columns `signer_engine_id` and `signer_key_id`; grant the new action to whoever may delete archived CRL settings. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3697":2943,"_31245":2765,"_21577":60069,"_5":14884,"_28435":59616,"_3074":60070},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3697":2944,"_31245":2765,"_21577":60072,"_5":14884,"_28435":59620,"_3074":60073},[],"`POST /v1/cas/{id}/signature/sign` and `POST /v1/cas/{id}/signature/verify` no longer exist: the CA service no longer signs or verifies arbitrary data, so a CA's private key only signs certificates. The Go SDK's `CAService.SignatureSign` and `CAService.SignatureVerify` methods are removed too, and the `ca.sign.signature` event is no longer published, so alert subscriptions and event-bus consumers that rely on it never fire again — remove those subscriptions and point consumers elsewhere. Sign and verify arbitrary data with a KMS key instead, through `POST /api/kms/v1/keys/{id}/sign` and `POST /api/kms/v1/keys/{id}/verify` (the Go SDK's `KMSService.SignMessage` and `KMSService.VerifySignature`); the console equivalent is described in Sign and verify. A CA is also only accepted for signing when its validity window includes the current time, even if its stored status still reads `ACTIVE`.",{"_3697":2945,"_31245":2765,"_21577":60075,"_5":14884,"_28435":59624,"_3074":60076},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3697":2946,"_31245":2765,"_21577":60078,"_5":14884,"_28435":59628,"_3074":60079},[],"The certificate `type` values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Stored values are converted by the upgrade; adapt consumers that read or match on those values.",{"_3697":2947,"_31245":2765,"_21577":60081,"_5":14884,"_28435":59632,"_3074":60082},[],"KMS identifiers now resolve as a key ID before an alias. The KMS migration therefore deletes, with a `NOTICE`, aliases that equal an existing key ID. Affected aliases are dropped, not redirected: a client that used one now reaches the key with that ID.",{"_3697":2948,"_31245":2765,"_21577":60084,"_5":14884,"_28435":59636,"_3074":60085},[],"Webhook configs change layout and their fields are renamed. Stored configs are rewritten by the upgrade; API clients that read or write them must use the new names:",{"_3697":2949,"_31245":2765,"_21577":60087,"_5":14884,"_28435":59636,"_3074":60088},[],"Field in 3.8.0",{"_3697":2950,"_31245":2765,"_21577":60090,"_5":14884,"_28435":59636,"_3074":60091},[],"Field in 4.0.0",{"_3697":2951,"_31245":2765,"_21577":60093,"_5":14884,"_28435":59636,"_3074":60094},[],"`validate_server_cert`",{"_3697":2952,"_31245":2765,"_21577":60096,"_5":14884,"_28435":59636,"_3074":60097},[],"`insecure_skip_verify` (value negated)",{"_3697":2953,"_31245":2765,"_21577":60099,"_5":14884,"_28435":59636,"_3074":60100},[],"`oidc`",{"_3697":2954,"_31245":2765,"_21577":60102,"_5":14884,"_28435":59636,"_3074":60103},[],"`jwt_options`",{"_3697":2955,"_31245":2765,"_21577":60105,"_5":14884,"_28435":59636,"_3074":60106},[],"`apikey`",{"_3697":2956,"_31245":2765,"_21577":60108,"_5":14884,"_28435":59636,"_3074":60109},[],"`apikey_options`",{"_3697":2957,"_31245":2765,"_21577":60111,"_5":14884,"_28435":59636,"_3074":60112},[],"`mtls`",{"_3697":2958,"_31245":2765,"_21577":60114,"_5":14884,"_28435":59636,"_3074":60115},[],"`mtls_options`",{"_3697":2959,"_31245":2765,"_21577":60117,"_5":14884,"_28435":59636,"_3074":60118},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. File references do require action; also review receiver verification.",{"_3697":2960,"_31245":2765,"_21577":60120,"_5":14884,"_28435":59636,"_3074":60121},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3697":2961,"_31245":2765,"_21577":60123,"_5":14884,"_28435":59640,"_3074":60124},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3697":2962,"_31245":2765,"_21577":60126,"_5":14884,"_28435":59640,"_3074":60127},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3697":2963,"_31245":2765,"_21577":60129,"_5":14884,"_28435":59640,"_3074":60130},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3697":2964,"_31245":2765,"_21577":60132,"_5":14884,"_28435":59644,"_3074":60133},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3697":2965,"_31245":2765,"_21577":60135,"_5":14884,"_28435":59648,"_3074":60136},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3697":2966,"_31245":2765,"_21577":60138,"_5":14884,"_28435":59648,"_3074":60139},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3697":2967,"_31245":2765,"_21577":60141,"_5":14884,"_28435":59648,"_3074":60142},[],"`POST /v1/devices/:id/events` creates an event.",{"_3697":2968,"_31245":2765,"_21577":60144,"_5":14884,"_28435":59648,"_3074":60145},[],"The endpoint also supports SSE. See Events API and live stream.",{"_3697":2969,"_31245":2765,"_21577":60147,"_5":14884,"_28435":59652,"_3074":60148},[],"Two changes affect alert subscriptions and event-bus consumers: the VA events are renamed and reshaped, and `ca.sign.signature` is no longer published because the CA no longer signs arbitrary data (see CA signature endpoints removed).",{"_3697":2970,"_31245":2765,"_21577":60150,"_5":14884,"_28435":59656,"_3074":60151},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3697":2971,"_31245":2765,"_21577":60153,"_5":14884,"_28435":59664,"_3074":60154},[],"Enrollment and re-enrollment now verify the revocation of the presented certificates and fail closed when it cannot be verified. There is no migration: every pre-existing DMS has the new `allow_unverifiable_revocation` option at its default `false`, so a certificate that is not managed by Lamassu and carries no OCSP or CRL distribution points is rejected until the option is set to `true` in the affected block, independently for the enrollment and the re-enrollment block.",{"_3697":2972,"_31245":2765,"_21577":60156,"_5":14884,"_28435":59664,"_3074":60157},[],"Certificates that do carry endpoints are still strictly checked: unreachable endpoints, stale or inconclusive answers reject the certificate even when `allow_unverifiable_revocation` is enabled, and certificates managed by Lamassu are unaffected because their stored status is used. A validation CA revoked in Lamassu also rejects the operation, without falling back to the remaining validation CAs. See the DMS guide and Revocation and checks.",{"_3697":2973,"_31245":2765,"_21577":60159,"_5":14884,"_28435":59668,"_3074":60160},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3697":2974,"_31245":2765,"_21577":60162,"_5":14884,"_28435":59672,"_3074":60163},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings migration).",{"_3697":2975,"_31245":2765,"_21577":60165,"_5":14884,"_28435":59672,"_3074":60166},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3697":2976,"_31245":2765,"_21577":60168,"_5":14884,"_28435":59672,"_3074":60169},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3697":2977,"_31245":2765,"_21577":60171,"_5":14884,"_28435":59672,"_3074":60172},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3697":2978,"_31245":2765,"_21577":60174,"_5":14884,"_28435":59672,"_3074":60175},[],"Record the names of your local-storage PVCs:",{"_3697":2979,"_31245":2765,"_21577":60177,"_5":14884,"_28435":59672,"_3074":60178},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3697":2980,"_31245":2765,"_21577":60180,"_5":14884,"_28435":59676,"_3074":60181},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3697":2981,"_31245":2765,"_21577":60183,"_5":14884,"_28435":59676,"_3074":60184},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3697":2982,"_31245":2765,"_21577":60186,"_5":14884,"_28435":59676,"_3074":60187},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3697":2983,"_31245":2765,"_21577":60189,"_5":14884,"_28435":59676,"_3074":60190},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3697":2984,"_31245":2765,"_21577":60192,"_5":14884,"_28435":59676,"_3074":60193},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3697":2985,"_31245":2765,"_21577":60195,"_5":14884,"_28435":59680,"_3074":60196},[],"**Create the credential Secrets.** The 4.0.0 chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets, and the pre-upgrade database job needs them before the upgrade runs. Copy the 3.8.0 credentials into your secret-management provider and create the Secrets with the External Secrets Operator (ESO), which the chart does not install:",{"_3697":2986,"_31245":2765,"_21577":60198,"_5":14884,"_28435":59680,"_3074":60199},[],"Configure ESO and its provider (`SecretStore` or `ClusterSecretStore`).",{"_3697":2987,"_31245":2765,"_21577":60201,"_5":14884,"_28435":59680,"_3074":60202},[],"Create an `ExternalSecret` for each credential set you use. Its target Secret must live in the release namespace, be named after the corresponding `existingSecret` value, and contain these keys:",{"_3697":2988,"_31245":2765,"_21577":60204,"_5":14884,"_28435":59680,"_3074":60205},[],"Secret (`existingSecret`)",{"_3697":2989,"_31245":2765,"_21577":60207,"_5":14884,"_28435":59680,"_3074":60208},[],"Required data keys",{"_3697":2990,"_31245":2765,"_21577":60210,"_5":14884,"_28435":59680,"_3074":60211},[],"When",{"_3697":2991,"_31245":2765,"_21577":60213,"_5":14884,"_28435":59680,"_3074":60214},[],"`lamassu-postgres` (default of `postgres.existingSecret`)",{"_3697":2992,"_31245":2765,"_21577":60216,"_5":14884,"_28435":59680,"_3074":60217},[],"`username`, `password`",{"_3697":2993,"_31245":2765,"_21577":60219,"_5":14884,"_28435":59680,"_3074":60220},[],"Always",{"_3697":2994,"_31245":2765,"_21577":60222,"_5":14884,"_28435":59680,"_3074":60223},[],"`lamassu-amqp` (default of `amqp.existingSecret`)",{"_3697":2995,"_31245":2765,"_21577":60225,"_5":14884,"_28435":59680,"_3074":60217},[],{"_3697":2996,"_31245":2765,"_21577":60227,"_5":14884,"_28435":59680,"_3074":60220},[],{"_3697":2997,"_31245":2765,"_21577":60229,"_5":14884,"_28435":59680,"_3074":60230},[],"`services.alerts.smtp_server.existingSecret`",{"_3697":2998,"_31245":2765,"_21577":60232,"_5":14884,"_28435":59680,"_3074":60217},[],{"_3697":2999,"_31245":2765,"_21577":60234,"_5":14884,"_28435":59680,"_3074":60235},[],"Only when SMTP authentication is enabled",{"_3697":3000,"_31245":2765,"_21577":60237,"_5":14884,"_28435":59680,"_3074":60238},[],"Wait for every `ExternalSecret` to be Ready and verify the generated Secrets before running the upgrade.",{"_3697":3001,"_31245":2765,"_21577":60240,"_5":14884,"_28435":59680,"_3074":60241},[],"Do not change the database or broker passwords as part of this migration: ESO synchronizes credentials into Secrets, but it does not update the users configured on the PostgreSQL server or the broker. Removing credentials from the values file does not undo past exposure — if they were ever committed to Git, rotate them after the migration is complete.",{"_3697":3002,"_31245":2765,"_21577":60243,"_5":14884,"_28435":59680,"_3074":60244},[],"The `charts/lamassu/README.md` in the Helm repository documents a full worked example in its *Secret management* section: installing external-secrets 0.20.2, a test Fake `ClusterSecretStore`, the `ExternalSecret` resources and the wait for synchronization. Its Fake provider is for testing only; for production, replace it with your provider's configuration.",{"_3697":3003,"_31245":2765,"_21577":60246,"_5":14884,"_28435":59680,"_3074":60247},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3697":3004,"_31245":2765,"_21577":60249,"_5":14884,"_28435":59680,"_3074":60250},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3697":3005,"_31245":2765,"_21577":60252,"_5":14884,"_28435":59680,"_3074":60253},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is required; per-schema `hostname` and `port` values remain accepted but are ignored — the connection always uses the global `postgres.hostname` and `postgres.port` with the global PostgreSQL credential Secret, `postgres.existingSecret` with its configured key names, unless the entry sets its own `existingSecret` (with optional `usernameKey` and `passwordKey`).",{"_3697":3006,"_31245":2765,"_21577":60255,"_5":14884,"_28435":59680,"_3074":60256},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3697":3007,"_31245":2765,"_21577":60258,"_5":14884,"_28435":59680,"_3074":60259},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3697":3008,"_31245":2765,"_21577":60261,"_5":14884,"_28435":59680,"_3074":60262},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3697":3009,"_31245":2765,"_21577":60264,"_5":14884,"_28435":59680,"_3074":60265},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3697":3010,"_31245":2765,"_21577":60267,"_5":14884,"_28435":59680,"_3074":60268},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3697":3011,"_31245":2765,"_21577":60270,"_5":14884,"_28435":59680,"_3074":60271},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3697":3012,"_31245":2765,"_21577":60273,"_5":14884,"_28435":59680,"_3074":60274},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3697":3013,"_31245":2765,"_21577":60276,"_5":14884,"_28435":59680,"_3074":60277},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3697":3014,"_31245":2765,"_21577":60279,"_5":14884,"_28435":59680,"_3074":60280},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown. Before running Step 3, confirm every credential `ExternalSecret` is Ready and the generated Secrets contain the expected keys.",{"_3697":3015,"_31245":2765,"_21577":60282,"_5":14884,"_28435":59684,"_3074":60283},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3697":3016,"_31245":2765,"_21577":60285,"_5":14884,"_28435":59684,"_3074":60286},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3697":3017,"_31245":2765,"_21577":60288,"_5":14884,"_28435":59688,"_3074":60289},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3697":3018,"_31245":2765,"_21577":60291,"_5":14884,"_28435":59688,"_3074":60292},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3697":3019,"_31245":2765,"_21577":60294,"_5":14884,"_28435":59688,"_3074":60295},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3697":3020,"_31245":2765,"_21577":60297,"_5":14884,"_28435":59688,"_3074":60298},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3697":3021,"_31245":2765,"_21577":60300,"_5":14884,"_28435":59688,"_3074":60301},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3697":3022,"_31245":2765,"_21577":60303,"_5":14884,"_28435":59688,"_3074":60304},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3697":3023,"_31245":2765,"_21577":60306,"_5":14884,"_28435":59688,"_3074":60307},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3697":3024,"_31245":2765,"_21577":60309,"_5":14884,"_28435":59688,"_3074":60310},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3697":3025,"_31245":2765,"_21577":60312,"_5":14884,"_28435":59688,"_3074":60313},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3697":3026,"_31245":2765,"_21577":60315,"_5":14884,"_28435":59688,"_3074":60316},[],"**Remove the helper and restore the recorded replica counts:**",{"_3697":3027,"_31245":2765,"_21577":60318,"_5":14884,"_28435":59688,"_3074":60319},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3697":3028,"_31245":2765,"_21577":60321,"_5":14884,"_28435":59692,"_3074":60322},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3697":3029,"_31245":2765,"_21577":60324,"_5":14884,"_28435":59692,"_3074":60325},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3697":3030,"_31245":2765,"_21577":60327,"_5":14884,"_28435":59696,"_3074":60328},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3697":3031,"_31245":2765,"_21577":60330,"_5":14884,"_28435":59696,"_3074":60331},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3697":3032,"_31245":2765,"_21577":60333,"_5":14884,"_28435":59696,"_3074":60334},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration requires `ca` and `kms` to be migrated first: it fails with `ca schema not found: migrate the ca schema before the va schema` or `kms schema not found: migrate the kms schema before the va schema` if one of them is missing.",{"_3697":3033,"_31245":2765,"_21577":60336,"_5":14884,"_28435":59696,"_3074":60337},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates`, `SELECT` on `ca.ca_certificates`, and `USAGE` on `kms` plus `SELECT` and `REFERENCES` on `kms.kms_keys`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`. After migrating `va`, if the CA service runs as a different user, grant it `USAGE` on the `va` schema and `SELECT` on `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): the CA service reads `va.crl_settings` when it deletes a CA, and without these grants every deletion of a CA that has a crypto engine fails with `permission denied for schema va` (or `for table crl_settings`).",{"_3697":3034,"_31245":2765,"_21577":60339,"_5":14884,"_28435":59696,"_3074":60340},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3697":3035,"_31245":2765,"_21577":60342,"_5":14884,"_28435":59696,"_3074":60343},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3697":3036,"_31245":2765,"_21577":60345,"_5":14884,"_28435":59696,"_3074":60346},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3697":3037,"_31245":2765,"_21577":60348,"_5":14884,"_28435":59696,"_3074":60349},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3697":3038,"_31245":2765,"_21577":60351,"_5":14884,"_28435":59700,"_3074":60352},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3697":3039,"_31245":2765,"_21577":60354,"_5":14884,"_28435":59700,"_3074":60355},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3697":3040,"_31245":2765,"_21577":60357,"_5":14884,"_28435":59700,"_3074":60358},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3697":3041,"_31245":2765,"_21577":60360,"_5":14884,"_28435":59700,"_3074":60361},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3697":3042,"_31245":2765,"_21577":60363,"_5":14884,"_28435":59700,"_3074":60364},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3697":3043,"_31245":2765,"_21577":60366,"_5":14884,"_28435":59700,"_3074":60367},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3697":3044,"_31245":2765,"_21577":60369,"_5":14884,"_28435":59700,"_3074":60370},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3697":3045,"_31245":2765,"_21577":60372,"_5":14884,"_28435":59700,"_3074":60373},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` and `va` schema migrations.",{"_3697":3046,"_31245":2765,"_21577":60375,"_5":14884,"_28435":59700,"_3074":60376},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3697":3047,"_31245":2765,"_21577":60378,"_5":14884,"_28435":59700,"_3074":60379},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3697":3048,"_31245":2765,"_21577":60381,"_5":14884,"_28435":59700,"_3074":60382},[],"**A migration or service fails with `permission denied for table ...` or `permission denied for schema ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped, and `permission denied for schema va` (or `for table crl_settings`) when deleting a CA without the `va` grants. Grant the missing privileges and re-run.",{"_3697":3049,"_31245":2765,"_21577":60384,"_5":14884,"_28435":59703,"_3074":60385},[],"After the upgrade, check in this order:",{"_3697":3050,"_31245":2765,"_21577":60387,"_5":14884,"_28435":59703,"_3074":60388},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3697":3051,"_31245":2765,"_21577":60390,"_5":14884,"_28435":59703,"_3074":60391},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3697":3052,"_31245":2765,"_21577":60393,"_5":14884,"_28435":59703,"_3074":60394},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3697":3053,"_31245":2765,"_21577":60396,"_5":14884,"_28435":59703,"_3074":60397},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3697":3054,"_31245":2765,"_21577":60399,"_5":14884,"_28435":59703,"_3074":60400},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3697":3055,"_31245":2765,"_21577":60402,"_5":14884,"_28435":59703,"_3074":60403},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3697":3056,"_31245":2765,"_21577":60405,"_5":14884,"_28435":59703,"_3074":60406},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3697":3057,"_31245":2765,"_21577":60408,"_5":14884,"_28435":59703,"_3074":60409},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3697":3058,"_31245":2765,"_21577":60411,"_5":14884,"_28435":59703,"_3074":60412},[],"**AMQP.** The backend connects to the broker with the expected TLS settings. On AMQP the SSE subscriber queues are auto-delete and disappear when their instance stops; on event-bus providers without ephemeral-subscriber support, check that leftover per-process SSE queues are not accumulating.",{"_3697":3059,"_31245":2765,"_21577":60414,"_5":14884,"_28435":59703,"_3074":60415},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3697":3060,"_31245":2765,"_21577":60417,"_5":14884,"_28435":59703,"_3074":60418},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3697":3061,"_31245":2765,"_21577":60420,"_5":14884,"_28435":59703,"_3074":60421},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3697":3062,"_31245":2765,"_21577":60423,"_5":14884,"_28435":59703,"_3074":60424},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3697":3063,"_31245":2765,"_21577":60426,"_5":14884,"_28435":59703,"_3074":60427},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3697":3064,"_31245":2765,"_21577":60429,"_5":14884,"_28435":59703,"_3074":60430},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3697":3065,"_31245":2765,"_21577":60432,"_5":14884,"_28435":59707,"_3074":60433},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3697":3066,"_31245":2765,"_21577":60435,"_5":14884,"_28435":59707,"_3074":60436},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3697":3067,"_31245":2765,"_21577":60438,"_5":14884,"_28435":59707,"_3074":60439},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3697":3068,"_31245":2765,"_21577":60441,"_5":14884,"_28435":59707,"_3074":60442},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3697":3069,"_31245":2765,"_21577":60444,"_5":14884,"_28435":59707,"_3074":60445},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_60448":60449,"_60450":60451,"_60452":60453,"_60454":60455,"_18746":3109,"_72689":3109},"language","english","sortableProperties",[3074,31245,5,28435],"sortablePropertiesWithTypes",{"_3074":25773,"_31245":25773,"_5":25773,"_28435":25773},"sorts",{"_3074":60456,"_31245":63515,"_5":66573,"_28435":69631},{"_4847":60457,"_60458":60459,"_5":25773},{"_14965":4810,"_15332":5802,"_15351":7901,"_30250":7932,"_15338":6494,"_20500":7915,"_14986":14930,"_14993":25949,"_30187":4820,"_30600":3512,"_30632":5263,"_30226":5744,"_35600":7233,"_30329":7621,"_30676":16293,"_35607":30833,"_35610":3563,"_35613":4971,"_35616":14534,"_31068":7082,"_35621":4357,"_35623":3395,"_31103":5490,"_15347":3647,"_35627":3464,"_35630":17069,"_35632":5193,"_30671":4790,"_31088":10840,"_31116":5210,"_35637":4130,"_35639":8768,"_35641":7283,"_30340":3174,"_35644":3422,"_35646":3195,"_35648":5371,"_35650":3832,"_35652":24314,"_30263":17769,"_35655":10480,"_35657":3474,"_30257":16465,"_30708":6301,"_35661":6884,"_35663":6206,"_35666":3169,"_30303":6083,"_35670":7737,"_30178":10261,"_35673":8023,"_30231":6495,"_35676":3508,"_35678":7269,"_35681":17230,"_15341":4998,"_35684":3886,"_35686":11385,"_35689":7281,"_35691":3561,"_35693":4974,"_35695":3216,"_35697":6097,"_20503":4403,"_35700":10387,"_35702":4174,"_30204":4270,"_30665":4581,"_35706":5169,"_35708":6209,"_35710":7927,"_31132":7337,"_35713":3560,"_35715":6424,"_35717":9427,"_31225":4605,"_30724":21720,"_35721":4258,"_35723":5752,"_30241":10693,"_35726":7247,"_35728":6999,"_35730":3419,"_31148":20049,"_30323":7256,"_29697":3588,"_35735":7832,"_35737":4188,"_35739":7835,"_30366":7358,"_35743":5373,"_30659":22345,"_35747":25776,"_35749":4520,"_35751":3952,"_35753":6283,"_35755":7353,"_35757":3355,"_30355":4698,"_30605":4756,"_35761":3918,"_35763":5052,"_35765":8699,"_35768":3533,"_35770":6433,"_35772":4799,"_35774":3944,"_35776":7623,"_35778":7681,"_35780":4411,"_35783":16287,"_35785":25775,"_35787":20757,"_35789":12643,"_35791":6234,"_35794":17391,"_35796":14755,"_35799":7330,"_35802":11161,"_35804":3214,"_35806":12906,"_35808":7289,"_35810":6191,"_35812":50938,"_35814":3215,"_35816":3542,"_35818":3390,"_30670":7982,"_35821":8235,"_35823":21488,"_35825":3159,"_35827":3319,"_35829":5335,"_35831":7271,"_35833":6831,"_35835":7795,"_35837":3400,"_35839":4161,"_35841":3150,"_35843":8769,"_35845":6061,"_35847":4797,"_35849":6761,"_35851":4903,"_35853":3935,"_35855":5129,"_35857":7856,"_35859":3111,"_35861":4267,"_35863":4696,"_35865":7198,"_35867":20796,"_35869":7210,"_35871":4824,"_35873":6105,"_35875":5821,"_35877":6073,"_35879":7960,"_35881":3317,"_35883":16279,"_35885":4817,"_35887":5158,"_35889":3414,"_35891":6760,"_35893":3318,"_35895":5170,"_35897":4456,"_30664":6190,"_35900":15217,"_35902":3460,"_35904":7855,"_35906":4904,"_35908":5497,"_35910":20756,"_35913":4160,"_35915":6443,"_35917":11422,"_35919":7313,"_35921":4217,"_35923":5242,"_35925":7407,"_35927":12773,"_35929":3655,"_35931":4261,"_35933":10242,"_35935":13759,"_35937":18800,"_35939":13392,"_35941":4564,"_35943":6995,"_35945":4612,"_30658":5941,"_35948":4838,"_35950":4567,"_35953":7818,"_35956":20057,"_35958":5474,"_35960":6102,"_35963":25291,"_31083":5388,"_35966":4496,"_35968":3149,"_35970":3810,"_31073":3547,"_35973":4353,