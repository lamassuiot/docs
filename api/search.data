:41002,"_29457":41005,"_29459":41008,"_29461":41011,"_29463":41014,"_29465":41017,"_29467":41020,"_29469":41023,"_29471":41026,"_29473":41029,"_29475":41032,"_29477":41035,"_29479":41038,"_29481":41041,"_29483":41044,"_29485":41047,"_29487":41050,"_29489":41053,"_29491":41056,"_29493":41059,"_29495":41062,"_29497":41065,"_29499":41068,"_29501":41071,"_29503":41074,"_29505":41077,"_29507":41080,"_29509":41083,"_29511":41086,"_29513":41089,"_29515":41092,"_29517":41095,"_29519":41098,"_29521":41101,"_29523":41104,"_29525":41107,"_29527":41110,"_29529":41113,"_29531":41116,"_29533":41119,"_29535":41122,"_29537":41125,"_29539":41128,"_29541":41131,"_29543":41134,"_29545":41137,"_29547":41140,"_29549":41143,"_29551":41146,"_29553":41149,"_29555":41152,"_29557":41156,"_29559":41160,"_29561":41164,"_29563":41167,"_29565":41170,"_29567":41173,"_29569":41176},{"_2303":15,"_22650":15,"_5":10649,"_1893":35254,"_22909":35255,"_15464":35259,"_21389":15},"Deploy from AWS Marketplace",[35256,35257,35258],"Docs","Deployment","Other models",[],{"_2303":16,"_22650":15,"_15464":35261,"_5":15353,"_21389":15,"_1893":35262},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_2303":17,"_22650":15,"_5":22906,"_15464":35264,"_21389":35265,"_1893":35266},[],"/docs/deployment/aws-marketplace#before-you-begin","Before you begin",{"_2303":18,"_22650":15,"_5":22906,"_15464":35268,"_21389":35269,"_1893":35270},[],"/docs/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_2303":19,"_22650":15,"_5":22906,"_15464":35272,"_21389":35273,"_1893":35274},[],"/docs/deployment/aws-marketplace#open-the-offer","Open the offer",{"_2303":20,"_22650":15,"_5":22906,"_15464":35276,"_21389":35277,"_1893":35278},[],"/docs/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_2303":21,"_22650":15,"_5":22906,"_15464":35280,"_21389":35281,"_1893":35282},[],"/docs/deployment/aws-marketplace#limit-network-access","Limit network access",{"_2303":22,"_22650":15,"_5":22906,"_15464":35284,"_21389":35285,"_1893":35286},[],"/docs/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_2303":23,"_22650":15,"_5":22906,"_15464":35288,"_21389":35289,"_1893":35290},[],"/docs/deployment/aws-marketplace#next-step","Next step",{"_2303":24,"_22650":15,"_15464":35292,"_5":15353,"_21389":15,"_1893":35293},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_2303":25,"_22650":15,"_15464":35295,"_5":15353,"_21389":35265,"_1893":35296},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_2303":26,"_22650":15,"_15464":35298,"_5":15353,"_21389":35265,"_1893":35299},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_2303":27,"_22650":15,"_15464":35301,"_5":15353,"_21389":35265,"_1893":35302},[],"A security group allowing the necessary endpoints.",{"_2303":28,"_22650":15,"_15464":35304,"_5":15353,"_21389":35269,"_1893":35305},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_2303":29,"_22650":15,"_15464":35307,"_5":15353,"_21389":35269,"_1893":35308},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_2303":30,"_22650":15,"_15464":35310,"_5":15353,"_21389":35269,"_1893":35311},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_2303":31,"_22650":15,"_15464":35313,"_5":15353,"_21389":35273,"_1893":35314},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_2303":32,"_22650":15,"_15464":35316,"_5":15353,"_21389":35277,"_1893":35317},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_2303":33,"_22650":15,"_15464":35319,"_5":15353,"_21389":35281,"_1893":35320},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_2303":34,"_22650":15,"_15464":35322,"_5":15353,"_21389":35285,"_1893":35323},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_2303":35,"_22650":15,"_15464":35325,"_5":15353,"_21389":35289,"_1893":35326},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_2303":36,"_22650":36,"_5":10649,"_1893":35328,"_22909":35329,"_15464":35330,"_21389":36},"Deploy Lamassu",[35256,35257],[],{"_2303":37,"_22650":36,"_15464":35332,"_5":15353,"_21389":36,"_1893":35333},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_2303":38,"_22650":36,"_5":22906,"_15464":35335,"_21389":35336,"_1893":35337},[],"/docs/deployment/overview#choose-a-model","Choose a model",{"_2303":39,"_22650":36,"_5":22906,"_15464":35339,"_21389":35340,"_1893":35341},[],"/docs/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_2303":40,"_22650":36,"_5":22906,"_15464":35343,"_21389":35344,"_1893":35345},[],"/docs/deployment/overview#after-deployment","After deployment",{"_2303":41,"_22650":36,"_15464":35347,"_5":15353,"_21389":36,"_1893":35348},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_2303":42,"_22650":36,"_15464":35350,"_5":15353,"_21389":35336,"_1893":35351},[],"Model",{"_2303":43,"_22650":36,"_15464":35353,"_5":15353,"_21389":35336,"_1893":35354},[],"Recommended for",{"_2303":44,"_22650":36,"_15464":35356,"_5":15353,"_21389":35336,"_1893":35357},[],"Who operates the infrastructure",{"_2303":45,"_22650":36,"_15464":35359,"_5":15353,"_21389":35336,"_1893":35360},[],"Starting point",{"_2303":46,"_22650":36,"_15464":35362,"_5":15353,"_21389":35336,"_1893":35363},[],"Kubernetes self-managed",{"_2303":47,"_22650":36,"_15464":35365,"_5":15353,"_21389":35336,"_1893":35366},[],"Production, regulated environments and custom deployments",{"_2303":48,"_22650":36,"_15464":35368,"_5":15353,"_21389":35336,"_1893":35369},[],"Your team",{"_2303":49,"_22650":36,"_15464":35371,"_5":15353,"_21389":35336,"_1893":35372},[],"Helm or Fastlane",{"_2303":50,"_22650":36,"_15464":35374,"_5":15353,"_21389":35336,"_1893":35375},[],"AWS Marketplace",{"_2303":51,"_22650":36,"_15464":35377,"_5":15353,"_21389":35336,"_1893":35378},[],"Evaluation or a dedicated deployment inside an AWS account",{"_2303":52,"_22650":36,"_15464":35380,"_5":15353,"_21389":35336,"_1893":35369},[],{"_2303":53,"_22650":36,"_15464":35382,"_5":15353,"_21389":35336,"_1893":35383},[],"Preconfigured image on EC2",{"_2303":54,"_22650":36,"_15464":35385,"_5":15353,"_21389":35336,"_1893":35386},[],"SaaS",{"_2303":55,"_22650":36,"_15464":35388,"_5":15353,"_21389":35336,"_1893":35389},[],"Teams that want to use the platform without operating it",{"_2303":56,"_22650":36,"_15464":35391,"_5":15353,"_21389":35336,"_1893":35392},[],"Lamassu",{"_2303":57,"_22650":36,"_15464":35394,"_5":15353,"_21389":35336,"_1893":35395},[],"Managed subscription",{"_2303":58,"_22650":36,"_15464":35397,"_5":15353,"_21389":35336,"_1893":35398},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2303":59,"_22650":36,"_15464":35400,"_5":15353,"_21389":35336,"_1893":35401},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2303":60,"_22650":36,"_15464":35403,"_5":15353,"_21389":35336,"_1893":35404},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_2303":61,"_22650":36,"_15464":35406,"_5":15353,"_21389":35340,"_1893":35407},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_2303":62,"_22650":36,"_15464":35409,"_5":15353,"_21389":35344,"_1893":35410},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_2303":63,"_22650":63,"_5":10649,"_1893":35412,"_22909":35413,"_15464":35414,"_21389":63},"Use Lamassu as SaaS",[35256,35257,35258],[],{"_2303":64,"_22650":63,"_15464":35416,"_5":15353,"_21389":63,"_1893":35417},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_2303":65,"_22650":63,"_5":22906,"_15464":35419,"_21389":35420,"_1893":35421},[],"/docs/deployment/saas#what-the-service-manages","What the service manages",{"_2303":66,"_22650":63,"_5":22906,"_15464":35423,"_21389":35424,"_1893":35425},[],"/docs/deployment/saas#plans","Plans",{"_2303":67,"_22650":63,"_5":22906,"_15464":35427,"_21389":35428,"_1893":35429},[],"/docs/deployment/saas#request-access","Request access",{"_2303":68,"_22650":63,"_15464":35431,"_5":15353,"_21389":63,"_1893":35432},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_2303":69,"_22650":63,"_15464":35434,"_5":15353,"_21389":35420,"_1893":35435},[],"Platform availability and maintenance.",{"_2303":70,"_22650":63,"_15464":35437,"_5":15353,"_21389":35420,"_1893":35438},[],"Automatic backups.",{"_2303":71,"_22650":63,"_15464":35440,"_5":15353,"_21389":35420,"_1893":35441},[],"Version upgrades.",{"_2303":72,"_22650":63,"_15464":35443,"_5":15353,"_21389":35420,"_1893":35444},[],"Technical support and SLA according to your plan.",{"_2303":73,"_22650":63,"_15464":35446,"_5":15353,"_21389":35424,"_1893":35447},[],"Plan",{"_2303":74,"_22650":63,"_15464":35449,"_5":15353,"_21389":35424,"_1893":35450},[],"Devices",{"_2303":75,"_22650":63,"_15464":35452,"_5":15353,"_21389":35424,"_1893":35453},[],"Support",{"_2303":76,"_22650":63,"_15464":35455,"_5":15353,"_21389":35424,"_1893":35456},[],"SLA",{"_2303":77,"_22650":63,"_15464":35458,"_5":15353,"_21389":35424,"_1893":35459},[],"Starter",{"_2303":78,"_22650":63,"_15464":35461,"_5":15353,"_21389":35424,"_1893":35462},[],"Up to 1,000",{"_2303":79,"_22650":63,"_15464":35464,"_5":15353,"_21389":35424,"_1893":35465},[],"Email",{"_2303":80,"_22650":63,"_15464":35467,"_5":15353,"_21389":35424,"_1893":35468},[],"99.5 %",{"_2303":81,"_22650":63,"_15464":35470,"_5":15353,"_21389":35424,"_1893":35471},[],"Professional",{"_2303":82,"_22650":63,"_15464":35473,"_5":15353,"_21389":35424,"_1893":35474},[],"Up to 10,000",{"_2303":83,"_22650":63,"_15464":35476,"_5":15353,"_21389":35424,"_1893":35477},[],"Email and chat",{"_2303":84,"_22650":63,"_15464":35479,"_5":15353,"_21389":35424,"_1893":35480},[],"99.9 %",{"_2303":85,"_22650":63,"_15464":35482,"_5":15353,"_21389":35424,"_1893":35483},[],"Enterprise",{"_2303":86,"_22650":63,"_15464":35485,"_5":15353,"_21389":35424,"_1893":35486},[],"Unlimited",{"_2303":87,"_22650":63,"_15464":35488,"_5":15353,"_21389":35424,"_1893":35489},[],"Dedicated",{"_2303":88,"_22650":63,"_15464":35491,"_5":15353,"_21389":35424,"_1893":35492},[],"99.99 %",{"_2303":89,"_22650":63,"_15464":35494,"_5":15353,"_21389":35428,"_1893":35495},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_2303":90,"_22650":63,"_15464":35497,"_5":15353,"_21389":35428,"_1893":35498},[],"When you receive your instance's credentials, continue with Get started.",{"_2303":91,"_22650":91,"_5":10649,"_1893":35500,"_22909":35501,"_15464":35502,"_21389":91},"Fastlane",[35256,35257,35363],[],{"_2303":92,"_22650":91,"_15464":35504,"_5":15353,"_21389":91,"_1893":35505},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_2303":93,"_22650":91,"_5":22906,"_15464":35507,"_21389":35508,"_1893":35509},[],"/docs/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_2303":94,"_22650":91,"_5":22906,"_15464":35511,"_21389":35512,"_1893":35513},[],"/docs/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_2303":95,"_22650":91,"_5":22906,"_15464":35515,"_21389":35516,"_1893":35266},[],"/docs/deployment/self-hosted/fastlane#before-you-begin",{"_2303":96,"_22650":91,"_5":22906,"_15464":35518,"_21389":35519,"_1893":35520},[],"/docs/deployment/self-hosted/fastlane#quick-start","Quick start",{"_2303":97,"_22650":91,"_5":22906,"_15464":35522,"_21389":35523,"_1893":35524},[],"/docs/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_2303":98,"_22650":91,"_5":22906,"_15464":35526,"_21389":35527,"_1893":35528},[],"/docs/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_2303":99,"_22650":91,"_5":22906,"_15464":35530,"_21389":35531,"_1893":35532},[],"/docs/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_2303":100,"_22650":91,"_5":22906,"_15464":35534,"_21389":35535,"_1893":35536},[],"/docs/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_2303":101,"_22650":91,"_5":22906,"_15464":35538,"_21389":35539,"_1893":35540},[],"/docs/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_2303":102,"_22650":91,"_5":22906,"_15464":35542,"_21389":35543,"_1893":35544},[],"/docs/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_2303":103,"_22650":91,"_15464":35546,"_5":15353,"_21389":35508,"_1893":35547},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_2303":104,"_22650":91,"_15464":35549,"_5":15353,"_21389":35508,"_1893":35550},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_2303":105,"_22650":91,"_15464":35552,"_5":15353,"_21389":35512,"_1893":35553},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_2303":106,"_22650":91,"_15464":35555,"_5":15353,"_21389":35512,"_1893":35556},[],"Fastlane installs or configures",{"_2303":107,"_22650":91,"_15464":35558,"_5":15353,"_21389":35512,"_1893":35559},[],"You still provide",{"_2303":108,"_22650":91,"_15464":35561,"_5":15353,"_21389":35512,"_1893":35562},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_2303":109,"_22650":91,"_15464":35564,"_5":15353,"_21389":35512,"_1893":35565},[],"The Kubernetes cluster, nodes and persistent storage",{"_2303":110,"_22650":91,"_15464":35567,"_5":15353,"_21389":35512,"_1893":35568},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_2303":111,"_22650":91,"_15464":35570,"_5":15353,"_21389":35512,"_1893":35571},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_2303":112,"_22650":91,"_15464":35573,"_5":15353,"_21389":35512,"_1893":35574},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_2303":113,"_22650":91,"_15464":35576,"_5":15353,"_21389":35512,"_1893":35577},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_2303":114,"_22650":91,"_15464":35579,"_5":15353,"_21389":35512,"_1893":35580},[],"Optional observability and lab HSM components",{"_2303":115,"_22650":91,"_15464":35582,"_5":15353,"_21389":35512,"_1893":35583},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_2303":116,"_22650":91,"_15464":35585,"_5":15353,"_21389":35512,"_1893":35586},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_2303":117,"_22650":91,"_15464":35588,"_5":15353,"_21389":35516,"_1893":35589},[],"You need:",{"_2303":118,"_22650":91,"_15464":35591,"_5":15353,"_21389":35516,"_1893":35592},[],"an existing Kubernetes cluster",{"_2303":119,"_22650":91,"_15464":35594,"_5":15353,"_21389":35516,"_1893":35595},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_2303":120,"_22650":91,"_15464":35597,"_5":15353,"_21389":35516,"_1893":35598},[],"`yq`",{"_2303":121,"_22650":91,"_15464":35600,"_5":15353,"_21389":35516,"_1893":17583},[],{"_2303":122,"_22650":91,"_15464":35602,"_5":15353,"_21389":35516,"_1893":35603},[],"`jq` only when using `--sample-data`",{"_2303":123,"_22650":91,"_15464":35605,"_5":15353,"_21389":35516,"_1893":35606},[],"free external ports 80 and 443 on a single-node K3s host",{"_2303":124,"_22650":91,"_15464":35608,"_5":15353,"_21389":35516,"_1893":35609},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_2303":125,"_22650":91,"_15464":35611,"_5":15353,"_21389":35516,"_1893":35612},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_2303":126,"_22650":91,"_15464":35614,"_5":15353,"_21389":35519,"_1893":35615},[],"Run the script from a clone of the Helm repository:",{"_2303":127,"_22650":91,"_15464":35617,"_5":15353,"_21389":35519,"_1893":35618},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_2303":128,"_22650":91,"_15464":35620,"_5":15353,"_21389":35523,"_1893":35621},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_2303":129,"_22650":91,"_15464":35623,"_5":15353,"_21389":35523,"_1893":35624},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_2303":130,"_22650":91,"_15464":35626,"_5":15353,"_21389":35523,"_1893":35627},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_2303":131,"_22650":91,"_15464":35629,"_5":15353,"_21389":35523,"_1893":35630},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_2303":132,"_22650":91,"_15464":35632,"_5":15353,"_21389":35527,"_1893":35633},[],"Option",{"_2303":133,"_22650":91,"_15464":35635,"_5":15353,"_21389":35527,"_1893":35636},[],"Default",{"_2303":134,"_22650":91,"_15464":35638,"_5":15353,"_21389":35527,"_1893":35639},[],"Purpose",{"_2303":135,"_22650":91,"_15464":35641,"_5":15353,"_21389":35527,"_1893":35642},[],"`-h`, `--help`",{"_2303":136,"_22650":91,"_15464":35644,"_5":15353,"_21389":35527,"_1893":35645},[],"—",{"_2303":137,"_22650":91,"_15464":35647,"_5":15353,"_21389":35527,"_1893":35648},[],"Show help",{"_2303":138,"_22650":91,"_15464":35650,"_5":15353,"_21389":35527,"_1893":35651},[],"`-c`, `--context`",{"_2303":139,"_22650":91,"_15464":35653,"_5":15353,"_21389":35527,"_1893":35654},[],"current context",{"_2303":140,"_22650":91,"_15464":35656,"_5":15353,"_21389":35527,"_1893":35657},[],"Select the kubeconfig context for kubectl and Helm",{"_2303":141,"_22650":91,"_15464":35659,"_5":15353,"_21389":35527,"_1893":35660},[],"`-n`, `--non-interactive`",{"_2303":142,"_22650":91,"_15464":35662,"_5":15353,"_21389":35527,"_1893":4394},[],{"_2303":143,"_22650":91,"_15464":35664,"_5":15353,"_21389":35527,"_1893":35665},[],"Skip prompts and generate dependency credentials",{"_2303":144,"_22650":91,"_15464":35667,"_5":15353,"_21389":35527,"_1893":35668},[],"`-ns`, `--namespace`",{"_2303":145,"_22650":91,"_15464":35670,"_5":15353,"_21389":35527,"_1893":35671},[],"`lamassu-dev`",{"_2303":146,"_22650":91,"_15464":35673,"_5":15353,"_21389":35527,"_1893":35674},[],"Namespace for the installation",{"_2303":147,"_22650":91,"_15464":35676,"_5":15353,"_21389":35527,"_1893":35677},[],"`-d`, `--domain`",{"_2303":148,"_22650":91,"_15464":35679,"_5":15353,"_21389":35527,"_1893":35680},[],"`dev.lamassu.io`",{"_2303":149,"_22650":91,"_15464":35682,"_5":15353,"_21389":35527,"_1893":35683},[],"Domain used by the UI, OIDC and certificate",{"_2303":150,"_22650":91,"_15464":35685,"_5":15353,"_21389":35527,"_1893":35686},[],"`-v`, `--version`",{"_2303":151,"_22650":91,"_15464":35688,"_5":15353,"_21389":35527,"_1893":10851},[],{"_2303":152,"_22650":91,"_15464":35690,"_5":15353,"_21389":35527,"_1893":35691},[],"Lamassu chart version",{"_2303":153,"_22650":91,"_15464":35693,"_5":15353,"_21389":35527,"_1893":35694},[],"`--https-port`",{"_2303":154,"_22650":91,"_15464":35696,"_5":15353,"_21389":35527,"_1893":35697},[],"`443`",{"_2303":155,"_22650":91,"_15464":35699,"_5":15353,"_21389":35527,"_1893":35700},[],"Gateway HTTPS listener port",{"_2303":156,"_22650":91,"_15464":35702,"_5":15353,"_21389":35527,"_1893":35703},[],"`--http-port`",{"_2303":157,"_22650":91,"_15464":35705,"_5":15353,"_21389":35527,"_1893":35706},[],"`80`",{"_2303":158,"_22650":91,"_15464":35708,"_5":15353,"_21389":35527,"_1893":35709},[],"Gateway HTTP listener port",{"_2303":159,"_22650":91,"_15464":35711,"_5":15353,"_21389":35527,"_1893":35712},[],"`--tls-crt`",{"_2303":160,"_22650":91,"_15464":35714,"_5":15353,"_21389":35527,"_1893":35645},[],{"_2303":161,"_22650":91,"_15464":35716,"_5":15353,"_21389":35527,"_1893":35717},[],"PEM certificate for downstream TLS",{"_2303":162,"_22650":91,"_15464":35719,"_5":15353,"_21389":35527,"_1893":35720},[],"`--tls-key`",{"_2303":163,"_22650":91,"_15464":35722,"_5":15353,"_21389":35527,"_1893":35645},[],{"_2303":164,"_22650":91,"_15464":35724,"_5":15353,"_21389":35527,"_1893":35725},[],"PEM private key for downstream TLS",{"_2303":165,"_22650":91,"_15464":35727,"_5":15353,"_21389":35527,"_1893":35728},[],"`-l`, `--local-chart-path`",{"_2303":166,"_22650":91,"_15464":35730,"_5":15353,"_21389":35527,"_1893":35731},[],"repository chart",{"_2303":167,"_22650":91,"_15464":35733,"_5":15353,"_21389":35527,"_1893":35734},[],"Use an unpacked local Lamassu chart",{"_2303":168,"_22650":91,"_15464":35736,"_5":15353,"_21389":35527,"_1893":35737},[],"`-ip`, `--gateway-ip`",{"_2303":169,"_22650":91,"_15464":35739,"_5":15353,"_21389":35527,"_1893":6201},[],{"_2303":170,"_22650":91,"_15464":35741,"_5":15353,"_21389":35527,"_1893":35742},[],"Override the address written to `gateway.addresses`",{"_2303":171,"_22650":91,"_15464":35744,"_5":15353,"_21389":35527,"_1893":35745},[],"`--otel`",{"_2303":172,"_22650":91,"_15464":35747,"_5":15353,"_21389":35527,"_1893":4394},[],{"_2303":173,"_22650":91,"_15464":35749,"_5":15353,"_21389":35527,"_1893":35750},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_2303":174,"_22650":91,"_15464":35752,"_5":15353,"_21389":35527,"_1893":35753},[],"`--sample-data`",{"_2303":175,"_22650":91,"_15464":35755,"_5":15353,"_21389":35527,"_1893":4394},[],{"_2303":176,"_22650":91,"_15464":35757,"_5":15353,"_21389":35527,"_1893":35758},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_2303":177,"_22650":91,"_15464":35760,"_5":15353,"_21389":35527,"_1893":35761},[],"`--with-hsm`",{"_2303":178,"_22650":91,"_15464":35763,"_5":15353,"_21389":35527,"_1893":4394},[],{"_2303":179,"_22650":91,"_15464":35765,"_5":15353,"_21389":35527,"_1893":35766},[],"Install lab HSM components and configure KMS for PKCS#11",{"_2303":180,"_22650":91,"_15464":35768,"_5":15353,"_21389":35527,"_1893":35769},[],"`--softhsm-chart-path`",{"_2303":181,"_22650":91,"_15464":35771,"_5":15353,"_21389":35527,"_1893":35772},[],"`./charts/softhsm`",{"_2303":182,"_22650":91,"_15464":35774,"_5":15353,"_21389":35527,"_1893":35775},[],"Use a different local SoftHSM chart",{"_2303":183,"_22650":91,"_15464":35777,"_5":15353,"_21389":35527,"_1893":35778},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_2303":184,"_22650":91,"_15464":35780,"_5":15353,"_21389":35531,"_1893":35781},[],"Fastlane:",{"_2303":185,"_22650":91,"_15464":35783,"_5":15353,"_21389":35531,"_1893":35784},[],"validates local tools and the selected cluster",{"_2303":186,"_22650":91,"_15464":35786,"_5":15353,"_21389":35531,"_1893":35787},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_2303":187,"_22650":91,"_15464":35789,"_5":15353,"_21389":35531,"_1893":35790},[],"creates the namespace",{"_2303":188,"_22650":91,"_15464":35792,"_5":15353,"_21389":35531,"_1893":35793},[],"installs PostgreSQL and creates the required databases",{"_2303":189,"_22650":91,"_15464":35795,"_5":15353,"_21389":35531,"_1893":35796},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_2303":190,"_22650":91,"_15464":35798,"_5":15353,"_21389":35531,"_1893":35799},[],"installs RabbitMQ",{"_2303":191,"_22650":91,"_15464":35801,"_5":15353,"_21389":35531,"_1893":35802},[],"optionally installs observability and lab HSM components",{"_2303":192,"_22650":91,"_15464":35804,"_5":15353,"_21389":35531,"_1893":35805},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_2303":193,"_22650":91,"_15464":35807,"_5":15353,"_21389":35531,"_1893":35808},[],"optionally loads sample data",{"_2303":194,"_22650":91,"_15464":35810,"_5":15353,"_21389":35531,"_1893":35811},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_2303":195,"_22650":91,"_15464":35813,"_5":15353,"_21389":35535,"_1893":35814},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_2303":196,"_22650":91,"_15464":35816,"_5":15353,"_21389":35535,"_1893":35817},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_2303":197,"_22650":91,"_15464":35819,"_5":15353,"_21389":35539,"_1893":35820},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use.",{"_2303":198,"_22650":91,"_15464":35822,"_5":15353,"_21389":35539,"_1893":35823},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_2303":199,"_22650":91,"_15464":35825,"_5":15353,"_21389":35539,"_1893":35826},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_2303":200,"_22650":91,"_15464":35828,"_5":15353,"_21389":35543,"_1893":35829},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_2303":201,"_22650":201,"_5":10649,"_1893":35831,"_22909":35832,"_15464":35833,"_21389":201},"Install with Helm",[35256,35257,35363],[],{"_2303":202,"_22650":201,"_15464":35835,"_5":15353,"_21389":201,"_1893":35836},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_2303":203,"_22650":201,"_5":22906,"_15464":35838,"_21389":35839,"_1893":35840},[],"/docs/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_2303":204,"_22650":201,"_5":22906,"_15464":35842,"_21389":35843,"_1893":35266},[],"/docs/deployment/self-hosted/helm#before-you-begin",{"_2303":205,"_22650":201,"_5":22906,"_15464":35845,"_21389":35846,"_1893":35847},[],"/docs/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_2303":206,"_22650":201,"_5":22906,"_15464":35849,"_21389":35850,"_1893":35851},[],"/docs/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_2303":207,"_22650":201,"_5":22906,"_15464":35853,"_21389":35854,"_1893":35855},[],"/docs/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_2303":208,"_22650":201,"_5":22906,"_15464":35857,"_21389":35858,"_1893":35859},[],"/docs/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_2303":209,"_22650":201,"_5":22906,"_15464":35861,"_21389":35862,"_1893":35863},[],"/docs/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_2303":210,"_22650":201,"_5":22906,"_15464":35865,"_21389":35866,"_1893":35867},[],"/docs/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_2303":211,"_22650":201,"_5":22906,"_15464":35869,"_21389":35870,"_1893":35871},[],"/docs/deployment/self-hosted/helm#production-decisions","Production decisions",{"_2303":212,"_22650":201,"_15464":35873,"_5":15353,"_21389":35839,"_1893":35874},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_2303":213,"_22650":201,"_15464":35876,"_5":15353,"_21389":35843,"_1893":35877},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_2303":214,"_22650":201,"_15464":35879,"_5":15353,"_21389":35843,"_1893":35880},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_2303":215,"_22650":201,"_15464":35882,"_5":15353,"_21389":35843,"_1893":35883},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_2303":216,"_22650":201,"_15464":35885,"_5":15353,"_21389":35843,"_1893":35886},[],"a reachable RabbitMQ broker and credentials",{"_2303":217,"_22650":201,"_15464":35888,"_5":15353,"_21389":35843,"_1893":35889},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_2303":218,"_22650":201,"_15464":35891,"_5":15353,"_21389":35843,"_1893":35892},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_2303":219,"_22650":201,"_15464":35894,"_5":15353,"_21389":35843,"_1893":35895},[],"cert-manager 1.14+; for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_2303":220,"_22650":201,"_15464":35897,"_5":15353,"_21389":35843,"_1893":35898},[],"a StorageClass and an external traffic design",{"_2303":221,"_22650":201,"_15464":35900,"_5":15353,"_21389":35843,"_1893":35901},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_2303":222,"_22650":201,"_15464":35903,"_5":15353,"_21389":35843,"_1893":35904},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_2303":223,"_22650":201,"_15464":35906,"_5":15353,"_21389":35843,"_1893":35907},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_2303":224,"_22650":201,"_15464":35909,"_5":15353,"_21389":35846,"_1893":35910},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_2303":225,"_22650":201,"_15464":35912,"_5":15353,"_21389":35846,"_1893":35913},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_2303":226,"_22650":201,"_15464":35915,"_5":15353,"_21389":35846,"_1893":35916},[],"Install cert-manager separately before Lamassu. The current chart renders its self-signed issuer and CA certificate resources even when `tls.type: external` makes the Gateway use an existing TLS Secret. Selecting external TLS therefore does not remove the cert-manager prerequisite.",{"_2303":227,"_22650":201,"_15464":35918,"_5":15353,"_21389":35850,"_1893":35919},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_2303":228,"_22650":201,"_15464":35921,"_5":15353,"_21389":35850,"_1893":35922},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_2303":229,"_22650":201,"_15464":35924,"_5":15353,"_21389":35850,"_1893":35925},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_2303":230,"_22650":201,"_15464":35927,"_5":15353,"_21389":35854,"_1893":35928},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it:",{"_2303":231,"_22650":201,"_15464":35930,"_5":15353,"_21389":35858,"_1893":35931},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_2303":232,"_22650":201,"_15464":35933,"_5":15353,"_21389":35858,"_1893":35934},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_2303":233,"_22650":201,"_15464":35936,"_5":15353,"_21389":35858,"_1893":35937},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_2303":234,"_22650":201,"_15464":35939,"_5":15353,"_21389":35858,"_1893":35940},[],"See Access control for the principal and policy model.",{"_2303":235,"_22650":201,"_15464":35942,"_5":15353,"_21389":35862,"_1893":35943},[],"To install a local checkout instead:",{"_2303":236,"_22650":201,"_15464":35945,"_5":15353,"_21389":35866,"_1893":35946},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_2303":237,"_22650":201,"_15464":35948,"_5":15353,"_21389":35866,"_1893":35949},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_2303":238,"_22650":201,"_15464":35951,"_5":15353,"_21389":35870,"_1893":35952},[],"Before going live, review:",{"_2303":239,"_22650":201,"_15464":35954,"_5":15353,"_21389":35870,"_1893":35955},[],"backup and recovery for PostgreSQL and persistent volumes",{"_2303":240,"_22650":201,"_15464":35957,"_5":15353,"_21389":35870,"_1893":35958},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_2303":241,"_22650":201,"_15464":35960,"_5":15353,"_21389":35870,"_1893":35961},[],"shared VA storage before increasing VA replicas",{"_2303":242,"_22650":201,"_15464":35963,"_5":15353,"_21389":35870,"_1893":35964},[],"managed OIDC roles and removal of evaluation credentials",{"_2303":243,"_22650":201,"_15464":35966,"_5":15353,"_21389":35870,"_1893":35967},[],"a trusted TLS issuer or externally managed certificate",{"_2303":244,"_22650":201,"_15464":35969,"_5":15353,"_21389":35870,"_1893":35970},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_2303":245,"_22650":201,"_15464":35972,"_5":15353,"_21389":35870,"_1893":35973},[],"SMTP, observability and alert delivery",{"_2303":246,"_22650":201,"_15464":35975,"_5":15353,"_21389":35870,"_1893":35976},[],"the migration notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_2303":247,"_22650":201,"_15464":35978,"_5":15353,"_21389":35870,"_1893":35979},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_2303":248,"_22650":248,"_5":10649,"_1893":35981,"_22909":35982,"_15464":35983,"_21389":248},"Expose the Gateway",[35256,35257,35363],[],{"_2303":249,"_22650":248,"_15464":35985,"_5":15353,"_21389":248,"_1893":35986},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_2303":250,"_22650":248,"_5":22906,"_15464":35988,"_21389":35989,"_1893":35990},[],"/docs/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_2303":251,"_22650":248,"_5":22906,"_15464":35992,"_21389":35993,"_1893":35994},[],"/docs/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_2303":252,"_22650":248,"_5":22906,"_15464":35996,"_21389":35997,"_1893":35998},[],"/docs/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_2303":253,"_22650":248,"_5":22906,"_15464":36000,"_21389":36001,"_1893":36002},[],"/docs/deployment/self-hosted/networking#k3s","K3s",{"_2303":254,"_22650":248,"_5":22906,"_15464":36004,"_21389":36005,"_1893":36006},[],"/docs/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_2303":255,"_22650":248,"_5":22906,"_15464":36008,"_21389":36009,"_1893":36010},[],"/docs/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_2303":256,"_22650":248,"_5":22906,"_15464":36012,"_21389":36013,"_1893":36014},[],"/docs/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_2303":257,"_22650":248,"_5":22906,"_15464":36016,"_21389":36017,"_1893":36018},[],"/docs/deployment/self-hosted/networking#decision-guide","Decision guide",{"_2303":258,"_22650":248,"_5":22906,"_15464":36020,"_21389":36021,"_1893":36022},[],"/docs/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_2303":259,"_22650":248,"_15464":36024,"_5":15353,"_21389":35989,"_1893":36025},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_2303":260,"_22650":248,"_15464":36027,"_5":15353,"_21389":35989,"_1893":36028},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_2303":261,"_22650":248,"_15464":36030,"_5":15353,"_21389":35993,"_1893":36031},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_2303":262,"_22650":248,"_15464":36033,"_5":15353,"_21389":35993,"_1893":36034},[],"Set it only when:",{"_2303":263,"_22650":248,"_15464":36036,"_5":15353,"_21389":35993,"_1893":36037},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_2303":264,"_22650":248,"_15464":36039,"_5":15353,"_21389":35993,"_1893":36040},[],"that address is allocated to this Gateway",{"_2303":265,"_22650":248,"_15464":36042,"_5":15353,"_21389":35993,"_1893":36043},[],"the surrounding network already routes traffic for it to the cluster",{"_2303":266,"_22650":248,"_15464":36045,"_5":15353,"_21389":35993,"_1893":36046},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_2303":267,"_22650":248,"_15464":36048,"_5":15353,"_21389":35993,"_1893":36049},[],"Keep these two settings separate:",{"_2303":268,"_22650":248,"_15464":36051,"_5":15353,"_21389":35993,"_1893":36052},[],"`gateway.addresses` requests an address for the Gateway.",{"_2303":269,"_22650":248,"_15464":36054,"_5":15353,"_21389":35993,"_1893":36055},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_2303":270,"_22650":248,"_15464":36057,"_5":15353,"_21389":35993,"_1893":36058},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_2303":271,"_22650":248,"_15464":36060,"_5":15353,"_21389":35997,"_1893":36061},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_2303":272,"_22650":248,"_15464":36063,"_5":15353,"_21389":35997,"_1893":36064},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_2303":273,"_22650":248,"_15464":36066,"_5":15353,"_21389":36001,"_1893":36067},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_2303":274,"_22650":248,"_15464":36069,"_5":15353,"_21389":36001,"_1893":36070},[],"For the recommended design:",{"_2303":275,"_22650":248,"_15464":36072,"_5":15353,"_21389":36001,"_1893":36073},[],"Use only one externally exposed Lamassu Gateway.",{"_2303":276,"_22650":248,"_15464":36075,"_5":15353,"_21389":36001,"_1893":36076},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_2303":277,"_22650":248,"_15464":36078,"_5":15353,"_21389":36001,"_1893":36079},[],"Allow those ports through the VM firewall and any upstream security group.",{"_2303":278,"_22650":248,"_15464":36081,"_5":15353,"_21389":36001,"_1893":36082},[],"Point DNS at the VM's reachable address.",{"_2303":279,"_22650":248,"_15464":36084,"_5":15353,"_21389":36001,"_1893":36085},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_2303":280,"_22650":248,"_15464":36087,"_5":15353,"_21389":36005,"_1893":36088},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_2303":281,"_22650":248,"_15464":36090,"_5":15353,"_21389":36009,"_1893":36091},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_2303":282,"_22650":248,"_15464":36093,"_5":15353,"_21389":36009,"_1893":36094},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_2303":283,"_22650":248,"_15464":36096,"_5":15353,"_21389":36013,"_1893":36097},[],"First decide whether you need three independent data planes or only three hostnames.",{"_2303":284,"_22650":248,"_15464":36099,"_5":15353,"_21389":36013,"_1893":36100},[],"Requirement",{"_2303":285,"_22650":248,"_15464":36102,"_5":15353,"_21389":36013,"_1893":36103},[],"Recommended design",{"_2303":286,"_22650":248,"_15464":36105,"_5":15353,"_21389":36013,"_1893":36106},[],"Consequence",{"_2303":287,"_22650":248,"_15464":36108,"_5":15353,"_21389":36013,"_1893":36109},[],"Several Lamassu URLs or services",{"_2303":288,"_22650":248,"_15464":36111,"_5":15353,"_21389":36013,"_1893":36112},[],"One Gateway with multiple routes",{"_2303":289,"_22650":248,"_15464":36114,"_5":15353,"_21389":36013,"_1893":36115},[],"One IP and one proxy fleet; this is the chart default",{"_2303":290,"_22650":248,"_15464":36117,"_5":15353,"_21389":36013,"_1893":36118},[],"Independent Gateways and separate external IPs",{"_2303":291,"_22650":248,"_15464":36120,"_5":15353,"_21389":36013,"_1893":36121},[],"One VIP per Gateway",{"_2303":292,"_22650":248,"_15464":36123,"_5":15353,"_21389":36013,"_1893":36124},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_2303":293,"_22650":248,"_15464":36126,"_5":15353,"_21389":36013,"_1893":36127},[],"Independent Gateways on one node and one IP",{"_2303":294,"_22650":248,"_15464":36129,"_5":15353,"_21389":36013,"_1893":36130},[],"Use different external ports",{"_2303":295,"_22650":248,"_15464":36132,"_5":15353,"_21389":36013,"_1893":36133},[],"Clients must include non-standard ports",{"_2303":296,"_22650":248,"_15464":36135,"_5":15353,"_21389":36013,"_1893":36136},[],"Separate TLS/mTLS termination behind one IP",{"_2303":297,"_22650":248,"_15464":36138,"_5":15353,"_21389":36013,"_1893":36139},[],"Front-door SNI routing to internal Gateways",{"_2303":298,"_22650":248,"_15464":36141,"_5":15353,"_21389":36013,"_1893":36142},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_2303":299,"_22650":248,"_15464":36144,"_5":15353,"_21389":36013,"_1893":36145},[],"Separate Gateway resources but shared proxy infrastructure",{"_2303":300,"_22650":248,"_15464":36147,"_5":15353,"_21389":36013,"_1893":36148},[],"Envoy merged-Gateway mode",{"_2303":301,"_22650":248,"_15464":36150,"_5":15353,"_21389":36013,"_1893":36151},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_2303":302,"_22650":248,"_15464":36153,"_5":15353,"_21389":36013,"_1893":36154},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_2303":303,"_22650":248,"_15464":36156,"_5":15353,"_21389":36013,"_1893":36157},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_2303":304,"_22650":248,"_15464":36159,"_5":15353,"_21389":36013,"_1893":36160},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_2303":305,"_22650":248,"_15464":36162,"_5":15353,"_21389":36013,"_1893":36163},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_2303":306,"_22650":248,"_15464":36165,"_5":15353,"_21389":36017,"_1893":36166},[],"If one Gateway can own TLS and routing, use the chart default.",{"_2303":307,"_22650":248,"_15464":36168,"_5":15353,"_21389":36017,"_1893":36169},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_2303":308,"_22650":248,"_15464":36171,"_5":15353,"_21389":36017,"_1893":36172},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_2303":309,"_22650":248,"_15464":36174,"_5":15353,"_21389":36017,"_1893":36175},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_2303":310,"_22650":248,"_15464":36177,"_5":15353,"_21389":36017,"_1893":36178},[],"If none of those are possible, use different external ports or change the external network design.",{"_2303":311,"_22650":248,"_15464":36180,"_5":15353,"_21389":36021,"_1893":36181},[],"Check, in order:",{"_2303":312,"_22650":248,"_15464":36183,"_5":15353,"_21389":36021,"_1893":36184},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_2303":313,"_22650":248,"_15464":36186,"_5":15353,"_21389":36021,"_1893":36187},[],"Its status contains the expected address.",{"_2303":314,"_22650":248,"_15464":36189,"_5":15353,"_21389":36021,"_1893":36190},[],"The generated `LoadBalancer` Service has a usable external address.",{"_2303":315,"_22650":248,"_15464":36192,"_5":15353,"_21389":36021,"_1893":36193},[],"Port 443 reaches that address from the client network.",{"_2303":316,"_22650":248,"_15464":36195,"_5":15353,"_21389":36021,"_1893":36196},[],"DNS resolves to the externally reachable endpoint.",{"_2303":317,"_22650":248,"_15464":36198,"_5":15353,"_21389":36021,"_1893":36199},[],"The certificate contains the DNS name or IP used by the client.",{"_2303":318,"_22650":248,"_15464":36201,"_5":15353,"_21389":36021,"_1893":36202},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_2303":319,"_22650":319,"_5":10649,"_1893":35363,"_22909":36204,"_15464":36205,"_21389":319},[35256,35257,35363],[],{"_2303":320,"_22650":319,"_15464":36207,"_5":15353,"_21389":319,"_1893":36208},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_2303":321,"_22650":319,"_5":22906,"_15464":36210,"_21389":36211,"_1893":36212},[],"/docs/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_2303":322,"_22650":319,"_5":22906,"_15464":36214,"_21389":36215,"_1893":36216},[],"/docs/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_2303":323,"_22650":319,"_5":22906,"_15464":36218,"_21389":36219,"_1893":36220},[],"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_2303":324,"_22650":319,"_5":22906,"_15464":36222,"_21389":36223,"_1893":36224},[],"/docs/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_2303":325,"_22650":319,"_5":22906,"_15464":36226,"_21389":36227,"_1893":36228},[],"/docs/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_2303":326,"_22650":319,"_5":22906,"_15464":36230,"_21389":36231,"_1893":36232},[],"/docs/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_2303":327,"_22650":319,"_15464":36234,"_5":15353,"_21389":36211,"_1893":36235},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_2303":328,"_22650":319,"_15464":36237,"_5":15353,"_21389":36215,"_1893":36238},[],"Workflow",{"_2303":329,"_22650":319,"_15464":36240,"_5":15353,"_21389":36215,"_1893":36241},[],"Use it for",{"_2303":330,"_22650":319,"_15464":36243,"_5":15353,"_21389":36215,"_1893":36244},[],"What it installs",{"_2303":331,"_22650":319,"_15464":36246,"_5":15353,"_21389":36215,"_1893":36247},[],"Helm",{"_2303":332,"_22650":319,"_15464":36249,"_5":15353,"_21389":36215,"_1893":36250},[],"Production and controlled environments",{"_2303":333,"_22650":319,"_15464":36252,"_5":15353,"_21389":36215,"_1893":36253},[],"Lamassu services and Gateway API resources",{"_2303":334,"_22650":319,"_15464":36255,"_5":15353,"_21389":36215,"_1893":35500},[],{"_2303":335,"_22650":319,"_15464":36257,"_5":15353,"_21389":36215,"_1893":36258},[],"Evaluation, demos, CI and small lab clusters",{"_2303":336,"_22650":319,"_15464":36260,"_5":15353,"_21389":36215,"_1893":36261},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_2303":337,"_22650":319,"_15464":36263,"_5":15353,"_21389":36219,"_1893":36264},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_2303":338,"_22650":319,"_15464":36266,"_5":15353,"_21389":36219,"_1893":36267},[],"Area",{"_2303":339,"_22650":319,"_15464":36269,"_5":15353,"_21389":36219,"_1893":36270},[],"The Lamassu chart provides",{"_2303":340,"_22650":319,"_15464":36272,"_5":15353,"_21389":36219,"_1893":36273},[],"You provide",{"_2303":341,"_22650":319,"_15464":36275,"_5":15353,"_21389":36219,"_1893":36276},[],"Lamassu applications",{"_2303":342,"_22650":319,"_15464":36278,"_5":15353,"_21389":36219,"_1893":36279},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_2303":343,"_22650":319,"_15464":36281,"_5":15353,"_21389":36219,"_1893":36282},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_2303":344,"_22650":319,"_15464":36284,"_5":15353,"_21389":36219,"_1893":36285},[],"PostgreSQL data",{"_2303":345,"_22650":319,"_15464":36287,"_5":15353,"_21389":36219,"_1893":36288},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_2303":346,"_22650":319,"_15464":36290,"_5":15353,"_21389":36219,"_1893":36291},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_2303":347,"_22650":319,"_15464":36293,"_5":15353,"_21389":36219,"_1893":36294},[],"Messaging",{"_2303":348,"_22650":319,"_15464":36296,"_5":15353,"_21389":36219,"_1893":36297},[],"RabbitMQ connection configuration for the Lamassu services",{"_2303":349,"_22650":319,"_15464":36299,"_5":15353,"_21389":36219,"_1893":36300},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_2303":350,"_22650":319,"_15464":36302,"_5":15353,"_21389":36219,"_1893":36303},[],"Identity",{"_2303":351,"_22650":319,"_15464":36305,"_5":15353,"_21389":36219,"_1893":36306},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_2303":352,"_22650":319,"_15464":36308,"_5":15353,"_21389":36219,"_1893":36309},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_2303":353,"_22650":319,"_15464":36311,"_5":15353,"_21389":36219,"_1893":36312},[],"External routing",{"_2303":354,"_22650":319,"_15464":36314,"_5":15353,"_21389":36219,"_1893":36315},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_2303":355,"_22650":319,"_15464":36317,"_5":15353,"_21389":36219,"_1893":36318},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_2303":356,"_22650":319,"_15464":36320,"_5":15353,"_21389":36219,"_1893":36321},[],"TLS",{"_2303":357,"_22650":319,"_15464":36323,"_5":15353,"_21389":36219,"_1893":36324},[],"cert-manager `Issuer` and CA `Certificate` resources; either a chart-managed downstream `Certificate` or a reference to your TLS Secret",{"_2303":358,"_22650":319,"_15464":36326,"_5":15353,"_21389":36219,"_1893":36327},[],"cert-manager itself; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_2303":359,"_22650":319,"_15464":36329,"_5":15353,"_21389":36219,"_1893":36330},[],"Persistent application data",{"_2303":360,"_22650":319,"_15464":36332,"_5":15353,"_21389":36219,"_1893":36333},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_2303":361,"_22650":319,"_15464":36335,"_5":15353,"_21389":36219,"_1893":36336},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_2303":362,"_22650":319,"_15464":36338,"_5":15353,"_21389":36219,"_1893":36339},[],"Optional integrations",{"_2303":363,"_22650":319,"_15464":36341,"_5":15353,"_21389":36219,"_1893":36342},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_2303":364,"_22650":319,"_15464":36344,"_5":15353,"_21389":36219,"_1893":36345},[],"The observability backends, cloud credentials and production HSM or external key service",{"_2303":365,"_22650":319,"_15464":36347,"_5":15353,"_21389":36219,"_1893":36348},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_2303":366,"_22650":319,"_15464":36350,"_5":15353,"_21389":36219,"_1893":36351},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_2303":367,"_22650":319,"_15464":36353,"_5":15353,"_21389":36223,"_1893":36354},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_2303":368,"_22650":319,"_15464":36356,"_5":15353,"_21389":36223,"_1893":36357},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_2303":369,"_22650":319,"_15464":36359,"_5":15353,"_21389":36227,"_1893":36360},[],"Kubernetes 1.24 or newer",{"_2303":370,"_22650":319,"_15464":36362,"_5":15353,"_21389":36227,"_1893":36363},[],"Helm 3.2 or newer",{"_2303":371,"_22650":319,"_15464":36365,"_5":15353,"_21389":36227,"_1893":36366},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_2303":372,"_22650":319,"_15464":36368,"_5":15353,"_21389":36227,"_1893":36369},[],"cert-manager 1.14 or newer; the current chart renders cert-manager issuer and certificate resources",{"_2303":373,"_22650":319,"_15464":36371,"_5":15353,"_21389":36227,"_1893":36372},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_2303":374,"_22650":319,"_15464":36374,"_5":15353,"_21389":36227,"_1893":36375},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_2303":375,"_22650":319,"_15464":36377,"_5":15353,"_21389":36227,"_1893":36378},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer.",{"_2303":376,"_22650":319,"_15464":36380,"_5":15353,"_21389":36231,"_1893":36381},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2303":377,"_22650":319,"_15464":36383,"_5":15353,"_21389":36231,"_1893":36384},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2303":378,"_22650":319,"_15464":36386,"_5":15353,"_21389":36231,"_1893":36387},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2303":379,"_22650":379,"_5":10649,"_1893":36389,"_22909":36390,"_15464":36393,"_21389":379},"Access control",[35256,36391,36392],"Platform","Administer Lamassu",[],{"_2303":380,"_22650":379,"_15464":36395,"_5":15353,"_21389":379,"_1893":36396},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_2303":381,"_22650":379,"_5":22906,"_15464":36398,"_21389":36399,"_1893":36400},[],"/docs/platform/pki/access-control#essential-concepts","Essential concepts",{"_2303":382,"_22650":379,"_5":22906,"_15464":36402,"_21389":36403,"_1893":36404},[],"/docs/platform/pki/access-control#two-decision-systems","Two decision systems",{"_2303":383,"_22650":379,"_5":22906,"_15464":36406,"_21389":36407,"_1893":36408},[],"/docs/platform/pki/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_2303":384,"_22650":379,"_5":22906,"_15464":36410,"_21389":36411,"_1893":36412},[],"/docs/platform/pki/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_2303":385,"_22650":379,"_5":22906,"_15464":36414,"_21389":36415,"_1893":36416},[],"/docs/platform/pki/access-control#how-the-two-paths-relate","How the two paths relate",{"_2303":386,"_22650":379,"_5":22906,"_15464":36418,"_21389":36419,"_1893":36420},[],"/docs/platform/pki/access-control#oidc-principals","OIDC principals",{"_2303":387,"_22650":379,"_5":22906,"_15464":36422,"_21389":36423,"_1893":36424},[],"/docs/platform/pki/access-control#x509-principals","X.509 principals",{"_2303":388,"_22650":379,"_5":22906,"_15464":36426,"_21389":36427,"_1893":36428},[],"/docs/platform/pki/access-control#when-several-principals-match","When several principals match",{"_2303":389,"_22650":379,"_5":22906,"_15464":36430,"_21389":36431,"_1893":36432},[],"/docs/platform/pki/access-control#how-policies-express-access","How policies express access",{"_2303":390,"_22650":379,"_5":22906,"_15464":36434,"_21389":36435,"_1893":36436},[],"/docs/platform/pki/access-control#global-and-direct-access","Global and direct access",{"_2303":391,"_22650":379,"_5":22906,"_15464":36438,"_21389":36439,"_1893":36440},[],"/docs/platform/pki/access-control#access-inherited-through-relations","Access inherited through relations",{"_2303":392,"_22650":379,"_5":22906,"_15464":36442,"_21389":36443,"_1893":36444},[],"/docs/platform/pki/access-control#attribute-filtered-access","Attribute-filtered access",{"_2303":393,"_22650":379,"_5":22906,"_15464":36446,"_21389":36447,"_1893":36448},[],"/docs/platform/pki/access-control#http-rules","HTTP rules",{"_2303":394,"_22650":379,"_5":22906,"_15464":36450,"_21389":36451,"_1893":36452},[],"/docs/platform/pki/access-control#included-policies","Included policies",{"_2303":395,"_22650":379,"_5":22906,"_15464":36454,"_21389":36455,"_1893":35859},[],"/docs/platform/pki/access-control#provision-the-first-administrator",{"_2303":396,"_22650":379,"_5":22906,"_15464":36457,"_21389":36458,"_1893":36459},[],"/docs/platform/pki/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_2303":397,"_22650":379,"_5":22906,"_15464":36461,"_21389":36462,"_1893":36463},[],"/docs/platform/pki/access-control#configure-the-two-jwt-validations","Configure the two JWT validations",{"_2303":398,"_22650":379,"_5":22906,"_15464":36465,"_21389":36466,"_1893":36467},[],"/docs/platform/pki/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_2303":399,"_22650":379,"_5":22906,"_15464":36469,"_21389":36470,"_1893":36471},[],"/docs/platform/pki/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_2303":400,"_22650":379,"_5":22906,"_15464":36473,"_21389":36474,"_1893":36475},[],"/docs/platform/pki/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_2303":401,"_22650":379,"_5":22906,"_15464":36477,"_21389":36478,"_1893":36479},[],"/docs/platform/pki/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_2303":402,"_22650":379,"_5":22906,"_15464":36481,"_21389":36482,"_1893":36483},[],"/docs/platform/pki/access-control#design-least-privilege-roles","Design least-privilege roles",{"_2303":403,"_22650":379,"_5":22906,"_15464":36485,"_21389":36486,"_1893":36487},[],"/docs/platform/pki/access-control#changes-and-access-revocation","Changes and access revocation",{"_2303":404,"_22650":379,"_5":22906,"_15464":36489,"_21389":36490,"_1893":36491},[],"/docs/platform/pki/access-control#operational-checklist","Operational checklist",{"_2303":405,"_22650":379,"_5":22906,"_15464":36493,"_21389":36494,"_1893":36495},[],"/docs/platform/pki/access-control#diagnostics","Diagnostics",{"_2303":406,"_22650":379,"_5":22906,"_15464":36497,"_21389":36498,"_1893":36499},[],"/docs/platform/pki/access-control#the-response-is-401","The response is 401",{"_2303":407,"_22650":379,"_5":22906,"_15464":36501,"_21389":36502,"_1893":36503},[],"/docs/platform/pki/access-control#the-response-is-403","The response is 403",{"_2303":408,"_22650":379,"_5":22906,"_15464":36505,"_21389":36506,"_1893":36507},[],"/docs/platform/pki/access-control#everything-returns-403","Everything returns 403",{"_2303":409,"_22650":379,"_5":22906,"_15464":36509,"_21389":36510,"_1893":36511},[],"/docs/platform/pki/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_2303":410,"_22650":379,"_15464":36513,"_5":15353,"_21389":379,"_1893":36514},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_2303":411,"_22650":379,"_15464":36516,"_5":15353,"_21389":379,"_1893":36517},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_2303":412,"_22650":379,"_15464":36519,"_5":15353,"_21389":379,"_1893":36520},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_2303":413,"_22650":379,"_15464":36522,"_5":15353,"_21389":36399,"_1893":36523},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_2303":414,"_22650":379,"_15464":36525,"_5":15353,"_21389":36399,"_1893":36526},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_2303":415,"_22650":379,"_15464":36528,"_5":15353,"_21389":36399,"_1893":36529},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_2303":416,"_22650":379,"_15464":36531,"_5":15353,"_21389":36399,"_1893":36532},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_2303":417,"_22650":379,"_15464":36534,"_5":15353,"_21389":36399,"_1893":36535},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_2303":418,"_22650":379,"_15464":36537,"_5":15353,"_21389":36399,"_1893":36538},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and one of its policies must allow the requested operation.",{"_2303":419,"_22650":379,"_15464":36540,"_5":15353,"_21389":36403,"_1893":36541},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_2303":420,"_22650":379,"_15464":36543,"_5":15353,"_21389":36403,"_1893":36544},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_2303":421,"_22650":379,"_15464":36546,"_5":15353,"_21389":36407,"_1893":36547},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_2303":422,"_22650":379,"_15464":36549,"_5":15353,"_21389":36407,"_1893":36550},[],"The decision is made **before forwarding the request to the service**:",{"_2303":423,"_22650":379,"_15464":36552,"_5":15353,"_21389":36407,"_1893":36553},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_2303":424,"_22650":379,"_15464":36555,"_5":15353,"_21389":36407,"_1893":36556},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_2303":425,"_22650":379,"_15464":36558,"_5":15353,"_21389":36407,"_1893":36559},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_2303":426,"_22650":379,"_15464":36561,"_5":15353,"_21389":36407,"_1893":36562},[],"It separately loads the policies granted to each principal.",{"_2303":427,"_22650":379,"_15464":36564,"_5":15353,"_21389":36407,"_1893":36565},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_2303":428,"_22650":379,"_15464":36567,"_5":15353,"_21389":36407,"_1893":36568},[],"`authz` looks for an HTTP rule granting that action.",{"_2303":429,"_22650":379,"_15464":36570,"_5":15353,"_21389":36407,"_1893":36571},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy.",{"_2303":430,"_22650":379,"_15464":36573,"_5":15353,"_21389":36407,"_1893":36574},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_2303":431,"_22650":379,"_15464":36576,"_5":15353,"_21389":36407,"_1893":36577},[],"When it allows access, `authz` returns the selected principal in `x-current-user`. The Gateway can propagate that header to the service to preserve the identity context.",{"_2303":432,"_22650":379,"_15464":36579,"_5":15353,"_21389":36407,"_1893":36580},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, the schema must declare a constraint relating a request value to a normalized attribute of the principal.",{"_2303":433,"_22650":379,"_15464":36582,"_5":15353,"_21389":36411,"_1893":36583},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_2303":434,"_22650":379,"_15464":36585,"_5":15353,"_21389":36411,"_1893":36586},[],"The decision is made with the domain operation context:",{"_2303":435,"_22650":379,"_15464":36588,"_5":15353,"_21389":36411,"_1893":36589},[],"The middleware extracts the credential and resolves the matching principals.",{"_2303":436,"_22650":379,"_15464":36591,"_5":15353,"_21389":36411,"_1893":36592},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_2303":437,"_22650":379,"_15464":36594,"_5":15353,"_21389":36411,"_1893":36595},[],"`authz` gathers the entity rules of the granted policies.",{"_2303":438,"_22650":379,"_15464":36597,"_5":15353,"_21389":36411,"_1893":36598},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_2303":439,"_22650":379,"_15464":36600,"_5":15353,"_21389":36411,"_1893":36601},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_2303":440,"_22650":379,"_15464":36603,"_5":15353,"_21389":36411,"_1893":36604},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_2303":441,"_22650":379,"_15464":36606,"_5":15353,"_21389":36411,"_1893":36607},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_2303":442,"_22650":379,"_15464":36609,"_5":15353,"_21389":36411,"_1893":36610},[],"Actions fall into two groups:",{"_2303":443,"_22650":379,"_15464":36612,"_5":15353,"_21389":36411,"_1893":36613},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_2303":444,"_22650":379,"_15464":36615,"_5":15353,"_21389":36411,"_1893":36616},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_2303":445,"_22650":379,"_15464":36618,"_5":15353,"_21389":36411,"_1893":36619},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_2303":446,"_22650":379,"_15464":36621,"_5":15353,"_21389":36415,"_1893":36622},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_2303":447,"_22650":379,"_15464":36624,"_5":15353,"_21389":36415,"_1893":36625},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_2303":448,"_22650":379,"_15464":36627,"_5":15353,"_21389":36415,"_1893":36628},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it. Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_2303":449,"_22650":379,"_15464":36630,"_5":15353,"_21389":36419,"_1893":36631},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_2303":450,"_22650":379,"_15464":36633,"_5":15353,"_21389":36419,"_1893":36634},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_2303":451,"_22650":379,"_15464":36636,"_5":15353,"_21389":36419,"_1893":36637},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_2303":452,"_22650":379,"_15464":36639,"_5":15353,"_21389":36419,"_1893":36640},[],"The implemented operators are:",{"_2303":453,"_22650":379,"_15464":36642,"_5":15353,"_21389":36419,"_1893":36643},[],"`equals`, for exact equality;",{"_2303":454,"_22650":379,"_15464":36645,"_5":15353,"_21389":36419,"_1893":36646},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_2303":455,"_22650":379,"_15464":36648,"_5":15353,"_21389":36419,"_1893":36649},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_2303":456,"_22650":379,"_15464":36651,"_5":15353,"_21389":36419,"_1893":36652},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_2303":457,"_22650":379,"_15464":36654,"_5":15353,"_21389":36423,"_1893":36655},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_2303":458,"_22650":379,"_15464":36657,"_5":15353,"_21389":36423,"_1893":36658},[],"The available modes are:",{"_2303":459,"_22650":379,"_15464":36660,"_5":15353,"_21389":36423,"_1893":36661},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_2303":460,"_22650":379,"_15464":36663,"_5":15353,"_21389":36423,"_1893":36664},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_2303":461,"_22650":379,"_15464":36666,"_5":15353,"_21389":36423,"_1893":36667},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_2303":462,"_22650":379,"_15464":36669,"_5":15353,"_21389":36423,"_1893":36670},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_2303":463,"_22650":379,"_15464":36672,"_5":15353,"_21389":36423,"_1893":36673},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_2303":464,"_22650":379,"_15464":36675,"_5":15353,"_21389":36423,"_1893":36676},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_2303":465,"_22650":379,"_15464":36678,"_5":15353,"_21389":36427,"_1893":36679},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_2303":466,"_22650":379,"_15464":36681,"_5":15353,"_21389":36427,"_1893":36682},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_2303":467,"_22650":379,"_15464":36684,"_5":15353,"_21389":36427,"_1893":36685},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_2303":468,"_22650":379,"_15464":36687,"_5":15353,"_21389":36427,"_1893":36688},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_2303":469,"_22650":379,"_15464":36690,"_5":15353,"_21389":36435,"_1893":36691},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_2303":470,"_22650":379,"_15464":36693,"_5":15353,"_21389":36435,"_1893":36694},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_2303":471,"_22650":379,"_15464":36696,"_5":15353,"_21389":36439,"_1893":36697},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_2303":472,"_22650":379,"_15464":36699,"_5":15353,"_21389":36439,"_1893":36700},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_2303":473,"_22650":379,"_15464":36702,"_5":15353,"_21389":36443,"_1893":36703},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_2303":474,"_22650":379,"_15464":36705,"_5":15353,"_21389":36443,"_1893":36706},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_2303":475,"_22650":379,"_15464":36708,"_5":15353,"_21389":36443,"_1893":36709},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_2303":476,"_22650":379,"_15464":36711,"_5":15353,"_21389":36447,"_1893":36712},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_2303":477,"_22650":379,"_15464":36714,"_5":15353,"_21389":36447,"_1893":36715},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_2303":478,"_22650":379,"_15464":36717,"_5":15353,"_21389":36447,"_1893":36718},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_2303":479,"_22650":379,"_15464":36720,"_5":15353,"_21389":36451,"_1893":36721},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_2303":480,"_22650":379,"_15464":36723,"_5":15353,"_21389":36451,"_1893":36724},[],"full and read-only access to certificates and authorities;",{"_2303":481,"_22650":379,"_15464":36726,"_5":15353,"_21389":36451,"_1893":36727},[],"full and read-only access to the KMS;",{"_2303":482,"_22650":379,"_15464":36729,"_5":15353,"_21389":36451,"_1893":36730},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_2303":483,"_22650":379,"_15464":36732,"_5":15353,"_21389":36451,"_1893":36733},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_2303":484,"_22650":379,"_15464":36735,"_5":15353,"_21389":36451,"_1893":36736},[],"console access;",{"_2303":485,"_22650":379,"_15464":36738,"_5":15353,"_21389":36451,"_1893":36739},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_2303":486,"_22650":379,"_15464":36741,"_5":15353,"_21389":36451,"_1893":36742},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_2303":487,"_22650":379,"_15464":36744,"_5":15353,"_21389":36451,"_1893":36745},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_2303":488,"_22650":379,"_15464":36747,"_5":15353,"_21389":36455,"_1893":36748},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_2303":489,"_22650":379,"_15464":36750,"_5":15353,"_21389":36455,"_1893":36751},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_2303":490,"_22650":379,"_15464":36753,"_5":15353,"_21389":36455,"_1893":36754},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_2303":491,"_22650":379,"_15464":36756,"_5":15353,"_21389":36458,"_1893":36757},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_2303":492,"_22650":379,"_15464":36759,"_5":15353,"_21389":36462,"_1893":36760},[],"The Gateway uses `auth.authentication.apiGateway.jwks` to authenticate requests. `authz` uses `services.authz.jwkUrl` to resolve OIDC principals. Both endpoints must contain the keys of the same issuer and be reachable from their respective components.",{"_2303":493,"_22650":379,"_15464":36762,"_5":15353,"_21389":36466,"_1893":36763},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_2303":494,"_22650":379,"_15464":36765,"_5":15353,"_21389":36470,"_1893":36766},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_2303":495,"_22650":379,"_15464":36768,"_5":15353,"_21389":36474,"_1893":36769},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_2303":496,"_22650":379,"_15464":36771,"_5":15353,"_21389":36478,"_1893":36772},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_2303":497,"_22650":379,"_15464":36774,"_5":15353,"_21389":36478,"_1893":36775},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_2303":498,"_22650":379,"_15464":36777,"_5":15353,"_21389":36482,"_1893":36778},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_2303":499,"_22650":379,"_15464":36780,"_5":15353,"_21389":36482,"_1893":36781},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_2303":500,"_22650":379,"_15464":36783,"_5":15353,"_21389":36482,"_1893":36784},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_2303":501,"_22650":379,"_15464":36786,"_5":15353,"_21389":36482,"_1893":36787},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_2303":502,"_22650":379,"_15464":36789,"_5":15353,"_21389":36482,"_1893":36790},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_2303":503,"_22650":379,"_15464":36792,"_5":15353,"_21389":36482,"_1893":36793},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_2303":504,"_22650":379,"_15464":36795,"_5":15353,"_21389":36482,"_1893":36796},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_2303":505,"_22650":379,"_15464":36798,"_5":15353,"_21389":36482,"_1893":36799},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_2303":506,"_22650":379,"_15464":36801,"_5":15353,"_21389":36486,"_1893":36802},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_2303":507,"_22650":379,"_15464":36804,"_5":15353,"_21389":36486,"_1893":36805},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_2303":508,"_22650":379,"_15464":36807,"_5":15353,"_21389":36486,"_1893":36808},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_2303":509,"_22650":379,"_15464":36810,"_5":15353,"_21389":36490,"_1893":36811},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_2303":510,"_22650":379,"_15464":36813,"_5":15353,"_21389":36490,"_1893":36814},[],"Use groups or stable roles for people and independent identities for automations.",{"_2303":511,"_22650":379,"_15464":36816,"_5":15353,"_21389":36490,"_1893":36817},[],"Keep at least two recovery administrators and test their access periodically.",{"_2303":512,"_22650":379,"_15464":36819,"_5":15353,"_21389":36490,"_1893":36820},[],"Review active principals, their matches and their grants after IdP changes.",{"_2303":513,"_22650":379,"_15464":36822,"_5":15353,"_21389":36490,"_1893":36823},[],"Search for wildcards in policies before upgrading Lamassu.",{"_2303":514,"_22650":379,"_15464":36825,"_5":15353,"_21389":36490,"_1893":36826},[],"Always test one allowed and one denied operation for each role.",{"_2303":515,"_22650":379,"_15464":36828,"_5":15353,"_21389":36490,"_1893":36829},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_2303":516,"_22650":379,"_15464":36831,"_5":15353,"_21389":36498,"_1893":36832},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_2303":517,"_22650":379,"_15464":36834,"_5":15353,"_21389":36502,"_1893":36835},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_2303":518,"_22650":379,"_15464":36837,"_5":15353,"_21389":36502,"_1893":36838},[],"that an active principal of the correct type exists;",{"_2303":519,"_22650":379,"_15464":36840,"_5":15353,"_21389":36502,"_1893":36841},[],"that the claim paths and values match the real token exactly;",{"_2303":520,"_22650":379,"_15464":36843,"_5":15353,"_21389":36502,"_1893":36844},[],"that all of the principal's conditions hold;",{"_2303":521,"_22650":379,"_15464":36846,"_5":15353,"_21389":36502,"_1893":36847},[],"that the principal has the expected policy granted;",{"_2303":522,"_22650":379,"_15464":36849,"_5":15353,"_21389":36502,"_1893":36850},[],"that the policy includes the action and the requested resource type or route;",{"_2303":523,"_22650":379,"_15464":36852,"_5":15353,"_21389":36502,"_1893":36853},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_2303":524,"_22650":379,"_15464":36855,"_5":15353,"_21389":36502,"_1893":36856},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure.",{"_2303":525,"_22650":379,"_15464":36858,"_5":15353,"_21389":36506,"_1893":36859},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_2303":526,"_22650":379,"_15464":36861,"_5":15353,"_21389":36510,"_1893":36862},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_2303":527,"_22650":379,"_15464":36864,"_5":15353,"_21389":36510,"_1893":36865},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_2303":528,"_22650":528,"_5":10649,"_1893":36867,"_22909":36868,"_15464":36870,"_21389":528},"Alerts and subscriptions",[35256,36391,36869],"Operate Lamassu",[],{"_2303":529,"_22650":528,"_15464":36872,"_5":15353,"_21389":528,"_1893":36873},[],"Send PKI events to people and external systems.",{"_2303":530,"_22650":528,"_5":22906,"_15464":36875,"_21389":36876,"_1893":36877},[],"/docs/platform/pki/alerts#how-it-works","How it works",{"_2303":531,"_22650":528,"_5":22906,"_15464":36879,"_21389":36880,"_1893":36881},[],"/docs/platform/pki/alerts#available-channels","Available channels",{"_2303":532,"_22650":528,"_5":22906,"_15464":36883,"_21389":36884,"_1893":36885},[],"/docs/platform/pki/alerts#create-a-subscription","Create a subscription",{"_2303":533,"_22650":528,"_5":22906,"_15464":36887,"_21389":36888,"_1893":36889},[],"/docs/platform/pki/alerts#choose-the-event","Choose the event",{"_2303":534,"_22650":528,"_5":22906,"_15464":36891,"_21389":36892,"_1893":36893},[],"/docs/platform/pki/alerts#configure-the-destination","Configure the destination",{"_2303":535,"_22650":528,"_5":22906,"_15464":36895,"_21389":36896,"_1893":36897},[],"/docs/platform/pki/alerts#limit-the-notifications","Limit the notifications",{"_2303":536,"_22650":528,"_5":22906,"_15464":36899,"_21389":36900,"_1893":36901},[],"/docs/platform/pki/alerts#review-and-activate","Review and activate",{"_2303":537,"_22650":528,"_5":22906,"_15464":36903,"_21389":36904,"_1893":36905},[],"/docs/platform/pki/alerts#manage-a-subscription","Manage a subscription",{"_2303":538,"_22650":528,"_5":22906,"_15464":36907,"_21389":36908,"_1893":36909},[],"/docs/platform/pki/alerts#event-families","Event families",{"_2303":539,"_22650":528,"_15464":36911,"_5":15353,"_21389":528,"_1893":36912},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_2303":540,"_22650":528,"_15464":36914,"_5":15353,"_21389":36876,"_1893":36915},[],"A service publishes a domain event.",{"_2303":541,"_22650":528,"_15464":36917,"_5":15353,"_21389":36876,"_1893":36918},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_2303":542,"_22650":528,"_15464":36920,"_5":15353,"_21389":36876,"_1893":36921},[],"Each subscription's filter decides whether it should be notified.",{"_2303":543,"_22650":528,"_15464":36923,"_5":15353,"_21389":36876,"_1893":36924},[],"Lamassu delivers the event to the configured channel.",{"_2303":544,"_22650":528,"_15464":36926,"_5":15353,"_21389":36876,"_1893":36927},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_2303":545,"_22650":528,"_15464":36929,"_5":15353,"_21389":36880,"_1893":36930},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address.",{"_2303":546,"_22650":528,"_15464":36932,"_5":15353,"_21389":36880,"_1893":36933},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_2303":547,"_22650":528,"_15464":36935,"_5":15353,"_21389":36880,"_1893":36936},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_2303":548,"_22650":528,"_15464":36938,"_5":15353,"_21389":36888,"_1893":36939},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_2303":549,"_22650":528,"_15464":36941,"_5":15353,"_21389":36892,"_1893":36942},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_2303":550,"_22650":528,"_15464":36944,"_5":15353,"_21389":36896,"_1893":36945},[],"Add a filter if you don't want to receive every instance of the event.",{"_2303":551,"_22650":528,"_15464":36947,"_5":15353,"_21389":36896,"_1893":36948},[],"**None** notifies all instances of the event.",{"_2303":552,"_22650":528,"_15464":36950,"_5":15353,"_21389":36896,"_1893":36951},[],"**JSON Path** evaluates one or more specific fields.",{"_2303":553,"_22650":528,"_15464":36953,"_5":15353,"_21389":36896,"_1893":36954},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_2303":554,"_22650":528,"_15464":36956,"_5":15353,"_21389":36896,"_1893":36957},[],"**JavaScript** lets you express custom logic.",{"_2303":555,"_22650":528,"_15464":36959,"_5":15353,"_21389":36896,"_1893":36960},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_2303":556,"_22650":528,"_15464":36962,"_5":15353,"_21389":36900,"_1893":36963},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_2303":557,"_22650":528,"_15464":36965,"_5":15353,"_21389":36904,"_1893":36966},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_2303":558,"_22650":528,"_15464":36968,"_5":15353,"_21389":36908,"_1893":36969},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_2303":559,"_22650":528,"_15464":36971,"_5":15353,"_21389":36908,"_1893":36972},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_2303":560,"_22650":528,"_15464":36974,"_5":15353,"_21389":36908,"_1893":36975},[],"**Profiles:** `profile.create`, `profile.update` and `profile.delete`.",{"_2303":561,"_22650":528,"_15464":36977,"_5":15353,"_21389":36908,"_1893":36978},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_2303":562,"_22650":528,"_15464":36980,"_5":15353,"_21389":36908,"_1893":36981},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_2303":563,"_22650":528,"_15464":36983,"_5":15353,"_21389":36908,"_1893":36984},[],"**Validation:** `va.role.crl.create`.",{"_2303":564,"_22650":528,"_15464":36986,"_5":15353,"_21389":36908,"_1893":36987},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign.message` and `kms.delete`.",{"_2303":565,"_22650":528,"_15464":36989,"_5":15353,"_21389":36908,"_1893":36990},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_2303":566,"_22650":566,"_5":10649,"_1893":36992,"_22909":36993,"_15464":36994,"_21389":566},"Audit logs",[35256,36391,36392],[],{"_2303":567,"_22650":566,"_15464":36996,"_5":15353,"_21389":566,"_1893":36997},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_2303":568,"_22650":566,"_5":22906,"_15464":36999,"_21389":37000,"_1893":37001},[],"/docs/platform/pki/audit-logs#what-an-event-contains","What an event contains",{"_2303":569,"_22650":566,"_5":22906,"_15464":37003,"_21389":37004,"_1893":37005},[],"/docs/platform/pki/audit-logs#coverage","Coverage",{"_2303":570,"_22650":566,"_5":22906,"_15464":37007,"_21389":37008,"_1893":37009},[],"/docs/platform/pki/audit-logs#publication-and-persistence","Publication and persistence",{"_2303":571,"_22650":566,"_5":22906,"_15464":37011,"_21389":37012,"_1893":37013},[],"/docs/platform/pki/audit-logs#sensitive-data","Sensitive data",{"_2303":572,"_22650":566,"_5":22906,"_15464":37015,"_21389":37016,"_1893":37017},[],"/docs/platform/pki/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_2303":573,"_22650":566,"_5":22906,"_15464":37019,"_21389":37020,"_1893":37021},[],"/docs/platform/pki/audit-logs#bound-the-interval","Bound the interval",{"_2303":574,"_22650":566,"_5":22906,"_15464":37023,"_21389":37024,"_1893":37025},[],"/docs/platform/pki/audit-logs#identify-the-operation","Identify the operation",{"_2303":575,"_22650":566,"_5":22906,"_15464":37027,"_21389":37028,"_1893":37029},[],"/docs/platform/pki/audit-logs#attribute-the-principal","Attribute the principal",{"_2303":576,"_22650":566,"_5":22906,"_15464":37031,"_21389":37032,"_1893":37033},[],"/docs/platform/pki/audit-logs#compare-intent-and-result","Compare intent and result",{"_2303":577,"_22650":566,"_5":22906,"_15464":37035,"_21389":37036,"_1893":37037},[],"/docs/platform/pki/audit-logs#follow-the-effect","Follow the effect",{"_2303":578,"_22650":566,"_5":22906,"_15464":37039,"_21389":37040,"_1893":37041},[],"/docs/platform/pki/audit-logs#periodic-verification","Periodic verification",{"_2303":579,"_22650":566,"_15464":37043,"_5":15353,"_21389":566,"_1893":37044},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_2303":580,"_22650":566,"_15464":37046,"_5":15353,"_21389":37000,"_1893":37047},[],"The audit body includes:",{"_2303":581,"_22650":566,"_15464":37049,"_5":15353,"_21389":37000,"_1893":37050},[],"input: data received by the operation;",{"_2303":582,"_22650":566,"_15464":37052,"_5":15353,"_21389":37000,"_1893":37053},[],"has\\_error: whether the service returned an error;",{"_2303":583,"_22650":566,"_15464":37055,"_5":15353,"_21389":37000,"_1893":37056},[],"output: produced result or error message;",{"_2303":584,"_22650":566,"_15464":37058,"_5":15353,"_21389":37000,"_1893":37059},[],"principals: identifiers of the principals that matched the request.",{"_2303":585,"_22650":566,"_15464":37061,"_5":15353,"_21389":37000,"_1893":37062},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_2303":586,"_22650":566,"_15464":37064,"_5":15353,"_21389":37000,"_1893":37065},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_2303":587,"_22650":566,"_15464":37067,"_5":15353,"_21389":37004,"_1893":37068},[],"The backend applies auditing to mutations of:",{"_2303":588,"_22650":566,"_15464":37070,"_5":15353,"_21389":37004,"_1893":37071},[],"authorities, certificates and issuance profiles;",{"_2303":589,"_22650":566,"_15464":37073,"_5":15353,"_21389":37004,"_1893":37074},[],"keys and KMS engines;",{"_2303":590,"_22650":566,"_15464":37076,"_5":15353,"_21389":37004,"_1893":37077},[],"devices and identities;",{"_2303":591,"_22650":566,"_15464":37079,"_5":15353,"_21389":37004,"_1893":37080},[],"DMSs and enrollment operations;",{"_2303":592,"_22650":566,"_15464":37082,"_5":15353,"_21389":37004,"_1893":37083},[],"validation functions and CRL;",{"_2303":593,"_22650":566,"_15464":37085,"_5":15353,"_21389":37004,"_1893":37086},[],"principals, policies and authorization grants.",{"_2303":594,"_22650":566,"_15464":37088,"_5":15353,"_21389":37004,"_1893":37089},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_2303":595,"_22650":566,"_15464":37091,"_5":15353,"_21389":37008,"_1893":37092},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_2303":596,"_22650":566,"_15464":37094,"_5":15353,"_21389":37008,"_1893":37095},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_2303":597,"_22650":566,"_15464":37097,"_5":15353,"_21389":37008,"_1893":37098},[],"Design the consumer to:",{"_2303":598,"_22650":566,"_15464":37100,"_5":15353,"_21389":37008,"_1893":37101},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_2303":599,"_22650":566,"_15464":37103,"_5":15353,"_21389":37008,"_1893":37104},[],"keep the complete CloudEvent unmodified;",{"_2303":600,"_22650":566,"_15464":37106,"_5":15353,"_21389":37008,"_1893":37107},[],"record the ingestion time and detect duplicates by ID;",{"_2303":601,"_22650":566,"_15464":37109,"_5":15353,"_21389":37008,"_1893":37110},[],"encrypt in transit and at rest;",{"_2303":602,"_22650":566,"_15464":37112,"_5":15353,"_21389":37008,"_1893":37113},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_2303":603,"_22650":566,"_15464":37115,"_5":15353,"_21389":37008,"_1893":37116},[],"apply an explicit retention and legal hold policy;",{"_2303":604,"_22650":566,"_15464":37118,"_5":15353,"_21389":37008,"_1893":37119},[],"alert if it stops consuming or the pending queue grows.",{"_2303":605,"_22650":566,"_15464":37121,"_5":15353,"_21389":37012,"_1893":37122},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_2303":606,"_22650":566,"_15464":37124,"_5":15353,"_21389":37012,"_1893":37125},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_2303":607,"_22650":566,"_15464":37127,"_5":15353,"_21389":37020,"_1893":37128},[],"Start from the reported time and normalize every source to UTC.",{"_2303":608,"_22650":566,"_15464":37130,"_5":15353,"_21389":37024,"_1893":37131},[],"Filter by event type, service source and resource identifier.",{"_2303":609,"_22650":566,"_15464":37133,"_5":15353,"_21389":37028,"_1893":37134},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_2303":610,"_22650":566,"_15464":37136,"_5":15353,"_21389":37032,"_1893":37137},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_2303":611,"_22650":566,"_15464":37139,"_5":15353,"_21389":37036,"_1893":37140},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_2303":612,"_22650":566,"_15464":37142,"_5":15353,"_21389":37040,"_1893":37143},[],"Generate a controlled mutation in a test environment and check that:",{"_2303":613,"_22650":566,"_15464":37145,"_5":15353,"_21389":37040,"_1893":37146},[],"a successful audit event appears;",{"_2303":614,"_22650":566,"_15464":37148,"_5":15353,"_21389":37040,"_1893":37149},[],"the principal matches the identity used;",{"_2303":615,"_22650":566,"_15464":37151,"_5":15353,"_21389":37040,"_1893":37152},[],"the consumer persists it exactly once;",{"_2303":616,"_22650":566,"_15464":37154,"_5":15353,"_21389":37040,"_1893":37155},[],"it can be retrieved by resource, actor and period;",{"_2303":617,"_22650":566,"_15464":37157,"_5":15353,"_21389":37040,"_1893":37158},[],"a consumer outage raises an alert.",{"_2303":618,"_22650":566,"_15464":37160,"_5":15353,"_21389":37040,"_1893":37161},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_2303":619,"_22650":619,"_5":10649,"_1893":37163,"_22909":37164,"_15464":37165,"_21389":619},"CA hierarchy and rotation",[35256,36391,36869],[],{"_2303":620,"_22650":619,"_15464":37167,"_5":15353,"_21389":619,"_1893":37168},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_2303":621,"_22650":619,"_5":22906,"_15464":37170,"_21389":37171,"_1893":37172},[],"/docs/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_2303":622,"_22650":619,"_5":22906,"_15464":37174,"_21389":37175,"_1893":37176},[],"/docs/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_2303":623,"_22650":619,"_5":22906,"_15464":37178,"_21389":37179,"_1893":37180},[],"/docs/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_2303":624,"_22650":619,"_5":22906,"_15464":37182,"_21389":37183,"_1893":37184},[],"/docs/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_2303":625,"_22650":619,"_5":22906,"_15464":37186,"_21389":37187,"_1893":37188},[],"/docs/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_2303":626,"_22650":619,"_5":22906,"_15464":37190,"_21389":37191,"_1893":37192},[],"/docs/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_2303":627,"_22650":619,"_5":22906,"_15464":37194,"_21389":37195,"_1893":37196},[],"/docs/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_2303":628,"_22650":619,"_5":22906,"_15464":37198,"_21389":37199,"_1893":37200},[],"/docs/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_2303":629,"_22650":619,"_5":22906,"_15464":37202,"_21389":37203,"_1893":37204},[],"/docs/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_2303":630,"_22650":619,"_5":22906,"_15464":37206,"_21389":37207,"_1893":37208},[],"/docs/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_2303":631,"_22650":619,"_5":22906,"_15464":37210,"_21389":37211,"_1893":37212},[],"/docs/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_2303":632,"_22650":619,"_5":22906,"_15464":37214,"_21389":37215,"_1893":37216},[],"/docs/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_2303":633,"_22650":619,"_15464":37218,"_5":15353,"_21389":619,"_1893":37219},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_2303":634,"_22650":619,"_15464":37221,"_5":15353,"_21389":37171,"_1893":37222},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_2303":635,"_22650":619,"_15464":37224,"_5":15353,"_21389":37171,"_1893":37225},[],"environment, such as production and preproduction;",{"_2303":636,"_22650":619,"_15464":37227,"_5":15353,"_21389":37171,"_1893":37228},[],"owner or operating team;",{"_2303":637,"_22650":619,"_15464":37230,"_5":15353,"_21389":37171,"_1893":37231},[],"device family or manufacturing process;",{"_2303":638,"_22650":619,"_15464":37233,"_5":15353,"_21389":37171,"_1893":37234},[],"region or regulatory requirement;",{"_2303":639,"_22650":619,"_15464":37236,"_5":15353,"_21389":37171,"_1893":37237},[],"cryptographic engine or key policy;",{"_2303":640,"_22650":619,"_15464":37239,"_5":15353,"_21389":37171,"_1893":37240},[],"maintenance window and renewal cadence.",{"_2303":641,"_22650":619,"_15464":37242,"_5":15353,"_21389":37171,"_1893":37243},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_2303":642,"_22650":619,"_15464":37245,"_5":15353,"_21389":37171,"_1893":37246},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_2303":643,"_22650":619,"_15464":37248,"_5":15353,"_21389":37175,"_1893":37249},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_2303":644,"_22650":619,"_15464":37251,"_5":15353,"_21389":37175,"_1893":37252},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_2303":645,"_22650":619,"_15464":37254,"_5":15353,"_21389":37175,"_1893":37255},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_2303":646,"_22650":619,"_15464":37257,"_5":15353,"_21389":37179,"_1893":37258},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_2303":647,"_22650":619,"_15464":37260,"_5":15353,"_21389":37179,"_1893":37261},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_2303":648,"_22650":619,"_15464":37263,"_5":15353,"_21389":37179,"_1893":37264},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_2303":649,"_22650":619,"_15464":37266,"_5":15353,"_21389":37179,"_1893":37267},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_2303":650,"_22650":619,"_15464":37269,"_5":15353,"_21389":37187,"_1893":37270},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_2303":651,"_22650":619,"_15464":37272,"_5":15353,"_21389":37191,"_1893":37273},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_2303":652,"_22650":619,"_15464":37275,"_5":15353,"_21389":37195,"_1893":37276},[],"Add the new root or chain to consumers before issuing with it. In a DMS, use the managed CAs of `/cacerts` to temporarily keep both the old and new chains.",{"_2303":653,"_22650":619,"_15464":37278,"_5":15353,"_21389":37199,"_1893":37279},[],"Update the enrollment CA and profile of the DMSs. Keep the additional validation CAs if old certificates still need to be accepted during re-enrollment.",{"_2303":654,"_22650":619,"_15464":37281,"_5":15353,"_21389":37203,"_1893":37282},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_2303":655,"_22650":619,"_15464":37284,"_5":15353,"_21389":37207,"_1893":37285},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance and from the distributed CAs. Revoke it if policy requires it.",{"_2303":656,"_22650":619,"_15464":37287,"_5":15353,"_21389":37211,"_1893":37288},[],"When you revoke a CA, Lamassu also updates its child CAs and issued certificates to `REVOKED` with the reason `CessationOfOperation`. The children's revocations propagate the effect to their own branches.",{"_2303":657,"_22650":619,"_15464":37290,"_5":15353,"_21389":37211,"_1893":37291},[],"This protects the coherence of the hierarchy, but it makes revocation a high-impact action. Do not use it as the ordinary mechanism to stop issuing: first complete the migration and remove the CA from operational flows.",{"_2303":658,"_22650":619,"_15464":37293,"_5":15353,"_21389":37215,"_1893":37294},[],"The new chain ends in an anchor installed by the consumer.",{"_2303":659,"_22650":619,"_15464":37296,"_5":15353,"_21389":37215,"_1893":37297},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_2303":660,"_22650":619,"_15464":37299,"_5":15353,"_21389":37215,"_1893":37300},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_2303":661,"_22650":619,"_15464":37302,"_5":15353,"_21389":37215,"_1893":37303},[],"Re-enrollment accepts the old identity during the planned period.",{"_2303":662,"_22650":619,"_15464":37305,"_5":15353,"_21389":37215,"_1893":37306},[],"OCSP and CRL respond for the authorities that remain active.",{"_2303":663,"_22650":619,"_15464":37308,"_5":15353,"_21389":37215,"_1893":37309},[],"No DMS is left accidentally issuing from the old CA.",{"_2303":664,"_22650":619,"_15464":37311,"_5":15353,"_21389":37215,"_1893":37312},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_2303":665,"_22650":665,"_5":10649,"_1893":37314,"_22909":37315,"_15464":37316,"_21389":665},"Certification authorities",[35256,36391,36869],[],{"_2303":666,"_22650":665,"_15464":37318,"_5":15353,"_21389":665,"_1893":37319},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_2303":667,"_22650":665,"_5":22906,"_15464":37321,"_21389":37322,"_1893":37323},[],"/docs/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_2303":668,"_22650":665,"_5":22906,"_15464":37325,"_21389":37326,"_1893":37327},[],"/docs/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_2303":669,"_22650":665,"_5":22906,"_15464":37329,"_21389":37330,"_1893":35266},[],"/docs/platform/pki/certificate-authorities#before-you-begin",{"_2303":670,"_22650":665,"_5":22906,"_15464":37332,"_21389":37333,"_1893":37334},[],"/docs/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_2303":671,"_22650":665,"_5":22906,"_15464":37336,"_21389":37337,"_1893":37338},[],"/docs/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_2303":672,"_22650":665,"_5":22906,"_15464":37340,"_21389":37341,"_1893":37342},[],"/docs/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_2303":673,"_22650":665,"_5":22906,"_15464":37344,"_21389":37345,"_1893":37346},[],"/docs/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_2303":674,"_22650":665,"_5":22906,"_15464":37348,"_21389":37349,"_1893":37350},[],"/docs/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_2303":675,"_22650":665,"_5":22906,"_15464":37352,"_21389":37353,"_1893":37354},[],"/docs/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_2303":676,"_22650":665,"_5":22906,"_15464":37356,"_21389":37357,"_1893":37358},[],"/docs/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_2303":677,"_22650":665,"_5":22906,"_15464":37360,"_21389":37361,"_1893":37362},[],"/docs/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_2303":678,"_22650":665,"_5":22906,"_15464":37364,"_21389":37365,"_1893":37366},[],"/docs/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_2303":679,"_22650":665,"_5":22906,"_15464":37368,"_21389":37369,"_1893":37370},[],"/docs/platform/pki/certificate-authorities#load-the-material","Load the material",{"_2303":680,"_22650":665,"_5":22906,"_15464":37372,"_21389":37373,"_1893":37374},[],"/docs/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_2303":681,"_22650":665,"_5":22906,"_15464":37376,"_21389":37377,"_1893":37378},[],"/docs/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_2303":682,"_22650":665,"_5":22906,"_15464":37380,"_21389":37381,"_1893":37382},[],"/docs/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_2303":683,"_22650":665,"_5":22906,"_15464":37384,"_21389":37385,"_1893":37386},[],"/docs/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_2303":684,"_22650":665,"_5":22906,"_15464":37388,"_21389":37389,"_1893":37390},[],"/docs/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_2303":685,"_22650":665,"_5":22906,"_15464":37392,"_21389":37393,"_1893":37394},[],"/docs/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_2303":686,"_22650":665,"_5":22906,"_15464":37396,"_21389":37397,"_1893":37398},[],"/docs/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_2303":687,"_22650":665,"_5":22906,"_15464":37400,"_21389":37401,"_1893":37402},[],"/docs/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_2303":688,"_22650":665,"_5":22906,"_15464":37404,"_21389":37405,"_1893":37406},[],"/docs/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_2303":689,"_22650":665,"_15464":37408,"_5":15353,"_21389":665,"_1893":37409},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_2303":690,"_22650":665,"_15464":37411,"_5":15353,"_21389":665,"_1893":37412},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_2303":691,"_22650":665,"_15464":37414,"_5":15353,"_21389":37322,"_1893":37415},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_2303":692,"_22650":665,"_15464":37417,"_5":15353,"_21389":37322,"_1893":37418},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_2303":693,"_22650":665,"_15464":37420,"_5":15353,"_21389":37322,"_1893":37421},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_2303":694,"_22650":665,"_15464":37423,"_5":15353,"_21389":37322,"_1893":37424},[],"**Import only the certificate:** add an authority for building chains and validating, but not for issuing.",{"_2303":695,"_22650":665,"_15464":37426,"_5":15353,"_21389":37322,"_1893":37427},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_2303":696,"_22650":665,"_15464":37429,"_5":15353,"_21389":37330,"_1893":37430},[],"Decide whether the CA will be a root or an intermediate.",{"_2303":697,"_22650":665,"_15464":37432,"_5":15353,"_21389":37330,"_1893":37433},[],"Choose the engine that will keep the key.",{"_2303":698,"_22650":665,"_15464":37435,"_5":15353,"_21389":37330,"_1893":37436},[],"Define a validity longer than that of the certificates it will issue.",{"_2303":699,"_22650":665,"_15464":37438,"_5":15353,"_21389":37330,"_1893":37439},[],"For an intermediate CA, make sure the parent CA is active.",{"_2303":700,"_22650":665,"_15464":37441,"_5":15353,"_21389":37333,"_1893":37442},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_2303":701,"_22650":665,"_15464":37444,"_5":15353,"_21389":37337,"_1893":37445},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_2303":702,"_22650":665,"_15464":37447,"_5":15353,"_21389":37337,"_1893":37448},[],"For RSA you can choose 1024, 2048, 3072 or 4096 bits. For EC, the P-256, P-384 and P-521 curves are available.",{"_2303":703,"_22650":665,"_15464":37450,"_5":15353,"_21389":37341,"_1893":37451},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_2303":704,"_22650":665,"_15464":37453,"_5":15353,"_21389":37345,"_1893":37454},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_2303":705,"_22650":665,"_15464":37456,"_5":15353,"_21389":37345,"_1893":37457},[],"`C`: two-letter ISO 3166-1 country code.",{"_2303":706,"_22650":665,"_15464":37459,"_5":15353,"_21389":37345,"_1893":37460},[],"`ST`: state or province.",{"_2303":707,"_22650":665,"_15464":37462,"_5":15353,"_21389":37345,"_1893":37463},[],"`L`: locality.",{"_2303":708,"_22650":665,"_15464":37465,"_5":15353,"_21389":37345,"_1893":37466},[],"`O`: organization.",{"_2303":709,"_22650":665,"_15464":37468,"_5":15353,"_21389":37345,"_1893":37469},[],"`OU`: organizational unit.",{"_2303":710,"_22650":665,"_15464":37471,"_5":15353,"_21389":37345,"_1893":37472},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_2303":711,"_22650":665,"_15464":37474,"_5":15353,"_21389":37349,"_1893":37475},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_2303":712,"_22650":665,"_15464":37477,"_5":15353,"_21389":37349,"_1893":37478},[],"Select an existing issuance profile or configure the `Key Usage` and `Extended Key Usage` in the form. If you don't choose a profile, Lamassu applies the default basic usages.",{"_2303":713,"_22650":665,"_15464":37480,"_5":15353,"_21389":37353,"_1893":37481},[],"Confirm the form. The CA should appear in the inventory with its PEM certificate, status, expiration date and list of issued certificates.",{"_2303":714,"_22650":665,"_15464":37483,"_5":15353,"_21389":37353,"_1893":37484},[],"A CA cannot issue certificates that outlive its own expiration date. Leave enough margin to renew or replace the authority without interrupting consumers.",{"_2303":715,"_22650":665,"_15464":37486,"_5":15353,"_21389":37357,"_1893":37487},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_2303":716,"_22650":665,"_15464":37489,"_5":15353,"_21389":37357,"_1893":37490},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_2303":717,"_22650":665,"_15464":37492,"_5":15353,"_21389":37361,"_1893":37493},[],"Importing preserves an authority created outside Lamassu.",{"_2303":718,"_22650":665,"_15464":37495,"_5":15353,"_21389":37365,"_1893":37496},[],"Choose the engine that will keep the imported key.",{"_2303":719,"_22650":665,"_15464":37498,"_5":15353,"_21389":37369,"_1893":37499},[],"Provide the CA certificate and the private key in PEM format. For a subordinate CA, optionally add the validation chain.",{"_2303":720,"_22650":665,"_15464":37501,"_5":15353,"_21389":37373,"_1893":37502},[],"Configure the validity that end-entity certificates will receive when a request does not specify another duration.",{"_2303":721,"_22650":665,"_15464":37504,"_5":15353,"_21389":37377,"_1893":37505},[],"Lamassu checks that the certificate belongs to a CA and that the material is coherent before registering it.",{"_2303":722,"_22650":665,"_15464":37507,"_5":15353,"_21389":37377,"_1893":37508},[],"If you don't have the private key, import only the certificate. The authority can take part in chains of trust and validation processes, but it cannot issue certificates from Lamassu.",{"_2303":723,"_22650":665,"_15464":37510,"_5":15353,"_21389":37381,"_1893":37511},[],"Open a CA from the inventory to review:",{"_2303":724,"_22650":665,"_15464":37513,"_5":15353,"_21389":37381,"_1893":37514},[],"Status and validity period.",{"_2303":725,"_22650":665,"_15464":37516,"_5":15353,"_21389":37381,"_1893":37517},[],"Certificate and chain in PEM format.",{"_2303":726,"_22650":665,"_15464":37519,"_5":15353,"_21389":37381,"_1893":37520},[],"Number of active, expired and revoked certificates.",{"_2303":727,"_22650":665,"_15464":37522,"_5":15353,"_21389":37381,"_1893":37523},[],"Certificates issued in **Issued Certificates**.",{"_2303":728,"_22650":665,"_15464":37525,"_5":15353,"_21389":37381,"_1893":37526},[],"The CRL linked to the authority.",{"_2303":729,"_22650":665,"_15464":37528,"_5":15353,"_21389":37381,"_1893":37529},[],"Metadata and the associated cryptographic engine.",{"_2303":730,"_22650":665,"_15464":37531,"_5":15353,"_21389":37381,"_1893":37532},[],"You can filter the inventory by name, status and CA type.",{"_2303":731,"_22650":665,"_15464":37534,"_5":15353,"_21389":37385,"_1893":37535},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_2303":732,"_22650":665,"_15464":37537,"_5":15353,"_21389":37385,"_1893":37538},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_2303":733,"_22650":665,"_15464":37540,"_5":15353,"_21389":37385,"_1893":37541},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_2303":734,"_22650":665,"_15464":37543,"_5":15353,"_21389":37385,"_1893":37544},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_2303":735,"_22650":665,"_15464":37546,"_5":15353,"_21389":37389,"_1893":37547},[],"Revoking a CA invalidates trust in the certificates it issued and can interrupt devices and services. The action is irreversible.",{"_2303":736,"_22650":665,"_15464":37549,"_5":15353,"_21389":37393,"_1893":37550},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_2303":737,"_22650":665,"_15464":37552,"_5":15353,"_21389":37397,"_1893":37553},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_2303":738,"_22650":665,"_15464":37555,"_5":15353,"_21389":37401,"_1893":37556},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_2303":739,"_22650":665,"_15464":37558,"_5":15353,"_21389":37405,"_1893":37559},[],"The status should change to **REVOKED** and the CRL should reflect the new information. The CA can no longer issue certificates.",{"_2303":740,"_22650":665,"_15464":37561,"_5":15353,"_21389":37405,"_1893":37562},[],"Permanent deletion is only available after revoking. Delete the record only when your retention and audit policy allows it.",{"_2303":741,"_22650":741,"_5":10649,"_1893":37564,"_22909":37565,"_15464":37566,"_21389":741},"Certificate profiles",[35256,36391,36869],[],{"_2303":742,"_22650":741,"_15464":37568,"_5":15353,"_21389":741,"_1893":37569},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_2303":743,"_22650":741,"_5":22906,"_15464":37571,"_21389":37572,"_1893":37573},[],"/docs/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_2303":744,"_22650":741,"_5":22906,"_15464":37575,"_21389":37576,"_1893":37577},[],"/docs/platform/pki/certificate-profiles#validity","Validity",{"_2303":745,"_22650":741,"_5":22906,"_15464":37579,"_21389":37580,"_1893":37581},[],"/docs/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_2303":746,"_22650":741,"_5":22906,"_15464":37583,"_21389":37584,"_1893":37585},[],"/docs/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_2303":747,"_22650":741,"_5":22906,"_15464":37587,"_21389":37588,"_1893":37589},[],"/docs/platform/pki/certificate-profiles#subject","Subject",{"_2303":748,"_22650":741,"_5":22906,"_15464":37591,"_21389":37592,"_1893":37593},[],"/docs/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_2303":749,"_22650":741,"_5":22906,"_15464":37595,"_21389":37596,"_1893":37597},[],"/docs/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_2303":750,"_22650":741,"_5":22906,"_15464":37599,"_21389":37600,"_1893":37601},[],"/docs/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_2303":751,"_22650":741,"_5":22906,"_15464":37603,"_21389":37604,"_1893":37605},[],"/docs/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_2303":752,"_22650":741,"_5":22906,"_15464":37607,"_21389":37608,"_1893":37609},[],"/docs/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_2303":753,"_22650":741,"_5":22906,"_15464":37611,"_21389":37612,"_1893":37613},[],"/docs/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_2303":754,"_22650":741,"_5":22906,"_15464":37615,"_21389":37616,"_1893":37617},[],"/docs/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_2303":755,"_22650":741,"_5":22906,"_15464":37619,"_21389":37620,"_1893":37621},[],"/docs/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_2303":756,"_22650":741,"_5":22906,"_15464":37623,"_21389":37624,"_1893":37625},[],"/docs/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_2303":757,"_22650":741,"_5":22906,"_15464":37627,"_21389":37628,"_1893":37629},[],"/docs/platform/pki/certificate-profiles#design-examples","Design examples",{"_2303":758,"_22650":741,"_5":22906,"_15464":37631,"_21389":37632,"_1893":37633},[],"/docs/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_2303":759,"_22650":741,"_15464":37635,"_5":15353,"_21389":741,"_1893":37636},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_2303":760,"_22650":741,"_15464":37638,"_5":15353,"_21389":37576,"_1893":37639},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_2303":761,"_22650":741,"_15464":37641,"_5":15353,"_21389":37576,"_1893":37642},[],"The end date must never outlive the issuing CA.",{"_2303":762,"_22650":741,"_15464":37644,"_5":15353,"_21389":37580,"_1893":37645},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_2303":763,"_22650":741,"_15464":37647,"_5":15353,"_21389":37584,"_1893":37648},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_2303":764,"_22650":741,"_15464":37650,"_5":15353,"_21389":37584,"_1893":37651},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_2303":765,"_22650":741,"_15464":37653,"_5":15353,"_21389":37584,"_1893":37654},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_2303":766,"_22650":741,"_15464":37656,"_5":15353,"_21389":37588,"_1893":37657},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_2303":767,"_22650":741,"_15464":37659,"_5":15353,"_21389":37592,"_1893":37660},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_2303":768,"_22650":741,"_15464":37662,"_5":15353,"_21389":37592,"_1893":37663},[],"This behavior allows accepting DNS, IP, email or URI as alternative identities without accepting arbitrary extensions.",{"_2303":769,"_22650":741,"_15464":37665,"_5":15353,"_21389":37596,"_1893":37666},[],"The cryptographic enforcement can:",{"_2303":770,"_22650":741,"_15464":37668,"_5":15353,"_21389":37596,"_1893":37669},[],"allow or block RSA keys;",{"_2303":771,"_22650":741,"_15464":37671,"_5":15353,"_21389":37596,"_1893":37672},[],"limit the supported RSA sizes;",{"_2303":772,"_22650":741,"_15464":37674,"_5":15353,"_21389":37596,"_1893":37675},[],"allow or block ECDSA keys;",{"_2303":773,"_22650":741,"_15464":37677,"_5":15353,"_21389":37596,"_1893":37678},[],"limit the supported ECDSA sizes or curves.",{"_2303":774,"_22650":741,"_15464":37680,"_5":15353,"_21389":37596,"_1893":37681},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_2303":775,"_22650":741,"_15464":37683,"_5":15353,"_21389":37600,"_1893":37684},[],"In operations that accept multiple sources, Lamassu resolves the profile in this order:",{"_2303":776,"_22650":741,"_15464":37686,"_5":15353,"_21389":37600,"_1893":37687},[],"The profile sent within the operation.",{"_2303":777,"_22650":741,"_15464":37689,"_5":15353,"_21389":37600,"_1893":37690},[],"The profile identifier sent in the operation.",{"_2303":778,"_22650":741,"_15464":37692,"_5":15353,"_21389":37600,"_1893":37693},[],"The default profile associated with the CA.",{"_2303":779,"_22650":741,"_15464":37695,"_5":15353,"_21389":37600,"_1893":37696},[],"A DMS can also reference its own issuance profile. This way, several fleets can use the same CA with different policies.",{"_2303":780,"_22650":741,"_15464":37698,"_5":15353,"_21389":37608,"_1893":37699},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_2303":781,"_22650":741,"_15464":37701,"_5":15353,"_21389":37612,"_1893":37702},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_2303":782,"_22650":741,"_15464":37704,"_5":15353,"_21389":37616,"_1893":37705},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_2303":783,"_22650":741,"_15464":37707,"_5":15353,"_21389":37620,"_1893":37708},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_2303":784,"_22650":741,"_15464":37710,"_5":15353,"_21389":37624,"_1893":37711},[],"Attach the profile to a CA or DMS. Issue a test certificate and check subject, SAN, KU, EKU, basic constraints and dates with an independent X.509 tool.",{"_2303":785,"_22650":741,"_15464":37713,"_5":15353,"_21389":37628,"_1893":37714},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_2303":786,"_22650":741,"_15464":37716,"_5":15353,"_21389":37628,"_1893":37717},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_2303":787,"_22650":741,"_15464":37719,"_5":15353,"_21389":37628,"_1893":37720},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_2303":788,"_22650":741,"_15464":37722,"_5":15353,"_21389":37628,"_1893":37723},[],"These are starting patterns, not a universal policy. Always verify the requirements of the protocol, the consumer and the applicable regulatory framework.",{"_2303":789,"_22650":741,"_15464":37725,"_5":15353,"_21389":37632,"_1893":37726},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_2303":790,"_22650":741,"_15464":37728,"_5":15353,"_21389":37632,"_1893":37729},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_2303":791,"_22650":791,"_5":10649,"_1893":37731,"_22909":37732,"_15464":37733,"_21389":791},"Certificate validation",[35256,36391,36869],[],{"_2303":792,"_22650":791,"_15464":37735,"_5":15353,"_21389":791,"_1893":37736},[],"Publish the status of identities through OCSP and CRL.",{"_2303":793,"_22650":791,"_5":22906,"_15464":37738,"_21389":37739,"_1893":37740},[],"/docs/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_2303":794,"_22650":791,"_15464":37742,"_5":15353,"_21389":791,"_1893":37743},[],"Issuance proves who signed a certificate; validation tells you whether it should still be accepted. Lamassu publishes status through two complementary mechanisms.",{"_2303":795,"_22650":791,"_15464":37745,"_5":15353,"_21389":37739,"_1893":37746},[],"Use **OCSP** when the consumer is online and needs to check the latest status of a specific certificate.",{"_2303":796,"_22650":791,"_15464":37748,"_5":15353,"_21389":37739,"_1893":37749},[],"Use a **CRL** when validation must happen locally, offline or over a high volume of certificates. The consumer periodically downloads a signed list and keeps it until the next update.",{"_2303":797,"_22650":791,"_15464":37751,"_5":15353,"_21389":37739,"_1893":37752},[],"Many environments use both: OCSP as the primary check and a CRL as the local or fallback mechanism.",{"_2303":798,"_22650":791,"_15464":37754,"_5":15353,"_21389":37739,"_1893":37755},[],"<Card title=\"Online validation with OCSP\" description=\"Query Good, Revoked and Unknown statuses in real time.\" href=\"/docs/platform/pki/ocsp\" />",{"_2303":799,"_22650":791,"_15464":37757,"_5":15353,"_21389":37739,"_1893":37758},[],"<Card title=\"Revocation lists\" description=\"Generate, publish and distribute CRLs per authority.\" href=\"/docs/platform/pki/crl\" />",{"_2303":800,"_22650":800,"_5":10649,"_1893":37760,"_22909":37761,"_15464":37762,"_21389":800},"Certificates",[35256,36391,36869],[],{"_2303":801,"_22650":800,"_15464":37764,"_5":15353,"_21389":800,"_1893":37765},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_2303":802,"_22650":800,"_5":22906,"_15464":37767,"_21389":37768,"_1893":37769},[],"/docs/platform/pki/certificates#find-a-certificate","Find a certificate",{"_2303":803,"_22650":800,"_5":22906,"_15464":37771,"_21389":37772,"_1893":37773},[],"/docs/platform/pki/certificates#download-the-certificate","Download the certificate",{"_2303":804,"_22650":800,"_5":22906,"_15464":37775,"_21389":37776,"_1893":37777},[],"/docs/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_2303":805,"_22650":800,"_5":22906,"_15464":37779,"_21389":37780,"_1893":37781},[],"/docs/platform/pki/certificates#open-the-action","Open the action",{"_2303":806,"_22650":800,"_5":22906,"_15464":37783,"_21389":37784,"_1893":37785},[],"/docs/platform/pki/certificates#choose-a-reason","Choose a reason",{"_2303":807,"_22650":800,"_5":22906,"_15464":37787,"_21389":37788,"_1893":37789},[],"/docs/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_2303":808,"_22650":800,"_5":22906,"_15464":37791,"_21389":37792,"_1893":37793},[],"/docs/platform/pki/certificates#continue","Continue",{"_2303":809,"_22650":800,"_15464":37795,"_5":15353,"_21389":800,"_1893":37796},[],"The certificate inventory offers a global view of the identities issued by all authorities. You can also open **Issued Certificates** inside a CA to limit the view to that issuer.",{"_2303":810,"_22650":800,"_15464":37798,"_5":15353,"_21389":37768,"_1893":37799},[],"Open **Certificates** and filter by:",{"_2303":811,"_22650":800,"_15464":37801,"_5":15353,"_21389":37768,"_1893":37802},[],"Subject's `Common Name`.",{"_2303":812,"_22650":800,"_15464":37804,"_5":15353,"_21389":37768,"_1893":37805},[],"Serial number.",{"_2303":813,"_22650":800,"_15464":37807,"_5":15353,"_21389":37768,"_1893":37808},[],"Status.",{"_2303":814,"_22650":800,"_15464":37810,"_5":15353,"_21389":37768,"_1893":37811},[],"Issuing authority.",{"_2303":815,"_22650":800,"_15464":37813,"_5":15353,"_21389":37768,"_1893":37814},[],"Use **Quick Inspect** for a quick check or **View Details** to see the subject, SANs, usages, chain, validity period and full metadata.",{"_2303":816,"_22650":800,"_15464":37816,"_5":15353,"_21389":37772,"_1893":37817},[],"The download action delivers the certificate in PEM format. If the certificate was issued from an external CSR, the private key stays on the system that generated that CSR. If it was generated in the browser, the key was only available when the issuance finished.",{"_2303":817,"_22650":800,"_15464":37819,"_5":15353,"_21389":37776,"_1893":37820},[],"Revoke an identity when the key has been compromised, the subject is no longer authorized or the certificate must stop being accepted before it expires.",{"_2303":818,"_22650":800,"_15464":37822,"_5":15353,"_21389":37780,"_1893":37823},[],"In the inventory or detail view, select **Revoke Certificate**.",{"_2303":819,"_22650":800,"_15464":37825,"_5":15353,"_21389":37784,"_1893":37826},[],"Select the reason that represents the incident. This information is published in OCSP and in the CRL.",{"_2303":820,"_22650":800,"_15464":37828,"_5":15353,"_21389":37788,"_1893":37829},[],"Confirm the operation and check that the status is **Revoked**. If the CA regenerates the CRL upon revocation, also verify that a new version exists.",{"_2303":821,"_22650":800,"_15464":37831,"_5":15353,"_21389":37788,"_1893":37832},[],"A revocation with the reason `CertificateHold` can be reactivated. All other reasons produce a final revocation.",{"_2303":822,"_22650":800,"_15464":37834,"_5":15353,"_21389":37792,"_1893":37835},[],"<Card title=\"Validate with OCSP\" description=\"Query the status of a certificate in real time.\" href=\"/docs/platform/pki/ocsp\" />",{"_2303":823,"_22650":800,"_15464":37837,"_5":15353,"_21389":37792,"_1893":37838},[],"<Card title=\"Distribute a CRL\" description=\"Publish the status for offline validation.\" href=\"/docs/platform/pki/crl\" />",{"_2303":824,"_22650":824,"_5":10649,"_1893":37840,"_22909":37841,"_15464":37843,"_21389":824},"Platform architecture",[35256,36391,37842],"Concepts",[],{"_2303":825,"_22650":824,"_15464":37845,"_5":15353,"_21389":824,"_1893":37846},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_2303":826,"_22650":824,"_5":22906,"_15464":37848,"_21389":37849,"_1893":37850},[],"/docs/platform/pki/concepts/architecture#control-plane","Control plane",{"_2303":827,"_22650":824,"_5":22906,"_15464":37852,"_21389":37853,"_1893":37854},[],"/docs/platform/pki/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_2303":828,"_22650":824,"_5":22906,"_15464":37856,"_21389":37857,"_1893":37858},[],"/docs/platform/pki/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_2303":829,"_22650":824,"_5":22906,"_15464":37860,"_21389":37861,"_1893":37862},[],"/docs/platform/pki/concepts/architecture#status-and-validation","Status and validation",{"_2303":830,"_22650":824,"_5":22906,"_15464":37864,"_21389":37865,"_1893":37866},[],"/docs/platform/pki/concepts/architecture#platform-dependencies","Platform dependencies",{"_2303":831,"_22650":824,"_15464":37868,"_5":15353,"_21389":824,"_1893":37869},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_2303":832,"_22650":824,"_15464":37871,"_5":15353,"_21389":824,"_1893":37872},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_2303":833,"_22650":824,"_15464":37874,"_5":15353,"_21389":37849,"_1893":37875},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_2303":834,"_22650":824,"_15464":37877,"_5":15353,"_21389":37853,"_1893":37878},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_2303":835,"_22650":824,"_15464":37880,"_5":15353,"_21389":37857,"_1893":37881},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_2303":836,"_22650":824,"_15464":37883,"_5":15353,"_21389":37861,"_1893":37884},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_2303":837,"_22650":824,"_15464":37886,"_5":15353,"_21389":37865,"_1893":37887},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_2303":838,"_22650":838,"_5":10649,"_1893":37889,"_22909":37890,"_15464":37891,"_21389":838},"Certificate lifecycle",[35256,36391,37842],[],{"_2303":839,"_22650":838,"_15464":37893,"_5":15353,"_21389":838,"_1893":37894},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_2303":840,"_22650":838,"_5":22906,"_15464":37896,"_21389":37897,"_1893":37898},[],"/docs/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_2303":841,"_22650":838,"_5":22906,"_15464":37900,"_21389":37901,"_1893":37902},[],"/docs/platform/pki/concepts/certificate-lifecycle#request","Request",{"_2303":842,"_22650":838,"_5":22906,"_15464":37904,"_21389":37905,"_1893":37906},[],"/docs/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_2303":843,"_22650":838,"_5":22906,"_15464":37908,"_21389":37909,"_1893":37910},[],"/docs/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_2303":844,"_22650":838,"_5":22906,"_15464":37912,"_21389":37913,"_1893":37914},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_2303":845,"_22650":838,"_5":22906,"_15464":37916,"_21389":37917,"_1893":37918},[],"/docs/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_2303":846,"_22650":838,"_5":22906,"_15464":37920,"_21389":37921,"_1893":37922},[],"/docs/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_2303":847,"_22650":838,"_5":22906,"_15464":37924,"_21389":37925,"_1893":37926},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_2303":848,"_22650":838,"_5":22906,"_15464":37928,"_21389":37929,"_1893":37930},[],"/docs/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_2303":849,"_22650":838,"_5":22906,"_15464":37932,"_21389":37933,"_1893":37934},[],"/docs/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_2303":850,"_22650":838,"_15464":37936,"_5":15353,"_21389":838,"_1893":37937},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_2303":851,"_22650":838,"_15464":37939,"_5":15353,"_21389":37901,"_1893":37940},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_2303":852,"_22650":838,"_15464":37942,"_5":15353,"_21389":37905,"_1893":37943},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_2303":853,"_22650":838,"_15464":37945,"_5":15353,"_21389":37909,"_1893":37946},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_2303":854,"_22650":838,"_15464":37948,"_5":15353,"_21389":37913,"_1893":37949},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_2303":855,"_22650":838,"_15464":37951,"_5":15353,"_21389":37917,"_1893":37952},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_2303":856,"_22650":838,"_15464":37954,"_5":15353,"_21389":37921,"_1893":37955},[],"Lamassu persists four X.509 states:",{"_2303":857,"_22650":838,"_15464":37957,"_5":15353,"_21389":37921,"_1893":37958},[],"**`ACTIVE`**: the certificate is enabled and within its validity period.",{"_2303":858,"_22650":838,"_15464":37960,"_5":15353,"_21389":37921,"_1893":37961},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_2303":859,"_22650":838,"_15464":37963,"_5":15353,"_21389":37921,"_1893":37964},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_2303":860,"_22650":838,"_15464":37966,"_5":15353,"_21389":37921,"_1893":37967},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_2303":861,"_22650":838,"_15464":37969,"_5":15353,"_21389":37921,"_1893":37970},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_2303":862,"_22650":838,"_15464":37972,"_5":15353,"_21389":37925,"_1893":37973},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_2303":863,"_22650":838,"_15464":37975,"_5":15353,"_21389":37925,"_1893":37976},[],"Only a revocation with the reason `CertificateHold` can be undone. A revocation with any other reason is final in Lamassu.",{"_2303":864,"_22650":838,"_15464":37978,"_5":15353,"_21389":37925,"_1893":37979},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_2303":865,"_22650":838,"_15464":37981,"_5":15353,"_21389":37929,"_1893":37982},[],"Revoking a CA is a cascading operation. Lamassu revokes its child CAs and the certificates it issued, with the reason `CessationOfOperation`. The propagation continues down the hierarchy.",{"_2303":866,"_22650":838,"_15464":37984,"_5":15353,"_21389":37929,"_1893":37985},[],"Before confirming:",{"_2303":867,"_22650":838,"_15464":37987,"_5":15353,"_21389":37929,"_1893":37988},[],"Identify DMSs, devices and services that trust that chain.",{"_2303":868,"_22650":838,"_15464":37990,"_5":15353,"_21389":37929,"_1893":37991},[],"Distribute the new chain of trust.",{"_2303":869,"_22650":838,"_15464":37993,"_5":15353,"_21389":37929,"_1893":37994},[],"Reissue the necessary identities.",{"_2303":870,"_22650":838,"_15464":37996,"_5":15353,"_21389":37929,"_1893":37997},[],"Check OCSP and CRL from a real consumer.",{"_2303":871,"_22650":838,"_15464":37999,"_5":15353,"_21389":37929,"_1893":38000},[],"Revoke the old CA once no legitimate traffic remains.",{"_2303":872,"_22650":838,"_15464":38002,"_5":15353,"_21389":37929,"_1893":38003},[],"Decommissioning a device revokes its certificates and prevents it from obtaining new identities. Use this action only when the device is being retired permanently.",{"_2303":873,"_22650":838,"_15464":38005,"_5":15353,"_21389":37933,"_1893":38006},[],"Certificates entering the preventive or critical renewal window.",{"_2303":874,"_22650":838,"_15464":38008,"_5":15353,"_21389":37933,"_1893":38009},[],"Repeated enrollment or re-enrollment failures.",{"_2303":875,"_22650":838,"_15464":38011,"_5":15353,"_21389":37933,"_1893":38012},[],"Status changes and revocation reasons.",{"_2303":876,"_22650":838,"_15464":38014,"_5":15353,"_21389":37933,"_1893":38015},[],"OCSP and CRL publication and validity.",{"_2303":877,"_22650":838,"_15464":38017,"_5":15353,"_21389":37933,"_1893":38018},[],"Dependencies still presenting a replaced certificate.",{"_2303":878,"_22650":838,"_15464":38020,"_5":15353,"_21389":37933,"_1893":38021},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_2303":879,"_22650":879,"_5":10649,"_1893":38023,"_22909":38024,"_15464":38025,"_21389":879},"Glossary",[35256,36391,37842],[],{"_2303":880,"_22650":879,"_15464":38027,"_5":15353,"_21389":879,"_1893":38028},[],"PKI, certificate and identity management terms used in Lamassu.",{"_2303":881,"_22650":879,"_5":22906,"_15464":38030,"_21389":38031,"_1893":38032},[],"/docs/platform/pki/concepts/glossary#ac","A–C",{"_2303":882,"_22650":879,"_5":22906,"_15464":38034,"_21389":38035,"_1893":38036},[],"/docs/platform/pki/concepts/glossary#dk","D–K",{"_2303":883,"_22650":879,"_5":22906,"_15464":38038,"_21389":38039,"_1893":38040},[],"/docs/platform/pki/concepts/glossary#mr","M–R",{"_2303":884,"_22650":879,"_5":22906,"_15464":38042,"_21389":38043,"_1893":38044},[],"/docs/platform/pki/concepts/glossary#sz","S–Z",{"_2303":885,"_22650":879,"_15464":38046,"_5":15353,"_21389":38031,"_1893":38047},[],"**AKI (Authority Key Identifier)**\\\nIdentifier of the public key of the authority that signed a certificate. It helps build the chain toward the correct issuer.",{"_2303":886,"_22650":879,"_15464":38049,"_5":15353,"_21389":38031,"_1893":38050},[],"**Anchor of trust**\\\nA certificate, usually from a root CA, that a consumer explicitly accepts as the endpoint of a chain.",{"_2303":887,"_22650":879,"_15464":38052,"_5":15353,"_21389":38031,"_1893":38053},[],"**CA (Certification Authority)**\\\nAuthority that signs certificates and binds an identity to a public key.",{"_2303":888,"_22650":879,"_15464":38055,"_5":15353,"_21389":38031,"_1893":38056},[],"**Intermediate CA**\\\nA CA signed by another authority. Used to issue without exposing the root to daily operation.",{"_2303":889,"_22650":879,"_15464":38058,"_5":15353,"_21389":38031,"_1893":38059},[],"**Root CA**\\\nA self-signed CA that starts a hierarchy of trust.",{"_2303":890,"_22650":879,"_15464":38061,"_5":15353,"_21389":38031,"_1893":38062},[],"**X.509 certificate**\\\nA signed document containing a public key, a subject, an issuer, a validity period and extensions that constrain its use.",{"_2303":891,"_22650":879,"_15464":38064,"_5":15353,"_21389":38031,"_1893":38065},[],"**CRL (Certificate Revocation List)**\\\nSigned list of revoked certificates published by a CA.",{"_2303":892,"_22650":879,"_15464":38067,"_5":15353,"_21389":38031,"_1893":38068},[],"**CSR (Certificate Signing Request)**\\\nPKCS#10 request containing a public key and requested attributes. Signing the CSR proves possession of the corresponding private key.",{"_2303":893,"_22650":879,"_15464":38070,"_5":15353,"_21389":38035,"_1893":38071},[],"**DMS (Device Management Service)**\\\nConfiguration that groups registration, enrollment, re-enrollment, issuance and CA distribution rules for a fleet.",{"_2303":894,"_22650":879,"_15464":38073,"_5":15353,"_21389":38035,"_1893":38074},[],"**Distinguished Name (DN)**\\\nSet of subject or issuer attributes, such as `CN`, `O`, `OU`, `C`, `ST` and `L`.",{"_2303":895,"_22650":879,"_15464":38076,"_5":15353,"_21389":38035,"_1893":38077},[],"**EST (Enrollment over Secure Transport)**\\\nProtocol defined in RFC 7030 to obtain CAs, enroll and re-enroll certificates over HTTPS.",{"_2303":896,"_22650":879,"_15464":38079,"_5":15353,"_21389":38035,"_1893":38080},[],"**Extended Key Usage (EKU)**\\\nExtension that constrains purposes such as client authentication, server authentication, code signing or OCSP.",{"_2303":897,"_22650":879,"_15464":38082,"_5":15353,"_21389":38035,"_1893":38083},[],"**Device identity**\\\nRelationship between a device and one of its certificates. A device can keep a history of identities.",{"_2303":898,"_22650":879,"_15464":38085,"_5":15353,"_21389":38035,"_1893":38086},[],"**Identity slot**\\\nLogical position on a device where Lamassu binds an active or historical identity.",{"_2303":899,"_22650":879,"_15464":38088,"_5":15353,"_21389":38035,"_1893":38089},[],"**JITP (Just-in-Time Provisioning)**\\\nAutomatic registration of a device when it successfully completes its first enrollment.",{"_2303":900,"_22650":879,"_15464":38091,"_5":15353,"_21389":38035,"_1893":38092},[],"**KMS (Key Management Service)**\\\nLamassu service that normalizes key generation, import and use across different cryptographic engines.",{"_2303":901,"_22650":879,"_15464":38094,"_5":15353,"_21389":38035,"_1893":38095},[],"**Key Usage**\\\nX.509 extension that allows basic operations such as digital signature, key encryption or certificate signing.",{"_2303":902,"_22650":879,"_15464":38097,"_5":15353,"_21389":38039,"_1893":38098},[],"**mTLS (Mutual TLS)**\\\nTLS where both client and server present certificates. A DMS can use the client certificate as an authentication method.",{"_2303":903,"_22650":879,"_15464":38100,"_5":15353,"_21389":38039,"_1893":38101},[],"**OCSP (Online Certificate Status Protocol)**\\\nProtocol for querying online whether a certificate is valid, revoked or unknown.",{"_2303":904,"_22650":879,"_15464":38103,"_5":15353,"_21389":38039,"_1893":38104},[],"**Issuance profile**\\\nReusable policy that defines how Lamassu builds a certificate and which keys it accepts.",{"_2303":905,"_22650":879,"_15464":38106,"_5":15353,"_21389":38039,"_1893":38107},[],"**Principal**\\\nOperator or API client identity recognized by the authorization service. Lamassu supports OIDC and X.509 principals.",{"_2303":906,"_22650":879,"_15464":38109,"_5":15353,"_21389":38039,"_1893":38110},[],"**Policy**\\\nSet of permissions assignable to one or more principals.",{"_2303":907,"_22650":879,"_15464":38112,"_5":15353,"_21389":38039,"_1893":38113},[],"**RA (Registration Authority)**\\\nComponent that verifies the requester before asking a CA to issue. The DMS plays this role in device enrollment flows.",{"_2303":908,"_22650":879,"_15464":38115,"_5":15353,"_21389":38039,"_1893":38116},[],"**Relying party**\\\nConsuming system that decides whether to accept a presented certificate.",{"_2303":909,"_22650":879,"_15464":38118,"_5":15353,"_21389":38039,"_1893":38119},[],"**Revocation**\\\nInvalidation of a certificate before its expiration date.",{"_2303":910,"_22650":879,"_15464":38121,"_5":15353,"_21389":38043,"_1893":38122},[],"**SAN (Subject Alternative Name)**\\\nExtension that adds identities such as DNS names, IP addresses, emails or URIs.",{"_2303":911,"_22650":879,"_15464":38124,"_5":15353,"_21389":38043,"_1893":38125},[],"**SKI (Subject Key Identifier)**\\\nIdentifier derived from the public key of the certificate itself.",{"_2303":912,"_22650":879,"_15464":38127,"_5":15353,"_21389":38043,"_1893":38128},[],"**VA (Validation Authority)**\\\nLamassu service responsible for OCSP responses and the generation or publication of CRLs.",{"_2303":913,"_22650":879,"_15464":38130,"_5":15353,"_21389":38043,"_1893":38131},[],"**Renewal window**\\\nPeriod before expiration during which a device may or must request another identity.",{"_2303":914,"_22650":879,"_15464":38133,"_5":15353,"_21389":38043,"_1893":38134},[],"Missing an operational term? Check How Lamassu works and the Trust model first, where these concepts appear connected.",{"_2303":915,"_22650":915,"_5":10649,"_1893":38136,"_22909":38137,"_15464":38138,"_21389":915},"How Lamassu works",[35256,36391,37842],[],{"_2303":916,"_22650":915,"_15464":38140,"_5":15353,"_21389":915,"_1893":38141},[],"The mental model of trust, keys, certificates and devices.",{"_2303":917,"_22650":915,"_5":22906,"_15464":38143,"_21389":38144,"_1893":38145},[],"/docs/platform/pki/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_2303":918,"_22650":915,"_5":22906,"_15464":38147,"_21389":38148,"_1893":38149},[],"/docs/platform/pki/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_2303":919,"_22650":915,"_15464":38151,"_5":15353,"_21389":915,"_1893":38152},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_2303":920,"_22650":915,"_15464":38154,"_5":15353,"_21389":38144,"_1893":38155},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_2303":921,"_22650":915,"_15464":38157,"_5":15353,"_21389":38144,"_1893":38158},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_2303":922,"_22650":915,"_15464":38160,"_5":15353,"_21389":38144,"_1893":38161},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_2303":923,"_22650":915,"_15464":38163,"_5":15353,"_21389":38144,"_1893":38164},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_2303":924,"_22650":915,"_15464":38166,"_5":15353,"_21389":38144,"_1893":38167},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_2303":925,"_22650":915,"_15464":38169,"_5":15353,"_21389":38148,"_1893":38170},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_2303":926,"_22650":915,"_15464":38172,"_5":15353,"_21389":38148,"_1893":38173},[],"A DMS relates that CA to an enrollment policy.",{"_2303":927,"_22650":915,"_15464":38175,"_5":15353,"_21389":38148,"_1893":38176},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_2303":928,"_22650":915,"_15464":38178,"_5":15353,"_21389":38148,"_1893":38179},[],"Lamassu keeps the inventory, history and status of the identity.",{"_2303":929,"_22650":915,"_15464":38181,"_5":15353,"_21389":38148,"_1893":38182},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_2303":930,"_22650":915,"_15464":38184,"_5":15353,"_21389":38148,"_1893":38185},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/pki/concepts/architecture\" />",{"_2303":931,"_22650":915,"_15464":38187,"_5":15353,"_21389":38148,"_1893":38188},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2303":932,"_22650":932,"_5":10649,"_1893":38190,"_22909":38191,"_15464":38192,"_21389":932},"Trust model",[35256,36391,37842],[],{"_2303":933,"_22650":932,"_15464":38194,"_5":15353,"_21389":932,"_1893":38195},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_2303":934,"_22650":932,"_5":22906,"_15464":38197,"_21389":38198,"_1893":38199},[],"/docs/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_2303":935,"_22650":932,"_5":22906,"_15464":38201,"_21389":38202,"_1893":38203},[],"/docs/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_2303":936,"_22650":932,"_5":22906,"_15464":38205,"_21389":38206,"_1893":38207},[],"/docs/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_2303":937,"_22650":932,"_5":22906,"_15464":38209,"_21389":38210,"_1893":38211},[],"/docs/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_2303":938,"_22650":932,"_5":22906,"_15464":38213,"_21389":38214,"_1893":38215},[],"/docs/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_2303":939,"_22650":932,"_5":22906,"_15464":38217,"_21389":38218,"_1893":38219},[],"/docs/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_2303":940,"_22650":932,"_5":22906,"_15464":38221,"_21389":38222,"_1893":38223},[],"/docs/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_2303":941,"_22650":932,"_5":22906,"_15464":38225,"_21389":38226,"_1893":38227},[],"/docs/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_2303":942,"_22650":932,"_5":22906,"_15464":38229,"_21389":38230,"_1893":38231},[],"/docs/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_2303":943,"_22650":932,"_5":22906,"_15464":38233,"_21389":38234,"_1893":38235},[],"/docs/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_2303":944,"_22650":932,"_15464":38237,"_5":15353,"_21389":932,"_1893":38238},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_2303":945,"_22650":932,"_15464":38240,"_5":15353,"_21389":38202,"_1893":38241},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_2303":946,"_22650":932,"_15464":38243,"_5":15353,"_21389":38206,"_1893":38244},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_2303":947,"_22650":932,"_15464":38246,"_5":15353,"_21389":38210,"_1893":38247},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_2303":948,"_22650":932,"_15464":38249,"_5":15353,"_21389":38214,"_1893":38250},[],"The consuming service or device keeps its own trust store. Lamassu can distribute the system CA, the enrollment CA and other managed CAs through `/cacerts`, but the consumer decides which ones it installs and how it applies validation.",{"_2303":949,"_22650":932,"_15464":38252,"_5":15353,"_21389":38218,"_1893":38253},[],"The device proves it can enroll according to the DMS policy.",{"_2303":950,"_22650":932,"_15464":38255,"_5":15353,"_21389":38218,"_1893":38256},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_2303":951,"_22650":932,"_15464":38258,"_5":15353,"_21389":38218,"_1893":38259},[],"The CA applies the profile and signs without ever receiving the device's private key.",{"_2303":952,"_22650":932,"_15464":38261,"_5":15353,"_21389":38218,"_1893":38262},[],"The device installs the certificate and the chain it needs.",{"_2303":953,"_22650":932,"_15464":38264,"_5":15353,"_21389":38218,"_1893":38265},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_2303":954,"_22650":932,"_15464":38267,"_5":15353,"_21389":38218,"_1893":38268},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_2303":955,"_22650":932,"_15464":38270,"_5":15353,"_21389":38222,"_1893":38271},[],"A DMS relates three sets that are worth designing separately:",{"_2303":956,"_22650":932,"_15464":38273,"_5":15353,"_21389":38222,"_1893":38274},[],"**Enrollment CA:** signs the new identities.",{"_2303":957,"_22650":932,"_15464":38276,"_5":15353,"_21389":38222,"_1893":38277},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, Lamassu tries the enrollment CA first and then the additional validation CAs.",{"_2303":958,"_22650":932,"_15464":38279,"_5":15353,"_21389":38222,"_1893":38280},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the system CA, the enrollment CA and a list of managed CAs.",{"_2303":959,"_22650":932,"_15464":38282,"_5":15353,"_21389":38222,"_1893":38283},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_2303":960,"_22650":932,"_15464":38285,"_5":15353,"_21389":38226,"_1893":38286},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_2303":961,"_22650":932,"_15464":38288,"_5":15353,"_21389":38226,"_1893":38289},[],"that the current date is between `Not Before` and `Not After`;",{"_2303":962,"_22650":932,"_15464":38291,"_5":15353,"_21389":38226,"_1893":38292},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_2303":963,"_22650":932,"_15464":38294,"_5":15353,"_21389":38226,"_1893":38295},[],"that names, SANs and subject match the expected identity;",{"_2303":964,"_22650":932,"_15464":38297,"_5":15353,"_21389":38226,"_1893":38298},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_2303":965,"_22650":932,"_15464":38300,"_5":15353,"_21389":38226,"_1893":38301},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_2303":966,"_22650":932,"_15464":38303,"_5":15353,"_21389":38230,"_1893":38304},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_2303":967,"_22650":932,"_15464":38306,"_5":15353,"_21389":38234,"_1893":38307},[],"Keep the root out of daily operations, or with very restricted access.",{"_2303":968,"_22650":932,"_15464":38309,"_5":15353,"_21389":38234,"_1893":38310},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_2303":969,"_22650":932,"_15464":38312,"_5":15353,"_21389":38234,"_1893":38313},[],"Assign explicit profiles to every use case.",{"_2303":970,"_22650":932,"_15464":38315,"_5":15353,"_21389":38234,"_1893":38316},[],"Distribute the new trust before starting a rotation.",{"_2303":971,"_22650":932,"_15464":38318,"_5":15353,"_21389":38234,"_1893":38319},[],"Keep enough overlap to renew a disconnected fleet.",{"_2303":972,"_22650":932,"_15464":38321,"_5":15353,"_21389":38234,"_1893":38322},[],"Validate from the consuming system, not only from the Lamassu console.",{"_2303":973,"_22650":932,"_15464":38324,"_5":15353,"_21389":38234,"_1893":38325},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_2303":974,"_22650":974,"_5":10649,"_1893":38327,"_22909":38328,"_15464":38329,"_21389":974},"Revocation lists (CRL)",[35256,36391,36869],[],{"_2303":975,"_22650":974,"_15464":38331,"_5":15353,"_21389":974,"_1893":38332},[],"Generate and distribute signed lists to validate certificates offline.",{"_2303":976,"_22650":974,"_5":22906,"_15464":38334,"_21389":38335,"_1893":38336},[],"/docs/platform/pki/crl#crl-service","CRL service",{"_2303":977,"_22650":974,"_5":22906,"_15464":38338,"_21389":38339,"_1893":38340},[],"/docs/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_2303":978,"_22650":974,"_5":22906,"_15464":38342,"_21389":38343,"_1893":38344},[],"/docs/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_2303":979,"_22650":974,"_5":22906,"_15464":38346,"_21389":38347,"_1893":38348},[],"/docs/platform/pki/crl#crl-contents","CRL contents",{"_2303":980,"_22650":974,"_5":22906,"_15464":38350,"_21389":38351,"_1893":38352},[],"/docs/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_2303":981,"_22650":974,"_5":22906,"_15464":38354,"_21389":38355,"_1893":38356},[],"/docs/platform/pki/crl#va-role-management-api","VA role management API",{"_2303":982,"_22650":974,"_5":22906,"_15464":38358,"_21389":38359,"_1893":38360},[],"/docs/platform/pki/crl#from-the-interface","From the interface",{"_2303":983,"_22650":974,"_5":22906,"_15464":38362,"_21389":38363,"_1893":38364},[],"/docs/platform/pki/crl#references","References",{"_2303":984,"_22650":974,"_15464":38366,"_5":15353,"_21389":38335,"_1893":38367},[],"A CRL (*Certificate Revocation List*) is a signed list containing the serial numbers of certificates revoked before their expiration date. Unlike OCSP, it does not require a real-time query: the relying party downloads the list periodically and consults it locally.",{"_2303":985,"_22650":974,"_15464":38369,"_5":15353,"_21389":38335,"_1893":38370},[],"Lamassu generates and maintains one CRL per CA it manages. Each CRL is signed with the private key of the issuing CA itself and is stored in the object storage configured on the platform.",{"_2303":986,"_22650":974,"_15464":38372,"_5":15353,"_21389":38339,"_1893":38373},[],"The publication of each CA's CRL is controlled by a *VA role*. This object defines how it is generated, when it is regenerated and which key signs it.",{"_2303":987,"_22650":974,"_15464":38375,"_5":15353,"_21389":38339,"_1893":38376},[],"The main parameters are:",{"_2303":988,"_22650":974,"_15464":38378,"_5":15353,"_21389":38339,"_1893":38379},[],"**`validity`** defines the validity period reflected in `nextUpdate`. Its default value is 7 days.",{"_2303":989,"_22650":974,"_15464":38381,"_5":15353,"_21389":38339,"_1893":38382},[],"**`refresh_interval`** sets the minimum interval between scheduled regenerations. By default it is approximately 6 days and 23 hours.",{"_2303":990,"_22650":974,"_15464":38384,"_5":15353,"_21389":38339,"_1893":38385},[],"**`regenerate_on_revoke`** orders publishing a new version immediately after a revocation. It is enabled by default.",{"_2303":991,"_22650":974,"_15464":38387,"_5":15353,"_21389":38339,"_1893":38388},[],"The `subject_key_id_signer` field identifies the CA whose private key signs the CRL. By default, each CA signs its own CRL.",{"_2303":992,"_22650":974,"_15464":38390,"_5":15353,"_21389":38339,"_1893":38391},[],"Each CRL carries an incremental version number. Lamassu stores all versions under the path `pki/va/crl/{subject_key_id}/{version}.crl` in object storage.",{"_2303":993,"_22650":974,"_15464":38393,"_5":15353,"_21389":38343,"_1893":38394},[],"A background process monitors active VA roles. When the remaining validity of the current CRL falls below the configured watch period (*blind period*), the system requests the generation of a new CRL. This prevents the published CRL from expiring without a valid version available.",{"_2303":994,"_22650":974,"_15464":38396,"_5":15353,"_21389":38343,"_1893":38397},[],"Additionally, when `regenerate_on_revoke` is enabled, which is the default behavior, any certificate revocation immediately triggers the generation of a new CRL for the affected CA. This minimizes the time between revocation and its publication.",{"_2303":995,"_22650":974,"_15464":38399,"_5":15353,"_21389":38347,"_1893":38400},[],"Each entry of the CRL includes the serial number of the revoked certificate, the revocation date and the RFC 5280 reason code.",{"_2303":996,"_22650":974,"_15464":38402,"_5":15353,"_21389":38347,"_1893":38403},[],"The CRL also includes the *Issuing Distribution Point* (IDP, OID 2.5.29.28) extension, marked as critical, which indicates the public URL from which it can be downloaded. That URL points to the `/crl/{subject_key_id}` endpoint of each configured VA domain.",{"_2303":997,"_22650":974,"_15464":38405,"_5":15353,"_21389":38351,"_1893":38406},[],"The latest CRL of a CA can be obtained directly without authentication:",{"_2303":998,"_22650":974,"_15464":38408,"_5":15353,"_21389":38351,"_1893":38409},[],"The response has `Content-Type: application/pkix-crl` and contains the CRL in DER format.",{"_2303":999,"_22650":974,"_15464":38411,"_5":15353,"_21389":38355,"_1893":38412},[],"The VA role of a CA can be queried and updated through the API:",{"_2303":1000,"_22650":974,"_15464":38414,"_5":15353,"_21389":38355,"_1893":38415},[],"Method",{"_2303":1001,"_22650":974,"_15464":38417,"_5":15353,"_21389":38355,"_1893":38418},[],"Path",{"_2303":1002,"_22650":974,"_15464":38420,"_5":15353,"_21389":38355,"_1893":38421},[],"Description",{"_2303":1003,"_22650":974,"_15464":38423,"_5":15353,"_21389":38355,"_1893":38424},[],"`GET`",{"_2303":1004,"_22650":974,"_15464":38426,"_5":15353,"_21389":38355,"_1893":38427},[],"`/v1/roles/{ca-ski}`",{"_2303":1005,"_22650":974,"_15464":38429,"_5":15353,"_21389":38355,"_1893":38430},[],"Returns the VA role configuration and the metadata of the last issued CRL.",{"_2303":1006,"_22650":974,"_15464":38432,"_5":15353,"_21389":38355,"_1893":38433},[],"`PUT`",{"_2303":1007,"_22650":974,"_15464":38435,"_5":15353,"_21389":38355,"_1893":38427},[],{"_2303":1008,"_22650":974,"_15464":38437,"_5":15353,"_21389":38355,"_1893":38438},[],"Updates the VA role configuration parameters (`validity`, `refresh_interval`, `regenerate_on_revoke`).",{"_2303":1009,"_22650":974,"_15464":38440,"_5":15353,"_21389":38355,"_1893":38441},[],"Example of querying the VA role:",{"_2303":1010,"_22650":974,"_15464":38443,"_5":15353,"_21389":38355,"_1893":38444},[],"The response includes the `latest_crl` field with the version, the start of validity and the expiration date of the currently published CRL.",{"_2303":1011,"_22650":974,"_15464":38446,"_5":15353,"_21389":38359,"_1893":38447},[],"From a CA's detail panel you can preview the content of the active CRL and download it directly for offline use or for importing into applications that perform local validation.",{"_2303":1012,"_22650":974,"_15464":38449,"_5":15353,"_21389":38363,"_1893":38450},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile*",{"_2303":1013,"_22650":974,"_15464":38452,"_5":15353,"_21389":38363,"_1893":38453},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_2303":1014,"_22650":974,"_15464":38455,"_5":15353,"_21389":38363,"_1893":38456},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2303":1015,"_22650":1015,"_5":10649,"_1893":38458,"_22909":38459,"_15464":38460,"_21389":1015},"Device Management Service",[35256,36391,36869],[],{"_2303":1016,"_22650":1015,"_15464":38462,"_5":15353,"_21389":1015,"_1893":38463},[],"Define how a fleet receives, renews and uses its identities.",{"_2303":1017,"_22650":1015,"_5":22906,"_15464":38465,"_21389":38466,"_1893":35266},[],"/docs/platform/pki/device-enrollment#before-you-begin",{"_2303":1018,"_22650":1015,"_5":22906,"_15464":38468,"_21389":38469,"_1893":38470},[],"/docs/platform/pki/device-enrollment#configure-a-dms","Configure a DMS",{"_2303":1019,"_22650":1015,"_5":22906,"_15464":38472,"_21389":38473,"_1893":38474},[],"/docs/platform/pki/device-enrollment#identify-the-fleet","Identify the fleet",{"_2303":1020,"_22650":1015,"_5":22906,"_15464":38476,"_21389":38477,"_1893":38478},[],"/docs/platform/pki/device-enrollment#select-the-enrollment-ca","Select the enrollment CA",{"_2303":1021,"_22650":1015,"_5":22906,"_15464":38480,"_21389":38481,"_1893":38482},[],"/docs/platform/pki/device-enrollment#configure-est","Configure EST",{"_2303":1022,"_22650":1015,"_5":22906,"_15464":38484,"_21389":38485,"_1893":38486},[],"/docs/platform/pki/device-enrollment#distribute-trust","Distribute trust",{"_2303":1023,"_22650":1015,"_5":22906,"_15464":38488,"_21389":38489,"_1893":38490},[],"/docs/platform/pki/device-enrollment#verify-the-endpoints","Verify the endpoints",{"_2303":1024,"_22650":1015,"_5":22906,"_15464":38492,"_21389":38493,"_1893":38494},[],"/docs/platform/pki/device-enrollment#trust-distribution","Trust distribution",{"_2303":1025,"_22650":1015,"_5":22906,"_15464":38496,"_21389":38497,"_1893":38498},[],"/docs/platform/pki/device-enrollment#operate-the-dms-inventory","Operate the DMS inventory",{"_2303":1026,"_22650":1015,"_5":22906,"_15464":38500,"_21389":38501,"_1893":38502},[],"/docs/platform/pki/device-enrollment#integrate-the-devices","Integrate the devices",{"_2303":1027,"_22650":1015,"_15464":38504,"_5":15353,"_21389":1015,"_1893":38505},[],"A &#x2A;*Device Management Service (DMS)** acts as the registration authority facing a fleet. It receives requests, applies the authentication policy and delegates issuance to the configured CA.",{"_2303":1028,"_22650":1015,"_15464":38507,"_5":15353,"_21389":1015,"_1893":38508},[],"Each DMS is an independent operational boundary: it can represent a product line, an environment or a device type with its own CA, authentication rules, distributed trust and renewal window.",{"_2303":1029,"_22650":1015,"_15464":38510,"_5":15353,"_21389":38466,"_1893":38511},[],"Create or import at least one active CA.",{"_2303":1030,"_22650":1015,"_15464":38513,"_5":15353,"_21389":38466,"_1893":38514},[],"Decide how devices will authenticate during initial enrollment.",{"_2303":1031,"_22650":1015,"_15464":38516,"_5":15353,"_21389":38466,"_1893":38517},[],"Define which authorities the device should receive as anchors of trust.",{"_2303":1032,"_22650":1015,"_15464":38519,"_5":15353,"_21389":38466,"_1893":38520},[],"Make sure you have permissions to administer DMSs.",{"_2303":1033,"_22650":1015,"_15464":38522,"_5":15353,"_21389":38473,"_1893":38523},[],"Give the DMS a name that describes its scope, for example a device family or an environment.",{"_2303":1034,"_22650":1015,"_15464":38525,"_5":15353,"_21389":38477,"_1893":38526},[],"Choose the authority that will issue the identities. Its policy and validity period constrain the certificates the fleet can obtain.",{"_2303":1035,"_22650":1015,"_15464":38528,"_5":15353,"_21389":38481,"_1893":38529},[],"Define the authentication of `enroll`, the `reenroll` policy, the renewal window and, if needed, `serverkeygen`.",{"_2303":1036,"_22650":1015,"_15464":38531,"_5":15353,"_21389":38485,"_1893":38532},[],"Configure **CA Distribution** to control the response of the `cacerts` endpoint.",{"_2303":1037,"_22650":1015,"_15464":38534,"_5":15353,"_21389":38489,"_1893":38535},[],"From the DMS menu, open &#x2A;*EST (RFC-7030)** and check the base URL and the invocation examples before integrating the firmware.",{"_2303":1038,"_22650":1015,"_15464":38537,"_5":15353,"_21389":38493,"_1893":38538},[],"**Include Lamassu System CA** distributes the TLS certificate of the Lamassu server, useful for *pinning*. It does not represent an issuing CA.",{"_2303":1039,"_22650":1015,"_15464":38540,"_5":15353,"_21389":38493,"_1893":38541},[],"**Include Enrollment CA** adds the authority configured to issue the DMS's identities.",{"_2303":1040,"_22650":1015,"_15464":38543,"_5":15353,"_21389":38493,"_1893":38544},[],"**Managed CAs** lets you include additional authorities the device must consider trusted.",{"_2303":1041,"_22650":1015,"_15464":38546,"_5":15353,"_21389":38497,"_1893":38547},[],"**Edit** modifies the DMS policy.",{"_2303":1042,"_22650":1015,"_15464":38549,"_5":15353,"_21389":38497,"_1893":38550},[],"**Go to DMS owned devices** opens only the devices of that fleet.",{"_2303":1043,"_22650":1015,"_15464":38552,"_5":15353,"_21389":38497,"_1893":38553},[],"**Show/Edit Metadata** manages advanced configuration and integration data.",{"_2303":1044,"_22650":1015,"_15464":38555,"_5":15353,"_21389":38497,"_1893":38556},[],"**EST (RFC-7030)** shows the endpoints and examples specific to the DMS.",{"_2303":1045,"_22650":1015,"_15464":38558,"_5":15353,"_21389":38497,"_1893":38559},[],"**Delete** removes the DMS and its configuration. The action is irreversible.",{"_2303":1046,"_22650":1015,"_15464":38561,"_5":15353,"_21389":38501,"_1893":38562},[],"<Card title=\"EST enrollment\" description=\"Configure authentication, endpoints and flows for firmware.\" href=\"/docs/platform/pki/est-enrollment\" />",{"_2303":1047,"_22650":1015,"_15464":38564,"_5":15353,"_21389":38501,"_1893":38565},[],"<Card title=\"Devices and identities\" description=\"Review statuses, history and operational actions.\" href=\"/docs/platform/pki/device-management\" />",{"_2303":1048,"_22650":1048,"_5":10649,"_1893":38567,"_22909":38568,"_15464":38569,"_21389":1048},"Devices and identities",[35256,36391,36869],[],{"_2303":1049,"_22650":1048,"_15464":38571,"_5":15353,"_21389":1048,"_1893":38572},[],"Register devices and control their identities throughout the lifecycle.",{"_2303":1050,"_22650":1048,"_5":22906,"_15464":38574,"_21389":38575,"_1893":38576},[],"/docs/platform/pki/device-management#device-states","Device states",{"_2303":1051,"_22650":1048,"_5":22906,"_15464":38578,"_21389":38579,"_1893":38580},[],"/docs/platform/pki/device-management#inspect-a-device","Inspect a device",{"_2303":1052,"_22650":1048,"_5":22906,"_15464":38582,"_21389":38583,"_1893":38584},[],"/docs/platform/pki/device-management#register-a-device-manually","Register a device manually",{"_2303":1053,"_22650":1048,"_5":22906,"_15464":38586,"_21389":38587,"_1893":38588},[],"/docs/platform/pki/device-management#create-the-device","Create the device",{"_2303":1054,"_22650":1048,"_5":22906,"_15464":38590,"_21389":38591,"_1893":38592},[],"/docs/platform/pki/device-management#define-its-membership","Define its membership",{"_2303":1055,"_22650":1048,"_5":22906,"_15464":38594,"_21389":38595,"_1893":38596},[],"/docs/platform/pki/device-management#classify-the-device","Classify the device",{"_2303":1056,"_22650":1048,"_5":22906,"_15464":38598,"_21389":38599,"_1893":38600},[],"/docs/platform/pki/device-management#verify-the-registration","Verify the registration",{"_2303":1057,"_22650":1048,"_5":22906,"_15464":38602,"_21389":38603,"_1893":38604},[],"/docs/platform/pki/device-management#assign-an-identity-manually","Assign an identity manually",{"_2303":1058,"_22650":1048,"_5":22906,"_15464":38606,"_21389":38607,"_1893":38608},[],"/docs/platform/pki/device-management#revoke-the-current-identity","Revoke the current identity",{"_2303":1059,"_22650":1048,"_5":22906,"_15464":38610,"_21389":38611,"_1893":38612},[],"/docs/platform/pki/device-management#decommission-a-device","Decommission a device",{"_2303":1060,"_22650":1048,"_5":22906,"_15464":38614,"_21389":38615,"_1893":38616},[],"/docs/platform/pki/device-management#automate-enrollment","Automate enrollment",{"_2303":1061,"_22650":1048,"_15464":38618,"_5":15353,"_21389":1048,"_1893":38619},[],"A managed device represents an entity in your fleet and keeps the history of the certificates it has used. Lamassu separates the device from its current identity so you can renew or replace certificates without losing traceability.",{"_2303":1062,"_22650":1048,"_15464":38621,"_5":15353,"_21389":38575,"_1893":38622},[],"**Active** indicates the device has a valid identity.",{"_2303":1063,"_22650":1048,"_15464":38624,"_5":15353,"_21389":38575,"_1893":38625},[],"**No Identity** appears when it is registered but does not yet have an associated certificate.",{"_2303":1064,"_22650":1048,"_15464":38627,"_5":15353,"_21389":38575,"_1893":38628},[],"**Renewal Pending** signals that it has entered the renewal window.",{"_2303":1065,"_22650":1048,"_15464":38630,"_5":15353,"_21389":38575,"_1893":38631},[],"**Expiring Soon** warns that the certificate is close to expiring.",{"_2303":1066,"_22650":1048,"_15464":38633,"_5":15353,"_21389":38575,"_1893":38634},[],"**Expired** indicates the identity has passed its validity date.",{"_2303":1067,"_22650":1048,"_15464":38636,"_5":15353,"_21389":38575,"_1893":38637},[],"**Revoked** identifies a certificate invalidated before its expiration.",{"_2303":1068,"_22650":1048,"_15464":38639,"_5":15353,"_21389":38575,"_1893":38640},[],"**Decommissioned** corresponds to a device permanently retired.",{"_2303":1069,"_22650":1048,"_15464":38642,"_5":15353,"_21389":38575,"_1893":38643},[],"The inventory lets you filter by `Device ID`, tags and status.",{"_2303":1070,"_22650":1048,"_15464":38645,"_5":15353,"_21389":38579,"_1893":38646},[],"The detail view separates two perspectives:",{"_2303":1071,"_22650":1048,"_15464":38648,"_5":15353,"_21389":38579,"_1893":38649},[],"**Certificate History** keeps every certificate associated with the device, with its serial number, issuer, status and validity period.",{"_2303":1072,"_22650":1048,"_15464":38651,"_5":15353,"_21389":38579,"_1893":38652},[],"**Device Event Timeline** orders registrations, enrollments, renewals and status changes chronologically.",{"_2303":1073,"_22650":1048,"_15464":38654,"_5":15353,"_21389":38579,"_1893":38655},[],"Use the history for audit and the timeline to reconstruct an incident or diagnose an unexpected transition.",{"_2303":1074,"_22650":1048,"_15464":38657,"_5":15353,"_21389":38583,"_1893":38658},[],"Pre-registration is useful when policy requires the device to exist before requesting its first certificate.",{"_2303":1075,"_22650":1048,"_15464":38660,"_5":15353,"_21389":38587,"_1893":38661},[],"From **Managed Devices**, open the registration form.",{"_2303":1076,"_22650":1048,"_15464":38663,"_5":15353,"_21389":38591,"_1893":38664},[],"Enter a unique **Device ID** and select the DMS that will apply the enrollment and renewal policies.",{"_2303":1077,"_22650":1048,"_15464":38666,"_5":15353,"_21389":38595,"_1893":38667},[],"Add an icon and tags if you need to group devices by model, location, environment or another operational criterion.",{"_2303":1078,"_22650":1048,"_15464":38669,"_5":15353,"_21389":38599,"_1893":38670},[],"The device should appear with status **No Identity** until it completes enrollment or receives a manually assigned identity.",{"_2303":1079,"_22650":1048,"_15464":38672,"_5":15353,"_21389":38603,"_1893":38673},[],"The **Assign Identity** action is available while the device remains in **No Identity**.",{"_2303":1080,"_22650":1048,"_15464":38675,"_5":15353,"_21389":38603,"_1893":38676},[],"Open the device and select **Assign Identity**.",{"_2303":1081,"_22650":1048,"_15464":38678,"_5":15353,"_21389":38603,"_1893":38679},[],"Choose an active certificate whose `Common Name` matches the `Device ID`.",{"_2303":1082,"_22650":1048,"_15464":38681,"_5":15353,"_21389":38603,"_1893":38682},[],"If none exists, select **Issue New Instead** and choose a CA linked to the DMS.",{"_2303":1083,"_22650":1048,"_15464":38684,"_5":15353,"_21389":38603,"_1893":38685},[],"Confirm the assignment.",{"_2303":1084,"_22650":1048,"_15464":38687,"_5":15353,"_21389":38603,"_1893":38688},[],"The device should change to **Active** and the certificate should appear in its history.",{"_2303":1085,"_22650":1048,"_15464":38690,"_5":15353,"_21389":38607,"_1893":38691},[],"In **Device Event Timeline**, locate the latest active certificate and select **Revoke**. Choose a reason consistent with your policy and confirm the operation.",{"_2303":1086,"_22650":1048,"_15464":38693,"_5":15353,"_21389":38607,"_1893":38694},[],"Revocation invalidates the certificate but does not delete the device. You can restore its operation by assigning it a new identity. `CertificateHold` allows reactivating the retained certificate; all other reasons are final.",{"_2303":1087,"_22650":1048,"_15464":38696,"_5":15353,"_21389":38611,"_1893":38697},[],"This action revokes all the device's certificates and prevents it from obtaining an identity again.",{"_2303":1088,"_22650":1048,"_15464":38699,"_5":15353,"_21389":38611,"_1893":38700},[],"Use **Decommission** only when the device has stopped operating or is no longer trustworthy. After confirming, Lamassu revokes the active identity with `CessationOfOperation` and changes the status to **Decommissioned**.",{"_2303":1089,"_22650":1048,"_15464":38702,"_5":15353,"_21389":38615,"_1893":38703},[],"<Card title=\"Configure a DMS\" description=\"Define the CA, trust and policies of the fleet.\" href=\"/docs/platform/pki/device-enrollment\" />",{"_2303":1090,"_22650":1048,"_15464":38705,"_5":15353,"_21389":38615,"_1893":38706},[],"<Card title=\"Integrate EST\" description=\"Let the device request and renew its identity.\" href=\"/docs/platform/pki/est-enrollment\" />",{"_2303":1091,"_22650":1091,"_5":10649,"_1893":38708,"_22909":38709,"_15464":38710,"_21389":1091},"Device enrollment with EST",[35256,36391,36869],[],{"_2303":1092,"_22650":1091,"_15464":38712,"_5":15353,"_21389":1091,"_1893":38713},[],"EST protocol guide for Lamassu IoT, with DMS configuration for the PKI administrator and the endpoint reference for device integrators.",{"_2303":1093,"_22650":1091,"_5":22906,"_15464":38715,"_21389":38716,"_1893":38717},[],"/docs/platform/pki/est-enrollment#est-enrollment-over-secure-transport","EST: Enrollment over Secure Transport",{"_2303":1094,"_22650":1091,"_5":22906,"_15464":38719,"_21389":38720,"_1893":38721},[],"/docs/platform/pki/est-enrollment#dms-configuration","DMS configuration",{"_2303":1095,"_22650":1091,"_5":22906,"_15464":38723,"_21389":38724,"_1893":38725},[],"/docs/platform/pki/est-enrollment#prerequisites","Prerequisites",{"_2303":1096,"_22650":1091,"_5":22906,"_15464":38727,"_21389":38728,"_1893":38729},[],"/docs/platform/pki/est-enrollment#enrollment-configuration","Enrollment configuration",{"_2303":1097,"_22650":1091,"_5":22906,"_15464":38731,"_21389":38732,"_1893":38733},[],"/docs/platform/pki/est-enrollment#enrollment-device-registration","Enrollment Device Registration",{"_2303":1098,"_22650":1091,"_5":22906,"_15464":38735,"_21389":38736,"_1893":38737},[],"/docs/platform/pki/est-enrollment#enrollment-settings","Enrollment Settings",{"_2303":1099,"_22650":1091,"_5":22906,"_15464":38739,"_21389":38740,"_1893":38741},[],"/docs/platform/pki/est-enrollment#issuance-profile","Issuance profile",{"_2303":1100,"_22650":1091,"_5":22906,"_15464":38743,"_21389":38744,"_1893":38745},[],"/docs/platform/pki/est-enrollment#re-enrollment-configuration","Re-enrollment configuration",{"_2303":1101,"_22650":1091,"_5":22906,"_15464":38747,"_21389":38748,"_1893":38749},[],"/docs/platform/pki/est-enrollment#serverkeygen-configuration","ServerKeyGen configuration",{"_2303":1102,"_22650":1091,"_5":22906,"_15464":38751,"_21389":38752,"_1893":38753},[],"/docs/platform/pki/est-enrollment#verify-the-configuration","Verify the configuration",{"_2303":1103,"_22650":1091,"_5":22906,"_15464":38755,"_21389":38756,"_1893":38757},[],"/docs/platform/pki/est-enrollment#device-integration","Device integration",{"_2303":1104,"_22650":1091,"_5":22906,"_15464":38759,"_21389":38760,"_1893":35266},[],"/docs/platform/pki/est-enrollment#before-you-begin",{"_2303":1105,"_22650":1091,"_5":22906,"_15464":38762,"_21389":38763,"_1893":38764},[],"/docs/platform/pki/est-enrollment#flow-overview","Flow overview",{"_2303":1106,"_22650":1091,"_5":22906,"_15464":38766,"_21389":38767,"_1893":38768},[],"/docs/platform/pki/est-enrollment#client-authentication-model","Client authentication model",{"_2303":1107,"_22650":1091,"_5":22906,"_15464":38770,"_21389":38771,"_1893":38772},[],"/docs/platform/pki/est-enrollment#endpoint-reference","Endpoint reference",{"_2303":1108,"_22650":1091,"_5":22906,"_15464":38774,"_21389":38775,"_1893":38776},[],"/docs/platform/pki/est-enrollment#cacerts","`/cacerts`",{"_2303":1109,"_22650":1091,"_5":22906,"_15464":38778,"_21389":38779,"_1893":38780},[],"/docs/platform/pki/est-enrollment#simpleenroll","`/simpleenroll`",{"_2303":1110,"_22650":1091,"_5":22906,"_15464":38782,"_21389":38783,"_1893":38784},[],"/docs/platform/pki/est-enrollment#simplereenroll","`/simplereenroll`",{"_2303":1111,"_22650":1091,"_5":22906,"_15464":38786,"_21389":38787,"_1893":38788},[],"/docs/platform/pki/est-enrollment#serverkeygen","`/serverkeygen`",{"_2303":1112,"_22650":1091,"_5":22906,"_15464":38790,"_21389":38791,"_1893":38792},[],"/docs/platform/pki/est-enrollment#full-flows","Full flows",{"_2303":1113,"_22650":1091,"_5":22906,"_15464":38794,"_21389":38795,"_1893":38796},[],"/docs/platform/pki/est-enrollment#end-to-end-example-enroll","End-to-end example: enroll",{"_2303":1114,"_22650":1091,"_5":22906,"_15464":38798,"_21389":38799,"_1893":38800},[],"/docs/platform/pki/est-enrollment#end-to-end-example-reenroll","End-to-end example: reenroll",{"_2303":1115,"_22650":1091,"_5":22906,"_15464":38802,"_21389":38803,"_1893":38804},[],"/docs/platform/pki/est-enrollment#next-steps-after-enrollment","Next steps after enrollment",{"_2303":1116,"_22650":1091,"_5":22906,"_15464":38806,"_21389":38807,"_1893":38808},[],"/docs/platform/pki/est-enrollment#diagnostics-and-compatibility","Diagnostics and compatibility",{"_2303":1117,"_22650":1091,"_5":22906,"_15464":38810,"_21389":38811,"_1893":38812},[],"/docs/platform/pki/est-enrollment#error-codes-and-diagnostics","Error codes and diagnostics",{"_2303":1118,"_22650":1091,"_5":22906,"_15464":38814,"_21389":38815,"_1893":38816},[],"/docs/platform/pki/est-enrollment#compatibility-notes","Compatibility notes",{"_2303":1119,"_22650":1091,"_15464":38818,"_5":15353,"_21389":38716,"_1893":38819},[],"Lamassu IoT implements the &#x2A;*EST (Enrollment over Secure Transport)** protocol described in RFC 7030 as its only certificate enrollment mechanism for devices. Each DMS exposes the EST endpoints, validates the device and applies its own authentication, registration and renewal policies. In doing so, it acts as the Registration Authority (RA) facing the client.",{"_2303":1120,"_22650":1091,"_15464":38821,"_5":15353,"_21389":38716,"_1893":38822},[],"The entity that issues and cryptographically signs the certificate is always the **CA associated with the DMS**, not the DMS. The DMS coordinates the process: it receives the CSR, authenticates the device and applies the issuance policy. This distinction matters for the PKI administrator when selecting the `EnrollmentCA` and for the integrator when interpreting the chain of trust received from `/cacerts`.",{"_2303":1121,"_22650":1091,"_15464":38824,"_5":15353,"_21389":38716,"_1893":38825},[],"This guide is split in two parts:",{"_2303":1122,"_22650":1091,"_15464":38827,"_5":15353,"_21389":38716,"_1893":38828},[],"DMS configuration, for the PKI administrator.",{"_2303":1123,"_22650":1091,"_15464":38830,"_5":15353,"_21389":38716,"_1893":38831},[],"Device integration, for anyone consuming the EST endpoints from firmware, scripts or provisioning services.",{"_2303":1124,"_22650":1091,"_15464":38833,"_5":15353,"_21389":38716,"_1893":38834},[],"If you only need a quick orientation, this is the recommended route:",{"_2303":1125,"_22650":1091,"_15464":38836,"_5":15353,"_21389":38716,"_1893":38837},[],"**PKI administrator:** start with DMS configuration and finish with Diagnostics and compatibility.",{"_2303":1126,"_22650":1091,"_15464":38839,"_5":15353,"_21389":38716,"_1893":38840},[],"**Device integrator:** start with Before you begin and continue with `/cacerts`, `/simpleenroll`, `/simplereenroll` or `/serverkeygen`, depending on the flow you will implement.",{"_2303":1127,"_22650":1091,"_15464":38842,"_5":15353,"_21389":38724,"_1893":38843},[],"Before configuring a DMS for EST, the following resources must exist on the platform:",{"_2303":1128,"_22650":1091,"_15464":38845,"_5":15353,"_21389":38724,"_1893":38846},[],"**An available CA**: the CA acting as `EnrollmentCA` must be created and active in Lamassu. If the authentication mode is `CLIENT_CERTIFICATE`, the validation CAs for the bootstrap certificate must also have been created.",{"_2303":1129,"_22650":1091,"_15464":38848,"_5":15353,"_21389":38724,"_1893":38849},[],"**A created DMS**: the DMS this configuration applies to must already exist. The EST configuration is applied over an existing DMS, it does not create one.",{"_2303":1130,"_22650":1091,"_15464":38851,"_5":15353,"_21389":38724,"_1893":38852},[],"It is worth separating four configuration blocks:",{"_2303":1131,"_22650":1091,"_15464":38854,"_5":15353,"_21389":38724,"_1893":38855},[],"How the initial enrollment will be performed, including the registration mode and client authentication.",{"_2303":1132,"_22650":1091,"_15464":38857,"_5":15353,"_21389":38724,"_1893":38858},[],"How the re-enrollment of already-issued certificates will be handled.",{"_2303":1133,"_22650":1091,"_15464":38860,"_5":15353,"_21389":38724,"_1893":38861},[],"How the cacerts endpoint will be configured to distribute the CAs devices use as trust anchors.",{"_2303":1134,"_22650":1091,"_15464":38863,"_5":15353,"_21389":38724,"_1893":38864},[],"Whether server-side key generation through `ServerKeyGen` will be enabled.",{"_2303":1135,"_22650":1091,"_15464":38866,"_5":15353,"_21389":38732,"_1893":38867},[],"This section defines how new devices are registered and with which credentials they authenticate.",{"_2303":1136,"_22650":1091,"_15464":38869,"_5":15353,"_21389":38732,"_1893":38870},[],"**Registration Mode**: determines the behavior when receiving an initial enrollment. In `JITP` (*Just-In-Time Provisioning*) mode, the device is created automatically the first time it presents itself, applying the tags, metadata and icon defined in the provisioning profile. In `PRE_REGISTRATION` mode, the device must already exist on the platform; if it does not, the request is rejected with `device not preregistered`. JITP mode suits large fleets where the inventory is built during deployment; `PRE_REGISTRATION` fits high-security environments where each device is explicitly approved before receiving a certificate.",{"_2303":1137,"_22650":1091,"_15464":38872,"_5":15353,"_21389":38732,"_1893":38873},[],"**Tags**: applied to each device automatically created by this DMS. They are optional and only take effect in JITP mode. Tags improve device search.",{"_2303":1138,"_22650":1091,"_15464":38875,"_5":15353,"_21389":38732,"_1893":38876},[],"**Icon**: applied to each device automatically created by this DMS. It is optional and only takes effect in JITP mode. Purely visual.",{"_2303":1139,"_22650":1091,"_15464":38878,"_5":15353,"_21389":38736,"_1893":38879},[],"**Enrollment CA**: identifies the CA that will sign the identity certificates issued through this DMS. Its choice determines the chain of trust the device will receive and the root against which backend systems will validate fleet certificates.",{"_2303":1140,"_22650":1091,"_15464":38881,"_5":15353,"_21389":38736,"_1893":38882},[],"**Allow Override Enrollment** (`enable_replaceable_enrollment`): allows an already-enrolled device to enroll again through `/simpleenroll`. When active, the previous certificate is revoked with the reason `superseded` and the identity slot is updated. When inactive, a second `simpleenroll` attempt is rejected with `forbiddenNewEnrollment`. This option must be enabled with care in production environments, since it lets you replace a device's identity without going through the re-enrollment flow.",{"_2303":1141,"_22650":1091,"_15464":38884,"_5":15353,"_21389":38736,"_1893":38885},[],"**Verify CSR Signature** (`verify_csr_signature`): controls whether the server validates the CSR signature against the public key declared in it (PKCS#10 proof of possession). When inactive, a requester could submit a CSR with a public key it does not control and obtain a certificate bound to it. For IoT fleets on open networks it must be enabled.",{"_2303":1142,"_22650":1091,"_15464":38887,"_5":15353,"_21389":38736,"_1893":38888},[],"**Authentication Mode**: defines how the DMS validates the device identity during enrollment. It can require an mTLS certificate (`CLIENT_CERTIFICATE`), delegate authorization to a webhook (`EXTERNAL_WEBHOOK`), combine both controls (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`) or accept unauthenticated requests (`NO_AUTH`). The latter must be limited to isolated labs or provisioning networks.",{"_2303":1143,"_22650":1091,"_15464":38890,"_5":15353,"_21389":38736,"_1893":38891},[],"When the mode is `CLIENT_CERTIFICATE` or `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`, these parameters are also configured:",{"_2303":1144,"_22650":1091,"_15464":38893,"_5":15353,"_21389":38736,"_1893":38894},[],"**Validation CAs**: list of trusted CAs to validate the bootstrap certificate presented by the device.",{"_2303":1145,"_22650":1091,"_15464":38896,"_5":15353,"_21389":38736,"_1893":38897},[],"**Chain Validation Level**: maximum depth of the validation chain. The value `-1` validates the full chain up to the root CA.",{"_2303":1146,"_22650":1091,"_15464":38899,"_5":15353,"_21389":38736,"_1893":38900},[],"**Allow Authenticating Expired Certificates**: if active, accepts expired client certificates. Useful in recovery scenarios where the device could not renew its certificate in time.",{"_2303":1147,"_22650":1091,"_15464":38902,"_5":15353,"_21389":38736,"_1893":38903},[],"When the mode includes `EXTERNAL_WEBHOOK`, these parameters are also configured:",{"_2303":1148,"_22650":1091,"_15464":38905,"_5":15353,"_21389":38736,"_1893":38906},[],"**Webhook URL**: address of the external service that will decide authorization.",{"_2303":1149,"_22650":1091,"_15464":38908,"_5":15353,"_21389":38736,"_1893":38909},[],"**HTTP Method**: HTTP method used to invoke the webhook. Supports `POST` (default) or `PUT`; both are equivalent for the webhook, only the verb Lamassu uses changes.",{"_2303":1150,"_22650":1091,"_15464":38911,"_5":15353,"_21389":38736,"_1893":38912},[],"**Timeout**: maximum wait time for the webhook call. If not specified, the default is **10 seconds**; after that without a response, Lamassu denies the operation.",{"_2303":1151,"_22650":1091,"_15464":38914,"_5":15353,"_21389":38736,"_1893":38915},[],"**Webhook Authentication Mode**: authentication mode of the webhook toward the external service, for example `ApiKey`, `OIDC` or `mTLS`.",{"_2303":1152,"_22650":1091,"_15464":38917,"_5":15353,"_21389":38736,"_1893":38918},[],"The exact contract the webhook service must implement (request and response schema, examples) is published as an OpenAPI specification: authorization webhook reference.",{"_2303":1153,"_22650":1091,"_15464":38920,"_5":15353,"_21389":38740,"_1893":38921},[],"The behavior of the issued certificate is not determined solely by the device's CSR, but by the **issuance profile** (`IssuanceProfile`) associated with the DMS. The integrator does not configure this profile, but its rules affect the content of the final certificate:",{"_2303":1154,"_22650":1091,"_15464":38923,"_5":15353,"_21389":38740,"_1893":38924},[],"**`HonorSubject`** controls whether the CSR's subject is copied verbatim into the certificate. If disabled, the CA applies the profile's template and ignores the received subject.",{"_2303":1155,"_22650":1091,"_15464":38926,"_5":15353,"_21389":38740,"_1893":38927},[],"**`HonorKeyUsage`** decides whether the CSR's `KeyUsage` is respected or replaced by the one defined in the template.",{"_2303":1156,"_22650":1091,"_15464":38929,"_5":15353,"_21389":38740,"_1893":38930},[],"**`HonorExtendedKeyUsages`** applies the same rule to `ExtKeyUsage`.",{"_2303":1157,"_22650":1091,"_15464":38932,"_5":15353,"_21389":38740,"_1893":38933},[],"**`HonorExtensions`** controls whether the rest of the CSR's extensions, such as SAN or CDP, are included in the certificate.",{"_2303":1158,"_22650":1091,"_15464":38935,"_5":15353,"_21389":38740,"_1893":38936},[],"This matters for the integrator: the `KeyUsage`, `ExtKeyUsage` and SANs declared in the CSR may not appear as-is in the final certificate if the profile decides otherwise. Check with the PKI administrator if the issued certificate does not contain the expected extensions.",{"_2303":1159,"_22650":1091,"_15464":38938,"_5":15353,"_21389":38744,"_1893":38939},[],"The **Re-Enrollment Settings** section controls the certificate renewal process. Re-enrollment can only be performed while the certificate is within the configured window, and optionally also when the certificate has already expired.",{"_2303":1160,"_22650":1091,"_15464":38941,"_5":15353,"_21389":38744,"_1893":38942},[],"**Revoke On Re-Enroll**: if active, the previous certificate is automatically revoked with the reason `superseded` once the new one is issued.",{"_2303":1161,"_22650":1091,"_15464":38944,"_5":15353,"_21389":38744,"_1893":38945},[],"**Allow Expired Renewal**: allows renewing an already-expired certificate. Useful when a device has been offline and could not renew within the window.",{"_2303":1162,"_22650":1091,"_15464":38947,"_5":15353,"_21389":38744,"_1893":38948},[],"**Allowed Renewal Delta**: time window before expiration during which re-enrollment is allowed. Before this window opens, the request is rejected with `invalid reenroll window`.",{"_2303":1163,"_22650":1091,"_15464":38950,"_5":15353,"_21389":38744,"_1893":38951},[],"**Preventive Renewal Delta**: time before expiration from which preventive renewal alerts are raised.",{"_2303":1164,"_22650":1091,"_15464":38953,"_5":15353,"_21389":38744,"_1893":38954},[],"**Critical Renewal Delta**: threshold closest to expiration that triggers critical status alerts.",{"_2303":1165,"_22650":1091,"_15464":38956,"_5":15353,"_21389":38744,"_1893":38957},[],"**Additional Validation CAs**: additional CAs accepted as issuers of the active certificate during re-enrollment. It allows migrating to a new enrollment CA without interrupting the renewal of devices already enrolled with the previous CA.",{"_2303":1166,"_22650":1091,"_15464":38959,"_5":15353,"_21389":38748,"_1893":38960},[],"The **Server Key Generation** section lets Lamassu generate the device's key pair on the server and return it together with the issued certificate. It is useful for devices with limited cryptographic capability.",{"_2303":1167,"_22650":1091,"_15464":38962,"_5":15353,"_21389":38748,"_1893":38963},[],"The **Enable Server-Side Key Generation** option activates the `/serverkeygen` endpoint. When inactive, any call to that endpoint is rejected with `server key generation not enabled`.",{"_2303":1168,"_22650":1091,"_15464":38965,"_5":15353,"_21389":38748,"_1893":38966},[],"**Key Type** selects the algorithm: `RSA` or `ECDSA`. The &#x2A;*Key Size (bits)** field determines the key size. For ECDSA, the size in bits also determines the curve: 256 corresponds to P-256, 384 to P-384 and 521 to P-521.",{"_2303":1169,"_22650":1091,"_15464":38968,"_5":15353,"_21389":38748,"_1893":38969},[],"The key is generated in the server's software engine, not in a hardware Crypto Engine such as AWS KMS or PKCS#11. The only protection of the key in transit is the TLS channel; no additional encryption (CMS EnvelopedData) is applied to the key before sending it to the device. See the `/serverkeygen` section of the integrator reference for the exact response format and security considerations.",{"_2303":1170,"_22650":1091,"_15464":38971,"_5":15353,"_21389":38752,"_1893":38972},[],"Once the enrollment, re-enrollment and ServerKeyGen settings are applied, you can confirm the DMS is operational as follows:",{"_2303":1171,"_22650":1091,"_15464":38974,"_5":15353,"_21389":38752,"_1893":38975},[],"**From the console**: open the DMS detail and check that the EST section shows the assigned enrollment CA and the configured authentication mode.",{"_2303":1172,"_22650":1091,"_15464":38977,"_5":15353,"_21389":38752,"_1893":38978},[],"**With a test request**: invoke the DMS's `/cacerts` endpoint from a `curl` client with server trust. A `200 OK` response with base64 content confirms the DMS is active and the enrollment CA is reachable.",{"_2303":1173,"_22650":1091,"_15464":38980,"_5":15353,"_21389":38752,"_1893":38981},[],"If the DMS does not exist or the CA is not available, the server responds with `DMS not found` or another error message. See the Diagnostics and compatibility section to interpret error messages.",{"_2303":1174,"_22650":1091,"_15464":38983,"_5":15353,"_21389":38756,"_1893":38984},[],"*This section is aimed at device integrators.*",{"_2303":1175,"_22650":1091,"_15464":38986,"_5":15353,"_21389":38756,"_1893":38987},[],"Lamassu's EST endpoints are published under the `/.well-known/est` prefix and always require the presence of the `{aps}` path segment, interpreted as the identifier of the DMS the operation targets. The association is direct: the `{aps}` value received in the URL is used as the DMS ID when querying the internal store. Variants registered without `{aps}` (for example `/.well-known/est/cacerts`) are routed in the code, but their handler requires the `APS` field and returns `400 Bad Request` with the message `Field validation for 'APS' failed` when the segment is not provided.",{"_2303":1176,"_22650":1091,"_15464":38989,"_5":15353,"_21389":38756,"_1893":38990},[],"This part follows the integrator's usual working order: first the prerequisites and the authentication model, then the reference for each endpoint and, finally, complete examples and diagnostic material.",{"_2303":1177,"_22650":1091,"_15464":38992,"_5":15353,"_21389":38760,"_1893":38993},[],"The PKI administrator must have configured a DMS with the `EST_RFC7030` protocol, an assigned enrollment CA and at least one authentication mode. Without that prior configuration, Lamassu rejects any enrollment request. The details of that configuration are in the DMS configuration section of this same page.",{"_2303":1178,"_22650":1091,"_15464":38995,"_5":15353,"_21389":38760,"_1893":38996},[],"Before making the first call, make sure you have:",{"_2303":1179,"_22650":1091,"_15464":38998,"_5":15353,"_21389":38760,"_1893":38999},[],"**The EST host URL**, for example `https://est.lamassu.example`, provided by the PKI administrator.",{"_2303":1180,"_22650":1091,"_15464":39001,"_5":15353,"_21389":38760,"_1893":39002},[],"**The server trust anchor** (`lamassu-trust.pem`), root or intermediate, with which the client will validate Lamassu's TLS.",{"_2303":1181,"_22650":1091,"_15464":39004,"_5":15353,"_21389":38760,"_1893":39005},[],"**The bootstrap certificate and its private key** if the DMS uses `CLIENT_CERTIFICATE` or `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`. This identity must come from one of the configured `ValidationCAs`, usually a provisioning CA different from the enrollment CA.",{"_2303":1182,"_22650":1091,"_15464":39007,"_5":15353,"_21389":38760,"_1893":39008},[],"**The DMS ID** (`{aps}`), which must appear in every EST route.",{"_2303":1183,"_22650":1091,"_15464":39010,"_5":15353,"_21389":38763,"_1893":39011},[],"**Download trust with `/cacerts`:** the client validates the server's TLS and receives the certificates in PKCS#7 or PEM.",{"_2303":1184,"_22650":1091,"_15464":39013,"_5":15353,"_21389":38763,"_1893":39014},[],"**Perform initial enrollment with `/simpleenroll`:** present the bootstrap certificate or the credential defined by `AuthMode` to obtain the device certificate.",{"_2303":1185,"_22650":1091,"_15464":39016,"_5":15353,"_21389":38763,"_1893":39017},[],"**Renew with `/simplereenroll`:** authenticate with the device's current certificate to obtain a new one.",{"_2303":1186,"_22650":1091,"_15464":39019,"_5":15353,"_21389":38763,"_1893":39020},[],"**Use `/serverkeygen` only if you need server-side key generation:** it applies the same authentication as `/simpleenroll` and returns the PKCS#8 private key together with the certificate.",{"_2303":1187,"_22650":1091,"_15464":39022,"_5":15353,"_21389":38767,"_1893":39023},[],"Lamassu's implementation recognizes four authentication configurations for `/simpleenroll`, expressed through the DMS's `EnrollmentOptionsESTRFC7030.AuthMode` field. Three are simple modes (`CLIENT_CERTIFICATE`, `EXTERNAL_WEBHOOK`, `NO_AUTH`) and one combines two controls (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`). The client must present itself in the mode the DMS expects; any other combination fails the enrollment.",{"_2303":1188,"_22650":1091,"_15464":39025,"_5":15353,"_21389":38767,"_1893":39026},[],"Mode (`AuthMode`)",{"_2303":1189,"_22650":1091,"_15464":39028,"_5":15353,"_21389":38767,"_1893":38421},[],{"_2303":1190,"_22650":1091,"_15464":39030,"_5":15353,"_21389":38767,"_1893":39031},[],"Expected credential",{"_2303":1191,"_22650":1091,"_15464":39033,"_5":15353,"_21389":38767,"_1893":39034},[],"Applies in enroll",{"_2303":1192,"_22650":1091,"_15464":39036,"_5":15353,"_21389":38767,"_1893":39037},[],"Applies in reenroll",{"_2303":1193,"_22650":1091,"_15464":39039,"_5":15353,"_21389":38767,"_1893":39040},[],"`CLIENT_CERTIFICATE`",{"_2303":1194,"_22650":1091,"_15464":39042,"_5":15353,"_21389":38767,"_1893":39043},[],"mTLS with X.509 certificate",{"_2303":1195,"_22650":1091,"_15464":39045,"_5":15353,"_21389":38767,"_1893":39046},[],"Client certificate and private key",{"_2303":1196,"_22650":1091,"_15464":39048,"_5":15353,"_21389":38767,"_1893":39049},[],"Yes",{"_2303":1197,"_22650":1091,"_15464":39051,"_5":15353,"_21389":38767,"_1893":39052},[],"Yes (with the active certificate)",{"_2303":1198,"_22650":1091,"_15464":39054,"_5":15353,"_21389":38767,"_1893":39055},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_2303":1199,"_22650":1091,"_15464":39057,"_5":15353,"_21389":38767,"_1893":39058},[],"mTLS plus webhook validation",{"_2303":1200,"_22650":1091,"_15464":39060,"_5":15353,"_21389":38767,"_1893":39061},[],"Client certificate and private key, plus webhook approval",{"_2303":1201,"_22650":1091,"_15464":39063,"_5":15353,"_21389":38767,"_1893":39049},[],{"_2303":1202,"_22650":1091,"_15464":39065,"_5":15353,"_21389":38767,"_1893":39066},[],"Not as a combination; in reenroll both controls are not kept",{"_2303":1203,"_22650":1091,"_15464":39068,"_5":15353,"_21389":38767,"_1893":39069},[],"`EXTERNAL_WEBHOOK`",{"_2303":1204,"_22650":1091,"_15464":39071,"_5":15353,"_21389":38767,"_1893":39072},[],"External authorization webhook",{"_2303":1205,"_22650":1091,"_15464":39074,"_5":15353,"_21389":38767,"_1893":39075},[],"None on the TLS channel",{"_2303":1206,"_22650":1091,"_15464":39077,"_5":15353,"_21389":38767,"_1893":39049},[],{"_2303":1207,"_22650":1091,"_15464":39079,"_5":15353,"_21389":38767,"_1893":39080},[],"No, degrades to `NO_AUTH`",{"_2303":1208,"_22650":1091,"_15464":39082,"_5":15353,"_21389":38767,"_1893":39083},[],"`NO_AUTH`",{"_2303":1209,"_22650":1091,"_15464":39085,"_5":15353,"_21389":38767,"_1893":39086},[],"No authentication",{"_2303":1210,"_22650":1091,"_15464":39088,"_5":15353,"_21389":38767,"_1893":39089},[],"None",{"_2303":1211,"_22650":1091,"_15464":39091,"_5":15353,"_21389":38767,"_1893":39092},[],"Yes (restricted use)",{"_2303":1212,"_22650":1091,"_15464":39094,"_5":15353,"_21389":38767,"_1893":39092},[],{"_2303":1213,"_22650":1091,"_15464":39096,"_5":15353,"_21389":38767,"_1893":39097},[],"JWT **is not a valid authentication mode in EST**. The JWT identity extractor exists in the code but is only evaluated in Lamassu's administration API. Any *Bearer token* sent to `/.well-known/est/...` is silently ignored. When the DMS is configured with `AuthMode: CLIENT_CERTIFICATE`, a request carrying only a JWT is rejected for lack of a client certificate. When the DMS is in `AuthMode: NO_AUTH`, the request is processed as such and the JWT neither adds nor removes authorization.",{"_2303":1214,"_22650":1091,"_15464":39099,"_5":15353,"_21389":38767,"_1893":39100},[],"**`CLIENT_CERTIFICATE`**: the client presents an X.509 certificate issued by one of the CAs declared in `AuthOptionsMTLS.ValidationCAs`. The process validates the certificate chain against those CAs through the `ValidationCAs`, `AllowExpired` and `ChainLevelValidation` parameters. In addition, the service checks the revocation status in three steps: first it looks up the cert in Lamassu's local database; if not found, it queries the OCSP responders listed in the AIA extension; if OCSP fails, it tries the CRL Distribution Points (CDP). A revoked certificate interrupts the enrollment with `certificate is revoked`.",{"_2303":1215,"_22650":1091,"_15464":39102,"_5":15353,"_21389":38767,"_1893":39103},[],"Its main parameters are `ValidationCAs`, the list of CAs that can validate the bootstrap certificate or the active certificate; `AllowExpired`, which allows accepting expired client certificates; and `ChainLevelValidation`, which limits the chain depth when its value is greater than zero.",{"_2303":1216,"_22650":1091,"_15464":39105,"_5":15353,"_21389":38767,"_1893":39106},[],"**`EXTERNAL_WEBHOOK`**: Lamassu delegates the authorization decision to an external HTTP service. The EST server builds a `POST` request to the configured webhook with a JSON body reproducing the enrollment context.",{"_2303":1217,"_22650":1091,"_15464":39108,"_5":15353,"_21389":38767,"_1893":39109},[],"The value of the `csr` field is the **base64 encoding of the CSR's PEM** (not the DER, and not the plain PEM). The webhook must respond with `2xx` and a JSON body `{\"authorized\": true}` to continue; any other response aborts the enrollment with `external webhook denied enrollment`. A `204 No Content` **is not a valid response** even though it is a `2xx` code: Lamassu requires a JSON body with the `authorized` field, so a webhook responding without a body denies the operation just like an error.",{"_2303":1218,"_22650":1091,"_15464":39111,"_5":15353,"_21389":38767,"_1893":39112},[],"**`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`**: combines the two previous modes during `/simpleenroll`. The client must present a valid mTLS certificate and the webhook must return `authorized: true`. In `/simplereenroll` the combination is not preserved: the joint mTLS + webhook check is not maintained, so the integrator must not assume the same guarantees of the initial enrollment apply in reenroll.",{"_2303":1219,"_22650":1091,"_15464":39114,"_5":15353,"_21389":38767,"_1893":39115},[],"**`NO_AUTH`**: the DMS accepts any CSR without validating the client's identity. Lamassu logs a warning (`DMS is configured with NoAuth, allowing enrollment`) and proceeds with the registration. It must be restricted to controlled environments (an isolated provisioning network); any network exposed to the internet with a DMS in `NO_AUTH` is open to certificate issuance by unauthorized third parties.",{"_2303":1220,"_22650":1091,"_15464":39117,"_5":15353,"_21389":38771,"_1893":39118},[],"The following sections describe the endpoints in the usual order of use within the device lifecycle:",{"_2303":1221,"_22650":1091,"_15464":39120,"_5":15353,"_21389":38771,"_1893":39121},[],"`/cacerts`: download of the trust chain.",{"_2303":1222,"_22650":1091,"_15464":39123,"_5":15353,"_21389":38771,"_1893":39124},[],"`/simpleenroll`: initial certificate enrollment.",{"_2303":1223,"_22650":1091,"_15464":39126,"_5":15353,"_21389":38771,"_1893":39127},[],"`/simplereenroll`: renewal of an already-issued certificate.",{"_2303":1224,"_22650":1091,"_15464":39129,"_5":15353,"_21389":38771,"_1893":39130},[],"`/serverkeygen`: enrollment with server-side key generation.",{"_2303":1225,"_22650":1091,"_15464":39132,"_5":15353,"_21389":38775,"_1893":39133},[],"The endpoint `GET /.well-known/est/{aps}/cacerts` distributes the certificates the device needs to validate the EST server and the rest of the CAs managed by the DMS. Lamassu inserts the certificates in this order: first the **downstream** certificate of the Lamassu server, which is the server's TLS leaf and not a CA, useful for pinning if `IncludeLamassuSystemCA` is enabled; then the `ManagedCAs` list declared in the DMS; and last the enrollment CA, if `IncludeEnrollmentCA` is enabled.",{"_2303":1226,"_22650":1091,"_15464":39135,"_5":15353,"_21389":38775,"_1893":39136},[],"`CADistributionSettings` lets you decide what is published:",{"_2303":1227,"_22650":1091,"_15464":39138,"_5":15353,"_21389":38775,"_1893":39139},[],"**`IncludeLamassuSystemCA`** adds the *downstream* certificate of the Lamassu server. It is the TLS leaf the client can use to pin the connection, not a CA.",{"_2303":1228,"_22650":1091,"_15464":39141,"_5":15353,"_21389":38775,"_1893":39142},[],"**`IncludeEnrollmentCA`** adds the DMS's issuing CA, responsible for signing device certificates.",{"_2303":1229,"_22650":1091,"_15464":39144,"_5":15353,"_21389":38775,"_1893":39145},[],"**`ManagedCAs`** publishes additional CAs as trust anchors.",{"_2303":1230,"_22650":1091,"_15464":39147,"_5":15353,"_21389":38775,"_1893":39148},[],"The default format is *degenerate* PKCS#7 (certificates only) base64-encoded. The response declares `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The base64 is wrapped in lines of **76 characters** terminated with CRLF, a width compliant with S/MIME (RFC 5751), not the 64 that some RFC 7030 guides suggest. This wrapping applies only to `/cacerts` and `/simpleenroll`; the internal parts of `/serverkeygen` carry no wrap, as explained below.",{"_2303":1231,"_22650":1091,"_15464":39150,"_5":15353,"_21389":38775,"_1893":39151},[],"*Degenerate* PKCS#7 is a **set** of certificates with no defined semantic order. Although Lamassu inserts them in the order stated, the integrator must not assume that order when validating chains: the chain must be built by `Subject`/`Issuer` matching (or by AKI/SKI), not by position in the response.",{"_2303":1232,"_22650":1091,"_15464":39153,"_5":15353,"_21389":38775,"_1893":39154},[],"The `-i` flag (ignore garbage) helps tolerate the CRLF Lamassu adds and is necessary on some `base64` implementations (BusyBox, BSD); on GNU coreutils it is ignored.",{"_2303":1233,"_22650":1091,"_15464":39156,"_5":15353,"_21389":38775,"_1893":39157},[],"Lamassu additionally adds an extension over the RFC: if the client sends the `Accept: application/x-pem-file` header, the server responds with the PEM concatenation of the same certificates, without the PKCS#7 wrapper. This makes consumption from scripts easier. The extension also works on `/simpleenroll` and `/simplereenroll`.",{"_2303":1234,"_22650":1091,"_15464":39159,"_5":15353,"_21389":38779,"_1893":39160},[],"The endpoint `POST /.well-known/est/{aps}/simpleenroll` receives a CSR and returns the issued certificate. The request body must be the **PKCS#10 (CSR) in DER, base64-encoded** without line breaks. The base64 wraps the DER directly, not a PEM. The `Content-Type` header must be `application/pkcs10`. If the `Content-Type` is different, the server responds `400` with `content-type must be application/pkcs10`; if the body is not valid base64, it responds `400` with `body payload must be base64 encoded`.",{"_2303":1235,"_22650":1091,"_15464":39162,"_5":15353,"_21389":38779,"_1893":39163},[],"The response follows the same wrapper as `/cacerts`: *degenerate* PKCS#7 in base64, with `Content-Type: application/pkcs7-mime; smime-type=certs-only`. The PKCS#7 contains **only the newly issued leaf certificate**; it does not include the issuing CA or intermediates. This complies with RFC 7030 §4.2.3 (where the chain is optional) but implies the integrator must combine this certificate with the chain obtained from `/cacerts` before presenting it to any relying party that validates the full chain (for example, an MQTT broker with strict mTLS).",{"_2303":1236,"_22650":1091,"_15464":39165,"_5":15353,"_21389":38779,"_1893":39166},[],"Several DMS fields govern the behavior of `/simpleenroll`. The integrator does not configure them, but it helps to know them to interpret rejections:",{"_2303":1237,"_22650":1091,"_15464":39168,"_5":15353,"_21389":38779,"_1893":39169},[],"**`EnrollmentSettings.RegistrationMode`** decides whether the device is created during the first enrollment (`JITP`) or must exist beforehand (`PRE_REGISTRATION`).",{"_2303":1238,"_22650":1091,"_15464":39171,"_5":15353,"_21389":38779,"_1893":39172},[],"**`EnrollmentSettings.EnableReplaceableEnrollment`** allows repeating `/simpleenroll` for an already-enrolled device. When doing so, it revokes the previous certificate as `superseded`; if disabled, the server responds with `forbiddenNewEnrollment`.",{"_2303":1239,"_22650":1091,"_15464":39174,"_5":15353,"_21389":38779,"_1893":39175},[],"**`EnrollmentSettings.VerifyCSRSignature`** validates that whoever submits the CSR controls the declared private key. For IoT fleets on open networks it must be enabled.",{"_2303":1240,"_22650":1091,"_15464":39177,"_5":15353,"_21389":38779,"_1893":39178},[],"In `JITP` mode, the first `simpleenroll` with a `CommonName` that does not yet exist in Lamassu creates the device automatically. In `PRE_REGISTRATION` mode, the device must exist beforehand; an unknown `CommonName` is rejected with `device not preregistered`. See Enrollment configuration for more details on both modes and the behavior of the issuance profile.",{"_2303":1241,"_22650":1091,"_15464":39180,"_5":15353,"_21389":38783,"_1893":39181},[],"The endpoint `POST /.well-known/est/{aps}/simplereenroll` renews the certificate of an already-enrolled device. The body format is identical to `/simpleenroll` (DER base64 without line breaks, `Content-Type: application/pkcs10`). The difference lies in authentication: the client must present **the device's active certificate** (not the bootstrap) as the mTLS credential.",{"_2303":1242,"_22650":1091,"_15464":39183,"_5":15353,"_21389":38783,"_1893":39184},[],"If the DMS is configured with `AuthMode: EXTERNAL_WEBHOOK`, the webhook is **not invoked** during `/simplereenroll`. The renewal flow silently degrades to `NO_AUTH`: any client that knows a valid `CommonName` can request reenroll for that device without authentication (`allowing reenroll: using NO AUTH mode` in the log). A DMS with `EXTERNAL_WEBHOOK` must not be used in production for reenroll flows unless access to the endpoint is network-controlled.",{"_2303":1243,"_22650":1091,"_15464":39186,"_5":15353,"_21389":38783,"_1893":39187},[],"The behavior of reenroll is governed by several `ReEnrollmentSettings` fields:",{"_2303":1244,"_22650":1091,"_15464":39189,"_5":15353,"_21389":38783,"_1893":39190},[],"**`ReEnrollmentDelta`** opens the renewal window at `NotAfter - ReEnrollmentDelta`. Before that instant, the server responds with `invalid reenroll window`.",{"_2303":1245,"_22650":1091,"_15464":39192,"_5":15353,"_21389":38783,"_1893":39193},[],"**`EnableExpiredRenewal`** allows using an already-expired certificate as proof of identity; if disabled, the server responds with `expired certificate`.",{"_2303":1246,"_22650":1091,"_15464":39195,"_5":15353,"_21389":38783,"_1893":39196},[],"**`RevokeOnReEnrollment`** revokes the previous certificate as `superseded` after issuing the new one.",{"_2303":1247,"_22650":1091,"_15464":39198,"_5":15353,"_21389":38783,"_1893":39199},[],"**`AdditionalValidationCAs`** adds valid issuers for the current certificate, in addition to the DMS's enrollment CA.",{"_2303":1248,"_22650":1091,"_15464":39201,"_5":15353,"_21389":38783,"_1893":39202},[],"**Subject immutability**: the renewal CSR must have exactly the same subject as the active certificate. Lamassu compares, byte by byte, the `RawSubject` of the CSR with the certificate's (`slices.Compare`). If the bytes differ, the server falls back to a semantic comparison over the `CommonName`, `OrganizationalUnit`, `Organization`, `Locality`, `Province` and `Country` attributes. If all those attributes match, the reenroll continues despite the byte difference (rescuing cases where only the encoding changes, `PrintableString` versus `UTF8String`). If any attribute differs, the reenroll aborts with `invalid RawSubject bytes`. The integrator must regenerate the CSR with exactly the same subject as in the initial enrollment to avoid depending on fallback behavior.",{"_2303":1249,"_22650":1091,"_15464":39204,"_5":15353,"_21389":38783,"_1893":39205},[],"**Validation of the presented certificate's chain**: validation is first attempted against the DMS's enrollment CA; if it fails, it walks the `AdditionalValidationCAs`. Validation is \"shallow\": each CA is tested as an anchor, no multi-level chain is composed. The client must present the complete chain in the mTLS handshake. A revoked certificate aborts the reenroll with `certificate is revoked`.",{"_2303":1250,"_22650":1091,"_15464":39207,"_5":15353,"_21389":38787,"_1893":39208},[],"The endpoint `POST /.well-known/est/{aps}/serverkeygen` lets Lamassu generate the device's key pair on the server and return, in the same response, the private key and the issued certificate. It is useful for devices with limited cryptographic capability or flows where the key is provisioned during manufacturing.",{"_2303":1251,"_22650":1091,"_15464":39210,"_5":15353,"_21389":38787,"_1893":39211},[],"This endpoint requires `ServerKeyGen.Enabled` to be `true` in the DMS. If it is not enabled, the server responds with `server key generation not enabled`. Authentication applies the same way as in `/simpleenroll`: the integrator presents the credential matching the DMS's `AuthMode`.",{"_2303":1252,"_22650":1091,"_15464":39213,"_5":15353,"_21389":38787,"_1893":39214},[],"The algorithm and size of the generated key are decided by the DMS, not by the client.",{"_2303":1253,"_22650":1091,"_15464":39216,"_5":15353,"_21389":38787,"_1893":39217},[],"**RSA** supports any size accepted by `crypto/rsa`; common values are 2048, 3072 and 4096 bits. An invalid value fails generation with a `500` error.",{"_2303":1254,"_22650":1091,"_15464":39219,"_5":15353,"_21389":38787,"_1893":39220},[],"**ECDSA** supports 224, 256, 384 and 521 bits, equivalent to P-224, P-256 (`prime256v1`), P-384 and P-521. Any other value **silently** degrades to P-256 and only leaves a warning in the log: the client receives no error and may obtain a curve different from the expected one.",{"_2303":1255,"_22650":1091,"_15464":39222,"_5":15353,"_21389":38787,"_1893":39223},[],"The CSR sent by the client serves only to carry the subject and extensions; the PKCS#10 proof of possession does not apply here because the client is not the one who generated the key. Lamassu discards the original CSR's public key, generates a new key pair with its internal entropy, in a software engine and not in a hardware Crypto Engine such as AWS KMS or PKCS#11, builds a new CSR with that key and proceeds with an internal enrollment equivalent to `/simpleenroll`.",{"_2303":1256,"_22650":1091,"_15464":39225,"_5":15353,"_21389":38787,"_1893":39226},[],"The response is a `multipart/mixed` with the literal boundary `estServerLamassuBoundary`. It contains two parts:",{"_2303":1257,"_22650":1091,"_15464":39228,"_5":15353,"_21389":38787,"_1893":39229},[],"The private key in **unencrypted PKCS#8** format, base64-encoded inside a part with `Content-Type: application/pkcs8`.",{"_2303":1258,"_22650":1091,"_15464":39231,"_5":15353,"_21389":38787,"_1893":39232},[],"The issued certificate in *degenerate* PKCS#7 base64, inside a part with `Content-Type: application/pkcs7-mime; smime-type=certs-only`.",{"_2303":1259,"_22650":1091,"_15464":39234,"_5":15353,"_21389":38787,"_1893":39235},[],"Unlike `/cacerts` and `/simpleenroll`, where the base64 is wrapped in 76-character lines, each part of `/serverkeygen` travels as **a single base64 line without breaks**. Any reverse proxy that rewrites the body (for example, normalizing line endings) can break the parsing.",{"_2303":1260,"_22650":1091,"_15464":39237,"_5":15353,"_21389":38787,"_1893":39238},[],"This endpoint reverses the PKI principle whereby the subscriber controls its own private key. The key is serialized as unencrypted PKCS#8 (`PrivateKeyInfo`, without `EncryptedPrivateKeyInfo`). The CMS `EnvelopedData` wrapper contemplated in RFC 7030 §4.4.2 is not applied; no AES key wrap or password-based symmetric encryption is used. The only protection is the channel's TLS. The integrator must guarantee that: (a) no reverse proxy terminates TLS and logs the response body; (b) the key is encrypted at rest immediately after receipt; (c) the audit account on the Lamassu server remains the single point of origin of the key.",{"_2303":1261,"_22650":1091,"_15464":39240,"_5":15353,"_21389":38787,"_1893":39241},[],"To separate the two parts, the following snippet uses `awk` with the literal boundary. It works with Lamassu's exact structure (each part = headers + blank line + a single base64 line); any intermediate proxy rewriting the body will break it.",{"_2303":1262,"_22650":1091,"_15464":39243,"_5":15353,"_21389":38791,"_1893":39244},[],"Once the endpoints have been reviewed individually, these examples show how to chain them in two common scenarios: the initial enrollment of a device and the renewal of an already-issued certificate.",{"_2303":1263,"_22650":1091,"_15464":39246,"_5":15353,"_21389":38795,"_1893":39247},[],"The following script illustrates the complete process of enrolling a device with a locally generated EC P-256 key and mTLS authentication against a bootstrap certificate.",{"_2303":1264,"_22650":1091,"_15464":39249,"_5":15353,"_21389":38799,"_1893":39250},[],"The following script reproduces a renewal process: it detects the expiration of the current certificate, regenerates the CSR with the **same subject** and authenticates with the active certificate.",{"_2303":1265,"_22650":1091,"_15464":39252,"_5":15353,"_21389":38803,"_1893":39253},[],"Once the device has obtained its identity certificate, the usual steps are:",{"_2303":1266,"_22650":1091,"_15464":39255,"_5":15353,"_21389":38803,"_1893":39256},[],"**Install the trust chain** (`cacerts.pem`) into the device's trust store. The MQTT broker, the HTTPS server or any relying party validating mTLS will need this chain.",{"_2303":1267,"_22650":1091,"_15464":39258,"_5":15353,"_21389":38803,"_1893":39259},[],"**Combine the leaf certificate with the chain** before presenting it in mTLS connections. The `/simpleenroll` response contains only the leaf certificate; the relying party may reject the connection if it does not receive the full chain.",{"_2303":1268,"_22650":1091,"_15464":39261,"_5":15353,"_21389":38803,"_1893":39262},[],"**Plan renewal**: configure a timer on the device that invokes `/simplereenroll` within the `ReEnrollmentDelta` window before the certificate expires. Do not wait for expiry unless `EnableExpiredRenewal` is enabled.",{"_2303":1269,"_22650":1091,"_15464":39264,"_5":15353,"_21389":38811,"_1893":39265},[],"Lamassu maps almost every business error to `500 Internal Server Error`, not to `4xx`. The HTTP status code is not enough to distinguish a network error from a policy error. The integrator must inspect the `err` field of the JSON body (`{\"err\": \"<message>\"}`) to determine the exact cause of the failure.",{"_2303":1270,"_22650":1091,"_15464":39267,"_5":15353,"_21389":38811,"_1893":39268},[],"HTTP",{"_2303":1271,"_22650":1091,"_15464":39270,"_5":15353,"_21389":38811,"_1893":39271},[],"Message",{"_2303":1272,"_22650":1091,"_15464":39273,"_5":15353,"_21389":38811,"_1893":39274},[],"Cause",{"_2303":1273,"_22650":1091,"_15464":39276,"_5":15353,"_21389":38811,"_1893":39277},[],"Integrator action",{"_2303":1274,"_22650":1091,"_15464":39279,"_5":15353,"_21389":38811,"_1893":21986},[],{"_2303":1275,"_22650":1091,"_15464":39281,"_5":15353,"_21389":38811,"_1893":39282},[],"`Field validation for 'APS' failed`",{"_2303":1276,"_22650":1091,"_15464":39284,"_5":15353,"_21389":38811,"_1893":39285},[],"The `{aps}` segment is missing from the URL.",{"_2303":1277,"_22650":1091,"_15464":39287,"_5":15353,"_21389":38811,"_1893":39288},[],"Include the DMS ID in the path.",{"_2303":1278,"_22650":1091,"_15464":39290,"_5":15353,"_21389":38811,"_1893":21986},[],{"_2303":1279,"_22650":1091,"_15464":39292,"_5":15353,"_21389":38811,"_1893":39293},[],"`content-type must be application/pkcs10`",{"_2303":1280,"_22650":1091,"_15464":39295,"_5":15353,"_21389":38811,"_1893":39296},[],"`Content-Type` header missing or incorrect.",{"_2303":1281,"_22650":1091,"_15464":39298,"_5":15353,"_21389":38811,"_1893":39299},[],"Set `Content-Type: application/pkcs10`.",{"_2303":1282,"_22650":1091,"_15464":39301,"_5":15353,"_21389":38811,"_1893":21986},[],{"_2303":1283,"_22650":1091,"_15464":39303,"_5":15353,"_21389":38811,"_1893":39304},[],"`body payload must be base64 encoded`",{"_2303":1284,"_22650":1091,"_15464":39306,"_5":15353,"_21389":38811,"_1893":39307},[],"The body is not valid base64.",{"_2303":1285,"_22650":1091,"_15464":39309,"_5":15353,"_21389":38811,"_1893":39310},[],"Use `base64 -w 0` to avoid line breaks.",{"_2303":1286,"_22650":1091,"_15464":39312,"_5":15353,"_21389":38811,"_1893":21899},[],{"_2303":1287,"_22650":1091,"_15464":39314,"_5":15353,"_21389":38811,"_1893":39315},[],"`DMS not found`",{"_2303":1288,"_22650":1091,"_15464":39317,"_5":15353,"_21389":38811,"_1893":39318},[],"The `{aps}` value does not match any DMS.",{"_2303":1289,"_22650":1091,"_15464":39320,"_5":15353,"_21389":38811,"_1893":39321},[],"Verify the identifier with the PKI administrator.",{"_2303":1290,"_22650":1091,"_15464":39323,"_5":15353,"_21389":38811,"_1893":21899},[],{"_2303":1291,"_22650":1091,"_15464":39325,"_5":15353,"_21389":38811,"_1893":39326},[],"`invalid certificate`",{"_2303":1292,"_22650":1091,"_15464":39328,"_5":15353,"_21389":38811,"_1893":39329},[],"The client certificate is not valid against `ValidationCAs`.",{"_2303":1293,"_22650":1091,"_15464":39331,"_5":15353,"_21389":38811,"_1893":39332},[],"Check the bootstrap certificate chain.",{"_2303":1294,"_22650":1091,"_15464":39334,"_5":15353,"_21389":38811,"_1893":21899},[],{"_2303":1295,"_22650":1091,"_15464":39336,"_5":15353,"_21389":38811,"_1893":39337},[],"`certificate is revoked`",{"_2303":1296,"_22650":1091,"_15464":39339,"_5":15353,"_21389":38811,"_1893":39340},[],"The certificate **presented as the mTLS credential** is revoked in Lamassu or via external OCSP/CRL.",{"_2303":1297,"_22650":1091,"_15464":39342,"_5":15353,"_21389":38811,"_1893":39343},[],"Request a new bootstrap certificate or investigate the revocation.",{"_2303":1298,"_22650":1091,"_15464":39345,"_5":15353,"_21389":38811,"_1893":21899},[],{"_2303":1299,"_22650":1091,"_15464":39347,"_5":15353,"_21389":38811,"_1893":39348},[],"`revoked certificate`",{"_2303":1300,"_22650":1091,"_15464":39350,"_5":15353,"_21389":38811,"_1893":39351},[],"In reenroll, the device's **active certificate in the database** is listed as revoked.",{"_2303":1301,"_22650":1091,"_15464":39353,"_5":15353,"_21389":38811,"_1893":39354},[],"Review the identity slot status; if the revocation was intentional, issue a new enroll instead of reenroll.",{"_2303":1302,"_22650":1091,"_15464":39356,"_5":15353,"_21389":38811,"_1893":21899},[],{"_2303":1303,"_22650":1091,"_15464":39358,"_5":15353,"_21389":38811,"_1893":39359},[],"`expired certificate`",{"_2303":1304,"_22650":1091,"_15464":39361,"_5":15353,"_21389":38811,"_1893":39362},[],"The presented certificate has expired and the DMS does not allow `AllowExpired`/`EnableExpiredRenewal`.",{"_2303":1305,"_22650":1091,"_15464":39364,"_5":15353,"_21389":38811,"_1893":39365},[],"Renew before expiration or request `EnableExpiredRenewal` to be enabled.",{"_2303":1306,"_22650":1091,"_15464":39367,"_5":15353,"_21389":38811,"_1893":21899},[],{"_2303":1307,"_22650":1091,"_15464":39369,"_5":15353,"_21389":38811,"_1893":39370},[],"`forbiddenNewEnrollment`",{"_2303":1308,"_22650":1091,"_15464":39372,"_5":15353,"_21389":38811,"_1893":39373},[],"The device is already enrolled and `EnableReplaceableEnrollment` is `false`.",{"_2303":1309,"_22650":1091,"_15464":39375,"_5":15353,"_21389":38811,"_1893":39376},[],"Use `/simplereenroll` or ask the administrator to enable the flag.",{"_2303":1310,"_22650":1091,"_15464":39378,"_5":15353,"_21389":38811,"_1893":21899},[],{"_2303":1311,"_22650":1091,"_15464":39380,"_5":15353,"_21389":38811,"_1893":39381},[],"`device not preregistered`",{"_2303":1312,"_22650":1091,"_15464":39383,"_5":15353,"_21389":38811,"_1893":39384},[],"The DMS is in `PRE_REGISTRATION` and the device does not exist.",{"_2303":1313,"_22650":1091,"_15464":39386,"_5":15353,"_21389":38811,"_1893":39387},[],"Register the device before enrolling it.",{"_2303":1314,"_22650":1091,"_15464":39389,"_5":15353,"_21389":38811,"_1893":21899},[],{"_2303":1315,"_22650":1091,"_15464":39391,"_5":15353,"_21389":38811,"_1893":39392},[],"`invalid reenroll window`",{"_2303":1316,"_22650":1091,"_15464":39394,"_5":15353,"_21389":38811,"_1893":39395},[],"Renewal attempted before `NotAfter - ReEnrollmentDelta`.",{"_2303":1317,"_22650":1091,"_15464":39397,"_5":15353,"_21389":38811,"_1893":39398},[],"Wait for the window to open or request a larger `ReEnrollmentDelta`.",{"_2303":1318,"_22650":1091,"_15464":39400,"_5":15353,"_21389":38811,"_1893":21899},[],{"_2303":1319,"_22650":1091,"_15464":39402,"_5":15353,"_21389":38811,"_1893":39403},[],"`invalid RawSubject bytes`",{"_2303":1320,"_22650":1091,"_15464":39405,"_5":15353,"_21389":38811,"_1893":39406},[],"The renewal CSR's subject does not match the active certificate's.",{"_2303":1321,"_22650":1091,"_15464":39408,"_5":15353,"_21389":38811,"_1893":39409},[],"Regenerate the CSR with the exact subject of the previous cert.",{"_2303":1322,"_22650":1091,"_15464":39411,"_5":15353,"_21389":38811,"_1893":21899},[],{"_2303":1323,"_22650":1091,"_15464":39413,"_5":15353,"_21389":38811,"_1893":39414},[],"`external webhook denied enrollment`",{"_2303":1324,"_22650":1091,"_15464":39416,"_5":15353,"_21389":38811,"_1893":39417},[],"The webhook returned a non-`2xx` code or `authorized != true`.",{"_2303":1325,"_22650":1091,"_15464":39419,"_5":15353,"_21389":38811,"_1893":39420},[],"Review the webhook service logs.",{"_2303":1326,"_22650":1091,"_15464":39422,"_5":15353,"_21389":38811,"_1893":21899},[],{"_2303":1327,"_22650":1091,"_15464":39424,"_5":15353,"_21389":38811,"_1893":39425},[],"`server key generation not enabled`",{"_2303":1328,"_22650":1091,"_15464":39427,"_5":15353,"_21389":38811,"_1893":39428},[],"`/serverkeygen` is disabled on the DMS.",{"_2303":1329,"_22650":1091,"_15464":39430,"_5":15353,"_21389":38811,"_1893":39431},[],"Ask the administrator to enable `ServerKeyGen.Enabled`.",{"_2303":1330,"_22650":1091,"_15464":39433,"_5":15353,"_21389":38811,"_1893":39434},[],"For messages not listed in this table, the Lamassu server logs (with the fields `func`, `dms`, `device-cn`, `step`, `auth-method`, `auth-status`) are the first place to look for the cause.",{"_2303":1331,"_22650":1091,"_15464":39436,"_5":15353,"_21389":38815,"_1893":39437},[],"Lamassu's implementation follows RFC 7030 in its essentials but introduces several quirks that can affect strict EST clients or third-party libraries:",{"_2303":1332,"_22650":1091,"_15464":39439,"_5":15353,"_21389":38815,"_1893":39440},[],"The `/csrattrs` and `/fullcmc` endpoints of RFC 7030 are **not implemented** in Lamassu. A client invoking `/.well-known/est/<DMS_ID>/csrattrs` receives `404 Not Found` instead of the `204 No Content` the RFC suggests for \"no attributes\". Strict EST libraries must be configured not to attempt `csrattrs`.",{"_2303":1333,"_22650":1091,"_15464":39442,"_5":15353,"_21389":38815,"_1893":39443},[],"The base64 of the `/cacerts` and `/simpleenroll` responses is wrapped in lines of **76 characters** terminated with CRLF (S/MIME compliant, RFC 5751). The parts of `/serverkeygen` apply no wrap.",{"_2303":1334,"_22650":1091,"_15464":39445,"_5":15353,"_21389":38815,"_1893":39446},[],"The `multipart/mixed` boundary in `/serverkeygen` is fixed and cannot be negotiated.",{"_2303":1335,"_22650":1091,"_15464":39448,"_5":15353,"_21389":38815,"_1893":39449},[],"The `{aps}` segment is **mandatory** in all EST routes. Routes registered without `{aps}` are in the code but respond `400`.",{"_2303":1336,"_22650":1091,"_15464":39451,"_5":15353,"_21389":38815,"_1893":39452},[],"The body of `/cacerts`, `/simpleenroll` and `/simplereenroll` can be returned as concatenated PEM if the client sends `Accept: application/x-pem-file`. This is a Lamassu-specific extension and does not appear in the RFC.",{"_2303":1337,"_22650":1091,"_15464":39454,"_5":15353,"_21389":38815,"_1893":39455},[],"The server does not explicitly reject CSRs signed with SHA-1 or MD5; the integrator must generate the CSR with SHA-256 or higher.",{"_2303":1338,"_22650":1091,"_15464":39457,"_5":15353,"_21389":38815,"_1893":39458},[],"<Card title=\"DMS overview\" href=\"/docs/platform/pki/device-enrollment\" />",{"_2303":1339,"_22650":1091,"_15464":39460,"_5":15353,"_21389":38815,"_1893":39461},[],"<Card title=\"OCSP validation\" href=\"/docs/platform/pki/ocsp\" />",{"_2303":1340,"_22650":1091,"_15464":39463,"_5":15353,"_21389":38815,"_1893":39464},[],"<Card title=\"Manage devices\" href=\"/docs/platform/pki/device-management\" />",{"_2303":1341,"_22650":1341,"_5":10649,"_1893":39466,"_22909":39467,"_15464":39469,"_21389":1341},"AWS IoT Core",[35256,36391,39468],"Integrations",[],{"_2303":1342,"_22650":1341,"_15464":39471,"_5":15353,"_21389":1341,"_1893":39472},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_2303":1343,"_22650":1341,"_5":22906,"_15464":39474,"_21389":39475,"_1893":39476},[],"/docs/platform/pki/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_2303":1344,"_22650":1341,"_5":22906,"_15464":39478,"_21389":39479,"_1893":38725},[],"/docs/platform/pki/integrations/aws-iot-core#prerequisites",{"_2303":1345,"_22650":1341,"_5":22906,"_15464":39481,"_21389":39482,"_1893":39483},[],"/docs/platform/pki/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_2303":1346,"_22650":1341,"_5":22906,"_15464":39485,"_21389":39486,"_1893":39487},[],"/docs/platform/pki/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_2303":1347,"_22650":1341,"_5":22906,"_15464":39489,"_21389":39490,"_1893":39491},[],"/docs/platform/pki/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_2303":1348,"_22650":1341,"_5":22906,"_15464":39493,"_21389":39494,"_1893":39495},[],"/docs/platform/pki/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_2303":1349,"_22650":1341,"_5":22906,"_15464":39497,"_21389":39498,"_1893":39499},[],"/docs/platform/pki/integrations/aws-iot-core#primary-account","Primary Account",{"_2303":1350,"_22650":1341,"_5":22906,"_15464":39501,"_21389":39502,"_1893":39503},[],"/docs/platform/pki/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_2303":1351,"_22650":1341,"_5":22906,"_15464":39505,"_21389":39506,"_1893":38721},[],"/docs/platform/pki/integrations/aws-iot-core#dms-configuration",{"_2303":1352,"_22650":1341,"_5":22906,"_15464":39508,"_21389":39509,"_1893":39510},[],"/docs/platform/pki/integrations/aws-iot-core#none-mode","`none` mode",{"_2303":1353,"_22650":1341,"_5":22906,"_15464":39512,"_21389":39513,"_1893":39514},[],"/docs/platform/pki/integrations/aws-iot-core#auto-mode","`auto` mode",{"_2303":1354,"_22650":1341,"_5":22906,"_15464":39516,"_21389":39517,"_1893":39518},[],"/docs/platform/pki/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_2303":1355,"_22650":1341,"_5":22906,"_15464":39520,"_21389":39521,"_1893":39522},[],"/docs/platform/pki/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_2303":1356,"_22650":1341,"_5":22906,"_15464":39524,"_21389":39525,"_1893":39526},[],"/docs/platform/pki/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_2303":1357,"_22650":1341,"_5":22906,"_15464":39528,"_21389":39529,"_1893":39530},[],"/docs/platform/pki/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_2303":1358,"_22650":1341,"_5":22906,"_15464":39532,"_21389":39533,"_1893":39534},[],"/docs/platform/pki/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_2303":1359,"_22650":1341,"_5":22906,"_15464":39536,"_21389":39537,"_1893":39538},[],"/docs/platform/pki/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_2303":1360,"_22650":1341,"_5":22906,"_15464":39540,"_21389":39541,"_1893":39542},[],"/docs/platform/pki/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_2303":1361,"_22650":1341,"_5":22906,"_15464":39544,"_21389":39545,"_1893":39546},[],"/docs/platform/pki/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_2303":1362,"_22650":1341,"_5":22906,"_15464":39548,"_21389":39549,"_1893":39550},[],"/docs/platform/pki/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_2303":1363,"_22650":1341,"_15464":39552,"_5":15353,"_21389":1341,"_1893":39553},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_2303":1364,"_22650":1341,"_15464":39555,"_5":15353,"_21389":1341,"_1893":39556},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_2303":1365,"_22650":1341,"_15464":39558,"_5":15353,"_21389":1341,"_1893":39559},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_2303":1366,"_22650":1341,"_15464":39561,"_5":15353,"_21389":39475,"_1893":39562},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_2303":1367,"_22650":1341,"_15464":39564,"_5":15353,"_21389":39475,"_1893":39565},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_2303":1368,"_22650":1341,"_15464":39567,"_5":15353,"_21389":39475,"_1893":39568},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_2303":1369,"_22650":1341,"_15464":39570,"_5":15353,"_21389":39475,"_1893":39571},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_2303":1370,"_22650":1341,"_15464":39573,"_5":15353,"_21389":39479,"_1893":39574},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_2303":1371,"_22650":1341,"_15464":39576,"_5":15353,"_21389":39482,"_1893":39577},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_2303":1372,"_22650":1341,"_15464":39579,"_5":15353,"_21389":39482,"_1893":39580},[],"IAM action",{"_2303":1373,"_22650":1341,"_15464":39582,"_5":15353,"_21389":39482,"_1893":35639},[],{"_2303":1374,"_22650":1341,"_15464":39584,"_5":15353,"_21389":39482,"_1893":39585},[],"`iot:GetRegistrationCode`",{"_2303":1375,"_22650":1341,"_15464":39587,"_5":15353,"_21389":39482,"_1893":39588},[],"Obtain the verification code for CA registration in the Primary Account",{"_2303":1376,"_22650":1341,"_15464":39590,"_5":15353,"_21389":39482,"_1893":39591},[],"`iot:RegisterCACertificate`",{"_2303":1377,"_22650":1341,"_15464":39593,"_5":15353,"_21389":39482,"_1893":39594},[],"Register the CA in AWS IoT",{"_2303":1378,"_22650":1341,"_15464":39596,"_5":15353,"_21389":39482,"_1893":39597},[],"`iot:DescribeCACertificate`",{"_2303":1379,"_22650":1341,"_15464":39599,"_5":15353,"_21389":39482,"_1893":39600},[],"Check the CA registration status",{"_2303":1380,"_22650":1341,"_15464":39602,"_5":15353,"_21389":39482,"_1893":39603},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_2303":1381,"_22650":1341,"_15464":39605,"_5":15353,"_21389":39482,"_1893":39606},[],"Create or update Things in IoT Core",{"_2303":1382,"_22650":1341,"_15464":39608,"_5":15353,"_21389":39482,"_1893":39609},[],"`iot:RegisterThing`",{"_2303":1383,"_22650":1341,"_15464":39611,"_5":15353,"_21389":39482,"_1893":39612},[],"Provision Things through a template",{"_2303":1384,"_22650":1341,"_15464":39614,"_5":15353,"_21389":39482,"_1893":39615},[],"`iot:RegisterCertificate`",{"_2303":1385,"_22650":1341,"_15464":39617,"_5":15353,"_21389":39482,"_1893":39618},[],"Register device certificates",{"_2303":1386,"_22650":1341,"_15464":39620,"_5":15353,"_21389":39482,"_1893":39621},[],"`iot:UpdateCertificate`",{"_2303":1387,"_22650":1341,"_15464":39623,"_5":15353,"_21389":39482,"_1893":39624},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_2303":1388,"_22650":1341,"_15464":39626,"_5":15353,"_21389":39482,"_1893":39627},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_2303":1389,"_22650":1341,"_15464":39629,"_5":15353,"_21389":39482,"_1893":39630},[],"Create and attach IoT policies",{"_2303":1390,"_22650":1341,"_15464":39632,"_5":15353,"_21389":39482,"_1893":39633},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_2303":1391,"_22650":1341,"_15464":39635,"_5":15353,"_21389":39482,"_1893":39636},[],"Manage Thing groups",{"_2303":1392,"_22650":1341,"_15464":39638,"_5":15353,"_21389":39482,"_1893":39639},[],"`iot:CreateProvisioningTemplate`",{"_2303":1393,"_22650":1341,"_15464":39641,"_5":15353,"_21389":39482,"_1893":39642},[],"Create JITP templates",{"_2303":1394,"_22650":1341,"_15464":39644,"_5":15353,"_21389":39482,"_1893":39645},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_2303":1395,"_22650":1341,"_15464":39647,"_5":15353,"_21389":39482,"_1893":39648},[],"Read and write the Device Shadow",{"_2303":1396,"_22650":1341,"_15464":39650,"_5":15353,"_21389":39482,"_1893":39651},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_2303":1397,"_22650":1341,"_15464":39653,"_5":15353,"_21389":39486,"_1893":39654},[],"Parameter",{"_2303":1398,"_22650":1341,"_15464":39656,"_5":15353,"_21389":39486,"_1893":39657},[],"Type",{"_2303":1399,"_22650":1341,"_15464":39659,"_5":15353,"_21389":39486,"_1893":39660},[],"Required",{"_2303":1400,"_22650":1341,"_15464":39662,"_5":15353,"_21389":39486,"_1893":38421},[],{"_2303":1401,"_22650":1341,"_15464":39664,"_5":15353,"_21389":39486,"_1893":39665},[],"`connector_id`",{"_2303":1402,"_22650":1341,"_15464":39667,"_5":15353,"_21389":39486,"_1893":18637},[],{"_2303":1403,"_22650":1341,"_15464":39669,"_5":15353,"_21389":39486,"_1893":39049},[],{"_2303":1404,"_22650":1341,"_15464":39671,"_5":15353,"_21389":39486,"_1893":39672},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_2303":1405,"_22650":1341,"_15464":39674,"_5":15353,"_21389":39486,"_1893":39675},[],"`aws_config.region`",{"_2303":1406,"_22650":1341,"_15464":39677,"_5":15353,"_21389":39486,"_1893":18637},[],{"_2303":1407,"_22650":1341,"_15464":39679,"_5":15353,"_21389":39486,"_1893":39049},[],{"_2303":1408,"_22650":1341,"_15464":39681,"_5":15353,"_21389":39486,"_1893":39682},[],"AWS region where the connector operates.",{"_2303":1409,"_22650":1341,"_15464":39684,"_5":15353,"_21389":39486,"_1893":39685},[],"`aws_config.auth_method`",{"_2303":1410,"_22650":1341,"_15464":39687,"_5":15353,"_21389":39486,"_1893":18637},[],{"_2303":1411,"_22650":1341,"_15464":39689,"_5":15353,"_21389":39486,"_1893":39049},[],{"_2303":1412,"_22650":1341,"_15464":39691,"_5":15353,"_21389":39486,"_1893":39692},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_2303":1413,"_22650":1341,"_15464":39694,"_5":15353,"_21389":39486,"_1893":39695},[],"`aws_config.access_key_id`",{"_2303":1414,"_22650":1341,"_15464":39697,"_5":15353,"_21389":39486,"_1893":18637},[],{"_2303":1415,"_22650":1341,"_15464":39699,"_5":15353,"_21389":39486,"_1893":39700},[],"Only with `auth_method=static`",{"_2303":1416,"_22650":1341,"_15464":39702,"_5":15353,"_21389":39486,"_1893":39703},[],"AWS access key.",{"_2303":1417,"_22650":1341,"_15464":39705,"_5":15353,"_21389":39486,"_1893":39706},[],"`aws_config.secret_access_key`",{"_2303":1418,"_22650":1341,"_15464":39708,"_5":15353,"_21389":39486,"_1893":18637},[],{"_2303":1419,"_22650":1341,"_15464":39710,"_5":15353,"_21389":39486,"_1893":39700},[],{"_2303":1420,"_22650":1341,"_15464":39712,"_5":15353,"_21389":39486,"_1893":39713},[],"AWS secret key.",{"_2303":1421,"_22650":1341,"_15464":39715,"_5":15353,"_21389":39486,"_1893":39716},[],"`aws_config.session_token`",{"_2303":1422,"_22650":1341,"_15464":39718,"_5":15353,"_21389":39486,"_1893":18637},[],{"_2303":1423,"_22650":1341,"_15464":39720,"_5":15353,"_21389":39486,"_1893":39721},[],"No",{"_2303":1424,"_22650":1341,"_15464":39723,"_5":15353,"_21389":39486,"_1893":39724},[],"Session token (with `auth_method=static`).",{"_2303":1425,"_22650":1341,"_15464":39726,"_5":15353,"_21389":39486,"_1893":39727},[],"`aws_config.role_arn`",{"_2303":1426,"_22650":1341,"_15464":39729,"_5":15353,"_21389":39486,"_1893":18637},[],{"_2303":1427,"_22650":1341,"_15464":39731,"_5":15353,"_21389":39486,"_1893":39732},[],"Only with `auth_method=role`",{"_2303":1428,"_22650":1341,"_15464":39734,"_5":15353,"_21389":39486,"_1893":39735},[],"ARN of the role to assume.",{"_2303":1429,"_22650":1341,"_15464":39737,"_5":15353,"_21389":39486,"_1893":39738},[],"`aws_config.endpoint_url`",{"_2303":1430,"_22650":1341,"_15464":39740,"_5":15353,"_21389":39486,"_1893":18637},[],{"_2303":1431,"_22650":1341,"_15464":39742,"_5":15353,"_21389":39486,"_1893":39721},[],{"_2303":1432,"_22650":1341,"_15464":39744,"_5":15353,"_21389":39486,"_1893":39745},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_2303":1433,"_22650":1341,"_15464":39747,"_5":15353,"_21389":39486,"_1893":39748},[],"`subscriber_event_bus`",{"_2303":1434,"_22650":1341,"_15464":39750,"_5":15353,"_21389":39486,"_1893":12893},[],{"_2303":1435,"_22650":1341,"_15464":39752,"_5":15353,"_21389":39486,"_1893":39049},[],{"_2303":1436,"_22650":1341,"_15464":39754,"_5":15353,"_21389":39486,"_1893":39755},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_2303":1437,"_22650":1341,"_15464":39757,"_5":15353,"_21389":39486,"_1893":39758},[],"`dms_manager_client`",{"_2303":1438,"_22650":1341,"_15464":39760,"_5":15353,"_21389":39486,"_1893":18637},[],{"_2303":1439,"_22650":1341,"_15464":39762,"_5":15353,"_21389":39486,"_1893":39049},[],{"_2303":1440,"_22650":1341,"_15464":39764,"_5":15353,"_21389":39486,"_1893":39765},[],"HTTP URL of Lamassu's DMS Manager service.",{"_2303":1441,"_22650":1341,"_15464":39767,"_5":15353,"_21389":39486,"_1893":39768},[],"`device_manager_client`",{"_2303":1442,"_22650":1341,"_15464":39770,"_5":15353,"_21389":39486,"_1893":18637},[],{"_2303":1443,"_22650":1341,"_15464":39772,"_5":15353,"_21389":39486,"_1893":39049},[],{"_2303":1444,"_22650":1341,"_15464":39774,"_5":15353,"_21389":39486,"_1893":39775},[],"HTTP URL of Lamassu's Device Manager.",{"_2303":1445,"_22650":1341,"_15464":39777,"_5":15353,"_21389":39486,"_1893":39778},[],"`ca_client`",{"_2303":1446,"_22650":1341,"_15464":39780,"_5":15353,"_21389":39486,"_1893":18637},[],{"_2303":1447,"_22650":1341,"_15464":39782,"_5":15353,"_21389":39486,"_1893":39049},[],{"_2303":1448,"_22650":1341,"_15464":39784,"_5":15353,"_21389":39486,"_1893":39785},[],"HTTP URL of Lamassu's CA service.",{"_2303":1449,"_22650":1341,"_15464":39787,"_5":15353,"_21389":39490,"_1893":39788},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_2303":1450,"_22650":1341,"_15464":39790,"_5":15353,"_21389":39494,"_1893":39791},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_2303":1451,"_22650":1341,"_15464":39793,"_5":15353,"_21389":39494,"_1893":39794},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_2303":1452,"_22650":1341,"_15464":39796,"_5":15353,"_21389":39498,"_1893":39797},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_2303":1453,"_22650":1341,"_15464":39799,"_5":15353,"_21389":39498,"_1893":39800},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_2303":1454,"_22650":1341,"_15464":39802,"_5":15353,"_21389":39498,"_1893":39803},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_2303":1455,"_22650":1341,"_15464":39805,"_5":15353,"_21389":39498,"_1893":39806},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_2303":1456,"_22650":1341,"_15464":39808,"_5":15353,"_21389":39498,"_1893":39809},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_2303":1457,"_22650":1341,"_15464":39811,"_5":15353,"_21389":39498,"_1893":39812},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_2303":1458,"_22650":1341,"_15464":39814,"_5":15353,"_21389":39502,"_1893":39815},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_2303":1459,"_22650":1341,"_15464":39817,"_5":15353,"_21389":39506,"_1893":39818},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_2303":1460,"_22650":1341,"_15464":39820,"_5":15353,"_21389":39506,"_1893":39821},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_2303":1461,"_22650":1341,"_15464":39823,"_5":15353,"_21389":39509,"_1893":39824},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_2303":1462,"_22650":1341,"_15464":39826,"_5":15353,"_21389":39513,"_1893":39827},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_2303":1463,"_22650":1341,"_15464":39829,"_5":15353,"_21389":39513,"_1893":39830},[],"Creates or updates the IoT policies configured in the DMS.",{"_2303":1464,"_22650":1341,"_15464":39832,"_5":15353,"_21389":39513,"_1893":39833},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_2303":1465,"_22650":1341,"_15464":39835,"_5":15353,"_21389":39513,"_1893":39836},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_2303":1466,"_22650":1341,"_15464":39838,"_5":15353,"_21389":39513,"_1893":39839},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_2303":1467,"_22650":1341,"_15464":39841,"_5":15353,"_21389":39513,"_1893":39842},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_2303":1468,"_22650":1341,"_15464":39844,"_5":15353,"_21389":39513,"_1893":39845},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_2303":1469,"_22650":1341,"_15464":39847,"_5":15353,"_21389":39517,"_1893":39848},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. This template is created or updated at the moment the DMS is created or updated in Lamassu — not at device enrollment time. From then on, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_2303":1470,"_22650":1341,"_15464":39850,"_5":15353,"_21389":39517,"_1893":39851},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_2303":1471,"_22650":1341,"_15464":39853,"_5":15353,"_21389":39517,"_1893":39854},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_2303":1472,"_22650":1341,"_15464":39856,"_5":15353,"_21389":39521,"_1893":39857},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_2303":1473,"_22650":1341,"_15464":39859,"_5":15353,"_21389":39521,"_1893":39860},[],"The full flow from the device's perspective is:",{"_2303":1474,"_22650":1341,"_15464":39862,"_5":15353,"_21389":39521,"_1893":39863},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_2303":1475,"_22650":1341,"_15464":39865,"_5":15353,"_21389":39525,"_1893":39866},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_2303":1476,"_22650":1341,"_15464":39868,"_5":15353,"_21389":39525,"_1893":39869},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_2303":1477,"_22650":1341,"_15464":39871,"_5":15353,"_21389":39525,"_1893":39872},[],"For the JITP flow to work correctly:",{"_2303":1478,"_22650":1341,"_15464":39874,"_5":15353,"_21389":39525,"_1893":39875},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_2303":1479,"_22650":1341,"_15464":39877,"_5":15353,"_21389":39525,"_1893":39878},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_2303":1480,"_22650":1341,"_15464":39880,"_5":15353,"_21389":39525,"_1893":39881},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_2303":1481,"_22650":1341,"_15464":39883,"_5":15353,"_21389":39525,"_1893":39884},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_2303":1482,"_22650":1341,"_15464":39886,"_5":15353,"_21389":39529,"_1893":39887},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_2303":1483,"_22650":1341,"_15464":39889,"_5":15353,"_21389":39529,"_1893":39890},[],"Status in Lamassu",{"_2303":1484,"_22650":1341,"_15464":39892,"_5":15353,"_21389":39529,"_1893":39893},[],"Revocation reason",{"_2303":1485,"_22650":1341,"_15464":39895,"_5":15353,"_21389":39529,"_1893":39896},[],"Status in AWS IoT Core",{"_2303":1486,"_22650":1341,"_15464":39898,"_5":15353,"_21389":39529,"_1893":39899},[],"`Active`",{"_2303":1487,"_22650":1341,"_15464":39901,"_5":15353,"_21389":39529,"_1893":39089},[],{"_2303":1488,"_22650":1341,"_15464":39903,"_5":15353,"_21389":39529,"_1893":39904},[],"`ACTIVE`",{"_2303":1489,"_22650":1341,"_15464":39906,"_5":15353,"_21389":39529,"_1893":39907},[],"`Revoked`",{"_2303":1490,"_22650":1341,"_15464":39909,"_5":15353,"_21389":39529,"_1893":39910},[],"`certificateHold`",{"_2303":1491,"_22650":1341,"_15464":39912,"_5":15353,"_21389":39529,"_1893":39913},[],"`INACTIVE`",{"_2303":1492,"_22650":1341,"_15464":39915,"_5":15353,"_21389":39529,"_1893":39907},[],{"_2303":1493,"_22650":1341,"_15464":39917,"_5":15353,"_21389":39529,"_1893":39918},[],"Any other reason",{"_2303":1494,"_22650":1341,"_15464":39920,"_5":15353,"_21389":39529,"_1893":39921},[],"`REVOKED`",{"_2303":1495,"_22650":1341,"_15464":39923,"_5":15353,"_21389":39529,"_1893":39924},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_2303":1496,"_22650":1341,"_15464":39926,"_5":15353,"_21389":39533,"_1893":39927},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_2303":1497,"_22650":1341,"_15464":39929,"_5":15353,"_21389":39533,"_1893":39930},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_2303":1498,"_22650":1341,"_15464":39932,"_5":15353,"_21389":39533,"_1893":39933},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_2303":1499,"_22650":1341,"_15464":39935,"_5":15353,"_21389":39537,"_1893":39936},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_2303":1500,"_22650":1341,"_15464":39938,"_5":15353,"_21389":39537,"_1893":39939},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_2303":1501,"_22650":1341,"_15464":39941,"_5":15353,"_21389":39541,"_1893":39942},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_2303":1502,"_22650":1341,"_15464":39944,"_5":15353,"_21389":39541,"_1893":39945},[],"There are two action types:",{"_2303":1503,"_22650":1341,"_15464":39947,"_5":15353,"_21389":39541,"_1893":39948},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_2303":1504,"_22650":1341,"_15464":39950,"_5":15353,"_21389":39541,"_1893":39951},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_2303":1505,"_22650":1341,"_15464":39953,"_5":15353,"_21389":39541,"_1893":39954},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_2303":1506,"_22650":1341,"_15464":39956,"_5":15353,"_21389":39545,"_1893":39957},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_2303":1507,"_22650":1341,"_15464":39959,"_5":15353,"_21389":39545,"_1893":39960},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_2303":1508,"_22650":1341,"_15464":39962,"_5":15353,"_21389":39545,"_1893":39963},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_2303":1509,"_22650":1341,"_15464":39965,"_5":15353,"_21389":39549,"_1893":39966},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_2303":1510,"_22650":1341,"_15464":39968,"_5":15353,"_21389":39549,"_1893":39969},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_2303":1511,"_22650":1341,"_15464":39971,"_5":15353,"_21389":39549,"_1893":39972},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_2303":1512,"_22650":1341,"_15464":39974,"_5":15353,"_21389":39549,"_1893":39975},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_2303":1513,"_22650":1341,"_15464":39977,"_5":15353,"_21389":39549,"_1893":39978},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_2303":1514,"_22650":1341,"_15464":39980,"_5":15353,"_21389":39549,"_1893":39981},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_2303":1515,"_22650":1341,"_15464":39983,"_5":15353,"_21389":39549,"_1893":39984},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_2303":1516,"_22650":1341,"_15464":39986,"_5":15353,"_21389":39549,"_1893":39987},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_2303":1517,"_22650":1341,"_15464":39989,"_5":15353,"_21389":39549,"_1893":39990},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_2303":1518,"_22650":1341,"_15464":39992,"_5":15353,"_21389":39549,"_1893":39993},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_2303":1519,"_22650":1341,"_15464":39995,"_5":15353,"_21389":39549,"_1893":39996},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_2303":1520,"_22650":1341,"_15464":39998,"_5":15353,"_21389":39549,"_1893":39999},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_2303":1521,"_22650":1341,"_15464":40001,"_5":15353,"_21389":39549,"_1893":40002},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_2303":1522,"_22650":1341,"_15464":40004,"_5":15353,"_21389":39549,"_1893":40005},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_2303":1523,"_22650":1341,"_15464":40007,"_5":15353,"_21389":39549,"_1893":40008},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_2303":1524,"_22650":1341,"_15464":40010,"_5":15353,"_21389":39549,"_1893":40011},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_2303":1525,"_22650":1341,"_15464":40013,"_5":15353,"_21389":39549,"_1893":40014},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_2303":1526,"_22650":1341,"_15464":40016,"_5":15353,"_21389":39549,"_1893":40017},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_2303":1527,"_22650":1341,"_15464":40019,"_5":15353,"_21389":39549,"_1893":40020},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/pki/device-enrollment\" />",{"_2303":1528,"_22650":1341,"_15464":40022,"_5":15353,"_21389":39549,"_1893":40023},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/pki/est-enrollment\" />",{"_2303":1529,"_22650":1341,"_15464":40025,"_5":15353,"_21389":39549,"_1893":40026},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_2303":1530,"_22650":1530,"_5":10649,"_1893":40028,"_22909":40029,"_15464":40030,"_21389":1530},"Keys and cryptographic engines",[35256,36391,36869],[],{"_2303":1531,"_22650":1530,"_15464":40032,"_5":15353,"_21389":1530,"_1893":40033},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_2303":1532,"_22650":1530,"_5":22906,"_15464":40035,"_21389":40036,"_1893":40037},[],"/docs/platform/pki/key-management#cryptographic-key-management","Cryptographic key management",{"_2303":1533,"_22650":1530,"_5":22906,"_15464":40039,"_21389":40040,"_1893":40041},[],"/docs/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_2303":1534,"_22650":1530,"_5":22906,"_15464":40043,"_21389":40044,"_1893":40045},[],"/docs/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_2303":1535,"_22650":1530,"_5":22906,"_15464":40047,"_21389":40048,"_1893":40049},[],"/docs/platform/pki/key-management#file-system","File System",{"_2303":1536,"_22650":1530,"_5":22906,"_15464":40051,"_21389":40052,"_1893":40053},[],"/docs/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_2303":1537,"_22650":1530,"_5":22906,"_15464":40055,"_21389":40056,"_1893":40057},[],"/docs/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_2303":1538,"_22650":1530,"_5":22906,"_15464":40059,"_21389":40060,"_1893":40061},[],"/docs/platform/pki/key-management#aws-kms","AWS KMS",{"_2303":1539,"_22650":1530,"_5":22906,"_15464":40063,"_21389":40064,"_1893":40065},[],"/docs/platform/pki/key-management#pkcs11","PKCS#11",{"_2303":1540,"_22650":1530,"_5":22906,"_15464":40067,"_21389":40068,"_1893":40069},[],"/docs/platform/pki/key-management#key-inventory","Key inventory",{"_2303":1541,"_22650":1530,"_5":22906,"_15464":40071,"_21389":40072,"_1893":40073},[],"/docs/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_2303":1542,"_22650":1530,"_5":22906,"_15464":40075,"_21389":40076,"_1893":40077},[],"/docs/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_2303":1543,"_22650":1530,"_5":22906,"_15464":40079,"_21389":40080,"_1893":40081},[],"/docs/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_2303":1544,"_22650":1530,"_5":22906,"_15464":40083,"_21389":40084,"_1893":40085},[],"/docs/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_2303":1545,"_22650":1530,"_5":22906,"_15464":40087,"_21389":40088,"_1893":40089},[],"/docs/platform/pki/key-management#view-details","View details",{"_2303":1546,"_22650":1530,"_5":22906,"_15464":40091,"_21389":40092,"_1893":40093},[],"/docs/platform/pki/key-management#sign-and-verify","Sign and verify",{"_2303":1547,"_22650":1530,"_5":22906,"_15464":40095,"_21389":40096,"_1893":40097},[],"/docs/platform/pki/key-management#sign","Sign",{"_2303":1548,"_22650":1530,"_5":22906,"_15464":40099,"_21389":40100,"_1893":40101},[],"/docs/platform/pki/key-management#verify","Verify",{"_2303":1549,"_22650":1530,"_5":22906,"_15464":40103,"_21389":40104,"_1893":40105},[],"/docs/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_2303":1550,"_22650":1530,"_5":22906,"_15464":40107,"_21389":40108,"_1893":40109},[],"/docs/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_2303":1551,"_22650":1530,"_15464":40111,"_5":15353,"_21389":40036,"_1893":40112},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_2303":1552,"_22650":1530,"_15464":40114,"_5":15353,"_21389":40036,"_1893":40115},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_2303":1553,"_22650":1530,"_15464":40117,"_5":15353,"_21389":40040,"_1893":40118},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_2303":1554,"_22650":1530,"_15464":40120,"_5":15353,"_21389":40040,"_1893":40121},[],"In practice, it lets you:",{"_2303":1555,"_22650":1530,"_15464":40123,"_5":15353,"_21389":40040,"_1893":40124},[],"Generate new key pairs from Lamassu IoT.",{"_2303":1556,"_22650":1530,"_15464":40126,"_5":15353,"_21389":40040,"_1893":40127},[],"Import keys created externally.",{"_2303":1557,"_22650":1530,"_15464":40129,"_5":15353,"_21389":40040,"_1893":40130},[],"Delegate custody and cryptographic operations to external engines.",{"_2303":1558,"_22650":1530,"_15464":40132,"_5":15353,"_21389":40040,"_1893":40133},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_2303":1559,"_22650":1530,"_15464":40135,"_5":15353,"_21389":40044,"_1893":40136},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_2303":1560,"_22650":1530,"_15464":40138,"_5":15353,"_21389":40044,"_1893":40139},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_2303":1561,"_22650":1530,"_15464":40141,"_5":15353,"_21389":40044,"_1893":40142},[],"Currently, Lamassu supports five engine types. Choose according to the isolation level you need and who should be able to access private material.",{"_2303":1562,"_22650":1530,"_15464":40144,"_5":15353,"_21389":40048,"_1893":40145},[],"Generates keys with Go's cryptographic libraries and delegates their protection to the file system. It works both on-premise and in the cloud, but it does not prevent key extraction and is not recommended for production.",{"_2303":1563,"_22650":1530,"_15464":40147,"_5":15353,"_21389":40052,"_1893":40148},[],"Protects keys at rest and can run on-premise or in the cloud. An administrator with sufficient permissions can still view private material, so it is wise to limit administrative access and safeguard the *unseal* keys.",{"_2303":1564,"_22650":1530,"_15464":40150,"_5":15353,"_21389":40056,"_1893":40151},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_2303":1565,"_22650":1530,"_15464":40153,"_5":15353,"_21389":40060,"_1893":40154},[],"Generates keys with hardware entropy and never exposes the private key. Operations run inside the service. Even so, an identity with sufficient permissions could use the key to sign, so IAM policy remains critical.",{"_2303":1566,"_22650":1530,"_15464":40156,"_5":15353,"_21389":40064,"_1893":40157},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_2303":1567,"_22650":1530,"_15464":40159,"_5":15353,"_21389":40064,"_1893":40160},[],"Lamassu shows the full list of enabled engines in the console.",{"_2303":1568,"_22650":1530,"_15464":40162,"_5":15353,"_21389":40064,"_1893":40163},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_2303":1569,"_22650":1530,"_15464":40165,"_5":15353,"_21389":40064,"_1893":40166},[],"During deployment it is mandatory to define a default engine. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_2303":1570,"_22650":1530,"_15464":40168,"_5":15353,"_21389":40068,"_1893":40169},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_2303":1571,"_22650":1530,"_15464":40171,"_5":15353,"_21389":40068,"_1893":40172},[],"The table includes the following fields:",{"_2303":1572,"_22650":1530,"_15464":40174,"_5":15353,"_21389":40068,"_1893":40175},[],"**Name**: descriptive name of the key.",{"_2303":1573,"_22650":1530,"_15464":40177,"_5":15353,"_21389":40068,"_1893":40178},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_2303":1574,"_22650":1530,"_15464":40180,"_5":15353,"_21389":40068,"_1893":40181},[],"**Strength**: visual indicator of cryptographic strength.",{"_2303":1575,"_22650":1530,"_15464":40183,"_5":15353,"_21389":40068,"_1893":40184},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_2303":1576,"_22650":1530,"_15464":40186,"_5":15353,"_21389":40068,"_1893":40187},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_2303":1577,"_22650":1530,"_15464":40189,"_5":15353,"_21389":40068,"_1893":40190},[],"**Aliases**: alternative names associated with the key.",{"_2303":1578,"_22650":1530,"_15464":40192,"_5":15353,"_21389":40068,"_1893":40193},[],"**Tags**: labels for classification and search.",{"_2303":1579,"_22650":1530,"_15464":40195,"_5":15353,"_21389":40068,"_1893":40196},[],"**Related Entities**: certificates or other entities linked to that key.",{"_2303":1580,"_22650":1530,"_15464":40198,"_5":15353,"_21389":40068,"_1893":40199},[],"From this view you also reach the most common actions:",{"_2303":1581,"_22650":1530,"_15464":40201,"_5":15353,"_21389":40068,"_1893":40202},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_2303":1582,"_22650":1530,"_15464":40204,"_5":15353,"_21389":40068,"_1893":40205},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_2303":1583,"_22650":1530,"_15464":40207,"_5":15353,"_21389":40068,"_1893":40208},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_2303":1584,"_22650":1530,"_15464":40210,"_5":15353,"_21389":40068,"_1893":40211},[],"**Delete Key** to remove the key from the system.",{"_2303":1585,"_22650":1530,"_15464":40213,"_5":15353,"_21389":40072,"_1893":40214},[],"Keys are registered from the wizard opened with **Create New Key**.",{"_2303":1586,"_22650":1530,"_15464":40216,"_5":15353,"_21389":40076,"_1893":40217},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_2303":1587,"_22650":1530,"_15464":40219,"_5":15353,"_21389":40076,"_1893":40220},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_2303":1588,"_22650":1530,"_15464":40222,"_5":15353,"_21389":40076,"_1893":40223},[],"**Key Name**: unique and descriptive name.",{"_2303":1589,"_22650":1530,"_15464":40225,"_5":15353,"_21389":40076,"_1893":40226},[],"**Crypto Engine**: engine that will keep the key.",{"_2303":1590,"_22650":1530,"_15464":40228,"_5":15353,"_21389":40076,"_1893":40229},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_2303":1591,"_22650":1530,"_15464":40231,"_5":15353,"_21389":40076,"_1893":40232},[],"**Tags**: metadata to classify the key.",{"_2303":1592,"_22650":1530,"_15464":40234,"_5":15353,"_21389":40076,"_1893":40235},[],"**Metadata**: additional information for advanced uses.",{"_2303":1593,"_22650":1530,"_15464":40237,"_5":15353,"_21389":40080,"_1893":40238},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_2303":1594,"_22650":1530,"_15464":40240,"_5":15353,"_21389":40080,"_1893":40241},[],"When the key was generated in an isolated environment or an external HSM.",{"_2303":1595,"_22650":1530,"_15464":40243,"_5":15353,"_21389":40080,"_1893":40244},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_2303":1596,"_22650":1530,"_15464":40246,"_5":15353,"_21389":40080,"_1893":40247},[],"When Lamassu must operate with a root of trust created by a third party.",{"_2303":1597,"_22650":1530,"_15464":40249,"_5":15353,"_21389":40080,"_1893":40250},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_2303":1598,"_22650":1530,"_15464":40252,"_5":15353,"_21389":40080,"_1893":40253},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_2303":1599,"_22650":1530,"_15464":40255,"_5":15353,"_21389":40080,"_1893":40256},[],"**Crypto Engine**: engine that will keep the imported key.",{"_2303":1600,"_22650":1530,"_15464":40258,"_5":15353,"_21389":40080,"_1893":40259},[],"**Tags**: labels for organization and search.",{"_2303":1601,"_22650":1530,"_15464":40261,"_5":15353,"_21389":40080,"_1893":40262},[],"**Metadata**: additional optional information.",{"_2303":1602,"_22650":1530,"_15464":40264,"_5":15353,"_21389":40080,"_1893":40265},[],"**Private Key (PEM)**: private key in PEM format.",{"_2303":1603,"_22650":1530,"_15464":40267,"_5":15353,"_21389":40080,"_1893":40268},[],"Once the wizard is complete, the key is stored in the selected engine and can be used for signing, CSR generation and the rest of the operations supported by the KMS.",{"_2303":1604,"_22650":1530,"_15464":40270,"_5":15353,"_21389":40084,"_1893":40271},[],"Each registered key has a detail view and several operational actions.",{"_2303":1605,"_22650":1530,"_15464":40273,"_5":15353,"_21389":40088,"_1893":40274},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_2303":1606,"_22650":1530,"_15464":40276,"_5":15353,"_21389":40088,"_1893":40277},[],"The **Overview** tab shows, among others, these fields:",{"_2303":1607,"_22650":1530,"_15464":40279,"_5":15353,"_21389":40088,"_1893":40280},[],"**Key Name**: descriptive name.",{"_2303":1608,"_22650":1530,"_15464":40282,"_5":15353,"_21389":40088,"_1893":40283},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_2303":1609,"_22650":1530,"_15464":40285,"_5":15353,"_21389":40088,"_1893":40286},[],"**Tags**: associated labels.",{"_2303":1610,"_22650":1530,"_15464":40288,"_5":15353,"_21389":40088,"_1893":40289},[],"**Aliases**: alternative names.",{"_2303":1611,"_22650":1530,"_15464":40291,"_5":15353,"_21389":40088,"_1893":40292},[],"**Crypto Engine**: engine where the key resides.",{"_2303":1612,"_22650":1530,"_15464":40294,"_5":15353,"_21389":40088,"_1893":40295},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_2303":1613,"_22650":1530,"_15464":40297,"_5":15353,"_21389":40088,"_1893":40298},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_2303":1614,"_22650":1530,"_15464":40300,"_5":15353,"_21389":40088,"_1893":40301},[],"The **Public Key** tab presents the public key in PEM format, ready to consult or copy.",{"_2303":1615,"_22650":1530,"_15464":40303,"_5":15353,"_21389":40092,"_1893":40304},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_2303":1616,"_22650":1530,"_15464":40306,"_5":15353,"_21389":40092,"_1893":40307},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_2303":1617,"_22650":1530,"_15464":40309,"_5":15353,"_21389":40096,"_1893":40310},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_2303":1618,"_22650":1530,"_15464":40312,"_5":15353,"_21389":40096,"_1893":40313},[],"Main fields:",{"_2303":1619,"_22650":1530,"_15464":40315,"_5":15353,"_21389":40096,"_1893":40316},[],"**Algorithm**: signing algorithm available for the key type.",{"_2303":1620,"_22650":1530,"_15464":40318,"_5":15353,"_21389":40096,"_1893":40319},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_2303":1621,"_22650":1530,"_15464":40321,"_5":15353,"_21389":40096,"_1893":40322},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_2303":1622,"_22650":1530,"_15464":40324,"_5":15353,"_21389":40096,"_1893":40325},[],"**Message**: content to sign.",{"_2303":1623,"_22650":1530,"_15464":40327,"_5":15353,"_21389":40096,"_1893":40328},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_2303":1624,"_22650":1530,"_15464":40330,"_5":15353,"_21389":40100,"_1893":40331},[],"This tab checks whether a signature corresponds to the associated public key.",{"_2303":1625,"_22650":1530,"_15464":40333,"_5":15353,"_21389":40100,"_1893":40313},[],{"_2303":1626,"_22650":1530,"_15464":40335,"_5":15353,"_21389":40100,"_1893":40336},[],"**Algorithm**: must match the algorithm used for the signature.",{"_2303":1627,"_22650":1530,"_15464":40338,"_5":15353,"_21389":40100,"_1893":40339},[],"**Message Type**: `Raw` or `Digest`.",{"_2303":1628,"_22650":1530,"_15464":40341,"_5":15353,"_21389":40100,"_1893":40342},[],"**Payload Encoding**: encoding of the message.",{"_2303":1629,"_22650":1530,"_15464":40344,"_5":15353,"_21389":40100,"_1893":40345},[],"**Message**: original message or hash.",{"_2303":1630,"_22650":1530,"_15464":40347,"_5":15353,"_21389":40100,"_1893":40348},[],"**Signature**: signature to check.",{"_2303":1631,"_22650":1530,"_15464":40350,"_5":15353,"_21389":40100,"_1893":40351},[],"**Result**: indicator of the validation result.",{"_2303":1632,"_22650":1530,"_15464":40353,"_5":15353,"_21389":40104,"_1893":40354},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_2303":1633,"_22650":1530,"_15464":40356,"_5":15353,"_21389":40104,"_1893":40357},[],"This flow is useful for:",{"_2303":1634,"_22650":1530,"_15464":40359,"_5":15353,"_21389":40104,"_1893":40360},[],"Requesting certificates from an external CA.",{"_2303":1635,"_22650":1530,"_15464":40362,"_5":15353,"_21389":40104,"_1893":40363},[],"Renewing an identity while keeping the same key.",{"_2303":1636,"_22650":1530,"_15464":40365,"_5":15353,"_21389":40104,"_1893":40366},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_2303":1637,"_22650":1530,"_15464":40368,"_5":15353,"_21389":40104,"_1893":40369},[],"**Common Name (CN)**: main name of the identity.",{"_2303":1638,"_22650":1530,"_15464":40371,"_5":15353,"_21389":40104,"_1893":40372},[],"**Organization (O)**: organization or company.",{"_2303":1639,"_22650":1530,"_15464":40374,"_5":15353,"_21389":40104,"_1893":40375},[],"**Organizational Unit (OU)**: department or unit.",{"_2303":1640,"_22650":1530,"_15464":40377,"_5":15353,"_21389":40104,"_1893":40378},[],"**Country (C)**: two-letter country code.",{"_2303":1641,"_22650":1530,"_15464":40380,"_5":15353,"_21389":40104,"_1893":40381},[],"**State / Province (ST)**: state or province.",{"_2303":1642,"_22650":1530,"_15464":40383,"_5":15353,"_21389":40104,"_1893":40384},[],"**Locality (L)**: city or locality.",{"_2303":1643,"_22650":1530,"_15464":40386,"_5":15353,"_21389":40104,"_1893":40387},[],"**Email Address**: contact email.",{"_2303":1644,"_22650":1530,"_15464":40389,"_5":15353,"_21389":40104,"_1893":40390},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_2303":1645,"_22650":1530,"_15464":40392,"_5":15353,"_21389":40104,"_1893":40393},[],"Once the form is complete, Lamassu generates the CSR and presents it for download or copy.",{"_2303":1646,"_22650":1530,"_15464":40395,"_5":15353,"_21389":40108,"_1893":40396},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_2303":1647,"_22650":1530,"_15464":40398,"_5":15353,"_21389":40108,"_1893":40399},[],"This option shows the steps needed to configure the local environment, load the PKCS#11 module and perform signatures with tools like OpenSSL without extracting the private key from the secured environment.",{"_2303":1648,"_22650":1648,"_5":10649,"_1893":40401,"_22909":40402,"_15464":40403,"_21389":1648},"Online validation with OCSP",[35256,36391,36869],[],{"_2303":1649,"_22650":1648,"_15464":40405,"_5":15353,"_21389":1648,"_1893":40406},[],"Check in real time whether a certificate is still valid or has been revoked.",{"_2303":1650,"_22650":1648,"_5":22906,"_15464":40408,"_21389":40409,"_1893":40410},[],"/docs/platform/pki/ocsp#ocsp-service","OCSP service",{"_2303":1651,"_22650":1648,"_5":22906,"_15464":40412,"_21389":40413,"_1893":40414},[],"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_2303":1652,"_22650":1648,"_5":22906,"_15464":40416,"_21389":40417,"_1893":40418},[],"/docs/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_2303":1653,"_22650":1648,"_5":22906,"_15464":40420,"_21389":40421,"_1893":40422},[],"/docs/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_2303":1654,"_22650":1648,"_5":22906,"_15464":40424,"_21389":40425,"_1893":40426},[],"/docs/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_2303":1655,"_22650":1648,"_5":22906,"_15464":40428,"_21389":40429,"_1893":38364},[],"/docs/platform/pki/ocsp#references",{"_2303":1656,"_22650":1648,"_15464":40431,"_5":15353,"_21389":40409,"_1893":40432},[],"OCSP (Online Certificate Status Protocol) is the mechanism that lets a relying party check, in real time, whether a specific certificate is valid or has been revoked. Instead of downloading a full list of revoked certificates, the client sends a query with the certificate's serial number and receives a signed response with the current status.",{"_2303":1657,"_22650":1648,"_15464":40434,"_5":15353,"_21389":40409,"_1893":40435},[],"Lamassu integrates its own OCSP responder that serves these queries by consulting the internal certificate database directly. No external component is required.",{"_2303":1658,"_22650":1648,"_15464":40437,"_5":15353,"_21389":40413,"_1893":40438},[],"When a client requests the status of a certificate, the responder locates the certificate by its serial number and determines its status from the internal record:",{"_2303":1659,"_22650":1648,"_15464":40440,"_5":15353,"_21389":40413,"_1893":40441},[],"If the certificate is active, the response indicates `Good`.",{"_2303":1660,"_22650":1648,"_15464":40443,"_5":15353,"_21389":40413,"_1893":40444},[],"If the certificate has been revoked, the response indicates `Revoked` and includes the revocation timestamp and the RFC 5280 reason code.",{"_2303":1661,"_22650":1648,"_15464":40446,"_5":15353,"_21389":40413,"_1893":40447},[],"If the serial number is not found or the status is not recognizable, the response indicates `Unknown`.",{"_2303":1662,"_22650":1648,"_15464":40449,"_5":15353,"_21389":40413,"_1893":40450},[],"The OCSP response is signed by the issuing CA of the queried certificate, using the cryptographic engine associated with that CA. Lamassu does not use a delegated OCSP signing certificate: the CA acts directly as the responder.",{"_2303":1663,"_22650":1648,"_15464":40452,"_5":15353,"_21389":40413,"_1893":40453},[],"Each response has a validity window of 24 hours, reflected in the response's `thisUpdate` and `nextUpdate` fields. Clients that cache responses must take this window into account when determining how long a response remains valid.",{"_2303":1664,"_22650":1648,"_15464":40455,"_5":15353,"_21389":40417,"_1893":40456},[],"The OCSP responder URL is automatically embedded in the AIA (*Authority Information Access*) extension of every certificate issued by Lamassu. Clients that verify certificates can read this URL directly from the certificate without additional configuration.",{"_2303":1665,"_22650":1648,"_15464":40458,"_5":15353,"_21389":40421,"_1893":40459},[],"The responder accepts both formats defined in RFC 6960:",{"_2303":1666,"_22650":1648,"_15464":40461,"_5":15353,"_21389":40421,"_1893":40462},[],"`GET /ocsp/{ocsp_request}` includes the OCSP request Base64url-encoded within the URL itself.",{"_2303":1667,"_22650":1648,"_15464":40464,"_5":15353,"_21389":40421,"_1893":40465},[],"`POST /ocsp` sends the request in the body with `Content-Type: application/ocsp-request`.",{"_2303":1668,"_22650":1648,"_15464":40467,"_5":15353,"_21389":40421,"_1893":40468},[],"Example query with `curl` using POST:",{"_2303":1669,"_22650":1648,"_15464":40470,"_5":15353,"_21389":40421,"_1893":40471},[],"The response has `Content-Type: application/ocsp-response` and contains the OCSP response in DER format.",{"_2303":1670,"_22650":1648,"_15464":40473,"_5":15353,"_21389":40425,"_1893":40474},[],"From the certificates screen of Lamassu you can launch an OCSP request directly against the selected certificate with the **OCSP Check** action. This action shows the status returned by the responder without needing external tools.",{"_2303":1671,"_22650":1648,"_15464":40476,"_5":15353,"_21389":40429,"_1893":40477},[],"RFC 6960 - *X.509 Internet Public Key Infrastructure Online Certificate Status Protocol – OCSP*",{"_2303":1672,"_22650":1648,"_15464":40479,"_5":15353,"_21389":40429,"_1893":40480},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile* (revocation reasons, section 5.3.1)",{"_2303":1673,"_22650":1648,"_15464":40482,"_5":15353,"_21389":40429,"_1893":40483},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_2303":1674,"_22650":1648,"_15464":40485,"_5":15353,"_21389":40429,"_1893":38456},[],{"_2303":1675,"_22650":1675,"_5":10649,"_1893":40487,"_22909":40488,"_15464":40489,"_21389":1675},"Lamassu IoT Platform",[35256,36391],[],{"_2303":1676,"_22650":1675,"_15464":40491,"_5":15353,"_21389":1675,"_1893":40492},[],"Manage PKI and digital identities for your devices from a single platform.",{"_2303":1677,"_22650":1675,"_5":22906,"_15464":40494,"_21389":40495,"_1893":40496},[],"/docs/platform/pki/overview#start-here","Start here",{"_2303":1678,"_22650":1675,"_5":22906,"_15464":40498,"_21389":40499,"_1893":40500},[],"/docs/platform/pki/overview#architecture-at-a-glance","Architecture at a glance",{"_2303":1679,"_22650":1675,"_5":22906,"_15464":40502,"_21389":40503,"_1893":40504},[],"/docs/platform/pki/overview#core-capabilities","Core capabilities",{"_2303":1680,"_22650":1675,"_5":22906,"_15464":40506,"_21389":40507,"_1893":40508},[],"/docs/platform/pki/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_2303":1681,"_22650":1675,"_5":22906,"_15464":40510,"_21389":40511,"_1893":40512},[],"/docs/platform/pki/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_2303":1682,"_22650":1675,"_5":22906,"_15464":40514,"_21389":40515,"_1893":40516},[],"/docs/platform/pki/overview#issue-and-control-certificates","Issue and control certificates",{"_2303":1683,"_22650":1675,"_5":22906,"_15464":40518,"_21389":40519,"_1893":40520},[],"/docs/platform/pki/overview#automate-device-identities","Automate device identities",{"_2303":1684,"_22650":1675,"_5":22906,"_15464":40522,"_21389":40523,"_1893":40524},[],"/docs/platform/pki/overview#publish-validation-status","Publish validation status",{"_2303":1685,"_22650":1675,"_5":22906,"_15464":40526,"_21389":40527,"_1893":40528},[],"/docs/platform/pki/overview#react-to-events","React to events",{"_2303":1686,"_22650":1675,"_5":22906,"_15464":40530,"_21389":40531,"_1893":40532},[],"/docs/platform/pki/overview#choose-your-path","Choose your path",{"_2303":1687,"_22650":1675,"_5":22906,"_15464":40534,"_21389":40535,"_1893":40536},[],"/docs/platform/pki/overview#operational-reference","Operational reference",{"_2303":1688,"_22650":1675,"_15464":40538,"_5":15353,"_21389":1675,"_1893":40539},[],"Lamassu IoT centralizes the issuance, distribution, renewal and revocation of X.509 identities for connected devices. You can build a private PKI, protect its keys and automate the enrollment of a fleet without losing visibility into every certificate.",{"_2303":1689,"_22650":1675,"_15464":40541,"_5":15353,"_21389":40495,"_1893":40542},[],"<Card title=\"Get started\" description=\"Create a CA, issue a certificate and register your first device.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2303":1690,"_22650":1675,"_15464":40544,"_5":15353,"_21389":40495,"_1893":40545},[],"<Card title=\"How Lamassu works\" description=\"Build the mental model of authorities, keys, identities and validation.\" href=\"/docs/platform/pki/concepts/overview\" />",{"_2303":1691,"_22650":1675,"_15464":40547,"_5":15353,"_21389":40499,"_1893":40548},[],"Lamassu runs as a set of services on Kubernetes, backed by PostgreSQL, RabbitMQ and an OIDC provider. Hover a component to trace its connections, or see the platform architecture chapter for the low-level, per-service view.",{"_2303":1692,"_22650":1675,"_15464":40550,"_5":15353,"_21389":40507,"_1893":40551},[],"Create root and intermediate authorities or import an existing PKI. Define which authority can issue each identity and keep the full chain of trust.",{"_2303":1693,"_22650":1675,"_15464":40553,"_5":15353,"_21389":40511,"_1893":40554},[],"Generate and safeguard keys using software engines, PKCS#11 HSMs or cloud services. Lamassu decouples operations from the physical location of the key.",{"_2303":1694,"_22650":1675,"_15464":40556,"_5":15353,"_21389":40515,"_1893":40557},[],"Issue certificates from the console or from a CSR, check their status and revoke them when they stop being trustworthy.",{"_2303":1695,"_22650":1675,"_15464":40559,"_5":15353,"_21389":40519,"_1893":40560},[],"Define enrollment policies with a Device Management Service (DMS) and let devices request or renew their identity through EST.",{"_2303":1696,"_22650":1675,"_15464":40562,"_5":15353,"_21389":40523,"_1893":40563},[],"Offer online validation through OCSP and distribute CRLs for consumers that need to check certificates offline.",{"_2303":1697,"_22650":1675,"_15464":40565,"_5":15353,"_21389":40527,"_1893":40566},[],"Subscribe to lifecycle changes and send notifications by email, Microsoft Teams or webhooks.",{"_2303":1698,"_22650":1675,"_15464":40568,"_5":15353,"_21389":40531,"_1893":40569},[],"<Card title=\"I administer the PKI\" description=\"Configure engines, authorities, issuance and validation.\" href=\"/docs/platform/pki/key-management\" />",{"_2303":1699,"_22650":1675,"_15464":40571,"_5":15353,"_21389":40531,"_1893":40572},[],"<Card title=\"I integrate a device\" description=\"Configure the DMS and use EST to obtain an identity.\" href=\"/docs/platform/pki/device-enrollment\" />",{"_2303":1700,"_22650":1675,"_15464":40574,"_5":15353,"_21389":40531,"_1893":40575},[],"<Card title=\"I operate the platform\" description=\"Deploy Lamassu and prepare its dependencies.\" href=\"/docs/deployment/overview\" />",{"_2303":1701,"_22650":1675,"_15464":40577,"_5":15353,"_21389":40531,"_1893":40578},[],"<Card title=\"I integrate another system\" description=\"Connect Lamassu with AWS IoT Core and other destinations.\" href=\"/docs/platform/pki/integrations/aws-iot-core\" />",{"_2303":1702,"_22650":1675,"_15464":40580,"_5":15353,"_21389":40535,"_1893":40581},[],"<Card title=\"Certificate profiles\" description=\"Turn issuance policy into reusable constraints.\" href=\"/docs/platform/pki/certificate-profiles\" />",{"_2303":1703,"_22650":1675,"_15464":40583,"_5":15353,"_21389":40535,"_1893":40584},[],"<Card title=\"Hierarchy and rotation\" description=\"Replace CA certificates or keys without breaking trust.\" href=\"/docs/platform/pki/ca-hierarchy-and-rotation\" />",{"_2303":1704,"_22650":1675,"_15464":40586,"_5":15353,"_21389":40535,"_1893":40587},[],"<Card title=\"Access control\" description=\"Configure principals, policies and the first administrator.\" href=\"/docs/platform/pki/access-control\" />",{"_2303":1705,"_22650":1675,"_15464":40589,"_5":15353,"_21389":40535,"_1893":40590},[],"<Card title=\"Troubleshooting\" description=\"Diagnose the Gateway, services, issuance and enrollment.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2303":1706,"_22650":1706,"_5":10649,"_1893":40592,"_22909":40593,"_15464":40595,"_21389":1706},"Create your first CA",[35256,36391,40594],"Getting started",[],{"_2303":1707,"_22650":1706,"_15464":40597,"_5":15353,"_21389":1706,"_1893":40598},[],"Create a root authority and check that it is ready to issue certificates.",{"_2303":1708,"_22650":1706,"_5":22906,"_15464":40600,"_21389":40601,"_1893":35266},[],"/docs/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_2303":1709,"_22650":1706,"_5":22906,"_15464":40603,"_21389":40604,"_1893":40605},[],"/docs/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard","Open the creation wizard",{"_2303":1710,"_22650":1706,"_5":22906,"_15464":40607,"_21389":40608,"_1893":40609},[],"/docs/platform/pki/quickstarts/create-certificate-authority#select-the-key","Select the key",{"_2303":1711,"_22650":1706,"_5":22906,"_15464":40611,"_21389":40612,"_1893":40613},[],"/docs/platform/pki/quickstarts/create-certificate-authority#define-the-authority","Define the authority",{"_2303":1712,"_22650":1706,"_5":22906,"_15464":40615,"_21389":40616,"_1893":40617},[],"/docs/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca","Review and create the CA",{"_2303":1713,"_22650":1706,"_5":22906,"_15464":40619,"_21389":40620,"_1893":40621},[],"/docs/platform/pki/quickstarts/create-certificate-authority#verify-the-result","Verify the result",{"_2303":1714,"_22650":1706,"_5":22906,"_15464":40623,"_21389":40624,"_1893":35290},[],"/docs/platform/pki/quickstarts/create-certificate-authority#next-step",{"_2303":1715,"_22650":1706,"_15464":40626,"_5":15353,"_21389":1706,"_1893":40627},[],"In this quickstart you will create a root certification authority with a new key pair. When you finish you will have an active CA that you can use in the next quickstart.",{"_2303":1716,"_22650":1706,"_15464":40629,"_5":15353,"_21389":40601,"_1893":40630},[],"Console access with permissions to manage authorities.",{"_2303":1717,"_22650":1706,"_15464":40632,"_5":15353,"_21389":40601,"_1893":40633},[],"At least one cryptographic engine available.",{"_2303":1718,"_22650":1706,"_15464":40635,"_5":15353,"_21389":40601,"_1893":40636},[],"A name that identifies the purpose of the CA, for example `Acme Device Root CA`.",{"_2303":1719,"_22650":1706,"_15464":40638,"_5":15353,"_21389":40601,"_1893":40639},[],"A root CA is self-signed and acts as the anchor of trust. For production it is usually preferable to keep the root more protected and issue from an intermediate CA.",{"_2303":1720,"_22650":1706,"_15464":40641,"_5":15353,"_21389":40604,"_1893":40642},[],"In the side menu, open **Certification Authorities** and select **Create New CA**.",{"_2303":1721,"_22650":1706,"_15464":40644,"_5":15353,"_21389":40604,"_1893":40645},[],"Choose to create a CA with a new key pair. If you already have the key in the KMS, use &#x2A;*Create New CA (Existing Key)**.",{"_2303":1722,"_22650":1706,"_15464":40647,"_5":15353,"_21389":40608,"_1893":40648},[],"Choose the cryptographic engine that will keep the key and configure the algorithm. For a first CA you can use **EC P-384**, as long as it is compatible with your consumers.",{"_2303":1723,"_22650":1706,"_15464":40650,"_5":15353,"_21389":40608,"_1893":40651},[],"The private key will remain under the control of the selected engine.",{"_2303":1724,"_22650":1706,"_15464":40653,"_5":15353,"_21389":40612,"_1893":40654},[],"Select **Root CA** and complete:",{"_2303":1725,"_22650":1706,"_15464":40656,"_5":15353,"_21389":40612,"_1893":40657},[],"**CA Name**: a unique, recognizable name.",{"_2303":1726,"_22650":1706,"_15464":40659,"_5":15353,"_21389":40612,"_1893":40660},[],"**Subject**: at least the organization and country that will identify the authority.",{"_2303":1727,"_22650":1706,"_15464":40662,"_5":15353,"_21389":40612,"_1893":40663},[],"**CA Certificate Expiration**: a validity longer than that of the certificates it will issue.",{"_2303":1728,"_22650":1706,"_15464":40665,"_5":15353,"_21389":40612,"_1893":40666},[],"**Default End-Entity Certificate Issuance Expiration**: the default validity of end-entity certificates.",{"_2303":1729,"_22650":1706,"_15464":40668,"_5":15353,"_21389":40612,"_1893":40669},[],"The CA name will be used as the certificate's `Common Name`.",{"_2303":1730,"_22650":1706,"_15464":40671,"_5":15353,"_21389":40616,"_1893":40672},[],"Check the algorithm, subject and dates before confirming. These values define the anchor of trust and should not be chosen as throwaway test data in a production environment.",{"_2303":1731,"_22650":1706,"_15464":40674,"_5":15353,"_21389":40620,"_1893":40675},[],"Open the new CA from the list. It should appear active and show its PEM certificate, the expiration date and the **Issued Certificates** tab.",{"_2303":1732,"_22650":1706,"_15464":40677,"_5":15353,"_21389":40624,"_1893":40678},[],"Use the authority to issue your first certificate, or see the full authorities guide to create an intermediate CA, import a CA or define advanced profiles.",{"_2303":1733,"_22650":1733,"_5":10649,"_1893":40680,"_22909":40681,"_15464":40682,"_21389":1733},"Issue your first certificate",[35256,36391,40594],[],{"_2303":1734,"_22650":1733,"_15464":40684,"_5":15353,"_21389":1733,"_1893":40685},[],"Issue an X.509 identity from the console and verify the result.",{"_2303":1735,"_22650":1733,"_5":22906,"_15464":40687,"_21389":40688,"_1893":35266},[],"/docs/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_2303":1736,"_22650":1733,"_5":22906,"_15464":40690,"_21389":40691,"_1893":40692},[],"/docs/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_2303":1737,"_22650":1733,"_5":22906,"_15464":40694,"_21389":40695,"_1893":40696},[],"/docs/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_2303":1738,"_22650":1733,"_5":22906,"_15464":40698,"_21389":40699,"_1893":40700},[],"/docs/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_2303":1739,"_22650":1733,"_5":22906,"_15464":40702,"_21389":40703,"_1893":40704},[],"/docs/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_2303":1740,"_22650":1733,"_5":22906,"_15464":40706,"_21389":40707,"_1893":40708},[],"/docs/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_2303":1741,"_22650":1733,"_5":22906,"_15464":40710,"_21389":40711,"_1893":40621},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-result",{"_2303":1742,"_22650":1733,"_5":22906,"_15464":40713,"_21389":40714,"_1893":35290},[],"/docs/platform/pki/quickstarts/issue-certificate#next-step",{"_2303":1743,"_22650":1733,"_15464":40716,"_5":15353,"_21389":1733,"_1893":40717},[],"In this quickstart Lamassu will generate the key and the CSR in the browser, and the CA will issue the certificate. When you finish you will download the certificate and its private key.",{"_2303":1744,"_22650":1733,"_15464":40719,"_5":15353,"_21389":40688,"_1893":40720},[],"An active CA with permission to issue certificates.",{"_2303":1745,"_22650":1733,"_15464":40722,"_5":15353,"_21389":40688,"_1893":40723},[],"A name for the identity, for example `device-001.example.internal`.",{"_2303":1746,"_22650":1733,"_15464":40725,"_5":15353,"_21389":40688,"_1893":40726},[],"A safe place to keep the downloaded private key.",{"_2303":1747,"_22650":1733,"_15464":40728,"_5":15353,"_21389":40688,"_1893":40729},[],"In this flow the key is generated in the browser and Lamassu does not store it. Download it and protect it before closing the operation result.",{"_2303":1748,"_22650":1733,"_15464":40731,"_5":15353,"_21389":40691,"_1893":40732},[],"Open the CA created in the previous quickstart, go to **Issued Certificates** and select **Issue New**.",{"_2303":1749,"_22650":1733,"_15464":40734,"_5":15353,"_21389":40695,"_1893":40735},[],"Select **Generate Key & CSR in Browser**. Use **Upload Existing CSR** when the private key must be generated and kept on the target system.",{"_2303":1750,"_22650":1733,"_15464":40737,"_5":15353,"_21389":40699,"_1893":40738},[],"Enter the `Common Name` and, if applicable, the organization, organizational unit and location. Add SANs for each DNS name, IP address, email or URI the identity will be validated with.",{"_2303":1751,"_22650":1733,"_15464":40740,"_5":15353,"_21389":40703,"_1893":40741},[],"Choose RSA or ECDSA, define the validity and select the key usages. For a device identity that uses mTLS, enable **Digital Signature** and **Client Authentication**.",{"_2303":1752,"_22650":1733,"_15464":40743,"_5":15353,"_21389":40703,"_1893":40744},[],"The validity cannot exceed the expiration date of the issuing CA.",{"_2303":1753,"_22650":1733,"_15464":40746,"_5":15353,"_21389":40707,"_1893":40747},[],"Confirm the issuance and immediately download the certificate and the private key in PEM format.",{"_2303":1754,"_22650":1733,"_15464":40749,"_5":15353,"_21389":40711,"_1893":40750},[],"The certificate should appear in **Issued Certificates** with an active status. Check its subject, SANs, issuer, usages and validity period.",{"_2303":1755,"_22650":1733,"_15464":40752,"_5":15353,"_21389":40714,"_1893":40753},[],"Register your first device to associate the identity with a managed entity, or see certificate management.",{"_2303":1756,"_22650":1756,"_5":10649,"_1893":40755,"_22909":40756,"_15464":40757,"_21389":1756},"Get started",[35256,36391,40594],[],{"_2303":1757,"_22650":1756,"_15464":40759,"_5":15353,"_21389":1756,"_1893":40760},[],"Get a first result with Lamassu and continue from a working base.",{"_2303":1758,"_22650":1756,"_5":22906,"_15464":40762,"_21389":40763,"_1893":40764},[],"/docs/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_2303":1759,"_22650":1756,"_5":22906,"_15464":40766,"_21389":40767,"_1893":35266},[],"/docs/platform/pki/quickstarts/overview#before-you-begin",{"_2303":1760,"_22650":1756,"_15464":40769,"_5":15353,"_21389":1756,"_1893":40770},[],"The quickstarts take you from a prepared instance to an active device identity. Each guide produces a verifiable result and links the detailed explanation when you need to go deeper.",{"_2303":1761,"_22650":1756,"_15464":40772,"_5":15353,"_21389":40763,"_1893":40773},[],"<Card title=\"1. Create your first CA\" description=\"Establish a root of trust capable of issuing certificates.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2303":1762,"_22650":1756,"_15464":40775,"_5":15353,"_21389":40763,"_1893":40776},[],"<Card title=\"2. Issue a certificate\" description=\"Create an X.509 identity and verify its contents.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2303":1763,"_22650":1756,"_15464":40778,"_5":15353,"_21389":40763,"_1893":40779},[],"<Card title=\"3. Register a device\" description=\"Add a device and assign it its first identity.\" href=\"/docs/platform/pki/quickstarts/register-device\" />",{"_2303":1764,"_22650":1756,"_15464":40781,"_5":15353,"_21389":40767,"_1893":40782},[],"You need access to the Lamassu IoT console and permissions to administer keys, authorities and devices. The instance must have at least one cryptographic engine configured.",{"_2303":1765,"_22650":1756,"_15464":40784,"_5":15353,"_21389":40767,"_1893":40785},[],"If you don't have an instance yet, first choose a deployment model.",{"_2303":1766,"_22650":1766,"_5":10649,"_1893":40787,"_22909":40788,"_15464":40789,"_21389":1766},"Register your first device",[35256,36391,40594],[],{"_2303":1767,"_22650":1766,"_15464":40791,"_5":15353,"_21389":1766,"_1893":40792},[],"Add a device to Lamassu and assign it an active identity.",{"_2303":1768,"_22650":1766,"_5":22906,"_15464":40794,"_21389":40795,"_1893":35266},[],"/docs/platform/pki/quickstarts/register-device#before-you-begin",{"_2303":1769,"_22650":1766,"_5":22906,"_15464":40797,"_21389":40798,"_1893":40799},[],"/docs/platform/pki/quickstarts/register-device#register-the-device","Register the device",{"_2303":1770,"_22650":1766,"_5":22906,"_15464":40801,"_21389":40802,"_1893":40803},[],"/docs/platform/pki/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_2303":1771,"_22650":1766,"_5":22906,"_15464":40805,"_21389":40806,"_1893":40807},[],"/docs/platform/pki/quickstarts/register-device#assign-an-identity","Assign an identity",{"_2303":1772,"_22650":1766,"_5":22906,"_15464":40809,"_21389":40810,"_1893":40811},[],"/docs/platform/pki/quickstarts/register-device#verify-the-device","Verify the device",{"_2303":1773,"_22650":1766,"_5":22906,"_15464":40813,"_21389":40814,"_1893":40815},[],"/docs/platform/pki/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_2303":1774,"_22650":1766,"_15464":40817,"_5":15353,"_21389":1766,"_1893":40818},[],"In this quickstart you will manually register a device and assign it its first certificate. It is the shortest path to understanding how Lamassu relates a physical entity to its identity history.",{"_2303":1775,"_22650":1766,"_15464":40820,"_5":15353,"_21389":40795,"_1893":40821},[],"A configured DMS.",{"_2303":1776,"_22650":1766,"_15464":40823,"_5":15353,"_21389":40795,"_1893":40824},[],"A CA associated with the DMS.",{"_2303":1777,"_22650":1766,"_15464":40826,"_5":15353,"_21389":40795,"_1893":40827},[],"A unique identifier for the device.",{"_2303":1778,"_22650":1766,"_15464":40829,"_5":15353,"_21389":40798,"_1893":40830},[],"Open **Managed Devices**, select the action to register a device and complete:",{"_2303":1779,"_22650":1766,"_15464":40832,"_5":15353,"_21389":40798,"_1893":40833},[],"**Device ID**: unique identifier of the device.",{"_2303":1780,"_22650":1766,"_15464":40835,"_5":15353,"_21389":40798,"_1893":40836},[],"**Registration Authority**: the DMS that will apply the enrollment policies.",{"_2303":1781,"_22650":1766,"_15464":40838,"_5":15353,"_21389":40798,"_1893":40839},[],"**Icon** and **Tags**: optional classification to locate it later.",{"_2303":1782,"_22650":1766,"_15464":40841,"_5":15353,"_21389":40802,"_1893":40842},[],"Open the newly created device. It should appear with status **No Identity**: it exists in the inventory but does not yet have an associated certificate.",{"_2303":1783,"_22650":1766,"_15464":40844,"_5":15353,"_21389":40806,"_1893":40845},[],"Select **Assign Identity**. Lamassu will search for active certificates whose `Common Name` matches the `Device ID`.",{"_2303":1784,"_22650":1766,"_15464":40847,"_5":15353,"_21389":40806,"_1893":40848},[],"Select an existing certificate or use **Issue New Instead** to issue one from a CA linked to the DMS.",{"_2303":1785,"_22650":1766,"_15464":40850,"_5":15353,"_21389":40810,"_1893":40851},[],"After confirming, the status should change to **Active**. Review **Certificate History** to check the associated identity and **Device Event Timeline** to see the assignment event.",{"_2303":1786,"_22650":1766,"_15464":40853,"_5":15353,"_21389":40814,"_1893":40854},[],"Manual registration helps you understand the model, but a fleet should use automated enrollment. Continue with Device Management Service and the EST integration.",{"_2303":1787,"_22650":1787,"_5":10649,"_1893":39550,"_22909":40856,"_15464":40857,"_21389":1787},[35256,36391,36392],[],{"_2303":1788,"_22650":1787,"_15464":40859,"_5":15353,"_21389":1787,"_1893":40860},[],"Diagnose access, health, issuance, enrollment and dependencies in a Lamassu deployment.",{"_2303":1789,"_22650":1787,"_5":22906,"_15464":40862,"_21389":40863,"_1893":40864},[],"/docs/platform/pki/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_2303":1790,"_22650":1787,"_5":22906,"_15464":40866,"_21389":40867,"_1893":40868},[],"/docs/platform/pki/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_2303":1791,"_22650":1787,"_5":22906,"_15464":40870,"_21389":40871,"_1893":40872},[],"/docs/platform/pki/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_2303":1792,"_22650":1787,"_5":22906,"_15464":40874,"_21389":40875,"_1893":40876},[],"/docs/platform/pki/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_2303":1793,"_22650":1787,"_5":22906,"_15464":40878,"_21389":40879,"_1893":40880},[],"/docs/platform/pki/troubleshooting#query-the-affected-service","Query the affected service",{"_2303":1794,"_22650":1787,"_5":22906,"_15464":40882,"_21389":40883,"_1893":40884},[],"/docs/platform/pki/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_2303":1795,"_22650":1787,"_5":22906,"_15464":40886,"_21389":40887,"_1893":40888},[],"/docs/platform/pki/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_2303":1796,"_22650":1787,"_5":22906,"_15464":40890,"_21389":40891,"_1893":40892},[],"/docs/platform/pki/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_2303":1797,"_22650":1787,"_5":22906,"_15464":40894,"_21389":40895,"_1893":40896},[],"/docs/platform/pki/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_2303":1798,"_22650":1787,"_5":22906,"_15464":40898,"_21389":40899,"_1893":40900},[],"/docs/platform/pki/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_2303":1799,"_22650":1787,"_5":22906,"_15464":40902,"_21389":40903,"_1893":40904},[],"/docs/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_2303":1800,"_22650":1787,"_5":22906,"_15464":40906,"_21389":40907,"_1893":40908},[],"/docs/platform/pki/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_2303":1801,"_22650":1787,"_5":22906,"_15464":40910,"_21389":40911,"_1893":40912},[],"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_2303":1802,"_22650":1787,"_5":22906,"_15464":40914,"_21389":40915,"_1893":40916},[],"/docs/platform/pki/troubleshooting#events-are-not-arriving","Events are not arriving",{"_2303":1803,"_22650":1787,"_5":22906,"_15464":40918,"_21389":40919,"_1893":40920},[],"/docs/platform/pki/troubleshooting#observability","Observability",{"_2303":1804,"_22650":1787,"_15464":40922,"_5":15353,"_21389":1787,"_1893":40923},[],"Start by locating the failing layer. A Gateway response, an unready pod and a rejected issuance can look like the same problem from the console, but they require different evidence.",{"_2303":1805,"_22650":1787,"_15464":40925,"_5":15353,"_21389":40867,"_1893":40926},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_2303":1806,"_22650":1787,"_15464":40928,"_5":15353,"_21389":40871,"_1893":40929},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_2303":1807,"_22650":1787,"_15464":40931,"_5":15353,"_21389":40875,"_1893":40932},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_2303":1808,"_22650":1787,"_15464":40934,"_5":15353,"_21389":40879,"_1893":40935},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_2303":1809,"_22650":1787,"_15464":40937,"_5":15353,"_21389":40883,"_1893":40938},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_2303":1810,"_22650":1787,"_15464":40940,"_5":15353,"_21389":40887,"_1893":40941},[],"Replace the placeholders with your real release, namespace and deployment.",{"_2303":1811,"_22650":1787,"_15464":40943,"_5":15353,"_21389":40887,"_1893":40944},[],"Also run the chart's connectivity test:",{"_2303":1812,"_22650":1787,"_15464":40946,"_5":15353,"_21389":40887,"_1893":40947},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_2303":1813,"_22650":1787,"_15464":40949,"_5":15353,"_21389":40887,"_1893":40950},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_2303":1814,"_22650":1787,"_15464":40952,"_5":15353,"_21389":40891,"_1893":40953},[],"If you receive a 401:",{"_2303":1815,"_22650":1787,"_15464":40955,"_5":15353,"_21389":40891,"_1893":40956},[],"check that the UI's OIDC authority is reachable from the browser;",{"_2303":1816,"_22650":1787,"_15464":40958,"_5":15353,"_21389":40891,"_1893":40959},[],"verify issuer, audience and expiration of the token;",{"_2303":1817,"_22650":1787,"_15464":40961,"_5":15353,"_21389":40891,"_1893":40962},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_2303":1818,"_22650":1787,"_15464":40964,"_5":15353,"_21389":40891,"_1893":40965},[],"check that the provider's public and internal routes point to the same realm.",{"_2303":1819,"_22650":1787,"_15464":40967,"_5":15353,"_21389":40891,"_1893":40968},[],"If login succeeds but the APIs return 403:",{"_2303":1820,"_22650":1787,"_15464":40970,"_5":15353,"_21389":40891,"_1893":40971},[],"inspect the token's real claims;",{"_2303":1821,"_22650":1787,"_15464":40973,"_5":15353,"_21389":40891,"_1893":40974},[],"confirm they match an active principal;",{"_2303":1822,"_22650":1787,"_15464":40976,"_5":15353,"_21389":40891,"_1893":40977},[],"review the policies granted to that principal;",{"_2303":1823,"_22650":1787,"_15464":40979,"_5":15353,"_21389":40891,"_1893":40980},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_2303":1824,"_22650":1787,"_15464":40982,"_5":15353,"_21389":40891,"_1893":40983},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_2303":1825,"_22650":1787,"_15464":40985,"_5":15353,"_21389":40895,"_1893":40986},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_2303":1826,"_22650":1787,"_15464":40988,"_5":15353,"_21389":40895,"_1893":40989},[],"Locate the authz pod and Service.",{"_2303":1827,"_22650":1787,"_15464":40991,"_5":15353,"_21389":40895,"_1893":40992},[],"Check /health, logs and its database connection.",{"_2303":1828,"_22650":1787,"_15464":40994,"_5":15353,"_21389":40895,"_1893":40995},[],"Verify the DNS and port configured in externalAuthorization.",{"_2303":1829,"_22650":1787,"_15464":40997,"_5":15353,"_21389":40895,"_1893":40998},[],"Check the check route is /v1/ext\\_authz/check.",{"_2303":1830,"_22650":1787,"_15464":41000,"_5":15353,"_21389":40895,"_1893":41001},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_2303":1831,"_22650":1787,"_15464":41003,"_5":15353,"_21389":40899,"_1893":41004},[],"Review kubectl describe pod first. Common causes are:",{"_2303":1832,"_22650":1787,"_15464":41006,"_5":15353,"_21389":40899,"_1893":41007},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_2303":1833,"_22650":1787,"_15464":41009,"_5":15353,"_21389":40899,"_1893":41010},[],"unbound persistent volume;",{"_2303":1834,"_22650":1787,"_15464":41012,"_5":15353,"_21389":40899,"_1893":41013},[],"inaccessible image or incorrect pull policy;",{"_2303":1835,"_22650":1787,"_15464":41015,"_5":15353,"_21389":40899,"_1893":41016},[],"invalid cryptographic engine configuration;",{"_2303":1836,"_22650":1787,"_15464":41018,"_5":15353,"_21389":40899,"_1893":41019},[],"CPU or memory limits set too low;",{"_2303":1837,"_22650":1787,"_15464":41021,"_5":15353,"_21389":40899,"_1893":41022},[],"an incomplete prior migration.",{"_2303":1838,"_22650":1787,"_15464":41024,"_5":15353,"_21389":40899,"_1893":41025},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_2303":1839,"_22650":1787,"_15464":41027,"_5":15353,"_21389":40899,"_1893":41028},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_2303":1840,"_22650":1787,"_15464":41030,"_5":15353,"_21389":40903,"_1893":41031},[],"Narrow the error following this order:",{"_2303":1841,"_22650":1787,"_15464":41033,"_5":15353,"_21389":40903,"_1893":41034},[],"The CA exists, is active and has not expired.",{"_2303":1842,"_22650":1787,"_15464":41036,"_5":15353,"_21389":40903,"_1893":41037},[],"The CA has a usable private key and the engine is available.",{"_2303":1843,"_22650":1787,"_15464":41039,"_5":15353,"_21389":40903,"_1893":41040},[],"The CSR has a valid signature.",{"_2303":1844,"_22650":1787,"_15464":41042,"_5":15353,"_21389":40903,"_1893":41043},[],"The profile allows the key type and size.",{"_2303":1845,"_22650":1787,"_15464":41045,"_5":15353,"_21389":40903,"_1893":41046},[],"The requested validity fits within the CA's lifetime.",{"_2303":1846,"_22650":1787,"_15464":41048,"_5":15353,"_21389":40903,"_1893":41049},[],"KU, EKU, subject and extensions comply with the profile.",{"_2303":1847,"_22650":1787,"_15464":41051,"_5":15353,"_21389":40903,"_1893":41052},[],"If the reissuance of a CA fails, remember it is not supported for a revoked or already-expired CA. To change its key, follow CA hierarchy and rotation.",{"_2303":1848,"_22650":1787,"_15464":41054,"_5":15353,"_21389":40907,"_1893":41055},[],"Check:",{"_2303":1849,"_22650":1787,"_15464":41057,"_5":15353,"_21389":40907,"_1893":41058},[],"the DMS identifier in the EST path;",{"_2303":1850,"_22650":1787,"_15464":41060,"_5":15353,"_21389":40907,"_1893":41061},[],"the configured authentication method;",{"_2303":1851,"_22650":1787,"_15464":41063,"_5":15353,"_21389":40907,"_1893":41064},[],"the chain presented by the client;",{"_2303":1852,"_22650":1787,"_15464":41066,"_5":15353,"_21389":40907,"_1893":41067},[],"the validation CAs and the level limit;",{"_2303":1853,"_22650":1787,"_15464":41069,"_5":15353,"_21389":40907,"_1893":41070},[],"the revocation status of the client certificate;",{"_2303":1854,"_22650":1787,"_15464":41072,"_5":15353,"_21389":40907,"_1893":41073},[],"the CSR signature;",{"_2303":1855,"_22650":1787,"_15464":41075,"_5":15353,"_21389":40907,"_1893":41076},[],"the CA and profile used for issuance;",{"_2303":1856,"_22650":1787,"_15464":41078,"_5":15353,"_21389":40907,"_1893":41079},[],"the re-enrollment window.",{"_2303":1857,"_22650":1787,"_15464":41081,"_5":15353,"_21389":40907,"_1893":41082},[],"During re-enrollment, Lamassu first tries to validate with the enrollment CA and then with the additional CAs. During a migration, keep the old CA in that second set until the overlap ends.",{"_2303":1858,"_22650":1787,"_15464":41084,"_5":15353,"_21389":40911,"_1893":41085},[],"Confirm the revocation was persisted and has reason and timestamp.",{"_2303":1859,"_22650":1787,"_15464":41087,"_5":15353,"_21389":40911,"_1893":41088},[],"Review VA configuration and logs.",{"_2303":1860,"_22650":1787,"_15464":41090,"_5":15353,"_21389":40911,"_1893":41091},[],"Check the CRL's periodicity and next update.",{"_2303":1861,"_22650":1787,"_15464":41093,"_5":15353,"_21389":40911,"_1893":41094},[],"Rule out intermediate caches in proxy and client.",{"_2303":1862,"_22650":1787,"_15464":41096,"_5":15353,"_21389":40911,"_1893":41097},[],"Verify the certificate points to the endpoint you are querying.",{"_2303":1863,"_22650":1787,"_15464":41099,"_5":15353,"_21389":40911,"_1893":41100},[],"Query by the correct serial number and issuer.",{"_2303":1864,"_22650":1787,"_15464":41102,"_5":15353,"_21389":40915,"_1893":41103},[],"Domain and audit events depend on the bus publisher:",{"_2303":1865,"_22650":1787,"_15464":41105,"_5":15353,"_21389":40915,"_1893":41106},[],"verify it is enabled in the emitting service;",{"_2303":1866,"_22650":1787,"_15464":41108,"_5":15353,"_21389":40915,"_1893":41109},[],"check AMQP connectivity and credentials;",{"_2303":1867,"_22650":1787,"_15464":41111,"_5":15353,"_21389":40915,"_1893":41112},[],"review exchange, routing key, queues and consumers;",{"_2303":1868,"_22650":1787,"_15464":41114,"_5":15353,"_21389":40915,"_1893":41115},[],"inspect dead-letter queues;",{"_2303":1869,"_22650":1787,"_15464":41117,"_5":15353,"_21389":40915,"_1893":41118},[],"alert on orphan durable queues and backlog growth.",{"_2303":1870,"_22650":1787,"_15464":41120,"_5":15353,"_21389":40915,"_1893":41121},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_2303":1871,"_22650":1787,"_15464":41123,"_5":15353,"_21389":40919,"_1893":41124},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_2303":1872,"_22650":1787,"_15464":41126,"_5":15353,"_21389":40919,"_1893":41127},[],"Before closing an incident, record:",{"_2303":1873,"_22650":1787,"_15464":41129,"_5":15353,"_21389":40919,"_1893":41130},[],"the confirmed cause;",{"_2303":1874,"_22650":1787,"_15464":41132,"_5":15353,"_21389":40919,"_1893":41133},[],"the time scope and affected resources;",{"_2303":1875,"_22650":1787,"_15464":41135,"_5":15353,"_21389":40919,"_1893":41136},[],"the commands or queries used;",{"_2303":1876,"_22650":1787,"_15464":41138,"_5":15353,"_21389":40919,"_1893":41139},[],"the applied change and how to revert it;",{"_2303":1877,"_22650":1787,"_15464":41141,"_5":15353,"_21389":40919,"_1893":41142},[],"validation from a consumer;",{"_2303":1878,"_22650":1787,"_15464":41144,"_5":15353,"_21389":40919,"_1893":41145},[],"the preventive action and its owner.",{"_2303":1879,"_22650":1879,"_5":10649,"_1893":41147,"_15464":41148,"_21389":1879},"Test",[],{"_2303":1880,"_22650":1879,"_15464":41150,"_5":15353,"_21389":1879,"_1893":41151},[],"A document to test Fumadocs",{"_2303":1881,"_22650":1879,"_5":22906,"_15464":41153,"_21389":41154,"_1893":41155},[],"/docs/test#cards","Cards",{"_2303":1882,"_22650":1879,"_5":22906,"_15464":41157,"_21389":41158,"_1893":41159},[],"/docs/test#codeblock","CodeBlock",{"_2303":1883,"_22650":1879,"_5":22906,"_15464":41161,"_21389":41162,"_1893":41163},[],"/docs/test#list","List",{"_2303":1884,"_22650":1879,"_15464":41165,"_5":15353,"_21389":1879,"_1893":41166},[],"Hey there!",{"_2303":1885,"_22650":1879,"_15464":41168,"_5":15353,"_21389":41154,"_1893":41169},[],"<Card title=\"Learn more about Next.js\" href=\"https://nextjs.org/docs\" />",{"_2303":1886,"_22650":1879,"_15464":41171,"_5":15353,"_21389":41154,"_1893":41172},[],"<Card title=\"Learn more about Fumadocs\" href=\"https://fumadocs.dev\" />",{"_2303":1887,"_22650":1879,"_15464":41174,"_5"