"_33158":47550,"_33160":47554,"_33162":47557,"_33164":47560,"_33166":47563,"_33168":47566,"_33170":47569,"_33172":47573,"_33174":47576,"_33176":47579,"_33178":47582,"_33180":47585,"_33182":47588,"_33184":47591,"_33186":47594,"_33188":47597,"_33190":47600,"_33192":47603,"_33194":47606,"_33196":47609,"_33198":47612,"_33200":47615,"_33202":47618,"_33204":47621,"_33206":47624,"_33208":47627,"_33210":47630,"_33212":47633,"_33214":47636,"_33216":47639,"_33218":47642,"_33220":47646,"_33222":47649,"_33224":47652,"_33226":47656,"_33228":47660,"_33230":47664,"_33232":47668,"_33234":47672,"_33236":47676,"_33238":47679,"_33240":47682,"_33242":47685,"_33244":47688,"_33246":47691,"_33248":47694,"_33250":47697,"_33252":47700,"_33254":47703,"_33256":47706,"_33258":47709,"_33260":47712,"_33262":47715,"_33264":47718,"_33266":47721,"_33268":47724,"_33270":47727,"_33272":47730,"_33274":47733,"_33276":47736,"_33278":47739,"_33280":47742,"_33282":47745,"_33284":47748,"_33286":47751,"_33288":47754,"_33290":47757,"_33292":47760,"_33294":47764,"_33296":47767,"_33298":47770,"_33300":47774,"_33302":47778,"_33304":47782,"_33306":47786,"_33308":47790,"_33310":47793,"_33312":47797,"_33314":47801,"_33316":47805,"_33318":47808,"_33320":47811,"_33322":47814,"_33324":47817,"_33326":47820,"_33328":47823,"_33330":47826,"_33332":47829,"_33334":47832,"_33336":47835,"_33338":47838,"_33340":47841,"_33342":47844,"_33344":47847,"_33346":47850,"_33348":47853,"_33350":47856,"_33352":47859,"_33354":47862,"_33356":47865,"_33358":47868,"_33360":47871,"_33362":47874,"_33364":47877,"_33366":47879,"_33368":47882,"_33370":47885,"_33372":47888,"_33374":47891,"_33376":47894,"_33378":47897,"_33380":47900,"_33382":47903,"_33384":47906,"_33386":47909,"_33388":47912,"_33390":47915,"_33392":47918,"_33394":47921,"_33396":47924,"_33398":47927,"_33400":47930,"_33402":47934,"_33404":47937,"_33406":47940,"_33408":47944,"_33410":47947,"_33412":47951,"_33414":47954,"_33416":47957,"_33418":47960,"_33420":47963,"_33422":47966,"_33424":47969,"_33426":47972,"_33428":47975,"_33430":47978,"_33432":47981,"_33434":47984,"_33436":47986,"_33438":47989,"_33440":47992,"_33442":47995,"_33444":47998,"_33446":48001,"_33448":48004,"_33450":48007,"_33452":48010,"_33454":48013,"_33456":48016,"_33458":48020,"_33460":48023,"_33462":48027,"_33464":48031,"_33466":48035,"_33468":48038,"_33470":48041,"_33472":48043,"_33474":48046,"_33476":48048,"_33478":48051,"_33480":48054,"_33482":48057,"_33484":48060,"_33486":48063,"_33488":48066,"_33490":48069,"_33492":48072,"_33494":48075,"_33496":48078,"_33498":48081,"_33500":48084,"_33502":48086,"_33504":48089,"_33506":48092,"_33508":48095,"_33510":48098,"_33512":48101,"_33514":48104,"_33516":48107,"_33518":48110,"_33520":48113,"_33522":48116,"_33524":48119,"_33526":48122},{"_2856":15,"_25053":15,"_5":12268,"_2383":40691,"_25368":40692,"_17489":40696,"_23720":15},"Deploy from AWS Marketplace",[40693,40694,40695],"Docs","Deployment","Other models",[],{"_2856":16,"_25053":15,"_17489":40698,"_5":17384,"_23720":15,"_2383":40699},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_2856":17,"_25053":15,"_5":25365,"_17489":40701,"_23720":40702,"_2383":40703},[],"/docs/deployment/aws-marketplace#before-you-begin","Before you begin",{"_2856":18,"_25053":15,"_5":25365,"_17489":40705,"_23720":40706,"_2383":40707},[],"/docs/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_2856":19,"_25053":15,"_5":25365,"_17489":40709,"_23720":40710,"_2383":40711},[],"/docs/deployment/aws-marketplace#open-the-offer","Open the offer",{"_2856":20,"_25053":15,"_5":25365,"_17489":40713,"_23720":40714,"_2383":40715},[],"/docs/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_2856":21,"_25053":15,"_5":25365,"_17489":40717,"_23720":40718,"_2383":40719},[],"/docs/deployment/aws-marketplace#limit-network-access","Limit network access",{"_2856":22,"_25053":15,"_5":25365,"_17489":40721,"_23720":40722,"_2383":40723},[],"/docs/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_2856":23,"_25053":15,"_5":25365,"_17489":40725,"_23720":40726,"_2383":40727},[],"/docs/deployment/aws-marketplace#next-step","Next step",{"_2856":24,"_25053":15,"_17489":40729,"_5":17384,"_23720":15,"_2383":40730},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_2856":25,"_25053":15,"_17489":40732,"_5":17384,"_23720":40702,"_2383":40733},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_2856":26,"_25053":15,"_17489":40735,"_5":17384,"_23720":40702,"_2383":40736},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_2856":27,"_25053":15,"_17489":40738,"_5":17384,"_23720":40702,"_2383":40739},[],"A security group allowing the necessary endpoints.",{"_2856":28,"_25053":15,"_17489":40741,"_5":17384,"_23720":40706,"_2383":40742},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_2856":29,"_25053":15,"_17489":40744,"_5":17384,"_23720":40706,"_2383":40745},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_2856":30,"_25053":15,"_17489":40747,"_5":17384,"_23720":40706,"_2383":40748},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_2856":31,"_25053":15,"_17489":40750,"_5":17384,"_23720":40710,"_2383":40751},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_2856":32,"_25053":15,"_17489":40753,"_5":17384,"_23720":40714,"_2383":40754},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_2856":33,"_25053":15,"_17489":40756,"_5":17384,"_23720":40718,"_2383":40757},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_2856":34,"_25053":15,"_17489":40759,"_5":17384,"_23720":40722,"_2383":40760},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_2856":35,"_25053":15,"_17489":40762,"_5":17384,"_23720":40726,"_2383":40763},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_2856":36,"_25053":36,"_5":12268,"_2383":40765,"_25368":40766,"_17489":40767,"_23720":36},"Deploy Lamassu",[40693,40694],[],{"_2856":37,"_25053":36,"_17489":40769,"_5":17384,"_23720":36,"_2383":40770},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_2856":38,"_25053":36,"_5":25365,"_17489":40772,"_23720":40773,"_2383":40774},[],"/docs/deployment/overview#choose-a-model","Choose a model",{"_2856":39,"_25053":36,"_5":25365,"_17489":40776,"_23720":40777,"_2383":40778},[],"/docs/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_2856":40,"_25053":36,"_5":25365,"_17489":40780,"_23720":40781,"_2383":40782},[],"/docs/deployment/overview#after-deployment","After deployment",{"_2856":41,"_25053":36,"_17489":40784,"_5":17384,"_23720":36,"_2383":40785},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_2856":42,"_25053":36,"_17489":40787,"_5":17384,"_23720":40773,"_2383":40788},[],"Model",{"_2856":43,"_25053":36,"_17489":40790,"_5":17384,"_23720":40773,"_2383":40791},[],"Recommended for",{"_2856":44,"_25053":36,"_17489":40793,"_5":17384,"_23720":40773,"_2383":40794},[],"Who operates the infrastructure",{"_2856":45,"_25053":36,"_17489":40796,"_5":17384,"_23720":40773,"_2383":40797},[],"Starting point",{"_2856":46,"_25053":36,"_17489":40799,"_5":17384,"_23720":40773,"_2383":40800},[],"Kubernetes self-managed",{"_2856":47,"_25053":36,"_17489":40802,"_5":17384,"_23720":40773,"_2383":40803},[],"Production, regulated environments and custom deployments",{"_2856":48,"_25053":36,"_17489":40805,"_5":17384,"_23720":40773,"_2383":40806},[],"Your team",{"_2856":49,"_25053":36,"_17489":40808,"_5":17384,"_23720":40773,"_2383":40809},[],"Helm or Fastlane",{"_2856":50,"_25053":36,"_17489":40811,"_5":17384,"_23720":40773,"_2383":40812},[],"AWS Marketplace",{"_2856":51,"_25053":36,"_17489":40814,"_5":17384,"_23720":40773,"_2383":40815},[],"Evaluation or a dedicated deployment inside an AWS account",{"_2856":52,"_25053":36,"_17489":40817,"_5":17384,"_23720":40773,"_2383":40806},[],{"_2856":53,"_25053":36,"_17489":40819,"_5":17384,"_23720":40773,"_2383":40820},[],"Preconfigured image on EC2",{"_2856":54,"_25053":36,"_17489":40822,"_5":17384,"_23720":40773,"_2383":40823},[],"SaaS",{"_2856":55,"_25053":36,"_17489":40825,"_5":17384,"_23720":40773,"_2383":40826},[],"Teams that want to use the platform without operating it",{"_2856":56,"_25053":36,"_17489":40828,"_5":17384,"_23720":40773,"_2383":40829},[],"Lamassu",{"_2856":57,"_25053":36,"_17489":40831,"_5":17384,"_23720":40773,"_2383":40832},[],"Managed subscription",{"_2856":58,"_25053":36,"_17489":40834,"_5":17384,"_23720":40773,"_2383":40835},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2856":59,"_25053":36,"_17489":40837,"_5":17384,"_23720":40773,"_2383":40838},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2856":60,"_25053":36,"_17489":40840,"_5":17384,"_23720":40773,"_2383":40841},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_2856":61,"_25053":36,"_17489":40843,"_5":17384,"_23720":40777,"_2383":40844},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_2856":62,"_25053":36,"_17489":40846,"_5":17384,"_23720":40781,"_2383":40847},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_2856":63,"_25053":63,"_5":12268,"_2383":40849,"_25368":40850,"_17489":40851,"_23720":63},"Use Lamassu as SaaS",[40693,40694,40695],[],{"_2856":64,"_25053":63,"_17489":40853,"_5":17384,"_23720":63,"_2383":40854},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_2856":65,"_25053":63,"_5":25365,"_17489":40856,"_23720":40857,"_2383":40858},[],"/docs/deployment/saas#what-the-service-manages","What the service manages",{"_2856":66,"_25053":63,"_5":25365,"_17489":40860,"_23720":40861,"_2383":40862},[],"/docs/deployment/saas#plans","Plans",{"_2856":67,"_25053":63,"_5":25365,"_17489":40864,"_23720":40865,"_2383":40866},[],"/docs/deployment/saas#request-access","Request access",{"_2856":68,"_25053":63,"_17489":40868,"_5":17384,"_23720":63,"_2383":40869},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_2856":69,"_25053":63,"_17489":40871,"_5":17384,"_23720":40857,"_2383":40872},[],"Platform availability and maintenance.",{"_2856":70,"_25053":63,"_17489":40874,"_5":17384,"_23720":40857,"_2383":40875},[],"Automatic backups.",{"_2856":71,"_25053":63,"_17489":40877,"_5":17384,"_23720":40857,"_2383":40878},[],"Version upgrades.",{"_2856":72,"_25053":63,"_17489":40880,"_5":17384,"_23720":40857,"_2383":40881},[],"Technical support and SLA according to your plan.",{"_2856":73,"_25053":63,"_17489":40883,"_5":17384,"_23720":40861,"_2383":40884},[],"Plan",{"_2856":74,"_25053":63,"_17489":40886,"_5":17384,"_23720":40861,"_2383":40887},[],"Devices",{"_2856":75,"_25053":63,"_17489":40889,"_5":17384,"_23720":40861,"_2383":40890},[],"Support",{"_2856":76,"_25053":63,"_17489":40892,"_5":17384,"_23720":40861,"_2383":40893},[],"SLA",{"_2856":77,"_25053":63,"_17489":40895,"_5":17384,"_23720":40861,"_2383":40896},[],"Starter",{"_2856":78,"_25053":63,"_17489":40898,"_5":17384,"_23720":40861,"_2383":40899},[],"Up to 1,000",{"_2856":79,"_25053":63,"_17489":40901,"_5":17384,"_23720":40861,"_2383":40902},[],"Email",{"_2856":80,"_25053":63,"_17489":40904,"_5":17384,"_23720":40861,"_2383":40905},[],"99.5 %",{"_2856":81,"_25053":63,"_17489":40907,"_5":17384,"_23720":40861,"_2383":40908},[],"Professional",{"_2856":82,"_25053":63,"_17489":40910,"_5":17384,"_23720":40861,"_2383":40911},[],"Up to 10,000",{"_2856":83,"_25053":63,"_17489":40913,"_5":17384,"_23720":40861,"_2383":40914},[],"Email and chat",{"_2856":84,"_25053":63,"_17489":40916,"_5":17384,"_23720":40861,"_2383":40917},[],"99.9 %",{"_2856":85,"_25053":63,"_17489":40919,"_5":17384,"_23720":40861,"_2383":40920},[],"Enterprise",{"_2856":86,"_25053":63,"_17489":40922,"_5":17384,"_23720":40861,"_2383":40923},[],"Unlimited",{"_2856":87,"_25053":63,"_17489":40925,"_5":17384,"_23720":40861,"_2383":40926},[],"Dedicated",{"_2856":88,"_25053":63,"_17489":40928,"_5":17384,"_23720":40861,"_2383":40929},[],"99.99 %",{"_2856":89,"_25053":63,"_17489":40931,"_5":17384,"_23720":40865,"_2383":40932},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_2856":90,"_25053":63,"_17489":40934,"_5":17384,"_23720":40865,"_2383":40935},[],"When you receive your instance's credentials, continue with Get started.",{"_2856":91,"_25053":91,"_5":12268,"_2383":40937,"_25368":40938,"_17489":40939,"_23720":91},"Fastlane",[40693,40694,40800],[],{"_2856":92,"_25053":91,"_17489":40941,"_5":17384,"_23720":91,"_2383":40942},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_2856":93,"_25053":91,"_5":25365,"_17489":40944,"_23720":40945,"_2383":40946},[],"/docs/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_2856":94,"_25053":91,"_5":25365,"_17489":40948,"_23720":40949,"_2383":40950},[],"/docs/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_2856":95,"_25053":91,"_5":25365,"_17489":40952,"_23720":40953,"_2383":40703},[],"/docs/deployment/self-hosted/fastlane#before-you-begin",{"_2856":96,"_25053":91,"_5":25365,"_17489":40955,"_23720":40956,"_2383":40957},[],"/docs/deployment/self-hosted/fastlane#quick-start","Quick start",{"_2856":97,"_25053":91,"_5":25365,"_17489":40959,"_23720":40960,"_2383":40961},[],"/docs/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_2856":98,"_25053":91,"_5":25365,"_17489":40963,"_23720":40964,"_2383":40965},[],"/docs/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_2856":99,"_25053":91,"_5":25365,"_17489":40967,"_23720":40968,"_2383":40969},[],"/docs/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_2856":100,"_25053":91,"_5":25365,"_17489":40971,"_23720":40972,"_2383":40973},[],"/docs/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_2856":101,"_25053":91,"_5":25365,"_17489":40975,"_23720":40976,"_2383":40977},[],"/docs/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_2856":102,"_25053":91,"_5":25365,"_17489":40979,"_23720":40980,"_2383":40981},[],"/docs/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_2856":103,"_25053":91,"_17489":40983,"_5":17384,"_23720":40945,"_2383":40984},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_2856":104,"_25053":91,"_17489":40986,"_5":17384,"_23720":40945,"_2383":40987},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_2856":105,"_25053":91,"_17489":40989,"_5":17384,"_23720":40949,"_2383":40990},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_2856":106,"_25053":91,"_17489":40992,"_5":17384,"_23720":40949,"_2383":40993},[],"Fastlane installs or configures",{"_2856":107,"_25053":91,"_17489":40995,"_5":17384,"_23720":40949,"_2383":40996},[],"You still provide",{"_2856":108,"_25053":91,"_17489":40998,"_5":17384,"_23720":40949,"_2383":40999},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_2856":109,"_25053":91,"_17489":41001,"_5":17384,"_23720":40949,"_2383":41002},[],"The Kubernetes cluster, nodes and persistent storage",{"_2856":110,"_25053":91,"_17489":41004,"_5":17384,"_23720":40949,"_2383":41005},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_2856":111,"_25053":91,"_17489":41007,"_5":17384,"_23720":40949,"_2383":41008},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_2856":112,"_25053":91,"_17489":41010,"_5":17384,"_23720":40949,"_2383":41011},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_2856":113,"_25053":91,"_17489":41013,"_5":17384,"_23720":40949,"_2383":41014},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_2856":114,"_25053":91,"_17489":41016,"_5":17384,"_23720":40949,"_2383":41017},[],"Optional observability and lab HSM components",{"_2856":115,"_25053":91,"_17489":41019,"_5":17384,"_23720":40949,"_2383":41020},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_2856":116,"_25053":91,"_17489":41022,"_5":17384,"_23720":40949,"_2383":41023},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_2856":117,"_25053":91,"_17489":41025,"_5":17384,"_23720":40953,"_2383":41026},[],"You need:",{"_2856":118,"_25053":91,"_17489":41028,"_5":17384,"_23720":40953,"_2383":41029},[],"an existing Kubernetes cluster",{"_2856":119,"_25053":91,"_17489":41031,"_5":17384,"_23720":40953,"_2383":41032},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_2856":120,"_25053":91,"_17489":41034,"_5":17384,"_23720":40953,"_2383":41035},[],"`yq`",{"_2856":121,"_25053":91,"_17489":41037,"_5":17384,"_23720":40953,"_2383":19794},[],{"_2856":122,"_25053":91,"_17489":41039,"_5":17384,"_23720":40953,"_2383":41040},[],"`jq` only when using `--sample-data`",{"_2856":123,"_25053":91,"_17489":41042,"_5":17384,"_23720":40953,"_2383":41043},[],"free external ports 80 and 443 on a single-node K3s host",{"_2856":124,"_25053":91,"_17489":41045,"_5":17384,"_23720":40953,"_2383":41046},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_2856":125,"_25053":91,"_17489":41048,"_5":17384,"_23720":40953,"_2383":41049},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_2856":126,"_25053":91,"_17489":41051,"_5":17384,"_23720":40956,"_2383":41052},[],"Run the script from a clone of the Helm repository:",{"_2856":127,"_25053":91,"_17489":41054,"_5":17384,"_23720":40956,"_2383":41055},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_2856":128,"_25053":91,"_17489":41057,"_5":17384,"_23720":40960,"_2383":41058},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_2856":129,"_25053":91,"_17489":41060,"_5":17384,"_23720":40960,"_2383":41061},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_2856":130,"_25053":91,"_17489":41063,"_5":17384,"_23720":40960,"_2383":41064},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_2856":131,"_25053":91,"_17489":41066,"_5":17384,"_23720":40960,"_2383":41067},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_2856":132,"_25053":91,"_17489":41069,"_5":17384,"_23720":40964,"_2383":41070},[],"Option",{"_2856":133,"_25053":91,"_17489":41072,"_5":17384,"_23720":40964,"_2383":41073},[],"Default",{"_2856":134,"_25053":91,"_17489":41075,"_5":17384,"_23720":40964,"_2383":41076},[],"Purpose",{"_2856":135,"_25053":91,"_17489":41078,"_5":17384,"_23720":40964,"_2383":41079},[],"`-h`, `--help`",{"_2856":136,"_25053":91,"_17489":41081,"_5":17384,"_23720":40964,"_2383":41082},[],"—",{"_2856":137,"_25053":91,"_17489":41084,"_5":17384,"_23720":40964,"_2383":41085},[],"Show help",{"_2856":138,"_25053":91,"_17489":41087,"_5":17384,"_23720":40964,"_2383":41088},[],"`-c`, `--context`",{"_2856":139,"_25053":91,"_17489":41090,"_5":17384,"_23720":40964,"_2383":41091},[],"current context",{"_2856":140,"_25053":91,"_17489":41093,"_5":17384,"_23720":40964,"_2383":41094},[],"Select the kubeconfig context for kubectl and Helm",{"_2856":141,"_25053":91,"_17489":41096,"_5":17384,"_23720":40964,"_2383":41097},[],"`-n`, `--non-interactive`",{"_2856":142,"_25053":91,"_17489":41099,"_5":17384,"_23720":40964,"_2383":5347},[],{"_2856":143,"_25053":91,"_17489":41101,"_5":17384,"_23720":40964,"_2383":41102},[],"Skip prompts and generate dependency credentials",{"_2856":144,"_25053":91,"_17489":41104,"_5":17384,"_23720":40964,"_2383":41105},[],"`-ns`, `--namespace`",{"_2856":145,"_25053":91,"_17489":41107,"_5":17384,"_23720":40964,"_2383":41108},[],"`lamassu-dev`",{"_2856":146,"_25053":91,"_17489":41110,"_5":17384,"_23720":40964,"_2383":41111},[],"Namespace for the installation",{"_2856":147,"_25053":91,"_17489":41113,"_5":17384,"_23720":40964,"_2383":41114},[],"`-d`, `--domain`",{"_2856":148,"_25053":91,"_17489":41116,"_5":17384,"_23720":40964,"_2383":41117},[],"`dev.lamassu.io`",{"_2856":149,"_25053":91,"_17489":41119,"_5":17384,"_23720":40964,"_2383":41120},[],"Domain used by the UI, OIDC and certificate",{"_2856":150,"_25053":91,"_17489":41122,"_5":17384,"_23720":40964,"_2383":41123},[],"`-v`, `--version`",{"_2856":151,"_25053":91,"_17489":41125,"_5":17384,"_23720":40964,"_2383":12494},[],{"_2856":152,"_25053":91,"_17489":41127,"_5":17384,"_23720":40964,"_2383":41128},[],"Lamassu chart version",{"_2856":153,"_25053":91,"_17489":41130,"_5":17384,"_23720":40964,"_2383":41131},[],"`--https-port`",{"_2856":154,"_25053":91,"_17489":41133,"_5":17384,"_23720":40964,"_2383":41134},[],"`443`",{"_2856":155,"_25053":91,"_17489":41136,"_5":17384,"_23720":40964,"_2383":41137},[],"Gateway HTTPS listener port",{"_2856":156,"_25053":91,"_17489":41139,"_5":17384,"_23720":40964,"_2383":41140},[],"`--http-port`",{"_2856":157,"_25053":91,"_17489":41142,"_5":17384,"_23720":40964,"_2383":41143},[],"`80`",{"_2856":158,"_25053":91,"_17489":41145,"_5":17384,"_23720":40964,"_2383":41146},[],"Gateway HTTP listener port",{"_2856":159,"_25053":91,"_17489":41148,"_5":17384,"_23720":40964,"_2383":41149},[],"`--tls-crt`",{"_2856":160,"_25053":91,"_17489":41151,"_5":17384,"_23720":40964,"_2383":41082},[],{"_2856":161,"_25053":91,"_17489":41153,"_5":17384,"_23720":40964,"_2383":41154},[],"PEM certificate for downstream TLS",{"_2856":162,"_25053":91,"_17489":41156,"_5":17384,"_23720":40964,"_2383":41157},[],"`--tls-key`",{"_2856":163,"_25053":91,"_17489":41159,"_5":17384,"_23720":40964,"_2383":41082},[],{"_2856":164,"_25053":91,"_17489":41161,"_5":17384,"_23720":40964,"_2383":41162},[],"PEM private key for downstream TLS",{"_2856":165,"_25053":91,"_17489":41164,"_5":17384,"_23720":40964,"_2383":41165},[],"`-l`, `--local-chart-path`",{"_2856":166,"_25053":91,"_17489":41167,"_5":17384,"_23720":40964,"_2383":41168},[],"repository chart",{"_2856":167,"_25053":91,"_17489":41170,"_5":17384,"_23720":40964,"_2383":41171},[],"Use an unpacked local Lamassu chart",{"_2856":168,"_25053":91,"_17489":41173,"_5":17384,"_23720":40964,"_2383":41174},[],"`-ip`, `--gateway-ip`",{"_2856":169,"_25053":91,"_17489":41176,"_5":17384,"_23720":40964,"_2383":7252},[],{"_2856":170,"_25053":91,"_17489":41178,"_5":17384,"_23720":40964,"_2383":41179},[],"Override the address written to `gateway.addresses`",{"_2856":171,"_25053":91,"_17489":41181,"_5":17384,"_23720":40964,"_2383":41182},[],"`--otel`",{"_2856":172,"_25053":91,"_17489":41184,"_5":17384,"_23720":40964,"_2383":5347},[],{"_2856":173,"_25053":91,"_17489":41186,"_5":17384,"_23720":40964,"_2383":41187},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_2856":174,"_25053":91,"_17489":41189,"_5":17384,"_23720":40964,"_2383":41190},[],"`--sample-data`",{"_2856":175,"_25053":91,"_17489":41192,"_5":17384,"_23720":40964,"_2383":5347},[],{"_2856":176,"_25053":91,"_17489":41194,"_5":17384,"_23720":40964,"_2383":41195},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_2856":177,"_25053":91,"_17489":41197,"_5":17384,"_23720":40964,"_2383":41198},[],"`--with-hsm`",{"_2856":178,"_25053":91,"_17489":41200,"_5":17384,"_23720":40964,"_2383":5347},[],{"_2856":179,"_25053":91,"_17489":41202,"_5":17384,"_23720":40964,"_2383":41203},[],"Install lab HSM components and configure KMS for PKCS#11",{"_2856":180,"_25053":91,"_17489":41205,"_5":17384,"_23720":40964,"_2383":41206},[],"`--softhsm-chart-path`",{"_2856":181,"_25053":91,"_17489":41208,"_5":17384,"_23720":40964,"_2383":41209},[],"`./charts/softhsm`",{"_2856":182,"_25053":91,"_17489":41211,"_5":17384,"_23720":40964,"_2383":41212},[],"Use a different local SoftHSM chart",{"_2856":183,"_25053":91,"_17489":41214,"_5":17384,"_23720":40964,"_2383":41215},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_2856":184,"_25053":91,"_17489":41217,"_5":17384,"_23720":40968,"_2383":41218},[],"Fastlane:",{"_2856":185,"_25053":91,"_17489":41220,"_5":17384,"_23720":40968,"_2383":41221},[],"validates local tools and the selected cluster",{"_2856":186,"_25053":91,"_17489":41223,"_5":17384,"_23720":40968,"_2383":41224},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_2856":187,"_25053":91,"_17489":41226,"_5":17384,"_23720":40968,"_2383":41227},[],"creates the namespace",{"_2856":188,"_25053":91,"_17489":41229,"_5":17384,"_23720":40968,"_2383":41230},[],"installs PostgreSQL and creates the required databases",{"_2856":189,"_25053":91,"_17489":41232,"_5":17384,"_23720":40968,"_2383":41233},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_2856":190,"_25053":91,"_17489":41235,"_5":17384,"_23720":40968,"_2383":41236},[],"installs RabbitMQ",{"_2856":191,"_25053":91,"_17489":41238,"_5":17384,"_23720":40968,"_2383":41239},[],"optionally installs observability and lab HSM components",{"_2856":192,"_25053":91,"_17489":41241,"_5":17384,"_23720":40968,"_2383":41242},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_2856":193,"_25053":91,"_17489":41244,"_5":17384,"_23720":40968,"_2383":41245},[],"optionally loads sample data",{"_2856":194,"_25053":91,"_17489":41247,"_5":17384,"_23720":40968,"_2383":41248},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_2856":195,"_25053":91,"_17489":41250,"_5":17384,"_23720":40972,"_2383":41251},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_2856":196,"_25053":91,"_17489":41253,"_5":17384,"_23720":40972,"_2383":41254},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_2856":197,"_25053":91,"_17489":41256,"_5":17384,"_23720":40976,"_2383":41257},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use.",{"_2856":198,"_25053":91,"_17489":41259,"_5":17384,"_23720":40976,"_2383":41260},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_2856":199,"_25053":91,"_17489":41262,"_5":17384,"_23720":40976,"_2383":41263},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_2856":200,"_25053":91,"_17489":41265,"_5":17384,"_23720":40980,"_2383":41266},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_2856":201,"_25053":201,"_5":12268,"_2383":41268,"_25368":41269,"_17489":41270,"_23720":201},"Install with Helm",[40693,40694,40800],[],{"_2856":202,"_25053":201,"_17489":41272,"_5":17384,"_23720":201,"_2383":41273},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_2856":203,"_25053":201,"_5":25365,"_17489":41275,"_23720":41276,"_2383":41277},[],"/docs/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_2856":204,"_25053":201,"_5":25365,"_17489":41279,"_23720":41280,"_2383":40703},[],"/docs/deployment/self-hosted/helm#before-you-begin",{"_2856":205,"_25053":201,"_5":25365,"_17489":41282,"_23720":41283,"_2383":41284},[],"/docs/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_2856":206,"_25053":201,"_5":25365,"_17489":41286,"_23720":41287,"_2383":41288},[],"/docs/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_2856":207,"_25053":201,"_5":25365,"_17489":41290,"_23720":41291,"_2383":41292},[],"/docs/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_2856":208,"_25053":201,"_5":25365,"_17489":41294,"_23720":41295,"_2383":41296},[],"/docs/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_2856":209,"_25053":201,"_5":25365,"_17489":41298,"_23720":41299,"_2383":41300},[],"/docs/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_2856":210,"_25053":201,"_5":25365,"_17489":41302,"_23720":41303,"_2383":41304},[],"/docs/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_2856":211,"_25053":201,"_5":25365,"_17489":41306,"_23720":41307,"_2383":41308},[],"/docs/deployment/self-hosted/helm#production-decisions","Production decisions",{"_2856":212,"_25053":201,"_17489":41310,"_5":17384,"_23720":41276,"_2383":41311},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_2856":213,"_25053":201,"_17489":41313,"_5":17384,"_23720":41280,"_2383":41314},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_2856":214,"_25053":201,"_17489":41316,"_5":17384,"_23720":41280,"_2383":41317},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_2856":215,"_25053":201,"_17489":41319,"_5":17384,"_23720":41280,"_2383":41320},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_2856":216,"_25053":201,"_17489":41322,"_5":17384,"_23720":41280,"_2383":41323},[],"a reachable RabbitMQ broker and credentials",{"_2856":217,"_25053":201,"_17489":41325,"_5":17384,"_23720":41280,"_2383":41326},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_2856":218,"_25053":201,"_17489":41328,"_5":17384,"_23720":41280,"_2383":41329},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_2856":219,"_25053":201,"_17489":41331,"_5":17384,"_23720":41280,"_2383":41332},[],"cert-manager 1.14+; for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_2856":220,"_25053":201,"_17489":41334,"_5":17384,"_23720":41280,"_2383":41335},[],"a StorageClass and an external traffic design",{"_2856":221,"_25053":201,"_17489":41337,"_5":17384,"_23720":41280,"_2383":41338},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_2856":222,"_25053":201,"_17489":41340,"_5":17384,"_23720":41280,"_2383":41341},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_2856":223,"_25053":201,"_17489":41343,"_5":17384,"_23720":41280,"_2383":41344},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_2856":224,"_25053":201,"_17489":41346,"_5":17384,"_23720":41283,"_2383":41347},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_2856":225,"_25053":201,"_17489":41349,"_5":17384,"_23720":41283,"_2383":41350},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_2856":226,"_25053":201,"_17489":41352,"_5":17384,"_23720":41283,"_2383":41353},[],"Install cert-manager separately before Lamassu. The current chart renders its self-signed issuer and CA certificate resources even when `tls.type: external` makes the Gateway use an existing TLS Secret. Selecting external TLS therefore does not remove the cert-manager prerequisite.",{"_2856":227,"_25053":201,"_17489":41355,"_5":17384,"_23720":41287,"_2383":41356},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_2856":228,"_25053":201,"_17489":41358,"_5":17384,"_23720":41287,"_2383":41359},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_2856":229,"_25053":201,"_17489":41361,"_5":17384,"_23720":41287,"_2383":41362},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_2856":230,"_25053":201,"_17489":41364,"_5":17384,"_23720":41291,"_2383":41365},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it:",{"_2856":231,"_25053":201,"_17489":41367,"_5":17384,"_23720":41295,"_2383":41368},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_2856":232,"_25053":201,"_17489":41370,"_5":17384,"_23720":41295,"_2383":41371},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_2856":233,"_25053":201,"_17489":41373,"_5":17384,"_23720":41295,"_2383":41374},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_2856":234,"_25053":201,"_17489":41376,"_5":17384,"_23720":41295,"_2383":41377},[],"See Access control for the principal and policy model.",{"_2856":235,"_25053":201,"_17489":41379,"_5":17384,"_23720":41299,"_2383":41380},[],"To install a local checkout instead:",{"_2856":236,"_25053":201,"_17489":41382,"_5":17384,"_23720":41303,"_2383":41383},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_2856":237,"_25053":201,"_17489":41385,"_5":17384,"_23720":41303,"_2383":41386},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_2856":238,"_25053":201,"_17489":41388,"_5":17384,"_23720":41307,"_2383":41389},[],"Before going live, review:",{"_2856":239,"_25053":201,"_17489":41391,"_5":17384,"_23720":41307,"_2383":41392},[],"backup and recovery for PostgreSQL and persistent volumes",{"_2856":240,"_25053":201,"_17489":41394,"_5":17384,"_23720":41307,"_2383":41395},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_2856":241,"_25053":201,"_17489":41397,"_5":17384,"_23720":41307,"_2383":41398},[],"shared VA storage before increasing VA replicas",{"_2856":242,"_25053":201,"_17489":41400,"_5":17384,"_23720":41307,"_2383":41401},[],"managed OIDC roles and removal of evaluation credentials",{"_2856":243,"_25053":201,"_17489":41403,"_5":17384,"_23720":41307,"_2383":41404},[],"a trusted TLS issuer or externally managed certificate",{"_2856":244,"_25053":201,"_17489":41406,"_5":17384,"_23720":41307,"_2383":41407},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_2856":245,"_25053":201,"_17489":41409,"_5":17384,"_23720":41307,"_2383":41410},[],"SMTP, observability and alert delivery",{"_2856":246,"_25053":201,"_17489":41412,"_5":17384,"_23720":41307,"_2383":41413},[],"the migration notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_2856":247,"_25053":201,"_17489":41415,"_5":17384,"_23720":41307,"_2383":41416},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_2856":248,"_25053":248,"_5":12268,"_2383":41418,"_25368":41419,"_17489":41420,"_23720":248},"Expose the Gateway",[40693,40694,40800],[],{"_2856":249,"_25053":248,"_17489":41422,"_5":17384,"_23720":248,"_2383":41423},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_2856":250,"_25053":248,"_5":25365,"_17489":41425,"_23720":41426,"_2383":41427},[],"/docs/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_2856":251,"_25053":248,"_5":25365,"_17489":41429,"_23720":41430,"_2383":41431},[],"/docs/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_2856":252,"_25053":248,"_5":25365,"_17489":41433,"_23720":41434,"_2383":41435},[],"/docs/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_2856":253,"_25053":248,"_5":25365,"_17489":41437,"_23720":41438,"_2383":41439},[],"/docs/deployment/self-hosted/networking#k3s","K3s",{"_2856":254,"_25053":248,"_5":25365,"_17489":41441,"_23720":41442,"_2383":41443},[],"/docs/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_2856":255,"_25053":248,"_5":25365,"_17489":41445,"_23720":41446,"_2383":41447},[],"/docs/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_2856":256,"_25053":248,"_5":25365,"_17489":41449,"_23720":41450,"_2383":41451},[],"/docs/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_2856":257,"_25053":248,"_5":25365,"_17489":41453,"_23720":41454,"_2383":41455},[],"/docs/deployment/self-hosted/networking#decision-guide","Decision guide",{"_2856":258,"_25053":248,"_5":25365,"_17489":41457,"_23720":41458,"_2383":41459},[],"/docs/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_2856":259,"_25053":248,"_17489":41461,"_5":17384,"_23720":41426,"_2383":41462},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_2856":260,"_25053":248,"_17489":41464,"_5":17384,"_23720":41426,"_2383":41465},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_2856":261,"_25053":248,"_17489":41467,"_5":17384,"_23720":41430,"_2383":41468},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_2856":262,"_25053":248,"_17489":41470,"_5":17384,"_23720":41430,"_2383":41471},[],"Set it only when:",{"_2856":263,"_25053":248,"_17489":41473,"_5":17384,"_23720":41430,"_2383":41474},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_2856":264,"_25053":248,"_17489":41476,"_5":17384,"_23720":41430,"_2383":41477},[],"that address is allocated to this Gateway",{"_2856":265,"_25053":248,"_17489":41479,"_5":17384,"_23720":41430,"_2383":41480},[],"the surrounding network already routes traffic for it to the cluster",{"_2856":266,"_25053":248,"_17489":41482,"_5":17384,"_23720":41430,"_2383":41483},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_2856":267,"_25053":248,"_17489":41485,"_5":17384,"_23720":41430,"_2383":41486},[],"Keep these two settings separate:",{"_2856":268,"_25053":248,"_17489":41488,"_5":17384,"_23720":41430,"_2383":41489},[],"`gateway.addresses` requests an address for the Gateway.",{"_2856":269,"_25053":248,"_17489":41491,"_5":17384,"_23720":41430,"_2383":41492},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_2856":270,"_25053":248,"_17489":41494,"_5":17384,"_23720":41430,"_2383":41495},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_2856":271,"_25053":248,"_17489":41497,"_5":17384,"_23720":41434,"_2383":41498},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_2856":272,"_25053":248,"_17489":41500,"_5":17384,"_23720":41434,"_2383":41501},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_2856":273,"_25053":248,"_17489":41503,"_5":17384,"_23720":41438,"_2383":41504},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_2856":274,"_25053":248,"_17489":41506,"_5":17384,"_23720":41438,"_2383":41507},[],"For the recommended design:",{"_2856":275,"_25053":248,"_17489":41509,"_5":17384,"_23720":41438,"_2383":41510},[],"Use only one externally exposed Lamassu Gateway.",{"_2856":276,"_25053":248,"_17489":41512,"_5":17384,"_23720":41438,"_2383":41513},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_2856":277,"_25053":248,"_17489":41515,"_5":17384,"_23720":41438,"_2383":41516},[],"Allow those ports through the VM firewall and any upstream security group.",{"_2856":278,"_25053":248,"_17489":41518,"_5":17384,"_23720":41438,"_2383":41519},[],"Point DNS at the VM's reachable address.",{"_2856":279,"_25053":248,"_17489":41521,"_5":17384,"_23720":41438,"_2383":41522},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_2856":280,"_25053":248,"_17489":41524,"_5":17384,"_23720":41442,"_2383":41525},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_2856":281,"_25053":248,"_17489":41527,"_5":17384,"_23720":41446,"_2383":41528},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_2856":282,"_25053":248,"_17489":41530,"_5":17384,"_23720":41446,"_2383":41531},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_2856":283,"_25053":248,"_17489":41533,"_5":17384,"_23720":41450,"_2383":41534},[],"First decide whether you need three independent data planes or only three hostnames.",{"_2856":284,"_25053":248,"_17489":41536,"_5":17384,"_23720":41450,"_2383":41537},[],"Requirement",{"_2856":285,"_25053":248,"_17489":41539,"_5":17384,"_23720":41450,"_2383":41540},[],"Recommended design",{"_2856":286,"_25053":248,"_17489":41542,"_5":17384,"_23720":41450,"_2383":41543},[],"Consequence",{"_2856":287,"_25053":248,"_17489":41545,"_5":17384,"_23720":41450,"_2383":41546},[],"Several Lamassu URLs or services",{"_2856":288,"_25053":248,"_17489":41548,"_5":17384,"_23720":41450,"_2383":41549},[],"One Gateway with multiple routes",{"_2856":289,"_25053":248,"_17489":41551,"_5":17384,"_23720":41450,"_2383":41552},[],"One IP and one proxy fleet; this is the chart default",{"_2856":290,"_25053":248,"_17489":41554,"_5":17384,"_23720":41450,"_2383":41555},[],"Independent Gateways and separate external IPs",{"_2856":291,"_25053":248,"_17489":41557,"_5":17384,"_23720":41450,"_2383":41558},[],"One VIP per Gateway",{"_2856":292,"_25053":248,"_17489":41560,"_5":17384,"_23720":41450,"_2383":41561},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_2856":293,"_25053":248,"_17489":41563,"_5":17384,"_23720":41450,"_2383":41564},[],"Independent Gateways on one node and one IP",{"_2856":294,"_25053":248,"_17489":41566,"_5":17384,"_23720":41450,"_2383":41567},[],"Use different external ports",{"_2856":295,"_25053":248,"_17489":41569,"_5":17384,"_23720":41450,"_2383":41570},[],"Clients must include non-standard ports",{"_2856":296,"_25053":248,"_17489":41572,"_5":17384,"_23720":41450,"_2383":41573},[],"Separate TLS/mTLS termination behind one IP",{"_2856":297,"_25053":248,"_17489":41575,"_5":17384,"_23720":41450,"_2383":41576},[],"Front-door SNI routing to internal Gateways",{"_2856":298,"_25053":248,"_17489":41578,"_5":17384,"_23720":41450,"_2383":41579},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_2856":299,"_25053":248,"_17489":41581,"_5":17384,"_23720":41450,"_2383":41582},[],"Separate Gateway resources but shared proxy infrastructure",{"_2856":300,"_25053":248,"_17489":41584,"_5":17384,"_23720":41450,"_2383":41585},[],"Envoy merged-Gateway mode",{"_2856":301,"_25053":248,"_17489":41587,"_5":17384,"_23720":41450,"_2383":41588},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_2856":302,"_25053":248,"_17489":41590,"_5":17384,"_23720":41450,"_2383":41591},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_2856":303,"_25053":248,"_17489":41593,"_5":17384,"_23720":41450,"_2383":41594},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_2856":304,"_25053":248,"_17489":41596,"_5":17384,"_23720":41450,"_2383":41597},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_2856":305,"_25053":248,"_17489":41599,"_5":17384,"_23720":41450,"_2383":41600},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_2856":306,"_25053":248,"_17489":41602,"_5":17384,"_23720":41454,"_2383":41603},[],"If one Gateway can own TLS and routing, use the chart default.",{"_2856":307,"_25053":248,"_17489":41605,"_5":17384,"_23720":41454,"_2383":41606},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_2856":308,"_25053":248,"_17489":41608,"_5":17384,"_23720":41454,"_2383":41609},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_2856":309,"_25053":248,"_17489":41611,"_5":17384,"_23720":41454,"_2383":41612},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_2856":310,"_25053":248,"_17489":41614,"_5":17384,"_23720":41454,"_2383":41615},[],"If none of those are possible, use different external ports or change the external network design.",{"_2856":311,"_25053":248,"_17489":41617,"_5":17384,"_23720":41458,"_2383":41618},[],"Check, in order:",{"_2856":312,"_25053":248,"_17489":41620,"_5":17384,"_23720":41458,"_2383":41621},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_2856":313,"_25053":248,"_17489":41623,"_5":17384,"_23720":41458,"_2383":41624},[],"Its status contains the expected address.",{"_2856":314,"_25053":248,"_17489":41626,"_5":17384,"_23720":41458,"_2383":41627},[],"The generated `LoadBalancer` Service has a usable external address.",{"_2856":315,"_25053":248,"_17489":41629,"_5":17384,"_23720":41458,"_2383":41630},[],"Port 443 reaches that address from the client network.",{"_2856":316,"_25053":248,"_17489":41632,"_5":17384,"_23720":41458,"_2383":41633},[],"DNS resolves to the externally reachable endpoint.",{"_2856":317,"_25053":248,"_17489":41635,"_5":17384,"_23720":41458,"_2383":41636},[],"The certificate contains the DNS name or IP used by the client.",{"_2856":318,"_25053":248,"_17489":41638,"_5":17384,"_23720":41458,"_2383":41639},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_2856":319,"_25053":319,"_5":12268,"_2383":40800,"_25368":41641,"_17489":41642,"_23720":319},[40693,40694,40800],[],{"_2856":320,"_25053":319,"_17489":41644,"_5":17384,"_23720":319,"_2383":41645},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_2856":321,"_25053":319,"_5":25365,"_17489":41647,"_23720":41648,"_2383":41649},[],"/docs/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_2856":322,"_25053":319,"_5":25365,"_17489":41651,"_23720":41652,"_2383":41653},[],"/docs/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_2856":323,"_25053":319,"_5":25365,"_17489":41655,"_23720":41656,"_2383":41657},[],"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_2856":324,"_25053":319,"_5":25365,"_17489":41659,"_23720":41660,"_2383":41661},[],"/docs/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_2856":325,"_25053":319,"_5":25365,"_17489":41663,"_23720":41664,"_2383":41665},[],"/docs/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_2856":326,"_25053":319,"_5":25365,"_17489":41667,"_23720":41668,"_2383":41669},[],"/docs/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_2856":327,"_25053":319,"_17489":41671,"_5":17384,"_23720":41648,"_2383":41672},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_2856":328,"_25053":319,"_17489":41674,"_5":17384,"_23720":41652,"_2383":41675},[],"Workflow",{"_2856":329,"_25053":319,"_17489":41677,"_5":17384,"_23720":41652,"_2383":41678},[],"Use it for",{"_2856":330,"_25053":319,"_17489":41680,"_5":17384,"_23720":41652,"_2383":41681},[],"What it installs",{"_2856":331,"_25053":319,"_17489":41683,"_5":17384,"_23720":41652,"_2383":41684},[],"Helm",{"_2856":332,"_25053":319,"_17489":41686,"_5":17384,"_23720":41652,"_2383":41687},[],"Production and controlled environments",{"_2856":333,"_25053":319,"_17489":41689,"_5":17384,"_23720":41652,"_2383":41690},[],"Lamassu services and Gateway API resources",{"_2856":334,"_25053":319,"_17489":41692,"_5":17384,"_23720":41652,"_2383":40937},[],{"_2856":335,"_25053":319,"_17489":41694,"_5":17384,"_23720":41652,"_2383":41695},[],"Evaluation, demos, CI and small lab clusters",{"_2856":336,"_25053":319,"_17489":41697,"_5":17384,"_23720":41652,"_2383":41698},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_2856":337,"_25053":319,"_17489":41700,"_5":17384,"_23720":41656,"_2383":41701},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_2856":338,"_25053":319,"_17489":41703,"_5":17384,"_23720":41656,"_2383":41704},[],"Area",{"_2856":339,"_25053":319,"_17489":41706,"_5":17384,"_23720":41656,"_2383":41707},[],"The Lamassu chart provides",{"_2856":340,"_25053":319,"_17489":41709,"_5":17384,"_23720":41656,"_2383":41710},[],"You provide",{"_2856":341,"_25053":319,"_17489":41712,"_5":17384,"_23720":41656,"_2383":41713},[],"Lamassu applications",{"_2856":342,"_25053":319,"_17489":41715,"_5":17384,"_23720":41656,"_2383":41716},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_2856":343,"_25053":319,"_17489":41718,"_5":17384,"_23720":41656,"_2383":41719},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_2856":344,"_25053":319,"_17489":41721,"_5":17384,"_23720":41656,"_2383":41722},[],"PostgreSQL data",{"_2856":345,"_25053":319,"_17489":41724,"_5":17384,"_23720":41656,"_2383":41725},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_2856":346,"_25053":319,"_17489":41727,"_5":17384,"_23720":41656,"_2383":41728},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_2856":347,"_25053":319,"_17489":41730,"_5":17384,"_23720":41656,"_2383":41731},[],"Messaging",{"_2856":348,"_25053":319,"_17489":41733,"_5":17384,"_23720":41656,"_2383":41734},[],"RabbitMQ connection configuration for the Lamassu services",{"_2856":349,"_25053":319,"_17489":41736,"_5":17384,"_23720":41656,"_2383":41737},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_2856":350,"_25053":319,"_17489":41739,"_5":17384,"_23720":41656,"_2383":41740},[],"Identity",{"_2856":351,"_25053":319,"_17489":41742,"_5":17384,"_23720":41656,"_2383":41743},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_2856":352,"_25053":319,"_17489":41745,"_5":17384,"_23720":41656,"_2383":41746},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_2856":353,"_25053":319,"_17489":41748,"_5":17384,"_23720":41656,"_2383":41749},[],"External routing",{"_2856":354,"_25053":319,"_17489":41751,"_5":17384,"_23720":41656,"_2383":41752},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_2856":355,"_25053":319,"_17489":41754,"_5":17384,"_23720":41656,"_2383":41755},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_2856":356,"_25053":319,"_17489":41757,"_5":17384,"_23720":41656,"_2383":41758},[],"TLS",{"_2856":357,"_25053":319,"_17489":41760,"_5":17384,"_23720":41656,"_2383":41761},[],"cert-manager `Issuer` and CA `Certificate` resources; either a chart-managed downstream `Certificate` or a reference to your TLS Secret",{"_2856":358,"_25053":319,"_17489":41763,"_5":17384,"_23720":41656,"_2383":41764},[],"cert-manager itself; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_2856":359,"_25053":319,"_17489":41766,"_5":17384,"_23720":41656,"_2383":41767},[],"Persistent application data",{"_2856":360,"_25053":319,"_17489":41769,"_5":17384,"_23720":41656,"_2383":41770},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_2856":361,"_25053":319,"_17489":41772,"_5":17384,"_23720":41656,"_2383":41773},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_2856":362,"_25053":319,"_17489":41775,"_5":17384,"_23720":41656,"_2383":41776},[],"Optional integrations",{"_2856":363,"_25053":319,"_17489":41778,"_5":17384,"_23720":41656,"_2383":41779},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_2856":364,"_25053":319,"_17489":41781,"_5":17384,"_23720":41656,"_2383":41782},[],"The observability backends, cloud credentials and production HSM or external key service",{"_2856":365,"_25053":319,"_17489":41784,"_5":17384,"_23720":41656,"_2383":41785},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_2856":366,"_25053":319,"_17489":41787,"_5":17384,"_23720":41656,"_2383":41788},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_2856":367,"_25053":319,"_17489":41790,"_5":17384,"_23720":41660,"_2383":41791},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_2856":368,"_25053":319,"_17489":41793,"_5":17384,"_23720":41660,"_2383":41794},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_2856":369,"_25053":319,"_17489":41796,"_5":17384,"_23720":41664,"_2383":41797},[],"Kubernetes 1.24 or newer",{"_2856":370,"_25053":319,"_17489":41799,"_5":17384,"_23720":41664,"_2383":41800},[],"Helm 3.2 or newer",{"_2856":371,"_25053":319,"_17489":41802,"_5":17384,"_23720":41664,"_2383":41803},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_2856":372,"_25053":319,"_17489":41805,"_5":17384,"_23720":41664,"_2383":41806},[],"cert-manager 1.14 or newer; the current chart renders cert-manager issuer and certificate resources",{"_2856":373,"_25053":319,"_17489":41808,"_5":17384,"_23720":41664,"_2383":41809},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_2856":374,"_25053":319,"_17489":41811,"_5":17384,"_23720":41664,"_2383":41812},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_2856":375,"_25053":319,"_17489":41814,"_5":17384,"_23720":41664,"_2383":41815},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer.",{"_2856":376,"_25053":319,"_17489":41817,"_5":17384,"_23720":41668,"_2383":41818},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2856":377,"_25053":319,"_17489":41820,"_5":17384,"_23720":41668,"_2383":41821},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2856":378,"_25053":319,"_17489":41823,"_5":17384,"_23720":41668,"_2383":41824},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2856":379,"_25053":379,"_5":12268,"_2383":41826,"_25368":41827,"_17489":41829,"_23720":379},"Deployment troubleshooting",[40693,40694,41828],"Operations",[],{"_2856":380,"_25053":379,"_17489":41831,"_5":17384,"_23720":379,"_2383":41832},[],"Diagnose access, service health and infrastructure dependencies.",{"_2856":381,"_25053":379,"_5":25365,"_17489":41834,"_23720":41835,"_2383":41836},[],"/docs/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_2856":382,"_25053":379,"_5":25365,"_17489":41838,"_23720":41839,"_2383":41840},[],"/docs/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_2856":383,"_25053":379,"_5":25365,"_17489":41842,"_23720":41843,"_2383":41844},[],"/docs/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_2856":384,"_25053":379,"_5":25365,"_17489":41846,"_23720":41847,"_2383":41848},[],"/docs/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_2856":385,"_25053":379,"_5":25365,"_17489":41850,"_23720":41851,"_2383":41852},[],"/docs/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_2856":386,"_25053":379,"_5":25365,"_17489":41854,"_23720":41855,"_2383":41856},[],"/docs/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_2856":387,"_25053":379,"_5":25365,"_17489":41858,"_23720":41859,"_2383":41860},[],"/docs/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_2856":388,"_25053":379,"_5":25365,"_17489":41862,"_23720":41863,"_2383":41864},[],"/docs/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_2856":389,"_25053":379,"_5":25365,"_17489":41866,"_23720":41867,"_2383":41868},[],"/docs/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_2856":390,"_25053":379,"_5":25365,"_17489":41870,"_23720":41871,"_2383":41872},[],"/docs/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_2856":391,"_25053":379,"_5":25365,"_17489":41874,"_23720":41875,"_2383":41876},[],"/docs/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_2856":392,"_25053":379,"_5":25365,"_17489":41878,"_23720":41879,"_2383":41880},[],"/docs/deployment/troubleshooting#observability","Observability",{"_2856":393,"_25053":379,"_17489":41882,"_5":17384,"_23720":379,"_2383":41883},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_2856":394,"_25053":379,"_17489":41885,"_5":17384,"_23720":41839,"_2383":41886},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_2856":395,"_25053":379,"_17489":41888,"_5":17384,"_23720":41843,"_2383":41889},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_2856":396,"_25053":379,"_17489":41891,"_5":17384,"_23720":41847,"_2383":41892},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_2856":397,"_25053":379,"_17489":41894,"_5":17384,"_23720":41851,"_2383":41895},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_2856":398,"_25053":379,"_17489":41897,"_5":17384,"_23720":41855,"_2383":41898},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_2856":399,"_25053":379,"_17489":41900,"_5":17384,"_23720":41859,"_2383":41901},[],"Replace the placeholders with your real release, namespace and deployment.",{"_2856":400,"_25053":379,"_17489":41903,"_5":17384,"_23720":41859,"_2383":41904},[],"Also run the chart's connectivity test:",{"_2856":401,"_25053":379,"_17489":41906,"_5":17384,"_23720":41859,"_2383":41907},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_2856":402,"_25053":379,"_17489":41909,"_5":17384,"_23720":41859,"_2383":41910},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_2856":403,"_25053":379,"_17489":41912,"_5":17384,"_23720":41863,"_2383":41913},[],"If you receive a 401:",{"_2856":404,"_25053":379,"_17489":41915,"_5":17384,"_23720":41863,"_2383":41916},[],"check that the UI's OIDC authority is reachable from the browser;",{"_2856":405,"_25053":379,"_17489":41918,"_5":17384,"_23720":41863,"_2383":41919},[],"verify issuer, audience and expiration of the token;",{"_2856":406,"_25053":379,"_17489":41921,"_5":17384,"_23720":41863,"_2383":41922},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_2856":407,"_25053":379,"_17489":41924,"_5":17384,"_23720":41863,"_2383":41925},[],"check that the provider's public and internal routes point to the same realm.",{"_2856":408,"_25053":379,"_17489":41927,"_5":17384,"_23720":41863,"_2383":41928},[],"If login succeeds but the APIs return 403:",{"_2856":409,"_25053":379,"_17489":41930,"_5":17384,"_23720":41863,"_2383":41931},[],"inspect the token's real claims;",{"_2856":410,"_25053":379,"_17489":41933,"_5":17384,"_23720":41863,"_2383":41934},[],"confirm they match an active principal;",{"_2856":411,"_25053":379,"_17489":41936,"_5":17384,"_23720":41863,"_2383":41937},[],"review the policies granted to that principal;",{"_2856":412,"_25053":379,"_17489":41939,"_5":17384,"_23720":41863,"_2383":41940},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_2856":413,"_25053":379,"_17489":41942,"_5":17384,"_23720":41863,"_2383":41943},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_2856":414,"_25053":379,"_17489":41945,"_5":17384,"_23720":41867,"_2383":41946},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_2856":415,"_25053":379,"_17489":41948,"_5":17384,"_23720":41867,"_2383":41949},[],"Locate the authz pod and Service.",{"_2856":416,"_25053":379,"_17489":41951,"_5":17384,"_23720":41867,"_2383":41952},[],"Check /health, logs and its database connection.",{"_2856":417,"_25053":379,"_17489":41954,"_5":17384,"_23720":41867,"_2383":41955},[],"Verify the DNS and port configured in externalAuthorization.",{"_2856":418,"_25053":379,"_17489":41957,"_5":17384,"_23720":41867,"_2383":41958},[],"Check the check route is /v1/ext\\_authz/check.",{"_2856":419,"_25053":379,"_17489":41960,"_5":17384,"_23720":41867,"_2383":41961},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_2856":420,"_25053":379,"_17489":41963,"_5":17384,"_23720":41871,"_2383":41964},[],"Review kubectl describe pod first. Common causes are:",{"_2856":421,"_25053":379,"_17489":41966,"_5":17384,"_23720":41871,"_2383":41967},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_2856":422,"_25053":379,"_17489":41969,"_5":17384,"_23720":41871,"_2383":41970},[],"unbound persistent volume;",{"_2856":423,"_25053":379,"_17489":41972,"_5":17384,"_23720":41871,"_2383":41973},[],"inaccessible image or incorrect pull policy;",{"_2856":424,"_25053":379,"_17489":41975,"_5":17384,"_23720":41871,"_2383":41976},[],"invalid cryptographic engine configuration;",{"_2856":425,"_25053":379,"_17489":41978,"_5":17384,"_23720":41871,"_2383":41979},[],"CPU or memory limits set too low;",{"_2856":426,"_25053":379,"_17489":41981,"_5":17384,"_23720":41871,"_2383":41982},[],"an incomplete prior migration.",{"_2856":427,"_25053":379,"_17489":41984,"_5":17384,"_23720":41871,"_2383":41985},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_2856":428,"_25053":379,"_17489":41987,"_5":17384,"_23720":41871,"_2383":41988},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_2856":429,"_25053":379,"_17489":41990,"_5":17384,"_23720":41875,"_2383":41991},[],"Domain and audit events depend on the bus publisher:",{"_2856":430,"_25053":379,"_17489":41993,"_5":17384,"_23720":41875,"_2383":41994},[],"verify it is enabled in the emitting service;",{"_2856":431,"_25053":379,"_17489":41996,"_5":17384,"_23720":41875,"_2383":41997},[],"check AMQP connectivity and credentials;",{"_2856":432,"_25053":379,"_17489":41999,"_5":17384,"_23720":41875,"_2383":42000},[],"review exchange, routing key, queues and consumers;",{"_2856":433,"_25053":379,"_17489":42002,"_5":17384,"_23720":41875,"_2383":42003},[],"inspect dead-letter queues;",{"_2856":434,"_25053":379,"_17489":42005,"_5":17384,"_23720":41875,"_2383":42006},[],"alert on orphan durable queues and backlog growth.",{"_2856":435,"_25053":379,"_17489":42008,"_5":17384,"_23720":41875,"_2383":42009},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_2856":436,"_25053":379,"_17489":42011,"_5":17384,"_23720":41879,"_2383":42012},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_2856":437,"_25053":379,"_17489":42014,"_5":17384,"_23720":41879,"_2383":42015},[],"Before closing an incident, record:",{"_2856":438,"_25053":379,"_17489":42017,"_5":17384,"_23720":41879,"_2383":42018},[],"the confirmed cause;",{"_2856":439,"_25053":379,"_17489":42020,"_5":17384,"_23720":41879,"_2383":42021},[],"the time scope and affected resources;",{"_2856":440,"_25053":379,"_17489":42023,"_5":17384,"_23720":41879,"_2383":42024},[],"the commands or queries used;",{"_2856":441,"_25053":379,"_17489":42026,"_5":17384,"_23720":41879,"_2383":42027},[],"the applied change and how to revert it;",{"_2856":442,"_25053":379,"_17489":42029,"_5":17384,"_23720":41879,"_2383":42030},[],"validation from a consumer;",{"_2856":443,"_25053":379,"_17489":42032,"_5":17384,"_23720":41879,"_2383":42033},[],"the preventive action and its owner.",{"_2856":444,"_25053":444,"_5":12268,"_2383":42035,"_25368":42036,"_17489":42039,"_23720":444},"Access control",[40693,42037,42038],"Platform","Administration",[],{"_2856":445,"_25053":444,"_17489":42041,"_5":17384,"_23720":444,"_2383":42042},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_2856":446,"_25053":444,"_5":25365,"_17489":42044,"_23720":42045,"_2383":42046},[],"/docs/platform/administration/access-control#essential-concepts","Essential concepts",{"_2856":447,"_25053":444,"_5":25365,"_17489":42048,"_23720":42049,"_2383":42050},[],"/docs/platform/administration/access-control#two-decision-systems","Two decision systems",{"_2856":448,"_25053":444,"_5":25365,"_17489":42052,"_23720":42053,"_2383":42054},[],"/docs/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_2856":449,"_25053":444,"_5":25365,"_17489":42056,"_23720":42057,"_2383":42058},[],"/docs/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_2856":450,"_25053":444,"_5":25365,"_17489":42060,"_23720":42061,"_2383":42062},[],"/docs/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_2856":451,"_25053":444,"_5":25365,"_17489":42064,"_23720":42065,"_2383":42066},[],"/docs/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_2856":452,"_25053":444,"_5":25365,"_17489":42068,"_23720":42069,"_2383":42070},[],"/docs/platform/administration/access-control#oidc-principals","OIDC principals",{"_2856":453,"_25053":444,"_5":25365,"_17489":42072,"_23720":42073,"_2383":42074},[],"/docs/platform/administration/access-control#x509-principals","X.509 principals",{"_2856":454,"_25053":444,"_5":25365,"_17489":42076,"_23720":42077,"_2383":42078},[],"/docs/platform/administration/access-control#when-several-principals-match","When several principals match",{"_2856":455,"_25053":444,"_5":25365,"_17489":42080,"_23720":42081,"_2383":42082},[],"/docs/platform/administration/access-control#how-policies-express-access","How policies express access",{"_2856":456,"_25053":444,"_5":25365,"_17489":42084,"_23720":42085,"_2383":42086},[],"/docs/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_2856":457,"_25053":444,"_5":25365,"_17489":42088,"_23720":42089,"_2383":42090},[],"/docs/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_2856":458,"_25053":444,"_5":25365,"_17489":42092,"_23720":42093,"_2383":42094},[],"/docs/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_2856":459,"_25053":444,"_5":25365,"_17489":42096,"_23720":42097,"_2383":42098},[],"/docs/platform/administration/access-control#http-rules","HTTP rules",{"_2856":460,"_25053":444,"_5":25365,"_17489":42100,"_23720":42101,"_2383":42102},[],"/docs/platform/administration/access-control#included-policies","Included policies",{"_2856":461,"_25053":444,"_5":25365,"_17489":42104,"_23720":42105,"_2383":41296},[],"/docs/platform/administration/access-control#provision-the-first-administrator",{"_2856":462,"_25053":444,"_5":25365,"_17489":42107,"_23720":42108,"_2383":42109},[],"/docs/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_2856":463,"_25053":444,"_5":25365,"_17489":42111,"_23720":42112,"_2383":42113},[],"/docs/platform/administration/access-control#configure-the-two-jwt-validations","Configure the two JWT validations",{"_2856":464,"_25053":444,"_5":25365,"_17489":42115,"_23720":42116,"_2383":42117},[],"/docs/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_2856":465,"_25053":444,"_5":25365,"_17489":42119,"_23720":42120,"_2383":42121},[],"/docs/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_2856":466,"_25053":444,"_5":25365,"_17489":42123,"_23720":42124,"_2383":42125},[],"/docs/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_2856":467,"_25053":444,"_5":25365,"_17489":42127,"_23720":42128,"_2383":42129},[],"/docs/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_2856":468,"_25053":444,"_5":25365,"_17489":42131,"_23720":42132,"_2383":42133},[],"/docs/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_2856":469,"_25053":444,"_5":25365,"_17489":42135,"_23720":42136,"_2383":42137},[],"/docs/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_2856":470,"_25053":444,"_5":25365,"_17489":42139,"_23720":42140,"_2383":42141},[],"/docs/platform/administration/access-control#operational-checklist","Operational checklist",{"_2856":471,"_25053":444,"_5":25365,"_17489":42143,"_23720":42144,"_2383":42145},[],"/docs/platform/administration/access-control#diagnostics","Diagnostics",{"_2856":472,"_25053":444,"_5":25365,"_17489":42147,"_23720":42148,"_2383":42149},[],"/docs/platform/administration/access-control#the-response-is-401","The response is 401",{"_2856":473,"_25053":444,"_5":25365,"_17489":42151,"_23720":42152,"_2383":42153},[],"/docs/platform/administration/access-control#the-response-is-403","The response is 403",{"_2856":474,"_25053":444,"_5":25365,"_17489":42155,"_23720":42156,"_2383":42157},[],"/docs/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_2856":475,"_25053":444,"_5":25365,"_17489":42159,"_23720":42160,"_2383":42161},[],"/docs/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_2856":476,"_25053":444,"_5":25365,"_17489":42163,"_23720":42164,"_2383":42165},[],"/docs/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_2856":477,"_25053":444,"_17489":42167,"_5":17384,"_23720":444,"_2383":42168},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_2856":478,"_25053":444,"_17489":42170,"_5":17384,"_23720":444,"_2383":42171},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_2856":479,"_25053":444,"_17489":42173,"_5":17384,"_23720":444,"_2383":42174},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_2856":480,"_25053":444,"_17489":42176,"_5":17384,"_23720":42045,"_2383":42177},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_2856":481,"_25053":444,"_17489":42179,"_5":17384,"_23720":42045,"_2383":42180},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_2856":482,"_25053":444,"_17489":42182,"_5":17384,"_23720":42045,"_2383":42183},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_2856":483,"_25053":444,"_17489":42185,"_5":17384,"_23720":42045,"_2383":42186},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_2856":484,"_25053":444,"_17489":42188,"_5":17384,"_23720":42045,"_2383":42189},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_2856":485,"_25053":444,"_17489":42191,"_5":17384,"_23720":42045,"_2383":42192},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_2856":486,"_25053":444,"_17489":42194,"_5":17384,"_23720":42049,"_2383":42195},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_2856":487,"_25053":444,"_17489":42197,"_5":17384,"_23720":42049,"_2383":42198},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_2856":488,"_25053":444,"_17489":42200,"_5":17384,"_23720":42053,"_2383":42201},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_2856":489,"_25053":444,"_17489":42203,"_5":17384,"_23720":42053,"_2383":42204},[],"The decision is made **before forwarding the request to the service**:",{"_2856":490,"_25053":444,"_17489":42206,"_5":17384,"_23720":42053,"_2383":42207},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_2856":491,"_25053":444,"_17489":42209,"_5":17384,"_23720":42053,"_2383":42210},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_2856":492,"_25053":444,"_17489":42212,"_5":17384,"_23720":42053,"_2383":42213},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_2856":493,"_25053":444,"_17489":42215,"_5":17384,"_23720":42053,"_2383":42216},[],"It separately loads the policies granted to each principal.",{"_2856":494,"_25053":444,"_17489":42218,"_5":17384,"_23720":42053,"_2383":42219},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_2856":495,"_25053":444,"_17489":42221,"_5":17384,"_23720":42053,"_2383":42222},[],"`authz` looks for an HTTP rule granting that action.",{"_2856":496,"_25053":444,"_17489":42224,"_5":17384,"_23720":42053,"_2383":42225},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_2856":497,"_25053":444,"_17489":42227,"_5":17384,"_23720":42053,"_2383":42228},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_2856":498,"_25053":444,"_17489":42230,"_5":17384,"_23720":42053,"_2383":42231},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_2856":499,"_25053":444,"_17489":42233,"_5":17384,"_23720":42053,"_2383":42234},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_2856":500,"_25053":444,"_17489":42236,"_5":17384,"_23720":42057,"_2383":42237},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_2856":501,"_25053":444,"_17489":42239,"_5":17384,"_23720":42057,"_2383":42240},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_2856":502,"_25053":444,"_17489":42242,"_5":17384,"_23720":42057,"_2383":42243},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_2856":503,"_25053":444,"_17489":42245,"_5":17384,"_23720":42057,"_2383":42246},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_2856":504,"_25053":444,"_17489":42248,"_5":17384,"_23720":42057,"_2383":42249},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_2856":505,"_25053":444,"_17489":42251,"_5":17384,"_23720":42057,"_2383":42252},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_2856":506,"_25053":444,"_17489":42254,"_5":17384,"_23720":42057,"_2383":42255},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_2856":507,"_25053":444,"_17489":42257,"_5":17384,"_23720":42057,"_2383":42258},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_2856":508,"_25053":444,"_17489":42260,"_5":17384,"_23720":42061,"_2383":42261},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_2856":509,"_25053":444,"_17489":42263,"_5":17384,"_23720":42061,"_2383":42264},[],"The decision is made with the domain operation context:",{"_2856":510,"_25053":444,"_17489":42266,"_5":17384,"_23720":42061,"_2383":42267},[],"The middleware extracts the credential and resolves the matching principals.",{"_2856":511,"_25053":444,"_17489":42269,"_5":17384,"_23720":42061,"_2383":42270},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_2856":512,"_25053":444,"_17489":42272,"_5":17384,"_23720":42061,"_2383":42273},[],"`authz` gathers the entity rules of the granted policies.",{"_2856":513,"_25053":444,"_17489":42275,"_5":17384,"_23720":42061,"_2383":42276},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_2856":514,"_25053":444,"_17489":42278,"_5":17384,"_23720":42061,"_2383":42279},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_2856":515,"_25053":444,"_17489":42281,"_5":17384,"_23720":42061,"_2383":42282},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_2856":516,"_25053":444,"_17489":42284,"_5":17384,"_23720":42061,"_2383":42285},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_2856":517,"_25053":444,"_17489":42287,"_5":17384,"_23720":42061,"_2383":42288},[],"Actions fall into two groups:",{"_2856":518,"_25053":444,"_17489":42290,"_5":17384,"_23720":42061,"_2383":42291},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_2856":519,"_25053":444,"_17489":42293,"_5":17384,"_23720":42061,"_2383":42294},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_2856":520,"_25053":444,"_17489":42296,"_5":17384,"_23720":42061,"_2383":42297},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_2856":521,"_25053":444,"_17489":42299,"_5":17384,"_23720":42065,"_2383":42300},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_2856":522,"_25053":444,"_17489":42302,"_5":17384,"_23720":42065,"_2383":42303},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_2856":523,"_25053":444,"_17489":42305,"_5":17384,"_23720":42065,"_2383":42306},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_2856":524,"_25053":444,"_17489":42308,"_5":17384,"_23720":42069,"_2383":42309},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_2856":525,"_25053":444,"_17489":42311,"_5":17384,"_23720":42069,"_2383":42312},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_2856":526,"_25053":444,"_17489":42314,"_5":17384,"_23720":42069,"_2383":42315},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_2856":527,"_25053":444,"_17489":42317,"_5":17384,"_23720":42069,"_2383":42318},[],"The implemented operators are:",{"_2856":528,"_25053":444,"_17489":42320,"_5":17384,"_23720":42069,"_2383":42321},[],"`equals`, for exact equality;",{"_2856":529,"_25053":444,"_17489":42323,"_5":17384,"_23720":42069,"_2383":42324},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_2856":530,"_25053":444,"_17489":42326,"_5":17384,"_23720":42069,"_2383":42327},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_2856":531,"_25053":444,"_17489":42329,"_5":17384,"_23720":42069,"_2383":42330},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_2856":532,"_25053":444,"_17489":42332,"_5":17384,"_23720":42073,"_2383":42333},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_2856":533,"_25053":444,"_17489":42335,"_5":17384,"_23720":42073,"_2383":42336},[],"The available modes are:",{"_2856":534,"_25053":444,"_17489":42338,"_5":17384,"_23720":42073,"_2383":42339},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_2856":535,"_25053":444,"_17489":42341,"_5":17384,"_23720":42073,"_2383":42342},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_2856":536,"_25053":444,"_17489":42344,"_5":17384,"_23720":42073,"_2383":42345},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_2856":537,"_25053":444,"_17489":42347,"_5":17384,"_23720":42073,"_2383":42348},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_2856":538,"_25053":444,"_17489":42350,"_5":17384,"_23720":42073,"_2383":42351},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_2856":539,"_25053":444,"_17489":42353,"_5":17384,"_23720":42073,"_2383":42354},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_2856":540,"_25053":444,"_17489":42356,"_5":17384,"_23720":42077,"_2383":42357},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_2856":541,"_25053":444,"_17489":42359,"_5":17384,"_23720":42077,"_2383":42360},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_2856":542,"_25053":444,"_17489":42362,"_5":17384,"_23720":42077,"_2383":42363},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_2856":543,"_25053":444,"_17489":42365,"_5":17384,"_23720":42077,"_2383":42366},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_2856":544,"_25053":444,"_17489":42368,"_5":17384,"_23720":42085,"_2383":42369},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_2856":545,"_25053":444,"_17489":42371,"_5":17384,"_23720":42085,"_2383":42372},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_2856":546,"_25053":444,"_17489":42374,"_5":17384,"_23720":42089,"_2383":42375},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_2856":547,"_25053":444,"_17489":42377,"_5":17384,"_23720":42089,"_2383":42378},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_2856":548,"_25053":444,"_17489":42380,"_5":17384,"_23720":42093,"_2383":42381},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_2856":549,"_25053":444,"_17489":42383,"_5":17384,"_23720":42093,"_2383":42384},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_2856":550,"_25053":444,"_17489":42386,"_5":17384,"_23720":42093,"_2383":42387},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_2856":551,"_25053":444,"_17489":42389,"_5":17384,"_23720":42097,"_2383":42390},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_2856":552,"_25053":444,"_17489":42392,"_5":17384,"_23720":42097,"_2383":42393},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_2856":553,"_25053":444,"_17489":42395,"_5":17384,"_23720":42097,"_2383":42396},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_2856":554,"_25053":444,"_17489":42398,"_5":17384,"_23720":42097,"_2383":42399},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_2856":555,"_25053":444,"_17489":42401,"_5":17384,"_23720":42097,"_2383":42402},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_2856":556,"_25053":444,"_17489":42404,"_5":17384,"_23720":42097,"_2383":42405},[],"Note that:",{"_2856":557,"_25053":444,"_17489":42407,"_5":17384,"_23720":42097,"_2383":42408},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_2856":558,"_25053":444,"_17489":42410,"_5":17384,"_23720":42097,"_2383":42411},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_2856":559,"_25053":444,"_17489":42413,"_5":17384,"_23720":42097,"_2383":42414},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_2856":560,"_25053":444,"_17489":42416,"_5":17384,"_23720":42101,"_2383":42417},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_2856":561,"_25053":444,"_17489":42419,"_5":17384,"_23720":42101,"_2383":42420},[],"full and read-only access to certificates and authorities;",{"_2856":562,"_25053":444,"_17489":42422,"_5":17384,"_23720":42101,"_2383":42423},[],"full and read-only access to the KMS;",{"_2856":563,"_25053":444,"_17489":42425,"_5":17384,"_23720":42101,"_2383":42426},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_2856":564,"_25053":444,"_17489":42428,"_5":17384,"_23720":42101,"_2383":42429},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_2856":565,"_25053":444,"_17489":42431,"_5":17384,"_23720":42101,"_2383":42432},[],"console access;",{"_2856":566,"_25053":444,"_17489":42434,"_5":17384,"_23720":42101,"_2383":42435},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_2856":567,"_25053":444,"_17489":42437,"_5":17384,"_23720":42101,"_2383":42438},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_2856":568,"_25053":444,"_17489":42440,"_5":17384,"_23720":42101,"_2383":42441},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_2856":569,"_25053":444,"_17489":42443,"_5":17384,"_23720":42105,"_2383":42444},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_2856":570,"_25053":444,"_17489":42446,"_5":17384,"_23720":42105,"_2383":42447},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_2856":571,"_25053":444,"_17489":42449,"_5":17384,"_23720":42105,"_2383":42450},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_2856":572,"_25053":444,"_17489":42452,"_5":17384,"_23720":42108,"_2383":42453},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_2856":573,"_25053":444,"_17489":42455,"_5":17384,"_23720":42112,"_2383":42456},[],"The Gateway uses `auth.authentication.apiGateway.jwks` to authenticate requests. `authz` uses `services.authz.jwkUrl` to resolve OIDC principals. Both endpoints must contain the keys of the same issuer and be reachable from their respective components.",{"_2856":574,"_25053":444,"_17489":42458,"_5":17384,"_23720":42116,"_2383":42459},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_2856":575,"_25053":444,"_17489":42461,"_5":17384,"_23720":42120,"_2383":42462},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_2856":576,"_25053":444,"_17489":42464,"_5":17384,"_23720":42124,"_2383":42465},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_2856":577,"_25053":444,"_17489":42467,"_5":17384,"_23720":42128,"_2383":42468},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_2856":578,"_25053":444,"_17489":42470,"_5":17384,"_23720":42128,"_2383":42471},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_2856":579,"_25053":444,"_17489":42473,"_5":17384,"_23720":42132,"_2383":42474},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_2856":580,"_25053":444,"_17489":42476,"_5":17384,"_23720":42132,"_2383":42477},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_2856":581,"_25053":444,"_17489":42479,"_5":17384,"_23720":42132,"_2383":42480},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_2856":582,"_25053":444,"_17489":42482,"_5":17384,"_23720":42132,"_2383":42483},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_2856":583,"_25053":444,"_17489":42485,"_5":17384,"_23720":42132,"_2383":42486},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_2856":584,"_25053":444,"_17489":42488,"_5":17384,"_23720":42132,"_2383":42489},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_2856":585,"_25053":444,"_17489":42491,"_5":17384,"_23720":42132,"_2383":42492},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_2856":586,"_25053":444,"_17489":42494,"_5":17384,"_23720":42132,"_2383":42495},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_2856":587,"_25053":444,"_17489":42497,"_5":17384,"_23720":42136,"_2383":42498},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_2856":588,"_25053":444,"_17489":42500,"_5":17384,"_23720":42136,"_2383":42501},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_2856":589,"_25053":444,"_17489":42503,"_5":17384,"_23720":42136,"_2383":42504},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_2856":590,"_25053":444,"_17489":42506,"_5":17384,"_23720":42140,"_2383":42507},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_2856":591,"_25053":444,"_17489":42509,"_5":17384,"_23720":42140,"_2383":42510},[],"Use groups or stable roles for people and independent identities for automations.",{"_2856":592,"_25053":444,"_17489":42512,"_5":17384,"_23720":42140,"_2383":42513},[],"Keep at least two recovery administrators and test their access periodically.",{"_2856":593,"_25053":444,"_17489":42515,"_5":17384,"_23720":42140,"_2383":42516},[],"Review active principals, their matches and their grants after IdP changes.",{"_2856":594,"_25053":444,"_17489":42518,"_5":17384,"_23720":42140,"_2383":42519},[],"Search for wildcards in policies before upgrading Lamassu.",{"_2856":595,"_25053":444,"_17489":42521,"_5":17384,"_23720":42140,"_2383":42522},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_2856":596,"_25053":444,"_17489":42524,"_5":17384,"_23720":42140,"_2383":42525},[],"Always test one allowed and one denied operation for each role.",{"_2856":597,"_25053":444,"_17489":42527,"_5":17384,"_23720":42140,"_2383":42528},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_2856":598,"_25053":444,"_17489":42530,"_5":17384,"_23720":42148,"_2383":42531},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_2856":599,"_25053":444,"_17489":42533,"_5":17384,"_23720":42152,"_2383":42534},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_2856":600,"_25053":444,"_17489":42536,"_5":17384,"_23720":42152,"_2383":42537},[],"that an active principal of the correct type exists;",{"_2856":601,"_25053":444,"_17489":42539,"_5":17384,"_23720":42152,"_2383":42540},[],"that the claim paths and values match the real token exactly;",{"_2856":602,"_25053":444,"_17489":42542,"_5":17384,"_23720":42152,"_2383":42543},[],"that all of the principal's conditions hold;",{"_2856":603,"_25053":444,"_17489":42545,"_5":17384,"_23720":42152,"_2383":42546},[],"that the principal has the expected policy granted;",{"_2856":604,"_25053":444,"_17489":42548,"_5":17384,"_23720":42152,"_2383":42549},[],"that the policy includes the action and the requested resource type or route;",{"_2856":605,"_25053":444,"_17489":42551,"_5":17384,"_23720":42152,"_2383":42552},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_2856":606,"_25053":444,"_17489":42554,"_5":17384,"_23720":42152,"_2383":42555},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry instrumentation enabled, each decision also produces a span — `engine.CheckHTTP` on the Gateway path — whose attributes record `authz.allowed`, the matched policy and the matched principal, so you can correlate the denial with the Gateway trace.",{"_2856":607,"_25053":444,"_17489":42557,"_5":17384,"_23720":42156,"_2383":42558},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_2856":608,"_25053":444,"_17489":42560,"_5":17384,"_23720":42160,"_2383":42561},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_2856":609,"_25053":444,"_17489":42563,"_5":17384,"_23720":42164,"_2383":42564},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_2856":610,"_25053":444,"_17489":42566,"_5":17384,"_23720":42164,"_2383":42567},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_2856":611,"_25053":611,"_5":12268,"_2383":42569,"_25368":42570,"_17489":42571,"_23720":611},"Alerts and subscriptions",[40693,42037,42038],[],{"_2856":612,"_25053":611,"_17489":42573,"_5":17384,"_23720":611,"_2383":42574},[],"Send PKI events to people and external systems.",{"_2856":613,"_25053":611,"_5":25365,"_17489":42576,"_23720":42577,"_2383":42578},[],"/docs/platform/administration/alerts#how-it-works","How it works",{"_2856":614,"_25053":611,"_5":25365,"_17489":42580,"_23720":42581,"_2383":42582},[],"/docs/platform/administration/alerts#available-channels","Available channels",{"_2856":615,"_25053":611,"_5":25365,"_17489":42584,"_23720":42585,"_2383":42586},[],"/docs/platform/administration/alerts#create-a-subscription","Create a subscription",{"_2856":616,"_25053":611,"_5":25365,"_17489":42588,"_23720":42589,"_2383":42590},[],"/docs/platform/administration/alerts#choose-the-event","Choose the event",{"_2856":617,"_25053":611,"_5":25365,"_17489":42592,"_23720":42593,"_2383":42594},[],"/docs/platform/administration/alerts#configure-the-destination","Configure the destination",{"_2856":618,"_25053":611,"_5":25365,"_17489":42596,"_23720":42597,"_2383":42598},[],"/docs/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_2856":619,"_25053":611,"_5":25365,"_17489":42600,"_23720":42601,"_2383":42602},[],"/docs/platform/administration/alerts#review-and-activate","Review and activate",{"_2856":620,"_25053":611,"_5":25365,"_17489":42604,"_23720":42605,"_2383":42606},[],"/docs/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_2856":621,"_25053":611,"_5":25365,"_17489":42608,"_23720":42609,"_2383":42610},[],"/docs/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_2856":622,"_25053":611,"_5":25365,"_17489":42612,"_23720":42613,"_2383":42614},[],"/docs/platform/administration/alerts#event-families","Event families",{"_2856":623,"_25053":611,"_17489":42616,"_5":17384,"_23720":611,"_2383":42617},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_2856":624,"_25053":611,"_17489":42619,"_5":17384,"_23720":42577,"_2383":42620},[],"A service publishes a domain event.",{"_2856":625,"_25053":611,"_17489":42622,"_5":17384,"_23720":42577,"_2383":42623},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_2856":626,"_25053":611,"_17489":42625,"_5":17384,"_23720":42577,"_2383":42626},[],"Each subscription's filter decides whether it should be notified.",{"_2856":627,"_25053":611,"_17489":42628,"_5":17384,"_23720":42577,"_2383":42629},[],"Lamassu delivers the event to the configured channel.",{"_2856":628,"_25053":611,"_17489":42631,"_5":17384,"_23720":42577,"_2383":42632},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_2856":629,"_25053":611,"_17489":42634,"_5":17384,"_23720":42581,"_2383":42635},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_2856":630,"_25053":611,"_17489":42637,"_5":17384,"_23720":42581,"_2383":42638},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_2856":631,"_25053":611,"_17489":42640,"_5":17384,"_23720":42581,"_2383":42641},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_2856":632,"_25053":611,"_17489":42643,"_5":17384,"_23720":42581,"_2383":42644},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_2856":633,"_25053":611,"_17489":42646,"_5":17384,"_23720":42581,"_2383":42647},[],"`apikey_options` requires `header` and `key`.",{"_2856":634,"_25053":611,"_17489":42649,"_5":17384,"_23720":42581,"_2383":42650},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_2856":635,"_25053":611,"_17489":42652,"_5":17384,"_23720":42581,"_2383":42653},[],"`mtls_options` requires the inline PEM `cert_content` and `key_content`; values that reference files on the server are rejected.",{"_2856":636,"_25053":611,"_17489":42655,"_5":17384,"_23720":42581,"_2383":42656},[],"The alerts API reference documents the full `http_client` schema.",{"_2856":637,"_25053":611,"_17489":42658,"_5":17384,"_23720":42589,"_2383":42659},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_2856":638,"_25053":611,"_17489":42661,"_5":17384,"_23720":42593,"_2383":42662},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_2856":639,"_25053":611,"_17489":42664,"_5":17384,"_23720":42597,"_2383":42665},[],"Add a filter if you don't want to receive every instance of the event.",{"_2856":640,"_25053":611,"_17489":42667,"_5":17384,"_23720":42597,"_2383":42668},[],"**None** notifies all instances of the event.",{"_2856":641,"_25053":611,"_17489":42670,"_5":17384,"_23720":42597,"_2383":42671},[],"**JSON Path** evaluates one or more specific fields.",{"_2856":642,"_25053":611,"_17489":42673,"_5":17384,"_23720":42597,"_2383":42674},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_2856":643,"_25053":611,"_17489":42676,"_5":17384,"_23720":42597,"_2383":42677},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_2856":644,"_25053":611,"_17489":42679,"_5":17384,"_23720":42597,"_2383":42680},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_2856":645,"_25053":611,"_17489":42682,"_5":17384,"_23720":42601,"_2383":42683},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_2856":646,"_25053":611,"_17489":42685,"_5":17384,"_23720":42605,"_2383":42686},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_2856":647,"_25053":611,"_17489":42688,"_5":17384,"_23720":42605,"_2383":42689},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_2856":648,"_25053":611,"_17489":42691,"_5":17384,"_23720":42605,"_2383":42692},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_2856":649,"_25053":611,"_17489":42694,"_5":17384,"_23720":42605,"_2383":42695},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_2856":650,"_25053":611,"_17489":42697,"_5":17384,"_23720":42605,"_2383":42698},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_2856":651,"_25053":611,"_17489":42700,"_5":17384,"_23720":42605,"_2383":42701},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_2856":652,"_25053":611,"_17489":42703,"_5":17384,"_23720":42605,"_2383":42704},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_2856":653,"_25053":611,"_17489":42706,"_5":17384,"_23720":42605,"_2383":42707},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_2856":654,"_25053":611,"_17489":42709,"_5":17384,"_23720":42609,"_2383":42710},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_2856":655,"_25053":611,"_17489":42712,"_5":17384,"_23720":42613,"_2383":42713},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_2856":656,"_25053":611,"_17489":42715,"_5":17384,"_23720":42613,"_2383":42716},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_2856":657,"_25053":611,"_17489":42718,"_5":17384,"_23720":42613,"_2383":42719},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_2856":658,"_25053":611,"_17489":42721,"_5":17384,"_23720":42613,"_2383":42722},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_2856":659,"_25053":611,"_17489":42724,"_5":17384,"_23720":42613,"_2383":42725},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_2856":660,"_25053":611,"_17489":42727,"_5":17384,"_23720":42613,"_2383":42728},[],"**Validation:** `va.role.crl.create`.",{"_2856":661,"_25053":611,"_17489":42730,"_5":17384,"_23720":42613,"_2383":42731},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_2856":662,"_25053":611,"_17489":42733,"_5":17384,"_23720":42613,"_2383":42734},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_2856":663,"_25053":663,"_5":12268,"_2383":42736,"_25368":42737,"_17489":42738,"_23720":663},"Audit logs",[40693,42037,42038],[],{"_2856":664,"_25053":663,"_17489":42740,"_5":17384,"_23720":663,"_2383":42741},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_2856":665,"_25053":663,"_5":25365,"_17489":42743,"_23720":42744,"_2383":42745},[],"/docs/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_2856":666,"_25053":663,"_5":25365,"_17489":42747,"_23720":42748,"_2383":42749},[],"/docs/platform/administration/audit-logs#coverage","Coverage",{"_2856":667,"_25053":663,"_5":25365,"_17489":42751,"_23720":42752,"_2383":42753},[],"/docs/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_2856":668,"_25053":663,"_5":25365,"_17489":42755,"_23720":42756,"_2383":42757},[],"/docs/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_2856":669,"_25053":663,"_5":25365,"_17489":42759,"_23720":42760,"_2383":42761},[],"/docs/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_2856":670,"_25053":663,"_5":25365,"_17489":42763,"_23720":42764,"_2383":42765},[],"/docs/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_2856":671,"_25053":663,"_5":25365,"_17489":42767,"_23720":42768,"_2383":42769},[],"/docs/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_2856":672,"_25053":663,"_5":25365,"_17489":42771,"_23720":42772,"_2383":42773},[],"/docs/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_2856":673,"_25053":663,"_5":25365,"_17489":42775,"_23720":42776,"_2383":42777},[],"/docs/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_2856":674,"_25053":663,"_5":25365,"_17489":42779,"_23720":42780,"_2383":42781},[],"/docs/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_2856":675,"_25053":663,"_5":25365,"_17489":42783,"_23720":42784,"_2383":42785},[],"/docs/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_2856":676,"_25053":663,"_17489":42787,"_5":17384,"_23720":663,"_2383":42788},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_2856":677,"_25053":663,"_17489":42790,"_5":17384,"_23720":42744,"_2383":42791},[],"The audit body includes:",{"_2856":678,"_25053":663,"_17489":42793,"_5":17384,"_23720":42744,"_2383":42794},[],"input: data received by the operation;",{"_2856":679,"_25053":663,"_17489":42796,"_5":17384,"_23720":42744,"_2383":42797},[],"has\\_error: whether the service returned an error;",{"_2856":680,"_25053":663,"_17489":42799,"_5":17384,"_23720":42744,"_2383":42800},[],"output: produced result or error message;",{"_2856":681,"_25053":663,"_17489":42802,"_5":17384,"_23720":42744,"_2383":42803},[],"principals: identifiers of the principals that matched the request.",{"_2856":682,"_25053":663,"_17489":42805,"_5":17384,"_23720":42744,"_2383":42806},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_2856":683,"_25053":663,"_17489":42808,"_5":17384,"_23720":42744,"_2383":42809},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_2856":684,"_25053":663,"_17489":42811,"_5":17384,"_23720":42748,"_2383":42812},[],"The backend applies auditing to mutations of:",{"_2856":685,"_25053":663,"_17489":42814,"_5":17384,"_23720":42748,"_2383":42815},[],"authorities, certificates and issuance profiles;",{"_2856":686,"_25053":663,"_17489":42817,"_5":17384,"_23720":42748,"_2383":42818},[],"keys and KMS engines;",{"_2856":687,"_25053":663,"_17489":42820,"_5":17384,"_23720":42748,"_2383":42821},[],"devices and identities;",{"_2856":688,"_25053":663,"_17489":42823,"_5":17384,"_23720":42748,"_2383":42824},[],"DMSs and enrollment operations;",{"_2856":689,"_25053":663,"_17489":42826,"_5":17384,"_23720":42748,"_2383":42827},[],"validation functions and CRL;",{"_2856":690,"_25053":663,"_17489":42829,"_5":17384,"_23720":42748,"_2383":42830},[],"principals, policies and authorization grants.",{"_2856":691,"_25053":663,"_17489":42832,"_5":17384,"_23720":42748,"_2383":42833},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_2856":692,"_25053":663,"_17489":42835,"_5":17384,"_23720":42752,"_2383":42836},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_2856":693,"_25053":663,"_17489":42838,"_5":17384,"_23720":42752,"_2383":42839},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_2856":694,"_25053":663,"_17489":42841,"_5":17384,"_23720":42752,"_2383":42842},[],"Design the consumer to:",{"_2856":695,"_25053":663,"_17489":42844,"_5":17384,"_23720":42752,"_2383":42845},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_2856":696,"_25053":663,"_17489":42847,"_5":17384,"_23720":42752,"_2383":42848},[],"keep the complete CloudEvent unmodified;",{"_2856":697,"_25053":663,"_17489":42850,"_5":17384,"_23720":42752,"_2383":42851},[],"record the ingestion time and detect duplicates by ID;",{"_2856":698,"_25053":663,"_17489":42853,"_5":17384,"_23720":42752,"_2383":42854},[],"encrypt in transit and at rest;",{"_2856":699,"_25053":663,"_17489":42856,"_5":17384,"_23720":42752,"_2383":42857},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_2856":700,"_25053":663,"_17489":42859,"_5":17384,"_23720":42752,"_2383":42860},[],"apply an explicit retention and legal hold policy;",{"_2856":701,"_25053":663,"_17489":42862,"_5":17384,"_23720":42752,"_2383":42863},[],"alert if it stops consuming or the pending queue grows.",{"_2856":702,"_25053":663,"_17489":42865,"_5":17384,"_23720":42756,"_2383":42866},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_2856":703,"_25053":663,"_17489":42868,"_5":17384,"_23720":42756,"_2383":42869},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_2856":704,"_25053":663,"_17489":42871,"_5":17384,"_23720":42764,"_2383":42872},[],"Start from the reported time and normalize every source to UTC.",{"_2856":705,"_25053":663,"_17489":42874,"_5":17384,"_23720":42768,"_2383":42875},[],"Filter by event type, service source and resource identifier.",{"_2856":706,"_25053":663,"_17489":42877,"_5":17384,"_23720":42772,"_2383":42878},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_2856":707,"_25053":663,"_17489":42880,"_5":17384,"_23720":42776,"_2383":42881},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_2856":708,"_25053":663,"_17489":42883,"_5":17384,"_23720":42780,"_2383":42884},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_2856":709,"_25053":663,"_17489":42886,"_5":17384,"_23720":42784,"_2383":42887},[],"Generate a controlled mutation in a test environment and check that:",{"_2856":710,"_25053":663,"_17489":42889,"_5":17384,"_23720":42784,"_2383":42890},[],"a successful audit event appears;",{"_2856":711,"_25053":663,"_17489":42892,"_5":17384,"_23720":42784,"_2383":42893},[],"the principal matches the identity used;",{"_2856":712,"_25053":663,"_17489":42895,"_5":17384,"_23720":42784,"_2383":42896},[],"the consumer persists it exactly once;",{"_2856":713,"_25053":663,"_17489":42898,"_5":17384,"_23720":42784,"_2383":42899},[],"it can be retrieved by resource, actor and period;",{"_2856":714,"_25053":663,"_17489":42901,"_5":17384,"_23720":42784,"_2383":42902},[],"a consumer outage raises an alert.",{"_2856":715,"_25053":663,"_17489":42904,"_5":17384,"_23720":42784,"_2383":42905},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_2856":716,"_25053":716,"_5":12268,"_2383":42907,"_25368":42908,"_17489":42909,"_23720":716},"Platform architecture",[40693,42037],[],{"_2856":717,"_25053":716,"_17489":42911,"_5":17384,"_23720":716,"_2383":42912},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_2856":718,"_25053":716,"_5":25365,"_17489":42914,"_23720":42915,"_2383":42916},[],"/docs/platform/concepts/architecture#control-plane","Control plane",{"_2856":719,"_25053":716,"_5":25365,"_17489":42918,"_23720":42919,"_2383":42920},[],"/docs/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_2856":720,"_25053":716,"_5":25365,"_17489":42922,"_23720":42923,"_2383":42924},[],"/docs/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_2856":721,"_25053":716,"_5":25365,"_17489":42926,"_23720":42927,"_2383":42928},[],"/docs/platform/concepts/architecture#status-and-validation","Status and validation",{"_2856":722,"_25053":716,"_5":25365,"_17489":42930,"_23720":42931,"_2383":42932},[],"/docs/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_2856":723,"_25053":716,"_17489":42934,"_5":17384,"_23720":716,"_2383":42935},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_2856":724,"_25053":716,"_17489":42937,"_5":17384,"_23720":716,"_2383":42938},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_2856":725,"_25053":716,"_17489":42940,"_5":17384,"_23720":42915,"_2383":42941},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_2856":726,"_25053":716,"_17489":42943,"_5":17384,"_23720":42919,"_2383":42944},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_2856":727,"_25053":716,"_17489":42946,"_5":17384,"_23720":42923,"_2383":42947},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_2856":728,"_25053":716,"_17489":42949,"_5":17384,"_23720":42927,"_2383":42950},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_2856":729,"_25053":716,"_17489":42952,"_5":17384,"_23720":42931,"_2383":42953},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_2856":730,"_25053":730,"_5":12268,"_2383":42955,"_25368":42956,"_17489":42957,"_23720":730},"How Lamassu works",[40693,42037],[],{"_2856":731,"_25053":730,"_17489":42959,"_5":17384,"_23720":730,"_2383":42960},[],"The mental model of trust, keys, certificates and devices.",{"_2856":732,"_25053":730,"_5":25365,"_17489":42962,"_23720":42963,"_2383":42964},[],"/docs/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_2856":733,"_25053":730,"_5":25365,"_17489":42966,"_23720":42967,"_2383":42968},[],"/docs/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_2856":734,"_25053":730,"_17489":42970,"_5":17384,"_23720":730,"_2383":42971},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_2856":735,"_25053":730,"_17489":42973,"_5":17384,"_23720":42963,"_2383":42974},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_2856":736,"_25053":730,"_17489":42976,"_5":17384,"_23720":42963,"_2383":42977},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_2856":737,"_25053":730,"_17489":42979,"_5":17384,"_23720":42963,"_2383":42980},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_2856":738,"_25053":730,"_17489":42982,"_5":17384,"_23720":42963,"_2383":42983},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_2856":739,"_25053":730,"_17489":42985,"_5":17384,"_23720":42963,"_2383":42986},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_2856":740,"_25053":730,"_17489":42988,"_5":17384,"_23720":42967,"_2383":42989},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_2856":741,"_25053":730,"_17489":42991,"_5":17384,"_23720":42967,"_2383":42992},[],"A DMS relates that CA to an enrollment policy.",{"_2856":742,"_25053":730,"_17489":42994,"_5":17384,"_23720":42967,"_2383":42995},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_2856":743,"_25053":730,"_17489":42997,"_5":17384,"_23720":42967,"_2383":42998},[],"Lamassu keeps the inventory, history and status of the identity.",{"_2856":744,"_25053":730,"_17489":43000,"_5":17384,"_23720":42967,"_2383":43001},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_2856":745,"_25053":730,"_17489":43003,"_5":17384,"_23720":42967,"_2383":43004},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_2856":746,"_25053":730,"_17489":43006,"_5":17384,"_23720":42967,"_2383":43007},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2856":747,"_25053":747,"_5":12268,"_2383":43009,"_25368":43010,"_17489":43012,"_23720":747},"Devices and identities",[40693,42037,43011,43009],"IoT Fleets",[],{"_2856":748,"_25053":747,"_17489":43014,"_5":17384,"_23720":747,"_2383":43015},[],"Register, inspect and retire devices while checking their current identity and history.",{"_2856":749,"_25053":747,"_5":25365,"_17489":43017,"_23720":43018,"_2383":43019},[],"/docs/platform/iot-fleets/device-management#device-states","Device states",{"_2856":750,"_25053":747,"_5":25365,"_17489":43021,"_23720":43022,"_2383":43023},[],"/docs/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_2856":751,"_25053":747,"_5":25365,"_17489":43025,"_23720":43026,"_2383":43027},[],"/docs/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_2856":752,"_25053":747,"_5":25365,"_17489":43029,"_23720":43030,"_2383":43031},[],"/docs/platform/iot-fleets/device-management#create-the-device","Create the device",{"_2856":753,"_25053":747,"_5":25365,"_17489":43033,"_23720":43034,"_2383":43035},[],"/docs/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_2856":754,"_25053":747,"_5":25365,"_17489":43037,"_23720":43038,"_2383":43039},[],"/docs/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_2856":755,"_25053":747,"_5":25365,"_17489":43041,"_23720":43042,"_2383":43043},[],"/docs/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_2856":756,"_25053":747,"_5":25365,"_17489":43045,"_23720":43046,"_2383":43047},[],"/docs/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_2856":757,"_25053":747,"_5":25365,"_17489":43049,"_23720":43050,"_2383":43051},[],"/docs/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_2856":758,"_25053":747,"_5":25365,"_17489":43053,"_23720":43054,"_2383":43055},[],"/docs/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_2856":759,"_25053":747,"_5":25365,"_17489":43057,"_23720":43058,"_2383":43059},[],"/docs/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_2856":760,"_25053":747,"_17489":43061,"_5":17384,"_23720":747,"_2383":43062},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_2856":761,"_25053":747,"_17489":43064,"_5":17384,"_23720":747,"_2383":43065},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_2856":762,"_25053":747,"_17489":43067,"_5":17384,"_23720":43018,"_2383":43068},[],"Operational view",{"_2856":763,"_25053":747,"_17489":43070,"_5":17384,"_23720":43018,"_2383":43071},[],"Meaning",{"_2856":764,"_25053":747,"_17489":43073,"_5":17384,"_23720":43018,"_2383":43074},[],"**No Identity**",{"_2856":765,"_25053":747,"_17489":43076,"_5":17384,"_23720":43018,"_2383":43077},[],"A record exists without an associated identity.",{"_2856":766,"_25053":747,"_17489":43079,"_5":17384,"_23720":43018,"_2383":43080},[],"**Active**",{"_2856":767,"_25053":747,"_17489":43082,"_5":17384,"_23720":43018,"_2383":43083},[],"The slot is active; also check certificate dates, status and usages.",{"_2856":768,"_25053":747,"_17489":43085,"_5":17384,"_23720":43018,"_2383":43086},[],"**Renewal Pending**",{"_2856":769,"_25053":747,"_17489":43088,"_5":17384,"_23720":43018,"_2383":43089},[],"The identity is in the operational renewal window.",{"_2856":770,"_25053":747,"_17489":43091,"_5":17384,"_23720":43018,"_2383":43092},[],"**Expiring Soon**",{"_2856":771,"_25053":747,"_17489":43094,"_5":17384,"_23720":43018,"_2383":43095},[],"Expiration is approaching according to configured thresholds.",{"_2856":772,"_25053":747,"_17489":43097,"_5":17384,"_23720":43018,"_2383":43098},[],"**Expired**",{"_2856":773,"_25053":747,"_17489":43100,"_5":17384,"_23720":43018,"_2383":43101},[],"The identity has expired.",{"_2856":774,"_25053":747,"_17489":43103,"_5":17384,"_23720":43018,"_2383":43104},[],"**Revoked**",{"_2856":775,"_25053":747,"_17489":43106,"_5":17384,"_23720":43018,"_2383":43107},[],"The identity is marked revoked.",{"_2856":776,"_25053":747,"_17489":43109,"_5":17384,"_23720":43018,"_2383":43110},[],"**Decommissioned**",{"_2856":777,"_25053":747,"_17489":43112,"_5":17384,"_23720":43018,"_2383":43113},[],"The record is retired and ordinary updates do not restore operation.",{"_2856":778,"_25053":747,"_17489":43115,"_5":17384,"_23720":43018,"_2383":43116},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_2856":779,"_25053":747,"_17489":43118,"_5":17384,"_23720":43022,"_2383":43119},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_2856":780,"_25053":747,"_17489":43121,"_5":17384,"_23720":43022,"_2383":43122},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_2856":781,"_25053":747,"_17489":43124,"_5":17384,"_23720":43022,"_2383":43125},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_2856":782,"_25053":747,"_17489":43127,"_5":17384,"_23720":43022,"_2383":43128},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_2856":783,"_25053":747,"_17489":43130,"_5":17384,"_23720":43026,"_2383":43131},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_2856":784,"_25053":747,"_17489":43133,"_5":17384,"_23720":43030,"_2383":43134},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_2856":785,"_25053":747,"_17489":43136,"_5":17384,"_23720":43034,"_2383":43137},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_2856":786,"_25053":747,"_17489":43139,"_5":17384,"_23720":43038,"_2383":43140},[],"Add model, environment or location tags and an icon according to your inventory.",{"_2856":787,"_25053":747,"_17489":43142,"_5":17384,"_23720":43042,"_2383":43143},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_2856":788,"_25053":747,"_17489":43145,"_5":17384,"_23720":43042,"_2383":43146},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_2856":789,"_25053":747,"_17489":43148,"_5":17384,"_23720":43046,"_2383":43149},[],"From **No Identity**, use **Assign Identity**:",{"_2856":790,"_25053":747,"_17489":43151,"_5":17384,"_23720":43046,"_2383":43152},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_2856":791,"_25053":747,"_17489":43154,"_5":17384,"_23720":43046,"_2383":43155},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_2856":792,"_25053":747,"_17489":43157,"_5":17384,"_23720":43046,"_2383":43158},[],"Confirm and read the serial, active version and history again.",{"_2856":793,"_25053":747,"_17489":43160,"_5":17384,"_23720":43046,"_2383":43161},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_2856":794,"_25053":747,"_17489":43163,"_5":17384,"_23720":43046,"_2383":43164},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_2856":795,"_25053":747,"_17489":43166,"_5":17384,"_23720":43050,"_2383":43167},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_2856":796,"_25053":747,"_17489":43169,"_5":17384,"_23720":43050,"_2383":43170},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_2856":797,"_25053":747,"_17489":43172,"_5":17384,"_23720":43054,"_2383":43173},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_2856":798,"_25053":747,"_17489":43175,"_5":17384,"_23720":43054,"_2383":43176},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_2856":799,"_25053":747,"_17489":43178,"_5":17384,"_23720":43054,"_2383":43179},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_2856":800,"_25053":747,"_17489":43181,"_5":17384,"_23720":43054,"_2383":43182},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_2856":801,"_25053":747,"_17489":43184,"_5":17384,"_23720":43058,"_2383":43185},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2856":802,"_25053":747,"_17489":43187,"_5":17384,"_23720":43058,"_2383":43188},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2856":803,"_25053":803,"_5":12268,"_2383":43190,"_25368":43191,"_17489":43193,"_23720":803},"Bootstrap identity and authentication",[40693,42037,43011,43009,43192],"Enrollment with PKI",[],{"_2856":804,"_25053":803,"_17489":43195,"_5":17384,"_23720":803,"_2383":43196},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_2856":805,"_25053":803,"_5":25365,"_17489":43198,"_23720":43199,"_2383":43200},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_2856":806,"_25053":803,"_5":25365,"_17489":43202,"_23720":43203,"_2383":43204},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_2856":807,"_25053":803,"_5":25365,"_17489":43206,"_23720":43207,"_2383":43208},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_2856":808,"_25053":803,"_5":25365,"_17489":43210,"_23720":43211,"_2383":43212},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_2856":809,"_25053":803,"_5":25365,"_17489":43214,"_23720":43215,"_2383":43216},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_2856":810,"_25053":803,"_17489":43218,"_5":17384,"_23720":803,"_2383":43219},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_2856":811,"_25053":803,"_17489":43221,"_5":17384,"_23720":43199,"_2383":43222},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_2856":812,"_25053":803,"_17489":43224,"_5":17384,"_23720":43199,"_2383":43225},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_2856":813,"_25053":803,"_17489":43227,"_5":17384,"_23720":43203,"_2383":43228},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_2856":814,"_25053":803,"_17489":43230,"_5":17384,"_23720":43203,"_2383":43231},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_2856":815,"_25053":803,"_17489":43233,"_5":17384,"_23720":43203,"_2383":43234},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_2856":816,"_25053":803,"_17489":43236,"_5":17384,"_23720":43207,"_2383":43237},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_2856":817,"_25053":803,"_17489":43239,"_5":17384,"_23720":43207,"_2383":43240},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_2856":818,"_25053":803,"_17489":43242,"_5":17384,"_23720":43211,"_2383":43243},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_2856":819,"_25053":803,"_17489":43245,"_5":17384,"_23720":43211,"_2383":43246},[],"Example body:",{"_2856":820,"_25053":803,"_17489":43248,"_5":17384,"_23720":43211,"_2383":43249},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_2856":821,"_25053":803,"_17489":43251,"_5":17384,"_23720":43211,"_2383":43252},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_2856":822,"_25053":803,"_17489":43254,"_5":17384,"_23720":43211,"_2383":43255},[],"Continuation requires a successful HTTP response and JSON:",{"_2856":823,"_25053":803,"_17489":43257,"_5":17384,"_23720":43211,"_2383":43258},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_2856":824,"_25053":803,"_17489":43260,"_5":17384,"_23720":43215,"_2383":43261},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_2856":825,"_25053":803,"_17489":43263,"_5":17384,"_23720":43215,"_2383":43264},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_2856":826,"_25053":826,"_5":12268,"_2383":43266,"_25368":43267,"_17489":43268,"_23720":826},"Configure and operate the DMS",[40693,42037,43011,43009,43192],[],{"_2856":827,"_25053":826,"_17489":43270,"_5":17384,"_23720":826,"_2383":43271},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_2856":828,"_25053":826,"_5":25365,"_17489":43273,"_23720":43274,"_2383":40703},[],"/docs/platform/iot-fleets/enrollment/dms#before-you-begin",{"_2856":829,"_25053":826,"_5":25365,"_17489":43276,"_23720":43277,"_2383":43278},[],"/docs/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_2856":830,"_25053":826,"_5":25365,"_17489":43280,"_23720":43281,"_2383":43282},[],"/docs/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_2856":831,"_25053":826,"_5":25365,"_17489":43284,"_23720":43285,"_2383":43286},[],"/docs/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_2856":832,"_25053":826,"_5":25365,"_17489":43288,"_23720":43289,"_2383":43290},[],"/docs/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_2856":833,"_25053":826,"_5":25365,"_17489":43292,"_23720":43293,"_2383":43294},[],"/docs/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_2856":834,"_25053":826,"_5":25365,"_17489":43296,"_23720":43297,"_2383":43298},[],"/docs/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_2856":835,"_25053":826,"_5":25365,"_17489":43300,"_23720":43301,"_2383":43302},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_2856":836,"_25053":826,"_5":25365,"_17489":43304,"_23720":43305,"_2383":43306},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_2856":837,"_25053":826,"_5":25365,"_17489":43308,"_23720":43309,"_2383":43310},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_2856":838,"_25053":826,"_5":25365,"_17489":43312,"_23720":43313,"_2383":43314},[],"/docs/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_2856":839,"_25053":826,"_5":25365,"_17489":43316,"_23720":43317,"_2383":43318},[],"/docs/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_2856":840,"_25053":826,"_5":25365,"_17489":43320,"_23720":43321,"_2383":43322},[],"/docs/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_2856":841,"_25053":826,"_5":25365,"_17489":43324,"_23720":43325,"_2383":43326},[],"/docs/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_2856":842,"_25053":826,"_5":25365,"_17489":43328,"_23720":43329,"_2383":43330},[],"/docs/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_2856":843,"_25053":826,"_5":25365,"_17489":43332,"_23720":43333,"_2383":43334},[],"/docs/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_2856":844,"_25053":826,"_5":25365,"_17489":43336,"_23720":43337,"_2383":43338},[],"/docs/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_2856":845,"_25053":826,"_5":25365,"_17489":43340,"_23720":43341,"_2383":43342},[],"/docs/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_2856":846,"_25053":826,"_17489":43344,"_5":17384,"_23720":826,"_2383":43345},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_2856":847,"_25053":826,"_17489":43347,"_5":17384,"_23720":43274,"_2383":43348},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_2856":848,"_25053":826,"_17489":43350,"_5":17384,"_23720":43274,"_2383":43351},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_2856":849,"_25053":826,"_17489":43353,"_5":17384,"_23720":43281,"_2383":43354},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_2856":850,"_25053":826,"_17489":43356,"_5":17384,"_23720":43285,"_2383":43357},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_2856":851,"_25053":826,"_17489":43359,"_5":17384,"_23720":43289,"_2383":43360},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_2856":852,"_25053":826,"_17489":43362,"_5":17384,"_23720":43293,"_2383":43363},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_2856":853,"_25053":826,"_17489":43365,"_5":17384,"_23720":43297,"_2383":43366},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_2856":854,"_25053":826,"_17489":43368,"_5":17384,"_23720":43305,"_2383":43369},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_2856":855,"_25053":826,"_17489":43371,"_5":17384,"_23720":43305,"_2383":43372},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_2856":856,"_25053":826,"_17489":43374,"_5":17384,"_23720":43309,"_2383":43375},[],"`settings.enrollment_settings` field",{"_2856":857,"_25053":826,"_17489":43377,"_5":17384,"_23720":43309,"_2383":43378},[],"Decision",{"_2856":858,"_25053":826,"_17489":43380,"_5":17384,"_23720":43309,"_2383":43381},[],"`protocol`",{"_2856":859,"_25053":826,"_17489":43383,"_5":17384,"_23720":43309,"_2383":43384},[],"`EST_RFC7030` for these operations.",{"_2856":860,"_25053":826,"_17489":43386,"_5":17384,"_23720":43309,"_2383":43387},[],"`enrollment_ca`",{"_2856":861,"_25053":826,"_17489":43389,"_5":17384,"_23720":43309,"_2383":43390},[],"ID of the signing CA.",{"_2856":862,"_25053":826,"_17489":43392,"_5":17384,"_23720":43309,"_2383":43393},[],"`verify_csr_signature`",{"_2856":863,"_25053":826,"_17489":43395,"_5":17384,"_23720":43309,"_2383":43396},[],"Keep `true` to verify CSR key possession.",{"_2856":864,"_25053":826,"_17489":43398,"_5":17384,"_23720":43309,"_2383":43399},[],"`enable_replaceable_enrollment`",{"_2856":865,"_25053":826,"_17489":43401,"_5":17384,"_23720":43309,"_2383":43402},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_2856":866,"_25053":826,"_17489":43404,"_5":17384,"_23720":43309,"_2383":43405},[],"`est_rfc7030_settings.auth_mode`",{"_2856":867,"_25053":826,"_17489":43407,"_5":17384,"_23720":43309,"_2383":43408},[],"One of the four authentication modes.",{"_2856":868,"_25053":826,"_17489":43410,"_5":17384,"_23720":43309,"_2383":43411},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_2856":869,"_25053":826,"_17489":43413,"_5":17384,"_23720":43313,"_2383":43414},[],"The blocks are independent:",{"_2856":870,"_25053":826,"_17489":43416,"_5":17384,"_23720":43313,"_2383":43417},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_2856":871,"_25053":826,"_17489":43419,"_5":17384,"_23720":43313,"_2383":43420},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_2856":872,"_25053":826,"_17489":43422,"_5":17384,"_23720":43313,"_2383":43423},[],"`auth_mode`",{"_2856":873,"_25053":826,"_17489":43425,"_5":17384,"_23720":43313,"_2383":43426},[],"Control applied in the configured operation",{"_2856":874,"_25053":826,"_17489":43428,"_5":17384,"_23720":43313,"_2383":43429},[],"`CLIENT_CERTIFICATE`",{"_2856":875,"_25053":826,"_17489":43431,"_5":17384,"_23720":43313,"_2383":43432},[],"Presented certificate validation.",{"_2856":876,"_25053":826,"_17489":43434,"_5":17384,"_23720":43313,"_2383":43435},[],"`EXTERNAL_WEBHOOK`",{"_2856":877,"_25053":826,"_17489":43437,"_5":17384,"_23720":43313,"_2383":43438},[],"Configured webhook authorization.",{"_2856":878,"_25053":826,"_17489":43440,"_5":17384,"_23720":43313,"_2383":43441},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_2856":879,"_25053":826,"_17489":43443,"_5":17384,"_23720":43313,"_2383":43444},[],"Certificate validation followed by webhook approval.",{"_2856":880,"_25053":826,"_17489":43446,"_5":17384,"_23720":43313,"_2383":43447},[],"`NO_AUTH`",{"_2856":881,"_25053":826,"_17489":43449,"_5":17384,"_23720":43313,"_2383":43450},[],"No DMS requester authentication.",{"_2856":882,"_25053":826,"_17489":43452,"_5":17384,"_23720":43313,"_2383":43453},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_2856":883,"_25053":826,"_17489":43455,"_5":17384,"_23720":43313,"_2383":43456},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_2856":884,"_25053":826,"_17489":43458,"_5":17384,"_23720":43313,"_2383":43459},[],"For certificate re-enrollment, the validator uses the enrollment CA, then `additional_validation_cas`, and `enable_expired_renewal`. Do not assume copying initial `validation_cas` changes those issuers.",{"_2856":885,"_25053":826,"_17489":43461,"_5":17384,"_23720":43313,"_2383":43462},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_2856":886,"_25053":826,"_17489":43464,"_5":17384,"_23720":43317,"_2383":43465},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_2856":887,"_25053":826,"_17489":43467,"_5":17384,"_23720":43317,"_2383":43468},[],"`external_webhook_settings` field",{"_2856":888,"_25053":826,"_17489":43470,"_5":17384,"_23720":43317,"_2383":43378},[],{"_2856":889,"_25053":826,"_17489":43472,"_5":17384,"_23720":43317,"_2383":43473},[],"`url`",{"_2856":890,"_25053":826,"_17489":43475,"_5":17384,"_23720":43317,"_2383":43476},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_2856":891,"_25053":826,"_17489":43478,"_5":17384,"_23720":43317,"_2383":43479},[],"`method`",{"_2856":892,"_25053":826,"_17489":43481,"_5":17384,"_23720":43317,"_2383":43482},[],"`POST` or `PUT`; `POST` by default.",{"_2856":893,"_25053":826,"_17489":43484,"_5":17384,"_23720":43317,"_2383":43485},[],"`name`",{"_2856":894,"_25053":826,"_17489":43487,"_5":17384,"_23720":43317,"_2383":43488},[],"Label used in service logs.",{"_2856":895,"_25053":826,"_17489":43490,"_5":17384,"_23720":43317,"_2383":43491},[],"`config.auth_mode`",{"_2856":896,"_25053":826,"_17489":43493,"_5":17384,"_23720":43317,"_2383":43494},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_2856":897,"_25053":826,"_17489":43496,"_5":17384,"_23720":43317,"_2383":43497},[],"`config.apikey_options`",{"_2856":898,"_25053":826,"_17489":43499,"_5":17384,"_23720":43317,"_2383":43500},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_2856":899,"_25053":826,"_17489":43502,"_5":17384,"_23720":43317,"_2383":43503},[],"`config.jwt_options`",{"_2856":900,"_25053":826,"_17489":43505,"_5":17384,"_23720":43317,"_2383":43506},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_2856":901,"_25053":826,"_17489":43508,"_5":17384,"_23720":43317,"_2383":43509},[],"`config.mtls_options`",{"_2856":902,"_25053":826,"_17489":43511,"_5":17384,"_23720":43317,"_2383":43512},[],"Required for `mtls`: `cert_content` and `key_content` as inline PEM.",{"_2856":903,"_25053":826,"_17489":43514,"_5":17384,"_23720":43317,"_2383":43515},[],"`config.insecure_skip_verify`",{"_2856":904,"_25053":826,"_17489":43517,"_5":17384,"_23720":43317,"_2383":43518},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_2856":905,"_25053":826,"_17489":43520,"_5":17384,"_23720":43317,"_2383":43521},[],"`config.call_timeout`",{"_2856":906,"_25053":826,"_17489":43523,"_5":17384,"_23720":43317,"_2383":43524},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_2856":907,"_25053":826,"_17489":43526,"_5":17384,"_23720":43317,"_2383":43527},[],"Rules for that configuration:",{"_2856":908,"_25053":826,"_17489":43529,"_5":17384,"_23720":43317,"_2383":43530},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so supply the PEM as `mtls_options.cert_content` and `key_content`.",{"_2856":909,"_25053":826,"_17489":43532,"_5":17384,"_23720":43317,"_2383":43533},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_2856":910,"_25053":826,"_17489":43535,"_5":17384,"_23720":43317,"_2383":43536},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_2856":911,"_25053":826,"_17489":43538,"_5":17384,"_23720":43317,"_2383":43539},[],"The API ignores the legacy fields `validate_server_cert`, `apikey`, `oidc` and `mtls`. A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` that still carries only the legacy option fields (`apikey`, `oidc`, `mtls`) fails validation with 400; only legacy `noauth` bodies are accepted, and their credentials are dropped.",{"_2856":912,"_25053":826,"_17489":43541,"_5":17384,"_23720":43317,"_2383":43542},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_2856":913,"_25053":826,"_17489":43544,"_5":17384,"_23720":43317,"_2383":43545},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_2856":914,"_25053":826,"_17489":43547,"_5":17384,"_23720":43317,"_2383":43548},[],"Migration `20260604110000` copies initial authentication into renewal settings if missing and the required structure exists. It preserves existing configuration. After upgrading, read both blocks; if your version’s console does not expose independent settings, use the DMS API.",{"_2856":915,"_25053":826,"_17489":43550,"_5":17384,"_23720":43317,"_2383":43551},[],"Migration `20261021120000` rewrites every stored webhook config into this layout: `validate_server_cert` becomes the negated `insecure_skip_verify` (a config where `validate_server_cert` was false keeps skipping verification), `oidc` becomes `jwt_options`, `apikey` becomes `apikey_options` and `mtls` becomes `mtls_options`. When both the legacy certificate and key are PEM, they move into `mtls_options.cert_content` and `key_content` and need no action. Otherwise, including a mixed config (PEM certificate, file-path key), both values become `mtls_options.cert_file` and `key_file`. Delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are re-entered as PEM content, or the leftover file fields are removed if the webhook does not use mTLS. If your version's console does not expose those fields, edit the DMS through the DMS API.",{"_2856":916,"_25053":826,"_17489":43553,"_5":17384,"_23720":43321,"_2383":43554},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_2856":917,"_25053":826,"_17489":43556,"_5":17384,"_23720":43325,"_2383":43557},[],"`settings.reenrollment_settings` field",{"_2856":918,"_25053":826,"_17489":43559,"_5":17384,"_23720":43325,"_2383":41076},[],{"_2856":919,"_25053":826,"_17489":43561,"_5":17384,"_23720":43325,"_2383":43562},[],"`reenrollment_delta`",{"_2856":920,"_25053":826,"_17489":43564,"_5":17384,"_23720":43325,"_2383":43565},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_2856":921,"_25053":826,"_17489":43567,"_5":17384,"_23720":43325,"_2383":43568},[],"`preventive_delta`",{"_2856":922,"_25053":826,"_17489":43570,"_5":17384,"_23720":43325,"_2383":43571},[],"Preventive operational monitoring threshold.",{"_2856":923,"_25053":826,"_17489":43573,"_5":17384,"_23720":43325,"_2383":43574},[],"`critical_delta`",{"_2856":924,"_25053":826,"_17489":43576,"_5":17384,"_23720":43325,"_2383":43577},[],"Critical operational monitoring threshold.",{"_2856":925,"_25053":826,"_17489":43579,"_5":17384,"_23720":43325,"_2383":43580},[],"`enable_expired_renewal`",{"_2856":926,"_25053":826,"_17489":43582,"_5":17384,"_23720":43325,"_2383":43583},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_2856":927,"_25053":826,"_17489":43585,"_5":17384,"_23720":43325,"_2383":43586},[],"`additional_validation_cas`",{"_2856":928,"_25053":826,"_17489":43588,"_5":17384,"_23720":43325,"_2383":43589},[],"Additional mTLS credential issuers during migration.",{"_2856":929,"_25053":826,"_17489":43591,"_5":17384,"_23720":43325,"_2383":43592},[],"`revoke_on_reenrollment`",{"_2856":930,"_25053":826,"_17489":43594,"_5":17384,"_23720":43325,"_2383":43595},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_2856":931,"_25053":826,"_17489":43597,"_5":17384,"_23720":43325,"_2383":43598},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_2856":932,"_25053":826,"_17489":43600,"_5":17384,"_23720":43329,"_2383":43601},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. Algorithm and size come from its `key` field; the profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_2856":933,"_25053":826,"_17489":43603,"_5":17384,"_23720":43333,"_2383":41070},[],{"_2856":934,"_25053":826,"_17489":43605,"_5":17384,"_23720":43333,"_2383":43606},[],"Published material",{"_2856":935,"_25053":826,"_17489":43608,"_5":17384,"_23720":43333,"_2383":43609},[],"**Include Lamassu System CA**",{"_2856":936,"_25053":826,"_17489":43611,"_5":17384,"_23720":43333,"_2383":43612},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_2856":937,"_25053":826,"_17489":43614,"_5":17384,"_23720":43333,"_2383":43615},[],"**Include Enrollment CA**",{"_2856":938,"_25053":826,"_17489":43617,"_5":17384,"_23720":43333,"_2383":43618},[],"Selected issuing CA certificate.",{"_2856":939,"_25053":826,"_17489":43620,"_5":17384,"_23720":43333,"_2383":43621},[],"**Managed CAs**",{"_2856":940,"_25053":826,"_17489":43623,"_5":17384,"_23720":43333,"_2383":43624},[],"Explicitly selected CA certificates.",{"_2856":941,"_25053":826,"_17489":43626,"_5":17384,"_23720":43333,"_2383":43627},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_2856":942,"_25053":826,"_17489":43629,"_5":17384,"_23720":43337,"_2383":43630},[],"**Edit** changes name, settings and metadata. Backend updates replace these complete blocks; read the DMS before sending API edits to avoid losing fields.",{"_2856":943,"_25053":826,"_17489":43632,"_5":17384,"_23720":43337,"_2383":43633},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_2856":944,"_25053":826,"_17489":43635,"_5":17384,"_23720":43337,"_2383":43636},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_2856":945,"_25053":826,"_17489":43638,"_5":17384,"_23720":43341,"_2383":43639},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_2856":946,"_25053":946,"_5":12268,"_2383":43641,"_25368":43642,"_17489":43643,"_23720":946},"Integrate the EST client",[40693,42037,43011,43009,43192],[],{"_2856":947,"_25053":946,"_17489":43645,"_5":17384,"_23720":946,"_2383":43646},[],"Prepare trust, send a CSR and check the identity you receive.",{"_2856":948,"_25053":946,"_5":25365,"_17489":43648,"_23720":43649,"_2383":40703},[],"/docs/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_2856":949,"_25053":946,"_5":25365,"_17489":43651,"_23720":43652,"_2383":43653},[],"/docs/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_2856":950,"_25053":946,"_5":25365,"_17489":43655,"_23720":43656,"_2383":43657},[],"/docs/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_2856":951,"_25053":946,"_5":25365,"_17489":43659,"_23720":43660,"_2383":43661},[],"/docs/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_2856":952,"_25053":946,"_5":25365,"_17489":43663,"_23720":43664,"_2383":43665},[],"/docs/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_2856":953,"_25053":946,"_5":25365,"_17489":43667,"_23720":43668,"_2383":43669},[],"/docs/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_2856":954,"_25053":946,"_17489":43671,"_5":17384,"_23720":946,"_2383":43672},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_2856":955,"_25053":946,"_17489":43674,"_5":17384,"_23720":43649,"_2383":43675},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_2856":956,"_25053":946,"_17489":43677,"_5":17384,"_23720":43649,"_2383":43678},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_2856":957,"_25053":946,"_17489":43680,"_5":17384,"_23720":43649,"_2383":43681},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_2856":958,"_25053":946,"_17489":43683,"_5":17384,"_23720":43652,"_2383":43684},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_2856":959,"_25053":946,"_17489":43686,"_5":17384,"_23720":43652,"_2383":43687},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_2856":960,"_25053":946,"_17489":43689,"_5":17384,"_23720":43656,"_2383":43690},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_2856":961,"_25053":946,"_17489":43692,"_5":17384,"_23720":43656,"_2383":43693},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_2856":962,"_25053":946,"_17489":43695,"_5":17384,"_23720":43660,"_2383":43696},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_2856":963,"_25053":946,"_17489":43698,"_5":17384,"_23720":43660,"_2383":43699},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_2856":964,"_25053":946,"_17489":43701,"_5":17384,"_23720":43664,"_2383":43702},[],"For a root that issues directly:",{"_2856":965,"_25053":946,"_17489":43704,"_5":17384,"_23720":43664,"_2383":43705},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_2856":966,"_25053":946,"_17489":43707,"_5":17384,"_23720":43664,"_2383":43708},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_2856":967,"_25053":946,"_17489":43710,"_5":17384,"_23720":43668,"_2383":43711},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_2856":968,"_25053":968,"_5":12268,"_2383":43713,"_25368":43714,"_17489":43715,"_23720":968},"EST reference",[40693,42037,43011,43009,43192],[],{"_2856":969,"_25053":968,"_17489":43717,"_5":17384,"_23720":968,"_2383":43718},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_2856":970,"_25053":968,"_5":25365,"_17489":43720,"_23720":43721,"_2383":43722},[],"/docs/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_2856":971,"_25053":968,"_5":25365,"_17489":43724,"_23720":43725,"_2383":18993},[],"/docs/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2856":972,"_25053":968,"_5":25365,"_17489":43727,"_23720":43728,"_2383":21753},[],"/docs/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2856":973,"_25053":968,"_5":25365,"_17489":43730,"_23720":43731,"_2383":21760},[],"/docs/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2856":974,"_25053":968,"_5":25365,"_17489":43733,"_23720":43734,"_2383":21130},[],"/docs/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2856":975,"_25053":968,"_5":25365,"_17489":43736,"_23720":43737,"_2383":43738},[],"/docs/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_2856":976,"_25053":968,"_5":25365,"_17489":43740,"_23720":43741,"_2383":43742},[],"/docs/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_2856":977,"_25053":968,"_5":25365,"_17489":43744,"_23720":43745,"_2383":43746},[],"/docs/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_2856":978,"_25053":968,"_17489":43748,"_5":17384,"_23720":968,"_2383":43749},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_2856":979,"_25053":968,"_17489":43751,"_5":17384,"_23720":43721,"_2383":43752},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_2856":980,"_25053":968,"_17489":43754,"_5":17384,"_23720":43721,"_2383":43755},[],"Operation",{"_2856":981,"_25053":968,"_17489":43757,"_5":17384,"_23720":43721,"_2383":43758},[],"Method",{"_2856":982,"_25053":968,"_17489":43760,"_5":17384,"_23720":43721,"_2383":43761},[],"Authentication and condition",{"_2856":983,"_25053":968,"_17489":43763,"_5":17384,"_23720":43721,"_2383":43764},[],"`/cacerts`",{"_2856":984,"_25053":968,"_17489":43766,"_5":17384,"_23720":43721,"_2383":43767},[],"GET",{"_2856":985,"_25053":968,"_17489":43769,"_5":17384,"_23720":43721,"_2383":43770},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_2856":986,"_25053":968,"_17489":43772,"_5":17384,"_23720":43721,"_2383":43773},[],"`/simpleenroll`",{"_2856":987,"_25053":968,"_17489":43775,"_5":17384,"_23720":43721,"_2383":43776},[],"POST",{"_2856":988,"_25053":968,"_17489":43778,"_5":17384,"_23720":43721,"_2383":43779},[],"Initial authentication and DMS registration/replacement policy.",{"_2856":989,"_25053":968,"_17489":43781,"_5":17384,"_23720":43721,"_2383":43782},[],"`/simplereenroll`",{"_2856":990,"_25053":968,"_17489":43784,"_5":17384,"_23720":43721,"_2383":43776},[],{"_2856":991,"_25053":968,"_17489":43786,"_5":17384,"_23720":43721,"_2383":43787},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_2856":992,"_25053":968,"_17489":43789,"_5":17384,"_23720":43721,"_2383":43790},[],"`/serverkeygen`",{"_2856":993,"_25053":968,"_17489":43792,"_5":17384,"_23720":43721,"_2383":43776},[],{"_2856":994,"_25053":968,"_17489":43794,"_5":17384,"_23720":43721,"_2383":43795},[],"Initial authentication and admission; server generation enabled.",{"_2856":995,"_25053":968,"_17489":43797,"_5":17384,"_23720":43721,"_2383":43798},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_2856":996,"_25053":968,"_17489":43800,"_5":17384,"_23720":43725,"_2383":43801},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_2856":997,"_25053":968,"_17489":43803,"_5":17384,"_23720":43725,"_2383":43804},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_2856":998,"_25053":968,"_17489":43806,"_5":17384,"_23720":43728,"_2383":43807},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_2856":999,"_25053":968,"_17489":43809,"_5":17384,"_23720":43728,"_2383":43810},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_2856":1000,"_25053":968,"_17489":43812,"_5":17384,"_23720":43731,"_2383":43813},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_2856":1001,"_25053":968,"_17489":43815,"_5":17384,"_23720":43731,"_2383":43816},[],"The enrollment CA or an additional CA validates the credential in mTLS mode. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_2856":1002,"_25053":968,"_17489":43818,"_5":17384,"_23720":43734,"_2383":43819},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_2856":1003,"_25053":968,"_17489":43821,"_5":17384,"_23720":43734,"_2383":43822},[],"The code supports RSA and ECDSA with 224, 256, 384 or 521 bits. An unrecognized ECDSA size can fall back to 256; explicitly select a compatible size and check the resulting key. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_2856":1004,"_25053":968,"_17489":43824,"_5":17384,"_23720":43737,"_2383":43825},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_2856":1005,"_25053":968,"_17489":43827,"_5":17384,"_23720":43737,"_2383":43828},[],"Part",{"_2856":1006,"_25053":968,"_17489":43830,"_5":17384,"_23720":43737,"_2383":43831},[],"Content after decoding its Base64",{"_2856":1007,"_25053":968,"_17489":43833,"_5":17384,"_23720":43737,"_2383":43834},[],"`application/pkcs8`",{"_2856":1008,"_25053":968,"_17489":43836,"_5":17384,"_23720":43737,"_2383":43837},[],"Unencrypted DER PKCS#8 private key.",{"_2856":1009,"_25053":968,"_17489":43839,"_5":17384,"_23720":43737,"_2383":43840},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_2856":1010,"_25053":968,"_17489":43842,"_5":17384,"_23720":43737,"_2383":43843},[],"DER PKCS#7 containing the issued certificate.",{"_2856":1011,"_25053":968,"_17489":43845,"_5":17384,"_23720":43737,"_2383":43846},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_2856":1012,"_25053":968,"_17489":43848,"_5":17384,"_23720":43741,"_2383":43849},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_2856":1013,"_25053":968,"_17489":43851,"_5":17384,"_23720":43741,"_2383":43852},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_2856":1014,"_25053":968,"_17489":43854,"_5":17384,"_23720":43741,"_2383":43855},[],"Convert and check the result:",{"_2856":1015,"_25053":968,"_17489":43857,"_5":17384,"_23720":43741,"_2383":43858},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_2856":1016,"_25053":968,"_17489":43860,"_5":17384,"_23720":43745,"_2383":43861},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_2856":1017,"_25053":968,"_17489":43863,"_5":17384,"_23720":43745,"_2383":43864},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_2856":1018,"_25053":1018,"_5":12268,"_2383":43192,"_25368":43866,"_17489":43867,"_23720":1018},[40693,42037,43011,43009,43192],[],{"_2856":1019,"_25053":1018,"_17489":43869,"_5":17384,"_23720":1018,"_2383":43870},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_2856":1020,"_25053":1018,"_5":25365,"_17489":43872,"_23720":43873,"_2383":43874},[],"/docs/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_2856":1021,"_25053":1018,"_5":25365,"_17489":43876,"_23720":43877,"_2383":43878},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_2856":1022,"_25053":1018,"_5":25365,"_17489":43880,"_23720":43881,"_2383":43882},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_2856":1023,"_25053":1018,"_5":25365,"_17489":43884,"_23720":43885,"_2383":43886},[],"/docs/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_2856":1024,"_25053":1018,"_17489":43888,"_5":17384,"_23720":1018,"_2383":43889},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_2856":1025,"_25053":1018,"_17489":43891,"_5":17384,"_23720":43873,"_2383":43892},[],"The administrator prepares the CA, issuance profile and DMS.",{"_2856":1026,"_25053":1018,"_17489":43894,"_5":17384,"_23720":43873,"_2383":43895},[],"The integrator installs initial EST server trust and an admission credential.",{"_2856":1027,"_25053":1018,"_17489":43897,"_5":17384,"_23720":43873,"_2383":43898},[],"The client requests an identity for its `Device ID` through EST.",{"_2856":1028,"_25053":1018,"_17489":43900,"_5":17384,"_23720":43873,"_2383":43901},[],"Certificate, device binding and key/certificate installation are checked.",{"_2856":1029,"_25053":1018,"_17489":43903,"_5":17384,"_23720":43873,"_2383":43904},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_2856":1030,"_25053":1018,"_17489":43906,"_5":17384,"_23720":43873,"_2383":43907},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_2856":1031,"_25053":1018,"_17489":43909,"_5":17384,"_23720":43877,"_2383":43910},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2856":1032,"_25053":1018,"_17489":43912,"_5":17384,"_23720":43877,"_2383":43913},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2856":1033,"_25053":1018,"_17489":43915,"_5":17384,"_23720":43877,"_2383":43916},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2856":1034,"_25053":1018,"_17489":43918,"_5":17384,"_23720":43877,"_2383":43919},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2856":1035,"_25053":1018,"_17489":43921,"_5":17384,"_23720":43881,"_2383":43922},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2856":1036,"_25053":1018,"_17489":43924,"_5":17384,"_23720":43881,"_2383":43925},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2856":1037,"_25053":1018,"_17489":43927,"_5":17384,"_23720":43881,"_2383":43928},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2856":1038,"_25053":1018,"_17489":43930,"_5":17384,"_23720":43881,"_2383":43931},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2856":1039,"_25053":1018,"_17489":43933,"_5":17384,"_23720":43885,"_2383":43934},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract and migrations, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_2856":1040,"_25053":1018,"_17489":43936,"_5":17384,"_23720":43885,"_2383":43937},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_2856":1041,"_25053":1041,"_5":12268,"_2383":43939,"_25368":43940,"_17489":43941,"_23720":1041},"Provisioning strategies",[40693,42037,43011,43009,43192],[],{"_2856":1042,"_25053":1041,"_17489":43943,"_5":17384,"_23720":1041,"_2383":43944},[],"Choose device registration, identity authorization and key generation.",{"_2856":1043,"_25053":1041,"_5":25365,"_17489":43946,"_23720":43947,"_2383":43948},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_2856":1044,"_25053":1041,"_5":25365,"_17489":43950,"_23720":43951,"_2383":43952},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_2856":1045,"_25053":1041,"_5":25365,"_17489":43954,"_23720":43955,"_2383":43956},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_2856":1046,"_25053":1041,"_5":25365,"_17489":43958,"_23720":43959,"_2383":43960},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_2856":1047,"_25053":1041,"_5":25365,"_17489":43962,"_23720":43963,"_2383":43964},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_2856":1048,"_25053":1041,"_17489":43966,"_5":17384,"_23720":1041,"_2383":43967},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_2856":1049,"_25053":1041,"_17489":43969,"_5":17384,"_23720":43947,"_2383":43970},[],"Path",{"_2856":1050,"_25053":1041,"_17489":43972,"_5":17384,"_23720":43947,"_2383":43973},[],"When the device exists",{"_2856":1051,"_25053":1041,"_17489":43975,"_5":17384,"_23720":43947,"_2383":43976},[],"What to check",{"_2856":1052,"_25053":1041,"_17489":43978,"_5":17384,"_23720":43947,"_2383":43979},[],"Manual assignment",{"_2856":1053,"_25053":1041,"_17489":43981,"_5":17384,"_23720":43947,"_2383":43982},[],"An operator creates it before associating a certificate.",{"_2856":1054,"_25053":1041,"_17489":43984,"_5":17384,"_23720":43947,"_2383":43985},[],"ID, owning DMS, certificate CN and bound serial.",{"_2856":1055,"_25053":1041,"_17489":43987,"_5":17384,"_23720":43947,"_2383":43988},[],"EST with `JITP`",{"_2856":1056,"_25053":1041,"_17489":43990,"_5":17384,"_23720":43947,"_2383":43991},[],"Created for an unknown CN during `/simpleenroll`.",{"_2856":1057,"_25053":1041,"_17489":43993,"_5":17384,"_23720":43947,"_2383":43994},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_2856":1058,"_25053":1041,"_17489":43996,"_5":17384,"_23720":43947,"_2383":43997},[],"EST with `PRE_REGISTRATION`",{"_2856":1059,"_25053":1041,"_17489":43999,"_5":17384,"_23720":43947,"_2383":44000},[],"Must exist before `/simpleenroll`.",{"_2856":1060,"_25053":1041,"_17489":44002,"_5":17384,"_23720":43947,"_2383":44003},[],"Approved record, same DMS and replacement conditions for your version.",{"_2856":1061,"_25053":1041,"_17489":44005,"_5":17384,"_23720":43947,"_2383":44006},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_2856":1062,"_25053":1041,"_17489":44008,"_5":17384,"_23720":43947,"_2383":44009},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_2856":1063,"_25053":1041,"_17489":44011,"_5":17384,"_23720":43951,"_2383":44012},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_2856":1064,"_25053":1041,"_17489":44014,"_5":17384,"_23720":43951,"_2383":44015},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_2856":1065,"_25053":1041,"_17489":44017,"_5":17384,"_23720":43951,"_2383":44018},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_2856":1066,"_25053":1041,"_17489":44020,"_5":17384,"_23720":43955,"_2383":44021},[],"Decide initial enrollment and re-enrollment separately:",{"_2856":1067,"_25053":1041,"_17489":44023,"_5":17384,"_23720":43955,"_2383":44024},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_2856":1068,"_25053":1041,"_17489":44026,"_5":17384,"_23720":43955,"_2383":44027},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_2856":1069,"_25053":1041,"_17489":44029,"_5":17384,"_23720":43955,"_2383":44030},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_2856":1070,"_25053":1041,"_17489":44032,"_5":17384,"_23720":43955,"_2383":44033},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_2856":1071,"_25053":1041,"_17489":44035,"_5":17384,"_23720":43955,"_2383":44036},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_2856":1072,"_25053":1041,"_17489":44038,"_5":17384,"_23720":43959,"_2383":41070},[],{"_2856":1073,"_25053":1041,"_17489":44040,"_5":17384,"_23720":43959,"_2383":44041},[],"Material crossing EST",{"_2856":1074,"_25053":1041,"_17489":44043,"_5":17384,"_23720":43959,"_2383":44044},[],"Device-generated key",{"_2856":1075,"_25053":1041,"_17489":44046,"_5":17384,"_23720":43959,"_2383":44047},[],"Public CSR and certificate; the key stays on the client.",{"_2856":1076,"_25053":1041,"_17489":44049,"_5":17384,"_23720":43959,"_2383":44050},[],"Existing device key",{"_2856":1077,"_25053":1041,"_17489":44052,"_5":17384,"_23720":43959,"_2383":44053},[],"CSR signed with that key and a new certificate.",{"_2856":1078,"_25053":1041,"_17489":44055,"_5":17384,"_23720":43959,"_2383":43330},[],{"_2856":1079,"_25053":1041,"_17489":44057,"_5":17384,"_23720":43959,"_2383":44058},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_2856":1080,"_25053":1041,"_17489":44060,"_5":17384,"_23720":43959,"_2383":44061},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_2856":1081,"_25053":1041,"_17489":44063,"_5":17384,"_23720":43963,"_2383":44064},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_2856":1082,"_25053":1082,"_5":12268,"_2383":44066,"_25368":44067,"_17489":44068,"_23720":1082},"Renewal and recovery",[40693,42037,43011,43009,43192],[],{"_2856":1083,"_25053":1082,"_17489":44070,"_5":17384,"_23720":1082,"_2383":44071},[],"Renew without losing the identity and recover devices according to their actual state.",{"_2856":1084,"_25053":1082,"_5":25365,"_17489":44073,"_23720":44074,"_2383":44075},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_2856":1085,"_25053":1082,"_5":25365,"_17489":44077,"_23720":44078,"_2383":44079},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_2856":1086,"_25053":1082,"_5":25365,"_17489":44081,"_23720":44082,"_2383":44083},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_2856":1087,"_25053":1082,"_5":25365,"_17489":44085,"_23720":44086,"_2383":44087},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_2856":1088,"_25053":1082,"_5":25365,"_17489":44089,"_23720":44090,"_2383":44091},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_2856":1089,"_25053":1082,"_17489":44093,"_5":17384,"_23720":1082,"_2383":44094},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_2856":1090,"_25053":1082,"_17489":44096,"_5":17384,"_23720":44074,"_2383":44097},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_2856":1091,"_25053":1082,"_17489":44099,"_5":17384,"_23720":44074,"_2383":44100},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_2856":1092,"_25053":1082,"_17489":44102,"_5":17384,"_23720":44074,"_2383":44103},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_2856":1093,"_25053":1082,"_17489":44105,"_5":17384,"_23720":44074,"_2383":44106},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_2856":1094,"_25053":1082,"_17489":44108,"_5":17384,"_23720":44078,"_2383":44109},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_2856":1095,"_25053":1082,"_17489":44111,"_5":17384,"_23720":44078,"_2383":44112},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_2856":1096,"_25053":1082,"_17489":44114,"_5":17384,"_23720":44082,"_2383":44115},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_2856":1097,"_25053":1082,"_17489":44117,"_5":17384,"_23720":44082,"_2383":44118},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_2856":1098,"_25053":1082,"_17489":44120,"_5":17384,"_23720":44082,"_2383":44121},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_2856":1099,"_25053":1082,"_17489":44123,"_5":17384,"_23720":44086,"_2383":44124},[],"Situation",{"_2856":1100,"_25053":1082,"_17489":44126,"_5":17384,"_23720":44086,"_2383":44127},[],"Procedure",{"_2856":1101,"_25053":1082,"_17489":44129,"_5":17384,"_23720":44086,"_2383":44130},[],"Valid certificate, outside the window",{"_2856":1102,"_25053":1082,"_17489":44132,"_5":17384,"_23720":44086,"_2383":44133},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_2856":1103,"_25053":1082,"_17489":44135,"_5":17384,"_23720":44086,"_2383":44136},[],"Expired certificate, key available",{"_2856":1104,"_25053":1082,"_17489":44138,"_5":17384,"_23720":44086,"_2383":44139},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_2856":1105,"_25053":1082,"_17489":44141,"_5":17384,"_23720":44086,"_2383":44142},[],"Renewal through webhook or `NO_AUTH`",{"_2856":1106,"_25053":1082,"_17489":44144,"_5":17384,"_23720":44086,"_2383":44145},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_2856":1107,"_25053":1082,"_17489":44147,"_5":17384,"_23720":44086,"_2383":44148},[],"Lost or inaccessible key",{"_2856":1108,"_25053":1082,"_17489":44150,"_5":17384,"_23720":44086,"_2383":44151},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_2856":1109,"_25053":1082,"_17489":44153,"_5":17384,"_23720":44086,"_2383":44154},[],"Current identity revoked",{"_2856":1110,"_25053":1082,"_17489":44156,"_5":17384,"_23720":44086,"_2383":44157},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_2856":1111,"_25053":1082,"_17489":44159,"_5":17384,"_23720":44086,"_2383":44160},[],"Device without an identity",{"_2856":1112,"_25053":1082,"_17489":44162,"_5":17384,"_23720":44086,"_2383":44163},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_2856":1113,"_25053":1082,"_17489":44165,"_5":17384,"_23720":44086,"_2383":44166},[],"Retired device",{"_2856":1114,"_25053":1082,"_17489":44168,"_5":17384,"_23720":44086,"_2383":44169},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_2856":1115,"_25053":1082,"_17489":44171,"_5":17384,"_23720":44086,"_2383":44172},[],"Timeout, HTTP 500 or installation failure",{"_2856":1116,"_25053":1082,"_17489":44174,"_5":17384,"_23720":44086,"_2383":44175},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_2856":1117,"_25053":1082,"_17489":44177,"_5":17384,"_23720":44090,"_2383":44178},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_2856":1118,"_25053":1082,"_17489":44180,"_5":17384,"_23720":44090,"_2383":44181},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_2856":1119,"_25053":1119,"_5":12268,"_2383":44183,"_25368":44184,"_17489":44185,"_23720":1119},"Enrollment troubleshooting",[40693,42037,43011,43009,43192],[],{"_2856":1120,"_25053":1119,"_17489":44187,"_5":17384,"_23720":1119,"_2383":44188},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_2856":1121,"_25053":1119,"_5":25365,"_17489":44190,"_23720":44191,"_2383":44192},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_2856":1122,"_25053":1119,"_5":25365,"_17489":44194,"_23720":44195,"_2383":44196},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_2856":1123,"_25053":1119,"_5":25365,"_17489":44198,"_23720":44199,"_2383":43746},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_2856":1124,"_25053":1119,"_5":25365,"_17489":44201,"_23720":44202,"_2383":44203},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_2856":1125,"_25053":1119,"_17489":44205,"_5":17384,"_23720":1119,"_2383":44206},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_2856":1126,"_25053":1119,"_17489":44208,"_5":17384,"_23720":44195,"_2383":44209},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_2856":1127,"_25053":1119,"_17489":44211,"_5":17384,"_23720":44195,"_2383":44212},[],"Symptom or message",{"_2856":1128,"_25053":1119,"_17489":44214,"_5":17384,"_23720":44195,"_2383":43976},[],{"_2856":1129,"_25053":1119,"_17489":44216,"_5":17384,"_23720":44195,"_2383":44217},[],"curl rejects TLS, name or issuer",{"_2856":1130,"_25053":1119,"_17489":44219,"_5":17384,"_23720":44195,"_2383":44220},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_2856":1131,"_25053":1119,"_17489":44222,"_5":17384,"_23720":44195,"_2383":44223},[],"404 or missing APS",{"_2856":1132,"_25053":1119,"_17489":44225,"_5":17384,"_23720":44195,"_2383":44226},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_2856":1133,"_25053":1119,"_17489":44228,"_5":17384,"_23720":44195,"_2383":44229},[],"400, CSR or format error",{"_2856":1134,"_25053":1119,"_17489":44231,"_5":17384,"_23720":44195,"_2383":44232},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_2856":1135,"_25053":1119,"_17489":44234,"_5":17384,"_23720":44195,"_2383":44235},[],"Missing credential or invalid certificate",{"_2856":1136,"_25053":1119,"_17489":44237,"_5":17384,"_23720":44195,"_2383":44238},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_2856":1137,"_25053":1119,"_17489":44240,"_5":17384,"_23720":44195,"_2383":44241},[],"Webhook denies, times out or responds without authorization",{"_2856":1138,"_25053":1119,"_17489":44243,"_5":17384,"_23720":44195,"_2383":44244},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_2856":1139,"_25053":1119,"_17489":44246,"_5":17384,"_23720":44195,"_2383":44247},[],"`unexpected status code: <n>: redirects are not followed`",{"_2856":1140,"_25053":1119,"_17489":44249,"_5":17384,"_23720":44195,"_2383":44250},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_2856":1141,"_25053":1119,"_17489":44252,"_5":17384,"_23720":44195,"_2383":44253},[],"`webhook response exceeds 1048576 bytes`",{"_2856":1142,"_25053":1119,"_17489":44255,"_5":17384,"_23720":44195,"_2383":44256},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_2856":1143,"_25053":1119,"_17489":44258,"_5":17384,"_23720":44195,"_2383":44259},[],"`webhook config must not reference files`",{"_2856":1144,"_25053":1119,"_17489":44261,"_5":17384,"_23720":44195,"_2383":44262},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the PEM as `cert_content` and `key_content`; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the upgrade note in DMS.",{"_2856":1145,"_25053":1119,"_17489":44264,"_5":17384,"_23720":44195,"_2383":44265},[],"400 `struct validation error` creating or updating a DMS",{"_2856":1146,"_25053":1119,"_17489":44267,"_5":17384,"_23720":44195,"_2383":44268},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_2856":1147,"_25053":1119,"_17489":44270,"_5":17384,"_23720":44195,"_2383":44271},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_2856":1148,"_25053":1119,"_17489":44273,"_5":17384,"_23720":44195,"_2383":44274},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_2856":1149,"_25053":1119,"_17489":44276,"_5":17384,"_23720":44195,"_2383":44277},[],"`device not preregistered`",{"_2856":1150,"_25053":1119,"_17489":44279,"_5":17384,"_23720":44195,"_2383":44280},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_2856":1151,"_25053":1119,"_17489":44282,"_5":17384,"_23720":44195,"_2383":44283},[],"`forbiddenNewEnrollment`",{"_2856":1152,"_25053":1119,"_17489":44285,"_5":17384,"_23720":44195,"_2383":44286},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_2856":1153,"_25053":1119,"_17489":44288,"_5":17384,"_23720":44195,"_2383":44289},[],"Different owning DMS",{"_2856":1154,"_25053":1119,"_17489":44291,"_5":17384,"_23720":44195,"_2383":44292},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_2856":1155,"_25053":1119,"_17489":44294,"_5":17384,"_23720":44195,"_2383":44295},[],"`invalid RawSubject bytes`",{"_2856":1156,"_25053":1119,"_17489":44297,"_5":17384,"_23720":44195,"_2383":44298},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_2856":1157,"_25053":1119,"_17489":44300,"_5":17384,"_23720":44195,"_2383":44301},[],"`invalid reenroll window`",{"_2856":1158,"_25053":1119,"_17489":44303,"_5":17384,"_23720":44195,"_2383":44304},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_2856":1159,"_25053":1119,"_17489":44306,"_5":17384,"_23720":44195,"_2383":44307},[],"Current certificate revoked",{"_2856":1160,"_25053":1119,"_17489":44309,"_5":17384,"_23720":44195,"_2383":44310},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_2856":1161,"_25053":1119,"_17489":44312,"_5":17384,"_23720":44195,"_2383":44313},[],"CA, profile or signing error",{"_2856":1162,"_25053":1119,"_17489":44315,"_5":17384,"_23720":44195,"_2383":44316},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_2856":1163,"_25053":1119,"_17489":44318,"_5":17384,"_23720":44195,"_2383":44319},[],"HTTP 200 without a device connection",{"_2856":1164,"_25053":1119,"_17489":44321,"_5":17384,"_23720":44195,"_2383":44322},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_2856":1165,"_25053":1119,"_17489":44324,"_5":17384,"_23720":44195,"_2383":44325},[],"Timeout or error after issuance",{"_2856":1166,"_25053":1119,"_17489":44327,"_5":17384,"_23720":44195,"_2383":44328},[],"New certificates, current slot and previous identity's state before retrying.",{"_2856":1167,"_25053":1119,"_17489":44330,"_5":17384,"_23720":44199,"_2383":44331},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode after migration and Gateway behavior with expired certificates and the bootstrap CA.",{"_2856":1168,"_25053":1119,"_17489":44333,"_5":17384,"_23720":44199,"_2383":44334},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_2856":1169,"_25053":1119,"_17489":44336,"_5":17384,"_23720":44202,"_2383":44337},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_2856":1170,"_25053":1119,"_17489":44339,"_5":17384,"_23720":44202,"_2383":44340},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_2856":1171,"_25053":1119,"_17489":44342,"_5":17384,"_23720":44202,"_2383":44343},[],"Verify the CSR locally and relate its CN to the inventory.",{"_2856":1172,"_25053":1119,"_17489":44345,"_5":17384,"_23720":44202,"_2383":44346},[],"Make one request, save headers/body and query the device and certificates.",{"_2856":1173,"_25053":1119,"_17489":44348,"_5":17384,"_23720":44202,"_2383":44349},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_2856":1174,"_25053":1119,"_17489":44351,"_5":17384,"_23720":44202,"_2383":44352},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_2856":1175,"_25053":1119,"_17489":44354,"_5":17384,"_23720":44202,"_2383":44355},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_2856":1176,"_25053":1176,"_5":12268,"_2383":44357,"_25368":44358,"_17489":44359,"_23720":1176},"Trust distribution and updates",[40693,42037,43011,43009,43192],[],{"_2856":1177,"_25053":1176,"_17489":44361,"_5":17384,"_23720":1176,"_2383":44362},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_2856":1178,"_25053":1176,"_5":25365,"_17489":44364,"_23720":44365,"_2383":44366},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_2856":1179,"_25053":1176,"_5":25365,"_17489":44368,"_23720":44369,"_2383":44370},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_2856":1180,"_25053":1176,"_5":25365,"_17489":44372,"_23720":44373,"_2383":44374},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_2856":1181,"_25053":1176,"_5":25365,"_17489":44376,"_23720":44377,"_2383":44378},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_2856":1182,"_25053":1176,"_5":25365,"_17489":44380,"_23720":44381,"_2383":44382},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_2856":1183,"_25053":1176,"_17489":44384,"_5":17384,"_23720":1176,"_2383":44385},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_2856":1184,"_25053":1176,"_17489":44387,"_5":17384,"_23720":44365,"_2383":44388},[],"Relationship",{"_2856":1185,"_25053":1176,"_17489":44390,"_5":17384,"_23720":44365,"_2383":44391},[],"Material prepared by its owner",{"_2856":1186,"_25053":1176,"_17489":44393,"_5":17384,"_23720":44365,"_2383":44394},[],"Device → EST server",{"_2856":1187,"_25053":1176,"_17489":44396,"_5":17384,"_23720":44365,"_2383":44397},[],"Previously verified server root, chain or pin and TLS name.",{"_2856":1188,"_25053":1176,"_17489":44399,"_5":17384,"_23720":44365,"_2383":44400},[],"DMS → requester",{"_2856":1189,"_25053":1176,"_17489":44402,"_5":17384,"_23720":44365,"_2383":44403},[],"CAs and rules authorizing initial or renewal credentials.",{"_2856":1190,"_25053":1176,"_17489":44405,"_5":17384,"_23720":44365,"_2383":44406},[],"Consumer → device",{"_2856":1191,"_25053":1176,"_17489":44408,"_5":17384,"_23720":44365,"_2383":44409},[],"Operational identity roots, intermediates, validation and permissions.",{"_2856":1192,"_25053":1176,"_17489":44411,"_5":17384,"_23720":44365,"_2383":44412},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_2856":1193,"_25053":1176,"_17489":44414,"_5":17384,"_23720":44369,"_2383":44415},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_2856":1194,"_25053":1176,"_17489":44417,"_5":17384,"_23720":44369,"_2383":44418},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_2856":1195,"_25053":1176,"_17489":44420,"_5":17384,"_23720":44373,"_2383":44421},[],"Keep initial EST server trust separate from identity consumer trust.",{"_2856":1196,"_25053":1176,"_17489":44423,"_5":17384,"_23720":44373,"_2383":44424},[],"Select policy-approved roots as anchors.",{"_2856":1197,"_25053":1176,"_17489":44426,"_5":17384,"_23720":44373,"_2383":44427},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_2856":1198,"_25053":1176,"_17489":44429,"_5":17384,"_23720":44373,"_2383":44430},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_2856":1199,"_25053":1176,"_17489":44432,"_5":17384,"_23720":44373,"_2383":44433},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_2856":1200,"_25053":1176,"_17489":44435,"_5":17384,"_23720":44373,"_2383":44436},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_2856":1201,"_25053":1176,"_17489":44438,"_5":17384,"_23720":44377,"_2383":44439},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_2856":1202,"_25053":1176,"_17489":44441,"_5":17384,"_23720":44377,"_2383":44442},[],"In the DMS, separate distributed CAs from `additional_validation_cas`, used for re-enrollment credentials. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_2856":1203,"_25053":1176,"_17489":44444,"_5":17384,"_23720":44377,"_2383":44445},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_2856":1204,"_25053":1176,"_17489":44447,"_5":17384,"_23720":44381,"_2383":44448},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_2856":1205,"_25053":1205,"_5":12268,"_2383":44450,"_25368":44451,"_17489":44453,"_23720":1205},"AWS IoT Core",[40693,42037,43011,43009,44452],"Integrations",[],{"_2856":1206,"_25053":1205,"_17489":44455,"_5":17384,"_23720":1205,"_2383":44456},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_2856":1207,"_25053":1205,"_5":25365,"_17489":44458,"_23720":44459,"_2383":44460},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_2856":1208,"_25053":1205,"_5":25365,"_17489":44462,"_23720":44463,"_2383":44464},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_2856":1209,"_25053":1205,"_5":25365,"_17489":44466,"_23720":44467,"_2383":44468},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_2856":1210,"_25053":1205,"_5":25365,"_17489":44470,"_23720":44471,"_2383":44472},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_2856":1211,"_25053":1205,"_5":25365,"_17489":44474,"_23720":44475,"_2383":44476},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_2856":1212,"_25053":1205,"_5":25365,"_17489":44478,"_23720":44479,"_2383":44480},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_2856":1213,"_25053":1205,"_5":25365,"_17489":44482,"_23720":44483,"_2383":44484},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_2856":1214,"_25053":1205,"_5":25365,"_17489":44486,"_23720":44487,"_2383":44488},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_2856":1215,"_25053":1205,"_5":25365,"_17489":44490,"_23720":44491,"_2383":44492},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_2856":1216,"_25053":1205,"_5":25365,"_17489":44494,"_23720":44495,"_2383":44496},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_2856":1217,"_25053":1205,"_5":25365,"_17489":44498,"_23720":44499,"_2383":44500},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_2856":1218,"_25053":1205,"_5":25365,"_17489":44502,"_23720":44503,"_2383":44504},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_2856":1219,"_25053":1205,"_5":25365,"_17489":44506,"_23720":44507,"_2383":44508},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_2856":1220,"_25053":1205,"_5":25365,"_17489":44510,"_23720":44511,"_2383":44512},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_2856":1221,"_25053":1205,"_5":25365,"_17489":44514,"_23720":44515,"_2383":44516},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_2856":1222,"_25053":1205,"_5":25365,"_17489":44518,"_23720":44519,"_2383":44520},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_2856":1223,"_25053":1205,"_5":25365,"_17489":44522,"_23720":44523,"_2383":44524},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_2856":1224,"_25053":1205,"_5":25365,"_17489":44526,"_23720":44527,"_2383":44528},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_2856":1225,"_25053":1205,"_5":25365,"_17489":44530,"_23720":44531,"_2383":44532},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_2856":1226,"_25053":1205,"_5":25365,"_17489":44534,"_23720":44535,"_2383":44536},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_2856":1227,"_25053":1205,"_17489":44538,"_5":17384,"_23720":1205,"_2383":44539},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_2856":1228,"_25053":1205,"_17489":44541,"_5":17384,"_23720":1205,"_2383":44542},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_2856":1229,"_25053":1205,"_17489":44544,"_5":17384,"_23720":1205,"_2383":44545},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_2856":1230,"_25053":1205,"_17489":44547,"_5":17384,"_23720":44459,"_2383":44548},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_2856":1231,"_25053":1205,"_17489":44550,"_5":17384,"_23720":44459,"_2383":44551},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_2856":1232,"_25053":1205,"_17489":44553,"_5":17384,"_23720":44459,"_2383":44554},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_2856":1233,"_25053":1205,"_17489":44556,"_5":17384,"_23720":44459,"_2383":44557},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_2856":1234,"_25053":1205,"_17489":44559,"_5":17384,"_23720":44463,"_2383":44560},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_2856":1235,"_25053":1205,"_17489":44562,"_5":17384,"_23720":44467,"_2383":44563},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_2856":1236,"_25053":1205,"_17489":44565,"_5":17384,"_23720":44467,"_2383":44566},[],"IAM action",{"_2856":1237,"_25053":1205,"_17489":44568,"_5":17384,"_23720":44467,"_2383":41076},[],{"_2856":1238,"_25053":1205,"_17489":44570,"_5":17384,"_23720":44467,"_2383":44571},[],"`iot:GetRegistrationCode`",{"_2856":1239,"_25053":1205,"_17489":44573,"_5":17384,"_23720":44467,"_2383":44574},[],"Obtain the verification code for CA registration in the Primary Account",{"_2856":1240,"_25053":1205,"_17489":44576,"_5":17384,"_23720":44467,"_2383":44577},[],"`iot:RegisterCACertificate`",{"_2856":1241,"_25053":1205,"_17489":44579,"_5":17384,"_23720":44467,"_2383":44580},[],"Register the CA in AWS IoT",{"_2856":1242,"_25053":1205,"_17489":44582,"_5":17384,"_23720":44467,"_2383":44583},[],"`iot:DescribeCACertificate`",{"_2856":1243,"_25053":1205,"_17489":44585,"_5":17384,"_23720":44467,"_2383":44586},[],"Check the CA registration status",{"_2856":1244,"_25053":1205,"_17489":44588,"_5":17384,"_23720":44467,"_2383":44589},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_2856":1245,"_25053":1205,"_17489":44591,"_5":17384,"_23720":44467,"_2383":44592},[],"Create or update Things in IoT Core",{"_2856":1246,"_25053":1205,"_17489":44594,"_5":17384,"_23720":44467,"_2383":44595},[],"`iot:RegisterThing`",{"_2856":1247,"_25053":1205,"_17489":44597,"_5":17384,"_23720":44467,"_2383":44598},[],"Provision Things through a template",{"_2856":1248,"_25053":1205,"_17489":44600,"_5":17384,"_23720":44467,"_2383":44601},[],"`iot:RegisterCertificate`",{"_2856":1249,"_25053":1205,"_17489":44603,"_5":17384,"_23720":44467,"_2383":44604},[],"Register device certificates",{"_2856":1250,"_25053":1205,"_17489":44606,"_5":17384,"_23720":44467,"_2383":44607},[],"`iot:UpdateCertificate`",{"_2856":1251,"_25053":1205,"_17489":44609,"_5":17384,"_23720":44467,"_2383":44610},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_2856":1252,"_25053":1205,"_17489":44612,"_5":17384,"_23720":44467,"_2383":44613},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_2856":1253,"_25053":1205,"_17489":44615,"_5":17384,"_23720":44467,"_2383":44616},[],"Create and attach IoT policies",{"_2856":1254,"_25053":1205,"_17489":44618,"_5":17384,"_23720":44467,"_2383":44619},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_2856":1255,"_25053":1205,"_17489":44621,"_5":17384,"_23720":44467,"_2383":44622},[],"Manage Thing groups",{"_2856":1256,"_25053":1205,"_17489":44624,"_5":17384,"_23720":44467,"_2383":44625},[],"`iot:CreateProvisioningTemplate`",{"_2856":1257,"_25053":1205,"_17489":44627,"_5":17384,"_23720":44467,"_2383":44628},[],"Create JITP templates",{"_2856":1258,"_25053":1205,"_17489":44630,"_5":17384,"_23720":44467,"_2383":44631},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_2856":1259,"_25053":1205,"_17489":44633,"_5":17384,"_23720":44467,"_2383":44634},[],"Read and write the Device Shadow",{"_2856":1260,"_25053":1205,"_17489":44636,"_5":17384,"_23720":44467,"_2383":44637},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_2856":1261,"_25053":1205,"_17489":44639,"_5":17384,"_23720":44471,"_2383":44640},[],"Parameter",{"_2856":1262,"_25053":1205,"_17489":44642,"_5":17384,"_23720":44471,"_2383":44643},[],"Type",{"_2856":1263,"_25053":1205,"_17489":44645,"_5":17384,"_23720":44471,"_2383":44646},[],"Required",{"_2856":1264,"_25053":1205,"_17489":44648,"_5":17384,"_23720":44471,"_2383":44649},[],"Description",{"_2856":1265,"_25053":1205,"_17489":44651,"_5":17384,"_23720":44471,"_2383":44652},[],"`connector_id`",{"_2856":1266,"_25053":1205,"_17489":44654,"_5":17384,"_23720":44471,"_2383":20874},[],{"_2856":1267,"_25053":1205,"_17489":44656,"_5":17384,"_23720":44471,"_2383":44657},[],"Yes",{"_2856":1268,"_25053":1205,"_17489":44659,"_5":17384,"_23720":44471,"_2383":44660},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_2856":1269,"_25053":1205,"_17489":44662,"_5":17384,"_23720":44471,"_2383":44663},[],"`aws_config.region`",{"_2856":1270,"_25053":1205,"_17489":44665,"_5":17384,"_23720":44471,"_2383":20874},[],{"_2856":1271,"_25053":1205,"_17489":44667,"_5":17384,"_23720":44471,"_2383":44657},[],{"_2856":1272,"_25053":1205,"_17489":44669,"_5":17384,"_23720":44471,"_2383":44670},[],"AWS region where the connector operates.",{"_2856":1273,"_25053":1205,"_17489":44672,"_5":17384,"_23720":44471,"_2383":44673},[],"`aws_config.auth_method`",{"_2856":1274,"_25053":1205,"_17489":44675,"_5":17384,"_23720":44471,"_2383":20874},[],{"_2856":1275,"_25053":1205,"_17489":44677,"_5":17384,"_23720":44471,"_2383":44657},[],{"_2856":1276,"_25053":1205,"_17489":44679,"_5":17384,"_23720":44471,"_2383":44680},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_2856":1277,"_25053":1205,"_17489":44682,"_5":17384,"_23720":44471,"_2383":44683},[],"`aws_config.access_key_id`",{"_2856":1278,"_25053":1205,"_17489":44685,"_5":17384,"_23720":44471,"_2383":20874},[],{"_2856":1279,"_25053":1205,"_17489":44687,"_5":17384,"_23720":44471,"_2383":44688},[],"Only with `auth_method=static`",{"_2856":1280,"_25053":1205,"_17489":44690,"_5":17384,"_23720":44471,"_2383":44691},[],"AWS access key.",{"_2856":1281,"_25053":1205,"_17489":44693,"_5":17384,"_23720":44471,"_2383":44694},[],"`aws_config.secret_access_key`",{"_2856":1282,"_25053":1205,"_17489":44696,"_5":17384,"_23720":44471,"_2383":20874},[],{"_2856":1283,"_25053":1205,"_17489":44698,"_5":17384,"_23720":44471,"_2383":44688},[],{"_2856":1284,"_25053":1205,"_17489":44700,"_5":17384,"_23720":44471,"_2383":44701},[],"AWS secret key.",{"_2856":1285,"_25053":1205,"_17489":44703,"_5":17384,"_23720":44471,"_2383":44704},[],"`aws_config.session_token`",{"_2856":1286,"_25053":1205,"_17489":44706,"_5":17384,"_23720":44471,"_2383":20874},[],{"_2856":1287,"_25053":1205,"_17489":44708,"_5":17384,"_23720":44471,"_2383":44709},[],"No",{"_2856":1288,"_25053":1205,"_17489":44711,"_5":17384,"_23720":44471,"_2383":44712},[],"Session token (with `auth_method=static`).",{"_2856":1289,"_25053":1205,"_17489":44714,"_5":17384,"_23720":44471,"_2383":44715},[],"`aws_config.role_arn`",{"_2856":1290,"_25053":1205,"_17489":44717,"_5":17384,"_23720":44471,"_2383":20874},[],{"_2856":1291,"_25053":1205,"_17489":44719,"_5":17384,"_23720":44471,"_2383":44720},[],"Only with `auth_method=role`",{"_2856":1292,"_25053":1205,"_17489":44722,"_5":17384,"_23720":44471,"_2383":44723},[],"ARN of the role to assume.",{"_2856":1293,"_25053":1205,"_17489":44725,"_5":17384,"_23720":44471,"_2383":44726},[],"`aws_config.endpoint_url`",{"_2856":1294,"_25053":1205,"_17489":44728,"_5":17384,"_23720":44471,"_2383":20874},[],{"_2856":1295,"_25053":1205,"_17489":44730,"_5":17384,"_23720":44471,"_2383":44709},[],{"_2856":1296,"_25053":1205,"_17489":44732,"_5":17384,"_23720":44471,"_2383":44733},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_2856":1297,"_25053":1205,"_17489":44735,"_5":17384,"_23720":44471,"_2383":44736},[],"`subscriber_event_bus`",{"_2856":1298,"_25053":1205,"_17489":44738,"_5":17384,"_23720":44471,"_2383":14682},[],{"_2856":1299,"_25053":1205,"_17489":44740,"_5":17384,"_23720":44471,"_2383":44657},[],{"_2856":1300,"_25053":1205,"_17489":44742,"_5":17384,"_23720":44471,"_2383":44743},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_2856":1301,"_25053":1205,"_17489":44745,"_5":17384,"_23720":44471,"_2383":44746},[],"`dms_manager_client`",{"_2856":1302,"_25053":1205,"_17489":44748,"_5":17384,"_23720":44471,"_2383":20874},[],{"_2856":1303,"_25053":1205,"_17489":44750,"_5":17384,"_23720":44471,"_2383":44657},[],{"_2856":1304,"_25053":1205,"_17489":44752,"_5":17384,"_23720":44471,"_2383":44753},[],"HTTP URL of Lamassu's DMS Manager service.",{"_2856":1305,"_25053":1205,"_17489":44755,"_5":17384,"_23720":44471,"_2383":44756},[],"`device_manager_client`",{"_2856":1306,"_25053":1205,"_17489":44758,"_5":17384,"_23720":44471,"_2383":20874},[],{"_2856":1307,"_25053":1205,"_17489":44760,"_5":17384,"_23720":44471,"_2383":44657},[],{"_2856":1308,"_25053":1205,"_17489":44762,"_5":17384,"_23720":44471,"_2383":44763},[],"HTTP URL of Lamassu's Device Manager.",{"_2856":1309,"_25053":1205,"_17489":44765,"_5":17384,"_23720":44471,"_2383":44766},[],"`ca_client`",{"_2856":1310,"_25053":1205,"_17489":44768,"_5":17384,"_23720":44471,"_2383":20874},[],{"_2856":1311,"_25053":1205,"_17489":44770,"_5":17384,"_23720":44471,"_2383":44657},[],{"_2856":1312,"_25053":1205,"_17489":44772,"_5":17384,"_23720":44471,"_2383":44773},[],"HTTP URL of Lamassu's CA service.",{"_2856":1313,"_25053":1205,"_17489":44775,"_5":17384,"_23720":44475,"_2383":44776},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_2856":1314,"_25053":1205,"_17489":44778,"_5":17384,"_23720":44479,"_2383":44779},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_2856":1315,"_25053":1205,"_17489":44781,"_5":17384,"_23720":44479,"_2383":44782},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_2856":1316,"_25053":1205,"_17489":44784,"_5":17384,"_23720":44483,"_2383":44785},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_2856":1317,"_25053":1205,"_17489":44787,"_5":17384,"_23720":44483,"_2383":44788},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_2856":1318,"_25053":1205,"_17489":44790,"_5":17384,"_23720":44483,"_2383":44791},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_2856":1319,"_25053":1205,"_17489":44793,"_5":17384,"_23720":44483,"_2383":44794},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_2856":1320,"_25053":1205,"_17489":44796,"_5":17384,"_23720":44483,"_2383":44797},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_2856":1321,"_25053":1205,"_17489":44799,"_5":17384,"_23720":44483,"_2383":44800},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_2856":1322,"_25053":1205,"_17489":44802,"_5":17384,"_23720":44487,"_2383":44803},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_2856":1323,"_25053":1205,"_17489":44805,"_5":17384,"_23720":44491,"_2383":44806},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_2856":1324,"_25053":1205,"_17489":44808,"_5":17384,"_23720":44491,"_2383":44809},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_2856":1325,"_25053":1205,"_17489":44811,"_5":17384,"_23720":44495,"_2383":44812},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_2856":1326,"_25053":1205,"_17489":44814,"_5":17384,"_23720":44499,"_2383":44815},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_2856":1327,"_25053":1205,"_17489":44817,"_5":17384,"_23720":44499,"_2383":44818},[],"Creates or updates the IoT policies configured in the DMS.",{"_2856":1328,"_25053":1205,"_17489":44820,"_5":17384,"_23720":44499,"_2383":44821},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_2856":1329,"_25053":1205,"_17489":44823,"_5":17384,"_23720":44499,"_2383":44824},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_2856":1330,"_25053":1205,"_17489":44826,"_5":17384,"_23720":44499,"_2383":44827},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_2856":1331,"_25053":1205,"_17489":44829,"_5":17384,"_23720":44499,"_2383":44830},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_2856":1332,"_25053":1205,"_17489":44832,"_5":17384,"_23720":44499,"_2383":44833},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_2856":1333,"_25053":1205,"_17489":44835,"_5":17384,"_23720":44503,"_2383":44836},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. This template is created or updated at the moment the DMS is created or updated in Lamassu — not at device enrollment time. From then on, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_2856":1334,"_25053":1205,"_17489":44838,"_5":17384,"_23720":44503,"_2383":44839},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_2856":1335,"_25053":1205,"_17489":44841,"_5":17384,"_23720":44503,"_2383":44842},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_2856":1336,"_25053":1205,"_17489":44844,"_5":17384,"_23720":44507,"_2383":44845},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_2856":1337,"_25053":1205,"_17489":44847,"_5":17384,"_23720":44507,"_2383":44848},[],"The full flow from the device's perspective is:",{"_2856":1338,"_25053":1205,"_17489":44850,"_5":17384,"_23720":44507,"_2383":44851},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_2856":1339,"_25053":1205,"_17489":44853,"_5":17384,"_23720":44511,"_2383":44854},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_2856":1340,"_25053":1205,"_17489":44856,"_5":17384,"_23720":44511,"_2383":44857},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_2856":1341,"_25053":1205,"_17489":44859,"_5":17384,"_23720":44511,"_2383":44860},[],"For the JITP flow to work correctly:",{"_2856":1342,"_25053":1205,"_17489":44862,"_5":17384,"_23720":44511,"_2383":44863},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_2856":1343,"_25053":1205,"_17489":44865,"_5":17384,"_23720":44511,"_2383":44866},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_2856":1344,"_25053":1205,"_17489":44868,"_5":17384,"_23720":44511,"_2383":44869},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_2856":1345,"_25053":1205,"_17489":44871,"_5":17384,"_23720":44511,"_2383":44872},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_2856":1346,"_25053":1205,"_17489":44874,"_5":17384,"_23720":44515,"_2383":44875},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_2856":1347,"_25053":1205,"_17489":44877,"_5":17384,"_23720":44515,"_2383":44878},[],"Status in Lamassu",{"_2856":1348,"_25053":1205,"_17489":44880,"_5":17384,"_23720":44515,"_2383":44881},[],"Revocation reason",{"_2856":1349,"_25053":1205,"_17489":44883,"_5":17384,"_23720":44515,"_2383":44884},[],"Status in AWS IoT Core",{"_2856":1350,"_25053":1205,"_17489":44886,"_5":17384,"_23720":44515,"_2383":44887},[],"`Active`",{"_2856":1351,"_25053":1205,"_17489":44889,"_5":17384,"_23720":44515,"_2383":44890},[],"None",{"_2856":1352,"_25053":1205,"_17489":44892,"_5":17384,"_23720":44515,"_2383":44893},[],"`ACTIVE`",{"_2856":1353,"_25053":1205,"_17489":44895,"_5":17384,"_23720":44515,"_2383":44896},[],"`Revoked`",{"_2856":1354,"_25053":1205,"_17489":44898,"_5":17384,"_23720":44515,"_2383":44899},[],"`certificateHold`",{"_2856":1355,"_25053":1205,"_17489":44901,"_5":17384,"_23720":44515,"_2383":44902},[],"`INACTIVE`",{"_2856":1356,"_25053":1205,"_17489":44904,"_5":17384,"_23720":44515,"_2383":44896},[],{"_2856":1357,"_25053":1205,"_17489":44906,"_5":17384,"_23720":44515,"_2383":44907},[],"Any other reason",{"_2856":1358,"_25053":1205,"_17489":44909,"_5":17384,"_23720":44515,"_2383":44910},[],"`REVOKED`",{"_2856":1359,"_25053":1205,"_17489":44912,"_5":17384,"_23720":44515,"_2383":44913},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_2856":1360,"_25053":1205,"_17489":44915,"_5":17384,"_23720":44519,"_2383":44916},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_2856":1361,"_25053":1205,"_17489":44918,"_5":17384,"_23720":44519,"_2383":44919},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_2856":1362,"_25053":1205,"_17489":44921,"_5":17384,"_23720":44519,"_2383":44922},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_2856":1363,"_25053":1205,"_17489":44924,"_5":17384,"_23720":44523,"_2383":44925},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_2856":1364,"_25053":1205,"_17489":44927,"_5":17384,"_23720":44523,"_2383":44928},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_2856":1365,"_25053":1205,"_17489":44930,"_5":17384,"_23720":44527,"_2383":44931},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_2856":1366,"_25053":1205,"_17489":44933,"_5":17384,"_23720":44527,"_2383":44934},[],"There are two action types:",{"_2856":1367,"_25053":1205,"_17489":44936,"_5":17384,"_23720":44527,"_2383":44937},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_2856":1368,"_25053":1205,"_17489":44939,"_5":17384,"_23720":44527,"_2383":44940},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_2856":1369,"_25053":1205,"_17489":44942,"_5":17384,"_23720":44527,"_2383":44943},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_2856":1370,"_25053":1205,"_17489":44945,"_5":17384,"_23720":44531,"_2383":44946},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_2856":1371,"_25053":1205,"_17489":44948,"_5":17384,"_23720":44531,"_2383":44949},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_2856":1372,"_25053":1205,"_17489":44951,"_5":17384,"_23720":44531,"_2383":44952},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_2856":1373,"_25053":1205,"_17489":44954,"_5":17384,"_23720":44535,"_2383":44955},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_2856":1374,"_25053":1205,"_17489":44957,"_5":17384,"_23720":44535,"_2383":44958},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_2856":1375,"_25053":1205,"_17489":44960,"_5":17384,"_23720":44535,"_2383":44961},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_2856":1376,"_25053":1205,"_17489":44963,"_5":17384,"_23720":44535,"_2383":44964},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_2856":1377,"_25053":1205,"_17489":44966,"_5":17384,"_23720":44535,"_2383":44967},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_2856":1378,"_25053":1205,"_17489":44969,"_5":17384,"_23720":44535,"_2383":44970},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_2856":1379,"_25053":1205,"_17489":44972,"_5":17384,"_23720":44535,"_2383":44973},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_2856":1380,"_25053":1205,"_17489":44975,"_5":17384,"_23720":44535,"_2383":44976},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_2856":1381,"_25053":1205,"_17489":44978,"_5":17384,"_23720":44535,"_2383":44979},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_2856":1382,"_25053":1205,"_17489":44981,"_5":17384,"_23720":44535,"_2383":44982},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_2856":1383,"_25053":1205,"_17489":44984,"_5":17384,"_23720":44535,"_2383":44985},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_2856":1384,"_25053":1205,"_17489":44987,"_5":17384,"_23720":44535,"_2383":44988},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_2856":1385,"_25053":1205,"_17489":44990,"_5":17384,"_23720":44535,"_2383":44991},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_2856":1386,"_25053":1205,"_17489":44993,"_5":17384,"_23720":44535,"_2383":44994},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_2856":1387,"_25053":1205,"_17489":44996,"_5":17384,"_23720":44535,"_2383":44997},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_2856":1388,"_25053":1205,"_17489":44999,"_5":17384,"_23720":44535,"_2383":45000},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_2856":1389,"_25053":1205,"_17489":45002,"_5":17384,"_23720":44535,"_2383":45003},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_2856":1390,"_25053":1205,"_17489":45005,"_5":17384,"_23720":44535,"_2383":45006},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_2856":1391,"_25053":1205,"_17489":45008,"_5":17384,"_23720":44535,"_2383":45009},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2856":1392,"_25053":1205,"_17489":45011,"_5":17384,"_23720":44535,"_2383":45012},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2856":1393,"_25053":1205,"_17489":45014,"_5":17384,"_23720":44535,"_2383":45015},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_2856":1394,"_25053":1394,"_5":12268,"_2383":43011,"_25368":45017,"_17489":45018,"_23720":1394},[40693,42037,43011],[],{"_2856":1395,"_25053":1394,"_17489":45020,"_5":17384,"_23720":1394,"_2383":45021},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_2856":1396,"_25053":1394,"_5":25365,"_17489":45023,"_23720":45024,"_2383":45025},[],"/docs/platform/iot-fleets/overview#start-here","Start here",{"_2856":1397,"_25053":1394,"_5":25365,"_17489":45027,"_23720":45028,"_2383":43009},[],"/docs/platform/iot-fleets/overview#devices-and-identities",{"_2856":1398,"_25053":1394,"_5":25365,"_17489":45030,"_23720":45031,"_2383":43192},[],"/docs/platform/iot-fleets/overview#enrollment-with-pki",{"_2856":1399,"_25053":1394,"_5":25365,"_17489":45033,"_23720":45034,"_2383":44452},[],"/docs/platform/iot-fleets/overview#integrations",{"_2856":1400,"_25053":1394,"_5":25365,"_17489":45036,"_23720":45037,"_2383":45038},[],"/docs/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_2856":1401,"_25053":1394,"_17489":45040,"_5":17384,"_23720":1394,"_2383":45041},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_2856":1402,"_25053":1394,"_17489":45043,"_5":17384,"_23720":45024,"_2383":45044},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_2856":1403,"_25053":1394,"_17489":45046,"_5":17384,"_23720":45024,"_2383":45047},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_2856":1404,"_25053":1394,"_17489":45049,"_5":17384,"_23720":45028,"_2383":45050},[],"Resource",{"_2856":1405,"_25053":1394,"_17489":45052,"_5":17384,"_23720":45028,"_2383":45053},[],"What it represents",{"_2856":1406,"_25053":1394,"_17489":45055,"_5":17384,"_23720":45028,"_2383":45056},[],"**Device**",{"_2856":1407,"_25053":1394,"_17489":45058,"_5":17384,"_23720":45028,"_2383":45059},[],"An inventory entry with an identifier, owning DMS and classification.",{"_2856":1408,"_25053":1394,"_17489":45061,"_5":17384,"_23720":45028,"_2383":45062},[],"**Identity**",{"_2856":1409,"_25053":1394,"_17489":45064,"_5":17384,"_23720":45028,"_2383":45065},[],"The device's association with its certificates: an active version and a history.",{"_2856":1410,"_25053":1394,"_17489":45067,"_5":17384,"_23720":45028,"_2383":45068},[],"**DMS**",{"_2856":1411,"_25053":1394,"_17489":45070,"_5":17384,"_23720":45028,"_2383":45071},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_2856":1412,"_25053":1394,"_17489":45073,"_5":17384,"_23720":45028,"_2383":45074},[],"**Fleet**",{"_2856":1413,"_25053":1394,"_17489":45076,"_5":17384,"_23720":45028,"_2383":45077},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_2856":1414,"_25053":1394,"_17489":45079,"_5":17384,"_23720":45028,"_2383":45080},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_2856":1415,"_25053":1394,"_17489":45082,"_5":17384,"_23720":45028,"_2383":45083},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_2856":1416,"_25053":1394,"_17489":45085,"_5":17384,"_23720":45031,"_2383":45086},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_2856":1417,"_25053":1394,"_17489":45088,"_5":17384,"_23720":45031,"_2383":45089},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_2856":1418,"_25053":1394,"_17489":45091,"_5":17384,"_23720":45031,"_2383":45092},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_2856":1419,"_25053":1394,"_17489":45094,"_5":17384,"_23720":45031,"_2383":45095},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_2856":1420,"_25053":1394,"_17489":45097,"_5":17384,"_23720":45031,"_2383":45098},[],"**Result:** request the certificate, install it and check its association with the device.",{"_2856":1421,"_25053":1394,"_17489":45100,"_5":17384,"_23720":45031,"_2383":45101},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_2856":1422,"_25053":1394,"_17489":45103,"_5":17384,"_23720":45031,"_2383":45104},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2856":1423,"_25053":1394,"_17489":45106,"_5":17384,"_23720":45031,"_2383":45107},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2856":1424,"_25053":1394,"_17489":45109,"_5":17384,"_23720":45034,"_2383":45110},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_2856":1425,"_25053":1394,"_17489":45112,"_5":17384,"_23720":45034,"_2383":45113},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_2856":1426,"_25053":1394,"_17489":45115,"_5":17384,"_23720":45037,"_2383":45116},[],"Participant",{"_2856":1427,"_25053":1394,"_17489":45118,"_5":17384,"_23720":45037,"_2383":45119},[],"Responsibility",{"_2856":1428,"_25053":1394,"_17489":45121,"_5":17384,"_23720":45037,"_2383":45122},[],"PKI administrator",{"_2856":1429,"_25053":1394,"_17489":45124,"_5":17384,"_23720":45037,"_2383":45125},[],"CA, issuance profile, chain and revocation publication.",{"_2856":1430,"_25053":1394,"_17489":45127,"_5":17384,"_23720":45037,"_2383":45128},[],"Provisioning administrator",{"_2856":1431,"_25053":1394,"_17489":45130,"_5":17384,"_23720":45037,"_2383":45131},[],"DMS, admission, authentication per operation and inventory.",{"_2856":1432,"_25053":1394,"_17489":45133,"_5":17384,"_23720":45037,"_2383":45134},[],"Device integrator",{"_2856":1433,"_25053":1394,"_17489":45136,"_5":17384,"_23720":45037,"_2383":45137},[],"Initial credential, key, EST client, trust and certificate installation.",{"_2856":1434,"_25053":1394,"_17489":45139,"_5":17384,"_23720":45037,"_2383":45140},[],"Consumer integrator",{"_2856":1435,"_25053":1394,"_17489":45142,"_5":17384,"_23720":45037,"_2383":45143},[],"Trusted issuers, validation and device permissions in the destination.",{"_2856":1436,"_25053":1394,"_17489":45145,"_5":17384,"_23720":45037,"_2383":45146},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_2856":1437,"_25053":1437,"_5":12268,"_2383":45148,"_25368":45149,"_17489":45151,"_23720":1437},"Enroll and connect your first device",[40693,42037,43011,45150],"Getting started",[],{"_2856":1438,"_25053":1437,"_17489":45153,"_5":17384,"_23720":1437,"_2383":45154},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_2856":1439,"_25053":1437,"_5":25365,"_17489":45156,"_23720":45157,"_2383":40703},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_2856":1440,"_25053":1437,"_5":25365,"_17489":45159,"_23720":45160,"_2383":45161},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_2856":1441,"_25053":1437,"_5":25365,"_17489":45163,"_23720":45164,"_2383":45165},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_2856":1442,"_25053":1437,"_5":25365,"_17489":45167,"_23720":45168,"_2383":45169},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_2856":1443,"_25053":1437,"_5":25365,"_17489":45171,"_23720":45172,"_2383":45173},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_2856":1444,"_25053":1437,"_5":25365,"_17489":45175,"_23720":45176,"_2383":45177},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_2856":1445,"_25053":1437,"_5":25365,"_17489":45179,"_23720":45180,"_2383":45181},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_2856":1446,"_25053":1437,"_5":25365,"_17489":45183,"_23720":45184,"_2383":45185},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_2856":1447,"_25053":1437,"_17489":45187,"_5":17384,"_23720":1437,"_2383":45188},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_2856":1448,"_25053":1437,"_17489":45190,"_5":17384,"_23720":45157,"_2383":45191},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_2856":1449,"_25053":1437,"_17489":45193,"_5":17384,"_23720":45157,"_2383":45194},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_2856":1450,"_25053":1437,"_17489":45196,"_5":17384,"_23720":45157,"_2383":45197},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_2856":1451,"_25053":1437,"_17489":45199,"_5":17384,"_23720":45157,"_2383":45200},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_2856":1452,"_25053":1437,"_17489":45202,"_5":17384,"_23720":45157,"_2383":45203},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_2856":1453,"_25053":1437,"_17489":45205,"_5":17384,"_23720":45160,"_2383":45206},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_2856":1454,"_25053":1437,"_17489":45208,"_5":17384,"_23720":45160,"_2383":45209},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_2856":1455,"_25053":1437,"_17489":45211,"_5":17384,"_23720":45164,"_2383":45212},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_2856":1456,"_25053":1437,"_17489":45214,"_5":17384,"_23720":45164,"_2383":45215},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_2856":1457,"_25053":1437,"_17489":45217,"_5":17384,"_23720":45164,"_2383":45218},[],"Setting",{"_2856":1458,"_25053":1437,"_17489":45220,"_5":17384,"_23720":45164,"_2383":45221},[],"Evaluation value",{"_2856":1459,"_25053":1437,"_17489":45223,"_5":17384,"_23720":45164,"_2383":45224},[],"Enrollment CA",{"_2856":1460,"_25053":1437,"_17489":45226,"_5":17384,"_23720":45164,"_2383":45227},[],"Issuing root from `device-root.pem`.",{"_2856":1461,"_25053":1437,"_17489":45229,"_5":17384,"_23720":45164,"_2383":43322},[],{"_2856":1462,"_25053":1437,"_17489":45231,"_5":17384,"_23720":45164,"_2383":45232},[],"The 1-hour leaf profile you just prepared.",{"_2856":1463,"_25053":1437,"_17489":45234,"_5":17384,"_23720":45164,"_2383":45235},[],"Protocol / Registration Mode",{"_2856":1464,"_25053":1437,"_17489":45237,"_5":17384,"_23720":45164,"_2383":45238},[],"`EST_RFC7030` / `JITP`.",{"_2856":1465,"_25053":1437,"_17489":45240,"_5":17384,"_23720":45164,"_2383":45241},[],"Verify CSR Signature",{"_2856":1466,"_25053":1437,"_17489":45243,"_5":17384,"_23720":45164,"_2383":45244},[],"Enabled.",{"_2856":1467,"_25053":1437,"_17489":45246,"_5":17384,"_23720":45164,"_2383":45247},[],"Enable Replaceable Enrollment",{"_2856":1468,"_25053":1437,"_17489":45249,"_5":17384,"_23720":45164,"_2383":45250},[],"Disabled; the ID must be new.",{"_2856":1469,"_25053":1437,"_17489":45252,"_5":17384,"_23720":45164,"_2383":45253},[],"Initial authentication",{"_2856":1470,"_25053":1437,"_17489":45255,"_5":17384,"_23720":45164,"_2383":45256},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_2856":1471,"_25053":1437,"_17489":45258,"_5":17384,"_23720":45164,"_2383":45259},[],"Renewal authentication",{"_2856":1472,"_25053":1437,"_17489":45261,"_5":17384,"_23720":45164,"_2383":45262},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_2856":1473,"_25053":1437,"_17489":45264,"_5":17384,"_23720":45164,"_2383":45265},[],"Additional Validation CAs / Enable Expired Renewal",{"_2856":1474,"_25053":1437,"_17489":45267,"_5":17384,"_23720":45164,"_2383":45268},[],"Empty list for this direct issuance / disabled.",{"_2856":1475,"_25053":1437,"_17489":45270,"_5":17384,"_23720":45164,"_2383":45271},[],"Re-enrollment Delta",{"_2856":1476,"_25053":1437,"_17489":45273,"_5":17384,"_23720":45164,"_2383":45274},[],"1 hour.",{"_2856":1477,"_25053":1437,"_17489":45276,"_5":17384,"_23720":45164,"_2383":45277},[],"Preventive / Critical Delta",{"_2856":1478,"_25053":1437,"_17489":45279,"_5":17384,"_23720":45164,"_2383":45280},[],"30 minutes / 10 minutes.",{"_2856":1479,"_25053":1437,"_17489":45282,"_5":17384,"_23720":45164,"_2383":45283},[],"Revoke on Re-enrollment",{"_2856":1480,"_25053":1437,"_17489":45285,"_5":17384,"_23720":45164,"_2383":45286},[],"Disabled to test the successor before retiring the previous identity.",{"_2856":1481,"_25053":1437,"_17489":45288,"_5":17384,"_23720":45164,"_2383":43330},[],{"_2856":1482,"_25053":1437,"_17489":45290,"_5":17384,"_23720":45164,"_2383":45291},[],"Disabled; the operational key is generated in the client.",{"_2856":1483,"_25053":1437,"_17489":45293,"_5":17384,"_23720":45164,"_2383":45294},[],"CA Distribution",{"_2856":1484,"_25053":1437,"_17489":45296,"_5":17384,"_23720":45164,"_2383":45297},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_2856":1485,"_25053":1437,"_17489":45299,"_5":17384,"_23720":45164,"_2383":45300},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. If your console does not expose the independent block, configure and check the resource through the DMS API and DMS guide.",{"_2856":1486,"_25053":1437,"_17489":45302,"_5":17384,"_23720":45168,"_2383":45303},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_2856":1487,"_25053":1437,"_17489":45305,"_5":17384,"_23720":45168,"_2383":45306},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_2856":1488,"_25053":1437,"_17489":45308,"_5":17384,"_23720":45172,"_2383":45309},[],"Generate a new key and CSR with the selected identifier:",{"_2856":1489,"_25053":1437,"_17489":45311,"_5":17384,"_23720":45172,"_2383":45312},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_2856":1490,"_25053":1437,"_17489":45314,"_5":17384,"_23720":45172,"_2383":45315},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_2856":1491,"_25053":1437,"_17489":45317,"_5":17384,"_23720":45176,"_2383":45318},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_2856":1492,"_25053":1437,"_17489":45320,"_5":17384,"_23720":45176,"_2383":45321},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_2856":1493,"_25053":1437,"_17489":45323,"_5":17384,"_23720":45180,"_2383":45324},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_2856":1494,"_25053":1437,"_17489":45326,"_5":17384,"_23720":45180,"_2383":45327},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_2856":1495,"_25053":1437,"_17489":45329,"_5":17384,"_23720":45180,"_2383":45330},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_2856":1496,"_25053":1437,"_17489":45332,"_5":17384,"_23720":45180,"_2383":45333},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_2856":1497,"_25053":1437,"_17489":45335,"_5":17384,"_23720":45180,"_2383":45336},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_2856":1498,"_25053":1437,"_17489":45338,"_5":17384,"_23720":45184,"_2383":45339},[],"Check",{"_2856":1499,"_25053":1437,"_17489":45341,"_5":17384,"_23720":45184,"_2383":45342},[],"Expected result",{"_2856":1500,"_25053":1437,"_17489":45344,"_5":17384,"_23720":45184,"_2383":45345},[],"Registration",{"_2856":1501,"_25053":1437,"_17489":45347,"_5":17384,"_23720":45184,"_2383":45348},[],"ID created automatically and correct DMS.",{"_2856":1502,"_25053":1437,"_17489":45350,"_5":17384,"_23720":45184,"_2383":45351},[],"Certificate",{"_2856":1503,"_25053":1437,"_17489":45353,"_5":17384,"_23720":45184,"_2383":45354},[],"CN, profile, serial and key verified.",{"_2856":1504,"_25053":1437,"_17489":45356,"_5":17384,"_23720":45184,"_2383":45357},[],"Inventory",{"_2856":1505,"_25053":1437,"_17489":45359,"_5":17384,"_23720":45184,"_2383":45360},[],"Received serial visible as the current identity and in history.",{"_2856":1506,"_25053":1437,"_17489":45362,"_5":17384,"_23720":45184,"_2383":45363},[],"Consumer",{"_2856":1507,"_25053":1437,"_17489":45365,"_5":17384,"_23720":45184,"_2383":45366},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_2856":1508,"_25053":1437,"_17489":45368,"_5":17384,"_23720":45184,"_2383":45369},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_2856":1509,"_25053":1437,"_17489":45371,"_5":17384,"_23720":45184,"_2383":45372},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_2856":1510,"_25053":1510,"_5":12268,"_2383":43027,"_25368":45374,"_17489":45375,"_23720":1510},[40693,42037,43011,45150],[],{"_2856":1511,"_25053":1510,"_17489":45377,"_5":17384,"_23720":1510,"_2383":45378},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_2856":1512,"_25053":1510,"_5":25365,"_17489":45380,"_23720":45381,"_2383":40703},[],"/docs/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_2856":1513,"_25053":1510,"_5":25365,"_17489":45383,"_23720":45384,"_2383":45385},[],"/docs/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_2856":1514,"_25053":1510,"_5":25365,"_17489":45387,"_23720":45388,"_2383":45389},[],"/docs/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_2856":1515,"_25053":1510,"_5":25365,"_17489":45391,"_23720":45392,"_2383":45393},[],"/docs/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_2856":1516,"_25053":1510,"_5":25365,"_17489":45395,"_23720":45396,"_2383":45397},[],"/docs/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_2856":1517,"_25053":1510,"_5":25365,"_17489":45399,"_23720":45400,"_2383":45401},[],"/docs/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_2856":1518,"_25053":1510,"_5":25365,"_17489":45403,"_23720":45404,"_2383":45342},[],"/docs/platform/iot-fleets/quickstarts/register-device#expected-result",{"_2856":1519,"_25053":1510,"_5":25365,"_17489":45406,"_23720":45407,"_2383":45408},[],"/docs/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_2856":1520,"_25053":1510,"_5":25365,"_17489":45410,"_23720":45411,"_2383":45412},[],"/docs/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_2856":1521,"_25053":1510,"_17489":45414,"_5":17384,"_23720":1510,"_2383":45415},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_2856":1522,"_25053":1510,"_17489":45417,"_5":17384,"_23720":1510,"_2383":45418},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_2856":1523,"_25053":1510,"_17489":45420,"_5":17384,"_23720":45381,"_2383":45421},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_2856":1524,"_25053":1510,"_17489":45423,"_5":17384,"_23720":45381,"_2383":45424},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_2856":1525,"_25053":1510,"_17489":45426,"_5":17384,"_23720":45381,"_2383":45427},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_2856":1526,"_25053":1510,"_17489":45429,"_5":17384,"_23720":45381,"_2383":45430},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_2856":1527,"_25053":1510,"_17489":45432,"_5":17384,"_23720":45384,"_2383":45433},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_2856":1528,"_25053":1510,"_17489":45435,"_5":17384,"_23720":45384,"_2383":45436},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_2856":1529,"_25053":1510,"_17489":45438,"_5":17384,"_23720":45384,"_2383":45439},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_2856":1530,"_25053":1510,"_17489":45441,"_5":17384,"_23720":45384,"_2383":45442},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_2856":1531,"_25053":1510,"_17489":45444,"_5":17384,"_23720":45384,"_2383":45445},[],"Set **Authentication Mode** to `CLIENT_CERTIFICATE` and add the CA whose initial certificates you will accept in **Validation CAs**. For this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and server key generation disabled if you will not use it.",{"_2856":1532,"_25053":1510,"_17489":45447,"_5":17384,"_23720":45384,"_2383":45448},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_2856":1533,"_25053":1510,"_17489":45450,"_5":17384,"_23720":45384,"_2383":45451},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_2856":1534,"_25053":1510,"_17489":45453,"_5":17384,"_23720":45384,"_2383":45454},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_2856":1535,"_25053":1510,"_17489":45456,"_5":17384,"_23720":45388,"_2383":45457},[],"Open **Managed Devices** and the registration action. Complete:",{"_2856":1536,"_25053":1510,"_17489":45459,"_5":17384,"_23720":45388,"_2383":45460},[],"**Device ID**: `device-001`.",{"_2856":1537,"_25053":1510,"_17489":45462,"_5":17384,"_23720":45388,"_2383":45463},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_2856":1538,"_25053":1510,"_17489":45465,"_5":17384,"_23720":45388,"_2383":45466},[],"**Icon** and **Tags**: optional classification.",{"_2856":1539,"_25053":1510,"_17489":45468,"_5":17384,"_23720":45388,"_2383":45469},[],"Confirm registration.",{"_2856":1540,"_25053":1510,"_17489":45471,"_5":17384,"_23720":45392,"_2383":45472},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_2856":1541,"_25053":1510,"_17489":45474,"_5":17384,"_23720":45392,"_2383":45475},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_2856":1542,"_25053":1510,"_17489":45477,"_5":17384,"_23720":45396,"_2383":45478},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_2856":1543,"_25053":1510,"_17489":45480,"_5":17384,"_23720":45396,"_2383":45481},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_2856":1544,"_25053":1510,"_17489":45483,"_5":17384,"_23720":45400,"_2383":45484},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_2856":1545,"_25053":1510,"_17489":45486,"_5":17384,"_23720":45400,"_2383":45487},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_2856":1546,"_25053":1510,"_17489":45489,"_5":17384,"_23720":45404,"_2383":45339},[],{"_2856":1547,"_25053":1510,"_17489":45491,"_5":17384,"_23720":45404,"_2383":45492},[],"Result",{"_2856":1548,"_25053":1510,"_17489":45494,"_5":17384,"_23720":45404,"_2383":45495},[],"Device",{"_2856":1549,"_25053":1510,"_17489":45497,"_5":17384,"_23720":45404,"_2383":45498},[],"`device-001` appears in inventory with the expected DMS.",{"_2856":1550,"_25053":1510,"_17489":45500,"_5":17384,"_23720":45404,"_2383":45501},[],"Current identity",{"_2856":1551,"_25053":1510,"_17489":45503,"_5":17384,"_23720":45404,"_2383":45504},[],"The associated certificate matches the one you verified in PKI.",{"_2856":1552,"_25053":1510,"_17489":45506,"_5":17384,"_23720":45404,"_2383":45507},[],"History",{"_2856":1553,"_25053":1510,"_17489":45509,"_5":17384,"_23720":45404,"_2383":45510},[],"The associated issuance appears with its serial number and dates.",{"_2856":1554,"_25053":1510,"_17489":45512,"_5":17384,"_23720":45404,"_2383":45513},[],"Key and certificate",{"_2856":1555,"_25053":1510,"_17489":45515,"_5":17384,"_23720":45404,"_2383":45516},[],"You have the verified pair ready to install on the device.",{"_2856":1556,"_25053":1510,"_17489":45518,"_5":17384,"_23720":45407,"_2383":45519},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_2856":1557,"_25053":1510,"_17489":45521,"_5":17384,"_23720":45407,"_2383":45522},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_2856":1558,"_25053":1510,"_17489":45524,"_5":17384,"_23720":45407,"_2383":45525},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_2856":1559,"_25053":1510,"_17489":45527,"_5":17384,"_23720":45407,"_2383":45528},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_2856":1560,"_25053":1510,"_17489":45530,"_5":17384,"_23720":45411,"_2383":45531},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_2856":1561,"_25053":1510,"_17489":45533,"_5":17384,"_23720":45411,"_2383":45534},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_2856":1562,"_25053":1510,"_17489":45536,"_5":17384,"_23720":45411,"_2383":45537},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_2856":1563,"_25053":1563,"_5":12268,"_2383":45539,"_25368":45540,"_17489":45541,"_23720":1563},"Lamassu IoT Platform",[40693,42037],[],{"_2856":1564,"_25053":1563,"_17489":45543,"_5":17384,"_23720":1563,"_2383":45544},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_2856":1565,"_25053":1563,"_5":25365,"_17489":45546,"_23720":45547,"_2383":45025},[],"/docs/platform/overview#start-here",{"_2856":1566,"_25053":1563,"_5":25365,"_17489":45549,"_23720":45550,"_2383":45551},[],"/docs/platform/overview#choose-your-path","Choose your path",{"_2856":1567,"_25053":1563,"_5":25365,"_17489":45553,"_23720":45554,"_2383":45555},[],"/docs/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_2856":1568,"_25053":1563,"_5":25365,"_17489":45557,"_23720":45558,"_2383":45559},[],"/docs/platform/overview#core-capabilities","Core capabilities",{"_2856":1569,"_25053":1563,"_5":25365,"_17489":45561,"_23720":45562,"_2383":45563},[],"/docs/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_2856":1570,"_25053":1563,"_5":25365,"_17489":45565,"_23720":45566,"_2383":45567},[],"/docs/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_2856":1571,"_25053":1563,"_5":25365,"_17489":45569,"_23720":45570,"_2383":45571},[],"/docs/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_2856":1572,"_25053":1563,"_5":25365,"_17489":45573,"_23720":45574,"_2383":45575},[],"/docs/platform/overview#automate-device-identities","Automate device identities",{"_2856":1573,"_25053":1563,"_5":25365,"_17489":45577,"_23720":45578,"_2383":45579},[],"/docs/platform/overview#publish-validation-status","Publish validation status",{"_2856":1574,"_25053":1563,"_5":25365,"_17489":45581,"_23720":45582,"_2383":45583},[],"/docs/platform/overview#react-to-events","React to events",{"_2856":1575,"_25053":1563,"_5":25365,"_17489":45585,"_23720":45586,"_2383":45587},[],"/docs/platform/overview#operational-reference","Operational reference",{"_2856":1576,"_25053":1563,"_17489":45589,"_5":17384,"_23720":1563,"_2383":45590},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_2856":1577,"_25053":1563,"_17489":45592,"_5":17384,"_23720":45547,"_2383":45593},[],"Choose the result you need:",{"_2856":1578,"_25053":1563,"_17489":45595,"_5":17384,"_23720":45547,"_2383":45596},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2856":1579,"_25053":1563,"_17489":45598,"_5":17384,"_23720":45547,"_2383":45599},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2856":1580,"_25053":1563,"_17489":45601,"_5":17384,"_23720":45547,"_2383":45602},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_2856":1581,"_25053":1563,"_17489":45604,"_5":17384,"_23720":45550,"_2383":45605},[],"Section",{"_2856":1582,"_25053":1563,"_17489":45607,"_5":17384,"_23720":45550,"_2383":45608},[],"What you manage",{"_2856":1583,"_25053":1563,"_17489":45610,"_5":17384,"_23720":45550,"_2383":45611},[],"Entry point",{"_2856":1584,"_25053":1563,"_17489":45613,"_5":17384,"_23720":45550,"_2383":45614},[],"**PKI**",{"_2856":1585,"_25053":1563,"_17489":45616,"_5":17384,"_23720":45550,"_2383":45617},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_2856":1586,"_25053":1563,"_17489":45619,"_5":17384,"_23720":45550,"_2383":45620},[],"PKI overview",{"_2856":1587,"_25053":1563,"_17489":45622,"_5":17384,"_23720":45550,"_2383":45623},[],"**IoT Fleets**",{"_2856":1588,"_25053":1563,"_17489":45625,"_5":17384,"_23720":45550,"_2383":45626},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_2856":1589,"_25053":1563,"_17489":45628,"_5":17384,"_23720":45550,"_2383":45629},[],"IoT Fleets overview",{"_2856":1590,"_25053":1563,"_17489":45631,"_5":17384,"_23720":45550,"_2383":45632},[],"**Administration**",{"_2856":1591,"_25053":1563,"_17489":45634,"_5":17384,"_23720":45550,"_2383":45635},[],"Operator permissions, audit and event subscriptions.",{"_2856":1592,"_25053":1563,"_17489":45637,"_5":17384,"_23720":45550,"_2383":42035},[],{"_2856":1593,"_25053":1563,"_17489":45639,"_5":17384,"_23720":45550,"_2383":45640},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_2856":1594,"_25053":1563,"_17489":45642,"_5":17384,"_23720":45554,"_2383":45643},[],"An identity's journey connects four responsibilities:",{"_2856":1595,"_25053":1563,"_17489":45645,"_5":17384,"_23720":45554,"_2383":45646},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_2856":1596,"_25053":1563,"_17489":45648,"_5":17384,"_23720":45554,"_2383":45649},[],"The provisioning administrator configures the DMS and initial trust.",{"_2856":1597,"_25053":1563,"_17489":45651,"_5":17384,"_23720":45554,"_2383":45652},[],"The device client requests a certificate and installs it with the matching key.",{"_2856":1598,"_25053":1563,"_17489":45654,"_5":17384,"_23720":45554,"_2383":45655},[],"The consumer validates the identity and applies its access permissions.",{"_2856":1599,"_25053":1563,"_17489":45657,"_5":17384,"_23720":45554,"_2383":45658},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_2856":1600,"_25053":1563,"_17489":45660,"_5":17384,"_23720":45562,"_2383":45661},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_2856":1601,"_25053":1563,"_17489":45663,"_5":17384,"_23720":45566,"_2383":45664},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_2856":1602,"_25053":1563,"_17489":45666,"_5":17384,"_23720":45570,"_2383":45667},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_2856":1603,"_25053":1563,"_17489":45669,"_5":17384,"_23720":45574,"_2383":45670},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_2856":1604,"_25053":1563,"_17489":45672,"_5":17384,"_23720":45578,"_2383":45673},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_2856":1605,"_25053":1563,"_17489":45675,"_5":17384,"_23720":45582,"_2383":45676},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_2856":1606,"_25053":1563,"_17489":45678,"_5":17384,"_23720":45586,"_2383":45119},[],{"_2856":1607,"_25053":1563,"_17489":45680,"_5":17384,"_23720":45586,"_2383":45681},[],"What it prepares or checks",{"_2856":1608,"_25053":1563,"_17489":45683,"_5":17384,"_23720":45586,"_2383":45122},[],{"_2856":1609,"_25053":1563,"_17489":45685,"_5":17384,"_23720":45586,"_2383":45686},[],"Key custody, CA hierarchy, profiles and validation.",{"_2856":1610,"_25053":1563,"_17489":45688,"_5":17384,"_23720":45586,"_2383":45689},[],"Fleet administrator",{"_2856":1611,"_25053":1563,"_17489":45691,"_5":17384,"_23720":45586,"_2383":45692},[],"DMS, device admission, renewal policy and inventory.",{"_2856":1612,"_25053":1563,"_17489":45694,"_5":17384,"_23720":45586,"_2383":45134},[],{"_2856":1613,"_25053":1563,"_17489":45696,"_5":17384,"_23720":45586,"_2383":45697},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_2856":1614,"_25053":1563,"_17489":45699,"_5":17384,"_23720":45586,"_2383":45140},[],{"_2856":1615,"_25053":1563,"_17489":45701,"_5":17384,"_23720":45586,"_2383":45702},[],"Issuer trust, certificate validation and permissions in the destination.",{"_2856":1616,"_25053":1563,"_17489":45704,"_5":17384,"_23720":45586,"_2383":45705},[],"Infrastructure operator",{"_2856":1617,"_25053":1563,"_17489":45707,"_5":17384,"_23720":45586,"_2383":45708},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_2856":1618,"_25053":1563,"_17489":45710,"_5":17384,"_23720":45586,"_2383":45711},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_2856":1619,"_25053":1619,"_5":12268,"_2383":45713,"_25368":45714,"_17489":45717,"_23720":1619},"CA hierarchy and rotation",[40693,42037,45715,45716],"PKI","Keys, authorities and certificates",[],{"_2856":1620,"_25053":1619,"_17489":45719,"_5":17384,"_23720":1619,"_2383":45720},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_2856":1621,"_25053":1619,"_5":25365,"_17489":45722,"_23720":45723,"_2383":45724},[],"/docs/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_2856":1622,"_25053":1619,"_5":25365,"_17489":45726,"_23720":45727,"_2383":45728},[],"/docs/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_2856":1623,"_25053":1619,"_5":25365,"_17489":45730,"_23720":45731,"_2383":45732},[],"/docs/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_2856":1624,"_25053":1619,"_5":25365,"_17489":45734,"_23720":45735,"_2383":45736},[],"/docs/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_2856":1625,"_25053":1619,"_5":25365,"_17489":45738,"_23720":45739,"_2383":45740},[],"/docs/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_2856":1626,"_25053":1619,"_5":25365,"_17489":45742,"_23720":45743,"_2383":45744},[],"/docs/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_2856":1627,"_25053":1619,"_5":25365,"_17489":45746,"_23720":45747,"_2383":45748},[],"/docs/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_2856":1628,"_25053":1619,"_5":25365,"_17489":45750,"_23720":45751,"_2383":45752},[],"/docs/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_2856":1629,"_25053":1619,"_5":25365,"_17489":45754,"_23720":45755,"_2383":45756},[],"/docs/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_2856":1630,"_25053":1619,"_5":25365,"_17489":45758,"_23720":45759,"_2383":45760},[],"/docs/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_2856":1631,"_25053":1619,"_5":25365,"_17489":45762,"_23720":45763,"_2383":45764},[],"/docs/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_2856":1632,"_25053":1619,"_5":25365,"_17489":45766,"_23720":45767,"_2383":45768},[],"/docs/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_2856":1633,"_25053":1619,"_17489":45770,"_5":17384,"_23720":1619,"_2383":45771},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_2856":1634,"_25053":1619,"_17489":45773,"_5":17384,"_23720":1619,"_2383":45774},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_2856":1635,"_25053":1619,"_17489":45776,"_5":17384,"_23720":45723,"_2383":45777},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_2856":1636,"_25053":1619,"_17489":45779,"_5":17384,"_23720":45723,"_2383":45780},[],"environment, such as production and preproduction;",{"_2856":1637,"_25053":1619,"_17489":45782,"_5":17384,"_23720":45723,"_2383":45783},[],"owner or operating team;",{"_2856":1638,"_25053":1619,"_17489":45785,"_5":17384,"_23720":45723,"_2383":45786},[],"device family or manufacturing process;",{"_2856":1639,"_25053":1619,"_17489":45788,"_5":17384,"_23720":45723,"_2383":45789},[],"region or regulatory requirement;",{"_2856":1640,"_25053":1619,"_17489":45791,"_5":17384,"_23720":45723,"_2383":45792},[],"cryptographic engine or key policy;",{"_2856":1641,"_25053":1619,"_17489":45794,"_5":17384,"_23720":45723,"_2383":45795},[],"maintenance window and renewal cadence.",{"_2856":1642,"_25053":1619,"_17489":45797,"_5":17384,"_23720":45723,"_2383":45798},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_2856":1643,"_25053":1619,"_17489":45800,"_5":17384,"_23720":45723,"_2383":45801},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_2856":1644,"_25053":1619,"_17489":45803,"_5":17384,"_23720":45727,"_2383":45804},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_2856":1645,"_25053":1619,"_17489":45806,"_5":17384,"_23720":45727,"_2383":45807},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_2856":1646,"_25053":1619,"_17489":45809,"_5":17384,"_23720":45727,"_2383":45810},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_2856":1647,"_25053":1619,"_17489":45812,"_5":17384,"_23720":45731,"_2383":45813},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_2856":1648,"_25053":1619,"_17489":45815,"_5":17384,"_23720":45731,"_2383":45816},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_2856":1649,"_25053":1619,"_17489":45818,"_5":17384,"_23720":45731,"_2383":45819},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_2856":1650,"_25053":1619,"_17489":45821,"_5":17384,"_23720":45731,"_2383":45822},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_2856":1651,"_25053":1619,"_17489":45824,"_5":17384,"_23720":45739,"_2383":45825},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_2856":1652,"_25053":1619,"_17489":45827,"_5":17384,"_23720":45743,"_2383":45828},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_2856":1653,"_25053":1619,"_17489":45830,"_5":17384,"_23720":45747,"_2383":45831},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_2856":1654,"_25053":1619,"_17489":45833,"_5":17384,"_23720":45751,"_2383":45834},[],"Update the enrollment CA and profile of the DMSs. Keep the additional validation CAs if old certificates still need to be accepted during re-enrollment.",{"_2856":1655,"_25053":1619,"_17489":45836,"_5":17384,"_23720":45755,"_2383":45837},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_2856":1656,"_25053":1619,"_17489":45839,"_5":17384,"_23720":45759,"_2383":45840},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance and from the distributed CAs. Revoke it if policy requires it.",{"_2856":1657,"_25053":1619,"_17489":45842,"_5":17384,"_23720":45763,"_2383":45843},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_2856":1658,"_25053":1619,"_17489":45845,"_5":17384,"_23720":45763,"_2383":45846},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_2856":1659,"_25053":1619,"_17489":45848,"_5":17384,"_23720":45763,"_2383":45849},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_2856":1660,"_25053":1619,"_17489":45851,"_5":17384,"_23720":45763,"_2383":45852},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_2856":1661,"_25053":1619,"_17489":45854,"_5":17384,"_23720":45767,"_2383":45855},[],"The new chain ends in an anchor installed by the consumer.",{"_2856":1662,"_25053":1619,"_17489":45857,"_5":17384,"_23720":45767,"_2383":45858},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_2856":1663,"_25053":1619,"_17489":45860,"_5":17384,"_23720":45767,"_2383":45861},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_2856":1664,"_25053":1619,"_17489":45863,"_5":17384,"_23720":45767,"_2383":45864},[],"Re-enrollment accepts the old identity during the planned period.",{"_2856":1665,"_25053":1619,"_17489":45866,"_5":17384,"_23720":45767,"_2383":45867},[],"OCSP and CRL respond for the authorities that remain active.",{"_2856":1666,"_25053":1619,"_17489":45869,"_5":17384,"_23720":45767,"_2383":45870},[],"No DMS is left accidentally issuing from the old CA.",{"_2856":1667,"_25053":1619,"_17489":45872,"_5":17384,"_23720":45767,"_2383":45873},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_2856":1668,"_25053":1668,"_5":12268,"_2383":45875,"_25368":45876,"_17489":45877,"_23720":1668},"Certification authorities",[40693,42037,45715,45716],[],{"_2856":1669,"_25053":1668,"_17489":45879,"_5":17384,"_23720":1668,"_2383":45880},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_2856":1670,"_25053":1668,"_5":25365,"_17489":45882,"_23720":45883,"_2383":45884},[],"/docs/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_2856":1671,"_25053":1668,"_5":25365,"_17489":45886,"_23720":45887,"_2383":45888},[],"/docs/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_2856":1672,"_25053":1668,"_5":25365,"_17489":45890,"_23720":45891,"_2383":40703},[],"/docs/platform/pki/certificate-authorities#before-you-begin",{"_2856":1673,"_25053":1668,"_5":25365,"_17489":45893,"_23720":45894,"_2383":45895},[],"/docs/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_2856":1674,"_25053":1668,"_5":25365,"_17489":45897,"_23720":45898,"_2383":45899},[],"/docs/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_2856":1675,"_25053":1668,"_5":25365,"_17489":45901,"_23720":45902,"_2383":45903},[],"/docs/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_2856":1676,"_25053":1668,"_5":25365,"_17489":45905,"_23720":45906,"_2383":45907},[],"/docs/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_2856":1677,"_25053":1668,"_5":25365,"_17489":45909,"_23720":45910,"_2383":45911},[],"/docs/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_2856":1678,"_25053":1668,"_5":25365,"_17489":45913,"_23720":45914,"_2383":45915},[],"/docs/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_2856":1679,"_25053":1668,"_5":25365,"_17489":45917,"_23720":45918,"_2383":45919},[],"/docs/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_2856":1680,"_25053":1668,"_5":25365,"_17489":45921,"_23720":45922,"_2383":45923},[],"/docs/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_2856":1681,"_25053":1668,"_5":25365,"_17489":45925,"_23720":45926,"_2383":45927},[],"/docs/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_2856":1682,"_25053":1668,"_5":25365,"_17489":45929,"_23720":45930,"_2383":45931},[],"/docs/platform/pki/certificate-authorities#load-the-material","Load the material",{"_2856":1683,"_25053":1668,"_5":25365,"_17489":45933,"_23720":45934,"_2383":45935},[],"/docs/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_2856":1684,"_25053":1668,"_5":25365,"_17489":45937,"_23720":45938,"_2383":45939},[],"/docs/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_2856":1685,"_25053":1668,"_5":25365,"_17489":45941,"_23720":45942,"_2383":45943},[],"/docs/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_2856":1686,"_25053":1668,"_5":25365,"_17489":45945,"_23720":45946,"_2383":45947},[],"/docs/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_2856":1687,"_25053":1668,"_5":25365,"_17489":45949,"_23720":45950,"_2383":45951},[],"/docs/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_2856":1688,"_25053":1668,"_5":25365,"_17489":45953,"_23720":45954,"_2383":45955},[],"/docs/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_2856":1689,"_25053":1668,"_5":25365,"_17489":45957,"_23720":45958,"_2383":45959},[],"/docs/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_2856":1690,"_25053":1668,"_5":25365,"_17489":45961,"_23720":45962,"_2383":45963},[],"/docs/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_2856":1691,"_25053":1668,"_5":25365,"_17489":45965,"_23720":45966,"_2383":45967},[],"/docs/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_2856":1692,"_25053":1668,"_17489":45969,"_5":17384,"_23720":1668,"_2383":45970},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_2856":1693,"_25053":1668,"_17489":45972,"_5":17384,"_23720":1668,"_2383":45973},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_2856":1694,"_25053":1668,"_17489":45975,"_5":17384,"_23720":1668,"_2383":45976},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_2856":1695,"_25053":1668,"_17489":45978,"_5":17384,"_23720":45883,"_2383":45979},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_2856":1696,"_25053":1668,"_17489":45981,"_5":17384,"_23720":45883,"_2383":45982},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_2856":1697,"_25053":1668,"_17489":45984,"_5":17384,"_23720":45883,"_2383":45985},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_2856":1698,"_25053":1668,"_17489":45987,"_5":17384,"_23720":45883,"_2383":45988},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_2856":1699,"_25053":1668,"_17489":45990,"_5":17384,"_23720":45883,"_2383":45991},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_2856":1700,"_25053":1668,"_17489":45993,"_5":17384,"_23720":45891,"_2383":45994},[],"Decide whether the CA will be a root or an intermediate.",{"_2856":1701,"_25053":1668,"_17489":45996,"_5":17384,"_23720":45891,"_2383":45997},[],"Choose the engine that will keep the key.",{"_2856":1702,"_25053":1668,"_17489":45999,"_5":17384,"_23720":45891,"_2383":46000},[],"Define a validity longer than that of the certificates it will issue.",{"_2856":1703,"_25053":1668,"_17489":46002,"_5":17384,"_23720":45891,"_2383":46003},[],"For an intermediate CA, make sure the parent CA is active.",{"_2856":1704,"_25053":1668,"_17489":46005,"_5":17384,"_23720":45894,"_2383":46006},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_2856":1705,"_25053":1668,"_17489":46008,"_5":17384,"_23720":45898,"_2383":46009},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_2856":1706,"_25053":1668,"_17489":46011,"_5":17384,"_23720":45898,"_2383":46012},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_2856":1707,"_25053":1668,"_17489":46014,"_5":17384,"_23720":45902,"_2383":46015},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_2856":1708,"_25053":1668,"_17489":46017,"_5":17384,"_23720":45906,"_2383":46018},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_2856":1709,"_25053":1668,"_17489":46020,"_5":17384,"_23720":45906,"_2383":46021},[],"`C`: two-letter ISO 3166-1 country code.",{"_2856":1710,"_25053":1668,"_17489":46023,"_5":17384,"_23720":45906,"_2383":46024},[],"`ST`: state or province.",{"_2856":1711,"_25053":1668,"_17489":46026,"_5":17384,"_23720":45906,"_2383":46027},[],"`L`: locality.",{"_2856":1712,"_25053":1668,"_17489":46029,"_5":17384,"_23720":45906,"_2383":46030},[],"`O`: organization.",{"_2856":1713,"_25053":1668,"_17489":46032,"_5":17384,"_23720":45906,"_2383":46033},[],"`OU`: organizational unit.",{"_2856":1714,"_25053":1668,"_17489":46035,"_5":17384,"_23720":45906,"_2383":46036},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_2856":1715,"_25053":1668,"_17489":46038,"_5":17384,"_23720":45910,"_2383":46039},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_2856":1716,"_25053":1668,"_17489":46041,"_5":17384,"_23720":45910,"_2383":46042},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_2856":1717,"_25053":1668,"_17489":46044,"_5":17384,"_23720":45914,"_2383":46045},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_2856":1718,"_25053":1668,"_17489":46047,"_5":17384,"_23720":45914,"_2383":46048},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_2856":1719,"_25053":1668,"_17489":46050,"_5":17384,"_23720":45918,"_2383":46051},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_2856":1720,"_25053":1668,"_17489":46053,"_5":17384,"_23720":45918,"_2383":46054},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_2856":1721,"_25053":1668,"_17489":46056,"_5":17384,"_23720":45922,"_2383":46057},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_2856":1722,"_25053":1668,"_17489":46059,"_5":17384,"_23720":45926,"_2383":46060},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_2856":1723,"_25053":1668,"_17489":46062,"_5":17384,"_23720":45930,"_2383":46063},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_2856":1724,"_25053":1668,"_17489":46065,"_5":17384,"_23720":45934,"_2383":46066},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_2856":1725,"_25053":1668,"_17489":46068,"_5":17384,"_23720":45938,"_2383":46069},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_2856":1726,"_25053":1668,"_17489":46071,"_5":17384,"_23720":45938,"_2383":46072},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_2856":1727,"_25053":1668,"_17489":46074,"_5":17384,"_23720":45942,"_2383":46075},[],"Open a CA from the inventory to review:",{"_2856":1728,"_25053":1668,"_17489":46077,"_5":17384,"_23720":45942,"_2383":46078},[],"Status and validity period.",{"_2856":1729,"_25053":1668,"_17489":46080,"_5":17384,"_23720":45942,"_2383":46081},[],"Certificate and chain in PEM format.",{"_2856":1730,"_25053":1668,"_17489":46083,"_5":17384,"_23720":45942,"_2383":46084},[],"Number of active, expired and revoked certificates.",{"_2856":1731,"_25053":1668,"_17489":46086,"_5":17384,"_23720":45942,"_2383":46087},[],"Certificates issued in **Issued Certificates**.",{"_2856":1732,"_25053":1668,"_17489":46089,"_5":17384,"_23720":45942,"_2383":46090},[],"The CRL linked to the authority.",{"_2856":1733,"_25053":1668,"_17489":46092,"_5":17384,"_23720":45942,"_2383":46093},[],"Metadata and the associated cryptographic engine.",{"_2856":1734,"_25053":1668,"_17489":46095,"_5":17384,"_23720":45942,"_2383":46096},[],"You can filter the inventory by name, status and CA type.",{"_2856":1735,"_25053":1668,"_17489":46098,"_5":17384,"_23720":45946,"_2383":46099},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_2856":1736,"_25053":1668,"_17489":46101,"_5":17384,"_23720":45946,"_2383":46102},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_2856":1737,"_25053":1668,"_17489":46104,"_5":17384,"_23720":45946,"_2383":46105},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_2856":1738,"_25053":1668,"_17489":46107,"_5":17384,"_23720":45946,"_2383":46108},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_2856":1739,"_25053":1668,"_17489":46110,"_5":17384,"_23720":45950,"_2383":46111},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_2856":1740,"_25053":1668,"_17489":46113,"_5":17384,"_23720":45954,"_2383":46114},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_2856":1741,"_25053":1668,"_17489":46116,"_5":17384,"_23720":45958,"_2383":46117},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_2856":1742,"_25053":1668,"_17489":46119,"_5":17384,"_23720":45962,"_2383":46120},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_2856":1743,"_25053":1668,"_17489":46122,"_5":17384,"_23720":45966,"_2383":46123},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_2856":1744,"_25053":1668,"_17489":46125,"_5":17384,"_23720":45966,"_2383":46126},[],"Permanent deletion is only available after revoking. Delete the record only when your retention and audit policy allows it.",{"_2856":1745,"_25053":1745,"_5":12268,"_2383":46128,"_25368":46129,"_17489":46130,"_23720":1745},"Certificate profiles",[40693,42037,45715,45716],[],{"_2856":1746,"_25053":1745,"_17489":46132,"_5":17384,"_23720":1745,"_2383":46133},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_2856":1747,"_25053":1745,"_5":25365,"_17489":46135,"_23720":46136,"_2383":46137},[],"/docs/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_2856":1748,"_25053":1745,"_5":25365,"_17489":46139,"_23720":46140,"_2383":46141},[],"/docs/platform/pki/certificate-profiles#validity","Validity",{"_2856":1749,"_25053":1745,"_5":25365,"_17489":46143,"_23720":46144,"_2383":46145},[],"/docs/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_2856":1750,"_25053":1745,"_5":25365,"_17489":46147,"_23720":46148,"_2383":46149},[],"/docs/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_2856":1751,"_25053":1745,"_5":25365,"_17489":46151,"_23720":46152,"_2383":46153},[],"/docs/platform/pki/certificate-profiles#subject","Subject",{"_2856":1752,"_25053":1745,"_5":25365,"_17489":46155,"_23720":46156,"_2383":46157},[],"/docs/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_2856":1753,"_25053":1745,"_5":25365,"_17489":46159,"_23720":46160,"_2383":46161},[],"/docs/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_2856":1754,"_25053":1745,"_5":25365,"_17489":46163,"_23720":46164,"_2383":46165},[],"/docs/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_2856":1755,"_25053":1745,"_5":25365,"_17489":46167,"_23720":46168,"_2383":46169},[],"/docs/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_2856":1756,"_25053":1745,"_5":25365,"_17489":46171,"_23720":46172,"_2383":46173},[],"/docs/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_2856":1757,"_25053":1745,"_5":25365,"_17489":46175,"_23720":46176,"_2383":46177},[],"/docs/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_2856":1758,"_25053":1745,"_5":25365,"_17489":46179,"_23720":46180,"_2383":46181},[],"/docs/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_2856":1759,"_25053":1745,"_5":25365,"_17489":46183,"_23720":46184,"_2383":46185},[],"/docs/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_2856":1760,"_25053":1745,"_5":25365,"_17489":46187,"_23720":46188,"_2383":46189},[],"/docs/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_2856":1761,"_25053":1745,"_5":25365,"_17489":46191,"_23720":46192,"_2383":46193},[],"/docs/platform/pki/certificate-profiles#design-examples","Design examples",{"_2856":1762,"_25053":1745,"_5":25365,"_17489":46195,"_23720":46196,"_2383":46197},[],"/docs/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_2856":1763,"_25053":1745,"_17489":46199,"_5":17384,"_23720":1745,"_2383":46200},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_2856":1764,"_25053":1745,"_17489":46202,"_5":17384,"_23720":1745,"_2383":46203},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_2856":1765,"_25053":1745,"_17489":46205,"_5":17384,"_23720":46140,"_2383":46206},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_2856":1766,"_25053":1745,"_17489":46208,"_5":17384,"_23720":46140,"_2383":46209},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_2856":1767,"_25053":1745,"_17489":46211,"_5":17384,"_23720":46144,"_2383":46212},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_2856":1768,"_25053":1745,"_17489":46214,"_5":17384,"_23720":46148,"_2383":46215},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_2856":1769,"_25053":1745,"_17489":46217,"_5":17384,"_23720":46148,"_2383":46218},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_2856":1770,"_25053":1745,"_17489":46220,"_5":17384,"_23720":46148,"_2383":46221},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_2856":1771,"_25053":1745,"_17489":46223,"_5":17384,"_23720":46152,"_2383":46224},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_2856":1772,"_25053":1745,"_17489":46226,"_5":17384,"_23720":46156,"_2383":46227},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_2856":1773,"_25053":1745,"_17489":46229,"_5":17384,"_23720":46156,"_2383":46230},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_2856":1774,"_25053":1745,"_17489":46232,"_5":17384,"_23720":46160,"_2383":46233},[],"The cryptographic enforcement can:",{"_2856":1775,"_25053":1745,"_17489":46235,"_5":17384,"_23720":46160,"_2383":46236},[],"allow or block RSA keys;",{"_2856":1776,"_25053":1745,"_17489":46238,"_5":17384,"_23720":46160,"_2383":46239},[],"limit the supported RSA sizes;",{"_2856":1777,"_25053":1745,"_17489":46241,"_5":17384,"_23720":46160,"_2383":46242},[],"allow or block ECDSA keys;",{"_2856":1778,"_25053":1745,"_17489":46244,"_5":17384,"_23720":46160,"_2383":46245},[],"limit the supported ECDSA sizes or curves.",{"_2856":1779,"_25053":1745,"_17489":46247,"_5":17384,"_23720":46160,"_2383":46248},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_2856":1780,"_25053":1745,"_17489":46250,"_5":17384,"_23720":46164,"_2383":46251},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_2856":1781,"_25053":1745,"_17489":46253,"_5":17384,"_23720":46164,"_2383":43755},[],{"_2856":1782,"_25053":1745,"_17489":46255,"_5":17384,"_23720":46164,"_2383":46256},[],"First choice",{"_2856":1783,"_25053":1745,"_17489":46258,"_5":17384,"_23720":46164,"_2383":46259},[],"Second choice",{"_2856":1784,"_25053":1745,"_17489":46261,"_5":17384,"_23720":46164,"_2383":46262},[],"If neither is supplied",{"_2856":1785,"_25053":1745,"_17489":46264,"_5":17384,"_23720":46164,"_2383":46265},[],"Direct signing with a CA",{"_2856":1786,"_25053":1745,"_17489":46267,"_5":17384,"_23720":46164,"_2383":46268},[],"`issuance_profile` embedded in the request",{"_2856":1787,"_25053":1745,"_17489":46270,"_5":17384,"_23720":46164,"_2383":46271},[],"Request `issuance_profile_id`",{"_2856":1788,"_25053":1745,"_17489":46273,"_5":17384,"_23720":46164,"_2383":46274},[],"CA default profile (`profile_id`).",{"_2856":1789,"_25053":1745,"_17489":46276,"_5":17384,"_23720":46164,"_2383":46277},[],"Issuance through a DMS",{"_2856":1790,"_25053":1745,"_17489":46279,"_5":17384,"_23720":46164,"_2383":46280},[],"`settings.issuance_profile_id`",{"_2856":1791,"_25053":1745,"_17489":46282,"_5":17384,"_23720":46164,"_2383":46283},[],"`settings.issuance_profile` embedded in the DMS",{"_2856":1792,"_25053":1745,"_17489":46285,"_5":17384,"_23720":46164,"_2383":46286},[],"Enrollment CA default profile.",{"_2856":1793,"_25053":1745,"_17489":46288,"_5":17384,"_23720":46164,"_2383":46289},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_2856":1794,"_25053":1745,"_17489":46291,"_5":17384,"_23720":46164,"_2383":46292},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_2856":1795,"_25053":1745,"_17489":46294,"_5":17384,"_23720":46172,"_2383":46295},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_2856":1796,"_25053":1745,"_17489":46297,"_5":17384,"_23720":46176,"_2383":46298},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_2856":1797,"_25053":1745,"_17489":46300,"_5":17384,"_23720":46180,"_2383":46301},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_2856":1798,"_25053":1745,"_17489":46303,"_5":17384,"_23720":46184,"_2383":46304},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_2856":1799,"_25053":1745,"_17489":46306,"_5":17384,"_23720":46188,"_2383":46307},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_2856":1800,"_25053":1745,"_17489":46309,"_5":17384,"_23720":46188,"_2383":46310},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_2856":1801,"_25053":1745,"_17489":46312,"_5":17384,"_23720":46192,"_2383":46313},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_2856":1802,"_25053":1745,"_17489":46315,"_5":17384,"_23720":46192,"_2383":46316},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_2856":1803,"_25053":1745,"_17489":46318,"_5":17384,"_23720":46192,"_2383":46319},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_2856":1804,"_25053":1745,"_17489":46321,"_5":17384,"_23720":46192,"_2383":46322},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_2856":1805,"_25053":1745,"_17489":46324,"_5":17384,"_23720":46196,"_2383":46325},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_2856":1806,"_25053":1745,"_17489":46327,"_5":17384,"_23720":46196,"_2383":46328},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_2856":1807,"_25053":1807,"_5":12268,"_2383":46330,"_25368":46331,"_17489":46333,"_23720":1807},"Certificate validation",[40693,42037,45715,46332],"Validation",[],{"_2856":1808,"_25053":1807,"_17489":46335,"_5":17384,"_23720":1807,"_2383":46336},[],"Check chain, identity, purpose and revocation from the consumer.",{"_2856":1809,"_25053":1807,"_5":25365,"_17489":46338,"_23720":46339,"_2383":46340},[],"/docs/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_2856":1810,"_25053":1807,"_5":25365,"_17489":46342,"_23720":46343,"_2383":46344},[],"/docs/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_2856":1811,"_25053":1807,"_5":25365,"_17489":46346,"_23720":46347,"_2383":46348},[],"/docs/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_2856":1812,"_25053":1807,"_17489":46350,"_5":17384,"_23720":1807,"_2383":46351},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_2856":1813,"_25053":1807,"_17489":46353,"_5":17384,"_23720":46339,"_2383":46354},[],"Verify these criteria together:",{"_2856":1814,"_25053":1807,"_17489":46356,"_5":17384,"_23720":46339,"_2383":45339},[],{"_2856":1815,"_25053":1807,"_17489":46358,"_5":17384,"_23720":46339,"_2383":46359},[],"Required result",{"_2856":1816,"_25053":1807,"_17489":46361,"_5":17384,"_23720":46339,"_2383":46362},[],"Chain and signature",{"_2856":1817,"_25053":1807,"_17489":46364,"_5":17384,"_23720":46339,"_2383":46365},[],"Valid chain to a root deliberately installed in the consumer.",{"_2856":1818,"_25053":1807,"_17489":46367,"_5":17384,"_23720":46339,"_2383":46368},[],"Dates",{"_2856":1819,"_25053":1807,"_17489":46370,"_5":17384,"_23720":46339,"_2383":46371},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_2856":1820,"_25053":1807,"_17489":46373,"_5":17384,"_23720":46339,"_2383":41740},[],{"_2856":1821,"_25053":1807,"_17489":46375,"_5":17384,"_23720":46339,"_2383":46376},[],"Name, SAN or identifier matches the expected peer.",{"_2856":1822,"_25053":1807,"_17489":46378,"_5":17384,"_23720":46339,"_2383":41076},[],{"_2856":1823,"_25053":1807,"_17489":46380,"_5":17384,"_23720":46339,"_2383":46381},[],"KU, EKU and constraints permit the specific operation.",{"_2856":1824,"_25053":1807,"_17489":46383,"_5":17384,"_23720":46339,"_2383":46384},[],"Revocation",{"_2856":1825,"_25053":1807,"_17489":46386,"_5":17384,"_23720":46339,"_2383":46387},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_2856":1826,"_25053":1807,"_17489":46389,"_5":17384,"_23720":46339,"_2383":46390},[],"Authorization",{"_2856":1827,"_25053":1807,"_17489":46392,"_5":17384,"_23720":46339,"_2383":46393},[],"The application permits that identity to perform the action.",{"_2856":1828,"_25053":1807,"_17489":46395,"_5":17384,"_23720":46339,"_2383":46396},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_2856":1829,"_25053":1807,"_17489":46398,"_5":17384,"_23720":46343,"_2383":46399},[],"Mechanism",{"_2856":1830,"_25053":1807,"_17489":46401,"_5":17384,"_23720":46343,"_2383":46402},[],"When to use it",{"_2856":1831,"_25053":1807,"_17489":46404,"_5":17384,"_23720":46343,"_2383":46405},[],"What you must maintain",{"_2856":1832,"_25053":1807,"_17489":46407,"_5":17384,"_23720":46343,"_2383":46408},[],"OCSP",{"_2856":1833,"_25053":1807,"_17489":46410,"_5":17384,"_23720":46343,"_2383":46411},[],"Status query for a specific certificate.",{"_2856":1834,"_25053":1807,"_17489":46413,"_5":17384,"_23720":46343,"_2383":46414},[],"Responder access, signature verification and cache/freshness policy.",{"_2856":1835,"_25053":1807,"_17489":46416,"_5":17384,"_23720":46343,"_2383":46417},[],"CRL",{"_2856":1836,"_25053":1807,"_17489":46419,"_5":17384,"_23720":46343,"_2383":46420},[],"Local checks for many certificates or offline operation.",{"_2856":1837,"_25053":1807,"_17489":46422,"_5":17384,"_23720":46343,"_2383":46423},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_2856":1838,"_25053":1807,"_17489":46425,"_5":17384,"_23720":46343,"_2383":46426},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_2856":1839,"_25053":1807,"_17489":46428,"_5":17384,"_23720":46343,"_2383":46429},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_2856":1840,"_25053":1807,"_17489":46431,"_5":17384,"_23720":46347,"_2383":46432},[],"Accept a current, authorized certificate with a known chain.",{"_2856":1841,"_25053":1807,"_17489":46434,"_5":17384,"_23720":46347,"_2383":46435},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_2856":1842,"_25053":1807,"_17489":46437,"_5":17384,"_23720":46347,"_2383":46438},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_2856":1843,"_25053":1807,"_17489":46440,"_5":17384,"_23720":46347,"_2383":46441},[],"Check that a new connection with that identity is rejected.",{"_2856":1844,"_25053":1807,"_17489":46443,"_5":17384,"_23720":46347,"_2383":46444},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_2856":1845,"_25053":1807,"_17489":46446,"_5":17384,"_23720":46347,"_2383":46447},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_2856":1846,"_25053":1807,"_17489":46449,"_5":17384,"_23720":46347,"_2383":46450},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_2856":1847,"_25053":1807,"_17489":46452,"_5":17384,"_23720":46347,"_2383":46453},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_2856":1848,"_25053":1807,"_17489":46455,"_5":17384,"_23720":46347,"_2383":46456},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_2856":1849,"_25053":1849,"_5":12268,"_2383":46458,"_25368":46459,"_17489":46460,"_23720":1849},"Certificates",[40693,42037,45715,45716],[],{"_2856":1850,"_25053":1849,"_17489":46462,"_5":17384,"_23720":1849,"_2383":46463},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_2856":1851,"_25053":1849,"_5":25365,"_17489":46465,"_23720":46466,"_2383":46467},[],"/docs/platform/pki/certificates#find-a-certificate","Find a certificate",{"_2856":1852,"_25053":1849,"_5":25365,"_17489":46469,"_23720":46470,"_2383":46471},[],"/docs/platform/pki/certificates#download-the-certificate","Download the certificate",{"_2856":1853,"_25053":1849,"_5":25365,"_17489":46473,"_23720":46474,"_2383":46475},[],"/docs/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_2856":1854,"_25053":1849,"_5":25365,"_17489":46477,"_23720":46478,"_2383":46479},[],"/docs/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_2856":1855,"_25053":1849,"_5":25365,"_17489":46481,"_23720":46482,"_2383":46483},[],"/docs/platform/pki/certificates#open-the-action","Open the action",{"_2856":1856,"_25053":1849,"_5":25365,"_17489":46485,"_23720":46486,"_2383":46487},[],"/docs/platform/pki/certificates#choose-a-reason","Choose a reason",{"_2856":1857,"_25053":1849,"_5":25365,"_17489":46489,"_23720":46490,"_2383":46491},[],"/docs/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_2856":1858,"_25053":1849,"_5":25365,"_17489":46493,"_23720":46494,"_2383":46495},[],"/docs/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_2856":1859,"_25053":1849,"_5":25365,"_17489":46497,"_23720":46498,"_2383":46499},[],"/docs/platform/pki/certificates#continue","Continue",{"_2856":1860,"_25053":1849,"_17489":46501,"_5":17384,"_23720":1849,"_2383":46502},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_2856":1861,"_25053":1849,"_17489":46504,"_5":17384,"_23720":46466,"_2383":46505},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_2856":1862,"_25053":1849,"_17489":46507,"_5":17384,"_23720":46466,"_2383":46508},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_2856":1863,"_25053":1849,"_17489":46510,"_5":17384,"_23720":46470,"_2383":46511},[],"Download the PEM and inspect it:",{"_2856":1864,"_25053":1849,"_17489":46513,"_5":17384,"_23720":46470,"_2383":46514},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_2856":1865,"_25053":1849,"_17489":46516,"_5":17384,"_23720":46474,"_2383":46517},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_2856":1866,"_25053":1849,"_17489":46519,"_5":17384,"_23720":46474,"_2383":46520},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_2856":1867,"_25053":1849,"_17489":46522,"_5":17384,"_23720":46474,"_2383":46523},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_2856":1868,"_25053":1849,"_17489":46525,"_5":17384,"_23720":46474,"_2383":46526},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_2856":1869,"_25053":1849,"_17489":46528,"_5":17384,"_23720":46474,"_2383":46529},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_2856":1870,"_25053":1849,"_17489":46531,"_5":17384,"_23720":46474,"_2383":46532},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_2856":1871,"_25053":1849,"_17489":46534,"_5":17384,"_23720":46474,"_2383":46535},[],"For browser key generation, follow Issue your first certificate.",{"_2856":1872,"_25053":1849,"_17489":46537,"_5":17384,"_23720":46478,"_2383":46538},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_2856":1873,"_25053":1849,"_17489":46540,"_5":17384,"_23720":46482,"_2383":46541},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_2856":1874,"_25053":1849,"_17489":46543,"_5":17384,"_23720":46486,"_2383":46544},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_2856":1875,"_25053":1849,"_17489":46546,"_5":17384,"_23720":46490,"_2383":46547},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_2856":1876,"_25053":1849,"_17489":46549,"_5":17384,"_23720":46490,"_2383":46550},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_2856":1877,"_25053":1849,"_17489":46552,"_5":17384,"_23720":46490,"_2383":46553},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_2856":1878,"_25053":1849,"_17489":46555,"_5":17384,"_23720":46494,"_2383":46556},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_2856":1879,"_25053":1849,"_17489":46558,"_5":17384,"_23720":46494,"_2383":46559},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_2856":1880,"_25053":1849,"_17489":46561,"_5":17384,"_23720":46494,"_2383":46562},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_2856":1881,"_25053":1849,"_17489":46564,"_5":17384,"_23720":46498,"_2383":46565},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_2856":1882,"_25053":1849,"_17489":46567,"_5":17384,"_23720":46498,"_2383":46568},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_2856":1883,"_25053":1883,"_5":12268,"_2383":46570,"_25368":46571,"_17489":46573,"_23720":1883},"Certificate lifecycle",[40693,42037,45715,46572],"Concepts",[],{"_2856":1884,"_25053":1883,"_17489":46575,"_5":17384,"_23720":1883,"_2383":46576},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_2856":1885,"_25053":1883,"_5":25365,"_17489":46578,"_23720":46579,"_2383":46580},[],"/docs/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_2856":1886,"_25053":1883,"_5":25365,"_17489":46582,"_23720":46583,"_2383":46584},[],"/docs/platform/pki/concepts/certificate-lifecycle#request","Request",{"_2856":1887,"_25053":1883,"_5":25365,"_17489":46586,"_23720":46587,"_2383":46588},[],"/docs/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_2856":1888,"_25053":1883,"_5":25365,"_17489":46590,"_23720":46591,"_2383":46592},[],"/docs/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_2856":1889,"_25053":1883,"_5":25365,"_17489":46594,"_23720":46595,"_2383":46596},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_2856":1890,"_25053":1883,"_5":25365,"_17489":46598,"_23720":46599,"_2383":46600},[],"/docs/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_2856":1891,"_25053":1883,"_5":25365,"_17489":46602,"_23720":46603,"_2383":46604},[],"/docs/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_2856":1892,"_25053":1883,"_5":25365,"_17489":46606,"_23720":46607,"_2383":46608},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_2856":1893,"_25053":1883,"_5":25365,"_17489":46610,"_23720":46611,"_2383":46612},[],"/docs/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_2856":1894,"_25053":1883,"_5":25365,"_17489":46614,"_23720":46615,"_2383":46616},[],"/docs/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_2856":1895,"_25053":1883,"_17489":46618,"_5":17384,"_23720":1883,"_2383":46619},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_2856":1896,"_25053":1883,"_17489":46621,"_5":17384,"_23720":46583,"_2383":46622},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_2856":1897,"_25053":1883,"_17489":46624,"_5":17384,"_23720":46587,"_2383":46625},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_2856":1898,"_25053":1883,"_17489":46627,"_5":17384,"_23720":46591,"_2383":46628},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_2856":1899,"_25053":1883,"_17489":46630,"_5":17384,"_23720":46595,"_2383":46631},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_2856":1900,"_25053":1883,"_17489":46633,"_5":17384,"_23720":46599,"_2383":46634},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_2856":1901,"_25053":1883,"_17489":46636,"_5":17384,"_23720":46603,"_2383":46637},[],"Lamassu persists four X.509 states:",{"_2856":1902,"_25053":1883,"_17489":46639,"_5":17384,"_23720":46603,"_2383":46640},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_2856":1903,"_25053":1883,"_17489":46642,"_5":17384,"_23720":46603,"_2383":46643},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_2856":1904,"_25053":1883,"_17489":46645,"_5":17384,"_23720":46603,"_2383":46646},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_2856":1905,"_25053":1883,"_17489":46648,"_5":17384,"_23720":46603,"_2383":46649},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_2856":1906,"_25053":1883,"_17489":46651,"_5":17384,"_23720":46603,"_2383":46652},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_2856":1907,"_25053":1883,"_17489":46654,"_5":17384,"_23720":46607,"_2383":46655},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_2856":1908,"_25053":1883,"_17489":46657,"_5":17384,"_23720":46607,"_2383":46658},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_2856":1909,"_25053":1883,"_17489":46660,"_5":17384,"_23720":46607,"_2383":46661},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_2856":1910,"_25053":1883,"_17489":46663,"_5":17384,"_23720":46611,"_2383":46664},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_2856":1911,"_25053":1883,"_17489":46666,"_5":17384,"_23720":46611,"_2383":46667},[],"Before confirming:",{"_2856":1912,"_25053":1883,"_17489":46669,"_5":17384,"_23720":46611,"_2383":46670},[],"Identify DMSs, devices and services that trust that chain.",{"_2856":1913,"_25053":1883,"_17489":46672,"_5":17384,"_23720":46611,"_2383":46673},[],"Distribute the new chain of trust.",{"_2856":1914,"_25053":1883,"_17489":46675,"_5":17384,"_23720":46611,"_2383":46676},[],"Reissue the necessary identities.",{"_2856":1915,"_25053":1883,"_17489":46678,"_5":17384,"_23720":46611,"_2383":46679},[],"Check OCSP and CRL from a real consumer.",{"_2856":1916,"_25053":1883,"_17489":46681,"_5":17384,"_23720":46611,"_2383":46682},[],"Revoke the old CA once no legitimate traffic remains.",{"_2856":1917,"_25053":1883,"_17489":46684,"_5":17384,"_23720":46611,"_2383":46685},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_2856":1918,"_25053":1883,"_17489":46687,"_5":17384,"_23720":46615,"_2383":46688},[],"Certificates entering the preventive or critical renewal window.",{"_2856":1919,"_25053":1883,"_17489":46690,"_5":17384,"_23720":46615,"_2383":46691},[],"Repeated enrollment or re-enrollment failures.",{"_2856":1920,"_25053":1883,"_17489":46693,"_5":17384,"_23720":46615,"_2383":46694},[],"Status changes and revocation reasons.",{"_2856":1921,"_25053":1883,"_17489":46696,"_5":17384,"_23720":46615,"_2383":46697},[],"OCSP and CRL publication and validity.",{"_2856":1922,"_25053":1883,"_17489":46699,"_5":17384,"_23720":46615,"_2383":46700},[],"Dependencies still presenting a replaced certificate.",{"_2856":1923,"_25053":1883,"_17489":46702,"_5":17384,"_23720":46615,"_2383":46703},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_2856":1924,"_25053":1924,"_5":12268,"_2383":46705,"_25368":46706,"_17489":46707,"_23720":1924},"Trust model",[40693,42037,45715,46572],[],{"_2856":1925,"_25053":1924,"_17489":46709,"_5":17384,"_23720":1924,"_2383":46710},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_2856":1926,"_25053":1924,"_5":25365,"_17489":46712,"_23720":46713,"_2383":46714},[],"/docs/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_2856":1927,"_25053":1924,"_5":25365,"_17489":46716,"_23720":46717,"_2383":46718},[],"/docs/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_2856":1928,"_25053":1924,"_5":25365,"_17489":46720,"_23720":46721,"_2383":46722},[],"/docs/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_2856":1929,"_25053":1924,"_5":25365,"_17489":46724,"_23720":46725,"_2383":46726},[],"/docs/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_2856":1930,"_25053":1924,"_5":25365,"_17489":46728,"_23720":46729,"_2383":46730},[],"/docs/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_2856":1931,"_25053":1924,"_5":25365,"_17489":46732,"_23720":46733,"_2383":46734},[],"/docs/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_2856":1932,"_25053":1924,"_5":25365,"_17489":46736,"_23720":46737,"_2383":46738},[],"/docs/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_2856":1933,"_25053":1924,"_5":25365,"_17489":46740,"_23720":46741,"_2383":46742},[],"/docs/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_2856":1934,"_25053":1924,"_5":25365,"_17489":46744,"_23720":46745,"_2383":46746},[],"/docs/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_2856":1935,"_25053":1924,"_5":25365,"_17489":46748,"_23720":46749,"_2383":46750},[],"/docs/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_2856":1936,"_25053":1924,"_17489":46752,"_5":17384,"_23720":1924,"_2383":46753},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_2856":1937,"_25053":1924,"_17489":46755,"_5":17384,"_23720":46717,"_2383":46756},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_2856":1938,"_25053":1924,"_17489":46758,"_5":17384,"_23720":46721,"_2383":46759},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_2856":1939,"_25053":1924,"_17489":46761,"_5":17384,"_23720":46725,"_2383":46762},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_2856":1940,"_25053":1924,"_17489":46764,"_5":17384,"_23720":46729,"_2383":46765},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_2856":1941,"_25053":1924,"_17489":46767,"_5":17384,"_23720":46733,"_2383":46768},[],"The device proves it can enroll according to the DMS policy.",{"_2856":1942,"_25053":1924,"_17489":46770,"_5":17384,"_23720":46733,"_2383":46771},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_2856":1943,"_25053":1924,"_17489":46773,"_5":17384,"_23720":46733,"_2383":46774},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_2856":1944,"_25053":1924,"_17489":46776,"_5":17384,"_23720":46733,"_2383":46777},[],"The device installs the certificate and the chain it needs.",{"_2856":1945,"_25053":1924,"_17489":46779,"_5":17384,"_23720":46733,"_2383":46780},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_2856":1946,"_25053":1924,"_17489":46782,"_5":17384,"_23720":46733,"_2383":46783},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_2856":1947,"_25053":1924,"_17489":46785,"_5":17384,"_23720":46737,"_2383":46786},[],"A DMS relates three sets that are worth designing separately:",{"_2856":1948,"_25053":1924,"_17489":46788,"_5":17384,"_23720":46737,"_2383":46789},[],"**Enrollment CA:** signs the new identities.",{"_2856":1949,"_25053":1924,"_17489":46791,"_5":17384,"_23720":46737,"_2383":46792},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, Lamassu tries the enrollment CA first and then the additional validation CAs.",{"_2856":1950,"_25053":1924,"_17489":46794,"_5":17384,"_23720":46737,"_2383":46795},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_2856":1951,"_25053":1924,"_17489":46797,"_5":17384,"_23720":46737,"_2383":46798},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_2856":1952,"_25053":1924,"_17489":46800,"_5":17384,"_23720":46741,"_2383":46801},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_2856":1953,"_25053":1924,"_17489":46803,"_5":17384,"_23720":46741,"_2383":46804},[],"that the current date is between `Not Before` and `Not After`;",{"_2856":1954,"_25053":1924,"_17489":46806,"_5":17384,"_23720":46741,"_2383":46807},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_2856":1955,"_25053":1924,"_17489":46809,"_5":17384,"_23720":46741,"_2383":46810},[],"that names, SANs and subject match the expected identity;",{"_2856":1956,"_25053":1924,"_17489":46812,"_5":17384,"_23720":46741,"_2383":46813},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_2856":1957,"_25053":1924,"_17489":46815,"_5":17384,"_23720":46741,"_2383":46816},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_2856":1958,"_25053":1924,"_17489":46818,"_5":17384,"_23720":46741,"_2383":46819},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_2856":1959,"_25053":1924,"_17489":46821,"_5":17384,"_23720":46745,"_2383":46822},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_2856":1960,"_25053":1924,"_17489":46824,"_5":17384,"_23720":46749,"_2383":46825},[],"Keep the root out of daily operations, or with very restricted access.",{"_2856":1961,"_25053":1924,"_17489":46827,"_5":17384,"_23720":46749,"_2383":46828},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_2856":1962,"_25053":1924,"_17489":46830,"_5":17384,"_23720":46749,"_2383":46831},[],"Assign explicit profiles to every use case.",{"_2856":1963,"_25053":1924,"_17489":46833,"_5":17384,"_23720":46749,"_2383":46834},[],"Distribute the new trust before starting a rotation.",{"_2856":1964,"_25053":1924,"_17489":46836,"_5":17384,"_23720":46749,"_2383":46837},[],"Keep enough overlap to renew a disconnected fleet.",{"_2856":1965,"_25053":1924,"_17489":46839,"_5":17384,"_23720":46749,"_2383":46840},[],"Validate from the consuming system, not only from the Lamassu console.",{"_2856":1966,"_25053":1924,"_17489":46842,"_5":17384,"_23720":46749,"_2383":46843},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_2856":1967,"_25053":1967,"_5":12268,"_2383":46845,"_25368":46846,"_17489":46847,"_23720":1967},"Revocation lists (CRL)",[40693,42037,45715,46332],[],{"_2856":1968,"_25053":1967,"_17489":46849,"_5":17384,"_23720":1967,"_2383":46850},[],"Generate and distribute signed lists to validate certificates offline.",{"_2856":1969,"_25053":1967,"_5":25365,"_17489":46852,"_23720":46853,"_2383":46854},[],"/docs/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_2856":1970,"_25053":1967,"_5":25365,"_17489":46856,"_23720":46857,"_2383":46858},[],"/docs/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_2856":1971,"_25053":1967,"_5":25365,"_17489":46860,"_23720":46861,"_2383":46862},[],"/docs/platform/pki/crl#crl-contents","CRL contents",{"_2856":1972,"_25053":1967,"_5":25365,"_17489":46864,"_23720":46865,"_2383":46866},[],"/docs/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_2856":1973,"_25053":1967,"_5":25365,"_17489":46868,"_23720":46869,"_2383":46870},[],"/docs/platform/pki/crl#va-role-management-api","VA role management API",{"_2856":1974,"_25053":1967,"_5":25365,"_17489":46872,"_23720":46873,"_2383":46874},[],"/docs/platform/pki/crl#from-the-interface","From the interface",{"_2856":1975,"_25053":1967,"_5":25365,"_17489":46876,"_23720":46877,"_2383":46878},[],"/docs/platform/pki/crl#references","References",{"_2856":1976,"_25053":1967,"_17489":46880,"_5":17384,"_23720":1967,"_2383":46881},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_2856":1977,"_25053":1967,"_17489":46883,"_5":17384,"_23720":46853,"_2383":46884},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_2856":1978,"_25053":1967,"_17489":46886,"_5":17384,"_23720":46853,"_2383":46887},[],"`crl_options` field",{"_2856":1979,"_25053":1967,"_17489":46889,"_5":17384,"_23720":46853,"_2383":41076},[],{"_2856":1980,"_25053":1967,"_17489":46891,"_5":17384,"_23720":46853,"_2383":46892},[],"Backend initial value",{"_2856":1981,"_25053":1967,"_17489":46894,"_5":17384,"_23720":46853,"_2383":46895},[],"`validity`",{"_2856":1982,"_25053":1967,"_17489":46897,"_5":17384,"_23720":46853,"_2383":46898},[],"Time from `thisUpdate` to `nextUpdate`.",{"_2856":1983,"_25053":1967,"_17489":46900,"_5":17384,"_23720":46853,"_2383":46901},[],"7 days.",{"_2856":1984,"_25053":1967,"_17489":46903,"_5":17384,"_23720":46853,"_2383":46904},[],"`refresh_interval`",{"_2856":1985,"_25053":1967,"_17489":46906,"_5":17384,"_23720":46853,"_2383":46907},[],"Time since publication that triggers scheduled renewal.",{"_2856":1986,"_25053":1967,"_17489":46909,"_5":17384,"_23720":46853,"_2383":46910},[],"6 days and 23 hours.",{"_2856":1987,"_25053":1967,"_17489":46912,"_5":17384,"_23720":46853,"_2383":46913},[],"`regenerate_on_revoke`",{"_2856":1988,"_25053":1967,"_17489":46915,"_5":17384,"_23720":46853,"_2383":46916},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_2856":1989,"_25053":1967,"_17489":46918,"_5":17384,"_23720":46853,"_2383":46919},[],"`true`.",{"_2856":1990,"_25053":1967,"_17489":46921,"_5":17384,"_23720":46853,"_2383":46922},[],"`subject_key_id_signer`",{"_2856":1991,"_25053":1967,"_17489":46924,"_5":17384,"_23720":46853,"_2383":46925},[],"Configuration field initialized with the CA’s SKI.",{"_2856":1992,"_25053":1967,"_17489":46927,"_5":17384,"_23720":46853,"_2383":46928},[],"CA SKI.",{"_2856":1993,"_25053":1967,"_17489":46930,"_5":17384,"_23720":46853,"_2383":46931},[],"The generator uses the key of the CA identified by the requested SKI. Do not interpret `subject_key_id_signer` as verified support for a different delegated CA: changing that field does not change the signer in this flow.",{"_2856":1994,"_25053":1967,"_17489":46933,"_5":17384,"_23720":46853,"_2383":46934},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_2856":1995,"_25053":1967,"_17489":46936,"_5":17384,"_23720":46857,"_2383":46937},[],"The scheduled job requests another list when `refresh_interval` is reached or when the list approaches expiration within the configured watch period. This depends on working jobs, storage and signing; it does not guarantee renewal during a service failure.",{"_2856":1996,"_25053":1967,"_17489":46939,"_5":17384,"_23720":46857,"_2383":46940},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_2856":1997,"_25053":1967,"_17489":46942,"_5":17384,"_23720":46857,"_2383":46943},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_2856":1998,"_25053":1967,"_17489":46945,"_5":17384,"_23720":46861,"_2383":46946},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_2856":1999,"_25053":1967,"_17489":46948,"_5":17384,"_23720":46861,"_2383":46949},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_2856":2000,"_25053":1967,"_17489":46951,"_5":17384,"_23720":46865,"_2383":46952},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_2856":2001,"_25053":1967,"_17489":46954,"_5":17384,"_23720":46865,"_2383":46955},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_2856":2002,"_25053":1967,"_17489":46957,"_5":17384,"_23720":46865,"_2383":46958},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_2856":2003,"_25053":1967,"_17489":46960,"_5":17384,"_23720":46865,"_2383":46961},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_2856":2004,"_25053":1967,"_17489":46963,"_5":17384,"_23720":46865,"_2383":46964},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_2856":2005,"_25053":1967,"_17489":46966,"_5":17384,"_23720":46869,"_2383":46967},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_2856":2006,"_25053":1967,"_17489":46969,"_5":17384,"_23720":46869,"_2383":43758},[],{"_2856":2007,"_25053":1967,"_17489":46971,"_5":17384,"_23720":46869,"_2383":46972},[],"Relative path",{"_2856":2008,"_25053":1967,"_17489":46974,"_5":17384,"_23720":46869,"_2383":43755},[],{"_2856":2009,"_25053":1967,"_17489":46976,"_5":17384,"_23720":46869,"_2383":46977},[],"`GET`",{"_2856":2010,"_25053":1967,"_17489":46979,"_5":17384,"_23720":46869,"_2383":46980},[],"`/v1/roles/{ca-ski}`",{"_2856":2011,"_25053":1967,"_17489":46982,"_5":17384,"_23720":46869,"_2383":46983},[],"Read `crl_options` and `latest_crl`.",{"_2856":2012,"_25053":1967,"_17489":46985,"_5":17384,"_23720":46869,"_2383":46986},[],"`PUT`",{"_2856":2013,"_25053":1967,"_17489":46988,"_5":17384,"_23720":46869,"_2383":46980},[],{"_2856":2014,"_25053":1967,"_17489":46990,"_5":17384,"_23720":46869,"_2383":46991},[],"Replace CRL configuration.",{"_2856":2015,"_25053":1967,"_17489":46993,"_5":17384,"_23720":46869,"_2383":46994},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_2856":2016,"_25053":1967,"_17489":46996,"_5":17384,"_23720":46869,"_2383":46997},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_2856":2017,"_25053":1967,"_17489":46999,"_5":17384,"_23720":46873,"_2383":47000},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_2856":2018,"_25053":1967,"_17489":47002,"_5":17384,"_23720":46877,"_2383":47003},[],"RFC 5280: X.509 and CRL profile.",{"_2856":2019,"_25053":1967,"_17489":47005,"_5":17384,"_23720":46877,"_2383":47006},[],"OpenSSL: openssl-crl.",{"_2856":2020,"_25053":1967,"_17489":47008,"_5":17384,"_23720":46877,"_2383":47009},[],"OpenSSL: openssl-verify.",{"_2856":2021,"_25053":1967,"_17489":47011,"_5":17384,"_23720":46877,"_2383":47012},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_2856":2022,"_25053":1967,"_17489":47014,"_5":17384,"_23720":46877,"_2383":47015},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2856":2023,"_25053":2023,"_5":12268,"_2383":47017,"_25368":47018,"_17489":47019,"_23720":2023},"Keys and cryptographic engines",[40693,42037,45715,45716],[],{"_2856":2024,"_25053":2023,"_17489":47021,"_5":17384,"_23720":2023,"_2383":47022},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_2856":2025,"_25053":2023,"_5":25365,"_17489":47024,"_23720":47025,"_2383":47026},[],"/docs/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_2856":2026,"_25053":2023,"_5":25365,"_17489":47028,"_23720":47029,"_2383":47030},[],"/docs/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_2856":2027,"_25053":2023,"_5":25365,"_17489":47032,"_23720":47033,"_2383":47034},[],"/docs/platform/pki/key-management#file-system","File System",{"_2856":2028,"_25053":2023,"_5":25365,"_17489":47036,"_23720":47037,"_2383":47038},[],"/docs/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_2856":2029,"_25053":2023,"_5":25365,"_17489":47040,"_23720":47041,"_2383":47042},[],"/docs/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_2856":2030,"_25053":2023,"_5":25365,"_17489":47044,"_23720":47045,"_2383":47046},[],"/docs/platform/pki/key-management#aws-kms","AWS KMS",{"_2856":2031,"_25053":2023,"_5":25365,"_17489":47048,"_23720":47049,"_2383":47050},[],"/docs/platform/pki/key-management#pkcs11","PKCS#11",{"_2856":2032,"_25053":2023,"_5":25365,"_17489":47052,"_23720":47053,"_2383":47054},[],"/docs/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_2856":2033,"_25053":2023,"_5":25365,"_17489":47056,"_23720":47057,"_2383":47058},[],"/docs/platform/pki/key-management#key-inventory","Key inventory",{"_2856":2034,"_25053":2023,"_5":25365,"_17489":47060,"_23720":47061,"_2383":47062},[],"/docs/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_2856":2035,"_25053":2023,"_5":25365,"_17489":47064,"_23720":47065,"_2383":47066},[],"/docs/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_2856":2036,"_25053":2023,"_5":25365,"_17489":47068,"_23720":47069,"_2383":47070},[],"/docs/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_2856":2037,"_25053":2023,"_5":25365,"_17489":47072,"_23720":47073,"_2383":47074},[],"/docs/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_2856":2038,"_25053":2023,"_5":25365,"_17489":47076,"_23720":47077,"_2383":47078},[],"/docs/platform/pki/key-management#view-details","View details",{"_2856":2039,"_25053":2023,"_5":25365,"_17489":47080,"_23720":47081,"_2383":47082},[],"/docs/platform/pki/key-management#sign-and-verify","Sign and verify",{"_2856":2040,"_25053":2023,"_5":25365,"_17489":47084,"_23720":47085,"_2383":47086},[],"/docs/platform/pki/key-management#sign","Sign",{"_2856":2041,"_25053":2023,"_5":25365,"_17489":47088,"_23720":47089,"_2383":47090},[],"/docs/platform/pki/key-management#verify","Verify",{"_2856":2042,"_25053":2023,"_5":25365,"_17489":47092,"_23720":47093,"_2383":47094},[],"/docs/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_2856":2043,"_25053":2023,"_5":25365,"_17489":47096,"_23720":47097,"_2383":47098},[],"/docs/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_2856":2044,"_25053":2023,"_5":25365,"_17489":47100,"_23720":47101,"_2383":47102},[],"/docs/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_2856":2045,"_25053":2023,"_17489":47104,"_5":17384,"_23720":2023,"_2383":47105},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_2856":2046,"_25053":2023,"_17489":47107,"_5":17384,"_23720":2023,"_2383":47108},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_2856":2047,"_25053":2023,"_17489":47110,"_5":17384,"_23720":47025,"_2383":47111},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_2856":2048,"_25053":2023,"_17489":47113,"_5":17384,"_23720":47025,"_2383":47114},[],"In practice, it lets you:",{"_2856":2049,"_25053":2023,"_17489":47116,"_5":17384,"_23720":47025,"_2383":47117},[],"Generate new key pairs from Lamassu IoT.",{"_2856":2050,"_25053":2023,"_17489":47119,"_5":17384,"_23720":47025,"_2383":47120},[],"Import keys created externally.",{"_2856":2051,"_25053":2023,"_17489":47122,"_5":17384,"_23720":47025,"_2383":47123},[],"Delegate custody and cryptographic operations to external engines.",{"_2856":2052,"_25053":2023,"_17489":47125,"_5":17384,"_23720":47025,"_2383":47126},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_2856":2053,"_25053":2023,"_17489":47128,"_5":17384,"_23720":47029,"_2383":47129},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_2856":2054,"_25053":2023,"_17489":47131,"_5":17384,"_23720":47029,"_2383":47132},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_2856":2055,"_25053":2023,"_17489":47134,"_5":17384,"_23720":47029,"_2383":47135},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_2856":2056,"_25053":2023,"_17489":47137,"_5":17384,"_23720":47033,"_2383":47138},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_2856":2057,"_25053":2023,"_17489":47140,"_5":17384,"_23720":47037,"_2383":47141},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_2856":2058,"_25053":2023,"_17489":47143,"_5":17384,"_23720":47041,"_2383":47144},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_2856":2059,"_25053":2023,"_17489":47146,"_5":17384,"_23720":47045,"_2383":47147},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_2856":2060,"_25053":2023,"_17489":47149,"_5":17384,"_23720":47049,"_2383":47150},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_2856":2061,"_25053":2023,"_17489":47152,"_5":17384,"_23720":47053,"_2383":47153},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_2856":2062,"_25053":2023,"_17489":47155,"_5":17384,"_23720":47053,"_2383":47156},[],"Lamassu shows the enabled engines in the console.",{"_2856":2063,"_25053":2023,"_17489":47158,"_5":17384,"_23720":47053,"_2383":47159},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_2856":2064,"_25053":2023,"_17489":47161,"_5":17384,"_23720":47053,"_2383":47162},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_2856":2065,"_25053":2023,"_17489":47164,"_5":17384,"_23720":47057,"_2383":47165},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_2856":2066,"_25053":2023,"_17489":47167,"_5":17384,"_23720":47057,"_2383":47168},[],"The table includes the following fields:",{"_2856":2067,"_25053":2023,"_17489":47170,"_5":17384,"_23720":47057,"_2383":47171},[],"**Name**: descriptive name of the key.",{"_2856":2068,"_25053":2023,"_17489":47173,"_5":17384,"_23720":47057,"_2383":47174},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_2856":2069,"_25053":2023,"_17489":47176,"_5":17384,"_23720":47057,"_2383":47177},[],"**Strength**: visual indicator of cryptographic strength.",{"_2856":2070,"_25053":2023,"_17489":47179,"_5":17384,"_23720":47057,"_2383":47180},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_2856":2071,"_25053":2023,"_17489":47182,"_5":17384,"_23720":47057,"_2383":47183},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_2856":2072,"_25053":2023,"_17489":47185,"_5":17384,"_23720":47057,"_2383":47186},[],"**Aliases**: alternative names associated with the key.",{"_2856":2073,"_25053":2023,"_17489":47188,"_5":17384,"_23720":47057,"_2383":47189},[],"**Tags**: labels for classification and search.",{"_2856":2074,"_25053":2023,"_17489":47191,"_5":17384,"_23720":47057,"_2383":47192},[],"**Related Entities**: certificates or other entities linked to that key.",{"_2856":2075,"_25053":2023,"_17489":47194,"_5":17384,"_23720":47057,"_2383":47195},[],"From this view you also reach the most common actions:",{"_2856":2076,"_25053":2023,"_17489":47197,"_5":17384,"_23720":47057,"_2383":47198},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_2856":2077,"_25053":2023,"_17489":47200,"_5":17384,"_23720":47057,"_2383":47201},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_2856":2078,"_25053":2023,"_17489":47203,"_5":17384,"_23720":47057,"_2383":47204},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_2856":2079,"_25053":2023,"_17489":47206,"_5":17384,"_23720":47057,"_2383":47207},[],"**Delete Key** to remove the key from the system.",{"_2856":2080,"_25053":2023,"_17489":47209,"_5":17384,"_23720":47061,"_2383":47210},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_2856":2081,"_25053":2023,"_17489":47212,"_5":17384,"_23720":47065,"_2383":47213},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_2856":2082,"_25053":2023,"_17489":47215,"_5":17384,"_23720":47065,"_2383":47216},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_2856":2083,"_25053":2023,"_17489":47218,"_5":17384,"_23720":47065,"_2383":47219},[],"**Key Name**: unique and descriptive name.",{"_2856":2084,"_25053":2023,"_17489":47221,"_5":17384,"_23720":47065,"_2383":47222},[],"**Crypto Engine**: engine that will keep the key.",{"_2856":2085,"_25053":2023,"_17489":47224,"_5":17384,"_23720":47065,"_2383":47225},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_2856":2086,"_25053":2023,"_17489":47227,"_5":17384,"_23720":47065,"_2383":47228},[],"**Tags**: metadata to classify the key.",{"_2856":2087,"_25053":2023,"_17489":47230,"_5":17384,"_23720":47065,"_2383":47231},[],"**Metadata**: additional information for advanced uses.",{"_2856":2088,"_25053":2023,"_17489":47233,"_5":17384,"_23720":47069,"_2383":47234},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_2856":2089,"_25053":2023,"_17489":47236,"_5":17384,"_23720":47069,"_2383":47237},[],"When you have an exportable private key and the destination engine supports import.",{"_2856":2090,"_25053":2023,"_17489":47239,"_5":17384,"_23720":47069,"_2383":47240},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_2856":2091,"_25053":2023,"_17489":47242,"_5":17384,"_23720":47069,"_2383":47243},[],"When Lamassu must operate with a root of trust created by a third party.",{"_2856":2092,"_25053":2023,"_17489":47245,"_5":17384,"_23720":47069,"_2383":47246},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_2856":2093,"_25053":2023,"_17489":47248,"_5":17384,"_23720":47069,"_2383":47249},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_2856":2094,"_25053":2023,"_17489":47251,"_5":17384,"_23720":47069,"_2383":47252},[],"**Crypto Engine**: engine that will keep the imported key.",{"_2856":2095,"_25053":2023,"_17489":47254,"_5":17384,"_23720":47069,"_2383":47255},[],"**Tags**: labels for organization and search.",{"_2856":2096,"_25053":2023,"_17489":47257,"_5":17384,"_23720":47069,"_2383":47258},[],"**Metadata**: additional optional information.",{"_2856":2097,"_25053":2023,"_17489":47260,"_5":17384,"_23720":47069,"_2383":47261},[],"**Private Key (PEM)**: private key in PEM format.",{"_2856":2098,"_25053":2023,"_17489":47263,"_5":17384,"_23720":47069,"_2383":47264},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_2856":2099,"_25053":2023,"_17489":47266,"_5":17384,"_23720":47073,"_2383":47267},[],"Each registered key has a detail view and several operational actions.",{"_2856":2100,"_25053":2023,"_17489":47269,"_5":17384,"_23720":47077,"_2383":47270},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_2856":2101,"_25053":2023,"_17489":47272,"_5":17384,"_23720":47077,"_2383":47273},[],"The **Overview** tab shows, among others, these fields:",{"_2856":2102,"_25053":2023,"_17489":47275,"_5":17384,"_23720":47077,"_2383":47276},[],"**Key Name**: descriptive name.",{"_2856":2103,"_25053":2023,"_17489":47278,"_5":17384,"_23720":47077,"_2383":47279},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_2856":2104,"_25053":2023,"_17489":47281,"_5":17384,"_23720":47077,"_2383":47282},[],"**Tags**: associated labels.",{"_2856":2105,"_25053":2023,"_17489":47284,"_5":17384,"_23720":47077,"_2383":47285},[],"**Aliases**: alternative names.",{"_2856":2106,"_25053":2023,"_17489":47287,"_5":17384,"_23720":47077,"_2383":47288},[],"**Crypto Engine**: engine where the key resides.",{"_2856":2107,"_25053":2023,"_17489":47290,"_5":17384,"_23720":47077,"_2383":47291},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_2856":2108,"_25053":2023,"_17489":47293,"_5":17384,"_23720":47077,"_2383":47294},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_2856":2109,"_25053":2023,"_17489":47296,"_5":17384,"_23720":47077,"_2383":47297},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_2856":2110,"_25053":2023,"_17489":47299,"_5":17384,"_23720":47081,"_2383":47300},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_2856":2111,"_25053":2023,"_17489":47302,"_5":17384,"_23720":47081,"_2383":47303},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_2856":2112,"_25053":2023,"_17489":47305,"_5":17384,"_23720":47081,"_2383":47306},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_2856":2113,"_25053":2023,"_17489":47308,"_5":17384,"_23720":47085,"_2383":47309},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_2856":2114,"_25053":2023,"_17489":47311,"_5":17384,"_23720":47085,"_2383":47312},[],"Main fields:",{"_2856":2115,"_25053":2023,"_17489":47314,"_5":17384,"_23720":47085,"_2383":47315},[],"**Algorithm**: signing algorithm available for the key type.",{"_2856":2116,"_25053":2023,"_17489":47317,"_5":17384,"_23720":47085,"_2383":47318},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_2856":2117,"_25053":2023,"_17489":47320,"_5":17384,"_23720":47085,"_2383":47321},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_2856":2118,"_25053":2023,"_17489":47323,"_5":17384,"_23720":47085,"_2383":47324},[],"**Message**: content to sign.",{"_2856":2119,"_25053":2023,"_17489":47326,"_5":17384,"_23720":47085,"_2383":47327},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_2856":2120,"_25053":2023,"_17489":47329,"_5":17384,"_23720":47089,"_2383":47330},[],"This tab checks whether a signature corresponds to the associated public key.",{"_2856":2121,"_25053":2023,"_17489":47332,"_5":17384,"_23720":47089,"_2383":47312},[],{"_2856":2122,"_25053":2023,"_17489":47334,"_5":17384,"_23720":47089,"_2383":47335},[],"**Algorithm**: must match the algorithm used for the signature.",{"_2856":2123,"_25053":2023,"_17489":47337,"_5":17384,"_23720":47089,"_2383":47338},[],"**Message Type**: `Raw` or `Digest`.",{"_2856":2124,"_25053":2023,"_17489":47340,"_5":17384,"_23720":47089,"_2383":47341},[],"**Payload Encoding**: encoding of the message.",{"_2856":2125,"_25053":2023,"_17489":47343,"_5":17384,"_23720":47089,"_2383":47344},[],"**Message**: original message or hash.",{"_2856":2126,"_25053":2023,"_17489":47346,"_5":17384,"_23720":47089,"_2383":47347},[],"**Signature**: signature to check.",{"_2856":2127,"_25053":2023,"_17489":47349,"_5":17384,"_23720":47089,"_2383":47350},[],"**Result**: indicator of the validation result.",{"_2856":2128,"_25053":2023,"_17489":47352,"_5":17384,"_23720":47093,"_2383":47353},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_2856":2129,"_25053":2023,"_17489":47355,"_5":17384,"_23720":47093,"_2383":47356},[],"This flow is useful for:",{"_2856":2130,"_25053":2023,"_17489":47358,"_5":17384,"_23720":47093,"_2383":47359},[],"Requesting certificates from an external CA.",{"_2856":2131,"_25053":2023,"_17489":47361,"_5":17384,"_23720":47093,"_2383":47362},[],"Renewing an identity while keeping the same key.",{"_2856":2132,"_25053":2023,"_17489":47364,"_5":17384,"_23720":47093,"_2383":47365},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_2856":2133,"_25053":2023,"_17489":47367,"_5":17384,"_23720":47093,"_2383":47368},[],"**Common Name (CN)**: main name of the identity.",{"_2856":2134,"_25053":2023,"_17489":47370,"_5":17384,"_23720":47093,"_2383":47371},[],"**Organization (O)**: organization or company.",{"_2856":2135,"_25053":2023,"_17489":47373,"_5":17384,"_23720":47093,"_2383":47374},[],"**Organizational Unit (OU)**: department or unit.",{"_2856":2136,"_25053":2023,"_17489":47376,"_5":17384,"_23720":47093,"_2383":47377},[],"**Country (C)**: two-letter country code.",{"_2856":2137,"_25053":2023,"_17489":47379,"_5":17384,"_23720":47093,"_2383":47380},[],"**State / Province (ST)**: state or province.",{"_2856":2138,"_25053":2023,"_17489":47382,"_5":17384,"_23720":47093,"_2383":47383},[],"**Locality (L)**: city or locality.",{"_2856":2139,"_25053":2023,"_17489":47385,"_5":17384,"_23720":47093,"_2383":47386},[],"**Email Address**: contact email.",{"_2856":2140,"_25053":2023,"_17489":47388,"_5":17384,"_23720":47093,"_2383":47389},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_2856":2141,"_25053":2023,"_17489":47391,"_5":17384,"_23720":47093,"_2383":47392},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_2856":2142,"_25053":2023,"_17489":47394,"_5":17384,"_23720":47097,"_2383":47395},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_2856":2143,"_25053":2023,"_17489":47397,"_5":17384,"_23720":47097,"_2383":47398},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_2856":2144,"_25053":2023,"_17489":47400,"_5":17384,"_23720":47101,"_2383":47401},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_2856":2145,"_25053":2145,"_5":12268,"_2383":47403,"_25368":47404,"_17489":47405,"_23720":2145},"Online validation with OCSP",[40693,42037,45715,46332],[],{"_2856":2146,"_25053":2145,"_17489":47407,"_5":17384,"_23720":2145,"_2383":47408},[],"Query signed status and verify the responder’s response.",{"_2856":2147,"_25053":2145,"_5":25365,"_17489":47410,"_23720":47411,"_2383":47412},[],"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_2856":2148,"_25053":2145,"_5":25365,"_17489":47414,"_23720":47415,"_2383":47416},[],"/docs/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_2856":2149,"_25053":2145,"_5":25365,"_17489":47418,"_23720":47419,"_2383":47420},[],"/docs/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_2856":2150,"_25053":2145,"_5":25365,"_17489":47422,"_23720":47423,"_2383":47424},[],"/docs/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_2856":2151,"_25053":2145,"_5":25365,"_17489":47426,"_23720":47427,"_2383":47428},[],"/docs/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_2856":2152,"_25053":2145,"_5":25365,"_17489":47430,"_23720":47431,"_2383":46878},[],"/docs/platform/pki/ocsp#references",{"_2856":2153,"_25053":2145,"_17489":47433,"_5":17384,"_23720":2145,"_2383":47434},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_2856":2154,"_25053":2145,"_17489":47436,"_5":17384,"_23720":47411,"_2383":47437},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_2856":2155,"_25053":2145,"_17489":47439,"_5":17384,"_23720":47411,"_2383":47440},[],"Record status",{"_2856":2156,"_25053":2145,"_17489":47442,"_5":17384,"_23720":47411,"_2383":47443},[],"Signed response",{"_2856":2157,"_25053":2145,"_17489":47445,"_5":17384,"_23720":47411,"_2383":44893},[],{"_2856":2158,"_25053":2145,"_17489":47447,"_5":17384,"_23720":47411,"_2383":47448},[],"`Good`.",{"_2856":2159,"_25053":2145,"_17489":47450,"_5":17384,"_23720":47411,"_2383":44910},[],{"_2856":2160,"_25053":2145,"_17489":47452,"_5":17384,"_23720":47411,"_2383":47453},[],"`Revoked`, with revocation reason and timestamp.",{"_2856":2161,"_25053":2145,"_17489":47455,"_5":17384,"_23720":47411,"_2383":47456},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_2856":2162,"_25053":2145,"_17489":47458,"_5":17384,"_23720":47411,"_2383":47459},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_2856":2163,"_25053":2145,"_17489":47461,"_5":17384,"_23720":47411,"_2383":47462},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_2856":2164,"_25053":2145,"_17489":47464,"_5":17384,"_23720":47411,"_2383":47465},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_2856":2165,"_25053":2145,"_17489":47467,"_5":17384,"_23720":47411,"_2383":47468},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_2856":2166,"_25053":2145,"_17489":47470,"_5":17384,"_23720":47415,"_2383":47471},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_2856":2167,"_25053":2145,"_17489":47473,"_5":17384,"_23720":47415,"_2383":47474},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_2856":2168,"_25053":2145,"_17489":47476,"_5":17384,"_23720":47419,"_2383":47477},[],"The service accepts:",{"_2856":2169,"_25053":2145,"_17489":47479,"_5":17384,"_23720":47419,"_2383":43758},[],{"_2856":2170,"_25053":2145,"_17489":47481,"_5":17384,"_23720":47419,"_2383":47482},[],"VA service path",{"_2856":2171,"_25053":2145,"_17489":47484,"_5":17384,"_23720":47419,"_2383":47485},[],"Format",{"_2856":2172,"_25053":2145,"_17489":47487,"_5":17384,"_23720":47419,"_2383":47488},[],"`POST`",{"_2856":2173,"_25053":2145,"_17489":47490,"_5":17384,"_23720":47419,"_2383":47491},[],"`/ocsp`",{"_2856":2174,"_25053":2145,"_17489":47493,"_5":17384,"_23720":47419,"_2383":47494},[],"DER request, `Content-Type: application/ocsp-request`.",{"_2856":2175,"_25053":2145,"_17489":47496,"_5":17384,"_23720":47419,"_2383":46977},[],{"_2856":2176,"_25053":2145,"_17489":47498,"_5":17384,"_23720":47419,"_2383":47499},[],"`/ocsp/{ocsp_request}`",{"_2856":2177,"_25053":2145,"_17489":47501,"_5":17384,"_23720":47419,"_2383":47502},[],"DER request encoded using padded URL Base64.",{"_2856":2178,"_25053":2145,"_17489":47504,"_5":17384,"_23720":47419,"_2383":47505},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_2856":2179,"_25053":2145,"_17489":47507,"_5":17384,"_23720":47423,"_2383":47508},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_2856":2180,"_25053":2145,"_17489":47510,"_5":17384,"_23720":47423,"_2383":47511},[],"Generate the request:",{"_2856":2181,"_25053":2145,"_17489":47513,"_5":17384,"_23720":47423,"_2383":47514},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_2856":2182,"_25053":2145,"_17489":47516,"_5":17384,"_23720":47423,"_2383":47517},[],"Replace the example URL with the inspected endpoint:",{"_2856":2183,"_25053":2145,"_17489":47519,"_5":17384,"_23720":47423,"_2383":47520},[],"Verify the returned DER:",{"_2856":2184,"_25053":2145,"_17489":47522,"_5":17384,"_23720":47423,"_2383":47523},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_2856":2185,"_25053":2145,"_17489":47525,"_5":17384,"_23720":47427,"_2383":47526},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_2856":2186,"_25053":2145,"_17489":47528,"_5":17384,"_23720":47427,"_2383":47529},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_2856":2187,"_25053":2145,"_17489":47531,"_5":17384,"_23720":47431,"_2383":47532},[],"RFC 6960: OCSP.",{"_2856":2188,"_25053":2145,"_17489":47534,"_5":17384,"_23720":47431,"_2383":47535},[],"OpenSSL: openssl-ocsp.",{"_2856":2189,"_25053":2145,"_17489":47537,"_5":17384,"_23720":47431,"_2383":47538},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_2856":2190,"_25053":2145,"_17489":47540,"_5":17384,"_23720":47431,"_2383":47015},[],{"_2856":2191,"_25053":2191,"_5":12268,"_2383":45715,"_25368":47542,"_17489":47543,"_23720":2191},[40693,42037,45715],[],{"_2856":2192,"_25053":2191,"_17489":47545,"_5":17384,"_23720":2191,"_2383":47546},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_2856":2193,"_25053":2191,"_5":25365,"_17489":47548,"_23720":47549,"_2383":45025},[],"/docs/platform/pki/overview#start-here",{"_2856":2194,"_25053":2191,"_5":25365,"_17489":47551,"_23720":47552,"_2383":47553},[],"/docs/platform/pki/overview#what-you-need","What you need",{"_2856":2195,"_25053":2191,"_5":25365,"_17489":47555,"_23720":47556,"_2383":45559},[],"/docs/platform/pki/overview#core-capabilities",{"_2856":2196,"_25053":2191,"_5":25365,"_17489":47558,"_23720":47559,"_2383":45563},[],"/docs/platform/pki/overview#build-your-trust-hierarchy",{"_2856":2197,"_25053":2191,"_5":25365,"_17489":47561,"_23720":47562,"_2383":45567},[],"/docs/platform/pki/overview#protect-cryptographic-keys",{"_2856":2198,"_25053":2191,"_5":25365,"_17489":47564,"_23720":47565,"_2383":45571},[],"/docs/platform/pki/overview#issue-and-control-certificates",{"_2856":2199,"_25053":2191,"_5":25365,"_17489":47567,"_23720":47568,"_2383":45579},[],"/docs/platform/pki/overview#publish-validation-status",{"_2856":2200,"_25053":2191,"_5":25365,"_17489":47570,"_23720":47571,"_2383":47572},[],"/docs/platform/pki/overview#how-to-check-the-result","How to check the result",{"_2856":2201,"_25053":2191,"_5":25365,"_17489":47574,"_23720":47575,"_2383":46499},[],"/docs/platform/pki/overview#continue",{"_2856":2202,"_25053":2191,"_17489":47577,"_5":17384,"_23720":2191,"_2383":47578},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_2856":2203,"_25053":2191,"_17489":47580,"_5":17384,"_23720":47549,"_2383":47581},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_2856":2204,"_25053":2191,"_17489":47583,"_5":17384,"_23720":47549,"_2383":47584},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_2856":2205,"_25053":2191,"_17489":47586,"_5":17384,"_23720":47552,"_2383":47587},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_2856":2206,"_25053":2191,"_17489":47589,"_5":17384,"_23720":47552,"_2383":47590},[],"An available cryptographic engine to keep the authority's key.",{"_2856":2207,"_25053":2191,"_17489":47592,"_5":17384,"_23720":47552,"_2383":47593},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_2856":2208,"_25053":2191,"_17489":47595,"_5":17384,"_23720":47552,"_2383":47596},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_2856":2209,"_25053":2191,"_17489":47598,"_5":17384,"_23720":47552,"_2383":47599},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_2856":2210,"_25053":2191,"_17489":47601,"_5":17384,"_23720":47559,"_2383":47602},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_2856":2211,"_25053":2191,"_17489":47604,"_5":17384,"_23720":47562,"_2383":47605},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_2856":2212,"_25053":2191,"_17489":47607,"_5":17384,"_23720":47565,"_2383":47608},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_2856":2213,"_25053":2191,"_17489":47610,"_5":17384,"_23720":47568,"_2383":47611},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_2856":2214,"_25053":2191,"_17489":47613,"_5":17384,"_23720":47571,"_2383":47614},[],"An active certificate in the console is one part of the check. Also verify that:",{"_2856":2215,"_25053":2191,"_17489":47616,"_5":17384,"_23720":47571,"_2383":47617},[],"its subject and extensions identify the expected client;",{"_2856":2216,"_25053":2191,"_17489":47619,"_5":17384,"_23720":47571,"_2383":47620},[],"its public key matches the client's private key;",{"_2856":2217,"_25053":2191,"_17489":47622,"_5":17384,"_23720":47571,"_2383":47623},[],"its chain reaches a root trusted by the consumer;",{"_2856":2218,"_25053":2191,"_17489":47625,"_5":17384,"_23720":47571,"_2383":47626},[],"its dates and usages allow the operation;",{"_2856":2219,"_25053":2191,"_17489":47628,"_5":17384,"_23720":47571,"_2383":47629},[],"the consumer applies revocation checks and authorization.",{"_2856":2220,"_25053":2191,"_17489":47631,"_5":17384,"_23720":47571,"_2383":47632},[],"The issuance path includes the first independent checks.",{"_2856":2221,"_25053":2191,"_17489":47634,"_5":17384,"_23720":47575,"_2383":47635},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2856":2222,"_25053":2191,"_17489":47637,"_5":17384,"_23720":47575,"_2383":47638},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2856":2223,"_25053":2191,"_17489":47640,"_5":17384,"_23720":47575,"_2383":47641},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2856":2224,"_25053":2224,"_5":12268,"_2383":47643,"_25368":47644,"_17489":47645,"_23720":2224},"Create your first CA",[40693,42037,45715,45150],[],{"_2856":2225,"_25053":2224,"_17489":47647,"_5":17384,"_23720":2224,"_2383":47648},[],"Create an evaluation root and check its certificate before issuing.",{"_2856":2226,"_25053":2224,"_5":25365,"_17489":47650,"_23720":47651,"_2383":40703},[],"/docs/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_2856":2227,"_25053":2224,"_5":25365,"_17489":47653,"_23720":47654,"_2383":47655},[],"/docs/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard","Open the creation wizard",{"_2856":2228,"_25053":2224,"_5":25365,"_17489":47657,"_23720":47658,"_2383":47659},[],"/docs/platform/pki/quickstarts/create-certificate-authority#select-the-key","Select the key",{"_2856":2229,"_25053":2224,"_5":25365,"_17489":47661,"_23720":47662,"_2383":47663},[],"/docs/platform/pki/quickstarts/create-certificate-authority#define-the-authority","Define the authority",{"_2856":2230,"_25053":2224,"_5":25365,"_17489":47665,"_23720":47666,"_2383":47667},[],"/docs/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca","Review and create the CA",{"_2856":2231,"_25053":2224,"_5":25365,"_17489":47669,"_23720":47670,"_2383":47671},[],"/docs/platform/pki/quickstarts/create-certificate-authority#verify-the-result","Verify the result",{"_2856":2232,"_25053":2224,"_5":25365,"_17489":47673,"_23720":47674,"_2383":47675},[],"/docs/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_2856":2233,"_25053":2224,"_5":25365,"_17489":47677,"_23720":47678,"_2383":45408},[],"/docs/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_2856":2234,"_25053":2224,"_5":25365,"_17489":47680,"_23720":47681,"_2383":40727},[],"/docs/platform/pki/quickstarts/create-certificate-authority#next-step",{"_2856":2235,"_25053":2224,"_17489":47683,"_5":17384,"_23720":2224,"_2383":47684},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_2856":2236,"_25053":2224,"_17489":47686,"_5":17384,"_23720":47651,"_2383":47687},[],"Console access and permission to create keys and authorities.",{"_2856":2237,"_25053":2224,"_17489":47689,"_5":17384,"_23720":47651,"_2383":47690},[],"An available cryptographic engine that supports the chosen algorithm.",{"_2856":2238,"_25053":2224,"_17489":47692,"_5":17384,"_23720":47651,"_2383":47693},[],"OpenSSL 3.x to check the downloaded certificate.",{"_2856":2239,"_25053":2224,"_17489":47695,"_5":17384,"_23720":47651,"_2383":47696},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_2856":2240,"_25053":2224,"_17489":47698,"_5":17384,"_23720":47654,"_2383":47699},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_2856":2241,"_25053":2224,"_17489":47701,"_5":17384,"_23720":47654,"_2383":47702},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_2856":2242,"_25053":2224,"_17489":47704,"_5":17384,"_23720":47658,"_2383":47705},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_2856":2243,"_25053":2224,"_17489":47707,"_5":17384,"_23720":47658,"_2383":47708},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_2856":2244,"_25053":2224,"_17489":47710,"_5":17384,"_23720":47662,"_2383":47711},[],"Select **Root CA** and complete:",{"_2856":2245,"_25053":2224,"_17489":47713,"_5":17384,"_23720":47662,"_2383":47714},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_2856":2246,"_25053":2224,"_17489":47716,"_5":17384,"_23720":47662,"_2383":47717},[],"**Subject**: organization and country details for your evaluation.",{"_2856":2247,"_25053":2224,"_17489":47719,"_5":17384,"_23720":47662,"_2383":47720},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_2856":2248,"_25053":2224,"_17489":47722,"_5":17384,"_23720":47662,"_2383":47723},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_2856":2249,"_25053":2224,"_17489":47725,"_5":17384,"_23720":47662,"_2383":47726},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_2856":2250,"_25053":2224,"_17489":47728,"_5":17384,"_23720":47666,"_2383":47729},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_2856":2251,"_25053":2224,"_17489":47731,"_5":17384,"_23720":47670,"_2383":47732},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_2856":2252,"_25053":2224,"_17489":47734,"_5":17384,"_23720":47670,"_2383":47735},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_2856":2253,"_25053":2224,"_17489":47737,"_5":17384,"_23720":47674,"_2383":47738},[],"Run from the directory where you saved `ca.pem`:",{"_2856":2254,"_25053":2224,"_17489":47740,"_5":17384,"_23720":47674,"_2383":47741},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_2856":2255,"_25053":2224,"_17489":47743,"_5":17384,"_23720":47674,"_2383":47744},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_2856":2256,"_25053":2224,"_17489":47746,"_5":17384,"_23720":47678,"_2383":47747},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_2856":2257,"_25053":2224,"_17489":47749,"_5":17384,"_23720":47678,"_2383":47750},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_2856":2258,"_25053":2224,"_17489":47752,"_5":17384,"_23720":47678,"_2383":47753},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_2856":2259,"_25053":2224,"_17489":47755,"_5":17384,"_23720":47678,"_2383":47756},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_2856":2260,"_25053":2224,"_17489":47758,"_5":17384,"_23720":47681,"_2383":47759},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_2856":2261,"_25053":2261,"_5":12268,"_2383":47761,"_25368":47762,"_17489":47763,"_23720":2261},"Issue and verify a certificate",[40693,42037,45715,45150],[],{"_2856":2262,"_25053":2261,"_17489":47765,"_5":17384,"_23720":2261,"_2383":47766},[],"Issue a client certificate and check content, chain and key correspondence.",{"_2856":2263,"_25053":2261,"_5":25365,"_17489":47768,"_23720":47769,"_2383":40703},[],"/docs/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_2856":2264,"_25053":2261,"_5":25365,"_17489":47771,"_23720":47772,"_2383":47773},[],"/docs/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_2856":2265,"_25053":2261,"_5":25365,"_17489":47775,"_23720":47776,"_2383":47777},[],"/docs/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_2856":2266,"_25053":2261,"_5":25365,"_17489":47779,"_23720":47780,"_2383":47781},[],"/docs/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_2856":2267,"_25053":2261,"_5":25365,"_17489":47783,"_23720":47784,"_2383":47785},[],"/docs/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_2856":2268,"_25053":2261,"_5":25365,"_17489":47787,"_23720":47788,"_2383":47789},[],"/docs/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_2856":2269,"_25053":2261,"_5":25365,"_17489":47791,"_23720":47792,"_2383":47671},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-result",{"_2856":2270,"_25053":2261,"_5":25365,"_17489":47794,"_23720":47795,"_2383":47796},[],"/docs/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_2856":2271,"_25053":2261,"_5":25365,"_17489":47798,"_23720":47799,"_2383":47800},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_2856":2272,"_25053":2261,"_5":25365,"_17489":47802,"_23720":47803,"_2383":47804},[],"/docs/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_2856":2273,"_25053":2261,"_5":25365,"_17489":47806,"_23720":47807,"_2383":45408},[],"/docs/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_2856":2274,"_25053":2261,"_5":25365,"_17489":47809,"_23720":47810,"_2383":40727},[],"/docs/platform/pki/quickstarts/issue-certificate#next-step",{"_2856":2275,"_25053":2261,"_17489":47812,"_5":17384,"_23720":2261,"_2383":47813},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_2856":2276,"_25053":2261,"_17489":47815,"_5":17384,"_23720":47769,"_2383":47816},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_2856":2277,"_25053":2261,"_17489":47818,"_5":17384,"_23720":47769,"_2383":47819},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_2856":2278,"_25053":2261,"_17489":47821,"_5":17384,"_23720":47769,"_2383":47822},[],"OpenSSL 3.x and a working directory with restricted access.",{"_2856":2279,"_25053":2261,"_17489":47824,"_5":17384,"_23720":47769,"_2383":47825},[],"A client identifier: here we use `device-001`.",{"_2856":2280,"_25053":2261,"_17489":47827,"_5":17384,"_23720":47769,"_2383":47828},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_2856":2281,"_25053":2261,"_17489":47830,"_5":17384,"_23720":47772,"_2383":47831},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_2856":2282,"_25053":2261,"_17489":47833,"_5":17384,"_23720":47776,"_2383":47834},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_2856":2283,"_25053":2261,"_17489":47836,"_5":17384,"_23720":47776,"_2383":47837},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_2856":2284,"_25053":2261,"_17489":47839,"_5":17384,"_23720":47780,"_2383":47840},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_2856":2285,"_25053":2261,"_17489":47842,"_5":17384,"_23720":47780,"_2383":47843},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_2856":2286,"_25053":2261,"_17489":47845,"_5":17384,"_23720":47784,"_2383":47846},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_2856":2287,"_25053":2261,"_17489":47848,"_5":17384,"_23720":47784,"_2383":47849},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_2856":2288,"_25053":2261,"_17489":47851,"_5":17384,"_23720":47788,"_2383":47852},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_2856":2289,"_25053":2261,"_17489":47854,"_5":17384,"_23720":47792,"_2383":47855},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_2856":2290,"_25053":2261,"_17489":47857,"_5":17384,"_23720":47795,"_2383":47858},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_2856":2291,"_25053":2261,"_17489":47860,"_5":17384,"_23720":47799,"_2383":47861},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_2856":2292,"_25053":2261,"_17489":47863,"_5":17384,"_23720":47799,"_2383":47864},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_2856":2293,"_25053":2261,"_17489":47866,"_5":17384,"_23720":47799,"_2383":47867},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_2856":2294,"_25053":2261,"_17489":47869,"_5":17384,"_23720":47803,"_2383":47870},[],"In Bash, compare the two public-key digests:",{"_2856":2295,"_25053":2261,"_17489":47872,"_5":17384,"_23720":47803,"_2383":47873},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_2856":2296,"_25053":2261,"_17489":47875,"_5":17384,"_23720":47803,"_2383":47876},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_2856":2297,"_25053":2261,"_17489":47878,"_5":17384,"_23720":47807,"_2383":45492},[],{"_2856":2298,"_25053":2261,"_17489":47880,"_5":17384,"_23720":47807,"_2383":47881},[],"What to review",{"_2856":2299,"_25053":2261,"_17489":47883,"_5":17384,"_23720":47807,"_2383":47884},[],"The CA rejects issuance",{"_2856":2300,"_25053":2261,"_17489":47886,"_5":17384,"_23720":47807,"_2383":47887},[],"Permissions, CA state and key, algorithm and profile.",{"_2856":2301,"_25053":2261,"_17489":47889,"_5":17384,"_23720":47807,"_2383":47890},[],"Different subject or usages",{"_2856":2302,"_25053":2261,"_17489":47892,"_5":17384,"_23720":47807,"_2383":47893},[],"Applied profile and requested values.",{"_2856":2303,"_25053":2261,"_17489":47895,"_5":17384,"_23720":47807,"_2383":47896},[],"Issuer cannot be found",{"_2856":2304,"_25053":2261,"_17489":47898,"_5":17384,"_23720":47807,"_2383":47899},[],"Downloaded CA and required intermediate chain.",{"_2856":2305,"_25053":2261,"_17489":47901,"_5":17384,"_23720":47807,"_2383":47902},[],"Validity fails",{"_2856":2306,"_25053":2261,"_17489":47904,"_5":17384,"_23720":47807,"_2383":47905},[],"Certificate and CA dates, and the computer's clock.",{"_2856":2307,"_25053":2261,"_17489":47907,"_5":17384,"_23720":47807,"_2383":47908},[],"Public-key digests differ",{"_2856":2308,"_25053":2261,"_17489":47910,"_5":17384,"_23720":47807,"_2383":47911},[],"Certificate and key files from the same issuance.",{"_2856":2309,"_25053":2261,"_17489":47913,"_5":17384,"_23720":47807,"_2383":47914},[],"See PKI diagnostics to narrow an issuance failure.",{"_2856":2310,"_25053":2261,"_17489":47916,"_5":17384,"_23720":47810,"_2383":47917},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_2856":2311,"_25053":2261,"_17489":47919,"_5":17384,"_23720":47810,"_2383":47920},[],"Manage certificates for inspection, status and revocation.",{"_2856":2312,"_25053":2261,"_17489":47922,"_5":17384,"_23720":47810,"_2383":47923},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_2856":2313,"_25053":2261,"_17489":47925,"_5":17384,"_23720":47810,"_2383":47926},[],"Prepare EST for the device to request its next identities.",{"_2856":2314,"_25053":2261,"_17489":47928,"_5":17384,"_23720":47810,"_2383":47929},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_2856":2315,"_25053":2315,"_5":12268,"_2383":47931,"_25368":47932,"_17489":47933,"_23720":2315},"PKI getting started",[40693,42037,45715,45150],[],{"_2856":2316,"_25053":2315,"_17489":47935,"_5":17384,"_23720":2315,"_2383":47936},[],"Create a CA, issue a client certificate and check its chain and key.",{"_2856":2317,"_25053":2315,"_5":25365,"_17489":47938,"_23720":47939,"_2383":40703},[],"/docs/platform/pki/quickstarts/overview#before-you-begin",{"_2856":2318,"_25053":2315,"_5":25365,"_17489":47941,"_23720":47942,"_2383":47943},[],"/docs/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_2856":2319,"_25053":2315,"_5":25365,"_17489":47945,"_23720":47946,"_2383":45342},[],"/docs/platform/pki/quickstarts/overview#expected-result",{"_2856":2320,"_25053":2315,"_5":25365,"_17489":47948,"_23720":47949,"_2383":47950},[],"/docs/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_2856":2321,"_25053":2315,"_17489":47952,"_5":17384,"_23720":2315,"_2383":47953},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_2856":2322,"_25053":2315,"_17489":47955,"_5":17384,"_23720":47939,"_2383":47956},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_2856":2323,"_25053":2315,"_17489":47958,"_5":17384,"_23720":47939,"_2383":47959},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_2856":2324,"_25053":2315,"_17489":47961,"_5":17384,"_23720":47939,"_2383":47962},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_2856":2325,"_25053":2315,"_17489":47964,"_5":17384,"_23720":47939,"_2383":47965},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_2856":2326,"_25053":2315,"_17489":47967,"_5":17384,"_23720":47939,"_2383":47968},[],"A working directory with restricted access for the downloaded key.",{"_2856":2327,"_25053":2315,"_17489":47970,"_5":17384,"_23720":47942,"_2383":47971},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2856":2328,"_25053":2315,"_17489":47973,"_5":17384,"_23720":47942,"_2383":47974},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2856":2329,"_25053":2315,"_17489":47976,"_5":17384,"_23720":47942,"_2383":47977},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_2856":2330,"_25053":2315,"_17489":47979,"_5":17384,"_23720":47942,"_2383":47980},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_2856":2331,"_25053":2315,"_17489":47982,"_5":17384,"_23720":47946,"_2383":47983},[],"File or resource",{"_2856":2332,"_25053":2315,"_17489":47985,"_5":17384,"_23720":47946,"_2383":45339},[],{"_2856":2333,"_25053":2315,"_17489":47987,"_5":17384,"_23720":47946,"_2383":47988},[],"Active root CA and `ca.pem`",{"_2856":2334,"_25053":2315,"_17489":47990,"_5":17384,"_23720":47946,"_2383":47991},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_2856":2335,"_25053":2315,"_17489":47993,"_5":17384,"_23720":47946,"_2383":47994},[],"End-entity certificate and `device.crt`",{"_2856":2336,"_25053":2315,"_17489":47996,"_5":17384,"_23720":47946,"_2383":47997},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_2856":2337,"_25053":2315,"_17489":47999,"_5":17384,"_23720":47946,"_2383":48000},[],"Private key `device.key`",{"_2856":2338,"_25053":2315,"_17489":48002,"_5":17384,"_23720":47946,"_2383":48003},[],"Its public key matches the one included in `device.crt`.",{"_2856":2339,"_25053":2315,"_17489":48005,"_5":17384,"_23720":47946,"_2383":48006},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_2856":2340,"_25053":2315,"_17489":48008,"_5":17384,"_23720":47949,"_2383":48009},[],"To operate certificates, continue with Certificates and Validation.",{"_2856":2341,"_25053":2315,"_17489":48011,"_5":17384,"_23720":47949,"_2383":48012},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_2856":2342,"_25053":2315,"_17489":48014,"_5":17384,"_23720":47949,"_2383":48015},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_2856":2343,"_25053":2343,"_5":12268,"_2383":48017,"_25368":48018,"_17489":48019,"_23720":2343},"PKI troubleshooting",[40693,42037,45715,44536],[],{"_2856":2344,"_25053":2343,"_17489":48021,"_5":17384,"_23720":2343,"_2383":48022},[],"Diagnose certificate issuance, OCSP and CRL.",{"_2856":2345,"_25053":2343,"_5":25365,"_17489":48024,"_23720":48025,"_2383":48026},[],"/docs/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_2856":2346,"_25053":2343,"_5":25365,"_17489":48028,"_23720":48029,"_2383":48030},[],"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_2856":2347,"_25053":2343,"_5":25365,"_17489":48032,"_23720":48033,"_2383":48034},[],"/docs/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_2856":2348,"_25053":2343,"_17489":48036,"_5":17384,"_23720":2343,"_2383":48037},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_2856":2349,"_25053":2343,"_17489":48039,"_5":17384,"_23720":2343,"_2383":48040},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_2856":2350,"_25053":2343,"_17489":48042,"_5":17384,"_23720":48025,"_2383":45339},[],{"_2856":2351,"_25053":2343,"_17489":48044,"_5":17384,"_23720":48025,"_2383":48045},[],"What to inspect",{"_2856":2352,"_25053":2343,"_17489":48047,"_5":17384,"_23720":48025,"_2383":40727},[],{"_2856":2353,"_25053":2343,"_17489":48049,"_5":17384,"_23720":48025,"_2383":48050},[],"CA",{"_2856":2354,"_25053":2343,"_17489":48052,"_5":17384,"_23720":48025,"_2383":48053},[],"Exists, is active and has usable dates.",{"_2856":2355,"_25053":2343,"_17489":48055,"_5":17384,"_23720":48025,"_2383":48056},[],"Authorities.",{"_2856":2356,"_25053":2343,"_17489":48058,"_5":17384,"_23720":48025,"_2383":48059},[],"Key",{"_2856":2357,"_25053":2343,"_17489":48061,"_5":17384,"_23720":48025,"_2383":48062},[],"The record has a usable private key and the engine can sign.",{"_2856":2358,"_25053":2343,"_17489":48064,"_5":17384,"_23720":48025,"_2383":48065},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_2856":2359,"_25053":2343,"_17489":48067,"_5":17384,"_23720":48025,"_2383":48068},[],"CSR",{"_2856":2360,"_25053":2343,"_17489":48070,"_5":17384,"_23720":48025,"_2383":48071},[],"Correct PEM and verifiable signature.",{"_2856":2361,"_25053":2343,"_17489":48073,"_5":17384,"_23720":48025,"_2383":48074},[],"`openssl req -in request.csr -noout -verify -text`.",{"_2856":2362,"_25053":2343,"_17489":48076,"_5":17384,"_23720":48025,"_2383":48077},[],"Profile",{"_2856":2363,"_25053":2343,"_17489":48079,"_5":17384,"_23720":48025,"_2383":48080},[],"Selected source, existing ID, allowed algorithm and size.",{"_2856":2364,"_25053":2343,"_17489":48082,"_5":17384,"_23720":48025,"_2383":48083},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_2856":2365,"_25053":2343,"_17489":48085,"_5":17384,"_23720":48025,"_2383":45492},[],{"_2856":2366,"_25053":2343,"_17489":48087,"_5":17384,"_23720":48025,"_2383":48088},[],"Appropriate subject, SAN, usages and dates.",{"_2856":2367,"_25053":2343,"_17489":48090,"_5":17384,"_23720":48025,"_2383":48091},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_2856":2368,"_25053":2343,"_17489":48093,"_5":17384,"_23720":48025,"_2383":48094},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_2856":2369,"_25053":2343,"_17489":48096,"_5":17384,"_23720":48025,"_2383":48097},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_2856":2370,"_25053":2343,"_17489":48099,"_5":17384,"_23720":48029,"_2383":48100},[],"Check each boundary independently:",{"_2856":2371,"_25053":2343,"_17489":48102,"_5":17384,"_23720":48029,"_2383":48103},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_2856":2372,"_25053":2343,"_17489":48105,"_5":17384,"_23720":48029,"_2383":48106},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_2856":2373,"_25053":2343,"_17489":48108,"_5":17384,"_23720":48029,"_2383":48109},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_2856":2374,"_25053":2343,"_17489":48111,"_5":17384,"_23720":48029,"_2383":48112},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_2856":2375,"_25053":2343,"_17489":48114,"_5":17384,"_23720":48029,"_2383":48115},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_2856":2376,"_25053":2343,"_17489":48117,"_5":17384,"_23720":48029,"_2383":48118},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_2856":2377,"_25053":2343,"_17489":48120,"_5":17384,"_23720":48033,"_2383":48121},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_2856":2378,"_25053":2343,"_17489":48123,"_5":17384,"_23720":48033,"_2383":48124},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.","count","sorting",{"_48128":48129,"_48130":48131,"_48132":48133,"_48134":48135,"_15199":2405,"_57605":2405},"language","english","sortableProperties",[2383,25053,5,23720],"sortablePropertiesWithTypes",{"_2383":20874,"_25053":20874,"_5":20874,"_23720":20874},"sorts",{"_2383":48136,"_25053":50504,"_5":52871,"_23720":55238},{"_3827":48137,"_48138":48139,"_5":20874},{"_12013":2647,"_12356":4249,"_12363":3332,"_24266":13053,"_23833":2735,"_16602":6136,"_12034":2822,"_12041":2821,"_24228":2824,"_24578":3652,"_24599":2748,"_24241":11346,"_28818":4752,"_24610":12391,"_28823":24758,"_28826":19797,"_28829":4220,"_28832":6280,"_28835":2623,"_24911":6150,"_28840":2632,"_28842":7072,"_24959":2809,"_24901":3891,"_28846":2697,"_24927":3456,"_28850":7159,"_24628":16219,"_24906":4286,"_24977":3116,"_28855":5556,"_28857":3305,"_28859":6266,"_28861":3061,"_28863":2672,"_28865":3699,"_28867":2927,"_28869":4455,"_28871":2830,"_24279":2834,"_28874":4403,"_28876":2706,"_24273":4234,"_28879":2443,"_28881":3986,"_28883":2444,"_28886":16854,"_243