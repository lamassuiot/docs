_3048":119232,"_31263":119233,"_21431":119236,"_28112":72087},"Despliega desde AWS Marketplace",[50505,119234,119235],"Despliegue","Otros modelos",[],{"_3592":72088,"_30925":72087,"_21431":119238,"_5":14725,"_28112":72087,"_3048":119239},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3592":72089,"_30925":72087,"_5":31260,"_21431":119241,"_28112":119242,"_3048":119243},[],"/docs/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3592":72090,"_30925":72087,"_5":31260,"_21431":119245,"_28112":119246,"_3048":119247},[],"/docs/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3592":72091,"_30925":72087,"_5":31260,"_21431":119249,"_28112":119250,"_3048":119251},[],"/docs/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3592":72092,"_30925":72087,"_5":31260,"_21431":119253,"_28112":119254,"_3048":119255},[],"/docs/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3592":72093,"_30925":72087,"_5":31260,"_21431":119257,"_28112":119258,"_3048":119259},[],"/docs/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3592":72094,"_30925":72087,"_5":31260,"_21431":119261,"_28112":119262,"_3048":119263},[],"/docs/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3592":72095,"_30925":72087,"_5":31260,"_21431":119265,"_28112":119266,"_3048":119267},[],"/docs/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3592":72096,"_30925":72087,"_21431":119269,"_5":14725,"_28112":72087,"_3048":119270},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3592":72097,"_30925":72087,"_21431":119272,"_5":14725,"_28112":119242,"_3048":119273},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3592":72098,"_30925":72087,"_21431":119275,"_5":14725,"_28112":119242,"_3048":119276},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3592":72099,"_30925":72087,"_21431":119278,"_5":14725,"_28112":119242,"_3048":119279},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3592":72100,"_30925":72087,"_21431":119281,"_5":14725,"_28112":119246,"_3048":119282},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3592":72101,"_30925":72087,"_21431":119284,"_5":14725,"_28112":119246,"_3048":119285},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3592":72102,"_30925":72087,"_21431":119287,"_5":14725,"_28112":119246,"_3048":119288},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3592":72103,"_30925":72087,"_21431":119290,"_5":14725,"_28112":119250,"_3048":119291},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3592":72104,"_30925":72087,"_21431":119293,"_5":14725,"_28112":119254,"_3048":119294},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3592":72105,"_30925":72087,"_21431":119296,"_5":14725,"_28112":119258,"_3048":119297},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3592":72106,"_30925":72087,"_21431":119299,"_5":14725,"_28112":119262,"_3048":119300},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3592":72107,"_30925":72087,"_21431":119302,"_5":14725,"_28112":119266,"_3048":119303},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3592":72108,"_30925":72108,"_5":15085,"_3048":119305,"_31263":119306,"_21431":119307,"_28112":72108},"Despliega Lamassu",[50505,119234],[],{"_3592":72109,"_30925":72108,"_21431":119309,"_5":14725,"_28112":72108,"_3048":119310},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3592":72110,"_30925":72108,"_5":31260,"_21431":119312,"_28112":119313,"_3048":119314},[],"/docs/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3592":72111,"_30925":72108,"_5":31260,"_21431":119316,"_28112":119317,"_3048":119318},[],"/docs/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3592":72112,"_30925":72108,"_5":31260,"_21431":119320,"_28112":119321,"_3048":119322},[],"/docs/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3592":72113,"_30925":72108,"_21431":119324,"_5":14725,"_28112":72108,"_3048":119325},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3592":72114,"_30925":72108,"_21431":119327,"_5":14725,"_28112":119313,"_3048":119328},[],"Modelo",{"_3592":72115,"_30925":72108,"_21431":119330,"_5":14725,"_28112":119313,"_3048":119331},[],"Recomendado para",{"_3592":72116,"_30925":72108,"_21431":119333,"_5":14725,"_28112":119313,"_3048":119334},[],"Quién opera la infraestructura",{"_3592":72117,"_30925":72108,"_21431":119336,"_5":14725,"_28112":119313,"_3048":119337},[],"Punto de partida",{"_3592":72118,"_30925":72108,"_21431":119339,"_5":14725,"_28112":119313,"_3048":50612},[],{"_3592":72119,"_30925":72108,"_21431":119341,"_5":14725,"_28112":119313,"_3048":119342},[],"Producción, entornos regulados y despliegues personalizados",{"_3592":72120,"_30925":72108,"_21431":119344,"_5":14725,"_28112":119313,"_3048":119345},[],"Tu equipo",{"_3592":72121,"_30925":72108,"_21431":119347,"_5":14725,"_28112":119313,"_3048":119348},[],"Helm o Fastlane",{"_3592":72122,"_30925":72108,"_21431":119350,"_5":14725,"_28112":119313,"_3048":50624},[],{"_3592":72123,"_30925":72108,"_21431":119352,"_5":14725,"_28112":119313,"_3048":119353},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3592":72124,"_30925":72108,"_21431":119355,"_5":14725,"_28112":119313,"_3048":119345},[],{"_3592":72125,"_30925":72108,"_21431":119357,"_5":14725,"_28112":119313,"_3048":119358},[],"Imagen preconfigurada en EC2",{"_3592":72126,"_30925":72108,"_21431":119360,"_5":14725,"_28112":119313,"_3048":50635},[],{"_3592":72127,"_30925":72108,"_21431":119362,"_5":14725,"_28112":119313,"_3048":119363},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3592":72128,"_30925":72108,"_21431":119365,"_5":14725,"_28112":119313,"_3048":50641},[],{"_3592":72129,"_30925":72108,"_21431":119367,"_5":14725,"_28112":119313,"_3048":119368},[],"Suscripción gestionada",{"_3592":72130,"_30925":72108,"_21431":119370,"_5":14725,"_28112":119313,"_3048":119371},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3592":72131,"_30925":72108,"_21431":119373,"_5":14725,"_28112":119313,"_3048":119374},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3592":72132,"_30925":72108,"_21431":119376,"_5":14725,"_28112":119313,"_3048":119377},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3592":72133,"_30925":72108,"_21431":119379,"_5":14725,"_28112":119317,"_3048":119380},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3592":72134,"_30925":72108,"_21431":119382,"_5":14725,"_28112":119321,"_3048":119383},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3592":72135,"_30925":72135,"_5":15085,"_3048":119385,"_31263":119386,"_21431":119387,"_28112":72135},"Utiliza Lamassu como SaaS",[50505,119234,119235],[],{"_3592":72136,"_30925":72135,"_21431":119389,"_5":14725,"_28112":72135,"_3048":119390},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3592":72137,"_30925":72135,"_5":31260,"_21431":119392,"_28112":119393,"_3048":119394},[],"/docs/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3592":72138,"_30925":72135,"_5":31260,"_21431":119396,"_28112":119397,"_3048":119398},[],"/docs/es/deployment/saas#planes","Planes",{"_3592":72139,"_30925":72135,"_5":31260,"_21431":119400,"_28112":119401,"_3048":119402},[],"/docs/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3592":72140,"_30925":72135,"_21431":119404,"_5":14725,"_28112":72135,"_3048":119405},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3592":72141,"_30925":72135,"_21431":119407,"_5":14725,"_28112":119393,"_3048":119408},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3592":72142,"_30925":72135,"_21431":119410,"_5":14725,"_28112":119393,"_3048":119411},[],"Copias de seguridad automáticas.",{"_3592":72143,"_30925":72135,"_21431":119413,"_5":14725,"_28112":119393,"_3048":119414},[],"Actualizaciones de versión.",{"_3592":72144,"_30925":72135,"_21431":119416,"_5":14725,"_28112":119393,"_3048":119417},[],"Soporte técnico y SLA según el plan contratado.",{"_3592":72145,"_30925":72135,"_21431":119419,"_5":14725,"_28112":119397,"_3048":50696},[],{"_3592":72146,"_30925":72135,"_21431":119421,"_5":14725,"_28112":119397,"_3048":119422},[],"Dispositivos",{"_3592":72147,"_30925":72135,"_21431":119424,"_5":14725,"_28112":119397,"_3048":119425},[],"Soporte",{"_3592":72148,"_30925":72135,"_21431":119427,"_5":14725,"_28112":119397,"_3048":50705},[],{"_3592":72149,"_30925":72135,"_21431":119429,"_5":14725,"_28112":119397,"_3048":50708},[],{"_3592":72150,"_30925":72135,"_21431":119431,"_5":14725,"_28112":119397,"_3048":119432},[],"Hasta 1.000",{"_3592":72151,"_30925":72135,"_21431":119434,"_5":14725,"_28112":119397,"_3048":50714},[],{"_3592":72152,"_30925":72135,"_21431":119436,"_5":14725,"_28112":119397,"_3048":119437},[],"99,5 %",{"_3592":72153,"_30925":72135,"_21431":119439,"_5":14725,"_28112":119397,"_3048":50720},[],{"_3592":72154,"_30925":72135,"_21431":119441,"_5":14725,"_28112":119397,"_3048":119442},[],"Hasta 10.000",{"_3592":72155,"_30925":72135,"_21431":119444,"_5":14725,"_28112":119397,"_3048":119445},[],"Email y chat",{"_3592":72156,"_30925":72135,"_21431":119447,"_5":14725,"_28112":119397,"_3048":119448},[],"99,9 %",{"_3592":72157,"_30925":72135,"_21431":119450,"_5":14725,"_28112":119397,"_3048":50732},[],{"_3592":72158,"_30925":72135,"_21431":119452,"_5":14725,"_28112":119397,"_3048":119453},[],"Ilimitados",{"_3592":72159,"_30925":72135,"_21431":119455,"_5":14725,"_28112":119397,"_3048":119456},[],"Dedicado",{"_3592":72160,"_30925":72135,"_21431":119458,"_5":14725,"_28112":119397,"_3048":119459},[],"99,99 %",{"_3592":72161,"_30925":72135,"_21431":119461,"_5":14725,"_28112":119401,"_3048":119462},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3592":72162,"_30925":72135,"_21431":119464,"_5":14725,"_28112":119401,"_3048":119465},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3592":72163,"_30925":72163,"_5":15085,"_3048":50749,"_31263":119467,"_21431":119469,"_28112":72163},[50505,119234,119468],"Kubernetes autogestionado",[],{"_3592":72164,"_30925":72163,"_21431":119471,"_5":14725,"_28112":72163,"_3048":119472},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3592":72165,"_30925":72163,"_5":31260,"_21431":119474,"_28112":119475,"_3048":119476},[],"/docs/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3592":72166,"_30925":72163,"_5":31260,"_21431":119478,"_28112":119479,"_3048":119480},[],"/docs/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3592":72167,"_30925":72163,"_5":31260,"_21431":119482,"_28112":119483,"_3048":119484},[],"/docs/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3592":72168,"_30925":72163,"_5":31260,"_21431":119486,"_28112":119487,"_3048":119488},[],"/docs/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3592":72169,"_30925":72163,"_5":31260,"_21431":119490,"_28112":119491,"_3048":119492},[],"/docs/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3592":72170,"_30925":72163,"_5":31260,"_21431":119494,"_28112":119495,"_3048":119496},[],"/docs/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3592":72171,"_30925":72163,"_5":31260,"_21431":119498,"_28112":119499,"_3048":119500},[],"/docs/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3592":72172,"_30925":72163,"_5":31260,"_21431":119502,"_28112":119503,"_3048":119504},[],"/docs/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3592":72173,"_30925":72163,"_5":31260,"_21431":119506,"_28112":119507,"_3048":119508},[],"/docs/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3592":72174,"_30925":72163,"_5":31260,"_21431":119510,"_28112":119511,"_3048":119512},[],"/docs/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3592":72175,"_30925":72163,"_5":31260,"_21431":119514,"_28112":119515,"_3048":119516},[],"/docs/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3592":72176,"_30925":72163,"_21431":119518,"_5":14725,"_28112":119475,"_3048":119519},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3592":72177,"_30925":72163,"_21431":119521,"_5":14725,"_28112":119475,"_3048":119522},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3592":72178,"_30925":72163,"_21431":119524,"_5":14725,"_28112":119479,"_3048":119525},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3592":72179,"_30925":72163,"_21431":119527,"_5":14725,"_28112":119479,"_3048":119528},[],"Fastlane instala o configura",{"_3592":72180,"_30925":72163,"_21431":119530,"_5":14725,"_28112":119479,"_3048":119531},[],"Tú sigues proporcionando",{"_3592":72181,"_30925":72163,"_21431":119533,"_5":14725,"_28112":119479,"_3048":119534},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3592":72182,"_30925":72163,"_21431":119536,"_5":14725,"_28112":119479,"_3048":119537},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3592":72183,"_30925":72163,"_21431":119539,"_5":14725,"_28112":119479,"_3048":119540},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3592":72184,"_30925":72163,"_21431":119542,"_5":14725,"_28112":119479,"_3048":119543},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3592":72185,"_30925":72163,"_21431":119545,"_5":14725,"_28112":119479,"_3048":119546},[],"Un flujo de certificado self-signed para Lamassu, credenciales de las dependencias almacenadas en Secrets de Kubernetes (mediante el External Secrets Operator) y un usuario inicial",{"_3592":72186,"_30925":72163,"_21431":119548,"_5":14725,"_28112":119479,"_3048":119549},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3592":72187,"_30925":72163,"_21431":119551,"_5":14725,"_28112":119479,"_3048":119552},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3592":72188,"_30925":72163,"_21431":119554,"_5":14725,"_28112":119479,"_3048":119555},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3592":72189,"_30925":72163,"_21431":119557,"_5":14725,"_28112":119479,"_3048":119558},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3592":72190,"_30925":72163,"_21431":119560,"_5":14725,"_28112":119483,"_3048":119561},[],"Necesitas:",{"_3592":72191,"_30925":72163,"_21431":119563,"_5":14725,"_28112":119483,"_3048":119564},[],"un clúster Kubernetes existente",{"_3592":72192,"_30925":72163,"_21431":119566,"_5":14725,"_28112":119483,"_3048":119567},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3592":72193,"_30925":72163,"_21431":119569,"_5":14725,"_28112":119483,"_3048":50851},[],{"_3592":72194,"_30925":72163,"_21431":119571,"_5":14725,"_28112":119483,"_3048":24216},[],{"_3592":72195,"_30925":72163,"_21431":119573,"_5":14725,"_28112":119483,"_3048":119574},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3592":72196,"_30925":72163,"_21431":119576,"_5":14725,"_28112":119483,"_3048":119577},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3592":72197,"_30925":72163,"_21431":119579,"_5":14725,"_28112":119483,"_3048":119580},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3592":72198,"_30925":72163,"_21431":119582,"_5":14725,"_28112":119483,"_3048":119583},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3592":72199,"_30925":72163,"_21431":119585,"_5":14725,"_28112":119483,"_3048":119586},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3592":72200,"_30925":72163,"_21431":119588,"_5":14725,"_28112":119487,"_3048":119589},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3592":72201,"_30925":72163,"_21431":119591,"_5":14725,"_28112":119487,"_3048":119592},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3592":72202,"_30925":72163,"_21431":119594,"_5":14725,"_28112":119491,"_3048":119595},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3592":72203,"_30925":72163,"_21431":119597,"_5":14725,"_28112":119491,"_3048":119598},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3592":72204,"_30925":72163,"_21431":119600,"_5":14725,"_28112":119491,"_3048":119601},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3592":72205,"_30925":72163,"_21431":119603,"_5":14725,"_28112":119491,"_3048":119604},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3592":72206,"_30925":72163,"_21431":119606,"_5":14725,"_28112":119495,"_3048":119607},[],"Opción",{"_3592":72207,"_30925":72163,"_21431":119609,"_5":14725,"_28112":119495,"_3048":119610},[],"Valor predeterminado",{"_3592":72208,"_30925":72163,"_21431":119612,"_5":14725,"_28112":119495,"_3048":119613},[],"Propósito",{"_3592":72209,"_30925":72163,"_21431":119615,"_5":14725,"_28112":119495,"_3048":50898},[],{"_3592":72210,"_30925":72163,"_21431":119617,"_5":14725,"_28112":119495,"_3048":50901},[],{"_3592":72211,"_30925":72163,"_21431":119619,"_5":14725,"_28112":119495,"_3048":119620},[],"Muestra la ayuda",{"_3592":72212,"_30925":72163,"_21431":119622,"_5":14725,"_28112":119495,"_3048":50907},[],{"_3592":72213,"_30925":72163,"_21431":119624,"_5":14725,"_28112":119495,"_3048":119625},[],"contexto actual",{"_3592":72214,"_30925":72163,"_21431":119627,"_5":14725,"_28112":119495,"_3048":119628},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3592":72215,"_30925":72163,"_21431":119630,"_5":14725,"_28112":119495,"_3048":50916},[],{"_3592":72216,"_30925":72163,"_21431":119632,"_5":14725,"_28112":119495,"_3048":6743},[],{"_3592":72217,"_30925":72163,"_21431":119634,"_5":14725,"_28112":119495,"_3048":119635},[],"Omite prompts y genera credenciales para las dependencias",{"_3592":72218,"_30925":72163,"_21431":119637,"_5":14725,"_28112":119495,"_3048":50924},[],{"_3592":72219,"_30925":72163,"_21431":119639,"_5":14725,"_28112":119495,"_3048":50927},[],{"_3592":72220,"_30925":72163,"_21431":119641,"_5":14725,"_28112":119495,"_3048":119642},[],"Namespace de la instalación",{"_3592":72221,"_30925":72163,"_21431":119644,"_5":14725,"_28112":119495,"_3048":50933},[],{"_3592":72222,"_30925":72163,"_21431":119646,"_5":14725,"_28112":119495,"_3048":50936},[],{"_3592":72223,"_30925":72163,"_21431":119648,"_5":14725,"_28112":119495,"_3048":119649},[],"Dominio usado por la UI, OIDC y el certificado",{"_3592":72224,"_30925":72163,"_21431":119651,"_5":14725,"_28112":119495,"_3048":50942},[],{"_3592":72225,"_30925":72163,"_21431":119653,"_5":14725,"_28112":119495,"_3048":15436},[],{"_3592":72226,"_30925":72163,"_21431":119655,"_5":14725,"_28112":119495,"_3048":119656},[],"Versión del chart de Lamassu",{"_3592":72227,"_30925":72163,"_21431":119658,"_5":14725,"_28112":119495,"_3048":50950},[],{"_3592":72228,"_30925":72163,"_21431":119660,"_5":14725,"_28112":119495,"_3048":50953},[],{"_3592":72229,"_30925":72163,"_21431":119662,"_5":14725,"_28112":119495,"_3048":119663},[],"Puerto del listener HTTPS",{"_3592":72230,"_30925":72163,"_21431":119665,"_5":14725,"_28112":119495,"_3048":50959},[],{"_3592":72231,"_30925":72163,"_21431":119667,"_5":14725,"_28112":119495,"_3048":50962},[],{"_3592":72232,"_30925":72163,"_21431":119669,"_5":14725,"_28112":119495,"_3048":119670},[],"Puerto del listener HTTP",{"_3592":72233,"_30925":72163,"_21431":119672,"_5":14725,"_28112":119495,"_3048":50968},[],{"_3592":72234,"_30925":72163,"_21431":119674,"_5":14725,"_28112":119495,"_3048":50901},[],{"_3592":72235,"_30925":72163,"_21431":119676,"_5":14725,"_28112":119495,"_3048":119677},[],"Certificado PEM para TLS downstream",{"_3592":72236,"_30925":72163,"_21431":119679,"_5":14725,"_28112":119495,"_3048":50976},[],{"_3592":72237,"_30925":72163,"_21431":119681,"_5":14725,"_28112":119495,"_3048":50901},[],{"_3592":72238,"_30925":72163,"_21431":119683,"_5":14725,"_28112":119495,"_3048":119684},[],"Clave privada PEM para TLS downstream",{"_3592":72239,"_30925":72163,"_21431":119686,"_5":14725,"_28112":119495,"_3048":50984},[],{"_3592":72240,"_30925":72163,"_21431":119688,"_5":14725,"_28112":119495,"_3048":119689},[],"chart del repositorio",{"_3592":72241,"_30925":72163,"_21431":119691,"_5":14725,"_28112":119495,"_3048":119692},[],"Usa un chart local de Lamassu sin empaquetar",{"_3592":72242,"_30925":72163,"_21431":119694,"_5":14725,"_28112":119495,"_3048":50993},[],{"_3592":72243,"_30925":72163,"_21431":119696,"_5":14725,"_28112":119495,"_3048":119697},[],"detección automática",{"_3592":72244,"_30925":72163,"_21431":119699,"_5":14725,"_28112":119495,"_3048":119700},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3592":72245,"_30925":72163,"_21431":119702,"_5":14725,"_28112":119495,"_3048":51001},[],{"_3592":72246,"_30925":72163,"_21431":119704,"_5":14725,"_28112":119495,"_3048":6743},[],{"_3592":72247,"_30925":72163,"_21431":119706,"_5":14725,"_28112":119495,"_3048":119707},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3592":72248,"_30925":72163,"_21431":119709,"_5":14725,"_28112":119495,"_3048":51009},[],{"_3592":72249,"_30925":72163,"_21431":119711,"_5":14725,"_28112":119495,"_3048":6743},[],{"_3592":72250,"_30925":72163,"_21431":119713,"_5":14725,"_28112":119495,"_3048":119714},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3592":72251,"_30925":72163,"_21431":119716,"_5":14725,"_28112":119495,"_3048":51017},[],{"_3592":72252,"_30925":72163,"_21431":119718,"_5":14725,"_28112":119495,"_3048":6743},[],{"_3592":72253,"_30925":72163,"_21431":119720,"_5":14725,"_28112":119495,"_3048":119721},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3592":72254,"_30925":72163,"_21431":119723,"_5":14725,"_28112":119495,"_3048":51025},[],{"_3592":72255,"_30925":72163,"_21431":119725,"_5":14725,"_28112":119495,"_3048":6743},[],{"_3592":72256,"_30925":72163,"_21431":119727,"_5":14725,"_28112":119495,"_3048":119728},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3592":72257,"_30925":72163,"_21431":119730,"_5":14725,"_28112":119495,"_3048":51033},[],{"_3592":72258,"_30925":72163,"_21431":119732,"_5":14725,"_28112":119495,"_3048":51036},[],{"_3592":72259,"_30925":72163,"_21431":119734,"_5":14725,"_28112":119495,"_3048":119735},[],"Usa otro chart local de SoftHSM",{"_3592":72260,"_30925":72163,"_21431":119737,"_5":14725,"_28112":119495,"_3048":119738},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3592":72261,"_30925":72163,"_21431":119740,"_5":14725,"_28112":119499,"_3048":119741},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3592":72262,"_30925":72163,"_21431":119743,"_5":14725,"_28112":119499,"_3048":119744},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3592":72263,"_30925":72163,"_21431":119746,"_5":14725,"_28112":119499,"_3048":119747},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3592":72264,"_30925":72163,"_21431":119749,"_5":14725,"_28112":119499,"_3048":119750},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3592":72265,"_30925":72163,"_21431":119752,"_5":14725,"_28112":119499,"_3048":119753},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3592":72266,"_30925":72163,"_21431":119755,"_5":14725,"_28112":119499,"_3048":119756},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3592":72267,"_30925":72163,"_21431":119758,"_5":14725,"_28112":119503,"_3048":51063},[],{"_3592":72268,"_30925":72163,"_21431":119760,"_5":14725,"_28112":119503,"_3048":119761},[],"valida las herramientas locales y el clúster seleccionado",{"_3592":72269,"_30925":72163,"_21431":119763,"_5":14725,"_28112":119503,"_3048":119764},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3592":72270,"_30925":72163,"_21431":119766,"_5":14725,"_28112":119503,"_3048":119767},[],"crea el namespace",{"_3592":72271,"_30925":72163,"_21431":119769,"_5":14725,"_28112":119503,"_3048":119770},[],"instala el External Secrets Operator y crea las credenciales de PostgreSQL, RabbitMQ y del administrador de Keycloak como Secrets a través de un `ClusterSecretStore` Fake",{"_3592":72272,"_30925":72163,"_21431":119772,"_5":14725,"_28112":119503,"_3048":119773},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3592":72273,"_30925":72163,"_21431":119775,"_5":14725,"_28112":119503,"_3048":119776},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3592":72274,"_30925":72163,"_21431":119778,"_5":14725,"_28112":119503,"_3048":119779},[],"instala RabbitMQ",{"_3592":72275,"_30925":72163,"_21431":119781,"_5":14725,"_28112":119503,"_3048":119782},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3592":72276,"_30925":72163,"_21431":119784,"_5":14725,"_28112":119503,"_3048":119785},[],"genera `lamassu.yaml`, que referencia los Secrets en lugar de credenciales inline, e instala el chart de Lamassu",{"_3592":72277,"_30925":72163,"_21431":119787,"_5":14725,"_28112":119503,"_3048":119788},[],"carga datos de ejemplo opcionalmente",{"_3592":72278,"_30925":72163,"_21431":119790,"_5":14725,"_28112":119503,"_3048":119791},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3592":72279,"_30925":72163,"_21431":119793,"_5":14725,"_28112":119507,"_3048":119794},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3592":72280,"_30925":72163,"_21431":119796,"_5":14725,"_28112":119507,"_3048":119797},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3592":72281,"_30925":72163,"_21431":119799,"_5":14725,"_28112":119511,"_3048":119800},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak y las almacena en Secrets de Kubernetes a través del `ClusterSecretStore` Fake del External Secrets Operator. Fastlane escribe `lamassu.yaml` en el directorio actual referenciando esos Secrets — el archivo de valores ya no contiene las credenciales.",{"_3592":72282,"_30925":72163,"_21431":119802,"_5":14725,"_28112":119511,"_3048":119803},[],"La contraseña del administrador de Keycloak ya no se imprime por pantalla. Recupérala del Secret cuando la necesites:",{"_3592":72283,"_30925":72163,"_21431":119805,"_5":14725,"_28112":119511,"_3048":119806},[],"El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3592":72284,"_30925":72163,"_21431":119808,"_5":14725,"_28112":119511,"_3048":119809},[],"El `ClusterSecretStore` Fake almacena las credenciales en texto plano y es solo para laboratorio: sustitúyelo por un proveedor ESO real para cualquier uso que vaya más allá de un entorno desechable. Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3592":72285,"_30925":72163,"_21431":119811,"_5":14725,"_28112":119515,"_3048":119812},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3592":72286,"_30925":72286,"_5":15085,"_3048":119814,"_31263":119815,"_21431":119816,"_28112":72286},"Instala con Helm",[50505,119234,119468],[],{"_3592":72287,"_30925":72286,"_21431":119818,"_5":14725,"_28112":72286,"_3048":119819},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3592":72288,"_30925":72286,"_5":31260,"_21431":119821,"_28112":119822,"_3048":119823},[],"/docs/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3592":72289,"_30925":72286,"_5":31260,"_21431":119825,"_28112":119826,"_3048":119484},[],"/docs/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3592":72290,"_30925":72286,"_5":31260,"_21431":119828,"_28112":119829,"_3048":119830},[],"/docs/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3592":72291,"_30925":72286,"_5":31260,"_21431":119832,"_28112":119833,"_3048":119834},[],"/docs/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3592":72292,"_30925":72286,"_5":31260,"_21431":119836,"_28112":119837,"_3048":119838},[],"/docs/es/deployment/self-hosted/helm#credenciales-en-secrets-de-kubernetes","Credenciales en Secrets de Kubernetes",{"_3592":72293,"_30925":72286,"_5":31260,"_21431":119840,"_28112":119841,"_3048":119842},[],"/docs/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3592":72294,"_30925":72286,"_5":31260,"_21431":119844,"_28112":119845,"_3048":119846},[],"/docs/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3592":72295,"_30925":72286,"_5":31260,"_21431":119848,"_28112":119849,"_3048":119850},[],"/docs/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3592":72296,"_30925":72286,"_5":31260,"_21431":119852,"_28112":119853,"_3048":119854},[],"/docs/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3592":72297,"_30925":72286,"_5":31260,"_21431":119856,"_28112":119857,"_3048":119858},[],"/docs/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3592":72298,"_30925":72286,"_5":31260,"_21431":119860,"_28112":119861,"_3048":119862},[],"/docs/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3592":72299,"_30925":72286,"_5":31260,"_21431":119864,"_28112":119865,"_3048":119866},[],"/docs/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3592":72300,"_30925":72286,"_21431":119868,"_5":14725,"_28112":119822,"_3048":119869},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3592":72301,"_30925":72286,"_21431":119871,"_5":14725,"_28112":119826,"_3048":119872},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3592":72302,"_30925":72286,"_21431":119874,"_5":14725,"_28112":119826,"_3048":119875},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3592":72303,"_30925":72286,"_21431":119877,"_5":14725,"_28112":119826,"_3048":119878},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3592":72304,"_30925":72286,"_21431":119880,"_5":14725,"_28112":119826,"_3048":119881},[],"un broker RabbitMQ accesible y sus credenciales",{"_3592":72305,"_30925":72286,"_21431":119883,"_5":14725,"_28112":119826,"_3048":119884},[],"Secrets de Kubernetes en el namespace del release con las credenciales de PostgreSQL y RabbitMQ (y las credenciales SMTP cuando el SMTP exija autenticación) — el chart lee las credenciales de Secrets y rechaza los valores inline (consulta Credenciales en Secrets de Kubernetes)",{"_3592":72306,"_30925":72286,"_21431":119886,"_5":14725,"_28112":119826,"_3048":119887},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3592":72307,"_30925":72286,"_21431":119889,"_5":14725,"_28112":119826,"_3048":119890},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3592":72308,"_30925":72286,"_21431":119892,"_5":14725,"_28112":119826,"_3048":119893},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3592":72309,"_30925":72286,"_21431":119895,"_5":14725,"_28112":119826,"_3048":119896},[],"una StorageClass y un diseño de tráfico externo",{"_3592":72310,"_30925":72286,"_21431":119898,"_5":14725,"_28112":119826,"_3048":119899},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3592":72311,"_30925":72286,"_21431":119901,"_5":14725,"_28112":119826,"_3048":119902},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3592":72312,"_30925":72286,"_21431":119904,"_5":14725,"_28112":119826,"_3048":119905},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3592":72313,"_30925":72286,"_21431":119907,"_5":14725,"_28112":119829,"_3048":119908},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3592":72314,"_30925":72286,"_21431":119910,"_5":14725,"_28112":119829,"_3048":119911},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3592":72315,"_30925":72286,"_21431":119913,"_5":14725,"_28112":119829,"_3048":119914},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3592":72316,"_30925":72286,"_21431":119916,"_5":14725,"_28112":119833,"_3048":119917},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3592":72317,"_30925":72286,"_21431":119919,"_5":14725,"_28112":119833,"_3048":119920},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3592":72318,"_30925":72286,"_21431":119922,"_5":14725,"_28112":119833,"_3048":119923},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3592":72319,"_30925":72286,"_21431":119925,"_5":14725,"_28112":119833,"_3048":119926},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3592":72320,"_30925":72286,"_21431":119928,"_5":14725,"_28112":119837,"_3048":119929},[],"El chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release. Referéncialas con `existingSecret` más las claves de datos `usernameKey` y `passwordKey`; los valores inline `username` y `password` se han eliminado y `values.schema.json` los rechaza.",{"_3592":72321,"_30925":72286,"_21431":119931,"_5":14725,"_28112":119837,"_3048":119932},[],"Los Secrets deben existir antes de instalar o actualizar: el job de migración de pre-install y pre-upgrade se conecta a PostgreSQL con el Secret de PostgreSQL, y los contenedores de los servicios leen las credenciales de AMQP y SMTP cuando arrancan.",{"_3592":72322,"_30925":72286,"_21431":119934,"_5":14725,"_28112":119837,"_3048":119935},[],"`postgres.existingSecret` (por defecto `lamassu-postgres`) y `amqp.existingSecret` (por defecto `lamassu-amqp`) son obligatorios siempre.",{"_3592":72323,"_30925":72286,"_21431":119937,"_5":14725,"_28112":119837,"_3048":119938},[],"`services.alerts.smtp_server.existingSecret` está vacío por defecto, lo que significa SMTP sin autenticación. Defínelo, junto con sus nombres de clave, solo cuando tu servidor SMTP exija autenticación.",{"_3592":72324,"_30925":72286,"_21431":119940,"_5":14725,"_28112":119837,"_3048":119941},[],"Cada entrada de `services.authz.credentials` nombra su `database` y usa el Secret global de PostgreSQL — `postgres.existingSecret` con sus nombres de clave configurados — salvo que la entrada defina su propio `existingSecret`.",{"_3592":72325,"_30925":72286,"_21431":119943,"_5":14725,"_28112":119837,"_3048":119944},[],"Cambiar el contenido de un Secret no reinicia los pods que lo consumen: los servicios leen las credenciales cuando arrancan. Reinicia los pods afectados después de rotar una credencial.",{"_3592":72326,"_30925":72286,"_21431":119946,"_5":14725,"_28112":119837,"_3048":119947},[],"Para producción, gestiona los Secrets con el External Secrets Operator (ESO), que el chart no instala. El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` de prueba, los recursos `ExternalSecret` y la espera antes de instalar el chart. Su proveedor Fake es solo para pruebas — sustitúyelo por la configuración de tu proveedor para cualquier uso que vaya más allá de un entorno desechable; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager y otros proveedores están documentados en external-secrets.io.",{"_3592":72327,"_30925":72286,"_21431":119949,"_5":14725,"_28112":119837,"_3048":119950},[],"Solo estas credenciales pasan a Secrets: el resto de values, como la configuración de conectores o de motores criptográficos, sigue configurándose en el archivo de values.",{"_3592":72328,"_30925":72286,"_21431":119952,"_5":14725,"_28112":119841,"_3048":119953},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3592":72329,"_30925":72286,"_21431":119955,"_5":14725,"_28112":119845,"_3048":119956},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3592":72330,"_30925":72286,"_21431":119958,"_5":14725,"_28112":119845,"_3048":119959},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3592":72331,"_30925":72286,"_21431":119961,"_5":14725,"_28112":119845,"_3048":119962},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3592":72332,"_30925":72286,"_21431":119964,"_5":14725,"_28112":119845,"_3048":119965},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — el security context del pod por defecto del chart ya define `fsGroup: 65532` para todos los pods de servicio, por lo que este ajuste solo se aplica cuando se ha sobrescrito un `podSecurityContext` explícito sin `fsGroup` y hay un Secret de cliente AMQP configurado — y usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3592":72333,"_30925":72286,"_21431":119967,"_5":14725,"_28112":119845,"_3048":119968},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3592":72334,"_30925":72286,"_21431":119970,"_5":14725,"_28112":119845,"_3048":119971},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3592":72335,"_30925":72286,"_21431":119973,"_5":14725,"_28112":119845,"_3048":119974},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3592":72336,"_30925":72286,"_21431":119976,"_5":14725,"_28112":119849,"_3048":119977},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3592":72337,"_30925":72286,"_21431":119979,"_5":14725,"_28112":119849,"_3048":119980},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3592":72338,"_30925":72286,"_21431":119982,"_5":14725,"_28112":119849,"_3048":119983},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3592":72339,"_30925":72286,"_21431":119985,"_5":14725,"_28112":119849,"_3048":119986},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3592":72340,"_30925":72286,"_21431":119988,"_5":14725,"_28112":119853,"_3048":119989},[],"Para instalar un checkout local:",{"_3592":72341,"_30925":72286,"_21431":119991,"_5":14725,"_28112":119857,"_3048":119992},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3592":72342,"_30925":72286,"_21431":119994,"_5":14725,"_28112":119857,"_3048":119995},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3592":72343,"_30925":72286,"_21431":119997,"_5":14725,"_28112":119861,"_3048":119998},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3592":72344,"_30925":72286,"_21431":120000,"_5":14725,"_28112":119861,"_3048":120001},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3592":72345,"_30925":72286,"_21431":120003,"_5":14725,"_28112":119861,"_3048":120004},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3592":72346,"_30925":72286,"_21431":120006,"_5":14725,"_28112":119861,"_3048":120007},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3592":72347,"_30925":72286,"_21431":120009,"_5":14725,"_28112":119861,"_3048":120010},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3592":72348,"_30925":72286,"_21431":120012,"_5":14725,"_28112":119865,"_3048":120013},[],"Antes de pasar a producción, revisa:",{"_3592":72349,"_30925":72286,"_21431":120015,"_5":14725,"_28112":119865,"_3048":120016},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3592":72350,"_30925":72286,"_21431":120018,"_5":14725,"_28112":119865,"_3048":120019},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3592":72351,"_30925":72286,"_21431":120021,"_5":14725,"_28112":119865,"_3048":120022},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3592":72352,"_30925":72286,"_21431":120024,"_5":14725,"_28112":119865,"_3048":120025},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3592":72353,"_30925":72286,"_21431":120027,"_5":14725,"_28112":119865,"_3048":120028},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3592":72354,"_30925":72286,"_21431":120030,"_5":14725,"_28112":119865,"_3048":120031},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3592":72355,"_30925":72286,"_21431":120033,"_5":14725,"_28112":119865,"_3048":120034},[],"SMTP, observabilidad y entrega de alertas",{"_3592":72356,"_30925":72286,"_21431":120036,"_5":14725,"_28112":119865,"_3048":120037},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3592":72357,"_30925":72286,"_21431":120039,"_5":14725,"_28112":119865,"_3048":120040},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3592":72358,"_30925":72358,"_5":15085,"_3048":120042,"_31263":120043,"_21431":120044,"_28112":72358},"Expón el Gateway",[50505,119234,119468],[],{"_3592":72359,"_30925":72358,"_21431":120046,"_5":14725,"_28112":72358,"_3048":120047},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3592":72360,"_30925":72358,"_5":31260,"_21431":120049,"_28112":120050,"_3048":120051},[],"/docs/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3592":72361,"_30925":72358,"_5":31260,"_21431":120053,"_28112":120054,"_3048":120055},[],"/docs/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3592":72362,"_30925":72358,"_5":31260,"_21431":120057,"_28112":120058,"_3048":120059},[],"/docs/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3592":72363,"_30925":72358,"_5":31260,"_21431":120061,"_28112":120062,"_3048":51368},[],"/docs/es/deployment/self-hosted/networking#k3s",{"_3592":72364,"_30925":72358,"_5":31260,"_21431":120064,"_28112":120065,"_3048":120066},[],"/docs/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3592":72365,"_30925":72358,"_5":31260,"_21431":120068,"_28112":120069,"_3048":120070},[],"/docs/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3592":72366,"_30925":72358,"_5":31260,"_21431":120072,"_28112":120073,"_3048":120074},[],"/docs/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3592":72367,"_30925":72358,"_5":31260,"_21431":120076,"_28112":120077,"_3048":120078},[],"/docs/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3592":72368,"_30925":72358,"_5":31260,"_21431":120080,"_28112":120081,"_3048":120082},[],"/docs/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3592":72369,"_30925":72358,"_5":31260,"_21431":120084,"_28112":120085,"_3048":120086},[],"/docs/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3592":72370,"_30925":72358,"_5":31260,"_21431":120088,"_28112":120089,"_3048":120090},[],"/docs/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3592":72371,"_30925":72358,"_21431":120092,"_5":14725,"_28112":120050,"_3048":120093},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3592":72372,"_30925":72358,"_21431":120095,"_5":14725,"_28112":120050,"_3048":120096},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3592":72373,"_30925":72358,"_21431":120098,"_5":14725,"_28112":120054,"_3048":120099},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3592":72374,"_30925":72358,"_21431":120101,"_5":14725,"_28112":120054,"_3048":120102},[],"Defínelo únicamente cuando:",{"_3592":72375,"_30925":72358,"_21431":120104,"_5":14725,"_28112":120054,"_3048":120105},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3592":72376,"_30925":72358,"_21431":120107,"_5":14725,"_28112":120054,"_3048":120108},[],"esa dirección está asignada a este Gateway",{"_3592":72377,"_30925":72358,"_21431":120110,"_5":14725,"_28112":120054,"_3048":120111},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3592":72378,"_30925":72358,"_21431":120113,"_5":14725,"_28112":120054,"_3048":120114},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3592":72379,"_30925":72358,"_21431":120116,"_5":14725,"_28112":120054,"_3048":120117},[],"No confundas estos valores:",{"_3592":72380,"_30925":72358,"_21431":120119,"_5":14725,"_28112":120054,"_3048":120120},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3592":72381,"_30925":72358,"_21431":120122,"_5":14725,"_28112":120054,"_3048":120123},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3592":72382,"_30925":72358,"_21431":120125,"_5":14725,"_28112":120054,"_3048":120126},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3592":72383,"_30925":72358,"_21431":120128,"_5":14725,"_28112":120058,"_3048":120129},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3592":72384,"_30925":72358,"_21431":120131,"_5":14725,"_28112":120058,"_3048":120132},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3592":72385,"_30925":72358,"_21431":120134,"_5":14725,"_28112":120062,"_3048":120135},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3592":72386,"_30925":72358,"_21431":120137,"_5":14725,"_28112":120062,"_3048":120138},[],"Para el diseño recomendado:",{"_3592":72387,"_30925":72358,"_21431":120140,"_5":14725,"_28112":120062,"_3048":120141},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3592":72388,"_30925":72358,"_21431":120143,"_5":14725,"_28112":120062,"_3048":120144},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3592":72389,"_30925":72358,"_21431":120146,"_5":14725,"_28112":120062,"_3048":120147},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3592":72390,"_30925":72358,"_21431":120149,"_5":14725,"_28112":120062,"_3048":120150},[],"Apunta DNS a la dirección accesible de la VM.",{"_3592":72391,"_30925":72358,"_21431":120152,"_5":14725,"_28112":120062,"_3048":120153},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3592":72392,"_30925":72358,"_21431":120155,"_5":14725,"_28112":120065,"_3048":120156},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3592":72393,"_30925":72358,"_21431":120158,"_5":14725,"_28112":120069,"_3048":120159},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3592":72394,"_30925":72358,"_21431":120161,"_5":14725,"_28112":120069,"_3048":120162},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3592":72395,"_30925":72358,"_21431":120164,"_5":14725,"_28112":120073,"_3048":120165},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3592":72396,"_30925":72358,"_21431":120167,"_5":14725,"_28112":120073,"_3048":120168},[],"Requisito",{"_3592":72397,"_30925":72358,"_21431":120170,"_5":14725,"_28112":120073,"_3048":120171},[],"Diseño recomendado",{"_3592":72398,"_30925":72358,"_21431":120173,"_5":14725,"_28112":120073,"_3048":120174},[],"Consecuencia",{"_3592":72399,"_30925":72358,"_21431":120176,"_5":14725,"_28112":120073,"_3048":120177},[],"Varias URL o servicios de Lamassu",{"_3592":72400,"_30925":72358,"_21431":120179,"_5":14725,"_28112":120073,"_3048":120180},[],"Un Gateway con varias rutas",{"_3592":72401,"_30925":72358,"_21431":120182,"_5":14725,"_28112":120073,"_3048":120183},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3592":72402,"_30925":72358,"_21431":120185,"_5":14725,"_28112":120073,"_3048":120186},[],"Gateways independientes e IP externas distintas",{"_3592":72403,"_30925":72358,"_21431":120188,"_5":14725,"_28112":120073,"_3048":120189},[],"Una VIP por Gateway",{"_3592":72404,"_30925":72358,"_21431":120191,"_5":14725,"_28112":120073,"_3048":120192},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3592":72405,"_30925":72358,"_21431":120194,"_5":14725,"_28112":120073,"_3048":120195},[],"Gateways independientes, un nodo y una IP",{"_3592":72406,"_30925":72358,"_21431":120197,"_5":14725,"_28112":120073,"_3048":120198},[],"Puertos externos diferentes",{"_3592":72407,"_30925":72358,"_21431":120200,"_5":14725,"_28112":120073,"_3048":120201},[],"Los clientes deben indicar puertos no estándar",{"_3592":72408,"_30925":72358,"_21431":120203,"_5":14725,"_28112":120073,"_3048":120204},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3592":72409,"_30925":72358,"_21431":120206,"_5":14725,"_28112":120073,"_3048":120207},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3592":72410,"_30925":72358,"_21431":120209,"_5":14725,"_28112":120073,"_3048":120210},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3592":72411,"_30925":72358,"_21431":120212,"_5":14725,"_28112":120073,"_3048":120213},[],"Recursos Gateway separados pero proxy compartido",{"_3592":72412,"_30925":72358,"_21431":120215,"_5":14725,"_28112":120073,"_3048":120216},[],"Modo merged Gateway de Envoy",{"_3592":72413,"_30925":72358,"_21431":120218,"_5":14725,"_28112":120073,"_3048":120219},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3592":72414,"_30925":72358,"_21431":120221,"_5":14725,"_28112":120073,"_3048":120222},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3592":72415,"_30925":72358,"_21431":120224,"_5":14725,"_28112":120073,"_3048":120225},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3592":72416,"_30925":72358,"_21431":120227,"_5":14725,"_28112":120073,"_3048":120228},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3592":72417,"_30925":72358,"_21431":120230,"_5":14725,"_28112":120073,"_3048":120231},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3592":72418,"_30925":72358,"_21431":120233,"_5":14725,"_28112":120077,"_3048":120234},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3592":72419,"_30925":72358,"_21431":120236,"_5":14725,"_28112":120081,"_3048":120237},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3592":72420,"_30925":72358,"_21431":120239,"_5":14725,"_28112":120081,"_3048":120240},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3592":72421,"_30925":72358,"_21431":120242,"_5":14725,"_28112":120081,"_3048":120243},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3592":72422,"_30925":72358,"_21431":120245,"_5":14725,"_28112":120081,"_3048":120246},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3592":72423,"_30925":72358,"_21431":120248,"_5":14725,"_28112":120081,"_3048":120249},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3592":72424,"_30925":72358,"_21431":120251,"_5":14725,"_28112":120085,"_3048":120252},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3592":72425,"_30925":72358,"_21431":120254,"_5":14725,"_28112":120085,"_3048":120255},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3592":72426,"_30925":72358,"_21431":120257,"_5":14725,"_28112":120089,"_3048":120258},[],"Comprueba, en orden:",{"_3592":72427,"_30925":72358,"_21431":120260,"_5":14725,"_28112":120089,"_3048":120261},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3592":72428,"_30925":72358,"_21431":120263,"_5":14725,"_28112":120089,"_3048":120264},[],"Su estado contiene la dirección esperada.",{"_3592":72429,"_30925":72358,"_21431":120266,"_5":14725,"_28112":120089,"_3048":120267},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3592":72430,"_30925":72358,"_21431":120269,"_5":14725,"_28112":120089,"_3048":120270},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3592":72431,"_30925":72358,"_21431":120272,"_5":14725,"_28112":120089,"_3048":120273},[],"DNS resuelve al endpoint accesible externamente.",{"_3592":72432,"_30925":72358,"_21431":120275,"_5":14725,"_28112":120089,"_3048":120276},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3592":72433,"_30925":72358,"_21431":120278,"_5":14725,"_28112":120089,"_3048":120279},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3592":72434,"_30925":72434,"_5":15085,"_3048":50612,"_31263":120281,"_21431":120282,"_28112":72434},[50505,119234,119468],[],{"_3592":72435,"_30925":72434,"_21431":120284,"_5":14725,"_28112":72434,"_3048":120285},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3592":72436,"_30925":72434,"_5":31260,"_21431":120287,"_28112":120288,"_3048":120289},[],"/docs/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3592":72437,"_30925":72434,"_5":31260,"_21431":120291,"_28112":120292,"_3048":120293},[],"/docs/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3592":72438,"_30925":72434,"_5":31260,"_21431":120295,"_28112":120296,"_3048":120297},[],"/docs/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3592":72439,"_30925":72434,"_5":31260,"_21431":120299,"_28112":120300,"_3048":120301},[],"/docs/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3592":72440,"_30925":72434,"_5":31260,"_21431":120303,"_28112":120304,"_3048":120305},[],"/docs/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3592":72441,"_30925":72434,"_5":31260,"_21431":120307,"_28112":120308,"_3048":120309},[],"/docs/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3592":72442,"_30925":72434,"_21431":120311,"_5":14725,"_28112":120288,"_3048":120312},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3592":72443,"_30925":72434,"_21431":120314,"_5":14725,"_28112":120292,"_3048":120315},[],"Flujo",{"_3592":72444,"_30925":72434,"_21431":120317,"_5":14725,"_28112":120292,"_3048":120318},[],"Úsalo para",{"_3592":72445,"_30925":72434,"_21431":120320,"_5":14725,"_28112":120292,"_3048":120321},[],"Qué instala",{"_3592":72446,"_30925":72434,"_21431":120323,"_5":14725,"_28112":120292,"_3048":51630},[],{"_3592":72447,"_30925":72434,"_21431":120325,"_5":14725,"_28112":120292,"_3048":120326},[],"Producción y entornos controlados",{"_3592":72448,"_30925":72434,"_21431":120328,"_5":14725,"_28112":120292,"_3048":120329},[],"Servicios de Lamassu y recursos de Gateway API",{"_3592":72449,"_30925":72434,"_21431":120331,"_5":14725,"_28112":120292,"_3048":50749},[],{"_3592":72450,"_30925":72434,"_21431":120333,"_5":14725,"_28112":120292,"_3048":120334},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3592":72451,"_30925":72434,"_21431":120336,"_5":14725,"_28112":120292,"_3048":120337},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3592":72452,"_30925":72434,"_21431":120339,"_5":14725,"_28112":120296,"_3048":120340},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3592":72453,"_30925":72434,"_21431":120342,"_5":14725,"_28112":120296,"_3048":120343},[],"Área",{"_3592":72454,"_30925":72434,"_21431":120345,"_5":14725,"_28112":120296,"_3048":120346},[],"El chart de Lamassu proporciona",{"_3592":72455,"_30925":72434,"_21431":120348,"_5":14725,"_28112":120296,"_3048":120349},[],"Tú proporcionas",{"_3592":72456,"_30925":72434,"_21431":120351,"_5":14725,"_28112":120296,"_3048":120352},[],"Aplicaciones Lamassu",{"_3592":72457,"_30925":72434,"_21431":120354,"_5":14725,"_28112":120296,"_3048":120355},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3592":72458,"_30925":72434,"_21431":120357,"_5":14725,"_28112":120296,"_3048":120358},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3592":72459,"_30925":72434,"_21431":120360,"_5":14725,"_28112":120296,"_3048":120361},[],"Datos PostgreSQL",{"_3592":72460,"_30925":72434,"_21431":120363,"_5":14725,"_28112":120296,"_3048":120364},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3592":72461,"_30925":72434,"_21431":120366,"_5":14725,"_28112":120296,"_3048":120367},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3592":72462,"_30925":72434,"_21431":120369,"_5":14725,"_28112":120296,"_3048":120370},[],"Mensajería",{"_3592":72463,"_30925":72434,"_21431":120372,"_5":14725,"_28112":120296,"_3048":120373},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3592":72464,"_30925":72434,"_21431":120375,"_5":14725,"_28112":120296,"_3048":120376},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3592":72465,"_30925":72434,"_21431":120378,"_5":14725,"_28112":120296,"_3048":120379},[],"Identidad",{"_3592":72466,"_30925":72434,"_21431":120381,"_5":14725,"_28112":120296,"_3048":120382},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3592":72467,"_30925":72434,"_21431":120384,"_5":14725,"_28112":120296,"_3048":120385},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3592":72468,"_30925":72434,"_21431":120387,"_5":14725,"_28112":120296,"_3048":120388},[],"Enrutamiento externo",{"_3592":72469,"_30925":72434,"_21431":120390,"_5":14725,"_28112":120296,"_3048":120391},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3592":72470,"_30925":72434,"_21431":120393,"_5":14725,"_28112":120296,"_3048":120394},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3592":72471,"_30925":72434,"_21431":120396,"_5":14725,"_28112":120296,"_3048":51704},[],{"_3592":72472,"_30925":72434,"_21431":120398,"_5":14725,"_28112":120296,"_3048":120399},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3592":72473,"_30925":72434,"_21431":120401,"_5":14725,"_28112":120296,"_3048":120402},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3592":72474,"_30925":72434,"_21431":120404,"_5":14725,"_28112":120296,"_3048":120405},[],"Datos persistentes de la aplicación",{"_3592":72475,"_30925":72434,"_21431":120407,"_5":14725,"_28112":120296,"_3048":120408},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3592":72476,"_30925":72434,"_21431":120410,"_5":14725,"_28112":120296,"_3048":120411},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3592":72477,"_30925":72434,"_21431":120413,"_5":14725,"_28112":120296,"_3048":120414},[],"Integraciones opcionales",{"_3592":72478,"_30925":72434,"_21431":120416,"_5":14725,"_28112":120296,"_3048":120417},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3592":72479,"_30925":72434,"_21431":120419,"_5":14725,"_28112":120296,"_3048":120420},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3592":72480,"_30925":72434,"_21431":120422,"_5":14725,"_28112":120296,"_3048":120423},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3592":72481,"_30925":72434,"_21431":120425,"_5":14725,"_28112":120296,"_3048":120426},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3592":72482,"_30925":72434,"_21431":120428,"_5":14725,"_28112":120300,"_3048":120429},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3592":72483,"_30925":72434,"_21431":120431,"_5":14725,"_28112":120300,"_3048":120432},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3592":72484,"_30925":72434,"_21431":120434,"_5":14725,"_28112":120304,"_3048":120435},[],"Kubernetes 1.24 o posterior",{"_3592":72485,"_30925":72434,"_21431":120437,"_5":14725,"_28112":120304,"_3048":120438},[],"Helm 3.2 o posterior",{"_3592":72486,"_30925":72434,"_21431":120440,"_5":14725,"_28112":120304,"_3048":120441},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3592":72487,"_30925":72434,"_21431":120443,"_5":14725,"_28112":120304,"_3048":120444},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3592":72488,"_30925":72434,"_21431":120446,"_5":14725,"_28112":120304,"_3048":120447},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3592":72489,"_30925":72434,"_21431":120449,"_5":14725,"_28112":120304,"_3048":120450},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3592":72490,"_30925":72434,"_21431":120452,"_5":14725,"_28112":120304,"_3048":120453},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3592":72491,"_30925":72434,"_21431":120455,"_5":14725,"_28112":120308,"_3048":120456},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3592":72492,"_30925":72434,"_21431":120458,"_5":14725,"_28112":120308,"_3048":120459},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3592":72493,"_30925":72434,"_21431":120461,"_5":14725,"_28112":120308,"_3048":120462},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3592":72494,"_30925":72434,"_21431":120464,"_5":14725,"_28112":120308,"_3048":120465},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3592":72495,"_30925":72495,"_5":15085,"_3048":120467,"_31263":120468,"_21431":120470,"_28112":72495},"Resolución de problemas de despliegue",[50505,119234,120469],"Operación",[],{"_3592":72496,"_30925":72495,"_21431":120472,"_5":14725,"_28112":72495,"_3048":120473},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3592":72497,"_30925":72495,"_5":31260,"_21431":120475,"_28112":120476,"_3048":120477},[],"/docs/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3592":72498,"_30925":72495,"_5":31260,"_21431":120479,"_28112":120480,"_3048":120481},[],"/docs/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3592":72499,"_30925":72495,"_5":31260,"_21431":120483,"_28112":120484,"_3048":120485},[],"/docs/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3592":72500,"_30925":72495,"_5":31260,"_21431":120487,"_28112":120488,"_3048":120489},[],"/docs/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3592":72501,"_30925":72495,"_5":31260,"_21431":120491,"_28112":120492,"_3048":120493},[],"/docs/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3592":72502,"_30925":72495,"_5":31260,"_21431":120495,"_28112":120496,"_3048":120497},[],"/docs/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3592":72503,"_30925":72495,"_5":31260,"_21431":120499,"_28112":120500,"_3048":120501},[],"/docs/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3592":72504,"_30925":72495,"_5":31260,"_21431":120503,"_28112":120504,"_3048":120505},[],"/docs/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3592":72505,"_30925":72495,"_5":31260,"_21431":120507,"_28112":120508,"_3048":120509},[],"/docs/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3592":72506,"_30925":72495,"_5":31260,"_21431":120511,"_28112":120512,"_3048":120513},[],"/docs/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3592":72507,"_30925":72495,"_5":31260,"_21431":120515,"_28112":120516,"_3048":120517},[],"/docs/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3592":72508,"_30925":72495,"_5":31260,"_21431":120519,"_28112":120520,"_3048":120521},[],"/docs/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3592":72509,"_30925":72495,"_5":31260,"_21431":120523,"_28112":120524,"_3048":120525},[],"/docs/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3592":72510,"_30925":72495,"_21431":120527,"_5":14725,"_28112":72495,"_3048":120528},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3592":72511,"_30925":72495,"_21431":120530,"_5":14725,"_28112":120480,"_3048":120531},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3592":72512,"_30925":72495,"_21431":120533,"_5":14725,"_28112":120484,"_3048":120534},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3592":72513,"_30925":72495,"_21431":120536,"_5":14725,"_28112":120488,"_3048":120537},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3592":72514,"_30925":72495,"_21431":120539,"_5":14725,"_28112":120492,"_3048":120540},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3592":72515,"_30925":72495,"_21431":120542,"_5":14725,"_28112":120496,"_3048":120543},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3592":72516,"_30925":72495,"_21431":120545,"_5":14725,"_28112":120500,"_3048":120546},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3592":72517,"_30925":72495,"_21431":120548,"_5":14725,"_28112":120500,"_3048":120549},[],"Ejecuta también la prueba de conectividad del chart:",{"_3592":72518,"_30925":72495,"_21431":120551,"_5":14725,"_28112":120500,"_3048":120552},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3592":72519,"_30925":72495,"_21431":120554,"_5":14725,"_28112":120500,"_3048":120555},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3592":72520,"_30925":72495,"_21431":120557,"_5":14725,"_28112":120504,"_3048":120558},[],"Si recibes un 401:",{"_3592":72521,"_30925":72495,"_21431":120560,"_5":14725,"_28112":120504,"_3048":120561},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3592":72522,"_30925":72495,"_21431":120563,"_5":14725,"_28112":120504,"_3048":120564},[],"verifica emisor, audiencia y expiración del token;",{"_3592":72523,"_30925":72495,"_21431":120566,"_5":14725,"_28112":120504,"_3048":120567},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3592":72524,"_30925":72495,"_21431":120569,"_5":14725,"_28112":120504,"_3048":120570},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3592":72525,"_30925":72495,"_21431":120572,"_5":14725,"_28112":120504,"_3048":120573},[],"Si el login termina pero las APIs devuelven 403:",{"_3592":72526,"_30925":72495,"_21431":120575,"_5":14725,"_28112":120504,"_3048":120576},[],"inspecciona los claims reales del token;",{"_3592":72527,"_30925":72495,"_21431":120578,"_5":14725,"_28112":120504,"_3048":120579},[],"confirma que coinciden con un principal activo;",{"_3592":72528,"_30925":72495,"_21431":120581,"_5":14725,"_28112":120504,"_3048":120582},[],"revisa las políticas concedidas al principal;",{"_3592":72529,"_30925":72495,"_21431":120584,"_5":14725,"_28112":120504,"_3048":120585},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3592":72530,"_30925":72495,"_21431":120587,"_5":14725,"_28112":120504,"_3048":120588},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3592":72531,"_30925":72495,"_21431":120590,"_5":14725,"_28112":120508,"_3048":120591},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3592":72532,"_30925":72495,"_21431":120593,"_5":14725,"_28112":120508,"_3048":120594},[],"Localiza el pod y Service de authz.",{"_3592":72533,"_30925":72495,"_21431":120596,"_5":14725,"_28112":120508,"_3048":120597},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3592":72534,"_30925":72495,"_21431":120599,"_5":14725,"_28112":120508,"_3048":120600},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3592":72535,"_30925":72495,"_21431":120602,"_5":14725,"_28112":120508,"_3048":120603},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3592":72536,"_30925":72495,"_21431":120605,"_5":14725,"_28112":120508,"_3048":120606},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3592":72537,"_30925":72495,"_21431":120608,"_5":14725,"_28112":120512,"_3048":120609},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3592":72538,"_30925":72495,"_21431":120611,"_5":14725,"_28112":120516,"_3048":120612},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3592":72539,"_30925":72495,"_21431":120614,"_5":14725,"_28112":120516,"_3048":120615},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3592":72540,"_30925":72495,"_21431":120617,"_5":14725,"_28112":120516,"_3048":120618},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3592":72541,"_30925":72495,"_21431":120620,"_5":14725,"_28112":120516,"_3048":120621},[],"volumen persistente sin enlazar;",{"_3592":72542,"_30925":72495,"_21431":120623,"_5":14725,"_28112":120516,"_3048":120624},[],"imagen inaccesible o política de pull incorrecta;",{"_3592":72543,"_30925":72495,"_21431":120626,"_5":14725,"_28112":120516,"_3048":120627},[],"configuración inválida del motor criptográfico;",{"_3592":72544,"_30925":72495,"_21431":120629,"_5":14725,"_28112":120516,"_3048":120630},[],"límites de CPU o memoria demasiado bajos;",{"_3592":72545,"_30925":72495,"_21431":120632,"_5":14725,"_28112":120516,"_3048":120633},[],"migración previa incompleta.",{"_3592":72546,"_30925":72495,"_21431":120635,"_5":14725,"_28112":120516,"_3048":120636},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3592":72547,"_30925":72495,"_21431":120638,"_5":14725,"_28112":120516,"_3048":120639},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3592":72548,"_30925":72495,"_21431":120641,"_5":14725,"_28112":120516,"_3048":120642},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3592":72549,"_30925":72495,"_21431":120644,"_5":14725,"_28112":120520,"_3048":120645},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3592":72550,"_30925":72495,"_21431":120647,"_5":14725,"_28112":120520,"_3048":120648},[],"verifica que esté habilitado en el servicio emisor;",{"_3592":72551,"_30925":72495,"_21431":120650,"_5":14725,"_28112":120520,"_3048":120651},[],"comprueba conectividad y credenciales AMQP;",{"_3592":72552,"_30925":72495,"_21431":120653,"_5":14725,"_28112":120520,"_3048":120654},[],"revisa exchange, routing key, colas y consumidores;",{"_3592":72553,"_30925":72495,"_21431":120656,"_5":14725,"_28112":120520,"_3048":120657},[],"inspecciona dead-letter queues;",{"_3592":72554,"_30925":72495,"_21431":120659,"_5":14725,"_28112":120520,"_3048":120660},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3592":72555,"_30925":72495,"_21431":120662,"_5":14725,"_28112":120520,"_3048":120663},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3592":72556,"_30925":72495,"_21431":120665,"_5":14725,"_28112":120520,"_3048":120666},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3592":72557,"_30925":72495,"_21431":120668,"_5":14725,"_28112":120520,"_3048":120669},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3592":72558,"_30925":72495,"_21431":120671,"_5":14725,"_28112":120520,"_3048":120672},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3592":72559,"_30925":72495,"_21431":120674,"_5":14725,"_28112":120520,"_3048":120675},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3592":72560,"_30925":72495,"_21431":120677,"_5":14725,"_28112":120520,"_3048":120678},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3592":72561,"_30925":72495,"_21431":120680,"_5":14725,"_28112":120520,"_3048":120681},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3592":72562,"_30925":72495,"_21431":120683,"_5":14725,"_28112":120524,"_3048":120684},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3592":72563,"_30925":72495,"_21431":120686,"_5":14725,"_28112":120524,"_3048":120687},[],"Antes de cerrar una incidencia, guarda:",{"_3592":72564,"_30925":72495,"_21431":120689,"_5":14725,"_28112":120524,"_3048":120690},[],"causa confirmada;",{"_3592":72565,"_30925":72495,"_21431":120692,"_5":14725,"_28112":120524,"_3048":120693},[],"alcance temporal y recursos afectados;",{"_3592":72566,"_30925":72495,"_21431":120695,"_5":14725,"_28112":120524,"_3048":120696},[],"comandos o consultas utilizados;",{"_3592":72567,"_30925":72495,"_21431":120698,"_5":14725,"_28112":120524,"_3048":120699},[],"cambio aplicado y forma de revertirlo;",{"_3592":72568,"_30925":72495,"_21431":120701,"_5":14725,"_28112":120524,"_3048":120702},[],"validación desde un consumidor;",{"_3592":72569,"_30925":72495,"_21431":120704,"_5":14725,"_28112":120524,"_3048":120705},[],"acción preventiva y propietario.",{"_3592":72570,"_30925":72570,"_5":15085,"_3048":120707,"_31263":120708,"_21431":120712,"_28112":72570},"Modelo de datos",[50505,120709,120710,120711],"Plataforma","Administración","Control de acceso",[],{"_3592":72571,"_30925":72570,"_21431":120714,"_5":14725,"_28112":72570,"_3048":120715},[],"Entidades y relaciones del esquema pki.json que utiliza authz para evaluar políticas de acceso.",{"_3592":72572,"_30925":72570,"_5":31260,"_21431":120717,"_28112":120718,"_3048":120719},[],"/docs/es/platform/administration/access-control/data-model#relaciones-del-esquema","Relaciones del esquema",{"_3592":72573,"_30925":72570,"_5":31260,"_21431":120721,"_28112":120722,"_3048":120723},[],"/docs/es/platform/administration/access-control/data-model#entidades-del-esquema","Entidades del esquema",{"_3592":72574,"_30925":72570,"_21431":120725,"_5":14725,"_28112":72570,"_3048":120726},[],"El esquema `connectors/authz/pki.json` define las entidades del dominio `pki` para el control de acceso. Una política identifica el tipo de recurso mediante `namespace: pki`, `schema_name` y `entity_type`. Por ejemplo, `ca.certificate` corresponde al esquema `ca` y al tipo de entidad `certificate`.",{"_3592":72575,"_30925":72570,"_21431":120728,"_5":14725,"_28112":120718,"_3048":120729},[],"Cada flecha sale de la entidad que declara la relación y apunta a su `target_entity`. Debajo de la etiqueta aparece el valor de `foreign_key`, la columna de origen. En `pki.json`, el `name` de cada relación coincide con esa columna. El diagrama se puede pulsar para ampliarlo y recorrerlo.",{"_3592":72576,"_30925":72570,"_21431":120731,"_5":14725,"_28112":120718,"_3048":120732},[],"Una política puede propagar acciones desde la entidad referenciada hacia la que declara la relación. Por ejemplo, para conceder lectura de los dispositivos de un DMS, la regla parte de `dmsmanager.dms`, apunta a `devicemanager.device` y especifica `via: dms_owner`.",{"_3592":72577,"_30925":72570,"_21431":120734,"_5":14725,"_28112":120718,"_3048":120735},[],"En los filtros de acceso heredado, `authz` compara la columna `foreign_key` con la primera columna de `primary_key` de la entidad referenciada. Así, `subject_common_name` se compara con `device.id`, `issuer_meta_serial_number` con `ca_certificate.id` y los enlaces hacia `kms_key` con `kms_key.key_id`.",{"_3592":72578,"_30925":72570,"_21431":120737,"_5":14725,"_28112":120722,"_3048":120738},[],"Entidad (`schema_name.entity_type`)",{"_3592":72579,"_30925":72570,"_21431":120740,"_5":14725,"_28112":120722,"_3048":120741},[],"Tabla (`table_name`)",{"_3592":72580,"_30925":72570,"_21431":120743,"_5":14725,"_28112":120722,"_3048":120744},[],"Clave (`primary_key`)",{"_3592":72581,"_30925":72570,"_21431":120746,"_5":14725,"_28112":120722,"_3048":52055},[],{"_3592":72582,"_30925":72570,"_21431":120748,"_5":14725,"_28112":120722,"_3048":52058},[],{"_3592":72583,"_30925":72570,"_21431":120750,"_5":14725,"_28112":120722,"_3048":52061},[],{"_3592":72584,"_30925":72570,"_21431":120752,"_5":14725,"_28112":120722,"_3048":52064},[],{"_3592":72585,"_30925":72570,"_21431":120754,"_5":14725,"_28112":120722,"_3048":52067},[],{"_3592":72586,"_30925":72570,"_21431":120756,"_5":14725,"_28112":120722,"_3048":52070},[],{"_3592":72587,"_30925":72570,"_21431":120758,"_5":14725,"_28112":120722,"_3048":52073},[],{"_3592":72588,"_30925":72570,"_21431":120760,"_5":14725,"_28112":120722,"_3048":52076},[],{"_3592":72589,"_30925":72570,"_21431":120762,"_5":14725,"_28112":120722,"_3048":52070},[],{"_3592":72590,"_30925":72570,"_21431":120764,"_5":14725,"_28112":120722,"_3048":52081},[],{"_3592":72591,"_30925":72570,"_21431":120766,"_5":14725,"_28112":120722,"_3048":52084},[],{"_3592":72592,"_30925":72570,"_21431":120768,"_5":14725,"_28112":120722,"_3048":52087},[],{"_3592":72593,"_30925":72570,"_21431":120770,"_5":14725,"_28112":120722,"_3048":52090},[],{"_3592":72594,"_30925":72570,"_21431":120772,"_5":14725,"_28112":120722,"_3048":52093},[],{"_3592":72595,"_30925":72570,"_21431":120774,"_5":14725,"_28112":120722,"_3048":52070},[],{"_3592":72596,"_30925":72570,"_21431":120776,"_5":14725,"_28112":120722,"_3048":52098},[],{"_3592":72597,"_30925":72570,"_21431":120778,"_5":14725,"_28112":120722,"_3048":52101},[],{"_3592":72598,"_30925":72570,"_21431":120780,"_5":14725,"_28112":120722,"_3048":52070},[],{"_3592":72599,"_30925":72570,"_21431":120782,"_5":14725,"_28112":120722,"_3048":52106},[],{"_3592":72600,"_30925":72570,"_21431":120784,"_5":14725,"_28112":120722,"_3048":52109},[],{"_3592":72601,"_30925":72570,"_21431":120786,"_5":14725,"_28112":120722,"_3048":52070},[],{"_3592":72602,"_30925":72570,"_21431":120788,"_5":14725,"_28112":120722,"_3048":52114},[],{"_3592":72603,"_30925":72570,"_21431":120790,"_5":14725,"_28112":120722,"_3048":52117},[],{"_3592":72604,"_30925":72570,"_21431":120792,"_5":14725,"_28112":120722,"_3048":52070},[],{"_3592":72605,"_30925":72570,"_21431":120794,"_5":14725,"_28112":120722,"_3048":52122},[],{"_3592":72606,"_30925":72570,"_21431":120796,"_5":14725,"_28112":120722,"_3048":52125},[],{"_3592":72607,"_30925":72570,"_21431":120798,"_5":14725,"_28112":120722,"_3048":52128},[],{"_3592":72608,"_30925":72570,"_21431":120800,"_5":14725,"_28112":120722,"_3048":52131},[],{"_3592":72609,"_30925":72570,"_21431":120802,"_5":14725,"_28112":120722,"_3048":52134},[],{"_3592":72610,"_30925":72570,"_21431":120804,"_5":14725,"_28112":120722,"_3048":52137},[],{"_3592":72611,"_30925":72570,"_21431":120806,"_5":14725,"_28112":120722,"_3048":120807},[],"Los eventos, las suscripciones y los grupos de dispositivos tienen acciones y filtros propios. Sus listas `relations` están vacías y tienen cero referencias entrantes en el esquema. Para `ca.certificate`, `view_tables` también registra `certificates_view`.",{"_3592":72612,"_30925":72570,"_21431":120809,"_5":14725,"_28112":120722,"_3048":120810},[],"Cada entidad declara sus acciones sobre instancias en `atomic_actions`, sus acciones sin identificador de recurso en `global_actions` y las columnas y tipos que admite en `column_filters` mediante `filterable`.",{"_3592":72613,"_30925":72570,"_21431":120812,"_5":14725,"_28112":120722,"_3048":120813},[],"<Card title=\"Acceso heredado por relaciones\" href=\"/docs/platform/administration/access-control#acceso-heredado-por-relaciones\" />",{"_3592":72614,"_30925":72614,"_5":15085,"_3048":120815,"_31263":120816,"_21431":120817,"_28112":72614},"Visión general del control de acceso",[50505,120709,120710,120711],[],{"_3592":72615,"_30925":72614,"_21431":120819,"_5":14725,"_28112":72614,"_3048":120820},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3592":72616,"_30925":72614,"_5":31260,"_21431":120822,"_28112":120823,"_3048":120824},[],"/docs/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3592":72617,"_30925":72614,"_5":31260,"_21431":120826,"_28112":120827,"_3048":120828},[],"/docs/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3592":72618,"_30925":72614,"_5":31260,"_21431":120830,"_28112":120831,"_3048":120832},[],"/docs/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3592":72619,"_30925":72614,"_5":31260,"_21431":120834,"_28112":120835,"_3048":120836},[],"/docs/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3592":72620,"_30925":72614,"_5":31260,"_21431":120838,"_28112":120839,"_3048":120840},[],"/docs/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3592":72621,"_30925":72614,"_5":31260,"_21431":120842,"_28112":120843,"_3048":120844},[],"/docs/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3592":72622,"_30925":72614,"_5":31260,"_21431":120846,"_28112":120847,"_3048":120848},[],"/docs/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3592":72623,"_30925":72614,"_5":31260,"_21431":120850,"_28112":120851,"_3048":120852},[],"/docs/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3592":72624,"_30925":72614,"_5":31260,"_21431":120854,"_28112":120855,"_3048":120856},[],"/docs/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3592":72625,"_30925":72614,"_5":31260,"_21431":120858,"_28112":120859,"_3048":120860},[],"/docs/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3592":72626,"_30925":72614,"_5":31260,"_21431":120862,"_28112":120863,"_3048":120864},[],"/docs/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3592":72627,"_30925":72614,"_5":31260,"_21431":120866,"_28112":120867,"_3048":120868},[],"/docs/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3592":72628,"_30925":72614,"_5":31260,"_21431":120870,"_28112":120871,"_3048":120872},[],"/docs/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3592":72629,"_30925":72614,"_5":31260,"_21431":120874,"_28112":120875,"_3048":120876},[],"/docs/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3592":72630,"_30925":72614,"_5":31260,"_21431":120878,"_28112":120879,"_3048":120880},[],"/docs/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3592":72631,"_30925":72614,"_5":31260,"_21431":120882,"_28112":120883,"_3048":119850},[],"/docs/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3592":72632,"_30925":72614,"_5":31260,"_21431":120885,"_28112":120886,"_3048":120887},[],"/docs/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3592":72633,"_30925":72614,"_5":31260,"_21431":120889,"_28112":120890,"_3048":120891},[],"/docs/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3592":72634,"_30925":72614,"_5":31260,"_21431":120893,"_28112":120894,"_3048":120895},[],"/docs/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3592":72635,"_30925":72614,"_5":31260,"_21431":120897,"_28112":120898,"_3048":120899},[],"/docs/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3592":72636,"_30925":72614,"_5":31260,"_21431":120901,"_28112":120902,"_3048":120903},[],"/docs/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3592":72637,"_30925":72614,"_5":31260,"_21431":120905,"_28112":120906,"_3048":120907},[],"/docs/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3592":72638,"_30925":72614,"_5":31260,"_21431":120909,"_28112":120910,"_3048":120911},[],"/docs/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3592":72639,"_30925":72614,"_5":31260,"_21431":120913,"_28112":120914,"_3048":120915},[],"/docs/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3592":72640,"_30925":72614,"_5":31260,"_21431":120917,"_28112":120918,"_3048":120919},[],"/docs/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3592":72641,"_30925":72614,"_5":31260,"_21431":120921,"_28112":120922,"_3048":120923},[],"/docs/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3592":72642,"_30925":72614,"_5":31260,"_21431":120925,"_28112":120926,"_3048":120927},[],"/docs/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3592":72643,"_30925":72614,"_5":31260,"_21431":120929,"_28112":120930,"_3048":120931},[],"/docs/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3592":72644,"_30925":72614,"_5":31260,"_21431":120933,"_28112":120934,"_3048":120935},[],"/docs/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3592":72645,"_30925":72614,"_5":31260,"_21431":120937,"_28112":120938,"_3048":120939},[],"/docs/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3592":72646,"_30925":72614,"_5":31260,"_21431":120941,"_28112":120942,"_3048":120943},[],"/docs/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3592":72647,"_30925":72614,"_21431":120945,"_5":14725,"_28112":72614,"_3048":120946},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3592":72648,"_30925":72614,"_21431":120948,"_5":14725,"_28112":72614,"_3048":120949},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3592":72649,"_30925":72614,"_21431":120951,"_5":14725,"_28112":72614,"_3048":120952},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3592":72650,"_30925":72614,"_21431":120954,"_5":14725,"_28112":120823,"_3048":120955},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3592":72651,"_30925":72614,"_21431":120957,"_5":14725,"_28112":120823,"_3048":120958},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3592":72652,"_30925":72614,"_21431":120960,"_5":14725,"_28112":120823,"_3048":120961},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3592":72653,"_30925":72614,"_21431":120963,"_5":14725,"_28112":120823,"_3048":120964},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3592":72654,"_30925":72614,"_21431":120966,"_5":14725,"_28112":120823,"_3048":120967},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3592":72655,"_30925":72614,"_21431":120969,"_5":14725,"_28112":120823,"_3048":120970},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3592":72656,"_30925":72614,"_21431":120972,"_5":14725,"_28112":120827,"_3048":120973},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3592":72657,"_30925":72614,"_21431":120975,"_5":14725,"_28112":120827,"_3048":120976},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3592":72658,"_30925":72614,"_21431":120978,"_5":14725,"_28112":120831,"_3048":120979},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3592":72659,"_30925":72614,"_21431":120981,"_5":14725,"_28112":120831,"_3048":120982},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3592":72660,"_30925":72614,"_21431":120984,"_5":14725,"_28112":120831,"_3048":120985},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3592":72661,"_30925":72614,"_21431":120987,"_5":14725,"_28112":120831,"_3048":120988},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3592":72662,"_30925":72614,"_21431":120990,"_5":14725,"_28112":120831,"_3048":120991},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3592":72663,"_30925":72614,"_21431":120993,"_5":14725,"_28112":120831,"_3048":120994},[],"Carga por separado las políticas concedidas a cada principal.",{"_3592":72664,"_30925":72614,"_21431":120996,"_5":14725,"_28112":120831,"_3048":120997},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3592":72665,"_30925":72614,"_21431":120999,"_5":14725,"_28112":120831,"_3048":121000},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3592":72666,"_30925":72614,"_21431":121002,"_5":14725,"_28112":120831,"_3048":121003},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3592":72667,"_30925":72614,"_21431":121005,"_5":14725,"_28112":120831,"_3048":121006},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3592":72668,"_30925":72614,"_21431":121008,"_5":14725,"_28112":120831,"_3048":121009},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3592":72669,"_30925":72614,"_21431":121011,"_5":14725,"_28112":120831,"_3048":121012},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3592":72670,"_30925":72614,"_21431":121014,"_5":14725,"_28112":120835,"_3048":121015},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3592":72671,"_30925":72614,"_21431":121017,"_5":14725,"_28112":120835,"_3048":121018},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3592":72672,"_30925":72614,"_21431":121020,"_5":14725,"_28112":120835,"_3048":121021},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3592":72673,"_30925":72614,"_21431":121023,"_5":14725,"_28112":120835,"_3048":121024},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3592":72674,"_30925":72614,"_21431":121026,"_5":14725,"_28112":120835,"_3048":121027},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3592":72675,"_30925":72614,"_21431":121029,"_5":14725,"_28112":120835,"_3048":121030},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3592":72676,"_30925":72614,"_21431":121032,"_5":14725,"_28112":120835,"_3048":121033},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3592":72677,"_30925":72614,"_21431":121035,"_5":14725,"_28112":120835,"_3048":121036},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3592":72678,"_30925":72614,"_21431":121038,"_5":14725,"_28112":120835,"_3048":121039},[],"Un esquema también puede hacer que una ruta individual acepte la credencial por la URL. **`query_token: true` en una ruta** hace que acepte el token de acceso OIDC del parámetro de consulta `access_token`, pero solo cuando la petición no lleva ni una cabecera `Authorization: Bearer` ni una cabecera de certificado de cliente: la credencial en una cabecera siempre prevalece. El token se valida y autoriza exactamente igual que un token Bearer, así que la acción de la ruta sigue exigiendo un grant, y las rutas que no activan esta opción nunca leen el parámetro de consulta. La terminal experimental del dashboard usa este mecanismo, porque la conexión WebSocket que abre su cliente de navegador no puede establecer cabeceras de petición.",{"_3592":72679,"_30925":72614,"_21431":121041,"_5":14725,"_28112":120835,"_3048":121042},[],"Las cadenas de consulta suelen quedar registradas. `authz` sustituye el valor de `access_token` por `REDACTED` en sus propios logs de decisión, pero otros logs que capturan la URL —el access log del Gateway, los logs de petición de los servicios, el tracing— no la redactan. Reserva `query_token` para rutas WebSocket y tokens de corta duración.",{"_3592":72680,"_30925":72614,"_21431":121044,"_5":14725,"_28112":120839,"_3048":121045},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3592":72681,"_30925":72614,"_21431":121047,"_5":14725,"_28112":120839,"_3048":121048},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3592":72682,"_30925":72614,"_21431":121050,"_5":14725,"_28112":120839,"_3048":121051},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3592":72683,"_30925":72614,"_21431":121053,"_5":14725,"_28112":120839,"_3048":121054},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3592":72684,"_30925":72614,"_21431":121056,"_5":14725,"_28112":120839,"_3048":121057},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3592":72685,"_30925":72614,"_21431":121059,"_5":14725,"_28112":120839,"_3048":121060},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3592":72686,"_30925":72614,"_21431":121062,"_5":14725,"_28112":120839,"_3048":121063},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3592":72687,"_30925":72614,"_21431":121065,"_5":14725,"_28112":120839,"_3048":121066},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3592":72688,"_30925":72614,"_21431":121068,"_5":14725,"_28112":120839,"_3048":121069},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3592":72689,"_30925":72614,"_21431":121071,"_5":14725,"_28112":120839,"_3048":121072},[],"Las acciones se dividen en dos grupos:",{"_3592":72690,"_30925":72614,"_21431":121074,"_5":14725,"_28112":120839,"_3048":121075},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3592":72691,"_30925":72614,"_21431":121077,"_5":14725,"_28112":120839,"_3048":121078},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3592":72692,"_30925":72614,"_21431":121080,"_5":14725,"_28112":120839,"_3048":121081},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3592":72693,"_30925":72614,"_21431":121083,"_5":14725,"_28112":120843,"_3048":121084},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3592":72694,"_30925":72614,"_21431":121086,"_5":14725,"_28112":120843,"_3048":121087},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3592":72695,"_30925":72614,"_21431":121089,"_5":14725,"_28112":120843,"_3048":121090},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3592":72696,"_30925":72614,"_21431":121092,"_5":14725,"_28112":120847,"_3048":121093},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3592":72697,"_30925":72614,"_21431":121095,"_5":14725,"_28112":120847,"_3048":121096},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3592":72698,"_30925":72614,"_21431":121098,"_5":14725,"_28112":120847,"_3048":121099},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3592":72699,"_30925":72614,"_21431":121101,"_5":14725,"_28112":120847,"_3048":121102},[],"Los operadores implementados son:",{"_3592":72700,"_30925":72614,"_21431":121104,"_5":14725,"_28112":120847,"_3048":121105},[],"`equals`, para igualdad exacta;",{"_3592":72701,"_30925":72614,"_21431":121107,"_5":14725,"_28112":120847,"_3048":121108},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3592":72702,"_30925":72614,"_21431":121110,"_5":14725,"_28112":120847,"_3048":121111},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3592":72703,"_30925":72614,"_21431":121113,"_5":14725,"_28112":120847,"_3048":121114},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3592":72704,"_30925":72614,"_21431":121116,"_5":14725,"_28112":120851,"_3048":121117},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3592":72705,"_30925":72614,"_21431":121119,"_5":14725,"_28112":120851,"_3048":121120},[],"Los modos disponibles son:",{"_3592":72706,"_30925":72614,"_21431":121122,"_5":14725,"_28112":120851,"_3048":121123},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3592":72707,"_30925":72614,"_21431":121125,"_5":14725,"_28112":120851,"_3048":121126},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3592":72708,"_30925":72614,"_21431":121128,"_5":14725,"_28112":120851,"_3048":121129},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3592":72709,"_30925":72614,"_21431":121131,"_5":14725,"_28112":120851,"_3048":121132},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3592":72710,"_30925":72614,"_21431":121134,"_5":14725,"_28112":120851,"_3048":121135},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3592":72711,"_30925":72614,"_21431":121137,"_5":14725,"_28112":120851,"_3048":121138},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3592":72712,"_30925":72614,"_21431":121140,"_5":14725,"_28112":120855,"_3048":121141},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3592":72713,"_30925":72614,"_21431":121143,"_5":14725,"_28112":120855,"_3048":121144},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3592":72714,"_30925":72614,"_21431":121146,"_5":14725,"_28112":120855,"_3048":121147},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3592":72715,"_30925":72614,"_21431":121149,"_5":14725,"_28112":120855,"_3048":121150},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3592":72716,"_30925":72614,"_21431":121152,"_5":14725,"_28112":120863,"_3048":121153},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3592":72717,"_30925":72614,"_21431":121155,"_5":14725,"_28112":120863,"_3048":121156},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3592":72718,"_30925":72614,"_21431":121158,"_5":14725,"_28112":120867,"_3048":121159},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3592":72719,"_30925":72614,"_21431":121161,"_5":14725,"_28112":120867,"_3048":121162},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3592":72720,"_30925":72614,"_21431":121164,"_5":14725,"_28112":120867,"_3048":121165},[],"El modelo de datos muestra cómo se conectan los recursos sobre los que se aplican las reglas de entidad.",{"_3592":72721,"_30925":72614,"_21431":121167,"_5":14725,"_28112":120867,"_3048":121168},[],"Una regla solo puede seguir relaciones que el esquema de datos declare entre sus dos entidades. Puedes referenciar la relación por su nombre o por su columna de clave foránea —ambas formas son equivalentes— y es el esquema el que decide qué columna utiliza la consulta. Al guardar una política, `authz` comprueba cada relación contra los esquemas cargados: una que ningún esquema declare, o que apunte a una entidad no cargada, se rechaza en ese momento.",{"_3592":72722,"_30925":72614,"_21431":121170,"_5":14725,"_28112":120867,"_3048":121171},[],"Las políticas almacenadas antes de esta validación pueden contener todavía relaciones que los esquemas no declaran. Esa relación no concede nada: `authz` registra una advertencia, `skipping relation that grants nothing`, indicando la política y la relación, y continúa evaluando el resto de la política. La referencia siempre se resuelve contra el esquema antes de construir cualquier consulta, por lo que una relación no declarada nunca puede alterarla. Si el acceso heredado se reduce tras una actualización, busca esta advertencia en los logs de `authz` y corrige la relación de la política afectada.",{"_3592":72723,"_30925":72614,"_21431":121173,"_5":14725,"_28112":120871,"_3048":121174},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3592":72724,"_30925":72614,"_21431":121176,"_5":14725,"_28112":120871,"_3048":121177},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3592":72725,"_30925":72614,"_21431":121179,"_5":14725,"_28112":120871,"_3048":121180},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3592":72726,"_30925":72614,"_21431":121182,"_5":14725,"_28112":120875,"_3048":121183},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3592":72727,"_30925":72614,"_21431":121185,"_5":14725,"_28112":120875,"_3048":121186},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3592":72728,"_30925":72614,"_21431":121188,"_5":14725,"_28112":120875,"_3048":121189},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3592":72729,"_30925":72614,"_21431":121191,"_5":14725,"_28112":120875,"_3048":121192},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3592":72730,"_30925":72614,"_21431":121194,"_5":14725,"_28112":120875,"_3048":121195},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3592":72731,"_30925":72614,"_21431":121197,"_5":14725,"_28112":120875,"_3048":121198},[],"Ten en cuenta que:",{"_3592":72732,"_30925":72614,"_21431":121200,"_5":14725,"_28112":120875,"_3048":121201},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3592":72733,"_30925":72614,"_21431":121203,"_5":14725,"_28112":120875,"_3048":121204},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3592":72734,"_30925":72614,"_21431":121206,"_5":14725,"_28112":120875,"_3048":121207},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3592":72735,"_30925":72614,"_21431":121209,"_5":14725,"_28112":120879,"_3048":121210},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3592":72736,"_30925":72614,"_21431":121212,"_5":14725,"_28112":120879,"_3048":121213},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3592":72737,"_30925":72614,"_21431":121215,"_5":14725,"_28112":120879,"_3048":121216},[],"acceso completo y de solo lectura a KMS;",{"_3592":72738,"_30925":72614,"_21431":121218,"_5":14725,"_28112":120879,"_3048":121219},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3592":72739,"_30925":72614,"_21431":121221,"_5":14725,"_28112":120879,"_3048":121222},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3592":72740,"_30925":72614,"_21431":121224,"_5":14725,"_28112":120879,"_3048":121225},[],"acceso a la interfaz;",{"_3592":72741,"_30925":72614,"_21431":121227,"_5":14725,"_28112":120879,"_3048":121228},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3592":72742,"_30925":72614,"_21431":121230,"_5":14725,"_28112":120879,"_3048":121231},[],"acceso a la terminal experimental del dashboard (Terminal Network);",{"_3592":72743,"_30925":72614,"_21431":121233,"_5":14725,"_28112":120879,"_3048":121234},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3592":72744,"_30925":72614,"_21431":121236,"_5":14725,"_28112":120879,"_3048":121237},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3592":72745,"_30925":72614,"_21431":121239,"_5":14725,"_28112":120879,"_3048":121240},[],"La política de Terminal Network la crea la precarga de `authz` la próxima vez que `authz` arranque tras la actualización. Las políticas precargadas son políticas del sistema —sus identificadores empiezan por `lamassu.`— y no se pueden editar a través de la API.",{"_3592":72746,"_30925":72614,"_21431":121242,"_5":14725,"_28112":120883,"_3048":121243},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3592":72747,"_30925":72614,"_21431":121245,"_5":14725,"_28112":120883,"_3048":121246},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3592":72748,"_30925":72614,"_21431":121248,"_5":14725,"_28112":120883,"_3048":121249},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3592":72749,"_30925":72614,"_21431":121251,"_5":14725,"_28112":120886,"_3048":121252},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3592":72750,"_30925":72614,"_21431":121254,"_5":14725,"_28112":120890,"_3048":121255},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3592":72751,"_30925":72614,"_21431":121257,"_5":14725,"_28112":120890,"_3048":121258},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3592":72752,"_30925":72614,"_21431":121260,"_5":14725,"_28112":120894,"_3048":121261},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3592":72753,"_30925":72614,"_21431":121263,"_5":14725,"_28112":120898,"_3048":121264},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3592":72754,"_30925":72614,"_21431":121266,"_5":14725,"_28112":120902,"_3048":121267},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3592":72755,"_30925":72614,"_21431":121269,"_5":14725,"_28112":120906,"_3048":121270},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3592":72756,"_30925":72614,"_21431":121272,"_5":14725,"_28112":120906,"_3048":121273},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3592":72757,"_30925":72614,"_21431":121275,"_5":14725,"_28112":120910,"_3048":121276},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3592":72758,"_30925":72614,"_21431":121278,"_5":14725,"_28112":120910,"_3048":121279},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3592":72759,"_30925":72614,"_21431":121281,"_5":14725,"_28112":120910,"_3048":121282},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3592":72760,"_30925":72614,"_21431":121284,"_5":14725,"_28112":120910,"_3048":121285},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3592":72761,"_30925":72614,"_21431":121287,"_5":14725,"_28112":120910,"_3048":121288},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3592":72762,"_30925":72614,"_21431":121290,"_5":14725,"_28112":120910,"_3048":121291},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3592":72763,"_30925":72614,"_21431":121293,"_5":14725,"_28112":120910,"_3048":121294},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3592":72764,"_30925":72614,"_21431":121296,"_5":14725,"_28112":120910,"_3048":121297},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3592":72765,"_30925":72614,"_21431":121299,"_5":14725,"_28112":120914,"_3048":121300},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3592":72766,"_30925":72614,"_21431":121302,"_5":14725,"_28112":120914,"_3048":121303},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3592":72767,"_30925":72614,"_21431":121305,"_5":14725,"_28112":120914,"_3048":121306},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3592":72768,"_30925":72614,"_21431":121308,"_5":14725,"_28112":120918,"_3048":121309},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3592":72769,"_30925":72614,"_21431":121311,"_5":14725,"_28112":120918,"_3048":121312},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3592":72770,"_30925":72614,"_21431":121314,"_5":14725,"_28112":120918,"_3048":121315},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3592":72771,"_30925":72614,"_21431":121317,"_5":14725,"_28112":120918,"_3048":121318},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3592":72772,"_30925":72614,"_21431":121320,"_5":14725,"_28112":120918,"_3048":121321},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3592":72773,"_30925":72614,"_21431":121323,"_5":14725,"_28112":120918,"_3048":121324},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3592":72774,"_30925":72614,"_21431":121326,"_5":14725,"_28112":120918,"_3048":121327},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3592":72775,"_30925":72614,"_21431":121329,"_5":14725,"_28112":120918,"_3048":121330},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3592":72776,"_30925":72614,"_21431":121332,"_5":14725,"_28112":120926,"_3048":121333},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3592":72777,"_30925":72614,"_21431":121335,"_5":14725,"_28112":120930,"_3048":121336},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3592":72778,"_30925":72614,"_21431":121338,"_5":14725,"_28112":120930,"_3048":121339},[],"que exista un principal activo del tipo correcto;",{"_3592":72779,"_30925":72614,"_21431":121341,"_5":14725,"_28112":120930,"_3048":121342},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3592":72780,"_30925":72614,"_21431":121344,"_5":14725,"_28112":120930,"_3048":121345},[],"que todas las condiciones del principal se cumplan;",{"_3592":72781,"_30925":72614,"_21431":121347,"_5":14725,"_28112":120930,"_3048":121348},[],"que el principal tenga concedida la política esperada;",{"_3592":72782,"_30925":72614,"_21431":121350,"_5":14725,"_28112":120930,"_3048":121351},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3592":72783,"_30925":72614,"_21431":121353,"_5":14725,"_28112":120930,"_3048":121354},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3592":72784,"_30925":72614,"_21431":121356,"_5":14725,"_28112":120930,"_3048":121357},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3592":72785,"_30925":72614,"_21431":121359,"_5":14725,"_28112":120930,"_3048":121360},[],"Si una política que dependía de acceso heredado dejó de concederlo tras una actualización, busca en los logs de `authz` el mensaje `skipping relation that grants nothing`: la advertencia indica la política y la relación que los esquemas ya no declaran. Corrige la relación de esa política para que coincida con los esquemas actuales.",{"_3592":72786,"_30925":72614,"_21431":121362,"_5":14725,"_28112":120934,"_3048":121363},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3592":72787,"_30925":72614,"_21431":121365,"_5":14725,"_28112":120938,"_3048":121366},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3592":72788,"_30925":72614,"_21431":121368,"_5":14725,"_28112":120942,"_3048":121369},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3592":72789,"_30925":72614,"_21431":121371,"_5":14725,"_28112":120942,"_3048":121372},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3592":72790,"_30925":72790,"_5":15085,"_3048":121374,"_31263":121375,"_21431":121376,"_28112":72790},"Alertas y suscripciones",[50505,120709,120710],[],{"_3592":72791,"_30925":72790,"_21431":121378,"_5":14725,"_28112":72790,"_3048":121379},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3592":72792,"_30925":72790,"_5":31260,"_21431":121381,"_28112":121382,"_3048":121383},[],"/docs/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3592":72793,"_30925":72790,"_5":31260,"_21431":121385,"_28112":121386,"_3048":121387},[],"/docs/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3592":72794,"_30925":72790,"_5":31260,"_21431":121389,"_28112":121390,"_3048":121391},[],"/docs/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3592":72795,"_30925":72790,"_5":31260,"_21431":121393,"_28112":121394,"_3048":121395},[],"/docs/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3592":72796,"_30925":72790,"_5":31260,"_21431":121397,"_28112":121398,"_3048":121399},[],"/docs/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3592":72797,"_30925":72790,"_5":31260,"_21431":121401,"_28112":121402,"_3048":121403},[],"/docs/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3592":72798,"_30925":72790,"_5":31260,"_21431":121405,"_28112":121406,"_3048":121407},[],"/docs/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3592":72799,"_30925":72790,"_5":31260,"_21431":121409,"_28112":121410,"_3048":121411},[],"/docs/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3592":72800,"_30925":72790,"_5":31260,"_21431":121413,"_28112":121414,"_3048":121415},[],"/docs/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3592":72801,"_30925":72790,"_5":31260,"_21431":121417,"_28112":121418,"_3048":121419},[],"/docs/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3592":72802,"_30925":72790,"_5":31260,"_21431":121421,"_28112":121422,"_3048":121423},[],"/docs/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3592":72803,"_30925":72790,"_21431":121425,"_5":14725,"_28112":72790,"_3048":121426},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3592":72804,"_30925":72790,"_21431":121428,"_5":14725,"_28112":121382,"_3048":121429},[],"Un servicio publica un evento de dominio.",{"_3592":72805,"_30925":72790,"_21431":121431,"_5":14725,"_28112":121382,"_3048":121432},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3592":72806,"_30925":72790,"_21431":121434,"_5":14725,"_28112":121382,"_3048":121435},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3592":72807,"_30925":72790,"_21431":121437,"_5":14725,"_28112":121382,"_3048":121438},[],"Lamassu entrega el evento al canal configurado.",{"_3592":72808,"_30925":72790,"_21431":121440,"_5":14725,"_28112":121382,"_3048":121441},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3592":72809,"_30925":72790,"_21431":121443,"_5":14725,"_28112":121386,"_3048":121444},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3592":72810,"_30925":72790,"_21431":121446,"_5":14725,"_28112":121386,"_3048":121447},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3592":72811,"_30925":72790,"_21431":121449,"_5":14725,"_28112":121386,"_3048":121450},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3592":72812,"_30925":72790,"_21431":121452,"_5":14725,"_28112":121386,"_3048":121453},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3592":72813,"_30925":72790,"_21431":121455,"_5":14725,"_28112":121386,"_3048":121456},[],"`apikey_options` necesita `header` y `key`.",{"_3592":72814,"_30925":72790,"_21431":121458,"_5":14725,"_28112":121386,"_3048":121459},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3592":72815,"_30925":72790,"_21431":121461,"_5":14725,"_28112":121386,"_3048":121462},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3592":72816,"_30925":72790,"_21431":121464,"_5":14725,"_28112":121386,"_3048":121465},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3592":72817,"_30925":72790,"_21431":121467,"_5":14725,"_28112":121394,"_3048":121468},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3592":72818,"_30925":72790,"_21431":121470,"_5":14725,"_28112":121398,"_3048":121471},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3592":72819,"_30925":72790,"_21431":121473,"_5":14725,"_28112":121402,"_3048":121474},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3592":72820,"_30925":72790,"_21431":121476,"_5":14725,"_28112":121402,"_3048":121477},[],"**None** notifica todas las instancias del evento.",{"_3592":72821,"_30925":72790,"_21431":121479,"_5":14725,"_28112":121402,"_3048":121480},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3592":72822,"_30925":72790,"_21431":121482,"_5":14725,"_28112":121402,"_3048":121483},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3592":72823,"_30925":72790,"_21431":121485,"_5":14725,"_28112":121402,"_3048":121486},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3592":72824,"_30925":72790,"_21431":121488,"_5":14725,"_28112":121402,"_3048":121489},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3592":72825,"_30925":72790,"_21431":121491,"_5":14725,"_28112":121402,"_3048":121492},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3592":72826,"_30925":72790,"_21431":121494,"_5":14725,"_28112":121406,"_3048":121495},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3592":72827,"_30925":72790,"_21431":121497,"_5":14725,"_28112":121410,"_3048":121498},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3592":72828,"_30925":72790,"_21431":121500,"_5":14725,"_28112":121410,"_3048":121501},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3592":72829,"_30925":72790,"_21431":121503,"_5":14725,"_28112":121410,"_3048":121504},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3592":72830,"_30925":72790,"_21431":121506,"_5":14725,"_28112":121410,"_3048":121507},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3592":72831,"_30925":72790,"_21431":121509,"_5":14725,"_28112":121410,"_3048":121510},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3592":72832,"_30925":72790,"_21431":121512,"_5":14725,"_28112":121410,"_3048":121513},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3592":72833,"_30925":72790,"_21431":121515,"_5":14725,"_28112":121410,"_3048":121516},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3592":72834,"_30925":72790,"_21431":121518,"_5":14725,"_28112":121410,"_3048":121519},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3592":72835,"_30925":72790,"_21431":121521,"_5":14725,"_28112":121414,"_3048":121522},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3592":72836,"_30925":72790,"_21431":121524,"_5":14725,"_28112":121414,"_3048":121525},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3592":72837,"_30925":72790,"_21431":121527,"_5":14725,"_28112":121414,"_3048":121528},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3592":72838,"_30925":72790,"_21431":121530,"_5":14725,"_28112":121414,"_3048":121531},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3592":72839,"_30925":72790,"_21431":121533,"_5":14725,"_28112":121414,"_3048":121534},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3592":72840,"_30925":72790,"_21431":121536,"_5":14725,"_28112":121414,"_3048":121537},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3592":72841,"_30925":72790,"_21431":121539,"_5":14725,"_28112":121414,"_3048":121540},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3592":72842,"_30925":72790,"_21431":121542,"_5":14725,"_28112":121414,"_3048":121543},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3592":72843,"_30925":72790,"_21431":121545,"_5":14725,"_28112":121418,"_3048":121546},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3592":72844,"_30925":72790,"_21431":121548,"_5":14725,"_28112":121418,"_3048":121549},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3592":72845,"_30925":72790,"_21431":121551,"_5":14725,"_28112":121422,"_3048":121552},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3592":72846,"_30925":72790,"_21431":121554,"_5":14725,"_28112":121422,"_3048":121555},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3592":72847,"_30925":72790,"_21431":121557,"_5":14725,"_28112":121422,"_3048":121558},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3592":72848,"_30925":72790,"_21431":121560,"_5":14725,"_28112":121422,"_3048":121561},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3592":72849,"_30925":72790,"_21431":121563,"_5":14725,"_28112":121422,"_3048":121564},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3592":72850,"_30925":72790,"_21431":121566,"_5":14725,"_28112":121422,"_3048":121567},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` y `va.crl-settings.delete`.",{"_3592":72851,"_30925":72790,"_21431":121569,"_5":14725,"_28112":121422,"_3048":121570},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3592":72852,"_30925":72790,"_21431":121572,"_5":14725,"_28112":121422,"_3048":121573},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3592":72853,"_30925":72790,"_21431":121575,"_5":14725,"_28112":121422,"_3048":121576},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3592":72854,"_30925":72790,"_21431":121578,"_5":14725,"_28112":121422,"_3048":121579},[],"La VA publica además `va.crl-settings.finalize` cuando una CA se revoca de forma permanente o caduca, `va.crl-settings.archive` cuando la CA se elimina, y `va.crl-settings.delete` cuando se eliminan ajustes archivados.",{"_3592":72855,"_30925":72855,"_5":15085,"_3048":121581,"_31263":121582,"_21431":121583,"_28112":72855},"Registros de auditoría",[50505,120709,120710],[],{"_3592":72856,"_30925":72855,"_21431":121585,"_5":14725,"_28112":72855,"_3048":121586},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3592":72857,"_30925":72855,"_5":31260,"_21431":121588,"_28112":121589,"_3048":121590},[],"/docs/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3592":72858,"_30925":72855,"_5":31260,"_21431":121592,"_28112":121593,"_3048":121594},[],"/docs/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3592":72859,"_30925":72855,"_5":31260,"_21431":121596,"_28112":121597,"_3048":121598},[],"/docs/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3592":72860,"_30925":72855,"_5":31260,"_21431":121600,"_28112":121601,"_3048":121602},[],"/docs/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3592":72861,"_30925":72855,"_5":31260,"_21431":121604,"_28112":121605,"_3048":121606},[],"/docs/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3592":72862,"_30925":72855,"_5":31260,"_21431":121608,"_28112":121609,"_3048":121610},[],"/docs/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3592":72863,"_30925":72855,"_5":31260,"_21431":121612,"_28112":121613,"_3048":121614},[],"/docs/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3592":72864,"_30925":72855,"_5":31260,"_21431":121616,"_28112":121617,"_3048":121618},[],"/docs/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3592":72865,"_30925":72855,"_5":31260,"_21431":121620,"_28112":121621,"_3048":121622},[],"/docs/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3592":72866,"_30925":72855,"_5":31260,"_21431":121624,"_28112":121625,"_3048":121626},[],"/docs/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3592":72867,"_30925":72855,"_5":31260,"_21431":121628,"_28112":121629,"_3048":121630},[],"/docs/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3592":72868,"_30925":72855,"_21431":121632,"_5":14725,"_28112":72855,"_3048":121633},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3592":72869,"_30925":72855,"_21431":121635,"_5":14725,"_28112":121589,"_3048":121636},[],"El cuerpo de auditoría incluye:",{"_3592":72870,"_30925":72855,"_21431":121638,"_5":14725,"_28112":121589,"_3048":121639},[],"input: datos recibidos por la operación;",{"_3592":72871,"_30925":72855,"_21431":121641,"_5":14725,"_28112":121589,"_3048":121642},[],"has\\_error: indica si el servicio devolvió un error;",{"_3592":72872,"_30925":72855,"_21431":121644,"_5":14725,"_28112":121589,"_3048":121645},[],"output: resultado producido o mensaje de error;",{"_3592":72873,"_30925":72855,"_21431":121647,"_5":14725,"_28112":121589,"_3048":121648},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3592":72874,"_30925":72855,"_21431":121650,"_5":14725,"_28112":121589,"_3048":121651},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3592":72875,"_30925":72855,"_21431":121653,"_5":14725,"_28112":121589,"_3048":121654},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3592":72876,"_30925":72855,"_21431":121656,"_5":14725,"_28112":121593,"_3048":121657},[],"El backend aplica auditoría a mutaciones de:",{"_3592":72877,"_30925":72855,"_21431":121659,"_5":14725,"_28112":121593,"_3048":121660},[],"autoridades, certificados y perfiles de emisión;",{"_3592":72878,"_30925":72855,"_21431":121662,"_5":14725,"_28112":121593,"_3048":121663},[],"claves y motores KMS;",{"_3592":72879,"_30925":72855,"_21431":121665,"_5":14725,"_28112":121593,"_3048":121666},[],"dispositivos e identidades;",{"_3592":72880,"_30925":72855,"_21431":121668,"_5":14725,"_28112":121593,"_3048":121669},[],"DMS y operaciones de enrolamiento;",{"_3592":72881,"_30925":72855,"_21431":121671,"_5":14725,"_28112":121593,"_3048":121672},[],"funciones de validación y CRL;",{"_3592":72882,"_30925":72855,"_21431":121674,"_5":14725,"_28112":121593,"_3048":121675},[],"principales, políticas y concesiones de autorización.",{"_3592":72883,"_30925":72855,"_21431":121677,"_5":14725,"_28112":121593,"_3048":121678},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3592":72884,"_30925":72855,"_21431":121680,"_5":14725,"_28112":121597,"_3048":121681},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3592":72885,"_30925":72855,"_21431":121683,"_5":14725,"_28112":121597,"_3048":121684},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3592":72886,"_30925":72855,"_21431":121686,"_5":14725,"_28112":121597,"_3048":121687},[],"Diseña el consumidor para:",{"_3592":72887,"_30925":72855,"_21431":121689,"_5":14725,"_28112":121597,"_3048":121690},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3592":72888,"_30925":72855,"_21431":121692,"_5":14725,"_28112":121597,"_3048":121693},[],"conservar el CloudEvent completo sin modificar;",{"_3592":72889,"_30925":72855,"_21431":121695,"_5":14725,"_28112":121597,"_3048":121696},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3592":72890,"_30925":72855,"_21431":121698,"_5":14725,"_28112":121597,"_3048":121699},[],"cifrar en tránsito y en reposo;",{"_3592":72891,"_30925":72855,"_21431":121701,"_5":14725,"_28112":121597,"_3048":121702},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3592":72892,"_30925":72855,"_21431":121704,"_5":14725,"_28112":121597,"_3048":121705},[],"aplicar una política explícita de retención y legal hold;",{"_3592":72893,"_30925":72855,"_21431":121707,"_5":14725,"_28112":121597,"_3048":121708},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3592":72894,"_30925":72855,"_21431":121710,"_5":14725,"_28112":121601,"_3048":121711},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3592":72895,"_30925":72855,"_21431":121713,"_5":14725,"_28112":121601,"_3048":121714},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3592":72896,"_30925":72855,"_21431":121716,"_5":14725,"_28112":121609,"_3048":121717},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3592":72897,"_30925":72855,"_21431":121719,"_5":14725,"_28112":121613,"_3048":121720},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3592":72898,"_30925":72855,"_21431":121722,"_5":14725,"_28112":121617,"_3048":121723},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3592":72899,"_30925":72855,"_21431":121725,"_5":14725,"_28112":121621,"_3048":121726},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3592":72900,"_30925":72855,"_21431":121728,"_5":14725,"_28112":121625,"_3048":121729},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3592":72901,"_30925":72855,"_21431":121731,"_5":14725,"_28112":121629,"_3048":121732},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3592":72902,"_30925":72855,"_21431":121734,"_5":14725,"_28112":121629,"_3048":121735},[],"aparece un evento de auditoría correcto;",{"_3592":72903,"_30925":72855,"_21431":121737,"_5":14725,"_28112":121629,"_3048":121738},[],"el principal coincide con la identidad utilizada;",{"_3592":72904,"_30925":72855,"_21431":121740,"_5":14725,"_28112":121629,"_3048":121741},[],"el consumidor lo persiste una sola vez;",{"_3592":72905,"_30925":72855,"_21431":121743,"_5":14725,"_28112":121629,"_3048":121744},[],"puede recuperarse por recurso, actor y periodo;",{"_3592":72906,"_30925":72855,"_21431":121746,"_5":14725,"_28112":121629,"_3048":121747},[],"una interrupción del consumidor produce una alerta.",{"_3592":72907,"_30925":72855,"_21431":121749,"_5":14725,"_28112":121629,"_3048":121750},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3592":72908,"_30925":72908,"_5":15085,"_3048":121752,"_31263":121753,"_21431":121754,"_28112":72908},"Arquitectura de la plataforma",[50505,120709],[],{"_3592":72909,"_30925":72908,"_21431":121756,"_5":14725,"_28112":72908,"_3048":121757},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3592":72910,"_30925":72908,"_5":31260,"_21431":121759,"_28112":121760,"_3048":121761},[],"/docs/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3592":72911,"_30925":72908,"_5":31260,"_21431":121763,"_28112":121764,"_3048":121765},[],"/docs/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3592":72912,"_30925":72908,"_5":31260,"_21431":121767,"_28112":121768,"_3048":121769},[],"/docs/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3592":72913,"_30925":72908,"_5":31260,"_21431":121771,"_28112":121772,"_3048":121773},[],"/docs/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3592":72914,"_30925":72908,"_5":31260,"_21431":121775,"_28112":121776,"_3048":121777},[],"/docs/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3592":72915,"_30925":72908,"_21431":121779,"_5":14725,"_28112":72908,"_3048":121780},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3592":72916,"_30925":72908,"_21431":121782,"_5":14725,"_28112":72908,"_3048":121783},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3592":72917,"_30925":72908,"_21431":121785,"_5":14725,"_28112":121760,"_3048":121786},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3592":72918,"_30925":72908,"_21431":121788,"_5":14725,"_28112":121764,"_3048":121789},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3592":72919,"_30925":72908,"_21431":121791,"_5":14725,"_28112":121768,"_3048":121792},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3592":72920,"_30925":72908,"_21431":121794,"_5":14725,"_28112":121772,"_3048":121795},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3592":72921,"_30925":72908,"_21431":121797,"_5":14725,"_28112":121776,"_3048":121798},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3592":72922,"_30925":72922,"_5":15085,"_3048":121800,"_31263":121801,"_21431":121802,"_28112":72922},"Cómo funciona Lamassu",[50505,120709],[],{"_3592":72923,"_30925":72922,"_21431":121804,"_5":14725,"_28112":72922,"_3048":121805},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3592":72924,"_30925":72922,"_5":31260,"_21431":121807,"_28112":121808,"_3048":121809},[],"/docs/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3592":72925,"_30925":72922,"_5":31260,"_21431":121811,"_28112":121812,"_3048":121813},[],"/docs/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3592":72926,"_30925":72922,"_21431":121815,"_5":14725,"_28112":72922,"_3048":121816},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3592":72927,"_30925":72922,"_21431":121818,"_5":14725,"_28112":121808,"_3048":121819},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3592":72928,"_30925":72922,"_21431":121821,"_5":14725,"_28112":121808,"_3048":121822},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3592":72929,"_30925":72922,"_21431":121824,"_5":14725,"_28112":121808,"_3048":121825},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3592":72930,"_30925":72922,"_21431":121827,"_5":14725,"_28112":121808,"_3048":121828},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3592":72931,"_30925":72922,"_21431":121830,"_5":14725,"_28112":121808,"_3048":121831},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3592":72932,"_30925":72922,"_21431":121833,"_5":14725,"_28112":121812,"_3048":121834},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3592":72933,"_30925":72922,"_21431":121836,"_5":14725,"_28112":121812,"_3048":121837},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3592":72934,"_30925":72922,"_21431":121839,"_5":14725,"_28112":121812,"_3048":121840},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3592":72935,"_30925":72922,"_21431":121842,"_5":14725,"_28112":121812,"_3048":121843},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3592":72936,"_30925":72922,"_21431":121845,"_5":14725,"_28112":121812,"_3048":121846},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3592":72937,"_30925":72922,"_21431":121848,"_5":14725,"_28112":121812,"_3048":121849},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3592":72938,"_30925":72922,"_21431":121851,"_5":14725,"_28112":121812,"_3048":121852},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3592":72939,"_30925":72939,"_5":15085,"_3048":121854,"_31263":121855,"_21431":121856,"_28112":72939},"Dispositivos e identidades",[50505,120709,53189,121854],[],{"_3592":72940,"_30925":72939,"_21431":121858,"_5":14725,"_28112":72939,"_3048":121859},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3592":72941,"_30925":72939,"_5":31260,"_21431":121861,"_28112":121862,"_3048":121863},[],"/docs/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3592":72942,"_30925":72939,"_5":31260,"_21431":121865,"_28112":121866,"_3048":121867},[],"/docs/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3592":72943,"_30925":72939,"_5":31260,"_21431":121869,"_28112":121870,"_3048":121871},[],"/docs/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3592":72944,"_30925":72939,"_5":31260,"_21431":121873,"_28112":121874,"_3048":121875},[],"/docs/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3592":72945,"_30925":72939,"_5":31260,"_21431":121877,"_28112":121878,"_3048":121879},[],"/docs/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3592":72946,"_30925":72939,"_5":31260,"_21431":121881,"_28112":121882,"_3048":121883},[],"/docs/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3592":72947,"_30925":72939,"_5":31260,"_21431":121885,"_28112":121886,"_3048":121887},[],"/docs/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3592":72948,"_30925":72939,"_5":31260,"_21431":121889,"_28112":121890,"_3048":121891},[],"/docs/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3592":72949,"_30925":72939,"_5":31260,"_21431":121893,"_28112":121894,"_3048":121895},[],"/docs/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3592":72950,"_30925":72939,"_5":31260,"_21431":121897,"_28112":121898,"_3048":121899},[],"/docs/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3592":72951,"_30925":72939,"_5":31260,"_21431":121901,"_28112":121902,"_3048":121903},[],"/docs/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3592":72952,"_30925":72939,"_21431":121905,"_5":14725,"_28112":72939,"_3048":121906},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3592":72953,"_30925":72939,"_21431":121908,"_5":14725,"_28112":72939,"_3048":121909},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3592":72954,"_30925":72939,"_21431":121911,"_5":14725,"_28112":121862,"_3048":121912},[],"Vista operativa",{"_3592":72955,"_30925":72939,"_21431":121914,"_5":14725,"_28112":121862,"_3048":121915},[],"Interpretación",{"_3592":72956,"_30925":72939,"_21431":121917,"_5":14725,"_28112":121862,"_3048":53252},[],{"_3592":72957,"_30925":72939,"_21431":121919,"_5":14725,"_28112":121862,"_3048":121920},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3592":72958,"_30925":72939,"_21431":121922,"_5":14725,"_28112":121862,"_3048":53258},[],{"_3592":72959,"_30925":72939,"_21431":121924,"_5":14725,"_28112":121862,"_3048":121925},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3592":72960,"_30925":72939,"_21431":121927,"_5":14725,"_28112":121862,"_3048":53264},[],{"_3592":72961,"_30925":72939,"_21431":121929,"_5":14725,"_28112":121862,"_3048":121930},[],"La identidad está en la ventana operativa de renovación.",{"_3592":72962,"_30925":72939,"_21431":121932,"_5":14725,"_28112":121862,"_3048":53270},[],{"_3592":72963,"_30925":72939,"_21431":121934,"_5":14725,"_28112":121862,"_3048":121935},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3592":72964,"_30925":72939,"_21431":121937,"_5":14725,"_28112":121862,"_3048":53276},[],{"_3592":72965,"_30925":72939,"_21431":121939,"_5":14725,"_28112":121862,"_3048":121940},[],"La identidad ha vencido.",{"_3592":72966,"_30925":72939,"_21431":121942,"_5":14725,"_28112":121862,"_3048":53282},[],{"_3592":72967,"_30925":72939,"_21431":121944,"_5":14725,"_28112":121862,"_3048":121945},[],"La identidad está marcada como revocada.",{"_3592":72968,"_30925":72939,"_21431":121947,"_5":14725,"_28112":121862,"_3048":53288},[],{"_3592":72969,"_30925":72939,"_21431":121949,"_5":14725,"_28112":121862,"_3048":121950},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3592":72970,"_30925":72939,"_21431":121952,"_5":14725,"_28112":121862,"_3048":121953},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3592":72971,"_30925":72939,"_21431":121955,"_5":14725,"_28112":121866,"_3048":121956},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3592":72972,"_30925":72939,"_21431":121958,"_5":14725,"_28112":121866,"_3048":121959},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3592":72973,"_30925":72939,"_21431":121961,"_5":14725,"_28112":121866,"_3048":121962},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3592":72974,"_30925":72939,"_21431":121964,"_5":14725,"_28112":121866,"_3048":121965},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3592":72975,"_30925":72939,"_21431":121967,"_5":14725,"_28112":121870,"_3048":121968},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3592":72976,"_30925":72939,"_21431":121970,"_5":14725,"_28112":121874,"_3048":121971},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3592":72977,"_30925":72939,"_21431":121973,"_5":14725,"_28112":121878,"_3048":121974},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3592":72978,"_30925":72939,"_21431":121976,"_5":14725,"_28112":121882,"_3048":121977},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3592":72979,"_30925":72939,"_21431":121979,"_5":14725,"_28112":121886,"_3048":121980},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3592":72980,"_30925":72939,"_21431":121982,"_5":14725,"_28112":121886,"_3048":121983},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3592":72981,"_30925":72939,"_21431":121985,"_5":14725,"_28112":121890,"_3048":121986},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3592":72982,"_30925":72939,"_21431":121988,"_5":14725,"_28112":121890,"_3048":121989},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3592":72983,"_30925":72939,"_21431":121991,"_5":14725,"_28112":121890,"_3048":121992},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3592":72984,"_30925":72939,"_21431":121994,"_5":14725,"_28112":121890,"_3048":121995},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3592":72985,"_30925":72939,"_21431":121997,"_5":14725,"_28112":121890,"_3048":121998},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3592":72986,"_30925":72939,"_21431":122000,"_5":14725,"_28112":121890,"_3048":122001},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3592":72987,"_30925":72939,"_21431":122003,"_5":14725,"_28112":121894,"_3048":122004},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3592":72988,"_30925":72939,"_21431":122006,"_5":14725,"_28112":121894,"_3048":122007},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3592":72989,"_30925":72939,"_21431":122009,"_5":14725,"_28112":121898,"_3048":122010},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3592":72990,"_30925":72939,"_21431":122012,"_5":14725,"_28112":121898,"_3048":122013},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3592":72991,"_30925":72939,"_21431":122015,"_5":14725,"_28112":121898,"_3048":122016},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3592":72992,"_30925":72939,"_21431":122018,"_5":14725,"_28112":121898,"_3048":122019},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3592":72993,"_30925":72939,"_21431":122021,"_5":14725,"_28112":121902,"_3048":122022},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3592":72994,"_30925":72939,"_21431":122024,"_5":14725,"_28112":121902,"_3048":122025},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3592":72995,"_30925":72995,"_5":15085,"_3048":122027,"_31263":122028,"_21431":122030,"_28112":72995},"Identidad inicial y autenticación",[50505,120709,53189,121854,122029],"Enrolamiento con PKI",[],{"_3592":72996,"_30925":72995,"_21431":122032,"_5":14725,"_28112":72995,"_3048":122033},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3592":72997,"_30925":72995,"_5":31260,"_21431":122035,"_28112":122036,"_3048":122037},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3592":72998,"_30925":72995,"_5":31260,"_21431":122039,"_28112":122040,"_3048":122041},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3592":72999,"_30925":72995,"_5":31260,"_21431":122043,"_28112":122044,"_3048":122045},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3592":73000,"_30925":72995,"_5":31260,"_21431":122047,"_28112":122048,"_3048":122049},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3592":73001,"_30925":72995,"_5":31260,"_21431":122051,"_28112":122052,"_3048":122053},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3592":73002,"_30925":72995,"_21431":122055,"_5":14725,"_28112":72995,"_3048":122056},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3592":73003,"_30925":72995,"_21431":122058,"_5":14725,"_28112":122036,"_3048":122059},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3592":73004,"_30925":72995,"_21431":122061,"_5":14725,"_28112":122036,"_3048":122062},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3592":73005,"_30925":72995,"_21431":122064,"_5":14725,"_28112":122040,"_3048":122065},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3592":73006,"_30925":72995,"_21431":122067,"_5":14725,"_28112":122040,"_3048":122068},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3592":73007,"_30925":72995,"_21431":122070,"_5":14725,"_28112":122040,"_3048":122071},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3592":73008,"_30925":72995,"_21431":122073,"_5":14725,"_28112":122044,"_3048":122074},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3592":73009,"_30925":72995,"_21431":122076,"_5":14725,"_28112":122044,"_3048":122077},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3592":73010,"_30925":72995,"_21431":122079,"_5":14725,"_28112":122048,"_3048":122080},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3592":73011,"_30925":72995,"_21431":122082,"_5":14725,"_28112":122048,"_3048":122083},[],"Ejemplo de cuerpo:",{"_3592":73012,"_30925":72995,"_21431":122085,"_5":14725,"_28112":122048,"_3048":122086},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3592":73013,"_30925":72995,"_21431":122088,"_5":14725,"_28112":122048,"_3048":122089},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3592":73014,"_30925":72995,"_21431":122091,"_5":14725,"_28112":122048,"_3048":122092},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3592":73015,"_30925":72995,"_21431":122094,"_5":14725,"_28112":122048,"_3048":122095},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3592":73016,"_30925":72995,"_21431":122097,"_5":14725,"_28112":122052,"_3048":122098},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3592":73017,"_30925":72995,"_21431":122100,"_5":14725,"_28112":122052,"_3048":122101},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3592":73018,"_30925":73018,"_5":15085,"_3048":122103,"_31263":122104,"_21431":122105,"_28112":73018},"Configura y opera el DMS",[50505,120709,53189,121854,122029],[],{"_3592":73019,"_30925":73018,"_21431":122107,"_5":14725,"_28112":73018,"_3048":122108},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3592":73020,"_30925":73018,"_5":31260,"_21431":122110,"_28112":122111,"_3048":119243},[],"/docs/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3592":73021,"_30925":73018,"_5":31260,"_21431":122113,"_28112":122114,"_3048":122115},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3592":73022,"_30925":73018,"_5":31260,"_21431":122117,"_28112":122118,"_3048":122119},[],"/docs/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3592":73023,"_30925":73018,"_5":31260,"_21431":122121,"_28112":122122,"_3048":122123},[],"/docs/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3592":73024,"_30925":73018,"_5":31260,"_21431":122125,"_28112":122126,"_3048":122127},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3592":73025,"_30925":73018,"_5":31260,"_21431":122129,"_28112":122130,"_3048":122131},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3592":73026,"_30925":73018,"_5":31260,"_21431":122133,"_28112":122134,"_3048":122135},[],"/docs/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3592":73027,"_30925":73018,"_5":31260,"_21431":122137,"_28112":122138,"_3048":122139},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3592":73028,"_30925":73018,"_5":31260,"_21431":122141,"_28112":122142,"_3048":53484},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3592":73029,"_30925":73018,"_5":31260,"_21431":122144,"_28112":122145,"_3048":53488},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3592":73030,"_30925":73018,"_5":31260,"_21431":122147,"_28112":122148,"_3048":122149},[],"/docs/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3592":73031,"_30925":73018,"_5":31260,"_21431":122151,"_28112":122152,"_3048":122153},[],"/docs/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3592":73032,"_30925":73018,"_5":31260,"_21431":122155,"_28112":122156,"_3048":122157},[],"/docs/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3592":73033,"_30925":73018,"_5":31260,"_21431":122159,"_28112":122160,"_3048":122161},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3592":73034,"_30925":73018,"_5":31260,"_21431":122163,"_28112":122164,"_3048":53508},[],"/docs/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3592":73035,"_30925":73018,"_5":31260,"_21431":122166,"_28112":122167,"_3048":122168},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3592":73036,"_30925":73018,"_5":31260,"_21431":122170,"_28112":122171,"_3048":122172},[],"/docs/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3592":73037,"_30925":73018,"_5":31260,"_21431":122174,"_28112":122175,"_3048":122176},[],"/docs/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3592":73038,"_30925":73018,"_21431":122178,"_5":14725,"_28112":73018,"_3048":122179},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3592":73039,"_30925":73018,"_21431":122181,"_5":14725,"_28112":122111,"_3048":122182},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3592":73040,"_30925":73018,"_21431":122184,"_5":14725,"_28112":122111,"_3048":122185},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3592":73041,"_30925":73018,"_21431":122187,"_5":14725,"_28112":122118,"_3048":122188},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3592":73042,"_30925":73018,"_21431":122190,"_5":14725,"_28112":122122,"_3048":122191},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3592":73043,"_30925":73018,"_21431":122193,"_5":14725,"_28112":122126,"_3048":122194},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3592":73044,"_30925":73018,"_21431":122196,"_5":14725,"_28112":122130,"_3048":122197},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3592":73045,"_30925":73018,"_21431":122199,"_5":14725,"_28112":122134,"_3048":122200},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3592":73046,"_30925":73018,"_21431":122202,"_5":14725,"_28112":122142,"_3048":122203},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3592":73047,"_30925":73018,"_21431":122205,"_5":14725,"_28112":122142,"_3048":122206},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3592":73048,"_30925":73018,"_21431":122208,"_5":14725,"_28112":122145,"_3048":122209},[],"Campo de `settings.enrollment_settings`",{"_3592":73049,"_30925":73018,"_21431":122211,"_5":14725,"_28112":122145,"_3048":122212},[],"Decisión",{"_3592":73050,"_30925":73018,"_21431":122214,"_5":14725,"_28112":122145,"_3048":53559},[],{"_3592":73051,"_30925":73018,"_21431":122216,"_5":14725,"_28112":122145,"_3048":122217},[],"`EST_RFC7030` para estas operaciones.",{"_3592":73052,"_30925":73018,"_21431":122219,"_5":14725,"_28112":122145,"_3048":53565},[],{"_3592":73053,"_30925":73018,"_21431":122221,"_5":14725,"_28112":122145,"_3048":122222},[],"ID de la CA que firmará.",{"_3592":73054,"_30925":73018,"_21431":122224,"_5":14725,"_28112":122145,"_3048":53571},[],{"_3592":73055,"_30925":73018,"_21431":122226,"_5":14725,"_28112":122145,"_3048":122227},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3592":73056,"_30925":73018,"_21431":122229,"_5":14725,"_28112":122145,"_3048":53577},[],{"_3592":73057,"_30925":73018,"_21431":122231,"_5":14725,"_28112":122145,"_3048":122232},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3592":73058,"_30925":73018,"_21431":122234,"_5":14725,"_28112":122145,"_3048":53583},[],{"_3592":73059,"_30925":73018,"_21431":122236,"_5":14725,"_28112":122145,"_3048":122237},[],"Uno de los cuatro modos de autenticación.",{"_3592":73060,"_30925":73018,"_21431":122239,"_5":14725,"_28112":122145,"_3048":122240},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3592":73061,"_30925":73018,"_21431":122242,"_5":14725,"_28112":122148,"_3048":122243},[],"Los bloques son independientes:",{"_3592":73062,"_30925":73018,"_21431":122245,"_5":14725,"_28112":122148,"_3048":122246},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3592":73063,"_30925":73018,"_21431":122248,"_5":14725,"_28112":122148,"_3048":122249},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3592":73064,"_30925":73018,"_21431":122251,"_5":14725,"_28112":122148,"_3048":53601},[],{"_3592":73065,"_30925":73018,"_21431":122253,"_5":14725,"_28112":122148,"_3048":122254},[],"Control aplicado en la operación configurada",{"_3592":73066,"_30925":73018,"_21431":122256,"_5":14725,"_28112":122148,"_3048":53607},[],{"_3592":73067,"_30925":73018,"_21431":122258,"_5":14725,"_28112":122148,"_3048":122259},[],"Validación del certificado presentado.",{"_3592":73068,"_30925":73018,"_21431":122261,"_5":14725,"_28112":122148,"_3048":53613},[],{"_3592":73069,"_30925":73018,"_21431":122263,"_5":14725,"_28112":122148,"_3048":122264},[],"Autorización del webhook configurado.",{"_3592":73070,"_30925":73018,"_21431":122266,"_5":14725,"_28112":122148,"_3048":53619},[],{"_3592":73071,"_30925":73018,"_21431":122268,"_5":14725,"_28112":122148,"_3048":122269},[],"Validación del certificado y, después, aprobación del webhook.",{"_3592":73072,"_30925":73018,"_21431":122271,"_5":14725,"_28112":122148,"_3048":53625},[],{"_3592":73073,"_30925":73018,"_21431":122273,"_5":14725,"_28112":122148,"_3048":122274},[],"Sin autenticación del solicitante por el DMS.",{"_3592":73074,"_30925":73018,"_21431":122276,"_5":14725,"_28112":122148,"_3048":122277},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3592":73075,"_30925":73018,"_21431":122279,"_5":14725,"_28112":122148,"_3048":122280},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3592":73076,"_30925":73018,"_21431":122282,"_5":14725,"_28112":122148,"_3048":122283},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3592":73077,"_30925":73018,"_21431":122285,"_5":14725,"_28112":122148,"_3048":122286},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3592":73078,"_30925":73018,"_21431":122288,"_5":14725,"_28112":122152,"_3048":122289},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3592":73079,"_30925":73018,"_21431":122291,"_5":14725,"_28112":122152,"_3048":122292},[],"Campo de `external_webhook_settings`",{"_3592":73080,"_30925":73018,"_21431":122294,"_5":14725,"_28112":122152,"_3048":122212},[],{"_3592":73081,"_30925":73018,"_21431":122296,"_5":14725,"_28112":122152,"_3048":53651},[],{"_3592":73082,"_30925":73018,"_21431":122298,"_5":14725,"_28112":122152,"_3048":122299},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3592":73083,"_30925":73018,"_21431":122301,"_5":14725,"_28112":122152,"_3048":53657},[],{"_3592":73084,"_30925":73018,"_21431":122303,"_5":14725,"_28112":122152,"_3048":122304},[],"`POST` o `PUT`; `POST` por defecto.",{"_3592":73085,"_30925":73018,"_21431":122306,"_5":14725,"_28112":122152,"_3048":53663},[],{"_3592":73086,"_30925":73018,"_21431":122308,"_5":14725,"_28112":122152,"_3048":122309},[],"Etiqueta usada en los logs del servicio.",{"_3592":73087,"_30925":73018,"_21431":122311,"_5":14725,"_28112":122152,"_3048":53669},[],{"_3592":73088,"_30925":73018,"_21431":122313,"_5":14725,"_28112":122152,"_3048":122314},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3592":73089,"_30925":73018,"_21431":122316,"_5":14725,"_28112":122152,"_3048":53675},[],{"_3592":73090,"_30925":73018,"_21431":122318,"_5":14725,"_28112":122152,"_3048":122319},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3592":73091,"_30925":73018,"_21431":122321,"_5":14725,"_28112":122152,"_3048":53681},[],{"_3592":73092,"_30925":73018,"_21431":122323,"_5":14725,"_28112":122152,"_3048":122324},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3592":73093,"_30925":73018,"_21431":122326,"_5":14725,"_28112":122152,"_3048":53687},[],{"_3592":73094,"_30925":73018,"_21431":122328,"_5":14725,"_28112":122152,"_3048":122329},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3592":73095,"_30925":73018,"_21431":122331,"_5":14725,"_28112":122152,"_3048":53693},[],{"_3592":73096,"_30925":73018,"_21431":122333,"_5":14725,"_28112":122152,"_3048":122334},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3592":73097,"_30925":73018,"_21431":122336,"_5":14725,"_28112":122152,"_3048":53699},[],{"_3592":73098,"_30925":73018,"_21431":122338,"_5":14725,"_28112":122152,"_3048":122339},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3592":73099,"_30925":73018,"_21431":122341,"_5":14725,"_28112":122152,"_3048":53705},[],{"_3592":73100,"_30925":73018,"_21431":122343,"_5":14725,"_28112":122152,"_3048":122344},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3592":73101,"_30925":73018,"_21431":122346,"_5":14725,"_28112":122152,"_3048":122347},[],"Reglas de esa configuración:",{"_3592":73102,"_30925":73018,"_21431":122349,"_5":14725,"_28112":122152,"_3048":122350},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3592":73103,"_30925":73018,"_21431":122352,"_5":14725,"_28112":122152,"_3048":122353},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3592":73104,"_30925":73018,"_21431":122355,"_5":14725,"_28112":122152,"_3048":122356},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3592":73105,"_30925":73018,"_21431":122358,"_5":14725,"_28112":122152,"_3048":122359},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3592":73106,"_30925":73018,"_21431":122361,"_5":14725,"_28112":122152,"_3048":122362},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3592":73107,"_30925":73018,"_21431":122364,"_5":14725,"_28112":122152,"_3048":122365},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3592":73108,"_30925":73018,"_21431":122367,"_5":14725,"_28112":122152,"_3048":122368},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3592":73109,"_30925":73018,"_21431":122370,"_5":14725,"_28112":122152,"_3048":122371},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3592":73110,"_30925":73018,"_21431":122373,"_5":14725,"_28112":122152,"_3048":122374},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3592":73111,"_30925":73018,"_21431":122376,"_5":14725,"_28112":122156,"_3048":122377},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3592":73112,"_30925":73018,"_21431":122379,"_5":14725,"_28112":122160,"_3048":122380},[],"Campo de `settings.reenrollment_settings`",{"_3592":73113,"_30925":73018,"_21431":122382,"_5":14725,"_28112":122160,"_3048":122383},[],"Función",{"_3592":73114,"_30925":73018,"_21431":122385,"_5":14725,"_28112":122160,"_3048":53749},[],{"_3592":73115,"_30925":73018,"_21431":122387,"_5":14725,"_28112":122160,"_3048":122388},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3592":73116,"_30925":73018,"_21431":122390,"_5":14725,"_28112":122160,"_3048":53755},[],{"_3592":73117,"_30925":73018,"_21431":122392,"_5":14725,"_28112":122160,"_3048":122393},[],"Umbral operativo preventivo de monitorización.",{"_3592":73118,"_30925":73018,"_21431":122395,"_5":14725,"_28112":122160,"_3048":53761},[],{"_3592":73119,"_30925":73018,"_21431":122397,"_5":14725,"_28112":122160,"_3048":122398},[],"Umbral operativo crítico de monitorización.",{"_3592":73120,"_30925":73018,"_21431":122400,"_5":14725,"_28112":122160,"_3048":53767},[],{"_3592":73121,"_30925":73018,"_21431":122402,"_5":14725,"_28112":122160,"_3048":122403},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3592":73122,"_30925":73018,"_21431":122405,"_5":14725,"_28112":122160,"_3048":53773},[],{"_3592":73123,"_30925":73018,"_21431":122407,"_5":14725,"_28112":122160,"_3048":122408},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3592":73124,"_30925":73018,"_21431":122410,"_5":14725,"_28112":122160,"_3048":53779},[],{"_3592":73125,"_30925":73018,"_21431":122412,"_5":14725,"_28112":122160,"_3048":122413},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3592":73126,"_30925":73018,"_21431":122415,"_5":14725,"_28112":122160,"_3048":122416},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3592":73127,"_30925":73018,"_21431":122418,"_5":14725,"_28112":122164,"_3048":122419},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3592":73128,"_30925":73018,"_21431":122421,"_5":14725,"_28112":122167,"_3048":119607},[],{"_3592":73129,"_30925":73018,"_21431":122423,"_5":14725,"_28112":122167,"_3048":122424},[],"Qué publica",{"_3592":73130,"_30925":73018,"_21431":122426,"_5":14725,"_28112":122167,"_3048":53796},[],{"_3592":73131,"_30925":73018,"_21431":122428,"_5":14725,"_28112":122167,"_3048":122429},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3592":73132,"_30925":73018,"_21431":122431,"_5":14725,"_28112":122167,"_3048":53802},[],{"_3592":73133,"_30925":73018,"_21431":122433,"_5":14725,"_28112":122167,"_3048":122434},[],"Certificado de la CA emisora seleccionada.",{"_3592":73134,"_30925":73018,"_21431":122436,"_5":14725,"_28112":122167,"_3048":53808},[],{"_3592":73135,"_30925":73018,"_21431":122438,"_5":14725,"_28112":122167,"_3048":122439},[],"Certificados de las CAs elegidas explícitamente.",{"_3592":73136,"_30925":73018,"_21431":122441,"_5":14725,"_28112":122167,"_3048":122442},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3592":73137,"_30925":73018,"_21431":122444,"_5":14725,"_28112":122171,"_3048":122445},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3592":73138,"_30925":73018,"_21431":122447,"_5":14725,"_28112":122171,"_3048":122448},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3592":73139,"_30925":73018,"_21431":122450,"_5":14725,"_28112":122171,"_3048":122451},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3592":73140,"_30925":73018,"_21431":122453,"_5":14725,"_28112":122175,"_3048":122454},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3592":73141,"_30925":73141,"_5":15085,"_3048":122456,"_31263":122457,"_21431":122458,"_28112":73141},"Integra el cliente EST",[50505,120709,53189,121854,122029],[],{"_3592":73142,"_30925":73141,"_21431":122460,"_5":14725,"_28112":73141,"_3048":122461},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3592":73143,"_30925":73141,"_5":31260,"_21431":122463,"_28112":122464,"_3048":119243},[],"/docs/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3592":73144,"_30925":73141,"_5":31260,"_21431":122466,"_28112":122467,"_3048":122468},[],"/docs/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3592":73145,"_30925":73141,"_5":31260,"_21431":122470,"_28112":122471,"_3048":122472},[],"/docs/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3592":73146,"_30925":73141,"_5":31260,"_21431":122474,"_28112":122475,"_3048":122476},[],"/docs/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3592":73147,"_30925":73141,"_5":31260,"_21431":122478,"_28112":122479,"_3048":122480},[],"/docs/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3592":73148,"_30925":73141,"_5":31260,"_21431":122482,"_28112":122483,"_3048":122484},[],"/docs/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3592":73149,"_30925":73141,"_21431":122486,"_5":14725,"_28112":73141,"_3048":122487},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3592":73150,"_30925":73141,"_21431":122489,"_5":14725,"_28112":122464,"_3048":122490},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3592":73151,"_30925":73141,"_21431":122492,"_5":14725,"_28112":122464,"_3048":122493},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3592":73152,"_30925":73141,"_21431":122495,"_5":14725,"_28112":122464,"_3048":122496},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3592":73153,"_30925":73141,"_21431":122498,"_5":14725,"_28112":122467,"_3048":122499},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3592":73154,"_30925":73141,"_21431":122501,"_5":14725,"_28112":122467,"_3048":122502},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3592":73155,"_30925":73141,"_21431":122504,"_5":14725,"_28112":122471,"_3048":122505},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3592":73156,"_30925":73141,"_21431":122507,"_5":14725,"_28112":122471,"_3048":122508},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3592":73157,"_30925":73141,"_21431":122510,"_5":14725,"_28112":122475,"_3048":122511},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3592":73158,"_30925":73141,"_21431":122513,"_5":14725,"_28112":122475,"_3048":122514},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3592":73159,"_30925":73141,"_21431":122516,"_5":14725,"_28112":122479,"_3048":122517},[],"Para el caso de una raíz que emite directamente:",{"_3592":73160,"_30925":73141,"_21431":122519,"_5":14725,"_28112":122479,"_3048":122520},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3592":73161,"_30925":73141,"_21431":122522,"_5":14725,"_28112":122479,"_3048":122523},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3592":73162,"_30925":73141,"_21431":122525,"_5":14725,"_28112":122483,"_3048":122526},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3592":73163,"_30925":73163,"_5":15085,"_3048":122528,"_31263":122529,"_21431":122530,"_28112":73163},"Referencia EST",[50505,120709,53189,121854,122029],[],{"_3592":73164,"_30925":73163,"_21431":122532,"_5":14725,"_28112":73163,"_3048":122533},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3592":73165,"_30925":73163,"_5":31260,"_21431":122535,"_28112":122536,"_3048":122537},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3592":73166,"_30925":73163,"_5":31260,"_21431":122539,"_28112":122540,"_3048":23212},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3592":73167,"_30925":73163,"_5":31260,"_21431":122542,"_28112":122543,"_3048":26668},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3592":73168,"_30925":73163,"_5":31260,"_21431":122545,"_28112":122546,"_3048":26675},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3592":73169,"_30925":73163,"_5":31260,"_21431":122548,"_28112":122549,"_3048":25963},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3592":73170,"_30925":73163,"_5":31260,"_21431":122551,"_28112":122552,"_3048":122553},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3592":73171,"_30925":73163,"_5":31260,"_21431":122555,"_28112":122556,"_3048":122557},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3592":73172,"_30925":73163,"_5":31260,"_21431":122559,"_28112":122560,"_3048":122561},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3592":73173,"_30925":73163,"_21431":122563,"_5":14725,"_28112":73163,"_3048":122564},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3592":73174,"_30925":73163,"_21431":122566,"_5":14725,"_28112":122536,"_3048":122567},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3592":73175,"_30925":73163,"_21431":122569,"_5":14725,"_28112":122536,"_3048":120469},[],{"_3592":73176,"_30925":73163,"_21431":122571,"_5":14725,"_28112":122536,"_3048":122572},[],"Método",{"_3592":73177,"_30925":73163,"_21431":122574,"_5":14725,"_28112":122536,"_3048":122575},[],"Autenticación y condición",{"_3592":73178,"_30925":73163,"_21431":122577,"_5":14725,"_28112":122536,"_3048":53951},[],{"_3592":73179,"_30925":73163,"_21431":122579,"_5":14725,"_28112":122536,"_3048":53954},[],{"_3592":73180,"_30925":73163,"_21431":122581,"_5":14725,"_28112":122536,"_3048":122582},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3592":73181,"_30925":73163,"_21431":122584,"_5":14725,"_28112":122536,"_3048":53960},[],{"_3592":73182,"_30925":73163,"_21431":122586,"_5":14725,"_28112":122536,"_3048":53963},[],{"_3592":73183,"_30925":73163,"_21431":122588,"_5":14725,"_28112":122536,"_3048":122589},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3592":73184,"_30925":73163,"_21431":122591,"_5":14725,"_28112":122536,"_3048":53969},[],{"_3592":73185,"_30925":73163,"_21431":122593,"_5":14725,"_28112":122536,"_3048":53963},[],{"_3592":73186,"_30925":73163,"_21431":122595,"_5":14725,"_28112":122536,"_3048":122596},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3592":73187,"_30925":73163,"_21431":122598,"_5":14725,"_28112":122536,"_3048":53977},[],{"_3592":73188,"_30925":73163,"_21431":122600,"_5":14725,"_28112":122536,"_3048":53963},[],{"_3592":73189,"_30925":73163,"_21431":122602,"_5":14725,"_28112":122536,"_3048":122603},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3592":73190,"_30925":73163,"_21431":122605,"_5":14725,"_28112":122536,"_3048":122606},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3592":73191,"_30925":73163,"_21431":122608,"_5":14725,"_28112":122540,"_3048":122609},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3592":73192,"_30925":73163,"_21431":122611,"_5":14725,"_28112":122540,"_3048":122612},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3592":73193,"_30925":73163,"_21431":122614,"_5":14725,"_28112":122543,"_3048":122615},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3592":73194,"_30925":73163,"_21431":122617,"_5":14725,"_28112":122543,"_3048":122618},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3592":73195,"_30925":73163,"_21431":122620,"_5":14725,"_28112":122546,"_3048":122621},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3592":73196,"_30925":73163,"_21431":122623,"_5":14725,"_28112":122546,"_3048":122624},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3592":73197,"_30925":73163,"_21431":122626,"_5":14725,"_28112":122549,"_3048":122627},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3592":73198,"_30925":73163,"_21431":122629,"_5":14725,"_28112":122549,"_3048":122630},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3592":73199,"_30925":73163,"_21431":122632,"_5":14725,"_28112":122552,"_3048":122633},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3592":73200,"_30925":73163,"_21431":122635,"_5":14725,"_28112":122552,"_3048":122636},[],"Parte",{"_3592":73201,"_30925":73163,"_21431":122638,"_5":14725,"_28112":122552,"_3048":122639},[],"Contenido tras decodificar su Base64",{"_3592":73202,"_30925":73163,"_21431":122641,"_5":14725,"_28112":122552,"_3048":54021},[],{"_3592":73203,"_30925":73163,"_21431":122643,"_5":14725,"_28112":122552,"_3048":122644},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3592":73204,"_30925":73163,"_21431":122646,"_5":14725,"_28112":122552,"_3048":54027},[],{"_3592":73205,"_30925":73163,"_21431":122648,"_5":14725,"_28112":122552,"_3048":122649},[],"PKCS#7 DER con el certificado emitido.",{"_3592":73206,"_30925":73163,"_21431":122651,"_5":14725,"_28112":122552,"_3048":122652},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3592":73207,"_30925":73163,"_21431":122654,"_5":14725,"_28112":122556,"_3048":122655},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3592":73208,"_30925":73163,"_21431":122657,"_5":14725,"_28112":122556,"_3048":122658},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3592":73209,"_30925":73163,"_21431":122660,"_5":14725,"_28112":122556,"_3048":122661},[],"Convierte y comprueba el resultado:",{"_3592":73210,"_30925":73163,"_21431":122663,"_5":14725,"_28112":122556,"_3048":122664},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3592":73211,"_30925":73163,"_21431":122666,"_5":14725,"_28112":122560,"_3048":122667},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3592":73212,"_30925":73163,"_21431":122669,"_5":14725,"_28112":122560,"_3048":122670},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3592":73213,"_30925":73213,"_5":15085,"_3048":122029,"_31263":122672,"_21431":122673,"_28112":73213},[50505,120709,53189,121854,122029],[],{"_3592":73214,"_30925":73213,"_21431":122675,"_5":14725,"_28112":73213,"_3048":122676},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3592":73215,"_30925":73213,"_5":31260,"_21431":122678,"_28112":122679,"_3048":122680},[],"/docs/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3592":73216,"_30925":73213,"_5":31260,"_21431":122682,"_28112":122683,"_3048":122684},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3592":73217,"_30925":73213,"_5":31260,"_21431":122686,"_28112":122687,"_3048":122688},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3592":73218,"_30925":73213,"_5":31260,"_21431":122690,"_28112":122691,"_3048":122692},[],"/docs/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3592":73219,"_30925":73213,"_21431":122694,"_5":14725,"_28112":73213,"_3048":122695},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3592":73220,"_30925":73213,"_21431":122697,"_5":14725,"_28112":122679,"_3048":122698},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3592":73221,"_30925":73213,"_21431":122700,"_5":14725,"_28112":122679,"_3048":122701},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3592":73222,"_30925":73213,"_21431":122703,"_5":14725,"_28112":122679,"_3048":122704},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3592":73223,"_30925":73213,"_21431":122706,"_5":14725,"_28112":122679,"_3048":122707},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3592":73224,"_30925":73213,"_21431":122709,"_5":14725,"_28112":122679,"_3048":122710},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3592":73225,"_30925":73213,"_21431":122712,"_5":14725,"_28112":122679,"_3048":122713},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3592":73226,"_30925":73213,"_21431":122715,"_5":14725,"_28112":122683,"_3048":122716},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3592":73227,"_30925":73213,"_21431":122718,"_5":14725,"_28112":122683,"_3048":122719},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3592":73228,"_30925":73213,"_21431":122721,"_5":14725,"_28112":122683,"_3048":122722},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3592":73229,"_30925":73213,"_21431":122724,"_5":14725,"_28112":122683,"_3048":122725},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3592":73230,"_30925":73213,"_21431":122727,"_5":14725,"_28112":122687,"_3048":122728},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3592":73231,"_30925":73213,"_21431":122730,"_5":14725,"_28112":122687,"_3048":122731},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3592":73232,"_30925":73213,"_21431":122733,"_5":14725,"_28112":122687,"_3048":122734},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3592":73233,"_30925":73213,"_21431":122736,"_5":14725,"_28112":122687,"_3048":122737},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3592":73234,"_30925":73213,"_21431":122739,"_5":14725,"_28112":122691,"_3048":122740},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3592":73235,"_30925":73213,"_21431":122742,"_5":14725,"_28112":122691,"_3048":122743},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3592":73236,"_30925":73236,"_5":15085,"_3048":122745,"_31263":122746,"_21431":122747,"_28112":73236},"Estrategias de aprovisionamiento",[50505,120709,53189,121854,122029],[],{"_3592":73237,"_30925":73236,"_21431":122749,"_5":14725,"_28112":73236,"_3048":122750},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3592":73238,"_30925":73236,"_5":31260,"_21431":122752,"_28112":122753,"_3048":122754},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3592":73239,"_30925":73236,"_5":31260,"_21431":122756,"_28112":122757,"_3048":122758},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3592":73240,"_30925":73236,"_5":31260,"_21431":122760,"_28112":122761,"_3048":122762},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3592":73241,"_30925":73236,"_5":31260,"_21431":122764,"_28112":122765,"_3048":122766},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3592":73242,"_30925":73236,"_5":31260,"_21431":122768,"_28112":122769,"_3048":122770},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3592":73243,"_30925":73236,"_21431":122772,"_5":14725,"_28112":73236,"_3048":122773},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3592":73244,"_30925":73236,"_21431":122775,"_5":14725,"_28112":122753,"_3048":122776},[],"Recorrido",{"_3592":73245,"_30925":73236,"_21431":122778,"_5":14725,"_28112":122753,"_3048":122779},[],"Cuándo existe el dispositivo",{"_3592":73246,"_30925":73236,"_21431":122781,"_5":14725,"_28112":122753,"_3048":122782},[],"Qué compruebas",{"_3592":73247,"_30925":73236,"_21431":122784,"_5":14725,"_28112":122753,"_3048":122785},[],"Asignación manual",{"_3592":73248,"_30925":73236,"_21431":122787,"_5":14725,"_28112":122753,"_3048":122788},[],"El operador lo crea antes de asociar un certificado.",{"_3592":73249,"_30925":73236,"_21431":122790,"_5":14725,"_28112":122753,"_3048":122791},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3592":73250,"_30925":73236,"_21431":122793,"_5":14725,"_28112":122753,"_3048":122794},[],"EST con `JITP`",{"_3592":73251,"_30925":73236,"_21431":122796,"_5":14725,"_28112":122753,"_3048":122797},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3592":73252,"_30925":73236,"_21431":122799,"_5":14725,"_28112":122753,"_3048":122800},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3592":73253,"_30925":73236,"_21431":122802,"_5":14725,"_28112":122753,"_3048":122803},[],"EST con `PRE_REGISTRATION`",{"_3592":73254,"_30925":73236,"_21431":122805,"_5":14725,"_28112":122753,"_3048":122806},[],"Debe existir antes de `/simpleenroll`.",{"_3592":73255,"_30925":73236,"_21431":122808,"_5":14725,"_28112":122753,"_3048":122809},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3592":73256,"_30925":73236,"_21431":122811,"_5":14725,"_28112":122753,"_3048":122812},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3592":73257,"_30925":73236,"_21431":122814,"_5":14725,"_28112":122753,"_3048":122815},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3592":73258,"_30925":73236,"_21431":122817,"_5":14725,"_28112":122757,"_3048":122818},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3592":73259,"_30925":73236,"_21431":122820,"_5":14725,"_28112":122757,"_3048":122821},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3592":73260,"_30925":73236,"_21431":122823,"_5":14725,"_28112":122757,"_3048":122824},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3592":73261,"_30925":73236,"_21431":122826,"_5":14725,"_28112":122761,"_3048":122827},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3592":73262,"_30925":73236,"_21431":122829,"_5":14725,"_28112":122761,"_3048":122830},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3592":73263,"_30925":73236,"_21431":122832,"_5":14725,"_28112":122761,"_3048":122833},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3592":73264,"_30925":73236,"_21431":122835,"_5":14725,"_28112":122761,"_3048":122836},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3592":73265,"_30925":73236,"_21431":122838,"_5":14725,"_28112":122761,"_3048":122839},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3592":73266,"_30925":73236,"_21431":122841,"_5":14725,"_28112":122761,"_3048":122842},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3592":73267,"_30925":73236,"_21431":122844,"_5":14725,"_28112":122765,"_3048":119607},[],{"_3592":73268,"_30925":73236,"_21431":122846,"_5":14725,"_28112":122765,"_3048":122847},[],"Material que atraviesa EST",{"_3592":73269,"_30925":73236,"_21431":122849,"_5":14725,"_28112":122765,"_3048":122850},[],"Clave generada por el dispositivo",{"_3592":73270,"_30925":73236,"_21431":122852,"_5":14725,"_28112":122765,"_3048":122853},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3592":73271,"_30925":73236,"_21431":122855,"_5":14725,"_28112":122765,"_3048":122856},[],"Clave ya disponible en el dispositivo",{"_3592":73272,"_30925":73236,"_21431":122858,"_5":14725,"_28112":122765,"_3048":122859},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3592":73273,"_30925":73236,"_21431":122861,"_5":14725,"_28112":122765,"_3048":53508},[],{"_3592":73274,"_30925":73236,"_21431":122863,"_5":14725,"_28112":122765,"_3048":122864},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3592":73275,"_30925":73236,"_21431":122866,"_5":14725,"_28112":122765,"_3048":122867},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3592":73276,"_30925":73236,"_21431":122869,"_5":14725,"_28112":122769,"_3048":122870},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3592":73277,"_30925":73277,"_5":15085,"_3048":122872,"_31263":122873,"_21431":122874,"_28112":73277},"Renovación y recuperación",[50505,120709,53189,121854,122029],[],{"_3592":73278,"_30925":73277,"_21431":122876,"_5":14725,"_28112":73277,"_3048":122877},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3592":73279,"_30925":73277,"_5":31260,"_21431":122879,"_28112":122880,"_3048":122881},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3592":73280,"_30925":73277,"_5":31260,"_21431":122883,"_28112":122884,"_3048":122885},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3592":73281,"_30925":73277,"_5":31260,"_21431":122887,"_28112":122888,"_3048":122889},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3592":73282,"_30925":73277,"_5":31260,"_21431":122891,"_28112":122892,"_3048":122893},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3592":73283,"_30925":73277,"_5":31260,"_21431":122895,"_28112":122896,"_3048":122897},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3592":73284,"_30925":73277,"_21431":122899,"_5":14725,"_28112":73277,"_3048":122900},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3592":73285,"_30925":73277,"_21431":122902,"_5":14725,"_28112":122880,"_3048":122903},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3592":73286,"_30925":73277,"_21431":122905,"_5":14725,"_28112":122880,"_3048":122906},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3592":73287,"_30925":73277,"_21431":122908,"_5":14725,"_28112":122880,"_3048":122909},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3592":73288,"_30925":73277,"_21431":122911,"_5":14725,"_28112":122880,"_3048":122912},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3592":73289,"_30925":73277,"_21431":122914,"_5":14725,"_28112":122884,"_3048":122915},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3592":73290,"_30925":73277,"_21431":122917,"_5":14725,"_28112":122884,"_3048":122918},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3592":73291,"_30925":73277,"_21431":122920,"_5":14725,"_28112":122888,"_3048":122921},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3592":73292,"_30925":73277,"_21431":122923,"_5":14725,"_28112":122888,"_3048":122924},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3592":73293,"_30925":73277,"_21431":122926,"_5":14725,"_28112":122888,"_3048":122927},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3592":73294,"_30925":73277,"_21431":122929,"_5":14725,"_28112":122892,"_3048":122930},[],"Situación",{"_3592":73295,"_30925":73277,"_21431":122932,"_5":14725,"_28112":122892,"_3048":122933},[],"Procedimiento",{"_3592":73296,"_30925":73277,"_21431":122935,"_5":14725,"_28112":122892,"_3048":122936},[],"Certificado vigente, fuera de ventana",{"_3592":73297,"_30925":73277,"_21431":122938,"_5":14725,"_28112":122892,"_3048":122939},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3592":73298,"_30925":73277,"_21431":122941,"_5":14725,"_28112":122892,"_3048":122942},[],"Certificado vencido, clave disponible",{"_3592":73299,"_30925":73277,"_21431":122944,"_5":14725,"_28112":122892,"_3048":122945},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3592":73300,"_30925":73277,"_21431":122947,"_5":14725,"_28112":122892,"_3048":122948},[],"Renovación por webhook o `NO_AUTH`",{"_3592":73301,"_30925":73277,"_21431":122950,"_5":14725,"_28112":122892,"_3048":122951},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3592":73302,"_30925":73277,"_21431":122953,"_5":14725,"_28112":122892,"_3048":122954},[],"Clave perdida o inaccesible",{"_3592":73303,"_30925":73277,"_21431":122956,"_5":14725,"_28112":122892,"_3048":122957},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3592":73304,"_30925":73277,"_21431":122959,"_5":14725,"_28112":122892,"_3048":122960},[],"Identidad actual revocada",{"_3592":73305,"_30925":73277,"_21431":122962,"_5":14725,"_28112":122892,"_3048":122963},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3592":73306,"_30925":73277,"_21431":122965,"_5":14725,"_28112":122892,"_3048":122966},[],"Dispositivo sin identidad",{"_3592":73307,"_30925":73277,"_21431":122968,"_5":14725,"_28112":122892,"_3048":122969},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3592":73308,"_30925":73277,"_21431":122971,"_5":14725,"_28112":122892,"_3048":122972},[],"Dispositivo retirado",{"_3592":73309,"_30925":73277,"_21431":122974,"_5":14725,"_28112":122892,"_3048":122975},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3592":73310,"_30925":73277,"_21431":122977,"_5":14725,"_28112":122892,"_3048":122978},[],"Timeout, HTTP 500 o fallo de instalación",{"_3592":73311,"_30925":73277,"_21431":122980,"_5":14725,"_28112":122892,"_3048":122981},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3592":73312,"_30925":73277,"_21431":122983,"_5":14725,"_28112":122896,"_3048":122984},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3592":73313,"_30925":73277,"_21431":122986,"_5":14725,"_28112":122896,"_3048":122987},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3592":73314,"_30925":73314,"_5":15085,"_3048":122989,"_31263":122990,"_21431":122991,"_28112":73314},"Diagnóstico de enrolamiento",[50505,120709,53189,121854,122029],[],{"_3592":73315,"_30925":73314,"_21431":122993,"_5":14725,"_28112":73314,"_3048":122994},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3592":73316,"_30925":73314,"_5":31260,"_21431":122996,"_28112":122997,"_3048":122998},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3592":73317,"_30925":73314,"_5":31260,"_21431":123000,"_28112":123001,"_3048":123002},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3592":73318,"_30925":73314,"_5":31260,"_21431":123004,"_28112":123005,"_3048":122561},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3592":73319,"_30925":73314,"_5":31260,"_21431":123007,"_28112":123008,"_3048":123009},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3592":73320,"_30925":73314,"_21431":123011,"_5":14725,"_28112":73314,"_3048":123012},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3592":73321,"_30925":73314,"_21431":123014,"_5":14725,"_28112":123001,"_3048":123015},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3592":73322,"_30925":73314,"_21431":123017,"_5":14725,"_28112":123001,"_3048":123018},[],"Síntoma o mensaje",{"_3592":73323,"_30925":73314,"_21431":123020,"_5":14725,"_28112":123001,"_3048":123021},[],"Qué revisar",{"_3592":73324,"_30925":73314,"_21431":123023,"_5":14725,"_28112":123001,"_3048":123024},[],"curl rechaza TLS, nombre o emisor",{"_3592":73325,"_30925":73314,"_21431":123026,"_5":14725,"_28112":123001,"_3048":123027},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3592":73326,"_30925":73314,"_21431":123029,"_5":14725,"_28112":123001,"_3048":123030},[],"404 o APS ausente",{"_3592":73327,"_30925":73314,"_21431":123032,"_5":14725,"_28112":123001,"_3048":123033},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3592":73328,"_30925":73314,"_21431":123035,"_5":14725,"_28112":123001,"_3048":123036},[],"400, error de CSR o formato",{"_3592":73329,"_30925":73314,"_21431":123038,"_5":14725,"_28112":123001,"_3048":123039},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3592":73330,"_30925":73314,"_21431":123041,"_5":14725,"_28112":123001,"_3048":123042},[],"Credencial ausente o certificado no válido",{"_3592":73331,"_30925":73314,"_21431":123044,"_5":14725,"_28112":123001,"_3048":123045},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3592":73332,"_30925":73314,"_21431":123047,"_5":14725,"_28112":123001,"_3048":123048},[],"Webhook deniega, expira o responde sin autorización",{"_3592":73333,"_30925":73314,"_21431":123050,"_5":14725,"_28112":123001,"_3048":123051},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3592":73334,"_30925":73314,"_21431":123053,"_5":14725,"_28112":123001,"_3048":54434},[],{"_3592":73335,"_30925":73314,"_21431":123055,"_5":14725,"_28112":123001,"_3048":123056},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3592":73336,"_30925":73314,"_21431":123058,"_5":14725,"_28112":123001,"_3048":54440},[],{"_3592":73337,"_30925":73314,"_21431":123060,"_5":14725,"_28112":123001,"_3048":123061},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3592":73338,"_30925":73314,"_21431":123063,"_5":14725,"_28112":123001,"_3048":54446},[],{"_3592":73339,"_30925":73314,"_21431":123065,"_5":14725,"_28112":123001,"_3048":123066},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3592":73340,"_30925":73314,"_21431":123068,"_5":14725,"_28112":123001,"_3048":54452},[],{"_3592":73341,"_30925":73314,"_21431":123070,"_5":14725,"_28112":123001,"_3048":123071},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3592":73342,"_30925":73314,"_21431":123073,"_5":14725,"_28112":123001,"_3048":54458},[],{"_3592":73343,"_30925":73314,"_21431":123075,"_5":14725,"_28112":123001,"_3048":123076},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3592":73344,"_30925":73314,"_21431":123078,"_5":14725,"_28112":123001,"_3048":123079},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3592":73345,"_30925":73314,"_21431":123081,"_5":14725,"_28112":123001,"_3048":123082},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3592":73346,"_30925":73314,"_21431":123084,"_5":14725,"_28112":123001,"_3048":123085},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3592":73347,"_30925":73314,"_21431":123087,"_5":14725,"_28112":123001,"_3048":123088},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3592":73348,"_30925":73314,"_21431":123090,"_5":14725,"_28112":123001,"_3048":54476},[],{"_3592":73349,"_30925":73314,"_21431":123092,"_5":14725,"_28112":123001,"_3048":123093},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3592":73350,"_30925":73314,"_21431":123095,"_5":14725,"_28112":123001,"_3048":54482},[],{"_3592":73351,"_30925":73314,"_21431":123097,"_5":14725,"_28112":123001,"_3048":123098},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3592":73352,"_30925":73314,"_21431":123100,"_5":14725,"_28112":123001,"_3048":123101},[],"DMS propietario distinto",{"_3592":73353,"_30925":73314,"_21431":123103,"_5":14725,"_28112":123001,"_3048":123104},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3592":73354,"_30925":73314,"_21431":123106,"_5":14725,"_28112":123001,"_3048":54494},[],{"_3592":73355,"_30925":73314,"_21431":123108,"_5":14725,"_28112":123001,"_3048":123109},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3592":73356,"_30925":73314,"_21431":123111,"_5":14725,"_28112":123001,"_3048":54500},[],{"_3592":73357,"_30925":73314,"_21431":123113,"_5":14725,"_28112":123001,"_3048":123114},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3592":73358,"_30925":73314,"_21431":123116,"_5":14725,"_28112":123001,"_3048":123117},[],"Certificado actual revocado",{"_3592":73359,"_30925":73314,"_21431":123119,"_5":14725,"_28112":123001,"_3048":123120},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3592":73360,"_30925":73314,"_21431":123122,"_5":14725,"_28112":123001,"_3048":123123},[],"Error de CA, perfil o firma",{"_3592":73361,"_30925":73314,"_21431":123125,"_5":14725,"_28112":123001,"_3048":123126},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3592":73362,"_30925":73314,"_21431":123128,"_5":14725,"_28112":123001,"_3048":123129},[],"HTTP 200 sin conexión del dispositivo",{"_3592":73363,"_30925":73314,"_21431":123131,"_5":14725,"_28112":123001,"_3048":123132},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3592":73364,"_30925":73314,"_21431":123134,"_5":14725,"_28112":123001,"_3048":123135},[],"Timeout o error después de emitir",{"_3592":73365,"_30925":73314,"_21431":123137,"_5":14725,"_28112":123001,"_3048":123138},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3592":73366,"_30925":73314,"_21431":123140,"_5":14725,"_28112":123005,"_3048":123141},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3592":73367,"_30925":73314,"_21431":123143,"_5":14725,"_28112":123005,"_3048":123144},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3592":73368,"_30925":73314,"_21431":123146,"_5":14725,"_28112":123008,"_3048":123147},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3592":73369,"_30925":73314,"_21431":123149,"_5":14725,"_28112":123008,"_3048":123150},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3592":73370,"_30925":73314,"_21431":123152,"_5":14725,"_28112":123008,"_3048":123153},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3592":73371,"_30925":73314,"_21431":123155,"_5":14725,"_28112":123008,"_3048":123156},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3592":73372,"_30925":73314,"_21431":123158,"_5":14725,"_28112":123008,"_3048":123159},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3592":73373,"_30925":73314,"_21431":123161,"_5":14725,"_28112":123008,"_3048":123162},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3592":73374,"_30925":73314,"_21431":123164,"_5":14725,"_28112":123008,"_3048":123165},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3592":73375,"_30925":73375,"_5":15085,"_3048":123167,"_31263":123168,"_21431":123169,"_28112":73375},"Distribución y actualización de confianza",[50505,120709,53189,121854,122029],[],{"_3592":73376,"_30925":73375,"_21431":123171,"_5":14725,"_28112":73375,"_3048":123172},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3592":73377,"_30925":73375,"_5":31260,"_21431":123174,"_28112":123175,"_3048":123176},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3592":73378,"_30925":73375,"_5":31260,"_21431":123178,"_28112":123179,"_3048":123180},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3592":73379,"_30925":73375,"_5":31260,"_21431":123182,"_28112":123183,"_3048":123184},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3592":73380,"_30925":73375,"_5":31260,"_21431":123186,"_28112":123187,"_3048":123188},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3592":73381,"_30925":73375,"_5":31260,"_21431":123190,"_28112":123191,"_3048":123192},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3592":73382,"_30925":73375,"_21431":123194,"_5":14725,"_28112":73375,"_3048":123195},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3592":73383,"_30925":73375,"_21431":123197,"_5":14725,"_28112":123175,"_3048":123198},[],"Relación",{"_3592":73384,"_30925":73375,"_21431":123200,"_5":14725,"_28112":123175,"_3048":123201},[],"Material que prepara el responsable",{"_3592":73385,"_30925":73375,"_21431":123203,"_5":14725,"_28112":123175,"_3048":123204},[],"Dispositivo → servidor EST",{"_3592":73386,"_30925":73375,"_21431":123206,"_5":14725,"_28112":123175,"_3048":123207},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3592":73387,"_30925":73375,"_21431":123209,"_5":14725,"_28112":123175,"_3048":123210},[],"DMS → solicitante",{"_3592":73388,"_30925":73375,"_21431":123212,"_5":14725,"_28112":123175,"_3048":123213},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3592":73389,"_30925":73375,"_21431":123215,"_5":14725,"_28112":123175,"_3048":123216},[],"Consumidor → dispositivo",{"_3592":73390,"_30925":73375,"_21431":123218,"_5":14725,"_28112":123175,"_3048":123219},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3592":73391,"_30925":73375,"_21431":123221,"_5":14725,"_28112":123175,"_3048":123222},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3592":73392,"_30925":73375,"_21431":123224,"_5":14725,"_28112":123179,"_3048":123225},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3592":73393,"_30925":73375,"_21431":123227,"_5":14725,"_28112":123179,"_3048":123228},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3592":73394,"_30925":73375,"_21431":123230,"_5":14725,"_28112":123183,"_3048":123231},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3592":73395,"_30925":73375,"_21431":123233,"_5":14725,"_28112":123183,"_3048":123234},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3592":73396,"_30925":73375,"_21431":123236,"_5":14725,"_28112":123183,"_3048":123237},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3592":73397,"_30925":73375,"_21431":123239,"_5":14725,"_28112":123183,"_3048":123240},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3592":73398,"_30925":73375,"_21431":123242,"_5":14725,"_28112":123183,"_3048":123243},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3592":73399,"_30925":73375,"_21431":123245,"_5":14725,"_28112":123183,"_3048":123246},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3592":73400,"_30925":73375,"_21431":123248,"_5":14725,"_28112":123187,"_3048":123249},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3592":73401,"_30925":73375,"_21431":123251,"_5":14725,"_28112":123187,"_3048":123252},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3592":73402,"_30925":73375,"_21431":123254,"_5":14725,"_28112":123187,"_3048":123255},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3592":73403,"_30925":73375,"_21431":123257,"_5":14725,"_28112":123191,"_3048":123258},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3592":73404,"_30925":73404,"_5":15085,"_3048":54649,"_31263":123260,"_21431":123262,"_28112":73404},[50505,120709,53189,121854,123261],"Integraciones",[],{"_3592":73405,"_30925":73404,"_21431":123264,"_5":14725,"_28112":73404,"_3048":123265},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3592":73406,"_30925":73404,"_5":31260,"_21431":123267,"_28112":123268,"_3048":123269},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3592":73407,"_30925":73404,"_5":31260,"_21431":123271,"_28112":123272,"_3048":123273},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3592":73408,"_30925":73404,"_5":31260,"_21431":123275,"_28112":123276,"_3048":123277},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3592":73409,"_30925":73404,"_5":31260,"_21431":123279,"_28112":123280,"_3048":123281},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3592":73410,"_30925":73404,"_5":31260,"_21431":123283,"_28112":123284,"_3048":123285},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3592":73411,"_30925":73404,"_5":31260,"_21431":123287,"_28112":123288,"_3048":123289},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3592":73412,"_30925":73404,"_5":31260,"_21431":123291,"_28112":123292,"_3048":123293},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3592":73413,"_30925":73404,"_5":31260,"_21431":123295,"_28112":123296,"_3048":123297},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3592":73414,"_30925":73404,"_5":31260,"_21431":123299,"_28112":123300,"_3048":54691},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3592":73415,"_30925":73404,"_5":31260,"_21431":123302,"_28112":123303,"_3048":54695},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3592":73416,"_30925":73404,"_5":31260,"_21431":123305,"_28112":123306,"_3048":123307},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3592":73417,"_30925":73404,"_5":31260,"_21431":123309,"_28112":123310,"_3048":123311},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3592":73418,"_30925":73404,"_5":31260,"_21431":123313,"_28112":123314,"_3048":123315},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3592":73419,"_30925":73404,"_5":31260,"_21431":123317,"_28112":123318,"_3048":123319},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3592":73420,"_30925":73404,"_5":31260,"_21431":123321,"_28112":123322,"_3048":123323},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3592":73421,"_30925":73404,"_5":31260,"_21431":123325,"_28112":123326,"_3048":123327},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3592":73422,"_30925":73404,"_5":31260,"_21431":123329,"_28112":123330,"_3048":123331},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3592":73423,"_30925":73404,"_5":31260,"_21431":123333,"_28112":123334,"_3048":123335},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3592":73424,"_30925":73404,"_5":31260,"_21431":123337,"_28112":123338,"_3048":123339},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3592":73425,"_30925":73404,"_5":31260,"_21431":123341,"_28112":123342,"_3048":123343},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3592":73426,"_30925":73404,"_5":31260,"_21431":123345,"_28112":123346,"_3048":123347},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3592":73427,"_30925":73404,"_5":31260,"_21431":123349,"_28112":123350,"_3048":123351},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3592":73428,"_30925":73404,"_5":31260,"_21431":123353,"_28112":123354,"_3048":123355},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3592":73429,"_30925":73404,"_5":31260,"_21431":123357,"_28112":123358,"_3048":123359},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3592":73430,"_30925":73404,"_5":31260,"_21431":123361,"_28112":123362,"_3048":123363},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3592":73431,"_30925":73404,"_21431":123365,"_5":14725,"_28112":73404,"_3048":123366},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3592":73432,"_30925":73404,"_21431":123368,"_5":14725,"_28112":73404,"_3048":123369},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3592":73433,"_30925":73404,"_21431":123371,"_5":14725,"_28112":73404,"_3048":123372},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3592":73434,"_30925":73404,"_21431":123374,"_5":14725,"_28112":123268,"_3048":123375},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3592":73435,"_30925":73404,"_21431":123377,"_5":14725,"_28112":123268,"_3048":123378},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3592":73436,"_30925":73404,"_21431":123380,"_5":14725,"_28112":123268,"_3048":123381},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3592":73437,"_30925":73404,"_21431":123383,"_5":14725,"_28112":123268,"_3048":123384},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3592":73438,"_30925":73404,"_21431":123386,"_5":14725,"_28112":123272,"_3048":123387},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3592":73439,"_30925":73404,"_21431":123389,"_5":14725,"_28112":123276,"_3048":123390},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3592":73440,"_30925":73404,"_21431":123392,"_5":14725,"_28112":123276,"_3048":123393},[],"Acción IAM",{"_3592":73441,"_30925":73404,"_21431":123395,"_5":14725,"_28112":123276,"_3048":119613},[],{"_3592":73442,"_30925":73404,"_21431":123397,"_5":14725,"_28112":123276,"_3048":54790},[],{"_3592":73443,"_30925":73404,"_21431":123399,"_5":14725,"_28112":123276,"_3048":123400},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3592":73444,"_30925":73404,"_21431":123402,"_5":14725,"_28112":123276,"_3048":54796},[],{"_3592":73445,"_30925":73404,"_21431":123404,"_5":14725,"_28112":123276,"_3048":123405},[],"Registrar la CA en AWS IoT",{"_3592":73446,"_30925":73404,"_21431":123407,"_5":14725,"_28112":123276,"_3048":54802},[],{"_3592":73447,"_30925":73404,"_21431":123409,"_5":14725,"_28112":123276,"_3048":123410},[],"Consultar el estado del registro de la CA",{"_3592":73448,"_30925":73404,"_21431":123412,"_5":14725,"_28112":123276,"_3048":54808},[],{"_3592":73449,"_30925":73404,"_21431":123414,"_5":14725,"_28112":123276,"_3048":123415},[],"Crear o actualizar Things en IoT Core",{"_3592":73450,"_30925":73404,"_21431":123417,"_5":14725,"_28112":123276,"_3048":54814},[],{"_3592":73451,"_30925":73404,"_21431":123419,"_5":14725,"_28112":123276,"_3048":123420},[],"Aprovisionar Things mediante plantilla",{"_3592":73452,"_30925":73404,"_21431":123422,"_5":14725,"_28112":123276,"_3048":54820},[],{"_3592":73453,"_30925":73404,"_21431":123424,"_5":14725,"_28112":123276,"_3048":123425},[],"Registrar certificados de dispositivo",{"_3592":73454,"_30925":73404,"_21431":123427,"_5":14725,"_28112":123276,"_3048":54826},[],{"_3592":73455,"_30925":73404,"_21431":123429,"_5":14725,"_28112":123276,"_3048":123430},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3592":73456,"_30925":73404,"_21431":123432,"_5":14725,"_28112":123276,"_3048":54832},[],{"_3592":73457,"_30925":73404,"_21431":123434,"_5":14725,"_28112":123276,"_3048":123435},[],"Crear y adjuntar políticas IoT",{"_3592":73458,"_30925":73404,"_21431":123437,"_5":14725,"_28112":123276,"_3048":54838},[],{"_3592":73459,"_30925":73404,"_21431":123439,"_5":14725,"_28112":123276,"_3048":123440},[],"Gestionar grupos de Things",{"_3592":73460,"_30925":73404,"_21431":123442,"_5":14725,"_28112":123276,"_3048":54844},[],{"_3592":73461,"_30925":73404,"_21431":123444,"_5":14725,"_28112":123276,"_3048":123445},[],"Crear plantillas JITP",{"_3592":73462,"_30925":73404,"_21431":123447,"_5":14725,"_28112":123276,"_3048":54850},[],{"_3592":73463,"_30925":73404,"_21431":123449,"_5":14725,"_28112":123276,"_3048":123450},[],"Leer y escribir el Device Shadow",{"_3592":73464,"_30925":73404,"_21431":123452,"_5":14725,"_28112":123276,"_3048":123453},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3592":73465,"_30925":73404,"_21431":123455,"_5":14725,"_28112":123280,"_3048":123456},[],"Parámetro",{"_3592":73466,"_30925":73404,"_21431":123458,"_5":14725,"_28112":123280,"_3048":123459},[],"Tipo",{"_3592":73467,"_30925":73404,"_21431":123461,"_5":14725,"_28112":123280,"_3048":123462},[],"Requerido",{"_3592":73468,"_30925":73404,"_21431":123464,"_5":14725,"_28112":123280,"_3048":123465},[],"Descripción",{"_3592":73469,"_30925":73404,"_21431":123467,"_5":14725,"_28112":123280,"_3048":54871},[],{"_3592":73470,"_30925":73404,"_21431":123469,"_5":14725,"_28112":123280,"_3048":25573},[],{"_3592":73471,"_30925":73404,"_21431":123471,"_5":14725,"_28112":123280,"_3048":123472},[],"Sí",{"_3592":73472,"_30925":73404,"_21431":123474,"_5":14725,"_28112":123280,"_3048":123475},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3592":73473,"_30925":73404,"_21431":123477,"_5":14725,"_28112":123280,"_3048":54882},[],{"_3592":73474,"_30925":73404,"_21431":123479,"_5":14725,"_28112":123280,"_3048":25573},[],{"_3592":73475,"_30925":73404,"_21431":123481,"_5":14725,"_28112":123280,"_3048":123472},[],{"_3592":73476,"_30925":73404,"_21431":123483,"_5":14725,"_28112":123280,"_3048":123484},[],"Región AWS donde opera el conector.",{"_3592":73477,"_30925":73404,"_21431":123486,"_5":14725,"_28112":123280,"_3048":54892},[],{"_3592":73478,"_30925":73404,"_21431":123488,"_5":14725,"_28112":123280,"_3048":25573},[],{"_3592":73479,"_30925":73404,"_21431":123490,"_5":14725,"_28112":123280,"_3048":123472},[],{"_3592":73480,"_30925":73404,"_21431":123492,"_5":14725,"_28112":123280,"_3048":123493},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3592":73481,"_30925":73404,"_21431":123495,"_5":14725,"_28112":123280,"_3048":54902},[],{"_3592":73482,"_30925":73404,"_21431":123497,"_5":14725,"_28112":123280,"_3048":25573},[],{"_3592":73483,"_30925":73404,"_21431":123499,"_5":14725,"_28112":123280,"_3048":123500},[],"Solo con `auth_method=static`",{"_3592":73484,"_30925":73404,"_21431":123502,"_5":14725,"_28112":123280,"_3048":123503},[],"Clave de acceso AWS.",{"_3592":73485,"_30925":73404,"_21431":123505,"_5":14725,"_28112":123280,"_3048":54913},[],{"_3592":73486,"_30925":73404,"_21431":123507,"_5":14725,"_28112":123280,"_3048":25573},[],{"_3592":73487,"_30925":73404,"_21431":123509,"_5":14725,"_28112":123280,"_3048":123500},[],{"_3592":73488,"_30925":73404,"_21431":123511,"_5":14725,"_28112":123280,"_3048":123512},[],"Clave secreta AWS.",{"_3592":73489,"_30925":73404,"_21431":123514,"_5":14725,"_28112":123280,"_3048":54923},[],{"_3592":73490,"_30925":73404,"_21431":123516,"_5":14725,"_28112":123280,"_3048":25573},[],{"_3592":73491,"_30925":73404,"_21431":123518,"_5":14725,"_28112":123280,"_3048":54928},[],{"_3592":73492,"_30925":73404,"_21431":123520,"_5":14725,"_28112":123280,"_3048":123521},[],"Token de sesión (con `auth_method=static`).",{"_3592":73493,"_30925":73404,"_21431":123523,"_5":14725,"_28112":123280,"_3048":54934},[],{"_3592":73494,"_30925":73404,"_21431":123525,"_5":14725,"_28112":123280,"_3048":25573},[],{"_3592":73495,"_30925":73404,"_21431":123527,"_5":14725,"_28112":123280,"_3048":123528},[],"Solo con `auth_method=role`",{"_3592":73496,"_30925":73404,"_21431":123530,"_5":14725,"_28112":123280,"_3048":123531},[],"ARN del rol a asumir.",{"_3592":73497,"_30925":73404,"_21431":123533,"_5":14725,"_28112":123280,"_3048":54945},[],{"_3592":73498,"_30925":73404,"_21431":123535,"_5":14725,"_28112":123280,"_3048":25573},[],{"_3592":73499,"_30925":73404,"_21431":123537,"_5":14725,"_28112":123280,"_3048":54928},[],{"_3592":73500,"_30925":73404,"_21431":123539,"_5":14725,"_28112":123280,"_3048":123540},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3592":73501,"_30925":73404,"_21431":123542,"_5":14725,"_28112":123280,"_3048":54955},[],{"_3592":73502,"_30925":73404,"_21431":123544,"_5":14725,"_28112":123280,"_3048":92097},[],{"_3592":73503,"_30925":73404,"_21431":123546,"_5":14725,"_28112":123280,"_3048":123472},[],{"_3592":73504,"_30925":73404,"_21431":123548,"_5":14725,"_28112":123280,"_3048":123549},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3592":73505,"_30925":73404,"_21431":123551,"_5":14725,"_28112":123280,"_3048":54965},[],{"_3592":73506,"_30925":73404,"_21431":123553,"_5":14725,"_28112":123280,"_3048":25573},[],{"_3592":73507,"_30925":73404,"_21431":123555,"_5":14725,"_28112":123280,"_3048":123472},[],{"_3592":73508,"_30925":73404,"_21431":123557,"_5":14725,"_28112":123280,"_3048":123558},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3592":73509,"_30925":73404,"_21431":123560,"_5":14725,"_28112":123280,"_3048":54975},[],{"_3592":73510,"_30925":73404,"_21431":123562,"_5":14725,"_28112":123280,"_3048":25573},[],{"_3592":73511,"_30925":73404,"_21431":123564,"_5":14725,"_28112":123280,"_3048":123472},[],{"_3592":73512,"_30925":73404,"_21431":123566,"_5":14725,"_28112":123280,"_3048":123567},[],"URL HTTP del Device Manager de Lamassu.",{"_3592":73513,"_30925":73404,"_21431":123569,"_5":14725,"_28112":123280,"_3048":54985},[],{"_3592":73514,"_30925":73404,"_21431":123571,"_5":14725,"_28112":123280,"_3048":25573},[],{"_3592":73515,"_30925":73404,"_21431":123573,"_5":14725,"_28112":123280,"_3048":123472},[],{"_3592":73516,"_30925":73404,"_21431":123575,"_5":14725,"_28112":123280,"_3048":123576},[],"URL HTTP del servicio de CA de Lamassu.",{"_3592":73517,"_30925":73404,"_21431":123578,"_5":14725,"_28112":123284,"_3048":123579},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3592":73518,"_30925":73404,"_21431":123581,"_5":14725,"_28112":123284,"_3048":123582},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3592":73519,"_30925":73404,"_21431":123584,"_5":14725,"_28112":123284,"_3048":123585},[],"Tipo de CloudEvent",{"_3592":73520,"_30925":73404,"_21431":123587,"_5":14725,"_28112":123284,"_3048":123588},[],"Recurso en Lamassu",{"_3592":73521,"_30925":73404,"_21431":123590,"_5":14725,"_28112":123284,"_3048":123591},[],"Recurso AWS",{"_3592":73522,"_30925":73404,"_21431":123593,"_5":14725,"_28112":123284,"_3048":123594},[],"Acciones IAM",{"_3592":73523,"_30925":73404,"_21431":123596,"_5":14725,"_28112":123284,"_3048":123597},[],"Llamadas AWS y efecto",{"_3592":73524,"_30925":73404,"_21431":123599,"_5":14725,"_28112":123284,"_3048":123600},[],"Dónde en esta página",{"_3592":73525,"_30925":73404,"_21431":123602,"_5":14725,"_28112":123284,"_3048":55019},[],{"_3592":73526,"_30925":73404,"_21431":123604,"_5":14725,"_28112":123284,"_3048":55022},[],{"_3592":73527,"_30925":73404,"_21431":123606,"_5":14725,"_28112":123284,"_3048":55025},[],{"_3592":73528,"_30925":73404,"_21431":123608,"_5":14725,"_28112":123284,"_3048":55028},[],{"_3592":73529,"_30925":73404,"_21431":123610,"_5":14725,"_28112":123284,"_3048":123611},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3592":73530,"_30925":73404,"_21431":123613,"_5":14725,"_28112":123284,"_3048":123297},[],{"_3592":73531,"_30925":73404,"_21431":123615,"_5":14725,"_28112":123284,"_3048":55036},[],{"_3592":73532,"_30925":73404,"_21431":123617,"_5":14725,"_28112":123284,"_3048":55039},[],{"_3592":73533,"_30925":73404,"_21431":123619,"_5":14725,"_28112":123284,"_3048":55042},[],{"_3592":73534,"_30925":73404,"_21431":123621,"_5":14725,"_28112":123284,"_3048":55045},[],{"_3592":73535,"_30925":73404,"_21431":123623,"_5":14725,"_28112":123284,"_3048":123624},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3592":73536,"_30925":73404,"_21431":123626,"_5":14725,"_28112":123284,"_3048":123323},[],{"_3592":73537,"_30925":73404,"_21431":123628,"_5":14725,"_28112":123284,"_3048":55053},[],{"_3592":73538,"_30925":73404,"_21431":123630,"_5":14725,"_28112":123284,"_3048":123631},[],"Dispositivo",{"_3592":73539,"_30925":73404,"_21431":123633,"_5":14725,"_28112":123284,"_3048":55059},[],{"_3592":73540,"_30925":73404,"_21431":123635,"_5":14725,"_28112":123284,"_3048":55062},[],{"_3592":73541,"_30925":73404,"_21431":123637,"_5":14725,"_28112":123284,"_3048":123638},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3592":73542,"_30925":73404,"_21431":123640,"_5":14725,"_28112":123284,"_3048":123331},[],{"_3592":73543,"_30925":73404,"_21431":123642,"_5":14725,"_28112":123284,"_3048":55070},[],{"_3592":73544,"_30925":73404,"_21431":123644,"_5":14725,"_28112":123284,"_3048":123645},[],"Certificado",{"_3592":73545,"_30925":73404,"_21431":123647,"_5":14725,"_28112":123284,"_3048":55076},[],{"_3592":73546,"_30925":73404,"_21431":123649,"_5":14725,"_28112":123284,"_3048":123650},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3592":73547,"_30925":73404,"_21431":123652,"_5":14725,"_28112":123284,"_3048":123653},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3592":73548,"_30925":73404,"_21431":123655,"_5":14725,"_28112":123284,"_3048":123343},[],{"_3592":73549,"_30925":73404,"_21431":123657,"_5":14725,"_28112":123284,"_3048":55087},[],{"_3592":73550,"_30925":73404,"_21431":123659,"_5":14725,"_28112":123284,"_3048":123660},[],"Certificado / Dispositivo",{"_3592":73551,"_30925":73404,"_21431":123662,"_5":14725,"_28112":123284,"_3048":55093},[],{"_3592":73552,"_30925":73404,"_21431":123664,"_5":14725,"_28112":123284,"_3048":50901},[],{"_3592":73553,"_30925":73404,"_21431":123666,"_5":14725,"_28112":123284,"_3048":123667},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3592":73554,"_30925":73404,"_21431":123669,"_5":14725,"_28112":123284,"_3048":123351},[],{"_3592":73555,"_30925":73404,"_21431":123671,"_5":14725,"_28112":123288,"_3048":123672},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3592":73556,"_30925":73404,"_21431":123674,"_5":14725,"_28112":123292,"_3048":123675},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3592":73557,"_30925":73404,"_21431":123677,"_5":14725,"_28112":123292,"_3048":123678},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3592":73558,"_30925":73404,"_21431":123680,"_5":14725,"_28112":123296,"_3048":123681},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3592":73559,"_30925":73404,"_21431":123683,"_5":14725,"_28112":123296,"_3048":123684},[],"Transición",{"_3592":73560,"_30925":73404,"_21431":123686,"_5":14725,"_28112":123296,"_3048":123687},[],"Llamadas AWS",{"_3592":73561,"_30925":73404,"_21431":123689,"_5":14725,"_28112":123296,"_3048":123690},[],"`NoRegistrada` → `Solicitada`",{"_3592":73562,"_30925":73404,"_21431":123692,"_5":14725,"_28112":123296,"_3048":123693},[],"ninguna (solo escritura de metadatos)",{"_3592":73563,"_30925":73404,"_21431":123695,"_5":14725,"_28112":123296,"_3048":123696},[],"`Solicitada` → `Registrando`",{"_3592":73564,"_30925":73404,"_21431":123698,"_5":14725,"_28112":123296,"_3048":123699},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3592":73565,"_30925":73404,"_21431":123701,"_5":14725,"_28112":123296,"_3048":123702},[],"`Registrando` → `Completada`",{"_3592":73566,"_30925":73404,"_21431":123704,"_5":14725,"_28112":123296,"_3048":123705},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3592":73567,"_30925":73404,"_21431":123707,"_5":14725,"_28112":123296,"_3048":123708},[],"`Registrando` → `Fallida`",{"_3592":73568,"_30925":73404,"_21431":123710,"_5":14725,"_28112":123296,"_3048":123711},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3592":73569,"_30925":73404,"_21431":123713,"_5":14725,"_28112":123296,"_3048":123714},[],"`Fallida` / `Completada` → `Solicitada`",{"_3592":73570,"_30925":73404,"_21431":123716,"_5":14725,"_28112":123296,"_3048":123717},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3592":73571,"_30925":73404,"_21431":123719,"_5":14725,"_28112":123300,"_3048":123720},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3592":73572,"_30925":73404,"_21431":123722,"_5":14725,"_28112":123300,"_3048":123723},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3592":73573,"_30925":73404,"_21431":123725,"_5":14725,"_28112":123300,"_3048":123726},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3592":73574,"_30925":73404,"_21431":123728,"_5":14725,"_28112":123300,"_3048":123729},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3592":73575,"_30925":73404,"_21431":123731,"_5":14725,"_28112":123300,"_3048":123732},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3592":73576,"_30925":73404,"_21431":123734,"_5":14725,"_28112":123300,"_3048":123735},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3592":73577,"_30925":73404,"_21431":123737,"_5":14725,"_28112":123303,"_3048":123738},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3592":73578,"_30925":73404,"_21431":123740,"_5":14725,"_28112":123306,"_3048":123741},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3592":73579,"_30925":73404,"_21431":123743,"_5":14725,"_28112":123306,"_3048":123744},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3592":73580,"_30925":73404,"_21431":123746,"_5":14725,"_28112":123310,"_3048":123747},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3592":73581,"_30925":73404,"_21431":123749,"_5":14725,"_28112":123314,"_3048":123750},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3592":73582,"_30925":73404,"_21431":123752,"_5":14725,"_28112":123314,"_3048":123753},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3592":73583,"_30925":73404,"_21431":123755,"_5":14725,"_28112":123314,"_3048":123756},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3592":73584,"_30925":73404,"_21431":123758,"_5":14725,"_28112":123314,"_3048":123759},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3592":73585,"_30925":73404,"_21431":123761,"_5":14725,"_28112":123314,"_3048":123762},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3592":73586,"_30925":73404,"_21431":123764,"_5":14725,"_28112":123314,"_3048":123765},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3592":73587,"_30925":73404,"_21431":123767,"_5":14725,"_28112":123318,"_3048":123768},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3592":73588,"_30925":73404,"_21431":123770,"_5":14725,"_28112":123318,"_3048":123771},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3592":73589,"_30925":73404,"_21431":123773,"_5":14725,"_28112":123318,"_3048":123774},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3592":73590,"_30925":73404,"_21431":123776,"_5":14725,"_28112":123318,"_3048":123777},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3592":73591,"_30925":73404,"_21431":123779,"_5":14725,"_28112":123318,"_3048":123780},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3592":73592,"_30925":73404,"_21431":123782,"_5":14725,"_28112":123322,"_3048":123783},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3592":73593,"_30925":73404,"_21431":123785,"_5":14725,"_28112":123322,"_3048":123684},[],{"_3592":73594,"_30925":73404,"_21431":123787,"_5":14725,"_28112":123322,"_3048":123687},[],{"_3592":73595,"_30925":73404,"_21431":123789,"_5":14725,"_28112":123322,"_3048":123790},[],"`SinConfigurar` → `None` / `Auto`",{"_3592":73596,"_30925":73404,"_21431":123792,"_5":14725,"_28112":123322,"_3048":123793},[],"ninguna (solo configuración)",{"_3592":73597,"_30925":73404,"_21431":123795,"_5":14725,"_28112":123322,"_3048":55230},[],{"_3592":73598,"_30925":73404,"_21431":123797,"_5":14725,"_28112":123322,"_3048":123793},[],{"_3592":73599,"_30925":73404,"_21431":123799,"_5":14725,"_28112":123322,"_3048":123800},[],"Cualquiera → `Jitp`",{"_3592":73600,"_30925":73404,"_21431":123802,"_5":14725,"_28112":123322,"_3048":123803},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3592":73601,"_30925":73404,"_21431":123805,"_5":14725,"_28112":123322,"_3048":55241},[],{"_3592":73602,"_30925":73404,"_21431":123807,"_5":14725,"_28112":123322,"_3048":123808},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3592":73603,"_30925":73404,"_21431":123810,"_5":14725,"_28112":123326,"_3048":123811},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3592":73604,"_30925":73404,"_21431":123813,"_5":14725,"_28112":123326,"_3048":123814},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3592":73605,"_30925":73404,"_21431":123816,"_5":14725,"_28112":123326,"_3048":123817},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3592":73606,"_30925":73404,"_21431":123819,"_5":14725,"_28112":123330,"_3048":123820},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3592":73607,"_30925":73404,"_21431":123822,"_5":14725,"_28112":123330,"_3048":123684},[],{"_3592":73608,"_30925":73404,"_21431":123824,"_5":14725,"_28112":123330,"_3048":123687},[],{"_3592":73609,"_30925":73404,"_21431":123826,"_5":14725,"_28112":123330,"_3048":123827},[],"`Ausente` → `Aprovisionado`",{"_3592":73610,"_30925":73404,"_21431":123829,"_5":14725,"_28112":123330,"_3048":123830},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3592":73611,"_30925":73404,"_21431":123832,"_5":14725,"_28112":123330,"_3048":123833},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3592":73612,"_30925":73404,"_21431":123835,"_5":14725,"_28112":123330,"_3048":123836},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3592":73613,"_30925":73404,"_21431":123838,"_5":14725,"_28112":123330,"_3048":123839},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3592":73614,"_30925":73404,"_21431":123841,"_5":14725,"_28112":123334,"_3048":123842},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3592":73615,"_30925":73404,"_21431":123844,"_5":14725,"_28112":123334,"_3048":123845},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3592":73616,"_30925":73404,"_21431":123847,"_5":14725,"_28112":123334,"_3048":123848},[],"Para que el flujo JITP funcione correctamente:",{"_3592":73617,"_30925":73404,"_21431":123850,"_5":14725,"_28112":123334,"_3048":123851},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3592":73618,"_30925":73404,"_21431":123853,"_5":14725,"_28112":123334,"_3048":123854},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3592":73619,"_30925":73404,"_21431":123856,"_5":14725,"_28112":123334,"_3048":123857},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3592":73620,"_30925":73404,"_21431":123859,"_5":14725,"_28112":123334,"_3048":123860},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3592":73621,"_30925":73404,"_21431":123862,"_5":14725,"_28112":123338,"_3048":123863},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3592":73622,"_30925":73404,"_21431":123865,"_5":14725,"_28112":123338,"_3048":123866},[],"Estado en Lamassu",{"_3592":73623,"_30925":73404,"_21431":123868,"_5":14725,"_28112":123338,"_3048":123869},[],"Razón de revocación",{"_3592":73624,"_30925":73404,"_21431":123871,"_5":14725,"_28112":123338,"_3048":123872},[],"Estado en AWS IoT Core",{"_3592":73625,"_30925":73404,"_21431":123874,"_5":14725,"_28112":123338,"_3048":55311},[],{"_3592":73626,"_30925":73404,"_21431":123876,"_5":14725,"_28112":123338,"_3048":123877},[],"Ninguna",{"_3592":73627,"_30925":73404,"_21431":123879,"_5":14725,"_28112":123338,"_3048":55317},[],{"_3592":73628,"_30925":73404,"_21431":123881,"_5":14725,"_28112":123338,"_3048":55320},[],{"_3592":73629,"_30925":73404,"_21431":123883,"_5":14725,"_28112":123338,"_3048":55323},[],{"_3592":73630,"_30925":73404,"_21431":123885,"_5":14725,"_28112":123338,"_3048":55326},[],{"_3592":73631,"_30925":73404,"_21431":123887,"_5":14725,"_28112":123338,"_3048":55320},[],{"_3592":73632,"_30925":73404,"_21431":123889,"_5":14725,"_28112":123338,"_3048":123890},[],"Cualquier otra razón",{"_3592":73633,"_30925":73404,"_21431":123892,"_5":14725,"_28112":123338,"_3048":55334},[],{"_3592":73634,"_30925":73404,"_21431":123894,"_5":14725,"_28112":123338,"_3048":123895},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3592":73635,"_30925":73404,"_21431":123897,"_5":14725,"_28112":123342,"_3048":123898},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3592":73636,"_30925":73404,"_21431":123900,"_5":14725,"_28112":123342,"_3048":123684},[],{"_3592":73637,"_30925":73404,"_21431":123902,"_5":14725,"_28112":123342,"_3048":123687},[],{"_3592":73638,"_30925":73404,"_21431":123904,"_5":14725,"_28112":123342,"_3048":123905},[],"`NoSincronizado` → `Active`",{"_3592":73639,"_30925":73404,"_21431":123907,"_5":14725,"_28112":123342,"_3048":54826},[],{"_3592":73640,"_30925":73404,"_21431":123909,"_5":14725,"_28112":123342,"_3048":55352},[],{"_3592":73641,"_30925":73404,"_21431":123911,"_5":14725,"_28112":123342,"_3048":123912},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3592":73642,"_30925":73404,"_21431":123914,"_5":14725,"_28112":123342,"_3048":55358},[],{"_3592":73643,"_30925":73404,"_21431":123916,"_5":14725,"_28112":123342,"_3048":123912},[],{"_3592":73644,"_30925":73404,"_21431":123918,"_5":14725,"_28112":123342,"_3048":55363},[],{"_3592":73645,"_30925":73404,"_21431":123920,"_5":14725,"_28112":123342,"_3048":54826},[],{"_3592":73646,"_30925":73404,"_21431":123922,"_5":14725,"_28112":123342,"_3048":55368},[],{"_3592":73647,"_30925":73404,"_21431":123924,"_5":14725,"_28112":123342,"_3048":123925},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3592":73648,"_30925":73404,"_21431":123927,"_5":14725,"_28112":123346,"_3048":123928},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3592":73649,"_30925":73404,"_21431":123930,"_5":14725,"_28112":123346,"_3048":123931},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3592":73650,"_30925":73404,"_21431":123933,"_5":14725,"_28112":123346,"_3048":123934},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3592":73651,"_30925":73404,"_21431":123936,"_5":14725,"_28112":123350,"_3048":123937},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3592":73652,"_30925":73404,"_21431":123939,"_5":14725,"_28112":123350,"_3048":123940},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3592":73653,"_30925":73404,"_21431":123942,"_5":14725,"_28112":123354,"_3048":123943},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3592":73654,"_30925":73404,"_21431":123945,"_5":14725,"_28112":123354,"_3048":123946},[],"Existen dos tipos de acciones:",{"_3592":73655,"_30925":73404,"_21431":123948,"_5":14725,"_28112":123354,"_3048":123949},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3592":73656,"_30925":73404,"_21431":123951,"_5":14725,"_28112":123354,"_3048":123952},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3592":73657,"_30925":73404,"_21431":123954,"_5":14725,"_28112":123354,"_3048":123955},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3592":73658,"_30925":73404,"_21431":123957,"_5":14725,"_28112":123358,"_3048":123958},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3592":73659,"_30925":73404,"_21431":123960,"_5":14725,"_28112":123358,"_3048":123961},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3592":73660,"_30925":73404,"_21431":123963,"_5":14725,"_28112":123358,"_3048":123964},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3592":73661,"_30925":73404,"_21431":123966,"_5":14725,"_28112":123362,"_3048":123967},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3592":73662,"_30925":73404,"_21431":123969,"_5":14725,"_28112":123362,"_3048":123970},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3592":73663,"_30925":73404,"_21431":123972,"_5":14725,"_28112":123362,"_3048":123973},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3592":73664,"_30925":73404,"_21431":123975,"_5":14725,"_28112":123362,"_3048":123976},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3592":73665,"_30925":73404,"_21431":123978,"_5":14725,"_28112":123362,"_3048":123979},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3592":73666,"_30925":73404,"_21431":123981,"_5":14725,"_28112":123362,"_3048":123982},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3592":73667,"_30925":73404,"_21431":123984,"_5":14725,"_28112":123362,"_3048":123985},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3592":73668,"_30925":73404,"_21431":123987,"_5":14725,"_28112":123362,"_3048":123988},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3592":73669,"_30925":73404,"_21431":123990,"_5":14725,"_28112":123362,"_3048":123991},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3592":73670,"_30925":73404,"_21431":123993,"_5":14725,"_28112":123362,"_3048":123994},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3592":73671,"_30925":73404,"_21431":123996,"_5":14725,"_28112":123362,"_3048":123997},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3592":73672,"_30925":73404,"_21431":123999,"_5":14725,"_28112":123362,"_3048":124000},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3592":73673,"_30925":73404,"_21431":124002,"_5":14725,"_28112":123362,"_3048":124003},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3592":73674,"_30925":73404,"_21431":124005,"_5":14725,"_28112":123362,"_3048":124006},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3592":73675,"_30925":73404,"_21431":124008,"_5":14725,"_28112":123362,"_3048":124009},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3592":73676,"_30925":73404,"_21431":124011,"_5":14725,"_28112":123362,"_3048":124012},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3592":73677,"_30925":73404,"_21431":124014,"_5":14725,"_28112":123362,"_3048":124015},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3592":73678,"_30925":73404,"_21431":124017,"_5":14725,"_28112":123362,"_3048":124018},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3592":73679,"_30925":73404,"_21431":124020,"_5":14725,"_28112":123362,"_3048":124021},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3592":73680,"_30925":73404,"_21431":124023,"_5":14725,"_28112":123362,"_3048":124024},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3592":73681,"_30925":73404,"_21431":124026,"_5":14725,"_28112":123362,"_3048":124027},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3592":73682,"_30925":73404,"_21431":124029,"_5":14725,"_28112":123362,"_3048":124030},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3592":73683,"_30925":73404,"_21431":124032,"_5":14725,"_28112":123362,"_3048":124033},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3592":73684,"_30925":73404,"_21431":124035,"_5":14725,"_28112":123362,"_3048":124036},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3592":73685,"_30925":73685,"_5":15085,"_3048":53189,"_31263":124038,"_21431":124039,"_28112":73685},[50505,120709,53189],[],{"_3592":73686,"_30925":73685,"_21431":124041,"_5":14725,"_28112":73685,"_3048":124042},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3592":73687,"_30925":73685,"_5":31260,"_21431":124044,"_28112":124045,"_3048":124046},[],"/docs/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3592":73688,"_30925":73685,"_5":31260,"_21431":124048,"_28112":124049,"_3048":121854},[],"/docs/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3592":73689,"_30925":73685,"_5":31260,"_21431":124051,"_28112":124052,"_3048":122029},[],"/docs/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3592":73690,"_30925":73685,"_5":31260,"_21431":124054,"_28112":124055,"_3048":123261},[],"/docs/es/platform/iot-fleets/overview#integraciones",{"_3592":73691,"_30925":73685,"_5":31260,"_21431":124057,"_28112":124058,"_3048":124059},[],"/docs/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3592":73692,"_30925":73685,"_21431":124061,"_5":14725,"_28112":73685,"_3048":124062},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3592":73693,"_30925":73685,"_21431":124064,"_5":14725,"_28112":124045,"_3048":124065},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3592":73694,"_30925":73685,"_21431":124067,"_5":14725,"_28112":124045,"_3048":124068},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3592":73695,"_30925":73685,"_21431":124070,"_5":14725,"_28112":124049,"_3048":124071},[],"Recurso",{"_3592":73696,"_30925":73685,"_21431":124073,"_5":14725,"_28112":124049,"_3048":124074},[],"Qué representa",{"_3592":73697,"_30925":73685,"_21431":124076,"_5":14725,"_28112":124049,"_3048":124077},[],"**Dispositivo**",{"_3592":73698,"_30925":73685,"_21431":124079,"_5":14725,"_28112":124049,"_3048":124080},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3592":73699,"_30925":73685,"_21431":124082,"_5":14725,"_28112":124049,"_3048":124083},[],"**Identidad**",{"_3592":73700,"_30925":73685,"_21431":124085,"_5":14725,"_28112":124049,"_3048":124086},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3592":73701,"_30925":73685,"_21431":124088,"_5":14725,"_28112":124049,"_3048":55535},[],{"_3592":73702,"_30925":73685,"_21431":124090,"_5":14725,"_28112":124049,"_3048":124091},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3592":73703,"_30925":73685,"_21431":124093,"_5":14725,"_28112":124049,"_3048":124094},[],"**Flota**",{"_3592":73704,"_30925":73685,"_21431":124096,"_5":14725,"_28112":124049,"_3048":124097},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3592":73705,"_30925":73685,"_21431":124099,"_5":14725,"_28112":124049,"_3048":124100},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3592":73706,"_30925":73685,"_21431":124102,"_5":14725,"_28112":124049,"_3048":124103},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3592":73707,"_30925":73685,"_21431":124105,"_5":14725,"_28112":124052,"_3048":124106},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3592":73708,"_30925":73685,"_21431":124108,"_5":14725,"_28112":124052,"_3048":124109},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3592":73709,"_30925":73685,"_21431":124111,"_5":14725,"_28112":124052,"_3048":124112},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3592":73710,"_30925":73685,"_21431":124114,"_5":14725,"_28112":124052,"_3048":124115},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3592":73711,"_30925":73685,"_21431":124117,"_5":14725,"_28112":124052,"_3048":124118},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3592":73712,"_30925":73685,"_21431":124120,"_5":14725,"_28112":124052,"_3048":124121},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3592":73713,"_30925":73685,"_21431":124123,"_5":14725,"_28112":124052,"_3048":124124},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3592":73714,"_30925":73685,"_21431":124126,"_5":14725,"_28112":124052,"_3048":124127},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3592":73715,"_30925":73685,"_21431":124129,"_5":14725,"_28112":124055,"_3048":124130},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3592":73716,"_30925":73685,"_21431":124132,"_5":14725,"_28112":124055,"_3048":124133},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3592":73717,"_30925":73685,"_21431":124135,"_5":14725,"_28112":124058,"_3048":124136},[],"Participante",{"_3592":73718,"_30925":73685,"_21431":124138,"_5":14725,"_28112":124058,"_3048":124139},[],"Responsabilidad",{"_3592":73719,"_30925":73685,"_21431":124141,"_5":14725,"_28112":124058,"_3048":124142},[],"Administrador PKI",{"_3592":73720,"_30925":73685,"_21431":124144,"_5":14725,"_28112":124058,"_3048":124145},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3592":73721,"_30925":73685,"_21431":124147,"_5":14725,"_28112":124058,"_3048":124148},[],"Administrador del aprovisionamiento",{"_3592":73722,"_30925":73685,"_21431":124150,"_5":14725,"_28112":124058,"_3048":124151},[],"DMS, admisión, autenticación por operación e inventario.",{"_3592":73723,"_30925":73685,"_21431":124153,"_5":14725,"_28112":124058,"_3048":124154},[],"Integrador del dispositivo",{"_3592":73724,"_30925":73685,"_21431":124156,"_5":14725,"_28112":124058,"_3048":124157},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3592":73725,"_30925":73685,"_21431":124159,"_5":14725,"_28112":124058,"_3048":124160},[],"Integrador del consumidor",{"_3592":73726,"_30925":73685,"_21431":124162,"_5":14725,"_28112":124058,"_3048":124163},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3592":73727,"_30925":73685,"_21431":124165,"_5":14725,"_28112":124058,"_3048":124166},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3592":73728,"_30925":73728,"_5":15085,"_3048":124168,"_31263":124169,"_21431":124171,"_28112":73728},"Enrola y conecta tu primer dispositivo",[50505,120709,53189,124170],"Primeros pasos",[],{"_3592":73729,"_30925":73728,"_21431":124173,"_5":14725,"_28112":73728,"_3048":124174},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3592":73730,"_30925":73728,"_5":31260,"_21431":124176,"_28112":124177,"_3048":119243},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3592":73731,"_30925":73728,"_5":31260,"_21431":124179,"_28112":124180,"_3048":124181},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3592":73732,"_30925":73728,"_5":31260,"_21431":124183,"_28112":124184,"_3048":124185},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3592":73733,"_30925":73728,"_5":31260,"_21431":124187,"_28112":124188,"_3048":124189},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3592":73734,"_30925":73728,"_5":31260,"_21431":124191,"_28112":124192,"_3048":124193},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3592":73735,"_30925":73728,"_5":31260,"_21431":124195,"_28112":124196,"_3048":124197},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3592":73736,"_30925":73728,"_5":31260,"_21431":124199,"_28112":124200,"_3048":124201},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3592":73737,"_30925":73728,"_5":31260,"_21431":124203,"_28112":124204,"_3048":124205},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3592":73738,"_30925":73728,"_21431":124207,"_5":14725,"_28112":73728,"_3048":124208},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3592":73739,"_30925":73728,"_21431":124210,"_5":14725,"_28112":124177,"_3048":124211},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3592":73740,"_30925":73728,"_21431":124213,"_5":14725,"_28112":124177,"_3048":124214},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3592":73741,"_30925":73728,"_21431":124216,"_5":14725,"_28112":124177,"_3048":124217},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3592":73742,"_30925":73728,"_21431":124219,"_5":14725,"_28112":124177,"_3048":124220},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3592":73743,"_30925":73728,"_21431":124222,"_5":14725,"_28112":124177,"_3048":124223},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3592":73744,"_30925":73728,"_21431":124225,"_5":14725,"_28112":124180,"_3048":124226},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3592":73745,"_30925":73728,"_21431":124228,"_5":14725,"_28112":124180,"_3048":124229},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3592":73746,"_30925":73728,"_21431":124231,"_5":14725,"_28112":124184,"_3048":124232},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3592":73747,"_30925":73728,"_21431":124234,"_5":14725,"_28112":124184,"_3048":124235},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3592":73748,"_30925":73728,"_21431":124237,"_5":14725,"_28112":124184,"_3048":124238},[],"Ajuste",{"_3592":73749,"_30925":73728,"_21431":124240,"_5":14725,"_28112":124184,"_3048":124241},[],"Valor de evaluación",{"_3592":73750,"_30925":73728,"_21431":124243,"_5":14725,"_28112":124184,"_3048":55691},[],{"_3592":73751,"_30925":73728,"_21431":124245,"_5":14725,"_28112":124184,"_3048":124246},[],"Raíz emisora de `device-root.pem`.",{"_3592":73752,"_30925":73728,"_21431":124248,"_5":14725,"_28112":124184,"_3048":122157},[],{"_3592":73753,"_30925":73728,"_21431":124250,"_5":14725,"_28112":124184,"_3048":124251},[],"Perfil final de 1 hora que acabas de preparar.",{"_3592":73754,"_30925":73728,"_21431":124253,"_5":14725,"_28112":124184,"_3048":55702},[],{"_3592":73755,"_30925":73728,"_21431":124255,"_5":14725,"_28112":124184,"_3048":55705},[],{"_3592":73756,"_30925":73728,"_21431":124257,"_5":14725,"_28112":124184,"_3048":55708},[],{"_3592":73757,"_30925":73728,"_21431":124259,"_5":14725,"_28112":124184,"_3048":124260},[],"Habilitado.",{"_3592":73758,"_30925":73728,"_21431":124262,"_5":14725,"_28112":124184,"_3048":55714},[],{"_3592":73759,"_30925":73728,"_21431":124264,"_5":14725,"_28112":124184,"_3048":124265},[],"Deshabilitado; el ID debe ser nuevo.",{"_3592":73760,"_30925":73728,"_21431":124267,"_5":14725,"_28112":124184,"_3048":124268},[],"Autenticación inicial",{"_3592":73761,"_30925":73728,"_21431":124270,"_5":14725,"_28112":124184,"_3048":124271},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3592":73762,"_30925":73728,"_21431":124273,"_5":14725,"_28112":124184,"_3048":124274},[],"Autenticación de renovación",{"_3592":73763,"_30925":73728,"_21431":124276,"_5":14725,"_28112":124184,"_3048":124277},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3592":73764,"_30925":73728,"_21431":124279,"_5":14725,"_28112":124184,"_3048":55732},[],{"_3592":73765,"_30925":73728,"_21431":124281,"_5":14725,"_28112":124184,"_3048":124282},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3592":73766,"_30925":73728,"_21431":124284,"_5":14725,"_28112":124184,"_3048":55738},[],{"_3592":73767,"_30925":73728,"_21431":124286,"_5":14725,"_28112":124184,"_3048":124287},[],"1 hora.",{"_3592":73768,"_30925":73728,"_21431":124289,"_5":14725,"_28112":124184,"_3048":55744},[],{"_3592":73769,"_30925":73728,"_21431":124291,"_5":14725,"_28112":124184,"_3048":124292},[],"30 minutos / 10 minutos.",{"_3592":73770,"_30925":73728,"_21431":124294,"_5":14725,"_28112":124184,"_3048":55750},[],{"_3592":73771,"_30925":73728,"_21431":124296,"_5":14725,"_28112":124184,"_3048":124297},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3592":73772,"_30925":73728,"_21431":124299,"_5":14725,"_28112":124184,"_3048":53508},[],{"_3592":73773,"_30925":73728,"_21431":124301,"_5":14725,"_28112":124184,"_3048":124302},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3592":73774,"_30925":73728,"_21431":124304,"_5":14725,"_28112":124184,"_3048":55761},[],{"_3592":73775,"_30925":73728,"_21431":124306,"_5":14725,"_28112":124184,"_3048":124307},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3592":73776,"_30925":73728,"_21431":124309,"_5":14725,"_28112":124184,"_3048":124310},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3592":73777,"_30925":73728,"_21431":124312,"_5":14725,"_28112":124188,"_3048":124313},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3592":73778,"_30925":73728,"_21431":124315,"_5":14725,"_28112":124188,"_3048":124316},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3592":73779,"_30925":73728,"_21431":124318,"_5":14725,"_28112":124192,"_3048":124319},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3592":73780,"_30925":73728,"_21431":124321,"_5":14725,"_28112":124192,"_3048":124322},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3592":73781,"_30925":73728,"_21431":124324,"_5":14725,"_28112":124192,"_3048":124325},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3592":73782,"_30925":73728,"_21431":124327,"_5":14725,"_28112":124196,"_3048":124328},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3592":73783,"_30925":73728,"_21431":124330,"_5":14725,"_28112":124196,"_3048":124331},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3592":73784,"_30925":73728,"_21431":124333,"_5":14725,"_28112":124200,"_3048":124334},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3592":73785,"_30925":73728,"_21431":124336,"_5":14725,"_28112":124200,"_3048":124337},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3592":73786,"_30925":73728,"_21431":124339,"_5":14725,"_28112":124200,"_3048":124340},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3592":73787,"_30925":73728,"_21431":124342,"_5":14725,"_28112":124200,"_3048":124343},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3592":73788,"_30925":73728,"_21431":124345,"_5":14725,"_28112":124200,"_3048":124346},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3592":73789,"_30925":73728,"_21431":124348,"_5":14725,"_28112":124204,"_3048":124349},[],"Comprobación",{"_3592":73790,"_30925":73728,"_21431":124351,"_5":14725,"_28112":124204,"_3048":124352},[],"Resultado esperado",{"_3592":73791,"_30925":73728,"_21431":124354,"_5":14725,"_28112":124204,"_3048":124355},[],"Registro",{"_3592":73792,"_30925":73728,"_21431":124357,"_5":14725,"_28112":124204,"_3048":124358},[],"ID creado automáticamente y DMS correcto.",{"_3592":73793,"_30925":73728,"_21431":124360,"_5":14725,"_28112":124204,"_3048":123645},[],{"_3592":73794,"_30925":73728,"_21431":124362,"_5":14725,"_28112":124204,"_3048":124363},[],"CN, perfil, serie y clave verificados.",{"_3592":73795,"_30925":73728,"_21431":124365,"_5":14725,"_28112":124204,"_3048":124366},[],"Inventario",{"_3592":73796,"_30925":73728,"_21431":124368,"_5":14725,"_28112":124204,"_3048":124369},[],"Serie recibida visible como identidad actual y en el historial.",{"_3592":73797,"_30925":73728,"_21431":124371,"_5":14725,"_28112":124204,"_3048":124372},[],"Consumidor",{"_3592":73798,"_30925":73728,"_21431":124374,"_5":14725,"_28112":124204,"_3048":124375},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3592":73799,"_30925":73728,"_21431":124377,"_5":14725,"_28112":124204,"_3048":124378},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3592":73800,"_30925":73728,"_21431":124380,"_5":14725,"_28112":124204,"_3048":124381},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3592":73801,"_30925":73801,"_5":15085,"_3048":121871,"_31263":124383,"_21431":124384,"_28112":73801},[50505,120709,53189,124170],[],{"_3592":73802,"_30925":73801,"_21431":124386,"_5":14725,"_28112":73801,"_3048":124387},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3592":73803,"_30925":73801,"_5":31260,"_21431":124389,"_28112":124390,"_3048":119243},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3592":73804,"_30925":73801,"_5":31260,"_21431":124392,"_28112":124393,"_3048":124394},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3592":73805,"_30925":73801,"_5":31260,"_21431":124396,"_28112":124397,"_3048":124398},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3592":73806,"_30925":73801,"_5":31260,"_21431":124400,"_28112":124401,"_3048":124402},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3592":73807,"_30925":73801,"_5":31260,"_21431":124404,"_28112":124405,"_3048":124406},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3592":73808,"_30925":73801,"_5":31260,"_21431":124408,"_28112":124409,"_3048":124410},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3592":73809,"_30925":73801,"_5":31260,"_21431":124412,"_28112":124413,"_3048":124352},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3592":73810,"_30925":73801,"_5":31260,"_21431":124415,"_28112":124416,"_3048":124417},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3592":73811,"_30925":73801,"_5":31260,"_21431":124419,"_28112":124420,"_3048":124421},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3592":73812,"_30925":73801,"_21431":124423,"_5":14725,"_28112":73801,"_3048":124424},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3592":73813,"_30925":73801,"_21431":124426,"_5":14725,"_28112":73801,"_3048":124427},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3592":73814,"_30925":73801,"_21431":124429,"_5":14725,"_28112":124390,"_3048":124430},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3592":73815,"_30925":73801,"_21431":124432,"_5":14725,"_28112":124390,"_3048":124433},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3592":73816,"_30925":73801,"_21431":124435,"_5":14725,"_28112":124390,"_3048":124436},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3592":73817,"_30925":73801,"_21431":124438,"_5":14725,"_28112":124390,"_3048":124439},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3592":73818,"_30925":73801,"_21431":124441,"_5":14725,"_28112":124393,"_3048":124442},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3592":73819,"_30925":73801,"_21431":124444,"_5":14725,"_28112":124393,"_3048":124445},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3592":73820,"_30925":73801,"_21431":124447,"_5":14725,"_28112":124393,"_3048":124448},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3592":73821,"_30925":73801,"_21431":124450,"_5":14725,"_28112":124393,"_3048":124451},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3592":73822,"_30925":73801,"_21431":124453,"_5":14725,"_28112":124393,"_3048":124454},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3592":73823,"_30925":73801,"_21431":124456,"_5":14725,"_28112":124393,"_3048":124457},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3592":73824,"_30925":73801,"_21431":124459,"_5":14725,"_28112":124393,"_3048":124460},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3592":73825,"_30925":73801,"_21431":124462,"_5":14725,"_28112":124393,"_3048":124463},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3592":73826,"_30925":73801,"_21431":124465,"_5":14725,"_28112":124397,"_3048":124466},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3592":73827,"_30925":73801,"_21431":124468,"_5":14725,"_28112":124397,"_3048":55926},[],{"_3592":73828,"_30925":73801,"_21431":124470,"_5":14725,"_28112":124397,"_3048":124471},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3592":73829,"_30925":73801,"_21431":124473,"_5":14725,"_28112":124397,"_3048":124474},[],"**Icon** y **Tags**: clasificación opcional.",{"_3592":73830,"_30925":73801,"_21431":124476,"_5":14725,"_28112":124397,"_3048":124477},[],"Confirma el registro.",{"_3592":73831,"_30925":73801,"_21431":124479,"_5":14725,"_28112":124401,"_3048":124480},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3592":73832,"_30925":73801,"_21431":124482,"_5":14725,"_28112":124401,"_3048":124483},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3592":73833,"_30925":73801,"_21431":124485,"_5":14725,"_28112":124405,"_3048":124486},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3592":73834,"_30925":73801,"_21431":124488,"_5":14725,"_28112":124405,"_3048":124489},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3592":73835,"_30925":73801,"_21431":124491,"_5":14725,"_28112":124409,"_3048":124492},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3592":73836,"_30925":73801,"_21431":124494,"_5":14725,"_28112":124409,"_3048":124495},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3592":73837,"_30925":73801,"_21431":124497,"_5":14725,"_28112":124413,"_3048":124349},[],{"_3592":73838,"_30925":73801,"_21431":124499,"_5":14725,"_28112":124413,"_3048":124500},[],"Resultado",{"_3592":73839,"_30925":73801,"_21431":124502,"_5":14725,"_28112":124413,"_3048":123631},[],{"_3592":73840,"_30925":73801,"_21431":124504,"_5":14725,"_28112":124413,"_3048":124505},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3592":73841,"_30925":73801,"_21431":124507,"_5":14725,"_28112":124413,"_3048":124508},[],"Identidad actual",{"_3592":73842,"_30925":73801,"_21431":124510,"_5":14725,"_28112":124413,"_3048":124511},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3592":73843,"_30925":73801,"_21431":124513,"_5":14725,"_28112":124413,"_3048":124514},[],"Historial",{"_3592":73844,"_30925":73801,"_21431":124516,"_5":14725,"_28112":124413,"_3048":124517},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3592":73845,"_30925":73801,"_21431":124519,"_5":14725,"_28112":124413,"_3048":124520},[],"Clave y certificado",{"_3592":73846,"_30925":73801,"_21431":124522,"_5":14725,"_28112":124413,"_3048":124523},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3592":73847,"_30925":73801,"_21431":124525,"_5":14725,"_28112":124416,"_3048":124526},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3592":73848,"_30925":73801,"_21431":124528,"_5":14725,"_28112":124416,"_3048":124529},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3592":73849,"_30925":73801,"_21431":124531,"_5":14725,"_28112":124416,"_3048":124532},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3592":73850,"_30925":73801,"_21431":124534,"_5":14725,"_28112":124416,"_3048":124535},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3592":73851,"_30925":73801,"_21431":124537,"_5":14725,"_28112":124420,"_3048":124538},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3592":73852,"_30925":73801,"_21431":124540,"_5":14725,"_28112":124420,"_3048":124541},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3592":73853,"_30925":73801,"_21431":124543,"_5":14725,"_28112":124420,"_3048":124544},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3592":73854,"_30925":73854,"_5":15085,"_3048":124546,"_31263":124547,"_21431":124548,"_28112":73854},"Plataforma Lamassu IoT",[50505,120709],[],{"_3592":73855,"_30925":73854,"_21431":124550,"_5":14725,"_28112":73854,"_3048":124551},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3592":73856,"_30925":73854,"_5":31260,"_21431":124553,"_28112":124554,"_3048":124046},[],"/docs/es/platform/overview#empieza-aquí",{"_3592":73857,"_30925":73854,"_5":31260,"_21431":124556,"_28112":124557,"_3048":124558},[],"/docs/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3592":73858,"_30925":73854,"_5":31260,"_21431":124560,"_28112":124561,"_3048":124562},[],"/docs/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3592":73859,"_30925":73854,"_5":31260,"_21431":124564,"_28112":124565,"_3048":124566},[],"/docs/es/platform/overview#capacidades-principales","Capacidades principales",{"_3592":73860,"_30925":73854,"_5":31260,"_21431":124568,"_28112":124569,"_3048":124570},[],"/docs/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3592":73861,"_30925":73854,"_5":31260,"_21431":124572,"_28112":124573,"_3048":124574},[],"/docs/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3592":73862,"_30925":73854,"_5":31260,"_21431":124576,"_28112":124577,"_3048":124578},[],"/docs/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3592":73863,"_30925":73854,"_5":31260,"_21431":124580,"_28112":124581,"_3048":124582},[],"/docs/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3592":73864,"_30925":73854,"_5":31260,"_21431":124584,"_28112":124585,"_3048":124586},[],"/docs/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3592":73865,"_30925":73854,"_5":31260,"_21431":124588,"_28112":124589,"_3048":124590},[],"/docs/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3592":73866,"_30925":73854,"_5":31260,"_21431":124592,"_28112":124593,"_3048":124594},[],"/docs/es/platform/overview#referencia-operativa","Referencia operativa",{"_3592":73867,"_30925":73854,"_21431":124596,"_5":14725,"_28112":73854,"_3048":124597},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3592":73868,"_30925":73854,"_21431":124599,"_5":14725,"_28112":124554,"_3048":124600},[],"Elige el resultado que necesitas obtener:",{"_3592":73869,"_30925":73854,"_21431":124602,"_5":14725,"_28112":124554,"_3048":124603},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3592":73870,"_30925":73854,"_21431":124605,"_5":14725,"_28112":124554,"_3048":124606},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3592":73871,"_30925":73854,"_21431":124608,"_5":14725,"_28112":124554,"_3048":124609},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3592":73872,"_30925":73854,"_21431":124611,"_5":14725,"_28112":124557,"_3048":124612},[],"Bloque",{"_3592":73873,"_30925":73854,"_21431":124614,"_5":14725,"_28112":124557,"_3048":124615},[],"Qué gestionas",{"_3592":73874,"_30925":73854,"_21431":124617,"_5":14725,"_28112":124557,"_3048":124618},[],"Punto de entrada",{"_3592":73875,"_30925":73854,"_21431":124620,"_5":14725,"_28112":124557,"_3048":56079},[],{"_3592":73876,"_30925":73854,"_21431":124622,"_5":14725,"_28112":124557,"_3048":124623},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3592":73877,"_30925":73854,"_21431":124625,"_5":14725,"_28112":124557,"_3048":124626},[],"Visión general de PKI",{"_3592":73878,"_30925":73854,"_21431":124628,"_5":14725,"_28112":124557,"_3048":56088},[],{"_3592":73879,"_30925":73854,"_21431":124630,"_5":14725,"_28112":124557,"_3048":124631},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3592":73880,"_30925":73854,"_21431":124633,"_5":14725,"_28112":124557,"_3048":124634},[],"Visión general de IoT Fleets",{"_3592":73881,"_30925":73854,"_21431":124636,"_5":14725,"_28112":124557,"_3048":124637},[],"**Administración**",{"_3592":73882,"_30925":73854,"_21431":124639,"_5":14725,"_28112":124557,"_3048":124640},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3592":73883,"_30925":73854,"_21431":124642,"_5":14725,"_28112":124557,"_3048":120711},[],{"_3592":73884,"_30925":73854,"_21431":124644,"_5":14725,"_28112":124557,"_3048":124645},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3592":73885,"_30925":73854,"_21431":124647,"_5":14725,"_28112":124561,"_3048":124648},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3592":73886,"_30925":73854,"_21431":124650,"_5":14725,"_28112":124561,"_3048":124651},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3592":73887,"_30925":73854,"_21431":124653,"_5":14725,"_28112":124561,"_3048":124654},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3592":73888,"_30925":73854,"_21431":124656,"_5":14725,"_28112":124561,"_3048":124657},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3592":73889,"_30925":73854,"_21431":124659,"_5":14725,"_28112":124561,"_3048":124660},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3592":73890,"_30925":73854,"_21431":124662,"_5":14725,"_28112":124561,"_3048":124663},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3592":73891,"_30925":73854,"_21431":124665,"_5":14725,"_28112":124569,"_3048":124666},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3592":73892,"_30925":73854,"_21431":124668,"_5":14725,"_28112":124573,"_3048":124669},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3592":73893,"_30925":73854,"_21431":124671,"_5":14725,"_28112":124577,"_3048":124672},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3592":73894,"_30925":73854,"_21431":124674,"_5":14725,"_28112":124581,"_3048":124675},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3592":73895,"_30925":73854,"_21431":124677,"_5":14725,"_28112":124585,"_3048":124678},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3592":73896,"_30925":73854,"_21431":124680,"_5":14725,"_28112":124589,"_3048":124681},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3592":73897,"_30925":73854,"_21431":124683,"_5":14725,"_28112":124593,"_3048":124139},[],{"_3592":73898,"_30925":73854,"_21431":124685,"_5":14725,"_28112":124593,"_3048":124686},[],"Qué prepara o comprueba",{"_3592":73899,"_30925":73854,"_21431":124688,"_5":14725,"_28112":124593,"_3048":124142},[],{"_3592":73900,"_30925":73854,"_21431":124690,"_5":14725,"_28112":124593,"_3048":124691},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3592":73901,"_30925":73854,"_21431":124693,"_5":14725,"_28112":124593,"_3048":124694},[],"Administrador de la flota",{"_3592":73902,"_30925":73854,"_21431":124696,"_5":14725,"_28112":124593,"_3048":124697},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3592":73903,"_30925":73854,"_21431":124699,"_5":14725,"_28112":124593,"_3048":124154},[],{"_3592":73904,"_30925":73854,"_21431":124701,"_5":14725,"_28112":124593,"_3048":124702},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3592":73905,"_30925":73854,"_21431":124704,"_5":14725,"_28112":124593,"_3048":124160},[],{"_3592":73906,"_30925":73854,"_21431":124706,"_5":14725,"_28112":124593,"_3048":124707},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3592":73907,"_30925":73854,"_21431":124709,"_5":14725,"_28112":124593,"_3048":124710},[],"Operador de infraestructura",{"_3592":73908,"_30925":73854,"_21431":124712,"_5":14725,"_28112":124593,"_3048":124713},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3592":73909,"_30925":73854,"_21431":124715,"_5":14725,"_28112":124593,"_3048":124716},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3592":73910,"_30925":73910,"_5":15085,"_3048":124718,"_31263":124719,"_21431":124721,"_28112":73910},"Jerarquía y rotación de CAs",[50505,120709,56180,124720],"Claves, autoridades y certificados",[],{"_3592":73911,"_30925":73910,"_21431":124723,"_5":14725,"_28112":73910,"_3048":124724},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3592":73912,"_30925":73910,"_5":31260,"_21431":124726,"_28112":124727,"_3048":124728},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3592":73913,"_30925":73910,"_5":31260,"_21431":124730,"_28112":124731,"_3048":124732},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3592":73914,"_30925":73910,"_5":31260,"_21431":124734,"_28112":124735,"_3048":124736},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3592":73915,"_30925":73910,"_5":31260,"_21431":124738,"_28112":124739,"_3048":124740},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3592":73916,"_30925":73910,"_5":31260,"_21431":124742,"_28112":124743,"_3048":124744},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3592":73917,"_30925":73910,"_5":31260,"_21431":124746,"_28112":124747,"_3048":124748},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3592":73918,"_30925":73910,"_5":31260,"_21431":124750,"_28112":124751,"_3048":124752},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3592":73919,"_30925":73910,"_5":31260,"_21431":124754,"_28112":124755,"_3048":124756},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3592":73920,"_30925":73910,"_5":31260,"_21431":124758,"_28112":124759,"_3048":124760},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3592":73921,"_30925":73910,"_5":31260,"_21431":124762,"_28112":124763,"_3048":124764},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3592":73922,"_30925":73910,"_5":31260,"_21431":124766,"_28112":124767,"_3048":124768},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3592":73923,"_30925":73910,"_5":31260,"_21431":124770,"_28112":124771,"_3048":124772},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3592":73924,"_30925":73910,"_21431":124774,"_5":14725,"_28112":73910,"_3048":124775},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3592":73925,"_30925":73910,"_21431":124777,"_5":14725,"_28112":73910,"_3048":124778},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3592":73926,"_30925":73910,"_21431":124780,"_5":14725,"_28112":124727,"_3048":124781},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3592":73927,"_30925":73910,"_21431":124783,"_5":14725,"_28112":124727,"_3048":124784},[],"entorno, como producción y preproducción;",{"_3592":73928,"_30925":73910,"_21431":124786,"_5":14725,"_28112":124727,"_3048":124787},[],"propietario o equipo operador;",{"_3592":73929,"_30925":73910,"_21431":124789,"_5":14725,"_28112":124727,"_3048":124790},[],"familia de dispositivos o proceso de fabricación;",{"_3592":73930,"_30925":73910,"_21431":124792,"_5":14725,"_28112":124727,"_3048":124793},[],"región o requisito regulatorio;",{"_3592":73931,"_30925":73910,"_21431":124795,"_5":14725,"_28112":124727,"_3048":124796},[],"motor criptográfico o política de clave;",{"_3592":73932,"_30925":73910,"_21431":124798,"_5":14725,"_28112":124727,"_3048":124799},[],"ventana de mantenimiento y ritmo de renovación.",{"_3592":73933,"_30925":73910,"_21431":124801,"_5":14725,"_28112":124727,"_3048":124802},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3592":73934,"_30925":73910,"_21431":124804,"_5":14725,"_28112":124727,"_3048":124805},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3592":73935,"_30925":73910,"_21431":124807,"_5":14725,"_28112":124731,"_3048":124808},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3592":73936,"_30925":73910,"_21431":124810,"_5":14725,"_28112":124731,"_3048":124811},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir; consulta la guía de CRL.",{"_3592":73937,"_30925":73910,"_21431":124813,"_5":14725,"_28112":124731,"_3048":124814},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3592":73938,"_30925":73910,"_21431":124816,"_5":14725,"_28112":124731,"_3048":124817},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3592":73939,"_30925":73910,"_21431":124819,"_5":14725,"_28112":124735,"_3048":124820},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3592":73940,"_30925":73910,"_21431":124822,"_5":14725,"_28112":124735,"_3048":124823},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3592":73941,"_30925":73910,"_21431":124825,"_5":14725,"_28112":124735,"_3048":124826},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3592":73942,"_30925":73910,"_21431":124828,"_5":14725,"_28112":124735,"_3048":124829},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3592":73943,"_30925":73910,"_21431":124831,"_5":14725,"_28112":124743,"_3048":124832},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3592":73944,"_30925":73910,"_21431":124834,"_5":14725,"_28112":124747,"_3048":124835},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3592":73945,"_30925":73910,"_21431":124837,"_5":14725,"_28112":124751,"_3048":124838},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3592":73946,"_30925":73910,"_21431":124840,"_5":14725,"_28112":124755,"_3048":124841},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3592":73947,"_30925":73910,"_21431":124843,"_5":14725,"_28112":124759,"_3048":124844},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3592":73948,"_30925":73910,"_21431":124846,"_5":14725,"_28112":124763,"_3048":124847},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3592":73949,"_30925":73910,"_21431":124849,"_5":14725,"_28112":124767,"_3048":124850},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3592":73950,"_30925":73910,"_21431":124852,"_5":14725,"_28112":124767,"_3048":124853},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3592":73951,"_30925":73910,"_21431":124855,"_5":14725,"_28112":124767,"_3048":124856},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3592":73952,"_30925":73910,"_21431":124858,"_5":14725,"_28112":124767,"_3048":124859},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3592":73953,"_30925":73910,"_21431":124861,"_5":14725,"_28112":124771,"_3048":124862},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3592":73954,"_30925":73910,"_21431":124864,"_5":14725,"_28112":124771,"_3048":124865},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3592":73955,"_30925":73910,"_21431":124867,"_5":14725,"_28112":124771,"_3048":124868},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3592":73956,"_30925":73910,"_21431":124870,"_5":14725,"_28112":124771,"_3048":124871},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3592":73957,"_30925":73910,"_21431":124873,"_5":14725,"_28112":124771,"_3048":124874},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3592":73958,"_30925":73910,"_21431":124876,"_5":14725,"_28112":124771,"_3048":124877},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3592":73959,"_30925":73910,"_21431":124879,"_5":14725,"_28112":124771,"_3048":124880},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3592":73960,"_30925":73960,"_5":15085,"_3048":124882,"_31263":124883,"_21431":124884,"_28112":73960},"Autoridades de certificación",[50505,120709,56180,124720],[],{"_3592":73961,"_30925":73960,"_21431":124886,"_5":14725,"_28112":73960,"_3048":124887},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3592":73962,"_30925":73960,"_5":31260,"_21431":124889,"_28112":124890,"_3048":124891},[],"/docs/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3592":73963,"_30925":73960,"_5":31260,"_21431":124893,"_28112":124894,"_3048":124895},[],"/docs/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3592":73964,"_30925":73960,"_5":31260,"_21431":124897,"_28112":124898,"_3048":119243},[],"/docs/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3592":73965,"_30925":73960,"_5":31260,"_21431":124900,"_28112":124901,"_3048":124902},[],"/docs/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3592":73966,"_30925":73960,"_5":31260,"_21431":124904,"_28112":124905,"_3048":124906},[],"/docs/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3592":73967,"_30925":73960,"_5":31260,"_21431":124908,"_28112":124909,"_3048":124910},[],"/docs/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3592":73968,"_30925":73960,"_5":31260,"_21431":124912,"_28112":124913,"_3048":124914},[],"/docs/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3592":73969,"_30925":73960,"_5":31260,"_21431":124916,"_28112":124917,"_3048":124918},[],"/docs/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3592":73970,"_30925":73960,"_5":31260,"_21431":124920,"_28112":124921,"_3048":124922},[],"/docs/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3592":73971,"_30925":73960,"_5":31260,"_21431":124924,"_28112":124925,"_3048":124926},[],"/docs/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3592":73972,"_30925":73960,"_5":31260,"_21431":124928,"_28112":124929,"_3048":124930},[],"/docs/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3592":73973,"_30925":73960,"_5":31260,"_21431":124932,"_28112":124933,"_3048":124934},[],"/docs/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3592":73974,"_30925":73960,"_5":31260,"_21431":124936,"_28112":124937,"_3048":124938},[],"/docs/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3592":73975,"_30925":73960,"_5":31260,"_21431":124940,"_28112":124941,"_3048":124942},[],"/docs/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3592":73976,"_30925":73960,"_5":31260,"_21431":124944,"_28112":124945,"_3048":124946},[],"/docs/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3592":73977,"_30925":73960,"_5":31260,"_21431":124948,"_28112":124949,"_3048":124950},[],"/docs/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3592":73978,"_30925":73960,"_5":31260,"_21431":124952,"_28112":124953,"_3048":124954},[],"/docs/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3592":73979,"_30925":73960,"_5":31260,"_21431":124956,"_28112":124957,"_3048":124958},[],"/docs/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3592":73980,"_30925":73960,"_5":31260,"_21431":124960,"_28112":124961,"_3048":124962},[],"/docs/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3592":73981,"_30925":73960,"_5":31260,"_21431":124964,"_28112":124965,"_3048":124966},[],"/docs/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3592":73982,"_30925":73960,"_5":31260,"_21431":124968,"_28112":124969,"_3048":124970},[],"/docs/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3592":73983,"_30925":73960,"_5":31260,"_21431":124972,"_28112":124973,"_3048":124974},[],"/docs/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3592":73984,"_30925":73960,"_5":31260,"_21431":124976,"_28112":124977,"_3048":124978},[],"/docs/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3592":73985,"_30925":73960,"_21431":124980,"_5":14725,"_28112":73960,"_3048":124981},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3592":73986,"_30925":73960,"_21431":124983,"_5":14725,"_28112":73960,"_3048":124984},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3592":73987,"_30925":73960,"_21431":124986,"_5":14725,"_28112":73960,"_3048":124987},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3592":73988,"_30925":73960,"_21431":124989,"_5":14725,"_28112":124890,"_3048":124990},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3592":73989,"_30925":73960,"_21431":124992,"_5":14725,"_28112":124890,"_3048":124993},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3592":73990,"_30925":73960,"_21431":124995,"_5":14725,"_28112":124890,"_3048":124996},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3592":73991,"_30925":73960,"_21431":124998,"_5":14725,"_28112":124890,"_3048":124999},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3592":73992,"_30925":73960,"_21431":125001,"_5":14725,"_28112":124890,"_3048":125002},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3592":73993,"_30925":73960,"_21431":125004,"_5":14725,"_28112":124898,"_3048":125005},[],"Decide si la CA será raíz o intermedia.",{"_3592":73994,"_30925":73960,"_21431":125007,"_5":14725,"_28112":124898,"_3048":125008},[],"Elige el motor que custodiará la clave.",{"_3592":73995,"_30925":73960,"_21431":125010,"_5":14725,"_28112":124898,"_3048":125011},[],"Define una validez superior a la de los certificados que emitirá.",{"_3592":73996,"_30925":73960,"_21431":125013,"_5":14725,"_28112":124898,"_3048":125014},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3592":73997,"_30925":73960,"_21431":125016,"_5":14725,"_28112":124901,"_3048":125017},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3592":73998,"_30925":73960,"_21431":125019,"_5":14725,"_28112":124905,"_3048":125020},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3592":73999,"_30925":73960,"_21431":125022,"_5":14725,"_28112":124905,"_3048":125023},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3592":74000,"_30925":73960,"_21431":125025,"_5":14725,"_28112":124909,"_3048":125026},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3592":74001,"_30925":73960,"_21431":125028,"_5":14725,"_28112":124913,"_3048":125029},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3592":74002,"_30925":73960,"_21431":125031,"_5":14725,"_28112":124913,"_3048":125032},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3592":74003,"_30925":73960,"_21431":125034,"_5":14725,"_28112":124913,"_3048":125035},[],"`ST`: estado o provincia.",{"_3592":74004,"_30925":73960,"_21431":125037,"_5":14725,"_28112":124913,"_3048":125038},[],"`L`: localidad.",{"_3592":74005,"_30925":73960,"_21431":125040,"_5":14725,"_28112":124913,"_3048":125041},[],"`O`: organización.",{"_3592":74006,"_30925":73960,"_21431":125043,"_5":14725,"_28112":124913,"_3048":125044},[],"`OU`: unidad organizativa.",{"_3592":74007,"_30925":73960,"_21431":125046,"_5":14725,"_28112":124913,"_3048":125047},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3592":74008,"_30925":73960,"_21431":125049,"_5":14725,"_28112":124917,"_3048":125050},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3592":74009,"_30925":73960,"_21431":125052,"_5":14725,"_28112":124917,"_3048":125053},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3592":74010,"_30925":73960,"_21431":125055,"_5":14725,"_28112":124921,"_3048":125056},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3592":74011,"_30925":73960,"_21431":125058,"_5":14725,"_28112":124921,"_3048":125059},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3592":74012,"_30925":73960,"_21431":125061,"_5":14725,"_28112":124925,"_3048":125062},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3592":74013,"_30925":73960,"_21431":125064,"_5":14725,"_28112":124925,"_3048":125065},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3592":74014,"_30925":73960,"_21431":125067,"_5":14725,"_28112":124929,"_3048":125068},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3592":74015,"_30925":73960,"_21431":125070,"_5":14725,"_28112":124929,"_3048":125071},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3592":74016,"_30925":73960,"_21431":125073,"_5":14725,"_28112":124929,"_3048":125074},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3592":74017,"_30925":73960,"_21431":125076,"_5":14725,"_28112":124933,"_3048":125077},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3592":74018,"_30925":73960,"_21431":125079,"_5":14725,"_28112":124937,"_3048":125080},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3592":74019,"_30925":73960,"_21431":125082,"_5":14725,"_28112":124937,"_3048":125083},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3592":74020,"_30925":73960,"_21431":125085,"_5":14725,"_28112":124941,"_3048":125086},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3592":74021,"_30925":73960,"_21431":125088,"_5":14725,"_28112":124945,"_3048":125089},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3592":74022,"_30925":73960,"_21431":125091,"_5":14725,"_28112":124945,"_3048":125092},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3592":74023,"_30925":73960,"_21431":125094,"_5":14725,"_28112":124949,"_3048":125095},[],"Abre una CA desde el inventario para consultar:",{"_3592":74024,"_30925":73960,"_21431":125097,"_5":14725,"_28112":124949,"_3048":125098},[],"Estado y periodo de validez.",{"_3592":74025,"_30925":73960,"_21431":125100,"_5":14725,"_28112":124949,"_3048":125101},[],"Certificado y cadena en formato PEM.",{"_3592":74026,"_30925":73960,"_21431":125103,"_5":14725,"_28112":124949,"_3048":125104},[],"Número de certificados activos, expirados y revocados.",{"_3592":74027,"_30925":73960,"_21431":125106,"_5":14725,"_28112":124949,"_3048":125107},[],"Certificados emitidos en **Issued Certificates**.",{"_3592":74028,"_30925":73960,"_21431":125109,"_5":14725,"_28112":124949,"_3048":125110},[],"CRL vinculada a la autoridad.",{"_3592":74029,"_30925":73960,"_21431":125112,"_5":14725,"_28112":124949,"_3048":125113},[],"Metadatos y motor criptográfico asociado.",{"_3592":74030,"_30925":73960,"_21431":125115,"_5":14725,"_28112":124949,"_3048":125116},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3592":74031,"_30925":73960,"_21431":125118,"_5":14725,"_28112":124953,"_3048":125119},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3592":74032,"_30925":73960,"_21431":125121,"_5":14725,"_28112":124953,"_3048":125122},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3592":74033,"_30925":73960,"_21431":125124,"_5":14725,"_28112":124953,"_3048":125125},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3592":74034,"_30925":73960,"_21431":125127,"_5":14725,"_28112":124953,"_3048":125128},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3592":74035,"_30925":73960,"_21431":125130,"_5":14725,"_28112":124957,"_3048":125131},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3592":74036,"_30925":73960,"_21431":125133,"_5":14725,"_28112":124961,"_3048":125134},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3592":74037,"_30925":73960,"_21431":125136,"_5":14725,"_28112":124965,"_3048":125137},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3592":74038,"_30925":73960,"_21431":125139,"_5":14725,"_28112":124969,"_3048":125140},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3592":74039,"_30925":73960,"_21431":125142,"_5":14725,"_28112":124973,"_3048":125143},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3592":74040,"_30925":73960,"_21431":125145,"_5":14725,"_28112":124977,"_3048":125146},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3592":74041,"_30925":73960,"_21431":125148,"_5":14725,"_28112":124977,"_3048":125149},[],"Los ajustes de CRL de la CA se conservan. La eliminación se rechaza con un error `409` mientras sigan `ACTIVE`: la VA debe publicar primero la CRL final de la CA, lo que puede tardar hasta aproximadamente una hora después de la revocación con la programación predeterminada del trabajo, así que reintenta cuando se haya publicado la CRL final. Una CA caducada se finaliza sin CRL final, y una CA en retención (`CertificateHold`) se rechaza con un mensaje que te pide revocarla de forma permanente primero. La eliminación también se rechaza con un `409` cuando la clave de la CA firma las CRLs de otra CA: el error nombra a esa CA, así que cambia su firmante de CRL, o elimínala o revócala, antes de eliminar esta. La CA y todos sus descendientes se comprueban antes de eliminar nada; si alguno no puede eliminarse, no cambia nada.",{"_3592":74042,"_30925":73960,"_21431":125151,"_5":14725,"_28112":124977,"_3048":125152},[],"Tras la eliminación, los ajustes quedan archivados y la última CRL sigue sirviéndose pero nunca se regenera; puedes eliminarlos cuando ningún certificado emitido por la CA necesite ya evidencia de revocación, con `DELETE /v1/crl-settings/{ca-id}` o desde la página **Verification Authorities** de la consola. Borrarlos deja de servir la CRL y no puede deshacerse. Ajusta la validez y el firmante antes de revocar o eliminar la CA (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3592":74043,"_30925":73960,"_21431":125154,"_5":14725,"_28112":124977,"_3048":125155},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: hasta que se eliminen esos ajustes, estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3592":74044,"_30925":74044,"_5":15085,"_3048":125157,"_31263":125158,"_21431":125159,"_28112":74044},"Perfiles de certificado",[50505,120709,56180,124720],[],{"_3592":74045,"_30925":74044,"_21431":125161,"_5":14725,"_28112":74044,"_3048":125162},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3592":74046,"_30925":74044,"_5":31260,"_21431":125164,"_28112":125165,"_3048":125166},[],"/docs/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3592":74047,"_30925":74044,"_5":31260,"_21431":125168,"_28112":125169,"_3048":125170},[],"/docs/es/platform/pki/certificate-profiles#validez","Validez",{"_3592":74048,"_30925":74044,"_5":31260,"_21431":125172,"_28112":125173,"_3048":125174},[],"/docs/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3592":74049,"_30925":74044,"_5":31260,"_21431":125176,"_28112":125177,"_3048":125178},[],"/docs/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3592":74050,"_30925":74044,"_5":31260,"_21431":125180,"_28112":125181,"_3048":125182},[],"/docs/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3592":74051,"_30925":74044,"_5":31260,"_21431":125184,"_28112":125185,"_3048":125186},[],"/docs/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3592":74052,"_30925":74044,"_5":31260,"_21431":125188,"_28112":125189,"_3048":125190},[],"/docs/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3592":74053,"_30925":74044,"_5":31260,"_21431":125192,"_28112":125193,"_3048":125194},[],"/docs/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3592":74054,"_30925":74044,"_5":31260,"_21431":125196,"_28112":125197,"_3048":125198},[],"/docs/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3592":74055,"_30925":74044,"_5":31260,"_21431":125200,"_28112":125201,"_3048":125202},[],"/docs/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3592":74056,"_30925":74044,"_5":31260,"_21431":125204,"_28112":125205,"_3048":125206},[],"/docs/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3592":74057,"_30925":74044,"_5":31260,"_21431":125208,"_28112":125209,"_3048":125210},[],"/docs/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3592":74058,"_30925":74044,"_5":31260,"_21431":125212,"_28112":125213,"_3048":125214},[],"/docs/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3592":74059,"_30925":74044,"_5":31260,"_21431":125216,"_28112":125217,"_3048":125218},[],"/docs/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3592":74060,"_30925":74044,"_5":31260,"_21431":125220,"_28112":125221,"_3048":125222},[],"/docs/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3592":74061,"_30925":74044,"_5":31260,"_21431":125224,"_28112":125225,"_3048":125226},[],"/docs/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3592":74062,"_30925":74044,"_21431":125228,"_5":14725,"_28112":74044,"_3048":125229},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3592":74063,"_30925":74044,"_21431":125231,"_5":14725,"_28112":74044,"_3048":125232},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3592":74064,"_30925":74044,"_21431":125234,"_5":14725,"_28112":125169,"_3048":125235},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3592":74065,"_30925":74044,"_21431":125237,"_5":14725,"_28112":125169,"_3048":125238},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3592":74066,"_30925":74044,"_21431":125240,"_5":14725,"_28112":125173,"_3048":125241},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3592":74067,"_30925":74044,"_21431":125243,"_5":14725,"_28112":125177,"_3048":125244},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3592":74068,"_30925":74044,"_21431":125246,"_5":14725,"_28112":125177,"_3048":125247},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3592":74069,"_30925":74044,"_21431":125249,"_5":14725,"_28112":125177,"_3048":125250},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3592":74070,"_30925":74044,"_21431":125252,"_5":14725,"_28112":125181,"_3048":125253},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3592":74071,"_30925":74044,"_21431":125255,"_5":14725,"_28112":125185,"_3048":125256},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3592":74072,"_30925":74044,"_21431":125258,"_5":14725,"_28112":125185,"_3048":125259},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3592":74073,"_30925":74044,"_21431":125261,"_5":14725,"_28112":125189,"_3048":125262},[],"La aplicación criptográfica puede:",{"_3592":74074,"_30925":74044,"_21431":125264,"_5":14725,"_28112":125189,"_3048":125265},[],"permitir o bloquear claves RSA;",{"_3592":74075,"_30925":74044,"_21431":125267,"_5":14725,"_28112":125189,"_3048":125268},[],"limitar los tamaños RSA admitidos;",{"_3592":74076,"_30925":74044,"_21431":125270,"_5":14725,"_28112":125189,"_3048":125271},[],"permitir o bloquear claves ECDSA;",{"_3592":74077,"_30925":74044,"_21431":125273,"_5":14725,"_28112":125189,"_3048":125274},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3592":74078,"_30925":74044,"_21431":125276,"_5":14725,"_28112":125189,"_3048":125277},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3592":74079,"_30925":74044,"_21431":125279,"_5":14725,"_28112":125193,"_3048":125280},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3592":74080,"_30925":74044,"_21431":125282,"_5":14725,"_28112":125193,"_3048":120469},[],{"_3592":74081,"_30925":74044,"_21431":125284,"_5":14725,"_28112":125193,"_3048":125285},[],"Primera opción",{"_3592":74082,"_30925":74044,"_21431":125287,"_5":14725,"_28112":125193,"_3048":125288},[],"Segunda opción",{"_3592":74083,"_30925":74044,"_21431":125290,"_5":14725,"_28112":125193,"_3048":125291},[],"Si no hay ninguna",{"_3592":74084,"_30925":74044,"_21431":125293,"_5":14725,"_28112":125193,"_3048":125294},[],"Firma directa con una CA",{"_3592":74085,"_30925":74044,"_21431":125296,"_5":14725,"_28112":125193,"_3048":125297},[],"`issuance_profile` incluido en la solicitud",{"_3592":74086,"_30925":74044,"_21431":125299,"_5":14725,"_28112":125193,"_3048":125300},[],"`issuance_profile_id` de la solicitud",{"_3592":74087,"_30925":74044,"_21431":125302,"_5":14725,"_28112":125193,"_3048":125303},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3592":74088,"_30925":74044,"_21431":125305,"_5":14725,"_28112":125193,"_3048":125306},[],"Emisión mediante DMS",{"_3592":74089,"_30925":74044,"_21431":125308,"_5":14725,"_28112":125193,"_3048":56770},[],{"_3592":74090,"_30925":74044,"_21431":125310,"_5":14725,"_28112":125193,"_3048":125311},[],"`settings.issuance_profile` incluido en el DMS",{"_3592":74091,"_30925":74044,"_21431":125313,"_5":14725,"_28112":125193,"_3048":125314},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3592":74092,"_30925":74044,"_21431":125316,"_5":14725,"_28112":125193,"_3048":125317},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3592":74093,"_30925":74044,"_21431":125319,"_5":14725,"_28112":125193,"_3048":125320},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3592":74094,"_30925":74044,"_21431":125322,"_5":14725,"_28112":125201,"_3048":125323},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3592":74095,"_30925":74044,"_21431":125325,"_5":14725,"_28112":125205,"_3048":125326},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3592":74096,"_30925":74044,"_21431":125328,"_5":14725,"_28112":125209,"_3048":125329},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3592":74097,"_30925":74044,"_21431":125331,"_5":14725,"_28112":125213,"_3048":125332},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3592":74098,"_30925":74044,"_21431":125334,"_5":14725,"_28112":125217,"_3048":125335},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3592":74099,"_30925":74044,"_21431":125337,"_5":14725,"_28112":125217,"_3048":125338},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3592":74100,"_30925":74044,"_21431":125340,"_5":14725,"_28112":125221,"_3048":125341},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3592":74101,"_30925":74044,"_21431":125343,"_5":14725,"_28112":125221,"_3048":125344},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3592":74102,"_30925":74044,"_21431":125346,"_5":14725,"_28112":125221,"_3048":125347},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3592":74103,"_30925":74044,"_21431":125349,"_5":14725,"_28112":125221,"_3048":125350},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3592":74104,"_30925":74044,"_21431":125352,"_5":14725,"_28112":125225,"_3048":125353},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3592":74105,"_30925":74044,"_21431":125355,"_5":14725,"_28112":125225,"_3048":125356},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3592":74106,"_30925":74106,"_5":15085,"_3048":125358,"_31263":125359,"_21431":125361,"_28112":74106},"Validación de certificados",[50505,120709,56180,125360],"Validación",[],{"_3592":74107,"_30925":74106,"_21431":125363,"_5":14725,"_28112":74106,"_3048":125364},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3592":74108,"_30925":74106,"_5":31260,"_21431":125366,"_28112":125367,"_3048":125368},[],"/docs/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3592":74109,"_30925":74106,"_5":31260,"_21431":125370,"_28112":125371,"_3048":125372},[],"/docs/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3592":74110,"_30925":74106,"_5":31260,"_21431":125374,"_28112":125375,"_3048":125376},[],"/docs/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3592":74111,"_30925":74106,"_21431":125378,"_5":14725,"_28112":74106,"_3048":125379},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3592":74112,"_30925":74106,"_21431":125381,"_5":14725,"_28112":125367,"_3048":125382},[],"Verifica estos criterios juntos:",{"_3592":74113,"_30925":74106,"_21431":125384,"_5":14725,"_28112":125367,"_3048":124349},[],{"_3592":74114,"_30925":74106,"_21431":125386,"_5":14725,"_28112":125367,"_3048":125387},[],"Resultado necesario",{"_3592":74115,"_30925":74106,"_21431":125389,"_5":14725,"_28112":125367,"_3048":125390},[],"Cadena y firma",{"_3592":74116,"_30925":74106,"_21431":125392,"_5":14725,"_28112":125367,"_3048":125393},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3592":74117,"_30925":74106,"_21431":125395,"_5":14725,"_28112":125367,"_3048":125396},[],"Fechas",{"_3592":74118,"_30925":74106,"_21431":125398,"_5":14725,"_28112":125367,"_3048":125399},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3592":74119,"_30925":74106,"_21431":125401,"_5":14725,"_28112":125367,"_3048":120379},[],{"_3592":74120,"_30925":74106,"_21431":125403,"_5":14725,"_28112":125367,"_3048":125404},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3592":74121,"_30925":74106,"_21431":125406,"_5":14725,"_28112":125367,"_3048":125407},[],"Uso",{"_3592":74122,"_30925":74106,"_21431":125409,"_5":14725,"_28112":125367,"_3048":125410},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3592":74123,"_30925":74106,"_21431":125412,"_5":14725,"_28112":125367,"_3048":125413},[],"Revocación",{"_3592":74124,"_30925":74106,"_21431":125415,"_5":14725,"_28112":125367,"_3048":125416},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3592":74125,"_30925":74106,"_21431":125418,"_5":14725,"_28112":125367,"_3048":125419},[],"Autorización",{"_3592":74126,"_30925":74106,"_21431":125421,"_5":14725,"_28112":125367,"_3048":125422},[],"La aplicación permite la acción a esa identidad.",{"_3592":74127,"_30925":74106,"_21431":125424,"_5":14725,"_28112":125367,"_3048":125425},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3592":74128,"_30925":74106,"_21431":125427,"_5":14725,"_28112":125371,"_3048":125428},[],"Mecanismo",{"_3592":74129,"_30925":74106,"_21431":125430,"_5":14725,"_28112":125371,"_3048":125431},[],"Cuándo utilizarlo",{"_3592":74130,"_30925":74106,"_21431":125433,"_5":14725,"_28112":125371,"_3048":125434},[],"Qué debes mantener",{"_3592":74131,"_30925":74106,"_21431":125436,"_5":14725,"_28112":125371,"_3048":56898},[],{"_3592":74132,"_30925":74106,"_21431":125438,"_5":14725,"_28112":125371,"_3048":125439},[],"Consulta del estado de un certificado concreto.",{"_3592":74133,"_30925":74106,"_21431":125441,"_5":14725,"_28112":125371,"_3048":125442},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3592":74134,"_30925":74106,"_21431":125444,"_5":14725,"_28112":125371,"_3048":56907},[],{"_3592":74135,"_30925":74106,"_21431":125446,"_5":14725,"_28112":125371,"_3048":125447},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3592":74136,"_30925":74106,"_21431":125449,"_5":14725,"_28112":125371,"_3048":125450},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3592":74137,"_30925":74106,"_21431":125452,"_5":14725,"_28112":125371,"_3048":125453},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3592":74138,"_30925":74106,"_21431":125455,"_5":14725,"_28112":125371,"_3048":125456},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3592":74139,"_30925":74106,"_21431":125458,"_5":14725,"_28112":125375,"_3048":125459},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3592":74140,"_30925":74106,"_21431":125461,"_5":14725,"_28112":125375,"_3048":125462},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3592":74141,"_30925":74106,"_21431":125464,"_5":14725,"_28112":125375,"_3048":125465},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3592":74142,"_30925":74106,"_21431":125467,"_5":14725,"_28112":125375,"_3048":125468},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3592":74143,"_30925":74106,"_21431":125470,"_5":14725,"_28112":125375,"_3048":125471},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3592":74144,"_30925":74106,"_21431":125473,"_5":14725,"_28112":125375,"_3048":125474},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3592":74145,"_30925":74106,"_21431":125476,"_5":14725,"_28112":125375,"_3048":125477},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3592":74146,"_30925":74106,"_21431":125479,"_5":14725,"_28112":125375,"_3048":125480},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3592":74147,"_30925":74106,"_21431":125482,"_5":14725,"_28112":125375,"_3048":125483},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3592":74148,"_30925":74148,"_5":15085,"_3048":125485,"_31263":125486,"_21431":125487,"_28112":74148},"Certificados",[50505,120709,56180,124720],[],{"_3592":74149,"_30925":74148,"_21431":125489,"_5":14725,"_28112":74148,"_3048":125490},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3592":74150,"_30925":74148,"_5":31260,"_21431":125492,"_28112":125493,"_3048":125494},[],"/docs/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3592":74151,"_30925":74148,"_5":31260,"_21431":125496,"_28112":125497,"_3048":125498},[],"/docs/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3592":74152,"_30925":74148,"_5":31260,"_21431":125500,"_28112":125501,"_3048":125502},[],"/docs/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3592":74153,"_30925":74148,"_5":31260,"_21431":125504,"_28112":125505,"_3048":125506},[],"/docs/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3592":74154,"_30925":74148,"_5":31260,"_21431":125508,"_28112":125509,"_3048":125510},[],"/docs/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3592":74155,"_30925":74148,"_5":31260,"_21431":125512,"_28112":125513,"_3048":125514},[],"/docs/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3592":74156,"_30925":74148,"_5":31260,"_21431":125516,"_28112":125517,"_3048":125518},[],"/docs/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3592":74157,"_30925":74148,"_5":31260,"_21431":125520,"_28112":125521,"_3048":125522},[],"/docs/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3592":74158,"_30925":74148,"_5":31260,"_21431":125524,"_28112":125525,"_3048":125526},[],"/docs/es/platform/pki/certificates#continúa","Continúa",{"_3592":74159,"_30925":74148,"_21431":125528,"_5":14725,"_28112":74148,"_3048":125529},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3592":74160,"_30925":74148,"_21431":125531,"_5":14725,"_28112":125493,"_3048":125532},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3592":74161,"_30925":74148,"_21431":125534,"_5":14725,"_28112":125493,"_3048":125535},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3592":74162,"_30925":74148,"_21431":125537,"_5":14725,"_28112":125493,"_3048":125538},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3592":74163,"_30925":74148,"_21431":125540,"_5":14725,"_28112":125493,"_3048":125541},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3592":74164,"_30925":74148,"_21431":125543,"_5":14725,"_28112":125493,"_3048":125544},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3592":74165,"_30925":74148,"_21431":125546,"_5":14725,"_28112":125493,"_3048":125547},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3592":74166,"_30925":74148,"_21431":125549,"_5":14725,"_28112":125493,"_3048":125550},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3592":74167,"_30925":74148,"_21431":125552,"_5":14725,"_28112":125497,"_3048":125553},[],"Descarga el PEM e inspecciónalo:",{"_3592":74168,"_30925":74148,"_21431":125555,"_5":14725,"_28112":125497,"_3048":125556},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3592":74169,"_30925":74148,"_21431":125558,"_5":14725,"_28112":125501,"_3048":125559},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3592":74170,"_30925":74148,"_21431":125561,"_5":14725,"_28112":125501,"_3048":125562},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3592":74171,"_30925":74148,"_21431":125564,"_5":14725,"_28112":125501,"_3048":125565},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3592":74172,"_30925":74148,"_21431":125567,"_5":14725,"_28112":125501,"_3048":125568},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3592":74173,"_30925":74148,"_21431":125570,"_5":14725,"_28112":125501,"_3048":125571},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3592":74174,"_30925":74148,"_21431":125573,"_5":14725,"_28112":125501,"_3048":125574},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3592":74175,"_30925":74148,"_21431":125576,"_5":14725,"_28112":125501,"_3048":125577},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3592":74176,"_30925":74148,"_21431":125579,"_5":14725,"_28112":125505,"_3048":125580},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3592":74177,"_30925":74148,"_21431":125582,"_5":14725,"_28112":125509,"_3048":125583},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3592":74178,"_30925":74148,"_21431":125585,"_5":14725,"_28112":125513,"_3048":125586},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3592":74179,"_30925":74148,"_21431":125588,"_5":14725,"_28112":125517,"_3048":125589},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3592":74180,"_30925":74148,"_21431":125591,"_5":14725,"_28112":125517,"_3048":125592},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3592":74181,"_30925":74148,"_21431":125594,"_5":14725,"_28112":125517,"_3048":125595},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3592":74182,"_30925":74148,"_21431":125597,"_5":14725,"_28112":125521,"_3048":125598},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3592":74183,"_30925":74148,"_21431":125600,"_5":14725,"_28112":125521,"_3048":125601},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3592":74184,"_30925":74148,"_21431":125603,"_5":14725,"_28112":125521,"_3048":125604},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3592":74185,"_30925":74148,"_21431":125606,"_5":14725,"_28112":125525,"_3048":125607},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3592":74186,"_30925":74148,"_21431":125609,"_5":14725,"_28112":125525,"_3048":125610},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3592":74187,"_30925":74187,"_5":15085,"_3048":125612,"_31263":125613,"_21431":125615,"_28112":74187},"Ciclo de vida de un certificado",[50505,120709,56180,125614],"Conceptos",[],{"_3592":74188,"_30925":74187,"_21431":125617,"_5":14725,"_28112":74187,"_3048":125618},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3592":74189,"_30925":74187,"_5":31260,"_21431":125620,"_28112":125621,"_3048":125622},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3592":74190,"_30925":74187,"_5":31260,"_21431":125624,"_28112":125625,"_3048":125626},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3592":74191,"_30925":74187,"_5":31260,"_21431":125628,"_28112":125629,"_3048":125630},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3592":74192,"_30925":74187,"_5":31260,"_21431":125632,"_28112":125633,"_3048":125634},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3592":74193,"_30925":74187,"_5":31260,"_21431":125636,"_28112":125637,"_3048":125638},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3592":74194,"_30925":74187,"_5":31260,"_21431":125640,"_28112":125641,"_3048":125642},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3592":74195,"_30925":74187,"_5":31260,"_21431":125644,"_28112":125645,"_3048":123343},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3592":74196,"_30925":74187,"_5":31260,"_21431":125647,"_28112":125648,"_3048":125649},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3592":74197,"_30925":74187,"_5":31260,"_21431":125651,"_28112":125652,"_3048":125653},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3592":74198,"_30925":74187,"_5":31260,"_21431":125655,"_28112":125656,"_3048":125657},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3592":74199,"_30925":74187,"_21431":125659,"_5":14725,"_28112":74187,"_3048":125660},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3592":74200,"_30925":74187,"_21431":125662,"_5":14725,"_28112":125625,"_3048":125663},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3592":74201,"_30925":74187,"_21431":125665,"_5":14725,"_28112":125629,"_3048":125666},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3592":74202,"_30925":74187,"_21431":125668,"_5":14725,"_28112":125633,"_3048":125669},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3592":74203,"_30925":74187,"_21431":125671,"_5":14725,"_28112":125637,"_3048":125672},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3592":74204,"_30925":74187,"_21431":125674,"_5":14725,"_28112":125641,"_3048":125675},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3592":74205,"_30925":74187,"_21431":125677,"_5":14725,"_28112":125645,"_3048":125678},[],"Lamassu persiste cuatro estados X.509:",{"_3592":74206,"_30925":74187,"_21431":125680,"_5":14725,"_28112":125645,"_3048":125681},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3592":74207,"_30925":74187,"_21431":125683,"_5":14725,"_28112":125645,"_3048":125684},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3592":74208,"_30925":74187,"_21431":125686,"_5":14725,"_28112":125645,"_3048":125687},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3592":74209,"_30925":74187,"_21431":125689,"_5":14725,"_28112":125645,"_3048":125690},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3592":74210,"_30925":74187,"_21431":125692,"_5":14725,"_28112":125645,"_3048":125693},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3592":74211,"_30925":74187,"_21431":125695,"_5":14725,"_28112":125648,"_3048":125696},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3592":74212,"_30925":74187,"_21431":125698,"_5":14725,"_28112":125648,"_3048":125699},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3592":74213,"_30925":74187,"_21431":125701,"_5":14725,"_28112":125648,"_3048":125702},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3592":74214,"_30925":74187,"_21431":125704,"_5":14725,"_28112":125652,"_3048":125705},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3592":74215,"_30925":74187,"_21431":125707,"_5":14725,"_28112":125652,"_3048":125708},[],"Antes de confirmar:",{"_3592":74216,"_30925":74187,"_21431":125710,"_5":14725,"_28112":125652,"_3048":125711},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3592":74217,"_30925":74187,"_21431":125713,"_5":14725,"_28112":125652,"_3048":125714},[],"Distribuye la nueva cadena de confianza.",{"_3592":74218,"_30925":74187,"_21431":125716,"_5":14725,"_28112":125652,"_3048":125717},[],"Reemite las identidades necesarias.",{"_3592":74219,"_30925":74187,"_21431":125719,"_5":14725,"_28112":125652,"_3048":125720},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3592":74220,"_30925":74187,"_21431":125722,"_5":14725,"_28112":125652,"_3048":125723},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3592":74221,"_30925":74187,"_21431":125725,"_5":14725,"_28112":125652,"_3048":125726},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3592":74222,"_30925":74187,"_21431":125728,"_5":14725,"_28112":125656,"_3048":125729},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3592":74223,"_30925":74187,"_21431":125731,"_5":14725,"_28112":125656,"_3048":125732},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3592":74224,"_30925":74187,"_21431":125734,"_5":14725,"_28112":125656,"_3048":125735},[],"Cambios de estado y razones de revocación.",{"_3592":74225,"_30925":74187,"_21431":125737,"_5":14725,"_28112":125656,"_3048":125738},[],"Publicación y vigencia de OCSP y CRLs.",{"_3592":74226,"_30925":74187,"_21431":125740,"_5":14725,"_28112":125656,"_3048":125741},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3592":74227,"_30925":74187,"_21431":125743,"_5":14725,"_28112":125656,"_3048":125744},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3592":74228,"_30925":74228,"_5":15085,"_3048":125746,"_31263":125747,"_21431":125748,"_28112":74228},"Modelo de confianza",[50505,120709,56180,125614],[],{"_3592":74229,"_30925":74228,"_21431":125750,"_5":14725,"_28112":74228,"_3048":125751},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3592":74230,"_30925":74228,"_5":31260,"_21431":125753,"_28112":125754,"_3048":125755},[],"/docs/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3592":74231,"_30925":74228,"_5":31260,"_21431":125757,"_28112":125758,"_3048":125759},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3592":74232,"_30925":74228,"_5":31260,"_21431":125761,"_28112":125762,"_3048":125763},[],"/docs/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3592":74233,"_30925":74228,"_5":31260,"_21431":125765,"_28112":125766,"_3048":125767},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3592":74234,"_30925":74228,"_5":31260,"_21431":125769,"_28112":125770,"_3048":125771},[],"/docs/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3592":74235,"_30925":74228,"_5":31260,"_21431":125773,"_28112":125774,"_3048":125775},[],"/docs/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3592":74236,"_30925":74228,"_5":31260,"_21431":125777,"_28112":125778,"_3048":125779},[],"/docs/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3592":74237,"_30925":74228,"_5":31260,"_21431":125781,"_28112":125782,"_3048":125783},[],"/docs/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3592":74238,"_30925":74228,"_5":31260,"_21431":125785,"_28112":125786,"_3048":125787},[],"/docs/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3592":74239,"_30925":74228,"_5":31260,"_21431":125789,"_28112":125790,"_3048":125791},[],"/docs/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3592":74240,"_30925":74228,"_21431":125793,"_5":14725,"_28112":74228,"_3048":125794},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3592":74241,"_30925":74228,"_21431":125796,"_5":14725,"_28112":125758,"_3048":125797},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3592":74242,"_30925":74228,"_21431":125799,"_5":14725,"_28112":125762,"_3048":125800},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3592":74243,"_30925":74228,"_21431":125802,"_5":14725,"_28112":125766,"_3048":125803},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3592":74244,"_30925":74228,"_21431":125805,"_5":14725,"_28112":125770,"_3048":125806},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3592":74245,"_30925":74228,"_21431":125808,"_5":14725,"_28112":125774,"_3048":125809},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3592":74246,"_30925":74228,"_21431":125811,"_5":14725,"_28112":125774,"_3048":125812},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3592":74247,"_30925":74228,"_21431":125814,"_5":14725,"_28112":125774,"_3048":125815},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3592":74248,"_30925":74228,"_21431":125817,"_5":14725,"_28112":125774,"_3048":125818},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3592":74249,"_30925":74228,"_21431":125820,"_5":14725,"_28112":125774,"_3048":125821},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3592":74250,"_30925":74228,"_21431":125823,"_5":14725,"_28112":125774,"_3048":125824},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3592":74251,"_30925":74228,"_21431":125826,"_5":14725,"_28112":125778,"_3048":125827},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3592":74252,"_30925":74228,"_21431":125829,"_5":14725,"_28112":125778,"_3048":125830},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3592":74253,"_30925":74228,"_21431":125832,"_5":14725,"_28112":125778,"_3048":125833},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3592":74254,"_30925":74228,"_21431":125835,"_5":14725,"_28112":125778,"_3048":125836},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3592":74255,"_30925":74228,"_21431":125838,"_5":14725,"_28112":125778,"_3048":125839},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3592":74256,"_30925":74228,"_21431":125841,"_5":14725,"_28112":125782,"_3048":125842},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3592":74257,"_30925":74228,"_21431":125844,"_5":14725,"_28112":125782,"_3048":125845},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3592":74258,"_30925":74228,"_21431":125847,"_5":14725,"_28112":125782,"_3048":125848},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3592":74259,"_30925":74228,"_21431":125850,"_5":14725,"_28112":125782,"_3048":125851},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3592":74260,"_30925":74228,"_21431":125853,"_5":14725,"_28112":125782,"_3048":125854},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3592":74261,"_30925":74228,"_21431":125856,"_5":14725,"_28112":125782,"_3048":125857},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3592":74262,"_30925":74228,"_21431":125859,"_5":14725,"_28112":125782,"_3048":125860},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3592":74263,"_30925":74228,"_21431":125862,"_5":14725,"_28112":125786,"_3048":125863},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3592":74264,"_30925":74228,"_21431":125865,"_5":14725,"_28112":125790,"_3048":125866},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3592":74265,"_30925":74228,"_21431":125868,"_5":14725,"_28112":125790,"_3048":125869},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3592":74266,"_30925":74228,"_21431":125871,"_5":14725,"_28112":125790,"_3048":125872},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3592":74267,"_30925":74228,"_21431":125874,"_5":14725,"_28112":125790,"_3048":125875},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3592":74268,"_30925":74228,"_21431":125877,"_5":14725,"_28112":125790,"_3048":125878},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3592":74269,"_30925":74228,"_21431":125880,"_5":14725,"_28112":125790,"_3048":125881},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3592":74270,"_30925":74228,"_21431":125883,"_5":14725,"_28112":125790,"_3048":125884},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3592":74271,"_30925":74271,"_5":15085,"_3048":125886,"_31263":125887,"_21431":125888,"_28112":74271},"Listas de revocación (CRL)",[50505,120709,56180,125360],[],{"_3592":74272,"_30925":74271,"_21431":125890,"_5":14725,"_28112":74271,"_3048":125891},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3592":74273,"_30925":74271,"_5":31260,"_21431":125893,"_28112":125894,"_3048":125895},[],"/docs/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3592":74274,"_30925":74271,"_5":31260,"_21431":125897,"_28112":125898,"_3048":125899},[],"/docs/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3592":74275,"_30925":74271,"_5":31260,"_21431":125901,"_28112":125902,"_3048":125903},[],"/docs/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3592":74276,"_30925":74271,"_5":31260,"_21431":125905,"_28112":125906,"_3048":125907},[],"/docs/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3592":74277,"_30925":74271,"_5":31260,"_21431":125909,"_28112":125910,"_3048":125911},[],"/docs/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3592":74278,"_30925":74271,"_5":31260,"_21431":125913,"_28112":125914,"_3048":125915},[],"/docs/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3592":74279,"_30925":74271,"_5":31260,"_21431":125917,"_28112":125918,"_3048":125919},[],"/docs/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3592":74280,"_30925":74271,"_5":31260,"_21431":125921,"_28112":125922,"_3048":125923},[],"/docs/es/platform/pki/crl#referencias","Referencias",{"_3592":74281,"_30925":74271,"_21431":125925,"_5":14725,"_28112":74271,"_3048":125926},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3592":74282,"_30925":74271,"_21431":125928,"_5":14725,"_28112":125894,"_3048":125929},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3592":74283,"_30925":74271,"_21431":125931,"_5":14725,"_28112":125894,"_3048":125932},[],"Campo",{"_3592":74284,"_30925":74271,"_21431":125934,"_5":14725,"_28112":125894,"_3048":122383},[],{"_3592":74285,"_30925":74271,"_21431":125936,"_5":14725,"_28112":125894,"_3048":52137},[],{"_3592":74286,"_30925":74271,"_21431":125938,"_5":14725,"_28112":125894,"_3048":125939},[],"ID de la CA a la que pertenecen los ajustes.",{"_3592":74287,"_30925":74271,"_21431":125941,"_5":14725,"_28112":125894,"_3048":57406},[],{"_3592":74288,"_30925":74271,"_21431":125943,"_5":14725,"_28112":125894,"_3048":125944},[],"Ciclo de vida de los ajustes. Los `ACTIVE` generan CRLs. Los `FINAL` pertenecen a una CA revocada de forma permanente o caducada: la primera publica una CRL final, válida hasta que expire el certificado actual de la CA, y la segunda pasa a `FINAL` sin CRL final. Los `ARCHIVED` pertenecen a una CA eliminada: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3592":74289,"_30925":74271,"_21431":125946,"_5":14725,"_28112":125894,"_3048":57412},[],{"_3592":74290,"_30925":74271,"_21431":125948,"_5":14725,"_28112":125894,"_3048":125949},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3592":74291,"_30925":74271,"_21431":125951,"_5":14725,"_28112":125894,"_3048":57418},[],{"_3592":74292,"_30925":74271,"_21431":125953,"_5":14725,"_28112":125894,"_3048":125954},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3592":74293,"_30925":74271,"_21431":125956,"_5":14725,"_28112":125894,"_3048":125957},[],"Campo de `crl_options`",{"_3592":74294,"_30925":74271,"_21431":125959,"_5":14725,"_28112":125894,"_3048":122383},[],{"_3592":74295,"_30925":74271,"_21431":125961,"_5":14725,"_28112":125894,"_3048":125962},[],"Valor inicial",{"_3592":74296,"_30925":74271,"_21431":125964,"_5":14725,"_28112":125894,"_3048":57432},[],{"_3592":74297,"_30925":74271,"_21431":125966,"_5":14725,"_28112":125894,"_3048":125967},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3592":74298,"_30925":74271,"_21431":125969,"_5":14725,"_28112":125894,"_3048":125970},[],"7 días.",{"_3592":74299,"_30925":74271,"_21431":125972,"_5":14725,"_28112":125894,"_3048":57441},[],{"_3592":74300,"_30925":74271,"_21431":125974,"_5":14725,"_28112":125894,"_3048":125975},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3592":74301,"_30925":74271,"_21431":125977,"_5":14725,"_28112":125894,"_3048":125978},[],"6 días y 23 horas.",{"_3592":74302,"_30925":74271,"_21431":125980,"_5":14725,"_28112":125894,"_3048":57450},[],{"_3592":74303,"_30925":74271,"_21431":125982,"_5":14725,"_28112":125894,"_3048":125983},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3592":74304,"_30925":74271,"_21431":125985,"_5":14725,"_28112":125894,"_3048":57456},[],{"_3592":74305,"_30925":74271,"_21431":125987,"_5":14725,"_28112":125894,"_3048":57459},[],{"_3592":74306,"_30925":74271,"_21431":125989,"_5":14725,"_28112":125894,"_3048":125990},[],"Número de serie del certificado existente que firma la CRL.",{"_3592":74307,"_30925":74271,"_21431":125992,"_5":14725,"_28112":125894,"_3048":125993},[],"Número de serie del certificado actual de la CA.",{"_3592":74308,"_30925":74271,"_21431":125995,"_5":14725,"_28112":125894,"_3048":125996},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3592":74309,"_30925":74271,"_21431":125998,"_5":14725,"_28112":125894,"_3048":125999},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3592":74310,"_30925":74271,"_21431":126001,"_5":14725,"_28112":125894,"_3048":126002},[],"Las decisiones del ciclo de vida de la CRL — cuándo deja de publicarse y cuándo expira la CRL final — usan únicamente el certificado actual de la CA. Si un certificado reemitido expira antes que un certificado antiguo que sigue vigente, la publicación de CRLs puede detenerse, o la CRL final puede expirar, mientras el certificado antiguo siga vigente. Es una limitación aceptada del comportamiento actual.",{"_3592":74311,"_30925":74271,"_21431":126004,"_5":14725,"_28112":125894,"_3048":126005},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3592":74312,"_30925":74271,"_21431":126007,"_5":14725,"_28112":125894,"_3048":126008},[],"Eliminar una CA conserva sus ajustes de CRL; permanecen hasta que borres los archivados por API o desde la página Verification Authorities de la consola (consulta API de gestión de los ajustes de CRL). Lo que ocurre con ellos depende de cómo terminó la CA:",{"_3592":74313,"_30925":74271,"_21431":126010,"_5":14725,"_28112":125894,"_3048":126011},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3592":74314,"_30925":74271,"_21431":126013,"_5":14725,"_28112":125894,"_3048":126014},[],"Revocar una CA de forma permanente o dejar que caduque finaliza sus ajustes: su `status` pasa a `FINAL`, cualquier `PUT` devuelve 409 y no se genera ninguna CRL nueva. Una CA revocada permanentemente publica una CRL final, válida hasta que expire el certificado actual de la CA; una CA caducada no recibe ninguna. Eliminar después la CA archiva sus ajustes, que pasan a comportarse como los archivados de la migración.",{"_3592":74315,"_30925":74271,"_21431":126016,"_5":14725,"_28112":125894,"_3048":126017},[],"Los ajustes dejan de poder editarse mientras su `status` no sea `ACTIVE`. Ajusta validez y firmante antes de revocar o eliminar una CA.",{"_3592":74316,"_30925":74271,"_21431":126019,"_5":14725,"_28112":125894,"_3048":126020},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3592":74317,"_30925":74271,"_21431":126022,"_5":14725,"_28112":125894,"_3048":126023},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3592":74318,"_30925":74271,"_21431":126025,"_5":14725,"_28112":125894,"_3048":126026},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3592":74319,"_30925":74271,"_21431":126028,"_5":14725,"_28112":125898,"_3048":126029},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3592":74320,"_30925":74271,"_21431":126031,"_5":14725,"_28112":125898,"_3048":126032},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3592":74321,"_30925":74271,"_21431":126034,"_5":14725,"_28112":125898,"_3048":126035},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3592":74322,"_30925":74271,"_21431":126037,"_5":14725,"_28112":125898,"_3048":126038},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3592":74323,"_30925":74271,"_21431":126040,"_5":14725,"_28112":125902,"_3048":126041},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3592":74324,"_30925":74271,"_21431":126043,"_5":14725,"_28112":125902,"_3048":126044},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3592":74325,"_30925":74271,"_21431":126046,"_5":14725,"_28112":125902,"_3048":126047},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3592":74326,"_30925":74271,"_21431":126049,"_5":14725,"_28112":125902,"_3048":126050},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3592":74327,"_30925":74271,"_21431":126052,"_5":14725,"_28112":125902,"_3048":126053},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3592":74328,"_30925":74271,"_21431":126055,"_5":14725,"_28112":125902,"_3048":126056},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3592":74329,"_30925":74271,"_21431":126058,"_5":14725,"_28112":125902,"_3048":126059},[],"Los ajustes con `status` distinto de `ACTIVE` — `FINAL` o `ARCHIVED` — se omiten: nada regenera su CRL.",{"_3592":74330,"_30925":74271,"_21431":126061,"_5":14725,"_28112":125902,"_3048":126062},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3592":74331,"_30925":74271,"_21431":126064,"_5":14725,"_28112":125902,"_3048":126065},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3592":74332,"_30925":74271,"_21431":126067,"_5":14725,"_28112":125906,"_3048":126068},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3592":74333,"_30925":74271,"_21431":126070,"_5":14725,"_28112":125906,"_3048":126071},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3592":74334,"_30925":74271,"_21431":126073,"_5":14725,"_28112":125910,"_3048":126074},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3592":74335,"_30925":74271,"_21431":126076,"_5":14725,"_28112":125910,"_3048":126077},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3592":74336,"_30925":74271,"_21431":126079,"_5":14725,"_28112":125910,"_3048":126080},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3592":74337,"_30925":74271,"_21431":126082,"_5":14725,"_28112":125910,"_3048":126083},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3592":74338,"_30925":74271,"_21431":126085,"_5":14725,"_28112":125910,"_3048":126086},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3592":74339,"_30925":74271,"_21431":126088,"_5":14725,"_28112":125914,"_3048":126089},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3592":74340,"_30925":74271,"_21431":126091,"_5":14725,"_28112":125914,"_3048":122572},[],{"_3592":74341,"_30925":74271,"_21431":126093,"_5":14725,"_28112":125914,"_3048":126094},[],"Path relativo",{"_3592":74342,"_30925":74271,"_21431":126096,"_5":14725,"_28112":125914,"_3048":120469},[],{"_3592":74343,"_30925":74271,"_21431":126098,"_5":14725,"_28112":125914,"_3048":57571},[],{"_3592":74344,"_30925":74271,"_21431":126100,"_5":14725,"_28112":125914,"_3048":57574},[],{"_3592":74345,"_30925":74271,"_21431":126102,"_5":14725,"_28112":125914,"_3048":126103},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3592":74346,"_30925":74271,"_21431":126105,"_5":14725,"_28112":125914,"_3048":57571},[],{"_3592":74347,"_30925":74271,"_21431":126107,"_5":14725,"_28112":125914,"_3048":57582},[],{"_3592":74348,"_30925":74271,"_21431":126109,"_5":14725,"_28112":125914,"_3048":126110},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3592":74349,"_30925":74271,"_21431":126112,"_5":14725,"_28112":125914,"_3048":57588},[],{"_3592":74350,"_30925":74271,"_21431":126114,"_5":14725,"_28112":125914,"_3048":57582},[],{"_3592":74351,"_30925":74271,"_21431":126116,"_5":14725,"_28112":125914,"_3048":126117},[],"Sustituir la configuración de CRL de una CA.",{"_3592":74352,"_30925":74271,"_21431":126119,"_5":14725,"_28112":125914,"_3048":57596},[],{"_3592":74353,"_30925":74271,"_21431":126121,"_5":14725,"_28112":125914,"_3048":57582},[],{"_3592":74354,"_30925":74271,"_21431":126123,"_5":14725,"_28112":125914,"_3048":126124},[],"Eliminar los ajustes de CRL archivados de una CA.",{"_3592":74355,"_30925":74271,"_21431":126126,"_5":14725,"_28112":125914,"_3048":126127},[],"Necesitas autenticación y permisos de lectura, actualización o borrado de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3592":74356,"_30925":74271,"_21431":126129,"_5":14725,"_28112":125914,"_3048":126130},[],"Los ajustes archivados, cuya CA ya no existe, pueden eliminarse con `DELETE`: la llamada devuelve 204 en caso de éxito, 404 cuando la CA no tiene ajustes y 409 mientras los ajustes no estén todavía archivados. Tras el borrado, el endpoint público `/crl/{id}` y cualquier endpoint heredado `/crl/<ski>` dejan de servir la lista de la CA, aunque los ficheros de CRL publicados permanecen en el bucket. Conserva los ajustes archivados mientras cualquier certificado emitido por la CA pueda necesitar evidencia de revocación: `DELETE` deja de servir la lista inmediatamente, independientemente de la validez de `latest_crl`. La acción no puede deshacerse.",{"_3592":74357,"_30925":74271,"_21431":126132,"_5":14725,"_28112":125914,"_3048":126133},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3592":74358,"_30925":74271,"_21431":126135,"_5":14725,"_28112":125918,"_3048":126136},[],"Síntoma",{"_3592":74359,"_30925":74271,"_21431":126138,"_5":14725,"_28112":125918,"_3048":126139},[],"Causa",{"_3592":74360,"_30925":74271,"_21431":126141,"_5":14725,"_28112":125918,"_3048":126142},[],"Acción",{"_3592":74361,"_30925":74271,"_21431":126144,"_5":14725,"_28112":125918,"_3048":126145},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3592":74362,"_30925":74271,"_21431":126147,"_5":14725,"_28112":125918,"_3048":126148},[],"Los ajustes no están `ACTIVE`: revocar la CA de forma permanente o dejar que caduque los finalizó, o la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3592":74363,"_30925":74271,"_21431":126150,"_5":14725,"_28112":125918,"_3048":126151},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3592":74364,"_30925":74271,"_21431":126153,"_5":14725,"_28112":125918,"_3048":126154},[],"`DELETE /v1/crl-settings/{ca-id}` devuelve 409.",{"_3592":74365,"_30925":74271,"_21431":126156,"_5":14725,"_28112":125918,"_3048":126157},[],"Los ajustes no están todavía `ARCHIVED`: la CA no se ha eliminado.",{"_3592":74366,"_30925":74271,"_21431":126159,"_5":14725,"_28112":125918,"_3048":126160},[],"Elimina primero la CA; su eliminación archiva los ajustes.",{"_3592":74367,"_30925":74271,"_21431":126162,"_5":14725,"_28112":125918,"_3048":126163},[],"`PUT` devuelve 400.",{"_3592":74368,"_30925":74271,"_21431":126165,"_5":14725,"_28112":125918,"_3048":126166},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3592":74369,"_30925":74271,"_21431":126168,"_5":14725,"_28112":125918,"_3048":126169},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3592":74370,"_30925":74271,"_21431":126171,"_5":14725,"_28112":125918,"_3048":126172},[],"`PUT` devuelve 404.",{"_3592":74371,"_30925":74271,"_21431":126174,"_5":14725,"_28112":125918,"_3048":126175},[],"La CA o el certificado firmante nuevo no existen, o la CA no tiene ajustes de CRL (por ejemplo, una CA importada).",{"_3592":74372,"_30925":74271,"_21431":126177,"_5":14725,"_28112":125918,"_3048":126178},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3592":74373,"_30925":74271,"_21431":126180,"_5":14725,"_28112":125918,"_3048":126181},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3592":74374,"_30925":74271,"_21431":126183,"_5":14725,"_28112":125918,"_3048":126184},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3592":74375,"_30925":74271,"_21431":126186,"_5":14725,"_28112":125918,"_3048":126187},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3592":74376,"_30925":74271,"_21431":126189,"_5":14725,"_28112":125918,"_3048":126190},[],"La CRL no cambia tras revocar un certificado.",{"_3592":74377,"_30925":74271,"_21431":126192,"_5":14725,"_28112":125918,"_3048":126193},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3592":74378,"_30925":74271,"_21431":126195,"_5":14725,"_28112":125918,"_3048":126196},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3592":74379,"_30925":74271,"_21431":126198,"_5":14725,"_28112":125918,"_3048":126199},[],"Un verificador rechaza la CRL por el emisor.",{"_3592":74380,"_30925":74271,"_21431":126201,"_5":14725,"_28112":125918,"_3048":126202},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3592":74381,"_30925":74271,"_21431":126204,"_5":14725,"_28112":125918,"_3048":126205},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3592":74382,"_30925":74271,"_21431":126207,"_5":14725,"_28112":125922,"_3048":126208},[],"RFC 5280: perfil X.509 y CRL.",{"_3592":74383,"_30925":74271,"_21431":126210,"_5":14725,"_28112":125922,"_3048":57688},[],{"_3592":74384,"_30925":74271,"_21431":126212,"_5":14725,"_28112":125922,"_3048":57691},[],{"_3592":74385,"_30925":74271,"_21431":126214,"_5":14725,"_28112":125922,"_3048":126215},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3592":74386,"_30925":74271,"_21431":126217,"_5":14725,"_28112":125922,"_3048":126218},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3592":74387,"_30925":74387,"_5":15085,"_3048":126220,"_31263":126221,"_21431":126222,"_28112":74387},"Claves y motores criptográficos",[50505,120709,56180,124720],[],{"_3592":74388,"_30925":74387,"_21431":126224,"_5":14725,"_28112":74387,"_3048":126225},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3592":74389,"_30925":74387,"_5":31260,"_21431":126227,"_28112":126228,"_3048":126229},[],"/docs/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3592":74390,"_30925":74387,"_5":31260,"_21431":126231,"_28112":126232,"_3048":126233},[],"/docs/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3592":74391,"_30925":74387,"_5":31260,"_21431":126235,"_28112":126236,"_3048":57716},[],"/docs/es/platform/pki/key-management#file-system",{"_3592":74392,"_30925":74387,"_5":31260,"_21431":126238,"_28112":126239,"_3048":57720},[],"/docs/es/platform/pki/key-management#hashicorp-vault",{"_3592":74393,"_30925":74387,"_5":31260,"_21431":126241,"_28112":126242,"_3048":57724},[],"/docs/es/platform/pki/key-management#aws-secrets-manager",{"_3592":74394,"_30925":74387,"_5":31260,"_21431":126244,"_28112":126245,"_3048":57728},[],"/docs/es/platform/pki/key-management#aws-kms",{"_3592":74395,"_30925":74387,"_5":31260,"_21431":126247,"_28112":126248,"_3048":57732},[],"/docs/es/platform/pki/key-management#pkcs11",{"_3592":74396,"_30925":74387,"_5":31260,"_21431":126250,"_28112":126251,"_3048":57736},[],"/docs/es/platform/pki/key-management#azure-key-vault",{"_3592":74397,"_30925":74387,"_5":31260,"_21431":126253,"_28112":126254,"_3048":126255},[],"/docs/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3592":74398,"_30925":74387,"_5":31260,"_21431":126257,"_28112":126258,"_3048":126259},[],"/docs/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3592":74399,"_30925":74387,"_5":31260,"_21431":126261,"_28112":126262,"_3048":126263},[],"/docs/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3592":74400,"_30925":74387,"_5":31260,"_21431":126265,"_28112":126266,"_3048":126267},[],"/docs/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3592":74401,"_30925":74387,"_5":31260,"_21431":126269,"_28112":126270,"_3048":126271},[],"/docs/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3592":74402,"_30925":74387,"_5":31260,"_21431":126273,"_28112":126274,"_3048":126275},[],"/docs/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3592":74403,"_30925":74387,"_5":31260,"_21431":126277,"_28112":126278,"_3048":126279},[],"/docs/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3592":74404,"_30925":74387,"_5":31260,"_21431":126281,"_28112":126282,"_3048":57768},[],"/docs/es/platform/pki/key-management#sign",{"_3592":74405,"_30925":74387,"_5":31260,"_21431":126284,"_28112":126285,"_3048":57772},[],"/docs/es/platform/pki/key-management#verify",{"_3592":74406,"_30925":74387,"_5":31260,"_21431":126287,"_28112":126288,"_3048":126289},[],"/docs/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3592":74407,"_30925":74387,"_5":31260,"_21431":126291,"_28112":126292,"_3048":126293},[],"/docs/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3592":74408,"_30925":74387,"_5":31260,"_21431":126295,"_28112":126296,"_3048":126297},[],"/docs/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3592":74409,"_30925":74387,"_21431":126299,"_5":14725,"_28112":74387,"_3048":126300},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3592":74410,"_30925":74387,"_21431":126302,"_5":14725,"_28112":74387,"_3048":126303},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3592":74411,"_30925":74387,"_21431":126305,"_5":14725,"_28112":126228,"_3048":126306},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3592":74412,"_30925":74387,"_21431":126308,"_5":14725,"_28112":126228,"_3048":126309},[],"En la práctica, permite:",{"_3592":74413,"_30925":74387,"_21431":126311,"_5":14725,"_28112":126228,"_3048":126312},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3592":74414,"_30925":74387,"_21431":126314,"_5":14725,"_28112":126228,"_3048":126315},[],"Importar claves creadas externamente.",{"_3592":74415,"_30925":74387,"_21431":126317,"_5":14725,"_28112":126228,"_3048":126318},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3592":74416,"_30925":74387,"_21431":126320,"_5":14725,"_28112":126228,"_3048":126321},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3592":74417,"_30925":74387,"_21431":126323,"_5":14725,"_28112":126232,"_3048":126324},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3592":74418,"_30925":74387,"_21431":126326,"_5":14725,"_28112":126232,"_3048":126327},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3592":74419,"_30925":74387,"_21431":126329,"_5":14725,"_28112":126232,"_3048":126330},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3592":74420,"_30925":74387,"_21431":126332,"_5":14725,"_28112":126236,"_3048":126333},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3592":74421,"_30925":74387,"_21431":126335,"_5":14725,"_28112":126239,"_3048":126336},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3592":74422,"_30925":74387,"_21431":126338,"_5":14725,"_28112":126239,"_3048":126339},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3592":74423,"_30925":74387,"_21431":126341,"_5":14725,"_28112":126242,"_3048":126342},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3592":74424,"_30925":74387,"_21431":126344,"_5":14725,"_28112":126245,"_3048":126345},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3592":74425,"_30925":74387,"_21431":126347,"_5":14725,"_28112":126248,"_3048":126348},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3592":74426,"_30925":74387,"_21431":126350,"_5":14725,"_28112":126251,"_3048":126351},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3592":74427,"_30925":74387,"_21431":126353,"_5":14725,"_28112":126251,"_3048":126354},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3592":74428,"_30925":74387,"_21431":126356,"_5":14725,"_28112":126251,"_3048":126357},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3592":74429,"_30925":74387,"_21431":126359,"_5":14725,"_28112":126251,"_3048":126360},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3592":74430,"_30925":74387,"_21431":126362,"_5":14725,"_28112":126254,"_3048":126363},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3592":74431,"_30925":74387,"_21431":126365,"_5":14725,"_28112":126254,"_3048":126366},[],"La tabla incluye los siguientes campos:",{"_3592":74432,"_30925":74387,"_21431":126368,"_5":14725,"_28112":126254,"_3048":126369},[],"**Name**: nombre descriptivo de la clave.",{"_3592":74433,"_30925":74387,"_21431":126371,"_5":14725,"_28112":126254,"_3048":126372},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3592":74434,"_30925":74387,"_21431":126374,"_5":14725,"_28112":126254,"_3048":126375},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3592":74435,"_30925":74387,"_21431":126377,"_5":14725,"_28112":126254,"_3048":126378},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3592":74436,"_30925":74387,"_21431":126380,"_5":14725,"_28112":126254,"_3048":126381},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3592":74437,"_30925":74387,"_21431":126383,"_5":14725,"_28112":126254,"_3048":126384},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3592":74438,"_30925":74387,"_21431":126386,"_5":14725,"_28112":126254,"_3048":126387},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3592":74439,"_30925":74387,"_21431":126389,"_5":14725,"_28112":126254,"_3048":126390},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3592":74440,"_30925":74387,"_21431":126392,"_5":14725,"_28112":126254,"_3048":126393},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3592":74441,"_30925":74387,"_21431":126395,"_5":14725,"_28112":126254,"_3048":126396},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3592":74442,"_30925":74387,"_21431":126398,"_5":14725,"_28112":126254,"_3048":126399},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3592":74443,"_30925":74387,"_21431":126401,"_5":14725,"_28112":126254,"_3048":126402},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3592":74444,"_30925":74387,"_21431":126404,"_5":14725,"_28112":126254,"_3048":126405},[],"**Delete Key** para eliminar la clave del sistema.",{"_3592":74445,"_30925":74387,"_21431":126407,"_5":14725,"_28112":126258,"_3048":126408},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3592":74446,"_30925":74387,"_21431":126410,"_5":14725,"_28112":126262,"_3048":126411},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3592":74447,"_30925":74387,"_21431":126413,"_5":14725,"_28112":126262,"_3048":126414},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3592":74448,"_30925":74387,"_21431":126416,"_5":14725,"_28112":126262,"_3048":126417},[],"**Key Name**: nombre único y descriptivo.",{"_3592":74449,"_30925":74387,"_21431":126419,"_5":14725,"_28112":126262,"_3048":126420},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3592":74450,"_30925":74387,"_21431":126422,"_5":14725,"_28112":126262,"_3048":126423},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3592":74451,"_30925":74387,"_21431":126425,"_5":14725,"_28112":126262,"_3048":126426},[],"**Tags**: metadatos para clasificar la clave.",{"_3592":74452,"_30925":74387,"_21431":126428,"_5":14725,"_28112":126262,"_3048":126429},[],"**Metadata**: información adicional para usos avanzados.",{"_3592":74453,"_30925":74387,"_21431":126431,"_5":14725,"_28112":126266,"_3048":126432},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3592":74454,"_30925":74387,"_21431":126434,"_5":14725,"_28112":126266,"_3048":126435},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3592":74455,"_30925":74387,"_21431":126437,"_5":14725,"_28112":126266,"_3048":126438},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3592":74456,"_30925":74387,"_21431":126440,"_5":14725,"_28112":126266,"_3048":126441},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3592":74457,"_30925":74387,"_21431":126443,"_5":14725,"_28112":126266,"_3048":126444},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3592":74458,"_30925":74387,"_21431":126446,"_5":14725,"_28112":126266,"_3048":126447},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3592":74459,"_30925":74387,"_21431":126449,"_5":14725,"_28112":126266,"_3048":126450},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3592":74460,"_30925":74387,"_21431":126452,"_5":14725,"_28112":126266,"_3048":126453},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3592":74461,"_30925":74387,"_21431":126455,"_5":14725,"_28112":126266,"_3048":126456},[],"**Metadata**: información adicional opcional.",{"_3592":74462,"_30925":74387,"_21431":126458,"_5":14725,"_28112":126266,"_3048":126459},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3592":74463,"_30925":74387,"_21431":126461,"_5":14725,"_28112":126266,"_3048":126462},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3592":74464,"_30925":74387,"_21431":126464,"_5":14725,"_28112":126270,"_3048":126465},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3592":74465,"_30925":74387,"_21431":126467,"_5":14725,"_28112":126274,"_3048":126468},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3592":74466,"_30925":74387,"_21431":126470,"_5":14725,"_28112":126274,"_3048":126471},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3592":74467,"_30925":74387,"_21431":126473,"_5":14725,"_28112":126274,"_3048":126474},[],"**Key Name**: nombre descriptivo.",{"_3592":74468,"_30925":74387,"_21431":126476,"_5":14725,"_28112":126274,"_3048":126477},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3592":74469,"_30925":74387,"_21431":126479,"_5":14725,"_28112":126274,"_3048":126480},[],"**Tags**: etiquetas asociadas.",{"_3592":74470,"_30925":74387,"_21431":126482,"_5":14725,"_28112":126274,"_3048":126483},[],"**Aliases**: nombres alternativos.",{"_3592":74471,"_30925":74387,"_21431":126485,"_5":14725,"_28112":126274,"_3048":126486},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3592":74472,"_30925":74387,"_21431":126488,"_5":14725,"_28112":126274,"_3048":126489},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3592":74473,"_30925":74387,"_21431":126491,"_5":14725,"_28112":126274,"_3048":126492},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3592":74474,"_30925":74387,"_21431":126494,"_5":14725,"_28112":126274,"_3048":126495},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3592":74475,"_30925":74387,"_21431":126497,"_5":14725,"_28112":126278,"_3048":126498},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3592":74476,"_30925":74387,"_21431":126500,"_5":14725,"_28112":126278,"_3048":126501},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3592":74477,"_30925":74387,"_21431":126503,"_5":14725,"_28112":126278,"_3048":126504},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3592":74478,"_30925":74387,"_21431":126506,"_5":14725,"_28112":126282,"_3048":126507},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3592":74479,"_30925":74387,"_21431":126509,"_5":14725,"_28112":126282,"_3048":126510},[],"Campos principales:",{"_3592":74480,"_30925":74387,"_21431":126512,"_5":14725,"_28112":126282,"_3048":126513},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3592":74481,"_30925":74387,"_21431":126515,"_5":14725,"_28112":126282,"_3048":126516},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3592":74482,"_30925":74387,"_21431":126518,"_5":14725,"_28112":126282,"_3048":126519},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3592":74483,"_30925":74387,"_21431":126521,"_5":14725,"_28112":126282,"_3048":126522},[],"**Message**: contenido que se va a firmar.",{"_3592":74484,"_30925":74387,"_21431":126524,"_5":14725,"_28112":126282,"_3048":126525},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3592":74485,"_30925":74387,"_21431":126527,"_5":14725,"_28112":126285,"_3048":126528},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3592":74486,"_30925":74387,"_21431":126530,"_5":14725,"_28112":126285,"_3048":126510},[],{"_3592":74487,"_30925":74387,"_21431":126532,"_5":14725,"_28112":126285,"_3048":126533},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3592":74488,"_30925":74387,"_21431":126535,"_5":14725,"_28112":126285,"_3048":126536},[],"**Message Type**: `Raw` o `Digest`.",{"_3592":74489,"_30925":74387,"_21431":126538,"_5":14725,"_28112":126285,"_3048":126539},[],"**Payload Encoding**: codificación del mensaje.",{"_3592":74490,"_30925":74387,"_21431":126541,"_5":14725,"_28112":126285,"_3048":126542},[],"**Message**: mensaje original o hash.",{"_3592":74491,"_30925":74387,"_21431":126544,"_5":14725,"_28112":126285,"_3048":126545},[],"**Signature**: firma que se desea comprobar.",{"_3592":74492,"_30925":74387,"_21431":126547,"_5":14725,"_28112":126285,"_3048":126548},[],"**Result**: indicador del resultado de la validación.",{"_3592":74493,"_30925":74387,"_21431":126550,"_5":14725,"_28112":126288,"_3048":126551},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3592":74494,"_30925":74387,"_21431":126553,"_5":14725,"_28112":126288,"_3048":126554},[],"Este flujo es útil para:",{"_3592":74495,"_30925":74387,"_21431":126556,"_5":14725,"_28112":126288,"_3048":126557},[],"Solicitar certificados a una CA externa.",{"_3592":74496,"_30925":74387,"_21431":126559,"_5":14725,"_28112":126288,"_3048":126560},[],"Renovar una identidad manteniendo la misma clave.",{"_3592":74497,"_30925":74387,"_21431":126562,"_5":14725,"_28112":126288,"_3048":126563},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3592":74498,"_30925":74387,"_21431":126565,"_5":14725,"_28112":126288,"_3048":126566},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3592":74499,"_30925":74387,"_21431":126568,"_5":14725,"_28112":126288,"_3048":126569},[],"**Organization (O)**: organización o empresa.",{"_3592":74500,"_30925":74387,"_21431":126571,"_5":14725,"_28112":126288,"_3048":126572},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3592":74501,"_30925":74387,"_21431":126574,"_5":14725,"_28112":126288,"_3048":126575},[],"**Country (C)**: código de país de dos letras.",{"_3592":74502,"_30925":74387,"_21431":126577,"_5":14725,"_28112":126288,"_3048":126578},[],"**State / Province (ST)**: estado o provincia.",{"_3592":74503,"_30925":74387,"_21431":126580,"_5":14725,"_28112":126288,"_3048":126581},[],"**Locality (L)**: ciudad o localidad.",{"_3592":74504,"_30925":74387,"_21431":126583,"_5":14725,"_28112":126288,"_3048":126584},[],"**Email Address**: correo de contacto.",{"_3592":74505,"_30925":74387,"_21431":126586,"_5":14725,"_28112":126288,"_3048":126587},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3592":74506,"_30925":74387,"_21431":126589,"_5":14725,"_28112":126288,"_3048":126590},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3592":74507,"_30925":74387,"_21431":126592,"_5":14725,"_28112":126292,"_3048":126593},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3592":74508,"_30925":74387,"_21431":126595,"_5":14725,"_28112":126292,"_3048":126596},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3592":74509,"_30925":74387,"_21431":126598,"_5":14725,"_28112":126296,"_3048":126599},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3592":74510,"_30925":74387,"_21431":126601,"_5":14725,"_28112":126296,"_3048":126602},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. El KMS también se niega a eliminar una clave que firma la CRL de una CA cuyos ajustes de CRL siguen `ACTIVE`, con el mismo `409` `key is in use`; esa referencia se libera cuando los ajustes se finalizan, después de que la CA se revoca de forma permanente o caduca (consulta CRL). La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3592":74511,"_30925":74511,"_5":15085,"_3048":126604,"_31263":126605,"_21431":126606,"_28112":74511},"Validación online con OCSP",[50505,120709,56180,125360],[],{"_3592":74512,"_30925":74511,"_21431":126608,"_5":14725,"_28112":74511,"_3048":126609},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3592":74513,"_30925":74511,"_5":31260,"_21431":126611,"_28112":126612,"_3048":126613},[],"/docs/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3592":74514,"_30925":74511,"_5":31260,"_21431":126615,"_28112":126616,"_3048":126617},[],"/docs/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3592":74515,"_30925":74511,"_5":31260,"_21431":126619,"_28112":126620,"_3048":126621},[],"/docs/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3592":74516,"_30925":74511,"_5":31260,"_21431":126623,"_28112":126624,"_3048":126625},[],"/docs/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3592":74517,"_30925":74511,"_5":31260,"_21431":126627,"_28112":126628,"_3048":126629},[],"/docs/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3592":74518,"_30925":74511,"_5":31260,"_21431":126631,"_28112":126632,"_3048":125923},[],"/docs/es/platform/pki/ocsp#referencias",{"_3592":74519,"_30925":74511,"_21431":126634,"_5":14725,"_28112":74511,"_3048":126635},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3592":74520,"_30925":74511,"_21431":126637,"_5":14725,"_28112":126612,"_3048":126638},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3592":74521,"_30925":74511,"_21431":126640,"_5":14725,"_28112":126612,"_3048":126641},[],"Estado del registro",{"_3592":74522,"_30925":74511,"_21431":126643,"_5":14725,"_28112":126612,"_3048":126644},[],"Respuesta firmada",{"_3592":74523,"_30925":74511,"_21431":126646,"_5":14725,"_28112":126612,"_3048":55317},[],{"_3592":74524,"_30925":74511,"_21431":126648,"_5":14725,"_28112":126612,"_3048":58136},[],{"_3592":74525,"_30925":74511,"_21431":126650,"_5":14725,"_28112":126612,"_3048":55334},[],{"_3592":74526,"_30925":74511,"_21431":126652,"_5":14725,"_28112":126612,"_3048":126653},[],"`Revoked`, con razón y fecha de revocación.",{"_3592":74527,"_30925":74511,"_21431":126655,"_5":14725,"_28112":126612,"_3048":126656},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3592":74528,"_30925":74511,"_21431":126658,"_5":14725,"_28112":126612,"_3048":126659},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3592":74529,"_30925":74511,"_21431":126661,"_5":14725,"_28112":126612,"_3048":126662},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3592":74530,"_30925":74511,"_21431":126664,"_5":14725,"_28112":126612,"_3048":126665},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3592":74531,"_30925":74511,"_21431":126667,"_5":14725,"_28112":126612,"_3048":126668},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3592":74532,"_30925":74511,"_21431":126670,"_5":14725,"_28112":126616,"_3048":126671},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3592":74533,"_30925":74511,"_21431":126673,"_5":14725,"_28112":126616,"_3048":126674},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3592":74534,"_30925":74511,"_21431":126676,"_5":14725,"_28112":126620,"_3048":126677},[],"El servicio acepta:",{"_3592":74535,"_30925":74511,"_21431":126679,"_5":14725,"_28112":126620,"_3048":122572},[],{"_3592":74536,"_30925":74511,"_21431":126681,"_5":14725,"_28112":126620,"_3048":126682},[],"Ruta del servicio VA",{"_3592":74537,"_30925":74511,"_21431":126684,"_5":14725,"_28112":126620,"_3048":126685},[],"Formato",{"_3592":74538,"_30925":74511,"_21431":126687,"_5":14725,"_28112":126620,"_3048":58176},[],{"_3592":74539,"_30925":74511,"_21431":126689,"_5":14725,"_28112":126620,"_3048":58179},[],{"_3592":74540,"_30925":74511,"_21431":126691,"_5":14725,"_28112":126620,"_3048":126692},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3592":74541,"_30925":74511,"_21431":126694,"_5":14725,"_28112":126620,"_3048":57571},[],{"_3592":74542,"_30925":74511,"_21431":126696,"_5":14725,"_28112":126620,"_3048":58187},[],{"_3592":74543,"_30925":74511,"_21431":126698,"_5":14725,"_28112":126620,"_3048":126699},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3592":74544,"_30925":74511,"_21431":126701,"_5":14725,"_28112":126620,"_3048":126702},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3592":74545,"_30925":74511,"_21431":126704,"_5":14725,"_28112":126624,"_3048":126705},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3592":74546,"_30925":74511,"_21431":126707,"_5":14725,"_28112":126624,"_3048":126708},[],"Genera la solicitud:",{"_3592":74547,"_30925":74511,"_21431":126710,"_5":14725,"_28112":126624,"_3048":126711},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3592":74548,"_30925":74511,"_21431":126713,"_5":14725,"_28112":126624,"_3048":126714},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3592":74549,"_30925":74511,"_21431":126716,"_5":14725,"_28112":126624,"_3048":126717},[],"Verifica el DER recibido:",{"_3592":74550,"_30925":74511,"_21431":126719,"_5":14725,"_28112":126624,"_3048":126720},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3592":74551,"_30925":74511,"_21431":126722,"_5":14725,"_28112":126628,"_3048":126723},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3592":74552,"_30925":74511,"_21431":126725,"_5":14725,"_28112":126628,"_3048":126726},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3592":74553,"_30925":74511,"_21431":126728,"_5":14725,"_28112":126632,"_3048":58220},[],{"_3592":74554,"_30925":74511,"_21431":126730,"_5":14725,"_28112":126632,"_3048":58223},[],{"_3592":74555,"_30925":74511,"_21431":126732,"_5":14725,"_28112":126632,"_3048":126733},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3592":74556,"_30925":74511,"_21431":126735,"_5":14725,"_28112":126632,"_3048":126218},[],{"_3592":74557,"_30925":74557,"_5":15085,"_3048":56180,"_31263":126737,"_21431":126738,"_28112":74557},[50505,120709,56180],[],{"_3592":74558,"_30925":74557,"_21431":126740,"_5":14725,"_28112":74557,"_3048":126741},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3592":74559,"_30925":74557,"_5":31260,"_21431":126743,"_28112":126744,"_3048":124046},[],"/docs/es/platform/pki/overview#empieza-aquí",{"_3592":74560,"_30925":74557,"_5":31260,"_21431":126746,"_28112":126747,"_3048":126748},[],"/docs/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3592":74561,"_30925":74557,"_5":31260,"_21431":126750,"_28112":126751,"_3048":124566},[],"/docs/es/platform/pki/overview#capacidades-principales",{"_3592":74562,"_30925":74557,"_5":31260,"_21431":126753,"_28112":126754,"_3048":124570},[],"/docs/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3592":74563,"_30925":74557,"_5":31260,"_21431":126756,"_28112":126757,"_3048":124574},[],"/docs/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3592":74564,"_30925":74557,"_5":31260,"_21431":126759,"_28112":126760,"_3048":124578},[],"/docs/es/platform/pki/overview#emite-y-controla-certificados",{"_3592":74565,"_30925":74557,"_5":31260,"_21431":126762,"_28112":126763,"_3048":124586},[],"/docs/es/platform/pki/overview#publica-el-estado-de-validación",{"_3592":74566,"_30925":74557,"_5":31260,"_21431":126765,"_28112":126766,"_3048":126767},[],"/docs/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3592":74567,"_30925":74557,"_5":31260,"_21431":126769,"_28112":126770,"_3048":125526},[],"/docs/es/platform/pki/overview#continúa",{"_3592":74568,"_30925":74557,"_21431":126772,"_5":14725,"_28112":74557,"_3048":126773},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3592":74569,"_30925":74557,"_21431":126775,"_5":14725,"_28112":126744,"_3048":126776},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3592":74570,"_30925":74557,"_21431":126778,"_5":14725,"_28112":126744,"_3048":126779},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3592":74571,"_30925":74557,"_21431":126781,"_5":14725,"_28112":126747,"_3048":126782},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3592":74572,"_30925":74557,"_21431":126784,"_5":14725,"_28112":126747,"_3048":126785},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3592":74573,"_30925":74557,"_21431":126787,"_5":14725,"_28112":126747,"_3048":126788},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3592":74574,"_30925":74557,"_21431":126790,"_5":14725,"_28112":126747,"_3048":126791},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3592":74575,"_30925":74557,"_21431":126793,"_5":14725,"_28112":126747,"_3048":126794},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3592":74576,"_30925":74557,"_21431":126796,"_5":14725,"_28112":126754,"_3048":126797},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3592":74577,"_30925":74557,"_21431":126799,"_5":14725,"_28112":126757,"_3048":126800},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3592":74578,"_30925":74557,"_21431":126802,"_5":14725,"_28112":126760,"_3048":126803},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3592":74579,"_30925":74557,"_21431":126805,"_5":14725,"_28112":126763,"_3048":126806},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3592":74580,"_30925":74557,"_21431":126808,"_5":14725,"_28112":126766,"_3048":126809},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3592":74581,"_30925":74557,"_21431":126811,"_5":14725,"_28112":126766,"_3048":126812},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3592":74582,"_30925":74557,"_21431":126814,"_5":14725,"_28112":126766,"_3048":126815},[],"su clave pública corresponda a la clave privada del cliente;",{"_3592":74583,"_30925":74557,"_21431":126817,"_5":14725,"_28112":126766,"_3048":126818},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3592":74584,"_30925":74557,"_21431":126820,"_5":14725,"_28112":126766,"_3048":126821},[],"sus fechas y usos permitan la operación;",{"_3592":74585,"_30925":74557,"_21431":126823,"_5":14725,"_28112":126766,"_3048":126824},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3592":74586,"_30925":74557,"_21431":126826,"_5":14725,"_28112":126766,"_3048":126827},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3592":74587,"_30925":74557,"_21431":126829,"_5":14725,"_28112":126770,"_3048":126830},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3592":74588,"_30925":74557,"_21431":126832,"_5":14725,"_28112":126770,"_3048":126833},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3592":74589,"_30925":74557,"_21431":126835,"_5":14725,"_28112":126770,"_3048":126836},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3592":74590,"_30925":74590,"_5":15085,"_3048":126838,"_31263":126839,"_21431":126840,"_28112":74590},"Crea tu primera CA",[50505,120709,56180,124170],[],{"_3592":74591,"_30925":74590,"_21431":126842,"_5":14725,"_28112":74590,"_3048":126843},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3592":74592,"_30925":74590,"_5":31260,"_21431":126845,"_28112":126846,"_3048":119243},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3592":74593,"_30925":74590,"_5":31260,"_21431":126848,"_28112":126849,"_3048":126850},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3592":74594,"_30925":74590,"_5":31260,"_21431":126852,"_28112":126853,"_3048":126854},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3592":74595,"_30925":74590,"_5":31260,"_21431":126856,"_28112":126857,"_3048":126858},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3592":74596,"_30925":74590,"_5":31260,"_21431":126860,"_28112":126861,"_3048":126862},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3592":74597,"_30925":74590,"_5":31260,"_21431":126864,"_28112":126865,"_3048":126866},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3592":74598,"_30925":74590,"_5":31260,"_21431":126868,"_28112":126869,"_3048":126870},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3592":74599,"_30925":74590,"_5":31260,"_21431":126872,"_28112":126873,"_3048":124417},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3592":74600,"_30925":74590,"_5":31260,"_21431":126875,"_28112":126876,"_3048":119267},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3592":74601,"_30925":74590,"_21431":126878,"_5":14725,"_28112":74590,"_3048":126879},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3592":74602,"_30925":74590,"_21431":126881,"_5":14725,"_28112":126846,"_3048":126882},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3592":74603,"_30925":74590,"_21431":126884,"_5":14725,"_28112":126846,"_3048":126885},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3592":74604,"_30925":74590,"_21431":126887,"_5":14725,"_28112":126846,"_3048":126888},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3592":74605,"_30925":74590,"_21431":126890,"_5":14725,"_28112":126846,"_3048":126891},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3592":74606,"_30925":74590,"_21431":126893,"_5":14725,"_28112":126849,"_3048":126894},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3592":74607,"_30925":74590,"_21431":126896,"_5":14725,"_28112":126849,"_3048":126897},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3592":74608,"_30925":74590,"_21431":126899,"_5":14725,"_28112":126853,"_3048":126900},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3592":74609,"_30925":74590,"_21431":126902,"_5":14725,"_28112":126853,"_3048":126903},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3592":74610,"_30925":74590,"_21431":126905,"_5":14725,"_28112":126857,"_3048":126906},[],"Selecciona **Root CA** y completa:",{"_3592":74611,"_30925":74590,"_21431":126908,"_5":14725,"_28112":126857,"_3048":58402},[],{"_3592":74612,"_30925":74590,"_21431":126910,"_5":14725,"_28112":126857,"_3048":126911},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3592":74613,"_30925":74590,"_21431":126913,"_5":14725,"_28112":126857,"_3048":126914},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3592":74614,"_30925":74590,"_21431":126916,"_5":14725,"_28112":126857,"_3048":126917},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3592":74615,"_30925":74590,"_21431":126919,"_5":14725,"_28112":126857,"_3048":126920},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3592":74616,"_30925":74590,"_21431":126922,"_5":14725,"_28112":126861,"_3048":126923},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3592":74617,"_30925":74590,"_21431":126925,"_5":14725,"_28112":126865,"_3048":126926},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3592":74618,"_30925":74590,"_21431":126928,"_5":14725,"_28112":126865,"_3048":126929},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3592":74619,"_30925":74590,"_21431":126931,"_5":14725,"_28112":126869,"_3048":126932},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3592":74620,"_30925":74590,"_21431":126934,"_5":14725,"_28112":126869,"_3048":126935},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3592":74621,"_30925":74590,"_21431":126937,"_5":14725,"_28112":126869,"_3048":126938},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3592":74622,"_30925":74590,"_21431":126940,"_5":14725,"_28112":126873,"_3048":126941},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3592":74623,"_30925":74590,"_21431":126943,"_5":14725,"_28112":126873,"_3048":126944},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3592":74624,"_30925":74590,"_21431":126946,"_5":14725,"_28112":126873,"_3048":126947},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3592":74625,"_30925":74590,"_21431":126949,"_5":14725,"_28112":126873,"_3048":126950},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3592":74626,"_30925":74590,"_21431":126952,"_5":14725,"_28112":126876,"_3048":126953},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3592":74627,"_30925":74627,"_5":15085,"_3048":126955,"_31263":126956,"_21431":126957,"_28112":74627},"Emite y verifica un certificado",[50505,120709,56180,124170],[],{"_3592":74628,"_30925":74627,"_21431":126959,"_5":14725,"_28112":74627,"_3048":126960},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3592":74629,"_30925":74627,"_5":31260,"_21431":126962,"_28112":126963,"_3048":119243},[],"/docs/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3592":74630,"_30925":74627,"_5":31260,"_21431":126965,"_28112":126966,"_3048":126967},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3592":74631,"_30925":74627,"_5":31260,"_21431":126969,"_28112":126970,"_3048":126971},[],"/docs/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3592":74632,"_30925":74627,"_5":31260,"_21431":126973,"_28112":126974,"_3048":126975},[],"/docs/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3592":74633,"_30925":74627,"_5":31260,"_21431":126977,"_28112":126978,"_3048":126979},[],"/docs/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3592":74634,"_30925":74627,"_5":31260,"_21431":126981,"_28112":126982,"_3048":126983},[],"/docs/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3592":74635,"_30925":74627,"_5":31260,"_21431":126985,"_28112":126986,"_3048":126987},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3592":74636,"_30925":74627,"_5":31260,"_21431":126989,"_28112":126990,"_3048":126991},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3592":74637,"_30925":74627,"_5":31260,"_21431":126993,"_28112":126994,"_3048":126995},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3592":74638,"_30925":74627,"_5":31260,"_21431":126997,"_28112":126998,"_3048":126999},[],"/docs/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3592":74639,"_30925":74627,"_5":31260,"_21431":127001,"_28112":127002,"_3048":124417},[],"/docs/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3592":74640,"_30925":74627,"_5":31260,"_21431":127004,"_28112":127005,"_3048":119267},[],"/docs/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3592":74641,"_30925":74627,"_21431":127007,"_5":14725,"_28112":74627,"_3048":127008},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3592":74642,"_30925":74627,"_21431":127010,"_5":14725,"_28112":126963,"_3048":127011},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3592":74643,"_30925":74627,"_21431":127013,"_5":14725,"_28112":126963,"_3048":127014},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3592":74644,"_30925":74627,"_21431":127016,"_5":14725,"_28112":126963,"_3048":127017},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3592":74645,"_30925":74627,"_21431":127019,"_5":14725,"_28112":126963,"_3048":127020},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3592":74646,"_30925":74627,"_21431":127022,"_5":14725,"_28112":126963,"_3048":127023},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3592":74647,"_30925":74627,"_21431":127025,"_5":14725,"_28112":126966,"_3048":127026},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3592":74648,"_30925":74627,"_21431":127028,"_5":14725,"_28112":126970,"_3048":127029},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3592":74649,"_30925":74627,"_21431":127031,"_5":14725,"_28112":126970,"_3048":127032},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3592":74650,"_30925":74627,"_21431":127034,"_5":14725,"_28112":126974,"_3048":127035},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3592":74651,"_30925":74627,"_21431":127037,"_5":14725,"_28112":126974,"_3048":127038},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3592":74652,"_30925":74627,"_21431":127040,"_5":14725,"_28112":126978,"_3048":127041},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3592":74653,"_30925":74627,"_21431":127043,"_5":14725,"_28112":126978,"_3048":127044},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3592":74654,"_30925":74627,"_21431":127046,"_5":14725,"_28112":126982,"_3048":127047},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3592":74655,"_30925":74627,"_21431":127049,"_5":14725,"_28112":126986,"_3048":127050},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3592":74656,"_30925":74627,"_21431":127052,"_5":14725,"_28112":126990,"_3048":127053},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3592":74657,"_30925":74627,"_21431":127055,"_5":14725,"_28112":126994,"_3048":127056},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3592":74658,"_30925":74627,"_21431":127058,"_5":14725,"_28112":126994,"_3048":127059},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3592":74659,"_30925":74627,"_21431":127061,"_5":14725,"_28112":126994,"_3048":127062},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3592":74660,"_30925":74627,"_21431":127064,"_5":14725,"_28112":126998,"_3048":127065},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3592":74661,"_30925":74627,"_21431":127067,"_5":14725,"_28112":126998,"_3048":127068},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3592":74662,"_30925":74627,"_21431":127070,"_5":14725,"_28112":126998,"_3048":127071},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3592":74663,"_30925":74627,"_21431":127073,"_5":14725,"_28112":127002,"_3048":124500},[],{"_3592":74664,"_30925":74627,"_21431":127075,"_5":14725,"_28112":127002,"_3048":123021},[],{"_3592":74665,"_30925":74627,"_21431":127077,"_5":14725,"_28112":127002,"_3048":127078},[],"La CA rechaza la emisión",{"_3592":74666,"_30925":74627,"_21431":127080,"_5":14725,"_28112":127002,"_3048":127081},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3592":74667,"_30925":74627,"_21431":127083,"_5":14725,"_28112":127002,"_3048":127084},[],"Sujeto o usos diferentes",{"_3592":74668,"_30925":74627,"_21431":127086,"_5":14725,"_28112":127002,"_3048":127087},[],"Perfil aplicado y valores solicitados.",{"_3592":74669,"_30925":74627,"_21431":127089,"_5":14725,"_28112":127002,"_3048":127090},[],"No se encuentra el emisor",{"_3592":74670,"_30925":74627,"_21431":127092,"_5":14725,"_28112":127002,"_3048":127093},[],"CA descargada y cadena intermedia necesaria.",{"_3592":74671,"_30925":74627,"_21431":127095,"_5":14725,"_28112":127002,"_3048":127096},[],"Falla la vigencia",{"_3592":74672,"_30925":74627,"_21431":127098,"_5":14725,"_28112":127002,"_3048":127099},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3592":74673,"_30925":74627,"_21431":127101,"_5":14725,"_28112":127002,"_3048":127102},[],"Los resúmenes de clave difieren",{"_3592":74674,"_30925":74627,"_21431":127104,"_5":14725,"_28112":127002,"_3048":127105},[],"Archivos de certificado y clave de la misma emisión.",{"_3592":74675,"_30925":74627,"_21431":127107,"_5":14725,"_28112":127002,"_3048":127108},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3592":74676,"_30925":74627,"_21431":127110,"_5":14725,"_28112":127005,"_3048":127111},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3592":74677,"_30925":74627,"_21431":127113,"_5":14725,"_28112":127005,"_3048":127114},[],"Gestionar certificados para inspección, estado y revocación.",{"_3592":74678,"_30925":74627,"_21431":127116,"_5":14725,"_28112":127005,"_3048":127117},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3592":74679,"_30925":74627,"_21431":127119,"_5":14725,"_28112":127005,"_3048":127120},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3592":74680,"_30925":74627,"_21431":127122,"_5":14725,"_28112":127005,"_3048":127123},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3592":74681,"_30925":74681,"_5":15085,"_3048":127125,"_31263":127126,"_21431":127127,"_28112":74681},"Primeros pasos de PKI",[50505,120709,56180,124170],[],{"_3592":74682,"_30925":74681,"_21431":127129,"_5":14725,"_28112":74681,"_3048":127130},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3592":74683,"_30925":74681,"_5":31260,"_21431":127132,"_28112":127133,"_3048":119243},[],"/docs/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3592":74684,"_30925":74681,"_5":31260,"_21431":127135,"_28112":127136,"_3048":127137},[],"/docs/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3592":74685,"_30925":74681,"_5":31260,"_21431":127139,"_28112":127140,"_3048":124352},[],"/docs/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3592":74686,"_30925":74681,"_5":31260,"_21431":127142,"_28112":127143,"_3048":127144},[],"/docs/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3592":74687,"_30925":74681,"_21431":127146,"_5":14725,"_28112":74681,"_3048":127147},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3592":74688,"_30925":74681,"_21431":127149,"_5":14725,"_28112":127133,"_3048":127150},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3592":74689,"_30925":74681,"_21431":127152,"_5":14725,"_28112":127133,"_3048":127153},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3592":74690,"_30925":74681,"_21431":127155,"_5":14725,"_28112":127133,"_3048":127156},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3592":74691,"_30925":74681,"_21431":127158,"_5":14725,"_28112":127133,"_3048":127159},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3592":74692,"_30925":74681,"_21431":127161,"_5":14725,"_28112":127133,"_3048":127162},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3592":74693,"_30925":74681,"_21431":127164,"_5":14725,"_28112":127136,"_3048":127165},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3592":74694,"_30925":74681,"_21431":127167,"_5":14725,"_28112":127136,"_3048":127168},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3592":74695,"_30925":74681,"_21431":127170,"_5":14725,"_28112":127136,"_3048":127171},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3592":74696,"_30925":74681,"_21431":127173,"_5":14725,"_28112":127136,"_3048":127174},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3592":74697,"_30925":74681,"_21431":127176,"_5":14725,"_28112":127140,"_3048":127177},[],"Archivo o recurso",{"_3592":74698,"_30925":74681,"_21431":127179,"_5":14725,"_28112":127140,"_3048":124349},[],{"_3592":74699,"_30925":74681,"_21431":127181,"_5":14725,"_28112":127140,"_3048":127182},[],"CA raíz activa y `ca.pem`",{"_3592":74700,"_30925":74681,"_21431":127184,"_5":14725,"_28112":127140,"_3048":127185},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3592":74701,"_30925":74681,"_21431":127187,"_5":14725,"_28112":127140,"_3048":127188},[],"Certificado final y `device.crt`",{"_3592":74702,"_30925":74681,"_21431":127190,"_5":14725,"_28112":127140,"_3048":127191},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3592":74703,"_30925":74681,"_21431":127193,"_5":14725,"_28112":127140,"_3048":127194},[],"Clave privada `device.key`",{"_3592":74704,"_30925":74681,"_21431":127196,"_5":14725,"_28112":127140,"_3048":127197},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3592":74705,"_30925":74681,"_21431":127199,"_5":14725,"_28112":127140,"_3048":127200},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3592":74706,"_30925":74681,"_21431":127202,"_5":14725,"_28112":127143,"_3048":127203},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3592":74707,"_30925":74681,"_21431":127205,"_5":14725,"_28112":127143,"_3048":127206},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3592":74708,"_30925":74681,"_21431":127208,"_5":14725,"_28112":127143,"_3048":127209},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3592":74709,"_30925":74709,"_5":15085,"_3048":127211,"_31263":127212,"_21431":127214,"_28112":74709},"Resolución de problemas PKI",[50505,120709,56180,127213],"Resolución de problemas",[],{"_3592":74710,"_30925":74709,"_21431":127216,"_5":14725,"_28112":74709,"_3048":127217},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3592":74711,"_30925":74709,"_5":31260,"_21431":127219,"_28112":127220,"_3048":127221},[],"/docs/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3592":74712,"_30925":74709,"_5":31260,"_21431":127223,"_28112":127224,"_3048":127225},[],"/docs/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3592":74713,"_30925":74709,"_5":31260,"_21431":127227,"_28112":127228,"_3048":127229},[],"/docs/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3592":74714,"_30925":74709,"_21431":127231,"_5":14725,"_28112":74709,"_3048":127232},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3592":74715,"_30925":74709,"_21431":127234,"_5":14725,"_28112":74709,"_3048":127235},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3592":74716,"_30925":74709,"_21431":127237,"_5":14725,"_28112":127220,"_3048":124349},[],{"_3592":74717,"_30925":74709,"_21431":127239,"_5":14725,"_28112":127220,"_3048":123021},[],{"_3592":74718,"_30925":74709,"_21431":127241,"_5":14725,"_28112":127220,"_3048":119267},[],{"_3592":74719,"_30925":74709,"_21431":127243,"_5":14725,"_28112":127220,"_3048":55022},[],{"_3592":74720,"_30925":74709,"_21431":127245,"_5":14725,"_28112":127220,"_3048":127246},[],"Existe, está activa y sus fechas son utilizables.",{"_3592":74721,"_30925":74709,"_21431":127248,"_5":14725,"_28112":127220,"_3048":127249},[],"Autoridades.",{"_3592":74722,"_30925":74709,"_21431":127251,"_5":14725,"_28112":127220,"_3048":127252},[],"Clave",{"_3592":74723,"_30925":74709,"_21431":127254,"_5":14725,"_28112":127220,"_3048":127255},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3592":74724,"_30925":74709,"_21431":127257,"_5":14725,"_28112":127220,"_3048":127258},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3592":74725,"_30925":74709,"_21431":127260,"_5":14725,"_28112":127220,"_3048":58756},[],{"_3592":74726,"_30925":74709,"_21431":127262,"_5":14725,"_28112":127220,"_3048":127263},[],"PEM correcto y firma verificable.",{"_3592":74727,"_30925":74709,"_21431":127265,"_5":14725,"_28112":127220,"_3048":58762},[],{"_3592":74728,"_30925":74709,"_21431":127267,"_5":14725,"_28112":127220,"_3048":127268},[],"Perfil",{"_3592":74729,"_30925":74709,"_21431":127270,"_5":14725,"_28112":127220,"_3048":127271},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3592":74730,"_30925":74709,"_21431":127273,"_5":14725,"_28112":127220,"_3048":127274},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3592":74731,"_30925":74709,"_21431":127276,"_5":14725,"_28112":127220,"_3048":124500},[],{"_3592":74732,"_30925":74709,"_21431":127278,"_5":14725,"_28112":127220,"_3048":127279},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3592":74733,"_30925":74709,"_21431":127281,"_5":14725,"_28112":127220,"_3048":127282},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3592":74734,"_30925":74709,"_21431":127284,"_5":14725,"_28112":127220,"_3048":127285},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3592":74735,"_30925":74709,"_21431":127287,"_5":14725,"_28112":127220,"_3048":127288},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3592":74736,"_30925":74709,"_21431":127290,"_5":14725,"_28112":127224,"_3048":127291},[],"Revisa cada frontera por separado:",{"_3592":74737,"_30925":74709,"_21431":127293,"_5":14725,"_28112":127224,"_3048":127294},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3592":74738,"_30925":74709,"_21431":127296,"_5":14725,"_28112":127224,"_3048":127297},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3592":74739,"_30925":74709,"_21431":127299,"_5":14725,"_28112":127224,"_3048":127300},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3592":74740,"_30925":74709,"_21431":127302,"_5":14725,"_28112":127224,"_3048":127303},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3592":74741,"_30925":74709,"_21431":127305,"_5":14725,"_28112":127224,"_3048":127306},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3592":74742,"_30925":74709,"_21431":127308,"_5":14725,"_28112":127224,"_3048":127309},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3592":74743,"_30925":74709,"_21431":127311,"_5":14725,"_28112":127228,"_3048":127312},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3592":74744,"_30925":74709,"_21431":127314,"_5":14725,"_28112":127228,"_3048":127315},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3592":74745,"_30925":74745,"_5":15085,"_3048":127317,"_31263":127318,"_21431":127319,"_28112":74745},"Seguridad",[50505],[],{"_3592":74746,"_30925":74745,"_21431":127321,"_5":14725,"_28112":74745,"_3048":127322},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3592":74747,"_30925":74745,"_5":31260,"_21431":127324,"_28112":127325,"_3048":127326},[],"/docs/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3592":74748,"_30925":74745,"_5":31260,"_21431":127328,"_28112":127329,"_3048":127330},[],"/docs/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3592":74749,"_30925":74745,"_5":31260,"_21431":127332,"_28112":127333,"_3048":127334},[],"/docs/es/security#versiones-soportadas","Versiones soportadas",{"_3592":74750,"_30925":74745,"_5":31260,"_21431":127336,"_28112":127337,"_3048":127338},[],"/docs/es/security#divulgación-responsable","Divulgación responsable",{"_3592":74751,"_30925":74745,"_21431":127340,"_5":14725,"_28112":74745,"_3048":127341},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3592":74752,"_30925":74745,"_21431":127343,"_5":14725,"_28112":127325,"_3048":127344},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3592":74753,"_30925":74745,"_21431":127346,"_5":14725,"_28112":127325,"_3048":127347},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3592":74754,"_30925":74745,"_21431":127349,"_5":14725,"_28112":127325,"_3048":15363},[],{"_3592":74755,"_30925":74745,"_21431":127351,"_5":14725,"_28112":127325,"_3048":15292},[],{"_3592":74756,"_30925":74745,"_21431":127353,"_5":14725,"_28112":127325,"_3048":15350},[],{"_3592":74757,"_30925":74745,"_21431":127355,"_5":14725,"_28112":127325,"_3048":127356},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3592":74758,"_30925":74745,"_21431":127358,"_5":14725,"_28112":127325,"_3048":127359},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3592":74759,"_30925":74745,"_21431":127361,"_5":14725,"_28112":127329,"_3048":127362},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3592":74760,"_30925":74745,"_21431":127364,"_5":14725,"_28112":127329,"_3048":127365},[],"No incluyas en el reporte:",{"_3592":74761,"_30925":74745,"_21431":127367,"_5":14725,"_28112":127329,"_3048":127368},[],"Credenciales, tokens o claves privadas",{"_3592":74762,"_30925":74745,"_21431":127370,"_5":14725,"_28112":127329,"_3048":127371},[],"Datos de clientes o información identificable de clientes",{"_3592":74763,"_30925":74745,"_21431":127373,"_5":14725,"_28112":127329,"_3048":127374},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3592":74764,"_30925":74745,"_21431":127376,"_5":14725,"_28112":127333,"_3048":127377},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3592":74765,"_30925":74745,"_21431":127379,"_5":14725,"_28112":127333,"_3048":127380},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3592":74766,"_30925":74745,"_21431":127382,"_5":14725,"_28112":127337,"_3048":127383},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3592":74767,"_30925":74745,"_21431":127385,"_5":14725,"_28112":127337,"_3048":127386},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3592":74768,"_30925":74745,"_21431":127388,"_5":14725,"_28112":127337,"_3048":127389},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3592":74769,"_30925":74745,"_21431":127391,"_5":14725,"_28112":127337,"_3048":127392},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3592":74770,"_30925":74745,"_21431":127394,"_5":14725,"_28112":127337,"_3048":127395},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3592":74771,"_30925":74771,"_5":15085,"_3048":127397,"_31263":127398,"_21431":127400,"_28112":74771},"3.8.0 a 4.0.0",[50505,127399],"Actualizaciones",[],{"_3592":74772,"_30925":74771,"_21431":127402,"_5":14725,"_28112":74771,"_3048":127403},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3592":74773,"_30925":74771,"_5":31260,"_21431":127405,"_28112":127406,"_3048":127407},[],"/docs/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3592":74774,"_30925":74771,"_5":31260,"_21431":127409,"_28112":127410,"_3048":127411},[],"/docs/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3592":74775,"_30925":74771,"_5":31260,"_21431":127413,"_28112":127414,"_3048":127415},[],"/docs/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3592":74776,"_30925":74771,"_5":31260,"_21431":127417,"_28112":127418,"_3048":127419},[],"/docs/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3592":74777,"_30925":74771,"_5":31260,"_21431":127421,"_28112":127422,"_3048":127423},[],"/docs/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3592":74778,"_30925":74771,"_5":31260,"_21431":127425,"_28112":127426,"_3048":127427},[],"/docs/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3592":74779,"_30925":74771,"_5":31260,"_21431":127429,"_28112":127430,"_3048":58928},[],"/docs/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3592":74780,"_30925":74771,"_5":31260,"_21431":127432,"_28112":127433,"_3048":127434},[],"/docs/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3592":74781,"_30925":74771,"_5":31260,"_21431":127436,"_28112":127437,"_3048":127438},[],"/docs/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3592":74782,"_30925":74771,"_5":31260,"_21431":127440,"_28112":127441,"_3048":127442},[],"/docs/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3592":74783,"_30925":74771,"_5":31260,"_21431":127444,"_28112":127445,"_3048":119838},[],"/docs/es/upgrades/3-8-0-to-4-0-0#credenciales-en-secrets-de-kubernetes",{"_3592":74784,"_30925":74771,"_5":31260,"_21431":127447,"_28112":127448,"_3048":127449},[],"/docs/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3592":74785,"_30925":74771,"_5":31260,"_21431":127451,"_28112":127452,"_3048":127453},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3592":74786,"_30925":74771,"_5":31260,"_21431":127455,"_28112":127456,"_3048":127457},[],"/docs/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3592":74787,"_30925":74771,"_5":31260,"_21431":127459,"_28112":127460,"_3048":127461},[],"/docs/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3592":74788,"_30925":74771,"_5":31260,"_21431":127463,"_28112":127464,"_3048":127465},[],"/docs/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3592":74789,"_30925":74771,"_5":31260,"_21431":127467,"_28112":127468,"_3048":127469},[],"/docs/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3592":74790,"_30925":74771,"_5":31260,"_21431":127471,"_28112":127472,"_3048":127473},[],"/docs/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3592":74791,"_30925":74771,"_5":31260,"_21431":127475,"_28112":127476,"_3048":127477},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3592":74792,"_30925":74771,"_5":31260,"_21431":127479,"_28112":127480,"_3048":127481},[],"/docs/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3592":74793,"_30925":74771,"_5":31260,"_21431":127483,"_28112":127484,"_3048":127485},[],"/docs/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3592":74794,"_30925":74771,"_5":31260,"_21431":127487,"_28112":127488,"_3048":127489},[],"/docs/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3592":74795,"_30925":74771,"_5":31260,"_21431":127491,"_28112":127492,"_3048":127493},[],"/docs/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3592":74796,"_30925":74771,"_5":31260,"_21431":127495,"_28112":127496,"_3048":127497},[],"/docs/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3592":74797,"_30925":74771,"_5":31260,"_21431":127499,"_28112":127500,"_3048":127501},[],"/docs/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3592":74798,"_30925":74771,"_5":31260,"_21431":127503,"_28112":127504,"_3048":127505},[],"/docs/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3592":74799,"_30925":74771,"_5":31260,"_21431":127507,"_28112":127508,"_3048":127509},[],"/docs/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3592":74800,"_30925":74771,"_5":31260,"_21431":127511,"_28112":127512,"_3048":127513},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3592":74801,"_30925":74771,"_5":31260,"_21431":127515,"_28112":127516,"_3048":127517},[],"/docs/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3592":74802,"_30925":74771,"_5":31260,"_21431":127519,"_28112":127520,"_3048":127521},[],"/docs/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3592":74803,"_30925":74771,"_5":31260,"_21431":127523,"_28112":127524,"_3048":127525},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3592":74804,"_30925":74771,"_5":31260,"_21431":127527,"_28112":127528,"_3048":127529},[],"/docs/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3592":74805,"_30925":74771,"_5":31260,"_21431":127531,"_28112":127532,"_3048":127533},[],"/docs/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3592":74806,"_30925":74771,"_5":31260,"_21431":127535,"_28112":127536,"_3048":127537},[],"/docs/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3592":74807,"_30925":74771,"_5":31260,"_21431":127539,"_28112":127540,"_3048":127541},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3592":74808,"_30925":74771,"_5":31260,"_21431":127543,"_28112":127544,"_3048":127545},[],"/docs/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3592":74809,"_30925":74771,"_5":31260,"_21431":127547,"_28112":127548,"_3048":127549},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3592":74810,"_30925":74771,"_5":31260,"_21431":127551,"_28112":127552,"_3048":127553},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3592":74811,"_30925":74771,"_5":31260,"_21431":127555,"_28112":127556,"_3048":127557},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3592":74812,"_30925":74771,"_5":31260,"_21431":127559,"_28112":127560,"_3048":127561},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3592":74813,"_30925":74771,"_5":31260,"_21431":127563,"_28112":127564,"_3048":127565},[],"/docs/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3592":74814,"_30925":74771,"_5":31260,"_21431":127567,"_28112":127568,"_3048":123363},[],"/docs/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3592":74815,"_30925":74771,"_5":31260,"_21431":127570,"_28112":127571,"_3048":127572},[],"/docs/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3592":74816,"_30925":74771,"_5":31260,"_21431":127574,"_28112":127575,"_3048":127576},[],"/docs/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3592":74817,"_30925":74771,"_21431":127578,"_5":14725,"_28112":74771,"_3048":127579},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3592":74818,"_30925":74771,"_21431":127581,"_5":14725,"_28112":74771,"_3048":127582},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3592":74819,"_30925":74771,"_21431":127584,"_5":14725,"_28112":74771,"_3048":127585},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3592":74820,"_30925":74771,"_21431":127587,"_5":14725,"_28112":74771,"_3048":127588},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3592":74821,"_30925":74771,"_21431":127590,"_5":14725,"_28112":74771,"_3048":127591},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3592":74822,"_30925":74771,"_21431":127593,"_5":14725,"_28112":74771,"_3048":127594},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3592":74823,"_30925":74771,"_21431":127596,"_5":14725,"_28112":74771,"_3048":127597},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3592":74824,"_30925":74771,"_21431":127599,"_5":14725,"_28112":127410,"_3048":127600},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3592":74825,"_30925":74771,"_21431":127602,"_5":14725,"_28112":127410,"_3048":127603},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3592":74826,"_30925":74771,"_21431":127605,"_5":14725,"_28112":127414,"_3048":127606},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3592":74827,"_30925":74771,"_21431":127608,"_5":14725,"_28112":127414,"_3048":127609},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3592":74828,"_30925":74771,"_21431":127611,"_5":14725,"_28112":127418,"_3048":127612},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3592":74829,"_30925":74771,"_21431":127614,"_5":14725,"_28112":127422,"_3048":127615},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3592":74830,"_30925":74771,"_21431":127617,"_5":14725,"_28112":127422,"_3048":127618},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3592":74831,"_30925":74771,"_21431":127620,"_5":14725,"_28112":127422,"_3048":127621},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3592":74832,"_30925":74771,"_21431":127623,"_5":14725,"_28112":127422,"_3048":127624},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3592":74833,"_30925":74771,"_21431":127626,"_5":14725,"_28112":127422,"_3048":127627},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3592":74834,"_30925":74771,"_21431":127629,"_5":14725,"_28112":127426,"_3048":127630},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3592":74835,"_30925":74771,"_21431":127632,"_5":14725,"_28112":127426,"_3048":127633},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3592":74836,"_30925":74771,"_21431":127635,"_5":14725,"_28112":127426,"_3048":127636},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3592":74837,"_30925":74771,"_21431":127638,"_5":14725,"_28112":127426,"_3048":127639},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3592":74838,"_30925":74771,"_21431":127641,"_5":14725,"_28112":127426,"_3048":127642},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3592":74839,"_30925":74771,"_21431":127644,"_5":14725,"_28112":127426,"_3048":127645},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3592":74840,"_30925":74771,"_21431":127647,"_5":14725,"_28112":127430,"_3048":127648},[],"Cambio",{"_3592":74841,"_30925":74771,"_21431":127650,"_5":14725,"_28112":127430,"_3048":127651},[],"A quién afecta",{"_3592":74842,"_30925":74771,"_21431":127653,"_5":14725,"_28112":127430,"_3048":127654},[],"Gravedad",{"_3592":74843,"_30925":74771,"_21431":127656,"_5":14725,"_28112":127430,"_3048":126142},[],{"_3592":74844,"_30925":74771,"_21431":127658,"_5":14725,"_28112":127430,"_3048":127438},[],{"_3592":74845,"_30925":74771,"_21431":127660,"_5":14725,"_28112":127430,"_3048":127661},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3592":74846,"_30925":74771,"_21431":127663,"_5":14725,"_28112":127430,"_3048":127664},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3592":74847,"_30925":74771,"_21431":127666,"_5":14725,"_28112":127430,"_3048":127667},[],"Copiar los datos a los volúmenes nuevos",{"_3592":74848,"_30925":74771,"_21431":127669,"_5":14725,"_28112":127430,"_3048":127442},[],{"_3592":74849,"_30925":74771,"_21431":127671,"_5":14725,"_28112":127430,"_3048":127672},[],"Todas las releases de Helm",{"_3592":74850,"_30925":74771,"_21431":127674,"_5":14725,"_28112":127430,"_3048":127675},[],"Alta: `helm upgrade` falla",{"_3592":74851,"_30925":74771,"_21431":127677,"_5":14725,"_28112":127430,"_3048":127678},[],"Eliminar o renombrar las claves heredadas",{"_3592":74852,"_30925":74771,"_21431":127680,"_5":14725,"_28112":127430,"_3048":119838},[],{"_3592":74853,"_30925":74771,"_21431":127682,"_5":14725,"_28112":127430,"_3048":127672},[],{"_3592":74854,"_30925":74771,"_21431":127684,"_5":14725,"_28112":127430,"_3048":127685},[],"Alta: `helm upgrade` falla con credenciales inline",{"_3592":74855,"_30925":74771,"_21431":127687,"_5":14725,"_28112":127430,"_3048":127688},[],"Crear primero los Secrets; consulta el paso 2",{"_3592":74856,"_30925":74771,"_21431":127690,"_5":14725,"_28112":127430,"_3048":127449},[],{"_3592":74857,"_30925":74771,"_21431":127692,"_5":14725,"_28112":127430,"_3048":127693},[],"Todos los despliegues",{"_3592":74858,"_30925":74771,"_21431":127695,"_5":14725,"_28112":127430,"_3048":127696},[],"Alta: sin principal de bootstrap no hay administrador",{"_3592":74859,"_30925":74771,"_21431":127698,"_5":14725,"_28112":127430,"_3048":127699},[],"Configurar `services.authz`",{"_3592":74860,"_30925":74771,"_21431":127701,"_5":14725,"_28112":127430,"_3048":127453},[],{"_3592":74861,"_30925":74771,"_21431":127703,"_5":14725,"_28112":127430,"_3048":127672},[],{"_3592":74862,"_30925":74771,"_21431":127705,"_5":14725,"_28112":127430,"_3048":127706},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3592":74863,"_30925":74771,"_21431":127708,"_5":14725,"_28112":127430,"_3048":127709},[],"Mover JWKS y roles a `services.authz`",{"_3592":74864,"_30925":74771,"_21431":127711,"_5":14725,"_28112":127430,"_3048":127473},[],{"_3592":74865,"_30925":74771,"_21431":127713,"_5":14725,"_28112":127430,"_3048":127714},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3592":74866,"_30925":74771,"_21431":127716,"_5":14725,"_28112":127430,"_3048":127717},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3592":74867,"_30925":74771,"_21431":127719,"_5":14725,"_28112":127430,"_3048":127720},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3592":74868,"_30925":74771,"_21431":127722,"_5":14725,"_28112":127430,"_3048":127477},[],{"_3592":74869,"_30925":74771,"_21431":127724,"_5":14725,"_28112":127430,"_3048":127725},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3592":74870,"_30925":74771,"_21431":127727,"_5":14725,"_28112":127430,"_3048":127728},[],"Alta: el backend ya no arranca con ellos",{"_3592":74871,"_30925":74771,"_21431":127730,"_5":14725,"_28112":127430,"_3048":127731},[],"Pasar a PostgreSQL antes de actualizar",{"_3592":74872,"_30925":74771,"_21431":127733,"_5":14725,"_28112":127430,"_3048":127521},[],{"_3592":74873,"_30925":74771,"_21431":127735,"_5":14725,"_28112":127430,"_3048":127736},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3592":74874,"_30925":74771,"_21431":127738,"_5":14725,"_28112":127430,"_3048":127739},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3592":74875,"_30925":74771,"_21431":127741,"_5":14725,"_28112":127430,"_3048":127742},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3592":74876,"_30925":74771,"_21431":127744,"_5":14725,"_28112":127430,"_3048":127745},[],"Webhooks con referencias a archivos",{"_3592":74877,"_30925":74771,"_21431":127747,"_5":14725,"_28112":127430,"_3048":127748},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3592":74878,"_30925":74771,"_21431":127750,"_5":14725,"_28112":127430,"_3048":127751},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3592":74879,"_30925":74771,"_21431":127753,"_5":14725,"_28112":127430,"_3048":127754},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3592":74880,"_30925":74771,"_21431":127756,"_5":14725,"_28112":127430,"_3048":127457},[],{"_3592":74881,"_30925":74771,"_21431":127758,"_5":14725,"_28112":127430,"_3048":127759},[],"Releases con identidades por servicio o material de claves montado",{"_3592":74882,"_30925":74771,"_21431":127761,"_5":14725,"_28112":127430,"_3048":127762},[],"Media: los servicios no pueden leer sus archivos",{"_3592":74883,"_30925":74771,"_21431":127764,"_5":14725,"_28112":127430,"_3048":127765},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3592":74884,"_30925":74771,"_21431":127767,"_5":14725,"_28112":127430,"_3048":127461},[],{"_3592":74885,"_30925":74771,"_21431":127769,"_5":14725,"_28112":127430,"_3048":127770},[],"Releases que definen `amqp.tls`",{"_3592":74886,"_30925":74771,"_21431":127772,"_5":14725,"_28112":127430,"_3048":127773},[],"Media: los clientes se conectan al puerto equivocado",{"_3592":74887,"_30925":74771,"_21431":127775,"_5":14725,"_28112":127430,"_3048":127776},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3592":74888,"_30925":74771,"_21431":127778,"_5":14725,"_28112":127430,"_3048":127481},[],{"_3592":74889,"_30925":74771,"_21431":127780,"_5":14725,"_28112":127430,"_3048":127781},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3592":74890,"_30925":74771,"_21431":127783,"_5":14725,"_28112":127430,"_3048":127784},[],"Media: las claves de CA quedan sin gestionar",{"_3592":74891,"_30925":74771,"_21431":127786,"_5":14725,"_28112":127430,"_3048":127787},[],"Ejecutar la migración de CA a KMS",{"_3592":74892,"_30925":74771,"_21431":127789,"_5":14725,"_28112":127430,"_3048":127790},[],"Verificación del certificado del receptor",{"_3592":74893,"_30925":74771,"_21431":127792,"_5":14725,"_28112":127430,"_3048":127793},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3592":74894,"_30925":74771,"_21431":127795,"_5":14725,"_28112":127430,"_3048":127796},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3592":74895,"_30925":74771,"_21431":127798,"_5":14725,"_28112":127430,"_3048":127799},[],"Poner `insecure_skip_verify` a `false`",{"_3592":74896,"_30925":74771,"_21431":127801,"_5":14725,"_28112":127430,"_3048":127497},[],{"_3592":74897,"_30925":74771,"_21431":127803,"_5":14725,"_28112":127430,"_3048":127804},[],"Scripts y consolas que editan DMS por API",{"_3592":74898,"_30925":74771,"_21431":127806,"_5":14725,"_28112":127430,"_3048":127807},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3592":74899,"_30925":74771,"_21431":127809,"_5":14725,"_28112":127430,"_3048":127810},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3592":74900,"_30925":74771,"_21431":127812,"_5":14725,"_28112":127430,"_3048":127517},[],{"_3592":74901,"_30925":74771,"_21431":127814,"_5":14725,"_28112":127430,"_3048":127815},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3592":74902,"_30925":74771,"_21431":127817,"_5":14725,"_28112":127430,"_3048":127818},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3592":74903,"_30925":74771,"_21431":127820,"_5":14725,"_28112":127430,"_3048":127821},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3592":74904,"_30925":74771,"_21431":127823,"_5":14725,"_28112":127430,"_3048":127525},[],{"_3592":74905,"_30925":74771,"_21431":127825,"_5":14725,"_28112":127430,"_3048":127826},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3592":74906,"_30925":74771,"_21431":127828,"_5":14725,"_28112":127430,"_3048":127829},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3592":74907,"_30925":74771,"_21431":127831,"_5":14725,"_28112":127430,"_3048":127832},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3592":74908,"_30925":74771,"_21431":127834,"_5":14725,"_28112":127430,"_3048":127513},[],{"_3592":74909,"_30925":74771,"_21431":127836,"_5":14725,"_28112":127430,"_3048":127837},[],"Consumidores que leen el campo `events` del dispositivo",{"_3592":74910,"_30925":74771,"_21431":127839,"_5":14725,"_28112":127430,"_3048":127840},[],"Media: el campo desaparece",{"_3592":74911,"_30925":74771,"_21431":127842,"_5":14725,"_28112":127430,"_3048":127843},[],"Usar los nuevos endpoints de eventos",{"_3592":74912,"_30925":74771,"_21431":127845,"_5":14725,"_28112":127430,"_3048":127533},[],{"_3592":74913,"_30925":74771,"_21431":127847,"_5":14725,"_28112":127430,"_3048":127848},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3592":74914,"_30925":74771,"_21431":127850,"_5":14725,"_28112":127430,"_3048":127851},[],"Media: la migración de la VA aborta",{"_3592":74915,"_30925":74771,"_21431":127853,"_5":14725,"_28112":127430,"_3048":127854},[],"Corregir los roles afectados antes de actualizar",{"_3592":74916,"_30925":74771,"_21431":127856,"_5":14725,"_28112":127430,"_3048":127465},[],{"_3592":74917,"_30925":74771,"_21431":127858,"_5":14725,"_28112":127430,"_3048":127859},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3592":74918,"_30925":74771,"_21431":127861,"_5":14725,"_28112":127430,"_3048":127862},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3592":74919,"_30925":74771,"_21431":127864,"_5":14725,"_28112":127430,"_3048":127865},[],"Actualizar el archivo de values",{"_3592":74920,"_30925":74771,"_21431":127867,"_5":14725,"_28112":127430,"_3048":127505},[],{"_3592":74921,"_30925":74771,"_21431":127869,"_5":14725,"_28112":127430,"_3048":127870},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3592":74922,"_30925":74771,"_21431":127872,"_5":14725,"_28112":127430,"_3048":127873},[],"Baja: prevalece el ID de la URL",{"_3592":74923,"_30925":74771,"_21431":127875,"_5":14725,"_28112":127430,"_3048":127876},[],"Enviar el ID en la URL",{"_3592":74924,"_30925":74771,"_21431":127878,"_5":14725,"_28112":127430,"_3048":127529},[],{"_3592":74925,"_30925":74771,"_21431":127880,"_5":14725,"_28112":127430,"_3048":127881},[],"Clientes que envían un `id` al crear o importar CAs",{"_3592":74926,"_30925":74771,"_21431":127883,"_5":14725,"_28112":127430,"_3048":127884},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3592":74927,"_30925":74771,"_21431":127886,"_5":14725,"_28112":127430,"_3048":127887},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3592":74928,"_30925":74771,"_21431":127889,"_5":14725,"_28112":127430,"_3048":127509},[],{"_3592":74929,"_30925":74771,"_21431":127891,"_5":14725,"_28112":127430,"_3048":127892},[],"Consumidores que comparan el `type` del certificado",{"_3592":74930,"_30925":74771,"_21431":127894,"_5":14725,"_28112":127430,"_3048":127895},[],"Baja: dos valores cambian de nombre",{"_3592":74931,"_30925":74771,"_21431":127897,"_5":14725,"_28112":127430,"_3048":127898},[],"Adaptar los consumidores",{"_3592":74932,"_30925":74771,"_21431":127900,"_5":14725,"_28112":127430,"_3048":127501},[],{"_3592":74933,"_30925":74771,"_21431":127902,"_5":14725,"_28112":127430,"_3048":127903},[],"Cualquier DMS",{"_3592":74934,"_30925":74771,"_21431":127905,"_5":14725,"_28112":127430,"_3048":127906},[],"Baja: solo informativo",{"_3592":74935,"_30925":74771,"_21431":127908,"_5":14725,"_28112":127430,"_3048":127909},[],"Revisar ambos bloques antes de editar",{"_3592":74936,"_30925":74771,"_21431":127911,"_5":14725,"_28112":127437,"_3048":127912},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3592":74937,"_30925":74771,"_21431":127914,"_5":14725,"_28112":127437,"_3048":127915},[],"El paso 4 de la guía de migración copia los datos.",{"_3592":74938,"_30925":74771,"_21431":127917,"_5":14725,"_28112":127441,"_3048":127918},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3592":74939,"_30925":74771,"_21431":127920,"_5":14725,"_28112":127445,"_3048":127921},[],"En 4.0.0 el chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release en lugar de valores inline: `postgres.existingSecret`, `amqp.existingSecret` y — cuando hay autenticación SMTP configurada — `services.alerts.smtp_server.existingSecret`, cada uno con `usernameKey` y `passwordKey` nombrando las claves de datos del Secret. Los valores inline `postgres.username`/`postgres.password` y `amqp.username`/`amqp.password` se eliminan y `values.schema.json` los rechaza, así que un archivo de values de 3.8.0 hace fallar `helm lint` y `helm upgrade` hasta que las credenciales pasen a Secrets.",{"_3592":74940,"_30925":74771,"_21431":127923,"_5":14725,"_28112":127445,"_3048":127924},[],"Los Secrets deben existir antes de ejecutar `helm upgrade`: el job de base de datos de pre-upgrade se conecta a PostgreSQL con ellos. El paso 2 los crea mediante el External Secrets Operator.",{"_3592":74941,"_30925":74771,"_21431":127926,"_5":14725,"_28112":127448,"_3048":127927},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3592":74942,"_30925":74771,"_21431":127929,"_5":14725,"_28112":127452,"_3048":127930},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3592":74943,"_30925":74771,"_21431":127932,"_5":14725,"_28112":127456,"_3048":127933},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3592":74944,"_30925":74771,"_21431":127935,"_5":14725,"_28112":127456,"_3048":127936},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3592":74945,"_30925":74771,"_21431":127938,"_5":14725,"_28112":127456,"_3048":127939},[],"Los pods llevan ahora un `fsGroup: 65532` a nivel de pod con `fsGroupChangePolicy: OnRootMismatch`, que se salta los cambios recursivos de propiedad cuando la raíz del volumen ya tiene el grupo esperado. Si tus herramientas de backup o jobs usan otro GID, verifica que sigan pudiendo acceder a los volúmenes que necesitan.",{"_3592":74946,"_30925":74771,"_21431":127941,"_5":14725,"_28112":127460,"_3048":127942},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3592":74947,"_30925":74771,"_21431":127944,"_5":14725,"_28112":127464,"_3048":127945},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3592":74948,"_30925":74771,"_21431":127947,"_5":14725,"_28112":127464,"_3048":127948},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3592":74949,"_30925":74771,"_21431":127950,"_5":14725,"_28112":127464,"_3048":127951},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3592":74950,"_30925":74771,"_21431":127953,"_5":14725,"_28112":127464,"_3048":127954},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3592":74951,"_30925":74771,"_21431":127956,"_5":14725,"_28112":127464,"_3048":127957},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3592":74952,"_30925":74771,"_21431":127959,"_5":14725,"_28112":127464,"_3048":127960},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3592":74953,"_30925":74771,"_21431":127962,"_5":14725,"_28112":127472,"_3048":127963},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3592":74954,"_30925":74771,"_21431":127965,"_5":14725,"_28112":127472,"_3048":127966},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3592":74955,"_30925":74771,"_21431":127968,"_5":14725,"_28112":127472,"_3048":127969},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3592":74956,"_30925":74771,"_21431":127971,"_5":14725,"_28112":127472,"_3048":127972},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3592":74957,"_30925":74771,"_21431":127974,"_5":14725,"_28112":127472,"_3048":127975},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3592":74958,"_30925":74771,"_21431":127977,"_5":14725,"_28112":127476,"_3048":127978},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3592":74959,"_30925":74771,"_21431":127980,"_5":14725,"_28112":127480,"_3048":127981},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3592":74960,"_30925":74771,"_21431":127983,"_5":14725,"_28112":127480,"_3048":127984},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3592":74961,"_30925":74771,"_21431":127986,"_5":14725,"_28112":127480,"_3048":127987},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3592":74962,"_30925":74771,"_21431":127989,"_5":14725,"_28112":127480,"_3048":127990},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3592":74963,"_30925":74771,"_21431":127992,"_5":14725,"_28112":127480,"_3048":127993},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3592":74964,"_30925":74771,"_21431":127995,"_5":14725,"_28112":127480,"_3048":127996},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3592":74965,"_30925":74771,"_21431":127998,"_5":14725,"_28112":127480,"_3048":127999},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3592":74966,"_30925":74771,"_21431":128001,"_5":14725,"_28112":127480,"_3048":128002},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3592":74967,"_30925":74771,"_21431":128004,"_5":14725,"_28112":127484,"_3048":128005},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3592":74968,"_30925":74771,"_21431":128007,"_5":14725,"_28112":127492,"_3048":128008},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3592":74969,"_30925":74771,"_21431":128010,"_5":14725,"_28112":127492,"_3048":128011},[],"Campo en 3.8.0",{"_3592":74970,"_30925":74771,"_21431":128013,"_5":14725,"_28112":127492,"_3048":128014},[],"Campo en 4.0.0",{"_3592":74971,"_30925":74771,"_21431":128016,"_5":14725,"_28112":127492,"_3048":59515},[],{"_3592":74972,"_30925":74771,"_21431":128018,"_5":14725,"_28112":127492,"_3048":128019},[],"`insecure_skip_verify` (con el valor negado)",{"_3592":74973,"_30925":74771,"_21431":128021,"_5":14725,"_28112":127492,"_3048":59521},[],{"_3592":74974,"_30925":74771,"_21431":128023,"_5":14725,"_28112":127492,"_3048":59524},[],{"_3592":74975,"_30925":74771,"_21431":128025,"_5":14725,"_28112":127492,"_3048":59527},[],{"_3592":74976,"_30925":74771,"_21431":128027,"_5":14725,"_28112":127492,"_3048":59530},[],{"_3592":74977,"_30925":74771,"_21431":128029,"_5":14725,"_28112":127492,"_3048":59533},[],{"_3592":74978,"_30925":74771,"_21431":128031,"_5":14725,"_28112":127492,"_3048":59536},[],{"_3592":74979,"_30925":74771,"_21431":128033,"_5":14725,"_28112":127492,"_3048":128034},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3592":74980,"_30925":74771,"_21431":128036,"_5":14725,"_28112":127492,"_3048":128037},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3592":74981,"_30925":74771,"_21431":128039,"_5":14725,"_28112":127492,"_3048":128040},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3592":74982,"_30925":74771,"_21431":128042,"_5":14725,"_28112":127496,"_3048":128043},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3592":74983,"_30925":74771,"_21431":128045,"_5":14725,"_28112":127496,"_3048":128046},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3592":74984,"_30925":74771,"_21431":128048,"_5":14725,"_28112":127496,"_3048":128049},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3592":74985,"_30925":74771,"_21431":128051,"_5":14725,"_28112":127500,"_3048":128052},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3592":74986,"_30925":74771,"_21431":128054,"_5":14725,"_28112":127504,"_3048":128055},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3592":74987,"_30925":74771,"_21431":128057,"_5":14725,"_28112":127508,"_3048":128058},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3592":74988,"_30925":74771,"_21431":128060,"_5":14725,"_28112":127512,"_3048":128061},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3592":74989,"_30925":74771,"_21431":128063,"_5":14725,"_28112":127512,"_3048":128064},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3592":74990,"_30925":74771,"_21431":128066,"_5":14725,"_28112":127512,"_3048":128067},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3592":74991,"_30925":74771,"_21431":128069,"_5":14725,"_28112":127512,"_3048":128070},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3592":74992,"_30925":74771,"_21431":128072,"_5":14725,"_28112":127516,"_3048":128073},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3592":74993,"_30925":74771,"_21431":128075,"_5":14725,"_28112":127520,"_3048":128076},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3592":74994,"_30925":74771,"_21431":128078,"_5":14725,"_28112":127520,"_3048":128079},[],"Ruta",{"_3592":74995,"_30925":74771,"_21431":128081,"_5":14725,"_28112":127520,"_3048":120469},[],{"_3592":74996,"_30925":74771,"_21431":128083,"_5":14725,"_28112":127520,"_3048":59589},[],{"_3592":74997,"_30925":74771,"_21431":128085,"_5":14725,"_28112":127520,"_3048":128086},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3592":74998,"_30925":74771,"_21431":128088,"_5":14725,"_28112":127520,"_3048":59595},[],{"_3592":74999,"_30925":74771,"_21431":128090,"_5":14725,"_28112":127520,"_3048":128091},[],"Lee los ajustes de una CA.",{"_3592":75000,"_30925":74771,"_21431":128093,"_5":14725,"_28112":127520,"_3048":59601},[],{"_3592":75001,"_30925":74771,"_21431":128095,"_5":14725,"_28112":127520,"_3048":128096},[],"Sustituye los `crl_options`.",{"_3592":75002,"_30925":74771,"_21431":128098,"_5":14725,"_28112":127520,"_3048":59607},[],{"_3592":75003,"_30925":74771,"_21431":128100,"_5":14725,"_28112":127520,"_3048":128101},[],"Elimina los ajustes archivados de una CA.",{"_3592":75004,"_30925":74771,"_21431":128103,"_5":14725,"_28112":127520,"_3048":128104},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE`, `FINAL` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3592":75005,"_30925":74771,"_21431":128106,"_5":14725,"_28112":127520,"_3048":128107},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3592":75006,"_30925":74771,"_21431":128109,"_5":14725,"_28112":127520,"_3048":128110},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3592":75007,"_30925":74771,"_21431":128112,"_5":14725,"_28112":127520,"_3048":128113},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3592":75008,"_30925":74771,"_21431":128115,"_5":14725,"_28112":127520,"_3048":128116},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3592":75009,"_30925":74771,"_21431":128118,"_5":14725,"_28112":127520,"_3048":128119},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3592":75010,"_30925":74771,"_21431":128121,"_5":14725,"_28112":127520,"_3048":128122},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3592":75011,"_30925":74771,"_21431":128124,"_5":14725,"_28112":127520,"_3048":128125},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3592":75012,"_30925":74771,"_21431":128127,"_5":14725,"_28112":127520,"_3048":128128},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3592":75013,"_30925":74771,"_21431":128130,"_5":14725,"_28112":127520,"_3048":128131},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3592":75014,"_30925":74771,"_21431":128133,"_5":14725,"_28112":127520,"_3048":128134},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. La entidad incorpora la acción atómica `delete`, una relación `signer_key_id` con las claves del KMS y las columnas filtrables `signer_engine_id` y `signer_key_id`; concede la acción nueva a quien pueda borrar ajustes de CRL archivados. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3592":75015,"_30925":74771,"_21431":128136,"_5":14725,"_28112":127524,"_3048":128137},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3592":75016,"_30925":74771,"_21431":128139,"_5":14725,"_28112":127528,"_3048":128140},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3592":75017,"_30925":74771,"_21431":128142,"_5":14725,"_28112":127532,"_3048":128143},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3592":75018,"_30925":74771,"_21431":128145,"_5":14725,"_28112":127536,"_3048":128146},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3592":75019,"_30925":74771,"_21431":128148,"_5":14725,"_28112":127540,"_3048":128149},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3592":75020,"_30925":74771,"_21431":128151,"_5":14725,"_28112":127540,"_3048":128152},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3592":75021,"_30925":74771,"_21431":128154,"_5":14725,"_28112":127540,"_3048":128155},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3592":75022,"_30925":74771,"_21431":128157,"_5":14725,"_28112":127540,"_3048":128158},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3592":75023,"_30925":74771,"_21431":128160,"_5":14725,"_28112":127540,"_3048":128161},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3592":75024,"_30925":74771,"_21431":128163,"_5":14725,"_28112":127540,"_3048":128164},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3592":75025,"_30925":74771,"_21431":128166,"_5":14725,"_28112":127544,"_3048":128167},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3592":75026,"_30925":74771,"_21431":128169,"_5":14725,"_28112":127544,"_3048":128170},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3592":75027,"_30925":74771,"_21431":128172,"_5":14725,"_28112":127544,"_3048":128173},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3592":75028,"_30925":74771,"_21431":128175,"_5":14725,"_28112":127544,"_3048":128176},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3592":75029,"_30925":74771,"_21431":128178,"_5":14725,"_28112":127544,"_3048":128179},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3592":75030,"_30925":74771,"_21431":128181,"_5":14725,"_28112":127548,"_3048":128182},[],"**Crea los Secrets de credenciales.** El chart de 4.0.0 lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes, y el job de base de datos de pre-upgrade las necesita antes de que se ejecute la actualización. Copia las credenciales de 3.8.0 a tu proveedor de gestión de secretos y crea los Secrets con el External Secrets Operator (ESO), que el chart no instala:",{"_3592":75031,"_30925":74771,"_21431":128184,"_5":14725,"_28112":127548,"_3048":128185},[],"Configura ESO y su proveedor (`SecretStore` o `ClusterSecretStore`).",{"_3592":75032,"_30925":74771,"_21431":128187,"_5":14725,"_28112":127548,"_3048":128188},[],"Crea un `ExternalSecret` por cada conjunto de credenciales que uses. Su Secret de destino debe vivir en el namespace de la release, llamarse como el valor `existingSecret` correspondiente y contener estas claves:",{"_3592":75033,"_30925":74771,"_21431":128190,"_5":14725,"_28112":127548,"_3048":59700},[],{"_3592":75034,"_30925":74771,"_21431":128192,"_5":14725,"_28112":127548,"_3048":128193},[],"Claves de datos obligatorias",{"_3592":75035,"_30925":74771,"_21431":128195,"_5":14725,"_28112":127548,"_3048":128196},[],"Cuándo",{"_3592":75036,"_30925":74771,"_21431":128198,"_5":14725,"_28112":127548,"_3048":128199},[],"`lamassu-postgres` (por defecto de `postgres.existingSecret`)",{"_3592":75037,"_30925":74771,"_21431":128201,"_5":14725,"_28112":127548,"_3048":59712},[],{"_3592":75038,"_30925":74771,"_21431":128203,"_5":14725,"_28112":127548,"_3048":128204},[],"Siempre",{"_3592":75039,"_30925":74771,"_21431":128206,"_5":14725,"_28112":127548,"_3048":128207},[],"`lamassu-amqp` (por defecto de `amqp.existingSecret`)",{"_3592":75040,"_30925":74771,"_21431":128209,"_5":14725,"_28112":127548,"_3048":59712},[],{"_3592":75041,"_30925":74771,"_21431":128211,"_5":14725,"_28112":127548,"_3048":128204},[],{"_3592":75042,"_30925":74771,"_21431":128213,"_5":14725,"_28112":127548,"_3048":59725},[],{"_3592":75043,"_30925":74771,"_21431":128215,"_5":14725,"_28112":127548,"_3048":59712},[],{"_3592":75044,"_30925":74771,"_21431":128217,"_5":14725,"_28112":127548,"_3048":128218},[],"Solo cuando hay autenticación SMTP",{"_3592":75045,"_30925":74771,"_21431":128220,"_5":14725,"_28112":127548,"_3048":128221},[],"Espera a que cada `ExternalSecret` esté Ready y verifica los Secrets generados antes de ejecutar la actualización.",{"_3592":75046,"_30925":74771,"_21431":128223,"_5":14725,"_28112":127548,"_3048":128224},[],"No cambies las contraseñas de la base de datos ni del broker como parte de esta migración: ESO sincroniza credenciales en Secrets, pero no actualiza los usuarios configurados en el servidor PostgreSQL ni en el broker. Quitar credenciales del archivo de values no deshace la exposición previa — si se llegaron a subir a Git, rotarlas cuando la migración se haya completado.",{"_3592":75047,"_30925":74771,"_21431":128226,"_5":14725,"_28112":127548,"_3048":128227},[],"El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` Fake de prueba, los recursos `ExternalSecret` y la espera de la sincronización. Su proveedor Fake es solo para pruebas; para producción, sustitúyelo por la configuración de tu proveedor.",{"_3592":75048,"_30925":74771,"_21431":128229,"_5":14725,"_28112":127548,"_3048":128230},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3592":75049,"_30925":74771,"_21431":128232,"_5":14725,"_28112":127548,"_3048":128233},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3592":75050,"_30925":74771,"_21431":128235,"_5":14725,"_28112":127548,"_3048":128236},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se exige el campo `database` de cada entrada; los `hostname` y `port` por esquema se siguen aceptando pero se ignoran — la conexión usa siempre los `postgres.hostname` y `postgres.port` globales con el Secret de credenciales de PostgreSQL global, `postgres.existingSecret` con sus nombres de clave configurados, salvo que la entrada defina su propio `existingSecret` (con `usernameKey` y `passwordKey` opcionales).",{"_3592":75051,"_30925":74771,"_21431":128238,"_5":14725,"_28112":127548,"_3048":128239},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3592":75052,"_30925":74771,"_21431":128241,"_5":14725,"_28112":127548,"_3048":128242},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3592":75053,"_30925":74771,"_21431":128244,"_5":14725,"_28112":127548,"_3048":128245},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3592":75054,"_30925":74771,"_21431":128247,"_5":14725,"_28112":127548,"_3048":128248},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3592":75055,"_30925":74771,"_21431":128250,"_5":14725,"_28112":127548,"_3048":128251},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3592":75056,"_30925":74771,"_21431":128253,"_5":14725,"_28112":127548,"_3048":128254},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3592":75057,"_30925":74771,"_21431":128256,"_5":14725,"_28112":127548,"_3048":128257},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3592":75058,"_30925":74771,"_21431":128259,"_5":14725,"_28112":127548,"_3048":128260},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3592":75059,"_30925":74771,"_21431":128262,"_5":14725,"_28112":127548,"_3048":128263},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida. Antes de ejecutar el paso 3, confirma que cada `ExternalSecret` de credenciales esté Ready y que los Secrets generados contengan las claves esperadas.",{"_3592":75060,"_30925":74771,"_21431":128265,"_5":14725,"_28112":127552,"_3048":128266},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3592":75061,"_30925":74771,"_21431":128268,"_5":14725,"_28112":127552,"_3048":128269},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3592":75062,"_30925":74771,"_21431":128271,"_5":14725,"_28112":127556,"_3048":128272},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3592":75063,"_30925":74771,"_21431":128274,"_5":14725,"_28112":127556,"_3048":128275},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3592":75064,"_30925":74771,"_21431":128277,"_5":14725,"_28112":127556,"_3048":128278},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3592":75065,"_30925":74771,"_21431":128280,"_5":14725,"_28112":127556,"_3048":128281},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3592":75066,"_30925":74771,"_21431":128283,"_5":14725,"_28112":127556,"_3048":128284},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3592":75067,"_30925":74771,"_21431":128286,"_5":14725,"_28112":127556,"_3048":128287},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3592":75068,"_30925":74771,"_21431":128289,"_5":14725,"_28112":127556,"_3048":128290},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3592":75069,"_30925":74771,"_21431":128292,"_5":14725,"_28112":127556,"_3048":128293},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3592":75070,"_30925":74771,"_21431":128295,"_5":14725,"_28112":127556,"_3048":128296},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3592":75071,"_30925":74771,"_21431":128298,"_5":14725,"_28112":127556,"_3048":128299},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3592":75072,"_30925":74771,"_21431":128301,"_5":14725,"_28112":127556,"_3048":128302},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3592":75073,"_30925":74771,"_21431":128304,"_5":14725,"_28112":127560,"_3048":128305},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3592":75074,"_30925":74771,"_21431":128307,"_5":14725,"_28112":127560,"_3048":128308},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3592":75075,"_30925":74771,"_21431":128310,"_5":14725,"_28112":127564,"_3048":128311},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3592":75076,"_30925":74771,"_21431":128313,"_5":14725,"_28112":127564,"_3048":128314},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3592":75077,"_30925":74771,"_21431":128316,"_5":14725,"_28112":127564,"_3048":128317},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` requiere que `ca` y `kms` se hayan migrado primero: falla con `ca schema not found: migrate the ca schema before the va schema` o `kms schema not found: migrate the kms schema before the va schema` si falta alguno de los dos.",{"_3592":75078,"_30925":74771,"_21431":128319,"_5":14725,"_28112":127564,"_3048":128320},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates`, `SELECT` sobre `ca.ca_certificates`, y `USAGE` sobre `kms` más `SELECT` y `REFERENCES` sobre `kms.kms_keys`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`. Tras migrar `va`, si el servicio de CA corre con un usuario distinto, concédele `USAGE` sobre el esquema `va` y `SELECT` sobre `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): el servicio de CA lee `va.crl_settings` cuando elimina una CA, y sin estos permisos toda eliminación de una CA que tenga motor criptográfico falla con `permission denied for schema va` (o `for table crl_settings`).",{"_3592":75079,"_30925":74771,"_21431":128322,"_5":14725,"_28112":127564,"_3048":128323},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3592":75080,"_30925":74771,"_21431":128325,"_5":14725,"_28112":127564,"_3048":128326},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3592":75081,"_30925":74771,"_21431":128328,"_5":14725,"_28112":127564,"_3048":128329},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3592":75082,"_30925":74771,"_21431":128331,"_5":14725,"_28112":127564,"_3048":128332},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3592":75083,"_30925":74771,"_21431":128334,"_5":14725,"_28112":127568,"_3048":128335},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3592":75084,"_30925":74771,"_21431":128337,"_5":14725,"_28112":127568,"_3048":128338},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3592":75085,"_30925":74771,"_21431":128340,"_5":14725,"_28112":127568,"_3048":128341},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3592":75086,"_30925":74771,"_21431":128343,"_5":14725,"_28112":127568,"_3048":128344},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3592":75087,"_30925":74771,"_21431":128346,"_5":14725,"_28112":127568,"_3048":128347},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3592":75088,"_30925":74771,"_21431":128349,"_5":14725,"_28112":127568,"_3048":128350},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3592":75089,"_30925":74771,"_21431":128352,"_5":14725,"_28112":127568,"_3048":128353},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3592":75090,"_30925":74771,"_21431":128355,"_5":14725,"_28112":127568,"_3048":128356},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que las migraciones de los esquemas `ca` y `va`.",{"_3592":75091,"_30925":74771,"_21431":128358,"_5":14725,"_28112":127568,"_3048":128359},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3592":75092,"_30925":74771,"_21431":128361,"_5":14725,"_28112":127568,"_3048":128362},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3592":75093,"_30925":74771,"_21431":128364,"_5":14725,"_28112":127568,"_3048":128365},[],"**Una migración o un servicio falla con `permission denied for table ...` o `permission denied for schema ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración, y `permission denied for schema va` (o `for table crl_settings`) al eliminar una CA sin los permisos de `va`. Concede los privilegios que falten y vuelve a ejecutar.",{"_3592":75094,"_30925":74771,"_21431":128367,"_5":14725,"_28112":127571,"_3048":128368},[],"Tras la actualización, comprueba en este orden:",{"_3592":75095,"_30925":74771,"_21431":128370,"_5":14725,"_28112":127571,"_3048":128371},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3592":75096,"_30925":74771,"_21431":128373,"_5":14725,"_28112":127571,"_3048":128374},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3592":75097,"_30925":74771,"_21431":128376,"_5":14725,"_28112":127571,"_3048":128377},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3592":75098,"_30925":74771,"_21431":128379,"_5":14725,"_28112":127571,"_3048":128380},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3592":75099,"_30925":74771,"_21431":128382,"_5":14725,"_28112":127571,"_3048":128383},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3592":75100,"_30925":74771,"_21431":128385,"_5":14725,"_28112":127571,"_3048":128386},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3592":75101,"_30925":74771,"_21431":128388,"_5":14725,"_28112":127571,"_3048":128389},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3592":75102,"_30925":74771,"_21431":128391,"_5":14725,"_28112":127571,"_3048":128392},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3592":75103,"_30925":74771,"_21431":128394,"_5":14725,"_28112":127571,"_3048":128395},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3592":75104,"_30925":74771,"_21431":128397,"_5":14725,"_28112":127571,"_3048":128398},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3592":75105,"_30925":74771,"_21431":128400,"_5":14725,"_28112":127571,"_3048":128401},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3592":75106,"_30925":74771,"_21431":128403,"_5":14725,"_28112":127571,"_3048":128404},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3592":75107,"_30925":74771,"_21431":128406,"_5":14725,"_28112":127571,"_3048":128407},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3592":75108,"_30925":74771,"_21431":128409,"_5":14725,"_28112":127571,"_3048":128410},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3592":75109,"_30925":74771,"_21431":128412,"_5":14725,"_28112":127571,"_3048":128413},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3592":75110,"_30925":74771,"_21431":128415,"_5":14725,"_28112":127575,"_3048":128416},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3592":75111,"_30925":74771,"_21431":128418,"_5":14725,"_28112":127575,"_3048":128419},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3592":75112,"_30925":74771,"_21431":128421,"_5":14725,"_28112":127575,"_3048":128422},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3592":75113,"_30925":74771,"_21431":128424,"_5":14725,"_28112":127575,"_3048":128425},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3592":75114,"_30925":74771,"_21431":128427,"_5":14725,"_28112":127575,"_3048":128428},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_59943":128430,"_59945":128431,"_59947":128432,"_59949":128433,"_18556":3083,"_72080":3083},"spanish",[3048,30925,5,28112],{"_3048":25573,"_30925":25573,"_5":25573,"_28112":25573},{"_3048":128434,"_30925":131465,"_5":134496,"_28112":137527},{"_4788":128435,"_59953":128436,"_5":25573},{"_14801":7172,"_15184":7718,"_15203":7149,"_29924":7428,"_15190":4175,"_20338":3339,"_14822":17116,"_14829":22119,"_29866":12047,"_30280":6173,"_30301":18426,"_29900":7254,"_35286":6810,"_30003":20824,"_30345":10148,"_35293":5407,"_35296":4109,"_35299":6482,"_35302":3337,"_30747":22659,"_35307":4866,"_35309":25969,"_30782":11891,"_15199":18935,"_35313":7747,"_35316":10751,"_35318":7222,"_30329":5212,"_30767":3482,"_30795":4349,"_35323":7223,"_35325":5578,"_35327":7221,"_30020":10739,"_35330":4762,"_35332":7154,"_35334":3426,"_35336":12610,"_35338":3449,"_29937":6200,"_35341":3406,"_35343":7862,"_29931":6809,"_30366":10684,"_35347":27704,"_35349":14515,"_35352":5118,"_29977":4686,"_35356":8429,"_29857":6155,"_35359":3808,"_29905":4065,"_35362":10640,"_35364":13608,"_35367":11608,"_15193":18991,"_35370":9325,"_35372":7916,"_35375":7217,"_35377":6827,"_35379":3498,"_35381":13226,"_35383":7246,"_20341":3440,"_35386":10778,"_35388":3802,"_29878":6699,"_30323":5316,"_35392":10450,"_35394":4279,"_35396":7598,"_30812":5320,"_35399":3760,"_35401":7142,"_35403":6680,"_30905":3674,"_30382":3635,"_35407":3112,"_35409":3357,"_29915":7733,"_35412":7148,"_35414":7843,"_35416":6496,"_30828":5246,"_29997":12677,"_29377":17414,"_35421":3323,"_35423":26671,"_35425":4927,"_30046":19622,"_35429":6554,"_30317":13232,"_35433":24309,"_35435":6542,"_35437":3125,"_35439":4875,"_35441":4127,"_35443":7159,"_30035":4545,"_30285":5599,"_35447":3524,"_35449":5215,"_35451":5697,"_35454":7878,"_35456":7740,"_35458":9324,"_35460":3297,"_35462":7799,"_35464":9088,"_35466":4339,"_35469":4899,"_35471":10142,"_35473":12183,"_35475":5289,"_35477":3344,"_35480":6019,"_35482":24717,"_35485":21574,"_35488":21655,"_35490":25140,"