949,"_39487":56952,"_39489":56955,"_39491":56958,"_39493":56961,"_39495":56964,"_39497":56967,"_39499":56970,"_39501":56973,"_39503":56976,"_39505":56979,"_39507":56982,"_39509":56985,"_39511":56988,"_39513":56991,"_39515":56994,"_39517":56997,"_39519":57000,"_39521":57003,"_39523":57006,"_39525":57009,"_39527":57012,"_39529":57015,"_39531":57018,"_39533":57021,"_39535":57024,"_39537":57027,"_39539":57030,"_39541":57033,"_39543":57036,"_39545":57039,"_39547":57042,"_39549":57045,"_39551":57048,"_39553":57051,"_39555":57054,"_39557":57057,"_39559":57060,"_39561":57063,"_39563":57066,"_39565":57069,"_39567":57072,"_39570":57075,"_39572":57078,"_39574":57081,"_39576":57084},{"_3379":15,"_29619":15,"_5":14457,"_2865":48189,"_29951":48190,"_20556":48194,"_26939":15},"Deploy from AWS Marketplace",[48191,48192,48193],"Docs","Deployment","Other models",[],{"_3379":16,"_29619":15,"_20556":48196,"_5":14099,"_26939":15,"_2865":48197},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3379":17,"_29619":15,"_5":29948,"_20556":48199,"_26939":48200,"_2865":48201},[],"/docs/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3379":18,"_29619":15,"_5":29948,"_20556":48203,"_26939":48204,"_2865":48205},[],"/docs/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3379":19,"_29619":15,"_5":29948,"_20556":48207,"_26939":48208,"_2865":48209},[],"/docs/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3379":20,"_29619":15,"_5":29948,"_20556":48211,"_26939":48212,"_2865":48213},[],"/docs/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3379":21,"_29619":15,"_5":29948,"_20556":48215,"_26939":48216,"_2865":48217},[],"/docs/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3379":22,"_29619":15,"_5":29948,"_20556":48219,"_26939":48220,"_2865":48221},[],"/docs/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3379":23,"_29619":15,"_5":29948,"_20556":48223,"_26939":48224,"_2865":48225},[],"/docs/deployment/aws-marketplace#next-step","Next step",{"_3379":24,"_29619":15,"_20556":48227,"_5":14099,"_26939":15,"_2865":48228},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3379":25,"_29619":15,"_20556":48230,"_5":14099,"_26939":48200,"_2865":48231},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3379":26,"_29619":15,"_20556":48233,"_5":14099,"_26939":48200,"_2865":48234},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3379":27,"_29619":15,"_20556":48236,"_5":14099,"_26939":48200,"_2865":48237},[],"A security group allowing the necessary endpoints.",{"_3379":28,"_29619":15,"_20556":48239,"_5":14099,"_26939":48204,"_2865":48240},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3379":29,"_29619":15,"_20556":48242,"_5":14099,"_26939":48204,"_2865":48243},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3379":30,"_29619":15,"_20556":48245,"_5":14099,"_26939":48204,"_2865":48246},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3379":31,"_29619":15,"_20556":48248,"_5":14099,"_26939":48208,"_2865":48249},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3379":32,"_29619":15,"_20556":48251,"_5":14099,"_26939":48212,"_2865":48252},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3379":33,"_29619":15,"_20556":48254,"_5":14099,"_26939":48216,"_2865":48255},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3379":34,"_29619":15,"_20556":48257,"_5":14099,"_26939":48220,"_2865":48258},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3379":35,"_29619":15,"_20556":48260,"_5":14099,"_26939":48224,"_2865":48261},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3379":36,"_29619":36,"_5":14457,"_2865":48263,"_29951":48264,"_20556":48265,"_26939":36},"Deploy Lamassu",[48191,48192],[],{"_3379":37,"_29619":36,"_20556":48267,"_5":14099,"_26939":36,"_2865":48268},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3379":38,"_29619":36,"_5":29948,"_20556":48270,"_26939":48271,"_2865":48272},[],"/docs/deployment/overview#choose-a-model","Choose a model",{"_3379":39,"_29619":36,"_5":29948,"_20556":48274,"_26939":48275,"_2865":48276},[],"/docs/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3379":40,"_29619":36,"_5":29948,"_20556":48278,"_26939":48279,"_2865":48280},[],"/docs/deployment/overview#after-deployment","After deployment",{"_3379":41,"_29619":36,"_20556":48282,"_5":14099,"_26939":36,"_2865":48283},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3379":42,"_29619":36,"_20556":48285,"_5":14099,"_26939":48271,"_2865":48286},[],"Model",{"_3379":43,"_29619":36,"_20556":48288,"_5":14099,"_26939":48271,"_2865":48289},[],"Recommended for",{"_3379":44,"_29619":36,"_20556":48291,"_5":14099,"_26939":48271,"_2865":48292},[],"Who operates the infrastructure",{"_3379":45,"_29619":36,"_20556":48294,"_5":14099,"_26939":48271,"_2865":48295},[],"Starting point",{"_3379":46,"_29619":36,"_20556":48297,"_5":14099,"_26939":48271,"_2865":48298},[],"Kubernetes self-managed",{"_3379":47,"_29619":36,"_20556":48300,"_5":14099,"_26939":48271,"_2865":48301},[],"Production, regulated environments and custom deployments",{"_3379":48,"_29619":36,"_20556":48303,"_5":14099,"_26939":48271,"_2865":48304},[],"Your team",{"_3379":49,"_29619":36,"_20556":48306,"_5":14099,"_26939":48271,"_2865":48307},[],"Helm or Fastlane",{"_3379":50,"_29619":36,"_20556":48309,"_5":14099,"_26939":48271,"_2865":48310},[],"AWS Marketplace",{"_3379":51,"_29619":36,"_20556":48312,"_5":14099,"_26939":48271,"_2865":48313},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3379":52,"_29619":36,"_20556":48315,"_5":14099,"_26939":48271,"_2865":48304},[],{"_3379":53,"_29619":36,"_20556":48317,"_5":14099,"_26939":48271,"_2865":48318},[],"Preconfigured image on EC2",{"_3379":54,"_29619":36,"_20556":48320,"_5":14099,"_26939":48271,"_2865":48321},[],"SaaS",{"_3379":55,"_29619":36,"_20556":48323,"_5":14099,"_26939":48271,"_2865":48324},[],"Teams that want to use the platform without operating it",{"_3379":56,"_29619":36,"_20556":48326,"_5":14099,"_26939":48271,"_2865":48327},[],"Lamassu",{"_3379":57,"_29619":36,"_20556":48329,"_5":14099,"_26939":48271,"_2865":48330},[],"Managed subscription",{"_3379":58,"_29619":36,"_20556":48332,"_5":14099,"_26939":48271,"_2865":48333},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3379":59,"_29619":36,"_20556":48335,"_5":14099,"_26939":48271,"_2865":48336},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3379":60,"_29619":36,"_20556":48338,"_5":14099,"_26939":48271,"_2865":48339},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3379":61,"_29619":36,"_20556":48341,"_5":14099,"_26939":48275,"_2865":48342},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3379":62,"_29619":36,"_20556":48344,"_5":14099,"_26939":48279,"_2865":48345},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3379":63,"_29619":63,"_5":14457,"_2865":48347,"_29951":48348,"_20556":48349,"_26939":63},"Use Lamassu as SaaS",[48191,48192,48193],[],{"_3379":64,"_29619":63,"_20556":48351,"_5":14099,"_26939":63,"_2865":48352},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3379":65,"_29619":63,"_5":29948,"_20556":48354,"_26939":48355,"_2865":48356},[],"/docs/deployment/saas#what-the-service-manages","What the service manages",{"_3379":66,"_29619":63,"_5":29948,"_20556":48358,"_26939":48359,"_2865":48360},[],"/docs/deployment/saas#plans","Plans",{"_3379":67,"_29619":63,"_5":29948,"_20556":48362,"_26939":48363,"_2865":48364},[],"/docs/deployment/saas#request-access","Request access",{"_3379":68,"_29619":63,"_20556":48366,"_5":14099,"_26939":63,"_2865":48367},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3379":69,"_29619":63,"_20556":48369,"_5":14099,"_26939":48355,"_2865":48370},[],"Platform availability and maintenance.",{"_3379":70,"_29619":63,"_20556":48372,"_5":14099,"_26939":48355,"_2865":48373},[],"Automatic backups.",{"_3379":71,"_29619":63,"_20556":48375,"_5":14099,"_26939":48355,"_2865":48376},[],"Version upgrades.",{"_3379":72,"_29619":63,"_20556":48378,"_5":14099,"_26939":48355,"_2865":48379},[],"Technical support and SLA according to your plan.",{"_3379":73,"_29619":63,"_20556":48381,"_5":14099,"_26939":48359,"_2865":48382},[],"Plan",{"_3379":74,"_29619":63,"_20556":48384,"_5":14099,"_26939":48359,"_2865":48385},[],"Devices",{"_3379":75,"_29619":63,"_20556":48387,"_5":14099,"_26939":48359,"_2865":48388},[],"Support",{"_3379":76,"_29619":63,"_20556":48390,"_5":14099,"_26939":48359,"_2865":48391},[],"SLA",{"_3379":77,"_29619":63,"_20556":48393,"_5":14099,"_26939":48359,"_2865":48394},[],"Starter",{"_3379":78,"_29619":63,"_20556":48396,"_5":14099,"_26939":48359,"_2865":48397},[],"Up to 1,000",{"_3379":79,"_29619":63,"_20556":48399,"_5":14099,"_26939":48359,"_2865":48400},[],"Email",{"_3379":80,"_29619":63,"_20556":48402,"_5":14099,"_26939":48359,"_2865":48403},[],"99.5 %",{"_3379":81,"_29619":63,"_20556":48405,"_5":14099,"_26939":48359,"_2865":48406},[],"Professional",{"_3379":82,"_29619":63,"_20556":48408,"_5":14099,"_26939":48359,"_2865":48409},[],"Up to 10,000",{"_3379":83,"_29619":63,"_20556":48411,"_5":14099,"_26939":48359,"_2865":48412},[],"Email and chat",{"_3379":84,"_29619":63,"_20556":48414,"_5":14099,"_26939":48359,"_2865":48415},[],"99.9 %",{"_3379":85,"_29619":63,"_20556":48417,"_5":14099,"_26939":48359,"_2865":48418},[],"Enterprise",{"_3379":86,"_29619":63,"_20556":48420,"_5":14099,"_26939":48359,"_2865":48421},[],"Unlimited",{"_3379":87,"_29619":63,"_20556":48423,"_5":14099,"_26939":48359,"_2865":48424},[],"Dedicated",{"_3379":88,"_29619":63,"_20556":48426,"_5":14099,"_26939":48359,"_2865":48427},[],"99.99 %",{"_3379":89,"_29619":63,"_20556":48429,"_5":14099,"_26939":48363,"_2865":48430},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3379":90,"_29619":63,"_20556":48432,"_5":14099,"_26939":48363,"_2865":48433},[],"When you receive your instance's credentials, continue with Get started.",{"_3379":91,"_29619":91,"_5":14457,"_2865":48435,"_29951":48436,"_20556":48437,"_26939":91},"Fastlane",[48191,48192,48298],[],{"_3379":92,"_29619":91,"_20556":48439,"_5":14099,"_26939":91,"_2865":48440},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3379":93,"_29619":91,"_5":29948,"_20556":48442,"_26939":48443,"_2865":48444},[],"/docs/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3379":94,"_29619":91,"_5":29948,"_20556":48446,"_26939":48447,"_2865":48448},[],"/docs/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3379":95,"_29619":91,"_5":29948,"_20556":48450,"_26939":48451,"_2865":48201},[],"/docs/deployment/self-hosted/fastlane#before-you-begin",{"_3379":96,"_29619":91,"_5":29948,"_20556":48453,"_26939":48454,"_2865":48455},[],"/docs/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3379":97,"_29619":91,"_5":29948,"_20556":48457,"_26939":48458,"_2865":48459},[],"/docs/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3379":98,"_29619":91,"_5":29948,"_20556":48461,"_26939":48462,"_2865":48463},[],"/docs/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3379":99,"_29619":91,"_5":29948,"_20556":48465,"_26939":48466,"_2865":48467},[],"/docs/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3379":100,"_29619":91,"_5":29948,"_20556":48469,"_26939":48470,"_2865":48471},[],"/docs/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3379":101,"_29619":91,"_5":29948,"_20556":48473,"_26939":48474,"_2865":48475},[],"/docs/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3379":102,"_29619":91,"_5":29948,"_20556":48477,"_26939":48478,"_2865":48479},[],"/docs/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3379":103,"_29619":91,"_5":29948,"_20556":48481,"_26939":48482,"_2865":48483},[],"/docs/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3379":104,"_29619":91,"_20556":48485,"_5":14099,"_26939":48443,"_2865":48486},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3379":105,"_29619":91,"_20556":48488,"_5":14099,"_26939":48443,"_2865":48489},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3379":106,"_29619":91,"_20556":48491,"_5":14099,"_26939":48447,"_2865":48492},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3379":107,"_29619":91,"_20556":48494,"_5":14099,"_26939":48447,"_2865":48495},[],"Fastlane installs or configures",{"_3379":108,"_29619":91,"_20556":48497,"_5":14099,"_26939":48447,"_2865":48498},[],"You still provide",{"_3379":109,"_29619":91,"_20556":48500,"_5":14099,"_26939":48447,"_2865":48501},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3379":110,"_29619":91,"_20556":48503,"_5":14099,"_26939":48447,"_2865":48504},[],"The Kubernetes cluster, nodes and persistent storage",{"_3379":111,"_29619":91,"_20556":48506,"_5":14099,"_26939":48447,"_2865":48507},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3379":112,"_29619":91,"_20556":48509,"_5":14099,"_26939":48447,"_2865":48510},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3379":113,"_29619":91,"_20556":48512,"_5":14099,"_26939":48447,"_2865":48513},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3379":114,"_29619":91,"_20556":48515,"_5":14099,"_26939":48447,"_2865":48516},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3379":115,"_29619":91,"_20556":48518,"_5":14099,"_26939":48447,"_2865":48519},[],"Optional observability and lab HSM components",{"_3379":116,"_29619":91,"_20556":48521,"_5":14099,"_26939":48447,"_2865":48522},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3379":117,"_29619":91,"_20556":48524,"_5":14099,"_26939":48447,"_2865":48525},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3379":118,"_29619":91,"_20556":48527,"_5":14099,"_26939":48451,"_2865":48528},[],"You need:",{"_3379":119,"_29619":91,"_20556":48530,"_5":14099,"_26939":48451,"_2865":48531},[],"an existing Kubernetes cluster",{"_3379":120,"_29619":91,"_20556":48533,"_5":14099,"_26939":48451,"_2865":48534},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3379":121,"_29619":91,"_20556":48536,"_5":14099,"_26939":48451,"_2865":48537},[],"`yq`",{"_3379":122,"_29619":91,"_20556":48539,"_5":14099,"_26939":48451,"_2865":23237},[],{"_3379":123,"_29619":91,"_20556":48541,"_5":14099,"_26939":48451,"_2865":48542},[],"`jq` only when using `--sample-data` or `--development`",{"_3379":124,"_29619":91,"_20556":48544,"_5":14099,"_26939":48451,"_2865":48545},[],"`ssh-keygen` only when using `--with-hsm`",{"_3379":125,"_29619":91,"_20556":48547,"_5":14099,"_26939":48451,"_2865":48548},[],"free external ports 80 and 443 on a single-node K3s host",{"_3379":126,"_29619":91,"_20556":48550,"_5":14099,"_26939":48451,"_2865":48551},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3379":127,"_29619":91,"_20556":48553,"_5":14099,"_26939":48451,"_2865":48554},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3379":128,"_29619":91,"_20556":48556,"_5":14099,"_26939":48454,"_2865":48557},[],"Run the script from a clone of the Helm repository:",{"_3379":129,"_29619":91,"_20556":48559,"_5":14099,"_26939":48454,"_2865":48560},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3379":130,"_29619":91,"_20556":48562,"_5":14099,"_26939":48458,"_2865":48563},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3379":131,"_29619":91,"_20556":48565,"_5":14099,"_26939":48458,"_2865":48566},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3379":132,"_29619":91,"_20556":48568,"_5":14099,"_26939":48458,"_2865":48569},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3379":133,"_29619":91,"_20556":48571,"_5":14099,"_26939":48458,"_2865":48572},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3379":134,"_29619":91,"_20556":48574,"_5":14099,"_26939":48462,"_2865":48575},[],"Option",{"_3379":135,"_29619":91,"_20556":48577,"_5":14099,"_26939":48462,"_2865":48578},[],"Default",{"_3379":136,"_29619":91,"_20556":48580,"_5":14099,"_26939":48462,"_2865":48581},[],"Purpose",{"_3379":137,"_29619":91,"_20556":48583,"_5":14099,"_26939":48462,"_2865":48584},[],"`-h`, `--help`",{"_3379":138,"_29619":91,"_20556":48586,"_5":14099,"_26939":48462,"_2865":48587},[],"—",{"_3379":139,"_29619":91,"_20556":48589,"_5":14099,"_26939":48462,"_2865":48590},[],"Show help",{"_3379":140,"_29619":91,"_20556":48592,"_5":14099,"_26939":48462,"_2865":48593},[],"`-c`, `--context`",{"_3379":141,"_29619":91,"_20556":48595,"_5":14099,"_26939":48462,"_2865":48596},[],"current context",{"_3379":142,"_29619":91,"_20556":48598,"_5":14099,"_26939":48462,"_2865":48599},[],"Select the kubeconfig context for kubectl and Helm",{"_3379":143,"_29619":91,"_20556":48601,"_5":14099,"_26939":48462,"_2865":48602},[],"`-n`, `--non-interactive`",{"_3379":144,"_29619":91,"_20556":48604,"_5":14099,"_26939":48462,"_2865":6393},[],{"_3379":145,"_29619":91,"_20556":48606,"_5":14099,"_26939":48462,"_2865":48607},[],"Skip prompts and generate dependency credentials",{"_3379":146,"_29619":91,"_20556":48609,"_5":14099,"_26939":48462,"_2865":48610},[],"`-ns`, `--namespace`",{"_3379":147,"_29619":91,"_20556":48612,"_5":14099,"_26939":48462,"_2865":48613},[],"`lamassu-dev`",{"_3379":148,"_29619":91,"_20556":48615,"_5":14099,"_26939":48462,"_2865":48616},[],"Namespace for the installation",{"_3379":149,"_29619":91,"_20556":48618,"_5":14099,"_26939":48462,"_2865":48619},[],"`-d`, `--domain`",{"_3379":150,"_29619":91,"_20556":48621,"_5":14099,"_26939":48462,"_2865":48622},[],"`dev.lamassu.io`",{"_3379":151,"_29619":91,"_20556":48624,"_5":14099,"_26939":48462,"_2865":48625},[],"Domain used by the UI, OIDC and certificate",{"_3379":152,"_29619":91,"_20556":48627,"_5":14099,"_26939":48462,"_2865":48628},[],"`-v`, `--version`",{"_3379":153,"_29619":91,"_20556":48630,"_5":14099,"_26939":48462,"_2865":14791},[],{"_3379":154,"_29619":91,"_20556":48632,"_5":14099,"_26939":48462,"_2865":48633},[],"Lamassu chart version",{"_3379":155,"_29619":91,"_20556":48635,"_5":14099,"_26939":48462,"_2865":48636},[],"`--https-port`",{"_3379":156,"_29619":91,"_20556":48638,"_5":14099,"_26939":48462,"_2865":48639},[],"`443`",{"_3379":157,"_29619":91,"_20556":48641,"_5":14099,"_26939":48462,"_2865":48642},[],"Gateway HTTPS listener port",{"_3379":158,"_29619":91,"_20556":48644,"_5":14099,"_26939":48462,"_2865":48645},[],"`--http-port`",{"_3379":159,"_29619":91,"_20556":48647,"_5":14099,"_26939":48462,"_2865":48648},[],"`80`",{"_3379":160,"_29619":91,"_20556":48650,"_5":14099,"_26939":48462,"_2865":48651},[],"Gateway HTTP listener port",{"_3379":161,"_29619":91,"_20556":48653,"_5":14099,"_26939":48462,"_2865":48654},[],"`--tls-crt`",{"_3379":162,"_29619":91,"_20556":48656,"_5":14099,"_26939":48462,"_2865":48587},[],{"_3379":163,"_29619":91,"_20556":48658,"_5":14099,"_26939":48462,"_2865":48659},[],"PEM certificate for downstream TLS",{"_3379":164,"_29619":91,"_20556":48661,"_5":14099,"_26939":48462,"_2865":48662},[],"`--tls-key`",{"_3379":165,"_29619":91,"_20556":48664,"_5":14099,"_26939":48462,"_2865":48587},[],{"_3379":166,"_29619":91,"_20556":48666,"_5":14099,"_26939":48462,"_2865":48667},[],"PEM private key for downstream TLS",{"_3379":167,"_29619":91,"_20556":48669,"_5":14099,"_26939":48462,"_2865":48670},[],"`-l`, `--local-chart-path`",{"_3379":168,"_29619":91,"_20556":48672,"_5":14099,"_26939":48462,"_2865":48673},[],"repository chart",{"_3379":169,"_29619":91,"_20556":48675,"_5":14099,"_26939":48462,"_2865":48676},[],"Use an unpacked local Lamassu chart",{"_3379":170,"_29619":91,"_20556":48678,"_5":14099,"_26939":48462,"_2865":48679},[],"`-ip`, `--gateway-ip`",{"_3379":171,"_29619":91,"_20556":48681,"_5":14099,"_26939":48462,"_2865":8562},[],{"_3379":172,"_29619":91,"_20556":48683,"_5":14099,"_26939":48462,"_2865":48684},[],"Override the address written to `gateway.addresses`",{"_3379":173,"_29619":91,"_20556":48686,"_5":14099,"_26939":48462,"_2865":48687},[],"`--otel`",{"_3379":174,"_29619":91,"_20556":48689,"_5":14099,"_26939":48462,"_2865":6393},[],{"_3379":175,"_29619":91,"_20556":48691,"_5":14099,"_26939":48462,"_2865":48692},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3379":176,"_29619":91,"_20556":48694,"_5":14099,"_26939":48462,"_2865":48695},[],"`--development`",{"_3379":177,"_29619":91,"_20556":48697,"_5":14099,"_26939":48462,"_2865":6393},[],{"_3379":178,"_29619":91,"_20556":48699,"_5":14099,"_26939":48462,"_2865":48700},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3379":179,"_29619":91,"_20556":48702,"_5":14099,"_26939":48462,"_2865":48703},[],"`--sample-data`",{"_3379":180,"_29619":91,"_20556":48705,"_5":14099,"_26939":48462,"_2865":6393},[],{"_3379":181,"_29619":91,"_20556":48707,"_5":14099,"_26939":48462,"_2865":48708},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3379":182,"_29619":91,"_20556":48710,"_5":14099,"_26939":48462,"_2865":48711},[],"`--with-hsm`",{"_3379":183,"_29619":91,"_20556":48713,"_5":14099,"_26939":48462,"_2865":6393},[],{"_3379":184,"_29619":91,"_20556":48715,"_5":14099,"_26939":48462,"_2865":48716},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3379":185,"_29619":91,"_20556":48718,"_5":14099,"_26939":48462,"_2865":48719},[],"`--softhsm-chart-path`",{"_3379":186,"_29619":91,"_20556":48721,"_5":14099,"_26939":48462,"_2865":48722},[],"`./charts/softhsm`",{"_3379":187,"_29619":91,"_20556":48724,"_5":14099,"_26939":48462,"_2865":48725},[],"Use a different local SoftHSM chart",{"_3379":188,"_29619":91,"_20556":48727,"_5":14099,"_26939":48462,"_2865":48728},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3379":189,"_29619":91,"_20556":48730,"_5":14099,"_26939":48466,"_2865":48731},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3379":190,"_29619":91,"_20556":48733,"_5":14099,"_26939":48466,"_2865":48734},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3379":191,"_29619":91,"_20556":48736,"_5":14099,"_26939":48466,"_2865":48737},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3379":192,"_29619":91,"_20556":48739,"_5":14099,"_26939":48466,"_2865":48740},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3379":193,"_29619":91,"_20556":48742,"_5":14099,"_26939":48466,"_2865":48743},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3379":194,"_29619":91,"_20556":48745,"_5":14099,"_26939":48466,"_2865":48746},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3379":195,"_29619":91,"_20556":48748,"_5":14099,"_26939":48470,"_2865":48749},[],"Fastlane:",{"_3379":196,"_29619":91,"_20556":48751,"_5":14099,"_26939":48470,"_2865":48752},[],"validates local tools and the selected cluster",{"_3379":197,"_29619":91,"_20556":48754,"_5":14099,"_26939":48470,"_2865":48755},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3379":198,"_29619":91,"_20556":48757,"_5":14099,"_26939":48470,"_2865":48758},[],"creates the namespace",{"_3379":199,"_29619":91,"_20556":48760,"_5":14099,"_26939":48470,"_2865":48761},[],"installs PostgreSQL and creates the required databases",{"_3379":200,"_29619":91,"_20556":48763,"_5":14099,"_26939":48470,"_2865":48764},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3379":201,"_29619":91,"_20556":48766,"_5":14099,"_26939":48470,"_2865":48767},[],"installs RabbitMQ",{"_3379":202,"_29619":91,"_20556":48769,"_5":14099,"_26939":48470,"_2865":48770},[],"optionally installs observability and lab HSM components",{"_3379":203,"_29619":91,"_20556":48772,"_5":14099,"_26939":48470,"_2865":48773},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3379":204,"_29619":91,"_20556":48775,"_5":14099,"_26939":48470,"_2865":48776},[],"optionally loads sample data",{"_3379":205,"_29619":91,"_20556":48778,"_5":14099,"_26939":48470,"_2865":48779},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3379":206,"_29619":91,"_20556":48781,"_5":14099,"_26939":48474,"_2865":48782},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3379":207,"_29619":91,"_20556":48784,"_5":14099,"_26939":48474,"_2865":48785},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3379":208,"_29619":91,"_20556":48787,"_5":14099,"_26939":48478,"_2865":48788},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3379":209,"_29619":91,"_20556":48790,"_5":14099,"_26939":48478,"_2865":48791},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3379":210,"_29619":91,"_20556":48793,"_5":14099,"_26939":48478,"_2865":48794},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3379":211,"_29619":91,"_20556":48796,"_5":14099,"_26939":48482,"_2865":48797},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3379":212,"_29619":212,"_5":14457,"_2865":48799,"_29951":48800,"_20556":48801,"_26939":212},"Install with Helm",[48191,48192,48298],[],{"_3379":213,"_29619":212,"_20556":48803,"_5":14099,"_26939":212,"_2865":48804},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3379":214,"_29619":212,"_5":29948,"_20556":48806,"_26939":48807,"_2865":48808},[],"/docs/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3379":215,"_29619":212,"_5":29948,"_20556":48810,"_26939":48811,"_2865":48201},[],"/docs/deployment/self-hosted/helm#before-you-begin",{"_3379":216,"_29619":212,"_5":29948,"_20556":48813,"_26939":48814,"_2865":48815},[],"/docs/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3379":217,"_29619":212,"_5":29948,"_20556":48817,"_26939":48818,"_2865":48819},[],"/docs/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3379":218,"_29619":212,"_5":29948,"_20556":48821,"_26939":48822,"_2865":48823},[],"/docs/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3379":219,"_29619":212,"_5":29948,"_20556":48825,"_26939":48826,"_2865":48827},[],"/docs/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3379":220,"_29619":212,"_5":29948,"_20556":48829,"_26939":48830,"_2865":48831},[],"/docs/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3379":221,"_29619":212,"_5":29948,"_20556":48833,"_26939":48834,"_2865":48835},[],"/docs/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3379":222,"_29619":212,"_5":29948,"_20556":48837,"_26939":48838,"_2865":48839},[],"/docs/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3379":223,"_29619":212,"_5":29948,"_20556":48841,"_26939":48842,"_2865":48843},[],"/docs/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3379":224,"_29619":212,"_5":29948,"_20556":48845,"_26939":48846,"_2865":48847},[],"/docs/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3379":225,"_29619":212,"_20556":48849,"_5":14099,"_26939":48807,"_2865":48850},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3379":226,"_29619":212,"_20556":48852,"_5":14099,"_26939":48811,"_2865":48853},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3379":227,"_29619":212,"_20556":48855,"_5":14099,"_26939":48811,"_2865":48856},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3379":228,"_29619":212,"_20556":48858,"_5":14099,"_26939":48811,"_2865":48859},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3379":229,"_29619":212,"_20556":48861,"_5":14099,"_26939":48811,"_2865":48862},[],"a reachable RabbitMQ broker and credentials",{"_3379":230,"_29619":212,"_20556":48864,"_5":14099,"_26939":48811,"_2865":48865},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3379":231,"_29619":212,"_20556":48867,"_5":14099,"_26939":48811,"_2865":48868},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3379":232,"_29619":212,"_20556":48870,"_5":14099,"_26939":48811,"_2865":48871},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3379":233,"_29619":212,"_20556":48873,"_5":14099,"_26939":48811,"_2865":48874},[],"a StorageClass and an external traffic design",{"_3379":234,"_29619":212,"_20556":48876,"_5":14099,"_26939":48811,"_2865":48877},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3379":235,"_29619":212,"_20556":48879,"_5":14099,"_26939":48811,"_2865":48880},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3379":236,"_29619":212,"_20556":48882,"_5":14099,"_26939":48811,"_2865":48883},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3379":237,"_29619":212,"_20556":48885,"_5":14099,"_26939":48814,"_2865":48886},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3379":238,"_29619":212,"_20556":48888,"_5":14099,"_26939":48814,"_2865":48889},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3379":239,"_29619":212,"_20556":48891,"_5":14099,"_26939":48814,"_2865":48892},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3379":240,"_29619":212,"_20556":48894,"_5":14099,"_26939":48818,"_2865":48895},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3379":241,"_29619":212,"_20556":48897,"_5":14099,"_26939":48818,"_2865":48898},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3379":242,"_29619":212,"_20556":48900,"_5":14099,"_26939":48818,"_2865":48901},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3379":243,"_29619":212,"_20556":48903,"_5":14099,"_26939":48818,"_2865":48904},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3379":244,"_29619":212,"_20556":48906,"_5":14099,"_26939":48822,"_2865":48907},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3379":245,"_29619":212,"_20556":48909,"_5":14099,"_26939":48826,"_2865":48910},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3379":246,"_29619":212,"_20556":48912,"_5":14099,"_26939":48826,"_2865":48913},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3379":247,"_29619":212,"_20556":48915,"_5":14099,"_26939":48826,"_2865":48916},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3379":248,"_29619":212,"_20556":48918,"_5":14099,"_26939":48826,"_2865":48919},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3379":249,"_29619":212,"_20556":48921,"_5":14099,"_26939":48826,"_2865":48922},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3379":250,"_29619":212,"_20556":48924,"_5":14099,"_26939":48826,"_2865":48925},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3379":251,"_29619":212,"_20556":48927,"_5":14099,"_26939":48826,"_2865":48928},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3379":252,"_29619":212,"_20556":48930,"_5":14099,"_26939":48830,"_2865":48931},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3379":253,"_29619":212,"_20556":48933,"_5":14099,"_26939":48830,"_2865":48934},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3379":254,"_29619":212,"_20556":48936,"_5":14099,"_26939":48830,"_2865":48937},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3379":255,"_29619":212,"_20556":48939,"_5":14099,"_26939":48830,"_2865":48940},[],"See Access control for the principal and policy model.",{"_3379":256,"_29619":212,"_20556":48942,"_5":14099,"_26939":48834,"_2865":48943},[],"To install a local checkout instead:",{"_3379":257,"_29619":212,"_20556":48945,"_5":14099,"_26939":48838,"_2865":48946},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3379":258,"_29619":212,"_20556":48948,"_5":14099,"_26939":48838,"_2865":48949},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3379":259,"_29619":212,"_20556":48951,"_5":14099,"_26939":48842,"_2865":48952},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3379":260,"_29619":212,"_20556":48954,"_5":14099,"_26939":48842,"_2865":48955},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3379":261,"_29619":212,"_20556":48957,"_5":14099,"_26939":48842,"_2865":48958},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3379":262,"_29619":212,"_20556":48960,"_5":14099,"_26939":48842,"_2865":48961},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3379":263,"_29619":212,"_20556":48963,"_5":14099,"_26939":48842,"_2865":48964},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3379":264,"_29619":212,"_20556":48966,"_5":14099,"_26939":48846,"_2865":48967},[],"Before going live, review:",{"_3379":265,"_29619":212,"_20556":48969,"_5":14099,"_26939":48846,"_2865":48970},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3379":266,"_29619":212,"_20556":48972,"_5":14099,"_26939":48846,"_2865":48973},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3379":267,"_29619":212,"_20556":48975,"_5":14099,"_26939":48846,"_2865":48976},[],"shared VA storage before increasing VA replicas",{"_3379":268,"_29619":212,"_20556":48978,"_5":14099,"_26939":48846,"_2865":48979},[],"managed OIDC roles and removal of evaluation credentials",{"_3379":269,"_29619":212,"_20556":48981,"_5":14099,"_26939":48846,"_2865":48982},[],"a trusted TLS issuer or externally managed certificate",{"_3379":270,"_29619":212,"_20556":48984,"_5":14099,"_26939":48846,"_2865":48985},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3379":271,"_29619":212,"_20556":48987,"_5":14099,"_26939":48846,"_2865":48988},[],"SMTP, observability and alert delivery",{"_3379":272,"_29619":212,"_20556":48990,"_5":14099,"_26939":48846,"_2865":48991},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3379":273,"_29619":212,"_20556":48993,"_5":14099,"_26939":48846,"_2865":48994},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3379":274,"_29619":274,"_5":14457,"_2865":48996,"_29951":48997,"_20556":48998,"_26939":274},"Expose the Gateway",[48191,48192,48298],[],{"_3379":275,"_29619":274,"_20556":49000,"_5":14099,"_26939":274,"_2865":49001},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3379":276,"_29619":274,"_5":29948,"_20556":49003,"_26939":49004,"_2865":49005},[],"/docs/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3379":277,"_29619":274,"_5":29948,"_20556":49007,"_26939":49008,"_2865":49009},[],"/docs/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3379":278,"_29619":274,"_5":29948,"_20556":49011,"_26939":49012,"_2865":49013},[],"/docs/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3379":279,"_29619":274,"_5":29948,"_20556":49015,"_26939":49016,"_2865":49017},[],"/docs/deployment/self-hosted/networking#k3s","K3s",{"_3379":280,"_29619":274,"_5":29948,"_20556":49019,"_26939":49020,"_2865":49021},[],"/docs/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3379":281,"_29619":274,"_5":29948,"_20556":49023,"_26939":49024,"_2865":49025},[],"/docs/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3379":282,"_29619":274,"_5":29948,"_20556":49027,"_26939":49028,"_2865":49029},[],"/docs/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3379":283,"_29619":274,"_5":29948,"_20556":49031,"_26939":49032,"_2865":49033},[],"/docs/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3379":284,"_29619":274,"_5":29948,"_20556":49035,"_26939":49036,"_2865":49037},[],"/docs/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3379":285,"_29619":274,"_5":29948,"_20556":49039,"_26939":49040,"_2865":49041},[],"/docs/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3379":286,"_29619":274,"_20556":49043,"_5":14099,"_26939":49004,"_2865":49044},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3379":287,"_29619":274,"_20556":49046,"_5":14099,"_26939":49004,"_2865":49047},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3379":288,"_29619":274,"_20556":49049,"_5":14099,"_26939":49008,"_2865":49050},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3379":289,"_29619":274,"_20556":49052,"_5":14099,"_26939":49008,"_2865":49053},[],"Set it only when:",{"_3379":290,"_29619":274,"_20556":49055,"_5":14099,"_26939":49008,"_2865":49056},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3379":291,"_29619":274,"_20556":49058,"_5":14099,"_26939":49008,"_2865":49059},[],"that address is allocated to this Gateway",{"_3379":292,"_29619":274,"_20556":49061,"_5":14099,"_26939":49008,"_2865":49062},[],"the surrounding network already routes traffic for it to the cluster",{"_3379":293,"_29619":274,"_20556":49064,"_5":14099,"_26939":49008,"_2865":49065},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3379":294,"_29619":274,"_20556":49067,"_5":14099,"_26939":49008,"_2865":49068},[],"Keep these two settings separate:",{"_3379":295,"_29619":274,"_20556":49070,"_5":14099,"_26939":49008,"_2865":49071},[],"`gateway.addresses` requests an address for the Gateway.",{"_3379":296,"_29619":274,"_20556":49073,"_5":14099,"_26939":49008,"_2865":49074},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3379":297,"_29619":274,"_20556":49076,"_5":14099,"_26939":49008,"_2865":49077},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3379":298,"_29619":274,"_20556":49079,"_5":14099,"_26939":49012,"_2865":49080},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3379":299,"_29619":274,"_20556":49082,"_5":14099,"_26939":49012,"_2865":49083},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3379":300,"_29619":274,"_20556":49085,"_5":14099,"_26939":49016,"_2865":49086},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3379":301,"_29619":274,"_20556":49088,"_5":14099,"_26939":49016,"_2865":49089},[],"For the recommended design:",{"_3379":302,"_29619":274,"_20556":49091,"_5":14099,"_26939":49016,"_2865":49092},[],"Use only one externally exposed Lamassu Gateway.",{"_3379":303,"_29619":274,"_20556":49094,"_5":14099,"_26939":49016,"_2865":49095},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3379":304,"_29619":274,"_20556":49097,"_5":14099,"_26939":49016,"_2865":49098},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3379":305,"_29619":274,"_20556":49100,"_5":14099,"_26939":49016,"_2865":49101},[],"Point DNS at the VM's reachable address.",{"_3379":306,"_29619":274,"_20556":49103,"_5":14099,"_26939":49016,"_2865":49104},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3379":307,"_29619":274,"_20556":49106,"_5":14099,"_26939":49020,"_2865":49107},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3379":308,"_29619":274,"_20556":49109,"_5":14099,"_26939":49024,"_2865":49110},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3379":309,"_29619":274,"_20556":49112,"_5":14099,"_26939":49024,"_2865":49113},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3379":310,"_29619":274,"_20556":49115,"_5":14099,"_26939":49028,"_2865":49116},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3379":311,"_29619":274,"_20556":49118,"_5":14099,"_26939":49028,"_2865":49119},[],"Requirement",{"_3379":312,"_29619":274,"_20556":49121,"_5":14099,"_26939":49028,"_2865":49122},[],"Recommended design",{"_3379":313,"_29619":274,"_20556":49124,"_5":14099,"_26939":49028,"_2865":49125},[],"Consequence",{"_3379":314,"_29619":274,"_20556":49127,"_5":14099,"_26939":49028,"_2865":49128},[],"Several Lamassu URLs or services",{"_3379":315,"_29619":274,"_20556":49130,"_5":14099,"_26939":49028,"_2865":49131},[],"One Gateway with multiple routes",{"_3379":316,"_29619":274,"_20556":49133,"_5":14099,"_26939":49028,"_2865":49134},[],"One IP and one proxy fleet; this is the chart default",{"_3379":317,"_29619":274,"_20556":49136,"_5":14099,"_26939":49028,"_2865":49137},[],"Independent Gateways and separate external IPs",{"_3379":318,"_29619":274,"_20556":49139,"_5":14099,"_26939":49028,"_2865":49140},[],"One VIP per Gateway",{"_3379":319,"_29619":274,"_20556":49142,"_5":14099,"_26939":49028,"_2865":49143},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3379":320,"_29619":274,"_20556":49145,"_5":14099,"_26939":49028,"_2865":49146},[],"Independent Gateways on one node and one IP",{"_3379":321,"_29619":274,"_20556":49148,"_5":14099,"_26939":49028,"_2865":49149},[],"Use different external ports",{"_3379":322,"_29619":274,"_20556":49151,"_5":14099,"_26939":49028,"_2865":49152},[],"Clients must include non-standard ports",{"_3379":323,"_29619":274,"_20556":49154,"_5":14099,"_26939":49028,"_2865":49155},[],"Separate TLS/mTLS termination behind one IP",{"_3379":324,"_29619":274,"_20556":49157,"_5":14099,"_26939":49028,"_2865":49158},[],"Front-door SNI routing to internal Gateways",{"_3379":325,"_29619":274,"_20556":49160,"_5":14099,"_26939":49028,"_2865":49161},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3379":326,"_29619":274,"_20556":49163,"_5":14099,"_26939":49028,"_2865":49164},[],"Separate Gateway resources but shared proxy infrastructure",{"_3379":327,"_29619":274,"_20556":49166,"_5":14099,"_26939":49028,"_2865":49167},[],"Envoy merged-Gateway mode",{"_3379":328,"_29619":274,"_20556":49169,"_5":14099,"_26939":49028,"_2865":49170},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3379":329,"_29619":274,"_20556":49172,"_5":14099,"_26939":49028,"_2865":49173},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3379":330,"_29619":274,"_20556":49175,"_5":14099,"_26939":49028,"_2865":49176},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3379":331,"_29619":274,"_20556":49178,"_5":14099,"_26939":49028,"_2865":49179},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3379":332,"_29619":274,"_20556":49181,"_5":14099,"_26939":49028,"_2865":49182},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3379":333,"_29619":274,"_20556":49184,"_5":14099,"_26939":49032,"_2865":49185},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3379":334,"_29619":274,"_20556":49187,"_5":14099,"_26939":49032,"_2865":49188},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3379":335,"_29619":274,"_20556":49190,"_5":14099,"_26939":49032,"_2865":49191},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3379":336,"_29619":274,"_20556":49193,"_5":14099,"_26939":49032,"_2865":49194},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3379":337,"_29619":274,"_20556":49196,"_5":14099,"_26939":49032,"_2865":49197},[],"If none of those are possible, use different external ports or change the external network design.",{"_3379":338,"_29619":274,"_20556":49199,"_5":14099,"_26939":49036,"_2865":49200},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3379":339,"_29619":274,"_20556":49202,"_5":14099,"_26939":49036,"_2865":49203},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3379":340,"_29619":274,"_20556":49205,"_5":14099,"_26939":49040,"_2865":49206},[],"Check, in order:",{"_3379":341,"_29619":274,"_20556":49208,"_5":14099,"_26939":49040,"_2865":49209},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3379":342,"_29619":274,"_20556":49211,"_5":14099,"_26939":49040,"_2865":49212},[],"Its status contains the expected address.",{"_3379":343,"_29619":274,"_20556":49214,"_5":14099,"_26939":49040,"_2865":49215},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3379":344,"_29619":274,"_20556":49217,"_5":14099,"_26939":49040,"_2865":49218},[],"Port 443 reaches that address from the client network.",{"_3379":345,"_29619":274,"_20556":49220,"_5":14099,"_26939":49040,"_2865":49221},[],"DNS resolves to the externally reachable endpoint.",{"_3379":346,"_29619":274,"_20556":49223,"_5":14099,"_26939":49040,"_2865":49224},[],"The certificate contains the DNS name or IP used by the client.",{"_3379":347,"_29619":274,"_20556":49226,"_5":14099,"_26939":49040,"_2865":49227},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3379":348,"_29619":348,"_5":14457,"_2865":48298,"_29951":49229,"_20556":49230,"_26939":348},[48191,48192,48298],[],{"_3379":349,"_29619":348,"_20556":49232,"_5":14099,"_26939":348,"_2865":49233},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3379":350,"_29619":348,"_5":29948,"_20556":49235,"_26939":49236,"_2865":49237},[],"/docs/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3379":351,"_29619":348,"_5":29948,"_20556":49239,"_26939":49240,"_2865":49241},[],"/docs/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3379":352,"_29619":348,"_5":29948,"_20556":49243,"_26939":49244,"_2865":49245},[],"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3379":353,"_29619":348,"_5":29948,"_20556":49247,"_26939":49248,"_2865":49249},[],"/docs/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3379":354,"_29619":348,"_5":29948,"_20556":49251,"_26939":49252,"_2865":49253},[],"/docs/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3379":355,"_29619":348,"_5":29948,"_20556":49255,"_26939":49256,"_2865":49257},[],"/docs/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3379":356,"_29619":348,"_20556":49259,"_5":14099,"_26939":49236,"_2865":49260},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3379":357,"_29619":348,"_20556":49262,"_5":14099,"_26939":49240,"_2865":49263},[],"Workflow",{"_3379":358,"_29619":348,"_20556":49265,"_5":14099,"_26939":49240,"_2865":49266},[],"Use it for",{"_3379":359,"_29619":348,"_20556":49268,"_5":14099,"_26939":49240,"_2865":49269},[],"What it installs",{"_3379":360,"_29619":348,"_20556":49271,"_5":14099,"_26939":49240,"_2865":49272},[],"Helm",{"_3379":361,"_29619":348,"_20556":49274,"_5":14099,"_26939":49240,"_2865":49275},[],"Production and controlled environments",{"_3379":362,"_29619":348,"_20556":49277,"_5":14099,"_26939":49240,"_2865":49278},[],"Lamassu services and Gateway API resources",{"_3379":363,"_29619":348,"_20556":49280,"_5":14099,"_26939":49240,"_2865":48435},[],{"_3379":364,"_29619":348,"_20556":49282,"_5":14099,"_26939":49240,"_2865":49283},[],"Evaluation, demos, CI and small lab clusters",{"_3379":365,"_29619":348,"_20556":49285,"_5":14099,"_26939":49240,"_2865":49286},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3379":366,"_29619":348,"_20556":49288,"_5":14099,"_26939":49244,"_2865":49289},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3379":367,"_29619":348,"_20556":49291,"_5":14099,"_26939":49244,"_2865":49292},[],"Area",{"_3379":368,"_29619":348,"_20556":49294,"_5":14099,"_26939":49244,"_2865":49295},[],"The Lamassu chart provides",{"_3379":369,"_29619":348,"_20556":49297,"_5":14099,"_26939":49244,"_2865":49298},[],"You provide",{"_3379":370,"_29619":348,"_20556":49300,"_5":14099,"_26939":49244,"_2865":49301},[],"Lamassu applications",{"_3379":371,"_29619":348,"_20556":49303,"_5":14099,"_26939":49244,"_2865":49304},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3379":372,"_29619":348,"_20556":49306,"_5":14099,"_26939":49244,"_2865":49307},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3379":373,"_29619":348,"_20556":49309,"_5":14099,"_26939":49244,"_2865":49310},[],"PostgreSQL data",{"_3379":374,"_29619":348,"_20556":49312,"_5":14099,"_26939":49244,"_2865":49313},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3379":375,"_29619":348,"_20556":49315,"_5":14099,"_26939":49244,"_2865":49316},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3379":376,"_29619":348,"_20556":49318,"_5":14099,"_26939":49244,"_2865":49319},[],"Messaging",{"_3379":377,"_29619":348,"_20556":49321,"_5":14099,"_26939":49244,"_2865":49322},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3379":378,"_29619":348,"_20556":49324,"_5":14099,"_26939":49244,"_2865":49325},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3379":379,"_29619":348,"_20556":49327,"_5":14099,"_26939":49244,"_2865":49328},[],"Identity",{"_3379":380,"_29619":348,"_20556":49330,"_5":14099,"_26939":49244,"_2865":49331},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3379":381,"_29619":348,"_20556":49333,"_5":14099,"_26939":49244,"_2865":49334},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3379":382,"_29619":348,"_20556":49336,"_5":14099,"_26939":49244,"_2865":49337},[],"External routing",{"_3379":383,"_29619":348,"_20556":49339,"_5":14099,"_26939":49244,"_2865":49340},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3379":384,"_29619":348,"_20556":49342,"_5":14099,"_26939":49244,"_2865":49343},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3379":385,"_29619":348,"_20556":49345,"_5":14099,"_26939":49244,"_2865":49346},[],"TLS",{"_3379":386,"_29619":348,"_20556":49348,"_5":14099,"_26939":49244,"_2865":49349},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3379":387,"_29619":348,"_20556":49351,"_5":14099,"_26939":49244,"_2865":49352},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3379":388,"_29619":348,"_20556":49354,"_5":14099,"_26939":49244,"_2865":49355},[],"Persistent application data",{"_3379":389,"_29619":348,"_20556":49357,"_5":14099,"_26939":49244,"_2865":49358},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3379":390,"_29619":348,"_20556":49360,"_5":14099,"_26939":49244,"_2865":49361},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3379":391,"_29619":348,"_20556":49363,"_5":14099,"_26939":49244,"_2865":49364},[],"Optional integrations",{"_3379":392,"_29619":348,"_20556":49366,"_5":14099,"_26939":49244,"_2865":49367},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3379":393,"_29619":348,"_20556":49369,"_5":14099,"_26939":49244,"_2865":49370},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3379":394,"_29619":348,"_20556":49372,"_5":14099,"_26939":49244,"_2865":49373},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3379":395,"_29619":348,"_20556":49375,"_5":14099,"_26939":49244,"_2865":49376},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3379":396,"_29619":348,"_20556":49378,"_5":14099,"_26939":49248,"_2865":49379},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3379":397,"_29619":348,"_20556":49381,"_5":14099,"_26939":49248,"_2865":49382},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3379":398,"_29619":348,"_20556":49384,"_5":14099,"_26939":49252,"_2865":49385},[],"Kubernetes 1.24 or newer",{"_3379":399,"_29619":348,"_20556":49387,"_5":14099,"_26939":49252,"_2865":49388},[],"Helm 3.2 or newer",{"_3379":400,"_29619":348,"_20556":49390,"_5":14099,"_26939":49252,"_2865":49391},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3379":401,"_29619":348,"_20556":49393,"_5":14099,"_26939":49252,"_2865":49394},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3379":402,"_29619":348,"_20556":49396,"_5":14099,"_26939":49252,"_2865":49397},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3379":403,"_29619":348,"_20556":49399,"_5":14099,"_26939":49252,"_2865":49400},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3379":404,"_29619":348,"_20556":49402,"_5":14099,"_26939":49252,"_2865":49403},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3379":405,"_29619":348,"_20556":49405,"_5":14099,"_26939":49256,"_2865":49406},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3379":406,"_29619":348,"_20556":49408,"_5":14099,"_26939":49256,"_2865":49409},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3379":407,"_29619":348,"_20556":49411,"_5":14099,"_26939":49256,"_2865":49412},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3379":408,"_29619":348,"_20556":49414,"_5":14099,"_26939":49256,"_2865":49415},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3379":409,"_29619":409,"_5":14457,"_2865":49417,"_29951":49418,"_20556":49420,"_26939":409},"Deployment troubleshooting",[48191,48192,49419],"Operations",[],{"_3379":410,"_29619":409,"_20556":49422,"_5":14099,"_26939":409,"_2865":49423},[],"Diagnose access, service health and infrastructure dependencies.",{"_3379":411,"_29619":409,"_5":29948,"_20556":49425,"_26939":49426,"_2865":49427},[],"/docs/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3379":412,"_29619":409,"_5":29948,"_20556":49429,"_26939":49430,"_2865":49431},[],"/docs/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3379":413,"_29619":409,"_5":29948,"_20556":49433,"_26939":49434,"_2865":49435},[],"/docs/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3379":414,"_29619":409,"_5":29948,"_20556":49437,"_26939":49438,"_2865":49439},[],"/docs/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3379":415,"_29619":409,"_5":29948,"_20556":49441,"_26939":49442,"_2865":49443},[],"/docs/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3379":416,"_29619":409,"_5":29948,"_20556":49445,"_26939":49446,"_2865":49447},[],"/docs/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3379":417,"_29619":409,"_5":29948,"_20556":49449,"_26939":49450,"_2865":49451},[],"/docs/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3379":418,"_29619":409,"_5":29948,"_20556":49453,"_26939":49454,"_2865":49455},[],"/docs/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3379":419,"_29619":409,"_5":29948,"_20556":49457,"_26939":49458,"_2865":49459},[],"/docs/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3379":420,"_29619":409,"_5":29948,"_20556":49461,"_26939":49462,"_2865":49463},[],"/docs/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3379":421,"_29619":409,"_5":29948,"_20556":49465,"_26939":49466,"_2865":49467},[],"/docs/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3379":422,"_29619":409,"_5":29948,"_20556":49469,"_26939":49470,"_2865":49471},[],"/docs/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3379":423,"_29619":409,"_5":29948,"_20556":49473,"_26939":49474,"_2865":49475},[],"/docs/deployment/troubleshooting#observability","Observability",{"_3379":424,"_29619":409,"_20556":49477,"_5":14099,"_26939":409,"_2865":49478},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3379":425,"_29619":409,"_20556":49480,"_5":14099,"_26939":49430,"_2865":49481},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3379":426,"_29619":409,"_20556":49483,"_5":14099,"_26939":49434,"_2865":49484},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3379":427,"_29619":409,"_20556":49486,"_5":14099,"_26939":49438,"_2865":49487},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3379":428,"_29619":409,"_20556":49489,"_5":14099,"_26939":49442,"_2865":49490},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3379":429,"_29619":409,"_20556":49492,"_5":14099,"_26939":49446,"_2865":49493},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3379":430,"_29619":409,"_20556":49495,"_5":14099,"_26939":49450,"_2865":49496},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3379":431,"_29619":409,"_20556":49498,"_5":14099,"_26939":49450,"_2865":49499},[],"Also run the chart's connectivity test:",{"_3379":432,"_29619":409,"_20556":49501,"_5":14099,"_26939":49450,"_2865":49502},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3379":433,"_29619":409,"_20556":49504,"_5":14099,"_26939":49450,"_2865":49505},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3379":434,"_29619":409,"_20556":49507,"_5":14099,"_26939":49454,"_2865":49508},[],"If you receive a 401:",{"_3379":435,"_29619":409,"_20556":49510,"_5":14099,"_26939":49454,"_2865":49511},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3379":436,"_29619":409,"_20556":49513,"_5":14099,"_26939":49454,"_2865":49514},[],"verify issuer, audience and expiration of the token;",{"_3379":437,"_29619":409,"_20556":49516,"_5":14099,"_26939":49454,"_2865":49517},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3379":438,"_29619":409,"_20556":49519,"_5":14099,"_26939":49454,"_2865":49520},[],"check that the provider's public and internal routes point to the same realm.",{"_3379":439,"_29619":409,"_20556":49522,"_5":14099,"_26939":49454,"_2865":49523},[],"If login succeeds but the APIs return 403:",{"_3379":440,"_29619":409,"_20556":49525,"_5":14099,"_26939":49454,"_2865":49526},[],"inspect the token's real claims;",{"_3379":441,"_29619":409,"_20556":49528,"_5":14099,"_26939":49454,"_2865":49529},[],"confirm they match an active principal;",{"_3379":442,"_29619":409,"_20556":49531,"_5":14099,"_26939":49454,"_2865":49532},[],"review the policies granted to that principal;",{"_3379":443,"_29619":409,"_20556":49534,"_5":14099,"_26939":49454,"_2865":49535},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3379":444,"_29619":409,"_20556":49537,"_5":14099,"_26939":49454,"_2865":49538},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3379":445,"_29619":409,"_20556":49540,"_5":14099,"_26939":49458,"_2865":49541},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3379":446,"_29619":409,"_20556":49543,"_5":14099,"_26939":49458,"_2865":49544},[],"Locate the authz pod and Service.",{"_3379":447,"_29619":409,"_20556":49546,"_5":14099,"_26939":49458,"_2865":49547},[],"Check /health, logs and its database connection.",{"_3379":448,"_29619":409,"_20556":49549,"_5":14099,"_26939":49458,"_2865":49550},[],"Verify the DNS and port configured in externalAuthorization.",{"_3379":449,"_29619":409,"_20556":49552,"_5":14099,"_26939":49458,"_2865":49553},[],"Check the check route is /v1/ext\\_authz/check.",{"_3379":450,"_29619":409,"_20556":49555,"_5":14099,"_26939":49458,"_2865":49556},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3379":451,"_29619":409,"_20556":49558,"_5":14099,"_26939":49462,"_2865":49559},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3379":452,"_29619":409,"_20556":49561,"_5":14099,"_26939":49466,"_2865":49562},[],"Review kubectl describe pod first. Common causes are:",{"_3379":453,"_29619":409,"_20556":49564,"_5":14099,"_26939":49466,"_2865":49565},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3379":454,"_29619":409,"_20556":49567,"_5":14099,"_26939":49466,"_2865":49568},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3379":455,"_29619":409,"_20556":49570,"_5":14099,"_26939":49466,"_2865":49571},[],"unbound persistent volume;",{"_3379":456,"_29619":409,"_20556":49573,"_5":14099,"_26939":49466,"_2865":49574},[],"inaccessible image or incorrect pull policy;",{"_3379":457,"_29619":409,"_20556":49576,"_5":14099,"_26939":49466,"_2865":49577},[],"invalid cryptographic engine configuration;",{"_3379":458,"_29619":409,"_20556":49579,"_5":14099,"_26939":49466,"_2865":49580},[],"CPU or memory limits set too low;",{"_3379":459,"_29619":409,"_20556":49582,"_5":14099,"_26939":49466,"_2865":49583},[],"an incomplete prior migration.",{"_3379":460,"_29619":409,"_20556":49585,"_5":14099,"_26939":49466,"_2865":49586},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3379":461,"_29619":409,"_20556":49588,"_5":14099,"_26939":49466,"_2865":49589},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3379":462,"_29619":409,"_20556":49591,"_5":14099,"_26939":49466,"_2865":49592},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3379":463,"_29619":409,"_20556":49594,"_5":14099,"_26939":49470,"_2865":49595},[],"Domain and audit events depend on the bus publisher:",{"_3379":464,"_29619":409,"_20556":49597,"_5":14099,"_26939":49470,"_2865":49598},[],"verify it is enabled in the emitting service;",{"_3379":465,"_29619":409,"_20556":49600,"_5":14099,"_26939":49470,"_2865":49601},[],"check AMQP connectivity and credentials;",{"_3379":466,"_29619":409,"_20556":49603,"_5":14099,"_26939":49470,"_2865":49604},[],"review exchange, routing key, queues and consumers;",{"_3379":467,"_29619":409,"_20556":49606,"_5":14099,"_26939":49470,"_2865":49607},[],"inspect dead-letter queues;",{"_3379":468,"_29619":409,"_20556":49609,"_5":14099,"_26939":49470,"_2865":49610},[],"alert on orphan durable queues and backlog growth.",{"_3379":469,"_29619":409,"_20556":49612,"_5":14099,"_26939":49470,"_2865":49613},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3379":470,"_29619":409,"_20556":49615,"_5":14099,"_26939":49470,"_2865":49616},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3379":471,"_29619":409,"_20556":49618,"_5":14099,"_26939":49470,"_2865":49619},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3379":472,"_29619":409,"_20556":49621,"_5":14099,"_26939":49470,"_2865":49622},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3379":473,"_29619":409,"_20556":49624,"_5":14099,"_26939":49470,"_2865":49625},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3379":474,"_29619":409,"_20556":49627,"_5":14099,"_26939":49470,"_2865":49628},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3379":475,"_29619":409,"_20556":49630,"_5":14099,"_26939":49470,"_2865":49631},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3379":476,"_29619":409,"_20556":49633,"_5":14099,"_26939":49474,"_2865":49634},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3379":477,"_29619":409,"_20556":49636,"_5":14099,"_26939":49474,"_2865":49637},[],"Before closing an incident, record:",{"_3379":478,"_29619":409,"_20556":49639,"_5":14099,"_26939":49474,"_2865":49640},[],"the confirmed cause;",{"_3379":479,"_29619":409,"_20556":49642,"_5":14099,"_26939":49474,"_2865":49643},[],"the time scope and affected resources;",{"_3379":480,"_29619":409,"_20556":49645,"_5":14099,"_26939":49474,"_2865":49646},[],"the commands or queries used;",{"_3379":481,"_29619":409,"_20556":49648,"_5":14099,"_26939":49474,"_2865":49649},[],"the applied change and how to revert it;",{"_3379":482,"_29619":409,"_20556":49651,"_5":14099,"_26939":49474,"_2865":49652},[],"validation from a consumer;",{"_3379":483,"_29619":409,"_20556":49654,"_5":14099,"_26939":49474,"_2865":49655},[],"the preventive action and its owner.",{"_3379":484,"_29619":484,"_5":14457,"_2865":49657,"_29951":49658,"_20556":49661,"_26939":484},"Access control",[48191,49659,49660],"Platform","Administration",[],{"_3379":485,"_29619":484,"_20556":49663,"_5":14099,"_26939":484,"_2865":49664},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3379":486,"_29619":484,"_5":29948,"_20556":49666,"_26939":49667,"_2865":49668},[],"/docs/platform/administration/access-control#essential-concepts","Essential concepts",{"_3379":487,"_29619":484,"_5":29948,"_20556":49670,"_26939":49671,"_2865":49672},[],"/docs/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3379":488,"_29619":484,"_5":29948,"_20556":49674,"_26939":49675,"_2865":49676},[],"/docs/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3379":489,"_29619":484,"_5":29948,"_20556":49678,"_26939":49679,"_2865":49680},[],"/docs/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3379":490,"_29619":484,"_5":29948,"_20556":49682,"_26939":49683,"_2865":49684},[],"/docs/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3379":491,"_29619":484,"_5":29948,"_20556":49686,"_26939":49687,"_2865":49688},[],"/docs/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3379":492,"_29619":484,"_5":29948,"_20556":49690,"_26939":49691,"_2865":49692},[],"/docs/platform/administration/access-control#oidc-principals","OIDC principals",{"_3379":493,"_29619":484,"_5":29948,"_20556":49694,"_26939":49695,"_2865":49696},[],"/docs/platform/administration/access-control#x509-principals","X.509 principals",{"_3379":494,"_29619":484,"_5":29948,"_20556":49698,"_26939":49699,"_2865":49700},[],"/docs/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3379":495,"_29619":484,"_5":29948,"_20556":49702,"_26939":49703,"_2865":49704},[],"/docs/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3379":496,"_29619":484,"_5":29948,"_20556":49706,"_26939":49707,"_2865":49708},[],"/docs/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3379":497,"_29619":484,"_5":29948,"_20556":49710,"_26939":49711,"_2865":49712},[],"/docs/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3379":498,"_29619":484,"_5":29948,"_20556":49714,"_26939":49715,"_2865":49716},[],"/docs/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3379":499,"_29619":484,"_5":29948,"_20556":49718,"_26939":49719,"_2865":49720},[],"/docs/platform/administration/access-control#http-rules","HTTP rules",{"_3379":500,"_29619":484,"_5":29948,"_20556":49722,"_26939":49723,"_2865":49724},[],"/docs/platform/administration/access-control#included-policies","Included policies",{"_3379":501,"_29619":484,"_5":29948,"_20556":49726,"_26939":49727,"_2865":48831},[],"/docs/platform/administration/access-control#provision-the-first-administrator",{"_3379":502,"_29619":484,"_5":29948,"_20556":49729,"_26939":49730,"_2865":49731},[],"/docs/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3379":503,"_29619":484,"_5":29948,"_20556":49733,"_26939":49734,"_2865":49735},[],"/docs/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3379":504,"_29619":484,"_5":29948,"_20556":49737,"_26939":49738,"_2865":49739},[],"/docs/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3379":505,"_29619":484,"_5":29948,"_20556":49741,"_26939":49742,"_2865":49743},[],"/docs/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3379":506,"_29619":484,"_5":29948,"_20556":49745,"_26939":49746,"_2865":49747},[],"/docs/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3379":507,"_29619":484,"_5":29948,"_20556":49749,"_26939":49750,"_2865":49751},[],"/docs/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3379":508,"_29619":484,"_5":29948,"_20556":49753,"_26939":49754,"_2865":49755},[],"/docs/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3379":509,"_29619":484,"_5":29948,"_20556":49757,"_26939":49758,"_2865":49759},[],"/docs/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3379":510,"_29619":484,"_5":29948,"_20556":49761,"_26939":49762,"_2865":49763},[],"/docs/platform/administration/access-control#operational-checklist","Operational checklist",{"_3379":511,"_29619":484,"_5":29948,"_20556":49765,"_26939":49766,"_2865":49767},[],"/docs/platform/administration/access-control#diagnostics","Diagnostics",{"_3379":512,"_29619":484,"_5":29948,"_20556":49769,"_26939":49770,"_2865":49771},[],"/docs/platform/administration/access-control#the-response-is-401","The response is 401",{"_3379":513,"_29619":484,"_5":29948,"_20556":49773,"_26939":49774,"_2865":49775},[],"/docs/platform/administration/access-control#the-response-is-403","The response is 403",{"_3379":514,"_29619":484,"_5":29948,"_20556":49777,"_26939":49778,"_2865":49779},[],"/docs/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3379":515,"_29619":484,"_5":29948,"_20556":49781,"_26939":49782,"_2865":49783},[],"/docs/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3379":516,"_29619":484,"_5":29948,"_20556":49785,"_26939":49786,"_2865":49787},[],"/docs/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3379":517,"_29619":484,"_20556":49789,"_5":14099,"_26939":484,"_2865":49790},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3379":518,"_29619":484,"_20556":49792,"_5":14099,"_26939":484,"_2865":49793},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3379":519,"_29619":484,"_20556":49795,"_5":14099,"_26939":484,"_2865":49796},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3379":520,"_29619":484,"_20556":49798,"_5":14099,"_26939":49667,"_2865":49799},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3379":521,"_29619":484,"_20556":49801,"_5":14099,"_26939":49667,"_2865":49802},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3379":522,"_29619":484,"_20556":49804,"_5":14099,"_26939":49667,"_2865":49805},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3379":523,"_29619":484,"_20556":49807,"_5":14099,"_26939":49667,"_2865":49808},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3379":524,"_29619":484,"_20556":49810,"_5":14099,"_26939":49667,"_2865":49811},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3379":525,"_29619":484,"_20556":49813,"_5":14099,"_26939":49667,"_2865":49814},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3379":526,"_29619":484,"_20556":49816,"_5":14099,"_26939":49671,"_2865":49817},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3379":527,"_29619":484,"_20556":49819,"_5":14099,"_26939":49671,"_2865":49820},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3379":528,"_29619":484,"_20556":49822,"_5":14099,"_26939":49675,"_2865":49823},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3379":529,"_29619":484,"_20556":49825,"_5":14099,"_26939":49675,"_2865":49826},[],"The decision is made **before forwarding the request to the service**:",{"_3379":530,"_29619":484,"_20556":49828,"_5":14099,"_26939":49675,"_2865":49829},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3379":531,"_29619":484,"_20556":49831,"_5":14099,"_26939":49675,"_2865":49832},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3379":532,"_29619":484,"_20556":49834,"_5":14099,"_26939":49675,"_2865":49835},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3379":533,"_29619":484,"_20556":49837,"_5":14099,"_26939":49675,"_2865":49838},[],"It separately loads the policies granted to each principal.",{"_3379":534,"_29619":484,"_20556":49840,"_5":14099,"_26939":49675,"_2865":49841},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3379":535,"_29619":484,"_20556":49843,"_5":14099,"_26939":49675,"_2865":49844},[],"`authz` looks for an HTTP rule granting that action.",{"_3379":536,"_29619":484,"_20556":49846,"_5":14099,"_26939":49675,"_2865":49847},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3379":537,"_29619":484,"_20556":49849,"_5":14099,"_26939":49675,"_2865":49850},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3379":538,"_29619":484,"_20556":49852,"_5":14099,"_26939":49675,"_2865":49853},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_3379":539,"_29619":484,"_20556":49855,"_5":14099,"_26939":49675,"_2865":49856},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3379":540,"_29619":484,"_20556":49858,"_5":14099,"_26939":49679,"_2865":49859},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3379":541,"_29619":484,"_20556":49861,"_5":14099,"_26939":49679,"_2865":49862},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3379":542,"_29619":484,"_20556":49864,"_5":14099,"_26939":49679,"_2865":49865},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3379":543,"_29619":484,"_20556":49867,"_5":14099,"_26939":49679,"_2865":49868},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3379":544,"_29619":484,"_20556":49870,"_5":14099,"_26939":49679,"_2865":49871},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3379":545,"_29619":484,"_20556":49873,"_5":14099,"_26939":49679,"_2865":49874},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3379":546,"_29619":484,"_20556":49876,"_5":14099,"_26939":49679,"_2865":49877},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3379":547,"_29619":484,"_20556":49879,"_5":14099,"_26939":49679,"_2865":49880},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3379":548,"_29619":484,"_20556":49882,"_5":14099,"_26939":49683,"_2865":49883},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3379":549,"_29619":484,"_20556":49885,"_5":14099,"_26939":49683,"_2865":49886},[],"The decision is made with the domain operation context:",{"_3379":550,"_29619":484,"_20556":49888,"_5":14099,"_26939":49683,"_2865":49889},[],"The middleware extracts the credential and resolves the matching principals.",{"_3379":551,"_29619":484,"_20556":49891,"_5":14099,"_26939":49683,"_2865":49892},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3379":552,"_29619":484,"_20556":49894,"_5":14099,"_26939":49683,"_2865":49895},[],"`authz` gathers the entity rules of the granted policies.",{"_3379":553,"_29619":484,"_20556":49897,"_5":14099,"_26939":49683,"_2865":49898},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3379":554,"_29619":484,"_20556":49900,"_5":14099,"_26939":49683,"_2865":49901},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3379":555,"_29619":484,"_20556":49903,"_5":14099,"_26939":49683,"_2865":49904},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3379":556,"_29619":484,"_20556":49906,"_5":14099,"_26939":49683,"_2865":49907},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3379":557,"_29619":484,"_20556":49909,"_5":14099,"_26939":49683,"_2865":49910},[],"Actions fall into two groups:",{"_3379":558,"_29619":484,"_20556":49912,"_5":14099,"_26939":49683,"_2865":49913},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3379":559,"_29619":484,"_20556":49915,"_5":14099,"_26939":49683,"_2865":49916},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3379":560,"_29619":484,"_20556":49918,"_5":14099,"_26939":49683,"_2865":49919},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3379":561,"_29619":484,"_20556":49921,"_5":14099,"_26939":49687,"_2865":49922},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3379":562,"_29619":484,"_20556":49924,"_5":14099,"_26939":49687,"_2865":49925},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3379":563,"_29619":484,"_20556":49927,"_5":14099,"_26939":49687,"_2865":49928},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3379":564,"_29619":484,"_20556":49930,"_5":14099,"_26939":49691,"_2865":49931},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3379":565,"_29619":484,"_20556":49933,"_5":14099,"_26939":49691,"_2865":49934},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3379":566,"_29619":484,"_20556":49936,"_5":14099,"_26939":49691,"_2865":49937},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3379":567,"_29619":484,"_20556":49939,"_5":14099,"_26939":49691,"_2865":49940},[],"The implemented operators are:",{"_3379":568,"_29619":484,"_20556":49942,"_5":14099,"_26939":49691,"_2865":49943},[],"`equals`, for exact equality;",{"_3379":569,"_29619":484,"_20556":49945,"_5":14099,"_26939":49691,"_2865":49946},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3379":570,"_29619":484,"_20556":49948,"_5":14099,"_26939":49691,"_2865":49949},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3379":571,"_29619":484,"_20556":49951,"_5":14099,"_26939":49691,"_2865":49952},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3379":572,"_29619":484,"_20556":49954,"_5":14099,"_26939":49695,"_2865":49955},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3379":573,"_29619":484,"_20556":49957,"_5":14099,"_26939":49695,"_2865":49958},[],"The available modes are:",{"_3379":574,"_29619":484,"_20556":49960,"_5":14099,"_26939":49695,"_2865":49961},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3379":575,"_29619":484,"_20556":49963,"_5":14099,"_26939":49695,"_2865":49964},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3379":576,"_29619":484,"_20556":49966,"_5":14099,"_26939":49695,"_2865":49967},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3379":577,"_29619":484,"_20556":49969,"_5":14099,"_26939":49695,"_2865":49970},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3379":578,"_29619":484,"_20556":49972,"_5":14099,"_26939":49695,"_2865":49973},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3379":579,"_29619":484,"_20556":49975,"_5":14099,"_26939":49695,"_2865":49976},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3379":580,"_29619":484,"_20556":49978,"_5":14099,"_26939":49699,"_2865":49979},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3379":581,"_29619":484,"_20556":49981,"_5":14099,"_26939":49699,"_2865":49982},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3379":582,"_29619":484,"_20556":49984,"_5":14099,"_26939":49699,"_2865":49985},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3379":583,"_29619":484,"_20556":49987,"_5":14099,"_26939":49699,"_2865":49988},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3379":584,"_29619":484,"_20556":49990,"_5":14099,"_26939":49707,"_2865":49991},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3379":585,"_29619":484,"_20556":49993,"_5":14099,"_26939":49707,"_2865":49994},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3379":586,"_29619":484,"_20556":49996,"_5":14099,"_26939":49711,"_2865":49997},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3379":587,"_29619":484,"_20556":49999,"_5":14099,"_26939":49711,"_2865":50000},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3379":588,"_29619":484,"_20556":50002,"_5":14099,"_26939":49715,"_2865":50003},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3379":589,"_29619":484,"_20556":50005,"_5":14099,"_26939":49715,"_2865":50006},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3379":590,"_29619":484,"_20556":50008,"_5":14099,"_26939":49715,"_2865":50009},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3379":591,"_29619":484,"_20556":50011,"_5":14099,"_26939":49719,"_2865":50012},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3379":592,"_29619":484,"_20556":50014,"_5":14099,"_26939":49719,"_2865":50015},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3379":593,"_29619":484,"_20556":50017,"_5":14099,"_26939":49719,"_2865":50018},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3379":594,"_29619":484,"_20556":50020,"_5":14099,"_26939":49719,"_2865":50021},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3379":595,"_29619":484,"_20556":50023,"_5":14099,"_26939":49719,"_2865":50024},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3379":596,"_29619":484,"_20556":50026,"_5":14099,"_26939":49719,"_2865":50027},[],"Note that:",{"_3379":597,"_29619":484,"_20556":50029,"_5":14099,"_26939":49719,"_2865":50030},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3379":598,"_29619":484,"_20556":50032,"_5":14099,"_26939":49719,"_2865":50033},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3379":599,"_29619":484,"_20556":50035,"_5":14099,"_26939":49719,"_2865":50036},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3379":600,"_29619":484,"_20556":50038,"_5":14099,"_26939":49723,"_2865":50039},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3379":601,"_29619":484,"_20556":50041,"_5":14099,"_26939":49723,"_2865":50042},[],"full and read-only access to certificates and authorities;",{"_3379":602,"_29619":484,"_20556":50044,"_5":14099,"_26939":49723,"_2865":50045},[],"full and read-only access to the KMS;",{"_3379":603,"_29619":484,"_20556":50047,"_5":14099,"_26939":49723,"_2865":50048},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3379":604,"_29619":484,"_20556":50050,"_5":14099,"_26939":49723,"_2865":50051},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3379":605,"_29619":484,"_20556":50053,"_5":14099,"_26939":49723,"_2865":50054},[],"console access;",{"_3379":606,"_29619":484,"_20556":50056,"_5":14099,"_26939":49723,"_2865":50057},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3379":607,"_29619":484,"_20556":50059,"_5":14099,"_26939":49723,"_2865":50060},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3379":608,"_29619":484,"_20556":50062,"_5":14099,"_26939":49723,"_2865":50063},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3379":609,"_29619":484,"_20556":50065,"_5":14099,"_26939":49727,"_2865":50066},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3379":610,"_29619":484,"_20556":50068,"_5":14099,"_26939":49727,"_2865":50069},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3379":611,"_29619":484,"_20556":50071,"_5":14099,"_26939":49727,"_2865":50072},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3379":612,"_29619":484,"_20556":50074,"_5":14099,"_26939":49730,"_2865":50075},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3379":613,"_29619":484,"_20556":50077,"_5":14099,"_26939":49734,"_2865":50078},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3379":614,"_29619":484,"_20556":50080,"_5":14099,"_26939":49734,"_2865":50081},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3379":615,"_29619":484,"_20556":50083,"_5":14099,"_26939":49738,"_2865":50084},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3379":616,"_29619":484,"_20556":50086,"_5":14099,"_26939":49742,"_2865":50087},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3379":617,"_29619":484,"_20556":50089,"_5":14099,"_26939":49746,"_2865":50090},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3379":618,"_29619":484,"_20556":50092,"_5":14099,"_26939":49750,"_2865":50093},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3379":619,"_29619":484,"_20556":50095,"_5":14099,"_26939":49750,"_2865":50096},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3379":620,"_29619":484,"_20556":50098,"_5":14099,"_26939":49754,"_2865":50099},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3379":621,"_29619":484,"_20556":50101,"_5":14099,"_26939":49754,"_2865":50102},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3379":622,"_29619":484,"_20556":50104,"_5":14099,"_26939":49754,"_2865":50105},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3379":623,"_29619":484,"_20556":50107,"_5":14099,"_26939":49754,"_2865":50108},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3379":624,"_29619":484,"_20556":50110,"_5":14099,"_26939":49754,"_2865":50111},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3379":625,"_29619":484,"_20556":50113,"_5":14099,"_26939":49754,"_2865":50114},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3379":626,"_29619":484,"_20556":50116,"_5":14099,"_26939":49754,"_2865":50117},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3379":627,"_29619":484,"_20556":50119,"_5":14099,"_26939":49754,"_2865":50120},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3379":628,"_29619":484,"_20556":50122,"_5":14099,"_26939":49758,"_2865":50123},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3379":629,"_29619":484,"_20556":50125,"_5":14099,"_26939":49758,"_2865":50126},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3379":630,"_29619":484,"_20556":50128,"_5":14099,"_26939":49758,"_2865":50129},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3379":631,"_29619":484,"_20556":50131,"_5":14099,"_26939":49762,"_2865":50132},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3379":632,"_29619":484,"_20556":50134,"_5":14099,"_26939":49762,"_2865":50135},[],"Use groups or stable roles for people and independent identities for automations.",{"_3379":633,"_29619":484,"_20556":50137,"_5":14099,"_26939":49762,"_2865":50138},[],"Keep at least two recovery administrators and test their access periodically.",{"_3379":634,"_29619":484,"_20556":50140,"_5":14099,"_26939":49762,"_2865":50141},[],"Review active principals, their matches and their grants after IdP changes.",{"_3379":635,"_29619":484,"_20556":50143,"_5":14099,"_26939":49762,"_2865":50144},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3379":636,"_29619":484,"_20556":50146,"_5":14099,"_26939":49762,"_2865":50147},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3379":637,"_29619":484,"_20556":50149,"_5":14099,"_26939":49762,"_2865":50150},[],"Always test one allowed and one denied operation for each role.",{"_3379":638,"_29619":484,"_20556":50152,"_5":14099,"_26939":49762,"_2865":50153},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3379":639,"_29619":484,"_20556":50155,"_5":14099,"_26939":49770,"_2865":50156},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3379":640,"_29619":484,"_20556":50158,"_5":14099,"_26939":49774,"_2865":50159},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3379":641,"_29619":484,"_20556":50161,"_5":14099,"_26939":49774,"_2865":50162},[],"that an active principal of the correct type exists;",{"_3379":642,"_29619":484,"_20556":50164,"_5":14099,"_26939":49774,"_2865":50165},[],"that the claim paths and values match the real token exactly;",{"_3379":643,"_29619":484,"_20556":50167,"_5":14099,"_26939":49774,"_2865":50168},[],"that all of the principal's conditions hold;",{"_3379":644,"_29619":484,"_20556":50170,"_5":14099,"_26939":49774,"_2865":50171},[],"that the principal has the expected policy granted;",{"_3379":645,"_29619":484,"_20556":50173,"_5":14099,"_26939":49774,"_2865":50174},[],"that the policy includes the action and the requested resource type or route;",{"_3379":646,"_29619":484,"_20556":50176,"_5":14099,"_26939":49774,"_2865":50177},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3379":647,"_29619":484,"_20556":50179,"_5":14099,"_26939":49774,"_2865":50180},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3379":648,"_29619":484,"_20556":50182,"_5":14099,"_26939":49778,"_2865":50183},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3379":649,"_29619":484,"_20556":50185,"_5":14099,"_26939":49782,"_2865":50186},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3379":650,"_29619":484,"_20556":50188,"_5":14099,"_26939":49786,"_2865":50189},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3379":651,"_29619":484,"_20556":50191,"_5":14099,"_26939":49786,"_2865":50192},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3379":652,"_29619":652,"_5":14457,"_2865":50194,"_29951":50195,"_20556":50196,"_26939":652},"Alerts and subscriptions",[48191,49659,49660],[],{"_3379":653,"_29619":652,"_20556":50198,"_5":14099,"_26939":652,"_2865":50199},[],"Send PKI events to people and external systems.",{"_3379":654,"_29619":652,"_5":29948,"_20556":50201,"_26939":50202,"_2865":50203},[],"/docs/platform/administration/alerts#how-it-works","How it works",{"_3379":655,"_29619":652,"_5":29948,"_20556":50205,"_26939":50206,"_2865":50207},[],"/docs/platform/administration/alerts#available-channels","Available channels",{"_3379":656,"_29619":652,"_5":29948,"_20556":50209,"_26939":50210,"_2865":50211},[],"/docs/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3379":657,"_29619":652,"_5":29948,"_20556":50213,"_26939":50214,"_2865":50215},[],"/docs/platform/administration/alerts#choose-the-event","Choose the event",{"_3379":658,"_29619":652,"_5":29948,"_20556":50217,"_26939":50218,"_2865":50219},[],"/docs/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3379":659,"_29619":652,"_5":29948,"_20556":50221,"_26939":50222,"_2865":50223},[],"/docs/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3379":660,"_29619":652,"_5":29948,"_20556":50225,"_26939":50226,"_2865":50227},[],"/docs/platform/administration/alerts#review-and-activate","Review and activate",{"_3379":661,"_29619":652,"_5":29948,"_20556":50229,"_26939":50230,"_2865":50231},[],"/docs/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3379":662,"_29619":652,"_5":29948,"_20556":50233,"_26939":50234,"_2865":50235},[],"/docs/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3379":663,"_29619":652,"_5":29948,"_20556":50237,"_26939":50238,"_2865":50239},[],"/docs/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3379":664,"_29619":652,"_5":29948,"_20556":50241,"_26939":50242,"_2865":50243},[],"/docs/platform/administration/alerts#event-families","Event families",{"_3379":665,"_29619":652,"_20556":50245,"_5":14099,"_26939":652,"_2865":50246},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3379":666,"_29619":652,"_20556":50248,"_5":14099,"_26939":50202,"_2865":50249},[],"A service publishes a domain event.",{"_3379":667,"_29619":652,"_20556":50251,"_5":14099,"_26939":50202,"_2865":50252},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3379":668,"_29619":652,"_20556":50254,"_5":14099,"_26939":50202,"_2865":50255},[],"Each subscription's filter decides whether it should be notified.",{"_3379":669,"_29619":652,"_20556":50257,"_5":14099,"_26939":50202,"_2865":50258},[],"Lamassu delivers the event to the configured channel.",{"_3379":670,"_29619":652,"_20556":50260,"_5":14099,"_26939":50202,"_2865":50261},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3379":671,"_29619":652,"_20556":50263,"_5":14099,"_26939":50206,"_2865":50264},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3379":672,"_29619":652,"_20556":50266,"_5":14099,"_26939":50206,"_2865":50267},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3379":673,"_29619":652,"_20556":50269,"_5":14099,"_26939":50206,"_2865":50270},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3379":674,"_29619":652,"_20556":50272,"_5":14099,"_26939":50206,"_2865":50273},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3379":675,"_29619":652,"_20556":50275,"_5":14099,"_26939":50206,"_2865":50276},[],"`apikey_options` requires `header` and `key`.",{"_3379":676,"_29619":652,"_20556":50278,"_5":14099,"_26939":50206,"_2865":50279},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3379":677,"_29619":652,"_20556":50281,"_5":14099,"_26939":50206,"_2865":50282},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3379":678,"_29619":652,"_20556":50284,"_5":14099,"_26939":50206,"_2865":50285},[],"The alerts API reference documents the full `http_client` schema.",{"_3379":679,"_29619":652,"_20556":50287,"_5":14099,"_26939":50214,"_2865":50288},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3379":680,"_29619":652,"_20556":50290,"_5":14099,"_26939":50218,"_2865":50291},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3379":681,"_29619":652,"_20556":50293,"_5":14099,"_26939":50222,"_2865":50294},[],"Add a filter if you don't want to receive every instance of the event.",{"_3379":682,"_29619":652,"_20556":50296,"_5":14099,"_26939":50222,"_2865":50297},[],"**None** notifies all instances of the event.",{"_3379":683,"_29619":652,"_20556":50299,"_5":14099,"_26939":50222,"_2865":50300},[],"**JSON Path** evaluates one or more specific fields.",{"_3379":684,"_29619":652,"_20556":50302,"_5":14099,"_26939":50222,"_2865":50303},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3379":685,"_29619":652,"_20556":50305,"_5":14099,"_26939":50222,"_2865":50306},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3379":686,"_29619":652,"_20556":50308,"_5":14099,"_26939":50222,"_2865":50309},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3379":687,"_29619":652,"_20556":50311,"_5":14099,"_26939":50222,"_2865":50312},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3379":688,"_29619":652,"_20556":50314,"_5":14099,"_26939":50226,"_2865":50315},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3379":689,"_29619":652,"_20556":50317,"_5":14099,"_26939":50230,"_2865":50318},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3379":690,"_29619":652,"_20556":50320,"_5":14099,"_26939":50230,"_2865":50321},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3379":691,"_29619":652,"_20556":50323,"_5":14099,"_26939":50230,"_2865":50324},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3379":692,"_29619":652,"_20556":50326,"_5":14099,"_26939":50230,"_2865":50327},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3379":693,"_29619":652,"_20556":50329,"_5":14099,"_26939":50230,"_2865":50330},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3379":694,"_29619":652,"_20556":50332,"_5":14099,"_26939":50230,"_2865":50333},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3379":695,"_29619":652,"_20556":50335,"_5":14099,"_26939":50230,"_2865":50336},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3379":696,"_29619":652,"_20556":50338,"_5":14099,"_26939":50230,"_2865":50339},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3379":697,"_29619":652,"_20556":50341,"_5":14099,"_26939":50234,"_2865":50342},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3379":698,"_29619":652,"_20556":50344,"_5":14099,"_26939":50234,"_2865":50345},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3379":699,"_29619":652,"_20556":50347,"_5":14099,"_26939":50234,"_2865":50348},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3379":700,"_29619":652,"_20556":50350,"_5":14099,"_26939":50234,"_2865":50351},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3379":701,"_29619":652,"_20556":50353,"_5":14099,"_26939":50234,"_2865":50354},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3379":702,"_29619":652,"_20556":50356,"_5":14099,"_26939":50234,"_2865":50357},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3379":703,"_29619":652,"_20556":50359,"_5":14099,"_26939":50234,"_2865":50360},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3379":704,"_29619":652,"_20556":50362,"_5":14099,"_26939":50234,"_2865":50363},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3379":705,"_29619":652,"_20556":50365,"_5":14099,"_26939":50238,"_2865":50366},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3379":706,"_29619":652,"_20556":50368,"_5":14099,"_26939":50238,"_2865":50369},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3379":707,"_29619":652,"_20556":50371,"_5":14099,"_26939":50242,"_2865":50372},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3379":708,"_29619":652,"_20556":50374,"_5":14099,"_26939":50242,"_2865":50375},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3379":709,"_29619":652,"_20556":50377,"_5":14099,"_26939":50242,"_2865":50378},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3379":710,"_29619":652,"_20556":50380,"_5":14099,"_26939":50242,"_2865":50381},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3379":711,"_29619":652,"_20556":50383,"_5":14099,"_26939":50242,"_2865":50384},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3379":712,"_29619":652,"_20556":50386,"_5":14099,"_26939":50242,"_2865":50387},[],"**Validation:** `va.role.crl.create`.",{"_3379":713,"_29619":652,"_20556":50389,"_5":14099,"_26939":50242,"_2865":50390},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3379":714,"_29619":652,"_20556":50392,"_5":14099,"_26939":50242,"_2865":50393},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3379":715,"_29619":715,"_5":14457,"_2865":50395,"_29951":50396,"_20556":50397,"_26939":715},"Audit logs",[48191,49659,49660],[],{"_3379":716,"_29619":715,"_20556":50399,"_5":14099,"_26939":715,"_2865":50400},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3379":717,"_29619":715,"_5":29948,"_20556":50402,"_26939":50403,"_2865":50404},[],"/docs/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3379":718,"_29619":715,"_5":29948,"_20556":50406,"_26939":50407,"_2865":50408},[],"/docs/platform/administration/audit-logs#coverage","Coverage",{"_3379":719,"_29619":715,"_5":29948,"_20556":50410,"_26939":50411,"_2865":50412},[],"/docs/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3379":720,"_29619":715,"_5":29948,"_20556":50414,"_26939":50415,"_2865":50416},[],"/docs/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3379":721,"_29619":715,"_5":29948,"_20556":50418,"_26939":50419,"_2865":50420},[],"/docs/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3379":722,"_29619":715,"_5":29948,"_20556":50422,"_26939":50423,"_2865":50424},[],"/docs/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3379":723,"_29619":715,"_5":29948,"_20556":50426,"_26939":50427,"_2865":50428},[],"/docs/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3379":724,"_29619":715,"_5":29948,"_20556":50430,"_26939":50431,"_2865":50432},[],"/docs/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3379":725,"_29619":715,"_5":29948,"_20556":50434,"_26939":50435,"_2865":50436},[],"/docs/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3379":726,"_29619":715,"_5":29948,"_20556":50438,"_26939":50439,"_2865":50440},[],"/docs/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3379":727,"_29619":715,"_5":29948,"_20556":50442,"_26939":50443,"_2865":50444},[],"/docs/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3379":728,"_29619":715,"_20556":50446,"_5":14099,"_26939":715,"_2865":50447},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3379":729,"_29619":715,"_20556":50449,"_5":14099,"_26939":50403,"_2865":50450},[],"The audit body includes:",{"_3379":730,"_29619":715,"_20556":50452,"_5":14099,"_26939":50403,"_2865":50453},[],"input: data received by the operation;",{"_3379":731,"_29619":715,"_20556":50455,"_5":14099,"_26939":50403,"_2865":50456},[],"has\\_error: whether the service returned an error;",{"_3379":732,"_29619":715,"_20556":50458,"_5":14099,"_26939":50403,"_2865":50459},[],"output: produced result or error message;",{"_3379":733,"_29619":715,"_20556":50461,"_5":14099,"_26939":50403,"_2865":50462},[],"principals: identifiers of the principals that matched the request.",{"_3379":734,"_29619":715,"_20556":50464,"_5":14099,"_26939":50403,"_2865":50465},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3379":735,"_29619":715,"_20556":50467,"_5":14099,"_26939":50403,"_2865":50468},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3379":736,"_29619":715,"_20556":50470,"_5":14099,"_26939":50407,"_2865":50471},[],"The backend applies auditing to mutations of:",{"_3379":737,"_29619":715,"_20556":50473,"_5":14099,"_26939":50407,"_2865":50474},[],"authorities, certificates and issuance profiles;",{"_3379":738,"_29619":715,"_20556":50476,"_5":14099,"_26939":50407,"_2865":50477},[],"keys and KMS engines;",{"_3379":739,"_29619":715,"_20556":50479,"_5":14099,"_26939":50407,"_2865":50480},[],"devices and identities;",{"_3379":740,"_29619":715,"_20556":50482,"_5":14099,"_26939":50407,"_2865":50483},[],"DMSs and enrollment operations;",{"_3379":741,"_29619":715,"_20556":50485,"_5":14099,"_26939":50407,"_2865":50486},[],"validation functions and CRL;",{"_3379":742,"_29619":715,"_20556":50488,"_5":14099,"_26939":50407,"_2865":50489},[],"principals, policies and authorization grants.",{"_3379":743,"_29619":715,"_20556":50491,"_5":14099,"_26939":50407,"_2865":50492},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3379":744,"_29619":715,"_20556":50494,"_5":14099,"_26939":50411,"_2865":50495},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3379":745,"_29619":715,"_20556":50497,"_5":14099,"_26939":50411,"_2865":50498},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3379":746,"_29619":715,"_20556":50500,"_5":14099,"_26939":50411,"_2865":50501},[],"Design the consumer to:",{"_3379":747,"_29619":715,"_20556":50503,"_5":14099,"_26939":50411,"_2865":50504},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3379":748,"_29619":715,"_20556":50506,"_5":14099,"_26939":50411,"_2865":50507},[],"keep the complete CloudEvent unmodified;",{"_3379":749,"_29619":715,"_20556":50509,"_5":14099,"_26939":50411,"_2865":50510},[],"record the ingestion time and detect duplicates by ID;",{"_3379":750,"_29619":715,"_20556":50512,"_5":14099,"_26939":50411,"_2865":50513},[],"encrypt in transit and at rest;",{"_3379":751,"_29619":715,"_20556":50515,"_5":14099,"_26939":50411,"_2865":50516},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3379":752,"_29619":715,"_20556":50518,"_5":14099,"_26939":50411,"_2865":50519},[],"apply an explicit retention and legal hold policy;",{"_3379":753,"_29619":715,"_20556":50521,"_5":14099,"_26939":50411,"_2865":50522},[],"alert if it stops consuming or the pending queue grows.",{"_3379":754,"_29619":715,"_20556":50524,"_5":14099,"_26939":50415,"_2865":50525},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3379":755,"_29619":715,"_20556":50527,"_5":14099,"_26939":50415,"_2865":50528},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3379":756,"_29619":715,"_20556":50530,"_5":14099,"_26939":50423,"_2865":50531},[],"Start from the reported time and normalize every source to UTC.",{"_3379":757,"_29619":715,"_20556":50533,"_5":14099,"_26939":50427,"_2865":50534},[],"Filter by event type, service source and resource identifier.",{"_3379":758,"_29619":715,"_20556":50536,"_5":14099,"_26939":50431,"_2865":50537},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3379":759,"_29619":715,"_20556":50539,"_5":14099,"_26939":50435,"_2865":50540},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3379":760,"_29619":715,"_20556":50542,"_5":14099,"_26939":50439,"_2865":50543},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3379":761,"_29619":715,"_20556":50545,"_5":14099,"_26939":50443,"_2865":50546},[],"Generate a controlled mutation in a test environment and check that:",{"_3379":762,"_29619":715,"_20556":50548,"_5":14099,"_26939":50443,"_2865":50549},[],"a successful audit event appears;",{"_3379":763,"_29619":715,"_20556":50551,"_5":14099,"_26939":50443,"_2865":50552},[],"the principal matches the identity used;",{"_3379":764,"_29619":715,"_20556":50554,"_5":14099,"_26939":50443,"_2865":50555},[],"the consumer persists it exactly once;",{"_3379":765,"_29619":715,"_20556":50557,"_5":14099,"_26939":50443,"_2865":50558},[],"it can be retrieved by resource, actor and period;",{"_3379":766,"_29619":715,"_20556":50560,"_5":14099,"_26939":50443,"_2865":50561},[],"a consumer outage raises an alert.",{"_3379":767,"_29619":715,"_20556":50563,"_5":14099,"_26939":50443,"_2865":50564},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3379":768,"_29619":768,"_5":14457,"_2865":50566,"_29951":50567,"_20556":50568,"_26939":768},"Platform architecture",[48191,49659],[],{"_3379":769,"_29619":768,"_20556":50570,"_5":14099,"_26939":768,"_2865":50571},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3379":770,"_29619":768,"_5":29948,"_20556":50573,"_26939":50574,"_2865":50575},[],"/docs/platform/concepts/architecture#control-plane","Control plane",{"_3379":771,"_29619":768,"_5":29948,"_20556":50577,"_26939":50578,"_2865":50579},[],"/docs/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3379":772,"_29619":768,"_5":29948,"_20556":50581,"_26939":50582,"_2865":50583},[],"/docs/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3379":773,"_29619":768,"_5":29948,"_20556":50585,"_26939":50586,"_2865":50587},[],"/docs/platform/concepts/architecture#status-and-validation","Status and validation",{"_3379":774,"_29619":768,"_5":29948,"_20556":50589,"_26939":50590,"_2865":50591},[],"/docs/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3379":775,"_29619":768,"_20556":50593,"_5":14099,"_26939":768,"_2865":50594},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3379":776,"_29619":768,"_20556":50596,"_5":14099,"_26939":768,"_2865":50597},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3379":777,"_29619":768,"_20556":50599,"_5":14099,"_26939":50574,"_2865":50600},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3379":778,"_29619":768,"_20556":50602,"_5":14099,"_26939":50578,"_2865":50603},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3379":779,"_29619":768,"_20556":50605,"_5":14099,"_26939":50582,"_2865":50606},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3379":780,"_29619":768,"_20556":50608,"_5":14099,"_26939":50586,"_2865":50609},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3379":781,"_29619":768,"_20556":50611,"_5":14099,"_26939":50590,"_2865":50612},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3379":782,"_29619":782,"_5":14457,"_2865":50614,"_29951":50615,"_20556":50616,"_26939":782},"How Lamassu works",[48191,49659],[],{"_3379":783,"_29619":782,"_20556":50618,"_5":14099,"_26939":782,"_2865":50619},[],"The mental model of trust, keys, certificates and devices.",{"_3379":784,"_29619":782,"_5":29948,"_20556":50621,"_26939":50622,"_2865":50623},[],"/docs/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3379":785,"_29619":782,"_5":29948,"_20556":50625,"_26939":50626,"_2865":50627},[],"/docs/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3379":786,"_29619":782,"_20556":50629,"_5":14099,"_26939":782,"_2865":50630},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3379":787,"_29619":782,"_20556":50632,"_5":14099,"_26939":50622,"_2865":50633},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3379":788,"_29619":782,"_20556":50635,"_5":14099,"_26939":50622,"_2865":50636},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3379":789,"_29619":782,"_20556":50638,"_5":14099,"_26939":50622,"_2865":50639},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3379":790,"_29619":782,"_20556":50641,"_5":14099,"_26939":50622,"_2865":50642},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3379":791,"_29619":782,"_20556":50644,"_5":14099,"_26939":50622,"_2865":50645},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3379":792,"_29619":782,"_20556":50647,"_5":14099,"_26939":50626,"_2865":50648},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3379":793,"_29619":782,"_20556":50650,"_5":14099,"_26939":50626,"_2865":50651},[],"A DMS relates that CA to an enrollment policy.",{"_3379":794,"_29619":782,"_20556":50653,"_5":14099,"_26939":50626,"_2865":50654},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3379":795,"_29619":782,"_20556":50656,"_5":14099,"_26939":50626,"_2865":50657},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3379":796,"_29619":782,"_20556":50659,"_5":14099,"_26939":50626,"_2865":50660},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3379":797,"_29619":782,"_20556":50662,"_5":14099,"_26939":50626,"_2865":50663},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3379":798,"_29619":782,"_20556":50665,"_5":14099,"_26939":50626,"_2865":50666},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3379":799,"_29619":799,"_5":14457,"_2865":50668,"_29951":50669,"_20556":50671,"_26939":799},"Devices and identities",[48191,49659,50670,50668],"IoT Fleets",[],{"_3379":800,"_29619":799,"_20556":50673,"_5":14099,"_26939":799,"_2865":50674},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3379":801,"_29619":799,"_5":29948,"_20556":50676,"_26939":50677,"_2865":50678},[],"/docs/platform/iot-fleets/device-management#device-states","Device states",{"_3379":802,"_29619":799,"_5":29948,"_20556":50680,"_26939":50681,"_2865":50682},[],"/docs/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3379":803,"_29619":799,"_5":29948,"_20556":50684,"_26939":50685,"_2865":50686},[],"/docs/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3379":804,"_29619":799,"_5":29948,"_20556":50688,"_26939":50689,"_2865":50690},[],"/docs/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3379":805,"_29619":799,"_5":29948,"_20556":50692,"_26939":50693,"_2865":50694},[],"/docs/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3379":806,"_29619":799,"_5":29948,"_20556":50696,"_26939":50697,"_2865":50698},[],"/docs/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3379":807,"_29619":799,"_5":29948,"_20556":50700,"_26939":50701,"_2865":50702},[],"/docs/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3379":808,"_29619":799,"_5":29948,"_20556":50704,"_26939":50705,"_2865":50706},[],"/docs/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3379":809,"_29619":799,"_5":29948,"_20556":50708,"_26939":50709,"_2865":50710},[],"/docs/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3379":810,"_29619":799,"_5":29948,"_20556":50712,"_26939":50713,"_2865":50714},[],"/docs/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3379":811,"_29619":799,"_5":29948,"_20556":50716,"_26939":50717,"_2865":50718},[],"/docs/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3379":812,"_29619":799,"_20556":50720,"_5":14099,"_26939":799,"_2865":50721},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3379":813,"_29619":799,"_20556":50723,"_5":14099,"_26939":799,"_2865":50724},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3379":814,"_29619":799,"_20556":50726,"_5":14099,"_26939":50677,"_2865":50727},[],"Operational view",{"_3379":815,"_29619":799,"_20556":50729,"_5":14099,"_26939":50677,"_2865":50730},[],"Meaning",{"_3379":816,"_29619":799,"_20556":50732,"_5":14099,"_26939":50677,"_2865":50733},[],"**No Identity**",{"_3379":817,"_29619":799,"_20556":50735,"_5":14099,"_26939":50677,"_2865":50736},[],"A record exists without an associated identity.",{"_3379":818,"_29619":799,"_20556":50738,"_5":14099,"_26939":50677,"_2865":50739},[],"**Active**",{"_3379":819,"_29619":799,"_20556":50741,"_5":14099,"_26939":50677,"_2865":50742},[],"The slot is active; also check certificate dates, status and usages.",{"_3379":820,"_29619":799,"_20556":50744,"_5":14099,"_26939":50677,"_2865":50745},[],"**Renewal Pending**",{"_3379":821,"_29619":799,"_20556":50747,"_5":14099,"_26939":50677,"_2865":50748},[],"The identity is in the operational renewal window.",{"_3379":822,"_29619":799,"_20556":50750,"_5":14099,"_26939":50677,"_2865":50751},[],"**Expiring Soon**",{"_3379":823,"_29619":799,"_20556":50753,"_5":14099,"_26939":50677,"_2865":50754},[],"Expiration is approaching according to configured thresholds.",{"_3379":824,"_29619":799,"_20556":50756,"_5":14099,"_26939":50677,"_2865":50757},[],"**Expired**",{"_3379":825,"_29619":799,"_20556":50759,"_5":14099,"_26939":50677,"_2865":50760},[],"The identity has expired.",{"_3379":826,"_29619":799,"_20556":50762,"_5":14099,"_26939":50677,"_2865":50763},[],"**Revoked**",{"_3379":827,"_29619":799,"_20556":50765,"_5":14099,"_26939":50677,"_2865":50766},[],"The identity is marked revoked.",{"_3379":828,"_29619":799,"_20556":50768,"_5":14099,"_26939":50677,"_2865":50769},[],"**Decommissioned**",{"_3379":829,"_29619":799,"_20556":50771,"_5":14099,"_26939":50677,"_2865":50772},[],"The record is retired and ordinary updates do not restore operation.",{"_3379":830,"_29619":799,"_20556":50774,"_5":14099,"_26939":50677,"_2865":50775},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3379":831,"_29619":799,"_20556":50777,"_5":14099,"_26939":50681,"_2865":50778},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3379":832,"_29619":799,"_20556":50780,"_5":14099,"_26939":50681,"_2865":50781},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3379":833,"_29619":799,"_20556":50783,"_5":14099,"_26939":50681,"_2865":50784},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3379":834,"_29619":799,"_20556":50786,"_5":14099,"_26939":50681,"_2865":50787},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3379":835,"_29619":799,"_20556":50789,"_5":14099,"_26939":50685,"_2865":50790},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3379":836,"_29619":799,"_20556":50792,"_5":14099,"_26939":50689,"_2865":50793},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3379":837,"_29619":799,"_20556":50795,"_5":14099,"_26939":50693,"_2865":50796},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3379":838,"_29619":799,"_20556":50798,"_5":14099,"_26939":50697,"_2865":50799},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3379":839,"_29619":799,"_20556":50801,"_5":14099,"_26939":50701,"_2865":50802},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3379":840,"_29619":799,"_20556":50804,"_5":14099,"_26939":50701,"_2865":50805},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3379":841,"_29619":799,"_20556":50807,"_5":14099,"_26939":50705,"_2865":50808},[],"From **No Identity**, use **Assign Identity**:",{"_3379":842,"_29619":799,"_20556":50810,"_5":14099,"_26939":50705,"_2865":50811},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3379":843,"_29619":799,"_20556":50813,"_5":14099,"_26939":50705,"_2865":50814},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3379":844,"_29619":799,"_20556":50816,"_5":14099,"_26939":50705,"_2865":50817},[],"Confirm and read the serial, active version and history again.",{"_3379":845,"_29619":799,"_20556":50819,"_5":14099,"_26939":50705,"_2865":50820},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3379":846,"_29619":799,"_20556":50822,"_5":14099,"_26939":50705,"_2865":50823},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3379":847,"_29619":799,"_20556":50825,"_5":14099,"_26939":50709,"_2865":50826},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3379":848,"_29619":799,"_20556":50828,"_5":14099,"_26939":50709,"_2865":50829},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3379":849,"_29619":799,"_20556":50831,"_5":14099,"_26939":50713,"_2865":50832},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3379":850,"_29619":799,"_20556":50834,"_5":14099,"_26939":50713,"_2865":50835},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3379":851,"_29619":799,"_20556":50837,"_5":14099,"_26939":50713,"_2865":50838},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3379":852,"_29619":799,"_20556":50840,"_5":14099,"_26939":50713,"_2865":50841},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3379":853,"_29619":799,"_20556":50843,"_5":14099,"_26939":50717,"_2865":50844},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3379":854,"_29619":799,"_20556":50846,"_5":14099,"_26939":50717,"_2865":50847},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3379":855,"_29619":855,"_5":14457,"_2865":50849,"_29951":50850,"_20556":50852,"_26939":855},"Bootstrap identity and authentication",[48191,49659,50670,50668,50851],"Enrollment with PKI",[],{"_3379":856,"_29619":855,"_20556":50854,"_5":14099,"_26939":855,"_2865":50855},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3379":857,"_29619":855,"_5":29948,"_20556":50857,"_26939":50858,"_2865":50859},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3379":858,"_29619":855,"_5":29948,"_20556":50861,"_26939":50862,"_2865":50863},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3379":859,"_29619":855,"_5":29948,"_20556":50865,"_26939":50866,"_2865":50867},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3379":860,"_29619":855,"_5":29948,"_20556":50869,"_26939":50870,"_2865":50871},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3379":861,"_29619":855,"_5":29948,"_20556":50873,"_26939":50874,"_2865":50875},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3379":862,"_29619":855,"_20556":50877,"_5":14099,"_26939":855,"_2865":50878},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3379":863,"_29619":855,"_20556":50880,"_5":14099,"_26939":50858,"_2865":50881},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3379":864,"_29619":855,"_20556":50883,"_5":14099,"_26939":50858,"_2865":50884},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3379":865,"_29619":855,"_20556":50886,"_5":14099,"_26939":50862,"_2865":50887},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3379":866,"_29619":855,"_20556":50889,"_5":14099,"_26939":50862,"_2865":50890},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3379":867,"_29619":855,"_20556":50892,"_5":14099,"_26939":50862,"_2865":50893},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3379":868,"_29619":855,"_20556":50895,"_5":14099,"_26939":50866,"_2865":50896},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3379":869,"_29619":855,"_20556":50898,"_5":14099,"_26939":50866,"_2865":50899},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3379":870,"_29619":855,"_20556":50901,"_5":14099,"_26939":50870,"_2865":50902},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3379":871,"_29619":855,"_20556":50904,"_5":14099,"_26939":50870,"_2865":50905},[],"Example body:",{"_3379":872,"_29619":855,"_20556":50907,"_5":14099,"_26939":50870,"_2865":50908},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3379":873,"_29619":855,"_20556":50910,"_5":14099,"_26939":50870,"_2865":50911},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3379":874,"_29619":855,"_20556":50913,"_5":14099,"_26939":50870,"_2865":50914},[],"Continuation requires a successful HTTP response and JSON:",{"_3379":875,"_29619":855,"_20556":50916,"_5":14099,"_26939":50870,"_2865":50917},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3379":876,"_29619":855,"_20556":50919,"_5":14099,"_26939":50874,"_2865":50920},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3379":877,"_29619":855,"_20556":50922,"_5":14099,"_26939":50874,"_2865":50923},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3379":878,"_29619":878,"_5":14457,"_2865":50925,"_29951":50926,"_20556":50927,"_26939":878},"Configure and operate the DMS",[48191,49659,50670,50668,50851],[],{"_3379":879,"_29619":878,"_20556":50929,"_5":14099,"_26939":878,"_2865":50930},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3379":880,"_29619":878,"_5":29948,"_20556":50932,"_26939":50933,"_2865":48201},[],"/docs/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3379":881,"_29619":878,"_5":29948,"_20556":50935,"_26939":50936,"_2865":50937},[],"/docs/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3379":882,"_29619":878,"_5":29948,"_20556":50939,"_26939":50940,"_2865":50941},[],"/docs/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3379":883,"_29619":878,"_5":29948,"_20556":50943,"_26939":50944,"_2865":50945},[],"/docs/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3379":884,"_29619":878,"_5":29948,"_20556":50947,"_26939":50948,"_2865":50949},[],"/docs/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3379":885,"_29619":878,"_5":29948,"_20556":50951,"_26939":50952,"_2865":50953},[],"/docs/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3379":886,"_29619":878,"_5":29948,"_20556":50955,"_26939":50956,"_2865":50957},[],"/docs/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3379":887,"_29619":878,"_5":29948,"_20556":50959,"_26939":50960,"_2865":50961},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3379":888,"_29619":878,"_5":29948,"_20556":50963,"_26939":50964,"_2865":50965},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3379":889,"_29619":878,"_5":29948,"_20556":50967,"_26939":50968,"_2865":50969},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3379":890,"_29619":878,"_5":29948,"_20556":50971,"_26939":50972,"_2865":50973},[],"/docs/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3379":891,"_29619":878,"_5":29948,"_20556":50975,"_26939":50976,"_2865":50977},[],"/docs/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3379":892,"_29619":878,"_5":29948,"_20556":50979,"_26939":50980,"_2865":50981},[],"/docs/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3379":893,"_29619":878,"_5":29948,"_20556":50983,"_26939":50984,"_2865":50985},[],"/docs/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3379":894,"_29619":878,"_5":29948,"_20556":50987,"_26939":50988,"_2865":50989},[],"/docs/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3379":895,"_29619":878,"_5":29948,"_20556":50991,"_26939":50992,"_2865":50993},[],"/docs/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3379":896,"_29619":878,"_5":29948,"_20556":50995,"_26939":50996,"_2865":50997},[],"/docs/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3379":897,"_29619":878,"_5":29948,"_20556":50999,"_26939":51000,"_2865":51001},[],"/docs/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3379":898,"_29619":878,"_20556":51003,"_5":14099,"_26939":878,"_2865":51004},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3379":899,"_29619":878,"_20556":51006,"_5":14099,"_26939":50933,"_2865":51007},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3379":900,"_29619":878,"_20556":51009,"_5":14099,"_26939":50933,"_2865":51010},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3379":901,"_29619":878,"_20556":51012,"_5":14099,"_26939":50940,"_2865":51013},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3379":902,"_29619":878,"_20556":51015,"_5":14099,"_26939":50944,"_2865":51016},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3379":903,"_29619":878,"_20556":51018,"_5":14099,"_26939":50948,"_2865":51019},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3379":904,"_29619":878,"_20556":51021,"_5":14099,"_26939":50952,"_2865":51022},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3379":905,"_29619":878,"_20556":51024,"_5":14099,"_26939":50956,"_2865":51025},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3379":906,"_29619":878,"_20556":51027,"_5":14099,"_26939":50964,"_2865":51028},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3379":907,"_29619":878,"_20556":51030,"_5":14099,"_26939":50964,"_2865":51031},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3379":908,"_29619":878,"_20556":51033,"_5":14099,"_26939":50968,"_2865":51034},[],"`settings.enrollment_settings` field",{"_3379":909,"_29619":878,"_20556":51036,"_5":14099,"_26939":50968,"_2865":51037},[],"Decision",{"_3379":910,"_29619":878,"_20556":51039,"_5":14099,"_26939":50968,"_2865":51040},[],"`protocol`",{"_3379":911,"_29619":878,"_20556":51042,"_5":14099,"_26939":50968,"_2865":51043},[],"`EST_RFC7030` for these operations.",{"_3379":912,"_29619":878,"_20556":51045,"_5":14099,"_26939":50968,"_2865":51046},[],"`enrollment_ca`",{"_3379":913,"_29619":878,"_20556":51048,"_5":14099,"_26939":50968,"_2865":51049},[],"ID of the signing CA.",{"_3379":914,"_29619":878,"_20556":51051,"_5":14099,"_26939":50968,"_2865":51052},[],"`verify_csr_signature`",{"_3379":915,"_29619":878,"_20556":51054,"_5":14099,"_26939":50968,"_2865":51055},[],"Keep `true` to verify CSR key possession.",{"_3379":916,"_29619":878,"_20556":51057,"_5":14099,"_26939":50968,"_2865":51058},[],"`enable_replaceable_enrollment`",{"_3379":917,"_29619":878,"_20556":51060,"_5":14099,"_26939":50968,"_2865":51061},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3379":918,"_29619":878,"_20556":51063,"_5":14099,"_26939":50968,"_2865":51064},[],"`est_rfc7030_settings.auth_mode`",{"_3379":919,"_29619":878,"_20556":51066,"_5":14099,"_26939":50968,"_2865":51067},[],"One of the four authentication modes.",{"_3379":920,"_29619":878,"_20556":51069,"_5":14099,"_26939":50968,"_2865":51070},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3379":921,"_29619":878,"_20556":51072,"_5":14099,"_26939":50972,"_2865":51073},[],"The blocks are independent:",{"_3379":922,"_29619":878,"_20556":51075,"_5":14099,"_26939":50972,"_2865":51076},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3379":923,"_29619":878,"_20556":51078,"_5":14099,"_26939":50972,"_2865":51079},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3379":924,"_29619":878,"_20556":51081,"_5":14099,"_26939":50972,"_2865":51082},[],"`auth_mode`",{"_3379":925,"_29619":878,"_20556":51084,"_5":14099,"_26939":50972,"_2865":51085},[],"Control applied in the configured operation",{"_3379":926,"_29619":878,"_20556":51087,"_5":14099,"_26939":50972,"_2865":51088},[],"`CLIENT_CERTIFICATE`",{"_3379":927,"_29619":878,"_20556":51090,"_5":14099,"_26939":50972,"_2865":51091},[],"Presented certificate validation.",{"_3379":928,"_29619":878,"_20556":51093,"_5":14099,"_26939":50972,"_2865":51094},[],"`EXTERNAL_WEBHOOK`",{"_3379":929,"_29619":878,"_20556":51096,"_5":14099,"_26939":50972,"_2865":51097},[],"Configured webhook authorization.",{"_3379":930,"_29619":878,"_20556":51099,"_5":14099,"_26939":50972,"_2865":51100},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3379":931,"_29619":878,"_20556":51102,"_5":14099,"_26939":50972,"_2865":51103},[],"Certificate validation followed by webhook approval.",{"_3379":932,"_29619":878,"_20556":51105,"_5":14099,"_26939":50972,"_2865":51106},[],"`NO_AUTH`",{"_3379":933,"_29619":878,"_20556":51108,"_5":14099,"_26939":50972,"_2865":51109},[],"No DMS requester authentication.",{"_3379":934,"_29619":878,"_20556":51111,"_5":14099,"_26939":50972,"_2865":51112},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3379":935,"_29619":878,"_20556":51114,"_5":14099,"_26939":50972,"_2865":51115},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3379":936,"_29619":878,"_20556":51117,"_5":14099,"_26939":50972,"_2865":51118},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3379":937,"_29619":878,"_20556":51120,"_5":14099,"_26939":50972,"_2865":51121},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3379":938,"_29619":878,"_20556":51123,"_5":14099,"_26939":50976,"_2865":51124},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3379":939,"_29619":878,"_20556":51126,"_5":14099,"_26939":50976,"_2865":51127},[],"`external_webhook_settings` field",{"_3379":940,"_29619":878,"_20556":51129,"_5":14099,"_26939":50976,"_2865":51037},[],{"_3379":941,"_29619":878,"_20556":51131,"_5":14099,"_26939":50976,"_2865":51132},[],"`url`",{"_3379":942,"_29619":878,"_20556":51134,"_5":14099,"_26939":50976,"_2865":51135},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3379":943,"_29619":878,"_20556":51137,"_5":14099,"_26939":50976,"_2865":51138},[],"`method`",{"_3379":944,"_29619":878,"_20556":51140,"_5":14099,"_26939":50976,"_2865":51141},[],"`POST` or `PUT`; `POST` by default.",{"_3379":945,"_29619":878,"_20556":51143,"_5":14099,"_26939":50976,"_2865":51144},[],"`name`",{"_3379":946,"_29619":878,"_20556":51146,"_5":14099,"_26939":50976,"_2865":51147},[],"Label used in service logs.",{"_3379":947,"_29619":878,"_20556":51149,"_5":14099,"_26939":50976,"_2865":51150},[],"`config.auth_mode`",{"_3379":948,"_29619":878,"_20556":51152,"_5":14099,"_26939":50976,"_2865":51153},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3379":949,"_29619":878,"_20556":51155,"_5":14099,"_26939":50976,"_2865":51156},[],"`config.log_level`",{"_3379":950,"_29619":878,"_20556":51158,"_5":14099,"_26939":50976,"_2865":51159},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3379":951,"_29619":878,"_20556":51161,"_5":14099,"_26939":50976,"_2865":51162},[],"`config.apikey_options`",{"_3379":952,"_29619":878,"_20556":51164,"_5":14099,"_26939":50976,"_2865":51165},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3379":953,"_29619":878,"_20556":51167,"_5":14099,"_26939":50976,"_2865":51168},[],"`config.jwt_options`",{"_3379":954,"_29619":878,"_20556":51170,"_5":14099,"_26939":50976,"_2865":51171},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3379":955,"_29619":878,"_20556":51173,"_5":14099,"_26939":50976,"_2865":51174},[],"`config.mtls_options`",{"_3379":956,"_29619":878,"_20556":51176,"_5":14099,"_26939":50976,"_2865":51177},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3379":957,"_29619":878,"_20556":51179,"_5":14099,"_26939":50976,"_2865":51180},[],"`config.insecure_skip_verify`",{"_3379":958,"_29619":878,"_20556":51182,"_5":14099,"_26939":50976,"_2865":51183},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3379":959,"_29619":878,"_20556":51185,"_5":14099,"_26939":50976,"_2865":51186},[],"`config.call_timeout`",{"_3379":960,"_29619":878,"_20556":51188,"_5":14099,"_26939":50976,"_2865":51189},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3379":961,"_29619":878,"_20556":51191,"_5":14099,"_26939":50976,"_2865":51192},[],"Rules for that configuration:",{"_3379":962,"_29619":878,"_20556":51194,"_5":14099,"_26939":50976,"_2865":51195},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3379":963,"_29619":878,"_20556":51197,"_5":14099,"_26939":50976,"_2865":51198},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3379":964,"_29619":878,"_20556":51200,"_5":14099,"_26939":50976,"_2865":51201},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3379":965,"_29619":878,"_20556":51203,"_5":14099,"_26939":50976,"_2865":51204},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3379":966,"_29619":878,"_20556":51206,"_5":14099,"_26939":50976,"_2865":51207},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3379":967,"_29619":878,"_20556":51209,"_5":14099,"_26939":50976,"_2865":51210},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3379":968,"_29619":878,"_20556":51212,"_5":14099,"_26939":50976,"_2865":51213},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3379":969,"_29619":878,"_20556":51215,"_5":14099,"_26939":50976,"_2865":51216},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3379":970,"_29619":878,"_20556":51218,"_5":14099,"_26939":50976,"_2865":51219},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3379":971,"_29619":878,"_20556":51221,"_5":14099,"_26939":50980,"_2865":51222},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3379":972,"_29619":878,"_20556":51224,"_5":14099,"_26939":50984,"_2865":51225},[],"`settings.reenrollment_settings` field",{"_3379":973,"_29619":878,"_20556":51227,"_5":14099,"_26939":50984,"_2865":48581},[],{"_3379":974,"_29619":878,"_20556":51229,"_5":14099,"_26939":50984,"_2865":51230},[],"`reenrollment_delta`",{"_3379":975,"_29619":878,"_20556":51232,"_5":14099,"_26939":50984,"_2865":51233},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3379":976,"_29619":878,"_20556":51235,"_5":14099,"_26939":50984,"_2865":51236},[],"`preventive_delta`",{"_3379":977,"_29619":878,"_20556":51238,"_5":14099,"_26939":50984,"_2865":51239},[],"Preventive operational monitoring threshold.",{"_3379":978,"_29619":878,"_20556":51241,"_5":14099,"_26939":50984,"_2865":51242},[],"`critical_delta`",{"_3379":979,"_29619":878,"_20556":51244,"_5":14099,"_26939":50984,"_2865":51245},[],"Critical operational monitoring threshold.",{"_3379":980,"_29619":878,"_20556":51247,"_5":14099,"_26939":50984,"_2865":51248},[],"`enable_expired_renewal`",{"_3379":981,"_29619":878,"_20556":51250,"_5":14099,"_26939":50984,"_2865":51251},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3379":982,"_29619":878,"_20556":51253,"_5":14099,"_26939":50984,"_2865":51254},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3379":983,"_29619":878,"_20556":51256,"_5":14099,"_26939":50984,"_2865":51257},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3379":984,"_29619":878,"_20556":51259,"_5":14099,"_26939":50984,"_2865":51260},[],"`revoke_on_reenrollment`",{"_3379":985,"_29619":878,"_20556":51262,"_5":14099,"_26939":50984,"_2865":51263},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3379":986,"_29619":878,"_20556":51265,"_5":14099,"_26939":50984,"_2865":51266},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3379":987,"_29619":878,"_20556":51268,"_5":14099,"_26939":50988,"_2865":51269},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3379":988,"_29619":878,"_20556":51271,"_5":14099,"_26939":50992,"_2865":48575},[],{"_3379":989,"_29619":878,"_20556":51273,"_5":14099,"_26939":50992,"_2865":51274},[],"Published material",{"_3379":990,"_29619":878,"_20556":51276,"_5":14099,"_26939":50992,"_2865":51277},[],"**Include Lamassu System CA**",{"_3379":991,"_29619":878,"_20556":51279,"_5":14099,"_26939":50992,"_2865":51280},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3379":992,"_29619":878,"_20556":51282,"_5":14099,"_26939":50992,"_2865":51283},[],"**Include Enrollment CA**",{"_3379":993,"_29619":878,"_20556":51285,"_5":14099,"_26939":50992,"_2865":51286},[],"Selected issuing CA certificate.",{"_3379":994,"_29619":878,"_20556":51288,"_5":14099,"_26939":50992,"_2865":51289},[],"**Managed CAs**",{"_3379":995,"_29619":878,"_20556":51291,"_5":14099,"_26939":50992,"_2865":51292},[],"Explicitly selected CA certificates.",{"_3379":996,"_29619":878,"_20556":51294,"_5":14099,"_26939":50992,"_2865":51295},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3379":997,"_29619":878,"_20556":51297,"_5":14099,"_26939":50996,"_2865":51298},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3379":998,"_29619":878,"_20556":51300,"_5":14099,"_26939":50996,"_2865":51301},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3379":999,"_29619":878,"_20556":51303,"_5":14099,"_26939":50996,"_2865":51304},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3379":1000,"_29619":878,"_20556":51306,"_5":14099,"_26939":51000,"_2865":51307},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3379":1001,"_29619":1001,"_5":14457,"_2865":51309,"_29951":51310,"_20556":51311,"_26939":1001},"Integrate the EST client",[48191,49659,50670,50668,50851],[],{"_3379":1002,"_29619":1001,"_20556":51313,"_5":14099,"_26939":1001,"_2865":51314},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3379":1003,"_29619":1001,"_5":29948,"_20556":51316,"_26939":51317,"_2865":48201},[],"/docs/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3379":1004,"_29619":1001,"_5":29948,"_20556":51319,"_26939":51320,"_2865":51321},[],"/docs/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3379":1005,"_29619":1001,"_5":29948,"_20556":51323,"_26939":51324,"_2865":51325},[],"/docs/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3379":1006,"_29619":1001,"_5":29948,"_20556":51327,"_26939":51328,"_2865":51329},[],"/docs/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3379":1007,"_29619":1001,"_5":29948,"_20556":51331,"_26939":51332,"_2865":51333},[],"/docs/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3379":1008,"_29619":1001,"_5":29948,"_20556":51335,"_26939":51336,"_2865":51337},[],"/docs/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3379":1009,"_29619":1001,"_20556":51339,"_5":14099,"_26939":1001,"_2865":51340},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3379":1010,"_29619":1001,"_20556":51342,"_5":14099,"_26939":51317,"_2865":51343},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3379":1011,"_29619":1001,"_20556":51345,"_5":14099,"_26939":51317,"_2865":51346},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3379":1012,"_29619":1001,"_20556":51348,"_5":14099,"_26939":51317,"_2865":51349},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3379":1013,"_29619":1001,"_20556":51351,"_5":14099,"_26939":51320,"_2865":51352},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3379":1014,"_29619":1001,"_20556":51354,"_5":14099,"_26939":51320,"_2865":51355},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3379":1015,"_29619":1001,"_20556":51357,"_5":14099,"_26939":51324,"_2865":51358},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3379":1016,"_29619":1001,"_20556":51360,"_5":14099,"_26939":51324,"_2865":51361},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3379":1017,"_29619":1001,"_20556":51363,"_5":14099,"_26939":51328,"_2865":51364},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3379":1018,"_29619":1001,"_20556":51366,"_5":14099,"_26939":51328,"_2865":51367},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3379":1019,"_29619":1001,"_20556":51369,"_5":14099,"_26939":51332,"_2865":51370},[],"For a root that issues directly:",{"_3379":1020,"_29619":1001,"_20556":51372,"_5":14099,"_26939":51332,"_2865":51373},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3379":1021,"_29619":1001,"_20556":51375,"_5":14099,"_26939":51332,"_2865":51376},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3379":1022,"_29619":1001,"_20556":51378,"_5":14099,"_26939":51336,"_2865":51379},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3379":1023,"_29619":1023,"_5":14457,"_2865":51381,"_29951":51382,"_20556":51383,"_26939":1023},"EST reference",[48191,49659,50670,50668,50851],[],{"_3379":1024,"_29619":1023,"_20556":51385,"_5":14099,"_26939":1023,"_2865":51386},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3379":1025,"_29619":1023,"_5":29948,"_20556":51388,"_26939":51389,"_2865":51390},[],"/docs/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3379":1026,"_29619":1023,"_5":29948,"_20556":51392,"_26939":51393,"_2865":22284},[],"/docs/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3379":1027,"_29619":1023,"_5":29948,"_20556":51395,"_26939":51396,"_2865":25575},[],"/docs/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3379":1028,"_29619":1023,"_5":29948,"_20556":51398,"_26939":51399,"_2865":25582},[],"/docs/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3379":1029,"_29619":1023,"_5":29948,"_20556":51401,"_26939":51402,"_2865":24904},[],"/docs/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3379":1030,"_29619":1023,"_5":29948,"_20556":51404,"_26939":51405,"_2865":51406},[],"/docs/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3379":1031,"_29619":1023,"_5":29948,"_20556":51408,"_26939":51409,"_2865":51410},[],"/docs/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3379":1032,"_29619":1023,"_5":29948,"_20556":51412,"_26939":51413,"_2865":51414},[],"/docs/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3379":1033,"_29619":1023,"_20556":51416,"_5":14099,"_26939":1023,"_2865":51417},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3379":1034,"_29619":1023,"_20556":51419,"_5":14099,"_26939":51389,"_2865":51420},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3379":1035,"_29619":1023,"_20556":51422,"_5":14099,"_26939":51389,"_2865":51423},[],"Operation",{"_3379":1036,"_29619":1023,"_20556":51425,"_5":14099,"_26939":51389,"_2865":51426},[],"Method",{"_3379":1037,"_29619":1023,"_20556":51428,"_5":14099,"_26939":51389,"_2865":51429},[],"Authentication and condition",{"_3379":1038,"_29619":1023,"_20556":51431,"_5":14099,"_26939":51389,"_2865":51432},[],"`/cacerts`",{"_3379":1039,"_29619":1023,"_20556":51434,"_5":14099,"_26939":51389,"_2865":51435},[],"GET",{"_3379":1040,"_29619":1023,"_20556":51437,"_5":14099,"_26939":51389,"_2865":51438},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3379":1041,"_29619":1023,"_20556":51440,"_5":14099,"_26939":51389,"_2865":51441},[],"`/simpleenroll`",{"_3379":1042,"_29619":1023,"_20556":51443,"_5":14099,"_26939":51389,"_2865":51444},[],"POST",{"_3379":1043,"_29619":1023,"_20556":51446,"_5":14099,"_26939":51389,"_2865":51447},[],"Initial authentication and DMS registration/replacement policy.",{"_3379":1044,"_29619":1023,"_20556":51449,"_5":14099,"_26939":51389,"_2865":51450},[],"`/simplereenroll`",{"_3379":1045,"_29619":1023,"_20556":51452,"_5":14099,"_26939":51389,"_2865":51444},[],{"_3379":1046,"_29619":1023,"_20556":51454,"_5":14099,"_26939":51389,"_2865":51455},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3379":1047,"_29619":1023,"_20556":51457,"_5":14099,"_26939":51389,"_2865":51458},[],"`/serverkeygen`",{"_3379":1048,"_29619":1023,"_20556":51460,"_5":14099,"_26939":51389,"_2865":51444},[],{"_3379":1049,"_29619":1023,"_20556":51462,"_5":14099,"_26939":51389,"_2865":51463},[],"Initial authentication and admission; server generation enabled.",{"_3379":1050,"_29619":1023,"_20556":51465,"_5":14099,"_26939":51389,"_2865":51466},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3379":1051,"_29619":1023,"_20556":51468,"_5":14099,"_26939":51393,"_2865":51469},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3379":1052,"_29619":1023,"_20556":51471,"_5":14099,"_26939":51393,"_2865":51472},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3379":1053,"_29619":1023,"_20556":51474,"_5":14099,"_26939":51396,"_2865":51475},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3379":1054,"_29619":1023,"_20556":51477,"_5":14099,"_26939":51396,"_2865":51478},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3379":1055,"_29619":1023,"_20556":51480,"_5":14099,"_26939":51399,"_2865":51481},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3379":1056,"_29619":1023,"_20556":51483,"_5":14099,"_26939":51399,"_2865":51484},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3379":1057,"_29619":1023,"_20556":51486,"_5":14099,"_26939":51402,"_2865":51487},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3379":1058,"_29619":1023,"_20556":51489,"_5":14099,"_26939":51402,"_2865":51490},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3379":1059,"_29619":1023,"_20556":51492,"_5":14099,"_26939":51405,"_2865":51493},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3379":1060,"_29619":1023,"_20556":51495,"_5":14099,"_26939":51405,"_2865":51496},[],"Part",{"_3379":1061,"_29619":1023,"_20556":51498,"_5":14099,"_26939":51405,"_2865":51499},[],"Content after decoding its Base64",{"_3379":1062,"_29619":1023,"_20556":51501,"_5":14099,"_26939":51405,"_2865":51502},[],"`application/pkcs8`",{"_3379":1063,"_29619":1023,"_20556":51504,"_5":14099,"_26939":51405,"_2865":51505},[],"Unencrypted DER PKCS#8 private key.",{"_3379":1064,"_29619":1023,"_20556":51507,"_5":14099,"_26939":51405,"_2865":51508},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3379":1065,"_29619":1023,"_20556":51510,"_5":14099,"_26939":51405,"_2865":51511},[],"DER PKCS#7 containing the issued certificate.",{"_3379":1066,"_29619":1023,"_20556":51513,"_5":14099,"_26939":51405,"_2865":51514},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3379":1067,"_29619":1023,"_20556":51516,"_5":14099,"_26939":51409,"_2865":51517},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3379":1068,"_29619":1023,"_20556":51519,"_5":14099,"_26939":51409,"_2865":51520},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3379":1069,"_29619":1023,"_20556":51522,"_5":14099,"_26939":51409,"_2865":51523},[],"Convert and check the result:",{"_3379":1070,"_29619":1023,"_20556":51525,"_5":14099,"_26939":51409,"_2865":51526},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3379":1071,"_29619":1023,"_20556":51528,"_5":14099,"_26939":51413,"_2865":51529},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3379":1072,"_29619":1023,"_20556":51531,"_5":14099,"_26939":51413,"_2865":51532},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3379":1073,"_29619":1073,"_5":14457,"_2865":50851,"_29951":51534,"_20556":51535,"_26939":1073},[48191,49659,50670,50668,50851],[],{"_3379":1074,"_29619":1073,"_20556":51537,"_5":14099,"_26939":1073,"_2865":51538},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3379":1075,"_29619":1073,"_5":29948,"_20556":51540,"_26939":51541,"_2865":51542},[],"/docs/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3379":1076,"_29619":1073,"_5":29948,"_20556":51544,"_26939":51545,"_2865":51546},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3379":1077,"_29619":1073,"_5":29948,"_20556":51548,"_26939":51549,"_2865":51550},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3379":1078,"_29619":1073,"_5":29948,"_20556":51552,"_26939":51553,"_2865":51554},[],"/docs/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3379":1079,"_29619":1073,"_20556":51556,"_5":14099,"_26939":1073,"_2865":51557},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3379":1080,"_29619":1073,"_20556":51559,"_5":14099,"_26939":51541,"_2865":51560},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3379":1081,"_29619":1073,"_20556":51562,"_5":14099,"_26939":51541,"_2865":51563},[],"The integrator installs initial EST server trust and an admission credential.",{"_3379":1082,"_29619":1073,"_20556":51565,"_5":14099,"_26939":51541,"_2865":51566},[],"The client requests an identity for its `Device ID` through EST.",{"_3379":1083,"_29619":1073,"_20556":51568,"_5":14099,"_26939":51541,"_2865":51569},[],"Certificate, device binding and key/certificate installation are checked.",{"_3379":1084,"_29619":1073,"_20556":51571,"_5":14099,"_26939":51541,"_2865":51572},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3379":1085,"_29619":1073,"_20556":51574,"_5":14099,"_26939":51541,"_2865":51575},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3379":1086,"_29619":1073,"_20556":51577,"_5":14099,"_26939":51545,"_2865":51578},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3379":1087,"_29619":1073,"_20556":51580,"_5":14099,"_26939":51545,"_2865":51581},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3379":1088,"_29619":1073,"_20556":51583,"_5":14099,"_26939":51545,"_2865":51584},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3379":1089,"_29619":1073,"_20556":51586,"_5":14099,"_26939":51545,"_2865":51587},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3379":1090,"_29619":1073,"_20556":51589,"_5":14099,"_26939":51549,"_2865":51590},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3379":1091,"_29619":1073,"_20556":51592,"_5":14099,"_26939":51549,"_2865":51593},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3379":1092,"_29619":1073,"_20556":51595,"_5":14099,"_26939":51549,"_2865":51596},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3379":1093,"_29619":1073,"_20556":51598,"_5":14099,"_26939":51549,"_2865":51599},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3379":1094,"_29619":1073,"_20556":51601,"_5":14099,"_26939":51553,"_2865":51602},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3379":1095,"_29619":1073,"_20556":51604,"_5":14099,"_26939":51553,"_2865":51605},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3379":1096,"_29619":1096,"_5":14457,"_2865":51607,"_29951":51608,"_20556":51609,"_26939":1096},"Provisioning strategies",[48191,49659,50670,50668,50851],[],{"_3379":1097,"_29619":1096,"_20556":51611,"_5":14099,"_26939":1096,"_2865":51612},[],"Choose device registration, identity authorization and key generation.",{"_3379":1098,"_29619":1096,"_5":29948,"_20556":51614,"_26939":51615,"_2865":51616},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3379":1099,"_29619":1096,"_5":29948,"_20556":51618,"_26939":51619,"_2865":51620},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3379":1100,"_29619":1096,"_5":29948,"_20556":51622,"_26939":51623,"_2865":51624},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3379":1101,"_29619":1096,"_5":29948,"_20556":51626,"_26939":51627,"_2865":51628},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3379":1102,"_29619":1096,"_5":29948,"_20556":51630,"_26939":51631,"_2865":51632},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3379":1103,"_29619":1096,"_20556":51634,"_5":14099,"_26939":1096,"_2865":51635},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3379":1104,"_29619":1096,"_20556":51637,"_5":14099,"_26939":51615,"_2865":51638},[],"Path",{"_3379":1105,"_29619":1096,"_20556":51640,"_5":14099,"_26939":51615,"_2865":51641},[],"When the device exists",{"_3379":1106,"_29619":1096,"_20556":51643,"_5":14099,"_26939":51615,"_2865":51644},[],"What to check",{"_3379":1107,"_29619":1096,"_20556":51646,"_5":14099,"_26939":51615,"_2865":51647},[],"Manual assignment",{"_3379":1108,"_29619":1096,"_20556":51649,"_5":14099,"_26939":51615,"_2865":51650},[],"An operator creates it before associating a certificate.",{"_3379":1109,"_29619":1096,"_20556":51652,"_5":14099,"_26939":51615,"_2865":51653},[],"ID, owning DMS, certificate CN and bound serial.",{"_3379":1110,"_29619":1096,"_20556":51655,"_5":14099,"_26939":51615,"_2865":51656},[],"EST with `JITP`",{"_3379":1111,"_29619":1096,"_20556":51658,"_5":14099,"_26939":51615,"_2865":51659},[],"Created for an unknown CN during `/simpleenroll`.",{"_3379":1112,"_29619":1096,"_20556":51661,"_5":14099,"_26939":51615,"_2865":51662},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3379":1113,"_29619":1096,"_20556":51664,"_5":14099,"_26939":51615,"_2865":51665},[],"EST with `PRE_REGISTRATION`",{"_3379":1114,"_29619":1096,"_20556":51667,"_5":14099,"_26939":51615,"_2865":51668},[],"Must exist before `/simpleenroll`.",{"_3379":1115,"_29619":1096,"_20556":51670,"_5":14099,"_26939":51615,"_2865":51671},[],"Approved record, same DMS and replacement conditions for your version.",{"_3379":1116,"_29619":1096,"_20556":51673,"_5":14099,"_26939":51615,"_2865":51674},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3379":1117,"_29619":1096,"_20556":51676,"_5":14099,"_26939":51615,"_2865":51677},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3379":1118,"_29619":1096,"_20556":51679,"_5":14099,"_26939":51619,"_2865":51680},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3379":1119,"_29619":1096,"_20556":51682,"_5":14099,"_26939":51619,"_2865":51683},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3379":1120,"_29619":1096,"_20556":51685,"_5":14099,"_26939":51619,"_2865":51686},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3379":1121,"_29619":1096,"_20556":51688,"_5":14099,"_26939":51623,"_2865":51689},[],"Decide initial enrollment and re-enrollment separately:",{"_3379":1122,"_29619":1096,"_20556":51691,"_5":14099,"_26939":51623,"_2865":51692},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3379":1123,"_29619":1096,"_20556":51694,"_5":14099,"_26939":51623,"_2865":51695},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3379":1124,"_29619":1096,"_20556":51697,"_5":14099,"_26939":51623,"_2865":51698},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3379":1125,"_29619":1096,"_20556":51700,"_5":14099,"_26939":51623,"_2865":51701},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3379":1126,"_29619":1096,"_20556":51703,"_5":14099,"_26939":51623,"_2865":51704},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3379":1127,"_29619":1096,"_20556":51706,"_5":14099,"_26939":51627,"_2865":48575},[],{"_3379":1128,"_29619":1096,"_20556":51708,"_5":14099,"_26939":51627,"_2865":51709},[],"Material crossing EST",{"_3379":1129,"_29619":1096,"_20556":51711,"_5":14099,"_26939":51627,"_2865":51712},[],"Device-generated key",{"_3379":1130,"_29619":1096,"_20556":51714,"_5":14099,"_26939":51627,"_2865":51715},[],"Public CSR and certificate; the key stays on the client.",{"_3379":1131,"_29619":1096,"_20556":51717,"_5":14099,"_26939":51627,"_2865":51718},[],"Existing device key",{"_3379":1132,"_29619":1096,"_20556":51720,"_5":14099,"_26939":51627,"_2865":51721},[],"CSR signed with that key and a new certificate.",{"_3379":1133,"_29619":1096,"_20556":51723,"_5":14099,"_26939":51627,"_2865":50989},[],{"_3379":1134,"_29619":1096,"_20556":51725,"_5":14099,"_26939":51627,"_2865":51726},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3379":1135,"_29619":1096,"_20556":51728,"_5":14099,"_26939":51627,"_2865":51729},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3379":1136,"_29619":1096,"_20556":51731,"_5":14099,"_26939":51631,"_2865":51732},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3379":1137,"_29619":1137,"_5":14457,"_2865":51734,"_29951":51735,"_20556":51736,"_26939":1137},"Renewal and recovery",[48191,49659,50670,50668,50851],[],{"_3379":1138,"_29619":1137,"_20556":51738,"_5":14099,"_26939":1137,"_2865":51739},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3379":1139,"_29619":1137,"_5":29948,"_20556":51741,"_26939":51742,"_2865":51743},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3379":1140,"_29619":1137,"_5":29948,"_20556":51745,"_26939":51746,"_2865":51747},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3379":1141,"_29619":1137,"_5":29948,"_20556":51749,"_26939":51750,"_2865":51751},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3379":1142,"_29619":1137,"_5":29948,"_20556":51753,"_26939":51754,"_2865":51755},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3379":1143,"_29619":1137,"_5":29948,"_20556":51757,"_26939":51758,"_2865":51759},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3379":1144,"_29619":1137,"_20556":51761,"_5":14099,"_26939":1137,"_2865":51762},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3379":1145,"_29619":1137,"_20556":51764,"_5":14099,"_26939":51742,"_2865":51765},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3379":1146,"_29619":1137,"_20556":51767,"_5":14099,"_26939":51742,"_2865":51768},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3379":1147,"_29619":1137,"_20556":51770,"_5":14099,"_26939":51742,"_2865":51771},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3379":1148,"_29619":1137,"_20556":51773,"_5":14099,"_26939":51742,"_2865":51774},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3379":1149,"_29619":1137,"_20556":51776,"_5":14099,"_26939":51746,"_2865":51777},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3379":1150,"_29619":1137,"_20556":51779,"_5":14099,"_26939":51746,"_2865":51780},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3379":1151,"_29619":1137,"_20556":51782,"_5":14099,"_26939":51750,"_2865":51783},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3379":1152,"_29619":1137,"_20556":51785,"_5":14099,"_26939":51750,"_2865":51786},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3379":1153,"_29619":1137,"_20556":51788,"_5":14099,"_26939":51750,"_2865":51789},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3379":1154,"_29619":1137,"_20556":51791,"_5":14099,"_26939":51754,"_2865":51792},[],"Situation",{"_3379":1155,"_29619":1137,"_20556":51794,"_5":14099,"_26939":51754,"_2865":51795},[],"Procedure",{"_3379":1156,"_29619":1137,"_20556":51797,"_5":14099,"_26939":51754,"_2865":51798},[],"Valid certificate, outside the window",{"_3379":1157,"_29619":1137,"_20556":51800,"_5":14099,"_26939":51754,"_2865":51801},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3379":1158,"_29619":1137,"_20556":51803,"_5":14099,"_26939":51754,"_2865":51804},[],"Expired certificate, key available",{"_3379":1159,"_29619":1137,"_20556":51806,"_5":14099,"_26939":51754,"_2865":51807},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3379":1160,"_29619":1137,"_20556":51809,"_5":14099,"_26939":51754,"_2865":51810},[],"Renewal through webhook or `NO_AUTH`",{"_3379":1161,"_29619":1137,"_20556":51812,"_5":14099,"_26939":51754,"_2865":51813},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3379":1162,"_29619":1137,"_20556":51815,"_5":14099,"_26939":51754,"_2865":51816},[],"Lost or inaccessible key",{"_3379":1163,"_29619":1137,"_20556":51818,"_5":14099,"_26939":51754,"_2865":51819},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3379":1164,"_29619":1137,"_20556":51821,"_5":14099,"_26939":51754,"_2865":51822},[],"Current identity revoked",{"_3379":1165,"_29619":1137,"_20556":51824,"_5":14099,"_26939":51754,"_2865":51825},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3379":1166,"_29619":1137,"_20556":51827,"_5":14099,"_26939":51754,"_2865":51828},[],"Device without an identity",{"_3379":1167,"_29619":1137,"_20556":51830,"_5":14099,"_26939":51754,"_2865":51831},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3379":1168,"_29619":1137,"_20556":51833,"_5":14099,"_26939":51754,"_2865":51834},[],"Retired device",{"_3379":1169,"_29619":1137,"_20556":51836,"_5":14099,"_26939":51754,"_2865":51837},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3379":1170,"_29619":1137,"_20556":51839,"_5":14099,"_26939":51754,"_2865":51840},[],"Timeout, HTTP 500 or installation failure",{"_3379":1171,"_29619":1137,"_20556":51842,"_5":14099,"_26939":51754,"_2865":51843},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3379":1172,"_29619":1137,"_20556":51845,"_5":14099,"_26939":51758,"_2865":51846},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3379":1173,"_29619":1137,"_20556":51848,"_5":14099,"_26939":51758,"_2865":51849},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3379":1174,"_29619":1174,"_5":14457,"_2865":51851,"_29951":51852,"_20556":51853,"_26939":1174},"Enrollment troubleshooting",[48191,49659,50670,50668,50851],[],{"_3379":1175,"_29619":1174,"_20556":51855,"_5":14099,"_26939":1174,"_2865":51856},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3379":1176,"_29619":1174,"_5":29948,"_20556":51858,"_26939":51859,"_2865":51860},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3379":1177,"_29619":1174,"_5":29948,"_20556":51862,"_26939":51863,"_2865":51864},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3379":1178,"_29619":1174,"_5":29948,"_20556":51866,"_26939":51867,"_2865":51414},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3379":1179,"_29619":1174,"_5":29948,"_20556":51869,"_26939":51870,"_2865":51871},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3379":1180,"_29619":1174,"_20556":51873,"_5":14099,"_26939":1174,"_2865":51874},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3379":1181,"_29619":1174,"_20556":51876,"_5":14099,"_26939":51863,"_2865":51877},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3379":1182,"_29619":1174,"_20556":51879,"_5":14099,"_26939":51863,"_2865":51880},[],"Symptom or message",{"_3379":1183,"_29619":1174,"_20556":51882,"_5":14099,"_26939":51863,"_2865":51644},[],{"_3379":1184,"_29619":1174,"_20556":51884,"_5":14099,"_26939":51863,"_2865":51885},[],"curl rejects TLS, name or issuer",{"_3379":1185,"_29619":1174,"_20556":51887,"_5":14099,"_26939":51863,"_2865":51888},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3379":1186,"_29619":1174,"_20556":51890,"_5":14099,"_26939":51863,"_2865":51891},[],"404 or missing APS",{"_3379":1187,"_29619":1174,"_20556":51893,"_5":14099,"_26939":51863,"_2865":51894},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3379":1188,"_29619":1174,"_20556":51896,"_5":14099,"_26939":51863,"_2865":51897},[],"400, CSR or format error",{"_3379":1189,"_29619":1174,"_20556":51899,"_5":14099,"_26939":51863,"_2865":51900},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3379":1190,"_29619":1174,"_20556":51902,"_5":14099,"_26939":51863,"_2865":51903},[],"Missing credential or invalid certificate",{"_3379":1191,"_29619":1174,"_20556":51905,"_5":14099,"_26939":51863,"_2865":51906},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3379":1192,"_29619":1174,"_20556":51908,"_5":14099,"_26939":51863,"_2865":51909},[],"Webhook denies, times out or responds without authorization",{"_3379":1193,"_29619":1174,"_20556":51911,"_5":14099,"_26939":51863,"_2865":51912},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3379":1194,"_29619":1174,"_20556":51914,"_5":14099,"_26939":51863,"_2865":51915},[],"`unexpected status code: <n>: redirects are not followed`",{"_3379":1195,"_29619":1174,"_20556":51917,"_5":14099,"_26939":51863,"_2865":51918},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3379":1196,"_29619":1174,"_20556":51920,"_5":14099,"_26939":51863,"_2865":51921},[],"`webhook response exceeds 1048576 bytes`",{"_3379":1197,"_29619":1174,"_20556":51923,"_5":14099,"_26939":51863,"_2865":51924},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3379":1198,"_29619":1174,"_20556":51926,"_5":14099,"_26939":51863,"_2865":51927},[],"`webhook config must not reference files`",{"_3379":1199,"_29619":1174,"_20556":51929,"_5":14099,"_26939":51863,"_2865":51930},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3379":1200,"_29619":1174,"_20556":51932,"_5":14099,"_26939":51863,"_2865":51933},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3379":1201,"_29619":1174,"_20556":51935,"_5":14099,"_26939":51863,"_2865":51936},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3379":1202,"_29619":1174,"_20556":51938,"_5":14099,"_26939":51863,"_2865":51939},[],"`webhook mTLS certificate and key are invalid: …`",{"_3379":1203,"_29619":1174,"_20556":51941,"_5":14099,"_26939":51863,"_2865":51942},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3379":1204,"_29619":1174,"_20556":51944,"_5":14099,"_26939":51863,"_2865":51945},[],"400 `struct validation error` creating or updating a DMS",{"_3379":1205,"_29619":1174,"_20556":51947,"_5":14099,"_26939":51863,"_2865":51948},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3379":1206,"_29619":1174,"_20556":51950,"_5":14099,"_26939":51863,"_2865":51951},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3379":1207,"_29619":1174,"_20556":51953,"_5":14099,"_26939":51863,"_2865":51954},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3379":1208,"_29619":1174,"_20556":51956,"_5":14099,"_26939":51863,"_2865":51957},[],"`device not preregistered`",{"_3379":1209,"_29619":1174,"_20556":51959,"_5":14099,"_26939":51863,"_2865":51960},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3379":1210,"_29619":1174,"_20556":51962,"_5":14099,"_26939":51863,"_2865":51963},[],"`forbiddenNewEnrollment`",{"_3379":1211,"_29619":1174,"_20556":51965,"_5":14099,"_26939":51863,"_2865":51966},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3379":1212,"_29619":1174,"_20556":51968,"_5":14099,"_26939":51863,"_2865":51969},[],"Different owning DMS",{"_3379":1213,"_29619":1174,"_20556":51971,"_5":14099,"_26939":51863,"_2865":51972},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3379":1214,"_29619":1174,"_20556":51974,"_5":14099,"_26939":51863,"_2865":51975},[],"`invalid RawSubject bytes`",{"_3379":1215,"_29619":1174,"_20556":51977,"_5":14099,"_26939":51863,"_2865":51978},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3379":1216,"_29619":1174,"_20556":51980,"_5":14099,"_26939":51863,"_2865":51981},[],"`invalid reenroll window`",{"_3379":1217,"_29619":1174,"_20556":51983,"_5":14099,"_26939":51863,"_2865":51984},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3379":1218,"_29619":1174,"_20556":51986,"_5":14099,"_26939":51863,"_2865":51987},[],"Current certificate revoked",{"_3379":1219,"_29619":1174,"_20556":51989,"_5":14099,"_26939":51863,"_2865":51990},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3379":1220,"_29619":1174,"_20556":51992,"_5":14099,"_26939":51863,"_2865":51993},[],"CA, profile or signing error",{"_3379":1221,"_29619":1174,"_20556":51995,"_5":14099,"_26939":51863,"_2865":51996},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3379":1222,"_29619":1174,"_20556":51998,"_5":14099,"_26939":51863,"_2865":51999},[],"HTTP 200 without a device connection",{"_3379":1223,"_29619":1174,"_20556":52001,"_5":14099,"_26939":51863,"_2865":52002},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3379":1224,"_29619":1174,"_20556":52004,"_5":14099,"_26939":51863,"_2865":52005},[],"Timeout or error after issuance",{"_3379":1225,"_29619":1174,"_20556":52007,"_5":14099,"_26939":51863,"_2865":52008},[],"New certificates, current slot and previous identity's state before retrying.",{"_3379":1226,"_29619":1174,"_20556":52010,"_5":14099,"_26939":51867,"_2865":52011},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3379":1227,"_29619":1174,"_20556":52013,"_5":14099,"_26939":51867,"_2865":52014},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3379":1228,"_29619":1174,"_20556":52016,"_5":14099,"_26939":51870,"_2865":52017},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3379":1229,"_29619":1174,"_20556":52019,"_5":14099,"_26939":51870,"_2865":52020},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3379":1230,"_29619":1174,"_20556":52022,"_5":14099,"_26939":51870,"_2865":52023},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3379":1231,"_29619":1174,"_20556":52025,"_5":14099,"_26939":51870,"_2865":52026},[],"Make one request, save headers/body and query the device and certificates.",{"_3379":1232,"_29619":1174,"_20556":52028,"_5":14099,"_26939":51870,"_2865":52029},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3379":1233,"_29619":1174,"_20556":52031,"_5":14099,"_26939":51870,"_2865":52032},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3379":1234,"_29619":1174,"_20556":52034,"_5":14099,"_26939":51870,"_2865":52035},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3379":1235,"_29619":1235,"_5":14457,"_2865":52037,"_29951":52038,"_20556":52039,"_26939":1235},"Trust distribution and updates",[48191,49659,50670,50668,50851],[],{"_3379":1236,"_29619":1235,"_20556":52041,"_5":14099,"_26939":1235,"_2865":52042},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3379":1237,"_29619":1235,"_5":29948,"_20556":52044,"_26939":52045,"_2865":52046},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3379":1238,"_29619":1235,"_5":29948,"_20556":52048,"_26939":52049,"_2865":52050},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3379":1239,"_29619":1235,"_5":29948,"_20556":52052,"_26939":52053,"_2865":52054},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3379":1240,"_29619":1235,"_5":29948,"_20556":52056,"_26939":52057,"_2865":52058},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3379":1241,"_29619":1235,"_5":29948,"_20556":52060,"_26939":52061,"_2865":52062},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3379":1242,"_29619":1235,"_20556":52064,"_5":14099,"_26939":1235,"_2865":52065},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3379":1243,"_29619":1235,"_20556":52067,"_5":14099,"_26939":52045,"_2865":52068},[],"Relationship",{"_3379":1244,"_29619":1235,"_20556":52070,"_5":14099,"_26939":52045,"_2865":52071},[],"Material prepared by its owner",{"_3379":1245,"_29619":1235,"_20556":52073,"_5":14099,"_26939":52045,"_2865":52074},[],"Device → EST server",{"_3379":1246,"_29619":1235,"_20556":52076,"_5":14099,"_26939":52045,"_2865":52077},[],"Previously verified server root, chain or pin and TLS name.",{"_3379":1247,"_29619":1235,"_20556":52079,"_5":14099,"_26939":52045,"_2865":52080},[],"DMS → requester",{"_3379":1248,"_29619":1235,"_20556":52082,"_5":14099,"_26939":52045,"_2865":52083},[],"CAs and rules authorizing initial or renewal credentials.",{"_3379":1249,"_29619":1235,"_20556":52085,"_5":14099,"_26939":52045,"_2865":52086},[],"Consumer → device",{"_3379":1250,"_29619":1235,"_20556":52088,"_5":14099,"_26939":52045,"_2865":52089},[],"Operational identity roots, intermediates, validation and permissions.",{"_3379":1251,"_29619":1235,"_20556":52091,"_5":14099,"_26939":52045,"_2865":52092},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3379":1252,"_29619":1235,"_20556":52094,"_5":14099,"_26939":52049,"_2865":52095},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3379":1253,"_29619":1235,"_20556":52097,"_5":14099,"_26939":52049,"_2865":52098},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3379":1254,"_29619":1235,"_20556":52100,"_5":14099,"_26939":52053,"_2865":52101},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3379":1255,"_29619":1235,"_20556":52103,"_5":14099,"_26939":52053,"_2865":52104},[],"Select policy-approved roots as anchors.",{"_3379":1256,"_29619":1235,"_20556":52106,"_5":14099,"_26939":52053,"_2865":52107},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3379":1257,"_29619":1235,"_20556":52109,"_5":14099,"_26939":52053,"_2865":52110},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3379":1258,"_29619":1235,"_20556":52112,"_5":14099,"_26939":52053,"_2865":52113},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3379":1259,"_29619":1235,"_20556":52115,"_5":14099,"_26939":52053,"_2865":52116},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3379":1260,"_29619":1235,"_20556":52118,"_5":14099,"_26939":52057,"_2865":52119},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3379":1261,"_29619":1235,"_20556":52121,"_5":14099,"_26939":52057,"_2865":52122},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3379":1262,"_29619":1235,"_20556":52124,"_5":14099,"_26939":52057,"_2865":52125},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3379":1263,"_29619":1235,"_20556":52127,"_5":14099,"_26939":52061,"_2865":52128},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3379":1264,"_29619":1264,"_5":14457,"_2865":52130,"_29951":52131,"_20556":52133,"_26939":1264},"AWS IoT Core",[48191,49659,50670,50668,52132],"Integrations",[],{"_3379":1265,"_29619":1264,"_20556":52135,"_5":14099,"_26939":1264,"_2865":52136},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3379":1266,"_29619":1264,"_5":29948,"_20556":52138,"_26939":52139,"_2865":52140},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3379":1267,"_29619":1264,"_5":29948,"_20556":52142,"_26939":52143,"_2865":52144},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3379":1268,"_29619":1264,"_5":29948,"_20556":52146,"_26939":52147,"_2865":52148},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3379":1269,"_29619":1264,"_5":29948,"_20556":52150,"_26939":52151,"_2865":52152},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3379":1270,"_29619":1264,"_5":29948,"_20556":52154,"_26939":52155,"_2865":52156},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3379":1271,"_29619":1264,"_5":29948,"_20556":52158,"_26939":52159,"_2865":52160},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3379":1272,"_29619":1264,"_5":29948,"_20556":52162,"_26939":52163,"_2865":52164},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3379":1273,"_29619":1264,"_5":29948,"_20556":52166,"_26939":52167,"_2865":52168},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3379":1274,"_29619":1264,"_5":29948,"_20556":52170,"_26939":52171,"_2865":52172},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3379":1275,"_29619":1264,"_5":29948,"_20556":52174,"_26939":52175,"_2865":52176},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3379":1276,"_29619":1264,"_5":29948,"_20556":52178,"_26939":52179,"_2865":52180},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3379":1277,"_29619":1264,"_5":29948,"_20556":52182,"_26939":52183,"_2865":52184},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3379":1278,"_29619":1264,"_5":29948,"_20556":52186,"_26939":52187,"_2865":52188},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3379":1279,"_29619":1264,"_5":29948,"_20556":52190,"_26939":52191,"_2865":52192},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3379":1280,"_29619":1264,"_5":29948,"_20556":52194,"_26939":52195,"_2865":52196},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3379":1281,"_29619":1264,"_5":29948,"_20556":52198,"_26939":52199,"_2865":52200},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3379":1282,"_29619":1264,"_5":29948,"_20556":52202,"_26939":52203,"_2865":52204},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3379":1283,"_29619":1264,"_5":29948,"_20556":52206,"_26939":52207,"_2865":52208},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3379":1284,"_29619":1264,"_5":29948,"_20556":52210,"_26939":52211,"_2865":52212},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3379":1285,"_29619":1264,"_5":29948,"_20556":52214,"_26939":52215,"_2865":52216},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3379":1286,"_29619":1264,"_5":29948,"_20556":52218,"_26939":52219,"_2865":52220},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3379":1287,"_29619":1264,"_5":29948,"_20556":52222,"_26939":52223,"_2865":52224},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3379":1288,"_29619":1264,"_5":29948,"_20556":52226,"_26939":52227,"_2865":52228},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3379":1289,"_29619":1264,"_5":29948,"_20556":52230,"_26939":52231,"_2865":52232},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3379":1290,"_29619":1264,"_5":29948,"_20556":52234,"_26939":52235,"_2865":52236},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3379":1291,"_29619":1264,"_20556":52238,"_5":14099,"_26939":1264,"_2865":52239},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3379":1292,"_29619":1264,"_20556":52241,"_5":14099,"_26939":1264,"_2865":52242},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3379":1293,"_29619":1264,"_20556":52244,"_5":14099,"_26939":1264,"_2865":52245},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3379":1294,"_29619":1264,"_20556":52247,"_5":14099,"_26939":52139,"_2865":52248},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3379":1295,"_29619":1264,"_20556":52250,"_5":14099,"_26939":52139,"_2865":52251},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3379":1296,"_29619":1264,"_20556":52253,"_5":14099,"_26939":52139,"_2865":52254},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3379":1297,"_29619":1264,"_20556":52256,"_5":14099,"_26939":52139,"_2865":52257},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3379":1298,"_29619":1264,"_20556":52259,"_5":14099,"_26939":52143,"_2865":52260},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3379":1299,"_29619":1264,"_20556":52262,"_5":14099,"_26939":52147,"_2865":52263},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3379":1300,"_29619":1264,"_20556":52265,"_5":14099,"_26939":52147,"_2865":52266},[],"IAM action",{"_3379":1301,"_29619":1264,"_20556":52268,"_5":14099,"_26939":52147,"_2865":48581},[],{"_3379":1302,"_29619":1264,"_20556":52270,"_5":14099,"_26939":52147,"_2865":52271},[],"`iot:GetRegistrationCode`",{"_3379":1303,"_29619":1264,"_20556":52273,"_5":14099,"_26939":52147,"_2865":52274},[],"Obtain the verification code for CA registration in the Primary Account",{"_3379":1304,"_29619":1264,"_20556":52276,"_5":14099,"_26939":52147,"_2865":52277},[],"`iot:RegisterCACertificate`",{"_3379":1305,"_29619":1264,"_20556":52279,"_5":14099,"_26939":52147,"_2865":52280},[],"Register the CA in AWS IoT",{"_3379":1306,"_29619":1264,"_20556":52282,"_5":14099,"_26939":52147,"_2865":52283},[],"`iot:DescribeCACertificate`",{"_3379":1307,"_29619":1264,"_20556":52285,"_5":14099,"_26939":52147,"_2865":52286},[],"Check the CA registration status",{"_3379":1308,"_29619":1264,"_20556":52288,"_5":14099,"_26939":52147,"_2865":52289},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3379":1309,"_29619":1264,"_20556":52291,"_5":14099,"_26939":52147,"_2865":52292},[],"Create or update Things in IoT Core",{"_3379":1310,"_29619":1264,"_20556":52294,"_5":14099,"_26939":52147,"_2865":52295},[],"`iot:RegisterThing`",{"_3379":1311,"_29619":1264,"_20556":52297,"_5":14099,"_26939":52147,"_2865":52298},[],"Provision Things through a template",{"_3379":1312,"_29619":1264,"_20556":52300,"_5":14099,"_26939":52147,"_2865":52301},[],"`iot:RegisterCertificate`",{"_3379":1313,"_29619":1264,"_20556":52303,"_5":14099,"_26939":52147,"_2865":52304},[],"Register device certificates",{"_3379":1314,"_29619":1264,"_20556":52306,"_5":14099,"_26939":52147,"_2865":52307},[],"`iot:UpdateCertificate`",{"_3379":1315,"_29619":1264,"_20556":52309,"_5":14099,"_26939":52147,"_2865":52310},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3379":1316,"_29619":1264,"_20556":52312,"_5":14099,"_26939":52147,"_2865":52313},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3379":1317,"_29619":1264,"_20556":52315,"_5":14099,"_26939":52147,"_2865":52316},[],"Create and attach IoT policies",{"_3379":1318,"_29619":1264,"_20556":52318,"_5":14099,"_26939":52147,"_2865":52319},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3379":1319,"_29619":1264,"_20556":52321,"_5":14099,"_26939":52147,"_2865":52322},[],"Manage Thing groups",{"_3379":1320,"_29619":1264,"_20556":52324,"_5":14099,"_26939":52147,"_2865":52325},[],"`iot:CreateProvisioningTemplate`",{"_3379":1321,"_29619":1264,"_20556":52327,"_5":14099,"_26939":52147,"_2865":52328},[],"Create JITP templates",{"_3379":1322,"_29619":1264,"_20556":52330,"_5":14099,"_26939":52147,"_2865":52331},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3379":1323,"_29619":1264,"_20556":52333,"_5":14099,"_26939":52147,"_2865":52334},[],"Read and write the Device Shadow",{"_3379":1324,"_29619":1264,"_20556":52336,"_5":14099,"_26939":52147,"_2865":52337},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3379":1325,"_29619":1264,"_20556":52339,"_5":14099,"_26939":52151,"_2865":52340},[],"Parameter",{"_3379":1326,"_29619":1264,"_20556":52342,"_5":14099,"_26939":52151,"_2865":52343},[],"Type",{"_3379":1327,"_29619":1264,"_20556":52345,"_5":14099,"_26939":52151,"_2865":52346},[],"Required",{"_3379":1328,"_29619":1264,"_20556":52348,"_5":14099,"_26939":52151,"_2865":52349},[],"Description",{"_3379":1329,"_29619":1264,"_20556":52351,"_5":14099,"_26939":52151,"_2865":52352},[],"`connector_id`",{"_3379":1330,"_29619":1264,"_20556":52354,"_5":14099,"_26939":52151,"_2865":24560},[],{"_3379":1331,"_29619":1264,"_20556":52356,"_5":14099,"_26939":52151,"_2865":52357},[],"Yes",{"_3379":1332,"_29619":1264,"_20556":52359,"_5":14099,"_26939":52151,"_2865":52360},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3379":1333,"_29619":1264,"_20556":52362,"_5":14099,"_26939":52151,"_2865":52363},[],"`aws_config.region`",{"_3379":1334,"_29619":1264,"_20556":52365,"_5":14099,"_26939":52151,"_2865":24560},[],{"_3379":1335,"_29619":1264,"_20556":52367,"_5":14099,"_26939":52151,"_2865":52357},[],{"_3379":1336,"_29619":1264,"_20556":52369,"_5":14099,"_26939":52151,"_2865":52370},[],"AWS region where the connector operates.",{"_3379":1337,"_29619":1264,"_20556":52372,"_5":14099,"_26939":52151,"_2865":52373},[],"`aws_config.auth_method`",{"_3379":1338,"_29619":1264,"_20556":52375,"_5":14099,"_26939":52151,"_2865":24560},[],{"_3379":1339,"_29619":1264,"_20556":52377,"_5":14099,"_26939":52151,"_2865":52357},[],{"_3379":1340,"_29619":1264,"_20556":52379,"_5":14099,"_26939":52151,"_2865":52380},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3379":1341,"_29619":1264,"_20556":52382,"_5":14099,"_26939":52151,"_2865":52383},[],"`aws_config.access_key_id`",{"_3379":1342,"_29619":1264,"_20556":52385,"_5":14099,"_26939":52151,"_2865":24560},[],{"_3379":1343,"_29619":1264,"_20556":52387,"_5":14099,"_26939":52151,"_2865":52388},[],"Only with `auth_method=static`",{"_3379":1344,"_29619":1264,"_20556":52390,"_5":14099,"_26939":52151,"_2865":52391},[],"AWS access key.",{"_3379":1345,"_29619":1264,"_20556":52393,"_5":14099,"_26939":52151,"_2865":52394},[],"`aws_config.secret_access_key`",{"_3379":1346,"_29619":1264,"_20556":52396,"_5":14099,"_26939":52151,"_2865":24560},[],{"_3379":1347,"_29619":1264,"_20556":52398,"_5":14099,"_26939":52151,"_2865":52388},[],{"_3379":1348,"_29619":1264,"_20556":52400,"_5":14099,"_26939":52151,"_2865":52401},[],"AWS secret key.",{"_3379":1349,"_29619":1264,"_20556":52403,"_5":14099,"_26939":52151,"_2865":52404},[],"`aws_config.session_token`",{"_3379":1350,"_29619":1264,"_20556":52406,"_5":14099,"_26939":52151,"_2865":24560},[],{"_3379":1351,"_29619":1264,"_20556":52408,"_5":14099,"_26939":52151,"_2865":52409},[],"No",{"_3379":1352,"_29619":1264,"_20556":52411,"_5":14099,"_26939":52151,"_2865":52412},[],"Session token (with `auth_method=static`).",{"_3379":1353,"_29619":1264,"_20556":52414,"_5":14099,"_26939":52151,"_2865":52415},[],"`aws_config.role_arn`",{"_3379":1354,"_29619":1264,"_20556":52417,"_5":14099,"_26939":52151,"_2865":24560},[],{"_3379":1355,"_29619":1264,"_20556":52419,"_5":14099,"_26939":52151,"_2865":52420},[],"Only with `auth_method=role`",{"_3379":1356,"_29619":1264,"_20556":52422,"_5":14099,"_26939":52151,"_2865":52423},[],"ARN of the role to assume.",{"_3379":1357,"_29619":1264,"_20556":52425,"_5":14099,"_26939":52151,"_2865":52426},[],"`aws_config.endpoint_url`",{"_3379":1358,"_29619":1264,"_20556":52428,"_5":14099,"_26939":52151,"_2865":24560},[],{"_3379":1359,"_29619":1264,"_20556":52430,"_5":14099,"_26939":52151,"_2865":52409},[],{"_3379":1360,"_29619":1264,"_20556":52432,"_5":14099,"_26939":52151,"_2865":52433},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3379":1361,"_29619":1264,"_20556":52435,"_5":14099,"_26939":52151,"_2865":52436},[],"`subscriber_event_bus`",{"_3379":1362,"_29619":1264,"_20556":52438,"_5":14099,"_26939":52151,"_2865":17301},[],{"_3379":1363,"_29619":1264,"_20556":52440,"_5":14099,"_26939":52151,"_2865":52357},[],{"_3379":1364,"_29619":1264,"_20556":52442,"_5":14099,"_26939":52151,"_2865":52443},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3379":1365,"_29619":1264,"_20556":52445,"_5":14099,"_26939":52151,"_2865":52446},[],"`dms_manager_client`",{"_3379":1366,"_29619":1264,"_20556":52448,"_5":14099,"_26939":52151,"_2865":24560},[],{"_3379":1367,"_29619":1264,"_20556":52450,"_5":14099,"_26939":52151,"_2865":52357},[],{"_3379":1368,"_29619":1264,"_20556":52452,"_5":14099,"_26939":52151,"_2865":52453},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3379":1369,"_29619":1264,"_20556":52455,"_5":14099,"_26939":52151,"_2865":52456},[],"`device_manager_client`",{"_3379":1370,"_29619":1264,"_20556":52458,"_5":14099,"_26939":52151,"_2865":24560},[],{"_3379":1371,"_29619":1264,"_20556":52460,"_5":14099,"_26939":52151,"_2865":52357},[],{"_3379":1372,"_29619":1264,"_20556":52462,"_5":14099,"_26939":52151,"_2865":52463},[],"HTTP URL of Lamassu's Device Manager.",{"_3379":1373,"_29619":1264,"_20556":52465,"_5":14099,"_26939":52151,"_2865":52466},[],"`ca_client`",{"_3379":1374,"_29619":1264,"_20556":52468,"_5":14099,"_26939":52151,"_2865":24560},[],{"_3379":1375,"_29619":1264,"_20556":52470,"_5":14099,"_26939":52151,"_2865":52357},[],{"_3379":1376,"_29619":1264,"_20556":52472,"_5":14099,"_26939":52151,"_2865":52473},[],"HTTP URL of Lamassu's CA service.",{"_3379":1377,"_29619":1264,"_20556":52475,"_5":14099,"_26939":52155,"_2865":52476},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3379":1378,"_29619":1264,"_20556":52478,"_5":14099,"_26939":52155,"_2865":52479},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3379":1379,"_29619":1264,"_20556":52481,"_5":14099,"_26939":52155,"_2865":52482},[],"CloudEvent type",{"_3379":1380,"_29619":1264,"_20556":52484,"_5":14099,"_26939":52155,"_2865":52485},[],"Lamassu resource",{"_3379":1381,"_29619":1264,"_20556":52487,"_5":14099,"_26939":52155,"_2865":52488},[],"AWS Resource",{"_3379":1382,"_29619":1264,"_20556":52490,"_5":14099,"_26939":52155,"_2865":52491},[],"IAM actions",{"_3379":1383,"_29619":1264,"_20556":52493,"_5":14099,"_26939":52155,"_2865":52494},[],"AWS calls and effect",{"_3379":1384,"_29619":1264,"_20556":52496,"_5":14099,"_26939":52155,"_2865":52497},[],"Where in this page",{"_3379":1385,"_29619":1264,"_20556":52499,"_5":14099,"_26939":52155,"_2865":52500},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3379":1386,"_29619":1264,"_20556":52502,"_5":14099,"_26939":52155,"_2865":52503},[],"CA",{"_3379":1387,"_29619":1264,"_20556":52505,"_5":14099,"_26939":52155,"_2865":52506},[],"`IoTCore/CACertificate`",{"_3379":1388,"_29619":1264,"_20556":52508,"_5":14099,"_26939":52155,"_2865":52509},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3379":1389,"_29619":1264,"_20556":52511,"_5":14099,"_26939":52155,"_2865":52512},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3379":1390,"_29619":1264,"_20556":52514,"_5":14099,"_26939":52155,"_2865":52168},[],{"_3379":1391,"_29619":1264,"_20556":52516,"_5":14099,"_26939":52155,"_2865":52517},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3379":1392,"_29619":1264,"_20556":52519,"_5":14099,"_26939":52155,"_2865":52520},[],"DMS",{"_3379":1393,"_29619":1264,"_20556":52522,"_5":14099,"_26939":52155,"_2865":52523},[],"`IoTCore/ProvisioningTemplate`",{"_3379":1394,"_29619":1264,"_20556":52525,"_5":14099,"_26939":52155,"_2865":52526},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3379":1395,"_29619":1264,"_20556":52528,"_5":14099,"_26939":52155,"_2865":52529},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3379":1396,"_29619":1264,"_20556":52531,"_5":14099,"_26939":52155,"_2865":52196},[],{"_3379":1397,"_29619":1264,"_20556":52533,"_5":14099,"_26939":52155,"_2865":52534},[],"`EventBindDeviceIdentityKey`",{"_3379":1398,"_29619":1264,"_20556":52536,"_5":14099,"_26939":52155,"_2865":52537},[],"Device",{"_3379":1399,"_29619":1264,"_20556":52539,"_5":14099,"_26939":52155,"_2865":52540},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3379":1400,"_29619":1264,"_20556":52542,"_5":14099,"_26939":52155,"_2865":52543},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3379":1401,"_29619":1264,"_20556":52545,"_5":14099,"_26939":52155,"_2865":52546},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3379":1402,"_29619":1264,"_20556":52548,"_5":14099,"_26939":52155,"_2865":52204},[],{"_3379":1403,"_29619":1264,"_20556":52550,"_5":14099,"_26939":52155,"_2865":52551},[],"`EventUpdateCertificateStatusKey`",{"_3379":1404,"_29619":1264,"_20556":52553,"_5":14099,"_26939":52155,"_2865":52554},[],"Certificate",{"_3379":1405,"_29619":1264,"_20556":52556,"_5":14099,"_26939":52155,"_2865":52557},[],"`IoTCore/Certificate`",{"_3379":1406,"_29619":1264,"_20556":52559,"_5":14099,"_26939":52155,"_2865":52560},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3379":1407,"_29619":1264,"_20556":52562,"_5":14099,"_26939":52155,"_2865":52563},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3379":1408,"_29619":1264,"_20556":52565,"_5":14099,"_26939":52155,"_2865":52216},[],{"_3379":1409,"_29619":1264,"_20556":52567,"_5":14099,"_26939":52155,"_2865":52568},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3379":1410,"_29619":1264,"_20556":52570,"_5":14099,"_26939":52155,"_2865":52571},[],"Certificate / Device",{"_3379":1411,"_29619":1264,"_20556":52573,"_5":14099,"_26939":52155,"_2865":52574},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3379":1412,"_29619":1264,"_20556":52576,"_5":14099,"_26939":52155,"_2865":48587},[],{"_3379":1413,"_29619":1264,"_20556":52578,"_5":14099,"_26939":52155,"_2865":52579},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3379":1414,"_29619":1264,"_20556":52581,"_5":14099,"_26939":52155,"_2865":52224},[],{"_3379":1415,"_29619":1264,"_20556":52583,"_5":14099,"_26939":52159,"_2865":52584},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3379":1416,"_29619":1264,"_20556":52586,"_5":14099,"_26939":52163,"_2865":52587},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3379":1417,"_29619":1264,"_20556":52589,"_5":14099,"_26939":52163,"_2865":52590},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3379":1418,"_29619":1264,"_20556":52592,"_5":14099,"_26939":52167,"_2865":52593},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3379":1419,"_29619":1264,"_20556":52595,"_5":14099,"_26939":52167,"_2865":52596},[],"Transition",{"_3379":1420,"_29619":1264,"_20556":52598,"_5":14099,"_26939":52167,"_2865":52599},[],"AWS calls",{"_3379":1421,"_29619":1264,"_20556":52601,"_5":14099,"_26939":52167,"_2865":52602},[],"`NotRegistered` → `Requested`",{"_3379":1422,"_29619":1264,"_20556":52604,"_5":14099,"_26939":52167,"_2865":52605},[],"none (metadata write only)",{"_3379":1423,"_29619":1264,"_20556":52607,"_5":14099,"_26939":52167,"_2865":52608},[],"`Requested` → `Registering`",{"_3379":1424,"_29619":1264,"_20556":52610,"_5":14099,"_26939":52167,"_2865":52611},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3379":1425,"_29619":1264,"_20556":52613,"_5":14099,"_26939":52167,"_2865":52614},[],"`Registering` → `Succeeded`",{"_3379":1426,"_29619":1264,"_20556":52616,"_5":14099,"_26939":52167,"_2865":52617},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3379":1427,"_29619":1264,"_20556":52619,"_5":14099,"_26939":52167,"_2865":52620},[],"`Registering` → `Failed`",{"_3379":1428,"_29619":1264,"_20556":52622,"_5":14099,"_26939":52167,"_2865":52623},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3379":1429,"_29619":1264,"_20556":52625,"_5":14099,"_26939":52167,"_2865":52626},[],"`Failed` / `Succeeded` → `Requested`",{"_3379":1430,"_29619":1264,"_20556":52628,"_5":14099,"_26939":52167,"_2865":52629},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3379":1431,"_29619":1264,"_20556":52631,"_5":14099,"_26939":52171,"_2865":52632},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3379":1432,"_29619":1264,"_20556":52634,"_5":14099,"_26939":52171,"_2865":52635},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3379":1433,"_29619":1264,"_20556":52637,"_5":14099,"_26939":52171,"_2865":52638},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3379":1434,"_29619":1264,"_20556":52640,"_5":14099,"_26939":52171,"_2865":52641},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3379":1435,"_29619":1264,"_20556":52643,"_5":14099,"_26939":52171,"_2865":52644},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3379":1436,"_29619":1264,"_20556":52646,"_5":14099,"_26939":52171,"_2865":52647},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3379":1437,"_29619":1264,"_20556":52649,"_5":14099,"_26939":52175,"_2865":52650},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3379":1438,"_29619":1264,"_20556":52652,"_5":14099,"_26939":52179,"_2865":52653},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3379":1439,"_29619":1264,"_20556":52655,"_5":14099,"_26939":52179,"_2865":52656},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3379":1440,"_29619":1264,"_20556":52658,"_5":14099,"_26939":52183,"_2865":52659},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3379":1441,"_29619":1264,"_20556":52661,"_5":14099,"_26939":52187,"_2865":52662},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3379":1442,"_29619":1264,"_20556":52664,"_5":14099,"_26939":52187,"_2865":52665},[],"Creates or updates the IoT policies configured in the DMS.",{"_3379":1443,"_29619":1264,"_20556":52667,"_5":14099,"_26939":52187,"_2865":52668},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3379":1444,"_29619":1264,"_20556":52670,"_5":14099,"_26939":52187,"_2865":52671},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3379":1445,"_29619":1264,"_20556":52673,"_5":14099,"_26939":52187,"_2865":52674},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3379":1446,"_29619":1264,"_20556":52676,"_5":14099,"_26939":52187,"_2865":52677},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3379":1447,"_29619":1264,"_20556":52679,"_5":14099,"_26939":52187,"_2865":52680},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3379":1448,"_29619":1264,"_20556":52682,"_5":14099,"_26939":52191,"_2865":52683},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3379":1449,"_29619":1264,"_20556":52685,"_5":14099,"_26939":52191,"_2865":52686},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3379":1450,"_29619":1264,"_20556":52688,"_5":14099,"_26939":52191,"_2865":52689},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3379":1451,"_29619":1264,"_20556":52691,"_5":14099,"_26939":52191,"_2865":52692},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3379":1452,"_29619":1264,"_20556":52694,"_5":14099,"_26939":52191,"_2865":52695},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3379":1453,"_29619":1264,"_20556":52697,"_5":14099,"_26939":52195,"_2865":52698},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3379":1454,"_29619":1264,"_20556":52700,"_5":14099,"_26939":52195,"_2865":52596},[],{"_3379":1455,"_29619":1264,"_20556":52702,"_5":14099,"_26939":52195,"_2865":52599},[],{"_3379":1456,"_29619":1264,"_20556":52704,"_5":14099,"_26939":52195,"_2865":52705},[],"`Unconfigured` → `None` / `Auto`",{"_3379":1457,"_29619":1264,"_20556":52707,"_5":14099,"_26939":52195,"_2865":52708},[],"none (configuration only)",{"_3379":1458,"_29619":1264,"_20556":52710,"_5":14099,"_26939":52195,"_2865":52711},[],"`None` ↔ `Auto`",{"_3379":1459,"_29619":1264,"_20556":52713,"_5":14099,"_26939":52195,"_2865":52708},[],{"_3379":1460,"_29619":1264,"_20556":52715,"_5":14099,"_26939":52195,"_2865":52716},[],"Any → `Jitp`",{"_3379":1461,"_29619":1264,"_20556":52718,"_5":14099,"_26939":52195,"_2865":52719},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3379":1462,"_29619":1264,"_20556":52721,"_5":14099,"_26939":52195,"_2865":52722},[],"`Jitp` → `None` / `Auto`",{"_3379":1463,"_29619":1264,"_20556":52724,"_5":14099,"_26939":52195,"_2865":52725},[],"none (the template stays in the AWS account)",{"_3379":1464,"_29619":1264,"_20556":52727,"_5":14099,"_26939":52199,"_2865":52728},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3379":1465,"_29619":1264,"_20556":52730,"_5":14099,"_26939":52199,"_2865":52731},[],"The full flow from the device's perspective is:",{"_3379":1466,"_29619":1264,"_20556":52733,"_5":14099,"_26939":52199,"_2865":52734},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3379":1467,"_29619":1264,"_20556":52736,"_5":14099,"_26939":52203,"_2865":52737},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3379":1468,"_29619":1264,"_20556":52739,"_5":14099,"_26939":52203,"_2865":52596},[],{"_3379":1469,"_29619":1264,"_20556":52741,"_5":14099,"_26939":52203,"_2865":52599},[],{"_3379":1470,"_29619":1264,"_20556":52743,"_5":14099,"_26939":52203,"_2865":52744},[],"`Absent` → `Provisioned`",{"_3379":1471,"_29619":1264,"_20556":52746,"_5":14099,"_26939":52203,"_2865":52747},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3379":1472,"_29619":1264,"_20556":52749,"_5":14099,"_26939":52203,"_2865":52750},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3379":1473,"_29619":1264,"_20556":52752,"_5":14099,"_26939":52203,"_2865":52753},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3379":1474,"_29619":1264,"_20556":52755,"_5":14099,"_26939":52203,"_2865":52756},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3379":1475,"_29619":1264,"_20556":52758,"_5":14099,"_26939":52207,"_2865":52759},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3379":1476,"_29619":1264,"_20556":52761,"_5":14099,"_26939":52207,"_2865":52762},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3379":1477,"_29619":1264,"_20556":52764,"_5":14099,"_26939":52207,"_2865":52765},[],"For the JITP flow to work correctly:",{"_3379":1478,"_29619":1264,"_20556":52767,"_5":14099,"_26939":52207,"_2865":52768},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3379":1479,"_29619":1264,"_20556":52770,"_5":14099,"_26939":52207,"_2865":52771},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3379":1480,"_29619":1264,"_20556":52773,"_5":14099,"_26939":52207,"_2865":52774},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3379":1481,"_29619":1264,"_20556":52776,"_5":14099,"_26939":52207,"_2865":52777},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3379":1482,"_29619":1264,"_20556":52779,"_5":14099,"_26939":52211,"_2865":52780},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3379":1483,"_29619":1264,"_20556":52782,"_5":14099,"_26939":52211,"_2865":52783},[],"Status in Lamassu",{"_3379":1484,"_29619":1264,"_20556":52785,"_5":14099,"_26939":52211,"_2865":52786},[],"Revocation reason",{"_3379":1485,"_29619":1264,"_20556":52788,"_5":14099,"_26939":52211,"_2865":52789},[],"Status in AWS IoT Core",{"_3379":1486,"_29619":1264,"_20556":52791,"_5":14099,"_26939":52211,"_2865":52792},[],"`Active`",{"_3379":1487,"_29619":1264,"_20556":52794,"_5":14099,"_26939":52211,"_2865":52795},[],"None",{"_3379":1488,"_29619":1264,"_20556":52797,"_5":14099,"_26939":52211,"_2865":52798},[],"`ACTIVE`",{"_3379":1489,"_29619":1264,"_20556":52800,"_5":14099,"_26939":52211,"_2865":52801},[],"`Revoked`",{"_3379":1490,"_29619":1264,"_20556":52803,"_5":14099,"_26939":52211,"_2865":52804},[],"`certificateHold`",{"_3379":1491,"_29619":1264,"_20556":52806,"_5":14099,"_26939":52211,"_2865":52807},[],"`INACTIVE`",{"_3379":1492,"_29619":1264,"_20556":52809,"_5":14099,"_26939":52211,"_2865":52801},[],{"_3379":1493,"_29619":1264,"_20556":52811,"_5":14099,"_26939":52211,"_2865":52812},[],"Any other reason",{"_3379":1494,"_29619":1264,"_20556":52814,"_5":14099,"_26939":52211,"_2865":52815},[],"`REVOKED`",{"_3379":1495,"_29619":1264,"_20556":52817,"_5":14099,"_26939":52211,"_2865":52818},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3379":1496,"_29619":1264,"_20556":52820,"_5":14099,"_26939":52215,"_2865":52821},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3379":1497,"_29619":1264,"_20556":52823,"_5":14099,"_26939":52215,"_2865":52596},[],{"_3379":1498,"_29619":1264,"_20556":52825,"_5":14099,"_26939":52215,"_2865":52599},[],{"_3379":1499,"_29619":1264,"_20556":52827,"_5":14099,"_26939":52215,"_2865":52828},[],"`NotSynced` → `Active`",{"_3379":1500,"_29619":1264,"_20556":52830,"_5":14099,"_26939":52215,"_2865":52307},[],{"_3379":1501,"_29619":1264,"_20556":52832,"_5":14099,"_26939":52215,"_2865":52833},[],"`Active` → `Inactive`",{"_3379":1502,"_29619":1264,"_20556":52835,"_5":14099,"_26939":52215,"_2865":52836},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3379":1503,"_29619":1264,"_20556":52838,"_5":14099,"_26939":52215,"_2865":52839},[],"`Active` → `Revoked`",{"_3379":1504,"_29619":1264,"_20556":52841,"_5":14099,"_26939":52215,"_2865":52836},[],{"_3379":1505,"_29619":1264,"_20556":52843,"_5":14099,"_26939":52215,"_2865":52844},[],"`Inactive` / `Revoked` → `Active`",{"_3379":1506,"_29619":1264,"_20556":52846,"_5":14099,"_26939":52215,"_2865":52307},[],{"_3379":1507,"_29619":1264,"_20556":52848,"_5":14099,"_26939":52215,"_2865":52849},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3379":1508,"_29619":1264,"_20556":52851,"_5":14099,"_26939":52215,"_2865":52852},[],"none (these states are not synced to AWS)",{"_3379":1509,"_29619":1264,"_20556":52854,"_5":14099,"_26939":52219,"_2865":52855},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3379":1510,"_29619":1264,"_20556":52857,"_5":14099,"_26939":52219,"_2865":52858},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3379":1511,"_29619":1264,"_20556":52860,"_5":14099,"_26939":52219,"_2865":52861},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3379":1512,"_29619":1264,"_20556":52863,"_5":14099,"_26939":52223,"_2865":52864},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3379":1513,"_29619":1264,"_20556":52866,"_5":14099,"_26939":52223,"_2865":52867},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3379":1514,"_29619":1264,"_20556":52869,"_5":14099,"_26939":52227,"_2865":52870},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3379":1515,"_29619":1264,"_20556":52872,"_5":14099,"_26939":52227,"_2865":52873},[],"There are two action types:",{"_3379":1516,"_29619":1264,"_20556":52875,"_5":14099,"_26939":52227,"_2865":52876},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3379":1517,"_29619":1264,"_20556":52878,"_5":14099,"_26939":52227,"_2865":52879},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3379":1518,"_29619":1264,"_20556":52881,"_5":14099,"_26939":52227,"_2865":52882},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3379":1519,"_29619":1264,"_20556":52884,"_5":14099,"_26939":52231,"_2865":52885},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3379":1520,"_29619":1264,"_20556":52887,"_5":14099,"_26939":52231,"_2865":52888},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3379":1521,"_29619":1264,"_20556":52890,"_5":14099,"_26939":52231,"_2865":52891},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3379":1522,"_29619":1264,"_20556":52893,"_5":14099,"_26939":52235,"_2865":52894},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3379":1523,"_29619":1264,"_20556":52896,"_5":14099,"_26939":52235,"_2865":52897},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3379":1524,"_29619":1264,"_20556":52899,"_5":14099,"_26939":52235,"_2865":52900},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3379":1525,"_29619":1264,"_20556":52902,"_5":14099,"_26939":52235,"_2865":52903},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3379":1526,"_29619":1264,"_20556":52905,"_5":14099,"_26939":52235,"_2865":52906},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3379":1527,"_29619":1264,"_20556":52908,"_5":14099,"_26939":52235,"_2865":52909},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3379":1528,"_29619":1264,"_20556":52911,"_5":14099,"_26939":52235,"_2865":52912},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3379":1529,"_29619":1264,"_20556":52914,"_5":14099,"_26939":52235,"_2865":52915},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3379":1530,"_29619":1264,"_20556":52917,"_5":14099,"_26939":52235,"_2865":52918},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3379":1531,"_29619":1264,"_20556":52920,"_5":14099,"_26939":52235,"_2865":52921},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3379":1532,"_29619":1264,"_20556":52923,"_5":14099,"_26939":52235,"_2865":52924},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3379":1533,"_29619":1264,"_20556":52926,"_5":14099,"_26939":52235,"_2865":52927},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3379":1534,"_29619":1264,"_20556":52929,"_5":14099,"_26939":52235,"_2865":52930},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3379":1535,"_29619":1264,"_20556":52932,"_5":14099,"_26939":52235,"_2865":52933},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3379":1536,"_29619":1264,"_20556":52935,"_5":14099,"_26939":52235,"_2865":52936},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3379":1537,"_29619":1264,"_20556":52938,"_5":14099,"_26939":52235,"_2865":52939},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3379":1538,"_29619":1264,"_20556":52941,"_5":14099,"_26939":52235,"_2865":52942},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3379":1539,"_29619":1264,"_20556":52944,"_5":14099,"_26939":52235,"_2865":52945},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3379":1540,"_29619":1264,"_20556":52947,"_5":14099,"_26939":52235,"_2865":52948},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3379":1541,"_29619":1264,"_20556":52950,"_5":14099,"_26939":52235,"_2865":52951},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3379":1542,"_29619":1264,"_20556":52953,"_5":14099,"_26939":52235,"_2865":52954},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3379":1543,"_29619":1264,"_20556":52956,"_5":14099,"_26939":52235,"_2865":52957},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3379":1544,"_29619":1264,"_20556":52959,"_5":14099,"_26939":52235,"_2865":52960},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3379":1545,"_29619":1264,"_20556":52962,"_5":14099,"_26939":52235,"_2865":52963},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3379":1546,"_29619":1546,"_5":14457,"_2865":50670,"_29951":52965,"_20556":52966,"_26939":1546},[48191,49659,50670],[],{"_3379":1547,"_29619":1546,"_20556":52968,"_5":14099,"_26939":1546,"_2865":52969},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3379":1548,"_29619":1546,"_5":29948,"_20556":52971,"_26939":52972,"_2865":52973},[],"/docs/platform/iot-fleets/overview#start-here","Start here",{"_3379":1549,"_29619":1546,"_5":29948,"_20556":52975,"_26939":52976,"_2865":50668},[],"/docs/platform/iot-fleets/overview#devices-and-identities",{"_3379":1550,"_29619":1546,"_5":29948,"_20556":52978,"_26939":52979,"_2865":50851},[],"/docs/platform/iot-fleets/overview#enrollment-with-pki",{"_3379":1551,"_29619":1546,"_5":29948,"_20556":52981,"_26939":52982,"_2865":52132},[],"/docs/platform/iot-fleets/overview#integrations",{"_3379":1552,"_29619":1546,"_5":29948,"_20556":52984,"_26939":52985,"_2865":52986},[],"/docs/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3379":1553,"_29619":1546,"_20556":52988,"_5":14099,"_26939":1546,"_2865":52989},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3379":1554,"_29619":1546,"_20556":52991,"_5":14099,"_26939":52972,"_2865":52992},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3379":1555,"_29619":1546,"_20556":52994,"_5":14099,"_26939":52972,"_2865":52995},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3379":1556,"_29619":1546,"_20556":52997,"_5":14099,"_26939":52976,"_2865":52998},[],"Resource",{"_3379":1557,"_29619":1546,"_20556":53000,"_5":14099,"_26939":52976,"_2865":53001},[],"What it represents",{"_3379":1558,"_29619":1546,"_20556":53003,"_5":14099,"_26939":52976,"_2865":53004},[],"**Device**",{"_3379":1559,"_29619":1546,"_20556":53006,"_5":14099,"_26939":52976,"_2865":53007},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3379":1560,"_29619":1546,"_20556":53009,"_5":14099,"_26939":52976,"_2865":53010},[],"**Identity**",{"_3379":1561,"_29619":1546,"_20556":53012,"_5":14099,"_26939":52976,"_2865":53013},[],"The device's association with its certificates: an active version and a history.",{"_3379":1562,"_29619":1546,"_20556":53015,"_5":14099,"_26939":52976,"_2865":53016},[],"**DMS**",{"_3379":1563,"_29619":1546,"_20556":53018,"_5":14099,"_26939":52976,"_2865":53019},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3379":1564,"_29619":1546,"_20556":53021,"_5":14099,"_26939":52976,"_2865":53022},[],"**Fleet**",{"_3379":1565,"_29619":1546,"_20556":53024,"_5":14099,"_26939":52976,"_2865":53025},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3379":1566,"_29619":1546,"_20556":53027,"_5":14099,"_26939":52976,"_2865":53028},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3379":1567,"_29619":1546,"_20556":53030,"_5":14099,"_26939":52976,"_2865":53031},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3379":1568,"_29619":1546,"_20556":53033,"_5":14099,"_26939":52979,"_2865":53034},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3379":1569,"_29619":1546,"_20556":53036,"_5":14099,"_26939":52979,"_2865":53037},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3379":1570,"_29619":1546,"_20556":53039,"_5":14099,"_26939":52979,"_2865":53040},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3379":1571,"_29619":1546,"_20556":53042,"_5":14099,"_26939":52979,"_2865":53043},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3379":1572,"_29619":1546,"_20556":53045,"_5":14099,"_26939":52979,"_2865":53046},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3379":1573,"_29619":1546,"_20556":53048,"_5":14099,"_26939":52979,"_2865":53049},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3379":1574,"_29619":1546,"_20556":53051,"_5":14099,"_26939":52979,"_2865":53052},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3379":1575,"_29619":1546,"_20556":53054,"_5":14099,"_26939":52979,"_2865":53055},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3379":1576,"_29619":1546,"_20556":53057,"_5":14099,"_26939":52982,"_2865":53058},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3379":1577,"_29619":1546,"_20556":53060,"_5":14099,"_26939":52982,"_2865":53061},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3379":1578,"_29619":1546,"_20556":53063,"_5":14099,"_26939":52985,"_2865":53064},[],"Participant",{"_3379":1579,"_29619":1546,"_20556":53066,"_5":14099,"_26939":52985,"_2865":53067},[],"Responsibility",{"_3379":1580,"_29619":1546,"_20556":53069,"_5":14099,"_26939":52985,"_2865":53070},[],"PKI administrator",{"_3379":1581,"_29619":1546,"_20556":53072,"_5":14099,"_26939":52985,"_2865":53073},[],"CA, issuance profile, chain and revocation publication.",{"_3379":1582,"_29619":1546,"_20556":53075,"_5":14099,"_26939":52985,"_2865":53076},[],"Provisioning administrator",{"_3379":1583,"_29619":1546,"_20556":53078,"_5":14099,"_26939":52985,"_2865":53079},[],"DMS, admission, authentication per operation and inventory.",{"_3379":1584,"_29619":1546,"_20556":53081,"_5":14099,"_26939":52985,"_2865":53082},[],"Device integrator",{"_3379":1585,"_29619":1546,"_20556":53084,"_5":14099,"_26939":52985,"_2865":53085},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3379":1586,"_29619":1546,"_20556":53087,"_5":14099,"_26939":52985,"_2865":53088},[],"Consumer integrator",{"_3379":1587,"_29619":1546,"_20556":53090,"_5":14099,"_26939":52985,"_2865":53091},[],"Trusted issuers, validation and device permissions in the destination.",{"_3379":1588,"_29619":1546,"_20556":53093,"_5":14099,"_26939":52985,"_2865":53094},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3379":1589,"_29619":1589,"_5":14457,"_2865":53096,"_29951":53097,"_20556":53099,"_26939":1589},"Enroll and connect your first device",[48191,49659,50670,53098],"Getting started",[],{"_3379":1590,"_29619":1589,"_20556":53101,"_5":14099,"_26939":1589,"_2865":53102},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3379":1591,"_29619":1589,"_5":29948,"_20556":53104,"_26939":53105,"_2865":48201},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3379":1592,"_29619":1589,"_5":29948,"_20556":53107,"_26939":53108,"_2865":53109},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3379":1593,"_29619":1589,"_5":29948,"_20556":53111,"_26939":53112,"_2865":53113},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3379":1594,"_29619":1589,"_5":29948,"_20556":53115,"_26939":53116,"_2865":53117},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3379":1595,"_29619":1589,"_5":29948,"_20556":53119,"_26939":53120,"_2865":53121},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3379":1596,"_29619":1589,"_5":29948,"_20556":53123,"_26939":53124,"_2865":53125},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3379":1597,"_29619":1589,"_5":29948,"_20556":53127,"_26939":53128,"_2865":53129},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3379":1598,"_29619":1589,"_5":29948,"_20556":53131,"_26939":53132,"_2865":53133},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3379":1599,"_29619":1589,"_20556":53135,"_5":14099,"_26939":1589,"_2865":53136},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3379":1600,"_29619":1589,"_20556":53138,"_5":14099,"_26939":53105,"_2865":53139},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3379":1601,"_29619":1589,"_20556":53141,"_5":14099,"_26939":53105,"_2865":53142},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3379":1602,"_29619":1589,"_20556":53144,"_5":14099,"_26939":53105,"_2865":53145},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3379":1603,"_29619":1589,"_20556":53147,"_5":14099,"_26939":53105,"_2865":53148},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3379":1604,"_29619":1589,"_20556":53150,"_5":14099,"_26939":53105,"_2865":53151},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3379":1605,"_29619":1589,"_20556":53153,"_5":14099,"_26939":53108,"_2865":53154},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3379":1606,"_29619":1589,"_20556":53156,"_5":14099,"_26939":53108,"_2865":53157},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3379":1607,"_29619":1589,"_20556":53159,"_5":14099,"_26939":53112,"_2865":53160},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3379":1608,"_29619":1589,"_20556":53162,"_5":14099,"_26939":53112,"_2865":53163},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3379":1609,"_29619":1589,"_20556":53165,"_5":14099,"_26939":53112,"_2865":53166},[],"Setting",{"_3379":1610,"_29619":1589,"_20556":53168,"_5":14099,"_26939":53112,"_2865":53169},[],"Evaluation value",{"_3379":1611,"_29619":1589,"_20556":53171,"_5":14099,"_26939":53112,"_2865":53172},[],"Enrollment CA",{"_3379":1612,"_29619":1589,"_20556":53174,"_5":14099,"_26939":53112,"_2865":53175},[],"Issuing root from `device-root.pem`.",{"_3379":1613,"_29619":1589,"_20556":53177,"_5":14099,"_26939":53112,"_2865":50981},[],{"_3379":1614,"_29619":1589,"_20556":53179,"_5":14099,"_26939":53112,"_2865":53180},[],"The 1-hour leaf profile you just prepared.",{"_3379":1615,"_29619":1589,"_20556":53182,"_5":14099,"_26939":53112,"_2865":53183},[],"Protocol / Registration Mode",{"_3379":1616,"_29619":1589,"_20556":53185,"_5":14099,"_26939":53112,"_2865":53186},[],"`EST_RFC7030` / `JITP`.",{"_3379":1617,"_29619":1589,"_20556":53188,"_5":14099,"_26939":53112,"_2865":53189},[],"Verify CSR Signature",{"_3379":1618,"_29619":1589,"_20556":53191,"_5":14099,"_26939":53112,"_2865":53192},[],"Enabled.",{"_3379":1619,"_29619":1589,"_20556":53194,"_5":14099,"_26939":53112,"_2865":53195},[],"Enable Replaceable Enrollment",{"_3379":1620,"_29619":1589,"_20556":53197,"_5":14099,"_26939":53112,"_2865":53198},[],"Disabled; the ID must be new.",{"_3379":1621,"_29619":1589,"_20556":53200,"_5":14099,"_26939":53112,"_2865":53201},[],"Initial authentication",{"_3379":1622,"_29619":1589,"_20556":53203,"_5":14099,"_26939":53112,"_2865":53204},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3379":1623,"_29619":1589,"_20556":53206,"_5":14099,"_26939":53112,"_2865":53207},[],"Renewal authentication",{"_3379":1624,"_29619":1589,"_20556":53209,"_5":14099,"_26939":53112,"_2865":53210},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3379":1625,"_29619":1589,"_20556":53212,"_5":14099,"_26939":53112,"_2865":53213},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3379":1626,"_29619":1589,"_20556":53215,"_5":14099,"_26939":53112,"_2865":53216},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3379":1627,"_29619":1589,"_20556":53218,"_5":14099,"_26939":53112,"_2865":53219},[],"Re-enrollment Delta",{"_3379":1628,"_29619":1589,"_20556":53221,"_5":14099,"_26939":53112,"_2865":53222},[],"1 hour.",{"_3379":1629,"_29619":1589,"_20556":53224,"_5":14099,"_26939":53112,"_2865":53225},[],"Preventive / Critical Delta",{"_3379":1630,"_29619":1589,"_20556":53227,"_5":14099,"_26939":53112,"_2865":53228},[],"30 minutes / 10 minutes.",{"_3379":1631,"_29619":1589,"_20556":53230,"_5":14099,"_26939":53112,"_2865":53231},[],"Revoke on Re-enrollment",{"_3379":1632,"_29619":1589,"_20556":53233,"_5":14099,"_26939":53112,"_2865":53234},[],"Disabled to test the successor before retiring the previous identity.",{"_3379":1633,"_29619":1589,"_20556":53236,"_5":14099,"_26939":53112,"_2865":50989},[],{"_3379":1634,"_29619":1589,"_20556":53238,"_5":14099,"_26939":53112,"_2865":53239},[],"Disabled; the operational key is generated in the client.",{"_3379":1635,"_29619":1589,"_20556":53241,"_5":14099,"_26939":53112,"_2865":53242},[],"CA Distribution",{"_3379":1636,"_29619":1589,"_20556":53244,"_5":14099,"_26939":53112,"_2865":53245},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3379":1637,"_29619":1589,"_20556":53247,"_5":14099,"_26939":53112,"_2865":53248},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3379":1638,"_29619":1589,"_20556":53250,"_5":14099,"_26939":53116,"_2865":53251},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3379":1639,"_29619":1589,"_20556":53253,"_5":14099,"_26939":53116,"_2865":53254},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3379":1640,"_29619":1589,"_20556":53256,"_5":14099,"_26939":53120,"_2865":53257},[],"Generate a new key and CSR with the selected identifier:",{"_3379":1641,"_29619":1589,"_20556":53259,"_5":14099,"_26939":53120,"_2865":53260},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3379":1642,"_29619":1589,"_20556":53262,"_5":14099,"_26939":53120,"_2865":53263},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3379":1643,"_29619":1589,"_20556":53265,"_5":14099,"_26939":53124,"_2865":53266},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3379":1644,"_29619":1589,"_20556":53268,"_5":14099,"_26939":53124,"_2865":53269},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3379":1645,"_29619":1589,"_20556":53271,"_5":14099,"_26939":53128,"_2865":53272},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3379":1646,"_29619":1589,"_20556":53274,"_5":14099,"_26939":53128,"_2865":53275},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3379":1647,"_29619":1589,"_20556":53277,"_5":14099,"_26939":53128,"_2865":53278},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3379":1648,"_29619":1589,"_20556":53280,"_5":14099,"_26939":53128,"_2865":53281},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3379":1649,"_29619":1589,"_20556":53283,"_5":14099,"_26939":53128,"_2865":53284},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3379":1650,"_29619":1589,"_20556":53286,"_5":14099,"_26939":53132,"_2865":53287},[],"Check",{"_3379":1651,"_29619":1589,"_20556":53289,"_5":14099,"_26939":53132,"_2865":53290},[],"Expected result",{"_3379":1652,"_29619":1589,"_20556":53292,"_5":14099,"_26939":53132,"_2865":53293},[],"Registration",{"_3379":1653,"_29619":1589,"_20556":53295,"_5":14099,"_26939":53132,"_2865":53296},[],"ID created automatically and correct DMS.",{"_3379":1654,"_29619":1589,"_20556":53298,"_5":14099,"_26939":53132,"_2865":52554},[],{"_3379":1655,"_29619":1589,"_20556":53300,"_5":14099,"_26939":53132,"_2865":53301},[],"CN, profile, serial and key verified.",{"_3379":1656,"_29619":1589,"_20556":53303,"_5":14099,"_26939":53132,"_2865":53304},[],"Inventory",{"_3379":1657,"_29619":1589,"_20556":53306,"_5":14099,"_26939":53132,"_2865":53307},[],"Received serial visible as the current identity and in history.",{"_3379":1658,"_29619":1589,"_20556":53309,"_5":14099,"_26939":53132,"_2865":53310},[],"Consumer",{"_3379":1659,"_29619":1589,"_20556":53312,"_5":14099,"_26939":53132,"_2865":53313},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3379":1660,"_29619":1589,"_20556":53315,"_5":14099,"_26939":53132,"_2865":53316},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3379":1661,"_29619":1589,"_20556":53318,"_5":14099,"_26939":53132,"_2865":53319},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3379":1662,"_29619":1662,"_5":14457,"_2865":50686,"_29951":53321,"_20556":53322,"_26939":1662},[48191,49659,50670,53098],[],{"_3379":1663,"_29619":1662,"_20556":53324,"_5":14099,"_26939":1662,"_2865":53325},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3379":1664,"_29619":1662,"_5":29948,"_20556":53327,"_26939":53328,"_2865":48201},[],"/docs/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3379":1665,"_29619":1662,"_5":29948,"_20556":53330,"_26939":53331,"_2865":53332},[],"/docs/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3379":1666,"_29619":1662,"_5":29948,"_20556":53334,"_26939":53335,"_2865":53336},[],"/docs/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3379":1667,"_29619":1662,"_5":29948,"_20556":53338,"_26939":53339,"_2865":53340},[],"/docs/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3379":1668,"_29619":1662,"_5":29948,"_20556":53342,"_26939":53343,"_2865":53344},[],"/docs/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3379":1669,"_29619":1662,"_5":29948,"_20556":53346,"_26939":53347,"_2865":53348},[],"/docs/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3379":1670,"_29619":1662,"_5":29948,"_20556":53350,"_26939":53351,"_2865":53290},[],"/docs/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3379":1671,"_29619":1662,"_5":29948,"_20556":53353,"_26939":53354,"_2865":53355},[],"/docs/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3379":1672,"_29619":1662,"_5":29948,"_20556":53357,"_26939":53358,"_2865":53359},[],"/docs/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3379":1673,"_29619":1662,"_20556":53361,"_5":14099,"_26939":1662,"_2865":53362},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3379":1674,"_29619":1662,"_20556":53364,"_5":14099,"_26939":1662,"_2865":53365},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3379":1675,"_29619":1662,"_20556":53367,"_5":14099,"_26939":53328,"_2865":53368},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3379":1676,"_29619":1662,"_20556":53370,"_5":14099,"_26939":53328,"_2865":53371},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3379":1677,"_29619":1662,"_20556":53373,"_5":14099,"_26939":53328,"_2865":53374},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3379":1678,"_29619":1662,"_20556":53376,"_5":14099,"_26939":53328,"_2865":53377},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3379":1679,"_29619":1662,"_20556":53379,"_5":14099,"_26939":53331,"_2865":53380},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3379":1680,"_29619":1662,"_20556":53382,"_5":14099,"_26939":53331,"_2865":53383},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3379":1681,"_29619":1662,"_20556":53385,"_5":14099,"_26939":53331,"_2865":53386},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3379":1682,"_29619":1662,"_20556":53388,"_5":14099,"_26939":53331,"_2865":53389},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3379":1683,"_29619":1662,"_20556":53391,"_5":14099,"_26939":53331,"_2865":53392},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3379":1684,"_29619":1662,"_20556":53394,"_5":14099,"_26939":53331,"_2865":53395},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3379":1685,"_29619":1662,"_20556":53397,"_5":14099,"_26939":53331,"_2865":53398},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3379":1686,"_29619":1662,"_20556":53400,"_5":14099,"_26939":53331,"_2865":53401},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3379":1687,"_29619":1662,"_20556":53403,"_5":14099,"_26939":53335,"_2865":53404},[],"Open **Managed Devices** and the registration action. Complete:",{"_3379":1688,"_29619":1662,"_20556":53406,"_5":14099,"_26939":53335,"_2865":53407},[],"**Device ID**: `device-001`.",{"_3379":1689,"_29619":1662,"_20556":53409,"_5":14099,"_26939":53335,"_2865":53410},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3379":1690,"_29619":1662,"_20556":53412,"_5":14099,"_26939":53335,"_2865":53413},[],"**Icon** and **Tags**: optional classification.",{"_3379":1691,"_29619":1662,"_20556":53415,"_5":14099,"_26939":53335,"_2865":53416},[],"Confirm registration.",{"_3379":1692,"_29619":1662,"_20556":53418,"_5":14099,"_26939":53339,"_2865":53419},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3379":1693,"_29619":1662,"_20556":53421,"_5":14099,"_26939":53339,"_2865":53422},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3379":1694,"_29619":1662,"_20556":53424,"_5":14099,"_26939":53343,"_2865":53425},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3379":1695,"_29619":1662,"_20556":53427,"_5":14099,"_26939":53343,"_2865":53428},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3379":1696,"_29619":1662,"_20556":53430,"_5":14099,"_26939":53347,"_2865":53431},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3379":1697,"_29619":1662,"_20556":53433,"_5":14099,"_26939":53347,"_2865":53434},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3379":1698,"_29619":1662,"_20556":53436,"_5":14099,"_26939":53351,"_2865":53287},[],{"_3379":1699,"_29619":1662,"_20556":53438,"_5":14099,"_26939":53351,"_2865":53439},[],"Result",{"_3379":1700,"_29619":1662,"_20556":53441,"_5":14099,"_26939":53351,"_2865":52537},[],{"_3379":1701,"_29619":1662,"_20556":53443,"_5":14099,"_26939":53351,"_2865":53444},[],"`device-001` appears in inventory with the expected DMS.",{"_3379":1702,"_29619":1662,"_20556":53446,"_5":14099,"_26939":53351,"_2865":53447},[],"Current identity",{"_3379":1703,"_29619":1662,"_20556":53449,"_5":14099,"_26939":53351,"_2865":53450},[],"The associated certificate matches the one you verified in PKI.",{"_3379":1704,"_29619":1662,"_20556":53452,"_5":14099,"_26939":53351,"_2865":53453},[],"History",{"_3379":1705,"_29619":1662,"_20556":53455,"_5":14099,"_26939":53351,"_2865":53456},[],"The associated issuance appears with its serial number and dates.",{"_3379":1706,"_29619":1662,"_20556":53458,"_5":14099,"_26939":53351,"_2865":53459},[],"Key and certificate",{"_3379":1707,"_29619":1662,"_20556":53461,"_5":14099,"_26939":53351,"_2865":53462},[],"You have the verified pair ready to install on the device.",{"_3379":1708,"_29619":1662,"_20556":53464,"_5":14099,"_26939":53354,"_2865":53465},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3379":1709,"_29619":1662,"_20556":53467,"_5":14099,"_26939":53354,"_2865":53468},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3379":1710,"_29619":1662,"_20556":53470,"_5":14099,"_26939":53354,"_2865":53471},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3379":1711,"_29619":1662,"_20556":53473,"_5":14099,"_26939":53354,"_2865":53474},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3379":1712,"_29619":1662,"_20556":53476,"_5":14099,"_26939":53358,"_2865":53477},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3379":1713,"_29619":1662,"_20556":53479,"_5":14099,"_26939":53358,"_2865":53480},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3379":1714,"_29619":1662,"_20556":53482,"_5":14099,"_26939":53358,"_2865":53483},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3379":1715,"_29619":1715,"_5":14457,"_2865":53485,"_29951":53486,"_20556":53487,"_26939":1715},"Lamassu IoT Platform",[48191,49659],[],{"_3379":1716,"_29619":1715,"_20556":53489,"_5":14099,"_26939":1715,"_2865":53490},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3379":1717,"_29619":1715,"_5":29948,"_20556":53492,"_26939":53493,"_2865":52973},[],"/docs/platform/overview#start-here",{"_3379":1718,"_29619":1715,"_5":29948,"_20556":53495,"_26939":53496,"_2865":53497},[],"/docs/platform/overview#choose-your-path","Choose your path",{"_3379":1719,"_29619":1715,"_5":29948,"_20556":53499,"_26939":53500,"_2865":53501},[],"/docs/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3379":1720,"_29619":1715,"_5":29948,"_20556":53503,"_26939":53504,"_2865":53505},[],"/docs/platform/overview#core-capabilities","Core capabilities",{"_3379":1721,"_29619":1715,"_5":29948,"_20556":53507,"_26939":53508,"_2865":53509},[],"/docs/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3379":1722,"_29619":1715,"_5":29948,"_20556":53511,"_26939":53512,"_2865":53513},[],"/docs/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3379":1723,"_29619":1715,"_5":29948,"_20556":53515,"_26939":53516,"_2865":53517},[],"/docs/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3379":1724,"_29619":1715,"_5":29948,"_20556":53519,"_26939":53520,"_2865":53521},[],"/docs/platform/overview#automate-device-identities","Automate device identities",{"_3379":1725,"_29619":1715,"_5":29948,"_20556":53523,"_26939":53524,"_2865":53525},[],"/docs/platform/overview#publish-validation-status","Publish validation status",{"_3379":1726,"_29619":1715,"_5":29948,"_20556":53527,"_26939":53528,"_2865":53529},[],"/docs/platform/overview#react-to-events","React to events",{"_3379":1727,"_29619":1715,"_5":29948,"_20556":53531,"_26939":53532,"_2865":53533},[],"/docs/platform/overview#operational-reference","Operational reference",{"_3379":1728,"_29619":1715,"_20556":53535,"_5":14099,"_26939":1715,"_2865":53536},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3379":1729,"_29619":1715,"_20556":53538,"_5":14099,"_26939":53493,"_2865":53539},[],"Choose the result you need:",{"_3379":1730,"_29619":1715,"_20556":53541,"_5":14099,"_26939":53493,"_2865":53542},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3379":1731,"_29619":1715,"_20556":53544,"_5":14099,"_26939":53493,"_2865":53545},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3379":1732,"_29619":1715,"_20556":53547,"_5":14099,"_26939":53493,"_2865":53548},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3379":1733,"_29619":1715,"_20556":53550,"_5":14099,"_26939":53496,"_2865":53551},[],"Section",{"_3379":1734,"_29619":1715,"_20556":53553,"_5":14099,"_26939":53496,"_2865":53554},[],"What you manage",{"_3379":1735,"_29619":1715,"_20556":53556,"_5":14099,"_26939":53496,"_2865":53557},[],"Entry point",{"_3379":1736,"_29619":1715,"_20556":53559,"_5":14099,"_26939":53496,"_2865":53560},[],"**PKI**",{"_3379":1737,"_29619":1715,"_20556":53562,"_5":14099,"_26939":53496,"_2865":53563},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3379":1738,"_29619":1715,"_20556":53565,"_5":14099,"_26939":53496,"_2865":53566},[],"PKI overview",{"_3379":1739,"_29619":1715,"_20556":53568,"_5":14099,"_26939":53496,"_2865":53569},[],"**IoT Fleets**",{"_3379":1740,"_29619":1715,"_20556":53571,"_5":14099,"_26939":53496,"_2865":53572},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3379":1741,"_29619":1715,"_20556":53574,"_5":14099,"_26939":53496,"_2865":53575},[],"IoT Fleets overview",{"_3379":1742,"_29619":1715,"_20556":53577,"_5":14099,"_26939":53496,"_2865":53578},[],"**Administration**",{"_3379":1743,"_29619":1715,"_20556":53580,"_5":14099,"_26939":53496,"_2865":53581},[],"Operator permissions, audit and event subscriptions.",{"_3379":1744,"_29619":1715,"_20556":53583,"_5":14099,"_26939":53496,"_2865":49657},[],{"_3379":1745,"_29619":1715,"_20556":53585,"_5":14099,"_26939":53496,"_2865":53586},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3379":1746,"_29619":1715,"_20556":53588,"_5":14099,"_26939":53500,"_2865":53589},[],"An identity's journey connects four responsibilities:",{"_3379":1747,"_29619":1715,"_20556":53591,"_5":14099,"_26939":53500,"_2865":53592},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3379":1748,"_29619":1715,"_20556":53594,"_5":14099,"_26939":53500,"_2865":53595},[],"The provisioning administrator configures the DMS and initial trust.",{"_3379":1749,"_29619":1715,"_20556":53597,"_5":14099,"_26939":53500,"_2865":53598},[],"The device client requests a certificate and installs it with the matching key.",{"_3379":1750,"_29619":1715,"_20556":53600,"_5":14099,"_26939":53500,"_2865":53601},[],"The consumer validates the identity and applies its access permissions.",{"_3379":1751,"_29619":1715,"_20556":53603,"_5":14099,"_26939":53500,"_2865":53604},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3379":1752,"_29619":1715,"_20556":53606,"_5":14099,"_26939":53508,"_2865":53607},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3379":1753,"_29619":1715,"_20556":53609,"_5":14099,"_26939":53512,"_2865":53610},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3379":1754,"_29619":1715,"_20556":53612,"_5":14099,"_26939":53516,"_2865":53613},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3379":1755,"_29619":1715,"_20556":53615,"_5":14099,"_26939":53520,"_2865":53616},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3379":1756,"_29619":1715,"_20556":53618,"_5":14099,"_26939":53524,"_2865":53619},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3379":1757,"_29619":1715,"_20556":53621,"_5":14099,"_26939":53528,"_2865":53622},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3379":1758,"_29619":1715,"_20556":53624,"_5":14099,"_26939":53532,"_2865":53067},[],{"_3379":1759,"_29619":1715,"_20556":53626,"_5":14099,"_26939":53532,"_2865":53627},[],"What it prepares or checks",{"_3379":1760,"_29619":1715,"_20556":53629,"_5":14099,"_26939":53532,"_2865":53070},[],{"_3379":1761,"_29619":1715,"_20556":53631,"_5":14099,"_26939":53532,"_2865":53632},[],"Key custody, CA hierarchy, profiles and validation.",{"_3379":1762,"_29619":1715,"_20556":53634,"_5":14099,"_26939":53532,"_2865":53635},[],"Fleet administrator",{"_3379":1763,"_29619":1715,"_20556":53637,"_5":14099,"_26939":53532,"_2865":53638},[],"DMS, device admission, renewal policy and inventory.",{"_3379":1764,"_29619":1715,"_20556":53640,"_5":14099,"_26939":53532,"_2865":53082},[],{"_3379":1765,"_29619":1715,"_20556":53642,"_5":14099,"_26939":53532,"_2865":53643},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3379":1766,"_29619":1715,"_20556":53645,"_5":14099,"_26939":53532,"_2865":53088},[],{"_3379":1767,"_29619":1715,"_20556":53647,"_5":14099,"_26939":53532,"_2865":53648},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3379":1768,"_29619":1715,"_20556":53650,"_5":14099,"_26939":53532,"_2865":53651},[],"Infrastructure operator",{"_3379":1769,"_29619":1715,"_20556":53653,"_5":14099,"_26939":53532,"_2865":53654},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3379":1770,"_29619":1715,"_20556":53656,"_5":14099,"_26939":53532,"_2865":53657},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3379":1771,"_29619":1771,"_5":14457,"_2865":53659,"_29951":53660,"_20556":53663,"_26939":1771},"CA hierarchy and rotation",[48191,49659,53661,53662],"PKI","Keys, authorities and certificates",[],{"_3379":1772,"_29619":1771,"_20556":53665,"_5":14099,"_26939":1771,"_2865":53666},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3379":1773,"_29619":1771,"_5":29948,"_20556":53668,"_26939":53669,"_2865":53670},[],"/docs/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3379":1774,"_29619":1771,"_5":29948,"_20556":53672,"_26939":53673,"_2865":53674},[],"/docs/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3379":1775,"_29619":1771,"_5":29948,"_20556":53676,"_26939":53677,"_2865":53678},[],"/docs/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3379":1776,"_29619":1771,"_5":29948,"_20556":53680,"_26939":53681,"_2865":53682},[],"/docs/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3379":1777,"_29619":1771,"_5":29948,"_20556":53684,"_26939":53685,"_2865":53686},[],"/docs/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3379":1778,"_29619":1771,"_5":29948,"_20556":53688,"_26939":53689,"_2865":53690},[],"/docs/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3379":1779,"_29619":1771,"_5":29948,"_20556":53692,"_26939":53693,"_2865":53694},[],"/docs/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3379":1780,"_29619":1771,"_5":29948,"_20556":53696,"_26939":53697,"_2865":53698},[],"/docs/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3379":1781,"_29619":1771,"_5":29948,"_20556":53700,"_26939":53701,"_2865":53702},[],"/docs/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3379":1782,"_29619":1771,"_5":29948,"_20556":53704,"_26939":53705,"_2865":53706},[],"/docs/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3379":1783,"_29619":1771,"_5":29948,"_20556":53708,"_26939":53709,"_2865":53710},[],"/docs/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3379":1784,"_29619":1771,"_5":29948,"_20556":53712,"_26939":53713,"_2865":53714},[],"/docs/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3379":1785,"_29619":1771,"_20556":53716,"_5":14099,"_26939":1771,"_2865":53717},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3379":1786,"_29619":1771,"_20556":53719,"_5":14099,"_26939":1771,"_2865":53720},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3379":1787,"_29619":1771,"_20556":53722,"_5":14099,"_26939":53669,"_2865":53723},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3379":1788,"_29619":1771,"_20556":53725,"_5":14099,"_26939":53669,"_2865":53726},[],"environment, such as production and preproduction;",{"_3379":1789,"_29619":1771,"_20556":53728,"_5":14099,"_26939":53669,"_2865":53729},[],"owner or operating team;",{"_3379":1790,"_29619":1771,"_20556":53731,"_5":14099,"_26939":53669,"_2865":53732},[],"device family or manufacturing process;",{"_3379":1791,"_29619":1771,"_20556":53734,"_5":14099,"_26939":53669,"_2865":53735},[],"region or regulatory requirement;",{"_3379":1792,"_29619":1771,"_20556":53737,"_5":14099,"_26939":53669,"_2865":53738},[],"cryptographic engine or key policy;",{"_3379":1793,"_29619":1771,"_20556":53740,"_5":14099,"_26939":53669,"_2865":53741},[],"maintenance window and renewal cadence.",{"_3379":1794,"_29619":1771,"_20556":53743,"_5":14099,"_26939":53669,"_2865":53744},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3379":1795,"_29619":1771,"_20556":53746,"_5":14099,"_26939":53669,"_2865":53747},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3379":1796,"_29619":1771,"_20556":53749,"_5":14099,"_26939":53673,"_2865":53750},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3379":1797,"_29619":1771,"_20556":53752,"_5":14099,"_26939":53673,"_2865":53753},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3379":1798,"_29619":1771,"_20556":53755,"_5":14099,"_26939":53673,"_2865":53756},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3379":1799,"_29619":1771,"_20556":53758,"_5":14099,"_26939":53677,"_2865":53759},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3379":1800,"_29619":1771,"_20556":53761,"_5":14099,"_26939":53677,"_2865":53762},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3379":1801,"_29619":1771,"_20556":53764,"_5":14099,"_26939":53677,"_2865":53765},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3379":1802,"_29619":1771,"_20556":53767,"_5":14099,"_26939":53677,"_2865":53768},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3379":1803,"_29619":1771,"_20556":53770,"_5":14099,"_26939":53685,"_2865":53771},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3379":1804,"_29619":1771,"_20556":53773,"_5":14099,"_26939":53689,"_2865":53774},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3379":1805,"_29619":1771,"_20556":53776,"_5":14099,"_26939":53693,"_2865":53777},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3379":1806,"_29619":1771,"_20556":53779,"_5":14099,"_26939":53697,"_2865":53780},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3379":1807,"_29619":1771,"_20556":53782,"_5":14099,"_26939":53701,"_2865":53783},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3379":1808,"_29619":1771,"_20556":53785,"_5":14099,"_26939":53705,"_2865":53786},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3379":1809,"_29619":1771,"_20556":53788,"_5":14099,"_26939":53709,"_2865":53789},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3379":1810,"_29619":1771,"_20556":53791,"_5":14099,"_26939":53709,"_2865":53792},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3379":1811,"_29619":1771,"_20556":53794,"_5":14099,"_26939":53709,"_2865":53795},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3379":1812,"_29619":1771,"_20556":53797,"_5":14099,"_26939":53709,"_2865":53798},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3379":1813,"_29619":1771,"_20556":53800,"_5":14099,"_26939":53713,"_2865":53801},[],"The new chain ends in an anchor installed by the consumer.",{"_3379":1814,"_29619":1771,"_20556":53803,"_5":14099,"_26939":53713,"_2865":53804},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3379":1815,"_29619":1771,"_20556":53806,"_5":14099,"_26939":53713,"_2865":53807},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3379":1816,"_29619":1771,"_20556":53809,"_5":14099,"_26939":53713,"_2865":53810},[],"Re-enrollment accepts the old identity during the planned period.",{"_3379":1817,"_29619":1771,"_20556":53812,"_5":14099,"_26939":53713,"_2865":53813},[],"OCSP and CRL respond for the authorities that remain active.",{"_3379":1818,"_29619":1771,"_20556":53815,"_5":14099,"_26939":53713,"_2865":53816},[],"No DMS is left accidentally issuing from the old CA.",{"_3379":1819,"_29619":1771,"_20556":53818,"_5":14099,"_26939":53713,"_2865":53819},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3379":1820,"_29619":1820,"_5":14457,"_2865":53821,"_29951":53822,"_20556":53823,"_26939":1820},"Certification authorities",[48191,49659,53661,53662],[],{"_3379":1821,"_29619":1820,"_20556":53825,"_5":14099,"_26939":1820,"_2865":53826},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3379":1822,"_29619":1820,"_5":29948,"_20556":53828,"_26939":53829,"_2865":53830},[],"/docs/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3379":1823,"_29619":1820,"_5":29948,"_20556":53832,"_26939":53833,"_2865":53834},[],"/docs/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3379":1824,"_29619":1820,"_5":29948,"_20556":53836,"_26939":53837,"_2865":48201},[],"/docs/platform/pki/certificate-authorities#before-you-begin",{"_3379":1825,"_29619":1820,"_5":29948,"_20556":53839,"_26939":53840,"_2865":53841},[],"/docs/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3379":1826,"_29619":1820,"_5":29948,"_20556":53843,"_26939":53844,"_2865":53845},[],"/docs/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3379":1827,"_29619":1820,"_5":29948,"_20556":53847,"_26939":53848,"_2865":53849},[],"/docs/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3379":1828,"_29619":1820,"_5":29948,"_20556":53851,"_26939":53852,"_2865":53853},[],"/docs/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3379":1829,"_29619":1820,"_5":29948,"_20556":53855,"_26939":53856,"_2865":53857},[],"/docs/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3379":1830,"_29619":1820,"_5":29948,"_20556":53859,"_26939":53860,"_2865":53861},[],"/docs/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3379":1831,"_29619":1820,"_5":29948,"_20556":53863,"_26939":53864,"_2865":53865},[],"/docs/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3379":1832,"_29619":1820,"_5":29948,"_20556":53867,"_26939":53868,"_2865":53869},[],"/docs/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3379":1833,"_29619":1820,"_5":29948,"_20556":53871,"_26939":53872,"_2865":53873},[],"/docs/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3379":1834,"_29619":1820,"_5":29948,"_20556":53875,"_26939":53876,"_2865":53877},[],"/docs/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3379":1835,"_29619":1820,"_5":29948,"_20556":53879,"_26939":53880,"_2865":53881},[],"/docs/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3379":1836,"_29619":1820,"_5":29948,"_20556":53883,"_26939":53884,"_2865":53885},[],"/docs/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3379":1837,"_29619":1820,"_5":29948,"_20556":53887,"_26939":53888,"_2865":53889},[],"/docs/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3379":1838,"_29619":1820,"_5":29948,"_20556":53891,"_26939":53892,"_2865":53893},[],"/docs/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3379":1839,"_29619":1820,"_5":29948,"_20556":53895,"_26939":53896,"_2865":53897},[],"/docs/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3379":1840,"_29619":1820,"_5":29948,"_20556":53899,"_26939":53900,"_2865":53901},[],"/docs/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3379":1841,"_29619":1820,"_5":29948,"_20556":53903,"_26939":53904,"_2865":53905},[],"/docs/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3379":1842,"_29619":1820,"_5":29948,"_20556":53907,"_26939":53908,"_2865":53909},[],"/docs/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3379":1843,"_29619":1820,"_5":29948,"_20556":53911,"_26939":53912,"_2865":53913},[],"/docs/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3379":1844,"_29619":1820,"_5":29948,"_20556":53915,"_26939":53916,"_2865":53917},[],"/docs/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3379":1845,"_29619":1820,"_20556":53919,"_5":14099,"_26939":1820,"_2865":53920},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3379":1846,"_29619":1820,"_20556":53922,"_5":14099,"_26939":1820,"_2865":53923},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3379":1847,"_29619":1820,"_20556":53925,"_5":14099,"_26939":1820,"_2865":53926},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3379":1848,"_29619":1820,"_20556":53928,"_5":14099,"_26939":53829,"_2865":53929},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3379":1849,"_29619":1820,"_20556":53931,"_5":14099,"_26939":53829,"_2865":53932},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3379":1850,"_29619":1820,"_20556":53934,"_5":14099,"_26939":53829,"_2865":53935},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3379":1851,"_29619":1820,"_20556":53937,"_5":14099,"_26939":53829,"_2865":53938},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3379":1852,"_29619":1820,"_20556":53940,"_5":14099,"_26939":53829,"_2865":53941},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3379":1853,"_29619":1820,"_20556":53943,"_5":14099,"_26939":53837,"_2865":53944},[],"Decide whether the CA will be a root or an intermediate.",{"_3379":1854,"_29619":1820,"_20556":53946,"_5":14099,"_26939":53837,"_2865":53947},[],"Choose the engine that will keep the key.",{"_3379":1855,"_29619":1820,"_20556":53949,"_5":14099,"_26939":53837,"_2865":53950},[],"Define a validity longer than that of the certificates it will issue.",{"_3379":1856,"_29619":1820,"_20556":53952,"_5":14099,"_26939":53837,"_2865":53953},[],"For an intermediate CA, make sure the parent CA is active.",{"_3379":1857,"_29619":1820,"_20556":53955,"_5":14099,"_26939":53840,"_2865":53956},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3379":1858,"_29619":1820,"_20556":53958,"_5":14099,"_26939":53844,"_2865":53959},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3379":1859,"_29619":1820,"_20556":53961,"_5":14099,"_26939":53844,"_2865":53962},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3379":1860,"_29619":1820,"_20556":53964,"_5":14099,"_26939":53848,"_2865":53965},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3379":1861,"_29619":1820,"_20556":53967,"_5":14099,"_26939":53852,"_2865":53968},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3379":1862,"_29619":1820,"_20556":53970,"_5":14099,"_26939":53852,"_2865":53971},[],"`C`: two-letter ISO 3166-1 country code.",{"_3379":1863,"_29619":1820,"_20556":53973,"_5":14099,"_26939":53852,"_2865":53974},[],"`ST`: state or province.",{"_3379":1864,"_29619":1820,"_20556":53976,"_5":14099,"_26939":53852,"_2865":53977},[],"`L`: locality.",{"_3379":1865,"_29619":1820,"_20556":53979,"_5":14099,"_26939":53852,"_2865":53980},[],"`O`: organization.",{"_3379":1866,"_29619":1820,"_20556":53982,"_5":14099,"_26939":53852,"_2865":53983},[],"`OU`: organizational unit.",{"_3379":1867,"_29619":1820,"_20556":53985,"_5":14099,"_26939":53852,"_2865":53986},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3379":1868,"_29619":1820,"_20556":53988,"_5":14099,"_26939":53856,"_2865":53989},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3379":1869,"_29619":1820,"_20556":53991,"_5":14099,"_26939":53856,"_2865":53992},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3379":1870,"_29619":1820,"_20556":53994,"_5":14099,"_26939":53860,"_2865":53995},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3379":1871,"_29619":1820,"_20556":53997,"_5":14099,"_26939":53860,"_2865":53998},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3379":1872,"_29619":1820,"_20556":54000,"_5":14099,"_26939":53864,"_2865":54001},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3379":1873,"_29619":1820,"_20556":54003,"_5":14099,"_26939":53864,"_2865":54004},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3379":1874,"_29619":1820,"_20556":54006,"_5":14099,"_26939":53868,"_2865":54007},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3379":1875,"_29619":1820,"_20556":54009,"_5":14099,"_26939":53868,"_2865":54010},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3379":1876,"_29619":1820,"_20556":54012,"_5":14099,"_26939":53868,"_2865":54013},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3379":1877,"_29619":1820,"_20556":54015,"_5":14099,"_26939":53872,"_2865":54016},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3379":1878,"_29619":1820,"_20556":54018,"_5":14099,"_26939":53876,"_2865":54019},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3379":1879,"_29619":1820,"_20556":54021,"_5":14099,"_26939":53880,"_2865":54022},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3379":1880,"_29619":1820,"_20556":54024,"_5":14099,"_26939":53884,"_2865":54025},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3379":1881,"_29619":1820,"_20556":54027,"_5":14099,"_26939":53884,"_2865":54028},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3379":1882,"_29619":1820,"_20556":54030,"_5":14099,"_26939":53888,"_2865":54031},[],"Open a CA from the inventory to review:",{"_3379":1883,"_29619":1820,"_20556":54033,"_5":14099,"_26939":53888,"_2865":54034},[],"Status and validity period.",{"_3379":1884,"_29619":1820,"_20556":54036,"_5":14099,"_26939":53888,"_2865":54037},[],"Certificate and chain in PEM format.",{"_3379":1885,"_29619":1820,"_20556":54039,"_5":14099,"_26939":53888,"_2865":54040},[],"Number of active, expired and revoked certificates.",{"_3379":1886,"_29619":1820,"_20556":54042,"_5":14099,"_26939":53888,"_2865":54043},[],"Certificates issued in **Issued Certificates**.",{"_3379":1887,"_29619":1820,"_20556":54045,"_5":14099,"_26939":53888,"_2865":54046},[],"The CRL linked to the authority.",{"_3379":1888,"_29619":1820,"_20556":54048,"_5":14099,"_26939":53888,"_2865":54049},[],"Metadata and the associated cryptographic engine.",{"_3379":1889,"_29619":1820,"_20556":54051,"_5":14099,"_26939":53888,"_2865":54052},[],"You can filter the inventory by name, status and CA type.",{"_3379":1890,"_29619":1820,"_20556":54054,"_5":14099,"_26939":53892,"_2865":54055},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3379":1891,"_29619":1820,"_20556":54057,"_5":14099,"_26939":53892,"_2865":54058},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3379":1892,"_29619":1820,"_20556":54060,"_5":14099,"_26939":53892,"_2865":54061},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3379":1893,"_29619":1820,"_20556":54063,"_5":14099,"_26939":53892,"_2865":54064},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3379":1894,"_29619":1820,"_20556":54066,"_5":14099,"_26939":53896,"_2865":54067},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3379":1895,"_29619":1820,"_20556":54069,"_5":14099,"_26939":53900,"_2865":54070},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3379":1896,"_29619":1820,"_20556":54072,"_5":14099,"_26939":53904,"_2865":54073},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3379":1897,"_29619":1820,"_20556":54075,"_5":14099,"_26939":53908,"_2865":54076},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3379":1898,"_29619":1820,"_20556":54078,"_5":14099,"_26939":53912,"_2865":54079},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3379":1899,"_29619":1820,"_20556":54081,"_5":14099,"_26939":53916,"_2865":54082},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3379":1900,"_29619":1820,"_20556":54084,"_5":14099,"_26939":53916,"_2865":54085},[],"The CA’s VA role is kept. If no other CA with the same SKI remains, it can no longer be edited (see CRL), so adjust its validity and signer beforehand. The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3379":1901,"_29619":1820,"_20556":54087,"_5":14099,"_26939":53916,"_2865":54088},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. If the new certificate uses the same key, it shares the SKI with the retained VA role of the deleted CA, whose signer is the old certificate: check that the CRL is generated and, if it is not, use `PUT` to set a signer of the new CA (see CRL).",{"_3379":1902,"_29619":1902,"_5":14457,"_2865":54090,"_29951":54091,"_20556":54092,"_26939":1902},"Certificate profiles",[48191,49659,53661,53662],[],{"_3379":1903,"_29619":1902,"_20556":54094,"_5":14099,"_26939":1902,"_2865":54095},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3379":1904,"_29619":1902,"_5":29948,"_20556":54097,"_26939":54098,"_2865":54099},[],"/docs/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3379":1905,"_29619":1902,"_5":29948,"_20556":54101,"_26939":54102,"_2865":54103},[],"/docs/platform/pki/certificate-profiles#validity","Validity",{"_3379":1906,"_29619":1902,"_5":29948,"_20556":54105,"_26939":54106,"_2865":54107},[],"/docs/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3379":1907,"_29619":1902,"_5":29948,"_20556":54109,"_26939":54110,"_2865":54111},[],"/docs/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3379":1908,"_29619":1902,"_5":29948,"_20556":54113,"_26939":54114,"_2865":54115},[],"/docs/platform/pki/certificate-profiles#subject","Subject",{"_3379":1909,"_29619":1902,"_5":29948,"_20556":54117,"_26939":54118,"_2865":54119},[],"/docs/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3379":1910,"_29619":1902,"_5":29948,"_20556":54121,"_26939":54122,"_2865":54123},[],"/docs/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3379":1911,"_29619":1902,"_5":29948,"_20556":54125,"_26939":54126,"_2865":54127},[],"/docs/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3379":1912,"_29619":1902,"_5":29948,"_20556":54129,"_26939":54130,"_2865":54131},[],"/docs/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3379":1913,"_29619":1902,"_5":29948,"_20556":54133,"_26939":54134,"_2865":54135},[],"/docs/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3379":1914,"_29619":1902,"_5":29948,"_20556":54137,"_26939":54138,"_2865":54139},[],"/docs/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3379":1915,"_29619":1902,"_5":29948,"_20556":54141,"_26939":54142,"_2865":54143},[],"/docs/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3379":1916,"_29619":1902,"_5":29948,"_20556":54145,"_26939":54146,"_2865":54147},[],"/docs/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3379":1917,"_29619":1902,"_5":29948,"_20556":54149,"_26939":54150,"_2865":54151},[],"/docs/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3379":1918,"_29619":1902,"_5":29948,"_20556":54153,"_26939":54154,"_2865":54155},[],"/docs/platform/pki/certificate-profiles#design-examples","Design examples",{"_3379":1919,"_29619":1902,"_5":29948,"_20556":54157,"_26939":54158,"_2865":54159},[],"/docs/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3379":1920,"_29619":1902,"_20556":54161,"_5":14099,"_26939":1902,"_2865":54162},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3379":1921,"_29619":1902,"_20556":54164,"_5":14099,"_26939":1902,"_2865":54165},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3379":1922,"_29619":1902,"_20556":54167,"_5":14099,"_26939":54102,"_2865":54168},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3379":1923,"_29619":1902,"_20556":54170,"_5":14099,"_26939":54102,"_2865":54171},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3379":1924,"_29619":1902,"_20556":54173,"_5":14099,"_26939":54106,"_2865":54174},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_3379":1925,"_29619":1902,"_20556":54176,"_5":14099,"_26939":54110,"_2865":54177},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3379":1926,"_29619":1902,"_20556":54179,"_5":14099,"_26939":54110,"_2865":54180},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3379":1927,"_29619":1902,"_20556":54182,"_5":14099,"_26939":54110,"_2865":54183},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3379":1928,"_29619":1902,"_20556":54185,"_5":14099,"_26939":54114,"_2865":54186},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3379":1929,"_29619":1902,"_20556":54188,"_5":14099,"_26939":54118,"_2865":54189},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3379":1930,"_29619":1902,"_20556":54191,"_5":14099,"_26939":54118,"_2865":54192},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3379":1931,"_29619":1902,"_20556":54194,"_5":14099,"_26939":54122,"_2865":54195},[],"The cryptographic enforcement can:",{"_3379":1932,"_29619":1902,"_20556":54197,"_5":14099,"_26939":54122,"_2865":54198},[],"allow or block RSA keys;",{"_3379":1933,"_29619":1902,"_20556":54200,"_5":14099,"_26939":54122,"_2865":54201},[],"limit the supported RSA sizes;",{"_3379":1934,"_29619":1902,"_20556":54203,"_5":14099,"_26939":54122,"_2865":54204},[],"allow or block ECDSA keys;",{"_3379":1935,"_29619":1902,"_20556":54206,"_5":14099,"_26939":54122,"_2865":54207},[],"limit the supported ECDSA sizes or curves.",{"_3379":1936,"_29619":1902,"_20556":54209,"_5":14099,"_26939":54122,"_2865":54210},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3379":1937,"_29619":1902,"_20556":54212,"_5":14099,"_26939":54126,"_2865":54213},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3379":1938,"_29619":1902,"_20556":54215,"_5":14099,"_26939":54126,"_2865":51423},[],{"_3379":1939,"_29619":1902,"_20556":54217,"_5":14099,"_26939":54126,"_2865":54218},[],"First choice",{"_3379":1940,"_29619":1902,"_20556":54220,"_5":14099,"_26939":54126,"_2865":54221},[],"Second choice",{"_3379":1941,"_29619":1902,"_20556":54223,"_5":14099,"_26939":54126,"_2865":54224},[],"If neither is supplied",{"_3379":1942,"_29619":1902,"_20556":54226,"_5":14099,"_26939":54126,"_2865":54227},[],"Direct signing with a CA",{"_3379":1943,"_29619":1902,"_20556":54229,"_5":14099,"_26939":54126,"_2865":54230},[],"`issuance_profile` embedded in the request",{"_3379":1944,"_29619":1902,"_20556":54232,"_5":14099,"_26939":54126,"_2865":54233},[],"Request `issuance_profile_id`",{"_3379":1945,"_29619":1902,"_20556":54235,"_5":14099,"_26939":54126,"_2865":54236},[],"CA default profile (`profile_id`).",{"_3379":1946,"_29619":1902,"_20556":54238,"_5":14099,"_26939":54126,"_2865":54239},[],"Issuance through a DMS",{"_3379":1947,"_29619":1902,"_20556":54241,"_5":14099,"_26939":54126,"_2865":54242},[],"`settings.issuance_profile_id`",{"_3379":1948,"_29619":1902,"_20556":54244,"_5":14099,"_26939":54126,"_2865":54245},[],"`settings.issuance_profile` embedded in the DMS",{"_3379":1949,"_29619":1902,"_20556":54247,"_5":14099,"_26939":54126,"_2865":54248},[],"Enrollment CA default profile.",{"_3379":1950,"_29619":1902,"_20556":54250,"_5":14099,"_26939":54126,"_2865":54251},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3379":1951,"_29619":1902,"_20556":54253,"_5":14099,"_26939":54126,"_2865":54254},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3379":1952,"_29619":1902,"_20556":54256,"_5":14099,"_26939":54134,"_2865":54257},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3379":1953,"_29619":1902,"_20556":54259,"_5":14099,"_26939":54138,"_2865":54260},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3379":1954,"_29619":1902,"_20556":54262,"_5":14099,"_26939":54142,"_2865":54263},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3379":1955,"_29619":1902,"_20556":54265,"_5":14099,"_26939":54146,"_2865":54266},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3379":1956,"_29619":1902,"_20556":54268,"_5":14099,"_26939":54150,"_2865":54269},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3379":1957,"_29619":1902,"_20556":54271,"_5":14099,"_26939":54150,"_2865":54272},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3379":1958,"_29619":1902,"_20556":54274,"_5":14099,"_26939":54154,"_2865":54275},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3379":1959,"_29619":1902,"_20556":54277,"_5":14099,"_26939":54154,"_2865":54278},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3379":1960,"_29619":1902,"_20556":54280,"_5":14099,"_26939":54154,"_2865":54281},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3379":1961,"_29619":1902,"_20556":54283,"_5":14099,"_26939":54154,"_2865":54284},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3379":1962,"_29619":1902,"_20556":54286,"_5":14099,"_26939":54158,"_2865":54287},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3379":1963,"_29619":1902,"_20556":54289,"_5":14099,"_26939":54158,"_2865":54290},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3379":1964,"_29619":1964,"_5":14457,"_2865":54292,"_29951":54293,"_20556":54295,"_26939":1964},"Certificate validation",[48191,49659,53661,54294],"Validation",[],{"_3379":1965,"_29619":1964,"_20556":54297,"_5":14099,"_26939":1964,"_2865":54298},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3379":1966,"_29619":1964,"_5":29948,"_20556":54300,"_26939":54301,"_2865":54302},[],"/docs/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3379":1967,"_29619":1964,"_5":29948,"_20556":54304,"_26939":54305,"_2865":54306},[],"/docs/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3379":1968,"_29619":1964,"_5":29948,"_20556":54308,"_26939":54309,"_2865":54310},[],"/docs/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3379":1969,"_29619":1964,"_20556":54312,"_5":14099,"_26939":1964,"_2865":54313},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3379":1970,"_29619":1964,"_20556":54315,"_5":14099,"_26939":54301,"_2865":54316},[],"Verify these criteria together:",{"_3379":1971,"_29619":1964,"_20556":54318,"_5":14099,"_26939":54301,"_2865":53287},[],{"_3379":1972,"_29619":1964,"_20556":54320,"_5":14099,"_26939":54301,"_2865":54321},[],"Required result",{"_3379":1973,"_29619":1964,"_20556":54323,"_5":14099,"_26939":54301,"_2865":54324},[],"Chain and signature",{"_3379":1974,"_29619":1964,"_20556":54326,"_5":14099,"_26939":54301,"_2865":54327},[],"Valid chain to a root deliberately installed in the consumer.",{"_3379":1975,"_29619":1964,"_20556":54329,"_5":14099,"_26939":54301,"_2865":54330},[],"Dates",{"_3379":1976,"_29619":1964,"_20556":54332,"_5":14099,"_26939":54301,"_2865":54333},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3379":1977,"_29619":1964,"_20556":54335,"_5":14099,"_26939":54301,"_2865":49328},[],{"_3379":1978,"_29619":1964,"_20556":54337,"_5":14099,"_26939":54301,"_2865":54338},[],"Name, SAN or identifier matches the expected peer.",{"_3379":1979,"_29619":1964,"_20556":54340,"_5":14099,"_26939":54301,"_2865":48581},[],{"_3379":1980,"_29619":1964,"_20556":54342,"_5":14099,"_26939":54301,"_2865":54343},[],"KU, EKU and constraints permit the specific operation.",{"_3379":1981,"_29619":1964,"_20556":54345,"_5":14099,"_26939":54301,"_2865":54346},[],"Revocation",{"_3379":1982,"_29619":1964,"_20556":54348,"_5":14099,"_26939":54301,"_2865":54349},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3379":1983,"_29619":1964,"_20556":54351,"_5":14099,"_26939":54301,"_2865":54352},[],"Authorization",{"_3379":1984,"_29619":1964,"_20556":54354,"_5":14099,"_26939":54301,"_2865":54355},[],"The application permits that identity to perform the action.",{"_3379":1985,"_29619":1964,"_20556":54357,"_5":14099,"_26939":54301,"_2865":54358},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3379":1986,"_29619":1964,"_20556":54360,"_5":14099,"_26939":54305,"_2865":54361},[],"Mechanism",{"_3379":1987,"_29619":1964,"_20556":54363,"_5":14099,"_26939":54305,"_2865":54364},[],"When to use it",{"_3379":1988,"_29619":1964,"_20556":54366,"_5":14099,"_26939":54305,"_2865":54367},[],"What you must maintain",{"_3379":1989,"_29619":1964,"_20556":54369,"_5":14099,"_26939":54305,"_2865":54370},[],"OCSP",{"_3379":1990,"_29619":1964,"_20556":54372,"_5":14099,"_26939":54305,"_2865":54373},[],"Status query for a specific certificate.",{"_3379":1991,"_29619":1964,"_20556":54375,"_5":14099,"_26939":54305,"_2865":54376},[],"Responder access, signature verification and cache/freshness policy.",{"_3379":1992,"_29619":1964,"_20556":54378,"_5":14099,"_26939":54305,"_2865":54379},[],"CRL",{"_3379":1993,"_29619":1964,"_20556":54381,"_5":14099,"_26939":54305,"_2865":54382},[],"Local checks for many certificates or offline operation.",{"_3379":1994,"_29619":1964,"_20556":54384,"_5":14099,"_26939":54305,"_2865":54385},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3379":1995,"_29619":1964,"_20556":54387,"_5":14099,"_26939":54305,"_2865":54388},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3379":1996,"_29619":1964,"_20556":54390,"_5":14099,"_26939":54305,"_2865":54391},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3379":1997,"_29619":1964,"_20556":54393,"_5":14099,"_26939":54309,"_2865":54394},[],"Accept a current, authorized certificate with a known chain.",{"_3379":1998,"_29619":1964,"_20556":54396,"_5":14099,"_26939":54309,"_2865":54397},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3379":1999,"_29619":1964,"_20556":54399,"_5":14099,"_26939":54309,"_2865":54400},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3379":2000,"_29619":1964,"_20556":54402,"_5":14099,"_26939":54309,"_2865":54403},[],"Check that a new connection with that identity is rejected.",{"_3379":2001,"_29619":1964,"_20556":54405,"_5":14099,"_26939":54309,"_2865":54406},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3379":2002,"_29619":1964,"_20556":54408,"_5":14099,"_26939":54309,"_2865":54409},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3379":2003,"_29619":1964,"_20556":54411,"_5":14099,"_26939":54309,"_2865":54412},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3379":2004,"_29619":1964,"_20556":54414,"_5":14099,"_26939":54309,"_2865":54415},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3379":2005,"_29619":1964,"_20556":54417,"_5":14099,"_26939":54309,"_2865":54418},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3379":2006,"_29619":2006,"_5":14457,"_2865":54420,"_29951":54421,"_20556":54422,"_26939":2006},"Certificates",[48191,49659,53661,53662],[],{"_3379":2007,"_29619":2006,"_20556":54424,"_5":14099,"_26939":2006,"_2865":54425},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3379":2008,"_29619":2006,"_5":29948,"_20556":54427,"_26939":54428,"_2865":54429},[],"/docs/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3379":2009,"_29619":2006,"_5":29948,"_20556":54431,"_26939":54432,"_2865":54433},[],"/docs/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3379":2010,"_29619":2006,"_5":29948,"_20556":54435,"_26939":54436,"_2865":54437},[],"/docs/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3379":2011,"_29619":2006,"_5":29948,"_20556":54439,"_26939":54440,"_2865":54441},[],"/docs/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3379":2012,"_29619":2006,"_5":29948,"_20556":54443,"_26939":54444,"_2865":54445},[],"/docs/platform/pki/certificates#open-the-action","Open the action",{"_3379":2013,"_29619":2006,"_5":29948,"_20556":54447,"_26939":54448,"_2865":54449},[],"/docs/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3379":2014,"_29619":2006,"_5":29948,"_20556":54451,"_26939":54452,"_2865":54453},[],"/docs/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3379":2015,"_29619":2006,"_5":29948,"_20556":54455,"_26939":54456,"_2865":54457},[],"/docs/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3379":2016,"_29619":2006,"_5":29948,"_20556":54459,"_26939":54460,"_2865":54461},[],"/docs/platform/pki/certificates#continue","Continue",{"_3379":2017,"_29619":2006,"_20556":54463,"_5":14099,"_26939":2006,"_2865":54464},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3379":2018,"_29619":2006,"_20556":54466,"_5":14099,"_26939":54428,"_2865":54467},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3379":2019,"_29619":2006,"_20556":54469,"_5":14099,"_26939":54428,"_2865":54470},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3379":2020,"_29619":2006,"_20556":54472,"_5":14099,"_26939":54428,"_2865":54473},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3379":2021,"_29619":2006,"_20556":54475,"_5":14099,"_26939":54428,"_2865":54476},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3379":2022,"_29619":2006,"_20556":54478,"_5":14099,"_26939":54428,"_2865":54479},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3379":2023,"_29619":2006,"_20556":54481,"_5":14099,"_26939":54428,"_2865":54482},[],"Certificate details include the key reference (`key_id`) and whether the private key is managed (`has_private_key`); certificate lists can be filtered on `has_private_key`.",{"_3379":2024,"_29619":2006,"_20556":54484,"_5":14099,"_26939":54428,"_2865":54485},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3379":2025,"_29619":2006,"_20556":54487,"_5":14099,"_26939":54432,"_2865":54488},[],"Download the PEM and inspect it:",{"_3379":2026,"_29619":2006,"_20556":54490,"_5":14099,"_26939":54432,"_2865":54491},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3379":2027,"_29619":2006,"_20556":54493,"_5":14099,"_26939":54436,"_2865":54494},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3379":2028,"_29619":2006,"_20556":54496,"_5":14099,"_26939":54436,"_2865":54497},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3379":2029,"_29619":2006,"_20556":54499,"_5":14099,"_26939":54436,"_2865":54500},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3379":2030,"_29619":2006,"_20556":54502,"_5":14099,"_26939":54436,"_2865":54503},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3379":2031,"_29619":2006,"_20556":54505,"_5":14099,"_26939":54436,"_2865":54506},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3379":2032,"_29619":2006,"_20556":54508,"_5":14099,"_26939":54436,"_2865":54509},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3379":2033,"_29619":2006,"_20556":54511,"_5":14099,"_26939":54436,"_2865":54512},[],"For browser key generation, follow Issue your first certificate.",{"_3379":2034,"_29619":2006,"_20556":54514,"_5":14099,"_26939":54440,"_2865":54515},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3379":2035,"_29619":2006,"_20556":54517,"_5":14099,"_26939":54444,"_2865":54518},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3379":2036,"_29619":2006,"_20556":54520,"_5":14099,"_26939":54448,"_2865":54521},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3379":2037,"_29619":2006,"_20556":54523,"_5":14099,"_26939":54452,"_2865":54524},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3379":2038,"_29619":2006,"_20556":54526,"_5":14099,"_26939":54452,"_2865":54527},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3379":2039,"_29619":2006,"_20556":54529,"_5":14099,"_26939":54452,"_2865":54530},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3379":2040,"_29619":2006,"_20556":54532,"_5":14099,"_26939":54456,"_2865":54533},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3379":2041,"_29619":2006,"_20556":54535,"_5":14099,"_26939":54456,"_2865":54536},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3379":2042,"_29619":2006,"_20556":54538,"_5":14099,"_26939":54456,"_2865":54539},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3379":2043,"_29619":2006,"_20556":54541,"_5":14099,"_26939":54460,"_2865":54542},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3379":2044,"_29619":2006,"_20556":54544,"_5":14099,"_26939":54460,"_2865":54545},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3379":2045,"_29619":2045,"_5":14457,"_2865":54547,"_29951":54548,"_20556":54550,"_26939":2045},"Certificate lifecycle",[48191,49659,53661,54549],"Concepts",[],{"_3379":2046,"_29619":2045,"_20556":54552,"_5":14099,"_26939":2045,"_2865":54553},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3379":2047,"_29619":2045,"_5":29948,"_20556":54555,"_26939":54556,"_2865":54557},[],"/docs/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3379":2048,"_29619":2045,"_5":29948,"_20556":54559,"_26939":54560,"_2865":54561},[],"/docs/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3379":2049,"_29619":2045,"_5":29948,"_20556":54563,"_26939":54564,"_2865":54565},[],"/docs/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3379":2050,"_29619":2045,"_5":29948,"_20556":54567,"_26939":54568,"_2865":54569},[],"/docs/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3379":2051,"_29619":2045,"_5":29948,"_20556":54571,"_26939":54572,"_2865":54573},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3379":2052,"_29619":2045,"_5":29948,"_20556":54575,"_26939":54576,"_2865":54577},[],"/docs/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3379":2053,"_29619":2045,"_5":29948,"_20556":54579,"_26939":54580,"_2865":54581},[],"/docs/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3379":2054,"_29619":2045,"_5":29948,"_20556":54583,"_26939":54584,"_2865":54585},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3379":2055,"_29619":2045,"_5":29948,"_20556":54587,"_26939":54588,"_2865":54589},[],"/docs/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3379":2056,"_29619":2045,"_5":29948,"_20556":54591,"_26939":54592,"_2865":54593},[],"/docs/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3379":2057,"_29619":2045,"_20556":54595,"_5":14099,"_26939":2045,"_2865":54596},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3379":2058,"_29619":2045,"_20556":54598,"_5":14099,"_26939":54560,"_2865":54599},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3379":2059,"_29619":2045,"_20556":54601,"_5":14099,"_26939":54564,"_2865":54602},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3379":2060,"_29619":2045,"_20556":54604,"_5":14099,"_26939":54568,"_2865":54605},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3379":2061,"_29619":2045,"_20556":54607,"_5":14099,"_26939":54572,"_2865":54608},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3379":2062,"_29619":2045,"_20556":54610,"_5":14099,"_26939":54576,"_2865":54611},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3379":2063,"_29619":2045,"_20556":54613,"_5":14099,"_26939":54580,"_2865":54614},[],"Lamassu persists four X.509 states:",{"_3379":2064,"_29619":2045,"_20556":54616,"_5":14099,"_26939":54580,"_2865":54617},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3379":2065,"_29619":2045,"_20556":54619,"_5":14099,"_26939":54580,"_2865":54620},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3379":2066,"_29619":2045,"_20556":54622,"_5":14099,"_26939":54580,"_2865":54623},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3379":2067,"_29619":2045,"_20556":54625,"_5":14099,"_26939":54580,"_2865":54626},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3379":2068,"_29619":2045,"_20556":54628,"_5":14099,"_26939":54580,"_2865":54629},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3379":2069,"_29619":2045,"_20556":54631,"_5":14099,"_26939":54584,"_2865":54632},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3379":2070,"_29619":2045,"_20556":54634,"_5":14099,"_26939":54584,"_2865":54635},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3379":2071,"_29619":2045,"_20556":54637,"_5":14099,"_26939":54584,"_2865":54638},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3379":2072,"_29619":2045,"_20556":54640,"_5":14099,"_26939":54588,"_2865":54641},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3379":2073,"_29619":2045,"_20556":54643,"_5":14099,"_26939":54588,"_2865":54644},[],"Before confirming:",{"_3379":2074,"_29619":2045,"_20556":54646,"_5":14099,"_26939":54588,"_2865":54647},[],"Identify DMSs, devices and services that trust that chain.",{"_3379":2075,"_29619":2045,"_20556":54649,"_5":14099,"_26939":54588,"_2865":54650},[],"Distribute the new chain of trust.",{"_3379":2076,"_29619":2045,"_20556":54652,"_5":14099,"_26939":54588,"_2865":54653},[],"Reissue the necessary identities.",{"_3379":2077,"_29619":2045,"_20556":54655,"_5":14099,"_26939":54588,"_2865":54656},[],"Check OCSP and CRL from a real consumer.",{"_3379":2078,"_29619":2045,"_20556":54658,"_5":14099,"_26939":54588,"_2865":54659},[],"Revoke the old CA once no legitimate traffic remains.",{"_3379":2079,"_29619":2045,"_20556":54661,"_5":14099,"_26939":54588,"_2865":54662},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3379":2080,"_29619":2045,"_20556":54664,"_5":14099,"_26939":54592,"_2865":54665},[],"Certificates entering the preventive or critical renewal window.",{"_3379":2081,"_29619":2045,"_20556":54667,"_5":14099,"_26939":54592,"_2865":54668},[],"Repeated enrollment or re-enrollment failures.",{"_3379":2082,"_29619":2045,"_20556":54670,"_5":14099,"_26939":54592,"_2865":54671},[],"Status changes and revocation reasons.",{"_3379":2083,"_29619":2045,"_20556":54673,"_5":14099,"_26939":54592,"_2865":54674},[],"OCSP and CRL publication and validity.",{"_3379":2084,"_29619":2045,"_20556":54676,"_5":14099,"_26939":54592,"_2865":54677},[],"Dependencies still presenting a replaced certificate.",{"_3379":2085,"_29619":2045,"_20556":54679,"_5":14099,"_26939":54592,"_2865":54680},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3379":2086,"_29619":2086,"_5":14457,"_2865":54682,"_29951":54683,"_20556":54684,"_26939":2086},"Trust model",[48191,49659,53661,54549],[],{"_3379":2087,"_29619":2086,"_20556":54686,"_5":14099,"_26939":2086,"_2865":54687},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3379":2088,"_29619":2086,"_5":29948,"_20556":54689,"_26939":54690,"_2865":54691},[],"/docs/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3379":2089,"_29619":2086,"_5":29948,"_20556":54693,"_26939":54694,"_2865":54695},[],"/docs/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3379":2090,"_29619":2086,"_5":29948,"_20556":54697,"_26939":54698,"_2865":54699},[],"/docs/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3379":2091,"_29619":2086,"_5":29948,"_20556":54701,"_26939":54702,"_2865":54703},[],"/docs/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3379":2092,"_29619":2086,"_5":29948,"_20556":54705,"_26939":54706,"_2865":54707},[],"/docs/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3379":2093,"_29619":2086,"_5":29948,"_20556":54709,"_26939":54710,"_2865":54711},[],"/docs/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3379":2094,"_29619":2086,"_5":29948,"_20556":54713,"_26939":54714,"_2865":54715},[],"/docs/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3379":2095,"_29619":2086,"_5":29948,"_20556":54717,"_26939":54718,"_2865":54719},[],"/docs/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3379":2096,"_29619":2086,"_5":29948,"_20556":54721,"_26939":54722,"_2865":54723},[],"/docs/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3379":2097,"_29619":2086,"_5":29948,"_20556":54725,"_26939":54726,"_2865":54727},[],"/docs/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3379":2098,"_29619":2086,"_20556":54729,"_5":14099,"_26939":2086,"_2865":54730},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3379":2099,"_29619":2086,"_20556":54732,"_5":14099,"_26939":54694,"_2865":54733},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3379":2100,"_29619":2086,"_20556":54735,"_5":14099,"_26939":54698,"_2865":54736},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3379":2101,"_29619":2086,"_20556":54738,"_5":14099,"_26939":54702,"_2865":54739},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3379":2102,"_29619":2086,"_20556":54741,"_5":14099,"_26939":54706,"_2865":54742},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3379":2103,"_29619":2086,"_20556":54744,"_5":14099,"_26939":54710,"_2865":54745},[],"The device proves it can enroll according to the DMS policy.",{"_3379":2104,"_29619":2086,"_20556":54747,"_5":14099,"_26939":54710,"_2865":54748},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3379":2105,"_29619":2086,"_20556":54750,"_5":14099,"_26939":54710,"_2865":54751},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3379":2106,"_29619":2086,"_20556":54753,"_5":14099,"_26939":54710,"_2865":54754},[],"The device installs the certificate and the chain it needs.",{"_3379":2107,"_29619":2086,"_20556":54756,"_5":14099,"_26939":54710,"_2865":54757},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3379":2108,"_29619":2086,"_20556":54759,"_5":14099,"_26939":54710,"_2865":54760},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3379":2109,"_29619":2086,"_20556":54762,"_5":14099,"_26939":54714,"_2865":54763},[],"A DMS relates three sets that are worth designing separately:",{"_3379":2110,"_29619":2086,"_20556":54765,"_5":14099,"_26939":54714,"_2865":54766},[],"**Enrollment CA:** signs the new identities.",{"_3379":2111,"_29619":2086,"_20556":54768,"_5":14099,"_26939":54714,"_2865":54769},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3379":2112,"_29619":2086,"_20556":54771,"_5":14099,"_26939":54714,"_2865":54772},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3379":2113,"_29619":2086,"_20556":54774,"_5":14099,"_26939":54714,"_2865":54775},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3379":2114,"_29619":2086,"_20556":54777,"_5":14099,"_26939":54718,"_2865":54778},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3379":2115,"_29619":2086,"_20556":54780,"_5":14099,"_26939":54718,"_2865":54781},[],"that the current date is between `Not Before` and `Not After`;",{"_3379":2116,"_29619":2086,"_20556":54783,"_5":14099,"_26939":54718,"_2865":54784},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3379":2117,"_29619":2086,"_20556":54786,"_5":14099,"_26939":54718,"_2865":54787},[],"that names, SANs and subject match the expected identity;",{"_3379":2118,"_29619":2086,"_20556":54789,"_5":14099,"_26939":54718,"_2865":54790},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3379":2119,"_29619":2086,"_20556":54792,"_5":14099,"_26939":54718,"_2865":54793},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3379":2120,"_29619":2086,"_20556":54795,"_5":14099,"_26939":54718,"_2865":54796},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3379":2121,"_29619":2086,"_20556":54798,"_5":14099,"_26939":54722,"_2865":54799},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3379":2122,"_29619":2086,"_20556":54801,"_5":14099,"_26939":54726,"_2865":54802},[],"Keep the root out of daily operations, or with very restricted access.",{"_3379":2123,"_29619":2086,"_20556":54804,"_5":14099,"_26939":54726,"_2865":54805},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3379":2124,"_29619":2086,"_20556":54807,"_5":14099,"_26939":54726,"_2865":54808},[],"Assign explicit profiles to every use case.",{"_3379":2125,"_29619":2086,"_20556":54810,"_5":14099,"_26939":54726,"_2865":54811},[],"Distribute the new trust before starting a rotation.",{"_3379":2126,"_29619":2086,"_20556":54813,"_5":14099,"_26939":54726,"_2865":54814},[],"Keep enough overlap to renew a disconnected fleet.",{"_3379":2127,"_29619":2086,"_20556":54816,"_5":14099,"_26939":54726,"_2865":54817},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3379":2128,"_29619":2086,"_20556":54819,"_5":14099,"_26939":54726,"_2865":54820},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3379":2129,"_29619":2129,"_5":14457,"_2865":54822,"_29951":54823,"_20556":54824,"_26939":2129},"Revocation lists (CRL)",[48191,49659,53661,54294],[],{"_3379":2130,"_29619":2129,"_20556":54826,"_5":14099,"_26939":2129,"_2865":54827},[],"Generate and distribute signed lists to validate certificates offline.",{"_3379":2131,"_29619":2129,"_5":29948,"_20556":54829,"_26939":54830,"_2865":54831},[],"/docs/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_3379":2132,"_29619":2129,"_5":29948,"_20556":54833,"_26939":54834,"_2865":54835},[],"/docs/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3379":2133,"_29619":2129,"_5":29948,"_20556":54837,"_26939":54838,"_2865":54839},[],"/docs/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3379":2134,"_29619":2129,"_5":29948,"_20556":54841,"_26939":54842,"_2865":54843},[],"/docs/platform/pki/crl#crl-contents","CRL contents",{"_3379":2135,"_29619":2129,"_5":29948,"_20556":54845,"_26939":54846,"_2865":54847},[],"/docs/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3379":2136,"_29619":2129,"_5":29948,"_20556":54849,"_26939":54850,"_2865":54851},[],"/docs/platform/pki/crl#va-role-management-api","VA role management API",{"_3379":2137,"_29619":2129,"_5":29948,"_20556":54853,"_26939":54854,"_2865":54855},[],"/docs/platform/pki/crl#common-va-role-errors","Common VA role errors",{"_3379":2138,"_29619":2129,"_5":29948,"_20556":54857,"_26939":54858,"_2865":54859},[],"/docs/platform/pki/crl#from-the-interface","From the interface",{"_3379":2139,"_29619":2129,"_5":29948,"_20556":54861,"_26939":54862,"_2865":54863},[],"/docs/platform/pki/crl#references","References",{"_3379":2140,"_29619":2129,"_20556":54865,"_5":14099,"_26939":2129,"_2865":54866},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3379":2141,"_29619":2129,"_20556":54868,"_5":14099,"_26939":54830,"_2865":54869},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3379":2142,"_29619":2129,"_20556":54871,"_5":14099,"_26939":54830,"_2865":54872},[],"`crl_options` field",{"_3379":2143,"_29619":2129,"_20556":54874,"_5":14099,"_26939":54830,"_2865":48581},[],{"_3379":2144,"_29619":2129,"_20556":54876,"_5":14099,"_26939":54830,"_2865":54877},[],"Backend initial value",{"_3379":2145,"_29619":2129,"_20556":54879,"_5":14099,"_26939":54830,"_2865":54880},[],"`validity`",{"_3379":2146,"_29619":2129,"_20556":54882,"_5":14099,"_26939":54830,"_2865":54883},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3379":2147,"_29619":2129,"_20556":54885,"_5":14099,"_26939":54830,"_2865":54886},[],"7 days.",{"_3379":2148,"_29619":2129,"_20556":54888,"_5":14099,"_26939":54830,"_2865":54889},[],"`refresh_interval`",{"_3379":2149,"_29619":2129,"_20556":54891,"_5":14099,"_26939":54830,"_2865":54892},[],"Stored and returned by the API, but the VA does not use it: scheduled renewal does not depend on it (see Periodic and automatic regeneration).",{"_3379":2150,"_29619":2129,"_20556":54894,"_5":14099,"_26939":54830,"_2865":54895},[],"6 days and 23 hours.",{"_3379":2151,"_29619":2129,"_20556":54897,"_5":14099,"_26939":54830,"_2865":54898},[],"`regenerate_on_revoke`",{"_3379":2152,"_29619":2129,"_20556":54900,"_5":14099,"_26939":54830,"_2865":54901},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3379":2153,"_29619":2129,"_20556":54903,"_5":14099,"_26939":54830,"_2865":54904},[],"`true`.",{"_3379":2154,"_29619":2129,"_20556":54906,"_5":14099,"_26939":54830,"_2865":54907},[],"`signer_certificate_serial_number`",{"_3379":2155,"_29619":2129,"_20556":54909,"_5":14099,"_26939":54830,"_2865":54910},[],"Serial number of the existing certificate that signs the CRL.",{"_3379":2156,"_29619":2129,"_20556":54912,"_5":14099,"_26939":54830,"_2865":54913},[],"Serial number of the CA’s current certificate.",{"_3379":2157,"_29619":2129,"_20556":54915,"_5":14099,"_26939":54830,"_2865":54916},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3379":2158,"_29619":2129,"_20556":54918,"_5":14099,"_26939":54830,"_2865":54919},[],"When a CA is reissued, the role keeps pointing at the previous certificate. CRLs remain valid because both certificates share subject and key, but the previous certificate cannot be deleted while the role uses it. To retire it, update the role’s signer.",{"_3379":2159,"_29619":2129,"_20556":54921,"_5":14099,"_26939":54830,"_2865":54922},[],"When a CA is deleted, its VA role is kept and cannot be removed through the API. If no other CA with the same SKI remains, the role can be read but any `PUT` returns 404, and the renewal job logs a warning on every cycle because it no longer finds the CA. The API offers no way out; it can only be fixed by editing the database. If another CA with that SKI remains, the role is still editable (see CAs that share a key). Adjust validity and signer before deleting the CA.",{"_3379":2160,"_29619":2129,"_20556":54924,"_5":14099,"_26939":54830,"_2865":54925},[],"A CA whose certificate lacks `cRLSign` cannot generate its CRL or edit its role (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and set it as the signer with `PUT`. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages.",{"_3379":2161,"_29619":2129,"_20556":54927,"_5":14099,"_26939":54830,"_2865":54928},[],"`PUT` always validates the signer, even when the request does not change it. If the stored signer is no longer valid, no field of the role can be modified, not even the validity, until a valid one is set.",{"_3379":2162,"_29619":2129,"_20556":54930,"_5":14099,"_26939":54830,"_2865":54931},[],"Sharing a key between CAs can prevent CRL validation. See CAs that share a key.",{"_3379":2163,"_29619":2129,"_20556":54933,"_5":14099,"_26939":54830,"_2865":54934},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_3379":2164,"_29619":2129,"_20556":54936,"_5":14099,"_26939":54834,"_2865":54937},[],"The VA identifies each CRL by the CA’s SKI, and the SKI is derived from its key. Two CAs with the same key have the same SKI and share a single VA role and a single CRL. This happens when a CA is created on an existing KMS key, or when a CA is imported whose certificate declares an SKI already in use. Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. The first CA creates the role and the others keep it.",{"_3379":2165,"_29619":2129,"_20556":54939,"_5":14099,"_26939":54834,"_2865":54940},[],"The certificates of all of them point to `/crl/{ski}`, but the published list has the first CA as issuer and only includes its revocations. A verifier compares the CRL issuer with the issuer of the certificate it validates (RFC 5280, §6.3.2) and rejects the list if they differ. Depending on its policy, the certificate is blocked (*hard-fail*) or accepted even though it is revoked (*soft-fail*). Revocations of the secondary CAs do not appear in any list.",{"_3379":2166,"_29619":2129,"_20556":54942,"_5":14099,"_26939":54834,"_2865":54943},[],"If the first CA is deleted, CRL generation for the remaining one fails because the configured signer no longer matches a CA with that name. Until the role’s signer is updated to a certificate of the remaining CA, the last published list keeps being served until it expires (7 days by default).",{"_3379":2167,"_29619":2129,"_20556":54945,"_5":14099,"_26939":54834,"_2865":54946},[],"Before upgrading, review CAs that share a key. To detect the problem, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued. A CA imported with an SKI already in use does not replace the existing one as CRL issuer, because the issuer is resolved from the role’s signer. However, its own certificates point to that same URL and its revocations are not published. Until Lamassu rejects these imports, restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same collision, so also avoid reusing keys across CAs. A per-CA CRL and the rejection of imports whose SKI collides with an existing CA are both proposed in lamassuiot#834, and neither is implemented yet.",{"_3379":2168,"_29619":2129,"_20556":54948,"_5":14099,"_26939":54838,"_2865":54949},[],"The VA scheduled job checks every role on each run and requests another list when the remaining validity of `latest_crl` is less than the interval between runs. The frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. `refresh_interval` plays no part. Keep `validity` well above the interval: with a shorter validity, the list is regenerated on every cycle.",{"_3379":2169,"_29619":2129,"_20556":54951,"_5":14099,"_26939":54838,"_2865":54952},[],"If generation fails (for example, because of a role without a CA or an invalid signer), the job logs the warning `something went wrong while calculating CRL for CA <ski>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3379":2170,"_29619":2129,"_20556":54954,"_5":14099,"_26939":54838,"_2865":54955},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if it fails (missing role, invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3379":2171,"_29619":2129,"_20556":54957,"_5":14099,"_26939":54838,"_2865":54958},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3379":2172,"_29619":2129,"_20556":54960,"_5":14099,"_26939":54842,"_2865":54961},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3379":2173,"_29619":2129,"_20556":54963,"_5":14099,"_26939":54842,"_2865":54964},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3379":2174,"_29619":2129,"_20556":54966,"_5":14099,"_26939":54846,"_2865":54967},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_3379":2175,"_29619":2129,"_20556":54969,"_5":14099,"_26939":54846,"_2865":54970},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3379":2176,"_29619":2129,"_20556":54972,"_5":14099,"_26939":54846,"_2865":54973},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the role points to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3379":2177,"_29619":2129,"_20556":54975,"_5":14099,"_26939":54846,"_2865":54976},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3379":2178,"_29619":2129,"_20556":54978,"_5":14099,"_26939":54846,"_2865":54979},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3379":2179,"_29619":2129,"_20556":54981,"_5":14099,"_26939":54850,"_2865":54982},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3379":2180,"_29619":2129,"_20556":54984,"_5":14099,"_26939":54850,"_2865":51426},[],{"_3379":2181,"_29619":2129,"_20556":54986,"_5":14099,"_26939":54850,"_2865":54987},[],"Relative path",{"_3379":2182,"_29619":2129,"_20556":54989,"_5":14099,"_26939":54850,"_2865":51423},[],{"_3379":2183,"_29619":2129,"_20556":54991,"_5":14099,"_26939":54850,"_2865":54992},[],"`GET`",{"_3379":2184,"_29619":2129,"_20556":54994,"_5":14099,"_26939":54850,"_2865":54995},[],"`/v1/roles/{ca-ski}`",{"_3379":2185,"_29619":2129,"_20556":54997,"_5":14099,"_26939":54850,"_2865":54998},[],"Read `crl_options` and `latest_crl`.",{"_3379":2186,"_29619":2129,"_20556":55000,"_5":14099,"_26939":54850,"_2865":55001},[],"`PUT`",{"_3379":2187,"_29619":2129,"_20556":55003,"_5":14099,"_26939":54850,"_2865":54995},[],{"_3379":2188,"_29619":2129,"_20556":55005,"_5":14099,"_26939":54850,"_2865":55006},[],"Replace CRL configuration.",{"_3379":2189,"_29619":2129,"_20556":55008,"_5":14099,"_26939":54850,"_2865":55009},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_3379":2190,"_29619":2129,"_20556":55011,"_5":14099,"_26939":54850,"_2865":55012},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_3379":2191,"_29619":2129,"_20556":55014,"_5":14099,"_26939":54854,"_2865":55015},[],"Symptom",{"_3379":2192,"_29619":2129,"_20556":55017,"_5":14099,"_26939":54854,"_2865":55018},[],"Cause",{"_3379":2193,"_29619":2129,"_20556":55020,"_5":14099,"_26939":54854,"_2865":55021},[],"Action",{"_3379":2194,"_29619":2129,"_20556":55023,"_5":14099,"_26939":54854,"_2865":55024},[],"`PUT /v1/roles/{ca-ski}` returns 404 and `GET` returns 200.",{"_3379":2195,"_29619":2129,"_20556":55026,"_5":14099,"_26939":54854,"_2865":55027},[],"The role’s CA was deleted and no other CA with the same SKI remains.",{"_3379":2196,"_29619":2129,"_20556":55029,"_5":14099,"_26939":54854,"_2865":55030},[],"There is no API way out; it requires database intervention. Avoid it by adjusting the role before deleting the CA.",{"_3379":2197,"_29619":2129,"_20556":55032,"_5":14099,"_26939":54854,"_2865":55033},[],"`PUT` returns 400.",{"_3379":2198,"_29619":2129,"_20556":55035,"_5":14099,"_26939":54854,"_2865":55036},[],"The signer lacks `cRLSign`, or its subject and key match no CA with that SKI (for example, after deleting the first of two CAs that share a key).",{"_3379":2199,"_29619":2129,"_20556":55038,"_5":14099,"_26939":54854,"_2865":55039},[],"Use `PUT` to set the serial number of a valid certificate of the remaining CA.",{"_3379":2200,"_29619":2129,"_20556":55041,"_5":14099,"_26939":54854,"_2865":55042},[],"`PUT` returns 400 from a 3.x client.",{"_3379":2201,"_29619":2129,"_20556":55044,"_5":14099,"_26939":54854,"_2865":55045},[],"`crl_options.subject_key_id_signer` was replaced by `signer_certificate_serial_number`, which is required.",{"_3379":2202,"_29619":2129,"_20556":55047,"_5":14099,"_26939":54854,"_2865":55048},[],"Update the client to send the new field.",{"_3379":2203,"_29619":2129,"_20556":55050,"_5":14099,"_26939":54854,"_2865":55051},[],"The CRL does not change after revoking a certificate.",{"_3379":2204,"_29619":2129,"_20556":55053,"_5":14099,"_26939":54854,"_2865":55054},[],"`regenerate_on_revoke` is `false`, or the event failed because of a missing role or an invalid signer.",{"_3379":2205,"_29619":2129,"_20556":55056,"_5":14099,"_26939":54854,"_2865":55057},[],"Check the VA logs and the failed-events queue; fix the signer.",{"_3379":2206,"_29619":2129,"_20556":55059,"_5":14099,"_26939":54854,"_2865":55060},[],"A verifier rejects the CRL because of the issuer.",{"_3379":2207,"_29619":2129,"_20556":55062,"_5":14099,"_26939":54854,"_2865":55063},[],"Several CAs share an SKI.",{"_3379":2208,"_29619":2129,"_20556":55065,"_5":14099,"_26939":54854,"_2865":55066},[],"See CAs that share a key.",{"_3379":2209,"_29619":2129,"_20556":55068,"_5":14099,"_26939":54858,"_2865":55069},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. The CA’s VA settings also let you select the CRL signer: the certificate picker only offers certificates that have a private key and carry the `cRLSign` key usage. If a configured signer’s certificate cannot be resolved, the interface shows `Unknown Certificate (Serial: X)` or `Certificate details unavailable (Serial: X)`. Diagnose differences using PKI troubleshooting.",{"_3379":2210,"_29619":2129,"_20556":55071,"_5":14099,"_26939":54862,"_2865":55072},[],"RFC 5280: X.509 and CRL profile.",{"_3379":2211,"_29619":2129,"_20556":55074,"_5":14099,"_26939":54862,"_2865":55075},[],"OpenSSL: openssl-crl.",{"_3379":2212,"_29619":2129,"_20556":55077,"_5":14099,"_26939":54862,"_2865":55078},[],"OpenSSL: openssl-verify.",{"_3379":2213,"_29619":2129,"_20556":55080,"_5":14099,"_26939":54862,"_2865":55081},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3379":2214,"_29619":2129,"_20556":55083,"_5":14099,"_26939":54862,"_2865":55084},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3379":2215,"_29619":2215,"_5":14457,"_2865":55086,"_29951":55087,"_20556":55088,"_26939":2215},"Keys and cryptographic engines",[48191,49659,53661,53662],[],{"_3379":2216,"_29619":2215,"_20556":55090,"_5":14099,"_26939":2215,"_2865":55091},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3379":2217,"_29619":2215,"_5":29948,"_20556":55093,"_26939":55094,"_2865":55095},[],"/docs/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3379":2218,"_29619":2215,"_5":29948,"_20556":55097,"_26939":55098,"_2865":55099},[],"/docs/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3379":2219,"_29619":2215,"_5":29948,"_20556":55101,"_26939":55102,"_2865":55103},[],"/docs/platform/pki/key-management#file-system","File System",{"_3379":2220,"_29619":2215,"_5":29948,"_20556":55105,"_26939":55106,"_2865":55107},[],"/docs/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3379":2221,"_29619":2215,"_5":29948,"_20556":55109,"_26939":55110,"_2865":55111},[],"/docs/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3379":2222,"_29619":2215,"_5":29948,"_20556":55113,"_26939":55114,"_2865":55115},[],"/docs/platform/pki/key-management#aws-kms","AWS KMS",{"_3379":2223,"_29619":2215,"_5":29948,"_20556":55117,"_26939":55118,"_2865":55119},[],"/docs/platform/pki/key-management#pkcs11","PKCS#11",{"_3379":2224,"_29619":2215,"_5":29948,"_20556":55121,"_26939":55122,"_2865":55123},[],"/docs/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3379":2225,"_29619":2215,"_5":29948,"_20556":55125,"_26939":55126,"_2865":55127},[],"/docs/platform/pki/key-management#key-inventory","Key inventory",{"_3379":2226,"_29619":2215,"_5":29948,"_20556":55129,"_26939":55130,"_2865":55131},[],"/docs/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3379":2227,"_29619":2215,"_5":29948,"_20556":55133,"_26939":55134,"_2865":55135},[],"/docs/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3379":2228,"_29619":2215,"_5":29948,"_20556":55137,"_26939":55138,"_2865":55139},[],"/docs/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3379":2229,"_29619":2215,"_5":29948,"_20556":55141,"_26939":55142,"_2865":55143},[],"/docs/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3379":2230,"_29619":2215,"_5":29948,"_20556":55145,"_26939":55146,"_2865":55147},[],"/docs/platform/pki/key-management#view-details","View details",{"_3379":2231,"_29619":2215,"_5":29948,"_20556":55149,"_26939":55150,"_2865":55151},[],"/docs/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3379":2232,"_29619":2215,"_5":29948,"_20556":55153,"_26939":55154,"_2865":55155},[],"/docs/platform/pki/key-management#sign","Sign",{"_3379":2233,"_29619":2215,"_5":29948,"_20556":55157,"_26939":55158,"_2865":55159},[],"/docs/platform/pki/key-management#verify","Verify",{"_3379":2234,"_29619":2215,"_5":29948,"_20556":55161,"_26939":55162,"_2865":55163},[],"/docs/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3379":2235,"_29619":2215,"_5":29948,"_20556":55165,"_26939":55166,"_2865":55167},[],"/docs/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3379":2236,"_29619":2215,"_5":29948,"_20556":55169,"_26939":55170,"_2865":55171},[],"/docs/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3379":2237,"_29619":2215,"_20556":55173,"_5":14099,"_26939":2215,"_2865":55174},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3379":2238,"_29619":2215,"_20556":55176,"_5":14099,"_26939":2215,"_2865":55177},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3379":2239,"_29619":2215,"_20556":55179,"_5":14099,"_26939":55094,"_2865":55180},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3379":2240,"_29619":2215,"_20556":55182,"_5":14099,"_26939":55094,"_2865":55183},[],"In practice, it lets you:",{"_3379":2241,"_29619":2215,"_20556":55185,"_5":14099,"_26939":55094,"_2865":55186},[],"Generate new key pairs from Lamassu IoT.",{"_3379":2242,"_29619":2215,"_20556":55188,"_5":14099,"_26939":55094,"_2865":55189},[],"Import keys created externally.",{"_3379":2243,"_29619":2215,"_20556":55191,"_5":14099,"_26939":55094,"_2865":55192},[],"Delegate custody and cryptographic operations to external engines.",{"_3379":2244,"_29619":2215,"_20556":55194,"_5":14099,"_26939":55094,"_2865":55195},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3379":2245,"_29619":2215,"_20556":55197,"_5":14099,"_26939":55098,"_2865":55198},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3379":2246,"_29619":2215,"_20556":55200,"_5":14099,"_26939":55098,"_2865":55201},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3379":2247,"_29619":2215,"_20556":55203,"_5":14099,"_26939":55098,"_2865":55204},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3379":2248,"_29619":2215,"_20556":55206,"_5":14099,"_26939":55102,"_2865":55207},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3379":2249,"_29619":2215,"_20556":55209,"_5":14099,"_26939":55106,"_2865":55210},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3379":2250,"_29619":2215,"_20556":55212,"_5":14099,"_26939":55106,"_2865":55213},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3379":2251,"_29619":2215,"_20556":55215,"_5":14099,"_26939":55110,"_2865":55216},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3379":2252,"_29619":2215,"_20556":55218,"_5":14099,"_26939":55114,"_2865":55219},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3379":2253,"_29619":2215,"_20556":55221,"_5":14099,"_26939":55118,"_2865":55222},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3379":2254,"_29619":2215,"_20556":55224,"_5":14099,"_26939":55122,"_2865":55225},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3379":2255,"_29619":2215,"_20556":55227,"_5":14099,"_26939":55122,"_2865":55228},[],"Lamassu shows the enabled engines in the console.",{"_3379":2256,"_29619":2215,"_20556":55230,"_5":14099,"_26939":55122,"_2865":55231},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3379":2257,"_29619":2215,"_20556":55233,"_5":14099,"_26939":55122,"_2865":55234},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3379":2258,"_29619":2215,"_20556":55236,"_5":14099,"_26939":55126,"_2865":55237},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3379":2259,"_29619":2215,"_20556":55239,"_5":14099,"_26939":55126,"_2865":55240},[],"The table includes the following fields:",{"_3379":2260,"_29619":2215,"_20556":55242,"_5":14099,"_26939":55126,"_2865":55243},[],"**Name**: descriptive name of the key.",{"_3379":2261,"_29619":2215,"_20556":55245,"_5":14099,"_26939":55126,"_2865":55246},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3379":2262,"_29619":2215,"_20556":55248,"_5":14099,"_26939":55126,"_2865":55249},[],"**Strength**: visual indicator of cryptographic strength.",{"_3379":2263,"_29619":2215,"_20556":55251,"_5":14099,"_26939":55126,"_2865":55252},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3379":2264,"_29619":2215,"_20556":55254,"_5":14099,"_26939":55126,"_2865":55255},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3379":2265,"_29619":2215,"_20556":55257,"_5":14099,"_26939":55126,"_2865":55258},[],"**Aliases**: alternative names associated with the key.",{"_3379":2266,"_29619":2215,"_20556":55260,"_5":14099,"_26939":55126,"_2865":55261},[],"**Tags**: labels for classification and search.",{"_3379":2267,"_29619":2215,"_20556":55263,"_5":14099,"_26939":55126,"_2865":55264},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3379":2268,"_29619":2215,"_20556":55266,"_5":14099,"_26939":55126,"_2865":55267},[],"From this view you also reach the most common actions:",{"_3379":2269,"_29619":2215,"_20556":55269,"_5":14099,"_26939":55126,"_2865":55270},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3379":2270,"_29619":2215,"_20556":55272,"_5":14099,"_26939":55126,"_2865":55273},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3379":2271,"_29619":2215,"_20556":55275,"_5":14099,"_26939":55126,"_2865":55276},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3379":2272,"_29619":2215,"_20556":55278,"_5":14099,"_26939":55126,"_2865":55279},[],"**Delete Key** to remove the key from the system.",{"_3379":2273,"_29619":2215,"_20556":55281,"_5":14099,"_26939":55130,"_2865":55282},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3379":2274,"_29619":2215,"_20556":55284,"_5":14099,"_26939":55134,"_2865":55285},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3379":2275,"_29619":2215,"_20556":55287,"_5":14099,"_26939":55134,"_2865":55288},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3379":2276,"_29619":2215,"_20556":55290,"_5":14099,"_26939":55134,"_2865":55291},[],"**Key Name**: unique and descriptive name.",{"_3379":2277,"_29619":2215,"_20556":55293,"_5":14099,"_26939":55134,"_2865":55294},[],"**Crypto Engine**: engine that will keep the key.",{"_3379":2278,"_29619":2215,"_20556":55296,"_5":14099,"_26939":55134,"_2865":55297},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3379":2279,"_29619":2215,"_20556":55299,"_5":14099,"_26939":55134,"_2865":55300},[],"**Tags**: metadata to classify the key.",{"_3379":2280,"_29619":2215,"_20556":55302,"_5":14099,"_26939":55134,"_2865":55303},[],"**Metadata**: additional information for advanced uses.",{"_3379":2281,"_29619":2215,"_20556":55305,"_5":14099,"_26939":55138,"_2865":55306},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3379":2282,"_29619":2215,"_20556":55308,"_5":14099,"_26939":55138,"_2865":55309},[],"When you have an exportable private key and the destination engine supports import.",{"_3379":2283,"_29619":2215,"_20556":55311,"_5":14099,"_26939":55138,"_2865":55312},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3379":2284,"_29619":2215,"_20556":55314,"_5":14099,"_26939":55138,"_2865":55315},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3379":2285,"_29619":2215,"_20556":55317,"_5":14099,"_26939":55138,"_2865":55318},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3379":2286,"_29619":2215,"_20556":55320,"_5":14099,"_26939":55138,"_2865":55321},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3379":2287,"_29619":2215,"_20556":55323,"_5":14099,"_26939":55138,"_2865":55324},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3379":2288,"_29619":2215,"_20556":55326,"_5":14099,"_26939":55138,"_2865":55327},[],"**Tags**: labels for organization and search.",{"_3379":2289,"_29619":2215,"_20556":55329,"_5":14099,"_26939":55138,"_2865":55330},[],"**Metadata**: additional optional information.",{"_3379":2290,"_29619":2215,"_20556":55332,"_5":14099,"_26939":55138,"_2865":55333},[],"**Private Key (PEM)**: private key in PEM format.",{"_3379":2291,"_29619":2215,"_20556":55335,"_5":14099,"_26939":55138,"_2865":55336},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3379":2292,"_29619":2215,"_20556":55338,"_5":14099,"_26939":55142,"_2865":55339},[],"Each registered key has a detail view and several operational actions.",{"_3379":2293,"_29619":2215,"_20556":55341,"_5":14099,"_26939":55146,"_2865":55342},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3379":2294,"_29619":2215,"_20556":55344,"_5":14099,"_26939":55146,"_2865":55345},[],"The **Overview** tab shows, among others, these fields:",{"_3379":2295,"_29619":2215,"_20556":55347,"_5":14099,"_26939":55146,"_2865":55348},[],"**Key Name**: descriptive name.",{"_3379":2296,"_29619":2215,"_20556":55350,"_5":14099,"_26939":55146,"_2865":55351},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3379":2297,"_29619":2215,"_20556":55353,"_5":14099,"_26939":55146,"_2865":55354},[],"**Tags**: associated labels.",{"_3379":2298,"_29619":2215,"_20556":55356,"_5":14099,"_26939":55146,"_2865":55357},[],"**Aliases**: alternative names.",{"_3379":2299,"_29619":2215,"_20556":55359,"_5":14099,"_26939":55146,"_2865":55360},[],"**Crypto Engine**: engine where the key resides.",{"_3379":2300,"_29619":2215,"_20556":55362,"_5":14099,"_26939":55146,"_2865":55363},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3379":2301,"_29619":2215,"_20556":55365,"_5":14099,"_26939":55146,"_2865":55366},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3379":2302,"_29619":2215,"_20556":55368,"_5":14099,"_26939":55146,"_2865":55369},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3379":2303,"_29619":2215,"_20556":55371,"_5":14099,"_26939":55150,"_2865":55372},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3379":2304,"_29619":2215,"_20556":55374,"_5":14099,"_26939":55150,"_2865":55375},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3379":2305,"_29619":2215,"_20556":55377,"_5":14099,"_26939":55150,"_2865":55378},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3379":2306,"_29619":2215,"_20556":55380,"_5":14099,"_26939":55154,"_2865":55381},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3379":2307,"_29619":2215,"_20556":55383,"_5":14099,"_26939":55154,"_2865":55384},[],"Main fields:",{"_3379":2308,"_29619":2215,"_20556":55386,"_5":14099,"_26939":55154,"_2865":55387},[],"**Algorithm**: signing algorithm available for the key type.",{"_3379":2309,"_29619":2215,"_20556":55389,"_5":14099,"_26939":55154,"_2865":55390},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3379":2310,"_29619":2215,"_20556":55392,"_5":14099,"_26939":55154,"_2865":55393},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3379":2311,"_29619":2215,"_20556":55395,"_5":14099,"_26939":55154,"_2865":55396},[],"**Message**: content to sign.",{"_3379":2312,"_29619":2215,"_20556":55398,"_5":14099,"_26939":55154,"_2865":55399},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3379":2313,"_29619":2215,"_20556":55401,"_5":14099,"_26939":55158,"_2865":55402},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3379":2314,"_29619":2215,"_20556":55404,"_5":14099,"_26939":55158,"_2865":55384},[],{"_3379":2315,"_29619":2215,"_20556":55406,"_5":14099,"_26939":55158,"_2865":55407},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3379":2316,"_29619":2215,"_20556":55409,"_5":14099,"_26939":55158,"_2865":55410},[],"**Message Type**: `Raw` or `Digest`.",{"_3379":2317,"_29619":2215,"_20556":55412,"_5":14099,"_26939":55158,"_2865":55413},[],"**Payload Encoding**: encoding of the message.",{"_3379":2318,"_29619":2215,"_20556":55415,"_5":14099,"_26939":55158,"_2865":55416},[],"**Message**: original message or hash.",{"_3379":2319,"_29619":2215,"_20556":55418,"_5":14099,"_26939":55158,"_2865":55419},[],"**Signature**: signature to check.",{"_3379":2320,"_29619":2215,"_20556":55421,"_5":14099,"_26939":55158,"_2865":55422},[],"**Result**: indicator of the validation result.",{"_3379":2321,"_29619":2215,"_20556":55424,"_5":14099,"_26939":55162,"_2865":55425},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3379":2322,"_29619":2215,"_20556":55427,"_5":14099,"_26939":55162,"_2865":55428},[],"This flow is useful for:",{"_3379":2323,"_29619":2215,"_20556":55430,"_5":14099,"_26939":55162,"_2865":55431},[],"Requesting certificates from an external CA.",{"_3379":2324,"_29619":2215,"_20556":55433,"_5":14099,"_26939":55162,"_2865":55434},[],"Renewing an identity while keeping the same key.",{"_3379":2325,"_29619":2215,"_20556":55436,"_5":14099,"_26939":55162,"_2865":55437},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3379":2326,"_29619":2215,"_20556":55439,"_5":14099,"_26939":55162,"_2865":55440},[],"**Common Name (CN)**: main name of the identity.",{"_3379":2327,"_29619":2215,"_20556":55442,"_5":14099,"_26939":55162,"_2865":55443},[],"**Organization (O)**: organization or company.",{"_3379":2328,"_29619":2215,"_20556":55445,"_5":14099,"_26939":55162,"_2865":55446},[],"**Organizational Unit (OU)**: department or unit.",{"_3379":2329,"_29619":2215,"_20556":55448,"_5":14099,"_26939":55162,"_2865":55449},[],"**Country (C)**: two-letter country code.",{"_3379":2330,"_29619":2215,"_20556":55451,"_5":14099,"_26939":55162,"_2865":55452},[],"**State / Province (ST)**: state or province.",{"_3379":2331,"_29619":2215,"_20556":55454,"_5":14099,"_26939":55162,"_2865":55455},[],"**Locality (L)**: city or locality.",{"_3379":2332,"_29619":2215,"_20556":55457,"_5":14099,"_26939":55162,"_2865":55458},[],"**Email Address**: contact email.",{"_3379":2333,"_29619":2215,"_20556":55460,"_5":14099,"_26939":55162,"_2865":55461},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3379":2334,"_29619":2215,"_20556":55463,"_5":14099,"_26939":55162,"_2865":55464},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3379":2335,"_29619":2215,"_20556":55466,"_5":14099,"_26939":55166,"_2865":55467},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3379":2336,"_29619":2215,"_20556":55469,"_5":14099,"_26939":55166,"_2865":55470},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3379":2337,"_29619":2215,"_20556":55472,"_5":14099,"_26939":55170,"_2865":55473},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3379":2338,"_29619":2215,"_20556":55475,"_5":14099,"_26939":55170,"_2865":55476},[],"The KMS refuses to delete a key that certificates still reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. Revoking certificates issued by the deleted CA does not release their own key references. Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3379":2339,"_29619":2339,"_5":14457,"_2865":55478,"_29951":55479,"_20556":55480,"_26939":2339},"Online validation with OCSP",[48191,49659,53661,54294],[],{"_3379":2340,"_29619":2339,"_20556":55482,"_5":14099,"_26939":2339,"_2865":55483},[],"Query signed status and verify the responder’s response.",{"_3379":2341,"_29619":2339,"_5":29948,"_20556":55485,"_26939":55486,"_2865":55487},[],"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3379":2342,"_29619":2339,"_5":29948,"_20556":55489,"_26939":55490,"_2865":55491},[],"/docs/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3379":2343,"_29619":2339,"_5":29948,"_20556":55493,"_26939":55494,"_2865":55495},[],"/docs/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3379":2344,"_29619":2339,"_5":29948,"_20556":55497,"_26939":55498,"_2865":55499},[],"/docs/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3379":2345,"_29619":2339,"_5":29948,"_20556":55501,"_26939":55502,"_2865":55503},[],"/docs/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3379":2346,"_29619":2339,"_5":29948,"_20556":55505,"_26939":55506,"_2865":54863},[],"/docs/platform/pki/ocsp#references",{"_3379":2347,"_29619":2339,"_20556":55508,"_5":14099,"_26939":2339,"_2865":55509},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3379":2348,"_29619":2339,"_20556":55511,"_5":14099,"_26939":55486,"_2865":55512},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3379":2349,"_29619":2339,"_20556":55514,"_5":14099,"_26939":55486,"_2865":55515},[],"Record status",{"_3379":2350,"_29619":2339,"_20556":55517,"_5":14099,"_26939":55486,"_2865":55518},[],"Signed response",{"_3379":2351,"_29619":2339,"_20556":55520,"_5":14099,"_26939":55486,"_2865":52798},[],{"_3379":2352,"_29619":2339,"_20556":55522,"_5":14099,"_26939":55486,"_2865":55523},[],"`Good`.",{"_3379":2353,"_29619":2339,"_20556":55525,"_5":14099,"_26939":55486,"_2865":52815},[],{"_3379":2354,"_29619":2339,"_20556":55527,"_5":14099,"_26939":55486,"_2865":55528},[],"`Revoked`, with revocation reason and timestamp.",{"_3379":2355,"_29619":2339,"_20556":55530,"_5":14099,"_26939":55486,"_2865":55531},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3379":2356,"_29619":2339,"_20556":55533,"_5":14099,"_26939":55486,"_2865":55534},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3379":2357,"_29619":2339,"_20556":55536,"_5":14099,"_26939":55486,"_2865":55537},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3379":2358,"_29619":2339,"_20556":55539,"_5":14099,"_26939":55486,"_2865":55540},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3379":2359,"_29619":2339,"_20556":55542,"_5":14099,"_26939":55486,"_2865":55543},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3379":2360,"_29619":2339,"_20556":55545,"_5":14099,"_26939":55490,"_2865":55546},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3379":2361,"_29619":2339,"_20556":55548,"_5":14099,"_26939":55490,"_2865":55549},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3379":2362,"_29619":2339,"_20556":55551,"_5":14099,"_26939":55494,"_2865":55552},[],"The service accepts:",{"_3379":2363,"_29619":2339,"_20556":55554,"_5":14099,"_26939":55494,"_2865":51426},[],{"_3379":2364,"_29619":2339,"_20556":55556,"_5":14099,"_26939":55494,"_2865":55557},[],"VA service path",{"_3379":2365,"_29619":2339,"_20556":55559,"_5":14099,"_26939":55494,"_2865":55560},[],"Format",{"_3379":2366,"_29619":2339,"_20556":55562,"_5":14099,"_26939":55494,"_2865":55563},[],"`POST`",{"_3379":2367,"_29619":2339,"_20556":55565,"_5":14099,"_26939":55494,"_2865":55566},[],"`/ocsp`",{"_3379":2368,"_29619":2339,"_20556":55568,"_5":14099,"_26939":55494,"_2865":55569},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3379":2369,"_29619":2339,"_20556":55571,"_5":14099,"_26939":55494,"_2865":54992},[],{"_3379":2370,"_29619":2339,"_20556":55573,"_5":14099,"_26939":55494,"_2865":55574},[],"`/ocsp/{ocsp_request}`",{"_3379":2371,"_29619":2339,"_20556":55576,"_5":14099,"_26939":55494,"_2865":55577},[],"DER request encoded using padded URL Base64.",{"_3379":2372,"_29619":2339,"_20556":55579,"_5":14099,"_26939":55494,"_2865":55580},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3379":2373,"_29619":2339,"_20556":55582,"_5":14099,"_26939":55498,"_2865":55583},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3379":2374,"_29619":2339,"_20556":55585,"_5":14099,"_26939":55498,"_2865":55586},[],"Generate the request:",{"_3379":2375,"_29619":2339,"_20556":55588,"_5":14099,"_26939":55498,"_2865":55589},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3379":2376,"_29619":2339,"_20556":55591,"_5":14099,"_26939":55498,"_2865":55592},[],"Replace the example URL with the inspected endpoint:",{"_3379":2377,"_29619":2339,"_20556":55594,"_5":14099,"_26939":55498,"_2865":55595},[],"Verify the returned DER:",{"_3379":2378,"_29619":2339,"_20556":55597,"_5":14099,"_26939":55498,"_2865":55598},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3379":2379,"_29619":2339,"_20556":55600,"_5":14099,"_26939":55502,"_2865":55601},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3379":2380,"_29619":2339,"_20556":55603,"_5":14099,"_26939":55502,"_2865":55604},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3379":2381,"_29619":2339,"_20556":55606,"_5":14099,"_26939":55506,"_2865":55607},[],"RFC 6960: OCSP.",{"_3379":2382,"_29619":2339,"_20556":55609,"_5":14099,"_26939":55506,"_2865":55610},[],"OpenSSL: openssl-ocsp.",{"_3379":2383,"_29619":2339,"_20556":55612,"_5":14099,"_26939":55506,"_2865":55613},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3379":2384,"_29619":2339,"_20556":55615,"_5":14099,"_26939":55506,"_2865":55084},[],{"_3379":2385,"_29619":2385,"_5":14457,"_2865":53661,"_29951":55617,"_20556":55618,"_26939":2385},[48191,49659,53661],[],{"_3379":2386,"_29619":2385,"_20556":55620,"_5":14099,"_26939":2385,"_2865":55621},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3379":2387,"_29619":2385,"_5":29948,"_20556":55623,"_26939":55624,"_2865":52973},[],"/docs/platform/pki/overview#start-here",{"_3379":2388,"_29619":2385,"_5":29948,"_20556":55626,"_26939":55627,"_2865":55628},[],"/docs/platform/pki/overview#what-you-need","What you need",{"_3379":2389,"_29619":2385,"_5":29948,"_20556":55630,"_26939":55631,"_2865":53505},[],"/docs/platform/pki/overview#core-capabilities",{"_3379":2390,"_29619":2385,"_5":29948,"_20556":55633,"_26939":55634,"_2865":53509},[],"/docs/platform/pki/overview#build-your-trust-hierarchy",{"_3379":2391,"_29619":2385,"_5":29948,"_20556":55636,"_26939":55637,"_2865":53513},[],"/docs/platform/pki/overview#protect-cryptographic-keys",{"_3379":2392,"_29619":2385,"_5":29948,"_20556":55639,"_26939":55640,"_2865":53517},[],"/docs/platform/pki/overview#issue-and-control-certificates",{"_3379":2393,"_29619":2385,"_5":29948,"_20556":55642,"_26939":55643,"_2865":53525},[],"/docs/platform/pki/overview#publish-validation-status",{"_3379":2394,"_29619":2385,"_5":29948,"_20556":55645,"_26939":55646,"_2865":55647},[],"/docs/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3379":2395,"_29619":2385,"_5":29948,"_20556":55649,"_26939":55650,"_2865":54461},[],"/docs/platform/pki/overview#continue",{"_3379":2396,"_29619":2385,"_20556":55652,"_5":14099,"_26939":2385,"_2865":55653},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3379":2397,"_29619":2385,"_20556":55655,"_5":14099,"_26939":55624,"_2865":55656},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3379":2398,"_29619":2385,"_20556":55658,"_5":14099,"_26939":55624,"_2865":55659},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3379":2399,"_29619":2385,"_20556":55661,"_5":14099,"_26939":55627,"_2865":55662},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3379":2400,"_29619":2385,"_20556":55664,"_5":14099,"_26939":55627,"_2865":55665},[],"An available cryptographic engine to keep the authority's key.",{"_3379":2401,"_29619":2385,"_20556":55667,"_5":14099,"_26939":55627,"_2865":55668},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3379":2402,"_29619":2385,"_20556":55670,"_5":14099,"_26939":55627,"_2865":55671},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3379":2403,"_29619":2385,"_20556":55673,"_5":14099,"_26939":55627,"_2865":55674},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3379":2404,"_29619":2385,"_20556":55676,"_5":14099,"_26939":55634,"_2865":55677},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3379":2405,"_29619":2385,"_20556":55679,"_5":14099,"_26939":55637,"_2865":55680},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3379":2406,"_29619":2385,"_20556":55682,"_5":14099,"_26939":55640,"_2865":55683},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3379":2407,"_29619":2385,"_20556":55685,"_5":14099,"_26939":55643,"_2865":55686},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3379":2408,"_29619":2385,"_20556":55688,"_5":14099,"_26939":55646,"_2865":55689},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3379":2409,"_29619":2385,"_20556":55691,"_5":14099,"_26939":55646,"_2865":55692},[],"its subject and extensions identify the expected client;",{"_3379":2410,"_29619":2385,"_20556":55694,"_5":14099,"_26939":55646,"_2865":55695},[],"its public key matches the client's private key;",{"_3379":2411,"_29619":2385,"_20556":55697,"_5":14099,"_26939":55646,"_2865":55698},[],"its chain reaches a root trusted by the consumer;",{"_3379":2412,"_29619":2385,"_20556":55700,"_5":14099,"_26939":55646,"_2865":55701},[],"its dates and usages allow the operation;",{"_3379":2413,"_29619":2385,"_20556":55703,"_5":14099,"_26939":55646,"_2865":55704},[],"the consumer applies revocation checks and authorization.",{"_3379":2414,"_29619":2385,"_20556":55706,"_5":14099,"_26939":55646,"_2865":55707},[],"The issuance path includes the first independent checks.",{"_3379":2415,"_29619":2385,"_20556":55709,"_5":14099,"_26939":55650,"_2865":55710},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3379":2416,"_29619":2385,"_20556":55712,"_5":14099,"_26939":55650,"_2865":55713},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3379":2417,"_29619":2385,"_20556":55715,"_5":14099,"_26939":55650,"_2865":55716},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3379":2418,"_29619":2418,"_5":14457,"_2865":55718,"_29951":55719,"_20556":55720,"_26939":2418},"Create your first CA",[48191,49659,53661,53098],[],{"_3379":2419,"_29619":2418,"_20556":55722,"_5":14099,"_26939":2418,"_2865":55723},[],"Create an evaluation root and check its certificate before issuing.",{"_3379":2420,"_29619":2418,"_5":29948,"_20556":55725,"_26939":55726,"_2865":48201},[],"/docs/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3379":2421,"_29619":2418,"_5":29948,"_20556":55728,"_26939":55729,"_2865":55730},[],"/docs/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3379":2422,"_29619":2418,"_5":29948,"_20556":55732,"_26939":55733,"_2865":55734},[],"/docs/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3379":2423,"_29619":2418,"_5":29948,"_20556":55736,"_26939":55737,"_2865":55738},[],"/docs/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3379":2424,"_29619":2418,"_5":29948,"_20556":55740,"_26939":55741,"_2865":55742},[],"/docs/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3379":2425,"_29619":2418,"_5":29948,"_20556":55744,"_26939":55745,"_2865":55746},[],"/docs/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3379":2426,"_29619":2418,"_5":29948,"_20556":55748,"_26939":55749,"_2865":55750},[],"/docs/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3379":2427,"_29619":2418,"_5":29948,"_20556":55752,"_26939":55753,"_2865":53355},[],"/docs/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3379":2428,"_29619":2418,"_5":29948,"_20556":55755,"_26939":55756,"_2865":48225},[],"/docs/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3379":2429,"_29619":2418,"_20556":55758,"_5":14099,"_26939":2418,"_2865":55759},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3379":2430,"_29619":2418,"_20556":55761,"_5":14099,"_26939":55726,"_2865":55762},[],"Console access and permission to create keys and authorities.",{"_3379":2431,"_29619":2418,"_20556":55764,"_5":14099,"_26939":55726,"_2865":55765},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3379":2432,"_29619":2418,"_20556":55767,"_5":14099,"_26939":55726,"_2865":55768},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3379":2433,"_29619":2418,"_20556":55770,"_5":14099,"_26939":55726,"_2865":55771},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3379":2434,"_29619":2418,"_20556":55773,"_5":14099,"_26939":55729,"_2865":55774},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3379":2435,"_29619":2418,"_20556":55776,"_5":14099,"_26939":55729,"_2865":55777},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3379":2436,"_29619":2418,"_20556":55779,"_5":14099,"_26939":55733,"_2865":55780},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3379":2437,"_29619":2418,"_20556":55782,"_5":14099,"_26939":55733,"_2865":55783},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3379":2438,"_29619":2418,"_20556":55785,"_5":14099,"_26939":55737,"_2865":55786},[],"Select **Root CA** and complete:",{"_3379":2439,"_29619":2418,"_20556":55788,"_5":14099,"_26939":55737,"_2865":55789},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3379":2440,"_29619":2418,"_20556":55791,"_5":14099,"_26939":55737,"_2865":55792},[],"**Subject**: organization and country details for your evaluation.",{"_3379":2441,"_29619":2418,"_20556":55794,"_5":14099,"_26939":55737,"_2865":55795},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3379":2442,"_29619":2418,"_20556":55797,"_5":14099,"_26939":55737,"_2865":55798},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3379":2443,"_29619":2418,"_20556":55800,"_5":14099,"_26939":55737,"_2865":55801},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3379":2444,"_29619":2418,"_20556":55803,"_5":14099,"_26939":55741,"_2865":55804},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3379":2445,"_29619":2418,"_20556":55806,"_5":14099,"_26939":55745,"_2865":55807},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3379":2446,"_29619":2418,"_20556":55809,"_5":14099,"_26939":55745,"_2865":55810},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3379":2447,"_29619":2418,"_20556":55812,"_5":14099,"_26939":55749,"_2865":55813},[],"Run from the directory where you saved `ca.pem`:",{"_3379":2448,"_29619":2418,"_20556":55815,"_5":14099,"_26939":55749,"_2865":55816},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3379":2449,"_29619":2418,"_20556":55818,"_5":14099,"_26939":55749,"_2865":55819},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3379":2450,"_29619":2418,"_20556":55821,"_5":14099,"_26939":55753,"_2865":55822},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3379":2451,"_29619":2418,"_20556":55824,"_5":14099,"_26939":55753,"_2865":55825},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3379":2452,"_29619":2418,"_20556":55827,"_5":14099,"_26939":55753,"_2865":55828},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3379":2453,"_29619":2418,"_20556":55830,"_5":14099,"_26939":55753,"_2865":55831},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3379":2454,"_29619":2418,"_20556":55833,"_5":14099,"_26939":55756,"_2865":55834},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3379":2455,"_29619":2455,"_5":14457,"_2865":55836,"_29951":55837,"_20556":55838,"_26939":2455},"Issue and verify a certificate",[48191,49659,53661,53098],[],{"_3379":2456,"_29619":2455,"_20556":55840,"_5":14099,"_26939":2455,"_2865":55841},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3379":2457,"_29619":2455,"_5":29948,"_20556":55843,"_26939":55844,"_2865":48201},[],"/docs/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3379":2458,"_29619":2455,"_5":29948,"_20556":55846,"_26939":55847,"_2865":55848},[],"/docs/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3379":2459,"_29619":2455,"_5":29948,"_20556":55850,"_26939":55851,"_2865":55852},[],"/docs/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3379":2460,"_29619":2455,"_5":29948,"_20556":55854,"_26939":55855,"_2865":55856},[],"/docs/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3379":2461,"_29619":2455,"_5":29948,"_20556":55858,"_26939":55859,"_2865":55860},[],"/docs/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3379":2462,"_29619":2455,"_5":29948,"_20556":55862,"_26939":55863,"_2865":55864},[],"/docs/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3379":2463,"_29619":2455,"_5":29948,"_20556":55866,"_26939":55867,"_2865":55868},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3379":2464,"_29619":2455,"_5":29948,"_20556":55870,"_26939":55871,"_2865":55872},[],"/docs/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3379":2465,"_29619":2455,"_5":29948,"_20556":55874,"_26939":55875,"_2865":55876},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3379":2466,"_29619":2455,"_5":29948,"_20556":55878,"_26939":55879,"_2865":55880},[],"/docs/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3379":2467,"_29619":2455,"_5":29948,"_20556":55882,"_26939":55883,"_2865":53355},[],"/docs/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3379":2468,"_29619":2455,"_5":29948,"_20556":55885,"_26939":55886,"_2865":48225},[],"/docs/platform/pki/quickstarts/issue-certificate#next-step",{"_3379":2469,"_29619":2455,"_20556":55888,"_5":14099,"_26939":2455,"_2865":55889},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3379":2470,"_29619":2455,"_20556":55891,"_5":14099,"_26939":55844,"_2865":55892},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3379":2471,"_29619":2455,"_20556":55894,"_5":14099,"_26939":55844,"_2865":55895},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3379":2472,"_29619":2455,"_20556":55897,"_5":14099,"_26939":55844,"_2865":55898},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3379":2473,"_29619":2455,"_20556":55900,"_5":14099,"_26939":55844,"_2865":55901},[],"A client identifier: here we use `device-001`.",{"_3379":2474,"_29619":2455,"_20556":55903,"_5":14099,"_26939":55844,"_2865":55904},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3379":2475,"_29619":2455,"_20556":55906,"_5":14099,"_26939":55847,"_2865":55907},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3379":2476,"_29619":2455,"_20556":55909,"_5":14099,"_26939":55851,"_2865":55910},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3379":2477,"_29619":2455,"_20556":55912,"_5":14099,"_26939":55851,"_2865":55913},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3379":2478,"_29619":2455,"_20556":55915,"_5":14099,"_26939":55855,"_2865":55916},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3379":2479,"_29619":2455,"_20556":55918,"_5":14099,"_26939":55855,"_2865":55919},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3379":2480,"_29619":2455,"_20556":55921,"_5":14099,"_26939":55859,"_2865":55922},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3379":2481,"_29619":2455,"_20556":55924,"_5":14099,"_26939":55859,"_2865":55925},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3379":2482,"_29619":2455,"_20556":55927,"_5":14099,"_26939":55863,"_2865":55928},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3379":2483,"_29619":2455,"_20556":55930,"_5":14099,"_26939":55867,"_2865":55931},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3379":2484,"_29619":2455,"_20556":55933,"_5":14099,"_26939":55871,"_2865":55934},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3379":2485,"_29619":2455,"_20556":55936,"_5":14099,"_26939":55875,"_2865":55937},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3379":2486,"_29619":2455,"_20556":55939,"_5":14099,"_26939":55875,"_2865":55940},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3379":2487,"_29619":2455,"_20556":55942,"_5":14099,"_26939":55875,"_2865":55943},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3379":2488,"_29619":2455,"_20556":55945,"_5":14099,"_26939":55879,"_2865":55946},[],"In Bash, compare the two public-key digests:",{"_3379":2489,"_29619":2455,"_20556":55948,"_5":14099,"_26939":55879,"_2865":55949},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3379":2490,"_29619":2455,"_20556":55951,"_5":14099,"_26939":55879,"_2865":55952},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3379":2491,"_29619":2455,"_20556":55954,"_5":14099,"_26939":55883,"_2865":53439},[],{"_3379":2492,"_29619":2455,"_20556":55956,"_5":14099,"_26939":55883,"_2865":55957},[],"What to review",{"_3379":2493,"_29619":2455,"_20556":55959,"_5":14099,"_26939":55883,"_2865":55960},[],"The CA rejects issuance",{"_3379":2494,"_29619":2455,"_20556":55962,"_5":14099,"_26939":55883,"_2865":55963},[],"Permissions, CA state and key, algorithm and profile.",{"_3379":2495,"_29619":2455,"_20556":55965,"_5":14099,"_26939":55883,"_2865":55966},[],"Different subject or usages",{"_3379":2496,"_29619":2455,"_20556":55968,"_5":14099,"_26939":55883,"_2865":55969},[],"Applied profile and requested values.",{"_3379":2497,"_29619":2455,"_20556":55971,"_5":14099,"_26939":55883,"_2865":55972},[],"Issuer cannot be found",{"_3379":2498,"_29619":2455,"_20556":55974,"_5":14099,"_26939":55883,"_2865":55975},[],"Downloaded CA and required intermediate chain.",{"_3379":2499,"_29619":2455,"_20556":55977,"_5":14099,"_26939":55883,"_2865":55978},[],"Validity fails",{"_3379":2500,"_29619":2455,"_20556":55980,"_5":14099,"_26939":55883,"_2865":55981},[],"Certificate and CA dates, and the computer's clock.",{"_3379":2501,"_29619":2455,"_20556":55983,"_5":14099,"_26939":55883,"_2865":55984},[],"Public-key digests differ",{"_3379":2502,"_29619":2455,"_20556":55986,"_5":14099,"_26939":55883,"_2865":55987},[],"Certificate and key files from the same issuance.",{"_3379":2503,"_29619":2455,"_20556":55989,"_5":14099,"_26939":55883,"_2865":55990},[],"See PKI diagnostics to narrow an issuance failure.",{"_3379":2504,"_29619":2455,"_20556":55992,"_5":14099,"_26939":55886,"_2865":55993},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3379":2505,"_29619":2455,"_20556":55995,"_5":14099,"_26939":55886,"_2865":55996},[],"Manage certificates for inspection, status and revocation.",{"_3379":2506,"_29619":2455,"_20556":55998,"_5":14099,"_26939":55886,"_2865":55999},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3379":2507,"_29619":2455,"_20556":56001,"_5":14099,"_26939":55886,"_2865":56002},[],"Prepare EST for the device to request its next identities.",{"_3379":2508,"_29619":2455,"_20556":56004,"_5":14099,"_26939":55886,"_2865":56005},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3379":2509,"_29619":2509,"_5":14457,"_2865":56007,"_29951":56008,"_20556":56009,"_26939":2509},"PKI getting started",[48191,49659,53661,53098],[],{"_3379":2510,"_29619":2509,"_20556":56011,"_5":14099,"_26939":2509,"_2865":56012},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3379":2511,"_29619":2509,"_5":29948,"_20556":56014,"_26939":56015,"_2865":48201},[],"/docs/platform/pki/quickstarts/overview#before-you-begin",{"_3379":2512,"_29619":2509,"_5":29948,"_20556":56017,"_26939":56018,"_2865":56019},[],"/docs/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3379":2513,"_29619":2509,"_5":29948,"_20556":56021,"_26939":56022,"_2865":53290},[],"/docs/platform/pki/quickstarts/overview#expected-result",{"_3379":2514,"_29619":2509,"_5":29948,"_20556":56024,"_26939":56025,"_2865":56026},[],"/docs/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3379":2515,"_29619":2509,"_20556":56028,"_5":14099,"_26939":2509,"_2865":56029},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3379":2516,"_29619":2509,"_20556":56031,"_5":14099,"_26939":56015,"_2865":56032},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3379":2517,"_29619":2509,"_20556":56034,"_5":14099,"_26939":56015,"_2865":56035},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3379":2518,"_29619":2509,"_20556":56037,"_5":14099,"_26939":56015,"_2865":56038},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3379":2519,"_29619":2509,"_20556":56040,"_5":14099,"_26939":56015,"_2865":56041},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3379":2520,"_29619":2509,"_20556":56043,"_5":14099,"_26939":56015,"_2865":56044},[],"A working directory with restricted access for the downloaded key.",{"_3379":2521,"_29619":2509,"_20556":56046,"_5":14099,"_26939":56018,"_2865":56047},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3379":2522,"_29619":2509,"_20556":56049,"_5":14099,"_26939":56018,"_2865":56050},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3379":2523,"_29619":2509,"_20556":56052,"_5":14099,"_26939":56018,"_2865":56053},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3379":2524,"_29619":2509,"_20556":56055,"_5":14099,"_26939":56018,"_2865":56056},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3379":2525,"_29619":2509,"_20556":56058,"_5":14099,"_26939":56022,"_2865":56059},[],"File or resource",{"_3379":2526,"_29619":2509,"_20556":56061,"_5":14099,"_26939":56022,"_2865":53287},[],{"_3379":2527,"_29619":2509,"_20556":56063,"_5":14099,"_26939":56022,"_2865":56064},[],"Active root CA and `ca.pem`",{"_3379":2528,"_29619":2509,"_20556":56066,"_5":14099,"_26939":56022,"_2865":56067},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3379":2529,"_29619":2509,"_20556":56069,"_5":14099,"_26939":56022,"_2865":56070},[],"End-entity certificate and `device.crt`",{"_3379":2530,"_29619":2509,"_20556":56072,"_5":14099,"_26939":56022,"_2865":56073},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3379":2531,"_29619":2509,"_20556":56075,"_5":14099,"_26939":56022,"_2865":56076},[],"Private key `device.key`",{"_3379":2532,"_29619":2509,"_20556":56078,"_5":14099,"_26939":56022,"_2865":56079},[],"Its public key matches the one included in `device.crt`.",{"_3379":2533,"_29619":2509,"_20556":56081,"_5":14099,"_26939":56022,"_2865":56082},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3379":2534,"_29619":2509,"_20556":56084,"_5":14099,"_26939":56025,"_2865":56085},[],"To operate certificates, continue with Certificates and Validation.",{"_3379":2535,"_29619":2509,"_20556":56087,"_5":14099,"_26939":56025,"_2865":56088},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3379":2536,"_29619":2509,"_20556":56090,"_5":14099,"_26939":56025,"_2865":56091},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3379":2537,"_29619":2537,"_5":14457,"_2865":56093,"_29951":56094,"_20556":56095,"_26939":2537},"PKI troubleshooting",[48191,49659,53661,52236],[],{"_3379":2538,"_29619":2537,"_20556":56097,"_5":14099,"_26939":2537,"_2865":56098},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3379":2539,"_29619":2537,"_5":29948,"_20556":56100,"_26939":56101,"_2865":56102},[],"/docs/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3379":2540,"_29619":2537,"_5":29948,"_20556":56104,"_26939":56105,"_2865":56106},[],"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3379":2541,"_29619":2537,"_5":29948,"_20556":56108,"_26939":56109,"_2865":56110},[],"/docs/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3379":2542,"_29619":2537,"_20556":56112,"_5":14099,"_26939":2537,"_2865":56113},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3379":2543,"_29619":2537,"_20556":56115,"_5":14099,"_26939":2537,"_2865":56116},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3379":2544,"_29619":2537,"_20556":56118,"_5":14099,"_26939":56101,"_2865":53287},[],{"_3379":2545,"_29619":2537,"_20556":56120,"_5":14099,"_26939":56101,"_2865":56121},[],"What to inspect",{"_3379":2546,"_29619":2537,"_20556":56123,"_5":14099,"_26939":56101,"_2865":48225},[],{"_3379":2547,"_29619":2537,"_20556":56125,"_5":14099,"_26939":56101,"_2865":52503},[],{"_3379":2548,"_29619":2537,"_20556":56127,"_5":14099,"_26939":56101,"_2865":56128},[],"Exists, is active and has usable dates.",{"_3379":2549,"_29619":2537,"_20556":56130,"_5":14099,"_26939":56101,"_2865":56131},[],"Authorities.",{"_3379":2550,"_29619":2537,"_20556":56133,"_5":14099,"_26939":56101,"_2865":56134},[],"Key",{"_3379":2551,"_29619":2537,"_20556":56136,"_5":14099,"_26939":56101,"_2865":56137},[],"The record has a usable private key and the engine can sign.",{"_3379":2552,"_29619":2537,"_20556":56139,"_5":14099,"_26939":56101,"_2865":56140},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3379":2553,"_29619":2537,"_20556":56142,"_5":14099,"_26939":56101,"_2865":56143},[],"CSR",{"_3379":2554,"_29619":2537,"_20556":56145,"_5":14099,"_26939":56101,"_2865":56146},[],"Correct PEM and verifiable signature.",{"_3379":2555,"_29619":2537,"_20556":56148,"_5":14099,"_26939":56101,"_2865":56149},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3379":2556,"_29619":2537,"_20556":56151,"_5":14099,"_26939":56101,"_2865":56152},[],"Profile",{"_3379":2557,"_29619":2537,"_20556":56154,"_5":14099,"_26939":56101,"_2865":56155},[],"Selected source, existing ID, allowed algorithm and size.",{"_3379":2558,"_29619":2537,"_20556":56157,"_5":14099,"_26939":56101,"_2865":56158},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3379":2559,"_29619":2537,"_20556":56160,"_5":14099,"_26939":56101,"_2865":53439},[],{"_3379":2560,"_29619":2537,"_20556":56162,"_5":14099,"_26939":56101,"_2865":56163},[],"Appropriate subject, SAN, usages and dates.",{"_3379":2561,"_29619":2537,"_20556":56165,"_5":14099,"_26939":56101,"_2865":56166},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3379":2562,"_29619":2537,"_20556":56168,"_5":14099,"_26939":56101,"_2865":56169},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3379":2563,"_29619":2537,"_20556":56171,"_5":14099,"_26939":56101,"_2865":56172},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3379":2564,"_29619":2537,"_20556":56174,"_5":14099,"_26939":56105,"_2865":56175},[],"Check each boundary independently:",{"_3379":2565,"_29619":2537,"_20556":56177,"_5":14099,"_26939":56105,"_2865":56178},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3379":2566,"_29619":2537,"_20556":56180,"_5":14099,"_26939":56105,"_2865":56181},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3379":2567,"_29619":2537,"_20556":56183,"_5":14099,"_26939":56105,"_2865":56184},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3379":2568,"_29619":2537,"_20556":56186,"_5":14099,"_26939":56105,"_2865":56187},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3379":2569,"_29619":2537,"_20556":56189,"_5":14099,"_26939":56105,"_2865":56190},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3379":2570,"_29619":2537,"_20556":56192,"_5":14099,"_26939":56105,"_2865":56193},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3379":2571,"_29619":2537,"_20556":56195,"_5":14099,"_26939":56109,"_2865":56196},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3379":2572,"_29619":2537,"_20556":56198,"_5":14099,"_26939":56109,"_2865":56199},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3379":2573,"_29619":2573,"_5":14457,"_2865":56201,"_29951":56202,"_20556":56203,"_26939":2573},"Security",[48191],[],{"_3379":2574,"_29619":2573,"_20556":56205,"_5":14099,"_26939":2573,"_2865":56206},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3379":2575,"_29619":2573,"_5":29948,"_20556":56208,"_26939":56209,"_2865":56210},[],"/docs/security#report-a-vulnerability","Report a vulnerability",{"_3379":2576,"_29619":2573,"_5":29948,"_20556":56212,"_26939":56213,"_2865":56214},[],"/docs/security#what-to-include-in-a-report","What to include in a report",{"_3379":2577,"_29619":2573,"_5":29948,"_20556":56216,"_26939":56217,"_2865":56218},[],"/docs/security#supported-versions","Supported versions",{"_3379":2578,"_29619":2573,"_5":29948,"_20556":56220,"_26939":56221,"_2865":56222},[],"/docs/security#responsible-disclosure","Responsible disclosure",{"_3379":2579,"_29619":2573,"_20556":56224,"_5":14099,"_26939":2573,"_2865":56225},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3379":2580,"_29619":2573,"_20556":56227,"_5":14099,"_26939":56209,"_2865":56228},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3379":2581,"_29619":2573,"_20556":56230,"_5":14099,"_26939":56209,"_2865":56231},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3379":2582,"_29619":2573,"_20556":56233,"_5":14099,"_26939":56209,"_2865":14724},[],{"_3379":2583,"_29619":2573,"_20556":56235,"_5":14099,"_26939":56209,"_2865":14670},[],{"_3379":2584,"_29619":2573,"_20556":56237,"_5":14099,"_26939":56209,"_2865":14717},[],{"_3379":2585,"_29619":2573,"_20556":56239,"_5":14099,"_26939":56209,"_2865":56240},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3379":2586,"_29619":2573,"_20556":56242,"_5":14099,"_26939":56209,"_2865":56243},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3379":2587,"_29619":2573,"_20556":56245,"_5":14099,"_26939":56213,"_2865":56246},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3379":2588,"_29619":2573,"_20556":56248,"_5":14099,"_26939":56213,"_2865":56249},[],"Do not include in the report:",{"_3379":2589,"_29619":2573,"_20556":56251,"_5":14099,"_26939":56213,"_2865":56252},[],"Credentials, tokens, or private keys",{"_3379":2590,"_29619":2573,"_20556":56254,"_5":14099,"_26939":56213,"_2865":56255},[],"Customer data or customer-identifiable information",{"_3379":2591,"_29619":2573,"_20556":56257,"_5":14099,"_26939":56213,"_2865":56258},[],"Confidential architecture or internal infrastructure details",{"_3379":2592,"_29619":2573,"_20556":56260,"_5":14099,"_26939":56217,"_2865":56261},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3379":2593,"_29619":2573,"_20556":56263,"_5":14099,"_26939":56217,"_2865":56264},[],"For upgrade guidance, see Upgrades.",{"_3379":2594,"_29619":2573,"_20556":56266,"_5":14099,"_26939":56221,"_2865":56267},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3379":2595,"_29619":2573,"_20556":56269,"_5":14099,"_26939":56221,"_2865":56270},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3379":2596,"_29619":2573,"_20556":56272,"_5":14099,"_26939":56221,"_2865":56273},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3379":2597,"_29619":2573,"_20556":56275,"_5":14099,"_26939":56221,"_2865":56276},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3379":2598,"_29619":2573,"_20556":56278,"_5":14099,"_26939":56221,"_2865":56279},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3379":2599,"_29619":2599,"_5":14457,"_2865":56281,"_29951":56282,"_20556":56284,"_26939":2599},"3.8.0 to 4.0.0",[48191,56283],"Upgrades",[],{"_3379":2600,"_29619":2599,"_20556":56286,"_5":14099,"_26939":2599,"_2865":56287},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3379":2601,"_29619":2599,"_5":29948,"_20556":56289,"_26939":56290,"_2865":56291},[],"/docs/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3379":2602,"_29619":2599,"_5":29948,"_20556":56293,"_26939":56294,"_2865":56295},[],"/docs/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3379":2603,"_29619":2599,"_5":29948,"_20556":56297,"_26939":56298,"_2865":56299},[],"/docs/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3379":2604,"_29619":2599,"_5":29948,"_20556":56301,"_26939":56302,"_2865":56303},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3379":2605,"_29619":2599,"_5":29948,"_20556":56305,"_26939":56306,"_2865":56307},[],"/docs/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3379":2606,"_29619":2599,"_5":29948,"_20556":56309,"_26939":56310,"_2865":56311},[],"/docs/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3379":2607,"_29619":2599,"_5":29948,"_20556":56313,"_26939":56314,"_2865":56315},[],"/docs/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3379":2608,"_29619":2599,"_5":29948,"_20556":56317,"_26939":56318,"_2865":56319},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3379":2609,"_29619":2599,"_5":29948,"_20556":56321,"_26939":56322,"_2865":56323},[],"/docs/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3379":2610,"_29619":2599,"_5":29948,"_20556":56325,"_26939":56326,"_2865":56327},[],"/docs/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3379":2611,"_29619":2599,"_5":29948,"_20556":56329,"_26939":56330,"_2865":56331},[],"/docs/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3379":2612,"_29619":2599,"_5":29948,"_20556":56333,"_26939":56334,"_2865":56335},[],"/docs/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3379":2613,"_29619":2599,"_5":29948,"_20556":56337,"_26939":56338,"_2865":56339},[],"/docs/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3379":2614,"_29619":2599,"_5":29948,"_20556":56341,"_26939":56342,"_2865":56343},[],"/docs/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3379":2615,"_29619":2599,"_5":29948,"_20556":56345,"_26939":56346,"_2865":56347},[],"/docs/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3379":2616,"_29619":2599,"_5":29948,"_20556":56349,"_26939":56350,"_2865":56351},[],"/docs/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3379":2617,"_29619":2599,"_5":29948,"_20556":56353,"_26939":56354,"_2865":56355},[],"/docs/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3379":2618,"_29619":2599,"_5":29948,"_20556":56357,"_26939":56358,"_2865":56359},[],"/docs/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3379":2619,"_29619":2599,"_5":29948,"_20556":56361,"_26939":56362,"_2865":56363},[],"/docs/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3379":2620,"_29619":2599,"_5":29948,"_20556":56365,"_26939":56366,"_2865":56367},[],"/docs/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-va-roles","References between certificates, keys and VA roles",{"_3379":2621,"_29619":2599,"_5":29948,"_20556":56369,"_26939":56370,"_2865":56371},[],"/docs/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3379":2622,"_29619":2599,"_5":29948,"_20556":56373,"_26939":56374,"_2865":56375},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3379":2623,"_29619":2599,"_5":29948,"_20556":56377,"_26939":56378,"_2865":56379},[],"/docs/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3379":2624,"_29619":2599,"_5":29948,"_20556":56381,"_26939":56382,"_2865":56383},[],"/docs/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3379":2625,"_29619":2599,"_5":29948,"_20556":56385,"_26939":56386,"_2865":56387},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3379":2626,"_29619":2599,"_5":29948,"_20556":56389,"_26939":56390,"_2865":56391},[],"/docs/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3379":2627,"_29619":2599,"_5":29948,"_20556":56393,"_26939":56394,"_2865":56395},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3379":2628,"_29619":2599,"_5":29948,"_20556":56397,"_26939":56398,"_2865":56399},[],"/docs/upgrades/3-8-0-to-4-0-0#va-role-signer-field","VA role signer field",{"_3379":2629,"_29619":2599,"_5":29948,"_20556":56401,"_26939":56402,"_2865":56403},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3379":2630,"_29619":2599,"_5":29948,"_20556":56405,"_26939":56406,"_2865":56407},[],"/docs/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3379":2631,"_29619":2599,"_5":29948,"_20556":56409,"_26939":56410,"_2865":56411},[],"/docs/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3379":2632,"_29619":2599,"_5":29948,"_20556":56413,"_26939":56414,"_2865":56415},[],"/docs/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3379":2633,"_29619":2599,"_5":29948,"_20556":56417,"_26939":56418,"_2865":56419},[],"/docs/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3379":2634,"_29619":2599,"_5":29948,"_20556":56421,"_26939":56422,"_2865":56423},[],"/docs/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3379":2635,"_29619":2599,"_5":29948,"_20556":56425,"_26939":56426,"_2865":56427},[],"/docs/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3379":2636,"_29619":2599,"_5":29948,"_20556":56429,"_26939":56430,"_2865":52236},[],"/docs/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3379":2637,"_29619":2599,"_5":29948,"_20556":56432,"_26939":56433,"_2865":56434},[],"/docs/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3379":2638,"_29619":2599,"_5":29948,"_20556":56436,"_26939":56437,"_2865":56438},[],"/docs/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3379":2639,"_29619":2599,"_20556":56440,"_5":14099,"_26939":2599,"_2865":56441},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3379":2640,"_29619":2599,"_20556":56443,"_5":14099,"_26939":2599,"_2865":56444},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3379":2641,"_29619":2599,"_20556":56446,"_5":14099,"_26939":2599,"_2865":56447},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3379":2642,"_29619":2599,"_20556":56449,"_5":14099,"_26939":2599,"_2865":56450},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3379":2643,"_29619":2599,"_20556":56452,"_5":14099,"_26939":2599,"_2865":56453},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3379":2644,"_29619":2599,"_20556":56455,"_5":14099,"_26939":2599,"_2865":56456},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3379":2645,"_29619":2599,"_20556":56458,"_5":14099,"_26939":2599,"_2865":56459},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3379":2646,"_29619":2599,"_20556":56461,"_5":14099,"_26939":56294,"_2865":56462},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3379":2647,"_29619":2599,"_20556":56464,"_5":14099,"_26939":56294,"_2865":56465},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3379":2648,"_29619":2599,"_20556":56467,"_5":14099,"_26939":56298,"_2865":56468},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3379":2649,"_29619":2599,"_20556":56470,"_5":14099,"_26939":56298,"_2865":56471},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and VA roles. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3379":2650,"_29619":2599,"_20556":56473,"_5":14099,"_26939":56302,"_2865":56474},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3379":2651,"_29619":2599,"_20556":56476,"_5":14099,"_26939":56306,"_2865":56477},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3379":2652,"_29619":2599,"_20556":56479,"_5":14099,"_26939":56306,"_2865":56480},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3379":2653,"_29619":2599,"_20556":56482,"_5":14099,"_26939":56306,"_2865":56483},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3379":2654,"_29619":2599,"_20556":56485,"_5":14099,"_26939":56306,"_2865":56486},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3379":2655,"_29619":2599,"_20556":56488,"_5":14099,"_26939":56306,"_2865":56489},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3379":2656,"_29619":2599,"_20556":56491,"_5":14099,"_26939":56310,"_2865":56492},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3379":2657,"_29619":2599,"_20556":56494,"_5":14099,"_26939":56310,"_2865":56495},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3379":2658,"_29619":2599,"_20556":56497,"_5":14099,"_26939":56310,"_2865":56498},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3379":2659,"_29619":2599,"_20556":56500,"_5":14099,"_26939":56310,"_2865":56501},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3379":2660,"_29619":2599,"_20556":56503,"_5":14099,"_26939":56310,"_2865":56504},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3379":2661,"_29619":2599,"_20556":56506,"_5":14099,"_26939":56314,"_2865":56507},[],"Change",{"_3379":2662,"_29619":2599,"_20556":56509,"_5":14099,"_26939":56314,"_2865":56510},[],"Who is affected",{"_3379":2663,"_29619":2599,"_20556":56512,"_5":14099,"_26939":56314,"_2865":56513},[],"Severity",{"_3379":2664,"_29619":2599,"_20556":56515,"_5":14099,"_26939":56314,"_2865":55021},[],{"_3379":2665,"_29619":2599,"_20556":56517,"_5":14099,"_26939":56314,"_2865":56323},[],{"_3379":2666,"_29619":2599,"_20556":56519,"_5":14099,"_26939":56314,"_2865":56520},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3379":2667,"_29619":2599,"_20556":56522,"_5":14099,"_26939":56314,"_2865":56523},[],"High: KMS and VA start on empty volumes",{"_3379":2668,"_29619":2599,"_20556":56525,"_5":14099,"_26939":56314,"_2865":56526},[],"Copy the data into the new volumes",{"_3379":2669,"_29619":2599,"_20556":56528,"_5":14099,"_26939":56314,"_2865":56327},[],{"_3379":2670,"_29619":2599,"_20556":56530,"_5":14099,"_26939":56314,"_2865":56531},[],"Every Helm release",{"_3379":2671,"_29619":2599,"_20556":56533,"_5":14099,"_26939":56314,"_2865":56534},[],"High: `helm upgrade` fails",{"_3379":2672,"_29619":2599,"_20556":56536,"_5":14099,"_26939":56314,"_2865":56537},[],"Remove or rename legacy keys",{"_3379":2673,"_29619":2599,"_20556":56539,"_5":14099,"_26939":56314,"_2865":56331},[],{"_3379":2674,"_29619":2599,"_20556":56541,"_5":14099,"_26939":56314,"_2865":56542},[],"Every deployment",{"_3379":2675,"_29619":2599,"_20556":56544,"_5":14099,"_26939":56314,"_2865":56545},[],"High: without a bootstrap principal there is no administrator",{"_3379":2676,"_29619":2599,"_20556":56547,"_5":14099,"_26939":56314,"_2865":56548},[],"Configure `services.authz`",{"_3379":2677,"_29619":2599,"_20556":56550,"_5":14099,"_26939":56314,"_2865":56335},[],{"_3379":2678,"_29619":2599,"_20556":56552,"_5":14099,"_26939":56314,"_2865":56531},[],{"_3379":2679,"_29619":2599,"_20556":56554,"_5":14099,"_26939":56314,"_2865":56555},[],"High: `helm upgrade` fails on the old keys",{"_3379":2680,"_29619":2599,"_20556":56557,"_5":14099,"_26939":56314,"_2865":56558},[],"Move JWKS and roles into `services.authz`",{"_3379":2681,"_29619":2599,"_20556":56560,"_5":14099,"_26939":56314,"_2865":56355},[],{"_3379":2682,"_29619":2599,"_20556":56562,"_5":14099,"_26939":56314,"_2865":56563},[],"3.8.0 deployments with per-service databases",{"_3379":2683,"_29619":2599,"_20556":56565,"_5":14099,"_26939":56314,"_2865":56566},[],"High: services find no data, or a migration aborts",{"_3379":2684,"_29619":2599,"_20556":56568,"_5":14099,"_26939":56314,"_2865":56569},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3379":2685,"_29619":2599,"_20556":56571,"_5":14099,"_26939":56314,"_2865":56359},[],{"_3379":2686,"_29619":2599,"_20556":56573,"_5":14099,"_26939":56314,"_2865":56574},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3379":2687,"_29619":2599,"_20556":56576,"_5":14099,"_26939":56314,"_2865":56577},[],"High: the backend no longer starts with them",{"_3379":2688,"_29619":2599,"_20556":56579,"_5":14099,"_26939":56314,"_2865":56580},[],"Move to PostgreSQL before upgrading",{"_3379":2689,"_29619":2599,"_20556":56582,"_5":14099,"_26939":56314,"_2865":56583},[],"Webhooks with file references",{"_3379":2690,"_29619":2599,"_20556":56585,"_5":14099,"_26939":56314,"_2865":56586},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3379":2691,"_29619":2599,"_20556":56588,"_5":14099,"_26939":56314,"_2865":56589},[],"High: enrollments calling the webhook fail",{"_3379":2692,"_29619":2599,"_20556":56591,"_5":14099,"_26939":56314,"_2865":56592},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3379":2693,"_29619":2599,"_20556":56594,"_5":14099,"_26939":56314,"_2865":56339},[],{"_3379":2694,"_29619":2599,"_20556":56596,"_5":14099,"_26939":56314,"_2865":56597},[],"Releases with per-service identity overrides or mounted key material",{"_3379":2695,"_29619":2599,"_20556":56599,"_5":14099,"_26939":56314,"_2865":56600},[],"Medium: services cannot read their files",{"_3379":2696,"_29619":2599,"_20556":56602,"_5":14099,"_26939":56314,"_2865":56603},[],"Remove the overrides and fix volume ownership",{"_3379":2697,"_29619":2599,"_20556":56605,"_5":14099,"_26939":56314,"_2865":56343},[],{"_3379":2698,"_29619":2599,"_20556":56607,"_5":14099,"_26939":56314,"_2865":56608},[],"Releases that set `amqp.tls`",{"_3379":2699,"_29619":2599,"_20556":56610,"_5":14099,"_26939":56314,"_2865":56611},[],"Medium: clients connect to the wrong port",{"_3379":2700,"_29619":2599,"_20556":56613,"_5":14099,"_26939":56314,"_2865":56614},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3379":2701,"_29619":2599,"_20556":56616,"_5":14099,"_26939":56314,"_2865":56363},[],{"_3379":2702,"_29619":2599,"_20556":56618,"_5":14099,"_26939":56314,"_2865":56619},[],"Installations whose CA keys predate the KMS",{"_3379":2703,"_29619":2599,"_20556":56621,"_5":14099,"_26939":56314,"_2865":56622},[],"Medium: CA keys stay unmanaged",{"_3379":2704,"_29619":2599,"_20556":56624,"_5":14099,"_26939":56314,"_2865":56625},[],"Run the CA-to-KMS migration",{"_3379":2705,"_29619":2599,"_20556":56627,"_5":14099,"_26939":56314,"_2865":56628},[],"Receiver certificate verification",{"_3379":2706,"_29619":2599,"_20556":56630,"_5":14099,"_26939":56314,"_2865":56631},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3379":2707,"_29619":2599,"_20556":56633,"_5":14099,"_26939":56314,"_2865":56634},[],"Medium: credentials go to an unverified receiver",{"_3379":2708,"_29619":2599,"_20556":56636,"_5":14099,"_26939":56314,"_2865":56637},[],"Set `insecure_skip_verify` to `false`",{"_3379":2709,"_29619":2599,"_20556":56639,"_5":14099,"_26939":56314,"_2865":56379},[],{"_3379":2710,"_29619":2599,"_20556":56641,"_5":14099,"_26939":56314,"_2865":56642},[],"Scripts and consoles that edit DMSs through the API",{"_3379":2711,"_29619":2599,"_20556":56644,"_5":14099,"_26939":56314,"_2865":56645},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3379":2712,"_29619":2599,"_20556":56647,"_5":14099,"_26939":56314,"_2865":56648},[],"Read the DMS before editing and use the new field",{"_3379":2713,"_29619":2599,"_20556":56650,"_5":14099,"_26939":56314,"_2865":56399},[],{"_3379":2714,"_29619":2599,"_20556":56652,"_5":14099,"_26939":56314,"_2865":56653},[],"Clients that create or update VA roles through the API",{"_3379":2715,"_29619":2599,"_20556":56655,"_5":14099,"_26939":56314,"_2865":56656},[],"Medium: requests with the old field return an error",{"_3379":2716,"_29619":2599,"_20556":56658,"_5":14099,"_26939":56314,"_2865":56659},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_certificate_serial_number`",{"_3379":2717,"_29619":2599,"_20556":56661,"_5":14099,"_26939":56314,"_2865":56395},[],{"_3379":2718,"_29619":2599,"_20556":56663,"_5":14099,"_26939":56314,"_2865":56664},[],"Consumers that read the device `events` field",{"_3379":2719,"_29619":2599,"_20556":56666,"_5":14099,"_26939":56314,"_2865":56667},[],"Medium: the field disappears",{"_3379":2720,"_29619":2599,"_20556":56669,"_5":14099,"_26939":56314,"_2865":56670},[],"Use the new event endpoints",{"_3379":2721,"_29619":2599,"_20556":56672,"_5":14099,"_26939":56314,"_2865":56347},[],{"_3379":2722,"_29619":2599,"_20556":56674,"_5":14099,"_26939":56314,"_2865":56675},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3379":2723,"_29619":2599,"_20556":56677,"_5":14099,"_26939":56314,"_2865":56678},[],"Low to medium: validation errors or changed defaults",{"_3379":2724,"_29619":2599,"_20556":56680,"_5":14099,"_26939":56314,"_2865":56681},[],"Update the values file",{"_3379":2725,"_29619":2599,"_20556":56683,"_5":14099,"_26939":56314,"_2865":56387},[],{"_3379":2726,"_29619":2599,"_20556":56685,"_5":14099,"_26939":56314,"_2865":56686},[],"Clients that send the DMS ID in the update body",{"_3379":2727,"_29619":2599,"_20556":56688,"_5":14099,"_26939":56314,"_2865":56689},[],"Low: the ID in the URL wins",{"_3379":2728,"_29619":2599,"_20556":56691,"_5":14099,"_26939":56314,"_2865":56692},[],"Send the ID in the URL",{"_3379":2729,"_29619":2599,"_20556":56694,"_5":14099,"_26939":56314,"_2865":56391},[],{"_3379":2730,"_29619":2599,"_20556":56696,"_5":14099,"_26939":56314,"_2865":56697},[],"Consumers that match on certificate `type`",{"_3379":2731,"_29619":2599,"_20556":56699,"_5":14099,"_26939":56314,"_2865":56700},[],"Low: two values are renamed",{"_3379":2732,"_29619":2599,"_20556":56702,"_5":14099,"_26939":56314,"_2865":56703},[],"Adapt consumers",{"_3379":2733,"_29619":2599,"_20556":56705,"_5":14099,"_26939":56314,"_2865":56383},[],{"_3379":2734,"_29619":2599,"_20556":56707,"_5":14099,"_26939":56314,"_2865":56708},[],"Any DMS",{"_3379":2735,"_29619":2599,"_20556":56710,"_5":14099,"_26939":56314,"_2865":56711},[],"Low: informational",{"_3379":2736,"_29619":2599,"_20556":56713,"_5":14099,"_26939":56314,"_2865":56714},[],"Read both blocks before editing",{"_3379":2737,"_29619":2599,"_20556":56716,"_5":14099,"_26939":56322,"_2865":56717},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3379":2738,"_29619":2599,"_20556":56719,"_5":14099,"_26939":56322,"_2865":56720},[],"Step 4 of the migration guide copies the data.",{"_3379":2739,"_29619":2599,"_20556":56722,"_5":14099,"_26939":56326,"_2865":56723},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3379":2740,"_29619":2599,"_20556":56725,"_5":14099,"_26939":56330,"_2865":56726},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3379":2741,"_29619":2599,"_20556":56728,"_5":14099,"_26939":56334,"_2865":56729},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3379":2742,"_29619":2599,"_20556":56731,"_5":14099,"_26939":56338,"_2865":56732},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3379":2743,"_29619":2599,"_20556":56734,"_5":14099,"_26939":56338,"_2865":56735},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3379":2744,"_29619":2599,"_20556":56737,"_5":14099,"_26939":56342,"_2865":56738},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3379":2745,"_29619":2599,"_20556":56740,"_5":14099,"_26939":56346,"_2865":56741},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3379":2746,"_29619":2599,"_20556":56743,"_5":14099,"_26939":56346,"_2865":56744},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3379":2747,"_29619":2599,"_20556":56746,"_5":14099,"_26939":56346,"_2865":56747},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3379":2748,"_29619":2599,"_20556":56749,"_5":14099,"_26939":56346,"_2865":56750},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3379":2749,"_29619":2599,"_20556":56752,"_5":14099,"_26939":56346,"_2865":56753},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3379":2750,"_29619":2599,"_20556":56755,"_5":14099,"_26939":56346,"_2865":56756},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3379":2751,"_29619":2599,"_20556":56758,"_5":14099,"_26939":56354,"_2865":56759},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3379":2752,"_29619":2599,"_20556":56761,"_5":14099,"_26939":56354,"_2865":56762},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3379":2753,"_29619":2599,"_20556":56764,"_5":14099,"_26939":56354,"_2865":56765},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3379":2754,"_29619":2599,"_20556":56767,"_5":14099,"_26939":56354,"_2865":56768},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3379":2755,"_29619":2599,"_20556":56770,"_5":14099,"_26939":56354,"_2865":56771},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3379":2756,"_29619":2599,"_20556":56773,"_5":14099,"_26939":56358,"_2865":56774},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3379":2757,"_29619":2599,"_20556":56776,"_5":14099,"_26939":56362,"_2865":56777},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3379":2758,"_29619":2599,"_20556":56779,"_5":14099,"_26939":56362,"_2865":56780},[],"The `key_id` is the certificate's `subject_key_id` (SHA-256 of the public key).",{"_3379":2759,"_29619":2599,"_20556":56782,"_5":14099,"_26939":56362,"_2865":56783},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3379":2760,"_29619":2599,"_20556":56785,"_5":14099,"_26939":56362,"_2865":56786},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3379":2761,"_29619":2599,"_20556":56788,"_5":14099,"_26939":56362,"_2865":56789},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3379":2762,"_29619":2599,"_20556":56791,"_5":14099,"_26939":56362,"_2865":56792},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3379":2763,"_29619":2599,"_20556":56794,"_5":14099,"_26939":56362,"_2865":56795},[],"Once legacy keys are registered, starting the KMS with the backend configuration option `crypto_engines.migrate_keys_format` renames keys whose name is not the public-key SHA-256 digest, keeps the old name as an alias and moves certificate references along. It is safe to re-run and can be disabled afterwards.",{"_3379":2764,"_29619":2599,"_20556":56797,"_5":14099,"_26939":56366,"_2865":56798},[],"Certificates now reference their KMS key, and VA roles reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3379":2765,"_29619":2599,"_20556":56800,"_5":14099,"_26939":56374,"_2865":56801},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3379":2766,"_29619":2599,"_20556":56803,"_5":14099,"_26939":56374,"_2865":56804},[],"Field in 3.8.0",{"_3379":2767,"_29619":2599,"_20556":56806,"_5":14099,"_26939":56374,"_2865":56807},[],"Field in 4.0.0",{"_3379":2768,"_29619":2599,"_20556":56809,"_5":14099,"_26939":56374,"_2865":56810},[],"`validate_server_cert`",{"_3379":2769,"_29619":2599,"_20556":56812,"_5":14099,"_26939":56374,"_2865":56813},[],"`insecure_skip_verify` (value negated)",{"_3379":2770,"_29619":2599,"_20556":56815,"_5":14099,"_26939":56374,"_2865":56816},[],"`oidc`",{"_3379":2771,"_29619":2599,"_20556":56818,"_5":14099,"_26939":56374,"_2865":56819},[],"`jwt_options`",{"_3379":2772,"_29619":2599,"_20556":56821,"_5":14099,"_26939":56374,"_2865":56822},[],"`apikey`",{"_3379":2773,"_29619":2599,"_20556":56824,"_5":14099,"_26939":56374,"_2865":56825},[],"`apikey_options`",{"_3379":2774,"_29619":2599,"_20556":56827,"_5":14099,"_26939":56374,"_2865":56828},[],"`mtls`",{"_3379":2775,"_29619":2599,"_20556":56830,"_5":14099,"_26939":56374,"_2865":56831},[],"`mtls_options`",{"_3379":2776,"_29619":2599,"_20556":56833,"_5":14099,"_26939":56374,"_2865":56834},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3379":2777,"_29619":2599,"_20556":56836,"_5":14099,"_26939":56374,"_2865":56837},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3379":2778,"_29619":2599,"_20556":56839,"_5":14099,"_26939":56374,"_2865":56840},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3379":2779,"_29619":2599,"_20556":56842,"_5":14099,"_26939":56378,"_2865":56843},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3379":2780,"_29619":2599,"_20556":56845,"_5":14099,"_26939":56378,"_2865":56846},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3379":2781,"_29619":2599,"_20556":56848,"_5":14099,"_26939":56378,"_2865":56849},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3379":2782,"_29619":2599,"_20556":56851,"_5":14099,"_26939":56382,"_2865":56852},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3379":2783,"_29619":2599,"_20556":56854,"_5":14099,"_26939":56386,"_2865":56855},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3379":2784,"_29619":2599,"_20556":56857,"_5":14099,"_26939":56390,"_2865":56858},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3379":2785,"_29619":2599,"_20556":56860,"_5":14099,"_26939":56394,"_2865":56861},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3379":2786,"_29619":2599,"_20556":56863,"_5":14099,"_26939":56394,"_2865":56864},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3379":2787,"_29619":2599,"_20556":56866,"_5":14099,"_26939":56394,"_2865":56867},[],"`POST /v1/devices/:id/events` creates an event.",{"_3379":2788,"_29619":2599,"_20556":56869,"_5":14099,"_26939":56394,"_2865":56870},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3379":2789,"_29619":2599,"_20556":56872,"_5":14099,"_26939":56398,"_2865":56873},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_certificate_serial_number`, the serial number of the existing certificate that signs the CRL. A new role's initial value is the CA's current certificate serial number. Requests that still carry `subject_key_id_signer` return an error. Custom authorization policies that filter on the old field must be updated: the filter `crl_subject_key_id_signer` is renamed to `crl_signer_certificate_serial_number` and takes serial-number values.",{"_3379":2790,"_29619":2599,"_20556":56875,"_5":14099,"_26939":56402,"_2865":56876},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3379":2791,"_29619":2599,"_20556":56878,"_5":14099,"_26939":56406,"_2865":56879},[],"Take a verifiable backup of PostgreSQL and schedule downtime. The upgrade moves every service's data into `pki`.",{"_3379":2792,"_29619":2599,"_20556":56881,"_5":14099,"_26939":56406,"_2865":56882},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3379":2793,"_29619":2599,"_20556":56884,"_5":14099,"_26939":56406,"_2865":56885},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3379":2794,"_29619":2599,"_20556":56887,"_5":14099,"_26939":56406,"_2865":56888},[],"Record the names of your local-storage PVCs:",{"_3379":2795,"_29619":2599,"_20556":56890,"_5":14099,"_26939":56406,"_2865":56891},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3379":2796,"_29619":2599,"_20556":56893,"_5":14099,"_26939":56410,"_2865":56894},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3379":2797,"_29619":2599,"_20556":56896,"_5":14099,"_26939":56410,"_2865":56897},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3379":2798,"_29619":2599,"_20556":56899,"_5":14099,"_26939":56410,"_2865":56900},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3379":2799,"_29619":2599,"_20556":56902,"_5":14099,"_26939":56410,"_2865":56903},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3379":2800,"_29619":2599,"_20556":56905,"_5":14099,"_26939":56410,"_2865":56906},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3379":2801,"_29619":2599,"_20556":56908,"_5":14099,"_26939":56410,"_2865":56909},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3379":2802,"_29619":2599,"_20556":56911,"_5":14099,"_26939":56410,"_2865":56912},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3379":2803,"_29619":2599,"_20556":56914,"_5":14099,"_26939":56410,"_2865":56915},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3379":2804,"_29619":2599,"_20556":56917,"_5":14099,"_26939":56410,"_2865":56918},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3379":2805,"_29619":2599,"_20556":56920,"_5":14099,"_26939":56410,"_2865":56921},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3379":2806,"_29619":2599,"_20556":56923,"_5":14099,"_26939":56410,"_2865":56924},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3379":2807,"_29619":2599,"_20556":56926,"_5":14099,"_26939":56410,"_2865":56927},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3379":2808,"_29619":2599,"_20556":56929,"_5":14099,"_26939":56414,"_2865":56930},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3379":2809,"_29619":2599,"_20556":56932,"_5":14099,"_26939":56414,"_2865":56933},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3379":2810,"_29619":2599,"_20556":56935,"_5":14099,"_26939":56418,"_2865":56936},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3379":2811,"_29619":2599,"_20556":56938,"_5":14099,"_26939":56418,"_2865":56939},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3379":2812,"_29619":2599,"_20556":56941,"_5":14099,"_26939":56418,"_2865":56942},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3379":2813,"_29619":2599,"_20556":56944,"_5":14099,"_26939":56418,"_2865":56945},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3379":2814,"_29619":2599,"_20556":56947,"_5":14099,"_26939":56418,"_2865":56948},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3379":2815,"_29619":2599,"_20556":56950,"_5":14099,"_26939":56418,"_2865":56951},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3379":2816,"_29619":2599,"_20556":56953,"_5":14099,"_26939":56418,"_2865":56954},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3379":2817,"_29619":2599,"_20556":56956,"_5":14099,"_26939":56418,"_2865":56957},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3379":2818,"_29619":2599,"_20556":56959,"_5":14099,"_26939":56418,"_2865":56960},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3379":2819,"_29619":2599,"_20556":56962,"_5":14099,"_26939":56418,"_2865":56963},[],"**Remove the helper and restore the recorded replica counts:**",{"_3379":2820,"_29619":2599,"_20556":56965,"_5":14099,"_26939":56418,"_2865":56966},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3379":2821,"_29619":2599,"_20556":56968,"_5":14099,"_26939":56422,"_2865":56969},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3379":2822,"_29619":2599,"_20556":56971,"_5":14099,"_26939":56422,"_2865":56972},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3379":2823,"_29619":2599,"_20556":56974,"_5":14099,"_26939":56426,"_2865":56975},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3379":2824,"_29619":2599,"_20556":56977,"_5":14099,"_26939":56426,"_2865":56978},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3379":2825,"_29619":2599,"_20556":56980,"_5":14099,"_26939":56426,"_2865":56981},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates` and `SELECT` on `ca.ca_certificates`. If your services connect with a different user than the one that ran the migrations, grant that user `SELECT` on `ca.certificates_view` after the migrations.",{"_3379":2826,"_29619":2599,"_20556":56983,"_5":14099,"_26939":56426,"_2865":56984},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3379":2827,"_29619":2599,"_20556":56986,"_5":14099,"_26939":56426,"_2865":56987},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3379":2828,"_29619":2599,"_20556":56989,"_5":14099,"_26939":56426,"_2865":56990},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3379":2829,"_29619":2599,"_20556":56992,"_5":14099,"_26939":56426,"_2865":56993},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3379":2830,"_29619":2599,"_20556":56995,"_5":14099,"_26939":56430,"_2865":56996},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3379":2831,"_29619":2599,"_20556":56998,"_5":14099,"_26939":56430,"_2865":56999},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3379":2832,"_29619":2599,"_20556":57001,"_5":14099,"_26939":56430,"_2865":57002},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3379":2833,"_29619":2599,"_20556":57004,"_5":14099,"_26939":56430,"_2865":57005},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3379":2834,"_29619":2599,"_20556":57007,"_5":14099,"_26939":56430,"_2865":57008},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted on duplicate CA IDs or missing `engine_id` values. Check the job logs, fix the privileges or the data, and re-run the upgrade.",{"_3379":2835,"_29619":2599,"_20556":57010,"_5":14099,"_26939":56430,"_2865":57011},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3379":2836,"_29619":2599,"_20556":57013,"_5":14099,"_26939":56430,"_2865":57014},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3379":2837,"_29619":2599,"_20556":57016,"_5":14099,"_26939":56430,"_2865":57017},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` schema migration.",{"_3379":2838,"_29619":2599,"_20556":57019,"_5":14099,"_26939":56430,"_2865":57020},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3379":2839,"_29619":2599,"_20556":57022,"_5":14099,"_26939":56430,"_2865":57023},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_certificate_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3379":2840,"_29619":2599,"_20556":57025,"_5":14099,"_26939":56430,"_2865":57026},[],"**A migration or service fails with `permission denied for table ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped. Grant the missing privileges and re-run.",{"_3379":2841,"_29619":2599,"_20556":57028,"_5":14099,"_26939":56433,"_2865":57029},[],"After the upgrade, check in this order:",{"_3379":2842,"_29619":2599,"_20556":57031,"_5":14099,"_26939":56433,"_2865":57032},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3379":2843,"_29619":2599,"_20556":57034,"_5":14099,"_26939":56433,"_2865":57035},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3379":2844,"_29619":2599,"_20556":57037,"_5":14099,"_26939":56433,"_2865":57038},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3379":2845,"_29619":2599,"_20556":57040,"_5":14099,"_26939":56433,"_2865":57041},[],"**Existing CRLs are served.** `GET /crl/<ca-ski>` on VA returns a previously issued CRL, and new CRLs are issued.",{"_3379":2846,"_29619":2599,"_20556":57043,"_5":14099,"_26939":56433,"_2865":57044},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS.",{"_3379":2847,"_29619":2599,"_20556":57046,"_5":14099,"_26939":56433,"_2865":57047},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3379":2848,"_29619":2599,"_20556":57049,"_5":14099,"_26939":56433,"_2865":57050},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3379":2849,"_29619":2599,"_20556":57052,"_5":14099,"_26939":56433,"_2865":57053},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3379":2850,"_29619":2599,"_20556":57055,"_5":14099,"_26939":56433,"_2865":57056},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3379":2851,"_29619":2599,"_20556":57058,"_5":14099,"_26939":56433,"_2865":57059},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3379":2852,"_29619":2599,"_20556":57061,"_5":14099,"_26939":56433,"_2865":57062},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3379":2853,"_29619":2599,"_20556":57064,"_5":14099,"_26939":56433,"_2865":57065},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3379":2854,"_29619":2599,"_20556":57067,"_5":14099,"_26939":56433,"_2865":57068},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3379":2855,"_29619":2599,"_20556":57070,"_5":14099,"_26939":56433,"_2865":57071},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3379":2856,"_29619":2599,"_20556":57073,"_5":14099,"_26939":56437,"_2865":57074},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3379":2857,"_29619":2599,"_20556":57076,"_5":14099,"_26939":56437,"_2865":57077},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3379":2858,"_29619":2599,"_20556":57079,"_5":14099,"_26939":56437,"_2865":57080},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3379":2859,"_29619":2599,"_20556":57082,"_5":14099,"_26939":56437,"_2865":57083},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3379":2860,"_29619":2599,"_20556":57085,"_5":14099,"_26939":56437,"_2865":57086},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_57089":57090,"_57091":57092,"_57093":57094,"_57095":57096,"_17802":2900,"_68494":2900},"language","english","sortableProperties",[2865,29619,5,26939],"sortablePropertiesWithTypes",{"_2865":24560,"_29619":24560,"_5":24560,"_26939":24560},"sorts",{"_2865":57097,"_29619":59947,"_5":62796,"_26939":65645},{"_4543":57098,"_57099":57100,"_5":24560},{"_14181":3552,"_14562":24146,"_14581":4686,"_28628":3466,"_14568":3985,"_19510":8483,"_14202":5044,"_14209":3253,"_28570":2941,"_28979":4346,"_29000":6558,"_28604":3381,"_33894":5824,"_28707":7341,"_29044":7349,"_33901":3098,"_33904":6901,"_33907":5445,"_33910":15232,"_29451":4663,"_33915":16968,"_33917":3553,"_29481":13193,"_14577":13016,"_33921":12650,"_33924":5830,"_33926":6058,"_29028":3350,"_29446":6834,"_29494":3619,"_33931":2950,"_33933":5039,"_33935":5049,"_28724":2964,"_33938":6113,"_33940":7383,"_33942":12096,"_33944":3569,"_33946":6828,"_28641":11491,"_33949":3009,"_33951":3244,"_28635":3368,"_29065":19986,"_33955":7373,"_33957":7038,"_33960":2975,"_28681":4634,"_33964":2976,"_28561":3914,"_33967":4272,"_28609":5713,"_33970":4029,"_33972":3248,"_33975":9818,"_14571":6791,"_33978":6452,"_33980":4664,"_33983":8442,"_33985":9404,"_33987":3862,"_33989":5470,"_33991":4010,"_19513":8642,"_33994":6028,"_33996":5817,"_28582":16433,"_29022":24969,"_34000":6029,"_34002":4121,"_34004":13017,"_29511":22481,"_34007":5705,"_34009":5911,"_34011":17823,"_29605":3935,"_29081":7113,"_34015":7389,"_34017":3554,"_28619":4323,"_34020":6793,"_34022":16552,"_34024":24569,"_29527":22915,"_28701":19970,"_28031":5417,"_34029":5054,"_34031":7400,"_34033":20696,"_28750":23168,"_34037":19753,"_29016":8505,"_34041":3188,"_34043":4229,"_34045":18484,"_34047":4671,"_34049":7414,"_34051":7305,"_28739":4606,"_28984":5001,"_34055":6006,"_34057":3926,"_34059":3187,"_34062":3314,"_34064":19785,"_34066":3109,"_34068":4601,"_34070":3127,"_34072":15955,"_34074":15781,"_34077":6899,"_34079":9663,"_34081":23167,"_34083":4974,"_34085":23425,"_34088":3330,"_34090":13873,"_34093":7500,"_34096":3929,"_34098":5710,"_34100":6162,"_34102":19110,"_34104":5689,"_34106":48181,"_34108":9107,"_34110":4908,"_34112":6803,"_29027":11647,"_34115":4382,"_34117":6893,"_34119":4285,"_34121":5803,"_34123":4600,"_34125":5047,"_34127":4595,"_34129":10832,"_34131":5515,