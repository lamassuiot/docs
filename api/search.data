,"_40090":124818,"_40092":124821,"_40094":124824,"_40096":124827,"_40098":124830,"_40100":124833,"_40102":124836,"_40104":124839,"_40106":124842,"_40108":124845,"_40110":124848,"_40112":124851,"_40115":124854,"_40117":124857,"_40119":124860,"_40121":124862,"_40123":124865,"_40125":124867,"_40127":124869,"_40129":124871,"_40131":124873,"_40133":124875,"_40135":124877,"_40137":124880,"_40139":124883,"_40142":124886,"_40144":124889,"_40146":124892,"_40148":124895,"_40150":124898,"_40152":124901,"_40154":124904,"_40156":124907,"_40158":124910,"_40160":124913,"_40162":124916,"_40165":124919,"_40167":124922,"_40169":124925,"_40171":124927,"_40173":124929,"_40175":124932,"_40177":124934,"_40179":124937,"_40181":124939,"_40183":124942,"_40185":124945,"_40187":124948,"_40190":124951,"_40193":124954,"_40195":124957,"_40197":124960,"_40199":124963,"_40201":124966,"_40203":124969,"_40205":124972,"_40207":124975,"_40209":124978,"_40212":124981,"_40214":124984,"_40216":124987,"_40218":124990,"_40220":124993,"_40222":124996,"_40224":124999,"_40226":125002,"_40228":125005,"_40230":125008,"_40232":125011,"_40234":125014,"_40236":125017,"_40238":125020,"_40240":125023,"_40242":125026,"_40244":125029,"_40246":125032,"_40248":125035,"_40250":125038,"_40252":125041,"_40254":125044,"_40256":125047,"_40258":125050,"_40260":125053,"_40262":125056,"_40264":125059,"_40266":125062,"_40268":125065,"_40270":125068,"_40272":125071,"_40275":125074,"_40277":125077,"_40279":125080,"_40281":125083,"_40283":125086,"_40285":125089,"_40287":125092,"_40289":125095,"_40291":125098,"_40293":125101,"_40295":125104,"_40297":125107,"_40299":125110,"_40301":125113,"_40303":125116,"_40305":125119,"_40307":125122,"_40309":125125,"_40311":125128,"_40313":125131,"_40315":125134,"_40317":125137,"_40319":125140,"_40321":125143,"_40323":125146,"_40325":125149,"_40327":125152,"_40329":125155,"_40331":125158,"_40333":125161,"_40335":125164,"_40337":125167,"_40339":125170,"_40341":125173,"_40343":125176,"_40345":125179,"_40347":125182,"_40349":125185,"_40351":125188,"_40353":125191,"_40355":125194,"_40357":125197,"_40359":125200,"_40361":125203,"_40363":125206,"_40365":125209,"_40368":125212,"_40370":125215,"_40372":125218},{"_3465":70136,"_30211":70136,"_5":14726,"_2949":116287,"_30543":116288,"_20923":116291,"_27449":70136},"Despliega desde AWS Marketplace",[49241,116289,116290],"Despliegue","Otros modelos",[],{"_3465":70137,"_30211":70136,"_20923":116293,"_5":14374,"_27449":70136,"_2949":116294},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3465":70138,"_30211":70136,"_5":30540,"_20923":116296,"_27449":116297,"_2949":116298},[],"/docs/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3465":70139,"_30211":70136,"_5":30540,"_20923":116300,"_27449":116301,"_2949":116302},[],"/docs/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3465":70140,"_30211":70136,"_5":30540,"_20923":116304,"_27449":116305,"_2949":116306},[],"/docs/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3465":70141,"_30211":70136,"_5":30540,"_20923":116308,"_27449":116309,"_2949":116310},[],"/docs/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3465":70142,"_30211":70136,"_5":30540,"_20923":116312,"_27449":116313,"_2949":116314},[],"/docs/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3465":70143,"_30211":70136,"_5":30540,"_20923":116316,"_27449":116317,"_2949":116318},[],"/docs/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3465":70144,"_30211":70136,"_5":30540,"_20923":116320,"_27449":116321,"_2949":116322},[],"/docs/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3465":70145,"_30211":70136,"_20923":116324,"_5":14374,"_27449":70136,"_2949":116325},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3465":70146,"_30211":70136,"_20923":116327,"_5":14374,"_27449":116297,"_2949":116328},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3465":70147,"_30211":70136,"_20923":116330,"_5":14374,"_27449":116297,"_2949":116331},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3465":70148,"_30211":70136,"_20923":116333,"_5":14374,"_27449":116297,"_2949":116334},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3465":70149,"_30211":70136,"_20923":116336,"_5":14374,"_27449":116301,"_2949":116337},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3465":70150,"_30211":70136,"_20923":116339,"_5":14374,"_27449":116301,"_2949":116340},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3465":70151,"_30211":70136,"_20923":116342,"_5":14374,"_27449":116301,"_2949":116343},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3465":70152,"_30211":70136,"_20923":116345,"_5":14374,"_27449":116305,"_2949":116346},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3465":70153,"_30211":70136,"_20923":116348,"_5":14374,"_27449":116309,"_2949":116349},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3465":70154,"_30211":70136,"_20923":116351,"_5":14374,"_27449":116313,"_2949":116352},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3465":70155,"_30211":70136,"_20923":116354,"_5":14374,"_27449":116317,"_2949":116355},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3465":70156,"_30211":70136,"_20923":116357,"_5":14374,"_27449":116321,"_2949":116358},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3465":70157,"_30211":70157,"_5":14726,"_2949":116360,"_30543":116361,"_20923":116362,"_27449":70157},"Despliega Lamassu",[49241,116289],[],{"_3465":70158,"_30211":70157,"_20923":116364,"_5":14374,"_27449":70157,"_2949":116365},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3465":70159,"_30211":70157,"_5":30540,"_20923":116367,"_27449":116368,"_2949":116369},[],"/docs/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3465":70160,"_30211":70157,"_5":30540,"_20923":116371,"_27449":116372,"_2949":116373},[],"/docs/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3465":70161,"_30211":70157,"_5":30540,"_20923":116375,"_27449":116376,"_2949":116377},[],"/docs/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3465":70162,"_30211":70157,"_20923":116379,"_5":14374,"_27449":70157,"_2949":116380},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3465":70163,"_30211":70157,"_20923":116382,"_5":14374,"_27449":116368,"_2949":116383},[],"Modelo",{"_3465":70164,"_30211":70157,"_20923":116385,"_5":14374,"_27449":116368,"_2949":116386},[],"Recomendado para",{"_3465":70165,"_30211":70157,"_20923":116388,"_5":14374,"_27449":116368,"_2949":116389},[],"Quién opera la infraestructura",{"_3465":70166,"_30211":70157,"_20923":116391,"_5":14374,"_27449":116368,"_2949":116392},[],"Punto de partida",{"_3465":70167,"_30211":70157,"_20923":116394,"_5":14374,"_27449":116368,"_2949":49348},[],{"_3465":70168,"_30211":70157,"_20923":116396,"_5":14374,"_27449":116368,"_2949":116397},[],"Producción, entornos regulados y despliegues personalizados",{"_3465":70169,"_30211":70157,"_20923":116399,"_5":14374,"_27449":116368,"_2949":116400},[],"Tu equipo",{"_3465":70170,"_30211":70157,"_20923":116402,"_5":14374,"_27449":116368,"_2949":116403},[],"Helm o Fastlane",{"_3465":70171,"_30211":70157,"_20923":116405,"_5":14374,"_27449":116368,"_2949":49360},[],{"_3465":70172,"_30211":70157,"_20923":116407,"_5":14374,"_27449":116368,"_2949":116408},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3465":70173,"_30211":70157,"_20923":116410,"_5":14374,"_27449":116368,"_2949":116400},[],{"_3465":70174,"_30211":70157,"_20923":116412,"_5":14374,"_27449":116368,"_2949":116413},[],"Imagen preconfigurada en EC2",{"_3465":70175,"_30211":70157,"_20923":116415,"_5":14374,"_27449":116368,"_2949":49371},[],{"_3465":70176,"_30211":70157,"_20923":116417,"_5":14374,"_27449":116368,"_2949":116418},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3465":70177,"_30211":70157,"_20923":116420,"_5":14374,"_27449":116368,"_2949":49377},[],{"_3465":70178,"_30211":70157,"_20923":116422,"_5":14374,"_27449":116368,"_2949":116423},[],"Suscripción gestionada",{"_3465":70179,"_30211":70157,"_20923":116425,"_5":14374,"_27449":116368,"_2949":116426},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3465":70180,"_30211":70157,"_20923":116428,"_5":14374,"_27449":116368,"_2949":116429},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3465":70181,"_30211":70157,"_20923":116431,"_5":14374,"_27449":116368,"_2949":116432},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3465":70182,"_30211":70157,"_20923":116434,"_5":14374,"_27449":116372,"_2949":116435},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3465":70183,"_30211":70157,"_20923":116437,"_5":14374,"_27449":116376,"_2949":116438},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3465":70184,"_30211":70184,"_5":14726,"_2949":116440,"_30543":116441,"_20923":116442,"_27449":70184},"Utiliza Lamassu como SaaS",[49241,116289,116290],[],{"_3465":70185,"_30211":70184,"_20923":116444,"_5":14374,"_27449":70184,"_2949":116445},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3465":70186,"_30211":70184,"_5":30540,"_20923":116447,"_27449":116448,"_2949":116449},[],"/docs/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3465":70187,"_30211":70184,"_5":30540,"_20923":116451,"_27449":116452,"_2949":116453},[],"/docs/es/deployment/saas#planes","Planes",{"_3465":70188,"_30211":70184,"_5":30540,"_20923":116455,"_27449":116456,"_2949":116457},[],"/docs/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3465":70189,"_30211":70184,"_20923":116459,"_5":14374,"_27449":70184,"_2949":116460},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3465":70190,"_30211":70184,"_20923":116462,"_5":14374,"_27449":116448,"_2949":116463},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3465":70191,"_30211":70184,"_20923":116465,"_5":14374,"_27449":116448,"_2949":116466},[],"Copias de seguridad automáticas.",{"_3465":70192,"_30211":70184,"_20923":116468,"_5":14374,"_27449":116448,"_2949":116469},[],"Actualizaciones de versión.",{"_3465":70193,"_30211":70184,"_20923":116471,"_5":14374,"_27449":116448,"_2949":116472},[],"Soporte técnico y SLA según el plan contratado.",{"_3465":70194,"_30211":70184,"_20923":116474,"_5":14374,"_27449":116452,"_2949":49432},[],{"_3465":70195,"_30211":70184,"_20923":116476,"_5":14374,"_27449":116452,"_2949":116477},[],"Dispositivos",{"_3465":70196,"_30211":70184,"_20923":116479,"_5":14374,"_27449":116452,"_2949":116480},[],"Soporte",{"_3465":70197,"_30211":70184,"_20923":116482,"_5":14374,"_27449":116452,"_2949":49441},[],{"_3465":70198,"_30211":70184,"_20923":116484,"_5":14374,"_27449":116452,"_2949":49444},[],{"_3465":70199,"_30211":70184,"_20923":116486,"_5":14374,"_27449":116452,"_2949":116487},[],"Hasta 1.000",{"_3465":70200,"_30211":70184,"_20923":116489,"_5":14374,"_27449":116452,"_2949":49450},[],{"_3465":70201,"_30211":70184,"_20923":116491,"_5":14374,"_27449":116452,"_2949":116492},[],"99,5 %",{"_3465":70202,"_30211":70184,"_20923":116494,"_5":14374,"_27449":116452,"_2949":49456},[],{"_3465":70203,"_30211":70184,"_20923":116496,"_5":14374,"_27449":116452,"_2949":116497},[],"Hasta 10.000",{"_3465":70204,"_30211":70184,"_20923":116499,"_5":14374,"_27449":116452,"_2949":116500},[],"Email y chat",{"_3465":70205,"_30211":70184,"_20923":116502,"_5":14374,"_27449":116452,"_2949":116503},[],"99,9 %",{"_3465":70206,"_30211":70184,"_20923":116505,"_5":14374,"_27449":116452,"_2949":49468},[],{"_3465":70207,"_30211":70184,"_20923":116507,"_5":14374,"_27449":116452,"_2949":116508},[],"Ilimitados",{"_3465":70208,"_30211":70184,"_20923":116510,"_5":14374,"_27449":116452,"_2949":116511},[],"Dedicado",{"_3465":70209,"_30211":70184,"_20923":116513,"_5":14374,"_27449":116452,"_2949":116514},[],"99,99 %",{"_3465":70210,"_30211":70184,"_20923":116516,"_5":14374,"_27449":116456,"_2949":116517},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3465":70211,"_30211":70184,"_20923":116519,"_5":14374,"_27449":116456,"_2949":116520},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3465":70212,"_30211":70212,"_5":14726,"_2949":49485,"_30543":116522,"_20923":116524,"_27449":70212},[49241,116289,116523],"Kubernetes autogestionado",[],{"_3465":70213,"_30211":70212,"_20923":116526,"_5":14374,"_27449":70212,"_2949":116527},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3465":70214,"_30211":70212,"_5":30540,"_20923":116529,"_27449":116530,"_2949":116531},[],"/docs/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3465":70215,"_30211":70212,"_5":30540,"_20923":116533,"_27449":116534,"_2949":116535},[],"/docs/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3465":70216,"_30211":70212,"_5":30540,"_20923":116537,"_27449":116538,"_2949":116539},[],"/docs/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3465":70217,"_30211":70212,"_5":30540,"_20923":116541,"_27449":116542,"_2949":116543},[],"/docs/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3465":70218,"_30211":70212,"_5":30540,"_20923":116545,"_27449":116546,"_2949":116547},[],"/docs/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3465":70219,"_30211":70212,"_5":30540,"_20923":116549,"_27449":116550,"_2949":116551},[],"/docs/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3465":70220,"_30211":70212,"_5":30540,"_20923":116553,"_27449":116554,"_2949":116555},[],"/docs/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3465":70221,"_30211":70212,"_5":30540,"_20923":116557,"_27449":116558,"_2949":116559},[],"/docs/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3465":70222,"_30211":70212,"_5":30540,"_20923":116561,"_27449":116562,"_2949":116563},[],"/docs/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3465":70223,"_30211":70212,"_5":30540,"_20923":116565,"_27449":116566,"_2949":116567},[],"/docs/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3465":70224,"_30211":70212,"_5":30540,"_20923":116569,"_27449":116570,"_2949":116571},[],"/docs/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3465":70225,"_30211":70212,"_20923":116573,"_5":14374,"_27449":116530,"_2949":116574},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3465":70226,"_30211":70212,"_20923":116576,"_5":14374,"_27449":116530,"_2949":116577},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3465":70227,"_30211":70212,"_20923":116579,"_5":14374,"_27449":116534,"_2949":116580},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3465":70228,"_30211":70212,"_20923":116582,"_5":14374,"_27449":116534,"_2949":116583},[],"Fastlane instala o configura",{"_3465":70229,"_30211":70212,"_20923":116585,"_5":14374,"_27449":116534,"_2949":116586},[],"Tú sigues proporcionando",{"_3465":70230,"_30211":70212,"_20923":116588,"_5":14374,"_27449":116534,"_2949":116589},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3465":70231,"_30211":70212,"_20923":116591,"_5":14374,"_27449":116534,"_2949":116592},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3465":70232,"_30211":70212,"_20923":116594,"_5":14374,"_27449":116534,"_2949":116595},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3465":70233,"_30211":70212,"_20923":116597,"_5":14374,"_27449":116534,"_2949":116598},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3465":70234,"_30211":70212,"_20923":116600,"_5":14374,"_27449":116534,"_2949":116601},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3465":70235,"_30211":70212,"_20923":116603,"_5":14374,"_27449":116534,"_2949":116604},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3465":70236,"_30211":70212,"_20923":116606,"_5":14374,"_27449":116534,"_2949":116607},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3465":70237,"_30211":70212,"_20923":116609,"_5":14374,"_27449":116534,"_2949":116610},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3465":70238,"_30211":70212,"_20923":116612,"_5":14374,"_27449":116534,"_2949":116613},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3465":70239,"_30211":70212,"_20923":116615,"_5":14374,"_27449":116538,"_2949":116616},[],"Necesitas:",{"_3465":70240,"_30211":70212,"_20923":116618,"_5":14374,"_27449":116538,"_2949":116619},[],"un clúster Kubernetes existente",{"_3465":70241,"_30211":70212,"_20923":116621,"_5":14374,"_27449":116538,"_2949":116622},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3465":70242,"_30211":70212,"_20923":116624,"_5":14374,"_27449":116538,"_2949":49587},[],{"_3465":70243,"_30211":70212,"_20923":116626,"_5":14374,"_27449":116538,"_2949":23667},[],{"_3465":70244,"_30211":70212,"_20923":116628,"_5":14374,"_27449":116538,"_2949":116629},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3465":70245,"_30211":70212,"_20923":116631,"_5":14374,"_27449":116538,"_2949":116632},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3465":70246,"_30211":70212,"_20923":116634,"_5":14374,"_27449":116538,"_2949":116635},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3465":70247,"_30211":70212,"_20923":116637,"_5":14374,"_27449":116538,"_2949":116638},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3465":70248,"_30211":70212,"_20923":116640,"_5":14374,"_27449":116538,"_2949":116641},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3465":70249,"_30211":70212,"_20923":116643,"_5":14374,"_27449":116542,"_2949":116644},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3465":70250,"_30211":70212,"_20923":116646,"_5":14374,"_27449":116542,"_2949":116647},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3465":70251,"_30211":70212,"_20923":116649,"_5":14374,"_27449":116546,"_2949":116650},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3465":70252,"_30211":70212,"_20923":116652,"_5":14374,"_27449":116546,"_2949":116653},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3465":70253,"_30211":70212,"_20923":116655,"_5":14374,"_27449":116546,"_2949":116656},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3465":70254,"_30211":70212,"_20923":116658,"_5":14374,"_27449":116546,"_2949":116659},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3465":70255,"_30211":70212,"_20923":116661,"_5":14374,"_27449":116550,"_2949":116662},[],"Opción",{"_3465":70256,"_30211":70212,"_20923":116664,"_5":14374,"_27449":116550,"_2949":116665},[],"Valor predeterminado",{"_3465":70257,"_30211":70212,"_20923":116667,"_5":14374,"_27449":116550,"_2949":116668},[],"Propósito",{"_3465":70258,"_30211":70212,"_20923":116670,"_5":14374,"_27449":116550,"_2949":49634},[],{"_3465":70259,"_30211":70212,"_20923":116672,"_5":14374,"_27449":116550,"_2949":49637},[],{"_3465":70260,"_30211":70212,"_20923":116674,"_5":14374,"_27449":116550,"_2949":116675},[],"Muestra la ayuda",{"_3465":70261,"_30211":70212,"_20923":116677,"_5":14374,"_27449":116550,"_2949":49643},[],{"_3465":70262,"_30211":70212,"_20923":116679,"_5":14374,"_27449":116550,"_2949":116680},[],"contexto actual",{"_3465":70263,"_30211":70212,"_20923":116682,"_5":14374,"_27449":116550,"_2949":116683},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3465":70264,"_30211":70212,"_20923":116685,"_5":14374,"_27449":116550,"_2949":49652},[],{"_3465":70265,"_30211":70212,"_20923":116687,"_5":14374,"_27449":116550,"_2949":6537},[],{"_3465":70266,"_30211":70212,"_20923":116689,"_5":14374,"_27449":116550,"_2949":116690},[],"Omite prompts y genera credenciales para las dependencias",{"_3465":70267,"_30211":70212,"_20923":116692,"_5":14374,"_27449":116550,"_2949":49660},[],{"_3465":70268,"_30211":70212,"_20923":116694,"_5":14374,"_27449":116550,"_2949":49663},[],{"_3465":70269,"_30211":70212,"_20923":116696,"_5":14374,"_27449":116550,"_2949":116697},[],"Namespace de la instalación",{"_3465":70270,"_30211":70212,"_20923":116699,"_5":14374,"_27449":116550,"_2949":49669},[],{"_3465":70271,"_30211":70212,"_20923":116701,"_5":14374,"_27449":116550,"_2949":49672},[],{"_3465":70272,"_30211":70212,"_20923":116703,"_5":14374,"_27449":116550,"_2949":116704},[],"Dominio usado por la UI, OIDC y el certificado",{"_3465":70273,"_30211":70212,"_20923":116706,"_5":14374,"_27449":116550,"_2949":49678},[],{"_3465":70274,"_30211":70212,"_20923":116708,"_5":14374,"_27449":116550,"_2949":15066},[],{"_3465":70275,"_30211":70212,"_20923":116710,"_5":14374,"_27449":116550,"_2949":116711},[],"Versión del chart de Lamassu",{"_3465":70276,"_30211":70212,"_20923":116713,"_5":14374,"_27449":116550,"_2949":49686},[],{"_3465":70277,"_30211":70212,"_20923":116715,"_5":14374,"_27449":116550,"_2949":49689},[],{"_3465":70278,"_30211":70212,"_20923":116717,"_5":14374,"_27449":116550,"_2949":116718},[],"Puerto del listener HTTPS",{"_3465":70279,"_30211":70212,"_20923":116720,"_5":14374,"_27449":116550,"_2949":49695},[],{"_3465":70280,"_30211":70212,"_20923":116722,"_5":14374,"_27449":116550,"_2949":49698},[],{"_3465":70281,"_30211":70212,"_20923":116724,"_5":14374,"_27449":116550,"_2949":116725},[],"Puerto del listener HTTP",{"_3465":70282,"_30211":70212,"_20923":116727,"_5":14374,"_27449":116550,"_2949":49704},[],{"_3465":70283,"_30211":70212,"_20923":116729,"_5":14374,"_27449":116550,"_2949":49637},[],{"_3465":70284,"_30211":70212,"_20923":116731,"_5":14374,"_27449":116550,"_2949":116732},[],"Certificado PEM para TLS downstream",{"_3465":70285,"_30211":70212,"_20923":116734,"_5":14374,"_27449":116550,"_2949":49712},[],{"_3465":70286,"_30211":70212,"_20923":116736,"_5":14374,"_27449":116550,"_2949":49637},[],{"_3465":70287,"_30211":70212,"_20923":116738,"_5":14374,"_27449":116550,"_2949":116739},[],"Clave privada PEM para TLS downstream",{"_3465":70288,"_30211":70212,"_20923":116741,"_5":14374,"_27449":116550,"_2949":49720},[],{"_3465":70289,"_30211":70212,"_20923":116743,"_5":14374,"_27449":116550,"_2949":116744},[],"chart del repositorio",{"_3465":70290,"_30211":70212,"_20923":116746,"_5":14374,"_27449":116550,"_2949":116747},[],"Usa un chart local de Lamassu sin empaquetar",{"_3465":70291,"_30211":70212,"_20923":116749,"_5":14374,"_27449":116550,"_2949":49729},[],{"_3465":70292,"_30211":70212,"_20923":116751,"_5":14374,"_27449":116550,"_2949":116752},[],"detección automática",{"_3465":70293,"_30211":70212,"_20923":116754,"_5":14374,"_27449":116550,"_2949":116755},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3465":70294,"_30211":70212,"_20923":116757,"_5":14374,"_27449":116550,"_2949":49737},[],{"_3465":70295,"_30211":70212,"_20923":116759,"_5":14374,"_27449":116550,"_2949":6537},[],{"_3465":70296,"_30211":70212,"_20923":116761,"_5":14374,"_27449":116550,"_2949":116762},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3465":70297,"_30211":70212,"_20923":116764,"_5":14374,"_27449":116550,"_2949":49745},[],{"_3465":70298,"_30211":70212,"_20923":116766,"_5":14374,"_27449":116550,"_2949":6537},[],{"_3465":70299,"_30211":70212,"_20923":116768,"_5":14374,"_27449":116550,"_2949":116769},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3465":70300,"_30211":70212,"_20923":116771,"_5":14374,"_27449":116550,"_2949":49753},[],{"_3465":70301,"_30211":70212,"_20923":116773,"_5":14374,"_27449":116550,"_2949":6537},[],{"_3465":70302,"_30211":70212,"_20923":116775,"_5":14374,"_27449":116550,"_2949":116776},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3465":70303,"_30211":70212,"_20923":116778,"_5":14374,"_27449":116550,"_2949":49761},[],{"_3465":70304,"_30211":70212,"_20923":116780,"_5":14374,"_27449":116550,"_2949":6537},[],{"_3465":70305,"_30211":70212,"_20923":116782,"_5":14374,"_27449":116550,"_2949":116783},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3465":70306,"_30211":70212,"_20923":116785,"_5":14374,"_27449":116550,"_2949":49769},[],{"_3465":70307,"_30211":70212,"_20923":116787,"_5":14374,"_27449":116550,"_2949":49772},[],{"_3465":70308,"_30211":70212,"_20923":116789,"_5":14374,"_27449":116550,"_2949":116790},[],"Usa otro chart local de SoftHSM",{"_3465":70309,"_30211":70212,"_20923":116792,"_5":14374,"_27449":116550,"_2949":116793},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3465":70310,"_30211":70212,"_20923":116795,"_5":14374,"_27449":116554,"_2949":116796},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3465":70311,"_30211":70212,"_20923":116798,"_5":14374,"_27449":116554,"_2949":116799},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3465":70312,"_30211":70212,"_20923":116801,"_5":14374,"_27449":116554,"_2949":116802},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3465":70313,"_30211":70212,"_20923":116804,"_5":14374,"_27449":116554,"_2949":116805},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3465":70314,"_30211":70212,"_20923":116807,"_5":14374,"_27449":116554,"_2949":116808},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3465":70315,"_30211":70212,"_20923":116810,"_5":14374,"_27449":116554,"_2949":116811},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3465":70316,"_30211":70212,"_20923":116813,"_5":14374,"_27449":116558,"_2949":49799},[],{"_3465":70317,"_30211":70212,"_20923":116815,"_5":14374,"_27449":116558,"_2949":116816},[],"valida las herramientas locales y el clúster seleccionado",{"_3465":70318,"_30211":70212,"_20923":116818,"_5":14374,"_27449":116558,"_2949":116819},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3465":70319,"_30211":70212,"_20923":116821,"_5":14374,"_27449":116558,"_2949":116822},[],"crea el namespace",{"_3465":70320,"_30211":70212,"_20923":116824,"_5":14374,"_27449":116558,"_2949":116825},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3465":70321,"_30211":70212,"_20923":116827,"_5":14374,"_27449":116558,"_2949":116828},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3465":70322,"_30211":70212,"_20923":116830,"_5":14374,"_27449":116558,"_2949":116831},[],"instala RabbitMQ",{"_3465":70323,"_30211":70212,"_20923":116833,"_5":14374,"_27449":116558,"_2949":116834},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3465":70324,"_30211":70212,"_20923":116836,"_5":14374,"_27449":116558,"_2949":116837},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3465":70325,"_30211":70212,"_20923":116839,"_5":14374,"_27449":116558,"_2949":116840},[],"carga datos de ejemplo opcionalmente",{"_3465":70326,"_30211":70212,"_20923":116842,"_5":14374,"_27449":116558,"_2949":116843},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3465":70327,"_30211":70212,"_20923":116845,"_5":14374,"_27449":116562,"_2949":116846},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3465":70328,"_30211":70212,"_20923":116848,"_5":14374,"_27449":116562,"_2949":116849},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3465":70329,"_30211":70212,"_20923":116851,"_5":14374,"_27449":116566,"_2949":116852},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3465":70330,"_30211":70212,"_20923":116854,"_5":14374,"_27449":116566,"_2949":116855},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3465":70331,"_30211":70212,"_20923":116857,"_5":14374,"_27449":116566,"_2949":116858},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3465":70332,"_30211":70212,"_20923":116860,"_5":14374,"_27449":116570,"_2949":116861},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3465":70333,"_30211":70333,"_5":14726,"_2949":116863,"_30543":116864,"_20923":116865,"_27449":70333},"Instala con Helm",[49241,116289,116523],[],{"_3465":70334,"_30211":70333,"_20923":116867,"_5":14374,"_27449":70333,"_2949":116868},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3465":70335,"_30211":70333,"_5":30540,"_20923":116870,"_27449":116871,"_2949":116872},[],"/docs/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3465":70336,"_30211":70333,"_5":30540,"_20923":116874,"_27449":116875,"_2949":116539},[],"/docs/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3465":70337,"_30211":70333,"_5":30540,"_20923":116877,"_27449":116878,"_2949":116879},[],"/docs/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3465":70338,"_30211":70333,"_5":30540,"_20923":116881,"_27449":116882,"_2949":116883},[],"/docs/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3465":70339,"_30211":70333,"_5":30540,"_20923":116885,"_27449":116886,"_2949":116887},[],"/docs/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3465":70340,"_30211":70333,"_5":30540,"_20923":116889,"_27449":116890,"_2949":116891},[],"/docs/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3465":70341,"_30211":70333,"_5":30540,"_20923":116893,"_27449":116894,"_2949":116895},[],"/docs/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3465":70342,"_30211":70333,"_5":30540,"_20923":116897,"_27449":116898,"_2949":116899},[],"/docs/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3465":70343,"_30211":70333,"_5":30540,"_20923":116901,"_27449":116902,"_2949":116903},[],"/docs/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3465":70344,"_30211":70333,"_5":30540,"_20923":116905,"_27449":116906,"_2949":116907},[],"/docs/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3465":70345,"_30211":70333,"_5":30540,"_20923":116909,"_27449":116910,"_2949":116911},[],"/docs/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3465":70346,"_30211":70333,"_20923":116913,"_5":14374,"_27449":116871,"_2949":116914},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3465":70347,"_30211":70333,"_20923":116916,"_5":14374,"_27449":116875,"_2949":116917},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3465":70348,"_30211":70333,"_20923":116919,"_5":14374,"_27449":116875,"_2949":116920},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3465":70349,"_30211":70333,"_20923":116922,"_5":14374,"_27449":116875,"_2949":116923},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3465":70350,"_30211":70333,"_20923":116925,"_5":14374,"_27449":116875,"_2949":116926},[],"un broker RabbitMQ accesible y sus credenciales",{"_3465":70351,"_30211":70333,"_20923":116928,"_5":14374,"_27449":116875,"_2949":116929},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3465":70352,"_30211":70333,"_20923":116931,"_5":14374,"_27449":116875,"_2949":116932},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3465":70353,"_30211":70333,"_20923":116934,"_5":14374,"_27449":116875,"_2949":116935},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3465":70354,"_30211":70333,"_20923":116937,"_5":14374,"_27449":116875,"_2949":116938},[],"una StorageClass y un diseño de tráfico externo",{"_3465":70355,"_30211":70333,"_20923":116940,"_5":14374,"_27449":116875,"_2949":116941},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3465":70356,"_30211":70333,"_20923":116943,"_5":14374,"_27449":116875,"_2949":116944},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3465":70357,"_30211":70333,"_20923":116946,"_5":14374,"_27449":116875,"_2949":116947},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3465":70358,"_30211":70333,"_20923":116949,"_5":14374,"_27449":116878,"_2949":116950},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3465":70359,"_30211":70333,"_20923":116952,"_5":14374,"_27449":116878,"_2949":116953},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3465":70360,"_30211":70333,"_20923":116955,"_5":14374,"_27449":116878,"_2949":116956},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3465":70361,"_30211":70333,"_20923":116958,"_5":14374,"_27449":116882,"_2949":116959},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3465":70362,"_30211":70333,"_20923":116961,"_5":14374,"_27449":116882,"_2949":116962},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3465":70363,"_30211":70333,"_20923":116964,"_5":14374,"_27449":116882,"_2949":116965},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3465":70364,"_30211":70333,"_20923":116967,"_5":14374,"_27449":116882,"_2949":116968},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3465":70365,"_30211":70333,"_20923":116970,"_5":14374,"_27449":116886,"_2949":116971},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3465":70366,"_30211":70333,"_20923":116973,"_5":14374,"_27449":116890,"_2949":116974},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3465":70367,"_30211":70333,"_20923":116976,"_5":14374,"_27449":116890,"_2949":116977},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3465":70368,"_30211":70333,"_20923":116979,"_5":14374,"_27449":116890,"_2949":116980},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3465":70369,"_30211":70333,"_20923":116982,"_5":14374,"_27449":116890,"_2949":116983},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3465":70370,"_30211":70333,"_20923":116985,"_5":14374,"_27449":116890,"_2949":116986},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3465":70371,"_30211":70333,"_20923":116988,"_5":14374,"_27449":116890,"_2949":116989},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3465":70372,"_30211":70333,"_20923":116991,"_5":14374,"_27449":116890,"_2949":116992},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3465":70373,"_30211":70333,"_20923":116994,"_5":14374,"_27449":116894,"_2949":116995},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3465":70374,"_30211":70333,"_20923":116997,"_5":14374,"_27449":116894,"_2949":116998},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3465":70375,"_30211":70333,"_20923":117000,"_5":14374,"_27449":116894,"_2949":117001},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3465":70376,"_30211":70333,"_20923":117003,"_5":14374,"_27449":116894,"_2949":117004},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3465":70377,"_30211":70333,"_20923":117006,"_5":14374,"_27449":116898,"_2949":117007},[],"Para instalar un checkout local:",{"_3465":70378,"_30211":70333,"_20923":117009,"_5":14374,"_27449":116902,"_2949":117010},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3465":70379,"_30211":70333,"_20923":117012,"_5":14374,"_27449":116902,"_2949":117013},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3465":70380,"_30211":70333,"_20923":117015,"_5":14374,"_27449":116906,"_2949":117016},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3465":70381,"_30211":70333,"_20923":117018,"_5":14374,"_27449":116906,"_2949":117019},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3465":70382,"_30211":70333,"_20923":117021,"_5":14374,"_27449":116906,"_2949":117022},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3465":70383,"_30211":70333,"_20923":117024,"_5":14374,"_27449":116906,"_2949":117025},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3465":70384,"_30211":70333,"_20923":117027,"_5":14374,"_27449":116906,"_2949":117028},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3465":70385,"_30211":70333,"_20923":117030,"_5":14374,"_27449":116910,"_2949":117031},[],"Antes de pasar a producción, revisa:",{"_3465":70386,"_30211":70333,"_20923":117033,"_5":14374,"_27449":116910,"_2949":117034},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3465":70387,"_30211":70333,"_20923":117036,"_5":14374,"_27449":116910,"_2949":117037},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3465":70388,"_30211":70333,"_20923":117039,"_5":14374,"_27449":116910,"_2949":117040},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3465":70389,"_30211":70333,"_20923":117042,"_5":14374,"_27449":116910,"_2949":117043},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3465":70390,"_30211":70333,"_20923":117045,"_5":14374,"_27449":116910,"_2949":117046},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3465":70391,"_30211":70333,"_20923":117048,"_5":14374,"_27449":116910,"_2949":117049},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3465":70392,"_30211":70333,"_20923":117051,"_5":14374,"_27449":116910,"_2949":117052},[],"SMTP, observabilidad y entrega de alertas",{"_3465":70393,"_30211":70333,"_20923":117054,"_5":14374,"_27449":116910,"_2949":117055},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3465":70394,"_30211":70333,"_20923":117057,"_5":14374,"_27449":116910,"_2949":117058},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3465":70395,"_30211":70395,"_5":14726,"_2949":117060,"_30543":117061,"_20923":117062,"_27449":70395},"Expón el Gateway",[49241,116289,116523],[],{"_3465":70396,"_30211":70395,"_20923":117064,"_5":14374,"_27449":70395,"_2949":117065},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3465":70397,"_30211":70395,"_5":30540,"_20923":117067,"_27449":117068,"_2949":117069},[],"/docs/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3465":70398,"_30211":70395,"_5":30540,"_20923":117071,"_27449":117072,"_2949":117073},[],"/docs/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3465":70399,"_30211":70395,"_5":30540,"_20923":117075,"_27449":117076,"_2949":117077},[],"/docs/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3465":70400,"_30211":70395,"_5":30540,"_20923":117079,"_27449":117080,"_2949":50067},[],"/docs/es/deployment/self-hosted/networking#k3s",{"_3465":70401,"_30211":70395,"_5":30540,"_20923":117082,"_27449":117083,"_2949":117084},[],"/docs/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3465":70402,"_30211":70395,"_5":30540,"_20923":117086,"_27449":117087,"_2949":117088},[],"/docs/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3465":70403,"_30211":70395,"_5":30540,"_20923":117090,"_27449":117091,"_2949":117092},[],"/docs/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3465":70404,"_30211":70395,"_5":30540,"_20923":117094,"_27449":117095,"_2949":117096},[],"/docs/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3465":70405,"_30211":70395,"_5":30540,"_20923":117098,"_27449":117099,"_2949":117100},[],"/docs/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3465":70406,"_30211":70395,"_5":30540,"_20923":117102,"_27449":117103,"_2949":117104},[],"/docs/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3465":70407,"_30211":70395,"_5":30540,"_20923":117106,"_27449":117107,"_2949":117108},[],"/docs/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3465":70408,"_30211":70395,"_20923":117110,"_5":14374,"_27449":117068,"_2949":117111},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3465":70409,"_30211":70395,"_20923":117113,"_5":14374,"_27449":117068,"_2949":117114},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3465":70410,"_30211":70395,"_20923":117116,"_5":14374,"_27449":117072,"_2949":117117},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3465":70411,"_30211":70395,"_20923":117119,"_5":14374,"_27449":117072,"_2949":117120},[],"Defínelo únicamente cuando:",{"_3465":70412,"_30211":70395,"_20923":117122,"_5":14374,"_27449":117072,"_2949":117123},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3465":70413,"_30211":70395,"_20923":117125,"_5":14374,"_27449":117072,"_2949":117126},[],"esa dirección está asignada a este Gateway",{"_3465":70414,"_30211":70395,"_20923":117128,"_5":14374,"_27449":117072,"_2949":117129},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3465":70415,"_30211":70395,"_20923":117131,"_5":14374,"_27449":117072,"_2949":117132},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3465":70416,"_30211":70395,"_20923":117134,"_5":14374,"_27449":117072,"_2949":117135},[],"No confundas estos valores:",{"_3465":70417,"_30211":70395,"_20923":117137,"_5":14374,"_27449":117072,"_2949":117138},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3465":70418,"_30211":70395,"_20923":117140,"_5":14374,"_27449":117072,"_2949":117141},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3465":70419,"_30211":70395,"_20923":117143,"_5":14374,"_27449":117072,"_2949":117144},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3465":70420,"_30211":70395,"_20923":117146,"_5":14374,"_27449":117076,"_2949":117147},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3465":70421,"_30211":70395,"_20923":117149,"_5":14374,"_27449":117076,"_2949":117150},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3465":70422,"_30211":70395,"_20923":117152,"_5":14374,"_27449":117080,"_2949":117153},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3465":70423,"_30211":70395,"_20923":117155,"_5":14374,"_27449":117080,"_2949":117156},[],"Para el diseño recomendado:",{"_3465":70424,"_30211":70395,"_20923":117158,"_5":14374,"_27449":117080,"_2949":117159},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3465":70425,"_30211":70395,"_20923":117161,"_5":14374,"_27449":117080,"_2949":117162},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3465":70426,"_30211":70395,"_20923":117164,"_5":14374,"_27449":117080,"_2949":117165},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3465":70427,"_30211":70395,"_20923":117167,"_5":14374,"_27449":117080,"_2949":117168},[],"Apunta DNS a la dirección accesible de la VM.",{"_3465":70428,"_30211":70395,"_20923":117170,"_5":14374,"_27449":117080,"_2949":117171},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3465":70429,"_30211":70395,"_20923":117173,"_5":14374,"_27449":117083,"_2949":117174},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3465":70430,"_30211":70395,"_20923":117176,"_5":14374,"_27449":117087,"_2949":117177},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3465":70431,"_30211":70395,"_20923":117179,"_5":14374,"_27449":117087,"_2949":117180},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3465":70432,"_30211":70395,"_20923":117182,"_5":14374,"_27449":117091,"_2949":117183},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3465":70433,"_30211":70395,"_20923":117185,"_5":14374,"_27449":117091,"_2949":117186},[],"Requisito",{"_3465":70434,"_30211":70395,"_20923":117188,"_5":14374,"_27449":117091,"_2949":117189},[],"Diseño recomendado",{"_3465":70435,"_30211":70395,"_20923":117191,"_5":14374,"_27449":117091,"_2949":117192},[],"Consecuencia",{"_3465":70436,"_30211":70395,"_20923":117194,"_5":14374,"_27449":117091,"_2949":117195},[],"Varias URL o servicios de Lamassu",{"_3465":70437,"_30211":70395,"_20923":117197,"_5":14374,"_27449":117091,"_2949":117198},[],"Un Gateway con varias rutas",{"_3465":70438,"_30211":70395,"_20923":117200,"_5":14374,"_27449":117091,"_2949":117201},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3465":70439,"_30211":70395,"_20923":117203,"_5":14374,"_27449":117091,"_2949":117204},[],"Gateways independientes e IP externas distintas",{"_3465":70440,"_30211":70395,"_20923":117206,"_5":14374,"_27449":117091,"_2949":117207},[],"Una VIP por Gateway",{"_3465":70441,"_30211":70395,"_20923":117209,"_5":14374,"_27449":117091,"_2949":117210},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3465":70442,"_30211":70395,"_20923":117212,"_5":14374,"_27449":117091,"_2949":117213},[],"Gateways independientes, un nodo y una IP",{"_3465":70443,"_30211":70395,"_20923":117215,"_5":14374,"_27449":117091,"_2949":117216},[],"Puertos externos diferentes",{"_3465":70444,"_30211":70395,"_20923":117218,"_5":14374,"_27449":117091,"_2949":117219},[],"Los clientes deben indicar puertos no estándar",{"_3465":70445,"_30211":70395,"_20923":117221,"_5":14374,"_27449":117091,"_2949":117222},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3465":70446,"_30211":70395,"_20923":117224,"_5":14374,"_27449":117091,"_2949":117225},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3465":70447,"_30211":70395,"_20923":117227,"_5":14374,"_27449":117091,"_2949":117228},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3465":70448,"_30211":70395,"_20923":117230,"_5":14374,"_27449":117091,"_2949":117231},[],"Recursos Gateway separados pero proxy compartido",{"_3465":70449,"_30211":70395,"_20923":117233,"_5":14374,"_27449":117091,"_2949":117234},[],"Modo merged Gateway de Envoy",{"_3465":70450,"_30211":70395,"_20923":117236,"_5":14374,"_27449":117091,"_2949":117237},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3465":70451,"_30211":70395,"_20923":117239,"_5":14374,"_27449":117091,"_2949":117240},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3465":70452,"_30211":70395,"_20923":117242,"_5":14374,"_27449":117091,"_2949":117243},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3465":70453,"_30211":70395,"_20923":117245,"_5":14374,"_27449":117091,"_2949":117246},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3465":70454,"_30211":70395,"_20923":117248,"_5":14374,"_27449":117091,"_2949":117249},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3465":70455,"_30211":70395,"_20923":117251,"_5":14374,"_27449":117095,"_2949":117252},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3465":70456,"_30211":70395,"_20923":117254,"_5":14374,"_27449":117099,"_2949":117255},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3465":70457,"_30211":70395,"_20923":117257,"_5":14374,"_27449":117099,"_2949":117258},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3465":70458,"_30211":70395,"_20923":117260,"_5":14374,"_27449":117099,"_2949":117261},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3465":70459,"_30211":70395,"_20923":117263,"_5":14374,"_27449":117099,"_2949":117264},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3465":70460,"_30211":70395,"_20923":117266,"_5":14374,"_27449":117099,"_2949":117267},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3465":70461,"_30211":70395,"_20923":117269,"_5":14374,"_27449":117103,"_2949":117270},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3465":70462,"_30211":70395,"_20923":117272,"_5":14374,"_27449":117103,"_2949":117273},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3465":70463,"_30211":70395,"_20923":117275,"_5":14374,"_27449":117107,"_2949":117276},[],"Comprueba, en orden:",{"_3465":70464,"_30211":70395,"_20923":117278,"_5":14374,"_27449":117107,"_2949":117279},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3465":70465,"_30211":70395,"_20923":117281,"_5":14374,"_27449":117107,"_2949":117282},[],"Su estado contiene la dirección esperada.",{"_3465":70466,"_30211":70395,"_20923":117284,"_5":14374,"_27449":117107,"_2949":117285},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3465":70467,"_30211":70395,"_20923":117287,"_5":14374,"_27449":117107,"_2949":117288},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3465":70468,"_30211":70395,"_20923":117290,"_5":14374,"_27449":117107,"_2949":117291},[],"DNS resuelve al endpoint accesible externamente.",{"_3465":70469,"_30211":70395,"_20923":117293,"_5":14374,"_27449":117107,"_2949":117294},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3465":70470,"_30211":70395,"_20923":117296,"_5":14374,"_27449":117107,"_2949":117297},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3465":70471,"_30211":70471,"_5":14726,"_2949":49348,"_30543":117299,"_20923":117300,"_27449":70471},[49241,116289,116523],[],{"_3465":70472,"_30211":70471,"_20923":117302,"_5":14374,"_27449":70471,"_2949":117303},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3465":70473,"_30211":70471,"_5":30540,"_20923":117305,"_27449":117306,"_2949":117307},[],"/docs/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3465":70474,"_30211":70471,"_5":30540,"_20923":117309,"_27449":117310,"_2949":117311},[],"/docs/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3465":70475,"_30211":70471,"_5":30540,"_20923":117313,"_27449":117314,"_2949":117315},[],"/docs/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3465":70476,"_30211":70471,"_5":30540,"_20923":117317,"_27449":117318,"_2949":117319},[],"/docs/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3465":70477,"_30211":70471,"_5":30540,"_20923":117321,"_27449":117322,"_2949":117323},[],"/docs/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3465":70478,"_30211":70471,"_5":30540,"_20923":117325,"_27449":117326,"_2949":117327},[],"/docs/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3465":70479,"_30211":70471,"_20923":117329,"_5":14374,"_27449":117306,"_2949":117330},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3465":70480,"_30211":70471,"_20923":117332,"_5":14374,"_27449":117310,"_2949":117333},[],"Flujo",{"_3465":70481,"_30211":70471,"_20923":117335,"_5":14374,"_27449":117310,"_2949":117336},[],"Úsalo para",{"_3465":70482,"_30211":70471,"_20923":117338,"_5":14374,"_27449":117310,"_2949":117339},[],"Qué instala",{"_3465":70483,"_30211":70471,"_20923":117341,"_5":14374,"_27449":117310,"_2949":50329},[],{"_3465":70484,"_30211":70471,"_20923":117343,"_5":14374,"_27449":117310,"_2949":117344},[],"Producción y entornos controlados",{"_3465":70485,"_30211":70471,"_20923":117346,"_5":14374,"_27449":117310,"_2949":117347},[],"Servicios de Lamassu y recursos de Gateway API",{"_3465":70486,"_30211":70471,"_20923":117349,"_5":14374,"_27449":117310,"_2949":49485},[],{"_3465":70487,"_30211":70471,"_20923":117351,"_5":14374,"_27449":117310,"_2949":117352},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3465":70488,"_30211":70471,"_20923":117354,"_5":14374,"_27449":117310,"_2949":117355},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3465":70489,"_30211":70471,"_20923":117357,"_5":14374,"_27449":117314,"_2949":117358},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3465":70490,"_30211":70471,"_20923":117360,"_5":14374,"_27449":117314,"_2949":117361},[],"Área",{"_3465":70491,"_30211":70471,"_20923":117363,"_5":14374,"_27449":117314,"_2949":117364},[],"El chart de Lamassu proporciona",{"_3465":70492,"_30211":70471,"_20923":117366,"_5":14374,"_27449":117314,"_2949":117367},[],"Tú proporcionas",{"_3465":70493,"_30211":70471,"_20923":117369,"_5":14374,"_27449":117314,"_2949":117370},[],"Aplicaciones Lamassu",{"_3465":70494,"_30211":70471,"_20923":117372,"_5":14374,"_27449":117314,"_2949":117373},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3465":70495,"_30211":70471,"_20923":117375,"_5":14374,"_27449":117314,"_2949":117376},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3465":70496,"_30211":70471,"_20923":117378,"_5":14374,"_27449":117314,"_2949":117379},[],"Datos PostgreSQL",{"_3465":70497,"_30211":70471,"_20923":117381,"_5":14374,"_27449":117314,"_2949":117382},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3465":70498,"_30211":70471,"_20923":117384,"_5":14374,"_27449":117314,"_2949":117385},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3465":70499,"_30211":70471,"_20923":117387,"_5":14374,"_27449":117314,"_2949":117388},[],"Mensajería",{"_3465":70500,"_30211":70471,"_20923":117390,"_5":14374,"_27449":117314,"_2949":117391},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3465":70501,"_30211":70471,"_20923":117393,"_5":14374,"_27449":117314,"_2949":117394},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3465":70502,"_30211":70471,"_20923":117396,"_5":14374,"_27449":117314,"_2949":117397},[],"Identidad",{"_3465":70503,"_30211":70471,"_20923":117399,"_5":14374,"_27449":117314,"_2949":117400},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3465":70504,"_30211":70471,"_20923":117402,"_5":14374,"_27449":117314,"_2949":117403},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3465":70505,"_30211":70471,"_20923":117405,"_5":14374,"_27449":117314,"_2949":117406},[],"Enrutamiento externo",{"_3465":70506,"_30211":70471,"_20923":117408,"_5":14374,"_27449":117314,"_2949":117409},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3465":70507,"_30211":70471,"_20923":117411,"_5":14374,"_27449":117314,"_2949":117412},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3465":70508,"_30211":70471,"_20923":117414,"_5":14374,"_27449":117314,"_2949":50403},[],{"_3465":70509,"_30211":70471,"_20923":117416,"_5":14374,"_27449":117314,"_2949":117417},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3465":70510,"_30211":70471,"_20923":117419,"_5":14374,"_27449":117314,"_2949":117420},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3465":70511,"_30211":70471,"_20923":117422,"_5":14374,"_27449":117314,"_2949":117423},[],"Datos persistentes de la aplicación",{"_3465":70512,"_30211":70471,"_20923":117425,"_5":14374,"_27449":117314,"_2949":117426},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3465":70513,"_30211":70471,"_20923":117428,"_5":14374,"_27449":117314,"_2949":117429},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3465":70514,"_30211":70471,"_20923":117431,"_5":14374,"_27449":117314,"_2949":117432},[],"Integraciones opcionales",{"_3465":70515,"_30211":70471,"_20923":117434,"_5":14374,"_27449":117314,"_2949":117435},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3465":70516,"_30211":70471,"_20923":117437,"_5":14374,"_27449":117314,"_2949":117438},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3465":70517,"_30211":70471,"_20923":117440,"_5":14374,"_27449":117314,"_2949":117441},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3465":70518,"_30211":70471,"_20923":117443,"_5":14374,"_27449":117314,"_2949":117444},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3465":70519,"_30211":70471,"_20923":117446,"_5":14374,"_27449":117318,"_2949":117447},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3465":70520,"_30211":70471,"_20923":117449,"_5":14374,"_27449":117318,"_2949":117450},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3465":70521,"_30211":70471,"_20923":117452,"_5":14374,"_27449":117322,"_2949":117453},[],"Kubernetes 1.24 o posterior",{"_3465":70522,"_30211":70471,"_20923":117455,"_5":14374,"_27449":117322,"_2949":117456},[],"Helm 3.2 o posterior",{"_3465":70523,"_30211":70471,"_20923":117458,"_5":14374,"_27449":117322,"_2949":117459},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3465":70524,"_30211":70471,"_20923":117461,"_5":14374,"_27449":117322,"_2949":117462},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3465":70525,"_30211":70471,"_20923":117464,"_5":14374,"_27449":117322,"_2949":117465},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3465":70526,"_30211":70471,"_20923":117467,"_5":14374,"_27449":117322,"_2949":117468},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3465":70527,"_30211":70471,"_20923":117470,"_5":14374,"_27449":117322,"_2949":117471},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3465":70528,"_30211":70471,"_20923":117473,"_5":14374,"_27449":117326,"_2949":117474},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3465":70529,"_30211":70471,"_20923":117476,"_5":14374,"_27449":117326,"_2949":117477},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3465":70530,"_30211":70471,"_20923":117479,"_5":14374,"_27449":117326,"_2949":117480},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3465":70531,"_30211":70471,"_20923":117482,"_5":14374,"_27449":117326,"_2949":117483},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3465":70532,"_30211":70532,"_5":14726,"_2949":117485,"_30543":117486,"_20923":117488,"_27449":70532},"Resolución de problemas de despliegue",[49241,116289,117487],"Operación",[],{"_3465":70533,"_30211":70532,"_20923":117490,"_5":14374,"_27449":70532,"_2949":117491},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3465":70534,"_30211":70532,"_5":30540,"_20923":117493,"_27449":117494,"_2949":117495},[],"/docs/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3465":70535,"_30211":70532,"_5":30540,"_20923":117497,"_27449":117498,"_2949":117499},[],"/docs/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3465":70536,"_30211":70532,"_5":30540,"_20923":117501,"_27449":117502,"_2949":117503},[],"/docs/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3465":70537,"_30211":70532,"_5":30540,"_20923":117505,"_27449":117506,"_2949":117507},[],"/docs/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3465":70538,"_30211":70532,"_5":30540,"_20923":117509,"_27449":117510,"_2949":117511},[],"/docs/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3465":70539,"_30211":70532,"_5":30540,"_20923":117513,"_27449":117514,"_2949":117515},[],"/docs/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3465":70540,"_30211":70532,"_5":30540,"_20923":117517,"_27449":117518,"_2949":117519},[],"/docs/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3465":70541,"_30211":70532,"_5":30540,"_20923":117521,"_27449":117522,"_2949":117523},[],"/docs/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3465":70542,"_30211":70532,"_5":30540,"_20923":117525,"_27449":117526,"_2949":117527},[],"/docs/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3465":70543,"_30211":70532,"_5":30540,"_20923":117529,"_27449":117530,"_2949":117531},[],"/docs/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3465":70544,"_30211":70532,"_5":30540,"_20923":117533,"_27449":117534,"_2949":117535},[],"/docs/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3465":70545,"_30211":70532,"_5":30540,"_20923":117537,"_27449":117538,"_2949":117539},[],"/docs/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3465":70546,"_30211":70532,"_5":30540,"_20923":117541,"_27449":117542,"_2949":117543},[],"/docs/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3465":70547,"_30211":70532,"_20923":117545,"_5":14374,"_27449":70532,"_2949":117546},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3465":70548,"_30211":70532,"_20923":117548,"_5":14374,"_27449":117498,"_2949":117549},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3465":70549,"_30211":70532,"_20923":117551,"_5":14374,"_27449":117502,"_2949":117552},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3465":70550,"_30211":70532,"_20923":117554,"_5":14374,"_27449":117506,"_2949":117555},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3465":70551,"_30211":70532,"_20923":117557,"_5":14374,"_27449":117510,"_2949":117558},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3465":70552,"_30211":70532,"_20923":117560,"_5":14374,"_27449":117514,"_2949":117561},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3465":70553,"_30211":70532,"_20923":117563,"_5":14374,"_27449":117518,"_2949":117564},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3465":70554,"_30211":70532,"_20923":117566,"_5":14374,"_27449":117518,"_2949":117567},[],"Ejecuta también la prueba de conectividad del chart:",{"_3465":70555,"_30211":70532,"_20923":117569,"_5":14374,"_27449":117518,"_2949":117570},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3465":70556,"_30211":70532,"_20923":117572,"_5":14374,"_27449":117518,"_2949":117573},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3465":70557,"_30211":70532,"_20923":117575,"_5":14374,"_27449":117522,"_2949":117576},[],"Si recibes un 401:",{"_3465":70558,"_30211":70532,"_20923":117578,"_5":14374,"_27449":117522,"_2949":117579},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3465":70559,"_30211":70532,"_20923":117581,"_5":14374,"_27449":117522,"_2949":117582},[],"verifica emisor, audiencia y expiración del token;",{"_3465":70560,"_30211":70532,"_20923":117584,"_5":14374,"_27449":117522,"_2949":117585},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3465":70561,"_30211":70532,"_20923":117587,"_5":14374,"_27449":117522,"_2949":117588},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3465":70562,"_30211":70532,"_20923":117590,"_5":14374,"_27449":117522,"_2949":117591},[],"Si el login termina pero las APIs devuelven 403:",{"_3465":70563,"_30211":70532,"_20923":117593,"_5":14374,"_27449":117522,"_2949":117594},[],"inspecciona los claims reales del token;",{"_3465":70564,"_30211":70532,"_20923":117596,"_5":14374,"_27449":117522,"_2949":117597},[],"confirma que coinciden con un principal activo;",{"_3465":70565,"_30211":70532,"_20923":117599,"_5":14374,"_27449":117522,"_2949":117600},[],"revisa las políticas concedidas al principal;",{"_3465":70566,"_30211":70532,"_20923":117602,"_5":14374,"_27449":117522,"_2949":117603},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3465":70567,"_30211":70532,"_20923":117605,"_5":14374,"_27449":117522,"_2949":117606},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3465":70568,"_30211":70532,"_20923":117608,"_5":14374,"_27449":117526,"_2949":117609},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3465":70569,"_30211":70532,"_20923":117611,"_5":14374,"_27449":117526,"_2949":117612},[],"Localiza el pod y Service de authz.",{"_3465":70570,"_30211":70532,"_20923":117614,"_5":14374,"_27449":117526,"_2949":117615},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3465":70571,"_30211":70532,"_20923":117617,"_5":14374,"_27449":117526,"_2949":117618},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3465":70572,"_30211":70532,"_20923":117620,"_5":14374,"_27449":117526,"_2949":117621},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3465":70573,"_30211":70532,"_20923":117623,"_5":14374,"_27449":117526,"_2949":117624},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3465":70574,"_30211":70532,"_20923":117626,"_5":14374,"_27449":117530,"_2949":117627},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3465":70575,"_30211":70532,"_20923":117629,"_5":14374,"_27449":117534,"_2949":117630},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3465":70576,"_30211":70532,"_20923":117632,"_5":14374,"_27449":117534,"_2949":117633},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3465":70577,"_30211":70532,"_20923":117635,"_5":14374,"_27449":117534,"_2949":117636},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3465":70578,"_30211":70532,"_20923":117638,"_5":14374,"_27449":117534,"_2949":117639},[],"volumen persistente sin enlazar;",{"_3465":70579,"_30211":70532,"_20923":117641,"_5":14374,"_27449":117534,"_2949":117642},[],"imagen inaccesible o política de pull incorrecta;",{"_3465":70580,"_30211":70532,"_20923":117644,"_5":14374,"_27449":117534,"_2949":117645},[],"configuración inválida del motor criptográfico;",{"_3465":70581,"_30211":70532,"_20923":117647,"_5":14374,"_27449":117534,"_2949":117648},[],"límites de CPU o memoria demasiado bajos;",{"_3465":70582,"_30211":70532,"_20923":117650,"_5":14374,"_27449":117534,"_2949":117651},[],"migración previa incompleta.",{"_3465":70583,"_30211":70532,"_20923":117653,"_5":14374,"_27449":117534,"_2949":117654},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3465":70584,"_30211":70532,"_20923":117656,"_5":14374,"_27449":117534,"_2949":117657},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3465":70585,"_30211":70532,"_20923":117659,"_5":14374,"_27449":117534,"_2949":117660},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3465":70586,"_30211":70532,"_20923":117662,"_5":14374,"_27449":117538,"_2949":117663},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3465":70587,"_30211":70532,"_20923":117665,"_5":14374,"_27449":117538,"_2949":117666},[],"verifica que esté habilitado en el servicio emisor;",{"_3465":70588,"_30211":70532,"_20923":117668,"_5":14374,"_27449":117538,"_2949":117669},[],"comprueba conectividad y credenciales AMQP;",{"_3465":70589,"_30211":70532,"_20923":117671,"_5":14374,"_27449":117538,"_2949":117672},[],"revisa exchange, routing key, colas y consumidores;",{"_3465":70590,"_30211":70532,"_20923":117674,"_5":14374,"_27449":117538,"_2949":117675},[],"inspecciona dead-letter queues;",{"_3465":70591,"_30211":70532,"_20923":117677,"_5":14374,"_27449":117538,"_2949":117678},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3465":70592,"_30211":70532,"_20923":117680,"_5":14374,"_27449":117538,"_2949":117681},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3465":70593,"_30211":70532,"_20923":117683,"_5":14374,"_27449":117538,"_2949":117684},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3465":70594,"_30211":70532,"_20923":117686,"_5":14374,"_27449":117538,"_2949":117687},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3465":70595,"_30211":70532,"_20923":117689,"_5":14374,"_27449":117538,"_2949":117690},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3465":70596,"_30211":70532,"_20923":117692,"_5":14374,"_27449":117538,"_2949":117693},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3465":70597,"_30211":70532,"_20923":117695,"_5":14374,"_27449":117538,"_2949":117696},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3465":70598,"_30211":70532,"_20923":117698,"_5":14374,"_27449":117538,"_2949":117699},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3465":70599,"_30211":70532,"_20923":117701,"_5":14374,"_27449":117542,"_2949":117702},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3465":70600,"_30211":70532,"_20923":117704,"_5":14374,"_27449":117542,"_2949":117705},[],"Antes de cerrar una incidencia, guarda:",{"_3465":70601,"_30211":70532,"_20923":117707,"_5":14374,"_27449":117542,"_2949":117708},[],"causa confirmada;",{"_3465":70602,"_30211":70532,"_20923":117710,"_5":14374,"_27449":117542,"_2949":117711},[],"alcance temporal y recursos afectados;",{"_3465":70603,"_30211":70532,"_20923":117713,"_5":14374,"_27449":117542,"_2949":117714},[],"comandos o consultas utilizados;",{"_3465":70604,"_30211":70532,"_20923":117716,"_5":14374,"_27449":117542,"_2949":117717},[],"cambio aplicado y forma de revertirlo;",{"_3465":70605,"_30211":70532,"_20923":117719,"_5":14374,"_27449":117542,"_2949":117720},[],"validación desde un consumidor;",{"_3465":70606,"_30211":70532,"_20923":117722,"_5":14374,"_27449":117542,"_2949":117723},[],"acción preventiva y propietario.",{"_3465":70607,"_30211":70607,"_5":14726,"_2949":117725,"_30543":117726,"_20923":117729,"_27449":70607},"Control de acceso",[49241,117727,117728],"Plataforma","Administración",[],{"_3465":70608,"_30211":70607,"_20923":117731,"_5":14374,"_27449":70607,"_2949":117732},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3465":70609,"_30211":70607,"_5":30540,"_20923":117734,"_27449":117735,"_2949":117736},[],"/docs/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3465":70610,"_30211":70607,"_5":30540,"_20923":117738,"_27449":117739,"_2949":117740},[],"/docs/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3465":70611,"_30211":70607,"_5":30540,"_20923":117742,"_27449":117743,"_2949":117744},[],"/docs/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3465":70612,"_30211":70607,"_5":30540,"_20923":117746,"_27449":117747,"_2949":117748},[],"/docs/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3465":70613,"_30211":70607,"_5":30540,"_20923":117750,"_27449":117751,"_2949":117752},[],"/docs/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3465":70614,"_30211":70607,"_5":30540,"_20923":117754,"_27449":117755,"_2949":117756},[],"/docs/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3465":70615,"_30211":70607,"_5":30540,"_20923":117758,"_27449":117759,"_2949":117760},[],"/docs/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3465":70616,"_30211":70607,"_5":30540,"_20923":117762,"_27449":117763,"_2949":117764},[],"/docs/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3465":70617,"_30211":70607,"_5":30540,"_20923":117766,"_27449":117767,"_2949":117768},[],"/docs/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3465":70618,"_30211":70607,"_5":30540,"_20923":117770,"_27449":117771,"_2949":117772},[],"/docs/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3465":70619,"_30211":70607,"_5":30540,"_20923":117774,"_27449":117775,"_2949":117776},[],"/docs/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3465":70620,"_30211":70607,"_5":30540,"_20923":117778,"_27449":117779,"_2949":117780},[],"/docs/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3465":70621,"_30211":70607,"_5":30540,"_20923":117782,"_27449":117783,"_2949":117784},[],"/docs/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3465":70622,"_30211":70607,"_5":30540,"_20923":117786,"_27449":117787,"_2949":117788},[],"/docs/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3465":70623,"_30211":70607,"_5":30540,"_20923":117790,"_27449":117791,"_2949":117792},[],"/docs/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3465":70624,"_30211":70607,"_5":30540,"_20923":117794,"_27449":117795,"_2949":116895},[],"/docs/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3465":70625,"_30211":70607,"_5":30540,"_20923":117797,"_27449":117798,"_2949":117799},[],"/docs/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3465":70626,"_30211":70607,"_5":30540,"_20923":117801,"_27449":117802,"_2949":117803},[],"/docs/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3465":70627,"_30211":70607,"_5":30540,"_20923":117805,"_27449":117806,"_2949":117807},[],"/docs/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3465":70628,"_30211":70607,"_5":30540,"_20923":117809,"_27449":117810,"_2949":117811},[],"/docs/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3465":70629,"_30211":70607,"_5":30540,"_20923":117813,"_27449":117814,"_2949":117815},[],"/docs/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3465":70630,"_30211":70607,"_5":30540,"_20923":117817,"_27449":117818,"_2949":117819},[],"/docs/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3465":70631,"_30211":70607,"_5":30540,"_20923":117821,"_27449":117822,"_2949":117823},[],"/docs/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3465":70632,"_30211":70607,"_5":30540,"_20923":117825,"_27449":117826,"_2949":117827},[],"/docs/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3465":70633,"_30211":70607,"_5":30540,"_20923":117829,"_27449":117830,"_2949":117831},[],"/docs/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3465":70634,"_30211":70607,"_5":30540,"_20923":117833,"_27449":117834,"_2949":117835},[],"/docs/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3465":70635,"_30211":70607,"_5":30540,"_20923":117837,"_27449":117838,"_2949":117839},[],"/docs/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3465":70636,"_30211":70607,"_5":30540,"_20923":117841,"_27449":117842,"_2949":117843},[],"/docs/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3465":70637,"_30211":70607,"_5":30540,"_20923":117845,"_27449":117846,"_2949":117847},[],"/docs/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3465":70638,"_30211":70607,"_5":30540,"_20923":117849,"_27449":117850,"_2949":117851},[],"/docs/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3465":70639,"_30211":70607,"_5":30540,"_20923":117853,"_27449":117854,"_2949":117855},[],"/docs/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3465":70640,"_30211":70607,"_20923":117857,"_5":14374,"_27449":70607,"_2949":117858},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3465":70641,"_30211":70607,"_20923":117860,"_5":14374,"_27449":70607,"_2949":117861},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3465":70642,"_30211":70607,"_20923":117863,"_5":14374,"_27449":70607,"_2949":117864},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3465":70643,"_30211":70607,"_20923":117866,"_5":14374,"_27449":117735,"_2949":117867},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3465":70644,"_30211":70607,"_20923":117869,"_5":14374,"_27449":117735,"_2949":117870},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3465":70645,"_30211":70607,"_20923":117872,"_5":14374,"_27449":117735,"_2949":117873},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3465":70646,"_30211":70607,"_20923":117875,"_5":14374,"_27449":117735,"_2949":117876},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3465":70647,"_30211":70607,"_20923":117878,"_5":14374,"_27449":117735,"_2949":117879},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3465":70648,"_30211":70607,"_20923":117881,"_5":14374,"_27449":117735,"_2949":117882},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3465":70649,"_30211":70607,"_20923":117884,"_5":14374,"_27449":117739,"_2949":117885},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3465":70650,"_30211":70607,"_20923":117887,"_5":14374,"_27449":117739,"_2949":117888},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3465":70651,"_30211":70607,"_20923":117890,"_5":14374,"_27449":117743,"_2949":117891},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3465":70652,"_30211":70607,"_20923":117893,"_5":14374,"_27449":117743,"_2949":117894},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3465":70653,"_30211":70607,"_20923":117896,"_5":14374,"_27449":117743,"_2949":117897},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3465":70654,"_30211":70607,"_20923":117899,"_5":14374,"_27449":117743,"_2949":117900},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3465":70655,"_30211":70607,"_20923":117902,"_5":14374,"_27449":117743,"_2949":117903},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3465":70656,"_30211":70607,"_20923":117905,"_5":14374,"_27449":117743,"_2949":117906},[],"Carga por separado las políticas concedidas a cada principal.",{"_3465":70657,"_30211":70607,"_20923":117908,"_5":14374,"_27449":117743,"_2949":117909},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3465":70658,"_30211":70607,"_20923":117911,"_5":14374,"_27449":117743,"_2949":117912},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3465":70659,"_30211":70607,"_20923":117914,"_5":14374,"_27449":117743,"_2949":117915},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3465":70660,"_30211":70607,"_20923":117917,"_5":14374,"_27449":117743,"_2949":117918},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3465":70661,"_30211":70607,"_20923":117920,"_5":14374,"_27449":117743,"_2949":117921},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3465":70662,"_30211":70607,"_20923":117923,"_5":14374,"_27449":117743,"_2949":117924},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3465":70663,"_30211":70607,"_20923":117926,"_5":14374,"_27449":117747,"_2949":117927},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3465":70664,"_30211":70607,"_20923":117929,"_5":14374,"_27449":117747,"_2949":117930},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3465":70665,"_30211":70607,"_20923":117932,"_5":14374,"_27449":117747,"_2949":117933},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3465":70666,"_30211":70607,"_20923":117935,"_5":14374,"_27449":117747,"_2949":117936},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3465":70667,"_30211":70607,"_20923":117938,"_5":14374,"_27449":117747,"_2949":117939},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3465":70668,"_30211":70607,"_20923":117941,"_5":14374,"_27449":117747,"_2949":117942},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3465":70669,"_30211":70607,"_20923":117944,"_5":14374,"_27449":117747,"_2949":117945},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3465":70670,"_30211":70607,"_20923":117947,"_5":14374,"_27449":117747,"_2949":117948},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3465":70671,"_30211":70607,"_20923":117950,"_5":14374,"_27449":117751,"_2949":117951},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3465":70672,"_30211":70607,"_20923":117953,"_5":14374,"_27449":117751,"_2949":117954},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3465":70673,"_30211":70607,"_20923":117956,"_5":14374,"_27449":117751,"_2949":117957},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3465":70674,"_30211":70607,"_20923":117959,"_5":14374,"_27449":117751,"_2949":117960},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3465":70675,"_30211":70607,"_20923":117962,"_5":14374,"_27449":117751,"_2949":117963},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3465":70676,"_30211":70607,"_20923":117965,"_5":14374,"_27449":117751,"_2949":117966},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3465":70677,"_30211":70607,"_20923":117968,"_5":14374,"_27449":117751,"_2949":117969},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3465":70678,"_30211":70607,"_20923":117971,"_5":14374,"_27449":117751,"_2949":117972},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3465":70679,"_30211":70607,"_20923":117974,"_5":14374,"_27449":117751,"_2949":117975},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3465":70680,"_30211":70607,"_20923":117977,"_5":14374,"_27449":117751,"_2949":117978},[],"Las acciones se dividen en dos grupos:",{"_3465":70681,"_30211":70607,"_20923":117980,"_5":14374,"_27449":117751,"_2949":117981},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3465":70682,"_30211":70607,"_20923":117983,"_5":14374,"_27449":117751,"_2949":117984},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3465":70683,"_30211":70607,"_20923":117986,"_5":14374,"_27449":117751,"_2949":117987},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3465":70684,"_30211":70607,"_20923":117989,"_5":14374,"_27449":117755,"_2949":117990},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3465":70685,"_30211":70607,"_20923":117992,"_5":14374,"_27449":117755,"_2949":117993},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3465":70686,"_30211":70607,"_20923":117995,"_5":14374,"_27449":117755,"_2949":117996},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3465":70687,"_30211":70607,"_20923":117998,"_5":14374,"_27449":117759,"_2949":117999},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3465":70688,"_30211":70607,"_20923":118001,"_5":14374,"_27449":117759,"_2949":118002},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3465":70689,"_30211":70607,"_20923":118004,"_5":14374,"_27449":117759,"_2949":118005},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3465":70690,"_30211":70607,"_20923":118007,"_5":14374,"_27449":117759,"_2949":118008},[],"Los operadores implementados son:",{"_3465":70691,"_30211":70607,"_20923":118010,"_5":14374,"_27449":117759,"_2949":118011},[],"`equals`, para igualdad exacta;",{"_3465":70692,"_30211":70607,"_20923":118013,"_5":14374,"_27449":117759,"_2949":118014},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3465":70693,"_30211":70607,"_20923":118016,"_5":14374,"_27449":117759,"_2949":118017},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3465":70694,"_30211":70607,"_20923":118019,"_5":14374,"_27449":117759,"_2949":118020},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3465":70695,"_30211":70607,"_20923":118022,"_5":14374,"_27449":117763,"_2949":118023},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3465":70696,"_30211":70607,"_20923":118025,"_5":14374,"_27449":117763,"_2949":118026},[],"Los modos disponibles son:",{"_3465":70697,"_30211":70607,"_20923":118028,"_5":14374,"_27449":117763,"_2949":118029},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3465":70698,"_30211":70607,"_20923":118031,"_5":14374,"_27449":117763,"_2949":118032},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3465":70699,"_30211":70607,"_20923":118034,"_5":14374,"_27449":117763,"_2949":118035},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3465":70700,"_30211":70607,"_20923":118037,"_5":14374,"_27449":117763,"_2949":118038},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3465":70701,"_30211":70607,"_20923":118040,"_5":14374,"_27449":117763,"_2949":118041},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3465":70702,"_30211":70607,"_20923":118043,"_5":14374,"_27449":117763,"_2949":118044},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3465":70703,"_30211":70607,"_20923":118046,"_5":14374,"_27449":117767,"_2949":118047},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3465":70704,"_30211":70607,"_20923":118049,"_5":14374,"_27449":117767,"_2949":118050},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3465":70705,"_30211":70607,"_20923":118052,"_5":14374,"_27449":117767,"_2949":118053},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3465":70706,"_30211":70607,"_20923":118055,"_5":14374,"_27449":117767,"_2949":118056},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3465":70707,"_30211":70607,"_20923":118058,"_5":14374,"_27449":117775,"_2949":118059},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3465":70708,"_30211":70607,"_20923":118061,"_5":14374,"_27449":117775,"_2949":118062},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3465":70709,"_30211":70607,"_20923":118064,"_5":14374,"_27449":117779,"_2949":118065},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3465":70710,"_30211":70607,"_20923":118067,"_5":14374,"_27449":117779,"_2949":118068},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3465":70711,"_30211":70607,"_20923":118070,"_5":14374,"_27449":117783,"_2949":118071},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3465":70712,"_30211":70607,"_20923":118073,"_5":14374,"_27449":117783,"_2949":118074},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3465":70713,"_30211":70607,"_20923":118076,"_5":14374,"_27449":117783,"_2949":118077},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3465":70714,"_30211":70607,"_20923":118079,"_5":14374,"_27449":117787,"_2949":118080},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3465":70715,"_30211":70607,"_20923":118082,"_5":14374,"_27449":117787,"_2949":118083},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3465":70716,"_30211":70607,"_20923":118085,"_5":14374,"_27449":117787,"_2949":118086},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3465":70717,"_30211":70607,"_20923":118088,"_5":14374,"_27449":117787,"_2949":118089},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3465":70718,"_30211":70607,"_20923":118091,"_5":14374,"_27449":117787,"_2949":118092},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3465":70719,"_30211":70607,"_20923":118094,"_5":14374,"_27449":117787,"_2949":118095},[],"Ten en cuenta que:",{"_3465":70720,"_30211":70607,"_20923":118097,"_5":14374,"_27449":117787,"_2949":118098},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3465":70721,"_30211":70607,"_20923":118100,"_5":14374,"_27449":117787,"_2949":118101},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3465":70722,"_30211":70607,"_20923":118103,"_5":14374,"_27449":117787,"_2949":118104},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3465":70723,"_30211":70607,"_20923":118106,"_5":14374,"_27449":117791,"_2949":118107},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3465":70724,"_30211":70607,"_20923":118109,"_5":14374,"_27449":117791,"_2949":118110},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3465":70725,"_30211":70607,"_20923":118112,"_5":14374,"_27449":117791,"_2949":118113},[],"acceso completo y de solo lectura a KMS;",{"_3465":70726,"_30211":70607,"_20923":118115,"_5":14374,"_27449":117791,"_2949":118116},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3465":70727,"_30211":70607,"_20923":118118,"_5":14374,"_27449":117791,"_2949":118119},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3465":70728,"_30211":70607,"_20923":118121,"_5":14374,"_27449":117791,"_2949":118122},[],"acceso a la interfaz;",{"_3465":70729,"_30211":70607,"_20923":118124,"_5":14374,"_27449":117791,"_2949":118125},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3465":70730,"_30211":70607,"_20923":118127,"_5":14374,"_27449":117791,"_2949":118128},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3465":70731,"_30211":70607,"_20923":118130,"_5":14374,"_27449":117791,"_2949":118131},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3465":70732,"_30211":70607,"_20923":118133,"_5":14374,"_27449":117795,"_2949":118134},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3465":70733,"_30211":70607,"_20923":118136,"_5":14374,"_27449":117795,"_2949":118137},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3465":70734,"_30211":70607,"_20923":118139,"_5":14374,"_27449":117795,"_2949":118140},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3465":70735,"_30211":70607,"_20923":118142,"_5":14374,"_27449":117798,"_2949":118143},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3465":70736,"_30211":70607,"_20923":118145,"_5":14374,"_27449":117802,"_2949":118146},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3465":70737,"_30211":70607,"_20923":118148,"_5":14374,"_27449":117802,"_2949":118149},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3465":70738,"_30211":70607,"_20923":118151,"_5":14374,"_27449":117806,"_2949":118152},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3465":70739,"_30211":70607,"_20923":118154,"_5":14374,"_27449":117810,"_2949":118155},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3465":70740,"_30211":70607,"_20923":118157,"_5":14374,"_27449":117814,"_2949":118158},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3465":70741,"_30211":70607,"_20923":118160,"_5":14374,"_27449":117818,"_2949":118161},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3465":70742,"_30211":70607,"_20923":118163,"_5":14374,"_27449":117818,"_2949":118164},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3465":70743,"_30211":70607,"_20923":118166,"_5":14374,"_27449":117822,"_2949":118167},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3465":70744,"_30211":70607,"_20923":118169,"_5":14374,"_27449":117822,"_2949":118170},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3465":70745,"_30211":70607,"_20923":118172,"_5":14374,"_27449":117822,"_2949":118173},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3465":70746,"_30211":70607,"_20923":118175,"_5":14374,"_27449":117822,"_2949":118176},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3465":70747,"_30211":70607,"_20923":118178,"_5":14374,"_27449":117822,"_2949":118179},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3465":70748,"_30211":70607,"_20923":118181,"_5":14374,"_27449":117822,"_2949":118182},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3465":70749,"_30211":70607,"_20923":118184,"_5":14374,"_27449":117822,"_2949":118185},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3465":70750,"_30211":70607,"_20923":118187,"_5":14374,"_27449":117822,"_2949":118188},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3465":70751,"_30211":70607,"_20923":118190,"_5":14374,"_27449":117826,"_2949":118191},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3465":70752,"_30211":70607,"_20923":118193,"_5":14374,"_27449":117826,"_2949":118194},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3465":70753,"_30211":70607,"_20923":118196,"_5":14374,"_27449":117826,"_2949":118197},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3465":70754,"_30211":70607,"_20923":118199,"_5":14374,"_27449":117830,"_2949":118200},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3465":70755,"_30211":70607,"_20923":118202,"_5":14374,"_27449":117830,"_2949":118203},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3465":70756,"_30211":70607,"_20923":118205,"_5":14374,"_27449":117830,"_2949":118206},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3465":70757,"_30211":70607,"_20923":118208,"_5":14374,"_27449":117830,"_2949":118209},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3465":70758,"_30211":70607,"_20923":118211,"_5":14374,"_27449":117830,"_2949":118212},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3465":70759,"_30211":70607,"_20923":118214,"_5":14374,"_27449":117830,"_2949":118215},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3465":70760,"_30211":70607,"_20923":118217,"_5":14374,"_27449":117830,"_2949":118218},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3465":70761,"_30211":70607,"_20923":118220,"_5":14374,"_27449":117830,"_2949":118221},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3465":70762,"_30211":70607,"_20923":118223,"_5":14374,"_27449":117838,"_2949":118224},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3465":70763,"_30211":70607,"_20923":118226,"_5":14374,"_27449":117842,"_2949":118227},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3465":70764,"_30211":70607,"_20923":118229,"_5":14374,"_27449":117842,"_2949":118230},[],"que exista un principal activo del tipo correcto;",{"_3465":70765,"_30211":70607,"_20923":118232,"_5":14374,"_27449":117842,"_2949":118233},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3465":70766,"_30211":70607,"_20923":118235,"_5":14374,"_27449":117842,"_2949":118236},[],"que todas las condiciones del principal se cumplan;",{"_3465":70767,"_30211":70607,"_20923":118238,"_5":14374,"_27449":117842,"_2949":118239},[],"que el principal tenga concedida la política esperada;",{"_3465":70768,"_30211":70607,"_20923":118241,"_5":14374,"_27449":117842,"_2949":118242},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3465":70769,"_30211":70607,"_20923":118244,"_5":14374,"_27449":117842,"_2949":118245},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3465":70770,"_30211":70607,"_20923":118247,"_5":14374,"_27449":117842,"_2949":118248},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3465":70771,"_30211":70607,"_20923":118250,"_5":14374,"_27449":117846,"_2949":118251},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3465":70772,"_30211":70607,"_20923":118253,"_5":14374,"_27449":117850,"_2949":118254},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3465":70773,"_30211":70607,"_20923":118256,"_5":14374,"_27449":117854,"_2949":118257},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3465":70774,"_30211":70607,"_20923":118259,"_5":14374,"_27449":117854,"_2949":118260},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3465":70775,"_30211":70775,"_5":14726,"_2949":118262,"_30543":118263,"_20923":118264,"_27449":70775},"Alertas y suscripciones",[49241,117727,117728],[],{"_3465":70776,"_30211":70775,"_20923":118266,"_5":14374,"_27449":70775,"_2949":118267},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3465":70777,"_30211":70775,"_5":30540,"_20923":118269,"_27449":118270,"_2949":118271},[],"/docs/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3465":70778,"_30211":70775,"_5":30540,"_20923":118273,"_27449":118274,"_2949":118275},[],"/docs/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3465":70779,"_30211":70775,"_5":30540,"_20923":118277,"_27449":118278,"_2949":118279},[],"/docs/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3465":70780,"_30211":70775,"_5":30540,"_20923":118281,"_27449":118282,"_2949":118283},[],"/docs/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3465":70781,"_30211":70775,"_5":30540,"_20923":118285,"_27449":118286,"_2949":118287},[],"/docs/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3465":70782,"_30211":70775,"_5":30540,"_20923":118289,"_27449":118290,"_2949":118291},[],"/docs/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3465":70783,"_30211":70775,"_5":30540,"_20923":118293,"_27449":118294,"_2949":118295},[],"/docs/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3465":70784,"_30211":70775,"_5":30540,"_20923":118297,"_27449":118298,"_2949":118299},[],"/docs/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3465":70785,"_30211":70775,"_5":30540,"_20923":118301,"_27449":118302,"_2949":118303},[],"/docs/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3465":70786,"_30211":70775,"_5":30540,"_20923":118305,"_27449":118306,"_2949":118307},[],"/docs/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3465":70787,"_30211":70775,"_5":30540,"_20923":118309,"_27449":118310,"_2949":118311},[],"/docs/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3465":70788,"_30211":70775,"_20923":118313,"_5":14374,"_27449":70775,"_2949":118314},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3465":70789,"_30211":70775,"_20923":118316,"_5":14374,"_27449":118270,"_2949":118317},[],"Un servicio publica un evento de dominio.",{"_3465":70790,"_30211":70775,"_20923":118319,"_5":14374,"_27449":118270,"_2949":118320},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3465":70791,"_30211":70775,"_20923":118322,"_5":14374,"_27449":118270,"_2949":118323},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3465":70792,"_30211":70775,"_20923":118325,"_5":14374,"_27449":118270,"_2949":118326},[],"Lamassu entrega el evento al canal configurado.",{"_3465":70793,"_30211":70775,"_20923":118328,"_5":14374,"_27449":118270,"_2949":118329},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3465":70794,"_30211":70775,"_20923":118331,"_5":14374,"_27449":118274,"_2949":118332},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3465":70795,"_30211":70775,"_20923":118334,"_5":14374,"_27449":118274,"_2949":118335},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3465":70796,"_30211":70775,"_20923":118337,"_5":14374,"_27449":118274,"_2949":118338},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3465":70797,"_30211":70775,"_20923":118340,"_5":14374,"_27449":118274,"_2949":118341},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3465":70798,"_30211":70775,"_20923":118343,"_5":14374,"_27449":118274,"_2949":118344},[],"`apikey_options` necesita `header` y `key`.",{"_3465":70799,"_30211":70775,"_20923":118346,"_5":14374,"_27449":118274,"_2949":118347},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3465":70800,"_30211":70775,"_20923":118349,"_5":14374,"_27449":118274,"_2949":118350},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3465":70801,"_30211":70775,"_20923":118352,"_5":14374,"_27449":118274,"_2949":118353},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3465":70802,"_30211":70775,"_20923":118355,"_5":14374,"_27449":118282,"_2949":118356},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3465":70803,"_30211":70775,"_20923":118358,"_5":14374,"_27449":118286,"_2949":118359},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3465":70804,"_30211":70775,"_20923":118361,"_5":14374,"_27449":118290,"_2949":118362},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3465":70805,"_30211":70775,"_20923":118364,"_5":14374,"_27449":118290,"_2949":118365},[],"**None** notifica todas las instancias del evento.",{"_3465":70806,"_30211":70775,"_20923":118367,"_5":14374,"_27449":118290,"_2949":118368},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3465":70807,"_30211":70775,"_20923":118370,"_5":14374,"_27449":118290,"_2949":118371},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3465":70808,"_30211":70775,"_20923":118373,"_5":14374,"_27449":118290,"_2949":118374},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3465":70809,"_30211":70775,"_20923":118376,"_5":14374,"_27449":118290,"_2949":118377},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3465":70810,"_30211":70775,"_20923":118379,"_5":14374,"_27449":118290,"_2949":118380},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3465":70811,"_30211":70775,"_20923":118382,"_5":14374,"_27449":118294,"_2949":118383},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3465":70812,"_30211":70775,"_20923":118385,"_5":14374,"_27449":118298,"_2949":118386},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3465":70813,"_30211":70775,"_20923":118388,"_5":14374,"_27449":118298,"_2949":118389},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3465":70814,"_30211":70775,"_20923":118391,"_5":14374,"_27449":118298,"_2949":118392},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3465":70815,"_30211":70775,"_20923":118394,"_5":14374,"_27449":118298,"_2949":118395},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3465":70816,"_30211":70775,"_20923":118397,"_5":14374,"_27449":118298,"_2949":118398},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3465":70817,"_30211":70775,"_20923":118400,"_5":14374,"_27449":118298,"_2949":118401},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3465":70818,"_30211":70775,"_20923":118403,"_5":14374,"_27449":118298,"_2949":118404},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3465":70819,"_30211":70775,"_20923":118406,"_5":14374,"_27449":118298,"_2949":118407},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3465":70820,"_30211":70775,"_20923":118409,"_5":14374,"_27449":118302,"_2949":118410},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3465":70821,"_30211":70775,"_20923":118412,"_5":14374,"_27449":118302,"_2949":118413},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3465":70822,"_30211":70775,"_20923":118415,"_5":14374,"_27449":118302,"_2949":118416},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3465":70823,"_30211":70775,"_20923":118418,"_5":14374,"_27449":118302,"_2949":118419},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3465":70824,"_30211":70775,"_20923":118421,"_5":14374,"_27449":118302,"_2949":118422},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3465":70825,"_30211":70775,"_20923":118424,"_5":14374,"_27449":118302,"_2949":118425},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3465":70826,"_30211":70775,"_20923":118427,"_5":14374,"_27449":118302,"_2949":118428},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3465":70827,"_30211":70775,"_20923":118430,"_5":14374,"_27449":118302,"_2949":118431},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3465":70828,"_30211":70775,"_20923":118433,"_5":14374,"_27449":118306,"_2949":118434},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3465":70829,"_30211":70775,"_20923":118436,"_5":14374,"_27449":118306,"_2949":118437},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3465":70830,"_30211":70775,"_20923":118439,"_5":14374,"_27449":118310,"_2949":118440},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3465":70831,"_30211":70775,"_20923":118442,"_5":14374,"_27449":118310,"_2949":118443},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3465":70832,"_30211":70775,"_20923":118445,"_5":14374,"_27449":118310,"_2949":118446},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3465":70833,"_30211":70775,"_20923":118448,"_5":14374,"_27449":118310,"_2949":118449},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3465":70834,"_30211":70775,"_20923":118451,"_5":14374,"_27449":118310,"_2949":118452},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3465":70835,"_30211":70775,"_20923":118454,"_5":14374,"_27449":118310,"_2949":118455},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init` y `va.crl-settings.update`.",{"_3465":70836,"_30211":70775,"_20923":118457,"_5":14374,"_27449":118310,"_2949":118458},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3465":70837,"_30211":70775,"_20923":118460,"_5":14374,"_27449":118310,"_2949":118461},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3465":70838,"_30211":70775,"_20923":118463,"_5":14374,"_27449":118310,"_2949":118464},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3465":70839,"_30211":70839,"_5":14726,"_2949":118466,"_30543":118467,"_20923":118468,"_27449":70839},"Registros de auditoría",[49241,117727,117728],[],{"_3465":70840,"_30211":70839,"_20923":118470,"_5":14374,"_27449":70839,"_2949":118471},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3465":70841,"_30211":70839,"_5":30540,"_20923":118473,"_27449":118474,"_2949":118475},[],"/docs/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3465":70842,"_30211":70839,"_5":30540,"_20923":118477,"_27449":118478,"_2949":118479},[],"/docs/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3465":70843,"_30211":70839,"_5":30540,"_20923":118481,"_27449":118482,"_2949":118483},[],"/docs/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3465":70844,"_30211":70839,"_5":30540,"_20923":118485,"_27449":118486,"_2949":118487},[],"/docs/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3465":70845,"_30211":70839,"_5":30540,"_20923":118489,"_27449":118490,"_2949":118491},[],"/docs/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3465":70846,"_30211":70839,"_5":30540,"_20923":118493,"_27449":118494,"_2949":118495},[],"/docs/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3465":70847,"_30211":70839,"_5":30540,"_20923":118497,"_27449":118498,"_2949":118499},[],"/docs/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3465":70848,"_30211":70839,"_5":30540,"_20923":118501,"_27449":118502,"_2949":118503},[],"/docs/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3465":70849,"_30211":70839,"_5":30540,"_20923":118505,"_27449":118506,"_2949":118507},[],"/docs/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3465":70850,"_30211":70839,"_5":30540,"_20923":118509,"_27449":118510,"_2949":118511},[],"/docs/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3465":70851,"_30211":70839,"_5":30540,"_20923":118513,"_27449":118514,"_2949":118515},[],"/docs/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3465":70852,"_30211":70839,"_20923":118517,"_5":14374,"_27449":70839,"_2949":118518},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3465":70853,"_30211":70839,"_20923":118520,"_5":14374,"_27449":118474,"_2949":118521},[],"El cuerpo de auditoría incluye:",{"_3465":70854,"_30211":70839,"_20923":118523,"_5":14374,"_27449":118474,"_2949":118524},[],"input: datos recibidos por la operación;",{"_3465":70855,"_30211":70839,"_20923":118526,"_5":14374,"_27449":118474,"_2949":118527},[],"has\\_error: indica si el servicio devolvió un error;",{"_3465":70856,"_30211":70839,"_20923":118529,"_5":14374,"_27449":118474,"_2949":118530},[],"output: resultado producido o mensaje de error;",{"_3465":70857,"_30211":70839,"_20923":118532,"_5":14374,"_27449":118474,"_2949":118533},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3465":70858,"_30211":70839,"_20923":118535,"_5":14374,"_27449":118474,"_2949":118536},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3465":70859,"_30211":70839,"_20923":118538,"_5":14374,"_27449":118474,"_2949":118539},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3465":70860,"_30211":70839,"_20923":118541,"_5":14374,"_27449":118478,"_2949":118542},[],"El backend aplica auditoría a mutaciones de:",{"_3465":70861,"_30211":70839,"_20923":118544,"_5":14374,"_27449":118478,"_2949":118545},[],"autoridades, certificados y perfiles de emisión;",{"_3465":70862,"_30211":70839,"_20923":118547,"_5":14374,"_27449":118478,"_2949":118548},[],"claves y motores KMS;",{"_3465":70863,"_30211":70839,"_20923":118550,"_5":14374,"_27449":118478,"_2949":118551},[],"dispositivos e identidades;",{"_3465":70864,"_30211":70839,"_20923":118553,"_5":14374,"_27449":118478,"_2949":118554},[],"DMS y operaciones de enrolamiento;",{"_3465":70865,"_30211":70839,"_20923":118556,"_5":14374,"_27449":118478,"_2949":118557},[],"funciones de validación y CRL;",{"_3465":70866,"_30211":70839,"_20923":118559,"_5":14374,"_27449":118478,"_2949":118560},[],"principales, políticas y concesiones de autorización.",{"_3465":70867,"_30211":70839,"_20923":118562,"_5":14374,"_27449":118478,"_2949":118563},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3465":70868,"_30211":70839,"_20923":118565,"_5":14374,"_27449":118482,"_2949":118566},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3465":70869,"_30211":70839,"_20923":118568,"_5":14374,"_27449":118482,"_2949":118569},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3465":70870,"_30211":70839,"_20923":118571,"_5":14374,"_27449":118482,"_2949":118572},[],"Diseña el consumidor para:",{"_3465":70871,"_30211":70839,"_20923":118574,"_5":14374,"_27449":118482,"_2949":118575},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3465":70872,"_30211":70839,"_20923":118577,"_5":14374,"_27449":118482,"_2949":118578},[],"conservar el CloudEvent completo sin modificar;",{"_3465":70873,"_30211":70839,"_20923":118580,"_5":14374,"_27449":118482,"_2949":118581},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3465":70874,"_30211":70839,"_20923":118583,"_5":14374,"_27449":118482,"_2949":118584},[],"cifrar en tránsito y en reposo;",{"_3465":70875,"_30211":70839,"_20923":118586,"_5":14374,"_27449":118482,"_2949":118587},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3465":70876,"_30211":70839,"_20923":118589,"_5":14374,"_27449":118482,"_2949":118590},[],"aplicar una política explícita de retención y legal hold;",{"_3465":70877,"_30211":70839,"_20923":118592,"_5":14374,"_27449":118482,"_2949":118593},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3465":70878,"_30211":70839,"_20923":118595,"_5":14374,"_27449":118486,"_2949":118596},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3465":70879,"_30211":70839,"_20923":118598,"_5":14374,"_27449":118486,"_2949":118599},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3465":70880,"_30211":70839,"_20923":118601,"_5":14374,"_27449":118494,"_2949":118602},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3465":70881,"_30211":70839,"_20923":118604,"_5":14374,"_27449":118498,"_2949":118605},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3465":70882,"_30211":70839,"_20923":118607,"_5":14374,"_27449":118502,"_2949":118608},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3465":70883,"_30211":70839,"_20923":118610,"_5":14374,"_27449":118506,"_2949":118611},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3465":70884,"_30211":70839,"_20923":118613,"_5":14374,"_27449":118510,"_2949":118614},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3465":70885,"_30211":70839,"_20923":118616,"_5":14374,"_27449":118514,"_2949":118617},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3465":70886,"_30211":70839,"_20923":118619,"_5":14374,"_27449":118514,"_2949":118620},[],"aparece un evento de auditoría correcto;",{"_3465":70887,"_30211":70839,"_20923":118622,"_5":14374,"_27449":118514,"_2949":118623},[],"el principal coincide con la identidad utilizada;",{"_3465":70888,"_30211":70839,"_20923":118625,"_5":14374,"_27449":118514,"_2949":118626},[],"el consumidor lo persiste una sola vez;",{"_3465":70889,"_30211":70839,"_20923":118628,"_5":14374,"_27449":118514,"_2949":118629},[],"puede recuperarse por recurso, actor y periodo;",{"_3465":70890,"_30211":70839,"_20923":118631,"_5":14374,"_27449":118514,"_2949":118632},[],"una interrupción del consumidor produce una alerta.",{"_3465":70891,"_30211":70839,"_20923":118634,"_5":14374,"_27449":118514,"_2949":118635},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3465":70892,"_30211":70892,"_5":14726,"_2949":118637,"_30543":118638,"_20923":118639,"_27449":70892},"Arquitectura de la plataforma",[49241,117727],[],{"_3465":70893,"_30211":70892,"_20923":118641,"_5":14374,"_27449":70892,"_2949":118642},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3465":70894,"_30211":70892,"_5":30540,"_20923":118644,"_27449":118645,"_2949":118646},[],"/docs/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3465":70895,"_30211":70892,"_5":30540,"_20923":118648,"_27449":118649,"_2949":118650},[],"/docs/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3465":70896,"_30211":70892,"_5":30540,"_20923":118652,"_27449":118653,"_2949":118654},[],"/docs/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3465":70897,"_30211":70892,"_5":30540,"_20923":118656,"_27449":118657,"_2949":118658},[],"/docs/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3465":70898,"_30211":70892,"_5":30540,"_20923":118660,"_27449":118661,"_2949":118662},[],"/docs/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3465":70899,"_30211":70892,"_20923":118664,"_5":14374,"_27449":70892,"_2949":118665},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3465":70900,"_30211":70892,"_20923":118667,"_5":14374,"_27449":70892,"_2949":118668},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3465":70901,"_30211":70892,"_20923":118670,"_5":14374,"_27449":118645,"_2949":118671},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3465":70902,"_30211":70892,"_20923":118673,"_5":14374,"_27449":118649,"_2949":118674},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3465":70903,"_30211":70892,"_20923":118676,"_5":14374,"_27449":118653,"_2949":118677},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3465":70904,"_30211":70892,"_20923":118679,"_5":14374,"_27449":118657,"_2949":118680},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3465":70905,"_30211":70892,"_20923":118682,"_5":14374,"_27449":118661,"_2949":118683},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3465":70906,"_30211":70906,"_5":14726,"_2949":118685,"_30543":118686,"_20923":118687,"_27449":70906},"Cómo funciona Lamassu",[49241,117727],[],{"_3465":70907,"_30211":70906,"_20923":118689,"_5":14374,"_27449":70906,"_2949":118690},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3465":70908,"_30211":70906,"_5":30540,"_20923":118692,"_27449":118693,"_2949":118694},[],"/docs/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3465":70909,"_30211":70906,"_5":30540,"_20923":118696,"_27449":118697,"_2949":118698},[],"/docs/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3465":70910,"_30211":70906,"_20923":118700,"_5":14374,"_27449":70906,"_2949":118701},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3465":70911,"_30211":70906,"_20923":118703,"_5":14374,"_27449":118693,"_2949":118704},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3465":70912,"_30211":70906,"_20923":118706,"_5":14374,"_27449":118693,"_2949":118707},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3465":70913,"_30211":70906,"_20923":118709,"_5":14374,"_27449":118693,"_2949":118710},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3465":70914,"_30211":70906,"_20923":118712,"_5":14374,"_27449":118693,"_2949":118713},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3465":70915,"_30211":70906,"_20923":118715,"_5":14374,"_27449":118693,"_2949":118716},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3465":70916,"_30211":70906,"_20923":118718,"_5":14374,"_27449":118697,"_2949":118719},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3465":70917,"_30211":70906,"_20923":118721,"_5":14374,"_27449":118697,"_2949":118722},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3465":70918,"_30211":70906,"_20923":118724,"_5":14374,"_27449":118697,"_2949":118725},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3465":70919,"_30211":70906,"_20923":118727,"_5":14374,"_27449":118697,"_2949":118728},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3465":70920,"_30211":70906,"_20923":118730,"_5":14374,"_27449":118697,"_2949":118731},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3465":70921,"_30211":70906,"_20923":118733,"_5":14374,"_27449":118697,"_2949":118734},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3465":70922,"_30211":70906,"_20923":118736,"_5":14374,"_27449":118697,"_2949":118737},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3465":70923,"_30211":70923,"_5":14726,"_2949":118739,"_30543":118740,"_20923":118741,"_27449":70923},"Dispositivos e identidades",[49241,117727,51730,118739],[],{"_3465":70924,"_30211":70923,"_20923":118743,"_5":14374,"_27449":70923,"_2949":118744},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3465":70925,"_30211":70923,"_5":30540,"_20923":118746,"_27449":118747,"_2949":118748},[],"/docs/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3465":70926,"_30211":70923,"_5":30540,"_20923":118750,"_27449":118751,"_2949":118752},[],"/docs/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3465":70927,"_30211":70923,"_5":30540,"_20923":118754,"_27449":118755,"_2949":118756},[],"/docs/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3465":70928,"_30211":70923,"_5":30540,"_20923":118758,"_27449":118759,"_2949":118760},[],"/docs/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3465":70929,"_30211":70923,"_5":30540,"_20923":118762,"_27449":118763,"_2949":118764},[],"/docs/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3465":70930,"_30211":70923,"_5":30540,"_20923":118766,"_27449":118767,"_2949":118768},[],"/docs/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3465":70931,"_30211":70923,"_5":30540,"_20923":118770,"_27449":118771,"_2949":118772},[],"/docs/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3465":70932,"_30211":70923,"_5":30540,"_20923":118774,"_27449":118775,"_2949":118776},[],"/docs/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3465":70933,"_30211":70923,"_5":30540,"_20923":118778,"_27449":118779,"_2949":118780},[],"/docs/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3465":70934,"_30211":70923,"_5":30540,"_20923":118782,"_27449":118783,"_2949":118784},[],"/docs/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3465":70935,"_30211":70923,"_5":30540,"_20923":118786,"_27449":118787,"_2949":118788},[],"/docs/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3465":70936,"_30211":70923,"_20923":118790,"_5":14374,"_27449":70923,"_2949":118791},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3465":70937,"_30211":70923,"_20923":118793,"_5":14374,"_27449":70923,"_2949":118794},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3465":70938,"_30211":70923,"_20923":118796,"_5":14374,"_27449":118747,"_2949":118797},[],"Vista operativa",{"_3465":70939,"_30211":70923,"_20923":118799,"_5":14374,"_27449":118747,"_2949":118800},[],"Interpretación",{"_3465":70940,"_30211":70923,"_20923":118802,"_5":14374,"_27449":118747,"_2949":51793},[],{"_3465":70941,"_30211":70923,"_20923":118804,"_5":14374,"_27449":118747,"_2949":118805},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3465":70942,"_30211":70923,"_20923":118807,"_5":14374,"_27449":118747,"_2949":51799},[],{"_3465":70943,"_30211":70923,"_20923":118809,"_5":14374,"_27449":118747,"_2949":118810},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3465":70944,"_30211":70923,"_20923":118812,"_5":14374,"_27449":118747,"_2949":51805},[],{"_3465":70945,"_30211":70923,"_20923":118814,"_5":14374,"_27449":118747,"_2949":118815},[],"La identidad está en la ventana operativa de renovación.",{"_3465":70946,"_30211":70923,"_20923":118817,"_5":14374,"_27449":118747,"_2949":51811},[],{"_3465":70947,"_30211":70923,"_20923":118819,"_5":14374,"_27449":118747,"_2949":118820},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3465":70948,"_30211":70923,"_20923":118822,"_5":14374,"_27449":118747,"_2949":51817},[],{"_3465":70949,"_30211":70923,"_20923":118824,"_5":14374,"_27449":118747,"_2949":118825},[],"La identidad ha vencido.",{"_3465":70950,"_30211":70923,"_20923":118827,"_5":14374,"_27449":118747,"_2949":51823},[],{"_3465":70951,"_30211":70923,"_20923":118829,"_5":14374,"_27449":118747,"_2949":118830},[],"La identidad está marcada como revocada.",{"_3465":70952,"_30211":70923,"_20923":118832,"_5":14374,"_27449":118747,"_2949":51829},[],{"_3465":70953,"_30211":70923,"_20923":118834,"_5":14374,"_27449":118747,"_2949":118835},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3465":70954,"_30211":70923,"_20923":118837,"_5":14374,"_27449":118747,"_2949":118838},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3465":70955,"_30211":70923,"_20923":118840,"_5":14374,"_27449":118751,"_2949":118841},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3465":70956,"_30211":70923,"_20923":118843,"_5":14374,"_27449":118751,"_2949":118844},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3465":70957,"_30211":70923,"_20923":118846,"_5":14374,"_27449":118751,"_2949":118847},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3465":70958,"_30211":70923,"_20923":118849,"_5":14374,"_27449":118751,"_2949":118850},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3465":70959,"_30211":70923,"_20923":118852,"_5":14374,"_27449":118755,"_2949":118853},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3465":70960,"_30211":70923,"_20923":118855,"_5":14374,"_27449":118759,"_2949":118856},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3465":70961,"_30211":70923,"_20923":118858,"_5":14374,"_27449":118763,"_2949":118859},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3465":70962,"_30211":70923,"_20923":118861,"_5":14374,"_27449":118767,"_2949":118862},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3465":70963,"_30211":70923,"_20923":118864,"_5":14374,"_27449":118771,"_2949":118865},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3465":70964,"_30211":70923,"_20923":118867,"_5":14374,"_27449":118771,"_2949":118868},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3465":70965,"_30211":70923,"_20923":118870,"_5":14374,"_27449":118775,"_2949":118871},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3465":70966,"_30211":70923,"_20923":118873,"_5":14374,"_27449":118775,"_2949":118874},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3465":70967,"_30211":70923,"_20923":118876,"_5":14374,"_27449":118775,"_2949":118877},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3465":70968,"_30211":70923,"_20923":118879,"_5":14374,"_27449":118775,"_2949":118880},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3465":70969,"_30211":70923,"_20923":118882,"_5":14374,"_27449":118775,"_2949":118883},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3465":70970,"_30211":70923,"_20923":118885,"_5":14374,"_27449":118775,"_2949":118886},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3465":70971,"_30211":70923,"_20923":118888,"_5":14374,"_27449":118779,"_2949":118889},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3465":70972,"_30211":70923,"_20923":118891,"_5":14374,"_27449":118779,"_2949":118892},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3465":70973,"_30211":70923,"_20923":118894,"_5":14374,"_27449":118783,"_2949":118895},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3465":70974,"_30211":70923,"_20923":118897,"_5":14374,"_27449":118783,"_2949":118898},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3465":70975,"_30211":70923,"_20923":118900,"_5":14374,"_27449":118783,"_2949":118901},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3465":70976,"_30211":70923,"_20923":118903,"_5":14374,"_27449":118783,"_2949":118904},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3465":70977,"_30211":70923,"_20923":118906,"_5":14374,"_27449":118787,"_2949":118907},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3465":70978,"_30211":70923,"_20923":118909,"_5":14374,"_27449":118787,"_2949":118910},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3465":70979,"_30211":70979,"_5":14726,"_2949":118912,"_30543":118913,"_20923":118915,"_27449":70979},"Identidad inicial y autenticación",[49241,117727,51730,118739,118914],"Enrolamiento con PKI",[],{"_3465":70980,"_30211":70979,"_20923":118917,"_5":14374,"_27449":70979,"_2949":118918},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3465":70981,"_30211":70979,"_5":30540,"_20923":118920,"_27449":118921,"_2949":118922},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3465":70982,"_30211":70979,"_5":30540,"_20923":118924,"_27449":118925,"_2949":118926},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3465":70983,"_30211":70979,"_5":30540,"_20923":118928,"_27449":118929,"_2949":118930},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3465":70984,"_30211":70979,"_5":30540,"_20923":118932,"_27449":118933,"_2949":118934},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3465":70985,"_30211":70979,"_5":30540,"_20923":118936,"_27449":118937,"_2949":118938},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3465":70986,"_30211":70979,"_20923":118940,"_5":14374,"_27449":70979,"_2949":118941},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3465":70987,"_30211":70979,"_20923":118943,"_5":14374,"_27449":118921,"_2949":118944},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3465":70988,"_30211":70979,"_20923":118946,"_5":14374,"_27449":118921,"_2949":118947},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3465":70989,"_30211":70979,"_20923":118949,"_5":14374,"_27449":118925,"_2949":118950},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3465":70990,"_30211":70979,"_20923":118952,"_5":14374,"_27449":118925,"_2949":118953},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3465":70991,"_30211":70979,"_20923":118955,"_5":14374,"_27449":118925,"_2949":118956},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3465":70992,"_30211":70979,"_20923":118958,"_5":14374,"_27449":118929,"_2949":118959},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3465":70993,"_30211":70979,"_20923":118961,"_5":14374,"_27449":118929,"_2949":118962},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3465":70994,"_30211":70979,"_20923":118964,"_5":14374,"_27449":118933,"_2949":118965},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3465":70995,"_30211":70979,"_20923":118967,"_5":14374,"_27449":118933,"_2949":118968},[],"Ejemplo de cuerpo:",{"_3465":70996,"_30211":70979,"_20923":118970,"_5":14374,"_27449":118933,"_2949":118971},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3465":70997,"_30211":70979,"_20923":118973,"_5":14374,"_27449":118933,"_2949":118974},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3465":70998,"_30211":70979,"_20923":118976,"_5":14374,"_27449":118933,"_2949":118977},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3465":70999,"_30211":70979,"_20923":118979,"_5":14374,"_27449":118933,"_2949":118980},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3465":71000,"_30211":70979,"_20923":118982,"_5":14374,"_27449":118937,"_2949":118983},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3465":71001,"_30211":70979,"_20923":118985,"_5":14374,"_27449":118937,"_2949":118986},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3465":71002,"_30211":71002,"_5":14726,"_2949":118988,"_30543":118989,"_20923":118990,"_27449":71002},"Configura y opera el DMS",[49241,117727,51730,118739,118914],[],{"_3465":71003,"_30211":71002,"_20923":118992,"_5":14374,"_27449":71002,"_2949":118993},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3465":71004,"_30211":71002,"_5":30540,"_20923":118995,"_27449":118996,"_2949":116298},[],"/docs/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3465":71005,"_30211":71002,"_5":30540,"_20923":118998,"_27449":118999,"_2949":119000},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3465":71006,"_30211":71002,"_5":30540,"_20923":119002,"_27449":119003,"_2949":119004},[],"/docs/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3465":71007,"_30211":71002,"_5":30540,"_20923":119006,"_27449":119007,"_2949":119008},[],"/docs/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3465":71008,"_30211":71002,"_5":30540,"_20923":119010,"_27449":119011,"_2949":119012},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3465":71009,"_30211":71002,"_5":30540,"_20923":119014,"_27449":119015,"_2949":119016},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3465":71010,"_30211":71002,"_5":30540,"_20923":119018,"_27449":119019,"_2949":119020},[],"/docs/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3465":71011,"_30211":71002,"_5":30540,"_20923":119022,"_27449":119023,"_2949":119024},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3465":71012,"_30211":71002,"_5":30540,"_20923":119026,"_27449":119027,"_2949":52025},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3465":71013,"_30211":71002,"_5":30540,"_20923":119029,"_27449":119030,"_2949":52029},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3465":71014,"_30211":71002,"_5":30540,"_20923":119032,"_27449":119033,"_2949":119034},[],"/docs/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3465":71015,"_30211":71002,"_5":30540,"_20923":119036,"_27449":119037,"_2949":119038},[],"/docs/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3465":71016,"_30211":71002,"_5":30540,"_20923":119040,"_27449":119041,"_2949":119042},[],"/docs/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3465":71017,"_30211":71002,"_5":30540,"_20923":119044,"_27449":119045,"_2949":119046},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3465":71018,"_30211":71002,"_5":30540,"_20923":119048,"_27449":119049,"_2949":52049},[],"/docs/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3465":71019,"_30211":71002,"_5":30540,"_20923":119051,"_27449":119052,"_2949":119053},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3465":71020,"_30211":71002,"_5":30540,"_20923":119055,"_27449":119056,"_2949":119057},[],"/docs/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3465":71021,"_30211":71002,"_5":30540,"_20923":119059,"_27449":119060,"_2949":119061},[],"/docs/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3465":71022,"_30211":71002,"_20923":119063,"_5":14374,"_27449":71002,"_2949":119064},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3465":71023,"_30211":71002,"_20923":119066,"_5":14374,"_27449":118996,"_2949":119067},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3465":71024,"_30211":71002,"_20923":119069,"_5":14374,"_27449":118996,"_2949":119070},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3465":71025,"_30211":71002,"_20923":119072,"_5":14374,"_27449":119003,"_2949":119073},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3465":71026,"_30211":71002,"_20923":119075,"_5":14374,"_27449":119007,"_2949":119076},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3465":71027,"_30211":71002,"_20923":119078,"_5":14374,"_27449":119011,"_2949":119079},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3465":71028,"_30211":71002,"_20923":119081,"_5":14374,"_27449":119015,"_2949":119082},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3465":71029,"_30211":71002,"_20923":119084,"_5":14374,"_27449":119019,"_2949":119085},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3465":71030,"_30211":71002,"_20923":119087,"_5":14374,"_27449":119027,"_2949":119088},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3465":71031,"_30211":71002,"_20923":119090,"_5":14374,"_27449":119027,"_2949":119091},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3465":71032,"_30211":71002,"_20923":119093,"_5":14374,"_27449":119030,"_2949":119094},[],"Campo de `settings.enrollment_settings`",{"_3465":71033,"_30211":71002,"_20923":119096,"_5":14374,"_27449":119030,"_2949":119097},[],"Decisión",{"_3465":71034,"_30211":71002,"_20923":119099,"_5":14374,"_27449":119030,"_2949":52100},[],{"_3465":71035,"_30211":71002,"_20923":119101,"_5":14374,"_27449":119030,"_2949":119102},[],"`EST_RFC7030` para estas operaciones.",{"_3465":71036,"_30211":71002,"_20923":119104,"_5":14374,"_27449":119030,"_2949":52106},[],{"_3465":71037,"_30211":71002,"_20923":119106,"_5":14374,"_27449":119030,"_2949":119107},[],"ID de la CA que firmará.",{"_3465":71038,"_30211":71002,"_20923":119109,"_5":14374,"_27449":119030,"_2949":52112},[],{"_3465":71039,"_30211":71002,"_20923":119111,"_5":14374,"_27449":119030,"_2949":119112},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3465":71040,"_30211":71002,"_20923":119114,"_5":14374,"_27449":119030,"_2949":52118},[],{"_3465":71041,"_30211":71002,"_20923":119116,"_5":14374,"_27449":119030,"_2949":119117},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3465":71042,"_30211":71002,"_20923":119119,"_5":14374,"_27449":119030,"_2949":52124},[],{"_3465":71043,"_30211":71002,"_20923":119121,"_5":14374,"_27449":119030,"_2949":119122},[],"Uno de los cuatro modos de autenticación.",{"_3465":71044,"_30211":71002,"_20923":119124,"_5":14374,"_27449":119030,"_2949":119125},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3465":71045,"_30211":71002,"_20923":119127,"_5":14374,"_27449":119033,"_2949":119128},[],"Los bloques son independientes:",{"_3465":71046,"_30211":71002,"_20923":119130,"_5":14374,"_27449":119033,"_2949":119131},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3465":71047,"_30211":71002,"_20923":119133,"_5":14374,"_27449":119033,"_2949":119134},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3465":71048,"_30211":71002,"_20923":119136,"_5":14374,"_27449":119033,"_2949":52142},[],{"_3465":71049,"_30211":71002,"_20923":119138,"_5":14374,"_27449":119033,"_2949":119139},[],"Control aplicado en la operación configurada",{"_3465":71050,"_30211":71002,"_20923":119141,"_5":14374,"_27449":119033,"_2949":52148},[],{"_3465":71051,"_30211":71002,"_20923":119143,"_5":14374,"_27449":119033,"_2949":119144},[],"Validación del certificado presentado.",{"_3465":71052,"_30211":71002,"_20923":119146,"_5":14374,"_27449":119033,"_2949":52154},[],{"_3465":71053,"_30211":71002,"_20923":119148,"_5":14374,"_27449":119033,"_2949":119149},[],"Autorización del webhook configurado.",{"_3465":71054,"_30211":71002,"_20923":119151,"_5":14374,"_27449":119033,"_2949":52160},[],{"_3465":71055,"_30211":71002,"_20923":119153,"_5":14374,"_27449":119033,"_2949":119154},[],"Validación del certificado y, después, aprobación del webhook.",{"_3465":71056,"_30211":71002,"_20923":119156,"_5":14374,"_27449":119033,"_2949":52166},[],{"_3465":71057,"_30211":71002,"_20923":119158,"_5":14374,"_27449":119033,"_2949":119159},[],"Sin autenticación del solicitante por el DMS.",{"_3465":71058,"_30211":71002,"_20923":119161,"_5":14374,"_27449":119033,"_2949":119162},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3465":71059,"_30211":71002,"_20923":119164,"_5":14374,"_27449":119033,"_2949":119165},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3465":71060,"_30211":71002,"_20923":119167,"_5":14374,"_27449":119033,"_2949":119168},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3465":71061,"_30211":71002,"_20923":119170,"_5":14374,"_27449":119033,"_2949":119171},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3465":71062,"_30211":71002,"_20923":119173,"_5":14374,"_27449":119037,"_2949":119174},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3465":71063,"_30211":71002,"_20923":119176,"_5":14374,"_27449":119037,"_2949":119177},[],"Campo de `external_webhook_settings`",{"_3465":71064,"_30211":71002,"_20923":119179,"_5":14374,"_27449":119037,"_2949":119097},[],{"_3465":71065,"_30211":71002,"_20923":119181,"_5":14374,"_27449":119037,"_2949":52192},[],{"_3465":71066,"_30211":71002,"_20923":119183,"_5":14374,"_27449":119037,"_2949":119184},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3465":71067,"_30211":71002,"_20923":119186,"_5":14374,"_27449":119037,"_2949":52198},[],{"_3465":71068,"_30211":71002,"_20923":119188,"_5":14374,"_27449":119037,"_2949":119189},[],"`POST` o `PUT`; `POST` por defecto.",{"_3465":71069,"_30211":71002,"_20923":119191,"_5":14374,"_27449":119037,"_2949":52204},[],{"_3465":71070,"_30211":71002,"_20923":119193,"_5":14374,"_27449":119037,"_2949":119194},[],"Etiqueta usada en los logs del servicio.",{"_3465":71071,"_30211":71002,"_20923":119196,"_5":14374,"_27449":119037,"_2949":52210},[],{"_3465":71072,"_30211":71002,"_20923":119198,"_5":14374,"_27449":119037,"_2949":119199},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3465":71073,"_30211":71002,"_20923":119201,"_5":14374,"_27449":119037,"_2949":52216},[],{"_3465":71074,"_30211":71002,"_20923":119203,"_5":14374,"_27449":119037,"_2949":119204},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3465":71075,"_30211":71002,"_20923":119206,"_5":14374,"_27449":119037,"_2949":52222},[],{"_3465":71076,"_30211":71002,"_20923":119208,"_5":14374,"_27449":119037,"_2949":119209},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3465":71077,"_30211":71002,"_20923":119211,"_5":14374,"_27449":119037,"_2949":52228},[],{"_3465":71078,"_30211":71002,"_20923":119213,"_5":14374,"_27449":119037,"_2949":119214},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3465":71079,"_30211":71002,"_20923":119216,"_5":14374,"_27449":119037,"_2949":52234},[],{"_3465":71080,"_30211":71002,"_20923":119218,"_5":14374,"_27449":119037,"_2949":119219},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3465":71081,"_30211":71002,"_20923":119221,"_5":14374,"_27449":119037,"_2949":52240},[],{"_3465":71082,"_30211":71002,"_20923":119223,"_5":14374,"_27449":119037,"_2949":119224},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3465":71083,"_30211":71002,"_20923":119226,"_5":14374,"_27449":119037,"_2949":52246},[],{"_3465":71084,"_30211":71002,"_20923":119228,"_5":14374,"_27449":119037,"_2949":119229},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3465":71085,"_30211":71002,"_20923":119231,"_5":14374,"_27449":119037,"_2949":119232},[],"Reglas de esa configuración:",{"_3465":71086,"_30211":71002,"_20923":119234,"_5":14374,"_27449":119037,"_2949":119235},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3465":71087,"_30211":71002,"_20923":119237,"_5":14374,"_27449":119037,"_2949":119238},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3465":71088,"_30211":71002,"_20923":119240,"_5":14374,"_27449":119037,"_2949":119241},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3465":71089,"_30211":71002,"_20923":119243,"_5":14374,"_27449":119037,"_2949":119244},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3465":71090,"_30211":71002,"_20923":119246,"_5":14374,"_27449":119037,"_2949":119247},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3465":71091,"_30211":71002,"_20923":119249,"_5":14374,"_27449":119037,"_2949":119250},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3465":71092,"_30211":71002,"_20923":119252,"_5":14374,"_27449":119037,"_2949":119253},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3465":71093,"_30211":71002,"_20923":119255,"_5":14374,"_27449":119037,"_2949":119256},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3465":71094,"_30211":71002,"_20923":119258,"_5":14374,"_27449":119037,"_2949":119259},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3465":71095,"_30211":71002,"_20923":119261,"_5":14374,"_27449":119041,"_2949":119262},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3465":71096,"_30211":71002,"_20923":119264,"_5":14374,"_27449":119045,"_2949":119265},[],"Campo de `settings.reenrollment_settings`",{"_3465":71097,"_30211":71002,"_20923":119267,"_5":14374,"_27449":119045,"_2949":119268},[],"Función",{"_3465":71098,"_30211":71002,"_20923":119270,"_5":14374,"_27449":119045,"_2949":52290},[],{"_3465":71099,"_30211":71002,"_20923":119272,"_5":14374,"_27449":119045,"_2949":119273},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3465":71100,"_30211":71002,"_20923":119275,"_5":14374,"_27449":119045,"_2949":52296},[],{"_3465":71101,"_30211":71002,"_20923":119277,"_5":14374,"_27449":119045,"_2949":119278},[],"Umbral operativo preventivo de monitorización.",{"_3465":71102,"_30211":71002,"_20923":119280,"_5":14374,"_27449":119045,"_2949":52302},[],{"_3465":71103,"_30211":71002,"_20923":119282,"_5":14374,"_27449":119045,"_2949":119283},[],"Umbral operativo crítico de monitorización.",{"_3465":71104,"_30211":71002,"_20923":119285,"_5":14374,"_27449":119045,"_2949":52308},[],{"_3465":71105,"_30211":71002,"_20923":119287,"_5":14374,"_27449":119045,"_2949":119288},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3465":71106,"_30211":71002,"_20923":119290,"_5":14374,"_27449":119045,"_2949":52314},[],{"_3465":71107,"_30211":71002,"_20923":119292,"_5":14374,"_27449":119045,"_2949":119293},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3465":71108,"_30211":71002,"_20923":119295,"_5":14374,"_27449":119045,"_2949":52320},[],{"_3465":71109,"_30211":71002,"_20923":119297,"_5":14374,"_27449":119045,"_2949":119298},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3465":71110,"_30211":71002,"_20923":119300,"_5":14374,"_27449":119045,"_2949":119301},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3465":71111,"_30211":71002,"_20923":119303,"_5":14374,"_27449":119049,"_2949":119304},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3465":71112,"_30211":71002,"_20923":119306,"_5":14374,"_27449":119052,"_2949":116662},[],{"_3465":71113,"_30211":71002,"_20923":119308,"_5":14374,"_27449":119052,"_2949":119309},[],"Qué publica",{"_3465":71114,"_30211":71002,"_20923":119311,"_5":14374,"_27449":119052,"_2949":52337},[],{"_3465":71115,"_30211":71002,"_20923":119313,"_5":14374,"_27449":119052,"_2949":119314},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3465":71116,"_30211":71002,"_20923":119316,"_5":14374,"_27449":119052,"_2949":52343},[],{"_3465":71117,"_30211":71002,"_20923":119318,"_5":14374,"_27449":119052,"_2949":119319},[],"Certificado de la CA emisora seleccionada.",{"_3465":71118,"_30211":71002,"_20923":119321,"_5":14374,"_27449":119052,"_2949":52349},[],{"_3465":71119,"_30211":71002,"_20923":119323,"_5":14374,"_27449":119052,"_2949":119324},[],"Certificados de las CAs elegidas explícitamente.",{"_3465":71120,"_30211":71002,"_20923":119326,"_5":14374,"_27449":119052,"_2949":119327},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3465":71121,"_30211":71002,"_20923":119329,"_5":14374,"_27449":119056,"_2949":119330},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3465":71122,"_30211":71002,"_20923":119332,"_5":14374,"_27449":119056,"_2949":119333},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3465":71123,"_30211":71002,"_20923":119335,"_5":14374,"_27449":119056,"_2949":119336},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3465":71124,"_30211":71002,"_20923":119338,"_5":14374,"_27449":119060,"_2949":119339},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3465":71125,"_30211":71125,"_5":14726,"_2949":119341,"_30543":119342,"_20923":119343,"_27449":71125},"Integra el cliente EST",[49241,117727,51730,118739,118914],[],{"_3465":71126,"_30211":71125,"_20923":119345,"_5":14374,"_27449":71125,"_2949":119346},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3465":71127,"_30211":71125,"_5":30540,"_20923":119348,"_27449":119349,"_2949":116298},[],"/docs/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3465":71128,"_30211":71125,"_5":30540,"_20923":119351,"_27449":119352,"_2949":119353},[],"/docs/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3465":71129,"_30211":71125,"_5":30540,"_20923":119355,"_27449":119356,"_2949":119357},[],"/docs/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3465":71130,"_30211":71125,"_5":30540,"_20923":119359,"_27449":119360,"_2949":119361},[],"/docs/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3465":71131,"_30211":71125,"_5":30540,"_20923":119363,"_27449":119364,"_2949":119365},[],"/docs/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3465":71132,"_30211":71125,"_5":30540,"_20923":119367,"_27449":119368,"_2949":119369},[],"/docs/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3465":71133,"_30211":71125,"_20923":119371,"_5":14374,"_27449":71125,"_2949":119372},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3465":71134,"_30211":71125,"_20923":119374,"_5":14374,"_27449":119349,"_2949":119375},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3465":71135,"_30211":71125,"_20923":119377,"_5":14374,"_27449":119349,"_2949":119378},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3465":71136,"_30211":71125,"_20923":119380,"_5":14374,"_27449":119349,"_2949":119381},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3465":71137,"_30211":71125,"_20923":119383,"_5":14374,"_27449":119352,"_2949":119384},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3465":71138,"_30211":71125,"_20923":119386,"_5":14374,"_27449":119352,"_2949":119387},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3465":71139,"_30211":71125,"_20923":119389,"_5":14374,"_27449":119356,"_2949":119390},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3465":71140,"_30211":71125,"_20923":119392,"_5":14374,"_27449":119356,"_2949":119393},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3465":71141,"_30211":71125,"_20923":119395,"_5":14374,"_27449":119360,"_2949":119396},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3465":71142,"_30211":71125,"_20923":119398,"_5":14374,"_27449":119360,"_2949":119399},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3465":71143,"_30211":71125,"_20923":119401,"_5":14374,"_27449":119364,"_2949":119402},[],"Para el caso de una raíz que emite directamente:",{"_3465":71144,"_30211":71125,"_20923":119404,"_5":14374,"_27449":119364,"_2949":119405},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3465":71145,"_30211":71125,"_20923":119407,"_5":14374,"_27449":119364,"_2949":119408},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3465":71146,"_30211":71125,"_20923":119410,"_5":14374,"_27449":119368,"_2949":119411},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3465":71147,"_30211":71147,"_5":14726,"_2949":119413,"_30543":119414,"_20923":119415,"_27449":71147},"Referencia EST",[49241,117727,51730,118739,118914],[],{"_3465":71148,"_30211":71147,"_20923":119417,"_5":14374,"_27449":71147,"_2949":119418},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3465":71149,"_30211":71147,"_5":30540,"_20923":119420,"_27449":119421,"_2949":119422},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3465":71150,"_30211":71147,"_5":30540,"_20923":119424,"_27449":119425,"_2949":22685},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3465":71151,"_30211":71147,"_5":30540,"_20923":119427,"_27449":119428,"_2949":26052},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3465":71152,"_30211":71147,"_5":30540,"_20923":119430,"_27449":119431,"_2949":26059},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3465":71153,"_30211":71147,"_5":30540,"_20923":119433,"_27449":119434,"_2949":25378},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3465":71154,"_30211":71147,"_5":30540,"_20923":119436,"_27449":119437,"_2949":119438},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3465":71155,"_30211":71147,"_5":30540,"_20923":119440,"_27449":119441,"_2949":119442},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3465":71156,"_30211":71147,"_5":30540,"_20923":119444,"_27449":119445,"_2949":119446},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3465":71157,"_30211":71147,"_20923":119448,"_5":14374,"_27449":71147,"_2949":119449},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3465":71158,"_30211":71147,"_20923":119451,"_5":14374,"_27449":119421,"_2949":119452},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3465":71159,"_30211":71147,"_20923":119454,"_5":14374,"_27449":119421,"_2949":117487},[],{"_3465":71160,"_30211":71147,"_20923":119456,"_5":14374,"_27449":119421,"_2949":119457},[],"Método",{"_3465":71161,"_30211":71147,"_20923":119459,"_5":14374,"_27449":119421,"_2949":119460},[],"Autenticación y condición",{"_3465":71162,"_30211":71147,"_20923":119462,"_5":14374,"_27449":119421,"_2949":52492},[],{"_3465":71163,"_30211":71147,"_20923":119464,"_5":14374,"_27449":119421,"_2949":52495},[],{"_3465":71164,"_30211":71147,"_20923":119466,"_5":14374,"_27449":119421,"_2949":119467},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3465":71165,"_30211":71147,"_20923":119469,"_5":14374,"_27449":119421,"_2949":52501},[],{"_3465":71166,"_30211":71147,"_20923":119471,"_5":14374,"_27449":119421,"_2949":52504},[],{"_3465":71167,"_30211":71147,"_20923":119473,"_5":14374,"_27449":119421,"_2949":119474},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3465":71168,"_30211":71147,"_20923":119476,"_5":14374,"_27449":119421,"_2949":52510},[],{"_3465":71169,"_30211":71147,"_20923":119478,"_5":14374,"_27449":119421,"_2949":52504},[],{"_3465":71170,"_30211":71147,"_20923":119480,"_5":14374,"_27449":119421,"_2949":119481},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3465":71171,"_30211":71147,"_20923":119483,"_5":14374,"_27449":119421,"_2949":52518},[],{"_3465":71172,"_30211":71147,"_20923":119485,"_5":14374,"_27449":119421,"_2949":52504},[],{"_3465":71173,"_30211":71147,"_20923":119487,"_5":14374,"_27449":119421,"_2949":119488},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3465":71174,"_30211":71147,"_20923":119490,"_5":14374,"_27449":119421,"_2949":119491},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3465":71175,"_30211":71147,"_20923":119493,"_5":14374,"_27449":119425,"_2949":119494},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3465":71176,"_30211":71147,"_20923":119496,"_5":14374,"_27449":119425,"_2949":119497},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3465":71177,"_30211":71147,"_20923":119499,"_5":14374,"_27449":119428,"_2949":119500},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3465":71178,"_30211":71147,"_20923":119502,"_5":14374,"_27449":119428,"_2949":119503},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3465":71179,"_30211":71147,"_20923":119505,"_5":14374,"_27449":119431,"_2949":119506},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3465":71180,"_30211":71147,"_20923":119508,"_5":14374,"_27449":119431,"_2949":119509},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3465":71181,"_30211":71147,"_20923":119511,"_5":14374,"_27449":119434,"_2949":119512},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3465":71182,"_30211":71147,"_20923":119514,"_5":14374,"_27449":119434,"_2949":119515},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3465":71183,"_30211":71147,"_20923":119517,"_5":14374,"_27449":119437,"_2949":119518},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3465":71184,"_30211":71147,"_20923":119520,"_5":14374,"_27449":119437,"_2949":119521},[],"Parte",{"_3465":71185,"_30211":71147,"_20923":119523,"_5":14374,"_27449":119437,"_2949":119524},[],"Contenido tras decodificar su Base64",{"_3465":71186,"_30211":71147,"_20923":119526,"_5":14374,"_27449":119437,"_2949":52562},[],{"_3465":71187,"_30211":71147,"_20923":119528,"_5":14374,"_27449":119437,"_2949":119529},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3465":71188,"_30211":71147,"_20923":119531,"_5":14374,"_27449":119437,"_2949":52568},[],{"_3465":71189,"_30211":71147,"_20923":119533,"_5":14374,"_27449":119437,"_2949":119534},[],"PKCS#7 DER con el certificado emitido.",{"_3465":71190,"_30211":71147,"_20923":119536,"_5":14374,"_27449":119437,"_2949":119537},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3465":71191,"_30211":71147,"_20923":119539,"_5":14374,"_27449":119441,"_2949":119540},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3465":71192,"_30211":71147,"_20923":119542,"_5":14374,"_27449":119441,"_2949":119543},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3465":71193,"_30211":71147,"_20923":119545,"_5":14374,"_27449":119441,"_2949":119546},[],"Convierte y comprueba el resultado:",{"_3465":71194,"_30211":71147,"_20923":119548,"_5":14374,"_27449":119441,"_2949":119549},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3465":71195,"_30211":71147,"_20923":119551,"_5":14374,"_27449":119445,"_2949":119552},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3465":71196,"_30211":71147,"_20923":119554,"_5":14374,"_27449":119445,"_2949":119555},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3465":71197,"_30211":71197,"_5":14726,"_2949":118914,"_30543":119557,"_20923":119558,"_27449":71197},[49241,117727,51730,118739,118914],[],{"_3465":71198,"_30211":71197,"_20923":119560,"_5":14374,"_27449":71197,"_2949":119561},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3465":71199,"_30211":71197,"_5":30540,"_20923":119563,"_27449":119564,"_2949":119565},[],"/docs/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3465":71200,"_30211":71197,"_5":30540,"_20923":119567,"_27449":119568,"_2949":119569},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3465":71201,"_30211":71197,"_5":30540,"_20923":119571,"_27449":119572,"_2949":119573},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3465":71202,"_30211":71197,"_5":30540,"_20923":119575,"_27449":119576,"_2949":119577},[],"/docs/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3465":71203,"_30211":71197,"_20923":119579,"_5":14374,"_27449":71197,"_2949":119580},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3465":71204,"_30211":71197,"_20923":119582,"_5":14374,"_27449":119564,"_2949":119583},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3465":71205,"_30211":71197,"_20923":119585,"_5":14374,"_27449":119564,"_2949":119586},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3465":71206,"_30211":71197,"_20923":119588,"_5":14374,"_27449":119564,"_2949":119589},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3465":71207,"_30211":71197,"_20923":119591,"_5":14374,"_27449":119564,"_2949":119592},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3465":71208,"_30211":71197,"_20923":119594,"_5":14374,"_27449":119564,"_2949":119595},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3465":71209,"_30211":71197,"_20923":119597,"_5":14374,"_27449":119564,"_2949":119598},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3465":71210,"_30211":71197,"_20923":119600,"_5":14374,"_27449":119568,"_2949":119601},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3465":71211,"_30211":71197,"_20923":119603,"_5":14374,"_27449":119568,"_2949":119604},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3465":71212,"_30211":71197,"_20923":119606,"_5":14374,"_27449":119568,"_2949":119607},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3465":71213,"_30211":71197,"_20923":119609,"_5":14374,"_27449":119568,"_2949":119610},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3465":71214,"_30211":71197,"_20923":119612,"_5":14374,"_27449":119572,"_2949":119613},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3465":71215,"_30211":71197,"_20923":119615,"_5":14374,"_27449":119572,"_2949":119616},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3465":71216,"_30211":71197,"_20923":119618,"_5":14374,"_27449":119572,"_2949":119619},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3465":71217,"_30211":71197,"_20923":119621,"_5":14374,"_27449":119572,"_2949":119622},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3465":71218,"_30211":71197,"_20923":119624,"_5":14374,"_27449":119576,"_2949":119625},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3465":71219,"_30211":71197,"_20923":119627,"_5":14374,"_27449":119576,"_2949":119628},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3465":71220,"_30211":71220,"_5":14726,"_2949":119630,"_30543":119631,"_20923":119632,"_27449":71220},"Estrategias de aprovisionamiento",[49241,117727,51730,118739,118914],[],{"_3465":71221,"_30211":71220,"_20923":119634,"_5":14374,"_27449":71220,"_2949":119635},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3465":71222,"_30211":71220,"_5":30540,"_20923":119637,"_27449":119638,"_2949":119639},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3465":71223,"_30211":71220,"_5":30540,"_20923":119641,"_27449":119642,"_2949":119643},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3465":71224,"_30211":71220,"_5":30540,"_20923":119645,"_27449":119646,"_2949":119647},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3465":71225,"_30211":71220,"_5":30540,"_20923":119649,"_27449":119650,"_2949":119651},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3465":71226,"_30211":71220,"_5":30540,"_20923":119653,"_27449":119654,"_2949":119655},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3465":71227,"_30211":71220,"_20923":119657,"_5":14374,"_27449":71220,"_2949":119658},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3465":71228,"_30211":71220,"_20923":119660,"_5":14374,"_27449":119638,"_2949":119661},[],"Recorrido",{"_3465":71229,"_30211":71220,"_20923":119663,"_5":14374,"_27449":119638,"_2949":119664},[],"Cuándo existe el dispositivo",{"_3465":71230,"_30211":71220,"_20923":119666,"_5":14374,"_27449":119638,"_2949":119667},[],"Qué compruebas",{"_3465":71231,"_30211":71220,"_20923":119669,"_5":14374,"_27449":119638,"_2949":119670},[],"Asignación manual",{"_3465":71232,"_30211":71220,"_20923":119672,"_5":14374,"_27449":119638,"_2949":119673},[],"El operador lo crea antes de asociar un certificado.",{"_3465":71233,"_30211":71220,"_20923":119675,"_5":14374,"_27449":119638,"_2949":119676},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3465":71234,"_30211":71220,"_20923":119678,"_5":14374,"_27449":119638,"_2949":119679},[],"EST con `JITP`",{"_3465":71235,"_30211":71220,"_20923":119681,"_5":14374,"_27449":119638,"_2949":119682},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3465":71236,"_30211":71220,"_20923":119684,"_5":14374,"_27449":119638,"_2949":119685},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3465":71237,"_30211":71220,"_20923":119687,"_5":14374,"_27449":119638,"_2949":119688},[],"EST con `PRE_REGISTRATION`",{"_3465":71238,"_30211":71220,"_20923":119690,"_5":14374,"_27449":119638,"_2949":119691},[],"Debe existir antes de `/simpleenroll`.",{"_3465":71239,"_30211":71220,"_20923":119693,"_5":14374,"_27449":119638,"_2949":119694},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3465":71240,"_30211":71220,"_20923":119696,"_5":14374,"_27449":119638,"_2949":119697},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3465":71241,"_30211":71220,"_20923":119699,"_5":14374,"_27449":119638,"_2949":119700},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3465":71242,"_30211":71220,"_20923":119702,"_5":14374,"_27449":119642,"_2949":119703},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3465":71243,"_30211":71220,"_20923":119705,"_5":14374,"_27449":119642,"_2949":119706},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3465":71244,"_30211":71220,"_20923":119708,"_5":14374,"_27449":119642,"_2949":119709},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3465":71245,"_30211":71220,"_20923":119711,"_5":14374,"_27449":119646,"_2949":119712},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3465":71246,"_30211":71220,"_20923":119714,"_5":14374,"_27449":119646,"_2949":119715},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3465":71247,"_30211":71220,"_20923":119717,"_5":14374,"_27449":119646,"_2949":119718},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3465":71248,"_30211":71220,"_20923":119720,"_5":14374,"_27449":119646,"_2949":119721},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3465":71249,"_30211":71220,"_20923":119723,"_5":14374,"_27449":119646,"_2949":119724},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3465":71250,"_30211":71220,"_20923":119726,"_5":14374,"_27449":119646,"_2949":119727},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3465":71251,"_30211":71220,"_20923":119729,"_5":14374,"_27449":119650,"_2949":116662},[],{"_3465":71252,"_30211":71220,"_20923":119731,"_5":14374,"_27449":119650,"_2949":119732},[],"Material que atraviesa EST",{"_3465":71253,"_30211":71220,"_20923":119734,"_5":14374,"_27449":119650,"_2949":119735},[],"Clave generada por el dispositivo",{"_3465":71254,"_30211":71220,"_20923":119737,"_5":14374,"_27449":119650,"_2949":119738},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3465":71255,"_30211":71220,"_20923":119740,"_5":14374,"_27449":119650,"_2949":119741},[],"Clave ya disponible en el dispositivo",{"_3465":71256,"_30211":71220,"_20923":119743,"_5":14374,"_27449":119650,"_2949":119744},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3465":71257,"_30211":71220,"_20923":119746,"_5":14374,"_27449":119650,"_2949":52049},[],{"_3465":71258,"_30211":71220,"_20923":119748,"_5":14374,"_27449":119650,"_2949":119749},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3465":71259,"_30211":71220,"_20923":119751,"_5":14374,"_27449":119650,"_2949":119752},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3465":71260,"_30211":71220,"_20923":119754,"_5":14374,"_27449":119654,"_2949":119755},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3465":71261,"_30211":71261,"_5":14726,"_2949":119757,"_30543":119758,"_20923":119759,"_27449":71261},"Renovación y recuperación",[49241,117727,51730,118739,118914],[],{"_3465":71262,"_30211":71261,"_20923":119761,"_5":14374,"_27449":71261,"_2949":119762},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3465":71263,"_30211":71261,"_5":30540,"_20923":119764,"_27449":119765,"_2949":119766},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3465":71264,"_30211":71261,"_5":30540,"_20923":119768,"_27449":119769,"_2949":119770},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3465":71265,"_30211":71261,"_5":30540,"_20923":119772,"_27449":119773,"_2949":119774},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3465":71266,"_30211":71261,"_5":30540,"_20923":119776,"_27449":119777,"_2949":119778},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3465":71267,"_30211":71261,"_5":30540,"_20923":119780,"_27449":119781,"_2949":119782},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3465":71268,"_30211":71261,"_20923":119784,"_5":14374,"_27449":71261,"_2949":119785},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3465":71269,"_30211":71261,"_20923":119787,"_5":14374,"_27449":119765,"_2949":119788},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3465":71270,"_30211":71261,"_20923":119790,"_5":14374,"_27449":119765,"_2949":119791},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3465":71271,"_30211":71261,"_20923":119793,"_5":14374,"_27449":119765,"_2949":119794},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3465":71272,"_30211":71261,"_20923":119796,"_5":14374,"_27449":119765,"_2949":119797},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3465":71273,"_30211":71261,"_20923":119799,"_5":14374,"_27449":119769,"_2949":119800},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3465":71274,"_30211":71261,"_20923":119802,"_5":14374,"_27449":119769,"_2949":119803},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3465":71275,"_30211":71261,"_20923":119805,"_5":14374,"_27449":119773,"_2949":119806},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3465":71276,"_30211":71261,"_20923":119808,"_5":14374,"_27449":119773,"_2949":119809},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3465":71277,"_30211":71261,"_20923":119811,"_5":14374,"_27449":119773,"_2949":119812},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3465":71278,"_30211":71261,"_20923":119814,"_5":14374,"_27449":119777,"_2949":119815},[],"Situación",{"_3465":71279,"_30211":71261,"_20923":119817,"_5":14374,"_27449":119777,"_2949":119818},[],"Procedimiento",{"_3465":71280,"_30211":71261,"_20923":119820,"_5":14374,"_27449":119777,"_2949":119821},[],"Certificado vigente, fuera de ventana",{"_3465":71281,"_30211":71261,"_20923":119823,"_5":14374,"_27449":119777,"_2949":119824},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3465":71282,"_30211":71261,"_20923":119826,"_5":14374,"_27449":119777,"_2949":119827},[],"Certificado vencido, clave disponible",{"_3465":71283,"_30211":71261,"_20923":119829,"_5":14374,"_27449":119777,"_2949":119830},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3465":71284,"_30211":71261,"_20923":119832,"_5":14374,"_27449":119777,"_2949":119833},[],"Renovación por webhook o `NO_AUTH`",{"_3465":71285,"_30211":71261,"_20923":119835,"_5":14374,"_27449":119777,"_2949":119836},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3465":71286,"_30211":71261,"_20923":119838,"_5":14374,"_27449":119777,"_2949":119839},[],"Clave perdida o inaccesible",{"_3465":71287,"_30211":71261,"_20923":119841,"_5":14374,"_27449":119777,"_2949":119842},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3465":71288,"_30211":71261,"_20923":119844,"_5":14374,"_27449":119777,"_2949":119845},[],"Identidad actual revocada",{"_3465":71289,"_30211":71261,"_20923":119847,"_5":14374,"_27449":119777,"_2949":119848},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3465":71290,"_30211":71261,"_20923":119850,"_5":14374,"_27449":119777,"_2949":119851},[],"Dispositivo sin identidad",{"_3465":71291,"_30211":71261,"_20923":119853,"_5":14374,"_27449":119777,"_2949":119854},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3465":71292,"_30211":71261,"_20923":119856,"_5":14374,"_27449":119777,"_2949":119857},[],"Dispositivo retirado",{"_3465":71293,"_30211":71261,"_20923":119859,"_5":14374,"_27449":119777,"_2949":119860},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3465":71294,"_30211":71261,"_20923":119862,"_5":14374,"_27449":119777,"_2949":119863},[],"Timeout, HTTP 500 o fallo de instalación",{"_3465":71295,"_30211":71261,"_20923":119865,"_5":14374,"_27449":119777,"_2949":119866},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3465":71296,"_30211":71261,"_20923":119868,"_5":14374,"_27449":119781,"_2949":119869},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3465":71297,"_30211":71261,"_20923":119871,"_5":14374,"_27449":119781,"_2949":119872},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3465":71298,"_30211":71298,"_5":14726,"_2949":119874,"_30543":119875,"_20923":119876,"_27449":71298},"Diagnóstico de enrolamiento",[49241,117727,51730,118739,118914],[],{"_3465":71299,"_30211":71298,"_20923":119878,"_5":14374,"_27449":71298,"_2949":119879},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3465":71300,"_30211":71298,"_5":30540,"_20923":119881,"_27449":119882,"_2949":119883},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3465":71301,"_30211":71298,"_5":30540,"_20923":119885,"_27449":119886,"_2949":119887},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3465":71302,"_30211":71298,"_5":30540,"_20923":119889,"_27449":119890,"_2949":119446},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3465":71303,"_30211":71298,"_5":30540,"_20923":119892,"_27449":119893,"_2949":119894},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3465":71304,"_30211":71298,"_20923":119896,"_5":14374,"_27449":71298,"_2949":119897},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3465":71305,"_30211":71298,"_20923":119899,"_5":14374,"_27449":119886,"_2949":119900},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3465":71306,"_30211":71298,"_20923":119902,"_5":14374,"_27449":119886,"_2949":119903},[],"Síntoma o mensaje",{"_3465":71307,"_30211":71298,"_20923":119905,"_5":14374,"_27449":119886,"_2949":119906},[],"Qué revisar",{"_3465":71308,"_30211":71298,"_20923":119908,"_5":14374,"_27449":119886,"_2949":119909},[],"curl rechaza TLS, nombre o emisor",{"_3465":71309,"_30211":71298,"_20923":119911,"_5":14374,"_27449":119886,"_2949":119912},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3465":71310,"_30211":71298,"_20923":119914,"_5":14374,"_27449":119886,"_2949":119915},[],"404 o APS ausente",{"_3465":71311,"_30211":71298,"_20923":119917,"_5":14374,"_27449":119886,"_2949":119918},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3465":71312,"_30211":71298,"_20923":119920,"_5":14374,"_27449":119886,"_2949":119921},[],"400, error de CSR o formato",{"_3465":71313,"_30211":71298,"_20923":119923,"_5":14374,"_27449":119886,"_2949":119924},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3465":71314,"_30211":71298,"_20923":119926,"_5":14374,"_27449":119886,"_2949":119927},[],"Credencial ausente o certificado no válido",{"_3465":71315,"_30211":71298,"_20923":119929,"_5":14374,"_27449":119886,"_2949":119930},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3465":71316,"_30211":71298,"_20923":119932,"_5":14374,"_27449":119886,"_2949":119933},[],"Webhook deniega, expira o responde sin autorización",{"_3465":71317,"_30211":71298,"_20923":119935,"_5":14374,"_27449":119886,"_2949":119936},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3465":71318,"_30211":71298,"_20923":119938,"_5":14374,"_27449":119886,"_2949":52975},[],{"_3465":71319,"_30211":71298,"_20923":119940,"_5":14374,"_27449":119886,"_2949":119941},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3465":71320,"_30211":71298,"_20923":119943,"_5":14374,"_27449":119886,"_2949":52981},[],{"_3465":71321,"_30211":71298,"_20923":119945,"_5":14374,"_27449":119886,"_2949":119946},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3465":71322,"_30211":71298,"_20923":119948,"_5":14374,"_27449":119886,"_2949":52987},[],{"_3465":71323,"_30211":71298,"_20923":119950,"_5":14374,"_27449":119886,"_2949":119951},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3465":71324,"_30211":71298,"_20923":119953,"_5":14374,"_27449":119886,"_2949":52993},[],{"_3465":71325,"_30211":71298,"_20923":119955,"_5":14374,"_27449":119886,"_2949":119956},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3465":71326,"_30211":71298,"_20923":119958,"_5":14374,"_27449":119886,"_2949":52999},[],{"_3465":71327,"_30211":71298,"_20923":119960,"_5":14374,"_27449":119886,"_2949":119961},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3465":71328,"_30211":71298,"_20923":119963,"_5":14374,"_27449":119886,"_2949":119964},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3465":71329,"_30211":71298,"_20923":119966,"_5":14374,"_27449":119886,"_2949":119967},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3465":71330,"_30211":71298,"_20923":119969,"_5":14374,"_27449":119886,"_2949":119970},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3465":71331,"_30211":71298,"_20923":119972,"_5":14374,"_27449":119886,"_2949":119973},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3465":71332,"_30211":71298,"_20923":119975,"_5":14374,"_27449":119886,"_2949":53017},[],{"_3465":71333,"_30211":71298,"_20923":119977,"_5":14374,"_27449":119886,"_2949":119978},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3465":71334,"_30211":71298,"_20923":119980,"_5":14374,"_27449":119886,"_2949":53023},[],{"_3465":71335,"_30211":71298,"_20923":119982,"_5":14374,"_27449":119886,"_2949":119983},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3465":71336,"_30211":71298,"_20923":119985,"_5":14374,"_27449":119886,"_2949":119986},[],"DMS propietario distinto",{"_3465":71337,"_30211":71298,"_20923":119988,"_5":14374,"_27449":119886,"_2949":119989},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3465":71338,"_30211":71298,"_20923":119991,"_5":14374,"_27449":119886,"_2949":53035},[],{"_3465":71339,"_30211":71298,"_20923":119993,"_5":14374,"_27449":119886,"_2949":119994},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3465":71340,"_30211":71298,"_20923":119996,"_5":14374,"_27449":119886,"_2949":53041},[],{"_3465":71341,"_30211":71298,"_20923":119998,"_5":14374,"_27449":119886,"_2949":119999},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3465":71342,"_30211":71298,"_20923":120001,"_5":14374,"_27449":119886,"_2949":120002},[],"Certificado actual revocado",{"_3465":71343,"_30211":71298,"_20923":120004,"_5":14374,"_27449":119886,"_2949":120005},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3465":71344,"_30211":71298,"_20923":120007,"_5":14374,"_27449":119886,"_2949":120008},[],"Error de CA, perfil o firma",{"_3465":71345,"_30211":71298,"_20923":120010,"_5":14374,"_27449":119886,"_2949":120011},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3465":71346,"_30211":71298,"_20923":120013,"_5":14374,"_27449":119886,"_2949":120014},[],"HTTP 200 sin conexión del dispositivo",{"_3465":71347,"_30211":71298,"_20923":120016,"_5":14374,"_27449":119886,"_2949":120017},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3465":71348,"_30211":71298,"_20923":120019,"_5":14374,"_27449":119886,"_2949":120020},[],"Timeout o error después de emitir",{"_3465":71349,"_30211":71298,"_20923":120022,"_5":14374,"_27449":119886,"_2949":120023},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3465":71350,"_30211":71298,"_20923":120025,"_5":14374,"_27449":119890,"_2949":120026},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3465":71351,"_30211":71298,"_20923":120028,"_5":14374,"_27449":119890,"_2949":120029},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3465":71352,"_30211":71298,"_20923":120031,"_5":14374,"_27449":119893,"_2949":120032},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3465":71353,"_30211":71298,"_20923":120034,"_5":14374,"_27449":119893,"_2949":120035},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3465":71354,"_30211":71298,"_20923":120037,"_5":14374,"_27449":119893,"_2949":120038},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3465":71355,"_30211":71298,"_20923":120040,"_5":14374,"_27449":119893,"_2949":120041},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3465":71356,"_30211":71298,"_20923":120043,"_5":14374,"_27449":119893,"_2949":120044},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3465":71357,"_30211":71298,"_20923":120046,"_5":14374,"_27449":119893,"_2949":120047},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3465":71358,"_30211":71298,"_20923":120049,"_5":14374,"_27449":119893,"_2949":120050},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3465":71359,"_30211":71359,"_5":14726,"_2949":120052,"_30543":120053,"_20923":120054,"_27449":71359},"Distribución y actualización de confianza",[49241,117727,51730,118739,118914],[],{"_3465":71360,"_30211":71359,"_20923":120056,"_5":14374,"_27449":71359,"_2949":120057},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3465":71361,"_30211":71359,"_5":30540,"_20923":120059,"_27449":120060,"_2949":120061},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3465":71362,"_30211":71359,"_5":30540,"_20923":120063,"_27449":120064,"_2949":120065},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3465":71363,"_30211":71359,"_5":30540,"_20923":120067,"_27449":120068,"_2949":120069},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3465":71364,"_30211":71359,"_5":30540,"_20923":120071,"_27449":120072,"_2949":120073},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3465":71365,"_30211":71359,"_5":30540,"_20923":120075,"_27449":120076,"_2949":120077},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3465":71366,"_30211":71359,"_20923":120079,"_5":14374,"_27449":71359,"_2949":120080},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3465":71367,"_30211":71359,"_20923":120082,"_5":14374,"_27449":120060,"_2949":120083},[],"Relación",{"_3465":71368,"_30211":71359,"_20923":120085,"_5":14374,"_27449":120060,"_2949":120086},[],"Material que prepara el responsable",{"_3465":71369,"_30211":71359,"_20923":120088,"_5":14374,"_27449":120060,"_2949":120089},[],"Dispositivo → servidor EST",{"_3465":71370,"_30211":71359,"_20923":120091,"_5":14374,"_27449":120060,"_2949":120092},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3465":71371,"_30211":71359,"_20923":120094,"_5":14374,"_27449":120060,"_2949":120095},[],"DMS → solicitante",{"_3465":71372,"_30211":71359,"_20923":120097,"_5":14374,"_27449":120060,"_2949":120098},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3465":71373,"_30211":71359,"_20923":120100,"_5":14374,"_27449":120060,"_2949":120101},[],"Consumidor → dispositivo",{"_3465":71374,"_30211":71359,"_20923":120103,"_5":14374,"_27449":120060,"_2949":120104},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3465":71375,"_30211":71359,"_20923":120106,"_5":14374,"_27449":120060,"_2949":120107},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3465":71376,"_30211":71359,"_20923":120109,"_5":14374,"_27449":120064,"_2949":120110},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3465":71377,"_30211":71359,"_20923":120112,"_5":14374,"_27449":120064,"_2949":120113},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3465":71378,"_30211":71359,"_20923":120115,"_5":14374,"_27449":120068,"_2949":120116},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3465":71379,"_30211":71359,"_20923":120118,"_5":14374,"_27449":120068,"_2949":120119},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3465":71380,"_30211":71359,"_20923":120121,"_5":14374,"_27449":120068,"_2949":120122},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3465":71381,"_30211":71359,"_20923":120124,"_5":14374,"_27449":120068,"_2949":120125},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3465":71382,"_30211":71359,"_20923":120127,"_5":14374,"_27449":120068,"_2949":120128},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3465":71383,"_30211":71359,"_20923":120130,"_5":14374,"_27449":120068,"_2949":120131},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3465":71384,"_30211":71359,"_20923":120133,"_5":14374,"_27449":120072,"_2949":120134},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3465":71385,"_30211":71359,"_20923":120136,"_5":14374,"_27449":120072,"_2949":120137},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3465":71386,"_30211":71359,"_20923":120139,"_5":14374,"_27449":120072,"_2949":120140},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3465":71387,"_30211":71359,"_20923":120142,"_5":14374,"_27449":120076,"_2949":120143},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3465":71388,"_30211":71388,"_5":14726,"_2949":53190,"_30543":120145,"_20923":120147,"_27449":71388},[49241,117727,51730,118739,120146],"Integraciones",[],{"_3465":71389,"_30211":71388,"_20923":120149,"_5":14374,"_27449":71388,"_2949":120150},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3465":71390,"_30211":71388,"_5":30540,"_20923":120152,"_27449":120153,"_2949":120154},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3465":71391,"_30211":71388,"_5":30540,"_20923":120156,"_27449":120157,"_2949":120158},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3465":71392,"_30211":71388,"_5":30540,"_20923":120160,"_27449":120161,"_2949":120162},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3465":71393,"_30211":71388,"_5":30540,"_20923":120164,"_27449":120165,"_2949":120166},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3465":71394,"_30211":71388,"_5":30540,"_20923":120168,"_27449":120169,"_2949":120170},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3465":71395,"_30211":71388,"_5":30540,"_20923":120172,"_27449":120173,"_2949":120174},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3465":71396,"_30211":71388,"_5":30540,"_20923":120176,"_27449":120177,"_2949":120178},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3465":71397,"_30211":71388,"_5":30540,"_20923":120180,"_27449":120181,"_2949":120182},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3465":71398,"_30211":71388,"_5":30540,"_20923":120184,"_27449":120185,"_2949":53232},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3465":71399,"_30211":71388,"_5":30540,"_20923":120187,"_27449":120188,"_2949":53236},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3465":71400,"_30211":71388,"_5":30540,"_20923":120190,"_27449":120191,"_2949":120192},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3465":71401,"_30211":71388,"_5":30540,"_20923":120194,"_27449":120195,"_2949":120196},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3465":71402,"_30211":71388,"_5":30540,"_20923":120198,"_27449":120199,"_2949":120200},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3465":71403,"_30211":71388,"_5":30540,"_20923":120202,"_27449":120203,"_2949":120204},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3465":71404,"_30211":71388,"_5":30540,"_20923":120206,"_27449":120207,"_2949":120208},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3465":71405,"_30211":71388,"_5":30540,"_20923":120210,"_27449":120211,"_2949":120212},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3465":71406,"_30211":71388,"_5":30540,"_20923":120214,"_27449":120215,"_2949":120216},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3465":71407,"_30211":71388,"_5":30540,"_20923":120218,"_27449":120219,"_2949":120220},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3465":71408,"_30211":71388,"_5":30540,"_20923":120222,"_27449":120223,"_2949":120224},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3465":71409,"_30211":71388,"_5":30540,"_20923":120226,"_27449":120227,"_2949":120228},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3465":71410,"_30211":71388,"_5":30540,"_20923":120230,"_27449":120231,"_2949":120232},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3465":71411,"_30211":71388,"_5":30540,"_20923":120234,"_27449":120235,"_2949":120236},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3465":71412,"_30211":71388,"_5":30540,"_20923":120238,"_27449":120239,"_2949":120240},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3465":71413,"_30211":71388,"_5":30540,"_20923":120242,"_27449":120243,"_2949":120244},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3465":71414,"_30211":71388,"_5":30540,"_20923":120246,"_27449":120247,"_2949":120248},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3465":71415,"_30211":71388,"_20923":120250,"_5":14374,"_27449":71388,"_2949":120251},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3465":71416,"_30211":71388,"_20923":120253,"_5":14374,"_27449":71388,"_2949":120254},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3465":71417,"_30211":71388,"_20923":120256,"_5":14374,"_27449":71388,"_2949":120257},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3465":71418,"_30211":71388,"_20923":120259,"_5":14374,"_27449":120153,"_2949":120260},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3465":71419,"_30211":71388,"_20923":120262,"_5":14374,"_27449":120153,"_2949":120263},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3465":71420,"_30211":71388,"_20923":120265,"_5":14374,"_27449":120153,"_2949":120266},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3465":71421,"_30211":71388,"_20923":120268,"_5":14374,"_27449":120153,"_2949":120269},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3465":71422,"_30211":71388,"_20923":120271,"_5":14374,"_27449":120157,"_2949":120272},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3465":71423,"_30211":71388,"_20923":120274,"_5":14374,"_27449":120161,"_2949":120275},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3465":71424,"_30211":71388,"_20923":120277,"_5":14374,"_27449":120161,"_2949":120278},[],"Acción IAM",{"_3465":71425,"_30211":71388,"_20923":120280,"_5":14374,"_27449":120161,"_2949":116668},[],{"_3465":71426,"_30211":71388,"_20923":120282,"_5":14374,"_27449":120161,"_2949":53331},[],{"_3465":71427,"_30211":71388,"_20923":120284,"_5":14374,"_27449":120161,"_2949":120285},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3465":71428,"_30211":71388,"_20923":120287,"_5":14374,"_27449":120161,"_2949":53337},[],{"_3465":71429,"_30211":71388,"_20923":120289,"_5":14374,"_27449":120161,"_2949":120290},[],"Registrar la CA en AWS IoT",{"_3465":71430,"_30211":71388,"_20923":120292,"_5":14374,"_27449":120161,"_2949":53343},[],{"_3465":71431,"_30211":71388,"_20923":120294,"_5":14374,"_27449":120161,"_2949":120295},[],"Consultar el estado del registro de la CA",{"_3465":71432,"_30211":71388,"_20923":120297,"_5":14374,"_27449":120161,"_2949":53349},[],{"_3465":71433,"_30211":71388,"_20923":120299,"_5":14374,"_27449":120161,"_2949":120300},[],"Crear o actualizar Things en IoT Core",{"_3465":71434,"_30211":71388,"_20923":120302,"_5":14374,"_27449":120161,"_2949":53355},[],{"_3465":71435,"_30211":71388,"_20923":120304,"_5":14374,"_27449":120161,"_2949":120305},[],"Aprovisionar Things mediante plantilla",{"_3465":71436,"_30211":71388,"_20923":120307,"_5":14374,"_27449":120161,"_2949":53361},[],{"_3465":71437,"_30211":71388,"_20923":120309,"_5":14374,"_27449":120161,"_2949":120310},[],"Registrar certificados de dispositivo",{"_3465":71438,"_30211":71388,"_20923":120312,"_5":14374,"_27449":120161,"_2949":53367},[],{"_3465":71439,"_30211":71388,"_20923":120314,"_5":14374,"_27449":120161,"_2949":120315},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3465":71440,"_30211":71388,"_20923":120317,"_5":14374,"_27449":120161,"_2949":53373},[],{"_3465":71441,"_30211":71388,"_20923":120319,"_5":14374,"_27449":120161,"_2949":120320},[],"Crear y adjuntar políticas IoT",{"_3465":71442,"_30211":71388,"_20923":120322,"_5":14374,"_27449":120161,"_2949":53379},[],{"_3465":71443,"_30211":71388,"_20923":120324,"_5":14374,"_27449":120161,"_2949":120325},[],"Gestionar grupos de Things",{"_3465":71444,"_30211":71388,"_20923":120327,"_5":14374,"_27449":120161,"_2949":53385},[],{"_3465":71445,"_30211":71388,"_20923":120329,"_5":14374,"_27449":120161,"_2949":120330},[],"Crear plantillas JITP",{"_3465":71446,"_30211":71388,"_20923":120332,"_5":14374,"_27449":120161,"_2949":53391},[],{"_3465":71447,"_30211":71388,"_20923":120334,"_5":14374,"_27449":120161,"_2949":120335},[],"Leer y escribir el Device Shadow",{"_3465":71448,"_30211":71388,"_20923":120337,"_5":14374,"_27449":120161,"_2949":120338},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3465":71449,"_30211":71388,"_20923":120340,"_5":14374,"_27449":120165,"_2949":120341},[],"Parámetro",{"_3465":71450,"_30211":71388,"_20923":120343,"_5":14374,"_27449":120165,"_2949":120344},[],"Tipo",{"_3465":71451,"_30211":71388,"_20923":120346,"_5":14374,"_27449":120165,"_2949":120347},[],"Requerido",{"_3465":71452,"_30211":71388,"_20923":120349,"_5":14374,"_27449":120165,"_2949":120350},[],"Descripción",{"_3465":71453,"_30211":71388,"_20923":120352,"_5":14374,"_27449":120165,"_2949":53412},[],{"_3465":71454,"_30211":71388,"_20923":120354,"_5":14374,"_27449":120165,"_2949":25028},[],{"_3465":71455,"_30211":71388,"_20923":120356,"_5":14374,"_27449":120165,"_2949":120357},[],"Sí",{"_3465":71456,"_30211":71388,"_20923":120359,"_5":14374,"_27449":120165,"_2949":120360},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3465":71457,"_30211":71388,"_20923":120362,"_5":14374,"_27449":120165,"_2949":53423},[],{"_3465":71458,"_30211":71388,"_20923":120364,"_5":14374,"_27449":120165,"_2949":25028},[],{"_3465":71459,"_30211":71388,"_20923":120366,"_5":14374,"_27449":120165,"_2949":120357},[],{"_3465":71460,"_30211":71388,"_20923":120368,"_5":14374,"_27449":120165,"_2949":120369},[],"Región AWS donde opera el conector.",{"_3465":71461,"_30211":71388,"_20923":120371,"_5":14374,"_27449":120165,"_2949":53433},[],{"_3465":71462,"_30211":71388,"_20923":120373,"_5":14374,"_27449":120165,"_2949":25028},[],{"_3465":71463,"_30211":71388,"_20923":120375,"_5":14374,"_27449":120165,"_2949":120357},[],{"_3465":71464,"_30211":71388,"_20923":120377,"_5":14374,"_27449":120165,"_2949":120378},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3465":71465,"_30211":71388,"_20923":120380,"_5":14374,"_27449":120165,"_2949":53443},[],{"_3465":71466,"_30211":71388,"_20923":120382,"_5":14374,"_27449":120165,"_2949":25028},[],{"_3465":71467,"_30211":71388,"_20923":120384,"_5":14374,"_27449":120165,"_2949":120385},[],"Solo con `auth_method=static`",{"_3465":71468,"_30211":71388,"_20923":120387,"_5":14374,"_27449":120165,"_2949":120388},[],"Clave de acceso AWS.",{"_3465":71469,"_30211":71388,"_20923":120390,"_5":14374,"_27449":120165,"_2949":53454},[],{"_3465":71470,"_30211":71388,"_20923":120392,"_5":14374,"_27449":120165,"_2949":25028},[],{"_3465":71471,"_30211":71388,"_20923":120394,"_5":14374,"_27449":120165,"_2949":120385},[],{"_3465":71472,"_30211":71388,"_20923":120396,"_5":14374,"_27449":120165,"_2949":120397},[],"Clave secreta AWS.",{"_3465":71473,"_30211":71388,"_20923":120399,"_5":14374,"_27449":120165,"_2949":53464},[],{"_3465":71474,"_30211":71388,"_20923":120401,"_5":14374,"_27449":120165,"_2949":25028},[],{"_3465":71475,"_30211":71388,"_20923":120403,"_5":14374,"_27449":120165,"_2949":53469},[],{"_3465":71476,"_30211":71388,"_20923":120405,"_5":14374,"_27449":120165,"_2949":120406},[],"Token de sesión (con `auth_method=static`).",{"_3465":71477,"_30211":71388,"_20923":120408,"_5":14374,"_27449":120165,"_2949":53475},[],{"_3465":71478,"_30211":71388,"_20923":120410,"_5":14374,"_27449":120165,"_2949":25028},[],{"_3465":71479,"_30211":71388,"_20923":120412,"_5":14374,"_27449":120165,"_2949":120413},[],"Solo con `auth_method=role`",{"_3465":71480,"_30211":71388,"_20923":120415,"_5":14374,"_27449":120165,"_2949":120416},[],"ARN del rol a asumir.",{"_3465":71481,"_30211":71388,"_20923":120418,"_5":14374,"_27449":120165,"_2949":53486},[],{"_3465":71482,"_30211":71388,"_20923":120420,"_5":14374,"_27449":120165,"_2949":25028},[],{"_3465":71483,"_30211":71388,"_20923":120422,"_5":14374,"_27449":120165,"_2949":53469},[],{"_3465":71484,"_30211":71388,"_20923":120424,"_5":14374,"_27449":120165,"_2949":120425},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3465":71485,"_30211":71388,"_20923":120427,"_5":14374,"_27449":120165,"_2949":53496},[],{"_3465":71486,"_30211":71388,"_20923":120429,"_5":14374,"_27449":120165,"_2949":89768},[],{"_3465":71487,"_30211":71388,"_20923":120431,"_5":14374,"_27449":120165,"_2949":120357},[],{"_3465":71488,"_30211":71388,"_20923":120433,"_5":14374,"_27449":120165,"_2949":120434},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3465":71489,"_30211":71388,"_20923":120436,"_5":14374,"_27449":120165,"_2949":53506},[],{"_3465":71490,"_30211":71388,"_20923":120438,"_5":14374,"_27449":120165,"_2949":25028},[],{"_3465":71491,"_30211":71388,"_20923":120440,"_5":14374,"_27449":120165,"_2949":120357},[],{"_3465":71492,"_30211":71388,"_20923":120442,"_5":14374,"_27449":120165,"_2949":120443},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3465":71493,"_30211":71388,"_20923":120445,"_5":14374,"_27449":120165,"_2949":53516},[],{"_3465":71494,"_30211":71388,"_20923":120447,"_5":14374,"_27449":120165,"_2949":25028},[],{"_3465":71495,"_30211":71388,"_20923":120449,"_5":14374,"_27449":120165,"_2949":120357},[],{"_3465":71496,"_30211":71388,"_20923":120451,"_5":14374,"_27449":120165,"_2949":120452},[],"URL HTTP del Device Manager de Lamassu.",{"_3465":71497,"_30211":71388,"_20923":120454,"_5":14374,"_27449":120165,"_2949":53526},[],{"_3465":71498,"_30211":71388,"_20923":120456,"_5":14374,"_27449":120165,"_2949":25028},[],{"_3465":71499,"_30211":71388,"_20923":120458,"_5":14374,"_27449":120165,"_2949":120357},[],{"_3465":71500,"_30211":71388,"_20923":120460,"_5":14374,"_27449":120165,"_2949":120461},[],"URL HTTP del servicio de CA de Lamassu.",{"_3465":71501,"_30211":71388,"_20923":120463,"_5":14374,"_27449":120169,"_2949":120464},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3465":71502,"_30211":71388,"_20923":120466,"_5":14374,"_27449":120169,"_2949":120467},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3465":71503,"_30211":71388,"_20923":120469,"_5":14374,"_27449":120169,"_2949":120470},[],"Tipo de CloudEvent",{"_3465":71504,"_30211":71388,"_20923":120472,"_5":14374,"_27449":120169,"_2949":120473},[],"Recurso en Lamassu",{"_3465":71505,"_30211":71388,"_20923":120475,"_5":14374,"_27449":120169,"_2949":120476},[],"Recurso AWS",{"_3465":71506,"_30211":71388,"_20923":120478,"_5":14374,"_27449":120169,"_2949":120479},[],"Acciones IAM",{"_3465":71507,"_30211":71388,"_20923":120481,"_5":14374,"_27449":120169,"_2949":120482},[],"Llamadas AWS y efecto",{"_3465":71508,"_30211":71388,"_20923":120484,"_5":14374,"_27449":120169,"_2949":120485},[],"Dónde en esta página",{"_3465":71509,"_30211":71388,"_20923":120487,"_5":14374,"_27449":120169,"_2949":53560},[],{"_3465":71510,"_30211":71388,"_20923":120489,"_5":14374,"_27449":120169,"_2949":53563},[],{"_3465":71511,"_30211":71388,"_20923":120491,"_5":14374,"_27449":120169,"_2949":53566},[],{"_3465":71512,"_30211":71388,"_20923":120493,"_5":14374,"_27449":120169,"_2949":53569},[],{"_3465":71513,"_30211":71388,"_20923":120495,"_5":14374,"_27449":120169,"_2949":120496},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3465":71514,"_30211":71388,"_20923":120498,"_5":14374,"_27449":120169,"_2949":120182},[],{"_3465":71515,"_30211":71388,"_20923":120500,"_5":14374,"_27449":120169,"_2949":53577},[],{"_3465":71516,"_30211":71388,"_20923":120502,"_5":14374,"_27449":120169,"_2949":53580},[],{"_3465":71517,"_30211":71388,"_20923":120504,"_5":14374,"_27449":120169,"_2949":53583},[],{"_3465":71518,"_30211":71388,"_20923":120506,"_5":14374,"_27449":120169,"_2949":53586},[],{"_3465":71519,"_30211":71388,"_20923":120508,"_5":14374,"_27449":120169,"_2949":120509},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3465":71520,"_30211":71388,"_20923":120511,"_5":14374,"_27449":120169,"_2949":120208},[],{"_3465":71521,"_30211":71388,"_20923":120513,"_5":14374,"_27449":120169,"_2949":53594},[],{"_3465":71522,"_30211":71388,"_20923":120515,"_5":14374,"_27449":120169,"_2949":120516},[],"Dispositivo",{"_3465":71523,"_30211":71388,"_20923":120518,"_5":14374,"_27449":120169,"_2949":53600},[],{"_3465":71524,"_30211":71388,"_20923":120520,"_5":14374,"_27449":120169,"_2949":53603},[],{"_3465":71525,"_30211":71388,"_20923":120522,"_5":14374,"_27449":120169,"_2949":120523},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3465":71526,"_30211":71388,"_20923":120525,"_5":14374,"_27449":120169,"_2949":120216},[],{"_3465":71527,"_30211":71388,"_20923":120527,"_5":14374,"_27449":120169,"_2949":53611},[],{"_3465":71528,"_30211":71388,"_20923":120529,"_5":14374,"_27449":120169,"_2949":120530},[],"Certificado",{"_3465":71529,"_30211":71388,"_20923":120532,"_5":14374,"_27449":120169,"_2949":53617},[],{"_3465":71530,"_30211":71388,"_20923":120534,"_5":14374,"_27449":120169,"_2949":120535},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3465":71531,"_30211":71388,"_20923":120537,"_5":14374,"_27449":120169,"_2949":120538},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3465":71532,"_30211":71388,"_20923":120540,"_5":14374,"_27449":120169,"_2949":120228},[],{"_3465":71533,"_30211":71388,"_20923":120542,"_5":14374,"_27449":120169,"_2949":53628},[],{"_3465":71534,"_30211":71388,"_20923":120544,"_5":14374,"_27449":120169,"_2949":120545},[],"Certificado / Dispositivo",{"_3465":71535,"_30211":71388,"_20923":120547,"_5":14374,"_27449":120169,"_2949":53634},[],{"_3465":71536,"_30211":71388,"_20923":120549,"_5":14374,"_27449":120169,"_2949":49637},[],{"_3465":71537,"_30211":71388,"_20923":120551,"_5":14374,"_27449":120169,"_2949":120552},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3465":71538,"_30211":71388,"_20923":120554,"_5":14374,"_27449":120169,"_2949":120236},[],{"_3465":71539,"_30211":71388,"_20923":120556,"_5":14374,"_27449":120173,"_2949":120557},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3465":71540,"_30211":71388,"_20923":120559,"_5":14374,"_27449":120177,"_2949":120560},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3465":71541,"_30211":71388,"_20923":120562,"_5":14374,"_27449":120177,"_2949":120563},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3465":71542,"_30211":71388,"_20923":120565,"_5":14374,"_27449":120181,"_2949":120566},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3465":71543,"_30211":71388,"_20923":120568,"_5":14374,"_27449":120181,"_2949":120569},[],"Transición",{"_3465":71544,"_30211":71388,"_20923":120571,"_5":14374,"_27449":120181,"_2949":120572},[],"Llamadas AWS",{"_3465":71545,"_30211":71388,"_20923":120574,"_5":14374,"_27449":120181,"_2949":120575},[],"`NoRegistrada` → `Solicitada`",{"_3465":71546,"_30211":71388,"_20923":120577,"_5":14374,"_27449":120181,"_2949":120578},[],"ninguna (solo escritura de metadatos)",{"_3465":71547,"_30211":71388,"_20923":120580,"_5":14374,"_27449":120181,"_2949":120581},[],"`Solicitada` → `Registrando`",{"_3465":71548,"_30211":71388,"_20923":120583,"_5":14374,"_27449":120181,"_2949":120584},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3465":71549,"_30211":71388,"_20923":120586,"_5":14374,"_27449":120181,"_2949":120587},[],"`Registrando` → `Completada`",{"_3465":71550,"_30211":71388,"_20923":120589,"_5":14374,"_27449":120181,"_2949":120590},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3465":71551,"_30211":71388,"_20923":120592,"_5":14374,"_27449":120181,"_2949":120593},[],"`Registrando` → `Fallida`",{"_3465":71552,"_30211":71388,"_20923":120595,"_5":14374,"_27449":120181,"_2949":120596},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3465":71553,"_30211":71388,"_20923":120598,"_5":14374,"_27449":120181,"_2949":120599},[],"`Fallida` / `Completada` → `Solicitada`",{"_3465":71554,"_30211":71388,"_20923":120601,"_5":14374,"_27449":120181,"_2949":120602},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3465":71555,"_30211":71388,"_20923":120604,"_5":14374,"_27449":120185,"_2949":120605},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3465":71556,"_30211":71388,"_20923":120607,"_5":14374,"_27449":120185,"_2949":120608},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3465":71557,"_30211":71388,"_20923":120610,"_5":14374,"_27449":120185,"_2949":120611},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3465":71558,"_30211":71388,"_20923":120613,"_5":14374,"_27449":120185,"_2949":120614},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3465":71559,"_30211":71388,"_20923":120616,"_5":14374,"_27449":120185,"_2949":120617},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3465":71560,"_30211":71388,"_20923":120619,"_5":14374,"_27449":120185,"_2949":120620},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3465":71561,"_30211":71388,"_20923":120622,"_5":14374,"_27449":120188,"_2949":120623},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3465":71562,"_30211":71388,"_20923":120625,"_5":14374,"_27449":120191,"_2949":120626},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3465":71563,"_30211":71388,"_20923":120628,"_5":14374,"_27449":120191,"_2949":120629},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3465":71564,"_30211":71388,"_20923":120631,"_5":14374,"_27449":120195,"_2949":120632},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3465":71565,"_30211":71388,"_20923":120634,"_5":14374,"_27449":120199,"_2949":120635},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3465":71566,"_30211":71388,"_20923":120637,"_5":14374,"_27449":120199,"_2949":120638},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3465":71567,"_30211":71388,"_20923":120640,"_5":14374,"_27449":120199,"_2949":120641},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3465":71568,"_30211":71388,"_20923":120643,"_5":14374,"_27449":120199,"_2949":120644},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3465":71569,"_30211":71388,"_20923":120646,"_5":14374,"_27449":120199,"_2949":120647},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3465":71570,"_30211":71388,"_20923":120649,"_5":14374,"_27449":120199,"_2949":120650},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3465":71571,"_30211":71388,"_20923":120652,"_5":14374,"_27449":120203,"_2949":120653},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3465":71572,"_30211":71388,"_20923":120655,"_5":14374,"_27449":120203,"_2949":120656},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3465":71573,"_30211":71388,"_20923":120658,"_5":14374,"_27449":120203,"_2949":120659},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3465":71574,"_30211":71388,"_20923":120661,"_5":14374,"_27449":120203,"_2949":120662},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3465":71575,"_30211":71388,"_20923":120664,"_5":14374,"_27449":120203,"_2949":120665},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3465":71576,"_30211":71388,"_20923":120667,"_5":14374,"_27449":120207,"_2949":120668},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3465":71577,"_30211":71388,"_20923":120670,"_5":14374,"_27449":120207,"_2949":120569},[],{"_3465":71578,"_30211":71388,"_20923":120672,"_5":14374,"_27449":120207,"_2949":120572},[],{"_3465":71579,"_30211":71388,"_20923":120674,"_5":14374,"_27449":120207,"_2949":120675},[],"`SinConfigurar` → `None` / `Auto`",{"_3465":71580,"_30211":71388,"_20923":120677,"_5":14374,"_27449":120207,"_2949":120678},[],"ninguna (solo configuración)",{"_3465":71581,"_30211":71388,"_20923":120680,"_5":14374,"_27449":120207,"_2949":53771},[],{"_3465":71582,"_30211":71388,"_20923":120682,"_5":14374,"_27449":120207,"_2949":120678},[],{"_3465":71583,"_30211":71388,"_20923":120684,"_5":14374,"_27449":120207,"_2949":120685},[],"Cualquiera → `Jitp`",{"_3465":71584,"_30211":71388,"_20923":120687,"_5":14374,"_27449":120207,"_2949":120688},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3465":71585,"_30211":71388,"_20923":120690,"_5":14374,"_27449":120207,"_2949":53782},[],{"_3465":71586,"_30211":71388,"_20923":120692,"_5":14374,"_27449":120207,"_2949":120693},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3465":71587,"_30211":71388,"_20923":120695,"_5":14374,"_27449":120211,"_2949":120696},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3465":71588,"_30211":71388,"_20923":120698,"_5":14374,"_27449":120211,"_2949":120699},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3465":71589,"_30211":71388,"_20923":120701,"_5":14374,"_27449":120211,"_2949":120702},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3465":71590,"_30211":71388,"_20923":120704,"_5":14374,"_27449":120215,"_2949":120705},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3465":71591,"_30211":71388,"_20923":120707,"_5":14374,"_27449":120215,"_2949":120569},[],{"_3465":71592,"_30211":71388,"_20923":120709,"_5":14374,"_27449":120215,"_2949":120572},[],{"_3465":71593,"_30211":71388,"_20923":120711,"_5":14374,"_27449":120215,"_2949":120712},[],"`Ausente` → `Aprovisionado`",{"_3465":71594,"_30211":71388,"_20923":120714,"_5":14374,"_27449":120215,"_2949":120715},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3465":71595,"_30211":71388,"_20923":120717,"_5":14374,"_27449":120215,"_2949":120718},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3465":71596,"_30211":71388,"_20923":120720,"_5":14374,"_27449":120215,"_2949":120721},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3465":71597,"_30211":71388,"_20923":120723,"_5":14374,"_27449":120215,"_2949":120724},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3465":71598,"_30211":71388,"_20923":120726,"_5":14374,"_27449":120219,"_2949":120727},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3465":71599,"_30211":71388,"_20923":120729,"_5":14374,"_27449":120219,"_2949":120730},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3465":71600,"_30211":71388,"_20923":120732,"_5":14374,"_27449":120219,"_2949":120733},[],"Para que el flujo JITP funcione correctamente:",{"_3465":71601,"_30211":71388,"_20923":120735,"_5":14374,"_27449":120219,"_2949":120736},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3465":71602,"_30211":71388,"_20923":120738,"_5":14374,"_27449":120219,"_2949":120739},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3465":71603,"_30211":71388,"_20923":120741,"_5":14374,"_27449":120219,"_2949":120742},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3465":71604,"_30211":71388,"_20923":120744,"_5":14374,"_27449":120219,"_2949":120745},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3465":71605,"_30211":71388,"_20923":120747,"_5":14374,"_27449":120223,"_2949":120748},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3465":71606,"_30211":71388,"_20923":120750,"_5":14374,"_27449":120223,"_2949":120751},[],"Estado en Lamassu",{"_3465":71607,"_30211":71388,"_20923":120753,"_5":14374,"_27449":120223,"_2949":120754},[],"Razón de revocación",{"_3465":71608,"_30211":71388,"_20923":120756,"_5":14374,"_27449":120223,"_2949":120757},[],"Estado en AWS IoT Core",{"_3465":71609,"_30211":71388,"_20923":120759,"_5":14374,"_27449":120223,"_2949":53852},[],{"_3465":71610,"_30211":71388,"_20923":120761,"_5":14374,"_27449":120223,"_2949":120762},[],"Ninguna",{"_3465":71611,"_30211":71388,"_20923":120764,"_5":14374,"_27449":120223,"_2949":53858},[],{"_3465":71612,"_30211":71388,"_20923":120766,"_5":14374,"_27449":120223,"_2949":53861},[],{"_3465":71613,"_30211":71388,"_20923":120768,"_5":14374,"_27449":120223,"_2949":53864},[],{"_3465":71614,"_30211":71388,"_20923":120770,"_5":14374,"_27449":120223,"_2949":53867},[],{"_3465":71615,"_30211":71388,"_20923":120772,"_5":14374,"_27449":120223,"_2949":53861},[],{"_3465":71616,"_30211":71388,"_20923":120774,"_5":14374,"_27449":120223,"_2949":120775},[],"Cualquier otra razón",{"_3465":71617,"_30211":71388,"_20923":120777,"_5":14374,"_27449":120223,"_2949":53875},[],{"_3465":71618,"_30211":71388,"_20923":120779,"_5":14374,"_27449":120223,"_2949":120780},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3465":71619,"_30211":71388,"_20923":120782,"_5":14374,"_27449":120227,"_2949":120783},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3465":71620,"_30211":71388,"_20923":120785,"_5":14374,"_27449":120227,"_2949":120569},[],{"_3465":71621,"_30211":71388,"_20923":120787,"_5":14374,"_27449":120227,"_2949":120572},[],{"_3465":71622,"_30211":71388,"_20923":120789,"_5":14374,"_27449":120227,"_2949":120790},[],"`NoSincronizado` → `Active`",{"_3465":71623,"_30211":71388,"_20923":120792,"_5":14374,"_27449":120227,"_2949":53367},[],{"_3465":71624,"_30211":71388,"_20923":120794,"_5":14374,"_27449":120227,"_2949":53893},[],{"_3465":71625,"_30211":71388,"_20923":120796,"_5":14374,"_27449":120227,"_2949":120797},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3465":71626,"_30211":71388,"_20923":120799,"_5":14374,"_27449":120227,"_2949":53899},[],{"_3465":71627,"_30211":71388,"_20923":120801,"_5":14374,"_27449":120227,"_2949":120797},[],{"_3465":71628,"_30211":71388,"_20923":120803,"_5":14374,"_27449":120227,"_2949":53904},[],{"_3465":71629,"_30211":71388,"_20923":120805,"_5":14374,"_27449":120227,"_2949":53367},[],{"_3465":71630,"_30211":71388,"_20923":120807,"_5":14374,"_27449":120227,"_2949":53909},[],{"_3465":71631,"_30211":71388,"_20923":120809,"_5":14374,"_27449":120227,"_2949":120810},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3465":71632,"_30211":71388,"_20923":120812,"_5":14374,"_27449":120231,"_2949":120813},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3465":71633,"_30211":71388,"_20923":120815,"_5":14374,"_27449":120231,"_2949":120816},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3465":71634,"_30211":71388,"_20923":120818,"_5":14374,"_27449":120231,"_2949":120819},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3465":71635,"_30211":71388,"_20923":120821,"_5":14374,"_27449":120235,"_2949":120822},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3465":71636,"_30211":71388,"_20923":120824,"_5":14374,"_27449":120235,"_2949":120825},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3465":71637,"_30211":71388,"_20923":120827,"_5":14374,"_27449":120239,"_2949":120828},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3465":71638,"_30211":71388,"_20923":120830,"_5":14374,"_27449":120239,"_2949":120831},[],"Existen dos tipos de acciones:",{"_3465":71639,"_30211":71388,"_20923":120833,"_5":14374,"_27449":120239,"_2949":120834},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3465":71640,"_30211":71388,"_20923":120836,"_5":14374,"_27449":120239,"_2949":120837},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3465":71641,"_30211":71388,"_20923":120839,"_5":14374,"_27449":120239,"_2949":120840},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3465":71642,"_30211":71388,"_20923":120842,"_5":14374,"_27449":120243,"_2949":120843},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3465":71643,"_30211":71388,"_20923":120845,"_5":14374,"_27449":120243,"_2949":120846},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3465":71644,"_30211":71388,"_20923":120848,"_5":14374,"_27449":120243,"_2949":120849},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3465":71645,"_30211":71388,"_20923":120851,"_5":14374,"_27449":120247,"_2949":120852},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3465":71646,"_30211":71388,"_20923":120854,"_5":14374,"_27449":120247,"_2949":120855},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3465":71647,"_30211":71388,"_20923":120857,"_5":14374,"_27449":120247,"_2949":120858},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3465":71648,"_30211":71388,"_20923":120860,"_5":14374,"_27449":120247,"_2949":120861},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3465":71649,"_30211":71388,"_20923":120863,"_5":14374,"_27449":120247,"_2949":120864},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3465":71650,"_30211":71388,"_20923":120866,"_5":14374,"_27449":120247,"_2949":120867},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3465":71651,"_30211":71388,"_20923":120869,"_5":14374,"_27449":120247,"_2949":120870},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3465":71652,"_30211":71388,"_20923":120872,"_5":14374,"_27449":120247,"_2949":120873},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3465":71653,"_30211":71388,"_20923":120875,"_5":14374,"_27449":120247,"_2949":120876},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3465":71654,"_30211":71388,"_20923":120878,"_5":14374,"_27449":120247,"_2949":120879},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3465":71655,"_30211":71388,"_20923":120881,"_5":14374,"_27449":120247,"_2949":120882},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3465":71656,"_30211":71388,"_20923":120884,"_5":14374,"_27449":120247,"_2949":120885},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3465":71657,"_30211":71388,"_20923":120887,"_5":14374,"_27449":120247,"_2949":120888},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3465":71658,"_30211":71388,"_20923":120890,"_5":14374,"_27449":120247,"_2949":120891},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3465":71659,"_30211":71388,"_20923":120893,"_5":14374,"_27449":120247,"_2949":120894},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3465":71660,"_30211":71388,"_20923":120896,"_5":14374,"_27449":120247,"_2949":120897},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3465":71661,"_30211":71388,"_20923":120899,"_5":14374,"_27449":120247,"_2949":120900},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3465":71662,"_30211":71388,"_20923":120902,"_5":14374,"_27449":120247,"_2949":120903},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3465":71663,"_30211":71388,"_20923":120905,"_5":14374,"_27449":120247,"_2949":120906},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3465":71664,"_30211":71388,"_20923":120908,"_5":14374,"_27449":120247,"_2949":120909},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3465":71665,"_30211":71388,"_20923":120911,"_5":14374,"_27449":120247,"_2949":120912},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3465":71666,"_30211":71388,"_20923":120914,"_5":14374,"_27449":120247,"_2949":120915},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3465":71667,"_30211":71388,"_20923":120917,"_5":14374,"_27449":120247,"_2949":120918},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3465":71668,"_30211":71388,"_20923":120920,"_5":14374,"_27449":120247,"_2949":120921},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3465":71669,"_30211":71669,"_5":14726,"_2949":51730,"_30543":120923,"_20923":120924,"_27449":71669},[49241,117727,51730],[],{"_3465":71670,"_30211":71669,"_20923":120926,"_5":14374,"_27449":71669,"_2949":120927},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3465":71671,"_30211":71669,"_5":30540,"_20923":120929,"_27449":120930,"_2949":120931},[],"/docs/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3465":71672,"_30211":71669,"_5":30540,"_20923":120933,"_27449":120934,"_2949":118739},[],"/docs/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3465":71673,"_30211":71669,"_5":30540,"_20923":120936,"_27449":120937,"_2949":118914},[],"/docs/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3465":71674,"_30211":71669,"_5":30540,"_20923":120939,"_27449":120940,"_2949":120146},[],"/docs/es/platform/iot-fleets/overview#integraciones",{"_3465":71675,"_30211":71669,"_5":30540,"_20923":120942,"_27449":120943,"_2949":120944},[],"/docs/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3465":71676,"_30211":71669,"_20923":120946,"_5":14374,"_27449":71669,"_2949":120947},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3465":71677,"_30211":71669,"_20923":120949,"_5":14374,"_27449":120930,"_2949":120950},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3465":71678,"_30211":71669,"_20923":120952,"_5":14374,"_27449":120930,"_2949":120953},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3465":71679,"_30211":71669,"_20923":120955,"_5":14374,"_27449":120934,"_2949":120956},[],"Recurso",{"_3465":71680,"_30211":71669,"_20923":120958,"_5":14374,"_27449":120934,"_2949":120959},[],"Qué representa",{"_3465":71681,"_30211":71669,"_20923":120961,"_5":14374,"_27449":120934,"_2949":120962},[],"**Dispositivo**",{"_3465":71682,"_30211":71669,"_20923":120964,"_5":14374,"_27449":120934,"_2949":120965},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3465":71683,"_30211":71669,"_20923":120967,"_5":14374,"_27449":120934,"_2949":120968},[],"**Identidad**",{"_3465":71684,"_30211":71669,"_20923":120970,"_5":14374,"_27449":120934,"_2949":120971},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3465":71685,"_30211":71669,"_20923":120973,"_5":14374,"_27449":120934,"_2949":54076},[],{"_3465":71686,"_30211":71669,"_20923":120975,"_5":14374,"_27449":120934,"_2949":120976},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3465":71687,"_30211":71669,"_20923":120978,"_5":14374,"_27449":120934,"_2949":120979},[],"**Flota**",{"_3465":71688,"_30211":71669,"_20923":120981,"_5":14374,"_27449":120934,"_2949":120982},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3465":71689,"_30211":71669,"_20923":120984,"_5":14374,"_27449":120934,"_2949":120985},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3465":71690,"_30211":71669,"_20923":120987,"_5":14374,"_27449":120934,"_2949":120988},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3465":71691,"_30211":71669,"_20923":120990,"_5":14374,"_27449":120937,"_2949":120991},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3465":71692,"_30211":71669,"_20923":120993,"_5":14374,"_27449":120937,"_2949":120994},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3465":71693,"_30211":71669,"_20923":120996,"_5":14374,"_27449":120937,"_2949":120997},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3465":71694,"_30211":71669,"_20923":120999,"_5":14374,"_27449":120937,"_2949":121000},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3465":71695,"_30211":71669,"_20923":121002,"_5":14374,"_27449":120937,"_2949":121003},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3465":71696,"_30211":71669,"_20923":121005,"_5":14374,"_27449":120937,"_2949":121006},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3465":71697,"_30211":71669,"_20923":121008,"_5":14374,"_27449":120937,"_2949":121009},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3465":71698,"_30211":71669,"_20923":121011,"_5":14374,"_27449":120937,"_2949":121012},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3465":71699,"_30211":71669,"_20923":121014,"_5":14374,"_27449":120940,"_2949":121015},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3465":71700,"_30211":71669,"_20923":121017,"_5":14374,"_27449":120940,"_2949":121018},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3465":71701,"_30211":71669,"_20923":121020,"_5":14374,"_27449":120943,"_2949":121021},[],"Participante",{"_3465":71702,"_30211":71669,"_20923":121023,"_5":14374,"_27449":120943,"_2949":121024},[],"Responsabilidad",{"_3465":71703,"_30211":71669,"_20923":121026,"_5":14374,"_27449":120943,"_2949":121027},[],"Administrador PKI",{"_3465":71704,"_30211":71669,"_20923":121029,"_5":14374,"_27449":120943,"_2949":121030},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3465":71705,"_30211":71669,"_20923":121032,"_5":14374,"_27449":120943,"_2949":121033},[],"Administrador del aprovisionamiento",{"_3465":71706,"_30211":71669,"_20923":121035,"_5":14374,"_27449":120943,"_2949":121036},[],"DMS, admisión, autenticación por operación e inventario.",{"_3465":71707,"_30211":71669,"_20923":121038,"_5":14374,"_27449":120943,"_2949":121039},[],"Integrador del dispositivo",{"_3465":71708,"_30211":71669,"_20923":121041,"_5":14374,"_27449":120943,"_2949":121042},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3465":71709,"_30211":71669,"_20923":121044,"_5":14374,"_27449":120943,"_2949":121045},[],"Integrador del consumidor",{"_3465":71710,"_30211":71669,"_20923":121047,"_5":14374,"_27449":120943,"_2949":121048},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3465":71711,"_30211":71669,"_20923":121050,"_5":14374,"_27449":120943,"_2949":121051},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3465":71712,"_30211":71712,"_5":14726,"_2949":121053,"_30543":121054,"_20923":121056,"_27449":71712},"Enrola y conecta tu primer dispositivo",[49241,117727,51730,121055],"Primeros pasos",[],{"_3465":71713,"_30211":71712,"_20923":121058,"_5":14374,"_27449":71712,"_2949":121059},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3465":71714,"_30211":71712,"_5":30540,"_20923":121061,"_27449":121062,"_2949":116298},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3465":71715,"_30211":71712,"_5":30540,"_20923":121064,"_27449":121065,"_2949":121066},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3465":71716,"_30211":71712,"_5":30540,"_20923":121068,"_27449":121069,"_2949":121070},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3465":71717,"_30211":71712,"_5":30540,"_20923":121072,"_27449":121073,"_2949":121074},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3465":71718,"_30211":71712,"_5":30540,"_20923":121076,"_27449":121077,"_2949":121078},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3465":71719,"_30211":71712,"_5":30540,"_20923":121080,"_27449":121081,"_2949":121082},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3465":71720,"_30211":71712,"_5":30540,"_20923":121084,"_27449":121085,"_2949":121086},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3465":71721,"_30211":71712,"_5":30540,"_20923":121088,"_27449":121089,"_2949":121090},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3465":71722,"_30211":71712,"_20923":121092,"_5":14374,"_27449":71712,"_2949":121093},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3465":71723,"_30211":71712,"_20923":121095,"_5":14374,"_27449":121062,"_2949":121096},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3465":71724,"_30211":71712,"_20923":121098,"_5":14374,"_27449":121062,"_2949":121099},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3465":71725,"_30211":71712,"_20923":121101,"_5":14374,"_27449":121062,"_2949":121102},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3465":71726,"_30211":71712,"_20923":121104,"_5":14374,"_27449":121062,"_2949":121105},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3465":71727,"_30211":71712,"_20923":121107,"_5":14374,"_27449":121062,"_2949":121108},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3465":71728,"_30211":71712,"_20923":121110,"_5":14374,"_27449":121065,"_2949":121111},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3465":71729,"_30211":71712,"_20923":121113,"_5":14374,"_27449":121065,"_2949":121114},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3465":71730,"_30211":71712,"_20923":121116,"_5":14374,"_27449":121069,"_2949":121117},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3465":71731,"_30211":71712,"_20923":121119,"_5":14374,"_27449":121069,"_2949":121120},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3465":71732,"_30211":71712,"_20923":121122,"_5":14374,"_27449":121069,"_2949":121123},[],"Ajuste",{"_3465":71733,"_30211":71712,"_20923":121125,"_5":14374,"_27449":121069,"_2949":121126},[],"Valor de evaluación",{"_3465":71734,"_30211":71712,"_20923":121128,"_5":14374,"_27449":121069,"_2949":54232},[],{"_3465":71735,"_30211":71712,"_20923":121130,"_5":14374,"_27449":121069,"_2949":121131},[],"Raíz emisora de `device-root.pem`.",{"_3465":71736,"_30211":71712,"_20923":121133,"_5":14374,"_27449":121069,"_2949":119042},[],{"_3465":71737,"_30211":71712,"_20923":121135,"_5":14374,"_27449":121069,"_2949":121136},[],"Perfil final de 1 hora que acabas de preparar.",{"_3465":71738,"_30211":71712,"_20923":121138,"_5":14374,"_27449":121069,"_2949":54243},[],{"_3465":71739,"_30211":71712,"_20923":121140,"_5":14374,"_27449":121069,"_2949":54246},[],{"_3465":71740,"_30211":71712,"_20923":121142,"_5":14374,"_27449":121069,"_2949":54249},[],{"_3465":71741,"_30211":71712,"_20923":121144,"_5":14374,"_27449":121069,"_2949":121145},[],"Habilitado.",{"_3465":71742,"_30211":71712,"_20923":121147,"_5":14374,"_27449":121069,"_2949":54255},[],{"_3465":71743,"_30211":71712,"_20923":121149,"_5":14374,"_27449":121069,"_2949":121150},[],"Deshabilitado; el ID debe ser nuevo.",{"_3465":71744,"_30211":71712,"_20923":121152,"_5":14374,"_27449":121069,"_2949":121153},[],"Autenticación inicial",{"_3465":71745,"_30211":71712,"_20923":121155,"_5":14374,"_27449":121069,"_2949":121156},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3465":71746,"_30211":71712,"_20923":121158,"_5":14374,"_27449":121069,"_2949":121159},[],"Autenticación de renovación",{"_3465":71747,"_30211":71712,"_20923":121161,"_5":14374,"_27449":121069,"_2949":121162},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3465":71748,"_30211":71712,"_20923":121164,"_5":14374,"_27449":121069,"_2949":54273},[],{"_3465":71749,"_30211":71712,"_20923":121166,"_5":14374,"_27449":121069,"_2949":121167},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3465":71750,"_30211":71712,"_20923":121169,"_5":14374,"_27449":121069,"_2949":54279},[],{"_3465":71751,"_30211":71712,"_20923":121171,"_5":14374,"_27449":121069,"_2949":121172},[],"1 hora.",{"_3465":71752,"_30211":71712,"_20923":121174,"_5":14374,"_27449":121069,"_2949":54285},[],{"_3465":71753,"_30211":71712,"_20923":121176,"_5":14374,"_27449":121069,"_2949":121177},[],"30 minutos / 10 minutos.",{"_3465":71754,"_30211":71712,"_20923":121179,"_5":14374,"_27449":121069,"_2949":54291},[],{"_3465":71755,"_30211":71712,"_20923":121181,"_5":14374,"_27449":121069,"_2949":121182},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3465":71756,"_30211":71712,"_20923":121184,"_5":14374,"_27449":121069,"_2949":52049},[],{"_3465":71757,"_30211":71712,"_20923":121186,"_5":14374,"_27449":121069,"_2949":121187},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3465":71758,"_30211":71712,"_20923":121189,"_5":14374,"_27449":121069,"_2949":54302},[],{"_3465":71759,"_30211":71712,"_20923":121191,"_5":14374,"_27449":121069,"_2949":121192},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3465":71760,"_30211":71712,"_20923":121194,"_5":14374,"_27449":121069,"_2949":121195},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3465":71761,"_30211":71712,"_20923":121197,"_5":14374,"_27449":121073,"_2949":121198},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3465":71762,"_30211":71712,"_20923":121200,"_5":14374,"_27449":121073,"_2949":121201},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3465":71763,"_30211":71712,"_20923":121203,"_5":14374,"_27449":121077,"_2949":121204},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3465":71764,"_30211":71712,"_20923":121206,"_5":14374,"_27449":121077,"_2949":121207},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3465":71765,"_30211":71712,"_20923":121209,"_5":14374,"_27449":121077,"_2949":121210},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3465":71766,"_30211":71712,"_20923":121212,"_5":14374,"_27449":121081,"_2949":121213},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3465":71767,"_30211":71712,"_20923":121215,"_5":14374,"_27449":121081,"_2949":121216},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3465":71768,"_30211":71712,"_20923":121218,"_5":14374,"_27449":121085,"_2949":121219},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3465":71769,"_30211":71712,"_20923":121221,"_5":14374,"_27449":121085,"_2949":121222},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3465":71770,"_30211":71712,"_20923":121224,"_5":14374,"_27449":121085,"_2949":121225},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3465":71771,"_30211":71712,"_20923":121227,"_5":14374,"_27449":121085,"_2949":121228},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3465":71772,"_30211":71712,"_20923":121230,"_5":14374,"_27449":121085,"_2949":121231},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3465":71773,"_30211":71712,"_20923":121233,"_5":14374,"_27449":121089,"_2949":121234},[],"Comprobación",{"_3465":71774,"_30211":71712,"_20923":121236,"_5":14374,"_27449":121089,"_2949":121237},[],"Resultado esperado",{"_3465":71775,"_30211":71712,"_20923":121239,"_5":14374,"_27449":121089,"_2949":121240},[],"Registro",{"_3465":71776,"_30211":71712,"_20923":121242,"_5":14374,"_27449":121089,"_2949":121243},[],"ID creado automáticamente y DMS correcto.",{"_3465":71777,"_30211":71712,"_20923":121245,"_5":14374,"_27449":121089,"_2949":120530},[],{"_3465":71778,"_30211":71712,"_20923":121247,"_5":14374,"_27449":121089,"_2949":121248},[],"CN, perfil, serie y clave verificados.",{"_3465":71779,"_30211":71712,"_20923":121250,"_5":14374,"_27449":121089,"_2949":121251},[],"Inventario",{"_3465":71780,"_30211":71712,"_20923":121253,"_5":14374,"_27449":121089,"_2949":121254},[],"Serie recibida visible como identidad actual y en el historial.",{"_3465":71781,"_30211":71712,"_20923":121256,"_5":14374,"_27449":121089,"_2949":121257},[],"Consumidor",{"_3465":71782,"_30211":71712,"_20923":121259,"_5":14374,"_27449":121089,"_2949":121260},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3465":71783,"_30211":71712,"_20923":121262,"_5":14374,"_27449":121089,"_2949":121263},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3465":71784,"_30211":71712,"_20923":121265,"_5":14374,"_27449":121089,"_2949":121266},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3465":71785,"_30211":71785,"_5":14726,"_2949":118756,"_30543":121268,"_20923":121269,"_27449":71785},[49241,117727,51730,121055],[],{"_3465":71786,"_30211":71785,"_20923":121271,"_5":14374,"_27449":71785,"_2949":121272},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3465":71787,"_30211":71785,"_5":30540,"_20923":121274,"_27449":121275,"_2949":116298},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3465":71788,"_30211":71785,"_5":30540,"_20923":121277,"_27449":121278,"_2949":121279},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3465":71789,"_30211":71785,"_5":30540,"_20923":121281,"_27449":121282,"_2949":121283},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3465":71790,"_30211":71785,"_5":30540,"_20923":121285,"_27449":121286,"_2949":121287},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3465":71791,"_30211":71785,"_5":30540,"_20923":121289,"_27449":121290,"_2949":121291},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3465":71792,"_30211":71785,"_5":30540,"_20923":121293,"_27449":121294,"_2949":121295},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3465":71793,"_30211":71785,"_5":30540,"_20923":121297,"_27449":121298,"_2949":121237},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3465":71794,"_30211":71785,"_5":30540,"_20923":121300,"_27449":121301,"_2949":121302},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3465":71795,"_30211":71785,"_5":30540,"_20923":121304,"_27449":121305,"_2949":121306},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3465":71796,"_30211":71785,"_20923":121308,"_5":14374,"_27449":71785,"_2949":121309},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3465":71797,"_30211":71785,"_20923":121311,"_5":14374,"_27449":71785,"_2949":121312},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3465":71798,"_30211":71785,"_20923":121314,"_5":14374,"_27449":121275,"_2949":121315},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3465":71799,"_30211":71785,"_20923":121317,"_5":14374,"_27449":121275,"_2949":121318},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3465":71800,"_30211":71785,"_20923":121320,"_5":14374,"_27449":121275,"_2949":121321},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3465":71801,"_30211":71785,"_20923":121323,"_5":14374,"_27449":121275,"_2949":121324},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3465":71802,"_30211":71785,"_20923":121326,"_5":14374,"_27449":121278,"_2949":121327},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3465":71803,"_30211":71785,"_20923":121329,"_5":14374,"_27449":121278,"_2949":121330},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3465":71804,"_30211":71785,"_20923":121332,"_5":14374,"_27449":121278,"_2949":121333},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3465":71805,"_30211":71785,"_20923":121335,"_5":14374,"_27449":121278,"_2949":121336},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3465":71806,"_30211":71785,"_20923":121338,"_5":14374,"_27449":121278,"_2949":121339},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3465":71807,"_30211":71785,"_20923":121341,"_5":14374,"_27449":121278,"_2949":121342},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3465":71808,"_30211":71785,"_20923":121344,"_5":14374,"_27449":121278,"_2949":121345},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3465":71809,"_30211":71785,"_20923":121347,"_5":14374,"_27449":121278,"_2949":121348},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3465":71810,"_30211":71785,"_20923":121350,"_5":14374,"_27449":121282,"_2949":121351},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3465":71811,"_30211":71785,"_20923":121353,"_5":14374,"_27449":121282,"_2949":54467},[],{"_3465":71812,"_30211":71785,"_20923":121355,"_5":14374,"_27449":121282,"_2949":121356},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3465":71813,"_30211":71785,"_20923":121358,"_5":14374,"_27449":121282,"_2949":121359},[],"**Icon** y **Tags**: clasificación opcional.",{"_3465":71814,"_30211":71785,"_20923":121361,"_5":14374,"_27449":121282,"_2949":121362},[],"Confirma el registro.",{"_3465":71815,"_30211":71785,"_20923":121364,"_5":14374,"_27449":121286,"_2949":121365},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3465":71816,"_30211":71785,"_20923":121367,"_5":14374,"_27449":121286,"_2949":121368},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3465":71817,"_30211":71785,"_20923":121370,"_5":14374,"_27449":121290,"_2949":121371},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3465":71818,"_30211":71785,"_20923":121373,"_5":14374,"_27449":121290,"_2949":121374},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3465":71819,"_30211":71785,"_20923":121376,"_5":14374,"_27449":121294,"_2949":121377},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3465":71820,"_30211":71785,"_20923":121379,"_5":14374,"_27449":121294,"_2949":121380},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3465":71821,"_30211":71785,"_20923":121382,"_5":14374,"_27449":121298,"_2949":121234},[],{"_3465":71822,"_30211":71785,"_20923":121384,"_5":14374,"_27449":121298,"_2949":121385},[],"Resultado",{"_3465":71823,"_30211":71785,"_20923":121387,"_5":14374,"_27449":121298,"_2949":120516},[],{"_3465":71824,"_30211":71785,"_20923":121389,"_5":14374,"_27449":121298,"_2949":121390},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3465":71825,"_30211":71785,"_20923":121392,"_5":14374,"_27449":121298,"_2949":121393},[],"Identidad actual",{"_3465":71826,"_30211":71785,"_20923":121395,"_5":14374,"_27449":121298,"_2949":121396},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3465":71827,"_30211":71785,"_20923":121398,"_5":14374,"_27449":121298,"_2949":121399},[],"Historial",{"_3465":71828,"_30211":71785,"_20923":121401,"_5":14374,"_27449":121298,"_2949":121402},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3465":71829,"_30211":71785,"_20923":121404,"_5":14374,"_27449":121298,"_2949":121405},[],"Clave y certificado",{"_3465":71830,"_30211":71785,"_20923":121407,"_5":14374,"_27449":121298,"_2949":121408},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3465":71831,"_30211":71785,"_20923":121410,"_5":14374,"_27449":121301,"_2949":121411},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3465":71832,"_30211":71785,"_20923":121413,"_5":14374,"_27449":121301,"_2949":121414},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3465":71833,"_30211":71785,"_20923":121416,"_5":14374,"_27449":121301,"_2949":121417},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3465":71834,"_30211":71785,"_20923":121419,"_5":14374,"_27449":121301,"_2949":121420},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3465":71835,"_30211":71785,"_20923":121422,"_5":14374,"_27449":121305,"_2949":121423},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3465":71836,"_30211":71785,"_20923":121425,"_5":14374,"_27449":121305,"_2949":121426},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3465":71837,"_30211":71785,"_20923":121428,"_5":14374,"_27449":121305,"_2949":121429},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3465":71838,"_30211":71838,"_5":14726,"_2949":121431,"_30543":121432,"_20923":121433,"_27449":71838},"Plataforma Lamassu IoT",[49241,117727],[],{"_3465":71839,"_30211":71838,"_20923":121435,"_5":14374,"_27449":71838,"_2949":121436},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3465":71840,"_30211":71838,"_5":30540,"_20923":121438,"_27449":121439,"_2949":120931},[],"/docs/es/platform/overview#empieza-aquí",{"_3465":71841,"_30211":71838,"_5":30540,"_20923":121441,"_27449":121442,"_2949":121443},[],"/docs/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3465":71842,"_30211":71838,"_5":30540,"_20923":121445,"_27449":121446,"_2949":121447},[],"/docs/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3465":71843,"_30211":71838,"_5":30540,"_20923":121449,"_27449":121450,"_2949":121451},[],"/docs/es/platform/overview#capacidades-principales","Capacidades principales",{"_3465":71844,"_30211":71838,"_5":30540,"_20923":121453,"_27449":121454,"_2949":121455},[],"/docs/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3465":71845,"_30211":71838,"_5":30540,"_20923":121457,"_27449":121458,"_2949":121459},[],"/docs/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3465":71846,"_30211":71838,"_5":30540,"_20923":121461,"_27449":121462,"_2949":121463},[],"/docs/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3465":71847,"_30211":71838,"_5":30540,"_20923":121465,"_27449":121466,"_2949":121467},[],"/docs/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3465":71848,"_30211":71838,"_5":30540,"_20923":121469,"_27449":121470,"_2949":121471},[],"/docs/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3465":71849,"_30211":71838,"_5":30540,"_20923":121473,"_27449":121474,"_2949":121475},[],"/docs/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3465":71850,"_30211":71838,"_5":30540,"_20923":121477,"_27449":121478,"_2949":121479},[],"/docs/es/platform/overview#referencia-operativa","Referencia operativa",{"_3465":71851,"_30211":71838,"_20923":121481,"_5":14374,"_27449":71838,"_2949":121482},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3465":71852,"_30211":71838,"_20923":121484,"_5":14374,"_27449":121439,"_2949":121485},[],"Elige el resultado que necesitas obtener:",{"_3465":71853,"_30211":71838,"_20923":121487,"_5":14374,"_27449":121439,"_2949":121488},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3465":71854,"_30211":71838,"_20923":121490,"_5":14374,"_27449":121439,"_2949":121491},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3465":71855,"_30211":71838,"_20923":121493,"_5":14374,"_27449":121439,"_2949":121494},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3465":71856,"_30211":71838,"_20923":121496,"_5":14374,"_27449":121442,"_2949":121497},[],"Bloque",{"_3465":71857,"_30211":71838,"_20923":121499,"_5":14374,"_27449":121442,"_2949":121500},[],"Qué gestionas",{"_3465":71858,"_30211":71838,"_20923":121502,"_5":14374,"_27449":121442,"_2949":121503},[],"Punto de entrada",{"_3465":71859,"_30211":71838,"_20923":121505,"_5":14374,"_27449":121442,"_2949":54620},[],{"_3465":71860,"_30211":71838,"_20923":121507,"_5":14374,"_27449":121442,"_2949":121508},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3465":71861,"_30211":71838,"_20923":121510,"_5":14374,"_27449":121442,"_2949":121511},[],"Visión general de PKI",{"_3465":71862,"_30211":71838,"_20923":121513,"_5":14374,"_27449":121442,"_2949":54629},[],{"_3465":71863,"_30211":71838,"_20923":121515,"_5":14374,"_27449":121442,"_2949":121516},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3465":71864,"_30211":71838,"_20923":121518,"_5":14374,"_27449":121442,"_2949":121519},[],"Visión general de IoT Fleets",{"_3465":71865,"_30211":71838,"_20923":121521,"_5":14374,"_27449":121442,"_2949":121522},[],"**Administración**",{"_3465":71866,"_30211":71838,"_20923":121524,"_5":14374,"_27449":121442,"_2949":121525},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3465":71867,"_30211":71838,"_20923":121527,"_5":14374,"_27449":121442,"_2949":117725},[],{"_3465":71868,"_30211":71838,"_20923":121529,"_5":14374,"_27449":121442,"_2949":121530},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3465":71869,"_30211":71838,"_20923":121532,"_5":14374,"_27449":121446,"_2949":121533},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3465":71870,"_30211":71838,"_20923":121535,"_5":14374,"_27449":121446,"_2949":121536},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3465":71871,"_30211":71838,"_20923":121538,"_5":14374,"_27449":121446,"_2949":121539},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3465":71872,"_30211":71838,"_20923":121541,"_5":14374,"_27449":121446,"_2949":121542},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3465":71873,"_30211":71838,"_20923":121544,"_5":14374,"_27449":121446,"_2949":121545},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3465":71874,"_30211":71838,"_20923":121547,"_5":14374,"_27449":121446,"_2949":121548},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3465":71875,"_30211":71838,"_20923":121550,"_5":14374,"_27449":121454,"_2949":121551},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3465":71876,"_30211":71838,"_20923":121553,"_5":14374,"_27449":121458,"_2949":121554},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3465":71877,"_30211":71838,"_20923":121556,"_5":14374,"_27449":121462,"_2949":121557},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3465":71878,"_30211":71838,"_20923":121559,"_5":14374,"_27449":121466,"_2949":121560},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3465":71879,"_30211":71838,"_20923":121562,"_5":14374,"_27449":121470,"_2949":121563},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3465":71880,"_30211":71838,"_20923":121565,"_5":14374,"_27449":121474,"_2949":121566},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3465":71881,"_30211":71838,"_20923":121568,"_5":14374,"_27449":121478,"_2949":121024},[],{"_3465":71882,"_30211":71838,"_20923":121570,"_5":14374,"_27449":121478,"_2949":121571},[],"Qué prepara o comprueba",{"_3465":71883,"_30211":71838,"_20923":121573,"_5":14374,"_27449":121478,"_2949":121027},[],{"_3465":71884,"_30211":71838,"_20923":121575,"_5":14374,"_27449":121478,"_2949":121576},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3465":71885,"_30211":71838,"_20923":121578,"_5":14374,"_27449":121478,"_2949":121579},[],"Administrador de la flota",{"_3465":71886,"_30211":71838,"_20923":121581,"_5":14374,"_27449":121478,"_2949":121582},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3465":71887,"_30211":71838,"_20923":121584,"_5":14374,"_27449":121478,"_2949":121039},[],{"_3465":71888,"_30211":71838,"_20923":121586,"_5":14374,"_27449":121478,"_2949":121587},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3465":71889,"_30211":71838,"_20923":121589,"_5":14374,"_27449":121478,"_2949":121045},[],{"_3465":71890,"_30211":71838,"_20923":121591,"_5":14374,"_27449":121478,"_2949":121592},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3465":71891,"_30211":71838,"_20923":121594,"_5":14374,"_27449":121478,"_2949":121595},[],"Operador de infraestructura",{"_3465":71892,"_30211":71838,"_20923":121597,"_5":14374,"_27449":121478,"_2949":121598},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3465":71893,"_30211":71838,"_20923":121600,"_5":14374,"_27449":121478,"_2949":121601},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3465":71894,"_30211":71894,"_5":14726,"_2949":121603,"_30543":121604,"_20923":121606,"_27449":71894},"Jerarquía y rotación de CAs",[49241,117727,54721,121605],"Claves, autoridades y certificados",[],{"_3465":71895,"_30211":71894,"_20923":121608,"_5":14374,"_27449":71894,"_2949":121609},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3465":71896,"_30211":71894,"_5":30540,"_20923":121611,"_27449":121612,"_2949":121613},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3465":71897,"_30211":71894,"_5":30540,"_20923":121615,"_27449":121616,"_2949":121617},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3465":71898,"_30211":71894,"_5":30540,"_20923":121619,"_27449":121620,"_2949":121621},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3465":71899,"_30211":71894,"_5":30540,"_20923":121623,"_27449":121624,"_2949":121625},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3465":71900,"_30211":71894,"_5":30540,"_20923":121627,"_27449":121628,"_2949":121629},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3465":71901,"_30211":71894,"_5":30540,"_20923":121631,"_27449":121632,"_2949":121633},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3465":71902,"_30211":71894,"_5":30540,"_20923":121635,"_27449":121636,"_2949":121637},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3465":71903,"_30211":71894,"_5":30540,"_20923":121639,"_27449":121640,"_2949":121641},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3465":71904,"_30211":71894,"_5":30540,"_20923":121643,"_27449":121644,"_2949":121645},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3465":71905,"_30211":71894,"_5":30540,"_20923":121647,"_27449":121648,"_2949":121649},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3465":71906,"_30211":71894,"_5":30540,"_20923":121651,"_27449":121652,"_2949":121653},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3465":71907,"_30211":71894,"_5":30540,"_20923":121655,"_27449":121656,"_2949":121657},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3465":71908,"_30211":71894,"_20923":121659,"_5":14374,"_27449":71894,"_2949":121660},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3465":71909,"_30211":71894,"_20923":121662,"_5":14374,"_27449":71894,"_2949":121663},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3465":71910,"_30211":71894,"_20923":121665,"_5":14374,"_27449":121612,"_2949":121666},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3465":71911,"_30211":71894,"_20923":121668,"_5":14374,"_27449":121612,"_2949":121669},[],"entorno, como producción y preproducción;",{"_3465":71912,"_30211":71894,"_20923":121671,"_5":14374,"_27449":121612,"_2949":121672},[],"propietario o equipo operador;",{"_3465":71913,"_30211":71894,"_20923":121674,"_5":14374,"_27449":121612,"_2949":121675},[],"familia de dispositivos o proceso de fabricación;",{"_3465":71914,"_30211":71894,"_20923":121677,"_5":14374,"_27449":121612,"_2949":121678},[],"región o requisito regulatorio;",{"_3465":71915,"_30211":71894,"_20923":121680,"_5":14374,"_27449":121612,"_2949":121681},[],"motor criptográfico o política de clave;",{"_3465":71916,"_30211":71894,"_20923":121683,"_5":14374,"_27449":121612,"_2949":121684},[],"ventana de mantenimiento y ritmo de renovación.",{"_3465":71917,"_30211":71894,"_20923":121686,"_5":14374,"_27449":121612,"_2949":121687},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3465":71918,"_30211":71894,"_20923":121689,"_5":14374,"_27449":121612,"_2949":121690},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3465":71919,"_30211":71894,"_20923":121692,"_5":14374,"_27449":121616,"_2949":121693},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3465":71920,"_30211":71894,"_20923":121695,"_5":14374,"_27449":121616,"_2949":121696},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir; consulta la guía de CRL.",{"_3465":71921,"_30211":71894,"_20923":121698,"_5":14374,"_27449":121616,"_2949":121699},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3465":71922,"_30211":71894,"_20923":121701,"_5":14374,"_27449":121616,"_2949":121702},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3465":71923,"_30211":71894,"_20923":121704,"_5":14374,"_27449":121620,"_2949":121705},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3465":71924,"_30211":71894,"_20923":121707,"_5":14374,"_27449":121620,"_2949":121708},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3465":71925,"_30211":71894,"_20923":121710,"_5":14374,"_27449":121620,"_2949":121711},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3465":71926,"_30211":71894,"_20923":121713,"_5":14374,"_27449":121620,"_2949":121714},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3465":71927,"_30211":71894,"_20923":121716,"_5":14374,"_27449":121628,"_2949":121717},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3465":71928,"_30211":71894,"_20923":121719,"_5":14374,"_27449":121632,"_2949":121720},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3465":71929,"_30211":71894,"_20923":121722,"_5":14374,"_27449":121636,"_2949":121723},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3465":71930,"_30211":71894,"_20923":121725,"_5":14374,"_27449":121640,"_2949":121726},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3465":71931,"_30211":71894,"_20923":121728,"_5":14374,"_27449":121644,"_2949":121729},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3465":71932,"_30211":71894,"_20923":121731,"_5":14374,"_27449":121648,"_2949":121732},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3465":71933,"_30211":71894,"_20923":121734,"_5":14374,"_27449":121652,"_2949":121735},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3465":71934,"_30211":71894,"_20923":121737,"_5":14374,"_27449":121652,"_2949":121738},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3465":71935,"_30211":71894,"_20923":121740,"_5":14374,"_27449":121652,"_2949":121741},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3465":71936,"_30211":71894,"_20923":121743,"_5":14374,"_27449":121652,"_2949":121744},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3465":71937,"_30211":71894,"_20923":121746,"_5":14374,"_27449":121656,"_2949":121747},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3465":71938,"_30211":71894,"_20923":121749,"_5":14374,"_27449":121656,"_2949":121750},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3465":71939,"_30211":71894,"_20923":121752,"_5":14374,"_27449":121656,"_2949":121753},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3465":71940,"_30211":71894,"_20923":121755,"_5":14374,"_27449":121656,"_2949":121756},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3465":71941,"_30211":71894,"_20923":121758,"_5":14374,"_27449":121656,"_2949":121759},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3465":71942,"_30211":71894,"_20923":121761,"_5":14374,"_27449":121656,"_2949":121762},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3465":71943,"_30211":71894,"_20923":121764,"_5":14374,"_27449":121656,"_2949":121765},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3465":71944,"_30211":71944,"_5":14726,"_2949":121767,"_30543":121768,"_20923":121769,"_27449":71944},"Autoridades de certificación",[49241,117727,54721,121605],[],{"_3465":71945,"_30211":71944,"_20923":121771,"_5":14374,"_27449":71944,"_2949":121772},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3465":71946,"_30211":71944,"_5":30540,"_20923":121774,"_27449":121775,"_2949":121776},[],"/docs/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3465":71947,"_30211":71944,"_5":30540,"_20923":121778,"_27449":121779,"_2949":121780},[],"/docs/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3465":71948,"_30211":71944,"_5":30540,"_20923":121782,"_27449":121783,"_2949":116298},[],"/docs/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3465":71949,"_30211":71944,"_5":30540,"_20923":121785,"_27449":121786,"_2949":121787},[],"/docs/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3465":71950,"_30211":71944,"_5":30540,"_20923":121789,"_27449":121790,"_2949":121791},[],"/docs/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3465":71951,"_30211":71944,"_5":30540,"_20923":121793,"_27449":121794,"_2949":121795},[],"/docs/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3465":71952,"_30211":71944,"_5":30540,"_20923":121797,"_27449":121798,"_2949":121799},[],"/docs/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3465":71953,"_30211":71944,"_5":30540,"_20923":121801,"_27449":121802,"_2949":121803},[],"/docs/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3465":71954,"_30211":71944,"_5":30540,"_20923":121805,"_27449":121806,"_2949":121807},[],"/docs/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3465":71955,"_30211":71944,"_5":30540,"_20923":121809,"_27449":121810,"_2949":121811},[],"/docs/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3465":71956,"_30211":71944,"_5":30540,"_20923":121813,"_27449":121814,"_2949":121815},[],"/docs/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3465":71957,"_30211":71944,"_5":30540,"_20923":121817,"_27449":121818,"_2949":121819},[],"/docs/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3465":71958,"_30211":71944,"_5":30540,"_20923":121821,"_27449":121822,"_2949":121823},[],"/docs/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3465":71959,"_30211":71944,"_5":30540,"_20923":121825,"_27449":121826,"_2949":121827},[],"/docs/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3465":71960,"_30211":71944,"_5":30540,"_20923":121829,"_27449":121830,"_2949":121831},[],"/docs/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3465":71961,"_30211":71944,"_5":30540,"_20923":121833,"_27449":121834,"_2949":121835},[],"/docs/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3465":71962,"_30211":71944,"_5":30540,"_20923":121837,"_27449":121838,"_2949":121839},[],"/docs/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3465":71963,"_30211":71944,"_5":30540,"_20923":121841,"_27449":121842,"_2949":121843},[],"/docs/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3465":71964,"_30211":71944,"_5":30540,"_20923":121845,"_27449":121846,"_2949":121847},[],"/docs/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3465":71965,"_30211":71944,"_5":30540,"_20923":121849,"_27449":121850,"_2949":121851},[],"/docs/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3465":71966,"_30211":71944,"_5":30540,"_20923":121853,"_27449":121854,"_2949":121855},[],"/docs/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3465":71967,"_30211":71944,"_5":30540,"_20923":121857,"_27449":121858,"_2949":121859},[],"/docs/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3465":71968,"_30211":71944,"_5":30540,"_20923":121861,"_27449":121862,"_2949":121863},[],"/docs/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3465":71969,"_30211":71944,"_20923":121865,"_5":14374,"_27449":71944,"_2949":121866},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3465":71970,"_30211":71944,"_20923":121868,"_5":14374,"_27449":71944,"_2949":121869},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3465":71971,"_30211":71944,"_20923":121871,"_5":14374,"_27449":71944,"_2949":121872},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3465":71972,"_30211":71944,"_20923":121874,"_5":14374,"_27449":121775,"_2949":121875},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3465":71973,"_30211":71944,"_20923":121877,"_5":14374,"_27449":121775,"_2949":121878},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3465":71974,"_30211":71944,"_20923":121880,"_5":14374,"_27449":121775,"_2949":121881},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3465":71975,"_30211":71944,"_20923":121883,"_5":14374,"_27449":121775,"_2949":121884},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3465":71976,"_30211":71944,"_20923":121886,"_5":14374,"_27449":121775,"_2949":121887},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3465":71977,"_30211":71944,"_20923":121889,"_5":14374,"_27449":121783,"_2949":121890},[],"Decide si la CA será raíz o intermedia.",{"_3465":71978,"_30211":71944,"_20923":121892,"_5":14374,"_27449":121783,"_2949":121893},[],"Elige el motor que custodiará la clave.",{"_3465":71979,"_30211":71944,"_20923":121895,"_5":14374,"_27449":121783,"_2949":121896},[],"Define una validez superior a la de los certificados que emitirá.",{"_3465":71980,"_30211":71944,"_20923":121898,"_5":14374,"_27449":121783,"_2949":121899},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3465":71981,"_30211":71944,"_20923":121901,"_5":14374,"_27449":121786,"_2949":121902},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3465":71982,"_30211":71944,"_20923":121904,"_5":14374,"_27449":121790,"_2949":121905},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3465":71983,"_30211":71944,"_20923":121907,"_5":14374,"_27449":121790,"_2949":121908},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3465":71984,"_30211":71944,"_20923":121910,"_5":14374,"_27449":121794,"_2949":121911},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3465":71985,"_30211":71944,"_20923":121913,"_5":14374,"_27449":121798,"_2949":121914},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3465":71986,"_30211":71944,"_20923":121916,"_5":14374,"_27449":121798,"_2949":121917},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3465":71987,"_30211":71944,"_20923":121919,"_5":14374,"_27449":121798,"_2949":121920},[],"`ST`: estado o provincia.",{"_3465":71988,"_30211":71944,"_20923":121922,"_5":14374,"_27449":121798,"_2949":121923},[],"`L`: localidad.",{"_3465":71989,"_30211":71944,"_20923":121925,"_5":14374,"_27449":121798,"_2949":121926},[],"`O`: organización.",{"_3465":71990,"_30211":71944,"_20923":121928,"_5":14374,"_27449":121798,"_2949":121929},[],"`OU`: unidad organizativa.",{"_3465":71991,"_30211":71944,"_20923":121931,"_5":14374,"_27449":121798,"_2949":121932},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3465":71992,"_30211":71944,"_20923":121934,"_5":14374,"_27449":121802,"_2949":121935},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3465":71993,"_30211":71944,"_20923":121937,"_5":14374,"_27449":121802,"_2949":121938},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3465":71994,"_30211":71944,"_20923":121940,"_5":14374,"_27449":121806,"_2949":121941},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3465":71995,"_30211":71944,"_20923":121943,"_5":14374,"_27449":121806,"_2949":121944},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3465":71996,"_30211":71944,"_20923":121946,"_5":14374,"_27449":121810,"_2949":121947},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3465":71997,"_30211":71944,"_20923":121949,"_5":14374,"_27449":121810,"_2949":121950},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3465":71998,"_30211":71944,"_20923":121952,"_5":14374,"_27449":121814,"_2949":121953},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3465":71999,"_30211":71944,"_20923":121955,"_5":14374,"_27449":121814,"_2949":121956},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3465":72000,"_30211":71944,"_20923":121958,"_5":14374,"_27449":121814,"_2949":121959},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3465":72001,"_30211":71944,"_20923":121961,"_5":14374,"_27449":121818,"_2949":121962},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3465":72002,"_30211":71944,"_20923":121964,"_5":14374,"_27449":121822,"_2949":121965},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3465":72003,"_30211":71944,"_20923":121967,"_5":14374,"_27449":121822,"_2949":121968},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3465":72004,"_30211":71944,"_20923":121970,"_5":14374,"_27449":121826,"_2949":121971},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3465":72005,"_30211":71944,"_20923":121973,"_5":14374,"_27449":121830,"_2949":121974},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3465":72006,"_30211":71944,"_20923":121976,"_5":14374,"_27449":121830,"_2949":121977},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3465":72007,"_30211":71944,"_20923":121979,"_5":14374,"_27449":121834,"_2949":121980},[],"Abre una CA desde el inventario para consultar:",{"_3465":72008,"_30211":71944,"_20923":121982,"_5":14374,"_27449":121834,"_2949":121983},[],"Estado y periodo de validez.",{"_3465":72009,"_30211":71944,"_20923":121985,"_5":14374,"_27449":121834,"_2949":121986},[],"Certificado y cadena en formato PEM.",{"_3465":72010,"_30211":71944,"_20923":121988,"_5":14374,"_27449":121834,"_2949":121989},[],"Número de certificados activos, expirados y revocados.",{"_3465":72011,"_30211":71944,"_20923":121991,"_5":14374,"_27449":121834,"_2949":121992},[],"Certificados emitidos en **Issued Certificates**.",{"_3465":72012,"_30211":71944,"_20923":121994,"_5":14374,"_27449":121834,"_2949":121995},[],"CRL vinculada a la autoridad.",{"_3465":72013,"_30211":71944,"_20923":121997,"_5":14374,"_27449":121834,"_2949":121998},[],"Metadatos y motor criptográfico asociado.",{"_3465":72014,"_30211":71944,"_20923":122000,"_5":14374,"_27449":121834,"_2949":122001},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3465":72015,"_30211":71944,"_20923":122003,"_5":14374,"_27449":121838,"_2949":122004},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3465":72016,"_30211":71944,"_20923":122006,"_5":14374,"_27449":121838,"_2949":122007},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3465":72017,"_30211":71944,"_20923":122009,"_5":14374,"_27449":121838,"_2949":122010},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3465":72018,"_30211":71944,"_20923":122012,"_5":14374,"_27449":121838,"_2949":122013},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3465":72019,"_30211":71944,"_20923":122015,"_5":14374,"_27449":121842,"_2949":122016},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3465":72020,"_30211":71944,"_20923":122018,"_5":14374,"_27449":121846,"_2949":122019},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3465":72021,"_30211":71944,"_20923":122021,"_5":14374,"_27449":121850,"_2949":122022},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3465":72022,"_30211":71944,"_20923":122024,"_5":14374,"_27449":121854,"_2949":122025},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3465":72023,"_30211":71944,"_20923":122027,"_5":14374,"_27449":121858,"_2949":122028},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3465":72024,"_30211":71944,"_20923":122030,"_5":14374,"_27449":121862,"_2949":122031},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3465":72025,"_30211":71944,"_20923":122033,"_5":14374,"_27449":121862,"_2949":122034},[],"Los ajustes de CRL de la CA se conservan como `ARCHIVED`. La última CRL sigue sirviéndose, pero una vez desaparecida la CA nada la regenera, así que ajusta antes su validez y su firmante. Los ajustes archivados pueden borrarse con `DELETE /v1/crl-settings/{ca-id}` o desde la página **Verification Authorities** de la consola. Al borrarlos, la CRL deja de servirse y la acción no puede deshacerse; consulta la advertencia en CRL. La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3465":72026,"_30211":71944,"_20923":122036,"_5":14374,"_27449":121862,"_2949":122037},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: hasta que se borren esos ajustes, su última CRL sigue sirviéndose en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; los ajustes archivados dejan de poder editarse (consulta CRL).",{"_3465":72027,"_30211":72027,"_5":14726,"_2949":122039,"_30543":122040,"_20923":122041,"_27449":72027},"Perfiles de certificado",[49241,117727,54721,121605],[],{"_3465":72028,"_30211":72027,"_20923":122043,"_5":14374,"_27449":72027,"_2949":122044},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3465":72029,"_30211":72027,"_5":30540,"_20923":122046,"_27449":122047,"_2949":122048},[],"/docs/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3465":72030,"_30211":72027,"_5":30540,"_20923":122050,"_27449":122051,"_2949":122052},[],"/docs/es/platform/pki/certificate-profiles#validez","Validez",{"_3465":72031,"_30211":72027,"_5":30540,"_20923":122054,"_27449":122055,"_2949":122056},[],"/docs/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3465":72032,"_30211":72027,"_5":30540,"_20923":122058,"_27449":122059,"_2949":122060},[],"/docs/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3465":72033,"_30211":72027,"_5":30540,"_20923":122062,"_27449":122063,"_2949":122064},[],"/docs/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3465":72034,"_30211":72027,"_5":30540,"_20923":122066,"_27449":122067,"_2949":122068},[],"/docs/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3465":72035,"_30211":72027,"_5":30540,"_20923":122070,"_27449":122071,"_2949":122072},[],"/docs/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3465":72036,"_30211":72027,"_5":30540,"_20923":122074,"_27449":122075,"_2949":122076},[],"/docs/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3465":72037,"_30211":72027,"_5":30540,"_20923":122078,"_27449":122079,"_2949":122080},[],"/docs/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3465":72038,"_30211":72027,"_5":30540,"_20923":122082,"_27449":122083,"_2949":122084},[],"/docs/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3465":72039,"_30211":72027,"_5":30540,"_20923":122086,"_27449":122087,"_2949":122088},[],"/docs/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3465":72040,"_30211":72027,"_5":30540,"_20923":122090,"_27449":122091,"_2949":122092},[],"/docs/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3465":72041,"_30211":72027,"_5":30540,"_20923":122094,"_27449":122095,"_2949":122096},[],"/docs/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3465":72042,"_30211":72027,"_5":30540,"_20923":122098,"_27449":122099,"_2949":122100},[],"/docs/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3465":72043,"_30211":72027,"_5":30540,"_20923":122102,"_27449":122103,"_2949":122104},[],"/docs/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3465":72044,"_30211":72027,"_5":30540,"_20923":122106,"_27449":122107,"_2949":122108},[],"/docs/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3465":72045,"_30211":72027,"_20923":122110,"_5":14374,"_27449":72027,"_2949":122111},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3465":72046,"_30211":72027,"_20923":122113,"_5":14374,"_27449":72027,"_2949":122114},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3465":72047,"_30211":72027,"_20923":122116,"_5":14374,"_27449":122051,"_2949":122117},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3465":72048,"_30211":72027,"_20923":122119,"_5":14374,"_27449":122051,"_2949":122120},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3465":72049,"_30211":72027,"_20923":122122,"_5":14374,"_27449":122055,"_2949":122123},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3465":72050,"_30211":72027,"_20923":122125,"_5":14374,"_27449":122059,"_2949":122126},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3465":72051,"_30211":72027,"_20923":122128,"_5":14374,"_27449":122059,"_2949":122129},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3465":72052,"_30211":72027,"_20923":122131,"_5":14374,"_27449":122059,"_2949":122132},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3465":72053,"_30211":72027,"_20923":122134,"_5":14374,"_27449":122063,"_2949":122135},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3465":72054,"_30211":72027,"_20923":122137,"_5":14374,"_27449":122067,"_2949":122138},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3465":72055,"_30211":72027,"_20923":122140,"_5":14374,"_27449":122067,"_2949":122141},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3465":72056,"_30211":72027,"_20923":122143,"_5":14374,"_27449":122071,"_2949":122144},[],"La aplicación criptográfica puede:",{"_3465":72057,"_30211":72027,"_20923":122146,"_5":14374,"_27449":122071,"_2949":122147},[],"permitir o bloquear claves RSA;",{"_3465":72058,"_30211":72027,"_20923":122149,"_5":14374,"_27449":122071,"_2949":122150},[],"limitar los tamaños RSA admitidos;",{"_3465":72059,"_30211":72027,"_20923":122152,"_5":14374,"_27449":122071,"_2949":122153},[],"permitir o bloquear claves ECDSA;",{"_3465":72060,"_30211":72027,"_20923":122155,"_5":14374,"_27449":122071,"_2949":122156},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3465":72061,"_30211":72027,"_20923":122158,"_5":14374,"_27449":122071,"_2949":122159},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3465":72062,"_30211":72027,"_20923":122161,"_5":14374,"_27449":122075,"_2949":122162},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3465":72063,"_30211":72027,"_20923":122164,"_5":14374,"_27449":122075,"_2949":117487},[],{"_3465":72064,"_30211":72027,"_20923":122166,"_5":14374,"_27449":122075,"_2949":122167},[],"Primera opción",{"_3465":72065,"_30211":72027,"_20923":122169,"_5":14374,"_27449":122075,"_2949":122170},[],"Segunda opción",{"_3465":72066,"_30211":72027,"_20923":122172,"_5":14374,"_27449":122075,"_2949":122173},[],"Si no hay ninguna",{"_3465":72067,"_30211":72027,"_20923":122175,"_5":14374,"_27449":122075,"_2949":122176},[],"Firma directa con una CA",{"_3465":72068,"_30211":72027,"_20923":122178,"_5":14374,"_27449":122075,"_2949":122179},[],"`issuance_profile` incluido en la solicitud",{"_3465":72069,"_30211":72027,"_20923":122181,"_5":14374,"_27449":122075,"_2949":122182},[],"`issuance_profile_id` de la solicitud",{"_3465":72070,"_30211":72027,"_20923":122184,"_5":14374,"_27449":122075,"_2949":122185},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3465":72071,"_30211":72027,"_20923":122187,"_5":14374,"_27449":122075,"_2949":122188},[],"Emisión mediante DMS",{"_3465":72072,"_30211":72027,"_20923":122190,"_5":14374,"_27449":122075,"_2949":55308},[],{"_3465":72073,"_30211":72027,"_20923":122192,"_5":14374,"_27449":122075,"_2949":122193},[],"`settings.issuance_profile` incluido en el DMS",{"_3465":72074,"_30211":72027,"_20923":122195,"_5":14374,"_27449":122075,"_2949":122196},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3465":72075,"_30211":72027,"_20923":122198,"_5":14374,"_27449":122075,"_2949":122199},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3465":72076,"_30211":72027,"_20923":122201,"_5":14374,"_27449":122075,"_2949":122202},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3465":72077,"_30211":72027,"_20923":122204,"_5":14374,"_27449":122083,"_2949":122205},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3465":72078,"_30211":72027,"_20923":122207,"_5":14374,"_27449":122087,"_2949":122208},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3465":72079,"_30211":72027,"_20923":122210,"_5":14374,"_27449":122091,"_2949":122211},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3465":72080,"_30211":72027,"_20923":122213,"_5":14374,"_27449":122095,"_2949":122214},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3465":72081,"_30211":72027,"_20923":122216,"_5":14374,"_27449":122099,"_2949":122217},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3465":72082,"_30211":72027,"_20923":122219,"_5":14374,"_27449":122099,"_2949":122220},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3465":72083,"_30211":72027,"_20923":122222,"_5":14374,"_27449":122103,"_2949":122223},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3465":72084,"_30211":72027,"_20923":122225,"_5":14374,"_27449":122103,"_2949":122226},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3465":72085,"_30211":72027,"_20923":122228,"_5":14374,"_27449":122103,"_2949":122229},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3465":72086,"_30211":72027,"_20923":122231,"_5":14374,"_27449":122103,"_2949":122232},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3465":72087,"_30211":72027,"_20923":122234,"_5":14374,"_27449":122107,"_2949":122235},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3465":72088,"_30211":72027,"_20923":122237,"_5":14374,"_27449":122107,"_2949":122238},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3465":72089,"_30211":72089,"_5":14726,"_2949":122240,"_30543":122241,"_20923":122243,"_27449":72089},"Validación de certificados",[49241,117727,54721,122242],"Validación",[],{"_3465":72090,"_30211":72089,"_20923":122245,"_5":14374,"_27449":72089,"_2949":122246},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3465":72091,"_30211":72089,"_5":30540,"_20923":122248,"_27449":122249,"_2949":122250},[],"/docs/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3465":72092,"_30211":72089,"_5":30540,"_20923":122252,"_27449":122253,"_2949":122254},[],"/docs/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3465":72093,"_30211":72089,"_5":30540,"_20923":122256,"_27449":122257,"_2949":122258},[],"/docs/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3465":72094,"_30211":72089,"_20923":122260,"_5":14374,"_27449":72089,"_2949":122261},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3465":72095,"_30211":72089,"_20923":122263,"_5":14374,"_27449":122249,"_2949":122264},[],"Verifica estos criterios juntos:",{"_3465":72096,"_30211":72089,"_20923":122266,"_5":14374,"_27449":122249,"_2949":121234},[],{"_3465":72097,"_30211":72089,"_20923":122268,"_5":14374,"_27449":122249,"_2949":122269},[],"Resultado necesario",{"_3465":72098,"_30211":72089,"_20923":122271,"_5":14374,"_27449":122249,"_2949":122272},[],"Cadena y firma",{"_3465":72099,"_30211":72089,"_20923":122274,"_5":14374,"_27449":122249,"_2949":122275},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3465":72100,"_30211":72089,"_20923":122277,"_5":14374,"_27449":122249,"_2949":122278},[],"Fechas",{"_3465":72101,"_30211":72089,"_20923":122280,"_5":14374,"_27449":122249,"_2949":122281},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3465":72102,"_30211":72089,"_20923":122283,"_5":14374,"_27449":122249,"_2949":117397},[],{"_3465":72103,"_30211":72089,"_20923":122285,"_5":14374,"_27449":122249,"_2949":122286},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3465":72104,"_30211":72089,"_20923":122288,"_5":14374,"_27449":122249,"_2949":122289},[],"Uso",{"_3465":72105,"_30211":72089,"_20923":122291,"_5":14374,"_27449":122249,"_2949":122292},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3465":72106,"_30211":72089,"_20923":122294,"_5":14374,"_27449":122249,"_2949":122295},[],"Revocación",{"_3465":72107,"_30211":72089,"_20923":122297,"_5":14374,"_27449":122249,"_2949":122298},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3465":72108,"_30211":72089,"_20923":122300,"_5":14374,"_27449":122249,"_2949":122301},[],"Autorización",{"_3465":72109,"_30211":72089,"_20923":122303,"_5":14374,"_27449":122249,"_2949":122304},[],"La aplicación permite la acción a esa identidad.",{"_3465":72110,"_30211":72089,"_20923":122306,"_5":14374,"_27449":122249,"_2949":122307},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3465":72111,"_30211":72089,"_20923":122309,"_5":14374,"_27449":122253,"_2949":122310},[],"Mecanismo",{"_3465":72112,"_30211":72089,"_20923":122312,"_5":14374,"_27449":122253,"_2949":122313},[],"Cuándo utilizarlo",{"_3465":72113,"_30211":72089,"_20923":122315,"_5":14374,"_27449":122253,"_2949":122316},[],"Qué debes mantener",{"_3465":72114,"_30211":72089,"_20923":122318,"_5":14374,"_27449":122253,"_2949":55436},[],{"_3465":72115,"_30211":72089,"_20923":122320,"_5":14374,"_27449":122253,"_2949":122321},[],"Consulta del estado de un certificado concreto.",{"_3465":72116,"_30211":72089,"_20923":122323,"_5":14374,"_27449":122253,"_2949":122324},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3465":72117,"_30211":72089,"_20923":122326,"_5":14374,"_27449":122253,"_2949":55445},[],{"_3465":72118,"_30211":72089,"_20923":122328,"_5":14374,"_27449":122253,"_2949":122329},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3465":72119,"_30211":72089,"_20923":122331,"_5":14374,"_27449":122253,"_2949":122332},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3465":72120,"_30211":72089,"_20923":122334,"_5":14374,"_27449":122253,"_2949":122335},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3465":72121,"_30211":72089,"_20923":122337,"_5":14374,"_27449":122253,"_2949":122338},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3465":72122,"_30211":72089,"_20923":122340,"_5":14374,"_27449":122257,"_2949":122341},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3465":72123,"_30211":72089,"_20923":122343,"_5":14374,"_27449":122257,"_2949":122344},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3465":72124,"_30211":72089,"_20923":122346,"_5":14374,"_27449":122257,"_2949":122347},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3465":72125,"_30211":72089,"_20923":122349,"_5":14374,"_27449":122257,"_2949":122350},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3465":72126,"_30211":72089,"_20923":122352,"_5":14374,"_27449":122257,"_2949":122353},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3465":72127,"_30211":72089,"_20923":122355,"_5":14374,"_27449":122257,"_2949":122356},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3465":72128,"_30211":72089,"_20923":122358,"_5":14374,"_27449":122257,"_2949":122359},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3465":72129,"_30211":72089,"_20923":122361,"_5":14374,"_27449":122257,"_2949":122362},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3465":72130,"_30211":72089,"_20923":122364,"_5":14374,"_27449":122257,"_2949":122365},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3465":72131,"_30211":72131,"_5":14726,"_2949":122367,"_30543":122368,"_20923":122369,"_27449":72131},"Certificados",[49241,117727,54721,121605],[],{"_3465":72132,"_30211":72131,"_20923":122371,"_5":14374,"_27449":72131,"_2949":122372},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3465":72133,"_30211":72131,"_5":30540,"_20923":122374,"_27449":122375,"_2949":122376},[],"/docs/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3465":72134,"_30211":72131,"_5":30540,"_20923":122378,"_27449":122379,"_2949":122380},[],"/docs/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3465":72135,"_30211":72131,"_5":30540,"_20923":122382,"_27449":122383,"_2949":122384},[],"/docs/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3465":72136,"_30211":72131,"_5":30540,"_20923":122386,"_27449":122387,"_2949":122388},[],"/docs/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3465":72137,"_30211":72131,"_5":30540,"_20923":122390,"_27449":122391,"_2949":122392},[],"/docs/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3465":72138,"_30211":72131,"_5":30540,"_20923":122394,"_27449":122395,"_2949":122396},[],"/docs/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3465":72139,"_30211":72131,"_5":30540,"_20923":122398,"_27449":122399,"_2949":122400},[],"/docs/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3465":72140,"_30211":72131,"_5":30540,"_20923":122402,"_27449":122403,"_2949":122404},[],"/docs/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3465":72141,"_30211":72131,"_5":30540,"_20923":122406,"_27449":122407,"_2949":122408},[],"/docs/es/platform/pki/certificates#continúa","Continúa",{"_3465":72142,"_30211":72131,"_20923":122410,"_5":14374,"_27449":72131,"_2949":122411},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3465":72143,"_30211":72131,"_20923":122413,"_5":14374,"_27449":122375,"_2949":122414},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3465":72144,"_30211":72131,"_20923":122416,"_5":14374,"_27449":122375,"_2949":122417},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3465":72145,"_30211":72131,"_20923":122419,"_5":14374,"_27449":122375,"_2949":122420},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3465":72146,"_30211":72131,"_20923":122422,"_5":14374,"_27449":122375,"_2949":122423},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3465":72147,"_30211":72131,"_20923":122425,"_5":14374,"_27449":122375,"_2949":122426},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3465":72148,"_30211":72131,"_20923":122428,"_5":14374,"_27449":122375,"_2949":122429},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3465":72149,"_30211":72131,"_20923":122431,"_5":14374,"_27449":122375,"_2949":122432},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3465":72150,"_30211":72131,"_20923":122434,"_5":14374,"_27449":122379,"_2949":122435},[],"Descarga el PEM e inspecciónalo:",{"_3465":72151,"_30211":72131,"_20923":122437,"_5":14374,"_27449":122379,"_2949":122438},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3465":72152,"_30211":72131,"_20923":122440,"_5":14374,"_27449":122383,"_2949":122441},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3465":72153,"_30211":72131,"_20923":122443,"_5":14374,"_27449":122383,"_2949":122444},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3465":72154,"_30211":72131,"_20923":122446,"_5":14374,"_27449":122383,"_2949":122447},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3465":72155,"_30211":72131,"_20923":122449,"_5":14374,"_27449":122383,"_2949":122450},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3465":72156,"_30211":72131,"_20923":122452,"_5":14374,"_27449":122383,"_2949":122453},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3465":72157,"_30211":72131,"_20923":122455,"_5":14374,"_27449":122383,"_2949":122456},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3465":72158,"_30211":72131,"_20923":122458,"_5":14374,"_27449":122383,"_2949":122459},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3465":72159,"_30211":72131,"_20923":122461,"_5":14374,"_27449":122387,"_2949":122462},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3465":72160,"_30211":72131,"_20923":122464,"_5":14374,"_27449":122391,"_2949":122465},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3465":72161,"_30211":72131,"_20923":122467,"_5":14374,"_27449":122395,"_2949":122468},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3465":72162,"_30211":72131,"_20923":122470,"_5":14374,"_27449":122399,"_2949":122471},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3465":72163,"_30211":72131,"_20923":122473,"_5":14374,"_27449":122399,"_2949":122474},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3465":72164,"_30211":72131,"_20923":122476,"_5":14374,"_27449":122399,"_2949":122477},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3465":72165,"_30211":72131,"_20923":122479,"_5":14374,"_27449":122403,"_2949":122480},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3465":72166,"_30211":72131,"_20923":122482,"_5":14374,"_27449":122403,"_2949":122483},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3465":72167,"_30211":72131,"_20923":122485,"_5":14374,"_27449":122403,"_2949":122486},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3465":72168,"_30211":72131,"_20923":122488,"_5":14374,"_27449":122407,"_2949":122489},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3465":72169,"_30211":72131,"_20923":122491,"_5":14374,"_27449":122407,"_2949":122492},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3465":72170,"_30211":72170,"_5":14726,"_2949":122494,"_30543":122495,"_20923":122497,"_27449":72170},"Ciclo de vida de un certificado",[49241,117727,54721,122496],"Conceptos",[],{"_3465":72171,"_30211":72170,"_20923":122499,"_5":14374,"_27449":72170,"_2949":122500},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3465":72172,"_30211":72170,"_5":30540,"_20923":122502,"_27449":122503,"_2949":122504},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3465":72173,"_30211":72170,"_5":30540,"_20923":122506,"_27449":122507,"_2949":122508},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3465":72174,"_30211":72170,"_5":30540,"_20923":122510,"_27449":122511,"_2949":122512},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3465":72175,"_30211":72170,"_5":30540,"_20923":122514,"_27449":122515,"_2949":122516},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3465":72176,"_30211":72170,"_5":30540,"_20923":122518,"_27449":122519,"_2949":122520},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3465":72177,"_30211":72170,"_5":30540,"_20923":122522,"_27449":122523,"_2949":122524},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3465":72178,"_30211":72170,"_5":30540,"_20923":122526,"_27449":122527,"_2949":120228},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3465":72179,"_30211":72170,"_5":30540,"_20923":122529,"_27449":122530,"_2949":122531},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3465":72180,"_30211":72170,"_5":30540,"_20923":122533,"_27449":122534,"_2949":122535},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3465":72181,"_30211":72170,"_5":30540,"_20923":122537,"_27449":122538,"_2949":122539},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3465":72182,"_30211":72170,"_20923":122541,"_5":14374,"_27449":72170,"_2949":122542},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3465":72183,"_30211":72170,"_20923":122544,"_5":14374,"_27449":122507,"_2949":122545},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3465":72184,"_30211":72170,"_20923":122547,"_5":14374,"_27449":122511,"_2949":122548},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3465":72185,"_30211":72170,"_20923":122550,"_5":14374,"_27449":122515,"_2949":122551},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3465":72186,"_30211":72170,"_20923":122553,"_5":14374,"_27449":122519,"_2949":122554},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3465":72187,"_30211":72170,"_20923":122556,"_5":14374,"_27449":122523,"_2949":122557},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3465":72188,"_30211":72170,"_20923":122559,"_5":14374,"_27449":122527,"_2949":122560},[],"Lamassu persiste cuatro estados X.509:",{"_3465":72189,"_30211":72170,"_20923":122562,"_5":14374,"_27449":122527,"_2949":122563},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3465":72190,"_30211":72170,"_20923":122565,"_5":14374,"_27449":122527,"_2949":122566},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3465":72191,"_30211":72170,"_20923":122568,"_5":14374,"_27449":122527,"_2949":122569},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3465":72192,"_30211":72170,"_20923":122571,"_5":14374,"_27449":122527,"_2949":122572},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3465":72193,"_30211":72170,"_20923":122574,"_5":14374,"_27449":122527,"_2949":122575},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3465":72194,"_30211":72170,"_20923":122577,"_5":14374,"_27449":122530,"_2949":122578},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3465":72195,"_30211":72170,"_20923":122580,"_5":14374,"_27449":122530,"_2949":122581},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3465":72196,"_30211":72170,"_20923":122583,"_5":14374,"_27449":122530,"_2949":122584},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3465":72197,"_30211":72170,"_20923":122586,"_5":14374,"_27449":122534,"_2949":122587},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3465":72198,"_30211":72170,"_20923":122589,"_5":14374,"_27449":122534,"_2949":122590},[],"Antes de confirmar:",{"_3465":72199,"_30211":72170,"_20923":122592,"_5":14374,"_27449":122534,"_2949":122593},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3465":72200,"_30211":72170,"_20923":122595,"_5":14374,"_27449":122534,"_2949":122596},[],"Distribuye la nueva cadena de confianza.",{"_3465":72201,"_30211":72170,"_20923":122598,"_5":14374,"_27449":122534,"_2949":122599},[],"Reemite las identidades necesarias.",{"_3465":72202,"_30211":72170,"_20923":122601,"_5":14374,"_27449":122534,"_2949":122602},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3465":72203,"_30211":72170,"_20923":122604,"_5":14374,"_27449":122534,"_2949":122605},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3465":72204,"_30211":72170,"_20923":122607,"_5":14374,"_27449":122534,"_2949":122608},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3465":72205,"_30211":72170,"_20923":122610,"_5":14374,"_27449":122538,"_2949":122611},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3465":72206,"_30211":72170,"_20923":122613,"_5":14374,"_27449":122538,"_2949":122614},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3465":72207,"_30211":72170,"_20923":122616,"_5":14374,"_27449":122538,"_2949":122617},[],"Cambios de estado y razones de revocación.",{"_3465":72208,"_30211":72170,"_20923":122619,"_5":14374,"_27449":122538,"_2949":122620},[],"Publicación y vigencia de OCSP y CRLs.",{"_3465":72209,"_30211":72170,"_20923":122622,"_5":14374,"_27449":122538,"_2949":122623},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3465":72210,"_30211":72170,"_20923":122625,"_5":14374,"_27449":122538,"_2949":122626},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3465":72211,"_30211":72211,"_5":14726,"_2949":122628,"_30543":122629,"_20923":122630,"_27449":72211},"Modelo de confianza",[49241,117727,54721,122496],[],{"_3465":72212,"_30211":72211,"_20923":122632,"_5":14374,"_27449":72211,"_2949":122633},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3465":72213,"_30211":72211,"_5":30540,"_20923":122635,"_27449":122636,"_2949":122637},[],"/docs/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3465":72214,"_30211":72211,"_5":30540,"_20923":122639,"_27449":122640,"_2949":122641},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3465":72215,"_30211":72211,"_5":30540,"_20923":122643,"_27449":122644,"_2949":122645},[],"/docs/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3465":72216,"_30211":72211,"_5":30540,"_20923":122647,"_27449":122648,"_2949":122649},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3465":72217,"_30211":72211,"_5":30540,"_20923":122651,"_27449":122652,"_2949":122653},[],"/docs/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3465":72218,"_30211":72211,"_5":30540,"_20923":122655,"_27449":122656,"_2949":122657},[],"/docs/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3465":72219,"_30211":72211,"_5":30540,"_20923":122659,"_27449":122660,"_2949":122661},[],"/docs/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3465":72220,"_30211":72211,"_5":30540,"_20923":122663,"_27449":122664,"_2949":122665},[],"/docs/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3465":72221,"_30211":72211,"_5":30540,"_20923":122667,"_27449":122668,"_2949":122669},[],"/docs/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3465":72222,"_30211":72211,"_5":30540,"_20923":122671,"_27449":122672,"_2949":122673},[],"/docs/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3465":72223,"_30211":72211,"_20923":122675,"_5":14374,"_27449":72211,"_2949":122676},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3465":72224,"_30211":72211,"_20923":122678,"_5":14374,"_27449":122640,"_2949":122679},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3465":72225,"_30211":72211,"_20923":122681,"_5":14374,"_27449":122644,"_2949":122682},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3465":72226,"_30211":72211,"_20923":122684,"_5":14374,"_27449":122648,"_2949":122685},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3465":72227,"_30211":72211,"_20923":122687,"_5":14374,"_27449":122652,"_2949":122688},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3465":72228,"_30211":72211,"_20923":122690,"_5":14374,"_27449":122656,"_2949":122691},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3465":72229,"_30211":72211,"_20923":122693,"_5":14374,"_27449":122656,"_2949":122694},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3465":72230,"_30211":72211,"_20923":122696,"_5":14374,"_27449":122656,"_2949":122697},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3465":72231,"_30211":72211,"_20923":122699,"_5":14374,"_27449":122656,"_2949":122700},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3465":72232,"_30211":72211,"_20923":122702,"_5":14374,"_27449":122656,"_2949":122703},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3465":72233,"_30211":72211,"_20923":122705,"_5":14374,"_27449":122656,"_2949":122706},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3465":72234,"_30211":72211,"_20923":122708,"_5":14374,"_27449":122660,"_2949":122709},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3465":72235,"_30211":72211,"_20923":122711,"_5":14374,"_27449":122660,"_2949":122712},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3465":72236,"_30211":72211,"_20923":122714,"_5":14374,"_27449":122660,"_2949":122715},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3465":72237,"_30211":72211,"_20923":122717,"_5":14374,"_27449":122660,"_2949":122718},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3465":72238,"_30211":72211,"_20923":122720,"_5":14374,"_27449":122660,"_2949":122721},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3465":72239,"_30211":72211,"_20923":122723,"_5":14374,"_27449":122664,"_2949":122724},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3465":72240,"_30211":72211,"_20923":122726,"_5":14374,"_27449":122664,"_2949":122727},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3465":72241,"_30211":72211,"_20923":122729,"_5":14374,"_27449":122664,"_2949":122730},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3465":72242,"_30211":72211,"_20923":122732,"_5":14374,"_27449":122664,"_2949":122733},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3465":72243,"_30211":72211,"_20923":122735,"_5":14374,"_27449":122664,"_2949":122736},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3465":72244,"_30211":72211,"_20923":122738,"_5":14374,"_27449":122664,"_2949":122739},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3465":72245,"_30211":72211,"_20923":122741,"_5":14374,"_27449":122664,"_2949":122742},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3465":72246,"_30211":72211,"_20923":122744,"_5":14374,"_27449":122668,"_2949":122745},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3465":72247,"_30211":72211,"_20923":122747,"_5":14374,"_27449":122672,"_2949":122748},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3465":72248,"_30211":72211,"_20923":122750,"_5":14374,"_27449":122672,"_2949":122751},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3465":72249,"_30211":72211,"_20923":122753,"_5":14374,"_27449":122672,"_2949":122754},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3465":72250,"_30211":72211,"_20923":122756,"_5":14374,"_27449":122672,"_2949":122757},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3465":72251,"_30211":72211,"_20923":122759,"_5":14374,"_27449":122672,"_2949":122760},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3465":72252,"_30211":72211,"_20923":122762,"_5":14374,"_27449":122672,"_2949":122763},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3465":72253,"_30211":72211,"_20923":122765,"_5":14374,"_27449":122672,"_2949":122766},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3465":72254,"_30211":72254,"_5":14726,"_2949":122768,"_30543":122769,"_20923":122770,"_27449":72254},"Listas de revocación (CRL)",[49241,117727,54721,122242],[],{"_3465":72255,"_30211":72254,"_20923":122772,"_5":14374,"_27449":72254,"_2949":122773},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3465":72256,"_30211":72254,"_5":30540,"_20923":122775,"_27449":122776,"_2949":122777},[],"/docs/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3465":72257,"_30211":72254,"_5":30540,"_20923":122779,"_27449":122780,"_2949":122781},[],"/docs/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3465":72258,"_30211":72254,"_5":30540,"_20923":122783,"_27449":122784,"_2949":122785},[],"/docs/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3465":72259,"_30211":72254,"_5":30540,"_20923":122787,"_27449":122788,"_2949":122789},[],"/docs/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3465":72260,"_30211":72254,"_5":30540,"_20923":122791,"_27449":122792,"_2949":122793},[],"/docs/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3465":72261,"_30211":72254,"_5":30540,"_20923":122795,"_27449":122796,"_2949":122797},[],"/docs/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3465":72262,"_30211":72254,"_5":30540,"_20923":122799,"_27449":122800,"_2949":122801},[],"/docs/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3465":72263,"_30211":72254,"_5":30540,"_20923":122803,"_27449":122804,"_2949":122805},[],"/docs/es/platform/pki/crl#referencias","Referencias",{"_3465":72264,"_30211":72254,"_20923":122807,"_5":14374,"_27449":72254,"_2949":122808},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3465":72265,"_30211":72254,"_20923":122810,"_5":14374,"_27449":122776,"_2949":122811},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3465":72266,"_30211":72254,"_20923":122813,"_5":14374,"_27449":122776,"_2949":122814},[],"Campo",{"_3465":72267,"_30211":72254,"_20923":122816,"_5":14374,"_27449":122776,"_2949":119268},[],{"_3465":72268,"_30211":72254,"_20923":122818,"_5":14374,"_27449":122776,"_2949":55939},[],{"_3465":72269,"_30211":72254,"_20923":122820,"_5":14374,"_27449":122776,"_2949":122821},[],"ID de la CA a la que pertenecen los ajustes.",{"_3465":72270,"_30211":72254,"_20923":122823,"_5":14374,"_27449":122776,"_2949":55945},[],{"_3465":72271,"_30211":72254,"_20923":122825,"_5":14374,"_27449":122776,"_2949":122826},[],"Los ajustes `ACTIVE` generan CRLs. Los `FINAL` pertenecen a una CA que fue revocada o ha expirado: su última CRL, si la hay, se publica y no se genera ninguna nueva. Los `ARCHIVED` pertenecen a una CA eliminada: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3465":72272,"_30211":72254,"_20923":122828,"_5":14374,"_27449":122776,"_2949":55951},[],{"_3465":72273,"_30211":72254,"_20923":122830,"_5":14374,"_27449":122776,"_2949":122831},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3465":72274,"_30211":72254,"_20923":122833,"_5":14374,"_27449":122776,"_2949":55957},[],{"_3465":72275,"_30211":72254,"_20923":122835,"_5":14374,"_27449":122776,"_2949":122836},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3465":72276,"_30211":72254,"_20923":122838,"_5":14374,"_27449":122776,"_2949":122839},[],"Campo de `crl_options`",{"_3465":72277,"_30211":72254,"_20923":122841,"_5":14374,"_27449":122776,"_2949":119268},[],{"_3465":72278,"_30211":72254,"_20923":122843,"_5":14374,"_27449":122776,"_2949":122844},[],"Valor inicial",{"_3465":72279,"_30211":72254,"_20923":122846,"_5":14374,"_27449":122776,"_2949":55971},[],{"_3465":72280,"_30211":72254,"_20923":122848,"_5":14374,"_27449":122776,"_2949":122849},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3465":72281,"_30211":72254,"_20923":122851,"_5":14374,"_27449":122776,"_2949":122852},[],"7 días.",{"_3465":72282,"_30211":72254,"_20923":122854,"_5":14374,"_27449":122776,"_2949":55980},[],{"_3465":72283,"_30211":72254,"_20923":122856,"_5":14374,"_27449":122776,"_2949":122857},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3465":72284,"_30211":72254,"_20923":122859,"_5":14374,"_27449":122776,"_2949":122860},[],"6 días y 23 horas.",{"_3465":72285,"_30211":72254,"_20923":122862,"_5":14374,"_27449":122776,"_2949":55989},[],{"_3465":72286,"_30211":72254,"_20923":122864,"_5":14374,"_27449":122776,"_2949":122865},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3465":72287,"_30211":72254,"_20923":122867,"_5":14374,"_27449":122776,"_2949":55995},[],{"_3465":72288,"_30211":72254,"_20923":122869,"_5":14374,"_27449":122776,"_2949":55998},[],{"_3465":72289,"_30211":72254,"_20923":122871,"_5":14374,"_27449":122776,"_2949":122872},[],"Número de serie del certificado existente que firma la CRL.",{"_3465":72290,"_30211":72254,"_20923":122874,"_5":14374,"_27449":122776,"_2949":122875},[],"Número de serie del certificado actual de la CA.",{"_3465":72291,"_30211":72254,"_20923":122877,"_5":14374,"_27449":122776,"_2949":122878},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3465":72292,"_30211":72254,"_20923":122880,"_5":14374,"_27449":122776,"_2949":122881},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3465":72293,"_30211":72254,"_20923":122883,"_5":14374,"_27449":122776,"_2949":122884},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3465":72294,"_30211":72254,"_20923":122886,"_5":14374,"_27449":122776,"_2949":122887},[],"Los ajustes cuyo `status` es `FINAL` o `ARCHIVED` son de solo lectura: cualquier `PUT` devuelve 409. Eliminar una CA conserva sus ajustes de CRL:",{"_3465":72295,"_30211":72254,"_20923":122889,"_5":14374,"_27449":122776,"_2949":122890},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera.",{"_3465":72296,"_30211":72254,"_20923":122892,"_5":14374,"_27449":122776,"_2949":122893},[],"Los ajustes `ARCHIVED` de una CA eliminada pueden borrarse, con `DELETE` o desde la página Verification Authorities de la consola. Esa CRL deja de servirse — quien compruebe sus certificados contra ella dejará de encontrarla —, mientras que las CRLs ya publicadas permanecen en el bucket. La acción no puede deshacerse.",{"_3465":72297,"_30211":72254,"_20923":122895,"_5":14374,"_27449":122776,"_2949":122896},[],"Ajusta validez y firmante antes de eliminar una CA.",{"_3465":72298,"_30211":72254,"_20923":122898,"_5":14374,"_27449":122776,"_2949":122899},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3465":72299,"_30211":72254,"_20923":122901,"_5":14374,"_27449":122776,"_2949":122902},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3465":72300,"_30211":72254,"_20923":122904,"_5":14374,"_27449":122776,"_2949":122905},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3465":72301,"_30211":72254,"_20923":122907,"_5":14374,"_27449":122780,"_2949":122908},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3465":72302,"_30211":72254,"_20923":122910,"_5":14374,"_27449":122780,"_2949":122911},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3465":72303,"_30211":72254,"_20923":122913,"_5":14374,"_27449":122780,"_2949":122914},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3465":72304,"_30211":72254,"_20923":122916,"_5":14374,"_27449":122780,"_2949":122917},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3465":72305,"_30211":72254,"_20923":122919,"_5":14374,"_27449":122784,"_2949":122920},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3465":72306,"_30211":72254,"_20923":122922,"_5":14374,"_27449":122784,"_2949":122923},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3465":72307,"_30211":72254,"_20923":122925,"_5":14374,"_27449":122784,"_2949":122926},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3465":72308,"_30211":72254,"_20923":122928,"_5":14374,"_27449":122784,"_2949":122929},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3465":72309,"_30211":72254,"_20923":122931,"_5":14374,"_27449":122784,"_2949":122932},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3465":72310,"_30211":72254,"_20923":122934,"_5":14374,"_27449":122784,"_2949":122935},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3465":72311,"_30211":72254,"_20923":122937,"_5":14374,"_27449":122784,"_2949":122938},[],"Los ajustes con `status` `FINAL` o `ARCHIVED` se omiten: nada regenera su CRL.",{"_3465":72312,"_30211":72254,"_20923":122940,"_5":14374,"_27449":122784,"_2949":122941},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3465":72313,"_30211":72254,"_20923":122943,"_5":14374,"_27449":122784,"_2949":122944},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3465":72314,"_30211":72254,"_20923":122946,"_5":14374,"_27449":122788,"_2949":122947},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3465":72315,"_30211":72254,"_20923":122949,"_5":14374,"_27449":122788,"_2949":122950},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3465":72316,"_30211":72254,"_20923":122952,"_5":14374,"_27449":122792,"_2949":122953},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3465":72317,"_30211":72254,"_20923":122955,"_5":14374,"_27449":122792,"_2949":122956},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3465":72318,"_30211":72254,"_20923":122958,"_5":14374,"_27449":122792,"_2949":122959},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3465":72319,"_30211":72254,"_20923":122961,"_5":14374,"_27449":122792,"_2949":122962},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3465":72320,"_30211":72254,"_20923":122964,"_5":14374,"_27449":122792,"_2949":122965},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3465":72321,"_30211":72254,"_20923":122967,"_5":14374,"_27449":122796,"_2949":122968},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3465":72322,"_30211":72254,"_20923":122970,"_5":14374,"_27449":122796,"_2949":119457},[],{"_3465":72323,"_30211":72254,"_20923":122972,"_5":14374,"_27449":122796,"_2949":122973},[],"Path relativo",{"_3465":72324,"_30211":72254,"_20923":122975,"_5":14374,"_27449":122796,"_2949":117487},[],{"_3465":72325,"_30211":72254,"_20923":122977,"_5":14374,"_27449":122796,"_2949":56107},[],{"_3465":72326,"_30211":72254,"_20923":122979,"_5":14374,"_27449":122796,"_2949":56110},[],{"_3465":72327,"_30211":72254,"_20923":122981,"_5":14374,"_27449":122796,"_2949":122982},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3465":72328,"_30211":72254,"_20923":122984,"_5":14374,"_27449":122796,"_2949":56107},[],{"_3465":72329,"_30211":72254,"_20923":122986,"_5":14374,"_27449":122796,"_2949":56118},[],{"_3465":72330,"_30211":72254,"_20923":122988,"_5":14374,"_27449":122796,"_2949":122989},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3465":72331,"_30211":72254,"_20923":122991,"_5":14374,"_27449":122796,"_2949":56124},[],{"_3465":72332,"_30211":72254,"_20923":122993,"_5":14374,"_27449":122796,"_2949":56118},[],{"_3465":72333,"_30211":72254,"_20923":122995,"_5":14374,"_27449":122796,"_2949":122996},[],"Sustituir la configuración de CRL de una CA.",{"_3465":72334,"_30211":72254,"_20923":122998,"_5":14374,"_27449":122796,"_2949":56132},[],{"_3465":72335,"_30211":72254,"_20923":123000,"_5":14374,"_27449":122796,"_2949":56118},[],{"_3465":72336,"_30211":72254,"_20923":123002,"_5":14374,"_27449":122796,"_2949":123003},[],"Borrar los ajustes de una CA cuyos ajustes están `ARCHIVED`; sus CRLs publicadas permanecen en el bucket pero dejan de servirse.",{"_3465":72337,"_30211":72254,"_20923":123005,"_5":14374,"_27449":122796,"_2949":123006},[],"Necesitas autenticación y permisos de lectura, actualización o borrado de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL. Un `DELETE` devuelve 409 salvo que los ajustes estén `ARCHIVED`.",{"_3465":72338,"_30211":72254,"_20923":123008,"_5":14374,"_27449":122796,"_2949":123009},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3465":72339,"_30211":72254,"_20923":123011,"_5":14374,"_27449":122800,"_2949":123012},[],"Síntoma",{"_3465":72340,"_30211":72254,"_20923":123014,"_5":14374,"_27449":122800,"_2949":123015},[],"Causa",{"_3465":72341,"_30211":72254,"_20923":123017,"_5":14374,"_27449":122800,"_2949":123018},[],"Acción",{"_3465":72342,"_30211":72254,"_20923":123020,"_5":14374,"_27449":122800,"_2949":123021},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3465":72343,"_30211":72254,"_20923":123023,"_5":14374,"_27449":122800,"_2949":123024},[],"Los ajustes no están `ACTIVE`: son `FINAL` o `ARCHIVED` (consulta la tabla del campo `status` en Ajustes de CRL).",{"_3465":72344,"_30211":72254,"_20923":123026,"_5":14374,"_27449":122800,"_2949":123027},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3465":72345,"_30211":72254,"_20923":123029,"_5":14374,"_27449":122800,"_2949":123030},[],"`PUT` devuelve 400.",{"_3465":72346,"_30211":72254,"_20923":123032,"_5":14374,"_27449":122800,"_2949":123033},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3465":72347,"_30211":72254,"_20923":123035,"_5":14374,"_27449":122800,"_2949":123036},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3465":72348,"_30211":72254,"_20923":123038,"_5":14374,"_27449":122800,"_2949":123039},[],"`PUT` devuelve 404.",{"_3465":72349,"_30211":72254,"_20923":123041,"_5":14374,"_27449":122800,"_2949":123042},[],"La CA o el certificado firmante nuevo no existen, o la CA no tiene ajustes de CRL (por ejemplo, una CA importada).",{"_3465":72350,"_30211":72254,"_20923":123044,"_5":14374,"_27449":122800,"_2949":123045},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3465":72351,"_30211":72254,"_20923":123047,"_5":14374,"_27449":122800,"_2949":123048},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3465":72352,"_30211":72254,"_20923":123050,"_5":14374,"_27449":122800,"_2949":123051},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3465":72353,"_30211":72254,"_20923":123053,"_5":14374,"_27449":122800,"_2949":123054},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3465":72354,"_30211":72254,"_20923":123056,"_5":14374,"_27449":122800,"_2949":123057},[],"La CRL no cambia tras revocar un certificado.",{"_3465":72355,"_30211":72254,"_20923":123059,"_5":14374,"_27449":122800,"_2949":123060},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3465":72356,"_30211":72254,"_20923":123062,"_5":14374,"_27449":122800,"_2949":123063},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3465":72357,"_30211":72254,"_20923":123065,"_5":14374,"_27449":122800,"_2949":123066},[],"Un verificador rechaza la CRL por el emisor.",{"_3465":72358,"_30211":72254,"_20923":123068,"_5":14374,"_27449":122800,"_2949":123069},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3465":72359,"_30211":72254,"_20923":123071,"_5":14374,"_27449":122800,"_2949":123072},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3465":72360,"_30211":72254,"_20923":123074,"_5":14374,"_27449":122804,"_2949":123075},[],"RFC 5280: perfil X.509 y CRL.",{"_3465":72361,"_30211":72254,"_20923":123077,"_5":14374,"_27449":122804,"_2949":56212},[],{"_3465":72362,"_30211":72254,"_20923":123079,"_5":14374,"_27449":122804,"_2949":56215},[],{"_3465":72363,"_30211":72254,"_20923":123081,"_5":14374,"_27449":122804,"_2949":123082},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3465":72364,"_30211":72254,"_20923":123084,"_5":14374,"_27449":122804,"_2949":123085},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3465":72365,"_30211":72365,"_5":14726,"_2949":123087,"_30543":123088,"_20923":123089,"_27449":72365},"Claves y motores criptográficos",[49241,117727,54721,121605],[],{"_3465":72366,"_30211":72365,"_20923":123091,"_5":14374,"_27449":72365,"_2949":123092},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3465":72367,"_30211":72365,"_5":30540,"_20923":123094,"_27449":123095,"_2949":123096},[],"/docs/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3465":72368,"_30211":72365,"_5":30540,"_20923":123098,"_27449":123099,"_2949":123100},[],"/docs/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3465":72369,"_30211":72365,"_5":30540,"_20923":123102,"_27449":123103,"_2949":56240},[],"/docs/es/platform/pki/key-management#file-system",{"_3465":72370,"_30211":72365,"_5":30540,"_20923":123105,"_27449":123106,"_2949":56244},[],"/docs/es/platform/pki/key-management#hashicorp-vault",{"_3465":72371,"_30211":72365,"_5":30540,"_20923":123108,"_27449":123109,"_2949":56248},[],"/docs/es/platform/pki/key-management#aws-secrets-manager",{"_3465":72372,"_30211":72365,"_5":30540,"_20923":123111,"_27449":123112,"_2949":56252},[],"/docs/es/platform/pki/key-management#aws-kms",{"_3465":72373,"_30211":72365,"_5":30540,"_20923":123114,"_27449":123115,"_2949":56256},[],"/docs/es/platform/pki/key-management#pkcs11",{"_3465":72374,"_30211":72365,"_5":30540,"_20923":123117,"_27449":123118,"_2949":56260},[],"/docs/es/platform/pki/key-management#azure-key-vault",{"_3465":72375,"_30211":72365,"_5":30540,"_20923":123120,"_27449":123121,"_2949":123122},[],"/docs/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3465":72376,"_30211":72365,"_5":30540,"_20923":123124,"_27449":123125,"_2949":123126},[],"/docs/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3465":72377,"_30211":72365,"_5":30540,"_20923":123128,"_27449":123129,"_2949":123130},[],"/docs/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3465":72378,"_30211":72365,"_5":30540,"_20923":123132,"_27449":123133,"_2949":123134},[],"/docs/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3465":72379,"_30211":72365,"_5":30540,"_20923":123136,"_27449":123137,"_2949":123138},[],"/docs/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3465":72380,"_30211":72365,"_5":30540,"_20923":123140,"_27449":123141,"_2949":123142},[],"/docs/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3465":72381,"_30211":72365,"_5":30540,"_20923":123144,"_27449":123145,"_2949":123146},[],"/docs/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3465":72382,"_30211":72365,"_5":30540,"_20923":123148,"_27449":123149,"_2949":56292},[],"/docs/es/platform/pki/key-management#sign",{"_3465":72383,"_30211":72365,"_5":30540,"_20923":123151,"_27449":123152,"_2949":56296},[],"/docs/es/platform/pki/key-management#verify",{"_3465":72384,"_30211":72365,"_5":30540,"_20923":123154,"_27449":123155,"_2949":123156},[],"/docs/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3465":72385,"_30211":72365,"_5":30540,"_20923":123158,"_27449":123159,"_2949":123160},[],"/docs/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3465":72386,"_30211":72365,"_5":30540,"_20923":123162,"_27449":123163,"_2949":123164},[],"/docs/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3465":72387,"_30211":72365,"_20923":123166,"_5":14374,"_27449":72365,"_2949":123167},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3465":72388,"_30211":72365,"_20923":123169,"_5":14374,"_27449":72365,"_2949":123170},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3465":72389,"_30211":72365,"_20923":123172,"_5":14374,"_27449":123095,"_2949":123173},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3465":72390,"_30211":72365,"_20923":123175,"_5":14374,"_27449":123095,"_2949":123176},[],"En la práctica, permite:",{"_3465":72391,"_30211":72365,"_20923":123178,"_5":14374,"_27449":123095,"_2949":123179},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3465":72392,"_30211":72365,"_20923":123181,"_5":14374,"_27449":123095,"_2949":123182},[],"Importar claves creadas externamente.",{"_3465":72393,"_30211":72365,"_20923":123184,"_5":14374,"_27449":123095,"_2949":123185},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3465":72394,"_30211":72365,"_20923":123187,"_5":14374,"_27449":123095,"_2949":123188},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3465":72395,"_30211":72365,"_20923":123190,"_5":14374,"_27449":123099,"_2949":123191},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3465":72396,"_30211":72365,"_20923":123193,"_5":14374,"_27449":123099,"_2949":123194},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3465":72397,"_30211":72365,"_20923":123196,"_5":14374,"_27449":123099,"_2949":123197},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3465":72398,"_30211":72365,"_20923":123199,"_5":14374,"_27449":123103,"_2949":123200},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3465":72399,"_30211":72365,"_20923":123202,"_5":14374,"_27449":123106,"_2949":123203},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3465":72400,"_30211":72365,"_20923":123205,"_5":14374,"_27449":123106,"_2949":123206},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3465":72401,"_30211":72365,"_20923":123208,"_5":14374,"_27449":123109,"_2949":123209},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3465":72402,"_30211":72365,"_20923":123211,"_5":14374,"_27449":123112,"_2949":123212},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3465":72403,"_30211":72365,"_20923":123214,"_5":14374,"_27449":123115,"_2949":123215},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3465":72404,"_30211":72365,"_20923":123217,"_5":14374,"_27449":123118,"_2949":123218},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3465":72405,"_30211":72365,"_20923":123220,"_5":14374,"_27449":123118,"_2949":123221},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3465":72406,"_30211":72365,"_20923":123223,"_5":14374,"_27449":123118,"_2949":123224},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3465":72407,"_30211":72365,"_20923":123226,"_5":14374,"_27449":123118,"_2949":123227},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3465":72408,"_30211":72365,"_20923":123229,"_5":14374,"_27449":123121,"_2949":123230},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3465":72409,"_30211":72365,"_20923":123232,"_5":14374,"_27449":123121,"_2949":123233},[],"La tabla incluye los siguientes campos:",{"_3465":72410,"_30211":72365,"_20923":123235,"_5":14374,"_27449":123121,"_2949":123236},[],"**Name**: nombre descriptivo de la clave.",{"_3465":72411,"_30211":72365,"_20923":123238,"_5":14374,"_27449":123121,"_2949":123239},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3465":72412,"_30211":72365,"_20923":123241,"_5":14374,"_27449":123121,"_2949":123242},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3465":72413,"_30211":72365,"_20923":123244,"_5":14374,"_27449":123121,"_2949":123245},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3465":72414,"_30211":72365,"_20923":123247,"_5":14374,"_27449":123121,"_2949":123248},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3465":72415,"_30211":72365,"_20923":123250,"_5":14374,"_27449":123121,"_2949":123251},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3465":72416,"_30211":72365,"_20923":123253,"_5":14374,"_27449":123121,"_2949":123254},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3465":72417,"_30211":72365,"_20923":123256,"_5":14374,"_27449":123121,"_2949":123257},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3465":72418,"_30211":72365,"_20923":123259,"_5":14374,"_27449":123121,"_2949":123260},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3465":72419,"_30211":72365,"_20923":123262,"_5":14374,"_27449":123121,"_2949":123263},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3465":72420,"_30211":72365,"_20923":123265,"_5":14374,"_27449":123121,"_2949":123266},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3465":72421,"_30211":72365,"_20923":123268,"_5":14374,"_27449":123121,"_2949":123269},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3465":72422,"_30211":72365,"_20923":123271,"_5":14374,"_27449":123121,"_2949":123272},[],"**Delete Key** para eliminar la clave del sistema.",{"_3465":72423,"_30211":72365,"_20923":123274,"_5":14374,"_27449":123125,"_2949":123275},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3465":72424,"_30211":72365,"_20923":123277,"_5":14374,"_27449":123129,"_2949":123278},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3465":72425,"_30211":72365,"_20923":123280,"_5":14374,"_27449":123129,"_2949":123281},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3465":72426,"_30211":72365,"_20923":123283,"_5":14374,"_27449":123129,"_2949":123284},[],"**Key Name**: nombre único y descriptivo.",{"_3465":72427,"_30211":72365,"_20923":123286,"_5":14374,"_27449":123129,"_2949":123287},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3465":72428,"_30211":72365,"_20923":123289,"_5":14374,"_27449":123129,"_2949":123290},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3465":72429,"_30211":72365,"_20923":123292,"_5":14374,"_27449":123129,"_2949":123293},[],"**Tags**: metadatos para clasificar la clave.",{"_3465":72430,"_30211":72365,"_20923":123295,"_5":14374,"_27449":123129,"_2949":123296},[],"**Metadata**: información adicional para usos avanzados.",{"_3465":72431,"_30211":72365,"_20923":123298,"_5":14374,"_27449":123133,"_2949":123299},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3465":72432,"_30211":72365,"_20923":123301,"_5":14374,"_27449":123133,"_2949":123302},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3465":72433,"_30211":72365,"_20923":123304,"_5":14374,"_27449":123133,"_2949":123305},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3465":72434,"_30211":72365,"_20923":123307,"_5":14374,"_27449":123133,"_2949":123308},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3465":72435,"_30211":72365,"_20923":123310,"_5":14374,"_27449":123133,"_2949":123311},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3465":72436,"_30211":72365,"_20923":123313,"_5":14374,"_27449":123133,"_2949":123314},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3465":72437,"_30211":72365,"_20923":123316,"_5":14374,"_27449":123133,"_2949":123317},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3465":72438,"_30211":72365,"_20923":123319,"_5":14374,"_27449":123133,"_2949":123320},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3465":72439,"_30211":72365,"_20923":123322,"_5":14374,"_27449":123133,"_2949":123323},[],"**Metadata**: información adicional opcional.",{"_3465":72440,"_30211":72365,"_20923":123325,"_5":14374,"_27449":123133,"_2949":123326},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3465":72441,"_30211":72365,"_20923":123328,"_5":14374,"_27449":123133,"_2949":123329},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3465":72442,"_30211":72365,"_20923":123331,"_5":14374,"_27449":123137,"_2949":123332},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3465":72443,"_30211":72365,"_20923":123334,"_5":14374,"_27449":123141,"_2949":123335},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3465":72444,"_30211":72365,"_20923":123337,"_5":14374,"_27449":123141,"_2949":123338},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3465":72445,"_30211":72365,"_20923":123340,"_5":14374,"_27449":123141,"_2949":123341},[],"**Key Name**: nombre descriptivo.",{"_3465":72446,"_30211":72365,"_20923":123343,"_5":14374,"_27449":123141,"_2949":123344},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3465":72447,"_30211":72365,"_20923":123346,"_5":14374,"_27449":123141,"_2949":123347},[],"**Tags**: etiquetas asociadas.",{"_3465":72448,"_30211":72365,"_20923":123349,"_5":14374,"_27449":123141,"_2949":123350},[],"**Aliases**: nombres alternativos.",{"_3465":72449,"_30211":72365,"_20923":123352,"_5":14374,"_27449":123141,"_2949":123353},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3465":72450,"_30211":72365,"_20923":123355,"_5":14374,"_27449":123141,"_2949":123356},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3465":72451,"_30211":72365,"_20923":123358,"_5":14374,"_27449":123141,"_2949":123359},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3465":72452,"_30211":72365,"_20923":123361,"_5":14374,"_27449":123141,"_2949":123362},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3465":72453,"_30211":72365,"_20923":123364,"_5":14374,"_27449":123145,"_2949":123365},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3465":72454,"_30211":72365,"_20923":123367,"_5":14374,"_27449":123145,"_2949":123368},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3465":72455,"_30211":72365,"_20923":123370,"_5":14374,"_27449":123145,"_2949":123371},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3465":72456,"_30211":72365,"_20923":123373,"_5":14374,"_27449":123149,"_2949":123374},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3465":72457,"_30211":72365,"_20923":123376,"_5":14374,"_27449":123149,"_2949":123377},[],"Campos principales:",{"_3465":72458,"_30211":72365,"_20923":123379,"_5":14374,"_27449":123149,"_2949":123380},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3465":72459,"_30211":72365,"_20923":123382,"_5":14374,"_27449":123149,"_2949":123383},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3465":72460,"_30211":72365,"_20923":123385,"_5":14374,"_27449":123149,"_2949":123386},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3465":72461,"_30211":72365,"_20923":123388,"_5":14374,"_27449":123149,"_2949":123389},[],"**Message**: contenido que se va a firmar.",{"_3465":72462,"_30211":72365,"_20923":123391,"_5":14374,"_27449":123149,"_2949":123392},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3465":72463,"_30211":72365,"_20923":123394,"_5":14374,"_27449":123152,"_2949":123395},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3465":72464,"_30211":72365,"_20923":123397,"_5":14374,"_27449":123152,"_2949":123377},[],{"_3465":72465,"_30211":72365,"_20923":123399,"_5":14374,"_27449":123152,"_2949":123400},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3465":72466,"_30211":72365,"_20923":123402,"_5":14374,"_27449":123152,"_2949":123403},[],"**Message Type**: `Raw` o `Digest`.",{"_3465":72467,"_30211":72365,"_20923":123405,"_5":14374,"_27449":123152,"_2949":123406},[],"**Payload Encoding**: codificación del mensaje.",{"_3465":72468,"_30211":72365,"_20923":123408,"_5":14374,"_27449":123152,"_2949":123409},[],"**Message**: mensaje original o hash.",{"_3465":72469,"_30211":72365,"_20923":123411,"_5":14374,"_27449":123152,"_2949":123412},[],"**Signature**: firma que se desea comprobar.",{"_3465":72470,"_30211":72365,"_20923":123414,"_5":14374,"_27449":123152,"_2949":123415},[],"**Result**: indicador del resultado de la validación.",{"_3465":72471,"_30211":72365,"_20923":123417,"_5":14374,"_27449":123155,"_2949":123418},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3465":72472,"_30211":72365,"_20923":123420,"_5":14374,"_27449":123155,"_2949":123421},[],"Este flujo es útil para:",{"_3465":72473,"_30211":72365,"_20923":123423,"_5":14374,"_27449":123155,"_2949":123424},[],"Solicitar certificados a una CA externa.",{"_3465":72474,"_30211":72365,"_20923":123426,"_5":14374,"_27449":123155,"_2949":123427},[],"Renovar una identidad manteniendo la misma clave.",{"_3465":72475,"_30211":72365,"_20923":123429,"_5":14374,"_27449":123155,"_2949":123430},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3465":72476,"_30211":72365,"_20923":123432,"_5":14374,"_27449":123155,"_2949":123433},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3465":72477,"_30211":72365,"_20923":123435,"_5":14374,"_27449":123155,"_2949":123436},[],"**Organization (O)**: organización o empresa.",{"_3465":72478,"_30211":72365,"_20923":123438,"_5":14374,"_27449":123155,"_2949":123439},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3465":72479,"_30211":72365,"_20923":123441,"_5":14374,"_27449":123155,"_2949":123442},[],"**Country (C)**: código de país de dos letras.",{"_3465":72480,"_30211":72365,"_20923":123444,"_5":14374,"_27449":123155,"_2949":123445},[],"**State / Province (ST)**: estado o provincia.",{"_3465":72481,"_30211":72365,"_20923":123447,"_5":14374,"_27449":123155,"_2949":123448},[],"**Locality (L)**: ciudad o localidad.",{"_3465":72482,"_30211":72365,"_20923":123450,"_5":14374,"_27449":123155,"_2949":123451},[],"**Email Address**: correo de contacto.",{"_3465":72483,"_30211":72365,"_20923":123453,"_5":14374,"_27449":123155,"_2949":123454},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3465":72484,"_30211":72365,"_20923":123456,"_5":14374,"_27449":123155,"_2949":123457},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3465":72485,"_30211":72365,"_20923":123459,"_5":14374,"_27449":123159,"_2949":123460},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3465":72486,"_30211":72365,"_20923":123462,"_5":14374,"_27449":123159,"_2949":123463},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3465":72487,"_30211":72365,"_20923":123465,"_5":14374,"_27449":123163,"_2949":123466},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3465":72488,"_30211":72365,"_20923":123468,"_5":14374,"_27449":123163,"_2949":123469},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3465":72489,"_30211":72489,"_5":14726,"_2949":123471,"_30543":123472,"_20923":123473,"_27449":72489},"Validación online con OCSP",[49241,117727,54721,122242],[],{"_3465":72490,"_30211":72489,"_20923":123475,"_5":14374,"_27449":72489,"_2949":123476},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3465":72491,"_30211":72489,"_5":30540,"_20923":123478,"_27449":123479,"_2949":123480},[],"/docs/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3465":72492,"_30211":72489,"_5":30540,"_20923":123482,"_27449":123483,"_2949":123484},[],"/docs/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3465":72493,"_30211":72489,"_5":30540,"_20923":123486,"_27449":123487,"_2949":123488},[],"/docs/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3465":72494,"_30211":72489,"_5":30540,"_20923":123490,"_27449":123491,"_2949":123492},[],"/docs/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3465":72495,"_30211":72489,"_5":30540,"_20923":123494,"_27449":123495,"_2949":123496},[],"/docs/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3465":72496,"_30211":72489,"_5":30540,"_20923":123498,"_27449":123499,"_2949":122805},[],"/docs/es/platform/pki/ocsp#referencias",{"_3465":72497,"_30211":72489,"_20923":123501,"_5":14374,"_27449":72489,"_2949":123502},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3465":72498,"_30211":72489,"_20923":123504,"_5":14374,"_27449":123479,"_2949":123505},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3465":72499,"_30211":72489,"_20923":123507,"_5":14374,"_27449":123479,"_2949":123508},[],"Estado del registro",{"_3465":72500,"_30211":72489,"_20923":123510,"_5":14374,"_27449":123479,"_2949":123511},[],"Respuesta firmada",{"_3465":72501,"_30211":72489,"_20923":123513,"_5":14374,"_27449":123479,"_2949":53858},[],{"_3465":72502,"_30211":72489,"_20923":123515,"_5":14374,"_27449":123479,"_2949":56660},[],{"_3465":72503,"_30211":72489,"_20923":123517,"_5":14374,"_27449":123479,"_2949":53875},[],{"_3465":72504,"_30211":72489,"_20923":123519,"_5":14374,"_27449":123479,"_2949":123520},[],"`Revoked`, con razón y fecha de revocación.",{"_3465":72505,"_30211":72489,"_20923":123522,"_5":14374,"_27449":123479,"_2949":123523},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3465":72506,"_30211":72489,"_20923":123525,"_5":14374,"_27449":123479,"_2949":123526},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3465":72507,"_30211":72489,"_20923":123528,"_5":14374,"_27449":123479,"_2949":123529},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3465":72508,"_30211":72489,"_20923":123531,"_5":14374,"_27449":123479,"_2949":123532},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3465":72509,"_30211":72489,"_20923":123534,"_5":14374,"_27449":123479,"_2949":123535},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3465":72510,"_30211":72489,"_20923":123537,"_5":14374,"_27449":123483,"_2949":123538},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3465":72511,"_30211":72489,"_20923":123540,"_5":14374,"_27449":123483,"_2949":123541},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3465":72512,"_30211":72489,"_20923":123543,"_5":14374,"_27449":123487,"_2949":123544},[],"El servicio acepta:",{"_3465":72513,"_30211":72489,"_20923":123546,"_5":14374,"_27449":123487,"_2949":119457},[],{"_3465":72514,"_30211":72489,"_20923":123548,"_5":14374,"_27449":123487,"_2949":123549},[],"Ruta del servicio VA",{"_3465":72515,"_30211":72489,"_20923":123551,"_5":14374,"_27449":123487,"_2949":123552},[],"Formato",{"_3465":72516,"_30211":72489,"_20923":123554,"_5":14374,"_27449":123487,"_2949":56700},[],{"_3465":72517,"_30211":72489,"_20923":123556,"_5":14374,"_27449":123487,"_2949":56703},[],{"_3465":72518,"_30211":72489,"_20923":123558,"_5":14374,"_27449":123487,"_2949":123559},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3465":72519,"_30211":72489,"_20923":123561,"_5":14374,"_27449":123487,"_2949":56107},[],{"_3465":72520,"_30211":72489,"_20923":123563,"_5":14374,"_27449":123487,"_2949":56711},[],{"_3465":72521,"_30211":72489,"_20923":123565,"_5":14374,"_27449":123487,"_2949":123566},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3465":72522,"_30211":72489,"_20923":123568,"_5":14374,"_27449":123487,"_2949":123569},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3465":72523,"_30211":72489,"_20923":123571,"_5":14374,"_27449":123491,"_2949":123572},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3465":72524,"_30211":72489,"_20923":123574,"_5":14374,"_27449":123491,"_2949":123575},[],"Genera la solicitud:",{"_3465":72525,"_30211":72489,"_20923":123577,"_5":14374,"_27449":123491,"_2949":123578},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3465":72526,"_30211":72489,"_20923":123580,"_5":14374,"_27449":123491,"_2949":123581},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3465":72527,"_30211":72489,"_20923":123583,"_5":14374,"_27449":123491,"_2949":123584},[],"Verifica el DER recibido:",{"_3465":72528,"_30211":72489,"_20923":123586,"_5":14374,"_27449":123491,"_2949":123587},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3465":72529,"_30211":72489,"_20923":123589,"_5":14374,"_27449":123495,"_2949":123590},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3465":72530,"_30211":72489,"_20923":123592,"_5":14374,"_27449":123495,"_2949":123593},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3465":72531,"_30211":72489,"_20923":123595,"_5":14374,"_27449":123499,"_2949":56744},[],{"_3465":72532,"_30211":72489,"_20923":123597,"_5":14374,"_27449":123499,"_2949":56747},[],{"_3465":72533,"_30211":72489,"_20923":123599,"_5":14374,"_27449":123499,"_2949":123600},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3465":72534,"_30211":72489,"_20923":123602,"_5":14374,"_27449":123499,"_2949":123085},[],{"_3465":72535,"_30211":72535,"_5":14726,"_2949":54721,"_30543":123604,"_20923":123605,"_27449":72535},[49241,117727,54721],[],{"_3465":72536,"_30211":72535,"_20923":123607,"_5":14374,"_27449":72535,"_2949":123608},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3465":72537,"_30211":72535,"_5":30540,"_20923":123610,"_27449":123611,"_2949":120931},[],"/docs/es/platform/pki/overview#empieza-aquí",{"_3465":72538,"_30211":72535,"_5":30540,"_20923":123613,"_27449":123614,"_2949":123615},[],"/docs/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3465":72539,"_30211":72535,"_5":30540,"_20923":123617,"_27449":123618,"_2949":121451},[],"/docs/es/platform/pki/overview#capacidades-principales",{"_3465":72540,"_30211":72535,"_5":30540,"_20923":123620,"_27449":123621,"_2949":121455},[],"/docs/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3465":72541,"_30211":72535,"_5":30540,"_20923":123623,"_27449":123624,"_2949":121459},[],"/docs/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3465":72542,"_30211":72535,"_5":30540,"_20923":123626,"_27449":123627,"_2949":121463},[],"/docs/es/platform/pki/overview#emite-y-controla-certificados",{"_3465":72543,"_30211":72535,"_5":30540,"_20923":123629,"_27449":123630,"_2949":121471},[],"/docs/es/platform/pki/overview#publica-el-estado-de-validación",{"_3465":72544,"_30211":72535,"_5":30540,"_20923":123632,"_27449":123633,"_2949":123634},[],"/docs/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3465":72545,"_30211":72535,"_5":30540,"_20923":123636,"_27449":123637,"_2949":122408},[],"/docs/es/platform/pki/overview#continúa",{"_3465":72546,"_30211":72535,"_20923":123639,"_5":14374,"_27449":72535,"_2949":123640},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3465":72547,"_30211":72535,"_20923":123642,"_5":14374,"_27449":123611,"_2949":123643},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3465":72548,"_30211":72535,"_20923":123645,"_5":14374,"_27449":123611,"_2949":123646},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3465":72549,"_30211":72535,"_20923":123648,"_5":14374,"_27449":123614,"_2949":123649},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3465":72550,"_30211":72535,"_20923":123651,"_5":14374,"_27449":123614,"_2949":123652},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3465":72551,"_30211":72535,"_20923":123654,"_5":14374,"_27449":123614,"_2949":123655},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3465":72552,"_30211":72535,"_20923":123657,"_5":14374,"_27449":123614,"_2949":123658},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3465":72553,"_30211":72535,"_20923":123660,"_5":14374,"_27449":123614,"_2949":123661},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3465":72554,"_30211":72535,"_20923":123663,"_5":14374,"_27449":123621,"_2949":123664},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3465":72555,"_30211":72535,"_20923":123666,"_5":14374,"_27449":123624,"_2949":123667},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3465":72556,"_30211":72535,"_20923":123669,"_5":14374,"_27449":123627,"_2949":123670},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3465":72557,"_30211":72535,"_20923":123672,"_5":14374,"_27449":123630,"_2949":123673},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3465":72558,"_30211":72535,"_20923":123675,"_5":14374,"_27449":123633,"_2949":123676},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3465":72559,"_30211":72535,"_20923":123678,"_5":14374,"_27449":123633,"_2949":123679},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3465":72560,"_30211":72535,"_20923":123681,"_5":14374,"_27449":123633,"_2949":123682},[],"su clave pública corresponda a la clave privada del cliente;",{"_3465":72561,"_30211":72535,"_20923":123684,"_5":14374,"_27449":123633,"_2949":123685},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3465":72562,"_30211":72535,"_20923":123687,"_5":14374,"_27449":123633,"_2949":123688},[],"sus fechas y usos permitan la operación;",{"_3465":72563,"_30211":72535,"_20923":123690,"_5":14374,"_27449":123633,"_2949":123691},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3465":72564,"_30211":72535,"_20923":123693,"_5":14374,"_27449":123633,"_2949":123694},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3465":72565,"_30211":72535,"_20923":123696,"_5":14374,"_27449":123637,"_2949":123697},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3465":72566,"_30211":72535,"_20923":123699,"_5":14374,"_27449":123637,"_2949":123700},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3465":72567,"_30211":72535,"_20923":123702,"_5":14374,"_27449":123637,"_2949":123703},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3465":72568,"_30211":72568,"_5":14726,"_2949":123705,"_30543":123706,"_20923":123707,"_27449":72568},"Crea tu primera CA",[49241,117727,54721,121055],[],{"_3465":72569,"_30211":72568,"_20923":123709,"_5":14374,"_27449":72568,"_2949":123710},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3465":72570,"_30211":72568,"_5":30540,"_20923":123712,"_27449":123713,"_2949":116298},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3465":72571,"_30211":72568,"_5":30540,"_20923":123715,"_27449":123716,"_2949":123717},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3465":72572,"_30211":72568,"_5":30540,"_20923":123719,"_27449":123720,"_2949":123721},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3465":72573,"_30211":72568,"_5":30540,"_20923":123723,"_27449":123724,"_2949":123725},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3465":72574,"_30211":72568,"_5":30540,"_20923":123727,"_27449":123728,"_2949":123729},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3465":72575,"_30211":72568,"_5":30540,"_20923":123731,"_27449":123732,"_2949":123733},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3465":72576,"_30211":72568,"_5":30540,"_20923":123735,"_27449":123736,"_2949":123737},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3465":72577,"_30211":72568,"_5":30540,"_20923":123739,"_27449":123740,"_2949":121302},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3465":72578,"_30211":72568,"_5":30540,"_20923":123742,"_27449":123743,"_2949":116322},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3465":72579,"_30211":72568,"_20923":123745,"_5":14374,"_27449":72568,"_2949":123746},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3465":72580,"_30211":72568,"_20923":123748,"_5":14374,"_27449":123713,"_2949":123749},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3465":72581,"_30211":72568,"_20923":123751,"_5":14374,"_27449":123713,"_2949":123752},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3465":72582,"_30211":72568,"_20923":123754,"_5":14374,"_27449":123713,"_2949":123755},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3465":72583,"_30211":72568,"_20923":123757,"_5":14374,"_27449":123713,"_2949":123758},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3465":72584,"_30211":72568,"_20923":123760,"_5":14374,"_27449":123716,"_2949":123761},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3465":72585,"_30211":72568,"_20923":123763,"_5":14374,"_27449":123716,"_2949":123764},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3465":72586,"_30211":72568,"_20923":123766,"_5":14374,"_27449":123720,"_2949":123767},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3465":72587,"_30211":72568,"_20923":123769,"_5":14374,"_27449":123720,"_2949":123770},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3465":72588,"_30211":72568,"_20923":123772,"_5":14374,"_27449":123724,"_2949":123773},[],"Selecciona **Root CA** y completa:",{"_3465":72589,"_30211":72568,"_20923":123775,"_5":14374,"_27449":123724,"_2949":56926},[],{"_3465":72590,"_30211":72568,"_20923":123777,"_5":14374,"_27449":123724,"_2949":123778},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3465":72591,"_30211":72568,"_20923":123780,"_5":14374,"_27449":123724,"_2949":123781},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3465":72592,"_30211":72568,"_20923":123783,"_5":14374,"_27449":123724,"_2949":123784},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3465":72593,"_30211":72568,"_20923":123786,"_5":14374,"_27449":123724,"_2949":123787},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3465":72594,"_30211":72568,"_20923":123789,"_5":14374,"_27449":123728,"_2949":123790},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3465":72595,"_30211":72568,"_20923":123792,"_5":14374,"_27449":123732,"_2949":123793},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3465":72596,"_30211":72568,"_20923":123795,"_5":14374,"_27449":123732,"_2949":123796},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3465":72597,"_30211":72568,"_20923":123798,"_5":14374,"_27449":123736,"_2949":123799},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3465":72598,"_30211":72568,"_20923":123801,"_5":14374,"_27449":123736,"_2949":123802},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3465":72599,"_30211":72568,"_20923":123804,"_5":14374,"_27449":123736,"_2949":123805},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3465":72600,"_30211":72568,"_20923":123807,"_5":14374,"_27449":123740,"_2949":123808},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3465":72601,"_30211":72568,"_20923":123810,"_5":14374,"_27449":123740,"_2949":123811},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3465":72602,"_30211":72568,"_20923":123813,"_5":14374,"_27449":123740,"_2949":123814},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3465":72603,"_30211":72568,"_20923":123816,"_5":14374,"_27449":123740,"_2949":123817},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3465":72604,"_30211":72568,"_20923":123819,"_5":14374,"_27449":123743,"_2949":123820},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3465":72605,"_30211":72605,"_5":14726,"_2949":123822,"_30543":123823,"_20923":123824,"_27449":72605},"Emite y verifica un certificado",[49241,117727,54721,121055],[],{"_3465":72606,"_30211":72605,"_20923":123826,"_5":14374,"_27449":72605,"_2949":123827},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3465":72607,"_30211":72605,"_5":30540,"_20923":123829,"_27449":123830,"_2949":116298},[],"/docs/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3465":72608,"_30211":72605,"_5":30540,"_20923":123832,"_27449":123833,"_2949":123834},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3465":72609,"_30211":72605,"_5":30540,"_20923":123836,"_27449":123837,"_2949":123838},[],"/docs/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3465":72610,"_30211":72605,"_5":30540,"_20923":123840,"_27449":123841,"_2949":123842},[],"/docs/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3465":72611,"_30211":72605,"_5":30540,"_20923":123844,"_27449":123845,"_2949":123846},[],"/docs/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3465":72612,"_30211":72605,"_5":30540,"_20923":123848,"_27449":123849,"_2949":123850},[],"/docs/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3465":72613,"_30211":72605,"_5":30540,"_20923":123852,"_27449":123853,"_2949":123854},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3465":72614,"_30211":72605,"_5":30540,"_20923":123856,"_27449":123857,"_2949":123858},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3465":72615,"_30211":72605,"_5":30540,"_20923":123860,"_27449":123861,"_2949":123862},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3465":72616,"_30211":72605,"_5":30540,"_20923":123864,"_27449":123865,"_2949":123866},[],"/docs/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3465":72617,"_30211":72605,"_5":30540,"_20923":123868,"_27449":123869,"_2949":121302},[],"/docs/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3465":72618,"_30211":72605,"_5":30540,"_20923":123871,"_27449":123872,"_2949":116322},[],"/docs/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3465":72619,"_30211":72605,"_20923":123874,"_5":14374,"_27449":72605,"_2949":123875},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3465":72620,"_30211":72605,"_20923":123877,"_5":14374,"_27449":123830,"_2949":123878},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3465":72621,"_30211":72605,"_20923":123880,"_5":14374,"_27449":123830,"_2949":123881},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3465":72622,"_30211":72605,"_20923":123883,"_5":14374,"_27449":123830,"_2949":123884},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3465":72623,"_30211":72605,"_20923":123886,"_5":14374,"_27449":123830,"_2949":123887},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3465":72624,"_30211":72605,"_20923":123889,"_5":14374,"_27449":123830,"_2949":123890},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3465":72625,"_30211":72605,"_20923":123892,"_5":14374,"_27449":123833,"_2949":123893},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3465":72626,"_30211":72605,"_20923":123895,"_5":14374,"_27449":123837,"_2949":123896},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3465":72627,"_30211":72605,"_20923":123898,"_5":14374,"_27449":123837,"_2949":123899},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3465":72628,"_30211":72605,"_20923":123901,"_5":14374,"_27449":123841,"_2949":123902},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3465":72629,"_30211":72605,"_20923":123904,"_5":14374,"_27449":123841,"_2949":123905},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3465":72630,"_30211":72605,"_20923":123907,"_5":14374,"_27449":123845,"_2949":123908},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3465":72631,"_30211":72605,"_20923":123910,"_5":14374,"_27449":123845,"_2949":123911},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3465":72632,"_30211":72605,"_20923":123913,"_5":14374,"_27449":123849,"_2949":123914},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3465":72633,"_30211":72605,"_20923":123916,"_5":14374,"_27449":123853,"_2949":123917},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3465":72634,"_30211":72605,"_20923":123919,"_5":14374,"_27449":123857,"_2949":123920},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3465":72635,"_30211":72605,"_20923":123922,"_5":14374,"_27449":123861,"_2949":123923},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3465":72636,"_30211":72605,"_20923":123925,"_5":14374,"_27449":123861,"_2949":123926},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3465":72637,"_30211":72605,"_20923":123928,"_5":14374,"_27449":123861,"_2949":123929},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3465":72638,"_30211":72605,"_20923":123931,"_5":14374,"_27449":123865,"_2949":123932},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3465":72639,"_30211":72605,"_20923":123934,"_5":14374,"_27449":123865,"_2949":123935},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3465":72640,"_30211":72605,"_20923":123937,"_5":14374,"_27449":123865,"_2949":123938},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3465":72641,"_30211":72605,"_20923":123940,"_5":14374,"_27449":123869,"_2949":121385},[],{"_3465":72642,"_30211":72605,"_20923":123942,"_5":14374,"_27449":123869,"_2949":119906},[],{"_3465":72643,"_30211":72605,"_20923":123944,"_5":14374,"_27449":123869,"_2949":123945},[],"La CA rechaza la emisión",{"_3465":72644,"_30211":72605,"_20923":123947,"_5":14374,"_27449":123869,"_2949":123948},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3465":72645,"_30211":72605,"_20923":123950,"_5":14374,"_27449":123869,"_2949":123951},[],"Sujeto o usos diferentes",{"_3465":72646,"_30211":72605,"_20923":123953,"_5":14374,"_27449":123869,"_2949":123954},[],"Perfil aplicado y valores solicitados.",{"_3465":72647,"_30211":72605,"_20923":123956,"_5":14374,"_27449":123869,"_2949":123957},[],"No se encuentra el emisor",{"_3465":72648,"_30211":72605,"_20923":123959,"_5":14374,"_27449":123869,"_2949":123960},[],"CA descargada y cadena intermedia necesaria.",{"_3465":72649,"_30211":72605,"_20923":123962,"_5":14374,"_27449":123869,"_2949":123963},[],"Falla la vigencia",{"_3465":72650,"_30211":72605,"_20923":123965,"_5":14374,"_27449":123869,"_2949":123966},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3465":72651,"_30211":72605,"_20923":123968,"_5":14374,"_27449":123869,"_2949":123969},[],"Los resúmenes de clave difieren",{"_3465":72652,"_30211":72605,"_20923":123971,"_5":14374,"_27449":123869,"_2949":123972},[],"Archivos de certificado y clave de la misma emisión.",{"_3465":72653,"_30211":72605,"_20923":123974,"_5":14374,"_27449":123869,"_2949":123975},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3465":72654,"_30211":72605,"_20923":123977,"_5":14374,"_27449":123872,"_2949":123978},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3465":72655,"_30211":72605,"_20923":123980,"_5":14374,"_27449":123872,"_2949":123981},[],"Gestionar certificados para inspección, estado y revocación.",{"_3465":72656,"_30211":72605,"_20923":123983,"_5":14374,"_27449":123872,"_2949":123984},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3465":72657,"_30211":72605,"_20923":123986,"_5":14374,"_27449":123872,"_2949":123987},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3465":72658,"_30211":72605,"_20923":123989,"_5":14374,"_27449":123872,"_2949":123990},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3465":72659,"_30211":72659,"_5":14726,"_2949":123992,"_30543":123993,"_20923":123994,"_27449":72659},"Primeros pasos de PKI",[49241,117727,54721,121055],[],{"_3465":72660,"_30211":72659,"_20923":123996,"_5":14374,"_27449":72659,"_2949":123997},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3465":72661,"_30211":72659,"_5":30540,"_20923":123999,"_27449":124000,"_2949":116298},[],"/docs/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3465":72662,"_30211":72659,"_5":30540,"_20923":124002,"_27449":124003,"_2949":124004},[],"/docs/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3465":72663,"_30211":72659,"_5":30540,"_20923":124006,"_27449":124007,"_2949":121237},[],"/docs/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3465":72664,"_30211":72659,"_5":30540,"_20923":124009,"_27449":124010,"_2949":124011},[],"/docs/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3465":72665,"_30211":72659,"_20923":124013,"_5":14374,"_27449":72659,"_2949":124014},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3465":72666,"_30211":72659,"_20923":124016,"_5":14374,"_27449":124000,"_2949":124017},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3465":72667,"_30211":72659,"_20923":124019,"_5":14374,"_27449":124000,"_2949":124020},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3465":72668,"_30211":72659,"_20923":124022,"_5":14374,"_27449":124000,"_2949":124023},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3465":72669,"_30211":72659,"_20923":124025,"_5":14374,"_27449":124000,"_2949":124026},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3465":72670,"_30211":72659,"_20923":124028,"_5":14374,"_27449":124000,"_2949":124029},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3465":72671,"_30211":72659,"_20923":124031,"_5":14374,"_27449":124003,"_2949":124032},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3465":72672,"_30211":72659,"_20923":124034,"_5":14374,"_27449":124003,"_2949":124035},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3465":72673,"_30211":72659,"_20923":124037,"_5":14374,"_27449":124003,"_2949":124038},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3465":72674,"_30211":72659,"_20923":124040,"_5":14374,"_27449":124003,"_2949":124041},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3465":72675,"_30211":72659,"_20923":124043,"_5":14374,"_27449":124007,"_2949":124044},[],"Archivo o recurso",{"_3465":72676,"_30211":72659,"_20923":124046,"_5":14374,"_27449":124007,"_2949":121234},[],{"_3465":72677,"_30211":72659,"_20923":124048,"_5":14374,"_27449":124007,"_2949":124049},[],"CA raíz activa y `ca.pem`",{"_3465":72678,"_30211":72659,"_20923":124051,"_5":14374,"_27449":124007,"_2949":124052},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3465":72679,"_30211":72659,"_20923":124054,"_5":14374,"_27449":124007,"_2949":124055},[],"Certificado final y `device.crt`",{"_3465":72680,"_30211":72659,"_20923":124057,"_5":14374,"_27449":124007,"_2949":124058},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3465":72681,"_30211":72659,"_20923":124060,"_5":14374,"_27449":124007,"_2949":124061},[],"Clave privada `device.key`",{"_3465":72682,"_30211":72659,"_20923":124063,"_5":14374,"_27449":124007,"_2949":124064},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3465":72683,"_30211":72659,"_20923":124066,"_5":14374,"_27449":124007,"_2949":124067},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3465":72684,"_30211":72659,"_20923":124069,"_5":14374,"_27449":124010,"_2949":124070},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3465":72685,"_30211":72659,"_20923":124072,"_5":14374,"_27449":124010,"_2949":124073},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3465":72686,"_30211":72659,"_20923":124075,"_5":14374,"_27449":124010,"_2949":124076},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3465":72687,"_30211":72687,"_5":14726,"_2949":124078,"_30543":124079,"_20923":124081,"_27449":72687},"Resolución de problemas PKI",[49241,117727,54721,124080],"Resolución de problemas",[],{"_3465":72688,"_30211":72687,"_20923":124083,"_5":14374,"_27449":72687,"_2949":124084},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3465":72689,"_30211":72687,"_5":30540,"_20923":124086,"_27449":124087,"_2949":124088},[],"/docs/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3465":72690,"_30211":72687,"_5":30540,"_20923":124090,"_27449":124091,"_2949":124092},[],"/docs/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3465":72691,"_30211":72687,"_5":30540,"_20923":124094,"_27449":124095,"_2949":124096},[],"/docs/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3465":72692,"_30211":72687,"_20923":124098,"_5":14374,"_27449":72687,"_2949":124099},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3465":72693,"_30211":72687,"_20923":124101,"_5":14374,"_27449":72687,"_2949":124102},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3465":72694,"_30211":72687,"_20923":124104,"_5":14374,"_27449":124087,"_2949":121234},[],{"_3465":72695,"_30211":72687,"_20923":124106,"_5":14374,"_27449":124087,"_2949":119906},[],{"_3465":72696,"_30211":72687,"_20923":124108,"_5":14374,"_27449":124087,"_2949":116322},[],{"_3465":72697,"_30211":72687,"_20923":124110,"_5":14374,"_27449":124087,"_2949":53563},[],{"_3465":72698,"_30211":72687,"_20923":124112,"_5":14374,"_27449":124087,"_2949":124113},[],"Existe, está activa y sus fechas son utilizables.",{"_3465":72699,"_30211":72687,"_20923":124115,"_5":14374,"_27449":124087,"_2949":124116},[],"Autoridades.",{"_3465":72700,"_30211":72687,"_20923":124118,"_5":14374,"_27449":124087,"_2949":124119},[],"Clave",{"_3465":72701,"_30211":72687,"_20923":124121,"_5":14374,"_27449":124087,"_2949":124122},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3465":72702,"_30211":72687,"_20923":124124,"_5":14374,"_27449":124087,"_2949":124125},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3465":72703,"_30211":72687,"_20923":124127,"_5":14374,"_27449":124087,"_2949":57280},[],{"_3465":72704,"_30211":72687,"_20923":124129,"_5":14374,"_27449":124087,"_2949":124130},[],"PEM correcto y firma verificable.",{"_3465":72705,"_30211":72687,"_20923":124132,"_5":14374,"_27449":124087,"_2949":57286},[],{"_3465":72706,"_30211":72687,"_20923":124134,"_5":14374,"_27449":124087,"_2949":124135},[],"Perfil",{"_3465":72707,"_30211":72687,"_20923":124137,"_5":14374,"_27449":124087,"_2949":124138},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3465":72708,"_30211":72687,"_20923":124140,"_5":14374,"_27449":124087,"_2949":124141},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3465":72709,"_30211":72687,"_20923":124143,"_5":14374,"_27449":124087,"_2949":121385},[],{"_3465":72710,"_30211":72687,"_20923":124145,"_5":14374,"_27449":124087,"_2949":124146},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3465":72711,"_30211":72687,"_20923":124148,"_5":14374,"_27449":124087,"_2949":124149},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3465":72712,"_30211":72687,"_20923":124151,"_5":14374,"_27449":124087,"_2949":124152},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3465":72713,"_30211":72687,"_20923":124154,"_5":14374,"_27449":124087,"_2949":124155},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3465":72714,"_30211":72687,"_20923":124157,"_5":14374,"_27449":124091,"_2949":124158},[],"Revisa cada frontera por separado:",{"_3465":72715,"_30211":72687,"_20923":124160,"_5":14374,"_27449":124091,"_2949":124161},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3465":72716,"_30211":72687,"_20923":124163,"_5":14374,"_27449":124091,"_2949":124164},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3465":72717,"_30211":72687,"_20923":124166,"_5":14374,"_27449":124091,"_2949":124167},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3465":72718,"_30211":72687,"_20923":124169,"_5":14374,"_27449":124091,"_2949":124170},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3465":72719,"_30211":72687,"_20923":124172,"_5":14374,"_27449":124091,"_2949":124173},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3465":72720,"_30211":72687,"_20923":124175,"_5":14374,"_27449":124091,"_2949":124176},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3465":72721,"_30211":72687,"_20923":124178,"_5":14374,"_27449":124095,"_2949":124179},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3465":72722,"_30211":72687,"_20923":124181,"_5":14374,"_27449":124095,"_2949":124182},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3465":72723,"_30211":72723,"_5":14726,"_2949":124184,"_30543":124185,"_20923":124186,"_27449":72723},"Seguridad",[49241],[],{"_3465":72724,"_30211":72723,"_20923":124188,"_5":14374,"_27449":72723,"_2949":124189},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3465":72725,"_30211":72723,"_5":30540,"_20923":124191,"_27449":124192,"_2949":124193},[],"/docs/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3465":72726,"_30211":72723,"_5":30540,"_20923":124195,"_27449":124196,"_2949":124197},[],"/docs/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3465":72727,"_30211":72723,"_5":30540,"_20923":124199,"_27449":124200,"_2949":124201},[],"/docs/es/security#versiones-soportadas","Versiones soportadas",{"_3465":72728,"_30211":72723,"_5":30540,"_20923":124203,"_27449":124204,"_2949":124205},[],"/docs/es/security#divulgación-responsable","Divulgación responsable",{"_3465":72729,"_30211":72723,"_20923":124207,"_5":14374,"_27449":72723,"_2949":124208},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3465":72730,"_30211":72723,"_20923":124210,"_5":14374,"_27449":124192,"_2949":124211},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3465":72731,"_30211":72723,"_20923":124213,"_5":14374,"_27449":124192,"_2949":124214},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3465":72732,"_30211":72723,"_20923":124216,"_5":14374,"_27449":124192,"_2949":14993},[],{"_3465":72733,"_30211":72723,"_20923":124218,"_5":14374,"_27449":124192,"_2949":14933},[],{"_3465":72734,"_30211":72723,"_20923":124220,"_5":14374,"_27449":124192,"_2949":14980},[],{"_3465":72735,"_30211":72723,"_20923":124222,"_5":14374,"_27449":124192,"_2949":124223},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3465":72736,"_30211":72723,"_20923":124225,"_5":14374,"_27449":124192,"_2949":124226},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3465":72737,"_30211":72723,"_20923":124228,"_5":14374,"_27449":124196,"_2949":124229},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3465":72738,"_30211":72723,"_20923":124231,"_5":14374,"_27449":124196,"_2949":124232},[],"No incluyas en el reporte:",{"_3465":72739,"_30211":72723,"_20923":124234,"_5":14374,"_27449":124196,"_2949":124235},[],"Credenciales, tokens o claves privadas",{"_3465":72740,"_30211":72723,"_20923":124237,"_5":14374,"_27449":124196,"_2949":124238},[],"Datos de clientes o información identificable de clientes",{"_3465":72741,"_30211":72723,"_20923":124240,"_5":14374,"_27449":124196,"_2949":124241},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3465":72742,"_30211":72723,"_20923":124243,"_5":14374,"_27449":124200,"_2949":124244},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3465":72743,"_30211":72723,"_20923":124246,"_5":14374,"_27449":124200,"_2949":124247},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3465":72744,"_30211":72723,"_20923":124249,"_5":14374,"_27449":124204,"_2949":124250},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3465":72745,"_30211":72723,"_20923":124252,"_5":14374,"_27449":124204,"_2949":124253},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3465":72746,"_30211":72723,"_20923":124255,"_5":14374,"_27449":124204,"_2949":124256},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3465":72747,"_30211":72723,"_20923":124258,"_5":14374,"_27449":124204,"_2949":124259},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3465":72748,"_30211":72723,"_20923":124261,"_5":14374,"_27449":124204,"_2949":124262},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3465":72749,"_30211":72749,"_5":14726,"_2949":124264,"_30543":124265,"_20923":124267,"_27449":72749},"3.8.0 a 4.0.0",[49241,124266],"Actualizaciones",[],{"_3465":72750,"_30211":72749,"_20923":124269,"_5":14374,"_27449":72749,"_2949":124270},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3465":72751,"_30211":72749,"_5":30540,"_20923":124272,"_27449":124273,"_2949":124274},[],"/docs/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3465":72752,"_30211":72749,"_5":30540,"_20923":124276,"_27449":124277,"_2949":124278},[],"/docs/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3465":72753,"_30211":72749,"_5":30540,"_20923":124280,"_27449":124281,"_2949":124282},[],"/docs/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3465":72754,"_30211":72749,"_5":30540,"_20923":124284,"_27449":124285,"_2949":124286},[],"/docs/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3465":72755,"_30211":72749,"_5":30540,"_20923":124288,"_27449":124289,"_2949":124290},[],"/docs/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3465":72756,"_30211":72749,"_5":30540,"_20923":124292,"_27449":124293,"_2949":124294},[],"/docs/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3465":72757,"_30211":72749,"_5":30540,"_20923":124296,"_27449":124297,"_2949":57452},[],"/docs/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3465":72758,"_30211":72749,"_5":30540,"_20923":124299,"_27449":124300,"_2949":124301},[],"/docs/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3465":72759,"_30211":72749,"_5":30540,"_20923":124303,"_27449":124304,"_2949":124305},[],"/docs/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3465":72760,"_30211":72749,"_5":30540,"_20923":124307,"_27449":124308,"_2949":124309},[],"/docs/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3465":72761,"_30211":72749,"_5":30540,"_20923":124311,"_27449":124312,"_2949":124313},[],"/docs/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3465":72762,"_30211":72749,"_5":30540,"_20923":124315,"_27449":124316,"_2949":124317},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3465":72763,"_30211":72749,"_5":30540,"_20923":124319,"_27449":124320,"_2949":124321},[],"/docs/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3465":72764,"_30211":72749,"_5":30540,"_20923":124323,"_27449":124324,"_2949":124325},[],"/docs/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3465":72765,"_30211":72749,"_5":30540,"_20923":124327,"_27449":124328,"_2949":124329},[],"/docs/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3465":72766,"_30211":72749,"_5":30540,"_20923":124331,"_27449":124332,"_2949":124333},[],"/docs/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3465":72767,"_30211":72749,"_5":30540,"_20923":124335,"_27449":124336,"_2949":124337},[],"/docs/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3465":72768,"_30211":72749,"_5":30540,"_20923":124339,"_27449":124340,"_2949":124341},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3465":72769,"_30211":72749,"_5":30540,"_20923":124343,"_27449":124344,"_2949":124345},[],"/docs/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3465":72770,"_30211":72749,"_5":30540,"_20923":124347,"_27449":124348,"_2949":124349},[],"/docs/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3465":72771,"_30211":72749,"_5":30540,"_20923":124351,"_27449":124352,"_2949":124353},[],"/docs/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3465":72772,"_30211":72749,"_5":30540,"_20923":124355,"_27449":124356,"_2949":124357},[],"/docs/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3465":72773,"_30211":72749,"_5":30540,"_20923":124359,"_27449":124360,"_2949":124361},[],"/docs/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3465":72774,"_30211":72749,"_5":30540,"_20923":124363,"_27449":124364,"_2949":124365},[],"/docs/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3465":72775,"_30211":72749,"_5":30540,"_20923":124367,"_27449":124368,"_2949":124369},[],"/docs/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3465":72776,"_30211":72749,"_5":30540,"_20923":124371,"_27449":124372,"_2949":124373},[],"/docs/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3465":72777,"_30211":72749,"_5":30540,"_20923":124375,"_27449":124376,"_2949":124377},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3465":72778,"_30211":72749,"_5":30540,"_20923":124379,"_27449":124380,"_2949":124381},[],"/docs/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3465":72779,"_30211":72749,"_5":30540,"_20923":124383,"_27449":124384,"_2949":124385},[],"/docs/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3465":72780,"_30211":72749,"_5":30540,"_20923":124387,"_27449":124388,"_2949":124389},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3465":72781,"_30211":72749,"_5":30540,"_20923":124391,"_27449":124392,"_2949":124393},[],"/docs/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3465":72782,"_30211":72749,"_5":30540,"_20923":124395,"_27449":124396,"_2949":124397},[],"/docs/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3465":72783,"_30211":72749,"_5":30540,"_20923":124399,"_27449":124400,"_2949":124401},[],"/docs/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3465":72784,"_30211":72749,"_5":30540,"_20923":124403,"_27449":124404,"_2949":124405},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3465":72785,"_30211":72749,"_5":30540,"_20923":124407,"_27449":124408,"_2949":124409},[],"/docs/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3465":72786,"_30211":72749,"_5":30540,"_20923":124411,"_27449":124412,"_2949":124413},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3465":72787,"_30211":72749,"_5":30540,"_20923":124415,"_27449":124416,"_2949":124417},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3465":72788,"_30211":72749,"_5":30540,"_20923":124419,"_27449":124420,"_2949":124421},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3465":72789,"_30211":72749,"_5":30540,"_20923":124423,"_27449":124424,"_2949":124425},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3465":72790,"_30211":72749,"_5":30540,"_20923":124427,"_27449":124428,"_2949":124429},[],"/docs/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3465":72791,"_30211":72749,"_5":30540,"_20923":124431,"_27449":124432,"_2949":120248},[],"/docs/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3465":72792,"_30211":72749,"_5":30540,"_20923":124434,"_27449":124435,"_2949":124436},[],"/docs/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3465":72793,"_30211":72749,"_5":30540,"_20923":124438,"_27449":124439,"_2949":124440},[],"/docs/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3465":72794,"_30211":72749,"_20923":124442,"_5":14374,"_27449":72749,"_2949":124443},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3465":72795,"_30211":72749,"_20923":124445,"_5":14374,"_27449":72749,"_2949":124446},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3465":72796,"_30211":72749,"_20923":124448,"_5":14374,"_27449":72749,"_2949":124449},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3465":72797,"_30211":72749,"_20923":124451,"_5":14374,"_27449":72749,"_2949":124452},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3465":72798,"_30211":72749,"_20923":124454,"_5":14374,"_27449":72749,"_2949":124455},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3465":72799,"_30211":72749,"_20923":124457,"_5":14374,"_27449":72749,"_2949":124458},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3465":72800,"_30211":72749,"_20923":124460,"_5":14374,"_27449":72749,"_2949":124461},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3465":72801,"_30211":72749,"_20923":124463,"_5":14374,"_27449":124277,"_2949":124464},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3465":72802,"_30211":72749,"_20923":124466,"_5":14374,"_27449":124277,"_2949":124467},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3465":72803,"_30211":72749,"_20923":124469,"_5":14374,"_27449":124281,"_2949":124470},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3465":72804,"_30211":72749,"_20923":124472,"_5":14374,"_27449":124281,"_2949":124473},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3465":72805,"_30211":72749,"_20923":124475,"_5":14374,"_27449":124285,"_2949":124476},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3465":72806,"_30211":72749,"_20923":124478,"_5":14374,"_27449":124289,"_2949":124479},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3465":72807,"_30211":72749,"_20923":124481,"_5":14374,"_27449":124289,"_2949":124482},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3465":72808,"_30211":72749,"_20923":124484,"_5":14374,"_27449":124289,"_2949":124485},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3465":72809,"_30211":72749,"_20923":124487,"_5":14374,"_27449":124289,"_2949":124488},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3465":72810,"_30211":72749,"_20923":124490,"_5":14374,"_27449":124289,"_2949":124491},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3465":72811,"_30211":72749,"_20923":124493,"_5":14374,"_27449":124293,"_2949":124494},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3465":72812,"_30211":72749,"_20923":124496,"_5":14374,"_27449":124293,"_2949":124497},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3465":72813,"_30211":72749,"_20923":124499,"_5":14374,"_27449":124293,"_2949":124500},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3465":72814,"_30211":72749,"_20923":124502,"_5":14374,"_27449":124293,"_2949":124503},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3465":72815,"_30211":72749,"_20923":124505,"_5":14374,"_27449":124293,"_2949":124506},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3465":72816,"_30211":72749,"_20923":124508,"_5":14374,"_27449":124293,"_2949":124509},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3465":72817,"_30211":72749,"_20923":124511,"_5":14374,"_27449":124297,"_2949":124512},[],"Cambio",{"_3465":72818,"_30211":72749,"_20923":124514,"_5":14374,"_27449":124297,"_2949":124515},[],"A quién afecta",{"_3465":72819,"_30211":72749,"_20923":124517,"_5":14374,"_27449":124297,"_2949":124518},[],"Gravedad",{"_3465":72820,"_30211":72749,"_20923":124520,"_5":14374,"_27449":124297,"_2949":123018},[],{"_3465":72821,"_30211":72749,"_20923":124522,"_5":14374,"_27449":124297,"_2949":124305},[],{"_3465":72822,"_30211":72749,"_20923":124524,"_5":14374,"_27449":124297,"_2949":124525},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3465":72823,"_30211":72749,"_20923":124527,"_5":14374,"_27449":124297,"_2949":124528},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3465":72824,"_30211":72749,"_20923":124530,"_5":14374,"_27449":124297,"_2949":124531},[],"Copiar los datos a los volúmenes nuevos",{"_3465":72825,"_30211":72749,"_20923":124533,"_5":14374,"_27449":124297,"_2949":124309},[],{"_3465":72826,"_30211":72749,"_20923":124535,"_5":14374,"_27449":124297,"_2949":124536},[],"Todas las releases de Helm",{"_3465":72827,"_30211":72749,"_20923":124538,"_5":14374,"_27449":124297,"_2949":124539},[],"Alta: `helm upgrade` falla",{"_3465":72828,"_30211":72749,"_20923":124541,"_5":14374,"_27449":124297,"_2949":124542},[],"Eliminar o renombrar las claves heredadas",{"_3465":72829,"_30211":72749,"_20923":124544,"_5":14374,"_27449":124297,"_2949":124313},[],{"_3465":72830,"_30211":72749,"_20923":124546,"_5":14374,"_27449":124297,"_2949":124547},[],"Todos los despliegues",{"_3465":72831,"_30211":72749,"_20923":124549,"_5":14374,"_27449":124297,"_2949":124550},[],"Alta: sin principal de bootstrap no hay administrador",{"_3465":72832,"_30211":72749,"_20923":124552,"_5":14374,"_27449":124297,"_2949":124553},[],"Configurar `services.authz`",{"_3465":72833,"_30211":72749,"_20923":124555,"_5":14374,"_27449":124297,"_2949":124317},[],{"_3465":72834,"_30211":72749,"_20923":124557,"_5":14374,"_27449":124297,"_2949":124536},[],{"_3465":72835,"_30211":72749,"_20923":124559,"_5":14374,"_27449":124297,"_2949":124560},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3465":72836,"_30211":72749,"_20923":124562,"_5":14374,"_27449":124297,"_2949":124563},[],"Mover JWKS y roles a `services.authz`",{"_3465":72837,"_30211":72749,"_20923":124565,"_5":14374,"_27449":124297,"_2949":124337},[],{"_3465":72838,"_30211":72749,"_20923":124567,"_5":14374,"_27449":124297,"_2949":124568},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3465":72839,"_30211":72749,"_20923":124570,"_5":14374,"_27449":124297,"_2949":124571},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3465":72840,"_30211":72749,"_20923":124573,"_5":14374,"_27449":124297,"_2949":124574},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3465":72841,"_30211":72749,"_20923":124576,"_5":14374,"_27449":124297,"_2949":124341},[],{"_3465":72842,"_30211":72749,"_20923":124578,"_5":14374,"_27449":124297,"_2949":124579},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3465":72843,"_30211":72749,"_20923":124581,"_5":14374,"_27449":124297,"_2949":124582},[],"Alta: el backend ya no arranca con ellos",{"_3465":72844,"_30211":72749,"_20923":124584,"_5":14374,"_27449":124297,"_2949":124585},[],"Pasar a PostgreSQL antes de actualizar",{"_3465":72845,"_30211":72749,"_20923":124587,"_5":14374,"_27449":124297,"_2949":124385},[],{"_3465":72846,"_30211":72749,"_20923":124589,"_5":14374,"_27449":124297,"_2949":124590},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3465":72847,"_30211":72749,"_20923":124592,"_5":14374,"_27449":124297,"_2949":124593},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3465":72848,"_30211":72749,"_20923":124595,"_5":14374,"_27449":124297,"_2949":124596},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3465":72849,"_30211":72749,"_20923":124598,"_5":14374,"_27449":124297,"_2949":124599},[],"Webhooks con referencias a archivos",{"_3465":72850,"_30211":72749,"_20923":124601,"_5":14374,"_27449":124297,"_2949":124602},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3465":72851,"_30211":72749,"_20923":124604,"_5":14374,"_27449":124297,"_2949":124605},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3465":72852,"_30211":72749,"_20923":124607,"_5":14374,"_27449":124297,"_2949":124608},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3465":72853,"_30211":72749,"_20923":124610,"_5":14374,"_27449":124297,"_2949":124321},[],{"_3465":72854,"_30211":72749,"_20923":124612,"_5":14374,"_27449":124297,"_2949":124613},[],"Releases con identidades por servicio o material de claves montado",{"_3465":72855,"_30211":72749,"_20923":124615,"_5":14374,"_27449":124297,"_2949":124616},[],"Media: los servicios no pueden leer sus archivos",{"_3465":72856,"_30211":72749,"_20923":124618,"_5":14374,"_27449":124297,"_2949":124619},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3465":72857,"_30211":72749,"_20923":124621,"_5":14374,"_27449":124297,"_2949":124325},[],{"_3465":72858,"_30211":72749,"_20923":124623,"_5":14374,"_27449":124297,"_2949":124624},[],"Releases que definen `amqp.tls`",{"_3465":72859,"_30211":72749,"_20923":124626,"_5":14374,"_27449":124297,"_2949":124627},[],"Media: los clientes se conectan al puerto equivocado",{"_3465":72860,"_30211":72749,"_20923":124629,"_5":14374,"_27449":124297,"_2949":124630},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3465":72861,"_30211":72749,"_20923":124632,"_5":14374,"_27449":124297,"_2949":124345},[],{"_3465":72862,"_30211":72749,"_20923":124634,"_5":14374,"_27449":124297,"_2949":124635},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3465":72863,"_30211":72749,"_20923":124637,"_5":14374,"_27449":124297,"_2949":124638},[],"Media: las claves de CA quedan sin gestionar",{"_3465":72864,"_30211":72749,"_20923":124640,"_5":14374,"_27449":124297,"_2949":124641},[],"Ejecutar la migración de CA a KMS",{"_3465":72865,"_30211":72749,"_20923":124643,"_5":14374,"_27449":124297,"_2949":124644},[],"Verificación del certificado del receptor",{"_3465":72866,"_30211":72749,"_20923":124646,"_5":14374,"_27449":124297,"_2949":124647},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3465":72867,"_30211":72749,"_20923":124649,"_5":14374,"_27449":124297,"_2949":124650},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3465":72868,"_30211":72749,"_20923":124652,"_5":14374,"_27449":124297,"_2949":124653},[],"Poner `insecure_skip_verify` a `false`",{"_3465":72869,"_30211":72749,"_20923":124655,"_5":14374,"_27449":124297,"_2949":124361},[],{"_3465":72870,"_30211":72749,"_20923":124657,"_5":14374,"_27449":124297,"_2949":124658},[],"Scripts y consolas que editan DMS por API",{"_3465":72871,"_30211":72749,"_20923":124660,"_5":14374,"_27449":124297,"_2949":124661},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3465":72872,"_30211":72749,"_20923":124663,"_5":14374,"_27449":124297,"_2949":124664},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3465":72873,"_30211":72749,"_20923":124666,"_5":14374,"_27449":124297,"_2949":124381},[],{"_3465":72874,"_30211":72749,"_20923":124668,"_5":14374,"_27449":124297,"_2949":124669},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3465":72875,"_30211":72749,"_20923":124671,"_5":14374,"_27449":124297,"_2949":124672},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3465":72876,"_30211":72749,"_20923":124674,"_5":14374,"_27449":124297,"_2949":124675},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3465":72877,"_30211":72749,"_20923":124677,"_5":14374,"_27449":124297,"_2949":124389},[],{"_3465":72878,"_30211":72749,"_20923":124679,"_5":14374,"_27449":124297,"_2949":124680},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3465":72879,"_30211":72749,"_20923":124682,"_5":14374,"_27449":124297,"_2949":124683},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3465":72880,"_30211":72749,"_20923":124685,"_5":14374,"_27449":124297,"_2949":124686},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3465":72881,"_30211":72749,"_20923":124688,"_5":14374,"_27449":124297,"_2949":124377},[],{"_3465":72882,"_30211":72749,"_20923":124690,"_5":14374,"_27449":124297,"_2949":124691},[],"Consumidores que leen el campo `events` del dispositivo",{"_3465":72883,"_30211":72749,"_20923":124693,"_5":14374,"_27449":124297,"_2949":124694},[],"Media: el campo desaparece",{"_3465":72884,"_30211":72749,"_20923":124696,"_5":14374,"_27449":124297,"_2949":124697},[],"Usar los nuevos endpoints de eventos",{"_3465":72885,"_30211":72749,"_20923":124699,"_5":14374,"_27449":124297,"_2949":124397},[],{"_3465":72886,"_30211":72749,"_20923":124701,"_5":14374,"_27449":124297,"_2949":124702},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3465":72887,"_30211":72749,"_20923":124704,"_5":14374,"_27449":124297,"_2949":124705},[],"Media: la migración de la VA aborta",{"_3465":72888,"_30211":72749,"_20923":124707,"_5":14374,"_27449":124297,"_2949":124708},[],"Corregir los roles afectados antes de actualizar",{"_3465":72889,"_30211":72749,"_20923":124710,"_5":14374,"_27449":124297,"_2949":124329},[],{"_3465":72890,"_30211":72749,"_20923":124712,"_5":14374,"_27449":124297,"_2949":124713},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3465":72891,"_30211":72749,"_20923":124715,"_5":14374,"_27449":124297,"_2949":124716},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3465":72892,"_30211":72749,"_20923":124718,"_5":14374,"_27449":124297,"_2949":124719},[],"Actualizar el archivo de values",{"_3465":72893,"_30211":72749,"_20923":124721,"_5":14374,"_27449":124297,"_2949":124369},[],{"_3465":72894,"_30211":72749,"_20923":124723,"_5":14374,"_27449":124297,"_2949":124724},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3465":72895,"_30211":72749,"_20923":124726,"_5":14374,"_27449":124297,"_2949":124727},[],"Baja: prevalece el ID de la URL",{"_3465":72896,"_30211":72749,"_20923":124729,"_5":14374,"_27449":124297,"_2949":124730},[],"Enviar el ID en la URL",{"_3465":72897,"_30211":72749,"_20923":124732,"_5":14374,"_27449":124297,"_2949":124393},[],{"_3465":72898,"_30211":72749,"_20923":124734,"_5":14374,"_27449":124297,"_2949":124735},[],"Clientes que envían un `id` al crear o importar CAs",{"_3465":72899,"_30211":72749,"_20923":124737,"_5":14374,"_27449":124297,"_2949":124738},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3465":72900,"_30211":72749,"_20923":124740,"_5":14374,"_27449":124297,"_2949":124741},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3465":72901,"_30211":72749,"_20923":124743,"_5":14374,"_27449":124297,"_2949":124373},[],{"_3465":72902,"_30211":72749,"_20923":124745,"_5":14374,"_27449":124297,"_2949":124746},[],"Consumidores que comparan el `type` del certificado",{"_3465":72903,"_30211":72749,"_20923":124748,"_5":14374,"_27449":124297,"_2949":124749},[],"Baja: dos valores cambian de nombre",{"_3465":72904,"_30211":72749,"_20923":124751,"_5":14374,"_27449":124297,"_2949":124752},[],"Adaptar los consumidores",{"_3465":72905,"_30211":72749,"_20923":124754,"_5":14374,"_27449":124297,"_2949":124365},[],{"_3465":72906,"_30211":72749,"_20923":124756,"_5":14374,"_27449":124297,"_2949":124757},[],"Cualquier DMS",{"_3465":72907,"_30211":72749,"_20923":124759,"_5":14374,"_27449":124297,"_2949":124760},[],"Baja: solo informativo",{"_3465":72908,"_30211":72749,"_20923":124762,"_5":14374,"_27449":124297,"_2949":124763},[],"Revisar ambos bloques antes de editar",{"_3465":72909,"_30211":72749,"_20923":124765,"_5":14374,"_27449":124304,"_2949":124766},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3465":72910,"_30211":72749,"_20923":124768,"_5":14374,"_27449":124304,"_2949":124769},[],"El paso 4 de la guía de migración copia los datos.",{"_3465":72911,"_30211":72749,"_20923":124771,"_5":14374,"_27449":124308,"_2949":124772},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3465":72912,"_30211":72749,"_20923":124774,"_5":14374,"_27449":124312,"_2949":124775},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3465":72913,"_30211":72749,"_20923":124777,"_5":14374,"_27449":124316,"_2949":124778},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3465":72914,"_30211":72749,"_20923":124780,"_5":14374,"_27449":124320,"_2949":124781},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3465":72915,"_30211":72749,"_20923":124783,"_5":14374,"_27449":124320,"_2949":124784},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3465":72916,"_30211":72749,"_20923":124786,"_5":14374,"_27449":124324,"_2949":124787},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3465":72917,"_30211":72749,"_20923":124789,"_5":14374,"_27449":124328,"_2949":124790},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3465":72918,"_30211":72749,"_20923":124792,"_5":14374,"_27449":124328,"_2949":124793},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3465":72919,"_30211":72749,"_20923":124795,"_5":14374,"_27449":124328,"_2949":124796},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3465":72920,"_30211":72749,"_20923":124798,"_5":14374,"_27449":124328,"_2949":124799},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3465":72921,"_30211":72749,"_20923":124801,"_5":14374,"_27449":124328,"_2949":124802},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3465":72922,"_30211":72749,"_20923":124804,"_5":14374,"_27449":124328,"_2949":124805},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3465":72923,"_30211":72749,"_20923":124807,"_5":14374,"_27449":124336,"_2949":124808},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3465":72924,"_30211":72749,"_20923":124810,"_5":14374,"_27449":124336,"_2949":124811},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3465":72925,"_30211":72749,"_20923":124813,"_5":14374,"_27449":124336,"_2949":124814},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3465":72926,"_30211":72749,"_20923":124816,"_5":14374,"_27449":124336,"_2949":124817},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3465":72927,"_30211":72749,"_20923":124819,"_5":14374,"_27449":124336,"_2949":124820},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3465":72928,"_30211":72749,"_20923":124822,"_5":14374,"_27449":124340,"_2949":124823},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3465":72929,"_30211":72749,"_20923":124825,"_5":14374,"_27449":124344,"_2949":124826},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3465":72930,"_30211":72749,"_20923":124828,"_5":14374,"_27449":124344,"_2949":124829},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3465":72931,"_30211":72749,"_20923":124831,"_5":14374,"_27449":124344,"_2949":124832},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3465":72932,"_30211":72749,"_20923":124834,"_5":14374,"_27449":124344,"_2949":124835},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3465":72933,"_30211":72749,"_20923":124837,"_5":14374,"_27449":124344,"_2949":124838},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3465":72934,"_30211":72749,"_20923":124840,"_5":14374,"_27449":124344,"_2949":124841},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3465":72935,"_30211":72749,"_20923":124843,"_5":14374,"_27449":124344,"_2949":124844},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3465":72936,"_30211":72749,"_20923":124846,"_5":14374,"_27449":124344,"_2949":124847},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3465":72937,"_30211":72749,"_20923":124849,"_5":14374,"_27449":124348,"_2949":124850},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3465":72938,"_30211":72749,"_20923":124852,"_5":14374,"_27449":124356,"_2949":124853},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3465":72939,"_30211":72749,"_20923":124855,"_5":14374,"_27449":124356,"_2949":124856},[],"Campo en 3.8.0",{"_3465":72940,"_30211":72749,"_20923":124858,"_5":14374,"_27449":124356,"_2949":124859},[],"Campo en 4.0.0",{"_3465":72941,"_30211":72749,"_20923":124861,"_5":14374,"_27449":124356,"_2949":58017},[],{"_3465":72942,"_30211":72749,"_20923":124863,"_5":14374,"_27449":124356,"_2949":124864},[],"`insecure_skip_verify` (con el valor negado)",{"_3465":72943,"_30211":72749,"_20923":124866,"_5":14374,"_27449":124356,"_2949":58023},[],{"_3465":72944,"_30211":72749,"_20923":124868,"_5":14374,"_27449":124356,"_2949":58026},[],{"_3465":72945,"_30211":72749,"_20923":124870,"_5":14374,"_27449":124356,"_2949":58029},[],{"_3465":72946,"_30211":72749,"_20923":124872,"_5":14374,"_27449":124356,"_2949":58032},[],{"_3465":72947,"_30211":72749,"_20923":124874,"_5":14374,"_27449":124356,"_2949":58035},[],{"_3465":72948,"_30211":72749,"_20923":124876,"_5":14374,"_27449":124356,"_2949":58038},[],{"_3465":72949,"_30211":72749,"_20923":124878,"_5":14374,"_27449":124356,"_2949":124879},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3465":72950,"_30211":72749,"_20923":124881,"_5":14374,"_27449":124356,"_2949":124882},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3465":72951,"_30211":72749,"_20923":124884,"_5":14374,"_27449":124356,"_2949":124885},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3465":72952,"_30211":72749,"_20923":124887,"_5":14374,"_27449":124360,"_2949":124888},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3465":72953,"_30211":72749,"_20923":124890,"_5":14374,"_27449":124360,"_2949":124891},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3465":72954,"_30211":72749,"_20923":124893,"_5":14374,"_27449":124360,"_2949":124894},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3465":72955,"_30211":72749,"_20923":124896,"_5":14374,"_27449":124364,"_2949":124897},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3465":72956,"_30211":72749,"_20923":124899,"_5":14374,"_27449":124368,"_2949":124900},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3465":72957,"_30211":72749,"_20923":124902,"_5":14374,"_27449":124372,"_2949":124903},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3465":72958,"_30211":72749,"_20923":124905,"_5":14374,"_27449":124376,"_2949":124906},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3465":72959,"_30211":72749,"_20923":124908,"_5":14374,"_27449":124376,"_2949":124909},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3465":72960,"_30211":72749,"_20923":124911,"_5":14374,"_27449":124376,"_2949":124912},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3465":72961,"_30211":72749,"_20923":124914,"_5":14374,"_27449":124376,"_2949":124915},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3465":72962,"_30211":72749,"_20923":124917,"_5":14374,"_27449":124380,"_2949":124918},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3465":72963,"_30211":72749,"_20923":124920,"_5":14374,"_27449":124384,"_2949":124921},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3465":72964,"_30211":72749,"_20923":124923,"_5":14374,"_27449":124384,"_2949":124924},[],"Ruta",{"_3465":72965,"_30211":72749,"_20923":124926,"_5":14374,"_27449":124384,"_2949":117487},[],{"_3465":72966,"_30211":72749,"_20923":124928,"_5":14374,"_27449":124384,"_2949":58091},[],{"_3465":72967,"_30211":72749,"_20923":124930,"_5":14374,"_27449":124384,"_2949":124931},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3465":72968,"_30211":72749,"_20923":124933,"_5":14374,"_27449":124384,"_2949":58097},[],{"_3465":72969,"_30211":72749,"_20923":124935,"_5":14374,"_27449":124384,"_2949":124936},[],"Lee los ajustes de una CA.",{"_3465":72970,"_30211":72749,"_20923":124938,"_5":14374,"_27449":124384,"_2949":58103},[],{"_3465":72971,"_30211":72749,"_20923":124940,"_5":14374,"_27449":124384,"_2949":124941},[],"Sustituye los `crl_options`.",{"_3465":72972,"_30211":72749,"_20923":124943,"_5":14374,"_27449":124384,"_2949":124944},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3465":72973,"_30211":72749,"_20923":124946,"_5":14374,"_27449":124384,"_2949":124947},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3465":72974,"_30211":72749,"_20923":124949,"_5":14374,"_27449":124384,"_2949":124950},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3465":72975,"_30211":72749,"_20923":124952,"_5":14374,"_27449":124384,"_2949":124953},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3465":72976,"_30211":72749,"_20923":124955,"_5":14374,"_27449":124384,"_2949":124956},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3465":72977,"_30211":72749,"_20923":124958,"_5":14374,"_27449":124384,"_2949":124959},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3465":72978,"_30211":72749,"_20923":124961,"_5":14374,"_27449":124384,"_2949":124962},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3465":72979,"_30211":72749,"_20923":124964,"_5":14374,"_27449":124384,"_2949":124965},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3465":72980,"_30211":72749,"_20923":124967,"_5":14374,"_27449":124384,"_2949":124968},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3465":72981,"_30211":72749,"_20923":124970,"_5":14374,"_27449":124384,"_2949":124971},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3465":72982,"_30211":72749,"_20923":124973,"_5":14374,"_27449":124384,"_2949":124974},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3465":72983,"_30211":72749,"_20923":124976,"_5":14374,"_27449":124388,"_2949":124977},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3465":72984,"_30211":72749,"_20923":124979,"_5":14374,"_27449":124392,"_2949":124980},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3465":72985,"_30211":72749,"_20923":124982,"_5":14374,"_27449":124396,"_2949":124983},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3465":72986,"_30211":72749,"_20923":124985,"_5":14374,"_27449":124400,"_2949":124986},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3465":72987,"_30211":72749,"_20923":124988,"_5":14374,"_27449":124404,"_2949":124989},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3465":72988,"_30211":72749,"_20923":124991,"_5":14374,"_27449":124404,"_2949":124992},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3465":72989,"_30211":72749,"_20923":124994,"_5":14374,"_27449":124404,"_2949":124995},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3465":72990,"_30211":72749,"_20923":124997,"_5":14374,"_27449":124404,"_2949":124998},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3465":72991,"_30211":72749,"_20923":125000,"_5":14374,"_27449":124404,"_2949":125001},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3465":72992,"_30211":72749,"_20923":125003,"_5":14374,"_27449":124404,"_2949":125004},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3465":72993,"_30211":72749,"_20923":125006,"_5":14374,"_27449":124408,"_2949":125007},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3465":72994,"_30211":72749,"_20923":125009,"_5":14374,"_27449":124408,"_2949":125010},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3465":72995,"_30211":72749,"_20923":125012,"_5":14374,"_27449":124408,"_2949":125013},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3465":72996,"_30211":72749,"_20923":125015,"_5":14374,"_27449":124408,"_2949":125016},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3465":72997,"_30211":72749,"_20923":125018,"_5":14374,"_27449":124408,"_2949":125019},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3465":72998,"_30211":72749,"_20923":125021,"_5":14374,"_27449":124412,"_2949":125022},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3465":72999,"_30211":72749,"_20923":125024,"_5":14374,"_27449":124412,"_2949":125025},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3465":73000,"_30211":72749,"_20923":125027,"_5":14374,"_27449":124412,"_2949":125028},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3465":73001,"_30211":72749,"_20923":125030,"_5":14374,"_27449":124412,"_2949":125031},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3465":73002,"_30211":72749,"_20923":125033,"_5":14374,"_27449":124412,"_2949":125034},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3465":73003,"_30211":72749,"_20923":125036,"_5":14374,"_27449":124412,"_2949":125037},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3465":73004,"_30211":72749,"_20923":125039,"_5":14374,"_27449":124412,"_2949":125040},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3465":73005,"_30211":72749,"_20923":125042,"_5":14374,"_27449":124412,"_2949":125043},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3465":73006,"_30211":72749,"_20923":125045,"_5":14374,"_27449":124412,"_2949":125046},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3465":73007,"_30211":72749,"_20923":125048,"_5":14374,"_27449":124412,"_2949":125049},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3465":73008,"_30211":72749,"_20923":125051,"_5":14374,"_27449":124412,"_2949":125052},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3465":73009,"_30211":72749,"_20923":125054,"_5":14374,"_27449":124412,"_2949":125055},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3465":73010,"_30211":72749,"_20923":125057,"_5":14374,"_27449":124416,"_2949":125058},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3465":73011,"_30211":72749,"_20923":125060,"_5":14374,"_27449":124416,"_2949":125061},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3465":73012,"_30211":72749,"_20923":125063,"_5":14374,"_27449":124420,"_2949":125064},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3465":73013,"_30211":72749,"_20923":125066,"_5":14374,"_27449":124420,"_2949":125067},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3465":73014,"_30211":72749,"_20923":125069,"_5":14374,"_27449":124420,"_2949":125070},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3465":73015,"_30211":72749,"_20923":125072,"_5":14374,"_27449":124420,"_2949":125073},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3465":73016,"_30211":72749,"_20923":125075,"_5":14374,"_27449":124420,"_2949":125076},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3465":73017,"_30211":72749,"_20923":125078,"_5":14374,"_27449":124420,"_2949":125079},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3465":73018,"_30211":72749,"_20923":125081,"_5":14374,"_27449":124420,"_2949":125082},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3465":73019,"_30211":72749,"_20923":125084,"_5":14374,"_27449":124420,"_2949":125085},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3465":73020,"_30211":72749,"_20923":125087,"_5":14374,"_27449":124420,"_2949":125088},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3465":73021,"_30211":72749,"_20923":125090,"_5":14374,"_27449":124420,"_2949":125091},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3465":73022,"_30211":72749,"_20923":125093,"_5":14374,"_27449":124420,"_2949":125094},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3465":73023,"_30211":72749,"_20923":125096,"_5":14374,"_27449":124424,"_2949":125097},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3465":73024,"_30211":72749,"_20923":125099,"_5":14374,"_27449":124424,"_2949":125100},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3465":73025,"_30211":72749,"_20923":125102,"_5":14374,"_27449":124428,"_2949":125103},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3465":73026,"_30211":72749,"_20923":125105,"_5":14374,"_27449":124428,"_2949":125106},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3465":73027,"_30211":72749,"_20923":125108,"_5":14374,"_27449":124428,"_2949":125109},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` también requiere que `ca` se haya migrado primero.",{"_3465":73028,"_30211":72749,"_20923":125111,"_5":14374,"_27449":124428,"_2949":125112},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates` y `SELECT` sobre `ca.ca_certificates`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`.",{"_3465":73029,"_30211":72749,"_20923":125114,"_5":14374,"_27449":124428,"_2949":125115},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3465":73030,"_30211":72749,"_20923":125117,"_5":14374,"_27449":124428,"_2949":125118},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3465":73031,"_30211":72749,"_20923":125120,"_5":14374,"_27449":124428,"_2949":125121},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3465":73032,"_30211":72749,"_20923":125123,"_5":14374,"_27449":124428,"_2949":125124},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3465":73033,"_30211":72749,"_20923":125126,"_5":14374,"_27449":124432,"_2949":125127},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3465":73034,"_30211":72749,"_20923":125129,"_5":14374,"_27449":124432,"_2949":125130},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3465":73035,"_30211":72749,"_20923":125132,"_5":14374,"_27449":124432,"_2949":125133},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3465":73036,"_30211":72749,"_20923":125135,"_5":14374,"_27449":124432,"_2949":125136},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3465":73037,"_30211":72749,"_20923":125138,"_5":14374,"_27449":124432,"_2949":125139},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3465":73038,"_30211":72749,"_20923":125141,"_5":14374,"_27449":124432,"_2949":125142},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3465":73039,"_30211":72749,"_20923":125144,"_5":14374,"_27449":124432,"_2949":125145},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3465":73040,"_30211":72749,"_20923":125147,"_5":14374,"_27449":124432,"_2949":125148},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que la del esquema `ca`.",{"_3465":73041,"_30211":72749,"_20923":125150,"_5":14374,"_27449":124432,"_2949":125151},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3465":73042,"_30211":72749,"_20923":125153,"_5":14374,"_27449":124432,"_2949":125154},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3465":73043,"_30211":72749,"_20923":125156,"_5":14374,"_27449":124432,"_2949":125157},[],"**Una migración o un servicio falla con `permission denied for table ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración. Concede los privilegios que falten y vuelve a ejecutar.",{"_3465":73044,"_30211":72749,"_20923":125159,"_5":14374,"_27449":124435,"_2949":125160},[],"Tras la actualización, comprueba en este orden:",{"_3465":73045,"_30211":72749,"_20923":125162,"_5":14374,"_27449":124435,"_2949":125163},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3465":73046,"_30211":72749,"_20923":125165,"_5":14374,"_27449":124435,"_2949":125166},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3465":73047,"_30211":72749,"_20923":125168,"_5":14374,"_27449":124435,"_2949":125169},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3465":73048,"_30211":72749,"_20923":125171,"_5":14374,"_27449":124435,"_2949":125172},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3465":73049,"_30211":72749,"_20923":125174,"_5":14374,"_27449":124435,"_2949":125175},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3465":73050,"_30211":72749,"_20923":125177,"_5":14374,"_27449":124435,"_2949":125178},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3465":73051,"_30211":72749,"_20923":125180,"_5":14374,"_27449":124435,"_2949":125181},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3465":73052,"_30211":72749,"_20923":125183,"_5":14374,"_27449":124435,"_2949":125184},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3465":73053,"_30211":72749,"_20923":125186,"_5":14374,"_27449":124435,"_2949":125187},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3465":73054,"_30211":72749,"_20923":125189,"_5":14374,"_27449":124435,"_2949":125190},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3465":73055,"_30211":72749,"_20923":125192,"_5":14374,"_27449":124435,"_2949":125193},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3465":73056,"_30211":72749,"_20923":125195,"_5":14374,"_27449":124435,"_2949":125196},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3465":73057,"_30211":72749,"_20923":125198,"_5":14374,"_27449":124435,"_2949":125199},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3465":73058,"_30211":72749,"_20923":125201,"_5":14374,"_27449":124435,"_2949":125202},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3465":73059,"_30211":72749,"_20923":125204,"_5":14374,"_27449":124435,"_2949":125205},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3465":73060,"_30211":72749,"_20923":125207,"_5":14374,"_27449":124439,"_2949":125208},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3465":73061,"_30211":72749,"_20923":125210,"_5":14374,"_27449":124439,"_2949":125211},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3465":73062,"_30211":72749,"_20923":125213,"_5":14374,"_27449":124439,"_2949":125214},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3465":73063,"_30211":72749,"_20923":125216,"_5":14374,"_27449":124439,"_2949":125217},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3465":73064,"_30211":72749,"_20923":125219,"_5":14374,"_27449":124439,"_2949":125220},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_58388":125222,"_58390":125223,"_58392":125224,"_58394":125225,"_18129":2984,"_70129":2984},"spanish",[2949,30211,5,27449],{"_2949":25028,"_30211":25028,"_5":25028,"_27449":25028},{"_2949":125226,"_30211":128158,"_5":131090,"_27449":134022},{"_4648":125227,"_58398":125228,"_5":25028},{"_14450":7292,"_14825":7293,"_14844":5965,"_29214":3653,"_14831":6554,"_19855":9048,"_14471":6974,"_14478":13294,"_29156":3041,"_29565":4386,"_29586":6545,"_29190":7030,"_34520":4036,"_29293":20335,"_29630":9860,"_34527":22843,"_34530":5817,"_34533":14417,"_34536":8654,"_30037":14331,"_34541":5439,"_34543":17211,"_30067":15779,"_14840":8854,"_34547":7502,"_34550":3256,"_34552":3094,"_29614":6983,"_30032":3036,"_30080":6021,"_34557":4953,"_34559":3768,"_34561":17019,"_29310":7139,"_34564":3337,"_34566":3808,"_34568":7590,"_34570":7140,"_34572":5055,"_29227":10979,"_34575":3299,"_34577":5057,"_29221":25442,"_29651":11083,"_34581":3589,"_34583":10771,"_34586":5257,"_29267":20154,"_34590":4969,"_29147":19198,"_34593":9466,"_29195":20162,"_34596":15706,"_34598":3730,"_34601":18210,"_14834":3239,"_34604":4711,"_34606":4959,"_34609":6994,"_34611":3261,"_34613":4394,"_34615":4957,"_34617":6188,"_19858":3335,"_34620":10486,"_34622":4051,"_29168":4393,"_29608":3432,"_34626":10130,"_34628":4052,"_34630":7352,"_30097":8417,"_34633":22742,"_34635":4053,"_3