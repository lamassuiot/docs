0471":125512,"_40473":125515,"_40475":125518,"_40477":125521,"_40480":125524,"_40482":125527,"_40484":125530,"_40486":125533,"_40488":125536,"_40490":125539,"_40492":125542,"_40494":125545,"_40496":125548,"_40498":125551,"_40500":125554,"_40502":125557,"_40504":125560,"_40506":125563,"_40508":125566,"_40510":125569,"_40512":125572,"_40514":125575,"_40516":125578,"_40518":125581,"_40520":125584,"_40522":125587,"_40524":125590,"_40526":125593,"_40528":125596,"_40530":125599,"_40533":125602,"_40535":125605,"_40537":125608},{"_3471":70353,"_30355":70353,"_5":14772,"_2954":116659,"_30687":116660,"_21010":116663,"_27589":70353},"Despliega desde AWS Marketplace",[49421,116661,116662],"Despliegue","Otros modelos",[],{"_3471":70354,"_30355":70353,"_21010":116665,"_5":14420,"_27589":70353,"_2954":116666},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3471":70355,"_30355":70353,"_5":30684,"_21010":116668,"_27589":116669,"_2954":116670},[],"/docs/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3471":70356,"_30355":70353,"_5":30684,"_21010":116672,"_27589":116673,"_2954":116674},[],"/docs/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3471":70357,"_30355":70353,"_5":30684,"_21010":116676,"_27589":116677,"_2954":116678},[],"/docs/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3471":70358,"_30355":70353,"_5":30684,"_21010":116680,"_27589":116681,"_2954":116682},[],"/docs/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3471":70359,"_30355":70353,"_5":30684,"_21010":116684,"_27589":116685,"_2954":116686},[],"/docs/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3471":70360,"_30355":70353,"_5":30684,"_21010":116688,"_27589":116689,"_2954":116690},[],"/docs/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3471":70361,"_30355":70353,"_5":30684,"_21010":116692,"_27589":116693,"_2954":116694},[],"/docs/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3471":70362,"_30355":70353,"_21010":116696,"_5":14420,"_27589":70353,"_2954":116697},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3471":70363,"_30355":70353,"_21010":116699,"_5":14420,"_27589":116669,"_2954":116700},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3471":70364,"_30355":70353,"_21010":116702,"_5":14420,"_27589":116669,"_2954":116703},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3471":70365,"_30355":70353,"_21010":116705,"_5":14420,"_27589":116669,"_2954":116706},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3471":70366,"_30355":70353,"_21010":116708,"_5":14420,"_27589":116673,"_2954":116709},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3471":70367,"_30355":70353,"_21010":116711,"_5":14420,"_27589":116673,"_2954":116712},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3471":70368,"_30355":70353,"_21010":116714,"_5":14420,"_27589":116673,"_2954":116715},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3471":70369,"_30355":70353,"_21010":116717,"_5":14420,"_27589":116677,"_2954":116718},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3471":70370,"_30355":70353,"_21010":116720,"_5":14420,"_27589":116681,"_2954":116721},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3471":70371,"_30355":70353,"_21010":116723,"_5":14420,"_27589":116685,"_2954":116724},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3471":70372,"_30355":70353,"_21010":116726,"_5":14420,"_27589":116689,"_2954":116727},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3471":70373,"_30355":70353,"_21010":116729,"_5":14420,"_27589":116693,"_2954":116730},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3471":70374,"_30355":70374,"_5":14772,"_2954":116732,"_30687":116733,"_21010":116734,"_27589":70374},"Despliega Lamassu",[49421,116661],[],{"_3471":70375,"_30355":70374,"_21010":116736,"_5":14420,"_27589":70374,"_2954":116737},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3471":70376,"_30355":70374,"_5":30684,"_21010":116739,"_27589":116740,"_2954":116741},[],"/docs/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3471":70377,"_30355":70374,"_5":30684,"_21010":116743,"_27589":116744,"_2954":116745},[],"/docs/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3471":70378,"_30355":70374,"_5":30684,"_21010":116747,"_27589":116748,"_2954":116749},[],"/docs/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3471":70379,"_30355":70374,"_21010":116751,"_5":14420,"_27589":70374,"_2954":116752},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3471":70380,"_30355":70374,"_21010":116754,"_5":14420,"_27589":116740,"_2954":116755},[],"Modelo",{"_3471":70381,"_30355":70374,"_21010":116757,"_5":14420,"_27589":116740,"_2954":116758},[],"Recomendado para",{"_3471":70382,"_30355":70374,"_21010":116760,"_5":14420,"_27589":116740,"_2954":116761},[],"Quién opera la infraestructura",{"_3471":70383,"_30355":70374,"_21010":116763,"_5":14420,"_27589":116740,"_2954":116764},[],"Punto de partida",{"_3471":70384,"_30355":70374,"_21010":116766,"_5":14420,"_27589":116740,"_2954":49528},[],{"_3471":70385,"_30355":70374,"_21010":116768,"_5":14420,"_27589":116740,"_2954":116769},[],"Producción, entornos regulados y despliegues personalizados",{"_3471":70386,"_30355":70374,"_21010":116771,"_5":14420,"_27589":116740,"_2954":116772},[],"Tu equipo",{"_3471":70387,"_30355":70374,"_21010":116774,"_5":14420,"_27589":116740,"_2954":116775},[],"Helm o Fastlane",{"_3471":70388,"_30355":70374,"_21010":116777,"_5":14420,"_27589":116740,"_2954":49540},[],{"_3471":70389,"_30355":70374,"_21010":116779,"_5":14420,"_27589":116740,"_2954":116780},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3471":70390,"_30355":70374,"_21010":116782,"_5":14420,"_27589":116740,"_2954":116772},[],{"_3471":70391,"_30355":70374,"_21010":116784,"_5":14420,"_27589":116740,"_2954":116785},[],"Imagen preconfigurada en EC2",{"_3471":70392,"_30355":70374,"_21010":116787,"_5":14420,"_27589":116740,"_2954":49551},[],{"_3471":70393,"_30355":70374,"_21010":116789,"_5":14420,"_27589":116740,"_2954":116790},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3471":70394,"_30355":70374,"_21010":116792,"_5":14420,"_27589":116740,"_2954":49557},[],{"_3471":70395,"_30355":70374,"_21010":116794,"_5":14420,"_27589":116740,"_2954":116795},[],"Suscripción gestionada",{"_3471":70396,"_30355":70374,"_21010":116797,"_5":14420,"_27589":116740,"_2954":116798},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3471":70397,"_30355":70374,"_21010":116800,"_5":14420,"_27589":116740,"_2954":116801},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3471":70398,"_30355":70374,"_21010":116803,"_5":14420,"_27589":116740,"_2954":116804},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3471":70399,"_30355":70374,"_21010":116806,"_5":14420,"_27589":116744,"_2954":116807},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3471":70400,"_30355":70374,"_21010":116809,"_5":14420,"_27589":116748,"_2954":116810},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3471":70401,"_30355":70401,"_5":14772,"_2954":116812,"_30687":116813,"_21010":116814,"_27589":70401},"Utiliza Lamassu como SaaS",[49421,116661,116662],[],{"_3471":70402,"_30355":70401,"_21010":116816,"_5":14420,"_27589":70401,"_2954":116817},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3471":70403,"_30355":70401,"_5":30684,"_21010":116819,"_27589":116820,"_2954":116821},[],"/docs/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3471":70404,"_30355":70401,"_5":30684,"_21010":116823,"_27589":116824,"_2954":116825},[],"/docs/es/deployment/saas#planes","Planes",{"_3471":70405,"_30355":70401,"_5":30684,"_21010":116827,"_27589":116828,"_2954":116829},[],"/docs/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3471":70406,"_30355":70401,"_21010":116831,"_5":14420,"_27589":70401,"_2954":116832},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3471":70407,"_30355":70401,"_21010":116834,"_5":14420,"_27589":116820,"_2954":116835},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3471":70408,"_30355":70401,"_21010":116837,"_5":14420,"_27589":116820,"_2954":116838},[],"Copias de seguridad automáticas.",{"_3471":70409,"_30355":70401,"_21010":116840,"_5":14420,"_27589":116820,"_2954":116841},[],"Actualizaciones de versión.",{"_3471":70410,"_30355":70401,"_21010":116843,"_5":14420,"_27589":116820,"_2954":116844},[],"Soporte técnico y SLA según el plan contratado.",{"_3471":70411,"_30355":70401,"_21010":116846,"_5":14420,"_27589":116824,"_2954":49612},[],{"_3471":70412,"_30355":70401,"_21010":116848,"_5":14420,"_27589":116824,"_2954":116849},[],"Dispositivos",{"_3471":70413,"_30355":70401,"_21010":116851,"_5":14420,"_27589":116824,"_2954":116852},[],"Soporte",{"_3471":70414,"_30355":70401,"_21010":116854,"_5":14420,"_27589":116824,"_2954":49621},[],{"_3471":70415,"_30355":70401,"_21010":116856,"_5":14420,"_27589":116824,"_2954":49624},[],{"_3471":70416,"_30355":70401,"_21010":116858,"_5":14420,"_27589":116824,"_2954":116859},[],"Hasta 1.000",{"_3471":70417,"_30355":70401,"_21010":116861,"_5":14420,"_27589":116824,"_2954":49630},[],{"_3471":70418,"_30355":70401,"_21010":116863,"_5":14420,"_27589":116824,"_2954":116864},[],"99,5 %",{"_3471":70419,"_30355":70401,"_21010":116866,"_5":14420,"_27589":116824,"_2954":49636},[],{"_3471":70420,"_30355":70401,"_21010":116868,"_5":14420,"_27589":116824,"_2954":116869},[],"Hasta 10.000",{"_3471":70421,"_30355":70401,"_21010":116871,"_5":14420,"_27589":116824,"_2954":116872},[],"Email y chat",{"_3471":70422,"_30355":70401,"_21010":116874,"_5":14420,"_27589":116824,"_2954":116875},[],"99,9 %",{"_3471":70423,"_30355":70401,"_21010":116877,"_5":14420,"_27589":116824,"_2954":49648},[],{"_3471":70424,"_30355":70401,"_21010":116879,"_5":14420,"_27589":116824,"_2954":116880},[],"Ilimitados",{"_3471":70425,"_30355":70401,"_21010":116882,"_5":14420,"_27589":116824,"_2954":116883},[],"Dedicado",{"_3471":70426,"_30355":70401,"_21010":116885,"_5":14420,"_27589":116824,"_2954":116886},[],"99,99 %",{"_3471":70427,"_30355":70401,"_21010":116888,"_5":14420,"_27589":116828,"_2954":116889},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3471":70428,"_30355":70401,"_21010":116891,"_5":14420,"_27589":116828,"_2954":116892},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3471":70429,"_30355":70429,"_5":14772,"_2954":49665,"_30687":116894,"_21010":116896,"_27589":70429},[49421,116661,116895],"Kubernetes autogestionado",[],{"_3471":70430,"_30355":70429,"_21010":116898,"_5":14420,"_27589":70429,"_2954":116899},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3471":70431,"_30355":70429,"_5":30684,"_21010":116901,"_27589":116902,"_2954":116903},[],"/docs/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3471":70432,"_30355":70429,"_5":30684,"_21010":116905,"_27589":116906,"_2954":116907},[],"/docs/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3471":70433,"_30355":70429,"_5":30684,"_21010":116909,"_27589":116910,"_2954":116911},[],"/docs/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3471":70434,"_30355":70429,"_5":30684,"_21010":116913,"_27589":116914,"_2954":116915},[],"/docs/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3471":70435,"_30355":70429,"_5":30684,"_21010":116917,"_27589":116918,"_2954":116919},[],"/docs/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3471":70436,"_30355":70429,"_5":30684,"_21010":116921,"_27589":116922,"_2954":116923},[],"/docs/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3471":70437,"_30355":70429,"_5":30684,"_21010":116925,"_27589":116926,"_2954":116927},[],"/docs/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3471":70438,"_30355":70429,"_5":30684,"_21010":116929,"_27589":116930,"_2954":116931},[],"/docs/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3471":70439,"_30355":70429,"_5":30684,"_21010":116933,"_27589":116934,"_2954":116935},[],"/docs/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3471":70440,"_30355":70429,"_5":30684,"_21010":116937,"_27589":116938,"_2954":116939},[],"/docs/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3471":70441,"_30355":70429,"_5":30684,"_21010":116941,"_27589":116942,"_2954":116943},[],"/docs/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3471":70442,"_30355":70429,"_21010":116945,"_5":14420,"_27589":116902,"_2954":116946},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3471":70443,"_30355":70429,"_21010":116948,"_5":14420,"_27589":116902,"_2954":116949},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3471":70444,"_30355":70429,"_21010":116951,"_5":14420,"_27589":116906,"_2954":116952},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3471":70445,"_30355":70429,"_21010":116954,"_5":14420,"_27589":116906,"_2954":116955},[],"Fastlane instala o configura",{"_3471":70446,"_30355":70429,"_21010":116957,"_5":14420,"_27589":116906,"_2954":116958},[],"Tú sigues proporcionando",{"_3471":70447,"_30355":70429,"_21010":116960,"_5":14420,"_27589":116906,"_2954":116961},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3471":70448,"_30355":70429,"_21010":116963,"_5":14420,"_27589":116906,"_2954":116964},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3471":70449,"_30355":70429,"_21010":116966,"_5":14420,"_27589":116906,"_2954":116967},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3471":70450,"_30355":70429,"_21010":116969,"_5":14420,"_27589":116906,"_2954":116970},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3471":70451,"_30355":70429,"_21010":116972,"_5":14420,"_27589":116906,"_2954":116973},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3471":70452,"_30355":70429,"_21010":116975,"_5":14420,"_27589":116906,"_2954":116976},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3471":70453,"_30355":70429,"_21010":116978,"_5":14420,"_27589":116906,"_2954":116979},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3471":70454,"_30355":70429,"_21010":116981,"_5":14420,"_27589":116906,"_2954":116982},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3471":70455,"_30355":70429,"_21010":116984,"_5":14420,"_27589":116906,"_2954":116985},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3471":70456,"_30355":70429,"_21010":116987,"_5":14420,"_27589":116910,"_2954":116988},[],"Necesitas:",{"_3471":70457,"_30355":70429,"_21010":116990,"_5":14420,"_27589":116910,"_2954":116991},[],"un clúster Kubernetes existente",{"_3471":70458,"_30355":70429,"_21010":116993,"_5":14420,"_27589":116910,"_2954":116994},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3471":70459,"_30355":70429,"_21010":116996,"_5":14420,"_27589":116910,"_2954":49767},[],{"_3471":70460,"_30355":70429,"_21010":116998,"_5":14420,"_27589":116910,"_2954":23761},[],{"_3471":70461,"_30355":70429,"_21010":117000,"_5":14420,"_27589":116910,"_2954":117001},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3471":70462,"_30355":70429,"_21010":117003,"_5":14420,"_27589":116910,"_2954":117004},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3471":70463,"_30355":70429,"_21010":117006,"_5":14420,"_27589":116910,"_2954":117007},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3471":70464,"_30355":70429,"_21010":117009,"_5":14420,"_27589":116910,"_2954":117010},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3471":70465,"_30355":70429,"_21010":117012,"_5":14420,"_27589":116910,"_2954":117013},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3471":70466,"_30355":70429,"_21010":117015,"_5":14420,"_27589":116914,"_2954":117016},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3471":70467,"_30355":70429,"_21010":117018,"_5":14420,"_27589":116914,"_2954":117019},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3471":70468,"_30355":70429,"_21010":117021,"_5":14420,"_27589":116918,"_2954":117022},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3471":70469,"_30355":70429,"_21010":117024,"_5":14420,"_27589":116918,"_2954":117025},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3471":70470,"_30355":70429,"_21010":117027,"_5":14420,"_27589":116918,"_2954":117028},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3471":70471,"_30355":70429,"_21010":117030,"_5":14420,"_27589":116918,"_2954":117031},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3471":70472,"_30355":70429,"_21010":117033,"_5":14420,"_27589":116922,"_2954":117034},[],"Opción",{"_3471":70473,"_30355":70429,"_21010":117036,"_5":14420,"_27589":116922,"_2954":117037},[],"Valor predeterminado",{"_3471":70474,"_30355":70429,"_21010":117039,"_5":14420,"_27589":116922,"_2954":117040},[],"Propósito",{"_3471":70475,"_30355":70429,"_21010":117042,"_5":14420,"_27589":116922,"_2954":49814},[],{"_3471":70476,"_30355":70429,"_21010":117044,"_5":14420,"_27589":116922,"_2954":49817},[],{"_3471":70477,"_30355":70429,"_21010":117046,"_5":14420,"_27589":116922,"_2954":117047},[],"Muestra la ayuda",{"_3471":70478,"_30355":70429,"_21010":117049,"_5":14420,"_27589":116922,"_2954":49823},[],{"_3471":70479,"_30355":70429,"_21010":117051,"_5":14420,"_27589":116922,"_2954":117052},[],"contexto actual",{"_3471":70480,"_30355":70429,"_21010":117054,"_5":14420,"_27589":116922,"_2954":117055},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3471":70481,"_30355":70429,"_21010":117057,"_5":14420,"_27589":116922,"_2954":49832},[],{"_3471":70482,"_30355":70429,"_21010":117059,"_5":14420,"_27589":116922,"_2954":6569},[],{"_3471":70483,"_30355":70429,"_21010":117061,"_5":14420,"_27589":116922,"_2954":117062},[],"Omite prompts y genera credenciales para las dependencias",{"_3471":70484,"_30355":70429,"_21010":117064,"_5":14420,"_27589":116922,"_2954":49840},[],{"_3471":70485,"_30355":70429,"_21010":117066,"_5":14420,"_27589":116922,"_2954":49843},[],{"_3471":70486,"_30355":70429,"_21010":117068,"_5":14420,"_27589":116922,"_2954":117069},[],"Namespace de la instalación",{"_3471":70487,"_30355":70429,"_21010":117071,"_5":14420,"_27589":116922,"_2954":49849},[],{"_3471":70488,"_30355":70429,"_21010":117073,"_5":14420,"_27589":116922,"_2954":49852},[],{"_3471":70489,"_30355":70429,"_21010":117075,"_5":14420,"_27589":116922,"_2954":117076},[],"Dominio usado por la UI, OIDC y el certificado",{"_3471":70490,"_30355":70429,"_21010":117078,"_5":14420,"_27589":116922,"_2954":49858},[],{"_3471":70491,"_30355":70429,"_21010":117080,"_5":14420,"_27589":116922,"_2954":15124},[],{"_3471":70492,"_30355":70429,"_21010":117082,"_5":14420,"_27589":116922,"_2954":117083},[],"Versión del chart de Lamassu",{"_3471":70493,"_30355":70429,"_21010":117085,"_5":14420,"_27589":116922,"_2954":49866},[],{"_3471":70494,"_30355":70429,"_21010":117087,"_5":14420,"_27589":116922,"_2954":49869},[],{"_3471":70495,"_30355":70429,"_21010":117089,"_5":14420,"_27589":116922,"_2954":117090},[],"Puerto del listener HTTPS",{"_3471":70496,"_30355":70429,"_21010":117092,"_5":14420,"_27589":116922,"_2954":49875},[],{"_3471":70497,"_30355":70429,"_21010":117094,"_5":14420,"_27589":116922,"_2954":49878},[],{"_3471":70498,"_30355":70429,"_21010":117096,"_5":14420,"_27589":116922,"_2954":117097},[],"Puerto del listener HTTP",{"_3471":70499,"_30355":70429,"_21010":117099,"_5":14420,"_27589":116922,"_2954":49884},[],{"_3471":70500,"_30355":70429,"_21010":117101,"_5":14420,"_27589":116922,"_2954":49817},[],{"_3471":70501,"_30355":70429,"_21010":117103,"_5":14420,"_27589":116922,"_2954":117104},[],"Certificado PEM para TLS downstream",{"_3471":70502,"_30355":70429,"_21010":117106,"_5":14420,"_27589":116922,"_2954":49892},[],{"_3471":70503,"_30355":70429,"_21010":117108,"_5":14420,"_27589":116922,"_2954":49817},[],{"_3471":70504,"_30355":70429,"_21010":117110,"_5":14420,"_27589":116922,"_2954":117111},[],"Clave privada PEM para TLS downstream",{"_3471":70505,"_30355":70429,"_21010":117113,"_5":14420,"_27589":116922,"_2954":49900},[],{"_3471":70506,"_30355":70429,"_21010":117115,"_5":14420,"_27589":116922,"_2954":117116},[],"chart del repositorio",{"_3471":70507,"_30355":70429,"_21010":117118,"_5":14420,"_27589":116922,"_2954":117119},[],"Usa un chart local de Lamassu sin empaquetar",{"_3471":70508,"_30355":70429,"_21010":117121,"_5":14420,"_27589":116922,"_2954":49909},[],{"_3471":70509,"_30355":70429,"_21010":117123,"_5":14420,"_27589":116922,"_2954":117124},[],"detección automática",{"_3471":70510,"_30355":70429,"_21010":117126,"_5":14420,"_27589":116922,"_2954":117127},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3471":70511,"_30355":70429,"_21010":117129,"_5":14420,"_27589":116922,"_2954":49917},[],{"_3471":70512,"_30355":70429,"_21010":117131,"_5":14420,"_27589":116922,"_2954":6569},[],{"_3471":70513,"_30355":70429,"_21010":117133,"_5":14420,"_27589":116922,"_2954":117134},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3471":70514,"_30355":70429,"_21010":117136,"_5":14420,"_27589":116922,"_2954":49925},[],{"_3471":70515,"_30355":70429,"_21010":117138,"_5":14420,"_27589":116922,"_2954":6569},[],{"_3471":70516,"_30355":70429,"_21010":117140,"_5":14420,"_27589":116922,"_2954":117141},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3471":70517,"_30355":70429,"_21010":117143,"_5":14420,"_27589":116922,"_2954":49933},[],{"_3471":70518,"_30355":70429,"_21010":117145,"_5":14420,"_27589":116922,"_2954":6569},[],{"_3471":70519,"_30355":70429,"_21010":117147,"_5":14420,"_27589":116922,"_2954":117148},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3471":70520,"_30355":70429,"_21010":117150,"_5":14420,"_27589":116922,"_2954":49941},[],{"_3471":70521,"_30355":70429,"_21010":117152,"_5":14420,"_27589":116922,"_2954":6569},[],{"_3471":70522,"_30355":70429,"_21010":117154,"_5":14420,"_27589":116922,"_2954":117155},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3471":70523,"_30355":70429,"_21010":117157,"_5":14420,"_27589":116922,"_2954":49949},[],{"_3471":70524,"_30355":70429,"_21010":117159,"_5":14420,"_27589":116922,"_2954":49952},[],{"_3471":70525,"_30355":70429,"_21010":117161,"_5":14420,"_27589":116922,"_2954":117162},[],"Usa otro chart local de SoftHSM",{"_3471":70526,"_30355":70429,"_21010":117164,"_5":14420,"_27589":116922,"_2954":117165},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3471":70527,"_30355":70429,"_21010":117167,"_5":14420,"_27589":116926,"_2954":117168},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3471":70528,"_30355":70429,"_21010":117170,"_5":14420,"_27589":116926,"_2954":117171},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3471":70529,"_30355":70429,"_21010":117173,"_5":14420,"_27589":116926,"_2954":117174},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3471":70530,"_30355":70429,"_21010":117176,"_5":14420,"_27589":116926,"_2954":117177},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3471":70531,"_30355":70429,"_21010":117179,"_5":14420,"_27589":116926,"_2954":117180},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3471":70532,"_30355":70429,"_21010":117182,"_5":14420,"_27589":116926,"_2954":117183},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3471":70533,"_30355":70429,"_21010":117185,"_5":14420,"_27589":116930,"_2954":49979},[],{"_3471":70534,"_30355":70429,"_21010":117187,"_5":14420,"_27589":116930,"_2954":117188},[],"valida las herramientas locales y el clúster seleccionado",{"_3471":70535,"_30355":70429,"_21010":117190,"_5":14420,"_27589":116930,"_2954":117191},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3471":70536,"_30355":70429,"_21010":117193,"_5":14420,"_27589":116930,"_2954":117194},[],"crea el namespace",{"_3471":70537,"_30355":70429,"_21010":117196,"_5":14420,"_27589":116930,"_2954":117197},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3471":70538,"_30355":70429,"_21010":117199,"_5":14420,"_27589":116930,"_2954":117200},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3471":70539,"_30355":70429,"_21010":117202,"_5":14420,"_27589":116930,"_2954":117203},[],"instala RabbitMQ",{"_3471":70540,"_30355":70429,"_21010":117205,"_5":14420,"_27589":116930,"_2954":117206},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3471":70541,"_30355":70429,"_21010":117208,"_5":14420,"_27589":116930,"_2954":117209},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3471":70542,"_30355":70429,"_21010":117211,"_5":14420,"_27589":116930,"_2954":117212},[],"carga datos de ejemplo opcionalmente",{"_3471":70543,"_30355":70429,"_21010":117214,"_5":14420,"_27589":116930,"_2954":117215},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3471":70544,"_30355":70429,"_21010":117217,"_5":14420,"_27589":116934,"_2954":117218},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3471":70545,"_30355":70429,"_21010":117220,"_5":14420,"_27589":116934,"_2954":117221},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3471":70546,"_30355":70429,"_21010":117223,"_5":14420,"_27589":116938,"_2954":117224},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3471":70547,"_30355":70429,"_21010":117226,"_5":14420,"_27589":116938,"_2954":117227},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3471":70548,"_30355":70429,"_21010":117229,"_5":14420,"_27589":116938,"_2954":117230},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3471":70549,"_30355":70429,"_21010":117232,"_5":14420,"_27589":116942,"_2954":117233},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3471":70550,"_30355":70550,"_5":14772,"_2954":117235,"_30687":117236,"_21010":117237,"_27589":70550},"Instala con Helm",[49421,116661,116895],[],{"_3471":70551,"_30355":70550,"_21010":117239,"_5":14420,"_27589":70550,"_2954":117240},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3471":70552,"_30355":70550,"_5":30684,"_21010":117242,"_27589":117243,"_2954":117244},[],"/docs/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3471":70553,"_30355":70550,"_5":30684,"_21010":117246,"_27589":117247,"_2954":116911},[],"/docs/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3471":70554,"_30355":70550,"_5":30684,"_21010":117249,"_27589":117250,"_2954":117251},[],"/docs/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3471":70555,"_30355":70550,"_5":30684,"_21010":117253,"_27589":117254,"_2954":117255},[],"/docs/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3471":70556,"_30355":70550,"_5":30684,"_21010":117257,"_27589":117258,"_2954":117259},[],"/docs/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3471":70557,"_30355":70550,"_5":30684,"_21010":117261,"_27589":117262,"_2954":117263},[],"/docs/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3471":70558,"_30355":70550,"_5":30684,"_21010":117265,"_27589":117266,"_2954":117267},[],"/docs/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3471":70559,"_30355":70550,"_5":30684,"_21010":117269,"_27589":117270,"_2954":117271},[],"/docs/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3471":70560,"_30355":70550,"_5":30684,"_21010":117273,"_27589":117274,"_2954":117275},[],"/docs/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3471":70561,"_30355":70550,"_5":30684,"_21010":117277,"_27589":117278,"_2954":117279},[],"/docs/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3471":70562,"_30355":70550,"_5":30684,"_21010":117281,"_27589":117282,"_2954":117283},[],"/docs/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3471":70563,"_30355":70550,"_21010":117285,"_5":14420,"_27589":117243,"_2954":117286},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3471":70564,"_30355":70550,"_21010":117288,"_5":14420,"_27589":117247,"_2954":117289},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3471":70565,"_30355":70550,"_21010":117291,"_5":14420,"_27589":117247,"_2954":117292},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3471":70566,"_30355":70550,"_21010":117294,"_5":14420,"_27589":117247,"_2954":117295},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3471":70567,"_30355":70550,"_21010":117297,"_5":14420,"_27589":117247,"_2954":117298},[],"un broker RabbitMQ accesible y sus credenciales",{"_3471":70568,"_30355":70550,"_21010":117300,"_5":14420,"_27589":117247,"_2954":117301},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3471":70569,"_30355":70550,"_21010":117303,"_5":14420,"_27589":117247,"_2954":117304},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3471":70570,"_30355":70550,"_21010":117306,"_5":14420,"_27589":117247,"_2954":117307},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3471":70571,"_30355":70550,"_21010":117309,"_5":14420,"_27589":117247,"_2954":117310},[],"una StorageClass y un diseño de tráfico externo",{"_3471":70572,"_30355":70550,"_21010":117312,"_5":14420,"_27589":117247,"_2954":117313},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3471":70573,"_30355":70550,"_21010":117315,"_5":14420,"_27589":117247,"_2954":117316},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3471":70574,"_30355":70550,"_21010":117318,"_5":14420,"_27589":117247,"_2954":117319},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3471":70575,"_30355":70550,"_21010":117321,"_5":14420,"_27589":117250,"_2954":117322},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3471":70576,"_30355":70550,"_21010":117324,"_5":14420,"_27589":117250,"_2954":117325},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3471":70577,"_30355":70550,"_21010":117327,"_5":14420,"_27589":117250,"_2954":117328},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3471":70578,"_30355":70550,"_21010":117330,"_5":14420,"_27589":117254,"_2954":117331},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3471":70579,"_30355":70550,"_21010":117333,"_5":14420,"_27589":117254,"_2954":117334},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3471":70580,"_30355":70550,"_21010":117336,"_5":14420,"_27589":117254,"_2954":117337},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3471":70581,"_30355":70550,"_21010":117339,"_5":14420,"_27589":117254,"_2954":117340},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3471":70582,"_30355":70550,"_21010":117342,"_5":14420,"_27589":117258,"_2954":117343},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3471":70583,"_30355":70550,"_21010":117345,"_5":14420,"_27589":117262,"_2954":117346},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3471":70584,"_30355":70550,"_21010":117348,"_5":14420,"_27589":117262,"_2954":117349},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3471":70585,"_30355":70550,"_21010":117351,"_5":14420,"_27589":117262,"_2954":117352},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3471":70586,"_30355":70550,"_21010":117354,"_5":14420,"_27589":117262,"_2954":117355},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3471":70587,"_30355":70550,"_21010":117357,"_5":14420,"_27589":117262,"_2954":117358},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3471":70588,"_30355":70550,"_21010":117360,"_5":14420,"_27589":117262,"_2954":117361},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3471":70589,"_30355":70550,"_21010":117363,"_5":14420,"_27589":117262,"_2954":117364},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3471":70590,"_30355":70550,"_21010":117366,"_5":14420,"_27589":117266,"_2954":117367},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3471":70591,"_30355":70550,"_21010":117369,"_5":14420,"_27589":117266,"_2954":117370},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3471":70592,"_30355":70550,"_21010":117372,"_5":14420,"_27589":117266,"_2954":117373},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3471":70593,"_30355":70550,"_21010":117375,"_5":14420,"_27589":117266,"_2954":117376},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3471":70594,"_30355":70550,"_21010":117378,"_5":14420,"_27589":117270,"_2954":117379},[],"Para instalar un checkout local:",{"_3471":70595,"_30355":70550,"_21010":117381,"_5":14420,"_27589":117274,"_2954":117382},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3471":70596,"_30355":70550,"_21010":117384,"_5":14420,"_27589":117274,"_2954":117385},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3471":70597,"_30355":70550,"_21010":117387,"_5":14420,"_27589":117278,"_2954":117388},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3471":70598,"_30355":70550,"_21010":117390,"_5":14420,"_27589":117278,"_2954":117391},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3471":70599,"_30355":70550,"_21010":117393,"_5":14420,"_27589":117278,"_2954":117394},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3471":70600,"_30355":70550,"_21010":117396,"_5":14420,"_27589":117278,"_2954":117397},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3471":70601,"_30355":70550,"_21010":117399,"_5":14420,"_27589":117278,"_2954":117400},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3471":70602,"_30355":70550,"_21010":117402,"_5":14420,"_27589":117282,"_2954":117403},[],"Antes de pasar a producción, revisa:",{"_3471":70603,"_30355":70550,"_21010":117405,"_5":14420,"_27589":117282,"_2954":117406},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3471":70604,"_30355":70550,"_21010":117408,"_5":14420,"_27589":117282,"_2954":117409},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3471":70605,"_30355":70550,"_21010":117411,"_5":14420,"_27589":117282,"_2954":117412},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3471":70606,"_30355":70550,"_21010":117414,"_5":14420,"_27589":117282,"_2954":117415},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3471":70607,"_30355":70550,"_21010":117417,"_5":14420,"_27589":117282,"_2954":117418},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3471":70608,"_30355":70550,"_21010":117420,"_5":14420,"_27589":117282,"_2954":117421},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3471":70609,"_30355":70550,"_21010":117423,"_5":14420,"_27589":117282,"_2954":117424},[],"SMTP, observabilidad y entrega de alertas",{"_3471":70610,"_30355":70550,"_21010":117426,"_5":14420,"_27589":117282,"_2954":117427},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3471":70611,"_30355":70550,"_21010":117429,"_5":14420,"_27589":117282,"_2954":117430},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3471":70612,"_30355":70612,"_5":14772,"_2954":117432,"_30687":117433,"_21010":117434,"_27589":70612},"Expón el Gateway",[49421,116661,116895],[],{"_3471":70613,"_30355":70612,"_21010":117436,"_5":14420,"_27589":70612,"_2954":117437},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3471":70614,"_30355":70612,"_5":30684,"_21010":117439,"_27589":117440,"_2954":117441},[],"/docs/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3471":70615,"_30355":70612,"_5":30684,"_21010":117443,"_27589":117444,"_2954":117445},[],"/docs/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3471":70616,"_30355":70612,"_5":30684,"_21010":117447,"_27589":117448,"_2954":117449},[],"/docs/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3471":70617,"_30355":70612,"_5":30684,"_21010":117451,"_27589":117452,"_2954":50247},[],"/docs/es/deployment/self-hosted/networking#k3s",{"_3471":70618,"_30355":70612,"_5":30684,"_21010":117454,"_27589":117455,"_2954":117456},[],"/docs/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3471":70619,"_30355":70612,"_5":30684,"_21010":117458,"_27589":117459,"_2954":117460},[],"/docs/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3471":70620,"_30355":70612,"_5":30684,"_21010":117462,"_27589":117463,"_2954":117464},[],"/docs/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3471":70621,"_30355":70612,"_5":30684,"_21010":117466,"_27589":117467,"_2954":117468},[],"/docs/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3471":70622,"_30355":70612,"_5":30684,"_21010":117470,"_27589":117471,"_2954":117472},[],"/docs/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3471":70623,"_30355":70612,"_5":30684,"_21010":117474,"_27589":117475,"_2954":117476},[],"/docs/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3471":70624,"_30355":70612,"_5":30684,"_21010":117478,"_27589":117479,"_2954":117480},[],"/docs/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3471":70625,"_30355":70612,"_21010":117482,"_5":14420,"_27589":117440,"_2954":117483},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3471":70626,"_30355":70612,"_21010":117485,"_5":14420,"_27589":117440,"_2954":117486},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3471":70627,"_30355":70612,"_21010":117488,"_5":14420,"_27589":117444,"_2954":117489},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3471":70628,"_30355":70612,"_21010":117491,"_5":14420,"_27589":117444,"_2954":117492},[],"Defínelo únicamente cuando:",{"_3471":70629,"_30355":70612,"_21010":117494,"_5":14420,"_27589":117444,"_2954":117495},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3471":70630,"_30355":70612,"_21010":117497,"_5":14420,"_27589":117444,"_2954":117498},[],"esa dirección está asignada a este Gateway",{"_3471":70631,"_30355":70612,"_21010":117500,"_5":14420,"_27589":117444,"_2954":117501},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3471":70632,"_30355":70612,"_21010":117503,"_5":14420,"_27589":117444,"_2954":117504},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3471":70633,"_30355":70612,"_21010":117506,"_5":14420,"_27589":117444,"_2954":117507},[],"No confundas estos valores:",{"_3471":70634,"_30355":70612,"_21010":117509,"_5":14420,"_27589":117444,"_2954":117510},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3471":70635,"_30355":70612,"_21010":117512,"_5":14420,"_27589":117444,"_2954":117513},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3471":70636,"_30355":70612,"_21010":117515,"_5":14420,"_27589":117444,"_2954":117516},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3471":70637,"_30355":70612,"_21010":117518,"_5":14420,"_27589":117448,"_2954":117519},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3471":70638,"_30355":70612,"_21010":117521,"_5":14420,"_27589":117448,"_2954":117522},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3471":70639,"_30355":70612,"_21010":117524,"_5":14420,"_27589":117452,"_2954":117525},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3471":70640,"_30355":70612,"_21010":117527,"_5":14420,"_27589":117452,"_2954":117528},[],"Para el diseño recomendado:",{"_3471":70641,"_30355":70612,"_21010":117530,"_5":14420,"_27589":117452,"_2954":117531},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3471":70642,"_30355":70612,"_21010":117533,"_5":14420,"_27589":117452,"_2954":117534},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3471":70643,"_30355":70612,"_21010":117536,"_5":14420,"_27589":117452,"_2954":117537},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3471":70644,"_30355":70612,"_21010":117539,"_5":14420,"_27589":117452,"_2954":117540},[],"Apunta DNS a la dirección accesible de la VM.",{"_3471":70645,"_30355":70612,"_21010":117542,"_5":14420,"_27589":117452,"_2954":117543},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3471":70646,"_30355":70612,"_21010":117545,"_5":14420,"_27589":117455,"_2954":117546},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3471":70647,"_30355":70612,"_21010":117548,"_5":14420,"_27589":117459,"_2954":117549},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3471":70648,"_30355":70612,"_21010":117551,"_5":14420,"_27589":117459,"_2954":117552},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3471":70649,"_30355":70612,"_21010":117554,"_5":14420,"_27589":117463,"_2954":117555},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3471":70650,"_30355":70612,"_21010":117557,"_5":14420,"_27589":117463,"_2954":117558},[],"Requisito",{"_3471":70651,"_30355":70612,"_21010":117560,"_5":14420,"_27589":117463,"_2954":117561},[],"Diseño recomendado",{"_3471":70652,"_30355":70612,"_21010":117563,"_5":14420,"_27589":117463,"_2954":117564},[],"Consecuencia",{"_3471":70653,"_30355":70612,"_21010":117566,"_5":14420,"_27589":117463,"_2954":117567},[],"Varias URL o servicios de Lamassu",{"_3471":70654,"_30355":70612,"_21010":117569,"_5":14420,"_27589":117463,"_2954":117570},[],"Un Gateway con varias rutas",{"_3471":70655,"_30355":70612,"_21010":117572,"_5":14420,"_27589":117463,"_2954":117573},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3471":70656,"_30355":70612,"_21010":117575,"_5":14420,"_27589":117463,"_2954":117576},[],"Gateways independientes e IP externas distintas",{"_3471":70657,"_30355":70612,"_21010":117578,"_5":14420,"_27589":117463,"_2954":117579},[],"Una VIP por Gateway",{"_3471":70658,"_30355":70612,"_21010":117581,"_5":14420,"_27589":117463,"_2954":117582},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3471":70659,"_30355":70612,"_21010":117584,"_5":14420,"_27589":117463,"_2954":117585},[],"Gateways independientes, un nodo y una IP",{"_3471":70660,"_30355":70612,"_21010":117587,"_5":14420,"_27589":117463,"_2954":117588},[],"Puertos externos diferentes",{"_3471":70661,"_30355":70612,"_21010":117590,"_5":14420,"_27589":117463,"_2954":117591},[],"Los clientes deben indicar puertos no estándar",{"_3471":70662,"_30355":70612,"_21010":117593,"_5":14420,"_27589":117463,"_2954":117594},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3471":70663,"_30355":70612,"_21010":117596,"_5":14420,"_27589":117463,"_2954":117597},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3471":70664,"_30355":70612,"_21010":117599,"_5":14420,"_27589":117463,"_2954":117600},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3471":70665,"_30355":70612,"_21010":117602,"_5":14420,"_27589":117463,"_2954":117603},[],"Recursos Gateway separados pero proxy compartido",{"_3471":70666,"_30355":70612,"_21010":117605,"_5":14420,"_27589":117463,"_2954":117606},[],"Modo merged Gateway de Envoy",{"_3471":70667,"_30355":70612,"_21010":117608,"_5":14420,"_27589":117463,"_2954":117609},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3471":70668,"_30355":70612,"_21010":117611,"_5":14420,"_27589":117463,"_2954":117612},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3471":70669,"_30355":70612,"_21010":117614,"_5":14420,"_27589":117463,"_2954":117615},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3471":70670,"_30355":70612,"_21010":117617,"_5":14420,"_27589":117463,"_2954":117618},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3471":70671,"_30355":70612,"_21010":117620,"_5":14420,"_27589":117463,"_2954":117621},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3471":70672,"_30355":70612,"_21010":117623,"_5":14420,"_27589":117467,"_2954":117624},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3471":70673,"_30355":70612,"_21010":117626,"_5":14420,"_27589":117471,"_2954":117627},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3471":70674,"_30355":70612,"_21010":117629,"_5":14420,"_27589":117471,"_2954":117630},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3471":70675,"_30355":70612,"_21010":117632,"_5":14420,"_27589":117471,"_2954":117633},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3471":70676,"_30355":70612,"_21010":117635,"_5":14420,"_27589":117471,"_2954":117636},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3471":70677,"_30355":70612,"_21010":117638,"_5":14420,"_27589":117471,"_2954":117639},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3471":70678,"_30355":70612,"_21010":117641,"_5":14420,"_27589":117475,"_2954":117642},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3471":70679,"_30355":70612,"_21010":117644,"_5":14420,"_27589":117475,"_2954":117645},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3471":70680,"_30355":70612,"_21010":117647,"_5":14420,"_27589":117479,"_2954":117648},[],"Comprueba, en orden:",{"_3471":70681,"_30355":70612,"_21010":117650,"_5":14420,"_27589":117479,"_2954":117651},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3471":70682,"_30355":70612,"_21010":117653,"_5":14420,"_27589":117479,"_2954":117654},[],"Su estado contiene la dirección esperada.",{"_3471":70683,"_30355":70612,"_21010":117656,"_5":14420,"_27589":117479,"_2954":117657},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3471":70684,"_30355":70612,"_21010":117659,"_5":14420,"_27589":117479,"_2954":117660},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3471":70685,"_30355":70612,"_21010":117662,"_5":14420,"_27589":117479,"_2954":117663},[],"DNS resuelve al endpoint accesible externamente.",{"_3471":70686,"_30355":70612,"_21010":117665,"_5":14420,"_27589":117479,"_2954":117666},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3471":70687,"_30355":70612,"_21010":117668,"_5":14420,"_27589":117479,"_2954":117669},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3471":70688,"_30355":70688,"_5":14772,"_2954":49528,"_30687":117671,"_21010":117672,"_27589":70688},[49421,116661,116895],[],{"_3471":70689,"_30355":70688,"_21010":117674,"_5":14420,"_27589":70688,"_2954":117675},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3471":70690,"_30355":70688,"_5":30684,"_21010":117677,"_27589":117678,"_2954":117679},[],"/docs/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3471":70691,"_30355":70688,"_5":30684,"_21010":117681,"_27589":117682,"_2954":117683},[],"/docs/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3471":70692,"_30355":70688,"_5":30684,"_21010":117685,"_27589":117686,"_2954":117687},[],"/docs/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3471":70693,"_30355":70688,"_5":30684,"_21010":117689,"_27589":117690,"_2954":117691},[],"/docs/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3471":70694,"_30355":70688,"_5":30684,"_21010":117693,"_27589":117694,"_2954":117695},[],"/docs/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3471":70695,"_30355":70688,"_5":30684,"_21010":117697,"_27589":117698,"_2954":117699},[],"/docs/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3471":70696,"_30355":70688,"_21010":117701,"_5":14420,"_27589":117678,"_2954":117702},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3471":70697,"_30355":70688,"_21010":117704,"_5":14420,"_27589":117682,"_2954":117705},[],"Flujo",{"_3471":70698,"_30355":70688,"_21010":117707,"_5":14420,"_27589":117682,"_2954":117708},[],"Úsalo para",{"_3471":70699,"_30355":70688,"_21010":117710,"_5":14420,"_27589":117682,"_2954":117711},[],"Qué instala",{"_3471":70700,"_30355":70688,"_21010":117713,"_5":14420,"_27589":117682,"_2954":50509},[],{"_3471":70701,"_30355":70688,"_21010":117715,"_5":14420,"_27589":117682,"_2954":117716},[],"Producción y entornos controlados",{"_3471":70702,"_30355":70688,"_21010":117718,"_5":14420,"_27589":117682,"_2954":117719},[],"Servicios de Lamassu y recursos de Gateway API",{"_3471":70703,"_30355":70688,"_21010":117721,"_5":14420,"_27589":117682,"_2954":49665},[],{"_3471":70704,"_30355":70688,"_21010":117723,"_5":14420,"_27589":117682,"_2954":117724},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3471":70705,"_30355":70688,"_21010":117726,"_5":14420,"_27589":117682,"_2954":117727},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3471":70706,"_30355":70688,"_21010":117729,"_5":14420,"_27589":117686,"_2954":117730},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3471":70707,"_30355":70688,"_21010":117732,"_5":14420,"_27589":117686,"_2954":117733},[],"Área",{"_3471":70708,"_30355":70688,"_21010":117735,"_5":14420,"_27589":117686,"_2954":117736},[],"El chart de Lamassu proporciona",{"_3471":70709,"_30355":70688,"_21010":117738,"_5":14420,"_27589":117686,"_2954":117739},[],"Tú proporcionas",{"_3471":70710,"_30355":70688,"_21010":117741,"_5":14420,"_27589":117686,"_2954":117742},[],"Aplicaciones Lamassu",{"_3471":70711,"_30355":70688,"_21010":117744,"_5":14420,"_27589":117686,"_2954":117745},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3471":70712,"_30355":70688,"_21010":117747,"_5":14420,"_27589":117686,"_2954":117748},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3471":70713,"_30355":70688,"_21010":117750,"_5":14420,"_27589":117686,"_2954":117751},[],"Datos PostgreSQL",{"_3471":70714,"_30355":70688,"_21010":117753,"_5":14420,"_27589":117686,"_2954":117754},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3471":70715,"_30355":70688,"_21010":117756,"_5":14420,"_27589":117686,"_2954":117757},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3471":70716,"_30355":70688,"_21010":117759,"_5":14420,"_27589":117686,"_2954":117760},[],"Mensajería",{"_3471":70717,"_30355":70688,"_21010":117762,"_5":14420,"_27589":117686,"_2954":117763},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3471":70718,"_30355":70688,"_21010":117765,"_5":14420,"_27589":117686,"_2954":117766},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3471":70719,"_30355":70688,"_21010":117768,"_5":14420,"_27589":117686,"_2954":117769},[],"Identidad",{"_3471":70720,"_30355":70688,"_21010":117771,"_5":14420,"_27589":117686,"_2954":117772},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3471":70721,"_30355":70688,"_21010":117774,"_5":14420,"_27589":117686,"_2954":117775},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3471":70722,"_30355":70688,"_21010":117777,"_5":14420,"_27589":117686,"_2954":117778},[],"Enrutamiento externo",{"_3471":70723,"_30355":70688,"_21010":117780,"_5":14420,"_27589":117686,"_2954":117781},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3471":70724,"_30355":70688,"_21010":117783,"_5":14420,"_27589":117686,"_2954":117784},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3471":70725,"_30355":70688,"_21010":117786,"_5":14420,"_27589":117686,"_2954":50583},[],{"_3471":70726,"_30355":70688,"_21010":117788,"_5":14420,"_27589":117686,"_2954":117789},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3471":70727,"_30355":70688,"_21010":117791,"_5":14420,"_27589":117686,"_2954":117792},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3471":70728,"_30355":70688,"_21010":117794,"_5":14420,"_27589":117686,"_2954":117795},[],"Datos persistentes de la aplicación",{"_3471":70729,"_30355":70688,"_21010":117797,"_5":14420,"_27589":117686,"_2954":117798},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3471":70730,"_30355":70688,"_21010":117800,"_5":14420,"_27589":117686,"_2954":117801},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3471":70731,"_30355":70688,"_21010":117803,"_5":14420,"_27589":117686,"_2954":117804},[],"Integraciones opcionales",{"_3471":70732,"_30355":70688,"_21010":117806,"_5":14420,"_27589":117686,"_2954":117807},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3471":70733,"_30355":70688,"_21010":117809,"_5":14420,"_27589":117686,"_2954":117810},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3471":70734,"_30355":70688,"_21010":117812,"_5":14420,"_27589":117686,"_2954":117813},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3471":70735,"_30355":70688,"_21010":117815,"_5":14420,"_27589":117686,"_2954":117816},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3471":70736,"_30355":70688,"_21010":117818,"_5":14420,"_27589":117690,"_2954":117819},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3471":70737,"_30355":70688,"_21010":117821,"_5":14420,"_27589":117690,"_2954":117822},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3471":70738,"_30355":70688,"_21010":117824,"_5":14420,"_27589":117694,"_2954":117825},[],"Kubernetes 1.24 o posterior",{"_3471":70739,"_30355":70688,"_21010":117827,"_5":14420,"_27589":117694,"_2954":117828},[],"Helm 3.2 o posterior",{"_3471":70740,"_30355":70688,"_21010":117830,"_5":14420,"_27589":117694,"_2954":117831},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3471":70741,"_30355":70688,"_21010":117833,"_5":14420,"_27589":117694,"_2954":117834},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3471":70742,"_30355":70688,"_21010":117836,"_5":14420,"_27589":117694,"_2954":117837},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3471":70743,"_30355":70688,"_21010":117839,"_5":14420,"_27589":117694,"_2954":117840},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3471":70744,"_30355":70688,"_21010":117842,"_5":14420,"_27589":117694,"_2954":117843},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3471":70745,"_30355":70688,"_21010":117845,"_5":14420,"_27589":117698,"_2954":117846},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3471":70746,"_30355":70688,"_21010":117848,"_5":14420,"_27589":117698,"_2954":117849},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3471":70747,"_30355":70688,"_21010":117851,"_5":14420,"_27589":117698,"_2954":117852},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3471":70748,"_30355":70688,"_21010":117854,"_5":14420,"_27589":117698,"_2954":117855},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3471":70749,"_30355":70749,"_5":14772,"_2954":117857,"_30687":117858,"_21010":117860,"_27589":70749},"Resolución de problemas de despliegue",[49421,116661,117859],"Operación",[],{"_3471":70750,"_30355":70749,"_21010":117862,"_5":14420,"_27589":70749,"_2954":117863},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3471":70751,"_30355":70749,"_5":30684,"_21010":117865,"_27589":117866,"_2954":117867},[],"/docs/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3471":70752,"_30355":70749,"_5":30684,"_21010":117869,"_27589":117870,"_2954":117871},[],"/docs/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3471":70753,"_30355":70749,"_5":30684,"_21010":117873,"_27589":117874,"_2954":117875},[],"/docs/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3471":70754,"_30355":70749,"_5":30684,"_21010":117877,"_27589":117878,"_2954":117879},[],"/docs/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3471":70755,"_30355":70749,"_5":30684,"_21010":117881,"_27589":117882,"_2954":117883},[],"/docs/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3471":70756,"_30355":70749,"_5":30684,"_21010":117885,"_27589":117886,"_2954":117887},[],"/docs/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3471":70757,"_30355":70749,"_5":30684,"_21010":117889,"_27589":117890,"_2954":117891},[],"/docs/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3471":70758,"_30355":70749,"_5":30684,"_21010":117893,"_27589":117894,"_2954":117895},[],"/docs/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3471":70759,"_30355":70749,"_5":30684,"_21010":117897,"_27589":117898,"_2954":117899},[],"/docs/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3471":70760,"_30355":70749,"_5":30684,"_21010":117901,"_27589":117902,"_2954":117903},[],"/docs/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3471":70761,"_30355":70749,"_5":30684,"_21010":117905,"_27589":117906,"_2954":117907},[],"/docs/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3471":70762,"_30355":70749,"_5":30684,"_21010":117909,"_27589":117910,"_2954":117911},[],"/docs/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3471":70763,"_30355":70749,"_5":30684,"_21010":117913,"_27589":117914,"_2954":117915},[],"/docs/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3471":70764,"_30355":70749,"_21010":117917,"_5":14420,"_27589":70749,"_2954":117918},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3471":70765,"_30355":70749,"_21010":117920,"_5":14420,"_27589":117870,"_2954":117921},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3471":70766,"_30355":70749,"_21010":117923,"_5":14420,"_27589":117874,"_2954":117924},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3471":70767,"_30355":70749,"_21010":117926,"_5":14420,"_27589":117878,"_2954":117927},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3471":70768,"_30355":70749,"_21010":117929,"_5":14420,"_27589":117882,"_2954":117930},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3471":70769,"_30355":70749,"_21010":117932,"_5":14420,"_27589":117886,"_2954":117933},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3471":70770,"_30355":70749,"_21010":117935,"_5":14420,"_27589":117890,"_2954":117936},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3471":70771,"_30355":70749,"_21010":117938,"_5":14420,"_27589":117890,"_2954":117939},[],"Ejecuta también la prueba de conectividad del chart:",{"_3471":70772,"_30355":70749,"_21010":117941,"_5":14420,"_27589":117890,"_2954":117942},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3471":70773,"_30355":70749,"_21010":117944,"_5":14420,"_27589":117890,"_2954":117945},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3471":70774,"_30355":70749,"_21010":117947,"_5":14420,"_27589":117894,"_2954":117948},[],"Si recibes un 401:",{"_3471":70775,"_30355":70749,"_21010":117950,"_5":14420,"_27589":117894,"_2954":117951},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3471":70776,"_30355":70749,"_21010":117953,"_5":14420,"_27589":117894,"_2954":117954},[],"verifica emisor, audiencia y expiración del token;",{"_3471":70777,"_30355":70749,"_21010":117956,"_5":14420,"_27589":117894,"_2954":117957},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3471":70778,"_30355":70749,"_21010":117959,"_5":14420,"_27589":117894,"_2954":117960},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3471":70779,"_30355":70749,"_21010":117962,"_5":14420,"_27589":117894,"_2954":117963},[],"Si el login termina pero las APIs devuelven 403:",{"_3471":70780,"_30355":70749,"_21010":117965,"_5":14420,"_27589":117894,"_2954":117966},[],"inspecciona los claims reales del token;",{"_3471":70781,"_30355":70749,"_21010":117968,"_5":14420,"_27589":117894,"_2954":117969},[],"confirma que coinciden con un principal activo;",{"_3471":70782,"_30355":70749,"_21010":117971,"_5":14420,"_27589":117894,"_2954":117972},[],"revisa las políticas concedidas al principal;",{"_3471":70783,"_30355":70749,"_21010":117974,"_5":14420,"_27589":117894,"_2954":117975},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3471":70784,"_30355":70749,"_21010":117977,"_5":14420,"_27589":117894,"_2954":117978},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3471":70785,"_30355":70749,"_21010":117980,"_5":14420,"_27589":117898,"_2954":117981},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3471":70786,"_30355":70749,"_21010":117983,"_5":14420,"_27589":117898,"_2954":117984},[],"Localiza el pod y Service de authz.",{"_3471":70787,"_30355":70749,"_21010":117986,"_5":14420,"_27589":117898,"_2954":117987},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3471":70788,"_30355":70749,"_21010":117989,"_5":14420,"_27589":117898,"_2954":117990},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3471":70789,"_30355":70749,"_21010":117992,"_5":14420,"_27589":117898,"_2954":117993},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3471":70790,"_30355":70749,"_21010":117995,"_5":14420,"_27589":117898,"_2954":117996},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3471":70791,"_30355":70749,"_21010":117998,"_5":14420,"_27589":117902,"_2954":117999},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3471":70792,"_30355":70749,"_21010":118001,"_5":14420,"_27589":117906,"_2954":118002},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3471":70793,"_30355":70749,"_21010":118004,"_5":14420,"_27589":117906,"_2954":118005},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3471":70794,"_30355":70749,"_21010":118007,"_5":14420,"_27589":117906,"_2954":118008},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3471":70795,"_30355":70749,"_21010":118010,"_5":14420,"_27589":117906,"_2954":118011},[],"volumen persistente sin enlazar;",{"_3471":70796,"_30355":70749,"_21010":118013,"_5":14420,"_27589":117906,"_2954":118014},[],"imagen inaccesible o política de pull incorrecta;",{"_3471":70797,"_30355":70749,"_21010":118016,"_5":14420,"_27589":117906,"_2954":118017},[],"configuración inválida del motor criptográfico;",{"_3471":70798,"_30355":70749,"_21010":118019,"_5":14420,"_27589":117906,"_2954":118020},[],"límites de CPU o memoria demasiado bajos;",{"_3471":70799,"_30355":70749,"_21010":118022,"_5":14420,"_27589":117906,"_2954":118023},[],"migración previa incompleta.",{"_3471":70800,"_30355":70749,"_21010":118025,"_5":14420,"_27589":117906,"_2954":118026},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3471":70801,"_30355":70749,"_21010":118028,"_5":14420,"_27589":117906,"_2954":118029},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3471":70802,"_30355":70749,"_21010":118031,"_5":14420,"_27589":117906,"_2954":118032},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3471":70803,"_30355":70749,"_21010":118034,"_5":14420,"_27589":117910,"_2954":118035},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3471":70804,"_30355":70749,"_21010":118037,"_5":14420,"_27589":117910,"_2954":118038},[],"verifica que esté habilitado en el servicio emisor;",{"_3471":70805,"_30355":70749,"_21010":118040,"_5":14420,"_27589":117910,"_2954":118041},[],"comprueba conectividad y credenciales AMQP;",{"_3471":70806,"_30355":70749,"_21010":118043,"_5":14420,"_27589":117910,"_2954":118044},[],"revisa exchange, routing key, colas y consumidores;",{"_3471":70807,"_30355":70749,"_21010":118046,"_5":14420,"_27589":117910,"_2954":118047},[],"inspecciona dead-letter queues;",{"_3471":70808,"_30355":70749,"_21010":118049,"_5":14420,"_27589":117910,"_2954":118050},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3471":70809,"_30355":70749,"_21010":118052,"_5":14420,"_27589":117910,"_2954":118053},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3471":70810,"_30355":70749,"_21010":118055,"_5":14420,"_27589":117910,"_2954":118056},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3471":70811,"_30355":70749,"_21010":118058,"_5":14420,"_27589":117910,"_2954":118059},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3471":70812,"_30355":70749,"_21010":118061,"_5":14420,"_27589":117910,"_2954":118062},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3471":70813,"_30355":70749,"_21010":118064,"_5":14420,"_27589":117910,"_2954":118065},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3471":70814,"_30355":70749,"_21010":118067,"_5":14420,"_27589":117910,"_2954":118068},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3471":70815,"_30355":70749,"_21010":118070,"_5":14420,"_27589":117910,"_2954":118071},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3471":70816,"_30355":70749,"_21010":118073,"_5":14420,"_27589":117914,"_2954":118074},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3471":70817,"_30355":70749,"_21010":118076,"_5":14420,"_27589":117914,"_2954":118077},[],"Antes de cerrar una incidencia, guarda:",{"_3471":70818,"_30355":70749,"_21010":118079,"_5":14420,"_27589":117914,"_2954":118080},[],"causa confirmada;",{"_3471":70819,"_30355":70749,"_21010":118082,"_5":14420,"_27589":117914,"_2954":118083},[],"alcance temporal y recursos afectados;",{"_3471":70820,"_30355":70749,"_21010":118085,"_5":14420,"_27589":117914,"_2954":118086},[],"comandos o consultas utilizados;",{"_3471":70821,"_30355":70749,"_21010":118088,"_5":14420,"_27589":117914,"_2954":118089},[],"cambio aplicado y forma de revertirlo;",{"_3471":70822,"_30355":70749,"_21010":118091,"_5":14420,"_27589":117914,"_2954":118092},[],"validación desde un consumidor;",{"_3471":70823,"_30355":70749,"_21010":118094,"_5":14420,"_27589":117914,"_2954":118095},[],"acción preventiva y propietario.",{"_3471":70824,"_30355":70824,"_5":14772,"_2954":118097,"_30687":118098,"_21010":118101,"_27589":70824},"Control de acceso",[49421,118099,118100],"Plataforma","Administración",[],{"_3471":70825,"_30355":70824,"_21010":118103,"_5":14420,"_27589":70824,"_2954":118104},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3471":70826,"_30355":70824,"_5":30684,"_21010":118106,"_27589":118107,"_2954":118108},[],"/docs/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3471":70827,"_30355":70824,"_5":30684,"_21010":118110,"_27589":118111,"_2954":118112},[],"/docs/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3471":70828,"_30355":70824,"_5":30684,"_21010":118114,"_27589":118115,"_2954":118116},[],"/docs/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3471":70829,"_30355":70824,"_5":30684,"_21010":118118,"_27589":118119,"_2954":118120},[],"/docs/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3471":70830,"_30355":70824,"_5":30684,"_21010":118122,"_27589":118123,"_2954":118124},[],"/docs/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3471":70831,"_30355":70824,"_5":30684,"_21010":118126,"_27589":118127,"_2954":118128},[],"/docs/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3471":70832,"_30355":70824,"_5":30684,"_21010":118130,"_27589":118131,"_2954":118132},[],"/docs/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3471":70833,"_30355":70824,"_5":30684,"_21010":118134,"_27589":118135,"_2954":118136},[],"/docs/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3471":70834,"_30355":70824,"_5":30684,"_21010":118138,"_27589":118139,"_2954":118140},[],"/docs/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3471":70835,"_30355":70824,"_5":30684,"_21010":118142,"_27589":118143,"_2954":118144},[],"/docs/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3471":70836,"_30355":70824,"_5":30684,"_21010":118146,"_27589":118147,"_2954":118148},[],"/docs/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3471":70837,"_30355":70824,"_5":30684,"_21010":118150,"_27589":118151,"_2954":118152},[],"/docs/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3471":70838,"_30355":70824,"_5":30684,"_21010":118154,"_27589":118155,"_2954":118156},[],"/docs/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3471":70839,"_30355":70824,"_5":30684,"_21010":118158,"_27589":118159,"_2954":118160},[],"/docs/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3471":70840,"_30355":70824,"_5":30684,"_21010":118162,"_27589":118163,"_2954":118164},[],"/docs/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3471":70841,"_30355":70824,"_5":30684,"_21010":118166,"_27589":118167,"_2954":117267},[],"/docs/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3471":70842,"_30355":70824,"_5":30684,"_21010":118169,"_27589":118170,"_2954":118171},[],"/docs/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3471":70843,"_30355":70824,"_5":30684,"_21010":118173,"_27589":118174,"_2954":118175},[],"/docs/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3471":70844,"_30355":70824,"_5":30684,"_21010":118177,"_27589":118178,"_2954":118179},[],"/docs/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3471":70845,"_30355":70824,"_5":30684,"_21010":118181,"_27589":118182,"_2954":118183},[],"/docs/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3471":70846,"_30355":70824,"_5":30684,"_21010":118185,"_27589":118186,"_2954":118187},[],"/docs/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3471":70847,"_30355":70824,"_5":30684,"_21010":118189,"_27589":118190,"_2954":118191},[],"/docs/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3471":70848,"_30355":70824,"_5":30684,"_21010":118193,"_27589":118194,"_2954":118195},[],"/docs/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3471":70849,"_30355":70824,"_5":30684,"_21010":118197,"_27589":118198,"_2954":118199},[],"/docs/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3471":70850,"_30355":70824,"_5":30684,"_21010":118201,"_27589":118202,"_2954":118203},[],"/docs/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3471":70851,"_30355":70824,"_5":30684,"_21010":118205,"_27589":118206,"_2954":118207},[],"/docs/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3471":70852,"_30355":70824,"_5":30684,"_21010":118209,"_27589":118210,"_2954":118211},[],"/docs/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3471":70853,"_30355":70824,"_5":30684,"_21010":118213,"_27589":118214,"_2954":118215},[],"/docs/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3471":70854,"_30355":70824,"_5":30684,"_21010":118217,"_27589":118218,"_2954":118219},[],"/docs/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3471":70855,"_30355":70824,"_5":30684,"_21010":118221,"_27589":118222,"_2954":118223},[],"/docs/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3471":70856,"_30355":70824,"_5":30684,"_21010":118225,"_27589":118226,"_2954":118227},[],"/docs/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3471":70857,"_30355":70824,"_21010":118229,"_5":14420,"_27589":70824,"_2954":118230},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3471":70858,"_30355":70824,"_21010":118232,"_5":14420,"_27589":70824,"_2954":118233},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3471":70859,"_30355":70824,"_21010":118235,"_5":14420,"_27589":70824,"_2954":118236},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3471":70860,"_30355":70824,"_21010":118238,"_5":14420,"_27589":118107,"_2954":118239},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3471":70861,"_30355":70824,"_21010":118241,"_5":14420,"_27589":118107,"_2954":118242},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3471":70862,"_30355":70824,"_21010":118244,"_5":14420,"_27589":118107,"_2954":118245},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3471":70863,"_30355":70824,"_21010":118247,"_5":14420,"_27589":118107,"_2954":118248},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3471":70864,"_30355":70824,"_21010":118250,"_5":14420,"_27589":118107,"_2954":118251},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3471":70865,"_30355":70824,"_21010":118253,"_5":14420,"_27589":118107,"_2954":118254},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3471":70866,"_30355":70824,"_21010":118256,"_5":14420,"_27589":118111,"_2954":118257},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3471":70867,"_30355":70824,"_21010":118259,"_5":14420,"_27589":118111,"_2954":118260},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3471":70868,"_30355":70824,"_21010":118262,"_5":14420,"_27589":118115,"_2954":118263},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3471":70869,"_30355":70824,"_21010":118265,"_5":14420,"_27589":118115,"_2954":118266},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3471":70870,"_30355":70824,"_21010":118268,"_5":14420,"_27589":118115,"_2954":118269},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3471":70871,"_30355":70824,"_21010":118271,"_5":14420,"_27589":118115,"_2954":118272},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3471":70872,"_30355":70824,"_21010":118274,"_5":14420,"_27589":118115,"_2954":118275},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3471":70873,"_30355":70824,"_21010":118277,"_5":14420,"_27589":118115,"_2954":118278},[],"Carga por separado las políticas concedidas a cada principal.",{"_3471":70874,"_30355":70824,"_21010":118280,"_5":14420,"_27589":118115,"_2954":118281},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3471":70875,"_30355":70824,"_21010":118283,"_5":14420,"_27589":118115,"_2954":118284},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3471":70876,"_30355":70824,"_21010":118286,"_5":14420,"_27589":118115,"_2954":118287},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3471":70877,"_30355":70824,"_21010":118289,"_5":14420,"_27589":118115,"_2954":118290},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3471":70878,"_30355":70824,"_21010":118292,"_5":14420,"_27589":118115,"_2954":118293},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3471":70879,"_30355":70824,"_21010":118295,"_5":14420,"_27589":118115,"_2954":118296},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3471":70880,"_30355":70824,"_21010":118298,"_5":14420,"_27589":118119,"_2954":118299},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3471":70881,"_30355":70824,"_21010":118301,"_5":14420,"_27589":118119,"_2954":118302},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3471":70882,"_30355":70824,"_21010":118304,"_5":14420,"_27589":118119,"_2954":118305},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3471":70883,"_30355":70824,"_21010":118307,"_5":14420,"_27589":118119,"_2954":118308},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3471":70884,"_30355":70824,"_21010":118310,"_5":14420,"_27589":118119,"_2954":118311},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3471":70885,"_30355":70824,"_21010":118313,"_5":14420,"_27589":118119,"_2954":118314},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3471":70886,"_30355":70824,"_21010":118316,"_5":14420,"_27589":118119,"_2954":118317},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3471":70887,"_30355":70824,"_21010":118319,"_5":14420,"_27589":118119,"_2954":118320},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3471":70888,"_30355":70824,"_21010":118322,"_5":14420,"_27589":118123,"_2954":118323},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3471":70889,"_30355":70824,"_21010":118325,"_5":14420,"_27589":118123,"_2954":118326},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3471":70890,"_30355":70824,"_21010":118328,"_5":14420,"_27589":118123,"_2954":118329},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3471":70891,"_30355":70824,"_21010":118331,"_5":14420,"_27589":118123,"_2954":118332},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3471":70892,"_30355":70824,"_21010":118334,"_5":14420,"_27589":118123,"_2954":118335},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3471":70893,"_30355":70824,"_21010":118337,"_5":14420,"_27589":118123,"_2954":118338},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3471":70894,"_30355":70824,"_21010":118340,"_5":14420,"_27589":118123,"_2954":118341},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3471":70895,"_30355":70824,"_21010":118343,"_5":14420,"_27589":118123,"_2954":118344},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3471":70896,"_30355":70824,"_21010":118346,"_5":14420,"_27589":118123,"_2954":118347},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3471":70897,"_30355":70824,"_21010":118349,"_5":14420,"_27589":118123,"_2954":118350},[],"Las acciones se dividen en dos grupos:",{"_3471":70898,"_30355":70824,"_21010":118352,"_5":14420,"_27589":118123,"_2954":118353},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3471":70899,"_30355":70824,"_21010":118355,"_5":14420,"_27589":118123,"_2954":118356},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3471":70900,"_30355":70824,"_21010":118358,"_5":14420,"_27589":118123,"_2954":118359},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3471":70901,"_30355":70824,"_21010":118361,"_5":14420,"_27589":118127,"_2954":118362},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3471":70902,"_30355":70824,"_21010":118364,"_5":14420,"_27589":118127,"_2954":118365},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3471":70903,"_30355":70824,"_21010":118367,"_5":14420,"_27589":118127,"_2954":118368},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3471":70904,"_30355":70824,"_21010":118370,"_5":14420,"_27589":118131,"_2954":118371},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3471":70905,"_30355":70824,"_21010":118373,"_5":14420,"_27589":118131,"_2954":118374},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3471":70906,"_30355":70824,"_21010":118376,"_5":14420,"_27589":118131,"_2954":118377},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3471":70907,"_30355":70824,"_21010":118379,"_5":14420,"_27589":118131,"_2954":118380},[],"Los operadores implementados son:",{"_3471":70908,"_30355":70824,"_21010":118382,"_5":14420,"_27589":118131,"_2954":118383},[],"`equals`, para igualdad exacta;",{"_3471":70909,"_30355":70824,"_21010":118385,"_5":14420,"_27589":118131,"_2954":118386},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3471":70910,"_30355":70824,"_21010":118388,"_5":14420,"_27589":118131,"_2954":118389},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3471":70911,"_30355":70824,"_21010":118391,"_5":14420,"_27589":118131,"_2954":118392},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3471":70912,"_30355":70824,"_21010":118394,"_5":14420,"_27589":118135,"_2954":118395},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3471":70913,"_30355":70824,"_21010":118397,"_5":14420,"_27589":118135,"_2954":118398},[],"Los modos disponibles son:",{"_3471":70914,"_30355":70824,"_21010":118400,"_5":14420,"_27589":118135,"_2954":118401},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3471":70915,"_30355":70824,"_21010":118403,"_5":14420,"_27589":118135,"_2954":118404},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3471":70916,"_30355":70824,"_21010":118406,"_5":14420,"_27589":118135,"_2954":118407},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3471":70917,"_30355":70824,"_21010":118409,"_5":14420,"_27589":118135,"_2954":118410},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3471":70918,"_30355":70824,"_21010":118412,"_5":14420,"_27589":118135,"_2954":118413},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3471":70919,"_30355":70824,"_21010":118415,"_5":14420,"_27589":118135,"_2954":118416},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3471":70920,"_30355":70824,"_21010":118418,"_5":14420,"_27589":118139,"_2954":118419},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3471":70921,"_30355":70824,"_21010":118421,"_5":14420,"_27589":118139,"_2954":118422},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3471":70922,"_30355":70824,"_21010":118424,"_5":14420,"_27589":118139,"_2954":118425},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3471":70923,"_30355":70824,"_21010":118427,"_5":14420,"_27589":118139,"_2954":118428},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3471":70924,"_30355":70824,"_21010":118430,"_5":14420,"_27589":118147,"_2954":118431},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3471":70925,"_30355":70824,"_21010":118433,"_5":14420,"_27589":118147,"_2954":118434},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3471":70926,"_30355":70824,"_21010":118436,"_5":14420,"_27589":118151,"_2954":118437},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3471":70927,"_30355":70824,"_21010":118439,"_5":14420,"_27589":118151,"_2954":118440},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3471":70928,"_30355":70824,"_21010":118442,"_5":14420,"_27589":118155,"_2954":118443},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3471":70929,"_30355":70824,"_21010":118445,"_5":14420,"_27589":118155,"_2954":118446},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3471":70930,"_30355":70824,"_21010":118448,"_5":14420,"_27589":118155,"_2954":118449},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3471":70931,"_30355":70824,"_21010":118451,"_5":14420,"_27589":118159,"_2954":118452},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3471":70932,"_30355":70824,"_21010":118454,"_5":14420,"_27589":118159,"_2954":118455},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3471":70933,"_30355":70824,"_21010":118457,"_5":14420,"_27589":118159,"_2954":118458},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3471":70934,"_30355":70824,"_21010":118460,"_5":14420,"_27589":118159,"_2954":118461},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3471":70935,"_30355":70824,"_21010":118463,"_5":14420,"_27589":118159,"_2954":118464},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3471":70936,"_30355":70824,"_21010":118466,"_5":14420,"_27589":118159,"_2954":118467},[],"Ten en cuenta que:",{"_3471":70937,"_30355":70824,"_21010":118469,"_5":14420,"_27589":118159,"_2954":118470},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3471":70938,"_30355":70824,"_21010":118472,"_5":14420,"_27589":118159,"_2954":118473},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3471":70939,"_30355":70824,"_21010":118475,"_5":14420,"_27589":118159,"_2954":118476},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3471":70940,"_30355":70824,"_21010":118478,"_5":14420,"_27589":118163,"_2954":118479},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3471":70941,"_30355":70824,"_21010":118481,"_5":14420,"_27589":118163,"_2954":118482},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3471":70942,"_30355":70824,"_21010":118484,"_5":14420,"_27589":118163,"_2954":118485},[],"acceso completo y de solo lectura a KMS;",{"_3471":70943,"_30355":70824,"_21010":118487,"_5":14420,"_27589":118163,"_2954":118488},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3471":70944,"_30355":70824,"_21010":118490,"_5":14420,"_27589":118163,"_2954":118491},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3471":70945,"_30355":70824,"_21010":118493,"_5":14420,"_27589":118163,"_2954":118494},[],"acceso a la interfaz;",{"_3471":70946,"_30355":70824,"_21010":118496,"_5":14420,"_27589":118163,"_2954":118497},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3471":70947,"_30355":70824,"_21010":118499,"_5":14420,"_27589":118163,"_2954":118500},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3471":70948,"_30355":70824,"_21010":118502,"_5":14420,"_27589":118163,"_2954":118503},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3471":70949,"_30355":70824,"_21010":118505,"_5":14420,"_27589":118167,"_2954":118506},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3471":70950,"_30355":70824,"_21010":118508,"_5":14420,"_27589":118167,"_2954":118509},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3471":70951,"_30355":70824,"_21010":118511,"_5":14420,"_27589":118167,"_2954":118512},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3471":70952,"_30355":70824,"_21010":118514,"_5":14420,"_27589":118170,"_2954":118515},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3471":70953,"_30355":70824,"_21010":118517,"_5":14420,"_27589":118174,"_2954":118518},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3471":70954,"_30355":70824,"_21010":118520,"_5":14420,"_27589":118174,"_2954":118521},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3471":70955,"_30355":70824,"_21010":118523,"_5":14420,"_27589":118178,"_2954":118524},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3471":70956,"_30355":70824,"_21010":118526,"_5":14420,"_27589":118182,"_2954":118527},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3471":70957,"_30355":70824,"_21010":118529,"_5":14420,"_27589":118186,"_2954":118530},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3471":70958,"_30355":70824,"_21010":118532,"_5":14420,"_27589":118190,"_2954":118533},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3471":70959,"_30355":70824,"_21010":118535,"_5":14420,"_27589":118190,"_2954":118536},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3471":70960,"_30355":70824,"_21010":118538,"_5":14420,"_27589":118194,"_2954":118539},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3471":70961,"_30355":70824,"_21010":118541,"_5":14420,"_27589":118194,"_2954":118542},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3471":70962,"_30355":70824,"_21010":118544,"_5":14420,"_27589":118194,"_2954":118545},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3471":70963,"_30355":70824,"_21010":118547,"_5":14420,"_27589":118194,"_2954":118548},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3471":70964,"_30355":70824,"_21010":118550,"_5":14420,"_27589":118194,"_2954":118551},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3471":70965,"_30355":70824,"_21010":118553,"_5":14420,"_27589":118194,"_2954":118554},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3471":70966,"_30355":70824,"_21010":118556,"_5":14420,"_27589":118194,"_2954":118557},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3471":70967,"_30355":70824,"_21010":118559,"_5":14420,"_27589":118194,"_2954":118560},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3471":70968,"_30355":70824,"_21010":118562,"_5":14420,"_27589":118198,"_2954":118563},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3471":70969,"_30355":70824,"_21010":118565,"_5":14420,"_27589":118198,"_2954":118566},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3471":70970,"_30355":70824,"_21010":118568,"_5":14420,"_27589":118198,"_2954":118569},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3471":70971,"_30355":70824,"_21010":118571,"_5":14420,"_27589":118202,"_2954":118572},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3471":70972,"_30355":70824,"_21010":118574,"_5":14420,"_27589":118202,"_2954":118575},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3471":70973,"_30355":70824,"_21010":118577,"_5":14420,"_27589":118202,"_2954":118578},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3471":70974,"_30355":70824,"_21010":118580,"_5":14420,"_27589":118202,"_2954":118581},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3471":70975,"_30355":70824,"_21010":118583,"_5":14420,"_27589":118202,"_2954":118584},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3471":70976,"_30355":70824,"_21010":118586,"_5":14420,"_27589":118202,"_2954":118587},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3471":70977,"_30355":70824,"_21010":118589,"_5":14420,"_27589":118202,"_2954":118590},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3471":70978,"_30355":70824,"_21010":118592,"_5":14420,"_27589":118202,"_2954":118593},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3471":70979,"_30355":70824,"_21010":118595,"_5":14420,"_27589":118210,"_2954":118596},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3471":70980,"_30355":70824,"_21010":118598,"_5":14420,"_27589":118214,"_2954":118599},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3471":70981,"_30355":70824,"_21010":118601,"_5":14420,"_27589":118214,"_2954":118602},[],"que exista un principal activo del tipo correcto;",{"_3471":70982,"_30355":70824,"_21010":118604,"_5":14420,"_27589":118214,"_2954":118605},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3471":70983,"_30355":70824,"_21010":118607,"_5":14420,"_27589":118214,"_2954":118608},[],"que todas las condiciones del principal se cumplan;",{"_3471":70984,"_30355":70824,"_21010":118610,"_5":14420,"_27589":118214,"_2954":118611},[],"que el principal tenga concedida la política esperada;",{"_3471":70985,"_30355":70824,"_21010":118613,"_5":14420,"_27589":118214,"_2954":118614},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3471":70986,"_30355":70824,"_21010":118616,"_5":14420,"_27589":118214,"_2954":118617},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3471":70987,"_30355":70824,"_21010":118619,"_5":14420,"_27589":118214,"_2954":118620},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3471":70988,"_30355":70824,"_21010":118622,"_5":14420,"_27589":118218,"_2954":118623},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3471":70989,"_30355":70824,"_21010":118625,"_5":14420,"_27589":118222,"_2954":118626},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3471":70990,"_30355":70824,"_21010":118628,"_5":14420,"_27589":118226,"_2954":118629},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3471":70991,"_30355":70824,"_21010":118631,"_5":14420,"_27589":118226,"_2954":118632},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3471":70992,"_30355":70992,"_5":14772,"_2954":118634,"_30687":118635,"_21010":118636,"_27589":70992},"Alertas y suscripciones",[49421,118099,118100],[],{"_3471":70993,"_30355":70992,"_21010":118638,"_5":14420,"_27589":70992,"_2954":118639},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3471":70994,"_30355":70992,"_5":30684,"_21010":118641,"_27589":118642,"_2954":118643},[],"/docs/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3471":70995,"_30355":70992,"_5":30684,"_21010":118645,"_27589":118646,"_2954":118647},[],"/docs/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3471":70996,"_30355":70992,"_5":30684,"_21010":118649,"_27589":118650,"_2954":118651},[],"/docs/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3471":70997,"_30355":70992,"_5":30684,"_21010":118653,"_27589":118654,"_2954":118655},[],"/docs/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3471":70998,"_30355":70992,"_5":30684,"_21010":118657,"_27589":118658,"_2954":118659},[],"/docs/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3471":70999,"_30355":70992,"_5":30684,"_21010":118661,"_27589":118662,"_2954":118663},[],"/docs/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3471":71000,"_30355":70992,"_5":30684,"_21010":118665,"_27589":118666,"_2954":118667},[],"/docs/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3471":71001,"_30355":70992,"_5":30684,"_21010":118669,"_27589":118670,"_2954":118671},[],"/docs/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3471":71002,"_30355":70992,"_5":30684,"_21010":118673,"_27589":118674,"_2954":118675},[],"/docs/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3471":71003,"_30355":70992,"_5":30684,"_21010":118677,"_27589":118678,"_2954":118679},[],"/docs/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3471":71004,"_30355":70992,"_5":30684,"_21010":118681,"_27589":118682,"_2954":118683},[],"/docs/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3471":71005,"_30355":70992,"_21010":118685,"_5":14420,"_27589":70992,"_2954":118686},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3471":71006,"_30355":70992,"_21010":118688,"_5":14420,"_27589":118642,"_2954":118689},[],"Un servicio publica un evento de dominio.",{"_3471":71007,"_30355":70992,"_21010":118691,"_5":14420,"_27589":118642,"_2954":118692},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3471":71008,"_30355":70992,"_21010":118694,"_5":14420,"_27589":118642,"_2954":118695},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3471":71009,"_30355":70992,"_21010":118697,"_5":14420,"_27589":118642,"_2954":118698},[],"Lamassu entrega el evento al canal configurado.",{"_3471":71010,"_30355":70992,"_21010":118700,"_5":14420,"_27589":118642,"_2954":118701},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3471":71011,"_30355":70992,"_21010":118703,"_5":14420,"_27589":118646,"_2954":118704},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3471":71012,"_30355":70992,"_21010":118706,"_5":14420,"_27589":118646,"_2954":118707},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3471":71013,"_30355":70992,"_21010":118709,"_5":14420,"_27589":118646,"_2954":118710},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3471":71014,"_30355":70992,"_21010":118712,"_5":14420,"_27589":118646,"_2954":118713},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3471":71015,"_30355":70992,"_21010":118715,"_5":14420,"_27589":118646,"_2954":118716},[],"`apikey_options` necesita `header` y `key`.",{"_3471":71016,"_30355":70992,"_21010":118718,"_5":14420,"_27589":118646,"_2954":118719},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3471":71017,"_30355":70992,"_21010":118721,"_5":14420,"_27589":118646,"_2954":118722},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3471":71018,"_30355":70992,"_21010":118724,"_5":14420,"_27589":118646,"_2954":118725},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3471":71019,"_30355":70992,"_21010":118727,"_5":14420,"_27589":118654,"_2954":118728},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3471":71020,"_30355":70992,"_21010":118730,"_5":14420,"_27589":118658,"_2954":118731},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3471":71021,"_30355":70992,"_21010":118733,"_5":14420,"_27589":118662,"_2954":118734},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3471":71022,"_30355":70992,"_21010":118736,"_5":14420,"_27589":118662,"_2954":118737},[],"**None** notifica todas las instancias del evento.",{"_3471":71023,"_30355":70992,"_21010":118739,"_5":14420,"_27589":118662,"_2954":118740},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3471":71024,"_30355":70992,"_21010":118742,"_5":14420,"_27589":118662,"_2954":118743},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3471":71025,"_30355":70992,"_21010":118745,"_5":14420,"_27589":118662,"_2954":118746},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3471":71026,"_30355":70992,"_21010":118748,"_5":14420,"_27589":118662,"_2954":118749},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3471":71027,"_30355":70992,"_21010":118751,"_5":14420,"_27589":118662,"_2954":118752},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3471":71028,"_30355":70992,"_21010":118754,"_5":14420,"_27589":118666,"_2954":118755},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3471":71029,"_30355":70992,"_21010":118757,"_5":14420,"_27589":118670,"_2954":118758},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3471":71030,"_30355":70992,"_21010":118760,"_5":14420,"_27589":118670,"_2954":118761},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3471":71031,"_30355":70992,"_21010":118763,"_5":14420,"_27589":118670,"_2954":118764},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3471":71032,"_30355":70992,"_21010":118766,"_5":14420,"_27589":118670,"_2954":118767},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3471":71033,"_30355":70992,"_21010":118769,"_5":14420,"_27589":118670,"_2954":118770},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3471":71034,"_30355":70992,"_21010":118772,"_5":14420,"_27589":118670,"_2954":118773},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3471":71035,"_30355":70992,"_21010":118775,"_5":14420,"_27589":118670,"_2954":118776},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3471":71036,"_30355":70992,"_21010":118778,"_5":14420,"_27589":118670,"_2954":118779},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3471":71037,"_30355":70992,"_21010":118781,"_5":14420,"_27589":118674,"_2954":118782},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3471":71038,"_30355":70992,"_21010":118784,"_5":14420,"_27589":118674,"_2954":118785},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3471":71039,"_30355":70992,"_21010":118787,"_5":14420,"_27589":118674,"_2954":118788},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3471":71040,"_30355":70992,"_21010":118790,"_5":14420,"_27589":118674,"_2954":118791},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3471":71041,"_30355":70992,"_21010":118793,"_5":14420,"_27589":118674,"_2954":118794},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3471":71042,"_30355":70992,"_21010":118796,"_5":14420,"_27589":118674,"_2954":118797},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3471":71043,"_30355":70992,"_21010":118799,"_5":14420,"_27589":118674,"_2954":118800},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3471":71044,"_30355":70992,"_21010":118802,"_5":14420,"_27589":118674,"_2954":118803},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3471":71045,"_30355":70992,"_21010":118805,"_5":14420,"_27589":118678,"_2954":118806},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3471":71046,"_30355":70992,"_21010":118808,"_5":14420,"_27589":118678,"_2954":118809},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3471":71047,"_30355":70992,"_21010":118811,"_5":14420,"_27589":118682,"_2954":118812},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3471":71048,"_30355":70992,"_21010":118814,"_5":14420,"_27589":118682,"_2954":118815},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3471":71049,"_30355":70992,"_21010":118817,"_5":14420,"_27589":118682,"_2954":118818},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3471":71050,"_30355":70992,"_21010":118820,"_5":14420,"_27589":118682,"_2954":118821},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3471":71051,"_30355":70992,"_21010":118823,"_5":14420,"_27589":118682,"_2954":118824},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3471":71052,"_30355":70992,"_21010":118826,"_5":14420,"_27589":118682,"_2954":118827},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init` y `va.crl-settings.update`.",{"_3471":71053,"_30355":70992,"_21010":118829,"_5":14420,"_27589":118682,"_2954":118830},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3471":71054,"_30355":70992,"_21010":118832,"_5":14420,"_27589":118682,"_2954":118833},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3471":71055,"_30355":70992,"_21010":118835,"_5":14420,"_27589":118682,"_2954":118836},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3471":71056,"_30355":71056,"_5":14772,"_2954":118838,"_30687":118839,"_21010":118840,"_27589":71056},"Registros de auditoría",[49421,118099,118100],[],{"_3471":71057,"_30355":71056,"_21010":118842,"_5":14420,"_27589":71056,"_2954":118843},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3471":71058,"_30355":71056,"_5":30684,"_21010":118845,"_27589":118846,"_2954":118847},[],"/docs/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3471":71059,"_30355":71056,"_5":30684,"_21010":118849,"_27589":118850,"_2954":118851},[],"/docs/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3471":71060,"_30355":71056,"_5":30684,"_21010":118853,"_27589":118854,"_2954":118855},[],"/docs/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3471":71061,"_30355":71056,"_5":30684,"_21010":118857,"_27589":118858,"_2954":118859},[],"/docs/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3471":71062,"_30355":71056,"_5":30684,"_21010":118861,"_27589":118862,"_2954":118863},[],"/docs/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3471":71063,"_30355":71056,"_5":30684,"_21010":118865,"_27589":118866,"_2954":118867},[],"/docs/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3471":71064,"_30355":71056,"_5":30684,"_21010":118869,"_27589":118870,"_2954":118871},[],"/docs/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3471":71065,"_30355":71056,"_5":30684,"_21010":118873,"_27589":118874,"_2954":118875},[],"/docs/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3471":71066,"_30355":71056,"_5":30684,"_21010":118877,"_27589":118878,"_2954":118879},[],"/docs/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3471":71067,"_30355":71056,"_5":30684,"_21010":118881,"_27589":118882,"_2954":118883},[],"/docs/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3471":71068,"_30355":71056,"_5":30684,"_21010":118885,"_27589":118886,"_2954":118887},[],"/docs/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3471":71069,"_30355":71056,"_21010":118889,"_5":14420,"_27589":71056,"_2954":118890},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3471":71070,"_30355":71056,"_21010":118892,"_5":14420,"_27589":118846,"_2954":118893},[],"El cuerpo de auditoría incluye:",{"_3471":71071,"_30355":71056,"_21010":118895,"_5":14420,"_27589":118846,"_2954":118896},[],"input: datos recibidos por la operación;",{"_3471":71072,"_30355":71056,"_21010":118898,"_5":14420,"_27589":118846,"_2954":118899},[],"has\\_error: indica si el servicio devolvió un error;",{"_3471":71073,"_30355":71056,"_21010":118901,"_5":14420,"_27589":118846,"_2954":118902},[],"output: resultado producido o mensaje de error;",{"_3471":71074,"_30355":71056,"_21010":118904,"_5":14420,"_27589":118846,"_2954":118905},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3471":71075,"_30355":71056,"_21010":118907,"_5":14420,"_27589":118846,"_2954":118908},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3471":71076,"_30355":71056,"_21010":118910,"_5":14420,"_27589":118846,"_2954":118911},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3471":71077,"_30355":71056,"_21010":118913,"_5":14420,"_27589":118850,"_2954":118914},[],"El backend aplica auditoría a mutaciones de:",{"_3471":71078,"_30355":71056,"_21010":118916,"_5":14420,"_27589":118850,"_2954":118917},[],"autoridades, certificados y perfiles de emisión;",{"_3471":71079,"_30355":71056,"_21010":118919,"_5":14420,"_27589":118850,"_2954":118920},[],"claves y motores KMS;",{"_3471":71080,"_30355":71056,"_21010":118922,"_5":14420,"_27589":118850,"_2954":118923},[],"dispositivos e identidades;",{"_3471":71081,"_30355":71056,"_21010":118925,"_5":14420,"_27589":118850,"_2954":118926},[],"DMS y operaciones de enrolamiento;",{"_3471":71082,"_30355":71056,"_21010":118928,"_5":14420,"_27589":118850,"_2954":118929},[],"funciones de validación y CRL;",{"_3471":71083,"_30355":71056,"_21010":118931,"_5":14420,"_27589":118850,"_2954":118932},[],"principales, políticas y concesiones de autorización.",{"_3471":71084,"_30355":71056,"_21010":118934,"_5":14420,"_27589":118850,"_2954":118935},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3471":71085,"_30355":71056,"_21010":118937,"_5":14420,"_27589":118854,"_2954":118938},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3471":71086,"_30355":71056,"_21010":118940,"_5":14420,"_27589":118854,"_2954":118941},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3471":71087,"_30355":71056,"_21010":118943,"_5":14420,"_27589":118854,"_2954":118944},[],"Diseña el consumidor para:",{"_3471":71088,"_30355":71056,"_21010":118946,"_5":14420,"_27589":118854,"_2954":118947},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3471":71089,"_30355":71056,"_21010":118949,"_5":14420,"_27589":118854,"_2954":118950},[],"conservar el CloudEvent completo sin modificar;",{"_3471":71090,"_30355":71056,"_21010":118952,"_5":14420,"_27589":118854,"_2954":118953},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3471":71091,"_30355":71056,"_21010":118955,"_5":14420,"_27589":118854,"_2954":118956},[],"cifrar en tránsito y en reposo;",{"_3471":71092,"_30355":71056,"_21010":118958,"_5":14420,"_27589":118854,"_2954":118959},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3471":71093,"_30355":71056,"_21010":118961,"_5":14420,"_27589":118854,"_2954":118962},[],"aplicar una política explícita de retención y legal hold;",{"_3471":71094,"_30355":71056,"_21010":118964,"_5":14420,"_27589":118854,"_2954":118965},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3471":71095,"_30355":71056,"_21010":118967,"_5":14420,"_27589":118858,"_2954":118968},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3471":71096,"_30355":71056,"_21010":118970,"_5":14420,"_27589":118858,"_2954":118971},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3471":71097,"_30355":71056,"_21010":118973,"_5":14420,"_27589":118866,"_2954":118974},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3471":71098,"_30355":71056,"_21010":118976,"_5":14420,"_27589":118870,"_2954":118977},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3471":71099,"_30355":71056,"_21010":118979,"_5":14420,"_27589":118874,"_2954":118980},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3471":71100,"_30355":71056,"_21010":118982,"_5":14420,"_27589":118878,"_2954":118983},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3471":71101,"_30355":71056,"_21010":118985,"_5":14420,"_27589":118882,"_2954":118986},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3471":71102,"_30355":71056,"_21010":118988,"_5":14420,"_27589":118886,"_2954":118989},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3471":71103,"_30355":71056,"_21010":118991,"_5":14420,"_27589":118886,"_2954":118992},[],"aparece un evento de auditoría correcto;",{"_3471":71104,"_30355":71056,"_21010":118994,"_5":14420,"_27589":118886,"_2954":118995},[],"el principal coincide con la identidad utilizada;",{"_3471":71105,"_30355":71056,"_21010":118997,"_5":14420,"_27589":118886,"_2954":118998},[],"el consumidor lo persiste una sola vez;",{"_3471":71106,"_30355":71056,"_21010":119000,"_5":14420,"_27589":118886,"_2954":119001},[],"puede recuperarse por recurso, actor y periodo;",{"_3471":71107,"_30355":71056,"_21010":119003,"_5":14420,"_27589":118886,"_2954":119004},[],"una interrupción del consumidor produce una alerta.",{"_3471":71108,"_30355":71056,"_21010":119006,"_5":14420,"_27589":118886,"_2954":119007},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3471":71109,"_30355":71109,"_5":14772,"_2954":119009,"_30687":119010,"_21010":119011,"_27589":71109},"Arquitectura de la plataforma",[49421,118099],[],{"_3471":71110,"_30355":71109,"_21010":119013,"_5":14420,"_27589":71109,"_2954":119014},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3471":71111,"_30355":71109,"_5":30684,"_21010":119016,"_27589":119017,"_2954":119018},[],"/docs/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3471":71112,"_30355":71109,"_5":30684,"_21010":119020,"_27589":119021,"_2954":119022},[],"/docs/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3471":71113,"_30355":71109,"_5":30684,"_21010":119024,"_27589":119025,"_2954":119026},[],"/docs/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3471":71114,"_30355":71109,"_5":30684,"_21010":119028,"_27589":119029,"_2954":119030},[],"/docs/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3471":71115,"_30355":71109,"_5":30684,"_21010":119032,"_27589":119033,"_2954":119034},[],"/docs/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3471":71116,"_30355":71109,"_21010":119036,"_5":14420,"_27589":71109,"_2954":119037},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3471":71117,"_30355":71109,"_21010":119039,"_5":14420,"_27589":71109,"_2954":119040},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3471":71118,"_30355":71109,"_21010":119042,"_5":14420,"_27589":119017,"_2954":119043},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3471":71119,"_30355":71109,"_21010":119045,"_5":14420,"_27589":119021,"_2954":119046},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3471":71120,"_30355":71109,"_21010":119048,"_5":14420,"_27589":119025,"_2954":119049},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3471":71121,"_30355":71109,"_21010":119051,"_5":14420,"_27589":119029,"_2954":119052},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3471":71122,"_30355":71109,"_21010":119054,"_5":14420,"_27589":119033,"_2954":119055},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3471":71123,"_30355":71123,"_5":14772,"_2954":119057,"_30687":119058,"_21010":119059,"_27589":71123},"Cómo funciona Lamassu",[49421,118099],[],{"_3471":71124,"_30355":71123,"_21010":119061,"_5":14420,"_27589":71123,"_2954":119062},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3471":71125,"_30355":71123,"_5":30684,"_21010":119064,"_27589":119065,"_2954":119066},[],"/docs/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3471":71126,"_30355":71123,"_5":30684,"_21010":119068,"_27589":119069,"_2954":119070},[],"/docs/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3471":71127,"_30355":71123,"_21010":119072,"_5":14420,"_27589":71123,"_2954":119073},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3471":71128,"_30355":71123,"_21010":119075,"_5":14420,"_27589":119065,"_2954":119076},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3471":71129,"_30355":71123,"_21010":119078,"_5":14420,"_27589":119065,"_2954":119079},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3471":71130,"_30355":71123,"_21010":119081,"_5":14420,"_27589":119065,"_2954":119082},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3471":71131,"_30355":71123,"_21010":119084,"_5":14420,"_27589":119065,"_2954":119085},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3471":71132,"_30355":71123,"_21010":119087,"_5":14420,"_27589":119065,"_2954":119088},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3471":71133,"_30355":71123,"_21010":119090,"_5":14420,"_27589":119069,"_2954":119091},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3471":71134,"_30355":71123,"_21010":119093,"_5":14420,"_27589":119069,"_2954":119094},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3471":71135,"_30355":71123,"_21010":119096,"_5":14420,"_27589":119069,"_2954":119097},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3471":71136,"_30355":71123,"_21010":119099,"_5":14420,"_27589":119069,"_2954":119100},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3471":71137,"_30355":71123,"_21010":119102,"_5":14420,"_27589":119069,"_2954":119103},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3471":71138,"_30355":71123,"_21010":119105,"_5":14420,"_27589":119069,"_2954":119106},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3471":71139,"_30355":71123,"_21010":119108,"_5":14420,"_27589":119069,"_2954":119109},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3471":71140,"_30355":71140,"_5":14772,"_2954":119111,"_30687":119112,"_21010":119113,"_27589":71140},"Dispositivos e identidades",[49421,118099,51910,119111],[],{"_3471":71141,"_30355":71140,"_21010":119115,"_5":14420,"_27589":71140,"_2954":119116},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3471":71142,"_30355":71140,"_5":30684,"_21010":119118,"_27589":119119,"_2954":119120},[],"/docs/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3471":71143,"_30355":71140,"_5":30684,"_21010":119122,"_27589":119123,"_2954":119124},[],"/docs/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3471":71144,"_30355":71140,"_5":30684,"_21010":119126,"_27589":119127,"_2954":119128},[],"/docs/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3471":71145,"_30355":71140,"_5":30684,"_21010":119130,"_27589":119131,"_2954":119132},[],"/docs/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3471":71146,"_30355":71140,"_5":30684,"_21010":119134,"_27589":119135,"_2954":119136},[],"/docs/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3471":71147,"_30355":71140,"_5":30684,"_21010":119138,"_27589":119139,"_2954":119140},[],"/docs/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3471":71148,"_30355":71140,"_5":30684,"_21010":119142,"_27589":119143,"_2954":119144},[],"/docs/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3471":71149,"_30355":71140,"_5":30684,"_21010":119146,"_27589":119147,"_2954":119148},[],"/docs/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3471":71150,"_30355":71140,"_5":30684,"_21010":119150,"_27589":119151,"_2954":119152},[],"/docs/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3471":71151,"_30355":71140,"_5":30684,"_21010":119154,"_27589":119155,"_2954":119156},[],"/docs/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3471":71152,"_30355":71140,"_5":30684,"_21010":119158,"_27589":119159,"_2954":119160},[],"/docs/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3471":71153,"_30355":71140,"_21010":119162,"_5":14420,"_27589":71140,"_2954":119163},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3471":71154,"_30355":71140,"_21010":119165,"_5":14420,"_27589":71140,"_2954":119166},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3471":71155,"_30355":71140,"_21010":119168,"_5":14420,"_27589":119119,"_2954":119169},[],"Vista operativa",{"_3471":71156,"_30355":71140,"_21010":119171,"_5":14420,"_27589":119119,"_2954":119172},[],"Interpretación",{"_3471":71157,"_30355":71140,"_21010":119174,"_5":14420,"_27589":119119,"_2954":51973},[],{"_3471":71158,"_30355":71140,"_21010":119176,"_5":14420,"_27589":119119,"_2954":119177},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3471":71159,"_30355":71140,"_21010":119179,"_5":14420,"_27589":119119,"_2954":51979},[],{"_3471":71160,"_30355":71140,"_21010":119181,"_5":14420,"_27589":119119,"_2954":119182},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3471":71161,"_30355":71140,"_21010":119184,"_5":14420,"_27589":119119,"_2954":51985},[],{"_3471":71162,"_30355":71140,"_21010":119186,"_5":14420,"_27589":119119,"_2954":119187},[],"La identidad está en la ventana operativa de renovación.",{"_3471":71163,"_30355":71140,"_21010":119189,"_5":14420,"_27589":119119,"_2954":51991},[],{"_3471":71164,"_30355":71140,"_21010":119191,"_5":14420,"_27589":119119,"_2954":119192},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3471":71165,"_30355":71140,"_21010":119194,"_5":14420,"_27589":119119,"_2954":51997},[],{"_3471":71166,"_30355":71140,"_21010":119196,"_5":14420,"_27589":119119,"_2954":119197},[],"La identidad ha vencido.",{"_3471":71167,"_30355":71140,"_21010":119199,"_5":14420,"_27589":119119,"_2954":52003},[],{"_3471":71168,"_30355":71140,"_21010":119201,"_5":14420,"_27589":119119,"_2954":119202},[],"La identidad está marcada como revocada.",{"_3471":71169,"_30355":71140,"_21010":119204,"_5":14420,"_27589":119119,"_2954":52009},[],{"_3471":71170,"_30355":71140,"_21010":119206,"_5":14420,"_27589":119119,"_2954":119207},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3471":71171,"_30355":71140,"_21010":119209,"_5":14420,"_27589":119119,"_2954":119210},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3471":71172,"_30355":71140,"_21010":119212,"_5":14420,"_27589":119123,"_2954":119213},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3471":71173,"_30355":71140,"_21010":119215,"_5":14420,"_27589":119123,"_2954":119216},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3471":71174,"_30355":71140,"_21010":119218,"_5":14420,"_27589":119123,"_2954":119219},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3471":71175,"_30355":71140,"_21010":119221,"_5":14420,"_27589":119123,"_2954":119222},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3471":71176,"_30355":71140,"_21010":119224,"_5":14420,"_27589":119127,"_2954":119225},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3471":71177,"_30355":71140,"_21010":119227,"_5":14420,"_27589":119131,"_2954":119228},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3471":71178,"_30355":71140,"_21010":119230,"_5":14420,"_27589":119135,"_2954":119231},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3471":71179,"_30355":71140,"_21010":119233,"_5":14420,"_27589":119139,"_2954":119234},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3471":71180,"_30355":71140,"_21010":119236,"_5":14420,"_27589":119143,"_2954":119237},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3471":71181,"_30355":71140,"_21010":119239,"_5":14420,"_27589":119143,"_2954":119240},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3471":71182,"_30355":71140,"_21010":119242,"_5":14420,"_27589":119147,"_2954":119243},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3471":71183,"_30355":71140,"_21010":119245,"_5":14420,"_27589":119147,"_2954":119246},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3471":71184,"_30355":71140,"_21010":119248,"_5":14420,"_27589":119147,"_2954":119249},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3471":71185,"_30355":71140,"_21010":119251,"_5":14420,"_27589":119147,"_2954":119252},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3471":71186,"_30355":71140,"_21010":119254,"_5":14420,"_27589":119147,"_2954":119255},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3471":71187,"_30355":71140,"_21010":119257,"_5":14420,"_27589":119147,"_2954":119258},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3471":71188,"_30355":71140,"_21010":119260,"_5":14420,"_27589":119151,"_2954":119261},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3471":71189,"_30355":71140,"_21010":119263,"_5":14420,"_27589":119151,"_2954":119264},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3471":71190,"_30355":71140,"_21010":119266,"_5":14420,"_27589":119155,"_2954":119267},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3471":71191,"_30355":71140,"_21010":119269,"_5":14420,"_27589":119155,"_2954":119270},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3471":71192,"_30355":71140,"_21010":119272,"_5":14420,"_27589":119155,"_2954":119273},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3471":71193,"_30355":71140,"_21010":119275,"_5":14420,"_27589":119155,"_2954":119276},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3471":71194,"_30355":71140,"_21010":119278,"_5":14420,"_27589":119159,"_2954":119279},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3471":71195,"_30355":71140,"_21010":119281,"_5":14420,"_27589":119159,"_2954":119282},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3471":71196,"_30355":71196,"_5":14772,"_2954":119284,"_30687":119285,"_21010":119287,"_27589":71196},"Identidad inicial y autenticación",[49421,118099,51910,119111,119286],"Enrolamiento con PKI",[],{"_3471":71197,"_30355":71196,"_21010":119289,"_5":14420,"_27589":71196,"_2954":119290},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3471":71198,"_30355":71196,"_5":30684,"_21010":119292,"_27589":119293,"_2954":119294},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3471":71199,"_30355":71196,"_5":30684,"_21010":119296,"_27589":119297,"_2954":119298},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3471":71200,"_30355":71196,"_5":30684,"_21010":119300,"_27589":119301,"_2954":119302},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3471":71201,"_30355":71196,"_5":30684,"_21010":119304,"_27589":119305,"_2954":119306},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3471":71202,"_30355":71196,"_5":30684,"_21010":119308,"_27589":119309,"_2954":119310},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3471":71203,"_30355":71196,"_21010":119312,"_5":14420,"_27589":71196,"_2954":119313},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3471":71204,"_30355":71196,"_21010":119315,"_5":14420,"_27589":119293,"_2954":119316},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3471":71205,"_30355":71196,"_21010":119318,"_5":14420,"_27589":119293,"_2954":119319},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3471":71206,"_30355":71196,"_21010":119321,"_5":14420,"_27589":119297,"_2954":119322},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3471":71207,"_30355":71196,"_21010":119324,"_5":14420,"_27589":119297,"_2954":119325},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3471":71208,"_30355":71196,"_21010":119327,"_5":14420,"_27589":119297,"_2954":119328},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3471":71209,"_30355":71196,"_21010":119330,"_5":14420,"_27589":119301,"_2954":119331},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3471":71210,"_30355":71196,"_21010":119333,"_5":14420,"_27589":119301,"_2954":119334},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3471":71211,"_30355":71196,"_21010":119336,"_5":14420,"_27589":119305,"_2954":119337},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3471":71212,"_30355":71196,"_21010":119339,"_5":14420,"_27589":119305,"_2954":119340},[],"Ejemplo de cuerpo:",{"_3471":71213,"_30355":71196,"_21010":119342,"_5":14420,"_27589":119305,"_2954":119343},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3471":71214,"_30355":71196,"_21010":119345,"_5":14420,"_27589":119305,"_2954":119346},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3471":71215,"_30355":71196,"_21010":119348,"_5":14420,"_27589":119305,"_2954":119349},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3471":71216,"_30355":71196,"_21010":119351,"_5":14420,"_27589":119305,"_2954":119352},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3471":71217,"_30355":71196,"_21010":119354,"_5":14420,"_27589":119309,"_2954":119355},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3471":71218,"_30355":71196,"_21010":119357,"_5":14420,"_27589":119309,"_2954":119358},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3471":71219,"_30355":71219,"_5":14772,"_2954":119360,"_30687":119361,"_21010":119362,"_27589":71219},"Configura y opera el DMS",[49421,118099,51910,119111,119286],[],{"_3471":71220,"_30355":71219,"_21010":119364,"_5":14420,"_27589":71219,"_2954":119365},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3471":71221,"_30355":71219,"_5":30684,"_21010":119367,"_27589":119368,"_2954":116670},[],"/docs/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3471":71222,"_30355":71219,"_5":30684,"_21010":119370,"_27589":119371,"_2954":119372},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3471":71223,"_30355":71219,"_5":30684,"_21010":119374,"_27589":119375,"_2954":119376},[],"/docs/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3471":71224,"_30355":71219,"_5":30684,"_21010":119378,"_27589":119379,"_2954":119380},[],"/docs/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3471":71225,"_30355":71219,"_5":30684,"_21010":119382,"_27589":119383,"_2954":119384},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3471":71226,"_30355":71219,"_5":30684,"_21010":119386,"_27589":119387,"_2954":119388},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3471":71227,"_30355":71219,"_5":30684,"_21010":119390,"_27589":119391,"_2954":119392},[],"/docs/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3471":71228,"_30355":71219,"_5":30684,"_21010":119394,"_27589":119395,"_2954":119396},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3471":71229,"_30355":71219,"_5":30684,"_21010":119398,"_27589":119399,"_2954":52205},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3471":71230,"_30355":71219,"_5":30684,"_21010":119401,"_27589":119402,"_2954":52209},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3471":71231,"_30355":71219,"_5":30684,"_21010":119404,"_27589":119405,"_2954":119406},[],"/docs/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3471":71232,"_30355":71219,"_5":30684,"_21010":119408,"_27589":119409,"_2954":119410},[],"/docs/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3471":71233,"_30355":71219,"_5":30684,"_21010":119412,"_27589":119413,"_2954":119414},[],"/docs/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3471":71234,"_30355":71219,"_5":30684,"_21010":119416,"_27589":119417,"_2954":119418},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3471":71235,"_30355":71219,"_5":30684,"_21010":119420,"_27589":119421,"_2954":52229},[],"/docs/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3471":71236,"_30355":71219,"_5":30684,"_21010":119423,"_27589":119424,"_2954":119425},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3471":71237,"_30355":71219,"_5":30684,"_21010":119427,"_27589":119428,"_2954":119429},[],"/docs/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3471":71238,"_30355":71219,"_5":30684,"_21010":119431,"_27589":119432,"_2954":119433},[],"/docs/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3471":71239,"_30355":71219,"_21010":119435,"_5":14420,"_27589":71219,"_2954":119436},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3471":71240,"_30355":71219,"_21010":119438,"_5":14420,"_27589":119368,"_2954":119439},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3471":71241,"_30355":71219,"_21010":119441,"_5":14420,"_27589":119368,"_2954":119442},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3471":71242,"_30355":71219,"_21010":119444,"_5":14420,"_27589":119375,"_2954":119445},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3471":71243,"_30355":71219,"_21010":119447,"_5":14420,"_27589":119379,"_2954":119448},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3471":71244,"_30355":71219,"_21010":119450,"_5":14420,"_27589":119383,"_2954":119451},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3471":71245,"_30355":71219,"_21010":119453,"_5":14420,"_27589":119387,"_2954":119454},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3471":71246,"_30355":71219,"_21010":119456,"_5":14420,"_27589":119391,"_2954":119457},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3471":71247,"_30355":71219,"_21010":119459,"_5":14420,"_27589":119399,"_2954":119460},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3471":71248,"_30355":71219,"_21010":119462,"_5":14420,"_27589":119399,"_2954":119463},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3471":71249,"_30355":71219,"_21010":119465,"_5":14420,"_27589":119402,"_2954":119466},[],"Campo de `settings.enrollment_settings`",{"_3471":71250,"_30355":71219,"_21010":119468,"_5":14420,"_27589":119402,"_2954":119469},[],"Decisión",{"_3471":71251,"_30355":71219,"_21010":119471,"_5":14420,"_27589":119402,"_2954":52280},[],{"_3471":71252,"_30355":71219,"_21010":119473,"_5":14420,"_27589":119402,"_2954":119474},[],"`EST_RFC7030` para estas operaciones.",{"_3471":71253,"_30355":71219,"_21010":119476,"_5":14420,"_27589":119402,"_2954":52286},[],{"_3471":71254,"_30355":71219,"_21010":119478,"_5":14420,"_27589":119402,"_2954":119479},[],"ID de la CA que firmará.",{"_3471":71255,"_30355":71219,"_21010":119481,"_5":14420,"_27589":119402,"_2954":52292},[],{"_3471":71256,"_30355":71219,"_21010":119483,"_5":14420,"_27589":119402,"_2954":119484},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3471":71257,"_30355":71219,"_21010":119486,"_5":14420,"_27589":119402,"_2954":52298},[],{"_3471":71258,"_30355":71219,"_21010":119488,"_5":14420,"_27589":119402,"_2954":119489},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3471":71259,"_30355":71219,"_21010":119491,"_5":14420,"_27589":119402,"_2954":52304},[],{"_3471":71260,"_30355":71219,"_21010":119493,"_5":14420,"_27589":119402,"_2954":119494},[],"Uno de los cuatro modos de autenticación.",{"_3471":71261,"_30355":71219,"_21010":119496,"_5":14420,"_27589":119402,"_2954":119497},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3471":71262,"_30355":71219,"_21010":119499,"_5":14420,"_27589":119405,"_2954":119500},[],"Los bloques son independientes:",{"_3471":71263,"_30355":71219,"_21010":119502,"_5":14420,"_27589":119405,"_2954":119503},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3471":71264,"_30355":71219,"_21010":119505,"_5":14420,"_27589":119405,"_2954":119506},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3471":71265,"_30355":71219,"_21010":119508,"_5":14420,"_27589":119405,"_2954":52322},[],{"_3471":71266,"_30355":71219,"_21010":119510,"_5":14420,"_27589":119405,"_2954":119511},[],"Control aplicado en la operación configurada",{"_3471":71267,"_30355":71219,"_21010":119513,"_5":14420,"_27589":119405,"_2954":52328},[],{"_3471":71268,"_30355":71219,"_21010":119515,"_5":14420,"_27589":119405,"_2954":119516},[],"Validación del certificado presentado.",{"_3471":71269,"_30355":71219,"_21010":119518,"_5":14420,"_27589":119405,"_2954":52334},[],{"_3471":71270,"_30355":71219,"_21010":119520,"_5":14420,"_27589":119405,"_2954":119521},[],"Autorización del webhook configurado.",{"_3471":71271,"_30355":71219,"_21010":119523,"_5":14420,"_27589":119405,"_2954":52340},[],{"_3471":71272,"_30355":71219,"_21010":119525,"_5":14420,"_27589":119405,"_2954":119526},[],"Validación del certificado y, después, aprobación del webhook.",{"_3471":71273,"_30355":71219,"_21010":119528,"_5":14420,"_27589":119405,"_2954":52346},[],{"_3471":71274,"_30355":71219,"_21010":119530,"_5":14420,"_27589":119405,"_2954":119531},[],"Sin autenticación del solicitante por el DMS.",{"_3471":71275,"_30355":71219,"_21010":119533,"_5":14420,"_27589":119405,"_2954":119534},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3471":71276,"_30355":71219,"_21010":119536,"_5":14420,"_27589":119405,"_2954":119537},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3471":71277,"_30355":71219,"_21010":119539,"_5":14420,"_27589":119405,"_2954":119540},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3471":71278,"_30355":71219,"_21010":119542,"_5":14420,"_27589":119405,"_2954":119543},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3471":71279,"_30355":71219,"_21010":119545,"_5":14420,"_27589":119409,"_2954":119546},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3471":71280,"_30355":71219,"_21010":119548,"_5":14420,"_27589":119409,"_2954":119549},[],"Campo de `external_webhook_settings`",{"_3471":71281,"_30355":71219,"_21010":119551,"_5":14420,"_27589":119409,"_2954":119469},[],{"_3471":71282,"_30355":71219,"_21010":119553,"_5":14420,"_27589":119409,"_2954":52372},[],{"_3471":71283,"_30355":71219,"_21010":119555,"_5":14420,"_27589":119409,"_2954":119556},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3471":71284,"_30355":71219,"_21010":119558,"_5":14420,"_27589":119409,"_2954":52378},[],{"_3471":71285,"_30355":71219,"_21010":119560,"_5":14420,"_27589":119409,"_2954":119561},[],"`POST` o `PUT`; `POST` por defecto.",{"_3471":71286,"_30355":71219,"_21010":119563,"_5":14420,"_27589":119409,"_2954":52384},[],{"_3471":71287,"_30355":71219,"_21010":119565,"_5":14420,"_27589":119409,"_2954":119566},[],"Etiqueta usada en los logs del servicio.",{"_3471":71288,"_30355":71219,"_21010":119568,"_5":14420,"_27589":119409,"_2954":52390},[],{"_3471":71289,"_30355":71219,"_21010":119570,"_5":14420,"_27589":119409,"_2954":119571},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3471":71290,"_30355":71219,"_21010":119573,"_5":14420,"_27589":119409,"_2954":52396},[],{"_3471":71291,"_30355":71219,"_21010":119575,"_5":14420,"_27589":119409,"_2954":119576},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3471":71292,"_30355":71219,"_21010":119578,"_5":14420,"_27589":119409,"_2954":52402},[],{"_3471":71293,"_30355":71219,"_21010":119580,"_5":14420,"_27589":119409,"_2954":119581},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3471":71294,"_30355":71219,"_21010":119583,"_5":14420,"_27589":119409,"_2954":52408},[],{"_3471":71295,"_30355":71219,"_21010":119585,"_5":14420,"_27589":119409,"_2954":119586},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3471":71296,"_30355":71219,"_21010":119588,"_5":14420,"_27589":119409,"_2954":52414},[],{"_3471":71297,"_30355":71219,"_21010":119590,"_5":14420,"_27589":119409,"_2954":119591},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3471":71298,"_30355":71219,"_21010":119593,"_5":14420,"_27589":119409,"_2954":52420},[],{"_3471":71299,"_30355":71219,"_21010":119595,"_5":14420,"_27589":119409,"_2954":119596},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3471":71300,"_30355":71219,"_21010":119598,"_5":14420,"_27589":119409,"_2954":52426},[],{"_3471":71301,"_30355":71219,"_21010":119600,"_5":14420,"_27589":119409,"_2954":119601},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3471":71302,"_30355":71219,"_21010":119603,"_5":14420,"_27589":119409,"_2954":119604},[],"Reglas de esa configuración:",{"_3471":71303,"_30355":71219,"_21010":119606,"_5":14420,"_27589":119409,"_2954":119607},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3471":71304,"_30355":71219,"_21010":119609,"_5":14420,"_27589":119409,"_2954":119610},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3471":71305,"_30355":71219,"_21010":119612,"_5":14420,"_27589":119409,"_2954":119613},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3471":71306,"_30355":71219,"_21010":119615,"_5":14420,"_27589":119409,"_2954":119616},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3471":71307,"_30355":71219,"_21010":119618,"_5":14420,"_27589":119409,"_2954":119619},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3471":71308,"_30355":71219,"_21010":119621,"_5":14420,"_27589":119409,"_2954":119622},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3471":71309,"_30355":71219,"_21010":119624,"_5":14420,"_27589":119409,"_2954":119625},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3471":71310,"_30355":71219,"_21010":119627,"_5":14420,"_27589":119409,"_2954":119628},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3471":71311,"_30355":71219,"_21010":119630,"_5":14420,"_27589":119409,"_2954":119631},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3471":71312,"_30355":71219,"_21010":119633,"_5":14420,"_27589":119413,"_2954":119634},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3471":71313,"_30355":71219,"_21010":119636,"_5":14420,"_27589":119417,"_2954":119637},[],"Campo de `settings.reenrollment_settings`",{"_3471":71314,"_30355":71219,"_21010":119639,"_5":14420,"_27589":119417,"_2954":119640},[],"Función",{"_3471":71315,"_30355":71219,"_21010":119642,"_5":14420,"_27589":119417,"_2954":52470},[],{"_3471":71316,"_30355":71219,"_21010":119644,"_5":14420,"_27589":119417,"_2954":119645},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3471":71317,"_30355":71219,"_21010":119647,"_5":14420,"_27589":119417,"_2954":52476},[],{"_3471":71318,"_30355":71219,"_21010":119649,"_5":14420,"_27589":119417,"_2954":119650},[],"Umbral operativo preventivo de monitorización.",{"_3471":71319,"_30355":71219,"_21010":119652,"_5":14420,"_27589":119417,"_2954":52482},[],{"_3471":71320,"_30355":71219,"_21010":119654,"_5":14420,"_27589":119417,"_2954":119655},[],"Umbral operativo crítico de monitorización.",{"_3471":71321,"_30355":71219,"_21010":119657,"_5":14420,"_27589":119417,"_2954":52488},[],{"_3471":71322,"_30355":71219,"_21010":119659,"_5":14420,"_27589":119417,"_2954":119660},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3471":71323,"_30355":71219,"_21010":119662,"_5":14420,"_27589":119417,"_2954":52494},[],{"_3471":71324,"_30355":71219,"_21010":119664,"_5":14420,"_27589":119417,"_2954":119665},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3471":71325,"_30355":71219,"_21010":119667,"_5":14420,"_27589":119417,"_2954":52500},[],{"_3471":71326,"_30355":71219,"_21010":119669,"_5":14420,"_27589":119417,"_2954":119670},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3471":71327,"_30355":71219,"_21010":119672,"_5":14420,"_27589":119417,"_2954":119673},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3471":71328,"_30355":71219,"_21010":119675,"_5":14420,"_27589":119421,"_2954":119676},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3471":71329,"_30355":71219,"_21010":119678,"_5":14420,"_27589":119424,"_2954":117034},[],{"_3471":71330,"_30355":71219,"_21010":119680,"_5":14420,"_27589":119424,"_2954":119681},[],"Qué publica",{"_3471":71331,"_30355":71219,"_21010":119683,"_5":14420,"_27589":119424,"_2954":52517},[],{"_3471":71332,"_30355":71219,"_21010":119685,"_5":14420,"_27589":119424,"_2954":119686},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3471":71333,"_30355":71219,"_21010":119688,"_5":14420,"_27589":119424,"_2954":52523},[],{"_3471":71334,"_30355":71219,"_21010":119690,"_5":14420,"_27589":119424,"_2954":119691},[],"Certificado de la CA emisora seleccionada.",{"_3471":71335,"_30355":71219,"_21010":119693,"_5":14420,"_27589":119424,"_2954":52529},[],{"_3471":71336,"_30355":71219,"_21010":119695,"_5":14420,"_27589":119424,"_2954":119696},[],"Certificados de las CAs elegidas explícitamente.",{"_3471":71337,"_30355":71219,"_21010":119698,"_5":14420,"_27589":119424,"_2954":119699},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3471":71338,"_30355":71219,"_21010":119701,"_5":14420,"_27589":119428,"_2954":119702},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3471":71339,"_30355":71219,"_21010":119704,"_5":14420,"_27589":119428,"_2954":119705},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3471":71340,"_30355":71219,"_21010":119707,"_5":14420,"_27589":119428,"_2954":119708},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3471":71341,"_30355":71219,"_21010":119710,"_5":14420,"_27589":119432,"_2954":119711},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3471":71342,"_30355":71342,"_5":14772,"_2954":119713,"_30687":119714,"_21010":119715,"_27589":71342},"Integra el cliente EST",[49421,118099,51910,119111,119286],[],{"_3471":71343,"_30355":71342,"_21010":119717,"_5":14420,"_27589":71342,"_2954":119718},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3471":71344,"_30355":71342,"_5":30684,"_21010":119720,"_27589":119721,"_2954":116670},[],"/docs/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3471":71345,"_30355":71342,"_5":30684,"_21010":119723,"_27589":119724,"_2954":119725},[],"/docs/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3471":71346,"_30355":71342,"_5":30684,"_21010":119727,"_27589":119728,"_2954":119729},[],"/docs/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3471":71347,"_30355":71342,"_5":30684,"_21010":119731,"_27589":119732,"_2954":119733},[],"/docs/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3471":71348,"_30355":71342,"_5":30684,"_21010":119735,"_27589":119736,"_2954":119737},[],"/docs/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3471":71349,"_30355":71342,"_5":30684,"_21010":119739,"_27589":119740,"_2954":119741},[],"/docs/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3471":71350,"_30355":71342,"_21010":119743,"_5":14420,"_27589":71342,"_2954":119744},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3471":71351,"_30355":71342,"_21010":119746,"_5":14420,"_27589":119721,"_2954":119747},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3471":71352,"_30355":71342,"_21010":119749,"_5":14420,"_27589":119721,"_2954":119750},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3471":71353,"_30355":71342,"_21010":119752,"_5":14420,"_27589":119721,"_2954":119753},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3471":71354,"_30355":71342,"_21010":119755,"_5":14420,"_27589":119724,"_2954":119756},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3471":71355,"_30355":71342,"_21010":119758,"_5":14420,"_27589":119724,"_2954":119759},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3471":71356,"_30355":71342,"_21010":119761,"_5":14420,"_27589":119728,"_2954":119762},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3471":71357,"_30355":71342,"_21010":119764,"_5":14420,"_27589":119728,"_2954":119765},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3471":71358,"_30355":71342,"_21010":119767,"_5":14420,"_27589":119732,"_2954":119768},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3471":71359,"_30355":71342,"_21010":119770,"_5":14420,"_27589":119732,"_2954":119771},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3471":71360,"_30355":71342,"_21010":119773,"_5":14420,"_27589":119736,"_2954":119774},[],"Para el caso de una raíz que emite directamente:",{"_3471":71361,"_30355":71342,"_21010":119776,"_5":14420,"_27589":119736,"_2954":119777},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3471":71362,"_30355":71342,"_21010":119779,"_5":14420,"_27589":119736,"_2954":119780},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3471":71363,"_30355":71342,"_21010":119782,"_5":14420,"_27589":119740,"_2954":119783},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3471":71364,"_30355":71364,"_5":14772,"_2954":119785,"_30687":119786,"_21010":119787,"_27589":71364},"Referencia EST",[49421,118099,51910,119111,119286],[],{"_3471":71365,"_30355":71364,"_21010":119789,"_5":14420,"_27589":71364,"_2954":119790},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3471":71366,"_30355":71364,"_5":30684,"_21010":119792,"_27589":119793,"_2954":119794},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3471":71367,"_30355":71364,"_5":30684,"_21010":119796,"_27589":119797,"_2954":22765},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3471":71368,"_30355":71364,"_5":30684,"_21010":119799,"_27589":119800,"_2954":26172},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3471":71369,"_30355":71364,"_5":30684,"_21010":119802,"_27589":119803,"_2954":26179},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3471":71370,"_30355":71364,"_5":30684,"_21010":119805,"_27589":119806,"_2954":25492},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3471":71371,"_30355":71364,"_5":30684,"_21010":119808,"_27589":119809,"_2954":119810},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3471":71372,"_30355":71364,"_5":30684,"_21010":119812,"_27589":119813,"_2954":119814},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3471":71373,"_30355":71364,"_5":30684,"_21010":119816,"_27589":119817,"_2954":119818},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3471":71374,"_30355":71364,"_21010":119820,"_5":14420,"_27589":71364,"_2954":119821},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3471":71375,"_30355":71364,"_21010":119823,"_5":14420,"_27589":119793,"_2954":119824},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3471":71376,"_30355":71364,"_21010":119826,"_5":14420,"_27589":119793,"_2954":117859},[],{"_3471":71377,"_30355":71364,"_21010":119828,"_5":14420,"_27589":119793,"_2954":119829},[],"Método",{"_3471":71378,"_30355":71364,"_21010":119831,"_5":14420,"_27589":119793,"_2954":119832},[],"Autenticación y condición",{"_3471":71379,"_30355":71364,"_21010":119834,"_5":14420,"_27589":119793,"_2954":52672},[],{"_3471":71380,"_30355":71364,"_21010":119836,"_5":14420,"_27589":119793,"_2954":52675},[],{"_3471":71381,"_30355":71364,"_21010":119838,"_5":14420,"_27589":119793,"_2954":119839},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3471":71382,"_30355":71364,"_21010":119841,"_5":14420,"_27589":119793,"_2954":52681},[],{"_3471":71383,"_30355":71364,"_21010":119843,"_5":14420,"_27589":119793,"_2954":52684},[],{"_3471":71384,"_30355":71364,"_21010":119845,"_5":14420,"_27589":119793,"_2954":119846},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3471":71385,"_30355":71364,"_21010":119848,"_5":14420,"_27589":119793,"_2954":52690},[],{"_3471":71386,"_30355":71364,"_21010":119850,"_5":14420,"_27589":119793,"_2954":52684},[],{"_3471":71387,"_30355":71364,"_21010":119852,"_5":14420,"_27589":119793,"_2954":119853},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3471":71388,"_30355":71364,"_21010":119855,"_5":14420,"_27589":119793,"_2954":52698},[],{"_3471":71389,"_30355":71364,"_21010":119857,"_5":14420,"_27589":119793,"_2954":52684},[],{"_3471":71390,"_30355":71364,"_21010":119859,"_5":14420,"_27589":119793,"_2954":119860},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3471":71391,"_30355":71364,"_21010":119862,"_5":14420,"_27589":119793,"_2954":119863},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3471":71392,"_30355":71364,"_21010":119865,"_5":14420,"_27589":119797,"_2954":119866},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3471":71393,"_30355":71364,"_21010":119868,"_5":14420,"_27589":119797,"_2954":119869},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3471":71394,"_30355":71364,"_21010":119871,"_5":14420,"_27589":119800,"_2954":119872},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3471":71395,"_30355":71364,"_21010":119874,"_5":14420,"_27589":119800,"_2954":119875},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3471":71396,"_30355":71364,"_21010":119877,"_5":14420,"_27589":119803,"_2954":119878},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3471":71397,"_30355":71364,"_21010":119880,"_5":14420,"_27589":119803,"_2954":119881},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3471":71398,"_30355":71364,"_21010":119883,"_5":14420,"_27589":119806,"_2954":119884},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3471":71399,"_30355":71364,"_21010":119886,"_5":14420,"_27589":119806,"_2954":119887},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3471":71400,"_30355":71364,"_21010":119889,"_5":14420,"_27589":119809,"_2954":119890},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3471":71401,"_30355":71364,"_21010":119892,"_5":14420,"_27589":119809,"_2954":119893},[],"Parte",{"_3471":71402,"_30355":71364,"_21010":119895,"_5":14420,"_27589":119809,"_2954":119896},[],"Contenido tras decodificar su Base64",{"_3471":71403,"_30355":71364,"_21010":119898,"_5":14420,"_27589":119809,"_2954":52742},[],{"_3471":71404,"_30355":71364,"_21010":119900,"_5":14420,"_27589":119809,"_2954":119901},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3471":71405,"_30355":71364,"_21010":119903,"_5":14420,"_27589":119809,"_2954":52748},[],{"_3471":71406,"_30355":71364,"_21010":119905,"_5":14420,"_27589":119809,"_2954":119906},[],"PKCS#7 DER con el certificado emitido.",{"_3471":71407,"_30355":71364,"_21010":119908,"_5":14420,"_27589":119809,"_2954":119909},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3471":71408,"_30355":71364,"_21010":119911,"_5":14420,"_27589":119813,"_2954":119912},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3471":71409,"_30355":71364,"_21010":119914,"_5":14420,"_27589":119813,"_2954":119915},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3471":71410,"_30355":71364,"_21010":119917,"_5":14420,"_27589":119813,"_2954":119918},[],"Convierte y comprueba el resultado:",{"_3471":71411,"_30355":71364,"_21010":119920,"_5":14420,"_27589":119813,"_2954":119921},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3471":71412,"_30355":71364,"_21010":119923,"_5":14420,"_27589":119817,"_2954":119924},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3471":71413,"_30355":71364,"_21010":119926,"_5":14420,"_27589":119817,"_2954":119927},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3471":71414,"_30355":71414,"_5":14772,"_2954":119286,"_30687":119929,"_21010":119930,"_27589":71414},[49421,118099,51910,119111,119286],[],{"_3471":71415,"_30355":71414,"_21010":119932,"_5":14420,"_27589":71414,"_2954":119933},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3471":71416,"_30355":71414,"_5":30684,"_21010":119935,"_27589":119936,"_2954":119937},[],"/docs/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3471":71417,"_30355":71414,"_5":30684,"_21010":119939,"_27589":119940,"_2954":119941},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3471":71418,"_30355":71414,"_5":30684,"_21010":119943,"_27589":119944,"_2954":119945},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3471":71419,"_30355":71414,"_5":30684,"_21010":119947,"_27589":119948,"_2954":119949},[],"/docs/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3471":71420,"_30355":71414,"_21010":119951,"_5":14420,"_27589":71414,"_2954":119952},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3471":71421,"_30355":71414,"_21010":119954,"_5":14420,"_27589":119936,"_2954":119955},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3471":71422,"_30355":71414,"_21010":119957,"_5":14420,"_27589":119936,"_2954":119958},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3471":71423,"_30355":71414,"_21010":119960,"_5":14420,"_27589":119936,"_2954":119961},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3471":71424,"_30355":71414,"_21010":119963,"_5":14420,"_27589":119936,"_2954":119964},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3471":71425,"_30355":71414,"_21010":119966,"_5":14420,"_27589":119936,"_2954":119967},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3471":71426,"_30355":71414,"_21010":119969,"_5":14420,"_27589":119936,"_2954":119970},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3471":71427,"_30355":71414,"_21010":119972,"_5":14420,"_27589":119940,"_2954":119973},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3471":71428,"_30355":71414,"_21010":119975,"_5":14420,"_27589":119940,"_2954":119976},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3471":71429,"_30355":71414,"_21010":119978,"_5":14420,"_27589":119940,"_2954":119979},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3471":71430,"_30355":71414,"_21010":119981,"_5":14420,"_27589":119940,"_2954":119982},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3471":71431,"_30355":71414,"_21010":119984,"_5":14420,"_27589":119944,"_2954":119985},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3471":71432,"_30355":71414,"_21010":119987,"_5":14420,"_27589":119944,"_2954":119988},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3471":71433,"_30355":71414,"_21010":119990,"_5":14420,"_27589":119944,"_2954":119991},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3471":71434,"_30355":71414,"_21010":119993,"_5":14420,"_27589":119944,"_2954":119994},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3471":71435,"_30355":71414,"_21010":119996,"_5":14420,"_27589":119948,"_2954":119997},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3471":71436,"_30355":71414,"_21010":119999,"_5":14420,"_27589":119948,"_2954":120000},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3471":71437,"_30355":71437,"_5":14772,"_2954":120002,"_30687":120003,"_21010":120004,"_27589":71437},"Estrategias de aprovisionamiento",[49421,118099,51910,119111,119286],[],{"_3471":71438,"_30355":71437,"_21010":120006,"_5":14420,"_27589":71437,"_2954":120007},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3471":71439,"_30355":71437,"_5":30684,"_21010":120009,"_27589":120010,"_2954":120011},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3471":71440,"_30355":71437,"_5":30684,"_21010":120013,"_27589":120014,"_2954":120015},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3471":71441,"_30355":71437,"_5":30684,"_21010":120017,"_27589":120018,"_2954":120019},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3471":71442,"_30355":71437,"_5":30684,"_21010":120021,"_27589":120022,"_2954":120023},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3471":71443,"_30355":71437,"_5":30684,"_21010":120025,"_27589":120026,"_2954":120027},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3471":71444,"_30355":71437,"_21010":120029,"_5":14420,"_27589":71437,"_2954":120030},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3471":71445,"_30355":71437,"_21010":120032,"_5":14420,"_27589":120010,"_2954":120033},[],"Recorrido",{"_3471":71446,"_30355":71437,"_21010":120035,"_5":14420,"_27589":120010,"_2954":120036},[],"Cuándo existe el dispositivo",{"_3471":71447,"_30355":71437,"_21010":120038,"_5":14420,"_27589":120010,"_2954":120039},[],"Qué compruebas",{"_3471":71448,"_30355":71437,"_21010":120041,"_5":14420,"_27589":120010,"_2954":120042},[],"Asignación manual",{"_3471":71449,"_30355":71437,"_21010":120044,"_5":14420,"_27589":120010,"_2954":120045},[],"El operador lo crea antes de asociar un certificado.",{"_3471":71450,"_30355":71437,"_21010":120047,"_5":14420,"_27589":120010,"_2954":120048},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3471":71451,"_30355":71437,"_21010":120050,"_5":14420,"_27589":120010,"_2954":120051},[],"EST con `JITP`",{"_3471":71452,"_30355":71437,"_21010":120053,"_5":14420,"_27589":120010,"_2954":120054},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3471":71453,"_30355":71437,"_21010":120056,"_5":14420,"_27589":120010,"_2954":120057},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3471":71454,"_30355":71437,"_21010":120059,"_5":14420,"_27589":120010,"_2954":120060},[],"EST con `PRE_REGISTRATION`",{"_3471":71455,"_30355":71437,"_21010":120062,"_5":14420,"_27589":120010,"_2954":120063},[],"Debe existir antes de `/simpleenroll`.",{"_3471":71456,"_30355":71437,"_21010":120065,"_5":14420,"_27589":120010,"_2954":120066},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3471":71457,"_30355":71437,"_21010":120068,"_5":14420,"_27589":120010,"_2954":120069},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3471":71458,"_30355":71437,"_21010":120071,"_5":14420,"_27589":120010,"_2954":120072},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3471":71459,"_30355":71437,"_21010":120074,"_5":14420,"_27589":120014,"_2954":120075},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3471":71460,"_30355":71437,"_21010":120077,"_5":14420,"_27589":120014,"_2954":120078},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3471":71461,"_30355":71437,"_21010":120080,"_5":14420,"_27589":120014,"_2954":120081},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3471":71462,"_30355":71437,"_21010":120083,"_5":14420,"_27589":120018,"_2954":120084},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3471":71463,"_30355":71437,"_21010":120086,"_5":14420,"_27589":120018,"_2954":120087},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3471":71464,"_30355":71437,"_21010":120089,"_5":14420,"_27589":120018,"_2954":120090},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3471":71465,"_30355":71437,"_21010":120092,"_5":14420,"_27589":120018,"_2954":120093},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3471":71466,"_30355":71437,"_21010":120095,"_5":14420,"_27589":120018,"_2954":120096},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3471":71467,"_30355":71437,"_21010":120098,"_5":14420,"_27589":120018,"_2954":120099},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3471":71468,"_30355":71437,"_21010":120101,"_5":14420,"_27589":120022,"_2954":117034},[],{"_3471":71469,"_30355":71437,"_21010":120103,"_5":14420,"_27589":120022,"_2954":120104},[],"Material que atraviesa EST",{"_3471":71470,"_30355":71437,"_21010":120106,"_5":14420,"_27589":120022,"_2954":120107},[],"Clave generada por el dispositivo",{"_3471":71471,"_30355":71437,"_21010":120109,"_5":14420,"_27589":120022,"_2954":120110},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3471":71472,"_30355":71437,"_21010":120112,"_5":14420,"_27589":120022,"_2954":120113},[],"Clave ya disponible en el dispositivo",{"_3471":71473,"_30355":71437,"_21010":120115,"_5":14420,"_27589":120022,"_2954":120116},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3471":71474,"_30355":71437,"_21010":120118,"_5":14420,"_27589":120022,"_2954":52229},[],{"_3471":71475,"_30355":71437,"_21010":120120,"_5":14420,"_27589":120022,"_2954":120121},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3471":71476,"_30355":71437,"_21010":120123,"_5":14420,"_27589":120022,"_2954":120124},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3471":71477,"_30355":71437,"_21010":120126,"_5":14420,"_27589":120026,"_2954":120127},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3471":71478,"_30355":71478,"_5":14772,"_2954":120129,"_30687":120130,"_21010":120131,"_27589":71478},"Renovación y recuperación",[49421,118099,51910,119111,119286],[],{"_3471":71479,"_30355":71478,"_21010":120133,"_5":14420,"_27589":71478,"_2954":120134},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3471":71480,"_30355":71478,"_5":30684,"_21010":120136,"_27589":120137,"_2954":120138},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3471":71481,"_30355":71478,"_5":30684,"_21010":120140,"_27589":120141,"_2954":120142},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3471":71482,"_30355":71478,"_5":30684,"_21010":120144,"_27589":120145,"_2954":120146},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3471":71483,"_30355":71478,"_5":30684,"_21010":120148,"_27589":120149,"_2954":120150},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3471":71484,"_30355":71478,"_5":30684,"_21010":120152,"_27589":120153,"_2954":120154},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3471":71485,"_30355":71478,"_21010":120156,"_5":14420,"_27589":71478,"_2954":120157},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3471":71486,"_30355":71478,"_21010":120159,"_5":14420,"_27589":120137,"_2954":120160},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3471":71487,"_30355":71478,"_21010":120162,"_5":14420,"_27589":120137,"_2954":120163},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3471":71488,"_30355":71478,"_21010":120165,"_5":14420,"_27589":120137,"_2954":120166},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3471":71489,"_30355":71478,"_21010":120168,"_5":14420,"_27589":120137,"_2954":120169},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3471":71490,"_30355":71478,"_21010":120171,"_5":14420,"_27589":120141,"_2954":120172},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3471":71491,"_30355":71478,"_21010":120174,"_5":14420,"_27589":120141,"_2954":120175},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3471":71492,"_30355":71478,"_21010":120177,"_5":14420,"_27589":120145,"_2954":120178},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3471":71493,"_30355":71478,"_21010":120180,"_5":14420,"_27589":120145,"_2954":120181},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3471":71494,"_30355":71478,"_21010":120183,"_5":14420,"_27589":120145,"_2954":120184},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3471":71495,"_30355":71478,"_21010":120186,"_5":14420,"_27589":120149,"_2954":120187},[],"Situación",{"_3471":71496,"_30355":71478,"_21010":120189,"_5":14420,"_27589":120149,"_2954":120190},[],"Procedimiento",{"_3471":71497,"_30355":71478,"_21010":120192,"_5":14420,"_27589":120149,"_2954":120193},[],"Certificado vigente, fuera de ventana",{"_3471":71498,"_30355":71478,"_21010":120195,"_5":14420,"_27589":120149,"_2954":120196},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3471":71499,"_30355":71478,"_21010":120198,"_5":14420,"_27589":120149,"_2954":120199},[],"Certificado vencido, clave disponible",{"_3471":71500,"_30355":71478,"_21010":120201,"_5":14420,"_27589":120149,"_2954":120202},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3471":71501,"_30355":71478,"_21010":120204,"_5":14420,"_27589":120149,"_2954":120205},[],"Renovación por webhook o `NO_AUTH`",{"_3471":71502,"_30355":71478,"_21010":120207,"_5":14420,"_27589":120149,"_2954":120208},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3471":71503,"_30355":71478,"_21010":120210,"_5":14420,"_27589":120149,"_2954":120211},[],"Clave perdida o inaccesible",{"_3471":71504,"_30355":71478,"_21010":120213,"_5":14420,"_27589":120149,"_2954":120214},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3471":71505,"_30355":71478,"_21010":120216,"_5":14420,"_27589":120149,"_2954":120217},[],"Identidad actual revocada",{"_3471":71506,"_30355":71478,"_21010":120219,"_5":14420,"_27589":120149,"_2954":120220},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3471":71507,"_30355":71478,"_21010":120222,"_5":14420,"_27589":120149,"_2954":120223},[],"Dispositivo sin identidad",{"_3471":71508,"_30355":71478,"_21010":120225,"_5":14420,"_27589":120149,"_2954":120226},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3471":71509,"_30355":71478,"_21010":120228,"_5":14420,"_27589":120149,"_2954":120229},[],"Dispositivo retirado",{"_3471":71510,"_30355":71478,"_21010":120231,"_5":14420,"_27589":120149,"_2954":120232},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3471":71511,"_30355":71478,"_21010":120234,"_5":14420,"_27589":120149,"_2954":120235},[],"Timeout, HTTP 500 o fallo de instalación",{"_3471":71512,"_30355":71478,"_21010":120237,"_5":14420,"_27589":120149,"_2954":120238},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3471":71513,"_30355":71478,"_21010":120240,"_5":14420,"_27589":120153,"_2954":120241},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3471":71514,"_30355":71478,"_21010":120243,"_5":14420,"_27589":120153,"_2954":120244},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3471":71515,"_30355":71515,"_5":14772,"_2954":120246,"_30687":120247,"_21010":120248,"_27589":71515},"Diagnóstico de enrolamiento",[49421,118099,51910,119111,119286],[],{"_3471":71516,"_30355":71515,"_21010":120250,"_5":14420,"_27589":71515,"_2954":120251},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3471":71517,"_30355":71515,"_5":30684,"_21010":120253,"_27589":120254,"_2954":120255},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3471":71518,"_30355":71515,"_5":30684,"_21010":120257,"_27589":120258,"_2954":120259},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3471":71519,"_30355":71515,"_5":30684,"_21010":120261,"_27589":120262,"_2954":119818},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3471":71520,"_30355":71515,"_5":30684,"_21010":120264,"_27589":120265,"_2954":120266},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3471":71521,"_30355":71515,"_21010":120268,"_5":14420,"_27589":71515,"_2954":120269},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3471":71522,"_30355":71515,"_21010":120271,"_5":14420,"_27589":120258,"_2954":120272},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3471":71523,"_30355":71515,"_21010":120274,"_5":14420,"_27589":120258,"_2954":120275},[],"Síntoma o mensaje",{"_3471":71524,"_30355":71515,"_21010":120277,"_5":14420,"_27589":120258,"_2954":120278},[],"Qué revisar",{"_3471":71525,"_30355":71515,"_21010":120280,"_5":14420,"_27589":120258,"_2954":120281},[],"curl rechaza TLS, nombre o emisor",{"_3471":71526,"_30355":71515,"_21010":120283,"_5":14420,"_27589":120258,"_2954":120284},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3471":71527,"_30355":71515,"_21010":120286,"_5":14420,"_27589":120258,"_2954":120287},[],"404 o APS ausente",{"_3471":71528,"_30355":71515,"_21010":120289,"_5":14420,"_27589":120258,"_2954":120290},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3471":71529,"_30355":71515,"_21010":120292,"_5":14420,"_27589":120258,"_2954":120293},[],"400, error de CSR o formato",{"_3471":71530,"_30355":71515,"_21010":120295,"_5":14420,"_27589":120258,"_2954":120296},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3471":71531,"_30355":71515,"_21010":120298,"_5":14420,"_27589":120258,"_2954":120299},[],"Credencial ausente o certificado no válido",{"_3471":71532,"_30355":71515,"_21010":120301,"_5":14420,"_27589":120258,"_2954":120302},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3471":71533,"_30355":71515,"_21010":120304,"_5":14420,"_27589":120258,"_2954":120305},[],"Webhook deniega, expira o responde sin autorización",{"_3471":71534,"_30355":71515,"_21010":120307,"_5":14420,"_27589":120258,"_2954":120308},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3471":71535,"_30355":71515,"_21010":120310,"_5":14420,"_27589":120258,"_2954":53155},[],{"_3471":71536,"_30355":71515,"_21010":120312,"_5":14420,"_27589":120258,"_2954":120313},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3471":71537,"_30355":71515,"_21010":120315,"_5":14420,"_27589":120258,"_2954":53161},[],{"_3471":71538,"_30355":71515,"_21010":120317,"_5":14420,"_27589":120258,"_2954":120318},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3471":71539,"_30355":71515,"_21010":120320,"_5":14420,"_27589":120258,"_2954":53167},[],{"_3471":71540,"_30355":71515,"_21010":120322,"_5":14420,"_27589":120258,"_2954":120323},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3471":71541,"_30355":71515,"_21010":120325,"_5":14420,"_27589":120258,"_2954":53173},[],{"_3471":71542,"_30355":71515,"_21010":120327,"_5":14420,"_27589":120258,"_2954":120328},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3471":71543,"_30355":71515,"_21010":120330,"_5":14420,"_27589":120258,"_2954":53179},[],{"_3471":71544,"_30355":71515,"_21010":120332,"_5":14420,"_27589":120258,"_2954":120333},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3471":71545,"_30355":71515,"_21010":120335,"_5":14420,"_27589":120258,"_2954":120336},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3471":71546,"_30355":71515,"_21010":120338,"_5":14420,"_27589":120258,"_2954":120339},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3471":71547,"_30355":71515,"_21010":120341,"_5":14420,"_27589":120258,"_2954":120342},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3471":71548,"_30355":71515,"_21010":120344,"_5":14420,"_27589":120258,"_2954":120345},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3471":71549,"_30355":71515,"_21010":120347,"_5":14420,"_27589":120258,"_2954":53197},[],{"_3471":71550,"_30355":71515,"_21010":120349,"_5":14420,"_27589":120258,"_2954":120350},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3471":71551,"_30355":71515,"_21010":120352,"_5":14420,"_27589":120258,"_2954":53203},[],{"_3471":71552,"_30355":71515,"_21010":120354,"_5":14420,"_27589":120258,"_2954":120355},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3471":71553,"_30355":71515,"_21010":120357,"_5":14420,"_27589":120258,"_2954":120358},[],"DMS propietario distinto",{"_3471":71554,"_30355":71515,"_21010":120360,"_5":14420,"_27589":120258,"_2954":120361},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3471":71555,"_30355":71515,"_21010":120363,"_5":14420,"_27589":120258,"_2954":53215},[],{"_3471":71556,"_30355":71515,"_21010":120365,"_5":14420,"_27589":120258,"_2954":120366},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3471":71557,"_30355":71515,"_21010":120368,"_5":14420,"_27589":120258,"_2954":53221},[],{"_3471":71558,"_30355":71515,"_21010":120370,"_5":14420,"_27589":120258,"_2954":120371},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3471":71559,"_30355":71515,"_21010":120373,"_5":14420,"_27589":120258,"_2954":120374},[],"Certificado actual revocado",{"_3471":71560,"_30355":71515,"_21010":120376,"_5":14420,"_27589":120258,"_2954":120377},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3471":71561,"_30355":71515,"_21010":120379,"_5":14420,"_27589":120258,"_2954":120380},[],"Error de CA, perfil o firma",{"_3471":71562,"_30355":71515,"_21010":120382,"_5":14420,"_27589":120258,"_2954":120383},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3471":71563,"_30355":71515,"_21010":120385,"_5":14420,"_27589":120258,"_2954":120386},[],"HTTP 200 sin conexión del dispositivo",{"_3471":71564,"_30355":71515,"_21010":120388,"_5":14420,"_27589":120258,"_2954":120389},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3471":71565,"_30355":71515,"_21010":120391,"_5":14420,"_27589":120258,"_2954":120392},[],"Timeout o error después de emitir",{"_3471":71566,"_30355":71515,"_21010":120394,"_5":14420,"_27589":120258,"_2954":120395},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3471":71567,"_30355":71515,"_21010":120397,"_5":14420,"_27589":120262,"_2954":120398},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3471":71568,"_30355":71515,"_21010":120400,"_5":14420,"_27589":120262,"_2954":120401},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3471":71569,"_30355":71515,"_21010":120403,"_5":14420,"_27589":120265,"_2954":120404},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3471":71570,"_30355":71515,"_21010":120406,"_5":14420,"_27589":120265,"_2954":120407},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3471":71571,"_30355":71515,"_21010":120409,"_5":14420,"_27589":120265,"_2954":120410},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3471":71572,"_30355":71515,"_21010":120412,"_5":14420,"_27589":120265,"_2954":120413},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3471":71573,"_30355":71515,"_21010":120415,"_5":14420,"_27589":120265,"_2954":120416},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3471":71574,"_30355":71515,"_21010":120418,"_5":14420,"_27589":120265,"_2954":120419},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3471":71575,"_30355":71515,"_21010":120421,"_5":14420,"_27589":120265,"_2954":120422},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3471":71576,"_30355":71576,"_5":14772,"_2954":120424,"_30687":120425,"_21010":120426,"_27589":71576},"Distribución y actualización de confianza",[49421,118099,51910,119111,119286],[],{"_3471":71577,"_30355":71576,"_21010":120428,"_5":14420,"_27589":71576,"_2954":120429},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3471":71578,"_30355":71576,"_5":30684,"_21010":120431,"_27589":120432,"_2954":120433},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3471":71579,"_30355":71576,"_5":30684,"_21010":120435,"_27589":120436,"_2954":120437},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3471":71580,"_30355":71576,"_5":30684,"_21010":120439,"_27589":120440,"_2954":120441},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3471":71581,"_30355":71576,"_5":30684,"_21010":120443,"_27589":120444,"_2954":120445},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3471":71582,"_30355":71576,"_5":30684,"_21010":120447,"_27589":120448,"_2954":120449},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3471":71583,"_30355":71576,"_21010":120451,"_5":14420,"_27589":71576,"_2954":120452},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3471":71584,"_30355":71576,"_21010":120454,"_5":14420,"_27589":120432,"_2954":120455},[],"Relación",{"_3471":71585,"_30355":71576,"_21010":120457,"_5":14420,"_27589":120432,"_2954":120458},[],"Material que prepara el responsable",{"_3471":71586,"_30355":71576,"_21010":120460,"_5":14420,"_27589":120432,"_2954":120461},[],"Dispositivo → servidor EST",{"_3471":71587,"_30355":71576,"_21010":120463,"_5":14420,"_27589":120432,"_2954":120464},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3471":71588,"_30355":71576,"_21010":120466,"_5":14420,"_27589":120432,"_2954":120467},[],"DMS → solicitante",{"_3471":71589,"_30355":71576,"_21010":120469,"_5":14420,"_27589":120432,"_2954":120470},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3471":71590,"_30355":71576,"_21010":120472,"_5":14420,"_27589":120432,"_2954":120473},[],"Consumidor → dispositivo",{"_3471":71591,"_30355":71576,"_21010":120475,"_5":14420,"_27589":120432,"_2954":120476},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3471":71592,"_30355":71576,"_21010":120478,"_5":14420,"_27589":120432,"_2954":120479},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3471":71593,"_30355":71576,"_21010":120481,"_5":14420,"_27589":120436,"_2954":120482},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3471":71594,"_30355":71576,"_21010":120484,"_5":14420,"_27589":120436,"_2954":120485},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3471":71595,"_30355":71576,"_21010":120487,"_5":14420,"_27589":120440,"_2954":120488},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3471":71596,"_30355":71576,"_21010":120490,"_5":14420,"_27589":120440,"_2954":120491},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3471":71597,"_30355":71576,"_21010":120493,"_5":14420,"_27589":120440,"_2954":120494},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3471":71598,"_30355":71576,"_21010":120496,"_5":14420,"_27589":120440,"_2954":120497},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3471":71599,"_30355":71576,"_21010":120499,"_5":14420,"_27589":120440,"_2954":120500},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3471":71600,"_30355":71576,"_21010":120502,"_5":14420,"_27589":120440,"_2954":120503},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3471":71601,"_30355":71576,"_21010":120505,"_5":14420,"_27589":120444,"_2954":120506},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3471":71602,"_30355":71576,"_21010":120508,"_5":14420,"_27589":120444,"_2954":120509},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3471":71603,"_30355":71576,"_21010":120511,"_5":14420,"_27589":120444,"_2954":120512},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3471":71604,"_30355":71576,"_21010":120514,"_5":14420,"_27589":120448,"_2954":120515},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3471":71605,"_30355":71605,"_5":14772,"_2954":53370,"_30687":120517,"_21010":120519,"_27589":71605},[49421,118099,51910,119111,120518],"Integraciones",[],{"_3471":71606,"_30355":71605,"_21010":120521,"_5":14420,"_27589":71605,"_2954":120522},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3471":71607,"_30355":71605,"_5":30684,"_21010":120524,"_27589":120525,"_2954":120526},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3471":71608,"_30355":71605,"_5":30684,"_21010":120528,"_27589":120529,"_2954":120530},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3471":71609,"_30355":71605,"_5":30684,"_21010":120532,"_27589":120533,"_2954":120534},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3471":71610,"_30355":71605,"_5":30684,"_21010":120536,"_27589":120537,"_2954":120538},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3471":71611,"_30355":71605,"_5":30684,"_21010":120540,"_27589":120541,"_2954":120542},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3471":71612,"_30355":71605,"_5":30684,"_21010":120544,"_27589":120545,"_2954":120546},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3471":71613,"_30355":71605,"_5":30684,"_21010":120548,"_27589":120549,"_2954":120550},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3471":71614,"_30355":71605,"_5":30684,"_21010":120552,"_27589":120553,"_2954":120554},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3471":71615,"_30355":71605,"_5":30684,"_21010":120556,"_27589":120557,"_2954":53412},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3471":71616,"_30355":71605,"_5":30684,"_21010":120559,"_27589":120560,"_2954":53416},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3471":71617,"_30355":71605,"_5":30684,"_21010":120562,"_27589":120563,"_2954":120564},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3471":71618,"_30355":71605,"_5":30684,"_21010":120566,"_27589":120567,"_2954":120568},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3471":71619,"_30355":71605,"_5":30684,"_21010":120570,"_27589":120571,"_2954":120572},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3471":71620,"_30355":71605,"_5":30684,"_21010":120574,"_27589":120575,"_2954":120576},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3471":71621,"_30355":71605,"_5":30684,"_21010":120578,"_27589":120579,"_2954":120580},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3471":71622,"_30355":71605,"_5":30684,"_21010":120582,"_27589":120583,"_2954":120584},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3471":71623,"_30355":71605,"_5":30684,"_21010":120586,"_27589":120587,"_2954":120588},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3471":71624,"_30355":71605,"_5":30684,"_21010":120590,"_27589":120591,"_2954":120592},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3471":71625,"_30355":71605,"_5":30684,"_21010":120594,"_27589":120595,"_2954":120596},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3471":71626,"_30355":71605,"_5":30684,"_21010":120598,"_27589":120599,"_2954":120600},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3471":71627,"_30355":71605,"_5":30684,"_21010":120602,"_27589":120603,"_2954":120604},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3471":71628,"_30355":71605,"_5":30684,"_21010":120606,"_27589":120607,"_2954":120608},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3471":71629,"_30355":71605,"_5":30684,"_21010":120610,"_27589":120611,"_2954":120612},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3471":71630,"_30355":71605,"_5":30684,"_21010":120614,"_27589":120615,"_2954":120616},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3471":71631,"_30355":71605,"_5":30684,"_21010":120618,"_27589":120619,"_2954":120620},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3471":71632,"_30355":71605,"_21010":120622,"_5":14420,"_27589":71605,"_2954":120623},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3471":71633,"_30355":71605,"_21010":120625,"_5":14420,"_27589":71605,"_2954":120626},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3471":71634,"_30355":71605,"_21010":120628,"_5":14420,"_27589":71605,"_2954":120629},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3471":71635,"_30355":71605,"_21010":120631,"_5":14420,"_27589":120525,"_2954":120632},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3471":71636,"_30355":71605,"_21010":120634,"_5":14420,"_27589":120525,"_2954":120635},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3471":71637,"_30355":71605,"_21010":120637,"_5":14420,"_27589":120525,"_2954":120638},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3471":71638,"_30355":71605,"_21010":120640,"_5":14420,"_27589":120525,"_2954":120641},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3471":71639,"_30355":71605,"_21010":120643,"_5":14420,"_27589":120529,"_2954":120644},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3471":71640,"_30355":71605,"_21010":120646,"_5":14420,"_27589":120533,"_2954":120647},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3471":71641,"_30355":71605,"_21010":120649,"_5":14420,"_27589":120533,"_2954":120650},[],"Acción IAM",{"_3471":71642,"_30355":71605,"_21010":120652,"_5":14420,"_27589":120533,"_2954":117040},[],{"_3471":71643,"_30355":71605,"_21010":120654,"_5":14420,"_27589":120533,"_2954":53511},[],{"_3471":71644,"_30355":71605,"_21010":120656,"_5":14420,"_27589":120533,"_2954":120657},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3471":71645,"_30355":71605,"_21010":120659,"_5":14420,"_27589":120533,"_2954":53517},[],{"_3471":71646,"_30355":71605,"_21010":120661,"_5":14420,"_27589":120533,"_2954":120662},[],"Registrar la CA en AWS IoT",{"_3471":71647,"_30355":71605,"_21010":120664,"_5":14420,"_27589":120533,"_2954":53523},[],{"_3471":71648,"_30355":71605,"_21010":120666,"_5":14420,"_27589":120533,"_2954":120667},[],"Consultar el estado del registro de la CA",{"_3471":71649,"_30355":71605,"_21010":120669,"_5":14420,"_27589":120533,"_2954":53529},[],{"_3471":71650,"_30355":71605,"_21010":120671,"_5":14420,"_27589":120533,"_2954":120672},[],"Crear o actualizar Things en IoT Core",{"_3471":71651,"_30355":71605,"_21010":120674,"_5":14420,"_27589":120533,"_2954":53535},[],{"_3471":71652,"_30355":71605,"_21010":120676,"_5":14420,"_27589":120533,"_2954":120677},[],"Aprovisionar Things mediante plantilla",{"_3471":71653,"_30355":71605,"_21010":120679,"_5":14420,"_27589":120533,"_2954":53541},[],{"_3471":71654,"_30355":71605,"_21010":120681,"_5":14420,"_27589":120533,"_2954":120682},[],"Registrar certificados de dispositivo",{"_3471":71655,"_30355":71605,"_21010":120684,"_5":14420,"_27589":120533,"_2954":53547},[],{"_3471":71656,"_30355":71605,"_21010":120686,"_5":14420,"_27589":120533,"_2954":120687},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3471":71657,"_30355":71605,"_21010":120689,"_5":14420,"_27589":120533,"_2954":53553},[],{"_3471":71658,"_30355":71605,"_21010":120691,"_5":14420,"_27589":120533,"_2954":120692},[],"Crear y adjuntar políticas IoT",{"_3471":71659,"_30355":71605,"_21010":120694,"_5":14420,"_27589":120533,"_2954":53559},[],{"_3471":71660,"_30355":71605,"_21010":120696,"_5":14420,"_27589":120533,"_2954":120697},[],"Gestionar grupos de Things",{"_3471":71661,"_30355":71605,"_21010":120699,"_5":14420,"_27589":120533,"_2954":53565},[],{"_3471":71662,"_30355":71605,"_21010":120701,"_5":14420,"_27589":120533,"_2954":120702},[],"Crear plantillas JITP",{"_3471":71663,"_30355":71605,"_21010":120704,"_5":14420,"_27589":120533,"_2954":53571},[],{"_3471":71664,"_30355":71605,"_21010":120706,"_5":14420,"_27589":120533,"_2954":120707},[],"Leer y escribir el Device Shadow",{"_3471":71665,"_30355":71605,"_21010":120709,"_5":14420,"_27589":120533,"_2954":120710},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3471":71666,"_30355":71605,"_21010":120712,"_5":14420,"_27589":120537,"_2954":120713},[],"Parámetro",{"_3471":71667,"_30355":71605,"_21010":120715,"_5":14420,"_27589":120537,"_2954":120716},[],"Tipo",{"_3471":71668,"_30355":71605,"_21010":120718,"_5":14420,"_27589":120537,"_2954":120719},[],"Requerido",{"_3471":71669,"_30355":71605,"_21010":120721,"_5":14420,"_27589":120537,"_2954":120722},[],"Descripción",{"_3471":71670,"_30355":71605,"_21010":120724,"_5":14420,"_27589":120537,"_2954":53592},[],{"_3471":71671,"_30355":71605,"_21010":120726,"_5":14420,"_27589":120537,"_2954":25132},[],{"_3471":71672,"_30355":71605,"_21010":120728,"_5":14420,"_27589":120537,"_2954":120729},[],"Sí",{"_3471":71673,"_30355":71605,"_21010":120731,"_5":14420,"_27589":120537,"_2954":120732},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3471":71674,"_30355":71605,"_21010":120734,"_5":14420,"_27589":120537,"_2954":53603},[],{"_3471":71675,"_30355":71605,"_21010":120736,"_5":14420,"_27589":120537,"_2954":25132},[],{"_3471":71676,"_30355":71605,"_21010":120738,"_5":14420,"_27589":120537,"_2954":120729},[],{"_3471":71677,"_30355":71605,"_21010":120740,"_5":14420,"_27589":120537,"_2954":120741},[],"Región AWS donde opera el conector.",{"_3471":71678,"_30355":71605,"_21010":120743,"_5":14420,"_27589":120537,"_2954":53613},[],{"_3471":71679,"_30355":71605,"_21010":120745,"_5":14420,"_27589":120537,"_2954":25132},[],{"_3471":71680,"_30355":71605,"_21010":120747,"_5":14420,"_27589":120537,"_2954":120729},[],{"_3471":71681,"_30355":71605,"_21010":120749,"_5":14420,"_27589":120537,"_2954":120750},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3471":71682,"_30355":71605,"_21010":120752,"_5":14420,"_27589":120537,"_2954":53623},[],{"_3471":71683,"_30355":71605,"_21010":120754,"_5":14420,"_27589":120537,"_2954":25132},[],{"_3471":71684,"_30355":71605,"_21010":120756,"_5":14420,"_27589":120537,"_2954":120757},[],"Solo con `auth_method=static`",{"_3471":71685,"_30355":71605,"_21010":120759,"_5":14420,"_27589":120537,"_2954":120760},[],"Clave de acceso AWS.",{"_3471":71686,"_30355":71605,"_21010":120762,"_5":14420,"_27589":120537,"_2954":53634},[],{"_3471":71687,"_30355":71605,"_21010":120764,"_5":14420,"_27589":120537,"_2954":25132},[],{"_3471":71688,"_30355":71605,"_21010":120766,"_5":14420,"_27589":120537,"_2954":120757},[],{"_3471":71689,"_30355":71605,"_21010":120768,"_5":14420,"_27589":120537,"_2954":120769},[],"Clave secreta AWS.",{"_3471":71690,"_30355":71605,"_21010":120771,"_5":14420,"_27589":120537,"_2954":53644},[],{"_3471":71691,"_30355":71605,"_21010":120773,"_5":14420,"_27589":120537,"_2954":25132},[],{"_3471":71692,"_30355":71605,"_21010":120775,"_5":14420,"_27589":120537,"_2954":53649},[],{"_3471":71693,"_30355":71605,"_21010":120777,"_5":14420,"_27589":120537,"_2954":120778},[],"Token de sesión (con `auth_method=static`).",{"_3471":71694,"_30355":71605,"_21010":120780,"_5":14420,"_27589":120537,"_2954":53655},[],{"_3471":71695,"_30355":71605,"_21010":120782,"_5":14420,"_27589":120537,"_2954":25132},[],{"_3471":71696,"_30355":71605,"_21010":120784,"_5":14420,"_27589":120537,"_2954":120785},[],"Solo con `auth_method=role`",{"_3471":71697,"_30355":71605,"_21010":120787,"_5":14420,"_27589":120537,"_2954":120788},[],"ARN del rol a asumir.",{"_3471":71698,"_30355":71605,"_21010":120790,"_5":14420,"_27589":120537,"_2954":53666},[],{"_3471":71699,"_30355":71605,"_21010":120792,"_5":14420,"_27589":120537,"_2954":25132},[],{"_3471":71700,"_30355":71605,"_21010":120794,"_5":14420,"_27589":120537,"_2954":53649},[],{"_3471":71701,"_30355":71605,"_21010":120796,"_5":14420,"_27589":120537,"_2954":120797},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3471":71702,"_30355":71605,"_21010":120799,"_5":14420,"_27589":120537,"_2954":53676},[],{"_3471":71703,"_30355":71605,"_21010":120801,"_5":14420,"_27589":120537,"_2954":90079},[],{"_3471":71704,"_30355":71605,"_21010":120803,"_5":14420,"_27589":120537,"_2954":120729},[],{"_3471":71705,"_30355":71605,"_21010":120805,"_5":14420,"_27589":120537,"_2954":120806},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3471":71706,"_30355":71605,"_21010":120808,"_5":14420,"_27589":120537,"_2954":53686},[],{"_3471":71707,"_30355":71605,"_21010":120810,"_5":14420,"_27589":120537,"_2954":25132},[],{"_3471":71708,"_30355":71605,"_21010":120812,"_5":14420,"_27589":120537,"_2954":120729},[],{"_3471":71709,"_30355":71605,"_21010":120814,"_5":14420,"_27589":120537,"_2954":120815},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3471":71710,"_30355":71605,"_21010":120817,"_5":14420,"_27589":120537,"_2954":53696},[],{"_3471":71711,"_30355":71605,"_21010":120819,"_5":14420,"_27589":120537,"_2954":25132},[],{"_3471":71712,"_30355":71605,"_21010":120821,"_5":14420,"_27589":120537,"_2954":120729},[],{"_3471":71713,"_30355":71605,"_21010":120823,"_5":14420,"_27589":120537,"_2954":120824},[],"URL HTTP del Device Manager de Lamassu.",{"_3471":71714,"_30355":71605,"_21010":120826,"_5":14420,"_27589":120537,"_2954":53706},[],{"_3471":71715,"_30355":71605,"_21010":120828,"_5":14420,"_27589":120537,"_2954":25132},[],{"_3471":71716,"_30355":71605,"_21010":120830,"_5":14420,"_27589":120537,"_2954":120729},[],{"_3471":71717,"_30355":71605,"_21010":120832,"_5":14420,"_27589":120537,"_2954":120833},[],"URL HTTP del servicio de CA de Lamassu.",{"_3471":71718,"_30355":71605,"_21010":120835,"_5":14420,"_27589":120541,"_2954":120836},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3471":71719,"_30355":71605,"_21010":120838,"_5":14420,"_27589":120541,"_2954":120839},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3471":71720,"_30355":71605,"_21010":120841,"_5":14420,"_27589":120541,"_2954":120842},[],"Tipo de CloudEvent",{"_3471":71721,"_30355":71605,"_21010":120844,"_5":14420,"_27589":120541,"_2954":120845},[],"Recurso en Lamassu",{"_3471":71722,"_30355":71605,"_21010":120847,"_5":14420,"_27589":120541,"_2954":120848},[],"Recurso AWS",{"_3471":71723,"_30355":71605,"_21010":120850,"_5":14420,"_27589":120541,"_2954":120851},[],"Acciones IAM",{"_3471":71724,"_30355":71605,"_21010":120853,"_5":14420,"_27589":120541,"_2954":120854},[],"Llamadas AWS y efecto",{"_3471":71725,"_30355":71605,"_21010":120856,"_5":14420,"_27589":120541,"_2954":120857},[],"Dónde en esta página",{"_3471":71726,"_30355":71605,"_21010":120859,"_5":14420,"_27589":120541,"_2954":53740},[],{"_3471":71727,"_30355":71605,"_21010":120861,"_5":14420,"_27589":120541,"_2954":53743},[],{"_3471":71728,"_30355":71605,"_21010":120863,"_5":14420,"_27589":120541,"_2954":53746},[],{"_3471":71729,"_30355":71605,"_21010":120865,"_5":14420,"_27589":120541,"_2954":53749},[],{"_3471":71730,"_30355":71605,"_21010":120867,"_5":14420,"_27589":120541,"_2954":120868},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3471":71731,"_30355":71605,"_21010":120870,"_5":14420,"_27589":120541,"_2954":120554},[],{"_3471":71732,"_30355":71605,"_21010":120872,"_5":14420,"_27589":120541,"_2954":53757},[],{"_3471":71733,"_30355":71605,"_21010":120874,"_5":14420,"_27589":120541,"_2954":53760},[],{"_3471":71734,"_30355":71605,"_21010":120876,"_5":14420,"_27589":120541,"_2954":53763},[],{"_3471":71735,"_30355":71605,"_21010":120878,"_5":14420,"_27589":120541,"_2954":53766},[],{"_3471":71736,"_30355":71605,"_21010":120880,"_5":14420,"_27589":120541,"_2954":120881},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3471":71737,"_30355":71605,"_21010":120883,"_5":14420,"_27589":120541,"_2954":120580},[],{"_3471":71738,"_30355":71605,"_21010":120885,"_5":14420,"_27589":120541,"_2954":53774},[],{"_3471":71739,"_30355":71605,"_21010":120887,"_5":14420,"_27589":120541,"_2954":120888},[],"Dispositivo",{"_3471":71740,"_30355":71605,"_21010":120890,"_5":14420,"_27589":120541,"_2954":53780},[],{"_3471":71741,"_30355":71605,"_21010":120892,"_5":14420,"_27589":120541,"_2954":53783},[],{"_3471":71742,"_30355":71605,"_21010":120894,"_5":14420,"_27589":120541,"_2954":120895},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3471":71743,"_30355":71605,"_21010":120897,"_5":14420,"_27589":120541,"_2954":120588},[],{"_3471":71744,"_30355":71605,"_21010":120899,"_5":14420,"_27589":120541,"_2954":53791},[],{"_3471":71745,"_30355":71605,"_21010":120901,"_5":14420,"_27589":120541,"_2954":120902},[],"Certificado",{"_3471":71746,"_30355":71605,"_21010":120904,"_5":14420,"_27589":120541,"_2954":53797},[],{"_3471":71747,"_30355":71605,"_21010":120906,"_5":14420,"_27589":120541,"_2954":120907},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3471":71748,"_30355":71605,"_21010":120909,"_5":14420,"_27589":120541,"_2954":120910},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3471":71749,"_30355":71605,"_21010":120912,"_5":14420,"_27589":120541,"_2954":120600},[],{"_3471":71750,"_30355":71605,"_21010":120914,"_5":14420,"_27589":120541,"_2954":53808},[],{"_3471":71751,"_30355":71605,"_21010":120916,"_5":14420,"_27589":120541,"_2954":120917},[],"Certificado / Dispositivo",{"_3471":71752,"_30355":71605,"_21010":120919,"_5":14420,"_27589":120541,"_2954":53814},[],{"_3471":71753,"_30355":71605,"_21010":120921,"_5":14420,"_27589":120541,"_2954":49817},[],{"_3471":71754,"_30355":71605,"_21010":120923,"_5":14420,"_27589":120541,"_2954":120924},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3471":71755,"_30355":71605,"_21010":120926,"_5":14420,"_27589":120541,"_2954":120608},[],{"_3471":71756,"_30355":71605,"_21010":120928,"_5":14420,"_27589":120545,"_2954":120929},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3471":71757,"_30355":71605,"_21010":120931,"_5":14420,"_27589":120549,"_2954":120932},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3471":71758,"_30355":71605,"_21010":120934,"_5":14420,"_27589":120549,"_2954":120935},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3471":71759,"_30355":71605,"_21010":120937,"_5":14420,"_27589":120553,"_2954":120938},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3471":71760,"_30355":71605,"_21010":120940,"_5":14420,"_27589":120553,"_2954":120941},[],"Transición",{"_3471":71761,"_30355":71605,"_21010":120943,"_5":14420,"_27589":120553,"_2954":120944},[],"Llamadas AWS",{"_3471":71762,"_30355":71605,"_21010":120946,"_5":14420,"_27589":120553,"_2954":120947},[],"`NoRegistrada` → `Solicitada`",{"_3471":71763,"_30355":71605,"_21010":120949,"_5":14420,"_27589":120553,"_2954":120950},[],"ninguna (solo escritura de metadatos)",{"_3471":71764,"_30355":71605,"_21010":120952,"_5":14420,"_27589":120553,"_2954":120953},[],"`Solicitada` → `Registrando`",{"_3471":71765,"_30355":71605,"_21010":120955,"_5":14420,"_27589":120553,"_2954":120956},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3471":71766,"_30355":71605,"_21010":120958,"_5":14420,"_27589":120553,"_2954":120959},[],"`Registrando` → `Completada`",{"_3471":71767,"_30355":71605,"_21010":120961,"_5":14420,"_27589":120553,"_2954":120962},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3471":71768,"_30355":71605,"_21010":120964,"_5":14420,"_27589":120553,"_2954":120965},[],"`Registrando` → `Fallida`",{"_3471":71769,"_30355":71605,"_21010":120967,"_5":14420,"_27589":120553,"_2954":120968},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3471":71770,"_30355":71605,"_21010":120970,"_5":14420,"_27589":120553,"_2954":120971},[],"`Fallida` / `Completada` → `Solicitada`",{"_3471":71771,"_30355":71605,"_21010":120973,"_5":14420,"_27589":120553,"_2954":120974},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3471":71772,"_30355":71605,"_21010":120976,"_5":14420,"_27589":120557,"_2954":120977},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3471":71773,"_30355":71605,"_21010":120979,"_5":14420,"_27589":120557,"_2954":120980},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3471":71774,"_30355":71605,"_21010":120982,"_5":14420,"_27589":120557,"_2954":120983},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3471":71775,"_30355":71605,"_21010":120985,"_5":14420,"_27589":120557,"_2954":120986},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3471":71776,"_30355":71605,"_21010":120988,"_5":14420,"_27589":120557,"_2954":120989},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3471":71777,"_30355":71605,"_21010":120991,"_5":14420,"_27589":120557,"_2954":120992},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3471":71778,"_30355":71605,"_21010":120994,"_5":14420,"_27589":120560,"_2954":120995},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3471":71779,"_30355":71605,"_21010":120997,"_5":14420,"_27589":120563,"_2954":120998},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3471":71780,"_30355":71605,"_21010":121000,"_5":14420,"_27589":120563,"_2954":121001},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3471":71781,"_30355":71605,"_21010":121003,"_5":14420,"_27589":120567,"_2954":121004},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3471":71782,"_30355":71605,"_21010":121006,"_5":14420,"_27589":120571,"_2954":121007},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3471":71783,"_30355":71605,"_21010":121009,"_5":14420,"_27589":120571,"_2954":121010},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3471":71784,"_30355":71605,"_21010":121012,"_5":14420,"_27589":120571,"_2954":121013},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3471":71785,"_30355":71605,"_21010":121015,"_5":14420,"_27589":120571,"_2954":121016},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3471":71786,"_30355":71605,"_21010":121018,"_5":14420,"_27589":120571,"_2954":121019},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3471":71787,"_30355":71605,"_21010":121021,"_5":14420,"_27589":120571,"_2954":121022},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3471":71788,"_30355":71605,"_21010":121024,"_5":14420,"_27589":120575,"_2954":121025},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3471":71789,"_30355":71605,"_21010":121027,"_5":14420,"_27589":120575,"_2954":121028},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3471":71790,"_30355":71605,"_21010":121030,"_5":14420,"_27589":120575,"_2954":121031},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3471":71791,"_30355":71605,"_21010":121033,"_5":14420,"_27589":120575,"_2954":121034},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3471":71792,"_30355":71605,"_21010":121036,"_5":14420,"_27589":120575,"_2954":121037},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3471":71793,"_30355":71605,"_21010":121039,"_5":14420,"_27589":120579,"_2954":121040},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3471":71794,"_30355":71605,"_21010":121042,"_5":14420,"_27589":120579,"_2954":120941},[],{"_3471":71795,"_30355":71605,"_21010":121044,"_5":14420,"_27589":120579,"_2954":120944},[],{"_3471":71796,"_30355":71605,"_21010":121046,"_5":14420,"_27589":120579,"_2954":121047},[],"`SinConfigurar` → `None` / `Auto`",{"_3471":71797,"_30355":71605,"_21010":121049,"_5":14420,"_27589":120579,"_2954":121050},[],"ninguna (solo configuración)",{"_3471":71798,"_30355":71605,"_21010":121052,"_5":14420,"_27589":120579,"_2954":53951},[],{"_3471":71799,"_30355":71605,"_21010":121054,"_5":14420,"_27589":120579,"_2954":121050},[],{"_3471":71800,"_30355":71605,"_21010":121056,"_5":14420,"_27589":120579,"_2954":121057},[],"Cualquiera → `Jitp`",{"_3471":71801,"_30355":71605,"_21010":121059,"_5":14420,"_27589":120579,"_2954":121060},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3471":71802,"_30355":71605,"_21010":121062,"_5":14420,"_27589":120579,"_2954":53962},[],{"_3471":71803,"_30355":71605,"_21010":121064,"_5":14420,"_27589":120579,"_2954":121065},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3471":71804,"_30355":71605,"_21010":121067,"_5":14420,"_27589":120583,"_2954":121068},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3471":71805,"_30355":71605,"_21010":121070,"_5":14420,"_27589":120583,"_2954":121071},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3471":71806,"_30355":71605,"_21010":121073,"_5":14420,"_27589":120583,"_2954":121074},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3471":71807,"_30355":71605,"_21010":121076,"_5":14420,"_27589":120587,"_2954":121077},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3471":71808,"_30355":71605,"_21010":121079,"_5":14420,"_27589":120587,"_2954":120941},[],{"_3471":71809,"_30355":71605,"_21010":121081,"_5":14420,"_27589":120587,"_2954":120944},[],{"_3471":71810,"_30355":71605,"_21010":121083,"_5":14420,"_27589":120587,"_2954":121084},[],"`Ausente` → `Aprovisionado`",{"_3471":71811,"_30355":71605,"_21010":121086,"_5":14420,"_27589":120587,"_2954":121087},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3471":71812,"_30355":71605,"_21010":121089,"_5":14420,"_27589":120587,"_2954":121090},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3471":71813,"_30355":71605,"_21010":121092,"_5":14420,"_27589":120587,"_2954":121093},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3471":71814,"_30355":71605,"_21010":121095,"_5":14420,"_27589":120587,"_2954":121096},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3471":71815,"_30355":71605,"_21010":121098,"_5":14420,"_27589":120591,"_2954":121099},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3471":71816,"_30355":71605,"_21010":121101,"_5":14420,"_27589":120591,"_2954":121102},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3471":71817,"_30355":71605,"_21010":121104,"_5":14420,"_27589":120591,"_2954":121105},[],"Para que el flujo JITP funcione correctamente:",{"_3471":71818,"_30355":71605,"_21010":121107,"_5":14420,"_27589":120591,"_2954":121108},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3471":71819,"_30355":71605,"_21010":121110,"_5":14420,"_27589":120591,"_2954":121111},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3471":71820,"_30355":71605,"_21010":121113,"_5":14420,"_27589":120591,"_2954":121114},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3471":71821,"_30355":71605,"_21010":121116,"_5":14420,"_27589":120591,"_2954":121117},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3471":71822,"_30355":71605,"_21010":121119,"_5":14420,"_27589":120595,"_2954":121120},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3471":71823,"_30355":71605,"_21010":121122,"_5":14420,"_27589":120595,"_2954":121123},[],"Estado en Lamassu",{"_3471":71824,"_30355":71605,"_21010":121125,"_5":14420,"_27589":120595,"_2954":121126},[],"Razón de revocación",{"_3471":71825,"_30355":71605,"_21010":121128,"_5":14420,"_27589":120595,"_2954":121129},[],"Estado en AWS IoT Core",{"_3471":71826,"_30355":71605,"_21010":121131,"_5":14420,"_27589":120595,"_2954":54032},[],{"_3471":71827,"_30355":71605,"_21010":121133,"_5":14420,"_27589":120595,"_2954":121134},[],"Ninguna",{"_3471":71828,"_30355":71605,"_21010":121136,"_5":14420,"_27589":120595,"_2954":54038},[],{"_3471":71829,"_30355":71605,"_21010":121138,"_5":14420,"_27589":120595,"_2954":54041},[],{"_3471":71830,"_30355":71605,"_21010":121140,"_5":14420,"_27589":120595,"_2954":54044},[],{"_3471":71831,"_30355":71605,"_21010":121142,"_5":14420,"_27589":120595,"_2954":54047},[],{"_3471":71832,"_30355":71605,"_21010":121144,"_5":14420,"_27589":120595,"_2954":54041},[],{"_3471":71833,"_30355":71605,"_21010":121146,"_5":14420,"_27589":120595,"_2954":121147},[],"Cualquier otra razón",{"_3471":71834,"_30355":71605,"_21010":121149,"_5":14420,"_27589":120595,"_2954":54055},[],{"_3471":71835,"_30355":71605,"_21010":121151,"_5":14420,"_27589":120595,"_2954":121152},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3471":71836,"_30355":71605,"_21010":121154,"_5":14420,"_27589":120599,"_2954":121155},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3471":71837,"_30355":71605,"_21010":121157,"_5":14420,"_27589":120599,"_2954":120941},[],{"_3471":71838,"_30355":71605,"_21010":121159,"_5":14420,"_27589":120599,"_2954":120944},[],{"_3471":71839,"_30355":71605,"_21010":121161,"_5":14420,"_27589":120599,"_2954":121162},[],"`NoSincronizado` → `Active`",{"_3471":71840,"_30355":71605,"_21010":121164,"_5":14420,"_27589":120599,"_2954":53547},[],{"_3471":71841,"_30355":71605,"_21010":121166,"_5":14420,"_27589":120599,"_2954":54073},[],{"_3471":71842,"_30355":71605,"_21010":121168,"_5":14420,"_27589":120599,"_2954":121169},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3471":71843,"_30355":71605,"_21010":121171,"_5":14420,"_27589":120599,"_2954":54079},[],{"_3471":71844,"_30355":71605,"_21010":121173,"_5":14420,"_27589":120599,"_2954":121169},[],{"_3471":71845,"_30355":71605,"_21010":121175,"_5":14420,"_27589":120599,"_2954":54084},[],{"_3471":71846,"_30355":71605,"_21010":121177,"_5":14420,"_27589":120599,"_2954":53547},[],{"_3471":71847,"_30355":71605,"_21010":121179,"_5":14420,"_27589":120599,"_2954":54089},[],{"_3471":71848,"_30355":71605,"_21010":121181,"_5":14420,"_27589":120599,"_2954":121182},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3471":71849,"_30355":71605,"_21010":121184,"_5":14420,"_27589":120603,"_2954":121185},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3471":71850,"_30355":71605,"_21010":121187,"_5":14420,"_27589":120603,"_2954":121188},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3471":71851,"_30355":71605,"_21010":121190,"_5":14420,"_27589":120603,"_2954":121191},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3471":71852,"_30355":71605,"_21010":121193,"_5":14420,"_27589":120607,"_2954":121194},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3471":71853,"_30355":71605,"_21010":121196,"_5":14420,"_27589":120607,"_2954":121197},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3471":71854,"_30355":71605,"_21010":121199,"_5":14420,"_27589":120611,"_2954":121200},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3471":71855,"_30355":71605,"_21010":121202,"_5":14420,"_27589":120611,"_2954":121203},[],"Existen dos tipos de acciones:",{"_3471":71856,"_30355":71605,"_21010":121205,"_5":14420,"_27589":120611,"_2954":121206},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3471":71857,"_30355":71605,"_21010":121208,"_5":14420,"_27589":120611,"_2954":121209},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3471":71858,"_30355":71605,"_21010":121211,"_5":14420,"_27589":120611,"_2954":121212},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3471":71859,"_30355":71605,"_21010":121214,"_5":14420,"_27589":120615,"_2954":121215},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3471":71860,"_30355":71605,"_21010":121217,"_5":14420,"_27589":120615,"_2954":121218},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3471":71861,"_30355":71605,"_21010":121220,"_5":14420,"_27589":120615,"_2954":121221},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3471":71862,"_30355":71605,"_21010":121223,"_5":14420,"_27589":120619,"_2954":121224},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3471":71863,"_30355":71605,"_21010":121226,"_5":14420,"_27589":120619,"_2954":121227},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3471":71864,"_30355":71605,"_21010":121229,"_5":14420,"_27589":120619,"_2954":121230},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3471":71865,"_30355":71605,"_21010":121232,"_5":14420,"_27589":120619,"_2954":121233},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3471":71866,"_30355":71605,"_21010":121235,"_5":14420,"_27589":120619,"_2954":121236},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3471":71867,"_30355":71605,"_21010":121238,"_5":14420,"_27589":120619,"_2954":121239},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3471":71868,"_30355":71605,"_21010":121241,"_5":14420,"_27589":120619,"_2954":121242},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3471":71869,"_30355":71605,"_21010":121244,"_5":14420,"_27589":120619,"_2954":121245},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3471":71870,"_30355":71605,"_21010":121247,"_5":14420,"_27589":120619,"_2954":121248},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3471":71871,"_30355":71605,"_21010":121250,"_5":14420,"_27589":120619,"_2954":121251},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3471":71872,"_30355":71605,"_21010":121253,"_5":14420,"_27589":120619,"_2954":121254},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3471":71873,"_30355":71605,"_21010":121256,"_5":14420,"_27589":120619,"_2954":121257},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3471":71874,"_30355":71605,"_21010":121259,"_5":14420,"_27589":120619,"_2954":121260},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3471":71875,"_30355":71605,"_21010":121262,"_5":14420,"_27589":120619,"_2954":121263},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3471":71876,"_30355":71605,"_21010":121265,"_5":14420,"_27589":120619,"_2954":121266},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3471":71877,"_30355":71605,"_21010":121268,"_5":14420,"_27589":120619,"_2954":121269},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3471":71878,"_30355":71605,"_21010":121271,"_5":14420,"_27589":120619,"_2954":121272},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3471":71879,"_30355":71605,"_21010":121274,"_5":14420,"_27589":120619,"_2954":121275},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3471":71880,"_30355":71605,"_21010":121277,"_5":14420,"_27589":120619,"_2954":121278},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3471":71881,"_30355":71605,"_21010":121280,"_5":14420,"_27589":120619,"_2954":121281},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3471":71882,"_30355":71605,"_21010":121283,"_5":14420,"_27589":120619,"_2954":121284},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3471":71883,"_30355":71605,"_21010":121286,"_5":14420,"_27589":120619,"_2954":121287},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3471":71884,"_30355":71605,"_21010":121289,"_5":14420,"_27589":120619,"_2954":121290},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3471":71885,"_30355":71605,"_21010":121292,"_5":14420,"_27589":120619,"_2954":121293},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3471":71886,"_30355":71886,"_5":14772,"_2954":51910,"_30687":121295,"_21010":121296,"_27589":71886},[49421,118099,51910],[],{"_3471":71887,"_30355":71886,"_21010":121298,"_5":14420,"_27589":71886,"_2954":121299},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3471":71888,"_30355":71886,"_5":30684,"_21010":121301,"_27589":121302,"_2954":121303},[],"/docs/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3471":71889,"_30355":71886,"_5":30684,"_21010":121305,"_27589":121306,"_2954":119111},[],"/docs/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3471":71890,"_30355":71886,"_5":30684,"_21010":121308,"_27589":121309,"_2954":119286},[],"/docs/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3471":71891,"_30355":71886,"_5":30684,"_21010":121311,"_27589":121312,"_2954":120518},[],"/docs/es/platform/iot-fleets/overview#integraciones",{"_3471":71892,"_30355":71886,"_5":30684,"_21010":121314,"_27589":121315,"_2954":121316},[],"/docs/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3471":71893,"_30355":71886,"_21010":121318,"_5":14420,"_27589":71886,"_2954":121319},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3471":71894,"_30355":71886,"_21010":121321,"_5":14420,"_27589":121302,"_2954":121322},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3471":71895,"_30355":71886,"_21010":121324,"_5":14420,"_27589":121302,"_2954":121325},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3471":71896,"_30355":71886,"_21010":121327,"_5":14420,"_27589":121306,"_2954":121328},[],"Recurso",{"_3471":71897,"_30355":71886,"_21010":121330,"_5":14420,"_27589":121306,"_2954":121331},[],"Qué representa",{"_3471":71898,"_30355":71886,"_21010":121333,"_5":14420,"_27589":121306,"_2954":121334},[],"**Dispositivo**",{"_3471":71899,"_30355":71886,"_21010":121336,"_5":14420,"_27589":121306,"_2954":121337},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3471":71900,"_30355":71886,"_21010":121339,"_5":14420,"_27589":121306,"_2954":121340},[],"**Identidad**",{"_3471":71901,"_30355":71886,"_21010":121342,"_5":14420,"_27589":121306,"_2954":121343},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3471":71902,"_30355":71886,"_21010":121345,"_5":14420,"_27589":121306,"_2954":54256},[],{"_3471":71903,"_30355":71886,"_21010":121347,"_5":14420,"_27589":121306,"_2954":121348},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3471":71904,"_30355":71886,"_21010":121350,"_5":14420,"_27589":121306,"_2954":121351},[],"**Flota**",{"_3471":71905,"_30355":71886,"_21010":121353,"_5":14420,"_27589":121306,"_2954":121354},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3471":71906,"_30355":71886,"_21010":121356,"_5":14420,"_27589":121306,"_2954":121357},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3471":71907,"_30355":71886,"_21010":121359,"_5":14420,"_27589":121306,"_2954":121360},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3471":71908,"_30355":71886,"_21010":121362,"_5":14420,"_27589":121309,"_2954":121363},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3471":71909,"_30355":71886,"_21010":121365,"_5":14420,"_27589":121309,"_2954":121366},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3471":71910,"_30355":71886,"_21010":121368,"_5":14420,"_27589":121309,"_2954":121369},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3471":71911,"_30355":71886,"_21010":121371,"_5":14420,"_27589":121309,"_2954":121372},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3471":71912,"_30355":71886,"_21010":121374,"_5":14420,"_27589":121309,"_2954":121375},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3471":71913,"_30355":71886,"_21010":121377,"_5":14420,"_27589":121309,"_2954":121378},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3471":71914,"_30355":71886,"_21010":121380,"_5":14420,"_27589":121309,"_2954":121381},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3471":71915,"_30355":71886,"_21010":121383,"_5":14420,"_27589":121309,"_2954":121384},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3471":71916,"_30355":71886,"_21010":121386,"_5":14420,"_27589":121312,"_2954":121387},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3471":71917,"_30355":71886,"_21010":121389,"_5":14420,"_27589":121312,"_2954":121390},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3471":71918,"_30355":71886,"_21010":121392,"_5":14420,"_27589":121315,"_2954":121393},[],"Participante",{"_3471":71919,"_30355":71886,"_21010":121395,"_5":14420,"_27589":121315,"_2954":121396},[],"Responsabilidad",{"_3471":71920,"_30355":71886,"_21010":121398,"_5":14420,"_27589":121315,"_2954":121399},[],"Administrador PKI",{"_3471":71921,"_30355":71886,"_21010":121401,"_5":14420,"_27589":121315,"_2954":121402},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3471":71922,"_30355":71886,"_21010":121404,"_5":14420,"_27589":121315,"_2954":121405},[],"Administrador del aprovisionamiento",{"_3471":71923,"_30355":71886,"_21010":121407,"_5":14420,"_27589":121315,"_2954":121408},[],"DMS, admisión, autenticación por operación e inventario.",{"_3471":71924,"_30355":71886,"_21010":121410,"_5":14420,"_27589":121315,"_2954":121411},[],"Integrador del dispositivo",{"_3471":71925,"_30355":71886,"_21010":121413,"_5":14420,"_27589":121315,"_2954":121414},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3471":71926,"_30355":71886,"_21010":121416,"_5":14420,"_27589":121315,"_2954":121417},[],"Integrador del consumidor",{"_3471":71927,"_30355":71886,"_21010":121419,"_5":14420,"_27589":121315,"_2954":121420},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3471":71928,"_30355":71886,"_21010":121422,"_5":14420,"_27589":121315,"_2954":121423},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3471":71929,"_30355":71929,"_5":14772,"_2954":121425,"_30687":121426,"_21010":121428,"_27589":71929},"Enrola y conecta tu primer dispositivo",[49421,118099,51910,121427],"Primeros pasos",[],{"_3471":71930,"_30355":71929,"_21010":121430,"_5":14420,"_27589":71929,"_2954":121431},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3471":71931,"_30355":71929,"_5":30684,"_21010":121433,"_27589":121434,"_2954":116670},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3471":71932,"_30355":71929,"_5":30684,"_21010":121436,"_27589":121437,"_2954":121438},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3471":71933,"_30355":71929,"_5":30684,"_21010":121440,"_27589":121441,"_2954":121442},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3471":71934,"_30355":71929,"_5":30684,"_21010":121444,"_27589":121445,"_2954":121446},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3471":71935,"_30355":71929,"_5":30684,"_21010":121448,"_27589":121449,"_2954":121450},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3471":71936,"_30355":71929,"_5":30684,"_21010":121452,"_27589":121453,"_2954":121454},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3471":71937,"_30355":71929,"_5":30684,"_21010":121456,"_27589":121457,"_2954":121458},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3471":71938,"_30355":71929,"_5":30684,"_21010":121460,"_27589":121461,"_2954":121462},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3471":71939,"_30355":71929,"_21010":121464,"_5":14420,"_27589":71929,"_2954":121465},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3471":71940,"_30355":71929,"_21010":121467,"_5":14420,"_27589":121434,"_2954":121468},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3471":71941,"_30355":71929,"_21010":121470,"_5":14420,"_27589":121434,"_2954":121471},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3471":71942,"_30355":71929,"_21010":121473,"_5":14420,"_27589":121434,"_2954":121474},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3471":71943,"_30355":71929,"_21010":121476,"_5":14420,"_27589":121434,"_2954":121477},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3471":71944,"_30355":71929,"_21010":121479,"_5":14420,"_27589":121434,"_2954":121480},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3471":71945,"_30355":71929,"_21010":121482,"_5":14420,"_27589":121437,"_2954":121483},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3471":71946,"_30355":71929,"_21010":121485,"_5":14420,"_27589":121437,"_2954":121486},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3471":71947,"_30355":71929,"_21010":121488,"_5":14420,"_27589":121441,"_2954":121489},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3471":71948,"_30355":71929,"_21010":121491,"_5":14420,"_27589":121441,"_2954":121492},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3471":71949,"_30355":71929,"_21010":121494,"_5":14420,"_27589":121441,"_2954":121495},[],"Ajuste",{"_3471":71950,"_30355":71929,"_21010":121497,"_5":14420,"_27589":121441,"_2954":121498},[],"Valor de evaluación",{"_3471":71951,"_30355":71929,"_21010":121500,"_5":14420,"_27589":121441,"_2954":54412},[],{"_3471":71952,"_30355":71929,"_21010":121502,"_5":14420,"_27589":121441,"_2954":121503},[],"Raíz emisora de `device-root.pem`.",{"_3471":71953,"_30355":71929,"_21010":121505,"_5":14420,"_27589":121441,"_2954":119414},[],{"_3471":71954,"_30355":71929,"_21010":121507,"_5":14420,"_27589":121441,"_2954":121508},[],"Perfil final de 1 hora que acabas de preparar.",{"_3471":71955,"_30355":71929,"_21010":121510,"_5":14420,"_27589":121441,"_2954":54423},[],{"_3471":71956,"_30355":71929,"_21010":121512,"_5":14420,"_27589":121441,"_2954":54426},[],{"_3471":71957,"_30355":71929,"_21010":121514,"_5":14420,"_27589":121441,"_2954":54429},[],{"_3471":71958,"_30355":71929,"_21010":121516,"_5":14420,"_27589":121441,"_2954":121517},[],"Habilitado.",{"_3471":71959,"_30355":71929,"_21010":121519,"_5":14420,"_27589":121441,"_2954":54435},[],{"_3471":71960,"_30355":71929,"_21010":121521,"_5":14420,"_27589":121441,"_2954":121522},[],"Deshabilitado; el ID debe ser nuevo.",{"_3471":71961,"_30355":71929,"_21010":121524,"_5":14420,"_27589":121441,"_2954":121525},[],"Autenticación inicial",{"_3471":71962,"_30355":71929,"_21010":121527,"_5":14420,"_27589":121441,"_2954":121528},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3471":71963,"_30355":71929,"_21010":121530,"_5":14420,"_27589":121441,"_2954":121531},[],"Autenticación de renovación",{"_3471":71964,"_30355":71929,"_21010":121533,"_5":14420,"_27589":121441,"_2954":121534},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3471":71965,"_30355":71929,"_21010":121536,"_5":14420,"_27589":121441,"_2954":54453},[],{"_3471":71966,"_30355":71929,"_21010":121538,"_5":14420,"_27589":121441,"_2954":121539},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3471":71967,"_30355":71929,"_21010":121541,"_5":14420,"_27589":121441,"_2954":54459},[],{"_3471":71968,"_30355":71929,"_21010":121543,"_5":14420,"_27589":121441,"_2954":121544},[],"1 hora.",{"_3471":71969,"_30355":71929,"_21010":121546,"_5":14420,"_27589":121441,"_2954":54465},[],{"_3471":71970,"_30355":71929,"_21010":121548,"_5":14420,"_27589":121441,"_2954":121549},[],"30 minutos / 10 minutos.",{"_3471":71971,"_30355":71929,"_21010":121551,"_5":14420,"_27589":121441,"_2954":54471},[],{"_3471":71972,"_30355":71929,"_21010":121553,"_5":14420,"_27589":121441,"_2954":121554},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3471":71973,"_30355":71929,"_21010":121556,"_5":14420,"_27589":121441,"_2954":52229},[],{"_3471":71974,"_30355":71929,"_21010":121558,"_5":14420,"_27589":121441,"_2954":121559},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3471":71975,"_30355":71929,"_21010":121561,"_5":14420,"_27589":121441,"_2954":54482},[],{"_3471":71976,"_30355":71929,"_21010":121563,"_5":14420,"_27589":121441,"_2954":121564},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3471":71977,"_30355":71929,"_21010":121566,"_5":14420,"_27589":121441,"_2954":121567},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3471":71978,"_30355":71929,"_21010":121569,"_5":14420,"_27589":121445,"_2954":121570},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3471":71979,"_30355":71929,"_21010":121572,"_5":14420,"_27589":121445,"_2954":121573},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3471":71980,"_30355":71929,"_21010":121575,"_5":14420,"_27589":121449,"_2954":121576},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3471":71981,"_30355":71929,"_21010":121578,"_5":14420,"_27589":121449,"_2954":121579},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3471":71982,"_30355":71929,"_21010":121581,"_5":14420,"_27589":121449,"_2954":121582},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3471":71983,"_30355":71929,"_21010":121584,"_5":14420,"_27589":121453,"_2954":121585},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3471":71984,"_30355":71929,"_21010":121587,"_5":14420,"_27589":121453,"_2954":121588},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3471":71985,"_30355":71929,"_21010":121590,"_5":14420,"_27589":121457,"_2954":121591},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3471":71986,"_30355":71929,"_21010":121593,"_5":14420,"_27589":121457,"_2954":121594},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3471":71987,"_30355":71929,"_21010":121596,"_5":14420,"_27589":121457,"_2954":121597},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3471":71988,"_30355":71929,"_21010":121599,"_5":14420,"_27589":121457,"_2954":121600},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3471":71989,"_30355":71929,"_21010":121602,"_5":14420,"_27589":121457,"_2954":121603},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3471":71990,"_30355":71929,"_21010":121605,"_5":14420,"_27589":121461,"_2954":121606},[],"Comprobación",{"_3471":71991,"_30355":71929,"_21010":121608,"_5":14420,"_27589":121461,"_2954":121609},[],"Resultado esperado",{"_3471":71992,"_30355":71929,"_21010":121611,"_5":14420,"_27589":121461,"_2954":121612},[],"Registro",{"_3471":71993,"_30355":71929,"_21010":121614,"_5":14420,"_27589":121461,"_2954":121615},[],"ID creado automáticamente y DMS correcto.",{"_3471":71994,"_30355":71929,"_21010":121617,"_5":14420,"_27589":121461,"_2954":120902},[],{"_3471":71995,"_30355":71929,"_21010":121619,"_5":14420,"_27589":121461,"_2954":121620},[],"CN, perfil, serie y clave verificados.",{"_3471":71996,"_30355":71929,"_21010":121622,"_5":14420,"_27589":121461,"_2954":121623},[],"Inventario",{"_3471":71997,"_30355":71929,"_21010":121625,"_5":14420,"_27589":121461,"_2954":121626},[],"Serie recibida visible como identidad actual y en el historial.",{"_3471":71998,"_30355":71929,"_21010":121628,"_5":14420,"_27589":121461,"_2954":121629},[],"Consumidor",{"_3471":71999,"_30355":71929,"_21010":121631,"_5":14420,"_27589":121461,"_2954":121632},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3471":72000,"_30355":71929,"_21010":121634,"_5":14420,"_27589":121461,"_2954":121635},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3471":72001,"_30355":71929,"_21010":121637,"_5":14420,"_27589":121461,"_2954":121638},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3471":72002,"_30355":72002,"_5":14772,"_2954":119128,"_30687":121640,"_21010":121641,"_27589":72002},[49421,118099,51910,121427],[],{"_3471":72003,"_30355":72002,"_21010":121643,"_5":14420,"_27589":72002,"_2954":121644},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3471":72004,"_30355":72002,"_5":30684,"_21010":121646,"_27589":121647,"_2954":116670},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3471":72005,"_30355":72002,"_5":30684,"_21010":121649,"_27589":121650,"_2954":121651},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3471":72006,"_30355":72002,"_5":30684,"_21010":121653,"_27589":121654,"_2954":121655},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3471":72007,"_30355":72002,"_5":30684,"_21010":121657,"_27589":121658,"_2954":121659},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3471":72008,"_30355":72002,"_5":30684,"_21010":121661,"_27589":121662,"_2954":121663},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3471":72009,"_30355":72002,"_5":30684,"_21010":121665,"_27589":121666,"_2954":121667},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3471":72010,"_30355":72002,"_5":30684,"_21010":121669,"_27589":121670,"_2954":121609},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3471":72011,"_30355":72002,"_5":30684,"_21010":121672,"_27589":121673,"_2954":121674},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3471":72012,"_30355":72002,"_5":30684,"_21010":121676,"_27589":121677,"_2954":121678},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3471":72013,"_30355":72002,"_21010":121680,"_5":14420,"_27589":72002,"_2954":121681},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3471":72014,"_30355":72002,"_21010":121683,"_5":14420,"_27589":72002,"_2954":121684},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3471":72015,"_30355":72002,"_21010":121686,"_5":14420,"_27589":121647,"_2954":121687},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3471":72016,"_30355":72002,"_21010":121689,"_5":14420,"_27589":121647,"_2954":121690},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3471":72017,"_30355":72002,"_21010":121692,"_5":14420,"_27589":121647,"_2954":121693},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3471":72018,"_30355":72002,"_21010":121695,"_5":14420,"_27589":121647,"_2954":121696},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3471":72019,"_30355":72002,"_21010":121698,"_5":14420,"_27589":121650,"_2954":121699},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3471":72020,"_30355":72002,"_21010":121701,"_5":14420,"_27589":121650,"_2954":121702},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3471":72021,"_30355":72002,"_21010":121704,"_5":14420,"_27589":121650,"_2954":121705},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3471":72022,"_30355":72002,"_21010":121707,"_5":14420,"_27589":121650,"_2954":121708},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3471":72023,"_30355":72002,"_21010":121710,"_5":14420,"_27589":121650,"_2954":121711},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3471":72024,"_30355":72002,"_21010":121713,"_5":14420,"_27589":121650,"_2954":121714},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3471":72025,"_30355":72002,"_21010":121716,"_5":14420,"_27589":121650,"_2954":121717},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3471":72026,"_30355":72002,"_21010":121719,"_5":14420,"_27589":121650,"_2954":121720},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3471":72027,"_30355":72002,"_21010":121722,"_5":14420,"_27589":121654,"_2954":121723},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3471":72028,"_30355":72002,"_21010":121725,"_5":14420,"_27589":121654,"_2954":54647},[],{"_3471":72029,"_30355":72002,"_21010":121727,"_5":14420,"_27589":121654,"_2954":121728},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3471":72030,"_30355":72002,"_21010":121730,"_5":14420,"_27589":121654,"_2954":121731},[],"**Icon** y **Tags**: clasificación opcional.",{"_3471":72031,"_30355":72002,"_21010":121733,"_5":14420,"_27589":121654,"_2954":121734},[],"Confirma el registro.",{"_3471":72032,"_30355":72002,"_21010":121736,"_5":14420,"_27589":121658,"_2954":121737},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3471":72033,"_30355":72002,"_21010":121739,"_5":14420,"_27589":121658,"_2954":121740},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3471":72034,"_30355":72002,"_21010":121742,"_5":14420,"_27589":121662,"_2954":121743},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3471":72035,"_30355":72002,"_21010":121745,"_5":14420,"_27589":121662,"_2954":121746},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3471":72036,"_30355":72002,"_21010":121748,"_5":14420,"_27589":121666,"_2954":121749},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3471":72037,"_30355":72002,"_21010":121751,"_5":14420,"_27589":121666,"_2954":121752},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3471":72038,"_30355":72002,"_21010":121754,"_5":14420,"_27589":121670,"_2954":121606},[],{"_3471":72039,"_30355":72002,"_21010":121756,"_5":14420,"_27589":121670,"_2954":121757},[],"Resultado",{"_3471":72040,"_30355":72002,"_21010":121759,"_5":14420,"_27589":121670,"_2954":120888},[],{"_3471":72041,"_30355":72002,"_21010":121761,"_5":14420,"_27589":121670,"_2954":121762},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3471":72042,"_30355":72002,"_21010":121764,"_5":14420,"_27589":121670,"_2954":121765},[],"Identidad actual",{"_3471":72043,"_30355":72002,"_21010":121767,"_5":14420,"_27589":121670,"_2954":121768},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3471":72044,"_30355":72002,"_21010":121770,"_5":14420,"_27589":121670,"_2954":121771},[],"Historial",{"_3471":72045,"_30355":72002,"_21010":121773,"_5":14420,"_27589":121670,"_2954":121774},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3471":72046,"_30355":72002,"_21010":121776,"_5":14420,"_27589":121670,"_2954":121777},[],"Clave y certificado",{"_3471":72047,"_30355":72002,"_21010":121779,"_5":14420,"_27589":121670,"_2954":121780},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3471":72048,"_30355":72002,"_21010":121782,"_5":14420,"_27589":121673,"_2954":121783},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3471":72049,"_30355":72002,"_21010":121785,"_5":14420,"_27589":121673,"_2954":121786},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3471":72050,"_30355":72002,"_21010":121788,"_5":14420,"_27589":121673,"_2954":121789},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3471":72051,"_30355":72002,"_21010":121791,"_5":14420,"_27589":121673,"_2954":121792},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3471":72052,"_30355":72002,"_21010":121794,"_5":14420,"_27589":121677,"_2954":121795},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3471":72053,"_30355":72002,"_21010":121797,"_5":14420,"_27589":121677,"_2954":121798},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3471":72054,"_30355":72002,"_21010":121800,"_5":14420,"_27589":121677,"_2954":121801},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3471":72055,"_30355":72055,"_5":14772,"_2954":121803,"_30687":121804,"_21010":121805,"_27589":72055},"Plataforma Lamassu IoT",[49421,118099],[],{"_3471":72056,"_30355":72055,"_21010":121807,"_5":14420,"_27589":72055,"_2954":121808},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3471":72057,"_30355":72055,"_5":30684,"_21010":121810,"_27589":121811,"_2954":121303},[],"/docs/es/platform/overview#empieza-aquí",{"_3471":72058,"_30355":72055,"_5":30684,"_21010":121813,"_27589":121814,"_2954":121815},[],"/docs/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3471":72059,"_30355":72055,"_5":30684,"_21010":121817,"_27589":121818,"_2954":121819},[],"/docs/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3471":72060,"_30355":72055,"_5":30684,"_21010":121821,"_27589":121822,"_2954":121823},[],"/docs/es/platform/overview#capacidades-principales","Capacidades principales",{"_3471":72061,"_30355":72055,"_5":30684,"_21010":121825,"_27589":121826,"_2954":121827},[],"/docs/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3471":72062,"_30355":72055,"_5":30684,"_21010":121829,"_27589":121830,"_2954":121831},[],"/docs/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3471":72063,"_30355":72055,"_5":30684,"_21010":121833,"_27589":121834,"_2954":121835},[],"/docs/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3471":72064,"_30355":72055,"_5":30684,"_21010":121837,"_27589":121838,"_2954":121839},[],"/docs/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3471":72065,"_30355":72055,"_5":30684,"_21010":121841,"_27589":121842,"_2954":121843},[],"/docs/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3471":72066,"_30355":72055,"_5":30684,"_21010":121845,"_27589":121846,"_2954":121847},[],"/docs/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3471":72067,"_30355":72055,"_5":30684,"_21010":121849,"_27589":121850,"_2954":121851},[],"/docs/es/platform/overview#referencia-operativa","Referencia operativa",{"_3471":72068,"_30355":72055,"_21010":121853,"_5":14420,"_27589":72055,"_2954":121854},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3471":72069,"_30355":72055,"_21010":121856,"_5":14420,"_27589":121811,"_2954":121857},[],"Elige el resultado que necesitas obtener:",{"_3471":72070,"_30355":72055,"_21010":121859,"_5":14420,"_27589":121811,"_2954":121860},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3471":72071,"_30355":72055,"_21010":121862,"_5":14420,"_27589":121811,"_2954":121863},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3471":72072,"_30355":72055,"_21010":121865,"_5":14420,"_27589":121811,"_2954":121866},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3471":72073,"_30355":72055,"_21010":121868,"_5":14420,"_27589":121814,"_2954":121869},[],"Bloque",{"_3471":72074,"_30355":72055,"_21010":121871,"_5":14420,"_27589":121814,"_2954":121872},[],"Qué gestionas",{"_3471":72075,"_30355":72055,"_21010":121874,"_5":14420,"_27589":121814,"_2954":121875},[],"Punto de entrada",{"_3471":72076,"_30355":72055,"_21010":121877,"_5":14420,"_27589":121814,"_2954":54800},[],{"_3471":72077,"_30355":72055,"_21010":121879,"_5":14420,"_27589":121814,"_2954":121880},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3471":72078,"_30355":72055,"_21010":121882,"_5":14420,"_27589":121814,"_2954":121883},[],"Visión general de PKI",{"_3471":72079,"_30355":72055,"_21010":121885,"_5":14420,"_27589":121814,"_2954":54809},[],{"_3471":72080,"_30355":72055,"_21010":121887,"_5":14420,"_27589":121814,"_2954":121888},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3471":72081,"_30355":72055,"_21010":121890,"_5":14420,"_27589":121814,"_2954":121891},[],"Visión general de IoT Fleets",{"_3471":72082,"_30355":72055,"_21010":121893,"_5":14420,"_27589":121814,"_2954":121894},[],"**Administración**",{"_3471":72083,"_30355":72055,"_21010":121896,"_5":14420,"_27589":121814,"_2954":121897},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3471":72084,"_30355":72055,"_21010":121899,"_5":14420,"_27589":121814,"_2954":118097},[],{"_3471":72085,"_30355":72055,"_21010":121901,"_5":14420,"_27589":121814,"_2954":121902},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3471":72086,"_30355":72055,"_21010":121904,"_5":14420,"_27589":121818,"_2954":121905},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3471":72087,"_30355":72055,"_21010":121907,"_5":14420,"_27589":121818,"_2954":121908},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3471":72088,"_30355":72055,"_21010":121910,"_5":14420,"_27589":121818,"_2954":121911},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3471":72089,"_30355":72055,"_21010":121913,"_5":14420,"_27589":121818,"_2954":121914},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3471":72090,"_30355":72055,"_21010":121916,"_5":14420,"_27589":121818,"_2954":121917},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3471":72091,"_30355":72055,"_21010":121919,"_5":14420,"_27589":121818,"_2954":121920},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3471":72092,"_30355":72055,"_21010":121922,"_5":14420,"_27589":121826,"_2954":121923},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3471":72093,"_30355":72055,"_21010":121925,"_5":14420,"_27589":121830,"_2954":121926},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3471":72094,"_30355":72055,"_21010":121928,"_5":14420,"_27589":121834,"_2954":121929},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3471":72095,"_30355":72055,"_21010":121931,"_5":14420,"_27589":121838,"_2954":121932},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3471":72096,"_30355":72055,"_21010":121934,"_5":14420,"_27589":121842,"_2954":121935},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3471":72097,"_30355":72055,"_21010":121937,"_5":14420,"_27589":121846,"_2954":121938},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3471":72098,"_30355":72055,"_21010":121940,"_5":14420,"_27589":121850,"_2954":121396},[],{"_3471":72099,"_30355":72055,"_21010":121942,"_5":14420,"_27589":121850,"_2954":121943},[],"Qué prepara o comprueba",{"_3471":72100,"_30355":72055,"_21010":121945,"_5":14420,"_27589":121850,"_2954":121399},[],{"_3471":72101,"_30355":72055,"_21010":121947,"_5":14420,"_27589":121850,"_2954":121948},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3471":72102,"_30355":72055,"_21010":121950,"_5":14420,"_27589":121850,"_2954":121951},[],"Administrador de la flota",{"_3471":72103,"_30355":72055,"_21010":121953,"_5":14420,"_27589":121850,"_2954":121954},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3471":72104,"_30355":72055,"_21010":121956,"_5":14420,"_27589":121850,"_2954":121411},[],{"_3471":72105,"_30355":72055,"_21010":121958,"_5":14420,"_27589":121850,"_2954":121959},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3471":72106,"_30355":72055,"_21010":121961,"_5":14420,"_27589":121850,"_2954":121417},[],{"_3471":72107,"_30355":72055,"_21010":121963,"_5":14420,"_27589":121850,"_2954":121964},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3471":72108,"_30355":72055,"_21010":121966,"_5":14420,"_27589":121850,"_2954":121967},[],"Operador de infraestructura",{"_3471":72109,"_30355":72055,"_21010":121969,"_5":14420,"_27589":121850,"_2954":121970},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3471":72110,"_30355":72055,"_21010":121972,"_5":14420,"_27589":121850,"_2954":121973},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3471":72111,"_30355":72111,"_5":14772,"_2954":121975,"_30687":121976,"_21010":121978,"_27589":72111},"Jerarquía y rotación de CAs",[49421,118099,54901,121977],"Claves, autoridades y certificados",[],{"_3471":72112,"_30355":72111,"_21010":121980,"_5":14420,"_27589":72111,"_2954":121981},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3471":72113,"_30355":72111,"_5":30684,"_21010":121983,"_27589":121984,"_2954":121985},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3471":72114,"_30355":72111,"_5":30684,"_21010":121987,"_27589":121988,"_2954":121989},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3471":72115,"_30355":72111,"_5":30684,"_21010":121991,"_27589":121992,"_2954":121993},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3471":72116,"_30355":72111,"_5":30684,"_21010":121995,"_27589":121996,"_2954":121997},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3471":72117,"_30355":72111,"_5":30684,"_21010":121999,"_27589":122000,"_2954":122001},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3471":72118,"_30355":72111,"_5":30684,"_21010":122003,"_27589":122004,"_2954":122005},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3471":72119,"_30355":72111,"_5":30684,"_21010":122007,"_27589":122008,"_2954":122009},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3471":72120,"_30355":72111,"_5":30684,"_21010":122011,"_27589":122012,"_2954":122013},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3471":72121,"_30355":72111,"_5":30684,"_21010":122015,"_27589":122016,"_2954":122017},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3471":72122,"_30355":72111,"_5":30684,"_21010":122019,"_27589":122020,"_2954":122021},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3471":72123,"_30355":72111,"_5":30684,"_21010":122023,"_27589":122024,"_2954":122025},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3471":72124,"_30355":72111,"_5":30684,"_21010":122027,"_27589":122028,"_2954":122029},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3471":72125,"_30355":72111,"_21010":122031,"_5":14420,"_27589":72111,"_2954":122032},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3471":72126,"_30355":72111,"_21010":122034,"_5":14420,"_27589":72111,"_2954":122035},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3471":72127,"_30355":72111,"_21010":122037,"_5":14420,"_27589":121984,"_2954":122038},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3471":72128,"_30355":72111,"_21010":122040,"_5":14420,"_27589":121984,"_2954":122041},[],"entorno, como producción y preproducción;",{"_3471":72129,"_30355":72111,"_21010":122043,"_5":14420,"_27589":121984,"_2954":122044},[],"propietario o equipo operador;",{"_3471":72130,"_30355":72111,"_21010":122046,"_5":14420,"_27589":121984,"_2954":122047},[],"familia de dispositivos o proceso de fabricación;",{"_3471":72131,"_30355":72111,"_21010":122049,"_5":14420,"_27589":121984,"_2954":122050},[],"región o requisito regulatorio;",{"_3471":72132,"_30355":72111,"_21010":122052,"_5":14420,"_27589":121984,"_2954":122053},[],"motor criptográfico o política de clave;",{"_3471":72133,"_30355":72111,"_21010":122055,"_5":14420,"_27589":121984,"_2954":122056},[],"ventana de mantenimiento y ritmo de renovación.",{"_3471":72134,"_30355":72111,"_21010":122058,"_5":14420,"_27589":121984,"_2954":122059},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3471":72135,"_30355":72111,"_21010":122061,"_5":14420,"_27589":121984,"_2954":122062},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3471":72136,"_30355":72111,"_21010":122064,"_5":14420,"_27589":121988,"_2954":122065},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3471":72137,"_30355":72111,"_21010":122067,"_5":14420,"_27589":121988,"_2954":122068},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir; consulta la guía de CRL.",{"_3471":72138,"_30355":72111,"_21010":122070,"_5":14420,"_27589":121988,"_2954":122071},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3471":72139,"_30355":72111,"_21010":122073,"_5":14420,"_27589":121988,"_2954":122074},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3471":72140,"_30355":72111,"_21010":122076,"_5":14420,"_27589":121992,"_2954":122077},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3471":72141,"_30355":72111,"_21010":122079,"_5":14420,"_27589":121992,"_2954":122080},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3471":72142,"_30355":72111,"_21010":122082,"_5":14420,"_27589":121992,"_2954":122083},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3471":72143,"_30355":72111,"_21010":122085,"_5":14420,"_27589":121992,"_2954":122086},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3471":72144,"_30355":72111,"_21010":122088,"_5":14420,"_27589":122000,"_2954":122089},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3471":72145,"_30355":72111,"_21010":122091,"_5":14420,"_27589":122004,"_2954":122092},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3471":72146,"_30355":72111,"_21010":122094,"_5":14420,"_27589":122008,"_2954":122095},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3471":72147,"_30355":72111,"_21010":122097,"_5":14420,"_27589":122012,"_2954":122098},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3471":72148,"_30355":72111,"_21010":122100,"_5":14420,"_27589":122016,"_2954":122101},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3471":72149,"_30355":72111,"_21010":122103,"_5":14420,"_27589":122020,"_2954":122104},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3471":72150,"_30355":72111,"_21010":122106,"_5":14420,"_27589":122024,"_2954":122107},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3471":72151,"_30355":72111,"_21010":122109,"_5":14420,"_27589":122024,"_2954":122110},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3471":72152,"_30355":72111,"_21010":122112,"_5":14420,"_27589":122024,"_2954":122113},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3471":72153,"_30355":72111,"_21010":122115,"_5":14420,"_27589":122024,"_2954":122116},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3471":72154,"_30355":72111,"_21010":122118,"_5":14420,"_27589":122028,"_2954":122119},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3471":72155,"_30355":72111,"_21010":122121,"_5":14420,"_27589":122028,"_2954":122122},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3471":72156,"_30355":72111,"_21010":122124,"_5":14420,"_27589":122028,"_2954":122125},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3471":72157,"_30355":72111,"_21010":122127,"_5":14420,"_27589":122028,"_2954":122128},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3471":72158,"_30355":72111,"_21010":122130,"_5":14420,"_27589":122028,"_2954":122131},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3471":72159,"_30355":72111,"_21010":122133,"_5":14420,"_27589":122028,"_2954":122134},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3471":72160,"_30355":72111,"_21010":122136,"_5":14420,"_27589":122028,"_2954":122137},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3471":72161,"_30355":72161,"_5":14772,"_2954":122139,"_30687":122140,"_21010":122141,"_27589":72161},"Autoridades de certificación",[49421,118099,54901,121977],[],{"_3471":72162,"_30355":72161,"_21010":122143,"_5":14420,"_27589":72161,"_2954":122144},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3471":72163,"_30355":72161,"_5":30684,"_21010":122146,"_27589":122147,"_2954":122148},[],"/docs/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3471":72164,"_30355":72161,"_5":30684,"_21010":122150,"_27589":122151,"_2954":122152},[],"/docs/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3471":72165,"_30355":72161,"_5":30684,"_21010":122154,"_27589":122155,"_2954":116670},[],"/docs/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3471":72166,"_30355":72161,"_5":30684,"_21010":122157,"_27589":122158,"_2954":122159},[],"/docs/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3471":72167,"_30355":72161,"_5":30684,"_21010":122161,"_27589":122162,"_2954":122163},[],"/docs/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3471":72168,"_30355":72161,"_5":30684,"_21010":122165,"_27589":122166,"_2954":122167},[],"/docs/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3471":72169,"_30355":72161,"_5":30684,"_21010":122169,"_27589":122170,"_2954":122171},[],"/docs/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3471":72170,"_30355":72161,"_5":30684,"_21010":122173,"_27589":122174,"_2954":122175},[],"/docs/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3471":72171,"_30355":72161,"_5":30684,"_21010":122177,"_27589":122178,"_2954":122179},[],"/docs/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3471":72172,"_30355":72161,"_5":30684,"_21010":122181,"_27589":122182,"_2954":122183},[],"/docs/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3471":72173,"_30355":72161,"_5":30684,"_21010":122185,"_27589":122186,"_2954":122187},[],"/docs/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3471":72174,"_30355":72161,"_5":30684,"_21010":122189,"_27589":122190,"_2954":122191},[],"/docs/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3471":72175,"_30355":72161,"_5":30684,"_21010":122193,"_27589":122194,"_2954":122195},[],"/docs/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3471":72176,"_30355":72161,"_5":30684,"_21010":122197,"_27589":122198,"_2954":122199},[],"/docs/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3471":72177,"_30355":72161,"_5":30684,"_21010":122201,"_27589":122202,"_2954":122203},[],"/docs/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3471":72178,"_30355":72161,"_5":30684,"_21010":122205,"_27589":122206,"_2954":122207},[],"/docs/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3471":72179,"_30355":72161,"_5":30684,"_21010":122209,"_27589":122210,"_2954":122211},[],"/docs/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3471":72180,"_30355":72161,"_5":30684,"_21010":122213,"_27589":122214,"_2954":122215},[],"/docs/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3471":72181,"_30355":72161,"_5":30684,"_21010":122217,"_27589":122218,"_2954":122219},[],"/docs/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3471":72182,"_30355":72161,"_5":30684,"_21010":122221,"_27589":122222,"_2954":122223},[],"/docs/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3471":72183,"_30355":72161,"_5":30684,"_21010":122225,"_27589":122226,"_2954":122227},[],"/docs/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3471":72184,"_30355":72161,"_5":30684,"_21010":122229,"_27589":122230,"_2954":122231},[],"/docs/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3471":72185,"_30355":72161,"_5":30684,"_21010":122233,"_27589":122234,"_2954":122235},[],"/docs/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3471":72186,"_30355":72161,"_21010":122237,"_5":14420,"_27589":72161,"_2954":122238},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3471":72187,"_30355":72161,"_21010":122240,"_5":14420,"_27589":72161,"_2954":122241},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3471":72188,"_30355":72161,"_21010":122243,"_5":14420,"_27589":72161,"_2954":122244},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3471":72189,"_30355":72161,"_21010":122246,"_5":14420,"_27589":122147,"_2954":122247},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3471":72190,"_30355":72161,"_21010":122249,"_5":14420,"_27589":122147,"_2954":122250},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3471":72191,"_30355":72161,"_21010":122252,"_5":14420,"_27589":122147,"_2954":122253},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3471":72192,"_30355":72161,"_21010":122255,"_5":14420,"_27589":122147,"_2954":122256},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3471":72193,"_30355":72161,"_21010":122258,"_5":14420,"_27589":122147,"_2954":122259},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3471":72194,"_30355":72161,"_21010":122261,"_5":14420,"_27589":122155,"_2954":122262},[],"Decide si la CA será raíz o intermedia.",{"_3471":72195,"_30355":72161,"_21010":122264,"_5":14420,"_27589":122155,"_2954":122265},[],"Elige el motor que custodiará la clave.",{"_3471":72196,"_30355":72161,"_21010":122267,"_5":14420,"_27589":122155,"_2954":122268},[],"Define una validez superior a la de los certificados que emitirá.",{"_3471":72197,"_30355":72161,"_21010":122270,"_5":14420,"_27589":122155,"_2954":122271},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3471":72198,"_30355":72161,"_21010":122273,"_5":14420,"_27589":122158,"_2954":122274},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3471":72199,"_30355":72161,"_21010":122276,"_5":14420,"_27589":122162,"_2954":122277},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3471":72200,"_30355":72161,"_21010":122279,"_5":14420,"_27589":122162,"_2954":122280},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3471":72201,"_30355":72161,"_21010":122282,"_5":14420,"_27589":122166,"_2954":122283},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3471":72202,"_30355":72161,"_21010":122285,"_5":14420,"_27589":122170,"_2954":122286},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3471":72203,"_30355":72161,"_21010":122288,"_5":14420,"_27589":122170,"_2954":122289},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3471":72204,"_30355":72161,"_21010":122291,"_5":14420,"_27589":122170,"_2954":122292},[],"`ST`: estado o provincia.",{"_3471":72205,"_30355":72161,"_21010":122294,"_5":14420,"_27589":122170,"_2954":122295},[],"`L`: localidad.",{"_3471":72206,"_30355":72161,"_21010":122297,"_5":14420,"_27589":122170,"_2954":122298},[],"`O`: organización.",{"_3471":72207,"_30355":72161,"_21010":122300,"_5":14420,"_27589":122170,"_2954":122301},[],"`OU`: unidad organizativa.",{"_3471":72208,"_30355":72161,"_21010":122303,"_5":14420,"_27589":122170,"_2954":122304},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3471":72209,"_30355":72161,"_21010":122306,"_5":14420,"_27589":122174,"_2954":122307},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3471":72210,"_30355":72161,"_21010":122309,"_5":14420,"_27589":122174,"_2954":122310},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3471":72211,"_30355":72161,"_21010":122312,"_5":14420,"_27589":122178,"_2954":122313},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3471":72212,"_30355":72161,"_21010":122315,"_5":14420,"_27589":122178,"_2954":122316},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3471":72213,"_30355":72161,"_21010":122318,"_5":14420,"_27589":122182,"_2954":122319},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3471":72214,"_30355":72161,"_21010":122321,"_5":14420,"_27589":122182,"_2954":122322},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3471":72215,"_30355":72161,"_21010":122324,"_5":14420,"_27589":122186,"_2954":122325},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3471":72216,"_30355":72161,"_21010":122327,"_5":14420,"_27589":122186,"_2954":122328},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3471":72217,"_30355":72161,"_21010":122330,"_5":14420,"_27589":122186,"_2954":122331},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3471":72218,"_30355":72161,"_21010":122333,"_5":14420,"_27589":122190,"_2954":122334},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3471":72219,"_30355":72161,"_21010":122336,"_5":14420,"_27589":122194,"_2954":122337},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3471":72220,"_30355":72161,"_21010":122339,"_5":14420,"_27589":122194,"_2954":122340},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3471":72221,"_30355":72161,"_21010":122342,"_5":14420,"_27589":122198,"_2954":122343},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3471":72222,"_30355":72161,"_21010":122345,"_5":14420,"_27589":122202,"_2954":122346},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3471":72223,"_30355":72161,"_21010":122348,"_5":14420,"_27589":122202,"_2954":122349},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3471":72224,"_30355":72161,"_21010":122351,"_5":14420,"_27589":122206,"_2954":122352},[],"Abre una CA desde el inventario para consultar:",{"_3471":72225,"_30355":72161,"_21010":122354,"_5":14420,"_27589":122206,"_2954":122355},[],"Estado y periodo de validez.",{"_3471":72226,"_30355":72161,"_21010":122357,"_5":14420,"_27589":122206,"_2954":122358},[],"Certificado y cadena en formato PEM.",{"_3471":72227,"_30355":72161,"_21010":122360,"_5":14420,"_27589":122206,"_2954":122361},[],"Número de certificados activos, expirados y revocados.",{"_3471":72228,"_30355":72161,"_21010":122363,"_5":14420,"_27589":122206,"_2954":122364},[],"Certificados emitidos en **Issued Certificates**.",{"_3471":72229,"_30355":72161,"_21010":122366,"_5":14420,"_27589":122206,"_2954":122367},[],"CRL vinculada a la autoridad.",{"_3471":72230,"_30355":72161,"_21010":122369,"_5":14420,"_27589":122206,"_2954":122370},[],"Metadatos y motor criptográfico asociado.",{"_3471":72231,"_30355":72161,"_21010":122372,"_5":14420,"_27589":122206,"_2954":122373},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3471":72232,"_30355":72161,"_21010":122375,"_5":14420,"_27589":122210,"_2954":122376},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3471":72233,"_30355":72161,"_21010":122378,"_5":14420,"_27589":122210,"_2954":122379},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3471":72234,"_30355":72161,"_21010":122381,"_5":14420,"_27589":122210,"_2954":122382},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3471":72235,"_30355":72161,"_21010":122384,"_5":14420,"_27589":122210,"_2954":122385},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3471":72236,"_30355":72161,"_21010":122387,"_5":14420,"_27589":122214,"_2954":122388},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3471":72237,"_30355":72161,"_21010":122390,"_5":14420,"_27589":122218,"_2954":122391},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3471":72238,"_30355":72161,"_21010":122393,"_5":14420,"_27589":122222,"_2954":122394},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3471":72239,"_30355":72161,"_21010":122396,"_5":14420,"_27589":122226,"_2954":122397},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3471":72240,"_30355":72161,"_21010":122399,"_5":14420,"_27589":122230,"_2954":122400},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3471":72241,"_30355":72161,"_21010":122402,"_5":14420,"_27589":122234,"_2954":122403},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3471":72242,"_30355":72161,"_21010":122405,"_5":14420,"_27589":122234,"_2954":122406},[],"Los ajustes de CRL de la CA se conservan y no pueden borrarse por API. La última CRL sigue sirviéndose, pero una vez desaparecida la CA nada la regenera, así que ajusta antes su validez y su firmante (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3471":72243,"_30355":72161,"_21010":122408,"_5":14420,"_27589":122234,"_2954":122409},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3471":72244,"_30355":72244,"_5":14772,"_2954":122411,"_30687":122412,"_21010":122413,"_27589":72244},"Perfiles de certificado",[49421,118099,54901,121977],[],{"_3471":72245,"_30355":72244,"_21010":122415,"_5":14420,"_27589":72244,"_2954":122416},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3471":72246,"_30355":72244,"_5":30684,"_21010":122418,"_27589":122419,"_2954":122420},[],"/docs/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3471":72247,"_30355":72244,"_5":30684,"_21010":122422,"_27589":122423,"_2954":122424},[],"/docs/es/platform/pki/certificate-profiles#validez","Validez",{"_3471":72248,"_30355":72244,"_5":30684,"_21010":122426,"_27589":122427,"_2954":122428},[],"/docs/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3471":72249,"_30355":72244,"_5":30684,"_21010":122430,"_27589":122431,"_2954":122432},[],"/docs/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3471":72250,"_30355":72244,"_5":30684,"_21010":122434,"_27589":122435,"_2954":122436},[],"/docs/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3471":72251,"_30355":72244,"_5":30684,"_21010":122438,"_27589":122439,"_2954":122440},[],"/docs/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3471":72252,"_30355":72244,"_5":30684,"_21010":122442,"_27589":122443,"_2954":122444},[],"/docs/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3471":72253,"_30355":72244,"_5":30684,"_21010":122446,"_27589":122447,"_2954":122448},[],"/docs/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3471":72254,"_30355":72244,"_5":30684,"_21010":122450,"_27589":122451,"_2954":122452},[],"/docs/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3471":72255,"_30355":72244,"_5":30684,"_21010":122454,"_27589":122455,"_2954":122456},[],"/docs/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3471":72256,"_30355":72244,"_5":30684,"_21010":122458,"_27589":122459,"_2954":122460},[],"/docs/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3471":72257,"_30355":72244,"_5":30684,"_21010":122462,"_27589":122463,"_2954":122464},[],"/docs/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3471":72258,"_30355":72244,"_5":30684,"_21010":122466,"_27589":122467,"_2954":122468},[],"/docs/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3471":72259,"_30355":72244,"_5":30684,"_21010":122470,"_27589":122471,"_2954":122472},[],"/docs/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3471":72260,"_30355":72244,"_5":30684,"_21010":122474,"_27589":122475,"_2954":122476},[],"/docs/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3471":72261,"_30355":72244,"_5":30684,"_21010":122478,"_27589":122479,"_2954":122480},[],"/docs/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3471":72262,"_30355":72244,"_21010":122482,"_5":14420,"_27589":72244,"_2954":122483},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3471":72263,"_30355":72244,"_21010":122485,"_5":14420,"_27589":72244,"_2954":122486},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3471":72264,"_30355":72244,"_21010":122488,"_5":14420,"_27589":122423,"_2954":122489},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3471":72265,"_30355":72244,"_21010":122491,"_5":14420,"_27589":122423,"_2954":122492},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3471":72266,"_30355":72244,"_21010":122494,"_5":14420,"_27589":122427,"_2954":122495},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3471":72267,"_30355":72244,"_21010":122497,"_5":14420,"_27589":122431,"_2954":122498},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3471":72268,"_30355":72244,"_21010":122500,"_5":14420,"_27589":122431,"_2954":122501},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3471":72269,"_30355":72244,"_21010":122503,"_5":14420,"_27589":122431,"_2954":122504},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3471":72270,"_30355":72244,"_21010":122506,"_5":14420,"_27589":122435,"_2954":122507},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3471":72271,"_30355":72244,"_21010":122509,"_5":14420,"_27589":122439,"_2954":122510},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3471":72272,"_30355":72244,"_21010":122512,"_5":14420,"_27589":122439,"_2954":122513},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3471":72273,"_30355":72244,"_21010":122515,"_5":14420,"_27589":122443,"_2954":122516},[],"La aplicación criptográfica puede:",{"_3471":72274,"_30355":72244,"_21010":122518,"_5":14420,"_27589":122443,"_2954":122519},[],"permitir o bloquear claves RSA;",{"_3471":72275,"_30355":72244,"_21010":122521,"_5":14420,"_27589":122443,"_2954":122522},[],"limitar los tamaños RSA admitidos;",{"_3471":72276,"_30355":72244,"_21010":122524,"_5":14420,"_27589":122443,"_2954":122525},[],"permitir o bloquear claves ECDSA;",{"_3471":72277,"_30355":72244,"_21010":122527,"_5":14420,"_27589":122443,"_2954":122528},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3471":72278,"_30355":72244,"_21010":122530,"_5":14420,"_27589":122443,"_2954":122531},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3471":72279,"_30355":72244,"_21010":122533,"_5":14420,"_27589":122447,"_2954":122534},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3471":72280,"_30355":72244,"_21010":122536,"_5":14420,"_27589":122447,"_2954":117859},[],{"_3471":72281,"_30355":72244,"_21010":122538,"_5":14420,"_27589":122447,"_2954":122539},[],"Primera opción",{"_3471":72282,"_30355":72244,"_21010":122541,"_5":14420,"_27589":122447,"_2954":122542},[],"Segunda opción",{"_3471":72283,"_30355":72244,"_21010":122544,"_5":14420,"_27589":122447,"_2954":122545},[],"Si no hay ninguna",{"_3471":72284,"_30355":72244,"_21010":122547,"_5":14420,"_27589":122447,"_2954":122548},[],"Firma directa con una CA",{"_3471":72285,"_30355":72244,"_21010":122550,"_5":14420,"_27589":122447,"_2954":122551},[],"`issuance_profile` incluido en la solicitud",{"_3471":72286,"_30355":72244,"_21010":122553,"_5":14420,"_27589":122447,"_2954":122554},[],"`issuance_profile_id` de la solicitud",{"_3471":72287,"_30355":72244,"_21010":122556,"_5":14420,"_27589":122447,"_2954":122557},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3471":72288,"_30355":72244,"_21010":122559,"_5":14420,"_27589":122447,"_2954":122560},[],"Emisión mediante DMS",{"_3471":72289,"_30355":72244,"_21010":122562,"_5":14420,"_27589":122447,"_2954":55488},[],{"_3471":72290,"_30355":72244,"_21010":122564,"_5":14420,"_27589":122447,"_2954":122565},[],"`settings.issuance_profile` incluido en el DMS",{"_3471":72291,"_30355":72244,"_21010":122567,"_5":14420,"_27589":122447,"_2954":122568},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3471":72292,"_30355":72244,"_21010":122570,"_5":14420,"_27589":122447,"_2954":122571},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3471":72293,"_30355":72244,"_21010":122573,"_5":14420,"_27589":122447,"_2954":122574},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3471":72294,"_30355":72244,"_21010":122576,"_5":14420,"_27589":122455,"_2954":122577},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3471":72295,"_30355":72244,"_21010":122579,"_5":14420,"_27589":122459,"_2954":122580},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3471":72296,"_30355":72244,"_21010":122582,"_5":14420,"_27589":122463,"_2954":122583},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3471":72297,"_30355":72244,"_21010":122585,"_5":14420,"_27589":122467,"_2954":122586},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3471":72298,"_30355":72244,"_21010":122588,"_5":14420,"_27589":122471,"_2954":122589},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3471":72299,"_30355":72244,"_21010":122591,"_5":14420,"_27589":122471,"_2954":122592},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3471":72300,"_30355":72244,"_21010":122594,"_5":14420,"_27589":122475,"_2954":122595},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3471":72301,"_30355":72244,"_21010":122597,"_5":14420,"_27589":122475,"_2954":122598},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3471":72302,"_30355":72244,"_21010":122600,"_5":14420,"_27589":122475,"_2954":122601},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3471":72303,"_30355":72244,"_21010":122603,"_5":14420,"_27589":122475,"_2954":122604},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3471":72304,"_30355":72244,"_21010":122606,"_5":14420,"_27589":122479,"_2954":122607},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3471":72305,"_30355":72244,"_21010":122609,"_5":14420,"_27589":122479,"_2954":122610},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3471":72306,"_30355":72306,"_5":14772,"_2954":122612,"_30687":122613,"_21010":122615,"_27589":72306},"Validación de certificados",[49421,118099,54901,122614],"Validación",[],{"_3471":72307,"_30355":72306,"_21010":122617,"_5":14420,"_27589":72306,"_2954":122618},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3471":72308,"_30355":72306,"_5":30684,"_21010":122620,"_27589":122621,"_2954":122622},[],"/docs/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3471":72309,"_30355":72306,"_5":30684,"_21010":122624,"_27589":122625,"_2954":122626},[],"/docs/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3471":72310,"_30355":72306,"_5":30684,"_21010":122628,"_27589":122629,"_2954":122630},[],"/docs/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3471":72311,"_30355":72306,"_21010":122632,"_5":14420,"_27589":72306,"_2954":122633},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3471":72312,"_30355":72306,"_21010":122635,"_5":14420,"_27589":122621,"_2954":122636},[],"Verifica estos criterios juntos:",{"_3471":72313,"_30355":72306,"_21010":122638,"_5":14420,"_27589":122621,"_2954":121606},[],{"_3471":72314,"_30355":72306,"_21010":122640,"_5":14420,"_27589":122621,"_2954":122641},[],"Resultado necesario",{"_3471":72315,"_30355":72306,"_21010":122643,"_5":14420,"_27589":122621,"_2954":122644},[],"Cadena y firma",{"_3471":72316,"_30355":72306,"_21010":122646,"_5":14420,"_27589":122621,"_2954":122647},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3471":72317,"_30355":72306,"_21010":122649,"_5":14420,"_27589":122621,"_2954":122650},[],"Fechas",{"_3471":72318,"_30355":72306,"_21010":122652,"_5":14420,"_27589":122621,"_2954":122653},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3471":72319,"_30355":72306,"_21010":122655,"_5":14420,"_27589":122621,"_2954":117769},[],{"_3471":72320,"_30355":72306,"_21010":122657,"_5":14420,"_27589":122621,"_2954":122658},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3471":72321,"_30355":72306,"_21010":122660,"_5":14420,"_27589":122621,"_2954":122661},[],"Uso",{"_3471":72322,"_30355":72306,"_21010":122663,"_5":14420,"_27589":122621,"_2954":122664},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3471":72323,"_30355":72306,"_21010":122666,"_5":14420,"_27589":122621,"_2954":122667},[],"Revocación",{"_3471":72324,"_30355":72306,"_21010":122669,"_5":14420,"_27589":122621,"_2954":122670},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3471":72325,"_30355":72306,"_21010":122672,"_5":14420,"_27589":122621,"_2954":122673},[],"Autorización",{"_3471":72326,"_30355":72306,"_21010":122675,"_5":14420,"_27589":122621,"_2954":122676},[],"La aplicación permite la acción a esa identidad.",{"_3471":72327,"_30355":72306,"_21010":122678,"_5":14420,"_27589":122621,"_2954":122679},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3471":72328,"_30355":72306,"_21010":122681,"_5":14420,"_27589":122625,"_2954":122682},[],"Mecanismo",{"_3471":72329,"_30355":72306,"_21010":122684,"_5":14420,"_27589":122625,"_2954":122685},[],"Cuándo utilizarlo",{"_3471":72330,"_30355":72306,"_21010":122687,"_5":14420,"_27589":122625,"_2954":122688},[],"Qué debes mantener",{"_3471":72331,"_30355":72306,"_21010":122690,"_5":14420,"_27589":122625,"_2954":55616},[],{"_3471":72332,"_30355":72306,"_21010":122692,"_5":14420,"_27589":122625,"_2954":122693},[],"Consulta del estado de un certificado concreto.",{"_3471":72333,"_30355":72306,"_21010":122695,"_5":14420,"_27589":122625,"_2954":122696},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3471":72334,"_30355":72306,"_21010":122698,"_5":14420,"_27589":122625,"_2954":55625},[],{"_3471":72335,"_30355":72306,"_21010":122700,"_5":14420,"_27589":122625,"_2954":122701},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3471":72336,"_30355":72306,"_21010":122703,"_5":14420,"_27589":122625,"_2954":122704},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3471":72337,"_30355":72306,"_21010":122706,"_5":14420,"_27589":122625,"_2954":122707},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3471":72338,"_30355":72306,"_21010":122709,"_5":14420,"_27589":122625,"_2954":122710},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3471":72339,"_30355":72306,"_21010":122712,"_5":14420,"_27589":122629,"_2954":122713},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3471":72340,"_30355":72306,"_21010":122715,"_5":14420,"_27589":122629,"_2954":122716},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3471":72341,"_30355":72306,"_21010":122718,"_5":14420,"_27589":122629,"_2954":122719},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3471":72342,"_30355":72306,"_21010":122721,"_5":14420,"_27589":122629,"_2954":122722},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3471":72343,"_30355":72306,"_21010":122724,"_5":14420,"_27589":122629,"_2954":122725},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3471":72344,"_30355":72306,"_21010":122727,"_5":14420,"_27589":122629,"_2954":122728},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3471":72345,"_30355":72306,"_21010":122730,"_5":14420,"_27589":122629,"_2954":122731},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3471":72346,"_30355":72306,"_21010":122733,"_5":14420,"_27589":122629,"_2954":122734},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3471":72347,"_30355":72306,"_21010":122736,"_5":14420,"_27589":122629,"_2954":122737},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3471":72348,"_30355":72348,"_5":14772,"_2954":122739,"_30687":122740,"_21010":122741,"_27589":72348},"Certificados",[49421,118099,54901,121977],[],{"_3471":72349,"_30355":72348,"_21010":122743,"_5":14420,"_27589":72348,"_2954":122744},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3471":72350,"_30355":72348,"_5":30684,"_21010":122746,"_27589":122747,"_2954":122748},[],"/docs/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3471":72351,"_30355":72348,"_5":30684,"_21010":122750,"_27589":122751,"_2954":122752},[],"/docs/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3471":72352,"_30355":72348,"_5":30684,"_21010":122754,"_27589":122755,"_2954":122756},[],"/docs/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3471":72353,"_30355":72348,"_5":30684,"_21010":122758,"_27589":122759,"_2954":122760},[],"/docs/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3471":72354,"_30355":72348,"_5":30684,"_21010":122762,"_27589":122763,"_2954":122764},[],"/docs/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3471":72355,"_30355":72348,"_5":30684,"_21010":122766,"_27589":122767,"_2954":122768},[],"/docs/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3471":72356,"_30355":72348,"_5":30684,"_21010":122770,"_27589":122771,"_2954":122772},[],"/docs/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3471":72357,"_30355":72348,"_5":30684,"_21010":122774,"_27589":122775,"_2954":122776},[],"/docs/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3471":72358,"_30355":72348,"_5":30684,"_21010":122778,"_27589":122779,"_2954":122780},[],"/docs/es/platform/pki/certificates#continúa","Continúa",{"_3471":72359,"_30355":72348,"_21010":122782,"_5":14420,"_27589":72348,"_2954":122783},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3471":72360,"_30355":72348,"_21010":122785,"_5":14420,"_27589":122747,"_2954":122786},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3471":72361,"_30355":72348,"_21010":122788,"_5":14420,"_27589":122747,"_2954":122789},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3471":72362,"_30355":72348,"_21010":122791,"_5":14420,"_27589":122747,"_2954":122792},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3471":72363,"_30355":72348,"_21010":122794,"_5":14420,"_27589":122747,"_2954":122795},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3471":72364,"_30355":72348,"_21010":122797,"_5":14420,"_27589":122747,"_2954":122798},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3471":72365,"_30355":72348,"_21010":122800,"_5":14420,"_27589":122747,"_2954":122801},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3471":72366,"_30355":72348,"_21010":122803,"_5":14420,"_27589":122747,"_2954":122804},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3471":72367,"_30355":72348,"_21010":122806,"_5":14420,"_27589":122751,"_2954":122807},[],"Descarga el PEM e inspecciónalo:",{"_3471":72368,"_30355":72348,"_21010":122809,"_5":14420,"_27589":122751,"_2954":122810},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3471":72369,"_30355":72348,"_21010":122812,"_5":14420,"_27589":122755,"_2954":122813},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3471":72370,"_30355":72348,"_21010":122815,"_5":14420,"_27589":122755,"_2954":122816},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3471":72371,"_30355":72348,"_21010":122818,"_5":14420,"_27589":122755,"_2954":122819},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3471":72372,"_30355":72348,"_21010":122821,"_5":14420,"_27589":122755,"_2954":122822},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3471":72373,"_30355":72348,"_21010":122824,"_5":14420,"_27589":122755,"_2954":122825},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3471":72374,"_30355":72348,"_21010":122827,"_5":14420,"_27589":122755,"_2954":122828},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3471":72375,"_30355":72348,"_21010":122830,"_5":14420,"_27589":122755,"_2954":122831},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3471":72376,"_30355":72348,"_21010":122833,"_5":14420,"_27589":122759,"_2954":122834},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3471":72377,"_30355":72348,"_21010":122836,"_5":14420,"_27589":122763,"_2954":122837},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3471":72378,"_30355":72348,"_21010":122839,"_5":14420,"_27589":122767,"_2954":122840},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3471":72379,"_30355":72348,"_21010":122842,"_5":14420,"_27589":122771,"_2954":122843},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3471":72380,"_30355":72348,"_21010":122845,"_5":14420,"_27589":122771,"_2954":122846},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3471":72381,"_30355":72348,"_21010":122848,"_5":14420,"_27589":122771,"_2954":122849},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3471":72382,"_30355":72348,"_21010":122851,"_5":14420,"_27589":122775,"_2954":122852},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3471":72383,"_30355":72348,"_21010":122854,"_5":14420,"_27589":122775,"_2954":122855},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3471":72384,"_30355":72348,"_21010":122857,"_5":14420,"_27589":122775,"_2954":122858},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3471":72385,"_30355":72348,"_21010":122860,"_5":14420,"_27589":122779,"_2954":122861},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3471":72386,"_30355":72348,"_21010":122863,"_5":14420,"_27589":122779,"_2954":122864},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3471":72387,"_30355":72387,"_5":14772,"_2954":122866,"_30687":122867,"_21010":122869,"_27589":72387},"Ciclo de vida de un certificado",[49421,118099,54901,122868],"Conceptos",[],{"_3471":72388,"_30355":72387,"_21010":122871,"_5":14420,"_27589":72387,"_2954":122872},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3471":72389,"_30355":72387,"_5":30684,"_21010":122874,"_27589":122875,"_2954":122876},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3471":72390,"_30355":72387,"_5":30684,"_21010":122878,"_27589":122879,"_2954":122880},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3471":72391,"_30355":72387,"_5":30684,"_21010":122882,"_27589":122883,"_2954":122884},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3471":72392,"_30355":72387,"_5":30684,"_21010":122886,"_27589":122887,"_2954":122888},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3471":72393,"_30355":72387,"_5":30684,"_21010":122890,"_27589":122891,"_2954":122892},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3471":72394,"_30355":72387,"_5":30684,"_21010":122894,"_27589":122895,"_2954":122896},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3471":72395,"_30355":72387,"_5":30684,"_21010":122898,"_27589":122899,"_2954":120600},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3471":72396,"_30355":72387,"_5":30684,"_21010":122901,"_27589":122902,"_2954":122903},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3471":72397,"_30355":72387,"_5":30684,"_21010":122905,"_27589":122906,"_2954":122907},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3471":72398,"_30355":72387,"_5":30684,"_21010":122909,"_27589":122910,"_2954":122911},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3471":72399,"_30355":72387,"_21010":122913,"_5":14420,"_27589":72387,"_2954":122914},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3471":72400,"_30355":72387,"_21010":122916,"_5":14420,"_27589":122879,"_2954":122917},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3471":72401,"_30355":72387,"_21010":122919,"_5":14420,"_27589":122883,"_2954":122920},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3471":72402,"_30355":72387,"_21010":122922,"_5":14420,"_27589":122887,"_2954":122923},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3471":72403,"_30355":72387,"_21010":122925,"_5":14420,"_27589":122891,"_2954":122926},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3471":72404,"_30355":72387,"_21010":122928,"_5":14420,"_27589":122895,"_2954":122929},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3471":72405,"_30355":72387,"_21010":122931,"_5":14420,"_27589":122899,"_2954":122932},[],"Lamassu persiste cuatro estados X.509:",{"_3471":72406,"_30355":72387,"_21010":122934,"_5":14420,"_27589":122899,"_2954":122935},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3471":72407,"_30355":72387,"_21010":122937,"_5":14420,"_27589":122899,"_2954":122938},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3471":72408,"_30355":72387,"_21010":122940,"_5":14420,"_27589":122899,"_2954":122941},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3471":72409,"_30355":72387,"_21010":122943,"_5":14420,"_27589":122899,"_2954":122944},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3471":72410,"_30355":72387,"_21010":122946,"_5":14420,"_27589":122899,"_2954":122947},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3471":72411,"_30355":72387,"_21010":122949,"_5":14420,"_27589":122902,"_2954":122950},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3471":72412,"_30355":72387,"_21010":122952,"_5":14420,"_27589":122902,"_2954":122953},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3471":72413,"_30355":72387,"_21010":122955,"_5":14420,"_27589":122902,"_2954":122956},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3471":72414,"_30355":72387,"_21010":122958,"_5":14420,"_27589":122906,"_2954":122959},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3471":72415,"_30355":72387,"_21010":122961,"_5":14420,"_27589":122906,"_2954":122962},[],"Antes de confirmar:",{"_3471":72416,"_30355":72387,"_21010":122964,"_5":14420,"_27589":122906,"_2954":122965},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3471":72417,"_30355":72387,"_21010":122967,"_5":14420,"_27589":122906,"_2954":122968},[],"Distribuye la nueva cadena de confianza.",{"_3471":72418,"_30355":72387,"_21010":122970,"_5":14420,"_27589":122906,"_2954":122971},[],"Reemite las identidades necesarias.",{"_3471":72419,"_30355":72387,"_21010":122973,"_5":14420,"_27589":122906,"_2954":122974},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3471":72420,"_30355":72387,"_21010":122976,"_5":14420,"_27589":122906,"_2954":122977},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3471":72421,"_30355":72387,"_21010":122979,"_5":14420,"_27589":122906,"_2954":122980},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3471":72422,"_30355":72387,"_21010":122982,"_5":14420,"_27589":122910,"_2954":122983},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3471":72423,"_30355":72387,"_21010":122985,"_5":14420,"_27589":122910,"_2954":122986},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3471":72424,"_30355":72387,"_21010":122988,"_5":14420,"_27589":122910,"_2954":122989},[],"Cambios de estado y razones de revocación.",{"_3471":72425,"_30355":72387,"_21010":122991,"_5":14420,"_27589":122910,"_2954":122992},[],"Publicación y vigencia de OCSP y CRLs.",{"_3471":72426,"_30355":72387,"_21010":122994,"_5":14420,"_27589":122910,"_2954":122995},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3471":72427,"_30355":72387,"_21010":122997,"_5":14420,"_27589":122910,"_2954":122998},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3471":72428,"_30355":72428,"_5":14772,"_2954":123000,"_30687":123001,"_21010":123002,"_27589":72428},"Modelo de confianza",[49421,118099,54901,122868],[],{"_3471":72429,"_30355":72428,"_21010":123004,"_5":14420,"_27589":72428,"_2954":123005},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3471":72430,"_30355":72428,"_5":30684,"_21010":123007,"_27589":123008,"_2954":123009},[],"/docs/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3471":72431,"_30355":72428,"_5":30684,"_21010":123011,"_27589":123012,"_2954":123013},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3471":72432,"_30355":72428,"_5":30684,"_21010":123015,"_27589":123016,"_2954":123017},[],"/docs/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3471":72433,"_30355":72428,"_5":30684,"_21010":123019,"_27589":123020,"_2954":123021},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3471":72434,"_30355":72428,"_5":30684,"_21010":123023,"_27589":123024,"_2954":123025},[],"/docs/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3471":72435,"_30355":72428,"_5":30684,"_21010":123027,"_27589":123028,"_2954":123029},[],"/docs/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3471":72436,"_30355":72428,"_5":30684,"_21010":123031,"_27589":123032,"_2954":123033},[],"/docs/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3471":72437,"_30355":72428,"_5":30684,"_21010":123035,"_27589":123036,"_2954":123037},[],"/docs/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3471":72438,"_30355":72428,"_5":30684,"_21010":123039,"_27589":123040,"_2954":123041},[],"/docs/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3471":72439,"_30355":72428,"_5":30684,"_21010":123043,"_27589":123044,"_2954":123045},[],"/docs/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3471":72440,"_30355":72428,"_21010":123047,"_5":14420,"_27589":72428,"_2954":123048},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3471":72441,"_30355":72428,"_21010":123050,"_5":14420,"_27589":123012,"_2954":123051},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3471":72442,"_30355":72428,"_21010":123053,"_5":14420,"_27589":123016,"_2954":123054},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3471":72443,"_30355":72428,"_21010":123056,"_5":14420,"_27589":123020,"_2954":123057},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3471":72444,"_30355":72428,"_21010":123059,"_5":14420,"_27589":123024,"_2954":123060},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3471":72445,"_30355":72428,"_21010":123062,"_5":14420,"_27589":123028,"_2954":123063},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3471":72446,"_30355":72428,"_21010":123065,"_5":14420,"_27589":123028,"_2954":123066},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3471":72447,"_30355":72428,"_21010":123068,"_5":14420,"_27589":123028,"_2954":123069},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3471":72448,"_30355":72428,"_21010":123071,"_5":14420,"_27589":123028,"_2954":123072},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3471":72449,"_30355":72428,"_21010":123074,"_5":14420,"_27589":123028,"_2954":123075},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3471":72450,"_30355":72428,"_21010":123077,"_5":14420,"_27589":123028,"_2954":123078},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3471":72451,"_30355":72428,"_21010":123080,"_5":14420,"_27589":123032,"_2954":123081},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3471":72452,"_30355":72428,"_21010":123083,"_5":14420,"_27589":123032,"_2954":123084},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3471":72453,"_30355":72428,"_21010":123086,"_5":14420,"_27589":123032,"_2954":123087},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3471":72454,"_30355":72428,"_21010":123089,"_5":14420,"_27589":123032,"_2954":123090},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3471":72455,"_30355":72428,"_21010":123092,"_5":14420,"_27589":123032,"_2954":123093},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3471":72456,"_30355":72428,"_21010":123095,"_5":14420,"_27589":123036,"_2954":123096},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3471":72457,"_30355":72428,"_21010":123098,"_5":14420,"_27589":123036,"_2954":123099},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3471":72458,"_30355":72428,"_21010":123101,"_5":14420,"_27589":123036,"_2954":123102},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3471":72459,"_30355":72428,"_21010":123104,"_5":14420,"_27589":123036,"_2954":123105},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3471":72460,"_30355":72428,"_21010":123107,"_5":14420,"_27589":123036,"_2954":123108},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3471":72461,"_30355":72428,"_21010":123110,"_5":14420,"_27589":123036,"_2954":123111},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3471":72462,"_30355":72428,"_21010":123113,"_5":14420,"_27589":123036,"_2954":123114},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3471":72463,"_30355":72428,"_21010":123116,"_5":14420,"_27589":123040,"_2954":123117},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3471":72464,"_30355":72428,"_21010":123119,"_5":14420,"_27589":123044,"_2954":123120},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3471":72465,"_30355":72428,"_21010":123122,"_5":14420,"_27589":123044,"_2954":123123},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3471":72466,"_30355":72428,"_21010":123125,"_5":14420,"_27589":123044,"_2954":123126},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3471":72467,"_30355":72428,"_21010":123128,"_5":14420,"_27589":123044,"_2954":123129},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3471":72468,"_30355":72428,"_21010":123131,"_5":14420,"_27589":123044,"_2954":123132},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3471":72469,"_30355":72428,"_21010":123134,"_5":14420,"_27589":123044,"_2954":123135},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3471":72470,"_30355":72428,"_21010":123137,"_5":14420,"_27589":123044,"_2954":123138},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3471":72471,"_30355":72471,"_5":14772,"_2954":123140,"_30687":123141,"_21010":123142,"_27589":72471},"Listas de revocación (CRL)",[49421,118099,54901,122614],[],{"_3471":72472,"_30355":72471,"_21010":123144,"_5":14420,"_27589":72471,"_2954":123145},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3471":72473,"_30355":72471,"_5":30684,"_21010":123147,"_27589":123148,"_2954":123149},[],"/docs/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3471":72474,"_30355":72471,"_5":30684,"_21010":123151,"_27589":123152,"_2954":123153},[],"/docs/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3471":72475,"_30355":72471,"_5":30684,"_21010":123155,"_27589":123156,"_2954":123157},[],"/docs/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3471":72476,"_30355":72471,"_5":30684,"_21010":123159,"_27589":123160,"_2954":123161},[],"/docs/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3471":72477,"_30355":72471,"_5":30684,"_21010":123163,"_27589":123164,"_2954":123165},[],"/docs/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3471":72478,"_30355":72471,"_5":30684,"_21010":123167,"_27589":123168,"_2954":123169},[],"/docs/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3471":72479,"_30355":72471,"_5":30684,"_21010":123171,"_27589":123172,"_2954":123173},[],"/docs/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3471":72480,"_30355":72471,"_5":30684,"_21010":123175,"_27589":123176,"_2954":123177},[],"/docs/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3471":72481,"_30355":72471,"_5":30684,"_21010":123179,"_27589":123180,"_2954":123181},[],"/docs/es/platform/pki/crl#referencias","Referencias",{"_3471":72482,"_30355":72471,"_21010":123183,"_5":14420,"_27589":72471,"_2954":123184},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3471":72483,"_30355":72471,"_21010":123186,"_5":14420,"_27589":123148,"_2954":123187},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3471":72484,"_30355":72471,"_21010":123189,"_5":14420,"_27589":123148,"_2954":123190},[],"Campo",{"_3471":72485,"_30355":72471,"_21010":123192,"_5":14420,"_27589":123148,"_2954":119640},[],{"_3471":72486,"_30355":72471,"_21010":123194,"_5":14420,"_27589":123148,"_2954":56123},[],{"_3471":72487,"_30355":72471,"_21010":123196,"_5":14420,"_27589":123148,"_2954":123197},[],"ID de la CA a la que pertenecen los ajustes.",{"_3471":72488,"_30355":72471,"_21010":123199,"_5":14420,"_27589":123148,"_2954":56129},[],{"_3471":72489,"_30355":72471,"_21010":123201,"_5":14420,"_27589":123148,"_2954":123202},[],"Los ajustes `ACTIVE` generan CRLs. Los `ARCHIVED` pertenecen a una CA que ya no existe: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3471":72490,"_30355":72471,"_21010":123204,"_5":14420,"_27589":123148,"_2954":56135},[],{"_3471":72491,"_30355":72471,"_21010":123206,"_5":14420,"_27589":123148,"_2954":123207},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3471":72492,"_30355":72471,"_21010":123209,"_5":14420,"_27589":123148,"_2954":56141},[],{"_3471":72493,"_30355":72471,"_21010":123211,"_5":14420,"_27589":123148,"_2954":123212},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3471":72494,"_30355":72471,"_21010":123214,"_5":14420,"_27589":123148,"_2954":123215},[],"Campo de `crl_options`",{"_3471":72495,"_30355":72471,"_21010":123217,"_5":14420,"_27589":123148,"_2954":119640},[],{"_3471":72496,"_30355":72471,"_21010":123219,"_5":14420,"_27589":123148,"_2954":123220},[],"Valor inicial",{"_3471":72497,"_30355":72471,"_21010":123222,"_5":14420,"_27589":123148,"_2954":56155},[],{"_3471":72498,"_30355":72471,"_21010":123224,"_5":14420,"_27589":123148,"_2954":123225},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3471":72499,"_30355":72471,"_21010":123227,"_5":14420,"_27589":123148,"_2954":123228},[],"7 días.",{"_3471":72500,"_30355":72471,"_21010":123230,"_5":14420,"_27589":123148,"_2954":56164},[],{"_3471":72501,"_30355":72471,"_21010":123232,"_5":14420,"_27589":123148,"_2954":123233},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3471":72502,"_30355":72471,"_21010":123235,"_5":14420,"_27589":123148,"_2954":123236},[],"6 días y 23 horas.",{"_3471":72503,"_30355":72471,"_21010":123238,"_5":14420,"_27589":123148,"_2954":56173},[],{"_3471":72504,"_30355":72471,"_21010":123240,"_5":14420,"_27589":123148,"_2954":123241},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3471":72505,"_30355":72471,"_21010":123243,"_5":14420,"_27589":123148,"_2954":56179},[],{"_3471":72506,"_30355":72471,"_21010":123245,"_5":14420,"_27589":123148,"_2954":56182},[],{"_3471":72507,"_30355":72471,"_21010":123247,"_5":14420,"_27589":123148,"_2954":123248},[],"Número de serie del certificado existente que firma la CRL.",{"_3471":72508,"_30355":72471,"_21010":123250,"_5":14420,"_27589":123148,"_2954":123251},[],"Número de serie del certificado actual de la CA.",{"_3471":72509,"_30355":72471,"_21010":123253,"_5":14420,"_27589":123148,"_2954":123254},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3471":72510,"_30355":72471,"_21010":123256,"_5":14420,"_27589":123148,"_2954":123257},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3471":72511,"_30355":72471,"_21010":123259,"_5":14420,"_27589":123148,"_2954":123260},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3471":72512,"_30355":72471,"_21010":123262,"_5":14420,"_27589":123148,"_2954":123263},[],"Eliminar una CA conserva sus ajustes de CRL, que no pueden borrarse por API. Qué ocurre después depende de cuándo se eliminó la CA:",{"_3471":72513,"_30355":72471,"_21010":123265,"_5":14420,"_27589":123148,"_2954":123266},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3471":72514,"_30355":72471,"_21010":123268,"_5":14420,"_27589":123148,"_2954":123269},[],"Una CA eliminada con 4.0.0 en marcha deja ajustes `ACTIVE`. La última CRL sigue sirviéndose, pero una vez vencida nada la regenera: el trabajo de renovación registra `something went wrong while calculating CRL for CA <ca-id>` en cada ciclo porque ya no puede resolver la CA. Las opciones siguen editándose mientras el firmante no cambie; cambiarlo falla, porque ya no queda ninguna CA con la que coincidir.",{"_3471":72515,"_30355":72471,"_21010":123271,"_5":14420,"_27589":123148,"_2954":123272},[],"Ajusta validez y firmante antes de eliminar una CA.",{"_3471":72516,"_30355":72471,"_21010":123274,"_5":14420,"_27589":123148,"_2954":123275},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3471":72517,"_30355":72471,"_21010":123277,"_5":14420,"_27589":123148,"_2954":123278},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3471":72518,"_30355":72471,"_21010":123280,"_5":14420,"_27589":123148,"_2954":123281},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3471":72519,"_30355":72471,"_21010":123283,"_5":14420,"_27589":123152,"_2954":123284},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3471":72520,"_30355":72471,"_21010":123286,"_5":14420,"_27589":123152,"_2954":123287},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3471":72521,"_30355":72471,"_21010":123289,"_5":14420,"_27589":123152,"_2954":123290},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3471":72522,"_30355":72471,"_21010":123292,"_5":14420,"_27589":123152,"_2954":123293},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3471":72523,"_30355":72471,"_21010":123295,"_5":14420,"_27589":123156,"_2954":123296},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3471":72524,"_30355":72471,"_21010":123298,"_5":14420,"_27589":123156,"_2954":123299},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3471":72525,"_30355":72471,"_21010":123301,"_5":14420,"_27589":123156,"_2954":123302},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3471":72526,"_30355":72471,"_21010":123304,"_5":14420,"_27589":123156,"_2954":123305},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3471":72527,"_30355":72471,"_21010":123307,"_5":14420,"_27589":123156,"_2954":123308},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3471":72528,"_30355":72471,"_21010":123310,"_5":14420,"_27589":123156,"_2954":123311},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3471":72529,"_30355":72471,"_21010":123313,"_5":14420,"_27589":123156,"_2954":123314},[],"Los ajustes con `status` `ARCHIVED` se omiten: nada regenera su CRL.",{"_3471":72530,"_30355":72471,"_21010":123316,"_5":14420,"_27589":123156,"_2954":123317},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3471":72531,"_30355":72471,"_21010":123319,"_5":14420,"_27589":123156,"_2954":123320},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3471":72532,"_30355":72471,"_21010":123322,"_5":14420,"_27589":123160,"_2954":123323},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3471":72533,"_30355":72471,"_21010":123325,"_5":14420,"_27589":123160,"_2954":123326},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3471":72534,"_30355":72471,"_21010":123328,"_5":14420,"_27589":123164,"_2954":123329},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3471":72535,"_30355":72471,"_21010":123331,"_5":14420,"_27589":123164,"_2954":123332},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3471":72536,"_30355":72471,"_21010":123334,"_5":14420,"_27589":123164,"_2954":123335},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3471":72537,"_30355":72471,"_21010":123337,"_5":14420,"_27589":123164,"_2954":123338},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3471":72538,"_30355":72471,"_21010":123340,"_5":14420,"_27589":123164,"_2954":123341},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3471":72539,"_30355":72471,"_21010":123343,"_5":14420,"_27589":123168,"_2954":123344},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3471":72540,"_30355":72471,"_21010":123346,"_5":14420,"_27589":123168,"_2954":119829},[],{"_3471":72541,"_30355":72471,"_21010":123348,"_5":14420,"_27589":123168,"_2954":123349},[],"Path relativo",{"_3471":72542,"_30355":72471,"_21010":123351,"_5":14420,"_27589":123168,"_2954":117859},[],{"_3471":72543,"_30355":72471,"_21010":123353,"_5":14420,"_27589":123168,"_2954":56291},[],{"_3471":72544,"_30355":72471,"_21010":123355,"_5":14420,"_27589":123168,"_2954":56294},[],{"_3471":72545,"_30355":72471,"_21010":123357,"_5":14420,"_27589":123168,"_2954":123358},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3471":72546,"_30355":72471,"_21010":123360,"_5":14420,"_27589":123168,"_2954":56291},[],{"_3471":72547,"_30355":72471,"_21010":123362,"_5":14420,"_27589":123168,"_2954":56302},[],{"_3471":72548,"_30355":72471,"_21010":123364,"_5":14420,"_27589":123168,"_2954":123365},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3471":72549,"_30355":72471,"_21010":123367,"_5":14420,"_27589":123168,"_2954":56308},[],{"_3471":72550,"_30355":72471,"_21010":123369,"_5":14420,"_27589":123168,"_2954":56302},[],{"_3471":72551,"_30355":72471,"_21010":123371,"_5":14420,"_27589":123168,"_2954":123372},[],"Sustituir la configuración de CRL de una CA.",{"_3471":72552,"_30355":72471,"_21010":123374,"_5":14420,"_27589":123168,"_2954":123375},[],"Necesitas autenticación y permisos de lectura o actualización de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3471":72553,"_30355":72471,"_21010":123377,"_5":14420,"_27589":123168,"_2954":123378},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3471":72554,"_30355":72471,"_21010":123380,"_5":14420,"_27589":123172,"_2954":123381},[],"Síntoma",{"_3471":72555,"_30355":72471,"_21010":123383,"_5":14420,"_27589":123172,"_2954":123384},[],"Causa",{"_3471":72556,"_30355":72471,"_21010":123386,"_5":14420,"_27589":123172,"_2954":123387},[],"Acción",{"_3471":72557,"_30355":72471,"_21010":123389,"_5":14420,"_27589":123172,"_2954":123390},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3471":72558,"_30355":72471,"_21010":123392,"_5":14420,"_27589":123172,"_2954":123393},[],"Los ajustes no están `ACTIVE`: la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3471":72559,"_30355":72471,"_21010":123395,"_5":14420,"_27589":123172,"_2954":123396},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3471":72560,"_30355":72471,"_21010":123398,"_5":14420,"_27589":123172,"_2954":123399},[],"`PUT` devuelve 400.",{"_3471":72561,"_30355":72471,"_21010":123401,"_5":14420,"_27589":123172,"_2954":123402},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3471":72562,"_30355":72471,"_21010":123404,"_5":14420,"_27589":123172,"_2954":123405},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3471":72563,"_30355":72471,"_21010":123407,"_5":14420,"_27589":123172,"_2954":123408},[],"`PUT` devuelve 404.",{"_3471":72564,"_30355":72471,"_21010":123410,"_5":14420,"_27589":123172,"_2954":123411},[],"La CA o el certificado firmante nuevo no existen (por ejemplo, la CA se eliminó), o la CA no tiene ajustes de CRL (por ejemplo, una CA importada).",{"_3471":72565,"_30355":72471,"_21010":123413,"_5":14420,"_27589":123172,"_2954":123414},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3471":72566,"_30355":72471,"_21010":123416,"_5":14420,"_27589":123172,"_2954":123417},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3471":72567,"_30355":72471,"_21010":123419,"_5":14420,"_27589":123172,"_2954":123420},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3471":72568,"_30355":72471,"_21010":123422,"_5":14420,"_27589":123172,"_2954":123423},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3471":72569,"_30355":72471,"_21010":123425,"_5":14420,"_27589":123172,"_2954":123426},[],"La CRL no cambia tras revocar un certificado.",{"_3471":72570,"_30355":72471,"_21010":123428,"_5":14420,"_27589":123172,"_2954":123429},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3471":72571,"_30355":72471,"_21010":123431,"_5":14420,"_27589":123172,"_2954":123432},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3471":72572,"_30355":72471,"_21010":123434,"_5":14420,"_27589":123172,"_2954":123435},[],"Un verificador rechaza la CRL por el emisor.",{"_3471":72573,"_30355":72471,"_21010":123437,"_5":14420,"_27589":123172,"_2954":123438},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3471":72574,"_30355":72471,"_21010":123440,"_5":14420,"_27589":123172,"_2954":123441},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3471":72575,"_30355":72471,"_21010":123443,"_5":14420,"_27589":123176,"_2954":123444},[],"Los ajustes de CRL de una CA se editan en la pestaña **Validation Authority** de la vista de la CA y en la página **Verification Authorities** de la consola. Ambos los leen y actualizan por ID de CA en `/v1/crl-settings/{ca-id}`, que requiere un backend 4.0.0.",{"_3471":72576,"_30355":72471,"_21010":123446,"_5":14420,"_27589":123176,"_2954":123447},[],"Si el backend aún no tiene ajustes para una CA, la pestaña muestra un panel **No CRL Settings** que indica que los ajustes de CRL se crean junto con la CA y que, si la CA se acaba de crear, pueden seguir inicializándose, con un botón **Retry**. Mientras cargan los ajustes, muestra &#x2A;*Loading CRL Settings...**; si falla la consulta, muestra **Error Loading CRL Settings**, también con un botón **Retry**. La fila 404 de Errores frecuentes de los ajustes de CRL enumera cuándo puede una CA no tener ajustes.",{"_3471":72577,"_30355":72471,"_21010":123449,"_5":14420,"_27589":123176,"_2954":123450},[],"Los ajustes cuya CA se eliminó antes de la actualización a 4.0.0 quedan `ARCHIVED`: la interfaz los muestra en solo lectura dentro de un aviso de advertencia, y la página Verification Authorities marca la CA con la insignia **Archived**. Su última CRL sigue sirviéndose, pero nunca se regenera, y los ajustes no pueden editarse — consulta Casos en los que los ajustes dejan de poder editarse. Los ajustes migrados del modelo indexado por SKI muestran una nota con su URL de CRL heredada `/crl/<legacy-ski>`, que sigue resolviendo a la lista de esta CA.",{"_3471":72578,"_30355":72471,"_21010":123452,"_5":14420,"_27589":123176,"_2954":123453},[],"El campo **CRL Refresh Interval** acepta `0`. Entonces un aviso informativo explica que no se genera una CRL nueva solo porque pase el tiempo — una se genera únicamente poco antes de que venza la actual — y, con **Regenerate CRL Immediately on Revocation** desactivado, que las revocaciones no se publican hasta entonces. El resumen de la página Verification Authorities muestra **Disabled** para un intervalo de renovación de `0`; la semántica está descrita en Regeneración periódica y automática. El campo **CRL Max Validity / Cache Duration** sigue exigiendo una duración positiva y rechaza `0`.",{"_3471":72579,"_30355":72471,"_21010":123455,"_5":14420,"_27589":123176,"_2954":123456},[],"La edición es tolerante: un campo muestra su error solo cuando lo abandonas. **Save CRL Settings** siempre está activado; si al guardar hay campos no válidos, la interfaz los marca todos, muestra los errores y enfoca el primero no válido en lugar de dejar desactivado el botón.",{"_3471":72580,"_30355":72471,"_21010":123458,"_5":14420,"_27589":123176,"_2954":123459},[],"El firmante seleccionado aparece como una tarjeta con su emisor (el DN completo en un tooltip que se abre al pasar el ratón y al enfocar con el teclado, y cuyo nombre enlaza a su CA cuando existe su registro), su fecha de vencimiento, su algoritmo de clave, sus chips de usos y su número de serie, bajo el pie **CRL signer — Signs the CRLs of this CA**. El selector de certificados solo ofrece certificados que tienen clave privada y el uso de clave `cRLSign`. Si el certificado de un firmante configurado no puede resolverse, la interfaz muestra `Unknown Certificate (Serial: X)` o `Certificate details unavailable (Serial: X)`.",{"_3471":72581,"_30355":72471,"_21010":123461,"_5":14420,"_27589":123176,"_2954":123462},[],"La vista de la CA permite inspeccionar y descargar la lista disponible; el fichero descargado se llama `<ca-id>.crl`. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3471":72582,"_30355":72471,"_21010":123464,"_5":14420,"_27589":123180,"_2954":123465},[],"RFC 5280: perfil X.509 y CRL.",{"_3471":72583,"_30355":72471,"_21010":123467,"_5":14420,"_27589":123180,"_2954":56409},[],{"_3471":72584,"_30355":72471,"_21010":123469,"_5":14420,"_27589":123180,"_2954":56412},[],{"_3471":72585,"_30355":72471,"_21010":123471,"_5":14420,"_27589":123180,"_2954":123472},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3471":72586,"_30355":72471,"_21010":123474,"_5":14420,"_27589":123180,"_2954":123475},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3471":72587,"_30355":72587,"_5":14772,"_2954":123477,"_30687":123478,"_21010":123479,"_27589":72587},"Claves y motores criptográficos",[49421,118099,54901,121977],[],{"_3471":72588,"_30355":72587,"_21010":123481,"_5":14420,"_27589":72587,"_2954":123482},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3471":72589,"_30355":72587,"_5":30684,"_21010":123484,"_27589":123485,"_2954":123486},[],"/docs/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3471":72590,"_30355":72587,"_5":30684,"_21010":123488,"_27589":123489,"_2954":123490},[],"/docs/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3471":72591,"_30355":72587,"_5":30684,"_21010":123492,"_27589":123493,"_2954":56437},[],"/docs/es/platform/pki/key-management#file-system",{"_3471":72592,"_30355":72587,"_5":30684,"_21010":123495,"_27589":123496,"_2954":56441},[],"/docs/es/platform/pki/key-management#hashicorp-vault",{"_3471":72593,"_30355":72587,"_5":30684,"_21010":123498,"_27589":123499,"_2954":56445},[],"/docs/es/platform/pki/key-management#aws-secrets-manager",{"_3471":72594,"_30355":72587,"_5":30684,"_21010":123501,"_27589":123502,"_2954":56449},[],"/docs/es/platform/pki/key-management#aws-kms",{"_3471":72595,"_30355":72587,"_5":30684,"_21010":123504,"_27589":123505,"_2954":56453},[],"/docs/es/platform/pki/key-management#pkcs11",{"_3471":72596,"_30355":72587,"_5":30684,"_21010":123507,"_27589":123508,"_2954":56457},[],"/docs/es/platform/pki/key-management#azure-key-vault",{"_3471":72597,"_30355":72587,"_5":30684,"_21010":123510,"_27589":123511,"_2954":123512},[],"/docs/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3471":72598,"_30355":72587,"_5":30684,"_21010":123514,"_27589":123515,"_2954":123516},[],"/docs/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3471":72599,"_30355":72587,"_5":30684,"_21010":123518,"_27589":123519,"_2954":123520},[],"/docs/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3471":72600,"_30355":72587,"_5":30684,"_21010":123522,"_27589":123523,"_2954":123524},[],"/docs/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3471":72601,"_30355":72587,"_5":30684,"_21010":123526,"_27589":123527,"_2954":123528},[],"/docs/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3471":72602,"_30355":72587,"_5":30684,"_21010":123530,"_27589":123531,"_2954":123532},[],"/docs/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3471":72603,"_30355":72587,"_5":30684,"_21010":123534,"_27589":123535,"_2954":123536},[],"/docs/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3471":72604,"_30355":72587,"_5":30684,"_21010":123538,"_27589":123539,"_2954":56489},[],"/docs/es/platform/pki/key-management#sign",{"_3471":72605,"_30355":72587,"_5":30684,"_21010":123541,"_27589":123542,"_2954":56493},[],"/docs/es/platform/pki/key-management#verify",{"_3471":72606,"_30355":72587,"_5":30684,"_21010":123544,"_27589":123545,"_2954":123546},[],"/docs/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3471":72607,"_30355":72587,"_5":30684,"_21010":123548,"_27589":123549,"_2954":123550},[],"/docs/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3471":72608,"_30355":72587,"_5":30684,"_21010":123552,"_27589":123553,"_2954":123554},[],"/docs/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3471":72609,"_30355":72587,"_21010":123556,"_5":14420,"_27589":72587,"_2954":123557},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3471":72610,"_30355":72587,"_21010":123559,"_5":14420,"_27589":72587,"_2954":123560},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3471":72611,"_30355":72587,"_21010":123562,"_5":14420,"_27589":123485,"_2954":123563},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3471":72612,"_30355":72587,"_21010":123565,"_5":14420,"_27589":123485,"_2954":123566},[],"En la práctica, permite:",{"_3471":72613,"_30355":72587,"_21010":123568,"_5":14420,"_27589":123485,"_2954":123569},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3471":72614,"_30355":72587,"_21010":123571,"_5":14420,"_27589":123485,"_2954":123572},[],"Importar claves creadas externamente.",{"_3471":72615,"_30355":72587,"_21010":123574,"_5":14420,"_27589":123485,"_2954":123575},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3471":72616,"_30355":72587,"_21010":123577,"_5":14420,"_27589":123485,"_2954":123578},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3471":72617,"_30355":72587,"_21010":123580,"_5":14420,"_27589":123489,"_2954":123581},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3471":72618,"_30355":72587,"_21010":123583,"_5":14420,"_27589":123489,"_2954":123584},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3471":72619,"_30355":72587,"_21010":123586,"_5":14420,"_27589":123489,"_2954":123587},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3471":72620,"_30355":72587,"_21010":123589,"_5":14420,"_27589":123493,"_2954":123590},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3471":72621,"_30355":72587,"_21010":123592,"_5":14420,"_27589":123496,"_2954":123593},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3471":72622,"_30355":72587,"_21010":123595,"_5":14420,"_27589":123496,"_2954":123596},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3471":72623,"_30355":72587,"_21010":123598,"_5":14420,"_27589":123499,"_2954":123599},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3471":72624,"_30355":72587,"_21010":123601,"_5":14420,"_27589":123502,"_2954":123602},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3471":72625,"_30355":72587,"_21010":123604,"_5":14420,"_27589":123505,"_2954":123605},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3471":72626,"_30355":72587,"_21010":123607,"_5":14420,"_27589":123508,"_2954":123608},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3471":72627,"_30355":72587,"_21010":123610,"_5":14420,"_27589":123508,"_2954":123611},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3471":72628,"_30355":72587,"_21010":123613,"_5":14420,"_27589":123508,"_2954":123614},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3471":72629,"_30355":72587,"_21010":123616,"_5":14420,"_27589":123508,"_2954":123617},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3471":72630,"_30355":72587,"_21010":123619,"_5":14420,"_27589":123511,"_2954":123620},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3471":72631,"_30355":72587,"_21010":123622,"_5":14420,"_27589":123511,"_2954":123623},[],"La tabla incluye los siguientes campos:",{"_3471":72632,"_30355":72587,"_21010":123625,"_5":14420,"_27589":123511,"_2954":123626},[],"**Name**: nombre descriptivo de la clave.",{"_3471":72633,"_30355":72587,"_21010":123628,"_5":14420,"_27589":123511,"_2954":123629},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3471":72634,"_30355":72587,"_21010":123631,"_5":14420,"_27589":123511,"_2954":123632},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3471":72635,"_30355":72587,"_21010":123634,"_5":14420,"_27589":123511,"_2954":123635},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3471":72636,"_30355":72587,"_21010":123637,"_5":14420,"_27589":123511,"_2954":123638},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3471":72637,"_30355":72587,"_21010":123640,"_5":14420,"_27589":123511,"_2954":123641},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3471":72638,"_30355":72587,"_21010":123643,"_5":14420,"_27589":123511,"_2954":123644},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3471":72639,"_30355":72587,"_21010":123646,"_5":14420,"_27589":123511,"_2954":123647},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3471":72640,"_30355":72587,"_21010":123649,"_5":14420,"_27589":123511,"_2954":123650},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3471":72641,"_30355":72587,"_21010":123652,"_5":14420,"_27589":123511,"_2954":123653},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3471":72642,"_30355":72587,"_21010":123655,"_5":14420,"_27589":123511,"_2954":123656},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3471":72643,"_30355":72587,"_21010":123658,"_5":14420,"_27589":123511,"_2954":123659},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3471":72644,"_30355":72587,"_21010":123661,"_5":14420,"_27589":123511,"_2954":123662},[],"**Delete Key** para eliminar la clave del sistema.",{"_3471":72645,"_30355":72587,"_21010":123664,"_5":14420,"_27589":123515,"_2954":123665},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3471":72646,"_30355":72587,"_21010":123667,"_5":14420,"_27589":123519,"_2954":123668},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3471":72647,"_30355":72587,"_21010":123670,"_5":14420,"_27589":123519,"_2954":123671},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3471":72648,"_30355":72587,"_21010":123673,"_5":14420,"_27589":123519,"_2954":123674},[],"**Key Name**: nombre único y descriptivo.",{"_3471":72649,"_30355":72587,"_21010":123676,"_5":14420,"_27589":123519,"_2954":123677},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3471":72650,"_30355":72587,"_21010":123679,"_5":14420,"_27589":123519,"_2954":123680},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3471":72651,"_30355":72587,"_21010":123682,"_5":14420,"_27589":123519,"_2954":123683},[],"**Tags**: metadatos para clasificar la clave.",{"_3471":72652,"_30355":72587,"_21010":123685,"_5":14420,"_27589":123519,"_2954":123686},[],"**Metadata**: información adicional para usos avanzados.",{"_3471":72653,"_30355":72587,"_21010":123688,"_5":14420,"_27589":123523,"_2954":123689},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3471":72654,"_30355":72587,"_21010":123691,"_5":14420,"_27589":123523,"_2954":123692},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3471":72655,"_30355":72587,"_21010":123694,"_5":14420,"_27589":123523,"_2954":123695},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3471":72656,"_30355":72587,"_21010":123697,"_5":14420,"_27589":123523,"_2954":123698},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3471":72657,"_30355":72587,"_21010":123700,"_5":14420,"_27589":123523,"_2954":123701},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3471":72658,"_30355":72587,"_21010":123703,"_5":14420,"_27589":123523,"_2954":123704},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3471":72659,"_30355":72587,"_21010":123706,"_5":14420,"_27589":123523,"_2954":123707},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3471":72660,"_30355":72587,"_21010":123709,"_5":14420,"_27589":123523,"_2954":123710},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3471":72661,"_30355":72587,"_21010":123712,"_5":14420,"_27589":123523,"_2954":123713},[],"**Metadata**: información adicional opcional.",{"_3471":72662,"_30355":72587,"_21010":123715,"_5":14420,"_27589":123523,"_2954":123716},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3471":72663,"_30355":72587,"_21010":123718,"_5":14420,"_27589":123523,"_2954":123719},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3471":72664,"_30355":72587,"_21010":123721,"_5":14420,"_27589":123527,"_2954":123722},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3471":72665,"_30355":72587,"_21010":123724,"_5":14420,"_27589":123531,"_2954":123725},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3471":72666,"_30355":72587,"_21010":123727,"_5":14420,"_27589":123531,"_2954":123728},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3471":72667,"_30355":72587,"_21010":123730,"_5":14420,"_27589":123531,"_2954":123731},[],"**Key Name**: nombre descriptivo.",{"_3471":72668,"_30355":72587,"_21010":123733,"_5":14420,"_27589":123531,"_2954":123734},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3471":72669,"_30355":72587,"_21010":123736,"_5":14420,"_27589":123531,"_2954":123737},[],"**Tags**: etiquetas asociadas.",{"_3471":72670,"_30355":72587,"_21010":123739,"_5":14420,"_27589":123531,"_2954":123740},[],"**Aliases**: nombres alternativos.",{"_3471":72671,"_30355":72587,"_21010":123742,"_5":14420,"_27589":123531,"_2954":123743},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3471":72672,"_30355":72587,"_21010":123745,"_5":14420,"_27589":123531,"_2954":123746},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3471":72673,"_30355":72587,"_21010":123748,"_5":14420,"_27589":123531,"_2954":123749},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3471":72674,"_30355":72587,"_21010":123751,"_5":14420,"_27589":123531,"_2954":123752},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3471":72675,"_30355":72587,"_21010":123754,"_5":14420,"_27589":123535,"_2954":123755},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3471":72676,"_30355":72587,"_21010":123757,"_5":14420,"_27589":123535,"_2954":123758},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3471":72677,"_30355":72587,"_21010":123760,"_5":14420,"_27589":123535,"_2954":123761},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3471":72678,"_30355":72587,"_21010":123763,"_5":14420,"_27589":123539,"_2954":123764},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3471":72679,"_30355":72587,"_21010":123766,"_5":14420,"_27589":123539,"_2954":123767},[],"Campos principales:",{"_3471":72680,"_30355":72587,"_21010":123769,"_5":14420,"_27589":123539,"_2954":123770},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3471":72681,"_30355":72587,"_21010":123772,"_5":14420,"_27589":123539,"_2954":123773},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3471":72682,"_30355":72587,"_21010":123775,"_5":14420,"_27589":123539,"_2954":123776},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3471":72683,"_30355":72587,"_21010":123778,"_5":14420,"_27589":123539,"_2954":123779},[],"**Message**: contenido que se va a firmar.",{"_3471":72684,"_30355":72587,"_21010":123781,"_5":14420,"_27589":123539,"_2954":123782},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3471":72685,"_30355":72587,"_21010":123784,"_5":14420,"_27589":123542,"_2954":123785},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3471":72686,"_30355":72587,"_21010":123787,"_5":14420,"_27589":123542,"_2954":123767},[],{"_3471":72687,"_30355":72587,"_21010":123789,"_5":14420,"_27589":123542,"_2954":123790},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3471":72688,"_30355":72587,"_21010":123792,"_5":14420,"_27589":123542,"_2954":123793},[],"**Message Type**: `Raw` o `Digest`.",{"_3471":72689,"_30355":72587,"_21010":123795,"_5":14420,"_27589":123542,"_2954":123796},[],"**Payload Encoding**: codificación del mensaje.",{"_3471":72690,"_30355":72587,"_21010":123798,"_5":14420,"_27589":123542,"_2954":123799},[],"**Message**: mensaje original o hash.",{"_3471":72691,"_30355":72587,"_21010":123801,"_5":14420,"_27589":123542,"_2954":123802},[],"**Signature**: firma que se desea comprobar.",{"_3471":72692,"_30355":72587,"_21010":123804,"_5":14420,"_27589":123542,"_2954":123805},[],"**Result**: indicador del resultado de la validación.",{"_3471":72693,"_30355":72587,"_21010":123807,"_5":14420,"_27589":123545,"_2954":123808},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3471":72694,"_30355":72587,"_21010":123810,"_5":14420,"_27589":123545,"_2954":123811},[],"Este flujo es útil para:",{"_3471":72695,"_30355":72587,"_21010":123813,"_5":14420,"_27589":123545,"_2954":123814},[],"Solicitar certificados a una CA externa.",{"_3471":72696,"_30355":72587,"_21010":123816,"_5":14420,"_27589":123545,"_2954":123817},[],"Renovar una identidad manteniendo la misma clave.",{"_3471":72697,"_30355":72587,"_21010":123819,"_5":14420,"_27589":123545,"_2954":123820},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3471":72698,"_30355":72587,"_21010":123822,"_5":14420,"_27589":123545,"_2954":123823},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3471":72699,"_30355":72587,"_21010":123825,"_5":14420,"_27589":123545,"_2954":123826},[],"**Organization (O)**: organización o empresa.",{"_3471":72700,"_30355":72587,"_21010":123828,"_5":14420,"_27589":123545,"_2954":123829},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3471":72701,"_30355":72587,"_21010":123831,"_5":14420,"_27589":123545,"_2954":123832},[],"**Country (C)**: código de país de dos letras.",{"_3471":72702,"_30355":72587,"_21010":123834,"_5":14420,"_27589":123545,"_2954":123835},[],"**State / Province (ST)**: estado o provincia.",{"_3471":72703,"_30355":72587,"_21010":123837,"_5":14420,"_27589":123545,"_2954":123838},[],"**Locality (L)**: ciudad o localidad.",{"_3471":72704,"_30355":72587,"_21010":123840,"_5":14420,"_27589":123545,"_2954":123841},[],"**Email Address**: correo de contacto.",{"_3471":72705,"_30355":72587,"_21010":123843,"_5":14420,"_27589":123545,"_2954":123844},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3471":72706,"_30355":72587,"_21010":123846,"_5":14420,"_27589":123545,"_2954":123847},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3471":72707,"_30355":72587,"_21010":123849,"_5":14420,"_27589":123549,"_2954":123850},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3471":72708,"_30355":72587,"_21010":123852,"_5":14420,"_27589":123549,"_2954":123853},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3471":72709,"_30355":72587,"_21010":123855,"_5":14420,"_27589":123553,"_2954":123856},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3471":72710,"_30355":72587,"_21010":123858,"_5":14420,"_27589":123553,"_2954":123859},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3471":72711,"_30355":72711,"_5":14772,"_2954":123861,"_30687":123862,"_21010":123863,"_27589":72711},"Validación online con OCSP",[49421,118099,54901,122614],[],{"_3471":72712,"_30355":72711,"_21010":123865,"_5":14420,"_27589":72711,"_2954":123866},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3471":72713,"_30355":72711,"_5":30684,"_21010":123868,"_27589":123869,"_2954":123870},[],"/docs/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3471":72714,"_30355":72711,"_5":30684,"_21010":123872,"_27589":123873,"_2954":123874},[],"/docs/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3471":72715,"_30355":72711,"_5":30684,"_21010":123876,"_27589":123877,"_2954":123878},[],"/docs/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3471":72716,"_30355":72711,"_5":30684,"_21010":123880,"_27589":123881,"_2954":123882},[],"/docs/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3471":72717,"_30355":72711,"_5":30684,"_21010":123884,"_27589":123885,"_2954":123886},[],"/docs/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3471":72718,"_30355":72711,"_5":30684,"_21010":123888,"_27589":123889,"_2954":123181},[],"/docs/es/platform/pki/ocsp#referencias",{"_3471":72719,"_30355":72711,"_21010":123891,"_5":14420,"_27589":72711,"_2954":123892},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3471":72720,"_30355":72711,"_21010":123894,"_5":14420,"_27589":123869,"_2954":123895},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3471":72721,"_30355":72711,"_21010":123897,"_5":14420,"_27589":123869,"_2954":123898},[],"Estado del registro",{"_3471":72722,"_30355":72711,"_21010":123900,"_5":14420,"_27589":123869,"_2954":123901},[],"Respuesta firmada",{"_3471":72723,"_30355":72711,"_21010":123903,"_5":14420,"_27589":123869,"_2954":54038},[],{"_3471":72724,"_30355":72711,"_21010":123905,"_5":14420,"_27589":123869,"_2954":56857},[],{"_3471":72725,"_30355":72711,"_21010":123907,"_5":14420,"_27589":123869,"_2954":54055},[],{"_3471":72726,"_30355":72711,"_21010":123909,"_5":14420,"_27589":123869,"_2954":123910},[],"`Revoked`, con razón y fecha de revocación.",{"_3471":72727,"_30355":72711,"_21010":123912,"_5":14420,"_27589":123869,"_2954":123913},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3471":72728,"_30355":72711,"_21010":123915,"_5":14420,"_27589":123869,"_2954":123916},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3471":72729,"_30355":72711,"_21010":123918,"_5":14420,"_27589":123869,"_2954":123919},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3471":72730,"_30355":72711,"_21010":123921,"_5":14420,"_27589":123869,"_2954":123922},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3471":72731,"_30355":72711,"_21010":123924,"_5":14420,"_27589":123869,"_2954":123925},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3471":72732,"_30355":72711,"_21010":123927,"_5":14420,"_27589":123873,"_2954":123928},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3471":72733,"_30355":72711,"_21010":123930,"_5":14420,"_27589":123873,"_2954":123931},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3471":72734,"_30355":72711,"_21010":123933,"_5":14420,"_27589":123877,"_2954":123934},[],"El servicio acepta:",{"_3471":72735,"_30355":72711,"_21010":123936,"_5":14420,"_27589":123877,"_2954":119829},[],{"_3471":72736,"_30355":72711,"_21010":123938,"_5":14420,"_27589":123877,"_2954":123939},[],"Ruta del servicio VA",{"_3471":72737,"_30355":72711,"_21010":123941,"_5":14420,"_27589":123877,"_2954":123942},[],"Formato",{"_3471":72738,"_30355":72711,"_21010":123944,"_5":14420,"_27589":123877,"_2954":56897},[],{"_3471":72739,"_30355":72711,"_21010":123946,"_5":14420,"_27589":123877,"_2954":56900},[],{"_3471":72740,"_30355":72711,"_21010":123948,"_5":14420,"_27589":123877,"_2954":123949},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3471":72741,"_30355":72711,"_21010":123951,"_5":14420,"_27589":123877,"_2954":56291},[],{"_3471":72742,"_30355":72711,"_21010":123953,"_5":14420,"_27589":123877,"_2954":56908},[],{"_3471":72743,"_30355":72711,"_21010":123955,"_5":14420,"_27589":123877,"_2954":123956},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3471":72744,"_30355":72711,"_21010":123958,"_5":14420,"_27589":123877,"_2954":123959},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3471":72745,"_30355":72711,"_21010":123961,"_5":14420,"_27589":123881,"_2954":123962},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3471":72746,"_30355":72711,"_21010":123964,"_5":14420,"_27589":123881,"_2954":123965},[],"Genera la solicitud:",{"_3471":72747,"_30355":72711,"_21010":123967,"_5":14420,"_27589":123881,"_2954":123968},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3471":72748,"_30355":72711,"_21010":123970,"_5":14420,"_27589":123881,"_2954":123971},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3471":72749,"_30355":72711,"_21010":123973,"_5":14420,"_27589":123881,"_2954":123974},[],"Verifica el DER recibido:",{"_3471":72750,"_30355":72711,"_21010":123976,"_5":14420,"_27589":123881,"_2954":123977},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3471":72751,"_30355":72711,"_21010":123979,"_5":14420,"_27589":123885,"_2954":123980},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3471":72752,"_30355":72711,"_21010":123982,"_5":14420,"_27589":123885,"_2954":123983},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3471":72753,"_30355":72711,"_21010":123985,"_5":14420,"_27589":123889,"_2954":56941},[],{"_3471":72754,"_30355":72711,"_21010":123987,"_5":14420,"_27589":123889,"_2954":56944},[],{"_3471":72755,"_30355":72711,"_21010":123989,"_5":14420,"_27589":123889,"_2954":123990},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3471":72756,"_30355":72711,"_21010":123992,"_5":14420,"_27589":123889,"_2954":123475},[],{"_3471":72757,"_30355":72757,"_5":14772,"_2954":54901,"_30687":123994,"_21010":123995,"_27589":72757},[49421,118099,54901],[],{"_3471":72758,"_30355":72757,"_21010":123997,"_5":14420,"_27589":72757,"_2954":123998},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3471":72759,"_30355":72757,"_5":30684,"_21010":124000,"_27589":124001,"_2954":121303},[],"/docs/es/platform/pki/overview#empieza-aquí",{"_3471":72760,"_30355":72757,"_5":30684,"_21010":124003,"_27589":124004,"_2954":124005},[],"/docs/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3471":72761,"_30355":72757,"_5":30684,"_21010":124007,"_27589":124008,"_2954":121823},[],"/docs/es/platform/pki/overview#capacidades-principales",{"_3471":72762,"_30355":72757,"_5":30684,"_21010":124010,"_27589":124011,"_2954":121827},[],"/docs/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3471":72763,"_30355":72757,"_5":30684,"_21010":124013,"_27589":124014,"_2954":121831},[],"/docs/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3471":72764,"_30355":72757,"_5":30684,"_21010":124016,"_27589":124017,"_2954":121835},[],"/docs/es/platform/pki/overview#emite-y-controla-certificados",{"_3471":72765,"_30355":72757,"_5":30684,"_21010":124019,"_27589":124020,"_2954":121843},[],"/docs/es/platform/pki/overview#publica-el-estado-de-validación",{"_3471":72766,"_30355":72757,"_5":30684,"_21010":124022,"_27589":124023,"_2954":124024},[],"/docs/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3471":72767,"_30355":72757,"_5":30684,"_21010":124026,"_27589":124027,"_2954":122780},[],"/docs/es/platform/pki/overview#continúa",{"_3471":72768,"_30355":72757,"_21010":124029,"_5":14420,"_27589":72757,"_2954":124030},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3471":72769,"_30355":72757,"_21010":124032,"_5":14420,"_27589":124001,"_2954":124033},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3471":72770,"_30355":72757,"_21010":124035,"_5":14420,"_27589":124001,"_2954":124036},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3471":72771,"_30355":72757,"_21010":124038,"_5":14420,"_27589":124004,"_2954":124039},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3471":72772,"_30355":72757,"_21010":124041,"_5":14420,"_27589":124004,"_2954":124042},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3471":72773,"_30355":72757,"_21010":124044,"_5":14420,"_27589":124004,"_2954":124045},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3471":72774,"_30355":72757,"_21010":124047,"_5":14420,"_27589":124004,"_2954":124048},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3471":72775,"_30355":72757,"_21010":124050,"_5":14420,"_27589":124004,"_2954":124051},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3471":72776,"_30355":72757,"_21010":124053,"_5":14420,"_27589":124011,"_2954":124054},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3471":72777,"_30355":72757,"_21010":124056,"_5":14420,"_27589":124014,"_2954":124057},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3471":72778,"_30355":72757,"_21010":124059,"_5":14420,"_27589":124017,"_2954":124060},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3471":72779,"_30355":72757,"_21010":124062,"_5":14420,"_27589":124020,"_2954":124063},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3471":72780,"_30355":72757,"_21010":124065,"_5":14420,"_27589":124023,"_2954":124066},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3471":72781,"_30355":72757,"_21010":124068,"_5":14420,"_27589":124023,"_2954":124069},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3471":72782,"_30355":72757,"_21010":124071,"_5":14420,"_27589":124023,"_2954":124072},[],"su clave pública corresponda a la clave privada del cliente;",{"_3471":72783,"_30355":72757,"_21010":124074,"_5":14420,"_27589":124023,"_2954":124075},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3471":72784,"_30355":72757,"_21010":124077,"_5":14420,"_27589":124023,"_2954":124078},[],"sus fechas y usos permitan la operación;",{"_3471":72785,"_30355":72757,"_21010":124080,"_5":14420,"_27589":124023,"_2954":124081},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3471":72786,"_30355":72757,"_21010":124083,"_5":14420,"_27589":124023,"_2954":124084},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3471":72787,"_30355":72757,"_21010":124086,"_5":14420,"_27589":124027,"_2954":124087},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3471":72788,"_30355":72757,"_21010":124089,"_5":14420,"_27589":124027,"_2954":124090},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3471":72789,"_30355":72757,"_21010":124092,"_5":14420,"_27589":124027,"_2954":124093},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3471":72790,"_30355":72790,"_5":14772,"_2954":124095,"_30687":124096,"_21010":124097,"_27589":72790},"Crea tu primera CA",[49421,118099,54901,121427],[],{"_3471":72791,"_30355":72790,"_21010":124099,"_5":14420,"_27589":72790,"_2954":124100},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3471":72792,"_30355":72790,"_5":30684,"_21010":124102,"_27589":124103,"_2954":116670},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3471":72793,"_30355":72790,"_5":30684,"_21010":124105,"_27589":124106,"_2954":124107},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3471":72794,"_30355":72790,"_5":30684,"_21010":124109,"_27589":124110,"_2954":124111},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3471":72795,"_30355":72790,"_5":30684,"_21010":124113,"_27589":124114,"_2954":124115},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3471":72796,"_30355":72790,"_5":30684,"_21010":124117,"_27589":124118,"_2954":124119},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3471":72797,"_30355":72790,"_5":30684,"_21010":124121,"_27589":124122,"_2954":124123},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3471":72798,"_30355":72790,"_5":30684,"_21010":124125,"_27589":124126,"_2954":124127},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3471":72799,"_30355":72790,"_5":30684,"_21010":124129,"_27589":124130,"_2954":121674},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3471":72800,"_30355":72790,"_5":30684,"_21010":124132,"_27589":124133,"_2954":116694},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3471":72801,"_30355":72790,"_21010":124135,"_5":14420,"_27589":72790,"_2954":124136},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3471":72802,"_30355":72790,"_21010":124138,"_5":14420,"_27589":124103,"_2954":124139},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3471":72803,"_30355":72790,"_21010":124141,"_5":14420,"_27589":124103,"_2954":124142},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3471":72804,"_30355":72790,"_21010":124144,"_5":14420,"_27589":124103,"_2954":124145},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3471":72805,"_30355":72790,"_21010":124147,"_5":14420,"_27589":124103,"_2954":124148},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3471":72806,"_30355":72790,"_21010":124150,"_5":14420,"_27589":124106,"_2954":124151},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3471":72807,"_30355":72790,"_21010":124153,"_5":14420,"_27589":124106,"_2954":124154},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3471":72808,"_30355":72790,"_21010":124156,"_5":14420,"_27589":124110,"_2954":124157},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3471":72809,"_30355":72790,"_21010":124159,"_5":14420,"_27589":124110,"_2954":124160},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3471":72810,"_30355":72790,"_21010":124162,"_5":14420,"_27589":124114,"_2954":124163},[],"Selecciona **Root CA** y completa:",{"_3471":72811,"_30355":72790,"_21010":124165,"_5":14420,"_27589":124114,"_2954":57123},[],{"_3471":72812,"_30355":72790,"_21010":124167,"_5":14420,"_27589":124114,"_2954":124168},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3471":72813,"_30355":72790,"_21010":124170,"_5":14420,"_27589":124114,"_2954":124171},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3471":72814,"_30355":72790,"_21010":124173,"_5":14420,"_27589":124114,"_2954":124174},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3471":72815,"_30355":72790,"_21010":124176,"_5":14420,"_27589":124114,"_2954":124177},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3471":72816,"_30355":72790,"_21010":124179,"_5":14420,"_27589":124118,"_2954":124180},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3471":72817,"_30355":72790,"_21010":124182,"_5":14420,"_27589":124122,"_2954":124183},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3471":72818,"_30355":72790,"_21010":124185,"_5":14420,"_27589":124122,"_2954":124186},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3471":72819,"_30355":72790,"_21010":124188,"_5":14420,"_27589":124126,"_2954":124189},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3471":72820,"_30355":72790,"_21010":124191,"_5":14420,"_27589":124126,"_2954":124192},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3471":72821,"_30355":72790,"_21010":124194,"_5":14420,"_27589":124126,"_2954":124195},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3471":72822,"_30355":72790,"_21010":124197,"_5":14420,"_27589":124130,"_2954":124198},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3471":72823,"_30355":72790,"_21010":124200,"_5":14420,"_27589":124130,"_2954":124201},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3471":72824,"_30355":72790,"_21010":124203,"_5":14420,"_27589":124130,"_2954":124204},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3471":72825,"_30355":72790,"_21010":124206,"_5":14420,"_27589":124130,"_2954":124207},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3471":72826,"_30355":72790,"_21010":124209,"_5":14420,"_27589":124133,"_2954":124210},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3471":72827,"_30355":72827,"_5":14772,"_2954":124212,"_30687":124213,"_21010":124214,"_27589":72827},"Emite y verifica un certificado",[49421,118099,54901,121427],[],{"_3471":72828,"_30355":72827,"_21010":124216,"_5":14420,"_27589":72827,"_2954":124217},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3471":72829,"_30355":72827,"_5":30684,"_21010":124219,"_27589":124220,"_2954":116670},[],"/docs/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3471":72830,"_30355":72827,"_5":30684,"_21010":124222,"_27589":124223,"_2954":124224},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3471":72831,"_30355":72827,"_5":30684,"_21010":124226,"_27589":124227,"_2954":124228},[],"/docs/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3471":72832,"_30355":72827,"_5":30684,"_21010":124230,"_27589":124231,"_2954":124232},[],"/docs/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3471":72833,"_30355":72827,"_5":30684,"_21010":124234,"_27589":124235,"_2954":124236},[],"/docs/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3471":72834,"_30355":72827,"_5":30684,"_21010":124238,"_27589":124239,"_2954":124240},[],"/docs/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3471":72835,"_30355":72827,"_5":30684,"_21010":124242,"_27589":124243,"_2954":124244},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3471":72836,"_30355":72827,"_5":30684,"_21010":124246,"_27589":124247,"_2954":124248},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3471":72837,"_30355":72827,"_5":30684,"_21010":124250,"_27589":124251,"_2954":124252},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3471":72838,"_30355":72827,"_5":30684,"_21010":124254,"_27589":124255,"_2954":124256},[],"/docs/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3471":72839,"_30355":72827,"_5":30684,"_21010":124258,"_27589":124259,"_2954":121674},[],"/docs/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3471":72840,"_30355":72827,"_5":30684,"_21010":124261,"_27589":124262,"_2954":116694},[],"/docs/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3471":72841,"_30355":72827,"_21010":124264,"_5":14420,"_27589":72827,"_2954":124265},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3471":72842,"_30355":72827,"_21010":124267,"_5":14420,"_27589":124220,"_2954":124268},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3471":72843,"_30355":72827,"_21010":124270,"_5":14420,"_27589":124220,"_2954":124271},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3471":72844,"_30355":72827,"_21010":124273,"_5":14420,"_27589":124220,"_2954":124274},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3471":72845,"_30355":72827,"_21010":124276,"_5":14420,"_27589":124220,"_2954":124277},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3471":72846,"_30355":72827,"_21010":124279,"_5":14420,"_27589":124220,"_2954":124280},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3471":72847,"_30355":72827,"_21010":124282,"_5":14420,"_27589":124223,"_2954":124283},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3471":72848,"_30355":72827,"_21010":124285,"_5":14420,"_27589":124227,"_2954":124286},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3471":72849,"_30355":72827,"_21010":124288,"_5":14420,"_27589":124227,"_2954":124289},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3471":72850,"_30355":72827,"_21010":124291,"_5":14420,"_27589":124231,"_2954":124292},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3471":72851,"_30355":72827,"_21010":124294,"_5":14420,"_27589":124231,"_2954":124295},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3471":72852,"_30355":72827,"_21010":124297,"_5":14420,"_27589":124235,"_2954":124298},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3471":72853,"_30355":72827,"_21010":124300,"_5":14420,"_27589":124235,"_2954":124301},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3471":72854,"_30355":72827,"_21010":124303,"_5":14420,"_27589":124239,"_2954":124304},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3471":72855,"_30355":72827,"_21010":124306,"_5":14420,"_27589":124243,"_2954":124307},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3471":72856,"_30355":72827,"_21010":124309,"_5":14420,"_27589":124247,"_2954":124310},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3471":72857,"_30355":72827,"_21010":124312,"_5":14420,"_27589":124251,"_2954":124313},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3471":72858,"_30355":72827,"_21010":124315,"_5":14420,"_27589":124251,"_2954":124316},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3471":72859,"_30355":72827,"_21010":124318,"_5":14420,"_27589":124251,"_2954":124319},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3471":72860,"_30355":72827,"_21010":124321,"_5":14420,"_27589":124255,"_2954":124322},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3471":72861,"_30355":72827,"_21010":124324,"_5":14420,"_27589":124255,"_2954":124325},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3471":72862,"_30355":72827,"_21010":124327,"_5":14420,"_27589":124255,"_2954":124328},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3471":72863,"_30355":72827,"_21010":124330,"_5":14420,"_27589":124259,"_2954":121757},[],{"_3471":72864,"_30355":72827,"_21010":124332,"_5":14420,"_27589":124259,"_2954":120278},[],{"_3471":72865,"_30355":72827,"_21010":124334,"_5":14420,"_27589":124259,"_2954":124335},[],"La CA rechaza la emisión",{"_3471":72866,"_30355":72827,"_21010":124337,"_5":14420,"_27589":124259,"_2954":124338},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3471":72867,"_30355":72827,"_21010":124340,"_5":14420,"_27589":124259,"_2954":124341},[],"Sujeto o usos diferentes",{"_3471":72868,"_30355":72827,"_21010":124343,"_5":14420,"_27589":124259,"_2954":124344},[],"Perfil aplicado y valores solicitados.",{"_3471":72869,"_30355":72827,"_21010":124346,"_5":14420,"_27589":124259,"_2954":124347},[],"No se encuentra el emisor",{"_3471":72870,"_30355":72827,"_21010":124349,"_5":14420,"_27589":124259,"_2954":124350},[],"CA descargada y cadena intermedia necesaria.",{"_3471":72871,"_30355":72827,"_21010":124352,"_5":14420,"_27589":124259,"_2954":124353},[],"Falla la vigencia",{"_3471":72872,"_30355":72827,"_21010":124355,"_5":14420,"_27589":124259,"_2954":124356},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3471":72873,"_30355":72827,"_21010":124358,"_5":14420,"_27589":124259,"_2954":124359},[],"Los resúmenes de clave difieren",{"_3471":72874,"_30355":72827,"_21010":124361,"_5":14420,"_27589":124259,"_2954":124362},[],"Archivos de certificado y clave de la misma emisión.",{"_3471":72875,"_30355":72827,"_21010":124364,"_5":14420,"_27589":124259,"_2954":124365},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3471":72876,"_30355":72827,"_21010":124367,"_5":14420,"_27589":124262,"_2954":124368},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3471":72877,"_30355":72827,"_21010":124370,"_5":14420,"_27589":124262,"_2954":124371},[],"Gestionar certificados para inspección, estado y revocación.",{"_3471":72878,"_30355":72827,"_21010":124373,"_5":14420,"_27589":124262,"_2954":124374},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3471":72879,"_30355":72827,"_21010":124376,"_5":14420,"_27589":124262,"_2954":124377},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3471":72880,"_30355":72827,"_21010":124379,"_5":14420,"_27589":124262,"_2954":124380},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3471":72881,"_30355":72881,"_5":14772,"_2954":124382,"_30687":124383,"_21010":124384,"_27589":72881},"Primeros pasos de PKI",[49421,118099,54901,121427],[],{"_3471":72882,"_30355":72881,"_21010":124386,"_5":14420,"_27589":72881,"_2954":124387},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3471":72883,"_30355":72881,"_5":30684,"_21010":124389,"_27589":124390,"_2954":116670},[],"/docs/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3471":72884,"_30355":72881,"_5":30684,"_21010":124392,"_27589":124393,"_2954":124394},[],"/docs/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3471":72885,"_30355":72881,"_5":30684,"_21010":124396,"_27589":124397,"_2954":121609},[],"/docs/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3471":72886,"_30355":72881,"_5":30684,"_21010":124399,"_27589":124400,"_2954":124401},[],"/docs/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3471":72887,"_30355":72881,"_21010":124403,"_5":14420,"_27589":72881,"_2954":124404},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3471":72888,"_30355":72881,"_21010":124406,"_5":14420,"_27589":124390,"_2954":124407},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3471":72889,"_30355":72881,"_21010":124409,"_5":14420,"_27589":124390,"_2954":124410},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3471":72890,"_30355":72881,"_21010":124412,"_5":14420,"_27589":124390,"_2954":124413},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3471":72891,"_30355":72881,"_21010":124415,"_5":14420,"_27589":124390,"_2954":124416},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3471":72892,"_30355":72881,"_21010":124418,"_5":14420,"_27589":124390,"_2954":124419},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3471":72893,"_30355":72881,"_21010":124421,"_5":14420,"_27589":124393,"_2954":124422},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3471":72894,"_30355":72881,"_21010":124424,"_5":14420,"_27589":124393,"_2954":124425},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3471":72895,"_30355":72881,"_21010":124427,"_5":14420,"_27589":124393,"_2954":124428},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3471":72896,"_30355":72881,"_21010":124430,"_5":14420,"_27589":124393,"_2954":124431},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3471":72897,"_30355":72881,"_21010":124433,"_5":14420,"_27589":124397,"_2954":124434},[],"Archivo o recurso",{"_3471":72898,"_30355":72881,"_21010":124436,"_5":14420,"_27589":124397,"_2954":121606},[],{"_3471":72899,"_30355":72881,"_21010":124438,"_5":14420,"_27589":124397,"_2954":124439},[],"CA raíz activa y `ca.pem`",{"_3471":72900,"_30355":72881,"_21010":124441,"_5":14420,"_27589":124397,"_2954":124442},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3471":72901,"_30355":72881,"_21010":124444,"_5":14420,"_27589":124397,"_2954":124445},[],"Certificado final y `device.crt`",{"_3471":72902,"_30355":72881,"_21010":124447,"_5":14420,"_27589":124397,"_2954":124448},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3471":72903,"_30355":72881,"_21010":124450,"_5":14420,"_27589":124397,"_2954":124451},[],"Clave privada `device.key`",{"_3471":72904,"_30355":72881,"_21010":124453,"_5":14420,"_27589":124397,"_2954":124454},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3471":72905,"_30355":72881,"_21010":124456,"_5":14420,"_27589":124397,"_2954":124457},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3471":72906,"_30355":72881,"_21010":124459,"_5":14420,"_27589":124400,"_2954":124460},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3471":72907,"_30355":72881,"_21010":124462,"_5":14420,"_27589":124400,"_2954":124463},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3471":72908,"_30355":72881,"_21010":124465,"_5":14420,"_27589":124400,"_2954":124466},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3471":72909,"_30355":72909,"_5":14772,"_2954":124468,"_30687":124469,"_21010":124471,"_27589":72909},"Resolución de problemas PKI",[49421,118099,54901,124470],"Resolución de problemas",[],{"_3471":72910,"_30355":72909,"_21010":124473,"_5":14420,"_27589":72909,"_2954":124474},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3471":72911,"_30355":72909,"_5":30684,"_21010":124476,"_27589":124477,"_2954":124478},[],"/docs/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3471":72912,"_30355":72909,"_5":30684,"_21010":124480,"_27589":124481,"_2954":124482},[],"/docs/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3471":72913,"_30355":72909,"_5":30684,"_21010":124484,"_27589":124485,"_2954":124486},[],"/docs/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3471":72914,"_30355":72909,"_21010":124488,"_5":14420,"_27589":72909,"_2954":124489},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3471":72915,"_30355":72909,"_21010":124491,"_5":14420,"_27589":72909,"_2954":124492},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3471":72916,"_30355":72909,"_21010":124494,"_5":14420,"_27589":124477,"_2954":121606},[],{"_3471":72917,"_30355":72909,"_21010":124496,"_5":14420,"_27589":124477,"_2954":120278},[],{"_3471":72918,"_30355":72909,"_21010":124498,"_5":14420,"_27589":124477,"_2954":116694},[],{"_3471":72919,"_30355":72909,"_21010":124500,"_5":14420,"_27589":124477,"_2954":53743},[],{"_3471":72920,"_30355":72909,"_21010":124502,"_5":14420,"_27589":124477,"_2954":124503},[],"Existe, está activa y sus fechas son utilizables.",{"_3471":72921,"_30355":72909,"_21010":124505,"_5":14420,"_27589":124477,"_2954":124506},[],"Autoridades.",{"_3471":72922,"_30355":72909,"_21010":124508,"_5":14420,"_27589":124477,"_2954":124509},[],"Clave",{"_3471":72923,"_30355":72909,"_21010":124511,"_5":14420,"_27589":124477,"_2954":124512},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3471":72924,"_30355":72909,"_21010":124514,"_5":14420,"_27589":124477,"_2954":124515},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3471":72925,"_30355":72909,"_21010":124517,"_5":14420,"_27589":124477,"_2954":57477},[],{"_3471":72926,"_30355":72909,"_21010":124519,"_5":14420,"_27589":124477,"_2954":124520},[],"PEM correcto y firma verificable.",{"_3471":72927,"_30355":72909,"_21010":124522,"_5":14420,"_27589":124477,"_2954":57483},[],{"_3471":72928,"_30355":72909,"_21010":124524,"_5":14420,"_27589":124477,"_2954":124525},[],"Perfil",{"_3471":72929,"_30355":72909,"_21010":124527,"_5":14420,"_27589":124477,"_2954":124528},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3471":72930,"_30355":72909,"_21010":124530,"_5":14420,"_27589":124477,"_2954":124531},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3471":72931,"_30355":72909,"_21010":124533,"_5":14420,"_27589":124477,"_2954":121757},[],{"_3471":72932,"_30355":72909,"_21010":124535,"_5":14420,"_27589":124477,"_2954":124536},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3471":72933,"_30355":72909,"_21010":124538,"_5":14420,"_27589":124477,"_2954":124539},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3471":72934,"_30355":72909,"_21010":124541,"_5":14420,"_27589":124477,"_2954":124542},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3471":72935,"_30355":72909,"_21010":124544,"_5":14420,"_27589":124477,"_2954":124545},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3471":72936,"_30355":72909,"_21010":124547,"_5":14420,"_27589":124481,"_2954":124548},[],"Revisa cada frontera por separado:",{"_3471":72937,"_30355":72909,"_21010":124550,"_5":14420,"_27589":124481,"_2954":124551},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3471":72938,"_30355":72909,"_21010":124553,"_5":14420,"_27589":124481,"_2954":124554},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3471":72939,"_30355":72909,"_21010":124556,"_5":14420,"_27589":124481,"_2954":124557},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3471":72940,"_30355":72909,"_21010":124559,"_5":14420,"_27589":124481,"_2954":124560},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3471":72941,"_30355":72909,"_21010":124562,"_5":14420,"_27589":124481,"_2954":124563},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3471":72942,"_30355":72909,"_21010":124565,"_5":14420,"_27589":124481,"_2954":124566},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3471":72943,"_30355":72909,"_21010":124568,"_5":14420,"_27589":124485,"_2954":124569},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3471":72944,"_30355":72909,"_21010":124571,"_5":14420,"_27589":124485,"_2954":124572},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3471":72945,"_30355":72945,"_5":14772,"_2954":124574,"_30687":124575,"_21010":124576,"_27589":72945},"Seguridad",[49421],[],{"_3471":72946,"_30355":72945,"_21010":124578,"_5":14420,"_27589":72945,"_2954":124579},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3471":72947,"_30355":72945,"_5":30684,"_21010":124581,"_27589":124582,"_2954":124583},[],"/docs/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3471":72948,"_30355":72945,"_5":30684,"_21010":124585,"_27589":124586,"_2954":124587},[],"/docs/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3471":72949,"_30355":72945,"_5":30684,"_21010":124589,"_27589":124590,"_2954":124591},[],"/docs/es/security#versiones-soportadas","Versiones soportadas",{"_3471":72950,"_30355":72945,"_5":30684,"_21010":124593,"_27589":124594,"_2954":124595},[],"/docs/es/security#divulgación-responsable","Divulgación responsable",{"_3471":72951,"_30355":72945,"_21010":124597,"_5":14420,"_27589":72945,"_2954":124598},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3471":72952,"_30355":72945,"_21010":124600,"_5":14420,"_27589":124582,"_2954":124601},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3471":72953,"_30355":72945,"_21010":124603,"_5":14420,"_27589":124582,"_2954":124604},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3471":72954,"_30355":72945,"_21010":124606,"_5":14420,"_27589":124582,"_2954":15051},[],{"_3471":72955,"_30355":72945,"_21010":124608,"_5":14420,"_27589":124582,"_2954":14991},[],{"_3471":72956,"_30355":72945,"_21010":124610,"_5":14420,"_27589":124582,"_2954":15038},[],{"_3471":72957,"_30355":72945,"_21010":124612,"_5":14420,"_27589":124582,"_2954":124613},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3471":72958,"_30355":72945,"_21010":124615,"_5":14420,"_27589":124582,"_2954":124616},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3471":72959,"_30355":72945,"_21010":124618,"_5":14420,"_27589":124586,"_2954":124619},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3471":72960,"_30355":72945,"_21010":124621,"_5":14420,"_27589":124586,"_2954":124622},[],"No incluyas en el reporte:",{"_3471":72961,"_30355":72945,"_21010":124624,"_5":14420,"_27589":124586,"_2954":124625},[],"Credenciales, tokens o claves privadas",{"_3471":72962,"_30355":72945,"_21010":124627,"_5":14420,"_27589":124586,"_2954":124628},[],"Datos de clientes o información identificable de clientes",{"_3471":72963,"_30355":72945,"_21010":124630,"_5":14420,"_27589":124586,"_2954":124631},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3471":72964,"_30355":72945,"_21010":124633,"_5":14420,"_27589":124590,"_2954":124634},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3471":72965,"_30355":72945,"_21010":124636,"_5":14420,"_27589":124590,"_2954":124637},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3471":72966,"_30355":72945,"_21010":124639,"_5":14420,"_27589":124594,"_2954":124640},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3471":72967,"_30355":72945,"_21010":124642,"_5":14420,"_27589":124594,"_2954":124643},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3471":72968,"_30355":72945,"_21010":124645,"_5":14420,"_27589":124594,"_2954":124646},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3471":72969,"_30355":72945,"_21010":124648,"_5":14420,"_27589":124594,"_2954":124649},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3471":72970,"_30355":72945,"_21010":124651,"_5":14420,"_27589":124594,"_2954":124652},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3471":72971,"_30355":72971,"_5":14772,"_2954":124654,"_30687":124655,"_21010":124657,"_27589":72971},"3.8.0 a 4.0.0",[49421,124656],"Actualizaciones",[],{"_3471":72972,"_30355":72971,"_21010":124659,"_5":14420,"_27589":72971,"_2954":124660},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3471":72973,"_30355":72971,"_5":30684,"_21010":124662,"_27589":124663,"_2954":124664},[],"/docs/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3471":72974,"_30355":72971,"_5":30684,"_21010":124666,"_27589":124667,"_2954":124668},[],"/docs/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3471":72975,"_30355":72971,"_5":30684,"_21010":124670,"_27589":124671,"_2954":124672},[],"/docs/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3471":72976,"_30355":72971,"_5":30684,"_21010":124674,"_27589":124675,"_2954":124676},[],"/docs/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3471":72977,"_30355":72971,"_5":30684,"_21010":124678,"_27589":124679,"_2954":124680},[],"/docs/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3471":72978,"_30355":72971,"_5":30684,"_21010":124682,"_27589":124683,"_2954":124684},[],"/docs/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3471":72979,"_30355":72971,"_5":30684,"_21010":124686,"_27589":124687,"_2954":57649},[],"/docs/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3471":72980,"_30355":72971,"_5":30684,"_21010":124689,"_27589":124690,"_2954":124691},[],"/docs/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3471":72981,"_30355":72971,"_5":30684,"_21010":124693,"_27589":124694,"_2954":124695},[],"/docs/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3471":72982,"_30355":72971,"_5":30684,"_21010":124697,"_27589":124698,"_2954":124699},[],"/docs/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3471":72983,"_30355":72971,"_5":30684,"_21010":124701,"_27589":124702,"_2954":124703},[],"/docs/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3471":72984,"_30355":72971,"_5":30684,"_21010":124705,"_27589":124706,"_2954":124707},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3471":72985,"_30355":72971,"_5":30684,"_21010":124709,"_27589":124710,"_2954":124711},[],"/docs/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3471":72986,"_30355":72971,"_5":30684,"_21010":124713,"_27589":124714,"_2954":124715},[],"/docs/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3471":72987,"_30355":72971,"_5":30684,"_21010":124717,"_27589":124718,"_2954":124719},[],"/docs/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3471":72988,"_30355":72971,"_5":30684,"_21010":124721,"_27589":124722,"_2954":124723},[],"/docs/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3471":72989,"_30355":72971,"_5":30684,"_21010":124725,"_27589":124726,"_2954":124727},[],"/docs/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3471":72990,"_30355":72971,"_5":30684,"_21010":124729,"_27589":124730,"_2954":124731},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3471":72991,"_30355":72971,"_5":30684,"_21010":124733,"_27589":124734,"_2954":124735},[],"/docs/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3471":72992,"_30355":72971,"_5":30684,"_21010":124737,"_27589":124738,"_2954":124739},[],"/docs/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3471":72993,"_30355":72971,"_5":30684,"_21010":124741,"_27589":124742,"_2954":124743},[],"/docs/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3471":72994,"_30355":72971,"_5":30684,"_21010":124745,"_27589":124746,"_2954":124747},[],"/docs/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3471":72995,"_30355":72971,"_5":30684,"_21010":124749,"_27589":124750,"_2954":124751},[],"/docs/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3471":72996,"_30355":72971,"_5":30684,"_21010":124753,"_27589":124754,"_2954":124755},[],"/docs/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3471":72997,"_30355":72971,"_5":30684,"_21010":124757,"_27589":124758,"_2954":124759},[],"/docs/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3471":72998,"_30355":72971,"_5":30684,"_21010":124761,"_27589":124762,"_2954":124763},[],"/docs/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3471":72999,"_30355":72971,"_5":30684,"_21010":124765,"_27589":124766,"_2954":124767},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3471":73000,"_30355":72971,"_5":30684,"_21010":124769,"_27589":124770,"_2954":124771},[],"/docs/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3471":73001,"_30355":72971,"_5":30684,"_21010":124773,"_27589":124774,"_2954":124775},[],"/docs/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3471":73002,"_30355":72971,"_5":30684,"_21010":124777,"_27589":124778,"_2954":124779},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3471":73003,"_30355":72971,"_5":30684,"_21010":124781,"_27589":124782,"_2954":124783},[],"/docs/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3471":73004,"_30355":72971,"_5":30684,"_21010":124785,"_27589":124786,"_2954":124787},[],"/docs/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3471":73005,"_30355":72971,"_5":30684,"_21010":124789,"_27589":124790,"_2954":124791},[],"/docs/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3471":73006,"_30355":72971,"_5":30684,"_21010":124793,"_27589":124794,"_2954":124795},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3471":73007,"_30355":72971,"_5":30684,"_21010":124797,"_27589":124798,"_2954":124799},[],"/docs/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3471":73008,"_30355":72971,"_5":30684,"_21010":124801,"_27589":124802,"_2954":124803},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3471":73009,"_30355":72971,"_5":30684,"_21010":124805,"_27589":124806,"_2954":124807},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3471":73010,"_30355":72971,"_5":30684,"_21010":124809,"_27589":124810,"_2954":124811},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3471":73011,"_30355":72971,"_5":30684,"_21010":124813,"_27589":124814,"_2954":124815},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3471":73012,"_30355":72971,"_5":30684,"_21010":124817,"_27589":124818,"_2954":124819},[],"/docs/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3471":73013,"_30355":72971,"_5":30684,"_21010":124821,"_27589":124822,"_2954":120620},[],"/docs/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3471":73014,"_30355":72971,"_5":30684,"_21010":124824,"_27589":124825,"_2954":124826},[],"/docs/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3471":73015,"_30355":72971,"_5":30684,"_21010":124828,"_27589":124829,"_2954":124830},[],"/docs/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3471":73016,"_30355":72971,"_21010":124832,"_5":14420,"_27589":72971,"_2954":124833},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3471":73017,"_30355":72971,"_21010":124835,"_5":14420,"_27589":72971,"_2954":124836},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3471":73018,"_30355":72971,"_21010":124838,"_5":14420,"_27589":72971,"_2954":124839},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3471":73019,"_30355":72971,"_21010":124841,"_5":14420,"_27589":72971,"_2954":124842},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3471":73020,"_30355":72971,"_21010":124844,"_5":14420,"_27589":72971,"_2954":124845},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3471":73021,"_30355":72971,"_21010":124847,"_5":14420,"_27589":72971,"_2954":124848},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3471":73022,"_30355":72971,"_21010":124850,"_5":14420,"_27589":72971,"_2954":124851},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3471":73023,"_30355":72971,"_21010":124853,"_5":14420,"_27589":124667,"_2954":124854},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3471":73024,"_30355":72971,"_21010":124856,"_5":14420,"_27589":124667,"_2954":124857},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3471":73025,"_30355":72971,"_21010":124859,"_5":14420,"_27589":124671,"_2954":124860},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3471":73026,"_30355":72971,"_21010":124862,"_5":14420,"_27589":124671,"_2954":124863},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3471":73027,"_30355":72971,"_21010":124865,"_5":14420,"_27589":124675,"_2954":124866},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3471":73028,"_30355":72971,"_21010":124868,"_5":14420,"_27589":124679,"_2954":124869},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3471":73029,"_30355":72971,"_21010":124871,"_5":14420,"_27589":124679,"_2954":124872},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3471":73030,"_30355":72971,"_21010":124874,"_5":14420,"_27589":124679,"_2954":124875},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3471":73031,"_30355":72971,"_21010":124877,"_5":14420,"_27589":124679,"_2954":124878},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3471":73032,"_30355":72971,"_21010":124880,"_5":14420,"_27589":124679,"_2954":124881},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3471":73033,"_30355":72971,"_21010":124883,"_5":14420,"_27589":124683,"_2954":124884},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3471":73034,"_30355":72971,"_21010":124886,"_5":14420,"_27589":124683,"_2954":124887},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3471":73035,"_30355":72971,"_21010":124889,"_5":14420,"_27589":124683,"_2954":124890},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3471":73036,"_30355":72971,"_21010":124892,"_5":14420,"_27589":124683,"_2954":124893},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3471":73037,"_30355":72971,"_21010":124895,"_5":14420,"_27589":124683,"_2954":124896},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3471":73038,"_30355":72971,"_21010":124898,"_5":14420,"_27589":124683,"_2954":124899},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3471":73039,"_30355":72971,"_21010":124901,"_5":14420,"_27589":124687,"_2954":124902},[],"Cambio",{"_3471":73040,"_30355":72971,"_21010":124904,"_5":14420,"_27589":124687,"_2954":124905},[],"A quién afecta",{"_3471":73041,"_30355":72971,"_21010":124907,"_5":14420,"_27589":124687,"_2954":124908},[],"Gravedad",{"_3471":73042,"_30355":72971,"_21010":124910,"_5":14420,"_27589":124687,"_2954":123387},[],{"_3471":73043,"_30355":72971,"_21010":124912,"_5":14420,"_27589":124687,"_2954":124695},[],{"_3471":73044,"_30355":72971,"_21010":124914,"_5":14420,"_27589":124687,"_2954":124915},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3471":73045,"_30355":72971,"_21010":124917,"_5":14420,"_27589":124687,"_2954":124918},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3471":73046,"_30355":72971,"_21010":124920,"_5":14420,"_27589":124687,"_2954":124921},[],"Copiar los datos a los volúmenes nuevos",{"_3471":73047,"_30355":72971,"_21010":124923,"_5":14420,"_27589":124687,"_2954":124699},[],{"_3471":73048,"_30355":72971,"_21010":124925,"_5":14420,"_27589":124687,"_2954":124926},[],"Todas las releases de Helm",{"_3471":73049,"_30355":72971,"_21010":124928,"_5":14420,"_27589":124687,"_2954":124929},[],"Alta: `helm upgrade` falla",{"_3471":73050,"_30355":72971,"_21010":124931,"_5":14420,"_27589":124687,"_2954":124932},[],"Eliminar o renombrar las claves heredadas",{"_3471":73051,"_30355":72971,"_21010":124934,"_5":14420,"_27589":124687,"_2954":124703},[],{"_3471":73052,"_30355":72971,"_21010":124936,"_5":14420,"_27589":124687,"_2954":124937},[],"Todos los despliegues",{"_3471":73053,"_30355":72971,"_21010":124939,"_5":14420,"_27589":124687,"_2954":124940},[],"Alta: sin principal de bootstrap no hay administrador",{"_3471":73054,"_30355":72971,"_21010":124942,"_5":14420,"_27589":124687,"_2954":124943},[],"Configurar `services.authz`",{"_3471":73055,"_30355":72971,"_21010":124945,"_5":14420,"_27589":124687,"_2954":124707},[],{"_3471":73056,"_30355":72971,"_21010":124947,"_5":14420,"_27589":124687,"_2954":124926},[],{"_3471":73057,"_30355":72971,"_21010":124949,"_5":14420,"_27589":124687,"_2954":124950},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3471":73058,"_30355":72971,"_21010":124952,"_5":14420,"_27589":124687,"_2954":124953},[],"Mover JWKS y roles a `services.authz`",{"_3471":73059,"_30355":72971,"_21010":124955,"_5":14420,"_27589":124687,"_2954":124727},[],{"_3471":73060,"_30355":72971,"_21010":124957,"_5":14420,"_27589":124687,"_2954":124958},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3471":73061,"_30355":72971,"_21010":124960,"_5":14420,"_27589":124687,"_2954":124961},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3471":73062,"_30355":72971,"_21010":124963,"_5":14420,"_27589":124687,"_2954":124964},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3471":73063,"_30355":72971,"_21010":124966,"_5":14420,"_27589":124687,"_2954":124731},[],{"_3471":73064,"_30355":72971,"_21010":124968,"_5":14420,"_27589":124687,"_2954":124969},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3471":73065,"_30355":72971,"_21010":124971,"_5":14420,"_27589":124687,"_2954":124972},[],"Alta: el backend ya no arranca con ellos",{"_3471":73066,"_30355":72971,"_21010":124974,"_5":14420,"_27589":124687,"_2954":124975},[],"Pasar a PostgreSQL antes de actualizar",{"_3471":73067,"_30355":72971,"_21010":124977,"_5":14420,"_27589":124687,"_2954":124775},[],{"_3471":73068,"_30355":72971,"_21010":124979,"_5":14420,"_27589":124687,"_2954":124980},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3471":73069,"_30355":72971,"_21010":124982,"_5":14420,"_27589":124687,"_2954":124983},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3471":73070,"_30355":72971,"_21010":124985,"_5":14420,"_27589":124687,"_2954":124986},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3471":73071,"_30355":72971,"_21010":124988,"_5":14420,"_27589":124687,"_2954":124989},[],"Webhooks con referencias a archivos",{"_3471":73072,"_30355":72971,"_21010":124991,"_5":14420,"_27589":124687,"_2954":124992},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3471":73073,"_30355":72971,"_21010":124994,"_5":14420,"_27589":124687,"_2954":124995},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3471":73074,"_30355":72971,"_21010":124997,"_5":14420,"_27589":124687,"_2954":124998},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3471":73075,"_30355":72971,"_21010":125000,"_5":14420,"_27589":124687,"_2954":124711},[],{"_3471":73076,"_30355":72971,"_21010":125002,"_5":14420,"_27589":124687,"_2954":125003},[],"Releases con identidades por servicio o material de claves montado",{"_3471":73077,"_30355":72971,"_21010":125005,"_5":14420,"_27589":124687,"_2954":125006},[],"Media: los servicios no pueden leer sus archivos",{"_3471":73078,"_30355":72971,"_21010":125008,"_5":14420,"_27589":124687,"_2954":125009},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3471":73079,"_30355":72971,"_21010":125011,"_5":14420,"_27589":124687,"_2954":124715},[],{"_3471":73080,"_30355":72971,"_21010":125013,"_5":14420,"_27589":124687,"_2954":125014},[],"Releases que definen `amqp.tls`",{"_3471":73081,"_30355":72971,"_21010":125016,"_5":14420,"_27589":124687,"_2954":125017},[],"Media: los clientes se conectan al puerto equivocado",{"_3471":73082,"_30355":72971,"_21010":125019,"_5":14420,"_27589":124687,"_2954":125020},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3471":73083,"_30355":72971,"_21010":125022,"_5":14420,"_27589":124687,"_2954":124735},[],{"_3471":73084,"_30355":72971,"_21010":125024,"_5":14420,"_27589":124687,"_2954":125025},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3471":73085,"_30355":72971,"_21010":125027,"_5":14420,"_27589":124687,"_2954":125028},[],"Media: las claves de CA quedan sin gestionar",{"_3471":73086,"_30355":72971,"_21010":125030,"_5":14420,"_27589":124687,"_2954":125031},[],"Ejecutar la migración de CA a KMS",{"_3471":73087,"_30355":72971,"_21010":125033,"_5":14420,"_27589":124687,"_2954":125034},[],"Verificación del certificado del receptor",{"_3471":73088,"_30355":72971,"_21010":125036,"_5":14420,"_27589":124687,"_2954":125037},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3471":73089,"_30355":72971,"_21010":125039,"_5":14420,"_27589":124687,"_2954":125040},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3471":73090,"_30355":72971,"_21010":125042,"_5":14420,"_27589":124687,"_2954":125043},[],"Poner `insecure_skip_verify` a `false`",{"_3471":73091,"_30355":72971,"_21010":125045,"_5":14420,"_27589":124687,"_2954":124751},[],{"_3471":73092,"_30355":72971,"_21010":125047,"_5":14420,"_27589":124687,"_2954":125048},[],"Scripts y consolas que editan DMS por API",{"_3471":73093,"_30355":72971,"_21010":125050,"_5":14420,"_27589":124687,"_2954":125051},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3471":73094,"_30355":72971,"_21010":125053,"_5":14420,"_27589":124687,"_2954":125054},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3471":73095,"_30355":72971,"_21010":125056,"_5":14420,"_27589":124687,"_2954":124771},[],{"_3471":73096,"_30355":72971,"_21010":125058,"_5":14420,"_27589":124687,"_2954":125059},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3471":73097,"_30355":72971,"_21010":125061,"_5":14420,"_27589":124687,"_2954":125062},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3471":73098,"_30355":72971,"_21010":125064,"_5":14420,"_27589":124687,"_2954":125065},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3471":73099,"_30355":72971,"_21010":125067,"_5":14420,"_27589":124687,"_2954":124779},[],{"_3471":73100,"_30355":72971,"_21010":125069,"_5":14420,"_27589":124687,"_2954":125070},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3471":73101,"_30355":72971,"_21010":125072,"_5":14420,"_27589":124687,"_2954":125073},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3471":73102,"_30355":72971,"_21010":125075,"_5":14420,"_27589":124687,"_2954":125076},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3471":73103,"_30355":72971,"_21010":125078,"_5":14420,"_27589":124687,"_2954":124767},[],{"_3471":73104,"_30355":72971,"_21010":125080,"_5":14420,"_27589":124687,"_2954":125081},[],"Consumidores que leen el campo `events` del dispositivo",{"_3471":73105,"_30355":72971,"_21010":125083,"_5":14420,"_27589":124687,"_2954":125084},[],"Media: el campo desaparece",{"_3471":73106,"_30355":72971,"_21010":125086,"_5":14420,"_27589":124687,"_2954":125087},[],"Usar los nuevos endpoints de eventos",{"_3471":73107,"_30355":72971,"_21010":125089,"_5":14420,"_27589":124687,"_2954":124787},[],{"_3471":73108,"_30355":72971,"_21010":125091,"_5":14420,"_27589":124687,"_2954":125092},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3471":73109,"_30355":72971,"_21010":125094,"_5":14420,"_27589":124687,"_2954":125095},[],"Media: la migración de la VA aborta",{"_3471":73110,"_30355":72971,"_21010":125097,"_5":14420,"_27589":124687,"_2954":125098},[],"Corregir los roles afectados antes de actualizar",{"_3471":73111,"_30355":72971,"_21010":125100,"_5":14420,"_27589":124687,"_2954":124719},[],{"_3471":73112,"_30355":72971,"_21010":125102,"_5":14420,"_27589":124687,"_2954":125103},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3471":73113,"_30355":72971,"_21010":125105,"_5":14420,"_27589":124687,"_2954":125106},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3471":73114,"_30355":72971,"_21010":125108,"_5":14420,"_27589":124687,"_2954":125109},[],"Actualizar el archivo de values",{"_3471":73115,"_30355":72971,"_21010":125111,"_5":14420,"_27589":124687,"_2954":124759},[],{"_3471":73116,"_30355":72971,"_21010":125113,"_5":14420,"_27589":124687,"_2954":125114},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3471":73117,"_30355":72971,"_21010":125116,"_5":14420,"_27589":124687,"_2954":125117},[],"Baja: prevalece el ID de la URL",{"_3471":73118,"_30355":72971,"_21010":125119,"_5":14420,"_27589":124687,"_2954":125120},[],"Enviar el ID en la URL",{"_3471":73119,"_30355":72971,"_21010":125122,"_5":14420,"_27589":124687,"_2954":124783},[],{"_3471":73120,"_30355":72971,"_21010":125124,"_5":14420,"_27589":124687,"_2954":125125},[],"Clientes que envían un `id` al crear o importar CAs",{"_3471":73121,"_30355":72971,"_21010":125127,"_5":14420,"_27589":124687,"_2954":125128},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3471":73122,"_30355":72971,"_21010":125130,"_5":14420,"_27589":124687,"_2954":125131},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3471":73123,"_30355":72971,"_21010":125133,"_5":14420,"_27589":124687,"_2954":124763},[],{"_3471":73124,"_30355":72971,"_21010":125135,"_5":14420,"_27589":124687,"_2954":125136},[],"Consumidores que comparan el `type` del certificado",{"_3471":73125,"_30355":72971,"_21010":125138,"_5":14420,"_27589":124687,"_2954":125139},[],"Baja: dos valores cambian de nombre",{"_3471":73126,"_30355":72971,"_21010":125141,"_5":14420,"_27589":124687,"_2954":125142},[],"Adaptar los consumidores",{"_3471":73127,"_30355":72971,"_21010":125144,"_5":14420,"_27589":124687,"_2954":124755},[],{"_3471":73128,"_30355":72971,"_21010":125146,"_5":14420,"_27589":124687,"_2954":125147},[],"Cualquier DMS",{"_3471":73129,"_30355":72971,"_21010":125149,"_5":14420,"_27589":124687,"_2954":125150},[],"Baja: solo informativo",{"_3471":73130,"_30355":72971,"_21010":125152,"_5":14420,"_27589":124687,"_2954":125153},[],"Revisar ambos bloques antes de editar",{"_3471":73131,"_30355":72971,"_21010":125155,"_5":14420,"_27589":124694,"_2954":125156},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3471":73132,"_30355":72971,"_21010":125158,"_5":14420,"_27589":124694,"_2954":125159},[],"El paso 4 de la guía de migración copia los datos.",{"_3471":73133,"_30355":72971,"_21010":125161,"_5":14420,"_27589":124698,"_2954":125162},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3471":73134,"_30355":72971,"_21010":125164,"_5":14420,"_27589":124702,"_2954":125165},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3471":73135,"_30355":72971,"_21010":125167,"_5":14420,"_27589":124706,"_2954":125168},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3471":73136,"_30355":72971,"_21010":125170,"_5":14420,"_27589":124710,"_2954":125171},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3471":73137,"_30355":72971,"_21010":125173,"_5":14420,"_27589":124710,"_2954":125174},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3471":73138,"_30355":72971,"_21010":125176,"_5":14420,"_27589":124714,"_2954":125177},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3471":73139,"_30355":72971,"_21010":125179,"_5":14420,"_27589":124718,"_2954":125180},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3471":73140,"_30355":72971,"_21010":125182,"_5":14420,"_27589":124718,"_2954":125183},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3471":73141,"_30355":72971,"_21010":125185,"_5":14420,"_27589":124718,"_2954":125186},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3471":73142,"_30355":72971,"_21010":125188,"_5":14420,"_27589":124718,"_2954":125189},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3471":73143,"_30355":72971,"_21010":125191,"_5":14420,"_27589":124718,"_2954":125192},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3471":73144,"_30355":72971,"_21010":125194,"_5":14420,"_27589":124718,"_2954":125195},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3471":73145,"_30355":72971,"_21010":125197,"_5":14420,"_27589":124726,"_2954":125198},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3471":73146,"_30355":72971,"_21010":125200,"_5":14420,"_27589":124726,"_2954":125201},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3471":73147,"_30355":72971,"_21010":125203,"_5":14420,"_27589":124726,"_2954":125204},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3471":73148,"_30355":72971,"_21010":125206,"_5":14420,"_27589":124726,"_2954":125207},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3471":73149,"_30355":72971,"_21010":125209,"_5":14420,"_27589":124726,"_2954":125210},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3471":73150,"_30355":72971,"_21010":125212,"_5":14420,"_27589":124730,"_2954":125213},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3471":73151,"_30355":72971,"_21010":125215,"_5":14420,"_27589":124734,"_2954":125216},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3471":73152,"_30355":72971,"_21010":125218,"_5":14420,"_27589":124734,"_2954":125219},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3471":73153,"_30355":72971,"_21010":125221,"_5":14420,"_27589":124734,"_2954":125222},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3471":73154,"_30355":72971,"_21010":125224,"_5":14420,"_27589":124734,"_2954":125225},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3471":73155,"_30355":72971,"_21010":125227,"_5":14420,"_27589":124734,"_2954":125228},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3471":73156,"_30355":72971,"_21010":125230,"_5":14420,"_27589":124734,"_2954":125231},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3471":73157,"_30355":72971,"_21010":125233,"_5":14420,"_27589":124734,"_2954":125234},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3471":73158,"_30355":72971,"_21010":125236,"_5":14420,"_27589":124734,"_2954":125237},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3471":73159,"_30355":72971,"_21010":125239,"_5":14420,"_27589":124738,"_2954":125240},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3471":73160,"_30355":72971,"_21010":125242,"_5":14420,"_27589":124746,"_2954":125243},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3471":73161,"_30355":72971,"_21010":125245,"_5":14420,"_27589":124746,"_2954":125246},[],"Campo en 3.8.0",{"_3471":73162,"_30355":72971,"_21010":125248,"_5":14420,"_27589":124746,"_2954":125249},[],"Campo en 4.0.0",{"_3471":73163,"_30355":72971,"_21010":125251,"_5":14420,"_27589":124746,"_2954":58214},[],{"_3471":73164,"_30355":72971,"_21010":125253,"_5":14420,"_27589":124746,"_2954":125254},[],"`insecure_skip_verify` (con el valor negado)",{"_3471":73165,"_30355":72971,"_21010":125256,"_5":14420,"_27589":124746,"_2954":58220},[],{"_3471":73166,"_30355":72971,"_21010":125258,"_5":14420,"_27589":124746,"_2954":58223},[],{"_3471":73167,"_30355":72971,"_21010":125260,"_5":14420,"_27589":124746,"_2954":58226},[],{"_3471":73168,"_30355":72971,"_21010":125262,"_5":14420,"_27589":124746,"_2954":58229},[],{"_3471":73169,"_30355":72971,"_21010":125264,"_5":14420,"_27589":124746,"_2954":58232},[],{"_3471":73170,"_30355":72971,"_21010":125266,"_5":14420,"_27589":124746,"_2954":58235},[],{"_3471":73171,"_30355":72971,"_21010":125268,"_5":14420,"_27589":124746,"_2954":125269},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3471":73172,"_30355":72971,"_21010":125271,"_5":14420,"_27589":124746,"_2954":125272},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3471":73173,"_30355":72971,"_21010":125274,"_5":14420,"_27589":124746,"_2954":125275},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3471":73174,"_30355":72971,"_21010":125277,"_5":14420,"_27589":124750,"_2954":125278},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3471":73175,"_30355":72971,"_21010":125280,"_5":14420,"_27589":124750,"_2954":125281},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3471":73176,"_30355":72971,"_21010":125283,"_5":14420,"_27589":124750,"_2954":125284},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3471":73177,"_30355":72971,"_21010":125286,"_5":14420,"_27589":124754,"_2954":125287},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3471":73178,"_30355":72971,"_21010":125289,"_5":14420,"_27589":124758,"_2954":125290},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3471":73179,"_30355":72971,"_21010":125292,"_5":14420,"_27589":124762,"_2954":125293},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3471":73180,"_30355":72971,"_21010":125295,"_5":14420,"_27589":124766,"_2954":125296},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3471":73181,"_30355":72971,"_21010":125298,"_5":14420,"_27589":124766,"_2954":125299},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3471":73182,"_30355":72971,"_21010":125301,"_5":14420,"_27589":124766,"_2954":125302},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3471":73183,"_30355":72971,"_21010":125304,"_5":14420,"_27589":124766,"_2954":125305},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3471":73184,"_30355":72971,"_21010":125307,"_5":14420,"_27589":124770,"_2954":125308},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3471":73185,"_30355":72971,"_21010":125310,"_5":14420,"_27589":124774,"_2954":125311},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3471":73186,"_30355":72971,"_21010":125313,"_5":14420,"_27589":124774,"_2954":125314},[],"Ruta",{"_3471":73187,"_30355":72971,"_21010":125316,"_5":14420,"_27589":124774,"_2954":117859},[],{"_3471":73188,"_30355":72971,"_21010":125318,"_5":14420,"_27589":124774,"_2954":58288},[],{"_3471":73189,"_30355":72971,"_21010":125320,"_5":14420,"_27589":124774,"_2954":125321},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3471":73190,"_30355":72971,"_21010":125323,"_5":14420,"_27589":124774,"_2954":58294},[],{"_3471":73191,"_30355":72971,"_21010":125325,"_5":14420,"_27589":124774,"_2954":125326},[],"Lee los ajustes de una CA.",{"_3471":73192,"_30355":72971,"_21010":125328,"_5":14420,"_27589":124774,"_2954":58300},[],{"_3471":73193,"_30355":72971,"_21010":125330,"_5":14420,"_27589":124774,"_2954":125331},[],"Sustituye los `crl_options`.",{"_3471":73194,"_30355":72971,"_21010":125333,"_5":14420,"_27589":124774,"_2954":125334},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3471":73195,"_30355":72971,"_21010":125336,"_5":14420,"_27589":124774,"_2954":125337},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3471":73196,"_30355":72971,"_21010":125339,"_5":14420,"_27589":124774,"_2954":125340},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3471":73197,"_30355":72971,"_21010":125342,"_5":14420,"_27589":124774,"_2954":125343},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3471":73198,"_30355":72971,"_21010":125345,"_5":14420,"_27589":124774,"_2954":125346},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3471":73199,"_30355":72971,"_21010":125348,"_5":14420,"_27589":124774,"_2954":125349},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3471":73200,"_30355":72971,"_21010":125351,"_5":14420,"_27589":124774,"_2954":125352},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3471":73201,"_30355":72971,"_21010":125354,"_5":14420,"_27589":124774,"_2954":125355},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3471":73202,"_30355":72971,"_21010":125357,"_5":14420,"_27589":124774,"_2954":125358},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3471":73203,"_30355":72971,"_21010":125360,"_5":14420,"_27589":124774,"_2954":125361},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3471":73204,"_30355":72971,"_21010":125363,"_5":14420,"_27589":124774,"_2954":125364},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3471":73205,"_30355":72971,"_21010":125366,"_5":14420,"_27589":124778,"_2954":125367},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3471":73206,"_30355":72971,"_21010":125369,"_5":14420,"_27589":124782,"_2954":125370},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3471":73207,"_30355":72971,"_21010":125372,"_5":14420,"_27589":124786,"_2954":125373},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3471":73208,"_30355":72971,"_21010":125375,"_5":14420,"_27589":124790,"_2954":125376},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3471":73209,"_30355":72971,"_21010":125378,"_5":14420,"_27589":124794,"_2954":125379},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3471":73210,"_30355":72971,"_21010":125381,"_5":14420,"_27589":124794,"_2954":125382},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3471":73211,"_30355":72971,"_21010":125384,"_5":14420,"_27589":124794,"_2954":125385},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3471":73212,"_30355":72971,"_21010":125387,"_5":14420,"_27589":124794,"_2954":125388},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3471":73213,"_30355":72971,"_21010":125390,"_5":14420,"_27589":124794,"_2954":125391},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3471":73214,"_30355":72971,"_21010":125393,"_5":14420,"_27589":124794,"_2954":125394},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3471":73215,"_30355":72971,"_21010":125396,"_5":14420,"_27589":124798,"_2954":125397},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3471":73216,"_30355":72971,"_21010":125399,"_5":14420,"_27589":124798,"_2954":125400},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3471":73217,"_30355":72971,"_21010":125402,"_5":14420,"_27589":124798,"_2954":125403},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3471":73218,"_30355":72971,"_21010":125405,"_5":14420,"_27589":124798,"_2954":125406},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3471":73219,"_30355":72971,"_21010":125408,"_5":14420,"_27589":124798,"_2954":125409},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3471":73220,"_30355":72971,"_21010":125411,"_5":14420,"_27589":124802,"_2954":125412},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3471":73221,"_30355":72971,"_21010":125414,"_5":14420,"_27589":124802,"_2954":125415},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3471":73222,"_30355":72971,"_21010":125417,"_5":14420,"_27589":124802,"_2954":125418},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3471":73223,"_30355":72971,"_21010":125420,"_5":14420,"_27589":124802,"_2954":125421},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3471":73224,"_30355":72971,"_21010":125423,"_5":14420,"_27589":124802,"_2954":125424},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3471":73225,"_30355":72971,"_21010":125426,"_5":14420,"_27589":124802,"_2954":125427},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3471":73226,"_30355":72971,"_21010":125429,"_5":14420,"_27589":124802,"_2954":125430},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3471":73227,"_30355":72971,"_21010":125432,"_5":14420,"_27589":124802,"_2954":125433},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3471":73228,"_30355":72971,"_21010":125435,"_5":14420,"_27589":124802,"_2954":125436},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3471":73229,"_30355":72971,"_21010":125438,"_5":14420,"_27589":124802,"_2954":125439},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3471":73230,"_30355":72971,"_21010":125441,"_5":14420,"_27589":124802,"_2954":125442},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3471":73231,"_30355":72971,"_21010":125444,"_5":14420,"_27589":124802,"_2954":125445},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3471":73232,"_30355":72971,"_21010":125447,"_5":14420,"_27589":124806,"_2954":125448},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3471":73233,"_30355":72971,"_21010":125450,"_5":14420,"_27589":124806,"_2954":125451},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3471":73234,"_30355":72971,"_21010":125453,"_5":14420,"_27589":124810,"_2954":125454},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3471":73235,"_30355":72971,"_21010":125456,"_5":14420,"_27589":124810,"_2954":125457},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3471":73236,"_30355":72971,"_21010":125459,"_5":14420,"_27589":124810,"_2954":125460},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3471":73237,"_30355":72971,"_21010":125462,"_5":14420,"_27589":124810,"_2954":125463},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3471":73238,"_30355":72971,"_21010":125465,"_5":14420,"_27589":124810,"_2954":125466},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3471":73239,"_30355":72971,"_21010":125468,"_5":14420,"_27589":124810,"_2954":125469},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3471":73240,"_30355":72971,"_21010":125471,"_5":14420,"_27589":124810,"_2954":125472},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3471":73241,"_30355":72971,"_21010":125474,"_5":14420,"_27589":124810,"_2954":125475},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3471":73242,"_30355":72971,"_21010":125477,"_5":14420,"_27589":124810,"_2954":125478},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3471":73243,"_30355":72971,"_21010":125480,"_5":14420,"_27589":124810,"_2954":125481},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3471":73244,"_30355":72971,"_21010":125483,"_5":14420,"_27589":124810,"_2954":125484},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3471":73245,"_30355":72971,"_21010":125486,"_5":14420,"_27589":124814,"_2954":125487},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3471":73246,"_30355":72971,"_21010":125489,"_5":14420,"_27589":124814,"_2954":125490},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3471":73247,"_30355":72971,"_21010":125492,"_5":14420,"_27589":124818,"_2954":125493},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3471":73248,"_30355":72971,"_21010":125495,"_5":14420,"_27589":124818,"_2954":125496},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3471":73249,"_30355":72971,"_21010":125498,"_5":14420,"_27589":124818,"_2954":125499},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` también requiere que `ca` se haya migrado primero.",{"_3471":73250,"_30355":72971,"_21010":125501,"_5":14420,"_27589":124818,"_2954":125502},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates` y `SELECT` sobre `ca.ca_certificates`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`.",{"_3471":73251,"_30355":72971,"_21010":125504,"_5":14420,"_27589":124818,"_2954":125505},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3471":73252,"_30355":72971,"_21010":125507,"_5":14420,"_27589":124818,"_2954":125508},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3471":73253,"_30355":72971,"_21010":125510,"_5":14420,"_27589":124818,"_2954":125511},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3471":73254,"_30355":72971,"_21010":125513,"_5":14420,"_27589":124818,"_2954":125514},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3471":73255,"_30355":72971,"_21010":125516,"_5":14420,"_27589":124822,"_2954":125517},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3471":73256,"_30355":72971,"_21010":125519,"_5":14420,"_27589":124822,"_2954":125520},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3471":73257,"_30355":72971,"_21010":125522,"_5":14420,"_27589":124822,"_2954":125523},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3471":73258,"_30355":72971,"_21010":125525,"_5":14420,"_27589":124822,"_2954":125526},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3471":73259,"_30355":72971,"_21010":125528,"_5":14420,"_27589":124822,"_2954":125529},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3471":73260,"_30355":72971,"_21010":125531,"_5":14420,"_27589":124822,"_2954":125532},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3471":73261,"_30355":72971,"_21010":125534,"_5":14420,"_27589":124822,"_2954":125535},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3471":73262,"_30355":72971,"_21010":125537,"_5":14420,"_27589":124822,"_2954":125538},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que la del esquema `ca`.",{"_3471":73263,"_30355":72971,"_21010":125540,"_5":14420,"_27589":124822,"_2954":125541},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3471":73264,"_30355":72971,"_21010":125543,"_5":14420,"_27589":124822,"_2954":125544},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3471":73265,"_30355":72971,"_21010":125546,"_5":14420,"_27589":124822,"_2954":125547},[],"**Una migración o un servicio falla con `permission denied for table ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración. Concede los privilegios que falten y vuelve a ejecutar.",{"_3471":73266,"_30355":72971,"_21010":125549,"_5":14420,"_27589":124825,"_2954":125550},[],"Tras la actualización, comprueba en este orden:",{"_3471":73267,"_30355":72971,"_21010":125552,"_5":14420,"_27589":124825,"_2954":125553},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3471":73268,"_30355":72971,"_21010":125555,"_5":14420,"_27589":124825,"_2954":125556},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3471":73269,"_30355":72971,"_21010":125558,"_5":14420,"_27589":124825,"_2954":125559},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3471":73270,"_30355":72971,"_21010":125561,"_5":14420,"_27589":124825,"_2954":125562},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3471":73271,"_30355":72971,"_21010":125564,"_5":14420,"_27589":124825,"_2954":125565},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3471":73272,"_30355":72971,"_21010":125567,"_5":14420,"_27589":124825,"_2954":125568},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3471":73273,"_30355":72971,"_21010":125570,"_5":14420,"_27589":124825,"_2954":125571},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3471":73274,"_30355":72971,"_21010":125573,"_5":14420,"_27589":124825,"_2954":125574},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3471":73275,"_30355":72971,"_21010":125576,"_5":14420,"_27589":124825,"_2954":125577},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3471":73276,"_30355":72971,"_21010":125579,"_5":14420,"_27589":124825,"_2954":125580},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3471":73277,"_30355":72971,"_21010":125582,"_5":14420,"_27589":124825,"_2954":125583},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3471":73278,"_30355":72971,"_21010":125585,"_5":14420,"_27589":124825,"_2954":125586},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3471":73279,"_30355":72971,"_21010":125588,"_5":14420,"_27589":124825,"_2954":125589},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3471":73280,"_30355":72971,"_21010":125591,"_5":14420,"_27589":124825,"_2954":125592},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3471":73281,"_30355":72971,"_21010":125594,"_5":14420,"_27589":124825,"_2954":125595},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3471":73282,"_30355":72971,"_21010":125597,"_5":14420,"_27589":124829,"_2954":125598},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3471":73283,"_30355":72971,"_21010":125600,"_5":14420,"_27589":124829,"_2954":125601},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3471":73284,"_30355":72971,"_21010":125603,"_5":14420,"_27589":124829,"_2954":125604},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3471":73285,"_30355":72971,"_21010":125606,"_5":14420,"_27589":124829,"_2954":125607},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3471":73286,"_30355":72971,"_21010":125609,"_5":14420,"_27589":124829,"_2954":125610},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_58585":125612,"_58587":125613,"_58589":125614,"_58591":125615,"_18204":2989,"_70346":2989},"spanish",[2954,30355,5,27589],{"_2954":25132,"_30355":25132,"_5":25132,"_27589":25132},{"_2954":125616,"_30355":128553,"_5":131490,"_27589":134427},{"_4653":125617,"_58595":125618,"_5":25132},{"_14496":10500,"_14883":4620,"_14902":7236,"_29358":3658,"_14889":5964,"_19930":8689,"_14517":6259,"_14524":24684,"_29300":20426,"_29709":3776,"_29730":7027,"_29334":7064,"_34675":12310,"_29437":20421,"_29774":9901,"_34682":22923,"_34685":4601,"_34688":3391,"_34691":14125,"_30181":3460,"_34696":16857,"_34698":7610,"_30211":15848,"_14898":8889,"_34702":7536,"_34705":6616,"_34707":11239,"_29758":3372,"_30176":4226,"_30224":5858,"_34712":6527,"_34714":7641,"_34716":3955,"_29454":6407,"_34719":6004,"_34721":4322,"_34723":7862,"_34725":7173,"_34727":7631,"_29371":4782,"_34730":4014,"_34732":5843,"_29365":8845,"_29795":5644,"_34736":16343,"_34738":11123,"_34741":5267,"_29411":6981,"_34745":4975,"_29291":9959,"_34748":7522,"_29339":7676,"_34751":11801,"_34753":11331,"_34756":5323,"_14892":23954,"_34759":5968,"_34761":4396,"_34764":4658,"_34766":22002,"_34768":22881,"_34770":7703,"_34772":4965,"_19933":3438,"_34775":10171,"_34777":4600,"_29312":7032,"_29752":4744,"_34781":10528,"_34783":3995,"_34785":15849,"_30241":28876,"_34788":11637,"_34790":4059,"_34792":11374,"_30335":5993,"_29811":4626,"_34796":6374,"_34798":12131,"_29349":8383,"_34801":4098,"_34803":6995,"_34805":5245,"_30257":16889,"_29431":6215,"_28812":7035,"_34810":4143,"_34812":7602,"_34814":4996,"_29480":18286,"_34818":4770,"_29746":25220,"_34822":13333,"_34824":5529,"_34826":5170,"_34828":5997,"_34830":3303,"_34832":4438,"_29469":6408,"_29714":6504,"_34836":3817,"_34838":3780,"_34840":19267,"_34843":7666,"_34845":7710,"_34847":5957,"_3