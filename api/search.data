158":37124,"_27160":37127,"_27162":37130,"_27164":37133,"_27166":37136,"_27168":37139,"_27170":37142,"_27172":37145,"_27174":37148,"_27176":37151,"_27178":37154,"_27180":37157,"_27182":37159,"_27184":37162,"_27186":37164,"_27188":37167,"_27190":37170,"_27192":37173,"_27194":37176,"_27196":37178,"_27198":37181,"_27200":37184,"_27202":37187,"_27204":37190,"_27206":37193,"_27208":37196,"_27210":37199,"_27212":37203,"_27214":37206,"_27216":37210,"_27218":37214,"_27220":37218,"_27222":37222,"_27224":37226,"_27226":37229,"_27228":37232,"_27230":37235,"_27232":37238,"_27234":37241,"_27236":37244,"_27238":37247,"_27240":37250,"_27242":37253,"_27244":37256,"_27246":37259,"_27248":37261,"_27250":37263,"_27252":37265,"_27254":37267,"_27256":37270,"_27258":37273,"_27260":37276,"_27262":37279,"_27264":37282,"_27266":37285,"_27268":37288,"_27270":37291,"_27272":37294,"_27274":37297,"_27276":37300,"_27278":37302,"_27280":37306,"_27282":37309,"_27284":37313,"_27286":37316,"_27288":37319,"_27290":37321,"_27292":37323,"_27294":37326,"_27296":37329,"_27298":37332,"_27300":37335,"_27302":37338,"_27304":37341,"_27306":37344,"_27308":37347,"_27310":37350,"_27312":37353,"_27314":37356,"_27316":37360,"_27318":37364,"_27320":37368,"_27322":37371,"_27324":37374,"_27326":37377,"_27328":37380},{"_3684":11,"_21620":11,"_5":21794,"_1666":32335,"_21807":32336,"_18607":32340,"_8577":11},"Despliega desde AWS Marketplace",[32337,32338,32339],"Docs","Despliegue","AWS Marketplace",[],{"_3684":12,"_21620":11,"_18607":32342,"_5":21799,"_8577":11,"_1666":32343},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3684":13,"_21620":11,"_5":21804,"_18607":32345,"_8577":32346,"_1666":32347},[],"/docs/despliegue/cloud#antes-de-empezar","Antes de empezar",{"_3684":14,"_21620":11,"_5":21804,"_18607":32349,"_8577":32350,"_1666":32351},[],"/docs/despliegue/cloud#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3684":15,"_21620":11,"_5":21804,"_18607":32353,"_8577":32354,"_1666":32355},[],"/docs/despliegue/cloud#abre-la-oferta","Abre la oferta",{"_3684":16,"_21620":11,"_5":21804,"_18607":32357,"_8577":32358,"_1666":32359},[],"/docs/despliegue/cloud#configura-la-instancia","Configura la instancia",{"_3684":17,"_21620":11,"_5":21804,"_18607":32361,"_8577":32362,"_1666":32363},[],"/docs/despliegue/cloud#limita-el-acceso-de-red","Limita el acceso de red",{"_3684":18,"_21620":11,"_5":21804,"_18607":32365,"_8577":32366,"_1666":32367},[],"/docs/despliegue/cloud#lanza-y-verifica","Lanza y verifica",{"_3684":19,"_21620":11,"_5":21804,"_18607":32369,"_8577":32370,"_1666":32371},[],"/docs/despliegue/cloud#siguiente-paso","Siguiente paso",{"_3684":20,"_21620":11,"_18607":32373,"_5":21799,"_8577":11,"_1666":32374},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3684":21,"_21620":11,"_18607":32376,"_5":21799,"_8577":32346,"_1666":32377},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3684":22,"_21620":11,"_18607":32379,"_5":21799,"_8577":32346,"_1666":32380},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3684":23,"_21620":11,"_18607":32382,"_5":21799,"_8577":32346,"_1666":32383},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3684":24,"_21620":11,"_18607":32385,"_5":21799,"_8577":32350,"_1666":32386},[],"Recurso",{"_3684":25,"_21620":11,"_18607":32388,"_5":21799,"_8577":32350,"_1666":32389},[],"Mínimo",{"_3684":26,"_21620":11,"_18607":32391,"_5":21799,"_8577":32350,"_1666":32392},[],"Recomendación",{"_3684":27,"_21620":11,"_18607":32394,"_5":21799,"_8577":32350,"_1666":32395},[],"Instancia",{"_3684":28,"_21620":11,"_18607":32397,"_5":21799,"_8577":32350,"_1666":32398},[],"`t3.large`",{"_3684":29,"_21620":11,"_18607":32400,"_5":21799,"_8577":32350,"_1666":32401},[],"`t3.xlarge` o superior según la carga",{"_3684":30,"_21620":11,"_18607":32403,"_5":21799,"_8577":32350,"_1666":32404},[],"Volumen",{"_3684":31,"_21620":11,"_18607":32406,"_5":21799,"_8577":32350,"_1666":32407},[],"EBS `gp3`, 50 GB",{"_3684":32,"_21620":11,"_18607":32409,"_5":21799,"_8577":32350,"_1666":32410},[],"Ajustar al inventario y la retención",{"_3684":33,"_21620":11,"_18607":32412,"_5":21799,"_8577":32350,"_1666":32413},[],"Red",{"_3684":34,"_21620":11,"_18607":32415,"_5":21799,"_8577":32350,"_1666":32416},[],"HTTPS accesible",{"_3684":35,"_21620":11,"_18607":32418,"_5":21799,"_8577":32350,"_1666":32419},[],"Restringir el acceso a redes de confianza",{"_3684":36,"_21620":11,"_18607":32421,"_5":21799,"_8577":32354,"_1666":32422},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3684":37,"_21620":11,"_18607":32424,"_5":21799,"_8577":32358,"_1666":32425},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3684":38,"_21620":11,"_18607":32427,"_5":21799,"_8577":32362,"_1666":32428},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3684":39,"_21620":11,"_18607":32430,"_5":21799,"_8577":32366,"_1666":32431},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3684":40,"_21620":11,"_18607":32433,"_5":21799,"_8577":32370,"_1666":32434},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3684":41,"_21620":41,"_5":21794,"_1666":32436,"_21807":32437,"_18607":32438,"_8577":41},"Despliega Lamassu",[32337,32338],[],{"_3684":42,"_21620":41,"_18607":32440,"_5":21799,"_8577":41,"_1666":32441},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3684":43,"_21620":41,"_5":21804,"_18607":32443,"_8577":32444,"_1666":32445},[],"/docs/despliegue#elige-un-modelo","Elige un modelo",{"_3684":44,"_21620":41,"_5":21804,"_18607":32447,"_8577":32448,"_1666":32449},[],"/docs/despliegue#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3684":45,"_21620":41,"_5":21804,"_18607":32451,"_8577":32452,"_1666":32453},[],"/docs/despliegue#después-del-despliegue","Después del despliegue",{"_3684":46,"_21620":41,"_18607":32455,"_5":21799,"_8577":41,"_1666":32456},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3684":47,"_21620":41,"_18607":32458,"_5":21799,"_8577":32444,"_1666":32459},[],"Modelo",{"_3684":48,"_21620":41,"_18607":32461,"_5":21799,"_8577":32444,"_1666":32462},[],"Recomendado para",{"_3684":49,"_21620":41,"_18607":32464,"_5":21799,"_8577":32444,"_1666":32465},[],"Quién opera la infraestructura",{"_3684":50,"_21620":41,"_18607":32467,"_5":21799,"_8577":32444,"_1666":32468},[],"Punto de partida",{"_3684":51,"_21620":41,"_18607":32470,"_5":21799,"_8577":32444,"_1666":32471},[],"Kubernetes self-managed",{"_3684":52,"_21620":41,"_18607":32473,"_5":21799,"_8577":32444,"_1666":32474},[],"Producción, entornos regulados y despliegues personalizados",{"_3684":53,"_21620":41,"_18607":32476,"_5":21799,"_8577":32444,"_1666":32477},[],"Tu equipo",{"_3684":54,"_21620":41,"_18607":32479,"_5":21799,"_8577":32444,"_1666":32480},[],"Helm o Fastlane",{"_3684":55,"_21620":41,"_18607":32482,"_5":21799,"_8577":32444,"_1666":32339},[],{"_3684":56,"_21620":41,"_18607":32484,"_5":21799,"_8577":32444,"_1666":32485},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3684":57,"_21620":41,"_18607":32487,"_5":21799,"_8577":32444,"_1666":32477},[],{"_3684":58,"_21620":41,"_18607":32489,"_5":21799,"_8577":32444,"_1666":32490},[],"Imagen preconfigurada en EC2",{"_3684":59,"_21620":41,"_18607":32492,"_5":21799,"_8577":32444,"_1666":32493},[],"SaaS",{"_3684":60,"_21620":41,"_18607":32495,"_5":21799,"_8577":32444,"_1666":32496},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3684":61,"_21620":41,"_18607":32498,"_5":21799,"_8577":32444,"_1666":32499},[],"Lamassu",{"_3684":62,"_21620":41,"_18607":32501,"_5":21799,"_8577":32444,"_1666":32502},[],"Suscripción gestionada",{"_3684":63,"_21620":41,"_18607":32504,"_5":21799,"_8577":32444,"_1666":32505},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/despliegue/onprem\" />",{"_3684":64,"_21620":41,"_18607":32507,"_5":21799,"_8577":32444,"_1666":32508},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/despliegue/cloud\" />",{"_3684":65,"_21620":41,"_18607":32510,"_5":21799,"_8577":32444,"_1666":32511},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/despliegue/saas\" />",{"_3684":66,"_21620":41,"_18607":32513,"_5":21799,"_8577":32448,"_1666":32514},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3684":67,"_21620":41,"_18607":32516,"_5":21799,"_8577":32452,"_1666":32517},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3684":68,"_21620":68,"_5":21794,"_1666":32519,"_21807":32520,"_18607":32521,"_8577":68},"Fastlane",[32337,32338,32471],[],{"_3684":69,"_21620":68,"_18607":32523,"_5":21799,"_8577":68,"_1666":32524},[],"Referencia del script scripts/lamassu-fast-lane.sh para desplegar Lamassu PKI de forma automatizada en Kubernetes",{"_3684":70,"_21620":68,"_5":21804,"_18607":32526,"_8577":32527,"_1666":32528},[],"/docs/despliegue/onprem/fastlane#fastlane---despliegue-automatizado-en-kubernetes","Fastlane - Despliegue automatizado en Kubernetes",{"_3684":71,"_21620":68,"_5":21804,"_18607":32530,"_8577":32531,"_1666":32532},[],"/docs/despliegue/onprem/fastlane#flags-de-línea-de-comandos","Flags de línea de comandos",{"_3684":72,"_21620":68,"_5":21804,"_18607":32534,"_8577":32535,"_1666":32536},[],"/docs/despliegue/onprem/fastlane#detección-de-distribución-kubernetes","Detección de distribución Kubernetes",{"_3684":73,"_21620":68,"_5":21804,"_18607":32538,"_8577":32539,"_1666":32540},[],"/docs/despliegue/onprem/fastlane#verificación-de-dependencias","Verificación de dependencias",{"_3684":74,"_21620":68,"_5":21804,"_18607":32542,"_8577":32543,"_1666":32544},[],"/docs/despliegue/onprem/fastlane#addons-obligatorios-en-microk8s","Addons obligatorios en MicroK8s",{"_3684":75,"_21620":68,"_5":21804,"_18607":32546,"_8577":32547,"_1666":32548},[],"/docs/despliegue/onprem/fastlane#modo-interactivo-vs-no-interactivo","Modo interactivo vs no interactivo",{"_3684":76,"_21620":68,"_5":21804,"_18607":32550,"_8577":32551,"_1666":32552},[],"/docs/despliegue/onprem/fastlane#modo-interactivo-por-defecto","Modo interactivo (por defecto)",{"_3684":77,"_21620":68,"_5":21804,"_18607":32554,"_8577":32555,"_1666":32556},[],"/docs/despliegue/onprem/fastlane#modo-no-interactivo--n","Modo no interactivo (`-n`)",{"_3684":78,"_21620":68,"_5":21804,"_18607":32558,"_8577":32559,"_1666":32560},[],"/docs/despliegue/onprem/fastlane#modo-online-vs-offline","Modo online vs offline",{"_3684":79,"_21620":68,"_5":21804,"_18607":32562,"_8577":32563,"_1666":32564},[],"/docs/despliegue/onprem/fastlane#modo-online-por-defecto","Modo online (por defecto)",{"_3684":80,"_21620":68,"_5":21804,"_18607":32566,"_8577":32567,"_1666":32568},[],"/docs/despliegue/onprem/fastlane#modo-offline","Modo offline",{"_3684":81,"_21620":68,"_5":21804,"_18607":32570,"_8577":32571,"_1666":32572},[],"/docs/despliegue/onprem/fastlane#instalación-de-componentes","Instalación de componentes",{"_3684":82,"_21620":68,"_5":21804,"_18607":32574,"_8577":32575,"_1666":32576},[],"/docs/despliegue/onprem/fastlane#postgresql-install_postgresql","PostgreSQL (`install_postgresql`)",{"_3684":83,"_21620":68,"_5":21804,"_18607":32578,"_8577":32579,"_1666":32580},[],"/docs/despliegue/onprem/fastlane#keycloak-install_keycloak","Keycloak (`install_keycloak`)",{"_3684":84,"_21620":68,"_5":21804,"_18607":32582,"_8577":32583,"_1666":32584},[],"/docs/despliegue/onprem/fastlane#rabbitmq-install_rabbitmq","RabbitMQ (`install_rabbitmq`)",{"_3684":85,"_21620":68,"_5":21804,"_18607":32586,"_8577":32587,"_1666":32588},[],"/docs/despliegue/onprem/fastlane#lamassu-install_lamassu","Lamassu (`install_lamassu`)",{"_3684":86,"_21620":68,"_5":21804,"_18607":32590,"_8577":32591,"_1666":32592},[],"/docs/despliegue/onprem/fastlane#configuración-tls","Configuración TLS",{"_3684":87,"_21620":68,"_5":21804,"_18607":32594,"_8577":32595,"_1666":32596},[],"/docs/despliegue/onprem/fastlane#certificado-externo","Certificado externo",{"_3684":88,"_21620":68,"_5":21804,"_18607":32598,"_8577":32599,"_1666":32600},[],"/docs/despliegue/onprem/fastlane#certificado-gestionado-por-cert-manager","Certificado gestionado por cert-manager",{"_3684":89,"_21620":68,"_5":21804,"_18607":32602,"_8577":32603,"_1666":32604},[],"/docs/despliegue/onprem/fastlane#salida-tras-la-instalación","Salida tras la instalación",{"_3684":90,"_21620":68,"_5":21804,"_18607":32606,"_8577":32607,"_1666":32608},[],"/docs/despliegue/onprem/fastlane#uso-en-ci","Uso en CI",{"_3684":91,"_21620":68,"_5":21804,"_18607":32610,"_8577":32611,"_1666":32612},[],"/docs/despliegue/onprem/fastlane#ejemplo-rápido","Ejemplo rápido",{"_3684":92,"_21620":68,"_5":21804,"_18607":32614,"_8577":32615,"_1666":32616},[],"/docs/despliegue/onprem/fastlane#resumen","Resumen",{"_3684":93,"_21620":68,"_18607":32618,"_5":21799,"_8577":32527,"_1666":32619},[],"Esta sección documenta el script `scripts/lamassu-fast-lane.sh`, cuyo objetivo es desplegar de forma automatizada una pila completa de Lamassu PKI sobre un clúster Kubernetes ya existente, con intervención manual mínima.",{"_3684":94,"_21620":68,"_18607":32621,"_5":21799,"_8577":32527,"_1666":32622},[],"La instalación incluye:",{"_3684":95,"_21620":68,"_18607":32624,"_5":21799,"_8577":32527,"_1666":32625},[],"PostgreSQL",{"_3684":96,"_21620":68,"_18607":32627,"_5":21799,"_8577":32527,"_1666":32628},[],"Keycloak",{"_3684":97,"_21620":68,"_18607":32630,"_5":21799,"_8577":32527,"_1666":32631},[],"RabbitMQ",{"_3684":98,"_21620":68,"_18607":32633,"_5":21799,"_8577":32527,"_1666":32634},[],"Chart Helm de Lamassu",{"_3684":99,"_21620":68,"_18607":32636,"_5":21799,"_8577":32531,"_1666":32637},[],"Todos los parámetros son procesados por la función `process_flags`.",{"_3684":100,"_21620":68,"_18607":32639,"_5":21799,"_8577":32531,"_1666":32640},[],"Flag",{"_3684":101,"_21620":68,"_18607":32642,"_5":21799,"_8577":32531,"_1666":32643},[],"Valor por defecto",{"_3684":102,"_21620":68,"_18607":32645,"_5":21799,"_8577":32531,"_1666":32646},[],"Descripción",{"_3684":103,"_21620":68,"_18607":32648,"_5":21799,"_8577":32531,"_1666":32649},[],"`-h`, `--help`",{"_3684":104,"_21620":68,"_18607":32651,"_5":21799,"_8577":32531,"_1666":3105},[],{"_3684":105,"_21620":68,"_18607":32653,"_5":21799,"_8577":32531,"_1666":32654},[],"Muestra la ayuda y finaliza",{"_3684":106,"_21620":68,"_18607":32656,"_5":21799,"_8577":32531,"_1666":32657},[],"`-n`, `--non-interactive`",{"_3684":107,"_21620":68,"_18607":32659,"_5":21799,"_8577":32531,"_1666":32660},[],"`false`",{"_3684":108,"_21620":68,"_18607":32662,"_5":21799,"_8577":32531,"_1666":32663},[],"Omite prompts y genera/usa credenciales por defecto",{"_3684":109,"_21620":68,"_18607":32665,"_5":21799,"_8577":32531,"_1666":32666},[],"`-ns`, `--namespace`",{"_3684":110,"_21620":68,"_18607":32668,"_5":21799,"_8577":32531,"_1666":32669},[],"`lamassu-dev`",{"_3684":111,"_21620":68,"_18607":32671,"_5":21799,"_8577":32531,"_1666":32672},[],"Namespace Kubernetes donde se despliegan los recursos",{"_3684":112,"_21620":68,"_18607":32674,"_5":21799,"_8577":32531,"_1666":32675},[],"`-d`, `--domain`",{"_3684":113,"_21620":68,"_18607":32677,"_5":21799,"_8577":32531,"_1666":32678},[],"`dev.lamassu.io`",{"_3684":114,"_21620":68,"_18607":32680,"_5":21799,"_8577":32531,"_1666":32681},[],"Dominio usado para endpoint y certificados TLS",{"_3684":115,"_21620":68,"_18607":32683,"_5":21799,"_8577":32531,"_1666":32684},[],"`-v`, `--version`",{"_3684":116,"_21620":68,"_18607":32686,"_5":21799,"_8577":32531,"_1666":32687},[],"`latest`",{"_3684":117,"_21620":68,"_18607":32689,"_5":21799,"_8577":32531,"_1666":32690},[],"Versión del chart Helm de Lamassu",{"_3684":118,"_21620":68,"_18607":32692,"_5":21799,"_8577":32531,"_1666":32693},[],"`--https-port`",{"_3684":119,"_21620":68,"_18607":32695,"_5":21799,"_8577":32531,"_1666":32696},[],"`443`",{"_3684":120,"_21620":68,"_18607":32698,"_5":21799,"_8577":32531,"_1666":32699},[],"Puerto HTTPS del gateway",{"_3684":121,"_21620":68,"_18607":32701,"_5":21799,"_8577":32531,"_1666":32702},[],"`--http-port`",{"_3684":122,"_21620":68,"_18607":32704,"_5":21799,"_8577":32531,"_1666":32705},[],"`80`",{"_3684":123,"_21620":68,"_18607":32707,"_5":21799,"_8577":32531,"_1666":32708},[],"Puerto HTTP del gateway",{"_3684":124,"_21620":68,"_18607":32710,"_5":21799,"_8577":32531,"_1666":32711},[],"`--offline`",{"_3684":125,"_21620":68,"_18607":32713,"_5":21799,"_8577":32531,"_1666":32660},[],{"_3684":126,"_21620":68,"_18607":32715,"_5":21799,"_8577":32531,"_1666":32716},[],"Activa modo offline",{"_3684":127,"_21620":68,"_18607":32718,"_5":21799,"_8577":32531,"_1666":32719},[],"`--tls-crt`",{"_3684":128,"_21620":68,"_18607":32721,"_5":21799,"_8577":32531,"_1666":3105},[],{"_3684":129,"_21620":68,"_18607":32723,"_5":21799,"_8577":32531,"_1666":32724},[],"Ruta al certificado TLS (PEM)",{"_3684":130,"_21620":68,"_18607":32726,"_5":21799,"_8577":32531,"_1666":32727},[],"`--tls-key`",{"_3684":131,"_21620":68,"_18607":32729,"_5":21799,"_8577":32531,"_1666":3105},[],{"_3684":132,"_21620":68,"_18607":32731,"_5":21799,"_8577":32531,"_1666":32732},[],"Ruta a la clave privada TLS (PEM)",{"_3684":133,"_21620":68,"_18607":32734,"_5":21799,"_8577":32531,"_1666":32735},[],"`--helm-chart-lamassu`",{"_3684":134,"_21620":68,"_18607":32737,"_5":21799,"_8577":32531,"_1666":3105},[],{"_3684":135,"_21620":68,"_18607":32739,"_5":21799,"_8577":32531,"_1666":32740},[],"Ruta a chart local Lamassu (`.tgz`)",{"_3684":136,"_21620":68,"_18607":32742,"_5":21799,"_8577":32531,"_1666":32743},[],"`--helm-chart-postgres`",{"_3684":137,"_21620":68,"_18607":32745,"_5":21799,"_8577":32531,"_1666":3105},[],{"_3684":138,"_21620":68,"_18607":32747,"_5":21799,"_8577":32531,"_1666":32748},[],"Ruta a chart local PostgreSQL (`.tgz`)",{"_3684":139,"_21620":68,"_18607":32750,"_5":21799,"_8577":32531,"_1666":32751},[],"`--helm-chart-keycloak`",{"_3684":140,"_21620":68,"_18607":32753,"_5":21799,"_8577":32531,"_1666":3105},[],{"_3684":141,"_21620":68,"_18607":32755,"_5":21799,"_8577":32531,"_1666":32756},[],"Ruta a chart local Keycloak (`.tgz`)",{"_3684":142,"_21620":68,"_18607":32758,"_5":21799,"_8577":32531,"_1666":32759},[],"`--helm-chart-rabbitmq`",{"_3684":143,"_21620":68,"_18607":32761,"_5":21799,"_8577":32531,"_1666":3105},[],{"_3684":144,"_21620":68,"_18607":32763,"_5":21799,"_8577":32531,"_1666":32764},[],"Ruta a chart local RabbitMQ (`.tgz`)",{"_3684":145,"_21620":68,"_18607":32766,"_5":21799,"_8577":32531,"_1666":32767},[],"`-l`, `--local-chart-path`",{"_3684":146,"_21620":68,"_18607":32769,"_5":21799,"_8577":32531,"_1666":3105},[],{"_3684":147,"_21620":68,"_18607":32771,"_5":21799,"_8577":32531,"_1666":32772},[],"Ruta a directorio local descomprimido del chart Lamassu",{"_3684":148,"_21620":68,"_18607":32774,"_5":21799,"_8577":32535,"_1666":32775},[],"La función `detect_distribution` identifica la distribución con el siguiente orden de prioridad:",{"_3684":149,"_21620":68,"_18607":32777,"_5":21799,"_8577":32535,"_1666":32778},[],"`microk8s`",{"_3684":150,"_21620":68,"_18607":32780,"_5":21799,"_8577":32535,"_1666":32781},[],"`k3s`",{"_3684":151,"_21620":68,"_18607":32783,"_5":21799,"_8577":32535,"_1666":32784},[],"`kind`",{"_3684":152,"_21620":68,"_18607":32786,"_5":21799,"_8577":32535,"_1666":32787},[],"Kubernetes estándar",{"_3684":153,"_21620":68,"_18607":32789,"_5":21799,"_8577":32535,"_1666":32790},[],"Comportamientos específicos:",{"_3684":154,"_21620":68,"_18607":32792,"_5":21799,"_8577":32535,"_1666":32793},[],"En `microk8s`, los comandos se ejecutan con prefijos `microk8s kubectl` y `microk8s helm`.",{"_3684":155,"_21620":68,"_18607":32795,"_5":21799,"_8577":32535,"_1666":32796},[],"En `kind`, el script muestra una advertencia de uso exclusivo para pruebas.",{"_3684":156,"_21620":68,"_18607":32798,"_5":21799,"_8577":32539,"_1666":32799},[],"La función `check_dependencies` valida prerequisitos según la distribución detectada.",{"_3684":157,"_21620":68,"_18607":32801,"_5":21799,"_8577":32539,"_1666":32802},[],"Requisitos generales:",{"_3684":158,"_21620":68,"_18607":32804,"_5":21799,"_8577":32539,"_1666":32805},[],"`yq`",{"_3684":159,"_21620":68,"_18607":32807,"_5":21799,"_8577":32539,"_1666":32808},[],"CLI de la distribución detectada",{"_3684":160,"_21620":68,"_18607":32810,"_5":21799,"_8577":32539,"_1666":32811},[],"Requisitos específicos:",{"_3684":161,"_21620":68,"_18607":32813,"_5":21799,"_8577":32539,"_1666":32814},[],"Distribución",{"_3684":162,"_21620":68,"_18607":32816,"_5":21799,"_8577":32539,"_1666":32817},[],"Herramientas requeridas",{"_3684":163,"_21620":68,"_18607":32819,"_5":21799,"_8577":32539,"_1666":32781},[],{"_3684":164,"_21620":68,"_18607":32821,"_5":21799,"_8577":32539,"_1666":32822},[],"`kubectl`, `helm`",{"_3684":165,"_21620":68,"_18607":32824,"_5":21799,"_8577":32539,"_1666":32778},[],{"_3684":166,"_21620":68,"_18607":32826,"_5":21799,"_8577":32539,"_1666":32827},[],"`microk8s kubectl`, `microk8s helm`",{"_3684":167,"_21620":68,"_18607":32829,"_5":21799,"_8577":32543,"_1666":32830},[],"Se valida que estén habilitados:",{"_3684":168,"_21620":68,"_18607":32832,"_5":21799,"_8577":32543,"_1666":32833},[],"`helm`",{"_3684":169,"_21620":68,"_18607":32835,"_5":21799,"_8577":32543,"_1666":32836},[],"`hostpath-storage`",{"_3684":170,"_21620":68,"_18607":32838,"_5":21799,"_8577":32543,"_1666":32839},[],"`dns`",{"_3684":171,"_21620":68,"_18607":32841,"_5":21799,"_8577":32543,"_1666":32842},[],"`cert-manager`",{"_3684":172,"_21620":68,"_18607":32844,"_5":21799,"_8577":32543,"_1666":32845},[],"También se verifica un release Helm de Envoy Gateway llamado `eg` en el namespace `envoy-gateway-system`.\nSi no existe, se instala automáticamente la versión `v1.3.0` y se crea un `GatewayClass` llamado `eg`.",{"_3684":173,"_21620":68,"_18607":32847,"_5":21799,"_8577":32551,"_1666":32848},[],"La función `request_config_data` solicita:",{"_3684":174,"_21620":68,"_18607":32850,"_5":21799,"_8577":32551,"_1666":32851},[],"Dominio Lamassu",{"_3684":175,"_21620":68,"_18607":32853,"_5":21799,"_8577":32551,"_1666":32854},[],"Usuario y contraseña admin PostgreSQL",{"_3684":176,"_21620":68,"_18607":32856,"_5":21799,"_8577":32551,"_1666":32857},[],"Usuario y contraseña admin RabbitMQ",{"_3684":177,"_21620":68,"_18607":32859,"_5":21799,"_8577":32551,"_1666":32860},[],"Usuario y contraseña admin Keycloak",{"_3684":178,"_21620":68,"_18607":32862,"_5":21799,"_8577":32551,"_1666":32863},[],"Namespace Kubernetes",{"_3684":179,"_21620":68,"_18607":32865,"_5":21799,"_8577":32555,"_1666":32866},[],"Se generan credenciales aleatorias de 30 caracteres alfanuméricos.",{"_3684":180,"_21620":68,"_18607":32868,"_5":21799,"_8577":32555,"_1666":32869},[],"Se usan valores por defecto para dominio y namespace, salvo que se sobrescriban con flags.",{"_3684":181,"_21620":68,"_18607":32871,"_5":21799,"_8577":32559,"_1666":32872},[],"El script admite dos estrategias para obtener charts Helm.",{"_3684":182,"_21620":68,"_18607":32874,"_5":21799,"_8577":32563,"_1666":32875},[],"Los charts se descargan desde repositorios remotos.",{"_3684":183,"_21620":68,"_18607":32877,"_5":21799,"_8577":32567,"_1666":32878},[],"Requiere obligatoriamente rutas a los cuatro charts:",{"_3684":184,"_21620":68,"_18607":32880,"_5":21799,"_8577":32567,"_1666":32735},[],{"_3684":185,"_21620":68,"_18607":32882,"_5":21799,"_8577":32567,"_1666":32743},[],{"_3684":186,"_21620":68,"_18607":32884,"_5":21799,"_8577":32567,"_1666":32751},[],{"_3684":187,"_21620":68,"_18607":32886,"_5":21799,"_8577":32567,"_1666":32759},[],{"_3684":188,"_21620":68,"_18607":32888,"_5":21799,"_8577":32567,"_1666":32889},[],"Si falta cualquiera de ellos, el script finaliza con error.",{"_3684":189,"_21620":68,"_18607":32891,"_5":21799,"_8577":32567,"_1666":32892},[],"En este modo se fuerza:",{"_3684":190,"_21620":68,"_18607":32894,"_5":21799,"_8577":32575,"_1666":32895},[],"Chart: `oci://registry-1.docker.io/cloudpirates/postgres`",{"_3684":191,"_21620":68,"_18607":32897,"_5":21799,"_8577":32575,"_1666":32898},[],"Versión del chart: `0.19.0`",{"_3684":192,"_21620":68,"_18607":32900,"_5":21799,"_8577":32575,"_1666":32901},[],"Release: `postgres`",{"_3684":193,"_21620":68,"_18607":32903,"_5":21799,"_8577":32575,"_1666":32904},[],"`fullnameOverride: \"postgresql\"`",{"_3684":194,"_21620":68,"_18607":32906,"_5":21799,"_8577":32575,"_1666":32907},[],"Se crea un script SQL de inicialización con estas bases de datos:",{"_3684":195,"_21620":68,"_18607":32909,"_5":21799,"_8577":32575,"_1666":32910},[],"Base de datos",{"_3684":196,"_21620":68,"_18607":32912,"_5":21799,"_8577":32575,"_1666":32913},[],"Servicio",{"_3684":197,"_21620":68,"_18607":32915,"_5":21799,"_8577":32575,"_1666":32916},[],"`auth`",{"_3684":198,"_21620":68,"_18607":32918,"_5":21799,"_8577":32575,"_1666":32628},[],{"_3684":199,"_21620":68,"_18607":32920,"_5":21799,"_8577":32575,"_1666":32921},[],"`alerts`",{"_3684":200,"_21620":68,"_18607":32923,"_5":21799,"_8577":32575,"_1666":32924},[],"Alerts",{"_3684":201,"_21620":68,"_18607":32926,"_5":21799,"_8577":32575,"_1666":32927},[],"`ca`",{"_3684":202,"_21620":68,"_18607":32929,"_5":21799,"_8577":32575,"_1666":32930},[],"CA",{"_3684":203,"_21620":68,"_18607":32932,"_5":21799,"_8577":32575,"_1666":32933},[],"`va`",{"_3684":204,"_21620":68,"_18607":32935,"_5":21799,"_8577":32575,"_1666":32936},[],"VA",{"_3684":205,"_21620":68,"_18607":32938,"_5":21799,"_8577":32575,"_1666":32939},[],"`cloudproxy`",{"_3684":206,"_21620":68,"_18607":32941,"_5":21799,"_8577":32575,"_1666":32942},[],"Cloud Proxy",{"_3684":207,"_21620":68,"_18607":32944,"_5":21799,"_8577":32575,"_1666":32945},[],"`devicemanager`",{"_3684":208,"_21620":68,"_18607":32947,"_5":21799,"_8577":32575,"_1666":32948},[],"Device Manager",{"_3684":209,"_21620":68,"_18607":32950,"_5":21799,"_8577":32575,"_1666":32951},[],"`dmsmanager`",{"_3684":210,"_21620":68,"_18607":32953,"_5":21799,"_8577":32575,"_1666":32954},[],"DMS Manager",{"_3684":211,"_21620":68,"_18607":32956,"_5":21799,"_8577":32575,"_1666":32957},[],"`kms`",{"_3684":212,"_21620":68,"_18607":32959,"_5":21799,"_8577":32575,"_1666":32960},[],"KMS",{"_3684":213,"_21620":68,"_18607":32962,"_5":21799,"_8577":32579,"_1666":32963},[],"Chart: `oci://registry-1.docker.io/cloudpirates/keycloak`",{"_3684":214,"_21620":68,"_18607":32965,"_5":21799,"_8577":32579,"_1666":32966},[],"Versión del chart: `0.20.0`",{"_3684":215,"_21620":68,"_18607":32968,"_5":21799,"_8577":32579,"_1666":32969},[],"Release: `auth`",{"_3684":216,"_21620":68,"_18607":32971,"_5":21799,"_8577":32579,"_1666":32972},[],"Uso de base de datos externa: `postgresql:5432/auth`",{"_3684":217,"_21620":68,"_18607":32974,"_5":21799,"_8577":32579,"_1666":32975},[],"Imagen de Keycloak fijada en `keycloak/keycloak:26.6.0`",{"_3684":218,"_21620":68,"_18607":32977,"_5":21799,"_8577":32579,"_1666":32978},[],"`httpRelativePath: /auth/`",{"_3684":219,"_21620":68,"_18607":32980,"_5":21799,"_8577":32579,"_1666":32981},[],"`proxyHeaders: xforwarded`",{"_3684":220,"_21620":68,"_18607":32983,"_5":21799,"_8577":32579,"_1666":32984},[],"Configuración automática del realm `lamassu`:",{"_3684":221,"_21620":68,"_18607":32986,"_5":21799,"_8577":32579,"_1666":32987},[],"Rol: `pki-admin`",{"_3684":222,"_21620":68,"_18607":32989,"_5":21799,"_8577":32579,"_1666":32990},[],"Usuario inicial: `lamassu` / `lamassu` (cambio obligatorio)",{"_3684":223,"_21620":68,"_18607":32992,"_5":21799,"_8577":32579,"_1666":32993},[],"Cliente público: `frontend` con `/*` en redirect URIs",{"_3684":224,"_21620":68,"_18607":32995,"_5":21799,"_8577":32579,"_1666":32996},[],"En modo online se descarga automáticamente un tema personalizado desde:",{"_3684":225,"_21620":68,"_18607":32998,"_5":21799,"_8577":32579,"_1666":32999},[],"`github.com/lamassuiot/keycloak-theme`",{"_3684":226,"_21620":68,"_18607":33001,"_5":21799,"_8577":32583,"_1666":33002},[],"Chart: `oci://registry-1.docker.io/cloudpirates/rabbitmq`",{"_3684":227,"_21620":68,"_18607":33004,"_5":21799,"_8577":32583,"_1666":32966},[],{"_3684":228,"_21620":68,"_18607":33006,"_5":21799,"_8577":32583,"_1666":33007},[],"Release: `rabbitmq`",{"_3684":229,"_21620":68,"_18607":33009,"_5":21799,"_8577":32583,"_1666":33010},[],"`fullnameOverride: \"rabbitmq\"`",{"_3684":230,"_21620":68,"_18607":33012,"_5":21799,"_8577":32583,"_1666":33013},[],"Credenciales inyectadas dinámicamente mediante `yq`",{"_3684":231,"_21620":68,"_18607":33015,"_5":21799,"_8577":32587,"_1666":33016},[],"Se genera un archivo `lamassu.yaml` que se pasa a `helm install`.",{"_3684":232,"_21620":68,"_18607":33018,"_5":21799,"_8577":32587,"_1666":33019},[],"Configuraciones principales:",{"_3684":233,"_21620":68,"_18607":33021,"_5":21799,"_8577":32587,"_1666":33022},[],"PostgreSQL: host `postgresql`, puerto `5432`",{"_3684":234,"_21620":68,"_18607":33024,"_5":21799,"_8577":32587,"_1666":33025},[],"AMQP: host `rabbitmq`, puerto `5672`, TLS deshabilitado",{"_3684":235,"_21620":68,"_18607":33027,"_5":21799,"_8577":32587,"_1666":33028},[],"OIDC JWKS:\n`http://auth-keycloak.<NAMESPACE>/auth/realms/lamassu/protocol/openid-connect/certs`",{"_3684":236,"_21620":68,"_18607":33030,"_5":21799,"_8577":32587,"_1666":33031},[],"Ruta adicional de gateway: `/auth -> auth-keycloak:8080`",{"_3684":237,"_21620":68,"_18607":33033,"_5":21799,"_8577":32587,"_1666":33034},[],"Direcciones de gateway: IP(s) obtenidas con `hostname -I`",{"_3684":238,"_21620":68,"_18607":33036,"_5":21799,"_8577":32587,"_1666":33037},[],"Puertos de gateway: desde `--https-port` y `--http-port`",{"_3684":239,"_21620":68,"_18607":33039,"_5":21799,"_8577":32587,"_1666":33040},[],"Dominios CA: valor de `--domain`",{"_3684":240,"_21620":68,"_18607":33042,"_5":21799,"_8577":32587,"_1666":33043},[],"Cuando se ejecuta en modo online y no se usa `--local-chart-path`, el script añade el repositorio Helm:",{"_3684":241,"_21620":68,"_18607":33045,"_5":21799,"_8577":32587,"_1666":33046},[],"Después instala el release `lamassu` usando la versión indicada por `--version` si se ha proporcionado.",{"_3684":242,"_21620":68,"_18607":33048,"_5":21799,"_8577":32587,"_1666":33049},[],"Si `--https-port` es distinto de `443`, el puerto se añade al dominio antes de escribirlo en `values`.",{"_3684":243,"_21620":68,"_18607":33051,"_5":21799,"_8577":32595,"_1666":33052},[],"Si se proporcionan:",{"_3684":244,"_21620":68,"_18607":33054,"_5":21799,"_8577":32595,"_1666":32719},[],{"_3684":245,"_21620":68,"_18607":33056,"_5":21799,"_8577":32595,"_1666":32727},[],{"_3684":246,"_21620":68,"_18607":33058,"_5":21799,"_8577":32595,"_1666":33059},[],"Se crea un secret Kubernetes:",{"_3684":247,"_21620":68,"_18607":33061,"_5":21799,"_8577":32595,"_1666":33062},[],"`downstream-provided-crt`",{"_3684":248,"_21620":68,"_18607":33064,"_5":21799,"_8577":32595,"_1666":33065},[],"Y se configura:",{"_3684":249,"_21620":68,"_18607":33067,"_5":21799,"_8577":32599,"_1666":33068},[],"Si no se proporciona certificado:",{"_3684":250,"_21620":68,"_18607":33070,"_5":21799,"_8577":32599,"_1666":33071},[],"Además, el script crea un `Issuer` self-signed y el recurso `Certificate`.",{"_3684":251,"_21620":68,"_18607":33073,"_5":21799,"_8577":32599,"_1666":33074},[],"Si el usuario quiere reutilizar un `Issuer` o `ClusterIssuer` corporativo, ese flujo no lo automatiza Fastlane; en ese caso es preferible un despliegue manual del chart con un archivo `values.yaml` propio.",{"_3684":252,"_21620":68,"_18607":33076,"_5":21799,"_8577":32603,"_1666":33077},[],"En caso de éxito, se muestra:",{"_3684":253,"_21620":68,"_18607":33079,"_5":21799,"_8577":32603,"_1666":33080},[],"URL de Lamassu UI: `https://<DOMAIN>`",{"_3684":254,"_21620":68,"_18607":33082,"_5":21799,"_8577":32603,"_1666":33083},[],"Credenciales iniciales: `lamassu / lamassu`",{"_3684":255,"_21620":68,"_18607":33085,"_5":21799,"_8577":32603,"_1666":33086},[],"Consola Keycloak: `https://<DOMAIN>/auth/admin`",{"_3684":256,"_21620":68,"_18607":33088,"_5":21799,"_8577":32603,"_1666":33089},[],"Credenciales admin de Keycloak",{"_3684":257,"_21620":68,"_18607":33091,"_5":21799,"_8577":32603,"_1666":33092},[],"El usuario `lamassu` se crea con:",{"_3684":258,"_21620":68,"_18607":33094,"_5":21799,"_8577":32603,"_1666":33095},[],"Por tanto, debe cambiar contraseña en el primer acceso.",{"_3684":259,"_21620":68,"_18607":33097,"_5":21799,"_8577":32607,"_1666":33098},[],"El script está pensado también para validaciones rápidas y smoke tests locales. Tras la instalación puede ejecutarse:",{"_3684":260,"_21620":68,"_18607":33100,"_5":21799,"_8577":32607,"_1666":33101},[],"El chart incluye una prueba que valida conectividad contra `ca`, `dms-manager`, `device-manager`, `va` y `ui`.",{"_3684":261,"_21620":68,"_18607":33103,"_5":21799,"_8577":32607,"_1666":33104},[],"Ejemplo:",{"_3684":262,"_21620":68,"_18607":33106,"_5":21799,"_8577":32607,"_1666":33107},[],"En este escenario:",{"_3684":263,"_21620":68,"_18607":33109,"_5":21799,"_8577":32607,"_1666":33110},[],"`-n`: modo no interactivo",{"_3684":264,"_21620":68,"_18607":33112,"_5":21799,"_8577":32607,"_1666":33113},[],"`-ns`: namespace específico",{"_3684":265,"_21620":68,"_18607":33115,"_5":21799,"_8577":32607,"_1666":33116},[],"`-d`: dominio de CI",{"_3684":266,"_21620":68,"_18607":33118,"_5":21799,"_8577":32607,"_1666":33119},[],"`-l`: chart local",{"_3684":267,"_21620":68,"_18607":33121,"_5":21799,"_8577":32615,"_1666":33122},[],"`lamassu-fast-lane.sh` proporciona un mecanismo totalmente automatizado para desplegar un entorno Lamassu funcional en Kubernetes en pocos minutos, integrando base de datos, autenticación, mensajería, gateway y TLS.",{"_3684":268,"_21620":68,"_18607":33124,"_5":21799,"_8577":32615,"_1666":33125},[],"Está optimizado para rapidez, reproducibilidad y uso en entornos no productivos, con soporte para escenarios offline y pipelines de CI.",{"_3684":269,"_21620":269,"_5":21794,"_1666":32471,"_21807":33127,"_18607":33128,"_8577":269},[32337,32338,32471],[],{"_3684":270,"_21620":269,"_18607":33130,"_5":21799,"_8577":269,"_1666":33131},[],"Despliega Lamassu en tu propio clúster Kubernetes con Helm o Fastlane.",{"_3684":271,"_21620":269,"_5":21804,"_18607":33133,"_8577":33134,"_1666":33135},[],"/docs/despliegue/onprem#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3684":272,"_21620":269,"_5":21804,"_18607":33137,"_8577":33138,"_1666":33139},[],"/docs/despliegue/onprem#quickstart","Quickstart",{"_3684":273,"_21620":269,"_5":21804,"_18607":33141,"_8577":33142,"_1666":33143},[],"/docs/despliegue/onprem#qué-se-despliega","Qué se despliega",{"_3684":274,"_21620":269,"_5":21804,"_18607":33145,"_8577":33146,"_1666":33147},[],"/docs/despliegue/onprem#requisitos-previos","Requisitos previos",{"_3684":275,"_21620":269,"_5":21804,"_18607":33149,"_8577":33150,"_1666":33151},[],"/docs/despliegue/onprem#opciones-de-despliegue","Opciones de despliegue",{"_3684":276,"_21620":269,"_5":21804,"_18607":33153,"_8577":33154,"_1666":33155},[],"/docs/despliegue/onprem#1-despliegue-manual-con-helm","1\\. Despliegue manual con Helm",{"_3684":277,"_21620":269,"_5":21804,"_18607":33157,"_8577":33158,"_1666":33159},[],"/docs/despliegue/onprem#2-despliegue-automatizado-con-fastlane","2\\. Despliegue automatizado con Fastlane",{"_3684":278,"_21620":269,"_5":21804,"_18607":33161,"_8577":33162,"_1666":33163},[],"/docs/despliegue/onprem#arquitectura","Arquitectura",{"_3684":279,"_21620":269,"_5":21804,"_18607":33165,"_8577":33166,"_1666":33167},[],"/docs/despliegue/onprem#instalación-manual-con-helm","Instalación manual con Helm",{"_3684":280,"_21620":269,"_5":21804,"_18607":33169,"_8577":33170,"_1666":33171},[],"/docs/despliegue/onprem#valores-mínimos-que-deben-definirse","Valores mínimos que deben definirse",{"_3684":281,"_21620":269,"_5":21804,"_18607":33173,"_8577":33174,"_1666":33175},[],"/docs/despliegue/onprem#áreas-de-configuración-más-relevantes","Áreas de configuración más relevantes",{"_3684":282,"_21620":269,"_5":21804,"_18607":33177,"_8577":33178,"_1666":33179},[],"/docs/despliegue/onprem#verificación-del-despliegue","Verificación del despliegue",{"_3684":283,"_21620":269,"_5":21804,"_18607":33181,"_8577":33182,"_1666":33183},[],"/docs/despliegue/onprem#repositorio-helm","Repositorio Helm",{"_3684":284,"_21620":269,"_5":21804,"_18607":33185,"_8577":33186,"_1666":33187},[],"/docs/despliegue/onprem#softhsm-como-complemento-opcional","SoftHSM como complemento opcional",{"_3684":285,"_21620":269,"_5":21804,"_18607":33189,"_8577":33190,"_1666":33191},[],"/docs/despliegue/onprem#versionado-y-migraciones","Versionado y migraciones",{"_3684":286,"_21620":269,"_18607":33193,"_5":21799,"_8577":33134,"_1666":33194},[],"Lamassu IoT puede desplegarse en infraestructura propia mediante **Kubernetes**, tanto en clústeres gestionados internamente como en entornos self-managed.",{"_3684":287,"_21620":269,"_18607":33196,"_5":21799,"_8577":33134,"_1666":33197},[],"La referencia principal para este despliegue es el repositorio `lamassu-helm`, que incluye:",{"_3684":288,"_21620":269,"_18607":33199,"_5":21799,"_8577":33134,"_1666":33200},[],"el chart principal de Lamassu",{"_3684":289,"_21620":269,"_18607":33202,"_5":21799,"_8577":33134,"_1666":33203},[],"un chart auxiliar de SoftHSM",{"_3684":290,"_21620":269,"_18607":33205,"_5":21799,"_8577":33134,"_1666":33206},[],"el script de despliegue automatizado `scripts/lamassu-fast-lane.sh`",{"_3684":291,"_21620":269,"_18607":33208,"_5":21799,"_8577":33138,"_1666":33209},[],"Si lo que necesitas es levantar un entorno funcional lo antes posible, la vía más rápida es usar Fastlane desde el repositorio `lamassu-helm`:",{"_3684":292,"_21620":269,"_18607":33211,"_5":21799,"_8577":33138,"_1666":33212},[],"Ese flujo:",{"_3684":293,"_21620":269,"_18607":33214,"_5":21799,"_8577":33138,"_1666":33215},[],"crea o reutiliza el namespace indicado",{"_3684":294,"_21620":269,"_18607":33217,"_5":21799,"_8577":33138,"_1666":33218},[],"instala PostgreSQL, Keycloak y RabbitMQ",{"_3684":295,"_21620":269,"_18607":33220,"_5":21799,"_8577":33138,"_1666":33221},[],"despliega el chart de Lamassu",{"_3684":296,"_21620":269,"_18607":33223,"_5":21799,"_8577":33138,"_1666":33224},[],"deja la UI expuesta en `https://<dominio>`",{"_3684":297,"_21620":269,"_18607":33226,"_5":21799,"_8577":33138,"_1666":33227},[],"Si buscas un despliegue productivo o más controlado, sigue con la instalación manual mediante Helm que se describe más abajo.",{"_3684":298,"_21620":269,"_18607":33229,"_5":21799,"_8577":33142,"_1666":33230},[],"El chart principal `charts/lamassu`, actualmente en la serie `3.7.x`, despliega estos componentes:",{"_3684":299,"_21620":269,"_18607":33232,"_5":21799,"_8577":33142,"_1666":33233},[],"`ui`",{"_3684":300,"_21620":269,"_18607":33235,"_5":21799,"_8577":33142,"_1666":32927},[],{"_3684":301,"_21620":269,"_18607":33237,"_5":21799,"_8577":33142,"_1666":32933},[],{"_3684":302,"_21620":269,"_18607":33239,"_5":21799,"_8577":33142,"_1666":32957},[],{"_3684":303,"_21620":269,"_18607":33241,"_5":21799,"_8577":33142,"_1666":33242},[],"`device-manager`",{"_3684":304,"_21620":269,"_18607":33244,"_5":21799,"_8577":33142,"_1666":33245},[],"`dms-manager`",{"_3684":305,"_21620":269,"_18607":33247,"_5":21799,"_8577":33142,"_1666":32921},[],{"_3684":306,"_21620":269,"_18607":33249,"_5":21799,"_8577":33142,"_1666":33250},[],"recursos de Gateway API y políticas de Envoy Gateway",{"_3684":307,"_21620":269,"_18607":33252,"_5":21799,"_8577":33142,"_1666":33253},[],"job de migraciones de base de datos",{"_3684":308,"_21620":269,"_18607":33255,"_5":21799,"_8577":33146,"_1666":33256},[],"Clúster Kubernetes `1.19+`",{"_3684":309,"_21620":269,"_18607":33258,"_5":21799,"_8577":33146,"_1666":33259},[],"`kubectl` configurado con acceso al clúster",{"_3684":310,"_21620":269,"_18607":33261,"_5":21799,"_8577":33146,"_1666":33262},[],"Helm `3.2.0+`",{"_3684":311,"_21620":269,"_18607":33264,"_5":21799,"_8577":33146,"_1666":33265},[],"`cert-manager 1.14+` para la gestión de certificados cuando se usa `tls.type=certManager`",{"_3684":312,"_21620":269,"_18607":33267,"_5":21799,"_8577":33146,"_1666":33268},[],"`Envoy Gateway 1.3.0+`, ya que el chart publica servicios mediante Gateway API y no mediante Ingress",{"_3684":313,"_21620":269,"_18607":33270,"_5":21799,"_8577":33146,"_1666":33271},[],"Acceso a un registro de contenedores o imágenes previamente importadas si se trabaja en modo offline",{"_3684":314,"_21620":269,"_18607":33273,"_5":21799,"_8577":33146,"_1666":33274},[],"Almacenamiento persistente disponible para PostgreSQL, RabbitMQ, VA y KMS",{"_3684":315,"_21620":269,"_18607":33276,"_5":21799,"_8577":33150,"_1666":33277},[],"Hay dos formas de desplegar Lamassu on-prem:",{"_3684":316,"_21620":269,"_18607":33279,"_5":21799,"_8577":33154,"_1666":33280},[],"Es la opción recomendada para entornos productivos o controlados, donde PostgreSQL, RabbitMQ, Keycloak, certificados y direccionamiento del Gateway ya están definidos por el equipo de plataforma.",{"_3684":317,"_21620":269,"_18607":33282,"_5":21799,"_8577":33158,"_1666":33283},[],"Es la opción más útil para pruebas, demos, CI o bootstrap rápido de un entorno. Fastlane levanta PostgreSQL, Keycloak, RabbitMQ y Lamassu en un único flujo. Su comportamiento está documentado en la página siguiente.",{"_3684":318,"_21620":269,"_18607":33285,"_5":21799,"_8577":33162,"_1666":33286},[],"Lamassu IoT se despliega como un conjunto de microservicios Kubernetes independientes. El chart principal crea `Deployment`, `StatefulSet`, `Service`, `ConfigMap`, `HTTPRoute`, `Gateway`, certificados y recursos auxiliares según los valores definidos.",{"_3684":319,"_21620":269,"_18607":33288,"_5":21799,"_8577":33162,"_1666":33289},[],"Dependencias externas requeridas por el chart principal:",{"_3684":320,"_21620":269,"_18607":33291,"_5":21799,"_8577":33162,"_1666":32625},[],{"_3684":321,"_21620":269,"_18607":33293,"_5":21799,"_8577":33162,"_1666":32631},[],{"_3684":322,"_21620":269,"_18607":33295,"_5":21799,"_8577":33162,"_1666":33296},[],"proveedor OIDC, típicamente Keycloak",{"_3684":323,"_21620":269,"_18607":33298,"_5":21799,"_8577":33162,"_1666":33299},[],"El chart no instala estas dependencias por sí solo. Para un despliegue manual hay que provisionarlas antes. Si se busca un entorno funcional rápido para laboratorio o validación, el script Fastlane sí instala PostgreSQL, RabbitMQ y Keycloak además del chart de Lamassu.",{"_3684":324,"_21620":269,"_18607":33301,"_5":21799,"_8577":33166,"_1666":33302},[],"Agregar el repositorio Helm:",{"_3684":325,"_21620":269,"_18607":33304,"_5":21799,"_8577":33166,"_1666":33305},[],"O instalar desde una copia local del repositorio:",{"_3684":326,"_21620":269,"_18607":33307,"_5":21799,"_8577":33170,"_1666":33308},[],"Los valores por defecto del chart son deliberadamente incompletos para dependencias externas. Como mínimo, un despliegue manual debe definir:",{"_3684":327,"_21620":269,"_18607":33310,"_5":21799,"_8577":33170,"_1666":33311},[],"`postgres.hostname`, `postgres.username`, `postgres.password`",{"_3684":328,"_21620":269,"_18607":33313,"_5":21799,"_8577":33170,"_1666":33314},[],"`amqp.hostname`, `amqp.username`, `amqp.password`",{"_3684":329,"_21620":269,"_18607":33316,"_5":21799,"_8577":33170,"_1666":33317},[],"`auth.oidc.frontend.authority`",{"_3684":330,"_21620":269,"_18607":33319,"_5":21799,"_8577":33170,"_1666":33320},[],"`auth.oidc.apiGateway.jwks`",{"_3684":331,"_21620":269,"_18607":33322,"_5":21799,"_8577":33170,"_1666":33323},[],"`services.ca.domains`",{"_3684":332,"_21620":269,"_18607":33325,"_5":21799,"_8577":33170,"_1666":33326},[],"`gateway.addresses` o una estrategia equivalente de publicación según el clúster",{"_3684":333,"_21620":269,"_18607":33328,"_5":21799,"_8577":33170,"_1666":33329},[],"`tls.*` según se use `certManager` o certificado externo",{"_3684":334,"_21620":269,"_18607":33331,"_5":21799,"_8577":33170,"_1666":33332},[],"Ejemplo base:",{"_3684":335,"_21620":269,"_18607":33334,"_5":21799,"_8577":33174,"_1666":33335},[],"Área",{"_3684":336,"_21620":269,"_18607":33337,"_5":21799,"_8577":33174,"_1666":33338},[],"Valores clave",{"_3684":337,"_21620":269,"_18607":33340,"_5":21799,"_8577":33174,"_1666":33341},[],"Uso",{"_3684":338,"_21620":269,"_18607":33343,"_5":21799,"_8577":33174,"_1666":33344},[],"TLS",{"_3684":339,"_21620":269,"_18607":33346,"_5":21799,"_8577":33174,"_1666":33347},[],"`tls.type`, `tls.certManagerOptions.*`, `tls.externalOptions.secretName`",{"_3684":340,"_21620":269,"_18607":33349,"_5":21799,"_8577":33174,"_1666":33350},[],"Certificado downstream del Gateway",{"_3684":341,"_21620":269,"_18607":33352,"_5":21799,"_8577":33174,"_1666":33353},[],"Gateway",{"_3684":342,"_21620":269,"_18607":33355,"_5":21799,"_8577":33174,"_1666":33356},[],"`gateway.addresses`, `gateway.ports.*`, `gateway.extraRouting`",{"_3684":343,"_21620":269,"_18607":33358,"_5":21799,"_8577":33174,"_1666":33359},[],"Exposición de UI y APIs vía Envoy Gateway",{"_3684":344,"_21620":269,"_18607":33361,"_5":21799,"_8577":33174,"_1666":32910},[],{"_3684":345,"_21620":269,"_18607":33363,"_5":21799,"_8577":33174,"_1666":33364},[],"`postgres.*`",{"_3684":346,"_21620":269,"_18607":33366,"_5":21799,"_8577":33174,"_1666":33367},[],"Conexión a PostgreSQL externa",{"_3684":347,"_21620":269,"_18607":33369,"_5":21799,"_8577":33174,"_1666":33370},[],"Mensajería",{"_3684":348,"_21620":269,"_18607":33372,"_5":21799,"_8577":33174,"_1666":33373},[],"`amqp.*`",{"_3684":349,"_21620":269,"_18607":33375,"_5":21799,"_8577":33174,"_1666":33376},[],"Conexión a RabbitMQ",{"_3684":350,"_21620":269,"_18607":33378,"_5":21799,"_8577":33174,"_1666":33379},[],"OIDC",{"_3684":351,"_21620":269,"_18607":33381,"_5":21799,"_8577":33174,"_1666":33382},[],"`auth.oidc.frontend.*`, `auth.oidc.apiGateway.jwks`",{"_3684":352,"_21620":269,"_18607":33384,"_5":21799,"_8577":33174,"_1666":33385},[],"Login de UI y validación JWT en el Gateway",{"_3684":353,"_21620":269,"_18607":33387,"_5":21799,"_8577":33174,"_1666":32930},[],{"_3684":354,"_21620":269,"_18607":33389,"_5":21799,"_8577":33174,"_1666":33323},[],{"_3684":355,"_21620":269,"_18607":33391,"_5":21799,"_8577":33174,"_1666":33392},[],"Dominios autorizados para CA y certificados",{"_3684":356,"_21620":269,"_18607":33394,"_5":21799,"_8577":33174,"_1666":32960},[],{"_3684":357,"_21620":269,"_18607":33396,"_5":21799,"_8577":33174,"_1666":33397},[],"`services.kms.cryptoEngines.*`",{"_3684":358,"_21620":269,"_18607":33399,"_5":21799,"_8577":33174,"_1666":33400},[],"Motor criptográfico y almacenamiento de claves",{"_3684":359,"_21620":269,"_18607":33402,"_5":21799,"_8577":33174,"_1666":32924},[],{"_3684":360,"_21620":269,"_18607":33404,"_5":21799,"_8577":33174,"_1666":33405},[],"`services.alerts.smtp_server.*`",{"_3684":361,"_21620":269,"_18607":33407,"_5":21799,"_8577":33174,"_1666":33408},[],"Envío de correo para alertas",{"_3684":362,"_21620":269,"_18607":33410,"_5":21799,"_8577":33178,"_1666":33411},[],"El chart incluye una prueba Helm en `charts/lamassu/templates/tests/test-connections.yml`. Tras instalarlo, puede validarse con:",{"_3684":363,"_21620":269,"_18607":33413,"_5":21799,"_8577":33178,"_1666":33414},[],"La prueba comprueba al menos:",{"_3684":364,"_21620":269,"_18607":33416,"_5":21799,"_8577":33178,"_1666":33417},[],"salud de `ca`",{"_3684":365,"_21620":269,"_18607":33419,"_5":21799,"_8577":33178,"_1666":33420},[],"salud de `dms-manager`",{"_3684":366,"_21620":269,"_18607":33422,"_5":21799,"_8577":33178,"_1666":33423},[],"salud de `device-manager`",{"_3684":367,"_21620":269,"_18607":33425,"_5":21799,"_8577":33178,"_1666":33426},[],"salud de `va`",{"_3684":368,"_21620":269,"_18607":33428,"_5":21799,"_8577":33178,"_1666":33429},[],"respuesta HTML esperada del servicio `ui`",{"_3684":369,"_21620":269,"_18607":33431,"_5":21799,"_8577":33182,"_1666":33432},[],"El repositorio `lamassu-helm` está organizado en tres bloques principales:",{"_3684":370,"_21620":269,"_18607":33434,"_5":21799,"_8577":33182,"_1666":33435},[],"`charts/lamassu`: chart principal de Lamassu",{"_3684":371,"_21620":269,"_18607":33437,"_5":21799,"_8577":33182,"_1666":33438},[],"`charts/softhsm`: chart opcional para laboratorios o escenarios de integración con PKCS#11 emulado",{"_3684":372,"_21620":269,"_18607":33440,"_5":21799,"_8577":33182,"_1666":33441},[],"`scripts/lamassu-fast-lane.sh`: automatización para levantar dependencias y desplegar Lamassu con intervención mínima",{"_3684":373,"_21620":269,"_18607":33443,"_5":21799,"_8577":33186,"_1666":33444},[],"El chart `charts/softhsm` no forma parte del despliegue estándar, pero resulta útil en entornos de laboratorio cuando se necesita simular un HSM compatible con PKCS#11. No sustituye al backend KMS principal; sirve como soporte para pruebas o integraciones concretas.",{"_3684":374,"_21620":269,"_18607":33446,"_5":21799,"_8577":33190,"_1666":33447},[],"La serie actual del chart principal es `3.7.x`. Para upgrades entre versiones, el repositorio incluye guías específicas en `charts/lamassu/CHANGELOG/`, especialmente en cambios importantes como la adopción de Envoy Gateway o la introducción del servicio KMS.",{"_3684":375,"_21620":375,"_5":21794,"_1666":33449,"_21807":33450,"_18607":33451,"_8577":375},"Utiliza Lamassu como SaaS",[32337,32338,32493],[],{"_3684":376,"_21620":375,"_18607":33453,"_5":21799,"_8577":375,"_1666":33454},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3684":377,"_21620":375,"_5":21804,"_18607":33456,"_8577":33457,"_1666":33458},[],"/docs/despliegue/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3684":378,"_21620":375,"_5":21804,"_18607":33460,"_8577":33461,"_1666":33462},[],"/docs/despliegue/saas#planes","Planes",{"_3684":379,"_21620":375,"_5":21804,"_18607":33464,"_8577":33465,"_1666":33466},[],"/docs/despliegue/saas#solicita-acceso","Solicita acceso",{"_3684":380,"_21620":375,"_18607":33468,"_5":21799,"_8577":375,"_1666":33469},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3684":381,"_21620":375,"_18607":33471,"_5":21799,"_8577":33457,"_1666":33472},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3684":382,"_21620":375,"_18607":33474,"_5":21799,"_8577":33457,"_1666":33475},[],"Copias de seguridad automáticas.",{"_3684":383,"_21620":375,"_18607":33477,"_5":21799,"_8577":33457,"_1666":33478},[],"Actualizaciones de versión.",{"_3684":384,"_21620":375,"_18607":33480,"_5":21799,"_8577":33457,"_1666":33481},[],"Soporte técnico y SLA según el plan contratado.",{"_3684":385,"_21620":375,"_18607":33483,"_5":21799,"_8577":33461,"_1666":33484},[],"Plan",{"_3684":386,"_21620":375,"_18607":33486,"_5":21799,"_8577":33461,"_1666":33487},[],"Dispositivos",{"_3684":387,"_21620":375,"_18607":33489,"_5":21799,"_8577":33461,"_1666":33490},[],"Soporte",{"_3684":388,"_21620":375,"_18607":33492,"_5":21799,"_8577":33461,"_1666":33493},[],"SLA",{"_3684":389,"_21620":375,"_18607":33495,"_5":21799,"_8577":33461,"_1666":33496},[],"Starter",{"_3684":390,"_21620":375,"_18607":33498,"_5":21799,"_8577":33461,"_1666":33499},[],"Hasta 1.000",{"_3684":391,"_21620":375,"_18607":33501,"_5":21799,"_8577":33461,"_1666":33502},[],"Email",{"_3684":392,"_21620":375,"_18607":33504,"_5":21799,"_8577":33461,"_1666":33505},[],"99,5 %",{"_3684":393,"_21620":375,"_18607":33507,"_5":21799,"_8577":33461,"_1666":33508},[],"Professional",{"_3684":394,"_21620":375,"_18607":33510,"_5":21799,"_8577":33461,"_1666":33511},[],"Hasta 10.000",{"_3684":395,"_21620":375,"_18607":33513,"_5":21799,"_8577":33461,"_1666":33514},[],"Email y chat",{"_3684":396,"_21620":375,"_18607":33516,"_5":21799,"_8577":33461,"_1666":33517},[],"99,9 %",{"_3684":397,"_21620":375,"_18607":33519,"_5":21799,"_8577":33461,"_1666":33520},[],"Enterprise",{"_3684":398,"_21620":375,"_18607":33522,"_5":21799,"_8577":33461,"_1666":33523},[],"Ilimitados",{"_3684":399,"_21620":375,"_18607":33525,"_5":21799,"_8577":33461,"_1666":33526},[],"Dedicado",{"_3684":400,"_21620":375,"_18607":33528,"_5":21799,"_8577":33461,"_1666":33529},[],"99,99 %",{"_3684":401,"_21620":375,"_18607":33531,"_5":21799,"_8577":33465,"_1666":33532},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3684":402,"_21620":375,"_18607":33534,"_5":21799,"_8577":33465,"_1666":33535},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3684":403,"_21620":403,"_5":21794,"_1666":33537,"_21807":33538,"_18607":33541,"_8577":403},"Arquitectura de la plataforma",[32337,33539,33540],"Plataforma","Conceptos",[],{"_3684":404,"_21620":403,"_18607":33543,"_5":21799,"_8577":403,"_1666":33544},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3684":405,"_21620":403,"_5":21804,"_18607":33546,"_8577":33547,"_1666":33548},[],"/docs/manual/conceptos/arquitectura#plano-de-control","Plano de control",{"_3684":406,"_21620":403,"_5":21804,"_18607":33550,"_8577":33551,"_1666":33552},[],"/docs/manual/conceptos/arquitectura#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3684":407,"_21620":403,"_5":21804,"_18607":33554,"_8577":33555,"_1666":33556},[],"/docs/manual/conceptos/arquitectura#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3684":408,"_21620":403,"_5":21804,"_18607":33558,"_8577":33559,"_1666":33560},[],"/docs/manual/conceptos/arquitectura#estado-y-validación","Estado y validación",{"_3684":409,"_21620":403,"_5":21804,"_18607":33562,"_8577":33563,"_1666":33564},[],"/docs/manual/conceptos/arquitectura#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3684":410,"_21620":403,"_18607":33566,"_5":21799,"_8577":403,"_1666":33567},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3684":411,"_21620":403,"_18607":33569,"_5":21799,"_8577":33547,"_1666":33570},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3684":412,"_21620":403,"_18607":33572,"_5":21799,"_8577":33551,"_1666":33573},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3684":413,"_21620":403,"_18607":33575,"_5":21799,"_8577":33555,"_1666":33576},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3684":414,"_21620":403,"_18607":33578,"_5":21799,"_8577":33559,"_1666":33579},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3684":415,"_21620":403,"_18607":33581,"_5":21799,"_8577":33563,"_1666":33582},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3684":416,"_21620":416,"_5":21794,"_1666":33584,"_21807":33585,"_18607":33586,"_8577":416},"Ciclo de vida de una identidad",[32337,33539,33540],[],{"_3684":417,"_21620":416,"_18607":33588,"_5":21799,"_8577":416,"_1666":33589},[],"Estados, transiciones y decisiones operativas de un certificado de dispositivo.",{"_3684":418,"_21620":416,"_5":21804,"_18607":33591,"_8577":33592,"_1666":33593},[],"/docs/manual/conceptos/ciclo-identidad#estados-principales","Estados principales",{"_3684":419,"_21620":416,"_5":21804,"_18607":33595,"_8577":33596,"_1666":33597},[],"/docs/manual/conceptos/ciclo-identidad#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3684":420,"_21620":416,"_5":21804,"_18607":33599,"_8577":33600,"_1666":33601},[],"/docs/manual/conceptos/ciclo-identidad#observabilidad","Observabilidad",{"_3684":421,"_21620":416,"_18607":33603,"_5":21799,"_8577":416,"_1666":33604},[],"Una identidad no termina cuando se emite el certificado. Lamassu mantiene su relación con el dispositivo y registra los cambios necesarios para renovarla, suspenderla o retirarla.",{"_3684":422,"_21620":416,"_18607":33606,"_5":21799,"_8577":33592,"_1666":33607},[],"Estado",{"_3684":423,"_21620":416,"_18607":33609,"_5":21799,"_8577":33592,"_1666":33610},[],"Qué significa",{"_3684":424,"_21620":416,"_18607":33612,"_5":21799,"_8577":33592,"_1666":33613},[],"Acción habitual",{"_3684":425,"_21620":416,"_18607":33615,"_5":21799,"_8577":33592,"_1666":33616},[],"`No Identity`",{"_3684":426,"_21620":416,"_18607":33618,"_5":21799,"_8577":33592,"_1666":33619},[],"El dispositivo está registrado pero no tiene certificado.",{"_3684":427,"_21620":416,"_18607":33621,"_5":21799,"_8577":33592,"_1666":33622},[],"Enrolar o asignar una identidad.",{"_3684":428,"_21620":416,"_18607":33624,"_5":21799,"_8577":33592,"_1666":33625},[],"`Active`",{"_3684":429,"_21620":416,"_18607":33627,"_5":21799,"_8577":33592,"_1666":33628},[],"El certificado está vigente y puede utilizarse.",{"_3684":430,"_21620":416,"_18607":33630,"_5":21799,"_8577":33592,"_1666":33631},[],"Monitorizar y preparar su renovación.",{"_3684":431,"_21620":416,"_18607":33633,"_5":21799,"_8577":33592,"_1666":33634},[],"`Renewal Pending`",{"_3684":432,"_21620":416,"_18607":33636,"_5":21799,"_8577":33592,"_1666":33637},[],"La identidad ha entrado en la ventana de renovación.",{"_3684":433,"_21620":416,"_18607":33639,"_5":21799,"_8577":33592,"_1666":33640},[],"Iniciar el re-enrolamiento.",{"_3684":434,"_21620":416,"_18607":33642,"_5":21799,"_8577":33592,"_1666":33643},[],"`Expiring Soon`",{"_3684":435,"_21620":416,"_18607":33645,"_5":21799,"_8577":33592,"_1666":33646},[],"La fecha de expiración está próxima.",{"_3684":436,"_21620":416,"_18607":33648,"_5":21799,"_8577":33592,"_1666":33649},[],"Renovar con prioridad.",{"_3684":437,"_21620":416,"_18607":33651,"_5":21799,"_8577":33592,"_1666":33652},[],"`Expired`",{"_3684":438,"_21620":416,"_18607":33654,"_5":21799,"_8577":33592,"_1666":33655},[],"El certificado ha superado su validez.",{"_3684":439,"_21620":416,"_18607":33657,"_5":21799,"_8577":33592,"_1666":33658},[],"Emitir una nueva identidad.",{"_3684":440,"_21620":416,"_18607":33660,"_5":21799,"_8577":33592,"_1666":33661},[],"`Revoked`",{"_3684":441,"_21620":416,"_18607":33663,"_5":21799,"_8577":33592,"_1666":33664},[],"El certificado se ha invalidado antes de expirar.",{"_3684":442,"_21620":416,"_18607":33666,"_5":21799,"_8577":33592,"_1666":33667},[],"Investigar la causa y sustituirlo si procede.",{"_3684":443,"_21620":416,"_18607":33669,"_5":21799,"_8577":33592,"_1666":33670},[],"`Decommissioned`",{"_3684":444,"_21620":416,"_18607":33672,"_5":21799,"_8577":33592,"_1666":33673},[],"El dispositivo se ha retirado definitivamente.",{"_3684":445,"_21620":416,"_18607":33675,"_5":21799,"_8577":33592,"_1666":33676},[],"No volver a enrolarlo.",{"_3684":446,"_21620":416,"_18607":33678,"_5":21799,"_8577":33596,"_1666":33679},[],"La **renovación** sustituye una identidad que sigue siendo fiable antes de que expire. La **revocación** comunica que un certificado ya no debe aceptarse. Revoca cuando exista compromiso, retirada o un cambio que invalide la identidad; renueva para mantener la continuidad operativa.",{"_3684":447,"_21620":416,"_18607":33681,"_5":21799,"_8577":33596,"_1666":33682},[],"Dar de baja un dispositivo revoca sus certificados y le impide obtener nuevas identidades. Utiliza esta acción únicamente cuando el dispositivo se retire de forma permanente.",{"_3684":448,"_21620":416,"_18607":33684,"_5":21799,"_8577":33600,"_1666":33685},[],"El historial de certificados muestra todas las identidades asociadas a un dispositivo. La línea de tiempo registra enrolamientos, renovaciones y cambios de estado. Las suscripciones permiten enviar estos eventos a correo, Microsoft Teams o webhooks.",{"_3684":449,"_21620":449,"_5":21794,"_1666":33687,"_21807":33688,"_18607":33689,"_8577":449},"Cómo funciona Lamassu",[32337,33539,33540],[],{"_3684":450,"_21620":449,"_18607":33691,"_5":21799,"_8577":449,"_1666":33692},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3684":451,"_21620":449,"_5":21804,"_18607":33694,"_8577":33695,"_1666":33696},[],"/docs/manual/conceptos#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3684":452,"_21620":449,"_5":21804,"_18607":33698,"_8577":33699,"_1666":33700},[],"/docs/manual/conceptos#del-alta-a-la-operación","Del alta a la operación",{"_3684":453,"_21620":449,"_18607":33702,"_5":21799,"_8577":449,"_1666":33703},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3684":454,"_21620":449,"_18607":33705,"_5":21799,"_8577":33695,"_1666":33706},[],"Pieza",{"_3684":455,"_21620":449,"_18607":33708,"_5":21799,"_8577":33695,"_1666":33709},[],"Responsabilidad",{"_3684":456,"_21620":449,"_18607":33711,"_5":21799,"_8577":33695,"_1666":33712},[],"Motor criptográfico",{"_3684":457,"_21620":449,"_18607":33714,"_5":21799,"_8577":33695,"_1666":33715},[],"Genera o custodia claves y ejecuta operaciones privadas.",{"_3684":458,"_21620":449,"_18607":33717,"_5":21799,"_8577":33695,"_1666":33718},[],"Autoridad de certificación (CA)",{"_3684":459,"_21620":449,"_18607":33720,"_5":21799,"_8577":33695,"_1666":33721},[],"Firma certificados y establece la cadena de confianza.",{"_3684":460,"_21620":449,"_18607":33723,"_5":21799,"_8577":33695,"_1666":33724},[],"Device Management Service (DMS)",{"_3684":461,"_21620":449,"_18607":33726,"_5":21799,"_8577":33695,"_1666":33727},[],"Define cómo se registran y renuevan los dispositivos.",{"_3684":462,"_21620":449,"_18607":33729,"_5":21799,"_8577":33695,"_1666":33730},[],"Dispositivo",{"_3684":463,"_21620":449,"_18607":33732,"_5":21799,"_8577":33695,"_1666":33733},[],"Conserva su clave privada y presenta el certificado para autenticarse.",{"_3684":464,"_21620":449,"_18607":33735,"_5":21799,"_8577":33695,"_1666":33736},[],"Validation Authority (VA)",{"_3684":465,"_21620":449,"_18607":33738,"_5":21799,"_8577":33695,"_1666":33739},[],"Publica el estado de los certificados mediante OCSP y CRL.",{"_3684":466,"_21620":449,"_18607":33741,"_5":21799,"_8577":33699,"_1666":33742},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3684":467,"_21620":449,"_18607":33744,"_5":21799,"_8577":33699,"_1666":33745},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3684":468,"_21620":449,"_18607":33747,"_5":21799,"_8577":33699,"_1666":33748},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3684":469,"_21620":449,"_18607":33750,"_5":21799,"_8577":33699,"_1666":33751},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3684":470,"_21620":449,"_18607":33753,"_5":21799,"_8577":33699,"_1666":33754},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3684":471,"_21620":449,"_18607":33756,"_5":21799,"_8577":33699,"_1666":33757},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/manual/conceptos/arquitectura\" />",{"_3684":472,"_21620":449,"_18607":33759,"_5":21799,"_8577":33699,"_1666":33760},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/manual/conceptos/ciclo-identidad\" />",{"_3684":473,"_21620":473,"_5":21794,"_1666":33762,"_21807":33763,"_18607":33764,"_8577":473},"Plataforma Lamassu IoT",[32337,33539],[],{"_3684":474,"_21620":473,"_18607":33766,"_5":21799,"_8577":473,"_1666":33767},[],"Gestiona la PKI y las identidades digitales de tus dispositivos desde una única plataforma.",{"_3684":475,"_21620":473,"_5":21804,"_18607":33769,"_8577":33770,"_1666":33771},[],"/docs/manual#empieza-aquí","Empieza aquí",{"_3684":476,"_21620":473,"_5":21804,"_18607":33773,"_8577":33774,"_1666":33775},[],"/docs/manual#capacidades-principales","Capacidades principales",{"_3684":477,"_21620":473,"_5":21804,"_18607":33777,"_8577":33778,"_1666":33779},[],"/docs/manual#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3684":478,"_21620":473,"_5":21804,"_18607":33781,"_8577":33782,"_1666":33783},[],"/docs/manual#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3684":479,"_21620":473,"_5":21804,"_18607":33785,"_8577":33786,"_1666":33787},[],"/docs/manual#emite-y-controla-certificados","Emite y controla certificados",{"_3684":480,"_21620":473,"_5":21804,"_18607":33789,"_8577":33790,"_1666":33791},[],"/docs/manual#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3684":481,"_21620":473,"_5":21804,"_18607":33793,"_8577":33794,"_1666":33795},[],"/docs/manual#publica-el-estado-de-validación","Publica el estado de validación",{"_3684":482,"_21620":473,"_5":21804,"_18607":33797,"_8577":33798,"_1666":33799},[],"/docs/manual#reacciona-a-los-eventos","Reacciona a los eventos",{"_3684":483,"_21620":473,"_5":21804,"_18607":33801,"_8577":33802,"_1666":33803},[],"/docs/manual#elige-tu-recorrido","Elige tu recorrido",{"_3684":484,"_21620":473,"_18607":33805,"_5":21799,"_8577":473,"_1666":33806},[],"Lamassu IoT centraliza la emisión, distribución, renovación y revocación de identidades X.509 para dispositivos conectados. Puedes construir una PKI privada, proteger sus claves y automatizar el enrolamiento de una flota sin perder visibilidad sobre cada certificado.",{"_3684":485,"_21620":473,"_18607":33808,"_5":21799,"_8577":33770,"_1666":33809},[],"<Card title=\"Primeros pasos\" description=\"Crea una CA, emite un certificado y registra tu primer dispositivo.\" href=\"/docs/manual/inicio\" />",{"_3684":486,"_21620":473,"_18607":33811,"_5":21799,"_8577":33770,"_1666":33812},[],"<Card title=\"Cómo funciona Lamassu\" description=\"Construye el modelo mental de autoridades, claves, identidades y validación.\" href=\"/docs/manual/conceptos\" />",{"_3684":487,"_21620":473,"_18607":33814,"_5":21799,"_8577":33778,"_1666":33815},[],"Crea autoridades raíz e intermedias o importa una PKI existente. Define qué autoridad puede emitir cada identidad y conserva la cadena de confianza completa.",{"_3684":488,"_21620":473,"_18607":33817,"_5":21799,"_8577":33782,"_1666":33818},[],"Genera y custodia claves mediante motores software, HSMs PKCS#11 o servicios cloud. Lamassu desacopla las operaciones de la ubicación física de la clave.",{"_3684":489,"_21620":473,"_18607":33820,"_5":21799,"_8577":33786,"_1666":33821},[],"Emite certificados desde la consola o a partir de un CSR, consulta su estado y revócalos cuando dejan de ser fiables.",{"_3684":490,"_21620":473,"_18607":33823,"_5":21799,"_8577":33790,"_1666":33824},[],"Define políticas de enrolamiento mediante un Device Management Service (DMS) y deja que los dispositivos soliciten o renueven su identidad a través de EST.",{"_3684":491,"_21620":473,"_18607":33826,"_5":21799,"_8577":33794,"_1666":33827},[],"Ofrece validación online mediante OCSP y distribuye CRLs para consumidores que necesitan comprobar certificados sin conexión.",{"_3684":492,"_21620":473,"_18607":33829,"_5":21799,"_8577":33798,"_1666":33830},[],"Suscríbete a cambios del ciclo de vida y envía notificaciones por correo, Microsoft Teams o webhooks.",{"_3684":493,"_21620":473,"_18607":33832,"_5":21799,"_8577":33802,"_1666":33833},[],"<Card title=\"Administro la PKI\" description=\"Configura motores, autoridades, emisión y validación.\" href=\"/docs/manual/servicios-core/kms\" />",{"_3684":494,"_21620":473,"_18607":33835,"_5":21799,"_8577":33802,"_1666":33836},[],"<Card title=\"Integro un dispositivo\" description=\"Configura el DMS y usa EST para obtener una identidad.\" href=\"/docs/manual/servicios-core/ra\" />",{"_3684":495,"_21620":473,"_18607":33838,"_5":21799,"_8577":33802,"_1666":33839},[],"<Card title=\"Opero la plataforma\" description=\"Despliega Lamassu y prepara sus dependencias.\" href=\"/docs/despliegue\" />",{"_3684":496,"_21620":473,"_18607":33841,"_5":21799,"_8577":33802,"_1666":33842},[],"<Card title=\"Integro otro sistema\" description=\"Conecta Lamassu con AWS IoT Core y otros destinos.\" href=\"/docs/manual/integraciones/aws\" />",{"_3684":497,"_21620":497,"_5":21794,"_1666":33844,"_21807":33845,"_18607":33846,"_8577":497},"Primeros pasos",[32337,33539,33844],[],{"_3684":498,"_21620":497,"_18607":33848,"_5":21799,"_8577":497,"_1666":33849},[],"Obtén un primer resultado con Lamassu y continúa desde una base funcional.",{"_3684":499,"_21620":497,"_5":21804,"_18607":33851,"_8577":33852,"_1666":33853},[],"/docs/manual/inicio#ruta-recomendada","Ruta recomendada",{"_3684":500,"_21620":497,"_5":21804,"_18607":33855,"_8577":33856,"_1666":32347},[],"/docs/manual/inicio#antes-de-empezar",{"_3684":501,"_21620":497,"_18607":33858,"_5":21799,"_8577":497,"_1666":33859},[],"Los quickstarts te llevan desde una instancia preparada hasta una identidad de dispositivo activa. Cada guía produce un resultado verificable y enlaza la explicación detallada cuando necesitas ir más allá.",{"_3684":502,"_21620":497,"_18607":33861,"_5":21799,"_8577":33852,"_1666":33862},[],"<Card title=\"1. Crea tu primera CA\" description=\"Establece una raíz de confianza capaz de emitir certificados.\" href=\"/docs/manual/inicio/primera-ca\" />",{"_3684":503,"_21620":497,"_18607":33864,"_5":21799,"_8577":33852,"_1666":33865},[],"<Card title=\"2. Emite un certificado\" description=\"Crea una identidad X.509 y verifica su contenido.\" href=\"/docs/manual/inicio/primer-certificado\" />",{"_3684":504,"_21620":497,"_18607":33867,"_5":21799,"_8577":33852,"_1666":33868},[],"<Card title=\"3. Registra un dispositivo\" description=\"Añade un dispositivo y asígnale su primera identidad.\" href=\"/docs/manual/inicio/primer-dispositivo\" />",{"_3684":505,"_21620":497,"_18607":33870,"_5":21799,"_8577":33856,"_1666":33871},[],"Necesitas acceso a la consola de Lamassu IoT y permisos para administrar claves, autoridades y dispositivos. La instancia debe tener al menos un motor criptográfico configurado.",{"_3684":506,"_21620":497,"_18607":33873,"_5":21799,"_8577":33856,"_1666":33874},[],"Si todavía no tienes una instancia, elige primero un modelo de despliegue.",{"_3684":507,"_21620":507,"_5":21794,"_1666":33876,"_21807":33877,"_18607":33878,"_8577":507},"Emite tu primer certificado",[32337,33539,33844],[],{"_3684":508,"_21620":507,"_18607":33880,"_5":21799,"_8577":507,"_1666":33881},[],"Emite una identidad X.509 desde la consola y verifica el resultado.",{"_3684":509,"_21620":507,"_5":21804,"_18607":33883,"_8577":33884,"_1666":32347},[],"/docs/manual/inicio/primer-certificado#antes-de-empezar",{"_3684":510,"_21620":507,"_5":21804,"_18607":33886,"_8577":33887,"_1666":33888},[],"/docs/manual/inicio/primer-certificado#inicia-la-emisión","Inicia la emisión",{"_3684":511,"_21620":507,"_5":21804,"_18607":33890,"_8577":33891,"_1666":33892},[],"/docs/manual/inicio/primer-certificado#elige-el-método","Elige el método",{"_3684":512,"_21620":507,"_5":21804,"_18607":33894,"_8577":33895,"_1666":33896},[],"/docs/manual/inicio/primer-certificado#identifica-el-certificado","Identifica el certificado",{"_3684":513,"_21620":507,"_5":21804,"_18607":33898,"_8577":33899,"_1666":33900},[],"/docs/manual/inicio/primer-certificado#configura-clave-y-usos","Configura clave y usos",{"_3684":514,"_21620":507,"_5":21804,"_18607":33902,"_8577":33903,"_1666":33904},[],"/docs/manual/inicio/primer-certificado#emite-y-descarga","Emite y descarga",{"_3684":515,"_21620":507,"_5":21804,"_18607":33906,"_8577":33907,"_1666":33908},[],"/docs/manual/inicio/primer-certificado#verifica-el-resultado","Verifica el resultado",{"_3684":516,"_21620":507,"_5":21804,"_18607":33910,"_8577":33911,"_1666":32371},[],"/docs/manual/inicio/primer-certificado#siguiente-paso",{"_3684":517,"_21620":507,"_18607":33913,"_5":21799,"_8577":507,"_1666":33914},[],"En este quickstart Lamassu generará la clave y el CSR en el navegador, y la CA emitirá el certificado. Al terminar descargarás el certificado y su clave privada.",{"_3684":518,"_21620":507,"_18607":33916,"_5":21799,"_8577":33884,"_1666":33917},[],"Una CA activa con permiso para emitir certificados.",{"_3684":519,"_21620":507,"_18607":33919,"_5":21799,"_8577":33884,"_1666":33920},[],"Un nombre para la identidad, por ejemplo `device-001.example.internal`.",{"_3684":520,"_21620":507,"_18607":33922,"_5":21799,"_8577":33884,"_1666":33923},[],"Un lugar seguro en el que custodiar la clave privada descargada.",{"_3684":521,"_21620":507,"_18607":33925,"_5":21799,"_8577":33884,"_1666":33926},[],"En este flujo la clave se genera en el navegador y Lamassu no la almacena. Descárgala y protégela antes de cerrar el resultado de la operación.",{"_3684":522,"_21620":507,"_18607":33928,"_5":21799,"_8577":33887,"_1666":33929},[],"Abre la CA creada en el quickstart anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3684":523,"_21620":507,"_18607":33931,"_5":21799,"_8577":33891,"_1666":33932},[],"Selecciona **Generate Key & CSR in Browser**. Usa **Upload Existing CSR** cuando la clave privada deba generarse y permanecer en el sistema de destino.",{"_3684":524,"_21620":507,"_18607":33934,"_5":21799,"_8577":33895,"_1666":33935},[],"Introduce el `Common Name` y, si corresponde, la organización, unidad organizativa y ubicación. Añade SANs para cada nombre DNS, dirección IP, correo o URI con el que se vaya a validar la identidad.",{"_3684":525,"_21620":507,"_18607":33937,"_5":21799,"_8577":33899,"_1666":33938},[],"Elige RSA o ECDSA, define la validez y selecciona los usos de clave. Para una identidad de dispositivo que usa mTLS, habilita **Digital Signature** y **Client Authentication**.",{"_3684":526,"_21620":507,"_18607":33940,"_5":21799,"_8577":33899,"_1666":33941},[],"La validez no puede superar la fecha de expiración de la CA emisora.",{"_3684":527,"_21620":507,"_18607":33943,"_5":21799,"_8577":33903,"_1666":33944},[],"Confirma la emisión y descarga inmediatamente el certificado y la clave privada en formato PEM.",{"_3684":528,"_21620":507,"_18607":33946,"_5":21799,"_8577":33907,"_1666":33947},[],"El certificado debe aparecer en **Issued Certificates** con estado activo. Comprueba su sujeto, SANs, emisor, usos y periodo de validez.",{"_3684":529,"_21620":507,"_18607":33949,"_5":21799,"_8577":33911,"_1666":33950},[],"Registra tu primer dispositivo para asociar la identidad a una entidad gestionada, o consulta la gestión de certificados.",{"_3684":530,"_21620":530,"_5":21794,"_1666":33952,"_21807":33953,"_18607":33954,"_8577":530},"Registra tu primer dispositivo",[32337,33539,33844],[],{"_3684":531,"_21620":530,"_18607":33956,"_5":21799,"_8577":530,"_1666":33957},[],"Añade un dispositivo a Lamassu y asígnale una identidad activa.",{"_3684":532,"_21620":530,"_5":21804,"_18607":33959,"_8577":33960,"_1666":32347},[],"/docs/manual/inicio/primer-dispositivo#antes-de-empezar",{"_3684":533,"_21620":530,"_5":21804,"_18607":33962,"_8577":33963,"_1666":33964},[],"/docs/manual/inicio/primer-dispositivo#registra-el-dispositivo","Registra el dispositivo",{"_3684":534,"_21620":530,"_5":21804,"_18607":33966,"_8577":33967,"_1666":33968},[],"/docs/manual/inicio/primer-dispositivo#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3684":535,"_21620":530,"_5":21804,"_18607":33970,"_8577":33971,"_1666":33972},[],"/docs/manual/inicio/primer-dispositivo#asigna-una-identidad","Asigna una identidad",{"_3684":536,"_21620":530,"_5":21804,"_18607":33974,"_8577":33975,"_1666":33976},[],"/docs/manual/inicio/primer-dispositivo#verifica-el-dispositivo","Verifica el dispositivo",{"_3684":537,"_21620":530,"_5":21804,"_18607":33978,"_8577":33979,"_1666":33980},[],"/docs/manual/inicio/primer-dispositivo#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3684":538,"_21620":530,"_18607":33982,"_5":21799,"_8577":530,"_1666":33983},[],"En este quickstart registrarás manualmente un dispositivo y le asignarás su primer certificado. Es el recorrido más corto para entender cómo Lamassu relaciona una entidad física con su historial de identidades.",{"_3684":539,"_21620":530,"_18607":33985,"_5":21799,"_8577":33960,"_1666":33986},[],"Un DMS configurado.",{"_3684":540,"_21620":530,"_18607":33988,"_5":21799,"_8577":33960,"_1666":33989},[],"Una CA asociada al DMS.",{"_3684":541,"_21620":530,"_18607":33991,"_5":21799,"_8577":33960,"_1666":33992},[],"Un identificador único para el dispositivo.",{"_3684":542,"_21620":530,"_18607":33994,"_5":21799,"_8577":33963,"_1666":33995},[],"Abre **Managed Devices**, selecciona la acción para registrar un dispositivo y completa:",{"_3684":543,"_21620":530,"_18607":33997,"_5":21799,"_8577":33963,"_1666":33998},[],"**Device ID**: identificador único del dispositivo.",{"_3684":544,"_21620":530,"_18607":34000,"_5":21799,"_8577":33963,"_1666":34001},[],"**Registration Authority**: DMS que aplicará las políticas de enrolamiento.",{"_3684":545,"_21620":530,"_18607":34003,"_5":21799,"_8577":33963,"_1666":34004},[],"**Icon** y **Tags**: clasificación opcional para localizarlo después.",{"_3684":546,"_21620":530,"_18607":34006,"_5":21799,"_8577":33967,"_1666":34007},[],"Abre el dispositivo recién creado. Debe aparecer con estado **No Identity**: existe en el inventario, pero todavía no tiene un certificado asociado.",{"_3684":547,"_21620":530,"_18607":34009,"_5":21799,"_8577":33971,"_1666":34010},[],"Selecciona **Assign Identity**. Lamassu buscará certificados activos cuyo `Common Name` coincida con el `Device ID`.",{"_3684":548,"_21620":530,"_18607":34012,"_5":21799,"_8577":33971,"_1666":34013},[],"Selecciona un certificado existente o usa **Issue New Instead** para emitir uno desde una CA vinculada al DMS.",{"_3684":549,"_21620":530,"_18607":34015,"_5":21799,"_8577":33975,"_1666":34016},[],"Tras confirmar, el estado debe cambiar a **Active**. Revisa **Certificate History** para comprobar la identidad asociada y **Device Event Timeline** para ver el evento de asignación.",{"_3684":550,"_21620":530,"_18607":34018,"_5":21799,"_8577":33979,"_1666":34019},[],"El registro manual ayuda a entender el modelo, pero una flota debe usar enrolamiento automatizado. Continúa con Device Management Service y la integración EST.",{"_3684":551,"_21620":551,"_5":21794,"_1666":34021,"_21807":34022,"_18607":34023,"_8577":551},"Crea tu primera CA",[32337,33539,33844],[],{"_3684":552,"_21620":551,"_18607":34025,"_5":21799,"_8577":551,"_1666":34026},[],"Crea una autoridad raíz y comprueba que está preparada para emitir certificados.",{"_3684":553,"_21620":551,"_5":21804,"_18607":34028,"_8577":34029,"_1666":32347},[],"/docs/manual/inicio/primera-ca#antes-de-empezar",{"_3684":554,"_21620":551,"_5":21804,"_18607":34031,"_8577":34032,"_1666":34033},[],"/docs/manual/inicio/primera-ca#abre-el-asistente-de-creación","Abre el asistente de creación",{"_3684":555,"_21620":551,"_5":21804,"_18607":34035,"_8577":34036,"_1666":34037},[],"/docs/manual/inicio/primera-ca#selecciona-la-clave","Selecciona la clave",{"_3684":556,"_21620":551,"_5":21804,"_18607":34039,"_8577":34040,"_1666":34041},[],"/docs/manual/inicio/primera-ca#define-la-autoridad","Define la autoridad",{"_3684":557,"_21620":551,"_5":21804,"_18607":34043,"_8577":34044,"_1666":34045},[],"/docs/manual/inicio/primera-ca#revisa-y-crea-la-ca","Revisa y crea la CA",{"_3684":558,"_21620":551,"_5":21804,"_18607":34047,"_8577":34048,"_1666":33908},[],"/docs/manual/inicio/primera-ca#verifica-el-resultado",{"_3684":559,"_21620":551,"_5":21804,"_18607":34050,"_8577":34051,"_1666":32371},[],"/docs/manual/inicio/primera-ca#siguiente-paso",{"_3684":560,"_21620":551,"_18607":34053,"_5":21799,"_8577":551,"_1666":34054},[],"En este quickstart crearás una autoridad de certificación raíz con un nuevo par de claves. Al terminar tendrás una CA activa que podrás usar en el siguiente quickstart.",{"_3684":561,"_21620":551,"_18607":34056,"_5":21799,"_8577":34029,"_1666":34057},[],"Acceso a la consola con permisos para gestionar autoridades.",{"_3684":562,"_21620":551,"_18607":34059,"_5":21799,"_8577":34029,"_1666":34060},[],"Al menos un motor criptográfico disponible.",{"_3684":563,"_21620":551,"_18607":34062,"_5":21799,"_8577":34029,"_1666":34063},[],"Un nombre que identifique el propósito de la CA, por ejemplo `Acme Device Root CA`.",{"_3684":564,"_21620":551,"_18607":34065,"_5":21799,"_8577":34029,"_1666":34066},[],"Una CA raíz se autofirma y actúa como ancla de confianza. Para producción suele ser preferible mantener la raíz más protegida y emitir desde una CA intermedia.",{"_3684":565,"_21620":551,"_18607":34068,"_5":21799,"_8577":34032,"_1666":34069},[],"En el menú lateral, abre **Certification Authorities** y selecciona **Create New CA**.",{"_3684":566,"_21620":551,"_18607":34071,"_5":21799,"_8577":34032,"_1666":34072},[],"Elige crear una CA con un par de claves nuevo. Si ya tienes la clave en el KMS, usa &#x2A;*Create New CA (Existing Key)**.",{"_3684":567,"_21620":551,"_18607":34074,"_5":21799,"_8577":34036,"_1666":34075},[],"Elige el motor criptográfico que custodiará la clave y configura el algoritmo. Para una primera CA puedes usar **EC P-384**, siempre que sea compatible con tus consumidores.",{"_3684":568,"_21620":551,"_18607":34077,"_5":21799,"_8577":34036,"_1666":34078},[],"La clave privada permanecerá bajo el control del motor seleccionado.",{"_3684":569,"_21620":551,"_18607":34080,"_5":21799,"_8577":34040,"_1666":34081},[],"Selecciona **Root CA** y completa:",{"_3684":570,"_21620":551,"_18607":34083,"_5":21799,"_8577":34040,"_1666":34084},[],"**CA Name**: un nombre único y reconocible.",{"_3684":571,"_21620":551,"_18607":34086,"_5":21799,"_8577":34040,"_1666":34087},[],"**Subject**: al menos la organización y el país que identificarán a la autoridad.",{"_3684":572,"_21620":551,"_18607":34089,"_5":21799,"_8577":34040,"_1666":34090},[],"**CA Certificate Expiration**: una validez mayor que la de los certificados que emitirá.",{"_3684":573,"_21620":551,"_18607":34092,"_5":21799,"_8577":34040,"_1666":34093},[],"**Default End-Entity Certificate Issuance Expiration**: la validez predeterminada de los certificados finales.",{"_3684":574,"_21620":551,"_18607":34095,"_5":21799,"_8577":34040,"_1666":34096},[],"El nombre de la CA se utilizará como `Common Name` del certificado.",{"_3684":575,"_21620":551,"_18607":34098,"_5":21799,"_8577":34044,"_1666":34099},[],"Comprueba el algoritmo, el sujeto y las fechas antes de confirmar. Estos valores definen el ancla de confianza y no deberían elegirse como simples datos de prueba en un entorno productivo.",{"_3684":576,"_21620":551,"_18607":34101,"_5":21799,"_8577":34048,"_1666":34102},[],"Abre la nueva CA desde el listado. Debe aparecer activa y mostrar su certificado PEM, la fecha de expiración y la pestaña **Issued Certificates**.",{"_3684":577,"_21620":551,"_18607":34104,"_5":21799,"_8577":34051,"_1666":34105},[],"Usa la autoridad para emitir tu primer certificado, o consulta la guía completa de autoridades para crear una CA intermedia, importar una CA o definir perfiles avanzados.",{"_3684":578,"_21620":578,"_5":21794,"_1666":34107,"_21807":34108,"_18607":34110,"_8577":578},"AWS IoT Core",[32337,33539,34109],"Integraciones",[],{"_3684":579,"_21620":578,"_18607":34112,"_5":21799,"_8577":578,"_1666":34113},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3684":580,"_21620":578,"_5":21804,"_18607":34115,"_8577":34116,"_1666":34117},[],"/docs/manual/integraciones/aws#arquitectura-del-conector","Arquitectura del conector",{"_3684":581,"_21620":578,"_5":21804,"_18607":34119,"_8577":34120,"_1666":34121},[],"/docs/manual/integraciones/aws#prerrequisitos","Prerrequisitos",{"_3684":582,"_21620":578,"_5":21804,"_18607":34123,"_8577":34124,"_1666":34125},[],"/docs/manual/integraciones/aws#permisos-iam-necesarios","Permisos IAM necesarios",{"_3684":583,"_21620":578,"_5":21804,"_18607":34127,"_8577":34128,"_1666":34129},[],"/docs/manual/integraciones/aws#parámetros-de-configuración","Parámetros de configuración",{"_3684":584,"_21620":578,"_5":21804,"_18607":34131,"_8577":34132,"_1666":34133},[],"/docs/manual/integraciones/aws#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3684":585,"_21620":578,"_5":21804,"_18607":34135,"_8577":34136,"_1666":34137},[],"/docs/manual/integraciones/aws#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3684":586,"_21620":578,"_5":21804,"_18607":34139,"_8577":34140,"_1666":34141},[],"/docs/manual/integraciones/aws#primary-account","Primary Account",{"_3684":587,"_21620":578,"_5":21804,"_18607":34143,"_8577":34144,"_1666":34145},[],"/docs/manual/integraciones/aws#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3684":588,"_21620":578,"_5":21804,"_18607":34147,"_8577":34148,"_1666":34149},[],"/docs/manual/integraciones/aws#configuración-del-dms","Configuración del DMS",{"_3684":589,"_21620":578,"_5":21804,"_18607":34151,"_8577":34152,"_1666":34153},[],"/docs/manual/integraciones/aws#modo-none","Modo `none`",{"_3684":590,"_21620":578,"_5":21804,"_18607":34155,"_8577":34156,"_1666":34157},[],"/docs/manual/integraciones/aws#modo-auto","Modo `auto`",{"_3684":591,"_21620":578,"_5":21804,"_18607":34159,"_8577":34160,"_1666":34161},[],"/docs/manual/integraciones/aws#modo-jitp","Modo `jitp`",{"_3684":592,"_21620":578,"_5":21804,"_18607":34163,"_8577":34164,"_1666":34165},[],"/docs/manual/integraciones/aws#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3684":593,"_21620":578,"_5":21804,"_18607":34167,"_8577":34168,"_1666":34169},[],"/docs/manual/integraciones/aws#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3684":594,"_21620":578,"_5":21804,"_18607":34171,"_8577":34172,"_1666":34173},[],"/docs/manual/integraciones/aws#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3684":595,"_21620":578,"_5":21804,"_18607":34175,"_8577":34176,"_1666":34177},[],"/docs/manual/integraciones/aws#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3684":596,"_21620":578,"_5":21804,"_18607":34179,"_8577":34180,"_1666":34181},[],"/docs/manual/integraciones/aws#device-shadow-y-automatización","Device Shadow y automatización",{"_3684":597,"_21620":578,"_5":21804,"_18607":34183,"_8577":34184,"_1666":34185},[],"/docs/manual/integraciones/aws#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3684":598,"_21620":578,"_5":21804,"_18607":34187,"_8577":34188,"_1666":34189},[],"/docs/manual/integraciones/aws#políticas-de-aws-iot","Políticas de AWS IoT",{"_3684":599,"_21620":578,"_5":21804,"_18607":34191,"_8577":34192,"_1666":34193},[],"/docs/manual/integraciones/aws#solución-de-problemas","Solución de problemas",{"_3684":600,"_21620":578,"_18607":34195,"_5":21799,"_8577":578,"_1666":34196},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3684":601,"_21620":578,"_18607":34198,"_5":21799,"_8577":578,"_1666":34199},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3684":602,"_21620":578,"_18607":34201,"_5":21799,"_8577":578,"_1666":34202},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3684":603,"_21620":578,"_18607":34204,"_5":21799,"_8577":34116,"_1666":34205},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3684":604,"_21620":578,"_18607":34207,"_5":21799,"_8577":34116,"_1666":34208},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3684":605,"_21620":578,"_18607":34210,"_5":21799,"_8577":34116,"_1666":34211},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3684":606,"_21620":578,"_18607":34213,"_5":21799,"_8577":34116,"_1666":34214},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3684":607,"_21620":578,"_18607":34216,"_5":21799,"_8577":34120,"_1666":34217},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3684":608,"_21620":578,"_18607":34219,"_5":21799,"_8577":34124,"_1666":34220},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3684":609,"_21620":578,"_18607":34222,"_5":21799,"_8577":34124,"_1666":34223},[],"Acción IAM",{"_3684":610,"_21620":578,"_18607":34225,"_5":21799,"_8577":34124,"_1666":34226},[],"Propósito",{"_3684":611,"_21620":578,"_18607":34228,"_5":21799,"_8577":34124,"_1666":34229},[],"`iot:GetRegistrationCode`",{"_3684":612,"_21620":578,"_18607":34231,"_5":21799,"_8577":34124,"_1666":34232},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3684":613,"_21620":578,"_18607":34234,"_5":21799,"_8577":34124,"_1666":34235},[],"`iot:RegisterCACertificate`",{"_3684":614,"_21620":578,"_18607":34237,"_5":21799,"_8577":34124,"_1666":34238},[],"Registrar la CA en AWS IoT",{"_3684":615,"_21620":578,"_18607":34240,"_5":21799,"_8577":34124,"_1666":34241},[],"`iot:DescribeCACertificate`",{"_3684":616,"_21620":578,"_18607":34243,"_5":21799,"_8577":34124,"_1666":34244},[],"Consultar el estado del registro de la CA",{"_3684":617,"_21620":578,"_18607":34246,"_5":21799,"_8577":34124,"_1666":34247},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3684":618,"_21620":578,"_18607":34249,"_5":21799,"_8577":34124,"_1666":34250},[],"Crear o actualizar Things en IoT Core",{"_3684":619,"_21620":578,"_18607":34252,"_5":21799,"_8577":34124,"_1666":34253},[],"`iot:RegisterThing`",{"_3684":620,"_21620":578,"_18607":34255,"_5":21799,"_8577":34124,"_1666":34256},[],"Aprovisionar Things mediante plantilla",{"_3684":621,"_21620":578,"_18607":34258,"_5":21799,"_8577":34124,"_1666":34259},[],"`iot:RegisterCertificate`",{"_3684":622,"_21620":578,"_18607":34261,"_5":21799,"_8577":34124,"_1666":34262},[],"Registrar certificados de dispositivo",{"_3684":623,"_21620":578,"_18607":34264,"_5":21799,"_8577":34124,"_1666":34265},[],"`iot:UpdateCertificate`",{"_3684":624,"_21620":578,"_18607":34267,"_5":21799,"_8577":34124,"_1666":34268},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3684":625,"_21620":578,"_18607":34270,"_5":21799,"_8577":34124,"_1666":34271},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3684":626,"_21620":578,"_18607":34273,"_5":21799,"_8577":34124,"_1666":34274},[],"Crear y adjuntar políticas IoT",{"_3684":627,"_21620":578,"_18607":34276,"_5":21799,"_8577":34124,"_1666":34277},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3684":628,"_21620":578,"_18607":34279,"_5":21799,"_8577":34124,"_1666":34280},[],"Gestionar grupos de Things",{"_3684":629,"_21620":578,"_18607":34282,"_5":21799,"_8577":34124,"_1666":34283},[],"`iot:CreateProvisioningTemplate`",{"_3684":630,"_21620":578,"_18607":34285,"_5":21799,"_8577":34124,"_1666":34286},[],"Crear plantillas JITP",{"_3684":631,"_21620":578,"_18607":34288,"_5":21799,"_8577":34124,"_1666":34289},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3684":632,"_21620":578,"_18607":34291,"_5":21799,"_8577":34124,"_1666":34292},[],"Leer y escribir el Device Shadow",{"_3684":633,"_21620":578,"_18607":34294,"_5":21799,"_8577":34124,"_1666":34295},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3684":634,"_21620":578,"_18607":34297,"_5":21799,"_8577":34128,"_1666":34298},[],"Parámetro",{"_3684":635,"_21620":578,"_18607":34300,"_5":21799,"_8577":34128,"_1666":34301},[],"Tipo",{"_3684":636,"_21620":578,"_18607":34303,"_5":21799,"_8577":34128,"_1666":34304},[],"Requerido",{"_3684":637,"_21620":578,"_18607":34306,"_5":21799,"_8577":34128,"_1666":32646},[],{"_3684":638,"_21620":578,"_18607":34308,"_5":21799,"_8577":34128,"_1666":34309},[],"`connector_id`",{"_3684":639,"_21620":578,"_18607":34311,"_5":21799,"_8577":34128,"_1666":17985},[],{"_3684":640,"_21620":578,"_18607":34313,"_5":21799,"_8577":34128,"_1666":34314},[],"Sí",{"_3684":641,"_21620":578,"_18607":34316,"_5":21799,"_8577":34128,"_1666":34317},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3684":642,"_21620":578,"_18607":34319,"_5":21799,"_8577":34128,"_1666":34320},[],"`aws_config.region`",{"_3684":643,"_21620":578,"_18607":34322,"_5":21799,"_8577":34128,"_1666":17985},[],{"_3684":644,"_21620":578,"_18607":34324,"_5":21799,"_8577":34128,"_1666":34314},[],{"_3684":645,"_21620":578,"_18607":34326,"_5":21799,"_8577":34128,"_1666":34327},[],"Región AWS donde opera el conector.",{"_3684":646,"_21620":578,"_18607":34329,"_5":21799,"_8577":34128,"_1666":34330},[],"`aws_config.auth_method`",{"_3684":647,"_21620":578,"_18607":34332,"_5":21799,"_8577":34128,"_1666":17985},[],{"_3684":648,"_21620":578,"_18607":34334,"_5":21799,"_8577":34128,"_1666":34314},[],{"_3684":649,"_21620":578,"_18607":34336,"_5":21799,"_8577":34128,"_1666":34337},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3684":650,"_21620":578,"_18607":34339,"_5":21799,"_8577":34128,"_1666":34340},[],"`aws_config.access_key_id`",{"_3684":651,"_21620":578,"_18607":34342,"_5":21799,"_8577":34128,"_1666":17985},[],{"_3684":652,"_21620":578,"_18607":34344,"_5":21799,"_8577":34128,"_1666":34345},[],"Solo con `auth_method=static`",{"_3684":653,"_21620":578,"_18607":34347,"_5":21799,"_8577":34128,"_1666":34348},[],"Clave de acceso AWS.",{"_3684":654,"_21620":578,"_18607":34350,"_5":21799,"_8577":34128,"_1666":34351},[],"`aws_config.secret_access_key`",{"_3684":655,"_21620":578,"_18607":34353,"_5":21799,"_8577":34128,"_1666":17985},[],{"_3684":656,"_21620":578,"_18607":34355,"_5":21799,"_8577":34128,"_1666":34345},[],{"_3684":657,"_21620":578,"_18607":34357,"_5":21799,"_8577":34128,"_1666":34358},[],"Clave secreta AWS.",{"_3684":658,"_21620":578,"_18607":34360,"_5":21799,"_8577":34128,"_1666":34361},[],"`aws_config.session_token`",{"_3684":659,"_21620":578,"_18607":34363,"_5":21799,"_8577":34128,"_1666":17985},[],{"_3684":660,"_21620":578,"_18607":34365,"_5":21799,"_8577":34128,"_1666":34366},[],"No",{"_3684":661,"_21620":578,"_18607":34368,"_5":21799,"_8577":34128,"_1666":34369},[],"Token de sesión (con `auth_method=static`).",{"_3684":662,"_21620":578,"_18607":34371,"_5":21799,"_8577":34128,"_1666":34372},[],"`aws_config.role_arn`",{"_3684":663,"_21620":578,"_18607":34374,"_5":21799,"_8577":34128,"_1666":17985},[],{"_3684":664,"_21620":578,"_18607":34376,"_5":21799,"_8577":34128,"_1666":34377},[],"Solo con `auth_method=role`",{"_3684":665,"_21620":578,"_18607":34379,"_5":21799,"_8577":34128,"_1666":34380},[],"ARN del rol a asumir.",{"_3684":666,"_21620":578,"_18607":34382,"_5":21799,"_8577":34128,"_1666":34383},[],"`aws_config.endpoint_url`",{"_3684":667,"_21620":578,"_18607":34385,"_5":21799,"_8577":34128,"_1666":17985},[],{"_3684":668,"_21620":578,"_18607":34387,"_5":21799,"_8577":34128,"_1666":34366},[],{"_3684":669,"_21620":578,"_18607":34389,"_5":21799,"_8577":34128,"_1666":34390},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3684":670,"_21620":578,"_18607":34392,"_5":21799,"_8577":34128,"_1666":34393},[],"`subscriber_event_bus`",{"_3684":671,"_21620":578,"_18607":34395,"_5":21799,"_8577":34128,"_1666":13932},[],{"_3684":672,"_21620":578,"_18607":34397,"_5":21799,"_8577":34128,"_1666":34314},[],{"_3684":673,"_21620":578,"_18607":34399,"_5":21799,"_8577":34128,"_1666":34400},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3684":674,"_21620":578,"_18607":34402,"_5":21799,"_8577":34128,"_1666":34403},[],"`dms_manager_client`",{"_3684":675,"_21620":578,"_18607":34405,"_5":21799,"_8577":34128,"_1666":17985},[],{"_3684":676,"_21620":578,"_18607":34407,"_5":21799,"_8577":34128,"_1666":34314},[],{"_3684":677,"_21620":578,"_18607":34409,"_5":21799,"_8577":34128,"_1666":34410},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3684":678,"_21620":578,"_18607":34412,"_5":21799,"_8577":34128,"_1666":34413},[],"`device_manager_client`",{"_3684":679,"_21620":578,"_18607":34415,"_5":21799,"_8577":34128,"_1666":17985},[],{"_3684":680,"_21620":578,"_18607":34417,"_5":21799,"_8577":34128,"_1666":34314},[],{"_3684":681,"_21620":578,"_18607":34419,"_5":21799,"_8577":34128,"_1666":34420},[],"URL HTTP del Device Manager de Lamassu.",{"_3684":682,"_21620":578,"_18607":34422,"_5":21799,"_8577":34128,"_1666":34423},[],"`ca_client`",{"_3684":683,"_21620":578,"_18607":34425,"_5":21799,"_8577":34128,"_1666":17985},[],{"_3684":684,"_21620":578,"_18607":34427,"_5":21799,"_8577":34128,"_1666":34314},[],{"_3684":685,"_21620":578,"_18607":34429,"_5":21799,"_8577":34128,"_1666":34430},[],"URL HTTP del servicio de CA de Lamassu.",{"_3684":686,"_21620":578,"_18607":34432,"_5":21799,"_8577":34132,"_1666":34433},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3684":687,"_21620":578,"_18607":34435,"_5":21799,"_8577":34136,"_1666":34436},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3684":688,"_21620":578,"_18607":34438,"_5":21799,"_8577":34136,"_1666":34439},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3684":689,"_21620":578,"_18607":34441,"_5":21799,"_8577":34140,"_1666":34442},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3684":690,"_21620":578,"_18607":34444,"_5":21799,"_8577":34140,"_1666":34445},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3684":691,"_21620":578,"_18607":34447,"_5":21799,"_8577":34140,"_1666":34448},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3684":692,"_21620":578,"_18607":34450,"_5":21799,"_8577":34140,"_1666":34451},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3684":693,"_21620":578,"_18607":34453,"_5":21799,"_8577":34140,"_1666":34454},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3684":694,"_21620":578,"_18607":34456,"_5":21799,"_8577":34140,"_1666":34457},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3684":695,"_21620":578,"_18607":34459,"_5":21799,"_8577":34144,"_1666":34460},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3684":696,"_21620":578,"_18607":34462,"_5":21799,"_8577":34148,"_1666":34463},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3684":697,"_21620":578,"_18607":34465,"_5":21799,"_8577":34148,"_1666":34466},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3684":698,"_21620":578,"_18607":34468,"_5":21799,"_8577":34152,"_1666":34469},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3684":699,"_21620":578,"_18607":34471,"_5":21799,"_8577":34156,"_1666":34472},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3684":700,"_21620":578,"_18607":34474,"_5":21799,"_8577":34156,"_1666":34475},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3684":701,"_21620":578,"_18607":34477,"_5":21799,"_8577":34156,"_1666":34478},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3684":702,"_21620":578,"_18607":34480,"_5":21799,"_8577":34156,"_1666":34481},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3684":703,"_21620":578,"_18607":34483,"_5":21799,"_8577":34156,"_1666":34484},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3684":704,"_21620":578,"_18607":34486,"_5":21799,"_8577":34156,"_1666":34487},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3684":705,"_21620":578,"_18607":34489,"_5":21799,"_8577":34160,"_1666":34490},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3684":706,"_21620":578,"_18607":34492,"_5":21799,"_8577":34160,"_1666":34493},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3684":707,"_21620":578,"_18607":34495,"_5":21799,"_8577":34160,"_1666":34496},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3684":708,"_21620":578,"_18607":34498,"_5":21799,"_8577":34164,"_1666":34499},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3684":709,"_21620":578,"_18607":34501,"_5":21799,"_8577":34164,"_1666":34502},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3684":710,"_21620":578,"_18607":34504,"_5":21799,"_8577":34164,"_1666":34505},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3684":711,"_21620":578,"_18607":34507,"_5":21799,"_8577":34168,"_1666":34508},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3684":712,"_21620":578,"_18607":34510,"_5":21799,"_8577":34168,"_1666":34511},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3684":713,"_21620":578,"_18607":34513,"_5":21799,"_8577":34168,"_1666":34514},[],"Para que el flujo JITP funcione correctamente:",{"_3684":714,"_21620":578,"_18607":34516,"_5":21799,"_8577":34168,"_1666":34517},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3684":715,"_21620":578,"_18607":34519,"_5":21799,"_8577":34168,"_1666":34520},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3684":716,"_21620":578,"_18607":34522,"_5":21799,"_8577":34168,"_1666":34523},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3684":717,"_21620":578,"_18607":34525,"_5":21799,"_8577":34168,"_1666":34526},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3684":718,"_21620":578,"_18607":34528,"_5":21799,"_8577":34172,"_1666":34529},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3684":719,"_21620":578,"_18607":34531,"_5":21799,"_8577":34172,"_1666":34532},[],"Estado en Lamassu",{"_3684":720,"_21620":578,"_18607":34534,"_5":21799,"_8577":34172,"_1666":34535},[],"Razón de revocación",{"_3684":721,"_21620":578,"_18607":34537,"_5":21799,"_8577":34172,"_1666":34538},[],"Estado en AWS IoT Core",{"_3684":722,"_21620":578,"_18607":34540,"_5":21799,"_8577":34172,"_1666":33625},[],{"_3684":723,"_21620":578,"_18607":34542,"_5":21799,"_8577":34172,"_1666":34543},[],"—",{"_3684":724,"_21620":578,"_18607":34545,"_5":21799,"_8577":34172,"_1666":34546},[],"`ACTIVE`",{"_3684":725,"_21620":578,"_18607":34548,"_5":21799,"_8577":34172,"_1666":33661},[],{"_3684":726,"_21620":578,"_18607":34550,"_5":21799,"_8577":34172,"_1666":34551},[],"`certificateHold`",{"_3684":727,"_21620":578,"_18607":34553,"_5":21799,"_8577":34172,"_1666":34554},[],"`INACTIVE`",{"_3684":728,"_21620":578,"_18607":34556,"_5":21799,"_8577":34172,"_1666":33661},[],{"_3684":729,"_21620":578,"_18607":34558,"_5":21799,"_8577":34172,"_1666":34559},[],"Cualquier otra razón",{"_3684":730,"_21620":578,"_18607":34561,"_5":21799,"_8577":34172,"_1666":34562},[],"`REVOKED`",{"_3684":731,"_21620":578,"_18607":34564,"_5":21799,"_8577":34172,"_1666":34565},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3684":732,"_21620":578,"_18607":34567,"_5":21799,"_8577":34176,"_1666":34568},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3684":733,"_21620":578,"_18607":34570,"_5":21799,"_8577":34176,"_1666":34571},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3684":734,"_21620":578,"_18607":34573,"_5":21799,"_8577":34176,"_1666":34574},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3684":735,"_21620":578,"_18607":34576,"_5":21799,"_8577":34180,"_1666":34577},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3684":736,"_21620":578,"_18607":34579,"_5":21799,"_8577":34180,"_1666":34580},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3684":737,"_21620":578,"_18607":34582,"_5":21799,"_8577":34184,"_1666":34583},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3684":738,"_21620":578,"_18607":34585,"_5":21799,"_8577":34184,"_1666":34586},[],"Existen dos tipos de acciones:",{"_3684":739,"_21620":578,"_18607":34588,"_5":21799,"_8577":34184,"_1666":34589},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3684":740,"_21620":578,"_18607":34591,"_5":21799,"_8577":34184,"_1666":34592},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3684":741,"_21620":578,"_18607":34594,"_5":21799,"_8577":34184,"_1666":34595},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3684":742,"_21620":578,"_18607":34597,"_5":21799,"_8577":34188,"_1666":34598},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3684":743,"_21620":578,"_18607":34600,"_5":21799,"_8577":34188,"_1666":34601},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3684":744,"_21620":578,"_18607":34603,"_5":21799,"_8577":34188,"_1666":34604},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3684":745,"_21620":578,"_18607":34606,"_5":21799,"_8577":34192,"_1666":34607},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3684":746,"_21620":578,"_18607":34609,"_5":21799,"_8577":34192,"_1666":34610},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3684":747,"_21620":578,"_18607":34612,"_5":21799,"_8577":34192,"_1666":34613},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3684":748,"_21620":578,"_18607":34615,"_5":21799,"_8577":34192,"_1666":34616},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3684":749,"_21620":578,"_18607":34618,"_5":21799,"_8577":34192,"_1666":34619},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3684":750,"_21620":578,"_18607":34621,"_5":21799,"_8577":34192,"_1666":34622},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3684":751,"_21620":578,"_18607":34624,"_5":21799,"_8577":34192,"_1666":34625},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3684":752,"_21620":578,"_18607":34627,"_5":21799,"_8577":34192,"_1666":34628},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3684":753,"_21620":578,"_18607":34630,"_5":21799,"_8577":34192,"_1666":34631},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3684":754,"_21620":578,"_18607":34633,"_5":21799,"_8577":34192,"_1666":34634},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3684":755,"_21620":578,"_18607":34636,"_5":21799,"_8577":34192,"_1666":34637},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3684":756,"_21620":578,"_18607":34639,"_5":21799,"_8577":34192,"_1666":34640},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3684":757,"_21620":578,"_18607":34642,"_5":21799,"_8577":34192,"_1666":34643},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3684":758,"_21620":578,"_18607":34645,"_5":21799,"_8577":34192,"_1666":34646},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3684":759,"_21620":578,"_18607":34648,"_5":21799,"_8577":34192,"_1666":34649},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3684":760,"_21620":578,"_18607":34651,"_5":21799,"_8577":34192,"_1666":34652},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3684":761,"_21620":578,"_18607":34654,"_5":21799,"_8577":34192,"_1666":34655},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3684":762,"_21620":578,"_18607":34657,"_5":21799,"_8577":34192,"_1666":34658},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3684":763,"_21620":578,"_18607":34660,"_5":21799,"_8577":34192,"_1666":34661},[],"<Card title=\"Configurar un DMS\" href=\"/docs/manual/servicios-core/ra\" />",{"_3684":764,"_21620":578,"_18607":34663,"_5":21799,"_8577":34192,"_1666":34664},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/manual/servicios-core/est\" />",{"_3684":765,"_21620":578,"_18607":34666,"_5":21799,"_8577":34192,"_1666":34667},[],"<Card title=\"Gestión de certificados\" href=\"/docs/manual/servicios-core/certificates\" />",{"_3684":766,"_21620":766,"_5":21794,"_1666":34669,"_21807":34670,"_18607":34672,"_8577":766},"Alertas y suscripciones",[32337,33539,34671],"Operar Lamassu",[],{"_3684":767,"_21620":766,"_18607":34674,"_5":21799,"_8577":766,"_1666":34675},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3684":768,"_21620":766,"_5":21804,"_18607":34677,"_8577":34678,"_1666":34679},[],"/docs/manual/servicios-core/alerts#cómo-funciona","Cómo funciona",{"_3684":769,"_21620":766,"_5":21804,"_18607":34681,"_8577":34682,"_1666":34683},[],"/docs/manual/servicios-core/alerts#canales-disponibles","Canales disponibles",{"_3684":770,"_21620":766,"_5":21804,"_18607":34685,"_8577":34686,"_1666":34687},[],"/docs/manual/servicios-core/alerts#crea-una-suscripción","Crea una suscripción",{"_3684":771,"_21620":766,"_5":21804,"_18607":34689,"_8577":34690,"_1666":34691},[],"/docs/manual/servicios-core/alerts#elige-el-evento","Elige el evento",{"_3684":772,"_21620":766,"_5":21804,"_18607":34693,"_8577":34694,"_1666":34695},[],"/docs/manual/servicios-core/alerts#configura-el-destino","Configura el destino",{"_3684":773,"_21620":766,"_5":21804,"_18607":34697,"_8577":34698,"_1666":34699},[],"/docs/manual/servicios-core/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3684":774,"_21620":766,"_5":21804,"_18607":34701,"_8577":34702,"_1666":34703},[],"/docs/manual/servicios-core/alerts#revisa-y-activa","Revisa y activa",{"_3684":775,"_21620":766,"_5":21804,"_18607":34705,"_8577":34706,"_1666":34707},[],"/docs/manual/servicios-core/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3684":776,"_21620":766,"_5":21804,"_18607":34709,"_8577":34710,"_1666":34711},[],"/docs/manual/servicios-core/alerts#familias-de-eventos","Familias de eventos",{"_3684":777,"_21620":766,"_18607":34713,"_5":21799,"_8577":766,"_1666":34714},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3684":778,"_21620":766,"_18607":34716,"_5":21799,"_8577":34678,"_1666":34717},[],"Un servicio publica un evento de dominio.",{"_3684":779,"_21620":766,"_18607":34719,"_5":21799,"_8577":34678,"_1666":34720},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3684":780,"_21620":766,"_18607":34722,"_5":21799,"_8577":34678,"_1666":34723},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3684":781,"_21620":766,"_18607":34725,"_5":21799,"_8577":34678,"_1666":34726},[],"Lamassu entrega el evento al canal configurado.",{"_3684":782,"_21620":766,"_18607":34728,"_5":21799,"_8577":34678,"_1666":34729},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3684":783,"_21620":766,"_18607":34731,"_5":21799,"_8577":34682,"_1666":34732},[],"Canal",{"_3684":784,"_21620":766,"_18607":34734,"_5":21799,"_8577":34682,"_1666":34735},[],"Configuración",{"_3684":785,"_21620":766,"_18607":34737,"_5":21799,"_8577":34682,"_1666":34738},[],"Uso habitual",{"_3684":786,"_21620":766,"_18607":34740,"_5":21799,"_8577":34682,"_1666":33502},[],{"_3684":787,"_21620":766,"_18607":34742,"_5":21799,"_8577":34682,"_1666":34743},[],"Dirección de destino",{"_3684":788,"_21620":766,"_18607":34745,"_5":21799,"_8577":34682,"_1666":34746},[],"Avisos para personas o listas operativas.",{"_3684":789,"_21620":766,"_18607":34748,"_5":21799,"_8577":34682,"_1666":34749},[],"Microsoft Teams",{"_3684":790,"_21620":766,"_18607":34751,"_5":21799,"_8577":34682,"_1666":34752},[],"Nombre y URL de webhook",{"_3684":791,"_21620":766,"_18607":34754,"_5":21799,"_8577":34682,"_1666":34755},[],"Notificaciones en un canal de colaboración.",{"_3684":792,"_21620":766,"_18607":34757,"_5":21799,"_8577":34682,"_1666":34758},[],"Webhook",{"_3684":793,"_21620":766,"_18607":34760,"_5":21799,"_8577":34682,"_1666":34761},[],"Nombre, método `POST` o `PUT` y URL",{"_3684":794,"_21620":766,"_18607":34763,"_5":21799,"_8577":34682,"_1666":34764},[],"Integración con automatización, SIEM o gestión de incidentes.",{"_3684":795,"_21620":766,"_18607":34766,"_5":21799,"_8577":34690,"_1666":34767},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3684":796,"_21620":766,"_18607":34769,"_5":21799,"_8577":34694,"_1666":34770},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3684":797,"_21620":766,"_18607":34772,"_5":21799,"_8577":34698,"_1666":34773},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3684":798,"_21620":766,"_18607":34775,"_5":21799,"_8577":34698,"_1666":34776},[],"Filtro",{"_3684":799,"_21620":766,"_18607":34778,"_5":21799,"_8577":34698,"_1666":34779},[],"Cuándo utilizarlo",{"_3684":800,"_21620":766,"_18607":34781,"_5":21799,"_8577":34698,"_1666":34782},[],"**None**",{"_3684":801,"_21620":766,"_18607":34784,"_5":21799,"_8577":34698,"_1666":34785},[],"Cada instancia del evento es relevante.",{"_3684":802,"_21620":766,"_18607":34787,"_5":21799,"_8577":34698,"_1666":34788},[],"**JSON Path**",{"_3684":803,"_21620":766,"_18607":34790,"_5":21799,"_8577":34698,"_1666":34791},[],"Una condición depende de uno o varios campos concretos.",{"_3684":804,"_21620":766,"_18607":34793,"_5":21799,"_8577":34698,"_1666":34794},[],"**JSON Schema**",{"_3684":805,"_21620":766,"_18607":34796,"_5":21799,"_8577":34698,"_1666":34797},[],"Solo deben aceptarse payloads con una estructura determinada.",{"_3684":806,"_21620":766,"_18607":34799,"_5":21799,"_8577":34698,"_1666":34800},[],"**JavaScript**",{"_3684":807,"_21620":766,"_18607":34802,"_5":21799,"_8577":34698,"_1666":34803},[],"La condición necesita lógica personalizada.",{"_3684":808,"_21620":766,"_18607":34805,"_5":21799,"_8577":34698,"_1666":34806},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3684":809,"_21620":766,"_18607":34808,"_5":21799,"_8577":34702,"_1666":34809},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3684":810,"_21620":766,"_18607":34811,"_5":21799,"_8577":34706,"_1666":34812},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3684":811,"_21620":766,"_18607":34814,"_5":21799,"_8577":34710,"_1666":33335},[],{"_3684":812,"_21620":766,"_18607":34816,"_5":21799,"_8577":34710,"_1666":34817},[],"Ejemplos",{"_3684":813,"_21620":766,"_18607":34819,"_5":21799,"_8577":34710,"_1666":34820},[],"Autoridades",{"_3684":814,"_21620":766,"_18607":34822,"_5":21799,"_8577":34710,"_1666":34823},[],"`ca.create`, `ca.import`, `ca.reissue`, `ca.delete`",{"_3684":815,"_21620":766,"_18607":34825,"_5":21799,"_8577":34710,"_1666":34826},[],"Certificados",{"_3684":816,"_21620":766,"_18607":34828,"_5":21799,"_8577":34710,"_1666":34829},[],"`ca.sign.certificate`, `certificate.delete`",{"_3684":817,"_21620":766,"_18607":34831,"_5":21799,"_8577":34710,"_1666":34832},[],"Perfiles",{"_3684":818,"_21620":766,"_18607":34834,"_5":21799,"_8577":34710,"_1666":34835},[],"`profile.create`, `profile.update`, `profile.delete`",{"_3684":819,"_21620":766,"_18607":34837,"_5":21799,"_8577":34710,"_1666":34838},[],"Enrolamiento",{"_3684":820,"_21620":766,"_18607":34840,"_5":21799,"_8577":34710,"_1666":34841},[],"`dms.create`, `dms.update`, `dms.enroll`, `dms.reenroll`",{"_3684":821,"_21620":766,"_18607":34843,"_5":21799,"_8577":34710,"_1666":33487},[],{"_3684":822,"_21620":766,"_18607":34845,"_5":21799,"_8577":34710,"_1666":34846},[],"`device.create`, `device.identity.update`, `device.status.update`",{"_3684":823,"_21620":766,"_18607":34848,"_5":21799,"_8577":34710,"_1666":34849},[],"Validación",{"_3684":824,"_21620":766,"_18607":34851,"_5":21799,"_8577":34710,"_1666":34852},[],"`va.role.crl.create`",{"_3684":825,"_21620":766,"_18607":34854,"_5":21799,"_8577":34710,"_1666":34855},[],"Claves",{"_3684":826,"_21620":766,"_18607":34857,"_5":21799,"_8577":34710,"_1666":34858},[],"`kms.create`, `kms.import`, `kms.sign.message`, `kms.delete`",{"_3684":827,"_21620":766,"_18607":34860,"_5":21799,"_8577":34710,"_1666":34861},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3684":828,"_21620":828,"_5":21794,"_1666":34863,"_21807":34864,"_18607":34865,"_8577":828},"Autoridades de certificación",[32337,33539,34671],[],{"_3684":829,"_21620":828,"_18607":34867,"_5":21799,"_8577":828,"_1666":34868},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3684":830,"_21620":828,"_5":21804,"_18607":34870,"_8577":34871,"_1666":34872},[],"/docs/manual/servicios-core/cas#elige-un-flujo","Elige un flujo",{"_3684":831,"_21620":828,"_5":21804,"_18607":34874,"_8577":34875,"_1666":34876},[],"/docs/manual/servicios-core/cas#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3684":832,"_21620":828,"_5":21804,"_18607":34878,"_8577":34879,"_1666":32347},[],"/docs/manual/servicios-core/cas#antes-de-empezar",{"_3684":833,"_21620":828,"_5":21804,"_18607":34881,"_8577":34882,"_1666":34883},[],"/docs/manual/servicios-core/cas#abre-el-asistente","Abre el asistente",{"_3684":834,"_21620":828,"_5":21804,"_18607":34885,"_8577":34886,"_1666":34887},[],"/docs/manual/servicios-core/cas#configura-la-clave","Configura la clave",{"_3684":835,"_21620":828,"_5":21804,"_18607":34889,"_8577":34890,"_1666":34891},[],"/docs/manual/servicios-core/cas#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3684":836,"_21620":828,"_5":21804,"_18607":34893,"_8577":34894,"_1666":34895},[],"/docs/manual/servicios-core/cas#define-la-identidad","Define la identidad",{"_3684":837,"_21620":828,"_5":21804,"_18607":34897,"_8577":34898,"_1666":34899},[],"/docs/manual/servicios-core/cas#configura-validez-y-usos","Configura validez y usos",{"_3684":838,"_21620":828,"_5":21804,"_18607":34901,"_8577":34902,"_1666":34903},[],"/docs/manual/servicios-core/cas#crea-y-verifica","Crea y verifica",{"_3684":839,"_21620":828,"_5":21804,"_18607":34905,"_8577":34906,"_1666":34907},[],"/docs/manual/servicios-core/cas#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3684":840,"_21620":828,"_5":21804,"_18607":34909,"_8577":34910,"_1666":34911},[],"/docs/manual/servicios-core/cas#importa-una-ca-externa","Importa una CA externa",{"_3684":841,"_21620":828,"_5":21804,"_18607":34913,"_8577":34914,"_1666":34915},[],"/docs/manual/servicios-core/cas#selecciona-el-motor","Selecciona el motor",{"_3684":842,"_21620":828,"_5":21804,"_18607":34917,"_8577":34918,"_1666":34919},[],"/docs/manual/servicios-core/cas#carga-el-material","Carga el material",{"_3684":843,"_21620":828,"_5":21804,"_18607":34921,"_8577":34922,"_1666":34923},[],"/docs/manual/servicios-core/cas#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3684":844,"_21620":828,"_5":21804,"_18607":34925,"_8577":34926,"_1666":34927},[],"/docs/manual/servicios-core/cas#verifica-la-importación","Verifica la importación",{"_3684":845,"_21620":828,"_5":21804,"_18607":34929,"_8577":34930,"_1666":34931},[],"/docs/manual/servicios-core/cas#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3684":846,"_21620":828,"_5":21804,"_18607":34933,"_8577":34934,"_1666":34935},[],"/docs/manual/servicios-core/cas#emite-certificados","Emite certificados",{"_3684":847,"_21620":828,"_5":21804,"_18607":34937,"_8577":34938,"_1666":34939},[],"/docs/manual/servicios-core/cas#revoca-una-ca","Revoca una CA",{"_3684":848,"_21620":828,"_5":21804,"_18607":34941,"_8577":34942,"_1666":34943},[],"/docs/manual/servicios-core/cas#evalúa-el-impacto","Evalúa el impacto",{"_3684":849,"_21620":828,"_5":21804,"_18607":34945,"_8577":34946,"_1666":34947},[],"/docs/manual/servicios-core/cas#inicia-la-revocación","Inicia la revocación",{"_3684":850,"_21620":828,"_5":21804,"_18607":34949,"_8577":34950,"_1666":34951},[],"/docs/manual/servicios-core/cas#confirma-la-identidad","Confirma la identidad",{"_3684":851,"_21620":828,"_5":21804,"_18607":34953,"_8577":34954,"_1666":34955},[],"/docs/manual/servicios-core/cas#comprueba-la-publicación","Comprueba la publicación",{"_3684":852,"_21620":828,"_18607":34957,"_5":21799,"_8577":828,"_1666":34958},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3684":853,"_21620":828,"_18607":34960,"_5":21799,"_8577":34871,"_1666":34961},[],"Necesitas",{"_3684":854,"_21620":828,"_18607":34963,"_5":21799,"_8577":34871,"_1666":34964},[],"Flujo",{"_3684":855,"_21620":828,"_18607":34966,"_5":21799,"_8577":34871,"_1666":34967},[],"Resultado",{"_3684":856,"_21620":828,"_18607":34969,"_5":21799,"_8577":34871,"_1666":34970},[],"Crear una raíz de confianza nueva",{"_3684":857,"_21620":828,"_18607":34972,"_5":21799,"_8577":34871,"_1666":34973},[],"Nueva CA y nueva clave",{"_3684":858,"_21620":828,"_18607":34975,"_5":21799,"_8577":34871,"_1666":34976},[],"Lamassu genera y custodia el par de claves.",{"_3684":859,"_21620":828,"_18607":34978,"_5":21799,"_8577":34871,"_1666":34979},[],"Crear una CA con una clave existente",{"_3684":860,"_21620":828,"_18607":34981,"_5":21799,"_8577":34871,"_1666":34982},[],"Nueva CA desde KMS",{"_3684":861,"_21620":828,"_18607":34984,"_5":21799,"_8577":34871,"_1666":34985},[],"La CA reutiliza una clave ya registrada.",{"_3684":862,"_21620":828,"_18607":34987,"_5":21799,"_8577":34871,"_1666":34988},[],"Migrar una CA operativa",{"_3684":863,"_21620":828,"_18607":34990,"_5":21799,"_8577":34871,"_1666":34991},[],"Importar CA con clave privada",{"_3684":864,"_21620":828,"_18607":34993,"_5":21799,"_8577":34871,"_1666":34994},[],"Lamassu puede emitir con la CA importada.",{"_3684":865,"_21620":828,"_18607":34996,"_5":21799,"_8577":34871,"_1666":34997},[],"Confiar en una CA externa",{"_3684":866,"_21620":828,"_18607":34999,"_5":21799,"_8577":34871,"_1666":35000},[],"Importar solo el certificado",{"_3684":867,"_21620":828,"_18607":35002,"_5":21799,"_8577":34871,"_1666":35003},[],"La CA se usa para validación, no para emitir.",{"_3684":868,"_21620":828,"_18607":35005,"_5":21799,"_8577":34871,"_1666":35006},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3684":869,"_21620":828,"_18607":35008,"_5":21799,"_8577":34879,"_1666":35009},[],"Decide si la CA será raíz o intermedia.",{"_3684":870,"_21620":828,"_18607":35011,"_5":21799,"_8577":34879,"_1666":35012},[],"Elige el motor que custodiará la clave.",{"_3684":871,"_21620":828,"_18607":35014,"_5":21799,"_8577":34879,"_1666":35015},[],"Define una validez superior a la de los certificados que emitirá.",{"_3684":872,"_21620":828,"_18607":35017,"_5":21799,"_8577":34879,"_1666":35018},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3684":873,"_21620":828,"_18607":35020,"_5":21799,"_8577":34882,"_1666":35021},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3684":874,"_21620":828,"_18607":35023,"_5":21799,"_8577":34886,"_1666":35024},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3684":875,"_21620":828,"_18607":35026,"_5":21799,"_8577":34886,"_1666":35027},[],"Algoritmo",{"_3684":876,"_21620":828,"_18607":35029,"_5":21799,"_8577":34886,"_1666":35030},[],"Parámetros disponibles",{"_3684":877,"_21620":828,"_18607":35032,"_5":21799,"_8577":34886,"_1666":35033},[],"RSA",{"_3684":878,"_21620":828,"_18607":35035,"_5":21799,"_8577":34886,"_1666":35036},[],"1024, 2048, 3072 o 4096 bits",{"_3684":879,"_21620":828,"_18607":35038,"_5":21799,"_8577":34886,"_1666":35039},[],"EC",{"_3684":880,"_21620":828,"_18607":35041,"_5":21799,"_8577":34886,"_1666":35042},[],"P-256, P-384 o P-521",{"_3684":881,"_21620":828,"_18607":35044,"_5":21799,"_8577":34890,"_1666":35045},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3684":882,"_21620":828,"_18607":35047,"_5":21799,"_8577":34894,"_1666":35048},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3684":883,"_21620":828,"_18607":35050,"_5":21799,"_8577":34894,"_1666":35051},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3684":884,"_21620":828,"_18607":35053,"_5":21799,"_8577":34894,"_1666":35054},[],"`ST`: estado o provincia.",{"_3684":885,"_21620":828,"_18607":35056,"_5":21799,"_8577":34894,"_1666":35057},[],"`L`: localidad.",{"_3684":886,"_21620":828,"_18607":35059,"_5":21799,"_8577":34894,"_1666":35060},[],"`O`: organización.",{"_3684":887,"_21620":828,"_18607":35062,"_5":21799,"_8577":34894,"_1666":35063},[],"`OU`: unidad organizativa.",{"_3684":888,"_21620":828,"_18607":35065,"_5":21799,"_8577":34894,"_1666":35066},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3684":889,"_21620":828,"_18607":35068,"_5":21799,"_8577":34898,"_1666":35069},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3684":890,"_21620":828,"_18607":35071,"_5":21799,"_8577":34898,"_1666":35072},[],"Selecciona un perfil de emisión existente o configura los `Key Usage` y `Extended Key Usage` en el formulario. Si no eliges un perfil, Lamassu aplica los usos básicos predeterminados.",{"_3684":891,"_21620":828,"_18607":35074,"_5":21799,"_8577":34902,"_1666":35075},[],"Confirma el formulario. La CA debe aparecer en el inventario con su certificado PEM, estado, fecha de expiración y relación de certificados emitidos.",{"_3684":892,"_21620":828,"_18607":35077,"_5":21799,"_8577":34902,"_1666":35078},[],"Una CA no puede emitir certificados que superen su propia fecha de expiración. Deja margen suficiente para renovar o sustituir la autoridad sin interrumpir a los consumidores.",{"_3684":893,"_21620":828,"_18607":35080,"_5":21799,"_8577":34906,"_1666":35081},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3684":894,"_21620":828,"_18607":35083,"_5":21799,"_8577":34906,"_1666":35084},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3684":895,"_21620":828,"_18607":35086,"_5":21799,"_8577":34910,"_1666":35087},[],"La importación conserva una autoridad creada fuera de Lamassu.",{"_3684":896,"_21620":828,"_18607":35089,"_5":21799,"_8577":34914,"_1666":35090},[],"Elige el motor que custodiará la clave importada.",{"_3684":897,"_21620":828,"_18607":35092,"_5":21799,"_8577":34918,"_1666":35093},[],"Proporciona el certificado de CA y la clave privada en formato PEM. Para una CA subordinada, añade opcionalmente la cadena de validación.",{"_3684":898,"_21620":828,"_18607":35095,"_5":21799,"_8577":34922,"_1666":35096},[],"Configura la validez que recibirán los certificados finales cuando una solicitud no indique otra duración.",{"_3684":899,"_21620":828,"_18607":35098,"_5":21799,"_8577":34926,"_1666":35099},[],"Lamassu comprueba que el certificado pertenece a una CA y que el material es coherente antes de registrarlo.",{"_3684":900,"_21620":828,"_18607":35101,"_5":21799,"_8577":34926,"_1666":35102},[],"Si no dispones de la clave privada, importa únicamente el certificado. La autoridad podrá formar parte de cadenas de confianza y procesos de validación, pero no podrá emitir certificados desde Lamassu.",{"_3684":901,"_21620":828,"_18607":35104,"_5":21799,"_8577":34930,"_1666":35105},[],"Abre una CA desde el inventario para consultar:",{"_3684":902,"_21620":828,"_18607":35107,"_5":21799,"_8577":34930,"_1666":35108},[],"Estado y periodo de validez.",{"_3684":903,"_21620":828,"_18607":35110,"_5":21799,"_8577":34930,"_1666":35111},[],"Certificado y cadena en formato PEM.",{"_3684":904,"_21620":828,"_18607":35113,"_5":21799,"_8577":34930,"_1666":35114},[],"Número de certificados activos, expirados y revocados.",{"_3684":905,"_21620":828,"_18607":35116,"_5":21799,"_8577":34930,"_1666":35117},[],"Certificados emitidos en **Issued Certificates**.",{"_3684":906,"_21620":828,"_18607":35119,"_5":21799,"_8577":34930,"_1666":35120},[],"CRL vinculada a la autoridad.",{"_3684":907,"_21620":828,"_18607":35122,"_5":21799,"_8577":34930,"_1666":35123},[],"Metadatos y motor criptográfico asociado.",{"_3684":908,"_21620":828,"_18607":35125,"_5":21799,"_8577":34930,"_1666":35126},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3684":909,"_21620":828,"_18607":35128,"_5":21799,"_8577":34934,"_1666":35129},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3684":910,"_21620":828,"_18607":35131,"_5":21799,"_8577":34934,"_1666":35132},[],"Método",{"_3684":911,"_21620":828,"_18607":35134,"_5":21799,"_8577":34934,"_1666":35135},[],"Cuándo usarlo",{"_3684":912,"_21620":828,"_18607":35137,"_5":21799,"_8577":34934,"_1666":35138},[],"Custodia de la clave",{"_3684":913,"_21620":828,"_18607":35140,"_5":21799,"_8577":34934,"_1666":35141},[],"**Generate Key & CSR in Browser**",{"_3684":914,"_21620":828,"_18607":35143,"_5":21799,"_8577":34934,"_1666":35144},[],"Operación manual o prueba rápida",{"_3684":915,"_21620":828,"_18607":35146,"_5":21799,"_8577":34934,"_1666":35147},[],"El navegador genera la clave; debes descargarla.",{"_3684":916,"_21620":828,"_18607":35149,"_5":21799,"_8577":34934,"_1666":35150},[],"**Upload Existing CSR**",{"_3684":917,"_21620":828,"_18607":35152,"_5":21799,"_8577":34934,"_1666":35153},[],"La clave debe permanecer en el sistema de destino",{"_3684":918,"_21620":828,"_18607":35155,"_5":21799,"_8577":34934,"_1666":35156},[],"Lamassu nunca recibe la clave privada.",{"_3684":919,"_21620":828,"_18607":35158,"_5":21799,"_8577":34934,"_1666":35159},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3684":920,"_21620":828,"_18607":35161,"_5":21799,"_8577":34938,"_1666":35162},[],"Revocar una CA invalida la confianza en los certificados que ha emitido y puede interrumpir dispositivos y servicios. La acción es irreversible.",{"_3684":921,"_21620":828,"_18607":35164,"_5":21799,"_8577":34942,"_1666":35165},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3684":922,"_21620":828,"_18607":35167,"_5":21799,"_8577":34946,"_1666":35168},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3684":923,"_21620":828,"_18607":35170,"_5":21799,"_8577":34950,"_1666":35171},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3684":924,"_21620":828,"_18607":35173,"_5":21799,"_8577":34954,"_1666":35174},[],"El estado debe cambiar a **REVOKED** y la CRL debe reflejar la nueva información. La CA deja de poder emitir certificados.",{"_3684":925,"_21620":828,"_18607":35176,"_5":21799,"_8577":34954,"_1666":35177},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3684":926,"_21620":926,"_5":21794,"_1666":34826,"_21807":35179,"_18607":35180,"_8577":926},[32337,33539,34671],[],{"_3684":927,"_21620":926,"_18607":35182,"_5":21799,"_8577":926,"_1666":35183},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3684":928,"_21620":926,"_5":21804,"_18607":35185,"_8577":35186,"_1666":35187},[],"/docs/manual/servicios-core/certificates#busca-un-certificado","Busca un certificado",{"_3684":929,"_21620":926,"_5":21804,"_18607":35189,"_8577":35190,"_1666":35191},[],"/docs/manual/servicios-core/certificates#descarga-el-certificado","Descarga el certificado",{"_3684":930,"_21620":926,"_5":21804,"_18607":35193,"_8577":35194,"_1666":35195},[],"/docs/manual/servicios-core/certificates#revoca-un-certificado","Revoca un certificado",{"_3684":931,"_21620":926,"_5":21804,"_18607":35197,"_8577":35198,"_1666":35199},[],"/docs/manual/servicios-core/certificates#abre-la-acción","Abre la acción",{"_3684":932,"_21620":926,"_5":21804,"_18607":35201,"_8577":35202,"_1666":35203},[],"/docs/manual/servicios-core/certificates#elige-una-razón","Elige una razón",{"_3684":933,"_21620":926,"_5":21804,"_18607":35205,"_8577":35206,"_1666":35207},[],"/docs/manual/servicios-core/certificates#confirma-y-verifica","Confirma y verifica",{"_3684":934,"_21620":926,"_5":21804,"_18607":35209,"_8577":35210,"_1666":35211},[],"/docs/manual/servicios-core/certificates#continúa","Continúa",{"_3684":935,"_21620":926,"_18607":35213,"_5":21799,"_8577":926,"_1666":35214},[],"El inventario de certificados ofrece una vista global de las identidades emitidas por todas las autoridades. También puedes abrir **Issued Certificates** dentro de una CA para limitar la vista a ese emisor.",{"_3684":936,"_21620":926,"_18607":35216,"_5":21799,"_8577":35186,"_1666":35217},[],"Abre **Certificates** y filtra por:",{"_3684":937,"_21620":926,"_18607":35219,"_5":21799,"_8577":35186,"_1666":35220},[],"`Common Name` del sujeto.",{"_3684":938,"_21620":926,"_18607":35222,"_5":21799,"_8577":35186,"_1666":35223},[],"Número de serie.",{"_3684":939,"_21620":926,"_18607":35225,"_5":21799,"_8577":35186,"_1666":35226},[],"Estado.",{"_3684":940,"_21620":926,"_18607":35228,"_5":21799,"_8577":35186,"_1666":35229},[],"Autoridad emisora.",{"_3684":941,"_21620":926,"_18607":35231,"_5":21799,"_8577":35186,"_1666":35232},[],"Utiliza **Quick Inspect** para una comprobación rápida o **View Details** para ver el sujeto, SANs, usos, cadena, periodo de validez y metadatos completos.",{"_3684":942,"_21620":926,"_18607":35234,"_5":21799,"_8577":35190,"_1666":35235},[],"La acción de descarga entrega el certificado en formato PEM. Si el certificado se emitió mediante un CSR externo, la clave privada permanece en el sistema que generó ese CSR. Si se generó en el navegador, la clave solo estuvo disponible al finalizar la emisión.",{"_3684":943,"_21620":926,"_18607":35237,"_5":21799,"_8577":35194,"_1666":35238},[],"Revoca una identidad cuando la clave se haya comprometido, el sujeto ya no esté autorizado o el certificado deba dejar de aceptarse antes de expirar.",{"_3684":944,"_21620":926,"_18607":35240,"_5":21799,"_8577":35198,"_1666":35241},[],"En el inventario o la vista de detalle, selecciona **Revoke Certificate**.",{"_3684":945,"_21620":926,"_18607":35243,"_5":21799,"_8577":35202,"_1666":35244},[],"Selecciona la razón que represente el incidente. Esta información se publica en OCSP y en la CRL.",{"_3684":946,"_21620":926,"_18607":35246,"_5":21799,"_8577":35206,"_1666":35247},[],"Confirma la operación y comprueba que el estado sea **Revoked**. Si la CA regenera la CRL al revocar, verifica también que exista una versión nueva.",{"_3684":947,"_21620":926,"_18607":35249,"_5":21799,"_8577":35206,"_1666":35250},[],"Una revocación con la razón `CertificateHold` puede reactivarse. Las demás razones producen una revocación definitiva.",{"_3684":948,"_21620":926,"_18607":35252,"_5":21799,"_8577":35210,"_1666":35253},[],"<Card title=\"Validar con OCSP\" description=\"Consulta el estado de un certificado en tiempo real.\" href=\"/docs/manual/servicios-core/validation-ocsp\" />",{"_3684":949,"_21620":926,"_18607":35255,"_5":21799,"_8577":35210,"_1666":35256},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación offline.\" href=\"/docs/manual/servicios-core/validation-crl\" />",{"_3684":950,"_21620":950,"_5":21794,"_1666":35258,"_21807":35259,"_18607":35260,"_8577":950},"Dispositivos e identidades",[32337,33539,34671],[],{"_3684":951,"_21620":950,"_18607":35262,"_5":21799,"_8577":950,"_1666":35263},[],"Registra dispositivos y controla sus identidades durante todo el ciclo de vida.",{"_3684":952,"_21620":950,"_5":21804,"_18607":35265,"_8577":35266,"_1666":35267},[],"/docs/manual/servicios-core/devices#estados-del-dispositivo","Estados del dispositivo",{"_3684":953,"_21620":950,"_5":21804,"_18607":35269,"_8577":35270,"_1666":35271},[],"/docs/manual/servicios-core/devices#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3684":954,"_21620":950,"_5":21804,"_18607":35273,"_8577":35274,"_1666":35275},[],"/docs/manual/servicios-core/devices#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3684":955,"_21620":950,"_5":21804,"_18607":35277,"_8577":35278,"_1666":35279},[],"/docs/manual/servicios-core/devices#crea-el-dispositivo","Crea el dispositivo",{"_3684":956,"_21620":950,"_5":21804,"_18607":35281,"_8577":35282,"_1666":35283},[],"/docs/manual/servicios-core/devices#define-su-pertenencia","Define su pertenencia",{"_3684":957,"_21620":950,"_5":21804,"_18607":35285,"_8577":35286,"_1666":35287},[],"/docs/manual/servicios-core/devices#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3684":958,"_21620":950,"_5":21804,"_18607":35289,"_8577":35290,"_1666":35291},[],"/docs/manual/servicios-core/devices#verifica-el-alta","Verifica el alta",{"_3684":959,"_21620":950,"_5":21804,"_18607":35293,"_8577":35294,"_1666":35295},[],"/docs/manual/servicios-core/devices#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3684":960,"_21620":950,"_5":21804,"_18607":35297,"_8577":35298,"_1666":35299},[],"/docs/manual/servicios-core/devices#revoca-la-identidad-actual","Revoca la identidad actual",{"_3684":961,"_21620":950,"_5":21804,"_18607":35301,"_8577":35302,"_1666":35303},[],"/docs/manual/servicios-core/devices#retira-un-dispositivo","Retira un dispositivo",{"_3684":962,"_21620":950,"_5":21804,"_18607":35305,"_8577":35306,"_1666":35307},[],"/docs/manual/servicios-core/devices#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3684":963,"_21620":950,"_18607":35309,"_5":21799,"_8577":950,"_1666":35310},[],"Un dispositivo gestionado representa una entidad de tu flota y conserva el historial de los certificados que ha utilizado. Lamassu separa el dispositivo de su identidad actual para que puedas renovar o sustituir certificados sin perder trazabilidad.",{"_3684":964,"_21620":950,"_18607":35312,"_5":21799,"_8577":35266,"_1666":33607},[],{"_3684":965,"_21620":950,"_18607":35314,"_5":21799,"_8577":35266,"_1666":35315},[],"Significado",{"_3684":966,"_21620":950,"_18607":35317,"_5":21799,"_8577":35266,"_1666":35318},[],"**Active**",{"_3684":967,"_21620":950,"_18607":35320,"_5":21799,"_8577":35266,"_1666":35321},[],"El dispositivo tiene una identidad válida.",{"_3684":968,"_21620":950,"_18607":35323,"_5":21799,"_8577":35266,"_1666":35324},[],"**No Identity**",{"_3684":969,"_21620":950,"_18607":35326,"_5":21799,"_8577":35266,"_1666":35327},[],"Está registrado, pero no tiene un certificado asociado.",{"_3684":970,"_21620":950,"_18607":35329,"_5":21799,"_8577":35266,"_1666":35330},[],"**Renewal Pending**",{"_3684":971,"_21620":950,"_18607":35332,"_5":21799,"_8577":35266,"_1666":35333},[],"Ha entrado en la ventana de renovación.",{"_3684":972,"_21620":950,"_18607":35335,"_5":21799,"_8577":35266,"_1666":35336},[],"**Expiring Soon**",{"_3684":973,"_21620":950,"_18607":35338,"_5":21799,"_8577":35266,"_1666":35339},[],"Su certificado está próximo a expirar.",{"_3684":974,"_21620":950,"_18607":35341,"_5":21799,"_8577":35266,"_1666":35342},[],"**Expired**",{"_3684":975,"_21620":950,"_18607":35344,"_5":21799,"_8577":35266,"_1666":35345},[],"La identidad ha superado su fecha de validez.",{"_3684":976,"_21620":950,"_18607":35347,"_5":21799,"_8577":35266,"_1666":35348},[],"**Revoked**",{"_3684":977,"_21620":950,"_18607":35350,"_5":21799,"_8577":35266,"_1666":35351},[],"El certificado actual se ha revocado.",{"_3684":978,"_21620":950,"_18607":35353,"_5":21799,"_8577":35266,"_1666":35354},[],"**Decommissioned**",{"_3684":979,"_21620":950,"_18607":35356,"_5":21799,"_8577":35266,"_1666":35357},[],"El dispositivo se ha retirado de forma permanente.",{"_3684":980,"_21620":950,"_18607":35359,"_5":21799,"_8577":35266,"_1666":35360},[],"El inventario permite filtrar por `Device ID`, etiquetas y estado.",{"_3684":981,"_21620":950,"_18607":35362,"_5":21799,"_8577":35270,"_1666":35363},[],"La vista de detalle separa dos perspectivas:",{"_3684":982,"_21620":950,"_18607":35365,"_5":21799,"_8577":35270,"_1666":35366},[],"**Certificate History** conserva todos los certificados asociados, con su número de serie, emisor, estado y periodo de validez.",{"_3684":983,"_21620":950,"_18607":35368,"_5":21799,"_8577":35270,"_1666":35369},[],"**Device Event Timeline** ordena cronológicamente registros, enrolamientos, renovaciones y cambios de estado.",{"_3684":984,"_21620":950,"_18607":35371,"_5":21799,"_8577":35270,"_1666":35372},[],"Utiliza el historial para auditoría y la línea de tiempo para reconstruir un incidente o diagnosticar una transición inesperada.",{"_3684":985,"_21620":950,"_18607":35374,"_5":21799,"_8577":35274,"_1666":35375},[],"El registro previo es útil cuando la política exige que el dispositivo exista antes de solicitar su primer certificado.",{"_3684":986,"_21620":950,"_18607":35377,"_5":21799,"_8577":35278,"_1666":35378},[],"Desde **Managed Devices**, abre el formulario de registro.",{"_3684":987,"_21620":950,"_18607":35380,"_5":21799,"_8577":35282,"_1666":35381},[],"Introduce un **Device ID** único y selecciona el DMS que aplicará las políticas de enrolamiento y renovación.",{"_3684":988,"_21620":950,"_18607":35383,"_5":21799,"_8577":35286,"_1666":35384},[],"Añade un icono y etiquetas si necesitas agruparlo por modelo, ubicación, entorno u otro criterio operativo.",{"_3684":989,"_21620":950,"_18607":35386,"_5":21799,"_8577":35290,"_1666":35387},[],"El dispositivo debe aparecer con estado **No Identity** hasta que complete el enrolamiento o reciba una identidad manual.",{"_3684":990,"_21620":950,"_18607":35389,"_5":21799,"_8577":35294,"_1666":35390},[],"La acción **Assign Identity** está disponible mientras el dispositivo permanece en **No Identity**.",{"_3684":991,"_21620":950,"_18607":35392,"_5":21799,"_8577":35294,"_1666":35393},[],"Abre el dispositivo y selecciona **Assign Identity**.",{"_3684":992,"_21620":950,"_18607":35395,"_5":21799,"_8577":35294,"_1666":35396},[],"Elige un certificado activo cuyo `Common Name` coincida con el `Device ID`.",{"_3684":993,"_21620":950,"_18607":35398,"_5":21799,"_8577":35294,"_1666":35399},[],"Si no existe, selecciona **Issue New Instead** y elige una CA vinculada al DMS.",{"_3684":994,"_21620":950,"_18607":35401,"_5":21799,"_8577":35294,"_1666":35402},[],"Confirma la asignación.",{"_3684":995,"_21620":950,"_18607":35404,"_5":21799,"_8577":35294,"_1666":35405},[],"El dispositivo debe cambiar a **Active** y el certificado debe aparecer en su historial.",{"_3684":996,"_21620":950,"_18607":35407,"_5":21799,"_8577":35298,"_1666":35408},[],"En **Device Event Timeline**, localiza el último certificado activo y selecciona **Revoke**. Elige una razón conforme a tu política y confirma la operación.",{"_3684":997,"_21620":950,"_18607":35410,"_5":21799,"_8577":35298,"_1666":35411},[],"La revocación invalida el certificado, pero no elimina el dispositivo. Puedes restaurar su operación asignándole una identidad nueva. `CertificateHold` permite reactivar el certificado retenido; el resto de razones son definitivas.",{"_3684":998,"_21620":950,"_18607":35413,"_5":21799,"_8577":35302,"_1666":35414},[],"Esta acción revoca todos los certificados del dispositivo e impide que vuelva a obtener una identidad.",{"_3684":999,"_21620":950,"_18607":35416,"_5":21799,"_8577":35302,"_1666":35417},[],"Usa **Decommission** únicamente cuando el dispositivo haya dejado de operar o ya no sea fiable. Tras confirmar, Lamassu revoca la identidad activa con `CessationOfOperation` y cambia el estado a **Decommissioned**.",{"_3684":1000,"_21620":950,"_18607":35419,"_5":21799,"_8577":35306,"_1666":35420},[],"<Card title=\"Configura un DMS\" description=\"Define la CA, confianza y políticas de la flota.\" href=\"/docs/manual/servicios-core/ra\" />",{"_3684":1001,"_21620":950,"_18607":35422,"_5":21799,"_8577":35306,"_1666":35423},[],"<Card title=\"Integra EST\" description=\"Permite que el dispositivo solicite y renueve su identidad.\" href=\"/docs/manual/servicios-core/est\" />",{"_3684":1002,"_21620":1002,"_5":21794,"_1666":35425,"_21807":35426,"_18607":35427,"_8577":1002},"Enrolamiento de dispositivos con EST",[32337,33539,34671],[],{"_3684":1003,"_21620":1002,"_18607":35429,"_5":21799,"_8577":1002,"_1666":35430},[],"Guía del protocolo EST en Lamassu IoT, con la configuración del DMS para el administrador PKI y la referencia de endpoints para el integrador de dispositivos.",{"_3684":1004,"_21620":1002,"_5":21804,"_18607":35432,"_8577":35433,"_1666":35434},[],"/docs/manual/servicios-core/est#est-enrollment-over-secure-transport","EST: Enrollment over Secure Transport",{"_3684":1005,"_21620":1002,"_5":21804,"_18607":35436,"_8577":35437,"_1666":34149},[],"/docs/manual/servicios-core/est#configuración-del-dms",{"_3684":1006,"_21620":1002,"_5":21804,"_18607":35439,"_8577":35440,"_1666":33147},[],"/docs/manual/servicios-core/est#requisitos-previos",{"_3684":1007,"_21620":1002,"_5":21804,"_18607":35442,"_8577":35443,"_1666":35444},[],"/docs/manual/servicios-core/est#configuración-de-enrollment","Configuración de enrollment",{"_3684":1008,"_21620":1002,"_5":21804,"_18607":35446,"_8577":35447,"_1666":35448},[],"/docs/manual/servicios-core/est#enrollment-device-registration","Enrollment Device Registration",{"_3684":1009,"_21620":1002,"_5":21804,"_18607":35450,"_8577":35451,"_1666":35452},[],"/docs/manual/servicios-core/est#enrollment-settings","Enrollment Settings",{"_3684":1010,"_21620":1002,"_5":21804,"_18607":35454,"_8577":35455,"_1666":35456},[],"/docs/manual/servicios-core/est#perfil-de-emisión","Perfil de emisión",{"_3684":1011,"_21620":1002,"_5":21804,"_18607":35458,"_8577":35459,"_1666":35460},[],"/docs/manual/servicios-core/est#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3684":1012,"_21620":1002,"_5":21804,"_18607":35462,"_8577":35463,"_1666":35464},[],"/docs/manual/servicios-core/est#configuración-de-serverkeygen","Configuración de ServerKeyGen",{"_3684":1013,"_21620":1002,"_5":21804,"_18607":35466,"_8577":35467,"_1666":35468},[],"/docs/manual/servicios-core/est#verificar-la-configuración","Verificar la configuración",{"_3684":1014,"_21620":1002,"_5":21804,"_18607":35470,"_8577":35471,"_1666":35472},[],"/docs/manual/servicios-core/est#integración-de-dispositivos","Integración de dispositivos",{"_3684":1015,"_21620":1002,"_5":21804,"_18607":35474,"_8577":35475,"_1666":32347},[],"/docs/manual/servicios-core/est#antes-de-empezar",{"_3684":1016,"_21620":1002,"_5":21804,"_18607":35477,"_8577":35478,"_1666":35479},[],"/docs/manual/servicios-core/est#resumen-del-flujo","Resumen del flujo",{"_3684":1017,"_21620":1002,"_5":21804,"_18607":35481,"_8577":35482,"_1666":35483},[],"/docs/manual/servicios-core/est#modelo-de-autenticación-del-cliente","Modelo de autenticación del cliente",{"_3684":1018,"_21620":1002,"_5":21804,"_18607":35485,"_8577":35486,"_1666":35487},[],"/docs/manual/servicios-core/est#referencia-de-endpoints","Referencia de endpoints",{"_3684":1019,"_21620":1002,"_5":21804,"_18607":35489,"_8577":35490,"_1666":35491},[],"/docs/manual/servicios-core/est#cacerts","`/cacerts`",{"_3684":1020,"_21620":1002,"_5":21804,"_18607":35493,"_8577":35494,"_1666":35495},[],"/docs/manual/servicios-core/est#simpleenroll","`/simpleenroll`",{"_3684":1021,"_21620":1002,"_5":21804,"_18607":35497,"_8577":35498,"_1666":35499},[],"/docs/manual/servicios-core/est#simplereenroll","`/simplereenroll`",{"_3684":1022,"_21620":1002,"_5":21804,"_18607":35501,"_8577":35502,"_1666":35503},[],"/docs/manual/servicios-core/est#serverkeygen","`/serverkeygen`",{"_3684":1023,"_21620":1002,"_5":21804,"_18607":35505,"_8577":35506,"_1666":35507},[],"/docs/manual/servicios-core/est#flujos-completos","Flujos completos",{"_3684":1024,"_21620":1002,"_5":21804,"_18607":35509,"_8577":35510,"_1666":35511},[],"/docs/manual/servicios-core/est#ejemplo-end-to-end-enroll","Ejemplo end-to-end: enroll",{"_3684":1025,"_21620":1002,"_5":21804,"_18607":35513,"_8577":35514,"_1666":35515},[],"/docs/manual/servicios-core/est#ejemplo-end-to-end-reenroll","Ejemplo end-to-end: reenroll",{"_3684":1026,"_21620":1002,"_5":21804,"_18607":35517,"_8577":35518,"_1666":35519},[],"/docs/manual/servicios-core/est#próximos-pasos-tras-el-enrolamiento","Próximos pasos tras el enrolamiento",{"_3684":1027,"_21620":1002,"_5":21804,"_18607":35521,"_8577":35522,"_1666":35523},[],"/docs/manual/servicios-core/est#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3684":1028,"_21620":1002,"_5":21804,"_18607":35525,"_8577":35526,"_1666":35527},[],"/docs/manual/servicios-core/est#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3684":1029,"_21620":1002,"_5":21804,"_18607":35529,"_8577":35530,"_1666":35531},[],"/docs/manual/servicios-core/est#notas-de-compatibilidad","Notas de compatibilidad",{"_3684":1030,"_21620":1002,"_18607":35533,"_5":21799,"_8577":35433,"_1666":35534},[],"Lamassu IoT implementa el protocolo &#x2A;*EST (Enrollment over Secure Transport)** descrito en el RFC 7030 como su único mecanismo de inscripción de certificados para dispositivos. Cada DMS expone los endpoints EST, valida al dispositivo y aplica sus propias políticas de autenticación, registro y renovación — actuando como autoridad de registro (RA) frente al cliente.",{"_3684":1031,"_21620":1002,"_18607":35536,"_5":21799,"_8577":35433,"_1666":35537},[],"La entidad que emite y firma criptográficamente el certificado es siempre la **CA asociada al DMS**, no el DMS. El DMS coordina el proceso: recibe el CSR, autentica al dispositivo y aplica la política de emisión. Esta distinción es relevante para el administrador PKI al seleccionar la `EnrollmentCA` y para el integrador al interpretar la cadena de confianza recibida de `/cacerts`.",{"_3684":1032,"_21620":1002,"_18607":35539,"_5":21799,"_8577":35433,"_1666":35540},[],"Esta guía está dividida en dos partes:",{"_3684":1033,"_21620":1002,"_18607":35542,"_5":21799,"_8577":35433,"_1666":35543},[],"Configuración del DMS, para el administrador PKI.",{"_3684":1034,"_21620":1002,"_18607":35545,"_5":21799,"_8577":35433,"_1666":35546},[],"Integración de dispositivos, para quien consume los endpoints EST desde firmware, scripts o servicios de aprovisionamiento.",{"_3684":1035,"_21620":1002,"_18607":35548,"_5":21799,"_8577":35433,"_1666":35549},[],"Si solo necesita una orientación rápida, este es el recorrido recomendado:",{"_3684":1036,"_21620":1002,"_18607":35551,"_5":21799,"_8577":35433,"_1666":35552},[],"Perfil",{"_3684":1037,"_21620":1002,"_18607":35554,"_5":21799,"_8577":35433,"_1666":35555},[],"Leer primero",{"_3684":1038,"_21620":1002,"_18607":35557,"_5":21799,"_8577":35433,"_1666":35558},[],"Después",{"_3684":1039,"_21620":1002,"_18607":35560,"_5":21799,"_8577":35433,"_1666":35561},[],"Administrador PKI",{"_3684":1040,"_21620":1002,"_18607":35563,"_5":21799,"_8577":35433,"_1666":34149},[],{"_3684":1041,"_21620":1002,"_18607":35565,"_5":21799,"_8577":35433,"_1666":35523},[],{"_3684":1042,"_21620":1002,"_18607":35567,"_5":21799,"_8577":35433,"_1666":35568},[],"Integrador de dispositivos",{"_3684":1043,"_21620":1002,"_18607":35570,"_5":21799,"_8577":35433,"_1666":32347},[],{"_3684":1044,"_21620":1002,"_18607":35572,"_5":21799,"_8577":35433,"_1666":35573},[],"Los endpoints `/cacerts`, `/simpleenroll`, `/simplereenroll` o `/serverkeygen`, según el flujo",{"_3684":1045,"_21620":1002,"_18607":35575,"_5":21799,"_8577":35440,"_1666":35576},[],"Antes de configurar un DMS para EST, deben existir los siguientes recursos en la plataforma:",{"_3684":1046,"_21620":1002,"_18607":35578,"_5":21799,"_8577":35440,"_1666":35579},[],"**Una CA disponible**: la CA que actuará como `EnrollmentCA` debe estar creada y en estado activo en Lamassu. Si el modo de autenticación es `CLIENT_CERTIFICATE`, también deben estar creadas las CAs de validación del certificado bootstrap.",{"_3684":1047,"_21620":1002,"_18607":35581,"_5":21799,"_8577":35440,"_1666":35582},[],"**Un DMS creado**: el DMS al que se aplicará esta configuración debe existir previamente. La configuración EST se aplica sobre un DMS existente, no lo crea.",{"_3684":1048,"_21620":1002,"_18607":35584,"_5":21799,"_8577":35440,"_1666":35585},[],"Conviene separar cuatro bloques de configuración:",{"_3684":1049,"_21620":1002,"_18607":35587,"_5":21799,"_8577":35440,"_1666":35588},[],"Cómo se realizará el enrollment inicial, incluyendo el modo de alta y la autenticación del cliente.",{"_3684":1050,"_21620":1002,"_18607":35590,"_5":21799,"_8577":35440,"_1666":35591},[],"Cómo se gestionará el re-enrollment de certificados ya emitidos.",{"_3684":1051,"_21620":1002,"_18607":35593,"_5":21799,"_8577":35440,"_1666":35594},[],"Cómo se configurará el endpoint cacerts para la distribución de las CAs de confianza utilizadas por los dispositivos.",{"_3684":1052,"_21620":1002,"_18607":35596,"_5":21799,"_8577":35440,"_1666":35597},[],"Si se habilitará la generación de claves en servidor mediante `ServerKeyGen`.",{"_3684":1053,"_21620":1002,"_18607":35599,"_5":21799,"_8577":35447,"_1666":35600},[],"En esta sección se define cómo se registran los dispositivos nuevos y con qué credenciales se autentican.",{"_3684":1054,"_21620":1002,"_18607":35602,"_5":21799,"_8577":35447,"_1666":35603},[],"**Registration Mode**: determina el comportamiento al recibir una inscripción inicial. En modo `JITP` (*Just-In-Time Provisioning*), el dispositivo se crea automáticamente la primera vez que se presenta, aplicando los tags, metadatos e icono definidos en el perfil de aprovisionamiento. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente en la plataforma; si no existe, la solicitud se rechaza con `device not preregistered`. El modo JITP es adecuado para flotas grandes donde el inventario se construye durante el despliegue; el modo `PRE_REGISTRATION` encaja en entornos de alta seguridad donde cada dispositivo se aprueba de forma explícita antes de recibir un certificado.",{"_3684":1055,"_21620":1002,"_18607":35605,"_5":21799,"_8577":35447,"_1666":35606},[],"**Tags**: se aplican a cada dispositivo creado automáticamente por este DMS. Son opcionales y solo tienen efecto en modo JITP. Los tags permiten mejorar la búsqueda de dispositivos.",{"_3684":1056,"_21620":1002,"_18607":35608,"_5":21799,"_8577":35447,"_1666":35609},[],"**Icon**: se aplica a cada dispositivo creado automáticamente por este DMS. Es opcional y solo tiene efecto en modo JITP. Únicamente visual.",{"_3684":1057,"_21620":1002,"_18607":35611,"_5":21799,"_8577":35451,"_1666":35612},[],"**Enrollment CA**: identifica la CA que firmará los certificados de identidad emitidos a través de este DMS. Su elección determina la cadena de confianza que el dispositivo recibirá y la raíz contra la que los sistemas de backend validarán los certificados de flota.",{"_3684":1058,"_21620":1002,"_18607":35614,"_5":21799,"_8577":35451,"_1666":35615},[],"**Allow Override Enrollment** (`enable_replaceable_enrollment`): permite que un dispositivo ya enrolado vuelva a inscribirse mediante `/simpleenroll`. Cuando está activa, el certificado anterior se revoca con la razón `superseded` y el slot de identidad se actualiza. Cuando está inactiva, un segundo intento de `simpleenroll` se rechaza con `forbiddenNewEnrollment`. Esta opción debe habilitarse con precaución en entornos de producción, ya que permite sustituir la identidad de un dispositivo sin pasar por el flujo de re-enrollment.",{"_3684":1059,"_21620":1002,"_18607":35617,"_5":21799,"_8577":35451,"_1666":35618},[],"**Verify CSR Signature** (`verify_csr_signature`): controla si el servidor valida la firma del CSR contra la clave pública declarada en él (prueba de posesión PKCS#10). Cuando está inactiva, un solicitante podría enviar un CSR con una clave pública que no controla y obtener un certificado vinculado a ella. Para flotas IoT en redes abiertas debe estar activa.",{"_3684":1060,"_21620":1002,"_18607":35620,"_5":21799,"_8577":35451,"_1666":35621},[],"**Authentication Mode**: define cómo el DMS valida la identidad del dispositivo durante el enrollment. Los cuatro modos disponibles son:",{"_3684":1061,"_21620":1002,"_18607":35623,"_5":21799,"_8577":35451,"_1666":35624},[],"Modo",{"_3684":1062,"_21620":1002,"_18607":35626,"_5":21799,"_8577":35451,"_1666":32646},[],{"_3684":1063,"_21620":1002,"_18607":35628,"_5":21799,"_8577":35451,"_1666":35629},[],"`CLIENT_CERTIFICATE`",{"_3684":1064,"_21620":1002,"_18607":35631,"_5":21799,"_8577":35451,"_1666":35632},[],"mTLS. El dispositivo presenta un certificado X.509 emitido por alguna de las CAs declaradas en **Validation CAs**.",{"_3684":1065,"_21620":1002,"_18607":35634,"_5":21799,"_8577":35451,"_1666":35635},[],"`EXTERNAL_WEBHOOK`",{"_3684":1066,"_21620":1002,"_18607":35637,"_5":21799,"_8577":35451,"_1666":35638},[],"La decisión de autorización se delega en un servicio HTTP externo. Solo aplica en `/simpleenroll`; en `/simplereenroll` este modo degrada silenciosamente a `NO_AUTH`.",{"_3684":1067,"_21620":1002,"_18607":35640,"_5":21799,"_8577":35451,"_1666":35641},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3684":1068,"_21620":1002,"_18607":35643,"_5":21799,"_8577":35451,"_1666":35644},[],"Combina los dos anteriores: se exige un certificado cliente válido **y** la confirmación del webhook externo.",{"_3684":1069,"_21620":1002,"_18607":35646,"_5":21799,"_8577":35451,"_1666":35647},[],"`NO_AUTH`",{"_3684":1070,"_21620":1002,"_18607":35649,"_5":21799,"_8577":35451,"_1666":35650},[],"Sin autenticación. Cualquier CSR se acepta. **Exclusivo para entornos de laboratorio o redes de aprovisionamiento aisladas**; no debe usarse en producción.",{"_3684":1071,"_21620":1002,"_18607":35652,"_5":21799,"_8577":35451,"_1666":35653},[],"Cuando el modo es `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`, se configuran además estos parámetros:",{"_3684":1072,"_21620":1002,"_18607":35655,"_5":21799,"_8577":35451,"_1666":35656},[],"**Validation CAs**: lista de CAs de confianza para validar el certificado bootstrap presentado por el dispositivo.",{"_3684":1073,"_21620":1002,"_18607":35658,"_5":21799,"_8577":35451,"_1666":35659},[],"**Chain Validation Level**: profundidad máxima de la cadena de validación. El valor `-1` valida la cadena completa hasta la CA raíz.",{"_3684":1074,"_21620":1002,"_18607":35661,"_5":21799,"_8577":35451,"_1666":35662},[],"**Allow Authenticating Expired Certificates**: si está activo, acepta certificados cliente caducados. Es útil en escenarios de recuperación donde el dispositivo no pudo renovar su certificado a tiempo.",{"_3684":1075,"_21620":1002,"_18607":35664,"_5":21799,"_8577":35451,"_1666":35665},[],"Cuando el modo incluye `EXTERNAL_WEBHOOK`, se configuran además estos parámetros:",{"_3684":1076,"_21620":1002,"_18607":35667,"_5":21799,"_8577":35451,"_1666":35668},[],"**Webhook URL**: dirección del servicio externo que decidirá la autorización.",{"_3684":1077,"_21620":1002,"_18607":35670,"_5":21799,"_8577":35451,"_1666":35671},[],"**HTTP Method**: método HTTP utilizado para invocar el webhook. Admite `POST` (por defecto) o `PUT`; ambos son equivalentes para el webhook, solo cambia el verbo con el que Lamassu realiza la llamada.",{"_3684":1078,"_21620":1002,"_18607":35673,"_5":21799,"_8577":35451,"_1666":35674},[],"**Timeout**: tiempo máximo de espera de la llamada al webhook. Si no se especifica, el valor por defecto es de **10 segundos**; superado ese plazo sin respuesta, Lamassu deniega la operación.",{"_3684":1079,"_21620":1002,"_18607":35676,"_5":21799,"_8577":35451,"_1666":35677},[],"**Webhook Authentication Mode**: modo de autenticación del webhook hacia el servicio externo, por ejemplo `ApiKey`, `OIDC` o `mTLS`.",{"_3684":1080,"_21620":1002,"_18607":35679,"_5":21799,"_8577":35451,"_1666":35680},[],"El contrato exacto que debe implementar el servicio webhook (esquema de petición y respuesta, ejemplos) está publicado como especificación OpenAPI: referencia del webhook de autorización.",{"_3684":1081,"_21620":1002,"_18607":35682,"_5":21799,"_8577":35455,"_1666":35683},[],"El comportamiento del certificado emitido no lo determina únicamente el CSR del dispositivo, sino el **perfil de emisión** (`IssuanceProfile`) asociado al DMS. El integrador no configura este perfil, pero sus reglas afectan al contenido del certificado final:",{"_3684":1082,"_21620":1002,"_18607":35685,"_5":21799,"_8577":35455,"_1666":35686},[],"Campo",{"_3684":1083,"_21620":1002,"_18607":35688,"_5":21799,"_8577":35455,"_1666":34301},[],{"_3684":1084,"_21620":1002,"_18607":35690,"_5":21799,"_8577":35455,"_1666":35691},[],"Efecto sobre el certificado emitido",{"_3684":1085,"_21620":1002,"_18607":35693,"_5":21799,"_8577":35455,"_1666":35694},[],"`HonorSubject`",{"_3684":1086,"_21620":1002,"_18607":35696,"_5":21799,"_8577":35455,"_1666":20842},[],{"_3684":1087,"_21620":1002,"_18607":35698,"_5":21799,"_8577":35455,"_1666":35699},[],"Si `true`, el subject del CSR se traslada literalmente al certificado. Si `false`, la CA aplica la plantilla del perfil e ignora el subject del CSR.",{"_3684":1088,"_21620":1002,"_18607":35701,"_5":21799,"_8577":35455,"_1666":35702},[],"`HonorKeyUsage`",{"_3684":1089,"_21620":1002,"_18607":35704,"_5":21799,"_8577":35455,"_1666":20842},[],{"_3684":1090,"_21620":1002,"_18607":35706,"_5":21799,"_8577":35455,"_1666":35707},[],"Si `true`, el `KeyUsage` del CSR se respeta. Si `false`, se aplica la plantilla del perfil.",{"_3684":1091,"_21620":1002,"_18607":35709,"_5":21799,"_8577":35455,"_1666":35710},[],"`HonorExtendedKeyUsages`",{"_3684":1092,"_21620":1002,"_18607":35712,"_5":21799,"_8577":35455,"_1666":20842},[],{"_3684":1093,"_21620":1002,"_18607":35714,"_5":21799,"_8577":35455,"_1666":35715},[],"Igual que `HonorKeyUsage`, pero para `ExtKeyUsage`.",{"_3684":1094,"_21620":1002,"_18607":35717,"_5":21799,"_8577":35455,"_1666":35718},[],"`HonorExtensions`",{"_3684":1095,"_21620":1002,"_18607":35720,"_5":21799,"_8577":35455,"_1666":20842},[],{"_3684":1096,"_21620":1002,"_18607":35722,"_5":21799,"_8577":35455,"_1666":35723},[],"Controla si el resto de extensiones del CSR (SAN, CDP, etc.) se incluyen en el certificado.",{"_3684":1097,"_21620":1002,"_18607":35725,"_5":21799,"_8577":35455,"_1666":35726},[],"Esto es relevante para el integrador: el `KeyUsage`, `ExtKeyUsage` y los SAN que declara el CSR pueden no aparecer tal cual en el certificado final si el perfil así lo decide. Consulte con el administrador PKI si el certificado emitido no contiene las extensiones esperadas.",{"_3684":1098,"_21620":1002,"_18607":35728,"_5":21799,"_8577":35459,"_1666":35729},[],"La sección **Re-Enrollment Settings** controla el proceso de renovación de certificados. El re-enrollment puede realizarse únicamente cuando el certificado está dentro de la ventana configurada, y opcionalmente también cuando el certificado ya ha caducado.",{"_3684":1099,"_21620":1002,"_18607":35731,"_5":21799,"_8577":35459,"_1666":35732},[],"**Revoke On Re-Enroll**: si está activo, el certificado anterior se revoca automáticamente con la razón `superseded` una vez emitido el nuevo.",{"_3684":1100,"_21620":1002,"_18607":35734,"_5":21799,"_8577":35459,"_1666":35735},[],"**Allow Expired Renewal**: permite renovar un certificado ya caducado. Es útil cuando un dispositivo ha estado desconectado y no pudo renovar dentro de la ventana.",{"_3684":1101,"_21620":1002,"_18607":35737,"_5":21799,"_8577":35459,"_1666":35738},[],"**Allowed Renewal Delta**: ventana de tiempo previa a la caducidad durante la cual se permite el re-enrollment. Antes de que se abra esta ventana, la solicitud se rechaza con `invalid reenroll window`.",{"_3684":1102,"_21620":1002,"_18607":35740,"_5":21799,"_8577":35459,"_1666":35741},[],"**Preventive Renewal Delta**: tiempo previo a la caducidad a partir del cual se emiten alertas de renovación preventiva.",{"_3684":1103,"_21620":1002,"_18607":35743,"_5":21799,"_8577":35459,"_1666":35744},[],"**Critical Renewal Delta**: umbral más cercano al vencimiento que activa alertas de estado crítico.",{"_3684":1104,"_21620":1002,"_18607":35746,"_5":21799,"_8577":35459,"_1666":35747},[],"**Additional Validation CAs**: CAs adicionales aceptadas como emisoras del certificado en vigor durante el re-enrollment. Permite migrar a una nueva CA de enrolamiento sin interrumpir la renovación de dispositivos ya enrolados con la CA anterior.",{"_3684":1105,"_21620":1002,"_18607":35749,"_5":21799,"_8577":35463,"_1666":35750},[],"La sección **Server Key Generation** permite que Lamassu genere el par de claves del dispositivo en el servidor y lo devuelva junto con el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada.",{"_3684":1106,"_21620":1002,"_18607":35752,"_5":21799,"_8577":35463,"_1666":35753},[],"La opción **Enable Server-Side Key Generation** activa el endpoint `/serverkeygen`. Cuando está inactiva, cualquier llamada a ese endpoint se rechaza con `server key generation not enabled`.",{"_3684":1107,"_21620":1002,"_18607":35755,"_5":21799,"_8577":35463,"_1666":35756},[],"**Key Type** selecciona el algoritmo: `RSA` o `ECDSA`. El campo &#x2A;*Key Size (bits)** determina el tamaño de la clave. Para ECDSA, el tamaño en bits determina también la curva: 256 corresponde a P-256, 384 a P-384 y 521 a P-521.",{"_3684":1108,"_21620":1002,"_18607":35758,"_5":21799,"_8577":35463,"_1666":35759},[],"La clave se genera en el motor software del servidor, no en un Crypto Engine de hardware como AWS KMS o PKCS#11. La única protección de la clave en tránsito es el canal TLS; no se aplica cifrado adicional (CMS EnvelopedData) sobre la clave antes de enviarla al dispositivo. Consulte el apartado `/serverkeygen` de la referencia para integrador para conocer el formato exacto de la respuesta y las consideraciones de seguridad.",{"_3684":1109,"_21620":1002,"_18607":35761,"_5":21799,"_8577":35467,"_1666":35762},[],"Una vez aplicados los ajustes de enrollment, re-enrollment y ServerKeyGen, puede confirmar que el DMS está operativo de las siguientes formas:",{"_3684":1110,"_21620":1002,"_18607":35764,"_5":21799,"_8577":35467,"_1666":35765},[],"**Desde la consola**: accede al detalle del DMS y comprueba que la sección EST muestra la CA de enrolamiento asignada y el modo de autenticación configurado.",{"_3684":1111,"_21620":1002,"_18607":35767,"_5":21799,"_8577":35467,"_1666":35768},[],"**Con una solicitud de prueba**: invoca el endpoint `/cacerts` del DMS desde un cliente `curl` con la confianza del servidor. Una respuesta `200 OK` con contenido base64 confirma que el DMS está activo y que la CA de enrolamiento es accesible.",{"_3684":1112,"_21620":1002,"_18607":35770,"_5":21799,"_8577":35467,"_1666":35771},[],"Si el DMS no existe o la CA no está disponible, el servidor responde con `DMS not found` u otro mensaje de error. Consulte la sección Diagnóstico y compatibilidad para interpretar los mensajes de error.",{"_3684":1113,"_21620":1002,"_18607":35773,"_5":21799,"_8577":35471,"_1666":35774},[],"*Esta sección está dirigida al integrador de dispositivos.*",{"_3684":1114,"_21620":1002,"_18607":35776,"_5":21799,"_8577":35471,"_1666":35777},[],"Los endpoints EST de Lamassu se publican bajo el prefijo `/.well-known/est` y exigen siempre la presencia del segmento de ruta `{aps}`, que se interpreta como el identificador del DMS al que se dirige la operación. La asociación es directa: el valor de `{aps}` recibido en la URL se utiliza como ID de DMS al consultar el almacén interno. Las variantes registradas sin `{aps}` (por ejemplo `/.well-known/est/cacerts`) están enrutadas en el código, pero su gestor exige el campo `APS` y devuelve `400 Bad Request` con el mensaje `Field validation for 'APS' failed` cuando el segmento no se proporciona.",{"_3684":1115,"_21620":1002,"_18607":35779,"_5":21799,"_8577":35471,"_1666":35780},[],"Esta parte sigue el orden habitual de trabajo del integrador: primero los requisitos previos y el modelo de autenticación, después la referencia de cada endpoint y, al final, ejemplos completos y material de diagnóstico.",{"_3684":1116,"_21620":1002,"_18607":35782,"_5":21799,"_8577":35475,"_1666":35783},[],"El administrador PKI debe haber configurado un DMS con el protocolo `EST_RFC7030`, una CA de enrolamiento asignada y al menos un modo de autenticación. Sin esa configuración previa, Lamassu rechaza cualquier solicitud de enrolamiento. Los detalles de esa configuración se encuentran en la sección de configuración del DMS de esta misma página.",{"_3684":1117,"_21620":1002,"_18607":35785,"_5":21799,"_8577":35475,"_1666":35786},[],"Antes de realizar la primera llamada, asegúrese de tener:",{"_3684":1118,"_21620":1002,"_18607":35788,"_5":21799,"_8577":35475,"_1666":35789},[],"Elemento",{"_3684":1119,"_21620":1002,"_18607":35791,"_5":21799,"_8577":35475,"_1666":32646},[],{"_3684":1120,"_21620":1002,"_18607":35793,"_5":21799,"_8577":35475,"_1666":35794},[],"**URL del host EST**",{"_3684":1121,"_21620":1002,"_18607":35796,"_5":21799,"_8577":35475,"_1666":35797},[],"Dirección base del servidor, por ejemplo `https://est.lamassu.example`. La proporciona el administrador PKI.",{"_3684":1122,"_21620":1002,"_18607":35799,"_5":21799,"_8577":35475,"_1666":35800},[],"**Ancla de confianza del servidor** (`lamassu-trust.pem`)",{"_3684":1123,"_21620":1002,"_18607":35802,"_5":21799,"_8577":35475,"_1666":35803},[],"Certificado raíz o intermedio con el que validar el TLS del servidor Lamassu. Sin él, el cliente rechazará el certificado del servidor.",{"_3684":1124,"_21620":1002,"_18607":35805,"_5":21799,"_8577":35475,"_1666":35806},[],"**Certificado bootstrap + clave privada**",{"_3684":1125,"_21620":1002,"_18607":35808,"_5":21799,"_8577":35475,"_1666":35809},[],"Solo para modos `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`. Es el certificado de aprovisionamiento emitido por alguna de las `ValidationCAs` del DMS, normalmente una CA dedicada al provisioning y distinta de la CA de enrolamiento.",{"_3684":1126,"_21620":1002,"_18607":35811,"_5":21799,"_8577":35475,"_1666":35812},[],"**ID del DMS** (`{aps}`)",{"_3684":1127,"_21620":1002,"_18607":35814,"_5":21799,"_8577":35475,"_1666":35815},[],"Identificador del DMS que aparece en todas las rutas EST. Lo proporciona el administrador PKI.",{"_3684":1128,"_21620":1002,"_18607":35817,"_5":21799,"_8577":35478,"_1666":35818},[],"Caso",{"_3684":1129,"_21620":1002,"_18607":35820,"_5":21799,"_8577":35478,"_1666":35821},[],"Credencial habitual",{"_3684":1130,"_21620":1002,"_18607":35823,"_5":21799,"_8577":35478,"_1666":35824},[],"Endpoint principal",{"_3684":1131,"_21620":1002,"_18607":35826,"_5":21799,"_8577":35478,"_1666":34967},[],{"_3684":1132,"_21620":1002,"_18607":35828,"_5":21799,"_8577":35478,"_1666":35829},[],"Alta inicial",{"_3684":1133,"_21620":1002,"_18607":35831,"_5":21799,"_8577":35478,"_1666":35832},[],"Certificado bootstrap o el modo definido en `AuthMode`",{"_3684":1134,"_21620":1002,"_18607":35834,"_5":21799,"_8577":35478,"_1666":35495},[],{"_3684":1135,"_21620":1002,"_18607":35836,"_5":21799,"_8577":35478,"_1666":35837},[],"Certificado de dispositivo",{"_3684":1136,"_21620":1002,"_18607":35839,"_5":21799,"_8577":35478,"_1666":35840},[],"Renovación",{"_3684":1137,"_21620":1002,"_18607":35842,"_5":21799,"_8577":35478,"_1666":35843},[],"Certificado actual del dispositivo",{"_3684":1138,"_21620":1002,"_18607":35845,"_5":21799,"_8577":35478,"_1666":35499},[],{"_3684":1139,"_21620":1002,"_18607":35847,"_5":21799,"_8577":35478,"_1666":35848},[],"Certificado renovado",{"_3684":1140,"_21620":1002,"_18607":35850,"_5":21799,"_8577":35478,"_1666":35851},[],"Descarga de confianza",{"_3684":1141,"_21620":1002,"_18607":35853,"_5":21799,"_8577":35478,"_1666":35854},[],"TLS del servidor",{"_3684":1142,"_21620":1002,"_18607":35856,"_5":21799,"_8577":35478,"_1666":35491},[],{"_3684":1143,"_21620":1002,"_18607":35858,"_5":21799,"_8577":35478,"_1666":35859},[],"PKCS#7 o PEM con certificados",{"_3684":1144,"_21620":1002,"_18607":35861,"_5":21799,"_8577":35478,"_1666":35862},[],"Clave generada en servidor",{"_3684":1145,"_21620":1002,"_18607":35864,"_5":21799,"_8577":35478,"_1666":35865},[],"Igual que `/simpleenroll`",{"_3684":1146,"_21620":1002,"_18607":35867,"_5":21799,"_8577":35478,"_1666":35503},[],{"_3684":1147,"_21620":1002,"_18607":35869,"_5":21799,"_8577":35478,"_1666":35870},[],"Clave privada PKCS#8 + certificado",{"_3684":1148,"_21620":1002,"_18607":35872,"_5":21799,"_8577":35482,"_1666":35873},[],"La implementación de Lamassu reconoce cuatro configuraciones de autenticación para `/simpleenroll`, expresadas mediante el campo `EnrollmentOptionsESTRFC7030.AuthMode` del DMS. Tres son modos simples (`CLIENT_CERTIFICATE`, `EXTERNAL_WEBHOOK`, `NO_AUTH`) y una combina dos controles (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`). El cliente debe presentarse en el modo que el DMS espera; cualquier otra combinación genera un fallo en la inscripción.",{"_3684":1149,"_21620":1002,"_18607":35875,"_5":21799,"_8577":35482,"_1666":35876},[],"Modo (`AuthMode`)",{"_3684":1150,"_21620":1002,"_18607":35878,"_5":21799,"_8577":35482,"_1666":32646},[],{"_3684":1151,"_21620":1002,"_18607":35880,"_5":21799,"_8577":35482,"_1666":35881},[],"Credencial esperada",{"_3684":1152,"_21620":1002,"_18607":35883,"_5":21799,"_8577":35482,"_1666":35884},[],"Aplica en enroll",{"_3684":1153,"_21620":1002,"_18607":35886,"_5":21799,"_8577":35482,"_1666":35887},[],"Aplica en reenroll",{"_3684":1154,"_21620":1002,"_18607":35889,"_5":21799,"_8577":35482,"_1666":35629},[],{"_3684":1155,"_21620":1002,"_18607":35891,"_5":21799,"_8577":35482,"_1666":35892},[],"mTLS con certificado X.509",{"_3684":1156,"_21620":1002,"_18607":35894,"_5":21799,"_8577":35482,"_1666":35895},[],"Certificado y clave privada cliente",{"_3684":1157,"_21620":1002,"_18607":35897,"_5":21799,"_8577":35482,"_1666":34314},[],{"_3684":1158,"_21620":1002,"_18607":35899,"_5":21799,"_8577":35482,"_1666":35900},[],"Sí (con el certificado en vigor)",{"_3684":1159,"_21620":1002,"_18607":35902,"_5":21799,"_8577":35482,"_1666":35641},[],{"_3684":1160,"_21620":1002,"_18607":35904,"_5":21799,"_8577":35482,"_1666":35905},[],"mTLS más validación por webhook",{"_3684":1161,"_21620":1002,"_18607":35907,"_5":21799,"_8577":35482,"_1666":35908},[],"Certificado y clave privada cliente, más aprobación del webhook",{"_3684":1162,"_21620":1002,"_18607":35910,"_5":21799,"_8577":35482,"_1666":34314},[],{"_3684":1163,"_21620":1002,"_18607":35912,"_5":21799,"_8577":35482,"_1666":35913},[],"No como combinación; en reenroll no mantiene ambos controles",{"_3684":1164,"_21620":1002,"_18607":35915,"_5":21799,"_8577":35482,"_1666":35635},[],{"_3684":1165,"_21620":1002,"_18607":35917,"_5":21799,"_8577":35482,"_1666":35918},[],"Webhook externo de autorización",{"_3684":1166,"_21620":1002,"_18607":35920,"_5":21799,"_8577":35482,"_1666":35921},[],"Ninguna en el canal TLS",{"_3684":1167,"_21620":1002,"_18607":35923,"_5":21799,"_8577":35482,"_1666":34314},[],{"_3684":1168,"_21620":1002,"_18607":35925,"_5":21799,"_8577":35482,"_1666":35926},[],"No, degrada a `NO_AUTH`",{"_3684":1169,"_21620":1002,"_18607":35928,"_5":21799,"_8577":35482,"_1666":35647},[],{"_3684":1170,"_21620":1002,"_18607":35930,"_5":21799,"_8577":35482,"_1666":35931},[],"Sin autenticación",{"_3684":1171,"_21620":1002,"_18607":35933,"_5":21799,"_8577":35482,"_1666":35934},[],"Ninguna",{"_3684":1172,"_21620":1002,"_18607":35936,"_5":21799,"_8577":35482,"_1666":35937},[],"Sí (uso restringido)",{"_3684":1173,"_21620":1002,"_18607":35939,"_5":21799,"_8577":35482,"_1666":35937},[],{"_3684":1174,"_21620":1002,"_18607":35941,"_5":21799,"_8577":35482,"_1666":35942},[],"JWT **no es un modo de autenticación válido en EST**. El extractor de identidad JWT existe en el código pero solo se evalúa en la API de administración de Lamassu. Cualquier *Bearer token* enviado a `/.well-known/est/...` se ignora silenciosamente. Cuando el DMS está configurado con `AuthMode: CLIENT_CERTIFICATE`, una petición que solo aporte JWT se rechaza por falta de certificado cliente. Cuando el DMS está en `AuthMode: NO_AUTH`, la petición se procesa como tal y el JWT no añade ni resta autorización.",{"_3684":1175,"_21620":1002,"_18607":35944,"_5":21799,"_8577":35482,"_1666":35945},[],"**`CLIENT_CERTIFICATE`**: el cliente presenta un certificado X.509 emitido por una de las CAs declaradas en `AuthOptionsMTLS.ValidationCAs`. El proceso valida la cadena del certificado contra esas CAs mediante los parámetros `ValidationCAs`, `AllowExpired` y `ChainLevelValidation`. Además, el servicio comprueba el estado de revocación en tres pasos: primero busca el cert en la base de datos local de Lamassu; si no lo encuentra, consulta los responders OCSP listados en la extensión AIA; si OCSP falla, intenta los CRL Distribution Points (CDP). Un certificado revocado interrumpe la inscripción con `certificate is revoked`.",{"_3684":1176,"_21620":1002,"_18607":35947,"_5":21799,"_8577":35482,"_1666":34298},[],{"_3684":1177,"_21620":1002,"_18607":35949,"_5":21799,"_8577":35482,"_1666":34301},[],{"_3684":1178,"_21620":1002,"_18607":35951,"_5":21799,"_8577":35482,"_1666":32646},[],{"_3684":1179,"_21620":1002,"_18607":35953,"_5":21799,"_8577":35482,"_1666":35954},[],"`ValidationCAs`",{"_3684":1180,"_21620":1002,"_18607":35956,"_5":21799,"_8577":35482,"_1666":35957},[],"lista de IDs de CA",{"_3684":1181,"_21620":1002,"_18607":35959,"_5":21799,"_8577":35482,"_1666":35960},[],"CAs de confianza para validar el certificado bootstrap (en enroll) o el certificado en vigor (en reenroll).",{"_3684":1182,"_21620":1002,"_18607":35962,"_5":21799,"_8577":35482,"_1666":35963},[],"`AllowExpired`",{"_3684":1183,"_21620":1002,"_18607":35965,"_5":21799,"_8577":35482,"_1666":20842},[],{"_3684":1184,"_21620":1002,"_18607":35967,"_5":21799,"_8577":35482,"_1666":35968},[],"Si está activado, acepta certificados cliente caducados. Si es `false`, los certificados expirados se rechazan.",{"_3684":1185,"_21620":1002,"_18607":35970,"_5":21799,"_8577":35482,"_1666":35971},[],"`ChainLevelValidation`",{"_3684":1186,"_21620":1002,"_18607":35973,"_5":21799,"_8577":35482,"_1666":6815},[],{"_3684":1187,"_21620":1002,"_18607":35975,"_5":21799,"_8577":35482,"_1666":35976},[],"Si es mayor que cero, recorta la cadena de validación al número de niveles indicado.",{"_3684":1188,"_21620":1002,"_18607":35978,"_5":21799,"_8577":35482,"_1666":35979},[],"**`EXTERNAL_WEBHOOK`**: Lamassu delega la decisión de autorización en un servicio HTTP externo. El servidor EST construye una petición `POST` al webhook configurado con un cuerpo JSON que reproduce el contexto de la inscripción.",{"_3684":1189,"_21620":1002,"_18607":35981,"_5":21799,"_8577":35482,"_1666":35982},[],"El valor del campo `csr` es la **codificación base64 del PEM** del CSR (no el DER, y no el PEM en claro). El webhook debe responder con `2xx` y un cuerpo JSON `{\"authorized\": true}` para continuar; cualquier otra respuesta aborta el enrolamiento con `external webhook denied enrollment`. Un `204 No Content` **no es una respuesta válida** aunque sea un código `2xx`: Lamassu exige un cuerpo JSON con el campo `authorized`, así que un webhook que responda sin cuerpo deniega la operación igual que un error.",{"_3684":1190,"_21620":1002,"_18607":35984,"_5":21799,"_8577":35482,"_1666":35985},[],"**`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`**: combina los dos modos anteriores durante `/simpleenroll` — el cliente debe presentar un certificado mTLS válido y el webhook debe devolver `authorized: true`. En `/simplereenroll` la combinación no se conserva: el chequeo conjunto mTLS + webhook no se mantiene, por lo que el integrador no debe asumir que las mismas garantías del enrollment inicial aplican en reenroll.",{"_3684":1191,"_21620":1002,"_18607":35987,"_5":21799,"_8577":35482,"_1666":35988},[],"**`NO_AUTH`**: el DMS acepta cualquier CSR sin validar identidad del cliente. Lamassu emite un aviso en su log (`DMS is configured with NoAuth, allowing enrollment`) y procede al alta. Debe restringirse a entornos controlados (una red de aprovisionamiento aislada); cualquier red expuesta a internet con un DMS en `NO_AUTH` queda abierta a la emisión de certificados por terceros no autorizados.",{"_3684":1192,"_21620":1002,"_18607":35990,"_5":21799,"_8577":35486,"_1666":35991},[],"Las siguientes secciones describen los endpoints en el orden más habitual de uso dentro del ciclo de vida del dispositivo:",{"_3684":1193,"_21620":1002,"_18607":35993,"_5":21799,"_8577":35486,"_1666":35994},[],"`/cacerts`: descarga de la cadena de confianza.",{"_3684":1194,"_21620":1002,"_18607":35996,"_5":21799,"_8577":35486,"_1666":35997},[],"`/simpleenroll`: inscripción inicial del certificado.",{"_3684":1195,"_21620":1002,"_18607":35999,"_5":21799,"_8577":35486,"_1666":36000},[],"`/simplereenroll`: renovación de un certificado ya emitido.",{"_3684":1196,"_21620":1002,"_18607":36002,"_5":21799,"_8577":35486,"_1666":36003},[],"`/serverkeygen`: inscripción con generación de clave en servidor.",{"_3684":1197,"_21620":1002,"_18607":36005,"_5":21799,"_8577":35490,"_1666":36006},[],"El endpoint `GET /.well-known/est/{aps}/cacerts` distribuye los certificados que el dispositivo necesita para validar al servidor EST y al resto de las CAs gestionadas por el DMS. Lamassu inserta los certificados en este orden: primero el certificado **downstream** del servidor Lamassu, que es la hoja TLS del servidor y no una CA, útil para pinning si `IncludeLamassuSystemCA` está activado; después la lista `ManagedCAs` declarada en el DMS; y por último la CA de enrolamiento, si `IncludeEnrollmentCA` está activado.",{"_3684":1198,"_21620":1002,"_18607":36008,"_5":21799,"_8577":35490,"_1666":36009},[],"Campo de `CADistributionSettings`",{"_3684":1199,"_21620":1002,"_18607":36011,"_5":21799,"_8577":35490,"_1666":34301},[],{"_3684":1200,"_21620":1002,"_18607":36013,"_5":21799,"_8577":35490,"_1666":32646},[],{"_3684":1201,"_21620":1002,"_18607":36015,"_5":21799,"_8577":35490,"_1666":36016},[],"`IncludeLamassuSystemCA`",{"_3684":1202,"_21620":1002,"_18607":36018,"_5":21799,"_8577":35490,"_1666":20842},[],{"_3684":1203,"_21620":1002,"_18607":36020,"_5":21799,"_8577":35490,"_1666":36021},[],"Incluye el certificado *downstream* del servidor Lamassu, es decir, la hoja TLS que el cliente puede usar para anclar la conexión. Es un cert de extremo, no una CA.",{"_3684":1204,"_21620":1002,"_18607":36023,"_5":21799,"_8577":35490,"_1666":36024},[],"`IncludeEnrollmentCA`",{"_3684":1205,"_21620":1002,"_18607":36026,"_5":21799,"_8577":35490,"_1666":20842},[],{"_3684":1206,"_21620":1002,"_18607":36028,"_5":21799,"_8577":35490,"_1666":36029},[],"Incluye la CA emisora del DMS, es decir, la que firmará los certificados de dispositivo.",{"_3684":1207,"_21620":1002,"_18607":36031,"_5":21799,"_8577":35490,"_1666":36032},[],"`ManagedCAs`",{"_3684":1208,"_21620":1002,"_18607":36034,"_5":21799,"_8577":35490,"_1666":35957},[],{"_3684":1209,"_21620":1002,"_18607":36036,"_5":21799,"_8577":35490,"_1666":36037},[],"CAs adicionales que se publican como anclas de confianza al dispositivo.",{"_3684":1210,"_21620":1002,"_18607":36039,"_5":21799,"_8577":35490,"_1666":36040},[],"El formato por defecto es PKCS#7 *degenerate* (sólo certificados) codificado en base64. La respuesta declara `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El base64 viene troceado en líneas de **76 caracteres** terminadas en CRLF, una anchura conforme con S/MIME (RFC 5751), no los 64 que sugieren ciertas guías de RFC 7030. Este troceo aplica únicamente a `/cacerts` y `/simpleenroll`; las partes internas de `/serverkeygen` no llevan wrap, como se explica más abajo.",{"_3684":1211,"_21620":1002,"_18607":36042,"_5":21799,"_8577":35490,"_1666":36043},[],"El PKCS#7 *degenerate* es un **conjunto** de certificados sin orden semántico definido. Aunque Lamassu los inserta en el orden indicado, el integrador no debe asumir ese orden al validar cadenas: la cadena debe construirse por correspondencia `Subject`/`Issuer` (o por AKI/SKI), no por la posición en la respuesta.",{"_3684":1212,"_21620":1002,"_18607":36045,"_5":21799,"_8577":35490,"_1666":36046},[],"El flag `-i` (ignore garbage) ayuda a tolerar el CRLF que Lamassu añade y es necesario en algunos `base64` (BusyBox, BSD); en GNU coreutils se ignora.",{"_3684":1213,"_21620":1002,"_18607":36048,"_5":21799,"_8577":35490,"_1666":36049},[],"Lamassu añade además una extensión sobre el RFC: si el cliente envía la cabecera `Accept: application/x-pem-file`, el servidor responde con la concatenación PEM de los mismos certificados, sin el envoltorio PKCS#7. Esto facilita el consumo desde scripts. La extensión también funciona en `/simpleenroll` y `/simplereenroll`.",{"_3684":1214,"_21620":1002,"_18607":36051,"_5":21799,"_8577":35494,"_1666":36052},[],"El endpoint `POST /.well-known/est/{aps}/simpleenroll` recibe un CSR y devuelve el certificado emitido. El cuerpo de la petición debe ser el **PKCS#10 (CSR) en DER, codificado en base64** sin saltos de línea. La base64 envuelve directamente al DER, no al PEM. La cabecera `Content-Type` debe valer `application/pkcs10`. Si el `Content-Type` es diferente, el servidor responde `400` con `content-type must be application/pkcs10`; si el cuerpo no es base64 válido, responde `400` con `body payload must be base64 encoded`.",{"_3684":1215,"_21620":1002,"_18607":36054,"_5":21799,"_8577":35494,"_1666":36055},[],"La respuesta sigue el mismo envoltorio que `/cacerts`: PKCS#7 *degenerate* en base64, con `Content-Type: application/pkcs7-mime; smime-type=certs-only`. El PKCS#7 contiene **únicamente el certificado de hoja** recién emitido; no incluye la CA emisora ni intermediarios. Esto cumple RFC 7030 §4.2.3 (donde la cadena es opcional) pero implica que el integrador debe combinar este certificado con la cadena obtenida de `/cacerts` antes de presentarlo a cualquier relying party que valide cadena completa (por ejemplo, un broker MQTT con mTLS estricta).",{"_3684":1216,"_21620":1002,"_18607":36057,"_5":21799,"_8577":35494,"_1666":36058},[],"Varios campos del DMS gobiernan el comportamiento de `/simpleenroll`. El integrador no los configura, pero conviene conocerlos para interpretar los rechazos.",{"_3684":1217,"_21620":1002,"_18607":36060,"_5":21799,"_8577":35494,"_1666":35686},[],{"_3684":1218,"_21620":1002,"_18607":36062,"_5":21799,"_8577":35494,"_1666":34301},[],{"_3684":1219,"_21620":1002,"_18607":36064,"_5":21799,"_8577":35494,"_1666":36065},[],"Efecto",{"_3684":1220,"_21620":1002,"_18607":36067,"_5":21799,"_8577":35494,"_1666":36068},[],"`EnrollmentSettings.RegistrationMode`",{"_3684":1221,"_21620":1002,"_18607":36070,"_5":21799,"_8577":35494,"_1666":36071},[],"`JITP` / `PRE_REGISTRATION`",{"_3684":1222,"_21620":1002,"_18607":36073,"_5":21799,"_8577":35494,"_1666":36074},[],"Decide si el dispositivo se crea automáticamente en la primera inscripción (`JITP`) o si debe existir previamente (`PRE_REGISTRATION`).",{"_3684":1223,"_21620":1002,"_18607":36076,"_5":21799,"_8577":35494,"_1666":36077},[],"`EnrollmentSettings.EnableReplaceableEnrollment`",{"_3684":1224,"_21620":1002,"_18607":36079,"_5":21799,"_8577":35494,"_1666":20842},[],{"_3684":1225,"_21620":1002,"_18607":36081,"_5":21799,"_8577":35494,"_1666":36082},[],"Si es `true`, un dispositivo ya enrolado puede volver a inscribirse mediante `/simpleenroll`; el certificado anterior se revoca con razón `superseded`. Si es `false`, el segundo intento se rechaza con `forbiddenNewEnrollment`.",{"_3684":1226,"_21620":1002,"_18607":36084,"_5":21799,"_8577":35494,"_1666":36085},[],"`EnrollmentSettings.VerifyCSRSignature`",{"_3684":1227,"_21620":1002,"_18607":36087,"_5":21799,"_8577":35494,"_1666":20842},[],{"_3684":1228,"_21620":1002,"_18607":36089,"_5":21799,"_8577":35494,"_1666":36090},[],"Si es `true`, el servidor valida la firma del CSR contra la clave pública declarada en él (proof-of-possession estándar de PKCS#10/RFC 2986). Si es `false`, se omite la prueba de posesión. Para flotas IoT en redes abiertas debe estar en `true`.",{"_3684":1229,"_21620":1002,"_18607":36092,"_5":21799,"_8577":35494,"_1666":36093},[],"En modo `JITP`, el primer `simpleenroll` con un `CommonName` que aún no existe en Lamassu crea el dispositivo automáticamente. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente; un `CommonName` desconocido se rechaza con `device not preregistered`. Consulte Configuración de enrollment para más detalles sobre ambos modos y el comportamiento del perfil de emisión.",{"_3684":1230,"_21620":1002,"_18607":36095,"_5":21799,"_8577":35498,"_1666":36096},[],"El endpoint `POST /.well-known/est/{aps}/simplereenroll` renueva el certificado de un dispositivo ya enrolado. El formato del cuerpo es idéntico al de `/simpleenroll` (DER base64 sin saltos, `Content-Type: application/pkcs10`). La diferencia está en la autenticación: el cliente debe presentar **el certificado en vigor** del dispositivo (no el bootstrap) como credencial mTLS.",{"_3684":1231,"_21620":1002,"_18607":36098,"_5":21799,"_8577":35498,"_1666":36099},[],"Si el DMS está configurado con `AuthMode: EXTERNAL_WEBHOOK`, el webhook **no se invoca** durante `/simplereenroll`. El flujo de renovación degrada silenciosamente a `NO_AUTH`: cualquier cliente que conozca un `CommonName` válido puede solicitar reenroll para ese dispositivo sin autenticación (`allowing reenroll: using NO AUTH mode` en el log). Un DMS con `EXTERNAL_WEBHOOK` no debe usarse en producción para flujos de reenroll a menos que se controle la red de acceso al endpoint.",{"_3684":1232,"_21620":1002,"_18607":36101,"_5":21799,"_8577":35498,"_1666":36102},[],"El comportamiento del reenroll está condicionado por varios campos de `ReEnrollmentSettings`:",{"_3684":1233,"_21620":1002,"_18607":36104,"_5":21799,"_8577":35498,"_1666":35686},[],{"_3684":1234,"_21620":1002,"_18607":36106,"_5":21799,"_8577":35498,"_1666":34301},[],{"_3684":1235,"_21620":1002,"_18607":36108,"_5":21799,"_8577":35498,"_1666":36065},[],{"_3684":1236,"_21620":1002,"_18607":36110,"_5":21799,"_8577":35498,"_1666":36111},[],"`ReEnrollmentDelta`",{"_3684":1237,"_21620":1002,"_18607":36113,"_5":21799,"_8577":35498,"_1666":36114},[],"duración",{"_3684":1238,"_21620":1002,"_18607":36116,"_5":21799,"_8577":35498,"_1666":36117},[],"Define la ventana de renovación: el cliente solo puede renovar a partir de `NotAfter - ReEnrollmentDelta`. Antes de ese instante, el servidor responde con `invalid reenroll window`.",{"_3684":1239,"_21620":1002,"_18607":36119,"_5":21799,"_8577":35498,"_1666":36120},[],"`EnableExpiredRenewal`",{"_3684":1240,"_21620":1002,"_18607":36122,"_5":21799,"_8577":35498,"_1666":20842},[],{"_3684":1241,"_21620":1002,"_18607":36124,"_5":21799,"_8577":35498,"_1666":36125},[],"Si es `true`, acepta certificados ya caducados como prueba de identidad. Si es `false`, un certificado expirado provoca `expired certificate`.",{"_3684":1242,"_21620":1002,"_18607":36127,"_5":21799,"_8577":35498,"_1666":36128},[],"`RevokeOnReEnrollment`",{"_3684":1243,"_21620":1002,"_18607":36130,"_5":21799,"_8577":35498,"_1666":20842},[],{"_3684":1244,"_21620":1002,"_18607":36132,"_5":21799,"_8577":35498,"_1666":36133},[],"Si es `true`, revoca automáticamente el certificado anterior tras emitir el nuevo, con la razón `superseded` (código 4 de RFC 5280).",{"_3684":1245,"_21620":1002,"_18607":36135,"_5":21799,"_8577":35498,"_1666":36136},[],"`AdditionalValidationCAs`",{"_3684":1246,"_21620":1002,"_18607":36138,"_5":21799,"_8577":35498,"_1666":35957},[],{"_3684":1247,"_21620":1002,"_18607":36140,"_5":21799,"_8577":35498,"_1666":36141},[],"CAs adicionales que el servidor admite como emisores válidos del certificado en vigor, además de la CA de enrolamiento del DMS.",{"_3684":1248,"_21620":1002,"_18607":36143,"_5":21799,"_8577":35498,"_1666":36144},[],"**Inmutabilidad del subject**: el CSR de renovación debe tener exactamente el mismo subject que el certificado en vigor. Lamassu compara, byte a byte, el `RawSubject` del CSR con el del certificado (`slices.Compare`). Si los bytes difieren, el servidor cae a una comparación semántica de respaldo sobre los atributos `CommonName`, `OrganizationalUnit`, `Organization`, `Locality`, `Province` y `Country`. Si todos esos atributos coinciden, el reenroll continúa pese a la diferencia de bytes (rescata casos donde solo cambia la codificación, `PrintableString` frente a `UTF8String`). Si algún atributo difiere, el reenroll se aborta con `invalid RawSubject bytes`. El integrador debe regenerar el CSR con exactamente el mismo subject que en la inscripción inicial para no depender del comportamiento de fallback.",{"_3684":1249,"_21620":1002,"_18607":36146,"_5":21799,"_8577":35498,"_1666":36147},[],"**Validación de la cadena del certificado presentado**: la validación se intenta primero contra la CA de enrolamiento del DMS; si falla, recorre las `AdditionalValidationCAs`. La validación es \"shallow\": cada CA se prueba como ancla, no se compone una cadena multinivel. El cliente debe presentar la cadena completa en el handshake mTLS. Un certificado revocado aborta el reenroll con `certificate is revoked`.",{"_3684":1250,"_21620":1002,"_18607":36149,"_5":21799,"_8577":35502,"_1666":36150},[],"El endpoint `POST /.well-known/est/{aps}/serverkeygen` permite que Lamassu genere el par de claves del dispositivo en el servidor y devuelva, en la misma respuesta, la clave privada y el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada o flujos donde la clave se aprovisiona durante la fabricación.",{"_3684":1251,"_21620":1002,"_18607":36152,"_5":21799,"_8577":35502,"_1666":36153},[],"Este endpoint requiere que `ServerKeyGen.Enabled` valga `true` en el DMS. Si no está activado, el servidor responde con `server key generation not enabled`. La autenticación se aplica igual que en `/simpleenroll`: el integrador presenta la credencial que corresponda al `AuthMode` del DMS.",{"_3684":1252,"_21620":1002,"_18607":36155,"_5":21799,"_8577":35502,"_1666":36156},[],"El algoritmo y el tamaño de la clave generada se deciden por el DMS, no por el cliente.",{"_3684":1253,"_21620":1002,"_18607":36158,"_5":21799,"_8577":35502,"_1666":36159},[],"Tipo de clave",{"_3684":1254,"_21620":1002,"_18607":36161,"_5":21799,"_8577":35502,"_1666":36162},[],"Parámetro válido",{"_3684":1255,"_21620":1002,"_18607":36164,"_5":21799,"_8577":35502,"_1666":36165},[],"Curva NIST equivalente",{"_3684":1256,"_21620":1002,"_18607":36167,"_5":21799,"_8577":35502,"_1666":36168},[],"Comportamiento ante valores no válidos",{"_3684":1257,"_21620":1002,"_18607":36170,"_5":21799,"_8577":35502,"_1666":36171},[],"`RSA`",{"_3684":1258,"_21620":1002,"_18607":36173,"_5":21799,"_8577":35502,"_1666":36174},[],"Cualquier número de bits aceptado por `crypto/rsa` (típico: 2048, 3072, 4096)",{"_3684":1259,"_21620":1002,"_18607":36176,"_5":21799,"_8577":35502,"_1666":36177},[],"No aplica",{"_3684":1260,"_21620":1002,"_18607":36179,"_5":21799,"_8577":35502,"_1666":36180},[],"Si el valor no es válido para RSA, la generación falla y devuelve `500`.",{"_3684":1261,"_21620":1002,"_18607":36182,"_5":21799,"_8577":35502,"_1666":36183},[],"`ECDSA`",{"_3684":1262,"_21620":1002,"_18607":36185,"_5":21799,"_8577":35502,"_1666":36186},[],"224, 256, 384, 521",{"_3684":1263,"_21620":1002,"_18607":36188,"_5":21799,"_8577":35502,"_1666":36189},[],"P-224 / P-256 (prime256v1) / P-384 / P-521",{"_3684":1264,"_21620":1002,"_18607":36191,"_5":21799,"_8577":35502,"_1666":36192},[],"Cualquier otro valor degrada **silenciosamente** a P-256, solo con un aviso en log (`invalid key size of N for ECDSA. Defaulting to 256 curve`). El cliente no recibe error: el certificado se emite con una curva distinta de la solicitada.",{"_3684":1265,"_21620":1002,"_18607":36194,"_5":21799,"_8577":35502,"_1666":36195},[],"El CSR enviado por el cliente sirve únicamente para transportar el subject y las extensiones; la prueba de posesión PKCS#10 no aplica aquí porque el cliente no es quien generó la clave. Lamassu descarta la clave pública del CSR original, genera un par de claves nuevo con su entropía interna, en motor software y no en un Crypto Engine de hardware como AWS KMS o PKCS#11, construye un CSR nuevo con esa clave y procede a una inscripción interna equivalente a `/simpleenroll`.",{"_3684":1266,"_21620":1002,"_18607":36197,"_5":21799,"_8577":35502,"_1666":36198},[],"La respuesta es un `multipart/mixed` con el boundary literal `estServerLamassuBoundary`. Contiene dos partes:",{"_3684":1267,"_21620":1002,"_18607":36200,"_5":21799,"_8577":35502,"_1666":36201},[],"La clave privada en formato **PKCS#8 sin cifrar**, codificada en base64 dentro de una parte con `Content-Type: application/pkcs8`.",{"_3684":1268,"_21620":1002,"_18607":36203,"_5":21799,"_8577":35502,"_1666":36204},[],"El certificado emitido en PKCS#7 *degenerate* base64, dentro de una parte con `Content-Type: application/pkcs7-mime; smime-type=certs-only`.",{"_3684":1269,"_21620":1002,"_18607":36206,"_5":21799,"_8577":35502,"_1666":36207},[],"A diferencia de `/cacerts` y `/simpleenroll`, donde el base64 va troceado en líneas de 76 caracteres, cada parte de `/serverkeygen` viaja como **una única línea base64 sin saltos**. Cualquier proxy inverso que reescriba el cuerpo (por ejemplo, normalizando line endings) puede romper el parseo.",{"_3684":1270,"_21620":1002,"_18607":36209,"_5":21799,"_8577":35502,"_1666":36210},[],"Este endpoint invierte el principio PKI por el que el subscriber controla su clave privada. La clave se serializa en PKCS#8 sin cifrar (`PrivateKeyInfo`, sin `EncryptedPrivateKeyInfo`). No se aplica el envoltorio CMS `EnvelopedData` contemplado en RFC 7030 §4.4.2; no se aplica AES key wrap ni cifrado simétrico por contraseña. La única protección es el TLS del canal. El integrador debe garantizar que: (a) ningún proxy inverso termine TLS y registre el cuerpo de la respuesta; (b) la clave se cifre en reposo inmediatamente tras recibirla; (c) la cuenta de auditoría en el servidor Lamassu queda como punto único de origen de la clave.",{"_3684":1271,"_21620":1002,"_18607":36212,"_5":21799,"_8577":35502,"_1666":36213},[],"Para separar las dos partes, el siguiente fragmento usa `awk` con el boundary literal. Funciona con la estructura exacta de Lamassu (cada parte = headers + línea en blanco + una sola línea base64); cualquier proxy intermedio que reescriba el cuerpo lo romperá.",{"_3684":1272,"_21620":1002,"_18607":36215,"_5":21799,"_8577":35506,"_1666":36216},[],"Una vez revisados los endpoints por separado, estos ejemplos muestran cómo encadenarlos en dos escenarios habituales: el alta inicial de un dispositivo y la renovación de un certificado ya emitido.",{"_3684":1273,"_21620":1002,"_18607":36218,"_5":21799,"_8577":35510,"_1666":36219},[],"El siguiente script ilustra el proceso completo de inscripción de un dispositivo con clave EC P-256 generada localmente y autenticación mTLS contra un certificado bootstrap.",{"_3684":1274,"_21620":1002,"_18607":36221,"_5":21799,"_8577":35514,"_1666":36222},[],"El siguiente script reproduce un proceso de renovación: detecta la expiración del certificado actual, regenera el CSR con el **mismo subject** y se autentica con el certificado en vigor.",{"_3684":1275,"_21620":1002,"_18607":36224,"_5":21799,"_8577":35518,"_1666":36225},[],"Una vez que el dispositivo ha obtenido su certificado de identidad, los pasos habituales son:",{"_3684":1276,"_21620":1002,"_18607":36227,"_5":21799,"_8577":35518,"_1666":36228},[],"**Instalar la cadena de confianza** (`cacerts.pem`) en el almacén de confianza del dispositivo. El broker MQTT, el servidor HTTPS o cualquier relying party que valide mTLS necesitará esta cadena.",{"_3684":1277,"_21620":1002,"_18607":36230,"_5":21799,"_8577":35518,"_1666":36231},[],"**Combinar el certificado de hoja con la cadena** antes de presentarlo en conexiones mTLS. La respuesta de `/simpleenroll` contiene solo el certificado de hoja; el relying party puede rechazar la conexión si no recibe la cadena completa.",{"_3684":1278,"_21620":1002,"_18607":36233,"_5":21799,"_8577":35518,"_1666":36234},[],"**Planificar la renovación**: configurar en el dispositivo un temporizador que invoque `/simplereenroll` dentro de la ventana `ReEnrollmentDelta` antes de la caducidad del certificado. No espere a que caduque salvo que `EnableExpiredRenewal` esté activo.",{"_3684":1279,"_21620":1002,"_18607":36236,"_5":21799,"_8577":35526,"_1666":36237},[],"Lamassu mapea casi todos los errores de negocio a `500 Internal Server Error`, no a `4xx`. El código de estado HTTP no es suficiente para distinguir entre un error de red y un error de política. El integrador debe inspeccionar el campo `err` del cuerpo JSON (`{\"err\": \"<mensaje>\"}`) para determinar la causa exacta del fallo.",{"_3684":1280,"_21620":1002,"_18607":36239,"_5":21799,"_8577":35526,"_1666":36240},[],"HTTP",{"_3684":1281,"_21620":1002,"_18607":36242,"_5":21799,"_8577":35526,"_1666":36243},[],"Mensaje",{"_3684":1282,"_21620":1002,"_18607":36245,"_5":21799,"_8577":35526,"_1666":36246},[],"Causa",{"_3684":1283,"_21620":1002,"_18607":36248,"_5":21799,"_8577":35526,"_1666":36249},[],"Acción del integrador",{"_3684":1284,"_21620":1002,"_18607":36251,"_5":21799,"_8577":35526,"_1666":20137},[],{"_3684":1285,"_21620":1002,"_18607":36253,"_5":21799,"_8577":35526,"_1666":36254},[],"`Field validation for 'APS' failed`",{"_3684":1286,"_21620":1002,"_18607":36256,"_5":21799,"_8577":35526,"_1666":36257},[],"El segmento `{aps}` falta en la URL.",{"_3684":1287,"_21620":1002,"_18607":36259,"_5":21799,"_8577":35526,"_1666":36260},[],"Incluir el ID del DMS en la ruta.",{"_3684":1288,"_21620":1002,"_18607":36262,"_5":21799,"_8577":35526,"_1666":20137},[],{"_3684":1289,"_21620":1002,"_18607":36264,"_5":21799,"_8577":35526,"_1666":36265},[],"`content-type must be application/pkcs10`",{"_3684":1290,"_21620":1002,"_18607":36267,"_5":21799,"_8577":35526,"_1666":36268},[],"Cabecera `Content-Type` ausente o incorrecta.",{"_3684":1291,"_21620":1002,"_18607":36270,"_5":21799,"_8577":35526,"_1666":36271},[],"Fijar `Content-Type: application/pkcs10`.",{"_3684":1292,"_21620":1002,"_18607":36273,"_5":21799,"_8577":35526,"_1666":20137},[],{"_3684":1293,"_21620":1002,"_18607":36275,"_5":21799,"_8577":35526,"_1666":36276},[],"`body payload must be base64 encoded`",{"_3684":1294,"_21620":1002,"_18607":36278,"_5":21799,"_8577":35526,"_1666":36279},[],"El cuerpo no es base64 válido.",{"_3684":1295,"_21620":1002,"_18607":36281,"_5":21799,"_8577":35526,"_1666":36282},[],"Usar `base64 -w 0` para evitar saltos de línea.",{"_3684":1296,"_21620":1002,"_18607":36284,"_5":21799,"_8577":35526,"_1666":19722},[],{"_3684":1297,"_21620":1002,"_18607":36286,"_5":21799,"_8577":35526,"_1666":36287},[],"`DMS not found`",{"_3684":1298,"_21620":1002,"_18607":36289,"_5":21799,"_8577":35526,"_1666":36290},[],"El valor `{aps}` no se corresponde con ningún DMS.",{"_3684":1299,"_21620":1002,"_18607":36292,"_5":21799,"_8577":35526,"_1666":36293},[],"Verificar el identificador con el administrador PKI.",{"_3684":1300,"_21620":1002,"_18607":36295,"_5":21799,"_8577":35526,"_1666":19722},[],{"_3684":1301,"_21620":1002,"_18607":36297,"_5":21799,"_8577":35526,"_1666":36298},[],"`invalid certificate`",{"_3684":1302,"_21620":1002,"_18607":36300,"_5":21799,"_8577":35526,"_1666":36301},[],"El certificado cliente no es válido contra `ValidationCAs`.",{"_3684":1303,"_21620":1002,"_18607":36303,"_5":21799,"_8577":35526,"_1666":36304},[],"Comprobar la cadena del certificado bootstrap.",{"_3684":1304,"_21620":1002,"_18607":36306,"_5":21799,"_8577":35526,"_1666":19722},[],{"_3684":1305,"_21620":1002,"_18607":36308,"_5":21799,"_8577":35526,"_1666":36309},[],"`certificate is revoked`",{"_3684":1306,"_21620":1002,"_18607":36311,"_5":21799,"_8577":35526,"_1666":36312},[],"El certificado **presentado como credencial mTLS** está revocado en Lamassu o vía OCSP/CRL externos.",{"_3684":1307,"_21620":1002,"_18607":36314,"_5":21799,"_8577":35526,"_1666":36315},[],"Solicitar un nuevo certificado bootstrap o investigar la revocación.",{"_3684":1308,"_21620":1002,"_18607":36317,"_5":21799,"_8577":35526,"_1666":19722},[],{"_3684":1309,"_21620":1002,"_18607":36319,"_5":21799,"_8577":35526,"_1666":36320},[],"`revoked certificate`",{"_3684":1310,"_21620":1002,"_18607":36322,"_5":21799,"_8577":35526,"_1666":36323},[],"En reenroll, el certificado **activo del dispositivo en la base de datos** figura como revocado.",{"_3684":1311,"_21620":1002,"_18607":36325,"_5":21799,"_8577":35526,"_1666":36326},[],"Revisar el estado del slot de identidad; si la revocación fue intencional, emitir un nuevo enroll en lugar de reenroll.",{"_3684":1312,"_21620":1002,"_18607":36328,"_5":21799,"_8577":35526,"_1666":19722},[],{"_3684":1313,"_21620":1002,"_18607":36330,"_5":21799,"_8577":35526,"_1666":36331},[],"`expired certificate`",{"_3684":1314,"_21620":1002,"_18607":36333,"_5":21799,"_8577":35526,"_1666":36334},[],"El certificado presentado ha caducado y el DMS no permite `AllowExpired`/`EnableExpiredRenewal`.",{"_3684":1315,"_21620":1002,"_18607":36336,"_5":21799,"_8577":35526,"_1666":36337},[],"Renovar antes de la caducidad o solicitar habilitar `EnableExpiredRenewal`.",{"_3684":1316,"_21620":1002,"_18607":36339,"_5":21799,"_8577":35526,"_1666":19722},[],{"_3684":1317,"_21620":1002,"_18607":36341,"_5":21799,"_8577":35526,"_1666":36342},[],"`forbiddenNewEnrollment`",{"_3684":1318,"_21620":1002,"_18607":36344,"_5":21799,"_8577":35526,"_1666":36345},[],"El dispositivo ya está enrolado y `EnableReplaceableEnrollment` es `false`.",{"_3684":1319,"_21620":1002,"_18607":36347,"_5":21799,"_8577":35526,"_1666":36348},[],"Usar `/simplereenroll` o pedir al administrador que habilite el flag.",{"_3684":1320,"_21620":1002,"_18607":36350,"_5":21799,"_8577":35526,"_1666":19722},[],{"_3684":1321,"_21620":1002,"_18607":36352,"_5":21799,"_8577":35526,"_1666":36353},[],"`device not preregistered`",{"_3684":1322,"_21620":1002,"_18607":36355,"_5":21799,"_8577":35526,"_1666":36356},[],"El DMS está en `PRE_REGISTRATION` y el dispositivo no existe.",{"_3684":1323,"_21620":1002,"_18607":36358,"_5":21799,"_8577":35526,"_1666":36359},[],"Registrar el dispositivo antes de inscribirlo.",{"_3684":1324,"_21620":1002,"_18607":36361,"_5":21799,"_8577":35526,"_1666":19722},[],{"_3684":1325,"_21620":1002,"_18607":36363,"_5":21799,"_8577":35526,"_1666":36364},[],"`invalid reenroll window`",{"_3684":1326,"_21620":1002,"_18607":36366,"_5":21799,"_8577":35526,"_1666":36367},[],"Se intenta renovar antes de `NotAfter - ReEnrollmentDelta`.",{"_3684":1327,"_21620":1002,"_18607":36369,"_5":21799,"_8577":35526,"_1666":36370},[],"Esperar a la apertura de la ventana o pedir un `ReEnrollmentDelta` mayor.",{"_3684":1328,"_21620":1002,"_18607":36372,"_5":21799,"_8577":35526,"_1666":19722},[],{"_3684":1329,"_21620":1002,"_18607":36374,"_5":21799,"_8577":35526,"_1666":36375},[],"`invalid RawSubject bytes`",{"_3684":1330,"_21620":1002,"_18607":36377,"_5":21799,"_8577":35526,"_1666":36378},[],"El subject del CSR de renovación no coincide con el del certificado en vigor.",{"_3684":1331,"_21620":1002,"_18607":36380,"_5":21799,"_8577":35526,"_1666":36381},[],"Regenerar el CSR con el subject exacto del cert anterior.",{"_3684":1332,"_21620":1002,"_18607":36383,"_5":21799,"_8577":35526,"_1666":19722},[],{"_3684":1333,"_21620":1002,"_18607":36385,"_5":21799,"_8577":35526,"_1666":36386},[],"`external webhook denied enrollment`",{"_3684":1334,"_21620":1002,"_18607":36388,"_5":21799,"_8577":35526,"_1666":36389},[],"El webhook devolvió un código no `2xx` o `authorized != true`.",{"_3684":1335,"_21620":1002,"_18607":36391,"_5":21799,"_8577":35526,"_1666":36392},[],"Revisar los logs del servicio webhook.",{"_3684":1336,"_21620":1002,"_18607":36394,"_5":21799,"_8577":35526,"_1666":19722},[],{"_3684":1337,"_21620":1002,"_18607":36396,"_5":21799,"_8577":35526,"_1666":36397},[],"`server key generation not enabled`",{"_3684":1338,"_21620":1002,"_18607":36399,"_5":21799,"_8577":35526,"_1666":36400},[],"`/serverkeygen` está deshabilitado en el DMS.",{"_3684":1339,"_21620":1002,"_18607":36402,"_5":21799,"_8577":35526,"_1666":36403},[],"Pedir al administrador activar `ServerKeyGen.Enabled`.",{"_3684":1340,"_21620":1002,"_18607":36405,"_5":21799,"_8577":35526,"_1666":36406},[],"Para los mensajes que no figuren en esta tabla, los logs del servidor Lamassu (con los campos `func`, `dms`, `device-cn`, `step`, `auth-method`, `auth-status`) son el primer lugar donde buscar la causa.",{"_3684":1341,"_21620":1002,"_18607":36408,"_5":21799,"_8577":35530,"_1666":36409},[],"La implementación de Lamassu se ajusta al RFC 7030 en lo esencial pero introduce varias particularidades que pueden afectar a clientes EST estrictos o a librerías de terceros:",{"_3684":1342,"_21620":1002,"_18607":36411,"_5":21799,"_8577":35530,"_1666":36412},[],"Los endpoints `/csrattrs` y `/fullcmc` del RFC 7030 **no están implementados** en Lamassu. Un cliente que invoque `/.well-known/est/<DMS_ID>/csrattrs` recibirá `404 Not Found` en lugar del `204 No Content` que el RFC sugiere para \"sin atributos\". Las librerías EST estrictas deben configurarse para no intentar `csrattrs`.",{"_3684":1343,"_21620":1002,"_18607":36414,"_5":21799,"_8577":35530,"_1666":36415},[],"El base64 de la respuesta de `/cacerts` y `/simpleenroll` se trocea en líneas de **76 caracteres** terminadas con CRLF (conforme con S/MIME, RFC 5751). Las partes de `/serverkeygen` no aplican wrap.",{"_3684":1344,"_21620":1002,"_18607":36417,"_5":21799,"_8577":35530,"_1666":36418},[],"El boundary del `multipart/mixed` en `/serverkeygen` está fijado y no se puede negociar.",{"_3684":1345,"_21620":1002,"_18607":36420,"_5":21799,"_8577":35530,"_1666":36421},[],"El segmento `{aps}` es **obligatorio** en todas las rutas EST. Las rutas registradas sin `{aps}` están en el código pero responden `400`.",{"_3684":1346,"_21620":1002,"_18607":36423,"_5":21799,"_8577":35530,"_1666":36424},[],"El cuerpo de `/cacerts`, `/simpleenroll` y `/simplereenroll` puede devolverse como PEM concatenado si el cliente envía `Accept: application/x-pem-file`. Esta es una extensión específica de Lamassu y no aparece en el RFC.",{"_3684":1347,"_21620":1002,"_18607":36426,"_5":21799,"_8577":35530,"_1666":36427},[],"El servidor no rechaza explícitamente CSRs firmados con SHA-1 o MD5; el integrador debe generar el CSR con SHA-256 o superior.",{"_3684":1348,"_21620":1002,"_18607":36429,"_5":21799,"_8577":35530,"_1666":36430},[],"<Card title=\"Visión general del DMS\" href=\"/docs/manual/servicios-core/ra\" />",{"_3684":1349,"_21620":1002,"_18607":36432,"_5":21799,"_8577":35530,"_1666":36433},[],"<Card title=\"Validación OCSP\" href=\"/docs/manual/servicios-core/validation-ocsp\" />",{"_3684":1350,"_21620":1002,"_18607":36435,"_5":21799,"_8577":35530,"_1666":36436},[],"<Card title=\"Gestionar dispositivos\" href=\"/docs/manual/servicios-core/devices\" />",{"_3684":1351,"_21620":1351,"_5":21794,"_1666":36438,"_21807":36439,"_18607":36440,"_8577":1351},"Claves y motores criptográficos",[32337,33539,34671],[],{"_3684":1352,"_21620":1351,"_18607":36442,"_5":21799,"_8577":1351,"_1666":36443},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3684":1353,"_21620":1351,"_5":21804,"_18607":36445,"_8577":36446,"_1666":36447},[],"/docs/manual/servicios-core/kms#gestión-de-claves-criptográficas","Gestión de claves criptográficas",{"_3684":1354,"_21620":1351,"_5":21804,"_18607":36449,"_8577":36450,"_1666":36451},[],"/docs/manual/servicios-core/kms#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3684":1355,"_21620":1351,"_5":21804,"_18607":36453,"_8577":36454,"_1666":36455},[],"/docs/manual/servicios-core/kms#motores-criptográficos","Motores criptográficos",{"_3684":1356,"_21620":1351,"_5":21804,"_18607":36457,"_8577":36458,"_1666":36459},[],"/docs/manual/servicios-core/kms#inventario-de-claves","Inventario de claves",{"_3684":1357,"_21620":1351,"_5":21804,"_18607":36461,"_8577":36462,"_1666":36463},[],"/docs/manual/servicios-core/kms#crear-o-importar-claves","Crear o importar claves",{"_3684":1358,"_21620":1351,"_5":21804,"_18607":36465,"_8577":36466,"_1666":36467},[],"/docs/manual/servicios-core/kms#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3684":1359,"_21620":1351,"_5":21804,"_18607":36469,"_8577":36470,"_1666":36471},[],"/docs/manual/servicios-core/kms#importar-un-par-existente","Importar un par existente",{"_3684":1360,"_21620":1351,"_5":21804,"_18607":36473,"_8577":36474,"_1666":36475},[],"/docs/manual/servicios-core/kms#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3684":1361,"_21620":1351,"_5":21804,"_18607":36477,"_8577":36478,"_1666":36479},[],"/docs/manual/servicios-core/kms#ver-detalles","Ver detalles",{"_3684":1362,"_21620":1351,"_5":21804,"_18607":36481,"_8577":36482,"_1666":36483},[],"/docs/manual/servicios-core/kms#firmar-y-verificar","Firmar y verificar",{"_3684":1363,"_21620":1351,"_5":21804,"_18607":36485,"_8577":36486,"_1666":36487},[],"/docs/manual/servicios-core/kms#sign","Sign",{"_3684":1364,"_21620":1351,"_5":21804,"_18607":36489,"_8577":36490,"_1666":36491},[],"/docs/manual/servicios-core/kms#verify","Verify",{"_3684":1365,"_21620":1351,"_5":21804,"_18607":36493,"_8577":36494,"_1666":36495},[],"/docs/manual/servicios-core/kms#generar-un-csr","Generar un CSR",{"_3684":1366,"_21620":1351,"_5":21804,"_18607":36497,"_8577":36498,"_1666":36499},[],"/docs/manual/servicios-core/kms#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3684":1367,"_21620":1351,"_18607":36501,"_5":21799,"_8577":36446,"_1666":36502},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3684":1368,"_21620":1351,"_18607":36504,"_5":21799,"_8577":36446,"_1666":36505},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3684":1369,"_21620":1351,"_18607":36507,"_5":21799,"_8577":36450,"_1666":36508},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3684":1370,"_21620":1351,"_18607":36510,"_5":21799,"_8577":36450,"_1666":36511},[],"En la práctica, permite:",{"_3684":1371,"_21620":1351,"_18607":36513,"_5":21799,"_8577":36450,"_1666":36514},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3684":1372,"_21620":1351,"_18607":36516,"_5":21799,"_8577":36450,"_1666":36517},[],"Importar claves creadas externamente.",{"_3684":1373,"_21620":1351,"_18607":36519,"_5":21799,"_8577":36450,"_1666":36520},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3684":1374,"_21620":1351,"_18607":36522,"_5":21799,"_8577":36450,"_1666":36523},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3684":1375,"_21620":1351,"_18607":36525,"_5":21799,"_8577":36454,"_1666":36526},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3684":1376,"_21620":1351,"_18607":36528,"_5":21799,"_8577":36454,"_1666":36529},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3684":1377,"_21620":1351,"_18607":36531,"_5":21799,"_8577":36454,"_1666":36532},[],"Actualmente, Lamassu soporta los siguientes motores:",{"_3684":1378,"_21620":1351,"_18607":36534,"_5":21799,"_8577":36454,"_1666":36535},[],"Crypto Engine",{"_3684":1379,"_21620":1351,"_18607":36537,"_5":21799,"_8577":36454,"_1666":36538},[],"Nivel de seguridad",{"_3684":1380,"_21620":1351,"_18607":36540,"_5":21799,"_8577":36454,"_1666":36541},[],"OnPrem / Cloud",{"_3684":1381,"_21620":1351,"_18607":36543,"_5":21799,"_8577":36454,"_1666":36544},[],"Coste adicional",{"_3684":1382,"_21620":1351,"_18607":36546,"_5":21799,"_8577":36454,"_1666":36547},[],"Generación de claves",{"_3684":1383,"_21620":1351,"_18607":36549,"_5":21799,"_8577":36454,"_1666":36550},[],"Persistencia *at-rest* segura",{"_3684":1384,"_21620":1351,"_18607":36552,"_5":21799,"_8577":36454,"_1666":36553},[],"Filtración de claves",{"_3684":1385,"_21620":1351,"_18607":36555,"_5":21799,"_8577":36454,"_1666":36556},[],"Consideraciones",{"_3684":1386,"_21620":1351,"_18607":36558,"_5":21799,"_8577":36454,"_1666":36559},[],"File System",{"_3684":1387,"_21620":1351,"_18607":36561,"_5":21799,"_8577":36454,"_1666":11500},[],{"_3684":1388,"_21620":1351,"_18607":36563,"_5":21799,"_8577":36454,"_1666":36564},[],"OnPrem y Cloud",{"_3684":1389,"_21620":1351,"_18607":36566,"_5":21799,"_8577":36454,"_1666":34366},[],{"_3684":1390,"_21620":1351,"_18607":36568,"_5":21799,"_8577":36454,"_1666":36569},[],"**Entropía software**. La generación se realiza con las librerías criptográficas de Go.",{"_3684":1391,"_21620":1351,"_18607":36571,"_5":21799,"_8577":36454,"_1666":36572},[],"**Insegura**. Delegada en el sistema de archivos.",{"_3684":1392,"_21620":1351,"_18607":36574,"_5":21799,"_8577":36454,"_1666":36572},[],{"_3684":1393,"_21620":1351,"_18607":36576,"_5":21799,"_8577":36454,"_1666":36577},[],"No recomendado para producción.",{"_3684":1394,"_21620":1351,"_18607":36579,"_5":21799,"_8577":36454,"_1666":36580},[],"HashiCorp Vault",{"_3684":1395,"_21620":1351,"_18607":36582,"_5":21799,"_8577":36454,"_1666":7058},[],{"_3684":1396,"_21620":1351,"_18607":36584,"_5":21799,"_8577":36454,"_1666":36564},[],{"_3684":1397,"_21620":1351,"_18607":36586,"_5":21799,"_8577":36454,"_1666":34366},[],{"_3684":1398,"_21620":1351,"_18607":36588,"_5":21799,"_8577":36454,"_1666":36589},[],"Depende de la configuración de Vault.",{"_3684":1399,"_21620":1351,"_18607":36591,"_5":21799,"_8577":36454,"_1666":36592},[],"**Segura**",{"_3684":1400,"_21620":1351,"_18607":36594,"_5":21799,"_8577":36454,"_1666":36595},[],"**Insegura**. Un administrador con permisos suficientes puede visualizar la clave privada.",{"_3684":1401,"_21620":1351,"_18607":36597,"_5":21799,"_8577":36454,"_1666":36598},[],"Conviene limitar al máximo el acceso administrativo y custodiar correctamente las claves de *unseal*.",{"_3684":1402,"_21620":1351,"_18607":36600,"_5":21799,"_8577":36454,"_1666":36601},[],"AWS Secrets Manager",{"_3684":1403,"_21620":1351,"_18607":36603,"_5":21799,"_8577":36454,"_1666":7058},[],{"_3684":1404,"_21620":1351,"_18607":36605,"_5":21799,"_8577":36454,"_1666":36606},[],"Cloud",{"_3684":1405,"_21620":1351,"_18607":36608,"_5":21799,"_8577":36454,"_1666":34314},[],{"_3684":1406,"_21620":1351,"_18607":36610,"_5":21799,"_8577":36454,"_1666":36611},[],"Depende del proceso de alta de la clave.",{"_3684":1407,"_21620":1351,"_18607":36613,"_5":21799,"_8577":36454,"_1666":36592},[],{"_3684":1408,"_21620":1351,"_18607":36615,"_5":21799,"_8577":36454,"_1666":36595},[],{"_3684":1409,"_21620":1351,"_18607":36617,"_5":21799,"_8577":36454,"_1666":36618},[],"La protección *at-rest* la proporciona AWS, pero no evita el acceso administrativo al material privado.",{"_3684":1410,"_21620":1351,"_18607":36620,"_5":21799,"_8577":36454,"_1666":36621},[],"AWS KMS",{"_3684":1411,"_21620":1351,"_18607":36623,"_5":21799,"_8577":36454,"_1666":11606},[],{"_3684":1412,"_21620":1351,"_18607":36625,"_5":21799,"_8577":36454,"_1666":36606},[],{"_3684":1413,"_21620":1351,"_18607":36627,"_5":21799,"_8577":36454,"_1666":34314},[],{"_3684":1414,"_21620":1351,"_18607":36629,"_5":21799,"_8577":36454,"_1666":36630},[],"**Entropía hardware**",{"_3684":1415,"_21620":1351,"_18607":36632,"_5":21799,"_8577":36454,"_1666":36592},[],{"_3684":1416,"_21620":1351,"_18607":36634,"_5":21799,"_8577":36454,"_1666":36592},[],{"_3684":1417,"_21620":1351,"_18607":36636,"_5":21799,"_8577":36454,"_1666":36637},[],"Aunque la clave privada no se expone, un actor con permisos suficientes podría usarla para firmar artefactos.",{"_3684":1418,"_21620":1351,"_18607":36639,"_5":21799,"_8577":36454,"_1666":36640},[],"PKCS11",{"_3684":1419,"_21620":1351,"_18607":36642,"_5":21799,"_8577":36454,"_1666":36643},[],"3\\*",{"_3684":1420,"_21620":1351,"_18607":36645,"_5":21799,"_8577":36454,"_1666":36646},[],"AirGap OnPrem y Cloud",{"_3684":1421,"_21620":1351,"_18607":36648,"_5":21799,"_8577":36454,"_1666":36649},[],"Depende del hardware o del servicio usado. Puede integrarse con HSMs OnPrem o con ofertas Key as a Service.",{"_3684":1422,"_21620":1351,"_18607":36651,"_5":21799,"_8577":36454,"_1666":36630},[],{"_3684":1423,"_21620":1351,"_18607":36653,"_5":21799,"_8577":36454,"_1666":36654},[],"**Segura**\\*",{"_3684":1424,"_21620":1351,"_18607":36656,"_5":21799,"_8577":36454,"_1666":36657},[],"Depende del HSM",{"_3684":1425,"_21620":1351,"_18607":36659,"_5":21799,"_8577":36454,"_1666":36660},[],"El nivel real depende de la implementación PKCS11 y del HSM utilizado.",{"_3684":1426,"_21620":1351,"_18607":36662,"_5":21799,"_8577":36454,"_1666":36663},[],"Lamassu muestra en la consola el listado completo de motores habilitados.",{"_3684":1427,"_21620":1351,"_18607":36665,"_5":21799,"_8577":36454,"_1666":36666},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3684":1428,"_21620":1351,"_18607":36668,"_5":21799,"_8577":36454,"_1666":36669},[],"Durante el despliegue es obligatorio definir un motor por defecto. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3684":1429,"_21620":1351,"_18607":36671,"_5":21799,"_8577":36458,"_1666":36672},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3684":1430,"_21620":1351,"_18607":36674,"_5":21799,"_8577":36458,"_1666":36675},[],"La tabla incluye los siguientes campos:",{"_3684":1431,"_21620":1351,"_18607":36677,"_5":21799,"_8577":36458,"_1666":36678},[],"**Name**: nombre descriptivo de la clave.",{"_3684":1432,"_21620":1351,"_18607":36680,"_5":21799,"_8577":36458,"_1666":36681},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3684":1433,"_21620":1351,"_18607":36683,"_5":21799,"_8577":36458,"_1666":36684},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3684":1434,"_21620":1351,"_18607":36686,"_5":21799,"_8577":36458,"_1666":36687},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3684":1435,"_21620":1351,"_18607":36689,"_5":21799,"_8577":36458,"_1666":36690},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3684":1436,"_21620":1351,"_18607":36692,"_5":21799,"_8577":36458,"_1666":36693},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3684":1437,"_21620":1351,"_18607":36695,"_5":21799,"_8577":36458,"_1666":36696},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3684":1438,"_21620":1351,"_18607":36698,"_5":21799,"_8577":36458,"_1666":36699},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3684":1439,"_21620":1351,"_18607":36701,"_5":21799,"_8577":36458,"_1666":36702},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3684":1440,"_21620":1351,"_18607":36704,"_5":21799,"_8577":36458,"_1666":36705},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3684":1441,"_21620":1351,"_18607":36707,"_5":21799,"_8577":36458,"_1666":36708},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3684":1442,"_21620":1351,"_18607":36710,"_5":21799,"_8577":36458,"_1666":36711},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3684":1443,"_21620":1351,"_18607":36713,"_5":21799,"_8577":36458,"_1666":36714},[],"**Delete Key** para eliminar la clave del sistema.",{"_3684":1444,"_21620":1351,"_18607":36716,"_5":21799,"_8577":36462,"_1666":36717},[],"El alta de claves se realiza desde el asistente que se abre con **Create New Key**.",{"_3684":1445,"_21620":1351,"_18607":36719,"_5":21799,"_8577":36466,"_1666":36720},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3684":1446,"_21620":1351,"_18607":36722,"_5":21799,"_8577":36466,"_1666":36723},[],"En la primera pantalla del asistente, elija **Generate New Key Pair** y después defina los parámetros principales:",{"_3684":1447,"_21620":1351,"_18607":36725,"_5":21799,"_8577":36466,"_1666":36726},[],"**Key Name**: nombre único y descriptivo.",{"_3684":1448,"_21620":1351,"_18607":36728,"_5":21799,"_8577":36466,"_1666":36729},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3684":1449,"_21620":1351,"_18607":36731,"_5":21799,"_8577":36466,"_1666":36732},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3684":1450,"_21620":1351,"_18607":36734,"_5":21799,"_8577":36466,"_1666":36735},[],"**Tags**: metadatos para clasificar la clave.",{"_3684":1451,"_21620":1351,"_18607":36737,"_5":21799,"_8577":36466,"_1666":36738},[],"**Metadata**: información adicional para usos avanzados.",{"_3684":1452,"_21620":1351,"_18607":36740,"_5":21799,"_8577":36470,"_1666":36741},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3684":1453,"_21620":1351,"_18607":36743,"_5":21799,"_8577":36470,"_1666":36744},[],"Cuando la clave se ha generado en un entorno aislado o en un HSM externo.",{"_3684":1454,"_21620":1351,"_18607":36746,"_5":21799,"_8577":36470,"_1666":36747},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3684":1455,"_21620":1351,"_18607":36749,"_5":21799,"_8577":36470,"_1666":36750},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3684":1456,"_21620":1351,"_18607":36752,"_5":21799,"_8577":36470,"_1666":36753},[],"En el asistente, elija **Import Existing Key Pair** y complete los campos solicitados:",{"_3684":1457,"_21620":1351,"_18607":36755,"_5":21799,"_8577":36470,"_1666":36756},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3684":1458,"_21620":1351,"_18607":36758,"_5":21799,"_8577":36470,"_1666":36759},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3684":1459,"_21620":1351,"_18607":36761,"_5":21799,"_8577":36470,"_1666":36762},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3684":1460,"_21620":1351,"_18607":36764,"_5":21799,"_8577":36470,"_1666":36765},[],"**Metadata**: información adicional opcional.",{"_3684":1461,"_21620":1351,"_18607":36767,"_5":21799,"_8577":36470,"_1666":36768},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3684":1462,"_21620":1351,"_18607":36770,"_5":21799,"_8577":36470,"_1666":36771},[],"Una vez completado el asistente, la clave queda almacenada en el motor seleccionado y puede utilizarse para firma, generación de CSR y el resto de operaciones soportadas por KMS.",{"_3684":1463,"_21620":1351,"_18607":36773,"_5":21799,"_8577":36474,"_1666":36774},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3684":1464,"_21620":1351,"_18607":36776,"_5":21799,"_8577":36478,"_1666":36777},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3684":1465,"_21620":1351,"_18607":36779,"_5":21799,"_8577":36478,"_1666":36780},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3684":1466,"_21620":1351,"_18607":36782,"_5":21799,"_8577":36478,"_1666":36783},[],"**Key Name**: nombre descriptivo.",{"_3684":1467,"_21620":1351,"_18607":36785,"_5":21799,"_8577":36478,"_1666":36786},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3684":1468,"_21620":1351,"_18607":36788,"_5":21799,"_8577":36478,"_1666":36789},[],"**Tags**: etiquetas asociadas.",{"_3684":1469,"_21620":1351,"_18607":36791,"_5":21799,"_8577":36478,"_1666":36792},[],"**Aliases**: nombres alternativos.",{"_3684":1470,"_21620":1351,"_18607":36794,"_5":21799,"_8577":36478,"_1666":36795},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3684":1471,"_21620":1351,"_18607":36797,"_5":21799,"_8577":36478,"_1666":36798},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3684":1472,"_21620":1351,"_18607":36800,"_5":21799,"_8577":36478,"_1666":36801},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3684":1473,"_21620":1351,"_18607":36803,"_5":21799,"_8577":36478,"_1666":36804},[],"La pestaña **Public Key** presenta la clave pública en formato PEM, lista para consulta o copia.",{"_3684":1474,"_21620":1351,"_18607":36806,"_5":21799,"_8577":36482,"_1666":36807},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3684":1475,"_21620":1351,"_18607":36809,"_5":21799,"_8577":36482,"_1666":36810},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3684":1476,"_21620":1351,"_18607":36812,"_5":21799,"_8577":36486,"_1666":36813},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3684":1477,"_21620":1351,"_18607":36815,"_5":21799,"_8577":36486,"_1666":36816},[],"Campos principales:",{"_3684":1478,"_21620":1351,"_18607":36818,"_5":21799,"_8577":36486,"_1666":36819},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3684":1479,"_21620":1351,"_18607":36821,"_5":21799,"_8577":36486,"_1666":36822},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3684":1480,"_21620":1351,"_18607":36824,"_5":21799,"_8577":36486,"_1666":36825},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3684":1481,"_21620":1351,"_18607":36827,"_5":21799,"_8577":36486,"_1666":36828},[],"**Message**: contenido que se va a firmar.",{"_3684":1482,"_21620":1351,"_18607":36830,"_5":21799,"_8577":36486,"_1666":36831},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3684":1483,"_21620":1351,"_18607":36833,"_5":21799,"_8577":36490,"_1666":36834},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3684":1484,"_21620":1351,"_18607":36836,"_5":21799,"_8577":36490,"_1666":36816},[],{"_3684":1485,"_21620":1351,"_18607":36838,"_5":21799,"_8577":36490,"_1666":36839},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3684":1486,"_21620":1351,"_18607":36841,"_5":21799,"_8577":36490,"_1666":36842},[],"**Message Type**: `Raw` o `Digest`.",{"_3684":1487,"_21620":1351,"_18607":36844,"_5":21799,"_8577":36490,"_1666":36845},[],"**Payload Encoding**: codificación del mensaje.",{"_3684":1488,"_21620":1351,"_18607":36847,"_5":21799,"_8577":36490,"_1666":36848},[],"**Message**: mensaje original o hash.",{"_3684":1489,"_21620":1351,"_18607":36850,"_5":21799,"_8577":36490,"_1666":36851},[],"**Signature**: firma que se desea comprobar.",{"_3684":1490,"_21620":1351,"_18607":36853,"_5":21799,"_8577":36490,"_1666":36854},[],"**Result**: indicador del resultado de la validación.",{"_3684":1491,"_21620":1351,"_18607":36856,"_5":21799,"_8577":36494,"_1666":36857},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3684":1492,"_21620":1351,"_18607":36859,"_5":21799,"_8577":36494,"_1666":36860},[],"Este flujo es útil para:",{"_3684":1493,"_21620":1351,"_18607":36862,"_5":21799,"_8577":36494,"_1666":36863},[],"Solicitar certificados a una CA externa.",{"_3684":1494,"_21620":1351,"_18607":36865,"_5":21799,"_8577":36494,"_1666":36866},[],"Renovar una identidad manteniendo la misma clave.",{"_3684":1495,"_21620":1351,"_18607":36868,"_5":21799,"_8577":36494,"_1666":36869},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3684":1496,"_21620":1351,"_18607":36871,"_5":21799,"_8577":36494,"_1666":36872},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3684":1497,"_21620":1351,"_18607":36874,"_5":21799,"_8577":36494,"_1666":36875},[],"**Organization (O)**: organización o empresa.",{"_3684":1498,"_21620":1351,"_18607":36877,"_5":21799,"_8577":36494,"_1666":36878},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3684":1499,"_21620":1351,"_18607":36880,"_5":21799,"_8577":36494,"_1666":36881},[],"**Country (C)**: código de país de dos letras.",{"_3684":1500,"_21620":1351,"_18607":36883,"_5":21799,"_8577":36494,"_1666":36884},[],"**State / Province (ST)**: estado o provincia.",{"_3684":1501,"_21620":1351,"_18607":36886,"_5":21799,"_8577":36494,"_1666":36887},[],"**Locality (L)**: ciudad o localidad.",{"_3684":1502,"_21620":1351,"_18607":36889,"_5":21799,"_8577":36494,"_1666":36890},[],"**Email Address**: correo de contacto.",{"_3684":1503,"_21620":1351,"_18607":36892,"_5":21799,"_8577":36494,"_1666":36893},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3684":1504,"_21620":1351,"_18607":36895,"_5":21799,"_8577":36494,"_1666":36896},[],"Una vez completado el formulario, Lamassu genera la CSR y la presenta para su descarga o copia.",{"_3684":1505,"_21620":1351,"_18607":36898,"_5":21799,"_8577":36498,"_1666":36899},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3684":1506,"_21620":1351,"_18607":36901,"_5":21799,"_8577":36498,"_1666":36902},[],"Esta opción muestra los pasos necesarios para configurar el entorno local, cargar el módulo PKCS#11 y ejecutar firmas con herramientas como OpenSSL sin extraer la clave privada del entorno custodiado.",{"_3684":1507,"_21620":1507,"_5":21794,"_1666":36904,"_21807":36905,"_18607":36906,"_8577":1507},"Device Management Service",[32337,33539,34671],[],{"_3684":1508,"_21620":1507,"_18607":36908,"_5":21799,"_8577":1507,"_1666":36909},[],"Define cómo una flota recibe, renueva y utiliza sus identidades.",{"_3684":1509,"_21620":1507,"_5":21804,"_18607":36911,"_8577":36912,"_1666":32347},[],"/docs/manual/servicios-core/ra#antes-de-empezar",{"_3684":1510,"_21620":1507,"_5":21804,"_18607":36914,"_8577":36915,"_1666":36916},[],"/docs/manual/servicios-core/ra#configura-un-dms","Configura un DMS",{"_3684":1511,"_21620":1507,"_5":21804,"_18607":36918,"_8577":36919,"_1666":36920},[],"/docs/manual/servicios-core/ra#identifica-la-flota","Identifica la flota",{"_3684":1512,"_21620":1507,"_5":21804,"_18607":36922,"_8577":36923,"_1666":36924},[],"/docs/manual/servicios-core/ra#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3684":1513,"_21620":1507,"_5":21804,"_18607":36926,"_8577":36927,"_1666":36928},[],"/docs/manual/servicios-core/ra#configura-est","Configura EST",{"_3684":1514,"_21620":1507,"_5":21804,"_18607":36930,"_8577":36931,"_1666":36932},[],"/docs/manual/servicios-core/ra#distribuye-la-confianza","Distribuye la confianza",{"_3684":1515,"_21620":1507,"_5":21804,"_18607":36934,"_8577":36935,"_1666":36936},[],"/docs/manual/servicios-core/ra#verifica-los-endpoints","Verifica los endpoints",{"_3684":1516,"_21620":1507,"_5":21804,"_18607":36938,"_8577":36939,"_1666":36940},[],"/docs/manual/servicios-core/ra#distribución-de-confianza","Distribución de confianza",{"_3684":1517,"_21620":1507,"_5":21804,"_18607":36942,"_8577":36943,"_1666":36944},[],"/docs/manual/servicios-core/ra#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3684":1518,"_21620":1507,"_5":21804,"_18607":36946,"_8577":36947,"_1666":36948},[],"/docs/manual/servicios-core/ra#integra-los-dispositivos","Integra los dispositivos",{"_3684":1519,"_21620":1507,"_18607":36950,"_5":21799,"_8577":1507,"_1666":36951},[],"Un &#x2A;*Device Management Service (DMS)** actúa como autoridad de registro frente a una flota. Recibe solicitudes, aplica la política de autenticación y encarga la emisión a la CA configurada.",{"_3684":1520,"_21620":1507,"_18607":36953,"_5":21799,"_8577":1507,"_1666":36954},[],"Cada DMS es un límite operativo independiente: puede representar una línea de producto, un entorno o un tipo de dispositivo con su propia CA, reglas de autenticación, confianza distribuida y ventana de renovación.",{"_3684":1521,"_21620":1507,"_18607":36956,"_5":21799,"_8577":36912,"_1666":36957},[],"Crea o importa al menos una CA activa.",{"_3684":1522,"_21620":1507,"_18607":36959,"_5":21799,"_8577":36912,"_1666":36960},[],"Decide cómo se autenticarán los dispositivos durante el primer enrolamiento.",{"_3684":1523,"_21620":1507,"_18607":36962,"_5":21799,"_8577":36912,"_1666":36963},[],"Define qué autoridades debe recibir el dispositivo como anclas de confianza.",{"_3684":1524,"_21620":1507,"_18607":36965,"_5":21799,"_8577":36912,"_1666":36966},[],"Asegúrate de tener permisos para administrar DMS.",{"_3684":1525,"_21620":1507,"_18607":36968,"_5":21799,"_8577":36919,"_1666":36969},[],"Asigna al DMS un nombre que describa su alcance, por ejemplo una familia de dispositivos o un entorno.",{"_3684":1526,"_21620":1507,"_18607":36971,"_5":21799,"_8577":36923,"_1666":36972},[],"Elige la autoridad que emitirá las identidades. Su política y periodo de validez condicionan los certificados que podrá obtener la flota.",{"_3684":1527,"_21620":1507,"_18607":36974,"_5":21799,"_8577":36927,"_1666":36975},[],"Define la autenticación de `enroll`, la política de `reenroll`, la ventana de renovación y, si se necesita, `serverkeygen`.",{"_3684":1528,"_21620":1507,"_18607":36977,"_5":21799,"_8577":36931,"_1666":36978},[],"Configura **CA Distribution** para controlar la respuesta del endpoint `cacerts`.",{"_3684":1529,"_21620":1507,"_18607":36980,"_5":21799,"_8577":36935,"_1666":36981},[],"Desde el menú del DMS, abre &#x2A;*EST (RFC-7030)** y comprueba la URL base y los ejemplos de invocación antes de integrar el firmware.",{"_3684":1530,"_21620":1507,"_18607":36983,"_5":21799,"_8577":36939,"_1666":34298},[],{"_3684":1531,"_21620":1507,"_18607":36985,"_5":21799,"_8577":36939,"_1666":36986},[],"Qué distribuye",{"_3684":1532,"_21620":1507,"_18607":36988,"_5":21799,"_8577":36939,"_1666":36989},[],"**Include Lamassu System CA**",{"_3684":1533,"_21620":1507,"_18607":36991,"_5":21799,"_8577":36939,"_1666":36992},[],"Certificado TLS del servidor Lamassu, útil para pinning. No representa una CA de emisión.",{"_3684":1534,"_21620":1507,"_18607":36994,"_5":21799,"_8577":36939,"_1666":36995},[],"**Include Enrollment CA**",{"_3684":1535,"_21620":1507,"_18607":36997,"_5":21799,"_8577":36939,"_1666":36998},[],"Autoridad configurada para emitir las identidades del DMS.",{"_3684":1536,"_21620":1507,"_18607":37000,"_5":21799,"_8577":36939,"_1666":37001},[],"**Managed CAs**",{"_3684":1537,"_21620":1507,"_18607":37003,"_5":21799,"_8577":36939,"_1666":37004},[],"Autoridades adicionales que el dispositivo debe confiar.",{"_3684":1538,"_21620":1507,"_18607":37006,"_5":21799,"_8577":36943,"_1666":37007},[],"Acción",{"_3684":1539,"_21620":1507,"_18607":37009,"_5":21799,"_8577":36943,"_1666":34967},[],{"_3684":1540,"_21620":1507,"_18607":37011,"_5":21799,"_8577":36943,"_1666":37012},[],"**Edit**",{"_3684":1541,"_21620":1507,"_18607":37014,"_5":21799,"_8577":36943,"_1666":37015},[],"Modifica la política del DMS.",{"_3684":1542,"_21620":1507,"_18607":37017,"_5":21799,"_8577":36943,"_1666":37018},[],"**Go to DMS owned devices**",{"_3684":1543,"_21620":1507,"_18607":37020,"_5":21799,"_8577":36943,"_1666":37021},[],"Abre únicamente los dispositivos de esa flota.",{"_3684":1544,"_21620":1507,"_18607":37023,"_5":21799,"_8577":36943,"_1666":37024},[],"**Show/Edit Metadata**",{"_3684":1545,"_21620":1507,"_18607":37026,"_5":21799,"_8577":36943,"_1666":37027},[],"Gestiona configuración avanzada y datos de integraciones.",{"_3684":1546,"_21620":1507,"_18607":37029,"_5":21799,"_8577":36943,"_1666":37030},[],"**EST (RFC-7030)**",{"_3684":1547,"_21620":1507,"_18607":37032,"_5":21799,"_8577":36943,"_1666":37033},[],"Muestra endpoints y ejemplos específicos del DMS.",{"_3684":1548,"_21620":1507,"_18607":37035,"_5":21799,"_8577":36943,"_1666":37036},[],"**Delete**",{"_3684":1549,"_21620":1507,"_18607":37038,"_5":21799,"_8577":36943,"_1666":37039},[],"Elimina el DMS; la acción es irreversible.",{"_3684":1550,"_21620":1507,"_18607":37041,"_5":21799,"_8577":36947,"_1666":37042},[],"<Card title=\"Enrolamiento EST\" description=\"Configura autenticación, endpoints y flujos para firmware.\" href=\"/docs/manual/servicios-core/est\" />",{"_3684":1551,"_21620":1507,"_18607":37044,"_5":21799,"_8577":36947,"_1666":37045},[],"<Card title=\"Dispositivos e identidades\" description=\"Consulta estados, historial y acciones operativas.\" href=\"/docs/manual/servicios-core/devices\" />",{"_3684":1552,"_21620":1552,"_5":21794,"_1666":37047,"_21807":37048,"_18607":37049,"_8577":1552},"Listas de revocación (CRL)",[32337,33539,34671],[],{"_3684":1553,"_21620":1552,"_18607":37051,"_5":21799,"_8577":1552,"_1666":37052},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3684":1554,"_21620":1552,"_5":21804,"_18607":37054,"_8577":37055,"_1666":37056},[],"/docs/manual/servicios-core/validation-crl#servicio-crl","Servicio CRL",{"_3684":1555,"_21620":1552,"_5":21804,"_18607":37058,"_8577":37059,"_1666":37060},[],"/docs/manual/servicios-core/validation-crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_3684":1556,"_21620":1552,"_5":21804,"_18607":37062,"_8577":37063,"_1666":37064},[],"/docs/manual/servicios-core/validation-crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3684":1557,"_21620":1552,"_5":21804,"_18607":37066,"_8577":37067,"_1666":37068},[],"/docs/manual/servicios-core/validation-crl#contenido-de-la-crl","Contenido de la CRL",{"_3684":1558,"_21620":1552,"_5":21804,"_18607":37070,"_8577":37071,"_1666":37072},[],"/docs/manual/servicios-core/validation-crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3684":1559,"_21620":1552,"_5":21804,"_18607":37074,"_8577":37075,"_1666":37076},[],"/docs/manual/servicios-core/validation-crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_3684":1560,"_21620":1552,"_5":21804,"_18607":37078,"_8577":37079,"_1666":37080},[],"/docs/manual/servicios-core/validation-crl#desde-la-interfaz","Desde la interfaz",{"_3684":1561,"_21620":1552,"_5":21804,"_18607":37082,"_8577":37083,"_1666":37084},[],"/docs/manual/servicios-core/validation-crl#referencias","Referencias",{"_3684":1562,"_21620":1552,"_18607":37086,"_5":21799,"_8577":37055,"_1666":37087},[],"Una CRL (*Certificate Revocation List*) es una lista firmada que contiene los números de serie de los certificados revocados antes de su fecha de caducidad. A diferencia de OCSP, no requiere una consulta en tiempo real: la parte que confía descarga la lista periódicamente y la consulta de forma local.",{"_3684":1563,"_21620":1552,"_18607":37089,"_5":21799,"_8577":37055,"_1666":37090},[],"Lamassu genera y mantiene una CRL por cada CA que gestiona. Cada CRL está firmada con la clave privada de la propia CA emisora y se almacena en el sistema de almacenamiento de objetos configurado en la plataforma.",{"_3684":1564,"_21620":1552,"_18607":37092,"_5":21799,"_8577":37059,"_1666":37093},[],"La publicación de la CRL de cada CA se controla mediante un *rol VA*. Este objeto define cómo se genera, cuándo se regenera y qué clave se utiliza para firmarla.",{"_3684":1565,"_21620":1552,"_18607":37095,"_5":21799,"_8577":37059,"_1666":37096},[],"Los parámetros principales son:",{"_3684":1566,"_21620":1552,"_18607":37098,"_5":21799,"_8577":37059,"_1666":34298},[],{"_3684":1567,"_21620":1552,"_18607":37100,"_5":21799,"_8577":37059,"_1666":32643},[],{"_3684":1568,"_21620":1552,"_18607":37102,"_5":21799,"_8577":37059,"_1666":32646},[],{"_3684":1569,"_21620":1552,"_18607":37104,"_5":21799,"_8577":37059,"_1666":37105},[],"`validity`",{"_3684":1570,"_21620":1552,"_18607":37107,"_5":21799,"_8577":37059,"_1666":37108},[],"7 días",{"_3684":1571,"_21620":1552,"_18607":37110,"_5":21799,"_8577":37059,"_1666":37111},[],"Período de validez de cada CRL emitida, reflejado en el campo `nextUpdate`.",{"_3684":1572,"_21620":1552,"_18607":37113,"_5":21799,"_8577":37059,"_1666":37114},[],"`refresh_interval`",{"_3684":1573,"_21620":1552,"_18607":37116,"_5":21799,"_8577":37059,"_1666":37117},[],"\\~6 días y 23 horas",{"_3684":1574,"_21620":1552,"_18607":37119,"_5":21799,"_8577":37059,"_1666":37120},[],"Intervalo mínimo entre regeneraciones periódicas programadas.",{"_3684":1575,"_21620":1552,"_18607":37122,"_5":21799,"_8577":37059,"_1666":37123},[],"`regenerate_on_revoke`",{"_3684":1576,"_21620":1552,"_18607":37125,"_5":21799,"_8577":37059,"_1666":37126},[],"`true`",{"_3684":1577,"_21620":1552,"_18607":37128,"_5":21799,"_8577":37059,"_1666":37129},[],"Cuando se revoca un certificado, se genera una nueva CRL de inmediato sin esperar al ciclo periódico.",{"_3684":1578,"_21620":1552,"_18607":37131,"_5":21799,"_8577":37059,"_1666":37132},[],"El campo `subject_key_id_signer` identifica la CA cuya clave privada firma la CRL. Por defecto, cada CA firma su propia CRL.",{"_3684":1579,"_21620":1552,"_18607":37134,"_5":21799,"_8577":37059,"_1666":37135},[],"Cada CRL lleva un número de versión incremental. Lamassu almacena todas las versiones en la ruta `pki/va/crl/{subject_key_id}/{version}.crl` del almacenamiento de objetos.",{"_3684":1580,"_21620":1552,"_18607":37137,"_5":21799,"_8577":37063,"_1666":37138},[],"Un proceso en segundo plano supervisa los roles VA activos. Cuando la validez restante de la CRL vigente cae por debajo del período de vigilancia configurado (*blind period*), el sistema solicita la generación de una nueva CRL. Así se evita que la CRL publicada caduque sin que exista una versión válida disponible.",{"_3684":1581,"_21620":1552,"_18607":37140,"_5":21799,"_8577":37063,"_1666":37141},[],"Además, cuando `regenerate_on_revoke` está activo, que es el comportamiento por defecto, cualquier revocación de un certificado desencadena inmediatamente la generación de una nueva CRL para la CA afectada. Esto reduce al mínimo el tiempo entre la revocación y su publicación.",{"_3684":1582,"_21620":1552,"_18607":37143,"_5":21799,"_8577":37067,"_1666":37144},[],"Cada entrada de la CRL incluye el número de serie del certificado revocado, la fecha de revocación y el código de razón conforme a RFC 5280.",{"_3684":1583,"_21620":1552,"_18607":37146,"_5":21799,"_8577":37067,"_1666":37147},[],"La CRL incluye también la extensión *Issuing Distribution Point* (IDP, OID 2.5.29.28), marcada como crítica, que indica la URL pública desde la que puede descargarse. Esa URL apunta al endpoint `/crl/{subject_key_id}` de cada dominio VA configurado.",{"_3684":1584,"_21620":1552,"_18607":37149,"_5":21799,"_8577":37071,"_1666":37150},[],"La CRL más reciente de una CA se puede obtener directamente sin autenticación:",{"_3684":1585,"_21620":1552,"_18607":37152,"_5":21799,"_8577":37071,"_1666":37153},[],"La respuesta tiene `Content-Type: application/pkix-crl` y contiene la CRL en formato DER.",{"_3684":1586,"_21620":1552,"_18607":37155,"_5":21799,"_8577":37075,"_1666":37156},[],"El rol VA de una CA se puede consultar y actualizar mediante la API:",{"_3684":1587,"_21620":1552,"_18607":37158,"_5":21799,"_8577":37075,"_1666":35132},[],{"_3684":1588,"_21620":1552,"_18607":37160,"_5":21799,"_8577":37075,"_1666":37161},[],"Ruta",{"_3684":1589,"_21620":1552,"_18607":37163,"_5":21799,"_8577":37075,"_1666":32646},[],{"_3684":1590,"_21620":1552,"_18607":37165,"_5":21799,"_8577":37075,"_1666":37166},[],"`GET`",{"_3684":1591,"_21620":1552,"_18607":37168,"_5":21799,"_8577":37075,"_1666":37169},[],"`/v1/roles/{ca-ski}`",{"_3684":1592,"_21620":1552,"_18607":37171,"_5":21799,"_8577":37075,"_1666":37172},[],"Devuelve la configuración del rol VA y los metadatos de la última CRL emitida.",{"_3684":1593,"_21620":1552,"_18607":37174,"_5":21799,"_8577":37075,"_1666":37175},[],"`PUT`",{"_3684":1594,"_21620":1552,"_18607":37177,"_5":21799,"_8577":37075,"_1666":37169},[],{"_3684":1595,"_21620":1552,"_18607":37179,"_5":21799,"_8577":37075,"_1666":37180},[],"Actualiza los parámetros de la configuración del rol VA (`validity`, `refresh_interval`, `regenerate_on_revoke`).",{"_3684":1596,"_21620":1552,"_18607":37182,"_5":21799,"_8577":37075,"_1666":37183},[],"Ejemplo de consulta del rol VA:",{"_3684":1597,"_21620":1552,"_18607":37185,"_5":21799,"_8577":37075,"_1666":37186},[],"La respuesta incluye el campo `latest_crl` con la versión, la fecha de inicio de validez y la fecha de caducidad de la CRL actualmente publicada.",{"_3684":1598,"_21620":1552,"_18607":37188,"_5":21799,"_8577":37079,"_1666":37189},[],"Desde el panel de detalle de una CA es posible previsualizar el contenido de la CRL activa y descargarla directamente para su uso offline o para importarla en aplicaciones que realicen validación local.",{"_3684":1599,"_21620":1552,"_18607":37191,"_5":21799,"_8577":37083,"_1666":37192},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile*",{"_3684":1600,"_21620":1552,"_18607":37194,"_5":21799,"_8577":37083,"_1666":37195},[],"<Card title=\"Servicio OCSP\" href=\"/docs/manual/servicios-core/validation-ocsp\" />",{"_3684":1601,"_21620":1552,"_18607":37197,"_5":21799,"_8577":37083,"_1666":37198},[],"<Card title=\"Validación de certificados\" href=\"/docs/manual/servicios-core/validation\" />",{"_3684":1602,"_21620":1602,"_5":21794,"_1666":37200,"_21807":37201,"_18607":37202,"_8577":1602},"Validación online con OCSP",[32337,33539,34671],[],{"_3684":1603,"_21620":1602,"_18607":37204,"_5":21799,"_8577":1602,"_1666":37205},[],"Consulta en tiempo real si un certificado sigue vigente o se ha revocado.",{"_3684":1604,"_21620":1602,"_5":21804,"_18607":37207,"_8577":37208,"_1666":37209},[],"/docs/manual/servicios-core/validation-ocsp#servicio-ocsp","Servicio OCSP",{"_3684":1605,"_21620":1602,"_5":21804,"_18607":37211,"_8577":37212,"_1666":37213},[],"/docs/manual/servicios-core/validation-ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3684":1606,"_21620":1602,"_5":21804,"_18607":37215,"_8577":37216,"_1666":37217},[],"/docs/manual/servicios-core/validation-ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3684":1607,"_21620":1602,"_5":21804,"_18607":37219,"_8577":37220,"_1666":37221},[],"/docs/manual/servicios-core/validation-ocsp#endpoints-http","Endpoints HTTP",{"_3684":1608,"_21620":1602,"_5":21804,"_18607":37223,"_8577":37224,"_1666":37225},[],"/docs/manual/servicios-core/validation-ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3684":1609,"_21620":1602,"_5":21804,"_18607":37227,"_8577":37228,"_1666":37084},[],"/docs/manual/servicios-core/validation-ocsp#referencias",{"_3684":1610,"_21620":1602,"_18607":37230,"_5":21799,"_8577":37208,"_1666":37231},[],"OCSP (Online Certificate Status Protocol) es el mecanismo que permite a una parte que confía comprobar, en tiempo real, si un certificado concreto está vigente o ha sido revocado. En lugar de descargar una lista completa de certificados revocados, el cliente envía una consulta con el número de serie del certificado y recibe una respuesta firmada con el estado actual.",{"_3684":1611,"_21620":1602,"_18607":37233,"_5":21799,"_8577":37208,"_1666":37234},[],"Lamassu integra un respondedor OCSP propio que atiende estas consultas consultando directamente la base de datos interna de certificados. No se requiere ningún componente externo.",{"_3684":1612,"_21620":1602,"_18607":37236,"_5":21799,"_8577":37212,"_1666":37237},[],"Cuando un cliente solicita el estado de un certificado, el respondedor localiza el certificado por su número de serie y determina su estado según el registro interno:",{"_3684":1613,"_21620":1602,"_18607":37239,"_5":21799,"_8577":37212,"_1666":37240},[],"Si el certificado está activo, la respuesta indica `Good`.",{"_3684":1614,"_21620":1602,"_18607":37242,"_5":21799,"_8577":37212,"_1666":37243},[],"Si el certificado ha sido revocado, la respuesta indica `Revoked` e incluye la marca de tiempo de revocación y el código de razón conforme a RFC 5280.",{"_3684":1615,"_21620":1602,"_18607":37245,"_5":21799,"_8577":37212,"_1666":37246},[],"Si el número de serie no se encuentra o el estado no es reconocible, la respuesta indica `Unknown`.",{"_3684":1616,"_21620":1602,"_18607":37248,"_5":21799,"_8577":37212,"_1666":37249},[],"La respuesta OCSP es firmada por la CA emisora del certificado consultado, utilizando el motor criptográfico asociado a esa CA. Lamassu no utiliza un certificado delegado de firma OCSP: la CA actúa directamente como respondedor.",{"_3684":1617,"_21620":1602,"_18607":37251,"_5":21799,"_8577":37212,"_1666":37252},[],"Cada respuesta tiene una ventana de validez de 24 horas, reflejada en los campos `thisUpdate` y `nextUpdate` de la respuesta. Los clientes que cacheen respuestas deben tener en cuenta esta ventana al determinar durante cuánto tiempo una respuesta sigue siendo válida.",{"_3684":1618,"_21620":1602,"_18607":37254,"_5":21799,"_8577":37216,"_1666":37255},[],"La URL del respondedor OCSP se incorpora automáticamente en la extensión AIA (*Authority Information Access*) de todos los certificados emitidos por Lamassu. Los clientes que verifican certificados pueden leer esta URL directamente del certificado sin necesidad de configuración adicional.",{"_3684":1619,"_21620":1602,"_18607":37257,"_5":21799,"_8577":37220,"_1666":37258},[],"El respondedor acepta consultas en dos formatos, ambos definidos en RFC 6960:",{"_3684":1620,"_21620":1602,"_18607":37260,"_5":21799,"_8577":37220,"_1666":35132},[],{"_3684":1621,"_21620":1602,"_18607":37262,"_5":21799,"_8577":37220,"_1666":37161},[],{"_3684":1622,"_21620":1602,"_18607":37264,"_5":21799,"_8577":37220,"_1666":32646},[],{"_3684":1623,"_21620":1602,"_18607":37266,"_5":21799,"_8577":37220,"_1666":37166},[],{"_3684":1624,"_21620":1602,"_18607":37268,"_5":21799,"_8577":37220,"_1666":37269},[],"`/ocsp/{ocsp_request}`",{"_3684":1625,"_21620":1602,"_18607":37271,"_5":21799,"_8577":37220,"_1666":37272},[],"La petición OCSP va codificada en Base64url en la propia URL.",{"_3684":1626,"_21620":1602,"_18607":37274,"_5":21799,"_8577":37220,"_1666":37275},[],"`POST`",{"_3684":1627,"_21620":1602,"_18607":37277,"_5":21799,"_8577":37220,"_1666":37278},[],"`/ocsp`",{"_3684":1628,"_21620":1602,"_18607":37280,"_5":21799,"_8577":37220,"_1666":37281},[],"La petición OCSP va en el cuerpo de la petición con `Content-Type: application/ocsp-request`.",{"_3684":1629,"_21620":1602,"_18607":37283,"_5":21799,"_8577":37220,"_1666":37284},[],"Ejemplo de consulta con `curl` mediante POST:",{"_3684":1630,"_21620":1602,"_18607":37286,"_5":21799,"_8577":37220,"_1666":37287},[],"La respuesta tiene `Content-Type: application/ocsp-response` y contiene la respuesta OCSP en formato DER.",{"_3684":1631,"_21620":1602,"_18607":37289,"_5":21799,"_8577":37224,"_1666":37290},[],"Desde la pantalla de certificados de Lamassu es posible lanzar una petición OCSP directamente sobre el certificado seleccionado mediante la acción **OCSP Check**. Esta acción muestra el estado devuelto por el respondedor sin necesidad de herramientas externas.",{"_3684":1632,"_21620":1602,"_18607":37292,"_5":21799,"_8577":37228,"_1666":37293},[],"RFC 6960 - *X.509 Internet Public Key Infrastructure Online Certificate Status Protocol – OCSP*",{"_3684":1633,"_21620":1602,"_18607":37295,"_5":21799,"_8577":37228,"_1666":37296},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile* (razones de revocación, sección 5.3.1)",{"_3684":1634,"_21620":1602,"_18607":37298,"_5":21799,"_8577":37228,"_1666":37299},[],"<Card title=\"Servicio CRL\" href=\"/docs/manual/servicios-core/validation-crl\" />",{"_3684":1635,"_21620":1602,"_18607":37301,"_5":21799,"_8577":37228,"_1666":37198},[],{"_3684":1636,"_21620":1636,"_5":21794,"_1666":37303,"_21807":37304,"_18607":37305,"_8577":1636},"Validación de certificados",[32337,33539,34671],[],{"_3684":1637,"_21620":1636,"_18607":37307,"_5":21799,"_8577":1636,"_1666":37308},[],"Publica el estado de las identidades mediante OCSP y CRL.",{"_3684":1638,"_21620":1636,"_5":21804,"_18607":37310,"_8577":37311,"_1666":37312},[],"/docs/manual/servicios-core/validation#elige-un-mecanismo","Elige un mecanismo",{"_3684":1639,"_21620":1636,"_18607":37314,"_5":21799,"_8577":1636,"_1666":37315},[],"La emisión demuestra quién firmó un certificado; la validación permite saber si todavía debe aceptarse. Lamassu publica el estado mediante dos mecanismos complementarios.",{"_3684":1640,"_21620":1636,"_18607":37317,"_5":21799,"_8577":37311,"_1666":37318},[],"Mecanismo",{"_3684":1641,"_21620":1636,"_18607":37320,"_5":21799,"_8577":37311,"_1666":32459},[],{"_3684":1642,"_21620":1636,"_18607":37322,"_5":21799,"_8577":37311,"_1666":32462},[],{"_3684":1643,"_21620":1636,"_18607":37324,"_5":21799,"_8577":37311,"_1666":37325},[],"OCSP",{"_3684":1644,"_21620":1636,"_18607":37327,"_5":21799,"_8577":37311,"_1666":37328},[],"Consulta online de un certificado concreto",{"_3684":1645,"_21620":1636,"_18607":37330,"_5":21799,"_8577":37311,"_1666":37331},[],"Consumidores conectados que necesitan el estado más reciente.",{"_3684":1646,"_21620":1636,"_18607":37333,"_5":21799,"_8577":37311,"_1666":37334},[],"CRL",{"_3684":1647,"_21620":1636,"_18607":37336,"_5":21799,"_8577":37311,"_1666":37337},[],"Descarga periódica de una lista firmada",{"_3684":1648,"_21620":1636,"_18607":37339,"_5":21799,"_8577":37311,"_1666":37340},[],"Entornos offline, redes limitadas o validación local masiva.",{"_3684":1649,"_21620":1636,"_18607":37342,"_5":21799,"_8577":37311,"_1666":37343},[],"Muchos entornos utilizan ambos: OCSP como comprobación primaria y CRL como mecanismo local o de respaldo.",{"_3684":1650,"_21620":1636,"_18607":37345,"_5":21799,"_8577":37311,"_1666":37346},[],"<Card title=\"Validación online con OCSP\" description=\"Consulta estados Good, Revoked y Unknown en tiempo real.\" href=\"/docs/manual/servicios-core/validation-ocsp\" />",{"_3684":1651,"_21620":1636,"_18607":37348,"_5":21799,"_8577":37311,"_1666":37349},[],"<Card title=\"Listas de revocación\" description=\"Genera, publica y distribuye CRLs por autoridad.\" href=\"/docs/manual/servicios-core/validation-crl\" />",{"_3684":1652,"_21620":1652,"_5":21794,"_1666":37351,"_18607":37352,"_8577":1652},"Test",[],{"_3684":1653,"_21620":1652,"_18607":37354,"_5":21799,"_8577":1652,"_1666":37355},[],"A document to test Fumadocs",{"_3684":1654,"_21620":1652,"_5":21804,"_18607":37357,"_8577":37358,"_1666":37359},[],"/docs/test#cards","Cards",{"_3684":1655,"_21620":1652,"_5":21804,"_18607":37361,"_8577":37362,"_1666":37363},[],"/docs/test#co