59939,"_41330":59942,"_41332":59945,"_41334":59948,"_41336":59951,"_41338":59954,"_41340":59957,"_41342":59960,"_41344":59963,"_41346":59966,"_41348":59969,"_41350":59972,"_41352":59975,"_41354":59978,"_41357":59981,"_41359":59984,"_41361":59987,"_41363":59990,"_41365":59993,"_41367":59996,"_41369":59999,"_41371":60002,"_41373":60005,"_41375":60008,"_41377":60011,"_41379":60014,"_41381":60017,"_41383":60020,"_41385":60023,"_41387":60026,"_41389":60029,"_41391":60032,"_41393":60035,"_41395":60038,"_41397":60041,"_41399":60044,"_41401":60047,"_41403":60050,"_41405":60053,"_41407":60056,"_41409":60059,"_41411":60062,"_41413":60065,"_41415":60068,"_41417":60071,"_41419":60074,"_41422":60077,"_41424":60080,"_41426":60083,"_41428":60086},{"_3602":15,"_30987":15,"_5":15110,"_3058":50621,"_31325":50622,"_21467":50626,"_28174":15},"Deploy from AWS Marketplace",[50623,50624,50625],"Docs","Deployment","Other models",[],{"_3602":16,"_30987":15,"_21467":50628,"_5":14750,"_28174":15,"_3058":50629},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3602":17,"_30987":15,"_5":31322,"_21467":50631,"_28174":50632,"_3058":50633},[],"/docs/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3602":18,"_30987":15,"_5":31322,"_21467":50635,"_28174":50636,"_3058":50637},[],"/docs/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3602":19,"_30987":15,"_5":31322,"_21467":50639,"_28174":50640,"_3058":50641},[],"/docs/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3602":20,"_30987":15,"_5":31322,"_21467":50643,"_28174":50644,"_3058":50645},[],"/docs/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3602":21,"_30987":15,"_5":31322,"_21467":50647,"_28174":50648,"_3058":50649},[],"/docs/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3602":22,"_30987":15,"_5":31322,"_21467":50651,"_28174":50652,"_3058":50653},[],"/docs/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3602":23,"_30987":15,"_5":31322,"_21467":50655,"_28174":50656,"_3058":50657},[],"/docs/deployment/aws-marketplace#next-step","Next step",{"_3602":24,"_30987":15,"_21467":50659,"_5":14750,"_28174":15,"_3058":50660},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3602":25,"_30987":15,"_21467":50662,"_5":14750,"_28174":50632,"_3058":50663},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3602":26,"_30987":15,"_21467":50665,"_5":14750,"_28174":50632,"_3058":50666},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3602":27,"_30987":15,"_21467":50668,"_5":14750,"_28174":50632,"_3058":50669},[],"A security group allowing the necessary endpoints.",{"_3602":28,"_30987":15,"_21467":50671,"_5":14750,"_28174":50636,"_3058":50672},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3602":29,"_30987":15,"_21467":50674,"_5":14750,"_28174":50636,"_3058":50675},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3602":30,"_30987":15,"_21467":50677,"_5":14750,"_28174":50636,"_3058":50678},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3602":31,"_30987":15,"_21467":50680,"_5":14750,"_28174":50640,"_3058":50681},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3602":32,"_30987":15,"_21467":50683,"_5":14750,"_28174":50644,"_3058":50684},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3602":33,"_30987":15,"_21467":50686,"_5":14750,"_28174":50648,"_3058":50687},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3602":34,"_30987":15,"_21467":50689,"_5":14750,"_28174":50652,"_3058":50690},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3602":35,"_30987":15,"_21467":50692,"_5":14750,"_28174":50656,"_3058":50693},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3602":36,"_30987":36,"_5":15110,"_3058":50695,"_31325":50696,"_21467":50697,"_28174":36},"Deploy Lamassu",[50623,50624],[],{"_3602":37,"_30987":36,"_21467":50699,"_5":14750,"_28174":36,"_3058":50700},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3602":38,"_30987":36,"_5":31322,"_21467":50702,"_28174":50703,"_3058":50704},[],"/docs/deployment/overview#choose-a-model","Choose a model",{"_3602":39,"_30987":36,"_5":31322,"_21467":50706,"_28174":50707,"_3058":50708},[],"/docs/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3602":40,"_30987":36,"_5":31322,"_21467":50710,"_28174":50711,"_3058":50712},[],"/docs/deployment/overview#after-deployment","After deployment",{"_3602":41,"_30987":36,"_21467":50714,"_5":14750,"_28174":36,"_3058":50715},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3602":42,"_30987":36,"_21467":50717,"_5":14750,"_28174":50703,"_3058":50718},[],"Model",{"_3602":43,"_30987":36,"_21467":50720,"_5":14750,"_28174":50703,"_3058":50721},[],"Recommended for",{"_3602":44,"_30987":36,"_21467":50723,"_5":14750,"_28174":50703,"_3058":50724},[],"Who operates the infrastructure",{"_3602":45,"_30987":36,"_21467":50726,"_5":14750,"_28174":50703,"_3058":50727},[],"Starting point",{"_3602":46,"_30987":36,"_21467":50729,"_5":14750,"_28174":50703,"_3058":50730},[],"Kubernetes self-managed",{"_3602":47,"_30987":36,"_21467":50732,"_5":14750,"_28174":50703,"_3058":50733},[],"Production, regulated environments and custom deployments",{"_3602":48,"_30987":36,"_21467":50735,"_5":14750,"_28174":50703,"_3058":50736},[],"Your team",{"_3602":49,"_30987":36,"_21467":50738,"_5":14750,"_28174":50703,"_3058":50739},[],"Helm or Fastlane",{"_3602":50,"_30987":36,"_21467":50741,"_5":14750,"_28174":50703,"_3058":50742},[],"AWS Marketplace",{"_3602":51,"_30987":36,"_21467":50744,"_5":14750,"_28174":50703,"_3058":50745},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3602":52,"_30987":36,"_21467":50747,"_5":14750,"_28174":50703,"_3058":50736},[],{"_3602":53,"_30987":36,"_21467":50749,"_5":14750,"_28174":50703,"_3058":50750},[],"Preconfigured image on EC2",{"_3602":54,"_30987":36,"_21467":50752,"_5":14750,"_28174":50703,"_3058":50753},[],"SaaS",{"_3602":55,"_30987":36,"_21467":50755,"_5":14750,"_28174":50703,"_3058":50756},[],"Teams that want to use the platform without operating it",{"_3602":56,"_30987":36,"_21467":50758,"_5":14750,"_28174":50703,"_3058":50759},[],"Lamassu",{"_3602":57,"_30987":36,"_21467":50761,"_5":14750,"_28174":50703,"_3058":50762},[],"Managed subscription",{"_3602":58,"_30987":36,"_21467":50764,"_5":14750,"_28174":50703,"_3058":50765},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3602":59,"_30987":36,"_21467":50767,"_5":14750,"_28174":50703,"_3058":50768},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3602":60,"_30987":36,"_21467":50770,"_5":14750,"_28174":50703,"_3058":50771},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3602":61,"_30987":36,"_21467":50773,"_5":14750,"_28174":50707,"_3058":50774},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3602":62,"_30987":36,"_21467":50776,"_5":14750,"_28174":50711,"_3058":50777},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3602":63,"_30987":63,"_5":15110,"_3058":50779,"_31325":50780,"_21467":50781,"_28174":63},"Use Lamassu as SaaS",[50623,50624,50625],[],{"_3602":64,"_30987":63,"_21467":50783,"_5":14750,"_28174":63,"_3058":50784},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3602":65,"_30987":63,"_5":31322,"_21467":50786,"_28174":50787,"_3058":50788},[],"/docs/deployment/saas#what-the-service-manages","What the service manages",{"_3602":66,"_30987":63,"_5":31322,"_21467":50790,"_28174":50791,"_3058":50792},[],"/docs/deployment/saas#plans","Plans",{"_3602":67,"_30987":63,"_5":31322,"_21467":50794,"_28174":50795,"_3058":50796},[],"/docs/deployment/saas#request-access","Request access",{"_3602":68,"_30987":63,"_21467":50798,"_5":14750,"_28174":63,"_3058":50799},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3602":69,"_30987":63,"_21467":50801,"_5":14750,"_28174":50787,"_3058":50802},[],"Platform availability and maintenance.",{"_3602":70,"_30987":63,"_21467":50804,"_5":14750,"_28174":50787,"_3058":50805},[],"Automatic backups.",{"_3602":71,"_30987":63,"_21467":50807,"_5":14750,"_28174":50787,"_3058":50808},[],"Version upgrades.",{"_3602":72,"_30987":63,"_21467":50810,"_5":14750,"_28174":50787,"_3058":50811},[],"Technical support and SLA according to your plan.",{"_3602":73,"_30987":63,"_21467":50813,"_5":14750,"_28174":50791,"_3058":50814},[],"Plan",{"_3602":74,"_30987":63,"_21467":50816,"_5":14750,"_28174":50791,"_3058":50817},[],"Devices",{"_3602":75,"_30987":63,"_21467":50819,"_5":14750,"_28174":50791,"_3058":50820},[],"Support",{"_3602":76,"_30987":63,"_21467":50822,"_5":14750,"_28174":50791,"_3058":50823},[],"SLA",{"_3602":77,"_30987":63,"_21467":50825,"_5":14750,"_28174":50791,"_3058":50826},[],"Starter",{"_3602":78,"_30987":63,"_21467":50828,"_5":14750,"_28174":50791,"_3058":50829},[],"Up to 1,000",{"_3602":79,"_30987":63,"_21467":50831,"_5":14750,"_28174":50791,"_3058":50832},[],"Email",{"_3602":80,"_30987":63,"_21467":50834,"_5":14750,"_28174":50791,"_3058":50835},[],"99.5 %",{"_3602":81,"_30987":63,"_21467":50837,"_5":14750,"_28174":50791,"_3058":50838},[],"Professional",{"_3602":82,"_30987":63,"_21467":50840,"_5":14750,"_28174":50791,"_3058":50841},[],"Up to 10,000",{"_3602":83,"_30987":63,"_21467":50843,"_5":14750,"_28174":50791,"_3058":50844},[],"Email and chat",{"_3602":84,"_30987":63,"_21467":50846,"_5":14750,"_28174":50791,"_3058":50847},[],"99.9 %",{"_3602":85,"_30987":63,"_21467":50849,"_5":14750,"_28174":50791,"_3058":50850},[],"Enterprise",{"_3602":86,"_30987":63,"_21467":50852,"_5":14750,"_28174":50791,"_3058":50853},[],"Unlimited",{"_3602":87,"_30987":63,"_21467":50855,"_5":14750,"_28174":50791,"_3058":50856},[],"Dedicated",{"_3602":88,"_30987":63,"_21467":50858,"_5":14750,"_28174":50791,"_3058":50859},[],"99.99 %",{"_3602":89,"_30987":63,"_21467":50861,"_5":14750,"_28174":50795,"_3058":50862},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3602":90,"_30987":63,"_21467":50864,"_5":14750,"_28174":50795,"_3058":50865},[],"When you receive your instance's credentials, continue with Get started.",{"_3602":91,"_30987":91,"_5":15110,"_3058":50867,"_31325":50868,"_21467":50869,"_28174":91},"Fastlane",[50623,50624,50730],[],{"_3602":92,"_30987":91,"_21467":50871,"_5":14750,"_28174":91,"_3058":50872},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3602":93,"_30987":91,"_5":31322,"_21467":50874,"_28174":50875,"_3058":50876},[],"/docs/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3602":94,"_30987":91,"_5":31322,"_21467":50878,"_28174":50879,"_3058":50880},[],"/docs/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3602":95,"_30987":91,"_5":31322,"_21467":50882,"_28174":50883,"_3058":50633},[],"/docs/deployment/self-hosted/fastlane#before-you-begin",{"_3602":96,"_30987":91,"_5":31322,"_21467":50885,"_28174":50886,"_3058":50887},[],"/docs/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3602":97,"_30987":91,"_5":31322,"_21467":50889,"_28174":50890,"_3058":50891},[],"/docs/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3602":98,"_30987":91,"_5":31322,"_21467":50893,"_28174":50894,"_3058":50895},[],"/docs/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3602":99,"_30987":91,"_5":31322,"_21467":50897,"_28174":50898,"_3058":50899},[],"/docs/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3602":100,"_30987":91,"_5":31322,"_21467":50901,"_28174":50902,"_3058":50903},[],"/docs/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3602":101,"_30987":91,"_5":31322,"_21467":50905,"_28174":50906,"_3058":50907},[],"/docs/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3602":102,"_30987":91,"_5":31322,"_21467":50909,"_28174":50910,"_3058":50911},[],"/docs/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3602":103,"_30987":91,"_5":31322,"_21467":50913,"_28174":50914,"_3058":50915},[],"/docs/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3602":104,"_30987":91,"_21467":50917,"_5":14750,"_28174":50875,"_3058":50918},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3602":105,"_30987":91,"_21467":50920,"_5":14750,"_28174":50875,"_3058":50921},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3602":106,"_30987":91,"_21467":50923,"_5":14750,"_28174":50879,"_3058":50924},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3602":107,"_30987":91,"_21467":50926,"_5":14750,"_28174":50879,"_3058":50927},[],"Fastlane installs or configures",{"_3602":108,"_30987":91,"_21467":50929,"_5":14750,"_28174":50879,"_3058":50930},[],"You still provide",{"_3602":109,"_30987":91,"_21467":50932,"_5":14750,"_28174":50879,"_3058":50933},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3602":110,"_30987":91,"_21467":50935,"_5":14750,"_28174":50879,"_3058":50936},[],"The Kubernetes cluster, nodes and persistent storage",{"_3602":111,"_30987":91,"_21467":50938,"_5":14750,"_28174":50879,"_3058":50939},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3602":112,"_30987":91,"_21467":50941,"_5":14750,"_28174":50879,"_3058":50942},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3602":113,"_30987":91,"_21467":50944,"_5":14750,"_28174":50879,"_3058":50945},[],"A self-signed Lamassu certificate flow, dependency credentials stored in Kubernetes Secrets (through the External Secrets Operator) and an initial user",{"_3602":114,"_30987":91,"_21467":50947,"_5":14750,"_28174":50879,"_3058":50948},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3602":115,"_30987":91,"_21467":50950,"_5":14750,"_28174":50879,"_3058":50951},[],"Optional observability and lab HSM components",{"_3602":116,"_30987":91,"_21467":50953,"_5":14750,"_28174":50879,"_3058":50954},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3602":117,"_30987":91,"_21467":50956,"_5":14750,"_28174":50879,"_3058":50957},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3602":118,"_30987":91,"_21467":50959,"_5":14750,"_28174":50883,"_3058":50960},[],"You need:",{"_3602":119,"_30987":91,"_21467":50962,"_5":14750,"_28174":50883,"_3058":50963},[],"an existing Kubernetes cluster",{"_3602":120,"_30987":91,"_21467":50965,"_5":14750,"_28174":50883,"_3058":50966},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3602":121,"_30987":91,"_21467":50968,"_5":14750,"_28174":50883,"_3058":50969},[],"`yq`",{"_3602":122,"_30987":91,"_21467":50971,"_5":14750,"_28174":50883,"_3058":24268},[],{"_3602":123,"_30987":91,"_21467":50973,"_5":14750,"_28174":50883,"_3058":50974},[],"`jq` only when using `--sample-data` or `--development`",{"_3602":124,"_30987":91,"_21467":50976,"_5":14750,"_28174":50883,"_3058":50977},[],"`ssh-keygen` only when using `--with-hsm`",{"_3602":125,"_30987":91,"_21467":50979,"_5":14750,"_28174":50883,"_3058":50980},[],"free external ports 80 and 443 on a single-node K3s host",{"_3602":126,"_30987":91,"_21467":50982,"_5":14750,"_28174":50883,"_3058":50983},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3602":127,"_30987":91,"_21467":50985,"_5":14750,"_28174":50883,"_3058":50986},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3602":128,"_30987":91,"_21467":50988,"_5":14750,"_28174":50886,"_3058":50989},[],"Run the script from a clone of the Helm repository:",{"_3602":129,"_30987":91,"_21467":50991,"_5":14750,"_28174":50886,"_3058":50992},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3602":130,"_30987":91,"_21467":50994,"_5":14750,"_28174":50890,"_3058":50995},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3602":131,"_30987":91,"_21467":50997,"_5":14750,"_28174":50890,"_3058":50998},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3602":132,"_30987":91,"_21467":51000,"_5":14750,"_28174":50890,"_3058":51001},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3602":133,"_30987":91,"_21467":51003,"_5":14750,"_28174":50890,"_3058":51004},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3602":134,"_30987":91,"_21467":51006,"_5":14750,"_28174":50894,"_3058":51007},[],"Option",{"_3602":135,"_30987":91,"_21467":51009,"_5":14750,"_28174":50894,"_3058":51010},[],"Default",{"_3602":136,"_30987":91,"_21467":51012,"_5":14750,"_28174":50894,"_3058":51013},[],"Purpose",{"_3602":137,"_30987":91,"_21467":51015,"_5":14750,"_28174":50894,"_3058":51016},[],"`-h`, `--help`",{"_3602":138,"_30987":91,"_21467":51018,"_5":14750,"_28174":50894,"_3058":51019},[],"—",{"_3602":139,"_30987":91,"_21467":51021,"_5":14750,"_28174":50894,"_3058":51022},[],"Show help",{"_3602":140,"_30987":91,"_21467":51024,"_5":14750,"_28174":50894,"_3058":51025},[],"`-c`, `--context`",{"_3602":141,"_30987":91,"_21467":51027,"_5":14750,"_28174":50894,"_3058":51028},[],"current context",{"_3602":142,"_30987":91,"_21467":51030,"_5":14750,"_28174":50894,"_3058":51031},[],"Select the kubeconfig context for kubectl and Helm",{"_3602":143,"_30987":91,"_21467":51033,"_5":14750,"_28174":50894,"_3058":51034},[],"`-n`, `--non-interactive`",{"_3602":144,"_30987":91,"_21467":51036,"_5":14750,"_28174":50894,"_3058":6759},[],{"_3602":145,"_30987":91,"_21467":51038,"_5":14750,"_28174":50894,"_3058":51039},[],"Skip prompts and generate dependency credentials",{"_3602":146,"_30987":91,"_21467":51041,"_5":14750,"_28174":50894,"_3058":51042},[],"`-ns`, `--namespace`",{"_3602":147,"_30987":91,"_21467":51044,"_5":14750,"_28174":50894,"_3058":51045},[],"`lamassu-dev`",{"_3602":148,"_30987":91,"_21467":51047,"_5":14750,"_28174":50894,"_3058":51048},[],"Namespace for the installation",{"_3602":149,"_30987":91,"_21467":51050,"_5":14750,"_28174":50894,"_3058":51051},[],"`-d`, `--domain`",{"_3602":150,"_30987":91,"_21467":51053,"_5":14750,"_28174":50894,"_3058":51054},[],"`dev.lamassu.io`",{"_3602":151,"_30987":91,"_21467":51056,"_5":14750,"_28174":50894,"_3058":51057},[],"Domain used by the UI, OIDC and certificate",{"_3602":152,"_30987":91,"_21467":51059,"_5":14750,"_28174":50894,"_3058":51060},[],"`-v`, `--version`",{"_3602":153,"_30987":91,"_21467":51062,"_5":14750,"_28174":50894,"_3058":15461},[],{"_3602":154,"_30987":91,"_21467":51064,"_5":14750,"_28174":50894,"_3058":51065},[],"Lamassu chart version",{"_3602":155,"_30987":91,"_21467":51067,"_5":14750,"_28174":50894,"_3058":51068},[],"`--https-port`",{"_3602":156,"_30987":91,"_21467":51070,"_5":14750,"_28174":50894,"_3058":51071},[],"`443`",{"_3602":157,"_30987":91,"_21467":51073,"_5":14750,"_28174":50894,"_3058":51074},[],"Gateway HTTPS listener port",{"_3602":158,"_30987":91,"_21467":51076,"_5":14750,"_28174":50894,"_3058":51077},[],"`--http-port`",{"_3602":159,"_30987":91,"_21467":51079,"_5":14750,"_28174":50894,"_3058":51080},[],"`80`",{"_3602":160,"_30987":91,"_21467":51082,"_5":14750,"_28174":50894,"_3058":51083},[],"Gateway HTTP listener port",{"_3602":161,"_30987":91,"_21467":51085,"_5":14750,"_28174":50894,"_3058":51086},[],"`--tls-crt`",{"_3602":162,"_30987":91,"_21467":51088,"_5":14750,"_28174":50894,"_3058":51019},[],{"_3602":163,"_30987":91,"_21467":51090,"_5":14750,"_28174":50894,"_3058":51091},[],"PEM certificate for downstream TLS",{"_3602":164,"_30987":91,"_21467":51093,"_5":14750,"_28174":50894,"_3058":51094},[],"`--tls-key`",{"_3602":165,"_30987":91,"_21467":51096,"_5":14750,"_28174":50894,"_3058":51019},[],{"_3602":166,"_30987":91,"_21467":51098,"_5":14750,"_28174":50894,"_3058":51099},[],"PEM private key for downstream TLS",{"_3602":167,"_30987":91,"_21467":51101,"_5":14750,"_28174":50894,"_3058":51102},[],"`-l`, `--local-chart-path`",{"_3602":168,"_30987":91,"_21467":51104,"_5":14750,"_28174":50894,"_3058":51105},[],"repository chart",{"_3602":169,"_30987":91,"_21467":51107,"_5":14750,"_28174":50894,"_3058":51108},[],"Use an unpacked local Lamassu chart",{"_3602":170,"_30987":91,"_21467":51110,"_5":14750,"_28174":50894,"_3058":51111},[],"`-ip`, `--gateway-ip`",{"_3602":171,"_30987":91,"_21467":51113,"_5":14750,"_28174":50894,"_3058":9027},[],{"_3602":172,"_30987":91,"_21467":51115,"_5":14750,"_28174":50894,"_3058":51116},[],"Override the address written to `gateway.addresses`",{"_3602":173,"_30987":91,"_21467":51118,"_5":14750,"_28174":50894,"_3058":51119},[],"`--otel`",{"_3602":174,"_30987":91,"_21467":51121,"_5":14750,"_28174":50894,"_3058":6759},[],{"_3602":175,"_30987":91,"_21467":51123,"_5":14750,"_28174":50894,"_3058":51124},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3602":176,"_30987":91,"_21467":51126,"_5":14750,"_28174":50894,"_3058":51127},[],"`--development`",{"_3602":177,"_30987":91,"_21467":51129,"_5":14750,"_28174":50894,"_3058":6759},[],{"_3602":178,"_30987":91,"_21467":51131,"_5":14750,"_28174":50894,"_3058":51132},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3602":179,"_30987":91,"_21467":51134,"_5":14750,"_28174":50894,"_3058":51135},[],"`--sample-data`",{"_3602":180,"_30987":91,"_21467":51137,"_5":14750,"_28174":50894,"_3058":6759},[],{"_3602":181,"_30987":91,"_21467":51139,"_5":14750,"_28174":50894,"_3058":51140},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3602":182,"_30987":91,"_21467":51142,"_5":14750,"_28174":50894,"_3058":51143},[],"`--with-hsm`",{"_3602":183,"_30987":91,"_21467":51145,"_5":14750,"_28174":50894,"_3058":6759},[],{"_3602":184,"_30987":91,"_21467":51147,"_5":14750,"_28174":50894,"_3058":51148},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3602":185,"_30987":91,"_21467":51150,"_5":14750,"_28174":50894,"_3058":51151},[],"`--softhsm-chart-path`",{"_3602":186,"_30987":91,"_21467":51153,"_5":14750,"_28174":50894,"_3058":51154},[],"`./charts/softhsm`",{"_3602":187,"_30987":91,"_21467":51156,"_5":14750,"_28174":50894,"_3058":51157},[],"Use a different local SoftHSM chart",{"_3602":188,"_30987":91,"_21467":51159,"_5":14750,"_28174":50894,"_3058":51160},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3602":189,"_30987":91,"_21467":51162,"_5":14750,"_28174":50898,"_3058":51163},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3602":190,"_30987":91,"_21467":51165,"_5":14750,"_28174":50898,"_3058":51166},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3602":191,"_30987":91,"_21467":51168,"_5":14750,"_28174":50898,"_3058":51169},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3602":192,"_30987":91,"_21467":51171,"_5":14750,"_28174":50898,"_3058":51172},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3602":193,"_30987":91,"_21467":51174,"_5":14750,"_28174":50898,"_3058":51175},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3602":194,"_30987":91,"_21467":51177,"_5":14750,"_28174":50898,"_3058":51178},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3602":195,"_30987":91,"_21467":51180,"_5":14750,"_28174":50902,"_3058":51181},[],"Fastlane:",{"_3602":196,"_30987":91,"_21467":51183,"_5":14750,"_28174":50902,"_3058":51184},[],"validates local tools and the selected cluster",{"_3602":197,"_30987":91,"_21467":51186,"_5":14750,"_28174":50902,"_3058":51187},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3602":198,"_30987":91,"_21467":51189,"_5":14750,"_28174":50902,"_3058":51190},[],"creates the namespace",{"_3602":199,"_30987":91,"_21467":51192,"_5":14750,"_28174":50902,"_3058":51193},[],"installs the External Secrets Operator and creates the PostgreSQL, RabbitMQ and Keycloak administrator credentials as Secrets through a Fake `ClusterSecretStore`",{"_3602":200,"_30987":91,"_21467":51195,"_5":14750,"_28174":50902,"_3058":51196},[],"installs PostgreSQL and creates the required databases",{"_3602":201,"_30987":91,"_21467":51198,"_5":14750,"_28174":50902,"_3058":51199},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3602":202,"_30987":91,"_21467":51201,"_5":14750,"_28174":50902,"_3058":51202},[],"installs RabbitMQ",{"_3602":203,"_30987":91,"_21467":51204,"_5":14750,"_28174":50902,"_3058":51205},[],"optionally installs observability and lab HSM components",{"_3602":204,"_30987":91,"_21467":51207,"_5":14750,"_28174":50902,"_3058":51208},[],"generates `lamassu.yaml`, which references the Secrets instead of inline credentials, and installs the Lamassu chart",{"_3602":205,"_30987":91,"_21467":51210,"_5":14750,"_28174":50902,"_3058":51211},[],"optionally loads sample data",{"_3602":206,"_30987":91,"_21467":51213,"_5":14750,"_28174":50902,"_3058":51214},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3602":207,"_30987":91,"_21467":51216,"_5":14750,"_28174":50906,"_3058":51217},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3602":208,"_30987":91,"_21467":51219,"_5":14750,"_28174":50906,"_3058":51220},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3602":209,"_30987":91,"_21467":51222,"_5":14750,"_28174":50910,"_3058":51223},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords and stores them in Kubernetes Secrets through the External Secrets Operator's Fake `ClusterSecretStore`. Fastlane writes `lamassu.yaml` in the current directory referencing those Secrets — the values file no longer contains the credentials.",{"_3602":210,"_30987":91,"_21467":51225,"_5":14750,"_28174":50910,"_3058":51226},[],"The Keycloak administrator password is not printed by the script. Retrieve it from the Secret when needed:",{"_3602":211,"_30987":91,"_21467":51228,"_5":14750,"_28174":50910,"_3058":51229},[],"The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3602":212,"_30987":91,"_21467":51231,"_5":14750,"_28174":50910,"_3058":51232},[],"The Fake `ClusterSecretStore` stores the credentials in plain text and is for lab use only: replace it with a real ESO provider for anything beyond a throwaway environment. Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3602":213,"_30987":91,"_21467":51234,"_5":14750,"_28174":50914,"_3058":51235},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3602":214,"_30987":214,"_5":15110,"_3058":51237,"_31325":51238,"_21467":51239,"_28174":214},"Install with Helm",[50623,50624,50730],[],{"_3602":215,"_30987":214,"_21467":51241,"_5":14750,"_28174":214,"_3058":51242},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3602":216,"_30987":214,"_5":31322,"_21467":51244,"_28174":51245,"_3058":51246},[],"/docs/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3602":217,"_30987":214,"_5":31322,"_21467":51248,"_28174":51249,"_3058":50633},[],"/docs/deployment/self-hosted/helm#before-you-begin",{"_3602":218,"_30987":214,"_5":31322,"_21467":51251,"_28174":51252,"_3058":51253},[],"/docs/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3602":219,"_30987":214,"_5":31322,"_21467":51255,"_28174":51256,"_3058":51257},[],"/docs/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3602":220,"_30987":214,"_5":31322,"_21467":51259,"_28174":51260,"_3058":51261},[],"/docs/deployment/self-hosted/helm#credentials-in-kubernetes-secrets","Credentials in Kubernetes Secrets",{"_3602":221,"_30987":214,"_5":31322,"_21467":51263,"_28174":51264,"_3058":51265},[],"/docs/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3602":222,"_30987":214,"_5":31322,"_21467":51267,"_28174":51268,"_3058":51269},[],"/docs/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3602":223,"_30987":214,"_5":31322,"_21467":51271,"_28174":51272,"_3058":51273},[],"/docs/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3602":224,"_30987":214,"_5":31322,"_21467":51275,"_28174":51276,"_3058":51277},[],"/docs/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3602":225,"_30987":214,"_5":31322,"_21467":51279,"_28174":51280,"_3058":51281},[],"/docs/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3602":226,"_30987":214,"_5":31322,"_21467":51283,"_28174":51284,"_3058":51285},[],"/docs/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3602":227,"_30987":214,"_5":31322,"_21467":51287,"_28174":51288,"_3058":51289},[],"/docs/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3602":228,"_30987":214,"_21467":51291,"_5":14750,"_28174":51245,"_3058":51292},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3602":229,"_30987":214,"_21467":51294,"_5":14750,"_28174":51249,"_3058":51295},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3602":230,"_30987":214,"_21467":51297,"_5":14750,"_28174":51249,"_3058":51298},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3602":231,"_30987":214,"_21467":51300,"_5":14750,"_28174":51249,"_3058":51301},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3602":232,"_30987":214,"_21467":51303,"_5":14750,"_28174":51249,"_3058":51304},[],"a reachable RabbitMQ broker and credentials",{"_3602":233,"_30987":214,"_21467":51306,"_5":14750,"_28174":51249,"_3058":51307},[],"Kubernetes Secrets in the release namespace holding the PostgreSQL and RabbitMQ credentials (and SMTP credentials when SMTP authentication is required) — the chart reads credentials from Secrets and rejects inline values (see Credentials in Kubernetes Secrets)",{"_3602":234,"_30987":214,"_21467":51309,"_5":14750,"_28174":51249,"_3058":51310},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3602":235,"_30987":214,"_21467":51312,"_5":14750,"_28174":51249,"_3058":51313},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3602":236,"_30987":214,"_21467":51315,"_5":14750,"_28174":51249,"_3058":51316},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3602":237,"_30987":214,"_21467":51318,"_5":14750,"_28174":51249,"_3058":51319},[],"a StorageClass and an external traffic design",{"_3602":238,"_30987":214,"_21467":51321,"_5":14750,"_28174":51249,"_3058":51322},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3602":239,"_30987":214,"_21467":51324,"_5":14750,"_28174":51249,"_3058":51325},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3602":240,"_30987":214,"_21467":51327,"_5":14750,"_28174":51249,"_3058":51328},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3602":241,"_30987":214,"_21467":51330,"_5":14750,"_28174":51252,"_3058":51331},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3602":242,"_30987":214,"_21467":51333,"_5":14750,"_28174":51252,"_3058":51334},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3602":243,"_30987":214,"_21467":51336,"_5":14750,"_28174":51252,"_3058":51337},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3602":244,"_30987":214,"_21467":51339,"_5":14750,"_28174":51256,"_3058":51340},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3602":245,"_30987":214,"_21467":51342,"_5":14750,"_28174":51256,"_3058":51343},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3602":246,"_30987":214,"_21467":51345,"_5":14750,"_28174":51256,"_3058":51346},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3602":247,"_30987":214,"_21467":51348,"_5":14750,"_28174":51256,"_3058":51349},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3602":248,"_30987":214,"_21467":51351,"_5":14750,"_28174":51260,"_3058":51352},[],"The chart reads the PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace. Reference them with `existingSecret` plus the `usernameKey` and `passwordKey` data keys; inline `username` and `password` values are removed and rejected by `values.schema.json`.",{"_3602":249,"_30987":214,"_21467":51354,"_5":14750,"_28174":51260,"_3058":51355},[],"The Secrets must exist before you install or upgrade: the pre-install and pre-upgrade migration job connects to PostgreSQL with the PostgreSQL Secret, and the service containers read the AMQP and SMTP credentials when they start.",{"_3602":250,"_30987":214,"_21467":51357,"_5":14750,"_28174":51260,"_3058":51358},[],"`postgres.existingSecret` (default `lamassu-postgres`) and `amqp.existingSecret` (default `lamassu-amqp`) are always required.",{"_3602":251,"_30987":214,"_21467":51360,"_5":14750,"_28174":51260,"_3058":51361},[],"`services.alerts.smtp_server.existingSecret` is empty by default, which means SMTP without authentication. Set it, together with its key names, only when your SMTP server requires authentication.",{"_3602":252,"_30987":214,"_21467":51363,"_5":14750,"_28174":51260,"_3058":51364},[],"Each `services.authz.credentials` entry names its `database` and uses the global PostgreSQL Secret — `postgres.existingSecret` with its configured key names — unless the entry sets its own `existingSecret`.",{"_3602":253,"_30987":214,"_21467":51366,"_5":14750,"_28174":51260,"_3058":51367},[],"Changing a Secret's contents does not roll the pods that consume it: the services read the credentials when they start. Restart the affected pods after rotating a credential.",{"_3602":254,"_30987":214,"_21467":51369,"_5":14750,"_28174":51260,"_3058":51370},[],"For production, manage the Secrets with the External Secrets Operator (ESO), which the chart does not install. The `charts/lamassu/README.md` in the Helm repository documents a complete working example in its *Secret management* section: installing external-secrets 0.20.2, a test `ClusterSecretStore`, the `ExternalSecret` resources and the wait before installing the chart. Its Fake provider is for testing only — replace it with your provider's configuration for anything beyond a throwaway environment; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager and other providers are documented at external-secrets.io.",{"_3602":255,"_30987":214,"_21467":51372,"_5":14750,"_28174":51260,"_3058":51373},[],"Only these credentials moved into Secrets: other values, such as connector and crypto-engine settings, are still configured through the values file.",{"_3602":256,"_30987":214,"_21467":51375,"_5":14750,"_28174":51264,"_3058":51376},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3602":257,"_30987":214,"_21467":51378,"_5":14750,"_28174":51268,"_3058":51379},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3602":258,"_30987":214,"_21467":51381,"_5":14750,"_28174":51268,"_3058":51382},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3602":259,"_30987":214,"_21467":51384,"_5":14750,"_28174":51268,"_3058":51385},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3602":260,"_30987":214,"_21467":51387,"_5":14750,"_28174":51268,"_3058":51388},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — the chart's default pod security context already sets `fsGroup: 65532` for every service pod, so this top-up applies only when an explicit `podSecurityContext` without `fsGroup` was overridden and an AMQP client Secret is configured — and it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3602":261,"_30987":214,"_21467":51390,"_5":14750,"_28174":51268,"_3058":51391},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3602":262,"_30987":214,"_21467":51393,"_5":14750,"_28174":51268,"_3058":51394},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3602":263,"_30987":214,"_21467":51396,"_5":14750,"_28174":51268,"_3058":51397},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3602":264,"_30987":214,"_21467":51399,"_5":14750,"_28174":51272,"_3058":51400},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3602":265,"_30987":214,"_21467":51402,"_5":14750,"_28174":51272,"_3058":51403},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3602":266,"_30987":214,"_21467":51405,"_5":14750,"_28174":51272,"_3058":51406},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3602":267,"_30987":214,"_21467":51408,"_5":14750,"_28174":51272,"_3058":51409},[],"See Access control for the principal and policy model.",{"_3602":268,"_30987":214,"_21467":51411,"_5":14750,"_28174":51276,"_3058":51412},[],"To install a local checkout instead:",{"_3602":269,"_30987":214,"_21467":51414,"_5":14750,"_28174":51280,"_3058":51415},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3602":270,"_30987":214,"_21467":51417,"_5":14750,"_28174":51280,"_3058":51418},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3602":271,"_30987":214,"_21467":51420,"_5":14750,"_28174":51284,"_3058":51421},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3602":272,"_30987":214,"_21467":51423,"_5":14750,"_28174":51284,"_3058":51424},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3602":273,"_30987":214,"_21467":51426,"_5":14750,"_28174":51284,"_3058":51427},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3602":274,"_30987":214,"_21467":51429,"_5":14750,"_28174":51284,"_3058":51430},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3602":275,"_30987":214,"_21467":51432,"_5":14750,"_28174":51284,"_3058":51433},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3602":276,"_30987":214,"_21467":51435,"_5":14750,"_28174":51288,"_3058":51436},[],"Before going live, review:",{"_3602":277,"_30987":214,"_21467":51438,"_5":14750,"_28174":51288,"_3058":51439},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3602":278,"_30987":214,"_21467":51441,"_5":14750,"_28174":51288,"_3058":51442},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3602":279,"_30987":214,"_21467":51444,"_5":14750,"_28174":51288,"_3058":51445},[],"shared VA storage before increasing VA replicas",{"_3602":280,"_30987":214,"_21467":51447,"_5":14750,"_28174":51288,"_3058":51448},[],"managed OIDC roles and removal of evaluation credentials",{"_3602":281,"_30987":214,"_21467":51450,"_5":14750,"_28174":51288,"_3058":51451},[],"a trusted TLS issuer or externally managed certificate",{"_3602":282,"_30987":214,"_21467":51453,"_5":14750,"_28174":51288,"_3058":51454},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3602":283,"_30987":214,"_21467":51456,"_5":14750,"_28174":51288,"_3058":51457},[],"SMTP, observability and alert delivery",{"_3602":284,"_30987":214,"_21467":51459,"_5":14750,"_28174":51288,"_3058":51460},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3602":285,"_30987":214,"_21467":51462,"_5":14750,"_28174":51288,"_3058":51463},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3602":286,"_30987":286,"_5":15110,"_3058":51465,"_31325":51466,"_21467":51467,"_28174":286},"Expose the Gateway",[50623,50624,50730],[],{"_3602":287,"_30987":286,"_21467":51469,"_5":14750,"_28174":286,"_3058":51470},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3602":288,"_30987":286,"_5":31322,"_21467":51472,"_28174":51473,"_3058":51474},[],"/docs/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3602":289,"_30987":286,"_5":31322,"_21467":51476,"_28174":51477,"_3058":51478},[],"/docs/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3602":290,"_30987":286,"_5":31322,"_21467":51480,"_28174":51481,"_3058":51482},[],"/docs/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3602":291,"_30987":286,"_5":31322,"_21467":51484,"_28174":51485,"_3058":51486},[],"/docs/deployment/self-hosted/networking#k3s","K3s",{"_3602":292,"_30987":286,"_5":31322,"_21467":51488,"_28174":51489,"_3058":51490},[],"/docs/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3602":293,"_30987":286,"_5":31322,"_21467":51492,"_28174":51493,"_3058":51494},[],"/docs/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3602":294,"_30987":286,"_5":31322,"_21467":51496,"_28174":51497,"_3058":51498},[],"/docs/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3602":295,"_30987":286,"_5":31322,"_21467":51500,"_28174":51501,"_3058":51502},[],"/docs/deployment/self-hosted/networking#client-certificates-and-identity-headers","Client certificates and identity headers",{"_3602":296,"_30987":286,"_5":31322,"_21467":51504,"_28174":51505,"_3058":51506},[],"/docs/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3602":297,"_30987":286,"_5":31322,"_21467":51508,"_28174":51509,"_3058":51510},[],"/docs/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3602":298,"_30987":286,"_5":31322,"_21467":51512,"_28174":51513,"_3058":51514},[],"/docs/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3602":299,"_30987":286,"_21467":51516,"_5":14750,"_28174":51473,"_3058":51517},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3602":300,"_30987":286,"_21467":51519,"_5":14750,"_28174":51473,"_3058":51520},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3602":301,"_30987":286,"_21467":51522,"_5":14750,"_28174":51477,"_3058":51523},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3602":302,"_30987":286,"_21467":51525,"_5":14750,"_28174":51477,"_3058":51526},[],"Set it only when:",{"_3602":303,"_30987":286,"_21467":51528,"_5":14750,"_28174":51477,"_3058":51529},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3602":304,"_30987":286,"_21467":51531,"_5":14750,"_28174":51477,"_3058":51532},[],"that address is allocated to this Gateway",{"_3602":305,"_30987":286,"_21467":51534,"_5":14750,"_28174":51477,"_3058":51535},[],"the surrounding network already routes traffic for it to the cluster",{"_3602":306,"_30987":286,"_21467":51537,"_5":14750,"_28174":51477,"_3058":51538},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3602":307,"_30987":286,"_21467":51540,"_5":14750,"_28174":51477,"_3058":51541},[],"Keep these two settings separate:",{"_3602":308,"_30987":286,"_21467":51543,"_5":14750,"_28174":51477,"_3058":51544},[],"`gateway.addresses` requests an address for the Gateway.",{"_3602":309,"_30987":286,"_21467":51546,"_5":14750,"_28174":51477,"_3058":51547},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3602":310,"_30987":286,"_21467":51549,"_5":14750,"_28174":51477,"_3058":51550},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3602":311,"_30987":286,"_21467":51552,"_5":14750,"_28174":51481,"_3058":51553},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3602":312,"_30987":286,"_21467":51555,"_5":14750,"_28174":51481,"_3058":51556},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3602":313,"_30987":286,"_21467":51558,"_5":14750,"_28174":51485,"_3058":51559},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3602":314,"_30987":286,"_21467":51561,"_5":14750,"_28174":51485,"_3058":51562},[],"For the recommended design:",{"_3602":315,"_30987":286,"_21467":51564,"_5":14750,"_28174":51485,"_3058":51565},[],"Use only one externally exposed Lamassu Gateway.",{"_3602":316,"_30987":286,"_21467":51567,"_5":14750,"_28174":51485,"_3058":51568},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3602":317,"_30987":286,"_21467":51570,"_5":14750,"_28174":51485,"_3058":51571},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3602":318,"_30987":286,"_21467":51573,"_5":14750,"_28174":51485,"_3058":51574},[],"Point DNS at the VM's reachable address.",{"_3602":319,"_30987":286,"_21467":51576,"_5":14750,"_28174":51485,"_3058":51577},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3602":320,"_30987":286,"_21467":51579,"_5":14750,"_28174":51489,"_3058":51580},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3602":321,"_30987":286,"_21467":51582,"_5":14750,"_28174":51493,"_3058":51583},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3602":322,"_30987":286,"_21467":51585,"_5":14750,"_28174":51493,"_3058":51586},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3602":323,"_30987":286,"_21467":51588,"_5":14750,"_28174":51497,"_3058":51589},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3602":324,"_30987":286,"_21467":51591,"_5":14750,"_28174":51497,"_3058":51592},[],"Requirement",{"_3602":325,"_30987":286,"_21467":51594,"_5":14750,"_28174":51497,"_3058":51595},[],"Recommended design",{"_3602":326,"_30987":286,"_21467":51597,"_5":14750,"_28174":51497,"_3058":51598},[],"Consequence",{"_3602":327,"_30987":286,"_21467":51600,"_5":14750,"_28174":51497,"_3058":51601},[],"Several Lamassu URLs or services",{"_3602":328,"_30987":286,"_21467":51603,"_5":14750,"_28174":51497,"_3058":51604},[],"One Gateway with multiple routes",{"_3602":329,"_30987":286,"_21467":51606,"_5":14750,"_28174":51497,"_3058":51607},[],"One IP and one proxy fleet; this is the chart default",{"_3602":330,"_30987":286,"_21467":51609,"_5":14750,"_28174":51497,"_3058":51610},[],"Independent Gateways and separate external IPs",{"_3602":331,"_30987":286,"_21467":51612,"_5":14750,"_28174":51497,"_3058":51613},[],"One VIP per Gateway",{"_3602":332,"_30987":286,"_21467":51615,"_5":14750,"_28174":51497,"_3058":51616},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3602":333,"_30987":286,"_21467":51618,"_5":14750,"_28174":51497,"_3058":51619},[],"Independent Gateways on one node and one IP",{"_3602":334,"_30987":286,"_21467":51621,"_5":14750,"_28174":51497,"_3058":51622},[],"Use different external ports",{"_3602":335,"_30987":286,"_21467":51624,"_5":14750,"_28174":51497,"_3058":51625},[],"Clients must include non-standard ports",{"_3602":336,"_30987":286,"_21467":51627,"_5":14750,"_28174":51497,"_3058":51628},[],"Separate TLS/mTLS termination behind one IP",{"_3602":337,"_30987":286,"_21467":51630,"_5":14750,"_28174":51497,"_3058":51631},[],"Front-door SNI routing to internal Gateways",{"_3602":338,"_30987":286,"_21467":51633,"_5":14750,"_28174":51497,"_3058":51634},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3602":339,"_30987":286,"_21467":51636,"_5":14750,"_28174":51497,"_3058":51637},[],"Separate Gateway resources but shared proxy infrastructure",{"_3602":340,"_30987":286,"_21467":51639,"_5":14750,"_28174":51497,"_3058":51640},[],"Envoy merged-Gateway mode",{"_3602":341,"_30987":286,"_21467":51642,"_5":14750,"_28174":51497,"_3058":51643},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3602":342,"_30987":286,"_21467":51645,"_5":14750,"_28174":51497,"_3058":51646},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3602":343,"_30987":286,"_21467":51648,"_5":14750,"_28174":51497,"_3058":51649},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3602":344,"_30987":286,"_21467":51651,"_5":14750,"_28174":51497,"_3058":51652},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3602":345,"_30987":286,"_21467":51654,"_5":14750,"_28174":51497,"_3058":51655},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3602":346,"_30987":286,"_21467":51657,"_5":14750,"_28174":51501,"_3058":51658},[],"The chart renders a `ClientTrafficPolicy` named `enable-mtls` on its shared Gateway automatically; no Helm value enables or disables it. TLS termination accepts requests with or without a client certificate: devices may present one, but they are not required to. Before forwarding a request, the Gateway removes identity and certificate headers that a client could otherwise supply itself: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (the Traefik spelling), `Ssl-Client-Cert` and `X-Amzn-Mtls-Clientcert`. The Traefik spelling is included because backends that accept `X-Forwarded-Tls-Client-Cert` directly would otherwise receive certificate identity data supplied by the client itself, without a client certificate having been presented. After stripping, Envoy adds its own `X-Forwarded-Client-Cert` carrying the presented certificate and its chain, so services that read certificate identity receive only gateway-generated values. No Helm value changes the list of stripped headers. The Access control page describes how `authz` uses this protection to keep `X-Principal-ID` out of reach of clients.",{"_3602":347,"_30987":286,"_21467":51660,"_5":14750,"_28174":51505,"_3058":51661},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3602":348,"_30987":286,"_21467":51663,"_5":14750,"_28174":51505,"_3058":51664},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3602":349,"_30987":286,"_21467":51666,"_5":14750,"_28174":51505,"_3058":51667},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3602":350,"_30987":286,"_21467":51669,"_5":14750,"_28174":51505,"_3058":51670},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3602":351,"_30987":286,"_21467":51672,"_5":14750,"_28174":51505,"_3058":51673},[],"If none of those are possible, use different external ports or change the external network design.",{"_3602":352,"_30987":286,"_21467":51675,"_5":14750,"_28174":51509,"_3058":51676},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3602":353,"_30987":286,"_21467":51678,"_5":14750,"_28174":51509,"_3058":51679},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3602":354,"_30987":286,"_21467":51681,"_5":14750,"_28174":51513,"_3058":51682},[],"Check, in order:",{"_3602":355,"_30987":286,"_21467":51684,"_5":14750,"_28174":51513,"_3058":51685},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3602":356,"_30987":286,"_21467":51687,"_5":14750,"_28174":51513,"_3058":51688},[],"Its status contains the expected address.",{"_3602":357,"_30987":286,"_21467":51690,"_5":14750,"_28174":51513,"_3058":51691},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3602":358,"_30987":286,"_21467":51693,"_5":14750,"_28174":51513,"_3058":51694},[],"Port 443 reaches that address from the client network.",{"_3602":359,"_30987":286,"_21467":51696,"_5":14750,"_28174":51513,"_3058":51697},[],"DNS resolves to the externally reachable endpoint.",{"_3602":360,"_30987":286,"_21467":51699,"_5":14750,"_28174":51513,"_3058":51700},[],"The certificate contains the DNS name or IP used by the client.",{"_3602":361,"_30987":286,"_21467":51702,"_5":14750,"_28174":51513,"_3058":51703},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3602":362,"_30987":362,"_5":15110,"_3058":50730,"_31325":51705,"_21467":51706,"_28174":362},[50623,50624,50730],[],{"_3602":363,"_30987":362,"_21467":51708,"_5":14750,"_28174":362,"_3058":51709},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3602":364,"_30987":362,"_5":31322,"_21467":51711,"_28174":51712,"_3058":51713},[],"/docs/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3602":365,"_30987":362,"_5":31322,"_21467":51715,"_28174":51716,"_3058":51717},[],"/docs/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3602":366,"_30987":362,"_5":31322,"_21467":51719,"_28174":51720,"_3058":51721},[],"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3602":367,"_30987":362,"_5":31322,"_21467":51723,"_28174":51724,"_3058":51725},[],"/docs/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3602":368,"_30987":362,"_5":31322,"_21467":51727,"_28174":51728,"_3058":51729},[],"/docs/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3602":369,"_30987":362,"_5":31322,"_21467":51731,"_28174":51732,"_3058":51733},[],"/docs/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3602":370,"_30987":362,"_21467":51735,"_5":14750,"_28174":51712,"_3058":51736},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3602":371,"_30987":362,"_21467":51738,"_5":14750,"_28174":51716,"_3058":51739},[],"Workflow",{"_3602":372,"_30987":362,"_21467":51741,"_5":14750,"_28174":51716,"_3058":51742},[],"Use it for",{"_3602":373,"_30987":362,"_21467":51744,"_5":14750,"_28174":51716,"_3058":51745},[],"What it installs",{"_3602":374,"_30987":362,"_21467":51747,"_5":14750,"_28174":51716,"_3058":51748},[],"Helm",{"_3602":375,"_30987":362,"_21467":51750,"_5":14750,"_28174":51716,"_3058":51751},[],"Production and controlled environments",{"_3602":376,"_30987":362,"_21467":51753,"_5":14750,"_28174":51716,"_3058":51754},[],"Lamassu services and Gateway API resources",{"_3602":377,"_30987":362,"_21467":51756,"_5":14750,"_28174":51716,"_3058":50867},[],{"_3602":378,"_30987":362,"_21467":51758,"_5":14750,"_28174":51716,"_3058":51759},[],"Evaluation, demos, CI and small lab clusters",{"_3602":379,"_30987":362,"_21467":51761,"_5":14750,"_28174":51716,"_3058":51762},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3602":380,"_30987":362,"_21467":51764,"_5":14750,"_28174":51720,"_3058":51765},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3602":381,"_30987":362,"_21467":51767,"_5":14750,"_28174":51720,"_3058":51768},[],"Area",{"_3602":382,"_30987":362,"_21467":51770,"_5":14750,"_28174":51720,"_3058":51771},[],"The Lamassu chart provides",{"_3602":383,"_30987":362,"_21467":51773,"_5":14750,"_28174":51720,"_3058":51774},[],"You provide",{"_3602":384,"_30987":362,"_21467":51776,"_5":14750,"_28174":51720,"_3058":51777},[],"Lamassu applications",{"_3602":385,"_30987":362,"_21467":51779,"_5":14750,"_28174":51720,"_3058":51780},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3602":386,"_30987":362,"_21467":51782,"_5":14750,"_28174":51720,"_3058":51783},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3602":387,"_30987":362,"_21467":51785,"_5":14750,"_28174":51720,"_3058":51786},[],"PostgreSQL data",{"_3602":388,"_30987":362,"_21467":51788,"_5":14750,"_28174":51720,"_3058":51789},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3602":389,"_30987":362,"_21467":51791,"_5":14750,"_28174":51720,"_3058":51792},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3602":390,"_30987":362,"_21467":51794,"_5":14750,"_28174":51720,"_3058":51795},[],"Messaging",{"_3602":391,"_30987":362,"_21467":51797,"_5":14750,"_28174":51720,"_3058":51798},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3602":392,"_30987":362,"_21467":51800,"_5":14750,"_28174":51720,"_3058":51801},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3602":393,"_30987":362,"_21467":51803,"_5":14750,"_28174":51720,"_3058":51804},[],"Identity",{"_3602":394,"_30987":362,"_21467":51806,"_5":14750,"_28174":51720,"_3058":51807},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3602":395,"_30987":362,"_21467":51809,"_5":14750,"_28174":51720,"_3058":51810},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3602":396,"_30987":362,"_21467":51812,"_5":14750,"_28174":51720,"_3058":51813},[],"External routing",{"_3602":397,"_30987":362,"_21467":51815,"_5":14750,"_28174":51720,"_3058":51816},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3602":398,"_30987":362,"_21467":51818,"_5":14750,"_28174":51720,"_3058":51819},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3602":399,"_30987":362,"_21467":51821,"_5":14750,"_28174":51720,"_3058":51822},[],"TLS",{"_3602":400,"_30987":362,"_21467":51824,"_5":14750,"_28174":51720,"_3058":51825},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3602":401,"_30987":362,"_21467":51827,"_5":14750,"_28174":51720,"_3058":51828},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3602":402,"_30987":362,"_21467":51830,"_5":14750,"_28174":51720,"_3058":51831},[],"Persistent application data",{"_3602":403,"_30987":362,"_21467":51833,"_5":14750,"_28174":51720,"_3058":51834},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3602":404,"_30987":362,"_21467":51836,"_5":14750,"_28174":51720,"_3058":51837},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3602":405,"_30987":362,"_21467":51839,"_5":14750,"_28174":51720,"_3058":51840},[],"Optional integrations",{"_3602":406,"_30987":362,"_21467":51842,"_5":14750,"_28174":51720,"_3058":51843},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3602":407,"_30987":362,"_21467":51845,"_5":14750,"_28174":51720,"_3058":51846},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3602":408,"_30987":362,"_21467":51848,"_5":14750,"_28174":51720,"_3058":51849},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3602":409,"_30987":362,"_21467":51851,"_5":14750,"_28174":51720,"_3058":51852},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3602":410,"_30987":362,"_21467":51854,"_5":14750,"_28174":51724,"_3058":51855},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3602":411,"_30987":362,"_21467":51857,"_5":14750,"_28174":51724,"_3058":51858},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3602":412,"_30987":362,"_21467":51860,"_5":14750,"_28174":51728,"_3058":51861},[],"Kubernetes 1.24 or newer",{"_3602":413,"_30987":362,"_21467":51863,"_5":14750,"_28174":51728,"_3058":51864},[],"Helm 3.2 or newer",{"_3602":414,"_30987":362,"_21467":51866,"_5":14750,"_28174":51728,"_3058":51867},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3602":415,"_30987":362,"_21467":51869,"_5":14750,"_28174":51728,"_3058":51870},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3602":416,"_30987":362,"_21467":51872,"_5":14750,"_28174":51728,"_3058":51873},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3602":417,"_30987":362,"_21467":51875,"_5":14750,"_28174":51728,"_3058":51876},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3602":418,"_30987":362,"_21467":51878,"_5":14750,"_28174":51728,"_3058":51879},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3602":419,"_30987":362,"_21467":51881,"_5":14750,"_28174":51732,"_3058":51882},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3602":420,"_30987":362,"_21467":51884,"_5":14750,"_28174":51732,"_3058":51885},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3602":421,"_30987":362,"_21467":51887,"_5":14750,"_28174":51732,"_3058":51888},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3602":422,"_30987":362,"_21467":51890,"_5":14750,"_28174":51732,"_3058":51891},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3602":423,"_30987":423,"_5":15110,"_3058":51893,"_31325":51894,"_21467":51896,"_28174":423},"Deployment troubleshooting",[50623,50624,51895],"Operations",[],{"_3602":424,"_30987":423,"_21467":51898,"_5":14750,"_28174":423,"_3058":51899},[],"Diagnose access, service health and infrastructure dependencies.",{"_3602":425,"_30987":423,"_5":31322,"_21467":51901,"_28174":51902,"_3058":51903},[],"/docs/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3602":426,"_30987":423,"_5":31322,"_21467":51905,"_28174":51906,"_3058":51907},[],"/docs/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3602":427,"_30987":423,"_5":31322,"_21467":51909,"_28174":51910,"_3058":51911},[],"/docs/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3602":428,"_30987":423,"_5":31322,"_21467":51913,"_28174":51914,"_3058":51915},[],"/docs/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3602":429,"_30987":423,"_5":31322,"_21467":51917,"_28174":51918,"_3058":51919},[],"/docs/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3602":430,"_30987":423,"_5":31322,"_21467":51921,"_28174":51922,"_3058":51923},[],"/docs/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3602":431,"_30987":423,"_5":31322,"_21467":51925,"_28174":51926,"_3058":51927},[],"/docs/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3602":432,"_30987":423,"_5":31322,"_21467":51929,"_28174":51930,"_3058":51931},[],"/docs/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3602":433,"_30987":423,"_5":31322,"_21467":51933,"_28174":51934,"_3058":51935},[],"/docs/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3602":434,"_30987":423,"_5":31322,"_21467":51937,"_28174":51938,"_3058":51939},[],"/docs/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3602":435,"_30987":423,"_5":31322,"_21467":51941,"_28174":51942,"_3058":51943},[],"/docs/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3602":436,"_30987":423,"_5":31322,"_21467":51945,"_28174":51946,"_3058":51947},[],"/docs/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3602":437,"_30987":423,"_5":31322,"_21467":51949,"_28174":51950,"_3058":51951},[],"/docs/deployment/troubleshooting#observability","Observability",{"_3602":438,"_30987":423,"_21467":51953,"_5":14750,"_28174":423,"_3058":51954},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3602":439,"_30987":423,"_21467":51956,"_5":14750,"_28174":51906,"_3058":51957},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3602":440,"_30987":423,"_21467":51959,"_5":14750,"_28174":51910,"_3058":51960},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3602":441,"_30987":423,"_21467":51962,"_5":14750,"_28174":51914,"_3058":51963},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3602":442,"_30987":423,"_21467":51965,"_5":14750,"_28174":51918,"_3058":51966},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3602":443,"_30987":423,"_21467":51968,"_5":14750,"_28174":51922,"_3058":51969},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3602":444,"_30987":423,"_21467":51971,"_5":14750,"_28174":51926,"_3058":51972},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3602":445,"_30987":423,"_21467":51974,"_5":14750,"_28174":51926,"_3058":51975},[],"Also run the chart's connectivity test:",{"_3602":446,"_30987":423,"_21467":51977,"_5":14750,"_28174":51926,"_3058":51978},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3602":447,"_30987":423,"_21467":51980,"_5":14750,"_28174":51926,"_3058":51981},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3602":448,"_30987":423,"_21467":51983,"_5":14750,"_28174":51930,"_3058":51984},[],"If you receive a 401:",{"_3602":449,"_30987":423,"_21467":51986,"_5":14750,"_28174":51930,"_3058":51987},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3602":450,"_30987":423,"_21467":51989,"_5":14750,"_28174":51930,"_3058":51990},[],"verify issuer, audience and expiration of the token;",{"_3602":451,"_30987":423,"_21467":51992,"_5":14750,"_28174":51930,"_3058":51993},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3602":452,"_30987":423,"_21467":51995,"_5":14750,"_28174":51930,"_3058":51996},[],"check that the provider's public and internal routes point to the same realm.",{"_3602":453,"_30987":423,"_21467":51998,"_5":14750,"_28174":51930,"_3058":51999},[],"If login succeeds but the APIs return 403:",{"_3602":454,"_30987":423,"_21467":52001,"_5":14750,"_28174":51930,"_3058":52002},[],"inspect the token's real claims;",{"_3602":455,"_30987":423,"_21467":52004,"_5":14750,"_28174":51930,"_3058":52005},[],"confirm they match an active principal;",{"_3602":456,"_30987":423,"_21467":52007,"_5":14750,"_28174":51930,"_3058":52008},[],"review the policies granted to that principal;",{"_3602":457,"_30987":423,"_21467":52010,"_5":14750,"_28174":51930,"_3058":52011},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3602":458,"_30987":423,"_21467":52013,"_5":14750,"_28174":51930,"_3058":52014},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3602":459,"_30987":423,"_21467":52016,"_5":14750,"_28174":51934,"_3058":52017},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3602":460,"_30987":423,"_21467":52019,"_5":14750,"_28174":51934,"_3058":52020},[],"Locate the authz pod and Service.",{"_3602":461,"_30987":423,"_21467":52022,"_5":14750,"_28174":51934,"_3058":52023},[],"Check /health, logs and its database connection.",{"_3602":462,"_30987":423,"_21467":52025,"_5":14750,"_28174":51934,"_3058":52026},[],"Verify the DNS and port configured in externalAuthorization.",{"_3602":463,"_30987":423,"_21467":52028,"_5":14750,"_28174":51934,"_3058":52029},[],"Check the check route is /v1/ext\\_authz/check.",{"_3602":464,"_30987":423,"_21467":52031,"_5":14750,"_28174":51934,"_3058":52032},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3602":465,"_30987":423,"_21467":52034,"_5":14750,"_28174":51938,"_3058":52035},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3602":466,"_30987":423,"_21467":52037,"_5":14750,"_28174":51942,"_3058":52038},[],"Review kubectl describe pod first. Common causes are:",{"_3602":467,"_30987":423,"_21467":52040,"_5":14750,"_28174":51942,"_3058":52041},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3602":468,"_30987":423,"_21467":52043,"_5":14750,"_28174":51942,"_3058":52044},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3602":469,"_30987":423,"_21467":52046,"_5":14750,"_28174":51942,"_3058":52047},[],"unbound persistent volume;",{"_3602":470,"_30987":423,"_21467":52049,"_5":14750,"_28174":51942,"_3058":52050},[],"inaccessible image or incorrect pull policy;",{"_3602":471,"_30987":423,"_21467":52052,"_5":14750,"_28174":51942,"_3058":52053},[],"invalid cryptographic engine configuration;",{"_3602":472,"_30987":423,"_21467":52055,"_5":14750,"_28174":51942,"_3058":52056},[],"CPU or memory limits set too low;",{"_3602":473,"_30987":423,"_21467":52058,"_5":14750,"_28174":51942,"_3058":52059},[],"an incomplete prior migration.",{"_3602":474,"_30987":423,"_21467":52061,"_5":14750,"_28174":51942,"_3058":52062},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3602":475,"_30987":423,"_21467":52064,"_5":14750,"_28174":51942,"_3058":52065},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3602":476,"_30987":423,"_21467":52067,"_5":14750,"_28174":51942,"_3058":52068},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3602":477,"_30987":423,"_21467":52070,"_5":14750,"_28174":51946,"_3058":52071},[],"Domain and audit events depend on the bus publisher:",{"_3602":478,"_30987":423,"_21467":52073,"_5":14750,"_28174":51946,"_3058":52074},[],"verify it is enabled in the emitting service;",{"_3602":479,"_30987":423,"_21467":52076,"_5":14750,"_28174":51946,"_3058":52077},[],"check AMQP connectivity and credentials;",{"_3602":480,"_30987":423,"_21467":52079,"_5":14750,"_28174":51946,"_3058":52080},[],"review exchange, routing key, queues and consumers;",{"_3602":481,"_30987":423,"_21467":52082,"_5":14750,"_28174":51946,"_3058":52083},[],"inspect dead-letter queues;",{"_3602":482,"_30987":423,"_21467":52085,"_5":14750,"_28174":51946,"_3058":52086},[],"alert on orphan durable queues and backlog growth.",{"_3602":483,"_30987":423,"_21467":52088,"_5":14750,"_28174":51946,"_3058":52089},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3602":484,"_30987":423,"_21467":52091,"_5":14750,"_28174":51946,"_3058":52092},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3602":485,"_30987":423,"_21467":52094,"_5":14750,"_28174":51946,"_3058":52095},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3602":486,"_30987":423,"_21467":52097,"_5":14750,"_28174":51946,"_3058":52098},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3602":487,"_30987":423,"_21467":52100,"_5":14750,"_28174":51946,"_3058":52101},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3602":488,"_30987":423,"_21467":52103,"_5":14750,"_28174":51946,"_3058":52104},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3602":489,"_30987":423,"_21467":52106,"_5":14750,"_28174":51946,"_3058":52107},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3602":490,"_30987":423,"_21467":52109,"_5":14750,"_28174":51950,"_3058":52110},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3602":491,"_30987":423,"_21467":52112,"_5":14750,"_28174":51950,"_3058":52113},[],"Before closing an incident, record:",{"_3602":492,"_30987":423,"_21467":52115,"_5":14750,"_28174":51950,"_3058":52116},[],"the confirmed cause;",{"_3602":493,"_30987":423,"_21467":52118,"_5":14750,"_28174":51950,"_3058":52119},[],"the time scope and affected resources;",{"_3602":494,"_30987":423,"_21467":52121,"_5":14750,"_28174":51950,"_3058":52122},[],"the commands or queries used;",{"_3602":495,"_30987":423,"_21467":52124,"_5":14750,"_28174":51950,"_3058":52125},[],"the applied change and how to revert it;",{"_3602":496,"_30987":423,"_21467":52127,"_5":14750,"_28174":51950,"_3058":52128},[],"validation from a consumer;",{"_3602":497,"_30987":423,"_21467":52130,"_5":14750,"_28174":51950,"_3058":52131},[],"the preventive action and its owner.",{"_3602":498,"_30987":498,"_5":15110,"_3058":52133,"_31325":52134,"_21467":52138,"_28174":498},"Data model",[50623,52135,52136,52137],"Platform","Administration","Access control",[],{"_3602":499,"_30987":498,"_21467":52140,"_5":14750,"_28174":498,"_3058":52141},[],"Entities and relationships from the pki.json schema that authz uses to evaluate access policies.",{"_3602":500,"_30987":498,"_5":31322,"_21467":52143,"_28174":52144,"_3058":52145},[],"/docs/platform/administration/access-control/data-model#schema-relationships","Schema relationships",{"_3602":501,"_30987":498,"_5":31322,"_21467":52147,"_28174":52148,"_3058":52149},[],"/docs/platform/administration/access-control/data-model#schema-entities","Schema entities",{"_3602":502,"_30987":498,"_21467":52151,"_5":14750,"_28174":498,"_3058":52152},[],"The `connectors/authz/pki.json` schema defines the entities in the `pki` authorization namespace. A policy identifies a resource type through `namespace: pki`, `schema_name` and `entity_type`. For example, `ca.certificate` identifies the `certificate` entity type in the `ca` schema.",{"_3602":503,"_30987":498,"_21467":52154,"_5":14750,"_28174":52144,"_3058":52155},[],"Each arrow starts at the entity that declares the relationship and points to its `target_entity`. The value of `foreign_key`, the source column, appears below the label. In `pki.json`, each relationship's `name` matches that column. Select the diagram to enlarge it and scroll through it.",{"_3602":504,"_30987":498,"_21467":52157,"_5":14750,"_28174":52144,"_3058":52158},[],"A policy can propagate actions from the referenced entity to the one that declares the relationship. For example, to grant read access to a DMS's devices, a rule starts from `dmsmanager.dms`, targets `devicemanager.device` and specifies `via: dms_owner`.",{"_3602":505,"_30987":498,"_21467":52160,"_5":14750,"_28174":52144,"_3058":52161},[],"When filtering inherited access, `authz` matches the `foreign_key` column against the first `primary_key` column of the referenced entity. For example, it matches `subject_common_name` to `device.id`, `issuer_meta_serial_number` to `ca_certificate.id` and the links to `kms_key` to `kms_key.key_id`.",{"_3602":506,"_30987":498,"_21467":52163,"_5":14750,"_28174":52148,"_3058":52164},[],"Entity (`schema_name.entity_type`)",{"_3602":507,"_30987":498,"_21467":52166,"_5":14750,"_28174":52148,"_3058":52167},[],"Table (`table_name`)",{"_3602":508,"_30987":498,"_21467":52169,"_5":14750,"_28174":52148,"_3058":52170},[],"Key (`primary_key`)",{"_3602":509,"_30987":498,"_21467":52172,"_5":14750,"_28174":52148,"_3058":52173},[],"`alerts.event`",{"_3602":510,"_30987":498,"_21467":52175,"_5":14750,"_28174":52148,"_3058":52176},[],"`events`",{"_3602":511,"_30987":498,"_21467":52178,"_5":14750,"_28174":52148,"_3058":52179},[],"`event_type`",{"_3602":512,"_30987":498,"_21467":52181,"_5":14750,"_28174":52148,"_3058":52182},[],"`alerts.subscription`",{"_3602":513,"_30987":498,"_21467":52184,"_5":14750,"_28174":52148,"_3058":52185},[],"`subscriptions`",{"_3602":514,"_30987":498,"_21467":52187,"_5":14750,"_28174":52148,"_3058":52188},[],"`id`",{"_3602":515,"_30987":498,"_21467":52190,"_5":14750,"_28174":52148,"_3058":52191},[],"`ca.ca_certificate`",{"_3602":516,"_30987":498,"_21467":52193,"_5":14750,"_28174":52148,"_3058":52194},[],"`ca_certificates`",{"_3602":517,"_30987":498,"_21467":52196,"_5":14750,"_28174":52148,"_3058":52188},[],{"_3602":518,"_30987":498,"_21467":52198,"_5":14750,"_28174":52148,"_3058":52199},[],"`ca.certificate`",{"_3602":519,"_30987":498,"_21467":52201,"_5":14750,"_28174":52148,"_3058":52202},[],"`certificates`",{"_3602":520,"_30987":498,"_21467":52204,"_5":14750,"_28174":52148,"_3058":52205},[],"`serial_number`",{"_3602":521,"_30987":498,"_21467":52207,"_5":14750,"_28174":52148,"_3058":52208},[],"`ca.issuance_profile`",{"_3602":522,"_30987":498,"_21467":52210,"_5":14750,"_28174":52148,"_3058":52211},[],"`issuance_profiles`",{"_3602":523,"_30987":498,"_21467":52213,"_5":14750,"_28174":52148,"_3058":52188},[],{"_3602":524,"_30987":498,"_21467":52215,"_5":14750,"_28174":52148,"_3058":52216},[],"`devicemanager.device_group`",{"_3602":525,"_30987":498,"_21467":52218,"_5":14750,"_28174":52148,"_3058":52219},[],"`device_groups`",{"_3602":526,"_30987":498,"_21467":52221,"_5":14750,"_28174":52148,"_3058":52188},[],{"_3602":527,"_30987":498,"_21467":52223,"_5":14750,"_28174":52148,"_3058":52224},[],"`devicemanager.device`",{"_3602":528,"_30987":498,"_21467":52226,"_5":14750,"_28174":52148,"_3058":52227},[],"`devices`",{"_3602":529,"_30987":498,"_21467":52229,"_5":14750,"_28174":52148,"_3058":52188},[],{"_3602":530,"_30987":498,"_21467":52231,"_5":14750,"_28174":52148,"_3058":52232},[],"`dmsmanager.dms`",{"_3602":531,"_30987":498,"_21467":52234,"_5":14750,"_28174":52148,"_3058":52235},[],"`dms`",{"_3602":532,"_30987":498,"_21467":52237,"_5":14750,"_28174":52148,"_3058":52188},[],{"_3602":533,"_30987":498,"_21467":52239,"_5":14750,"_28174":52148,"_3058":52240},[],"`kms.kms_key`",{"_3602":534,"_30987":498,"_21467":52242,"_5":14750,"_28174":52148,"_3058":52243},[],"`kms_keys`",{"_3602":535,"_30987":498,"_21467":52245,"_5":14750,"_28174":52148,"_3058":52246},[],"`key_id`, `engine_id`",{"_3602":536,"_30987":498,"_21467":52248,"_5":14750,"_28174":52148,"_3058":52249},[],"`va.crl_settings`",{"_3602":537,"_30987":498,"_21467":52251,"_5":14750,"_28174":52148,"_3058":52252},[],"`crl_settings`",{"_3602":538,"_30987":498,"_21467":52254,"_5":14750,"_28174":52148,"_3058":52255},[],"`ca_id`",{"_3602":539,"_30987":498,"_21467":52257,"_5":14750,"_28174":52148,"_3058":52258},[],"Events, subscriptions and device groups have their own actions and filters. Their `relations` lists are empty and they have zero incoming references in the schema. For `ca.certificate`, `view_tables` also lists `certificates_view`.",{"_3602":540,"_30987":498,"_21467":52260,"_5":14750,"_28174":52148,"_3058":52261},[],"Each entity declares instance-level operations in `atomic_actions`, operations that require no resource ID in `global_actions`, and the columns and types accepted by `column_filters` in `filterable`.",{"_3602":541,"_30987":498,"_21467":52263,"_5":14750,"_28174":52148,"_3058":52264},[],"<Card title=\"Access inherited through relations\" href=\"/docs/platform/administration/access-control#access-inherited-through-relations\" />",{"_3602":542,"_30987":542,"_5":15110,"_3058":52266,"_31325":52267,"_21467":52268,"_28174":542},"Access control overview",[50623,52135,52136,52137],[],{"_3602":543,"_30987":542,"_21467":52270,"_5":14750,"_28174":542,"_3058":52271},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3602":544,"_30987":542,"_5":31322,"_21467":52273,"_28174":52274,"_3058":52275},[],"/docs/platform/administration/access-control#essential-concepts","Essential concepts",{"_3602":545,"_30987":542,"_5":31322,"_21467":52277,"_28174":52278,"_3058":52279},[],"/docs/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3602":546,"_30987":542,"_5":31322,"_21467":52281,"_28174":52282,"_3058":52283},[],"/docs/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3602":547,"_30987":542,"_5":31322,"_21467":52285,"_28174":52286,"_3058":52287},[],"/docs/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3602":548,"_30987":542,"_5":31322,"_21467":52289,"_28174":52290,"_3058":52291},[],"/docs/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3602":549,"_30987":542,"_5":31322,"_21467":52293,"_28174":52294,"_3058":52295},[],"/docs/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3602":550,"_30987":542,"_5":31322,"_21467":52297,"_28174":52298,"_3058":52299},[],"/docs/platform/administration/access-control#oidc-principals","OIDC principals",{"_3602":551,"_30987":542,"_5":31322,"_21467":52301,"_28174":52302,"_3058":52303},[],"/docs/platform/administration/access-control#x509-principals","X.509 principals",{"_3602":552,"_30987":542,"_5":31322,"_21467":52305,"_28174":52306,"_3058":52307},[],"/docs/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3602":553,"_30987":542,"_5":31322,"_21467":52309,"_28174":52310,"_3058":52311},[],"/docs/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3602":554,"_30987":542,"_5":31322,"_21467":52313,"_28174":52314,"_3058":52315},[],"/docs/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3602":555,"_30987":542,"_5":31322,"_21467":52317,"_28174":52318,"_3058":52319},[],"/docs/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3602":556,"_30987":542,"_5":31322,"_21467":52321,"_28174":52322,"_3058":52323},[],"/docs/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3602":557,"_30987":542,"_5":31322,"_21467":52325,"_28174":52326,"_3058":52327},[],"/docs/platform/administration/access-control#http-rules","HTTP rules",{"_3602":558,"_30987":542,"_5":31322,"_21467":52329,"_28174":52330,"_3058":52331},[],"/docs/platform/administration/access-control#included-policies","Included policies",{"_3602":559,"_30987":542,"_5":31322,"_21467":52333,"_28174":52334,"_3058":51273},[],"/docs/platform/administration/access-control#provision-the-first-administrator",{"_3602":560,"_30987":542,"_5":31322,"_21467":52336,"_28174":52337,"_3058":52338},[],"/docs/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3602":561,"_30987":542,"_5":31322,"_21467":52340,"_28174":52341,"_3058":52342},[],"/docs/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3602":562,"_30987":542,"_5":31322,"_21467":52344,"_28174":52345,"_3058":52346},[],"/docs/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3602":563,"_30987":542,"_5":31322,"_21467":52348,"_28174":52349,"_3058":52350},[],"/docs/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3602":564,"_30987":542,"_5":31322,"_21467":52352,"_28174":52353,"_3058":52354},[],"/docs/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3602":565,"_30987":542,"_5":31322,"_21467":52356,"_28174":52357,"_3058":52358},[],"/docs/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3602":566,"_30987":542,"_5":31322,"_21467":52360,"_28174":52361,"_3058":52362},[],"/docs/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3602":567,"_30987":542,"_5":31322,"_21467":52364,"_28174":52365,"_3058":52366},[],"/docs/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3602":568,"_30987":542,"_5":31322,"_21467":52368,"_28174":52369,"_3058":52370},[],"/docs/platform/administration/access-control#operational-checklist","Operational checklist",{"_3602":569,"_30987":542,"_5":31322,"_21467":52372,"_28174":52373,"_3058":52374},[],"/docs/platform/administration/access-control#diagnostics","Diagnostics",{"_3602":570,"_30987":542,"_5":31322,"_21467":52376,"_28174":52377,"_3058":52378},[],"/docs/platform/administration/access-control#the-response-is-401","The response is 401",{"_3602":571,"_30987":542,"_5":31322,"_21467":52380,"_28174":52381,"_3058":52382},[],"/docs/platform/administration/access-control#the-response-is-403","The response is 403",{"_3602":572,"_30987":542,"_5":31322,"_21467":52384,"_28174":52385,"_3058":52386},[],"/docs/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3602":573,"_30987":542,"_5":31322,"_21467":52388,"_28174":52389,"_3058":52390},[],"/docs/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3602":574,"_30987":542,"_5":31322,"_21467":52392,"_28174":52393,"_3058":52394},[],"/docs/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3602":575,"_30987":542,"_21467":52396,"_5":14750,"_28174":542,"_3058":52397},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3602":576,"_30987":542,"_21467":52399,"_5":14750,"_28174":542,"_3058":52400},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3602":577,"_30987":542,"_21467":52402,"_5":14750,"_28174":542,"_3058":52403},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3602":578,"_30987":542,"_21467":52405,"_5":14750,"_28174":52274,"_3058":52406},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3602":579,"_30987":542,"_21467":52408,"_5":14750,"_28174":52274,"_3058":52409},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3602":580,"_30987":542,"_21467":52411,"_5":14750,"_28174":52274,"_3058":52412},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3602":581,"_30987":542,"_21467":52414,"_5":14750,"_28174":52274,"_3058":52415},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3602":582,"_30987":542,"_21467":52417,"_5":14750,"_28174":52274,"_3058":52418},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3602":583,"_30987":542,"_21467":52420,"_5":14750,"_28174":52274,"_3058":52421},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3602":584,"_30987":542,"_21467":52423,"_5":14750,"_28174":52278,"_3058":52424},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3602":585,"_30987":542,"_21467":52426,"_5":14750,"_28174":52278,"_3058":52427},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3602":586,"_30987":542,"_21467":52429,"_5":14750,"_28174":52282,"_3058":52430},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3602":587,"_30987":542,"_21467":52432,"_5":14750,"_28174":52282,"_3058":52433},[],"The decision is made **before forwarding the request to the service**:",{"_3602":588,"_30987":542,"_21467":52435,"_5":14750,"_28174":52282,"_3058":52436},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3602":589,"_30987":542,"_21467":52438,"_5":14750,"_28174":52282,"_3058":52439},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3602":590,"_30987":542,"_21467":52441,"_5":14750,"_28174":52282,"_3058":52442},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3602":591,"_30987":542,"_21467":52444,"_5":14750,"_28174":52282,"_3058":52445},[],"It separately loads the policies granted to each principal.",{"_3602":592,"_30987":542,"_21467":52447,"_5":14750,"_28174":52282,"_3058":52448},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3602":593,"_30987":542,"_21467":52450,"_5":14750,"_28174":52282,"_3058":52451},[],"`authz` looks for an HTTP rule granting that action.",{"_3602":594,"_30987":542,"_21467":52453,"_5":14750,"_28174":52282,"_3058":52454},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3602":595,"_30987":542,"_21467":52456,"_5":14750,"_28174":52282,"_3058":52457},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3602":596,"_30987":542,"_21467":52459,"_5":14750,"_28174":52282,"_3058":52460},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context. Clients cannot forge this header: the Gateway removes client-supplied `X-Principal-Id` (and the other forwarded identity and certificate headers) before forwarding, so only `authz` can set it. See Expose the Gateway for the full list of stripped headers.",{"_3602":597,"_30987":542,"_21467":52462,"_5":14750,"_28174":52282,"_3058":52463},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3602":598,"_30987":542,"_21467":52465,"_5":14750,"_28174":52286,"_3058":52466},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3602":599,"_30987":542,"_21467":52468,"_5":14750,"_28174":52286,"_3058":52469},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3602":600,"_30987":542,"_21467":52471,"_5":14750,"_28174":52286,"_3058":52472},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3602":601,"_30987":542,"_21467":52474,"_5":14750,"_28174":52286,"_3058":52475},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3602":602,"_30987":542,"_21467":52477,"_5":14750,"_28174":52286,"_3058":52478},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3602":603,"_30987":542,"_21467":52480,"_5":14750,"_28174":52286,"_3058":52481},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3602":604,"_30987":542,"_21467":52483,"_5":14750,"_28174":52286,"_3058":52484},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3602":605,"_30987":542,"_21467":52486,"_5":14750,"_28174":52286,"_3058":52487},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3602":606,"_30987":542,"_21467":52489,"_5":14750,"_28174":52286,"_3058":52490},[],"A schema can also make an individual route accept the credential from the URL. **`query_token: true` on a route** makes it accept the OIDC access token from the `access_token` query parameter, but only when the request carries neither an `Authorization: Bearer` header nor a client-certificate header: a credential in a header always wins. The token is validated and authorized exactly like a Bearer token, so the route's action still requires a policy grant, and routes that do not opt in never read the query parameter. The dashboard's experimental browser terminal uses this mechanism, because the WebSocket connection its browser client opens cannot set request headers.",{"_3602":607,"_30987":542,"_21467":52492,"_5":14750,"_28174":52286,"_3058":52493},[],"Query strings are often recorded. `authz` replaces the `access_token` value with `REDACTED` in its own decision logs, but other logs that capture the URL — the Gateway access log, service request logs, tracing — are not redacted. Keep `query_token` for WebSocket routes and short-lived tokens.",{"_3602":608,"_30987":542,"_21467":52495,"_5":14750,"_28174":52290,"_3058":52496},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3602":609,"_30987":542,"_21467":52498,"_5":14750,"_28174":52290,"_3058":52499},[],"The decision is made with the domain operation context:",{"_3602":610,"_30987":542,"_21467":52501,"_5":14750,"_28174":52290,"_3058":52502},[],"The middleware extracts the credential and resolves the matching principals.",{"_3602":611,"_30987":542,"_21467":52504,"_5":14750,"_28174":52290,"_3058":52505},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3602":612,"_30987":542,"_21467":52507,"_5":14750,"_28174":52290,"_3058":52508},[],"`authz` gathers the entity rules of the granted policies.",{"_3602":613,"_30987":542,"_21467":52510,"_5":14750,"_28174":52290,"_3058":52511},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3602":614,"_30987":542,"_21467":52513,"_5":14750,"_28174":52290,"_3058":52514},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3602":615,"_30987":542,"_21467":52516,"_5":14750,"_28174":52290,"_3058":52517},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3602":616,"_30987":542,"_21467":52519,"_5":14750,"_28174":52290,"_3058":52520},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3602":617,"_30987":542,"_21467":52522,"_5":14750,"_28174":52290,"_3058":52523},[],"Actions fall into two groups:",{"_3602":618,"_30987":542,"_21467":52525,"_5":14750,"_28174":52290,"_3058":52526},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3602":619,"_30987":542,"_21467":52528,"_5":14750,"_28174":52290,"_3058":52529},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3602":620,"_30987":542,"_21467":52531,"_5":14750,"_28174":52290,"_3058":52532},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3602":621,"_30987":542,"_21467":52534,"_5":14750,"_28174":52294,"_3058":52535},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3602":622,"_30987":542,"_21467":52537,"_5":14750,"_28174":52294,"_3058":52538},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3602":623,"_30987":542,"_21467":52540,"_5":14750,"_28174":52294,"_3058":52541},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3602":624,"_30987":542,"_21467":52543,"_5":14750,"_28174":52298,"_3058":52544},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3602":625,"_30987":542,"_21467":52546,"_5":14750,"_28174":52298,"_3058":52547},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3602":626,"_30987":542,"_21467":52549,"_5":14750,"_28174":52298,"_3058":52550},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3602":627,"_30987":542,"_21467":52552,"_5":14750,"_28174":52298,"_3058":52553},[],"The implemented operators are:",{"_3602":628,"_30987":542,"_21467":52555,"_5":14750,"_28174":52298,"_3058":52556},[],"`equals`, for exact equality;",{"_3602":629,"_30987":542,"_21467":52558,"_5":14750,"_28174":52298,"_3058":52559},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3602":630,"_30987":542,"_21467":52561,"_5":14750,"_28174":52298,"_3058":52562},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3602":631,"_30987":542,"_21467":52564,"_5":14750,"_28174":52298,"_3058":52565},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3602":632,"_30987":542,"_21467":52567,"_5":14750,"_28174":52302,"_3058":52568},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3602":633,"_30987":542,"_21467":52570,"_5":14750,"_28174":52302,"_3058":52571},[],"The available modes are:",{"_3602":634,"_30987":542,"_21467":52573,"_5":14750,"_28174":52302,"_3058":52574},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3602":635,"_30987":542,"_21467":52576,"_5":14750,"_28174":52302,"_3058":52577},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3602":636,"_30987":542,"_21467":52579,"_5":14750,"_28174":52302,"_3058":52580},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3602":637,"_30987":542,"_21467":52582,"_5":14750,"_28174":52302,"_3058":52583},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3602":638,"_30987":542,"_21467":52585,"_5":14750,"_28174":52302,"_3058":52586},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3602":639,"_30987":542,"_21467":52588,"_5":14750,"_28174":52302,"_3058":52589},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3602":640,"_30987":542,"_21467":52591,"_5":14750,"_28174":52306,"_3058":52592},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3602":641,"_30987":542,"_21467":52594,"_5":14750,"_28174":52306,"_3058":52595},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3602":642,"_30987":542,"_21467":52597,"_5":14750,"_28174":52306,"_3058":52598},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3602":643,"_30987":542,"_21467":52600,"_5":14750,"_28174":52306,"_3058":52601},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3602":644,"_30987":542,"_21467":52603,"_5":14750,"_28174":52314,"_3058":52604},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3602":645,"_30987":542,"_21467":52606,"_5":14750,"_28174":52314,"_3058":52607},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3602":646,"_30987":542,"_21467":52609,"_5":14750,"_28174":52318,"_3058":52610},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3602":647,"_30987":542,"_21467":52612,"_5":14750,"_28174":52318,"_3058":52613},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3602":648,"_30987":542,"_21467":52615,"_5":14750,"_28174":52318,"_3058":52616},[],"The data model shows how the resources used in entity rules are connected.",{"_3602":649,"_30987":542,"_21467":52618,"_5":14750,"_28174":52318,"_3058":52619},[],"A rule can only follow relations that the data schema declares between its two entities. You can reference the relation by its name or by its foreign-key column — both spellings are equivalent, and it is the schema that decides which column the query uses. When you save a policy, `authz` checks every relation against the loaded schemas: one that no schema declares, or one pointing at an entity that is not loaded, is rejected at that moment.",{"_3602":650,"_30987":542,"_21467":52621,"_5":14750,"_28174":52318,"_3058":52622},[],"Policies stored before this validation may still carry relations the schemas do not declare. Such a relation grants nothing: `authz` logs a warning, `skipping relation that grants nothing`, naming the policy and the relation, and continues evaluating the rest of the policy. The reference is always resolved against the schema before any query is built, so an undeclared relation can never alter it. If inherited access narrows after an upgrade, check the `authz` logs for this warning and correct the relation of the affected policy.",{"_3602":651,"_30987":542,"_21467":52624,"_5":14750,"_28174":52322,"_3058":52625},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3602":652,"_30987":542,"_21467":52627,"_5":14750,"_28174":52322,"_3058":52628},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3602":653,"_30987":542,"_21467":52630,"_5":14750,"_28174":52322,"_3058":52631},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3602":654,"_30987":542,"_21467":52633,"_5":14750,"_28174":52326,"_3058":52634},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3602":655,"_30987":542,"_21467":52636,"_5":14750,"_28174":52326,"_3058":52637},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3602":656,"_30987":542,"_21467":52639,"_5":14750,"_28174":52326,"_3058":52640},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3602":657,"_30987":542,"_21467":52642,"_5":14750,"_28174":52326,"_3058":52643},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3602":658,"_30987":542,"_21467":52645,"_5":14750,"_28174":52326,"_3058":52646},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3602":659,"_30987":542,"_21467":52648,"_5":14750,"_28174":52326,"_3058":52649},[],"Note that:",{"_3602":660,"_30987":542,"_21467":52651,"_5":14750,"_28174":52326,"_3058":52652},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3602":661,"_30987":542,"_21467":52654,"_5":14750,"_28174":52326,"_3058":52655},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3602":662,"_30987":542,"_21467":52657,"_5":14750,"_28174":52326,"_3058":52658},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3602":663,"_30987":542,"_21467":52660,"_5":14750,"_28174":52330,"_3058":52661},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3602":664,"_30987":542,"_21467":52663,"_5":14750,"_28174":52330,"_3058":52664},[],"full and read-only access to certificates and authorities;",{"_3602":665,"_30987":542,"_21467":52666,"_5":14750,"_28174":52330,"_3058":52667},[],"full and read-only access to the KMS;",{"_3602":666,"_30987":542,"_21467":52669,"_5":14750,"_28174":52330,"_3058":52670},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3602":667,"_30987":542,"_21467":52672,"_5":14750,"_28174":52330,"_3058":52673},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3602":668,"_30987":542,"_21467":52675,"_5":14750,"_28174":52330,"_3058":52676},[],"console access;",{"_3602":669,"_30987":542,"_21467":52678,"_5":14750,"_28174":52330,"_3058":52679},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3602":670,"_30987":542,"_21467":52681,"_5":14750,"_28174":52330,"_3058":52682},[],"access to the dashboard's experimental terminal (Terminal Network);",{"_3602":671,"_30987":542,"_21467":52684,"_5":14750,"_28174":52330,"_3058":52685},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3602":672,"_30987":542,"_21467":52687,"_5":14750,"_28174":52330,"_3058":52688},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3602":673,"_30987":542,"_21467":52690,"_5":14750,"_28174":52330,"_3058":52691},[],"The Terminal Network policy is created by the `authz` preload the next time `authz` starts after the upgrade. Preloaded policies are system policies — their ids begin with `lamassu.` — and cannot be edited through the API.",{"_3602":674,"_30987":542,"_21467":52693,"_5":14750,"_28174":52334,"_3058":52694},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3602":675,"_30987":542,"_21467":52696,"_5":14750,"_28174":52334,"_3058":52697},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3602":676,"_30987":542,"_21467":52699,"_5":14750,"_28174":52334,"_3058":52700},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3602":677,"_30987":542,"_21467":52702,"_5":14750,"_28174":52337,"_3058":52703},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3602":678,"_30987":542,"_21467":52705,"_5":14750,"_28174":52341,"_3058":52706},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3602":679,"_30987":542,"_21467":52708,"_5":14750,"_28174":52341,"_3058":52709},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3602":680,"_30987":542,"_21467":52711,"_5":14750,"_28174":52345,"_3058":52712},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3602":681,"_30987":542,"_21467":52714,"_5":14750,"_28174":52349,"_3058":52715},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3602":682,"_30987":542,"_21467":52717,"_5":14750,"_28174":52353,"_3058":52718},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3602":683,"_30987":542,"_21467":52720,"_5":14750,"_28174":52357,"_3058":52721},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3602":684,"_30987":542,"_21467":52723,"_5":14750,"_28174":52357,"_3058":52724},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3602":685,"_30987":542,"_21467":52726,"_5":14750,"_28174":52361,"_3058":52727},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3602":686,"_30987":542,"_21467":52729,"_5":14750,"_28174":52361,"_3058":52730},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3602":687,"_30987":542,"_21467":52732,"_5":14750,"_28174":52361,"_3058":52733},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3602":688,"_30987":542,"_21467":52735,"_5":14750,"_28174":52361,"_3058":52736},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3602":689,"_30987":542,"_21467":52738,"_5":14750,"_28174":52361,"_3058":52739},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3602":690,"_30987":542,"_21467":52741,"_5":14750,"_28174":52361,"_3058":52742},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3602":691,"_30987":542,"_21467":52744,"_5":14750,"_28174":52361,"_3058":52745},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3602":692,"_30987":542,"_21467":52747,"_5":14750,"_28174":52361,"_3058":52748},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3602":693,"_30987":542,"_21467":52750,"_5":14750,"_28174":52365,"_3058":52751},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3602":694,"_30987":542,"_21467":52753,"_5":14750,"_28174":52365,"_3058":52754},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3602":695,"_30987":542,"_21467":52756,"_5":14750,"_28174":52365,"_3058":52757},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3602":696,"_30987":542,"_21467":52759,"_5":14750,"_28174":52369,"_3058":52760},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3602":697,"_30987":542,"_21467":52762,"_5":14750,"_28174":52369,"_3058":52763},[],"Use groups or stable roles for people and independent identities for automations.",{"_3602":698,"_30987":542,"_21467":52765,"_5":14750,"_28174":52369,"_3058":52766},[],"Keep at least two recovery administrators and test their access periodically.",{"_3602":699,"_30987":542,"_21467":52768,"_5":14750,"_28174":52369,"_3058":52769},[],"Review active principals, their matches and their grants after IdP changes.",{"_3602":700,"_30987":542,"_21467":52771,"_5":14750,"_28174":52369,"_3058":52772},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3602":701,"_30987":542,"_21467":52774,"_5":14750,"_28174":52369,"_3058":52775},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3602":702,"_30987":542,"_21467":52777,"_5":14750,"_28174":52369,"_3058":52778},[],"Always test one allowed and one denied operation for each role.",{"_3602":703,"_30987":542,"_21467":52780,"_5":14750,"_28174":52369,"_3058":52781},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3602":704,"_30987":542,"_21467":52783,"_5":14750,"_28174":52377,"_3058":52784},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3602":705,"_30987":542,"_21467":52786,"_5":14750,"_28174":52381,"_3058":52787},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3602":706,"_30987":542,"_21467":52789,"_5":14750,"_28174":52381,"_3058":52790},[],"that an active principal of the correct type exists;",{"_3602":707,"_30987":542,"_21467":52792,"_5":14750,"_28174":52381,"_3058":52793},[],"that the claim paths and values match the real token exactly;",{"_3602":708,"_30987":542,"_21467":52795,"_5":14750,"_28174":52381,"_3058":52796},[],"that all of the principal's conditions hold;",{"_3602":709,"_30987":542,"_21467":52798,"_5":14750,"_28174":52381,"_3058":52799},[],"that the principal has the expected policy granted;",{"_3602":710,"_30987":542,"_21467":52801,"_5":14750,"_28174":52381,"_3058":52802},[],"that the policy includes the action and the requested resource type or route;",{"_3602":711,"_30987":542,"_21467":52804,"_5":14750,"_28174":52381,"_3058":52805},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3602":712,"_30987":542,"_21467":52807,"_5":14750,"_28174":52381,"_3058":52808},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3602":713,"_30987":542,"_21467":52810,"_5":14750,"_28174":52381,"_3058":52811},[],"If a policy that relied on inherited access stopped granting it after an upgrade, look in the `authz` logs for `skipping relation that grants nothing`: the warning names the policy and the relation the schemas no longer declare. Correct that policy's relation so it matches the current schemas.",{"_3602":714,"_30987":542,"_21467":52813,"_5":14750,"_28174":52385,"_3058":52814},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3602":715,"_30987":542,"_21467":52816,"_5":14750,"_28174":52389,"_3058":52817},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3602":716,"_30987":542,"_21467":52819,"_5":14750,"_28174":52393,"_3058":52820},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3602":717,"_30987":542,"_21467":52822,"_5":14750,"_28174":52393,"_3058":52823},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3602":718,"_30987":718,"_5":15110,"_3058":52825,"_31325":52826,"_21467":52827,"_28174":718},"Alerts and subscriptions",[50623,52135,52136],[],{"_3602":719,"_30987":718,"_21467":52829,"_5":14750,"_28174":718,"_3058":52830},[],"Send PKI events to people and external systems.",{"_3602":720,"_30987":718,"_5":31322,"_21467":52832,"_28174":52833,"_3058":52834},[],"/docs/platform/administration/alerts#how-it-works","How it works",{"_3602":721,"_30987":718,"_5":31322,"_21467":52836,"_28174":52837,"_3058":52838},[],"/docs/platform/administration/alerts#available-channels","Available channels",{"_3602":722,"_30987":718,"_5":31322,"_21467":52840,"_28174":52841,"_3058":52842},[],"/docs/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3602":723,"_30987":718,"_5":31322,"_21467":52844,"_28174":52845,"_3058":52846},[],"/docs/platform/administration/alerts#choose-the-event","Choose the event",{"_3602":724,"_30987":718,"_5":31322,"_21467":52848,"_28174":52849,"_3058":52850},[],"/docs/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3602":725,"_30987":718,"_5":31322,"_21467":52852,"_28174":52853,"_3058":52854},[],"/docs/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3602":726,"_30987":718,"_5":31322,"_21467":52856,"_28174":52857,"_3058":52858},[],"/docs/platform/administration/alerts#review-and-activate","Review and activate",{"_3602":727,"_30987":718,"_5":31322,"_21467":52860,"_28174":52861,"_3058":52862},[],"/docs/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3602":728,"_30987":718,"_5":31322,"_21467":52864,"_28174":52865,"_3058":52866},[],"/docs/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3602":729,"_30987":718,"_5":31322,"_21467":52868,"_28174":52869,"_3058":52870},[],"/docs/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3602":730,"_30987":718,"_5":31322,"_21467":52872,"_28174":52873,"_3058":52874},[],"/docs/platform/administration/alerts#event-families","Event families",{"_3602":731,"_30987":718,"_21467":52876,"_5":14750,"_28174":718,"_3058":52877},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3602":732,"_30987":718,"_21467":52879,"_5":14750,"_28174":52833,"_3058":52880},[],"A service publishes a domain event.",{"_3602":733,"_30987":718,"_21467":52882,"_5":14750,"_28174":52833,"_3058":52883},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3602":734,"_30987":718,"_21467":52885,"_5":14750,"_28174":52833,"_3058":52886},[],"Each subscription's filter decides whether it should be notified.",{"_3602":735,"_30987":718,"_21467":52888,"_5":14750,"_28174":52833,"_3058":52889},[],"Lamassu delivers the event to the configured channel.",{"_3602":736,"_30987":718,"_21467":52891,"_5":14750,"_28174":52833,"_3058":52892},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3602":737,"_30987":718,"_21467":52894,"_5":14750,"_28174":52837,"_3058":52895},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3602":738,"_30987":718,"_21467":52897,"_5":14750,"_28174":52837,"_3058":52898},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3602":739,"_30987":718,"_21467":52900,"_5":14750,"_28174":52837,"_3058":52901},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3602":740,"_30987":718,"_21467":52903,"_5":14750,"_28174":52837,"_3058":52904},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3602":741,"_30987":718,"_21467":52906,"_5":14750,"_28174":52837,"_3058":52907},[],"`apikey_options` requires `header` and `key`.",{"_3602":742,"_30987":718,"_21467":52909,"_5":14750,"_28174":52837,"_3058":52910},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3602":743,"_30987":718,"_21467":52912,"_5":14750,"_28174":52837,"_3058":52913},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3602":744,"_30987":718,"_21467":52915,"_5":14750,"_28174":52837,"_3058":52916},[],"The alerts API reference documents the full `http_client` schema.",{"_3602":745,"_30987":718,"_21467":52918,"_5":14750,"_28174":52845,"_3058":52919},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3602":746,"_30987":718,"_21467":52921,"_5":14750,"_28174":52849,"_3058":52922},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3602":747,"_30987":718,"_21467":52924,"_5":14750,"_28174":52853,"_3058":52925},[],"Add a filter if you don't want to receive every instance of the event.",{"_3602":748,"_30987":718,"_21467":52927,"_5":14750,"_28174":52853,"_3058":52928},[],"**None** notifies all instances of the event.",{"_3602":749,"_30987":718,"_21467":52930,"_5":14750,"_28174":52853,"_3058":52931},[],"**JSON Path** evaluates one or more specific fields.",{"_3602":750,"_30987":718,"_21467":52933,"_5":14750,"_28174":52853,"_3058":52934},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3602":751,"_30987":718,"_21467":52936,"_5":14750,"_28174":52853,"_3058":52937},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3602":752,"_30987":718,"_21467":52939,"_5":14750,"_28174":52853,"_3058":52940},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3602":753,"_30987":718,"_21467":52942,"_5":14750,"_28174":52853,"_3058":52943},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3602":754,"_30987":718,"_21467":52945,"_5":14750,"_28174":52857,"_3058":52946},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3602":755,"_30987":718,"_21467":52948,"_5":14750,"_28174":52861,"_3058":52949},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3602":756,"_30987":718,"_21467":52951,"_5":14750,"_28174":52861,"_3058":52952},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3602":757,"_30987":718,"_21467":52954,"_5":14750,"_28174":52861,"_3058":52955},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3602":758,"_30987":718,"_21467":52957,"_5":14750,"_28174":52861,"_3058":52958},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3602":759,"_30987":718,"_21467":52960,"_5":14750,"_28174":52861,"_3058":52961},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3602":760,"_30987":718,"_21467":52963,"_5":14750,"_28174":52861,"_3058":52964},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3602":761,"_30987":718,"_21467":52966,"_5":14750,"_28174":52861,"_3058":52967},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3602":762,"_30987":718,"_21467":52969,"_5":14750,"_28174":52861,"_3058":52970},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3602":763,"_30987":718,"_21467":52972,"_5":14750,"_28174":52865,"_3058":52973},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3602":764,"_30987":718,"_21467":52975,"_5":14750,"_28174":52865,"_3058":52976},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3602":765,"_30987":718,"_21467":52978,"_5":14750,"_28174":52865,"_3058":52979},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3602":766,"_30987":718,"_21467":52981,"_5":14750,"_28174":52865,"_3058":52982},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3602":767,"_30987":718,"_21467":52984,"_5":14750,"_28174":52865,"_3058":52985},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3602":768,"_30987":718,"_21467":52987,"_5":14750,"_28174":52865,"_3058":52988},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3602":769,"_30987":718,"_21467":52990,"_5":14750,"_28174":52865,"_3058":52991},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3602":770,"_30987":718,"_21467":52993,"_5":14750,"_28174":52865,"_3058":52994},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3602":771,"_30987":718,"_21467":52996,"_5":14750,"_28174":52869,"_3058":52997},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3602":772,"_30987":718,"_21467":52999,"_5":14750,"_28174":52869,"_3058":53000},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3602":773,"_30987":718,"_21467":53002,"_5":14750,"_28174":52873,"_3058":53003},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3602":774,"_30987":718,"_21467":53005,"_5":14750,"_28174":52873,"_3058":53006},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3602":775,"_30987":718,"_21467":53008,"_5":14750,"_28174":52873,"_3058":53009},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3602":776,"_30987":718,"_21467":53011,"_5":14750,"_28174":52873,"_3058":53012},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3602":777,"_30987":718,"_21467":53014,"_5":14750,"_28174":52873,"_3058":53015},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3602":778,"_30987":718,"_21467":53017,"_5":14750,"_28174":52873,"_3058":53018},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` and `va.crl-settings.delete`.",{"_3602":779,"_30987":718,"_21467":53020,"_5":14750,"_28174":52873,"_3058":53021},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3602":780,"_30987":718,"_21467":53023,"_5":14750,"_28174":52873,"_3058":53024},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3602":781,"_30987":718,"_21467":53026,"_5":14750,"_28174":52873,"_3058":53027},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3602":782,"_30987":718,"_21467":53029,"_5":14750,"_28174":52873,"_3058":53030},[],"The VA also publishes `va.crl-settings.finalize` when a CA is revoked permanently or expires, `va.crl-settings.archive` when the CA is deleted, and `va.crl-settings.delete` when archived settings are removed.",{"_3602":783,"_30987":783,"_5":15110,"_3058":53032,"_31325":53033,"_21467":53034,"_28174":783},"Audit logs",[50623,52135,52136],[],{"_3602":784,"_30987":783,"_21467":53036,"_5":14750,"_28174":783,"_3058":53037},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3602":785,"_30987":783,"_5":31322,"_21467":53039,"_28174":53040,"_3058":53041},[],"/docs/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3602":786,"_30987":783,"_5":31322,"_21467":53043,"_28174":53044,"_3058":53045},[],"/docs/platform/administration/audit-logs#coverage","Coverage",{"_3602":787,"_30987":783,"_5":31322,"_21467":53047,"_28174":53048,"_3058":53049},[],"/docs/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3602":788,"_30987":783,"_5":31322,"_21467":53051,"_28174":53052,"_3058":53053},[],"/docs/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3602":789,"_30987":783,"_5":31322,"_21467":53055,"_28174":53056,"_3058":53057},[],"/docs/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3602":790,"_30987":783,"_5":31322,"_21467":53059,"_28174":53060,"_3058":53061},[],"/docs/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3602":791,"_30987":783,"_5":31322,"_21467":53063,"_28174":53064,"_3058":53065},[],"/docs/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3602":792,"_30987":783,"_5":31322,"_21467":53067,"_28174":53068,"_3058":53069},[],"/docs/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3602":793,"_30987":783,"_5":31322,"_21467":53071,"_28174":53072,"_3058":53073},[],"/docs/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3602":794,"_30987":783,"_5":31322,"_21467":53075,"_28174":53076,"_3058":53077},[],"/docs/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3602":795,"_30987":783,"_5":31322,"_21467":53079,"_28174":53080,"_3058":53081},[],"/docs/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3602":796,"_30987":783,"_21467":53083,"_5":14750,"_28174":783,"_3058":53084},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3602":797,"_30987":783,"_21467":53086,"_5":14750,"_28174":53040,"_3058":53087},[],"The audit body includes:",{"_3602":798,"_30987":783,"_21467":53089,"_5":14750,"_28174":53040,"_3058":53090},[],"input: data received by the operation;",{"_3602":799,"_30987":783,"_21467":53092,"_5":14750,"_28174":53040,"_3058":53093},[],"has\\_error: whether the service returned an error;",{"_3602":800,"_30987":783,"_21467":53095,"_5":14750,"_28174":53040,"_3058":53096},[],"output: produced result or error message;",{"_3602":801,"_30987":783,"_21467":53098,"_5":14750,"_28174":53040,"_3058":53099},[],"principals: identifiers of the principals that matched the request.",{"_3602":802,"_30987":783,"_21467":53101,"_5":14750,"_28174":53040,"_3058":53102},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3602":803,"_30987":783,"_21467":53104,"_5":14750,"_28174":53040,"_3058":53105},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3602":804,"_30987":783,"_21467":53107,"_5":14750,"_28174":53044,"_3058":53108},[],"The backend applies auditing to mutations of:",{"_3602":805,"_30987":783,"_21467":53110,"_5":14750,"_28174":53044,"_3058":53111},[],"authorities, certificates and issuance profiles;",{"_3602":806,"_30987":783,"_21467":53113,"_5":14750,"_28174":53044,"_3058":53114},[],"keys and KMS engines;",{"_3602":807,"_30987":783,"_21467":53116,"_5":14750,"_28174":53044,"_3058":53117},[],"devices and identities;",{"_3602":808,"_30987":783,"_21467":53119,"_5":14750,"_28174":53044,"_3058":53120},[],"DMSs and enrollment operations;",{"_3602":809,"_30987":783,"_21467":53122,"_5":14750,"_28174":53044,"_3058":53123},[],"validation functions and CRL;",{"_3602":810,"_30987":783,"_21467":53125,"_5":14750,"_28174":53044,"_3058":53126},[],"principals, policies and authorization grants.",{"_3602":811,"_30987":783,"_21467":53128,"_5":14750,"_28174":53044,"_3058":53129},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3602":812,"_30987":783,"_21467":53131,"_5":14750,"_28174":53048,"_3058":53132},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3602":813,"_30987":783,"_21467":53134,"_5":14750,"_28174":53048,"_3058":53135},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3602":814,"_30987":783,"_21467":53137,"_5":14750,"_28174":53048,"_3058":53138},[],"Design the consumer to:",{"_3602":815,"_30987":783,"_21467":53140,"_5":14750,"_28174":53048,"_3058":53141},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3602":816,"_30987":783,"_21467":53143,"_5":14750,"_28174":53048,"_3058":53144},[],"keep the complete CloudEvent unmodified;",{"_3602":817,"_30987":783,"_21467":53146,"_5":14750,"_28174":53048,"_3058":53147},[],"record the ingestion time and detect duplicates by ID;",{"_3602":818,"_30987":783,"_21467":53149,"_5":14750,"_28174":53048,"_3058":53150},[],"encrypt in transit and at rest;",{"_3602":819,"_30987":783,"_21467":53152,"_5":14750,"_28174":53048,"_3058":53153},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3602":820,"_30987":783,"_21467":53155,"_5":14750,"_28174":53048,"_3058":53156},[],"apply an explicit retention and legal hold policy;",{"_3602":821,"_30987":783,"_21467":53158,"_5":14750,"_28174":53048,"_3058":53159},[],"alert if it stops consuming or the pending queue grows.",{"_3602":822,"_30987":783,"_21467":53161,"_5":14750,"_28174":53052,"_3058":53162},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3602":823,"_30987":783,"_21467":53164,"_5":14750,"_28174":53052,"_3058":53165},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3602":824,"_30987":783,"_21467":53167,"_5":14750,"_28174":53060,"_3058":53168},[],"Start from the reported time and normalize every source to UTC.",{"_3602":825,"_30987":783,"_21467":53170,"_5":14750,"_28174":53064,"_3058":53171},[],"Filter by event type, service source and resource identifier.",{"_3602":826,"_30987":783,"_21467":53173,"_5":14750,"_28174":53068,"_3058":53174},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3602":827,"_30987":783,"_21467":53176,"_5":14750,"_28174":53072,"_3058":53177},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3602":828,"_30987":783,"_21467":53179,"_5":14750,"_28174":53076,"_3058":53180},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3602":829,"_30987":783,"_21467":53182,"_5":14750,"_28174":53080,"_3058":53183},[],"Generate a controlled mutation in a test environment and check that:",{"_3602":830,"_30987":783,"_21467":53185,"_5":14750,"_28174":53080,"_3058":53186},[],"a successful audit event appears;",{"_3602":831,"_30987":783,"_21467":53188,"_5":14750,"_28174":53080,"_3058":53189},[],"the principal matches the identity used;",{"_3602":832,"_30987":783,"_21467":53191,"_5":14750,"_28174":53080,"_3058":53192},[],"the consumer persists it exactly once;",{"_3602":833,"_30987":783,"_21467":53194,"_5":14750,"_28174":53080,"_3058":53195},[],"it can be retrieved by resource, actor and period;",{"_3602":834,"_30987":783,"_21467":53197,"_5":14750,"_28174":53080,"_3058":53198},[],"a consumer outage raises an alert.",{"_3602":835,"_30987":783,"_21467":53200,"_5":14750,"_28174":53080,"_3058":53201},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3602":836,"_30987":836,"_5":15110,"_3058":53203,"_31325":53204,"_21467":53205,"_28174":836},"Platform architecture",[50623,52135],[],{"_3602":837,"_30987":836,"_21467":53207,"_5":14750,"_28174":836,"_3058":53208},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3602":838,"_30987":836,"_5":31322,"_21467":53210,"_28174":53211,"_3058":53212},[],"/docs/platform/concepts/architecture#control-plane","Control plane",{"_3602":839,"_30987":836,"_5":31322,"_21467":53214,"_28174":53215,"_3058":53216},[],"/docs/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3602":840,"_30987":836,"_5":31322,"_21467":53218,"_28174":53219,"_3058":53220},[],"/docs/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3602":841,"_30987":836,"_5":31322,"_21467":53222,"_28174":53223,"_3058":53224},[],"/docs/platform/concepts/architecture#status-and-validation","Status and validation",{"_3602":842,"_30987":836,"_5":31322,"_21467":53226,"_28174":53227,"_3058":53228},[],"/docs/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3602":843,"_30987":836,"_21467":53230,"_5":14750,"_28174":836,"_3058":53231},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3602":844,"_30987":836,"_21467":53233,"_5":14750,"_28174":836,"_3058":53234},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3602":845,"_30987":836,"_21467":53236,"_5":14750,"_28174":53211,"_3058":53237},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3602":846,"_30987":836,"_21467":53239,"_5":14750,"_28174":53215,"_3058":53240},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3602":847,"_30987":836,"_21467":53242,"_5":14750,"_28174":53219,"_3058":53243},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3602":848,"_30987":836,"_21467":53245,"_5":14750,"_28174":53223,"_3058":53246},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3602":849,"_30987":836,"_21467":53248,"_5":14750,"_28174":53227,"_3058":53249},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3602":850,"_30987":850,"_5":15110,"_3058":53251,"_31325":53252,"_21467":53253,"_28174":850},"How Lamassu works",[50623,52135],[],{"_3602":851,"_30987":850,"_21467":53255,"_5":14750,"_28174":850,"_3058":53256},[],"The mental model of trust, keys, certificates and devices.",{"_3602":852,"_30987":850,"_5":31322,"_21467":53258,"_28174":53259,"_3058":53260},[],"/docs/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3602":853,"_30987":850,"_5":31322,"_21467":53262,"_28174":53263,"_3058":53264},[],"/docs/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3602":854,"_30987":850,"_21467":53266,"_5":14750,"_28174":850,"_3058":53267},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3602":855,"_30987":850,"_21467":53269,"_5":14750,"_28174":53259,"_3058":53270},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3602":856,"_30987":850,"_21467":53272,"_5":14750,"_28174":53259,"_3058":53273},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3602":857,"_30987":850,"_21467":53275,"_5":14750,"_28174":53259,"_3058":53276},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3602":858,"_30987":850,"_21467":53278,"_5":14750,"_28174":53259,"_3058":53279},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3602":859,"_30987":850,"_21467":53281,"_5":14750,"_28174":53259,"_3058":53282},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3602":860,"_30987":850,"_21467":53284,"_5":14750,"_28174":53263,"_3058":53285},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3602":861,"_30987":850,"_21467":53287,"_5":14750,"_28174":53263,"_3058":53288},[],"A DMS relates that CA to an enrollment policy.",{"_3602":862,"_30987":850,"_21467":53290,"_5":14750,"_28174":53263,"_3058":53291},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3602":863,"_30987":850,"_21467":53293,"_5":14750,"_28174":53263,"_3058":53294},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3602":864,"_30987":850,"_21467":53296,"_5":14750,"_28174":53263,"_3058":53297},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3602":865,"_30987":850,"_21467":53299,"_5":14750,"_28174":53263,"_3058":53300},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3602":866,"_30987":850,"_21467":53302,"_5":14750,"_28174":53263,"_3058":53303},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3602":867,"_30987":867,"_5":15110,"_3058":53305,"_31325":53306,"_21467":53308,"_28174":867},"Devices and identities",[50623,52135,53307,53305],"IoT Fleets",[],{"_3602":868,"_30987":867,"_21467":53310,"_5":14750,"_28174":867,"_3058":53311},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3602":869,"_30987":867,"_5":31322,"_21467":53313,"_28174":53314,"_3058":53315},[],"/docs/platform/iot-fleets/device-management#device-states","Device states",{"_3602":870,"_30987":867,"_5":31322,"_21467":53317,"_28174":53318,"_3058":53319},[],"/docs/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3602":871,"_30987":867,"_5":31322,"_21467":53321,"_28174":53322,"_3058":53323},[],"/docs/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3602":872,"_30987":867,"_5":31322,"_21467":53325,"_28174":53326,"_3058":53327},[],"/docs/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3602":873,"_30987":867,"_5":31322,"_21467":53329,"_28174":53330,"_3058":53331},[],"/docs/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3602":874,"_30987":867,"_5":31322,"_21467":53333,"_28174":53334,"_3058":53335},[],"/docs/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3602":875,"_30987":867,"_5":31322,"_21467":53337,"_28174":53338,"_3058":53339},[],"/docs/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3602":876,"_30987":867,"_5":31322,"_21467":53341,"_28174":53342,"_3058":53343},[],"/docs/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3602":877,"_30987":867,"_5":31322,"_21467":53345,"_28174":53346,"_3058":53347},[],"/docs/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3602":878,"_30987":867,"_5":31322,"_21467":53349,"_28174":53350,"_3058":53351},[],"/docs/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3602":879,"_30987":867,"_5":31322,"_21467":53353,"_28174":53354,"_3058":53355},[],"/docs/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3602":880,"_30987":867,"_21467":53357,"_5":14750,"_28174":867,"_3058":53358},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3602":881,"_30987":867,"_21467":53360,"_5":14750,"_28174":867,"_3058":53361},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3602":882,"_30987":867,"_21467":53363,"_5":14750,"_28174":53314,"_3058":53364},[],"Operational view",{"_3602":883,"_30987":867,"_21467":53366,"_5":14750,"_28174":53314,"_3058":53367},[],"Meaning",{"_3602":884,"_30987":867,"_21467":53369,"_5":14750,"_28174":53314,"_3058":53370},[],"**No Identity**",{"_3602":885,"_30987":867,"_21467":53372,"_5":14750,"_28174":53314,"_3058":53373},[],"A record exists without an associated identity.",{"_3602":886,"_30987":867,"_21467":53375,"_5":14750,"_28174":53314,"_3058":53376},[],"**Active**",{"_3602":887,"_30987":867,"_21467":53378,"_5":14750,"_28174":53314,"_3058":53379},[],"The slot is active; also check certificate dates, status and usages.",{"_3602":888,"_30987":867,"_21467":53381,"_5":14750,"_28174":53314,"_3058":53382},[],"**Renewal Pending**",{"_3602":889,"_30987":867,"_21467":53384,"_5":14750,"_28174":53314,"_3058":53385},[],"The identity is in the operational renewal window.",{"_3602":890,"_30987":867,"_21467":53387,"_5":14750,"_28174":53314,"_3058":53388},[],"**Expiring Soon**",{"_3602":891,"_30987":867,"_21467":53390,"_5":14750,"_28174":53314,"_3058":53391},[],"Expiration is approaching according to configured thresholds.",{"_3602":892,"_30987":867,"_21467":53393,"_5":14750,"_28174":53314,"_3058":53394},[],"**Expired**",{"_3602":893,"_30987":867,"_21467":53396,"_5":14750,"_28174":53314,"_3058":53397},[],"The identity has expired.",{"_3602":894,"_30987":867,"_21467":53399,"_5":14750,"_28174":53314,"_3058":53400},[],"**Revoked**",{"_3602":895,"_30987":867,"_21467":53402,"_5":14750,"_28174":53314,"_3058":53403},[],"The identity is marked revoked.",{"_3602":896,"_30987":867,"_21467":53405,"_5":14750,"_28174":53314,"_3058":53406},[],"**Decommissioned**",{"_3602":897,"_30987":867,"_21467":53408,"_5":14750,"_28174":53314,"_3058":53409},[],"The record is retired and ordinary updates do not restore operation.",{"_3602":898,"_30987":867,"_21467":53411,"_5":14750,"_28174":53314,"_3058":53412},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3602":899,"_30987":867,"_21467":53414,"_5":14750,"_28174":53318,"_3058":53415},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3602":900,"_30987":867,"_21467":53417,"_5":14750,"_28174":53318,"_3058":53418},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3602":901,"_30987":867,"_21467":53420,"_5":14750,"_28174":53318,"_3058":53421},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3602":902,"_30987":867,"_21467":53423,"_5":14750,"_28174":53318,"_3058":53424},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3602":903,"_30987":867,"_21467":53426,"_5":14750,"_28174":53322,"_3058":53427},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3602":904,"_30987":867,"_21467":53429,"_5":14750,"_28174":53326,"_3058":53430},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3602":905,"_30987":867,"_21467":53432,"_5":14750,"_28174":53330,"_3058":53433},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3602":906,"_30987":867,"_21467":53435,"_5":14750,"_28174":53334,"_3058":53436},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3602":907,"_30987":867,"_21467":53438,"_5":14750,"_28174":53338,"_3058":53439},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3602":908,"_30987":867,"_21467":53441,"_5":14750,"_28174":53338,"_3058":53442},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3602":909,"_30987":867,"_21467":53444,"_5":14750,"_28174":53342,"_3058":53445},[],"From **No Identity**, use **Assign Identity**:",{"_3602":910,"_30987":867,"_21467":53447,"_5":14750,"_28174":53342,"_3058":53448},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3602":911,"_30987":867,"_21467":53450,"_5":14750,"_28174":53342,"_3058":53451},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3602":912,"_30987":867,"_21467":53453,"_5":14750,"_28174":53342,"_3058":53454},[],"Confirm and read the serial, active version and history again.",{"_3602":913,"_30987":867,"_21467":53456,"_5":14750,"_28174":53342,"_3058":53457},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3602":914,"_30987":867,"_21467":53459,"_5":14750,"_28174":53342,"_3058":53460},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3602":915,"_30987":867,"_21467":53462,"_5":14750,"_28174":53346,"_3058":53463},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3602":916,"_30987":867,"_21467":53465,"_5":14750,"_28174":53346,"_3058":53466},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3602":917,"_30987":867,"_21467":53468,"_5":14750,"_28174":53350,"_3058":53469},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3602":918,"_30987":867,"_21467":53471,"_5":14750,"_28174":53350,"_3058":53472},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3602":919,"_30987":867,"_21467":53474,"_5":14750,"_28174":53350,"_3058":53475},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3602":920,"_30987":867,"_21467":53477,"_5":14750,"_28174":53350,"_3058":53478},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3602":921,"_30987":867,"_21467":53480,"_5":14750,"_28174":53354,"_3058":53481},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3602":922,"_30987":867,"_21467":53483,"_5":14750,"_28174":53354,"_3058":53484},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3602":923,"_30987":923,"_5":15110,"_3058":53486,"_31325":53487,"_21467":53489,"_28174":923},"Bootstrap identity and authentication",[50623,52135,53307,53305,53488],"Enrollment with PKI",[],{"_3602":924,"_30987":923,"_21467":53491,"_5":14750,"_28174":923,"_3058":53492},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3602":925,"_30987":923,"_5":31322,"_21467":53494,"_28174":53495,"_3058":53496},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3602":926,"_30987":923,"_5":31322,"_21467":53498,"_28174":53499,"_3058":53500},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3602":927,"_30987":923,"_5":31322,"_21467":53502,"_28174":53503,"_3058":53504},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3602":928,"_30987":923,"_5":31322,"_21467":53506,"_28174":53507,"_3058":53508},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3602":929,"_30987":923,"_5":31322,"_21467":53510,"_28174":53511,"_3058":53512},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3602":930,"_30987":923,"_21467":53514,"_5":14750,"_28174":923,"_3058":53515},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3602":931,"_30987":923,"_21467":53517,"_5":14750,"_28174":53495,"_3058":53518},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3602":932,"_30987":923,"_21467":53520,"_5":14750,"_28174":53495,"_3058":53521},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3602":933,"_30987":923,"_21467":53523,"_5":14750,"_28174":53499,"_3058":53524},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3602":934,"_30987":923,"_21467":53526,"_5":14750,"_28174":53499,"_3058":53527},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3602":935,"_30987":923,"_21467":53529,"_5":14750,"_28174":53499,"_3058":53530},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3602":936,"_30987":923,"_21467":53532,"_5":14750,"_28174":53503,"_3058":53533},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3602":937,"_30987":923,"_21467":53535,"_5":14750,"_28174":53503,"_3058":53536},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3602":938,"_30987":923,"_21467":53538,"_5":14750,"_28174":53507,"_3058":53539},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3602":939,"_30987":923,"_21467":53541,"_5":14750,"_28174":53507,"_3058":53542},[],"Example body:",{"_3602":940,"_30987":923,"_21467":53544,"_5":14750,"_28174":53507,"_3058":53545},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3602":941,"_30987":923,"_21467":53547,"_5":14750,"_28174":53507,"_3058":53548},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3602":942,"_30987":923,"_21467":53550,"_5":14750,"_28174":53507,"_3058":53551},[],"Continuation requires a successful HTTP response and JSON:",{"_3602":943,"_30987":923,"_21467":53553,"_5":14750,"_28174":53507,"_3058":53554},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3602":944,"_30987":923,"_21467":53556,"_5":14750,"_28174":53511,"_3058":53557},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3602":945,"_30987":923,"_21467":53559,"_5":14750,"_28174":53511,"_3058":53560},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3602":946,"_30987":946,"_5":15110,"_3058":53562,"_31325":53563,"_21467":53564,"_28174":946},"Configure and operate the DMS",[50623,52135,53307,53305,53488],[],{"_3602":947,"_30987":946,"_21467":53566,"_5":14750,"_28174":946,"_3058":53567},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3602":948,"_30987":946,"_5":31322,"_21467":53569,"_28174":53570,"_3058":50633},[],"/docs/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3602":949,"_30987":946,"_5":31322,"_21467":53572,"_28174":53573,"_3058":53574},[],"/docs/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3602":950,"_30987":946,"_5":31322,"_21467":53576,"_28174":53577,"_3058":53578},[],"/docs/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3602":951,"_30987":946,"_5":31322,"_21467":53580,"_28174":53581,"_3058":53582},[],"/docs/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3602":952,"_30987":946,"_5":31322,"_21467":53584,"_28174":53585,"_3058":53586},[],"/docs/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3602":953,"_30987":946,"_5":31322,"_21467":53588,"_28174":53589,"_3058":53590},[],"/docs/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3602":954,"_30987":946,"_5":31322,"_21467":53592,"_28174":53593,"_3058":53594},[],"/docs/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3602":955,"_30987":946,"_5":31322,"_21467":53596,"_28174":53597,"_3058":53598},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3602":956,"_30987":946,"_5":31322,"_21467":53600,"_28174":53601,"_3058":53602},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3602":957,"_30987":946,"_5":31322,"_21467":53604,"_28174":53605,"_3058":53606},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3602":958,"_30987":946,"_5":31322,"_21467":53608,"_28174":53609,"_3058":53610},[],"/docs/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3602":959,"_30987":946,"_5":31322,"_21467":53612,"_28174":53613,"_3058":53614},[],"/docs/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3602":960,"_30987":946,"_5":31322,"_21467":53616,"_28174":53617,"_3058":53618},[],"/docs/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3602":961,"_30987":946,"_5":31322,"_21467":53620,"_28174":53621,"_3058":53622},[],"/docs/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3602":962,"_30987":946,"_5":31322,"_21467":53624,"_28174":53625,"_3058":53626},[],"/docs/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3602":963,"_30987":946,"_5":31322,"_21467":53628,"_28174":53629,"_3058":53630},[],"/docs/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3602":964,"_30987":946,"_5":31322,"_21467":53632,"_28174":53633,"_3058":53634},[],"/docs/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3602":965,"_30987":946,"_5":31322,"_21467":53636,"_28174":53637,"_3058":53638},[],"/docs/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3602":966,"_30987":946,"_21467":53640,"_5":14750,"_28174":946,"_3058":53641},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3602":967,"_30987":946,"_21467":53643,"_5":14750,"_28174":53570,"_3058":53644},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3602":968,"_30987":946,"_21467":53646,"_5":14750,"_28174":53570,"_3058":53647},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3602":969,"_30987":946,"_21467":53649,"_5":14750,"_28174":53577,"_3058":53650},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3602":970,"_30987":946,"_21467":53652,"_5":14750,"_28174":53581,"_3058":53653},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3602":971,"_30987":946,"_21467":53655,"_5":14750,"_28174":53585,"_3058":53656},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3602":972,"_30987":946,"_21467":53658,"_5":14750,"_28174":53589,"_3058":53659},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3602":973,"_30987":946,"_21467":53661,"_5":14750,"_28174":53593,"_3058":53662},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3602":974,"_30987":946,"_21467":53664,"_5":14750,"_28174":53601,"_3058":53665},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3602":975,"_30987":946,"_21467":53667,"_5":14750,"_28174":53601,"_3058":53668},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3602":976,"_30987":946,"_21467":53670,"_5":14750,"_28174":53605,"_3058":53671},[],"`settings.enrollment_settings` field",{"_3602":977,"_30987":946,"_21467":53673,"_5":14750,"_28174":53605,"_3058":53674},[],"Decision",{"_3602":978,"_30987":946,"_21467":53676,"_5":14750,"_28174":53605,"_3058":53677},[],"`protocol`",{"_3602":979,"_30987":946,"_21467":53679,"_5":14750,"_28174":53605,"_3058":53680},[],"`EST_RFC7030` for these operations.",{"_3602":980,"_30987":946,"_21467":53682,"_5":14750,"_28174":53605,"_3058":53683},[],"`enrollment_ca`",{"_3602":981,"_30987":946,"_21467":53685,"_5":14750,"_28174":53605,"_3058":53686},[],"ID of the signing CA.",{"_3602":982,"_30987":946,"_21467":53688,"_5":14750,"_28174":53605,"_3058":53689},[],"`verify_csr_signature`",{"_3602":983,"_30987":946,"_21467":53691,"_5":14750,"_28174":53605,"_3058":53692},[],"Keep `true` to verify CSR key possession.",{"_3602":984,"_30987":946,"_21467":53694,"_5":14750,"_28174":53605,"_3058":53695},[],"`enable_replaceable_enrollment`",{"_3602":985,"_30987":946,"_21467":53697,"_5":14750,"_28174":53605,"_3058":53698},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3602":986,"_30987":946,"_21467":53700,"_5":14750,"_28174":53605,"_3058":53701},[],"`est_rfc7030_settings.auth_mode`",{"_3602":987,"_30987":946,"_21467":53703,"_5":14750,"_28174":53605,"_3058":53704},[],"One of the four authentication modes.",{"_3602":988,"_30987":946,"_21467":53706,"_5":14750,"_28174":53605,"_3058":53707},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3602":989,"_30987":946,"_21467":53709,"_5":14750,"_28174":53609,"_3058":53710},[],"The blocks are independent:",{"_3602":990,"_30987":946,"_21467":53712,"_5":14750,"_28174":53609,"_3058":53713},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3602":991,"_30987":946,"_21467":53715,"_5":14750,"_28174":53609,"_3058":53716},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3602":992,"_30987":946,"_21467":53718,"_5":14750,"_28174":53609,"_3058":53719},[],"`auth_mode`",{"_3602":993,"_30987":946,"_21467":53721,"_5":14750,"_28174":53609,"_3058":53722},[],"Control applied in the configured operation",{"_3602":994,"_30987":946,"_21467":53724,"_5":14750,"_28174":53609,"_3058":53725},[],"`CLIENT_CERTIFICATE`",{"_3602":995,"_30987":946,"_21467":53727,"_5":14750,"_28174":53609,"_3058":53728},[],"Presented certificate validation.",{"_3602":996,"_30987":946,"_21467":53730,"_5":14750,"_28174":53609,"_3058":53731},[],"`EXTERNAL_WEBHOOK`",{"_3602":997,"_30987":946,"_21467":53733,"_5":14750,"_28174":53609,"_3058":53734},[],"Configured webhook authorization.",{"_3602":998,"_30987":946,"_21467":53736,"_5":14750,"_28174":53609,"_3058":53737},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3602":999,"_30987":946,"_21467":53739,"_5":14750,"_28174":53609,"_3058":53740},[],"Certificate validation followed by webhook approval.",{"_3602":1000,"_30987":946,"_21467":53742,"_5":14750,"_28174":53609,"_3058":53743},[],"`NO_AUTH`",{"_3602":1001,"_30987":946,"_21467":53745,"_5":14750,"_28174":53609,"_3058":53746},[],"No DMS requester authentication.",{"_3602":1002,"_30987":946,"_21467":53748,"_5":14750,"_28174":53609,"_3058":53749},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3602":1003,"_30987":946,"_21467":53751,"_5":14750,"_28174":53609,"_3058":53752},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3602":1004,"_30987":946,"_21467":53754,"_5":14750,"_28174":53609,"_3058":53755},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3602":1005,"_30987":946,"_21467":53757,"_5":14750,"_28174":53609,"_3058":53758},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3602":1006,"_30987":946,"_21467":53760,"_5":14750,"_28174":53613,"_3058":53761},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3602":1007,"_30987":946,"_21467":53763,"_5":14750,"_28174":53613,"_3058":53764},[],"`external_webhook_settings` field",{"_3602":1008,"_30987":946,"_21467":53766,"_5":14750,"_28174":53613,"_3058":53674},[],{"_3602":1009,"_30987":946,"_21467":53768,"_5":14750,"_28174":53613,"_3058":53769},[],"`url`",{"_3602":1010,"_30987":946,"_21467":53771,"_5":14750,"_28174":53613,"_3058":53772},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3602":1011,"_30987":946,"_21467":53774,"_5":14750,"_28174":53613,"_3058":53775},[],"`method`",{"_3602":1012,"_30987":946,"_21467":53777,"_5":14750,"_28174":53613,"_3058":53778},[],"`POST` or `PUT`; `POST` by default.",{"_3602":1013,"_30987":946,"_21467":53780,"_5":14750,"_28174":53613,"_3058":53781},[],"`name`",{"_3602":1014,"_30987":946,"_21467":53783,"_5":14750,"_28174":53613,"_3058":53784},[],"Label used in service logs.",{"_3602":1015,"_30987":946,"_21467":53786,"_5":14750,"_28174":53613,"_3058":53787},[],"`config.auth_mode`",{"_3602":1016,"_30987":946,"_21467":53789,"_5":14750,"_28174":53613,"_3058":53790},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3602":1017,"_30987":946,"_21467":53792,"_5":14750,"_28174":53613,"_3058":53793},[],"`config.log_level`",{"_3602":1018,"_30987":946,"_21467":53795,"_5":14750,"_28174":53613,"_3058":53796},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3602":1019,"_30987":946,"_21467":53798,"_5":14750,"_28174":53613,"_3058":53799},[],"`config.apikey_options`",{"_3602":1020,"_30987":946,"_21467":53801,"_5":14750,"_28174":53613,"_3058":53802},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3602":1021,"_30987":946,"_21467":53804,"_5":14750,"_28174":53613,"_3058":53805},[],"`config.jwt_options`",{"_3602":1022,"_30987":946,"_21467":53807,"_5":14750,"_28174":53613,"_3058":53808},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3602":1023,"_30987":946,"_21467":53810,"_5":14750,"_28174":53613,"_3058":53811},[],"`config.mtls_options`",{"_3602":1024,"_30987":946,"_21467":53813,"_5":14750,"_28174":53613,"_3058":53814},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3602":1025,"_30987":946,"_21467":53816,"_5":14750,"_28174":53613,"_3058":53817},[],"`config.insecure_skip_verify`",{"_3602":1026,"_30987":946,"_21467":53819,"_5":14750,"_28174":53613,"_3058":53820},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3602":1027,"_30987":946,"_21467":53822,"_5":14750,"_28174":53613,"_3058":53823},[],"`config.call_timeout`",{"_3602":1028,"_30987":946,"_21467":53825,"_5":14750,"_28174":53613,"_3058":53826},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3602":1029,"_30987":946,"_21467":53828,"_5":14750,"_28174":53613,"_3058":53829},[],"Rules for that configuration:",{"_3602":1030,"_30987":946,"_21467":53831,"_5":14750,"_28174":53613,"_3058":53832},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3602":1031,"_30987":946,"_21467":53834,"_5":14750,"_28174":53613,"_3058":53835},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3602":1032,"_30987":946,"_21467":53837,"_5":14750,"_28174":53613,"_3058":53838},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3602":1033,"_30987":946,"_21467":53840,"_5":14750,"_28174":53613,"_3058":53841},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3602":1034,"_30987":946,"_21467":53843,"_5":14750,"_28174":53613,"_3058":53844},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3602":1035,"_30987":946,"_21467":53846,"_5":14750,"_28174":53613,"_3058":53847},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3602":1036,"_30987":946,"_21467":53849,"_5":14750,"_28174":53613,"_3058":53850},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3602":1037,"_30987":946,"_21467":53852,"_5":14750,"_28174":53613,"_3058":53853},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3602":1038,"_30987":946,"_21467":53855,"_5":14750,"_28174":53613,"_3058":53856},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3602":1039,"_30987":946,"_21467":53858,"_5":14750,"_28174":53617,"_3058":53859},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. The resolved profile — including the CA default used as fallback when the DMS defines none — must define an end-entity certificate: a `Sign as CA` profile is rejected at enrollment and re-enrollment time. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3602":1040,"_30987":946,"_21467":53861,"_5":14750,"_28174":53621,"_3058":53862},[],"`settings.reenrollment_settings` field",{"_3602":1041,"_30987":946,"_21467":53864,"_5":14750,"_28174":53621,"_3058":51013},[],{"_3602":1042,"_30987":946,"_21467":53866,"_5":14750,"_28174":53621,"_3058":53867},[],"`reenrollment_delta`",{"_3602":1043,"_30987":946,"_21467":53869,"_5":14750,"_28174":53621,"_3058":53870},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3602":1044,"_30987":946,"_21467":53872,"_5":14750,"_28174":53621,"_3058":53873},[],"`preventive_delta`",{"_3602":1045,"_30987":946,"_21467":53875,"_5":14750,"_28174":53621,"_3058":53876},[],"Preventive operational monitoring threshold.",{"_3602":1046,"_30987":946,"_21467":53878,"_5":14750,"_28174":53621,"_3058":53879},[],"`critical_delta`",{"_3602":1047,"_30987":946,"_21467":53881,"_5":14750,"_28174":53621,"_3058":53882},[],"Critical operational monitoring threshold.",{"_3602":1048,"_30987":946,"_21467":53884,"_5":14750,"_28174":53621,"_3058":53885},[],"`enable_expired_renewal`",{"_3602":1049,"_30987":946,"_21467":53887,"_5":14750,"_28174":53621,"_3058":53888},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3602":1050,"_30987":946,"_21467":53890,"_5":14750,"_28174":53621,"_3058":53891},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3602":1051,"_30987":946,"_21467":53893,"_5":14750,"_28174":53621,"_3058":53894},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3602":1052,"_30987":946,"_21467":53896,"_5":14750,"_28174":53621,"_3058":53897},[],"`revoke_on_reenrollment`",{"_3602":1053,"_30987":946,"_21467":53899,"_5":14750,"_28174":53621,"_3058":53900},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3602":1054,"_30987":946,"_21467":53902,"_5":14750,"_28174":53621,"_3058":53903},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3602":1055,"_30987":946,"_21467":53905,"_5":14750,"_28174":53625,"_3058":53906},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3602":1056,"_30987":946,"_21467":53908,"_5":14750,"_28174":53629,"_3058":51007},[],{"_3602":1057,"_30987":946,"_21467":53910,"_5":14750,"_28174":53629,"_3058":53911},[],"Published material",{"_3602":1058,"_30987":946,"_21467":53913,"_5":14750,"_28174":53629,"_3058":53914},[],"**Include Lamassu System CA**",{"_3602":1059,"_30987":946,"_21467":53916,"_5":14750,"_28174":53629,"_3058":53917},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3602":1060,"_30987":946,"_21467":53919,"_5":14750,"_28174":53629,"_3058":53920},[],"**Include Enrollment CA**",{"_3602":1061,"_30987":946,"_21467":53922,"_5":14750,"_28174":53629,"_3058":53923},[],"Selected issuing CA certificate.",{"_3602":1062,"_30987":946,"_21467":53925,"_5":14750,"_28174":53629,"_3058":53926},[],"**Managed CAs**",{"_3602":1063,"_30987":946,"_21467":53928,"_5":14750,"_28174":53629,"_3058":53929},[],"Explicitly selected CA certificates.",{"_3602":1064,"_30987":946,"_21467":53931,"_5":14750,"_28174":53629,"_3058":53932},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3602":1065,"_30987":946,"_21467":53934,"_5":14750,"_28174":53633,"_3058":53935},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3602":1066,"_30987":946,"_21467":53937,"_5":14750,"_28174":53633,"_3058":53938},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3602":1067,"_30987":946,"_21467":53940,"_5":14750,"_28174":53633,"_3058":53941},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3602":1068,"_30987":946,"_21467":53943,"_5":14750,"_28174":53637,"_3058":53944},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3602":1069,"_30987":1069,"_5":15110,"_3058":53946,"_31325":53947,"_21467":53948,"_28174":1069},"Integrate the EST client",[50623,52135,53307,53305,53488],[],{"_3602":1070,"_30987":1069,"_21467":53950,"_5":14750,"_28174":1069,"_3058":53951},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3602":1071,"_30987":1069,"_5":31322,"_21467":53953,"_28174":53954,"_3058":50633},[],"/docs/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3602":1072,"_30987":1069,"_5":31322,"_21467":53956,"_28174":53957,"_3058":53958},[],"/docs/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3602":1073,"_30987":1069,"_5":31322,"_21467":53960,"_28174":53961,"_3058":53962},[],"/docs/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3602":1074,"_30987":1069,"_5":31322,"_21467":53964,"_28174":53965,"_3058":53966},[],"/docs/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3602":1075,"_30987":1069,"_5":31322,"_21467":53968,"_28174":53969,"_3058":53970},[],"/docs/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3602":1076,"_30987":1069,"_5":31322,"_21467":53972,"_28174":53973,"_3058":53974},[],"/docs/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3602":1077,"_30987":1069,"_21467":53976,"_5":14750,"_28174":1069,"_3058":53977},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3602":1078,"_30987":1069,"_21467":53979,"_5":14750,"_28174":53954,"_3058":53980},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3602":1079,"_30987":1069,"_21467":53982,"_5":14750,"_28174":53954,"_3058":53983},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3602":1080,"_30987":1069,"_21467":53985,"_5":14750,"_28174":53954,"_3058":53986},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3602":1081,"_30987":1069,"_21467":53988,"_5":14750,"_28174":53957,"_3058":53989},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3602":1082,"_30987":1069,"_21467":53991,"_5":14750,"_28174":53957,"_3058":53992},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3602":1083,"_30987":1069,"_21467":53994,"_5":14750,"_28174":53961,"_3058":53995},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3602":1084,"_30987":1069,"_21467":53997,"_5":14750,"_28174":53961,"_3058":53998},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3602":1085,"_30987":1069,"_21467":54000,"_5":14750,"_28174":53965,"_3058":54001},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3602":1086,"_30987":1069,"_21467":54003,"_5":14750,"_28174":53965,"_3058":54004},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3602":1087,"_30987":1069,"_21467":54006,"_5":14750,"_28174":53969,"_3058":54007},[],"For a root that issues directly:",{"_3602":1088,"_30987":1069,"_21467":54009,"_5":14750,"_28174":53969,"_3058":54010},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3602":1089,"_30987":1069,"_21467":54012,"_5":14750,"_28174":53969,"_3058":54013},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3602":1090,"_30987":1069,"_21467":54015,"_5":14750,"_28174":53973,"_3058":54016},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3602":1091,"_30987":1091,"_5":15110,"_3058":54018,"_31325":54019,"_21467":54020,"_28174":1091},"EST reference",[50623,52135,53307,53305,53488],[],{"_3602":1092,"_30987":1091,"_21467":54022,"_5":14750,"_28174":1091,"_3058":54023},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3602":1093,"_30987":1091,"_5":31322,"_21467":54025,"_28174":54026,"_3058":54027},[],"/docs/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3602":1094,"_30987":1091,"_5":31322,"_21467":54029,"_28174":54030,"_3058":23264},[],"/docs/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3602":1095,"_30987":1091,"_5":31322,"_21467":54032,"_28174":54033,"_3058":26730},[],"/docs/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3602":1096,"_30987":1091,"_5":31322,"_21467":54035,"_28174":54036,"_3058":26737},[],"/docs/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3602":1097,"_30987":1091,"_5":31322,"_21467":54038,"_28174":54039,"_3058":26015},[],"/docs/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3602":1098,"_30987":1091,"_5":31322,"_21467":54041,"_28174":54042,"_3058":54043},[],"/docs/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3602":1099,"_30987":1091,"_5":31322,"_21467":54045,"_28174":54046,"_3058":54047},[],"/docs/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3602":1100,"_30987":1091,"_5":31322,"_21467":54049,"_28174":54050,"_3058":54051},[],"/docs/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3602":1101,"_30987":1091,"_21467":54053,"_5":14750,"_28174":1091,"_3058":54054},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3602":1102,"_30987":1091,"_21467":54056,"_5":14750,"_28174":54026,"_3058":54057},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3602":1103,"_30987":1091,"_21467":54059,"_5":14750,"_28174":54026,"_3058":54060},[],"Operation",{"_3602":1104,"_30987":1091,"_21467":54062,"_5":14750,"_28174":54026,"_3058":54063},[],"Method",{"_3602":1105,"_30987":1091,"_21467":54065,"_5":14750,"_28174":54026,"_3058":54066},[],"Authentication and condition",{"_3602":1106,"_30987":1091,"_21467":54068,"_5":14750,"_28174":54026,"_3058":54069},[],"`/cacerts`",{"_3602":1107,"_30987":1091,"_21467":54071,"_5":14750,"_28174":54026,"_3058":54072},[],"GET",{"_3602":1108,"_30987":1091,"_21467":54074,"_5":14750,"_28174":54026,"_3058":54075},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3602":1109,"_30987":1091,"_21467":54077,"_5":14750,"_28174":54026,"_3058":54078},[],"`/simpleenroll`",{"_3602":1110,"_30987":1091,"_21467":54080,"_5":14750,"_28174":54026,"_3058":54081},[],"POST",{"_3602":1111,"_30987":1091,"_21467":54083,"_5":14750,"_28174":54026,"_3058":54084},[],"Initial authentication and DMS registration/replacement policy.",{"_3602":1112,"_30987":1091,"_21467":54086,"_5":14750,"_28174":54026,"_3058":54087},[],"`/simplereenroll`",{"_3602":1113,"_30987":1091,"_21467":54089,"_5":14750,"_28174":54026,"_3058":54081},[],{"_3602":1114,"_30987":1091,"_21467":54091,"_5":14750,"_28174":54026,"_3058":54092},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3602":1115,"_30987":1091,"_21467":54094,"_5":14750,"_28174":54026,"_3058":54095},[],"`/serverkeygen`",{"_3602":1116,"_30987":1091,"_21467":54097,"_5":14750,"_28174":54026,"_3058":54081},[],{"_3602":1117,"_30987":1091,"_21467":54099,"_5":14750,"_28174":54026,"_3058":54100},[],"Initial authentication and admission; server generation enabled.",{"_3602":1118,"_30987":1091,"_21467":54102,"_5":14750,"_28174":54026,"_3058":54103},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3602":1119,"_30987":1091,"_21467":54105,"_5":14750,"_28174":54030,"_3058":54106},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3602":1120,"_30987":1091,"_21467":54108,"_5":14750,"_28174":54030,"_3058":54109},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3602":1121,"_30987":1091,"_21467":54111,"_5":14750,"_28174":54033,"_3058":54112},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3602":1122,"_30987":1091,"_21467":54114,"_5":14750,"_28174":54033,"_3058":54115},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3602":1123,"_30987":1091,"_21467":54117,"_5":14750,"_28174":54036,"_3058":54118},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3602":1124,"_30987":1091,"_21467":54120,"_5":14750,"_28174":54036,"_3058":54121},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3602":1125,"_30987":1091,"_21467":54123,"_5":14750,"_28174":54039,"_3058":54124},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3602":1126,"_30987":1091,"_21467":54126,"_5":14750,"_28174":54039,"_3058":54127},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3602":1127,"_30987":1091,"_21467":54129,"_5":14750,"_28174":54042,"_3058":54130},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3602":1128,"_30987":1091,"_21467":54132,"_5":14750,"_28174":54042,"_3058":54133},[],"Part",{"_3602":1129,"_30987":1091,"_21467":54135,"_5":14750,"_28174":54042,"_3058":54136},[],"Content after decoding its Base64",{"_3602":1130,"_30987":1091,"_21467":54138,"_5":14750,"_28174":54042,"_3058":54139},[],"`application/pkcs8`",{"_3602":1131,"_30987":1091,"_21467":54141,"_5":14750,"_28174":54042,"_3058":54142},[],"Unencrypted DER PKCS#8 private key.",{"_3602":1132,"_30987":1091,"_21467":54144,"_5":14750,"_28174":54042,"_3058":54145},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3602":1133,"_30987":1091,"_21467":54147,"_5":14750,"_28174":54042,"_3058":54148},[],"DER PKCS#7 containing the issued certificate.",{"_3602":1134,"_30987":1091,"_21467":54150,"_5":14750,"_28174":54042,"_3058":54151},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3602":1135,"_30987":1091,"_21467":54153,"_5":14750,"_28174":54046,"_3058":54154},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3602":1136,"_30987":1091,"_21467":54156,"_5":14750,"_28174":54046,"_3058":54157},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3602":1137,"_30987":1091,"_21467":54159,"_5":14750,"_28174":54046,"_3058":54160},[],"Convert and check the result:",{"_3602":1138,"_30987":1091,"_21467":54162,"_5":14750,"_28174":54046,"_3058":54163},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3602":1139,"_30987":1091,"_21467":54165,"_5":14750,"_28174":54050,"_3058":54166},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3602":1140,"_30987":1091,"_21467":54168,"_5":14750,"_28174":54050,"_3058":54169},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3602":1141,"_30987":1141,"_5":15110,"_3058":53488,"_31325":54171,"_21467":54172,"_28174":1141},[50623,52135,53307,53305,53488],[],{"_3602":1142,"_30987":1141,"_21467":54174,"_5":14750,"_28174":1141,"_3058":54175},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3602":1143,"_30987":1141,"_5":31322,"_21467":54177,"_28174":54178,"_3058":54179},[],"/docs/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3602":1144,"_30987":1141,"_5":31322,"_21467":54181,"_28174":54182,"_3058":54183},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3602":1145,"_30987":1141,"_5":31322,"_21467":54185,"_28174":54186,"_3058":54187},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3602":1146,"_30987":1141,"_5":31322,"_21467":54189,"_28174":54190,"_3058":54191},[],"/docs/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3602":1147,"_30987":1141,"_21467":54193,"_5":14750,"_28174":1141,"_3058":54194},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3602":1148,"_30987":1141,"_21467":54196,"_5":14750,"_28174":54178,"_3058":54197},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3602":1149,"_30987":1141,"_21467":54199,"_5":14750,"_28174":54178,"_3058":54200},[],"The integrator installs initial EST server trust and an admission credential.",{"_3602":1150,"_30987":1141,"_21467":54202,"_5":14750,"_28174":54178,"_3058":54203},[],"The client requests an identity for its `Device ID` through EST.",{"_3602":1151,"_30987":1141,"_21467":54205,"_5":14750,"_28174":54178,"_3058":54206},[],"Certificate, device binding and key/certificate installation are checked.",{"_3602":1152,"_30987":1141,"_21467":54208,"_5":14750,"_28174":54178,"_3058":54209},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3602":1153,"_30987":1141,"_21467":54211,"_5":14750,"_28174":54178,"_3058":54212},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3602":1154,"_30987":1141,"_21467":54214,"_5":14750,"_28174":54182,"_3058":54215},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3602":1155,"_30987":1141,"_21467":54217,"_5":14750,"_28174":54182,"_3058":54218},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3602":1156,"_30987":1141,"_21467":54220,"_5":14750,"_28174":54182,"_3058":54221},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3602":1157,"_30987":1141,"_21467":54223,"_5":14750,"_28174":54182,"_3058":54224},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3602":1158,"_30987":1141,"_21467":54226,"_5":14750,"_28174":54186,"_3058":54227},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3602":1159,"_30987":1141,"_21467":54229,"_5":14750,"_28174":54186,"_3058":54230},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3602":1160,"_30987":1141,"_21467":54232,"_5":14750,"_28174":54186,"_3058":54233},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3602":1161,"_30987":1141,"_21467":54235,"_5":14750,"_28174":54186,"_3058":54236},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3602":1162,"_30987":1141,"_21467":54238,"_5":14750,"_28174":54190,"_3058":54239},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3602":1163,"_30987":1141,"_21467":54241,"_5":14750,"_28174":54190,"_3058":54242},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3602":1164,"_30987":1164,"_5":15110,"_3058":54244,"_31325":54245,"_21467":54246,"_28174":1164},"Provisioning strategies",[50623,52135,53307,53305,53488],[],{"_3602":1165,"_30987":1164,"_21467":54248,"_5":14750,"_28174":1164,"_3058":54249},[],"Choose device registration, identity authorization and key generation.",{"_3602":1166,"_30987":1164,"_5":31322,"_21467":54251,"_28174":54252,"_3058":54253},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3602":1167,"_30987":1164,"_5":31322,"_21467":54255,"_28174":54256,"_3058":54257},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3602":1168,"_30987":1164,"_5":31322,"_21467":54259,"_28174":54260,"_3058":54261},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3602":1169,"_30987":1164,"_5":31322,"_21467":54263,"_28174":54264,"_3058":54265},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3602":1170,"_30987":1164,"_5":31322,"_21467":54267,"_28174":54268,"_3058":54269},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3602":1171,"_30987":1164,"_21467":54271,"_5":14750,"_28174":1164,"_3058":54272},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3602":1172,"_30987":1164,"_21467":54274,"_5":14750,"_28174":54252,"_3058":54275},[],"Path",{"_3602":1173,"_30987":1164,"_21467":54277,"_5":14750,"_28174":54252,"_3058":54278},[],"When the device exists",{"_3602":1174,"_30987":1164,"_21467":54280,"_5":14750,"_28174":54252,"_3058":54281},[],"What to check",{"_3602":1175,"_30987":1164,"_21467":54283,"_5":14750,"_28174":54252,"_3058":54284},[],"Manual assignment",{"_3602":1176,"_30987":1164,"_21467":54286,"_5":14750,"_28174":54252,"_3058":54287},[],"An operator creates it before associating a certificate.",{"_3602":1177,"_30987":1164,"_21467":54289,"_5":14750,"_28174":54252,"_3058":54290},[],"ID, owning DMS, certificate CN and bound serial.",{"_3602":1178,"_30987":1164,"_21467":54292,"_5":14750,"_28174":54252,"_3058":54293},[],"EST with `JITP`",{"_3602":1179,"_30987":1164,"_21467":54295,"_5":14750,"_28174":54252,"_3058":54296},[],"Created for an unknown CN during `/simpleenroll`.",{"_3602":1180,"_30987":1164,"_21467":54298,"_5":14750,"_28174":54252,"_3058":54299},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3602":1181,"_30987":1164,"_21467":54301,"_5":14750,"_28174":54252,"_3058":54302},[],"EST with `PRE_REGISTRATION`",{"_3602":1182,"_30987":1164,"_21467":54304,"_5":14750,"_28174":54252,"_3058":54305},[],"Must exist before `/simpleenroll`.",{"_3602":1183,"_30987":1164,"_21467":54307,"_5":14750,"_28174":54252,"_3058":54308},[],"Approved record, same DMS and replacement conditions for your version.",{"_3602":1184,"_30987":1164,"_21467":54310,"_5":14750,"_28174":54252,"_3058":54311},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3602":1185,"_30987":1164,"_21467":54313,"_5":14750,"_28174":54252,"_3058":54314},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3602":1186,"_30987":1164,"_21467":54316,"_5":14750,"_28174":54256,"_3058":54317},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3602":1187,"_30987":1164,"_21467":54319,"_5":14750,"_28174":54256,"_3058":54320},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3602":1188,"_30987":1164,"_21467":54322,"_5":14750,"_28174":54256,"_3058":54323},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3602":1189,"_30987":1164,"_21467":54325,"_5":14750,"_28174":54260,"_3058":54326},[],"Decide initial enrollment and re-enrollment separately:",{"_3602":1190,"_30987":1164,"_21467":54328,"_5":14750,"_28174":54260,"_3058":54329},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3602":1191,"_30987":1164,"_21467":54331,"_5":14750,"_28174":54260,"_3058":54332},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3602":1192,"_30987":1164,"_21467":54334,"_5":14750,"_28174":54260,"_3058":54335},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3602":1193,"_30987":1164,"_21467":54337,"_5":14750,"_28174":54260,"_3058":54338},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3602":1194,"_30987":1164,"_21467":54340,"_5":14750,"_28174":54260,"_3058":54341},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3602":1195,"_30987":1164,"_21467":54343,"_5":14750,"_28174":54264,"_3058":51007},[],{"_3602":1196,"_30987":1164,"_21467":54345,"_5":14750,"_28174":54264,"_3058":54346},[],"Material crossing EST",{"_3602":1197,"_30987":1164,"_21467":54348,"_5":14750,"_28174":54264,"_3058":54349},[],"Device-generated key",{"_3602":1198,"_30987":1164,"_21467":54351,"_5":14750,"_28174":54264,"_3058":54352},[],"Public CSR and certificate; the key stays on the client.",{"_3602":1199,"_30987":1164,"_21467":54354,"_5":14750,"_28174":54264,"_3058":54355},[],"Existing device key",{"_3602":1200,"_30987":1164,"_21467":54357,"_5":14750,"_28174":54264,"_3058":54358},[],"CSR signed with that key and a new certificate.",{"_3602":1201,"_30987":1164,"_21467":54360,"_5":14750,"_28174":54264,"_3058":53626},[],{"_3602":1202,"_30987":1164,"_21467":54362,"_5":14750,"_28174":54264,"_3058":54363},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3602":1203,"_30987":1164,"_21467":54365,"_5":14750,"_28174":54264,"_3058":54366},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3602":1204,"_30987":1164,"_21467":54368,"_5":14750,"_28174":54268,"_3058":54369},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3602":1205,"_30987":1205,"_5":15110,"_3058":54371,"_31325":54372,"_21467":54373,"_28174":1205},"Renewal and recovery",[50623,52135,53307,53305,53488],[],{"_3602":1206,"_30987":1205,"_21467":54375,"_5":14750,"_28174":1205,"_3058":54376},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3602":1207,"_30987":1205,"_5":31322,"_21467":54378,"_28174":54379,"_3058":54380},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3602":1208,"_30987":1205,"_5":31322,"_21467":54382,"_28174":54383,"_3058":54384},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3602":1209,"_30987":1205,"_5":31322,"_21467":54386,"_28174":54387,"_3058":54388},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3602":1210,"_30987":1205,"_5":31322,"_21467":54390,"_28174":54391,"_3058":54392},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3602":1211,"_30987":1205,"_5":31322,"_21467":54394,"_28174":54395,"_3058":54396},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3602":1212,"_30987":1205,"_21467":54398,"_5":14750,"_28174":1205,"_3058":54399},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3602":1213,"_30987":1205,"_21467":54401,"_5":14750,"_28174":54379,"_3058":54402},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3602":1214,"_30987":1205,"_21467":54404,"_5":14750,"_28174":54379,"_3058":54405},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3602":1215,"_30987":1205,"_21467":54407,"_5":14750,"_28174":54379,"_3058":54408},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3602":1216,"_30987":1205,"_21467":54410,"_5":14750,"_28174":54379,"_3058":54411},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3602":1217,"_30987":1205,"_21467":54413,"_5":14750,"_28174":54383,"_3058":54414},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3602":1218,"_30987":1205,"_21467":54416,"_5":14750,"_28174":54383,"_3058":54417},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3602":1219,"_30987":1205,"_21467":54419,"_5":14750,"_28174":54387,"_3058":54420},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3602":1220,"_30987":1205,"_21467":54422,"_5":14750,"_28174":54387,"_3058":54423},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3602":1221,"_30987":1205,"_21467":54425,"_5":14750,"_28174":54387,"_3058":54426},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3602":1222,"_30987":1205,"_21467":54428,"_5":14750,"_28174":54391,"_3058":54429},[],"Situation",{"_3602":1223,"_30987":1205,"_21467":54431,"_5":14750,"_28174":54391,"_3058":54432},[],"Procedure",{"_3602":1224,"_30987":1205,"_21467":54434,"_5":14750,"_28174":54391,"_3058":54435},[],"Valid certificate, outside the window",{"_3602":1225,"_30987":1205,"_21467":54437,"_5":14750,"_28174":54391,"_3058":54438},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3602":1226,"_30987":1205,"_21467":54440,"_5":14750,"_28174":54391,"_3058":54441},[],"Expired certificate, key available",{"_3602":1227,"_30987":1205,"_21467":54443,"_5":14750,"_28174":54391,"_3058":54444},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3602":1228,"_30987":1205,"_21467":54446,"_5":14750,"_28174":54391,"_3058":54447},[],"Renewal through webhook or `NO_AUTH`",{"_3602":1229,"_30987":1205,"_21467":54449,"_5":14750,"_28174":54391,"_3058":54450},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3602":1230,"_30987":1205,"_21467":54452,"_5":14750,"_28174":54391,"_3058":54453},[],"Lost or inaccessible key",{"_3602":1231,"_30987":1205,"_21467":54455,"_5":14750,"_28174":54391,"_3058":54456},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3602":1232,"_30987":1205,"_21467":54458,"_5":14750,"_28174":54391,"_3058":54459},[],"Current identity revoked",{"_3602":1233,"_30987":1205,"_21467":54461,"_5":14750,"_28174":54391,"_3058":54462},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3602":1234,"_30987":1205,"_21467":54464,"_5":14750,"_28174":54391,"_3058":54465},[],"Device without an identity",{"_3602":1235,"_30987":1205,"_21467":54467,"_5":14750,"_28174":54391,"_3058":54468},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3602":1236,"_30987":1205,"_21467":54470,"_5":14750,"_28174":54391,"_3058":54471},[],"Retired device",{"_3602":1237,"_30987":1205,"_21467":54473,"_5":14750,"_28174":54391,"_3058":54474},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3602":1238,"_30987":1205,"_21467":54476,"_5":14750,"_28174":54391,"_3058":54477},[],"Timeout, HTTP 500 or installation failure",{"_3602":1239,"_30987":1205,"_21467":54479,"_5":14750,"_28174":54391,"_3058":54480},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3602":1240,"_30987":1205,"_21467":54482,"_5":14750,"_28174":54395,"_3058":54483},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3602":1241,"_30987":1205,"_21467":54485,"_5":14750,"_28174":54395,"_3058":54486},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3602":1242,"_30987":1242,"_5":15110,"_3058":54488,"_31325":54489,"_21467":54490,"_28174":1242},"Enrollment troubleshooting",[50623,52135,53307,53305,53488],[],{"_3602":1243,"_30987":1242,"_21467":54492,"_5":14750,"_28174":1242,"_3058":54493},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3602":1244,"_30987":1242,"_5":31322,"_21467":54495,"_28174":54496,"_3058":54497},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3602":1245,"_30987":1242,"_5":31322,"_21467":54499,"_28174":54500,"_3058":54501},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3602":1246,"_30987":1242,"_5":31322,"_21467":54503,"_28174":54504,"_3058":54051},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3602":1247,"_30987":1242,"_5":31322,"_21467":54506,"_28174":54507,"_3058":54508},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3602":1248,"_30987":1242,"_21467":54510,"_5":14750,"_28174":1242,"_3058":54511},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3602":1249,"_30987":1242,"_21467":54513,"_5":14750,"_28174":54500,"_3058":54514},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3602":1250,"_30987":1242,"_21467":54516,"_5":14750,"_28174":54500,"_3058":54517},[],"Symptom or message",{"_3602":1251,"_30987":1242,"_21467":54519,"_5":14750,"_28174":54500,"_3058":54281},[],{"_3602":1252,"_30987":1242,"_21467":54521,"_5":14750,"_28174":54500,"_3058":54522},[],"curl rejects TLS, name or issuer",{"_3602":1253,"_30987":1242,"_21467":54524,"_5":14750,"_28174":54500,"_3058":54525},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3602":1254,"_30987":1242,"_21467":54527,"_5":14750,"_28174":54500,"_3058":54528},[],"404 or missing APS",{"_3602":1255,"_30987":1242,"_21467":54530,"_5":14750,"_28174":54500,"_3058":54531},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3602":1256,"_30987":1242,"_21467":54533,"_5":14750,"_28174":54500,"_3058":54534},[],"400, CSR or format error",{"_3602":1257,"_30987":1242,"_21467":54536,"_5":14750,"_28174":54500,"_3058":54537},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3602":1258,"_30987":1242,"_21467":54539,"_5":14750,"_28174":54500,"_3058":54540},[],"Missing credential or invalid certificate",{"_3602":1259,"_30987":1242,"_21467":54542,"_5":14750,"_28174":54500,"_3058":54543},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3602":1260,"_30987":1242,"_21467":54545,"_5":14750,"_28174":54500,"_3058":54546},[],"Webhook denies, times out or responds without authorization",{"_3602":1261,"_30987":1242,"_21467":54548,"_5":14750,"_28174":54500,"_3058":54549},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3602":1262,"_30987":1242,"_21467":54551,"_5":14750,"_28174":54500,"_3058":54552},[],"`unexpected status code: <n>: redirects are not followed`",{"_3602":1263,"_30987":1242,"_21467":54554,"_5":14750,"_28174":54500,"_3058":54555},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3602":1264,"_30987":1242,"_21467":54557,"_5":14750,"_28174":54500,"_3058":54558},[],"`webhook response exceeds 1048576 bytes`",{"_3602":1265,"_30987":1242,"_21467":54560,"_5":14750,"_28174":54500,"_3058":54561},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3602":1266,"_30987":1242,"_21467":54563,"_5":14750,"_28174":54500,"_3058":54564},[],"`webhook config must not reference files`",{"_3602":1267,"_30987":1242,"_21467":54566,"_5":14750,"_28174":54500,"_3058":54567},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3602":1268,"_30987":1242,"_21467":54569,"_5":14750,"_28174":54500,"_3058":54570},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3602":1269,"_30987":1242,"_21467":54572,"_5":14750,"_28174":54500,"_3058":54573},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3602":1270,"_30987":1242,"_21467":54575,"_5":14750,"_28174":54500,"_3058":54576},[],"`webhook mTLS certificate and key are invalid: …`",{"_3602":1271,"_30987":1242,"_21467":54578,"_5":14750,"_28174":54500,"_3058":54579},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3602":1272,"_30987":1242,"_21467":54581,"_5":14750,"_28174":54500,"_3058":54582},[],"400 `struct validation error` creating or updating a DMS",{"_3602":1273,"_30987":1242,"_21467":54584,"_5":14750,"_28174":54500,"_3058":54585},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3602":1274,"_30987":1242,"_21467":54587,"_5":14750,"_28174":54500,"_3058":54588},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3602":1275,"_30987":1242,"_21467":54590,"_5":14750,"_28174":54500,"_3058":54591},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3602":1276,"_30987":1242,"_21467":54593,"_5":14750,"_28174":54500,"_3058":54594},[],"`device not preregistered`",{"_3602":1277,"_30987":1242,"_21467":54596,"_5":14750,"_28174":54500,"_3058":54597},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3602":1278,"_30987":1242,"_21467":54599,"_5":14750,"_28174":54500,"_3058":54600},[],"`forbiddenNewEnrollment`",{"_3602":1279,"_30987":1242,"_21467":54602,"_5":14750,"_28174":54500,"_3058":54603},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3602":1280,"_30987":1242,"_21467":54605,"_5":14750,"_28174":54500,"_3058":54606},[],"Different owning DMS",{"_3602":1281,"_30987":1242,"_21467":54608,"_5":14750,"_28174":54500,"_3058":54609},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3602":1282,"_30987":1242,"_21467":54611,"_5":14750,"_28174":54500,"_3058":54612},[],"`invalid RawSubject bytes`",{"_3602":1283,"_30987":1242,"_21467":54614,"_5":14750,"_28174":54500,"_3058":54615},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3602":1284,"_30987":1242,"_21467":54617,"_5":14750,"_28174":54500,"_3058":54618},[],"`invalid reenroll window`",{"_3602":1285,"_30987":1242,"_21467":54620,"_5":14750,"_28174":54500,"_3058":54621},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3602":1286,"_30987":1242,"_21467":54623,"_5":14750,"_28174":54500,"_3058":54624},[],"Current certificate revoked",{"_3602":1287,"_30987":1242,"_21467":54626,"_5":14750,"_28174":54500,"_3058":54627},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3602":1288,"_30987":1242,"_21467":54629,"_5":14750,"_28174":54500,"_3058":54630},[],"CA, profile or signing error",{"_3602":1289,"_30987":1242,"_21467":54632,"_5":14750,"_28174":54500,"_3058":54633},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3602":1290,"_30987":1242,"_21467":54635,"_5":14750,"_28174":54500,"_3058":54636},[],"HTTP 200 without a device connection",{"_3602":1291,"_30987":1242,"_21467":54638,"_5":14750,"_28174":54500,"_3058":54639},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3602":1292,"_30987":1242,"_21467":54641,"_5":14750,"_28174":54500,"_3058":54642},[],"Timeout or error after issuance",{"_3602":1293,"_30987":1242,"_21467":54644,"_5":14750,"_28174":54500,"_3058":54645},[],"New certificates, current slot and previous identity's state before retrying.",{"_3602":1294,"_30987":1242,"_21467":54647,"_5":14750,"_28174":54504,"_3058":54648},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3602":1295,"_30987":1242,"_21467":54650,"_5":14750,"_28174":54504,"_3058":54651},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3602":1296,"_30987":1242,"_21467":54653,"_5":14750,"_28174":54507,"_3058":54654},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3602":1297,"_30987":1242,"_21467":54656,"_5":14750,"_28174":54507,"_3058":54657},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3602":1298,"_30987":1242,"_21467":54659,"_5":14750,"_28174":54507,"_3058":54660},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3602":1299,"_30987":1242,"_21467":54662,"_5":14750,"_28174":54507,"_3058":54663},[],"Make one request, save headers/body and query the device and certificates.",{"_3602":1300,"_30987":1242,"_21467":54665,"_5":14750,"_28174":54507,"_3058":54666},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3602":1301,"_30987":1242,"_21467":54668,"_5":14750,"_28174":54507,"_3058":54669},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3602":1302,"_30987":1242,"_21467":54671,"_5":14750,"_28174":54507,"_3058":54672},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3602":1303,"_30987":1303,"_5":15110,"_3058":54674,"_31325":54675,"_21467":54676,"_28174":1303},"Trust distribution and updates",[50623,52135,53307,53305,53488],[],{"_3602":1304,"_30987":1303,"_21467":54678,"_5":14750,"_28174":1303,"_3058":54679},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3602":1305,"_30987":1303,"_5":31322,"_21467":54681,"_28174":54682,"_3058":54683},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3602":1306,"_30987":1303,"_5":31322,"_21467":54685,"_28174":54686,"_3058":54687},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3602":1307,"_30987":1303,"_5":31322,"_21467":54689,"_28174":54690,"_3058":54691},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3602":1308,"_30987":1303,"_5":31322,"_21467":54693,"_28174":54694,"_3058":54695},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3602":1309,"_30987":1303,"_5":31322,"_21467":54697,"_28174":54698,"_3058":54699},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3602":1310,"_30987":1303,"_21467":54701,"_5":14750,"_28174":1303,"_3058":54702},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3602":1311,"_30987":1303,"_21467":54704,"_5":14750,"_28174":54682,"_3058":54705},[],"Relationship",{"_3602":1312,"_30987":1303,"_21467":54707,"_5":14750,"_28174":54682,"_3058":54708},[],"Material prepared by its owner",{"_3602":1313,"_30987":1303,"_21467":54710,"_5":14750,"_28174":54682,"_3058":54711},[],"Device → EST server",{"_3602":1314,"_30987":1303,"_21467":54713,"_5":14750,"_28174":54682,"_3058":54714},[],"Previously verified server root, chain or pin and TLS name.",{"_3602":1315,"_30987":1303,"_21467":54716,"_5":14750,"_28174":54682,"_3058":54717},[],"DMS → requester",{"_3602":1316,"_30987":1303,"_21467":54719,"_5":14750,"_28174":54682,"_3058":54720},[],"CAs and rules authorizing initial or renewal credentials.",{"_3602":1317,"_30987":1303,"_21467":54722,"_5":14750,"_28174":54682,"_3058":54723},[],"Consumer → device",{"_3602":1318,"_30987":1303,"_21467":54725,"_5":14750,"_28174":54682,"_3058":54726},[],"Operational identity roots, intermediates, validation and permissions.",{"_3602":1319,"_30987":1303,"_21467":54728,"_5":14750,"_28174":54682,"_3058":54729},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3602":1320,"_30987":1303,"_21467":54731,"_5":14750,"_28174":54686,"_3058":54732},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3602":1321,"_30987":1303,"_21467":54734,"_5":14750,"_28174":54686,"_3058":54735},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3602":1322,"_30987":1303,"_21467":54737,"_5":14750,"_28174":54690,"_3058":54738},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3602":1323,"_30987":1303,"_21467":54740,"_5":14750,"_28174":54690,"_3058":54741},[],"Select policy-approved roots as anchors.",{"_3602":1324,"_30987":1303,"_21467":54743,"_5":14750,"_28174":54690,"_3058":54744},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3602":1325,"_30987":1303,"_21467":54746,"_5":14750,"_28174":54690,"_3058":54747},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3602":1326,"_30987":1303,"_21467":54749,"_5":14750,"_28174":54690,"_3058":54750},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3602":1327,"_30987":1303,"_21467":54752,"_5":14750,"_28174":54690,"_3058":54753},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3602":1328,"_30987":1303,"_21467":54755,"_5":14750,"_28174":54694,"_3058":54756},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3602":1329,"_30987":1303,"_21467":54758,"_5":14750,"_28174":54694,"_3058":54759},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3602":1330,"_30987":1303,"_21467":54761,"_5":14750,"_28174":54694,"_3058":54762},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3602":1331,"_30987":1303,"_21467":54764,"_5":14750,"_28174":54698,"_3058":54765},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3602":1332,"_30987":1332,"_5":15110,"_3058":54767,"_31325":54768,"_21467":54770,"_28174":1332},"AWS IoT Core",[50623,52135,53307,53305,54769],"Integrations",[],{"_3602":1333,"_30987":1332,"_21467":54772,"_5":14750,"_28174":1332,"_3058":54773},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3602":1334,"_30987":1332,"_5":31322,"_21467":54775,"_28174":54776,"_3058":54777},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3602":1335,"_30987":1332,"_5":31322,"_21467":54779,"_28174":54780,"_3058":54781},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3602":1336,"_30987":1332,"_5":31322,"_21467":54783,"_28174":54784,"_3058":54785},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3602":1337,"_30987":1332,"_5":31322,"_21467":54787,"_28174":54788,"_3058":54789},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3602":1338,"_30987":1332,"_5":31322,"_21467":54791,"_28174":54792,"_3058":54793},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3602":1339,"_30987":1332,"_5":31322,"_21467":54795,"_28174":54796,"_3058":54797},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3602":1340,"_30987":1332,"_5":31322,"_21467":54799,"_28174":54800,"_3058":54801},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3602":1341,"_30987":1332,"_5":31322,"_21467":54803,"_28174":54804,"_3058":54805},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3602":1342,"_30987":1332,"_5":31322,"_21467":54807,"_28174":54808,"_3058":54809},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3602":1343,"_30987":1332,"_5":31322,"_21467":54811,"_28174":54812,"_3058":54813},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3602":1344,"_30987":1332,"_5":31322,"_21467":54815,"_28174":54816,"_3058":54817},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3602":1345,"_30987":1332,"_5":31322,"_21467":54819,"_28174":54820,"_3058":54821},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3602":1346,"_30987":1332,"_5":31322,"_21467":54823,"_28174":54824,"_3058":54825},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3602":1347,"_30987":1332,"_5":31322,"_21467":54827,"_28174":54828,"_3058":54829},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3602":1348,"_30987":1332,"_5":31322,"_21467":54831,"_28174":54832,"_3058":54833},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3602":1349,"_30987":1332,"_5":31322,"_21467":54835,"_28174":54836,"_3058":54837},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3602":1350,"_30987":1332,"_5":31322,"_21467":54839,"_28174":54840,"_3058":54841},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3602":1351,"_30987":1332,"_5":31322,"_21467":54843,"_28174":54844,"_3058":54845},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3602":1352,"_30987":1332,"_5":31322,"_21467":54847,"_28174":54848,"_3058":54849},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3602":1353,"_30987":1332,"_5":31322,"_21467":54851,"_28174":54852,"_3058":54853},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3602":1354,"_30987":1332,"_5":31322,"_21467":54855,"_28174":54856,"_3058":54857},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3602":1355,"_30987":1332,"_5":31322,"_21467":54859,"_28174":54860,"_3058":54861},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3602":1356,"_30987":1332,"_5":31322,"_21467":54863,"_28174":54864,"_3058":54865},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3602":1357,"_30987":1332,"_5":31322,"_21467":54867,"_28174":54868,"_3058":54869},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3602":1358,"_30987":1332,"_5":31322,"_21467":54871,"_28174":54872,"_3058":54873},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3602":1359,"_30987":1332,"_21467":54875,"_5":14750,"_28174":1332,"_3058":54876},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3602":1360,"_30987":1332,"_21467":54878,"_5":14750,"_28174":1332,"_3058":54879},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3602":1361,"_30987":1332,"_21467":54881,"_5":14750,"_28174":1332,"_3058":54882},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3602":1362,"_30987":1332,"_21467":54884,"_5":14750,"_28174":54776,"_3058":54885},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3602":1363,"_30987":1332,"_21467":54887,"_5":14750,"_28174":54776,"_3058":54888},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3602":1364,"_30987":1332,"_21467":54890,"_5":14750,"_28174":54776,"_3058":54891},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3602":1365,"_30987":1332,"_21467":54893,"_5":14750,"_28174":54776,"_3058":54894},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3602":1366,"_30987":1332,"_21467":54896,"_5":14750,"_28174":54780,"_3058":54897},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3602":1367,"_30987":1332,"_21467":54899,"_5":14750,"_28174":54784,"_3058":54900},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3602":1368,"_30987":1332,"_21467":54902,"_5":14750,"_28174":54784,"_3058":54903},[],"IAM action",{"_3602":1369,"_30987":1332,"_21467":54905,"_5":14750,"_28174":54784,"_3058":51013},[],{"_3602":1370,"_30987":1332,"_21467":54907,"_5":14750,"_28174":54784,"_3058":54908},[],"`iot:GetRegistrationCode`",{"_3602":1371,"_30987":1332,"_21467":54910,"_5":14750,"_28174":54784,"_3058":54911},[],"Obtain the verification code for CA registration in the Primary Account",{"_3602":1372,"_30987":1332,"_21467":54913,"_5":14750,"_28174":54784,"_3058":54914},[],"`iot:RegisterCACertificate`",{"_3602":1373,"_30987":1332,"_21467":54916,"_5":14750,"_28174":54784,"_3058":54917},[],"Register the CA in AWS IoT",{"_3602":1374,"_30987":1332,"_21467":54919,"_5":14750,"_28174":54784,"_3058":54920},[],"`iot:DescribeCACertificate`",{"_3602":1375,"_30987":1332,"_21467":54922,"_5":14750,"_28174":54784,"_3058":54923},[],"Check the CA registration status",{"_3602":1376,"_30987":1332,"_21467":54925,"_5":14750,"_28174":54784,"_3058":54926},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3602":1377,"_30987":1332,"_21467":54928,"_5":14750,"_28174":54784,"_3058":54929},[],"Create or update Things in IoT Core",{"_3602":1378,"_30987":1332,"_21467":54931,"_5":14750,"_28174":54784,"_3058":54932},[],"`iot:RegisterThing`",{"_3602":1379,"_30987":1332,"_21467":54934,"_5":14750,"_28174":54784,"_3058":54935},[],"Provision Things through a template",{"_3602":1380,"_30987":1332,"_21467":54937,"_5":14750,"_28174":54784,"_3058":54938},[],"`iot:RegisterCertificate`",{"_3602":1381,"_30987":1332,"_21467":54940,"_5":14750,"_28174":54784,"_3058":54941},[],"Register device certificates",{"_3602":1382,"_30987":1332,"_21467":54943,"_5":14750,"_28174":54784,"_3058":54944},[],"`iot:UpdateCertificate`",{"_3602":1383,"_30987":1332,"_21467":54946,"_5":14750,"_28174":54784,"_3058":54947},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3602":1384,"_30987":1332,"_21467":54949,"_5":14750,"_28174":54784,"_3058":54950},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3602":1385,"_30987":1332,"_21467":54952,"_5":14750,"_28174":54784,"_3058":54953},[],"Create and attach IoT policies",{"_3602":1386,"_30987":1332,"_21467":54955,"_5":14750,"_28174":54784,"_3058":54956},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3602":1387,"_30987":1332,"_21467":54958,"_5":14750,"_28174":54784,"_3058":54959},[],"Manage Thing groups",{"_3602":1388,"_30987":1332,"_21467":54961,"_5":14750,"_28174":54784,"_3058":54962},[],"`iot:CreateProvisioningTemplate`",{"_3602":1389,"_30987":1332,"_21467":54964,"_5":14750,"_28174":54784,"_3058":54965},[],"Create JITP templates",{"_3602":1390,"_30987":1332,"_21467":54967,"_5":14750,"_28174":54784,"_3058":54968},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3602":1391,"_30987":1332,"_21467":54970,"_5":14750,"_28174":54784,"_3058":54971},[],"Read and write the Device Shadow",{"_3602":1392,"_30987":1332,"_21467":54973,"_5":14750,"_28174":54784,"_3058":54974},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3602":1393,"_30987":1332,"_21467":54976,"_5":14750,"_28174":54788,"_3058":54977},[],"Parameter",{"_3602":1394,"_30987":1332,"_21467":54979,"_5":14750,"_28174":54788,"_3058":54980},[],"Type",{"_3602":1395,"_30987":1332,"_21467":54982,"_5":14750,"_28174":54788,"_3058":54983},[],"Required",{"_3602":1396,"_30987":1332,"_21467":54985,"_5":14750,"_28174":54788,"_3058":54986},[],"Description",{"_3602":1397,"_30987":1332,"_21467":54988,"_5":14750,"_28174":54788,"_3058":54989},[],"`connector_id`",{"_3602":1398,"_30987":1332,"_21467":54991,"_5":14750,"_28174":54788,"_3058":25625},[],{"_3602":1399,"_30987":1332,"_21467":54993,"_5":14750,"_28174":54788,"_3058":54994},[],"Yes",{"_3602":1400,"_30987":1332,"_21467":54996,"_5":14750,"_28174":54788,"_3058":54997},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3602":1401,"_30987":1332,"_21467":54999,"_5":14750,"_28174":54788,"_3058":55000},[],"`aws_config.region`",{"_3602":1402,"_30987":1332,"_21467":55002,"_5":14750,"_28174":54788,"_3058":25625},[],{"_3602":1403,"_30987":1332,"_21467":55004,"_5":14750,"_28174":54788,"_3058":54994},[],{"_3602":1404,"_30987":1332,"_21467":55006,"_5":14750,"_28174":54788,"_3058":55007},[],"AWS region where the connector operates.",{"_3602":1405,"_30987":1332,"_21467":55009,"_5":14750,"_28174":54788,"_3058":55010},[],"`aws_config.auth_method`",{"_3602":1406,"_30987":1332,"_21467":55012,"_5":14750,"_28174":54788,"_3058":25625},[],{"_3602":1407,"_30987":1332,"_21467":55014,"_5":14750,"_28174":54788,"_3058":54994},[],{"_3602":1408,"_30987":1332,"_21467":55016,"_5":14750,"_28174":54788,"_3058":55017},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3602":1409,"_30987":1332,"_21467":55019,"_5":14750,"_28174":54788,"_3058":55020},[],"`aws_config.access_key_id`",{"_3602":1410,"_30987":1332,"_21467":55022,"_5":14750,"_28174":54788,"_3058":25625},[],{"_3602":1411,"_30987":1332,"_21467":55024,"_5":14750,"_28174":54788,"_3058":55025},[],"Only with `auth_method=static`",{"_3602":1412,"_30987":1332,"_21467":55027,"_5":14750,"_28174":54788,"_3058":55028},[],"AWS access key.",{"_3602":1413,"_30987":1332,"_21467":55030,"_5":14750,"_28174":54788,"_3058":55031},[],"`aws_config.secret_access_key`",{"_3602":1414,"_30987":1332,"_21467":55033,"_5":14750,"_28174":54788,"_3058":25625},[],{"_3602":1415,"_30987":1332,"_21467":55035,"_5":14750,"_28174":54788,"_3058":55025},[],{"_3602":1416,"_30987":1332,"_21467":55037,"_5":14750,"_28174":54788,"_3058":55038},[],"AWS secret key.",{"_3602":1417,"_30987":1332,"_21467":55040,"_5":14750,"_28174":54788,"_3058":55041},[],"`aws_config.session_token`",{"_3602":1418,"_30987":1332,"_21467":55043,"_5":14750,"_28174":54788,"_3058":25625},[],{"_3602":1419,"_30987":1332,"_21467":55045,"_5":14750,"_28174":54788,"_3058":55046},[],"No",{"_3602":1420,"_30987":1332,"_21467":55048,"_5":14750,"_28174":54788,"_3058":55049},[],"Session token (with `auth_method=static`).",{"_3602":1421,"_30987":1332,"_21467":55051,"_5":14750,"_28174":54788,"_3058":55052},[],"`aws_config.role_arn`",{"_3602":1422,"_30987":1332,"_21467":55054,"_5":14750,"_28174":54788,"_3058":25625},[],{"_3602":1423,"_30987":1332,"_21467":55056,"_5":14750,"_28174":54788,"_3058":55057},[],"Only with `auth_method=role`",{"_3602":1424,"_30987":1332,"_21467":55059,"_5":14750,"_28174":54788,"_3058":55060},[],"ARN of the role to assume.",{"_3602":1425,"_30987":1332,"_21467":55062,"_5":14750,"_28174":54788,"_3058":55063},[],"`aws_config.endpoint_url`",{"_3602":1426,"_30987":1332,"_21467":55065,"_5":14750,"_28174":54788,"_3058":25625},[],{"_3602":1427,"_30987":1332,"_21467":55067,"_5":14750,"_28174":54788,"_3058":55046},[],{"_3602":1428,"_30987":1332,"_21467":55069,"_5":14750,"_28174":54788,"_3058":55070},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3602":1429,"_30987":1332,"_21467":55072,"_5":14750,"_28174":54788,"_3058":55073},[],"`subscriber_event_bus`",{"_3602":1430,"_30987":1332,"_21467":55075,"_5":14750,"_28174":54788,"_3058":18068},[],{"_3602":1431,"_30987":1332,"_21467":55077,"_5":14750,"_28174":54788,"_3058":54994},[],{"_3602":1432,"_30987":1332,"_21467":55079,"_5":14750,"_28174":54788,"_3058":55080},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3602":1433,"_30987":1332,"_21467":55082,"_5":14750,"_28174":54788,"_3058":55083},[],"`dms_manager_client`",{"_3602":1434,"_30987":1332,"_21467":55085,"_5":14750,"_28174":54788,"_3058":25625},[],{"_3602":1435,"_30987":1332,"_21467":55087,"_5":14750,"_28174":54788,"_3058":54994},[],{"_3602":1436,"_30987":1332,"_21467":55089,"_5":14750,"_28174":54788,"_3058":55090},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3602":1437,"_30987":1332,"_21467":55092,"_5":14750,"_28174":54788,"_3058":55093},[],"`device_manager_client`",{"_3602":1438,"_30987":1332,"_21467":55095,"_5":14750,"_28174":54788,"_3058":25625},[],{"_3602":1439,"_30987":1332,"_21467":55097,"_5":14750,"_28174":54788,"_3058":54994},[],{"_3602":1440,"_30987":1332,"_21467":55099,"_5":14750,"_28174":54788,"_3058":55100},[],"HTTP URL of Lamassu's Device Manager.",{"_3602":1441,"_30987":1332,"_21467":55102,"_5":14750,"_28174":54788,"_3058":55103},[],"`ca_client`",{"_3602":1442,"_30987":1332,"_21467":55105,"_5":14750,"_28174":54788,"_3058":25625},[],{"_3602":1443,"_30987":1332,"_21467":55107,"_5":14750,"_28174":54788,"_3058":54994},[],{"_3602":1444,"_30987":1332,"_21467":55109,"_5":14750,"_28174":54788,"_3058":55110},[],"HTTP URL of Lamassu's CA service.",{"_3602":1445,"_30987":1332,"_21467":55112,"_5":14750,"_28174":54792,"_3058":55113},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3602":1446,"_30987":1332,"_21467":55115,"_5":14750,"_28174":54792,"_3058":55116},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3602":1447,"_30987":1332,"_21467":55118,"_5":14750,"_28174":54792,"_3058":55119},[],"CloudEvent type",{"_3602":1448,"_30987":1332,"_21467":55121,"_5":14750,"_28174":54792,"_3058":55122},[],"Lamassu resource",{"_3602":1449,"_30987":1332,"_21467":55124,"_5":14750,"_28174":54792,"_3058":55125},[],"AWS Resource",{"_3602":1450,"_30987":1332,"_21467":55127,"_5":14750,"_28174":54792,"_3058":55128},[],"IAM actions",{"_3602":1451,"_30987":1332,"_21467":55130,"_5":14750,"_28174":54792,"_3058":55131},[],"AWS calls and effect",{"_3602":1452,"_30987":1332,"_21467":55133,"_5":14750,"_28174":54792,"_3058":55134},[],"Where in this page",{"_3602":1453,"_30987":1332,"_21467":55136,"_5":14750,"_28174":54792,"_3058":55137},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3602":1454,"_30987":1332,"_21467":55139,"_5":14750,"_28174":54792,"_3058":55140},[],"CA",{"_3602":1455,"_30987":1332,"_21467":55142,"_5":14750,"_28174":54792,"_3058":55143},[],"`IoTCore/CACertificate`",{"_3602":1456,"_30987":1332,"_21467":55145,"_5":14750,"_28174":54792,"_3058":55146},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3602":1457,"_30987":1332,"_21467":55148,"_5":14750,"_28174":54792,"_3058":55149},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3602":1458,"_30987":1332,"_21467":55151,"_5":14750,"_28174":54792,"_3058":54805},[],{"_3602":1459,"_30987":1332,"_21467":55153,"_5":14750,"_28174":54792,"_3058":55154},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3602":1460,"_30987":1332,"_21467":55156,"_5":14750,"_28174":54792,"_3058":55157},[],"DMS",{"_3602":1461,"_30987":1332,"_21467":55159,"_5":14750,"_28174":54792,"_3058":55160},[],"`IoTCore/ProvisioningTemplate`",{"_3602":1462,"_30987":1332,"_21467":55162,"_5":14750,"_28174":54792,"_3058":55163},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3602":1463,"_30987":1332,"_21467":55165,"_5":14750,"_28174":54792,"_3058":55166},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3602":1464,"_30987":1332,"_21467":55168,"_5":14750,"_28174":54792,"_3058":54833},[],{"_3602":1465,"_30987":1332,"_21467":55170,"_5":14750,"_28174":54792,"_3058":55171},[],"`EventBindDeviceIdentityKey`",{"_3602":1466,"_30987":1332,"_21467":55173,"_5":14750,"_28174":54792,"_3058":55174},[],"Device",{"_3602":1467,"_30987":1332,"_21467":55176,"_5":14750,"_28174":54792,"_3058":55177},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3602":1468,"_30987":1332,"_21467":55179,"_5":14750,"_28174":54792,"_3058":55180},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3602":1469,"_30987":1332,"_21467":55182,"_5":14750,"_28174":54792,"_3058":55183},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3602":1470,"_30987":1332,"_21467":55185,"_5":14750,"_28174":54792,"_3058":54841},[],{"_3602":1471,"_30987":1332,"_21467":55187,"_5":14750,"_28174":54792,"_3058":55188},[],"`EventUpdateCertificateStatusKey`",{"_3602":1472,"_30987":1332,"_21467":55190,"_5":14750,"_28174":54792,"_3058":55191},[],"Certificate",{"_3602":1473,"_30987":1332,"_21467":55193,"_5":14750,"_28174":54792,"_3058":55194},[],"`IoTCore/Certificate`",{"_3602":1474,"_30987":1332,"_21467":55196,"_5":14750,"_28174":54792,"_3058":55197},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3602":1475,"_30987":1332,"_21467":55199,"_5":14750,"_28174":54792,"_3058":55200},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3602":1476,"_30987":1332,"_21467":55202,"_5":14750,"_28174":54792,"_3058":54853},[],{"_3602":1477,"_30987":1332,"_21467":55204,"_5":14750,"_28174":54792,"_3058":55205},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3602":1478,"_30987":1332,"_21467":55207,"_5":14750,"_28174":54792,"_3058":55208},[],"Certificate / Device",{"_3602":1479,"_30987":1332,"_21467":55210,"_5":14750,"_28174":54792,"_3058":55211},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3602":1480,"_30987":1332,"_21467":55213,"_5":14750,"_28174":54792,"_3058":51019},[],{"_3602":1481,"_30987":1332,"_21467":55215,"_5":14750,"_28174":54792,"_3058":55216},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3602":1482,"_30987":1332,"_21467":55218,"_5":14750,"_28174":54792,"_3058":54861},[],{"_3602":1483,"_30987":1332,"_21467":55220,"_5":14750,"_28174":54796,"_3058":55221},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3602":1484,"_30987":1332,"_21467":55223,"_5":14750,"_28174":54800,"_3058":55224},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3602":1485,"_30987":1332,"_21467":55226,"_5":14750,"_28174":54800,"_3058":55227},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3602":1486,"_30987":1332,"_21467":55229,"_5":14750,"_28174":54804,"_3058":55230},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3602":1487,"_30987":1332,"_21467":55232,"_5":14750,"_28174":54804,"_3058":55233},[],"Transition",{"_3602":1488,"_30987":1332,"_21467":55235,"_5":14750,"_28174":54804,"_3058":55236},[],"AWS calls",{"_3602":1489,"_30987":1332,"_21467":55238,"_5":14750,"_28174":54804,"_3058":55239},[],"`NotRegistered` → `Requested`",{"_3602":1490,"_30987":1332,"_21467":55241,"_5":14750,"_28174":54804,"_3058":55242},[],"none (metadata write only)",{"_3602":1491,"_30987":1332,"_21467":55244,"_5":14750,"_28174":54804,"_3058":55245},[],"`Requested` → `Registering`",{"_3602":1492,"_30987":1332,"_21467":55247,"_5":14750,"_28174":54804,"_3058":55248},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3602":1493,"_30987":1332,"_21467":55250,"_5":14750,"_28174":54804,"_3058":55251},[],"`Registering` → `Succeeded`",{"_3602":1494,"_30987":1332,"_21467":55253,"_5":14750,"_28174":54804,"_3058":55254},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3602":1495,"_30987":1332,"_21467":55256,"_5":14750,"_28174":54804,"_3058":55257},[],"`Registering` → `Failed`",{"_3602":1496,"_30987":1332,"_21467":55259,"_5":14750,"_28174":54804,"_3058":55260},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3602":1497,"_30987":1332,"_21467":55262,"_5":14750,"_28174":54804,"_3058":55263},[],"`Failed` / `Succeeded` → `Requested`",{"_3602":1498,"_30987":1332,"_21467":55265,"_5":14750,"_28174":54804,"_3058":55266},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3602":1499,"_30987":1332,"_21467":55268,"_5":14750,"_28174":54808,"_3058":55269},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3602":1500,"_30987":1332,"_21467":55271,"_5":14750,"_28174":54808,"_3058":55272},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3602":1501,"_30987":1332,"_21467":55274,"_5":14750,"_28174":54808,"_3058":55275},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3602":1502,"_30987":1332,"_21467":55277,"_5":14750,"_28174":54808,"_3058":55278},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3602":1503,"_30987":1332,"_21467":55280,"_5":14750,"_28174":54808,"_3058":55281},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3602":1504,"_30987":1332,"_21467":55283,"_5":14750,"_28174":54808,"_3058":55284},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3602":1505,"_30987":1332,"_21467":55286,"_5":14750,"_28174":54812,"_3058":55287},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3602":1506,"_30987":1332,"_21467":55289,"_5":14750,"_28174":54816,"_3058":55290},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3602":1507,"_30987":1332,"_21467":55292,"_5":14750,"_28174":54816,"_3058":55293},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3602":1508,"_30987":1332,"_21467":55295,"_5":14750,"_28174":54820,"_3058":55296},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3602":1509,"_30987":1332,"_21467":55298,"_5":14750,"_28174":54824,"_3058":55299},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3602":1510,"_30987":1332,"_21467":55301,"_5":14750,"_28174":54824,"_3058":55302},[],"Creates or updates the IoT policies configured in the DMS.",{"_3602":1511,"_30987":1332,"_21467":55304,"_5":14750,"_28174":54824,"_3058":55305},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3602":1512,"_30987":1332,"_21467":55307,"_5":14750,"_28174":54824,"_3058":55308},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3602":1513,"_30987":1332,"_21467":55310,"_5":14750,"_28174":54824,"_3058":55311},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3602":1514,"_30987":1332,"_21467":55313,"_5":14750,"_28174":54824,"_3058":55314},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3602":1515,"_30987":1332,"_21467":55316,"_5":14750,"_28174":54824,"_3058":55317},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3602":1516,"_30987":1332,"_21467":55319,"_5":14750,"_28174":54828,"_3058":55320},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3602":1517,"_30987":1332,"_21467":55322,"_5":14750,"_28174":54828,"_3058":55323},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3602":1518,"_30987":1332,"_21467":55325,"_5":14750,"_28174":54828,"_3058":55326},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3602":1519,"_30987":1332,"_21467":55328,"_5":14750,"_28174":54828,"_3058":55329},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3602":1520,"_30987":1332,"_21467":55331,"_5":14750,"_28174":54828,"_3058":55332},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3602":1521,"_30987":1332,"_21467":55334,"_5":14750,"_28174":54832,"_3058":55335},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3602":1522,"_30987":1332,"_21467":55337,"_5":14750,"_28174":54832,"_3058":55233},[],{"_3602":1523,"_30987":1332,"_21467":55339,"_5":14750,"_28174":54832,"_3058":55236},[],{"_3602":1524,"_30987":1332,"_21467":55341,"_5":14750,"_28174":54832,"_3058":55342},[],"`Unconfigured` → `None` / `Auto`",{"_3602":1525,"_30987":1332,"_21467":55344,"_5":14750,"_28174":54832,"_3058":55345},[],"none (configuration only)",{"_3602":1526,"_30987":1332,"_21467":55347,"_5":14750,"_28174":54832,"_3058":55348},[],"`None` ↔ `Auto`",{"_3602":1527,"_30987":1332,"_21467":55350,"_5":14750,"_28174":54832,"_3058":55345},[],{"_3602":1528,"_30987":1332,"_21467":55352,"_5":14750,"_28174":54832,"_3058":55353},[],"Any → `Jitp`",{"_3602":1529,"_30987":1332,"_21467":55355,"_5":14750,"_28174":54832,"_3058":55356},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3602":1530,"_30987":1332,"_21467":55358,"_5":14750,"_28174":54832,"_3058":55359},[],"`Jitp` → `None` / `Auto`",{"_3602":1531,"_30987":1332,"_21467":55361,"_5":14750,"_28174":54832,"_3058":55362},[],"none (the template stays in the AWS account)",{"_3602":1532,"_30987":1332,"_21467":55364,"_5":14750,"_28174":54836,"_3058":55365},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3602":1533,"_30987":1332,"_21467":55367,"_5":14750,"_28174":54836,"_3058":55368},[],"The full flow from the device's perspective is:",{"_3602":1534,"_30987":1332,"_21467":55370,"_5":14750,"_28174":54836,"_3058":55371},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3602":1535,"_30987":1332,"_21467":55373,"_5":14750,"_28174":54840,"_3058":55374},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3602":1536,"_30987":1332,"_21467":55376,"_5":14750,"_28174":54840,"_3058":55233},[],{"_3602":1537,"_30987":1332,"_21467":55378,"_5":14750,"_28174":54840,"_3058":55236},[],{"_3602":1538,"_30987":1332,"_21467":55380,"_5":14750,"_28174":54840,"_3058":55381},[],"`Absent` → `Provisioned`",{"_3602":1539,"_30987":1332,"_21467":55383,"_5":14750,"_28174":54840,"_3058":55384},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3602":1540,"_30987":1332,"_21467":55386,"_5":14750,"_28174":54840,"_3058":55387},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3602":1541,"_30987":1332,"_21467":55389,"_5":14750,"_28174":54840,"_3058":55390},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3602":1542,"_30987":1332,"_21467":55392,"_5":14750,"_28174":54840,"_3058":55393},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3602":1543,"_30987":1332,"_21467":55395,"_5":14750,"_28174":54844,"_3058":55396},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3602":1544,"_30987":1332,"_21467":55398,"_5":14750,"_28174":54844,"_3058":55399},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3602":1545,"_30987":1332,"_21467":55401,"_5":14750,"_28174":54844,"_3058":55402},[],"For the JITP flow to work correctly:",{"_3602":1546,"_30987":1332,"_21467":55404,"_5":14750,"_28174":54844,"_3058":55405},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3602":1547,"_30987":1332,"_21467":55407,"_5":14750,"_28174":54844,"_3058":55408},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3602":1548,"_30987":1332,"_21467":55410,"_5":14750,"_28174":54844,"_3058":55411},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3602":1549,"_30987":1332,"_21467":55413,"_5":14750,"_28174":54844,"_3058":55414},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3602":1550,"_30987":1332,"_21467":55416,"_5":14750,"_28174":54848,"_3058":55417},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3602":1551,"_30987":1332,"_21467":55419,"_5":14750,"_28174":54848,"_3058":55420},[],"Status in Lamassu",{"_3602":1552,"_30987":1332,"_21467":55422,"_5":14750,"_28174":54848,"_3058":55423},[],"Revocation reason",{"_3602":1553,"_30987":1332,"_21467":55425,"_5":14750,"_28174":54848,"_3058":55426},[],"Status in AWS IoT Core",{"_3602":1554,"_30987":1332,"_21467":55428,"_5":14750,"_28174":54848,"_3058":55429},[],"`Active`",{"_3602":1555,"_30987":1332,"_21467":55431,"_5":14750,"_28174":54848,"_3058":55432},[],"None",{"_3602":1556,"_30987":1332,"_21467":55434,"_5":14750,"_28174":54848,"_3058":55435},[],"`ACTIVE`",{"_3602":1557,"_30987":1332,"_21467":55437,"_5":14750,"_28174":54848,"_3058":55438},[],"`Revoked`",{"_3602":1558,"_30987":1332,"_21467":55440,"_5":14750,"_28174":54848,"_3058":55441},[],"`certificateHold`",{"_3602":1559,"_30987":1332,"_21467":55443,"_5":14750,"_28174":54848,"_3058":55444},[],"`INACTIVE`",{"_3602":1560,"_30987":1332,"_21467":55446,"_5":14750,"_28174":54848,"_3058":55438},[],{"_3602":1561,"_30987":1332,"_21467":55448,"_5":14750,"_28174":54848,"_3058":55449},[],"Any other reason",{"_3602":1562,"_30987":1332,"_21467":55451,"_5":14750,"_28174":54848,"_3058":55452},[],"`REVOKED`",{"_3602":1563,"_30987":1332,"_21467":55454,"_5":14750,"_28174":54848,"_3058":55455},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3602":1564,"_30987":1332,"_21467":55457,"_5":14750,"_28174":54852,"_3058":55458},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3602":1565,"_30987":1332,"_21467":55460,"_5":14750,"_28174":54852,"_3058":55233},[],{"_3602":1566,"_30987":1332,"_21467":55462,"_5":14750,"_28174":54852,"_3058":55236},[],{"_3602":1567,"_30987":1332,"_21467":55464,"_5":14750,"_28174":54852,"_3058":55465},[],"`NotSynced` → `Active`",{"_3602":1568,"_30987":1332,"_21467":55467,"_5":14750,"_28174":54852,"_3058":54944},[],{"_3602":1569,"_30987":1332,"_21467":55469,"_5":14750,"_28174":54852,"_3058":55470},[],"`Active` → `Inactive`",{"_3602":1570,"_30987":1332,"_21467":55472,"_5":14750,"_28174":54852,"_3058":55473},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3602":1571,"_30987":1332,"_21467":55475,"_5":14750,"_28174":54852,"_3058":55476},[],"`Active` → `Revoked`",{"_3602":1572,"_30987":1332,"_21467":55478,"_5":14750,"_28174":54852,"_3058":55473},[],{"_3602":1573,"_30987":1332,"_21467":55480,"_5":14750,"_28174":54852,"_3058":55481},[],"`Inactive` / `Revoked` → `Active`",{"_3602":1574,"_30987":1332,"_21467":55483,"_5":14750,"_28174":54852,"_3058":54944},[],{"_3602":1575,"_30987":1332,"_21467":55485,"_5":14750,"_28174":54852,"_3058":55486},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3602":1576,"_30987":1332,"_21467":55488,"_5":14750,"_28174":54852,"_3058":55489},[],"none (these states are not synced to AWS)",{"_3602":1577,"_30987":1332,"_21467":55491,"_5":14750,"_28174":54856,"_3058":55492},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3602":1578,"_30987":1332,"_21467":55494,"_5":14750,"_28174":54856,"_3058":55495},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3602":1579,"_30987":1332,"_21467":55497,"_5":14750,"_28174":54856,"_3058":55498},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3602":1580,"_30987":1332,"_21467":55500,"_5":14750,"_28174":54860,"_3058":55501},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3602":1581,"_30987":1332,"_21467":55503,"_5":14750,"_28174":54860,"_3058":55504},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3602":1582,"_30987":1332,"_21467":55506,"_5":14750,"_28174":54864,"_3058":55507},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3602":1583,"_30987":1332,"_21467":55509,"_5":14750,"_28174":54864,"_3058":55510},[],"There are two action types:",{"_3602":1584,"_30987":1332,"_21467":55512,"_5":14750,"_28174":54864,"_3058":55513},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3602":1585,"_30987":1332,"_21467":55515,"_5":14750,"_28174":54864,"_3058":55516},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3602":1586,"_30987":1332,"_21467":55518,"_5":14750,"_28174":54864,"_3058":55519},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3602":1587,"_30987":1332,"_21467":55521,"_5":14750,"_28174":54868,"_3058":55522},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3602":1588,"_30987":1332,"_21467":55524,"_5":14750,"_28174":54868,"_3058":55525},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3602":1589,"_30987":1332,"_21467":55527,"_5":14750,"_28174":54868,"_3058":55528},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3602":1590,"_30987":1332,"_21467":55530,"_5":14750,"_28174":54872,"_3058":55531},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3602":1591,"_30987":1332,"_21467":55533,"_5":14750,"_28174":54872,"_3058":55534},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3602":1592,"_30987":1332,"_21467":55536,"_5":14750,"_28174":54872,"_3058":55537},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3602":1593,"_30987":1332,"_21467":55539,"_5":14750,"_28174":54872,"_3058":55540},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3602":1594,"_30987":1332,"_21467":55542,"_5":14750,"_28174":54872,"_3058":55543},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3602":1595,"_30987":1332,"_21467":55545,"_5":14750,"_28174":54872,"_3058":55546},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3602":1596,"_30987":1332,"_21467":55548,"_5":14750,"_28174":54872,"_3058":55549},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3602":1597,"_30987":1332,"_21467":55551,"_5":14750,"_28174":54872,"_3058":55552},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3602":1598,"_30987":1332,"_21467":55554,"_5":14750,"_28174":54872,"_3058":55555},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3602":1599,"_30987":1332,"_21467":55557,"_5":14750,"_28174":54872,"_3058":55558},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3602":1600,"_30987":1332,"_21467":55560,"_5":14750,"_28174":54872,"_3058":55561},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3602":1601,"_30987":1332,"_21467":55563,"_5":14750,"_28174":54872,"_3058":55564},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3602":1602,"_30987":1332,"_21467":55566,"_5":14750,"_28174":54872,"_3058":55567},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3602":1603,"_30987":1332,"_21467":55569,"_5":14750,"_28174":54872,"_3058":55570},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3602":1604,"_30987":1332,"_21467":55572,"_5":14750,"_28174":54872,"_3058":55573},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3602":1605,"_30987":1332,"_21467":55575,"_5":14750,"_28174":54872,"_3058":55576},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3602":1606,"_30987":1332,"_21467":55578,"_5":14750,"_28174":54872,"_3058":55579},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3602":1607,"_30987":1332,"_21467":55581,"_5":14750,"_28174":54872,"_3058":55582},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3602":1608,"_30987":1332,"_21467":55584,"_5":14750,"_28174":54872,"_3058":55585},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3602":1609,"_30987":1332,"_21467":55587,"_5":14750,"_28174":54872,"_3058":55588},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3602":1610,"_30987":1332,"_21467":55590,"_5":14750,"_28174":54872,"_3058":55591},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3602":1611,"_30987":1332,"_21467":55593,"_5":14750,"_28174":54872,"_3058":55594},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3602":1612,"_30987":1332,"_21467":55596,"_5":14750,"_28174":54872,"_3058":55597},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3602":1613,"_30987":1332,"_21467":55599,"_5":14750,"_28174":54872,"_3058":55600},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3602":1614,"_30987":1614,"_5":15110,"_3058":53307,"_31325":55602,"_21467":55603,"_28174":1614},[50623,52135,53307],[],{"_3602":1615,"_30987":1614,"_21467":55605,"_5":14750,"_28174":1614,"_3058":55606},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3602":1616,"_30987":1614,"_5":31322,"_21467":55608,"_28174":55609,"_3058":55610},[],"/docs/platform/iot-fleets/overview#start-here","Start here",{"_3602":1617,"_30987":1614,"_5":31322,"_21467":55612,"_28174":55613,"_3058":53305},[],"/docs/platform/iot-fleets/overview#devices-and-identities",{"_3602":1618,"_30987":1614,"_5":31322,"_21467":55615,"_28174":55616,"_3058":53488},[],"/docs/platform/iot-fleets/overview#enrollment-with-pki",{"_3602":1619,"_30987":1614,"_5":31322,"_21467":55618,"_28174":55619,"_3058":54769},[],"/docs/platform/iot-fleets/overview#integrations",{"_3602":1620,"_30987":1614,"_5":31322,"_21467":55621,"_28174":55622,"_3058":55623},[],"/docs/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3602":1621,"_30987":1614,"_21467":55625,"_5":14750,"_28174":1614,"_3058":55626},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3602":1622,"_30987":1614,"_21467":55628,"_5":14750,"_28174":55609,"_3058":55629},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3602":1623,"_30987":1614,"_21467":55631,"_5":14750,"_28174":55609,"_3058":55632},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3602":1624,"_30987":1614,"_21467":55634,"_5":14750,"_28174":55613,"_3058":55635},[],"Resource",{"_3602":1625,"_30987":1614,"_21467":55637,"_5":14750,"_28174":55613,"_3058":55638},[],"What it represents",{"_3602":1626,"_30987":1614,"_21467":55640,"_5":14750,"_28174":55613,"_3058":55641},[],"**Device**",{"_3602":1627,"_30987":1614,"_21467":55643,"_5":14750,"_28174":55613,"_3058":55644},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3602":1628,"_30987":1614,"_21467":55646,"_5":14750,"_28174":55613,"_3058":55647},[],"**Identity**",{"_3602":1629,"_30987":1614,"_21467":55649,"_5":14750,"_28174":55613,"_3058":55650},[],"The device's association with its certificates: an active version and a history.",{"_3602":1630,"_30987":1614,"_21467":55652,"_5":14750,"_28174":55613,"_3058":55653},[],"**DMS**",{"_3602":1631,"_30987":1614,"_21467":55655,"_5":14750,"_28174":55613,"_3058":55656},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3602":1632,"_30987":1614,"_21467":55658,"_5":14750,"_28174":55613,"_3058":55659},[],"**Fleet**",{"_3602":1633,"_30987":1614,"_21467":55661,"_5":14750,"_28174":55613,"_3058":55662},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3602":1634,"_30987":1614,"_21467":55664,"_5":14750,"_28174":55613,"_3058":55665},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3602":1635,"_30987":1614,"_21467":55667,"_5":14750,"_28174":55613,"_3058":55668},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3602":1636,"_30987":1614,"_21467":55670,"_5":14750,"_28174":55616,"_3058":55671},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3602":1637,"_30987":1614,"_21467":55673,"_5":14750,"_28174":55616,"_3058":55674},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3602":1638,"_30987":1614,"_21467":55676,"_5":14750,"_28174":55616,"_3058":55677},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3602":1639,"_30987":1614,"_21467":55679,"_5":14750,"_28174":55616,"_3058":55680},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3602":1640,"_30987":1614,"_21467":55682,"_5":14750,"_28174":55616,"_3058":55683},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3602":1641,"_30987":1614,"_21467":55685,"_5":14750,"_28174":55616,"_3058":55686},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3602":1642,"_30987":1614,"_21467":55688,"_5":14750,"_28174":55616,"_3058":55689},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3602":1643,"_30987":1614,"_21467":55691,"_5":14750,"_28174":55616,"_3058":55692},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3602":1644,"_30987":1614,"_21467":55694,"_5":14750,"_28174":55619,"_3058":55695},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3602":1645,"_30987":1614,"_21467":55697,"_5":14750,"_28174":55619,"_3058":55698},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3602":1646,"_30987":1614,"_21467":55700,"_5":14750,"_28174":55622,"_3058":55701},[],"Participant",{"_3602":1647,"_30987":1614,"_21467":55703,"_5":14750,"_28174":55622,"_3058":55704},[],"Responsibility",{"_3602":1648,"_30987":1614,"_21467":55706,"_5":14750,"_28174":55622,"_3058":55707},[],"PKI administrator",{"_3602":1649,"_30987":1614,"_21467":55709,"_5":14750,"_28174":55622,"_3058":55710},[],"CA, issuance profile, chain and revocation publication.",{"_3602":1650,"_30987":1614,"_21467":55712,"_5":14750,"_28174":55622,"_3058":55713},[],"Provisioning administrator",{"_3602":1651,"_30987":1614,"_21467":55715,"_5":14750,"_28174":55622,"_3058":55716},[],"DMS, admission, authentication per operation and inventory.",{"_3602":1652,"_30987":1614,"_21467":55718,"_5":14750,"_28174":55622,"_3058":55719},[],"Device integrator",{"_3602":1653,"_30987":1614,"_21467":55721,"_5":14750,"_28174":55622,"_3058":55722},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3602":1654,"_30987":1614,"_21467":55724,"_5":14750,"_28174":55622,"_3058":55725},[],"Consumer integrator",{"_3602":1655,"_30987":1614,"_21467":55727,"_5":14750,"_28174":55622,"_3058":55728},[],"Trusted issuers, validation and device permissions in the destination.",{"_3602":1656,"_30987":1614,"_21467":55730,"_5":14750,"_28174":55622,"_3058":55731},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3602":1657,"_30987":1657,"_5":15110,"_3058":55733,"_31325":55734,"_21467":55736,"_28174":1657},"Enroll and connect your first device",[50623,52135,53307,55735],"Getting started",[],{"_3602":1658,"_30987":1657,"_21467":55738,"_5":14750,"_28174":1657,"_3058":55739},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3602":1659,"_30987":1657,"_5":31322,"_21467":55741,"_28174":55742,"_3058":50633},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3602":1660,"_30987":1657,"_5":31322,"_21467":55744,"_28174":55745,"_3058":55746},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3602":1661,"_30987":1657,"_5":31322,"_21467":55748,"_28174":55749,"_3058":55750},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3602":1662,"_30987":1657,"_5":31322,"_21467":55752,"_28174":55753,"_3058":55754},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3602":1663,"_30987":1657,"_5":31322,"_21467":55756,"_28174":55757,"_3058":55758},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3602":1664,"_30987":1657,"_5":31322,"_21467":55760,"_28174":55761,"_3058":55762},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3602":1665,"_30987":1657,"_5":31322,"_21467":55764,"_28174":55765,"_3058":55766},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3602":1666,"_30987":1657,"_5":31322,"_21467":55768,"_28174":55769,"_3058":55770},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3602":1667,"_30987":1657,"_21467":55772,"_5":14750,"_28174":1657,"_3058":55773},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3602":1668,"_30987":1657,"_21467":55775,"_5":14750,"_28174":55742,"_3058":55776},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3602":1669,"_30987":1657,"_21467":55778,"_5":14750,"_28174":55742,"_3058":55779},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3602":1670,"_30987":1657,"_21467":55781,"_5":14750,"_28174":55742,"_3058":55782},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3602":1671,"_30987":1657,"_21467":55784,"_5":14750,"_28174":55742,"_3058":55785},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3602":1672,"_30987":1657,"_21467":55787,"_5":14750,"_28174":55742,"_3058":55788},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3602":1673,"_30987":1657,"_21467":55790,"_5":14750,"_28174":55745,"_3058":55791},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3602":1674,"_30987":1657,"_21467":55793,"_5":14750,"_28174":55745,"_3058":55794},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3602":1675,"_30987":1657,"_21467":55796,"_5":14750,"_28174":55749,"_3058":55797},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3602":1676,"_30987":1657,"_21467":55799,"_5":14750,"_28174":55749,"_3058":55800},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3602":1677,"_30987":1657,"_21467":55802,"_5":14750,"_28174":55749,"_3058":55803},[],"Setting",{"_3602":1678,"_30987":1657,"_21467":55805,"_5":14750,"_28174":55749,"_3058":55806},[],"Evaluation value",{"_3602":1679,"_30987":1657,"_21467":55808,"_5":14750,"_28174":55749,"_3058":55809},[],"Enrollment CA",{"_3602":1680,"_30987":1657,"_21467":55811,"_5":14750,"_28174":55749,"_3058":55812},[],"Issuing root from `device-root.pem`.",{"_3602":1681,"_30987":1657,"_21467":55814,"_5":14750,"_28174":55749,"_3058":53618},[],{"_3602":1682,"_30987":1657,"_21467":55816,"_5":14750,"_28174":55749,"_3058":55817},[],"The 1-hour leaf profile you just prepared.",{"_3602":1683,"_30987":1657,"_21467":55819,"_5":14750,"_28174":55749,"_3058":55820},[],"Protocol / Registration Mode",{"_3602":1684,"_30987":1657,"_21467":55822,"_5":14750,"_28174":55749,"_3058":55823},[],"`EST_RFC7030` / `JITP`.",{"_3602":1685,"_30987":1657,"_21467":55825,"_5":14750,"_28174":55749,"_3058":55826},[],"Verify CSR Signature",{"_3602":1686,"_30987":1657,"_21467":55828,"_5":14750,"_28174":55749,"_3058":55829},[],"Enabled.",{"_3602":1687,"_30987":1657,"_21467":55831,"_5":14750,"_28174":55749,"_3058":55832},[],"Enable Replaceable Enrollment",{"_3602":1688,"_30987":1657,"_21467":55834,"_5":14750,"_28174":55749,"_3058":55835},[],"Disabled; the ID must be new.",{"_3602":1689,"_30987":1657,"_21467":55837,"_5":14750,"_28174":55749,"_3058":55838},[],"Initial authentication",{"_3602":1690,"_30987":1657,"_21467":55840,"_5":14750,"_28174":55749,"_3058":55841},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3602":1691,"_30987":1657,"_21467":55843,"_5":14750,"_28174":55749,"_3058":55844},[],"Renewal authentication",{"_3602":1692,"_30987":1657,"_21467":55846,"_5":14750,"_28174":55749,"_3058":55847},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3602":1693,"_30987":1657,"_21467":55849,"_5":14750,"_28174":55749,"_3058":55850},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3602":1694,"_30987":1657,"_21467":55852,"_5":14750,"_28174":55749,"_3058":55853},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3602":1695,"_30987":1657,"_21467":55855,"_5":14750,"_28174":55749,"_3058":55856},[],"Re-enrollment Delta",{"_3602":1696,"_30987":1657,"_21467":55858,"_5":14750,"_28174":55749,"_3058":55859},[],"1 hour.",{"_3602":1697,"_30987":1657,"_21467":55861,"_5":14750,"_28174":55749,"_3058":55862},[],"Preventive / Critical Delta",{"_3602":1698,"_30987":1657,"_21467":55864,"_5":14750,"_28174":55749,"_3058":55865},[],"30 minutes / 10 minutes.",{"_3602":1699,"_30987":1657,"_21467":55867,"_5":14750,"_28174":55749,"_3058":55868},[],"Revoke on Re-enrollment",{"_3602":1700,"_30987":1657,"_21467":55870,"_5":14750,"_28174":55749,"_3058":55871},[],"Disabled to test the successor before retiring the previous identity.",{"_3602":1701,"_30987":1657,"_21467":55873,"_5":14750,"_28174":55749,"_3058":53626},[],{"_3602":1702,"_30987":1657,"_21467":55875,"_5":14750,"_28174":55749,"_3058":55876},[],"Disabled; the operational key is generated in the client.",{"_3602":1703,"_30987":1657,"_21467":55878,"_5":14750,"_28174":55749,"_3058":55879},[],"CA Distribution",{"_3602":1704,"_30987":1657,"_21467":55881,"_5":14750,"_28174":55749,"_3058":55882},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3602":1705,"_30987":1657,"_21467":55884,"_5":14750,"_28174":55749,"_3058":55885},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3602":1706,"_30987":1657,"_21467":55887,"_5":14750,"_28174":55753,"_3058":55888},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3602":1707,"_30987":1657,"_21467":55890,"_5":14750,"_28174":55753,"_3058":55891},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3602":1708,"_30987":1657,"_21467":55893,"_5":14750,"_28174":55757,"_3058":55894},[],"Generate a new key and CSR with the selected identifier:",{"_3602":1709,"_30987":1657,"_21467":55896,"_5":14750,"_28174":55757,"_3058":55897},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3602":1710,"_30987":1657,"_21467":55899,"_5":14750,"_28174":55757,"_3058":55900},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3602":1711,"_30987":1657,"_21467":55902,"_5":14750,"_28174":55761,"_3058":55903},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3602":1712,"_30987":1657,"_21467":55905,"_5":14750,"_28174":55761,"_3058":55906},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3602":1713,"_30987":1657,"_21467":55908,"_5":14750,"_28174":55765,"_3058":55909},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3602":1714,"_30987":1657,"_21467":55911,"_5":14750,"_28174":55765,"_3058":55912},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3602":1715,"_30987":1657,"_21467":55914,"_5":14750,"_28174":55765,"_3058":55915},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3602":1716,"_30987":1657,"_21467":55917,"_5":14750,"_28174":55765,"_3058":55918},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3602":1717,"_30987":1657,"_21467":55920,"_5":14750,"_28174":55765,"_3058":55921},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3602":1718,"_30987":1657,"_21467":55923,"_5":14750,"_28174":55769,"_3058":55924},[],"Check",{"_3602":1719,"_30987":1657,"_21467":55926,"_5":14750,"_28174":55769,"_3058":55927},[],"Expected result",{"_3602":1720,"_30987":1657,"_21467":55929,"_5":14750,"_28174":55769,"_3058":55930},[],"Registration",{"_3602":1721,"_30987":1657,"_21467":55932,"_5":14750,"_28174":55769,"_3058":55933},[],"ID created automatically and correct DMS.",{"_3602":1722,"_30987":1657,"_21467":55935,"_5":14750,"_28174":55769,"_3058":55191},[],{"_3602":1723,"_30987":1657,"_21467":55937,"_5":14750,"_28174":55769,"_3058":55938},[],"CN, profile, serial and key verified.",{"_3602":1724,"_30987":1657,"_21467":55940,"_5":14750,"_28174":55769,"_3058":55941},[],"Inventory",{"_3602":1725,"_30987":1657,"_21467":55943,"_5":14750,"_28174":55769,"_3058":55944},[],"Received serial visible as the current identity and in history.",{"_3602":1726,"_30987":1657,"_21467":55946,"_5":14750,"_28174":55769,"_3058":55947},[],"Consumer",{"_3602":1727,"_30987":1657,"_21467":55949,"_5":14750,"_28174":55769,"_3058":55950},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3602":1728,"_30987":1657,"_21467":55952,"_5":14750,"_28174":55769,"_3058":55953},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3602":1729,"_30987":1657,"_21467":55955,"_5":14750,"_28174":55769,"_3058":55956},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3602":1730,"_30987":1730,"_5":15110,"_3058":53323,"_31325":55958,"_21467":55959,"_28174":1730},[50623,52135,53307,55735],[],{"_3602":1731,"_30987":1730,"_21467":55961,"_5":14750,"_28174":1730,"_3058":55962},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3602":1732,"_30987":1730,"_5":31322,"_21467":55964,"_28174":55965,"_3058":50633},[],"/docs/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3602":1733,"_30987":1730,"_5":31322,"_21467":55967,"_28174":55968,"_3058":55969},[],"/docs/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3602":1734,"_30987":1730,"_5":31322,"_21467":55971,"_28174":55972,"_3058":55973},[],"/docs/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3602":1735,"_30987":1730,"_5":31322,"_21467":55975,"_28174":55976,"_3058":55977},[],"/docs/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3602":1736,"_30987":1730,"_5":31322,"_21467":55979,"_28174":55980,"_3058":55981},[],"/docs/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3602":1737,"_30987":1730,"_5":31322,"_21467":55983,"_28174":55984,"_3058":55985},[],"/docs/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3602":1738,"_30987":1730,"_5":31322,"_21467":55987,"_28174":55988,"_3058":55927},[],"/docs/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3602":1739,"_30987":1730,"_5":31322,"_21467":55990,"_28174":55991,"_3058":55992},[],"/docs/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3602":1740,"_30987":1730,"_5":31322,"_21467":55994,"_28174":55995,"_3058":55996},[],"/docs/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3602":1741,"_30987":1730,"_21467":55998,"_5":14750,"_28174":1730,"_3058":55999},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3602":1742,"_30987":1730,"_21467":56001,"_5":14750,"_28174":1730,"_3058":56002},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3602":1743,"_30987":1730,"_21467":56004,"_5":14750,"_28174":55965,"_3058":56005},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3602":1744,"_30987":1730,"_21467":56007,"_5":14750,"_28174":55965,"_3058":56008},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3602":1745,"_30987":1730,"_21467":56010,"_5":14750,"_28174":55965,"_3058":56011},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3602":1746,"_30987":1730,"_21467":56013,"_5":14750,"_28174":55965,"_3058":56014},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3602":1747,"_30987":1730,"_21467":56016,"_5":14750,"_28174":55968,"_3058":56017},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3602":1748,"_30987":1730,"_21467":56019,"_5":14750,"_28174":55968,"_3058":56020},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3602":1749,"_30987":1730,"_21467":56022,"_5":14750,"_28174":55968,"_3058":56023},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3602":1750,"_30987":1730,"_21467":56025,"_5":14750,"_28174":55968,"_3058":56026},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3602":1751,"_30987":1730,"_21467":56028,"_5":14750,"_28174":55968,"_3058":56029},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3602":1752,"_30987":1730,"_21467":56031,"_5":14750,"_28174":55968,"_3058":56032},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3602":1753,"_30987":1730,"_21467":56034,"_5":14750,"_28174":55968,"_3058":56035},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3602":1754,"_30987":1730,"_21467":56037,"_5":14750,"_28174":55968,"_3058":56038},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3602":1755,"_30987":1730,"_21467":56040,"_5":14750,"_28174":55972,"_3058":56041},[],"Open **Managed Devices** and the registration action. Complete:",{"_3602":1756,"_30987":1730,"_21467":56043,"_5":14750,"_28174":55972,"_3058":56044},[],"**Device ID**: `device-001`.",{"_3602":1757,"_30987":1730,"_21467":56046,"_5":14750,"_28174":55972,"_3058":56047},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3602":1758,"_30987":1730,"_21467":56049,"_5":14750,"_28174":55972,"_3058":56050},[],"**Icon** and **Tags**: optional classification.",{"_3602":1759,"_30987":1730,"_21467":56052,"_5":14750,"_28174":55972,"_3058":56053},[],"Confirm registration.",{"_3602":1760,"_30987":1730,"_21467":56055,"_5":14750,"_28174":55976,"_3058":56056},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3602":1761,"_30987":1730,"_21467":56058,"_5":14750,"_28174":55976,"_3058":56059},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3602":1762,"_30987":1730,"_21467":56061,"_5":14750,"_28174":55980,"_3058":56062},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3602":1763,"_30987":1730,"_21467":56064,"_5":14750,"_28174":55980,"_3058":56065},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3602":1764,"_30987":1730,"_21467":56067,"_5":14750,"_28174":55984,"_3058":56068},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3602":1765,"_30987":1730,"_21467":56070,"_5":14750,"_28174":55984,"_3058":56071},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3602":1766,"_30987":1730,"_21467":56073,"_5":14750,"_28174":55988,"_3058":55924},[],{"_3602":1767,"_30987":1730,"_21467":56075,"_5":14750,"_28174":55988,"_3058":56076},[],"Result",{"_3602":1768,"_30987":1730,"_21467":56078,"_5":14750,"_28174":55988,"_3058":55174},[],{"_3602":1769,"_30987":1730,"_21467":56080,"_5":14750,"_28174":55988,"_3058":56081},[],"`device-001` appears in inventory with the expected DMS.",{"_3602":1770,"_30987":1730,"_21467":56083,"_5":14750,"_28174":55988,"_3058":56084},[],"Current identity",{"_3602":1771,"_30987":1730,"_21467":56086,"_5":14750,"_28174":55988,"_3058":56087},[],"The associated certificate matches the one you verified in PKI.",{"_3602":1772,"_30987":1730,"_21467":56089,"_5":14750,"_28174":55988,"_3058":56090},[],"History",{"_3602":1773,"_30987":1730,"_21467":56092,"_5":14750,"_28174":55988,"_3058":56093},[],"The associated issuance appears with its serial number and dates.",{"_3602":1774,"_30987":1730,"_21467":56095,"_5":14750,"_28174":55988,"_3058":56096},[],"Key and certificate",{"_3602":1775,"_30987":1730,"_21467":56098,"_5":14750,"_28174":55988,"_3058":56099},[],"You have the verified pair ready to install on the device.",{"_3602":1776,"_30987":1730,"_21467":56101,"_5":14750,"_28174":55991,"_3058":56102},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3602":1777,"_30987":1730,"_21467":56104,"_5":14750,"_28174":55991,"_3058":56105},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3602":1778,"_30987":1730,"_21467":56107,"_5":14750,"_28174":55991,"_3058":56108},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3602":1779,"_30987":1730,"_21467":56110,"_5":14750,"_28174":55991,"_3058":56111},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3602":1780,"_30987":1730,"_21467":56113,"_5":14750,"_28174":55995,"_3058":56114},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3602":1781,"_30987":1730,"_21467":56116,"_5":14750,"_28174":55995,"_3058":56117},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3602":1782,"_30987":1730,"_21467":56119,"_5":14750,"_28174":55995,"_3058":56120},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3602":1783,"_30987":1783,"_5":15110,"_3058":56122,"_31325":56123,"_21467":56124,"_28174":1783},"Lamassu IoT Platform",[50623,52135],[],{"_3602":1784,"_30987":1783,"_21467":56126,"_5":14750,"_28174":1783,"_3058":56127},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3602":1785,"_30987":1783,"_5":31322,"_21467":56129,"_28174":56130,"_3058":55610},[],"/docs/platform/overview#start-here",{"_3602":1786,"_30987":1783,"_5":31322,"_21467":56132,"_28174":56133,"_3058":56134},[],"/docs/platform/overview#choose-your-path","Choose your path",{"_3602":1787,"_30987":1783,"_5":31322,"_21467":56136,"_28174":56137,"_3058":56138},[],"/docs/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3602":1788,"_30987":1783,"_5":31322,"_21467":56140,"_28174":56141,"_3058":56142},[],"/docs/platform/overview#core-capabilities","Core capabilities",{"_3602":1789,"_30987":1783,"_5":31322,"_21467":56144,"_28174":56145,"_3058":56146},[],"/docs/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3602":1790,"_30987":1783,"_5":31322,"_21467":56148,"_28174":56149,"_3058":56150},[],"/docs/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3602":1791,"_30987":1783,"_5":31322,"_21467":56152,"_28174":56153,"_3058":56154},[],"/docs/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3602":1792,"_30987":1783,"_5":31322,"_21467":56156,"_28174":56157,"_3058":56158},[],"/docs/platform/overview#automate-device-identities","Automate device identities",{"_3602":1793,"_30987":1783,"_5":31322,"_21467":56160,"_28174":56161,"_3058":56162},[],"/docs/platform/overview#publish-validation-status","Publish validation status",{"_3602":1794,"_30987":1783,"_5":31322,"_21467":56164,"_28174":56165,"_3058":56166},[],"/docs/platform/overview#react-to-events","React to events",{"_3602":1795,"_30987":1783,"_5":31322,"_21467":56168,"_28174":56169,"_3058":56170},[],"/docs/platform/overview#operational-reference","Operational reference",{"_3602":1796,"_30987":1783,"_21467":56172,"_5":14750,"_28174":1783,"_3058":56173},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3602":1797,"_30987":1783,"_21467":56175,"_5":14750,"_28174":56130,"_3058":56176},[],"Choose the result you need:",{"_3602":1798,"_30987":1783,"_21467":56178,"_5":14750,"_28174":56130,"_3058":56179},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3602":1799,"_30987":1783,"_21467":56181,"_5":14750,"_28174":56130,"_3058":56182},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3602":1800,"_30987":1783,"_21467":56184,"_5":14750,"_28174":56130,"_3058":56185},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3602":1801,"_30987":1783,"_21467":56187,"_5":14750,"_28174":56133,"_3058":56188},[],"Section",{"_3602":1802,"_30987":1783,"_21467":56190,"_5":14750,"_28174":56133,"_3058":56191},[],"What you manage",{"_3602":1803,"_30987":1783,"_21467":56193,"_5":14750,"_28174":56133,"_3058":56194},[],"Entry point",{"_3602":1804,"_30987":1783,"_21467":56196,"_5":14750,"_28174":56133,"_3058":56197},[],"**PKI**",{"_3602":1805,"_30987":1783,"_21467":56199,"_5":14750,"_28174":56133,"_3058":56200},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3602":1806,"_30987":1783,"_21467":56202,"_5":14750,"_28174":56133,"_3058":56203},[],"PKI overview",{"_3602":1807,"_30987":1783,"_21467":56205,"_5":14750,"_28174":56133,"_3058":56206},[],"**IoT Fleets**",{"_3602":1808,"_30987":1783,"_21467":56208,"_5":14750,"_28174":56133,"_3058":56209},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3602":1809,"_30987":1783,"_21467":56211,"_5":14750,"_28174":56133,"_3058":56212},[],"IoT Fleets overview",{"_3602":1810,"_30987":1783,"_21467":56214,"_5":14750,"_28174":56133,"_3058":56215},[],"**Administration**",{"_3602":1811,"_30987":1783,"_21467":56217,"_5":14750,"_28174":56133,"_3058":56218},[],"Operator permissions, audit and event subscriptions.",{"_3602":1812,"_30987":1783,"_21467":56220,"_5":14750,"_28174":56133,"_3058":52137},[],{"_3602":1813,"_30987":1783,"_21467":56222,"_5":14750,"_28174":56133,"_3058":56223},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3602":1814,"_30987":1783,"_21467":56225,"_5":14750,"_28174":56137,"_3058":56226},[],"An identity's journey connects four responsibilities:",{"_3602":1815,"_30987":1783,"_21467":56228,"_5":14750,"_28174":56137,"_3058":56229},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3602":1816,"_30987":1783,"_21467":56231,"_5":14750,"_28174":56137,"_3058":56232},[],"The provisioning administrator configures the DMS and initial trust.",{"_3602":1817,"_30987":1783,"_21467":56234,"_5":14750,"_28174":56137,"_3058":56235},[],"The device client requests a certificate and installs it with the matching key.",{"_3602":1818,"_30987":1783,"_21467":56237,"_5":14750,"_28174":56137,"_3058":56238},[],"The consumer validates the identity and applies its access permissions.",{"_3602":1819,"_30987":1783,"_21467":56240,"_5":14750,"_28174":56137,"_3058":56241},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3602":1820,"_30987":1783,"_21467":56243,"_5":14750,"_28174":56145,"_3058":56244},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3602":1821,"_30987":1783,"_21467":56246,"_5":14750,"_28174":56149,"_3058":56247},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3602":1822,"_30987":1783,"_21467":56249,"_5":14750,"_28174":56153,"_3058":56250},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3602":1823,"_30987":1783,"_21467":56252,"_5":14750,"_28174":56157,"_3058":56253},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3602":1824,"_30987":1783,"_21467":56255,"_5":14750,"_28174":56161,"_3058":56256},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3602":1825,"_30987":1783,"_21467":56258,"_5":14750,"_28174":56165,"_3058":56259},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3602":1826,"_30987":1783,"_21467":56261,"_5":14750,"_28174":56169,"_3058":55704},[],{"_3602":1827,"_30987":1783,"_21467":56263,"_5":14750,"_28174":56169,"_3058":56264},[],"What it prepares or checks",{"_3602":1828,"_30987":1783,"_21467":56266,"_5":14750,"_28174":56169,"_3058":55707},[],{"_3602":1829,"_30987":1783,"_21467":56268,"_5":14750,"_28174":56169,"_3058":56269},[],"Key custody, CA hierarchy, profiles and validation.",{"_3602":1830,"_30987":1783,"_21467":56271,"_5":14750,"_28174":56169,"_3058":56272},[],"Fleet administrator",{"_3602":1831,"_30987":1783,"_21467":56274,"_5":14750,"_28174":56169,"_3058":56275},[],"DMS, device admission, renewal policy and inventory.",{"_3602":1832,"_30987":1783,"_21467":56277,"_5":14750,"_28174":56169,"_3058":55719},[],{"_3602":1833,"_30987":1783,"_21467":56279,"_5":14750,"_28174":56169,"_3058":56280},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3602":1834,"_30987":1783,"_21467":56282,"_5":14750,"_28174":56169,"_3058":55725},[],{"_3602":1835,"_30987":1783,"_21467":56284,"_5":14750,"_28174":56169,"_3058":56285},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3602":1836,"_30987":1783,"_21467":56287,"_5":14750,"_28174":56169,"_3058":56288},[],"Infrastructure operator",{"_3602":1837,"_30987":1783,"_21467":56290,"_5":14750,"_28174":56169,"_3058":56291},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3602":1838,"_30987":1783,"_21467":56293,"_5":14750,"_28174":56169,"_3058":56294},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3602":1839,"_30987":1839,"_5":15110,"_3058":56296,"_31325":56297,"_21467":56300,"_28174":1839},"CA hierarchy and rotation",[50623,52135,56298,56299],"PKI","Keys, authorities and certificates",[],{"_3602":1840,"_30987":1839,"_21467":56302,"_5":14750,"_28174":1839,"_3058":56303},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3602":1841,"_30987":1839,"_5":31322,"_21467":56305,"_28174":56306,"_3058":56307},[],"/docs/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3602":1842,"_30987":1839,"_5":31322,"_21467":56309,"_28174":56310,"_3058":56311},[],"/docs/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3602":1843,"_30987":1839,"_5":31322,"_21467":56313,"_28174":56314,"_3058":56315},[],"/docs/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3602":1844,"_30987":1839,"_5":31322,"_21467":56317,"_28174":56318,"_3058":56319},[],"/docs/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3602":1845,"_30987":1839,"_5":31322,"_21467":56321,"_28174":56322,"_3058":56323},[],"/docs/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3602":1846,"_30987":1839,"_5":31322,"_21467":56325,"_28174":56326,"_3058":56327},[],"/docs/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3602":1847,"_30987":1839,"_5":31322,"_21467":56329,"_28174":56330,"_3058":56331},[],"/docs/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3602":1848,"_30987":1839,"_5":31322,"_21467":56333,"_28174":56334,"_3058":56335},[],"/docs/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3602":1849,"_30987":1839,"_5":31322,"_21467":56337,"_28174":56338,"_3058":56339},[],"/docs/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3602":1850,"_30987":1839,"_5":31322,"_21467":56341,"_28174":56342,"_3058":56343},[],"/docs/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3602":1851,"_30987":1839,"_5":31322,"_21467":56345,"_28174":56346,"_3058":56347},[],"/docs/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3602":1852,"_30987":1839,"_5":31322,"_21467":56349,"_28174":56350,"_3058":56351},[],"/docs/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3602":1853,"_30987":1839,"_21467":56353,"_5":14750,"_28174":1839,"_3058":56354},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3602":1854,"_30987":1839,"_21467":56356,"_5":14750,"_28174":1839,"_3058":56357},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3602":1855,"_30987":1839,"_21467":56359,"_5":14750,"_28174":56306,"_3058":56360},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3602":1856,"_30987":1839,"_21467":56362,"_5":14750,"_28174":56306,"_3058":56363},[],"environment, such as production and preproduction;",{"_3602":1857,"_30987":1839,"_21467":56365,"_5":14750,"_28174":56306,"_3058":56366},[],"owner or operating team;",{"_3602":1858,"_30987":1839,"_21467":56368,"_5":14750,"_28174":56306,"_3058":56369},[],"device family or manufacturing process;",{"_3602":1859,"_30987":1839,"_21467":56371,"_5":14750,"_28174":56306,"_3058":56372},[],"region or regulatory requirement;",{"_3602":1860,"_30987":1839,"_21467":56374,"_5":14750,"_28174":56306,"_3058":56375},[],"cryptographic engine or key policy;",{"_3602":1861,"_30987":1839,"_21467":56377,"_5":14750,"_28174":56306,"_3058":56378},[],"maintenance window and renewal cadence.",{"_3602":1862,"_30987":1839,"_21467":56380,"_5":14750,"_28174":56306,"_3058":56381},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3602":1863,"_30987":1839,"_21467":56383,"_5":14750,"_28174":56306,"_3058":56384},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3602":1864,"_30987":1839,"_21467":56386,"_5":14750,"_28174":56310,"_3058":56387},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3602":1865,"_30987":1839,"_21467":56389,"_5":14750,"_28174":56310,"_3058":56390},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing; see the CRL guide.",{"_3602":1866,"_30987":1839,"_21467":56392,"_5":14750,"_28174":56310,"_3058":56393},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3602":1867,"_30987":1839,"_21467":56395,"_5":14750,"_28174":56310,"_3058":56396},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. A subordinate CA is signed by its parent, so the parent must also be `ACTIVE` and inside its validity period; otherwise the reissue fails with `400`. Plan ahead for these conditions.",{"_3602":1868,"_30987":1839,"_21467":56398,"_5":14750,"_28174":56314,"_3058":56399},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3602":1869,"_30987":1839,"_21467":56401,"_5":14750,"_28174":56314,"_3058":56402},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3602":1870,"_30987":1839,"_21467":56404,"_5":14750,"_28174":56314,"_3058":56405},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3602":1871,"_30987":1839,"_21467":56407,"_5":14750,"_28174":56314,"_3058":56408},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3602":1872,"_30987":1839,"_21467":56410,"_5":14750,"_28174":56322,"_3058":56411},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3602":1873,"_30987":1839,"_21467":56413,"_5":14750,"_28174":56326,"_3058":56414},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3602":1874,"_30987":1839,"_21467":56416,"_5":14750,"_28174":56330,"_3058":56417},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3602":1875,"_30987":1839,"_21467":56419,"_5":14750,"_28174":56334,"_3058":56420},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3602":1876,"_30987":1839,"_21467":56422,"_5":14750,"_28174":56338,"_3058":56423},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3602":1877,"_30987":1839,"_21467":56425,"_5":14750,"_28174":56342,"_3058":56426},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3602":1878,"_30987":1839,"_21467":56428,"_5":14750,"_28174":56346,"_3058":56429},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3602":1879,"_30987":1839,"_21467":56431,"_5":14750,"_28174":56346,"_3058":56432},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3602":1880,"_30987":1839,"_21467":56434,"_5":14750,"_28174":56346,"_3058":56435},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3602":1881,"_30987":1839,"_21467":56437,"_5":14750,"_28174":56346,"_3058":56438},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3602":1882,"_30987":1839,"_21467":56440,"_5":14750,"_28174":56350,"_3058":56441},[],"The new chain ends in an anchor installed by the consumer.",{"_3602":1883,"_30987":1839,"_21467":56443,"_5":14750,"_28174":56350,"_3058":56444},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3602":1884,"_30987":1839,"_21467":56446,"_5":14750,"_28174":56350,"_3058":56447},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3602":1885,"_30987":1839,"_21467":56449,"_5":14750,"_28174":56350,"_3058":56450},[],"Re-enrollment accepts the old identity during the planned period.",{"_3602":1886,"_30987":1839,"_21467":56452,"_5":14750,"_28174":56350,"_3058":56453},[],"OCSP and CRL respond for the authorities that remain active.",{"_3602":1887,"_30987":1839,"_21467":56455,"_5":14750,"_28174":56350,"_3058":56456},[],"No DMS is left accidentally issuing from the old CA.",{"_3602":1888,"_30987":1839,"_21467":56458,"_5":14750,"_28174":56350,"_3058":56459},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3602":1889,"_30987":1889,"_5":15110,"_3058":56461,"_31325":56462,"_21467":56463,"_28174":1889},"Certification authorities",[50623,52135,56298,56299],[],{"_3602":1890,"_30987":1889,"_21467":56465,"_5":14750,"_28174":1889,"_3058":56466},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3602":1891,"_30987":1889,"_5":31322,"_21467":56468,"_28174":56469,"_3058":56470},[],"/docs/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3602":1892,"_30987":1889,"_5":31322,"_21467":56472,"_28174":56473,"_3058":56474},[],"/docs/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3602":1893,"_30987":1889,"_5":31322,"_21467":56476,"_28174":56477,"_3058":50633},[],"/docs/platform/pki/certificate-authorities#before-you-begin",{"_3602":1894,"_30987":1889,"_5":31322,"_21467":56479,"_28174":56480,"_3058":56481},[],"/docs/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3602":1895,"_30987":1889,"_5":31322,"_21467":56483,"_28174":56484,"_3058":56485},[],"/docs/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3602":1896,"_30987":1889,"_5":31322,"_21467":56487,"_28174":56488,"_3058":56489},[],"/docs/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3602":1897,"_30987":1889,"_5":31322,"_21467":56491,"_28174":56492,"_3058":56493},[],"/docs/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3602":1898,"_30987":1889,"_5":31322,"_21467":56495,"_28174":56496,"_3058":56497},[],"/docs/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3602":1899,"_30987":1889,"_5":31322,"_21467":56499,"_28174":56500,"_3058":56501},[],"/docs/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3602":1900,"_30987":1889,"_5":31322,"_21467":56503,"_28174":56504,"_3058":56505},[],"/docs/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3602":1901,"_30987":1889,"_5":31322,"_21467":56507,"_28174":56508,"_3058":56509},[],"/docs/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3602":1902,"_30987":1889,"_5":31322,"_21467":56511,"_28174":56512,"_3058":56513},[],"/docs/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3602":1903,"_30987":1889,"_5":31322,"_21467":56515,"_28174":56516,"_3058":56517},[],"/docs/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3602":1904,"_30987":1889,"_5":31322,"_21467":56519,"_28174":56520,"_3058":56521},[],"/docs/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3602":1905,"_30987":1889,"_5":31322,"_21467":56523,"_28174":56524,"_3058":56525},[],"/docs/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3602":1906,"_30987":1889,"_5":31322,"_21467":56527,"_28174":56528,"_3058":56529},[],"/docs/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3602":1907,"_30987":1889,"_5":31322,"_21467":56531,"_28174":56532,"_3058":56533},[],"/docs/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3602":1908,"_30987":1889,"_5":31322,"_21467":56535,"_28174":56536,"_3058":56537},[],"/docs/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3602":1909,"_30987":1889,"_5":31322,"_21467":56539,"_28174":56540,"_3058":56541},[],"/docs/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3602":1910,"_30987":1889,"_5":31322,"_21467":56543,"_28174":56544,"_3058":56545},[],"/docs/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3602":1911,"_30987":1889,"_5":31322,"_21467":56547,"_28174":56548,"_3058":56549},[],"/docs/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3602":1912,"_30987":1889,"_5":31322,"_21467":56551,"_28174":56552,"_3058":56553},[],"/docs/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3602":1913,"_30987":1889,"_5":31322,"_21467":56555,"_28174":56556,"_3058":56557},[],"/docs/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3602":1914,"_30987":1889,"_21467":56559,"_5":14750,"_28174":1889,"_3058":56560},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3602":1915,"_30987":1889,"_21467":56562,"_5":14750,"_28174":1889,"_3058":56563},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3602":1916,"_30987":1889,"_21467":56565,"_5":14750,"_28174":1889,"_3058":56566},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3602":1917,"_30987":1889,"_21467":56568,"_5":14750,"_28174":56469,"_3058":56569},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3602":1918,"_30987":1889,"_21467":56571,"_5":14750,"_28174":56469,"_3058":56572},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3602":1919,"_30987":1889,"_21467":56574,"_5":14750,"_28174":56469,"_3058":56575},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3602":1920,"_30987":1889,"_21467":56577,"_5":14750,"_28174":56469,"_3058":56578},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3602":1921,"_30987":1889,"_21467":56580,"_5":14750,"_28174":56469,"_3058":56581},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3602":1922,"_30987":1889,"_21467":56583,"_5":14750,"_28174":56477,"_3058":56584},[],"Decide whether the CA will be a root or an intermediate.",{"_3602":1923,"_30987":1889,"_21467":56586,"_5":14750,"_28174":56477,"_3058":56587},[],"Choose the engine that will keep the key.",{"_3602":1924,"_30987":1889,"_21467":56589,"_5":14750,"_28174":56477,"_3058":56590},[],"Define a validity longer than that of the certificates it will issue.",{"_3602":1925,"_30987":1889,"_21467":56592,"_5":14750,"_28174":56477,"_3058":56593},[],"For an intermediate CA, make sure the parent CA is active.",{"_3602":1926,"_30987":1889,"_21467":56595,"_5":14750,"_28174":56480,"_3058":56596},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3602":1927,"_30987":1889,"_21467":56598,"_5":14750,"_28174":56484,"_3058":56599},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3602":1928,"_30987":1889,"_21467":56601,"_5":14750,"_28174":56484,"_3058":56602},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3602":1929,"_30987":1889,"_21467":56604,"_5":14750,"_28174":56488,"_3058":56605},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3602":1930,"_30987":1889,"_21467":56607,"_5":14750,"_28174":56492,"_3058":56608},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3602":1931,"_30987":1889,"_21467":56610,"_5":14750,"_28174":56492,"_3058":56611},[],"`C`: two-letter ISO 3166-1 country code.",{"_3602":1932,"_30987":1889,"_21467":56613,"_5":14750,"_28174":56492,"_3058":56614},[],"`ST`: state or province.",{"_3602":1933,"_30987":1889,"_21467":56616,"_5":14750,"_28174":56492,"_3058":56617},[],"`L`: locality.",{"_3602":1934,"_30987":1889,"_21467":56619,"_5":14750,"_28174":56492,"_3058":56620},[],"`O`: organization.",{"_3602":1935,"_30987":1889,"_21467":56622,"_5":14750,"_28174":56492,"_3058":56623},[],"`OU`: organizational unit.",{"_3602":1936,"_30987":1889,"_21467":56625,"_5":14750,"_28174":56492,"_3058":56626},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3602":1937,"_30987":1889,"_21467":56628,"_5":14750,"_28174":56496,"_3058":56629},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3602":1938,"_30987":1889,"_21467":56631,"_5":14750,"_28174":56496,"_3058":56632},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3602":1939,"_30987":1889,"_21467":56634,"_5":14750,"_28174":56500,"_3058":56635},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3602":1940,"_30987":1889,"_21467":56637,"_5":14750,"_28174":56500,"_3058":56638},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3602":1941,"_30987":1889,"_21467":56640,"_5":14750,"_28174":56504,"_3058":56641},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3602":1942,"_30987":1889,"_21467":56643,"_5":14750,"_28174":56504,"_3058":56644},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3602":1943,"_30987":1889,"_21467":56646,"_5":14750,"_28174":56508,"_3058":56647},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3602":1944,"_30987":1889,"_21467":56649,"_5":14750,"_28174":56508,"_3058":56650},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3602":1945,"_30987":1889,"_21467":56652,"_5":14750,"_28174":56508,"_3058":56653},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3602":1946,"_30987":1889,"_21467":56655,"_5":14750,"_28174":56512,"_3058":56656},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3602":1947,"_30987":1889,"_21467":56658,"_5":14750,"_28174":56516,"_3058":56659},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3602":1948,"_30987":1889,"_21467":56661,"_5":14750,"_28174":56516,"_3058":56662},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3602":1949,"_30987":1889,"_21467":56664,"_5":14750,"_28174":56520,"_3058":56665},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3602":1950,"_30987":1889,"_21467":56667,"_5":14750,"_28174":56524,"_3058":56668},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3602":1951,"_30987":1889,"_21467":56670,"_5":14750,"_28174":56524,"_3058":56671},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3602":1952,"_30987":1889,"_21467":56673,"_5":14750,"_28174":56528,"_3058":56674},[],"Open a CA from the inventory to review:",{"_3602":1953,"_30987":1889,"_21467":56676,"_5":14750,"_28174":56528,"_3058":56677},[],"Status and validity period.",{"_3602":1954,"_30987":1889,"_21467":56679,"_5":14750,"_28174":56528,"_3058":56680},[],"Certificate and chain in PEM format.",{"_3602":1955,"_30987":1889,"_21467":56682,"_5":14750,"_28174":56528,"_3058":56683},[],"Number of active, expired and revoked certificates.",{"_3602":1956,"_30987":1889,"_21467":56685,"_5":14750,"_28174":56528,"_3058":56686},[],"Certificates issued in **Issued Certificates**.",{"_3602":1957,"_30987":1889,"_21467":56688,"_5":14750,"_28174":56528,"_3058":56689},[],"The CRL linked to the authority.",{"_3602":1958,"_30987":1889,"_21467":56691,"_5":14750,"_28174":56528,"_3058":56692},[],"Metadata and the associated cryptographic engine.",{"_3602":1959,"_30987":1889,"_21467":56694,"_5":14750,"_28174":56528,"_3058":56695},[],"You can filter the inventory by name, status and CA type.",{"_3602":1960,"_30987":1889,"_21467":56697,"_5":14750,"_28174":56532,"_3058":56698},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3602":1961,"_30987":1889,"_21467":56700,"_5":14750,"_28174":56532,"_3058":56701},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3602":1962,"_30987":1889,"_21467":56703,"_5":14750,"_28174":56532,"_3058":56704},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3602":1963,"_30987":1889,"_21467":56706,"_5":14750,"_28174":56532,"_3058":56707},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3602":1964,"_30987":1889,"_21467":56709,"_5":14750,"_28174":56532,"_3058":56710},[],"A CA key signs certificates only. The CA API has no endpoint to sign or verify arbitrary data. To sign and verify a message with a key, use the KMS operations described in Key management, subject to their own permissions.",{"_3602":1965,"_30987":1889,"_21467":56712,"_5":14750,"_28174":56532,"_3058":56713},[],"A CA signs only while its status is `ACTIVE` and the current time falls inside the validity period of its certificate. Lamassu checks both, because the stored status can lag behind the dates until the expiration monitor runs. Otherwise the request fails with `400` and the message `CA Status inconsistent`, before the KMS is called. The same check applies when the CA signs the certificate of a subordinate CA, including when you create or reissue it.",{"_3602":1966,"_30987":1889,"_21467":56715,"_5":14750,"_28174":56536,"_3058":56716},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3602":1967,"_30987":1889,"_21467":56718,"_5":14750,"_28174":56540,"_3058":56719},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3602":1968,"_30987":1889,"_21467":56721,"_5":14750,"_28174":56544,"_3058":56722},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3602":1969,"_30987":1889,"_21467":56724,"_5":14750,"_28174":56548,"_3058":56725},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3602":1970,"_30987":1889,"_21467":56727,"_5":14750,"_28174":56552,"_3058":56728},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3602":1971,"_30987":1889,"_21467":56730,"_5":14750,"_28174":56556,"_3058":56731},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3602":1972,"_30987":1889,"_21467":56733,"_5":14750,"_28174":56556,"_3058":56734},[],"The CA’s CRL settings are kept. A deletion is refused with a `409` error while they are still `ACTIVE`: the VA must first publish the CA’s final CRL, which can take up to about an hour after revocation with the default job schedule, so retry after the final CRL is published. An expired CA is finalized without a final CRL, and a CA on hold (`CertificateHold`) is refused with a message asking you to revoke it permanently first. The deletion is also refused with a `409` when the CA’s key signs the CRLs of another CA: the error names that CA, so change its CRL signer, or delete or revoke it, before deleting this one. The CA and all its descendants are checked before anything is deleted; nothing changes if any of them cannot be deleted.",{"_3602":1973,"_30987":1889,"_21467":56736,"_5":14750,"_28174":56556,"_3058":56737},[],"After the deletion, the settings are archived and the last CRL keeps being served but is never regenerated; you can remove them once no certificate issued by the CA still needs revocation evidence, using `DELETE /v1/crl-settings/{ca-id}` or the console's **Verification Authorities** page. Deleting them stops the CRL from being served and cannot be undone. Adjust the validity and signer before revoking or deleting the CA (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3602":1974,"_30987":1889,"_21467":56739,"_5":14750,"_28174":56556,"_3058":56740},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: until those settings are deleted, those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL).",{"_3602":1975,"_30987":1975,"_5":15110,"_3058":56742,"_31325":56743,"_21467":56744,"_28174":1975},"Certificate profiles",[50623,52135,56298,56299],[],{"_3602":1976,"_30987":1975,"_21467":56746,"_5":14750,"_28174":1975,"_3058":56747},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3602":1977,"_30987":1975,"_5":31322,"_21467":56749,"_28174":56750,"_3058":56751},[],"/docs/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3602":1978,"_30987":1975,"_5":31322,"_21467":56753,"_28174":56754,"_3058":56755},[],"/docs/platform/pki/certificate-profiles#validity","Validity",{"_3602":1979,"_30987":1975,"_5":31322,"_21467":56757,"_28174":56758,"_3058":56759},[],"/docs/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3602":1980,"_30987":1975,"_5":31322,"_21467":56761,"_28174":56762,"_3058":56763},[],"/docs/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3602":1981,"_30987":1975,"_5":31322,"_21467":56765,"_28174":56766,"_3058":56767},[],"/docs/platform/pki/certificate-profiles#subject","Subject",{"_3602":1982,"_30987":1975,"_5":31322,"_21467":56769,"_28174":56770,"_3058":56771},[],"/docs/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3602":1983,"_30987":1975,"_5":31322,"_21467":56773,"_28174":56774,"_3058":56775},[],"/docs/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3602":1984,"_30987":1975,"_5":31322,"_21467":56777,"_28174":56778,"_3058":56779},[],"/docs/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3602":1985,"_30987":1975,"_5":31322,"_21467":56781,"_28174":56782,"_3058":56783},[],"/docs/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3602":1986,"_30987":1975,"_5":31322,"_21467":56785,"_28174":56786,"_3058":56787},[],"/docs/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3602":1987,"_30987":1975,"_5":31322,"_21467":56789,"_28174":56790,"_3058":56791},[],"/docs/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3602":1988,"_30987":1975,"_5":31322,"_21467":56793,"_28174":56794,"_3058":56795},[],"/docs/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3602":1989,"_30987":1975,"_5":31322,"_21467":56797,"_28174":56798,"_3058":56799},[],"/docs/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3602":1990,"_30987":1975,"_5":31322,"_21467":56801,"_28174":56802,"_3058":56803},[],"/docs/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3602":1991,"_30987":1975,"_5":31322,"_21467":56805,"_28174":56806,"_3058":56807},[],"/docs/platform/pki/certificate-profiles#design-examples","Design examples",{"_3602":1992,"_30987":1975,"_5":31322,"_21467":56809,"_28174":56810,"_3058":56811},[],"/docs/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3602":1993,"_30987":1975,"_21467":56813,"_5":14750,"_28174":1975,"_3058":56814},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3602":1994,"_30987":1975,"_21467":56816,"_5":14750,"_28174":1975,"_3058":56817},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3602":1995,"_30987":1975,"_21467":56819,"_5":14750,"_28174":56754,"_3058":56820},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3602":1996,"_30987":1975,"_21467":56822,"_5":14750,"_28174":56754,"_3058":56823},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3602":1997,"_30987":1975,"_21467":56825,"_5":14750,"_28174":56758,"_3058":56826},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Lamassu enforces this: a profile with `Sign as CA` is consumed only when creating or reissuing a CA. Any signing request that resolves to such a profile is rejected — direct signing with a CA, including certificate issuance requests on it, and DMS enrollment or re-enrollment. Nothing validates the profile when it is saved: if a CA's default profile or a DMS profile has `Sign as CA` enabled, the problem appears on the first signing request that resolves to it — for a DMS profile, when a device tries to enroll or re-enroll — and renewal stays blocked until the profile is changed.",{"_3602":1998,"_30987":1975,"_21467":56828,"_5":14750,"_28174":56762,"_3058":56829},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3602":1999,"_30987":1975,"_21467":56831,"_5":14750,"_28174":56762,"_3058":56832},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3602":2000,"_30987":1975,"_21467":56834,"_5":14750,"_28174":56762,"_3058":56835},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3602":2001,"_30987":1975,"_21467":56837,"_5":14750,"_28174":56766,"_3058":56838},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3602":2002,"_30987":1975,"_21467":56840,"_5":14750,"_28174":56770,"_3058":56841},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3602":2003,"_30987":1975,"_21467":56843,"_5":14750,"_28174":56770,"_3058":56844},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3602":2004,"_30987":1975,"_21467":56846,"_5":14750,"_28174":56774,"_3058":56847},[],"The cryptographic enforcement can:",{"_3602":2005,"_30987":1975,"_21467":56849,"_5":14750,"_28174":56774,"_3058":56850},[],"allow or block RSA keys;",{"_3602":2006,"_30987":1975,"_21467":56852,"_5":14750,"_28174":56774,"_3058":56853},[],"limit the supported RSA sizes;",{"_3602":2007,"_30987":1975,"_21467":56855,"_5":14750,"_28174":56774,"_3058":56856},[],"allow or block ECDSA keys;",{"_3602":2008,"_30987":1975,"_21467":56858,"_5":14750,"_28174":56774,"_3058":56859},[],"limit the supported ECDSA sizes or curves.",{"_3602":2009,"_30987":1975,"_21467":56861,"_5":14750,"_28174":56774,"_3058":56862},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3602":2010,"_30987":1975,"_21467":56864,"_5":14750,"_28174":56778,"_3058":56865},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3602":2011,"_30987":1975,"_21467":56867,"_5":14750,"_28174":56778,"_3058":54060},[],{"_3602":2012,"_30987":1975,"_21467":56869,"_5":14750,"_28174":56778,"_3058":56870},[],"First choice",{"_3602":2013,"_30987":1975,"_21467":56872,"_5":14750,"_28174":56778,"_3058":56873},[],"Second choice",{"_3602":2014,"_30987":1975,"_21467":56875,"_5":14750,"_28174":56778,"_3058":56876},[],"If neither is supplied",{"_3602":2015,"_30987":1975,"_21467":56878,"_5":14750,"_28174":56778,"_3058":56879},[],"Direct signing with a CA",{"_3602":2016,"_30987":1975,"_21467":56881,"_5":14750,"_28174":56778,"_3058":56882},[],"`issuance_profile` embedded in the request",{"_3602":2017,"_30987":1975,"_21467":56884,"_5":14750,"_28174":56778,"_3058":56885},[],"Request `issuance_profile_id`",{"_3602":2018,"_30987":1975,"_21467":56887,"_5":14750,"_28174":56778,"_3058":56888},[],"CA default profile (`profile_id`).",{"_3602":2019,"_30987":1975,"_21467":56890,"_5":14750,"_28174":56778,"_3058":56891},[],"Issuance through a DMS",{"_3602":2020,"_30987":1975,"_21467":56893,"_5":14750,"_28174":56778,"_3058":56894},[],"`settings.issuance_profile_id`",{"_3602":2021,"_30987":1975,"_21467":56896,"_5":14750,"_28174":56778,"_3058":56897},[],"`settings.issuance_profile` embedded in the DMS",{"_3602":2022,"_30987":1975,"_21467":56899,"_5":14750,"_28174":56778,"_3058":56900},[],"Enrollment CA default profile.",{"_3602":2023,"_30987":1975,"_21467":56902,"_5":14750,"_28174":56778,"_3058":56903},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3602":2024,"_30987":1975,"_21467":56905,"_5":14750,"_28174":56778,"_3058":56906},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3602":2025,"_30987":1975,"_21467":56908,"_5":14750,"_28174":56786,"_3058":56909},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3602":2026,"_30987":1975,"_21467":56911,"_5":14750,"_28174":56790,"_3058":56912},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3602":2027,"_30987":1975,"_21467":56914,"_5":14750,"_28174":56794,"_3058":56915},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3602":2028,"_30987":1975,"_21467":56917,"_5":14750,"_28174":56798,"_3058":56918},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3602":2029,"_30987":1975,"_21467":56920,"_5":14750,"_28174":56802,"_3058":56921},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3602":2030,"_30987":1975,"_21467":56923,"_5":14750,"_28174":56802,"_3058":56924},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3602":2031,"_30987":1975,"_21467":56926,"_5":14750,"_28174":56806,"_3058":56927},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3602":2032,"_30987":1975,"_21467":56929,"_5":14750,"_28174":56806,"_3058":56930},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3602":2033,"_30987":1975,"_21467":56932,"_5":14750,"_28174":56806,"_3058":56933},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3602":2034,"_30987":1975,"_21467":56935,"_5":14750,"_28174":56806,"_3058":56936},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3602":2035,"_30987":1975,"_21467":56938,"_5":14750,"_28174":56810,"_3058":56939},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3602":2036,"_30987":1975,"_21467":56941,"_5":14750,"_28174":56810,"_3058":56942},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3602":2037,"_30987":2037,"_5":15110,"_3058":56944,"_31325":56945,"_21467":56947,"_28174":2037},"Certificate validation",[50623,52135,56298,56946],"Validation",[],{"_3602":2038,"_30987":2037,"_21467":56949,"_5":14750,"_28174":2037,"_3058":56950},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3602":2039,"_30987":2037,"_5":31322,"_21467":56952,"_28174":56953,"_3058":56954},[],"/docs/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3602":2040,"_30987":2037,"_5":31322,"_21467":56956,"_28174":56957,"_3058":56958},[],"/docs/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3602":2041,"_30987":2037,"_5":31322,"_21467":56960,"_28174":56961,"_3058":56962},[],"/docs/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3602":2042,"_30987":2037,"_21467":56964,"_5":14750,"_28174":2037,"_3058":56965},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3602":2043,"_30987":2037,"_21467":56967,"_5":14750,"_28174":56953,"_3058":56968},[],"Verify these criteria together:",{"_3602":2044,"_30987":2037,"_21467":56970,"_5":14750,"_28174":56953,"_3058":55924},[],{"_3602":2045,"_30987":2037,"_21467":56972,"_5":14750,"_28174":56953,"_3058":56973},[],"Required result",{"_3602":2046,"_30987":2037,"_21467":56975,"_5":14750,"_28174":56953,"_3058":56976},[],"Chain and signature",{"_3602":2047,"_30987":2037,"_21467":56978,"_5":14750,"_28174":56953,"_3058":56979},[],"Valid chain to a root deliberately installed in the consumer.",{"_3602":2048,"_30987":2037,"_21467":56981,"_5":14750,"_28174":56953,"_3058":56982},[],"Dates",{"_3602":2049,"_30987":2037,"_21467":56984,"_5":14750,"_28174":56953,"_3058":56985},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3602":2050,"_30987":2037,"_21467":56987,"_5":14750,"_28174":56953,"_3058":51804},[],{"_3602":2051,"_30987":2037,"_21467":56989,"_5":14750,"_28174":56953,"_3058":56990},[],"Name, SAN or identifier matches the expected peer.",{"_3602":2052,"_30987":2037,"_21467":56992,"_5":14750,"_28174":56953,"_3058":51013},[],{"_3602":2053,"_30987":2037,"_21467":56994,"_5":14750,"_28174":56953,"_3058":56995},[],"KU, EKU and constraints permit the specific operation.",{"_3602":2054,"_30987":2037,"_21467":56997,"_5":14750,"_28174":56953,"_3058":56998},[],"Revocation",{"_3602":2055,"_30987":2037,"_21467":57000,"_5":14750,"_28174":56953,"_3058":57001},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3602":2056,"_30987":2037,"_21467":57003,"_5":14750,"_28174":56953,"_3058":57004},[],"Authorization",{"_3602":2057,"_30987":2037,"_21467":57006,"_5":14750,"_28174":56953,"_3058":57007},[],"The application permits that identity to perform the action.",{"_3602":2058,"_30987":2037,"_21467":57009,"_5":14750,"_28174":56953,"_3058":57010},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3602":2059,"_30987":2037,"_21467":57012,"_5":14750,"_28174":56957,"_3058":57013},[],"Mechanism",{"_3602":2060,"_30987":2037,"_21467":57015,"_5":14750,"_28174":56957,"_3058":57016},[],"When to use it",{"_3602":2061,"_30987":2037,"_21467":57018,"_5":14750,"_28174":56957,"_3058":57019},[],"What you must maintain",{"_3602":2062,"_30987":2037,"_21467":57021,"_5":14750,"_28174":56957,"_3058":57022},[],"OCSP",{"_3602":2063,"_30987":2037,"_21467":57024,"_5":14750,"_28174":56957,"_3058":57025},[],"Status query for a specific certificate.",{"_3602":2064,"_30987":2037,"_21467":57027,"_5":14750,"_28174":56957,"_3058":57028},[],"Responder access, signature verification and cache/freshness policy.",{"_3602":2065,"_30987":2037,"_21467":57030,"_5":14750,"_28174":56957,"_3058":57031},[],"CRL",{"_3602":2066,"_30987":2037,"_21467":57033,"_5":14750,"_28174":56957,"_3058":57034},[],"Local checks for many certificates or offline operation.",{"_3602":2067,"_30987":2037,"_21467":57036,"_5":14750,"_28174":56957,"_3058":57037},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3602":2068,"_30987":2037,"_21467":57039,"_5":14750,"_28174":56957,"_3058":57040},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3602":2069,"_30987":2037,"_21467":57042,"_5":14750,"_28174":56957,"_3058":57043},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3602":2070,"_30987":2037,"_21467":57045,"_5":14750,"_28174":56961,"_3058":57046},[],"Accept a current, authorized certificate with a known chain.",{"_3602":2071,"_30987":2037,"_21467":57048,"_5":14750,"_28174":56961,"_3058":57049},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3602":2072,"_30987":2037,"_21467":57051,"_5":14750,"_28174":56961,"_3058":57052},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3602":2073,"_30987":2037,"_21467":57054,"_5":14750,"_28174":56961,"_3058":57055},[],"Check that a new connection with that identity is rejected.",{"_3602":2074,"_30987":2037,"_21467":57057,"_5":14750,"_28174":56961,"_3058":57058},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3602":2075,"_30987":2037,"_21467":57060,"_5":14750,"_28174":56961,"_3058":57061},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3602":2076,"_30987":2037,"_21467":57063,"_5":14750,"_28174":56961,"_3058":57064},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3602":2077,"_30987":2037,"_21467":57066,"_5":14750,"_28174":56961,"_3058":57067},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3602":2078,"_30987":2037,"_21467":57069,"_5":14750,"_28174":56961,"_3058":57070},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3602":2079,"_30987":2079,"_5":15110,"_3058":57072,"_31325":57073,"_21467":57074,"_28174":2079},"Certificates",[50623,52135,56298,56299],[],{"_3602":2080,"_30987":2079,"_21467":57076,"_5":14750,"_28174":2079,"_3058":57077},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3602":2081,"_30987":2079,"_5":31322,"_21467":57079,"_28174":57080,"_3058":57081},[],"/docs/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3602":2082,"_30987":2079,"_5":31322,"_21467":57083,"_28174":57084,"_3058":57085},[],"/docs/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3602":2083,"_30987":2079,"_5":31322,"_21467":57087,"_28174":57088,"_3058":57089},[],"/docs/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3602":2084,"_30987":2079,"_5":31322,"_21467":57091,"_28174":57092,"_3058":57093},[],"/docs/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3602":2085,"_30987":2079,"_5":31322,"_21467":57095,"_28174":57096,"_3058":57097},[],"/docs/platform/pki/certificates#open-the-action","Open the action",{"_3602":2086,"_30987":2079,"_5":31322,"_21467":57099,"_28174":57100,"_3058":57101},[],"/docs/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3602":2087,"_30987":2079,"_5":31322,"_21467":57103,"_28174":57104,"_3058":57105},[],"/docs/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3602":2088,"_30987":2079,"_5":31322,"_21467":57107,"_28174":57108,"_3058":57109},[],"/docs/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3602":2089,"_30987":2079,"_5":31322,"_21467":57111,"_28174":57112,"_3058":57113},[],"/docs/platform/pki/certificates#continue","Continue",{"_3602":2090,"_30987":2079,"_21467":57115,"_5":14750,"_28174":2079,"_3058":57116},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3602":2091,"_30987":2079,"_21467":57118,"_5":14750,"_28174":57080,"_3058":57119},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3602":2092,"_30987":2079,"_21467":57121,"_5":14750,"_28174":57080,"_3058":57122},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3602":2093,"_30987":2079,"_21467":57124,"_5":14750,"_28174":57080,"_3058":57125},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3602":2094,"_30987":2079,"_21467":57127,"_5":14750,"_28174":57080,"_3058":57128},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3602":2095,"_30987":2079,"_21467":57130,"_5":14750,"_28174":57080,"_3058":57131},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3602":2096,"_30987":2079,"_21467":57133,"_5":14750,"_28174":57080,"_3058":57134},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3602":2097,"_30987":2079,"_21467":57136,"_5":14750,"_28174":57080,"_3058":57137},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3602":2098,"_30987":2079,"_21467":57139,"_5":14750,"_28174":57084,"_3058":57140},[],"Download the PEM and inspect it:",{"_3602":2099,"_30987":2079,"_21467":57142,"_5":14750,"_28174":57084,"_3058":57143},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3602":2100,"_30987":2079,"_21467":57145,"_5":14750,"_28174":57088,"_3058":57146},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3602":2101,"_30987":2079,"_21467":57148,"_5":14750,"_28174":57088,"_3058":57149},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3602":2102,"_30987":2079,"_21467":57151,"_5":14750,"_28174":57088,"_3058":57152},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3602":2103,"_30987":2079,"_21467":57154,"_5":14750,"_28174":57088,"_3058":57155},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3602":2104,"_30987":2079,"_21467":57157,"_5":14750,"_28174":57088,"_3058":57158},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3602":2105,"_30987":2079,"_21467":57160,"_5":14750,"_28174":57088,"_3058":57161},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3602":2106,"_30987":2079,"_21467":57163,"_5":14750,"_28174":57088,"_3058":57164},[],"For browser key generation, follow Issue your first certificate.",{"_3602":2107,"_30987":2079,"_21467":57166,"_5":14750,"_28174":57092,"_3058":57167},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3602":2108,"_30987":2079,"_21467":57169,"_5":14750,"_28174":57096,"_3058":57170},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3602":2109,"_30987":2079,"_21467":57172,"_5":14750,"_28174":57100,"_3058":57173},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3602":2110,"_30987":2079,"_21467":57175,"_5":14750,"_28174":57104,"_3058":57176},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3602":2111,"_30987":2079,"_21467":57178,"_5":14750,"_28174":57104,"_3058":57179},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3602":2112,"_30987":2079,"_21467":57181,"_5":14750,"_28174":57104,"_3058":57182},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3602":2113,"_30987":2079,"_21467":57184,"_5":14750,"_28174":57108,"_3058":57185},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3602":2114,"_30987":2079,"_21467":57187,"_5":14750,"_28174":57108,"_3058":57188},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3602":2115,"_30987":2079,"_21467":57190,"_5":14750,"_28174":57108,"_3058":57191},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3602":2116,"_30987":2079,"_21467":57193,"_5":14750,"_28174":57112,"_3058":57194},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3602":2117,"_30987":2079,"_21467":57196,"_5":14750,"_28174":57112,"_3058":57197},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3602":2118,"_30987":2118,"_5":15110,"_3058":57199,"_31325":57200,"_21467":57202,"_28174":2118},"Certificate lifecycle",[50623,52135,56298,57201],"Concepts",[],{"_3602":2119,"_30987":2118,"_21467":57204,"_5":14750,"_28174":2118,"_3058":57205},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3602":2120,"_30987":2118,"_5":31322,"_21467":57207,"_28174":57208,"_3058":57209},[],"/docs/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3602":2121,"_30987":2118,"_5":31322,"_21467":57211,"_28174":57212,"_3058":57213},[],"/docs/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3602":2122,"_30987":2118,"_5":31322,"_21467":57215,"_28174":57216,"_3058":57217},[],"/docs/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3602":2123,"_30987":2118,"_5":31322,"_21467":57219,"_28174":57220,"_3058":57221},[],"/docs/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3602":2124,"_30987":2118,"_5":31322,"_21467":57223,"_28174":57224,"_3058":57225},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3602":2125,"_30987":2118,"_5":31322,"_21467":57227,"_28174":57228,"_3058":57229},[],"/docs/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3602":2126,"_30987":2118,"_5":31322,"_21467":57231,"_28174":57232,"_3058":57233},[],"/docs/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3602":2127,"_30987":2118,"_5":31322,"_21467":57235,"_28174":57236,"_3058":57237},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3602":2128,"_30987":2118,"_5":31322,"_21467":57239,"_28174":57240,"_3058":57241},[],"/docs/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3602":2129,"_30987":2118,"_5":31322,"_21467":57243,"_28174":57244,"_3058":57245},[],"/docs/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3602":2130,"_30987":2118,"_21467":57247,"_5":14750,"_28174":2118,"_3058":57248},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3602":2131,"_30987":2118,"_21467":57250,"_5":14750,"_28174":57212,"_3058":57251},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3602":2132,"_30987":2118,"_21467":57253,"_5":14750,"_28174":57216,"_3058":57254},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3602":2133,"_30987":2118,"_21467":57256,"_5":14750,"_28174":57220,"_3058":57257},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3602":2134,"_30987":2118,"_21467":57259,"_5":14750,"_28174":57224,"_3058":57260},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3602":2135,"_30987":2118,"_21467":57262,"_5":14750,"_28174":57228,"_3058":57263},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3602":2136,"_30987":2118,"_21467":57265,"_5":14750,"_28174":57232,"_3058":57266},[],"Lamassu persists four X.509 states:",{"_3602":2137,"_30987":2118,"_21467":57268,"_5":14750,"_28174":57232,"_3058":57269},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3602":2138,"_30987":2118,"_21467":57271,"_5":14750,"_28174":57232,"_3058":57272},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3602":2139,"_30987":2118,"_21467":57274,"_5":14750,"_28174":57232,"_3058":57275},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3602":2140,"_30987":2118,"_21467":57277,"_5":14750,"_28174":57232,"_3058":57278},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3602":2141,"_30987":2118,"_21467":57280,"_5":14750,"_28174":57232,"_3058":57281},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3602":2142,"_30987":2118,"_21467":57283,"_5":14750,"_28174":57236,"_3058":57284},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3602":2143,"_30987":2118,"_21467":57286,"_5":14750,"_28174":57236,"_3058":57287},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3602":2144,"_30987":2118,"_21467":57289,"_5":14750,"_28174":57236,"_3058":57290},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3602":2145,"_30987":2118,"_21467":57292,"_5":14750,"_28174":57240,"_3058":57293},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3602":2146,"_30987":2118,"_21467":57295,"_5":14750,"_28174":57240,"_3058":57296},[],"Before confirming:",{"_3602":2147,"_30987":2118,"_21467":57298,"_5":14750,"_28174":57240,"_3058":57299},[],"Identify DMSs, devices and services that trust that chain.",{"_3602":2148,"_30987":2118,"_21467":57301,"_5":14750,"_28174":57240,"_3058":57302},[],"Distribute the new chain of trust.",{"_3602":2149,"_30987":2118,"_21467":57304,"_5":14750,"_28174":57240,"_3058":57305},[],"Reissue the necessary identities.",{"_3602":2150,"_30987":2118,"_21467":57307,"_5":14750,"_28174":57240,"_3058":57308},[],"Check OCSP and CRL from a real consumer.",{"_3602":2151,"_30987":2118,"_21467":57310,"_5":14750,"_28174":57240,"_3058":57311},[],"Revoke the old CA once no legitimate traffic remains.",{"_3602":2152,"_30987":2118,"_21467":57313,"_5":14750,"_28174":57240,"_3058":57314},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3602":2153,"_30987":2118,"_21467":57316,"_5":14750,"_28174":57244,"_3058":57317},[],"Certificates entering the preventive or critical renewal window.",{"_3602":2154,"_30987":2118,"_21467":57319,"_5":14750,"_28174":57244,"_3058":57320},[],"Repeated enrollment or re-enrollment failures.",{"_3602":2155,"_30987":2118,"_21467":57322,"_5":14750,"_28174":57244,"_3058":57323},[],"Status changes and revocation reasons.",{"_3602":2156,"_30987":2118,"_21467":57325,"_5":14750,"_28174":57244,"_3058":57326},[],"OCSP and CRL publication and validity.",{"_3602":2157,"_30987":2118,"_21467":57328,"_5":14750,"_28174":57244,"_3058":57329},[],"Dependencies still presenting a replaced certificate.",{"_3602":2158,"_30987":2118,"_21467":57331,"_5":14750,"_28174":57244,"_3058":57332},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3602":2159,"_30987":2159,"_5":15110,"_3058":57334,"_31325":57335,"_21467":57336,"_28174":2159},"Trust model",[50623,52135,56298,57201],[],{"_3602":2160,"_30987":2159,"_21467":57338,"_5":14750,"_28174":2159,"_3058":57339},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3602":2161,"_30987":2159,"_5":31322,"_21467":57341,"_28174":57342,"_3058":57343},[],"/docs/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3602":2162,"_30987":2159,"_5":31322,"_21467":57345,"_28174":57346,"_3058":57347},[],"/docs/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3602":2163,"_30987":2159,"_5":31322,"_21467":57349,"_28174":57350,"_3058":57351},[],"/docs/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3602":2164,"_30987":2159,"_5":31322,"_21467":57353,"_28174":57354,"_3058":57355},[],"/docs/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3602":2165,"_30987":2159,"_5":31322,"_21467":57357,"_28174":57358,"_3058":57359},[],"/docs/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3602":2166,"_30987":2159,"_5":31322,"_21467":57361,"_28174":57362,"_3058":57363},[],"/docs/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3602":2167,"_30987":2159,"_5":31322,"_21467":57365,"_28174":57366,"_3058":57367},[],"/docs/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3602":2168,"_30987":2159,"_5":31322,"_21467":57369,"_28174":57370,"_3058":57371},[],"/docs/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3602":2169,"_30987":2159,"_5":31322,"_21467":57373,"_28174":57374,"_3058":57375},[],"/docs/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3602":2170,"_30987":2159,"_5":31322,"_21467":57377,"_28174":57378,"_3058":57379},[],"/docs/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3602":2171,"_30987":2159,"_21467":57381,"_5":14750,"_28174":2159,"_3058":57382},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3602":2172,"_30987":2159,"_21467":57384,"_5":14750,"_28174":57346,"_3058":57385},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3602":2173,"_30987":2159,"_21467":57387,"_5":14750,"_28174":57350,"_3058":57388},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3602":2174,"_30987":2159,"_21467":57390,"_5":14750,"_28174":57354,"_3058":57391},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3602":2175,"_30987":2159,"_21467":57393,"_5":14750,"_28174":57358,"_3058":57394},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3602":2176,"_30987":2159,"_21467":57396,"_5":14750,"_28174":57362,"_3058":57397},[],"The device proves it can enroll according to the DMS policy.",{"_3602":2177,"_30987":2159,"_21467":57399,"_5":14750,"_28174":57362,"_3058":57400},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3602":2178,"_30987":2159,"_21467":57402,"_5":14750,"_28174":57362,"_3058":57403},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3602":2179,"_30987":2159,"_21467":57405,"_5":14750,"_28174":57362,"_3058":57406},[],"The device installs the certificate and the chain it needs.",{"_3602":2180,"_30987":2159,"_21467":57408,"_5":14750,"_28174":57362,"_3058":57409},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3602":2181,"_30987":2159,"_21467":57411,"_5":14750,"_28174":57362,"_3058":57412},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3602":2182,"_30987":2159,"_21467":57414,"_5":14750,"_28174":57366,"_3058":57415},[],"A DMS relates three sets that are worth designing separately:",{"_3602":2183,"_30987":2159,"_21467":57417,"_5":14750,"_28174":57366,"_3058":57418},[],"**Enrollment CA:** signs the new identities.",{"_3602":2184,"_30987":2159,"_21467":57420,"_5":14750,"_28174":57366,"_3058":57421},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3602":2185,"_30987":2159,"_21467":57423,"_5":14750,"_28174":57366,"_3058":57424},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3602":2186,"_30987":2159,"_21467":57426,"_5":14750,"_28174":57366,"_3058":57427},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3602":2187,"_30987":2159,"_21467":57429,"_5":14750,"_28174":57370,"_3058":57430},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3602":2188,"_30987":2159,"_21467":57432,"_5":14750,"_28174":57370,"_3058":57433},[],"that the current date is between `Not Before` and `Not After`;",{"_3602":2189,"_30987":2159,"_21467":57435,"_5":14750,"_28174":57370,"_3058":57436},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3602":2190,"_30987":2159,"_21467":57438,"_5":14750,"_28174":57370,"_3058":57439},[],"that names, SANs and subject match the expected identity;",{"_3602":2191,"_30987":2159,"_21467":57441,"_5":14750,"_28174":57370,"_3058":57442},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3602":2192,"_30987":2159,"_21467":57444,"_5":14750,"_28174":57370,"_3058":57445},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3602":2193,"_30987":2159,"_21467":57447,"_5":14750,"_28174":57370,"_3058":57448},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3602":2194,"_30987":2159,"_21467":57450,"_5":14750,"_28174":57374,"_3058":57451},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3602":2195,"_30987":2159,"_21467":57453,"_5":14750,"_28174":57378,"_3058":57454},[],"Keep the root out of daily operations, or with very restricted access.",{"_3602":2196,"_30987":2159,"_21467":57456,"_5":14750,"_28174":57378,"_3058":57457},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3602":2197,"_30987":2159,"_21467":57459,"_5":14750,"_28174":57378,"_3058":57460},[],"Assign explicit profiles to every use case.",{"_3602":2198,"_30987":2159,"_21467":57462,"_5":14750,"_28174":57378,"_3058":57463},[],"Distribute the new trust before starting a rotation.",{"_3602":2199,"_30987":2159,"_21467":57465,"_5":14750,"_28174":57378,"_3058":57466},[],"Keep enough overlap to renew a disconnected fleet.",{"_3602":2200,"_30987":2159,"_21467":57468,"_5":14750,"_28174":57378,"_3058":57469},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3602":2201,"_30987":2159,"_21467":57471,"_5":14750,"_28174":57378,"_3058":57472},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3602":2202,"_30987":2202,"_5":15110,"_3058":57474,"_31325":57475,"_21467":57476,"_28174":2202},"Revocation lists (CRL)",[50623,52135,56298,56946],[],{"_3602":2203,"_30987":2202,"_21467":57478,"_5":14750,"_28174":2202,"_3058":57479},[],"Generate and distribute signed lists to validate certificates offline.",{"_3602":2204,"_30987":2202,"_5":31322,"_21467":57481,"_28174":57482,"_3058":57483},[],"/docs/platform/pki/crl#crl-settings","CRL settings",{"_3602":2205,"_30987":2202,"_5":31322,"_21467":57485,"_28174":57486,"_3058":57487},[],"/docs/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3602":2206,"_30987":2202,"_5":31322,"_21467":57489,"_28174":57490,"_3058":57491},[],"/docs/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3602":2207,"_30987":2202,"_5":31322,"_21467":57493,"_28174":57494,"_3058":57495},[],"/docs/platform/pki/crl#crl-contents","CRL contents",{"_3602":2208,"_30987":2202,"_5":31322,"_21467":57497,"_28174":57498,"_3058":57499},[],"/docs/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3602":2209,"_30987":2202,"_5":31322,"_21467":57501,"_28174":57502,"_3058":57503},[],"/docs/platform/pki/crl#crl-settings-api","CRL settings API",{"_3602":2210,"_30987":2202,"_5":31322,"_21467":57505,"_28174":57506,"_3058":57507},[],"/docs/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3602":2211,"_30987":2202,"_5":31322,"_21467":57509,"_28174":57510,"_3058":57511},[],"/docs/platform/pki/crl#references","References",{"_3602":2212,"_30987":2202,"_21467":57513,"_5":14750,"_28174":2202,"_3058":57514},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3602":2213,"_30987":2202,"_21467":57516,"_5":14750,"_28174":57482,"_3058":57517},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3602":2214,"_30987":2202,"_21467":57519,"_5":14750,"_28174":57482,"_3058":57520},[],"Field",{"_3602":2215,"_30987":2202,"_21467":57522,"_5":14750,"_28174":57482,"_3058":51013},[],{"_3602":2216,"_30987":2202,"_21467":57524,"_5":14750,"_28174":57482,"_3058":52255},[],{"_3602":2217,"_30987":2202,"_21467":57526,"_5":14750,"_28174":57482,"_3058":57527},[],"ID of the CA the settings belong to.",{"_3602":2218,"_30987":2202,"_21467":57529,"_5":14750,"_28174":57482,"_3058":57530},[],"`status`",{"_3602":2219,"_30987":2202,"_21467":57532,"_5":14750,"_28174":57482,"_3058":57533},[],"Lifecycle of the settings. `ACTIVE` ones generate CRLs. `FINAL` ones belong to a CA revoked permanently or expired: the first publishes one final CRL, valid until the CA's current certificate expires, and the second is turned `FINAL` without one. `ARCHIVED` ones belong to a deleted CA: their last CRL is still served, but never regenerated.",{"_3602":2220,"_30987":2202,"_21467":57535,"_5":14750,"_28174":57482,"_3058":57536},[],"`legacy_ski`",{"_3602":2221,"_30987":2202,"_21467":57538,"_5":14750,"_28174":57482,"_3058":57539},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3602":2222,"_30987":2202,"_21467":57541,"_5":14750,"_28174":57482,"_3058":57542},[],"`latest_crl`",{"_3602":2223,"_30987":2202,"_21467":57544,"_5":14750,"_28174":57482,"_3058":57545},[],"Version, validity start and end of the last published list. Read-only.",{"_3602":2224,"_30987":2202,"_21467":57547,"_5":14750,"_28174":57482,"_3058":57548},[],"`crl_options` field",{"_3602":2225,"_30987":2202,"_21467":57550,"_5":14750,"_28174":57482,"_3058":51013},[],{"_3602":2226,"_30987":2202,"_21467":57552,"_5":14750,"_28174":57482,"_3058":57553},[],"Initial value",{"_3602":2227,"_30987":2202,"_21467":57555,"_5":14750,"_28174":57482,"_3058":57556},[],"`validity`",{"_3602":2228,"_30987":2202,"_21467":57558,"_5":14750,"_28174":57482,"_3058":57559},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3602":2229,"_30987":2202,"_21467":57561,"_5":14750,"_28174":57482,"_3058":57562},[],"7 days.",{"_3602":2230,"_30987":2202,"_21467":57564,"_5":14750,"_28174":57482,"_3058":57565},[],"`refresh_interval`",{"_3602":2231,"_30987":2202,"_21467":57567,"_5":14750,"_28174":57482,"_3058":57568},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3602":2232,"_30987":2202,"_21467":57570,"_5":14750,"_28174":57482,"_3058":57571},[],"6 days and 23 hours.",{"_3602":2233,"_30987":2202,"_21467":57573,"_5":14750,"_28174":57482,"_3058":57574},[],"`regenerate_on_revoke`",{"_3602":2234,"_30987":2202,"_21467":57576,"_5":14750,"_28174":57482,"_3058":57577},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3602":2235,"_30987":2202,"_21467":57579,"_5":14750,"_28174":57482,"_3058":57580},[],"`true`.",{"_3602":2236,"_30987":2202,"_21467":57582,"_5":14750,"_28174":57482,"_3058":57583},[],"`signer_serial_number`",{"_3602":2237,"_30987":2202,"_21467":57585,"_5":14750,"_28174":57482,"_3058":57586},[],"Serial number of the existing certificate that signs the CRL.",{"_3602":2238,"_30987":2202,"_21467":57588,"_5":14750,"_28174":57482,"_3058":57589},[],"Serial number of the CA’s current certificate.",{"_3602":2239,"_30987":2202,"_21467":57591,"_5":14750,"_28174":57482,"_3058":57592},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3602":2240,"_30987":2202,"_21467":57594,"_5":14750,"_28174":57482,"_3058":57595},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3602":2241,"_30987":2202,"_21467":57597,"_5":14750,"_28174":57482,"_3058":57598},[],"The CRL lifecycle decisions — when publication stops and when the final CRL expires — use only the CA's current certificate. If a reissued certificate expires earlier than an older certificate that is still valid, CRL publication can stop, or the final CRL can expire, while the older certificate is still valid. This is an accepted limitation of the current behavior.",{"_3602":2242,"_30987":2202,"_21467":57600,"_5":14750,"_28174":57482,"_3058":57601},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3602":2243,"_30987":2202,"_21467":57603,"_5":14750,"_28174":57482,"_3058":57604},[],"Deleting a CA keeps its CRL settings; they remain until you delete the archived ones through the API or from the console's Verification Authorities page (see CRL settings API). What happens to them depends on how the CA ended:",{"_3602":2244,"_30987":2202,"_21467":57606,"_5":14750,"_28174":57482,"_3058":57607},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated, any `PUT` returns 409, and there is no API way back to `ACTIVE`.",{"_3602":2245,"_30987":2202,"_21467":57609,"_5":14750,"_28174":57482,"_3058":57610},[],"Revoking a CA permanently or letting it expire finalizes its settings: their `status` becomes `FINAL`, any `PUT` returns 409, and no new CRL is generated. A permanently revoked CA publishes one final CRL, valid until the CA's current certificate expires; an expired CA gets none. Deleting the CA afterwards archives its settings, which then behave like the archived ones of the migration.",{"_3602":2246,"_30987":2202,"_21467":57612,"_5":14750,"_28174":57482,"_3058":57613},[],"The settings can no longer be edited while their `status` is not `ACTIVE`. Adjust validity and signer before revoking or deleting a CA.",{"_3602":2247,"_30987":2202,"_21467":57615,"_5":14750,"_28174":57482,"_3058":57616},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3602":2248,"_30987":2202,"_21467":57618,"_5":14750,"_28174":57482,"_3058":57619},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3602":2249,"_30987":2202,"_21467":57621,"_5":14750,"_28174":57482,"_3058":57622},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3602":2250,"_30987":2202,"_21467":57624,"_5":14750,"_28174":57486,"_3058":57625},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3602":2251,"_30987":2202,"_21467":57627,"_5":14750,"_28174":57486,"_3058":57628},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3602":2252,"_30987":2202,"_21467":57630,"_5":14750,"_28174":57486,"_3058":57631},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3602":2253,"_30987":2202,"_21467":57633,"_5":14750,"_28174":57486,"_3058":57634},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3602":2254,"_30987":2202,"_21467":57636,"_5":14750,"_28174":57490,"_3058":57637},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3602":2255,"_30987":2202,"_21467":57639,"_5":14750,"_28174":57490,"_3058":57640},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3602":2256,"_30987":2202,"_21467":57642,"_5":14750,"_28174":57490,"_3058":57643},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3602":2257,"_30987":2202,"_21467":57645,"_5":14750,"_28174":57490,"_3058":57646},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3602":2258,"_30987":2202,"_21467":57648,"_5":14750,"_28174":57490,"_3058":57649},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3602":2259,"_30987":2202,"_21467":57651,"_5":14750,"_28174":57490,"_3058":57652},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3602":2260,"_30987":2202,"_21467":57654,"_5":14750,"_28174":57490,"_3058":57655},[],"Settings whose `status` is not `ACTIVE` — `FINAL` or `ARCHIVED` — are skipped: nothing regenerates their CRL.",{"_3602":2261,"_30987":2202,"_21467":57657,"_5":14750,"_28174":57490,"_3058":57658},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3602":2262,"_30987":2202,"_21467":57660,"_5":14750,"_28174":57490,"_3058":57661},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3602":2263,"_30987":2202,"_21467":57663,"_5":14750,"_28174":57494,"_3058":57664},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3602":2264,"_30987":2202,"_21467":57666,"_5":14750,"_28174":57494,"_3058":57667},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3602":2265,"_30987":2202,"_21467":57669,"_5":14750,"_28174":57498,"_3058":57670},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3602":2266,"_30987":2202,"_21467":57672,"_5":14750,"_28174":57498,"_3058":57673},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3602":2267,"_30987":2202,"_21467":57675,"_5":14750,"_28174":57498,"_3058":57676},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3602":2268,"_30987":2202,"_21467":57678,"_5":14750,"_28174":57498,"_3058":57679},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3602":2269,"_30987":2202,"_21467":57681,"_5":14750,"_28174":57498,"_3058":57682},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3602":2270,"_30987":2202,"_21467":57684,"_5":14750,"_28174":57502,"_3058":57685},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3602":2271,"_30987":2202,"_21467":57687,"_5":14750,"_28174":57502,"_3058":54063},[],{"_3602":2272,"_30987":2202,"_21467":57689,"_5":14750,"_28174":57502,"_3058":57690},[],"Relative path",{"_3602":2273,"_30987":2202,"_21467":57692,"_5":14750,"_28174":57502,"_3058":54060},[],{"_3602":2274,"_30987":2202,"_21467":57694,"_5":14750,"_28174":57502,"_3058":57695},[],"`GET`",{"_3602":2275,"_30987":2202,"_21467":57697,"_5":14750,"_28174":57502,"_3058":57698},[],"`/v1/crl-settings`",{"_3602":2276,"_30987":2202,"_21467":57700,"_5":14750,"_28174":57502,"_3058":57701},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3602":2277,"_30987":2202,"_21467":57703,"_5":14750,"_28174":57502,"_3058":57695},[],{"_3602":2278,"_30987":2202,"_21467":57705,"_5":14750,"_28174":57502,"_3058":57706},[],"`/v1/crl-settings/{ca-id}`",{"_3602":2279,"_30987":2202,"_21467":57708,"_5":14750,"_28174":57502,"_3058":57709},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3602":2280,"_30987":2202,"_21467":57711,"_5":14750,"_28174":57502,"_3058":57712},[],"`PUT`",{"_3602":2281,"_30987":2202,"_21467":57714,"_5":14750,"_28174":57502,"_3058":57706},[],{"_3602":2282,"_30987":2202,"_21467":57716,"_5":14750,"_28174":57502,"_3058":57717},[],"Replace the CRL configuration of a CA.",{"_3602":2283,"_30987":2202,"_21467":57719,"_5":14750,"_28174":57502,"_3058":57720},[],"`DELETE`",{"_3602":2284,"_30987":2202,"_21467":57722,"_5":14750,"_28174":57502,"_3058":57706},[],{"_3602":2285,"_30987":2202,"_21467":57724,"_5":14750,"_28174":57502,"_3058":57725},[],"Remove the archived CRL settings of a CA.",{"_3602":2286,"_30987":2202,"_21467":57727,"_5":14750,"_28174":57502,"_3058":57728},[],"You need authentication and CRL settings read, update or delete permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL.",{"_3602":2287,"_30987":2202,"_21467":57730,"_5":14750,"_28174":57502,"_3058":57731},[],"Archived settings, whose CA no longer exists, can be removed with `DELETE`: the call returns 204 on success, 404 when the CA has no settings and 409 while the settings are not yet archived. After the deletion, the public `/crl/{id}` endpoint and any legacy `/crl/<ski>` endpoint stop serving the CA’s list, although the published CRL files remain in the bucket. Keep the archived settings while any certificate issued by the CA may still need revocation evidence: `DELETE` stops serving the list immediately, regardless of `latest_crl` validity. The action cannot be undone.",{"_3602":2288,"_30987":2202,"_21467":57733,"_5":14750,"_28174":57502,"_3058":57734},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3602":2289,"_30987":2202,"_21467":57736,"_5":14750,"_28174":57506,"_3058":57737},[],"Symptom",{"_3602":2290,"_30987":2202,"_21467":57739,"_5":14750,"_28174":57506,"_3058":57740},[],"Cause",{"_3602":2291,"_30987":2202,"_21467":57742,"_5":14750,"_28174":57506,"_3058":57743},[],"Action",{"_3602":2292,"_30987":2202,"_21467":57745,"_5":14750,"_28174":57506,"_3058":57746},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3602":2293,"_30987":2202,"_21467":57748,"_5":14750,"_28174":57506,"_3058":57749},[],"The settings are not `ACTIVE`: revoking the CA permanently or letting it expire finalized them, or the migration archived them because their CA was deleted before the upgrade.",{"_3602":2294,"_30987":2202,"_21467":57751,"_5":14750,"_28174":57506,"_3058":57752},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3602":2295,"_30987":2202,"_21467":57754,"_5":14750,"_28174":57506,"_3058":57755},[],"`DELETE /v1/crl-settings/{ca-id}` returns 409.",{"_3602":2296,"_30987":2202,"_21467":57757,"_5":14750,"_28174":57506,"_3058":57758},[],"The settings are not yet `ARCHIVED`: the CA has not been deleted.",{"_3602":2297,"_30987":2202,"_21467":57760,"_5":14750,"_28174":57506,"_3058":57761},[],"Delete the CA first; deleting it archives its settings.",{"_3602":2298,"_30987":2202,"_21467":57763,"_5":14750,"_28174":57506,"_3058":57764},[],"`PUT` returns 400.",{"_3602":2299,"_30987":2202,"_21467":57766,"_5":14750,"_28174":57506,"_3058":57767},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3602":2300,"_30987":2202,"_21467":57769,"_5":14750,"_28174":57506,"_3058":57770},[],"Set the serial number of a valid certificate of that CA.",{"_3602":2301,"_30987":2202,"_21467":57772,"_5":14750,"_28174":57506,"_3058":57773},[],"`PUT` returns 404.",{"_3602":2302,"_30987":2202,"_21467":57775,"_5":14750,"_28174":57506,"_3058":57776},[],"The CA or the new signer certificate does not exist, or the CA has no CRL settings (for example, an imported CA).",{"_3602":2303,"_30987":2202,"_21467":57778,"_5":14750,"_28174":57506,"_3058":57779},[],"Check the CA ID and the signer serial number.",{"_3602":2304,"_30987":2202,"_21467":57781,"_5":14750,"_28174":57506,"_3058":57782},[],"`PUT` returns 400 from a 3.x client.",{"_3602":2305,"_30987":2202,"_21467":57784,"_5":14750,"_28174":57506,"_3058":57785},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3602":2306,"_30987":2202,"_21467":57787,"_5":14750,"_28174":57506,"_3058":57788},[],"Update the client to send the new field.",{"_3602":2307,"_30987":2202,"_21467":57790,"_5":14750,"_28174":57506,"_3058":57791},[],"The CRL does not change after revoking a certificate.",{"_3602":2308,"_30987":2202,"_21467":57793,"_5":14750,"_28174":57506,"_3058":57794},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3602":2309,"_30987":2202,"_21467":57796,"_5":14750,"_28174":57506,"_3058":57797},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3602":2310,"_30987":2202,"_21467":57799,"_5":14750,"_28174":57506,"_3058":57800},[],"A verifier rejects the CRL because of the issuer.",{"_3602":2311,"_30987":2202,"_21467":57802,"_5":14750,"_28174":57506,"_3058":57803},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3602":2312,"_30987":2202,"_21467":57805,"_5":14750,"_28174":57506,"_3058":57806},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3602":2313,"_30987":2202,"_21467":57808,"_5":14750,"_28174":57510,"_3058":57809},[],"RFC 5280: X.509 and CRL profile.",{"_3602":2314,"_30987":2202,"_21467":57811,"_5":14750,"_28174":57510,"_3058":57812},[],"OpenSSL: openssl-crl.",{"_3602":2315,"_30987":2202,"_21467":57814,"_5":14750,"_28174":57510,"_3058":57815},[],"OpenSSL: openssl-verify.",{"_3602":2316,"_30987":2202,"_21467":57817,"_5":14750,"_28174":57510,"_3058":57818},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3602":2317,"_30987":2202,"_21467":57820,"_5":14750,"_28174":57510,"_3058":57821},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3602":2318,"_30987":2318,"_5":15110,"_3058":57823,"_31325":57824,"_21467":57825,"_28174":2318},"Keys and cryptographic engines",[50623,52135,56298,56299],[],{"_3602":2319,"_30987":2318,"_21467":57827,"_5":14750,"_28174":2318,"_3058":57828},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3602":2320,"_30987":2318,"_5":31322,"_21467":57830,"_28174":57831,"_3058":57832},[],"/docs/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3602":2321,"_30987":2318,"_5":31322,"_21467":57834,"_28174":57835,"_3058":57836},[],"/docs/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3602":2322,"_30987":2318,"_5":31322,"_21467":57838,"_28174":57839,"_3058":57840},[],"/docs/platform/pki/key-management#file-system","File System",{"_3602":2323,"_30987":2318,"_5":31322,"_21467":57842,"_28174":57843,"_3058":57844},[],"/docs/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3602":2324,"_30987":2318,"_5":31322,"_21467":57846,"_28174":57847,"_3058":57848},[],"/docs/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3602":2325,"_30987":2318,"_5":31322,"_21467":57850,"_28174":57851,"_3058":57852},[],"/docs/platform/pki/key-management#aws-kms","AWS KMS",{"_3602":2326,"_30987":2318,"_5":31322,"_21467":57854,"_28174":57855,"_3058":57856},[],"/docs/platform/pki/key-management#pkcs11","PKCS#11",{"_3602":2327,"_30987":2318,"_5":31322,"_21467":57858,"_28174":57859,"_3058":57860},[],"/docs/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3602":2328,"_30987":2318,"_5":31322,"_21467":57862,"_28174":57863,"_3058":57864},[],"/docs/platform/pki/key-management#key-inventory","Key inventory",{"_3602":2329,"_30987":2318,"_5":31322,"_21467":57866,"_28174":57867,"_3058":57868},[],"/docs/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3602":2330,"_30987":2318,"_5":31322,"_21467":57870,"_28174":57871,"_3058":57872},[],"/docs/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3602":2331,"_30987":2318,"_5":31322,"_21467":57874,"_28174":57875,"_3058":57876},[],"/docs/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3602":2332,"_30987":2318,"_5":31322,"_21467":57878,"_28174":57879,"_3058":57880},[],"/docs/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3602":2333,"_30987":2318,"_5":31322,"_21467":57882,"_28174":57883,"_3058":57884},[],"/docs/platform/pki/key-management#view-details","View details",{"_3602":2334,"_30987":2318,"_5":31322,"_21467":57886,"_28174":57887,"_3058":57888},[],"/docs/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3602":2335,"_30987":2318,"_5":31322,"_21467":57890,"_28174":57891,"_3058":57892},[],"/docs/platform/pki/key-management#sign","Sign",{"_3602":2336,"_30987":2318,"_5":31322,"_21467":57894,"_28174":57895,"_3058":57896},[],"/docs/platform/pki/key-management#verify","Verify",{"_3602":2337,"_30987":2318,"_5":31322,"_21467":57898,"_28174":57899,"_3058":57900},[],"/docs/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3602":2338,"_30987":2318,"_5":31322,"_21467":57902,"_28174":57903,"_3058":57904},[],"/docs/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3602":2339,"_30987":2318,"_5":31322,"_21467":57906,"_28174":57907,"_3058":57908},[],"/docs/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3602":2340,"_30987":2318,"_21467":57910,"_5":14750,"_28174":2318,"_3058":57911},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3602":2341,"_30987":2318,"_21467":57913,"_5":14750,"_28174":2318,"_3058":57914},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3602":2342,"_30987":2318,"_21467":57916,"_5":14750,"_28174":57831,"_3058":57917},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3602":2343,"_30987":2318,"_21467":57919,"_5":14750,"_28174":57831,"_3058":57920},[],"In practice, it lets you:",{"_3602":2344,"_30987":2318,"_21467":57922,"_5":14750,"_28174":57831,"_3058":57923},[],"Generate new key pairs from Lamassu IoT.",{"_3602":2345,"_30987":2318,"_21467":57925,"_5":14750,"_28174":57831,"_3058":57926},[],"Import keys created externally.",{"_3602":2346,"_30987":2318,"_21467":57928,"_5":14750,"_28174":57831,"_3058":57929},[],"Delegate custody and cryptographic operations to external engines.",{"_3602":2347,"_30987":2318,"_21467":57931,"_5":14750,"_28174":57831,"_3058":57932},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3602":2348,"_30987":2318,"_21467":57934,"_5":14750,"_28174":57835,"_3058":57935},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3602":2349,"_30987":2318,"_21467":57937,"_5":14750,"_28174":57835,"_3058":57938},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3602":2350,"_30987":2318,"_21467":57940,"_5":14750,"_28174":57835,"_3058":57941},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3602":2351,"_30987":2318,"_21467":57943,"_5":14750,"_28174":57839,"_3058":57944},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3602":2352,"_30987":2318,"_21467":57946,"_5":14750,"_28174":57843,"_3058":57947},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3602":2353,"_30987":2318,"_21467":57949,"_5":14750,"_28174":57843,"_3058":57950},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3602":2354,"_30987":2318,"_21467":57952,"_5":14750,"_28174":57847,"_3058":57953},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3602":2355,"_30987":2318,"_21467":57955,"_5":14750,"_28174":57851,"_3058":57956},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3602":2356,"_30987":2318,"_21467":57958,"_5":14750,"_28174":57855,"_3058":57959},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3602":2357,"_30987":2318,"_21467":57961,"_5":14750,"_28174":57859,"_3058":57962},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3602":2358,"_30987":2318,"_21467":57964,"_5":14750,"_28174":57859,"_3058":57965},[],"Lamassu shows the enabled engines in the console.",{"_3602":2359,"_30987":2318,"_21467":57967,"_5":14750,"_28174":57859,"_3058":57968},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3602":2360,"_30987":2318,"_21467":57970,"_5":14750,"_28174":57859,"_3058":57971},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3602":2361,"_30987":2318,"_21467":57973,"_5":14750,"_28174":57863,"_3058":57974},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3602":2362,"_30987":2318,"_21467":57976,"_5":14750,"_28174":57863,"_3058":57977},[],"The table includes the following fields:",{"_3602":2363,"_30987":2318,"_21467":57979,"_5":14750,"_28174":57863,"_3058":57980},[],"**Name**: descriptive name of the key.",{"_3602":2364,"_30987":2318,"_21467":57982,"_5":14750,"_28174":57863,"_3058":57983},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3602":2365,"_30987":2318,"_21467":57985,"_5":14750,"_28174":57863,"_3058":57986},[],"**Strength**: visual indicator of cryptographic strength.",{"_3602":2366,"_30987":2318,"_21467":57988,"_5":14750,"_28174":57863,"_3058":57989},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3602":2367,"_30987":2318,"_21467":57991,"_5":14750,"_28174":57863,"_3058":57992},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3602":2368,"_30987":2318,"_21467":57994,"_5":14750,"_28174":57863,"_3058":57995},[],"**Aliases**: alternative names associated with the key.",{"_3602":2369,"_30987":2318,"_21467":57997,"_5":14750,"_28174":57863,"_3058":57998},[],"**Tags**: labels for classification and search.",{"_3602":2370,"_30987":2318,"_21467":58000,"_5":14750,"_28174":57863,"_3058":58001},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3602":2371,"_30987":2318,"_21467":58003,"_5":14750,"_28174":57863,"_3058":58004},[],"From this view you also reach the most common actions:",{"_3602":2372,"_30987":2318,"_21467":58006,"_5":14750,"_28174":57863,"_3058":58007},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3602":2373,"_30987":2318,"_21467":58009,"_5":14750,"_28174":57863,"_3058":58010},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3602":2374,"_30987":2318,"_21467":58012,"_5":14750,"_28174":57863,"_3058":58013},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3602":2375,"_30987":2318,"_21467":58015,"_5":14750,"_28174":57863,"_3058":58016},[],"**Delete Key** to remove the key from the system.",{"_3602":2376,"_30987":2318,"_21467":58018,"_5":14750,"_28174":57867,"_3058":58019},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3602":2377,"_30987":2318,"_21467":58021,"_5":14750,"_28174":57871,"_3058":58022},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3602":2378,"_30987":2318,"_21467":58024,"_5":14750,"_28174":57871,"_3058":58025},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3602":2379,"_30987":2318,"_21467":58027,"_5":14750,"_28174":57871,"_3058":58028},[],"**Key Name**: unique and descriptive name.",{"_3602":2380,"_30987":2318,"_21467":58030,"_5":14750,"_28174":57871,"_3058":58031},[],"**Crypto Engine**: engine that will keep the key.",{"_3602":2381,"_30987":2318,"_21467":58033,"_5":14750,"_28174":57871,"_3058":58034},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3602":2382,"_30987":2318,"_21467":58036,"_5":14750,"_28174":57871,"_3058":58037},[],"**Tags**: metadata to classify the key.",{"_3602":2383,"_30987":2318,"_21467":58039,"_5":14750,"_28174":57871,"_3058":58040},[],"**Metadata**: additional information for advanced uses.",{"_3602":2384,"_30987":2318,"_21467":58042,"_5":14750,"_28174":57875,"_3058":58043},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3602":2385,"_30987":2318,"_21467":58045,"_5":14750,"_28174":57875,"_3058":58046},[],"When you have an exportable private key and the destination engine supports import.",{"_3602":2386,"_30987":2318,"_21467":58048,"_5":14750,"_28174":57875,"_3058":58049},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3602":2387,"_30987":2318,"_21467":58051,"_5":14750,"_28174":57875,"_3058":58052},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3602":2388,"_30987":2318,"_21467":58054,"_5":14750,"_28174":57875,"_3058":58055},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3602":2389,"_30987":2318,"_21467":58057,"_5":14750,"_28174":57875,"_3058":58058},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3602":2390,"_30987":2318,"_21467":58060,"_5":14750,"_28174":57875,"_3058":58061},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3602":2391,"_30987":2318,"_21467":58063,"_5":14750,"_28174":57875,"_3058":58064},[],"**Tags**: labels for organization and search.",{"_3602":2392,"_30987":2318,"_21467":58066,"_5":14750,"_28174":57875,"_3058":58067},[],"**Metadata**: additional optional information.",{"_3602":2393,"_30987":2318,"_21467":58069,"_5":14750,"_28174":57875,"_3058":58070},[],"**Private Key (PEM)**: private key in PEM format.",{"_3602":2394,"_30987":2318,"_21467":58072,"_5":14750,"_28174":57875,"_3058":58073},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3602":2395,"_30987":2318,"_21467":58075,"_5":14750,"_28174":57879,"_3058":58076},[],"Each registered key has a detail view and several operational actions.",{"_3602":2396,"_30987":2318,"_21467":58078,"_5":14750,"_28174":57883,"_3058":58079},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3602":2397,"_30987":2318,"_21467":58081,"_5":14750,"_28174":57883,"_3058":58082},[],"The **Overview** tab shows, among others, these fields:",{"_3602":2398,"_30987":2318,"_21467":58084,"_5":14750,"_28174":57883,"_3058":58085},[],"**Key Name**: descriptive name.",{"_3602":2399,"_30987":2318,"_21467":58087,"_5":14750,"_28174":57883,"_3058":58088},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3602":2400,"_30987":2318,"_21467":58090,"_5":14750,"_28174":57883,"_3058":58091},[],"**Tags**: associated labels.",{"_3602":2401,"_30987":2318,"_21467":58093,"_5":14750,"_28174":57883,"_3058":58094},[],"**Aliases**: alternative names.",{"_3602":2402,"_30987":2318,"_21467":58096,"_5":14750,"_28174":57883,"_3058":58097},[],"**Crypto Engine**: engine where the key resides.",{"_3602":2403,"_30987":2318,"_21467":58099,"_5":14750,"_28174":57883,"_3058":58100},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3602":2404,"_30987":2318,"_21467":58102,"_5":14750,"_28174":57883,"_3058":58103},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3602":2405,"_30987":2318,"_21467":58105,"_5":14750,"_28174":57883,"_3058":58106},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3602":2406,"_30987":2318,"_21467":58108,"_5":14750,"_28174":57887,"_3058":58109},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3602":2407,"_30987":2318,"_21467":58111,"_5":14750,"_28174":57887,"_3058":58112},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3602":2408,"_30987":2318,"_21467":58114,"_5":14750,"_28174":57887,"_3058":58115},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3602":2409,"_30987":2318,"_21467":58117,"_5":14750,"_28174":57891,"_3058":58118},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3602":2410,"_30987":2318,"_21467":58120,"_5":14750,"_28174":57891,"_3058":58121},[],"Main fields:",{"_3602":2411,"_30987":2318,"_21467":58123,"_5":14750,"_28174":57891,"_3058":58124},[],"**Algorithm**: signing algorithm available for the key type.",{"_3602":2412,"_30987":2318,"_21467":58126,"_5":14750,"_28174":57891,"_3058":58127},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3602":2413,"_30987":2318,"_21467":58129,"_5":14750,"_28174":57891,"_3058":58130},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3602":2414,"_30987":2318,"_21467":58132,"_5":14750,"_28174":57891,"_3058":58133},[],"**Message**: content to sign.",{"_3602":2415,"_30987":2318,"_21467":58135,"_5":14750,"_28174":57891,"_3058":58136},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3602":2416,"_30987":2318,"_21467":58138,"_5":14750,"_28174":57895,"_3058":58139},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3602":2417,"_30987":2318,"_21467":58141,"_5":14750,"_28174":57895,"_3058":58121},[],{"_3602":2418,"_30987":2318,"_21467":58143,"_5":14750,"_28174":57895,"_3058":58144},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3602":2419,"_30987":2318,"_21467":58146,"_5":14750,"_28174":57895,"_3058":58147},[],"**Message Type**: `Raw` or `Digest`.",{"_3602":2420,"_30987":2318,"_21467":58149,"_5":14750,"_28174":57895,"_3058":58150},[],"**Payload Encoding**: encoding of the message.",{"_3602":2421,"_30987":2318,"_21467":58152,"_5":14750,"_28174":57895,"_3058":58153},[],"**Message**: original message or hash.",{"_3602":2422,"_30987":2318,"_21467":58155,"_5":14750,"_28174":57895,"_3058":58156},[],"**Signature**: signature to check.",{"_3602":2423,"_30987":2318,"_21467":58158,"_5":14750,"_28174":57895,"_3058":58159},[],"**Result**: indicator of the validation result.",{"_3602":2424,"_30987":2318,"_21467":58161,"_5":14750,"_28174":57899,"_3058":58162},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3602":2425,"_30987":2318,"_21467":58164,"_5":14750,"_28174":57899,"_3058":58165},[],"This flow is useful for:",{"_3602":2426,"_30987":2318,"_21467":58167,"_5":14750,"_28174":57899,"_3058":58168},[],"Requesting certificates from an external CA.",{"_3602":2427,"_30987":2318,"_21467":58170,"_5":14750,"_28174":57899,"_3058":58171},[],"Renewing an identity while keeping the same key.",{"_3602":2428,"_30987":2318,"_21467":58173,"_5":14750,"_28174":57899,"_3058":58174},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3602":2429,"_30987":2318,"_21467":58176,"_5":14750,"_28174":57899,"_3058":58177},[],"**Common Name (CN)**: main name of the identity.",{"_3602":2430,"_30987":2318,"_21467":58179,"_5":14750,"_28174":57899,"_3058":58180},[],"**Organization (O)**: organization or company.",{"_3602":2431,"_30987":2318,"_21467":58182,"_5":14750,"_28174":57899,"_3058":58183},[],"**Organizational Unit (OU)**: department or unit.",{"_3602":2432,"_30987":2318,"_21467":58185,"_5":14750,"_28174":57899,"_3058":58186},[],"**Country (C)**: two-letter country code.",{"_3602":2433,"_30987":2318,"_21467":58188,"_5":14750,"_28174":57899,"_3058":58189},[],"**State / Province (ST)**: state or province.",{"_3602":2434,"_30987":2318,"_21467":58191,"_5":14750,"_28174":57899,"_3058":58192},[],"**Locality (L)**: city or locality.",{"_3602":2435,"_30987":2318,"_21467":58194,"_5":14750,"_28174":57899,"_3058":58195},[],"**Email Address**: contact email.",{"_3602":2436,"_30987":2318,"_21467":58197,"_5":14750,"_28174":57899,"_3058":58198},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3602":2437,"_30987":2318,"_21467":58200,"_5":14750,"_28174":57899,"_3058":58201},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3602":2438,"_30987":2318,"_21467":58203,"_5":14750,"_28174":57903,"_3058":58204},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3602":2439,"_30987":2318,"_21467":58206,"_5":14750,"_28174":57903,"_3058":58207},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3602":2440,"_30987":2318,"_21467":58209,"_5":14750,"_28174":57907,"_3058":58210},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3602":2441,"_30987":2318,"_21467":58212,"_5":14750,"_28174":57907,"_3058":58213},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. The KMS also refuses to delete a key that signs the CRL of a CA whose CRL settings are still `ACTIVE`, with the same `409` `key is in use`; that reference is released when the settings are finalized, after the CA is revoked permanently or expires (see CRL). Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3602":2442,"_30987":2442,"_5":15110,"_3058":58215,"_31325":58216,"_21467":58217,"_28174":2442},"Online validation with OCSP",[50623,52135,56298,56946],[],{"_3602":2443,"_30987":2442,"_21467":58219,"_5":14750,"_28174":2442,"_3058":58220},[],"Query signed status and verify the responder’s response.",{"_3602":2444,"_30987":2442,"_5":31322,"_21467":58222,"_28174":58223,"_3058":58224},[],"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3602":2445,"_30987":2442,"_5":31322,"_21467":58226,"_28174":58227,"_3058":58228},[],"/docs/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3602":2446,"_30987":2442,"_5":31322,"_21467":58230,"_28174":58231,"_3058":58232},[],"/docs/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3602":2447,"_30987":2442,"_5":31322,"_21467":58234,"_28174":58235,"_3058":58236},[],"/docs/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3602":2448,"_30987":2442,"_5":31322,"_21467":58238,"_28174":58239,"_3058":58240},[],"/docs/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3602":2449,"_30987":2442,"_5":31322,"_21467":58242,"_28174":58243,"_3058":57511},[],"/docs/platform/pki/ocsp#references",{"_3602":2450,"_30987":2442,"_21467":58245,"_5":14750,"_28174":2442,"_3058":58246},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3602":2451,"_30987":2442,"_21467":58248,"_5":14750,"_28174":58223,"_3058":58249},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3602":2452,"_30987":2442,"_21467":58251,"_5":14750,"_28174":58223,"_3058":58252},[],"Record status",{"_3602":2453,"_30987":2442,"_21467":58254,"_5":14750,"_28174":58223,"_3058":58255},[],"Signed response",{"_3602":2454,"_30987":2442,"_21467":58257,"_5":14750,"_28174":58223,"_3058":55435},[],{"_3602":2455,"_30987":2442,"_21467":58259,"_5":14750,"_28174":58223,"_3058":58260},[],"`Good`.",{"_3602":2456,"_30987":2442,"_21467":58262,"_5":14750,"_28174":58223,"_3058":55452},[],{"_3602":2457,"_30987":2442,"_21467":58264,"_5":14750,"_28174":58223,"_3058":58265},[],"`Revoked`, with revocation reason and timestamp.",{"_3602":2458,"_30987":2442,"_21467":58267,"_5":14750,"_28174":58223,"_3058":58268},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3602":2459,"_30987":2442,"_21467":58270,"_5":14750,"_28174":58223,"_3058":58271},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3602":2460,"_30987":2442,"_21467":58273,"_5":14750,"_28174":58223,"_3058":58274},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3602":2461,"_30987":2442,"_21467":58276,"_5":14750,"_28174":58223,"_3058":58277},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3602":2462,"_30987":2442,"_21467":58279,"_5":14750,"_28174":58223,"_3058":58280},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3602":2463,"_30987":2442,"_21467":58282,"_5":14750,"_28174":58227,"_3058":58283},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3602":2464,"_30987":2442,"_21467":58285,"_5":14750,"_28174":58227,"_3058":58286},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3602":2465,"_30987":2442,"_21467":58288,"_5":14750,"_28174":58231,"_3058":58289},[],"The service accepts:",{"_3602":2466,"_30987":2442,"_21467":58291,"_5":14750,"_28174":58231,"_3058":54063},[],{"_3602":2467,"_30987":2442,"_21467":58293,"_5":14750,"_28174":58231,"_3058":58294},[],"VA service path",{"_3602":2468,"_30987":2442,"_21467":58296,"_5":14750,"_28174":58231,"_3058":58297},[],"Format",{"_3602":2469,"_30987":2442,"_21467":58299,"_5":14750,"_28174":58231,"_3058":58300},[],"`POST`",{"_3602":2470,"_30987":2442,"_21467":58302,"_5":14750,"_28174":58231,"_3058":58303},[],"`/ocsp`",{"_3602":2471,"_30987":2442,"_21467":58305,"_5":14750,"_28174":58231,"_3058":58306},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3602":2472,"_30987":2442,"_21467":58308,"_5":14750,"_28174":58231,"_3058":57695},[],{"_3602":2473,"_30987":2442,"_21467":58310,"_5":14750,"_28174":58231,"_3058":58311},[],"`/ocsp/{ocsp_request}`",{"_3602":2474,"_30987":2442,"_21467":58313,"_5":14750,"_28174":58231,"_3058":58314},[],"DER request encoded using padded URL Base64.",{"_3602":2475,"_30987":2442,"_21467":58316,"_5":14750,"_28174":58231,"_3058":58317},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3602":2476,"_30987":2442,"_21467":58319,"_5":14750,"_28174":58235,"_3058":58320},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3602":2477,"_30987":2442,"_21467":58322,"_5":14750,"_28174":58235,"_3058":58323},[],"Generate the request:",{"_3602":2478,"_30987":2442,"_21467":58325,"_5":14750,"_28174":58235,"_3058":58326},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3602":2479,"_30987":2442,"_21467":58328,"_5":14750,"_28174":58235,"_3058":58329},[],"Replace the example URL with the inspected endpoint:",{"_3602":2480,"_30987":2442,"_21467":58331,"_5":14750,"_28174":58235,"_3058":58332},[],"Verify the returned DER:",{"_3602":2481,"_30987":2442,"_21467":58334,"_5":14750,"_28174":58235,"_3058":58335},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3602":2482,"_30987":2442,"_21467":58337,"_5":14750,"_28174":58239,"_3058":58338},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3602":2483,"_30987":2442,"_21467":58340,"_5":14750,"_28174":58239,"_3058":58341},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3602":2484,"_30987":2442,"_21467":58343,"_5":14750,"_28174":58243,"_3058":58344},[],"RFC 6960: OCSP.",{"_3602":2485,"_30987":2442,"_21467":58346,"_5":14750,"_28174":58243,"_3058":58347},[],"OpenSSL: openssl-ocsp.",{"_3602":2486,"_30987":2442,"_21467":58349,"_5":14750,"_28174":58243,"_3058":58350},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3602":2487,"_30987":2442,"_21467":58352,"_5":14750,"_28174":58243,"_3058":57821},[],{"_3602":2488,"_30987":2488,"_5":15110,"_3058":56298,"_31325":58354,"_21467":58355,"_28174":2488},[50623,52135,56298],[],{"_3602":2489,"_30987":2488,"_21467":58357,"_5":14750,"_28174":2488,"_3058":58358},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3602":2490,"_30987":2488,"_5":31322,"_21467":58360,"_28174":58361,"_3058":55610},[],"/docs/platform/pki/overview#start-here",{"_3602":2491,"_30987":2488,"_5":31322,"_21467":58363,"_28174":58364,"_3058":58365},[],"/docs/platform/pki/overview#what-you-need","What you need",{"_3602":2492,"_30987":2488,"_5":31322,"_21467":58367,"_28174":58368,"_3058":56142},[],"/docs/platform/pki/overview#core-capabilities",{"_3602":2493,"_30987":2488,"_5":31322,"_21467":58370,"_28174":58371,"_3058":56146},[],"/docs/platform/pki/overview#build-your-trust-hierarchy",{"_3602":2494,"_30987":2488,"_5":31322,"_21467":58373,"_28174":58374,"_3058":56150},[],"/docs/platform/pki/overview#protect-cryptographic-keys",{"_3602":2495,"_30987":2488,"_5":31322,"_21467":58376,"_28174":58377,"_3058":56154},[],"/docs/platform/pki/overview#issue-and-control-certificates",{"_3602":2496,"_30987":2488,"_5":31322,"_21467":58379,"_28174":58380,"_3058":56162},[],"/docs/platform/pki/overview#publish-validation-status",{"_3602":2497,"_30987":2488,"_5":31322,"_21467":58382,"_28174":58383,"_3058":58384},[],"/docs/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3602":2498,"_30987":2488,"_5":31322,"_21467":58386,"_28174":58387,"_3058":57113},[],"/docs/platform/pki/overview#continue",{"_3602":2499,"_30987":2488,"_21467":58389,"_5":14750,"_28174":2488,"_3058":58390},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3602":2500,"_30987":2488,"_21467":58392,"_5":14750,"_28174":58361,"_3058":58393},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3602":2501,"_30987":2488,"_21467":58395,"_5":14750,"_28174":58361,"_3058":58396},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3602":2502,"_30987":2488,"_21467":58398,"_5":14750,"_28174":58364,"_3058":58399},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3602":2503,"_30987":2488,"_21467":58401,"_5":14750,"_28174":58364,"_3058":58402},[],"An available cryptographic engine to keep the authority's key.",{"_3602":2504,"_30987":2488,"_21467":58404,"_5":14750,"_28174":58364,"_3058":58405},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3602":2505,"_30987":2488,"_21467":58407,"_5":14750,"_28174":58364,"_3058":58408},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3602":2506,"_30987":2488,"_21467":58410,"_5":14750,"_28174":58364,"_3058":58411},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3602":2507,"_30987":2488,"_21467":58413,"_5":14750,"_28174":58371,"_3058":58414},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3602":2508,"_30987":2488,"_21467":58416,"_5":14750,"_28174":58374,"_3058":58417},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3602":2509,"_30987":2488,"_21467":58419,"_5":14750,"_28174":58377,"_3058":58420},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3602":2510,"_30987":2488,"_21467":58422,"_5":14750,"_28174":58380,"_3058":58423},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3602":2511,"_30987":2488,"_21467":58425,"_5":14750,"_28174":58383,"_3058":58426},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3602":2512,"_30987":2488,"_21467":58428,"_5":14750,"_28174":58383,"_3058":58429},[],"its subject and extensions identify the expected client;",{"_3602":2513,"_30987":2488,"_21467":58431,"_5":14750,"_28174":58383,"_3058":58432},[],"its public key matches the client's private key;",{"_3602":2514,"_30987":2488,"_21467":58434,"_5":14750,"_28174":58383,"_3058":58435},[],"its chain reaches a root trusted by the consumer;",{"_3602":2515,"_30987":2488,"_21467":58437,"_5":14750,"_28174":58383,"_3058":58438},[],"its dates and usages allow the operation;",{"_3602":2516,"_30987":2488,"_21467":58440,"_5":14750,"_28174":58383,"_3058":58441},[],"the consumer applies revocation checks and authorization.",{"_3602":2517,"_30987":2488,"_21467":58443,"_5":14750,"_28174":58383,"_3058":58444},[],"The issuance path includes the first independent checks.",{"_3602":2518,"_30987":2488,"_21467":58446,"_5":14750,"_28174":58387,"_3058":58447},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3602":2519,"_30987":2488,"_21467":58449,"_5":14750,"_28174":58387,"_3058":58450},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3602":2520,"_30987":2488,"_21467":58452,"_5":14750,"_28174":58387,"_3058":58453},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3602":2521,"_30987":2521,"_5":15110,"_3058":58455,"_31325":58456,"_21467":58457,"_28174":2521},"Create your first CA",[50623,52135,56298,55735],[],{"_3602":2522,"_30987":2521,"_21467":58459,"_5":14750,"_28174":2521,"_3058":58460},[],"Create an evaluation root and check its certificate before issuing.",{"_3602":2523,"_30987":2521,"_5":31322,"_21467":58462,"_28174":58463,"_3058":50633},[],"/docs/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3602":2524,"_30987":2521,"_5":31322,"_21467":58465,"_28174":58466,"_3058":58467},[],"/docs/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3602":2525,"_30987":2521,"_5":31322,"_21467":58469,"_28174":58470,"_3058":58471},[],"/docs/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3602":2526,"_30987":2521,"_5":31322,"_21467":58473,"_28174":58474,"_3058":58475},[],"/docs/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3602":2527,"_30987":2521,"_5":31322,"_21467":58477,"_28174":58478,"_3058":58479},[],"/docs/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3602":2528,"_30987":2521,"_5":31322,"_21467":58481,"_28174":58482,"_3058":58483},[],"/docs/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3602":2529,"_30987":2521,"_5":31322,"_21467":58485,"_28174":58486,"_3058":58487},[],"/docs/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3602":2530,"_30987":2521,"_5":31322,"_21467":58489,"_28174":58490,"_3058":55992},[],"/docs/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3602":2531,"_30987":2521,"_5":31322,"_21467":58492,"_28174":58493,"_3058":50657},[],"/docs/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3602":2532,"_30987":2521,"_21467":58495,"_5":14750,"_28174":2521,"_3058":58496},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3602":2533,"_30987":2521,"_21467":58498,"_5":14750,"_28174":58463,"_3058":58499},[],"Console access and permission to create keys and authorities.",{"_3602":2534,"_30987":2521,"_21467":58501,"_5":14750,"_28174":58463,"_3058":58502},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3602":2535,"_30987":2521,"_21467":58504,"_5":14750,"_28174":58463,"_3058":58505},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3602":2536,"_30987":2521,"_21467":58507,"_5":14750,"_28174":58463,"_3058":58508},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3602":2537,"_30987":2521,"_21467":58510,"_5":14750,"_28174":58466,"_3058":58511},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3602":2538,"_30987":2521,"_21467":58513,"_5":14750,"_28174":58466,"_3058":58514},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3602":2539,"_30987":2521,"_21467":58516,"_5":14750,"_28174":58470,"_3058":58517},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3602":2540,"_30987":2521,"_21467":58519,"_5":14750,"_28174":58470,"_3058":58520},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3602":2541,"_30987":2521,"_21467":58522,"_5":14750,"_28174":58474,"_3058":58523},[],"Select **Root CA** and complete:",{"_3602":2542,"_30987":2521,"_21467":58525,"_5":14750,"_28174":58474,"_3058":58526},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3602":2543,"_30987":2521,"_21467":58528,"_5":14750,"_28174":58474,"_3058":58529},[],"**Subject**: organization and country details for your evaluation.",{"_3602":2544,"_30987":2521,"_21467":58531,"_5":14750,"_28174":58474,"_3058":58532},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3602":2545,"_30987":2521,"_21467":58534,"_5":14750,"_28174":58474,"_3058":58535},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3602":2546,"_30987":2521,"_21467":58537,"_5":14750,"_28174":58474,"_3058":58538},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3602":2547,"_30987":2521,"_21467":58540,"_5":14750,"_28174":58478,"_3058":58541},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3602":2548,"_30987":2521,"_21467":58543,"_5":14750,"_28174":58482,"_3058":58544},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3602":2549,"_30987":2521,"_21467":58546,"_5":14750,"_28174":58482,"_3058":58547},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3602":2550,"_30987":2521,"_21467":58549,"_5":14750,"_28174":58486,"_3058":58550},[],"Run from the directory where you saved `ca.pem`:",{"_3602":2551,"_30987":2521,"_21467":58552,"_5":14750,"_28174":58486,"_3058":58553},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3602":2552,"_30987":2521,"_21467":58555,"_5":14750,"_28174":58486,"_3058":58556},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3602":2553,"_30987":2521,"_21467":58558,"_5":14750,"_28174":58490,"_3058":58559},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3602":2554,"_30987":2521,"_21467":58561,"_5":14750,"_28174":58490,"_3058":58562},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3602":2555,"_30987":2521,"_21467":58564,"_5":14750,"_28174":58490,"_3058":58565},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3602":2556,"_30987":2521,"_21467":58567,"_5":14750,"_28174":58490,"_3058":58568},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3602":2557,"_30987":2521,"_21467":58570,"_5":14750,"_28174":58493,"_3058":58571},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3602":2558,"_30987":2558,"_5":15110,"_3058":58573,"_31325":58574,"_21467":58575,"_28174":2558},"Issue and verify a certificate",[50623,52135,56298,55735],[],{"_3602":2559,"_30987":2558,"_21467":58577,"_5":14750,"_28174":2558,"_3058":58578},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3602":2560,"_30987":2558,"_5":31322,"_21467":58580,"_28174":58581,"_3058":50633},[],"/docs/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3602":2561,"_30987":2558,"_5":31322,"_21467":58583,"_28174":58584,"_3058":58585},[],"/docs/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3602":2562,"_30987":2558,"_5":31322,"_21467":58587,"_28174":58588,"_3058":58589},[],"/docs/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3602":2563,"_30987":2558,"_5":31322,"_21467":58591,"_28174":58592,"_3058":58593},[],"/docs/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3602":2564,"_30987":2558,"_5":31322,"_21467":58595,"_28174":58596,"_3058":58597},[],"/docs/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3602":2565,"_30987":2558,"_5":31322,"_21467":58599,"_28174":58600,"_3058":58601},[],"/docs/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3602":2566,"_30987":2558,"_5":31322,"_21467":58603,"_28174":58604,"_3058":58605},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3602":2567,"_30987":2558,"_5":31322,"_21467":58607,"_28174":58608,"_3058":58609},[],"/docs/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3602":2568,"_30987":2558,"_5":31322,"_21467":58611,"_28174":58612,"_3058":58613},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3602":2569,"_30987":2558,"_5":31322,"_21467":58615,"_28174":58616,"_3058":58617},[],"/docs/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3602":2570,"_30987":2558,"_5":31322,"_21467":58619,"_28174":58620,"_3058":55992},[],"/docs/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3602":2571,"_30987":2558,"_5":31322,"_21467":58622,"_28174":58623,"_3058":50657},[],"/docs/platform/pki/quickstarts/issue-certificate#next-step",{"_3602":2572,"_30987":2558,"_21467":58625,"_5":14750,"_28174":2558,"_3058":58626},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3602":2573,"_30987":2558,"_21467":58628,"_5":14750,"_28174":58581,"_3058":58629},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3602":2574,"_30987":2558,"_21467":58631,"_5":14750,"_28174":58581,"_3058":58632},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3602":2575,"_30987":2558,"_21467":58634,"_5":14750,"_28174":58581,"_3058":58635},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3602":2576,"_30987":2558,"_21467":58637,"_5":14750,"_28174":58581,"_3058":58638},[],"A client identifier: here we use `device-001`.",{"_3602":2577,"_30987":2558,"_21467":58640,"_5":14750,"_28174":58581,"_3058":58641},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3602":2578,"_30987":2558,"_21467":58643,"_5":14750,"_28174":58584,"_3058":58644},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3602":2579,"_30987":2558,"_21467":58646,"_5":14750,"_28174":58588,"_3058":58647},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3602":2580,"_30987":2558,"_21467":58649,"_5":14750,"_28174":58588,"_3058":58650},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3602":2581,"_30987":2558,"_21467":58652,"_5":14750,"_28174":58592,"_3058":58653},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3602":2582,"_30987":2558,"_21467":58655,"_5":14750,"_28174":58592,"_3058":58656},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3602":2583,"_30987":2558,"_21467":58658,"_5":14750,"_28174":58596,"_3058":58659},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3602":2584,"_30987":2558,"_21467":58661,"_5":14750,"_28174":58596,"_3058":58662},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3602":2585,"_30987":2558,"_21467":58664,"_5":14750,"_28174":58600,"_3058":58665},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3602":2586,"_30987":2558,"_21467":58667,"_5":14750,"_28174":58604,"_3058":58668},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3602":2587,"_30987":2558,"_21467":58670,"_5":14750,"_28174":58608,"_3058":58671},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3602":2588,"_30987":2558,"_21467":58673,"_5":14750,"_28174":58612,"_3058":58674},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3602":2589,"_30987":2558,"_21467":58676,"_5":14750,"_28174":58612,"_3058":58677},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3602":2590,"_30987":2558,"_21467":58679,"_5":14750,"_28174":58612,"_3058":58680},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3602":2591,"_30987":2558,"_21467":58682,"_5":14750,"_28174":58616,"_3058":58683},[],"In Bash, compare the two public-key digests:",{"_3602":2592,"_30987":2558,"_21467":58685,"_5":14750,"_28174":58616,"_3058":58686},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3602":2593,"_30987":2558,"_21467":58688,"_5":14750,"_28174":58616,"_3058":58689},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3602":2594,"_30987":2558,"_21467":58691,"_5":14750,"_28174":58620,"_3058":56076},[],{"_3602":2595,"_30987":2558,"_21467":58693,"_5":14750,"_28174":58620,"_3058":58694},[],"What to review",{"_3602":2596,"_30987":2558,"_21467":58696,"_5":14750,"_28174":58620,"_3058":58697},[],"The CA rejects issuance",{"_3602":2597,"_30987":2558,"_21467":58699,"_5":14750,"_28174":58620,"_3058":58700},[],"Permissions, CA state and key, algorithm and profile.",{"_3602":2598,"_30987":2558,"_21467":58702,"_5":14750,"_28174":58620,"_3058":58703},[],"Different subject or usages",{"_3602":2599,"_30987":2558,"_21467":58705,"_5":14750,"_28174":58620,"_3058":58706},[],"Applied profile and requested values.",{"_3602":2600,"_30987":2558,"_21467":58708,"_5":14750,"_28174":58620,"_3058":58709},[],"Issuer cannot be found",{"_3602":2601,"_30987":2558,"_21467":58711,"_5":14750,"_28174":58620,"_3058":58712},[],"Downloaded CA and required intermediate chain.",{"_3602":2602,"_30987":2558,"_21467":58714,"_5":14750,"_28174":58620,"_3058":58715},[],"Validity fails",{"_3602":2603,"_30987":2558,"_21467":58717,"_5":14750,"_28174":58620,"_3058":58718},[],"Certificate and CA dates, and the computer's clock.",{"_3602":2604,"_30987":2558,"_21467":58720,"_5":14750,"_28174":58620,"_3058":58721},[],"Public-key digests differ",{"_3602":2605,"_30987":2558,"_21467":58723,"_5":14750,"_28174":58620,"_3058":58724},[],"Certificate and key files from the same issuance.",{"_3602":2606,"_30987":2558,"_21467":58726,"_5":14750,"_28174":58620,"_3058":58727},[],"See PKI diagnostics to narrow an issuance failure.",{"_3602":2607,"_30987":2558,"_21467":58729,"_5":14750,"_28174":58623,"_3058":58730},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3602":2608,"_30987":2558,"_21467":58732,"_5":14750,"_28174":58623,"_3058":58733},[],"Manage certificates for inspection, status and revocation.",{"_3602":2609,"_30987":2558,"_21467":58735,"_5":14750,"_28174":58623,"_3058":58736},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3602":2610,"_30987":2558,"_21467":58738,"_5":14750,"_28174":58623,"_3058":58739},[],"Prepare EST for the device to request its next identities.",{"_3602":2611,"_30987":2558,"_21467":58741,"_5":14750,"_28174":58623,"_3058":58742},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3602":2612,"_30987":2612,"_5":15110,"_3058":58744,"_31325":58745,"_21467":58746,"_28174":2612},"PKI getting started",[50623,52135,56298,55735],[],{"_3602":2613,"_30987":2612,"_21467":58748,"_5":14750,"_28174":2612,"_3058":58749},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3602":2614,"_30987":2612,"_5":31322,"_21467":58751,"_28174":58752,"_3058":50633},[],"/docs/platform/pki/quickstarts/overview#before-you-begin",{"_3602":2615,"_30987":2612,"_5":31322,"_21467":58754,"_28174":58755,"_3058":58756},[],"/docs/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3602":2616,"_30987":2612,"_5":31322,"_21467":58758,"_28174":58759,"_3058":55927},[],"/docs/platform/pki/quickstarts/overview#expected-result",{"_3602":2617,"_30987":2612,"_5":31322,"_21467":58761,"_28174":58762,"_3058":58763},[],"/docs/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3602":2618,"_30987":2612,"_21467":58765,"_5":14750,"_28174":2612,"_3058":58766},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3602":2619,"_30987":2612,"_21467":58768,"_5":14750,"_28174":58752,"_3058":58769},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3602":2620,"_30987":2612,"_21467":58771,"_5":14750,"_28174":58752,"_3058":58772},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3602":2621,"_30987":2612,"_21467":58774,"_5":14750,"_28174":58752,"_3058":58775},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3602":2622,"_30987":2612,"_21467":58777,"_5":14750,"_28174":58752,"_3058":58778},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3602":2623,"_30987":2612,"_21467":58780,"_5":14750,"_28174":58752,"_3058":58781},[],"A working directory with restricted access for the downloaded key.",{"_3602":2624,"_30987":2612,"_21467":58783,"_5":14750,"_28174":58755,"_3058":58784},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3602":2625,"_30987":2612,"_21467":58786,"_5":14750,"_28174":58755,"_3058":58787},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3602":2626,"_30987":2612,"_21467":58789,"_5":14750,"_28174":58755,"_3058":58790},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3602":2627,"_30987":2612,"_21467":58792,"_5":14750,"_28174":58755,"_3058":58793},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3602":2628,"_30987":2612,"_21467":58795,"_5":14750,"_28174":58759,"_3058":58796},[],"File or resource",{"_3602":2629,"_30987":2612,"_21467":58798,"_5":14750,"_28174":58759,"_3058":55924},[],{"_3602":2630,"_30987":2612,"_21467":58800,"_5":14750,"_28174":58759,"_3058":58801},[],"Active root CA and `ca.pem`",{"_3602":2631,"_30987":2612,"_21467":58803,"_5":14750,"_28174":58759,"_3058":58804},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3602":2632,"_30987":2612,"_21467":58806,"_5":14750,"_28174":58759,"_3058":58807},[],"End-entity certificate and `device.crt`",{"_3602":2633,"_30987":2612,"_21467":58809,"_5":14750,"_28174":58759,"_3058":58810},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3602":2634,"_30987":2612,"_21467":58812,"_5":14750,"_28174":58759,"_3058":58813},[],"Private key `device.key`",{"_3602":2635,"_30987":2612,"_21467":58815,"_5":14750,"_28174":58759,"_3058":58816},[],"Its public key matches the one included in `device.crt`.",{"_3602":2636,"_30987":2612,"_21467":58818,"_5":14750,"_28174":58759,"_3058":58819},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3602":2637,"_30987":2612,"_21467":58821,"_5":14750,"_28174":58762,"_3058":58822},[],"To operate certificates, continue with Certificates and Validation.",{"_3602":2638,"_30987":2612,"_21467":58824,"_5":14750,"_28174":58762,"_3058":58825},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3602":2639,"_30987":2612,"_21467":58827,"_5":14750,"_28174":58762,"_3058":58828},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3602":2640,"_30987":2640,"_5":15110,"_3058":58830,"_31325":58831,"_21467":58832,"_28174":2640},"PKI troubleshooting",[50623,52135,56298,54873],[],{"_3602":2641,"_30987":2640,"_21467":58834,"_5":14750,"_28174":2640,"_3058":58835},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3602":2642,"_30987":2640,"_5":31322,"_21467":58837,"_28174":58838,"_3058":58839},[],"/docs/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3602":2643,"_30987":2640,"_5":31322,"_21467":58841,"_28174":58842,"_3058":58843},[],"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3602":2644,"_30987":2640,"_5":31322,"_21467":58845,"_28174":58846,"_3058":58847},[],"/docs/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3602":2645,"_30987":2640,"_21467":58849,"_5":14750,"_28174":2640,"_3058":58850},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3602":2646,"_30987":2640,"_21467":58852,"_5":14750,"_28174":2640,"_3058":58853},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3602":2647,"_30987":2640,"_21467":58855,"_5":14750,"_28174":58838,"_3058":55924},[],{"_3602":2648,"_30987":2640,"_21467":58857,"_5":14750,"_28174":58838,"_3058":58858},[],"What to inspect",{"_3602":2649,"_30987":2640,"_21467":58860,"_5":14750,"_28174":58838,"_3058":50657},[],{"_3602":2650,"_30987":2640,"_21467":58862,"_5":14750,"_28174":58838,"_3058":55140},[],{"_3602":2651,"_30987":2640,"_21467":58864,"_5":14750,"_28174":58838,"_3058":58865},[],"Exists, is active and has usable dates.",{"_3602":2652,"_30987":2640,"_21467":58867,"_5":14750,"_28174":58838,"_3058":58868},[],"Authorities.",{"_3602":2653,"_30987":2640,"_21467":58870,"_5":14750,"_28174":58838,"_3058":58871},[],"Key",{"_3602":2654,"_30987":2640,"_21467":58873,"_5":14750,"_28174":58838,"_3058":58874},[],"The record has a usable private key and the engine can sign.",{"_3602":2655,"_30987":2640,"_21467":58876,"_5":14750,"_28174":58838,"_3058":58877},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3602":2656,"_30987":2640,"_21467":58879,"_5":14750,"_28174":58838,"_3058":58880},[],"CSR",{"_3602":2657,"_30987":2640,"_21467":58882,"_5":14750,"_28174":58838,"_3058":58883},[],"Correct PEM and verifiable signature.",{"_3602":2658,"_30987":2640,"_21467":58885,"_5":14750,"_28174":58838,"_3058":58886},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3602":2659,"_30987":2640,"_21467":58888,"_5":14750,"_28174":58838,"_3058":58889},[],"Profile",{"_3602":2660,"_30987":2640,"_21467":58891,"_5":14750,"_28174":58838,"_3058":58892},[],"Selected source, existing ID, allowed algorithm and size.",{"_3602":2661,"_30987":2640,"_21467":58894,"_5":14750,"_28174":58838,"_3058":58895},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3602":2662,"_30987":2640,"_21467":58897,"_5":14750,"_28174":58838,"_3058":56076},[],{"_3602":2663,"_30987":2640,"_21467":58899,"_5":14750,"_28174":58838,"_3058":58900},[],"Appropriate subject, SAN, usages and dates.",{"_3602":2664,"_30987":2640,"_21467":58902,"_5":14750,"_28174":58838,"_3058":58903},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3602":2665,"_30987":2640,"_21467":58905,"_5":14750,"_28174":58838,"_3058":58906},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3602":2666,"_30987":2640,"_21467":58908,"_5":14750,"_28174":58838,"_3058":58909},[],"If issuance fails with `400` and `CA Status inconsistent`, the issuing CA is not `ACTIVE` or is outside the validity period of its certificate. The stored status can lag behind the dates until the expiration monitor runs, so check the dates too. Reissue the CA while it is still valid, or issue from another CA.",{"_3602":2667,"_30987":2640,"_21467":58911,"_5":14750,"_28174":58838,"_3058":58912},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. For a subordinate CA, also check the status and dates of its parent. To change its key, use Hierarchy and rotation.",{"_3602":2668,"_30987":2640,"_21467":58914,"_5":14750,"_28174":58842,"_3058":58915},[],"Check each boundary independently:",{"_3602":2669,"_30987":2640,"_21467":58917,"_5":14750,"_28174":58842,"_3058":58918},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3602":2670,"_30987":2640,"_21467":58920,"_5":14750,"_28174":58842,"_3058":58921},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3602":2671,"_30987":2640,"_21467":58923,"_5":14750,"_28174":58842,"_3058":58924},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3602":2672,"_30987":2640,"_21467":58926,"_5":14750,"_28174":58842,"_3058":58927},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3602":2673,"_30987":2640,"_21467":58929,"_5":14750,"_28174":58842,"_3058":58930},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3602":2674,"_30987":2640,"_21467":58932,"_5":14750,"_28174":58842,"_3058":58933},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3602":2675,"_30987":2640,"_21467":58935,"_5":14750,"_28174":58846,"_3058":58936},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3602":2676,"_30987":2640,"_21467":58938,"_5":14750,"_28174":58846,"_3058":58939},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3602":2677,"_30987":2677,"_5":15110,"_3058":58941,"_31325":58942,"_21467":58943,"_28174":2677},"Security",[50623],[],{"_3602":2678,"_30987":2677,"_21467":58945,"_5":14750,"_28174":2677,"_3058":58946},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3602":2679,"_30987":2677,"_5":31322,"_21467":58948,"_28174":58949,"_3058":58950},[],"/docs/security#report-a-vulnerability","Report a vulnerability",{"_3602":2680,"_30987":2677,"_5":31322,"_21467":58952,"_28174":58953,"_3058":58954},[],"/docs/security#what-to-include-in-a-report","What to include in a report",{"_3602":2681,"_30987":2677,"_5":31322,"_21467":58956,"_28174":58957,"_3058":58958},[],"/docs/security#supported-versions","Supported versions",{"_3602":2682,"_30987":2677,"_5":31322,"_21467":58960,"_28174":58961,"_3058":58962},[],"/docs/security#responsible-disclosure","Responsible disclosure",{"_3602":2683,"_30987":2677,"_21467":58964,"_5":14750,"_28174":2677,"_3058":58965},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3602":2684,"_30987":2677,"_21467":58967,"_5":14750,"_28174":58949,"_3058":58968},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3602":2685,"_30987":2677,"_21467":58970,"_5":14750,"_28174":58949,"_3058":58971},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3602":2686,"_30987":2677,"_21467":58973,"_5":14750,"_28174":58949,"_3058":15388},[],{"_3602":2687,"_30987":2677,"_21467":58975,"_5":14750,"_28174":58949,"_3058":15317},[],{"_3602":2688,"_30987":2677,"_21467":58977,"_5":14750,"_28174":58949,"_3058":15375},[],{"_3602":2689,"_30987":2677,"_21467":58979,"_5":14750,"_28174":58949,"_3058":58980},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3602":2690,"_30987":2677,"_21467":58982,"_5":14750,"_28174":58949,"_3058":58983},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3602":2691,"_30987":2677,"_21467":58985,"_5":14750,"_28174":58953,"_3058":58986},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3602":2692,"_30987":2677,"_21467":58988,"_5":14750,"_28174":58953,"_3058":58989},[],"Do not include in the report:",{"_3602":2693,"_30987":2677,"_21467":58991,"_5":14750,"_28174":58953,"_3058":58992},[],"Credentials, tokens, or private keys",{"_3602":2694,"_30987":2677,"_21467":58994,"_5":14750,"_28174":58953,"_3058":58995},[],"Customer data or customer-identifiable information",{"_3602":2695,"_30987":2677,"_21467":58997,"_5":14750,"_28174":58953,"_3058":58998},[],"Confidential architecture or internal infrastructure details",{"_3602":2696,"_30987":2677,"_21467":59000,"_5":14750,"_28174":58957,"_3058":59001},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3602":2697,"_30987":2677,"_21467":59003,"_5":14750,"_28174":58957,"_3058":59004},[],"For upgrade guidance, see Upgrades.",{"_3602":2698,"_30987":2677,"_21467":59006,"_5":14750,"_28174":58961,"_3058":59007},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3602":2699,"_30987":2677,"_21467":59009,"_5":14750,"_28174":58961,"_3058":59010},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3602":2700,"_30987":2677,"_21467":59012,"_5":14750,"_28174":58961,"_3058":59013},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3602":2701,"_30987":2677,"_21467":59015,"_5":14750,"_28174":58961,"_3058":59016},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3602":2702,"_30987":2677,"_21467":59018,"_5":14750,"_28174":58961,"_3058":59019},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3602":2703,"_30987":2703,"_5":15110,"_3058":59021,"_31325":59022,"_21467":59024,"_28174":2703},"3.8.0 to 4.0.0",[50623,59023],"Upgrades",[],{"_3602":2704,"_30987":2703,"_21467":59026,"_5":14750,"_28174":2703,"_3058":59027},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3602":2705,"_30987":2703,"_5":31322,"_21467":59029,"_28174":59030,"_3058":59031},[],"/docs/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3602":2706,"_30987":2703,"_5":31322,"_21467":59033,"_28174":59034,"_3058":59035},[],"/docs/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3602":2707,"_30987":2703,"_5":31322,"_21467":59037,"_28174":59038,"_3058":59039},[],"/docs/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3602":2708,"_30987":2703,"_5":31322,"_21467":59041,"_28174":59042,"_3058":59043},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3602":2709,"_30987":2703,"_5":31322,"_21467":59045,"_28174":59046,"_3058":59047},[],"/docs/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3602":2710,"_30987":2703,"_5":31322,"_21467":59049,"_28174":59050,"_3058":59051},[],"/docs/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3602":2711,"_30987":2703,"_5":31322,"_21467":59053,"_28174":59054,"_3058":59055},[],"/docs/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3602":2712,"_30987":2703,"_5":31322,"_21467":59057,"_28174":59058,"_3058":59059},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3602":2713,"_30987":2703,"_5":31322,"_21467":59061,"_28174":59062,"_3058":59063},[],"/docs/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3602":2714,"_30987":2703,"_5":31322,"_21467":59065,"_28174":59066,"_3058":59067},[],"/docs/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3602":2715,"_30987":2703,"_5":31322,"_21467":59069,"_28174":59070,"_3058":51261},[],"/docs/upgrades/3-8-0-to-4-0-0#credentials-in-kubernetes-secrets",{"_3602":2716,"_30987":2703,"_5":31322,"_21467":59072,"_28174":59073,"_3058":59074},[],"/docs/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3602":2717,"_30987":2703,"_5":31322,"_21467":59076,"_28174":59077,"_3058":59078},[],"/docs/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3602":2718,"_30987":2703,"_5":31322,"_21467":59080,"_28174":59081,"_3058":59082},[],"/docs/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3602":2719,"_30987":2703,"_5":31322,"_21467":59084,"_28174":59085,"_3058":59086},[],"/docs/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3602":2720,"_30987":2703,"_5":31322,"_21467":59088,"_28174":59089,"_3058":59090},[],"/docs/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3602":2721,"_30987":2703,"_5":31322,"_21467":59092,"_28174":59093,"_3058":59094},[],"/docs/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3602":2722,"_30987":2703,"_5":31322,"_21467":59096,"_28174":59097,"_3058":59098},[],"/docs/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3602":2723,"_30987":2703,"_5":31322,"_21467":59100,"_28174":59101,"_3058":59102},[],"/docs/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3602":2724,"_30987":2703,"_5":31322,"_21467":59104,"_28174":59105,"_3058":59106},[],"/docs/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3602":2725,"_30987":2703,"_5":31322,"_21467":59108,"_28174":59109,"_3058":59110},[],"/docs/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3602":2726,"_30987":2703,"_5":31322,"_21467":59112,"_28174":59113,"_3058":59114},[],"/docs/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3602":2727,"_30987":2703,"_5":31322,"_21467":59116,"_28174":59117,"_3058":59118},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3602":2728,"_30987":2703,"_5":31322,"_21467":59120,"_28174":59121,"_3058":59122},[],"/docs/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3602":2729,"_30987":2703,"_5":31322,"_21467":59124,"_28174":59125,"_3058":59126},[],"/docs/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3602":2730,"_30987":2703,"_5":31322,"_21467":59128,"_28174":59129,"_3058":59130},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3602":2731,"_30987":2703,"_5":31322,"_21467":59132,"_28174":59133,"_3058":59134},[],"/docs/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3602":2732,"_30987":2703,"_5":31322,"_21467":59136,"_28174":59137,"_3058":59138},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3602":2733,"_30987":2703,"_5":31322,"_21467":59140,"_28174":59141,"_3058":59142},[],"/docs/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3602":2734,"_30987":2703,"_5":31322,"_21467":59144,"_28174":59145,"_3058":59146},[],"/docs/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3602":2735,"_30987":2703,"_5":31322,"_21467":59148,"_28174":59149,"_3058":59150},[],"/docs/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3602":2736,"_30987":2703,"_5":31322,"_21467":59152,"_28174":59153,"_3058":59154},[],"/docs/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3602":2737,"_30987":2703,"_5":31322,"_21467":59156,"_28174":59157,"_3058":59158},[],"/docs/upgrades/3-8-0-to-4-0-0#ca-signature-endpoints-removed","CA signature endpoints removed",{"_3602":2738,"_30987":2703,"_5":31322,"_21467":59160,"_28174":59161,"_3058":59162},[],"/docs/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3602":2739,"_30987":2703,"_5":31322,"_21467":59164,"_28174":59165,"_3058":59166},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3602":2740,"_30987":2703,"_5":31322,"_21467":59168,"_28174":59169,"_3058":59170},[],"/docs/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3602":2741,"_30987":2703,"_5":31322,"_21467":59172,"_28174":59173,"_3058":59174},[],"/docs/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3602":2742,"_30987":2703,"_5":31322,"_21467":59176,"_28174":59177,"_3058":59178},[],"/docs/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3602":2743,"_30987":2703,"_5":31322,"_21467":59180,"_28174":59181,"_3058":59182},[],"/docs/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3602":2744,"_30987":2703,"_5":31322,"_21467":59184,"_28174":59185,"_3058":59186},[],"/docs/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3602":2745,"_30987":2703,"_5":31322,"_21467":59188,"_28174":59189,"_3058":59190},[],"/docs/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3602":2746,"_30987":2703,"_5":31322,"_21467":59192,"_28174":59193,"_3058":59194},[],"/docs/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3602":2747,"_30987":2703,"_5":31322,"_21467":59196,"_28174":59197,"_3058":54873},[],"/docs/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3602":2748,"_30987":2703,"_5":31322,"_21467":59199,"_28174":59200,"_3058":59201},[],"/docs/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3602":2749,"_30987":2703,"_5":31322,"_21467":59203,"_28174":59204,"_3058":59205},[],"/docs/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3602":2750,"_30987":2703,"_21467":59207,"_5":14750,"_28174":2703,"_3058":59208},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3602":2751,"_30987":2703,"_21467":59210,"_5":14750,"_28174":2703,"_3058":59211},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3602":2752,"_30987":2703,"_21467":59213,"_5":14750,"_28174":2703,"_3058":59214},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3602":2753,"_30987":2703,"_21467":59216,"_5":14750,"_28174":2703,"_3058":59217},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3602":2754,"_30987":2703,"_21467":59219,"_5":14750,"_28174":2703,"_3058":59220},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3602":2755,"_30987":2703,"_21467":59222,"_5":14750,"_28174":2703,"_3058":59223},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3602":2756,"_30987":2703,"_21467":59225,"_5":14750,"_28174":2703,"_3058":59226},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3602":2757,"_30987":2703,"_21467":59228,"_5":14750,"_28174":59034,"_3058":59229},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3602":2758,"_30987":2703,"_21467":59231,"_5":14750,"_28174":59034,"_3058":59232},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3602":2759,"_30987":2703,"_21467":59234,"_5":14750,"_28174":59038,"_3058":59235},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3602":2760,"_30987":2703,"_21467":59237,"_5":14750,"_28174":59038,"_3058":59238},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3602":2761,"_30987":2703,"_21467":59240,"_5":14750,"_28174":59042,"_3058":59241},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3602":2762,"_30987":2703,"_21467":59243,"_5":14750,"_28174":59046,"_3058":59244},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3602":2763,"_30987":2703,"_21467":59246,"_5":14750,"_28174":59046,"_3058":59247},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3602":2764,"_30987":2703,"_21467":59249,"_5":14750,"_28174":59046,"_3058":59250},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3602":2765,"_30987":2703,"_21467":59252,"_5":14750,"_28174":59046,"_3058":59253},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3602":2766,"_30987":2703,"_21467":59255,"_5":14750,"_28174":59046,"_3058":59256},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3602":2767,"_30987":2703,"_21467":59258,"_5":14750,"_28174":59050,"_3058":59259},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3602":2768,"_30987":2703,"_21467":59261,"_5":14750,"_28174":59050,"_3058":59262},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3602":2769,"_30987":2703,"_21467":59264,"_5":14750,"_28174":59050,"_3058":59265},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3602":2770,"_30987":2703,"_21467":59267,"_5":14750,"_28174":59050,"_3058":59268},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3602":2771,"_30987":2703,"_21467":59270,"_5":14750,"_28174":59050,"_3058":59271},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3602":2772,"_30987":2703,"_21467":59273,"_5":14750,"_28174":59050,"_3058":59274},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3602":2773,"_30987":2703,"_21467":59276,"_5":14750,"_28174":59054,"_3058":59277},[],"Change",{"_3602":2774,"_30987":2703,"_21467":59279,"_5":14750,"_28174":59054,"_3058":59280},[],"Who is affected",{"_3602":2775,"_30987":2703,"_21467":59282,"_5":14750,"_28174":59054,"_3058":59283},[],"Severity",{"_3602":2776,"_30987":2703,"_21467":59285,"_5":14750,"_28174":59054,"_3058":57743},[],{"_3602":2777,"_30987":2703,"_21467":59287,"_5":14750,"_28174":59054,"_3058":59063},[],{"_3602":2778,"_30987":2703,"_21467":59289,"_5":14750,"_28174":59054,"_3058":59290},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3602":2779,"_30987":2703,"_21467":59292,"_5":14750,"_28174":59054,"_3058":59293},[],"High: KMS and VA start on empty volumes",{"_3602":2780,"_30987":2703,"_21467":59295,"_5":14750,"_28174":59054,"_3058":59296},[],"Copy the data into the new volumes",{"_3602":2781,"_30987":2703,"_21467":59298,"_5":14750,"_28174":59054,"_3058":59067},[],{"_3602":2782,"_30987":2703,"_21467":59300,"_5":14750,"_28174":59054,"_3058":59301},[],"Every Helm release",{"_3602":2783,"_30987":2703,"_21467":59303,"_5":14750,"_28174":59054,"_3058":59304},[],"High: `helm upgrade` fails",{"_3602":2784,"_30987":2703,"_21467":59306,"_5":14750,"_28174":59054,"_3058":59307},[],"Remove or rename legacy keys",{"_3602":2785,"_30987":2703,"_21467":59309,"_5":14750,"_28174":59054,"_3058":51261},[],{"_3602":2786,"_30987":2703,"_21467":59311,"_5":14750,"_28174":59054,"_3058":59301},[],{"_3602":2787,"_30987":2703,"_21467":59313,"_5":14750,"_28174":59054,"_3058":59314},[],"High: `helm upgrade` fails on inline credentials",{"_3602":2788,"_30987":2703,"_21467":59316,"_5":14750,"_28174":59054,"_3058":59317},[],"Create the Secrets first; see Step 2",{"_3602":2789,"_30987":2703,"_21467":59319,"_5":14750,"_28174":59054,"_3058":59074},[],{"_3602":2790,"_30987":2703,"_21467":59321,"_5":14750,"_28174":59054,"_3058":59322},[],"Every deployment",{"_3602":2791,"_30987":2703,"_21467":59324,"_5":14750,"_28174":59054,"_3058":59325},[],"High: without a bootstrap principal there is no administrator",{"_3602":2792,"_30987":2703,"_21467":59327,"_5":14750,"_28174":59054,"_3058":59328},[],"Configure `services.authz`",{"_3602":2793,"_30987":2703,"_21467":59330,"_5":14750,"_28174":59054,"_3058":59078},[],{"_3602":2794,"_30987":2703,"_21467":59332,"_5":14750,"_28174":59054,"_3058":59301},[],{"_3602":2795,"_30987":2703,"_21467":59334,"_5":14750,"_28174":59054,"_3058":59335},[],"High: `helm upgrade` fails on the old keys",{"_3602":2796,"_30987":2703,"_21467":59337,"_5":14750,"_28174":59054,"_3058":59338},[],"Move JWKS and roles into `services.authz`",{"_3602":2797,"_30987":2703,"_21467":59340,"_5":14750,"_28174":59054,"_3058":59098},[],{"_3602":2798,"_30987":2703,"_21467":59342,"_5":14750,"_28174":59054,"_3058":59343},[],"3.8.0 deployments with per-service databases",{"_3602":2799,"_30987":2703,"_21467":59345,"_5":14750,"_28174":59054,"_3058":59346},[],"High: services find no data, or a migration aborts",{"_3602":2800,"_30987":2703,"_21467":59348,"_5":14750,"_28174":59054,"_3058":59349},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3602":2801,"_30987":2703,"_21467":59351,"_5":14750,"_28174":59054,"_3058":59102},[],{"_3602":2802,"_30987":2703,"_21467":59353,"_5":14750,"_28174":59054,"_3058":59354},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3602":2803,"_30987":2703,"_21467":59356,"_5":14750,"_28174":59054,"_3058":59357},[],"High: the backend no longer starts with them",{"_3602":2804,"_30987":2703,"_21467":59359,"_5":14750,"_28174":59054,"_3058":59360},[],"Move to PostgreSQL before upgrading",{"_3602":2805,"_30987":2703,"_21467":59362,"_5":14750,"_28174":59054,"_3058":59146},[],{"_3602":2806,"_30987":2703,"_21467":59364,"_5":14750,"_28174":59054,"_3058":59365},[],"Every deployment; API clients, custom policies and alert subscriptions are also affected",{"_3602":2807,"_30987":2703,"_21467":59367,"_5":14750,"_28174":59054,"_3058":59368},[],"High: the `/v1/roles` routes are removed and the migration is irreversible",{"_3602":2808,"_30987":2703,"_21467":59370,"_5":14750,"_28174":59054,"_3058":59371},[],"Fix the data the migration aborts on, and back up the database and the CRL bucket",{"_3602":2809,"_30987":2703,"_21467":59373,"_5":14750,"_28174":59054,"_3058":59374},[],"Webhooks with file references",{"_3602":2810,"_30987":2703,"_21467":59376,"_5":14750,"_28174":59054,"_3058":59377},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3602":2811,"_30987":2703,"_21467":59379,"_5":14750,"_28174":59054,"_3058":59380},[],"High: enrollments calling the webhook fail",{"_3602":2812,"_30987":2703,"_21467":59382,"_5":14750,"_28174":59054,"_3058":59383},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3602":2813,"_30987":2703,"_21467":59385,"_5":14750,"_28174":59054,"_3058":59082},[],{"_3602":2814,"_30987":2703,"_21467":59387,"_5":14750,"_28174":59054,"_3058":59388},[],"Releases with per-service identity overrides or mounted key material",{"_3602":2815,"_30987":2703,"_21467":59390,"_5":14750,"_28174":59054,"_3058":59391},[],"Medium: services cannot read their files",{"_3602":2816,"_30987":2703,"_21467":59393,"_5":14750,"_28174":59054,"_3058":59394},[],"Remove the overrides and fix volume ownership",{"_3602":2817,"_30987":2703,"_21467":59396,"_5":14750,"_28174":59054,"_3058":59086},[],{"_3602":2818,"_30987":2703,"_21467":59398,"_5":14750,"_28174":59054,"_3058":59399},[],"Releases that set `amqp.tls`",{"_3602":2819,"_30987":2703,"_21467":59401,"_5":14750,"_28174":59054,"_3058":59402},[],"Medium: clients connect to the wrong port",{"_3602":2820,"_30987":2703,"_21467":59404,"_5":14750,"_28174":59054,"_3058":59405},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3602":2821,"_30987":2703,"_21467":59407,"_5":14750,"_28174":59054,"_3058":59106},[],{"_3602":2822,"_30987":2703,"_21467":59409,"_5":14750,"_28174":59054,"_3058":59410},[],"Installations whose CA keys predate the KMS",{"_3602":2823,"_30987":2703,"_21467":59412,"_5":14750,"_28174":59054,"_3058":59413},[],"Medium: CA keys stay unmanaged",{"_3602":2824,"_30987":2703,"_21467":59415,"_5":14750,"_28174":59054,"_3058":59416},[],"Run the CA-to-KMS migration",{"_3602":2825,"_30987":2703,"_21467":59418,"_5":14750,"_28174":59054,"_3058":59419},[],"Receiver certificate verification",{"_3602":2826,"_30987":2703,"_21467":59421,"_5":14750,"_28174":59054,"_3058":59422},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3602":2827,"_30987":2703,"_21467":59424,"_5":14750,"_28174":59054,"_3058":59425},[],"Medium: credentials go to an unverified receiver",{"_3602":2828,"_30987":2703,"_21467":59427,"_5":14750,"_28174":59054,"_3058":59428},[],"Set `insecure_skip_verify` to `false`",{"_3602":2829,"_30987":2703,"_21467":59430,"_5":14750,"_28174":59054,"_3058":59122},[],{"_3602":2830,"_30987":2703,"_21467":59432,"_5":14750,"_28174":59054,"_3058":59433},[],"Scripts and consoles that edit DMSs through the API",{"_3602":2831,"_30987":2703,"_21467":59435,"_5":14750,"_28174":59054,"_3058":59436},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3602":2832,"_30987":2703,"_21467":59438,"_5":14750,"_28174":59054,"_3058":59439},[],"Read the DMS before editing and use the new field",{"_3602":2833,"_30987":2703,"_21467":59441,"_5":14750,"_28174":59054,"_3058":59142},[],{"_3602":2834,"_30987":2703,"_21467":59443,"_5":14750,"_28174":59054,"_3058":59444},[],"Clients that create or update CRL settings through the API",{"_3602":2835,"_30987":2703,"_21467":59446,"_5":14750,"_28174":59054,"_3058":59447},[],"Medium: requests with the old field return an error",{"_3602":2836,"_30987":2703,"_21467":59449,"_5":14750,"_28174":59054,"_3058":59450},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3602":2837,"_30987":2703,"_21467":59452,"_5":14750,"_28174":59054,"_3058":59150},[],{"_3602":2838,"_30987":2703,"_21467":59454,"_5":14750,"_28174":59054,"_3058":59455},[],"Alert subscriptions and consumers of the VA events",{"_3602":2839,"_30987":2703,"_21467":59457,"_5":14750,"_28174":59054,"_3058":59458},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3602":2840,"_30987":2703,"_21467":59460,"_5":14750,"_28174":59054,"_3058":59461},[],"Review conditions filtering on the old event payload or subject",{"_3602":2841,"_30987":2703,"_21467":59463,"_5":14750,"_28174":59054,"_3058":59138},[],{"_3602":2842,"_30987":2703,"_21467":59465,"_5":14750,"_28174":59054,"_3058":59466},[],"Consumers that read the device `events` field",{"_3602":2843,"_30987":2703,"_21467":59468,"_5":14750,"_28174":59054,"_3058":59469},[],"Medium: the field disappears",{"_3602":2844,"_30987":2703,"_21467":59471,"_5":14750,"_28174":59054,"_3058":59472},[],"Use the new event endpoints",{"_3602":2845,"_30987":2703,"_21467":59474,"_5":14750,"_28174":59054,"_3058":59162},[],{"_3602":2846,"_30987":2703,"_21467":59476,"_5":14750,"_28174":59054,"_3058":59477},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3602":2847,"_30987":2703,"_21467":59479,"_5":14750,"_28174":59054,"_3058":59480},[],"Medium: the VA migration aborts",{"_3602":2848,"_30987":2703,"_21467":59482,"_5":14750,"_28174":59054,"_3058":59483},[],"Fix the affected roles before upgrading",{"_3602":2849,"_30987":2703,"_21467":59485,"_5":14750,"_28174":59054,"_3058":59090},[],{"_3602":2850,"_30987":2703,"_21467":59487,"_5":14750,"_28174":59054,"_3058":59488},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3602":2851,"_30987":2703,"_21467":59490,"_5":14750,"_28174":59054,"_3058":59491},[],"Low to medium: validation errors or changed defaults",{"_3602":2852,"_30987":2703,"_21467":59493,"_5":14750,"_28174":59054,"_3058":59494},[],"Update the values file",{"_3602":2853,"_30987":2703,"_21467":59496,"_5":14750,"_28174":59054,"_3058":59130},[],{"_3602":2854,"_30987":2703,"_21467":59498,"_5":14750,"_28174":59054,"_3058":59499},[],"Clients that send the DMS ID in the update body",{"_3602":2855,"_30987":2703,"_21467":59501,"_5":14750,"_28174":59054,"_3058":59502},[],"Low: the ID in the URL wins",{"_3602":2856,"_30987":2703,"_21467":59504,"_5":14750,"_28174":59054,"_3058":59505},[],"Send the ID in the URL",{"_3602":2857,"_30987":2703,"_21467":59507,"_5":14750,"_28174":59054,"_3058":59154},[],{"_3602":2858,"_30987":2703,"_21467":59509,"_5":14750,"_28174":59054,"_3058":59510},[],"Clients that send an `id` when creating or importing CAs",{"_3602":2859,"_30987":2703,"_21467":59512,"_5":14750,"_28174":59054,"_3058":59513},[],"Low: the ID in the body is ignored, and the field is removed",{"_3602":2860,"_30987":2703,"_21467":59515,"_5":14750,"_28174":59054,"_3058":59516},[],"Let the backend assign the ID and use the returned one",{"_3602":2861,"_30987":2703,"_21467":59518,"_5":14750,"_28174":59054,"_3058":59158},[],{"_3602":2862,"_30987":2703,"_21467":59520,"_5":14750,"_28174":59054,"_3058":59521},[],"API and SDK clients that call `/v1/cas/{id}/signature/sign` or `/verify`, and alert subscriptions on `ca.sign.signature`",{"_3602":2863,"_30987":2703,"_21467":59523,"_5":14750,"_28174":59054,"_3058":59524},[],"Medium: the calls return `404` and the subscriptions never fire",{"_3602":2864,"_30987":2703,"_21467":59526,"_5":14750,"_28174":59054,"_3058":59527},[],"Use the KMS `sign` and `verify` operations",{"_3602":2865,"_30987":2703,"_21467":59529,"_5":14750,"_28174":59054,"_3058":59134},[],{"_3602":2866,"_30987":2703,"_21467":59531,"_5":14750,"_28174":59054,"_3058":59532},[],"Consumers that match on certificate `type`",{"_3602":2867,"_30987":2703,"_21467":59534,"_5":14750,"_28174":59054,"_3058":59535},[],"Low: two values are renamed",{"_3602":2868,"_30987":2703,"_21467":59537,"_5":14750,"_28174":59054,"_3058":59538},[],"Adapt consumers",{"_3602":2869,"_30987":2703,"_21467":59540,"_5":14750,"_28174":59054,"_3058":59126},[],{"_3602":2870,"_30987":2703,"_21467":59542,"_5":14750,"_28174":59054,"_3058":59543},[],"Any DMS",{"_3602":2871,"_30987":2703,"_21467":59545,"_5":14750,"_28174":59054,"_3058":59546},[],"Low: informational",{"_3602":2872,"_30987":2703,"_21467":59548,"_5":14750,"_28174":59054,"_3058":59549},[],"Read both blocks before editing",{"_3602":2873,"_30987":2703,"_21467":59551,"_5":14750,"_28174":59062,"_3058":59552},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3602":2874,"_30987":2703,"_21467":59554,"_5":14750,"_28174":59062,"_3058":59555},[],"Step 4 of the migration guide copies the data.",{"_3602":2875,"_30987":2703,"_21467":59557,"_5":14750,"_28174":59066,"_3058":59558},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3602":2876,"_30987":2703,"_21467":59560,"_5":14750,"_28174":59070,"_3058":59561},[],"In 4.0.0 the chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace instead of inline values: `postgres.existingSecret`, `amqp.existingSecret` and — when SMTP authentication is configured — `services.alerts.smtp_server.existingSecret`, each with `usernameKey` and `passwordKey` naming the Secret data keys. The inline `postgres.username`/`postgres.password` and `amqp.username`/`amqp.password` values are removed and rejected by `values.schema.json`, so a 3.8.0 values file fails `helm lint` and `helm upgrade` until the credentials move into Secrets.",{"_3602":2877,"_30987":2703,"_21467":59563,"_5":14750,"_28174":59070,"_3058":59564},[],"The Secrets must exist before `helm upgrade` runs: the pre-upgrade database job connects to PostgreSQL with them. Step 2 creates them through the External Secrets Operator.",{"_3602":2878,"_30987":2703,"_21467":59566,"_5":14750,"_28174":59073,"_3058":59567},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3602":2879,"_30987":2703,"_21467":59569,"_5":14750,"_28174":59077,"_3058":59570},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3602":2880,"_30987":2703,"_21467":59572,"_5":14750,"_28174":59081,"_3058":59573},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3602":2881,"_30987":2703,"_21467":59575,"_5":14750,"_28174":59081,"_3058":59576},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3602":2882,"_30987":2703,"_21467":59578,"_5":14750,"_28174":59081,"_3058":59579},[],"Pods now carry a pod-level `fsGroup: 65532` with `fsGroupChangePolicy: OnRootMismatch`, which skips recursive ownership changes when the volume root already has the expected group. If your backup helpers or jobs run with a different GID, verify they can still access the volumes they need.",{"_3602":2883,"_30987":2703,"_21467":59581,"_5":14750,"_28174":59085,"_3058":59582},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3602":2884,"_30987":2703,"_21467":59584,"_5":14750,"_28174":59089,"_3058":59585},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3602":2885,"_30987":2703,"_21467":59587,"_5":14750,"_28174":59089,"_3058":59588},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3602":2886,"_30987":2703,"_21467":59590,"_5":14750,"_28174":59089,"_3058":59591},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3602":2887,"_30987":2703,"_21467":59593,"_5":14750,"_28174":59089,"_3058":59594},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3602":2888,"_30987":2703,"_21467":59596,"_5":14750,"_28174":59089,"_3058":59597},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3602":2889,"_30987":2703,"_21467":59599,"_5":14750,"_28174":59089,"_3058":59600},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3602":2890,"_30987":2703,"_21467":59602,"_5":14750,"_28174":59097,"_3058":59603},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3602":2891,"_30987":2703,"_21467":59605,"_5":14750,"_28174":59097,"_3058":59606},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3602":2892,"_30987":2703,"_21467":59608,"_5":14750,"_28174":59097,"_3058":59609},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3602":2893,"_30987":2703,"_21467":59611,"_5":14750,"_28174":59097,"_3058":59612},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3602":2894,"_30987":2703,"_21467":59614,"_5":14750,"_28174":59097,"_3058":59615},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3602":2895,"_30987":2703,"_21467":59617,"_5":14750,"_28174":59101,"_3058":59618},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3602":2896,"_30987":2703,"_21467":59620,"_5":14750,"_28174":59105,"_3058":59621},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3602":2897,"_30987":2703,"_21467":59623,"_5":14750,"_28174":59105,"_3058":59624},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3602":2898,"_30987":2703,"_21467":59626,"_5":14750,"_28174":59105,"_3058":59627},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3602":2899,"_30987":2703,"_21467":59629,"_5":14750,"_28174":59105,"_3058":59630},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3602":2900,"_30987":2703,"_21467":59632,"_5":14750,"_28174":59105,"_3058":59633},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3602":2901,"_30987":2703,"_21467":59635,"_5":14750,"_28174":59105,"_3058":59636},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3602":2902,"_30987":2703,"_21467":59638,"_5":14750,"_28174":59105,"_3058":59639},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3602":2903,"_30987":2703,"_21467":59641,"_5":14750,"_28174":59105,"_3058":59642},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3602":2904,"_30987":2703,"_21467":59644,"_5":14750,"_28174":59109,"_3058":59645},[],"Certificates now reference their KMS key, and CRL settings reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3602":2905,"_30987":2703,"_21467":59647,"_5":14750,"_28174":59117,"_3058":59648},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3602":2906,"_30987":2703,"_21467":59650,"_5":14750,"_28174":59117,"_3058":59651},[],"Field in 3.8.0",{"_3602":2907,"_30987":2703,"_21467":59653,"_5":14750,"_28174":59117,"_3058":59654},[],"Field in 4.0.0",{"_3602":2908,"_30987":2703,"_21467":59656,"_5":14750,"_28174":59117,"_3058":59657},[],"`validate_server_cert`",{"_3602":2909,"_30987":2703,"_21467":59659,"_5":14750,"_28174":59117,"_3058":59660},[],"`insecure_skip_verify` (value negated)",{"_3602":2910,"_30987":2703,"_21467":59662,"_5":14750,"_28174":59117,"_3058":59663},[],"`oidc`",{"_3602":2911,"_30987":2703,"_21467":59665,"_5":14750,"_28174":59117,"_3058":59666},[],"`jwt_options`",{"_3602":2912,"_30987":2703,"_21467":59668,"_5":14750,"_28174":59117,"_3058":59669},[],"`apikey`",{"_3602":2913,"_30987":2703,"_21467":59671,"_5":14750,"_28174":59117,"_3058":59672},[],"`apikey_options`",{"_3602":2914,"_30987":2703,"_21467":59674,"_5":14750,"_28174":59117,"_3058":59675},[],"`mtls`",{"_3602":2915,"_30987":2703,"_21467":59677,"_5":14750,"_28174":59117,"_3058":59678},[],"`mtls_options`",{"_3602":2916,"_30987":2703,"_21467":59680,"_5":14750,"_28174":59117,"_3058":59681},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3602":2917,"_30987":2703,"_21467":59683,"_5":14750,"_28174":59117,"_3058":59684},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3602":2918,"_30987":2703,"_21467":59686,"_5":14750,"_28174":59117,"_3058":59687},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3602":2919,"_30987":2703,"_21467":59689,"_5":14750,"_28174":59121,"_3058":59690},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3602":2920,"_30987":2703,"_21467":59692,"_5":14750,"_28174":59121,"_3058":59693},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3602":2921,"_30987":2703,"_21467":59695,"_5":14750,"_28174":59121,"_3058":59696},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3602":2922,"_30987":2703,"_21467":59698,"_5":14750,"_28174":59125,"_3058":59699},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3602":2923,"_30987":2703,"_21467":59701,"_5":14750,"_28174":59129,"_3058":59702},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3602":2924,"_30987":2703,"_21467":59704,"_5":14750,"_28174":59133,"_3058":59705},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3602":2925,"_30987":2703,"_21467":59707,"_5":14750,"_28174":59137,"_3058":59708},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3602":2926,"_30987":2703,"_21467":59710,"_5":14750,"_28174":59137,"_3058":59711},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3602":2927,"_30987":2703,"_21467":59713,"_5":14750,"_28174":59137,"_3058":59714},[],"`POST /v1/devices/:id/events` creates an event.",{"_3602":2928,"_30987":2703,"_21467":59716,"_5":14750,"_28174":59137,"_3058":59717},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3602":2929,"_30987":2703,"_21467":59719,"_5":14750,"_28174":59141,"_3058":59720},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3602":2930,"_30987":2703,"_21467":59722,"_5":14750,"_28174":59145,"_3058":59723},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key:",{"_3602":2931,"_30987":2703,"_21467":59725,"_5":14750,"_28174":59145,"_3058":59726},[],"Route",{"_3602":2932,"_30987":2703,"_21467":59728,"_5":14750,"_28174":59145,"_3058":54060},[],{"_3602":2933,"_30987":2703,"_21467":59730,"_5":14750,"_28174":59145,"_3058":59731},[],"`GET /v1/crl-settings`",{"_3602":2934,"_30987":2703,"_21467":59733,"_5":14750,"_28174":59145,"_3058":59734},[],"Lists the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3602":2935,"_30987":2703,"_21467":59736,"_5":14750,"_28174":59145,"_3058":59737},[],"`GET /v1/crl-settings/{ca-id}`",{"_3602":2936,"_30987":2703,"_21467":59739,"_5":14750,"_28174":59145,"_3058":59740},[],"Reads the settings of a CA.",{"_3602":2937,"_30987":2703,"_21467":59742,"_5":14750,"_28174":59145,"_3058":59743},[],"`PUT /v1/crl-settings/{ca-id}`",{"_3602":2938,"_30987":2703,"_21467":59745,"_5":14750,"_28174":59145,"_3058":59746},[],"Replaces `crl_options`.",{"_3602":2939,"_30987":2703,"_21467":59748,"_5":14750,"_28174":59145,"_3058":59749},[],"`DELETE /v1/crl-settings/{ca-id}`",{"_3602":2940,"_30987":2703,"_21467":59751,"_5":14750,"_28174":59145,"_3058":59752},[],"Removes the archived settings of a CA.",{"_3602":2941,"_30987":2703,"_21467":59754,"_5":14750,"_28174":59145,"_3058":59755},[],"The options keep their meaning and their defaults: 7 days of `validity`, 6 days and 23 hours of `refresh_interval`, and `regenerate_on_revoke` `true`. `status` (`ACTIVE`, `FINAL` or `ARCHIVED`), `legacy_ski` and `latest_crl` are read-only. A `PUT` validates the signer only when it changes, does not regenerate the CRL, and returns `409` when the settings are not `ACTIVE`.",{"_3602":2942,"_30987":2703,"_21467":59757,"_5":14750,"_28174":59145,"_3058":59758},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3602":2943,"_30987":2703,"_21467":59760,"_5":14750,"_28174":59145,"_3058":59761},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3602":2944,"_30987":2703,"_21467":59763,"_5":14750,"_28174":59145,"_3058":59764},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3602":2945,"_30987":2703,"_21467":59766,"_5":14750,"_28174":59145,"_3058":59767},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3602":2946,"_30987":2703,"_21467":59769,"_5":14750,"_28174":59145,"_3058":59770},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3602":2947,"_30987":2703,"_21467":59772,"_5":14750,"_28174":59145,"_3058":59773},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3602":2948,"_30987":2703,"_21467":59775,"_5":14750,"_28174":59145,"_3058":59776},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3602":2949,"_30987":2703,"_21467":59778,"_5":14750,"_28174":59145,"_3058":59779},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3602":2950,"_30987":2703,"_21467":59781,"_5":14750,"_28174":59145,"_3058":59782},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3602":2951,"_30987":2703,"_21467":59784,"_5":14750,"_28174":59145,"_3058":59785},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. The entity gains the `delete` atomic action, a `signer_key_id` relation to KMS keys, and the filterable columns `signer_engine_id` and `signer_key_id`; grant the new action to whoever may delete archived CRL settings. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3602":2952,"_30987":2703,"_21467":59787,"_5":14750,"_28174":59149,"_3058":59788},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3602":2953,"_30987":2703,"_21467":59790,"_5":14750,"_28174":59153,"_3058":59791},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3602":2954,"_30987":2703,"_21467":59793,"_5":14750,"_28174":59157,"_3058":59794},[],"A CA key now signs only certificates. 3.8.0 let a client sign arbitrary data with a CA key through `POST /v1/cas/{id}/signature/sign` and check the result with `POST /v1/cas/{id}/signature/verify`. 4.0.0 removes both endpoints, the matching `SignatureSign` and `SignatureVerify` methods of the Go SDK `CAService`, and the `ca.sign.signature` event. An alert subscription on that event no longer fires: delete it or move it to another event.",{"_3602":2955,"_30987":2703,"_21467":59796,"_5":14750,"_28174":59157,"_3058":59797},[],"To sign and verify data, use the KMS operations `POST /v1/keys/{id}/sign` and `POST /v1/keys/{id}/verify`, which have their own authorization. Signing a certificate with a CA that is not `ACTIVE` or whose validity period does not include the current time now fails with `400`, even if the stored status has not yet changed to `EXPIRED`: see Certificate authorities.",{"_3602":2956,"_30987":2703,"_21467":59799,"_5":14750,"_28174":59161,"_3058":59800},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3602":2957,"_30987":2703,"_21467":59802,"_5":14750,"_28174":59165,"_3058":59803},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3602":2958,"_30987":2703,"_21467":59805,"_5":14750,"_28174":59169,"_3058":59806},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings keyed by CA ID).",{"_3602":2959,"_30987":2703,"_21467":59808,"_5":14750,"_28174":59169,"_3058":59809},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3602":2960,"_30987":2703,"_21467":59811,"_5":14750,"_28174":59169,"_3058":59812},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3602":2961,"_30987":2703,"_21467":59814,"_5":14750,"_28174":59169,"_3058":59815},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3602":2962,"_30987":2703,"_21467":59817,"_5":14750,"_28174":59169,"_3058":59818},[],"Record the names of your local-storage PVCs:",{"_3602":2963,"_30987":2703,"_21467":59820,"_5":14750,"_28174":59169,"_3058":59821},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3602":2964,"_30987":2703,"_21467":59823,"_5":14750,"_28174":59173,"_3058":59824},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3602":2965,"_30987":2703,"_21467":59826,"_5":14750,"_28174":59173,"_3058":59827},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3602":2966,"_30987":2703,"_21467":59829,"_5":14750,"_28174":59173,"_3058":59830},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3602":2967,"_30987":2703,"_21467":59832,"_5":14750,"_28174":59173,"_3058":59833},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3602":2968,"_30987":2703,"_21467":59835,"_5":14750,"_28174":59173,"_3058":59836},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3602":2969,"_30987":2703,"_21467":59838,"_5":14750,"_28174":59177,"_3058":59839},[],"**Create the credential Secrets.** The 4.0.0 chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets, and the pre-upgrade database job needs them before the upgrade runs. Copy the 3.8.0 credentials into your secret-management provider and create the Secrets with the External Secrets Operator (ESO), which the chart does not install:",{"_3602":2970,"_30987":2703,"_21467":59841,"_5":14750,"_28174":59177,"_3058":59842},[],"Configure ESO and its provider (`SecretStore` or `ClusterSecretStore`).",{"_3602":2971,"_30987":2703,"_21467":59844,"_5":14750,"_28174":59177,"_3058":59845},[],"Create an `ExternalSecret` for each credential set you use. Its target Secret must live in the release namespace, be named after the corresponding `existingSecret` value, and contain these keys:",{"_3602":2972,"_30987":2703,"_21467":59847,"_5":14750,"_28174":59177,"_3058":59848},[],"Secret (`existingSecret`)",{"_3602":2973,"_30987":2703,"_21467":59850,"_5":14750,"_28174":59177,"_3058":59851},[],"Required data keys",{"_3602":2974,"_30987":2703,"_21467":59853,"_5":14750,"_28174":59177,"_3058":59854},[],"When",{"_3602":2975,"_30987":2703,"_21467":59856,"_5":14750,"_28174":59177,"_3058":59857},[],"`lamassu-postgres` (default of `postgres.existingSecret`)",{"_3602":2976,"_30987":2703,"_21467":59859,"_5":14750,"_28174":59177,"_3058":59860},[],"`username`, `password`",{"_3602":2977,"_30987":2703,"_21467":59862,"_5":14750,"_28174":59177,"_3058":59863},[],"Always",{"_3602":2978,"_30987":2703,"_21467":59865,"_5":14750,"_28174":59177,"_3058":59866},[],"`lamassu-amqp` (default of `amqp.existingSecret`)",{"_3602":2979,"_30987":2703,"_21467":59868,"_5":14750,"_28174":59177,"_3058":59860},[],{"_3602":2980,"_30987":2703,"_21467":59870,"_5":14750,"_28174":59177,"_3058":59863},[],{"_3602":2981,"_30987":2703,"_21467":59872,"_5":14750,"_28174":59177,"_3058":59873},[],"`services.alerts.smtp_server.existingSecret`",{"_3602":2982,"_30987":2703,"_21467":59875,"_5":14750,"_28174":59177,"_3058":59860},[],{"_3602":2983,"_30987":2703,"_21467":59877,"_5":14750,"_28174":59177,"_3058":59878},[],"Only when SMTP authentication is enabled",{"_3602":2984,"_30987":2703,"_21467":59880,"_5":14750,"_28174":59177,"_3058":59881},[],"Wait for every `ExternalSecret` to be Ready and verify the generated Secrets before running the upgrade.",{"_3602":2985,"_30987":2703,"_21467":59883,"_5":14750,"_28174":59177,"_3058":59884},[],"Do not change the database or broker passwords as part of this migration: ESO synchronizes credentials into Secrets, but it does not update the users configured on the PostgreSQL server or the broker. Removing credentials from the values file does not undo past exposure — if they were ever committed to Git, rotate them after the migration is complete.",{"_3602":2986,"_30987":2703,"_21467":59886,"_5":14750,"_28174":59177,"_3058":59887},[],"The `charts/lamassu/README.md` in the Helm repository documents a full worked example in its *Secret management* section: installing external-secrets 0.20.2, a test Fake `ClusterSecretStore`, the `ExternalSecret` resources and the wait for synchronization. Its Fake provider is for testing only; for production, replace it with your provider's configuration.",{"_3602":2987,"_30987":2703,"_21467":59889,"_5":14750,"_28174":59177,"_3058":59890},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3602":2988,"_30987":2703,"_21467":59892,"_5":14750,"_28174":59177,"_3058":59893},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3602":2989,"_30987":2703,"_21467":59895,"_5":14750,"_28174":59177,"_3058":59896},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is required; per-schema `hostname` and `port` values remain accepted but are ignored — the connection always uses the global `postgres.hostname` and `postgres.port` with the global PostgreSQL credential Secret, `postgres.existingSecret` with its configured key names, unless the entry sets its own `existingSecret` (with optional `usernameKey` and `passwordKey`).",{"_3602":2990,"_30987":2703,"_21467":59898,"_5":14750,"_28174":59177,"_3058":59899},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3602":2991,"_30987":2703,"_21467":59901,"_5":14750,"_28174":59177,"_3058":59902},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3602":2992,"_30987":2703,"_21467":59904,"_5":14750,"_28174":59177,"_3058":59905},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3602":2993,"_30987":2703,"_21467":59907,"_5":14750,"_28174":59177,"_3058":59908},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3602":2994,"_30987":2703,"_21467":59910,"_5":14750,"_28174":59177,"_3058":59911},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3602":2995,"_30987":2703,"_21467":59913,"_5":14750,"_28174":59177,"_3058":59914},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3602":2996,"_30987":2703,"_21467":59916,"_5":14750,"_28174":59177,"_3058":59917},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3602":2997,"_30987":2703,"_21467":59919,"_5":14750,"_28174":59177,"_3058":59920},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3602":2998,"_30987":2703,"_21467":59922,"_5":14750,"_28174":59177,"_3058":59923},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown. Before running Step 3, confirm every credential `ExternalSecret` is Ready and the generated Secrets contain the expected keys.",{"_3602":2999,"_30987":2703,"_21467":59925,"_5":14750,"_28174":59181,"_3058":59926},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3602":3000,"_30987":2703,"_21467":59928,"_5":14750,"_28174":59181,"_3058":59929},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3602":3001,"_30987":2703,"_21467":59931,"_5":14750,"_28174":59185,"_3058":59932},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3602":3002,"_30987":2703,"_21467":59934,"_5":14750,"_28174":59185,"_3058":59935},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3602":3003,"_30987":2703,"_21467":59937,"_5":14750,"_28174":59185,"_3058":59938},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3602":3004,"_30987":2703,"_21467":59940,"_5":14750,"_28174":59185,"_3058":59941},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3602":3005,"_30987":2703,"_21467":59943,"_5":14750,"_28174":59185,"_3058":59944},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3602":3006,"_30987":2703,"_21467":59946,"_5":14750,"_28174":59185,"_3058":59947},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3602":3007,"_30987":2703,"_21467":59949,"_5":14750,"_28174":59185,"_3058":59950},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3602":3008,"_30987":2703,"_21467":59952,"_5":14750,"_28174":59185,"_3058":59953},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3602":3009,"_30987":2703,"_21467":59955,"_5":14750,"_28174":59185,"_3058":59956},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3602":3010,"_30987":2703,"_21467":59958,"_5":14750,"_28174":59185,"_3058":59959},[],"**Remove the helper and restore the recorded replica counts:**",{"_3602":3011,"_30987":2703,"_21467":59961,"_5":14750,"_28174":59185,"_3058":59962},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3602":3012,"_30987":2703,"_21467":59964,"_5":14750,"_28174":59189,"_3058":59965},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3602":3013,"_30987":2703,"_21467":59967,"_5":14750,"_28174":59189,"_3058":59968},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3602":3014,"_30987":2703,"_21467":59970,"_5":14750,"_28174":59193,"_3058":59971},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3602":3015,"_30987":2703,"_21467":59973,"_5":14750,"_28174":59193,"_3058":59974},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3602":3016,"_30987":2703,"_21467":59976,"_5":14750,"_28174":59193,"_3058":59977},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration requires `ca` and `kms` to be migrated first: it fails with `ca schema not found: migrate the ca schema before the va schema` or `kms schema not found: migrate the kms schema before the va schema` if one of them is missing.",{"_3602":3017,"_30987":2703,"_21467":59979,"_5":14750,"_28174":59193,"_3058":59980},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates`, `SELECT` on `ca.ca_certificates`, and `USAGE` on `kms` plus `SELECT` and `REFERENCES` on `kms.kms_keys`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`. After migrating `va`, if the CA service runs as a different user, grant it `USAGE` on the `va` schema and `SELECT` on `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): the CA service reads `va.crl_settings` when it deletes a CA, and without these grants every deletion of a CA that has a crypto engine fails with `permission denied for schema va` (or `for table crl_settings`).",{"_3602":3018,"_30987":2703,"_21467":59982,"_5":14750,"_28174":59193,"_3058":59983},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3602":3019,"_30987":2703,"_21467":59985,"_5":14750,"_28174":59193,"_3058":59986},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3602":3020,"_30987":2703,"_21467":59988,"_5":14750,"_28174":59193,"_3058":59989},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3602":3021,"_30987":2703,"_21467":59991,"_5":14750,"_28174":59193,"_3058":59992},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3602":3022,"_30987":2703,"_21467":59994,"_5":14750,"_28174":59197,"_3058":59995},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3602":3023,"_30987":2703,"_21467":59997,"_5":14750,"_28174":59197,"_3058":59998},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3602":3024,"_30987":2703,"_21467":60000,"_5":14750,"_28174":59197,"_3058":60001},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3602":3025,"_30987":2703,"_21467":60003,"_5":14750,"_28174":59197,"_3058":60004},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3602":3026,"_30987":2703,"_21467":60006,"_5":14750,"_28174":59197,"_3058":60007},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3602":3027,"_30987":2703,"_21467":60009,"_5":14750,"_28174":59197,"_3058":60010},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3602":3028,"_30987":2703,"_21467":60012,"_5":14750,"_28174":59197,"_3058":60013},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3602":3029,"_30987":2703,"_21467":60015,"_5":14750,"_28174":59197,"_3058":60016},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` and `va` schema migrations.",{"_3602":3030,"_30987":2703,"_21467":60018,"_5":14750,"_28174":59197,"_3058":60019},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3602":3031,"_30987":2703,"_21467":60021,"_5":14750,"_28174":59197,"_3058":60022},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3602":3032,"_30987":2703,"_21467":60024,"_5":14750,"_28174":59197,"_3058":60025},[],"**A migration or service fails with `permission denied for table ...` or `permission denied for schema ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped, and `permission denied for schema va` (or `for table crl_settings`) when deleting a CA without the `va` grants. Grant the missing privileges and re-run.",{"_3602":3033,"_30987":2703,"_21467":60027,"_5":14750,"_28174":59200,"_3058":60028},[],"After the upgrade, check in this order:",{"_3602":3034,"_30987":2703,"_21467":60030,"_5":14750,"_28174":59200,"_3058":60031},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3602":3035,"_30987":2703,"_21467":60033,"_5":14750,"_28174":59200,"_3058":60034},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3602":3036,"_30987":2703,"_21467":60036,"_5":14750,"_28174":59200,"_3058":60037},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3602":3037,"_30987":2703,"_21467":60039,"_5":14750,"_28174":59200,"_3058":60040},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3602":3038,"_30987":2703,"_21467":60042,"_5":14750,"_28174":59200,"_3058":60043},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3602":3039,"_30987":2703,"_21467":60045,"_5":14750,"_28174":59200,"_3058":60046},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3602":3040,"_30987":2703,"_21467":60048,"_5":14750,"_28174":59200,"_3058":60049},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3602":3041,"_30987":2703,"_21467":60051,"_5":14750,"_28174":59200,"_3058":60052},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3602":3042,"_30987":2703,"_21467":60054,"_5":14750,"_28174":59200,"_3058":60055},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3602":3043,"_30987":2703,"_21467":60057,"_5":14750,"_28174":59200,"_3058":60058},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3602":3044,"_30987":2703,"_21467":60060,"_5":14750,"_28174":59200,"_3058":60061},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3602":3045,"_30987":2703,"_21467":60063,"_5":14750,"_28174":59200,"_3058":60064},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3602":3046,"_30987":2703,"_21467":60066,"_5":14750,"_28174":59200,"_3058":60067},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3602":3047,"_30987":2703,"_21467":60069,"_5":14750,"_28174":59200,"_3058":60070},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3602":3048,"_30987":2703,"_21467":60072,"_5":14750,"_28174":59200,"_3058":60073},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3602":3049,"_30987":2703,"_21467":60075,"_5":14750,"_28174":59204,"_3058":60076},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3602":3050,"_30987":2703,"_21467":60078,"_5":14750,"_28174":59204,"_3058":60079},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3602":3051,"_30987":2703,"_21467":60081,"_5":14750,"_28174":59204,"_3058":60082},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3602":3052,"_30987":2703,"_21467":60084,"_5":14750,"_28174":59204,"_3058":60085},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3602":3053,"_30987":2703,"_21467":60087,"_5":14750,"_28174":59204,"_3058":60088},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_60091":60092,"_60093":60094,"_60095":60096,"_60097":60098,"_18592":3093,"_72268":3093},"language","english","sortableProperties",[3058,30987,5,28174],"sortablePropertiesWithTypes",{"_3058":25625,"_30987":25625,"_5":25625,"_28174":25625},"sorts",{"_3058":60099,"_30987":63142,"_5":66184,"_28174":69226},{"_4800":60100,"_60101":60102,"_5":25625},{"_14826":4271,"_15209":11090,"_15228":7677,"_29986":8091,"_15215":3859,